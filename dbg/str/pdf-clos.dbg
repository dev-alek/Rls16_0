       40   procedure vss-get-parameters :
       41     define output parameter p-vss-parameters as character no-undo .
       42   end procedure.
       43   define new global shared variable g#vssrevis-logger as handle    no-undo .
       44   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       45   define variable v-vssrevis-logger                   as handle    no-undo .
       46   procedure vss-logevent :
       47     define input  parameter p-extra-paramters as character no-undo .
       48     define variable v-vssrevis-parameters as character no-undo .
       49     do
       50     on error undo, return error return-value
       51     :
       52       if  valid-handle(v-vssrevis-logger)
       53       and v-vssrevis-logger :get-signature("logevent") <> ""
       54       then do:
       55         run vss-get-parameters in this-procedure
       56           (output v-vssrevis-parameters
       57           ).
       58         run logevent in v-vssrevis-logger
       59           (input vss-workfile
       60           ,input vss-revision
       61           ,input v-vssrevis-parameters
       62           ,input p-extra-paramters
       63           ).
       64       end.
       65     end.
       66   end procedure.
       67   assign
       68     v-vssrevis-logger = g#vssrevis-logger
       69   .
       70   if  valid-handle(v-vssrevis-logger)
       71   and v-vssrevis-logger :get-signature("logevent") <> ""
       72   then do:
       73     assign
       74       v-vssrevis-logevent = true
       75     .
       76     run vss-logevent in this-procedure (input vss-description) .
       77   end.
       78   define new global shared variable g#language as character no-undo .
       79   if g#language <> '' and g#language <> 'rus':U then do:
       80     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       81   end.
       82   define new global shared variable g#library  as handle no-undo .
       83   define new global shared variable g#library2 as handle no-undo .
       84   define   shared variable g#auto as logical no-undo.
       85   define   shared variable g#news as logical no-undo.
       86   define   shared variable g#oxml as logical no-undo.
       87   define   shared variable g#esys as logical no-undo.
       88   define   shared variable g#news-source-db as integer no-undo.
       89   define   shared variable g#esys-source-esys as integer no-undo.
       90   define   shared variable g#db-num as integer   no-undo .
       91   define   shared variable g#userid as character no-undo .
       92   define   shared variable g#passwd as character no-undo .
       93   define new global shared variable g#lib-trn  as handle no-undo .
       94   define new global shared variable g#lib-trn2 as handle no-undo .
       95   define new global shared variable g#lib-trn3 as handle no-undo .
       96   define new global shared variable g#lib-trn4 as handle no-undo .
       97   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       98     define variable v-cntxt-db-num        as integer   no-undo .
       99     define variable v-cntxt-userid        as character no-undo .
      100     define variable v-cntxt-level         as character no-undo .
      101     define variable v-cntxt-host-code-obj as integer   no-undo .
      102     define variable v-cntxt-obj-type      as character no-undo .
      103     define variable v-cntxt-obj-code      as integer   no-undo .
      104     define variable v-cntxt-db-num-obj    as integer   no-undo .
      105     define variable v-cntxt-is-admin      as logical   no-undo .
      106   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      107     run mainmenu_getcntxt in parparentproc
      108       (output v-cntxt-db-num
      109       ,output v-cntxt-userid
      110       ,output v-cntxt-level
      111       ,output v-cntxt-host-code-obj
      112       ,output v-cntxt-obj-type
      113       ,output v-cntxt-obj-code
      114       ,output v-cntxt-db-num-obj
      115       ,output v-cntxt-is-admin
      116       ) .
      117   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      120   define variable par-type          as character no-undo.
      121   define variable v-value-character as character no-undo .
      122   define variable v-value-date      as date      no-undo .
      123   define variable v-value-decimal   as decimal   no-undo .
      124   define variable v-value-integer   as integer   no-undo .
      125   define variable v-value-logical   as logical   no-undo .
      126   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127   define temp-table x_obj-group no-undo like ub.clients  .
      128   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
      129   procedure metod-gop-obj :
      130     do
      131     on error undo, return error return-value
      132     :
      133   define input  parameter p-cntxt-db-num as integer   no-undo .
      134   define input  parameter p-gop-id       as integer   no-undo .
      135   define input  parameter p-gop-db-num   as integer   no-undo .
      136   define buffer buf1_clients for ub.clients  .
      137   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
      138   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
      139   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
      140   for each  x_obj-group : delete x_obj-group. end.
      141   if p-gop-id = 0 or p-gop-id = ?  then do:
      142      if p-cntxt-db-num = 0  then do:
      143           for each buf1_clients no-lock where
      144                   (buf1_clients.obj-type = 'маг':U  or
      145                    buf1_clients.obj-type = 'скл':U  )
      146                   and
      147                   buf1_clients.db-num >= 0  and
      148                   buf1_clients.stts = 0
      149                   :
      150             create x_obj-group .
      151             assign
      152               x_obj-group.obj-code   = buf1_clients.obj-code
      153               x_obj-group.obj-type   = buf1_clients.obj-type
      154               x_obj-group.obj-name   = buf1_clients.obj-name
      155               x_obj-group.db-num     = buf1_clients.db-num
      156             .
      157           end.
      158      end.
      159      else do:
      160           for each buf1_clients no-lock where
      161                   (buf1_clients.obj-type = 'маг':U  or
      162                    buf1_clients.obj-type = 'скл':U  ) and
      163                    buf1_clients.db-num = p-cntxt-db-num  and
      164                    buf1_clients.stts = 0
      165                   :
      166             create x_obj-group .
      167             assign
      168               x_obj-group.obj-code   = buf1_clients.obj-code
      169               x_obj-group.obj-type   = buf1_clients.obj-type
      170               x_obj-group.obj-name   = buf1_clients.obj-name
      171               x_obj-group.db-num     = buf1_clients.db-num
      172             .
      173           end.
      174      end.
      175   end.
      176   else do:
      177         for each buf_db-grp-obj-price  where
      178                 buf_db-grp-obj-price.gop-id     = p-gop-id and
      179                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
      180                 buf_db-grp-obj-price.stts = 0  no-lock :
      181           for each buf1_clients no-lock where
      182                  (buf1_clients.obj-type = 'маг':U  or
      183                   buf1_clients.obj-type = 'скл':U  ) and
      184                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
      185                   buf1_clients.stts = 0
      186                   :
      187             create x_obj-group .
      188             assign
      189               x_obj-group.obj-code   = buf1_clients.obj-code
      190               x_obj-group.obj-type   = buf1_clients.obj-type
      191               x_obj-group.obj-name   = buf1_clients.obj-name
      192               x_obj-group.db-num     = buf1_clients.db-num
      193             .
      194           end.
      195         end.
      196       for each buf_host-grp-obj-price where
      197               buf_host-grp-obj-price.gop-id     = p-gop-id and
      198               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
      199               buf_host-grp-obj-price.stts = 0
      200               no-lock :
      201         for each buf1_clients no-lock where
      202                (buf1_clients.obj-type = 'маг':U  or
      203                 buf1_clients.obj-type = 'скл':U  ) and
      204                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
      205                 buf1_clients.stts = 0
      206                 :
      207             find first x_obj-group no-lock  where
      208                       x_obj-group.obj-code   = buf1_clients.obj-code and
      209                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      210             if not available  x_obj-group then   create x_obj-group .
      211             assign
      212               x_obj-group.obj-code   = buf1_clients.obj-code
      213               x_obj-group.obj-type   = buf1_clients.obj-type
      214               x_obj-group.obj-name   = buf1_clients.obj-name
      215               x_obj-group.db-num     = buf1_clients.db-num
      216             .
      217         end.
      218       end.
      219       for each buf_obj-grp-obj-price where
      220               buf_obj-grp-obj-price.gop-id     = p-gop-id and
      221               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
      222               buf_obj-grp-obj-price.stts = 0
      223               no-lock :
      224         for each buf1_clients no-lock where
      225                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
      226                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
      227                   buf1_clients.stts     = 0
      228                   :
      229             find first  x_obj-group no-lock  where
      230                         x_obj-group.obj-code   = buf1_clients.obj-code and
      231                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      232             if not available  x_obj-group then   create x_obj-group .
      233             assign
      234               x_obj-group.obj-code   = buf1_clients.obj-code
      235               x_obj-group.obj-type   = buf1_clients.obj-type
      236               x_obj-group.obj-name   = buf1_clients.obj-name
      237               x_obj-group.db-num     = buf1_clients.db-num
      238             .
      239         end.
      240       end.
      241   end.
      242   end.
      243   end procedure.
      244   procedure metod-obj-in-gop :
      245   define input  parameter p-curr-db-num as integer   no-undo .
      246   define input  parameter p-obj-type as character no-undo .
      247   define input  parameter p-obj-code as integer   no-undo .
      248   define buffer buf_grp-obj-price for ub.grp-obj-price  .
      249     do
      250     on error undo, return error return-value
      251     :
      252       empty temp-table x_grp-obj-price.
      253       for each buf_grp-obj-price where
      254                buf_grp-obj-price.stts = 0
      255                no-lock :
      256                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
      257                  for each x_obj-group where
      258                           x_obj-group.obj-type = p-obj-type and
      259                           x_obj-group.obj-code = p-obj-code :
      260                       create  x_grp-obj-price.
      261                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
      262                  end.
      263       end.
      264     end.
      265   end procedure.
      266   procedure metod-delobj-usr :
      267   define input  parameter p-pdf-id  as integer   no-undo .
      268   define input  parameter p-pdf-db  as integer   no-undo .
      269   define input  parameter p-plt-id  as integer   no-undo .
      270   define input  parameter p-plt-db-num as integer   no-undo .
      271   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      272     do
      273     on error undo, return error return-value
      274     :
      275   for each buf_price-doc-forming-attr no-lock  where
      276            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
      277            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
      278            buf_price-doc-forming-attr.plt-id =     p-plt-id and
      279            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
      280            buf_price-doc-forming-attr.attr-code begins "obj" :
      281      for each x_obj-group  where
      282               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
      283               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
      284        delete x_obj-group.
      285      end.
      286   end.
      287     if not can-find (first x_obj-group) then do:
      288        return "nullobj" .
      289     end.
      290   end.
      291   end procedure.
      292   procedure metod-obj-pdf :
      293   define input  parameter p-cntxt-db-num as integer   no-undo .
      294   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
      295   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
      296   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
      297   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
      298   define buffer buf_price-list-type for ub.price-list-type  .
      299   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      300     do
      301     on error undo, return error return-value
      302     :
      303    for each  x_obj-group : delete x_obj-group. end.
      304    find first buf_price-list-type no-lock where
      305               buf_price-list-type.plt-id = p-plt-id and
      306               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
      307   if error-status :error then return error return-value .
      308    find first buf_price-doc-forming no-lock where
      309               buf_price-doc-forming.plt-id     = p-plt-id and
      310               buf_price-doc-forming.plt-db-num = p-plt-db-num and
      311               buf_price-doc-forming.pdf-id     = p-pdf-id and
      312               buf_price-doc-forming.pdf-db     = p-pdf-db-num
      313               no-error .
      314   if error-status :error then return error return-value .
      315     run metod-gop-obj in this-procedure (
      316         p-cntxt-db-num,
      317         buf_price-list-type.gop-id ,
      318         buf_price-list-type.gop-db-num
      319         ) no-error .
      320     run metod-delobj-usr in this-procedure (
      321       buf_price-doc-forming.pdf-id ,
      322       buf_price-doc-forming.pdf-db ,
      323       buf_price-doc-forming.plt-id ,
      324       buf_price-doc-forming.plt-db-num
      325       ) no-error .
      326     end.
      327   end procedure.
      328   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      329   define variable v-waitfram-action01         as character   no-undo .
      330   define variable v-waitfram-action02         as character   no-undo .
      331   define variable v-waitfram-action03         as character   no-undo .
      332   define variable mWaitFramTextBeg            as character   no-undo.
      333   define variable mWaitFramTextEnd            as character   no-undo.
      334   define variable mWaitFramView               as logical     no-undo.
      335   define variable mWaitProcEvent              as logical     no-undo init yes.
      336   define variable mWaitFramInterval           as integer     no-undo init 1 .
      337   define variable mWaitFramStop               as logical     no-undo.
      338   define variable mWaitFramStopUser           as logical     no-undo.
      339   define variable mWaitFramStopTimeOut        as logical     no-undo.
      340   define variable mWaitFramStartProc          as datetime-tz no-undo.
      341   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      342   define button B-WaitFramStop auto-end-key
      343        label "Стоп"
      344        size 10 by 1 tooltip "Остоновить процесс".
      345   define button B-viewProcInfo
      346        label "Информация"
      347        size 15 by 1 tooltip "Информация о процесс".
      348   define frame waitfram
      349     v-waitfram-action01 format "x(72)" no-label skip
      350     v-waitfram-action02 format "x(72)" no-label skip
      351     v-waitfram-action03 format "x(72)" no-label skip
      352     B-viewProcInfo
      353     B-WaitFramStop at row 4 col 30
      354     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      355     .
      356   define new global shared variable mBatchMode as logical no-undo init ?.
      357   define variable mFramBachModHandle as handle no-undo.
      358   mFramBachModHandle = frame waitfram:handle.
      359   define variable mFameOldVis as logical no-undo.
      360   define variable mVisCUrentVin as logical no-undo.
      361   if session:batch-mode
      362   then
      363      mBatchMode = yes.
      364   if mBatchMode = ? then do:
      365     mVisCUrentVin = current-window:visible.
      366     mFameOldVis = mFramBachModHandle:visible.
      367     mFramBachModHandle:visible  = yes.
      368     mBatchMode = mFramBachModHandle:visible ne yes.
      369     mFramBachModHandle:visible = mFameOldVis.
      370     current-window:visible = mVisCUrentVin.
      371   end.
      372    if  log-manager:logfile-name ne ?
      373     then DO:
      374         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      375         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      376         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      377     end.
      378   on choose of B-WaitFramStop in frame waitfram
      379   do:
      380     mWaitFramStop = yes.
      381     mWaitFramStopUser = yes.
      382   end.
      383   function waitfram-check-timeout returns logical():
      384      define variable vtime as int64 no-undo.
      385      if mWaitFramStopTimeOut
      386      then
      387         return yes.
      388      vtime = ( now - mWaitFramStartProc ) / 1000 .
      389      if     mWaitFramTimeOut ne ?
      390         and mWaitFramTimeOut ne 0
      391         and mWaitFramTimeOut lt vtime
      392      then do:
      393         mWaitFramStopTimeOut = yes.
      394      end.
      395      return mWaitFramStopTimeOut.
      396   end.
      397   procedure waitfram-hide :
      398     if not session:batch-mode
      399     then do
      400     on error undo, return error return-value
      401     :
      402       pause 0 before-hide .
      403       if not mBatchMode then
      404         hide frame waitfram .
      405     if     not mWaitFramView
      406        and mWaitProcEvent
      407     then
      408       process events .
      409     end.
      410   end procedure.
      411   procedure waitfram-show :
      412     define input  parameter p-message as character no-undo .
      413     define variable v-left-margin as integer   no-undo .
      414     if not session:batch-mode
      415     then do
      416     on error undo, return error return-value
      417     :
      418       if length(p-message) <= 70 then do:
      419         assign
      420           v-left-margin = integer((70 - length(p-message)) / 2)
      421         .
      422         assign
      423           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      424         .
      425         assign
      426           v-waitfram-action01 = " "
      427           v-waitfram-action02 = " "
      428                                    + fill(" ", v-left-margin)
      429                                    + p-message
      430           v-waitfram-action03 = " "
      431         .
      432       end.
      433       else do:
      434         define variable vRindex1 as integer no-undo.
      435         define variable vRindex2 as integer no-undo.
      436         vRindex1 = r-index(p-message," ",70).
      437         if vRindex1 = 0
      438         then
      439            vRindex1 = 70.
      440         if length(p-message)  <= vRindex1 + 70 then do:
      441           assign
      442             v-waitfram-action01 = " "
      443             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      444             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      445           .
      446         end.
      447         else do:
      448           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      449           if vRindex2 <= vRindex1
      450           then
      451              vRindex2 = vRindex1 + 70.
      452           assign
      453             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      454             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      455             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      456           .
      457         end.
      458       end.
      459       B-viewProcInfo:visible   in frame waitfram = no.
      460       B-viewProcInfo:sensitive in frame waitfram = no.
      461       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      462       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      463       if  (   mWaitFramView
      464          or  mWaitProcEvent)
      465          and not mBatchMode
      466       then
      467          display
      468             v-waitfram-action01 skip
      469             v-waitfram-action02 skip
      470             v-waitfram-action03 skip
      471          with frame waitfram .
      472       if     mWaitFramView
      473          then do:
      474             if     mWaitFramInterval ne ?
      475                and not mBatchMode
      476             then
      477                wait-for go of frame waitfram pause mWaitFramInterval.
      478          end.
      479          else
      480             if     mWaitProcEvent
      481                and not mBatchMode
      482             then
      483                process events .
      484     end.
      485   end procedure.
      486      procedure waitfram-show-this:
      487         define input  parameter iInterval as int64 no-undo.
      488         define variable vtime as int64 no-undo.
      489         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      490         mWaitFramInterval = iInterval.
      491         run waitfram-show (substitute("&1&2 &3&4" ,
      492                                       mWaitFramTextBeg ,
      493                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      494                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      495                                       mWaitFramTextEnd
      496                                      )
      497                           ).
      498      end.
      499      procedure WaitFramRunPause:
      500         define input  parameter iInterval as dec no-undo.
      501         define variable vStart  as datetime-tz no-undo.
      502         define variable vend    as datetime-tz no-undo.
      503         define variable vint as int64 no-undo.
      504         define variable vOk as logical no-undo.
      505         vStart = now.
      506         vend   = vStart.
      507         publish "WaitFramPause" (iInterval,output vOk).
      508         vend   =  now.
      509         vint = vend - vStart.
      510         vint = iInterval - vint / 1000.
      511         if     not mWaitFramStop
      512            and (   vint > 0
      513                 or (    not vOk
      514                     and iInterval eq ?
      515                     )
      516                 )
      517         then
      518            run waitfram-show-this (iInterval).
      519         vend   =  now.
      520         vint = vend - vStart.
      521         vint = iInterval - vint / 1000.
      522         if     not mWaitFramStop
      523            and vint > 0
      524         then do:
      525            run gbl/pause.p (vint * 1000).
      526         end.
      527         if iInterval ne ?
      528         then
      529            publish "WaitFramStop".
      530         waitfram-check-timeout().
      531      end.
      532      procedure WaitFramWaitFor:
      533         define input  parameter iInterval as dec no-undo.
      534         assign
      535            mWaitFramStartProc   = now
      536            mWaitFramStopUser    = no
      537            mWaitFramStopTimeOut = no
      538         .
      539         block-wait:
      540         do while not mWaitFramStop:
      541            run WaitFramRunPause (iInterval).
      542            if  waitfram-check-timeout()
      543            then do:
      544               leave block-wait.
      545            end.
      546         end.
      547         run waitfram-hide.
      548      end.
      549   procedure waitfram-join :
      550     define input  parameter p-line-1  as character no-undo .
      551     define input  parameter p-line-2  as character no-undo .
      552     define input  parameter p-line-3  as character no-undo .
      553     define output parameter p-message as character no-undo .
      554     do
      555     on error undo, return error return-value
      556     :
      557       assign
      558         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      559                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      560                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      561       .
      562     end.
      563   end procedure.
      564   function waitfram-join-function returns character
      565     (input p-line-1 as character
      566     ,input p-line-2 as character
      567     ,input p-line-3 as character
      568     ).
      569     define variable v-message as character no-undo .
      570     run waitfram-join in this-procedure
      571       (input  p-line-1
      572       ,input  p-line-2
      573       ,input  p-line-3
      574       ,output v-message
      575       ) .
      576     return v-message .
      577   end function .
      578   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      579   procedure doc-code:
      580   define input  parameter parmode          as   character           no-undo.
      581   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      582   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      583   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      584   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      585   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      586   define variable vardb-remote     as   logical             no-undo.
      587   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      588   define variable v-delimiter as character no-undo .
      589   do
      590   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      591   :
      592   find first buf_sys-ctrl no-lock .
      593   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      594     CASE parmode:
      595       when "main":u then do:
      596         if vardb-remote then do:
      597           assign
      598             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      599         end.
      600         else do:
      601           assign
      602             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      603         end.
      604       end.
      605       when "trio" then do:
      606         assign
      607           pardoc-code = replace (parroot-doc-code, "=", "*").
      608       end.
      609       otherwise do:
      610         assign
      611         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      612         no-error
      613         .
      614         if error-status:error  then do:
      615           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      616                                         ,chr(10)
      617                                         ,parmode
      618                                         ).
      619         end.
      620         if num-entries(parmode) = 1
      621         and parmode <> "chip":U
      622         and parmode <> "chip_s":U
      623         then do:
      624           assign
      625           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      626         end.
      627         else if (lookup("chip":U, parmode) > 0
      628                  or
      629                  lookup("chip_s":U, parmode) > 0) then do:
      630           assign
      631             vartemp-doc-code = parroot-doc-code.
      632           do while true:
      633             if index (vartemp-doc-code , ".") = 0 then
      634               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      635             else
      636               vartemp-doc-code  =
      637               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      638               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      639               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      640             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      641           end.
      642           assign
      643             pardoc-code = vartemp-doc-code.
      644         end.
      645       end.
      646     end CASE.
      647     if pardoc-code = '':U
      648     or (parroot-doc-code <> '':U
      649     and pardoc-code = parroot-doc-code) then do:
      650       undo, return error substitute("Ошибка при генерации номера документа&1"
      651                                     ,chr(10)).
      652     end.
      653   end.
      654   end. // procedure/method
      655   function get-doc-code-int64 returns int64
      656     ( input p-doc-code as character ) :
      657     define variable v-ind              as integer   no-undo .
      658     define variable v-num-entries      as integer   no-undo .
      659     define variable v-doc-code-int64   as int64     no-undo .
      660     define variable v-canonic-doc-code as character no-undo .
      661     assign
      662       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      663       v-canonic-doc-code = p-doc-code
      664     .
      665     do v-ind = 1 to v-num-entries
      666     :
      667       assign
      668         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      669       .
      670     end.
      671     assign
      672       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      673     .
      674     return v-doc-code-int64 .
      675   end. // function/method
      676   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      677   procedure factord :
      678     define input  parameter p-fact-date            as date    no-undo .
      679     define input  parameter p-fact-time            as integer no-undo .
      680     define input  parameter p-fact-num             as integer no-undo .
      681     define input  parameter p-shift-date           as date    no-undo .
      682     define input  parameter p-shift-num            as integer no-undo .
      683     define input  parameter p-shift-on             as logical no-undo .
      684     define output parameter p-fact-order           as decimal no-undo .
      685     define output parameter p-shift-end-fact-order as decimal no-undo .
      686     define output parameter p-day-end-fact-order   as decimal no-undo .
      687     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      688     if p-fact-date = ?
      689     then do:
      690       return error "Не указана фактическая дата" .
      691     end.
      692     define variable v-fact-date-num as integer no-undo .
      693     assign
      694       v-fact-date-num = integer(p-fact-date)
      695     .
      696     if p-fact-num = ?
      697     or p-fact-num = 0
      698     then do:
      699       return error "Не задан p-fact-num " + string(p-fact-num) .
      700     end.
      701     if p-fact-num < 0
      702     then do:
      703       return error "Отрицательный fact-num " + string(p-fact-num) .
      704     end.
      705     if p-fact-num >= 100000000
      706     then do:
      707       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      708     end.
      709     if p-shift-on = true
      710     then do:
      711       if p-shift-date = ?
      712       then do:
      713         return error "Не задана дата смены" .
      714       end.
      715       if p-shift-num = ?
      716       or p-shift-num = 0
      717       then do:
      718         return error "Не задан номер смены" .
      719       end.
      720     end.
      721     else do:
      722       assign
      723         p-shift-date = p-fact-date
      724         p-shift-num  = 24
      725       .
      726     end.
      727     define variable v-shift-offset as integer no-undo .
      728     if p-shift-date = p-fact-date
      729     then do:
      730       assign
      731         v-shift-offset = 1
      732       .
      733     end.
      734     if p-shift-date < p-fact-date
      735     then do:
      736       assign
      737         v-shift-offset = 0
      738       .
      739     end.
      740     if p-shift-date > p-fact-date
      741     then do:
      742       message
      743         vss-workfile vss-revision vss-description skip
      744         "Неправильная дата закрытия смены" skip
      745         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      746         view-as alert-box error .
      747       undo, return error
      748         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      749           ,string(p-fact-date, '99/99/9999':U)
      750           ,string(p-shift-date, '99/99/9999':U)
      751           )
      752       .
      753     end.
      754     if p-shift-num < 1
      755     or p-shift-num > 24
      756     then do:
      757       message
      758         vss-workfile vss-revision vss-description skip
      759         "Неправильный номер смены" skip
      760         "p-shift-num" p-shift-num skip
      761         view-as alert-box error .
      762       undo, return error return-value .
      763     end.
      764     assign
      765       p-fact-order           = v-fact-date-num
      766                              + v-shift-offset * 0.5
      767                              + p-shift-num    * 0.02 - 0.01
      768                              + p-fact-num     * 0.0000000001
      769       p-shift-end-fact-order = v-fact-date-num
      770                              + v-shift-offset * 0.5
      771                              + p-shift-num    * 0.02
      772       p-day-end-fact-order   = v-fact-date-num
      773                              + 0.99
      774     .
      775     if p-fact-order           <= v-fact-date-num
      776     or p-shift-end-fact-order <= v-fact-date-num
      777     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      778     or p-shift-end-fact-order >= p-day-end-fact-order
      779     then do:
      780       message
      781         vss-workfile vss-revision vss-description skip
      782         "Внутренняя ошибка при генерации фактического номера" skip
      783         "p-fact-date"            p-fact-date            skip
      784         "p-fact-time"            p-fact-time            skip
      785         "p-fact-num"             p-fact-num             skip
      786         "p-shift-date"           p-shift-date           skip
      787         "p-shift-num"            p-shift-num            skip
      788         "p-shift-on"             p-shift-on             skip
      789         "p-shift-end-fact-order" p-shift-end-fact-order skip
      790         "p-day-end-fact-order"   p-day-end-fact-order   skip
      791         "v-fact-date-num"        v-fact-date-num        skip
      792         view-as alert-box error .
      793       undo, return error return-value .
      794     end.
      795   end procedure.
      796   procedure day-begin-fact-order :
      797     define input  parameter p-fact-date            as date    no-undo .
      798     define output parameter p-day-begin-fact-order as decimal no-undo .
      799     do
      800     on error undo, return error return-value
      801     :
      802       if p-fact-date = ?
      803       then do:
      804         assign
      805           p-day-begin-fact-order = 0
      806         .
      807       end.
      808       else do:
      809         assign
      810           p-day-begin-fact-order = integer(p-fact-date)
      811         .
      812       end.
      813     end.
      814   end procedure.
      815   procedure factord-max-fact-order :
      816     define output parameter p-max-fact-order as decimal   no-undo .
      817     do
      818     on error undo, return error return-value
      819     :
      820       run day-begin-fact-order in this-procedure
      821         (input  date(1, 1, 5000)
      822         ,output p-max-fact-order
      823         ) .
      824     end.
      825   end procedure.
      826   procedure factord-cut-archive :
      827     define input  parameter p-obj-type             as character no-undo .
      828     define input  parameter p-obj-code             as integer   no-undo .
      829     define input  parameter p-fact-date            as date      no-undo .
      830     define output parameter p-shift-on             as logical   no-undo .
      831     define output parameter p-shift-date           as date      no-undo .
      832     define output parameter p-shift-num            as integer   no-undo .
      833     define output parameter p-day-end-fact-order   as decimal   no-undo .
      834     define output parameter p-shift-end-fact-order as decimal   no-undo .
      835     define variable v-fact-order as decimal   no-undo .
      836     define buffer buf_shift-obj for ub.shift-obj .
      837     do
      838     on error undo, return error return-value
      839     :
      840   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      841   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      842     (input  p-obj-type
      843     ,input  p-obj-code
      844     ,input  'shift-on=request'
      845     ,output p-shift-on
      846     ) no-error .
      847       if error-status :error
      848       then do:
      849         message
      850           vss-workfile vss-revision vss-description skip
      851           "Ошибка при определении атрибута объекта" skip
      852           "Объект" p-obj-type p-obj-code skip
      853           error-status :get-message(1) skip
      854           return-value skip
      855           view-as alert-box error .
      856         undo, return error return-value .
      857       end.
      858       if p-shift-on = false
      859       then do:
      860         assign
      861           p-shift-date               = ?
      862           p-shift-num                = 0
      863         .
      864       end.
      865       else do:
      866         find first buf_shift-obj share-lock
      867           where buf_shift-obj.obj-type   = p-obj-type
      868             and buf_shift-obj.obj-code   = p-obj-code
      869             and buf_shift-obj.shift-date > p-fact-date
      870           use-index pi
      871           no-error .
      872         if not available buf_shift-obj
      873         or buf_shift-obj.status_ <> 'зкр':U
      874         then do:
      875           message
      876             vss-workfile vss-revision vss-description skip
      877             "Невозможно вычислить последнюю смену" skip
      878             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      879             "Объект" p-obj-type p-obj-code skip
      880             "Дата" p-fact-date skip
      881             view-as alert-box error .
      882           undo, return error return-value .
      883         end.
      884         find last buf_shift-obj share-lock
      885           where buf_shift-obj.obj-type = p-obj-type
      886             and buf_shift-obj.obj-code = p-obj-code
      887             and buf_shift-obj.shift-date <= p-fact-date
      888           use-index pi
      889           no-error .
      890         if available buf_shift-obj
      891         then do:
      892           if  buf_shift-obj.status_ = 'зкр':U
      893           then do:
      894             assign
      895               p-shift-date = buf_shift-obj.shift-date
      896               p-shift-num  = buf_shift-obj.shift-num
      897             .
      898           end.
      899           else do:
      900             message
      901               vss-workfile vss-revision vss-description skip
      902               "Невозможно вычислить последнюю смену" skip
      903               "Статус смены отличен от статуса" 'зкр':U skip
      904               "Объект" p-obj-type p-obj-code skip
      905               "Дата" p-fact-date skip
      906               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      907               view-as alert-box error .
      908             undo, return error return-value .
      909           end.
      910         end.
      911         else do:
      912           assign
      913             p-shift-date = p-fact-date - 1
      914             p-shift-num  = 1
      915           .
      916         end.
      917       end.
      918       run factord in this-procedure
      919         (input  p-fact-date
      920         ,input  1
      921         ,input  1
      922         ,input  p-shift-date
      923         ,input  p-shift-num
      924         ,input  p-shift-on
      925         ,output v-fact-order
      926         ,output p-shift-end-fact-order
      927         ,output p-day-end-fact-order
      928         ) no-error .
      929       if error-status :error
      930       then do:
      931         message
      932           vss-workfile vss-revision vss-description skip
      933           "Ошибка при вызове процедуры factord"
      934           error-status :get-message(1) skip
      935           return-value skip
      936           view-as alert-box error .
      937         undo, return error return-value .
      938       end.
      939     end.
      940   end procedure.
      941   procedure factord-lock-shift :
      942     define input  parameter p-obj-type  as character no-undo .
      943     define input  parameter p-obj-code  as integer   no-undo .
      944     define input  parameter p-fact-date as date      no-undo .
      945     define parameter buffer buf_shift-obj for ub.shift-obj .
      946     define variable v-shift-on      as logical   no-undo .
      947     define variable v-extra-message as character no-undo .
      948     define variable v-error as character no-undo .
      949     do
      950     on error undo, return error return-value
      951     :
      952   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      953   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      954     (input  p-obj-type
      955     ,input  p-obj-code
      956     ,input  'shift-on=request'
      957     ,output v-shift-on
      958     ) no-error .
      959       if error-status :error
      960       then do:
      961         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      962         undo, return error v-error .
      963       end.
      964       if v-shift-on = true
      965       then do:
      966         find first buf_shift-obj share-lock
      967           where buf_shift-obj.obj-type   = p-obj-type
      968             and buf_shift-obj.obj-code   = p-obj-code
      969             and buf_shift-obj.shift-date > p-fact-date
      970           use-index pi
      971           no-error .
      972         if not available buf_shift-obj
      973         or buf_shift-obj.status_ <> 'зкр':U
      974         then do:
      975           find last buf_shift-obj
      976             where buf_shift-obj.obj-type = p-obj-type
      977               and buf_shift-obj.obj-code = p-obj-code
      978               and buf_shift-obj.status_  = 'зкр':U
      979             use-index stts
      980             no-error .
      981           if available buf_shift-obj
      982           then do:
      983             assign
      984               v-extra-message =
      985                     substitute("Дата начала последеней закрытой смены на объекте &1"
      986                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      987                               )
      988             .
      989           end.
      990           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      991           undo, return error v-error .
      992         end.
      993       end.
      994     end.
      995   end procedure.
      996   procedure factord-end-day :
      997     define input  parameter p-fact-date            as date    no-undo .
      998     define output parameter p-day-end-fact-order   as decimal no-undo .
      999     do
     1000     on error undo, return error return-value
     1001     :
     1002       if p-fact-date = ?
     1003       then do:
     1004         return error "Не указана фактическая дата" .
     1005       end.
     1006       assign
     1007         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1008       .
     1009     end.
     1010   end procedure.
     1011   procedure factord-to-date :
     1012     define input  parameter p-fact-order as decimal no-undo .
     1013     define output parameter p-fact-date  as date    no-undo .
     1014     define variable v-ref-date  as date      no-undo .
     1015     define variable v-ref-delta as integer   no-undo .
     1016     do
     1017     on error undo, return error return-value
     1018     :
     1019       if p-fact-order = ?
     1020       or p-fact-order = 0
     1021       then do:
     1022         return error "Не указан fact-order" .
     1023       end.
     1024       assign
     1025         v-ref-date  = date(1, 1, 2000)
     1026       .
     1027       assign
     1028         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1029       .
     1030       assign
     1031         p-fact-date = v-ref-date + v-ref-delta
     1032       .
     1033     end.
     1034   end procedure.
     1035   procedure factord-to-fact-num :
     1036     define input  parameter p-fact-order as decimal no-undo .
     1037     define output parameter p-fact-num   as integer no-undo .
     1038     define variable v-fact-order-trunc as decimal no-undo .
     1039     do
     1040     on error undo, return error return-value
     1041     :
     1042       if p-fact-order = ?
     1043       or p-fact-order = 0
     1044       then do:
     1045         return error "Не указан fact-order" .
     1046       end.
     1047       assign
     1048        v-fact-order-trunc = truncate(p-fact-order, 2)
     1049       .
     1050       assign
     1051         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1052       .
     1053     end.
     1054   end procedure.
     1055   procedure factord-to-shift-num :
     1056     define input  parameter p-fact-order as decimal no-undo .
     1057     define output parameter p-shift-num   as integer no-undo .
     1058     define variable  p-shift-numd  as decimal   no-undo .
     1059     define variable v-fact-order-trunc as decimal no-undo .
     1060     do
     1061     on error undo, return error return-value
     1062     :
     1063       if p-fact-order = ?
     1064       or p-fact-order = 0
     1065       then do:
     1066         return error "Не указан fact-order" .
     1067       end.
     1068       assign
     1069        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1070       .
     1071       if v-fact-order-trunc < 0.5 then do:
     1072         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1073       end.
     1074       assign
     1075         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1076         .
     1077        assign
     1078         p-shift-num = truncate (p-shift-numd , 0)
     1079       .
     1080     end.
     1081   end procedure.
     1082   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1083   FUNCTION fnc-base-price RETURN decimal (local-bc      as integer,
     1084                                           local-doc-num as char).
     1085   define buffer base-price        for ub.price-list.
     1086   define variable local-main-code like ub.bar-code.b-code no-undo.
     1087   define variable local-base-code like ub.bar-code.b-code no-undo.
     1088     run prc-base-code (input local-bc, output local-base-code).
     1089     find base-price no-lock where
     1090          base-price.doc-num = local-doc-num and
     1091          base-price.b-code  = local-base-code and
     1092          base-price.price-type = "" no-error.
     1093     if not available base-price then do:
     1094       run prc-main-code (input local-bc, output local-main-code).
     1095       find  base-price no-lock where
     1096             base-price.doc-num = local-doc-num and
     1097             base-price.b-code  = local-main-code and
     1098             base-price.price-type = "" no-error.
     1099     end.
     1100     if available base-price then
     1101       return (base-price.price-sale).
     1102     else
     1103       return (?).
     1104   END FUNCTION.
     1105   procedure prc-main-code:
     1106   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
     1107   define output parameter local-main-code like ub.bar-code.b-code no-undo.
     1108   define buffer local-bar-code        for ub.bar-code.
     1109   define buffer local-goods           for ub.goods.
     1110   define buffer main-code             for ub.bar-code.
     1111   define buffer main-prt              for ub.gds-prt.
     1112     local-main-code = ?.
     1113     find local-bar-code no-lock where
     1114          local-bar-code.b-code = local-bc no-error.
     1115     if not available local-bar-code then
     1116       return.
     1117     find local-goods no-lock where
     1118          local-goods.gds-code = local-bar-code.gds-code.
     1119     find first  main-prt no-lock where
     1120                 main-prt.upper-code = local-goods.prt-root.
     1121     find  main-code no-lock where
     1122           main-code.gds-code  = local-bar-code.gds-code and
     1123           main-code.in-code   = "" and
     1124           main-code.part-code = "" and
     1125           main-code.unit-cli  = local-goods.unit-base and
     1126           main-code.node-code = main-prt.node-code.
     1127     local-main-code = main-code.b-code.
     1128   end procedure.
     1129   procedure prc-base-code:
     1130   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
     1131   define output parameter local-base-code like ub.bar-code.b-code no-undo.
     1132   define buffer local-bar-code for ub.bar-code.
     1133   define buffer local-goods    for ub.goods.
     1134   define buffer base-code      for ub.bar-code.
     1135     local-base-code = ?.
     1136     find local-bar-code no-lock where
     1137          local-bar-code.b-code = local-bc no-error.
     1138     if not available local-bar-code then
     1139       return.
     1140     find local-goods no-lock where
     1141          local-goods.gds-code = local-bar-code.gds-code.
     1142     find base-code no-lock where
     1143          base-code.gds-code  = local-bar-code.gds-code and
     1144          base-code.node-code = local-bar-code.node-code and
     1145          base-code.in-code   = local-bar-code.in-code and
     1146          base-code.part-code = local-bar-code.part-code and
     1147          base-code.unit-cli  = local-goods.unit-base.
     1148     local-base-code = base-code.b-code.
     1149   end procedure.
     1150   p-auto  = logical (entry(10,p-parameter,chr(4))) no-error .
     1151     if error-status :error then p-auto = false .
