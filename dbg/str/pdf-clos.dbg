     4086     ,output l-excise
     4087     ) no-error .
     4088         if l-doc-num2 <> ? then do :
     4089           if l-price-sale = pdf_price-list.price-sale-doc
     4090           and v-price-sale = pdf_price-list.price-sale-doc
     4091           then do:
     4092                find first buf_goods no-lock where
     4093                           buf_goods.artic     =  pdf_price-list.artic and
     4094                           buf_goods.prod-type =  pdf_price-list.prod-type and
     4095                           buf_goods.prod-code =  pdf_price-list.prod-code no-error .
     4096               check-par = false .
     4097                  for each pp_price-list no-lock where
     4098                           pp_price-list.plt-id     = p-plt-id     and
     4099                           pp_price-list.plt-db-num = p-plt-db-num and
     4100                           pp_price-list.pdf-id     = p-pdf-id     and
     4101                           pp_price-list.pdf-db     = p-pdf-db     and
     4102                           pp_price-list.artic      = pdf_price-list.artic and
     4103                           pp_price-list.prod-type  = pdf_price-list.prod-type  and
     4104                           pp_price-list.prod-code  = pdf_price-list.prod-code ,
     4105                        first buf1-bar-code no-lock where
     4106                             buf1-bar-code.b-code   = pp_price-list.b-code and
     4107                             buf1-bar-code.unit-cli <> buf_goods.unit-base
     4108                       :
     4109                       if  pp_price-list.b-code = f-base-code (pp_price-list.b-code) then next .
     4110                       check-par = true  .
     4111                       leave.
     4112                   end.
     4113                  for each pp_price-list no-lock where
     4114                           pp_price-list.plt-id     = p-plt-id     and
     4115                           pp_price-list.plt-db-num = p-plt-db-num and
     4116                           pp_price-list.pdf-id     = p-pdf-id     and
     4117                           pp_price-list.pdf-db     = p-pdf-db     and
     4118                           pp_price-list.artic      = pdf_price-list.artic and
     4119                           pp_price-list.prod-type  = pdf_price-list.prod-type  and
     4120                           pp_price-list.prod-code  = pdf_price-list.prod-code and
     4121                           pp_price-list.price-sale-doc <> pdf_price-list.price-sale-doc  ,
     4122                        first buf1-bar-code no-lock where
     4123                             buf1-bar-code.b-code   = pp_price-list.b-code and
     4124                             buf1-bar-code.unit-cli = buf_goods.unit-base
     4125                       :
     4126                       if  pp_price-list.b-code = f-base-code (pp_price-list.b-code) then next .
     4127                       check-par = true  .
     4128                       leave.
     4129                   end.
     4130               if check-par = true then next.
     4131               if par-pr-equ-dq = 2 then do:
     4132                     if  ( v-num <= 2  and check-par = false ) then
     4133                         run gbl/d-askw.w
     4134                           (input "Удалить строку?"
     4135                           ,input      "Предыдущая цена РАВНА цене по закрываемому документу " + chr(10)
     4136                                       + " Объект "  + v-cntxt-obj-type + String(v-cntxt-obj-code)
     4137                                       + " Артикул " + pdf_price-list.artic + " " +  buf_goods.gds-name + chr(10)
     4138                                       + " Бар-код " + string(pdf_price-list.b-code)
     4139                                       + " Цена по предыдущему документу переоценки № " + l-doc-num2 + " = "
     4140                                       + string(pdf_price-list.price-sale-doc) + chr(10)
     4141                                       + " Удалить строку? "
     4142                           ,input "|^"
     4143                           ,input "Да|Нет|Да для всех^confirm|Нет для всех^confirm"
     4144                           ,input "Удалить строку|"
     4145                               + "Не удалять строку|"
     4146                               + "Удалять у всех товаров, цена на которые не изменилась|"
     4147                               + "Не удалять у всех товаров, цена на которые не изменилась"
     4148                           ,input 1
     4149                           ,input 2
     4150                           ,output v-num
     4151                           ).
     4152                 end.
     4153                 else do:
     4154                   v-num = 3 .
     4155                 end.
     4156                   if v-num = 1 then do:
     4157                     run del-doc-line ( input recid(pdf_price-list)) no-error  .
     4158                                     if error-status :error then do:
     4159                                             message  vss-workfile vss-revision vss-description skip
     4160                                             "Ошибка при удаление строки ДНЦ"
     4161                                             pdf_price-list.b-code skip
     4162                                             error-status :get-message(1) .
     4163                                             return error.
     4164                                     end.
     4165                   end.
     4166                   if v-num = 3  then do:
     4167                      run del-doc-line ( input recid(pdf_price-list)) no-error  .
     4168                   end.
     4169           end.
     4170          end.
     4171   end.
     4172     for each main_price-list no-lock where
     4173                 main_price-list.plt-id      = p-plt-id and
     4174                 main_price-list.plt-db-num  = p-plt-db-num and
     4175                 main_price-list.pdf-id      = p-pdf-id and
     4176                 main_price-list.pdf-db      = p-pdf-db
     4177                 :
     4178                 if main_price-list.b-code <> f-base-code (main_price-list.b-code) then next.
     4179                   for each pp_price-list no-lock where
     4180                             pp_price-list.plt-id       = main_price-list.plt-id     and
     4181                             pp_price-list.plt-db-num   = main_price-list.plt-db-num and
     4182                             pp_price-list.pdf-id       = main_price-list.pdf-id     and
     4183                             pp_price-list.pdf-db       = main_price-list.pdf-db     and
     4184                             pp_price-list.artic        = main_price-list.artic      and
     4185                             pp_price-list.prod-type    = main_price-list.prod-type  and
     4186                             pp_price-list.prod-code    = main_price-list.prod-code  and
     4187                             pp_price-list.b-code      <> main_price-list.b-code     and
     4188                             pp_price-list.price-sale-doc = main_price-list.price-sale-doc  ,
     4189                       first buf_goods no-lock where
     4190                             buf_goods.artic     =  pp_price-list.artic and
     4191                             buf_goods.prod-type =  pp_price-list.prod-type and
     4192                             buf_goods.prod-code =  pp_price-list.prod-code ,
     4193                       first buf1-bar-code no-lock where
     4194                             buf1-bar-code.b-code   = pp_price-list.b-code and
     4195                             buf1-bar-code.unit-cli = buf_goods.unit-base
     4196                             :
     4197                             bbb = true .
     4198                             for each alt_price-list no-lock where
     4199                                     alt_price-list.plt-id     = pp_price-list.plt-id     and
     4200                                     alt_price-list.plt-db-num = pp_price-list.plt-db-num and
     4201                                     alt_price-list.pdf-id     = pp_price-list.pdf-id     and
     4202                                     alt_price-list.pdf-db     = pp_price-list.pdf-db     and
     4203                                     alt_price-list.artic      = pp_price-list.artic      and
     4204                                     alt_price-list.prod-type  = pp_price-list.prod-type  and
     4205                                     alt_price-list.b-code     <> main_price-list.b-code  and
     4206                                     alt_price-list.b-code     <> pp_price-list.b-code    and
     4207                                     alt_price-list.prod-code  = pp_price-list.prod-code ,
     4208                               first buf2_goods no-lock where
     4209                                     buf2_goods.artic     =  pp_price-list.artic     and
     4210                                     buf2_goods.prod-type =  pp_price-list.prod-type and
     4211                                     buf2_goods.prod-code =  pp_price-list.prod-code ,
     4212                               first buf2-bar-code no-lock where
     4213                                     buf2-bar-code.b-code   = alt_price-list.b-code and
     4214                                     buf2-bar-code.unit-cli <> buf2_goods.unit-base and
     4215                                     buf2-bar-code.node-code = buf1-bar-code.node-code
     4216                                   :
     4217                                   bbb = false.
     4218                                   leave.
     4219                             end.
     4220                             if bbb = true  then do:
     4221                                 run del-doc-line ( input recid (pp_price-list)) no-error  .
     4222                                 if error-status :error then do:
     4223                                     message  vss-workfile vss-revision vss-description skip
     4224                                     " Нельзя удалить " pp_price-list.b-code skip
     4225                                     error-status :get-message(1) .
     4226                                 end.
     4227                             end.
     4228                   end.
     4229     end.
     4230   end.
     4231   end procedure.
