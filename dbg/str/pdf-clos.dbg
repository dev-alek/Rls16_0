     1189                 buf_price-doc-forming.pdf-id     = p-pdf-id     and
     1190                 buf_price-doc-forming.plt-db-num = p-plt-db-num and
     1191                 buf_price-doc-forming.plt-id     = p-plt-id
     1192                 no-error .
