     3209   procedure create-price-list-mpl :
     3210   define input  parameter p-pdf-db-num  as integer   no-undo .
     3211   define input  parameter p-pdf-id      as integer   no-undo .
     3212   define input  parameter p-plt-db-num  as integer   no-undo .
     3213   define input  parameter p-plt-id      as integer   no-undo .
     3214   define output parameter p-price-doc-recid as recid no-undo .
     3215   define output parameter p-list-recid as character no-undo .
     3216   define buffer b_price-list-type   for ub.price-list-type   .
     3217   define buffer b_price-doc-forming for ub.price-doc-forming .
     3218   define buffer b_price-doc-forming-gds for ub.price-doc-forming-gds .
     3219   define buffer b_price-all         for ub.price-all .
     3220   define buffer b_price-doc         for ub.price-doc .
     3221   define buffer bufnew_price-list   for ub.price-list  .
     3222   define variable v-base as logical   no-undo .
     3223   define variable p-first-ie as integer   no-undo .
     3224   define variable p-first-iv as integer   no-undo .
     3225   define variable p-first-im as integer   no-undo .
     3226   define variable p-second-ie as integer   no-undo .
     3227   define variable p-second-iv as integer   no-undo .
     3228   define variable p-second-im as integer   no-undo .
     3229     do
     3230     on error undo, return error return-value
     3231     :
     3232   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3233   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     3234     (output v-base
     3235     )  .
     3236   p-list-recid = "".
     3237   find first b_price-list-type no-lock where
     3238              b_price-list-type.plt-id     = p-plt-id   and
     3239              b_price-list-type.plt-db-num = p-plt-db-num
     3240              no-error .
