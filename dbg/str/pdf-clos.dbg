     3851                   if buf_price-doc-forming.end-shift-date = buf_price-doc-forming.start-shift-date then do:
     3852                      if buf_price-doc-forming.end-shift-num < buf_price-doc-forming.start-shift-num then return error "Не верно задан интервал смен !" .
     3853                   end.
     3854               end.
     3855             when int('3':U)     then
     3856               do :
