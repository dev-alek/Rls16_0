     3858                   if buf_price-doc-forming.end-sys-date = buf_price-doc-forming.start-sys-date then do:
     3859                      if buf_price-doc-forming.end-sys-time < buf_price-doc-forming.start-sys-time then return error "Не верно задан интервал времени !" .
     3860                   end.
     3861               end.
     3862         end case.
