     1438     ,input  p-obj-code
     1439     ,input  yes
     1440     ,output p-plt-id
     1441     ,output p-plt-db-num
     1442     )  .
     1443      create ub.price-doc-forming.
     1444      assign
     1445         ub.price-doc-forming.plt-id       = p-plt-id
     1446         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     1447         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     1448         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     1449         ub.price-doc-forming.base-rate    = v-base-rate
     1450         ub.price-doc-forming.base-scale   = v-base-scale
     1451         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
     1452         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
     1453         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
     1454         ub.price-doc-forming.stts         = 0
     1455         ub.price-doc-forming.sys-date     = today
     1456         ub.price-doc-forming.sys-time     = time
     1457         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     1458         ub.price-doc-forming.who          = v-cntxt-userid
     1459         ub.price-doc-forming.name         = "автосоздание"
     1460      .
     1461      assign
     1462       p-pdf-db-num  = ub.price-doc-forming.pdf-db
     1463       p-pdf-id      = ub.price-doc-forming.pdf-id
     1464       p-plt-db-num  = ub.price-doc-forming.plt-db-num
     1465       p-plt-id      = ub.price-doc-forming.plt-id
     1466      .
     1467     end.
     1468   end procedure.
     1469   procedure prcreate-new-price-doc-forming-gds :
     1470   define input  parameter p-price-doc-forming-recid as recid  no-undo.
     1471   define input  parameter p-obj-type   as character no-undo .
     1472   define input  parameter p-obj-code   as integer   no-undo .
     1473   define input  parameter par-pr-notls as character no-undo .
     1474   define input  parameter par-pr-altex as character no-undo .
     1475   define input  parameter par-pr-sclex as character no-undo .
     1476   define input  parameter p-line-num    as integer   no-undo .
     1477   define input  parameter p-gds-code    as integer   no-undo .
     1478   define input  parameter p-price-sale  as decimal   no-undo .
     1479   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     1480   define buffer buf_goods for ub.goods  .
     1481   define buffer buf_bar-code for ub.bar-code  .
     1482   define buffer main_bar-code for ub.bar-code  .
     1483   define variable main-b-code as integer   no-undo .
     1484   define variable v-sec as integer   no-undo .
     1485     do
     1486     on error undo, return error return-value
     1487     :
     1488   define variable v-cur-dn as character no-undo .
     1489   define variable v-cur-pr as decimal   no-undo .
     1490   define variable v-cur-rt as decimal   no-undo .
     1491   define variable v-cur-ex as decimal   no-undo .
     1492   find first buf_price-doc-forming no-lock where
     1493              recid(buf_price-doc-forming) = p-price-doc-forming-recid  no-error .
     1494              if error-status :error then return error .
     1495   find first buf_goods no-lock where
     1496              buf_goods.gds-code  = p-gds-code no-error .
     1497              if error-status :error then return error .
     1498   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1499     (input  buf_goods.gds-code
     1500     ,input  ?
     1501     ,output main-b-code
     1502     ) no-error .
     1503   run check-use-bar-code (main-b-code) no-error .
     1504   if error-status :error then return .
     1505   run create-line-pdf-mpl-lib (
     1506        input buf_price-doc-forming.plt-db-num
     1507       ,input buf_price-doc-forming.plt-id
     1508       ,input buf_price-doc-forming.pdf-db
     1509       ,input buf_price-doc-forming.pdf-id
     1510       ,input p-line-num
     1511       ,input main-b-code
     1512       ,input buf_goods.artic
     1513       ,input buf_goods.prod-type
     1514       ,input buf_goods.prod-code
     1515       ,input ""
     1516       ,input 0
     1517       ,input p-price-sale
     1518       ,input ""
     1519       ,input 0
     1520      ,input-output v-sec ) no-error .
     1521      if error-status :error  then do:
     1522        message
     1523          vss-workfile vss-revision vss-description skip
     1524          error-status :get-message(1) skip
     1525          return-value skip
     1526          "2"
     1527          view-as alert-box error
     1528        .
     1529      end.
     1530   define buffer old_price-list for ub.price-list  .
     1531   if par-pr-notls = "yes" then do:
     1532   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1533   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1534     (input  p-obj-type
     1535     ,input  p-obj-code
     1536     ,input  main-b-code
     1537     ,input  0
     1538     ,input  0
     1539     ,output v-cur-dn
     1540     ,output v-cur-pr
     1541     ,output v-cur-rt
     1542     ,output v-cur-ex
     1543     )  .
     1544   end.
     1545   if par-pr-altex = "yes" and
     1546      par-pr-notls = "yes" then do:
     1547       if v-cur-dn <> "" then do:
     1548           for each old_price-list no-lock where
     1549                    old_price-list.doc-num = v-cur-dn and
     1550                    old_price-list.artic      = buf_goods.artic and
     1551                    old_price-list.prod-type  = buf_goods.prod-type and
     1552                    old_price-list.prod-code  = buf_goods.prod-code and
     1553                    old_price-list.main-price = no,
     1554                   first buf_bar-code no-lock where
     1555                         buf_bar-code.b-code   = old_price-list.b-code and
     1556                         buf_bar-code.unit-cli <> buf_goods.unit-base
     1557                         :
     1558                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     1559                          if error-status :error then next.
     1560                    run create-line-pdf-mpl-lib (
     1561                          input buf_price-doc-forming.plt-db-num
     1562                         ,input buf_price-doc-forming.plt-id
     1563                         ,input buf_price-doc-forming.pdf-db
     1564                         ,input buf_price-doc-forming.pdf-id
     1565                         ,input p-line-num
     1566                         ,input old_price-list.b-code
     1567                         ,input buf_goods.artic
     1568                         ,input buf_goods.prod-type
     1569                         ,input buf_goods.prod-code
     1570                         ,input ""
     1571                         ,input 0
     1572                         ,input old_price-list.price-sale
     1573                         ,input ""
     1574                         ,input 0
     1575                        ,input-output v-sec ) no-error .
     1576           end.
     1577       end.
     1578   end.
     1579   if par-pr-sclex = "yes" and
     1580      par-pr-notls = "yes" then do:
     1581       if v-cur-dn <> "" then do:
     1582           for each old_price-list no-lock where
     1583                    old_price-list.doc-num    = v-cur-dn and
     1584                    old_price-list.artic      = buf_goods.artic and
     1585                    old_price-list.prod-type  = buf_goods.prod-type and
     1586                    old_price-list.prod-code  = buf_goods.prod-code and
     1587                    old_price-list.main-price = no,
     1588                   first buf_bar-code no-lock where
     1589                         buf_bar-code.b-code   = old_price-list.b-code and
     1590                         buf_bar-code.in-code  = "" and
     1591                         buf_bar-code.unit-cli = buf_goods.unit-base
     1592                         :
     1593                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     1594                          if error-status :error then next.
     1595                    run create-line-pdf-mpl-lib (
     1596                          input buf_price-doc-forming.plt-db-num
     1597                         ,input buf_price-doc-forming.plt-id
     1598                         ,input buf_price-doc-forming.pdf-db
     1599                         ,input buf_price-doc-forming.pdf-id
     1600                         ,input p-line-num
     1601                         ,input old_price-list.b-code
     1602                         ,input buf_goods.artic
     1603                         ,input buf_goods.prod-type
     1604                         ,input buf_goods.prod-code
     1605                         ,input ""
     1606                         ,input 0
     1607                         ,input old_price-list.price-sale
     1608                         ,input ""
     1609                         ,input 0
     1610                       ,input-output v-sec ) no-error .
     1611           end.
     1612       end.
     1613   end.
     1614   end.
     1615   end procedure.
     1616   procedure copy_new_price-doc-forming :
     1617   define input  parameter       p-recid      as recid no-undo .
     1618   define input-output parameter p-plt-db-num as integer   no-undo .
     1619   define input-output parameter p-plt-id     as integer   no-undo .
     1620   define output parameter       p-pdf-db-num as integer   no-undo .
     1621   define output parameter       p-pdf-id     as integer   no-undo .
     1622   define buffer buf_price-list-type        for ub.price-list-type  .
     1623   define buffer buf_price-doc-forming      for ub.price-doc-forming .
     1624   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr .
     1625   define buffer buf_price-doc-forming-gds  for ub.price-doc-forming-gds .
     1626   define buffer buf_pd-forming-gds-attr    for ub.price-doc-forming-gdsattr .
     1627   define variable v-host-code  as integer   no-undo .
     1628   define variable v-base-rate  as decimal   no-undo .
     1629   define variable v-base-scale as integer   no-undo .
     1630   define variable v-exch-rate  as decimal   no-undo .
     1631   define variable v-exch-scale as integer   no-undo .
     1632   define variable v-base as logical   no-undo .
     1633   define variable v-name as character no-undo .
     1634     do
     1635     on error undo, return error return-value
     1636     :
     1637   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1638   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     1639     (output v-base
     1640     )  .
     1641   find first buf_price-list-type no-lock where
     1642              buf_price-list-type.plt-db-num = p-plt-db-num and
     1643              buf_price-list-type.plt-id     = p-plt-id no-error .
     1644   if error-status :error then return error "Не найден ТПЛ".
     1645   if buf_price-list-type.stts <> 0 then return error "ТПЛ удален" .
     1646   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming )  = p-recid no-error .
     1647       if available buf_price-doc-forming then do :
     1648           assign
     1649             v-base-rate  = buf_price-doc-forming.base-rate
     1650             v-base-scale = buf_price-doc-forming.base-scale
     1651             v-name       =  substitute("Скопировано с ДНЦ &1 &2",  buf_price-doc-forming.pdf-id , trim(buf_price-doc-forming.name)  )
     1652           .
     1653       end.
     1654       else do:
     1655           assign
     1656             v-base-rate  = 1
     1657             v-base-scale = 1
     1658             v-name       = "Автосоздание"
     1659           .
     1660       end.
     1661      create ub.price-doc-forming.
     1662      assign
     1663         ub.price-doc-forming.plt-id       = p-plt-id
     1664         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     1665         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     1666         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     1667         ub.price-doc-forming.base-rate    = v-base-rate
     1668         ub.price-doc-forming.base-scale   = v-base-scale
     1669         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
     1670         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
     1671         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
     1672         ub.price-doc-forming.stts         = 0
     1673         ub.price-doc-forming.sys-date     = today
     1674         ub.price-doc-forming.sys-time     = time
     1675         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     1676         ub.price-doc-forming.who          = v-cntxt-userid
     1677         ub.price-doc-forming.name         = v-name
     1678      .
     1679      assign
     1680       p-pdf-db-num  = ub.price-doc-forming.pdf-db
     1681       p-pdf-id      = ub.price-doc-forming.pdf-id
     1682       p-plt-db-num  = ub.price-doc-forming.plt-db-num
     1683       p-plt-id      = ub.price-doc-forming.plt-id
     1684      .
     1685     end.
     1686     if not available buf_price-doc-forming then return .
     1687   for each buf_price-doc-forming-attr no-lock where
     1688            buf_price-doc-forming-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     1689            buf_price-doc-forming-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     1690            buf_price-doc-forming-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1691            buf_price-doc-forming-attr.plt-id      = buf_price-doc-forming.plt-id       :
     1692       create ub.price-doc-forming-attr.
     1693       buffer-copy buf_price-doc-forming-attr to ub.price-doc-forming-attr
     1694       assign
     1695         ub.price-doc-forming-attr.plt-db-num  = p-plt-db-num
     1696         ub.price-doc-forming-attr.plt-id      = p-plt-id
     1697         ub.price-doc-forming-attr.pdf-db     = p-pdf-db-num
     1698         ub.price-doc-forming-attr.pdf-id      = p-pdf-id
     1699         .
     1700   end.
     1701   for each buf_price-doc-forming-gds no-lock where
     1702            buf_price-doc-forming-gds.pdf-db      = buf_price-doc-forming.pdf-db       and
     1703            buf_price-doc-forming-gds.pdf-id      = buf_price-doc-forming.pdf-id       and
     1704            buf_price-doc-forming-gds.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1705            buf_price-doc-forming-gds.plt-id      = buf_price-doc-forming.plt-id       :
     1706       create ub.price-doc-forming-gds.
     1707       buffer-copy buf_price-doc-forming-gds to ub.price-doc-forming-gds
     1708       assign
     1709         ub.price-doc-forming-gds.plt-db-num  = p-plt-db-num
     1710         ub.price-doc-forming-gds.plt-id      = p-plt-id
     1711         ub.price-doc-forming-gds.pdf-db      = p-pdf-db-num
     1712         ub.price-doc-forming-gds.pdf-id      = p-pdf-id
     1713       .
     1714   end.
     1715   for each buf_pd-forming-gds-attr no-lock where
     1716            buf_pd-forming-gds-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     1717            buf_pd-forming-gds-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     1718            buf_pd-forming-gds-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1719            buf_pd-forming-gds-attr.plt-id      = buf_price-doc-forming.plt-id       :
     1720       create ub.price-doc-forming-gdsattr.
     1721       buffer-copy buf_pd-forming-gds-attr to ub.price-doc-forming-gdsattr
     1722       assign
     1723         ub.price-doc-forming-gdsattr.plt-db-num  = p-plt-db-num
     1724         ub.price-doc-forming-gdsattr.plt-id      = p-plt-id
     1725         ub.price-doc-forming-gdsattr.pdf-db      = p-pdf-db-num
     1726         ub.price-doc-forming-gdsattr.pdf-id      = p-pdf-id
     1727       .
     1728   end.
     1729   end procedure.
     1730   define variable par-pr-incpc as character no-undo.
     1731   define variable par-pr-rndmt as character no-undo.
     1732   define variable par-pr-rndbs as character no-undo.
     1733   define variable par-pr-clt-q as character no-undo.
     1734   define variable par-pr-dpl-q as character no-undo.
     1735   define variable par-pr-rdc-q as character no-undo.
     1736   define variable par-pr-abs-d as character no-undo.
     1737   define variable par-pr-altex as character no-undo.
     1738   define variable par-pr-parex as character no-undo.
     1739   define variable par-pr-sclex as character no-undo.
     1740   define variable par-pr-notls as character no-undo.
     1741   define variable par-pr-equ-dq as integer  no-undo.
     1742   define variable par-pr-discm as character no-undo .
     1743   define variable par-pr-dscnt as character no-undo .
     1744   define variable par-pr-print as character no-undo .
     1745   define variable par-pr-sigma as character no-undo .
     1746   define variable par-pr-goods as character no-undo.
     1747   define variable par-pr-nogds as character no-undo.
     1748   define variable par-alcohol  as character no-undo.
     1749   define variable par-gen-mrgn-ie as character no-undo .
     1750   define variable par-gen-mrgn-iv as character no-undo .
     1751   define variable par-gen-mrgn-im as character no-undo .
     1752   define variable par-pr-nakl-ie  as logical   no-undo .
     1753   define variable par-pr-nakl-iv  as logical   no-undo .
     1754   define variable par-pr-nakl-im  as logical   no-undo .
     1755   define variable par-pr-nogds-long as longchar no-undo .
     1756   define temp-table tmp-proof-price no-undo
     1757     field node-code like ub.gds-grp.node-code
     1758     field proof as decimal
     1759     field price as decimal
     1760   index pi node-code proof descending .
     1761   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1762   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1763   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     1764   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     1765   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     1766   ASSIGN
     1767      v-S_CONTRACT                = "Contract":U
     1768      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     1769      v-DELIM_CHR_3               = ","
     1770      .
     1771   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     1772   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     1773   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1774   FUNCTION Can-Find-Spec RETURN LOGICAL (
     1775      INPUT iHost-Code    AS INTEGER,
     1776      INPUT iContract-Num AS INTEGER,
     1777      INPUT iGds-Code     AS INTEGER ):
     1778      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     1779      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     1780      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     1781      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1782      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     1783      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     1784          INPUT  iHost-Code,
     1785          INPUT  iContract-Num,
     1786          OUTPUT iTmp-Extent3
     1787          ).
     1788      IF iTmp-Extent3[1] = 2 THEN DO:
     1789         ASSIGN
     1790            iTmp-Host-Code      = iTmp-Extent3[2]
     1791            iTmp-Contract-Num   = iTmp-Extent3[3]
     1792            .
     1793      END. ELSE DO:
     1794         ASSIGN
     1795            iTmp-Host-Code      = iHost-Code
     1796            iTmp-Contract-Num   = iContract-Num
     1797            .
     1798      END.
     1799      IF iGds-Code = ? THEN DO:
     1800         ASSIGN
     1801            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1802                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1803                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1804                           ).
     1805      END. ELSE DO:
     1806            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1807                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1808                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1809                              AND buf_Spec.Gds-Code      = iGds-Code
     1810                            ).
     1811      END.
     1812      RETURN (lRet).
     1813   END FUNCTION.
     1814   PROCEDURE MS-Contract-EXTENT-3:
     1815      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     1816      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     1817      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     1818      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1819      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1820      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     1821      FIND FIRST buf_Cont-2 WHERE
     1822                 buf_Cont-2.Host-Code      = i-Host-Code
     1823             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     1824           NO-LOCK NO-ERROR.
     1825      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     1826         RETURN.
     1827      END.
     1828      FOR FIRST buf_Ext-Classif WHERE
     1829                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1830           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1831                                               STRING(i-Contract-code)
     1832           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1833          NO-LOCK,
     1834          EACH buf_Cont WHERE
     1835               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1836           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1837          NO-LOCK:
     1838          ASSIGN
     1839             i-Ret[1] = 1
     1840             i-Ret[2] = buf_Cont.Host-code
     1841             i-Ret[3] = buf_Cont.Contract-code
     1842             .
     1843          LEAVE.
     1844      END.
     1845      IF i-Ret[1] <> 1 THEN DO:
     1846         FOR FIRST buf_Ext-Classif WHERE
     1847                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1848              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1849                                                  STRING(i-Contract-code)
     1850              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1851             NO-LOCK,
     1852             EACH buf_Cont WHERE
     1853                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1854              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1855             NO-LOCK:
     1856             ASSIGN
     1857                i-Ret[1] = 2
     1858                i-Ret[2] = buf_Cont.Host-code
     1859                i-Ret[3] = buf_Cont.Contract-code
     1860                .
     1861             LEAVE.
     1862         END.
     1863      END.
     1864      RETURN.
     1865   END PROCEDURE.
