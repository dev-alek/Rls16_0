     3802     end.
     3803      if buf_price-doc-forming.have-start-period = integer(true) then do:
     3804         case buf_price-list-type.work-date :
     3805             when int('1':U)     then
     3806               do :
     3807                  if buf_price-doc-forming.start-date = ? then return error "Не задана дата начала действия цен !" .
     3808               end.
     3809             when int('2':U)   then
     3810               do :
     3811                   if buf_price-doc-forming.start-shift-date = ? then return error "Не задана сменная дата начала действия цен !" .
