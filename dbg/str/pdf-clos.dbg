     6154                 p-ask-pr  ) no-error .
     6155                 if error-status :error then do:
     6156                     run write-log-and-file in p-log-handle (
     6157                           input 1
     6158                         , input log-file-name
     6159                         , input 1
     6160                         , input substitute("Создание и закрытие подчиненных ДНЦ ...&1 &2   ",error-status :get-message(1),return-value)).
     6161                 end.
     6162      end.
     6163   procedure exp-prt :
     6164   define input  param g-code  like ub.goods.gds-code    no-undo.
     6165   define input  param old-num like ub.price-doc.doc-num no-undo.
     6166   define input  param new-num like ub.price-doc.doc-num no-undo.
     6167   define output param new-rec as recid               no-undo.
     6168   end procedure.
     6169   procedure dfc-create-date :
     6170   define variable v-shift-date as date      no-undo .
     6171   define variable v-shift-num  as integer   no-undo .
     6172   define variable v-shift-name as character no-undo .
     6173   define variable v-obj-date   as date      no-undo .
     6174   define variable l-shift-on as logical   no-undo .
     6175     do
     6176     on error undo, return error return-value
     6177     :
     6178   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6179   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     6180     (input  v-cntxt-obj-type
     6181     ,input  v-cntxt-obj-code
     6182     ,output v-obj-date
     6183     ) no-error .
     6184     if error-status :error then do:
     6185       run write-log-and-file in p-log-handle (
     6186             input 1
     6187           , input log-file-name
     6188           , input 1
     6189           , input substitute("curobjdt: &1 &2 объект &3&4  " , error-status :get-message(1),return-value,v-cntxt-obj-type, v-cntxt-obj-code )).
     6190     end.
     6191   define variable vss-include-info73 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6192   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     6193     (input  v-cntxt-obj-type
     6194     ,input  v-cntxt-obj-code
     6195     ,input  'shift-on=request':U
     6196     ,output l-shift-on
     6197     ) no-error .
     6198     if error-status :error then do:
     6199       run write-log-and-file in p-log-handle (
     6200             input 1
     6201           , input log-file-name
     6202           , input 1
     6203           , input substitute("objat: &1 &2 объект &3&4" , error-status :get-message(1),return-value,v-cntxt-obj-type, v-cntxt-obj-code )).
     6204     end.
     6205   if l-shift-on then do:
     6206   define variable vss-include-info74 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6207   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     6208     (input  v-cntxt-obj-type
     6209     ,input  v-cntxt-obj-code
     6210     ,output v-shift-date
     6211     ,output v-shift-num
     6212     ,output v-shift-name
     6213     ) no-error .
     6214     if error-status :error then do:
     6215       run write-log-and-file in p-log-handle (
     6216             input 1
     6217           , input log-file-name
     6218           , input 1
     6219           , input substitute("curshift: &1 &2 объект &3&4" , error-status :get-message(1),return-value,v-cntxt-obj-type, v-cntxt-obj-code )).
     6220     end.
     6221   end.
     6222      if buf_price-doc-forming.have-start-period = integer( false ) then do:
     6223         case buf_price-list-type.work-date :
     6224             when int('1':U)     then
     6225               do :
     6226                  buf_price-doc-forming.start-date = v-obj-date .
     6227               end.
     6228             when int('2':U)   then
     6229               do :
     6230                    assign
     6231                       buf_price-doc-forming.start-shift-date  = v-shift-date
     6232                       buf_price-doc-forming.start-shift-num   = v-shift-num
     6233                       buf_price-doc-forming.start-shift-name  = v-shift-name
     6234                       .
     6235               end.
     6236             when int('3':U)     then
     6237               do :
     6238                   buf_price-doc-forming.start-sys-date = today .
     6239               end.
     6240         end case.
     6241         buf_price-doc-forming.start-sys-time = time .
     6242      end.
     6243     end.
     6244   end procedure.
     6245   procedure dfc-pr-good :
     6246     do
     6247     on error undo, return error return-value
     6248     :
     6249       define variable v-type-goods as integer   no-undo .
     6250       define variable i as integer   no-undo .
     6251       define variable is-petrolium as logical   no-undo .
     6252       define variable is-pieces    as logical   no-undo .
     6253       define variable v-next as logical   no-undo .
     6254       if par-pr-goods = "" or num-entries (par-pr-goods,".") <> 2 then v-type-goods = integer('1':U) .
     6255       repeat i = 1 to 8 :
     6256         if par-pr-goods begins string(i) + "."  then  do:
     6257           v-type-goods = i .
     6258           leave.
     6259         end.
     6260       end.
     6261     v-errstr = "" .
     6262         for each buf_price-doc-forming-gds  where
     6263                  buf_price-doc-forming-gds.pdf-id = buf_price-doc-forming.pdf-id and
     6264                  buf_price-doc-forming-gds.pdf-db = buf_price-doc-forming.pdf-db and
     6265                  buf_price-doc-forming-gds.plt-id = buf_price-doc-forming.plt-id and
     6266                  buf_price-doc-forming-gds.plt-db = buf_price-doc-forming.plt-db
     6267         :
     6268           find first buf_goods no-lock
     6269             where buf_goods.artic     = buf_price-doc-forming-gds.artic
     6270               and buf_goods.prod-type = buf_price-doc-forming-gds.prod-type
     6271               and buf_goods.prod-code = buf_price-doc-forming-gds.prod-code
     6272             no-error .
     6273   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     6274     (
     6275        input buf_goods.artic
     6276     ,  input buf_goods.prod-type
     6277     ,  input buf_goods.prod-code
     6278     , output is-petrolium
     6279     , output is-pieces
     6280     ) .
     6281     if g#esys
     6282     then do :
     6283       v-next = true .
     6284     end.
     6285     else do :
     6286       run ver-pr-nogds ( input  buf_goods.gds-code , input par-pr-nogds, output v-next , output v-errstr ) .
     6287     end.
     6288     if not v-next then do:
     6289       case string(v-type-goods) :
     6290       when '8':U       then do:
     6291         v-errstr = "Запрет на включение в переоценку товаров, услуг и топлива." .
     6292               return error v-errstr .
     6293       end.
     6294       when '2':U     then do:
     6295           if buf_goods.gds-type = 'т':U  and is-petrolium = false  then do:
     6296             v-errstr = substitute("Запрет на добавление товаров в переоценку. " , buf_goods.artic, buf_goods.gds-name, buf_goods.gds-type ) .
     6297               return error v-errstr .
     6298           end.
     6299       end.
     6300       when '3':U    then do:
     6301           if is-petrolium then do:
     6302              v-errstr = substitute("Запрет на добавление топлива в переоценку. " , buf_goods.artic, buf_goods.gds-name ) .
     6303               return error v-errstr .
     6304           end.
     6305       end.
     6306       when '4':U      then do:
     6307           if buf_goods.gds-type = 'у':U then do:
     6308              v-errstr = substitute("Запрет на добавление услуг в переоценку. " , buf_goods.artic, buf_goods.gds-name, buf_goods.gds-type ) .
     6309               return error v-errstr .
     6310           end.
     6311       end.
     6312       when '5':U  then do:
     6313           if buf_goods.gds-type = 'т':U and is-petrolium = false  then do:
     6314              v-errstr = substitute("Запрет на добавление товаров и услуг в переоценку. " , buf_goods.artic, buf_goods.gds-name, buf_goods.gds-type , buf_goods.unit-base ) .
     6315               return error v-errstr .
     6316           end.
     6317           if buf_goods.gds-type = 'у':U then do:
     6318              v-errstr = substitute("Запрет на добавление товаров и услуг в переоценку. " , buf_goods.artic, buf_goods.gds-name, buf_goods.gds-type ) .
     6319               return error v-errstr .
     6320           end.
     6321       end.
     6322       when '6':U  then do:
     6323           if buf_goods.gds-type <> 'у':U  then do:
     6324              v-errstr = substitute("Запрет на добавление топлива и товара в переоценку. " , buf_goods.artic, buf_goods.gds-name, buf_goods.gds-type, buf_goods.unit-base ) .
     6325               return error v-errstr .
     6326           end.
     6327       end.
     6328       when '7':U then do:
     6329           if buf_goods.gds-type = 'т':U and is-petrolium = true   then do:
     6330             v-errstr = substitute("Запрет на добавление услуг и топлива в переоценку. " , buf_goods.artic, buf_goods.gds-name, buf_goods.unit-base ) .
     6331               return error v-errstr .
     6332           end.
     6333           if buf_goods.gds-type = 'у':U then do:
     6334              v-errstr = substitute("Запрет на добавление услуг и топлива в переоценку. " , buf_goods.artic, buf_goods.gds-name, buf_goods.gds-type ) .
     6335               return error v-errstr .
     6336           end.
     6337       end.
     6338     end case.
     6339     end.
     6340   end.
     6341     end.
     6342   end procedure.
