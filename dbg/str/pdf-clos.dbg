     1212     )  .
     1213       v-obj-current-date  = today .
     1214       if not (buf_price-doc-forming.base-rate = 0 or buf_price-doc-forming.base-rate = ?) then do:
     1215           v-base-rate   =  buf_price-doc-forming.base-rate  .
