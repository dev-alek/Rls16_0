       12   define variable p-trn-doc     as character no-undo .
       13   define variable p-ask-pr      as logical   no-undo .
       14   define variable p-do      as logical   no-undo .
       15   define variable p-auto      as logical   no-undo .
       16   define variable log-file-name                as character      no-undo init "pdf-clos.txt".
       17   define variable o-db-num as integer   no-undo .
