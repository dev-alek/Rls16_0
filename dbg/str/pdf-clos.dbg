     3286                 bb_price-doc-forming-attr.pdf-db       = p-pdf-db-num   and
     3287                 bb_price-doc-forming-attr.attr-code    = 'first-price':U   no-error .
     3288         if available bb_price-doc-forming-attr then do:
     3289             if buf_trn-doc.ext-doc-type = 'ie':U and p-first-ie = 0 then v-make = false .
     3290             if buf_trn-doc.ext-doc-type = 'iv':U and p-first-iv = 0 then v-make = false .
     3291             if buf_trn-doc.ext-doc-type = 'im':U  and p-first-im = 0 then v-make = false .
     3292         end.
     3293         else do:
     3294             if buf_trn-doc.ext-doc-type = 'ie':U and p-second-ie = 0 then v-make = false .
     3295             if buf_trn-doc.ext-doc-type = 'iv':U and p-second-iv = 0 then v-make = false .
     3296             if buf_trn-doc.ext-doc-type = 'im':U  and p-second-im = 0 then v-make = false .
     3297         end.
     3298   end.
     3299   define variable p-update as logical   no-undo .
     3300   define buffer   b_bar-code for ub.bar-code  .
     3301   define variable p-recid-str as recid no-undo .
     3302     for each x_obj-group where v-make = true or (x_obj-group.obj-code = v-cntxt-obj-code and x_obj-group.obj-type = v-cntxt-obj-type) no-lock :
     3303         if x_obj-group.db-num <> v-cntxt-db-num and v-cntxt-db-num <> 0 then next .
     3304         run prcreate-new-price-doc in this-procedure
     3305             ( input v-cntxt-db-num ,
     3306               input x_obj-group.obj-type  ,
     3307               input x_obj-group.obj-code   ,
     3308               input p-plt-id      ,
     3309               input p-plt-db-num  ,
     3310               input p-pdf-id      ,
     3311               input p-pdf-db-num  ,
     3312               output p-price-doc-recid
     3313               ) .
     3314           p-list-recid = p-list-recid + string(p-price-doc-recid) + "," .
     3315           find first b_price-doc no-lock where recid(b_price-doc) = p-price-doc-recid no-error .
     3316           if error-status :error then message
     3317             vss-workfile vss-revision vss-description skip
     3318             error-status :get-message(1) skip
     3319             return-value skip
     3320             "3"
     3321             view-as alert-box error
     3322           .
     3323           for each  ub.price-doc-forming-attr exclusive-lock where
     3324                     ub.price-doc-forming-attr.plt-id       = p-plt-id       and
     3325                     ub.price-doc-forming-attr.plt-db-num   = p-plt-db-num   and
     3326                     ub.price-doc-forming-attr.pdf-id       = p-pdf-id       and
     3327                     ub.price-doc-forming-attr.pdf-db       = p-pdf-db-num :
     3328                 find first ub.doc-attr exclusive-lock where
     3329                            ub.doc-attr.doc-code  = b_price-doc.doc-num  and
     3330                            ub.doc-attr.attr-code = ub.price-doc-forming-attr.attr-code no-error .
     3331                        if not available ub.doc-attr then create ub.doc-attr.
     3332                        assign
     3333                           ub.doc-attr.doc-code   = b_price-doc.doc-num
     3334                           ub.doc-attr.attr-code  = ub.price-doc-forming-attr.attr-code
     3335                           ub.doc-attr.attr-value = ub.price-doc-forming-attr.attr-value
     3336                        .
     3337           end.
     3338           for each b_price-all exclusive-lock where
     3339              b_price-all.pdf-db     = p-pdf-db-num and
     3340              b_price-all.pdf-id     = p-pdf-id     and
     3341              b_price-all.plt-db-num = p-plt-db-num and
     3342              b_price-all.plt-id     = p-plt-id and
     3343              b_price-all.obj-type   =  x_obj-group.obj-type and
     3344              b_price-all.obj-code   =  x_obj-group.obj-code and
     3345              b_price-all.main-indication <= 1 :
     3346              find first b_price-doc-forming-gds no-lock where
     3347                         b_price-doc-forming-gds.b-code     = b_price-all.b-code and
     3348                         b_price-doc-forming-gds.pdf-db     = p-pdf-db-num and
     3349                         b_price-doc-forming-gds.pdf-id     = p-pdf-id     and
     3350                         b_price-doc-forming-gds.plt-db-num = p-plt-db-num and
     3351                         b_price-doc-forming-gds.plt-id     = p-plt-id
     3352                         no-error .
     3353              find first b_bar-code no-lock where  b_bar-code.b-code = b_price-all.b-code no-error .
     3354              if available b_bar-code then do:
     3355                     run cre-pr-list in this-procedure
     3356                     ( input  b_price-all.b-code
     3357                     , input  b_price-doc.doc-num
     3358                     , output p-recid-str).
     3359                     find first bufnew_price-list exclusive-lock where
     3360                         recid(bufnew_price-list) = p-recid-str no-error .
     3361                         if available bufnew_price-list then do:
     3362                             bufnew_price-list.calc-method =  b_price-doc-forming-gds.calc-method .
     3363                             bufnew_price-list.d-pcnt      =  b_price-doc-forming-gds.d-pcnt.
     3364                             if v-base then assign
     3365                               bufnew_price-list.road-tax   =  b_price-doc-forming-gds.road-tax-base
     3366                               bufnew_price-list.price-sale =  b_price-doc-forming-gds.price-sale-base
     3367                               bufnew_price-list.price-calc =  b_price-doc-forming-gds.price-calc-base
     3368                               bufnew_price-list.price-prev =  b_price-doc-forming-gds.price-prev-base
     3369                             .
     3370                             else assign
     3371                               bufnew_price-list.road-tax   =  b_price-doc-forming-gds.road-tax-rubl
     3372                               bufnew_price-list.price-sale =  b_price-doc-forming-gds.price-sale-rubl
     3373                               bufnew_price-list.price-calc =  b_price-doc-forming-gds.price-calc-rubl
     3374                               bufnew_price-list.price-prev =  b_price-doc-forming-gds.price-prev-rubl
     3375                             .
     3376                         end.
     3377                     if available b_price-doc then do:
     3378                         b_price-all.out-code   =  b_price-doc.doc-num .
     3379                     end.
     3380              end.
     3381           end.
     3382     end.
     3383     p-list-recid = trim (p-list-recid, "," ) .
     3384   end.
     3385   end procedure.
     3386   procedure proc-mpl-create-price-all :
     3387   DEFINE PARAMETER BUFFER b_price-list-type FOR ub.price-list-type         .
     3388   DEFINE PARAMETER BUFFER b_price-doc-forming FOR ub.price-doc-forming      .
     3389   define input  parameter v-curr-obj-date as date   no-undo .
     3390   define input  parameter p-main                   as integer   no-undo .
     3391   define input  parameter p-plt-id                 as integer   no-undo .
     3392   define input  parameter p-plt-db-num             as integer   no-undo .
     3393   define input  parameter p-pdf-id                 as integer   no-undo .
     3394   define input  parameter p-pdf-db-num             as integer   no-undo .
     3395   define input  parameter p-b-code                 as integer   no-undo .
     3396   define input  parameter p-gds-code               as integer   no-undo .
     3397   define input  parameter p-type-price             as integer   no-undo .
     3398   define input  parameter p-qnty-from              like  ub.price-doc-forming-gds-qnty.ggr-qnty no-undo .
     3399   define input  parameter p-qnty-to                like  ub.price-doc-forming-gds-qnty.ggr-qnty no-undo .
     3400   define input  parameter p-sum-from               as decimal   no-undo .
     3401   define input  parameter p-sum-to                 as decimal   no-undo .
     3402   define input  parameter p-turnover-from          as decimal   no-undo .
     3403   define input  parameter p-turnover-to            as decimal   no-undo .
     3404   define input  parameter p-fact-order-shift-from  as decimal   no-undo .
     3405   define input  parameter p-fact-order-shift-to    as decimal   no-undo .
     3406   define input  parameter p-fact-order-sys-from    as decimal   no-undo .
     3407   define input  parameter p-fact-order-sys-to      as decimal   no-undo .
     3408   define input  parameter p-price-sale             as decimal   no-undo .
     3409   define input  parameter p-pay-code               as integer   no-undo .
     3410   define input  parameter p-cdpay-code             as integer   no-undo .
     3411   define input  parameter p-curr-pay-code          as integer   no-undo .
     3412     do
     3413     on error undo, return error return-value
     3414     :
     3415            create ub.price-all.
     3416            assign
     3417               ub.price-all.main-indication           = p-main
     3418               ub.price-all.status_                   = if b_price-list-type.main = false then 'акт':U else ""
     3419               ub.price-all.type-price                = p-type-price
     3420               ub.price-all.pal-db-num                = v-cntxt-db-num
     3421               ub.price-all.pal-id                    = next-value ( s-pal , ub )
     3422               ub.price-all.b-code                    = p-b-code
     3423               ub.price-all.gds-code                  = p-gds-code
     3424               ub.price-all.obj-code                  = x_obj-group.obj-code
     3425               ub.price-all.obj-type                  = x_obj-group.obj-TYPE
     3426               ub.price-all.bgr-db-num                = b_price-list-type.bgr-db-num
     3427               ub.price-all.bgr-id                    = b_price-list-type.bgr-id
     3428               ub.price-all.curr-code                 = b_price-list-type.curr-code
     3429               ub.price-all.pdf-id                    = p-pdf-id
     3430               ub.price-all.pdf-db                    = p-pdf-db-num
     3431               ub.price-all.pdf-base-rate             = b_price-doc-forming.base-rate
     3432               ub.price-all.pdf-base-scale            = b_price-doc-forming.base-scale
     3433               ub.price-all.pdf-exch-rate             = b_price-doc-forming.exch-rate
     3434               ub.price-all.pdf-exch-scale            = b_price-doc-forming.exch-scale
     3435               ub.price-all.plt-id                    = p-plt-id
     3436               ub.price-all.plt-db-num                = p-plt-db-num
     3437               ub.price-all.plt-fix-cource-crc-base   = b_price-list-type.fix-cource-crc-base
     3438               ub.price-all.plt-fix-cource-crc-doc    = b_price-list-type.fix-cource-crc-doc
     3439               ub.price-all.plt-priority              = b_price-list-type.priority
     3440               ub.price-all.plt-work-date             = b_price-list-type.work-date
     3441               ub.price-all.qnty-from                 = p-qnty-from
     3442               ub.price-all.qnty-to                   = p-qnty-to
     3443               ub.price-all.sum-from                  = p-sum-from
     3444               ub.price-all.sum-to                    = p-sum-to
     3445               ub.price-all.turnover-from             = p-turnover-from
     3446               ub.price-all.turnover-to               = p-turnover-to
     3447               ub.price-all.tog-db-num                = b_price-list-type.tog-db-num
     3448               ub.price-all.tog-id                    = b_price-list-type.tog-id
     3449               ub.price-all.use-cash-pay              = b_price-list-type.use-cash-pay
     3450               ub.price-all.use-pay-type              = b_price-list-type.use-pay-type
     3451               ub.price-all.price-sale                = p-price-sale
     3452               ub.price-all.start-date                =  if b_price-list-type.main = true then  v-curr-obj-date else b_price-doc-forming.start-date
     3453               ub.price-all.start-shift-date          =  b_price-doc-forming.start-shift-date
     3454               ub.price-all.start-shift-name          =  b_price-doc-forming.start-shift-name
     3455               ub.price-all.start-shift-num           =  b_price-doc-forming.start-shift-num
     3456               ub.price-all.start-sys-date            =  b_price-doc-forming.start-sys-date
     3457               ub.price-all.start-sys-time            =  b_price-doc-forming.start-sys-time
     3458               ub.price-all.end-date                  =  b_price-doc-forming.end-date
     3459               ub.price-all.end-shift-date            =  b_price-doc-forming.end-shift-date
     3460               ub.price-all.end-shift-name            =  b_price-doc-forming.end-shift-name
     3461               ub.price-all.end-shift-num             =  b_price-doc-forming.end-shift-num
     3462               ub.price-all.end-sys-date              =  b_price-doc-forming.end-sys-date
     3463               ub.price-all.end-sys-time              =  b_price-doc-forming.end-sys-time
     3464               ub.price-all.fact-order-shift-from     = p-fact-order-shift-from
     3465               ub.price-all.fact-order-shift-to       = p-fact-order-shift-to
     3466               ub.price-all.fact-order-sys-from       = p-fact-order-sys-from
     3467               ub.price-all.fact-order-sys-to         = p-fact-order-sys-to
     3468               ub.price-all.pay-code      = p-pay-code
     3469               ub.price-all.cdpay-code    = p-cdpay-code
     3470               ub.price-all.curr-pay-code = p-curr-pay-code
     3471               ub.price-all.extra-pcnt            = ?
     3472               ub.price-all.extra-round           = ?
     3473               ub.price-all.work-acc-price        = ?
     3474               no-error .
     3475               if error-status :error then do:
     3476                   run write-log-and-file in p-log-handle (
     3477                         input 1
     3478                       , input log-file-name
     3479                       , input 1
     3480                       , input substitute ( "Ошибка при создании таблицы цен для товара бар-код &5 на объекте &1 &2 &3 &4" , x_obj-group.obj-type , x_obj-group.obj-code, error-status :get-message(1) , return-value, p-b-code )).
     3481               end.
     3482     end.
     3483   end procedure.
     3484   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3485   define variable var-pr-r-b as character no-undo .
     3486   define variable v-str2 as character no-undo .
     3487   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3488   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3489     (output var-pr-r-b
     3490     )  .
     3491   function f-base-code return integer ( p-b-code as integer ).
     3492     define variable main-b-code as integer   no-undo .
     3493     define buffer buf_bar-code for ub.bar-code  .
     3494     find first buf_bar-code no-lock where
     3495               buf_bar-code.b-code = p-b-code no-error .
     3496   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3497     (input  buf_bar-code.gds-code
     3498     ,input  ?
     3499     ,output main-b-code
     3500     )  .
     3501     return (main-b-code).
     3502   end function.
     3503   function fnc-cost-pc return decimal (buffer local-price-list for ub.price-doc-forming-gds ).
     3504     define variable f-cost     as decimal no-undo .
     3505     define variable f-cost-pc  as decimal no-undo .
     3506     define variable v-qnty     as decimal no-undo .
     3507     define variable v-sum      as decimal no-undo .
     3508     define variable fact_price as decimal no-undo .
     3509     find first ub.goods where ub.goods.artic     = local-price-list.artic and
     3510                               ub.goods.prod-type = local-price-list.prod-type and
     3511                               ub.goods.prod-code = local-price-list.prod-code no-lock
     3512                               no-error .
     3513     assign
     3514       v-sum  =  0
     3515       v-qnty =  0
     3516       .
     3517     for each x_obj-group :
     3518         find ub.gds-obj no-lock where
     3519             ub.gds-obj.gds-code = ub.goods.gds-code and
     3520             ub.gds-obj.obj-type = x_obj-group.obj-type and
     3521             ub.gds-obj.obj-code = x_obj-group.obj-code no-error.
     3522         if  available ub.gds-obj then
     3523           if ub.goods.gds-type = 'т':U then
     3524             assign
     3525               v-sum  = v-sum  + ( if var-pr-r-b = "rubl" then ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base) * ub.gds-obj.avrg-qnty
     3526               v-qnty =  v-qnty + ub.gds-obj.avrg-qnty
     3527               .
     3528             else  v-sum = ?.
     3529         else v-sum = ?.
     3530     end.
     3531     f-cost = v-sum / v-qnty .
     3532     fact_price = if var-pr-r-b = "rubl" then local-price-list.price-sale-rubl else local-price-list.price-sale-base .
     3533     f-cost-pc = ( round ( fact_price / f-cost , 2 ) -  1 ) * 100.
     3534     return (f-cost-pc).
     3535   end function.
     3536   function fnc-pr-pc return decimal (buffer local-price-list for ub.price-doc-forming-gds ).
     3537   define variable f-pr     as decimal no-undo .
     3538   define variable f-pr-pc  as decimal no-undo.
     3539   define variable v-qnty as decimal   no-undo .
     3540   define variable v-sum as decimal   no-undo .
     3541   define variable fact_price as decimal   no-undo .
     3542   find first ub.goods where ub.goods.artic = local-price-list.artic and
     3543                          ub.goods.prod-type = local-price-list.prod-type and
     3544                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     3545    assign
     3546      v-sum  =  0
     3547      v-qnty =  0
     3548      .
     3549   for each x_obj-group :
     3550   find ub.gds-obj no-lock where
     3551        ub.gds-obj.gds-code = ub.goods.gds-code and
     3552        ub.gds-obj.obj-type = x_obj-group.obj-type and
     3553        ub.gds-obj.obj-code = x_obj-group.obj-code  no-error .
     3554   if  available ub.gds-obj then do:
     3555     if ub.goods.gds-type = 'т':U then
     3556       assign
     3557         f-pr = (if var-pr-r-b = "rubl" then ub.gds-obj.last-rubl else ub.gds-obj.last-base)
     3558         .
     3559       else f-pr = ?.
     3560   end.
     3561   else f-pr = ?.
     3562   end.
     3563     fact_price = if var-pr-r-b = "rubl" then local-price-list.price-sale-rubl else local-price-list.price-sale-base .
     3564     f-pr-pc = ( round( fact_price / f-pr , 2 ) - 1 ) * 100 .
     3565     return (f-pr-pc).
     3566   end function.
     3567   function fnc-cost return decimal (buffer local-price-list for ub.price-doc-forming-gds).
     3568   define variable f-cost   as decimal no-undo .
     3569   find first  x_obj-group.
     3570   find first ub.goods where ub.goods.artic = local-price-list.artic and
     3571                          ub.goods.prod-type = local-price-list.prod-type and
     3572                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     3573   find ub.gds-obj no-lock where
     3574        ub.gds-obj.gds-code = ub.goods.gds-code  and
     3575        ub.gds-obj.obj-type = x_obj-group.obj-type and
     3576        ub.gds-obj.obj-code = x_obj-group.obj-code
     3577        no-error.
     3578   if  available ub.gds-obj then
     3579     if ub.goods.gds-type = 'т':U then
     3580       assign
     3581         f-cost = if var-pr-r-b = "rubl" then ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base
     3582         .
     3583       else  f-cost = ?.
     3584   else f-cost = ?.
     3585     return ( f-cost ).
     3586   end function.
     3587   function fnc-pr return decimal (buffer local-price-list for ub.price-doc-forming-gds).
     3588   define variable f-pr   as decimal no-undo .
     3589   find first x_obj-group .
     3590   find first ub.goods where ub.goods.artic = local-price-list.artic and
     3591                          ub.goods.prod-type = local-price-list.prod-type and
     3592                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     3593   find ub.gds-obj no-lock where
     3594        ub.gds-obj.gds-code = ub.goods.gds-code and
     3595        ub.gds-obj.obj-type = x_obj-group.obj-type and
     3596        ub.gds-obj.obj-code = x_obj-group.obj-code
     3597        no-error.
     3598   if  available ub.gds-obj then
     3599     if ub.goods.gds-type = 'т':U then
     3600       assign
     3601         f-pr = if var-pr-r-b = "rubl" then ub.gds-obj.last-rubl  else ub.gds-obj.last-base
     3602         .
     3603       else  f-pr = ?.
     3604   else f-pr = ?.
     3605      return ( f-pr ).
     3606   end function.
     3607   procedure make-fact-order-lib3 :
     3608   define input  parameter p-recid as recid no-undo .
     3609   define output parameter p-fact-order-sys-from as decimal   no-undo .
     3610   define output parameter p-fact-order-sys-to   as decimal   no-undo .
     3611   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     3612   define buffer buf_price-list-type for ub.price-list-type  .
     3613   define variable v-shift-end-fact-order as decimal no-undo .
     3614   define variable v-day-end-fact-order   as decimal no-undo .
     3615   define variable v-fact-order           as decimal no-undo .
     3616     do
     3617     on error undo, return error return-value
     3618     :
     3619   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming ) = p-recid no-error .
     3620     if error-status :error then return error error-status :get-message(1) .
     3621   find first buf_price-list-type  no-lock where
     3622              buf_price-list-type.plt-id = buf_price-doc-forming.plt-id and
     3623              buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num no-error .
     3624     if error-status :error then return error error-status :get-message(1) .
     3625    if buf_price-doc-forming.have-start-period = 1 then do:
     3626       case buf_price-list-type.work-date :
     3627         when int('1':U)  then
     3628           do :
     3629              run day-begin-fact-order
     3630                   ( buf_price-doc-forming.start-date ,
     3631                    output p-fact-order-sys-from ) no-error .
     3632                    if error-status :error then
     3633                    return error substitute ( "Ошибка из day-begin-fact-order &1 &2" ,
     3634                                               error-status :get-message(1) ,
     3635                                               return-value ).
     3636           end.
     3637         when int('2':U)   then
     3638           do :
     3639             run factord (
     3640                input   buf_price-doc-forming.start-shift-date
     3641               ,input   buf_price-doc-forming.sys-time
     3642               ,input   1
     3643               ,input   buf_price-doc-forming.start-shift-date
     3644               ,input   buf_price-doc-forming.start-shift-num
     3645               ,input   true
     3646               ,output  p-fact-order-sys-from
     3647               ,output  v-shift-end-fact-order
     3648               ,output  v-day-end-fact-order
     3649               ) no-error  .
     3650               if error-status :error then
     3651                    return error substitute ( "Ошибка из factord &1 &2" ,
     3652                                               error-status :get-message(1) ,
     3653                                               return-value ).
     3654           end.
     3655         when int('3':U)   then
     3656           do :
     3657             run factord (
     3658               input    buf_price-doc-forming.start-sys-date
     3659               ,input   buf_price-doc-forming.start-sys-time
     3660               ,input   (if buf_price-doc-forming.start-sys-time = 0 or buf_price-doc-forming.start-sys-time = ? then 1 else buf_price-doc-forming.start-sys-time )
     3661               ,input   ?
     3662               ,input   ?
     3663               ,input   false
     3664               ,output  p-fact-order-sys-from
     3665               ,output  v-shift-end-fact-order
     3666               ,output  v-day-end-fact-order
     3667               ) no-error .
     3668               if error-status :error then
     3669                    return error substitute ( "Ошибка из factord  - дата сервера &1 &2" ,
     3670                                               error-status :get-message(1) ,
     3671                                               return-value ).
     3672           end.
     3673       end case.
     3674     end.
     3675    if buf_price-doc-forming.have-end-period = 1 then do:
     3676       case buf_price-list-type.work-date :
     3677         when int('1':U)   then
     3678           do :
     3679              run factord-end-day
     3680                 ( buf_price-doc-forming.end-date ,
     3681                   output p-fact-order-sys-to ) no-error .
     3682                   if error-status :error then
     3683                    return error substitute ( "Ошибка из factord-end-day дата на объекте на конец периода &1 &2" ,
     3684                                               error-status :get-message(1) ,
     3685                                               return-value ).
     3686           end.
     3687         when int('2':U)   then
     3688           do :
     3689             run factord (
     3690                input   buf_price-doc-forming.end-shift-date
     3691               ,input   buf_price-doc-forming.sys-time
     3692               ,input   1
     3693               ,input   buf_price-doc-forming.end-shift-date
     3694               ,input   buf_price-doc-forming.end-shift-num
     3695               ,input   true
     3696               ,output  v-fact-order
     3697               ,output  p-fact-order-sys-to
     3698               ,output  v-day-end-fact-order
     3699               ) no-error .
     3700               if error-status :error then
     3701                 return error substitute ( "Ошибка из factord сменная дата на конец &1 &2" ,
     3702                                           error-status :get-message(1) ,
     3703                                           return-value ).
     3704           end.
     3705         when int('3':U)   then
     3706           do :
     3707             run factord (
     3708                input   buf_price-doc-forming.end-sys-date
     3709               ,input   buf_price-doc-forming.end-sys-time
     3710               ,input   (if buf_price-doc-forming.end-sys-time  = 0 or buf_price-doc-forming.end-sys-time = ? then 1 else buf_price-doc-forming.end-sys-time )
     3711               ,input   ?
     3712               ,input   ?
     3713               ,input   false
     3714               ,output  p-fact-order-sys-to
     3715               ,output  v-shift-end-fact-order
     3716               ,output  v-day-end-fact-order
     3717               ) no-error .
     3718               if error-status :error then
     3719                 return error substitute ( "Ошибка из factord  - дата сервера &1 &2" ,
     3720                                           error-status :get-message(1) ,
     3721                                           return-value ).
     3722           end.
     3723       end case.
     3724     end.
     3725     end.
     3726   end procedure.
     3727   procedure ver-dfc-mpl-lib3 :
     3728   define input  parameter p-recid as recid no-undo .
     3729   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     3730   define buffer buf_price-list-type for ub.price-list-type  .
     3731   define buffer buf_price-doc-forming-gds for ub.price-doc-forming-gds  .
     3732   define buffer buf_price-doc-forming-gds-qnty for ub.price-doc-forming-gds-qnty  .
     3733   define buffer buf_price-doc-sum  for ub.price-doc-forming-gds-sum  .
     3734   define buffer buf_price-doc-forming-gds-tnv  for ub.price-doc-forming-gds-tnv  .
     3735   define variable v-fact-order-sys-from   as decimal   no-undo .
     3736   define variable v-fact-order-sys-to     as decimal   no-undo .
     3737     do
     3738     on error undo, return error return-value
     3739    :
     3740   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming ) = p-recid no-error .
     3741     if error-status :error then return error error-status :get-message(1) .
     3742   find first buf_price-list-type  no-lock where
     3743              buf_price-list-type.plt-id = buf_price-doc-forming.plt-id and
     3744              buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num no-error .
     3745     if error-status :error then return error error-status :get-message(1) .
     3746     if buf_price-list-type.stts = integer('1':U) then do:
     3747        return error substitute(" ТПЛ &1 в статусе УДАЛЕН ! Закрывать с ним новые ДНЦ нельзя !" , buf_price-list-type.name )  .
     3748     end.
     3749     if buf_price-list-type.bgr-id > 0 then do:
     3750         find ub.buyer-group where
     3751               ub.buyer-group.stts       = 0  and
     3752               ub.buyer-group.bgr-db-num = buf_price-list-type.bgr-db-num and
     3753               ub.buyer-group.bgr-id     = buf_price-list-type.bgr-id
     3754               no-lock no-error .
     3755         if not available ub.buyer-group then
     3756         return error substitute(" ТПЛ &1 содержит некорректную группу по покупателям &2(&3) !" , buf_price-list-type.name,buf_price-list-type.bgr-id,buf_price-list-type.bgr-db-num )  .
     3757     end.
     3758     if buf_price-list-type.sgr-id > 0 then do:
     3759         find ub.sum-group where
     3760               ub.sum-group.stts       = 0  and
     3761               ub.sum-group.sgr-db-num = buf_price-list-type.sgr-db-num and
     3762               ub.sum-group.sgr-id     = buf_price-list-type.sgr-id
     3763               no-lock no-error .
     3764         if not available ub.sum-group then
     3765         return error substitute(" ТПЛ &1 содержит некорректную суммовую группу &2(&3) !" , buf_price-list-type.name,buf_price-list-type.sgr-id,buf_price-list-type.sgr-db-num )  .
     3766     end.
     3767     if buf_price-list-type.qgr-id > 0 then do:
     3768         find ub.qnty-group where
     3769              ub.qnty-group.stts       = 0  and
     3770              ub.qnty-group.qgr-db-num = buf_price-list-type.qgr-db-num and
     3771              ub.qnty-group.qgr-id     = buf_price-list-type.qgr-id
     3772              no-lock no-error .
     3773         if not available ub.qnty-group then
     3774         return error substitute(" ТПЛ &1 содержит некорректную количественную группу &2(&3) !" , buf_price-list-type.name,buf_price-list-type.qgr-id,buf_price-list-type.qgr-db-num )  .
     3775     end.
     3776     if buf_price-list-type.tog-id > 0 then do:
     3777         find ub.turnover-group where
     3778              ub.turnover-group.stts       = 0  and
     3779              ub.turnover-group.tog-db-num = buf_price-list-type.tog-db-num and
     3780              ub.turnover-group.tog-id     = buf_price-list-type.tog-id
     3781             no-lock no-error .
     3782         if not available ub.turnover-group then
     3783         return error substitute(" ТПЛ &1 содержит некорректную группу по оборотам &2(&3) !" , buf_price-list-type.name , buf_price-list-type.tog-id , buf_price-list-type.tog-db-num )  .
     3784     end.
     3785     if buf_price-list-type.gop-id > 0 then do:
