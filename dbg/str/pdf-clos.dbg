     2059   procedure grp-obj-notcorr-value :
     2060   do
     2061   on error undo, return error
     2062   :
     2063   define input parameter p-node-code             as integer      no-undo.
     2064   define input parameter p-obj-type              as character    no-undo.
     2065   define input parameter p-obj-code              as integer      no-undo.
     2066   define output parameter p-notcorr              as character    no-undo init ?.
     2067   define output parameter p-range-notcorr     as integer      no-undo.
     2068   define output parameter p-exists-notcorr    as logical      no-undo.
     2069   define variable v-host-code as integer      no-undo.
     2070   DEFINE VARIABLE v-found as logical no-undo .
     2071   DEFINE VARIABLE v-exists as logical no-undo .
     2072   DEFINE VARIABLE v-range as integer no-undo .
     2073   DEFINE VARIABLE jj as integer no-undo .
     2074   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     2075   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     2076   define buffer buf_gds-grp for ub.gds-grp.
     2077   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     2078   find first buf_gds-grp no-lock where
     2079              buf_gds-grp.node-code = p-node-code no-error .
     2080   if not avail buf_gds-grp and p-node-code <> 0 then do:
     2081     message
     2082       vss-workfile vss-revision vss-description
     2083       skip "Не удалось найти группу товаров с кодом" p-node-code
     2084       view-as alert-box error .
     2085     undo, return error .
     2086   end.
     2087   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2088   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2089     (input  p-obj-type
     2090     ,input  p-obj-code
     2091     ,output v-host-code
     2092     ) no-error .
     2093   if error-status :error
     2094   then do:
     2095       message
     2096         vss-workfile vss-revision vss-description
     2097         skip "Не удалось найти фирму объекта"
     2098         skip p-obj-type p-obj-code
     2099         skip return-value
     2100         skip trim(error-status :get-message(1))
     2101       view-as alert-box error.
     2102       undo, return error .
     2103   end.
     2104   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     2105   do while v-found = no and jj < 2:
     2106     if v-range <> 3 then do:
     2107       find first buf_gds-grp-obj no-lock
     2108           where buf_gds-grp-obj.node-code = p-node-code
     2109             and buf_gds-grp-obj.host-code = v-host-code
     2110             and buf_gds-grp-obj.obj-type  = p-obj-type
     2111             and buf_gds-grp-obj.obj-code  = p-obj-code
     2112       no-error .
     2113     end.
     2114     if v-range = 3 or not available buf_gds-grp-obj
     2115     then do:
     2116        if v-range <> 2 then do:
     2117           find first buf_gds-grp-obj no-lock
     2118               where buf_gds-grp-obj.node-code = p-node-code
     2119                 and buf_gds-grp-obj.host-code = v-host-code
     2120                 and buf_gds-grp-obj.obj-type  = ""
     2121                 and buf_gds-grp-obj.obj-code  = 0
     2122           no-error .
     2123         end.
     2124         if v-range = 2 or not available buf_gds-grp-obj
     2125         then do:
     2126             if v-range <> 1 then do:
     2127               find first buf_gds-grp-obj no-lock
     2128                   where buf_gds-grp-obj.node-code = p-node-code
     2129                   and buf_gds-grp-obj.host-code = 0
     2130                   and buf_gds-grp-obj.obj-type  = ""
     2131                   and buf_gds-grp-obj.obj-code  = 0
     2132               no-error .
     2133             end.
     2134             if v-range = 1 or not available buf_gds-grp-obj
     2135             then do:
     2136                 assign
     2137                     v-exists = no
     2138                 .
     2139             end.
     2140             else do:
     2141                 assign
     2142                     v-exists = yes
     2143                     v-range = 1
     2144                 .
     2145             end.
     2146         end.
     2147         else do:
     2148             assign
     2149                 v-exists = yes
     2150                 v-range  = 2
     2151             .
     2152         end.
     2153     end.
     2154     else do:
     2155         assign
     2156             v-exists = yes
     2157             v-range  = 3
     2158         .
     2159     end.
     2160     if available buf_gds-grp-obj
     2161     then do:
     2162       find first buf_gds-grp-obj-attr no-lock
     2163         where buf_gds-grp-obj-attr.node-code   = p-node-code
     2164           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     2165           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     2166           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     2167           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     2168         no-error .
     2169       if available buf_gds-grp-obj-attr then do:
     2170         assign
     2171           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     2172         .
     2173       end.
     2174       else do:
     2175         assign
     2176           v-notcorr-value = ?
     2177         .
     2178       end.
     2179       assign
     2180       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     2181                           then yes
     2182                           else p-exists-notcorr)
     2183       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     2184                         then v-range
     2185                         else p-range-notcorr
     2186       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     2187                         then v-notcorr-value
     2188                         else p-notcorr
     2189       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     2190       jj = jj + 1
     2191       .
     2192     end.
     2193     else do:
     2194       assign
     2195       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     2196       jj = jj + 1
     2197       .
     2198     end.
     2199   end.
     2200   end.
     2201   end procedure.
     2202   define variable vss-include-info28 as character format "X(65)" no-undo
     2203   initial "@(#)$Workfile$ $Revision$".
     2204   procedure grplib-get-full-name :
     2205      define input parameter p-node-code  as integer      no-undo.
     2206      define output parameter p-full-name as character    no-undo.
     2207      do
     2208   on error undo, return error
     2209   :
     2210       define variable v-upper-code    as integer           no-undo.
     2211       define buffer buf_gds-grp       for ub.gds-grp.
     2212       define buffer buf_upper_gds-grp for ub.gds-grp.
     2213       find first buf_gds-grp no-lock
     2214            where buf_gds-grp.node-code = p-node-code
     2215       no-error.
     2216       if not available buf_gds-grp
     2217       then do:
     2218           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2219       end.
     2220       assign
     2221           p-full-name  = ""
     2222           v-upper-code = 1
     2223       .
     2224       do while buf_gds-grp.upper-code <> 0
     2225       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     2226       :
     2227           assign
     2228               p-full-name  = buf_gds-grp.node-name
     2229                            + (if p-full-name <> "" then chr(47) else "")
     2230                            + p-full-name
     2231               v-upper-code = buf_gds-grp.upper-code
     2232           .
     2233           find first buf_gds-grp no-lock
     2234                where buf_gds-grp.node-code = v-upper-code
     2235           no-error.
     2236           if not available buf_gds-grp
     2237           then do:
     2238               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     2239                                   + string( v-upper-code )
     2240                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2241           end.
     2242       end.
     2243       assign
     2244       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2245       .
     2246   end.
     2247   end .
     2248   procedure grplib-get-node-from-full-name :
     2249   define input parameter p-full-name as character no-undo .
     2250   define output parameter p-node-code as integer no-undo .
     2251   define variable v-ii as integer no-undo .
     2252   define variable v-upper-code as integer no-undo .
     2253   define variable v-root-code as integer no-undo .
     2254   define variable v-entry as character no-undo .
     2255   define buffer buf_gds-grp       for ub.gds-grp.
     2256   do
     2257   on error undo, return error
     2258   :
     2259     find first buf_gds-grp no-lock
     2260         where buf_gds-grp.upper-code = 0
     2261     no-error .
     2262     if not available buf_gds-grp
     2263     then do:
     2264         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     2265     end.
     2266     else do:
     2267       assign
     2268       v-root-code = buf_gds-grp.node-code
     2269       .
     2270     end.
     2271     v-upper-code = v-root-code.
     2272     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     2273       assign
     2274       v-entry = entry(v-ii, p-full-name, chr(47)).
     2275       if v-entry = '' then leave.
     2276       find first buf_gds-grp no-lock where
     2277                 buf_gds-grp.node-name = v-entry
     2278             and buf_gds-grp.upper-code = v-upper-code
     2279             no-error.
     2280       if not available buf_gds-grp then do:
     2281         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     2282       end.
     2283       else do:
     2284         p-node-code = buf_gds-grp.node-code.
     2285         v-upper-code = buf_gds-grp.node-code.
     2286       end.
     2287     end.
     2288   end.
     2289   end .
     2290   procedure  chec-par :
     2291   define output parameter l-par as logical no-undo .
     2292   define input parameter l-host like ub.clients.obj-code no-undo .
     2293   define input parameter l-type like ub.clients.obj-type no-undo .
     2294   define input parameter l-code like ub.clients.obj-code no-undo .
     2295   define variable par-type          as character no-undo.
     2296   define variable v-value-character as character no-undo .
     2297   define variable v-value-date      as date      no-undo .
     2298   define variable v-value-decimal   as decimal   no-undo .
     2299   define variable v-value-integer   as integer   no-undo .
     2300   define variable v-value-logical   as logical   no-undo .
     2301   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2302     (input  'alcohol'
     2303     ,input  l-host
     2304     ,input  l-type
     2305     ,input  l-code
     2306     ,input  ''
     2307     ,input  ''
     2308     ,input  ''
     2309     ,input  no
     2310     ,output par-alcohol
     2311     ,output par-type
     2312     ) no-error .
     2313    .
     2314   empty temp-table thbjattr_thbj-attr.
     2315   run adm/shattri.p (
     2316      input "get":U
     2317     ,input l-type
     2318     ,input l-code
     2319     ,input 'overval':U
     2320     ,input  ""
     2321     ,output v-value-character
     2322     ,output v-value-date
     2323     ,output v-value-decimal
     2324     ,output v-value-integer
     2325     ,output v-value-logical
     2326     ,output par-type
     2327     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2328     ) no-error .
     2329   for each thbjattr_thbj-attr :
     2330       if thbjattr_thbj-attr.prop-code = 'pr-clt-q':U then par-pr-clt-q = string ( thbjattr_thbj-attr.property-value-logical) .
     2331       if thbjattr_thbj-attr.prop-code = 'pr-dpl-q':U then par-pr-dpl-q = string ( thbjattr_thbj-attr.property-value-logical) .
     2332       if thbjattr_thbj-attr.prop-code = 'pr-rdc-q':U then par-pr-rdc-q = string ( thbjattr_thbj-attr.property-value-logical) .
     2333       if thbjattr_thbj-attr.prop-code = 'pr-equ-dq':U then par-pr-equ-dq = thbjattr_thbj-attr.property-value-integer .
     2334       if thbjattr_thbj-attr.prop-code = 'pr-abs-d':U then par-pr-abs-d = string ( thbjattr_thbj-attr.property-value-logical) .
     2335       if thbjattr_thbj-attr.prop-code = 'pr-altex':U then par-pr-altex = string ( thbjattr_thbj-attr.property-value-logical) .
     2336       if thbjattr_thbj-attr.prop-code = 'pr-parex':U then par-pr-parex = string ( thbjattr_thbj-attr.property-value-logical) .
     2337       if thbjattr_thbj-attr.prop-code = 'pr-sclex':U then par-pr-sclex = string ( thbjattr_thbj-attr.property-value-logical) .
     2338       if thbjattr_thbj-attr.prop-code = 'pr-discm':U then par-pr-discm =  thbjattr_thbj-attr.property-value-character .
     2339       if thbjattr_thbj-attr.prop-code = 'pr-dscnt':U then par-pr-dscnt  = string ( thbjattr_thbj-attr.property-value-logical) .
     2340       if thbjattr_thbj-attr.prop-code = 'pr-print':U then par-pr-print  = string ( thbjattr_thbj-attr.property-value-logical) .
     2341       if thbjattr_thbj-attr.prop-code = 'pr-sigma':U then par-pr-sigma  = string ( thbjattr_thbj-attr.property-value-decimal) .
     2342       if thbjattr_thbj-attr.prop-code = 'pr-incpc':U then par-pr-incpc  = string ( thbjattr_thbj-attr.property-value-decimal) .
     2343       if thbjattr_thbj-attr.prop-code = 'pr-rndmt':U then par-pr-rndmt  =  thbjattr_thbj-attr.property-value-character .
     2344       if thbjattr_thbj-attr.prop-code = 'pr-rndbs':U then par-pr-rndbs  = string ( thbjattr_thbj-attr.property-value-decimal) .
     2345       if thbjattr_thbj-attr.prop-code = 'pr-notls':U then par-pr-notls = string ( thbjattr_thbj-attr.property-value-logical) .
     2346       if v-cntxt-db-num = 0 then do:
     2347         if thbjattr_thbj-attr.prop-code = 'pr-nogds0':U then par-pr-nogds =  thbjattr_thbj-attr.property-value-character.
     2348         if thbjattr_thbj-attr.prop-code = 'pr-goods0':U then par-pr-goods =  thbjattr_thbj-attr.property-value-character.
     2349       end.
     2350       else do:
     2351         if thbjattr_thbj-attr.prop-code = 'pr-nogds':U then par-pr-nogds =  thbjattr_thbj-attr.property-value-character.
     2352         if thbjattr_thbj-attr.prop-code = 'pr-goods':U then par-pr-goods =  thbjattr_thbj-attr.property-value-character.
     2353       end.
     2354   end.
     2355   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2356   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplmrgn in g#library2
     2357     (input  ?
     2358     ,input  l-type
     2359     ,input  l-code
     2360     ,output par-gen-mrgn-ie
     2361     ,output par-gen-mrgn-iv
     2362     ,output par-gen-mrgn-im
     2363     ) no-error .
     2364      IF error-status :error THEN message
     2365        vss-workfile vss-revision vss-description skip
     2366        error-status :get-message(1) skip
     2367        return-value skip
     2368        "gbl/gtplmrgn.i"
     2369        view-as alert-box error
     2370      .
     2371   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2372   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplpnakl in g#library2
     2373     (input  ?
     2374     ,input  l-type
     2375     ,input  l-code
     2376     ,output par-pr-nakl-ie
     2377     ,output par-pr-nakl-iv
     2378     ,output par-pr-nakl-im
     2379     ) no-error .
     2380      define variable ii as integer   no-undo .
     2381      define variable nn as integer   no-undo .
     2382      define variable v-fullname as character no-undo .
     2383      nn = num-entries ( par-pr-nogds ).
     2384      par-pr-nogds-long = "".
     2385      if par-pr-nogds <> "0" and par-pr-nogds <> ""  then do:
     2386         repeat ii = 1 to nn :
     2387           run grplib-get-full-name  ( input integer(entry(ii,par-pr-nogds)) , output v-fullname ) .
     2388           par-pr-nogds-long = par-pr-nogds-long + v-fullname + chr(4) .
     2389         end.
     2390         par-pr-nogds-long = trim (par-pr-nogds-long,chr(4)) .
     2391      end.
     2392   l-par = true .
     2393   end procedure.
     2394   PROCEDURE cre-pr-list:
     2395   define input  parameter bc      like ub.price-list.b-code no-undo.
     2396   define input  parameter new-num like ub.price-doc.doc-num no-undo.
     2397   define output parameter new-rec as recid             no-undo.
     2398   define buffer buf-price-list for ub.price-list.
     2399   define buffer buf-price-doc  for ub.price-doc.
     2400   define buffer buf-bar-code   for ub.bar-code.
     2401   define buffer buf-goods      for ub.goods.
     2402   define buffer buf-gds-prt    for ub.gds-prt.
     2403   define buffer root-gds-prt   for ub.gds-prt.
     2404   define variable cur-pr like ub.price-list.price-sale no-undo.
     2405   define variable cur-rt like ub.price-list.road-tax   no-undo.
     2406   define variable cur-ex like ub.price-list.excise     no-undo.
     2407   define variable cur-dn like ub.price-list.doc-num    no-undo.
     2408   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     2409   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     2410   define variable cur-rt-base as decimal no-undo .
     2411   define variable cur-rt-rubl as decimal no-undo .
     2412   define variable p-hostcode as int no-undo .
     2413   define variable v-line-num as integer no-undo .
     2414   define variable v-skip-del-gds as logical no-undo initial no .
     2415   cre-pr:
     2416   do on error undo cre-pr, return error:
     2417     find  buf-bar-code no-lock where
     2418           buf-bar-code.b-code = bc.
     2419     run check-use-bar-code ( buf-bar-code.b-code ) no-error .
     2420     if error-status :error then do:
     2421       message
     2422         return-value skip
     2423         "Ошибка !"
     2424         view-as alert-box error
     2425       .
     2426       undo cre-pr, return.
     2427     end.
     2428     find  buf-goods no-lock where
     2429           buf-goods.gds-code = buf-bar-code.gds-code.
     2430     find first root-gds-prt no-lock where
     2431               root-gds-prt.upper-code = buf-goods.prt-root.
     2432     if root-gds-prt.node-name <> '_Пустая шкала':U and
     2433       buf-bar-code.in-code <> "" then do:
     2434       message
     2435         "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     2436         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     2437         view-as alert-box error.
     2438       undo cre-pr, return.
     2439     end.
     2440     find  buf-gds-prt no-lock where
     2441           buf-gds-prt.node-code = buf-bar-code.node-code.
     2442       v-skip-del-gds = p-auto .
     2443     if buf-goods.stts <> 0 and not v-skip-del-gds then do:
     2444       message
     2445         "Не допускается создавать цены на удаленные товары!" skip (2)
     2446         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     2447         view-as alert-box error.
     2448       undo cre-pr, return.
     2449     end.
     2450     find  buf-price-doc where
     2451           buf-price-doc.doc-num = new-num.
     2452   define variable v-ret as logical no-undo .
     2453      run ver-modificator-price-is-null (
     2454             input    buf-goods.artic        ,
     2455             input    buf-goods.prod-type    ,
     2456             input    buf-goods.prod-code    ,
     2457             input    buf-price-doc.obj-type   ,
     2458             input    buf-price-doc.obj-code   ,
     2459             output   v-ret ).
     2460         if v-ret = false then dO:
     2461             message
     2462               "Не допускается создавать цены на модификаторы с нулевой ценой !" skip (2)
     2463               "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     2464               view-as alert-box error.
     2465             undo cre-pr, return.
     2466           end.
     2467   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2468   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2469     (input  buf-price-doc.obj-type
     2470     ,input  buf-price-doc.obj-code
     2471     ,output p-hostcode
     2472     ) no-error .
     2473   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2474   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2475     (input  buf-goods.gds-code
     2476     ,input  '1':U
     2477     ,input  ?
     2478     ,input  p-hostcode
     2479     ,input  buf-price-doc.obj-type
     2480     ,input  buf-price-doc.obj-code
     2481     ,output local_vat-pc
     2482     ) no-error .
     2483   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2484   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2485     (input  buf-goods.gds-code
     2486     ,input  '2':U
     2487     ,input  ?
     2488     ,input  p-hostcode
     2489     ,input  buf-price-doc.obj-type
     2490     ,input  buf-price-doc.obj-code
     2491     ,output local_slt-pc
     2492     ) no-error .
     2493   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2494   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2495     (input  buf-price-doc.obj-type
     2496     ,input  buf-price-doc.obj-code
     2497     ,input  bc
     2498     ,input  0
     2499     ,input  0
     2500     ,output cur-dn
     2501     ,output cur-pr
     2502     ,output cur-rt
     2503     ,output cur-ex
     2504     ) no-error .
     2505     find first buf-price-list where
     2506               buf-price-list.b-code  = buf-bar-code.b-code and
     2507               buf-price-list.doc-num = new-num  and
     2508               buf-price-list.price-type = ""    no-error .
     2509     if not available buf-price-list then do:
     2510       run calc-price-line-num (input  new-num , output v-line-num) .
     2511       create buf-price-list.
     2512       assign
     2513         buf-price-list.line-num  = v-line-num
     2514         buf-price-list.b-code    = buf-bar-code.b-code
     2515         buf-price-list.doc-num   = buf-price-doc.doc-num
     2516         buf-price-list.prod-type = buf-goods.prod-type
     2517         buf-price-list.prod-code = buf-goods.prod-code
     2518         buf-price-list.artic     = buf-goods.artic
     2519         buf-price-list.obj-type  = buf-price-doc.obj-type
     2520         buf-price-list.obj-code  = buf-price-doc.obj-code
     2521         buf-price-list.vat-pc    = local_vat-pc
     2522         buf-price-list.slt-pc    = local_slt-pc
     2523         buf-price-list.price-prev = cur-pr
     2524         .
     2525       if  buf-gds-prt.upper-code = buf-goods.prt-root and
     2526           buf-bar-code.in-code   = "" and
     2527           buf-bar-code.part-code = "" and
     2528           buf-bar-code.unit-cli  = buf-goods.unit-base then do:
     2529         buf-price-list.main-price = yes.
     2530         if cur-pr <> ? then do:
     2531           run exp-prt (input buf-goods.gds-code,
     2532                       input cur-dn,
     2533                       input new-num,
     2534                       output new-rec) no-error.
     2535           if error-status :error then do:
     2536             message
     2537               "Ошибка вызова процедуры разворота специальных и неосновных цен."
     2538               view-as alert-box error.
     2539             undo cre-pr, return error.
     2540           end.
     2541         end.
     2542       end.
     2543       else do:
     2544         if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     2545           buf-price-list.d-pcnt = ?.
     2546         end.
     2547         buf-price-list.main-price = no.
     2548       end.
     2549     end.
     2550   end.
     2551   new-rec = recid (buf-price-list).
     2552   END PROCEDURE.
     2553   procedure calc-price-line-num :
     2554    do
     2555    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2556    :
     2557   define input parameter p-doc-num as character no-undo .
     2558   define output parameter p-num  as integer no-undo .
     2559   define variable v-fact as integer no-undo .
     2560   define buffer buf_1_price-list for ub.price-list .
     2561   p-num = 1 .
     2562   find last  buf_1_price-list no-lock where
     2563              buf_1_price-list.doc-num = p-doc-num use-index line-num no-error .
     2564              if available buf_1_price-list then
     2565                   assign
     2566                     v-fact = buf_1_price-list.line-num
     2567                   .
     2568   v-fact = v-fact + 1.
     2569   if v-fact <> ? then if p-num < v-fact then p-num = v-fact .
     2570    end.
     2571   end procedure.
     2572   PROCEDURE del-pr-list:
     2573   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2574   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2575   define input parameter round-method as character         no-undo.
     2576   define input parameter round-base   as decimal      no-undo.
     2577   define buffer buf-price-list for ub.price-list.
     2578   define buffer buf-bar-code   for ub.bar-code.
     2579   define buffer buf-goods      for ub.goods.
     2580   define variable l-ov-on as logical no-undo .
     2581   del-pr:
     2582   do on error undo del-pr, return error:
     2583     find first  buf-price-list no-lock where
     2584                 buf-price-list.doc-num    = d-num and
     2585                 buf-price-list.b-code     = bc and
     2586                 buf-price-list.price-type = "" no-error.
     2587     if not available buf-price-list then
     2588       undo del-pr, return error.
     2589     find  buf-goods no-lock where
     2590           buf-goods.prod-type = buf-price-list.prod-type and
     2591           buf-goods.prod-code = buf-price-list.prod-code and
     2592           buf-goods.artic     = buf-price-list.artic.
     2593     if buf-price-list.main-price then do:
     2594       for each  buf-price-list exclusive-lock where
     2595                 buf-price-list.doc-num   = d-num and
     2596                 buf-price-list.artic     = buf-goods.artic and
     2597                 buf-price-list.prod-type = buf-goods.prod-type and
     2598                 buf-price-list.prod-code = buf-goods.prod-code,
     2599           first buf-bar-code no-lock where
     2600                 buf-bar-code.b-code = buf-price-list.b-code
     2601       on error undo del-pr, return error:
     2602   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2603   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     2604     (input  ub.buf-price-list.obj-type
     2605     ,input  ub.buf-price-list.obj-code
     2606     ,input  ub.buf-price-list.artic
     2607     ,input  ub.buf-price-list.prod-type
     2608     ,input  ub.buf-price-list.prod-code
     2609     ,input  'ov-on=request:exclusive'
     2610     ,output l-ov-on
     2611     ) no-error .
     2612         if error-status:error then do:
     2613           message
     2614             vss-workfile vss-revision vss-description skip
     2615             "Ошибка получения признака товара на объекте" skip
     2616             error-status :get-message(1) skip
     2617             return-value skip
     2618             view-as alert-box error .
     2619         end.
     2620         if l-ov-on then do:
     2621   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2622   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     2623     (input  ub.buf-price-list.obj-type
     2624     ,input  ub.buf-price-list.obj-code
     2625     ,input  ub.buf-price-list.artic
     2626     ,input  ub.buf-price-list.prod-type
     2627     ,input  ub.buf-price-list.prod-code
     2628     ,input  'ov-on=false'
     2629     ,output l-ov-on
     2630     ) no-error .
     2631           if error-status :error then do:
     2632           end.
     2633          end.
     2634         delete buf-price-list.
     2635       end.
     2636     end.
     2637     else do:
     2638       find  buf-bar-code no-lock where
     2639             buf-bar-code.b-code = buf-price-list.b-code.
     2640       if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     2641         message
     2642           "Нельзя удалить неосновную цену." skip
     2643           "Неосновная цена (скидка) не может быть неопределенной." skip
     2644           "Код:" bc skip
     2645           "Переоценка:" d-num
     2646           view-as alert-box error.
     2647         undo del-pr, return error.
     2648       end.
     2649       find current buf-price-list exclusive-lock no-error .
     2650       delete buf-price-list.
     2651       run calc-base-upd (input buf-bar-code.b-code,
     2652                         input d-num,
     2653                         input round-method,
     2654                         input round-base) no-error.
     2655       if error-status :error then
     2656         undo del-pr, return error.
     2657     end.
     2658   end.
     2659   END PROCEDURE.
     2660   PROCEDURE calc-base-upd:
     2661   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2662   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2663   define input parameter round-method as character         no-undo.
     2664   define input parameter round-base   as decimal      no-undo.
     2665   define buffer alt-bar-code   for ub.bar-code.
     2666   define buffer alt-price-list for ub.price-list.
     2667   define buffer buf-bar-code   for ub.bar-code.
     2668   define buffer buf-goods      for ub.goods.
     2669   calc-base:
     2670   do on error undo calc-base, return error:
     2671     find  buf-bar-code no-lock where
     2672           buf-bar-code.b-code = bc.
     2673     find  buf-goods no-lock where
     2674           buf-goods.gds-code = buf-bar-code.gds-code.
     2675     for each  alt-bar-code no-lock where
     2676               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     2677               alt-bar-code.node-code = buf-bar-code.node-code and
     2678               alt-bar-code.part-code = buf-bar-code.part-code and
     2679               alt-bar-code.in-code   = buf-bar-code.in-code and
     2680               alt-bar-code.unit-cli <> buf-goods.unit-base,
     2681         each  alt-price-list where
     2682               alt-price-list.doc-num    = d-num and
     2683               alt-price-list.b-code     = alt-bar-code.b-code and
     2684               alt-price-list.price-type = ""
     2685         on error undo calc-base, return error:
     2686       run calc-pr-alt (input d-num,
     2687                       input alt-bar-code.b-code,
     2688                       input round-method,
     2689                       input round-base) no-error.
     2690       if error-status:error then
     2691         undo calc-base, return error.
     2692     end.
     2693   end.
     2694   END PROCEDURE.
     2695   PROCEDURE calc-pr-alt:
     2696   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2697   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2698   define input parameter r-method as character             no-undo.
     2699   define input parameter r-base   as decimal              no-undo.
     2700   define buffer buf-price-doc  for ub.price-doc.
     2701   define buffer buf-price-list for ub.price-list.
     2702   define buffer buf-bar-code   for ub.bar-code.
     2703   define buffer buf-goods      for ub.goods.
     2704   define buffer old-price-list for ub.price-list.
     2705   define variable pr-rec   as   recid                  no-undo.
     2706   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     2707   pr-alt:
     2708   do on error undo pr-alt, return error:
     2709     if r-method = ? or
     2710        r-base = ? then do:
     2711       message
     2712         "Нельзя удалить основную цену." skip
     2713         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     2714         "Код:" bc skip
     2715         "Переоценка:" d-num
     2716         view-as alert-box error.
     2717       undo pr-alt, return error.
     2718     end.
     2719     find  buf-price-doc where
     2720           buf-price-doc.doc-num = d-num.
     2721     find  buf-bar-code no-lock where
     2722           buf-bar-code.b-code = bc.
     2723     find  buf-goods no-lock where
     2724           buf-goods.gds-code = buf-bar-code.gds-code.
     2725     find  buf-price-list where
     2726           buf-price-list.doc-num = buf-price-doc.doc-num and
     2727           buf-price-list.b-code  = bc.
     2728     if buf-price-list.d-pcnt = ? then do:
     2729   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2730   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2731     (input  buf-price-doc.obj-type
     2732     ,input  buf-price-doc.obj-code
     2733     ,input  bc
     2734     ,input  0
     2735     ,input  0
     2736     ,output pr-rec
     2737     ,output pr-c-b-r
     2738     )  .
     2739       find old-price-list no-lock where
     2740           recid (old-price-list) = pr-rec no-error.
     2741       if available old-price-list and
     2742         old-price-list.b-code = bc then
     2743         buf-price-list.d-pcnt = old-price-list.d-pcnt.
     2744       else
     2745         buf-price-list.d-pcnt = 0.
     2746     end.
     2747      if buf-price-list.d-pcnt = ? then do:
     2748         assign
     2749           buf-price-list.price-sale =   if available old-price-list then old-price-list.price-sale else 0
     2750           buf-price-list.calc-method =  'Не-считать':U + 'Основная':U
     2751           .
     2752     end.
     2753     else do:
     2754         assign
     2755           buf-price-list.price-sale =   fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) *
     2756                                         buf-bar-code.cli-base-rate *
     2757                                         (1 - buf-price-list.d-pcnt / 100)
     2758           buf-price-list.calc-method =  'Основная':U
     2759           .
     2760   case r-method :
     2761     when '9-окончание':U then do:
     2762       if buf-price-list.price-sale < 29 then do:
     2763         if (buf-price-list.price-sale - truncate (buf-price-list.price-sale, 0)) <> 0 then do:
     2764           assign
     2765             buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 1
     2766           .
     2767         end.
     2768       end.
     2769       else do:
     2770         if (buf-price-list.price-sale modulo 10) < 3 then do:
     2771           assign
     2772             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     2773                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     2774                   - 1 ) * 10
     2775                 + 9
     2776           .
     2777         end.
     2778         else do:
     2779           assign
     2780             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     2781                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     2782                   ) * 10
     2783                 + 9
     2784           .
     2785         end.
     2786         assign
     2787           buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     2788         .
     2789       end.
     2790     end.
     2791     when '9-99окончание':U then do:
     2792       if buf-price-list.price-sale < r-base then do:
     2793         assign
     2794           buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 0.99
     2795         .
     2796       end.
     2797       else do:
     2798         assign
     2799           buf-price-list.price-sale = truncate (buf-price-list.price-sale / 10 , 0) * 10 + 9.99
     2800         .
     2801       end.
     2802     end.
     2803     when 'Без-дробных':U then do:
     2804       assign
     2805         buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     2806       .
     2807     end.
     2808     when 'Произвольно':U then do:
     2809       if r-base <> 0 then do:
     2810         assign
     2811           buf-price-list.price-sale = round (buf-price-list.price-sale / r-base, 0) * r-base
     2812         .
     2813         if buf-price-list.price-sale = 0 then do:
     2814           assign
     2815             buf-price-list.price-sale = r-base
     2816           .
     2817         end.
     2818       end.
     2819     end.
     2820     when 'Вверх':U then do:
     2821       if r-base <> 0 then do:
     2822         if truncate ( buf-price-list.price-sale / r-base, 0 ) <> (buf-price-list.price-sale / r-base) then do:
     2823           assign
     2824             buf-price-list.price-sale = truncate (buf-price-list.price-sale / r-base, 0) * r-base + r-base
     2825           .
     2826         end.
     2827       end.
     2828       if buf-price-list.price-sale = 0 then do:
     2829         assign
     2830           buf-price-list.price-sale = r-base
     2831         .
     2832       end.
     2833     end.
     2834     when 'Коэффициент':U then do:
     2835       if r-base <> 0 then do:
     2836         assign
     2837           buf-price-list.price-sale = buf-price-list.price-sale * r-base
     2838         .
     2839       end.
     2840     end.
     2841     when 'Отключено':U then do:
     2842     end.
     2843     otherwise do:
     2844       message
     2845         vss-workfile vss-revision vss-description skip
     2846         "Неизвестный метод округления продажной цены" skip
     2847         "round-method" r-method skip
     2848         "round-base"   r-base   skip
     2849         "price"        buf-price-list.price-sale             skip
     2850         view-as alert-box error .
     2851     end.
     2852   end.
     2853     end.
     2854   end.
     2855   END PROCEDURE.
     2856   PROCEDURE calc-pr-discnt:
     2857   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2858   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2859   define buffer buf-price-doc  for ub.price-doc.
     2860   define buffer buf-price-list for ub.price-list.
     2861   define buffer buf-bar-code   for ub.bar-code.
     2862   define buffer buf-goods      for ub.goods.
     2863   define buffer old-price-list for ub.price-list.
     2864   define variable pr-rec   as   recid                  no-undo.
     2865   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     2866   pr-discnt:
     2867   do on error undo pr-discnt, return error:
     2868     find  buf-price-doc where
     2869           buf-price-doc.doc-num = d-num.
     2870     find  buf-bar-code no-lock where
     2871           buf-bar-code.b-code = bc.
     2872     find  buf-goods no-lock where
     2873           buf-goods.gds-code = buf-bar-code.gds-code.
     2874     find  buf-price-list where
     2875           buf-price-list.doc-num = buf-price-doc.doc-num and
     2876           buf-price-list.b-code  = bc.
     2877     buf-price-list.d-pcnt = (1 -
     2878                              buf-price-list.price-sale /
     2879                              fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) /
     2880                              buf-bar-code.cli-base-rate) *
     2881                              100
     2882                              .
     2883   end.
     2884   END PROCEDURE.
     2885   PROCEDURE calc-pr-sub :
     2886   define  input  parameter bc             like ub.price-list.b-code no-undo.
     2887   define  input  parameter d-num          like ub.price-doc.doc-num no-undo.
     2888   define  input  parameter calc-method  as character    no-undo.
     2889   define  input  parameter increase-pc  as decimal      no-undo.
     2890   define  input  parameter round-method as character    no-undo.
     2891   define  input  parameter round-base   as decimal      no-undo.
     2892   define  output parameter calc-rec     as recid        no-undo.
     2893   define  buffer buf-price-list for ub.price-list.
     2894   define  buffer buf-bar-code   for ub.bar-code.
     2895   define  buffer buf-goods      for ub.goods.
     2896   define  buffer buf-gds-prt    for ub.gds-prt.
     2897   define  buffer buf-gds-grp    for ub.gds-grp.
     2898   define  buffer buf-price-doc  for ub.price-doc.
     2899   calc-sub:
     2900   do on error undo calc-sub, return error:
     2901     find  buf-bar-code no-lock where
     2902           buf-bar-code.b-code = bc.
     2903     find  buf-goods no-lock where
     2904           buf-goods.gds-code = buf-bar-code.gds-code.
     2905     find  buf-gds-prt no-lock where
     2906           buf-gds-prt.node-code = buf-bar-code.node-code.
     2907     find  buf-price-list where
     2908           buf-price-list.doc-num    = d-num and
     2909           buf-price-list.b-code     = bc and
     2910           buf-price-list.price-type = "".
     2911     find  buf-price-doc where
     2912           buf-price-doc.doc-num = d-num.
     2913     calc-rec = recid (buf-price-list).
     2914     if buf-price-list.main-price then do:
     2915       for each  buf-price-list where
     2916                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     2917                 buf-price-list.main-price = no and
     2918                 buf-price-list.artic      = buf-goods.artic and
     2919                 buf-price-list.prod-type  = buf-goods.prod-type and
     2920                 buf-price-list.prod-code  = buf-goods.prod-code,
     2921           first buf-bar-code no-lock where
     2922                 buf-bar-code.b-code   = buf-price-list.b-code and
     2923                 buf-bar-code.unit-cli = buf-goods.unit-base
     2924           on error undo calc-sub, return error:
     2925         run calc-pr-list (input  buf-bar-code.b-code,
     2926                           input  buf-price-list.doc-num,
     2927                           input  calc-method,
     2928                           input  increase-pc,
     2929                           input  round-method,
     2930                           input  round-base,
     2931                           input ? ,
     2932                           input ? ,
     2933                           input ? ,
     2934                           input ? ,
     2935                           output calc-rec) no-error.
     2936         if error-status :error then
     2937           undo calc-sub, return error.
     2938         calc-rec = recid (buf-price-list).
     2939       end.
     2940       for each  buf-price-list where
     2941                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     2942                 buf-price-list.main-price = no and
     2943                 buf-price-list.artic      = buf-goods.artic and
     2944                 buf-price-list.prod-type  = buf-goods.prod-type and
     2945                 buf-price-list.prod-code  = buf-goods.prod-code,
     2946           first buf-bar-code no-lock where
     2947                 buf-bar-code.b-code    = buf-price-list.b-code and
     2948                 buf-bar-code.unit-cli <> buf-goods.unit-base
     2949           on error undo calc-sub, return error:
     2950         run calc-pr-alt (input buf-price-doc.doc-num,
     2951                         input buf-bar-code.b-code,
     2952                         input round-method,
     2953                         input round-base) no-error.
     2954         if error-status :error then
     2955           undo calc-sub, return error.
     2956       end.
     2957     end.
     2958     else do:
     2959       run calc-base-upd (input buf-bar-code.b-code,
     2960                         input buf-price-doc.doc-num,
     2961                         input round-method,
     2962                         input round-base) no-error.
     2963       if error-status :error then
     2964         undo calc-sub, return error.
     2965     end.
     2966   end.
     2967   END PROCEDURE.
     2968   procedure ver-pr-nogds :
     2969   define input  parameter p-gds-code      as integer   no-undo .
     2970   define input  parameter p-par-pr-nogds  as character no-undo .
     2971   define output parameter p-not           as logical   no-undo .
     2972   define output parameter p-str           as character no-undo .
     2973   define buffer buf_goods for ub.goods  .
     2974   define variable nn as integer   no-undo .
     2975   define variable ii as integer   no-undo .
     2976   define variable v-namegrp as character no-undo .
     2977     do
     2978     on error undo, return error return-value
     2979     :
     2980     if p-par-pr-nogds = "1" then do:
     2981        assign
     2982         p-not = true
     2983         p-str = ""
     2984        .
     2985        return .
     2986     end.
     2987     assign
     2988       p-not = false
     2989       p-str = ""
     2990     .
     2991     find first buf_goods no-lock where
     2992                buf_goods.gds-code = p-gds-code no-error .
     2993     nn = num-entries(par-pr-nogds-long,chr(4)) .
     2994     repeat ii = 1 to nn:
     2995        v-namegrp = entry(ii , par-pr-nogds-long , chr(4) ) no-error .
     2996        if buf_goods.grp-name  begins v-namegrp  then do:
     2997           assign
     2998             p-not = true
     2999             p-str = substitute ( "Товар &1 &2 &3  может быть включен в ДНЦ из-за исключения запрета по группе : &4"  , buf_goods.artic, buf_goods.gds-name , buf_goods.grp-name , v-namegrp )
     3000           .
     3001           leave .
     3002        end.
     3003     end.
     3004     end.
     3005   end procedure.
     3006   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3007   procedure ver-modificator-price-is-null :
     3008    do
     3009    on error undo, return error return-value
     3010    :
     3011   define input parameter p-artic     like ub.goods.artic no-undo.
     3012   define input parameter p-prod-type like ub.goods.prod-type no-undo.
     3013   define input parameter p-prod-code like ub.goods.prod-code no-undo.
     3014   define input parameter p-obj-type  like ub.clients.obj-type no-undo.
     3015   define input parameter p-obj-code  like ub.clients.obj-code no-undo.
     3016   define output parameter p-ret as logical no-undo .
     3017   define variable v-gds-code  like ub.goods.gds-code no-undo .
     3018   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     3019   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3020   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     3021     (input  p-artic
     3022     ,input  p-prod-type
     3023     ,input  p-prod-code
     3024     ,output v-gds-code
