     1349     (input  buf_price-doc.obj-type
     1350     ,input  buf_price-doc.obj-code
     1351     ,output p-hostcode
     1352     ) no-error .
     1353   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1354   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1355     (input  buf_goods.gds-code
     1356     ,input  '1':U
     1357     ,input  ?
     1358     ,input  p-hostcode
     1359     ,input  buf_price-doc.obj-type
     1360     ,input  buf_price-doc.obj-code
     1361     ,output local_vat-pc
     1362     ) no-error .
     1363   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1364   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1365     (input  buf_goods.gds-code
     1366     ,input  '2':U
     1367     ,input  ?
     1368     ,input  p-hostcode
     1369     ,input  buf_price-doc.obj-type
     1370     ,input  buf_price-doc.obj-code
     1371     ,output local_slt-pc
     1372     ) no-error .
     1373       kk = kk + 1.
     1374   define variable v-main-bar-code as integer   no-undo .
     1375   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1376     (input  buf_goods.gds-code
     1377     ,input  ?
     1378     ,output v-main-bar-code
     1379     )  .
     1380       create buf_price-list.
     1381       assign
     1382           buf_price-list.line-num    = kk
     1383           buf_price-list.doc-num     = buf_price-doc.doc-num
     1384           buf_price-list.b-code      = buf_bar-code.b-code
     1385           buf_price-list.artic       = buf_goods.artic
     1386           buf_price-list.prod-type   = buf_goods.prod-type
     1387           buf_price-list.prod-code   = buf_goods.prod-code
     1388           buf_price-list.main-price  = (buf_bar-code.b-code = v-main-bar-code )
     1389           buf_price-list.calc-method = 'Отсутствует':U
     1390           buf_price-list.obj-type    = buf_price-doc.obj-type
     1391           buf_price-list.obj-code    = buf_price-doc.obj-code
     1392           buf_price-list.price-sale  = p-price-sale
     1393           buf_price-list.vat-pc      = local_vat-pc
     1394           buf_price-list.slt-pc      = local_slt-pc
     1395           p-update                   = no
     1396       .
     1397   end.
     1398   end.
     1399   end procedure.
     1400   procedure create_new_price-doc-forming :
     1401   define input  parameter p-obj-type   as character no-undo .
