     3837                   if buf_price-doc-forming.end-sys-time = ? then return error "Не задано время окончания действия цен !" .
     3838               end.
     3839         end case.
     3840      end.
     3841      if buf_price-doc-forming.have-start-period = integer(true) and
     3842         buf_price-doc-forming.have-end-period = integer(true) then do:
     3843         case buf_price-list-type.work-date :
     3844             when int('1':U)     then
     3845               do :
     3846                  if buf_price-doc-forming.end-date < buf_price-doc-forming.start-date then return error "Не верно задан интервал дат !" .
     3847               end.
     3848             when int('2':U)   then
     3849               do :
