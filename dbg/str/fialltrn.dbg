        1   block-level on error undo, throw.
        2   define input parameter parparentproc as handle    no-undo .
        3   define input parameter par-type      as integer   no-undo .
        4   define input parameter par-host-code as integer   no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: fialltrn.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: str/fialltrn.p $":U .
       10   define variable vss-description as character no-undo init "Список накладных Без фин.обязательств Нет по поставке".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81     define variable v-cntxt-db-num        as integer   no-undo .
       82     define variable v-cntxt-userid        as character no-undo .
       83     define variable v-cntxt-level         as character no-undo .
       84     define variable v-cntxt-host-code-obj as integer   no-undo .
       85     define variable v-cntxt-obj-type      as character no-undo .
       86     define variable v-cntxt-obj-code      as integer   no-undo .
       87     define variable v-cntxt-db-num-obj    as integer   no-undo .
       88     define variable v-cntxt-is-admin      as logical   no-undo .
       89   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   define temp-table userobjs_temp-user-obj no-undo
       91     field obj-type as character
       92     field obj-code as integer
       93     index xpk is primary unique obj-type obj-code
       94     .
       95   procedure userobjs_clear :
       96     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       97     do
       98     on error undo, return error return-value
       99     :
      100       for each buf_userobjs_temp-user-obj
      101       on error undo, return error return-value
      102       :
      103         delete buf_userobjs_temp-user-obj .
      104       end.
      105     end.
      106   end .
      107   procedure userobjs_object-count :
      108     define output parameter p-total-count as integer   no-undo .
      109     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      110     do
      111     on error undo, return error return-value
      112     :
      113       assign
      114         p-total-count = 0
      115       .
      116       for each buf_userobjs_temp-user-obj
      117       on error undo, return error return-value
      118       :
      119         assign
      120           p-total-count = p-total-count + 1
      121         .
      122       end.
      123     end.
      124   end.
      125   procedure userobjs_append :
      126      define input  parameter p-obj-type as character no-undo .
      127      define input  parameter p-obj-code as integer   no-undo .
      128     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      129     do
      130     on error undo, return error return-value
      131     :
      132       find first buf_userobjs_temp-user-obj
      133         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      134           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      135         no-error .
      136       if not available buf_userobjs_temp-user-obj
      137       then do:
      138         create buf_userobjs_temp-user-obj .
      139         assign
      140           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      141           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      142         .
      143       end.
      144     end.
      145   end.
      146   procedure userobjs_object-exist :
      147     define output parameter p-object-exist as logical   no-undo .
      148     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      149     do
      150     on error undo, return error return-value
      151     :
      152       find first buf_userobjs_temp-user-obj
      153         no-error .
      154       if not available buf_userobjs_temp-user-obj
      155       then do:
      156         assign
      157           p-object-exist = false
      158         .
      159       end.
      160       else do:
      161         assign
      162           p-object-exist = true
      163         .
      164       end.
      165     end.
      166   end.
      167   procedure userobjs_transfer :
      168     define input  parameter p-callback-handle as handle no-undo .
      169     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      170     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      171     do
      172     on error undo, return error return-value
      173     :
      174       if valid-handle(p-callback-handle) <> true
      175       then do:
      176         message
      177           vss-workfile vss-revision vss-description skip
      178           "Ошибка задания входных параметров" skip
      179           "Неизвестный указатель на процедуру" skip
      180           view-as alert-box error .
      181         undo, return error return-value .
      182       end.
      183       if p-callback-handle :get-signature("userobjs_append") = ""
      184       then do:
      185         message
      186           vss-workfile vss-revision vss-description skip
      187           "Ошибка задания входных параметров" skip
      188           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      189                     ,p-callback-handle :file-name
      190                     ) skip
      191           view-as alert-box error .
      192         undo, return error return-value .
      193       end.
      194       for each buf_userobjs_temp-user-obj
      195       on error undo, return error return-value
      196       :
      197         run userobjs_append in p-callback-handle
      198           (input  buf_userobjs_temp-user-obj.obj-type
      199           ,input  buf_userobjs_temp-user-obj.obj-code
      200           ) .
      201       end.
      202     end.
      203   end procedure.
      204   procedure userobjs_select-one :
      205      define input  parameter parparentproc     as widget-handle no-undo .
      206      define input  parameter p-db-num          as integer   no-undo .
      207      define input  parameter p-user-id         as character no-undo .
      208      define input  parameter p-host-code-obj   as integer   no-undo .
      209      define input  parameter p-obj-type        as character no-undo .
      210      define input  parameter p-obj-code        as integer   no-undo .
      211      define output parameter p-user-select     as logical   no-undo .
      212      define output parameter p-select-obj-type as character no-undo .
      213      define output parameter p-select-obj-code as character no-undo .
      214     do
      215     on error undo, return error return-value
      216     :
      217       run gbl/userobjs.w
      218         (input  parparentproc
      219         ,input  this-procedure :handle
      220         ,input  p-db-num
      221         ,input  p-user-id
      222         ,input  p-host-code-obj
      223         ,input  p-obj-type
      224         ,input  p-obj-code
      225         ,INPUT  "b-sel"
      226         ,output p-user-select
      227         ,output p-select-obj-type
      228         ,output p-select-obj-code
      229         ) .
      230     end.
      231   end.
      232   procedure userobjs_select-many :
      233     define input  parameter parparentproc   as widget-handle no-undo .
      234     define input  parameter p-db-num        as integer   no-undo .
      235     define input  parameter p-user-id       as character no-undo .
      236     define input  parameter p-host-code-obj as integer   no-undo .
      237     define input  parameter p-obj-type      as character no-undo .
      238     define input  parameter p-obj-code      as integer   no-undo .
      239     define output parameter p-user-select   as logical   no-undo .
      240     define variable v-select-obj-type as character no-undo .
      241     define variable v-select-obj-code as integer   no-undo .
      242     do
      243     on error undo, return error return-value
      244     :
      245       run gbl/userobjs.w
      246         (input  parparentproc
      247         ,input  this-procedure :handle
      248         ,input  p-db-num
      249         ,input  p-user-id
      250         ,input  p-host-code-obj
      251         ,input  p-obj-type
      252         ,input  p-obj-code
      253         ,INPUT  "b-sel,b-mark"
      254         ,output p-user-select
      255         ,output v-select-obj-type
      256         ,output v-select-obj-code
      257         ) .
      258     end.
      259   end.
      260   procedure thobjs :
      261      define input        parameter parparentproc     as widget-handle no-undo .
      262      define input        parameter i-bttns           as character     no-undo .
      263      define input        parameter i-list-mode       as character     no-undo.
      264      define input        parameter i-obj-type        as character     no-undo.
      265      define input        parameter i-db-num          as integer       no-undo.
      266      define input        parameter i-host-code       as integer       no-undo.
      267      define input-output parameter p-rid-list        as character     no-undo .
      268   run ref/thobjs.p
      269           ( input parparentproc
      270            ,input  this-procedure :handle
      271           , input i-bttns
      272           , input i-list-mode
      273           , input i-obj-type
      274           , input i-db-num
      275           , input i-host-code
      276           , input-output p-rid-list ) no-error .
      277   end.
      278   define variable doc-t as character no-undo.
      279   DEFINE VARIABLE loc-ref-list as character no-undo.
      280   define variable v-input-output as character no-undo .
      281   define variable v-list-mode as character no-undo .
      282   def buffer b#clients for clients.
      283   define variable v-host-name as character no-undo .
      284   do
      285   on error undo, return error return-value
      286   :
      287   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      288     run mainmenu_getcntxt in parparentproc
      289       (output v-cntxt-db-num
      290       ,output v-cntxt-userid
      291       ,output v-cntxt-level
      292       ,output v-cntxt-host-code-obj
      293       ,output v-cntxt-obj-type
      294       ,output v-cntxt-obj-code
      295       ,output v-cntxt-db-num-obj
      296       ,output v-cntxt-is-admin
      297       ) .
      298     find first b#clients WHERE
      299           b#clients.obj-code = par-host-code and
      300           b#clients.obj-type = 'орг':U
      301           No-LOCK No-ERROR.
      302     v-host-name = b#clients.obj-name .
      303     case par-type :
      304       when 0 then do:
      305           v-list-mode = 'фирма':U .
      306       end.
      307       when 1 then do:
      308           v-list-mode = "no-gen-incfo":U .
      309       end.
      310       when 2 then do:
      311           v-list-mode = "no-gen-expfo":u .
      312       end.
      313       when 3 then do:
      314           v-list-mode = "no-gen-fo":u .
      315       end.
      316       when 4 then do:
      317           v-list-mode = "no-def":u .
      318       end.
      319       when 11 then do:
      320           v-list-mode = "yes-gen-incfo":U .
      321       end.
      322       when 12 then do:
      323           v-list-mode = "yes-gen-expfo":u .
      324       end.
      325       when 13 then do:
      326           v-list-mode = "yes-gen-fo":u .
      327       end.
      328     end case.
      329     run str/all-docs.w
      330         (input parparentproc
      331         ,input par-host-code
      332         ,input v-cntxt-obj-type
      333         ,input v-cntxt-obj-code
      334         ,input v-list-mode
      335         ,input ?
      336         ,input ?
      337         ,input ?
      338         ,input ?
      339         ,input 'b-mark':U
      340         ,input '':U
      341         ,input ?
      342         ,input (if par-type = 0 then recid(b#clients) else ?)
      343         ,output loc-ref-list
      344         ) no-error .
      345   end.
