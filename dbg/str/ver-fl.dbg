        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: ver-fl.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: str/ver-fl.p $":U .
        7   define variable vss-description as character no-undo init "Проверка количества зваведенного в атрибутах и в gds-dtl".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define new global shared variable g#lib-trn  as handle no-undo .
       69   define new global shared variable g#lib-trn2 as handle no-undo .
       70   define new global shared variable g#lib-trn3 as handle no-undo .
       71   define new global shared variable g#lib-trn4 as handle no-undo .
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   procedure lineattr-value :
       74     do
       75     on error undo, return error return-value
       76     :
       77       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
       78       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
       79       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
       80       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
       81       define output parameter p-type     as character no-undo .
       82       define buffer buf_doc-line-attr for ub.doc-line-attr .
       83       def var v-format         as character no-undo .
       84       def var v-fillin_width   as integer   no-undo .
       85       def var v-fillin_height  as integer   no-undo .
       86       def var v-label          as character no-undo .
       87       def var v-user-can-edit  as logical   no-undo .
       88       def var v-output-display as logical   no-undo .
       89       def var v-other          as character no-undo .
       90       run lineattr-code in this-procedure
       91         (input  p-code
       92         ,output p-type
       93         ,output v-format
       94         ,output v-fillin_width
       95         ,output v-fillin_height
       96         ,output v-label
       97         ,output v-user-can-edit
       98         ,output v-output-display
       99         ,output v-other
      100         ) no-error .
      101       if error-status :error then do:
      102         undo, return error return-value .
      103       end.
      104       find first buf_doc-line-attr no-lock
      105         where buf_doc-line-attr.doc-code  = p-doc-code
      106           and buf_doc-line-attr.gds-code  = p-gds-code
      107           and buf_doc-line-attr.attr-code = p-code
      108         no-error .
      109       if avail buf_doc-line-attr then do:
      110         assign
      111           p-value =  buf_doc-line-attr.attr-value
      112         .
      113       end.
      114       else do:
      115         assign
      116           p-value = if p-type = 'L':U then "no":U else ""
      117         .
      118       end.
      119     end.
      120   end procedure.
      121   procedure lineattr-write :
      122     do
      123     on error undo, return error return-value
      124     :
      125       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      126       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      127       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      128       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      129       define buffer buf_doc-line-attr for ub.doc-line-attr .
      130       def var v-type           as character no-undo .
      131       def var v-format         as character no-undo .
      132       def var v-fillin_width   as integer   no-undo .
      133       def var v-fillin_height  as integer   no-undo .
      134       def var v-label          as character no-undo .
      135       def var v-user-can-edit  as logical   no-undo .
      136       def var v-output-display as logical   no-undo .
      137       def var v-other          as character no-undo .
      138       run lineattr-code in this-procedure
      139         (input  p-code
      140         ,output v-type
      141         ,output v-format
      142         ,output v-fillin_width
      143         ,output v-fillin_height
      144         ,output v-label
      145         ,output v-user-can-edit
      146         ,output v-output-display
      147         ,output v-other
      148         ) no-error .
      149       if error-status :error then do:
      150         undo, return error return-value .
      151       end.
      152       find first buf_doc-line-attr exclusive-lock
      153         where buf_doc-line-attr.doc-code  = p-doc-code
      154           and buf_doc-line-attr.gds-code  = p-gds-code
      155           and buf_doc-line-attr.attr-code = p-code
      156         no-error .
      157       if not available buf_doc-line-attr then do:
      158         create buf_doc-line-attr .
      159         assign
      160           buf_doc-line-attr.doc-code  = p-doc-code
      161           buf_doc-line-attr.gds-code = p-gds-code
      162           buf_doc-line-attr.attr-code = p-code
      163         .
      164       end.
      165       assign
      166         buf_doc-line-attr.attr-value = p-value
      167       .
      168        release buf_doc-line-attr.
      169     end.
      170   end procedure.
      171   procedure lineattr-exist :
      172     do
      173     on error undo, return error return-value
      174     :
      175       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      176       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      177       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      178       define output parameter p-exist   as logical  no-undo .
      179       define buffer buf_doc-line-attr for ub.doc-line-attr .
      180       def var v-type           as character no-undo .
      181       def var v-format         as character no-undo .
      182       def var v-fillin_width   as integer   no-undo .
      183       def var v-fillin_height  as integer   no-undo .
      184       def var v-label          as character no-undo .
      185       def var v-user-can-edit  as logical   no-undo .
      186       def var v-output-display as logical   no-undo .
      187       def var v-other          as character no-undo .
      188       run lineattr-code in this-procedure
      189         (input  p-code
      190         ,output v-type
      191         ,output v-format
      192         ,output v-fillin_width
      193         ,output v-fillin_height
      194         ,output v-label
      195         ,output v-user-can-edit
      196         ,output v-output-display
      197         ,output v-other
      198         ) no-error .
      199       if error-status :error then do:
      200         undo, return error return-value .
      201       end.
      202       find first buf_doc-line-attr no-lock
      203         where buf_doc-line-attr.doc-code  = p-doc-code
      204           and buf_doc-line-attr.gds-code = p-gds-code
      205           and buf_doc-line-attr.attr-code = p-code
      206         no-error .
      207       if  available buf_doc-line-attr then do:
      208         p-exist = yes.
      209       end.
      210     end.
      211   end procedure.
      212   procedure lineattr-delete :
      213     do
      214     on error undo, return error return-value
      215     :
      216       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      217       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      218       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      219       define output parameter p-deleted  as logical no-undo.
      220       define buffer buf_doc-line-attr for ub.doc-line-attr .
      221       def var v-type           as character no-undo .
      222       def var v-format         as character no-undo .
      223       def var v-fillin_width   as integer   no-undo .
      224       def var v-fillin_height  as integer   no-undo .
      225       def var v-label          as character no-undo .
      226       def var v-user-can-edit  as logical   no-undo .
      227       def var v-output-display as logical   no-undo .
      228       def var v-other          as character no-undo .
      229       run lineattr-code in this-procedure
      230         (input  p-code
      231         ,output v-type
      232         ,output v-format
      233         ,output v-fillin_width
      234         ,output v-fillin_height
      235         ,output v-label
      236         ,output v-user-can-edit
      237         ,output v-output-display
      238         ,output v-other
      239         ) no-error .
      240       if error-status :error then do:
      241         undo, return error return-value .
      242       end.
      243       find first buf_doc-line-attr exclusive-lock
      244         where buf_doc-line-attr.doc-code  = p-doc-code
      245           and buf_doc-line-attr.gds-code  = p-gds-code
      246           and buf_doc-line-attr.attr-code = p-code
      247         no-error NO-WAIT.
      248       if not available buf_doc-line-attr then do:
      249         p-deleted = no.
      250       end.
      251       else do:
      252         delete buf_doc-line-attr.
      253         p-deleted = yes.
      254       end.
      255     end.
      256   end procedure.
      257   procedure lineattr-code :
      258     do on error undo, return error return-value
      259     :
      260       define input  parameter p-code           as character no-undo .
      261       define output parameter p-type           as character no-undo .
      262       define output parameter p-format         as character no-undo .
      263       define output parameter p-fillin_width   as integer   no-undo .
      264       define output parameter p-fillin_height  as integer   no-undo .
      265       define output parameter p-label          as character no-undo .
      266       define output parameter p-user-can-edit  as logical   no-undo .
      267       define output parameter p-output-display as logical   no-undo .
      268       define output parameter p-other          as character no-undo .
      269       case p-code :
      270               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      271               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      272               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      273               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      274               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      275               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      276               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      277               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      278               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      279               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      280               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      281         otherwise do:
      282           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
      283         end.
      284       end.
      285     end.
      286   end procedure.
      287   procedure lineattr-value-flora-gds :
      288     do
      289     on error undo, return error return-value
      290     :
      291       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      292       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      293       define input  parameter p-prt-code    as integer   no-undo .
      294       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      295       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      296       define output parameter p-value       as    decimal   no-undo .
      297       define buffer buf_doc-line-attr for ub.doc-line-attr .
      298       find first buf_doc-line-attr no-lock
      299         where buf_doc-line-attr.doc-code  = p-doc-code
      300           and buf_doc-line-attr.gds-code  = p-gds-code
      301           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      302         no-error .
      303       if avail buf_doc-line-attr then do:
      304         assign
      305           p-value = decimal( buf_doc-line-attr.attr-value)
      306         .
      307       end.
      308       else do:
      309         assign
      310           p-value = 0
      311         .
      312       end.
      313     end.
      314   end procedure.
      315   procedure lineattr-write-flora-gds :
      316     do
      317     on error undo, return error return-value
      318     :
      319       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      320       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      321       define input parameter p-prt-code    as integer   no-undo .
      322       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      323       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      324       define input parameter p-value    as decimal   no-undo .
      325       define buffer buf_doc-line-attr for ub.doc-line-attr .
      326       find first buf_doc-line-attr exclusive-lock
      327         where buf_doc-line-attr.doc-code  = p-doc-code
      328           and buf_doc-line-attr.gds-code  = p-gds-code
      329           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      330         no-error .
      331       if not available buf_doc-line-attr then do:
      332         create buf_doc-line-attr .
      333         assign
      334           buf_doc-line-attr.doc-code  = p-doc-code
      335           buf_doc-line-attr.gds-code  = p-gds-code
      336           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      337         .
      338       end.
      339       assign
      340         buf_doc-line-attr.attr-value = string( p-value )
      341       .
      342     end.
      343   end procedure.
      344   procedure lineattr-delete-flora-gds :
      345     do
      346     on error undo, return error return-value
      347     :
      348       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      349       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      350       define input  parameter p-prt-code    as integer   no-undo .
      351       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      352       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      353       define output parameter p-deleted  as logical no-undo.
      354       define buffer buf_doc-line-attr for ub.doc-line-attr .
      355       find first buf_doc-line-attr exclusive-lock
      356         where buf_doc-line-attr.doc-code  = p-doc-code
      357           and buf_doc-line-attr.gds-code  = p-gds-code
      358           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      359         no-error NO-WAIT.
      360       if not available buf_doc-line-attr then do:
      361         p-deleted = no.
      362       end.
      363       else do:
      364         delete buf_doc-line-attr.
      365         p-deleted = yes.
      366       end.
      367     end.
      368   end procedure.
      369   procedure lineattr-delete-flora-all :
      370     do
      371     on error undo, return error return-value
      372     :
      373       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      374       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      375       define input  parameter p-prt-code    as integer   no-undo .
      376       define buffer buf_doc-line-attr for ub.doc-line-attr .
      377       for each buf_doc-line-attr exclusive-lock
      378         where buf_doc-line-attr.doc-code  = p-doc-code
      379           and buf_doc-line-attr.gds-code  = p-gds-code
      380           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
      381        :
      382         delete buf_doc-line-attr.
      383       end.
      384    end.
      385   end procedure.
      386   procedure lineattr-exist-flora-gds :
      387     do
      388     on error undo, return error return-value
      389     :
      390       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      391       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      392       define input  parameter p-prt-code    as integer   no-undo .
      393       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      394       define output parameter p-exist as logical   no-undo .
      395       define buffer buf_doc-line-attr for ub.doc-line-attr .
      396       p-exist = false .
      397       find first buf_doc-line-attr no-lock
      398         where buf_doc-line-attr.doc-code  = p-doc-code
      399           and buf_doc-line-attr.gds-code  = p-gds-code
      400           and buf_doc-line-attr.attr-code = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      401         no-error .
      402       if avail buf_doc-line-attr then do:
      403         assign
      404          p-exist = true
      405         .
      406       end.
      407     end.
      408   end procedure.
      409   procedure lineattr-write-add-line-cli :
      410   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      411   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      412   define input  parameter p-cli-type      as character no-undo .
      413   define input  parameter p-cli-code      as integer   no-undo .
      414   define input  parameter p-contract-code as integer   no-undo .
      415   define input  parameter p-host-code     as integer   no-undo .
      416   define input  parameter p-exch-code     as integer   no-undo .
      417   define input  parameter p-exch-rate     as decimal   no-undo .
      418   define input  parameter p-exch-scale    as integer   no-undo .
      419   define input  parameter p-sum-cli       as decimal   no-undo .
      420   define input  parameter p-sum-vat       as decimal   no-undo .
      421   define buffer buf_doc-line-attr for ub.doc-line-attr .
      422     do
      423     on error undo, return error return-value
      424     :
      425       find first buf_doc-line-attr exclusive-lock
      426         where buf_doc-line-attr.doc-code  = p-doc-code
      427           and buf_doc-line-attr.gds-code  = p-gds-code
      428           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      429                                             chr(4) + p-cli-type +
      430                                             chr(4) + string(p-cli-code) +
      431                                             chr(4) + string(p-contract-code) +
      432                                             chr(4) + string(p-host-code)
      433         no-error .
      434       if not available buf_doc-line-attr then do:
      435         create buf_doc-line-attr .
      436         assign
      437           buf_doc-line-attr.doc-code  = p-doc-code
      438           buf_doc-line-attr.gds-code  = p-gds-code
      439           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
      440                                         chr(4) + p-cli-type +
      441                                         chr(4) + string(p-cli-code) +
      442                                         chr(4) + string(p-contract-code) +
      443                                         chr(4) + string(p-host-code)
      444         .
      445       end.
      446       assign
      447         buf_doc-line-attr.attr-value =
      448         string(p-exch-code)  + chr(4) +
      449         string(p-exch-rate)  + chr(4) +
      450         string(p-exch-scale) + chr(4) +
      451         string(p-sum-cli)    + chr(4) +
      452         string(p-sum-vat)
      453         .
      454     end.
      455   end procedure.
      456   procedure lineattr-value-add-line-cli :
      457   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      458   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      459   define input   parameter p-cli-type      as character no-undo .
      460   define input   parameter p-cli-code      as integer   no-undo .
      461   define input   parameter p-contract-code as integer   no-undo .
      462   define input   parameter p-host-code     as integer   no-undo .
      463   define output  parameter p-exch-code     as integer   no-undo .
      464   define output  parameter p-exch-rate     as decimal   no-undo .
      465   define output  parameter p-exch-scale    as integer   no-undo .
      466   define output  parameter p-sum-cli       as decimal   no-undo .
      467   define output  parameter p-sum-vat       as decimal   no-undo .
      468   define buffer buf_doc-line-attr for ub.doc-line-attr .
      469     do
      470     on error undo, return error return-value
      471     :
      472       find first buf_doc-line-attr exclusive-lock
      473         where buf_doc-line-attr.doc-code  = p-doc-code
      474           and buf_doc-line-attr.gds-code  = p-gds-code
      475           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      476                                             chr(4) + p-cli-type +
      477                                             chr(4) + string(p-cli-code) +
      478                                             chr(4) + string(p-contract-code) +
      479                                             chr(4) + string(p-host-code)
      480         no-error .
      481       if available buf_doc-line-attr then do:
      482        assign
      483           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
      484           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
      485           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
      486           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
      487           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
      488          .
      489        end.
      490     end.
      491   end procedure.
      492   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
      493     define variable v-code as character no-undo .
      494     define variable v-type as character no-undo .
      495     define variable v-gds-code as integer   no-undo .
      496   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      497   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      498     (input  local-doc-line.artic
      499     ,input  local-doc-line.prod-type
      500     ,input  local-doc-line.prod-code
      501     ,output v-gds-code
      502     )  .
      503     run lineattr-value (
      504         input   local-doc-line.doc-code ,
      505         input   v-gds-code              ,
      506         input   'reason-code':U ,
      507         output  v-code                  ,
      508         output  v-type ) .
      509     find first ub.trn-reason no-lock where
      510                ub.trn-reason.reason-code = integer ( v-code ) no-error.
      511     if not available ub.trn-reason then do:
      512        return "" .
      513     end.
      514     else do:
      515        return ub.trn-reason.reason-name .
      516     end.
      517   end function.
      518   procedure lineattr-value-parts :
      519     do
      520     on error undo, return error return-value
      521     :
      522       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      523       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      524       define input  parameter p-part-code   as character no-undo .
      525       define input  parameter p_in-code     as character no-undo .
      526       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      527       define output parameter p-value       as    decimal   no-undo .
      528       define buffer buf_doc-line-attr for ub.doc-line-attr .
      529       find first buf_doc-line-attr no-lock
      530         where buf_doc-line-attr.doc-code  = p-doc-code
      531           and buf_doc-line-attr.gds-code  = p-gds-code
      532           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
      533         no-error .
      534       if avail buf_doc-line-attr then do:
      535         assign
      536           p-value = decimal( buf_doc-line-attr.attr-value)
      537         .
      538       end.
      539       else do:
      540         assign
      541           p-value = 0
      542         .
      543       end.
      544     end.
      545   end procedure.
      546   procedure lineattr-write-parts :
      547     do
      548     on error undo, return error return-value
      549     :
      550       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      551       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      552       define input parameter p-part-code  as character no-undo .
      553       define input parameter p_in-code    as character no-undo .
      554       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
      555       define input parameter p-value      as decimal   no-undo .
      556       define buffer buf_doc-line-attr for ub.doc-line-attr .
      557       find first buf_doc-line-attr exclusive-lock
      558         where buf_doc-line-attr.doc-code  = p-doc-code
      559           and buf_doc-line-attr.gds-code  = p-gds-code
      560           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      561         no-error .
      562       if not available buf_doc-line-attr then do:
      563         create buf_doc-line-attr .
      564         assign
      565           buf_doc-line-attr.doc-code  = p-doc-code
      566           buf_doc-line-attr.gds-code  = p-gds-code
      567           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      568         .
      569       end.
      570       assign
      571         buf_doc-line-attr.attr-value = string( p-value )
      572       .
      573     end.
      574   end procedure.
      575   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      576   define new global shared variable g#trdcalib as handle no-undo.
      577   define input  parameter p-mode as character no-undo .
      578   define input  parameter   p-doc-code  as character no-undo .
      579   define output parameter   p-error       as logical   no-undo .
      580   define temp-table temp-gds-dtl no-undo
      581   field node-code as integer
      582   field artic     as char
      583   field prod-type     as char
      584   field prod-code     as int
      585   field gds-code  as integer
      586   field rel-bk    as logical
      587   index pi node-code
      588   .
      589   def buffer t-doc for ub.trn-doc.
      590   find first t-doc where t-doc.doc-code = p-doc-code.
      591   p-error = false  .
      592   if  p-mode = 'ПРОСМОТР':U
      593   then do:
      594   return .
      595   end.
      596   if not (( t-doc.status_ = 'накл':U or
      597        t-doc.status_ = 'разрешен':U ) and
      598        t-doc.ext-doc-type = 'ee':U)
      599   then do:
      600   define variable v-ex as logical   no-undo .
      601   define variable v-exist as logical   no-undo .
      602   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      603   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_resv-inqv in g#lib-trn3
      604   (input  t-doc.doc-code,
      605    output v-ex
      606   )
      607   .
      608     if not v-ex then do:
      609   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-xst in g#trdcalib (  input t-doc.doc-code ,
      610                           input '0rsrv-date':U ,
      611                          output v-exist )  .
      612           if error-status :error or v-exist = false or v-exist = ? then do:
      613             message "Нет даты заказа букета!" view-as alert-box error .
      614             return error "Нет даты заказа букета!".
      615           end.
      616     end.
      617   return .
      618   end.
      619   define variable v-ok as logical   no-undo .
      620   define buffer prt_goods for ub.goods.
      621   define buffer b2_doc-line-attr for ub.doc-line-attr.
      622   for each ub.gds-dtl no-lock  where ub.gds-dtl.doc-code  = p-doc-code :
      623     find first prt_goods no-lock where
      624               prt_goods.artic     = ub.gds-dtl.artic       and
      625               prt_goods.prod-type = ub.gds-dtl.prod-type   and
      626               prt_goods.prod-code = ub.gds-dtl.prod-code   no-error .
      627      find first b2_doc-line-attr no-lock where b2_doc-line-attr.doc-code = p-doc-code         and
      628                                                b2_doc-line-attr.gds-code = prt_goods.gds-code  and
      629                                                num-entries(b2_doc-line-attr.attr-code) = 3    no-error .
      630   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      631   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_grp-nabor in g#lib-trn3
      632   ( input  prt_goods.gds-code ,
      633     output v-ok
      634   )
      635   .
      636       if v-ok = true then next.
      637       create  temp-gds-dtl .
      638       assign
      639       temp-gds-dtl.node-code = ub.gds-dtl.prt-code
      640       temp-gds-dtl.artic     = prt_goods.artic
      641       temp-gds-dtl.prod-type = prt_goods.prod-type
      642       temp-gds-dtl.prod-code = prt_goods.prod-code
      643       temp-gds-dtl.gds-code  = prt_goods.gds-code
      644       temp-gds-dtl.rel-bk    = if available b2_doc-line-attr then true else false
      645       .
      646   end.
      647   define variable v-qnty as decimal   no-undo .
      648   define variable v-qnty-prt as decimal   no-undo .
      649   define buffer buf_goods  for ub.goods.
      650   define buffer buf2_goods for ub.goods.
      651   define buffer buf2_doc-line for ub.doc-line.
      652   for each ub.gds-dtl exclusive-lock where ub.gds-dtl.doc-code  = p-doc-code ,
      653       first temp-gds-dtl where
      654           temp-gds-dtl.artic     = ub.gds-dtl.artic and
      655           temp-gds-dtl.prod-type = ub.gds-dtl.prod-type and
      656           temp-gds-dtl.prod-code = ub.gds-dtl.prod-code and
      657           temp-gds-dtl.node-code = ub.gds-dtl.prt-code and
      658           temp-gds-dtl.rel-bk = true
      659     :
      660       v-qnty = 0 .
      661       v-qnty-prt = 0 .
      662       for each ub.doc-line-attr exclusive-lock
      663         where ub.doc-line-attr.doc-code  = p-doc-code
      664           and ub.doc-line-attr.gds-code  = temp-gds-dtl.gds-code
      665           and ub.doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(ub.gds-dtl.prt-code)  + chr(44)
      666        :
      667         v-qnty-prt = v-qnty-prt + dec(ub.doc-line-attr.attr-value) .
      668       end.
      669       if v-qnty-prt <> ub.gds-dtl.fact-qnty then do:
      670         p-error = true .
      671         find first  ub.goods WHERE ub.goods.gds-code = temp-gds-dtl.gds-code NO-LOCK no-error .
      672         find first  ub.gds-prt WHERE ub.gds-prt.node-code =  temp-gds-dtl.node-code NO-LOCK no-error .
      673          message "Несовпадают количества по наборам и общим количеством товара" skip
      674          "Товар :" (if ub.gds-prt.node-name <> '_Пустая шкала':U and ub.gds-prt.upper-code <> ub.goods.prt-root then ub.goods.gds-name + ' - ' + ub.gds-prt.f-name else ub.goods.gds-name) skip
      675          "Всего в наборах :" v-qnty-prt   skip
      676          "Итого товара :"    gds-dtl.fact-qnty
      677          view-as alert-box error
      678          .
      679         return error "Несовпадают количества по наборам и общим количеством товара".
      680       end.
      681   end.
