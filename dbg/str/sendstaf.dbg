      385   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      386   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
      387                                                       ,input p-range-type as character
      388                                                       ,input p-code as integer):
      389   define variable v-seq-val as integer no-undo .
      390   define buffer buf_code-range for ub.code-range.
      391   find first buf_code-range no-lock where
      392             buf_code-range.db-num = p-db-num
      393       and  buf_code-range.range-type = p-range-type
      394       and  buf_code-range.stts = 'u'
      395       and buf_code-range.first-code <= p-code
      396       and buf_code-range.last-code >= p-code no-error .
      397   if available buf_code-range then return yes.
      398   CASE p-range-type:
      399     when 'pngb':U then do:
      400       v-seq-val = current-value(s-pngb-code, ub).
      401     end.
      402     when 'fmgb':U then do:
      403       v-seq-val = current-value(s-fmgb-code, ub).
      404     end.
      405   END CASE.
      406   if p-code <= v-seq-val then do:
      407     find first buf_code-range no-lock where
      408               buf_code-range.db-num = p-db-num
      409         and  buf_code-range.range-type = p-range-type
      410         and  buf_code-range.stts = 'a'
      411         and buf_code-range.first-code <= p-code
      412         no-error .
      413    if available buf_code-range then return yes.
      414   end.
      415   find first buf_code-range no-lock where
      416             buf_code-range.db-num = p-db-num
      417       and  buf_code-range.range-type = p-range-type
      418       and  buf_code-range.stts = 'f'
      419       and buf_code-range.first-code <= p-code
      420       and buf_code-range.last-code >= p-code
      421       no-error .
      422   if available buf_code-range then return yes.
      423   return no.
      424   END FUNCTION.
      425   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
      426                                                       ,input p-range-type as character
      427                                                       ,input p-code as integer):
      428   define variable v-seq-val as integer no-undo .
      429   define buffer buf_code-range for ub.code-range.
      430   CASE p-range-type:
      431     when 'pngb':U then do:
      432       v-seq-val = current-value(s-pngb-code, ub).
      433     end.
      434     when 'fmgb':U then do:
      435       v-seq-val = current-value(s-fmgb-code, ub).
      436     end.
      437   END CASE.
      438   if p-code <= v-seq-val then do:
      439     find first buf_code-range no-lock where
      440               buf_code-range.db-num = p-db-num
      441         and  buf_code-range.range-type = p-range-type
      442         and buf_code-range.first-code <= p-code
      443         and buf_code-range.last-code >= p-code no-error .
      444     if available buf_code-range then return yes.
      445   end.
      446   return no.
      447   END FUNCTION.
      448   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
      449                                                       ,input p-db-num as integer
      450                                                       ,input p-staff-code as integer
      451                                                       ,input p-date as date
      452                                                        ):
      453   define buffer buf_staff for ub.staff.
      454   if p-date = ? then do:
      455     p-date = today .
      456   end.
      457   find first buf_staff no-lock where
      458             buf_staff.role = p-role
      459         and buf_staff.role-level = 'db':U
      460         and buf_staff.db-num = p-db-num
      461         and buf_staff.staff-code = p-staff-code
      462         and buf_staff.date-end >= p-date use-index pi  no-error .
      463   if available buf_staff then do:
      464     return buf_staff.psn-code.
      465   end.
      466   return 0.
      467   end FUNCTION.
      468   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
      469                                                             ,input p-db-num as integer
      470                                                             ,input p-date as date
      471                                                                 ):
      472   define buffer buf_staff for ub.staff.
      473   define buffer buf2_staff for ub.staff.
      474   if p-date = ? then do:
      475     p-date = today .
      476   end.
      477   for each  buf_staff no-lock where
      478             buf_staff.role = p-role
      479         and buf_staff.db-num = p-db-num,
      480   first buf2_staff no-lock where
      481         buf2_staff.role = p-role
      482     and buf2_staff.role-level = 'db':U
      483     and buf2_staff.staff-code = buf_staff.staff-code
      484     and buf2_staff.date-start <= p-date
      485     and buf2_staff.date-end >= p-date
      486   by buf_staff.staff-code
      487   by date-start descending:
      488     return buf_staff.staff-code.
      489   end.
      490   end FUNCTION.
      491   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
      492                                                  ,input p-db-num as integer
      493                                                  ,input p-psn-code as integer
      494                                                  ,input p-date as date
      495                                                  ,output p-c-password as character
      496                                                        ):
      497   define buffer buf_staff for ub.staff.
      498   if p-date = ? then do:
      499     p-date = today .
      500   end.
      501   find first buf_staff no-lock where
      502             buf_staff.role = p-role
      503         and buf_staff.role-level = 'db':U
      504         and buf_staff.db-num = p-db-num
      505        and buf_staff.date-end >= p-date
      506        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
      507   if available buf_staff
      508   then do:
      509     assign
      510     p-c-password = buf_staff.password.
      511     return buf_staff.staff-code.
      512   end.
      513   p-c-password = ''.
      514   return 0.
      515   end FUNCTION.
      516   FUNCTION gbclcode-is-psn-role returns integer (
      517                                                 input p-role as character
      518                                                 ,input p-psn-code as integer
      519                                                 ,input p-date as date
      520                                                     ):
      521   define buffer buf_staff for ub.staff.
      522   if p-date = ? then do:
      523     p-date = today .
      524   end.
      525   for each buf_staff no-lock where
      526             buf_staff.psn-code = p-psn-code
      527        and  buf_staff.role = p-role
      528   by buf_staff.role-level
      529   by buf_staff.date-start
      530        :
      531     if  buf_staff.date-start <= p-date and
      532     buf_staff.date-end >= p-date  then do:
      533       return buf_staff.staff-code.
      534     end.
      535   end.
      536   return 0.
      537   end FUNCTION.
      538   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
      539   define variable v-role-name as character no-undo .
      540   assign
      541   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      542   no-error .
      543   return v-role-name.
      544   END.
      545   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      546   FUNCTION gbclcode-get-position returns character ( input p-role as character
      547                                                     ,input p-role-level as character
      548                                                     ,input p-work-place as character
      549                                                     ,input p-staff-code as integer
      550                                                                ):
      551   define variable v-role-name as character no-undo .
      552   define variable v-role-level as character no-undo .
      553   define variable v-staff-code as integer no-undo .
      554   assign
      555   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      556   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      557   v-staff-code = p-staff-code
      558   no-error .
      559   return substitute("&1, &2, Код &3"
      560                   ,v-role-name
      561                   ,v-role-level
      562                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      563   END.
      564   FUNCTION gbclcode-get-work-place returns character (
      565                                                   input p-role as character
      566                                                  ,input p-role-level as character
      567                                                  ,input p-db-num as integer
      568                                                  ,input p-host-code as integer
      569                                                  ,input p-obj-type as character
      570                                                  ,input p-obj-code as integer
      571                                                  ) :
      572   define variable v-work-place as character no-undo .
      573   define variable v-obj-type as character no-undo .
      574     case p-role-level:
      575       when 'db':U then do:
      576         v-work-place = string(p-db-num, "99999").
      577       end.
      578       when 'firm':U then do:
      579         v-work-place = string(p-host-code, "99999").
      580       end.
      581       when 'object':U then do:
      582         assign
      583         v-work-place = p-obj-type + string(p-obj-code, "999999999")
      584         .
      585       end.
      586     END CASE.
      587     return v-work-place.
      588   END FUNCTION.
      589   FUNCTION gbclcode-get-level-last-code returns integer (
      590                                                           input p-role as character
      591                                                         , input p-role-level as character
      592                                                         , input p-work-place as character
      593                                                         , input p-date-start as date
      594                                                         ):
      595   DEFINE VARIABLE v-today as date no-undo .
      596   define buffer buf_staff for ub.staff.
      597   if p-work-place = chr(63) then return ?.
      598   if p-date-start = ? then do:
      599     v-today = today .
      600   end.
      601   else do:
      602     v-today = p-date-start.
      603   end.
      604   find last buf_staff no-lock where
      605             buf_staff.role = p-role
      606        and  buf_staff.role-level = p-role-level
      607        and  buf_staff.work-place = p-work-place
      608        and  buf_staff.date-start <= v-today + 1
      609        and  buf_staff.date-end >= v-today + 1
      610        use-index pi  no-error .
      611   if available buf_staff
      612   then return buf_staff.staff-code.
      613   return 0.
      614   end FUNCTION.
      615   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      616   procedure cur-time :
      617      define output parameter p-today as date      no-undo .
      618      define output parameter p-time  as integer   no-undo .
      619     do
      620     on error undo, return error
      621     :
      622       define variable v-date1 as date      no-undo .
      623       define variable v-date2 as date      no-undo .
      624       define variable v-time  as integer   no-undo .
      625       assign
      626         v-date1 = today
      627         v-time  = time
      628         v-date2 = today
      629       .
      630       if v-date1 <> v-date2
      631       then do:
      632         assign
      633           v-date1 = today
      634           v-time  = v-time
      635         .
      636       end.
      637       assign
      638         p-today = v-date1
      639         p-time  = v-time
      640       .
      641     end.
      642   end.
      643   function cur-time-date returns character
      644   :
      645     return string(today, '99/99/9999':U) .
      646   end.
      647   function cur-time-mjd returns decimal
      648   :
      649     define variable v-date as date      no-undo .
      650     define variable v-time as integer   no-undo .
      651     run cur-time in this-procedure
      652       (output v-date
      653       ,output v-time
      654       ) .
      655     return integer(v-date) - 2400002 + (v-time / 86400) .
      656   end.
      657   function cur-time-get-ending-index returns integer
      658   (input p-number as integer
      659   )
      660   :
      661     if p-number < 0
      662     or p-number = ?
      663     then do:
      664       return 1 .
      665     end.
      666     define variable v-rest as integer   no-undo .
      667     assign
      668       p-number = p-number modulo 100
      669     .
      670     if p-number < 20
      671     then do:
      672       assign
      673         v-rest = p-number
      674       .
      675     end.
      676     else do:
      677       assign
      678         v-rest = p-number modulo 10
      679       .
      680     end.
      681     case v-rest :
      682       when 1
      683       then do:
      684         return 2 .
      685       end.
      686       when 2 or
      687       when 3 or
      688       when 4
      689       then do:
      690         return 3 .
      691       end.
      692       otherwise do:
      693         return 1 .
      694       end.
      695     end case .
      696   end.
      697   procedure cur-time-mjd-to-date :
      698      define input  parameter i-mjd-diff as decimal no-undo.
      699      define output parameter o-Date     as date    no-undo.
      700      define output parameter o-Time     as integer no-undo.
      701      define variable v-day-number as integer   no-undo .
      702      if    i-mjd-diff < 0
      703         or i-mjd-diff = ?
      704      then do:
      705         return "?" .
      706      end.
      707      assign
      708         v-day-number = truncate(i-mjd-diff,0).
      709         o-Date = date(v-day-number + 2400002).
      710         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      711     .
      712   end.
      713   function cur-time-mjd-to-string returns character
      714   (input p-mjd-diff as decimal
      715   )
      716   :
      717     define variable v-day-number as integer   no-undo .
      718     define variable v-seconds    as integer   no-undo .
      719     define variable v-hour       as integer   no-undo .
      720     define variable v-min        as integer   no-undo .
      721     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      722     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      723     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      724     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      725     if p-mjd-diff < 0
      726     or p-mjd-diff = ?
      727     then do:
      728       return "?" .
      729     end.
      730     assign
      731       v-day-number = integer(truncate(p-mjd-diff,0))
      732       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      733     .
      734     if v-seconds > 86400
      735     then do:
      736       assign
      737         v-seconds = 86400 - 1
      738       .
      739     end.
      740     if v-seconds < 0
      741     then do:
      742       assign
      743         v-seconds = 0
      744       .
      745     end.
      746     assign
      747       v-hour = truncate(v-seconds / 3600, 0)
      748     .
      749     assign
      750       v-seconds = v-seconds modulo 3600
      751     .
      752     assign
      753       v-min = truncate(v-seconds / 60, 0)
      754     .
      755     assign
      756       v-seconds = v-seconds modulo 60
      757     .
      758     return
      759         (if v-day-number <> 0
      760           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      761           else ""
      762         )
      763       + (if v-day-number <> 0 or v-hour <> 0
      764           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      765           else ""
      766         )
      767       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      768           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      769           else ""
      770         )
      771       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      772       .
      773   end.
      774   function cur-time-string returns character
      775   :
      776     define variable v-date as date      no-undo .
      777     define variable v-time as integer   no-undo .
      778     run cur-time in this-procedure
      779       (output v-date
      780       ,output v-time
      781       ) .
      782     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      783   end.
      784   function cur-time-string-sec returns character
      785   :
      786     define variable v-date as date      no-undo .
      787     define variable v-time as integer   no-undo .
      788     run cur-time in this-procedure
      789       (output v-date
      790       ,output v-time
      791       ) .
      792     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      793   end.
      794   function cur-time-custom  returns character
      795   (input p-prefix as character
      796   ,input p-date-format as character
      797   ,input p-delimiter as character
      798   ,input p-time-format as character
      799   ,input p-suffix as character
      800   )
      801   :
      802     define variable v-date as date      no-undo .
      803     define variable v-time as integer   no-undo .
      804     run cur-time in this-procedure
      805       (output v-date
      806       ,output v-time
      807       ) .
      808     return
      809       p-prefix
      810       + string(v-date, p-date-format)
      811       + p-delimiter
      812       + string(v-time, p-time-format)
      813       + p-suffix
      814       .
      815   end.
      816   function cur-time-print  returns character
      817   :
      818     define variable v-date as date      no-undo .
      819     define variable v-time as integer   no-undo .
      820     run cur-time in this-procedure
      821       (output v-date
      822       ,output v-time
      823       ) .
      824     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      825   end.
      826   function cur-time-datetime returns datetime
      827   :
      828     define variable v-char as character no-undo .
      829     define variable v-datetime as datetime no-undo .
      830     v-char = cur-time-string().
      831     v-datetime = datetime(v-char).
      832     return  v-datetime.
      833   end.
      834   function cur-time-string-msec returns character
      835   :
      836     define variable v-date as datetime  no-undo .
      837     v-date = now.
      838     return string(v-date) .
      839   end.
      840   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      841     define variable v-cntxt-db-num        as integer   no-undo .
      842     define variable v-cntxt-userid        as character no-undo .
      843     define variable v-cntxt-level         as character no-undo .
      844     define variable v-cntxt-host-code-obj as integer   no-undo .
      845     define variable v-cntxt-obj-type      as character no-undo .
      846     define variable v-cntxt-obj-code      as integer   no-undo .
      847     define variable v-cntxt-db-num-obj    as integer   no-undo .
      848     define variable v-cntxt-is-admin      as logical   no-undo .
      849   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      850     run mainmenu_getcntxt in parparentproc
      851       (output v-cntxt-db-num
      852       ,output v-cntxt-userid
      853       ,output v-cntxt-level
      854       ,output v-cntxt-host-code-obj
      855       ,output v-cntxt-obj-type
      856       ,output v-cntxt-obj-code
      857       ,output v-cntxt-db-num-obj
      858       ,output v-cntxt-is-admin
      859       ) .
      860   define variable choice as integer no-undo.
      861   define variable cli-list  as character no-undo.
      862   define variable kk        as integer      no-undo.
      863   define variable callpoint as character no-undo.
      864   define variable dops as character no-undo format "X(250)".
      865   define variable dopst as character no-undo format "X(1)".
      866   define variable glog as logical no-undo .
      867   define variable log-file-name as character no-undo init "send-cd.txt".
      868   define variable v-view-log as logical no-undo .
      869   define variable v-value as character no-undo .
      870   define variable v-type as character no-undo .
      871   define variable v-work-place as character no-undo .
      872   DEFINE VARIABLE v-today as date no-undo .
      873   DEFINE VARIABLE v-time as integer no-undo .
      874   define variable v-host-code as integer no-undo .
      875   define buffer buf_clients for ub.clients.
      876   define buffer buf_staff for ub.staff.
      877   assign
      878   p-obj-type = entry(1, p-parameter, chr(4))
      879   p-obj-code = integer(entry(2, p-parameter, chr(4)))
      880   action = entry(3, p-parameter, chr(4))
      881   no-error
      882   .
      883   if error-status:error then return error.
      884   assign
      885   callpoint = action.
      886   action = if action = "R" then "U" else action.
      887   for each cash-cash:
      888       delete cash-cash.
      889   end.
      890   FIND FIRST ub.cash-desk NO-LOCK WHERE
      891              ub.cash-desk.db-num = g#db-num
      892         AND  ub.cash-desk.pos-type = 'MAGIA-XML':U
      893               No-error.
      894   IF not avail(ub.cash-desk) then do:
      895     if callpoint <> "R" then do:
      896         run write-log-and-file in p-log-handle (
      897               input 1
      898             , input log-file-name
      899             , input 1
      900             , input substitute( "!!!&1 персонала реализуется только для POS"
      901                                 , (if action = "U" then "Передача" else "Удаление")
      902                                 , 'MAGIA-XML':U
      903                               )
      904                                               ).
      905        return.
      906     end.
      907   end.
      908   if callpoint = "R" then glog = yes.
      909   else do:
      910     if not g#news then do:
      911   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      912   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      913     (input  p-obj-type
      914     ,input  p-obj-code
      915     ,output v-host-code
      916     )  .
      917   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      918   do:
      919     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      920       (input  v-cntxt-db-num
      921       ,input  v-cntxt-userid
      922       ,input  0
      923       ,input  'actn_cashdesk-restaurant_work':U
      924       ,input  'firm':U
      925       ,input  v-host-code
      926       ,input  '':U
      927       ,input  0
      928       ,input  0
      929       ,input  0
      930       ,input  0
      931       ,input  true
      932       ,output glog
      933       )  .
      934   end.
      935       if NOT glog then return .
      936     end.
      937   end.
      938   glog = yes.
      939   if callpoint = "R" then choice = 2.
      940   else
      941   run gbl/d-askw.w (input "Выбор персонала для пересылки",
      942               input ( (if action = "U" then "Переслать на кассу"
      943                         else "Удалить (заблокировать)" ) +
      944                         if g#db-num = 0
      945                         then
      946                         chr(10) + "информацию по персоналу"
      947                         else
      948                         chr(10) + "информацию по персоналу, заведенную в ГБД и текущей БД"
      949                         ),
      950               input "|",
      951               input "Официанты и кассиры-Все имеющиеся в базе|Официанты-Выборочно|Кассиры-Выборочно|Отказ от пересылки",
      952               input "|||",
      953               input 1,
      954               input 4,
      955               output choice).
      956   run cur-time in this-procedure ( output v-today, output v-time).
      957   CASE choice :
      958     when 4 then
      959         return .
      960     when 3
      961     or
      962     when 2
      963     then do:
      964       if callpoint = "R" then do:
      965         run write-log-and-file in p-log-handle (
      966               input 1
      967             , input log-file-name
      968             , input 1
      969             , input substitute("Подготовка данных")
      970                                             ).
      971         FOR EACH stf-list No-LOCK,
      972           first buf_clients no-lock where
      973               buf_clients.obj-type = 'чел':U
      974           and buf_clients.obj-code = stf-list.psn-code:
      975           FIND FIRST cash-cash WHERE
      976                       cash-cash.psn-code = stf-list.psn-code NO-ERROR.
      977           if not avail cash-cash then do:
      978             create cash-cash.
      979             assign
      980             cash-cash.psn-code =  stf-list.psn-code
      981             cash-cash.cash-code = (if stf-list.role = 'C':U then stf-list.staff-code else 0 )
      982             cash-cash.slr-code =  (if stf-list.role = 'S':U then stf-list.staff-code else 0 )
      983             cash-cash.cash-name = buf_clients.obj-name
      984             cash-cash.stts = (if stf-list.date-end < v-today then 1 else 0)
      985             cash-cash.psswd = (if stf-list.role = 'C':U then stf-list.password else ? )
      986             cash-cash.s-psswd = (if stf-list.role = 'S':U then stf-list.password else ? )
      987             cash-cash.ident-type = 1
      988             .
      989             run clntattr-value  in this-procedure (                                                     input  'чел':U                                                               ,input  cash-cash.psn-code                                                   ,input 'is-superviser':U                                                ,output v-value                                                               ,output v-type     ) no-error .        if not error-status:error then do:                                              assign                                                                        cash-cash.superviser = (if v-value = "yes" then 1 else 0)                     .                                                                           end.
      990             release cash-cash.
      991           end.
      992         END.
      993       end.
      994       else do:
      995         run ref/staffs.w (
      996                          input parparentproc
      997                        , input "b-sel,b-mark"
      998                        , input (if choice = 3 then 'C':U else 'S':U)
      999                        , input g#db-num
     1000                        , input 0
     1001                        , output cli-list ) .
     1002         if cli-list <> "" then do:
     1003           run write-log-and-file in p-log-handle (
     1004                 input 1
     1005               , input log-file-name
     1006               , input 1
     1007               , input substitute("&1 магазина &2: &3: выборочная пересылка"
     1008                                 , (if action = "U" then "Пересылка на кассы" else "Удаление с касс" )
     1009                                 , p-obj-code
     1010                                 , entry (lookup ((if choice = 3 then 'C':U else 'S':U), 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
     1011                                 )
     1012               ).
     1013           run write-log-and-file in p-log-handle (
     1014                 input 1
     1015               , input log-file-name
     1016               , input 1
     1017               , input substitute("Подготовка данных")
     1018                                               ).
     1019           DO kk = 1 TO num-entries( cli-list ) :
     1020             FIND FIRST buf_staff NO-LOCK WHERE
     1021                       recid(buf_staff) = integer(ENTRY(kk, cli-list)) NO-ERROR.
     1022             IF AVAIL buf_staff then do:
     1023               FIND FIRST buf_clients NO-LOCK WHERE
     1024                         buf_clients.obj-type = 'чел':U
     1025                     AND buf_clients.obj-code = buf_staff.psn-code NO-ERROR.
     1026               IF avail buf_clients then do:
     1027                 FIND FIRST cash-cash WHERE
     1028                             cash-cash.psn-code = buf_staff.psn-code NO-ERROR.
     1029                 if not avail cash-cash then do:
     1030                   create cash-cash.
     1031                   assign
     1032                   cash-cash.psn-code = buf_staff.psn-code
     1033                   cash-cash.cash-code = (if buf_staff.role = 'C':U then buf_staff.staff-code else 0)
     1034                   cash-cash.slr-code = (if buf_staff.role = 'S':U then buf_staff.staff-code else 0)
     1035                   cash-cash.cash-name = buf_clients.obj-name
     1036                   cash-cash.stts = (if buf_staff.date-end < v-today then 1 else 0)
     1037                   cash-cash.psswd = (if buf_staff.role = 'C':U then buf_staff.password else ? )
     1038                   cash-cash.s-psswd = (if buf_staff.role = 'S':U then buf_staff.password else ? )
     1039                   cash-cash.ident-type = 1
     1040                   .
     1041                   run clntattr-value  in this-procedure (                                                     input  'чел':U                                                               ,input  cash-cash.psn-code                                                   ,input 'is-superviser':U                                                ,output v-value                                                               ,output v-type     ) no-error .        if not error-status:error then do:                                              assign                                                                        cash-cash.superviser = (if v-value = "yes" then 1 else 0)                     .                                                                           end.
     1042                   release cash-cash.
     1043                 end.
     1044               END.
     1045             END.
     1046           END.
     1047         end.
     1048         else  do:
     1049           run write-log-and-file in p-log-handle (
     1050                 input 1
     1051               , input log-file-name
     1052               , input 1
     1053               , input substitute("&1: Не определен список для пересылки", entry (lookup ((if choice = 3 then 'C':U else 'S':U), 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U))
     1054                                               ).
     1055           return .
     1056         end.
     1057       end.
     1058     end.
     1059     when 1 then do:
     1060       run write-log-and-file in p-log-handle (
     1061             input 1
     1062           , input log-file-name
     1063           , input 1
     1064           , input substitute("Подготовка данных")
     1065                                                     ).
     1066       assign
     1067       v-work-place =  gbclcode-get-work-place  (
     1068                                                   input 'C':U
     1069                                                  ,input 'db':U
     1070                                                  ,input g#db-num
     1071                                                  ,input 0
     1072                                                  ,input '':U
     1073                                                  ,input 0).
     1074       for each buf_staff no-lock where
     1075               buf_staff.role = 'C':U
     1076           and buf_staff.role-leve = 'db':U
     1077           and buf_staff.work-place = v-work-place
     1078           and buf_staff.date-end >= v-today,
     1079         FIRST buf_clients WHERE
     1080               buf_clients.obj-type = 'чел':U
     1081           AND buf_clients.obj-code = buf_staff.psn-code:
     1082         FIND FIRST cash-cash WHERE
     1083                     cash-cash.psn-code = buf_staff.psn-code NO-ERROR.
     1084         if not avail cash-cash then do:
     1085           create cash-cash.
     1086           assign
     1087           cash-cash.psn-code = buf_staff.psn-code
     1088           cash-cash.cash-name = buf_clients.obj-name
     1089           cash-cash.stts = buf_clients.stts
     1090           cash-cash.cash-code = buf_staff.staff-code
     1091           cash-cash.psswd = buf_staff.password
     1092           cash-cash.stts = (if buf_staff.date-end < v-today then 1 else 0)
     1093           cash-cash.ident-type = 1
     1094           .
     1095           run clntattr-value  in this-procedure (                                                     input  'чел':U                                                               ,input  cash-cash.psn-code                                                   ,input 'is-superviser':U                                                ,output v-value                                                               ,output v-type     ) no-error .        if not error-status:error then do:                                              assign                                                                        cash-cash.superviser = (if v-value = "yes" then 1 else 0)                     .                                                                           end.
     1096           release cash-cash.
     1097         end.
     1098       END.
     1099       v-work-place =  gbclcode-get-work-place  (
     1100                                                   input 'S':U
     1101                                                  ,input 'db':U
     1102                                                  ,input g#db-num
     1103                                                  ,input 0
     1104                                                  ,input '':U
     1105                                                  ,input 0).
     1106       for each buf_staff no-lock where
     1107               buf_staff.role = 'S':U
     1108           and buf_staff.role-level = 'db':U
     1109           and buf_staff.work-place = v-work-place
     1110           and buf_staff.date-end >= v-today ,
     1111         FIRST buf_clients WHERE
     1112               buf_clients.obj-type = 'чел':U
     1113           AND buf_clients.obj-code = buf_staff.psn-code:
     1114         FIND FIRST cash-cash WHERE
     1115                     cash-cash.psn-code = buf_staff.psn-code NO-ERROR.
     1116         if not avail cash-cash then do:
     1117           create cash-cash.
     1118           assign
     1119           cash-cash.psn-code = buf_staff.psn-code
     1120           cash-cash.cash-name = buf_clients.obj-name
     1121           cash-cash.slr-code = buf_staff.staff-code
     1122           cash-cash.s-psswd = buf_staff.password
     1123           cash-cash.stts = (if buf_staff.date-end < v-today then 1 else 0)
     1124           cash-cash.ident-type = 1
     1125           .
     1126           run clntattr-value  in this-procedure (                                                     input  'чел':U                                                               ,input  cash-cash.psn-code                                                   ,input 'is-superviser':U                                                ,output v-value                                                               ,output v-type     ) no-error .        if not error-status:error then do:                                              assign                                                                        cash-cash.superviser = (if v-value = "yes" then 1 else 0)                     .                                                                           end.
     1127           release cash-cash.
     1128         end.
     1129         else do:
     1130           assign
     1131           cash-cash.slr-code = buf_staff.staff-code
     1132           cash-cash.s-psswd = buf_staff.password
     1133           cash-cash.stts = (if buf_staff.date-end < v-today or cash-cash.stts = 1 then 1 else 0)
     1134           cash-cash.ident-type = 1
     1135           .
     1136           run clntattr-value  in this-procedure (                                                     input  'чел':U                                                               ,input  cash-cash.psn-code                                                   ,input 'is-superviser':U                                                ,output v-value                                                               ,output v-type     ) no-error .        if not error-status:error then do:                                              assign                                                                        cash-cash.superviser = (if v-value = "yes" then 1 else 0)                     .                                                                           end.
     1137           release cash-cash.
     1138         end.
     1139       END.
     1140     end.
     1141   END CASE.
     1142   if can-find(first cash-cash ) then do:
     1143     run str/send-stf.p (
     1144                     input parparentproc
     1145                    ,input p-parent-handle
     1146                    ,input p-log-handle
     1147                    ,input (p-obj-type + chr(4) + string(p-obj-code) + chr(4) + action +
     1148                            chr(4) + "no":U)) no-error.
     1149     if not error-status:error then do:
     1150       run write-log-and-file in p-log-handle (
     1151               input 1
     1152             , input log-file-name
     1153             , input 1
     1154             , input substitute("&1 маг&2 &3"
     1155                                 , (if action = "U"
     1156                                   then "Передача персонала на кассы"
     1157                                   else "Удаление перасонала с касс")
     1158                                 , p-obj-code
     1159                                 , (if action = "U"
     1160                                   then "проведена"
     1161                                   else "проведено")
     1162                                 )
     1163                                             ).
     1164     end.
     1165     else do:
     1166       assign
     1167       v-view-log = yes
     1168       .
     1169     end.
     1170   end.
     1171   else do:
     1172     run write-log-and-file in p-log-handle (
     1173           input 1
     1174         , input log-file-name
     1175         , input 1
     1176         , input substitute("Не найдено информации по персоналу для передачи на кассы маг&1"
     1177                             , p-obj-code )
     1178                             ).
     1179   end.
     1180   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1181   if v-view-log
     1182   and not g#news
     1183   and not g#auto
     1184   then do:
     1185     message
     1186     '!!!При отсылке информации на кассы произошли ошибки!!!'  skip
     1187     "!!!Внимательно прочитайте Log-file!!"
     1188     view-as alert-box error .
     1189        define variable v-user-action11   as character no-undo .
     1190     define variable v-printed11       as logical   no-undo .
     1191     run gbl/prnfilen.w
     1192       (input  ('!!!При отсылке информации на кассы произошли ошибки!!!')
     1193       ,input  0
     1194       ,input  (string("./":U) + 'send-cd.txt')
     1195       ,input  7
     1196       ,output v-user-action11
     1197       ,output v-printed11
     1198       ) .
     1199   end.
     1200   if v-view-log = true
     1201   and (g#news
     1202   or g#auto)
     1203   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     1204   then do:
     1205      run cb_set-view-log in p-parent-handle ( input yes).
     1206   end.
     1207   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     1208     OS-DELETE value(string("./":U) + 'send-cd.txt').
     1209   end.
