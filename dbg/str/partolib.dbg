      307   procedure partolib_partocod :
      308     define  input parameter p-code           as character no-undo.
      309     define output parameter p-type           as character no-undo.
      310     define output parameter p-format         as character no-undo.
      311     define output parameter p-fillin_width   as integer   no-undo.
      312     define output parameter p-fillin_height  as integer   no-undo.
      313     define output parameter p-label          as character no-undo.
      314     define output parameter p-user-can-edit  as logical   no-undo.
      315     define output parameter p-output-display as logical   no-undo.
      316     define output parameter p-other          as character no-undo.
      317     define output parameter p-proc-attr       as character no-undo.
      318     define output parameter p-full-screen-val as character no-undo.
      319     define output parameter p-sort as integer   no-undo .
      320     do on error undo, return error return-value :
      321       case p-code :
      322               when 'parts-end':U then do:     assign p-label          = "Дата исчерпания своб зоны"            p-type           = 'C':U             p-format         = "x(10)"            p-fillin_width   = 10            p-fillin_height  = 3            p-label          = "Дата исчерпания своб зоны"            p-user-can-edit  = false            p-output-display = true            p-sort           = 45            p-proc-attr      = ''            p-other          = '':u . end.
      323         otherwise do:
      324           undo, return error substitute( 'неизвестный атрибут документа "&1"', p-code ).
      325         end.
      326       end case.
      327     end.
      328   end procedure.
