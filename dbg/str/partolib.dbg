        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U.
        3   define variable vss-author      as character no-undo initial "$Author: expertek $":U.
        4   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U.
        5   define variable vss-workfile    as character no-undo initial "$Workfile: partolib.p $":U.
        6   define variable vss-archive     as character no-undo initial "$Archive: str/partolib.p $":U.
        7   define variable vss-description as character no-undo initial "Библиотека процедур для работы с атрибутами партии на объекте":U.
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67    define new global shared variable g#partolib as handle no-undo.
       68   if valid-handle( g#partolib ) and g#partolib <> this-procedure :handle then do:
       69     message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 0 ) vss-description skip( 1 )
       70             "partolib.p: попытка повторной загрузки библиотеки" skip( 1 )
       71             g#partolib                     skip( 0 )
       72             g#partolib     :type           skip( 0 )
       73             g#partolib     :file-name      skip( 0 )
       74             valid-handle( g#partolib     ) skip( 0 )
       75             this-procedure :handle         skip( 0 )
       76             this-procedure :type           skip( 0 )
       77             this-procedure :file-name      skip( 0 )
       78             valid-handle( this-procedure ) skip( 0 )
       79     view-as alert-box error title " О Ш И Б К А  ! ! ! ".
       80     undo, return error "partolib.p: попытка повторной загрузки библиотеки".
       81   end.
       82   else do:
       83     assign
       84       g#partolib = this-procedure :handle
       85     .
       86   end.
       87   on delete of this-procedure do:
       88     assign
       89       g#partolib = ?
       90     .
       91   end.
       92   procedure partolib_partoval :
       93     define  input parameter p-obj-type as character no-undo .
       94     define  input parameter p-obj-code as integer no-undo .
       95     define  input parameter p-gds-code as integer no-undo .
       96     define  input parameter p-prt-code as integer no-undo .
       97     define  input parameter p-in-code as character no-undo .
       98     define  input parameter p-out-code as character no-undo .
       99     define  input parameter p-part-code as character no-undo .
      100     define  input parameter p-code     like ub.parts-obj-attr.attr-code  no-undo.
      101     define output parameter p-value    like ub.parts-obj-attr.attr-value no-undo.
      102     define output parameter p-type     as   character              no-undo.
      103     define buffer buf_parts-obj-attr for ub.parts-obj-attr.
      104     define variable v-format         as character no-undo.
      105     define variable v-fillin_width   as integer   no-undo.
      106     define variable v-fillin_height  as integer   no-undo.
      107     define variable v-label          as character no-undo.
      108     define variable v-user-can-edit  as logical   no-undo.
      109     define variable v-output-display as logical   no-undo.
      110     define variable v-other          as character no-undo.
      111     define variable v-proc-attr       as character no-undo .
      112     define variable v-full-screen-val as character no-undo .
      113     define variable v-sort as integer   no-undo .
      114     do on error undo, return error return-value :
      115   if valid-handle( g#partolib ) <> yes then do:       run str/partolib.p persistent no-error.       if error-status :error or valid-handle( g#partolib ) <> yes then do:         message "Error starting partolib.p"    skip( 0 )                 g#partolib                     skip( 0 )                 g#partolib   :type             skip( 0 )                 g#partolib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run partolib_partocod in g#partolib (  input p-code ,
      116                          output p-type ,
      117                          output v-format ,
      118                          output v-fillin_width ,
      119                          output v-fillin_height ,
      120                          output v-label ,
      121                          output v-user-can-edit ,
      122                          output v-output-display ,
      123                          output v-other  ,
      124                          output v-proc-attr ,
      125                          output v-full-screen-val ,
      126                          output v-sort
      127                          ) no-error .
      128       if error-status :error then do: undo, return error return-value. end.
      129       find first buf_parts-obj-attr no-lock where
      130                  buf_parts-obj-attr.obj-type  = p-obj-type
      131              and buf_parts-obj-attr.obj-code  = p-obj-code
      132              and buf_parts-obj-attr.gds-code  = p-gds-code
      133              and buf_parts-obj-attr.prt-code  = p-prt-code
      134              and buf_parts-obj-attr.in-code  = p-in-code
      135              and buf_parts-obj-attr.out-code  = p-out-code
      136              and buf_parts-obj-attr.part-code  = p-part-code
      137              and buf_parts-obj-attr.attr-code = p-code     no-error.
      138       assign p-value = ( if available buf_parts-obj-attr then buf_parts-obj-attr.attr-value else
      139                        ( if p-type = 'L':U then "no":U else "":U ) ).
      140     end.
      141   end procedure.
