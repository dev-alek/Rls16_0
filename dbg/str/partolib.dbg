      177                          ) no-error .
      178       if error-status :error then do: undo, return error return-value. end.
      179       find first buf_parts-obj-attr exclusive-lock where
      180                  buf_parts-obj-attr.obj-type  = p-obj-type
      181              and buf_parts-obj-attr.obj-code  = p-obj-code
      182              and buf_parts-obj-attr.gds-code  = p-gds-code
      183              and buf_parts-obj-attr.prt-code  = p-prt-code
      184              and buf_parts-obj-attr.in-code  = p-in-code
      185              and buf_parts-obj-attr.out-code  = p-out-code
      186              and buf_parts-obj-attr.part-code  = p-part-code
      187              and buf_parts-obj-attr.attr-code = p-code     no-error.
      188       if not available buf_parts-obj-attr then do:
