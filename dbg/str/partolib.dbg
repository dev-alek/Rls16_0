      276                          output v-type ,
      277                          output v-format ,
      278                          output v-fillin_width ,
      279                          output v-fillin_height ,
      280                          output v-label ,
      281                          output v-user-can-edit ,
      282                          output v-output-display ,
      283                          output v-other  ,
      284                          output v-proc-attr ,
      285                          output v-full-screen-val ,
      286                          output v-sort
      287                          ) no-error .
      288       if error-status :error then do: undo, return error return-value. end.
      289       find first buf_parts-obj-attr exclusive-lock where
      290                  buf_parts-obj-attr.obj-type  = p-obj-type
      291              and buf_parts-obj-attr.obj-code  = p-obj-code
      292              and buf_parts-obj-attr.gds-code  = p-gds-code
      293              and buf_parts-obj-attr.prt-code  = p-prt-code
      294              and buf_parts-obj-attr.in-code  = p-in-code
      295              and buf_parts-obj-attr.out-code  = p-out-code
      296              and buf_parts-obj-attr.part-code  = p-part-code
