      369   procedure partolib_tdatothn :
      370     define input parameter p-obj-type as character no-undo .
      371     define input parameter p-obj-code as integer no-undo .
      372     define input parameter p-gds-code as integer no-undo .
      373     define input parameter p-prt-code as integer no-undo .
      374     define input parameter p-in-code as character no-undo .
      375     define input parameter p-out-code as character no-undo .
      376     define input parameter p-part-code as character no-undo .
      377     define input parameter p-code     as character no-undo.
      378     define variable v-type           as character no-undo.
      379     define variable v-format         as character no-undo.
      380     define variable v-fillin_width   as integer   no-undo.
      381     define variable v-fillin_height  as integer   no-undo.
      382     define variable v-label          as character no-undo.
      383     define variable v-user-can-edit  as logical   no-undo.
      384     define variable v-output-display as logical   no-undo.
      385     define variable v-other          as character no-undo.
      386     define variable v-proc-attr       as character no-undo .
      387     define variable v-full-screen-val as character no-undo .
      388     define variable v-sort as integer   no-undo .
      389     define buffer buf_parts-obj-attr for ub.parts-obj-attr.
      390     do on error undo, return error return-value :
      391       find first buf_parts-obj-attr no-lock where
      392                  buf_parts-obj-attr.obj-type  = p-obj-type
      393              and buf_parts-obj-attr.obj-code  = p-obj-code
      394              and buf_parts-obj-attr.gds-code  = p-gds-code
      395              and buf_parts-obj-attr.prt-code  = p-prt-code
      396              and buf_parts-obj-attr.in-code  = p-in-code
      397              and buf_parts-obj-attr.out-code  = p-out-code
      398              and buf_parts-obj-attr.part-code  = p-part-code
      399              and buf_parts-obj-attr.attr-code = p-code     no-error no-wait.
      400       run str/callnews.p ( input 'parts-obj-attr':U
      401                          , input ( buffer buf_parts-obj-attr :handle ) ) no-error.
      402       if error-status :error then do:
      403         message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
      404                 "Невозможно маршрутизировать part-obj-attr для отправки в новости" skip( 0 )
      405                 "Атрибут:"  '"' + buf_parts-obj-attr.attr-code + '"' skip( 0 )
      406                 error-status :get-message( 1 ) skip( 0 )
      407                 error-status :get-message( 2 ) skip( 0 )
      408                 error-status :get-message( 3 ) skip( 0 )
      409                 "return-value = " return-value skip( 0 )
      410         view-as alert-box error.
      411         undo, return error return-value.
      412       end.
      413     end.
      414   end procedure.
