     2444        SIZE 30 BY 1
     2445        FGCOLOR 12  NO-UNDO.
     2446   DEFINE VARIABLE loc-name AS CHARACTER FORMAT "X(256)":U
     2447        LABEL ""
     2448        VIEW-AS FILL-IN
     2449        SIZE 30 BY 1
     2450        FGCOLOR 12  NO-UNDO.
     2451   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     2452         VIEW-AS TEXT
     2453        SIZE 6 BY 1
     2454        FGCOLOR 4  NO-UNDO.
     2455   DEFINE IMAGE cd-image
     2456        FILENAME "adeicon/blank":U
     2457        SIZE 3 BY 1 TOOLTIP "Отправьте клиентов на кассы".
     2458   DEFINE VARIABLE a-n-c AS CHARACTER
     2459        VIEW-AS RADIO-SET HORIZONTAL
     2460        RADIO-BUTTONS
     2461             "&Код", "b-code",
     2462   "&CLU", "CLU"
     2463        SIZE 29.5 BY 1 NO-UNDO.
     2464   DEFINE QUERY br-mcli FOR
     2465         X_cd-clu,
     2466         X_clients SCROLLING.
     2467   DEFINE BROWSE br-mcli
     2468     QUERY br-mcli NO-LOCK DISPLAY
     2469         X_cd-clu.clu-code COLUMN-LABEL "CLU" FORMAT "999":U WIDTH 12
     2470   X_cd-clu.cli-type + string(X_cd-clu.cli-code) FORMAT "X(12)":U
     2471   X_cd-clu.to-send  COLUMn-LABEL "И" FORMAT "+/":U
     2472   X_cd-clu.to-DEL COLUMN-LABEL "У" FORMAT "+/":U
     2473   X_clients.obj-name FORMAT "X(50)":U
     2474   ('K':U + string(if X_cd-clu.cli-type = 'орг':U then 1 else 0) + string(X_cd-clu.cli-code, '999999999')) COLUMN-LABEL 'Клиент-Счет' FORMAT "X(11)":U
     2475       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.25 BY 17.5 FIT-LAST-COLUMN.
     2476   DEFINE FRAME Dialog-Frame
     2477        b-quit AT ROW 1 COL 1
     2478        B-mark AT ROW 1 COL 11
     2479        b-sel AT ROW 1 COL 21
     2480        B-lkp AT ROW 1 COL 31
     2481        B-chg AT ROW 1 COL 41
     2482        B-send AT ROW 1 COL 51
     2483        B-print AT ROW 1 COL 89
     2484        B-sch AT ROW 1 COL 92
     2485        B-Help AT ROW 1 COL 95
     2486        a-n-c AT ROW 2 COL 2 NO-LABEL
     2487        loc-name AT ROW 2 COL 55 COLON-ALIGNED
     2488        loc-code AT ROW 2 COL 55 COLON-ALIGNED
     2489        br-mcli AT ROW 4.25 COL 1
     2490        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     2491        f-max-cli AT ROW 3 COL 1
     2492        f-tot-cli AT ROW 3 COL 25
     2493        f-max-CLU AT ROW 3 COL 50
     2494        cd-image AT ROW 2.25 COL 92
     2495        SPACE(4.25) SKIP(18.78)
     2496       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2497            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2498            TITLE "Клиенты на кассе".
     2499   ASSIGN
     2500          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2501          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2502   ASSIGN
     2503          B-send:POPUP-MENU IN FRAME Dialog-Frame       = MENU POPUP-MENU-B-send:HANDLE.
     2504   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2505   DO:
     2506     APPLY "END-ERROR":U TO SELF.
     2507   END.
     2508   ON VALUE-CHANGED OF a-n-c IN FRAME Dialog-Frame
     2509   DO:
     2510       case input frame Dialog-Frame a-n-c :
     2511       when "b-code" then do:
     2512         enable
     2513         loc-code
     2514         with frame Dialog-Frame.
     2515         loc-code:label = "Код".
     2516         display
     2517         loc-code
     2518         with frame Dialog-Frame.
     2519         hide
     2520         loc-name
     2521         in frame Dialog-Frame.
     2522         apply "entry" to loc-code in frame Dialog-Frame.
     2523       end.
     2524       when "CLU" then do:
     2525         enable
     2526         loc-code
     2527         with frame Dialog-Frame.
     2528         loc-code:label = "CLU (без № маг)".
     2529         display
     2530         loc-code
     2531         with frame Dialog-Frame.
     2532         hide
     2533         loc-name
     2534         in frame Dialog-Frame.
     2535         apply "entry" to loc-code in frame Dialog-Frame.
     2536       end.
     2537       when "obj-type" then do:
     2538         enable
     2539         loc-name
     2540         with frame Dialog-Frame.
     2541         loc-name:label = "Доп.БК".
     2542         display
     2543         loc-name
     2544         with frame Dialog-Frame.
     2545         hide
     2546         loc-code
     2547         in frame Dialog-Frame.
     2548         apply "entry" to loc-name in frame Dialog-Frame.
     2549       end.
     2550     end.
     2551   END.
     2552   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     2553   DO:
     2554     RUN proc-b-chg IN THIS-PROCEDURE NO-ERROR.
     2555     IF ERROR-STATUS:error THEN RETURN NO-APPLY.
     2556   END.
     2557   ON CHOOSE OF B-lkp IN FRAME Dialog-Frame
     2558   DO:
     2559       IF NOT AVAILABLE  X_cd-clu THEN RETURN NO-APPLY.
     2560       run ref/showcli.p
     2561       (input parParentProc
     2562       ,input X_cd-clu.cli-type
     2563       ,input X_cd-clu.cli-code
     2564       ).
     2565   END.
     2566   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     2567   DO:
     2568   define variable loc#log as logical no-undo .
     2569     if available X_cd-clu then do:
     2570   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2571   define variable v-str-recid20 as character no-undo .
     2572   define variable v-num-entry20 as integer   no-undo .
     2573   assign
     2574     v-str-recid20 = trim( string( recid( X_cd-clu ) , "->>>>>>>>>>>9":U ) )
     2575     v-num-entry20 = lookup( v-str-recid20 , p-rid-list )
     2576   .
     2577   if v-num-entry20 > 0 then do:
     2578     assign
     2579       entry( v-num-entry20, p-rid-list ) = "":U
     2580       p-rid-list = trim( replace( p-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2581     .
     2582   end.
     2583   else do:
     2584     assign
     2585       p-rid-list = p-rid-list + ( if p-rid-list = "":U then "":U else chr(44) ) + v-str-recid20
     2586     .
     2587   end.
     2588       loc#log = br-mcli:refresh() .
     2589       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     2590           loc#log = br-mcli:select-next-row ().
     2591           apply "VALUE-CHANGED" to br-mcli in frame Dialog-Frame.
     2592       end.
     2593       if num-entries( p-rid-list ) = 0
     2594       then
     2595           hide mark-num in frame Dialog-Frame.
     2596       else
     2597           disp num-entries( p-rid-list ) @ mark-num with frame Dialog-Frame.
     2598     end.
     2599     apply "entry" to br-mcli in frame Dialog-Frame.
     2600   END.
     2601   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     2602   DO:
     2603     if not avail X_cd-clu then return no-apply.
     2604     run proc-b-print in this-procedure  no-error.
     2605     if error-status:error then do:
     2606        return no-apply.
     2607     end.
     2608     APPLY "ENTRY" to br-mcli.
     2609   END.
     2610   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     2611   DO:
     2612     run proc-b-sch in this-procedure no-error.
     2613     if error-status:error then return no-apply.
     2614   END.
     2615   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     2616   DO:
     2617     if ( available X_cd-clu ) then do:
     2618       if ( p-rid-list = "" ) or b-mark:sensitive = no then
     2619       p-rid-list = string( recid( X_cd-clu ) ) .
     2620     end.
     2621   END.
     2622   ON CHOOSE OF B-send IN FRAME Dialog-Frame
     2623   DO:
     2624   if SendOption = "" then
     2625   run gbl/pop-up.p (self:handle, yes) no-error.
     2626   if SendOption = "" then return no-apply.
     2627   v-doc-rec = recid(X_cd-clu).
     2628   define variable v-chk-act-host-code as integer   no-undo .
     2629   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2630   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2631     (input  p-curr-obj-type
     2632     ,input  p-curr-obj-code
     2633     ,output v-chk-act-host-code
     2634     )  .
     2635   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2636   do:
     2637     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2638       (input  v-cntxt-db-num
     2639       ,input  v-cntxt-userid
     2640       ,input  0
     2641       ,input  'actn_cashdesk-clients_add-def':U
     2642       ,input  'object':U
     2643       ,input  v-chk-act-host-code
     2644       ,input  p-curr-obj-type
     2645       ,input  p-curr-obj-code
     2646       ,input  0
     2647       ,input  0
     2648       ,input  0
     2649       ,input  true
     2650       ,output glog
     2651       )  .
     2652   end.
     2653   if NOT glog THEN return no-apply.
     2654   RUN general-send no-error.
     2655   if error-status:error then do:
     2656       Sendoption = "".
     2657     return no-apply.
     2658   end.
     2659   Sendoption = "".
     2660   RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     2661   run disp-cd in this-procedure .
     2662   reposition br-mcli to recid v-doc-rec no-error.
     2663   END.
     2664   ON MOUSE-SELECT-CLICK OF cd-image IN FRAME Dialog-Frame
     2665   OR selection of cd-image DO:
     2666     run general-send in this-procedure  no-error .
     2667     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     2668     run fill-vars in this-procedure no-error .
     2669     run disp-cd in this-procedure no-error.
     2670     reposition br-mcli to recid v-doc-rec no-error.
     2671   END.
     2672   ON CTRL-J OF loc-code IN FRAME Dialog-Frame
     2673   DO:
     2674     run proc-find-code in this-procedure(a-n-c, YES, input frame Dialog-Frame loc-code) no-error.
     2675     if error-status:error then return no-apply.
     2676   END.
     2677   ON RETURN OF loc-code IN FRAME Dialog-Frame
     2678   DO:
     2679     run proc-find-code in this-procedure(a-n-c, no, input frame Dialog-Frame loc-code) no-error.
     2680     if error-status:error then return no-apply.
     2681   END.
     2682   ON CTRL-J OF loc-name IN FRAME Dialog-Frame
     2683   DO:
     2684     run proc-find-obj-type in this-procedure(a-n-c, YES, input frame Dialog-Frame loc-name) no-error.
     2685     if error-status:error then return no-apply.
     2686   END.
     2687   ON RETURN OF loc-name IN FRAME Dialog-Frame
     2688   DO:
     2689       run proc-find-obj-type in this-procedure(a-n-c, NO, input frame Dialog-Frame loc-name) no-error.
     2690     if error-status:error then return no-apply.
     2691   END.
     2692   ON CHOOSE OF MENU-ITEM m_all
     2693   DO:
     2694       assign
     2695     SendOption = "ALL":U.
     2696     APPLY "CHOOSE" to b-send  in frame Dialog-Frame.
     2697   END.
     2698   ON CHOOSE OF MENU-ITEM m_changed
     2699   DO:
     2700       assign
     2701     SendOption = "changed":U.
     2702     APPLY "CHOOSE" to b-send  in frame Dialog-Frame.
     2703   END.
     2704   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2705   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2706   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2707   on help of frame Dialog-Frame
     2708   do:
     2709     run gbl/app_help.p
     2710       (input this-procedure :file-name
     2711       ,input ''
     2712       ,input ?
     2713       ) no-error.
     2714     if error-status :error then do:
     2715       message
     2716         "Ошибка при вызове помощи"
     2717         error-status :get-message(1)
     2718         view-as alert-box .
     2719     end.
     2720   end.
     2721   run minbtn-set in this-procedure .
     2722   on choose of b-help in frame Dialog-Frame
     2723   do:
     2724     apply "help":u to frame Dialog-Frame .
     2725   end.
     2726   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2727   procedure minbtn-set :
     2728       do
     2729           on error undo, return error return-value
     2730           :
     2731           define variable ii              as integer       no-undo .
     2732           define variable fh              as widget-handle no-undo .
     2733           define variable hh              as widget-handle no-undo .
     2734           define variable v-h             as handle        extent 4 no-undo .
     2735           define variable v-name-button   as character     no-undo .
     2736           define variable v-help-old-x    as decimal       no-undo .
     2737           define variable v-help-old-y    as decimal       no-undo .
     2738           define variable v-help-old-size as decimal       no-undo .
     2739           define variable v-frame-width   as decimal       no-undo .
     2740           define variable jj              as integer       no-undo .
     2741           do
     2742               on error undo, return error
     2743               :
     2744               assign
     2745                   v-frame-width = frame Dialog-Frame:width - 0.3
     2746                   fh            = frame Dialog-Frame:first-child
     2747                   hh            = fh:first-child
     2748                   ii            = 1
     2749                   .
     2750               do while valid-handle(hh):
     2751                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2752                   do:
     2753                       case lc(hh:name) :
     2754                           when "b-help" then
     2755                               do:
     2756                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2757                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2758                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2759                                   hh:TOOLTIP = "Помощь" .
     2760                                   v-help-old-x = hh:column .
     2761                                   v-help-old-y = hh:row    .
     2762                                   v-help-old-size = hh:width .
     2763                                   hh:width-chars = 2.5 .
     2764                               end.
     2765                           when "b-print" then
     2766                               do:
     2767                                   hh:load-image("cmp/b-print.bmp":u) .
     2768                                   hh:TOOLTIP = "Печать" .
     2769                                   v-h[ii] = hh:handle .
     2770                                   ii = ii + 1 .
     2771                                   hh:width-chars = 3 .
     2772                               end.
     2773                           when "b-history" or
     2774                           when "b-hist" then
     2775                               do:
     2776                                   hh:load-image("cmp/b-hist.bmp":u) .
     2777                                   hh:TOOLTIP = "История" .
     2778                                   v-h[ii] = hh:handle .
     2779                                   ii = ii + 1 .
     2780                                   hh:width-chars = 3 .
     2781                               end.
     2782                           when "b-sch" then
     2783                               do:
     2784                                   hh:load-image("cmp/b-sch.bmp":u) .
     2785                                   hh:TOOLTIP = "Установка Фильтра" .
     2786                                   v-h[ii] = hh:handle .
     2787                                   ii = ii + 1 .
     2788                                   hh:width-chars = 3 .
     2789                               end.
     2790                           when "b-hist-user" then
     2791                               do:
     2792                                   hh:load-image("cmp/b-hist.bmp":u) .
     2793                                   hh:TOOLTIP = "История пользователя" .
     2794                                   ii = ii + 1 .
     2795                               end.
     2796                       end case.
     2797                   end.
     2798                   hh = hh:next-sibling.
     2799               end.
     2800               b-help:column = v-frame-width - b-help:width-chars.
     2801               jj = 0.
     2802               repeat ii = 4 to 1 by -1 :
     2803                   if valid-handle (v-h[ii] ) then
     2804                   do:
     2805                       jj  = jj + 1 .
     2806                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2807                       v-h[ii]:row    = v-help-old-y .
     2808                   end.
     2809               end.
     2810           end.
     2811       end.
     2812   end procedure.
     2813   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2814   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2815   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2816   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2817   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2818   define variable v-diasize-current-frame-height as decimal   no-undo .
     2819   define variable v-diasize-change-size          as logical   no-undo .
     2820   define variable v-diasize-resize-button        as handle    no-undo .
     2821   define variable v-diasize-wndmax               as logical   no-undo .
     2822   define variable v-diasize-wndstore             as logical   no-undo .
     2823   define variable v-diasize-proc-name            as character no-undo .
     2824   define variable v-diasize-browse-handle        as handle    no-undo .
     2825   define variable v-diasize-browse-number        as integer   no-undo .
     2826   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2827   define temp-table temp-diasize-handle no-undo
     2828     field handle-value  as handle
     2829     field save-position as decimal
     2830     index xpk is primary unique handle-value
     2831     .
     2832   define temp-table temp-browse-handle no-undo
     2833     field browse-type   as character
     2834     field browse-number as integer
     2835     field browse-handle as handle
     2836     field original-size as decimal
     2837     index xpk is primary unique browse-type browse-number
     2838     index xie browse-type browse-handle
     2839   .
     2840   procedure diasize_change-height :
     2841     define input  parameter p-change-value  as decimal   no-undo .
     2842     define input  parameter p-move-resize   as logical   no-undo .
     2843     define variable v-field-group-handle    as handle    no-undo .
     2844     define variable v-object-handle         as handle    no-undo .
     2845     define variable v-frame-height          as decimal   no-undo .
     2846     define variable v-frame-virtual-height  as decimal   no-undo .
     2847     define variable v-browse-height         as decimal   no-undo .
     2848     define variable v-window-height         as decimal   no-undo .
     2849     define variable v-window-virtual-height as decimal   no-undo .
     2850     define variable v-change-sign           as integer   no-undo .
     2851     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2852     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2853     if p-change-value > 0
     2854     then do:
     2855       if frame Dialog-Frame :height + p-change-value
     2856           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2857       then do:
     2858         assign
     2859           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2860                           - (frame Dialog-Frame :height-chars)
     2861         .
     2862         if p-change-value <= 0
     2863         then do:
     2864           run diasize_position-resize-button in this-procedure .
     2865           return .
     2866         end.
     2867       end.
     2868     end.
     2869     if p-change-value < 0
     2870     then do:
     2871       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2872       then do:
     2873         assign
     2874           p-change-value = v-diasize-orig-frame-height
     2875                          - (frame Dialog-Frame :height-chars)
     2876         .
     2877         if p-change-value >= 0
     2878         then do:
     2879           run diasize_position-resize-button in this-procedure .
     2880           return .
     2881         end.
     2882       end.
     2883     end.
     2884     if p-change-value >= 0
     2885     then do:
     2886       assign
     2887         v-change-sign = 1
     2888       .
     2889     end.
     2890     else do:
     2891       assign
     2892         v-change-sign = -1
     2893       .
     2894     end.
     2895     assign
     2896       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2897     .
     2898     if p-change-value = 0
     2899     then do:
     2900       run diasize_position-resize-button in this-procedure .
     2901       return .
     2902     end.
     2903     move_block:
     2904     do
     2905     on error undo move_block, retry move_block
     2906     :
     2907       if retry
     2908       then do:
     2909         do
     2910         on error undo move_block, leave move_block
     2911         :
     2912           if p-change-value > 0
     2913           then do:
     2914             for each buf_temp-diasize-handle
     2915             on error undo, next
     2916             :
     2917               assign
     2918                 v-object-handle = buf_temp-diasize-handle.handle-value
     2919               .
     2920               if v-object-handle <> v-diasize-resize-button
     2921               then do:
     2922                 assign
     2923                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2924                 .
     2925               end.
     2926             end.
     2927             assign
     2928               v-diasize-browse-handle :height = v-browse-height
     2929             .
     2930             for each buf_temp-browse-handle
     2931               where buf_temp-browse-handle.browse-type = 'height':u
     2932             on error undo, next
     2933             :
     2934               assign
     2935                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2936               .
     2937             end.
     2938             assign
     2939               frame Dialog-Frame :height = v-frame-height
     2940             .
     2941             if frame Dialog-Frame :scrollable = true
     2942             then do:
     2943               assign
     2944                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2945               .
     2946             end.
