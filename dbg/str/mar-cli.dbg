     3557         no-error .
     3558         if error-status :error
     3559         or error-status :get-message(1) <> ""
     3560         then do:
     3561           undo move_block, retry move_block.
     3562         end.
     3563         if frame Dialog-Frame :scrollable = true
     3564         then do:
     3565           assign
     3566             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3567           no-error .
     3568           if error-status :error
     3569           or error-status :get-message(1) <> ""
     3570           then do:
     3571             undo move_block, retry move_block.
     3572           end.
     3573         end.
     3574       end.
     3575       if p-move-resize
     3576       then do:
     3577         run diasize_position-resize-button in this-procedure .
     3578       end.
     3579       if v-diasize-wndstore = true
     3580       then do:
     3581         if connected("ub") = true
     3582         then do:
     3583           define variable v-cntxt-db-num        as integer   no-undo .
     3584           define variable v-cntxt-userid        as character no-undo .
     3585           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3586                                             , OUTPUT v-cntxt-userid
     3587                                             ) .
     3588           run gbl/wndsizew.p
     3589             (input  v-cntxt-db-num
     3590             ,input  v-cntxt-userid
     3591             ,input  v-diasize-proc-name
     3592             ,input  'width':u
     3593             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3594             ) .
     3595         end.
     3596       end.
     3597     end.
     3598     assign
     3599       v-diasize-change-size = false
     3600     .
     3601   end procedure.
     3602   procedure diasize_set-width :
     3603     define input  parameter p-new-width  as decimal   no-undo .
     3604     define input  parameter p-move-resize as logical   no-undo .
     3605     do
     3606     on error undo, return error return-value
     3607     :
     3608       run diasize_change-width in this-procedure
     3609         (input  (p-new-width - frame Dialog-Frame :width)
     3610         ,input  p-move-resize
     3611         ) .
     3612     end.
     3613   end procedure.
     3614   procedure diasize_position-resize-button :
     3615     do with frame Dialog-Frame
     3616     :
     3617       hide v-diasize-resize-button .
     3618       assign
     3619         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3620                     - 1
     3621                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3622         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3623                     - 1
     3624                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3625       .
     3626       view v-diasize-resize-button .
     3627     end.
     3628   end procedure.
     3629   on alt-right anywhere
     3630   do:
     3631     run diasize_change-width in this-procedure
     3632       (input 1
     3633       ,input true
     3634       ) .
     3635     return no-apply .
     3636   end.
     3637   on alt-left anywhere
     3638   do:
     3639     run diasize_change-width in this-procedure
     3640       (input -1
     3641       ,input true
     3642       ) .
     3643     return no-apply .
     3644   end.
     3645   on alt-down anywhere
     3646   do:
     3647     run diasize_change-height in this-procedure
     3648       (input 1
     3649       ,input true
     3650       ) .
     3651     return no-apply .
     3652   end.
     3653   on alt-up anywhere
     3654   do:
     3655     run diasize_change-height in this-procedure
     3656       (input -1
     3657       ,input true
     3658       ) .
     3659     return no-apply .
     3660   end.
     3661   on alt-enter of frame Dialog-Frame
     3662   do:
     3663     run diasize_maximize in this-procedure
     3664       (input  ?
     3665       ).
     3666     return no-apply .
     3667   end.
     3668   procedure diasize_end-move :
     3669     do
     3670     on error undo, return error return-value
     3671     :
     3672       define variable v-row-delta as decimal   no-undo .
     3673       define variable v-col-delta as decimal   no-undo .
     3674       define variable v-new-row as decimal   no-undo .
     3675       define variable v-new-col as decimal   no-undo .
     3676       assign
     3677         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3678         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3679       .
     3680       assign
     3681         v-row-delta = v-new-row - frame Dialog-Frame :height
     3682         v-col-delta = v-new-col - frame Dialog-Frame :width
     3683       .
     3684       run diasize_change-height in this-procedure
     3685         (input v-row-delta
     3686         ,input true
     3687         ) .
     3688       run diasize_change-width in this-procedure
     3689         (input v-col-delta
     3690         ,input true
     3691         ) .
     3692     end.
     3693   end procedure.
     3694   procedure diasize_maximize :
     3695     define input  parameter p-action as logical   no-undo .
     3696     do
     3697     on error undo, return error return-value
     3698     :
     3699       if p-action = ?
     3700       then do:
     3701         if v-diasize-need-maximize = true
     3702         then do:
     3703           assign
     3704             p-action = true
     3705           .
     3706         end.
     3707         else do:
     3708           assign
     3709             p-action = false
     3710           .
     3711         end.
     3712       end.
     3713       if p-action = true
     3714       then do:
     3715         run diasize_change-height in this-procedure
     3716           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3717               - frame Dialog-Frame :height-chars
     3718           ,input true
     3719           ) .
     3720         run diasize_change-width in this-procedure
     3721           (input session :width-chars
     3722               - frame Dialog-Frame :width-chars
     3723           ,input true
     3724           ) .
     3725         assign
     3726           v-diasize-need-maximize = false
     3727         .
     3728       end.
     3729       else do:
     3730         run diasize_change-width in this-procedure
     3731           (input v-diasize-orig-frame-width
     3732               - frame Dialog-Frame :width-chars
     3733           ,input true
     3734           ) .
     3735         run diasize_change-height in this-procedure
     3736           (input v-diasize-orig-frame-height
     3737               - frame Dialog-Frame :height-chars
     3738           ,input true
     3739           ) .
     3740         assign
     3741           v-diasize-need-maximize = true
     3742         .
     3743       end.
     3744     end.
     3745   end procedure.
     3746   procedure diasize_restore-orig-size :
     3747     do
     3748     on error undo, return error return-value
     3749     :
     3750       assign
     3751         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3752         v-diasize-current-frame-height = frame Dialog-Frame :height
     3753       .
     3754       run diasize_set-height in this-procedure
     3755         (input  v-diasize-orig-frame-height
     3756         ,input  true
     3757         ) .
     3758       run diasize_set-width in this-procedure
     3759         (input  v-diasize-orig-frame-width
     3760         ,input  true
     3761         ) .
     3762     end.
     3763   end procedure.
     3764   procedure diasize_restore-current-size :
     3765     do
     3766     on error undo, return error return-value
     3767     :
     3768       run diasize_set-height in this-procedure
     3769         (input  v-diasize-current-frame-height
     3770         ,input  true
     3771         ) .
     3772       run diasize_set-width in this-procedure
     3773         (input  v-diasize-current-frame-width
     3774         ,input  true
     3775         ) .
     3776     end.
     3777   end procedure.
     3778   procedure diasize_set-browse-handle :
     3779     define input  parameter p-browse-handle as handle   no-undo .
     3780     define buffer buf_temp-browse-handle for temp-browse-handle .
     3781     do
     3782     on error undo, return error return-value
     3783     :
     3784       assign
     3785         v-diasize-browse-handle = p-browse-handle
     3786       .
     3787       for each buf_temp-browse-handle
     3788       on error undo, return error return-value
     3789       :
     3790         delete buf_temp-browse-handle .
     3791       end.
     3792     end.
     3793   end procedure.
     3794   procedure diasize_add_browse :
     3795     define input  parameter p-browse-type   as character no-undo .
     3796     define input  parameter p-browse-handle as handle    no-undo .
     3797     define buffer buf_temp-browse-handle for temp-browse-handle .
     3798     do
     3799     on error undo, return error return-value
     3800     :
     3801       assign
     3802         v-diasize-browse-number = v-diasize-browse-number + 1
     3803       .
     3804       create buf_temp-browse-handle .
     3805       assign
     3806         buf_temp-browse-handle.browse-type   = p-browse-type
     3807         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3808         buf_temp-browse-handle.browse-handle = p-browse-handle
     3809       .
     3810     end.
     3811   end procedure.
     3812   procedure diasize_init :
     3813     define variable v-default-value    as logical   no-undo .
     3814     define variable v-restore-saved    as logical   no-undo .
     3815     define variable v-resize-value-str as character no-undo .
     3816     do
     3817     on error undo, return error return-value
     3818     :
     3819       do with frame Dialog-Frame
     3820       :
     3821         assign
     3822           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3823           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3824           v-diasize-browse-handle     = browse br-mcli :handle
     3825         .
     3826         create button v-diasize-resize-button
     3827         assign
     3828           parent        = frame Dialog-Frame :first-child
     3829           label         = "s"
     3830           height-pixels = 16
     3831           width-pixels  = 16
     3832           visible       = true
     3833           sensitive     = true
     3834           movable       = true
     3835           triggers:
     3836             on end-move persistent run diasize_end-move in this-procedure .
     3837           end triggers.
     3838         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3839         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3840         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3841         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3842         assign
     3843           v-diasize-wndmax = false
     3844         .
     3845         if connected("ub") = true
     3846         then do:
     3847           define variable v-cntxt-db-num        as integer   no-undo .
     3848           define variable v-cntxt-userid        as character no-undo .
     3849           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3850                                             , OUTPUT v-cntxt-userid
     3851                                             ) .
     3852           run gbl/wndpar_r.p
     3853             (input  v-cntxt-db-num
     3854             ,input  v-cntxt-userid
     3855             ,input  'wndmax':U
     3856             ,output v-diasize-wndmax
     3857             ,output v-default-value
     3858             ) .
     3859         end.
     3860         assign
     3861           v-diasize-wndstore = false
     3862         .
     3863         if connected("ub") = true
     3864         then do:
     3865           run gbl/wndpar_r.p
     3866             (input  v-cntxt-db-num
     3867             ,input  v-cntxt-userid
     3868             ,input  'wndstore':U
     3869             ,output v-diasize-wndstore
     3870             ,output v-default-value
     3871             ) .
     3872         end.
     3873         assign
     3874           v-diasize-proc-name = entry(1, program-name(2), '.')
     3875         .
     3876         if v-diasize-wndstore = true
     3877         then do:
     3878           assign
     3879             v-restore-saved = false
     3880           .
     3881           if connected("ub") = true
     3882           then do:
     3883             run gbl/wndsizer.p
     3884               (input  v-cntxt-db-num
     3885               ,input  v-cntxt-userid
     3886               ,input  v-diasize-proc-name
     3887               ,input  'height':u
     3888               ,output v-resize-value-str
     3889               ) .
     3890             if v-resize-value-str <> '':U
     3891             then do:
     3892               run diasize_change-height in this-procedure
     3893                 (input  integer(v-resize-value-str)
     3894                 ,input  true
     3895                 ) .
     3896               assign
     3897                 v-restore-saved = true
     3898               .
     3899             end.
     3900           end.
     3901           if connected("ub") = true
     3902           then do:
     3903             run gbl/wndsizer.p
     3904               (input  v-cntxt-db-num
     3905               ,input  v-cntxt-userid
     3906               ,input  v-diasize-proc-name
     3907               ,input  'width':u
     3908               ,output v-resize-value-str
     3909               ) .
     3910             if v-resize-value-str <> '':U
     3911             then do:
     3912               run diasize_change-width in this-procedure
     3913                 (input  integer(v-resize-value-str)
     3914                 ,input  true
     3915                 ) .
     3916               assign
     3917                 v-restore-saved = true
     3918               .
     3919             end.
     3920           end.
     3921           if v-restore-saved <> true
     3922           then do:
     3923             if v-diasize-wndmax = true
     3924             then do:
     3925               run diasize_maximize in this-procedure
     3926                 (input  true
     3927                 ) .
     3928             end.
     3929           end.
     3930         end.
     3931         else do:
     3932           if v-diasize-wndmax = true
     3933           then do:
     3934             run diasize_maximize in this-procedure
     3935               (input  true
     3936               ) .
     3937           end.
     3938         end.
     3939       end.
     3940     end.
     3941   end procedure.
     3942   procedure diasize_need-full-display :
     3943     define output parameter p-need-full-display as logical   no-undo .
     3944     do
     3945     on error undo, return error return-value
     3946     :
     3947       assign
     3948         p-need-full-display = v-diasize-need-full-display
     3949       .
     3950       assign
     3951         v-diasize-need-full-display = false
     3952       .
     3953     end.
     3954   end procedure.
     3955   procedure get-context :
     3956      define output parameter p-db-num as integer          no-undo.
     3957      define output parameter p-user-id as character        no-undo.
     3958      define variable v-login               as character    no-undo.
     3959      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3960      define buffer buf_user-login  for ub.user-login .
     3961      do
     3962      on error undo, return error
     3963      :
     3964            FIND FIRST buf_sys-ctrl no-lock.
     3965            ASSIGN
     3966               v-login = USERID("ub")
     3967               p-db-num = buf_sys-ctrl.db-num
     3968            .
     3969            FIND FIRST buf_user-login
     3970                 WHERE buf_user-login.db-num = p-db-num
     3971                   AND buf_user-login.user-login = v-login
     3972                 no-lock
     3973                 no-error
     3974                 .
     3975            IF AVAILABLE buf_user-login
     3976            THEN DO:
     3977               assign
     3978                  p-user-id = buf_user-login.user-id
     3979               .
     3980            END.
     3981      end.
     3982   end procedure.
     3983       run diasize_init in this-procedure .
     3984   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3985   procedure set-filter-name :
     3986   define input parameter p-filter-name as character no-undo .
     3987     do with frame Dialog-Frame:
     3988       if p-filter-name > "" then do:
     3989         assign
     3990           frame Dialog-Frame:title
     3991             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     3992         .
     3993         assign
     3994           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3995         .
     3996       end.
     3997       else do:
     3998         assign
     3999           b-sch :tooltip = ""
     4000         .
     4001       end.
     4002     end.
     4003   end procedure.
     4004   def var sort-labelbr-mcli   as character no-undo .
     4005   def var sort-clmnbr-mcli    as handle    no-undo .
     4006   def var cur-clmnbr-mcli     as handle    no-undo .
     4007   def var cur-clmn-locbr-mcli as integer   no-undo .
     4008   def var re-querybr-mcli     as logical   initial no no-undo .
     4009   on start-search, ctrl-o of br-mcli in frame Dialog-Frame do:
     4010      run sort-brbr-mcli
     4011        (input (if available X_cd-clu
     4012                then recid(X_cd-clu)
     4013                else ?
     4014               )
     4015        ).
     4016   end.
     4017   PROCEDURE sort-brbr-mcli :
     4018     define input parameter p-recid as recid no-undo .
     4019     if re-querybr-mcli = no then do:
     4020       assign
     4021          cur-clmnbr-mcli = br-mcli:current-column in frame Dialog-Frame
     4022       .
     4023       if sort-clmnbr-mcli <> ? then sort-clmnbr-mcli:column-fgcolor = 0.
     4024       if cur-clmnbr-mcli = sort-clmnbr-mcli then do:
     4025         assign
     4026            sort-labelbr-mcli = ""
     4027            sort-clmnbr-mcli = ?
     4028         .
     4029        end.
     4030        else do:
     4031          assign
     4032            sort-labelbr-mcli = cur-clmnbr-mcli:label
     4033            sort-clmnbr-mcli  = cur-clmnbr-mcli
     4034            sort-clmnbr-mcli:column-fgcolor = 4
     4035          .
     4036        end.
     4037      end.
     4038     assign
     4039       cur-clmn-locbr-mcli = 1
     4040     .
     4041     def var column-handle as handle no-undo .
     4042     column-handle = br-mcli:first-column.
     4043     do while valid-handle(column-handle) :
     4044       if column-handle = cur-clmnbr-mcli then do:
     4045         leave .
     4046       end.
     4047       column-handle = column-handle:NEXT-COLUMN.
     4048       assign
     4049         cur-clmn-locbr-mcli = cur-clmn-locbr-mcli + 1
     4050       .
     4051     end.
     4052     case sort-labelbr-mcli:
     4053           when X_cd-clu.clu-code:label in browse br-mcli then DO:    assign       sort-column-name = "X_cd-clu.clu-code"     .     run OpenBr in this-procedure  ( input yes, input no, input '':U).   . END.
     4054           when ' '  then DO:    assign       sort-column-name = "X_cd-clu.cli-type + string(X_cd-clu.cli-CODE)"     .     run OpenBr in this-procedure  ( input yes, input no, input '':U).   . END.
     4055           when X_clients.obj-name:label in browse br-mcli then DO:    assign       sort-column-name = "X_clients.obj-name"     .     run OpenBr in this-procedure  ( input yes, input no, input '':U).   . END.
     4056       otherwise do:
     4057         assign
     4058           sort-column-name = ""
     4059         .
     4060         run OpenBr in this-procedure ( input yes, input no, input '':U).
     4061           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-mcli') then do:
     4062             run mv-brw-defaultbr-mcli.
     4063           end.
     4064         if sort-labelbr-mcli <> "" then do:
     4065           assign
     4066             cur-clmnbr-mcli:column-fgcolor = 0
     4067           .
     4068         end.
     4069         assign
     4070           cur-clmn-locbr-mcli = ?
     4071         .
     4072       end.
     4073     end case.
     4074       if cur-clmn-locbr-mcli <> ? then do:
     4075         if can-do( this-procedure:internal-entries, 'ch-clmnbr-mcli') then do:
     4076           run ch-clmnbr-mcli in this-procedure (cur-clmn-locbr-mcli).
     4077         end.
     4078       end.
     4079     if p-recid <> ? then do:
     4080       reposition br-mcli to recid p-recid no-error.
     4081       apply "value-changed" to br-mcli in frame Dialog-Frame.
     4082     end.
     4083     apply "entry" to br-mcli in frame Dialog-Frame.
     4084   END PROCEDURE.
     4085   procedure re-open-query-srt-clmnbr-mcli:
     4086   if cur-clmnbr-mcli = ? then do:
     4087      run OpenBr in this-procedure ( input yes, input no, input '':U).
     4088   end.
     4089   else do:
     4090      assign re-querybr-mcli = yes.
     4091      run sort-brbr-mcli
     4092        (input (if available X_cd-clu
     4093                then recid(X_cd-clu)
     4094                else ?
     4095               )
     4096        ).
     4097      assign re-querybr-mcli = no.
     4098   end.
     4099   end.
