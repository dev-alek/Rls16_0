     4129   define variable vss-include-info33 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4130   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     4131     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     4132     return no-apply.
     4133   end.
     4134   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4135   DEF VAR cur-clmn-numbr-mcli as INT EXTENT 9 no-undo.
     4136   DEF VAR varmvibr-mcli       as INT no-undo.
     4137   DEF VAR varmvjbr-mcli       as INT no-undo.
     4138   DEF VAR varmvkbr-mcli       as INT no-undo.
     4139   DEF VAR varmvlbr-mcli       as INT no-undo.
     4140   DEF VAR move-elementbr-mcli as INT no-undo.
     4141   def var jjbr-mcli           as int no-undo.
     4142   do varmvibr-mcli = 1 to EXTENT(cur-clmn-numbr-mcli):
     4143     ASSIGN cur-clmn-numbr-mcli[varmvibr-mcli] = varmvibr-mcli.
     4144   END.
     4145   RUN start-mv-clmnbr-mcli.
     4146   PROCEDURE start-mv-clmnbr-mcli:
     4147   def var old-session as logical no-undo.
     4148      old-session = SESSION:IMMEDIATE-DISPLAY.
     4149      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4150          IF  true  THEN DO:
     4151      DO jjbr-mcli = NUM-ENTRIES('1,2,3,4,5,6,7,8,9') TO 1 BY -1:
     4152        RUN re-move-clmnbr-mcli ( cur-clmn-numbr-mcli[INTEGER(ENTRY (jjbr-mcli, '1,2,3,4,5,6,7,8,9'))] , 2).
     4153      END.
     4154          END.
     4155      SESSION:IMMEDIATE-DISPLAY = old-session.
     4156   END.
     4157   ON ctrl-cursor-right OF BROWSE br-mcli do:
     4158     RUN re-move-clmnbr-mcli ( 2, 9).
     4159   END.
     4160   ON ctrl-cursor-left OF BROWSE br-mcli do:
     4161     RUN re-move-clmnbr-mcli (9, 2).
     4162   END.
     4163   PROCEDURE re-move-clmnbr-mcli:
     4164     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     4165     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     4166     DO varmvibr-mcli = 1 TO EXTENT(cur-clmn-numbr-mcli):
     4167       if cur-clmn-numbr-mcli[varmvibr-mcli] = source-column THEN cur-clmn-numbr-mcli[varmvibr-mcli] = -1.
     4168     END.
     4169     if br-mcli:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     4170     if source-column > target-column THEN
     4171     DO varmvjbr-mcli = source-column - 1 to target-column BY -1:
     4172       DO varmvibr-mcli = 1 TO EXTENT(cur-clmn-numbr-mcli):
     4173           if cur-clmn-numbr-mcli[varmvibr-mcli] = varmvjbr-mcli THEN DO:
     4174             cur-clmn-numbr-mcli[varmvibr-mcli] = cur-clmn-numbr-mcli[varmvibr-mcli] + 1.
     4175           END.
     4176       END.
     4177     END.
     4178     ELSE
     4179     DO varmvjbr-mcli = source-column + 1 to target-column:
     4180       DO varmvibr-mcli = 1 TO EXTENT(cur-clmn-numbr-mcli):
     4181         if cur-clmn-numbr-mcli[varmvibr-mcli] = varmvjbr-mcli THEN DO:
     4182           cur-clmn-numbr-mcli[varmvibr-mcli] = cur-clmn-numbr-mcli[varmvibr-mcli] - 1.
     4183         END.
     4184       END.
     4185     END.
     4186     DO varmvibr-mcli = 1 TO EXTENT(cur-clmn-numbr-mcli):
     4187       if cur-clmn-numbr-mcli[varmvibr-mcli] = -1 THEN cur-clmn-numbr-mcli[varmvibr-mcli] = target-column.
     4188     END.
     4189   END PROCEDURE.
     4190   PROCEDURE ch-clmnbr-mcli:
     4191     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     4192     if cur-clmn-loc <= 2 then do:
     4193       return .
     4194     end.
     4195     DO varmvibr-mcli = 1 TO EXTENT(cur-clmn-numbr-mcli):
     4196       if cur-clmn-numbr-mcli[varmvibr-mcli] = cur-clmn-loc THEN move-elementbr-mcli = varmvibr-mcli.
     4197     END.
     4198     RUN re-move-clmnbr-mcli (cur-clmn-loc, 2).
     4199   END PROCEDURE.
     4200   PROCEDURE mv-brw-defaultbr-mcli:
     4201   def var old-session as logical no-undo.
     4202     old-session = SESSION:IMMEDIATE-DISPLAY.
     4203     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4204     do varmvlbr-mcli = 2 to EXTENT(cur-clmn-numbr-mcli):
     4205       RUN re-move-clmnbr-mcli (cur-clmn-numbr-mcli[varmvlbr-mcli], varmvlbr-mcli).
     4206     END.
     4207     RUN start-mv-clmnbr-mcli.
     4208     SESSION:IMMEDIATE-DISPLAY = old-session.
     4209   END PROCEDURE.
     4210   .
     4211   MAIN-BLOCK:
     4212   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4213      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4214   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4215     run mainmenu_getcntxt in parparentproc
     4216       (output v-cntxt-db-num
     4217       ,output v-cntxt-userid
     4218       ,output v-cntxt-level
     4219       ,output v-cntxt-host-code-obj
     4220       ,output v-cntxt-obj-type
     4221       ,output v-cntxt-obj-code
     4222       ,output v-cntxt-db-num-obj
     4223       ,output v-cntxt-is-admin
     4224       ) .
     4225       if p-mode <> 'все':U
     4226       AND p-mode <> 'объект':U then dO:
     4227       message
     4228       vss-workfile vss-revision vss-description skip
     4229       "Неверное значение параметров вызова p-mode"
     4230       p-mode
     4231       view-as alert-box ERROR.
     4232       return.
     4233    end.
     4234    find first X_cli-obj no-lock where
     4235                   X_cli-obj.obj-type = p-curr-obj-type
     4236               and X_cli-obj.obj-code = p-curr-obj-code no-error.
     4237     if not available X_cli-obj then do:
     4238         message
     4239         vss-workfile vss-revision vss-description skip
     4240         "Неверное значение параметра вызова p-curr-obj-type и/или p-curr-obj-code"
     4241           view-as alert-box ERROR.
     4242         return.
     4243     end.
     4244     if p-rid-list <> "" then do:
     4245         FIND FIRST find_cd-clu No-LOCK where
     4246                    recid(find_cd-clu) = integer(entry(1, p-rid-list)) No-ERROR.
     4247         if not avail find_cd-clu then do:
     4248           message
     4249           vss-workfile vss-revision vss-description skip
     4250           "Неверное значение параметра вызова p-rid-list" p-rid-list
     4251           view-as alert-box error .
     4252           return error.
     4253         end.
     4254         v-doc-rec = integer(entry(1, p-rid-list)).
     4255       end.
     4256   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4257   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     4258     (output v-db-num
     4259     )  .
     4260   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4261   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     4262     (input  p-curr-obj-type
     4263     ,input  p-curr-obj-code
     4264     ,output v-obj-db-num
     4265     )  .
     4266     if v-obj-db-num <> v-db-num then do:
     4267       message
     4268       "Нельзя работать с клиентами кассы объекта удаленной БД"
     4269       view-as alert-box error .
     4270       undo, return error .
     4271     end.
     4272     do transaction
     4273     on error undo main-block, return error
     4274     :
     4275       FIND FIRST LOCKED_cash-desk EXCLUSIVE-LOCK WHERE
     4276                 LOCKED_cash-desk.obj-code = p-curr-obj-code
     4277             AND LOCKED_cash-desk.db-num = v-db-num
     4278             AND LOCKED_cash-desk.pos-type = p-pos-type
     4279             AND (p-pos-type = 'MARIA':U or LOCKED_cash-desk.cash-num = 0) NO-WAIT NO-ERROR.
     4280       IF NOT AVAILABLE locked_cash-desk AND NOT LOCKED locked_cash-desk THEN DO:
     4281           MESSAGE
     4282           SUBSTITUTE("На &1&2 не определена касса типа &3 с номером 0 - кассовый менеджер&4" +
     4283                     "Нельзя работать с клиентами на кассе"
     4284                     , p-curr-obj-type
     4285                     , p-curr-obj-code
     4286                     , p-pos-type
     4287                     , chr(10)
     4288                     )
     4289         VIEW-AS ALERT-BOX ERROR.
     4290         UNDO main-block, RETURN ERROR.
     4291       END.
     4292       IF LOCKED locked_cash-desk THEN DO:
     4293           MESSAGE
     4294           SUBSTITUTE("На &1&2 в настоящее время занята запись кассы типа &3&4" +
     4295                     "с номером 0 - кассовый менеджер" +
     4296                     "Нельзя работать с клиентами на кассе"
     4297                     , p-curr-obj-type
     4298                     , p-curr-obj-code
     4299                     , p-pos-type
     4300                     , chr(10))
     4301         VIEW-AS ALERT-BOX ERROR.
     4302         UNDO main-block, RETURN ERROR.
     4303       END.
     4304       case p-pos-type:
     4305         when 'MARIA':U then do:
     4306            assign
     4307            v-cd-list-delete = locked_cash-desk.addr-path
     4308            v-cd-list-update = locked_cash-desk.addr-path
     4309            .
     4310         end.
     4311       END CASE.
     4312     end.
     4313     RUN fill-vars IN THIS-PROCEDURE NO-ERROR.
     4314     IF ERROR-STATUS:ERROR  THEN UNDO main-block, RETURN ERROR.
     4315     RUN MyEnable.
     4316     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     4317     HIDE mark-num in frame Dialog-Frame .
     4318     if p-rid-list <> "":U then
     4319     REPOSITION br-mcli to recid integer(entry(1, p-rid-list)) No-ERROR.
     4320     WAIT-FOR GO OF FRAME Dialog-Frame.
     4321   END.
     4322   RUN disable_UI.
     4323   PROCEDURE disable_UI :
     4324     HIDE FRAME Dialog-Frame.
     4325   END PROCEDURE.
     4326   PROCEDURE disp-cd :
     4327   DEFINE VARIABLE v-mes AS CHARACTER NO-UNDO.
     4328   define buffer buf_cd-clu for ub.cd-clu .
     4329     l-exist-cd = cd-attr_get-attr-log(buffer locked_cash-desk
     4330                                       ,input 'MARIA_operative':U
     4331                                       ,input 'to-send':U
     4332                                       ,output v-mes).
     4333   if l-exist-cd = ? then do:
     4334     message v-mes
     4335     view-as alert-box error .
     4336     undo, return error.
     4337   end.
     4338   do with frame Dialog-Frame:   if l-exist-cd then           assign       glog = cd-image:load-image ("cmp/l-cd.bmp")       cd-image :selectable = yes       cd-image :sensitive = yes       cd-image :tooltip = cd-image :private-data       .    else do:     assign     glog = cd-image:load-image (?)       cd-image :selectable = no       cd-image :sensitive = no       cd-image :tooltip = '':U     .   end. end.
     4339   END PROCEDURE.
     4340   PROCEDURE enable_UI :
     4341     DISPLAY a-n-c loc-name loc-code mark-num f-max-cli f-tot-cli f-max-CLU
     4342         WITH FRAME Dialog-Frame.
     4343     ENABLE b-quit B-mark b-sel B-lkp B-chg B-send B-print B-sch B-Help cd-image
     4344            a-n-c loc-name loc-code br-mcli mark-num f-max-cli f-tot-cli f-max-CLU
     4345         WITH FRAME Dialog-Frame.
     4346     VIEW FRAME Dialog-Frame.
     4347     OPEN QUERY br-mcli FOR EACH X_cd-clu NO-LOCK,              FIRST X_clients NO-LOCK WHERE X_clients.obj-type = X_cd-clu.cli-type     AND X_clients.obj-code = X_cd-clu.cli-code INDEXED-REPOSITION.
     4348   END PROCEDURE.
     4349   PROCEDURE fill-vars :
     4350   define variable v-mes as character no-undo .
     4351   do
     4352   on error undo, return error
     4353   :
     4354   v-tot-cli = cd-attr_get-attr-int(buffer locked_cash-desk
     4355                                   ,input 'MARIA_operative':U
     4356                                   ,input 'tot-cli':U
     4357                                   ,output v-mes).
     4358   if v-tot-cli = ? then do:
     4359     message v-mes
     4360     view-as alert-box error .
     4361     undo, return error.
     4362   end.
     4363   v-max-cli = cd-attr_get-attr-int(buffer locked_cash-desk
     4364                                   ,input 'MARIA_general':U
     4365                                   ,input 'max-cli':U
     4366                                   ,output v-mes).
     4367   if v-max-cli = ? then do:
     4368     message v-mes
     4369     view-as alert-box error .
     4370     undo, return error.
     4371   end.
     4372   v-max-CLU = cd-attr_get-attr-int(buffer locked_cash-desk
     4373                                   ,input 'MARIA_operative':U
     4374                                   ,input 'max-clu':U
     4375                                   ,output v-mes).
     4376   if v-max-CLU = ? then do:
     4377     message v-mes
     4378     view-as alert-box error .
     4379     undo, return error.
     4380   end.
     4381   l-exist-cd = cd-attr_get-attr-log(buffer locked_cash-desk
     4382                                    ,input 'MARIA_operative':U
     4383                                    ,input 'max-clu':U
     4384                                    ,output v-mes).
     4385   if l-exist-cd  = ? then do:
     4386     message v-mes
     4387     view-as alert-box error .
     4388     undo, return error.
     4389   end.
     4390   end.
     4391   DISPLAY
     4392   v-tot-cli @ f-tot-cli
     4393   v-max-cli @ f-max-cli
     4394   v-max-CLU @ f-max-CLU
     4395   WITH FRAME Dialog-Frame.
     4396   END PROCEDURE.
     4397   PROCEDURE general-send :
     4398   DEFINE VARIABLE err1 as logical init yes.
     4399   DEFINE VARIABLE jj as integer no-undo.
     4400   define variable v-step as integer no-undo .
     4401   define variable glog as logical no-undo .
     4402   define variable v-d-card like ub.dis-card.d-card no-undo .
     4403   define buffer buf_cd-clu  for ub.cd-clu.
     4404   define buffer buf_clients for ub.clients.
     4405   message
     4406   "Вы уверены что Вы приняли ВСЕ ЧЕКИ С КАССЫ?" skip
     4407   "В противном случае при изменении списка клиентов на кассе," skip
     4408   "может возникнуть ПЕРЕСОРТИЦА и/или появиться чеки с НЕОПОЗНАННЫМ КЛИЕНТОМ"
     4409   view-as alert-box QUESTION buttons YES-NO update glog.
     4410   if not glog then return error .
     4411     FOR EACH dc-list :
     4412       delete dc-list .
     4413     END .
     4414   do
     4415   on error undo, return error
     4416   :
     4417   _zz:
     4418   DO ON STOP UNDO, return error
     4419         ON END-KEY UNDO, return error
     4420         ON ERROR UNDO, LEAVE:
     4421     run waitfram-show in this-procedure ( 'Подождите ...' ) .
     4422     jj = 0.
     4423     _jj:
     4424     FOR EACH buf_cd-clu WHERE
     4425            buf_cd-clu.obj-type = p-curr-obj-type
     4426        and buf_cd-clu.obj-code = p-curr-obj-code
     4427        and buf_cd-clu.pos-type = 'MARIA':U
     4428        and buf_cd-clu.clu-type = '':U ,
     4429         first buf_clients no-lock where
     4430             buf_clients.obj-type = buf_cd-clu.cli-type
     4431         and buf_clients.obj-code = buf_cd-clu.cli-code :
     4432       IF sendoption <> "ALL"
     4433       AND buf_cd-clu.to-DEL = no
     4434       AND  buf_cd-clu.to-send = no THEN NEXT _jj.
     4435       v-d-card = ('K':U + string(if buf_cd-clu.cli-type = 'орг':U then 1 else 0) + string(buf_cd-clu.cli-code, '999999999')).
     4436       v-d-card = 'C' + string((if buf_cd-clu.cli-type = 'чел':U then 0 else 1000000000) + buf_cd-clu.cli-code).
     4437       find first cash-cli no-lock where
     4438                 cash-cli.d-card = v-d-card no-error .
     4439       if not available cash-cli then do:
     4440         create cash-cli.
     4441         assign
     4442         cash-cli.d-card = v-d-card
     4443         cash-cli.emitent-host-code = 0
     4444         cash-cli.cli-type = buf_cd-clu.cli-type
     4445         cash-cli.cli-code = buf_cd-clu.cli-code
     4446         cash-cli.obj-name = buf_clients.obj-name
     4447         cash-cli.crf = buf_cd-clu.clu-code
     4448         .
     4449       end.
     4450       jj = jj + 1.
     4451       if ( jj modulo 10 = 0 ) then
     4452       run waitfram-show in this-procedure (substitute("Обработано &1 кодов", jj)).
     4453     END.
     4454   END.
     4455     run str/diallog.w (   parparentproc
     4456                 , this-procedure
     4457                 , 'str/send-cli.p':U
     4458                 , (string( p-curr-obj-code) + chr(4) +
     4459                    "U":U + chr(4) +
     4460                    "no":U + chr(4) +
     4461                    "no":U + chr(4) +
     4462                    "del-mrkt-cli":U
     4463                    )
     4464                 , no
     4465                 , '':U
     4466                 , 'Отправка клиентов на кассу') no-error .
     4467     run cd-mrkt_update-marketer-cli in this-procedure (
     4468                                                     input locked_cash-desk.db-num
     4469                                                     ,input locked_cash-desk.obj-code
     4470                                                     ,input locked_cash-desk.pos-type
     4471                                                     ,input locked_cash-desk.cash-num
     4472                                                   )  .
     4473   end.
     4474   run fill-vars in this-procedure .
     4475   END PROCEDURE.
     4476   PROCEDURE MyEnable :
     4477   ASSIGN b-send:MENU-MOUSE in frame Dialog-Frame  = 1.
     4478   ASSIGN
     4479   cd-image:private-data in frame Dialog-Frame = cd-image:TOOLTIP
     4480   cd-image:fgcolor in frame Dialog-Frame = GRAY_COLOR
     4481   cd-image:bgcolor in frame Dialog-Frame = GRAY_COLOR
     4482   .
     4483   DISPLAY
     4484   a-n-c
     4485   loc-name
     4486   loc-code
     4487   mark-num
     4488   WITH FRAME Dialog-Frame.
     4489   ENABLE
     4490   b-quit
     4491   B-mark WHEN LOOKUP("b-mark", bttns) > 0
     4492   b-sel  WHEN LOOKUP("b-sel", bttns) > 0
     4493   B-chg
     4494   B-sch
     4495   B-print
     4496   B-Help
     4497   b-send
     4498   a-n-c
     4499   loc-name
     4500   loc-code
     4501   br-mcli
     4502   mark-num
     4503   b-lkp
     4504   WITH FRAME Dialog-Frame.
     4505   VIEW FRAME Dialog-Frame.
     4506   hide
     4507   loc-name in frame Dialog-Frame.
     4508   RUN disp-cd IN THIS-PROCEDURE.
     4509   END PROCEDURE.
     4510   PROCEDURE OpenBr :
     4511   define input  parameter p-open-query     as logical   no-undo .
     4512   define input  parameter p-find-next      as logical   no-undo .
     4513   define input  parameter p-find-condition as character no-undo .
     4514   define variable l-query-was-opened as logical no-undo .
     4515   define variable title0 as character no-undo.
     4516   title0 = substitute("Клиенты на кассе &1"
     4517                       , p-pos-type).
     4518   run waitfram-show in this-procedure ("Ждите...").
     4519   define variable sort-column-phrase as character no-undo .
     4520   case sort-column-name :
     4521     when "" then do:
     4522       assign
     4523         sort-column-phrase = ""
     4524       .
     4525     end.
     4526     otherwise do:
     4527       assign
     4528         sort-column-phrase = "by " + sort-column-name
     4529       .
     4530     end.
     4531   end case.
     4532   define variable l-open-query as logical   no-undo .
     4533   CASE p-mode :
     4534     WHEN 'все':U        THEN DO:
     4535       assign
     4536       filter-point = filter-point0 + p-mode
     4537       filter-label = substitute("&1", filter-label0)
     4538       .
     4539       if p-open-query then do:
     4540         frame Dialog-Frame:TITLE = title0.
     4541       end.
     4542   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4543   define variable  l-disable-where-39  as logical   no-undo .
     4544   define variable  l-filter-open-39    as logical   .
     4545   define variable  flt-rec-39       as recid     no-undo .
     4546   define variable  filter-name-39      as character no-undo .
     4547   define variable  where-phrase-39     as character no-undo .
     4548   define variable  sort-phrase-39      as character no-undo .
     4549   define variable  where-phrase-rus-39 as character no-undo .
     4550   define variable  sort-phrase-rus-39  as character no-undo .
     4551     run waitfram-show in this-procedure
     4552       (input "ЖДИТЕ ..."
     4553       ).
     4554   run gbl/flt-get.p
     4555     (input filter-point
     4556     ,output flt-rec-39
     4557     ,output filter-name-39
     4558     ,output where-phrase-39
     4559     ,output sort-phrase-39
     4560     ,output where-phrase-rus-39
     4561     ,output sort-phrase-rus-39
     4562     ).
     4563   if p-open-query then do:
     4564       run set-filter-name in this-procedure
     4565         (INPUT filter-name-39
     4566         ) no-error .
     4567     assign
     4568       l-filter-open-39 = false
     4569     .
     4570     if flt-rec-39 <> ?
     4571       or sort-column-phrase > ""
     4572     then do:
     4573       define variable  parameter-2-39 as character no-undo .
