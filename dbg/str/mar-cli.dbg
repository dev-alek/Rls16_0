     1402   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1403   PROCEDURE cd-mrkt_plu-marketer :
     1404   define input parameter p-silence as logical no-undo .
     1405   define parameter buffer buf_cash-desk for ub.cash-desk.
     1406   define input parameter p-id as character no-undo .
     1407   define input parameter p-b-code like ub.bar-code.b-code no-undo .
     1408   define input parameter p-b-str like ub.prod-bc.b-str no-undo .
     1409   define input parameter p-loc-ean as logical no-undo .
     1410   define input parameter p-is-petrolium as logical no-undo .
     1411   define input parameter p-extra as character no-undo .
     1412   define variable v-tot-gds as integer no-undo .
     1413   define variable v-max-gds as integer no-undo .
     1414   define variable v-petrol-start as integer no-undo .
     1415   define variable v-petrol-range as integer no-undo .
     1416   DEFINE VARIABLE v-today as date no-undo .
     1417   DEFINE VARIABLE v-time as integer no-undo .
     1418   define variable v-plu-type as character no-undo .
     1419   define variable v-int as integer no-undo .
     1420   define buffer  buf_cd-plu for ub.cd-plu.
     1421   define buffer  loc_cd-plu for ub.cd-plu.
     1422   define variable  ii as integer no-undo.
     1423   define variable v-mes as character no-undo .
     1424   _main:
     1425   DO ON ERROR undo, leave on stop undo, leave:
     1426     if buf_cash-desk.pos-type <> 'MARIA':U
     1427     or buf_cash-desk.cash-num <> 0 then do:
     1428       assign
     1429       v-mes =
     1430       substitute("Товары на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     1431                 , buf_cash-desk.pos-type).
     1432       if not p-silence then
     1433       message
     1434       v-mes
     1435       view-as alert-box error .
     1436       return error v-mes.
     1437     end.
     1438     v-tot-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     1439                                     ,input 'MARIA_operative':U
     1440                                     ,input (if buf_cash-desk.pos-type = 'MARIA':U
     1441                                           and p-is-petrolium
     1442                                           then 'tot-petrol':U
     1443                                           else 'tot-gds':U)
     1444                                     , output v-mes).
     1445     if v-tot-gds = ? then undo _main, return error v-mes.
     1446     v-max-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     1447                                     ,input 'MARIA_general':U
     1448                                     ,input 'max-gds':U
     1449                                     ,output v-mes).
     1450     if v-max-gds = ? then undo _main, return error v-mes.
     1451     v-petrol-range = cd-attr_get-attr-int(buffer buf_cash-desk
     1452                                          ,input 'petrolium-range':U
     1453                                          ,input 'petrolium-range':U
     1454                                          ,output v-mes).
     1455     if v-petrol-range = ? then undo _main, return error v-mes.
     1456     if buf_cash-desk.pos-type = 'MARIA':U then do:
     1457       assign
     1458       v-petrol-start = 1
     1459       v-max-gds = (if p-is-petrolium
     1460                    then v-petrol-range
     1461                    else v-max-gds)
     1462       v-plu-type = (if p-is-petrolium
     1463                  then 'топ':U
     1464                  else '':U)
     1465       .
     1466       if p-is-petrolium then do:
     1467         if p-id = '':U then do:
     1468           v-mes = substitute( "Топливо с кодом &1 не привязано к складскому месту&2" +
     1469                               "Невозможно привязать к кассе типа &3"
     1470                               , p-b-str
     1471                               , chr(10)
     1472                               , 'MARIA':U).
     1473           if not p-silence then
     1474           message
     1475           v-mes
     1476           view-as alert-box error .
     1477           return error v-mes.
     1478         end.
     1479         assign
     1480         v-int = integer(p-id)
     1481         no-error
     1482         .
     1483         if error-status:error
     1484         or v-int > v-petrol-range then do:
     1485           v-mes = substitute( "№ резервуара &1 для топлива с кодом &1 не укладывается&3" +
     1486                               "в диапазоны номеров резервуаров для кассы типа &4"
     1487                               , p-id
     1488                               , p-b-str
     1489                               , chr(10)
     1490                               , 'MARIA':U).
     1491           if not p-silence then
     1492           message
     1493           v-mes
     1494           view-as alert-box error .
     1495           return error v-mes.
     1496         end.
     1497       end.
     1498     end.
     1499     if buf_cash-desk.pos-type = 'MARIA':U
     1500     and p-is-petrolium then do:
     1501       find first loc_cd-plu where
     1502                loc_cd-plu.obj-type = 'маг':U
     1503            and loc_cd-plu.obj-code = buf_cash-desk.obj-code
     1504            and loc_cd-plu.pos-type = buf_cash-desk.pos-type
     1505            and loc_cd-plu.plu-type = 'топ':U
     1506      no-error .
     1507      if available loc_cd-plu then do:
     1508        if loc_cd-plu.b-code = p-b-code
     1509        and loc_cd-plu.b-str = p-b-str then do:
     1510           v-mes = substitute( "№ резервуара &1 на кассе УЖЕ привязан к топливу с кодом &1,&3"
     1511                               , p-id
     1512                               , p-b-str
     1513                               , chr(10)
     1514                               ).
     1515           if not p-silence then
     1516           message
     1517           v-mes
     1518           view-as alert-box WARNING .
     1519           return v-mes.
     1520        end.
     1521        else do:
     1522           v-mes = substitute( "№ резервуара &1 на кассе привязан к топливу с кодом &1,&3" +
     1523                               "нельзя его привязать к топливу &2&3"
     1524                               , p-id
     1525                               , loc_cd-plu.b-str
     1526                               , chr(10)
     1527                               , p-b-str).
     1528           if not p-silence then
     1529           message
     1530           v-mes
     1531           view-as alert-box error .
     1532           return error v-mes.
     1533        end.
     1534      end.
     1535      ii = v-int.
     1536     end.
     1537     else do:
     1538       DO ii = (if p-is-petrolium
     1539               then v-petrol-start
     1540               else (if buf_cash-desk.pos-type = 'MARIA':U
     1541                    then 1
     1542                    else (if v-petrol-start = 1
     1543                           then (v-petrol-range + 1)
     1544                           else 1)
     1545                   )
     1546               )
     1547         to v-max-gds :
     1548         if not can-find (loc_cd-plu where
     1549                         loc_cd-plu.obj-type = 'маг':U
     1550                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     1551                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     1552                      and loc_cd-plu.plu-type = v-plu-type
     1553                      and loc_cd-plu.plu-code = ii
     1554                       )
     1555         then LEAVE .
     1556       END .
     1557     end.
     1558     if ii > v-max-gds then do:
     1559         if not p-silence then
     1560         message
     1561         substitute("Превышено максимально допустимое количество &5 &1" +
     1562                   "для касс &2 &3&4"
     1563                   , chr(10)
     1564                   , v-max-gds
     1565                   , 'маг':U
     1566                   , buf_cash-desk.obj-code
     1567                   , (if p-is-petrolium then "топлив" else "товаров")
     1568                   )
     1569         view-as alert-box ERROR .
     1570         undo, return error "max-gds":U.
     1571     end.
     1572     DO ii = (if p-is-petrolium
     1573              then v-petrol-start
     1574              else (if v-petrol-start = 1
     1575                    then (v-petrol-range + 1)
     1576                    else 1)
     1577              )
     1578        to v-max-gds :
     1579       if not can-find (loc_cd-plu where
     1580                         loc_cd-plu.obj-type = 'маг':U
     1581                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     1582                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     1583                      and loc_cd-plu.plu-type = v-plu-type
     1584                      and loc_cd-plu.plu-code = ii
     1585                      )
     1586       then LEAVE .
     1587     END .
     1588     if ii > v-max-gds then do:
     1589         if not p-silence then
     1590         message
     1591         substitute("Превышено максимально допустимое количество &5 &1" +
     1592                   "для касс &2 &3&4"
     1593                   , chr(10)
     1594                   , v-max-gds
     1595                   , 'маг':U
     1596                   , buf_cash-desk.obj-code
     1597                   , (if p-is-petrolium then "топлив" else "товаров")
     1598                   )
     1599         view-as alert-box ERROR .
     1600         undo, return error "max-gds":U.
     1601     end.
     1602     run cur-time in this-procedure ( output v-today, output v-time).
     1603     create buf_cd-plu.
     1604     assign
     1605     buf_cd-plu.b-code = p-b-code
     1606     buf_cd-plu.b-str = p-b-str
     1607     buf_cd-plu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     1608                                         then buf_cash-desk.addr-path
     1609                                         else "U":U)
     1610     buf_cd-plu.to-send = yes
     1611     buf_cd-plu.charkey_one = "":U
     1612     buf_cd-plu.to-del = no
     1613     buf_cd-plu.plu-code = ii
     1614     buf_cd-plu.obj-type = 'маг':U
     1615     buf_cd-plu.obj-code = buf_cash-desk.obj-code
     1616     buf_cd-plu.pos-type = buf_cash-desk.pos-type
     1617     buf_cd-plu.plu-type = v-plu-type
     1618     buf_cd-plu.logkey_one = p-loc-ean
     1619     buf_cd-plu.key#_one = integer(p-extra)
     1620     .
     1621     run cd-attr-write  in this-procedure (
     1622                                           input   buf_cash-desk.db-num
     1623                                           ,input  buf_cash-desk.obj-code
     1624                                           ,input  buf_cash-desk.pos-type
     1625                                           ,input  buf_cash-desk.cash-num
     1626                                           ,input  substitute("&1_operative", buf_cash-desk.pos-type)
     1627                                           ,input (if buf_cash-desk.pos-type = 'MARIA':U
     1628                                                 and p-is-petrolium
     1629                                                 then 'tot-petrol':U
     1630                                                 else 'tot-gds':U)
     1631                                           ,input ''
     1632                                           ,input ?
     1633                                           ,input 0.0
     1634                                           ,input  (v-tot-gds + 1)
     1635                                           ,input no
     1636                                          ) no-error .
     1637     if error-status:error then do:
     1638       v-mes = substitute("Ошибка при записи <текущее количество товаров на кассе> для кассы &1 &2&3:&4&5 &6"
     1639                          ,buf_cash-desk.cash-num
     1640                          , 'маг':U
     1641                          ,buf_cash-desk.obj-code
     1642                          , chr(10)
     1643                          , error-status:get-message(1)
     1644                          , return-value
     1645                          ).
     1646       if not p-silence then
     1647       message
     1648       v-mes
     1649       view-as alert-box error .
     1650       undo _main, return error v-mes.
     1651     end.
     1652     run cd-attr-write  in this-procedure (
     1653                                           input   buf_cash-desk.db-num
     1654                                           ,input  buf_cash-desk.obj-code
     1655                                           ,input  buf_cash-desk.pos-type
     1656                                           ,input  buf_cash-desk.cash-num
     1657                                           ,input  'MARIA_operative':U
     1658                                           ,input  'to-send':U
     1659                                           ,input ''
     1660                                           ,input ?
     1661                                           ,input 0.0
     1662                                           ,input 0
     1663                                           ,input yes
     1664                                          ) no-error .
     1665     if error-status:error then do:
     1666       v-mes = substitute("Ошибка при записи <Есть коды товаров, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     1667                          ,buf_cash-desk.cash-num
     1668                          , 'маг':U
     1669                          ,buf_cash-desk.obj-code
     1670                          , chr(10)
     1671                          , error-status:get-message(1)
     1672                          , return-value
     1673                          ).
     1674       if not p-silence then
     1675       message
     1676       v-mes
     1677       view-as alert-box error .
     1678       undo _main, return error v-mes.
     1679     end.
     1680     return "":U.
     1681   end.
     1682   END PROCEDURE.
     1683   procedure cd-mrkt_update-marketer :
     1684   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     1685   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     1686   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     1687   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     1688   define input parameter p-is-petrolium as logical no-undo .
     1689   define variable v-to-send as logical no-undo .
     1690   define variable v-tot-gds as integer no-undo .
     1691   define variable v-max-plu as integer no-undo .
     1692   define buffer buf_cd-plu for ub.cd-plu.
     1693   define variable v-plu-type as character no-undo .
     1694     do
     1695     on error undo, return error
     1696     :
     1697       v-to-send = no.
     1698       v-tot-gds = 0.
     1699       assign
     1700       v-plu-type = (if p-is-petrolium
     1701                     then  'топ':U
     1702                     else '':U
     1703                 )
     1704       .
     1705       FOR EACH buf_cd-plu WHERE
     1706              buf_cd-plu.obj-type = 'маг':U
     1707         and  buf_cd-plu.obj-code = p-obj-code
     1708         and  buf_cd-plu.pos-type = p-pos-type
     1709         and  buf_cd-plu.plu-type = v-plu-type
     1710             :
     1711         if  buf_cd-plu.to-del
     1712         or  buf_cd-plu.to-send then do:
     1713           assign
     1714           v-to-send = yes.
     1715         end.
     1716         assign
     1717         v-tot-gds = v-tot-gds + 1.
     1718       end.
     1719       run cd-attr-write  in this-procedure (
     1720                                               input   p-db-num
     1721                                               ,input  p-obj-code
     1722                                               ,input  p-pos-type
     1723                                               ,input  p-cash-num
     1724                                               ,input  'MARIA_operative':U
     1725                                               ,input  (if p-pos-type = 'MARIA':U
     1726                                                        and p-is-petrolium
     1727                                                        then  'tot-petrol':U
     1728                                                        else 'tot-gds':U)
     1729                                               ,input ''
     1730                                               ,input ?
     1731                                               ,input 0.0
     1732                                               ,input v-tot-gds
     1733                                               ,input no
     1734                                                                                           ) no-error .
     1735       if error-status:error then do:
     1736           UNDO, RETURN ERROR RETURN-VALUE.
     1737       END.
     1738       run cd-attr-write  in this-procedure (
     1739                                               input   p-db-num
     1740                                               ,input  p-obj-code
     1741                                               ,input  p-pos-type
     1742                                               ,input  p-cash-num
     1743                                               ,input  'MARIA_operative':U
     1744                                               ,input  (if p-pos-type = 'MARIA':U
     1745                                                        and p-is-petrolium
     1746                                                        then  'petrol-to-send':U
     1747                                                        else 'to-send':U)
     1748                                               ,input ''
     1749                                               ,input ?
     1750                                               ,input 0.0
     1751                                               ,input 0
     1752                                               ,input v-to-send
     1753                                               ) no-error .
     1754       if error-status:error then do:
     1755           UNDO, RETURN ERROR RETURN-VALUE.
     1756       END.
     1757       FIND LAST buf_cd-plu NO-LOCK  WHERE
     1758                buf_cd-plu.obj-type = 'маг':U
     1759            and buf_cd-plu.obj-code = p-obj-code
     1760            and buf_cd-plu.pos-type = p-pos-type
     1761            and buf_cd-plu.plu-type = v-plu-type  use-index pi no-error .
     1762       if available buf_cd-plu then do:
     1763         if v-max-plu < buf_cd-plu.plu-code
     1764         then
     1765         v-max-plu = buf_cd-plu.plu-code .
     1766       end.
     1767       else do:
     1768         v-max-plu = 0.
     1769       end.
     1770       run cd-attr-write  in this-procedure (
     1771                                             input   p-db-num
     1772                                             ,input  p-obj-code
     1773                                             ,input  p-pos-type
     1774                                             ,input  p-cash-num
     1775                                             ,input  'MARIA_operative':U
     1776                                             ,input  (if p-pos-type = 'MARIA':U
     1777                                                     and p-is-petrolium
     1778                                                     then 'max-petrol-plu':U
     1779                                                     else 'max-plu':U)
     1780                                               ,input ''
     1781                                               ,input ?
     1782                                               ,input 0.0
     1783                                               ,input v-max-plu
     1784                                               ,input no
     1785                                             ) no-error .
     1786       if error-status:error then do:
     1787           UNDO, RETURN ERROR RETURN-VALUE.
     1788       END.
     1789     end.
     1790   end procedure.
     1791   PROCEDURE cd-mrkt_clu-marketer :
     1792   define input parameter p-silence as logical no-undo .
     1793   define parameter buffer buf_cash-desk for ub.cash-desk.
     1794   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     1795   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1796   define variable v-tot-cli as integer no-undo .
     1797   define variable v-max-cli as integer no-undo .
     1798   DEFINE VARIABLE v-today as date no-undo .
     1799   DEFINE VARIABLE v-time as integer no-undo .
     1800   define buffer  buf_cd-clu for ub.cd-clu.
     1801   define buffer  loc_cd-clu for ub.cd-clu.
     1802   define variable  ii as integer no-undo.
     1803   define variable v-mes as character no-undo .
     1804   _main:
     1805   DO ON ERROR undo, leave on stop undo, leave:
     1806     if buf_cash-desk.pos-type <> 'MARIA':U
     1807     or buf_cash-desk.cash-num <> 0 then do:
     1808       assign
     1809       v-mes =
     1810       substitute("Клиенты на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     1811                 , buf_cash-desk.pos-type).
     1812       if not p-silence then
     1813       message
     1814       v-mes
     1815       view-as alert-box error .
     1816       return error v-mes.
     1817     end.
     1818     v-tot-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     1819                                     ,input 'MARIA_operative':U
     1820                                     ,input 'tot-cli':U
     1821                                     ,output v-mes).
     1822     if v-tot-cli = ? then undo _main, return error v-mes.
     1823     v-max-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     1824                                     ,input 'MARIA_general':U
     1825                                     ,input 'max-cli':U
     1826                                     , output v-mes).
     1827     if v-max-cli = ? then undo _main, return error v-mes.
     1828     DO ii = 1
     1829        to v-max-cli :
     1830       if not can-find (loc_cd-clu where
     1831                       loc_cd-clu.obj-type = 'маг':U
     1832                   and loc_cd-clu.obj-code = buf_cash-desk.obj-code
     1833                   and loc_cd-clu.pos-type = buf_cash-desk.pos-type
     1834                   and loc_cd-clu.clu-type = '':U
     1835                   and loc_cd-clu.clu-code = ii
     1836                      )
     1837       then LEAVE .
     1838     END .
     1839     if ii > v-max-cli then do:
     1840         if not p-silence then
     1841         message
     1842         substitute("Превышено максимально допустимое количество клиентов &1" +
     1843                   "для касс &2 &3&4"
     1844                   , chr(10)
     1845                   , v-max-cli
     1846                   , 'маг':U
     1847                   , buf_cash-desk.obj-code
     1848                   )
     1849         view-as alert-box ERROR .
     1850         undo, return error "max-cli":U.
     1851     end.
     1852     run cur-time in this-procedure ( output v-today, output v-time).
     1853     create buf_cd-clu.
     1854     assign
     1855     buf_cd-clu.cli-code = p-obj-code
     1856     buf_cd-clu.cli-type = p-obj-type
     1857     buf_cd-clu.obj-type = 'маг':U
     1858     buf_cd-clu.obj-code = buf_Cash-desk.obj-code
     1859     buf_cd-clu.pos-type = buf_cash-desk.pos-type
     1860     buf_cd-clu.clu-type = '':U
     1861     buf_cd-clu.to-send = yes
     1862     buf_cd-clu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     1863                               then buf_cash-desk.addr-path
     1864                               else "U":U)
     1865     buf_cd-clu.clu-code = ii
     1866     .
     1867     run cd-attr-write  in this-procedure (
     1868                                           input   buf_cash-desk.db-num
     1869                                           ,input  buf_cash-desk.obj-code
     1870                                           ,input  buf_cash-desk.pos-type
     1871                                           ,input  buf_cash-desk.cash-num
     1872                                           ,input  'MARIA_operative':U
     1873                                           ,input  'tot-cli':U
     1874                                           ,input ''
     1875                                           ,input ?
     1876                                           ,input 0.0
     1877                                           ,input  (v-tot-cli + 1)
     1878                                           ,input no
     1879                                          ) no-error .
     1880     if error-status:error then do:
     1881       v-mes = substitute("Ошибка при записи <текущее количество клиентов на кассе> для кассы &1 &2&3:&4&5 &6"
     1882                          ,buf_cash-desk.cash-num
     1883                          , 'маг':U
     1884                          ,buf_cash-desk.obj-code
     1885                          , chr(10)
     1886                          , error-status:get-message(1)
     1887                          , return-value
     1888                          ).
     1889       if not p-silence then
     1890       message
     1891       v-mes
     1892       view-as alert-box error .
     1893       undo _main, return error v-mes.
     1894     end.
     1895     run cd-attr-write  in this-procedure (
     1896                                           input   buf_cash-desk.db-num
     1897                                           ,input  buf_cash-desk.obj-code
     1898                                           ,input  buf_cash-desk.pos-type
     1899                                           ,input  buf_cash-desk.cash-num
     1900                                           ,input  'MARIA_operative':U
     1901                                           ,input  'cli-to-send':U
     1902                                           ,input ''
     1903                                           ,input ?
     1904                                           ,input 0.0
     1905                                           ,input 0
     1906                                           ,input yes
     1907                                          ) no-error .
     1908     if error-status:error then do:
     1909       v-mes = substitute("Ошибка при записи <Есть коды клиентов, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     1910                          ,buf_cash-desk.cash-num
     1911                          , 'маг':U
     1912                          ,buf_cash-desk.obj-code
     1913                          , chr(10)
     1914                          , error-status:get-message(1)
     1915                          , return-value
     1916                          ).
     1917       if not p-silence then
     1918       message
     1919       v-mes
     1920       view-as alert-box error .
     1921       undo _main, return error v-mes.
     1922     end.
     1923     return "":U.
     1924   end.
     1925   END PROCEDURE.
     1926   procedure cd-mrkt_update-marketer-cli :
     1927   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     1928   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     1929   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     1930   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     1931   define variable v-cli-to-send as logical no-undo .
     1932   define variable v-tot-cli as integer no-undo .
     1933   define variable v-max-clu as integer no-undo .
     1934   define buffer buf_cd-clu for ub.cd-clu.
     1935   do
     1936   on error undo, return error return-value
     1937   :
     1938     v-cli-to-send = no.
     1939     v-tot-cli = 0.
     1940     FOR EACH buf_cd-clu WHERE
     1941           buf_cd-clu.obj-type = 'маг':U
     1942       and buf_cd-clu.obj-code =  p-obj-code
     1943       and buf_cd-clu.pos-type =  p-pos-type
     1944       and buf_cd-clu.clu-type =  '':U
     1945       :
     1946       if buf_cd-clu.to-del = yes then do:
     1947         assign
     1948         v-cli-to-send = yes.
     1949       end.
     1950       assign
     1951       v-tot-cli = v-tot-cli + 1.
     1952     end.
     1953     run cd-attr-write  in this-procedure (
     1954                                             input   p-db-num
     1955                                             ,input  p-obj-code
     1956                                             ,input  p-pos-type
     1957                                             ,input  p-cash-num
     1958                                             ,input  'MARIA_operative':U
     1959                                             ,input  'tot-cli':U
     1960                                             ,input ''
     1961                                             ,input ?
     1962                                             ,input 0.0
     1963                                             ,input v-tot-cli
     1964                                             ,input no
     1965                                             ) no-error .
     1966     if error-status:error then do:
     1967         UNDO, RETURN ERROR RETURN-VALUE.
     1968     END.
     1969     run cd-attr-write  in this-procedure (
     1970                                             input   p-db-num
     1971                                             ,input  p-obj-code
     1972                                             ,input  p-pos-type
     1973                                             ,input  p-cash-num
     1974                                             ,input  'MARIA_operative':U
     1975                                             ,input  'cli-to-send':U
     1976                                             ,input ''
     1977                                             ,input ?
     1978                                             ,input 0.0
     1979                                             ,input 0
     1980                                             ,input v-cli-to-send
     1981                                             ) no-error .
     1982     if error-status:error then do:
     1983         UNDO, RETURN ERROR RETURN-VALUE.
     1984     END.
     1985     FIND LAST buf_cd-clu WHERE
     1986             buf_cd-clu.obj-type = 'маг':U
     1987         and buf_cd-clu.obj-code = p-obj-code
     1988         and buf_cd-clu.pos-type = p-pos-type
     1989         and buf_cd-clu.clu-type = '':U
     1990         NO-LOCK use-index pi no-error .
     1991     if available buf_cd-clu then do:
     1992       if v-max-clu < buf_cd-clu.clu-code
     1993       then
     1994       v-max-clu = buf_cd-clu.clu-code.
     1995     end.
     1996     else do:
     1997       v-max-clu = 0.
     1998     end.
     1999     run cd-attr-write  in this-procedure (
     2000                                           input   p-db-num
     2001                                           ,input  p-obj-code
     2002                                           ,input  p-pos-type
     2003                                           ,input  p-cash-num
     2004                                           ,input  'MARIA_operative':U
     2005                                           ,input  'max-clu':U
     2006                                           ,input ''
     2007                                           ,input ?
     2008                                           ,input 0.0
     2009                                           ,input v-max-clu
     2010                                           ,input no
     2011                                           ) no-error .
     2012     if error-status:error then do:
     2013         UNDO, RETURN ERROR RETURN-VALUE.
     2014     END.
     2015   end.
     2016   end procedure.
