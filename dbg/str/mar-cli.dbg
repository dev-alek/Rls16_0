     4925   END CASE.
     4926   if not p-open-query and v-doc-rec <> ? then
     4927   REPOSITION br-mcli to recid v-doc-rec No-ERROR.
     4928   if not p-open-query and v-fltopend-rowid[1] <> ? then
     4929   query br-mcli:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     4930   run waitfram-hide in this-procedure .
     4931   APPLY "VALUE-CHANGED" TO br-mcli in frame Dialog-Frame.
     4932   APPLY "ENTRY" TO br-mcli.
     4933   END PROCEDURE.
     4934   PROCEDURE proc-b-chg :
     4935   define variable old-mode as char no-undo.
     4936   define variable old-handle as handle no-undo.
     4937   define variable old-type as char no-undo.
     4938   define variable old-stat as char no-undo.
     4939   define variable old-flag as logical no-undo.
     4940   define variable old-internal as logical no-undo.
     4941   DEFINE VARIABLE v-skip-next as logical no-undo .
     4942   DEFINE VARIABLE v-update as logical no-undo .
     4943   define variable v-f-name as character no-undo .
     4944   define variable l-empty-scale as logical no-undo .
     4945   define variable ves-err as integer no-undo .
     4946   define variable v-to-send as logical no-undo .
     4947   define variable v-mes as character no-undo .
     4948   define variable v-restore as logical   no-undo .
     4949   define buffer buf_clients for ub.clients.
     4950   DEFINE BUFFER buf_cd-clu FOR ub.cd-clu.
     4951   define buffer buf_dis-card for ub.dis-card.
     4952   FOR EACH dc-list :
     4953       delete dc-list.
     4954   END.
     4955   FOR EACH save-list:
     4956     delete save-list.
     4957   end.
     4958   run waitfram-show in this-procedure ( input "ЖДИТЕ.  Заполняется список...").
     4959   _block:
     4960   DO ON error UNDO _block, return error
     4961   on stop undo _block, return error:
     4962   _cd-clu:
     4963     FOR EACH buf_cd-clu  WHERE
     4964             buf_cd-clu.obj-type = p-curr-obj-type
     4965         and buf_cd-clu.obj-code = p-curr-obj-code
     4966         and buf_cd-clu.pos-type = 'MARIA':U
     4967         and buf_cd-clu.clu-type = '':U
     4968     by buf_cd-clu.clu-code:
     4969       IF buf_cd-clu.to-DEL = yes
     4970       and buf_cd-clu.charkey_one = v-cd-list-delete THEN NEXT.
     4971       assign
     4972       buf_cd-clu.to-del = yes
     4973       buf_cd-clu.charkey_one = v-cd-list-delete.
     4974       FIND FIRST buf_clients WHERE
     4975               buf_clients.obj-type = buf_cd-clu.cli-type
     4976           and buf_clients.obj-code = buf_cd-clu.cli-code  NO-LOCK no-error .
     4977       if not available buf_clients then do:
     4978         assign
     4979         buf_cd-clu.to-del = yes
     4980         buf_cd-clu.charkey_one = v-cd-list-delete.
     4981         next _cd-clu.
     4982       end.
     4983       find first buf_dis-card no-lock where
     4984                 buf_dis-card.d-card = ('K':U + string(if buf_clients.obj-type = 'орг':U then 1 else 0) + string(buf_clients.obj-code, '999999999')) no-error.
     4985       if not available buf_dis-card then do:
     4986         assign
     4987         buf_cd-clu.to-del = yes
     4988         buf_cd-clu.charkey_one = v-cd-list-delete.
     4989         next _cd-clu.
     4990       end.
     4991   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4992   find dc-list
     4993     where dc-list.d-card = buf_dis-card.d-card
     4994     no-error .
     4995   if available dc-list then do:
     4996     assign
     4997       dc-list.to-del = no
     4998     .
     4999   end.
     5000   else do:
     5001     create dc-list .
     5002     buffer-copy buf_dis-card to dc-list
     5003     assign
     5004       dc-list.to-del = no
     5005     .
     5006     assign
     5007       lns-cnt = lns-cnt + 1
     5008       line-rec = recid (dc-list)
     5009     .
     5010   end.
     5011   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5012       assign
     5013       buf_cd-clu.to-DEL = yes
     5014       buf_cd-clu.charkey_one = v-cd-list-delete
     5015       .
     5016     end.
     5017   run waitfram-hide in this-procedure .
     5018   END.
     5019   run run-dc-list no-error .
     5020   if error-status:error then do:
     5021     assign
     5022     v-restore = yes.
     5023   end.
     5024   if not v-restore then do:
     5025     message
     5026     substitute("Вы действительно хотите изменить список клиентов на кассах &4 на &1&2&3" +
     5027               "в соответствии с данным списком кодов?&3" +
     5028               "(В список будут добавлены ТОЛЬКО карты типа КЛИЕНТ-СЧЕТ)"
     5029               , p-curr-obj-type
     5030               , p-curr-obj-code
     5031               , chr(10)
     5032               , p-pos-type
     5033               )
     5034     view-as alert-box QUESTION buttons YES-NO update v-update.
     5035   end.
     5036   if not v-update then do:
     5037     FOR EACH dc-list:
     5038       delete dc-list.
     5039     END.
     5040     FOR EACH buf_cd-clu where
     5041             buf_cd-clu.obj-type = p-curr-obj-type
     5042         and buf_cd-clu.obj-code = p-curr-obj-code
     5043         and buf_cd-clu.pos-type = 'MARIA':U
     5044         and buf_cd-clu.clu-type = '':U ,
     5045         FIRST save-list WHERE
     5046               save-list.cli-type = buf_cd-clu.cli-type
     5047           AND save-list.cli-code = buf_cd-clu.cli-code NO-LOCK:
     5048       assign
     5049       buf_cd-clu.to-DEL = no
     5050       buf_cd-clu.charkey_one = '':U
     5051       .
     5052       delete save-list.
     5053     end.
     5054       return .
     5055   end.
     5056   run waitfram-show in this-procedure ("ЖДИТЕ.  Началось изменение справочника.").
     5057   ves-err = 0.
     5058   DO ON error UNDO, return error :
     5059   _TO-cli:
     5060   FOR EACH dc-list:
     5061     ACCUMULATE dc-list.d-card ( count ).
     5062     if ( accum count dc-list.d-card ) modulo 100 = 0 then do:
     5063       run waitfram-show in this-procedure ("ЖДИТЕ.  Обработано строк списка : " +
     5064                                      string ( accum count dc-list.d-card ) ) .
     5065     end.
     5066     FIND FIRST buf_cd-clu WHERE
     5067             buf_cd-clu.obj-type = p-curr-obj-type
     5068         and buf_cd-clu.obj-code = p-curr-obj-code
     5069         and buf_cd-clu.pos-type = 'MARIA':U
     5070         and buf_cd-clu.clu-type = '':U
     5071         AND buf_cd-clu.cli-code = dc-list.cli-code
     5072         AND buf_cd-clu.cli-type = dc-list.cli-type  NO-ERROR.
     5073     if available buf_cd-clu then do:
     5074       assign
     5075       buf_cd-clu.to-DEL = no
     5076       buf_cd-clu.charkey_one = "":U
     5077       .
     5078     end.
     5079     else do:
     5080       if v-skip-next then do:
     5081         delete dc-list.
     5082       end.
     5083       else do:
     5084         CASE p-pos-type:
     5085           when 'MARIA':U then do:
     5086             if dc-list.type <> '@client':U
     5087             or dc-list.d-card <> ('K':U + string(if dc-list.cli-type = 'орг':U then 1 else 0) + string(dc-list.cli-code, '999999999'))
     5088             then do:
     5089               ves-err = ves-err + 1.
     5090               next _TO-cli.
     5091             end.
     5092             run cd-mrkt_CLU-marketer(
     5093                                       input no
     5094                                     ,buffer locked_cash-desk
     5095                                     ,input dc-list.cli-type
     5096                                     ,input dc-list.cli-code
     5097                                     ) no-error.
     5098             if error-status:error then do:
     5099               if return-value = "max-cli":U then dO:
     5100                 assign
     5101                 v-skip-next = yes
     5102                 ves-err = ves-err + 1.
     5103                 NEXT _to-cli.
     5104               end.
     5105               else do:
     5106                 ves-err = ves-err + 1.
     5107                 next _TO-cli.
     5108               end.
     5109             end.
     5110             else do:
     5111               delete dc-list.
     5112             end.
     5113           end.
     5114         end CASE.
     5115       end.
     5116     end.
     5117   END .
     5118   _mrktr-cli:
     5119   FOR EACH buf_cd-clu WHERE
     5120           buf_cd-clu.obj-type = p-curr-obj-type
     5121       and buf_cd-clu.obj-code = p-curr-obj-code
     5122       and buf_cd-clu.pos-type = 'MARIA':U
     5123       and buf_cd-clu.clu-type = '':U :
     5124     IF buf_cd-clu.charkey_one <> v-cd-list-delete THEN NEXT _mrktr-cli.
     5125     assign
     5126     buf_cd-clu.to-send = yes
     5127     buf_cd-clu.charkey_two = v-cd-list-update.
     5128   END .
     5129   run cd-mrkt_update-marketer-cli in this-procedure (
     5130                                                   input locked_cash-desk.db-num
     5131                                                   ,input locked_cash-desk.obj-code
     5132                                                   ,input locked_cash-desk.pos-type
     5133                                                   ,input locked_cash-desk.cash-num
     5134                                                 )  no-error .
     5135   if error-status:error then do:
     5136     run waitfram-hide in this-procedure .
     5137     undo, return error .
     5138   end.
     5139   END.
     5140   run waitfram-hide in this-procedure .
     5141   RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     5142   run fill-vars in this-procedure .
     5143   run disp-cd in this-procedure .
     5144   if ves-err > 0 then
     5145   message
     5146   SUBSTITUTE("При добавлении клиентов на кассы встретилось &1 кодов,&2" +
     5147               "для которых не удалось создать запись клиента на кассе&2&2" +
     5148               "Эти клиенты на кассы НЕ ДОБАВЛЕНЫ !!!!"
     5149               , ves-err
     5150               ,chr(10))
     5151   view-as alert-box warning.
     5152   END PROCEDURE.
     5153   PROCEDURE proc-b-print :
     5154   define variable v-doc-rec as recid no-undo .
     5155   define variable accum-count as integer.
     5156   define variable date_string     as      CHARACTER    no-undo.
     5157   define variable Line            as      CHARACTER    no-undo.
     5158   define variable for-time        as      CHARACTER    no-undo.
     5159   define variable v-card-no as character no-undo .
     5160   DEFINE FRAME cd-clu-list
     5161   X_cd-clu.clu-code COLUMN-LABEL "CLU" FORMAT "999":U
     5162   X_cd-clu.cli-type COLUMN-LABEL "Тип!IBS TH" FORMAT "X(3)":U
     5163   X_cd-clu.cli-code COLUMN-LABEL "Код!IBS TH" FORMAT "999999999":U
     5164   X_cd-clu.to-del COLUMN-LABEL "У" FORMAT "+/":U
     5165   X_cd-clu.to-send COLUMN-LABEL "И" FORMAT "+/":U
     5166   X_clients.obj-name  FORMAT "X(50)"
     5167   v-card-no  COLUMN-LABEL 'Клиент-Счет' FORMAT "X(11)":U
     5168   HEADER  date_string AT 5 format "X(35)"
     5169    string( "Страница " ) format "X(9)" AT 105 PAGE-NUMBER(PrnLibStream) AT 115 FORMAT ">>9" SKIP
     5170   Line format "X(130)" AT 1
     5171   with width 232 down stream-io use-text    .
     5172   Line = fill("-", 130).
     5173   date_string = cur-time-print() .
     5174   run prn-lib-open-stream  in this-procedure (
     5175                                                input parParentProc
     5176                                               ,input 62
     5177                                               ,input yes
     5178                                               ,input no
     5179                                               ).
     5180   PUT  STREAM PrnLibStream
     5181   SPACE(25) ( frame Dialog-Frame:title )
     5182   format "x(90)" SKIP(1) .
     5183   FORM HEADER
     5184   Line format "X(130)" AT 1 SKIP
     5185   "Продолжение - на следующей странице" AT 30 SKIP
     5186   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5187   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5188   FORM with FRAME cd-clu-list  .
     5189   run waitfram-show in this-procedure ( input "Ждите...").
     5190   v-doc-rec = recid(X_cd-clu).
     5191   DO WHILE available X_cd-clu :
     5192     GET prev br-mcli.
     5193   END.
     5194   GET next br-mcli.
     5195   DO WHILE available X_cd-clu :
     5196     Display STREAM PrnLibStream
     5197     X_cd-clu.clu-code
     5198     X_cd-clu.cli-type
     5199     X_cd-clu.cli-code
     5200     X_cd-clu.to-DEL
     5201     X_cd-clu.to-send
     5202     X_clients.obj-name
     5203     ('K':U + string(if X_clients.obj-type = 'орг':U then 1 else 0) + string(X_clients.obj-code, '999999999')) @ v-card-no
     5204     with FRAME cd-clu-list .
     5205     DOWN STREAM PrnLibStream 1
     5206     with FRAME cd-clu-list  .
     5207     assign
     5208     accum-count = accum-count + 1
     5209     .
     5210     GET next br-mcli.
     5211   END.
     5212   UNDERLINE  STREAM PrnLibStream
     5213   X_cd-clu.clu-code
     5214   X_cd-clu.cli-type
     5215   X_cd-clu.cli-code
     5216   X_cd-clu.to-del
     5217   X_cd-clu.to-send
     5218   X_clients.obj-name
     5219   v-card-no
     5220   with FRAME cd-clu-list .
     5221   DISPLAY STREAM PrnLibStream
     5222   "ИТОГО" @ X_cd-clu.clu-code
     5223   accum-count @ X_cd-clu.cli-type
     5224   with frame cd-clu-list.
     5225   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5226   HIDE  STREAM PrnLibStream FRAME cd-clu-List.
     5227   output  STREAM PrnLibStream CLOSE.
     5228   REPOSITION br-mcli to recid v-doc-rec no-error.
     5229   APPLY "entry" to br-mcli.
     5230   run waitfram-hide in this-procedure .
     5231   run prn-lib-prn-file in this-procedure (
     5232                                             input parParentProc
     5233                                             ,input 0
     5234                                             ).
     5235   END PROCEDURE.
     5236   PROCEDURE proc-b-sch :
     5237   assign
     5238     tbl = 'cd-clu'
     5239     join-tbl = 'X_cd-clu'
     5240     fld = ""
     5241     lab = ""
     5242     spr = ""
     5243     dim = '0'
     5244     .
     5245   run fltfield-add in this-procedure('CLU-code', 'CLU', '',
     5246   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5247   run fltfield-add in this-procedure('CLI-code', 'Код в TH IBS', '',
     5248   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5249   run fltfield-add in this-procedure('cli-type', 'Тип в TH IBS', '',
     5250   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5251   run fltfield-add in this-procedure('to-del', 'Статус удаления', '',
     5252   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5253   run fltfield-add in this-procedure('to-send', 'Статус изменения', '',
     5254   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5255   Filter-Block:
     5256   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     5257       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     5258       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     5259     run gbl/filter.w ( INPUT parparentproc
     5260                      , INPUT (filter-point + chr(4) + filter-label)
     5261                      , INPUT tbl
     5262                      , INPUT join-tbl
     5263                      , INPUT fld
     5264                      , INPUT lab
     5265                      , INPUT spr
     5266                      , INPUT dim ).
     5267     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     5268   END.
     5269   END PROCEDURE.
     5270   PROCEDURE proc-find-code :
     5271   define input parameter p-a-n-c as character no-undo.
     5272   define input parameter p-next as logical no-undo.
     5273   define input parameter p-code AS integer no-undo.
     5274   DEFINE VARIABLE v-code AS CHARACTER NO-UNDO.
     5275   IF input frame Dialog-Frame a-n-c = "b-code":U THEN DO:
     5276       run OpenBr in this-procedure
     5277           (input false
     5278           ,input p-next
     5279           ,input substitute("and X_cd-clu.cli-code = &1 "
     5280             , p-code)
     5281           ).
     5282   END.
     5283   IF input frame Dialog-Frame a-n-c = "CLU":U THEN DO:
     5284       run OpenBr in this-procedure
     5285           (input false
     5286           ,input p-next
     5287           ,input substitute("and X_cd-clu.clu-code = &1 "
     5288             , p-code)
     5289           ).
     5290   END.
     5291   apply "entry":u to loc-code in frame Dialog-Frame .
     5292   END PROCEDURE.
     5293   PROCEDURE proc-find-obj-type :
     5294   define input parameter p-a-n-c as character no-undo.
     5295   define input parameter p-next as logical no-undo.
     5296   define input parameter p-obj-type AS character no-undo.
     5297   assign
     5298   p-obj-type = replace(p-obj-type, chr(34), "":U)
     5299   p-obj-type = replace(p-obj-type, chr(39), chr(39) + chr(39))
     5300   p-obj-type = chr(34) + p-obj-type + chr(34)
     5301   .
     5302   run OpenBr in this-procedure
     5303   (input false
     5304   ,input p-next
     5305   ,input substitute("and X_cd-clu.cli-type = &1 "
     5306     , p-obj-type)
     5307   ).
     5308   apply "entry":u to loc-code in frame Dialog-Frame .
     5309   END PROCEDURE.
     5310   PROCEDURE RUN-dc-list :
     5311   define variable v-host-code like ub.sysconf.host-code no-undo .
     5312   DO
     5313   ON ERROR UNDO, RETURN ERROR
     5314   ON STOP UNDO, RETURN ERROR:
     5315   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5316   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     5317     (input  p-curr-obj-type
     5318     ,input  p-curr-obj-code
     5319     ,output v-host-code
     5320     )  .
     5321     run str/dc-list.w (
     5322                   INPUT parparentproc
     5323                   ,input v-host-code
     5324                   ,INPUT p-curr-obj-type
     5325                   ,INPUT p-curr-obj-code
     5326                   ).
     5327   END.
     5328   END PROCEDURE.
