      639   procedure fltfield-clear :
      640     define output parameter loc-fld as character no-undo.
      641     define output parameter loc-lab as character no-undo .
      642     define output parameter loc-spr as character no-undo .
      643     define output parameter loc-dim as character no-undo .
      644     assign
      645       loc-fld = ""
      646       loc-lab = ""
      647       loc-spr = ""
      648       loc-dim = "0"
      649     .
      650   end procedure .
      651   procedure fltfield-add :
      652     define input        parameter par-fld as character no-undo.
      653     define input        parameter par-lab as character no-undo .
      654     define input        parameter par-spr as character no-undo .
      655     define input-output parameter loc-fld as character no-undo.
      656     define input-output parameter loc-lab as character no-undo .
      657     define input-output parameter loc-spr as character no-undo .
      658     define input-output parameter loc-dim as character no-undo .
      659     do
      660     on error undo, return error
      661     :
      662       assign
      663       loc-fld = if loc-dim = '0'
      664                 then par-fld
      665                 else (loc-fld + chr(44) + par-fld)
      666       loc-lab = if loc-dim = '0'
      667                 then par-lab
      668                 else (loc-lab + chr(44) + par-lab)
      669       loc-spr = if loc-dim = '0'
      670                 then par-spr
      671                 else (loc-spr + chr(44) + par-spr)
      672       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      673                 string(integer(if num-entries(loc-dim) > 1
      674                               then entry(2, loc-dim)
      675                               else entry(1, loc-dim)
      676                               ) + 1)
      677       no-error
      678       .
      679     end.
      680   end procedure.
      681   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      682   define  stream PrnLibStream.
      683   procedure prn-lib-prn-file :
      684     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      685     define input parameter p-DIsabledoptions as integer no-undo .
      686     define variable v-report-name as character no-undo .
      687     define variable v-user-action as character no-undo .
      688     define variable v-printed     as logical   no-undo .
      689     define variable v-exist       as logical   no-undo .
      690     do
      691       on error undo, return error
      692       :
      693       run prn-lib-get-report-name  in this-procedure (
      694         input parParentProc
      695         ,output v-report-name
      696         ).
      697   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      698   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      699     (input  v-report-name
      700     ,input  2
      701     ,output v-exist
      702     )  .
      703       if NOT v-exist then
      704       DO:
      705         Message
      706           "Нет заданий на печать ! "
      707           view-as alert-box .
      708         Return  .
      709       End.
      710       run gbl/prnfilen.w
      711         (input  ""
      712         ,input  p-DisabledOptions
      713         ,input  string(v-report-name )
      714         ,input  7
      715         ,output v-user-action
      716         ,output v-printed
      717         ) .
      718       if v-printed then
      719       do:
      720         return "YES" .
      721       end.
      722       else
      723       do:
      724         return "NO" .
      725       end.
      726     end.
      727   end procedure.
      728   procedure prn-lib-open-stream :
      729     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      730     define input parameter p-page-size    as integer no-undo .
      731     define input parameter p-is-stream    as logical no-undo .
      732     define input parameter p-append       as logical no-undo .
      733     define variable v-report-name as character no-undo .
      734     do
      735       on error undo, return error
      736       :
      737       run prn-lib-get-report-name  in this-procedure (
      738         input parParentProc
      739         ,output v-report-name
      740         ).
      741       if p-is-stream then
      742       do:
      743         if p-append then
      744         do:
      745           output stream PrnLibStream to value( v-report-name )
      746             page-size value(p-page-size) append .
      747         end.
      748         if not p-append then
      749         do:
      750           output stream PrnLibStream to value( v-report-name )
      751             page-size value(p-page-size) .
      752         end.
      753       end.
      754       if not p-is-stream then
      755       do:
      756         if p-append then
      757         do:
      758           output to value( v-report-name )
      759             page-size value(p-page-size) append .
      760         end.
      761         if not p-append then
      762         do:
      763           output to value( v-report-name )
      764             page-size value(p-page-size) .
      765         end.
      766       end.
      767     end.
      768   end procedure.
      769   procedure prn-lib-open-exp :
      770     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      771     define input parameter p-is-stream    as logical no-undo .
      772     define input parameter p-is-append    as logical no-undo .
      773     define output parameter p-ReportFileName as char init "report" no-undo.
      774     define output parameter p-process as logical no-undo .
      775     define variable glog as logical no-undo .
      776     do
      777       on error undo, return error
      778       :
      779       SYSTEM-DIALOG GET-FILE p-ReportFileName
      780         TITLE      "Укажите путь"
      781         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      782         ASK-OVERWRITE
      783         CREATE-TEST-FILE
      784         SAVE-AS
      785         USE-FILENAME
      786         DEFAULT-EXTENSION "txt"
      787         UPDATE glog
      788         .
      789       if not glog then  return.
      790       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      791       if p-is-stream then
      792       do:
      793         if p-is-append then
      794         do:
      795           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      796         end.
      797         else
      798         do:
      799           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      800         end.
      801       end.
      802       else
      803       do:
      804         if p-is-append then
      805         do:
      806           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      807         end.
      808         else
      809         do:
      810           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      811         end.
      812       end.
      813       p-process = yes.
      814     end.
      815   end procedure.
      816   procedure prn-lib-get-report-name :
