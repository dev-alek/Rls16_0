     2208   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     2209   procedure fltopend_fltopend :
     2210   define input parameter p-parent-handle as handle no-undo .
     2211   define input parameter p-qh as handle no-undo .
     2212   define input parameter p-flt-open-open-query  as character no-undo .
     2213   define input parameter p-where-cond as character no-undo .
     2214   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2215   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2216   define input parameter p-indexed-reposition as character no-undo .
     2217     do
     2218     on error undo, return error
     2219     :
     2220   define variable v-prepare-string as character no-undo .
     2221   define variable glog as logical no-undo .
     2222   assign
     2223   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2224                      p-where-cond + chr(32)  +
     2225                      p-use-indFIRST-query-tail + chr(32) +
     2226                      p-use-ind-sort-clmn-by + chr(32) +
     2227                      p-indexed-reposition
     2228   .
     2229   assign
     2230   glog = p-qh:query-prepare(v-prepare-string) no-error .
     2231   if not glog
     2232   or error-status:error then do:
     2233     message error-status:get-message(1) view-as alert-box .
     2234     undo, return error .
     2235   end.
     2236   assign
     2237   glog = p-qh:query-open no-error .
     2238   if not glog
     2239   or error-status:error then do:
     2240     message error-status:get-message(1) view-as alert-box .
     2241     undo, return error .
     2242   end.
     2243     end.
     2244   end procedure.
     2245   procedure fltopend_fltfindd :
     2246   define input parameter p-parent-handle as handle no-undo .
     2247   define input parameter p-qh as handle no-undo .
     2248   define input parameter p-rowid as rowid no-undo .
     2249   define input parameter p-next as logical no-undo .
     2250   define input parameter p-lock as integer no-undo .
     2251   define input parameter p-bh as handle no-undo .
     2252   define input parameter p-where-cond as character no-undo .
     2253   define input parameter p-use-index-phrase as character no-undo .
     2254   define variable glog as logical no-undo .
     2255   define variable v-qh as handle no-undo .
     2256   define variable v-bh as handle no-undo .
     2257   define variable v-recid as recid no-undo .
     2258   define variable v-prepare-string as character no-undo .
     2259   do
     2260   on error undo, return error
     2261   on stop undo, return error
     2262   :
     2263     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     2264     create buffer v-bh for table p-bh buffer-name p-bh:name.
     2265     create query v-qh.
     2266     v-qh:set-buffers(v-bh).
     2267     v-prepare-string = substitute("for each &1 &2 &3"
     2268                                     ,v-bh:name
     2269                                     ,p-where-cond
     2270                                     ,p-use-index-phrase).
     2271     glog = v-qh:query-prepare(v-prepare-string) no-error.
     2272     if not glog then do:
     2273       delete object v-qh.
     2274       delete object v-bh.
     2275       undo, return error .
     2276     end.
     2277     glog = v-qh:query-open no-error .
     2278     if not glog then do:
     2279       delete object v-qh.
     2280       delete object v-bh.
     2281       undo, return error .
     2282     end.
     2283     if p-next then do:
     2284       v-qh:reposition-to-rowid(p-rowid) no-error .
     2285       glog = v-qh:get-next( p-lock) no-error .
     2286       glog = v-qh:get-next( p-lock) no-error .
     2287       if not glog or v-qh:query-off-end = yes then do:
     2288         glog = v-qh:get-first( p-lock) no-error .
     2289       end.
     2290     end.
     2291     else do:
     2292       glog = v-qh:get-first( p-lock) no-error .
     2293     end.
     2294     v-recid = v-bh:recid no-error .
     2295     delete object v-qh.
     2296     delete object v-bh.
     2297     return string(v-recid) .
     2298   end.
     2299   end procedure.
     2300   procedure fltopend_fltfindq :
     2301   define input parameter p-parent-handle as handle no-undo .
     2302   define input parameter p-qh as handle no-undo .
     2303   define input parameter p-next as logical no-undo .
     2304   define input parameter p-lock as integer no-undo .
     2305   define input parameter p-flt-open-open-query  as character no-undo .
     2306   define input parameter p-where-cond as character no-undo .
     2307   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2308   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2309   define input parameter p-indexed-reposition as character no-undo .
     2310   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     2311   define variable glog as logical no-undo .
     2312   define variable v-qh as handle no-undo .
     2313   define variable v-bh as handle no-undo extent 18.
     2314   define variable v-rowid as rowid no-undo extent 18.
     2315   define variable v-ii as integer no-undo .
     2316   define variable v-prepare-string as character no-undo .
     2317   do
     2318   on error undo, return error
     2319   on stop undo, return error
     2320   :
     2321     create query v-qh.
     2322     do v-ii = 1 to p-qh:num-buffers:
     2323       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     2324       assign
     2325       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     2326       no-error.
     2327       v-qh:add-buffer(v-bh[v-ii]).
     2328     end.
     2329     assign
     2330     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2331                       p-where-cond + chr(32)  +
     2332                       p-use-indFIRST-query-tail + chr(32) +
     2333                       p-use-ind-sort-clmn-by + chr(32) +
     2334                       p-indexed-reposition
     2335     .
     2336     glog = v-qh:query-prepare( v-prepare-string) no-error .
     2337     if not glog then do:
     2338       delete object v-qh.
     2339       do v-ii = 1 to p-qh:num-buffers:
     2340         delete object v-bh[v-ii].
     2341       end.
     2342       undo, return error .
     2343     end.
     2344     glog = v-qh:query-open no-error .
     2345     if not glog then do:
     2346       delete object v-qh.
     2347       do v-ii = 1 to p-qh:num-buffers:
     2348         delete object v-bh[v-ii].
     2349       end.
     2350       undo, return error .
     2351     end.
     2352     if p-next then do:
     2353       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     2354       glog = v-qh:get-next( p-lock) no-error .
     2355       glog = v-qh:get-next( p-lock) no-error .
     2356       if not glog or v-qh:query-off-end = yes then do:
     2357         glog = v-qh:get-first( p-lock) no-error .
     2358       end.
     2359     end.
     2360     else do:
     2361       glog = v-qh:get-first( p-lock) no-error .
     2362     end.
     2363     do v-ii = 1 to p-qh:num-buffers:
     2364       assign
     2365       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     2366       no-error.
     2367     end.
     2368     delete object v-qh.
     2369     do v-ii = 1 to p-qh:num-buffers:
     2370       delete object v-bh[v-ii].
     2371     end.
     2372   end.
     2373   end procedure.
