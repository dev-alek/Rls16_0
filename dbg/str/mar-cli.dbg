      334   define   shared variable g#esys-source-esys as integer no-undo.
      335   define   shared variable g#db-num as integer   no-undo .
      336   define   shared variable g#userid as character no-undo .
      337   define   shared variable g#passwd as character no-undo .
      338   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      339   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
