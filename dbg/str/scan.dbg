     1033             put stream log unformatted "***" mess " - не все количество зарезервировано" skip.
     1034             put stream ler unformatted "***" mess " - не все количество зарезервировано" skip.
     1035       end.
     1036     end.
     1037   end.
     1038   os-delete value (scan-txt).
     1039   end procedure.
     1040   procedure store-place:
     1041   DEFine INPUT PARAMETER pl-str as CHAR NO-UNDO.
     1042   define input parameter parscales-pref as character no-undo.
     1043   define input parameter parpgscales-pref as character no-undo.
     1044   define variable pl-c as int no-undo.
     1045   define variable varres        as logical         no-undo.
     1046   define variable var-code-temp like ub.place.pl-code no-undo.
     1047   define variable varresult   as character       no-undo.
     1048   define variable vartype-bc  as character       no-undo.
     1049   define variable varweight   as decimal         no-undo.
     1050   define buffer pc-goods for ub.goods.
     1051   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     1052   (
     1053    input  parparentproc
     1054   ,input  pl-str
     1055   ,input  ?
     1056   ,input  v-cntxt-obj-type
     1057   ,input  v-cntxt-obj-code
     1058   ,input  yes
     1059   ,input  no
     1060   ,input  parscales-pref
     1061   ,input  parpgscales-pref
     1062   ,output varresult
     1063   ,output vartype-bc
     1064   ,output varweight
     1065   ,buffer ub.bar-code
     1066   ,buffer ub.prod-bc
     1067   ,buffer ub.place
     1068   ) no-error.
     1069   if error-status:error then do:
     1070     return error "Ошибка при разборе бар-кода: " + pl-str.
     1071   end.
     1072   if available place then do:
     1073     find ub.bar-code where ub.bar-code.b-code  = b-c no-lock.
     1074     find first pc-goods where pc-goods.gds-code  = ub.bar-code.gds-code no-lock.
     1075     RUN plgdsfnd (input  no,
     1076                   input  v-cntxt-obj-type,
     1077                   input  v-cntxt-obj-code,
     1078                   input  pc-goods.gds-code,
     1079                   output varres,
     1080                   output var-code-temp) no-error.
     1081     if varres = yes or error-status:error then do:
     1082         put stream log unformatted "***" mess "Нельзя перемещать партии товара по складским местам "
     1083             pc-goods.artic " " pc-goods.prod-type " " pc-goods.prod-code
     1084             " по объкту " v-cntxt-obj-type " " v-cntxt-obj-code " "  skip.
     1085         put stream ler unformatted "***" mess "Нельзя перемещать партии товара по складским местам "
     1086             pc-goods.artic " " pc-goods.prod-type " " pc-goods.prod-code
     1087             " по объкту " v-cntxt-obj-type " " v-cntxt-obj-code " "  skip.
     1088         put stream err unformatted bar-str "," qnty-str "," pl-str skip.
     1089     end.
     1090     else
     1091     for each ub.parts where ub.parts.obj-type  = v-cntxt-obj-type
     1092                      and ub.parts.obj-code  = v-cntxt-obj-code
     1093                      and ub.parts.artic     = pc-goods.artic
     1094                      and ub.parts.prod-type = pc-goods.prod-type
     1095                      and ub.parts.prod-code = pc-goods.prod-code
     1096                      and ub.parts.in-code   = ub.bar-code.in-code
     1097                      and ub.parts.part-code = ub.bar-code.part-code:
     1098       if ub.parts.rsrv-free or
     1099          ub.parts.out-code = t-doc.doc-code then ub.parts.pl-code = ub.place.pl-code.
     1100     end.
     1101   end.
     1102   end procedure.
     1103   procedure plgdsfnd :
     1104     define input  parameter p-chk-and-chs    as logical               no-undo .
     1105     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
     1106     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
     1107     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
     1108     define output parameter p-reserv-pl-code as   logical             no-undo .
     1109     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
     1110     define buffer buf_goods         for ub.goods .
     1111     define buffer buf_pl-gds        for ub.pl-gds .
     1112     define buffer buf_second_pl-gds for ub.pl-gds .
     1113     find first buf_goods no-lock where
     1114                buf_goods.gds-code = p-gds-code no-error .
     1115     if not available buf_goods
     1116     then do:
     1117       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
     1118     end.
     1119   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1120   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1121     (input  p-obj-type
     1122     ,input  p-obj-code
     1123     ,input  buf_goods.artic
     1124     ,input  buf_goods.prod-type
     1125     ,input  buf_goods.prod-code
     1126     ,input  'place-rsrv=request'
     1127     ,output p-reserv-pl-code
     1128     ) no-error .
     1129     if error-status :error
     1130     then do:
     1131       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     1132     end.
     1133     if p-reserv-pl-code = no
     1134     then do:
     1135       return .
     1136     end.
     1137     if p-chk-and-chs <> yes
     1138     then do:
     1139       return .
     1140     end.
     1141     find first buf_pl-gds no-lock where
     1142                buf_pl-gds.obj-type = p-obj-type and
     1143                buf_pl-gds.obj-code = p-obj-code and
     1144                buf_pl-gds.gds-code = p-gds-code no-error .
     1145     if not available buf_pl-gds
     1146     then do:
     1147       return error "К товару не привязано ни одного места хранения" .
     1148     end.
     1149     find first buf_second_pl-gds no-lock where
     1150                buf_second_pl-gds.obj-type  = p-obj-type          and
     1151                buf_second_pl-gds.obj-code  = p-obj-code          and
     1152                buf_second_pl-gds.gds-code  = p-gds-code          and
     1153                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     1154     if not available buf_second_pl-gds
     1155     then do:
     1156       assign
     1157         p-pl-code = buf_pl-gds.pl-code
     1158       .
     1159     end.
     1160     else do:
     1161       run str/plgdssel.p
     1162         (
     1163            input parparentproc
     1164         ,  input p-obj-type
     1165         ,  input p-obj-code
     1166         ,  input p-gds-code
     1167         , output p-pl-code
     1168         ) no-error .
     1169       if error-status :error
     1170       then do:
     1171         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     1172                                , 'plgdssel.p':U
     1173                                , chr(10)
     1174                                , error-status :get-message( 1 )
     1175                                , return-value
     1176                                ) .
     1177       end.
     1178       if p-pl-code = ? or
     1179          p-pl-code = 0
     1180       then do:
     1181         return error "Не выбрано место хранения " + chr(10) .
     1182       end.
     1183     end.
     1184   end procedure.
     1185   if p-name-file = ? then do:
     1186   system-dialog get-file scan-txt
     1187     title "Выберите файл со сканера"
     1188          filters "WorkAbout MS15"         "*.dbs",
     1189                  "WorkAbout"              "*.imp",
     1190                  "Инвентаризация с кассы" "*.inv",
     1191                  "Все файлы"               "*.*"
     1192          update varlog.
     1193   if not varlog then return error.
     1194   end.
     1195   else do:
     1196     scan-txt = p-name-file.
     1197   end.
     1198   if entry (2, scan-txt, ".") = "log" then do:
     1199     message "Файл с расширением '.log' не может быть обработан. Переименуйте его.".
     1200     return error.
     1201   end.
     1202   if entry (2, scan-txt, ".") = "err" then do:
     1203     message "Файл с расширением '.err' не может быть обработан. Переименуйте его.".
     1204     return error.
     1205   end.
     1206   if entry (2, scan-txt, ".") = "ler" then do:
     1207     message "Файл с расширением '.ler' не может быть обработан. Переименуйте его.".
     1208     return error.
     1209   end.
     1210   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
     1211                           input 'scanfile':U ,
     1212                          output varvalue ,
     1213                          output vartype ) no-error .
     1214   if lookup (scan-txt, varvalue) <> 0 then do:
     1215     message "Файл с названием " scan-txt " уже загружался в документ " t-doc.doc-code " ." skip
     1216             "Продолжить?" view-as alert-box question buttons yes-no update varlog.
     1217     if varlog <> yes then do:
     1218       return error.
     1219     end.
     1220   end.
     1221   else do:
     1222     assign
     1223       varline-file = varvalue + min (",", varvalue) + scan-txt no-error.
     1224   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t-doc.doc-code ,
     1225                          input 'scanfile':U ,
     1226                          input varline-file ) no-error .
     1227   end.
     1228     assign
     1229       v-pri-nakl- = false
     1230       v-silent    = false
     1231       v-first-del = false
     1232     .
     1233     run cb_is-silent in v-upperhandl (output v-silent )  no-error .
     1234     if v-silent then do:
     1235        v-num = 1.
     1236     end.
     1237     else do:
     1238       if t-doc.ext-doc-type = 'ie':U
     1239         and t-doc.status_  = 'накл':U
     1240         and t-doc.flag_    = no
     1241       then do:
     1242         assign
     1243           v-pri-nakl- = true
     1244         .
     1245       end.
     1246       run gbl/d-askw.w
     1247         ( input "Вопрос"
     1248         , input "Выберите режим работы для обработки файла." + chr(10)
     1249         , input "|^"
     1250         , input "Переписать|Прибавить|Спрашивать|"
     1251                + (if v-pri-nakl- = true then "Обнулить|" else "":U)
     1252                + "Отмена"
     1253         , input "Переписать количество со сканера для всех товаров|"
     1254               + "Прибавить количество со сканера для всех товаров|"
     1255               + "Cпрашивать для каждого товара|"
     1256               + (if v-pri-nakl- = true then "Удалить все строки и загрузить со сканера|" else "":U)
     1257               + "Отменить"
     1258         , input 1
     1259         , input (if v-pri-nakl- = true then 5 else 4 )
     1260         , output v-num
     1261         ).
     1262     end.
     1263     case v-num :
     1264       when 1 then do:
     1265         assign is-all = yes.
     1266       end.
     1267       when 2 then do:
     1268         assign is-all = no.
     1269       end.
     1270       when 3 then do:
     1271         assign is-all = ?.
     1272       end.
     1273       when 4 then do:
     1274         if v-pri-nakl- = true then do:
     1275           assign
     1276             is-all = yes
     1277             v-first-del = true
     1278           .
     1279         end.
     1280         else do:
     1281           return error.
     1282         end.
     1283       end.
     1284       otherwise do:
     1285         return error.
     1286       end.
     1287     end case.
     1288   scan-name = entry (1, scan-txt, ".").
     1289   frame a :title = "Разбор файла : " + scan-txt.
     1290   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1291   empty temp-table thbjattr_thbj-attr.
     1292   run adm/shattri.p (
     1293      input "get":U
     1294     ,input ''
     1295     ,input 0
     1296     ,input 'nakl-glob':U
     1297     ,input  ""
     1298     ,output v-value-character
     1299     ,output v-value-date
     1300     ,output v-value-decimal
     1301     ,output v-value-integer
     1302     ,output v-value-logical
     1303     ,output par-type
     1304     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1305     ) no-error .
     1306   for each thbjattr_thbj-attr :
     1307       if thbjattr_thbj-attr.prop-code = 'noapndsc' then varnoapnd = thbjattr_thbj-attr.property-value-logical  .
     1308   end.
     1309   if varnoapnd then do:
     1310     output stream log to value (scan-name + ".log").
     1311     output stream err to value (scan-name + ".err").
     1312     output stream ler to value (scan-name + ".ler").
     1313   end.
     1314   else do:
     1315     output stream log to value (scan-name + ".log") append.
     1316     output stream err to value (scan-name + ".err") append.
     1317     output stream ler to value (scan-name + ".ler") append.
     1318   end.
     1319   put stream log unformatted "  " skip.
     1320   put stream log unformatted cur-time-string-sec() skip.
     1321   put stream ler unformatted "  " skip.
     1322   put stream ler unformatted cur-time-string-sec() skip.
     1323   if add-sens = ? then
     1324     put stream log unformatted " " skip skip "Привязка партий к складским местам.  Объект : " v-cntxt-obj-type " " string (v-cntxt-obj-code) skip skip.
     1325   else do:
     1326     put stream log unformatted " " skip skip "Накладная: " t-doc.doc-code
     1327           " Тип: " t-doc.doc-type string (t-doc.internal, "внутр/внешн") " Статус: " t-doc.status_ " ОК: " string (t-doc.flag_, "+/-") skip skip.
     1328     put stream ler unformatted " " skip skip "Накладная: " t-doc.doc-code
     1329           " Тип: " t-doc.doc-type string (t-doc.internal, "внутр/внешн") " Статус: " t-doc.status_ " ОК: " string (t-doc.flag_, "+/-") skip skip.
     1330     find first doc-line where doc-line.doc-code = t-doc.doc-code no-lock no-error.
     1331     if available doc-line then do:
     1332       find goods where goods.artic = doc-line.artic
     1333                    and goods.prod-type = doc-line.prod-type
     1334                    and goods.prod-code = doc-line.prod-code no-lock.
     1335       g-type =  goods.gds-type.
     1336     end.
     1337   end.
     1338   view frame a.
     1339   input stream cur from value (scan-txt).
     1340   if t-doc.doc-type = 'инв':U and
     1341      t-doc.status_  = 'разрешен':U and
     1342      add-sens       = ?            then do:
     1343     return.
     1344   end.
     1345   if t-doc.doc-type = 'инв':U and
     1346      t-doc.status_  = 'разрешен':U then do:
     1347     put stream log unformatted " " skip skip "!!! Инвентаризация: " t-doc.doc-code
     1348           " подсчет суммарных количеств для одинаковых кодов." skip skip.
     1349   end.
     1350   else do:
     1351     put stream log unformatted " " skip skip "!!! Складской документ: " t-doc.doc-code
     1352           " подсчет суммарных количеств для одинаковых кодов." skip skip.
     1353   end.
     1354   for each un-bc on error undo, return error return-value :
     1355       delete un-bc.
     1356   end.
     1357   run str/bc-anlz.p (parParentProc , "file", scan-txt, yes, output varerr, output table in-bc) no-error.
     1358   if error-status:error then do:
     1359      message "Ошибка при обработке файла сканера." skip
     1360              error-status:get-message(1)
     1361         view-as alert-box error buttons ok.
     1362      return error.
     1363   end.
     1364   if varerr = yes then is-err = yes.
     1365   define variable vari    as integer no-undo.
     1366   define variable vartime as integer no-undo.
     1367   run waitfram-show in this-procedure ("Записываем результат разбора сканерного файла в log-файл.").
     1368   assign
     1369     vari    = 0.
     1370     vartime = time.
     1371   for each in-bc on error undo, return error return-value :
     1372       assign
     1373         vari = vari + 1.
     1374       run waitfram-show in this-procedure (substitute("Записываем ошибки разбора сканерного файла в файлы. Всего проверено на ошибки &1. Время &2.", vari, string (time - vartime, "hh:mm:ss"))).
     1375       if in-bc.rez = "err" then do:
     1376          put stream log unformatted in-bc.err-msg skip.
     1377          put stream ler unformatted in-bc.err-msg skip.
     1378          put stream err unformatted in-bc.bar-str skip.
     1379          assign is-err = yes.
     1380       end.
     1381       if in-bc.des <> "" and in-bc.des <> ? then put stream log unformatted in-bc.des.
     1382   end.
     1383   for each un-bc on error undo, return error return-value :
     1384       assign
     1385         vari = vari + 1.
     1386       run waitfram-show in this-procedure (substitute("Записываем ошибки разбора сканерного файла в файлы. Всего проверено на ошибки &1. Время &2.", vari, string (time - vartime, "hh:mm:ss"))).
     1387       if un-bc.rez = "err" then do:
     1388          put stream log unformatted un-bc.err-msg skip.
     1389          put stream ler unformatted un-bc.err-msg skip.
     1390          put stream err unformatted un-bc.bar-code ", " un-bc.file-qnty skip.
     1391          assign is-err = yes.
     1392       end.
     1393   end.
     1394   if v-first-del = true then do:
     1395     for each bb_doc-line
     1396       where bb_doc-line.doc-code = t-doc.doc-code
     1397     on error undo, return error return-value
     1398     :
     1399       delete bb_doc-line .
     1400     end.
     1401   end.
     1402   if t-doc.doc-type = 'при':U
     1403     and t-doc.status_  = 'накл':U
     1404     and t-doc.flag_    = yes
     1405   then do:
     1406     run waitfram-show in this-procedure ("Строим таблицу сравнения по загруженой информации из файла.").
     1407     for each bb_doc-line where bb_doc-line.doc-code = t-doc.doc-code no-lock on error undo, return error return-value :
     1408       find first bb_goods where bb_goods.artic     = bb_doc-line.artic     and
     1409                                 bb_goods.prod-type = bb_doc-line.prod-type and
     1410                                 bb_goods.prod-code = bb_doc-line.prod-code no-lock.
     1411       find first bb_gds-prt where bb_gds-prt.upper-code = bb_goods.prt-root no-lock.
     1412       if bb_gds-prt.node-name = '_Пустая шкала':U then do:
     1413         find first bb_bar-code where bb_bar-code.gds-code  = bb_goods.gds-code    and
     1414                                      bb_bar-code.node-code = bb_gds-prt.node-code and
     1415                                      bb_bar-code.part-code = ""                   and
     1416                                      bb_bar-code.in-code   = ""                   and
     1417                                      bb_bar-code.unit-cli  = bb_goods.unit-base   no-lock.
     1418         create tt-bar-code-doc.
     1419         assign
     1420           tt-bar-code-doc.b-c      = bb_bar-code.b-code
     1421           tt-bar-code-doc.scn-qnty = bb_doc-line.doc-qnty.
     1422         create tt-bar-code-ne.
     1423         assign
     1424           tt-bar-code-ne.nm            = 0
     1425           tt-bar-code-ne.mark          = "d"
     1426           tt-bar-code-ne.b-c           = bb_bar-code.b-code
     1427           tt-bar-code-ne.scn-qnty-doc  = bb_doc-line.doc-qnty
     1428           tt-bar-code-ne.scn-qnty-file = 0
     1429           tt-bar-code-ne.artic         = bb_goods.artic
     1430           tt-bar-code-ne.prod-type     = bb_goods.prod-type
     1431           tt-bar-code-ne.prod-code     = bb_goods.prod-code
     1432           tt-bar-code-ne.gds-name      = bb_goods.gds-name
     1433           tt-bar-code-ne.node-name     = "--------------------"
     1434           tt-bar-code-ne.in-code       = ""
     1435           tt-bar-code-ne.part-code     = "".
     1436       end.
     1437       else do:
     1438         for each bb_gds-dtl where bb_gds-dtl.doc-code  = bb_doc-line.doc-code  and
     1439                                   bb_gds-dtl.artic     = bb_doc-line.artic     and
     1440                                   bb_gds-dtl.prod-type = bb_doc-line.prod-type and
     1441                                   bb_gds-dtl.prod-code = bb_doc-line.prod-code no-lock on error undo, return error return-value :
     1442            find first bb_gds-prt where bb_gds-prt.node-code = bb_gds-dtl.prt-code no-lock.
     1443            find first bb_bar-code where bb_bar-code.gds-code  = bb_goods.gds-code    and
     1444                                         bb_bar-code.node-code = bb_gds-prt.node-code and
     1445                                         bb_bar-code.part-code = ""                   and
     1446                                         bb_bar-code.in-code   = ""                   and
     1447                                         bb_bar-code.unit-cli  = bb_goods.unit-base   no-lock.
     1448            create tt-bar-code-doc.
     1449            assign
     1450              tt-bar-code-doc.b-c      = bb_bar-code.b-code
     1451              tt-bar-code-doc.scn-qnty = bb_doc-line.doc-qnty.
     1452            create tt-bar-code-ne.
     1453            assign
     1454              tt-bar-code-ne.nm            = 0
     1455              tt-bar-code-ne.mark          = "d"
     1456              tt-bar-code-ne.b-c           = bb_bar-code.b-code
     1457              tt-bar-code-ne.scn-qnty-doc  = bb_gds-dtl.doc-qnty
     1458              tt-bar-code-ne.scn-qnty-file = 0
     1459              tt-bar-code-ne.artic         = bb_goods.artic
     1460              tt-bar-code-ne.prod-type     = bb_goods.prod-type
     1461              tt-bar-code-ne.prod-code     = bb_goods.prod-code
     1462              tt-bar-code-ne.gds-name      = bb_goods.gds-name
     1463              tt-bar-code-ne.node-name     = bb_gds-prt.node-name
     1464              tt-bar-code-ne.in-code       = ""
     1465              tt-bar-code-ne.part-code     = "".
     1466         end.
     1467       end.
     1468     end.
     1469     assign
     1470       varanlz = yes.
     1471     for each main-bc on error undo, return error return-value :
     1472       if main-bc.scn-pl <> "" then do:
     1473         assign
     1474           varanlz = no.
     1475       end.
     1476       find first bb_bar-code where bb_bar-code.b-code = main-bc.b-c no-lock.
     1477       if bb_bar-code.in-code   <> "" or
     1478          bb_bar-code.part-code <> "" then do:
     1479          message "В файле экспорте есть бар-код, cоответствующий бар-коду партии " bb_bar-code.b-code " ." skip
     1480                  "По данному бар-коду невозможно произвести сравнительный анализ. Он будет выведен отдельной строкой в таблицу анализа."
     1481          view-as alert-box.
     1482       end.
     1483       find first tt-bar-code-ne where tt-bar-code-ne.b-c = bb_bar-code.b-code no-error.
     1484       if not available tt-bar-code-ne then do:
     1485         find first bb_goods where bb_goods.gds-code = bb_bar-code.gds-code no-lock.
     1486         find first bb_gds-prt where bb_gds-prt.upper-code = bb_goods.prt-root no-lock.
     1487         create tt-bar-code-ne.
     1488         if bb_gds-prt.node-name = '_Пустая шкала':U then do:
     1489           assign
     1490             tt-bar-code-ne.nm            = -1
     1491             tt-bar-code-ne.mark          = (if bb_bar-code.in-code <> "" or bb_bar-code.part-code <> "" then "?" else "f")
     1492             tt-bar-code-ne.b-c           = bb_bar-code.b-code
     1493             tt-bar-code-ne.scn-qnty-doc  = 0
     1494             tt-bar-code-ne.scn-qnty-file = main-bc.scn-qnty
     1495             tt-bar-code-ne.artic         = bb_goods.artic
     1496             tt-bar-code-ne.prod-type     = bb_goods.prod-type
     1497             tt-bar-code-ne.prod-code     = bb_goods.prod-code
     1498             tt-bar-code-ne.gds-name      = bb_goods.gds-name
     1499             tt-bar-code-ne.node-name     = "------------------"
     1500             tt-bar-code-ne.in-code       = bb_bar-code.in-code
     1501             tt-bar-code-ne.part-code     = bb_bar-code.part-code.
     1502         end.
     1503         else do:
     1504           find first bb_gds-prt where bb_gds-prt.node-code = bb_bar-code.node-code no-lock.
     1505           assign
     1506             tt-bar-code-ne.nm            = main-bc.nm
     1507             tt-bar-code-ne.mark          = (if bb_bar-code.in-code <> "" or bb_bar-code.part-code <> "" then "?" else "f")
     1508             tt-bar-code-ne.b-c           = bb_bar-code.b-code
     1509             tt-bar-code-ne.scn-qnty-doc  = 0
     1510             tt-bar-code-ne.scn-qnty-file = main-bc.scn-qnty
     1511             tt-bar-code-ne.artic         = bb_goods.artic
     1512             tt-bar-code-ne.prod-type     = bb_goods.prod-type
     1513             tt-bar-code-ne.prod-code     = bb_goods.prod-code
     1514             tt-bar-code-ne.gds-name      = bb_goods.gds-name
     1515             tt-bar-code-ne.node-name     = bb_gds-prt.node-name
     1516             tt-bar-code-ne.in-code       = bb_bar-code.in-code
     1517             tt-bar-code-ne.part-code     = bb_bar-code.part-code.
     1518         end.
     1519       end.
     1520       else do:
     1521         assign
     1522           tt-bar-code-ne.nm            = main-bc.nm
     1523           tt-bar-code-ne.mark          = (if tt-bar-code-ne.scn-qnty-doc = main-bc.scn-qnty then "" else (if tt-bar-code-ne.scn-qnty-doc > main-bc.scn-qnty then "<" else ">"))
     1524           tt-bar-code-ne.scn-qnty-file = main-bc.scn-qnty.
     1525       end.
     1526     end.
     1527     if varanlz = yes then do:
     1528       run str/scr-neb.w (input parparentproc, input-output table tt-bar-code-ne, input scan-name, input no, input v-cntxt-obj-type, input v-cntxt-obj-code).
     1529     end.
     1530   end.
     1531   run waitfram-hide in this-procedure.
     1532   assign
     1533     i    = 0
     1534     j    = 0
     1535     .
     1536   define buffer buf_gds-obj for ub.gds-obj  .
     1537   find first buf_gds-obj no-lock where
     1538              buf_gds-obj.obj-type = t-doc.obj-type and
     1539              buf_gds-obj.obj-code = t-doc.obj-code and
     1540              buf_gds-obj.gds-code = goods.gds-code no-error .
     1541   if available buf_gds-obj and buf_gds-obj.cash-parts then do:
     1542   for each anlz-bc on error undo, return error return-value :
     1543     i = i + 1.
     1544     display i with frame a.
     1545     find first bar-code where bar-code.b-code   = anlz-bc.b-c        no-lock.
     1546     find first goods    where goods.gds-code    = bar-code.gds-code  no-lock.
     1547     assign bar-str  = string( anlz-bc.b-c)
     1548            qnty-str = string( anlz-bc.scn-qnty)
     1549            rate     = 1
     1550            pl-str   = anlz-bc.scn-pl
     1551            mess     = anlz-bc.des.
     1552     run proc-code in this-procedure (input anlz-bc.scn-pl
     1553                                     ,input (if anlz-bc.rez = "place" then "place" else "")
     1554                                     ,input varscales-pref
     1555                                     ,input varpgscales-pref
     1556                                     ) no-error.
     1557     if error-status:error then do:
     1558        assign is-err = yes.
     1559     end.
     1560     else do:
     1561       assign
     1562         j = j + 1.
     1563       display j with frame a.
     1564     end.
     1565   end.
     1566   end.
     1567   else do:
     1568   for each main-bc on error undo, return error return-value :
     1569     i = i + 1.
     1570     display i with frame a.
     1571     find first bar-code where bar-code.b-code   = main-bc.b-c        no-lock.
     1572     find first goods    where goods.gds-code    = bar-code.gds-code  no-lock.
     1573   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1574     (
     1575        input goods.artic
     1576     ,  input goods.prod-type
     1577     ,  input goods.prod-code
     1578     , output varis-petrolium
     1579     , output varis-pieces
     1580     ) .
     1581     find first gds-prt  where gds-prt.node-code = bar-code.node-code no-lock.
     1582     if gds-prt.is-term <> yes then do:
     1583       put stream log unformatted "Бар-код " bar-code.b-code " не является кодом терминального признака." skip.
     1584       put stream ler unformatted "Бар-код " bar-code.b-code " не является кодом терминального признака." skip.
     1585       put stream err unformatted main-bc.b-c ", " main-bc.scn-qnty skip.
     1586       assign is-err = yes.
     1587       next.
     1588     end.
     1589     assign bar-str  = string(main-bc.b-c)
     1590            qnty-str = string(main-bc.scn-qnty)
     1591            rate     = 1
     1592            pl-str   = main-bc.scn-pl
     1593            mess     = main-bc.des.
     1594     run proc-code in this-procedure (input main-bc.scn-pl
     1595                                     ,input (if main-bc.rez = "place" then "place" else "")
     1596                                     ,input varscales-pref
     1597                                     ,input varpgscales-pref
     1598                                     ) no-error.
     1599     if error-status:error then do:
     1600        assign is-err = yes.
     1601     end.
     1602     else do:
     1603       assign
     1604         j = j + 1.
     1605       display j with frame a.
     1606     end.
     1607   end.
     1608   end.
     1609   output stream log close.
     1610   output stream err close.
     1611   output stream ler close.
     1612   output stream cur close.
     1613   if is-err then do:
     1614       message "Во время загрузки файла:" scan-txt "обнаружены ошибки." skip
     1615               "Смотрите ler файл."
     1616       view-as alert-box error buttons ok.
     1617       if search (scan-name + ".ler") <> ? then do:
     1618         run gbl/prnfilen.w
     1619           (input  substitute("Ошибки, обнаруженные во время загрузки файла &1", scan-txt)
     1620           ,input  0
     1621           ,input  scan-name + ".ler"
     1622           ,input  7
     1623           ,output v-user-action
     1624           ,output v-printed
     1625           ).
     1626       end.
     1627   end.
