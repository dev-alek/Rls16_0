       97   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       98   procedure cur-time :
       99      define output parameter p-today as date      no-undo .
      100      define output parameter p-time  as integer   no-undo .
      101     do
      102     on error undo, return error
      103     :
      104       define variable v-date1 as date      no-undo .
      105       define variable v-date2 as date      no-undo .
      106       define variable v-time  as integer   no-undo .
      107       assign
      108         v-date1 = today
      109         v-time  = time
      110         v-date2 = today
      111       .
      112       if v-date1 <> v-date2
      113       then do:
      114         assign
      115           v-date1 = today
      116           v-time  = v-time
      117         .
      118       end.
      119       assign
      120         p-today = v-date1
      121         p-time  = v-time
      122       .
      123     end.
      124   end.
      125   function cur-time-date returns character
      126   :
      127     return string(today, '99/99/9999':U) .
      128   end.
      129   function cur-time-mjd returns decimal
      130   :
      131     define variable v-date as date      no-undo .
      132     define variable v-time as integer   no-undo .
      133     run cur-time in this-procedure
      134       (output v-date
      135       ,output v-time
      136       ) .
      137     return integer(v-date) - 2400002 + (v-time / 86400) .
      138   end.
      139   function cur-time-get-ending-index returns integer
      140   (input p-number as integer
      141   )
      142   :
      143     if p-number < 0
      144     or p-number = ?
      145     then do:
      146       return 1 .
      147     end.
      148     define variable v-rest as integer   no-undo .
      149     assign
      150       p-number = p-number modulo 100
      151     .
      152     if p-number < 20
      153     then do:
      154       assign
      155         v-rest = p-number
      156       .
      157     end.
      158     else do:
      159       assign
      160         v-rest = p-number modulo 10
      161       .
      162     end.
      163     case v-rest :
      164       when 1
      165       then do:
      166         return 2 .
      167       end.
      168       when 2 or
      169       when 3 or
      170       when 4
      171       then do:
      172         return 3 .
      173       end.
      174       otherwise do:
      175         return 1 .
      176       end.
      177     end case .
      178   end.
      179   procedure cur-time-mjd-to-date :
      180      define input  parameter i-mjd-diff as decimal no-undo.
      181      define output parameter o-Date     as date    no-undo.
      182      define output parameter o-Time     as integer no-undo.
      183      define variable v-day-number as integer   no-undo .
      184      if    i-mjd-diff < 0
      185         or i-mjd-diff = ?
      186      then do:
      187         return "?" .
      188      end.
      189      assign
      190         v-day-number = truncate(i-mjd-diff,0).
      191         o-Date = date(v-day-number + 2400002).
      192         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      193     .
      194   end.
      195   function cur-time-mjd-to-string returns character
      196   (input p-mjd-diff as decimal
      197   )
      198   :
      199     define variable v-day-number as integer   no-undo .
      200     define variable v-seconds    as integer   no-undo .
      201     define variable v-hour       as integer   no-undo .
      202     define variable v-min        as integer   no-undo .
      203     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      204     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      205     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      206     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      207     if p-mjd-diff < 0
      208     or p-mjd-diff = ?
      209     then do:
      210       return "?" .
      211     end.
      212     assign
      213       v-day-number = integer(truncate(p-mjd-diff,0))
      214       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      215     .
      216     if v-seconds > 86400
      217     then do:
      218       assign
      219         v-seconds = 86400 - 1
      220       .
      221     end.
      222     if v-seconds < 0
      223     then do:
      224       assign
      225         v-seconds = 0
      226       .
      227     end.
      228     assign
      229       v-hour = truncate(v-seconds / 3600, 0)
      230     .
      231     assign
      232       v-seconds = v-seconds modulo 3600
      233     .
      234     assign
      235       v-min = truncate(v-seconds / 60, 0)
      236     .
      237     assign
      238       v-seconds = v-seconds modulo 60
      239     .
      240     return
      241         (if v-day-number <> 0
      242           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      243           else ""
      244         )
      245       + (if v-day-number <> 0 or v-hour <> 0
      246           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      247           else ""
      248         )
      249       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      250           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      251           else ""
      252         )
      253       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      254       .
      255   end.
      256   function cur-time-string returns character
      257   :
      258     define variable v-date as date      no-undo .
      259     define variable v-time as integer   no-undo .
      260     run cur-time in this-procedure
      261       (output v-date
      262       ,output v-time
      263       ) .
      264     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      265   end.
      266   function cur-time-string-sec returns character
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      275   end.
      276   function cur-time-custom  returns character
      277   (input p-prefix as character
      278   ,input p-date-format as character
      279   ,input p-delimiter as character
      280   ,input p-time-format as character
      281   ,input p-suffix as character
      282   )
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return
      291       p-prefix
      292       + string(v-date, p-date-format)
      293       + p-delimiter
      294       + string(v-time, p-time-format)
      295       + p-suffix
      296       .
      297   end.
      298   function cur-time-print  returns character
      299   :
      300     define variable v-date as date      no-undo .
      301     define variable v-time as integer   no-undo .
      302     run cur-time in this-procedure
      303       (output v-date
      304       ,output v-time
      305       ) .
      306     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      307   end.
      308   function cur-time-datetime returns datetime
      309   :
      310     define variable v-char as character no-undo .
      311     define variable v-datetime as datetime no-undo .
      312     v-char = cur-time-string().
      313     v-datetime = datetime(v-char).
      314     return  v-datetime.
      315   end.
      316   function cur-time-string-msec returns character
      317   :
      318     define variable v-date as datetime  no-undo .
      319     v-date = now.
      320     return string(v-date) .
      321   end.
      322   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      323   define variable v-waitfram-action01         as character   no-undo .
      324   define variable v-waitfram-action02         as character   no-undo .
      325   define variable v-waitfram-action03         as character   no-undo .
      326   define variable mWaitFramTextBeg            as character   no-undo.
      327   define variable mWaitFramTextEnd            as character   no-undo.
      328   define variable mWaitFramView               as logical     no-undo.
      329   define variable mWaitProcEvent              as logical     no-undo init yes.
      330   define variable mWaitFramInterval           as integer     no-undo init 1 .
      331   define variable mWaitFramStop               as logical     no-undo.
      332   define variable mWaitFramStopUser           as logical     no-undo.
      333   define variable mWaitFramStopTimeOut        as logical     no-undo.
      334   define variable mWaitFramStartProc          as datetime-tz no-undo.
      335   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      336   define button B-WaitFramStop auto-end-key
      337        label "Стоп"
      338        size 10 by 1 tooltip "Остоновить процесс".
      339   define button B-viewProcInfo
      340        label "Информация"
      341        size 15 by 1 tooltip "Информация о процесс".
      342   define frame waitfram
      343     v-waitfram-action01 format "x(72)" no-label skip
      344     v-waitfram-action02 format "x(72)" no-label skip
      345     v-waitfram-action03 format "x(72)" no-label skip
      346     B-viewProcInfo
      347     B-WaitFramStop at row 4 col 30
      348     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      349     .
      350   define new global shared variable mBatchMode as logical no-undo init ?.
      351   define variable mFramBachModHandle as handle no-undo.
      352   mFramBachModHandle = frame waitfram:handle.
      353   define variable mFameOldVis as logical no-undo.
      354   define variable mVisCUrentVin as logical no-undo.
      355   if session:batch-mode
      356   then
      357      mBatchMode = yes.
      358   if mBatchMode = ? then do:
      359     mVisCUrentVin = current-window:visible.
      360     mFameOldVis = mFramBachModHandle:visible.
      361     mFramBachModHandle:visible  = yes.
      362     mBatchMode = mFramBachModHandle:visible ne yes.
      363     mFramBachModHandle:visible = mFameOldVis.
      364     current-window:visible = mVisCUrentVin.
      365   end.
      366    if  log-manager:logfile-name ne ?
      367     then DO:
      368         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      369         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      370         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      371     end.
      372   on choose of B-WaitFramStop in frame waitfram
      373   do:
      374     mWaitFramStop = yes.
      375     mWaitFramStopUser = yes.
      376   end.
      377   function waitfram-check-timeout returns logical():
      378      define variable vtime as int64 no-undo.
      379      if mWaitFramStopTimeOut
      380      then
      381         return yes.
      382      vtime = ( now - mWaitFramStartProc ) / 1000 .
      383      if     mWaitFramTimeOut ne ?
      384         and mWaitFramTimeOut ne 0
      385         and mWaitFramTimeOut lt vtime
      386      then do:
      387         mWaitFramStopTimeOut = yes.
      388      end.
      389      return mWaitFramStopTimeOut.
      390   end.
      391   procedure waitfram-hide :
      392     if not session:batch-mode
      393     then do
      394     on error undo, return error return-value
      395     :
      396       pause 0 before-hide .
      397       if not mBatchMode then
      398         hide frame waitfram .
      399     end.
      400   end procedure.
      401   procedure waitfram-show :
      402     define input  parameter p-message as character no-undo .
      403     define variable v-left-margin as integer   no-undo .
      404     if not session:batch-mode
      405     then do
      406     on error undo, return error return-value
      407     :
      408       if length(p-message) <= 70 then do:
      409         assign
      410           v-left-margin = integer((70 - length(p-message)) / 2)
      411         .
      412         assign
      413           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      414         .
      415         assign
      416           v-waitfram-action01 = " "
      417           v-waitfram-action02 = " "
      418                                    + fill(" ", v-left-margin)
      419                                    + p-message
      420           v-waitfram-action03 = " "
      421         .
      422       end.
      423       else do:
      424         define variable vRindex1 as integer no-undo.
      425         define variable vRindex2 as integer no-undo.
      426         vRindex1 = r-index(p-message," ",70).
      427         if vRindex1 = 0
      428         then
      429            vRindex1 = 70.
      430         if length(p-message)  <= vRindex1 + 70 then do:
      431           assign
      432             v-waitfram-action01 = " "
      433             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      434             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      435           .
      436         end.
      437         else do:
      438           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      439           if vRindex2 <= vRindex1
      440           then
      441              vRindex2 = vRindex1 + 70.
      442           assign
      443             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      444             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      445             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      446           .
      447         end.
      448       end.
      449       B-viewProcInfo:visible   in frame waitfram = no.
      450       B-viewProcInfo:sensitive in frame waitfram = no.
      451       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      452       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      453       if  (   mWaitFramView
      454          or  mWaitProcEvent)
      455          and not mBatchMode
      456       then
      457          display
      458             v-waitfram-action01 skip
      459             v-waitfram-action02 skip
      460             v-waitfram-action03 skip
      461          with frame waitfram .
      462     end.
      463   end procedure.
      464      procedure waitfram-show-this:
      465         define input  parameter iInterval as int64 no-undo.
      466         define variable vtime as int64 no-undo.
      467         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      468         mWaitFramInterval = iInterval.
      469         run waitfram-show (substitute("&1&2 &3&4" ,
      470                                       mWaitFramTextBeg ,
      471                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      472                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      473                                       mWaitFramTextEnd
      474                                      )
      475                           ).
      476      end.
      477      procedure WaitFramRunPause:
      478         define input  parameter iInterval as dec no-undo.
      479         define variable vStart  as datetime-tz no-undo.
      480         define variable vend    as datetime-tz no-undo.
      481         define variable vint as int64 no-undo.
      482         define variable vOk as logical no-undo.
      483         vStart = now.
      484         vend   = vStart.
      485         publish "WaitFramPause" (iInterval,output vOk).
      486         vend   =  now.
      487         vint = vend - vStart.
      488         vint = iInterval - vint / 1000.
      489         if     not mWaitFramStop
      490            and (   vint > 0
      491                 or (    not vOk
      492                     and iInterval eq ?
      493                     )
      494                 )
      495         then
      496            run waitfram-show-this (iInterval).
      497         vend   =  now.
      498         vint = vend - vStart.
      499         vint = iInterval - vint / 1000.
      500         if     not mWaitFramStop
      501            and vint > 0
      502         then do:
      503            run gbl/pause.p (vint * 1000).
      504         end.
      505         if iInterval ne ?
      506         then
      507            publish "WaitFramStop".
      508         waitfram-check-timeout().
      509      end.
      510      procedure WaitFramWaitFor:
      511         define input  parameter iInterval as dec no-undo.
      512         assign
      513            mWaitFramStartProc   = now
      514            mWaitFramStopUser    = no
      515            mWaitFramStopTimeOut = no
      516         .
      517         block-wait:
      518         do while not mWaitFramStop:
      519            run WaitFramRunPause (iInterval).
      520            if  waitfram-check-timeout()
      521            then do:
      522               leave block-wait.
      523            end.
      524         end.
      525         run waitfram-hide.
      526      end.
      527   procedure waitfram-join :
      528     define input  parameter p-line-1  as character no-undo .
      529     define input  parameter p-line-2  as character no-undo .
      530     define input  parameter p-line-3  as character no-undo .
      531     define output parameter p-message as character no-undo .
      532     do
      533     on error undo, return error return-value
      534     :
      535       assign
      536         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      537                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      538                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      539       .
      540     end.
      541   end procedure.
      542   function waitfram-join-function returns character
      543     (input p-line-1 as character
      544     ,input p-line-2 as character
      545     ,input p-line-3 as character
      546     ).
      547     define variable v-message as character no-undo .
      548     run waitfram-join in this-procedure
      549       (input  p-line-1
      550       ,input  p-line-2
      551       ,input  p-line-3
      552       ,output v-message
      553       ) .
      554     return v-message .
      555   end function .
      556   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      557   define new global shared variable g#trdcalib as handle no-undo.
