      747   index pi is primary b-c.
      748   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      749   define temp-table tt-bar-code-ne no-undo
      750   field nm            as integer
      751   field mark          as character
      752   field b-c           as integer
      753   field scn-qnty-doc  as decimal
      754   field scn-qnty-file as decimal
      755   field mem-qnty      as decimal
      756   field bef-qnty      as decimal
      757   field artic         like ub.goods.artic
      758   field prod-type     like ub.goods.prod-type
      759   field prod-code     like ub.goods.prod-code
      760   field gds-name      like ub.goods.gds-name
      761   field node-name     like ub.gds-prt.node-name
      762   field part-code     like ub.bar-code.part-code
      763   field in-code       like ub.bar-code.in-code
      764   index pi is primary nm
      765   index b-c is unique b-c.
      766   define frame a
      767       i format ">>>>9" label "Просмотрено" space (20) skip
      768       j format ">>>>9" label "Обработано"
      769       with view-as dialog-box side-labels three-d title "".
      770   def var mess as char no-undo.
      771   procedure check-code:
      772   define input parameter parbar-str AS char no-undo.
      773   define input parameter parprice   like ub.gds-dtl.price-base no-undo.
      774   define input parameter parqnty    as dec no-undo.
      775   define input  parameter parg#doc-prt as logical no-undo.
      776   define input  parameter parscales-pref as character no-undo.
      777   define input  parameter parpgscales-pref as character no-undo.
      778   define output parameter parplace   as log initial no no-undo.
      779   define output parameter parb-c     as int no-undo.
      780   define output parameter parrate    as dec no-undo.
      781   define variable varresult   as character       no-undo.
      782   define variable vartype-bc  as character       no-undo.
      783   define variable varweight   as decimal         no-undo.
      784   def buffer b-bar-code for ub.bar-code.
      785   ASSIGN mess = " Код: " + parbar-str + " количество: " + string (parqnty) + " ".
      786   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
      787   (
      788    input  parparentproc
      789   ,input  parbar-str
      790   ,input  parprice
      791   ,input  v-cntxt-obj-type
      792   ,input  v-cntxt-obj-code
      793   ,input  yes
      794   ,input  no
      795   ,input  parscales-pref
      796   ,input  parpgscales-pref
      797   ,output varresult
      798   ,output vartype-bc
      799   ,output varweight
      800   ,buffer ub.bar-code
      801   ,buffer ub.prod-bc
      802   ,buffer ub.place
      803   ) no-error.
      804   if error-status:error then do:
      805     return error "Ошибка при разборе бар-кода: " + parbar-str.
      806   end.
      807   if not available bar-code THEN DO:
      808      if add-sens = ? and available place
      809      then DO: parPlace = YES. RETURN. END.
      810      ELSE RETURN ERROR "Товар отсутствует в базе данных.".
      811   END.
      812   else do:
      813       assign  parb-c  = bar-code.b-code
      814               parrate = bar-code.cli-base-rate.
      815       find ub.goods where ub.goods.gds-code  = ub.bar-code.gds-code no-lock.
      816       find ub.gds-prt where ub.gds-prt.upper-code = ub.goods.prt-root no-lock.
      817       ASSIGN mess = mess + "Артикул: " + ub.goods.artic + " производитель: " + ub.goods.prod-type + " " + string (ub.goods.prod-code) + " " + ub.goods.gds-name + chr(10) .
      818       if parg#doc-prt and gds-prt.node-name <> '_Пустая шкала':U and
      819          can-find (first gds-prt where gds-prt.upper-code = bar-code.node-code) then
      820          RETURN ERROR "Ссылка не на подробный признак.".
      821       if not parg#doc-prt and gds-prt.node-name <> '_Пустая шкала':U and
      822            bar-code.node-code <> gds-prt.node-code then do:
      823         find b-bar-code where recid (b-bar-code) = recid (bar-code) no-lock.
      824         find bar-code where bar-code.gds-code  = b-bar-code.gds-code
      825                         and bar-code.node-code = gds-prt.node-code
      826                         and bar-code.in-code   = b-bar-code.in-code
      827                         and bar-code.part-code = b-bar-code.part-code
      828                         and bar-code.unit-cli  = ub.goods.unit-base
      829                           no-lock.
      830         parb-c = bar-code.b-code.
      831         RETURN "Ссылка на подробный или узловой признак. Заменяем на код: " + STRING(bar-code.b-code).
      832       end.
      833   end.
      834   RETURN.
      835   END PROCEDURE.
      836   procedure proc-code.
      837   define input parameter pl-str as char no-undo.
      838   DEFine INPUT PARAMeter mode-proc as CHAR NO-UNDO.
      839   define input parameter parscales-pref as character no-undo.
      840   define input parameter parpgscales-pref as character no-undo.
      841   define buffer b-bar-code for ub.bar-code.
      842   DEFINE VARIABLE mode-create      as LOGICAL NO-UNDO.
      843   DEFINE VARIABLE rec-old          as RECID NO-UNDO.
      844   define variable varres        as logical         no-undo.
      845   define variable var-code-temp like ub.place.pl-code no-undo.
      846   define buffer pc-goods for ub.goods.
      847   define variable g-log-char as character no-undo.
      848   define variable varprice-cli-old        like ub.doc-line.price-cli no-undo.
      849   define variable varprice-rubl-old       like ub.doc-line.price-cli no-undo.
      850   define variable varprice-base-old       like ub.doc-line.price-cli no-undo.
      851   define variable varcli-qnty-old         like ub.doc-line.cli-qnty  no-undo.
      852   define variable varcli-base-rate-old    like ub.doc-line.cli-qnty  no-undo.
      853   define variable varfact-qnty-old        like ub.doc-line.cli-qnty  no-undo.
      854   define variable vardoc-qnty-old         like ub.doc-line.cli-qnty  no-undo.
      855   define variable varvat-pc-old           like ub.doc-line.vat-pc    no-undo.
      856   define variable varslt-pc-old           like ub.doc-line.vat-pc    no-undo.
      857   define variable varroad-tax-old         like ub.doc-line.price-cli no-undo.
      858   define variable varexcise-old           like ub.doc-line.price-cli no-undo.
      859   define variable vartransport-rubl-old   like ub.doc-line.price-cli no-undo.
      860   define variable varother-rubl-old       like ub.doc-line.price-cli no-undo.
      861   define variable lns-cnt                 as   integer               no-undo.
      862   IF mode-proc = "PLACE" THEN DO:
      863       do lns-cnt = 1 to num-entries (part-list):
      864         find ub.bar-code where ub.bar-code.b-code  = integer (entry (lns-cnt, part-list)) no-lock.
      865         find first pc-goods where pc-goods.gds-code  = ub.bar-code.gds-code no-lock.
      866         RUN plgdsfnd (input  no,
      867                       input  v-cntxt-obj-type,
      868                       input  v-cntxt-obj-code,
      869                       input  pc-goods.gds-code,
      870                       output varres,
      871                       output var-code-temp) no-error.
      872        if varres = yes or error-status:error then do:
      873             put stream log unformatted "***" mess "Нельзя перемещать партии товара по складским местам "
      874             pc-goods.artic " " pc-goods.prod-type " " pc-goods.prod-code
      875             " по объкту " v-cntxt-obj-type " " v-cntxt-obj-code " "  skip.
      876             put stream ler unformatted "***" mess "Нельзя перемещать партии товара по складским местам "
      877             pc-goods.artic " " pc-goods.prod-type " " pc-goods.prod-code
      878             " по объкту " v-cntxt-obj-type " " v-cntxt-obj-code " "  skip.
      879             put stream err unformatted bar-str "," qnty-str "," pl-str skip.
      880         end.
      881         else
      882         for each ub.parts where ub.parts.obj-type  = v-cntxt-obj-type
      883                          and ub.parts.obj-code  = v-cntxt-obj-code
      884                          and ub.parts.artic     = pc-goods.artic
      885                          and ub.parts.prod-type = pc-goods.prod-type
      886                          and ub.parts.prod-code = pc-goods.prod-code
      887                          and ub.parts.in-code   = ub.bar-code.in-code
      888                          and ub.parts.part-code = ub.bar-code.part-code
      889                          and ub.parts.rsrv-free = yes:
      890           ub.parts.pl-code = ub.place.pl-code.
      891           put stream log unformatted mess "Партия: код: " bar-code.b-code " артикул: " ub.parts.artic " номер: " ub.parts.part-code " Место: " ub.parts.pl-code " - успешно" skip.
      892           j = j + 1.
      893           disp j with frame a.
      894         end.
      895       end.
      896       part-list = "".
      897   END.
      898   ELSE DO:
      899     if add-sens = ? then part-list = if part-list = "" then string (b-c) else part-list + "," + string (b-c).
      900     else do:
      901       if ub.goods.gds-type <> 'т':U and (t-doc.doc-type <> 'рас':U or t-doc.internal) then do:
      902         put stream log unformatted "***" mess "Услуга не соответствует типу данной накладной" skip.
      903         put stream ler unformatted "***" mess "Услуга не соответствует типу данной накладной" skip.
      904         put stream err unformatted bar-str "," qnty-str skip.
      905         return error.
      906       end.
      907       if g-type = ? then g-type = ub.goods.gds-type.
      908       if g-type <> ub.goods.gds-type then do:
      909         put stream log unformatted "***" mess "Тип товара не соответствует типу данной накладной" skip.
      910         put stream ler unformatted "***" mess "Тип товара не соответствует типу данной накладной" skip.
      911         put stream err unformatted bar-str ","  qnty-str skip.
      912         return error.
      913       end.
      914       assign g-log-char = "yes".
      915       do transaction on error undo , leave:
      916          define variable tempmess as character no-undo.
      917          define buffer bf_doc-line for ub.doc-line.
      918          find first ub.doc-line where ub.doc-line.doc-code  = t-doc.doc-code  and
      919                                    ub.doc-line.artic     = ub.goods.artic     and
      920                                    ub.doc-line.prod-type = ub.goods.prod-type and
      921                                    ub.doc-line.prod-code = ub.goods.prod-code no-error.
      922          if available ub.doc-line then do:
      923             assign
      924             mode-create = no
      925             varprice-cli-old       = ub.doc-line.price-cli
      926             varprice-rubl-old      = ub.doc-line.price-rubl
      927             varprice-base-old      = ub.doc-line.price-base
      928             varcli-qnty-old        = ub.doc-line.cli-qnty
      929             varcli-base-rate-old   = ub.doc-line.cli-base-rate
      930             varfact-qnty-old       = ub.doc-line.fact-qnty
      931             vardoc-qnty-old        = ub.doc-line.doc-qnty
      932             varvat-pc-old          = ub.doc-line.vat-pc
      933             varslt-pc-old          = ub.doc-line.slt-pc
      934             varroad-tax-old        = ub.doc-line.road-tax
      935             varexcise-old          = ub.doc-line.excise
      936             vartransport-rubl-old  = ub.doc-line.transport-rubl
      937             varother-rubl-old      = ub.doc-line.other-rubl.
      938          end.
      939          else mode-create = yes.
      940   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_copy-scn in g#lib-trn
      941     ( input  parparentproc
      942      ,input  recid(t-doc)
      943      ,input  bar-code.b-code
      944      ,input  decimal(qnty-str) * rate
      945      ,input  is-all
      946      ,input  add-sens
      947      ,input  line-mode
      948      ,output tempmess
      949      ,output g-log-char
      950     ) no-error .
      951          assign
      952          mess = mess + tempmess.
      953          if error-status:error then do:
      954            assign
      955            mess = mess + return-value.
      956            put stream err unformatted bar-str "," qnty-str skip.
      957            put stream log unformatted "***" mess " - ошибка" skip.
      958            put stream ler unformatted "***" mess " - ошибка" skip.
      959            return error.
      960          end.
      961          else do:
      962            put stream log unformatted mess " - успешно" skip.
      963            if pl-str <> "" then run store-place in this-procedure ( input pl-str
      964                                                                    ,input parscales-pref
      965                                                                    ,input parpgscales-pref
      966                                                                    ).
      967            j = j + 1.
      968            disp j with frame a.
      969          end.
      970          find first ub.doc-line where ub.doc-line.doc-code  = t-doc.doc-code  and
      971                                    ub.doc-line.artic     = ub.goods.artic     and
      972                                    ub.doc-line.prod-type = ub.goods.prod-type and
      973                                    ub.doc-line.prod-code = ub.goods.prod-code no-error.
      974          if t-doc.doc-type = 'при':U then do:
      975            if mode-create then do:
      976   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_clcintrn in g#lib-trn
      977     (
      978      input parparentproc
