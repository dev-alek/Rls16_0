      399     with frame fr-D-rvs-line-8.
      400     display ( ub.c-rvs-line.brutto-qnty           - ub.c-rvs-line.measure-qnty           ) @ v_meas-qty
      401             ( ub.c-rvs-line.brutto-cli-qnty       - ub.c-rvs-line.measure-cli-qnty       ) @ v_meas-cli
      402             ( ub.c-rvs-line.level-total           - ub.c-rvs-line.level-petrol           ) @ ub.c-rvs-line.level-water
      403             ( ub.c-rvs-line.state-brutto-qnty     - ub.c-rvs-line.state-measure-qnty     ) @ v_stat-qty
      404             ( ub.c-rvs-line.state-brutto-cli-qnty - ub.c-rvs-line.state-measure-cli-qnty ) @ v_stat-cli
      405             ( ub.c-rvs-line.state-level-total     - ub.c-rvs-line.state-level-petrol     ) @ ub.c-rvs-line.state-level-water
      406     with frame fr-D-rvs-line-8.
      407     if Show2nd( ub.c-rvs-line.system-qnty,     ub.c-rvs-line.orig-system-qnty     ) = yes and
      408        Show2nd( ub.c-rvs-line.system-cli-qnty, ub.c-rvs-line.orig-system-cli-qnty ) = yes then do:
      409       assign ub.c-rvs-line.orig-system-cli-qnty :label in frame fr-D-rvs-line-8 = "":U.
      410     end.
      411     if Show2nd( ub.c-rvs-line.system-qnty,     ub.c-rvs-line.orig-system-qnty     ) = yes then do:
      412       display ub.c-rvs-line.orig-system-qnty     with frame fr-D-rvs-line-8.
      413     end.
      414     else do:
      415       hide    ub.c-rvs-line.orig-system-qnty       in frame fr-D-rvs-line-8.
      416     end.
      417     if Show2nd( ub.c-rvs-line.system-cli-qnty, ub.c-rvs-line.orig-system-cli-qnty ) = yes then do:
      418       display ub.c-rvs-line.orig-system-cli-qnty with frame fr-D-rvs-line-8.
      419     end.
      420     else do:
      421       hide    ub.c-rvs-line.orig-system-cli-qnty   in frame fr-D-rvs-line-8.
      422     end.
      423     enable Btn_Exit b-help with frame fr-D-rvs-line-8.
      424     if p-mode = 'ПРОСМОТР':U then do: hide Btn_OK in frame fr-D-rvs-line-8. end.
      425     wait-for go of frame fr-D-rvs-line-8.
      426   end.
      427   hide frame fr-D-rvs-line-8 no-pause.
