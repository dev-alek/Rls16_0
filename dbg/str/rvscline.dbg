      148     ub.c-rvs-line.state-brutto-cli-qnty  at row 11.75 col 73.25 colon-aligned label "Факт брутто вес"        view-as fill-in size-chars 13.00 by 0.88
      149     v_meas-cli                      at row 12.75 col 28.25 colon-aligned label "Вес воды"               view-as fill-in size-chars 13.00 by 0.88
      150     v_stat-cli                      at row 12.75 col 73.25 colon-aligned label "Факт вес воды"          view-as fill-in size-chars 13.00 by 0.88
      151     ub.c-rvs-line.level-petrol           at row 13.75 col 28.25 colon-aligned label "Измер. уровень топлива" view-as fill-in size-chars 13.00 by 0.88
      152     ub.c-rvs-line.state-level-petrol     at row 13.75 col 73.25 colon-aligned label "Факт уровень топлива"   view-as fill-in size-chars 13.00 by 0.88
      153   with view-as dialog-box side-labels no-underline three-d scrollable
      154        title "":U default-button Btn_Exit cancel-button Btn_Exit.
