      161     ub.c-rvs-line.state-level-water at row 15.75 col 73.25 colon-aligned label "Факт уровень воды"         view-as fill-in size-chars 13.00 by 0.88
      162     ub.c-rvs-line.temperature       at row 16.75 col 28.25 colon-aligned                                   view-as fill-in size-chars 13.00 by 0.88
      163     ub.c-rvs-line.state-temperature at row 16.75 col 73.25 colon-aligned                                   view-as fill-in size-chars 13.00 by 0.88
      164     ub.c-rvs-line.temp-layer1       at row 17.75 col  8.63 colon-aligned label "ИзмT1"                     view-as fill-in size-chars  8.00 by 0.88
      165     ub.c-rvs-line.temp-layer2       at row 17.75 col 24.00 colon-aligned label "ИзмT2"                     view-as fill-in size-chars  8.00 by 0.88
      166     ub.c-rvs-line.temp-layer3       at row 17.75 col 39.38 colon-aligned label "ИзмT3"                     view-as fill-in size-chars  8.00 by 0.88
      167     ub.c-rvs-line.state-temp-layer1 at row 17.75 col 54.25 colon-aligned                                   view-as fill-in size-chars  8.00 by 0.88
      168     ub.c-rvs-line.state-temp-layer2 at row 17.75 col 71.38 colon-aligned                                   view-as fill-in size-chars  8.00 by 0.88
      169     ub.c-rvs-line.state-temp-layer3 at row 17.75 col 86.88 colon-aligned                                   view-as fill-in size-chars  8.00 by 0.88
      170     ub.c-rvs-line.meas-mh-qnty      at row 18.75 col 28.25 colon-aligned                                   view-as fill-in size-chars 17.00 by 0.88
      171     ub.c-rvs-line.state-mh-qnty     at row 18.75 col 73.25 colon-aligned                                   view-as fill-in size-chars 17.00 by 0.88
      172     ub.c-rvs-line.meas-am-qnty      at row 19.75 col 28.25 colon-aligned                                   view-as fill-in size-chars 17.00 by 0.88
      173     ub.c-rvs-line.state-am-qnty     at row 19.75 col 73.25 colon-aligned label "Факт сумма оборота"        view-as fill-in size-chars 17.00 by 0.88
      174     ub.c-rvs-line.meas-cf-qnty      at row 20.75 col 28.25 colon-aligned label "Измеренное кол-во наливов" view-as fill-in size-chars 17.00 by 0.88
      175     ub.c-rvs-line.state-cf-qnty     at row 20.75 col 73.25 colon-aligned label "Факт кол-во наливов"       view-as fill-in size-chars 17.00 by 0.88
      176     r-rect-0                   at row 22.00 col  1.50
      177       Btn_Exit                 at row 22.25 col  2.50
      178       Btn_OK                   at row 22.25 col 78.00
      179     b-help                at row 22.25 col 88.75
      180   with view-as dialog-box side-labels no-underline three-d scrollable
      181        title "":U default-button Btn_Exit cancel-button Btn_Exit.
      182   assign frame fr-D-rvs-line-8 :scrollable = no.
      183   on choose of Btn_OK in frame fr-D-rvs-line-8 do:
      184   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      185   if lookup(self :type
      186            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      187            ) = 0
      188   then do:
      189     message
      190       "$Workfile$"
      191       "Указанному интерфейсному элементу фокус не может быть передан" skip
      192       "Интерфейсный элемент" self :name  skip
      193       "Тип" self :type  skip
      194       "Процедура" this-procedure :file-name skip
      195       view-as alert-box .
      196   end.
      197   else do:
      198     apply "entry":u to self  .
      199     if focus :handle <> self :handle  then do:
      200       return no-apply .
      201     end.
      202   end.
      203     apply "GO":U to frame fr-D-rvs-line-8.
      204   end.
      205   on choose of Btn_Exit in frame fr-D-rvs-line-8 do:
      206   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      207   if lookup(self :type
      208            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      209            ) = 0
      210   then do:
      211     message
      212       "$Workfile$"
      213       "Указанному интерфейсному элементу фокус не может быть передан" skip
      214       "Интерфейсный элемент" self :name  skip
      215       "Тип" self :type  skip
      216       "Процедура" this-procedure :file-name skip
      217       view-as alert-box .
      218   end.
      219   else do:
      220     apply "entry":u to self  .
      221     if focus :handle <> self :handle  then do:
      222       return no-apply .
      223     end.
      224   end.
      225   end.
      226   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      227   on F1 of frame fr-D-rvs-line-8 anywhere do:
      228     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame fr-D-rvs-line-8. END.
      229     return no-apply.
      230   end.
      231   if valid-handle( active-window ) and frame fr-D-rvs-line-8 :parent = ? then frame fr-D-rvs-line-8 :parent = active-window.
      232   if current-window :window-state = window-minimized then do: current-window :window-state = window-normal. end.
      233   on window-close of frame fr-D-rvs-line-8 do: apply "END-ERROR":U to self. end.
      234   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      235   on help of frame fr-D-rvs-line-8
      236   do:
      237     run gbl/app_help.p
      238       (input this-procedure :file-name
      239       ,input ''
      240       ,input ?
      241       ) no-error.
      242     if error-status :error then do:
      243       message
      244         "Ошибка при вызове помощи"
      245         error-status :get-message(1)
      246         view-as alert-box .
      247     end.
      248   end.
      249   run minbtn-set in this-procedure .
      250   on choose of b-help in frame fr-D-rvs-line-8
      251   do:
      252     apply "help":u to frame fr-D-rvs-line-8 .
      253   end.
      254   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      255   procedure minbtn-set :
      256       do
      257           on error undo, return error return-value
      258           :
      259           define variable ii              as integer       no-undo .
      260           define variable fh              as widget-handle no-undo .
      261           define variable hh              as widget-handle no-undo .
      262           define variable v-h             as handle        extent 4 no-undo .
      263           define variable v-name-button   as character     no-undo .
      264           define variable v-help-old-x    as decimal       no-undo .
      265           define variable v-help-old-y    as decimal       no-undo .
      266           define variable v-help-old-size as decimal       no-undo .
      267           define variable v-frame-width   as decimal       no-undo .
      268           define variable jj              as integer       no-undo .
      269           do
      270               on error undo, return error
      271               :
      272               assign
      273                   v-frame-width = frame fr-D-rvs-line-8:width - 0.3
      274                   fh            = frame fr-D-rvs-line-8:first-child
      275                   hh            = fh:first-child
      276                   ii            = 1
      277                   .
      278               do while valid-handle(hh):
      279                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      280                   do:
      281                       case lc(hh:name) :
      282                           when "b-help" then
      283                               do:
      284                                   hh:load-image-up("cmp/b-help.bmp":u) .
      285                                   hh:load-image-down("cmp/b-help.bmp":u) .
      286                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      287                                   hh:TOOLTIP = "Помощь" .
      288                                   v-help-old-x = hh:column .
      289                                   v-help-old-y = hh:row    .
      290                                   v-help-old-size = hh:width .
      291                                   hh:width-chars = 2.5 .
      292                               end.
      293                           when "b-print" then
      294                               do:
      295                                   hh:load-image("cmp/b-print.bmp":u) .
      296                                   hh:TOOLTIP = "Печать" .
      297                                   v-h[ii] = hh:handle .
      298                                   ii = ii + 1 .
      299                                   hh:width-chars = 3 .
      300                               end.
      301                           when "b-history" or
      302                           when "b-hist" then
      303                               do:
      304                                   hh:load-image("cmp/b-hist.bmp":u) .
      305                                   hh:TOOLTIP = "История" .
      306                                   v-h[ii] = hh:handle .
      307                                   ii = ii + 1 .
      308                                   hh:width-chars = 3 .
      309                               end.
      310                           when "b-sch" then
      311                               do:
      312                                   hh:load-image("cmp/b-sch.bmp":u) .
      313                                   hh:TOOLTIP = "Установка Фильтра" .
      314                                   v-h[ii] = hh:handle .
      315                                   ii = ii + 1 .
      316                                   hh:width-chars = 3 .
      317                               end.
      318                           when "b-hist-user" then
      319                               do:
      320                                   hh:load-image("cmp/b-hist.bmp":u) .
      321                                   hh:TOOLTIP = "История пользователя" .
      322                                   ii = ii + 1 .
      323                               end.
      324                       end case.
      325                   end.
      326                   hh = hh:next-sibling.
      327               end.
      328               b-help:column = v-frame-width - b-help:width-chars.
      329               jj = 0.
      330               repeat ii = 4 to 1 by -1 :
      331                   if valid-handle (v-h[ii] ) then
      332                   do:
      333                       jj  = jj + 1 .
      334                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      335                       v-h[ii]:row    = v-help-old-y .
      336                   end.
      337               end.
      338           end.
      339       end.
      340   end procedure.
      341   Main-Block:
      342   do on error   undo Main-Block, leave Main-Block
      343      on end-key undo Main-Block, leave Main-Block :
      344     if p-mode <> 'ПРОСМОТР':U then do:
      345       message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
      346               "Неверное значение параметра вызова p-mode:" p-mode
      347       view-as alert-box error.
      348       undo Main-Block, return error.
      349     end.
      350     find ub.c-rvs-line no-lock where recid( ub.c-rvs-line ) = p-rec-id no-error.
      351     if not available ub.c-rvs-line then do:
      352       message "Карточка истории строки сверки не найдена!" view-as alert-box error.
      353       undo Main-Block, leave Main-Block.
      354     end.
      355     find first buf_goods no-lock where buf_goods.gds-code = ub.c-rvs-line.gds-code.
      356     assign frame fr-D-rvs-line-8 :title = 'Карточка истории изменения строки сверки  # ' + ub.c-rvs-line.rvs-code +
      357                                         ' товар ' + buf_goods.artic       + ' ':U +
      358                                                     buf_goods.prod-type   + ' ':U +
      359                                             string( buf_goods.prod-code ) +
      360                                         ' складское место ' + string( ub.c-rvs-line.pl-code ) + '  --  ' + p-mode.
      361     display ub.c-rvs-line.system-qnty
      362             ub.c-rvs-line.system-cli-qnty
      363             ub.c-rvs-line.orig-system-qnty
      364             ub.c-rvs-line.orig-system-cli-qnty
      365             ub.c-rvs-line.measure-qnty
      366             ub.c-rvs-line.state-measure-qnty
      367             ub.c-rvs-line.measure-tc-qnty
      368             ub.c-rvs-line.state-measure-tc-qnty
      369             ub.c-rvs-line.density
      370             ub.c-rvs-line.state-density
      371             ub.c-rvs-line.add-qnty
      372             ub.c-rvs-line.state-add-qnty
      373             ub.c-rvs-line.brutto-qnty
      374             ub.c-rvs-line.state-brutto-qnty
      375             ub.c-rvs-line.brutto-tc-qnty
      376             ub.c-rvs-line.state-brutto-tc-qnty
