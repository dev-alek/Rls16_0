      378             ub.c-rvs-line.state-measure-cli-qnty
      379             ub.c-rvs-line.brutto-cli-qnty
      380             ub.c-rvs-line.state-brutto-cli-qnty
      381             ub.c-rvs-line.level-petrol
      382             ub.c-rvs-line.state-level-petrol
      383             ub.c-rvs-line.level-total
      384             ub.c-rvs-line.state-level-total
      385             ub.c-rvs-line.temperature
      386             ub.c-rvs-line.state-temperature
      387             ub.c-rvs-line.temp-layer1
      388             ub.c-rvs-line.temp-layer2
      389             ub.c-rvs-line.temp-layer3
      390             ub.c-rvs-line.state-temp-layer1
      391             ub.c-rvs-line.state-temp-layer2
      392             ub.c-rvs-line.state-temp-layer3
      393             ub.c-rvs-line.meas-mh-qnty
      394             ub.c-rvs-line.state-mh-qnty
      395             ub.c-rvs-line.meas-am-qnty
      396             ub.c-rvs-line.state-am-qnty
      397             ub.c-rvs-line.meas-cf-qnty
