      742       .
      743       do while valid-handle(v-field-group-handle)
      744       :
      745         assign
      746           v-object-handle = v-field-group-handle :first-child
      747         .
      748         do while valid-handle(v-object-handle)
      749         :
      750           if  v-object-handle <> v-diasize-browse-handle :handle
      751           and can-query(v-object-handle, "row")
      752           and can-query(v-object-handle, "height")
      753           and ( v-object-handle :row > v-diasize-browse-handle :row )
      754           then do:
      755             find first buf_temp-browse-handle
      756               where buf_temp-browse-handle.browse-type   = 'height':u
      757                 and buf_temp-browse-handle.browse-handle = v-object-handle
      758               no-error .
      759             if available buf_temp-browse-handle
      760             then do:
      761             end.
      762             else do:
      763               create buf_temp-diasize-handle .
      764               assign
      765                 buf_temp-diasize-handle.handle-value  = v-object-handle
      766                 buf_temp-diasize-handle.save-position = v-object-handle :row
      767               .
      768             end.
      769           end.
      770           assign
      771             v-object-handle = v-object-handle :next-sibling
      772           .
      773         end.
      774         assign
      775           v-field-group-handle = v-field-group-handle :next-sibling
      776         .
      777       end.
      778       do with frame Dialog-Frame
      779       :
      780         hide v-diasize-resize-button .
      781         assign
      782           v-diasize-resize-button :row    = 1
      783           v-diasize-resize-button :column = 1
      784         .
      785       end.
      786       if p-change-value > 0
      787       then do:
      788         if frame Dialog-Frame :scrollable = true
      789         then do:
      790           assign
      791             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      792             no-error .
      793           if error-status :error
      794           or error-status :get-message(1) <> ""
      795           then do:
      796             undo move_block, retry move_block .
      797           end.
      798         end.
      799         assign
      800           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      801           no-error .
      802         if error-status :error
      803         or error-status :get-message(1) <> ""
