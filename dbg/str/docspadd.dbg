      959     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      960     define buffer buf_temp-browse-handle  for temp-browse-handle .
      961     if p-change-value > 0
      962     then do:
      963       if frame Dialog-Frame :width + p-change-value >
      964           session :width-chars
      965       then do:
      966         assign
      967           p-change-value = session :width-chars - frame Dialog-Frame :width
      968         .
      969         if p-change-value <= 0
      970         then do:
      971           run diasize_position-resize-button in this-procedure .
      972           return .
      973         end.
