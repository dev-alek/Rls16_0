      908       end.
      909       if p-move-resize = true
      910       then do:
      911         run diasize_position-resize-button in this-procedure .
      912       end.
      913       if v-diasize-wndstore = true
      914       then do:
      915         if connected("ub") = true
      916         then do:
      917           define variable v-cntxt-db-num        as integer   no-undo .
      918           define variable v-cntxt-userid        as character no-undo .
      919           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      920                                             , OUTPUT v-cntxt-userid
      921                                             ) .
      922           run gbl/wndsizew.p
      923             (input  v-cntxt-db-num
      924             ,input  v-cntxt-userid
      925             ,input  v-diasize-proc-name
      926             ,input  'height':u
      927             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      928             ) .
      929         end.
      930       end.
      931     end.
      932     assign
      933       v-diasize-change-size = false
      934     .
      935   end procedure.
      936   procedure diasize_set-height :
      937     define input  parameter p-new-height  as decimal   no-undo .
      938     define input  parameter p-move-resize as logical   no-undo .
      939     do
      940     on error undo, return error return-value
      941     :
      942       run diasize_change-height in this-procedure
      943         (input  (p-new-height - frame Dialog-Frame :height)
      944         ,input  p-move-resize
      945         ) .
      946     end.
      947   end procedure.
      948   procedure diasize_change-width :
      949     define input  parameter p-change-value as decimal   no-undo .
      950     define input  parameter p-move-resize  as logical   no-undo .
