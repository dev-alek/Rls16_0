      730         where buf_temp-browse-handle.browse-type = 'height':u
      731       :
      732         assign
      733           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      734         .
      735       end.
      736       for each buf_temp-diasize-handle
      737       :
      738         delete buf_temp-diasize-handle .
      739       end.
      740       assign
