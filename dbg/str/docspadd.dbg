     1204         on error undo move_block, retry move_block
     1205         :
     1206           assign
     1207             buf_temp-browse-handle.browse-handle :width
     1208               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1209             no-error .
     1210           if error-status :error
     1211           or error-status :get-message(1) <> ""
     1212           then do:
     1213             undo move_block, retry move_block .
     1214           end.
     1215         end.
     1216         for each buf_temp-diasize-handle
     1217         on error undo move_block, retry move_block
     1218         :
     1219           assign
     1220             v-object-handle = buf_temp-diasize-handle.handle-value
     1221           .
     1222           if v-object-handle <> v-diasize-resize-button
     1223           then do:
     1224             assign
     1225               v-object-handle :col = v-object-handle :col + p-change-value
     1226               no-error .
     1227             if error-status :error
     1228             or error-status :get-message(1) <> ""
     1229             then do:
     1230               undo move_block, retry move_block .
     1231             end.
     1232           end.
     1233         end.
     1234       end.
     1235       else do:
     1236         for each buf_temp-diasize-handle
     1237         on error undo move_block, retry move_block
     1238         :
     1239           assign
     1240             v-object-handle = buf_temp-diasize-handle.handle-value
     1241           .
     1242           if v-object-handle <> v-diasize-resize-button
     1243           then do:
     1244             assign
     1245               v-object-handle :col = v-object-handle :col + p-change-value
     1246               no-error .
     1247             if error-status :error
     1248             or error-status :get-message(1) <> ""
     1249             then do:
     1250               undo move_block, retry move_block .
     1251             end.
     1252           end.
     1253         end.
     1254         for each buf_temp-browse-handle
     1255           where buf_temp-browse-handle.browse-type = 'width':u
     1256         on error undo move_block, retry move_block
     1257         :
     1258           assign
     1259             buf_temp-browse-handle.browse-handle :width
     1260               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1261             no-error .
     1262           if error-status :error
     1263           or error-status :get-message(1) <> ""
     1264           then do:
     1265             undo move_block, retry move_block .
     1266           end.
     1267         end.
     1268         assign
     1269           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1270           no-error .
     1271         if error-status :error
     1272         or error-status :get-message(1) <> ""
     1273         then do:
     1274           undo move_block, retry move_block.
     1275         end.
     1276         assign
     1277           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1278         no-error .
     1279         if error-status :error
     1280         or error-status :get-message(1) <> ""
     1281         then do:
     1282           undo move_block, retry move_block.
     1283         end.
     1284         if frame Dialog-Frame :scrollable = true
     1285         then do:
     1286           assign
     1287             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1288           no-error .
     1289           if error-status :error
     1290           or error-status :get-message(1) <> ""
     1291           then do:
     1292             undo move_block, retry move_block.
     1293           end.
     1294         end.
     1295       end.
     1296       if p-move-resize
     1297       then do:
     1298         run diasize_position-resize-button in this-procedure .
     1299       end.
     1300       if v-diasize-wndstore = true
     1301       then do:
     1302         if connected("ub") = true
     1303         then do:
     1304           define variable v-cntxt-db-num        as integer   no-undo .
     1305           define variable v-cntxt-userid        as character no-undo .
     1306           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1307                                             , OUTPUT v-cntxt-userid
     1308                                             ) .
     1309           run gbl/wndsizew.p
     1310             (input  v-cntxt-db-num
     1311             ,input  v-cntxt-userid
     1312             ,input  v-diasize-proc-name
     1313             ,input  'width':u
     1314             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1315             ) .
     1316         end.
     1317       end.
     1318     end.
     1319     assign
     1320       v-diasize-change-size = false
     1321     .
     1322   end procedure.
     1323   procedure diasize_set-width :
     1324     define input  parameter p-new-width  as decimal   no-undo .
     1325     define input  parameter p-move-resize as logical   no-undo .
     1326     do
     1327     on error undo, return error return-value
     1328     :
     1329       run diasize_change-width in this-procedure
     1330         (input  (p-new-width - frame Dialog-Frame :width)
     1331         ,input  p-move-resize
     1332         ) .
     1333     end.
     1334   end procedure.
     1335   procedure diasize_position-resize-button :
     1336     do with frame Dialog-Frame
     1337     :
     1338       hide v-diasize-resize-button .
     1339       assign
     1340         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1341                     - 1
     1342                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1343         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1344                     - 1
     1345                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1346       .
     1347       view v-diasize-resize-button .
     1348     end.
     1349   end procedure.
     1350   on alt-right anywhere
     1351   do:
     1352     run diasize_change-width in this-procedure
     1353       (input 1
     1354       ,input true
     1355       ) .
     1356     return no-apply .
     1357   end.
     1358   on alt-left anywhere
     1359   do:
     1360     run diasize_change-width in this-procedure
     1361       (input -1
     1362       ,input true
     1363       ) .
     1364     return no-apply .
     1365   end.
     1366   on alt-down anywhere
     1367   do:
     1368     run diasize_change-height in this-procedure
     1369       (input 1
     1370       ,input true
     1371       ) .
     1372     return no-apply .
     1373   end.
     1374   on alt-up anywhere
     1375   do:
     1376     run diasize_change-height in this-procedure
     1377       (input -1
     1378       ,input true
     1379       ) .
     1380     return no-apply .
     1381   end.
     1382   on alt-enter of frame Dialog-Frame
     1383   do:
     1384     run diasize_maximize in this-procedure
     1385       (input  ?
     1386       ).
     1387     return no-apply .
     1388   end.
     1389   procedure diasize_end-move :
     1390     do
     1391     on error undo, return error return-value
     1392     :
     1393       define variable v-row-delta as decimal   no-undo .
     1394       define variable v-col-delta as decimal   no-undo .
     1395       define variable v-new-row as decimal   no-undo .
     1396       define variable v-new-col as decimal   no-undo .
     1397       assign
     1398         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1399         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1400       .
     1401       assign
     1402         v-row-delta = v-new-row - frame Dialog-Frame :height
     1403         v-col-delta = v-new-col - frame Dialog-Frame :width
     1404       .
     1405       run diasize_change-height in this-procedure
     1406         (input v-row-delta
     1407         ,input true
     1408         ) .
     1409       run diasize_change-width in this-procedure
     1410         (input v-col-delta
     1411         ,input true
     1412         ) .
     1413     end.
     1414   end procedure.
     1415   procedure diasize_maximize :
     1416     define input  parameter p-action as logical   no-undo .
     1417     do
     1418     on error undo, return error return-value
     1419     :
     1420       if p-action = ?
     1421       then do:
     1422         if v-diasize-need-maximize = true
     1423         then do:
     1424           assign
     1425             p-action = true
     1426           .
     1427         end.
     1428         else do:
     1429           assign
     1430             p-action = false
     1431           .
     1432         end.
     1433       end.
     1434       if p-action = true
     1435       then do:
     1436         run diasize_change-height in this-procedure
     1437           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1438               - frame Dialog-Frame :height-chars
     1439           ,input true
     1440           ) .
     1441         run diasize_change-width in this-procedure
     1442           (input session :width-chars
     1443               - frame Dialog-Frame :width-chars
     1444           ,input true
     1445           ) .
     1446         assign
     1447           v-diasize-need-maximize = false
     1448         .
     1449       end.
     1450       else do:
     1451         run diasize_change-width in this-procedure
     1452           (input v-diasize-orig-frame-width
     1453               - frame Dialog-Frame :width-chars
     1454           ,input true
     1455           ) .
     1456         run diasize_change-height in this-procedure
     1457           (input v-diasize-orig-frame-height
     1458               - frame Dialog-Frame :height-chars
     1459           ,input true
     1460           ) .
     1461         assign
     1462           v-diasize-need-maximize = true
     1463         .
     1464       end.
     1465     end.
     1466   end procedure.
     1467   procedure diasize_restore-orig-size :
     1468     do
     1469     on error undo, return error return-value
     1470     :
     1471       assign
     1472         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1473         v-diasize-current-frame-height = frame Dialog-Frame :height
     1474       .
     1475       run diasize_set-height in this-procedure
     1476         (input  v-diasize-orig-frame-height
     1477         ,input  true
     1478         ) .
     1479       run diasize_set-width in this-procedure
     1480         (input  v-diasize-orig-frame-width
     1481         ,input  true
     1482         ) .
     1483     end.
     1484   end procedure.
     1485   procedure diasize_restore-current-size :
     1486     do
     1487     on error undo, return error return-value
     1488     :
     1489       run diasize_set-height in this-procedure
     1490         (input  v-diasize-current-frame-height
     1491         ,input  true
     1492         ) .
     1493       run diasize_set-width in this-procedure
     1494         (input  v-diasize-current-frame-width
     1495         ,input  true
     1496         ) .
     1497     end.
     1498   end procedure.
     1499   procedure diasize_set-browse-handle :
     1500     define input  parameter p-browse-handle as handle   no-undo .
     1501     define buffer buf_temp-browse-handle for temp-browse-handle .
     1502     do
     1503     on error undo, return error return-value
     1504     :
     1505       assign
     1506         v-diasize-browse-handle = p-browse-handle
     1507       .
     1508       for each buf_temp-browse-handle
     1509       on error undo, return error return-value
     1510       :
     1511         delete buf_temp-browse-handle .
     1512       end.
     1513     end.
     1514   end procedure.
     1515   procedure diasize_add_browse :
     1516     define input  parameter p-browse-type   as character no-undo .
     1517     define input  parameter p-browse-handle as handle    no-undo .
     1518     define buffer buf_temp-browse-handle for temp-browse-handle .
     1519     do
     1520     on error undo, return error return-value
     1521     :
     1522       assign
     1523         v-diasize-browse-number = v-diasize-browse-number + 1
     1524       .
     1525       create buf_temp-browse-handle .
     1526       assign
     1527         buf_temp-browse-handle.browse-type   = p-browse-type
     1528         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1529         buf_temp-browse-handle.browse-handle = p-browse-handle
     1530       .
     1531     end.
     1532   end procedure.
     1533   procedure diasize_init :
     1534     define variable v-default-value    as logical   no-undo .
     1535     define variable v-restore-saved    as logical   no-undo .
     1536     define variable v-resize-value-str as character no-undo .
     1537     do
     1538     on error undo, return error return-value
     1539     :
     1540       do with frame Dialog-Frame
     1541       :
     1542         assign
     1543           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1544           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1545           v-diasize-browse-handle     = browse b-slt-vat :handle
     1546         .
     1547         create button v-diasize-resize-button
     1548         assign
     1549           parent        = frame Dialog-Frame :first-child
     1550           label         = "s"
     1551           height-pixels = 16
     1552           width-pixels  = 16
     1553           visible       = true
     1554           sensitive     = true
     1555           movable       = true
     1556           triggers:
     1557             on end-move persistent run diasize_end-move in this-procedure .
     1558           end triggers.
     1559         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1560         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1561         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1562         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1563         assign
     1564           v-diasize-wndmax = false
     1565         .
     1566         if connected("ub") = true
     1567         then do:
     1568           define variable v-cntxt-db-num        as integer   no-undo .
     1569           define variable v-cntxt-userid        as character no-undo .
     1570           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1571                                             , OUTPUT v-cntxt-userid
     1572                                             ) .
     1573           run gbl/wndpar_r.p
     1574             (input  v-cntxt-db-num
     1575             ,input  v-cntxt-userid
     1576             ,input  'wndmax':U
     1577             ,output v-diasize-wndmax
     1578             ,output v-default-value
     1579             ) .
     1580         end.
     1581         assign
     1582           v-diasize-wndstore = false
     1583         .
     1584         if connected("ub") = true
     1585         then do:
     1586           run gbl/wndpar_r.p
     1587             (input  v-cntxt-db-num
     1588             ,input  v-cntxt-userid
     1589             ,input  'wndstore':U
     1590             ,output v-diasize-wndstore
     1591             ,output v-default-value
     1592             ) .
     1593         end.
     1594         assign
     1595           v-diasize-proc-name = entry(1, program-name(2), '.')
     1596         .
     1597         if v-diasize-wndstore = true
     1598         then do:
     1599           assign
     1600             v-restore-saved = false
     1601           .
     1602           if connected("ub") = true
     1603           then do:
     1604             run gbl/wndsizer.p
     1605               (input  v-cntxt-db-num
     1606               ,input  v-cntxt-userid
     1607               ,input  v-diasize-proc-name
     1608               ,input  'height':u
     1609               ,output v-resize-value-str
     1610               ) .
     1611             if v-resize-value-str <> '':U
     1612             then do:
     1613               run diasize_change-height in this-procedure
     1614                 (input  integer(v-resize-value-str)
     1615                 ,input  true
     1616                 ) .
     1617               assign
     1618                 v-restore-saved = true
     1619               .
     1620             end.
     1621           end.
     1622           if connected("ub") = true
     1623           then do:
     1624             run gbl/wndsizer.p
     1625               (input  v-cntxt-db-num
     1626               ,input  v-cntxt-userid
     1627               ,input  v-diasize-proc-name
     1628               ,input  'width':u
     1629               ,output v-resize-value-str
     1630               ) .
     1631             if v-resize-value-str <> '':U
     1632             then do:
     1633               run diasize_change-width in this-procedure
     1634                 (input  integer(v-resize-value-str)
     1635                 ,input  true
     1636                 ) .
     1637               assign
     1638                 v-restore-saved = true
     1639               .
     1640             end.
     1641           end.
     1642           if v-restore-saved <> true
     1643           then do:
     1644             if v-diasize-wndmax = true
     1645             then do:
     1646               run diasize_maximize in this-procedure
     1647                 (input  true
     1648                 ) .
     1649             end.
     1650           end.
     1651         end.
     1652         else do:
     1653           if v-diasize-wndmax = true
     1654           then do:
     1655             run diasize_maximize in this-procedure
     1656               (input  true
     1657               ) .
     1658           end.
     1659         end.
     1660       end.
     1661     end.
     1662   end procedure.
     1663   procedure diasize_need-full-display :
     1664     define output parameter p-need-full-display as logical   no-undo .
     1665     do
     1666     on error undo, return error return-value
     1667     :
     1668       assign
     1669         p-need-full-display = v-diasize-need-full-display
     1670       .
     1671       assign
     1672         v-diasize-need-full-display = false
     1673       .
     1674     end.
     1675   end procedure.
     1676   procedure get-context :
     1677      define output parameter p-db-num as integer          no-undo.
     1678      define output parameter p-user-id as character        no-undo.
     1679      define variable v-login               as character    no-undo.
     1680      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1681      define buffer buf_user-login  for ub.user-login .
     1682      do
     1683      on error undo, return error
     1684      :
     1685            FIND FIRST buf_sys-ctrl no-lock.
     1686            ASSIGN
     1687               v-login = USERID("ub")
     1688               p-db-num = buf_sys-ctrl.db-num
     1689            .
     1690            FIND FIRST buf_user-login
     1691                 WHERE buf_user-login.db-num = p-db-num
     1692                   AND buf_user-login.user-login = v-login
     1693                 no-lock
     1694                 no-error
     1695                 .
     1696            IF AVAILABLE buf_user-login
     1697            THEN DO:
     1698               assign
     1699                  p-user-id = buf_user-login.user-id
     1700               .
     1701            END.
     1702      end.
     1703   end procedure.
     1704   run diasize_add_browse in this-procedure
     1705     (input  'width':u
     1706     ,input  browse b-slt-vat-cons :handle
     1707     ) .
     1708   run diasize_add_browse in this-procedure
     1709     (input  'width':u
     1710     ,input  browse b-slt-vat-cons-grp :handle
     1711     ) .
     1712   run diasize_init in this-procedure .
