      831         :
      832           assign
      833             v-object-handle = buf_temp-diasize-handle.handle-value
      834           .
      835           if v-object-handle <> v-diasize-resize-button
      836           then do:
      837             assign
      838               v-object-handle :row = v-object-handle :row + p-change-value
      839               no-error .
      840             if error-status :error
      841             or error-status :get-message(1) <> ""
      842             then do:
      843               undo move_block, retry move_block .
      844             end.
      845           end.
      846         end.
      847       end.
      848       else do:
      849         for each buf_temp-diasize-handle
      850         on error undo move_block, retry move_block
      851         :
      852           assign
      853             v-object-handle = buf_temp-diasize-handle.handle-value
      854           .
