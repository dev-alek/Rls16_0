     1719   d-slt-vat.acc-rubl:label in browse b-slt-vat = "Учет. цены (руб)"
     1720   d-slt-vat.acc-vat-base:label in browse b-slt-vat = "НДС уч. цены (вал)"
     1721   d-slt-vat.acc-vat-rubl:label in browse b-slt-vat = "НДС уч. цены (руб)"
     1722   d-slt-vat.sale-base:label in browse b-slt-vat  = "Продаж.цены"
     1723   d-slt-vat.ov-base:label in browse b-slt-vat = "Переоценка"
     1724   d-slt-vat.ov-vat:label in browse b-slt-vat = "НДС по переоценке"
     1725   d-slt-vat.pay-base:label in browse b-slt-vat = "К оплате (вал)"
     1726   d-slt-vat.pay-rubl:label in browse b-slt-vat = "К оплате (руб)"
     1727   d-slt-vat.no-vat-base:label in browse b-slt-vat = "Без НДС (вал)"
     1728   d-slt-vat.no-vat-rubl:label in browse b-slt-vat = "Без НДС (руб)"
     1729   d-slt-vat.vat-base:label in browse b-slt-vat = "НДС (вал)"
     1730   d-slt-vat.vat-rubl:label in browse b-slt-vat = "НДС(руб)"
     1731   d-slt-vat.slt-base:label in browse b-slt-vat = "НП (вал)"
     1732   d-slt-vat.slt-rubl:label in browse b-slt-vat = "НП (руб)"
     1733   d-slt-vat.excise:label in browse b-slt-vat = "Акциз"
     1734   .
     1735   assign
     1736     d-slt-vat.road-tax:label in browse b-slt-vat = varroad-tax-label.
     1737   assign
     1738   d-slt-vat-cons.vat-pc:label in browse b-slt-vat-cons = "НДС"
     1739   d-slt-vat-cons.slt-pc:label in browse b-slt-vat-cons = "НП"
     1740   d-slt-vat-cons.purch-name:label in browse b-slt-vat-cons = "Тип пр"
     1741   d-slt-vat-cons.fact-qnty:label in browse b-slt-vat-cons = "Факт. кол-во"
     1742   d-slt-vat-cons.acc-base:label in browse b-slt-vat-cons = "Учет. цены (вал)"
     1743   d-slt-vat-cons.acc-rubl:label in browse b-slt-vat-cons = "Учет. цены (руб)"
     1744   d-slt-vat-cons.acc-vat-base:label in browse b-slt-vat-cons = "НДС уч. цены (вал)"
     1745   d-slt-vat-cons.acc-vat-rubl:label in browse b-slt-vat-cons = "НДС уч. цены (руб)"
     1746   d-slt-vat-cons.sale-base:label in browse b-slt-vat-cons  = "Продаж.цены"
     1747   d-slt-vat-cons.ov-base:label in browse b-slt-vat-cons = "Переоценка"
     1748   d-slt-vat-cons.ov-vat:label in browse b-slt-vat-cons = "НДС по переоценке"
     1749   d-slt-vat-cons.pay-base:label in browse b-slt-vat-cons = "К оплате (вал)"
     1750   d-slt-vat-cons.pay-rubl:label in browse b-slt-vat-cons = "К оплате (руб)"
