      412   ASSIGN
      413          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      414          FRAME Dialog-Frame:HIDDEN           = TRUE.
      415   ASSIGN
      416          b-slt-vat:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 2.
      417   ASSIGN
      418          b-slt-vat-cons:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 3.
      419   ASSIGN
      420          b-slt-vat-cons-grp:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 4.
