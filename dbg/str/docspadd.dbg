      806         end.
      807         assign
      808           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      809           no-error .
      810         if error-status :error
      811         or error-status :get-message(1) <> ""
      812         then do:
      813           undo move_block, retry move_block .
      814         end.
      815         for each buf_temp-browse-handle
      816           where buf_temp-browse-handle.browse-type = 'height':u
