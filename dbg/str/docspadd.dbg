      818         :
      819           assign
      820             buf_temp-browse-handle.browse-handle :height
      821               = buf_temp-browse-handle.browse-handle :height + p-change-value
      822             no-error .
      823           if error-status :error
      824           or error-status :get-message(1) <> ""
      825           then do:
      826             undo move_block, retry move_block .
      827           end.
      828         end.
      829         for each buf_temp-diasize-handle
