      993       assign
      994         v-change-sign = 1
      995       .
      996     end.
      997     else do:
      998       assign
      999         v-change-sign = -1
     1000       .
     1001     end.
     1002     assign
     1003       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1004     .
     1005     if p-change-value = 0
     1006     then do:
     1007       run diasize_position-resize-button in this-procedure .
     1008       return .
     1009     end.
