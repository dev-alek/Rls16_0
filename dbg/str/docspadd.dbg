      561   procedure diasize_change-height :
      562     define input  parameter p-change-value  as decimal   no-undo .
      563     define input  parameter p-move-resize   as logical   no-undo .
      564     define variable v-field-group-handle    as handle    no-undo .
      565     define variable v-object-handle         as handle    no-undo .
      566     define variable v-frame-height          as decimal   no-undo .
      567     define variable v-frame-virtual-height  as decimal   no-undo .
      568     define variable v-browse-height         as decimal   no-undo .
      569     define variable v-window-height         as decimal   no-undo .
      570     define variable v-window-virtual-height as decimal   no-undo .
      571     define variable v-change-sign           as integer   no-undo .
      572     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      573     define buffer buf_temp-browse-handle  for temp-browse-handle .
      574     if p-change-value > 0
      575     then do:
      576       if frame Dialog-Frame :height + p-change-value
      577           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      578       then do:
      579         assign
      580           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      581                           - (frame Dialog-Frame :height-chars)
      582         .
      583         if p-change-value <= 0
      584         then do:
      585           run diasize_position-resize-button in this-procedure .
      586           return .
      587         end.
      588       end.
      589     end.
      590     if p-change-value < 0
      591     then do:
      592       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      593       then do:
      594         assign
      595           p-change-value = v-diasize-orig-frame-height
      596                          - (frame Dialog-Frame :height-chars)
      597         .
      598         if p-change-value >= 0
      599         then do:
      600           run diasize_position-resize-button in this-procedure .
      601           return .
      602         end.
      603       end.
      604     end.
      605     if p-change-value >= 0
      606     then do:
      607       assign
      608         v-change-sign = 1
      609       .
      610     end.
      611     else do:
      612       assign
      613         v-change-sign = -1
      614       .
      615     end.
      616     assign
      617       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      618     .
      619     if p-change-value = 0
      620     then do:
      621       run diasize_position-resize-button in this-procedure .
      622       return .
      623     end.
      624     move_block:
      625     do
      626     on error undo move_block, retry move_block
      627     :
      628       if retry
      629       then do:
      630         do
      631         on error undo move_block, leave move_block
      632         :
      633           if p-change-value > 0
      634           then do:
      635             for each buf_temp-diasize-handle
      636             on error undo, next
      637             :
      638               assign
      639                 v-object-handle = buf_temp-diasize-handle.handle-value
      640               .
      641               if v-object-handle <> v-diasize-resize-button
      642               then do:
      643                 assign
      644                   v-object-handle :row = buf_temp-diasize-handle.save-position
      645                 .
      646               end.
      647             end.
      648             assign
      649               v-diasize-browse-handle :height = v-browse-height
      650             .
      651             for each buf_temp-browse-handle
      652               where buf_temp-browse-handle.browse-type = 'height':u
      653             on error undo, next
      654             :
      655               assign
      656                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      657               .
      658             end.
      659             assign
      660               frame Dialog-Frame :height = v-frame-height
      661             .
      662             if frame Dialog-Frame :scrollable = true
      663             then do:
      664               assign
      665                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      666               .
      667             end.
      668             run diasize_position-resize-button in this-procedure .
      669           end.
      670           else do:
      671             if frame Dialog-Frame :scrollable = true
      672             then do:
      673               assign
      674                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      675               .
      676             end.
      677             assign
      678               frame Dialog-Frame :height = v-frame-height
      679             .
      680             assign
      681               v-diasize-browse-handle :height = v-browse-height
      682             .
      683             for each buf_temp-browse-handle
      684               where buf_temp-browse-handle.browse-type = 'height':u
      685             on error undo, next
      686             :
