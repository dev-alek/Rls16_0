     3784         assign
     3785           l-disable-where-39 =
     3786             (" TRUE " + " " + where-phrase-39 = "")
     3787         .
     3788         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3789                             ,input QUERY br-docs:handle
     3790                             ,input parameter-3-39
     3791                             ,input parameter-4-39
     3792                             ,input parameter-5-39
     3793                             ,input parameter-6-39
     3794                             ,input parameter-7-39
     3795                             )
     3796         .
     3797         assign
     3798           l-filter-open-39 = true
     3799         .
     3800       end.
     3801       if l-filter-open-39 = false then do:
     3802         message
     3803           "Ошибка при фильтрации / сортировке" skip
     3804           "Будут показаны записи без учета фильтра" skip
     3805           view-as alert-box .
     3806       end.
     3807       else do:
     3808           assign
     3809             l-query-was-opened = true
     3810           .
     3811       end.
     3812     end.
     3813     if l-filter-open-39 = false then do:
     3814       OPEN QUERY br-docs FOR EACH c-doc
     3815         where  TRUE
     3816         indexed-reposition
     3817     .
     3818         assign
     3819           l-query-was-opened = true
     3820         .
     3821     end.
     3822   end.
     3823   else do:
     3824     assign
     3825       v-doc-rec = recid( c-doc )
     3826     .
     3827     do
     3828     on stop undo, leave
     3829     on error undo, leave
     3830     :
     3831       if QUERY br-docs:handle:get-buffer-handle(1) = (buffer c-doc:handle) then do:
     3832         assign
     3833         parameter-2-39 = (if p-find-next then "true":u else "false":u )
     3834         parameter-4-39 =
     3835           "where ":u + " TRUE " + " ":u + where-phrase-39 + " ":u + p-find-condition + " " + ""
     3836         parameter-5-39 = "  "
     3837       .
