     3283   CASE par-mode:
     3284       WHEN  'все':U
     3285       or when  'объект':U
     3286       or when "free":U
     3287       or when "chk-date":U
     3288       or when 'vt':U
     3289       or when 'dis-card':U
     3290       or when 'IBS-TH':U
     3291       THEN DO:
     3292         FIND FIRST buf_obj No-LOCK WHERE
     3293                     buf_obj.obj-type = parobj-type and
     3294                     buf_obj.obj-code = parobj-code No-ERROR.
     3295         if not avail buf_obj then do:
     3296           message vss-workfile vss-revision vss-description skip
     3297           "Неверное значение параметров вызова parobj-type и/или parobj-code"
     3298           parobj-type parobj-code
     3299           view-as alert-box ERROR.
     3300           return.
     3301         end.
     3302       END.
     3303       when "d-card":U or when ("d-card" + chr(44) + 'продажа':U) then do:
     3304           FIND FIRST buf_dis-card where
     3305                             buf_dis-card.d-card = pard-card No-LOCK NO-ERROR.
     3306         if not avail buf_dis-card then do:
     3307             message vss-workfile vss-revision vss-description skip
     3308             "Неверное значение параметра вызова pard-card" pard-card
     3309             view-as alert-box ERROR.
     3310             return.
     3311         end.
     3312          FIND FIrst  buf_clients NO-LOCK WHERE
     3313                           buf_clients.obj-type = buf_dis-card.cli-type AND
     3314                           buf_clients.obj-code = buf_dis-card.cli-code No-ERROR.
     3315       end.
     3316       WHEN 'продажа':U  or when ("d-card" + chr(44) + 'продажа':U) or when "to-sale":U then do:
     3317           FIND buf_inkas where buf_inkas.inkas-code = parout-code NO-LOCK no-error.
     3318         if not avail buf_inkas then do:
     3319             message vss-workfile vss-revision vss-description skip
     3320             "Неверное значение параметра вызова parout-code" parout-code
     3321             view-as alert-box ERROR.
     3322             return.
     3323         end.
     3324       end.
     3325       WHEN "out-code":U then do:
     3326           FIND buf_wth-doc where buf_wth-doc.doc-code = parout-code NO-LOCK no-error.
     3327         if not avail buf_wth-doc then do:
     3328             message vss-workfile vss-revision vss-description skip
     3329             "Неверное значение параметра вызова parout-code" parout-code
     3330             view-as alert-box ERROR.
     3331             return.
     3332         end.
     3333       end.
     3334       when "chk-date":U then do:
     3335         if p-start-date > p-end-date
     3336         or p-start-date = ?
     3337         or p-end-date = ?
     3338         then do:
     3339             message vss-workfile vss-revision vss-description skip
     3340             "Неверное значение параметров p-start-date p-end-date" p-start-date p-end-date
     3341             view-as alert-box ERROR.
     3342             return.
     3343         end.
     3344       end.
     3345       when "to-inv" then do:
     3346         FIND buf_trn-doc where buf_trn-doc.doc-code = parout-code NO-LOCK no-error.
     3347         if not avail buf_trn-doc then do:
     3348             message vss-workfile vss-revision vss-description skip
     3349             "Неверное значение параметра вызова parout-code" parout-code
     3350             view-as alert-box ERROR.
     3351             return.
     3352         end.
     3353       end.
     3354       when "to-" + 'сч-трк-погр':U
     3355       or
     3356       when 'сч-трк-погр':U
     3357       then do:
     3358         if parout-code <> '':U then do:
     3359           FIND buf_icnt-doc where buf_icnt-doc.doc-code = parout-code NO-LOCK no-error.
     3360           if not avail buf_icnt-doc then do:
     3361               message vss-workfile vss-revision vss-description skip
     3362               "Неверное значение параметра вызова parout-code" parout-code
     3363               view-as alert-box ERROR.
     3364               return.
     3365           end.
     3366         end.
     3367       end.
     3368       otherwise do:
     3369         message vss-workfile vss-revision vss-description skip
     3370         "Неверный вызов - par-mode=" par-mode
     3371         view-as alert-box ERROR.
     3372         return.
     3373       end.
     3374     end CASE.
     3375       if pardoc-rec <> ? then do:
     3376         FIND FIRST find_chk-doc No-LOCK where
     3377                    recid(find_chk-doc) = pardoc-rec No-ERROR.
     3378         if not avail find_chk-doc then do:
     3379           message
     3380           vss-workfile vss-revision vss-description skip
     3381           "Неверное значение параметра вызова pardoc-rec" pardoc-rec
     3382           view-as alert-box error .
     3383           return error.
     3384         end.
     3385       end.
