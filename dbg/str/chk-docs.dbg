     3851           v-fltopend-rowid[1] = ?
     3852         .
     3853       end.
     3854       else do:
     3855         assign
     3856         parameter-2-39 = (if p-find-next then "true":u else "false":u )
     3857         parameter-3-39 =  "FOR EACH c-doc"
     3858         parameter-4-39 =
     3859           (
     3860             if (" TRUE " + " " + where-phrase-39) <> ""
