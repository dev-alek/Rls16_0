     3216       end.
     3217     end.
     3218     return no-apply .
     3219   end.
     3220     define MENU m-ed-date29
     3221       MENU-ITEM m-ed-date29-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     3222       MENU-ITEM m-ed-date29-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     3223       MENU-ITEM m-ed-date29-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     3224       MENU-ITEM m-ed-date29-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     3225       .
     3226     if sch-date :POPUP-MENU in frame Dialog-Frame = ?
     3227     then do:
     3228       ASSIGN
     3229         sch-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date29 :HANDLE
     3230         sch-date :MENU-MOUSE in frame Dialog-Frame = 3
     3231       .
     3232     end.
     3233     define variable v-label-handle29 as handle no-undo .
     3234     assign
     3235       v-label-handle29 = sch-date :side-label-handle in frame Dialog-Frame
     3236     .
     3237     if valid-handle (v-label-handle29)
     3238     then do:
     3239       if v-label-handle29 :tooltip = ""
     3240       or v-label-handle29 :tooltip = ?
     3241       then do:
     3242         assign
     3243           v-label-handle29 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     3244         .
     3245       end.
     3246     end.
     3247     ON CHOOSE OF MENU-ITEM m-ed-date29-1 in menu m-ed-date29 DO:
     3248       apply "ctrl-b":U to sch-date in frame Dialog-Frame .
     3249     END.
     3250     ON CHOOSE OF MENU-ITEM m-ed-date29-2 in menu m-ed-date29 DO:
