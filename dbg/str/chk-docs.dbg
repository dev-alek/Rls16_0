     3862             else "true"
     3863           )
     3864         parameter-5-39 = (" " + "" + " " + "" + " " + p-find-condition)
     3865         parameter-6-39 = if sort-phrase-39 = ''
     3866                              then
     3867           (
     3868           " " + "  " +
     3869             " " + sort-column-phrase +
     3870           " " + "  "
     3871           )
     3872                              else
