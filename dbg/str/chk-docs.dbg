     3651   ed-notes
     3652   b-del when LOOKUP("b-del":U, bttns) > 0
     3653   b-chg when par-mode <> 'продажа':U
     3654   b-print
     3655   WITH FRAME Dialog-Frame.
     3656   IF NOT CAN-FIND(FIRST cash-desk WHERE cash-desk.db-num >=0
     3657                 AND cash-desk.obj-code = parobj-code
     3658                 AND cash-desk.pos-type = 'Autotank':U) THEN
     3659   DO:
     3660     v-hdl = br-docs:FIRST-COLUMN .
     3661     DO WHILE VALID-HANDLE(v-hdl):
     3662         IF v-hdl:LABEL = "СдНал":U THEN v-hdl:VISIBLE = NO .
     3663         v-hdl = v-hdl:NEXT-COLUMN .
     3664     END.
     3665   END.
     3666   if par-mode = 'продажа':U then do:
     3667     IF available buf_inkas and (buf_inkas.status_ = 'факт':U or buf_inkas.status_ = 'запрос':U)
     3668     then disable b-del  with frame Dialog-Frame.
     3669   end.
     3670   if par-mode = 'vt':U then do:
     3671     IF available buf_trn-doc and buf_trn-doc.status_ <> 'накл':U
     3672     then disable b-del  with frame Dialog-Frame.
     3673   end.
     3674   if not chk-spfc then
     3675   menu-item m-spcf:sensitive in menu m-print  = no .
     3676   if (cb-chk-type:visible in frame Dialog-Frame  = yes) then do:
     3677     assign
     3678     br-docs:height = br-docs:height  - 0.5
     3679     br-docs:row = br-docs:row + 0.5
     3680     .
     3681   end.
     3682   else do:
     3683     hide
     3684     cb-chk-type
     3685     in frame Dialog-Frame .
     3686   end.
     3687   VIEW FRAME Dialog-Frame .
     3688   END PROCEDURE.
     3689   PROCEDURE OpenBr :
     3690   define input  parameter p-open-query     as logical   no-undo .
     3691   define input  parameter p-find-next      as logical   no-undo .
     3692   define input  parameter p-find-condition as character no-undo .
     3693   define variable l-query-was-opened as logical no-undo .
     3694   define variable title0 as character no-undo.
     3695   title0 = "Список чеков" + chr(32).
     3696   define variable sort-column-phrase as character no-undo .
     3697   define buffer buf_chk-doc for ub.chk-doc.
     3698   case sort-column-name :
     3699     when "" then do:
     3700       assign
     3701         sort-column-phrase = ""
     3702       .
     3703     end.
     3704     otherwise do:
     3705       assign
     3706         sort-column-phrase = "by " + sort-column-name
     3707       .
     3708     end.
     3709   end case.
     3710   define variable l-open-query as logical   no-undo .
     3711     CASE par-mode :
     3712       WHEN 'все':U        THEN DO:
     3713         assign
     3714         filter-point = filter-point0 + par-mode
     3715         filter-label = substitute("&1", filter-label0)
     3716         .
     3717   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
