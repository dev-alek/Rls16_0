     6922         end.
     6923         if l-shift-on then do:
     6924           define variable v-shift-date as date no-undo .
     6925           define variable v-shift-num as integer no-undo .
     6926           define variable v-shift-name as character no-undo .
     6927           define variable v-chk-date as date no-undo .
     6928           define variable v-chk-time as integer no-undo .
     6929           run gbl/factdate.p (
     6930                             INPUT         parobj-type
     6931                             ,INPUT        parobj-code
