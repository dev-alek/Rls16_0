     8781   c-doc.out-code      column-label "Номер_РН"
     8782   c-doc.d-card        column-label "Номер_диск._карты"              space(0)
     8783   HEADER  date_string AT 5 format "X(35)"
     8784   v-header-base-curr        format "X(20)" AT 42
     8785   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>>>9" SKIP
     8786   Line format "X(198)" AT 1
     8787   with width 232 down stream-io use-text    .
     8788   Line = fill("-", 198).
     8789   date_string = cur-time-print() .
     8790   run prn-lib-open-stream  in this-procedure (
     8791                                                input parParentProc
     8792                                               ,input 43
     8793                                               ,input yes
     8794                                               ,input no
     8795                                               ).
     8796   PUT  STREAM PrnLibStream
     8797   SPACE(25) ( frame Dialog-Frame:title )
     8798   format "x(90)" SKIP(1) .
     8799   FORM HEADER
     8800   Line format "X(177)" AT 1 SKIP
     8801   "Продолжение - на следующей странице" AT 30 SKIP
     8802   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     8803   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     8804   FORM with FRAME Chk-List  .
     8805   run waitfram-show in this-procedure ( input "Ждите...").
     8806   GET next br-docs  no-lock.
     8807   DO WHILE available c-doc :
     8808     v-chk-type = entry (lookup (string(c-doc.chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U) .
     8809     Display STREAM PrnLibStream
     8810     c-doc.office
     8811     c-doc.doc-code
     8812     v-chk-type
     8813     c-doc.chk-num
     8814     c-doc.chk-date
     8815     string(c-doc.chk-time, "HH:mm") @ for-time
     8816     c-doc.shift-date
     8817     shift-name-no-err(buffer c-doc) @ v-shift-name-num
     8818     c-doc.tot-doc
     8819     c-doc.discnt
     8820     c-doc.sub-discnt
     8821     c-doc.netto
     8822     c-doc.pay-desk
     8823     c-doc.cashier
     8824     c-doc.sales-man
     8825     if c-doc.out-code <> ? then c-doc.out-code else "" @ c-doc.out-code
     8826     c-doc.d-card
     8827     with FRAME Chk-List .
     8828     DOWN STREAM PrnLibStream 1 with FRAME CHk-List  .
     8829     assign
     8830     accum-count = accum-count + 1
     8831     accum-tot-doc = accum-tot-doc + c-doc.tot-doc
     8832     accum-discnt = accum-discnt + c-doc.discnt
     8833     accum-sub-discnt = accum-sub-discnt + c-doc.sub-discnt
     8834     accum-netto = accum-netto + c-doc.netto.
     8835     GET next br-docs  no-lock.
     8836   END.
     8837   UNDERLINE  STREAM PrnLibStream
     8838   c-doc.office
     8839   c-doc.doc-code
     8840   v-chk-type
     8841   c-doc.chk-num
     8842   c-doc.chk-date
     8843   for-time
     8844   c-doc.shift-date
     8845   v-shift-name-num
     8846   c-doc.tot-doc
     8847   c-doc.discnt
     8848   c-doc.sub-discnt
     8849   c-doc.netto
     8850   c-doc.pay-desk
     8851   c-doc.cashier
     8852   c-doc.sales-man
     8853   c-doc.out-code
     8854   c-doc.d-card
     8855   with FRAME Chk-List .
     8856   DISPLAY STREAM PrnLibStream
     8857   "ИТОГО"  @ c-doc.doc-code
     8858   accum-count @ c-doc.chk-num
     8859   "_" @ c-doc.chk-date
     8860   "_ " @ for-time
     8861   "_" @ c-doc.shift-date
     8862   "______" @ v-shift-name-num
     8863   accum-tot-doc @ c-doc.tot-doc
     8864   accum-discnt @ c-doc.discnt
     8865   accum-sub-discnt @ c-doc.sub-discnt
     8866   accum-netto @ c-doc.netto
     8867   with frame Chk-List.
     8868   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     8869   HIDE  STREAM PrnLibStream FRAME CheckList.
     8870   output  STREAM PrnLibStream CLOSE.
     8871   run waitfram-hide in this-procedure .
     8872   run prn-lib-prn-file in this-procedure (
     8873                                             input parParentProc
     8874                                             ,input 8
     8875                                             ).
     8876   END PROCEDURE.
     8877   PROCEDURE PrintProcGds :
     8878   define variable date_string     as      char    no-undo.
     8879   define variable Line                as      char    no-undo.
     8880   define variable for-time as char no-undo.
     8881   define variable accum-count as integer no-undo.
     8882   define variable accum-qnty as decimal no-undo.
     8883   define variable accum-tot-doc as decimal no-undo.
     8884   define variable accum-discnt as decimal no-undo.
     8885   define variable accum-netto as decimal no-undo.
     8886   define variable fgds-discnt-pc as decimal no-undo.
     8887   define variable for-gds-sum like ub.chk-doc.netto no-undo.
     8888   define variable for-gds-price like ub.chk-gds.price-base no-undo.
     8889   define variable v-write-off as logical no-undo .
     8890   define variable V-RECEIPT-NAME as character no-undo .
     8891   DEFINE FRAME Goods-Frame
     8892   ub.chk-gds.doc-code column-label "Номер_чека" FORMAT "X(18)"
     8893   v-receipt-name column-labeL "Тип_чека" format "x(8)"
     8894   ub.chk-gds.line-num column-label "NN" FORMAT "-999"
     8895   ub.chk-gds.b-code   column-label "Код"
     8896   ub.goods.artic
     8897   ub.goods.gds-name    FORMAT "X(27)"
     8898   ub.gds-prt.f-name   FORMAT "X(14)"
     8899   ub.chk-gds.is-error COLUMN-LABEL "Ош" FORMAT "+/ "
     8900   ub.chk-gds.src-code Column-label "Код в спул-файле" FORMAT "X(19)"
     8901   ub.chk-gds.pump column-label "ТРК"
     8902   ub.clients.obj-name    COLUMN-LABEL "Производитель" FORMAT "X(20)"
     8903   ub.chk-gds.doc-qnty
     8904   ub.bar-code.unit-cli     COLUMN-LABEL "Изм" FORMAT "X(3)"
     8905   ub.chk-gds.price-base
     8906   ub.chk-gds.discnt
     8907   fgds-discnt-pc COLUMn-LABEL "% ск."  FORMAT "->9.99%"
     8908   for-gds-price COLUMN-LABEL "Цена нетто"
     8909   v-write-off COLUMn-LABEL "Сп" FORMAT "+/"
     8910   HEADER  date_string AT 5 format "X(35)"
     8911   v-header-base-curr        format "X(20)" AT 42
     8912   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>>>9" SKIP
     8913    Line format "X(230)" AT 1
     8914   with width 232 down stream-io use-text .
     8915   Line = fill("-", 230).
     8916   date_string = cur-time-print() .
     8917   run prn-lib-open-stream  in this-procedure (
     8918                                                input parParentProc
     8919                                               ,input 43
     8920                                               ,input yes
     8921                                               ,input no
     8922                                               ).
     8923   PUT  STREAM PrnLibStream
     8924   SPACE(25) ( frame Dialog-Frame:title + ": строки чеков")
     8925   format "x(90)" SKIP(1) .
     8926   FORM HEADER
     8927   Line format "X(230)" AT 1 SKIP
     8928   "Продолжение - на следующей странице" AT 30 SKIP
     8929   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     8930   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     8931   FORM with FRAME Goods-Frame  .
     8932   run waitfram-show in this-procedure ( input "Ждите...").
     8933   GET next br-docs  no-lock.
     8934   DO WHILE available c-doc :
     8935     FOR EACH chk-gds NO-LOCK Where
     8936              chk-gds.doc-code = c-doc.doc-code by chk-gds.line-num:
     8937       FIND FIRST bar-code No-LOCK WHERE
     8938                  bar-code.b-code = chk-gds.b-code NO-ERROR.
     8939       IF AVAIL bar-code then do:
     8940       FIND FIRST goods NO-LOCK WHERE
     8941                  goods.gds-code = bar-code.gds-code NO-ERROR.
     8942       FIND FIRST  clients NO-LOCK WHERE
     8943                   clients.obj-type = goods.prod-type AND
     8944                   clients.obj-code = goods.prod-code NO-ERROR.
     8945       FIND FIRST gds-prt No-LOCK where
     8946                  gds-prt.upper-code = goods.prt-root NO-ERROR.
     8947       end.
     8948       assign
     8949       fgds-discnt-pc = (chk-gds.discnt / (chk-gds.price-base + chk-gds.price-service) * 100)
     8950       for-gds-sum = (chk-gds.price-base + chk-gds.price-service - chk-gds.discnt) * chk-gds.doc-qnty
     8951       for-gds-price = chk-gds.price-base + chk-gds.price-service - chk-gds.discnt
     8952       .
     8953       DISPLAY Stream PrnLibStream
     8954       chk-gds.doc-code
     8955       entry (lookup (STRING(C-DOC.CHK-TYPE), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U) @ V-RECEIPT-NAME
     8956       chk-gds.line-num
     8957       chk-gds.b-code
     8958       if avail bar-code then goods.artic else "" @ goods.artic
     8959       if avail bar-code then goods.gds-name else "" @ goods.gds-name
     8960       IF avail bar-code then (IF ( ub.gds-prt.node-name <> '_Пустая шкала':U)  then gds-prt.f-name  else "" ) else "" @ gds-prt.f-name
     8961       chk-gds.is-error
     8962       chk-gds.src-code
     8963       chk-gds.pump
     8964       if avail bar-code then clients.obj-name else "" @ clients.obj-name
     8965       chk-gds.doc-qnty
     8966       if avail bar-code then bar-code.unit-cli else "" @ bar-code.unit-cli
     8967       (chk-gds.price-base + chk-gds.price-service) @ chk-gds.price-base
     8968       chk-gds.discnt
     8969       fgds-discnt-pc
     8970       for-gds-price
     8971       (if chk-gds.write-off-code <> ?
     8972       and chk-gds.write-off-code <> 0
     8973       then yes
     8974       else no
     8975       )  @ v-write-off
     8976       WITH FRAME Goods-Frame.
     8977       DOWN STREAM PrnLibStream with FRAME Goods-Frame .
     8978       assign
     8979       accum-count = accum-count + 1
     8980       accum-qnty = accum-qnty + chk-gds.doc-qnty
     8981       accum-tot-doc = accum-tot-doc + chk-gds.doc-qnty * (chk-gds.price-base + price-service)
     8982       accum-discnt = accum-discnt + chk-gds.doc-qnty * chk-gds.discnt
     8983       accum-netto = accum-netto + chk-gds.doc-qnty * (chk-gds.price-base + chk-gds.price-service - chk-gds.discnt)
     8984       .
     8985     END.
     8986     GET next br-docs  no-lock.
     8987   END.
     8988   UNDERLINE  STREAM PrnLibStream
     8989   chk-gds.doc-code
     8990   chk-gds.line-num
     8991   chk-gds.b-code
     8992   goods.artic
     8993   goods.gds-name
     8994   gds-prt.f-name
     8995   chk-gds.is-error
     8996   chk-gds.src-code
     8997   chk-gds.pump
     8998   clients.obj-name
     8999   chk-gds.doc-qnty
     9000   bar-code.unit-cli
     9001   chk-gds.price-base
     9002   chk-gds.discnt
     9003   fgds-discnt-pc
     9004   for-gds-price
     9005   v-write-off
     9006   with FRAME Goods-Frame .
     9007   DISPLAY STREAM PrnLibStream
     9008   "ИТОГО"  @ chk-gds.doc-code
     9009   "_" @ chk-gds.line-num
     9010   accum-count @ chk-gds.b-code
     9011   "_" @ goods.artic
     9012   "_" @ goods.gds-name
     9013   "_" @ gds-prt.f-name
     9014   "_" @ chk-gds.is-error
     9015   "_" @ chk-gds.src-code
     9016   "_" @ chk-gds.pump
     9017   "_" @ clients.obj-name
     9018   ACCUM-qnty @ chk-gds.doc-qnty
     9019   "_" @ bar-code.unit-cli
     9020   accum-tot-doc @ chk-gds.price-base
     9021   (accum-discnt / accum-tot-doc * 100) @ fgds-discnt-pc
     9022   accum-discnt @ chk-gds.discnt
     9023   accum-netto @ for-gds-price
     9024   "_" @ v-write-off
     9025   WITH FRAME Goods-Frame.
     9026   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     9027   HIDE  STREAM PrnLibStream FRAME Goods-Frame.
     9028   output  STREAM PrnLibStream CLOSE.
     9029   run waitfram-hide in this-procedure .
     9030   run prn-lib-prn-file in this-procedure (
     9031                                             input parParentProc
     9032                                             ,input 9
     9033                                             ).
     9034   END PROCEDURE.
     9035   PROCEDURE PrintprocGds-List :
     9036   define variable v-num as integer no-undo.
     9037   define variable f-name as char no-undo.
     9038   define variable lns-cnt as integer no-undo .
     9039   define variable line-rec as recid no-undo .
     9040   DEFINE VARIABLE ii as integer no-undo .
     9041   define variable glog as logical no-undo .
     9042   run waitfram-show in this-procedure ( input "Ждите...").
     9043   FOR EACH gds-list :
     9044     delete gds-list .
     9045   END .
     9046   FOR EACH gds-bar :
     9047     delete gds-bar .
     9048   END .
     9049   GET next br-docs  no-lock.
     9050   ii = 0.
     9051   DO WHILE available c-doc :
     9052     FOR EACH ub.chk-gds NO-LOCK Where
     9053              ub.chk-gds.doc-code = c-doc.doc-code by chk-gds.line-num:
     9054       FIND FIRST ub.bar-code No-LOCK WHERE
     9055                  ub.bar-code.b-code = ub.chk-gds.b-code NO-ERROR.
     9056       IF AVAIL ub.bar-code then do:
     9057         FIND FIRST ub.goods NO-LOCK WHERE
     9058                    ub.goods.gds-code = ub.bar-code.gds-code NO-ERROR.
     9059         FIND FIRST ub.gds-prt No-LOCK where
     9060                    ub.gds-prt.upper-code = ub.goods.prt-root NO-ERROR.
     9061   define variable vss-include-info97 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9062   find gds-list
     9063     where gds-list.prod-type = goods.prod-type
     9064       and gds-list.prod-code = goods.prod-code
     9065       and gds-list.artic     = goods.artic
     9066     no-error .
     9067   if available gds-list then do:
     9068     assign
     9069       gds-list.to-del = no
     9070     .
     9071   end.
     9072   else do:
     9073     define variable v-last97 as integer no-undo .
     9074     find last gds-list use-index oi no-error.
     9075     if available gds-list then do:
     9076       v-last97 = gds-list.order-num .
     9077     end.
     9078     else do:
     9079       v-last97 = 0 .
     9080     end.
     9081     create gds-list .
     9082     buffer-copy goods to gds-list
     9083     assign
     9084       gds-list.to-del = no
     9085       gds-list.order-num = v-last97 + 1
     9086     .
     9087     assign
     9088       lns-cnt = lns-cnt + 1
     9089       line-rec = recid (gds-list)
     9090     .
     9091   end.
     9092         assign
     9093         gds-list.qnty = gds-list.qnty + ub.chk-gds.doc-qnty.
     9094         FIND FIRST gds-bar where gds-bar.b-code = ub.bar-code.b-code No-ERROR.
     9095         if not avail gds-bar then do:
     9096           create gds-bar.
     9097           assign
     9098           gds-bar.b-code = ub.bar-code.b-code.
     9099         end.
     9100         assign
     9101         gds-bar.qnty = gds-bar.qnty + ub.chk-gds.doc-qnty.
     9102        end.
     9103     END.
     9104     GET next br-docs  no-lock.
     9105   END.
     9106   run waitfram-hide in this-procedure .
     9107   REPEAT while v-num <> 4:
     9108   run gbl/d-askw.w (
     9109                input "Сохранение списка товаров"
     9110               ,input "Выберите формат для сохранения списка товаров"
     9111               ,input "|"
     9112               ,input "Файл списка товаров|Файл мобильного сканера|Таблица EXCEL|Отказ"
     9113               ,input "|||"
     9114               ,input 1
     9115               ,input 4
     9116               ,output v-num ).
     9117   if v-num = 4 then return.
     9118   CASE v-num:
     9119     when 1 then do:
     9120       assign
     9121         f-name = "default.gds"
     9122         glog = yes
     9123         .
     9124       system-dialog get-file f-name
     9125         filters "Списки товаров *.gds" "*.gds"
     9126         ask-overwrite
     9127         save-as
     9128         use-filename
     9129         update glog
     9130         default-extension "gds".
     9131       if not glog then do:
     9132         return.
     9133       end.
     9134       output to value (f-name).
     9135       for each gds-list:
     9136         export gds-list.prod-type
     9137               gds-list.prod-code
     9138               gds-list.artic
     9139               gds-list.qnty
     9140               .
     9141       end.
     9142       output close.
     9143     end.
     9144     when 2 then do:
     9145       assign
     9146         f-name = "default.inv"
     9147         glog = yes
     9148         .
     9149       system-dialog get-file f-name
     9150         filters "Инвентаризация касса *.inv" "*.inv"
     9151         ask-overwrite
     9152         save-as
     9153         use-filename
     9154         update glog
     9155         default-extension "inv".
     9156       if not glog then do:
     9157         return .
     9158       end.
     9159       run waitfram-show in this-procedure ( input "Сохранение в формате мобильного сканера.    ЖДИТЕ...").
     9160       output to value (f-name).
     9161       for each gds-bar NO-LOCK:
     9162         if gds-bar.qnty <> 0 then
     9163           put unformatted string (gds-bar.b-code) + "," + string (gds-bar.qnty) skip.
     9164       end.
     9165       output close.
     9166       run waitfram-hide in this-procedure .
     9167     end.
     9168     when 3 then do:
     9169       do on stop  undo, return no-apply
     9170         on error undo, return no-apply
     9171         on quit  undo, return no-apply
     9172       :
     9173         run str/gdsl-xls.p (
     9174                              input parparentproc
     9175                            , input parobj-type
     9176                            , input parobj-code) no-error.
     9177         run waitfram-hide in this-procedure .
     9178       end.
     9179     end.
     9180   END CASE.
     9181   end.
     9182   END PROCEDURE.
     9183   PROCEDURE PrintProcPay :
     9184   define variable date_string     as      char    no-undo.
     9185   define variable Line                as      char    no-undo.
     9186   define variable for-time as char.
     9187   define variable accum-count as integer.
     9188   define variable accum-tot-base as decima.
     9189   define variable accum-tot-rubl as decimal.
     9190   define variable pay-card-num like ub.chk-pay.pay-card no-undo .
     9191   DEFINE FRAME Pay-Frame
     9192   ub.chk-pay.doc-code column-label "Номер_чека" FORMAT "X(20)"
     9193   ub.chk-pay.line-num column-label "NN"
     9194   ub.chk-pay.curr-code column-label "Код. вал"
     9195   ub.currency.curr-name column-label "Валюта" FORMAT "X(15)"
     9196   ub.chk-pay.pay-code Column-label "Код платежа"
     9197   ub.cash-pay.obj-name COLUMn-LABEL "Платеж"
     9198   pay-card-num COLUMN-LABEL "Платежн.карта"
     9199   ub.chk-pay.tot-sum COLUMN-LABEL "Сумма в вал. платежа"
     9200   ub.chk-pay.tot-base COLUMN-LABEL "Сумма в баз.вал"
     9201   ub.chk-pay.tot-rubl  COLUMN-LABEL "Сумма в рублях"
     9202   HEADER  date_string AT 5 format "X(35)"
     9203   v-header-base-curr        format "X(20)" AT 42
     9204   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>>>9" SKIP
     9205   Line format "X(175)" AT 1
     9206   with width 232 down stream-io use-text    .
     9207   Line = fill("-", 175).
     9208   date_string = cur-time-print() .
     9209   run prn-lib-open-stream  in this-procedure (
     9210                                                input parParentProc
     9211                                               ,input 43
     9212                                               ,input yes
     9213                                               ,input no
     9214                                               ).
     9215   PUT  STREAM PrnLibStream
     9216   SPACE(25) ( frame Dialog-Frame:title  + ": оплаты")
     9217   format "x(90)" SKIP(1) .
     9218   FORM HEADER
     9219   Line format "X(175)" AT 1 SKIP
     9220   "Продолжение - на следующей странице" AT 30 SKIP
     9221   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     9222   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     9223   FORM with FRAME Pay-Frame  .
     9224   run waitfram-show in this-procedure ( input "Ждите...").
     9225   GET next br-docs  no-lock.
     9226   for each temp-pay:
     9227     delete temp-pay.
     9228   end.
     9229   DO WHILE available c-doc :
     9230     FOR EACH chk-pay No-LOCK WHERE chk-pay.doc-code = c-doc.doc-code by chk-pay.line-num:
     9231       FIND FIRST currency No-LOCK WHERE
     9232                  currency.curr-code = chk-pay.curr-code NO-ERROR.
     9233       FIND FIRST cash-pay No-LOCK WHERE
     9234                           cash-pay.cdpay-code = chk-pay.pay-code AND
     9235                           cash-pay.curr-code = chk-pay.curr-code No-ERROR.
     9236       find first temp-pay WHERE
     9237                  temp-pay.pay-code = chk-pay.pay-code AND
     9238                  temp-pay.curr-code = chk-pay.curr-code NO-ERROR.
     9239       if not avail temp-pay then do:
     9240         create temp-pay.
     9241         buffer-copy chk-pay except tot-base tot-sum tot-rubl line-num to temp-pay
     9242         assign temp-pay.line-num = 0
     9243         .
     9244       end.
     9245       assign
     9246       temp-pay.tot-sum = temp-pay.tot-sum + chk-pay.tot-sum
     9247       temp-pay.tot-base = temp-pay.tot-base + chk-pay.tot-base
     9248       temp-pay.tot-rubl = temp-pay.tot-rubl + chk-pay.tot-rubl
     9249       temp-pay.line-num = temp-pay.line-num + 1
     9250       .
     9251       DISPLAY STREAM PrnLibStream
     9252       chk-pay.doc-code
     9253       chk-pay.line-num
     9254       chk-pay.curr-code
     9255       if avail currency then currency.curr-name else "НЕОПОЗНАННАЯ ВАЛЮТА" @ currency.curr-name
     9256       chk-pay.pay-code
     9257       if avail cash-pay then cash-pay.obj-name else "НЕОПОЗНАННАЯ ОПЛАТА" @ cash-pay.obj-name
     9258       f-paycardv(chk-pay.pay-card, chk-pay.pay-code, chk-pay.curr-code) @ pay-card-num
     9259       chk-pay.tot-sum
     9260       chk-pay.tot-base
     9261       chk-pay.tot-rubl
     9262       WITH FRAME Pay-Frame.
     9263       DOWN STREAM PrnLibStream  with frame Pay-Frame.
     9264       assign
     9265       accum-count = accum-count + 1
     9266       accum-tot-rubl = accum-tot-rubl + chk-pay.tot-rubl
     9267       accum-tot-base = accum-tot-base + chk-pay.tot-base
     9268       .
     9269     END.
     9270     GET next br-docs  no-lock.
     9271   END.
     9272   UNDERLINE  STREAM PrnLibStream
     9273   chk-pay.doc-code
     9274   chk-pay.line-num
     9275   chk-pay.curr-code
     9276   currency.curr-name
     9277   chk-pay.pay-code
     9278   cash-pay.obj-name
     9279   pay-card-num
     9280   chk-pay.tot-sum
     9281   chk-pay.tot-base
     9282   chk-pay.tot-rubl
     9283   with FRAME Pay-Frame .
     9284   for each temp-pay No-LOCK
     9285       by temp-pay.pay-code
     9286       by temp-pay.curr-code:
     9287       FIND FIRST currency No-LOCK WHERE
     9288                  currency.curr-code = temp-pay.curr-code NO-ERROR.
     9289       FIND FIRST cash-pay No-LOCK WHERE
     9290                           cash-pay.cdpay-code = temp-pay.pay-code AND
     9291                           cash-pay.curr-code = temp-pay.curr-code No-ERROR.
     9292       DISPLAY STREAM PrnLibStream
     9293       "кол. по типу оплаты:" @ chk-pay.doc-code
     9294       (if temp-pay.line-num < 1000 then temp-pay.line-num else ?) @ chk-pay.line-num
     9295       temp-pay.curr-code @ chk-pay.curr-code
     9296       if avail currency then currency.curr-name else "НЕОПОЗНАННАЯ ВАЛЮТА" @ currency.curr-name
     9297       temp-pay.pay-code @ chk-pay.pay-code
     9298       if avail cash-pay then cash-pay.obj-name else "НЕОПОЗНАННАЯ ОПЛАТА" @ cash-pay.obj-name
     9299       temp-pay.tot-sum @ chk-pay.tot-sum
     9300       temp-pay.tot-base @ chk-pay.tot-base
     9301       temp-pay.tot-rubl @ chk-pay.tot-rubl
     9302       WITH FRAME Pay-Frame.
     9303       DOWN STREAM PrnLibStream  with frame Pay-Frame.
     9304   end.
     9305   UNDERLINE  STREAM PrnLibStream
     9306   chk-pay.doc-code
     9307   chk-pay.line-num
     9308   chk-pay.curr-code
     9309   currency.curr-name
     9310   chk-pay.pay-code
     9311   cash-pay.obj-name
     9312   pay-card-num
     9313   chk-pay.tot-sum
     9314   chk-pay.tot-base
     9315   chk-pay.tot-rubl
     9316   with FRAME Pay-Frame .
     9317   DISPLAY STREAM PrnLibStream
     9318   "ИТОГО"  @ chk-pay.doc-code
     9319   (if accum-count < 1000 then accum-count else ? )  @ chk-pay.line-num
     9320   "_" @ chk-pay.curr-code
     9321   "_" @ chk-pay.pay-code
     9322   "_" @ cash-pay.obj-name
     9323   string(accum-count) @ currency.curr-name
     9324   accum-tot-base @ chk-pay.tot-base
     9325   accum-tot-rubl @ chk-pay.tot-rubl
     9326   "_" @ chk-pay.tot-sum
     9327   with frame Pay-Frame.
     9328   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     9329   HIDE  STREAM PrnLibStream FRAME Pay-Frame.
     9330   output  STREAM PrnLibStream CLOSE.
     9331   run waitfram-hide in this-procedure .
     9332   run prn-lib-prn-file in this-procedure (
     9333                                             input parParentProc
     9334                                             ,input 8
     9335                                             ).
     9336   END PROCEDURE.
     9337   PROCEDURE proc-b-chg :
     9338   define input parameter p-change-type as character no-undo .
