     9420                                     )
     9421           .
     9422         end.
     9423         else do:
     9424   define variable vss-include-info100 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9425   do:
     9426     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     9427       (input  v-cntxt-db-num
     9428       ,input  v-cntxt-userid
     9429       ,input  0
     9430       ,input  'actn_receipt_input':U
     9431       ,input  'object':U
     9432       ,input  v-host-code
     9433       ,input  c-doc.obj-type
     9434       ,input  c-doc.obj-code
     9435       ,input  0
     9436       ,input  0
     9437       ,input  0
     9438       ,input  true
     9439       ,output glog
     9440       )  .
     9441   end.
     9442     if NOT glog then return no-apply.
     9443           run str/superchk.w
     9444                           (
     9445                             input parparentproc
     9446                           ,input 'ИЗМЕНЕНИЕ':U
     9447                           ,input c-doc.obj-type
     9448                           ,input c-doc.obj-code
     9449                           ,input-output v-doc-rec
     9450                           ,input ?
     9451                           ,input-output next-prev
     9452                                     )
     9453           .
     9454         end.
     9455         RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     9456         REPOSITION br-docs to recid v-doc-rec no-error .
     9457       end.
     9458       when "list-shift":U then do:
     9459         if p-change-type = "list-shift" then do:
     9460           message
     9461           "Вы хотите изменить дату, номер смены или резервуар для чеков?" skip
     9462           string(if index(frame Dialog-Frame:title,"ФИЛЬТР" ) = 0 then
     9463           "Эта процедура может занять долгое время! Продолжать?"
     9464           else "":U)
     9465           view-as alert-box WARNING buttons YES-NO update glog.
     9466           if NOT glog then return error.
     9467           run str/chgshift.w (
     9468                          input parparentproc
     9469                         ,input parobj-type
     9470                         ,input parobj-code
     9471                         ,output v-shift-date
     9472                         ,output v-shift-num
     9473                         ,output v-shift-name
     9474                         ,output v-shift-reservoir-from
     9475                         ,output v-shift-reservoir-to
     9476                         ,output v-change-fields
     9477                         ,output v-can-back-shift
     9478                         ).
     9479           if v-change-fields = '':U then return error.
     9480         end.
     9481   define variable vss-include-info101 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9482   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     9483     (input  'маг':U
     9484     ,input  parobj-code
     9485     ,input  'shift-on=request'
     9486     ,output l-shift-on
     9487     )  .
     9488         DO WHILE available c-doc :
     9489           GET prev br-docs  no-lock.
     9490         END.
     9491         GET next br-docs.
     9492         if p-change-type = "list-shift" then do:
     9493         _shift:
     9494         DO WHILE available c-doc
     9495         on error undo, next _shift
     9496         on stop undo, next _shift
     9497         :
     9498           run waitfram-show in this-procedure ( input "Ждите...").
     9499           assign
     9500           v-doc-rec = recid(c-doc)
     9501           v-added = no
     9502           v-changed = no.
     9503           .
     9504           run str/chkshift.p (
     9505                             input parparentproc
     9506                            ,input l-shift-on
     9507                            ,input v-doc-rec
     9508                            ,input v-shift-date
     9509                            ,input v-shift-num
     9510                            ,input v-shift-name
     9511                            ,input v-shift-reservoir-from
     9512                            ,input v-shift-reservoir-to
     9513                            ,input v-change-fields
     9514                            ,input v-can-back-shift
     9515                            ,output v-added
     9516                            ,output v-changed
     9517                             ) no-error.
     9518           if error-status:error then do:
     9519               GET next br-docs.
     9520               NEXT _shift.
     9521           end.
     9522           if v-changed then
     9523               assign
     9524                   v-changed-num = v-changed-num + 1.
     9525           if v-added then
     9526               assign
     9527                   v-added-num = v-added-num + 1
     9528           .
     9529           if v-first-record = ? then v-first-record = v-doc-rec.
     9530           GET next br-docs.
     9531        END.
     9532        run waitfram-hide in this-procedure .
     9533        end.
     9534        change-type = "".
     9535        RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     9536        APPLY "page-UP"   to br-docs.
     9537        APPLY "page-down"   to br-docs.
     9538        reposition br-docs to recid v-first-record no-error.
     9539        apply "entry" to br-docs in frame Dialog-Frame.
     9540        if l-shift-on and p-change-type = "list-shift" then do:
     9541         message
     9542         substitute("В результате изменения даты/номера смены или резервуара в указанной смене появилось &1 чеков, изменено &2 чеков", v-added-num, v-changed-num)
     9543         view-as alert-box  .
     9544        end.
     9545        if p-change-type = "list-pump" then do:
     9546         message
     9547         substitute("N ТРК изменен для &1 чеков", v-added-num)
     9548         view-as alert-box .
     9549        end.
     9550       end.
     9551     END CASE.
     9552   end.
     9553     run trg/userlog.p (
     9554       input 'update':U
     9555       , input 'chk-doc':U
     9556       , input ( buffer c-doc :handle )
     9557       , input ?
     9558       , input ""
     9559       ) no-error.
     9560     if error-status :error
     9561       then
     9562     do:
     9563       undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
     9564         , chr(10)
     9565         , vss-workfile
     9566         , return-value
     9567         , error-status :get-message ( 1 ) ).
     9568     end.
     9569   END PROCEDURE.
     9570   PROCEDURE proc-b-del :
     9571   define input parameter del-type as character no-undo.
     9572   define variable old-netto as decimal no-undo.
     9573   define variable old-tot-doc as decimal no-undo.
     9574   define variable old-discnt as decimal no-undo.
     9575   DEFINE VARIABLE v-first-record as recid no-undo .
     9576   define variable glog as logical no-undo .
     9577   define variable v-doc-rec as recid no-undo .
     9578   define variable v-host-code as integer no-undo .
     9579   define variable varlog as logical no-undo .
     9580   define buffer del_chk-doc for ub.chk-doc.
     9581   define buffer buf_inkas for ub.inkas.
     9582   define buffer buf_trn-doc for ub.trn-doc.
     9583   define variable vss-include-info102 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9584   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     9585     (input  parobj-type
     9586     ,input  parobj-code
     9587     ,output v-host-code
     9588     )  .
     9589   define variable vss-include-info103 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9590   do:
     9591     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     9592       (input  v-cntxt-db-num
     9593       ,input  v-cntxt-userid
     9594       ,input  0
     9595       ,input  'actn_receipts_deletion':U
     9596       ,input  'object':U
     9597       ,input  v-host-code
     9598       ,input  c-doc.obj-type
     9599       ,input  c-doc.obj-code
     9600       ,input  0
     9601       ,input  0
     9602       ,input  0
     9603       ,input  true
     9604       ,output glog
     9605       )  .
     9606   end.
     9607     if NOT glog then return no-apply.
     9608   case del-type:
     9609     when "list":U then do:
     9610       IF par-mode = 'продажа':U then do:
     9611         if index(frame Dialog-Frame:title,"ФИЛЬТР" ) = 0
     9612         and p-chk-type = 0
     9613         then do:
     9614           message
     9615           "Вы хотите исключить ВСЕ чеки из продажи!" skip
     9616           "Эта процедура может занять долгое время! Продолжать?"
     9617           view-as alert-box WARNING buttons YES-NO update glog.
     9618           if NOT glog then return no-apply.
     9619         end.
     9620         ELSE DO:
     9621           message
     9622           "Вы действительно хотите исключить ВСЕ чеки по текущему списку из продажи?!" skip
     9623           view-as alert-box WARNING buttons YES-NO update glog.
     9624           if NOT glog then return no-apply.
     9625         END.
     9626       end.
     9627       ELSE DO:
     9628         IF par-mode = 'vt':U then do:
     9629           message
     9630           "Вы действительно хотите исключить ВСЕ чеки по текущему списку из инвентаризации?!" skip
     9631           view-as alert-box WARNING buttons YES-NO update glog.
     9632           if NOT glog then return no-apply.
     9633         end.
     9634         else do:
     9635           if index(frame Dialog-Frame:title,"ФИЛЬТР" ) = 0
     9636           and p-chk-type = 0
     9637           then do:
     9638             message
     9639             "Вы хотите удалить ВСЕ НЕУЧТЕННЫЕ чеки по объекту!" skip
     9640             "Эта процедура может занять долгое время! Продолжать?" view-as alert-box
     9641             WARNING buttons YES-NO update glog.
     9642             if NOT glog then return no-apply.
     9643           end.
     9644           ELSE DO:
     9645             message
     9646             "Вы действительно хотите удалить ВСЕ НЕУЧТЕННЫЕ чеки по текущему списку?!" skip
     9647             view-as alert-box WARNING buttons YES-NO update glog.
     9648             if NOT glog then return no-apply.
     9649           END.
     9650         end.
     9651       end.
     9652     end.
     9653   END CASE.
     9654   CASE par-mode:
     9655     WHEN 'продажа':U then do:
     9656       if del-type = "list" then do:
     9657         DO WHILE available c-doc :
     9658               GET prev br-docs  no-lock.
     9659         END.
     9660         GET next br-docs.
     9661         _list0:
     9662         DO WHILE available c-doc
     9663         on error undo, next _list0
     9664         on stop undo, next _list0
     9665         :
     9666           FIND FIRST del_chk-doc where
     9667                             recid (del_chk-doc) = recid(c-doc) No-ERROR.
     9668           if not avail del_chk-doc then NEXT _list0.
     9669           if del_chk-doc.out-code <> ? then DO  :
     9670             run waitfram-show in this-procedure ( input "Ждите...").
     9671             FIND FIRST buf_inkas No-LOCK WHERE
     9672                             buf_inkas.inkas-code = del_chk-doc.out-code No-ERROR.
     9673             assign
     9674             old-netto = buf_inkas.netto
     9675             old-tot-doc = buf_inkas.tot-doc
     9676             old-discnt = buf_inkas.discnt.
     9677             if lookup(string(del_chk-doc.chk-type), '2,3,4,5,7':U) > 0 then do:
     9678               run str/exclwchk.p ( input parparentproc,  input v-curr-r-b, buffer del_chk-doc) no-error.
     9679             end.
     9680             else do:
     9681               run str/excl-chk.p ( input parparentproc,  input v-curr-r-b, buffer del_chk-doc) no-error.
     9682             end.
     9683             if error-status:error OR
     9684             (del_chk-doc.chk-type <> integer('43':U) and del_chk-doc.chk-type <> integer('44':U)
     9685             and
     9686             (buf_inkas.netto <> old-netto  - del_chk-doc.netto OR
     9687             buf_inkas.tot-doc <> old-tot-doc  - del_chk-doc.tot-doc OR
     9688             buf_inkas.discnt <> old-discnt - del_chk-doc.discnt)
     9689             )
     9690             then do:
     9691               message
     9692               substitute("Исключение чека &1 из продажи &2 не удалось:&3&4 &5"
     9693                       ,del_chk-doc.doc-code
     9694                       ,del_chk-doc.out-code
     9695                       , chr(10)
     9696                       ,error-status:get-message(1)
     9697                       ,return-value
     9698                       )
     9699               view-as alert-box ERROR.
     9700               undo, NEXT.
     9701             end.
     9702             deleted = yes.
     9703           END.
     9704           GET next br-docs.
     9705         END.
     9706         run waitfram-hide in this-procedure .
     9707         del-type = "".
     9708         RUN OpenBr in this-procedure  ( input yes, input no, input '':U).
     9709         APPLY "page-UP"   to br-docs.
     9710         APPLY "page-down"   to br-docs.
     9711         reposition br-docs to row 1 no-error.
     9712         apply "entry" to br-docs in frame Dialog-Frame.
     9713       end.
     9714       if del-type = "one":U then do:
     9715         if available c-doc then do:
     9716           if c-doc.out-code <> ? then do:
     9717             FIND FIRST del_chk-doc where
     9718                       recid (del_chk-doc) = recid(c-doc) No-ERROR.
     9719             if not avail del_chk-doc then return error.
     9720             varlog = br-docs:select-next-row().
     9721             if not varlog then varlog = br-docs:select-prev-row().
     9722             v-doc-rec = recid(c-doc).
     9723             FIND FIRST buf_inkas No-LOCK WHERE
     9724                       buf_inkas.inkas-code = del_chk-doc.out-code No-ERROR.
     9725             assign
     9726             old-netto = buf_inkas.netto
     9727             old-tot-doc = buf_inkas.tot-doc
     9728             old-discnt = buf_inkas.discnt.
     9729             if lookup(string(del_chk-doc.chk-type), '2,3,4,5,7':U) > 0 then do:
     9730               run str/exclwchk.p ( input parparentproc,  input v-curr-r-b, buffer del_chk-doc) no-error.
     9731             end.
     9732             else do:
     9733               run str/excl-chk.p ( input parparentproc, input v-curr-r-b, buffer del_chk-doc) no-error.
     9734             end.
     9735             if error-status:error  OR
     9736             buf_inkas.netto <> old-netto  - del_chk-doc.netto OR
     9737             buf_inkas.tot-doc <> old-tot-doc  - del_chk-doc.tot-doc OR
     9738             buf_inkas.discnt <> old-discnt - del_chk-doc.discnt then do:
     9739               message
     9740               substitute("Исключение чека &1 из продажи &2 не удалось:&3&4 &5"
     9741                       ,del_chk-doc.doc-code
     9742                       ,del_chk-doc.out-code
     9743                       , chr(10)
     9744                       ,error-status:get-message(1)
     9745                       ,return-value
     9746                       )
     9747               view-as alert-box ERROR.
     9748               undo, return error .
     9749             end.
     9750             deleted = yes.
     9751             RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     9752             reposition br-docs to recid v-doc-rec no-error.
     9753             APPLY "ENTRY" to br-docs.
     9754             APPLY "VALUE-CHANGED" to br-docs.
     9755             return no-apply.
     9756           end.
     9757         end.
     9758       end.
     9759     END.
     9760     WHEN 'vt':U then do:
     9761       if del-type = "list" then do:
     9762         DO WHILE available c-doc :
     9763           GET prev br-docs no-lock.
     9764         END.
     9765         GET next br-docs.
     9766         _list0:
     9767         DO WHILE available c-doc
     9768         on error undo, next _list0
     9769         on stop undo, next _list0
     9770         :
     9771           v-doc-rec = recid( c-doc ).
     9772           FIND FIRST del_chk-doc where
     9773                             recid (del_chk-doc) = v-doc-rec No-ERROR.
     9774           if not avail del_chk-doc then NEXT _list0.
     9775           if del_chk-doc.out-code <> ? then DO  :
     9776             run waitfram-show in this-procedure ( input "Ждите...").
     9777             FIND FIRST buf_trn-doc No-LOCK WHERE
     9778                             buf_trn-doc.doc-code = del_chk-doc.out-code No-ERROR.
     9779             run str/exclichk.p ( input parparentproc,   buffer del_chk-doc) no-error.
     9780             if error-status:error then do:
     9781               message
     9782               substitute("Исключение чека &1 из инвентаризации &2 не удалось:&3&4 &5"
     9783                       ,del_chk-doc.doc-code
     9784                       ,del_chk-doc.out-code
     9785                       , chr(10)
     9786                         ,error-status:get-message(1)
     9787                         ,return-value
     9788                         )
     9789                 view-as alert-box ERROR.
     9790                 undo, NEXT.
     9791               end.
     9792               deleted = yes.
     9793             END.
     9794             GET next br-docs .
     9795           END.
     9796           run waitfram-hide in this-procedure .
     9797           del-type = "".
     9798           RUN OpenBr in this-procedure( input yes,  input no,  input '':U).
     9799           APPLY "page-UP"   to br-docs.
     9800           APPLY "page-down"   to br-docs.
     9801           reposition br-docs to row 1 no-error.
     9802           apply "entry" to br-docs in frame Dialog-Frame.
     9803         end.
     9804         if del-type = "one":U then do:
     9805           if available c-doc then do:
     9806             if c-doc.out-code <> ? then do:
     9807               v-doc-rec = recid (c-doc).
     9808               FIND FIRST del_chk-doc where
     9809                         recid (del_chk-doc) = v-doc-rec No-ERROR.
     9810               if not avail del_chk-doc then return error.
     9811               varlog = br-docs:select-next-row().
     9812               if not varlog then varlog = br-docs:select-prev-row().
     9813               v-doc-rec = recid(c-doc).
     9814               FIND FIRST buf_trn-doc No-LOCK WHERE
     9815                         buf_trn-doc.doc-code = del_chk-doc.out-code No-ERROR.
     9816               run str/exclichk.p ( input parparentproc, buffer del_chk-doc) no-error.
     9817               if error-status:error  then do:
     9818                 message
     9819                 substitute("Исключение чека &1 из инвентаризации &2 не удалось:&3&4 &5"
     9820                         ,del_chk-doc.doc-code
     9821                         ,del_chk-doc.out-code
     9822                         , chr(10)
     9823                         ,error-status:get-message(1)
     9824                         ,return-value
     9825                         )
     9826                 view-as alert-box ERROR.
     9827                 undo, return error .
     9828               end.
     9829               deleted = yes.
     9830               RUN OpenBr in this-procedure( input yes,  input no,  input '':U).
     9831               reposition br-docs to recid v-doc-rec no-error.
     9832               APPLY "ENTRY" to br-docs.
     9833               APPLY "VALUE-CHANGED" to br-docs.
     9834               return no-apply.
     9835             end.
     9836           end.
     9837         end.
     9838       END.
     9839       OTHERWISE DO:
     9840         CASE del-type:
     9841           when "list":U then do:
     9842             DO WHILE available c-doc :
     9843               GET prev br-docs  no-lock.
     9844             END.
     9845             GET next br-docs.
     9846             _list1:
     9847             DO WHILE available c-doc
     9848             on error undo, next _list1
     9849             on stop undo, next _list1
     9850             :
     9851               run waitfram-show in this-procedure ( input "Ждите...").
     9852               FIND FIRST del_chk-doc where recid(del_chk-doc) = recid(c-doc) no-error.
     9853               if not avail del_chk-doc then next _list1.
     9854               run trg/userlog.p (
     9855                 input 'delete':U
     9856                 , input 'chk-doc':U
     9857                 , input ( buffer del_chk-doc :handle )
     9858                 , input ?
     9859                 , input ""
     9860                 ) no-error.
     9861               if error-status :error
     9862                 then
     9863               do:
     9864                 undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
     9865                   , chr(10)
     9866                   , vss-workfile
     9867                   , return-value
     9868                   , error-status :get-message ( 1 ) ).
     9869               end.
     9870               if del_chk-doc.out-code = ? then delete del_chk-doc no-error .
     9871               if error-status:error then do:
     9872                  message
     9873                  error-status:get-message(1) skip
     9874                  return-value
     9875                  view-as alert-box .
     9876               end.
     9877               GET next br-docs.
     9878             END.
     9879             run waitfram-hide in this-procedure .
     9880             del-type = "".
     9881             RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     9882             APPLY "page-UP"   to br-docs.
     9883             APPLY "page-down"   to br-docs.
     9884             reposition br-docs to row 1 no-error.
     9885             apply "entry" to br-docs in frame Dialog-Frame.
     9886           end.
     9887           when "one":U then do:
     9888             if NOT available c-doc then do:
     9889               message "Неправильно выбран чек." view-as alert-box ERROR.
     9890               return no-apply.
     9891             end.
     9892             FIND del_chk-doc where recid (del_chk-doc) = recid(c-doc) No-ERROR.
     9893             if not avail del_chk-doc then return error.
     9894             varlog = br-docs:select-next-row().
     9895             if not varlog then varlog = br-docs:select-prev-row().
     9896             v-doc-rec = recid(c-doc).
     9897             run trg/userlog.p (
     9898                 input 'delete':U
     9899                 , input 'chk-doc':U
     9900                 , input ( buffer del_chk-doc :handle )
     9901                 , input ?
     9902                 , input ""
     9903                 ) no-error.
     9904               if error-status :error
     9905                 then
     9906               do:
     9907                 undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
     9908                   , chr(10)
     9909                   , vss-workfile
     9910                   , return-value
     9911                   , error-status :get-message ( 1 ) ).
     9912               end.
     9913             if del_chk-doc.out-code = ?  then delete del_chk-doc no-error.
     9914             if error-status:error then do:
     9915               message
     9916               error-status:get-message(1) skip
     9917               return-value
     9918               view-as alert-box .
     9919               del-type = "".
     9920               return no-apply.
     9921             end.
     9922             del-type = "".
     9923             RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     9924             reposition br-docs to recid v-doc-rec no-error.
     9925             APPLY "ENTRY" to br-docs.
     9926             APPLY "VALUE-CHANGED" to br-docs.
     9927             return no-apply.
     9928           end.
     9929       END CASE.
     9930     END.
     9931   END CASE.
     9932   END PROCEDURE.
     9933   PROCEDURE proc-b-sch :
