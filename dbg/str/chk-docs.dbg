     3882                             input this-procedure:handle
     3883                             ,input QUERY br-docs:handle
     3884                             ,input logical(parameter-2-39)
     3885                             ,input no-lock
     3886                             ,input parameter-3-39
     3887                             ,input parameter-4-39
     3888                             ,input parameter-5-39
     3889                             ,input parameter-6-39
     3890                             ,input parameter-7-39
     3891                             ,output v-fltopend-rowid
     3892                             ) no-error.
     3893         .
     3894         v-doc-rec = ?.
     3895       end.
     3896       assign
     3897         l-query-was-opened = true
     3898       .
     3899     end.
     3900   end.
     3901     run waitfram-hide in this-procedure .
