     1114   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1115   define variable paycardv as character no-undo .
     1116   FUNCTION f-paycardv RETURNS CHARACTER(input p-pay-card as character, p-cash-pay-obj-code as integer, p-cash-pay-curr-code as integer):
     1117   define variable kk as integer no-undo .
     1118   define variable pay-card-num as character no-undo .
     1119   define buffer buf_cash-pay for ub.cash-pay.
     1120   find first buf_cash-pay no-lock where
     1121              buf_cash-pay.cdpay-code = p-cash-pay-obj-code
     1122          AND buf_cash-pay.curr-code = p-cash-pay-curr-code no-error .
     1123   if not avail buf_cash-pay then return "":U.
     1124   if p-pay-card = "":u
     1125   or p-pay-card = ? then return "":U.
     1126   assign
     1127   pay-card-num = "":U
     1128   .
     1129   _kk:
     1130   do kk = 1 to num-entries(buf_cash-pay.pay-card-view):
     1131     if p-pay-card begins entry(kk, buf_cash-pay.pay-card-view) then do:
     1132       assign
     1133       pay-card-num = p-pay-card
     1134       .
     1135       return pay-card-num.
     1136     end.
     1137   end.
     1138   if pay-card-num = "":u then do:
     1139     if length(p-pay-card) > 4 then
     1140     assign
     1141     pay-card-num = fill("*":U, length(p-pay-card) - 4) +
     1142                     substr(p-pay-card, (length(p-pay-card) - 3), 4)
     1143     .
     1144     else
     1145     return fill("*":U, length(p-pay-card)).
     1146   end.
     1147   return pay-card-num.
     1148   END FUNCTION.
     1149   def temp-table gds-bar no-undo
     1150   field b-code like ub.bar-code.b-code
     1151   field qnty   as decimal
     1152   index art is unique b-code .
     1153   define temp-table temp-pay no-undo like ub.chk-pay
     1154   index pi is unique primary pay-code curr-code
     1155   .
     1156   DEFINE MENU m-chg
     1157          MENU-ITEM m-one-change   LABEL "Изменить один чек"
     1158          MENU-ITEM m-list-shift   LABEL "Изменить список чеков".
     1159   DEFINE MENU m-del
     1160          MENU-ITEM m-list-del     LABEL "Удалить список чеков"
     1161          MENU-ITEM m-one-del      LABEL "Удалить один чек".
     1162   DEFINE MENU m-print
     1163          MENU-ITEM m-list         LABEL "Список чеков"
     1164          MENU-ITEM m-gds          LABEL "Список строк чеков"
     1165          MENU-ITEM m-pay          LABEL "Список оплат чеков"
     1166          MENU-ITEM m-one          LABEL "Чек"
     1167          MENU-ITEM m-gds-list     LABEL "Товары чеков в файл"
     1168          MENU-ITEM m-spcf         LABEL "Спецификация"
     1169          MENU-ITEM m-akt-spi    LABEL "Акт списания"
     1170            .
     1171   DEFINE BUTTON B-chg
     1172        LABEL "&Изменить"
     1173        SIZE 10 BY 1 TOOLTIP "Изменение чека".
     1174   DEFINE BUTTON B-del
     1175        LABEL "&Удал"
     1176        SIZE 10 BY 1 TOOLTIP "Удаление чека/исключение чека из документа".
     1177   DEFINE BUTTON B-Help
     1178        LABEL "Помо&щь"
     1179        SIZE 3 BY 1
     1180        BGCOLOR 8 .
     1181   DEFINE BUTTON B-lookup
     1182        LABEL "&Просмотр"
     1183        SIZE 10 BY 1 TOOLTIP "Просмотр чека".
     1184   DEFINE BUTTON B-mark
     1185        LABEL "&*"
     1186        SIZE 3 BY 1.
     1187   DEFINE BUTTON B-print
     1188        LABEL "Пе&чать"
     1189        SIZE 3 BY 1 TOOLTIP "Печать списка чеков, списка строк по всем чекам, списка оплат ...".
     1190   DEFINE BUTTON b-quit AUTO-END-KEY
     1191        LABEL "&Выход"
     1192        SIZE 10 BY 1
     1193        BGCOLOR 8 .
     1194   DEFINE BUTTON B-sale
     1195        LABEL "&Док-нт"
     1196        SIZE 10 BY 1 TOOLTIP "Просмотр документа, к которому привязан чек(продажа, инвентаризация)".
     1197   DEFINE BUTTON B-sch
     1198        LABEL "&Фильтр"
     1199        SIZE 3 BY 1 TOOLTIP "Установка фильтра на список чеков".
     1200   DEFINE BUTTON b-sel AUTO-GO
     1201        LABEL "Вы&бор"
     1202        SIZE 10 BY 1
     1203        BGCOLOR 8 .
     1204   DEFINE VARIABLE Cb-chk-type AS CHARACTER FORMAT "X(256)":U
     1205        VIEW-AS COMBO-BOX INNER-LINES 10
     1206        LIST-ITEMS "Item 1"
     1207        DROP-DOWN-LIST
     1208        SIZE 19 BY 1
     1209        BGCOLOR 15  NO-UNDO.
     1210   DEFINE VARIABLE ED-notes AS CHARACTER
     1211        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1212        SIZE 98 BY 2
     1213        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1214   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1215         VIEW-AS TEXT
     1216        SIZE 6 BY 1
     1217        FGCOLOR 4  NO-UNDO.
     1218   DEFINE VARIABLE sch-code AS CHARACTER FORMAT "X(20)":U
     1219        LABEL "номер"
     1220        VIEW-AS FILL-IN
     1221        SIZE 19.13 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1222   DEFINE VARIABLE sch-date AS DATE FORMAT "99/99/9999":U
     1223        LABEL "дата"
     1224        VIEW-AS FILL-IN
     1225        SIZE 11.63 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1226   DEFINE VARIABLE sch-sum AS DECIMAL FORMAT "->>,>>9.99":U INITIAL 0
     1227        LABEL "сумма оплат"
     1228        VIEW-AS FILL-IN
     1229        SIZE 19.13 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1230   DEFINE QUERY BR-docs FOR c-doc SCROLLING.
     1231   DEFINE BROWSE BR-docs
     1232     QUERY BR-docs DISPLAY
     1233         c-doc.office FORMAT "X(255)":U WIDTH 7
     1234         mark-string(RECID( c-doc), rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1235         c-doc.doc-code COLUMN-LABEL "Номер_чека" FORMAT "X(20)":U
     1236         entry (lookup (string(c-doc.chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U) COLUMN-LABEL "Тип_чека" FORMAT "X(8)":U
     1237         c-doc.chk-num COLUMN-LABEL "№/кассе" FORMAT "->>>>>>>>9":U
     1238         v-chk-autotank COLUMN-LABEL "СдНал" FORMAT 'x(1)':U
     1239         c-doc.chk-date FORMAT "99/99/9999":U
     1240         (string (c-doc.chk-time, "HH:MM"))
     1241         c-doc.shift-date COLUMN-LABEL "Смена_от" FORMAT "99/99/9999":U
     1242         shift-name-no-err(buffer c-doc) COLUMN-LABEL "№ смены" FORMAT "X(6)":U
     1243         c-doc.netto COLUMN-LABEL "Сумма_оплат" FORMAT "->>>,>>>,>>9.99":U
     1244         c-doc.tot-doc COLUMN-LABEL "Сумма_товарная" FORMAT "->>>,>>>,>>9.99":U
     1245         c-doc.discnt COLUMN-LABEL "Скидка_общая" FORMAT "->>>,>>>,>>9.99":U
     1246         c-doc.sub-discnt COLUMN-LABEL "Списания" FORMAT "->>>,>>>,>>9.99":U
     1247         c-doc.pay-desk FORMAT ">>>9":U
     1248         c-doc.cashier FORMAT "99999":U
     1249         c-doc.sales-man COLUMN-LABEL "Прод-ц" FORMAT "99999":U
     1250         c-doc.out-code COLUMN-LABEL "Номер_РН" FORMAT "X(14)":U
     1251         c-doc.d-card COLUMN-LABEL "N_диск._карты" FORMAT "X(19)":U
     1252         c-doc.doc-num COLUMN-LABEL "№_док-та" FORMAT "X(22)":U
     1253         c-doc.doc-num2 COLUMN-LABEL "№_заказа" FORMAT "X(22)":U
     1254         c-doc.src-tot-doc COLUMN-LABEL "Брутто-чек" FORMAT "->,>>>,>>9.99"
     1255     ENABLE
     1256         c-doc.cashier
     1257       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 15.67.
     1258   DEFINE FRAME Dialog-Frame
     1259        b-quit AT ROW 1 COL 1
     1260        B-mark AT ROW 1 COL 11
     1261        b-sel AT ROW 1 COL 21
     1262        B-lookup AT ROW 1 COL 31
     1263        B-chg AT ROW 1 COL 41
     1264        B-del AT ROW 1 COL 51
     1265        B-sale AT ROW 1 COL 61
     1266        B-print AT ROW 1 COL 89
     1267        B-sch AT ROW 1 COL 92
     1268        B-Help AT ROW 1 COL 95
     1269        Cb-chk-type AT ROW 2 COL 1 NO-LABEL
     1270        BR-docs AT ROW 2.67 COL 1
     1271        ED-notes AT ROW 18.67 COL 1 NO-LABEL
     1272        sch-code AT ROW 20.83 COL 20 COLON-ALIGNED
     1273        sch-date AT ROW 20.83 COL 48.25 COLON-ALIGNED
     1274        sch-sum AT ROW 20.83 COL 77.5 COLON-ALIGNED
     1275        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1276        "ПОИСК" VIEW-AS TEXT
     1277             SIZE 6 BY 1 AT ROW 20.79 COL 1.5
     1278             FGCOLOR 4
     1279        SPACE(91.50) SKIP(0.20)
     1280       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1281            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1282            TITLE ""
     1283            CANCEL-BUTTON b-quit.
     1284   ASSIGN
     1285          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1286          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1287   ASSIGN
     1288          B-chg:POPUP-MENU IN FRAME Dialog-Frame       = MENU m-chg:HANDLE.
     1289   ASSIGN
     1290          B-del:POPUP-MENU IN FRAME Dialog-Frame       = MENU m-del:HANDLE.
     1291   ASSIGN
     1292          B-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU m-print:HANDLE.
     1293   ON END-ERROR OF FRAME Dialog-Frame
     1294   DO:
     1295     if deleted then return "deleted".
     1296   END.
     1297   ON ENDKEY OF FRAME Dialog-Frame
     1298   DO:
     1299     if deleted then return "deleted".
     1300   END.
     1301   ON GO OF FRAME Dialog-Frame
     1302   DO:
     1303     APPLY "LEAVE" to ED-notes.
     1304     if deleted then return "deleted".
     1305   END.
     1306   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1307   DO:
     1308     APPLY "END-ERROR":U TO SELF.
     1309   END.
     1310   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1311   DO:
     1312   define variable glog as logical no-undo .
     1313   define variable v-host-code as integer no-undo .
     1314     define buffer s-doc for ub.trn-doc.
     1315     if not available c-doc then return no-apply.
     1316   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1317   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1318     (input  c-doc.obj-type
     1319     ,input  c-doc.obj-code
     1320     ,output v-host-code
     1321     )  .
     1322     if change-type = '':U then do:
     1323       run gbl/pop-up.p ( input b-chg:handle, input no) no-error.
     1324     end.
     1325     if change-type = '':U then return no-apply.
     1326     if change-type <> "list-shift" and
     1327     (c-doc.chk-type = integer('44':U)
     1328     or c-doc.chk-type = integer('43':U) )
     1329     then do :
     1330       message "Чеки коррекции нельзя изменять!" view-as alert-box.
     1331       return no-apply.
     1332     end.
     1333     run proc-b-chg in this-procedure ( input change-type) no-error.
     1334     assign
     1335     change-type = "":U.
     1336   END.
     1337   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1338   DO:
     1339    if del-type = "" then do:
     1340       run gbl/pop-up.p ( input b-del:handle, input no) no-error.
     1341    end.
     1342    if del-type = "" then return no-apply.
     1343      if c-doc.chk-type = 13 or c-doc.chk-type = 40 then
     1344      do:
     1345         message
     1346            "Удаление чеков открытия/закрытия смены невозможно."
     1347            view-as alert-box INFORMATION .
     1348         return no-apply.
     1349      end.
     1350   run proc-b-del in this-procedure ( input del-type) no-error.
     1351   if error-status:error then do:
     1352       del-type = '':U.
     1353       return no-apply.
     1354   end.
     1355   END.
     1356   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1357   DO:
     1358   define variable next-prev as character no-undo .
     1359   define variable v-doc-rec as recid no-undo .
     1360   assign
     1361   next-prev = '':U
     1362   .
     1363   DO WHILE next-prev = '':U:
     1364     if NOT available c-doc then do:
     1365             message "Неправильно выбран чек." view-as alert-box ERROR.
     1366             return no-apply.
     1367     end.
     1368     v-doc-rec = recid(c-doc).
     1369       run str/superchk.w
     1370                     (
     1371                       input parparentproc
     1372                       ,input 'ПРОСМОТР':U
     1373                       ,input c-doc.obj-type
     1374                       ,input c-doc.obj-code
     1375                       ,input-output v-doc-rec
     1376                       ,input this-procedure:handle
     1377                       ,input-output next-prev
     1378                                   )
     1379       .
     1380   END .
     1381   apply "entry" to br-docs in frame Dialog-Frame.
     1382   apply "value-changed" to br-docs in frame Dialog-Frame.
     1383   END.
     1384   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1385   DO:
     1386   define variable glog as logical no-undo .
     1387     if available c-doc then do:
     1388   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1389   define variable v-str-recid18 as character no-undo .
     1390   define variable v-num-entry18 as integer   no-undo .
     1391   assign
     1392     v-str-recid18 = trim( string( recid( c-doc ) , "->>>>>>>>>>>9":U ) )
     1393     v-num-entry18 = lookup( v-str-recid18 , rid-list )
     1394   .
     1395   if v-num-entry18 > 0 then do:
     1396     assign
     1397       entry( v-num-entry18, rid-list ) = "":U
     1398       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1399     .
     1400   end.
     1401   else do:
     1402     assign
     1403       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid18
     1404     .
     1405   end.
     1406       glog = br-docs:refresh() .
     1407       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1408           glog = br-docs:select-next-row ().
     1409           apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     1410       end.
     1411       if num-entries( rid-list ) = 0
     1412       then
     1413           hide mark-num in frame Dialog-Frame.
     1414       else
     1415           disp num-entries( rid-list ) @ mark-num with frame Dialog-Frame.
     1416     end.
     1417     apply "entry" to br-docs in frame Dialog-Frame.
     1418   END.
     1419   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1420   DO:
     1421   define variable v-doc-rec as recid no-undo .
     1422   define variable glog as logical no-undo .
     1423   define buffer s-doc for ub.trn-doc.
     1424   if NOT available c-doc then do:
     1425     return no-apply.
     1426   end.
     1427     if print-type = "" then do:
     1428       run gbl/pop-up.p ( input self:handle, input no) no-error.
     1429     end.
     1430     if print-type = "list":U or print-type = "gds":U or print-type = "pay":U or print-type = "gds-list":U then do:
     1431       if par-mode = 'объект':U and index(frame Dialog-Frame:title,"ФИЛЬТР" ) = 0 then do:
     1432         CASE print-type:
     1433           when "list":U then do:
     1434                 message "Вы хотите напечатать весь список чеков по объекту при невключенном фильтре!" skip
     1435                 "Эта процедура может занять долгое время! Продолжать?" view-as alert-box
     1436               WARNING buttons YES-NO update glog.
     1437               if NOT glog then return no-apply.
     1438           end.
     1439           when "gds":U then do:
     1440                 message "Вы хотите напечатать строки всего списка чеков по объекту при невключенном фильтре!" skip
     1441                 "Эта процедура может занять долгое время! Продолжать?" view-as alert-box
     1442               WARNING buttons YES-NO update glog.
     1443               if NOT glog then return no-apply.
     1444           end.
     1445           when "pay":U then do:
     1446                 message "Вы хотите напечатать оплаты всего списка чеков по объекту при невключенном фильтре!" skip
     1447                 "Эта процедура может занять долгое время! Продолжать?" view-as alert-box
     1448               WARNING buttons YES-NO update glog.
     1449               if NOT glog then return no-apply.
     1450           end.
     1451           when "gds-list":U then do:
     1452                 message "Вы хотите сохранить товары всего списка чеков по объекту при невключенном фильтре!" skip
     1453                         "Эта процедура может занять долгое время! Продолжать?" view-as alert-box
     1454               WARNING buttons YES-NO update glog.
     1455               if NOT glog then return no-apply.
     1456           end.
     1457         when "akt-spi" then do:
     1458             end.
     1459         END CASE.
     1460       end.
     1461       v-doc-rec = recid( c-doc ).
     1462       DO WHILE available c-doc :
     1463             GET prev br-docs no-lock.
     1464       END.
     1465       CASE print-type:
     1466         when "list":U then do:
     1467           run PrintProc in this-procedure.
     1468         end.
     1469         when "gds":U then do:
     1470           run PrintProcGds in this-procedure.
     1471         end.
     1472         when "pay":U then do:
     1473           run PrintProcPay in this-procedure.
     1474         end.
     1475         when "gds-list":U then do:
     1476           run PrintProcGds-list in this-procedure.
     1477         end.
     1478       END CASE.
     1479       print-type = "".
     1480       reposition br-docs to recid v-doc-rec no-error.
     1481       apply "entry" to br-docs in frame Dialog-Frame.
     1482     end.
     1483     else do:
     1484       CASE print-type:
     1485           when "akt-spi" then
     1486               do:
     1487                   if c-doc.chk-type <>  integer('17':U) then
     1488                   do:
     1489                       message "Акт списания делается только по чекам ТехПролива" view-as alert-box ERROR.
     1490                       return no-apply.
     1491                   end.
     1492                   run rep/r-akt-spis.p (input c-doc.doc-code ).
     1493               end.
     1494           when "one":U then do:
     1495             if lookup(string(c-doc.chk-type), '2,3,4,5,7':U) > 0 then do:
     1496               run str/checkwp.p ( input parparentproc, input c-doc.doc-code) no-error.
     1497               print-type = "".
     1498             end.
     1499             else do:
     1500               run str/checkp.p ( input parparentproc, input c-doc.doc-code) no-error.
     1501               print-type = "".
     1502             end.
     1503           end.
     1504           when "spcf":U then do:
     1505               if can-do( 'т':U, c-doc.office ) AND ( c-doc.d-card <> "" ) then
     1506               run rep/r-specsr.p ( input parparentproc, input recid( c-doc ), input 'касс':U ) .
     1507             else
     1508             message "Чек все еще ошибочный ! " view-as alert-box ERROR.
     1509           end.
     1510       END CASE.
     1511     end.
     1512   END.
     1513   ON CHOOSE OF B-sale IN FRAME Dialog-Frame
     1514   DO:
     1515    define buffer lkp_trn-doc for ub.trn-doc.
     1516     if NOT available c-doc then do:
     1517         message "Неправильно выбран чек." view-as alert-box ERROR.
     1518         return no-apply.
     1519     end.
     1520     find first lkp_trn-doc no-lock where
     1521               lkp_trn-doc.doc-code = c-doc.out-code no-error.
     1522     if not available lkp_trn-doc then do:
     1523       message
     1524       "Для данного чека нет документа."
     1525       view-as alert-box .
     1526       return no-apply.
     1527     end.
     1528     case lkp_trn-doc.ext-doc-type:
     1529       when 'es':U then do:
     1530         FIND find_inkas where
     1531                   find_inkas.inkas-code = c-doc.out-code.
     1532         run str/ink-lkp.p ( input parparentproc, input recid(find_inkas) ).
     1533       end.
     1534       when 'vt':U then do:
     1535         run str/showdoc.p (  input parparentproc
     1536                         ,input lkp_trn-doc.doc-code
     1537                         ,input '':U
     1538                         ,input '':U
     1539                         ,input 0
     1540                         ,input true).
     1541         end.
     1542     end case.
     1543   END.
     1544   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1545   DO:
     1546     run proc-b-sch in this-procedure no-error.
     1547     if error-status:error then return no-apply.
     1548   END.
     1549   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1550   DO:
     1551     if ( available c-doc ) AND ( rid-list = "" ) then
     1552       rid-list = string( recid( c-doc ) ) .
     1553   END.
     1554   ON ANY-PRINTABLE OF BR-docs IN FRAME Dialog-Frame
     1555   DO:
     1556       sch-code:screen-value = sch-code:screen-value + last-event:label.
     1557       apply "entry" to sch-code in frame Dialog-Frame.
     1558   apply "end" to sch-code in frame Dialog-Frame.
     1559   END.
     1560   ON DELETE-CHARACTER OF BR-docs IN FRAME Dialog-Frame
     1561   DO:
     1562     if b-mark:sensitive in frame Dialog-Frame then
     1563     APPLY "CHOOSE" to b-mark.
     1564   END.
     1565   ON INSERT-MODE OF BR-docs IN FRAME Dialog-Frame
     1566   DO:
     1567     if b-mark:sensitive in frame Dialog-Frame then
     1568     APPLY "CHOOSE" to b-mark.
     1569       else do:
     1570         if b-sel:sensitive in frame Dialog-Frame then
     1571         APPLY "CHOOSE" to b-sel.
     1572       end.
     1573   END.
     1574   ON RETURN OF BR-docs IN FRAME Dialog-Frame
     1575   OR MOUSE-SELECT-DBLCLICK OF BR-docs IN FRAME Dialog-Frame
     1576   DO:
     1577         if b-sel:sensitive in frame Dialog-Frame then
     1578         APPLY "CHOOSE" to b-sel.
     1579   END.
     1580   ON ROW-DISPLAY OF BR-docs IN FRAME Dialog-Frame
     1581   DO:
     1582     IF CAN-FIND(FIRST chk-pay WHERE chk-pay.doc-code = c-doc.doc-code
     1583                              AND chk-pay.line-num > 1 AND
     1584         CAN-FIND(FIRST chk-pay-attr WHERE chk-pay-attr.doc-code = chk-pay.doc-code
     1585                  AND chk-pay-attr.line-num = chk-pay.line-num
     1586                  AND chk-pay-attr.attr-code = "autotank-sum-return")) THEN
     1587      DO:
     1588         ASSIGN
     1589             v-chk-autotank = "+"
     1590             .
     1591      END.
     1592      ELSE
     1593          v-chk-autotank = "" .
     1594   END.
     1595   ON VALUE-CHANGED OF BR-docs IN FRAME Dialog-Frame
     1596   DO:
     1597       DEFINE VARIABLE dops as character no-undo .
     1598     dops = if available c-doc then c-doc.ps else '':U.
     1599     ED-notes:screen-value = dops.
     1600   END.
     1601   ON VALUE-CHANGED OF Cb-chk-type IN FRAME Dialog-Frame
     1602   DO:
     1603     ASSIGN
     1604     CB-chk-type
     1605     p-chk-type = integer(cb-chk-type)
     1606     .
     1607     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     1608   END.
     1609   ON LEAVE OF ED-notes IN FRAME Dialog-Frame
     1610   DO:
     1611     define variable is-cre as integer no-undo .
     1612     define buffer ps_chk-doc for ub.chk-doc.
     1613     if not available c-doc then return no-apply.
     1614      DO on stop undo, return no-apply:
     1615           FIND PS_chk-doc where recid (ps_chk-doc) = recid(c-doc) exclusive.
     1616           assign
     1617           is-cre = index(ps_chk-doc.PS, "!":U)
     1618           .
     1619           if ps_CHk-doc.PS <> input frame Dialog-Frame ed-notes then
     1620           assign
     1621           ps_chk-doc.PS = (if is-cre > 0 then "!":U else "":U) +
     1622                           left-trim(input frame Dialog-Frame ed-notes, "!":U)
     1623           .
     1624       END.
     1625   END.
     1626   ON CHOOSE OF MENU-ITEM m-gds
     1627   DO:
     1628       print-type = "gds":U.
     1629       apply "choose" to b-print in frame Dialog-Frame.
     1630   END.
     1631   ON CHOOSE OF MENU-ITEM m-gds-list
     1632   DO:
     1633         print-type = "gds-list":U.
     1634       apply "choose" to b-print in frame Dialog-Frame.
     1635   END.
     1636   ON CHOOSE OF MENU-ITEM m-akt-spi
     1637   DO:
     1638         print-type = "akt-spi":U.
     1639       apply "choose" to b-print in frame Dialog-Frame.
     1640   END.
     1641   ON CHOOSE OF MENU-ITEM m-list
     1642   DO:
     1643       print-type = "list":U.
     1644       apply "choose" to b-print in frame Dialog-Frame.
     1645   END.
     1646   ON CHOOSE OF MENU-ITEM m-list-del
     1647   DO:
     1648      del-type = "list".
     1649       apply "choose" to b-del in frame Dialog-Frame.
     1650   END.
     1651   ON CHOOSE OF MENU-ITEM m-list-shift
     1652   DO:
     1653      change-type = "list-shift":U.
     1654      apply "choose" to b-chg in frame Dialog-Frame.
     1655   END.
     1656   ON CHOOSE OF MENU-ITEM m-one
     1657   DO:
     1658       print-type = "one":U.
     1659       apply "choose" to b-print in frame Dialog-Frame.
     1660   END.
     1661   ON CHOOSE OF MENU-ITEM m-one-change
     1662   DO:
     1663       change-type = "one-change":U.
     1664       apply "choose" to b-chg in frame Dialog-Frame.
     1665   END.
     1666   ON CHOOSE OF MENU-ITEM m-one-del
     1667   DO:
     1668     del-type = "one".
     1669       apply "choose" to b-del in frame Dialog-Frame.
     1670   END.
     1671   ON CHOOSE OF MENU-ITEM m-pay
     1672   DO:
     1673         print-type = "pay":U.
     1674       apply "choose" to b-print in frame Dialog-Frame.
     1675   END.
     1676   ON CHOOSE OF MENU-ITEM m-spcf
     1677   DO:
     1678       print-type = "spcf":U.
     1679       apply "choose" to b-print in frame Dialog-Frame.
     1680   END.
     1681   ON CTRL-J OF sch-code IN FRAME Dialog-Frame
     1682   DO:
     1683     run proc-find-code in this-procedure ( input yes, input frame Dialog-Frame sch-code) no-error.
     1684     if error-status:error then return no-apply.
     1685   END.
     1686   ON RETURN OF sch-code IN FRAME Dialog-Frame
     1687   DO:
     1688     run proc-find-code in this-procedure ( input no, input frame Dialog-Frame sch-code) no-error.
     1689     if error-status:error then return no-apply.
     1690   END.
     1691   ON CTRL-J OF sch-date IN FRAME Dialog-Frame
     1692   DO:
     1693       run proc-find-date in this-procedure ( input yes, input frame Dialog-Frame sch-date) no-error.
     1694     if error-status:error then return no-apply.
     1695   END.
     1696   ON RETURN OF sch-date IN FRAME Dialog-Frame
     1697   DO:
     1698     run proc-find-date in this-procedure ( input no, input frame Dialog-Frame sch-date) no-error.
     1699     if error-status:error then return no-apply.
     1700   END.
     1701   ON CTRL-J OF sch-sum IN FRAME Dialog-Frame
     1702   DO:
     1703     run proc-find-sum in this-procedure ( input yes, input frame Dialog-Frame sch-sum) no-error.
     1704     if error-status:error then return no-apply.
     1705   END.
     1706   ON RETURN OF sch-sum IN FRAME Dialog-Frame
     1707   DO:
     1708     run proc-find-sum in this-procedure ( input no, input frame Dialog-Frame sch-sum) no-error.
     1709     if error-status:error then return no-apply.
     1710   END.
     1711   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1712   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1713   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1714   on help of frame Dialog-Frame
     1715   do:
     1716     run gbl/app_help.p
     1717       (input this-procedure :file-name
     1718       ,input ''
     1719       ,input ?
     1720       ) no-error.
     1721     if error-status :error then do:
     1722       message
     1723         "Ошибка при вызове помощи"
     1724         error-status :get-message(1)
     1725         view-as alert-box .
     1726     end.
     1727   end.
     1728   run minbtn-set in this-procedure .
     1729   on choose of b-help in frame Dialog-Frame
     1730   do:
     1731     apply "help":u to frame Dialog-Frame .
     1732   end.
     1733   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1734   procedure minbtn-set :
     1735       do
     1736           on error undo, return error return-value
     1737           :
     1738           define variable ii              as integer       no-undo .
     1739           define variable fh              as widget-handle no-undo .
     1740           define variable hh              as widget-handle no-undo .
     1741           define variable v-h             as handle        extent 4 no-undo .
     1742           define variable v-name-button   as character     no-undo .
     1743           define variable v-help-old-x    as decimal       no-undo .
     1744           define variable v-help-old-y    as decimal       no-undo .
     1745           define variable v-help-old-size as decimal       no-undo .
     1746           define variable v-frame-width   as decimal       no-undo .
     1747           define variable jj              as integer       no-undo .
     1748           do
     1749               on error undo, return error
     1750               :
     1751               assign
     1752                   v-frame-width = frame Dialog-Frame:width - 0.3
     1753                   fh            = frame Dialog-Frame:first-child
     1754                   hh            = fh:first-child
     1755                   ii            = 1
     1756                   .
     1757               do while valid-handle(hh):
     1758                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1759                   do:
     1760                       case lc(hh:name) :
     1761                           when "b-help" then
     1762                               do:
     1763                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1764                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1765                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1766                                   hh:TOOLTIP = "Помощь" .
     1767                                   v-help-old-x = hh:column .
     1768                                   v-help-old-y = hh:row    .
     1769                                   v-help-old-size = hh:width .
     1770                                   hh:width-chars = 2.5 .
     1771                               end.
     1772                           when "b-print" then
     1773                               do:
     1774                                   hh:load-image("cmp/b-print.bmp":u) .
     1775                                   hh:TOOLTIP = "Печать" .
     1776                                   v-h[ii] = hh:handle .
     1777                                   ii = ii + 1 .
     1778                                   hh:width-chars = 3 .
     1779                               end.
     1780                           when "b-history" or
     1781                           when "b-hist" then
     1782                               do:
     1783                                   hh:load-image("cmp/b-hist.bmp":u) .
     1784                                   hh:TOOLTIP = "История" .
     1785                                   v-h[ii] = hh:handle .
     1786                                   ii = ii + 1 .
     1787                                   hh:width-chars = 3 .
     1788                               end.
     1789                           when "b-sch" then
     1790                               do:
     1791                                   hh:load-image("cmp/b-sch.bmp":u) .
     1792                                   hh:TOOLTIP = "Установка Фильтра" .
     1793                                   v-h[ii] = hh:handle .
     1794                                   ii = ii + 1 .
     1795                                   hh:width-chars = 3 .
     1796                               end.
     1797                           when "b-hist-user" then
     1798                               do:
     1799                                   hh:load-image("cmp/b-hist.bmp":u) .
     1800                                   hh:TOOLTIP = "История пользователя" .
     1801                                   ii = ii + 1 .
     1802                               end.
     1803                       end case.
     1804                   end.
     1805                   hh = hh:next-sibling.
     1806               end.
     1807               b-help:column = v-frame-width - b-help:width-chars.
     1808               jj = 0.
     1809               repeat ii = 4 to 1 by -1 :
     1810                   if valid-handle (v-h[ii] ) then
     1811                   do:
     1812                       jj  = jj + 1 .
     1813                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1814                       v-h[ii]:row    = v-help-old-y .
     1815                   end.
     1816               end.
     1817           end.
     1818       end.
     1819   end procedure.
     1820   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1821   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1822   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1823   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1824   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1825   define variable v-diasize-current-frame-height as decimal   no-undo .
     1826   define variable v-diasize-change-size          as logical   no-undo .
     1827   define variable v-diasize-resize-button        as handle    no-undo .
     1828   define variable v-diasize-wndmax               as logical   no-undo .
     1829   define variable v-diasize-wndstore             as logical   no-undo .
     1830   define variable v-diasize-proc-name            as character no-undo .
     1831   define variable v-diasize-browse-handle        as handle    no-undo .
     1832   define variable v-diasize-browse-number        as integer   no-undo .
     1833   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1834   define temp-table temp-diasize-handle no-undo
     1835     field handle-value  as handle
     1836     field save-position as decimal
     1837     index xpk is primary unique handle-value
     1838     .
     1839   define temp-table temp-browse-handle no-undo
     1840     field browse-type   as character
     1841     field browse-number as integer
     1842     field browse-handle as handle
     1843     field original-size as decimal
     1844     index xpk is primary unique browse-type browse-number
     1845     index xie browse-type browse-handle
     1846   .
     1847   procedure diasize_change-height :
     1848     define input  parameter p-change-value  as decimal   no-undo .
     1849     define input  parameter p-move-resize   as logical   no-undo .
     1850     define variable v-field-group-handle    as handle    no-undo .
     1851     define variable v-object-handle         as handle    no-undo .
     1852     define variable v-frame-height          as decimal   no-undo .
     1853     define variable v-frame-virtual-height  as decimal   no-undo .
     1854     define variable v-browse-height         as decimal   no-undo .
     1855     define variable v-window-height         as decimal   no-undo .
     1856     define variable v-window-virtual-height as decimal   no-undo .
     1857     define variable v-change-sign           as integer   no-undo .
     1858     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1859     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1860     if p-change-value > 0
     1861     then do:
     1862       if frame Dialog-Frame :height + p-change-value
     1863           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1864       then do:
     1865         assign
     1866           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1867                           - (frame Dialog-Frame :height-chars)
     1868         .
     1869         if p-change-value <= 0
     1870         then do:
     1871           run diasize_position-resize-button in this-procedure .
     1872           return .
     1873         end.
     1874       end.
     1875     end.
     1876     if p-change-value < 0
     1877     then do:
     1878       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1879       then do:
     1880         assign
     1881           p-change-value = v-diasize-orig-frame-height
     1882                          - (frame Dialog-Frame :height-chars)
     1883         .
     1884         if p-change-value >= 0
     1885         then do:
     1886           run diasize_position-resize-button in this-procedure .
     1887           return .
     1888         end.
     1889       end.
     1890     end.
     1891     if p-change-value >= 0
     1892     then do:
     1893       assign
     1894         v-change-sign = 1
     1895       .
     1896     end.
     1897     else do:
     1898       assign
     1899         v-change-sign = -1
     1900       .
     1901     end.
     1902     assign
     1903       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1904     .
     1905     if p-change-value = 0
     1906     then do:
     1907       run diasize_position-resize-button in this-procedure .
     1908       return .
     1909     end.
     1910     move_block:
     1911     do
     1912     on error undo move_block, retry move_block
     1913     :
     1914       if retry
     1915       then do:
     1916         do
     1917         on error undo move_block, leave move_block
     1918         :
     1919           if p-change-value > 0
     1920           then do:
     1921             for each buf_temp-diasize-handle
     1922             on error undo, next
     1923             :
     1924               assign
     1925                 v-object-handle = buf_temp-diasize-handle.handle-value
     1926               .
     1927               if v-object-handle <> v-diasize-resize-button
     1928               then do:
     1929                 assign
     1930                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1931                 .
     1932               end.
     1933             end.
     1934             assign
     1935               v-diasize-browse-handle :height = v-browse-height
     1936             .
     1937             for each buf_temp-browse-handle
     1938               where buf_temp-browse-handle.browse-type = 'height':u
     1939             on error undo, next
     1940             :
     1941               assign
     1942                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1943               .
     1944             end.
     1945             assign
     1946               frame Dialog-Frame :height = v-frame-height
     1947             .
     1948             if frame Dialog-Frame :scrollable = true
     1949             then do:
     1950               assign
     1951                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1952               .
     1953             end.
     1954             run diasize_position-resize-button in this-procedure .
     1955           end.
     1956           else do:
     1957             if frame Dialog-Frame :scrollable = true
     1958             then do:
     1959               assign
     1960                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1961               .
     1962             end.
     1963             assign
     1964               frame Dialog-Frame :height = v-frame-height
     1965             .
     1966             assign
     1967               v-diasize-browse-handle :height = v-browse-height
     1968             .
     1969             for each buf_temp-browse-handle
     1970               where buf_temp-browse-handle.browse-type = 'height':u
     1971             on error undo, next
     1972             :
     1973               assign
     1974                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1975               .
     1976             end.
     1977             for each buf_temp-diasize-handle
     1978             on error undo, next
     1979             :
     1980               assign
     1981                 v-object-handle = buf_temp-diasize-handle.handle-value
     1982               .
     1983               if v-object-handle <> v-diasize-resize-button
     1984               then do:
     1985                 assign
     1986                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1987                 .
     1988               end.
     1989             end.
     1990             run diasize_position-resize-button in this-procedure .
     1991           end.
     1992           assign
     1993             v-diasize-change-size = false
     1994           .
     1995           leave move_block .
     1996         end.
     1997       end.
     1998       assign
     1999         v-diasize-need-full-display = true
     2000       .
     2001       if v-diasize-change-size = false
     2002       then do:
     2003         assign
     2004           v-diasize-change-size = true
     2005         .
     2006       end.
     2007       else do:
     2008         return .
     2009       end.
     2010       assign
     2011         v-frame-height = frame Dialog-Frame :height
     2012         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2013         v-browse-height = v-diasize-browse-handle :height
     2014       .
     2015       for each buf_temp-browse-handle
     2016         where buf_temp-browse-handle.browse-type = 'height':u
     2017       :
     2018         assign
     2019           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2020         .
     2021       end.
     2022       for each buf_temp-diasize-handle
     2023       :
     2024         delete buf_temp-diasize-handle .
     2025       end.
     2026       assign
     2027         v-field-group-handle = frame Dialog-Frame :first-child
     2028       .
     2029       do while valid-handle(v-field-group-handle)
     2030       :
     2031         assign
     2032           v-object-handle = v-field-group-handle :first-child
     2033         .
     2034         do while valid-handle(v-object-handle)
     2035         :
     2036           if  v-object-handle <> v-diasize-browse-handle :handle
     2037           and can-query(v-object-handle, "row")
     2038           and can-query(v-object-handle, "height")
     2039           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2040           then do:
     2041             find first buf_temp-browse-handle
     2042               where buf_temp-browse-handle.browse-type   = 'height':u
     2043                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2044               no-error .
     2045             if available buf_temp-browse-handle
     2046             then do:
     2047             end.
     2048             else do:
     2049               create buf_temp-diasize-handle .
     2050               assign
     2051                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2052                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2053               .
     2054             end.
     2055           end.
     2056           assign
     2057             v-object-handle = v-object-handle :next-sibling
     2058           .
     2059         end.
     2060         assign
     2061           v-field-group-handle = v-field-group-handle :next-sibling
     2062         .
     2063       end.
     2064       do with frame Dialog-Frame
     2065       :
     2066         hide v-diasize-resize-button .
     2067         assign
     2068           v-diasize-resize-button :row    = 1
     2069           v-diasize-resize-button :column = 1
     2070         .
     2071       end.
     2072       if p-change-value > 0
     2073       then do:
     2074         if frame Dialog-Frame :scrollable = true
     2075         then do:
     2076           assign
     2077             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2078             no-error .
     2079           if error-status :error
     2080           or error-status :get-message(1) <> ""
     2081           then do:
     2082             undo move_block, retry move_block .
     2083           end.
     2084         end.
     2085         assign
     2086           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2087           no-error .
     2088         if error-status :error
     2089         or error-status :get-message(1) <> ""
     2090         then do:
     2091           undo move_block, retry move_block .
     2092         end.
     2093         assign
     2094           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2095           no-error .
     2096         if error-status :error
     2097         or error-status :get-message(1) <> ""
     2098         then do:
     2099           undo move_block, retry move_block .
     2100         end.
     2101         for each buf_temp-browse-handle
     2102           where buf_temp-browse-handle.browse-type = 'height':u
     2103         on error undo move_block, retry move_block
     2104         :
     2105           assign
     2106             buf_temp-browse-handle.browse-handle :height
     2107               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2108             no-error .
     2109           if error-status :error
     2110           or error-status :get-message(1) <> ""
     2111           then do:
     2112             undo move_block, retry move_block .
     2113           end.
     2114         end.
     2115         for each buf_temp-diasize-handle
     2116         on error undo move_block, retry move_block
     2117         :
     2118           assign
     2119             v-object-handle = buf_temp-diasize-handle.handle-value
     2120           .
     2121           if v-object-handle <> v-diasize-resize-button
     2122           then do:
     2123             assign
     2124               v-object-handle :row = v-object-handle :row + p-change-value
     2125               no-error .
     2126             if error-status :error
     2127             or error-status :get-message(1) <> ""
     2128             then do:
     2129               undo move_block, retry move_block .
     2130             end.
     2131           end.
     2132         end.
     2133       end.
     2134       else do:
     2135         for each buf_temp-diasize-handle
     2136         on error undo move_block, retry move_block
     2137         :
     2138           assign
     2139             v-object-handle = buf_temp-diasize-handle.handle-value
     2140           .
     2141           if v-object-handle <> v-diasize-resize-button
     2142           then do:
     2143             assign
     2144               v-object-handle :row = v-object-handle :row + p-change-value
     2145               no-error .
     2146             if error-status :error
     2147             or error-status :get-message(1) <> ""
     2148             then do:
     2149               undo move_block, retry move_block .
     2150             end.
     2151           end.
     2152         end.
     2153         assign
     2154           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2155           no-error .
     2156         if error-status :error
     2157         or error-status :get-message(1) <> ""
     2158         then do:
     2159           undo move_block, retry move_block .
     2160         end.
     2161         for each buf_temp-browse-handle
     2162           where buf_temp-browse-handle.browse-type = 'height':u
     2163         on error undo move_block, retry move_block
     2164         :
     2165           assign
     2166             buf_temp-browse-handle.browse-handle :height
     2167               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2168             no-error .
     2169           if error-status :error
     2170           or error-status :get-message(1) <> ""
     2171           then do:
     2172             undo move_block, retry move_block .
     2173           end.
     2174         end.
     2175         assign
     2176           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2177           no-error .
     2178         if error-status :error
     2179         or error-status :get-message(1) <> ""
     2180         then do:
     2181           undo move_block, retry move_block .
     2182         end.
     2183         if frame Dialog-Frame :scrollable = true
     2184         then do:
     2185           assign
     2186             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2187             no-error .
     2188           if error-status :error
     2189           or error-status :get-message(1) <> ""
     2190           then do:
     2191             undo move_block, retry move_block .
     2192           end.
     2193         end.
     2194       end.
     2195       if p-move-resize = true
     2196       then do:
     2197         run diasize_position-resize-button in this-procedure .
     2198       end.
     2199       if v-diasize-wndstore = true
     2200       then do:
     2201         if connected("ub") = true
     2202         then do:
     2203           define variable v-cntxt-db-num        as integer   no-undo .
     2204           define variable v-cntxt-userid        as character no-undo .
     2205           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2206                                             , OUTPUT v-cntxt-userid
     2207                                             ) .
     2208           run gbl/wndsizew.p
     2209             (input  v-cntxt-db-num
     2210             ,input  v-cntxt-userid
     2211             ,input  v-diasize-proc-name
     2212             ,input  'height':u
     2213             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2214             ) .
     2215         end.
     2216       end.
     2217     end.
     2218     assign
     2219       v-diasize-change-size = false
     2220     .
     2221   end procedure.
     2222   procedure diasize_set-height :
     2223     define input  parameter p-new-height  as decimal   no-undo .
     2224     define input  parameter p-move-resize as logical   no-undo .
     2225     do
     2226     on error undo, return error return-value
     2227     :
     2228       run diasize_change-height in this-procedure
     2229         (input  (p-new-height - frame Dialog-Frame :height)
     2230         ,input  p-move-resize
     2231         ) .
     2232     end.
     2233   end procedure.
     2234   procedure diasize_change-width :
     2235     define input  parameter p-change-value as decimal   no-undo .
     2236     define input  parameter p-move-resize  as logical   no-undo .
     2237     define variable v-field-group-handle   as handle    no-undo .
     2238     define variable v-object-handle        as handle    no-undo .
     2239     define variable v-frame-width          as decimal   no-undo .
     2240     define variable v-frame-virtual-width  as decimal   no-undo .
     2241     define variable v-browse-width         as decimal   no-undo .
     2242     define variable v-window-width         as decimal   no-undo .
     2243     define variable v-window-virtual-width as decimal   no-undo .
     2244     define variable v-change-sign          as integer   no-undo .
     2245     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2246     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2247     if p-change-value > 0
     2248     then do:
     2249       if frame Dialog-Frame :width + p-change-value >
     2250           session :width-chars
     2251       then do:
     2252         assign
     2253           p-change-value = session :width-chars - frame Dialog-Frame :width
     2254         .
     2255         if p-change-value <= 0
     2256         then do:
     2257           run diasize_position-resize-button in this-procedure .
     2258           return .
     2259         end.
     2260       end.
     2261     end.
     2262     if p-change-value < 0
     2263     then do:
     2264       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2265       then do:
     2266         assign
     2267           p-change-value = v-diasize-orig-frame-width
     2268                          - frame Dialog-Frame :width
     2269         .
     2270         if p-change-value >= 0
     2271         then do:
     2272           run diasize_position-resize-button in this-procedure .
     2273           return .
     2274         end.
     2275       end.
     2276     end.
     2277     if p-change-value >= 0
     2278     then do:
     2279       assign
     2280         v-change-sign = 1
     2281       .
     2282     end.
     2283     else do:
     2284       assign
     2285         v-change-sign = -1
     2286       .
     2287     end.
     2288     assign
     2289       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2290     .
     2291     if p-change-value = 0
     2292     then do:
     2293       run diasize_position-resize-button in this-procedure .
     2294       return .
     2295     end.
     2296     move_block:
     2297     do
     2298     on error undo move_block, leave move_block
     2299     :
     2300       if retry
     2301       then do:
     2302         do
     2303         on error undo move_block, leave move_block
     2304         :
     2305           if p-change-value > 0
     2306           then do:
     2307             for each buf_temp-diasize-handle
     2308             on error undo, next
     2309             :
     2310               assign
     2311                 v-object-handle = buf_temp-diasize-handle.handle-value
     2312               .
     2313               if v-object-handle <> v-diasize-resize-button
     2314               then do:
     2315                 assign
     2316                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2317                 .
     2318               end.
     2319             end.
     2320             assign
     2321               v-diasize-browse-handle :width = v-browse-width
     2322             .
     2323             for each buf_temp-browse-handle
     2324               where buf_temp-browse-handle.browse-type = 'width':u
     2325             on error undo, next
     2326             :
     2327               assign
     2328                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2329               .
     2330             end.
     2331             assign
     2332               frame Dialog-Frame :width = v-frame-width
     2333             .
     2334             if frame Dialog-Frame :scrollable = true
     2335             then do:
     2336               assign
     2337                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2338               .
     2339             end.
     2340             run diasize_position-resize-button in this-procedure .
     2341           end.
     2342           else do:
     2343             if frame Dialog-Frame :scrollable = true
     2344             then do:
     2345               assign
     2346                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2347               .
     2348             end.
     2349             assign
     2350               frame Dialog-Frame :width = v-frame-width
     2351             .
     2352             for each buf_temp-browse-handle
     2353               where buf_temp-browse-handle.browse-type = 'width':u
     2354             on error undo, next
     2355             :
     2356               assign
     2357                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2358               .
     2359             end.
     2360             assign
     2361               v-diasize-browse-handle :width = v-browse-width
     2362             .
     2363             for each buf_temp-diasize-handle
     2364             on error undo, next
     2365             :
     2366               assign
     2367                 v-object-handle = buf_temp-diasize-handle.handle-value
     2368               .
     2369               if v-object-handle <> v-diasize-resize-button
     2370               then do:
     2371                 assign
     2372                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2373                 .
     2374               end.
     2375             end.
     2376             run diasize_position-resize-button in this-procedure .
     2377           end.
     2378           assign
     2379             v-diasize-change-size = false
     2380           .
     2381           leave move_block .
     2382         end.
     2383       end.
     2384       assign
     2385         v-diasize-need-full-display = true
     2386       .
     2387       if v-diasize-change-size = false
     2388       then do:
     2389         assign
     2390           v-diasize-change-size = true
     2391         .
     2392       end.
     2393       else do:
     2394         return .
     2395       end.
     2396       assign
     2397         v-frame-width = frame Dialog-Frame :width
     2398         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2399         v-browse-width = v-diasize-browse-handle :width
     2400       .
     2401       for each buf_temp-browse-handle
     2402         where buf_temp-browse-handle.browse-type = 'width':u
     2403       :
     2404         assign
     2405           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2406         .
     2407       end.
     2408       for each buf_temp-diasize-handle
     2409       :
     2410         delete buf_temp-diasize-handle .
     2411       end.
     2412       assign
     2413         v-field-group-handle = frame Dialog-Frame :first-child
     2414       .
     2415       do while valid-handle(v-field-group-handle)
     2416       :
     2417         assign
     2418           v-object-handle = v-field-group-handle :first-child
     2419         .
     2420         do while valid-handle(v-object-handle)
     2421         :
     2422           if  v-object-handle <> v-diasize-browse-handle :handle
     2423           and v-object-handle <> v-diasize-resize-button
     2424           and can-query(v-object-handle, "row")
     2425           and can-query(v-object-handle, "height")
     2426           and ( v-object-handle :col + v-object-handle :width
     2427                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2428               )
     2429           then do:
     2430             find first buf_temp-browse-handle
     2431               where buf_temp-browse-handle.browse-type   = 'width':u
     2432                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2433               no-error .
     2434             if available buf_temp-browse-handle
     2435             then do:
     2436             end.
     2437             else do:
     2438               create buf_temp-diasize-handle .
     2439               assign
     2440                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2441                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2442               .
     2443             end.
     2444           end.
     2445           assign
     2446             v-object-handle = v-object-handle :next-sibling
     2447           .
     2448         end.
     2449         assign
     2450           v-field-group-handle = v-field-group-handle :next-sibling
     2451         .
     2452       end.
     2453       do with frame Dialog-Frame
     2454       :
     2455         hide v-diasize-resize-button .
     2456         v-diasize-resize-button :row = 1.
     2457         v-diasize-resize-button :column = 1.
     2458       end.
     2459       if p-change-value > 0
     2460       then do:
     2461         if frame Dialog-Frame :scrollable = true
     2462         then do:
     2463           assign
     2464             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2465             no-error .
     2466           if error-status :error
     2467           or error-status :get-message(1) <> ""
     2468           then do:
     2469             undo move_block, retry move_block.
     2470           end.
     2471         end.
     2472         assign
     2473           frame Dialog-Frame :width = v-frame-width + p-change-value
     2474           no-error .
     2475         if error-status :error
     2476         or error-status :get-message(1) <> ""
     2477         then do:
     2478           undo move_block, retry move_block.
     2479         end.
     2480         assign
     2481           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2482         no-error .
     2483         if error-status :error
     2484         or error-status :get-message(1) <> ""
     2485         then do:
     2486           undo move_block, retry move_block.
     2487         end.
     2488         for each buf_temp-browse-handle
     2489           where buf_temp-browse-handle.browse-type = 'width':u
     2490         on error undo move_block, retry move_block
     2491         :
     2492           assign
     2493             buf_temp-browse-handle.browse-handle :width
     2494               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2495             no-error .
     2496           if error-status :error
     2497           or error-status :get-message(1) <> ""
     2498           then do:
     2499             undo move_block, retry move_block .
     2500           end.
     2501         end.
     2502         for each buf_temp-diasize-handle
     2503         on error undo move_block, retry move_block
     2504         :
     2505           assign
     2506             v-object-handle = buf_temp-diasize-handle.handle-value
     2507           .
     2508           if v-object-handle <> v-diasize-resize-button
     2509           then do:
     2510             assign
     2511               v-object-handle :col = v-object-handle :col + p-change-value
     2512               no-error .
     2513             if error-status :error
     2514             or error-status :get-message(1) <> ""
     2515             then do:
     2516               undo move_block, retry move_block .
     2517             end.
     2518           end.
     2519         end.
     2520       end.
     2521       else do:
     2522         for each buf_temp-diasize-handle
     2523         on error undo move_block, retry move_block
     2524         :
     2525           assign
     2526             v-object-handle = buf_temp-diasize-handle.handle-value
     2527           .
     2528           if v-object-handle <> v-diasize-resize-button
     2529           then do:
     2530             assign
     2531               v-object-handle :col = v-object-handle :col + p-change-value
     2532               no-error .
     2533             if error-status :error
     2534             or error-status :get-message(1) <> ""
     2535             then do:
     2536               undo move_block, retry move_block .
     2537             end.
     2538           end.
     2539         end.
     2540         for each buf_temp-browse-handle
     2541           where buf_temp-browse-handle.browse-type = 'width':u
     2542         on error undo move_block, retry move_block
     2543         :
     2544           assign
     2545             buf_temp-browse-handle.browse-handle :width
     2546               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2547             no-error .
     2548           if error-status :error
     2549           or error-status :get-message(1) <> ""
     2550           then do:
     2551             undo move_block, retry move_block .
     2552           end.
     2553         end.
     2554         assign
     2555           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2556           no-error .
     2557         if error-status :error
     2558         or error-status :get-message(1) <> ""
     2559         then do:
     2560           undo move_block, retry move_block.
     2561         end.
     2562         assign
     2563           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2564         no-error .
     2565         if error-status :error
     2566         or error-status :get-message(1) <> ""
     2567         then do:
     2568           undo move_block, retry move_block.
     2569         end.
     2570         if frame Dialog-Frame :scrollable = true
     2571         then do:
     2572           assign
     2573             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2574           no-error .
     2575           if error-status :error
     2576           or error-status :get-message(1) <> ""
     2577           then do:
     2578             undo move_block, retry move_block.
     2579           end.
     2580         end.
     2581       end.
     2582       if p-move-resize
     2583       then do:
     2584         run diasize_position-resize-button in this-procedure .
     2585       end.
     2586       if v-diasize-wndstore = true
     2587       then do:
     2588         if connected("ub") = true
     2589         then do:
     2590           define variable v-cntxt-db-num        as integer   no-undo .
     2591           define variable v-cntxt-userid        as character no-undo .
     2592           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2593                                             , OUTPUT v-cntxt-userid
     2594                                             ) .
     2595           run gbl/wndsizew.p
     2596             (input  v-cntxt-db-num
     2597             ,input  v-cntxt-userid
     2598             ,input  v-diasize-proc-name
     2599             ,input  'width':u
     2600             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2601             ) .
     2602         end.
     2603       end.
     2604     end.
     2605     assign
     2606       v-diasize-change-size = false
     2607     .
     2608   end procedure.
     2609   procedure diasize_set-width :
     2610     define input  parameter p-new-width  as decimal   no-undo .
     2611     define input  parameter p-move-resize as logical   no-undo .
     2612     do
     2613     on error undo, return error return-value
     2614     :
     2615       run diasize_change-width in this-procedure
     2616         (input  (p-new-width - frame Dialog-Frame :width)
     2617         ,input  p-move-resize
     2618         ) .
     2619     end.
     2620   end procedure.
     2621   procedure diasize_position-resize-button :
     2622     do with frame Dialog-Frame
     2623     :
     2624       hide v-diasize-resize-button .
     2625       assign
     2626         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2627                     - 1
     2628                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2629         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2630                     - 1
     2631                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2632       .
     2633       view v-diasize-resize-button .
     2634     end.
     2635   end procedure.
     2636   on alt-right anywhere
     2637   do:
     2638     run diasize_change-width in this-procedure
     2639       (input 1
     2640       ,input true
     2641       ) .
     2642     return no-apply .
     2643   end.
     2644   on alt-left anywhere
     2645   do:
     2646     run diasize_change-width in this-procedure
     2647       (input -1
     2648       ,input true
     2649       ) .
     2650     return no-apply .
     2651   end.
     2652   on alt-down anywhere
     2653   do:
     2654     run diasize_change-height in this-procedure
     2655       (input 1
     2656       ,input true
     2657       ) .
     2658     return no-apply .
     2659   end.
     2660   on alt-up anywhere
     2661   do:
     2662     run diasize_change-height in this-procedure
     2663       (input -1
     2664       ,input true
     2665       ) .
     2666     return no-apply .
     2667   end.
     2668   on alt-enter of frame Dialog-Frame
     2669   do:
     2670     run diasize_maximize in this-procedure
     2671       (input  ?
     2672       ).
     2673     return no-apply .
     2674   end.
     2675   procedure diasize_end-move :
     2676     do
     2677     on error undo, return error return-value
     2678     :
     2679       define variable v-row-delta as decimal   no-undo .
     2680       define variable v-col-delta as decimal   no-undo .
     2681       define variable v-new-row as decimal   no-undo .
     2682       define variable v-new-col as decimal   no-undo .
     2683       assign
     2684         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2685         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2686       .
     2687       assign
     2688         v-row-delta = v-new-row - frame Dialog-Frame :height
     2689         v-col-delta = v-new-col - frame Dialog-Frame :width
     2690       .
     2691       run diasize_change-height in this-procedure
     2692         (input v-row-delta
     2693         ,input true
     2694         ) .
     2695       run diasize_change-width in this-procedure
     2696         (input v-col-delta
     2697         ,input true
     2698         ) .
     2699     end.
     2700   end procedure.
     2701   procedure diasize_maximize :
     2702     define input  parameter p-action as logical   no-undo .
     2703     do
     2704     on error undo, return error return-value
     2705     :
     2706       if p-action = ?
     2707       then do:
     2708         if v-diasize-need-maximize = true
     2709         then do:
     2710           assign
     2711             p-action = true
     2712           .
     2713         end.
     2714         else do:
     2715           assign
     2716             p-action = false
     2717           .
     2718         end.
     2719       end.
     2720       if p-action = true
     2721       then do:
     2722         run diasize_change-height in this-procedure
     2723           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2724               - frame Dialog-Frame :height-chars
     2725           ,input true
     2726           ) .
     2727         run diasize_change-width in this-procedure
     2728           (input session :width-chars
     2729               - frame Dialog-Frame :width-chars
     2730           ,input true
     2731           ) .
     2732         assign
     2733           v-diasize-need-maximize = false
     2734         .
     2735       end.
     2736       else do:
     2737         run diasize_change-width in this-procedure
     2738           (input v-diasize-orig-frame-width
     2739               - frame Dialog-Frame :width-chars
     2740           ,input true
     2741           ) .
     2742         run diasize_change-height in this-procedure
     2743           (input v-diasize-orig-frame-height
     2744               - frame Dialog-Frame :height-chars
     2745           ,input true
     2746           ) .
     2747         assign
     2748           v-diasize-need-maximize = true
     2749         .
     2750       end.
     2751     end.
     2752   end procedure.
     2753   procedure diasize_restore-orig-size :
     2754     do
     2755     on error undo, return error return-value
     2756     :
     2757       assign
     2758         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2759         v-diasize-current-frame-height = frame Dialog-Frame :height
     2760       .
     2761       run diasize_set-height in this-procedure
     2762         (input  v-diasize-orig-frame-height
     2763         ,input  true
     2764         ) .
     2765       run diasize_set-width in this-procedure
     2766         (input  v-diasize-orig-frame-width
     2767         ,input  true
     2768         ) .
     2769     end.
     2770   end procedure.
     2771   procedure diasize_restore-current-size :
     2772     do
     2773     on error undo, return error return-value
     2774     :
     2775       run diasize_set-height in this-procedure
     2776         (input  v-diasize-current-frame-height
     2777         ,input  true
     2778         ) .
     2779       run diasize_set-width in this-procedure
     2780         (input  v-diasize-current-frame-width
     2781         ,input  true
     2782         ) .
     2783     end.
     2784   end procedure.
     2785   procedure diasize_set-browse-handle :
     2786     define input  parameter p-browse-handle as handle   no-undo .
     2787     define buffer buf_temp-browse-handle for temp-browse-handle .
     2788     do
     2789     on error undo, return error return-value
     2790     :
     2791       assign
     2792         v-diasize-browse-handle = p-browse-handle
     2793       .
     2794       for each buf_temp-browse-handle
     2795       on error undo, return error return-value
     2796       :
     2797         delete buf_temp-browse-handle .
     2798       end.
     2799     end.
     2800   end procedure.
     2801   procedure diasize_add_browse :
     2802     define input  parameter p-browse-type   as character no-undo .
     2803     define input  parameter p-browse-handle as handle    no-undo .
     2804     define buffer buf_temp-browse-handle for temp-browse-handle .
     2805     do
     2806     on error undo, return error return-value
     2807     :
     2808       assign
     2809         v-diasize-browse-number = v-diasize-browse-number + 1
     2810       .
     2811       create buf_temp-browse-handle .
     2812       assign
     2813         buf_temp-browse-handle.browse-type   = p-browse-type
     2814         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2815         buf_temp-browse-handle.browse-handle = p-browse-handle
     2816       .
     2817     end.
     2818   end procedure.
     2819   procedure diasize_init :
     2820     define variable v-default-value    as logical   no-undo .
     2821     define variable v-restore-saved    as logical   no-undo .
     2822     define variable v-resize-value-str as character no-undo .
     2823     do
     2824     on error undo, return error return-value
     2825     :
     2826       do with frame Dialog-Frame
     2827       :
     2828         assign
     2829           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2830           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2831           v-diasize-browse-handle     = browse BR-docs :handle
     2832         .
     2833         create button v-diasize-resize-button
     2834         assign
     2835           parent        = frame Dialog-Frame :first-child
     2836           label         = "s"
     2837           height-pixels = 16
     2838           width-pixels  = 16
     2839           visible       = true
     2840           sensitive     = true
     2841           movable       = true
     2842           triggers:
     2843             on end-move persistent run diasize_end-move in this-procedure .
     2844           end triggers.
     2845         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2846         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2847         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2848         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2849         assign
     2850           v-diasize-wndmax = false
     2851         .
     2852         if connected("ub") = true
     2853         then do:
     2854           define variable v-cntxt-db-num        as integer   no-undo .
     2855           define variable v-cntxt-userid        as character no-undo .
     2856           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2857                                             , OUTPUT v-cntxt-userid
     2858                                             ) .
     2859           run gbl/wndpar_r.p
     2860             (input  v-cntxt-db-num
     2861             ,input  v-cntxt-userid
     2862             ,input  'wndmax':U
     2863             ,output v-diasize-wndmax
     2864             ,output v-default-value
     2865             ) .
     2866         end.
     2867         assign
     2868           v-diasize-wndstore = false
     2869         .
     2870         if connected("ub") = true
     2871         then do:
     2872           run gbl/wndpar_r.p
     2873             (input  v-cntxt-db-num
     2874             ,input  v-cntxt-userid
     2875             ,input  'wndstore':U
     2876             ,output v-diasize-wndstore
     2877             ,output v-default-value
     2878             ) .
     2879         end.
     2880         assign
     2881           v-diasize-proc-name = entry(1, program-name(2), '.')
     2882         .
     2883         if v-diasize-wndstore = true
     2884         then do:
     2885           assign
     2886             v-restore-saved = false
     2887           .
     2888           if connected("ub") = true
     2889           then do:
     2890             run gbl/wndsizer.p
     2891               (input  v-cntxt-db-num
     2892               ,input  v-cntxt-userid
     2893               ,input  v-diasize-proc-name
     2894               ,input  'height':u
     2895               ,output v-resize-value-str
     2896               ) .
     2897             if v-resize-value-str <> '':U
     2898             then do:
     2899               run diasize_change-height in this-procedure
     2900                 (input  integer(v-resize-value-str)
     2901                 ,input  true
     2902                 ) .
     2903               assign
     2904                 v-restore-saved = true
     2905               .
     2906             end.
     2907           end.
     2908           if connected("ub") = true
     2909           then do:
     2910             run gbl/wndsizer.p
     2911               (input  v-cntxt-db-num
     2912               ,input  v-cntxt-userid
     2913               ,input  v-diasize-proc-name
     2914               ,input  'width':u
     2915               ,output v-resize-value-str
     2916               ) .
     2917             if v-resize-value-str <> '':U
     2918             then do:
     2919               run diasize_change-width in this-procedure
     2920                 (input  integer(v-resize-value-str)
     2921                 ,input  true
     2922                 ) .
     2923               assign
     2924                 v-restore-saved = true
     2925               .
     2926             end.
     2927           end.
     2928           if v-restore-saved <> true
     2929           then do:
     2930             if v-diasize-wndmax = true
     2931             then do:
     2932               run diasize_maximize in this-procedure
     2933                 (input  true
     2934                 ) .
     2935             end.
     2936           end.
     2937         end.
     2938         else do:
     2939           if v-diasize-wndmax = true
     2940           then do:
     2941             run diasize_maximize in this-procedure
     2942               (input  true
     2943               ) .
     2944           end.
     2945         end.
     2946       end.
     2947     end.
     2948   end procedure.
     2949   procedure diasize_need-full-display :
     2950     define output parameter p-need-full-display as logical   no-undo .
     2951     do
     2952     on error undo, return error return-value
     2953     :
     2954       assign
     2955         p-need-full-display = v-diasize-need-full-display
     2956       .
     2957       assign
     2958         v-diasize-need-full-display = false
     2959       .
     2960     end.
     2961   end procedure.
     2962   procedure get-context :
     2963      define output parameter p-db-num as integer          no-undo.
     2964      define output parameter p-user-id as character        no-undo.
     2965      define variable v-login               as character    no-undo.
     2966      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2967      define buffer buf_user-login  for ub.user-login .
     2968      do
     2969      on error undo, return error
     2970      :
     2971            FIND FIRST buf_sys-ctrl no-lock.
     2972            ASSIGN
     2973               v-login = USERID("ub")
     2974               p-db-num = buf_sys-ctrl.db-num
     2975            .
     2976            FIND FIRST buf_user-login
     2977                 WHERE buf_user-login.db-num = p-db-num
     2978                   AND buf_user-login.user-login = v-login
     2979                 no-lock
     2980                 no-error
     2981                 .
     2982            IF AVAILABLE buf_user-login
     2983            THEN DO:
     2984               assign
     2985                  p-user-id = buf_user-login.user-id
     2986               .
     2987            END.
     2988      end.
     2989   end procedure.
