      385   define  stream PrnLibStream.
      386   procedure prn-lib-prn-file :
      387     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      388     define input parameter p-DIsabledoptions as integer no-undo .
      389     define variable v-report-name as character no-undo .
      390     define variable v-user-action as character no-undo .
      391     define variable v-printed     as logical   no-undo .
      392     define variable v-exist       as logical   no-undo .
      393     do
      394       on error undo, return error
      395       :
      396       run prn-lib-get-report-name  in this-procedure (
      397         input parParentProc
      398         ,output v-report-name
      399         ).
      400   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      401   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      402     (input  v-report-name
      403     ,input  2
      404     ,output v-exist
      405     )  .
      406       if NOT v-exist then
      407       DO:
      408         Message
      409           "Нет заданий на печать ! "
      410           view-as alert-box .
      411         Return  .
      412       End.
      413       run gbl/prnfilen.w
      414         (input  ""
      415         ,input  p-DisabledOptions
      416         ,input  string(v-report-name )
      417         ,input  7
      418         ,output v-user-action
      419         ,output v-printed
      420         ) .
      421       if v-printed then
      422       do:
      423         return "YES" .
      424       end.
      425       else
      426       do:
      427         return "NO" .
      428       end.
      429     end.
      430   end procedure.
      431   procedure prn-lib-open-stream :
      432     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      433     define input parameter p-page-size    as integer no-undo .
      434     define input parameter p-is-stream    as logical no-undo .
      435     define input parameter p-append       as logical no-undo .
      436     define variable v-report-name as character no-undo .
      437     do
      438       on error undo, return error
      439       :
      440       run prn-lib-get-report-name  in this-procedure (
      441         input parParentProc
      442         ,output v-report-name
      443         ).
      444       if p-is-stream then
      445       do:
      446         if p-append then
      447         do:
      448           output stream PrnLibStream to value( v-report-name )
      449             page-size value(p-page-size) append .
      450         end.
      451         if not p-append then
      452         do:
      453           output stream PrnLibStream to value( v-report-name )
      454             page-size value(p-page-size) .
      455         end.
      456       end.
      457       if not p-is-stream then
      458       do:
      459         if p-append then
      460         do:
      461           output to value( v-report-name )
      462             page-size value(p-page-size) append .
      463         end.
      464         if not p-append then
      465         do:
      466           output to value( v-report-name )
      467             page-size value(p-page-size) .
      468         end.
      469       end.
      470     end.
      471   end procedure.
      472   procedure prn-lib-open-exp :
      473     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      474     define input parameter p-is-stream    as logical no-undo .
      475     define input parameter p-is-append    as logical no-undo .
      476     define output parameter p-ReportFileName as char init "report" no-undo.
      477     define output parameter p-process as logical no-undo .
      478     define variable glog as logical no-undo .
      479     do
      480       on error undo, return error
      481       :
      482       SYSTEM-DIALOG GET-FILE p-ReportFileName
      483         TITLE      "Укажите путь"
      484         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      485         ASK-OVERWRITE
      486         CREATE-TEST-FILE
      487         SAVE-AS
      488         USE-FILENAME
      489         DEFAULT-EXTENSION "txt"
      490         UPDATE glog
      491         .
      492       if not glog then  return.
      493       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      494       if p-is-stream then
      495       do:
      496         if p-is-append then
      497         do:
      498           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      499         end.
      500         else
      501         do:
      502           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      503         end.
      504       end.
      505       else
      506       do:
      507         if p-is-append then
      508         do:
      509           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      510         end.
      511         else
      512         do:
      513           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      514         end.
      515       end.
      516       p-process = yes.
      517     end.
      518   end procedure.
      519   procedure prn-lib-get-report-name :
      520     define input parameter parParentProc  as widget-handle no-undo.
      521     define output parameter p-report-name as character no-undo .
      522     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      523   end procedure.
      524   procedure prn-lib-reportviewer-report-name :
      525     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      526     define input parameter p-report-name-html as character no-undo .
      527     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      528   end procedure.
      529   procedure prn-lib-reportviewer :
      530     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      531     define input parameter p-report-name-html as character no-undo .
      532     define input parameter p-param        as character no-undo .
      533     define variable v-excel           as character no-undo init 'TRUE' .
      534     define variable v-value-character as character no-undo .
      535     define variable v-value-integer   as character no-undo .
      536     define variable v-value-date      as date      no-undo .
      537     define variable v-value-decimal   as decimal   no-undo .
      538     define variable rep-excel         as logical   no-undo .
      539     define variable excel-string      as character no-undo .
      540     define variable v-param-type      as character no-undo .
      541     define variable v-tth             as handle    no-undo .
      542     run adm/shattri.p (
      543       input "get":U
      544       ,input  ""
      545       ,input  0
      546       ,input  'report-glob':U
      547       ,input  'rep-excel':U
      548       ,output v-value-character
      549       ,output v-value-date
      550       ,output v-value-decimal
      551       ,output v-value-integer
      552       ,output rep-excel
      553       ,output v-param-type
      554       ,INPUT-OUTPUT table-handle v-tth
      555       )  .
      556     if rep-excel then v-excel = "TRUE" .
      557     else v-excel = "FALSE" .
      558     if p-param eq ""
      559     then
      560        p-param = "EXCEL:" + v-excel.
      561     else
      562        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      563     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      564   end procedure.
      565   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      566   procedure fltfield-clear :
      567     define output parameter loc-fld as character no-undo.
      568     define output parameter loc-lab as character no-undo .
      569     define output parameter loc-spr as character no-undo .
      570     define output parameter loc-dim as character no-undo .
      571     assign
      572       loc-fld = ""
      573       loc-lab = ""
      574       loc-spr = ""
      575       loc-dim = "0"
      576     .
      577   end procedure .
      578   procedure fltfield-add :
      579     define input        parameter par-fld as character no-undo.
      580     define input        parameter par-lab as character no-undo .
      581     define input        parameter par-spr as character no-undo .
      582     define input-output parameter loc-fld as character no-undo.
      583     define input-output parameter loc-lab as character no-undo .
      584     define input-output parameter loc-spr as character no-undo .
      585     define input-output parameter loc-dim as character no-undo .
      586     do
      587     on error undo, return error
      588     :
      589       assign
      590       loc-fld = if loc-dim = '0'
      591                 then par-fld
      592                 else (loc-fld + chr(44) + par-fld)
      593       loc-lab = if loc-dim = '0'
      594                 then par-lab
      595                 else (loc-lab + chr(44) + par-lab)
      596       loc-spr = if loc-dim = '0'
      597                 then par-spr
      598                 else (loc-spr + chr(44) + par-spr)
      599       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      600                 string(integer(if num-entries(loc-dim) > 1
      601                               then entry(2, loc-dim)
      602                               else entry(1, loc-dim)
      603                               ) + 1)
      604       no-error
      605       .
      606     end.
      607   end procedure.
      608   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      609   define variable v-waitfram-action01         as character   no-undo .
      610   define variable v-waitfram-action02         as character   no-undo .
      611   define variable v-waitfram-action03         as character   no-undo .
      612   define variable mWaitFramTextBeg            as character   no-undo.
      613   define variable mWaitFramTextEnd            as character   no-undo.
      614   define variable mWaitFramView               as logical     no-undo.
      615   define variable mWaitProcEvent              as logical     no-undo init yes.
      616   define variable mWaitFramInterval           as integer     no-undo init 1 .
      617   define variable mWaitFramStop               as logical     no-undo.
      618   define variable mWaitFramStopUser           as logical     no-undo.
      619   define variable mWaitFramStopTimeOut        as logical     no-undo.
      620   define variable mWaitFramStartProc          as datetime-tz no-undo.
      621   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      622   define button B-WaitFramStop auto-end-key
      623        label "Стоп"
      624        size 10 by 1 tooltip "Остоновить процесс".
      625   define button B-viewProcInfo
      626        label "Информация"
      627        size 15 by 1 tooltip "Информация о процесс".
      628   define frame waitfram
      629     v-waitfram-action01 format "x(72)" no-label skip
      630     v-waitfram-action02 format "x(72)" no-label skip
      631     v-waitfram-action03 format "x(72)" no-label skip
      632     B-viewProcInfo
      633     B-WaitFramStop at row 4 col 30
      634     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      635     .
      636   define new global shared variable mBatchMode as logical no-undo init ?.
      637   define variable mFramBachModHandle as handle no-undo.
      638   mFramBachModHandle = frame waitfram:handle.
      639   define variable mFameOldVis as logical no-undo.
      640   define variable mVisCUrentVin as logical no-undo.
      641   if session:batch-mode
      642   then
      643      mBatchMode = yes.
      644   if mBatchMode = ? then do:
      645     mVisCUrentVin = current-window:visible.
      646     mFameOldVis = mFramBachModHandle:visible.
      647     mFramBachModHandle:visible  = yes.
      648     mBatchMode = mFramBachModHandle:visible ne yes.
      649     mFramBachModHandle:visible = mFameOldVis.
      650     current-window:visible = mVisCUrentVin.
      651   end.
      652    if  log-manager:logfile-name ne ?
      653     then DO:
      654         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      655         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      656         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      657     end.
      658   on choose of B-WaitFramStop in frame waitfram
      659   do:
      660     mWaitFramStop = yes.
      661     mWaitFramStopUser = yes.
      662   end.
      663   function waitfram-check-timeout returns logical():
      664      define variable vtime as int64 no-undo.
      665      if mWaitFramStopTimeOut
      666      then
      667         return yes.
      668      vtime = ( now - mWaitFramStartProc ) / 1000 .
      669      if     mWaitFramTimeOut ne ?
      670         and mWaitFramTimeOut ne 0
      671         and mWaitFramTimeOut lt vtime
      672      then do:
      673         mWaitFramStopTimeOut = yes.
      674      end.
      675      return mWaitFramStopTimeOut.
      676   end.
      677   procedure waitfram-hide :
      678     if not session:batch-mode
      679     then do
      680     on error undo, return error return-value
      681     :
      682       pause 0 before-hide .
      683       if not mBatchMode then
      684         hide frame waitfram .
      685     if     not mWaitFramView
      686        and mWaitProcEvent
      687     then
      688       process events .
      689     end.
      690   end procedure.
      691   procedure waitfram-show :
      692     define input  parameter p-message as character no-undo .
      693     define variable v-left-margin as integer   no-undo .
      694     if not session:batch-mode
      695     then do
      696     on error undo, return error return-value
      697     :
      698       if length(p-message) <= 70 then do:
      699         assign
      700           v-left-margin = integer((70 - length(p-message)) / 2)
      701         .
      702         assign
      703           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      704         .
      705         assign
      706           v-waitfram-action01 = " "
      707           v-waitfram-action02 = " "
      708                                    + fill(" ", v-left-margin)
      709                                    + p-message
      710           v-waitfram-action03 = " "
      711         .
      712       end.
      713       else do:
      714         define variable vRindex1 as integer no-undo.
      715         define variable vRindex2 as integer no-undo.
      716         vRindex1 = r-index(p-message," ",70).
      717         if vRindex1 = 0
      718         then
      719            vRindex1 = 70.
      720         if length(p-message)  <= vRindex1 + 70 then do:
      721           assign
      722             v-waitfram-action01 = " "
      723             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      724             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      725           .
      726         end.
      727         else do:
      728           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      729           if vRindex2 <= vRindex1
      730           then
      731              vRindex2 = vRindex1 + 70.
      732           assign
      733             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      734             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      735             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      736           .
      737         end.
      738       end.
      739       B-viewProcInfo:visible   in frame waitfram = no.
      740       B-viewProcInfo:sensitive in frame waitfram = no.
      741       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      742       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      743       if  (   mWaitFramView
      744          or  mWaitProcEvent)
      745          and not mBatchMode
      746       then
      747          display
      748             v-waitfram-action01 skip
      749             v-waitfram-action02 skip
      750             v-waitfram-action03 skip
      751          with frame waitfram .
      752       if     mWaitFramView
      753          then do:
      754             if     mWaitFramInterval ne ?
      755                and not mBatchMode
      756             then
      757                wait-for go of frame waitfram pause mWaitFramInterval.
      758          end.
      759          else
      760             if     mWaitProcEvent
      761                and not mBatchMode
      762             then
      763                process events .
      764     end.
      765   end procedure.
      766      procedure waitfram-show-this:
      767         define input  parameter iInterval as int64 no-undo.
      768         define variable vtime as int64 no-undo.
      769         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      770         mWaitFramInterval = iInterval.
      771         run waitfram-show (substitute("&1&2 &3&4" ,
      772                                       mWaitFramTextBeg ,
      773                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      774                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      775                                       mWaitFramTextEnd
      776                                      )
      777                           ).
      778      end.
      779      procedure WaitFramRunPause:
      780         define input  parameter iInterval as dec no-undo.
      781         define variable vStart  as datetime-tz no-undo.
      782         define variable vend    as datetime-tz no-undo.
      783         define variable vint as int64 no-undo.
      784         define variable vOk as logical no-undo.
      785         vStart = now.
      786         vend   = vStart.
      787         publish "WaitFramPause" (iInterval,output vOk).
      788         vend   =  now.
      789         vint = vend - vStart.
      790         vint = iInterval - vint / 1000.
      791         if     not mWaitFramStop
      792            and (   vint > 0
      793                 or (    not vOk
      794                     and iInterval eq ?
      795                     )
      796                 )
      797         then
      798            run waitfram-show-this (iInterval).
      799         vend   =  now.
      800         vint = vend - vStart.
      801         vint = iInterval - vint / 1000.
      802         if     not mWaitFramStop
      803            and vint > 0
      804         then do:
      805            run gbl/pause.p (vint * 1000).
      806         end.
      807         if iInterval ne ?
      808         then
      809            publish "WaitFramStop".
      810         waitfram-check-timeout().
      811      end.
      812      procedure WaitFramWaitFor:
      813         define input  parameter iInterval as dec no-undo.
      814         assign
      815            mWaitFramStartProc   = now
      816            mWaitFramStopUser    = no
      817            mWaitFramStopTimeOut = no
      818         .
      819         block-wait:
      820         do while not mWaitFramStop:
      821            run WaitFramRunPause (iInterval).
      822            if  waitfram-check-timeout()
      823            then do:
      824               leave block-wait.
      825            end.
      826         end.
      827         run waitfram-hide.
      828      end.
      829   procedure waitfram-join :
      830     define input  parameter p-line-1  as character no-undo .
      831     define input  parameter p-line-2  as character no-undo .
      832     define input  parameter p-line-3  as character no-undo .
      833     define output parameter p-message as character no-undo .
      834     do
      835     on error undo, return error return-value
      836     :
      837       assign
      838         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      839                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      840                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      841       .
      842     end.
      843   end procedure.
      844   function waitfram-join-function returns character
      845     (input p-line-1 as character
      846     ,input p-line-2 as character
      847     ,input p-line-3 as character
      848     ).
      849     define variable v-message as character no-undo .
      850     run waitfram-join in this-procedure
      851       (input  p-line-1
      852       ,input  p-line-2
      853       ,input  p-line-3
      854       ,output v-message
      855       ) .
      856     return v-message .
      857   end function .
      858   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      859   define new global shared variable g#lib-trn  as handle no-undo .
      860   define new global shared variable g#lib-trn2 as handle no-undo .
      861   define new global shared variable g#lib-trn3 as handle no-undo .
      862   define new global shared variable g#lib-trn4 as handle no-undo .
      863   function shift-name-no-err return char (
      864                                           buffer loc-chk-doc for ub.chk-doc
      865    ).
      866   define variable varshift-name as character no-undo.
      867   define variable varshift-name-num as character no-undo.
      868     varshift-name = loc-chk-doc.shift-name.
      869   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      870   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_shiftnme in g#lib-trn3 ( input  loc-chk-doc.obj-type,
      871                          input  loc-chk-doc.obj-code,
      872                          input  loc-chk-doc.shift-date,
      873                          input  loc-chk-doc.shift-num,
