    10065   PROCEDURE proc-find-code :
    10066   define input parameter par-next as logical no-undo.
    10067   define input parameter pardoc-code like ub.chk-doc.doc-code no-undo.
    10068   define variable v-int as integer   no-undo .
    10069   assign
    10070   sch-date = ?
    10071   .
    10072   display
    10073   sch-date
    10074   0 @ sch-sum
    10075   with frame Dialog-Frame.
    10076   if par-mode = 'IBS-TH':U
    10077   and lookup(string(p-chk-type), '201,206,208,301,306':U) = 0 then do:
    10078     assign
    10079     v-int = integer(pardoc-code)
    10080     no-error.
    10081     if error-status :error
    10082     or trim(pardoc-code, "1234567890") <> ''
    10083     or length(pardoc-code) > 9 then do:
    10084       bell.
    10085       undo, return error .
    10086     end.
    10087     assign
    10088     pardoc-code = string(integer(pardoc-code)).
    10089     run OpenBr in this-procedure (
    10090         input false
    10091         ,input par-next
    10092         ,input substitute("and c-doc.chk-num  = &1 "
    10093           , pardoc-code)
    10094         ).
    10095   end.
    10096   else do:
    10097     assign
    10098     pardoc-code = chr(34) + pardoc-code + chr(34).
    10099     run OpenBr in this-procedure (
    10100         input false
    10101         ,input par-next
    10102         ,input substitute("and c-doc.doc-code   begins &1 "
    10103           , pardoc-code)
    10104         ).
    10105   end.
    10106   apply "entry":u to sch-code in frame Dialog-Frame .
    10107   END PROCEDURE.
    10108   PROCEDURE proc-find-date :
    10109   define input parameter par-next as logical no-undo.
    10110   define input parameter parchk-date like ub.chk-doc.chk-date no-undo.
    10111   define variable varchk-datechr as character no-undo.
    10112   display
    10113   '':U @ sch-code
    10114   0 @ sch-sum
    10115   with frame Dialog-Frame.
    10116   assign
    10117   varchk-datechr = string(day(parchk-date)) + chr(47) +
    10118                    string(month(parchk-date)) + chr(47) +
    10119                    string(year(parchk-date)).
    10120   run OpenBr in this-procedure (
    10121      input false
    10122     ,input true
    10123     ,input substitute("and c-doc.chk-date = &1 "
    10124       , varchk-datechr)
    10125     ).
    10126   apply "entry":u to sch-date in frame Dialog-Frame.
    10127   END PROCEDURE.
    10128   PROCEDURE proc-find-sum :
    10129   define input parameter par-next as logical no-undo.
    10130   define input parameter partot-doc like ub.chk-doc.tot-doc no-undo.
    10131   assign
    10132   sch-date = ?
    10133   .
    10134   display
    10135   sch-date
    10136   "":U @ sch-code
    10137   with frame Dialog-Frame.
    10138   run OpenBr in this-procedure (
    10139        input false
    10140       ,input par-next
    10141       ,input substitute("and c-doc.netto = &1 "
    10142         , partot-doc)
    10143       ).
    10144   apply "entry":u to sch-sum in frame Dialog-Frame .
    10145   END PROCEDURE.
    10146   PROCEDURE reposition-chk-doc :
    10147   define input  parameter p-direction   as character no-undo .
    10148   define output parameter p-chk-doc-recid as recid no-undo .
    10149     case p-direction :
    10150       when "first":U
    10151       then do:
    10152         get first br-docs.
    10153       end.
    10154       when "last":U
    10155       then do:
    10156         get last br-docs.
    10157       end.
    10158       when "prev":U
    10159       then do:
    10160         get prev br-docs.
    10161         if not available c-doc then do:
    10162           message
    10163           "Это первый чек списка"
    10164           view-as alert-box.
    10165         end.
    10166       end.
    10167       when "next":U
    10168       then do:
    10169         get next br-docs.
    10170         if not available c-doc then do:
    10171           message
    10172           "Это последний чек списка"
    10173           view-as alert-box.
    10174         end.
    10175       end.
    10176     end case .
    10177     assign
    10178     p-chk-doc-recid = recid(c-doc)
    10179     .
    10180     run reposition-query in this-procedure
    10181       (input p-chk-doc-recid
    10182       ).
    10183   END PROCEDURE.
    10184   PROCEDURE reposition-query :
    10185   define input parameter p-recid as recid no-undo .
    10186     if p-recid <> ?
    10187     then do:
    10188       reposition br-docs to recid p-recid no-error.
    10189     end.
    10190     do with frame Dialog-Frame:
    10191       apply "entry":u to browse BR-docs .
    10192       apply "VALUE-CHANGED":u to browse BR-docs .
    10193     end.
    10194   END PROCEDURE.
