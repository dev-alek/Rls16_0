     9359   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     9360     (input  parobj-type
     9361     ,input  parobj-code
     9362     ,output v-host-code
     9363     )  .
     9364     do
     9365     on error undo, return error
     9366     on stop undo, return error
     9367     :
     9368     CASE p-change-type:
     9369       when "one-change":U then do:
     9370         if NOT available c-doc then do:
     9371           message
     9372           "Неправильно выбран чек."
     9373           view-as alert-box ERROR.
     9374           return error.
     9375         end.
     9376         if c-doc.out-code <> ? then do:
     9377           message
     9378           "Этот чек включен в отчет о продаже или документ МЦ." skip
     9379           "Изменение невозможно."
     9380           view-as alert-box INFORMATION .
     9381           return error.
     9382         end.
     9383         if c-doc.chk-type = 13 or c-doc.chk-type = 40 then do:
     9384           message
     9385           "Изменение чеков открытия/закрытия смены невозможно."
     9386           view-as alert-box INFORMATION .
     9387           return error.
     9388         end.
     9389         assign
     9390         v-doc-rec = recid(c-doc).
     9391         if lookup(string(c-doc.chk-type), '2,3,4,5,7':U) > 0 then do:
     9392   define variable vss-include-info99 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9393   do:
     9394     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     9395       (input  v-cntxt-db-num
     9396       ,input  v-cntxt-userid
     9397       ,input  0
     9398       ,input  'actn_wth-receipts_update':U
     9399       ,input  'object':U
     9400       ,input  v-host-code
     9401       ,input  c-doc.obj-type
     9402       ,input  c-doc.obj-code
     9403       ,input  0
     9404       ,input  0
     9405       ,input  0
     9406       ,input  true
     9407       ,output glog
     9408       )  .
     9409   end.
     9410     if NOT glog then return no-apply.
     9411           run str/checkwth.w
     9412                           (
     9413                             input parparentproc
     9414                           ,input 'ИЗМЕНЕНИЕ':U
     9415                           ,input c-doc.obj-type
