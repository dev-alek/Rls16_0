     3022           frame Dialog-Frame:title
     3023             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     3024         .
     3025         assign
     3026           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3027         .
     3028       end.
     3029       else do:
     3030         assign
     3031           b-sch :tooltip = ""
     3032         .
     3033       end.
     3034     end.
