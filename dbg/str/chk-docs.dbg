     9961                                         , 'Объект/Дата смены/№ смены'
     9962                                         , ('sht' + chr(4) +
     9963                                            '':U + chr(4) +
     9964                                            string(0) + chr(4) +
     9965                                            'no'),
     9966       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9967     end.
     9968     otherwise do:
     9969   define variable vss-include-info104 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9970   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     9971     (input  'маг':U
     9972     ,input  parobj-code
     9973     ,input  'shift-on=request'
     9974     ,output l-shift-on
     9975     )  .
     9976       if not l-shift-on then do:
     9977   define variable vss-include-info105 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9978   define variable v-param-type105 as character no-undo .
     9979   define variable v-value-character105 as character no-undo .
     9980   define variable v-value-date105 as date no-undo .
     9981   define variable v-value-decimal105 as decimal no-undo .
     9982   define variable v-value-integer105 as INTEGER no-undo .
     9983   define variable v-tth105 as handle no-undo .
     9984   run adm/shattri.p (
     9985       input "get":U
     9986       ,input  parobj-type
     9987       ,input  parobj-code
     9988       ,input  'get-chk':U
     9989       ,input  'cas-shft':U
     9990       ,output v-value-character105
     9991       ,output v-value-date105
     9992       ,output v-value-decimal105
     9993       ,output v-value-integer105
     9994       ,output cas-shft
     9995       ,output v-param-type105
     9996       ,INPUT-OUTPUT table-handle v-tth105
     9997       )  .
     9998   delete object v-tth105.
     9999       end.
    10000       if l-shift-on
    10001       or cas-shft then do:
    10002         run fltfield-add in this-procedure('shift-date*shift-num'
    10003                                           , 'Дата смены/№ смены'
    10004                                           , ('sht' + chr(4) +
    10005                                             parobj-type + chr(4) +
