     3036   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3037   on ' ' of sch-date in frame Dialog-Frame
     3038   do:
     3039     if (can-query (self, "sensitive")
     3040        and
     3041        self :sensitive = true
     3042        )
     3043     or (can-query (self, "read-only")
     3044        and
     3045        self :read-only = false
     3046        )
     3047     then do:
     3048       assign
     3049         self :screen-value = ?
     3050       .
     3051     end.
     3052     return no-apply.
     3053   end.
     3054   on delete-character of sch-date in frame Dialog-Frame
     3055   do:
     3056     if (can-query (self, "sensitive")
     3057        and
     3058        self :sensitive = true
     3059        )
     3060     or (can-query (self, "read-only")
     3061        and
     3062        self :read-only = false
     3063        )
     3064     then do:
     3065       assign
     3066         self :screen-value = ?
     3067       .
     3068     end.
     3069     return no-apply.
     3070   end.
     3071   on ctrl-d of sch-date in frame Dialog-Frame
     3072   do:
     3073     define variable v-curr-sv-date as date no-undo .
     3074     if (can-query (self, "sensitive")
     3075        and
     3076        self :sensitive = true
     3077        )
     3078     or (can-query (self, "read-only")
     3079        and
     3080        self :read-only = false
     3081        )
     3082     then do:
     3083       if self :handle <> focus :handle
     3084       then do:
     3085         apply "entry":u to self .
     3086       end.
     3087       run gbl/getcurdt.p
     3088         (output v-curr-sv-date
     3089         ) .
     3090       assign
     3091         self :screen-value = string(v-curr-sv-date) .
     3092       .
     3093     end.
     3094     return no-apply.
     3095   end.
     3096   on ctrl-b of sch-date in frame Dialog-Frame
     3097   do:
     3098     if (can-query (self, "sensitive")
     3099        and
     3100        self :sensitive = true
     3101        )
     3102     or (can-query (self, "read-only")
     3103        and
     3104        self :read-only = false
     3105        )
     3106     then do:
     3107       if self :handle <> focus :handle
     3108       then do:
     3109         apply "entry":u to self .
     3110       end.
     3111       define variable v-curr-sv-date as date no-undo .
     3112       define variable v-new-sv-date  as date no-undo .
     3113       assign
     3114         v-curr-sv-date = date(self :screen-value) no-error
     3115       .
     3116       if v-curr-sv-date = ?
     3117       then do:
     3118         run gbl/getcurdt.p
     3119           (output v-curr-sv-date
     3120           ) .
     3121       end.
     3122       if v-curr-sv-date <> ?
     3123       then do:
     3124         assign
     3125           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     3126         .
     3127         assign
     3128           self :screen-value = string(v-new-sv-date) .
     3129         .
     3130       end.
     3131     end.
     3132     return no-apply .
     3133   end.
     3134   on ctrl-e of sch-date in frame Dialog-Frame
     3135   do:
     3136     if (can-query (self, "sensitive")
     3137        and
     3138        self :sensitive = true
     3139        )
     3140     or (can-query (self, "read-only")
     3141        and
     3142        self :read-only = false
     3143        )
     3144     then do:
     3145       if self :handle <> focus :handle
     3146       then do:
     3147         apply "entry":u to self .
     3148       end.
     3149       define variable v-curr-sv-date as date no-undo .
     3150       define variable v-new-sv-date  as date no-undo .
     3151       assign
     3152         v-curr-sv-date = date(self :screen-value) no-error
     3153       .
     3154       if v-curr-sv-date = ?
     3155       then do:
     3156         run gbl/getcurdt.p
     3157           (output v-curr-sv-date
     3158           ) .
