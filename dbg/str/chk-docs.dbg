     3730     (input filter-point
     3731     ,output flt-rec-39
     3732     ,output filter-name-39
     3733     ,output where-phrase-39
     3734     ,output sort-phrase-39
     3735     ,output where-phrase-rus-39
     3736     ,output sort-phrase-rus-39
     3737     ).
     3738   if p-open-query then do:
     3739       run set-filter-name in this-procedure
     3740         (INPUT filter-name-39
     3741         ) no-error .
     3742     assign
     3743       l-filter-open-39 = false
     3744     .
     3745     if flt-rec-39 <> ?
     3746       or sort-column-phrase > ""
     3747     then do:
     3748       define variable  parameter-2-39 as character no-undo .
     3749       define variable  parameter-3-39 as character no-undo .
     3750       define variable  parameter-4-39 as character no-undo .
     3751       define variable  parameter-5-39 as character no-undo .
     3752       define variable  parameter-6-39 as character no-undo .
     3753       define variable  parameter-7-39 as character no-undo .
     3754         assign
     3755         parameter-3-39 =
     3756                                 "FOR EACH c-doc"
     3757         parameter-4-39 =
     3758           (
     3759             if (" TRUE " + " " + where-phrase-39) <> ""
     3760             then " TRUE " + " " + where-phrase-39
     3761             else "true"
     3762           )
     3763         parameter-5-39 = (" " + "" + " " + "")
     3764         parameter-6-39 = if sort-phrase-39 = ''
     3765                              then
     3766           (
     3767           " " + "  " +
     3768             " " + sort-column-phrase +
     3769           " " + "  "
     3770           )
     3771                              else
     3772           (
     3773           " " + "  " +
     3774             " " + sort-column-phrase +
     3775           " " + sort-phrase-39
     3776           )
     3777         parameter-7-39 =
     3778           " indexed-reposition  "
     3779       .
     3780       do
     3781       on stop undo, leave
     3782       on error undo, leave
