        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: delmvvz.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: str/delmvvz.p $":U .
        7   define variable vss-description as character no-undo init "".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   define input parameter parparentproc  as widget-handle                no-undo.
       78   define input parameter varchip-num-main as integer   no-undo.
       79   define input parameter varchip-num      as integer   no-undo.
       80   define input parameter v-user-action    as character no-undo.
       81   define input parameter v-printed        as logical   no-undo.
       82   define shared buffer t-doc for ub.trn-doc .
       83   define buffer del_trn-doc for ub.trn-doc.
       84   if t-doc.status_ <> 'факт':U then return .
       85   if t-doc.ext-doc-type <> 'ep':U then return .
       86     define variable vardoc-hold as logical no-undo.
       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
       89     (input  t-doc.doc-code
       90     ,output vardoc-hold
       91     )  .
       92   if vardoc-hold <> true  then return .
       93   define buffer bf_clients   for ub.clients .
       94   define buffer bf2_clients   for ub.clients .
       95   define buffer bf-c_clients for ub.clients.
       96   define buffer bf-vzv_trn-doc for ub.trn-doc.
       97   define buffer bf-vzp_trn-doc for ub.trn-doc.
       98     find first bf_clients where bf_clients.obj-type = t-doc.obj-type and
       99                                 bf_clients.obj-code = t-doc.obj-code no-lock.
      100     find first bf2_clients where bf2_clients.obj-type = t-doc.hold-obj-type and
      101                                 bf2_clients.obj-code  = t-doc.hold-obj-code no-lock.
      102     find first  bf-vzv_trn-doc where bf-vzv_trn-doc.hold-doc-code-parent = t-doc.doc-code and
      103                                      bf-vzv_trn-doc.ext-doc-type = 're':U  no-lock no-error .
      104          if not available bf-vzv_trn-doc then do:
      105               message substitute("На документе МФ Возврат поставщика &1 по объекту &2 &3 базы данных &4 , нет МФ Возврата покупателю . БД покупателя : &5 &6 Нельзя удалять МФ документ разных БД ",
      106                                       t-doc.doc-code,
      107                                       t-doc.obj-type,
      108                                       t-doc.obj-code,
      109                                       bf_clients.db-num,
      110                                       bf2_clients.db-num ,
      111                                       chr(10)
      112                                       ) view-as alert-box error.
      113                return .
      114         end.
      115   do TRANSACTION :
      116       find first bf-vzv_trn-doc where bf-vzv_trn-doc.hold-doc-code-parent = t-doc.doc-code and
      117                                       bf-vzv_trn-doc.ext-doc-type = 're':U  exclusive-lock no-error.
      118       if available bf-vzv_trn-doc then do:
      119           if bf-vzv_trn-doc.status_ = 'факт':U then do:
      120               find first bf-c_clients where bf-c_clients.obj-type = bf-vzv_trn-doc.obj-type and
      121                                             bf-c_clients.obj-code = bf-vzv_trn-doc.obj-code no-lock.
      122                                             if bf_clients.db-num <> bf-c_clients.db-num then do:
      123                                               message substitute("В документе МФ возврата поставщику &1 по объекту &2 &3 базы данных &4 , а МФ возврат покупателя на объекте &5 &6 базы данных &7. Нельзя удалять МФ документы относящиеся к разным базам данных.",
      124                                                                       t-doc.doc-code,
      125                                                                       t-doc.obj-type,
      126                                                                       t-doc.obj-code,
      127                                                                       bf_clients.db-num,
      128                                                                       bf-vzv_trn-doc.obj-type,
      129                                                                       bf-vzv_trn-doc.obj-code,
      130                                                                       bf-c_clients.db-num
      131                                                                       ) view-as alert-box error.
      132                                               return error.
      133                                             end.
      134               run str/del-doc.p
      135                 ( input parparentproc,
      136                   input bf-vzv_trn-doc.doc-code,
      137                   input g#db-num,
      138                   input "del-doc.err",
      139                   input ?,
      140                   input ?,
      141                   input g#userid,
      142                   input 0,
      143                   input  varchip-num-main,
      144                   output varchip-num )
      145                 no-error.
      146               if error-status:error then do:
      147                 message
      148                   vss-workfile vss-revision vss-description skip
      149                   "Ошибка при удалении документа возврата внешнего." skip
      150                   return-value skip
      151                   trim(error-status :get-message(1))
      152                   trim(error-status :get-message(2))
      153                   view-as alert-box error.
      154                 if search ("del-doc.err") <> ? then do:
      155                   run gbl/prnfilen.w
      156                     (input  "Ошибки при удалении документа"
      157                     ,input  0
      158                     ,input  "del-doc.err"
      159                     ,input  7
      160                     ,output v-user-action
      161                     ,output v-printed
      162                     ).
      163                 end.
      164                 return error.
      165               end.
      166           end.
      167           else do:
      168               message "Имеется открытый документ МФ возврата поставщику по данному МФ внешнему возврату." skip
      169                       "Номер документа: " bf-vzv_trn-doc.doc-code skip
      170               view-as alert-box error.
      171               return error.
      172           end.
      173       end.
      174     run str/del-doc.p
      175       ( input parparentproc,
      176         input  t-doc.doc-code,
      177         input  g#db-num,
      178         input  "del-doc.err",
      179         input  ?,
      180         input  ?,
      181         input  g#userid,
      182         input  0,
      183         input  varchip-num-main,
      184         output varchip-num )
      185     no-error.
      186     if error-status:error then do:
      187       message
      188         vss-workfile vss-revision vss-description skip
      189         "Ошибка при удалении документа." skip
      190         return-value skip
      191         trim(error-status :get-message(1))
      192         trim(error-status :get-message(2))
      193         trim(error-status :get-message(3))
      194         trim(error-status :get-message(4))
      195         trim(error-status :get-message(5)) skip
      196         view-as alert-box error.
      197       if search ("del-doc.err") <> ? then do:
      198         run gbl/prnfilen.w
      199           (input  "Ошибки при удалении документа"
      200           ,input  0
      201           ,input  "del-doc.err"
      202           ,input  7
      203           ,output v-user-action
      204           ,output v-printed
      205           ).
      206       end.
      207       return error.
      208     end.
      209   end.
