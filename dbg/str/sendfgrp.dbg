        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-parameter   as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: sendfgrp.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: str/sendfgrp.p $":U .
       11   define variable vss-description as character no-undo init "пересылка групп блюд на кассу - пускальник".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   DEFINE SHARED TEMP-TABLE cash-fgrp no-undo
       83   FIELD node-code like ub.fbr-gds-grp.node-code
       84   FIELD upper-code like ub.fbr-gds-grp.upper-code
       85   FIELD out-code like ub.fbr-gds-grp.out-code
       86   FIELD node-name like ub.fbr-gds-grp.node-name
       87   FIELD upper-out-code like ub.fbr-gds-grp.out-code
       88   FIELD lvl-num        like ub.fbr-gds-grp.lvl-num
       89   FIELD stts  as integer
       90   FIELD action-code as integer
       91   index iout-code IS PRIMARY out-code
       92   index istts stts
       93   index ilvl action-code lvl-num
       94   .
       95   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       96     define variable v-cntxt-db-num        as integer   no-undo .
       97     define variable v-cntxt-userid        as character no-undo .
       98     define variable v-cntxt-level         as character no-undo .
       99     define variable v-cntxt-host-code-obj as integer   no-undo .
      100     define variable v-cntxt-obj-type      as character no-undo .
      101     define variable v-cntxt-obj-code      as integer   no-undo .
      102     define variable v-cntxt-db-num-obj    as integer   no-undo .
      103     define variable v-cntxt-is-admin      as logical   no-undo .
      104   define variable choice as integer no-undo.
      105   define variable     v-recid-list            as char no-undo.
      106   define variable     kk                  as int      no-undo.
      107   define variable callpoint as char no-undo.
      108   define variable glog as logical no-undo .
      109   define variable v-upper-out-code like ub.fbr-gds-grp.out-code no-undo .
      110   define variable log-file-name as character no-undo init "send-cd.txt".
      111   define variable v-view-log as logical no-undo .
      112   define variable i-obj-code like ub.clients.obj-code no-undo.
      113   define variable mode     as   character no-undo.
      114   define buffer buf_fbr-gds-grp for ub.fbr-gds-grp.
      115   define buffer upper_fbr-gds-grp for ub.fbr-gds-grp.
      116   assign
      117   i-obj-code = integer(entry(1, p-parameter, chr(4)))
      118   mode = entry(2, p-parameter, chr(4))
      119   no-error
      120   .
      121   if error-status:error then return error.
      122   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123     run mainmenu_getcntxt in parparentproc
      124       (output v-cntxt-db-num
      125       ,output v-cntxt-userid
      126       ,output v-cntxt-level
      127       ,output v-cntxt-host-code-obj
      128       ,output v-cntxt-obj-type
      129       ,output v-cntxt-obj-code
      130       ,output v-cntxt-db-num-obj
      131       ,output v-cntxt-is-admin
      132       ) .
      133   assign
      134   callpoint = mode.
      135   mode = if mode = "R" then "U" else mode.
      136   for each cash-fgrp:
      137       delete cash-fgrp.
      138   end.
      139   FIND FIRST ub.cash-desk NO-LOCK WHERE
      140              ub.cash-desk.db-num = g#db-num AND
      141              ub.cash-desk.pos-type = 'MAGIA-XML':U
      142               No-error.
      143   IF not avail(ub.cash-desk) then do:
      144     if callpoint <> "R" then do:
      145         run write-log-and-file in p-log-handle (
      146               input 1
      147             , input log-file-name
      148             , input 1
      149             , input substitute( "!!!&1 групп блюд реализуется только для касс &2"
      150                                 , (if mode = "U" then "Передача" else "Удаление")
      151                                 , 'MAGIA-XML':U
      152                               )
      153                                               ).
      154        return.
      155     end.
      156   end.
      157   else do:
      158     if callpoint = "R"
      159     then do:
      160       glog = yes.
      161     end.
      162     else do:
      163       define variable v-host-code as integer   no-undo .
      164   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      165   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      166     (input  'маг':U
      167     ,input  abs(i-obj-code)
      168     ,output v-host-code
      169     )  .
      170   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      171   do:
      172     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      173       (input  v-cntxt-db-num
      174       ,input  v-cntxt-userid
      175       ,input  0
      176       ,input  'actn_cashdesk-goods-groups_update':U
      177       ,input  'object':U
      178       ,input  v-host-code
      179       ,input  'маг':U
      180       ,input  abs(i-obj-code)
      181       ,input  0
      182       ,input  0
      183       ,input  0
      184       ,input  true
      185       ,output glog
      186       )  .
      187   end.
      188     end.
      189     if NOT glog then return .
      190     glog = yes.
      191     if callpoint = "R" then choice = 2.
      192     else
      193     run gbl/d-askw.w (input "Выбор групп блюд для пересылки",
      194                 input ( (if mode = "U" then "Переслать на кассу"
      195                           else "Удалить из кассы" ) +
      196                           chr(10) + "информацию о группах блюд по объекту"
      197                           ),
      198                 input "|",
      199                 input "Все  имеющиеся в базе|Выборочно|Отказ от пересылки",
      200                 input "||",
      201                 input 1,
      202                 input 3,
      203                 output choice).
      204     CASE choice :
      205       when 3 then
      206           return .
      207       when 2 then do:
      208         if callpoint = "R" then do:
      209         end.
      210         else do:
      211           run ref/fbrggrp.w (
      212                 input parparentproc
      213               , input 'маг':U
      214               , input i-obj-code
      215               , input "b-sel,b-mark"
      216               , input-output v-recid-list
      217           ).
      218           if v-recid-list <> "" then do:
      219             run write-log-and-file in p-log-handle (
      220                   input 1
      221                 , input log-file-name
      222                 , input 1
      223                 , input substitute("&1 магазина &2: выборочная пересылка групп блюд"
      224                                   , (if mode = "U" then "Пересылка на кассы" else "Удаление с касс" )
      225                                   , i-obj-code)
      226                 ).
      227             run write-log-and-file in p-log-handle (
      228                   input 1
      229                 , input log-file-name
      230                 , input 1
      231                 , input substitute("Подготовка данных")
      232                                                 ).
      233             DO kk = 1 TO num-entries( v-recid-list ) :
      234               FIND FIRST buf_fbr-gds-grp NO-LOCK WHERE
      235                    recid(buf_fbr-gds-grp) = integer(ENTRY(kk, v-recid-list)) NO-ERROR.
      236               IF AVAIL buf_fbr-gds-grp then do:
      237                 find first upper_fbr-gds-grp no-lock where
      238                           upper_fbr-gds-grp.obj-type = 'маг':U
      239                       AND upper_fbr-gds-grp.obj-code = i-obj-code
      240                       AND upper_fbr-gds-grp.node-code = buf_fbr-gds-grp.upper-code no-error .
      241                 if avail upper_fbr-gds-grp then do:
      242                   assign
      243                   v-upper-out-code = if upper_fbr-gds-grp.out-code = 0 then 1 else upper_fbr-gds-grp.out-code
      244                   .
      245                 end.
      246                 else do:
      247                   assign
      248                   v-upper-out-code = 1
      249                   .
      250                 end.
      251                 FIND FIRST cash-fgrp WHERE
      252                             cash-fgrp.node-code = buf_fbr-gds-grp.node-code NO-ERROR.
      253                 if not avail cash-fgrp then do:
      254                   create cash-fgrp.
      255                   assign
      256                   cash-fgrp.node-code  = buf_fbr-gds-grp.node-code
      257                   cash-fgrp.upper-code = buf_fbr-gds-grp.upper-code
      258                   cash-fgrp.out-code   = buf_fbr-gds-grp.out-code
      259                   cash-fgrp.node-name  = buf_fbr-gds-grp.node-name
      260                   cash-fgrp.upper-out-code  = v-upper-out-code
      261                   cash-fgrp.lvl-num    = buf_fbr-gds-grp.lvl-num
      262                   cash-fgrp.stts              = integer('0':U)
      263                   .
      264                   release cash-fgrp.
      265                 end.
      266               END.
      267             END.
      268           end.
      269           else  do:
      270             run write-log-and-file in p-log-handle (
      271                   input 1
      272                 , input log-file-name
      273                 , input 1
      274                 , input substitute("Не определен список групп блюд для пересылки")
      275                                                 ).
      276             return .
      277           end.
      278         end.
      279       end.
      280       when 1 then do:
      281         run write-log-and-file in p-log-handle (
      282               input 1
      283             , input log-file-name
      284             , input 1
      285             , input substitute("&1 магазина &2: пересылка всех имеющихся в БД групп блюд"
      286                               , (if mode = "U" then "Пересылка на кассы" else "Удаление с касс" )
      287                               , i-obj-code)
      288             ).
      289         run write-log-and-file in p-log-handle (
      290               input 1
      291             , input log-file-name
      292             , input 1
      293             , input substitute("Подготовка данных")
      294                                             ).
      295         FOR EACH buf_fbr-gds-grp no-lock where
      296                 buf_fbr-gds-grp.obj-type = 'маг':U
      297             AND buf_fbr-gds-grp.obj-code = i-obj-code:
      298           find first upper_fbr-gds-grp no-lock where
      299                     upper_fbr-gds-grp.obj-type = 'маг':U
      300                 AND upper_fbr-gds-grp.obj-code = i-obj-code
      301                 AND upper_fbr-gds-grp.node-code = buf_fbr-gds-grp.upper-code no-error .
      302           if avail upper_fbr-gds-grp then do:
      303             assign
      304             v-upper-out-code = if upper_fbr-gds-grp.out-code = 0 then 1 else upper_fbr-gds-grp.out-code
      305             .
      306           end.
      307           else do:
      308             assign
      309             v-upper-out-code = 1
      310             .
      311           end.
      312           FIND FIRST cash-fgrp WHERE
      313                       cash-fgrp.node-code = buf_fbr-gds-grp.node-code NO-ERROR.
      314           if not avail cash-fgrp then do:
      315             create cash-fgrp.
      316             assign
      317             cash-fgrp.node-code  = buf_fbr-gds-grp.node-code
      318             cash-fgrp.upper-code = buf_fbr-gds-grp.upper-code
      319             cash-fgrp.out-code   = buf_fbr-gds-grp.out-code
      320             cash-fgrp.upper-out-code  = v-upper-out-code
      321             cash-fgrp.node-name  = buf_fbr-gds-grp.node-name
      322             cash-fgrp.lvl-num    = buf_fbr-gds-grp.lvl-num
      323             cash-fgrp.stts              = integer('0':U)
      324             .
      325             release cash-fgrp.
      326           end.
      327         END.
      328       end.
      329     END CASE.
      330     if can-find(first cash-fgrp ) then do:
      331       run str/send-fgr.p (
      332                         input parparentproc
      333                         ,input p-parent-handle
      334                         ,input p-log-handle
      335                         ,input (string(i-obj-code) + chr(4) + mode + chr(4) + "no":U) ) no-error.
      336       if not error-status:error then do:
      337         run write-log-and-file in p-log-handle (
      338               input 1
      339             , input log-file-name
      340             , input 1
      341             , input substitute("&1 маг&2 &3"
      342                                 , (if mode = "U"
      343                                   then "Передача групп блюд на кассы"
      344                                   else "Удаление групп блюд с касс")
      345                                 , i-obj-code
      346                                 , (if mode = "U"
      347                                   then "проведена"
      348                                   else "проведено")
      349                                 )
      350                                             ).
      351       end.
      352       else do:
      353        assign
      354        v-view-log = yes
      355        .
      356       end.
      357     end.
      358     else do:
      359        run write-log-and-file in p-log-handle (
      360               input 1
      361             , input log-file-name
      362             , input 1
      363             , input substitute("Не найдено информации по группам блюд для передачи на кассы маг&1")
      364                                , i-obj-code
      365                                             ).
      366     end.
      367   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      368   if v-view-log
      369   and not g#news
      370   and not g#auto
      371   then do:
      372     message
      373     '!!!При отсылке информации на кассы произошли ошибки!!!'  skip
      374     "!!!Внимательно прочитайте Log-file!!"
      375     view-as alert-box error .
      376        define variable v-user-action6   as character no-undo .
      377     define variable v-printed6       as logical   no-undo .
      378     run gbl/prnfilen.w
      379       (input  ('!!!При отсылке информации на кассы произошли ошибки!!!')
      380       ,input  0
      381       ,input  (string("./":U) + 'send-cd.txt')
      382       ,input  7
      383       ,output v-user-action6
      384       ,output v-printed6
      385       ) .
      386   end.
      387   if v-view-log = true
      388   and (g#news
      389   or g#auto)
      390   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
      391   then do:
      392      run cb_set-view-log in p-parent-handle ( input yes).
      393   end.
      394   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
      395     OS-DELETE value(string("./":U) + 'send-cd.txt').
      396   end.
      397   end.
