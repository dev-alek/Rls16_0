        1   define input parameter parparentproc as widget-handle no-undo.
        2   define input parameter p-code like ub.chk-doc.doc-code no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Атрибуты чека".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   procedure proc-alt-shift-f2:
       64     if not ibs.th.gbl.gbl-var:rcode
       65   then
       66     run gbl\inidebug.p .
       67   end.
       68   procedure proc-alt-shift-f3:
       69     run gbl/prvssinf.p
       70       ( input this-procedure
       71       ) .
       72   end.
       73   define variable v-inform-launched as logical no-undo initial false .
       74   procedure proc-alt-shift-f4:
       75     define variable v-action as character no-undo .
       76     if v-inform-launched = false then do:
       77       assign
       78         v-inform-launched = true
       79       .
       80       run gbl/d-inform.w
       81         (  input self
       82         ,  input this-procedure
       83         , output v-action
       84         ) no-error .
       85       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       86       assign
       87         v-inform-launched = false
       88       .
       89     end.
       90   end.
       91   procedure proc-alt-f1:
       92     run gbl/corrhelp.p
       93       (input this-procedure
       94       ) .
       95   end .
       96   on alt-shift-f2 anywhere do:
       97     run proc-alt-shift-f2.
       98   end.
       99   on alt-shift-f3 anywhere do:
      100     run proc-alt-shift-f3 in this-procedure .
      101   end.
      102   on alt-shift-f4 anywhere do:
      103     run proc-alt-shift-f4 in this-procedure.
      104   end.
      105   on alt-f1 anywhere do:
      106     run proc-alt-f1 in this-procedure .
      107   end.
      108   define  temp-table tt-chk-attr no-undo
      109   field attr-type as char
      110   field attr-code as char
      111   field attr-value as char
      112   field attr-num as integer.
      113   DEFINE BUTTON b-quit AUTO-GO
      114        LABEL "Выход"
      115        SIZE 10 BY 1
      116        BGCOLOR 8 .
      117   DEFINE QUERY br-attr FOR
      118         tt-chk-attr SCROLLING.
      119   DEFINE BROWSE br-attr
      120       QUERY br-attr DISPLAY
      121       tt-chk-attr.attr-num COLUMN-LABEL "Номер" width 5 FORMAT "999":U
      122       tt-chk-attr.attr-code COLUMN-LABEL "Код" width 10 FORMAT "X(20)":U
      123       tt-chk-attr.attr-value COLUMN-LABEL "Значение атрибута" WIDTH 70 FORMAT "X(220)":U
      124       tt-chk-attr.attr-type COLUMN-LABEL "Тип" FORMAT "X(20)":U
      125       WITH SEPARATORS SIZE 102.5 BY 15.5 FIT-LAST-COLUMN.
      126   DEFINE FRAME Dialog-Frame
      127        b-quit AT ROW 1 COL 1
      128        br-attr AT ROW 2.75 COL 1 WIDGET-ID 200
      129        SPACE(0.74) SKIP(0.20)
      130       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      131            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      132            TITLE "Атрибуты чека"
      133            DEFAULT-BUTTON b-quit WIDGET-ID 100.
      134   ASSIGN
      135          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      136          FRAME Dialog-Frame:HIDDEN           = TRUE.
      137   ASSIGN
      138          br-attr:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
      139   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      140   DO:
      141     APPLY "END-ERROR":U TO SELF.
      142   END.
      143   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      144   DO:
      145     apply "go".
      146   END.
      147   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      148   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      149   MAIN-BLOCK:
      150   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      151      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      152     for each chk-gds-attr
      153           where chk-gds-attr.doc-code = p-code no-lock:
      154           create tt-chk-attr.
      155          assign
      156           tt-chk-attr.attr-value = chk-gds-attr.attr-value
      157           tt-chk-attr.attr-code = chk-gds-attr.attr-code
      158           tt-chk-attr.attr-num = chk-gds-attr.line-num
      159           tt-chk-attr.attr-type = "Товар".
      160      end.
      161               for each chk-pay-attr
      162                   where chk-pay-attr.doc-code = p-code no-lock:
      163                   create tt-chk-attr.
      164                   assign
      165                   tt-chk-attr.attr-value = chk-pay-attr.attr-value
      166                   tt-chk-attr.attr-code = chk-pay-attr.attr-code
      167                   tt-chk-attr.attr-num = chk-pay-attr.line-num
      168                   tt-chk-attr.attr-type = "Оплата".
      169               end.
      170           for each chk-doc-attr
      171                   where chk-doc-attr.doc-code = p-code no-lock:
      172           if chk-doc-attr.attr-code begins "corr-" then next.
      173                   create tt-chk-attr.
      174                   assign
      175                   tt-chk-attr.attr-value = chk-doc-attr.attr-value
      176                   tt-chk-attr.attr-code = chk-doc-attr.attr-code
      177                   tt-chk-attr.attr-type = "Чек".
      178           end.
      179       for each chk-discnt-attr where chk-discnt-attr.doc-code = p-code no-lock:
      180       if chk-discnt-attr.attr-code = "promo-id" and chk-discnt-attr.line-num = 0 then next .
      181                   create tt-chk-attr.
      182                   assign
      183                   tt-chk-attr.attr-value = chk-discnt-attr.attr-value
      184                   tt-chk-attr.attr-code = chk-discnt-attr.attr-code
      185                   tt-chk-attr.attr-num = chk-discnt-attr.line-num
      186                   tt-chk-attr.attr-type = "Скидка".
      187         end.
      188     RUN enable_UI.
      189     WAIT-FOR GO OF FRAME Dialog-Frame.
      190   END.
      191   RUN disable_UI.
      192   PROCEDURE cd-attr :
      193   END PROCEDURE.
      194   PROCEDURE disable_UI :
      195     HIDE FRAME Dialog-Frame.
      196   END PROCEDURE.
      197   PROCEDURE enable_UI :
      198     ENABLE b-quit br-attr
      199         WITH FRAME Dialog-Frame.
      200     VIEW FRAME Dialog-Frame.
      201     OPEN QUERY br-attr FOR EACH tt-chk-attr .
      202   END PROCEDURE.
