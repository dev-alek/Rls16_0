        1   block-level on error undo, throw.
        2   define input parameter p-doc-code       as character        no-undo.
        3   define input parameter p-attr-code      as character        no-undo.
        4   define output parameter p-attr-value    as character        no-undo.
        5   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo initial "$Workfile: fbrattrv.p $":U .
        9   define variable vss-archive     as character no-undo initial "$Archive: str/fbrattrv.p $":U .
       10   define variable vss-description as character no-undo initial "Чтение атрибута документа производства":U .
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   define new global shared variable g#trdcalib as handle no-undo.
       73   define variable vss-include-info1 as character format "X(65)" no-undo
       74   initial "@(#)$Workfile$ $Revision$".
       75   procedure fbrattr-write :
       76     define input parameter p-doc-type       as character        no-undo.
       77     define input parameter p-doc-code       as character        no-undo.
       78     define input parameter p-attr-code      as character        no-undo.
       79     define input parameter p-attr-value     as character        no-undo.
       80     do
       81     on error undo, return error
       82     :
       83   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input substitute('&1-&2',p-doc-type,p-doc-code) ,
       84                          input p-attr-code ,
       85                          input p-attr-value )  .
       86     end.
       87   end procedure.
       88   procedure fbrattr-value :
       89     define  input parameter p-doc-type      as character        no-undo.
       90     define  input parameter p-doc-code      as character        no-undo.
       91     define  input parameter p-attr-code     as character        no-undo.
       92     define output parameter p-attr-value    as character        no-undo.
       93     define variable v-par-value     as character    no-undo.
       94     define variable v-par-type      as character    no-undo.
       95     define buffer buf_clients       for ub.clients.
       96     do
       97     for buf_clients
       98     on error undo, return error
       99     :
      100   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input substitute('&1-&2',p-doc-type,p-doc-code) ,
      101                           input p-attr-code ,
      102                          output p-attr-value ,
      103                          output v-par-type )  .
      104     end.
      105   end procedure.
      106       define variable v-attr-type    as character    no-undo.
      107   do
      108   on error undo, return error
      109   :
      110       run fbrattr-value in this-procedure (
      111             input 'fbr-doc':U
      112           , input p-doc-code
      113           , input p-attr-code
      114           , output p-attr-value
      115       ) no-error.
      116       if error-status :error
      117       then do:
      118           message
      119               vss-workfile vss-revision vss-description
      120               skip(1)
      121               skip "Ошибка вычисления атрибута документа производства."
      122               skip(1)
      123               skip "Номер документа:" p-doc-code
      124               skip "Код атрибута:" p-attr-code
      125               skip(1)
      126               skip return-value
      127               skip trim( error-status :get-message( 1 ) )
      128                       trim( error-status :get-message( 2 ) )
      129                       trim( error-status :get-message( 3 ) )
      130           view-as alert-box error.
      131           undo, return error.
      132       end.
      133   end.
