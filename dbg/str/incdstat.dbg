      116   define new global shared variable g#libbcrcn as handle no-undo .
      117   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118   procedure cur-time :
      119      define output parameter p-today as date      no-undo .
      120      define output parameter p-time  as integer   no-undo .
      121     do
      122     on error undo, return error
      123     :
      124       define variable v-date1 as date      no-undo .
      125       define variable v-date2 as date      no-undo .
      126       define variable v-time  as integer   no-undo .
      127       assign
      128         v-date1 = today
      129         v-time  = time
      130         v-date2 = today
      131       .
      132       if v-date1 <> v-date2
      133       then do:
      134         assign
      135           v-date1 = today
      136           v-time  = v-time
      137         .
      138       end.
      139       assign
      140         p-today = v-date1
      141         p-time  = v-time
      142       .
      143     end.
      144   end.
      145   function cur-time-date returns character
      146   :
      147     return string(today, '99/99/9999':U) .
      148   end.
      149   function cur-time-mjd returns decimal
      150   :
      151     define variable v-date as date      no-undo .
      152     define variable v-time as integer   no-undo .
      153     run cur-time in this-procedure
      154       (output v-date
      155       ,output v-time
      156       ) .
      157     return integer(v-date) - 2400002 + (v-time / 86400) .
      158   end.
      159   function cur-time-get-ending-index returns integer
      160   (input p-number as integer
      161   )
      162   :
      163     if p-number < 0
      164     or p-number = ?
      165     then do:
      166       return 1 .
      167     end.
      168     define variable v-rest as integer   no-undo .
      169     assign
      170       p-number = p-number modulo 100
      171     .
      172     if p-number < 20
      173     then do:
      174       assign
      175         v-rest = p-number
      176       .
      177     end.
      178     else do:
      179       assign
      180         v-rest = p-number modulo 10
      181       .
      182     end.
      183     case v-rest :
      184       when 1
      185       then do:
      186         return 2 .
      187       end.
      188       when 2 or
      189       when 3 or
      190       when 4
      191       then do:
      192         return 3 .
      193       end.
      194       otherwise do:
      195         return 1 .
      196       end.
      197     end case .
      198   end.
      199   procedure cur-time-mjd-to-date :
      200      define input  parameter i-mjd-diff as decimal no-undo.
      201      define output parameter o-Date     as date    no-undo.
      202      define output parameter o-Time     as integer no-undo.
      203      define variable v-day-number as integer   no-undo .
      204      if    i-mjd-diff < 0
      205         or i-mjd-diff = ?
      206      then do:
      207         return "?" .
      208      end.
      209      assign
      210         v-day-number = truncate(i-mjd-diff,0).
      211         o-Date = date(v-day-number + 2400002).
      212         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      213     .
      214   end.
      215   function cur-time-mjd-to-string returns character
      216   (input p-mjd-diff as decimal
      217   )
      218   :
      219     define variable v-day-number as integer   no-undo .
      220     define variable v-seconds    as integer   no-undo .
      221     define variable v-hour       as integer   no-undo .
      222     define variable v-min        as integer   no-undo .
      223     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      224     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      225     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      226     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      227     if p-mjd-diff < 0
      228     or p-mjd-diff = ?
      229     then do:
      230       return "?" .
      231     end.
      232     assign
      233       v-day-number = integer(truncate(p-mjd-diff,0))
      234       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      235     .
      236     if v-seconds > 86400
      237     then do:
      238       assign
      239         v-seconds = 86400 - 1
      240       .
      241     end.
      242     if v-seconds < 0
      243     then do:
      244       assign
      245         v-seconds = 0
      246       .
      247     end.
      248     assign
      249       v-hour = truncate(v-seconds / 3600, 0)
      250     .
      251     assign
      252       v-seconds = v-seconds modulo 3600
      253     .
      254     assign
      255       v-min = truncate(v-seconds / 60, 0)
      256     .
      257     assign
      258       v-seconds = v-seconds modulo 60
      259     .
      260     return
      261         (if v-day-number <> 0
      262           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      263           else ""
      264         )
      265       + (if v-day-number <> 0 or v-hour <> 0
      266           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      267           else ""
      268         )
      269       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      270           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      271           else ""
      272         )
      273       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      274       .
      275   end.
      276   function cur-time-string returns character
      277   :
      278     define variable v-date as date      no-undo .
      279     define variable v-time as integer   no-undo .
      280     run cur-time in this-procedure
      281       (output v-date
      282       ,output v-time
      283       ) .
      284     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      285   end.
      286   function cur-time-string-sec returns character
      287   :
      288     define variable v-date as date      no-undo .
      289     define variable v-time as integer   no-undo .
      290     run cur-time in this-procedure
      291       (output v-date
      292       ,output v-time
      293       ) .
      294     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      295   end.
      296   function cur-time-custom  returns character
      297   (input p-prefix as character
      298   ,input p-date-format as character
      299   ,input p-delimiter as character
      300   ,input p-time-format as character
      301   ,input p-suffix as character
      302   )
      303   :
      304     define variable v-date as date      no-undo .
      305     define variable v-time as integer   no-undo .
      306     run cur-time in this-procedure
      307       (output v-date
      308       ,output v-time
      309       ) .
      310     return
      311       p-prefix
      312       + string(v-date, p-date-format)
      313       + p-delimiter
      314       + string(v-time, p-time-format)
      315       + p-suffix
      316       .
      317   end.
      318   function cur-time-print  returns character
      319   :
      320     define variable v-date as date      no-undo .
      321     define variable v-time as integer   no-undo .
      322     run cur-time in this-procedure
      323       (output v-date
      324       ,output v-time
      325       ) .
      326     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      327   end.
      328   function cur-time-datetime returns datetime
      329   :
      330     define variable v-char as character no-undo .
      331     define variable v-datetime as datetime no-undo .
      332     v-char = cur-time-string().
      333     v-datetime = datetime(v-char).
      334     return  v-datetime.
      335   end.
      336   function cur-time-string-msec returns character
      337   :
      338     define variable v-date as datetime  no-undo .
      339     v-date = now.
      340     return string(v-date) .
      341   end.
      342   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      343   define variable v-waitfram-action01         as character   no-undo .
      344   define variable v-waitfram-action02         as character   no-undo .
      345   define variable v-waitfram-action03         as character   no-undo .
      346   define variable mWaitFramTextBeg            as character   no-undo.
      347   define variable mWaitFramTextEnd            as character   no-undo.
      348   define variable mWaitFramView               as logical     no-undo.
      349   define variable mWaitProcEvent              as logical     no-undo init yes.
      350   define variable mWaitFramInterval           as integer     no-undo init 1 .
      351   define variable mWaitFramStop               as logical     no-undo.
      352   define variable mWaitFramStopUser           as logical     no-undo.
      353   define variable mWaitFramStopTimeOut        as logical     no-undo.
      354   define variable mWaitFramStartProc          as datetime-tz no-undo.
      355   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      356   define button B-WaitFramStop auto-end-key
      357        label "Стоп"
      358        size 10 by 1 tooltip "Остоновить процесс".
      359   define button B-viewProcInfo
      360        label "Информация"
      361        size 15 by 1 tooltip "Информация о процесс".
      362   define frame waitfram
      363     v-waitfram-action01 format "x(72)" no-label skip
      364     v-waitfram-action02 format "x(72)" no-label skip
      365     v-waitfram-action03 format "x(72)" no-label skip
      366     B-viewProcInfo
      367     B-WaitFramStop at row 4 col 30
      368     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      369     .
      370   define new global shared variable mBatchMode as logical no-undo init ?.
      371   define variable mFramBachModHandle as handle no-undo.
      372   mFramBachModHandle = frame waitfram:handle.
      373   define variable mFameOldVis as logical no-undo.
      374   define variable mVisCUrentVin as logical no-undo.
      375   if session:batch-mode
      376   then
      377      mBatchMode = yes.
      378   if mBatchMode = ? then do:
      379     mVisCUrentVin = current-window:visible.
      380     mFameOldVis = mFramBachModHandle:visible.
      381     mFramBachModHandle:visible  = yes.
      382     mBatchMode = mFramBachModHandle:visible ne yes.
      383     mFramBachModHandle:visible = mFameOldVis.
      384     current-window:visible = mVisCUrentVin.
      385   end.
      386    if  log-manager:logfile-name ne ?
      387     then DO:
      388         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      389         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      390         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      391     end.
      392   on choose of B-WaitFramStop in frame waitfram
      393   do:
      394     mWaitFramStop = yes.
      395     mWaitFramStopUser = yes.
      396   end.
      397   function waitfram-check-timeout returns logical():
      398      define variable vtime as int64 no-undo.
      399      if mWaitFramStopTimeOut
      400      then
      401         return yes.
      402      vtime = ( now - mWaitFramStartProc ) / 1000 .
      403      if     mWaitFramTimeOut ne ?
      404         and mWaitFramTimeOut ne 0
      405         and mWaitFramTimeOut lt vtime
      406      then do:
      407         mWaitFramStopTimeOut = yes.
      408      end.
      409      return mWaitFramStopTimeOut.
      410   end.
      411   procedure waitfram-hide :
      412     if not session:batch-mode
      413     then do
      414     on error undo, return error return-value
      415     :
      416       pause 0 before-hide .
      417       if not mBatchMode then
      418         hide frame waitfram .
      419     if     not mWaitFramView
      420        and mWaitProcEvent
      421     then
      422       process events .
      423     end.
      424   end procedure.
      425   procedure waitfram-show :
      426     define input  parameter p-message as character no-undo .
      427     define variable v-left-margin as integer   no-undo .
      428     if not session:batch-mode
      429     then do
      430     on error undo, return error return-value
      431     :
      432       if length(p-message) <= 70 then do:
      433         assign
      434           v-left-margin = integer((70 - length(p-message)) / 2)
      435         .
      436         assign
      437           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      438         .
      439         assign
      440           v-waitfram-action01 = " "
      441           v-waitfram-action02 = " "
      442                                    + fill(" ", v-left-margin)
      443                                    + p-message
      444           v-waitfram-action03 = " "
      445         .
      446       end.
      447       else do:
      448         define variable vRindex1 as integer no-undo.
      449         define variable vRindex2 as integer no-undo.
      450         vRindex1 = r-index(p-message," ",70).
      451         if vRindex1 = 0
      452         then
      453            vRindex1 = 70.
      454         if length(p-message)  <= vRindex1 + 70 then do:
      455           assign
      456             v-waitfram-action01 = " "
      457             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      458             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      459           .
      460         end.
      461         else do:
      462           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      463           if vRindex2 <= vRindex1
      464           then
      465              vRindex2 = vRindex1 + 70.
      466           assign
      467             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      468             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      469             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      470           .
      471         end.
      472       end.
      473       B-viewProcInfo:visible   in frame waitfram = no.
      474       B-viewProcInfo:sensitive in frame waitfram = no.
      475       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      476       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      477       if  (   mWaitFramView
      478          or  mWaitProcEvent)
      479          and not mBatchMode
      480       then
      481          display
      482             v-waitfram-action01 skip
      483             v-waitfram-action02 skip
      484             v-waitfram-action03 skip
      485          with frame waitfram .
      486       if     mWaitFramView
      487          then do:
      488             if     mWaitFramInterval ne ?
      489                and not mBatchMode
      490             then
      491                wait-for go of frame waitfram pause mWaitFramInterval.
      492          end.
      493          else
      494             if     mWaitProcEvent
      495                and not mBatchMode
      496             then
      497                process events .
      498     end.
      499   end procedure.
      500      procedure waitfram-show-this:
      501         define input  parameter iInterval as int64 no-undo.
      502         define variable vtime as int64 no-undo.
      503         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      504         mWaitFramInterval = iInterval.
      505         run waitfram-show (substitute("&1&2 &3&4" ,
      506                                       mWaitFramTextBeg ,
      507                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      508                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      509                                       mWaitFramTextEnd
      510                                      )
      511                           ).
      512      end.
      513      procedure WaitFramRunPause:
      514         define input  parameter iInterval as dec no-undo.
      515         define variable vStart  as datetime-tz no-undo.
      516         define variable vend    as datetime-tz no-undo.
      517         define variable vint as int64 no-undo.
      518         define variable vOk as logical no-undo.
      519         vStart = now.
      520         vend   = vStart.
      521         publish "WaitFramPause" (iInterval,output vOk).
      522         vend   =  now.
      523         vint = vend - vStart.
      524         vint = iInterval - vint / 1000.
      525         if     not mWaitFramStop
      526            and (   vint > 0
      527                 or (    not vOk
      528                     and iInterval eq ?
      529                     )
      530                 )
      531         then
      532            run waitfram-show-this (iInterval).
      533         vend   =  now.
      534         vint = vend - vStart.
      535         vint = iInterval - vint / 1000.
      536         if     not mWaitFramStop
      537            and vint > 0
      538         then do:
      539            run gbl/pause.p (vint * 1000).
      540         end.
      541         if iInterval ne ?
      542         then
      543            publish "WaitFramStop".
      544         waitfram-check-timeout().
      545      end.
      546      procedure WaitFramWaitFor:
      547         define input  parameter iInterval as dec no-undo.
      548         assign
      549            mWaitFramStartProc   = now
      550            mWaitFramStopUser    = no
      551            mWaitFramStopTimeOut = no
      552         .
      553         block-wait:
      554         do while not mWaitFramStop:
      555            run WaitFramRunPause (iInterval).
      556            if  waitfram-check-timeout()
      557            then do:
      558               leave block-wait.
      559            end.
      560         end.
      561         run waitfram-hide.
      562      end.
      563   procedure waitfram-join :
      564     define input  parameter p-line-1  as character no-undo .
      565     define input  parameter p-line-2  as character no-undo .
      566     define input  parameter p-line-3  as character no-undo .
      567     define output parameter p-message as character no-undo .
      568     do
      569     on error undo, return error return-value
      570     :
      571       assign
      572         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      573                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      574                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      575       .
      576     end.
      577   end procedure.
      578   function waitfram-join-function returns character
      579     (input p-line-1 as character
      580     ,input p-line-2 as character
      581     ,input p-line-3 as character
      582     ).
      583     define variable v-message as character no-undo .
      584     run waitfram-join in this-procedure
      585       (input  p-line-1
      586       ,input  p-line-2
      587       ,input  p-line-3
      588       ,output v-message
      589       ) .
      590     return v-message .
      591   end function .
      592   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      593     define variable v-cntxt-db-num        as integer   no-undo .
      594     define variable v-cntxt-userid        as character no-undo .
      595     define variable v-cntxt-level         as character no-undo .
      596     define variable v-cntxt-host-code-obj as integer   no-undo .
      597     define variable v-cntxt-obj-type      as character no-undo .
      598     define variable v-cntxt-obj-code      as integer   no-undo .
      599     define variable v-cntxt-db-num-obj    as integer   no-undo .
      600     define variable v-cntxt-is-admin      as logical   no-undo .
      601   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      602   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      603   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      604   define variable par-type          as character no-undo.
      605   define variable v-value-character as character no-undo .
      606   define variable v-value-date      as date      no-undo .
      607   define variable v-value-decimal   as decimal   no-undo .
      608   define variable v-value-integer   as integer   no-undo .
      609   define variable v-value-logical   as logical   no-undo .
      610   define variable line-mode as character no-undo init ? .
      611   define variable i            as integer   no-undo.
      612   define variable j            as integer   no-undo.
      613   define variable b-c           as integer   no-undo.
      614   define variable scan-txt      as character no-undo.
      615   define variable is-all        as logical   no-undo.
      616   define variable rate          as decimal   no-undo.
      617   define variable g-type        as character no-undo init ?.
      618   define variable qnty-str      as character no-undo.
      619   define variable bar-str       as character no-undo.
      620   define variable part-list     as character no-undo initial "".
      621   define variable varscales-pref      as character no-undo.
      622   define variable varpgscales-pref      as character no-undo.
      623   define variable varscales-pref-type as character no-undo.
      624   def stream ggg.
      625   define stream cur.
      626   define stream log.
      627   define stream ler.
      628   define stream err.
      629   define frame a
      630       i format ">>>>9" label "Просмотрено" space (20) skip
      631       j format ">>>>9" label "Обработано"
      632       with view-as dialog-box side-labels three-d title "".
      633   def var mess as char no-undo.
      634   procedure check-code:
      635   define input parameter parbar-str AS char no-undo.
      636   define input parameter parprice   like ub.gds-dtl.price-base no-undo.
      637   define input parameter parqnty    as dec no-undo.
      638   define input  parameter parg#doc-prt as logical no-undo.
      639   define input  parameter parscales-pref as character no-undo.
      640   define input  parameter parpgscales-pref as character no-undo.
      641   define output parameter parplace   as log initial no no-undo.
      642   define output parameter parb-c     as int no-undo.
      643   define output parameter parrate    as dec no-undo.
      644   define variable varresult   as character       no-undo.
      645   define variable vartype-bc  as character       no-undo.
      646   define variable varweight   as decimal         no-undo.
      647   def buffer b-bar-code for ub.bar-code.
      648   ASSIGN mess = " Код: " + parbar-str + " количество: " + string (parqnty) + " ".
      649   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
      650   (
      651    input  parparentproc
      652   ,input  parbar-str
      653   ,input  parprice
      654   ,input  v-cntxt-obj-type
      655   ,input  v-cntxt-obj-code
      656   ,input  yes
      657   ,input  no
      658   ,input  parscales-pref
      659   ,input  parpgscales-pref
      660   ,output varresult
      661   ,output vartype-bc
      662   ,output varweight
      663   ,buffer ub.bar-code
      664   ,buffer ub.prod-bc
      665   ,buffer ub.place
      666   ) no-error.
      667   if error-status:error then do:
      668     return error "Ошибка при разборе бар-кода: " + parbar-str.
      669   end.
      670   if not available bar-code THEN DO:
      671      if add-sens = ? and available place
      672      then DO: parPlace = YES. RETURN. END.
      673      ELSE RETURN ERROR "Товар отсутствует в базе данных.".
      674   END.
      675   else do:
      676       assign  parb-c  = bar-code.b-code
      677               parrate = bar-code.cli-base-rate.
      678       find ub.goods where ub.goods.gds-code  = ub.bar-code.gds-code no-lock.
      679       find ub.gds-prt where ub.gds-prt.upper-code = ub.goods.prt-root no-lock.
      680       ASSIGN mess = mess + "Артикул: " + ub.goods.artic + " производитель: " + ub.goods.prod-type + " " + string (ub.goods.prod-code) + " " + ub.goods.gds-name + chr(10) .
      681       if parg#doc-prt and gds-prt.node-name <> '_Пустая шкала':U and
      682          can-find (first gds-prt where gds-prt.upper-code = bar-code.node-code) then
      683          RETURN ERROR "Ссылка не на подробный признак.".
      684       if not parg#doc-prt and gds-prt.node-name <> '_Пустая шкала':U and
      685            bar-code.node-code <> gds-prt.node-code then do:
      686         find b-bar-code where recid (b-bar-code) = recid (bar-code) no-lock.
      687         find bar-code where bar-code.gds-code  = b-bar-code.gds-code
      688                         and bar-code.node-code = gds-prt.node-code
      689                         and bar-code.in-code   = b-bar-code.in-code
      690                         and bar-code.part-code = b-bar-code.part-code
      691                         and bar-code.unit-cli  = ub.goods.unit-base
      692                           no-lock.
      693         parb-c = bar-code.b-code.
      694         RETURN "Ссылка на подробный или узловой признак. Заменяем на код: " + STRING(bar-code.b-code).
      695       end.
      696   end.
      697   RETURN.
      698   END PROCEDURE.
      699   procedure proc-code.
      700   define input parameter pl-str as char no-undo.
      701   DEFine INPUT PARAMeter mode-proc as CHAR NO-UNDO.
      702   define input parameter parscales-pref as character no-undo.
      703   define input parameter parpgscales-pref as character no-undo.
      704   define buffer b-bar-code for ub.bar-code.
      705   DEFINE VARIABLE mode-create      as LOGICAL NO-UNDO.
      706   DEFINE VARIABLE rec-old          as RECID NO-UNDO.
      707   define variable varres        as logical         no-undo.
      708   define variable var-code-temp like ub.place.pl-code no-undo.
      709   define buffer pc-goods for ub.goods.
      710   define variable g-log-char as character no-undo.
      711   define variable varprice-cli-old        like ub.doc-line.price-cli no-undo.
      712   define variable varprice-rubl-old       like ub.doc-line.price-cli no-undo.
      713   define variable varprice-base-old       like ub.doc-line.price-cli no-undo.
      714   define variable varcli-qnty-old         like ub.doc-line.cli-qnty  no-undo.
      715   define variable varcli-base-rate-old    like ub.doc-line.cli-qnty  no-undo.
      716   define variable varfact-qnty-old        like ub.doc-line.cli-qnty  no-undo.
      717   define variable vardoc-qnty-old         like ub.doc-line.cli-qnty  no-undo.
      718   define variable varvat-pc-old           like ub.doc-line.vat-pc    no-undo.
      719   define variable varslt-pc-old           like ub.doc-line.vat-pc    no-undo.
      720   define variable varroad-tax-old         like ub.doc-line.price-cli no-undo.
      721   define variable varexcise-old           like ub.doc-line.price-cli no-undo.
      722   define variable vartransport-rubl-old   like ub.doc-line.price-cli no-undo.
      723   define variable varother-rubl-old       like ub.doc-line.price-cli no-undo.
      724   define variable lns-cnt                 as   integer               no-undo.
      725   IF mode-proc = "PLACE" THEN DO:
      726       do lns-cnt = 1 to num-entries (part-list):
      727         find ub.bar-code where ub.bar-code.b-code  = integer (entry (lns-cnt, part-list)) no-lock.
      728         find first pc-goods where pc-goods.gds-code  = ub.bar-code.gds-code no-lock.
      729         RUN plgdsfnd (input  no,
      730                       input  v-cntxt-obj-type,
      731                       input  v-cntxt-obj-code,
      732                       input  pc-goods.gds-code,
      733                       output varres,
      734                       output var-code-temp) no-error.
      735        if varres = yes or error-status:error then do:
      736             put stream log unformatted "***" mess "Нельзя перемещать партии товара по складским местам "
      737             pc-goods.artic " " pc-goods.prod-type " " pc-goods.prod-code
      738             " по объкту " v-cntxt-obj-type " " v-cntxt-obj-code " "  skip.
      739             put stream ler unformatted "***" mess "Нельзя перемещать партии товара по складским местам "
      740             pc-goods.artic " " pc-goods.prod-type " " pc-goods.prod-code
      741             " по объкту " v-cntxt-obj-type " " v-cntxt-obj-code " "  skip.
      742             put stream err unformatted bar-str "," qnty-str "," pl-str skip.
      743         end.
      744         else
      745         for each ub.parts where ub.parts.obj-type  = v-cntxt-obj-type
      746                          and ub.parts.obj-code  = v-cntxt-obj-code
      747                          and ub.parts.artic     = pc-goods.artic
      748                          and ub.parts.prod-type = pc-goods.prod-type
      749                          and ub.parts.prod-code = pc-goods.prod-code
      750                          and ub.parts.in-code   = ub.bar-code.in-code
      751                          and ub.parts.part-code = ub.bar-code.part-code
      752                          and ub.parts.rsrv-free = yes:
      753           ub.parts.pl-code = ub.place.pl-code.
      754           put stream log unformatted mess "Партия: код: " bar-code.b-code " артикул: " ub.parts.artic " номер: " ub.parts.part-code " Место: " ub.parts.pl-code " - успешно" skip.
      755           j = j + 1.
      756           disp j with frame a.
      757         end.
      758       end.
      759       part-list = "".
      760   END.
      761   ELSE DO:
      762     if add-sens = ? then part-list = if part-list = "" then string (b-c) else part-list + "," + string (b-c).
      763     else do:
      764       if ub.goods.gds-type <> 'т':U and (t-doc.doc-type <> 'рас':U or t-doc.internal) then do:
      765         put stream log unformatted "***" mess "Услуга не соответствует типу данной накладной" skip.
      766         put stream ler unformatted "***" mess "Услуга не соответствует типу данной накладной" skip.
      767         put stream err unformatted bar-str "," qnty-str skip.
      768         return error.
      769       end.
      770       if g-type = ? then g-type = ub.goods.gds-type.
      771       if g-type <> ub.goods.gds-type then do:
      772         put stream log unformatted "***" mess "Тип товара не соответствует типу данной накладной" skip.
      773         put stream ler unformatted "***" mess "Тип товара не соответствует типу данной накладной" skip.
      774         put stream err unformatted bar-str ","  qnty-str skip.
      775         return error.
      776       end.
      777       assign g-log-char = "yes".
      778       do transaction on error undo , leave:
      779          define variable tempmess as character no-undo.
      780          define buffer bf_doc-line for ub.doc-line.
      781          find first ub.doc-line where ub.doc-line.doc-code  = t-doc.doc-code  and
      782                                    ub.doc-line.artic     = ub.goods.artic     and
      783                                    ub.doc-line.prod-type = ub.goods.prod-type and
      784                                    ub.doc-line.prod-code = ub.goods.prod-code no-error.
      785          if available ub.doc-line then do:
      786             assign
      787             mode-create = no
      788             varprice-cli-old       = ub.doc-line.price-cli
      789             varprice-rubl-old      = ub.doc-line.price-rubl
      790             varprice-base-old      = ub.doc-line.price-base
      791             varcli-qnty-old        = ub.doc-line.cli-qnty
      792             varcli-base-rate-old   = ub.doc-line.cli-base-rate
      793             varfact-qnty-old       = ub.doc-line.fact-qnty
      794             vardoc-qnty-old        = ub.doc-line.doc-qnty
      795             varvat-pc-old          = ub.doc-line.vat-pc
      796             varslt-pc-old          = ub.doc-line.slt-pc
      797             varroad-tax-old        = ub.doc-line.road-tax
      798             varexcise-old          = ub.doc-line.excise
      799             vartransport-rubl-old  = ub.doc-line.transport-rubl
      800             varother-rubl-old      = ub.doc-line.other-rubl.
      801          end.
      802          else mode-create = yes.
      803   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_copy-scn in g#lib-trn
      804     ( input  parparentproc
      805      ,input  recid(t-doc)
      806      ,input  bar-code.b-code
      807      ,input  decimal(qnty-str) * rate
      808      ,input  is-all
      809      ,input  add-sens
      810      ,input  line-mode
      811      ,output tempmess
      812      ,output g-log-char
      813     ) no-error .
      814          assign
      815          mess = mess + tempmess.
      816          if error-status:error then do:
      817            assign
      818            mess = mess + return-value.
      819            put stream err unformatted bar-str "," qnty-str skip.
      820            put stream log unformatted "***" mess " - ошибка" skip.
      821            put stream ler unformatted "***" mess " - ошибка" skip.
      822            return error.
      823          end.
      824          else do:
      825            put stream log unformatted mess " - успешно" skip.
      826            if pl-str <> "" then run store-place in this-procedure ( input pl-str
      827                                                                    ,input parscales-pref
      828                                                                    ,input parpgscales-pref
      829                                                                    ).
      830            j = j + 1.
      831            disp j with frame a.
      832          end.
      833          find first ub.doc-line where ub.doc-line.doc-code  = t-doc.doc-code  and
      834                                    ub.doc-line.artic     = ub.goods.artic     and
      835                                    ub.doc-line.prod-type = ub.goods.prod-type and
      836                                    ub.doc-line.prod-code = ub.goods.prod-code no-error.
      837          if t-doc.doc-type = 'при':U then do:
      838            if mode-create then do:
      839   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_clcintrn in g#lib-trn
      840     (
      841      input parparentproc
      842     ,input recid(doc-line)
      843     ,input t-doc.doc-code
      844     ,input ub.doc-line.artic
      845     ,input ub.doc-line.prod-type
      846     ,input ub.doc-line.prod-code
      847     ,input 0
      848     ,input 0
      849     ,input 0
      850     ,input 0
      851     ,input 0
      852     ,input 0
      853     ,input 0
      854     ,input 0
      855     ,input 0
      856     ,input 0
      857     ,input 0
      858     ,input 0
      859     ,input 0
      860     ,input 'create'
      861     ,input ''
      862     ) no-error.
      863               if error-status:error then return error return-value.
      864            end.
      865            else do:
      866   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_clcintrn in g#lib-trn
      867     (
      868      input parparentproc
      869     ,input recid(doc-line)
      870     ,input ub.doc-line.doc-code
      871     ,input ub.doc-line.artic
      872     ,input ub.doc-line.prod-type
      873     ,input ub.doc-line.prod-code
      874     ,input varprice-cli-old
      875     ,input varprice-rubl-old
      876     ,input varprice-base-old
      877     ,input varcli-qnty-old
      878     ,input varcli-base-rate-old
      879     ,input varfact-qnty-old
      880     ,input vardoc-qnty-old
      881     ,input varvat-pc-old
      882     ,input varslt-pc-old
      883     ,input varroad-tax-old
      884     ,input varexcise-old
      885     ,input vartransport-rubl-old
      886     ,input varother-rubl-old
      887     ,input 'update'
      888     ,input ''
      889     ) no-error.
      890               if error-status:error then return error return-value.
      891            end.
      892          end.
      893       end.
      894       if substring(g-log-char, 1, 4) = "qnty" then do:
      895             put stream err unformatted bar-str "," ENTRY(2, g-log-char, "=") skip.
      896             put stream log unformatted "***" mess " - не все количество зарезервировано" skip.
      897             put stream ler unformatted "***" mess " - не все количество зарезервировано" skip.
      898       end.
      899     end.
      900   end.
      901   os-delete value (scan-txt).
      902   end procedure.
      903   procedure store-place:
      904   DEFine INPUT PARAMETER pl-str as CHAR NO-UNDO.
      905   define input parameter parscales-pref as character no-undo.
      906   define input parameter parpgscales-pref as character no-undo.
      907   define variable pl-c as int no-undo.
      908   define variable varres        as logical         no-undo.
      909   define variable var-code-temp like ub.place.pl-code no-undo.
      910   define variable varresult   as character       no-undo.
      911   define variable vartype-bc  as character       no-undo.
      912   define variable varweight   as decimal         no-undo.
      913   define buffer pc-goods for ub.goods.
      914   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
      915   (
      916    input  parparentproc
      917   ,input  pl-str
      918   ,input  ?
      919   ,input  v-cntxt-obj-type
      920   ,input  v-cntxt-obj-code
      921   ,input  yes
      922   ,input  no
      923   ,input  parscales-pref
      924   ,input  parpgscales-pref
      925   ,output varresult
      926   ,output vartype-bc
      927   ,output varweight
      928   ,buffer ub.bar-code
      929   ,buffer ub.prod-bc
      930   ,buffer ub.place
      931   ) no-error.
      932   if error-status:error then do:
      933     return error "Ошибка при разборе бар-кода: " + pl-str.
      934   end.
      935   if available place then do:
      936     find ub.bar-code where ub.bar-code.b-code  = b-c no-lock.
      937     find first pc-goods where pc-goods.gds-code  = ub.bar-code.gds-code no-lock.
      938     RUN plgdsfnd (input  no,
      939                   input  v-cntxt-obj-type,
      940                   input  v-cntxt-obj-code,
      941                   input  pc-goods.gds-code,
      942                   output varres,
      943                   output var-code-temp) no-error.
      944     if varres = yes or error-status:error then do:
      945         put stream log unformatted "***" mess "Нельзя перемещать партии товара по складским местам "
      946             pc-goods.artic " " pc-goods.prod-type " " pc-goods.prod-code
      947             " по объкту " v-cntxt-obj-type " " v-cntxt-obj-code " "  skip.
      948         put stream ler unformatted "***" mess "Нельзя перемещать партии товара по складским местам "
      949             pc-goods.artic " " pc-goods.prod-type " " pc-goods.prod-code
      950             " по объкту " v-cntxt-obj-type " " v-cntxt-obj-code " "  skip.
      951         put stream err unformatted bar-str "," qnty-str "," pl-str skip.
      952     end.
      953     else
      954     for each ub.parts where ub.parts.obj-type  = v-cntxt-obj-type
      955                      and ub.parts.obj-code  = v-cntxt-obj-code
      956                      and ub.parts.artic     = pc-goods.artic
      957                      and ub.parts.prod-type = pc-goods.prod-type
      958                      and ub.parts.prod-code = pc-goods.prod-code
      959                      and ub.parts.in-code   = ub.bar-code.in-code
      960                      and ub.parts.part-code = ub.bar-code.part-code:
      961       if ub.parts.rsrv-free or
      962          ub.parts.out-code = t-doc.doc-code then ub.parts.pl-code = ub.place.pl-code.
      963     end.
      964   end.
      965   end procedure.
      966   procedure plgdsfnd :
      967     define input  parameter p-chk-and-chs    as logical               no-undo .
      968     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
      969     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
      970     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
      971     define output parameter p-reserv-pl-code as   logical             no-undo .
      972     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
      973     define buffer buf_goods         for ub.goods .
      974     define buffer buf_pl-gds        for ub.pl-gds .
      975     define buffer buf_second_pl-gds for ub.pl-gds .
      976     find first buf_goods no-lock where
      977                buf_goods.gds-code = p-gds-code no-error .
      978     if not available buf_goods
      979     then do:
      980       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
      981     end.
      982   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      983   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
      984     (input  p-obj-type
      985     ,input  p-obj-code
      986     ,input  buf_goods.artic
      987     ,input  buf_goods.prod-type
      988     ,input  buf_goods.prod-code
      989     ,input  'place-rsrv=request'
      990     ,output p-reserv-pl-code
      991     ) no-error .
      992     if error-status :error
      993     then do:
      994       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
      995     end.
      996     if p-reserv-pl-code = no
      997     then do:
      998       return .
      999     end.
     1000     if p-chk-and-chs <> yes
     1001     then do:
     1002       return .
     1003     end.
     1004     find first buf_pl-gds no-lock where
     1005                buf_pl-gds.obj-type = p-obj-type and
     1006                buf_pl-gds.obj-code = p-obj-code and
     1007                buf_pl-gds.gds-code = p-gds-code no-error .
     1008     if not available buf_pl-gds
     1009     then do:
     1010       return error "К товару не привязано ни одного места хранения" .
     1011     end.
     1012     find first buf_second_pl-gds no-lock where
     1013                buf_second_pl-gds.obj-type  = p-obj-type          and
     1014                buf_second_pl-gds.obj-code  = p-obj-code          and
     1015                buf_second_pl-gds.gds-code  = p-gds-code          and
     1016                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     1017     if not available buf_second_pl-gds
     1018     then do:
     1019       assign
     1020         p-pl-code = buf_pl-gds.pl-code
     1021       .
     1022     end.
     1023     else do:
     1024       run str/plgdssel.p
     1025         (
     1026            input parparentproc
     1027         ,  input p-obj-type
     1028         ,  input p-obj-code
     1029         ,  input p-gds-code
     1030         , output p-pl-code
     1031         ) no-error .
     1032       if error-status :error
     1033       then do:
     1034         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     1035                                , 'plgdssel.p':U
     1036                                , chr(10)
     1037                                , error-status :get-message( 1 )
     1038                                , return-value
     1039                                ) .
     1040       end.
     1041       if p-pl-code = ? or
     1042          p-pl-code = 0
     1043       then do:
     1044         return error "Не выбрано место хранения " + chr(10) .
     1045       end.
     1046     end.
     1047   end procedure.
     1048   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1049   define temp-table tt-bar-code-ne no-undo
     1050   field nm            as integer
     1051   field mark          as character
     1052   field b-c           as integer
     1053   field scn-qnty-doc  as decimal
     1054   field scn-qnty-file as decimal
     1055   field mem-qnty      as decimal
     1056   field bef-qnty      as decimal
     1057   field artic         like ub.goods.artic
     1058   field prod-type     like ub.goods.prod-type
     1059   field prod-code     like ub.goods.prod-code
     1060   field gds-name      like ub.goods.gds-name
     1061   field node-name     like ub.gds-prt.node-name
     1062   field part-code     like ub.bar-code.part-code
     1063   field in-code       like ub.bar-code.in-code
     1064   index pi is primary nm
     1065   index b-c is unique b-c.
     1066   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1067   DEFINE TEMP-TABLE in-bc NO-UNDO
     1068        FIELD nm        as INTEGER
     1069        FIELD bar-str   AS CHARACTER
     1070        FIELD bar-code  as CHARACTER
     1071        FIELD rez       as CHARACTER
     1072        FIELD err-msg   as CHARACTER
     1073        FIELD des       as CHARACTER
     1074        INDEX pi IS PRIMARY nm.
     1075   DEFINE new SHARED TEMP-TABLE un-bc NO-UNDO
     1076        FIELD nm             as INTEGER
     1077        FIELD bar-code       as CHARACTER
     1078        FIELD entity         as character
     1079        FIELD b-c            as INTEGER
     1080        FIELD rate           as DECIMAL
     1081        FIELD TYPE-bc        as CHARACTER
     1082        FIELD wt             as DECIMAL
     1083        FIELD file-qnty      as decimal
     1084        FIELD scn-qnty       as DECIMAL
     1085        FIELD scn-pl         as CHARACTER
     1086        FIELD artic          LIKE ub.goods.artic
     1087        FIELD prod-type      LIKE ub.goods.prod-type
     1088        FIELD prod-code      LIKE ub.goods.prod-code
     1089        FIELD gds-name       LIKE ub.goods.gds-name
     1090        FIELD prod-name      LIKE ub.clients.obj-name
     1091        FIELD unit-base      LIKE ub.goods.unit-base
     1092        FIELD units-type     LIKE ub.units.type
     1093        FIELD f-name         LIKE ub.gds-prt.f-name
     1094        FIELD in-code        LIKE ub.parts.in-code
     1095        FIELD fact-date      LIKE ub.parts.fact-date
     1096        FIELD part-code      LIKE ub.parts.part-code
     1097        FIELD rez            as CHARACTER
     1098        FIELD err-msg        as CHARACTER
     1099        FIELD des            as CHARACTER
     1100        FIELD pl-name        AS CHARACTER
     1101        FIELD loc1           AS CHARACTER
     1102        FIELD loc2           AS CHARACTER
     1103        FIELD loc3           AS CHARACTER
     1104        FIELD loc4           AS CHARACTER
     1105        FIELD unit-name      LIKE ub.units.unit-name
     1106        FIELD long-name      LIKE ub.units.long-name
     1107        FIELD b-c-base       LIKE ub.bar-code.b-code
     1108        FIELD unit-name-base LIKE ub.units.unit-name
     1109        FIELD long-name-base LIKE ub.units.long-name
     1110        INDEX pi IS PRIMARY  nm
     1111        INDEX bar-code bar-code
     1112        INDEX b-c b-c
     1113        INDEX file-qnty file-qnty.
     1114   DEFINE new SHARED TEMP-TABLE anlz-bc NO-UNDO
     1115        FIELD nm       as INTEGER
     1116        FIELD b-c      as integer
     1117        FIELD scn-qnty as DECIMAL
     1118        FIELD scn-pl   as CHARACTER
     1119        FIELD rez      as CHARACTER
     1120        FIELD err-msg  as CHARACTER
     1121        FIELD des      as CHARACTER
     1122        FIELD upd-line as logical initial no
     1123        INDEX pi IS PRIMARY nm
     1124        INDEX b-c b-c.
     1125   DEFINE new SHARED TEMP-TABLE main-bc NO-UNDO
     1126        FIELD nm       as INTEGER
     1127        FIELD b-c      as integer
     1128        FIELD scn-qnty as DECIMAL
     1129        FIELD scn-pl   as CHARACTER
     1130        FIELD rez      as CHARACTER
     1131        FIELD des      as CHARACTER
     1132        INDEX pi IS PRIMARY nm
     1133        INDEX b-c b-c.
     1134   define temp-table tt-bar-code-doc no-undo
     1135   field b-c      as integer
     1136   field scn-qnty as decimal
     1137   index pi is primary b-c.
     1138   define temp-table old-doc-line no-undo like doc-line.
     1139   define temp-table tt-chk-gds no-undo like ub.chk-gds.
     1140   define variable p-chk-gds-rid-list as character no-undo .
     1141   define variable p-call-handle  as handle no-undo .
     1142   define variable p-ii as integer no-undo .
     1143   define variable p-ii-ok as integer no-undo .
     1144   define variable v-curr-r-b  as character no-undo .
     1145   define variable cas-shft    as logical no-undo init no.
     1146   define variable chk-amount as integer.
     1147   define variable p-day-only  as logical no-undo .
     1148   define variable p-rid-list as character no-undo .
     1149   define variable p-is-all as logical no-undo init no.
     1150   define buffer X_chk-doc for ub.chk-doc.
     1151   DEFINE QUERY QUERY-chk-doc FOR X_chk-doc SCROLLING.
     1152   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1153   procedure proc-main :
     1154   define input parameter p-status_ like ub.trn-doc.status_ no-undo .
     1155   define input parameter p-flag_ as logical no-undo .
     1156   define input parameter p-direction as integer no-undo .
     1157   define variable accum-chk-doc-tot-doc as decimal no-undo.
     1158   define variable v-add as logical no-undo .
     1159   define variable glog as logical no-undo .
     1160   define variable action as character no-undo .
     1161   define variable v-rc-ii as integer no-undo initial 1.
     1162   define variable v-rc-max as integer no-undo .
     1163   define variable v-first as logical no-undo init yes .
     1164   define variable recid-line as recid no-undo .
     1165   define variable pl-str        as character no-undo.
     1166   define variable conf-par      as character no-undo.
     1167   define variable par-type      as character no-undo.
     1168   define variable varplace      as logical   no-undo.
     1169   define variable is-err        as logical   no-undo initial no .
     1170   define variable v-num         as integer   no-undo.
     1171   define variable v-user-action as character no-undo.
     1172   define variable v-printed     as logical   no-undo.
     1173   define variable varerr        as logical   no-undo.
     1174   define variable varanlz       as logical   no-undo.
     1175   define variable varlog        as logical   no-undo.
     1176   define variable varvalue      as character no-undo.
     1177   define variable vartype       as character no-undo.
     1178   define variable varline-file  as character no-undo.
     1179   define variable scan-name     as character no-undo.
     1180   define variable varnoapnd     as logical   no-undo .
     1181   define variable ii            as integer   no-undo.
     1182   define variable jj            as integer   no-undo.
     1183   define variable v-chk-type    as character no-undo .
     1184   define variable v-to-inc      as logical   no-undo .
     1185   define variable v-direction   as integer   no-undo .
     1186   define variable v-query-prepare as character no-undo .
     1187   define variable v-mode        as character no-undo .
     1188   define variable v-is-petrolium as logical no-undo.
     1189   define variable v-is-pieces as logical no-undo.
     1190   define buffer bb_doc-line for ub.doc-line.
     1191   define buffer bb_gds-prt  for ub.gds-prt.
     1192   define buffer bb_goods    for ub.goods.
     1193   define buffer bb_gds-dtl  for ub.gds-dtl.
     1194   define buffer bb_bar-code for ub.bar-code.
     1195   define buffer buf_bar-code for ub.bar-code.
     1196   define buffer buf_goods for ub.goods.
     1197   define buffer buf_c-chk-doc for ub.c-chk-doc.
     1198   define buffer buf_c-chk-gds for ub.c-chk-gds.
     1199   define buffer buf_c-chk-pay for ub.c-chk-pay.
     1200   define buffer buf_c-chk-discnt for ub.c-chk-discnt.
     1201   define buffer buf_c-chk-doc-attr for ub.c-chk-doc-attr.
     1202   define buffer buf_chk-gds for ub.chk-gds.
     1203   define buffer buf_chk-pay for ub.chk-pay.
     1204   define buffer buf_chk-discnt for ub.chk-discnt.
     1205   define buffer buf_doc-line for ub.doc-line.
     1206   define buffer buf_gds-dtl for ub.gds-dtl.
     1207   define buffer buf_tt-chk-gds for tt-chk-gds.
     1208   _main:
     1209   do
     1210   on error undo, return error return-value
     1211   :
     1212     for each in-bc on error undo _main, return error return-value :
     1213       delete in-bc.
     1214     end.
     1215     for each un-bc on error undo _main, return error return-value :
     1216       delete un-bc.
     1217     end.
     1218     for each main-bc on error undo _main, return error return-value :
     1219       delete main-bc.
     1220     end.
     1221     for each anlz-bc on error undo _main, return error return-value :
     1222       delete anlz-bc.
     1223     end.
     1224     scan-name = substitute("&1-чеки", t-doc.doc-code).
     1225     find first ub.sysconf no-lock where
     1226               ub.sysconf.host-code = t-doc.host-code .
     1227     g-type = if t-doc.office then 'у':U else 'т':U.
     1228   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1229   empty temp-table thbjattr_thbj-attr.
     1230   run adm/shattri.p (
     1231      input "get":U
     1232     ,input ''
     1233     ,input 0
     1234     ,input 'nakl-glob':U
     1235     ,input  ""
     1236     ,output v-value-character
     1237     ,output v-value-date
     1238     ,output v-value-decimal
     1239     ,output v-value-integer
     1240     ,output v-value-logical
     1241     ,output par-type
     1242     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1243     ) no-error .
     1244   for each thbjattr_thbj-attr :
     1245       if thbjattr_thbj-attr.prop-code = 'noapndsc' then varnoapnd = thbjattr_thbj-attr.property-value-logical  .
     1246   end.
     1247     if varnoapnd  then do:
     1248       output stream log to value (scan-name + ".log").
     1249       output stream err to value (scan-name + ".err").
     1250       output stream ler to value (scan-name + ".ler").
     1251     end.
     1252     else do:
     1253       output stream log to value (scan-name + ".log") append.
     1254       output stream err to value (scan-name + ".err") append.
     1255       output stream ler to value (scan-name + ".ler") append.
     1256     end.
     1257     put stream log unformatted "  " skip.
     1258     put stream log unformatted cur-time-string-sec() skip.
     1259     put stream ler unformatted "  " skip.
     1260     put stream ler unformatted cur-time-string-sec() skip.
     1261     if add-sens = ? then
     1262       put stream log unformatted " " skip skip "Привязка партий к складским местам.  Объект : " v-cntxt-obj-type " " string (v-cntxt-obj-code) skip skip.
     1263     else do:
     1264       put stream log unformatted " " skip skip "Накладная: " t-doc.doc-code
     1265             " Тип: " t-doc.doc-type string (t-doc.internal, "внутр/внешн") " Статус: " p-status_ " ОК: " string (p-flag_, "+/-") skip skip.
     1266       put stream ler unformatted " " skip skip "Накладная: " t-doc.doc-code
     1267             " Тип: " t-doc.doc-type string (t-doc.internal, "внутр/внешн") " Статус: " p-status_ " ОК: " string (p-flag_, "+/-") skip skip.
     1268       find first buf_doc-line where
     1269                 buf_doc-line.doc-code = t-doc.doc-code no-lock no-error.
     1270       if available buf_doc-line then do:
     1271         find first buf_goods where
     1272                  buf_goods.artic = buf_doc-line.artic
     1273              and buf_goods.prod-type = buf_doc-line.prod-type
     1274              and buf_goods.prod-code = buf_doc-line.prod-code no-lock.
     1275         g-type =  buf_goods.gds-type.
     1276       end.
     1277     end.
     1278     if p-status_  = 'разрешен':U and
     1279       add-sens       = ?            then do:
     1280       return.
     1281     end.
     1282     if p-status_  = 'разрешен':U
     1283       or (p-status_ = 'разрешен':U
     1284           and p-flag_ = yes
     1285           and p-direction = 1
     1286           )
     1287       then do:
     1288       put stream log unformatted " " skip skip "!!! Инвентаризация: " t-doc.doc-code
     1289             " подсчет суммарных количеств для одинаковых кодов." skip skip.
     1290     end.
     1291     assign
     1292     accum-chk-doc-tot-doc = 0
     1293     v-rc-max = (if p-rid-list <> '':U then num-entries(p-rid-list) else 1)
     1294     v-rc-ii = (if p-rid-list <> '':U
     1295                then (if available X_chk-doc
     1296                      then lookup(string(recid(X_chk-doc)), p-rid-list)
     1297                      else v-rc-ii)
     1298                else v-rc-ii)
     1299     .
     1300     if (p-status_ = 'разрешен':U
     1301     and p-direction = -1)
     1302     then do:
     1303       ASSIGN
     1304       v-query-prepare = substitute("for each X_chk-doc no-lock where X_chk-doc.out-code = '&1'":U, t-doc.doc-code).
     1305       assign
     1306       glog = QUERY query-chk-doc:QUERY-PREPARE(v-query-prepare) No-error.
     1307       IF not glog
     1308       THEN DO:
     1309         undo, return error substitute("Ошибка при построении запроса по чекам инвентаризации:&1&2&1&3"
     1310                                       , chr(10)
     1311                                       , error-status:get-message(1)
     1312                                       , return-value ).
     1313       END.
     1314       assign
     1315       glog = QUERY query-chk-doc:query-OPEN() NO-ERROR.
     1316       IF not glog
     1317       THEN DO:
     1318         undo, return error substitute("Ошибка при открытии запроса по чекам инвентаризации:&1&2&1&3"
     1319                                       , chr(10)
     1320                                       , error-status:get-message(1)
     1321                                       , return-value ).
     1322       END.
     1323       ASSIGN
     1324       glog = QUERY query-chk-doc:GET-FIRST(no-LOCK) NO-ERROR.
     1325       IF not glog THEN DO:
     1326         RETURN.
     1327       END.
     1328       ASSIGN
     1329       glog = QUERY query-chk-doc:GET-FIRST(exclusive-LOCK, no-wait) NO-ERROR.
     1330       do while locked (X_chk-doc ) and available X_chk-doc:
     1331         glog = QUERY query-chk-doc:GET-NEXT(exclusive-LOCK, no-wait) NO-ERROR.
     1332       end.
     1333     end.
     1334     c-d:
     1335     DO WHILE available X_chk-doc or (p-rid-list <> '':U and  v-rc-ii <= v-rc-max) or action = "next"
     1336     on error undo c-d, NEXT c-d
     1337     on stop undo c-d, NEXT c-d:
     1338       action = '':U.
     1339       if not v-first then do:
     1340         if p-rid-list = "":U then do:
     1341           ASSIGN
     1342           glog = QUERY query-chk-doc:GET-next(no-LOCK) NO-ERROR.
     1343           if available X_chk-doc then do:
     1344             ASSIGN
     1345             glog = QUERY query-chk-doc:GET-current(exclusive-LOCK, no-wait) NO-ERROR.
     1346             if locked(X_chk-doc) then do:
     1347               error-status:error = no.
     1348               action = "next".
     1349               next c-d.
     1350             end.
     1351           end.
     1352         end.
     1353         else do:
     1354           assign
     1355           v-rc-ii = v-rc-ii + 1.
     1356           _v-rc:
     1357           do while v-rc-ii <= v-rc-max:
     1358             find first X_chk-doc exclusive-lock where
     1359                       recid(X_chk-doc) = integer(entry(v-rc-ii, p-rid-list))  no-error  NO-WAIT.
     1360             if locked X_chk-doc or not available X_chk-doc then do:
     1361               assign
     1362               v-rc-ii = v-rc-ii + 1.
     1363               next _v-rc.
     1364             end.
     1365             else LEAVE _v-rc.
     1366           end.
     1367           if v-rc-ii > v-rc-max then release X_chk-doc.
     1368         end.
     1369         if (not available X_chk-doc and action = '':U)
     1370         or (p-rid-list <> "":U and v-rc-ii > v-rc-max) then LEAVE c-d.
     1371       end.
     1372       if v-first then v-first = no.
     1373       if lookup(string(X_chk-doc.chk-type), '11':U) = 0 then next c-d.
     1374       if X_chk-doc.out-code = ? then do:
     1375         assign
     1376         v-chk-type = replace(X_chk-doc.office, '0', '':U)
     1377         v-chk-type = replace(v-chk-type, chr(44) + chr(44), chr(44))
     1378         v-chk-type = trim(v-chk-type, chr(44))
     1379         .
     1380         if (v-chk-type <> g-type or v-chk-type = ?)
     1381         then do:
     1382           NEXT c-d .
     1383         end.
     1384         if  v-chk-type <> g-type
     1385         and v-chk-type <> '':U then do:
     1386           NEXT c-d .
     1387         end.
     1388         assign
     1389         p-ii = p-ii + 1
     1390         .
     1391         if p-ii < 10
     1392         or (p-ii < 1000 and chk-amount modulo 10 = 0)
     1393         or (p-ii < 10000 and chk-amount modulo 100 = 0)
     1394         then do:
     1395           run display-chk in p-call-handle ( input chk-amount).
     1396         end.
     1397       end.
     1398       if entry(1, X_chk-doc.doc-num, chr(4)) = t-doc.doc-code then do:
     1399         run display-message in p-call-handle ( input substitute("Чек &1 уже был обсчитан&2" +
     1400                                                                    "Если в нем остались необсчитанные товары,&2" +
     1401                                                                    "Их может обсчитать потоварно"
     1402                                                                    , X_chk-doc.doc-code
     1403                                                                    , chr(10))).
     1404       end.
     1405       if X_chk-doc.out-code = ?
     1406       then do:
     1407         assign
     1408         v-to-inc = yes.
     1409       end.
     1410       else do:
     1411         assign
     1412         v-to-inc = no.
     1413       end.
     1414       if X_chk-doc.out-code = t-doc.doc-code
     1415       and p-status_ = 'разрешен':U
     1416       and p-flag_ = yes
     1417       and p-direction = 1
     1418       and p-chk-gds-rid-list = '':U
     1419       then do:
     1420         assign
     1421         v-direction = p-direction.
     1422       end.
     1423       else do:
     1424         assign
     1425         v-direction = 0.
     1426       end.
     1427       _one-check:
     1428       do
     1429       on error undo _one-check, leave _one-check
     1430       on stop undo _one-check, leave _one-check
     1431       :
     1432         _buf_chk-gds:
     1433         FOR EACH buf_chk-gds WHERE buf_chk-gds.doc-code = X_chk-doc.doc-code
     1434         on error undo _one-check, LEAVE _one-check
     1435         on stop undo _one-check, leave _one-check
     1436         :
     1437           if p-chk-gds-rid-list <> "":U
     1438           and lookup(string(recid(buf_chk-gds)), p-chk-gds-rid-list) = 0 then next _buf_Chk-gds.
     1439           if p-chk-gds-rid-list <> "":U then do:
     1440             if p-status_ = 'разрешен':U
     1441             and p-flag_ = yes
     1442             and p-direction = 1
     1443             then do:
     1444               assign
     1445               v-direction = p-direction.
     1446             end.
     1447             else do:
     1448               assign
     1449               v-direction = 0.
     1450             end.
     1451           end.
     1452           assign
     1453           buf_chk-gds.is-error = (if buf_chk-gds.out-code = ?
     1454                                   then yes
     1455                                   else (if p-status_ = 'разрешен':U
     1456                                         and p-flag_ = yes
     1457                                         and p-direction = -1
     1458                                         then yes
     1459                                         else buf_chk-gds.is-error)
     1460                                  )
     1461           buf_chk-gds.out-code = (if buf_chk-gds.out-code = ?
     1462                                   then t-doc.doc-code
     1463                                   else buf_chk-gds.out-code)
     1464           .
     1465           if buf_chk-gds.doc-qnty = 0 then do:
     1466             buf_chk-gds.is-err = no.
     1467             NEXT _Buf_chk-gds.
     1468           end.
     1469           if buf_chk-gds.is-error = no then do:
     1470             NEXT _Buf_chk-gds.
     1471           end.
     1472           if p-status_ = 'накл':U
     1473           and p-flag_ <> yes
     1474           then do:
     1475             FIND FIRST buf_bar-code WHERE
     1476                      buf_bar-code.b-code = buf_chk-gds.b-code NO-LOCK NO-ERROR.
     1477             if not avail buf_bar-code then do:
     1478               next _buf_chk-gds.
     1479             end.
     1480             FIND FIRST buf_goods WHERE
     1481                       buf_goods.gds-code = buf_bar-code.gds-code NO-LOCK.
     1482   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_adinvlin in g#lib-trn3
     1483   (input  parparentproc
     1484   ,input  t-doc.doc-code
     1485   ,input  buf_goods.artic
     1486   ,input  buf_goods.prod-type
     1487   ,input  buf_goods.prod-code
     1488   ,output recid-line
     1489   ) no-error.
     1490             if error-status:error then do:
     1491               buf_chk-gds.is-err = yes.
     1492             end.
     1493             find first buf_doc-line where recid(buf_doc-line) = recid-line exclusive-lock.
     1494             buf_doc-line.prt-OK = ?.
     1495             buf_chk-gds.is-err = yes.
     1496           end.
     1497           assign
     1498           buf_chk-gds.line-type = entry(1, buf_chk-gds.line-type) + chr(4) + 'vt':U
     1499           .
     1500           if not v-to-inc
     1501           and p-direction = 1
     1502           then do:
     1503             create buf_tt-chk-gds.
     1504             buffer-copy buf_chk-gds to buf_tt-chk-gds.
     1505             release buf_tt-chk-gds.
     1506           end.
     1507         END .
     1508         if not v-to-inc
     1509         and p-direction = 1
     1510         and not can-find(first tt-chk-gds) then do:
     1511           leave _one-check.
     1512         end.
     1513         if v-to-inc then do:
     1514           for each buf_c-chk-doc where
     1515                   buf_c-chk-doc.doc-code = X_chk-doc.doc-code:
     1516             assign
     1517             buf_c-chk-doc.out-code = t-doc.doc-code
     1518             .
     1519           end.
     1520           for each buf_c-chk-gds where
     1521                   buf_c-chk-gds.doc-code = X_chk-doc.doc-code:
     1522             assign
     1523             buf_c-chk-gds.out-code = t-doc.doc-code
     1524             .
     1525           end.
     1526           for each buf_c-chk-discnt where
     1527                   buf_c-chk-discnt.doc-code = X_chk-doc.doc-code:
     1528             assign
     1529             buf_c-chk-discnt.out-code = t-doc.doc-code
     1530             .
     1531           end.
     1532           for each buf_c-chk-pay where
     1533                   buf_c-chk-pay.doc-code = X_chk-doc.doc-code:
     1534             assign
     1535             buf_c-chk-pay.out-code = t-doc.doc-code
     1536             .
     1537           end.
     1538           for each buf_c-chk-doc-attr where
     1539                   buf_c-chk-doc-attr.doc-code = X_chk-doc.doc-code:
     1540             assign
     1541             buf_c-chk-doc-attr.out-code = t-doc.doc-code
     1542             .
     1543           end.
     1544           assign
     1545           X_chk-doc.out-code = t-doc.doc-code
     1546           chk-amount = chk-amount + 1
     1547           accum-chk-doc-tot-doc = accum-chk-doc-tot-doc  + X_chk-doc.tot-doc
     1548           .
     1549         end.
     1550         if p-status_ = 'накл':U
     1551         and p-flag_   <> yes then do:
     1552         end.
     1553         if (p-status_ = 'разрешен':U
     1554         and p-flag_ = yes
     1555         and p-direction = 1)
     1556         or p-status_ = 'разрешен':U
     1557         then do:
     1558           find first tt-chk-gds no-error.
     1559           repeat while v-to-inc
     1560           or v-direction = 1
     1561           or can-find (first tt-chk-gds)
     1562           :
     1563             find first tt-chk-gds no-error.
     1564             if p-chk-gds-rid-list <> '':U then do:
     1565               for each un-bc on error undo _main, return error return-value :
     1566                 delete un-bc.
     1567               end.
     1568               for each anlz-bc on error undo _main, return error return-value :
     1569                 delete anlz-bc.
     1570               end.
     1571             end.
     1572             run str/bc-anlz.p (
     1573                            input parparentproc
     1574                           ,input "chk-doc"
     1575                           ,input  (if v-to-inc or (v-direction = 1 and not available tt-chk-gds)
     1576                                   then X_chk-doc.doc-code
     1577                                   else (X_chk-doc.doc-code + chr(44) + string(tt-chk-gds.line-num))
     1578                                   )
     1579                           ,input yes
     1580                           ,output varerr
     1581                           ,output table in-bc ) no-error .
     1582             if error-status:error then do:
     1583             end.
     1584             if varerr = yes then is-err = yes.
     1585             if available tt-chk-gds then delete tt-chk-gds.
     1586             find first tt-chk-gds no-error .
     1587             if v-to-inc then v-to-inc = no.
     1588             if v-direction = 1 then v-direction = 0.
     1589             if p-chk-gds-rid-list <> '':U then do:
     1590               define variable vari    as integer no-undo.
     1591               define variable vartime as integer no-undo.
     1592               for each un-bc on error undo, return error return-value :
     1593                   assign
     1594                     vari = vari + 1.
     1595                   run display-message in p-call-handle ( INPUT substitute("Записываем ошибки разбора чека инвентаризации в файлы. Всего проверено на ошибки &1. Время &2.", vari, string (time - vartime, "hh:mm:ss"))).
     1596                   if un-bc.rez = "err" then do:
     1597                     put stream log unformatted un-bc.err-msg skip.
     1598                     put stream ler unformatted un-bc.err-msg skip.
     1599                     put stream err unformatted un-bc.bar-code ", " un-bc.file-qnty skip.
     1600                     assign is-err = yes.
     1601                   end.
     1602               end.
     1603               run waitfram-hide in this-procedure.
     1604             end.
     1605           end.
     1606         end.
     1607         assign
     1608         p-ii-ok = p-ii-ok + 1
     1609         .
     1610       end.
     1611       if p-status_ = 'разрешен':U
     1612       and p-chk-gds-rid-list = '':U then do:
     1613         entry(1, X_chk-doc.doc-num, chr(4)) = t-doc.doc-code.
     1614       end.
     1615       if p-status_ = 'разрешен':U
     1616       and p-direction = - 1
     1617       and p-chk-gds-rid-list = '':U then do:
     1618         entry(1, X_chk-doc.doc-num, chr(4)) = '':U.
     1619       end.
     1620     END.
     1621     run display-message in p-call-handle ( input "Записываем результат разбора чека инвентаризации файла в log-файл.").
     1622     assign
     1623       vari    = 0.
     1624       vartime = time.
     1625     if p-chk-gds-rid-list = '':U then do:
     1626       for each un-bc on error undo, return error return-value :
     1627           assign
     1628             vari = vari + 1.
     1629           run waitfram-show in this-procedure (substitute("Записываем ошибки разбора чека инвентаризации в файлы. Всего проверено на ошибки &1. Время &2.", vari, string (time - vartime, "hh:mm:ss"))).
     1630           if un-bc.rez = "err" then do:
     1631             put stream log unformatted un-bc.err-msg skip.
     1632             put stream ler unformatted un-bc.err-msg skip.
     1633             put stream err unformatted un-bc.bar-code ", " un-bc.file-qnty skip.
     1634             assign is-err = yes.
     1635           end.
     1636       end.
     1637     end.
     1638     run waitfram-hide in this-procedure.
     1639     _main-bc:
     1640     for each main-bc on error undo, return error return-value :
     1641       assign
     1642       ii = i
     1643       ii = ii + 1
     1644       i = ii
     1645       .
     1646       run display-processed in p-call-handle ( input ii).
     1647       find first ub.bar-code where ub.bar-code.b-code   = main-bc.b-c        no-lock.
     1648       find first ub.goods    where ub.goods.gds-code    = ub.bar-code.gds-code  no-lock.
     1649       find first ub.gds-prt  where ub.gds-prt.node-code = ub.bar-code.node-code no-lock.
     1650   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1651     (
     1652        input ub.goods.artic
     1653     ,  input ub.goods.prod-type
     1654     ,  input ub.goods.prod-code
     1655     , output v-is-petrolium
     1656     , output v-is-pieces
     1657     ) .
     1658       if v-is-petrolium = yes and
     1659         v-is-pieces    = no  then do:
     1660         message "Товар " goods.artic " " goods.prod-type " " goods.prod-code " является жидким топливом." skip
     1661                 "Товар нельзя добавить из чека."
     1662         view-as alert-box error.
     1663         put stream log unformatted "Бар-код " bar-code.b-code " принадлежит жидкому топливу - нельзя добавить из чека." skip.
     1664         put stream ler unformatted "Бар-код " bar-code.b-code " принадлежит жидкому топливу - нельзя добавить из чека." skip.
     1665         put stream err unformatted main-bc.b-c ", " main-bc.scn-qnty skip.
     1666         assign is-err = yes.
     1667         next.
     1668       end.
     1669       if gds-prt.is-term <> yes then do:
     1670         put stream log unformatted "Бар-код " bar-code.b-code " не является кодом терминального признака." skip.
     1671         put stream ler unformatted "Бар-код " bar-code.b-code " не является кодом терминального признака." skip.
     1672         put stream err unformatted main-bc.b-c ", " main-bc.scn-qnty skip.
     1673         assign is-err = yes.
     1674         next.
     1675       end.
     1676       assign bar-str  = string(main-bc.b-c)
     1677             qnty-str = string(main-bc.scn-qnty)
     1678             rate     = 1
     1679             pl-str   = main-bc.scn-pl
     1680             mess     = main-bc.des.
