     1682                 buf_doc-line.artic = goods.artic
     1683             and buf_doc-line.prod-type = goods.prod-type
     1684             and buf_doc-line.prod-code = goods.prod-code
     1685             and buf_doc-line.doc-code = t-doc.doc-code
     1686             no-error.
     1687       run proc-code in this-procedure ( input main-bc.scn-pl
     1688                                         ,input (if main-bc.rez = "place" then "place" else "")
     1689                                         ,input varscales-pref
     1690                                         ,input varpgscales-pref
     1691                                         ) no-error.
     1692       if error-status:error then do:
     1693         assign is-err = yes.
     1694       end.
     1695       else do:
     1696         assign
     1697         jj = j
     1698         jj = jj + 1
     1699         j = jj
     1700         .
     1701         run display-processed-ok in p-call-handle ( input jj).
     1702       end.
     1703     end.
     1704     output stream log close.
     1705     output stream err close.
     1706     output stream ler close.
     1707     if is-err then do:
     1708         message "Во время загрузки чеков:" scan-txt "обнаружены ошибки." skip
     1709                 "Смотрите ler файл."
     1710         view-as alert-box error buttons ok.
     1711         if search (scan-name + ".ler") <> ? then do:
     1712           run gbl/prnfilen.w (
     1713              input  substitute("Ошибки, обнаруженные во время загрузки чеков")
     1714             ,input  0
     1715             ,input  scan-name + ".ler"
     1716             ,input  7
     1717             ,output v-user-action
     1718             ,output v-printed
     1719             ).
     1720         end.
     1721     end.
     1722     run display-chk in p-call-handle ( input chk-amount ).
     1723   end.
     1724   end procedure.
