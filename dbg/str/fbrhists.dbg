        1   define input parameter p-sort-type      as integer      no-undo.
        2   define input parameter p-doc-code       as character    no-undo.
        3   define input parameter p-date-from      as date         no-undo.
        4   define input parameter p-date-to        as date         no-undo.
        5   define input parameter p-level          as integer      no-undo.
        6   define input parameter p-userid         as character    no-undo.
        7   define output parameter p-out-sort-type as integer      no-undo.
        8   define output parameter p-out-doc-code  as character    no-undo.
        9   define output parameter p-out-date-from as date         no-undo.
       10   define output parameter p-out-date-to   as date         no-undo.
       11   define output parameter p-out-level     as integer      no-undo.
       12   define output parameter p-out-userid    as character    no-undo.
       13   define output parameter p-ok-pressed    as logical      no-undo.
       14   define variable vss-revision    as character no-undo init "$Revision$":U .
       15   define variable vss-author      as character no-undo init "$Author$":U .
       16   define variable vss-date        as character no-undo init "$Date$":U .
       17   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       18   define variable vss-archive     as character no-undo init "$Archive$":U .
       19   define variable vss-description as character no-undo init "Группировка записей истории производства".
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   procedure cur-time :
       80      define output parameter p-today as date      no-undo .
       81      define output parameter p-time  as integer   no-undo .
       82     do
       83     on error undo, return error
       84     :
       85       define variable v-date1 as date      no-undo .
       86       define variable v-date2 as date      no-undo .
       87       define variable v-time  as integer   no-undo .
       88       assign
       89         v-date1 = today
       90         v-time  = time
       91         v-date2 = today
       92       .
       93       if v-date1 <> v-date2
       94       then do:
       95         assign
       96           v-date1 = today
       97           v-time  = v-time
       98         .
       99       end.
      100       assign
      101         p-today = v-date1
      102         p-time  = v-time
      103       .
      104     end.
      105   end.
      106   function cur-time-date returns character
      107   :
      108     return string(today, '99/99/9999':U) .
      109   end.
      110   function cur-time-mjd returns decimal
      111   :
      112     define variable v-date as date      no-undo .
      113     define variable v-time as integer   no-undo .
      114     run cur-time in this-procedure
      115       (output v-date
      116       ,output v-time
      117       ) .
      118     return integer(v-date) - 2400002 + (v-time / 86400) .
      119   end.
      120   function cur-time-get-ending-index returns integer
      121   (input p-number as integer
      122   )
      123   :
      124     if p-number < 0
      125     or p-number = ?
      126     then do:
      127       return 1 .
      128     end.
      129     define variable v-rest as integer   no-undo .
      130     assign
      131       p-number = p-number modulo 100
      132     .
      133     if p-number < 20
      134     then do:
      135       assign
      136         v-rest = p-number
      137       .
      138     end.
      139     else do:
      140       assign
      141         v-rest = p-number modulo 10
      142       .
      143     end.
      144     case v-rest :
      145       when 1
      146       then do:
      147         return 2 .
      148       end.
      149       when 2 or
      150       when 3 or
      151       when 4
      152       then do:
      153         return 3 .
      154       end.
      155       otherwise do:
      156         return 1 .
      157       end.
      158     end case .
      159   end.
      160   procedure cur-time-mjd-to-date :
      161      define input  parameter i-mjd-diff as decimal no-undo.
      162      define output parameter o-Date     as date    no-undo.
      163      define output parameter o-Time     as integer no-undo.
      164      define variable v-day-number as integer   no-undo .
      165      if    i-mjd-diff < 0
      166         or i-mjd-diff = ?
      167      then do:
      168         return "?" .
      169      end.
      170      assign
      171         v-day-number = truncate(i-mjd-diff,0).
      172         o-Date = date(v-day-number + 2400002).
      173         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      174     .
      175   end.
      176   function cur-time-mjd-to-string returns character
      177   (input p-mjd-diff as decimal
      178   )
      179   :
      180     define variable v-day-number as integer   no-undo .
      181     define variable v-seconds    as integer   no-undo .
      182     define variable v-hour       as integer   no-undo .
      183     define variable v-min        as integer   no-undo .
      184     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      185     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      186     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      187     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      188     if p-mjd-diff < 0
      189     or p-mjd-diff = ?
      190     then do:
      191       return "?" .
      192     end.
      193     assign
      194       v-day-number = integer(truncate(p-mjd-diff,0))
      195       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      196     .
      197     if v-seconds > 86400
      198     then do:
      199       assign
      200         v-seconds = 86400 - 1
      201       .
      202     end.
      203     if v-seconds < 0
      204     then do:
      205       assign
      206         v-seconds = 0
      207       .
      208     end.
      209     assign
      210       v-hour = truncate(v-seconds / 3600, 0)
      211     .
      212     assign
      213       v-seconds = v-seconds modulo 3600
      214     .
      215     assign
      216       v-min = truncate(v-seconds / 60, 0)
      217     .
      218     assign
      219       v-seconds = v-seconds modulo 60
      220     .
      221     return
      222         (if v-day-number <> 0
      223           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0
      227           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      231           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      232           else ""
      233         )
      234       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      235       .
      236   end.
      237   function cur-time-string returns character
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      246   end.
      247   function cur-time-string-sec returns character
      248   :
      249     define variable v-date as date      no-undo .
      250     define variable v-time as integer   no-undo .
      251     run cur-time in this-procedure
      252       (output v-date
      253       ,output v-time
      254       ) .
      255     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      256   end.
      257   function cur-time-custom  returns character
      258   (input p-prefix as character
      259   ,input p-date-format as character
      260   ,input p-delimiter as character
      261   ,input p-time-format as character
      262   ,input p-suffix as character
      263   )
      264   :
      265     define variable v-date as date      no-undo .
      266     define variable v-time as integer   no-undo .
      267     run cur-time in this-procedure
      268       (output v-date
      269       ,output v-time
      270       ) .
      271     return
      272       p-prefix
      273       + string(v-date, p-date-format)
      274       + p-delimiter
      275       + string(v-time, p-time-format)
      276       + p-suffix
      277       .
      278   end.
      279   function cur-time-print  returns character
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      288   end.
      289   function cur-time-datetime returns datetime
      290   :
      291     define variable v-char as character no-undo .
      292     define variable v-datetime as datetime no-undo .
      293     v-char = cur-time-string().
      294     v-datetime = datetime(v-char).
      295     return  v-datetime.
      296   end.
      297   function cur-time-string-msec returns character
      298   :
      299     define variable v-date as datetime  no-undo .
      300     v-date = now.
      301     return string(v-date) .
      302   end.
      303   procedure proc-alt-shift-f2:
      304     if not ibs.th.gbl.gbl-var:rcode
      305   then
      306     run gbl\inidebug.p .
      307   end.
      308   procedure proc-alt-shift-f3:
      309     run gbl/prvssinf.p
      310       ( input this-procedure
      311       ) .
      312   end.
      313   define variable v-inform-launched as logical no-undo initial false .
      314   procedure proc-alt-shift-f4:
      315     define variable v-action as character no-undo .
      316     if v-inform-launched = false then do:
      317       assign
      318         v-inform-launched = true
      319       .
      320       run gbl/d-inform.w
      321         (  input self
      322         ,  input this-procedure
      323         , output v-action
      324         ) no-error .
      325       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      326       assign
      327         v-inform-launched = false
      328       .
      329     end.
      330   end.
      331   procedure proc-alt-f1:
      332     run gbl/corrhelp.p
      333       (input this-procedure
      334       ) .
      335   end .
      336   on alt-shift-f2 anywhere do:
      337     run proc-alt-shift-f2.
      338   end.
      339   on alt-shift-f3 anywhere do:
      340     run proc-alt-shift-f3 in this-procedure .
      341   end.
      342   on alt-shift-f4 anywhere do:
      343     run proc-alt-shift-f4 in this-procedure.
      344   end.
      345   on alt-f1 anywhere do:
      346     run proc-alt-f1 in this-procedure .
      347   end.
      348       define variable v-today as date      no-undo.
      349       define variable v-time  as integer   no-undo.
      350   DEFINE BUTTON b-cancel AUTO-END-KEY
      351        LABEL "&Отмена"
      352        SIZE 10 BY 1
      353        BGCOLOR 8 .
      354   DEFINE BUTTON b-exit AUTO-GO
      355        LABEL "В&ыбор"
      356        SIZE 10 BY 1
      357        BGCOLOR 8 .
      358   DEFINE BUTTON b-help
      359        LABEL "Помо&щь"
      360        SIZE 10 BY 1.
      361   DEFINE BUTTON bt-sel-obj
      362        IMAGE-UP FILE "btn-down-arrow":U
      363        IMAGE-DOWN FILE "btn-down-arrow":U
      364        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      365        LABEL "..."
      366        SIZE 3.63 BY 1.04.
      367   DEFINE VARIABLE fi-date-from AS DATE FORMAT "99.99.9999":U
      368        LABEL "с"
      369        VIEW-AS FILL-IN
      370        SIZE 14 BY 1 NO-UNDO.
      371   DEFINE VARIABLE fi-date-to AS DATE FORMAT "99.99.9999":U
      372        LABEL "по"
      373        VIEW-AS FILL-IN
      374        SIZE 14 BY 1 NO-UNDO.
      375   DEFINE VARIABLE fi-doc-code AS CHARACTER FORMAT "X(256)":U
      376        LABEL "номер"
      377        VIEW-AS FILL-IN
      378        SIZE 14 BY 1 NO-UNDO.
      379   DEFINE VARIABLE fi-level AS INTEGER FORMAT ">>9":U INITIAL 0
      380        LABEL "уровень"
      381        VIEW-AS FILL-IN
      382        SIZE 4 BY 1 NO-UNDO.
      383   DEFINE VARIABLE fi-userid AS CHARACTER FORMAT "X(256)":U
      384        LABEL "имя"
      385        VIEW-AS FILL-IN
      386        SIZE 14 BY 1 NO-UNDO.
      387   DEFINE VARIABLE rs-group-type AS INTEGER
      388        VIEW-AS RADIO-SET VERTICAL
      389        RADIO-BUTTONS
      390             "Все", 1,
      391   "По документу", 2,
      392   "Диапазон дат", 3,
      393   "Пользователь", 4
      394        SIZE 19.5 BY 5 NO-UNDO.
      395   DEFINE FRAME Dialog-Frame
      396        b-exit AT ROW 1.25 COL 1.5
      397        b-cancel AT ROW 1.25 COL 11.5
      398        b-help AT ROW 1.25 COL 52
      399        rs-group-type AT ROW 2.75 COL 2.5 NO-LABEL
      400        fi-level AT ROW 2.75 COL 26 COLON-ALIGNED
      401        fi-doc-code AT ROW 4 COL 26 COLON-ALIGNED
      402        fi-date-from AT ROW 5.25 COL 26 COLON-ALIGNED
      403        fi-date-to AT ROW 5.25 COL 46 COLON-ALIGNED
      404        fi-userid AT ROW 6.5 COL 26 COLON-ALIGNED
      405        bt-sel-obj AT ROW 6.5 COL 42
      406        SPACE(17.11) SKIP(0.66)
      407       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      408            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      409            TITLE "Группировка записей истории"
      410            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-cancel.
      411   ASSIGN
      412          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      413          FRAME Dialog-Frame:HIDDEN           = TRUE.
      414   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      415   DO:
      416     APPLY "END-ERROR":U TO SELF.
      417   END.
      418   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
      419   DO:
      420       assign
      421           p-ok-pressed = no
      422       .
      423   END.
      424   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      425   DO:
      426       assign
      427           rs-group-type
      428           fi-doc-code
      429           fi-date-from
      430           fi-date-to
      431           fi-level
      432           fi-userid
      433       .
      434       run assign-out-param in this-procedure.
      435       assign
      436           p-ok-pressed = yes
      437       .
      438   END.
      439   ON CHOOSE OF bt-sel-obj IN FRAME Dialog-Frame
      440   DO:
      441       define variable v-userid    as character  no-undo.
      442       define variable v-ok        as logical    no-undo.
      443       run str/fbrhstlu.w (
      444             output v-userid
      445           , output v-ok
      446       ) no-error.
      447       if error-status :error
      448       then do:
      449           message
      450               vss-workfile vss-revision vss-description
      451               skip "Ошибка выбора пользователя из списка."
      452               skip return-value
      453               skip trim(error-status :get-message(1))
      454               trim(error-status :get-message(2))
      455               trim(error-status :get-message(3))
      456           view-as alert-box error.
      457           undo, return no-apply .
      458       end.
      459       if v-ok = yes
      460       then do:
      461           assign
      462               fi-userid       = v-userid
      463               rs-group-type   = 4
      464           .
      465           display
      466               fi-userid
      467               rs-group-type
      468           with frame Dialog-Frame.
      469           apply "value-changed" to rs-group-type.
      470           apply "entry" to fi-level.
      471       end.
      472   END.
      473   ON VALUE-CHANGED OF rs-group-type IN FRAME Dialog-Frame
      474   DO:
      475       assign
      476           rs-group-type
      477       .
      478       run ui-enable-all in this-procedure.
      479       run ui-disable in this-procedure.
      480   END.
      481   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      482   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      483   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      484   on help of frame Dialog-Frame
      485   do:
      486     run gbl/app_help.p
      487       (input this-procedure :file-name
      488       ,input ''
      489       ,input ?
      490       ) no-error.
      491     if error-status :error then do:
      492       message
      493         "Ошибка при вызове помощи"
      494         error-status :get-message(1)
      495         view-as alert-box .
      496     end.
      497   end.
      498   run minbtn-set in this-procedure .
      499   on choose of b-help in frame Dialog-Frame
      500   do:
      501     apply "help":u to frame Dialog-Frame .
      502   end.
      503   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      504   procedure minbtn-set :
      505       do
      506           on error undo, return error return-value
      507           :
      508           define variable ii              as integer       no-undo .
      509           define variable fh              as widget-handle no-undo .
      510           define variable hh              as widget-handle no-undo .
      511           define variable v-h             as handle        extent 4 no-undo .
      512           define variable v-name-button   as character     no-undo .
      513           define variable v-help-old-x    as decimal       no-undo .
      514           define variable v-help-old-y    as decimal       no-undo .
      515           define variable v-help-old-size as decimal       no-undo .
      516           define variable v-frame-width   as decimal       no-undo .
      517           define variable jj              as integer       no-undo .
      518           do
      519               on error undo, return error
      520               :
      521               assign
      522                   v-frame-width = frame Dialog-Frame:width - 0.3
      523                   fh            = frame Dialog-Frame:first-child
      524                   hh            = fh:first-child
      525                   ii            = 1
      526                   .
      527               do while valid-handle(hh):
      528                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      529                   do:
      530                       case lc(hh:name) :
      531                           when "b-help" then
      532                               do:
      533                                   hh:load-image-up("cmp/b-help.bmp":u) .
      534                                   hh:load-image-down("cmp/b-help.bmp":u) .
      535                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      536                                   hh:TOOLTIP = "Помощь" .
      537                                   v-help-old-x = hh:column .
      538                                   v-help-old-y = hh:row    .
      539                                   v-help-old-size = hh:width .
      540                                   hh:width-chars = 2.5 .
      541                               end.
      542                           when "b-print" then
      543                               do:
      544                                   hh:load-image("cmp/b-print.bmp":u) .
      545                                   hh:TOOLTIP = "Печать" .
      546                                   v-h[ii] = hh:handle .
      547                                   ii = ii + 1 .
      548                                   hh:width-chars = 3 .
      549                               end.
      550                           when "b-history" or
      551                           when "b-hist" then
      552                               do:
      553                                   hh:load-image("cmp/b-hist.bmp":u) .
      554                                   hh:TOOLTIP = "История" .
      555                                   v-h[ii] = hh:handle .
      556                                   ii = ii + 1 .
      557                                   hh:width-chars = 3 .
      558                               end.
      559                           when "b-sch" then
      560                               do:
      561                                   hh:load-image("cmp/b-sch.bmp":u) .
      562                                   hh:TOOLTIP = "Установка Фильтра" .
      563                                   v-h[ii] = hh:handle .
      564                                   ii = ii + 1 .
      565                                   hh:width-chars = 3 .
      566                               end.
      567                           when "b-hist-user" then
      568                               do:
      569                                   hh:load-image("cmp/b-hist.bmp":u) .
      570                                   hh:TOOLTIP = "История пользователя" .
      571                                   ii = ii + 1 .
      572                               end.
      573                       end case.
      574                   end.
      575                   hh = hh:next-sibling.
      576               end.
      577               b-help:column = v-frame-width - b-help:width-chars.
      578               jj = 0.
      579               repeat ii = 4 to 1 by -1 :
      580                   if valid-handle (v-h[ii] ) then
      581                   do:
      582                       jj  = jj + 1 .
      583                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      584                       v-h[ii]:row    = v-help-old-y .
      585                   end.
      586               end.
      587           end.
      588       end.
      589   end procedure.
