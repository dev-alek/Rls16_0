     1036   MAIN-BLOCK:
     1037   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1038      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1039       run init-fields in this-procedure.
     1040       RUN enable_UI.
     1041       run ui-enable-all in this-procedure.
     1042       run ui-disable in this-procedure.
     1043     WAIT-FOR GO OF FRAME Dialog-Frame.
     1044   END.
     1045   RUN disable_UI.
     1046   PROCEDURE assign-out-param :
     1047   do
     1048   on error undo, return error
     1049   :
     1050       assign
     1051           p-out-sort-type   = rs-group-type
     1052           p-out-doc-code    = fi-doc-code
     1053           p-out-date-from   = fi-date-from
     1054           p-out-date-to     = fi-date-to
     1055           p-out-level       = fi-level
     1056           p-out-userid      = fi-userid
     1057       .
     1058   end.
     1059   END PROCEDURE.
     1060   PROCEDURE disable_UI :
     1061     HIDE FRAME Dialog-Frame.
     1062   END PROCEDURE.
     1063   PROCEDURE enable_UI :
     1064     DISPLAY rs-group-type fi-level fi-doc-code fi-date-from fi-date-to fi-userid
     1065         WITH FRAME Dialog-Frame.
     1066     ENABLE b-exit b-cancel b-help rs-group-type fi-level fi-doc-code fi-date-from
     1067            fi-date-to fi-userid bt-sel-obj
     1068         WITH FRAME Dialog-Frame.
     1069     VIEW FRAME Dialog-Frame.
     1070   END PROCEDURE.
     1071   PROCEDURE init-fields :
     1072   do
     1073   on error undo, return error
     1074   :
     1075       run cur-time in this-procedure (
     1076             output v-today
     1077           , output v-time
     1078       ).
     1079       assign
     1080           rs-group-type = ( if p-sort-type = 0 then 1 else p-sort-type )
     1081           fi-doc-code   = p-doc-code
     1082           fi-date-from  = ( if p-date-from = ? then v-today else p-date-from )
     1083           fi-date-to    = ( if p-date-to = ?   then v-today else p-date-to   )
     1084           fi-level      = p-level
     1085           fi-userid     = p-userid
     1086       .
     1087   end.
     1088   END PROCEDURE.
     1089   PROCEDURE ui-disable :
     1090   do
     1091   on error undo, return error
     1092   :
     1093       case rs-group-type
     1094       :
     1095           when 1
     1096           then do:
     1097               disable
     1098                   fi-doc-code
     1099                   fi-date-from
     1100                   fi-date-to
     1101                   fi-userid
     1102               with frame Dialog-Frame.
     1103           end.
     1104           when 2
     1105           then do:
     1106               disable
     1107                   fi-date-from
     1108                   fi-date-to
     1109                   fi-level
     1110                   fi-userid
     1111               with frame Dialog-Frame.
     1112           end.
     1113           when 3
     1114           then do:
     1115               disable
     1116                   fi-doc-code
     1117                   fi-userid
     1118               with frame Dialog-Frame.
     1119           end.
     1120           when 4
     1121           then do:
     1122               disable
     1123                   fi-date-from
     1124                   fi-date-to
     1125                   fi-doc-code
     1126               with frame Dialog-Frame.
     1127           end.
     1128       end case.
     1129   end.
     1130   END PROCEDURE.
     1131   PROCEDURE ui-enable-all :
     1132   do
     1133   on error undo, return error
     1134   :
     1135       enable
     1136           rs-group-type
     1137           fi-doc-code
     1138           fi-date-from
     1139           fi-date-to
     1140           fi-level
     1141           fi-userid
     1142       with frame dialog-frame.
     1143   end.
     1144   END PROCEDURE.
