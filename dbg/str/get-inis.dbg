        1   block-level on error undo, throw.
        2   define input parameter p-obj-type like ub.clients.obj-type no-undo .
        3   define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
        4   define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
        5   define input parameter p-remote   like ub.cash-desk.remote  no-undo .
        6   define input parameter p-mode     as character no-undo .
        7   define output parameter out     as character no-undo .
        8   define output parameter out2    as character no-undo .
        9   define output parameter in_     as character no-undo .
       10   define output parameter spl     as character no-undo .
       11   define output parameter sav     as character no-undo .
       12   define output parameter v-remote as character no-undo .
       13   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       14   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       15   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile: get-inis.p $":U .
       17   define variable vss-archive     as character no-undo init "$Archive: str/get-inis.p $":U .
       18   define variable vss-description as character no-undo init "Получение настроек для почты на/с кассы из ini-файла".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define   shared variable g#auto as logical no-undo.
       80   define   shared variable g#news as logical no-undo.
       81   define   shared variable g#oxml as logical no-undo.
       82   define   shared variable g#esys as logical no-undo.
       83   define   shared variable g#news-source-db as integer no-undo.
       84   define   shared variable g#esys-source-esys as integer no-undo.
       85   define   shared variable g#db-num as integer   no-undo .
       86   define   shared variable g#userid as character no-undo .
       87   define   shared variable g#passwd as character no-undo .
       88   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   PROCEDURE verify-ini-entry:
       90   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
       91   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
       92   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
       93   DEFINE INPUT  PARAMETER silence          as logical no-undo.
       94   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
       95   define variable v-mess as character no-undo .
       96   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
       97   if ini-entry-value = ? and ini-key-name begins "spl"
       98   then
       99   get-key-value section ini-section-name key "splall" value ini-entry-value.
      100   if ini-entry-value = ? and ini-key-name begins "sav"
      101   then
      102   get-key-value section ini-section-name key "savall" value ini-entry-value.
      103   if ini-entry-value = ? then do:
      104     assign
      105     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
      106                       , chr(10)
      107                       , ini-section-name
      108                       , ini-key-name
      109                       , error-msg-text).
      110       if not silence then do:
      111         message
      112         v-mess
      113         view-as alert-box ERROR  .
      114         return error.
      115       end.
      116       else do:
      117         return error v-mess.
      118       end.
      119   end.
      120   END PROCEDURE.
      121   PROCEDURE verify-file:
      122   DEFINE INPUT  PARAMETER filename       as character no-undo.
      123   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
      124   DEFINE INPUT  PARAMETER silence        as logical no-undo.
      125   DEFINE OUTPUT PARAMETER found          as logical no-undo.
      126   file-info:file-name = filename.
      127   found = NOT (file-info:full-pathname = ?).
      128   if NOT found  then do:
      129     if not silence then do:
      130       message error-msg-text
      131       view-as alert-box ERROR.
      132       return error.
      133     end.
      134     else return error error-msg-text.
      135   end.
      136   END PROCEDURE.
      137   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      138   procedure alienini-getkey :
      139   define input parameter i-filename as char.
      140   define input parameter i-section as char.
      141   define input parameter i-key as char.
      142   define output parameter o-value as char.
      143   define variable EntryPointer as integer no-undo.
      144   define variable mem1 as memptr no-undo.
      145   define variable mem2 as memptr no-undo.
      146   define variable mem1size as integer no-undo.
      147   define variable mem2size as integer no-undo.
      148   define variable ii       as integer    no-undo.
      149   define variable cbReturnSize  as integer    no-undo.
      150   assign
      151   set-size(mem1)  = 4000
      152   mem1size = 4000.
      153   if i-key = "" then EntryPointer = 0.
      154   else do:
      155     assign
      156     set-size(mem2) = 128
      157     mem2size = 128
      158     EntryPointer = get-pointer-value(mem2)
      159     put-string(mem2, 1) = i-key.
      160   end.
      161   run getprivateprofilestringA
      162                                 (i-section,
      163                                  EntryPointer,
      164                                  "",
      165                                  get-pointer-value(mem1),
      166                                  input mem1size,
      167                                  i-filename,
      168                                  output cbReturnSize).
      169   do ii = 1 to cbReturnSize:
      170     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
      171                  then o-value + ","
      172                  else o-value + chr(get-byte(mem1, ii)).
      173   end.
      174     set-size(mem1) = 0.
      175     set-size(mem2) = 0.
      176   end procedure.
      177   procedure alienini-putkey :
      178   define input parameter i-filename as char.
      179   define input parameter i-section as char.
      180   define input parameter i-key as char.
      181   define input parameter i-value as char.
      182   define variable cbReturnSize as integer.
      183   run writeprivateprofilestringA
      184                                  (i-section,
      185                                   i-key,
      186                                   i-value,
      187                                   i-filename,
      188                                   output cbReturnSize ).
      189   end procedure.
      190   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
      191     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
      192     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
      193     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
      194     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
      195     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
      196     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
      197     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
      198   END PROCEDURE.
      199   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
      200     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
      201     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
      202     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
      203     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
      204     DEFINE RETURN PARAMETER lpszValue    AS LONG.
      205   END PROCEDURE.
      206   define variable v-cd-prfx as character no-undo .
      207   define variable glog as logical no-undo .
      208   define variable BadFlag as logical no-undo .
      209   define variable fq as integer no-undo .
      210   define variable yestr as character no-undo .
      211   define variable out3 as character no-undo .
      212   define variable out4 as character no-undo .
      213   define variable temp-out as character no-undo .
      214   define variable v-value as character no-undo .
      215   CASE p-pos-type:
      216     when 'MAGIA-XML':U then do:
      217       assign
      218       v-cd-prfx = 'magia':U
      219       .
      220     end.
      221     when 'IBM-XML':U then do:
      222       assign
      223       v-cd-prfx = 'IBM-XML':U
      224       .
      225     end.
      226     when 'Emulator-NKT-IBM':U then do:
      227       assign
      228       v-cd-prfx = 'NKT-IBM':U
      229       .
      230     end.
      231     when 'IBM':U then do:
      232       assign
      233       v-cd-prfx = 'IBM':U
      234       .
      235     end.
      236     when 'NCR-GM':U then do:
      237       assign
      238       v-cd-prfx = 'ncr-gm':U
      239       .
      240     end.
      241     when 'NCR-AS@R':U then do:
      242       assign
      243       v-cd-prfx = 'ncr-as-r':U
      244       .
      245     end.
      246     when 'r-keeper':U then do:
      247       assign
      248       v-cd-prfx = 'r-keeper':U
      249       .
      250     end.
      251     when 'InfoKiosk':U then do:
      252       assign
      253       v-cd-prfx = 'infokiosk':U
      254       .
      255     end.
      256     when 'pricecheck-Servis+':U then do:
      257       assign
      258       v-cd-prfx = 'pricecheck-Servis+':U
      259       .
      260     end.
      261     when 'MARIA':U then do:
      262       assign
      263       v-cd-prfx = 'maria':U
      264       .
      265     end.
      266     when 'Autotank':U then do:
      267       assign
      268       v-cd-prfx = 'autotank':U
      269       .
      270     end.
      271   END CASE.
      272   CASE p-pos-type:
      273     when 'MAGIA-XML':U
      274     or
      275     when 'IBM-XML':U
      276     or
      277     when  'IBM':U
      278     or
      279     when  'Emulator-NKT-IBM':U
      280     or
      281     when  'InfoKiosk':U
      282     or
      283     when  'pricecheck-Servis+':U
      284     or
      285     when 'Autotank':U
      286     then do:
      287       run verify-ini-entry in this-procedure (
      288                                               INPUT  'out'
      289                                               ,INPUT  'kassa-' + v-cd-prfx
      290                                               ,INPUT substitute("отсутствует путь к подкаталогу out для отсылки информации на POS &1", p-pos-type)
      291                                               ,INPUT yes
      292                                               ,output out) no-error .
      293       if error-status:error or out = ? then return error return-value .
      294       RUN verify-file in this-procedure
      295                                         ( out
      296                                         , substitute("Не найден каталог &1 параметр out, секция [kassa-&2] ini-файла", out, v-cd-prfx)
      297                                         , yes
      298                                         ,output glog) no-error.
      299       if error-status:error or not glog then return error return-value .
      300         if not
      301         (p-pos-type = 'InfoKiosk':U
      302              or
      303         p-pos-type = 'pricecheck-Servis+':U
      304         )
      305         then do:
      306           run verify-ini-entry in this-procedure (
      307                                                   INPUT  'in'
      308                                                   ,INPUT  'kassa-' + v-cd-prfx
      309                                                   ,INPUT substitute("отсутствует путь к подкаталогу in для приема данных с POS &1", p-pos-type)
      310                                                   ,INPUT yes
      311                                                   ,output in_) no-error .
      312           if error-status:error or in_ = ? then return error return-value .
      313           RUN verify-file in this-procedure
      314                                             ( in_
      315                                             , substitute("Не найден каталог &1 параметр in, секция [kassa-&2] ini-файла", in_, v-cd-prfx)
      316                                             ,yes
      317                                             ,output glog) no-error.
      318           if error-status:error or not glog then return error return-value .
      319         end.
      320         if p-pos-type <> 'InfoKiosk':U and
      321             p-pos-type <> 'pricecheck-Servis+':U
      322             then do:
      323           RUN verify-ini-entry(  input ("spl":U + string( p-obj-code ))
      324                                 ,input substitute("kassa-&1":U, v-cd-prfx)
      325                                 ,input substitute("отсутствует путь к подкаталогу &1 &2 в каталоге &3 &4 для приема данных с POS &6 для магазина с кодом &5"
      326                                                 , "in"
      327                                                 , chr(10)
      328                                                 , in_
      329                                                 , chr(10)
      330                                                 , p-obj-code
      331                                                 , v-cd-prfx)
      332                                 ,input yes
      333                                 ,output spl) no-error.
      334         end.
      335         if p-pos-type <> 'InfoKiosk':U and
      336            p-pos-type <> 'pricecheck-Servis+':U
      337            then do:
      338           if spl = ? or error-status:error then return error return-value .
      339           RUN verify-file(input in_ + spl
      340                           ,input substitute("Не найден подкаталог &1 в директории &2 &3 параметр spl&4, секция [kassa-&5] ini-файла"
      341                                             , spl
      342                                             , in_
      343                                             , chr(10)
      344                                             , p-obj-code
      345                                             , v-cd-prfx)
      346                           ,input yes
      347                           ,output glog) no-error.
      348           if error-status:error or not glog then return error return-value .
      349           RUN verify-ini-entry(  input ("sav":U + string( p-obj-code ))
      350                                 ,input substitute("kassa-&1":U, v-cd-prfx)
      351                                 ,input substitute("отсутствует путь к подкаталогу sav &1 в каталоге &2 &3 для архива принятых данных для магазина с кодом &4 с POS &5", chr(10), in_, chr(10), p-obj-code, v-cd-prfx)
      352                                 ,input yes
      353                                 ,output sav) no-error.
      354           if error-status:error or sav = ? then do:
      355             if p-pos-type = 'MAGIA-XML':U then do:
      356               return error return-value .
      357             end.
      358             else do:
      359               sav = spl.
      360             end.
      361           end.
      362         end.
      363         if p-pos-type = 'MAGIA-XML':U then do:
      364           RUN verify-file(input (in_ + sav)
      365                           ,input substitute("Не найден подкаталог &1 в директории &2 &3 параметр sav&4, секция [kassa-&5] ini-файла",
      366                                     sav, in_, chr(10), p-obj-code, v-cd-prfx)
      367                           ,input yes
      368                           ,output glog) no-error.
      369           if error-status:error or not glog then return error return-value .
      370         end.
      371         if p-mode = "send":U then do:
      372           run str/fileqnty.p ( out, output BadFlag ) .
      373           if not g#news and not g#auto and BadFlag then do:
      374             return error substitute("!!!Количество неотправленных на кассы файлов в каталоге &1 превышает 500 ! "
      375                                     ,out).
      376           end.
      377         end.
      378         if p-pos-type <> 'MAGIA-XML':U
      379         and p-pos-type <> 'InfoKiosk':U
      380         and p-pos-type <> 'pricecheck-Servis+':U
      381         then do:
      382           run verify-ini-entry in this-procedure (
      383                                                   INPUT  'remote'
      384                                                   ,INPUT  'kassa-' + v-cd-prfx
      385                                                   ,INPUT substitute("отсутствует путь к подкаталогу remote для отсылки информации на POS &1", p-pos-type)
      386                                                   ,INPUT yes
      387                                                   ,output v-remote) no-error .
      388           if error-status:error or v-remote = ? then v-remote = out.
      389           else do:
      390             RUN verify-file in this-procedure
      391                                               ( v-remote
      392                                               , substitute("Не найден каталог &1 параметр remote, секция [kassa-&2] ini-файла", v-remote , v-cd-prfx)
      393                                               ,yes
      394                                               ,output glog) no-error.
      395             if error-status:error or not glog then return error return-value .
      396             if p-mode = "send":u then do:
      397               run str/fileqntd.p ( v-remote, "out,tmp":U, output fq, output BadFlag ) .
      398               if not g#news and not g#auto and BadFlag then do:
      399                 return error substitute("!!!Количество неотправленных на кассы файлов в каталоге &1 превышает 500 ! "
      400                                         ,v-remote).
      401               end.
      402             end.
      403           end.
      404         end.
      405     end.
      406     when 'OMRON':U then do:
      407       RUN verify-ini-entry("in":U,
      408                             "kassa-omron":U,
      409                             "отсутствует путь к подкаталогу in" + chr(10) + "для приема чеков с POS OMRON",
      410                             yes,
      411                             output in_) no-error.
      412       if error-status:error or in_ = ? then return error return-value .
      413       RUN verify-file(in_,
      414                       "Не найден каталог " + in_ + chr(10) +
      415                       "параметр in, секция [kassa-omron] ini-файла",
      416                       yes,
      417                       output glog) no-error.
      418       if error-status:error or not glog then return error return-value .
      419       RUN verify-ini-entry("spl":U,
      420                             "kassa-omron":U,
      421                             "отсутствует путь к подкаталогу spl" + chr(10) + "для приема чеков с POS OMRON",
      422                             yes,
      423                             output spl) no-error.
      424       if error-status:error or spl = ? then return error return-value .
      425       RUN verify-file(in_ + spl,
      426                       "Не найден подкаталог t-i" + spl + " в директории " + in_ + chr(10) +
      427                       "параметр spl, секция [kassa-omron] ini-файла",
      428                       yes,
      429                       output glog) no-error.
      430       if error-status:error or not glog then return error return-value .
      431       RUN verify-ini-entry("out":U,
      432                             "kassa-omron":U,
      433                             "отсутствует путь к подкаталогу out" + chr(10) + "для передачи информации на POS OMRON",
      434                             yes,
      435                             output out) no-error.
      436       if error-status:error or out = ? then return error return-value .
      437       RUN verify-file(out,
      438                       "Не найден каталог " + out + chr(10) +
      439                       "параметр out, секция [kassa-omron] ini-файла",
      440                       yes,
      441                       output glog) no-error.
      442       if error-status:error or not glog then return error return-value .
      443     end.
      444     when 'NCR-GM':U
      445     or when 'NCR-AS@R':U
      446     then  do:
      447       assign
      448       out2 = '':U
      449       out3 = '':U
      450       out4 = '':U
      451       .
      452       RUN verify-ini-entry("out":U,
      453                             substitute("kassa-&1":U,  v-cd-prfx),
      454                             "отсутствует путь к подкаталогу out" + chr(10) + "для отсылки информации на POS NCR",
      455                             yes,
      456                             output out) no-error.
      457       if error-status:error or out = ? then return error return-value .
      458       RUN verify-file(out,
      459                       substitute("Не найден каталог &1&2 параметр out, секция [kassa-&3] ini-файла"
      460                                  , out
      461                                  ,chr(10)
      462                                  , v-cd-prfx),
      463                       yes,
      464                       output glog) no-error.
      465       if error-status:error or not glog then return error return-value .
      466       if p-pos-type = 'NCR-AS@R':U then do:
      467         RUN verify-ini-entry("out2":U,
      468                               substitute("kassa-&1":U,  v-cd-prfx),
      469                               "отсутствует путь к подкаталогу out2" + chr(10) + "для отсылки информации на POS NCR",
      470                               yes,
      471                               output out2) no-error.
      472         if error-status:error or out2 = ? then return error return-value .
      473         RUN verify-file(out2,
      474                         substitute("Не найден каталог &1&2 параметр out2, секция [kassa-&3] ini-файла"
      475                                   , out2
      476                                   ,chr(10)
      477                                   , v-cd-prfx),
      478                         yes,
      479                         output glog) no-error.
      480         if error-status:error or not glog then return error return-value .
      481         RUN verify-ini-entry("out3":U,
      482                               substitute("kassa-&1":U,  v-cd-prfx),
      483                               "отсутствует путь к подкаталогу out3" + chr(10) + "для отсылки информации на POS NCR",
      484                               yes,
      485                               output out3) no-error.
      486         if error-status:error or out3 = ? then return error return-value .
      487         RUN verify-file(out3,
      488                         substitute("Не найден каталог &1&2 параметр out3, секция [kassa-&3] ini-файла"
      489                                   , out3
      490                                   ,chr(10)
      491                                   , v-cd-prfx),
      492                         yes,
      493                         output glog) no-error.
      494         if error-status:error or not glog then return error return-value .
      495         assign
      496         out2 = out2 + chr(4) + out3
      497         .
      498       end.
      499       RUN verify-ini-entry("out4":U,
      500                             substitute("kassa-&1":U,  v-cd-prfx),
      501                             "отсутствует путь к подкаталогу out4 (директория p_regpar.dat)" + chr(10) + "для отсылки информации на POS NCR",
      502                             yes,
      503                             output out4) no-error.
      504       if error-status:error or out4 = ? then return error return-value .
      505       RUN verify-file(out4,
      506                       substitute("Не найден каталог &1&2 параметр out4, секция [kassa-&3] ini-файла"
      507                                 , out4
      508                                 ,chr(10)
      509                                 , v-cd-prfx),
      510                       yes,
      511                       output glog) no-error.
      512       if error-status:error or not glog then return error return-value .
      513       assign
      514       out2 = out2 + chr(4) + out3 + chr(4) + out4
      515       .
      516       RUN verify-ini-entry("in":U,
      517                             substitute("kassa-&1", v-cd-prfx),
      518                             "отсутствует путь к подкаталогу in" + chr(10) + "для приема чеков с сервера NCR",
      519                             yes,
      520                             output in_) no-error.
      521       if error-status:error or in_ = ? then return error return-value .
      522       RUN verify-file(in_,
      523                       substitute("Не найден каталог &1&2параметр in, секция [kassa-&3] ini-файла"
      524                                 , in_
      525                                 , chr(10)
      526                                 , v-cd-prfx),
      527                       yes,
      528                       output glog) no-error.
      529       if error-status:error or not glog then return error return-value .
      530       RUN verify-ini-entry("spl":U + string( p-obj-code ),
      531                             substitute("kassa-&1":U,  v-cd-prfx),
      532                             substitute("отсутствует путь к подкаталогу spl&1в каталоге &2&3для приема чеков магазина с кодом &4 с сервера NCR"
      533                                        , chr(10)
      534                                        , in_
      535                                        , chr(10)
      536                                        , p-obj-code
      537                                        ) ,
      538                             yes,
      539                             output spl) no-error.
      540       if spl = ? then spl = "":U.
      541       else do:
      542         RUN verify-file(in_ + spl,
      543                         substitute(
      544                         "Не найден подкаталог &1 в директории &2&3параметр spl&4 секция [kassa-&5] ini-файла"
      545                                    , spl
      546                                    , in_
      547                                    ,  chr(10)
      548                                    , p-obj-code
      549                                    , v-cd-prfx
      550                                    ),
      551                         yes,
      552                         output glog) no-error.
      553         if error-status:error or not glog then return error return-value .
      554       end.
      555       RUN verify-ini-entry("sav":U + string( p-obj-code ),
      556                             substitute("kassa-&1":U, v-cd-prfx),
      557                             "",
      558                             yes,
      559                             output sav) no-error.
      560       if error-status:error or sav = ? then sav = spl.
      561       if sav = ? or sav = "":U then sav = "sav".
      562       yestr = right-trim((in_ + spl), chr(92)) + "\yestr\":U.
      563       RUN verify-file(yestr,
      564                       "Не найден каталог " + yestr + chr(10) +
      565                       "используемый для получения архива чеков предыдущего дня",
      566                       yes,
      567                       output glog) no-error.
      568       if error-status:error then yestr = ?.
      569       assign v-remote = yestr.
      570     end.
      571     when 'r-keeper':U then do:
      572       run verify-ini-entry in this-procedure (
      573                                               INPUT  'out'
      574                                               ,INPUT  'kassa-' + v-cd-prfx
      575                                               ,INPUT substitute("отсутствует путь к подкаталогу out для отсылки информации на POS &1", p-pos-type)
      576                                               ,INPUT yes
      577                                               ,output out) no-error .
      578       if error-status:error or out = ? then return error return-value .
      579       RUN verify-file in this-procedure
      580                                         ( out
      581                                         , substitute("Не найден каталог &1 параметр out, секция [kassa-&2] ini-файла", out, v-cd-prfx)
      582                                         , yes
      583                                         ,output glog) no-error.
      584       if error-status:error or not glog then return error return-value .
      585       run verify-ini-entry in this-procedure (
      586                                               INPUT  'in'
      587                                               ,INPUT  'kassa-' + v-cd-prfx
      588                                               ,INPUT substitute("отсутствует путь к подкаталогу in для приема данных с POS &1", p-pos-type)
      589                                               ,INPUT yes
      590                                               ,output in_) no-error .
      591       if error-status:error or in_ = ? then return error return-value .
      592       RUN verify-file in this-procedure
      593                                         ( in_
      594                                         , substitute("Не найден каталог &1 параметр in, секция [kassa-&2] ini-файла", in_, v-cd-prfx)
      595                                         ,yes
      596                                         ,output glog) no-error.
      597       if error-status:error or not glog then return error return-value .
      598       RUN verify-ini-entry(  input ("spl":U + string( p-obj-code ))
      599                             ,input substitute("kassa-&1":U, v-cd-prfx)
      600                             ,input substitute("отсутствует путь к подкаталогу &1 &2 в каталоге &3 &4 для приема данных с POS &6 для магазина с кодом &5"
      601                                             , "spl"
      602                                             , chr(10)
      603                                             , in_
      604                                             , chr(10)
      605                                             , p-obj-code
      606                                             , v-cd-prfx)
      607                             ,input yes
      608                             ,output spl) no-error.
      609       if error-status:error or spl = ? then return error return-value .
      610       RUN verify-file(input (in_ + spl)
      611                       ,input substitute("Не найден подкаталог &1 в директории &2 &3 параметр spl&4, секция [kassa-&5] ini-файла"
      612                                           , spl
      613                                           , in_
      614                                           , chr(10)
      615                                           , p-obj-code
      616                                           , v-cd-prfx)
      617                       ,input yes
      618                       ,output glog) no-error.
      619       if error-status:error or not glog then return error return-value .
      620       RUN verify-ini-entry(  input ("sav":U + string( p-obj-code ))
      621                             ,input substitute("kassa-&1":U, v-cd-prfx)
      622                             ,input substitute("отсутствует путь к подкаталогу sav &1 в каталоге &2 &3 для архива принятых данных для магазина с кодом &4 с POS &5", chr(10), in_, chr(10), p-obj-code, v-cd-prfx)
      623                             ,input yes
      624                             ,output sav) no-error.
      625       if error-status:error or sav = ? then do:
      626         return error return-value .
      627       end.
      628       if spl = sav then do:
      629         return error substitute("параметр sav&1, секция [kassa-&2] ini-файла - место ХРАНЕНИЯ ОБРАБОТАННЫХ файлов, принятых с касс типа &3 маг&1)&4" +
      630                                 "параметр spl&1, секция [kassa-&2] ini-файла - место ПРИЕМА файлов с касс типа &3 маг&1)&4" +
      631                                 "указывают на одну и ту же директорию &5 - что недопустимо"
      632                                 , p-obj-code
      633                                 , v-cd-prfx
      634                                 , p-pos-type
      635                                 , chr(10)
      636                                 , (in_ + sav)).
      637       end.
      638       if p-mode = "send":U then do:
      639         run str/fileqnty.p ( out, output BadFlag ) .
      640         if not g#news and not g#auto and BadFlag then do:
      641           return error substitute("!!!Количество неотправленных на кассы файлов в каталоге &1 превышает 500 ! "
      642                                   ,out).
      643         end.
      644       end.
      645     end.
      646     when 'MARIA':U then do:
      647       run verify-ini-entry in this-procedure (
      648                                               INPUT  'out'
      649                                               ,INPUT  'kassa-' + v-cd-prfx
      650                                               ,INPUT substitute("отсутствует путь к подкаталогам для отсылки информации на POS &1&2" +
      651                                                                 "(параметр out cекция [kassa-&3] ini файла)"
      652                                                                , p-pos-type
      653                                                                , chr(10)
      654                                                                , v-cd-prfx
      655                                                                )
      656                                               ,INPUT yes
      657                                               ,output out) no-error .
      658       if error-status:error or out = ? then return error return-value .
      659       RUN verify-file in this-procedure
      660                                         ( out
      661                                         , substitute("Не найден каталог &1 для выгрузки информации на POS типа &1"
      662                                                      ,out
      663                                                      ,p-pos-type)
      664                                         , yes
      665                                         ,output glog) no-error.
      666       if error-status:error or not glog then return error return-value .
      667       run verify-ini-entry in this-procedure (
      668                                               INPUT  'in'
      669                                               ,INPUT  'kassa-' + v-cd-prfx
      670                                               ,INPUT substitute("отсутствует путь к подкаталогам для приема информации с POS &1&2" +
      671                                                                 "(параметр in cекция [kassa-&3] ini файла)"
      672                                                                , p-pos-type
      673                                                                , chr(10)
      674                                                                , v-cd-prfx
      675                                                                )
      676                                               ,INPUT yes
      677                                               ,output in_) no-error .
      678       if error-status:error or in_ = ? then return error return-value .
      679       RUN verify-file in this-procedure
      680                                         ( in_
      681                                         , substitute("Не найден каталог &1 для загрузки информации с POS типа &1"
      682                                                      ,in_
      683                                                      ,p-pos-type)
      684                                         , yes
      685                                         ,output glog) no-error.
      686       if error-status:error or not glog then return error return-value .
      687       RUN verify-ini-entry(  input ("spl":U + string( p-obj-code ))
      688                             ,input substitute("kassa-&1":U, v-cd-prfx)
      689                             ,input substitute("отсутствует параметр spl&1&2 секция [kassa-&5] - подкаталог в каталоге &3&2 для приема данных с POS &4 для магазина с кодом &1"
      690                                             , p-obj-code
      691                                             , chr(10)
      692                                             , in_
      693                                             , p-pos-type
      694                                             , v-cd-prfx)
      695                             ,input yes
      696                             ,output spl) no-error.
      697       if spl = ? or error-status:error then return error return-value .
      698       RUN verify-file(input in_ + spl
      699                       ,input substitute("Не найден подкаталог &1 в директории &2&3(параметр spl&4, секция [kassa-&5] ini-файла)"
      700                                         , spl
      701                                         , in_
      702                                         , chr(10)
      703                                         , p-obj-code
      704                                         , v-cd-prfx)
      705                       ,input yes
      706                       ,output glog) no-error.
      707       if error-status:error or not glog then return error return-value .
      708       run verify-ini-entry in this-procedure (
      709                                               INPUT  'addin-dir'
      710                                               ,INPUT  'kassa-' + v-cd-prfx
      711                                               ,INPUT substitute("отсутствует путь к каталогу OLE-сервера Addin.exe для обмена информацией с POS &1&2" +
      712                                                                 "(параметр addin-dir cекция [kassa-&3] ini файла)"
      713                                                                , p-pos-type
      714                                                                , chr(10)
      715                                                                , v-cd-prfx
      716                                                                )
      717                                               ,INPUT yes
      718                                               ,output v-remote) no-error .
      719       if v-remote = ? or error-status:error then return error return-value .
      720       RUN verify-file in this-procedure
      721                                         ( out
      722                                         , substitute("Не найден каталог &1 OLE-сервера AddIn.exe для обмена с POS типа &1"
      723                                                      ,v-remote
      724                                                      ,p-pos-type)
      725                                         , yes
      726                                         ,output glog) no-error.
      727       if error-status:error or not glog then return error return-value .
      728       RUN verify-ini-entry(  input ("sav":U + string( p-obj-code ))
      729                             ,input substitute("kassa-&1":U, v-cd-prfx)
      730                             ,input substitute("отсутствует путь к подкаталогу sav &1 в каталоге &2 &3 для архива принятых данных для магазина с кодом &4 с POS &5"
      731                                             , chr(10)
      732                                             , in_
      733                                             , chr(10)
      734                                             , p-obj-code
      735                                             , v-cd-prfx)
      736                             ,input yes
      737                             ,output sav) no-error.
      738       if error-status:error or sav = ? then return error return-value .
      739     end.
      740   END CASE.
