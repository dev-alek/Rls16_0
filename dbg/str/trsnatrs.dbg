      919   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      920   procedure minbtn-set :
      921       do
      922           on error undo, return error return-value
      923           :
      924           define variable ii              as integer       no-undo .
      925           define variable fh              as widget-handle no-undo .
      926           define variable hh              as widget-handle no-undo .
      927           define variable v-h             as handle        extent 4 no-undo .
      928           define variable v-name-button   as character     no-undo .
      929           define variable v-help-old-x    as decimal       no-undo .
      930           define variable v-help-old-y    as decimal       no-undo .
      931           define variable v-help-old-size as decimal       no-undo .
      932           define variable v-frame-width   as decimal       no-undo .
      933           define variable jj              as integer       no-undo .
      934           do
      935               on error undo, return error
      936               :
      937               assign
      938                   v-frame-width = frame fr-D-rsnattr-0:width - 0.3
      939                   fh            = frame fr-D-rsnattr-0:first-child
      940                   hh            = fh:first-child
      941                   ii            = 1
      942                   .
      943               do while valid-handle(hh):
      944                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      945                   do:
      946                       case lc(hh:name) :
      947                           when "b-help" then
      948                               do:
      949                                   hh:load-image-up("cmp/b-help.bmp":u) .
      950                                   hh:load-image-down("cmp/b-help.bmp":u) .
      951                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      952                                   hh:TOOLTIP = "Помощь" .
      953                                   v-help-old-x = hh:column .
      954                                   v-help-old-y = hh:row    .
      955                                   v-help-old-size = hh:width .
      956                                   hh:width-chars = 2.5 .
      957                               end.
      958                           when "b-print" then
      959                               do:
      960                                   hh:load-image("cmp/b-print.bmp":u) .
      961                                   hh:TOOLTIP = "Печать" .
      962                                   v-h[ii] = hh:handle .
      963                                   ii = ii + 1 .
      964                                   hh:width-chars = 3 .
      965                               end.
      966                           when "b-history" or
      967                           when "b-hist" then
      968                               do:
      969                                   hh:load-image("cmp/b-hist.bmp":u) .
      970                                   hh:TOOLTIP = "История" .
      971                                   v-h[ii] = hh:handle .
      972                                   ii = ii + 1 .
      973                                   hh:width-chars = 3 .
      974                               end.
      975                           when "b-sch" then
      976                               do:
      977                                   hh:load-image("cmp/b-sch.bmp":u) .
      978                                   hh:TOOLTIP = "Установка Фильтра" .
      979                                   v-h[ii] = hh:handle .
      980                                   ii = ii + 1 .
      981                                   hh:width-chars = 3 .
      982                               end.
      983                           when "b-hist-user" then
      984                               do:
      985                                   hh:load-image("cmp/b-hist.bmp":u) .
      986                                   hh:TOOLTIP = "История пользователя" .
      987                                   ii = ii + 1 .
      988                               end.
      989                       end case.
      990                   end.
      991                   hh = hh:next-sibling.
      992               end.
      993               b-help:column = v-frame-width - b-help:width-chars.
      994               jj = 0.
      995               repeat ii = 4 to 1 by -1 :
      996                   if valid-handle (v-h[ii] ) then
      997                   do:
      998                       jj  = jj + 1 .
      999                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1000                       v-h[ii]:row    = v-help-old-y .
     1001                   end.
     1002               end.
     1003           end.
     1004       end.
     1005   end procedure.
     1006   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1007   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1008   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1009   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1010   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1011   define variable v-diasize-current-frame-height as decimal   no-undo .
     1012   define variable v-diasize-change-size          as logical   no-undo .
     1013   define variable v-diasize-resize-button        as handle    no-undo .
     1014   define variable v-diasize-wndmax               as logical   no-undo .
     1015   define variable v-diasize-wndstore             as logical   no-undo .
     1016   define variable v-diasize-proc-name            as character no-undo .
     1017   define variable v-diasize-browse-handle        as handle    no-undo .
     1018   define variable v-diasize-browse-number        as integer   no-undo .
     1019   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1020   define temp-table temp-diasize-handle no-undo
     1021     field handle-value  as handle
     1022     field save-position as decimal
     1023     index xpk is primary unique handle-value
     1024     .
     1025   define temp-table temp-browse-handle no-undo
     1026     field browse-type   as character
     1027     field browse-number as integer
     1028     field browse-handle as handle
     1029     field original-size as decimal
     1030     index xpk is primary unique browse-type browse-number
     1031     index xie browse-type browse-handle
     1032   .
     1033   procedure diasize_change-height :
     1034     define input  parameter p-change-value  as decimal   no-undo .
     1035     define input  parameter p-move-resize   as logical   no-undo .
     1036     define variable v-field-group-handle    as handle    no-undo .
     1037     define variable v-object-handle         as handle    no-undo .
     1038     define variable v-frame-height          as decimal   no-undo .
     1039     define variable v-frame-virtual-height  as decimal   no-undo .
     1040     define variable v-browse-height         as decimal   no-undo .
     1041     define variable v-window-height         as decimal   no-undo .
     1042     define variable v-window-virtual-height as decimal   no-undo .
     1043     define variable v-change-sign           as integer   no-undo .
     1044     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1045     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1046     if p-change-value > 0
     1047     then do:
     1048       if frame fr-D-rsnattr-0 :height + p-change-value
     1049           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1050       then do:
     1051         assign
     1052           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1053                           - (frame fr-D-rsnattr-0 :height-chars)
     1054         .
     1055         if p-change-value <= 0
     1056         then do:
     1057           run diasize_position-resize-button in this-procedure .
     1058           return .
     1059         end.
     1060       end.
     1061     end.
     1062     if p-change-value < 0
     1063     then do:
     1064       if frame fr-D-rsnattr-0 :height + p-change-value < v-diasize-orig-frame-height
     1065       then do:
     1066         assign
     1067           p-change-value = v-diasize-orig-frame-height
     1068                          - (frame fr-D-rsnattr-0 :height-chars)
     1069         .
     1070         if p-change-value >= 0
     1071         then do:
     1072           run diasize_position-resize-button in this-procedure .
     1073           return .
     1074         end.
     1075       end.
     1076     end.
     1077     if p-change-value >= 0
     1078     then do:
     1079       assign
     1080         v-change-sign = 1
     1081       .
     1082     end.
     1083     else do:
     1084       assign
     1085         v-change-sign = -1
     1086       .
     1087     end.
     1088     assign
     1089       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1090     .
     1091     if p-change-value = 0
     1092     then do:
     1093       run diasize_position-resize-button in this-procedure .
     1094       return .
     1095     end.
     1096     move_block:
     1097     do
     1098     on error undo move_block, retry move_block
     1099     :
     1100       if retry
     1101       then do:
     1102         do
     1103         on error undo move_block, leave move_block
     1104         :
     1105           if p-change-value > 0
     1106           then do:
     1107             for each buf_temp-diasize-handle
     1108             on error undo, next
     1109             :
     1110               assign
     1111                 v-object-handle = buf_temp-diasize-handle.handle-value
     1112               .
     1113               if v-object-handle <> v-diasize-resize-button
     1114               then do:
     1115                 assign
     1116                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1117                 .
     1118               end.
     1119             end.
     1120             assign
     1121               v-diasize-browse-handle :height = v-browse-height
     1122             .
     1123             for each buf_temp-browse-handle
     1124               where buf_temp-browse-handle.browse-type = 'height':u
     1125             on error undo, next
     1126             :
     1127               assign
     1128                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1129               .
     1130             end.
     1131             assign
     1132               frame fr-D-rsnattr-0 :height = v-frame-height
     1133             .
     1134             if frame fr-D-rsnattr-0 :scrollable = true
     1135             then do:
     1136               assign
     1137                 frame fr-D-rsnattr-0 :virtual-height = v-frame-virtual-height
     1138               .
     1139             end.
     1140             run diasize_position-resize-button in this-procedure .
     1141           end.
     1142           else do:
     1143             if frame fr-D-rsnattr-0 :scrollable = true
     1144             then do:
     1145               assign
     1146                 frame fr-D-rsnattr-0 :virtual-height = v-frame-virtual-height
     1147               .
     1148             end.
     1149             assign
     1150               frame fr-D-rsnattr-0 :height = v-frame-height
     1151             .
     1152             assign
     1153               v-diasize-browse-handle :height = v-browse-height
     1154             .
     1155             for each buf_temp-browse-handle
     1156               where buf_temp-browse-handle.browse-type = 'height':u
     1157             on error undo, next
     1158             :
     1159               assign
     1160                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1161               .
     1162             end.
     1163             for each buf_temp-diasize-handle
     1164             on error undo, next
     1165             :
     1166               assign
     1167                 v-object-handle = buf_temp-diasize-handle.handle-value
     1168               .
     1169               if v-object-handle <> v-diasize-resize-button
     1170               then do:
     1171                 assign
     1172                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1173                 .
     1174               end.
     1175             end.
     1176             run diasize_position-resize-button in this-procedure .
     1177           end.
     1178           assign
     1179             v-diasize-change-size = false
     1180           .
     1181           leave move_block .
     1182         end.
     1183       end.
     1184       assign
     1185         v-diasize-need-full-display = true
     1186       .
     1187       if v-diasize-change-size = false
     1188       then do:
     1189         assign
     1190           v-diasize-change-size = true
     1191         .
     1192       end.
     1193       else do:
     1194         return .
     1195       end.
     1196       assign
     1197         v-frame-height = frame fr-D-rsnattr-0 :height
     1198         v-frame-virtual-height = frame fr-D-rsnattr-0 :virtual-height
     1199         v-browse-height = v-diasize-browse-handle :height
     1200       .
     1201       for each buf_temp-browse-handle
     1202         where buf_temp-browse-handle.browse-type = 'height':u
     1203       :
     1204         assign
     1205           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1206         .
     1207       end.
     1208       for each buf_temp-diasize-handle
     1209       :
     1210         delete buf_temp-diasize-handle .
     1211       end.
     1212       assign
     1213         v-field-group-handle = frame fr-D-rsnattr-0 :first-child
     1214       .
     1215       do while valid-handle(v-field-group-handle)
     1216       :
     1217         assign
     1218           v-object-handle = v-field-group-handle :first-child
     1219         .
     1220         do while valid-handle(v-object-handle)
     1221         :
     1222           if  v-object-handle <> v-diasize-browse-handle :handle
     1223           and can-query(v-object-handle, "row")
     1224           and can-query(v-object-handle, "height")
     1225           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1226           then do:
     1227             find first buf_temp-browse-handle
     1228               where buf_temp-browse-handle.browse-type   = 'height':u
     1229                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1230               no-error .
     1231             if available buf_temp-browse-handle
     1232             then do:
     1233             end.
     1234             else do:
     1235               create buf_temp-diasize-handle .
     1236               assign
     1237                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1238                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1239               .
     1240             end.
     1241           end.
     1242           assign
     1243             v-object-handle = v-object-handle :next-sibling
     1244           .
     1245         end.
     1246         assign
     1247           v-field-group-handle = v-field-group-handle :next-sibling
     1248         .
     1249       end.
     1250       do with frame fr-D-rsnattr-0
     1251       :
     1252         hide v-diasize-resize-button .
     1253         assign
     1254           v-diasize-resize-button :row    = 1
     1255           v-diasize-resize-button :column = 1
     1256         .
     1257       end.
     1258       if p-change-value > 0
     1259       then do:
     1260         if frame fr-D-rsnattr-0 :scrollable = true
     1261         then do:
     1262           assign
     1263             frame fr-D-rsnattr-0 :virtual-height = frame fr-D-rsnattr-0 :virtual-height + p-change-value
     1264             no-error .
     1265           if error-status :error
     1266           or error-status :get-message(1) <> ""
     1267           then do:
     1268             undo move_block, retry move_block .
     1269           end.
     1270         end.
     1271         assign
     1272           frame fr-D-rsnattr-0 :height = frame fr-D-rsnattr-0 :height + p-change-value
     1273           no-error .
     1274         if error-status :error
     1275         or error-status :get-message(1) <> ""
     1276         then do:
     1277           undo move_block, retry move_block .
     1278         end.
     1279         assign
     1280           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1281           no-error .
     1282         if error-status :error
     1283         or error-status :get-message(1) <> ""
     1284         then do:
     1285           undo move_block, retry move_block .
     1286         end.
     1287         for each buf_temp-browse-handle
     1288           where buf_temp-browse-handle.browse-type = 'height':u
     1289         on error undo move_block, retry move_block
     1290         :
     1291           assign
     1292             buf_temp-browse-handle.browse-handle :height
     1293               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1294             no-error .
     1295           if error-status :error
     1296           or error-status :get-message(1) <> ""
     1297           then do:
     1298             undo move_block, retry move_block .
     1299           end.
     1300         end.
     1301         for each buf_temp-diasize-handle
     1302         on error undo move_block, retry move_block
     1303         :
     1304           assign
     1305             v-object-handle = buf_temp-diasize-handle.handle-value
     1306           .
     1307           if v-object-handle <> v-diasize-resize-button
     1308           then do:
     1309             assign
     1310               v-object-handle :row = v-object-handle :row + p-change-value
     1311               no-error .
     1312             if error-status :error
     1313             or error-status :get-message(1) <> ""
     1314             then do:
     1315               undo move_block, retry move_block .
     1316             end.
     1317           end.
     1318         end.
     1319       end.
     1320       else do:
     1321         for each buf_temp-diasize-handle
     1322         on error undo move_block, retry move_block
     1323         :
     1324           assign
     1325             v-object-handle = buf_temp-diasize-handle.handle-value
     1326           .
     1327           if v-object-handle <> v-diasize-resize-button
     1328           then do:
     1329             assign
     1330               v-object-handle :row = v-object-handle :row + p-change-value
     1331               no-error .
     1332             if error-status :error
     1333             or error-status :get-message(1) <> ""
     1334             then do:
     1335               undo move_block, retry move_block .
     1336             end.
     1337           end.
     1338         end.
     1339         assign
     1340           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1341           no-error .
     1342         if error-status :error
     1343         or error-status :get-message(1) <> ""
     1344         then do:
     1345           undo move_block, retry move_block .
     1346         end.
     1347         for each buf_temp-browse-handle
     1348           where buf_temp-browse-handle.browse-type = 'height':u
     1349         on error undo move_block, retry move_block
     1350         :
     1351           assign
     1352             buf_temp-browse-handle.browse-handle :height
     1353               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1354             no-error .
     1355           if error-status :error
     1356           or error-status :get-message(1) <> ""
     1357           then do:
     1358             undo move_block, retry move_block .
     1359           end.
     1360         end.
     1361         assign
     1362           frame fr-D-rsnattr-0 :height = frame fr-D-rsnattr-0 :height + p-change-value
     1363           no-error .
     1364         if error-status :error
     1365         or error-status :get-message(1) <> ""
     1366         then do:
     1367           undo move_block, retry move_block .
     1368         end.
     1369         if frame fr-D-rsnattr-0 :scrollable = true
     1370         then do:
     1371           assign
     1372             frame fr-D-rsnattr-0 :virtual-height = frame fr-D-rsnattr-0 :virtual-height + p-change-value
     1373             no-error .
     1374           if error-status :error
     1375           or error-status :get-message(1) <> ""
     1376           then do:
     1377             undo move_block, retry move_block .
     1378           end.
     1379         end.
     1380       end.
     1381       if p-move-resize = true
     1382       then do:
     1383         run diasize_position-resize-button in this-procedure .
     1384       end.
     1385       if v-diasize-wndstore = true
     1386       then do:
     1387         if connected("ub") = true
     1388         then do:
     1389           define variable v-cntxt-db-num        as integer   no-undo .
     1390           define variable v-cntxt-userid        as character no-undo .
     1391           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1392                                             , OUTPUT v-cntxt-userid
     1393                                             ) .
     1394           run gbl/wndsizew.p
     1395             (input  v-cntxt-db-num
     1396             ,input  v-cntxt-userid
     1397             ,input  v-diasize-proc-name
     1398             ,input  'height':u
     1399             ,input  string(frame fr-D-rsnattr-0 :height - v-diasize-orig-frame-height)
     1400             ) .
     1401         end.
     1402       end.
     1403     end.
     1404     assign
     1405       v-diasize-change-size = false
     1406     .
     1407   end procedure.
     1408   procedure diasize_set-height :
     1409     define input  parameter p-new-height  as decimal   no-undo .
     1410     define input  parameter p-move-resize as logical   no-undo .
     1411     do
     1412     on error undo, return error return-value
     1413     :
     1414       run diasize_change-height in this-procedure
     1415         (input  (p-new-height - frame fr-D-rsnattr-0 :height)
     1416         ,input  p-move-resize
     1417         ) .
     1418     end.
     1419   end procedure.
     1420   procedure diasize_change-width :
     1421     define input  parameter p-change-value as decimal   no-undo .
     1422     define input  parameter p-move-resize  as logical   no-undo .
     1423     define variable v-field-group-handle   as handle    no-undo .
     1424     define variable v-object-handle        as handle    no-undo .
     1425     define variable v-frame-width          as decimal   no-undo .
     1426     define variable v-frame-virtual-width  as decimal   no-undo .
     1427     define variable v-browse-width         as decimal   no-undo .
     1428     define variable v-window-width         as decimal   no-undo .
     1429     define variable v-window-virtual-width as decimal   no-undo .
     1430     define variable v-change-sign          as integer   no-undo .
     1431     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1432     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1433     if p-change-value > 0
     1434     then do:
     1435       if frame fr-D-rsnattr-0 :width + p-change-value >
     1436           session :width-chars
     1437       then do:
     1438         assign
     1439           p-change-value = session :width-chars - frame fr-D-rsnattr-0 :width
     1440         .
     1441         if p-change-value <= 0
     1442         then do:
     1443           run diasize_position-resize-button in this-procedure .
     1444           return .
     1445         end.
     1446       end.
     1447     end.
     1448     if p-change-value < 0
     1449     then do:
     1450       if frame fr-D-rsnattr-0 :width + p-change-value < v-diasize-orig-frame-width
     1451       then do:
     1452         assign
     1453           p-change-value = v-diasize-orig-frame-width
     1454                          - frame fr-D-rsnattr-0 :width
     1455         .
     1456         if p-change-value >= 0
     1457         then do:
     1458           run diasize_position-resize-button in this-procedure .
     1459           return .
     1460         end.
     1461       end.
     1462     end.
     1463     if p-change-value >= 0
     1464     then do:
     1465       assign
     1466         v-change-sign = 1
     1467       .
     1468     end.
     1469     else do:
     1470       assign
     1471         v-change-sign = -1
     1472       .
     1473     end.
     1474     assign
     1475       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1476     .
     1477     if p-change-value = 0
     1478     then do:
     1479       run diasize_position-resize-button in this-procedure .
     1480       return .
     1481     end.
     1482     move_block:
     1483     do
     1484     on error undo move_block, leave move_block
     1485     :
     1486       if retry
     1487       then do:
     1488         do
     1489         on error undo move_block, leave move_block
     1490         :
     1491           if p-change-value > 0
     1492           then do:
     1493             for each buf_temp-diasize-handle
     1494             on error undo, next
     1495             :
     1496               assign
     1497                 v-object-handle = buf_temp-diasize-handle.handle-value
     1498               .
     1499               if v-object-handle <> v-diasize-resize-button
     1500               then do:
     1501                 assign
     1502                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1503                 .
     1504               end.
     1505             end.
     1506             assign
     1507               v-diasize-browse-handle :width = v-browse-width
     1508             .
     1509             for each buf_temp-browse-handle
     1510               where buf_temp-browse-handle.browse-type = 'width':u
     1511             on error undo, next
     1512             :
     1513               assign
     1514                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1515               .
     1516             end.
     1517             assign
     1518               frame fr-D-rsnattr-0 :width = v-frame-width
     1519             .
     1520             if frame fr-D-rsnattr-0 :scrollable = true
     1521             then do:
     1522               assign
     1523                 frame fr-D-rsnattr-0 :virtual-width = v-frame-virtual-width
     1524               .
     1525             end.
     1526             run diasize_position-resize-button in this-procedure .
     1527           end.
     1528           else do:
     1529             if frame fr-D-rsnattr-0 :scrollable = true
     1530             then do:
     1531               assign
     1532                 frame fr-D-rsnattr-0 :virtual-width = v-frame-virtual-width
     1533               .
     1534             end.
     1535             assign
     1536               frame fr-D-rsnattr-0 :width = v-frame-width
     1537             .
     1538             for each buf_temp-browse-handle
     1539               where buf_temp-browse-handle.browse-type = 'width':u
     1540             on error undo, next
     1541             :
     1542               assign
     1543                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1544               .
     1545             end.
     1546             assign
     1547               v-diasize-browse-handle :width = v-browse-width
     1548             .
     1549             for each buf_temp-diasize-handle
     1550             on error undo, next
     1551             :
     1552               assign
     1553                 v-object-handle = buf_temp-diasize-handle.handle-value
     1554               .
     1555               if v-object-handle <> v-diasize-resize-button
     1556               then do:
     1557                 assign
     1558                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1559                 .
     1560               end.
     1561             end.
     1562             run diasize_position-resize-button in this-procedure .
     1563           end.
     1564           assign
     1565             v-diasize-change-size = false
     1566           .
     1567           leave move_block .
     1568         end.
     1569       end.
     1570       assign
     1571         v-diasize-need-full-display = true
     1572       .
     1573       if v-diasize-change-size = false
     1574       then do:
     1575         assign
     1576           v-diasize-change-size = true
     1577         .
     1578       end.
     1579       else do:
     1580         return .
     1581       end.
     1582       assign
     1583         v-frame-width = frame fr-D-rsnattr-0 :width
     1584         v-frame-virtual-width = frame fr-D-rsnattr-0 :virtual-width
     1585         v-browse-width = v-diasize-browse-handle :width
     1586       .
     1587       for each buf_temp-browse-handle
     1588         where buf_temp-browse-handle.browse-type = 'width':u
     1589       :
     1590         assign
     1591           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1592         .
     1593       end.
     1594       for each buf_temp-diasize-handle
     1595       :
     1596         delete buf_temp-diasize-handle .
     1597       end.
     1598       assign
     1599         v-field-group-handle = frame fr-D-rsnattr-0 :first-child
     1600       .
     1601       do while valid-handle(v-field-group-handle)
     1602       :
     1603         assign
     1604           v-object-handle = v-field-group-handle :first-child
     1605         .
     1606         do while valid-handle(v-object-handle)
     1607         :
     1608           if  v-object-handle <> v-diasize-browse-handle :handle
     1609           and v-object-handle <> v-diasize-resize-button
     1610           and can-query(v-object-handle, "row")
     1611           and can-query(v-object-handle, "height")
     1612           and ( v-object-handle :col + v-object-handle :width
     1613                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1614               )
     1615           then do:
     1616             find first buf_temp-browse-handle
     1617               where buf_temp-browse-handle.browse-type   = 'width':u
     1618                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1619               no-error .
     1620             if available buf_temp-browse-handle
     1621             then do:
     1622             end.
     1623             else do:
     1624               create buf_temp-diasize-handle .
     1625               assign
     1626                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1627                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1628               .
     1629             end.
     1630           end.
     1631           assign
     1632             v-object-handle = v-object-handle :next-sibling
     1633           .
     1634         end.
     1635         assign
     1636           v-field-group-handle = v-field-group-handle :next-sibling
     1637         .
     1638       end.
     1639       do with frame fr-D-rsnattr-0
     1640       :
     1641         hide v-diasize-resize-button .
     1642         v-diasize-resize-button :row = 1.
     1643         v-diasize-resize-button :column = 1.
     1644       end.
     1645       if p-change-value > 0
     1646       then do:
     1647         if frame fr-D-rsnattr-0 :scrollable = true
     1648         then do:
     1649           assign
     1650             frame fr-D-rsnattr-0 :virtual-width = frame fr-D-rsnattr-0 :virtual-width + p-change-value
     1651             no-error .
     1652           if error-status :error
     1653           or error-status :get-message(1) <> ""
     1654           then do:
     1655             undo move_block, retry move_block.
     1656           end.
     1657         end.
     1658         assign
     1659           frame fr-D-rsnattr-0 :width = v-frame-width + p-change-value
     1660           no-error .
     1661         if error-status :error
     1662         or error-status :get-message(1) <> ""
     1663         then do:
     1664           undo move_block, retry move_block.
     1665         end.
     1666         assign
     1667           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1668         no-error .
     1669         if error-status :error
     1670         or error-status :get-message(1) <> ""
     1671         then do:
     1672           undo move_block, retry move_block.
     1673         end.
     1674         for each buf_temp-browse-handle
     1675           where buf_temp-browse-handle.browse-type = 'width':u
     1676         on error undo move_block, retry move_block
     1677         :
     1678           assign
     1679             buf_temp-browse-handle.browse-handle :width
     1680               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1681             no-error .
     1682           if error-status :error
     1683           or error-status :get-message(1) <> ""
     1684           then do:
     1685             undo move_block, retry move_block .
     1686           end.
     1687         end.
     1688         for each buf_temp-diasize-handle
     1689         on error undo move_block, retry move_block
     1690         :
     1691           assign
     1692             v-object-handle = buf_temp-diasize-handle.handle-value
     1693           .
     1694           if v-object-handle <> v-diasize-resize-button
     1695           then do:
     1696             assign
     1697               v-object-handle :col = v-object-handle :col + p-change-value
     1698               no-error .
     1699             if error-status :error
     1700             or error-status :get-message(1) <> ""
     1701             then do:
     1702               undo move_block, retry move_block .
     1703             end.
     1704           end.
     1705         end.
     1706       end.
     1707       else do:
     1708         for each buf_temp-diasize-handle
     1709         on error undo move_block, retry move_block
     1710         :
     1711           assign
     1712             v-object-handle = buf_temp-diasize-handle.handle-value
     1713           .
     1714           if v-object-handle <> v-diasize-resize-button
     1715           then do:
     1716             assign
     1717               v-object-handle :col = v-object-handle :col + p-change-value
     1718               no-error .
     1719             if error-status :error
     1720             or error-status :get-message(1) <> ""
     1721             then do:
     1722               undo move_block, retry move_block .
     1723             end.
     1724           end.
     1725         end.
     1726         for each buf_temp-browse-handle
     1727           where buf_temp-browse-handle.browse-type = 'width':u
     1728         on error undo move_block, retry move_block
     1729         :
     1730           assign
     1731             buf_temp-browse-handle.browse-handle :width
     1732               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1733             no-error .
     1734           if error-status :error
     1735           or error-status :get-message(1) <> ""
     1736           then do:
     1737             undo move_block, retry move_block .
     1738           end.
     1739         end.
     1740         assign
     1741           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1742           no-error .
     1743         if error-status :error
     1744         or error-status :get-message(1) <> ""
     1745         then do:
     1746           undo move_block, retry move_block.
     1747         end.
     1748         assign
     1749           frame fr-D-rsnattr-0 :width = frame fr-D-rsnattr-0 :width + p-change-value
     1750         no-error .
     1751         if error-status :error
     1752         or error-status :get-message(1) <> ""
     1753         then do:
     1754           undo move_block, retry move_block.
     1755         end.
     1756         if frame fr-D-rsnattr-0 :scrollable = true
     1757         then do:
     1758           assign
     1759             frame fr-D-rsnattr-0 :virtual-width = frame fr-D-rsnattr-0 :virtual-width + p-change-value
     1760           no-error .
     1761           if error-status :error
     1762           or error-status :get-message(1) <> ""
     1763           then do:
     1764             undo move_block, retry move_block.
     1765           end.
     1766         end.
     1767       end.
     1768       if p-move-resize
     1769       then do:
     1770         run diasize_position-resize-button in this-procedure .
     1771       end.
     1772       if v-diasize-wndstore = true
     1773       then do:
     1774         if connected("ub") = true
     1775         then do:
     1776           define variable v-cntxt-db-num        as integer   no-undo .
     1777           define variable v-cntxt-userid        as character no-undo .
     1778           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1779                                             , OUTPUT v-cntxt-userid
     1780                                             ) .
     1781           run gbl/wndsizew.p
     1782             (input  v-cntxt-db-num
     1783             ,input  v-cntxt-userid
     1784             ,input  v-diasize-proc-name
     1785             ,input  'width':u
     1786             ,input  string(frame fr-D-rsnattr-0 :width - v-diasize-orig-frame-width)
     1787             ) .
     1788         end.
     1789       end.
     1790     end.
     1791     assign
     1792       v-diasize-change-size = false
     1793     .
     1794   end procedure.
     1795   procedure diasize_set-width :
     1796     define input  parameter p-new-width  as decimal   no-undo .
     1797     define input  parameter p-move-resize as logical   no-undo .
     1798     do
     1799     on error undo, return error return-value
     1800     :
     1801       run diasize_change-width in this-procedure
     1802         (input  (p-new-width - frame fr-D-rsnattr-0 :width)
     1803         ,input  p-move-resize
     1804         ) .
     1805     end.
     1806   end procedure.
     1807   procedure diasize_position-resize-button :
     1808     do with frame fr-D-rsnattr-0
     1809     :
     1810       hide v-diasize-resize-button .
     1811       assign
     1812         v-diasize-resize-button :row = frame fr-D-rsnattr-0 :height - v-diasize-resize-button :height
     1813                     - 1
     1814                     - (frame fr-D-rsnattr-0 :border-bottom-pixels / session :pixels-per-row)
     1815         v-diasize-resize-button :col = frame fr-D-rsnattr-0 :width - v-diasize-resize-button :width
     1816                     - 1
     1817                     - (frame fr-D-rsnattr-0 :border-right-pixels / session :pixels-per-column)
     1818       .
     1819       view v-diasize-resize-button .
     1820     end.
     1821   end procedure.
     1822   on alt-right anywhere
     1823   do:
     1824     run diasize_change-width in this-procedure
     1825       (input 1
     1826       ,input true
     1827       ) .
     1828     return no-apply .
     1829   end.
     1830   on alt-left anywhere
     1831   do:
     1832     run diasize_change-width in this-procedure
     1833       (input -1
     1834       ,input true
     1835       ) .
     1836     return no-apply .
     1837   end.
     1838   on alt-down anywhere
     1839   do:
     1840     run diasize_change-height in this-procedure
     1841       (input 1
     1842       ,input true
     1843       ) .
     1844     return no-apply .
     1845   end.
     1846   on alt-up anywhere
     1847   do:
     1848     run diasize_change-height in this-procedure
     1849       (input -1
     1850       ,input true
     1851       ) .
     1852     return no-apply .
     1853   end.
     1854   on alt-enter of frame fr-D-rsnattr-0
     1855   do:
     1856     run diasize_maximize in this-procedure
     1857       (input  ?
     1858       ).
     1859     return no-apply .
     1860   end.
     1861   procedure diasize_end-move :
     1862     do
     1863     on error undo, return error return-value
     1864     :
     1865       define variable v-row-delta as decimal   no-undo .
     1866       define variable v-col-delta as decimal   no-undo .
     1867       define variable v-new-row as decimal   no-undo .
     1868       define variable v-new-col as decimal   no-undo .
     1869       assign
     1870         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1871         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1872       .
     1873       assign
     1874         v-row-delta = v-new-row - frame fr-D-rsnattr-0 :height
     1875         v-col-delta = v-new-col - frame fr-D-rsnattr-0 :width
     1876       .
     1877       run diasize_change-height in this-procedure
     1878         (input v-row-delta
     1879         ,input true
     1880         ) .
     1881       run diasize_change-width in this-procedure
     1882         (input v-col-delta
     1883         ,input true
     1884         ) .
     1885     end.
     1886   end procedure.
     1887   procedure diasize_maximize :
     1888     define input  parameter p-action as logical   no-undo .
     1889     do
     1890     on error undo, return error return-value
     1891     :
     1892       if p-action = ?
     1893       then do:
     1894         if v-diasize-need-maximize = true
     1895         then do:
     1896           assign
     1897             p-action = true
     1898           .
     1899         end.
     1900         else do:
     1901           assign
     1902             p-action = false
     1903           .
     1904         end.
     1905       end.
     1906       if p-action = true
     1907       then do:
     1908         run diasize_change-height in this-procedure
     1909           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1910               - frame fr-D-rsnattr-0 :height-chars
     1911           ,input true
     1912           ) .
     1913         run diasize_change-width in this-procedure
     1914           (input session :width-chars
     1915               - frame fr-D-rsnattr-0 :width-chars
     1916           ,input true
     1917           ) .
     1918         assign
     1919           v-diasize-need-maximize = false
     1920         .
     1921       end.
     1922       else do:
     1923         run diasize_change-width in this-procedure
     1924           (input v-diasize-orig-frame-width
     1925               - frame fr-D-rsnattr-0 :width-chars
     1926           ,input true
     1927           ) .
     1928         run diasize_change-height in this-procedure
     1929           (input v-diasize-orig-frame-height
     1930               - frame fr-D-rsnattr-0 :height-chars
     1931           ,input true
     1932           ) .
     1933         assign
     1934           v-diasize-need-maximize = true
     1935         .
     1936       end.
     1937     end.
     1938   end procedure.
     1939   procedure diasize_restore-orig-size :
     1940     do
     1941     on error undo, return error return-value
     1942     :
     1943       assign
     1944         v-diasize-current-frame-width  = frame fr-D-rsnattr-0 :width
     1945         v-diasize-current-frame-height = frame fr-D-rsnattr-0 :height
     1946       .
     1947       run diasize_set-height in this-procedure
     1948         (input  v-diasize-orig-frame-height
     1949         ,input  true
     1950         ) .
     1951       run diasize_set-width in this-procedure
     1952         (input  v-diasize-orig-frame-width
     1953         ,input  true
     1954         ) .
     1955     end.
     1956   end procedure.
     1957   procedure diasize_restore-current-size :
     1958     do
     1959     on error undo, return error return-value
     1960     :
     1961       run diasize_set-height in this-procedure
     1962         (input  v-diasize-current-frame-height
     1963         ,input  true
     1964         ) .
     1965       run diasize_set-width in this-procedure
     1966         (input  v-diasize-current-frame-width
     1967         ,input  true
     1968         ) .
     1969     end.
     1970   end procedure.
     1971   procedure diasize_set-browse-handle :
     1972     define input  parameter p-browse-handle as handle   no-undo .
     1973     define buffer buf_temp-browse-handle for temp-browse-handle .
     1974     do
     1975     on error undo, return error return-value
     1976     :
     1977       assign
     1978         v-diasize-browse-handle = p-browse-handle
     1979       .
     1980       for each buf_temp-browse-handle
     1981       on error undo, return error return-value
     1982       :
     1983         delete buf_temp-browse-handle .
     1984       end.
     1985     end.
     1986   end procedure.
     1987   procedure diasize_add_browse :
     1988     define input  parameter p-browse-type   as character no-undo .
     1989     define input  parameter p-browse-handle as handle    no-undo .
     1990     define buffer buf_temp-browse-handle for temp-browse-handle .
     1991     do
     1992     on error undo, return error return-value
     1993     :
     1994       assign
     1995         v-diasize-browse-number = v-diasize-browse-number + 1
     1996       .
     1997       create buf_temp-browse-handle .
     1998       assign
     1999         buf_temp-browse-handle.browse-type   = p-browse-type
     2000         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2001         buf_temp-browse-handle.browse-handle = p-browse-handle
     2002       .
     2003     end.
     2004   end procedure.
     2005   procedure diasize_init :
     2006     define variable v-default-value    as logical   no-undo .
     2007     define variable v-restore-saved    as logical   no-undo .
     2008     define variable v-resize-value-str as character no-undo .
     2009     do
     2010     on error undo, return error return-value
     2011     :
     2012       do with frame fr-D-rsnattr-0
     2013       :
     2014         assign
     2015           v-diasize-orig-frame-height = frame fr-D-rsnattr-0 :height
     2016           v-diasize-orig-frame-width  = frame fr-D-rsnattr-0 :width
     2017           v-diasize-browse-handle     = browse br-rattrs :handle
     2018         .
     2019         create button v-diasize-resize-button
     2020         assign
     2021           parent        = frame fr-D-rsnattr-0 :first-child
     2022           label         = "s"
     2023           height-pixels = 16
     2024           width-pixels  = 16
     2025           visible       = true
     2026           sensitive     = true
     2027           movable       = true
     2028           triggers:
     2029             on end-move persistent run diasize_end-move in this-procedure .
     2030           end triggers.
     2031         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2032         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2033         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2034         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2035         assign
     2036           v-diasize-wndmax = false
     2037         .
     2038         if connected("ub") = true
     2039         then do:
     2040           define variable v-cntxt-db-num        as integer   no-undo .
     2041           define variable v-cntxt-userid        as character no-undo .
     2042           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2043                                             , OUTPUT v-cntxt-userid
     2044                                             ) .
     2045           run gbl/wndpar_r.p
     2046             (input  v-cntxt-db-num
     2047             ,input  v-cntxt-userid
     2048             ,input  'wndmax':U
     2049             ,output v-diasize-wndmax
     2050             ,output v-default-value
     2051             ) .
     2052         end.
     2053         assign
     2054           v-diasize-wndstore = false
     2055         .
     2056         if connected("ub") = true
     2057         then do:
     2058           run gbl/wndpar_r.p
     2059             (input  v-cntxt-db-num
     2060             ,input  v-cntxt-userid
     2061             ,input  'wndstore':U
     2062             ,output v-diasize-wndstore
     2063             ,output v-default-value
     2064             ) .
     2065         end.
     2066         assign
     2067           v-diasize-proc-name = entry(1, program-name(2), '.')
     2068         .
     2069         if v-diasize-wndstore = true
     2070         then do:
     2071           assign
     2072             v-restore-saved = false
     2073           .
     2074           if connected("ub") = true
     2075           then do:
     2076             run gbl/wndsizer.p
     2077               (input  v-cntxt-db-num
     2078               ,input  v-cntxt-userid
     2079               ,input  v-diasize-proc-name
     2080               ,input  'height':u
     2081               ,output v-resize-value-str
     2082               ) .
     2083             if v-resize-value-str <> '':U
     2084             then do:
     2085               run diasize_change-height in this-procedure
     2086                 (input  integer(v-resize-value-str)
     2087                 ,input  true
     2088                 ) .
     2089               assign
     2090                 v-restore-saved = true
     2091               .
     2092             end.
     2093           end.
     2094           if connected("ub") = true
     2095           then do:
     2096             run gbl/wndsizer.p
     2097               (input  v-cntxt-db-num
     2098               ,input  v-cntxt-userid
     2099               ,input  v-diasize-proc-name
     2100               ,input  'width':u
     2101               ,output v-resize-value-str
     2102               ) .
     2103             if v-resize-value-str <> '':U
     2104             then do:
     2105               run diasize_change-width in this-procedure
     2106                 (input  integer(v-resize-value-str)
     2107                 ,input  true
     2108                 ) .
     2109               assign
     2110                 v-restore-saved = true
     2111               .
     2112             end.
     2113           end.
     2114           if v-restore-saved <> true
     2115           then do:
     2116             if v-diasize-wndmax = true
     2117             then do:
     2118               run diasize_maximize in this-procedure
     2119                 (input  true
     2120                 ) .
     2121             end.
     2122           end.
     2123         end.
     2124         else do:
     2125           if v-diasize-wndmax = true
     2126           then do:
     2127             run diasize_maximize in this-procedure
     2128               (input  true
     2129               ) .
     2130           end.
     2131         end.
     2132       end.
     2133     end.
     2134   end procedure.
     2135   procedure diasize_need-full-display :
     2136     define output parameter p-need-full-display as logical   no-undo .
     2137     do
     2138     on error undo, return error return-value
     2139     :
     2140       assign
     2141         p-need-full-display = v-diasize-need-full-display
     2142       .
     2143       assign
     2144         v-diasize-need-full-display = false
     2145       .
     2146     end.
     2147   end procedure.
     2148   procedure get-context :
     2149      define output parameter p-db-num as integer          no-undo.
     2150      define output parameter p-user-id as character        no-undo.
     2151      define variable v-login               as character    no-undo.
     2152      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2153      define buffer buf_user-login  for ub.user-login .
     2154      do
     2155      on error undo, return error
     2156      :
     2157            FIND FIRST buf_sys-ctrl no-lock.
     2158            ASSIGN
     2159               v-login = USERID("ub")
     2160               p-db-num = buf_sys-ctrl.db-num
     2161            .
     2162            FIND FIRST buf_user-login
     2163                 WHERE buf_user-login.db-num = p-db-num
     2164                   AND buf_user-login.user-login = v-login
     2165                 no-lock
     2166                 no-error
     2167                 .
     2168            IF AVAILABLE buf_user-login
     2169            THEN DO:
     2170               assign
     2171                  p-user-id = buf_user-login.user-id
     2172               .
     2173            END.
     2174      end.
     2175   end procedure.
     2176       run diasize_init in this-procedure .
     2177   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2178   DEF VAR cur-clmn-numbr-rattrs as INT EXTENT 2 no-undo.
     2179   DEF VAR varmvibr-rattrs       as INT no-undo.
     2180   DEF VAR varmvjbr-rattrs       as INT no-undo.
     2181   DEF VAR varmvkbr-rattrs       as INT no-undo.
     2182   DEF VAR varmvlbr-rattrs       as INT no-undo.
     2183   DEF VAR move-elementbr-rattrs as INT no-undo.
     2184   def var jjbr-rattrs           as int no-undo.
     2185   do varmvibr-rattrs = 1 to EXTENT(cur-clmn-numbr-rattrs):
     2186     ASSIGN cur-clmn-numbr-rattrs[varmvibr-rattrs] = varmvibr-rattrs.
     2187   END.
     2188   RUN start-mv-clmnbr-rattrs.
     2189   PROCEDURE start-mv-clmnbr-rattrs:
     2190   def var old-session as logical no-undo.
     2191      old-session = SESSION:IMMEDIATE-DISPLAY.
     2192      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2193      SESSION:IMMEDIATE-DISPLAY = old-session.
     2194   END.
     2195   ON ctrl-cursor-right OF BROWSE br-rattrs do:
     2196     RUN re-move-clmnbr-rattrs ( 1, 2).
     2197   END.
     2198   ON ctrl-cursor-left OF BROWSE br-rattrs do:
     2199     RUN re-move-clmnbr-rattrs (2, 1).
     2200   END.
     2201   PROCEDURE re-move-clmnbr-rattrs:
     2202     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2203     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2204     DO varmvibr-rattrs = 1 TO EXTENT(cur-clmn-numbr-rattrs):
     2205       if cur-clmn-numbr-rattrs[varmvibr-rattrs] = source-column THEN cur-clmn-numbr-rattrs[varmvibr-rattrs] = -1.
     2206     END.
     2207     if br-rattrs:MOVE-COLUMN(source-column, target-column) IN FRAME fr-D-rsnattr-0 then.
     2208     if source-column > target-column THEN
     2209     DO varmvjbr-rattrs = source-column - 1 to target-column BY -1:
     2210       DO varmvibr-rattrs = 1 TO EXTENT(cur-clmn-numbr-rattrs):
     2211           if cur-clmn-numbr-rattrs[varmvibr-rattrs] = varmvjbr-rattrs THEN DO:
     2212             cur-clmn-numbr-rattrs[varmvibr-rattrs] = cur-clmn-numbr-rattrs[varmvibr-rattrs] + 1.
     2213           END.
     2214       END.
     2215     END.
     2216     ELSE
     2217     DO varmvjbr-rattrs = source-column + 1 to target-column:
     2218       DO varmvibr-rattrs = 1 TO EXTENT(cur-clmn-numbr-rattrs):
     2219         if cur-clmn-numbr-rattrs[varmvibr-rattrs] = varmvjbr-rattrs THEN DO:
     2220           cur-clmn-numbr-rattrs[varmvibr-rattrs] = cur-clmn-numbr-rattrs[varmvibr-rattrs] - 1.
     2221         END.
     2222       END.
     2223     END.
     2224     DO varmvibr-rattrs = 1 TO EXTENT(cur-clmn-numbr-rattrs):
     2225       if cur-clmn-numbr-rattrs[varmvibr-rattrs] = -1 THEN cur-clmn-numbr-rattrs[varmvibr-rattrs] = target-column.
     2226     END.
     2227   END PROCEDURE.
     2228   PROCEDURE ch-clmnbr-rattrs:
     2229     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2230     if cur-clmn-loc <= 1 then do:
     2231       return .
     2232     end.
     2233     DO varmvibr-rattrs = 1 TO EXTENT(cur-clmn-numbr-rattrs):
     2234       if cur-clmn-numbr-rattrs[varmvibr-rattrs] = cur-clmn-loc THEN move-elementbr-rattrs = varmvibr-rattrs.
     2235     END.
     2236     RUN re-move-clmnbr-rattrs (cur-clmn-loc, 1).
     2237   END PROCEDURE.
     2238   PROCEDURE mv-brw-defaultbr-rattrs:
     2239   def var old-session as logical no-undo.
     2240     old-session = SESSION:IMMEDIATE-DISPLAY.
     2241     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2242     do varmvlbr-rattrs = 1 to EXTENT(cur-clmn-numbr-rattrs):
     2243       RUN re-move-clmnbr-rattrs (cur-clmn-numbr-rattrs[varmvlbr-rattrs], varmvlbr-rattrs).
     2244     END.
     2245     RUN start-mv-clmnbr-rattrs.
     2246     SESSION:IMMEDIATE-DISPLAY = old-session.
     2247   END PROCEDURE.
     2248   .
     2249   def var sort-labelbr-rattrs   as character no-undo .
     2250   def var sort-clmnbr-rattrs    as handle    no-undo .
     2251   def var cur-clmnbr-rattrs     as handle    no-undo .
     2252   def var cur-clmn-locbr-rattrs as integer   no-undo .
     2253   def var re-querybr-rattrs     as logical   initial no no-undo .
     2254   on start-search, ctrl-o of br-rattrs in frame fr-D-rsnattr-0 do:
     2255      run sort-brbr-rattrs
     2256        (input (if available X_trn-rsn-attr
     2257                then recid(X_trn-rsn-attr)
     2258                else ?
     2259               )
     2260        ).
     2261   end.
     2262   PROCEDURE sort-brbr-rattrs :
     2263     define input parameter p-recid as recid no-undo .
     2264     if re-querybr-rattrs = no then do:
     2265       assign
     2266          cur-clmnbr-rattrs = br-rattrs:current-column in frame fr-D-rsnattr-0
     2267       .
     2268       if sort-clmnbr-rattrs <> ? then sort-clmnbr-rattrs:column-fgcolor = 0.
     2269       if cur-clmnbr-rattrs = sort-clmnbr-rattrs then do:
     2270         assign
     2271            sort-labelbr-rattrs = ""
     2272            sort-clmnbr-rattrs = ?
     2273         .
     2274        end.
     2275        else do:
     2276          assign
     2277            sort-labelbr-rattrs = cur-clmnbr-rattrs:label
     2278            sort-clmnbr-rattrs  = cur-clmnbr-rattrs
     2279            sort-clmnbr-rattrs:column-fgcolor = 4
     2280          .
     2281        end.
     2282      end.
     2283     assign
     2284       cur-clmn-locbr-rattrs = 1
     2285     .
     2286     def var column-handle as handle no-undo .
     2287     column-handle = br-rattrs:first-column.
     2288     do while valid-handle(column-handle) :
     2289       if column-handle = cur-clmnbr-rattrs then do:
     2290         leave .
     2291       end.
     2292       column-handle = column-handle:NEXT-COLUMN.
     2293       assign
     2294         cur-clmn-locbr-rattrs = cur-clmn-locbr-rattrs + 1
     2295       .
     2296     end.
     2297     case sort-labelbr-rattrs:
     2298           when 'Код атрибута'  then DO:    assign       sort-column-name = "X_trn-rsn-attr.attr-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2299           when 'Значение'  then DO:    assign       sort-column-name = "X_trn-rsn-attr.attr-value"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2300       otherwise do:
     2301         assign
     2302           sort-column-name = ""
     2303         .
     2304         run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2305           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-rattrs') then do:
     2306             run mv-brw-defaultbr-rattrs.
     2307           end.
     2308         if sort-labelbr-rattrs <> "" then do:
     2309           assign
     2310             cur-clmnbr-rattrs:column-fgcolor = 0
     2311           .
     2312         end.
     2313         assign
     2314           cur-clmn-locbr-rattrs = ?
     2315         .
     2316       end.
     2317     end case.
     2318     if p-recid <> ? then do:
     2319       reposition br-rattrs to recid p-recid no-error.
     2320       apply "value-changed" to br-rattrs in frame fr-D-rsnattr-0.
     2321     end.
     2322     apply "entry" to br-rattrs in frame fr-D-rsnattr-0.
     2323   END PROCEDURE.
     2324   procedure re-open-query-srt-clmnbr-rattrs:
     2325   if cur-clmnbr-rattrs = ? then do:
     2326      run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2327   end.
     2328   else do:
     2329      assign re-querybr-rattrs = yes.
     2330      run sort-brbr-rattrs
     2331        (input (if available X_trn-rsn-attr
     2332                then recid(X_trn-rsn-attr)
     2333                else ?
     2334               )
     2335        ).
     2336      assign re-querybr-rattrs = no.
     2337   end.
     2338   end.
     2339   Main-Block:
     2340   do on error   undo Main-Block, leave Main-Block
     2341      on end-key undo Main-Block, leave Main-Block :
     2342     enable b-sch b-help b-History b-quit b-lkp br-rattrs sch-code with frame fr-D-rsnattr-0.
     2343     if p-mode <> 'ПРОСМОТР':U then do:
