     2355   hide frame fr-D-rsnattr-0 no-pause.
     2356   procedure OpenBr :
     2357   define input parameter p-open-query     as logical   no-undo.
     2358   define input parameter p-find-next      as logical   no-undo.
     2359   define input parameter p-find-condition as character no-undo.
     2360   define variable l-query-was-opened as logical   no-undo.
     2361   define variable sort-column-phrase as character no-undo.
     2362   define variable p-proc-hand        as handle    no-undo.
     2363   define variable l-open-query       as logical   no-undo.
     2364   define buffer X_trn-reason for ub.trn-reason.
     2365   assign p-proc-hand = this-procedure :handle.
     2366   case sort-column-name :
     2367     when "":U                   then do:
     2368       assign sort-column-phrase = "":U.
     2369     end.
     2370     when "X_trn-rsn-attr.attr-code"  then do:
     2371       assign sort-column-phrase = "by substring( X_trn-rsn-attr.reason-name, 1, 24 )".
     2372     end.
     2373     when "X_trn-rsn-attr.attr-value" then do:
     2374       assign sort-column-phrase = "by substring( X_trn-rsn-attr.PS,          1, 69 )".
     2375     end.
     2376     otherwise                        do:
     2377       assign sort-column-phrase = "by " + sort-column-name.
     2378     end.
     2379   end case.
     2380   find X_trn-reason no-lock where
     2381         X_trn-reason.reason-code = p-code no-error.
     2382   assign
     2383   frame fr-D-rsnattr-0 :title = substitute( "&1 &2"
     2384                                          ,  'Список атрибутов оснований (причин) создания документа':U
     2385                                          ,(if available X_trn-reason
     2386                                          then X_trn-reason.reason-name
     2387                                          else "":U )
     2388                                         )
     2389                                         .
     2390   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2391   define variable  l-disable-where-21  as logical   no-undo .
     2392   define variable  l-filter-open-21    as logical   .
     2393   define variable  flt-rec-21       as recid     no-undo .
     2394   define variable  filter-name-21      as character no-undo .
     2395   define variable  where-phrase-21     as character no-undo .
     2396   define variable  sort-phrase-21      as character no-undo .
     2397   define variable  where-phrase-rus-21 as character no-undo .
     2398   define variable  sort-phrase-rus-21  as character no-undo .
     2399     run waitfram-show in this-procedure
     2400       (input "ЖДИТЕ ..."
     2401       ).
     2402   run gbl/flt-get.p
     2403     (input filter-point
     2404     ,output flt-rec-21
     2405     ,output filter-name-21
     2406     ,output where-phrase-21
     2407     ,output sort-phrase-21
     2408     ,output where-phrase-rus-21
     2409     ,output sort-phrase-rus-21
     2410     ).
     2411   if p-open-query then do:
     2412       run set-filter-name in this-procedure
     2413         (INPUT filter-name-21
     2414         ) no-error .
     2415     assign
     2416       l-filter-open-21 = false
     2417     .
     2418     if flt-rec-21 <> ?
     2419       or sort-column-phrase > ""
     2420     then do:
     2421       define variable  parameter-2-21 as character no-undo .
     2422       define variable  parameter-3-21 as character no-undo .
     2423       define variable  parameter-4-21 as character no-undo .
     2424       define variable  parameter-5-21 as character no-undo .
     2425       define variable  parameter-6-21 as character no-undo .
     2426       define variable  parameter-7-21 as character no-undo .
     2427         assign
     2428         parameter-3-21 =
     2429                                 "each X_trn-rsn-attr"
     2430         parameter-4-21 =
     2431           (
     2432             if (" yes  " + " " + where-phrase-21) <> ""
     2433             then " yes  " + " " + where-phrase-21
     2434             else "true"
     2435           )
     2436         parameter-5-21 = (" " + "" + " " + "")
     2437         parameter-6-21 = if sort-phrase-21 = ''
     2438                              then
     2439           (
     2440           " " + "  " +
     2441             " " + sort-column-phrase +
     2442           " " + "  "
     2443           )
     2444                              else
     2445           (
     2446           " " + "  " +
     2447             " " + sort-column-phrase +
     2448           " " + sort-phrase-21
     2449           )
     2450         parameter-7-21 =
     2451           " indexed-reposition  "
     2452       .
     2453       do
     2454       on stop undo, leave
     2455       on error undo, leave
     2456       :
     2457         assign
     2458           l-disable-where-21 =
     2459             (" yes  " + " " + where-phrase-21 = "")
     2460         .
     2461         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2462                             ,input query br-rattrs:handle
     2463                             ,input parameter-3-21
     2464                             ,input parameter-4-21
     2465                             ,input parameter-5-21
     2466                             ,input parameter-6-21
     2467                             ,input parameter-7-21
     2468                             )
     2469         .
     2470         assign
     2471           l-filter-open-21 = true
     2472         .
     2473       end.
     2474       if l-filter-open-21 = false then do:
     2475         message
     2476           "Ошибка при фильтрации / сортировке" skip
     2477           "Будут показаны записи без учета фильтра" skip
     2478           view-as alert-box .
     2479       end.
     2480       else do:
     2481           assign
     2482             l-query-was-opened = true
     2483           .
     2484       end.
     2485     end.
     2486     if l-filter-open-21 = false then do:
     2487       open query br-rattrs for each X_trn-rsn-attr
     2488         where  yes
     2489         indexed-reposition
     2490     .
     2491         assign
     2492           l-query-was-opened = true
     2493         .
     2494     end.
     2495   end.
     2496   else do:
     2497     assign
     2498       v-doc-rec = recid( X_trn-rsn-attr )
     2499     .
     2500     do
     2501     on stop undo, leave
     2502     on error undo, leave
     2503     :
     2504       if query br-rattrs:handle:get-buffer-handle(1) = (buffer X_trn-rsn-attr:handle) then do:
     2505         assign
     2506         parameter-2-21 = (if p-find-next then "true":u else "false":u )
     2507         parameter-4-21 =
     2508           "where ":u + " yes  " + " ":u + where-phrase-21 + " ":u + p-find-condition + " " + ""
     2509         parameter-5-21 = "  "
     2510       .
     2511         run fltopend_fltfindd in this-procedure  (
     2512                             input this-procedure:handle
     2513                             ,input query br-rattrs:handle
     2514                             ,input rowid(X_trn-rsn-attr)
     2515                             ,input logical(parameter-2-21)
     2516                             ,input no-lock
     2517                             ,input (buffer X_trn-rsn-attr:handle)
     2518                             ,input parameter-4-21
     2519                             ,input parameter-5-21
     2520                             ) no-error.
     2521         .
     2522         assign
     2523           v-doc-rec = integer(return-value)
     2524           v-fltopend-rowid[1] = ?
     2525         .
     2526       end.
     2527       else do:
     2528         assign
     2529         parameter-2-21 = (if p-find-next then "true":u else "false":u )
     2530         parameter-3-21 =  "each X_trn-rsn-attr"
     2531         parameter-4-21 =
     2532           (
     2533             if (" yes  " + " " + where-phrase-21) <> ""
     2534             then " yes  " + " " + where-phrase-21
     2535             else "true"
     2536           )
     2537         parameter-5-21 = (" " + "" + " " + "" + " " + p-find-condition)
     2538         parameter-6-21 = if sort-phrase-21 = ''
     2539                              then
     2540           (
     2541           " " + "  " +
     2542             " " + sort-column-phrase +
     2543           " " + "  "
     2544           )
     2545                              else
     2546           (
     2547           " " + "  " +
     2548             " " + sort-column-phrase +
     2549           " " + sort-phrase-21
     2550           )
     2551         parameter-7-21 =
     2552           " indexed-reposition  "
     2553       .
     2554         run fltopend_fltfindq in this-procedure  (
     2555                             input this-procedure:handle
     2556                             ,input query br-rattrs:handle
     2557                             ,input logical(parameter-2-21)
     2558                             ,input no-lock
     2559                             ,input parameter-3-21
     2560                             ,input parameter-4-21
     2561                             ,input parameter-5-21
     2562                             ,input parameter-6-21
     2563                             ,input parameter-7-21
     2564                             ,output v-fltopend-rowid
     2565                             ) no-error.
     2566         .
     2567         v-doc-rec = ?.
     2568       end.
     2569       assign
     2570         l-query-was-opened = true
     2571       .
     2572     end.
     2573   end.
     2574     run waitfram-hide in this-procedure .
     2575   if p-open-query <> yes and v-doc-rec <> ? then
     2576   reposition br-rattrs to recid v-doc-rec no-error.
     2577   if not p-open-query and v-fltopend-rowid[1] <> ? then
     2578   query br-rattrs:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     2579   apply "VALUE-CHANGED":U to br-rattrs in frame fr-D-rsnattr-0.
     2580   apply "ENTRY":U         to br-rattrs in frame fr-D-rsnattr-0.
     2581   end procedure.
     2582   procedure proc-filter :
     2583     assign tbl      = 'trn-rsn-attr'
     2584            join-tbl = 'X_trn-rsn-attr'
     2585            fld      = '':U
     2586            lab      = '':U
     2587            spr      = '':U
     2588            dim      = '0'.
     2589       run fltfield-add in this-procedure ( input 'attr-code',  input 'Код причины',         input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2590     run fltfield-add in this-procedure ( input 'attr-value', input 'Основание (причина)', input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2591     if num-entries( fld ) <> num-entries( lab ) or num-entries( lab ) <> integer( dim ) or
     2592        num-entries( fld ) <> num-entries( spr ) or num-entries( spr ) <> integer( dim ) or
     2593        num-entries( lab ) <> num-entries( spr ) or num-entries( fld ) <> integer( dim ) then do:
     2594       message "Неверная настройка на фильтры!" view-as alert-box error.
     2595       return no-apply.
     2596     end.
     2597     Filter-Block:
     2598     do on error   undo Filter-Block, leave Filter-Block
     2599        on end-key undo Filter-Block, leave Filter-Block :
     2600       run gbl/filter.w ( input parParentProc
     2601                      ,input filter-point + chr(4) + filter-label
     2602                      ,input tbl
     2603                      ,input join-tbl
     2604                      ,input fld
     2605                      ,input lab
     2606                      ,input spr
     2607                      ,input dim            ).
     2608       if return-value = 'undo':U then do:
     2609         apply "ENTRY":U to browse br-rattrs.
     2610         return no-apply.
     2611       end.
     2612       assign sch-num = 0.
     2613       hide   sch-num in frame fr-D-rsnattr-0.
     2614       run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2615     end.
     2616   end procedure.
     2617   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2618   procedure set-filter-name :
     2619   define input parameter p-filter-name as character no-undo .
     2620     do with frame fr-D-rsnattr-0:
     2621       if p-filter-name > "" then do:
     2622         assign
     2623           frame fr-D-rsnattr-0:title
     2624             = frame fr-D-rsnattr-0:title + "   ФИЛЬТР: " + p-filter-name.
     2625         .
     2626         assign
     2627           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2628         .
     2629       end.
     2630       else do:
     2631         assign
     2632           b-sch :tooltip = ""
     2633         .
     2634       end.
     2635     end.
     2636   end procedure.
     2637   procedure proc-find-code :
     2638     define input parameter p-next as logical   no-undo.
     2639     define input parameter p-code as character no-undo.
     2640     assign p-code = replace( p-code, chr(34), chr(34) + chr(34) )
     2641            p-code = replace( p-code, chr(39), chr(39) + chr(39) )
     2642            p-code = chr(34) + p-code + chr(34).
     2643     run OpenBr in this-procedure ( input no, input p-next, input substitute( " and X_trn-rsn-attr.attr-code = &1 ", p-code ) ).
     2644     if v-doc-rec <> ? then do:
     2645       if FoundRec = ? then do: assign FoundRec = v-doc-rec. end.
     2646       if FoundRec = v-doc-rec then do: assign sch-num = 0. end.
     2647       assign  sch-num = sch-num + 1.
     2648       display sch-num with frame fr-D-rsnattr-0.
     2649     end.
     2650     else do:
     2651       assign  sch-num = 0.
     2652       hide    sch-num in frame fr-D-rsnattr-0.
     2653     end.
     2654     apply "ENTRY":U to sch-code in frame fr-D-rsnattr-0.
     2655   end procedure.
     2656   procedure proc-delete :
     2657     define variable l_log as logical no-undo.
     2658     define buffer buf_trn-rsn-attr for ub.trn-rsn-attr.
     2659     do on error   undo, leave
     2660        on end-key undo, leave :
     2661       find first buf_trn-rsn-attr no-lock where recid( buf_trn-rsn-attr ) = v-doc-rec no-error.
     2662       if not available buf_trn-rsn-attr then do:
     2663         message "Запись не найдена." view-as alert-box error.
     2664         undo, return error.
     2665       end.
     2666       Erase-Block:
     2667       do on error   undo Erase-Block, leave Erase-Block
     2668          on end-key undo Erase-Block, leave Erase-Block :
     2669         find first buf_trn-rsn-attr exclusive-lock where recid( buf_trn-rsn-attr ) = v-doc-rec.
     2670         delete buf_trn-rsn-attr.
     2671       end.
     2672       get prev br-rattrs no-lock.
     2673       if not available X_trn-rsn-attr then do: get prev br-rattrs no-lock. end.
     2674       if not available X_trn-rsn-attr then do: get next br-rattrs no-lock. end.
     2675       if not available X_trn-rsn-attr then do: get next br-rattrs no-lock. end.
     2676       assign v-doc-rec = ( if available X_trn-rsn-attr then recid( X_trn-rsn-attr ) else ? ).
     2677       reposition br-rattrs to recid v-doc-rec no-error.
     2678       if error-status :error then do: reposition br-rattrs to row 1 no-error. end.
     2679       apply "ENTRY":U         to br-rattrs in frame fr-D-rsnattr-0.
     2680       apply "VALUE-CHANGED":U to br-rattrs in frame fr-D-rsnattr-0.
     2681     end.
     2682   end procedure.
