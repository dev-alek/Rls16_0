     2665                       ( input  buf_rvs-line.gds-code
     2666                        ,input  'gds-ptrl-densities':U
     2667                        ,output v-value
     2668                        ,output vtype) .
     2669                   if v-value <> "" and v-value <> ? then
     2670                   do:
     2671                      assign
     2672                         v-min-dens = decimal(replace(entry(1, v-value, "-":U ), "кг\л", "":U))
     2673                         buf_rvs-line.state-density = v-min-dens
     2674                         // v-max-dens = decimal(replace(entry(2, v-value, "-":U ), "кг\л":U, "":U))
     2675                         no-error.
     2676                   end.
     2677               end.
     2678               if    buf_rvs-line.state-density eq 0
     2679                  or buf_rvs-line.state-density eq ?
     2680               then
     2681                  buf_rvs-line.state-density = 0.75.
     2682            end.
     2683       end.
     2684       if ptrlprop-autopump = true then do:
     2685   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_pump-sh in g#lib-rvs ( input  buf_rvs-doc.obj-type ,
