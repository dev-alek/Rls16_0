     1273   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1274   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1275   define variable ptrlprop-denstclc      as character no-undo initial 'shft_rvs-inc':U .
     1276   define variable ptrlprop-inpptrl       as character no-undo initial 'weight':U .
     1277   define variable ptrlprop-expptrl       as character no-undo initial 'volume':U .
     1278   define variable ptrlprop-autopump      as logical   no-undo initial false .
     1279   define variable ptrlprop-avtinvpm      as logical   no-undo initial false .
     1280   define variable ptrlprop-rvsnmter      as logical   no-undo initial false .
     1281   define variable ptrlprop-olddens       as logical   no-undo initial false .
     1282   define variable ptrlprop-invclipt      as integer   no-undo initial ? .
     1283   define variable ptrlprop-algrvspt      as integer   no-undo initial 1 .
     1284   define variable ptrlprop-temp-for-pomi as integer   no-undo initial 1 .
     1285   define variable ptrlprop-algoincome as integer no-undo init 0.
