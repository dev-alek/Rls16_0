        1   block-level on error undo, throw.
        2   define input parameter parparentproc   as widget-handle no-undo.
        3   define input parameter p-obj-type as character no-undo .
        4   define input parameter p-obj-code as integer no-undo .
        5   define output parameter p-rvs-code  as character no-undo .
        6   define variable vss-revision    as character no-undo initial "$Revision$":U.
        7   define variable vss-author      as character no-undo initial "$Author$":U.
        8   define variable vss-date        as character no-undo initial "$Date$":U.
        9   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
       10   define variable vss-archive     as character no-undo initial "$Archive$":U.
       11   define variable vss-description as character no-undo initial "Автоматическое создание контрольной сверки":U.
       12   DEFINE VARIABLE mParam AS CHARACTER NO-UNDO.
       13   DEFINE VARIABLE mRVSNull AS LOGICAL no-undo init no.
       14   publish "RVSParam" (output mParam).
       15   mRVSNull = logical (entry(1,mParam)) no-error.
       16   if mRVSNull eq ? then mRVSNull = no.
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   define new global shared variable g#lib-trn  as handle no-undo .
       87   define new global shared variable g#lib-trn2 as handle no-undo .
       88   define new global shared variable g#lib-trn3 as handle no-undo .
       89   define new global shared variable g#lib-trn4 as handle no-undo .
       90   define new global shared variable g#libbcrcn as handle no-undo .
       91     define new global shared variable g#lib-rvs as handle no-undo.
       92   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93   define  shared variable g#auto-pid           as integer   no-undo .
       94   define  shared variable conn-par             as character no-undo .
       95   define  shared variable g#auto-user-id       as character no-undo .
       96   define  shared variable g#auto-user-login    as character no-undo .
       97   define  shared variable g#auto-user-password as character no-undo .
       98   define  shared variable v-socket             as logical   no-undo .
       99   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      100   define  shared variable auto-window-h     as handle    no-undo .
      101   define  shared variable auto-log-msg-h    as handle    no-undo .
      102   define  shared variable hand-log-msg-h    as handle    no-undo .
      103   define  shared variable log-file-name     as character no-undo initial ? .
      104   define  shared variable add-log-file-name as character no-undo initial ? .
      105   define  shared variable writelogvalue     as character no-undo initial ? .
      106   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      107   procedure cur-time :
      108      define output parameter p-today as date      no-undo .
      109      define output parameter p-time  as integer   no-undo .
      110     do
      111     on error undo, return error
      112     :
      113       define variable v-date1 as date      no-undo .
      114       define variable v-date2 as date      no-undo .
      115       define variable v-time  as integer   no-undo .
      116       assign
      117         v-date1 = today
      118         v-time  = time
      119         v-date2 = today
      120       .
      121       if v-date1 <> v-date2
      122       then do:
      123         assign
      124           v-date1 = today
      125           v-time  = v-time
      126         .
      127       end.
      128       assign
      129         p-today = v-date1
      130         p-time  = v-time
      131       .
      132     end.
      133   end.
      134   function cur-time-date returns character
      135   :
      136     return string(today, '99/99/9999':U) .
      137   end.
      138   function cur-time-mjd returns decimal
      139   :
      140     define variable v-date as date      no-undo .
      141     define variable v-time as integer   no-undo .
      142     run cur-time in this-procedure
      143       (output v-date
      144       ,output v-time
      145       ) .
      146     return integer(v-date) - 2400002 + (v-time / 86400) .
      147   end.
      148   function cur-time-get-ending-index returns integer
      149   (input p-number as integer
      150   )
      151   :
      152     if p-number < 0
      153     or p-number = ?
      154     then do:
      155       return 1 .
      156     end.
      157     define variable v-rest as integer   no-undo .
      158     assign
      159       p-number = p-number modulo 100
      160     .
      161     if p-number < 20
      162     then do:
      163       assign
      164         v-rest = p-number
      165       .
      166     end.
      167     else do:
      168       assign
      169         v-rest = p-number modulo 10
      170       .
      171     end.
      172     case v-rest :
      173       when 1
      174       then do:
      175         return 2 .
      176       end.
      177       when 2 or
      178       when 3 or
      179       when 4
      180       then do:
      181         return 3 .
      182       end.
      183       otherwise do:
      184         return 1 .
      185       end.
      186     end case .
      187   end.
      188   procedure cur-time-mjd-to-date :
      189      define input  parameter i-mjd-diff as decimal no-undo.
      190      define output parameter o-Date     as date    no-undo.
      191      define output parameter o-Time     as integer no-undo.
      192      define variable v-day-number as integer   no-undo .
      193      if    i-mjd-diff < 0
      194         or i-mjd-diff = ?
      195      then do:
      196         return "?" .
      197      end.
      198      assign
      199         v-day-number = truncate(i-mjd-diff,0).
      200         o-Date = date(v-day-number + 2400002).
      201         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      202     .
      203   end.
      204   function cur-time-mjd-to-string returns character
      205   (input p-mjd-diff as decimal
      206   )
      207   :
      208     define variable v-day-number as integer   no-undo .
      209     define variable v-seconds    as integer   no-undo .
      210     define variable v-hour       as integer   no-undo .
      211     define variable v-min        as integer   no-undo .
      212     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      213     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      214     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      215     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      216     if p-mjd-diff < 0
      217     or p-mjd-diff = ?
      218     then do:
      219       return "?" .
      220     end.
      221     assign
      222       v-day-number = integer(truncate(p-mjd-diff,0))
      223       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      224     .
      225     if v-seconds > 86400
      226     then do:
      227       assign
      228         v-seconds = 86400 - 1
      229       .
      230     end.
      231     if v-seconds < 0
      232     then do:
      233       assign
      234         v-seconds = 0
      235       .
      236     end.
      237     assign
      238       v-hour = truncate(v-seconds / 3600, 0)
      239     .
      240     assign
      241       v-seconds = v-seconds modulo 3600
      242     .
      243     assign
      244       v-min = truncate(v-seconds / 60, 0)
      245     .
      246     assign
      247       v-seconds = v-seconds modulo 60
      248     .
      249     return
      250         (if v-day-number <> 0
      251           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      252           else ""
      253         )
      254       + (if v-day-number <> 0 or v-hour <> 0
      255           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      256           else ""
      257         )
      258       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      259           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      260           else ""
      261         )
      262       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      263       .
      264   end.
      265   function cur-time-string returns character
      266   :
      267     define variable v-date as date      no-undo .
      268     define variable v-time as integer   no-undo .
      269     run cur-time in this-procedure
      270       (output v-date
      271       ,output v-time
      272       ) .
      273     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      274   end.
      275   function cur-time-string-sec returns character
      276   :
      277     define variable v-date as date      no-undo .
      278     define variable v-time as integer   no-undo .
      279     run cur-time in this-procedure
      280       (output v-date
      281       ,output v-time
      282       ) .
      283     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      284   end.
      285   function cur-time-custom  returns character
      286   (input p-prefix as character
      287   ,input p-date-format as character
      288   ,input p-delimiter as character
      289   ,input p-time-format as character
      290   ,input p-suffix as character
      291   )
      292   :
      293     define variable v-date as date      no-undo .
      294     define variable v-time as integer   no-undo .
      295     run cur-time in this-procedure
      296       (output v-date
      297       ,output v-time
      298       ) .
      299     return
      300       p-prefix
      301       + string(v-date, p-date-format)
      302       + p-delimiter
      303       + string(v-time, p-time-format)
      304       + p-suffix
      305       .
      306   end.
      307   function cur-time-print  returns character
      308   :
      309     define variable v-date as date      no-undo .
      310     define variable v-time as integer   no-undo .
      311     run cur-time in this-procedure
      312       (output v-date
      313       ,output v-time
      314       ) .
      315     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      316   end.
      317   function cur-time-datetime returns datetime
      318   :
      319     define variable v-char as character no-undo .
      320     define variable v-datetime as datetime no-undo .
      321     v-char = cur-time-string().
      322     v-datetime = datetime(v-char).
      323     return  v-datetime.
      324   end.
      325   function cur-time-string-msec returns character
      326   :
      327     define variable v-date as datetime  no-undo .
      328     v-date = now.
      329     return string(v-date) .
      330   end.
      331   define stream LogStream .
      332   define variable mNoTime as logical no-undo.
      333   procedure write-to-log-notime :
      334     define input param i-str as character no-undo .
      335     mNoTime = yes.
      336     run write-to-log (i-str).
      337     mNoTime = no.
      338   end.
      339   procedure write-to-log :
      340     define input param p-str as character no-undo .
      341     do
      342     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      343     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      344     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      345     :
      346       define variable log-res        as logical   no-undo .
      347       define variable v-jj           as integer   no-undo .
      348       if    mNoTime
      349          or writelogvalue eq "AsyncProc"
      350       then
      351          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      352       else
      353          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      354       if auto-log-msg-h <> ? then do:
      355         log-res = auto-log-msg-h:move-to-eof( ) .
      356         log-res = auto-log-msg-h:insert-string( p-str ).
      357       end.
      358       if hand-log-msg-h <> ? then do:
      359         log-res = hand-log-msg-h:move-to-eof( ) .
      360         log-res = hand-log-msg-h:insert-string( p-str ).
      361       end.
      362       assign
      363         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      364         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      365         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      366       .
      367       if add-log-file-name <> ? then do:
      368         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      369           run gbl/fileapnd.p
      370             ( input entry(v-jj, add-log-file-name, chr(1) )
      371             ,input p-str
      372             ,input 20
      373             ) no-error .
      374           if error-status:error then do:
      375             return error return-value .
      376           end.
      377         end.
      378       end.
      379       if writelogvalue eq "AsyncProc"
      380       then do:
      381          p-str = trim(p-str, (chr(13) + chr(10)) )
      382       .
      383          Publish "WriteLogAsunc" (p-str,yes).
      384       end.
      385       else if writelogvalue <> "yes" then do:
      386         run gbl/fileapnd.p
      387           ( input log-file-name
      388           ,input p-str
      389           ,input 20
      390           ) no-error .
      391         if error-status:error then do:
      392           return error return-value .
      393         end.
      394       end.
      395     end.
      396   end procedure.
      397   procedure write-to-screen :
      398     define input param p-str as character no-undo .
      399     do
      400     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      401     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      402     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      403     :
      404       define variable log-res as logical no-undo.
      405       assign
      406         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      407       .
      408       if auto-log-msg-h <> ?
      409       then do:
      410         log-res = auto-log-msg-h:move-to-eof( ) .
      411         log-res = auto-log-msg-h:insert-string( p-str ).
      412       end.
      413       if hand-log-msg-h <> ?
      414       then do:
      415         log-res = hand-log-msg-h:move-to-eof( ) .
      416         log-res = hand-log-msg-h:insert-string( p-str ).
      417       end.
      418     end.
      419   end procedure.
      420   procedure send-msg-to-email :
      421     define input  parameter p-subject      as character no-undo .
      422     define input  parameter p-text-err     as character no-undo .
      423     define input  parameter p-attach-files as character no-undo .
      424     do
      425     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      426     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      427     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      428     :
      429       define variable v-tth             as handle    no-undo .
      430       define variable v-value-character as character no-undo .
      431       define variable v-value-date      as date      no-undo .
      432       define variable v-value-decimal   as decimal   no-undo .
      433       define variable v-value-integer   as integer   no-undo .
      434       define variable v-value-logical   as logical   no-undo .
      435       define variable v-param-type      as character no-undo .
      436       define variable v-email       as character no-undo .
      437       define variable v-tmp-str     as character no-undo .
      438       define variable v-tmp1-str    as character no-undo .
      439       define variable v-ind         as integer   no-undo .
      440       define variable v-num-entries as integer   no-undo .
      441       delete object v-tth no-error.
      442       run adm/shattri.p
      443         ( input "get":U
      444          ,input  "":U
      445          ,input  0
      446          ,input  'auto-task':U
      447          ,input  'send-msg-to-email':U
      448          ,output v-value-character
      449          ,output v-value-date
      450          ,output v-value-decimal
      451          ,output v-value-integer
      452          ,output v-value-logical
      453          ,output v-param-type
      454          ,input-output table-handle v-tth
      455         ) no-error .
      456       if not error-status :error  then do:
      457         assign
      458           v-tmp-str = v-value-character
      459         .
      460       end.
      461       delete object v-tth no-error.
      462       assign
      463         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      464         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      465         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      466         v-num-entries = num-entries( v-tmp-str, chr(44) )
      467         v-email       = "":U
      468       .
      469       do v-ind = 1 to v-num-entries
      470       :
      471         assign
      472           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      473         .
      474         if trim( v-tmp1-str ) <> "":U then do:
      475           if v-email = "":U then do:
      476             assign
      477               v-email = v-tmp1-str
      478             .
      479           end.
      480           else do:
      481             assign
      482               v-email = v-email + chr(44) + v-tmp1-str
      483             .
      484           end.
      485         end.
      486       end.
      487       if v-email <> "":U then do:
      488         run gbl/sendmail.p
      489           ( input v-email
      490           , input p-subject
      491           , input p-text-err
      492           , input p-attach-files
      493           ) no-error .
      494         if error-status :error
      495           or return-value <> "":U
      496         then do:
      497           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      498         end.
      499       end.
      500     end.
      501   end procedure.
      502   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      503   define temp-table temp-schedule-free no-undo
      504   field free-id as character
      505   field free-task-name as character
      506   field proc-run-name as character
      507   field proc-param-edit-name as character
      508   field conf-param as character
      509   field is-gbd as logical
      510   field is-ubd as logical
      511   field enable-concurrent-0 as logical
      512   field enable-concurrent-db as logical
      513   field other-info as character
      514   field enc-key as character
      515   field is-rum as logical
      516   index pi is unique primary
      517   free-id.
      518   procedure schedule-attr-name :
      519   do
      520     on error undo, return error
      521     :
      522     define input  parameter p-code           as character no-undo .
      523     define output parameter p-type           as character no-undo .
      524     define output parameter p-format         as character no-undo .
      525     define output parameter p-label          as character no-undo .
      526     define output parameter p-user-can-edit  as logical   no-undo .
      527     define output parameter p-output-display as logical   no-undo .
      528     define output parameter p-other          as character no-undo .
      529       if index(p-code, chr(4)) > 0 then do:
      530         p-code = entry(1, p-code, chr(4)).
      531       end.
      532       case p-code :
      533               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      534               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      535               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      536               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      537               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      538               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      539               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      540               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      541               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      542         otherwise do:
      543           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      544         end.
      545       end.
      546     end.
      547   end procedure.
      548   procedure schedule-attr-tooltip :
      549   do
      550     on error undo, return error
      551     :
      552       define input  parameter p-code    as character no-undo .
      553       define output parameter p-tooltip as character no-undo .
      554       define output parameter p-label   as character no-undo .
      555       if index(p-code, chr(4)) > 0 then do:
      556         p-code = entry(1, p-code, chr(4)).
      557       end.
      558       case p-code :
      559               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      560               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      561               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      562               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      563               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      564               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      565               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      566               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      567               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      568         otherwise do:
      569               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      570         end.
      571       end.
      572     end.
      573   end procedure.
      574   procedure schedule-attr-value :
      575   do
      576   on error undo, return error return-value
      577   :
      578   define input parameter  p-cre-db-num as integer    no-undo.
      579   define input parameter  p-task-type  as character  no-undo.
      580   define input parameter  p-task-num   as integer    no-undo.
      581   define input parameter  p-code       as character  no-undo.
      582   define output parameter p-value      as character  no-undo.
      583   define output parameter p-type       as character  no-undo.
      584       define variable v-format         as character no-undo .
      585       define variable v-label          as character no-undo .
      586       define variable v-user-can-edit  as logical   no-undo .
      587       define variable v-output-display as logical   no-undo .
      588       define variable v-other          as character no-undo .
      589       define buffer buf_schedule-attr for ub.schedule-attr.
      590       run schedule-attr-name in this-procedure (
      591             input  p-code
      592           , output p-type
      593           , output v-format
      594           , output v-label
      595           , output v-user-can-edit
      596           , output v-output-display
      597           , output v-other
      598       ) no-error .
      599       if error-status :error
      600       then do:
      601           undo, return error return-value .
      602       end.
      603       if p-code begins ('schd-free-id':U + chr(4))
      604       and entry(2, p-code, chr(4)) = '':U then do:
      605         find first buf_schedule-attr no-lock
      606             where buf_schedule-attr.cre-db-num = p-cre-db-num
      607               and buf_schedule-attr.task-type  = p-task-type
      608               and buf_schedule-attr.task-num   = p-task-num
      609               and buf_schedule-attr.attr-code  begins p-code
      610         no-error .
      611       end.
      612       else do:
      613         find first buf_schedule-attr no-lock
      614             where buf_schedule-attr.cre-db-num = p-cre-db-num
      615               and buf_schedule-attr.task-type  = p-task-type
      616               and buf_schedule-attr.task-num   = p-task-num
      617               and buf_schedule-attr.attr-code  = p-code
      618         no-error .
      619       end.
      620       if available buf_schedule-attr
      621       then do:
      622           assign
      623               p-value = buf_schedule-attr.attr-value
      624           .
      625       end.
      626       else do:
      627         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      628            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      629         end.
      630         else do:
      631           assign
      632               p-value = if p-type = 'L':U then "no":U else ""
      633           .
      634         end.
      635       end.
      636   end.
      637   end procedure.
      638   procedure schedule-attr-write :
      639   do
      640   on error undo, return error
      641   :
      642   define input parameter p-cre-db-num  as integer   no-undo.
      643   define input parameter p-task-type   as character no-undo.
      644   define input parameter p-task-num    as integer   no-undo.
      645   define input parameter p-code        as character no-undo.
      646   define input parameter p-value       as character no-undo.
      647       define variable v-type              as character                no-undo.
      648       define variable v-format            as character                no-undo.
      649       define variable v-label             as character                no-undo.
      650       define variable v-user-can-edit     as logical                  no-undo.
      651       define variable v-output-display    as logical                  no-undo.
      652       define variable v-other             as character                no-undo.
      653       define buffer buf_schedule-attr for ub.schedule-attr .
      654       run schedule-attr-name in this-procedure (
      655             input  p-code
      656           , output v-type
      657           , output v-format
      658           , output v-label
      659           , output v-user-can-edit
      660           , output v-output-display
      661           , output v-other
      662       ) no-error.
      663       if error-status :error
      664       then do:
      665           undo, return error return-value.
      666       end.
      667       find first buf_schedule-attr exclusive-lock
      668            where buf_schedule-attr.cre-db-num = p-cre-db-num
      669              and buf_schedule-attr.task-type  = p-task-type
      670              and buf_schedule-attr.task-num   = p-task-num
      671              and buf_schedule-attr.attr-code  = p-code
      672       no-error.
      673       if not available buf_schedule-attr
      674       then do:
      675           create buf_schedule-attr.
      676           assign
      677             buf_schedule-attr.cre-db-num = p-cre-db-num
      678             buf_schedule-attr.task-type  = p-task-type
      679             buf_schedule-attr.task-num   = p-task-num
      680             buf_schedule-attr.attr-code  = p-code
      681             buf_schedule-attr.attr-value = p-value
      682           .
      683       end.
      684       else do:
      685           assign
      686               buf_schedule-attr.attr-value = p-value
      687           .
      688       end.
      689   end.
      690   end procedure.
      691   procedure schedule-attr-delete :
      692   do
      693   on error undo, return error
      694   :
      695   define input  parameter p-cre-db-num  as integer   no-undo.
      696   define input  parameter p-task-type   as character no-undo.
      697   define input  parameter p-task-num    as integer   no-undo.
      698   define input  parameter p-code        as character no-undo.
      699   define output parameter p-deleted     as logical   no-undo.
      700       define buffer buf_schedule-attr for ub.schedule-attr .
      701       define variable v-type              as character                no-undo.
      702       define variable v-format            as character                no-undo.
      703       define variable v-label             as character                no-undo.
      704       define variable v-user-can-edit     as logical                  no-undo.
      705       define variable v-output-display    as logical                  no-undo.
      706       define variable v-other             as character                no-undo.
      707       run schedule-attr-name in this-procedure (
      708             input p-code
      709           , output v-type
      710           , output v-format
      711           , output v-label
      712           , output v-user-can-edit
      713           , output v-output-display
      714           , output v-other
      715       ) no-error .
      716       if error-status :error
      717       then do:
      718           undo, return error return-value .
      719       end.
      720       find first buf_schedule-attr exclusive-lock
      721            where buf_schedule-attr.cre-db-num = p-cre-db-num
      722              and buf_schedule-attr.task-type  = p-task-type
      723              and buf_schedule-attr.task-num   = p-task-num
      724              and buf_schedule-attr.attr-code  = p-code
      725       no-error.
      726       if not available buf_schedule-attr
      727       then do:
      728           assign
      729               p-deleted = no
      730           .
      731       end.
      732       else do:
      733           delete buf_schedule-attr.
      734           assign
      735               p-deleted = yes
      736           .
      737       end.
      738   end.
      739   end procedure.
      740   procedure schedule-attr-news :
      741   do
      742   on error undo, return error
      743   :
      744       define input  parameter p-code           as character no-undo .
      745       define output parameter p-news           as logical   no-undo .
      746       if index(p-code, chr(4)) > 0 then do:
      747         p-code = entry(1, p-code, chr(4)).
      748       end.
      749       case p-code :
      750               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      751               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      752               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      753               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      754               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      755               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      756               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      757               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      758               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      759         otherwise do:
      760           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      761         end.
      762       end.
      763   end.
      764   end procedure.
      765   procedure schedule-attr-extract-logical :
      766   do
      767   on error undo, return error
      768   :
      769   define input  parameter p-parameter-number   as integer      no-undo.
      770   define input  parameter p-parameter-list     as character    no-undo.
      771   define output parameter p-parameter-value   as logical      no-undo.
      772       if num-entries( p-parameter-list ) > p-parameter-number - 1
      773       then do:
      774           assign
      775               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      776           .
      777       end.
      778       else do:
      779           assign
      780               p-parameter-value   = no
      781           .
      782       end.
      783   end.
      784   end procedure.
      785   procedure schedule-attr-get-free-id :
      786   do
      787   on error undo, return error return-value
      788   :
      789     define input  parameter p-cre-db-num  as integer   no-undo.
      790     define input  parameter p-task-type   as character no-undo.
      791     define input  parameter p-task-num    as integer   no-undo.
      792     define output parameter p-free-id     as character no-undo.
      793     define buffer buf_schedule-attr for ub.schedule-attr.
      794     find first buf_schedule-attr no-lock
      795         where buf_schedule-attr.cre-db-num = p-cre-db-num
      796           and buf_schedule-attr.task-type  = p-task-type
      797           and buf_schedule-attr.task-num   = p-task-num
      798           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      799     no-error .
      800     if available buf_schedule-attr then
      801     assign
      802     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      803     no-error
      804     .
      805   end.
      806   end procedure.
      807   procedure schedule-attr-get-free-props :
      808     define input parameter p-free-id as character no-undo .
      809     define output parameter p-value as character no-undo .
      810     define buffer buf_temp-schedule-free for temp-schedule-free.
      811     do
      812     on error undo, return error return-value
      813     :
      814       find first buf_temp-schedule-free no-lock no-error .
      815       if not available buf_temp-schedule-free then do:
      816         run schedule-attr-fill-free-props in this-procedure .
      817       end.
      818       find first buf_temp-schedule-free where
      819               buf_temp-schedule-free.free-id = p-free-id no-error.
      820       if available buf_temp-schedule-free then do:
      821         assign
      822         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      823                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      824                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      825                   buf_temp-schedule-free.conf-param           + chr(4) +
      826                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      827                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      828                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      829                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      830                   buf_temp-schedule-free.other-info
      831         .
      832       end.
      833       else do:
      834        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      835                              "id произвольной задачи - &5"
      836                              ,vss-workfile
      837                              ,vss-revision
      838                              ,vss-description
      839                              ,chr(10)
      840                              ,p-free-id).
      841       end.
      842     end.
      843   end procedure.
      844   procedure schedule-attr-is-rum-free-id :
      845   define input parameter p-free-id as character no-undo .
      846   define output parameter p-is-rum as logical no-undo .
      847   define buffer buf_temp-schedule-free for temp-schedule-free.
      848   do
      849   on error undo, return error
      850   :
      851       find first buf_temp-schedule-free no-lock no-error .
      852       if not available buf_temp-schedule-free then do:
      853         run schedule-attr-fill-free-props in this-procedure .
      854       end.
      855       find first buf_temp-schedule-free where
      856               buf_temp-schedule-free.free-id = p-free-id no-error.
      857       if available buf_temp-schedule-free
      858       and buf_temp-schedule-free.is-rum
      859       then do:
      860         p-is-rum = yes.
      861       end.
      862   end.
      863   end procedure.
      864   procedure schedule-attr-fill-free-props :
      865   define variable v-path                    as character                no-undo .
      866   DEFINE VARIABLE v-full-path               as character                no-undo .
      867   DEFINE VARIABLE v-file-name               as character                no-undo .
      868   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      869   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      870   define buffer buf_temp-schedule-free for temp-schedule-free.
      871   define variable v-answer as logical no-undo .
      872     do
      873     on error undo, return error substitute("&1 &2 &3&4&5&4"
      874                                           ,vss-workfile
      875                                           ,vss-revision
      876                                           ,vss-description
      877                                           ,chr(10)
      878                                           ,error-status:get-message(1) )
      879     :
      880       run gbl/filename.p (
      881                       input 'cmp/shd-free.d'
      882                     ,output v-full-path
      883                     ,output v-path
      884                     ,output v-file-name
      885                     ,output v-file-name-no-ext
      886                     ,output v-file-name-ext
      887                     ) .
      888       input from value(v-full-path).
      889       repeat :
      890         create buf_temp-schedule-free.
      891         import buf_temp-schedule-free.
      892       END.
      893       input close.
      894       _ff:
      895       for each buf_temp-schedule-free :
      896         if buf_temp-schedule-free.free-id = '':U then do:
      897            delete buf_temp-schedule-free.
      898            next _ff.
      899          end.
      900          run schedule-attr-check-enc in this-procedure (
      901                                                       input  buf_temp-schedule-free.free-id
      902                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      903                                                               buf_temp-schedule-free.proc-param-edit-name +
      904                                                               buf_temp-schedule-free.conf-param +
      905                                                               string(buf_temp-schedule-free.is-gbd) +
      906                                                               string(buf_temp-schedule-free.is-ubd) +
      907                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      908                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      909                                                               string(buf_temp-schedule-free.other-info)
      910                                                               )
      911                                                       ,input  buf_temp-schedule-free.enc-key
      912                                                       ,output v-answer    ) no-error .
      913          if error-status:error
      914          or not v-answer then delete buf_temp-schedule-free.
      915        end.
      916     end.
      917   end procedure.
      918   Function schedule-attr-reverse returns character (str as character).
      919      define variable rev_incl_s as character init "" no-undo .
      920      define variable rev_incl_i as integer no-undo .
      921      define variable rev_incl_l as integer no-undo .
      922      rev_incl_l = length(str).
      923      do rev_incl_i = 1 to rev_incl_l:
      924         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      925      end.
      926      return rev_incl_s.
      927   end.
      928   procedure schedule-attr-check-enc.
      929     define input  parameter p-free-id   as character no-undo .
      930     define input  parameter p-value     as character no-undo .
      931     define input  parameter p-enc-value as character no-undo .
      932     define output parameter p-answer    as logical   no-undo .
      933     define variable tmp         as character no-undo .
      934     define variable v-enc-value as character no-undo .
      935     assign
      936     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      937     .
      938     run schedule-attr-pswd-enc in this-procedure
      939       ( input tmp
      940        ,output v-enc-value
      941       ) no-error .
      942     if error-status:error then do:
      943       message
      944         vss-workfile vss-revision vss-description skip
      945         "Ошибка при вызове процедуры pswd-enc" skip
      946         return-value skip
      947         error-status :get-message(1) skip
      948         view-as alert-box error .
      949       undo, return error .
      950     end.
      951     if v-enc-value = p-enc-value then do:
      952       assign
      953         p-answer = true
      954       .
      955     end.
      956     else do:
      957       assign
      958         p-answer = false
      959       .
      960     end.
      961   end.
      962   procedure schedule-attr-conf-enc.
      963     define input  parameter p-free-id   as character no-undo .
      964     define input  parameter p-value     as character no-undo .
      965     define output parameter p-enc-value as character no-undo .
      966     define variable tmp         as character no-undo .
      967     assign
      968       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      969     .
      970     run schedule-attr-pswd-enc in this-procedure
      971       ( input tmp
      972        ,output p-enc-value
      973       ) no-error .
      974     if error-status:error then do:
      975       message
      976         vss-workfile vss-revision vss-description skip
      977         "Ошибка при вызове процедуры pswd-enc" skip
      978         return-value skip
      979         error-status :get-message(1) skip
      980         view-as alert-box error .
      981       undo, return error .
      982     end.
      983   end procedure.
      984   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      985   procedure schedule-attr-pswd-enc :
      986     define input parameter  pswd     as character no-undo .
      987     define output parameter enc-pswd as character no-undo .
      988     do
      989     on error undo, return error return-value
      990     :
      991       assign
      992         enc-pswd = encode(pswd + string(index(pswd, "k")))
      993       .
      994     end.
      995   end procedure.
      996   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      997   PROCEDURE verify-ini-entry:
      998   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
      999   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
     1000   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
     1001   DEFINE INPUT  PARAMETER silence          as logical no-undo.
     1002   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
     1003   define variable v-mess as character no-undo .
     1004   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
     1005   if ini-entry-value = ? and ini-key-name begins "spl"
     1006   then
     1007   get-key-value section ini-section-name key "splall" value ini-entry-value.
     1008   if ini-entry-value = ? and ini-key-name begins "sav"
     1009   then
     1010   get-key-value section ini-section-name key "savall" value ini-entry-value.
     1011   if ini-entry-value = ? then do:
     1012     assign
     1013     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
     1014                       , chr(10)
     1015                       , ini-section-name
     1016                       , ini-key-name
     1017                       , error-msg-text).
     1018       if not silence then do:
     1019         message
     1020         v-mess
     1021         view-as alert-box ERROR  .
     1022         return error.
     1023       end.
     1024       else do:
     1025         return error v-mess.
     1026       end.
     1027   end.
     1028   END PROCEDURE.
     1029   PROCEDURE verify-file:
     1030   DEFINE INPUT  PARAMETER filename       as character no-undo.
     1031   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
     1032   DEFINE INPUT  PARAMETER silence        as logical no-undo.
     1033   DEFINE OUTPUT PARAMETER found          as logical no-undo.
     1034   file-info:file-name = filename.
     1035   found = NOT (file-info:full-pathname = ?).
     1036   if NOT found  then do:
     1037     if not silence then do:
     1038       message error-msg-text
     1039       view-as alert-box ERROR.
     1040       return error.
     1041     end.
     1042     else return error error-msg-text.
     1043   end.
     1044   END PROCEDURE.
     1045   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1046   procedure doc-code:
     1047   define input  parameter parmode          as   character           no-undo.
     1048   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
     1049   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
     1050   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
     1051   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
     1052   define buffer buf_sys-ctrl for ub.sys-ctrl  .
     1053   define variable vardb-remote     as   logical             no-undo.
     1054   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
     1055   define variable v-delimiter as character no-undo .
     1056   do
     1057   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1058   :
     1059   find first buf_sys-ctrl no-lock .
     1060   vardb-remote = buf_sys-ctrl.db-num <> 0 .
     1061     CASE parmode:
     1062       when "main":u then do:
     1063         if vardb-remote then do:
     1064           assign
     1065             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
     1066         end.
     1067         else do:
     1068           assign
     1069             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
     1070         end.
     1071       end.
     1072       when "trio" then do:
     1073         assign
     1074           pardoc-code = replace (parroot-doc-code, "=", "*").
     1075       end.
     1076       otherwise do:
     1077         assign
     1078         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
     1079         no-error
     1080         .
     1081         if error-status:error  then do:
     1082           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     1083                                         ,chr(10)
     1084                                         ,parmode
     1085                                         ).
     1086         end.
     1087         if num-entries(parmode) = 1
     1088         and parmode <> "chip":U
     1089         and parmode <> "chip_s":U
     1090         then do:
     1091           assign
     1092           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     1093         end.
     1094         else if (lookup("chip":U, parmode) > 0
     1095                  or
     1096                  lookup("chip_s":U, parmode) > 0) then do:
     1097           assign
     1098             vartemp-doc-code = parroot-doc-code.
     1099           do while true:
     1100             if index (vartemp-doc-code , ".") = 0 then
     1101               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     1102             else
     1103               vartemp-doc-code  =
     1104               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     1105               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     1106               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     1107             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     1108           end.
     1109           assign
     1110             pardoc-code = vartemp-doc-code.
     1111         end.
     1112       end.
     1113     end CASE.
     1114     if pardoc-code = '':U
     1115     or (parroot-doc-code <> '':U
     1116     and pardoc-code = parroot-doc-code) then do:
     1117       undo, return error substitute("Ошибка при генерации номера документа&1"
     1118                                     ,chr(10)).
     1119     end.
     1120   end.
     1121   end. // procedure/method
     1122   function get-doc-code-int64 returns int64
     1123     ( input p-doc-code as character ) :
     1124     define variable v-ind              as integer   no-undo .
     1125     define variable v-num-entries      as integer   no-undo .
     1126     define variable v-doc-code-int64   as int64     no-undo .
     1127     define variable v-canonic-doc-code as character no-undo .
     1128     assign
     1129       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     1130       v-canonic-doc-code = p-doc-code
     1131     .
     1132     do v-ind = 1 to v-num-entries
     1133     :
     1134       assign
     1135         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     1136       .
     1137     end.
     1138     assign
     1139       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     1140     .
     1141     return v-doc-code-int64 .
     1142   end. // function/method
