     1463           when 'trn-reas-sug':U then do:
     1464             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1465               assign
     1466                 ptrlprop-trn-reas-sug = thbjattr_thbj-attr.property-value-logical
     1467               .
     1468             end.
     1469           end.
     1470                 when 'rvd-own-nb':U then do:
     1471             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1472               assign
     1473                 ptrlprop-rvd-own-nb = thbjattr_thbj-attr.property-value-logical
     1474               .
     1475             end.
     1476           end.
     1477           when 'qr-scan-time':U then do:
     1478             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1479               assign
