     2865   end.
     2866   procedure add-msg :
     2867     define input parameter p-err as logical   no-undo .
     2868     define input parameter p-msg as character no-undo .
     2869     do
     2870     on error  undo, return error substitute( "&1 (add-msg). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2871     on stop   undo, return error substitute( "&1 (add-msg). stop", vss-workfile )
     2872     on endkey undo, return error substitute( "&1 (add-msg). endkey", vss-workfile )
     2873     :
     2874       if v-ret-msg <> "":U then do:
     2875         assign
     2876           v-ret-msg = v-ret-msg + chr(10)
     2877         .
     2878       end.
     2879       if p-err = true then do:
     2880         assign
     2881           v-ret-msg = v-ret-msg + substitute( "ОШИБКА! &2", p-msg )
     2882         .
     2883       end.
     2884       assign
     2885         v-ret-msg = v-ret-msg + p-msg
     2886       .
     2887     end.
     2888   end procedure.
