     1258   define input parameter  p-value    like ub.place-attr.attr-value .
     1259   define output parameter p-ok       as logical.
     1260   define buffer buf_place-attr for ub.place-attr .
     1261     do on error undo, return error return-value :
     1262        p-ok = false.
     1263        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1264                                                   and buf_place-attr.obj-code    = p-obj-code
     1265                                                   and buf_place-attr.obj-type    = p-obj-type
     1266                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1267        if available buf_place-attr then do :
