     2689                         input  ( if available prev_rvs-doc  then prev_rvs-doc.rvs-code  else ? ) ,
     2690                         input  ( if available prev_icnt-doc then prev_icnt-doc.doc-code else ? ) ,
     2691                         input  cur_shift-obj.shift-date ,
     2692                         input  cur_shift-obj.shift-num ,
     2693                         input  yes ,
     2694                         input no ) no-error .
     2695         if error-status :error then do:
     2696           run add-msg in this-procedure
     2697             ( input true
     2698             , input substitute( 'Ошибка при создании строк ТРК документа сверки для объекта &1 &2 .&3&4&3&5'
     2699                                 , v-obj-type
     2700                                 , v-obj-code
     2701                                 , chr(10)
     2702                                 , error-status :get-message( 1 )
     2703                                 , return-value
