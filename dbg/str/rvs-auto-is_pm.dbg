     1199   procedure placelib_write-attr:
     1200   define input  parameter p-code     like ub.place-attr.attr-code .
     1201   define input  parameter p-obj-code like ub.place-attr.obj-code .
     1202   define input  parameter p-obj-type like ub.place-attr.obj-type .
     1203   define input  parameter p-pl-code  like ub.place-attr.pl-code .
     1204   define input  parameter p-value    like ub.place-attr.attr-value .
     1205   define output parameter p-ok       as logical.
     1206   define buffer buf_place-attr for ub.place-attr .
     1207     do on error undo, return error return-value :
     1208        p-ok = false.
     1209        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1210                                                   and buf_place-attr.obj-code    = p-obj-code
     1211                                                   and buf_place-attr.obj-type    = p-obj-type
     1212                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1213        if not available buf_place-attr then do :
     1214           create buf_place-attr.
     1215           assign
     1216             buf_place-attr.attr-code   = p-code
     1217             buf_place-attr.attr-value  = p-value
     1218             buf_place-attr.obj-code    = p-obj-code
     1219             buf_place-attr.obj-type    = p-obj-type
     1220             buf_place-attr.pl-code     = p-pl-code
     1221           .
     1222           p-ok = true.
     1223        end.
     1224        else do:
     1225           buf_place-attr.attr-value  = p-value .
     1226           p-ok = true.
     1227        end.
     1228     end.
     1229   end.
     1230   procedure placelib_get-attr:
     1231   define input  parameter  p-code     like ub.place-attr.attr-code .
     1232   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     1233   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     1234   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     1235   define output parameter  p-value    like ub.place-attr.attr-value .
     1236   define output parameter  p-ok       as logical.
     1237   define buffer buf_place-attr for ub.place-attr .
     1238     do on error undo, return error return-value :
     1239        p-ok = false.
     1240        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     1241                                                   and buf_place-attr.obj-code    = p-obj-code
     1242                                                   and buf_place-attr.obj-type    = p-obj-type
     1243                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1244        if available buf_place-attr then do :
     1245          p-value = buf_place-attr.attr-value.
     1246          p-ok = true.
     1247        end.
     1248        else do :
     1249          p-ok = false.
     1250        end.
     1251     end.
     1252   end.
     1253   procedure placelib_del-attr:
