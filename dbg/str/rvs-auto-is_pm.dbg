     2742                                   , error-status :get-message( 1 )
     2743                                   , return-value
     2744                                 )
     2745               ) .
     2746           end.
     2747         end.
     2748       end.
     2749       for each buf_rvs-line exclusive-lock
     2750         where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     2751           and buf_rvs-line.obj-type = buf_rvs-doc.obj-type
     2752           and buf_rvs-line.obj-code = buf_rvs-doc.obj-code
     2753       on error undo Main-Block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2754       :
     2755         if ptrlprop-autopump = true then do:
     2756           for each buf_rvs-line-pump exclusive-lock
     2757             where buf_rvs-line-pump.rvs-code    = buf_rvs-line.rvs-code
     2758               and buf_rvs-line-pump.obj-type    = buf_rvs-line.obj-type
     2759               and buf_rvs-line-pump.obj-code    = buf_rvs-line.obj-code
     2760               and buf_rvs-line-pump.pl-code     = buf_rvs-line.pl-code
     2761               and buf_rvs-line-pump.gds-code    = buf_rvs-line.gds-code
     2762           on error undo Main-Block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2763           :
     2764             if buf_rvs-line-pump.meas-am-cnt = ?
     2765               or buf_rvs-line-pump.meas-cf-cnt = ?
     2766               or buf_rvs-line-pump.meas-el-cnt = ?
     2767               or buf_rvs-line-pump.meas-mh-cnt = ?
     2768             then do:
     2769               delete buf_rvs-line-pump .
     2770             end.
     2771             else do:
     2772               if buf_rvs-line-pump.state-el-cnt = ?
     2773                 or buf_rvs-line-pump.state-mh-cnt = ?
     2774               then do:
     2775                 assign
     2776                   buf_rvs-line-pump.state-el-cnt = buf_rvs-line-pump.meas-el-cnt
     2777                   buf_rvs-line-pump.state-mh-cnt = buf_rvs-line-pump.meas-mh-cnt
     2778                 .
     2779               end.
     2780             end.
     2781           end.
     2782         end.
     2783         if buf_rvs-line.state-measure-qnty = ?
     2784           or buf_rvs-line.state-density = ?
     2785           or buf_rvs-line.state-density = 0.00
     2786         then do:
     2787           delete buf_rvs-line .
     2788         end.
     2789       end.
     2790       find first buf_rvs-line no-lock
     2791         where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     2792           and buf_rvs-line.obj-type = buf_rvs-doc.obj-type
     2793           and buf_rvs-line.obj-code = buf_rvs-doc.obj-code
     2794         no-error .
     2795       if not available buf_rvs-line then do:
     2796         delete buf_rvs-doc.
     2797         run add-msg in this-procedure
     2798           ( input false
     2799           , input substitute( 'Для объекта &1 &2 сверка не создана, т.к. нет данных с приборов.'
     2800                               , v-obj-type
     2801                               , v-obj-code
     2802                             )
     2803           ) .
     2804         undo block_obj, next block_obj .
     2805       end.
     2806   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_rvs-full in g#lib-rvs ( input buf_rvs-doc.rvs-code )  .
     2807   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_rvsclchd in g#lib-rvs ( input recid( buf_rvs-doc ) ,
