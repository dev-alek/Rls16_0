     1297   procedure get-ptrl-prop :
     1298     define input  parameter p-obj-type as character no-undo .
     1299     define input  parameter p-obj-code as integer   no-undo .
     1300     do
     1301     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1302     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
     1303     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
     1304     :
     1305       define variable par-type          as character no-undo.
     1306       define variable v-value-character as character no-undo .
     1307       define variable v-value-date      as date      no-undo .
     1308       define variable v-value-decimal   as decimal   no-undo .
     1309       define variable v-value-integer   as integer   no-undo .
     1310       define variable v-value-logical   as logical   no-undo .
     1311       for each thbjattr_thbj-attr
     1312       :
     1313         delete thbjattr_thbj-attr .
     1314       end.
     1315       run adm/shattri.p
     1316         ( input "get":U
     1317         , input p-obj-type
     1318         , input p-obj-code
     1319         , input 'petrol':U
     1320         , input  ""
     1321         , output v-value-character
     1322         , output v-value-date
     1323         , output v-value-decimal
     1324         , output v-value-integer
     1325         , output v-value-logical
     1326         , output par-type
     1327         , input-output table thbjattr_thbj-attr
     1328         ) no-error .
     1329       for each thbjattr_thbj-attr
     1330       on error undo, return error return-value
     1331       :
     1332         case thbjattr_thbj-attr.prop-code :
     1333           when 'denstclc':U then do:
     1334             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
     1335               assign
     1336                 ptrlprop-denstclc = thbjattr_thbj-attr.property-value-character
     1337               .
     1338             end.
     1339           end.
     1340           when 'expptrl':U then do:
     1341             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
     1342               and thbjattr_thbj-attr.prop-value-type = 'character':U
     1343             then do:
     1344               assign
     1345                 ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
     1346               .
     1347             end.
     1348           end.
     1349           when 'inpptrl':U then do:
     1350             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
     1351               and thbjattr_thbj-attr.prop-value-type = 'character':U
     1352             then do:
     1353               assign
     1354                 ptrlprop-inpptrl = thbjattr_thbj-attr.property-value-character
     1355               .
     1356             end.
     1357           end.
     1358           when 'autopump':U then do:
     1359             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1360               assign
     1361                 ptrlprop-autopump = thbjattr_thbj-attr.property-value-logical
     1362               .
     1363             end.
     1364           end.
     1365           when 'rvsnmter':U then do:
     1366             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1367               assign
     1368                 ptrlprop-rvsnmter = thbjattr_thbj-attr.property-value-logical
     1369               .
     1370             end.
     1371           end.
     1372           when 'avtinvpm':U then do:
     1373             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1374               assign
     1375                 ptrlprop-avtinvpm = thbjattr_thbj-attr.property-value-logical
     1376               .
     1377             end.
     1378           end.
     1379           when 'invclipt':U then do:
     1380             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1381               assign
     1382                 ptrlprop-invclipt = thbjattr_thbj-attr.property-value-integer
     1383               .
     1384             end.
     1385           end.
     1386           when 'olddens':U then do:
     1387             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1388               assign
     1389                 ptrlprop-olddens = thbjattr_thbj-attr.property-value-logical
     1390               .
     1391             end.
     1392           end.
     1393           when 'algrvspt':U then do:
     1394             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1395               assign
     1396                 ptrlprop-algrvspt = thbjattr_thbj-attr.property-value-integer
     1397               .
     1398             end.
     1399           end.
     1400           when 'temp-for-pomi':U then do:
     1401             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1402               assign
     1403                 ptrlprop-temp-for-pomi = thbjattr_thbj-attr.property-value-integer
     1404               .
     1405             end.
     1406           end.
     1407           when 'algoincome':U then do:
     1408             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1409               assign
     1410                 ptrlprop-algoincome = thbjattr_thbj-attr.property-value-integer
     1411               .
     1412             end.
     1413           end.
     1414           when 'mand-choice-autocar':U then do:
     1415             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1416               assign
     1417                 ptrlprop-mand-choice-autocar = thbjattr_thbj-attr.property-value-logical
     1418               .
     1419             end.
     1420           end.
     1421           when 'block-nozzle':U then do:
     1422             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1423               assign
     1424                 ptrlprop-block-nozzle = thbjattr_thbj-attr.property-value-logical
     1425               .
     1426             end.
     1427           end.
     1428           when 'timeout-block-nozzle':U then do:
     1429             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1430               assign
