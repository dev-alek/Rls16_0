     2729                         input              buf_rvs-doc.rvs-code ,
     2730                         input              true ,
     2731                         input-output table tt-pump-nozzle-file ,
     2732                         input-output table tt-pump-nozzle ) no-error .
     2733           if error-status :error
     2734             or return-value <> "":U
     2735           then do:
     2736             run add-msg in this-procedure
     2737               ( input true
     2738               , input substitute( 'Ошибка при получении данных с приборов на ТРК для объекта &1 &2 .&3&4&3&5'
     2739                                   , v-obj-type
     2740                                   , v-obj-code
