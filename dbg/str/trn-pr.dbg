     2236   procedure proc-history :
     2237     define variable loc-ref-list as character no-undo.
     2238     define variable loc-doc-save as recid     no-undo.
     2239     define variable loc-mode     as character no-undo.
     2240     define variable loc#stat     as character no-undo.
     2241     define variable loc#type     as character no-undo.
     2242     define variable loc#internal as logical   no-undo.
     2243     define buffer buffer_trn-doc for ub.trn-doc.
