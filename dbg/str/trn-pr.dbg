        1   define input        parameter parparentproc as handle    no-undo.
        2   define input        parameter pardoc-rec    as recid     no-undo.
        3   define input        parameter pardoc-mode   as character no-undo.
        4   define input-output parameter parnext-prev  as logical   no-undo.
        5   define input        parameter parstat       as character no-undo.
        6   define input        parameter partype       as character no-undo.
        7   define input        parameter parinternal   as logical   no-undo.
        8   define input        parameter br-handle     as handle no-undo.
        9   define input        parameter bf-handle     as handle no-undo.
