      119   define new global shared variable g#library  as handle no-undo .
      120   define new global shared variable g#library2 as handle no-undo .
      121   define new global shared variable g#lib-trn  as handle no-undo .
      122   define new global shared variable g#lib-trn2 as handle no-undo .
      123   define new global shared variable g#lib-trn3 as handle no-undo .
      124   define new global shared variable g#lib-trn4 as handle no-undo .
      125   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126   procedure doc-code:
      127   define input  parameter parmode          as   character           no-undo.
      128   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      129   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      130   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      131   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      132   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      133   define variable vardb-remote     as   logical             no-undo.
      134   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      135   define variable v-delimiter as character no-undo .
      136   do
      137   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      138   :
      139   find first buf_sys-ctrl no-lock .
      140   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      141     CASE parmode:
      142       when "main":u then do:
      143         if vardb-remote then do:
      144           assign
      145             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      146         end.
      147         else do:
      148           assign
      149             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      150         end.
      151       end.
      152       when "trio" then do:
      153         assign
      154           pardoc-code = replace (parroot-doc-code, "=", "*").
      155       end.
      156       otherwise do:
      157         assign
      158         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      159         no-error
      160         .
      161         if error-status:error  then do:
      162           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      163                                         ,chr(10)
      164                                         ,parmode
      165                                         ).
      166         end.
      167         if num-entries(parmode) = 1
      168         and parmode <> "chip":U
      169         and parmode <> "chip_s":U
      170         then do:
      171           assign
      172           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      173         end.
      174         else if (lookup("chip":U, parmode) > 0
      175                  or
      176                  lookup("chip_s":U, parmode) > 0) then do:
      177           assign
      178             vartemp-doc-code = parroot-doc-code.
      179           do while true:
      180             if index (vartemp-doc-code , ".") = 0 then
      181               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      182             else
      183               vartemp-doc-code  =
      184               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      185               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      186               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      187             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      188           end.
      189           assign
      190             pardoc-code = vartemp-doc-code.
      191         end.
      192       end.
      193     end CASE.
      194     if pardoc-code = '':U
      195     or (parroot-doc-code <> '':U
      196     and pardoc-code = parroot-doc-code) then do:
      197       undo, return error substitute("Ошибка при генерации номера документа&1"
      198                                     ,chr(10)).
      199     end.
      200   end.
      201   end. // procedure/method
      202   function get-doc-code-int64 returns int64
      203     ( input p-doc-code as character ) :
      204     define variable v-ind              as integer   no-undo .
      205     define variable v-num-entries      as integer   no-undo .
      206     define variable v-doc-code-int64   as int64     no-undo .
      207     define variable v-canonic-doc-code as character no-undo .
      208     assign
      209       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      210       v-canonic-doc-code = p-doc-code
      211     .
      212     do v-ind = 1 to v-num-entries
      213     :
      214       assign
      215         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      216       .
      217     end.
      218     assign
      219       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      220     .
      221     return v-doc-code-int64 .
      222   end. // function/method
      223   define new global shared variable g#libbcrcn as handle no-undo .
      224   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      225   define  stream PrnLibStream.
      226   procedure prn-lib-prn-file :
      227     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      228     define input parameter p-DIsabledoptions as integer no-undo .
      229     define variable v-report-name as character no-undo .
      230     define variable v-user-action as character no-undo .
      231     define variable v-printed     as logical   no-undo .
      232     define variable v-exist       as logical   no-undo .
      233     do
      234       on error undo, return error
      235       :
      236       run prn-lib-get-report-name  in this-procedure (
      237         input parParentProc
      238         ,output v-report-name
      239         ).
      240   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      241   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      242     (input  v-report-name
      243     ,input  2
      244     ,output v-exist
      245     )  .
      246       if NOT v-exist then
      247       DO:
      248         Message
      249           "Нет заданий на печать ! "
      250           view-as alert-box .
      251         Return  .
      252       End.
      253       run gbl/prnfilen.w
      254         (input  ""
      255         ,input  p-DisabledOptions
      256         ,input  string(v-report-name )
      257         ,input  7
      258         ,output v-user-action
      259         ,output v-printed
      260         ) .
      261       if v-printed then
      262       do:
      263         return "YES" .
      264       end.
      265       else
      266       do:
      267         return "NO" .
      268       end.
      269     end.
      270   end procedure.
      271   procedure prn-lib-open-stream :
      272     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      273     define input parameter p-page-size    as integer no-undo .
      274     define input parameter p-is-stream    as logical no-undo .
      275     define input parameter p-append       as logical no-undo .
      276     define variable v-report-name as character no-undo .
      277     do
      278       on error undo, return error
      279       :
      280       run prn-lib-get-report-name  in this-procedure (
      281         input parParentProc
      282         ,output v-report-name
      283         ).
      284       if p-is-stream then
      285       do:
      286         if p-append then
      287         do:
      288           output stream PrnLibStream to value( v-report-name )
      289             page-size value(p-page-size) append .
      290         end.
      291         if not p-append then
      292         do:
      293           output stream PrnLibStream to value( v-report-name )
      294             page-size value(p-page-size) .
      295         end.
      296       end.
      297       if not p-is-stream then
      298       do:
      299         if p-append then
      300         do:
      301           output to value( v-report-name )
      302             page-size value(p-page-size) append .
      303         end.
      304         if not p-append then
      305         do:
      306           output to value( v-report-name )
      307             page-size value(p-page-size) .
      308         end.
      309       end.
      310     end.
      311   end procedure.
      312   procedure prn-lib-open-exp :
      313     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      314     define input parameter p-is-stream    as logical no-undo .
      315     define input parameter p-is-append    as logical no-undo .
      316     define output parameter p-ReportFileName as char init "report" no-undo.
      317     define output parameter p-process as logical no-undo .
      318     define variable glog as logical no-undo .
      319     do
      320       on error undo, return error
      321       :
      322       SYSTEM-DIALOG GET-FILE p-ReportFileName
      323         TITLE      "Укажите путь"
      324         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      325         ASK-OVERWRITE
      326         CREATE-TEST-FILE
      327         SAVE-AS
      328         USE-FILENAME
      329         DEFAULT-EXTENSION "txt"
      330         UPDATE glog
      331         .
      332       if not glog then  return.
      333       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      334       if p-is-stream then
      335       do:
      336         if p-is-append then
      337         do:
      338           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      339         end.
      340         else
      341         do:
      342           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      343         end.
      344       end.
      345       else
      346       do:
      347         if p-is-append then
      348         do:
      349           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      350         end.
      351         else
      352         do:
      353           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      354         end.
      355       end.
      356       p-process = yes.
      357     end.
      358   end procedure.
      359   procedure prn-lib-get-report-name :
      360     define input parameter parParentProc  as widget-handle no-undo.
      361     define output parameter p-report-name as character no-undo .
      362     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      363   end procedure.
      364   procedure prn-lib-reportviewer-report-name :
      365     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      366     define input parameter p-report-name-html as character no-undo .
      367     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      368   end procedure.
      369   procedure prn-lib-reportviewer :
      370     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      371     define input parameter p-report-name-html as character no-undo .
      372     define input parameter p-param        as character no-undo .
      373     define variable v-excel           as character no-undo init 'TRUE' .
      374     define variable v-value-character as character no-undo .
      375     define variable v-value-integer   as character no-undo .
      376     define variable v-value-date      as date      no-undo .
      377     define variable v-value-decimal   as decimal   no-undo .
      378     define variable rep-excel         as logical   no-undo .
      379     define variable excel-string      as character no-undo .
      380     define variable v-param-type      as character no-undo .
      381     define variable v-tth             as handle    no-undo .
      382     run adm/shattri.p (
      383       input "get":U
      384       ,input  ""
      385       ,input  0
      386       ,input  'report-glob':U
      387       ,input  'rep-excel':U
      388       ,output v-value-character
      389       ,output v-value-date
      390       ,output v-value-decimal
      391       ,output v-value-integer
      392       ,output rep-excel
      393       ,output v-param-type
      394       ,INPUT-OUTPUT table-handle v-tth
      395       )  .
      396     if rep-excel then v-excel = "TRUE" .
      397     else v-excel = "FALSE" .
      398     if p-param eq ""
      399     then
      400        p-param = "EXCEL:" + v-excel.
      401     else
      402        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      403     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      404   end procedure.
      405   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      406   define variable v-waitfram-action01         as character   no-undo .
      407   define variable v-waitfram-action02         as character   no-undo .
      408   define variable v-waitfram-action03         as character   no-undo .
      409   define variable mWaitFramTextBeg            as character   no-undo.
      410   define variable mWaitFramTextEnd            as character   no-undo.
      411   define variable mWaitFramView               as logical     no-undo.
      412   define variable mWaitProcEvent              as logical     no-undo init yes.
      413   define variable mWaitFramInterval           as integer     no-undo init 1 .
      414   define variable mWaitFramStop               as logical     no-undo.
      415   define variable mWaitFramStopUser           as logical     no-undo.
      416   define variable mWaitFramStopTimeOut        as logical     no-undo.
      417   define variable mWaitFramStartProc          as datetime-tz no-undo.
      418   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      419   define button B-WaitFramStop auto-end-key
      420        label "Стоп"
      421        size 10 by 1 tooltip "Остоновить процесс".
      422   define button B-viewProcInfo
      423        label "Информация"
      424        size 15 by 1 tooltip "Информация о процесс".
      425   define frame waitfram
      426     v-waitfram-action01 format "x(72)" no-label skip
      427     v-waitfram-action02 format "x(72)" no-label skip
      428     v-waitfram-action03 format "x(72)" no-label skip
      429     B-viewProcInfo
      430     B-WaitFramStop at row 4 col 30
      431     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      432     .
      433   define new global shared variable mBatchMode as logical no-undo init ?.
      434   define variable mFramBachModHandle as handle no-undo.
      435   mFramBachModHandle = frame waitfram:handle.
      436   define variable mFameOldVis as logical no-undo.
      437   define variable mVisCUrentVin as logical no-undo.
      438   if session:batch-mode
      439   then
      440      mBatchMode = yes.
      441   if mBatchMode = ? then do:
      442     mVisCUrentVin = current-window:visible.
      443     mFameOldVis = mFramBachModHandle:visible.
      444     mFramBachModHandle:visible  = yes.
      445     mBatchMode = mFramBachModHandle:visible ne yes.
      446     mFramBachModHandle:visible = mFameOldVis.
      447     current-window:visible = mVisCUrentVin.
      448   end.
      449    if  log-manager:logfile-name ne ?
      450     then DO:
      451         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      452         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      453         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      454     end.
      455   on choose of B-WaitFramStop in frame waitfram
      456   do:
      457     mWaitFramStop = yes.
      458     mWaitFramStopUser = yes.
      459   end.
      460   function waitfram-check-timeout returns logical():
      461      define variable vtime as int64 no-undo.
      462      if mWaitFramStopTimeOut
      463      then
      464         return yes.
      465      vtime = ( now - mWaitFramStartProc ) / 1000 .
      466      if     mWaitFramTimeOut ne ?
      467         and mWaitFramTimeOut ne 0
      468         and mWaitFramTimeOut lt vtime
      469      then do:
      470         mWaitFramStopTimeOut = yes.
      471      end.
      472      return mWaitFramStopTimeOut.
      473   end.
      474   procedure waitfram-hide :
      475     if not session:batch-mode
      476     then do
      477     on error undo, return error return-value
      478     :
      479       pause 0 before-hide .
      480       if not mBatchMode then
      481         hide frame waitfram .
      482     if     not mWaitFramView
      483        and mWaitProcEvent
      484     then
      485       process events .
      486     end.
      487   end procedure.
      488   procedure waitfram-show :
      489     define input  parameter p-message as character no-undo .
      490     define variable v-left-margin as integer   no-undo .
      491     if not session:batch-mode
      492     then do
      493     on error undo, return error return-value
      494     :
      495       if length(p-message) <= 70 then do:
      496         assign
      497           v-left-margin = integer((70 - length(p-message)) / 2)
      498         .
      499         assign
      500           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      501         .
      502         assign
      503           v-waitfram-action01 = " "
      504           v-waitfram-action02 = " "
      505                                    + fill(" ", v-left-margin)
      506                                    + p-message
      507           v-waitfram-action03 = " "
      508         .
      509       end.
      510       else do:
      511         define variable vRindex1 as integer no-undo.
      512         define variable vRindex2 as integer no-undo.
      513         vRindex1 = r-index(p-message," ",70).
      514         if vRindex1 = 0
      515         then
      516            vRindex1 = 70.
      517         if length(p-message)  <= vRindex1 + 70 then do:
      518           assign
      519             v-waitfram-action01 = " "
      520             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      521             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      522           .
      523         end.
      524         else do:
      525           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      526           if vRindex2 <= vRindex1
      527           then
      528              vRindex2 = vRindex1 + 70.
      529           assign
      530             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      531             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      532             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      533           .
      534         end.
      535       end.
      536       B-viewProcInfo:visible   in frame waitfram = no.
      537       B-viewProcInfo:sensitive in frame waitfram = no.
      538       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      539       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      540       if  (   mWaitFramView
      541          or  mWaitProcEvent)
      542          and not mBatchMode
      543       then
      544          display
      545             v-waitfram-action01 skip
      546             v-waitfram-action02 skip
      547             v-waitfram-action03 skip
      548          with frame waitfram .
      549       if     mWaitFramView
      550          then do:
      551             if     mWaitFramInterval ne ?
      552                and not mBatchMode
      553             then
      554                wait-for go of frame waitfram pause mWaitFramInterval.
      555          end.
      556          else
      557             if     mWaitProcEvent
      558                and not mBatchMode
      559             then
      560                process events .
      561     end.
      562   end procedure.
      563      procedure waitfram-show-this:
      564         define input  parameter iInterval as int64 no-undo.
      565         define variable vtime as int64 no-undo.
      566         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      567         mWaitFramInterval = iInterval.
      568         run waitfram-show (substitute("&1&2 &3&4" ,
      569                                       mWaitFramTextBeg ,
      570                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      571                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      572                                       mWaitFramTextEnd
      573                                      )
      574                           ).
      575      end.
      576      procedure WaitFramRunPause:
      577         define input  parameter iInterval as dec no-undo.
      578         define variable vStart  as datetime-tz no-undo.
      579         define variable vend    as datetime-tz no-undo.
      580         define variable vint as int64 no-undo.
      581         define variable vOk as logical no-undo.
      582         vStart = now.
      583         vend   = vStart.
      584         publish "WaitFramPause" (iInterval,output vOk).
      585         vend   =  now.
      586         vint = vend - vStart.
      587         vint = iInterval - vint / 1000.
      588         if     not mWaitFramStop
      589            and (   vint > 0
      590                 or (    not vOk
      591                     and iInterval eq ?
      592                     )
      593                 )
      594         then
      595            run waitfram-show-this (iInterval).
      596         vend   =  now.
      597         vint = vend - vStart.
      598         vint = iInterval - vint / 1000.
      599         if     not mWaitFramStop
      600            and vint > 0
      601         then do:
      602            run gbl/pause.p (vint * 1000).
      603         end.
      604         if iInterval ne ?
      605         then
      606            publish "WaitFramStop".
      607         waitfram-check-timeout().
      608      end.
      609      procedure WaitFramWaitFor:
      610         define input  parameter iInterval as dec no-undo.
      611         assign
      612            mWaitFramStartProc   = now
      613            mWaitFramStopUser    = no
      614            mWaitFramStopTimeOut = no
      615         .
      616         block-wait:
      617         do while not mWaitFramStop:
      618            run WaitFramRunPause (iInterval).
      619            if  waitfram-check-timeout()
      620            then do:
      621               leave block-wait.
      622            end.
      623         end.
      624         run waitfram-hide.
      625      end.
      626   procedure waitfram-join :
      627     define input  parameter p-line-1  as character no-undo .
      628     define input  parameter p-line-2  as character no-undo .
      629     define input  parameter p-line-3  as character no-undo .
      630     define output parameter p-message as character no-undo .
      631     do
      632     on error undo, return error return-value
      633     :
      634       assign
      635         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      636                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      637                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      638       .
      639     end.
      640   end procedure.
      641   function waitfram-join-function returns character
      642     (input p-line-1 as character
      643     ,input p-line-2 as character
      644     ,input p-line-3 as character
      645     ).
      646     define variable v-message as character no-undo .
      647     run waitfram-join in this-procedure
      648       (input  p-line-1
      649       ,input  p-line-2
      650       ,input  p-line-3
      651       ,output v-message
      652       ) .
      653     return v-message .
      654   end function .
