     1858   procedure ver-clients :
     1859   define input  parameter p-obj-type as character no-undo .
     1860   define input  parameter p-obj-code as integer   no-undo .
     1861   define output parameter p-error as logical   no-undo .
     1862   define variable v-veto-man-doc as character no-undo .
     1863   define variable v-type        as character no-undo .
     1864     do
     1865     on error undo, return error return-value
     1866     :
     1867     p-error = false .
     1868   run clntattr-value in this-procedure (
     1869    input p-obj-type ,
     1870    input p-obj-code ,
     1871    input 'veto-man-doc':U     ,
     1872    output v-veto-man-doc ,
     1873    output v-type        ) no-error .
     1874    if error-status :error then message
     1875      error-status :get-message(1) skip
     1876      return-value skip
     1877      "Ошибка clntattr-veto-man-doc"
     1878      view-as alert-box error
     1879    .
     1880     if v-veto-man-doc = 'ALL' then do:
     1881         message "Запрещено создание документа на этого контрагента оператору вручную." view-as alert-box error  .
     1882         p-error = true .
     1883     end.
     1884    end.
     1885   end procedure.
     1886   on end-error, stop of frame d-trn-pr do:
     1887     apply "choose" to b-exit in frame d-trn-pr.
     1888     return no-apply.
     1889   end.
     1890   on choose of b-notes in frame d-trn-pr run notes-tr.
     1891   on choose of b-history   in frame d-trn-pr do:
     1892     run proc-history in this-procedure no-error.
     1893     if error-status :error then do: return no-apply. end.
     1894   end.
     1895   on choose of b-exit  in frame d-trn-pr
     1896   do:
     1897     run proc-exit no-error.
     1898     if error-status :error then do: return no-apply. end.
     1899   end.
     1900   procedure mode-on :
     1901   define variable varout-ret-supp like ub.trn-doc.ret-supp no-undo.
     1902   define variable varout-pay-code like ub.trn-doc.pay-code no-undo.
     1903   define variable vardoc-code     like ub.trn-doc.doc-code no-undo.
     1904   define variable v-today         as date                  no-undo.
     1905   define buffer cli_clients  for ub.clients.
     1906   define buffer cli_firm     for ub.firm.
     1907   define buffer main_clients for ub.clients.
     1908   define buffer cli_sysconf  for ub.sysconf.
     1909   define variable varpurch-code as integer   no-undo.
     1910   define variable varbase-code as integer no-undo.
     1911   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1912   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1913     (input  v-cntxt-host-code-obj
     1914     ,output varbase-code
     1915     )  .
     1916   do on error undo, return error :
     1917   case pardoc-mode :
     1918     when 'ДОБАВЛЕНИЕ':U then do:
     1919   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1920   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1921     (input  v-cntxt-obj-type
     1922     ,input  v-cntxt-obj-code
     1923     ,output v-today
     1924     )  .
     1925       find last ub.curr-accnt where ub.curr-accnt.curr-code = varbase-code
     1926           and ub.curr-accnt.exch-date <= v-today use-index pi no-lock no-error.
     1927       if not available ub.curr-accnt then do:
     1928         message "На дату" v-today "неизвестен курс базовой валюты.".
     1929         undo, return error.
     1930       end.
     1931       if parinternal = ? then do:
     1932         message "Неизвестно, внутренний или внешний документ.".
     1933         undo, return error.
     1934       end.
     1935       if parinternal and partype = 'возврат':U then do:
     1936         message "Для внутреннего перемещения можно создать только расход."
     1937                         "Остальные документы создаются автоматически.".
     1938         undo, return error.
     1939       end.
     1940   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1941   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1942     (input  v-cntxt-obj-type
     1943     ,input  v-cntxt-obj-code
     1944     ,output v-today
     1945     )  .
     1946       run doc-code in this-procedure
     1947         (input  "main",
     1948          input  v-cntxt-obj-type,
     1949          input  v-cntxt-obj-code,
     1950          input  ?,
     1951          output vardoc-code ) no-error.
     1952       if error-status :error then do:
     1953         message "Ошибка при генерации номера документа." return-value view-as alert-box.
     1954         return error.
     1955       end.
     1956   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crtrndoc in g#lib-trn
     1957   (input ?
     1958   ,input ?
     1959   ,input ub.curr-accnt.exch-rate
     1960   ,input ub.curr-accnt.exch-scale
     1961   ,input ?
     1962   ,input ?
     1963   ,input ?
     1964   ,input v-cntxt-db-num
     1965   ,input v-cntxt-userid
     1966   ,input   ''
     1967   ,input vardoc-code
     1968   ,input v-today
     1969   ,input   'при':U
     1970   ,input no
     1971   ,input v-cntxt-host-code-obj
     1972   ,input parinternal
     1973   ,input v-cntxt-obj-code
     1974   ,input v-cntxt-obj-type
     1975   ,input no
     1976   ,input   v-cntxp-in-pay
     1977   ,input '@  '
     1978   ,input   no
     1979   ,input  ?
     1980   ,input   'накл':U
     1981   ,input  ?
     1982   ,input parext-doc-type
     1983   ,input
     1984           ?
     1985   ) no-error
     1986   .
     1987       if error-status :error then do:
     1988         undo, return error return-value.
     1989       end.
     1990       find t-doc where t-doc.doc-code = vardoc-code.
     1991       assign
     1992         pardoc-rec = recid (t-doc)
     1993         .
     1994          if not can-find(first ub.pay-type where ub.pay-type.obj-code = t-doc.pay-code no-lock) then do:
     1995             message "В настройках текущего объекта указан вид оплаты прихода: " v-cntxp-in-pay ", которого нет в справочнике!"
     1996                      view-as alert-box error buttons ok.
     1997             undo, return error.
     1998          end.
     1999     end.
     2000     when 'ПРОСМОТР':U then do:
     2001       find t-doc no-lock where recid( t-doc ) = pardoc-rec no-error.
     2002       if available t-doc then do:
     2003         if t-doc.internal = ? then do:
     2004           message "Документ был заведен неверно и удаляется!!!" view-as alert-box.
     2005           find t-doc exclusive-lock where recid( t-doc ) = pardoc-rec.
     2006           delete t-doc.
     2007           return.
     2008         end.
     2009         if parext-doc-mode <> "":U then do:
     2010           find t-doc exclusive-lock where recid( t-doc ) = pardoc-rec.
     2011         end.
     2012       end.
     2013     end.
     2014     when 'ИЗМЕНЕНИЕ':U then do:
     2015       find t-doc where recid (t-doc) = pardoc-rec no-error.
     2016       if available t-doc then do:
     2017         if t-doc.cli-code = ? then do:
     2018           message "Документ был заведен неверно и удаляется!!!" view-as alert-box.
     2019           delete t-doc.
     2020           return.
     2021         end.
     2022         if t-doc.flag_ = yes and t-doc.status_ = 'накл':U and t-doc.doc-type <> 'при':U and t-doc.ext-doc-type <> 'eo':U then do:
     2023           find t-doc where recid (t-doc) = pardoc-rec.
     2024           message "Факт. кол-во можно проставлять только в статусе разрешен.".
     2025           undo, return error.
     2026         end.
     2027         if t-doc.status_ = 'касс':U then do:
     2028           find t-doc where recid (t-doc) = pardoc-rec.
     2029           message "Все действия с кассовыми отчетами выполняются из АРМ Магазин.".
     2030           undo, return error.
     2031         end.
     2032         if t-doc.status_ = 'факт':U or
     2033            (t-doc.flag_ = yes and t-doc.status_ = 'запрос':U) then do:
     2034           find t-doc where recid (t-doc) = pardoc-rec.
     2035           message "Документ уже закрыт. Изменение невозможно.".
     2036           undo, return error.
     2037         end.
     2038         if  t-doc.flag_ = yes
     2039         then do:
     2040           define variable v-obj-active  as logical   no-undo .
     2041   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2042   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2043     (input  t-doc.obj-type
     2044     ,input  t-doc.obj-code
     2045     ,input  'active=request':u
     2046     ,output v-obj-active
     2047     )  .
     2048           if v-obj-active <> true
     2049           then do:
     2050             find t-doc
     2051               where recid (t-doc) = pardoc-rec.
     2052             message
     2053               "Коррекция фактического количества допустима только в базе данных объекта" skip
     2054               "Документ" t-doc.doc-code skip
     2055               "Объект" t-doc.obj-type t-doc.obj-code skip
     2056               view-as alert-box information .
     2057             undo, return error.
     2058           end.
     2059         end.
     2060         find t-doc exclusive-lock
     2061           where recid (t-doc) = pardoc-rec
     2062           .
     2063       end.
     2064     end.
     2065   end.
     2066   if not available t-doc
     2067   then do:
     2068     message "Неправильно выбран документ.".
     2069     undo, return error.
     2070   end.
     2071   end.
     2072   end procedure.
     2073   procedure notes-tr:
     2074   define variable notes as character no-undo.
     2075   assign
     2076     notes = t-doc.PS.
     2077   if pardoc-mode = 'ПРОСМОТР':U then do:
     2078     run gbl/d-prompt.w (
     2079         'title=Примечание\'
     2080       + 'type=editor\'
     2081       + 'fillin_width=96\'
     2082       + 'fillin_height=15\'
     2083       + 'readonly=yes\'
     2084       , input-output notes).
     2085   end.
     2086   else do:
     2087      run gbl/d-prompt.w (
     2088         'title=примечание\'
     2089       + 'type=editor\'
     2090       + 'fillin_width=96\'
     2091       + 'fillin_height=15\'
     2092       , input-output notes).
     2093       if return-value = 'false':u then return .
     2094     if t-doc.PS <> notes then do:
     2095     if pardoc-rec = ? then pardoc-rec = recid (t-doc).
     2096       do transaction on error undo, return error return-value :
     2097         find t-doc where recid (t-doc) = pardoc-rec exclusive.
     2098         assign
     2099           t-doc.PS = notes.
     2100       end.
     2101     end.
     2102   end.
     2103   end procedure.
     2104   procedure choose-cli:
     2105   define variable varfirm-code like ub.firm.firm-code no-undo.
     2106   define variable v-types as character no-undo .
     2107   define buffer bf_clients for ub.clients.
     2108   define variable ref-rec as recid no-undo.
     2109   define variable v-rid-list as character no-undo .
     2110   do on error undo, return error return-value :
     2111   run check-cli no-error.
     2112   if error-status :error then do:
     2113     if t-doc.internal then v-types = 'маг':U.
     2114                       else v-types = 'все':U.
     2115     if (t-doc.ext-doc-type = 'ee':U or t-doc.ext-doc-type = 'ep':U) and
     2116        varhold            = "yes"              and
     2117        paris-hold         = yes                then do:
     2118       assign
     2119         varfirm-code = ?.
     2120       run adm/sconfs.w ( input parparentproc
     2121                       , input "b-sel":U
     2122                       , input no
     2123                       , input ?
     2124                       , output varfirm-code
     2125                       , input-output v-rid-list) no-error.
     2126       if error-status :error or
     2127          varfirm-code = ?   then do:
     2128         return error.
     2129       end.
     2130       find first bf_clients where bf_clients.obj-type = 'орг':U       and
     2131                                   bf_clients.obj-code = varfirm-code no-lock.
     2132       assign ref-list = string(recid (bf_clients)).
     2133       run check-base-code in this-procedure (recid(bf_clients)).
     2134     end.
     2135     else do:
     2136       if transaction = yes then do:
     2137         message "Критическая ошибка." skip
     2138                 "Вы находитесь в транзакции." skip
     2139                 "Работа со справочником клиентов невозможна."
     2140         view-as alert-box error.
     2141         return error.
     2142       end.
     2143       run ref/cli-all.w ( parparentproc
     2144                      , "b-sel,b-add"
     2145                      , v-types
     2146                      , ?
     2147                      , ?
     2148                      , ?
     2149                      , ?
     2150                      , ?
     2151                     , output ref-list) .
     2152     end.
     2153     if ref-list <> "" then do:
     2154       ref-rec = integer (ref-list).
     2155       find ub.clients where recid ( ub.clients ) = ref-rec no-lock.
     2156       disp ub.clients.obj-code @ t-doc.cli-code
     2157               ub.clients.obj-name with frame d-trn-pr.
     2158     if pardoc-mode = 'ДОБАВЛЕНИЕ':U then
     2159       disp ub.clients.obj-type @ t-doc.cli-type with frame d-trn-pr.
     2160     end.
     2161     run check-cli no-error.
     2162     if error-status :error then do:
     2163       return error return-value.
     2164     end.
     2165   end.
     2166   end.
     2167   end procedure.
     2168   procedure proc-exit :
     2169     define variable v-vat-pc   as decimal no-undo .
     2170     define variable v-slt-pc   as decimal no-undo .
     2171     define variable v-insalepr as logical no-undo .
     2172     assign parnext-prev = ?.
     2173     if t-doc.ext-doc-type = 'ep':U  and pardoc-mode <> 'ПРОСМОТР':U then do:
     2174        run str/ep-corrp.p (input parparentproc , input t-doc.doc-code ) no-error.
     2175     end.
     2176   end procedure.
     2177   procedure check-base-code :
     2178   define input parameter parrec-id as recid no-undo.
     2179   define variable varmy-host-code  like ub.sysconf.host-code no-undo.
     2180   define variable varmy-base-code  like ub.sysconf.base-code no-undo.
     2181   define variable varcli-base-code like ub.sysconf.base-code no-undo.
     2182   define buffer bf-my_currency  for ub.currency.
     2183   define buffer bf-cli_currency for ub.currency.
     2184   define buffer bf_clients for ub.clients.
     2185   do on error undo, return error return-value :
     2186     find first bf_clients where recid(bf_clients) = parrec-id no-lock.
