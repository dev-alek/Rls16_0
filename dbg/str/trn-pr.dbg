     1188   DEFINE QUERY br-dtl FOR gds-dtl, gds-prt, goods, bar-code SCROLLING.
     1189   DEFINE BROWSE br-dtl QUERY br-dtl NO-LOCK DISPLAY
     1190         bar-code.b-code
     1191         gds-dtl.artic
     1192         goods.gds-name
     1193         (if gds-prt.node-name = '_Пустая шкала':U then "-" else
     1194          if gds-prt.upper-code = goods.prt-root then "-------------------" else gds-prt.node-name)
     1195              COLUMN-LABEL "Признак" FORMAT "x(10)"
     1196         gds-dtl.fact-qnty COLUMN-LABEL "Факт"
     1197         goods.unit-base
     1198         gds-dtl.cur-base   COLUMN-LABEL "Прод. цена "
     1199         gds-dtl.price-rubl COLUMN-LABEL "Цена док-та (РУБ)"
     1200         gds-dtl.price-base COLUMN-LABEL "Цена док-та (Б.В)"
     1201       WITH SIZE 98.5 BY 12 separators.
     1202   DEFINE FRAME d-trn-pr
     1203        t-doc.fact-date AT ROW 2 COL 30 COLON-ALIGNED format "99/99/9999" LABEL "Дата"
     1204                        VIEW-AS FILL-IN SIZE 9 BY 1 fgcolor 4
     1205        t-doc.fact-qnty AT ROW 3 COL 30 COLON-ALIGNED LABEL "Количество по док-ту"
     1206                        view-as fill-in size 17 by 1 fgcolor 4
     1207        v-temp          AT ROW 2 COL 70 COLON-ALIGNED
     1208                        VIEW-AS FILL-IN SIZE 17 BY 1 fgcolor 4
     1209        t-doc.tot-ov    AT ROW 3 COL 70 COLON-ALIGNED
     1210                        VIEW-AS FILL-IN SIZE 17 BY 1 fgcolor 4
     1211        b-exit AT ROW 1 COL 1
     1212        b-prev AT ROW 1 COL 9
     1213        b-next AT ROW 1 COL 13
     1214        b-print AT ROW 1 COL 17
     1215        b-notes AT ROW 1 COL 25
     1216        b-arch AT ROW 1 COL 33
     1217        b-history AT ROW 1 COL 41
     1218        b-help AT ROW 1 COL 49
     1219        br-dtl AT ROW 4 COL 1
     1220        loc-art AT ROW 16 COL 35 COLON-ALIGNED label "Начало артикула"
     1221        loc-name AT ROW 16 COL 35 COLON-ALIGNED label "Начало названия" format "x(40)"
     1222        loc-code AT ROW 16 COL 35 COLON-ALIGNED label "Бар-код (весь)" format "x(13)"
     1223        a-n-c at row 16 col 77 no-label
     1224        SPACE(0) SKIP(0) WITH VIEW-AS DIALOG-BOX SIDE-LABELS THREE-D SCROLLABLE .
     1225   ASSIGN
     1226          br-dtl:NUM-LOCKED-COLUMNS IN FRAME d-trn-pr = 2.
