     2253     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2254       (input  v-cntxt-db-num
     2255       ,input  v-cntxt-userid
     2256       ,input  0
     2257       ,input  'actn_c-documents_all':U
     2258       ,input  'object':U
     2259       ,input  v-cntxt-host-code-obj
     2260       ,input  v-cntxt-obj-type
     2261       ,input  v-cntxt-obj-code
     2262       ,input  0
     2263       ,input  0
     2264       ,input  0
     2265       ,input  true
     2266       ,output varlog
     2267       )  .
     2268   end.
     2269       if varlog <> yes then do: return no-apply. end.
     2270       run str/calldocs.w (  input  parparentproc,
     2271                         input  'doc':U,
     2272                         input  buffer_trn-doc.status_,
     2273                         input  buffer_trn-doc.doc-type,
     2274                         input  buffer_trn-doc.flag_,
