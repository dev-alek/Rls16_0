     2286   ON CHOOSE OF b-print IN FRAME d-trn-pr
     2287   DO:
     2288     define variable print_petrol as logical no-undo.
     2289     run CheckPetrol in this-procedure ( input t-doc.doc-code, output print_petrol ) no-error.
     2290     if error-status :error or print_petrol = ? then do: assign print_petrol = no. end.
     2291     if print_petrol = yes then do: run rep/autoact0.p ( input parparentproc, input recid( t-doc ), input "all":U ). end.
     2292                           else do: run rep/avt-akt0.p ( input parparentproc, input recid( t-doc ), input "all":U ). end.
     2293     run prn-lib-prn-file in this-procedure (
     2294                                               input parParentProc
     2295                                               ,input 8
     2296                                               ).
     2297     apply "ENTRY":U to br-dtl in frame d-trn-pr.
     2298   END.
     2299   ON CHOOSE OF b-arch IN FRAME d-trn-pr
     2300   DO:
     2301   define variable varbase-code as integer no-undo.
     2302   define buffer bf_currency for ub.currency.
     2303   define variable vss-include-info30 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2304   do:
     2305     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2306       (input  v-cntxt-db-num
     2307       ,input  v-cntxt-userid
     2308       ,input  0
     2309       ,input  'actn_archive_cost':U
     2310       ,input  'object':U
     2311       ,input  t-doc.host-code
     2312       ,input  t-doc.obj-type
     2313       ,input  t-doc.obj-code
     2314       ,input  0
     2315       ,input  0
     2316       ,input  0
     2317       ,input  true
     2318       ,output varlog
     2319       )  .
     2320   end.
     2321   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2322   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2323     (input  t-doc.host-code
     2324     ,output varbase-code
     2325     )  .
     2326   find first bf_currency where bf_currency.curr-code = varbase-code no-lock.
     2327   if varlog <> yes then return no-apply.
     2328   message "Сумма в учетных ценах:" skip
     2329                   string (t-doc.fact-base, "->>,>>>,>>9.99") bf_currency.curr-abbr skip
     2330                   string (t-doc.fact-rubl, "->>,>>>,>>>,>>9.99") "РУБ" skip (2)
     2331                   "Сумма в ценах документа:" skip
     2332                   string (t-doc.tot-fact, "->>,>>>,>>9.99") bf_currency.curr-abbr skip
     2333                   string (t-doc.tot-sale, "->>,>>>,>>>,>>9.99") "РУБ" skip (2)
     2334                   "Разница:" skip
     2335                   string (t-doc.tot-fact - t-doc.fact-base, "->>,>>>,>>9.99")
     2336                   bf_currency.curr-abbr skip
     2337                   string (t-doc.tot-sale - t-doc.fact-rubl, "->>,>>>,>>>,>>9.99")
     2338                     "РУБ" skip (2)
     2339                   "Наценка:"
     2340                   string ((t-doc.tot-fact - t-doc.fact-base) / t-doc.fact-base * 100, "->>9.9<%")
     2341                   view-as alert-box title "Док-т №: " + string (t-doc.doc-code) + "  от: " + string (t-doc.doc-date).
     2342   END.
     2343   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-trn-pr:PARENT eq ?
     2344   THEN FRAME d-trn-pr:PARENT = ACTIVE-WINDOW.
     2345   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2346   on help of frame d-trn-pr
     2347   do:
     2348     run gbl/app_help.p
     2349       (input this-procedure :file-name
     2350       ,input ''
     2351       ,input ?
     2352       ) no-error.
     2353     if error-status :error then do:
     2354       message
     2355         "Ошибка при вызове помощи"
     2356         error-status :get-message(1)
     2357         view-as alert-box .
     2358     end.
     2359   end.
     2360   run minbtn-set in this-procedure .
     2361   on choose of b-help in frame d-trn-pr
     2362   do:
     2363     apply "help":u to frame d-trn-pr .
     2364   end.
     2365   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2366   procedure minbtn-set :
     2367       do
     2368           on error undo, return error return-value
     2369           :
     2370           define variable ii              as integer       no-undo .
     2371           define variable fh              as widget-handle no-undo .
     2372           define variable hh              as widget-handle no-undo .
     2373           define variable v-h             as handle        extent 4 no-undo .
     2374           define variable v-name-button   as character     no-undo .
     2375           define variable v-help-old-x    as decimal       no-undo .
     2376           define variable v-help-old-y    as decimal       no-undo .
     2377           define variable v-help-old-size as decimal       no-undo .
     2378           define variable v-frame-width   as decimal       no-undo .
     2379           define variable jj              as integer       no-undo .
     2380           do
     2381               on error undo, return error
     2382               :
     2383               assign
     2384                   v-frame-width = frame d-trn-pr:width - 0.3
     2385                   fh            = frame d-trn-pr:first-child
     2386                   hh            = fh:first-child
     2387                   ii            = 1
     2388                   .
     2389               do while valid-handle(hh):
     2390                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2391                   do:
     2392                       case lc(hh:name) :
     2393                           when "b-help" then
     2394                               do:
     2395                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2396                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2397                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2398                                   hh:TOOLTIP = "Помощь" .
     2399                                   v-help-old-x = hh:column .
     2400                                   v-help-old-y = hh:row    .
     2401                                   v-help-old-size = hh:width .
     2402                                   hh:width-chars = 2.5 .
     2403                               end.
     2404                           when "b-print" then
     2405                               do:
     2406                                   hh:load-image("cmp/b-print.bmp":u) .
     2407                                   hh:TOOLTIP = "Печать" .
     2408                                   v-h[ii] = hh:handle .
     2409                                   ii = ii + 1 .
     2410                                   hh:width-chars = 3 .
     2411                               end.
     2412                           when "b-history" or
     2413                           when "b-hist" then
     2414                               do:
     2415                                   hh:load-image("cmp/b-hist.bmp":u) .
     2416                                   hh:TOOLTIP = "История" .
     2417                                   v-h[ii] = hh:handle .
     2418                                   ii = ii + 1 .
     2419                                   hh:width-chars = 3 .
     2420                               end.
     2421                           when "b-sch" then
     2422                               do:
     2423                                   hh:load-image("cmp/b-sch.bmp":u) .
     2424                                   hh:TOOLTIP = "Установка Фильтра" .
     2425                                   v-h[ii] = hh:handle .
     2426                                   ii = ii + 1 .
     2427                                   hh:width-chars = 3 .
     2428                               end.
     2429                           when "b-hist-user" then
     2430                               do:
     2431                                   hh:load-image("cmp/b-hist.bmp":u) .
     2432                                   hh:TOOLTIP = "История пользователя" .
     2433                                   ii = ii + 1 .
     2434                               end.
     2435                       end case.
     2436                   end.
     2437                   hh = hh:next-sibling.
     2438               end.
     2439               b-help:column = v-frame-width - b-help:width-chars.
     2440               jj = 0.
     2441               repeat ii = 4 to 1 by -1 :
     2442                   if valid-handle (v-h[ii] ) then
     2443                   do:
     2444                       jj  = jj + 1 .
     2445                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2446                       v-h[ii]:row    = v-help-old-y .
     2447                   end.
     2448               end.
     2449           end.
     2450       end.
     2451   end procedure.
     2452   ON WINDOW-CLOSE OF FRAME d-trn-pr APPLY "END-ERROR":U TO SELF.
     2453   parnext-prev = yes.
     2454   n-p: do while parnext-prev :
     2455   MAIN-BLOCK:
     2456   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2457      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2458      ON STOP UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2459   run mode-on no-error.
     2460   if error-status:error then return error.
     2461   assign
     2462     gds-dtl.cur-base  :label      = if var-pr-r-b = 'base' then "Прод. цена (баз.вал.)"  else "Прод. цена (РУБ)"
     2463     gds-dtl.price-rubl:visible    = if var-pr-r-b = 'rubl' then yes else no
     2464     gds-dtl.price-base:visible    = if var-pr-r-b = 'base' then yes else no
     2465     v-temp            :label      = if var-pr-r-b = 'base' then "Сумма ФАКТ (баз.вал.)" else "Сумма ФАКТ (РУБ)"
     2466     t-doc.tot-ov      :label      = if var-pr-r-b = 'base' then "Сумма АКТа (баз.вал.)" else "Сумма АКТа (РУБ)"
     2467     goods.gds-name :resizable  = true
     2468     .
     2469   run UI-on.
     2470   WAIT-FOR GO OF FRAME d-trn-pr focus br-dtl.
     2471   END.
     2472   if parnext-prev <> ? then parnext-prev = yes.
     2473   end.
     2474   RUN disable_UI.
     2475   PROCEDURE disable_UI :
     2476     HIDE FRAME d-trn-pr.
     2477   END PROCEDURE.
     2478   PROCEDURE UI-on :
     2479     assign
     2480       v-temp = ( if var-pr-r-b = "base" then t-doc.tot-fact else t-doc.tot-sale )
     2481     .
     2482     display v-temp
     2483             t-doc.fact-date
     2484             t-doc.fact-qnty
     2485             t-doc.tot-ov
     2486     with frame d-trn-pr.
     2487     hide loc-art  in frame d-trn-pr
     2488          loc-name in frame d-trn-pr
     2489          loc-code in frame d-trn-pr.
     2490     assign
     2491       loc-art = "":U
     2492     .
     2493     enable b-exit b-help b-print br-dtl b-arch b-history a-n-c b-notes b-prev b-next with frame d-trn-pr.
     2494     assign
     2495       frame d-trn-pr :title = "Акт ПЕРЕОЦЕНКИ для док-та :    " + t-doc.doc-type +
     2496                                    " № " + t-doc.doc-code + "            - " + pardoc-mode
     2497     .
     2498     OPEN QUERY br-dtl   FOR EACH gds-dtl no-lock WHERE            gds-dtl.doc-code = t-doc.doc-code and            gds-dtl.ov = yes,       EACH gds-prt no-lock WHERE            gds-prt.node-code = gds-dtl.prt-code,       EACH goods no-lock WHERE            goods.artic     = gds-dtl.artic and            goods.prod-code = gds-dtl.prod-code and            goods.prod-type = gds-dtl.prod-type,       FIRST bar-code no-lock WHERE             bar-code.gds-code  = goods.gds-code and             bar-code.node-code = gds-dtl.prt-code and             bar-code.in-code   = "" and             bar-code.part-code = "".
     2499   END PROCEDURE.
     2500   PROCEDURE CheckPetrol :
     2501     DEFINE  INPUT PARAMETER p-doc-code     LIKE ub.trn-doc.doc-code NO-UNDO.
     2502     DEFINE OUTPUT PARAMETER p-print-petrol AS   LOGICAL             NO-UNDO INITIAL NO.
     2503     DEFINE VARIABLE j_petrol  AS INTEGER NO-UNDO.
     2504     DEFINE VARIABLE j_total   AS INTEGER NO-UNDO.
     2505     DEFINE VARIABLE l_answer  AS LOGICAL NO-UNDO.
     2506     DEFINE VARIABLE is-petrol AS LOGICAL NO-UNDO.
     2507     DEFINE VARIABLE is-pieces AS LOGICAL NO-UNDO.
     2508     DEFINE BUFFER buf_doc-line FOR ub.doc-line.
     2509     DO ON ERROR UNDO, RETURN ERROR :
     2510       FOR EACH buf_doc-line NO-LOCK WHERE buf_doc-line.doc-code = p-doc-code :
     2511         ASSIGN j_total = j_total + 1.
     2512   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     2513     (
     2514        input buf_doc-line.artic
     2515     ,  input buf_doc-line.prod-type
     2516     ,  input buf_doc-line.prod-code
     2517     , output is-petrol
     2518     , output is-pieces
     2519     ) NO-ERROR.
     2520         IF ERROR-STATUS :ERROR OR is-petrol <> YES OR is-pieces <> NO THEN DO: NEXT. END.
     2521         ASSIGN j_petrol = j_petrol + 1.
     2522       END.
     2523       IF j_total > 0 AND j_petrol > 0 THEN DO:
     2524         MESSAGE "Напечатать акт переоценки только для топлива?" VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE l_answer.
     2525       END.
     2526     END.
     2527   END PROCEDURE.
