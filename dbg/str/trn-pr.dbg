     1234     run ref/gds-form.w ( input parparentproc
     1235                         ,input 'ПРОСМОТР':U
     1236                         ,input ?
     1237                         ,input ?
     1238                         ,input ?
     1239                         ,input-output gds-rec).
     1240     apply "entry" to br-dtl in frame d-trn-pr.
     1241     return no-apply.
     1242   end.
