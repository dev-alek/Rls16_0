     1300   ON return OF loc-code IN FRAME d-trn-pr do:
     1301     run proc-mouse-dbl-click-loc-code in this-procedure   no-error.
     1302     return no-apply.
     1303   end.
     1304   ON return, Ctrl-J OF loc-name IN FRAME d-trn-pr do:
     1305     run proc-mouse-dbl-click-loc-name in this-procedure   no-error.
     1306     return no-apply.
     1307   end.
     1308   PROCEDURE proc-valchg-a-n-c:
     1309     case input frame d-trn-pr a-n-c :
     1310       when "art" then do:
     1311         apply "entry" to br-dtl in frame d-trn-pr.
     1312         hide loc-name loc-code
     1313         in frame d-trn-pr.
     1314         loc-art = "".
     1315       end.
     1316       when "name" then do:
     1317         enable loc-name with frame d-trn-pr.
     1318         disp loc-name with frame d-trn-pr.
     1319         hide loc-art loc-code
     1320         in frame d-trn-pr.
     1321         apply "entry" to loc-name in frame d-trn-pr.
     1322       end.
     1323       when "code"
     1324    or when "DataMatrix" then
     1325       do:
     1326         enable loc-code with frame d-trn-pr.
     1327         disp loc-code with frame d-trn-pr.
     1328         hide loc-art loc-name
     1329         in frame d-trn-pr.
     1330         apply "entry" to loc-code in frame d-trn-pr.
     1331       end.
     1332     end CASE.
     1333   END PROCEDURE.
     1334   PROCEDURE proc-any-printable-br-dtl :
     1335     if input frame d-trn-pr a-n-c = "art" then do:
     1336       if last-event:label = " " and
     1337          loc-art = "" then
     1338       return error.
     1339       find first l-gds-dtl where
     1340                  l-gds-dtl.doc-code = t-doc.doc-code and l-gds-dtl.artic begins (loc-art + last-event:label)
     1341                  no-lock no-error.
     1342       if available l-gds-dtl then do:
     1343         loc-art = loc-art + last-event:label.
     1344         disp loc-art with frame d-trn-pr.
     1345         recid(gds-dtl) = recid (l-gds-dtl).
     1346         reposition br-dtl to recid recid(gds-dtl) no-error.
     1347       end.
     1348     end.
     1349   END PROCEDURE.
     1350   PROCEDURE proc-backspace-br-dtl:
     1351     if input frame d-trn-pr a-n-c = "art" then do:
     1352       if loc-art = "" then
     1353         return error.
     1354       loc-art = substr (loc-art, 1, length (loc-art) - 1).
     1355       find first l-gds-dtl where
     1356                  l-gds-dtl.doc-code = t-doc.doc-code and l-gds-dtl.artic begins loc-art
     1357                  no-lock.
     1358       disp loc-art with frame d-trn-pr.
     1359       recid(gds-dtl) = recid (l-gds-dtl).
     1360       reposition br-dtl to recid recid(gds-dtl) no-error.
     1361     end.
     1362   END PROCEDURE.
     1363   PROCEDURE proc-mouse-dbl-click-loc-code:
     1364   def var str-code as integer no-undo.
     1365   define variable varresult   as character         no-undo.
     1366   define variable vartype-bc  as character         no-undo.
     1367   define variable varweight   as decimal           no-undo.
     1368   define buffer l-goods for ub.goods.
     1369   define buffer l-bar-code for ub.bar-code.
     1370   define buffer buf_bar-code for ub.bar-code .
     1371   define buffer buf_prod-bc for ub.prod-bc.
     1372   define buffer buf_place for ub.place.
     1373     assign
     1374     frame d-trn-pr
     1375     loc-code
     1376     a-n-c.
     1377     if a-n-c = "datamatrix"
     1378     then do:
     1379   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_dm-rcnz in g#libbcrcn
     1380   (
     1381    input  parparentproc
     1382   ,input  loc-code
     1383   ,input  ?
     1384   ,input  v-cntxt-obj-type
     1385   ,input  v-cntxt-obj-code
     1386   ,input  yes
     1387   ,input  no
     1388   ,input  varscales-pref16
     1389   ,input  varpgscales-pref16
     1390   ,output varresult
     1391   ,output vartype-bc
     1392   ,output varweight
     1393   ,buffer buf_bar-code
     1394   ,buffer buf_prod-bc
     1395   ,buffer buf_place
     1396   ) no-error.
     1397        if varresult eq "prod-bc"
     1398        then
     1399           loc-code:screen-value in frame d-trn-pr = buf_prod-bc.b-str.
     1400     end.
     1401     else do:
     1402   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     1403   (
     1404    input  parparentproc
     1405   ,input  loc-code
     1406   ,input  ?
     1407   ,input  v-cntxt-obj-type
     1408   ,input  v-cntxt-obj-code
     1409   ,input  yes
     1410   ,input  no
     1411   ,input  varscales-pref16
     1412   ,input  varpgscales-pref16
     1413   ,output varresult
     1414   ,output vartype-bc
     1415   ,output varweight
     1416   ,buffer buf_bar-code
     1417   ,buffer buf_prod-bc
     1418   ,buffer buf_place
     1419   ) no-error.
     1420   end.
     1421     if available buf_bar-code then do:
     1422           find first l-goods where
     1423                     l-goods.gds-code =
     1424     buf_bar-code.gds-code No-LOCK.
     1425           find first l-gds-dtl where l-gds-dtl.doc-code = t-doc.doc-code and
     1426                     l-gds-dtl.artic = l-goods.artic AND
     1427                     l-gds-dtl.prod-type = l-goods.prod-type AND
     1428                     l-gds-dtl.prod-code = l-goods.prod-code no-lock no-error.
     1429       if available l-gds-dtl then do:
     1430         recid(gds-dtl) = recid (l-gds-dtl).
     1431         reposition br-dtl to recid recid(gds-dtl) no-error.
     1432       end.
     1433       else do:
     1434         message "Строка не найдена."
     1435                 view-as alert-box error.
     1436       end.
     1437     end.
     1438     else
     1439       message "Бар-код не найден."
     1440               view-as alert-box error.
     1441     apply "entry" to loc-code in frame d-trn-pr.
     1442   END PROCEDURE.
     1443   PROCEDURE  proc-mouse-dbl-click-loc-name:
     1444     assign
     1445     frame d-trn-pr
     1446     loc-name.
     1447       if last-event:label = "Ctrl-J" then
     1448         find next l-gds-dtl where l-gds-dtl.doc-code = t-doc.doc-code and
     1449                   can-find (ub.goods where ub.goods.artic = l-gds-dtl.artic and
     1450                   ub.goods.prod-type = l-gds-dtl.prod-type and
     1451                   ub.goods.prod-code = l-gds-dtl.prod-code and
     1452                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     1453       else
     1454         find first l-gds-dtl where l-gds-dtl.doc-code = t-doc.doc-code and
     1455                   can-find (ub.goods where ub.goods.artic = l-gds-dtl.artic and
     1456                   ub.goods.prod-type = l-gds-dtl.prod-type and
     1457                   ub.goods.prod-code = l-gds-dtl.prod-code and
     1458                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     1459       if available l-gds-dtl then do:
     1460         recid(gds-dtl) = recid (l-gds-dtl).
     1461         reposition br-dtl to recid recid(gds-dtl) no-error.
     1462       end.
     1463       else do:
     1464         message "Строка не найдена."
     1465                 view-as alert-box error.
     1466       end.
     1467     apply "entry" to loc-name in frame d-trn-pr.
     1468   END PROCEDURE.
     1469   on value-changed of br-dtl in frame d-trn-pr do:
     1470   if not available ub.gds-dtl or recid (ub.gds-dtl) <> recid(gds-dtl) then do:
     1471       hide loc-art in frame d-trn-pr.
     1472       loc-art = "".
     1473   end.
     1474   end.
     1475   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1476   def var vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1477   function func-get-name-from-ext-type   returns char
     1478     ( p-ext-type as character   ,
     1479       p-caps     as logical ).
     1480   define variable v-ext-name as character no-undo .
     1481   run get-name-from-ext-type in this-procedure (
     1482       input p-ext-type  ,
     1483       input p-caps  ,
     1484       output v-ext-name )
     1485       no-error .
     1486       if error-status :error then do:
     1487          assign
     1488            v-ext-name = p-ext-type
     1489          .
     1490       end.
     1491    return (v-ext-name) .
     1492   end.
     1493   procedure get-name-from-ext-type :
     1494    do
     1495    on error undo, return error return-value
     1496    :
     1497   define input  parameter p-ext-type as character no-undo .
     1498   define input  parameter p-caps     as logical no-undo   .
     1499   define output parameter p-ext-name as character no-undo .
     1500   define variable v-num as integer no-undo .
     1501     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
     1502       message
     1503         vss-include-info19 skip
     1504         "Неправильно задано значение входящего параметра! "
     1505         "Нет такого типа документов " p-ext-type
     1506         view-as alert-box error .
     1507         undo, return error .
     1508     end.
     1509     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
     1510     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
     1511     if p-caps  = true then do :
     1512        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
     1513     end .
     1514     end.
     1515   end procedure.
     1516   ON CHOOSE OF b-next IN FRAME d-trn-pr
     1517   DO:
     1518     RUN step-next in this-procedure .
     1519   END.
     1520   procedure step-next:
     1521   define variable cur-form as char no-undo.
     1522   define variable new-form as char no-undo.
     1523   define buffer new_trn-doc for ub.trn-doc  .
     1524   case t-doc.doc-type:
     1525     when 'при':U then
     1526       cur-form = if t-doc.internal then 'рас':U else 'при':U.
     1527     when 'рас':U or when 'возврат':U or when 'спи':U then
     1528       cur-form = 'рас':U.
     1529     when 'инв':U then cur-form = 'инв':U.
     1530   end case.
     1531   if bf-handle = ? then return .
     1532   if valid-handle (br-handle) then do:
     1533     varlog = br-handle:select-next-row().
     1534     find first new_trn-doc no-lock where  recid( new_trn-doc ) = bf-handle:recid no-error .
     1535     if not varlog then message "Это последний документ списка.".
     1536   end.
     1537   case new_trn-doc.doc-type:
     1538     when 'при':U then
     1539       new-form = if new_trn-doc.internal then 'рас':U else 'при':U.
     1540     when 'рас':U or when 'возврат':U or when 'спи':U then
     1541       new-form = 'рас':U.
     1542     when 'инв':U then new-form = 'инв':U.
     1543   end case.
     1544   assign
     1545       pardoc-rec   = bf-handle:recid
     1546       parnext-prev = ( cur-form = new-form ) .
     1547   end procedure.
     1548   ON CHOOSE OF b-prev IN FRAME d-trn-pr
     1549   DO:
     1550     run step-prev in this-procedure .
     1551   END.
     1552   procedure step-prev:
     1553   define variable cur-form as char no-undo.
     1554   define variable new-form as char no-undo.
     1555   define buffer new_trn-doc for ub.trn-doc  .
     1556   case t-doc.doc-type:
     1557     when 'при':U then if t-doc.internal then cur-form = 'рас':U. else cur-form = 'при':U.
     1558     when 'рас':U or when 'возврат':U or when 'спи':U then cur-form = 'рас':U.
     1559     when 'инв':U then cur-form = 'инв':U.
     1560   end case.
     1561   if bf-handle = ? then return .
     1562   if valid-handle (br-handle) then do:
     1563     varlog = br-handle:select-prev-row().
     1564     find first new_trn-doc no-lock where  recid( new_trn-doc ) = bf-handle:recid no-error .
     1565     if not varlog then message "Это первый документ списка.".
     1566   end.
     1567   case new_trn-doc.doc-type :
     1568     when 'при':U then if new_trn-doc.internal then new-form = 'рас':U. else new-form = 'при':U.
     1569     when 'рас':U or when 'возврат':U or when 'спи':U then  new-form = 'рас':U.
     1570     when 'инв':U then new-form = 'инв':U.
     1571   end case.
     1572   assign
     1573     pardoc-rec   = bf-handle:recid
     1574     parnext-prev = (cur-form = new-form)
     1575   .
     1576   end procedure.
