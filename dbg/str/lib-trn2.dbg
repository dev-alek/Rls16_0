     2348       bfacc_tt-allsum.vat-rubl-acc        = bf_tt-allsum.vat-rubl-acc
     2349       bfacc_tt-allsum.vat-cli-acc         = bf_tt-allsum.vat-cli-acc
     2350       bfacc_tt-allsum.slt-base-acc        = bf_tt-allsum.slt-base-acc
     2351       bfacc_tt-allsum.slt-rubl-acc        = bf_tt-allsum.slt-rubl-acc
     2352       bfacc_tt-allsum.slt-cli-acc         = bf_tt-allsum.slt-cli-acc
     2353       bfacc_tt-allsum.excise-base-acc     = bf_tt-allsum.excise-base-acc
     2354       bfacc_tt-allsum.excise-rubl-acc     = bf_tt-allsum.excise-rubl-acc
     2355       bfacc_tt-allsum.excise-cli-acc      = bf_tt-allsum.excise-cli-acc
     2356       bfacc_tt-allsum.road-tax-base-acc   = bf_tt-allsum.road-tax-base-acc
     2357       bfacc_tt-allsum.road-tax-rubl-acc   = bf_tt-allsum.road-tax-rubl-acc
     2358       bfacc_tt-allsum.road-tax-cli-acc    = bf_tt-allsum.road-tax-cli-acc
     2359       bfacc_tt-allsum.transport-base-acc  = bf_tt-allsum.transport-base-acc
     2360       bfacc_tt-allsum.transport-rubl-acc  = bf_tt-allsum.transport-rubl-acc
     2361       bfacc_tt-allsum.transport-cli-acc   = bf_tt-allsum.transport-cli-acc
     2362       bfacc_tt-allsum.other-base-acc      = bf_tt-allsum.other-base-acc
     2363       bfacc_tt-allsum.other-rubl-acc      = bf_tt-allsum.other-rubl-acc
     2364       bfacc_tt-allsum.other-cli-acc       = bf_tt-allsum.other-cli-acc
     2365       .
     2366     assign
     2367       bfsacc_tt-allsum.fact-qnty           = bfs_tt-allsum.fact-qnty
     2368       bfsacc_tt-allsum.cli-qnty            = bfs_tt-allsum.cli-qnty
     2369       bfsacc_tt-allsum.sum-dsc-base-doc    = bfs_tt-allsum.sum-dsc-base-acc
     2370       bfsacc_tt-allsum.sum-dsc-rubl-doc    = bfs_tt-allsum.sum-dsc-rubl-acc
     2371       bfsacc_tt-allsum.dsc-base-doc        = bfs_tt-allsum.dsc-base-acc
     2372       bfsacc_tt-allsum.dsc-rubl-doc        = bfs_tt-allsum.dsc-rubl-acc
     2373       bfsacc_tt-allsum.vat-base-doc        = 0
     2374       bfsacc_tt-allsum.vat-rubl-doc        = 0
     2375       bfsacc_tt-allsum.vat-base-buyer-doc  = bfs_tt-allsum.vat-base-acc
     2376       bfsacc_tt-allsum.vat-rubl-buyer-doc  = bfs_tt-allsum.vat-rubl-acc
     2377       bfsacc_tt-allsum.slt-base-doc        = bfs_tt-allsum.slt-base-acc
     2378       bfsacc_tt-allsum.slt-rubl-doc        = bfs_tt-allsum.slt-rubl-acc
     2379       bfsacc_tt-allsum.road-tax-base-doc   = bfs_tt-allsum.road-tax-base-acc
     2380       bfsacc_tt-allsum.road-tax-rubl-doc   = bfs_tt-allsum.road-tax-rubl-acc
     2381       bfsacc_tt-allsum.excise-base-doc     = bfs_tt-allsum.excise-base-acc
     2382       bfsacc_tt-allsum.excise-rubl-doc     = bfs_tt-allsum.excise-rubl-acc
     2383       bfsacc_tt-allsum.sum-dsc-base-cur    = bfs_tt-allsum.sum-dsc-base-acc
     2384       bfsacc_tt-allsum.sum-dsc-rubl-cur    = bfs_tt-allsum.sum-dsc-rubl-acc
     2385       bfsacc_tt-allsum.dsc-base-cur        = bfs_tt-allsum.dsc-base-acc
     2386       bfsacc_tt-allsum.dsc-rubl-cur        = bfs_tt-allsum.dsc-rubl-acc
     2387       bfsacc_tt-allsum.vat-base-cur        = 0
     2388       bfsacc_tt-allsum.vat-rubl-cur        = 0
     2389       bfsacc_tt-allsum.vat-base-buyer-cur  = bfs_tt-allsum.vat-base-acc
     2390       bfsacc_tt-allsum.vat-rubl-buyer-cur  = bfs_tt-allsum.vat-rubl-acc
     2391       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     2392       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     2393       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     2394       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     2395       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     2396       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     2397       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     2398       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     2399       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     2400       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     2401       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     2402       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     2403       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     2404       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     2405       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     2406       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     2407       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     2408       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     2409       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     2410       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     2411       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     2412       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     2413       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     2414       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     2415       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     2416       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     2417       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     2418       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     2419       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     2420       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     2421       .
     2422   end.
     2423   otherwise do:
     2424     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     2425                              cl_tt-clcparts.purch-code,
     2426                              cl_tt-clcparts.part-code,
     2427                              cl_tt-clcparts.out-code,
     2428                              cl_tt-clcparts.in-code,
     2429                              cl_tt-clcparts.artic,
     2430                              cl_tt-clcparts.prod-type,
     2431                              cl_tt-clcparts.prod-code).
     2432   end.
     2433   end case.
     2434   end.
     2435   end procedure.
     2436   procedure clcprtsl_calc-line :
     2437   define input  parameter parrec-line as recid no-undo.
     2438   define variable v-tax-date         as   date                     no-undo.
     2439   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     2440   define variable varr-b             as   character                no-undo.
     2441   define variable varr-btype         as   character                no-undo.
     2442   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     2443   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     2444   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     2445   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     2446   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     2447   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     2448   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     2449   define variable varb-code          like ub.bar-code.b-code       no-undo.
     2450   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2451   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2452   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2453   define variable varexcise          like ub.price-list.excise     no-undo.
     2454   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     2455   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     2456   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     2457   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2458   define variable v-varsum           as decimal                  no-undo.
     2459   define variable varprice-salef as decimal   no-undo .
     2460   define buffer bf_trn-doc             for ub.trn-doc.
     2461   define buffer bf_doc-line            for ub.doc-line.
     2462   define buffer bf_gds-dtl             for ub.gds-dtl.
     2463   define buffer bf_goods               for ub.goods.
     2464   define buffer bf_parts               for ub.parts.
     2465   define buffer bf_sysconf             for ub.sysconf.
     2466   define buffer bf_tt-allsum-line      for tt-allsum-line.
     2467   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     2468   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     2469   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     2470   define buffer buf_parts        for ub.parts.
     2471   v-calcbypart = no.
     2472   do on error undo, return error return-value :
     2473   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2474   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2475     (output varr-b
     2476     )  .
     2477     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     2478     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     2479     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     2480                               bf_goods.prod-type = bf_doc-line.prod-type and
     2481                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     2482     if bf_trn-doc.fact-date <> ?        then do:
     2483       assign v-tax-date = bf_trn-doc.fact-date.
     2484     end.
     2485     else do:
     2486       assign v-tax-date = ?.
     2487     end.
     2488   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2489   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2490     (input  bf_goods.gds-code
     2491     ,input  '1':U
     2492     ,input  v-tax-date
     2493     ,input  bf_trn-doc.host-code
     2494     ,input  bf_trn-doc.obj-type
     2495     ,input  bf_trn-doc.obj-code
     2496     ,output v-vat-pc
     2497     ) no-error .
     2498     if error-status :error
     2499     or v-vat-pc = ? then do:
     2500        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2501     end.
     2502     if bf_goods.gds-type = 'у':U or
     2503        bf_trn-doc.status_ = 'запрос':U then do:
     2504       for each bf_tt-allsum-line
     2505       on error undo, return error return-value
     2506        :
     2507         delete bf_tt-allsum-line.
     2508       end.
     2509       create bf_tt-allsum-line.
     2510       assign
     2511        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     2512       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     2513                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     2514                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     2515                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     2516         assign
     2517           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     2518           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     2519           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     2520           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     2521           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     2522           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2523           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2524           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     2525           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     2526           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     2527           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2528           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2529           bf_tt-allsum-line.vat-cli-acc          =  ?
     2530           .
     2531       end.
     2532       assign
     2533         bf_tt-allsum-line.cli-qnty             =  ?
     2534         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2535         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2536         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2537         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2538         bf_tt-allsum-line.road-tax-base-doc    =  0
     2539         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     2540         bf_tt-allsum-line.excise-base-doc      =  0
     2541         bf_tt-allsum-line.excise-rubl-doc      =  0
     2542         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     2543         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     2544         bf_tt-allsum-line.dsc-base-cur         =  0
     2545         bf_tt-allsum-line.dsc-rubl-cur         =  0
     2546         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2547         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2548         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2549         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2550         bf_tt-allsum-line.road-tax-base-cur    =  0
     2551         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     2552         bf_tt-allsum-line.excise-base-cur      =  0
     2553         bf_tt-allsum-line.excise-rubl-cur      =  0
     2554         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     2555         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     2556         bf_tt-allsum-line.dsc-base-acc         =  0
     2557         bf_tt-allsum-line.dsc-rubl-acc         =  0
     2558         bf_tt-allsum-line.dsc-cli-acc          =  0
     2559         bf_tt-allsum-line.slt-base-acc         =  0
     2560         bf_tt-allsum-line.slt-rubl-acc         =  0
     2561         bf_tt-allsum-line.slt-cli-acc          =  0
     2562         bf_tt-allsum-line.road-tax-base-acc    =  0
     2563         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     2564         bf_tt-allsum-line.road-tax-cli-acc     =  0
     2565         bf_tt-allsum-line.excise-base-acc      =  0
     2566         bf_tt-allsum-line.excise-rubl-acc      =  0
