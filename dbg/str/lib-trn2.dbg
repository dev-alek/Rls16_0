     6547           bf-ext-cli_trn-doc-sum.cost-transport-base   = bf-ext-cli_trn-doc-sum.cost-transport-base  + bf_doc-line-sum.cost-transport-base
     6548           bf-ext-cli_trn-doc-sum.cost-transport-rubl   = bf-ext-cli_trn-doc-sum.cost-transport-rubl  + bf_doc-line-sum.cost-transport-rubl
     6549           bf-ext-cli_trn-doc-sum.cost-other-base       = bf-ext-cli_trn-doc-sum.cost-other-base      + bf_doc-line-sum.cost-other-base
     6550           bf-ext-cli_trn-doc-sum.cost-other-rubl       = bf-ext-cli_trn-doc-sum.cost-other-rubl      + bf_doc-line-sum.cost-other-rubl
     6551           bf-ext-cli_trn-doc-sum.cost-discnt-base      = bf-ext-cli_trn-doc-sum.cost-discnt-base     + bf_doc-line-sum.cost-discnt-base
     6552           bf-ext-cli_trn-doc-sum.cost-discnt-rubl      = bf-ext-cli_trn-doc-sum.cost-discnt-rubl     + bf_doc-line-sum.cost-discnt-rubl
     6553         .
     6554       end.
     6555       else do:
     6556         assign
     6557           bf-mis-cli_trn-doc-sum.cost-sum-base         = bf-mis-cli_trn-doc-sum.cost-sum-base        - bf_doc-line-sum.cost-sum-base
     6558           bf-mis-cli_trn-doc-sum.cost-sum-rubl         = bf-mis-cli_trn-doc-sum.cost-sum-rubl        - bf_doc-line-sum.cost-sum-rubl
     6559           bf-mis-cli_trn-doc-sum.cost-VAT-base         = bf-mis-cli_trn-doc-sum.cost-VAT-base        - bf_doc-line-sum.cost-VAT-base
     6560           bf-mis-cli_trn-doc-sum.cost-VAT-rubl         = bf-mis-cli_trn-doc-sum.cost-VAT-rubl        - bf_doc-line-sum.cost-VAT-rubl
     6561           bf-mis-cli_trn-doc-sum.cost-SLT-base         = bf-mis-cli_trn-doc-sum.cost-SLT-base        - bf_doc-line-sum.cost-SLT-base
     6562           bf-mis-cli_trn-doc-sum.cost-SLT-rubl         = bf-mis-cli_trn-doc-sum.cost-SLT-rubl        - bf_doc-line-sum.cost-SLT-rubl
     6563           bf-mis-cli_trn-doc-sum.cost-road-tax-base    = bf-mis-cli_trn-doc-sum.cost-road-tax-base   - bf_doc-line-sum.cost-road-tax-base
     6564           bf-mis-cli_trn-doc-sum.cost-road-tax-rubl    = bf-mis-cli_trn-doc-sum.cost-road-tax-rubl   - bf_doc-line-sum.cost-road-tax-rubl
     6565           bf-mis-cli_trn-doc-sum.cost-excise-base      = bf-mis-cli_trn-doc-sum.cost-excise-base     - bf_doc-line-sum.cost-excise-base
     6566           bf-mis-cli_trn-doc-sum.cost-excise-rubl      = bf-mis-cli_trn-doc-sum.cost-excise-rubl     - bf_doc-line-sum.cost-excise-rubl
     6567           bf-mis-cli_trn-doc-sum.cost-transport-base   = bf-mis-cli_trn-doc-sum.cost-transport-base  - bf_doc-line-sum.cost-transport-base
     6568           bf-mis-cli_trn-doc-sum.cost-transport-rubl   = bf-mis-cli_trn-doc-sum.cost-transport-rubl  - bf_doc-line-sum.cost-transport-rubl
     6569           bf-mis-cli_trn-doc-sum.cost-other-base       = bf-mis-cli_trn-doc-sum.cost-other-base      - bf_doc-line-sum.cost-other-base
     6570           bf-mis-cli_trn-doc-sum.cost-other-rubl       = bf-mis-cli_trn-doc-sum.cost-other-rubl      - bf_doc-line-sum.cost-other-rubl
     6571           bf-mis-cli_trn-doc-sum.cost-discnt-base      = bf-mis-cli_trn-doc-sum.cost-discnt-base     - bf_doc-line-sum.cost-discnt-base
     6572           bf-mis-cli_trn-doc-sum.cost-discnt-rubl      = bf-mis-cli_trn-doc-sum.cost-discnt-rubl     - bf_doc-line-sum.cost-discnt-rubl
     6573         .
     6574       end.
     6575     end.
     6576   end.
     6577   end.
     6578   end procedure.
     6579   procedure lib-trn2_filinvon :
     6580   define input  parameter pariodoc-code like ub.trn-doc.doc-code   no-undo.
     6581   define input  parameter pariostatus   like ub.trn-doc.status_    no-undo.
     6582   define input  parameter parioflag     like ub.trn-doc.flag_      no-undo.
     6583   define input  parameter parchk-rsrv   as   logical               no-undo.
     6584   define input  parameter parhandle     as   handle                no-undo.
     6585   define output parameter parchg-inv    as   logical               no-undo.
     6586   define output parameter table for gds-list.
     6587   define variable variocur-qnty         like ub.doc-line.fact-qnty   no-undo.
     6588   define variable variocur-cli-qnty     like ub.doc-line.fact-qnty   no-undo.
     6589   define variable wastagevalue          as   character               no-undo.
     6590   define variable wastagetype           as   character               no-undo.
     6591   define variable varchg-inv            as   logical                 no-undo.
     6592   define variable varlns-cnt            as   integer                 no-undo.
     6593   define variable varvalue              like ub.doc-attr.attr-value  no-undo.
     6594   define variable vartype               as   character               no-undo.
     6595   define variable varvaluewt            as   character               no-undo.
     6596   define variable vartypewt             as   character               no-undo.
     6597   define variable varvalueol            as   character               no-undo.
     6598   define variable vartypeol             as   character               no-undo.
     6599   define variable is-petrol             as   logical                 no-undo.
     6600   define variable is-pieces             as   logical                 no-undo.
     6601   define variable v-density             like ub.doc-line.doc-density no-undo.
     6602   define buffer io_trn-doc              for ub.trn-doc.
     6603   define buffer io_doc-line             for ub.doc-line.
     6604   define buffer io_inv-line             for ub.inv-line.
     6605   define buffer io_goods                for ub.goods.
     6606   define buffer io_parts                for ub.parts.
     6607   define buffer io-bef_trn-doc-sum      for ub.trn-doc-sum.
     6608   define buffer io-bef-cli_trn-doc-sum  for ub.trn-doc-sum.
     6609   define buffer io-wst_trn-doc-sum      for ub.trn-doc-sum.
     6610   define buffer io-wst-cli_trn-doc-sum  for ub.trn-doc-sum.
     6611   define buffer io-bef_doc-line-sum     for ub.doc-line-sum.
     6612   define buffer io-bef-cli_doc-line-sum for ub.doc-line-sum.
     6613   define buffer io-wst_doc-line-sum     for ub.doc-line-sum.
     6614   define buffer io-wst-cli_doc-line-sum for ub.doc-line-sum.
     6615   define buffer io-aft-cli_doc-line-sum for ub.doc-line-sum.
     6616   define buffer io-aft_doc-line-sum     for ub.doc-line-sum.
     6617   define buffer buf_doc-prts for ub.doc-prts  .
     6618   define variable varinvclcspvalue as character no-undo.
     6619   define variable varinvclcsptype  as character no-undo.
     6620   define variable vartime          as integer   no-undo.
     6621   define variable varcount         as integer   no-undo.
     6622   define variable varmessage       as character no-undo.
     6623   bl-inv-on:
     6624   do transaction on error undo bl-inv-on, return error substitute( "Ошибка &1 &2 при вызове процедуры inv-on."
     6625                                                                  , return-value
     6626                                                                  , error-status :get-message( 1 ) ) :
     6627     find first io_trn-doc where io_trn-doc.doc-code = pariodoc-code.
     6628     if io_trn-doc.ext-doc-type <> 'vt':U              and
     6629        io_trn-doc.ext-doc-type <> 'ap':U   and
     6630        io_trn-doc.ext-doc-type <> 'pc':U   and
     6631        io_trn-doc.ext-doc-type <> 'mp':U and
     6632        io_trn-doc.ext-doc-type <> 'vp':U         then do:
     6633        return error substitute( "Неверный расширенный тип документа &1.", io_trn-doc.ext-doc-type ).
     6634     end.
     6635     run trg/lock-gds.p
     6636       (input io_trn-doc.doc-code
     6637       ,input (if io_trn-doc.ext-doc-type = 'vt':U then yes else no)
     6638       ,input (if io_trn-doc.ext-doc-type = 'vt':U then yes else no)
     6639       ,input 0
     6640       ,input 0
     6641       ,input false
     6642       ,input false
     6643       ) no-error.
     6644     if error-status :error then do:
     6645       run waitfram-hide in parhandle no-error.
     6646       undo bl-inv-on, return error return-value.
     6647     end.
     6648     assign
     6649       io_trn-doc.doc-qnty    = 0
     6650       io_trn-doc.tot-calc    = 0
     6651       io_trn-doc.discnt-rubl = 0
     6652     .
     6653   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6654   empty temp-table thbjattr_thbj-attr.
     6655   run adm/shattri.p (
     6656      input "get":U
     6657     ,input io_trn-doc.obj-type
     6658     ,input io_trn-doc.obj-code
     6659     ,input 'inv-obj':U
     6660     ,input  ""
     6661     ,output v-value-character
     6662     ,output v-value-date
     6663     ,output v-value-decimal
     6664     ,output v-value-integer
     6665     ,output v-value-logical
     6666     ,output par-type
     6667     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     6668     ) no-error .
     6669       for each thbjattr_thbj-attr :
     6670           if thbjattr_thbj-attr.prop-code = 'invclcsp'  then varinvclcspvalue = string( thbjattr_thbj-attr.property-value-logical, "yes/no").
     6671           if thbjattr_thbj-attr.prop-code = 'wastage'   then wastagevalue  = string( thbjattr_thbj-attr.property-value-logical, "yes/no").
     6672       end.
     6673       empty temp-table thbjattr_thbj-attr.
     6674     assign
     6675       vartime = time.
     6676     if io_trn-doc.ext-doc-type = 'vt':U      or
     6677        io_trn-doc.ext-doc-type = 'vp':U then do:
     6678       if io_trn-doc.ext-doc-type = 'vt':U then do:
     6679   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input io_trn-doc.doc-code ,
     6680                           input 'clcaswt':U ,
     6681                          output varvaluewt ,
     6682                          output vartypewt ) no-error .
     6683         if error-status :error then do:
     6684           undo bl-inv-on, return error substitute( "Ошибка при вызове процедуры tdat-val &1 &2."
     6685                                                  , return-value
     6686                                                  , error-status :get-message( 1 ) ).
     6687         end.
     6688       end.
     6689       else do:
     6690         assign
     6691           wastagevalue = "no":u.
     6692       end.
     6693       if io_trn-doc.ext-doc-type = 'vp':U then do:
     6694         assign
     6695           varvalueol = "yes":u.
     6696       end.
     6697       else do:
     6698   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input io_trn-doc.doc-code ,
     6699                           input 'clcasol':U ,
     6700                          output varvalueol ,
     6701                          output vartypeol ) no-error .
     6702         if error-status :error then do:
     6703           undo bl-inv-on, return error substitute( "Ошибка при вызове процедуры tdat-val &1 &2."
     6704                                                  , return-value
     6705                                                  , error-status :get-message( 1 ) ).
     6706         end.
     6707       end.
     6708       assign
     6709         varinvclcspvalue = "no".
     6710     end.
     6711     if io_trn-doc.status_ = 'разрешен':U and
     6712        not io_trn-doc.flag_              then do:
     6713       if io_trn-doc.ext-doc-type = 'vt':U then do:
     6714         run waitfram-show in parhandle ("Очистка сумм <перед документом>.").
     6715   if valid-handle( g#lib-rwds ) <> yes then do:       run str/lib-rwds.p persistent no-error.       if error-status :error or valid-handle( g#lib-rwds ) <> yes then do:         message "Error starting lib-rwds.p" skip( 0 )           g#lib-rwds                        skip( 0 )           g#lib-rwds   :type                skip( 0 )           g#lib-rwds   :file-name           skip( 0 )           error-status :get-message( 1 )    skip( 0 )           return-value                      skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rwds_cltrnsum in g#lib-rwds ( input io_trn-doc.doc-code ,
     6716                          input 'bd':U ) no-error .
     6717         if error-status :error then do:
     6718           run waitfram-hide in parhandle no-error.
     6719           undo bl-inv-on, return error return-value.
     6720         end.
     6721         for each io_doc-line where io_doc-line.doc-code = io_trn-doc.doc-code on error undo, return error return-value :
     6722   if valid-handle( g#lib-rwds ) <> yes then do:       run str/lib-rwds.p persistent no-error.       if error-status :error or valid-handle( g#lib-rwds ) <> yes then do:         message "Error starting lib-rwds.p" skip( 0 )           g#lib-rwds                        skip( 0 )           g#lib-rwds   :type                skip( 0 )           g#lib-rwds   :file-name           skip( 0 )           error-status :get-message( 1 )    skip( 0 )           return-value                      skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rwds_cllinsum in g#lib-rwds ( input io_doc-line.doc-code ,
     6723                          input 'bd':U ,
     6724                          input io_doc-line.artic ,
     6725                          input io_doc-line.prod-type ,
     6726                          input io_doc-line.prod-code ) no-error .
     6727           if error-status :error then do:
     6728             run waitfram-hide in parhandle no-error.
     6729             undo bl-inv-on, return error return-value.
     6730           end.
     6731         end.
     6732         find first io-bef_trn-doc-sum where io-bef_trn-doc-sum.doc-code = io_trn-doc.doc-code and
     6733                                             io-bef_trn-doc-sum.sum-type = 'bd':U   exclusive-lock.
     6734         if varinvclcspvalue = "yes" then do:
     6735   if valid-handle( g#lib-rwds ) <> yes then do:       run str/lib-rwds.p persistent no-error.       if error-status :error or valid-handle( g#lib-rwds ) <> yes then do:         message "Error starting lib-rwds.p" skip( 0 )           g#lib-rwds                        skip( 0 )           g#lib-rwds   :type                skip( 0 )           g#lib-rwds   :file-name           skip( 0 )           error-status :get-message( 1 )    skip( 0 )           return-value                      skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rwds_cltrnsum in g#lib-rwds ( input io_trn-doc.doc-code ,
     6736                          input 'bcd':U ) no-error .
     6737           if error-status :error then do:
     6738             undo bl-inv-on, return error return-value.
     6739           end.
     6740           for each io_doc-line where io_doc-line.doc-code = io_trn-doc.doc-code on error undo, return error return-value :
     6741   if valid-handle( g#lib-rwds ) <> yes then do:       run str/lib-rwds.p persistent no-error.       if error-status :error or valid-handle( g#lib-rwds ) <> yes then do:         message "Error starting lib-rwds.p" skip( 0 )           g#lib-rwds                        skip( 0 )           g#lib-rwds   :type                skip( 0 )           g#lib-rwds   :file-name           skip( 0 )           error-status :get-message( 1 )    skip( 0 )           return-value                      skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rwds_cllinsum in g#lib-rwds ( input io_doc-line.doc-code ,
     6742                          input 'bcd':U ,
     6743                          input io_doc-line.artic ,
     6744                          input io_doc-line.prod-type ,
     6745                          input io_doc-line.prod-code ) no-error .
     6746             if error-status :error then do:
     6747               run waitfram-hide in parhandle no-error.
     6748               undo bl-inv-on, return error return-value.
     6749             end.
     6750           end.
     6751           find first io-bef-cli_trn-doc-sum where io-bef-cli_trn-doc-sum.doc-code = io_trn-doc.doc-code   and
     6752                                                   io-bef-cli_trn-doc-sum.sum-type = 'bcd':U exclusive-lock.
     6753         end.
     6754       end.
     6755     end.
     6756     else do:
     6757       if io_trn-doc.ext-doc-type = 'vt':U      or
     6758          io_trn-doc.ext-doc-type = 'vp':U then do:
     6759   if valid-handle( g#lib-rwds ) <> yes then do:       run str/lib-rwds.p persistent no-error.       if error-status :error or valid-handle( g#lib-rwds ) <> yes then do:         message "Error starting lib-rwds.p" skip( 0 )           g#lib-rwds                        skip( 0 )           g#lib-rwds   :type                skip( 0 )           g#lib-rwds   :file-name           skip( 0 )           error-status :get-message( 1 )    skip( 0 )           return-value                      skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rwds_crtrnsum in g#lib-rwds ( input io_trn-doc.doc-code ,
     6760                          input 'bd':U ) no-error .
     6761         if error-status :error then do:
     6762           run waitfram-hide in parhandle no-error.
     6763           undo bl-inv-on, return error return-value.
     6764         end.
     6765         find first io-bef_trn-doc-sum where io-bef_trn-doc-sum.doc-code = io_trn-doc.doc-code and
     6766                                             io-bef_trn-doc-sum.sum-type = 'bd':U   exclusive-lock.
     6767         if varinvclcspvalue = "yes" then do:
     6768   if valid-handle( g#lib-rwds ) <> yes then do:       run str/lib-rwds.p persistent no-error.       if error-status :error or valid-handle( g#lib-rwds ) <> yes then do:         message "Error starting lib-rwds.p" skip( 0 )           g#lib-rwds                        skip( 0 )           g#lib-rwds   :type                skip( 0 )           g#lib-rwds   :file-name           skip( 0 )           error-status :get-message( 1 )    skip( 0 )           return-value                      skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rwds_crtrnsum in g#lib-rwds ( input io_trn-doc.doc-code ,
     6769                          input 'bcd':U ) no-error .
     6770           if error-status :error then do:
     6771             run waitfram-hide in parhandle no-error.
     6772             undo bl-inv-on, return error return-value.
     6773           end.
     6774           find first io-bef-cli_trn-doc-sum where io-bef-cli_trn-doc-sum.doc-code = io_trn-doc.doc-code and
     6775                                                   io-bef-cli_trn-doc-sum.sum-type = 'bcd':U   exclusive-lock.
     6776         end.
     6777         define buffer free_parts    for ub.parts  .
     6778         define buffer out_parts     for ub.parts  .
     6779         define buffer free_bar-code for ub.bar-code  .
     6780         for each io_doc-line where io_doc-line.doc-code = io_trn-doc.doc-code on error undo, return error return-value :
     6781           find first io_goods where io_goods.artic     = io_doc-line.artic     and
     6782                                     io_goods.prod-type = io_doc-line.prod-type and
     6783                                     io_goods.prod-code = io_doc-line.prod-code no-lock.
     6784           for each free_parts no-lock where
     6785                    free_parts.artic     = io_goods.artic     and
     6786                    free_parts.prod-type = io_goods.prod-type and
     6787                    free_parts.prod-code = io_goods.prod-code and
     6788                    free_parts.obj-type  = io_trn-doc.obj-type and
     6789                    free_parts.obj-code  = io_trn-doc.obj-code and
     6790                    free_parts.out-code  = 'free-zone':U
     6791                    :
     6792               find first free_bar-code no-lock where
     6793                          free_bar-code.in-code   = free_parts.in-code   and
     6794                          free_bar-code.part-code = free_parts.part-code and
     6795                          free_bar-code.gds-code  = io_goods.gds-code
     6796                          no-error .
     6797             if available free_bar-code then do:
     6798                find first buf_doc-prts exclusive-lock where
     6799                           buf_doc-prts.out-code = io_trn-doc.doc-code and
     6800                           buf_doc-prts.b-code   = free_bar-code.b-code no-error .
     6801                if not available buf_doc-prts then do:
     6802                    create buf_doc-prts.
     6803                end.
     6804                assign
     6805                   buf_doc-prts.gds-code = free_bar-code.gds-code
     6806                   buf_doc-prts.out-code = io_trn-doc.doc-code
     6807                   buf_doc-prts.b-code   = free_bar-code.b-code
     6808                   buf_doc-prts.fact-qnty = free_parts.fact-qnty
     6809                .
     6810             end.
     6811           end.
     6812           for each out_parts no-lock where
     6813                    out_parts.artic     = io_goods.artic     and
     6814                    out_parts.prod-type = io_goods.prod-type and
     6815                    out_parts.prod-code = io_goods.prod-code and
     6816                    out_parts.obj-type  = io_trn-doc.obj-type and
     6817                    out_parts.obj-code  = io_trn-doc.obj-code and
     6818                    out_parts.out-code  = 'out-zone':U
     6819                    :
     6820               find first free_bar-code no-lock where
     6821                          free_bar-code.in-code   = out_parts.in-code   and
     6822                          free_bar-code.part-code = out_parts.part-code and
     6823                          free_bar-code.gds-code  = io_goods.gds-code
     6824                          no-error .
     6825             if available free_bar-code then do:
     6826                find first buf_doc-prts exclusive-lock where
     6827                           buf_doc-prts.out-code = io_trn-doc.doc-code and
     6828                           buf_doc-prts.b-code   = free_bar-code.b-code no-error .
     6829                if not available buf_doc-prts then do:
     6830                    create buf_doc-prts.
     6831                     assign
