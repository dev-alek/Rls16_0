     3397   procedure plgdsfnd :
     3398     define input  parameter p-chk-and-chs    as logical               no-undo .
     3399     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
     3400     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
     3401     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
     3402     define output parameter p-reserv-pl-code as   logical             no-undo .
     3403     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
     3404     define buffer buf_goods         for ub.goods .
     3405     define buffer buf_pl-gds        for ub.pl-gds .
     3406     define buffer buf_second_pl-gds for ub.pl-gds .
     3407     find first buf_goods no-lock where
     3408                buf_goods.gds-code = p-gds-code no-error .
     3409     if not available buf_goods
     3410     then do:
     3411       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
     3412     end.
     3413   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3414   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     3415     (input  p-obj-type
     3416     ,input  p-obj-code
     3417     ,input  buf_goods.artic
     3418     ,input  buf_goods.prod-type
     3419     ,input  buf_goods.prod-code
     3420     ,input  'place-rsrv=request'
     3421     ,output p-reserv-pl-code
     3422     ) no-error .
     3423     if error-status :error
     3424     then do:
     3425       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     3426     end.
     3427     if p-reserv-pl-code = no
     3428     then do:
     3429       return .
     3430     end.
     3431     if p-chk-and-chs <> yes
     3432     then do:
     3433       return .
     3434     end.
     3435     find first buf_pl-gds no-lock where
     3436                buf_pl-gds.obj-type = p-obj-type and
     3437                buf_pl-gds.obj-code = p-obj-code and
     3438                buf_pl-gds.gds-code = p-gds-code no-error .
     3439     if not available buf_pl-gds
     3440     then do:
     3441       return error "К товару не привязано ни одного места хранения" .
     3442     end.
     3443     find first buf_second_pl-gds no-lock where
     3444                buf_second_pl-gds.obj-type  = p-obj-type          and
     3445                buf_second_pl-gds.obj-code  = p-obj-code          and
     3446                buf_second_pl-gds.gds-code  = p-gds-code          and
     3447                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     3448     if not available buf_second_pl-gds
     3449     then do:
     3450       assign
     3451         p-pl-code = buf_pl-gds.pl-code
     3452       .
     3453     end.
     3454     else do:
     3455       return error "Не выбрано место хранения " + chr(10) .
     3456     end.
     3457   end procedure.
     3458   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3459   define temp-table temp-pl-gds no-undo   like ub.pl-gds .
     3460   define temp-table temp-prt-obj no-undo   field prt-code         like ub.prt-obj.prt-code     field price-sale       like ub.prt-obj.price-sale   field fact-qnty        like ub.prt-obj.fact-qnty    field price-list-qnty  like ub.prt-obj.fact-qnty    field is-term          as logical   field prt-obj-recid    as recid     field price-list-recid as recid     index xpk is primary unique prt-code   index xie1 is-term .
