     2863   procedure clcprtsl_calc-ttable :
     2864   define input parameter paris-doc           as   logical                 no-undo.
     2865   define input parameter paris-cur           as   logical                 no-undo.
     2866   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     2867   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     2868   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     2869   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     2870   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     2871   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     2872   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     2873   define input parameter parr-b              as   character               no-undo.
     2874   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     2875   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     2876   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     2877   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     2878   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     2879   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     2880   define buffer bf_tt-allsum      for tt-allsum.
     2881   define buffer bf_tt-clcparts    for tt-clcparts.
     2882   define buffer bf_tt-allsum-line for tt-allsum-line.
     2883   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2884   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2885   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2886   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2887   define variable varexcise          like ub.price-list.excise     no-undo.
     2888   do on error undo, return error return-value :
     2889   for each bf_tt-allsum-line
     2890   on error undo, return error return-value
     2891    :
     2892     delete bf_tt-allsum-line.
     2893   end.
     2894   for each bf_tt-allsum
     2895   on error undo, return error return-value
     2896   :
     2897     delete bf_tt-allsum.
     2898   end.
     2899   for each bf_tt-clcparts
     2900   on error undo, return error return-value
     2901   :
     2902   if v-calcbypart then do:
     2903             assign
     2904             parcur-base =   bf_tt-clcparts.part-cur-base
     2905             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     2906             parcur-excise =   bf_tt-clcparts.part-cur-excise
     2907             .
     2908   end.
     2909      run clcprtsl_calc-parts in this-procedure (
     2910        input recid(bf_tt-clcparts),
     2911        input paris-doc,
     2912        input paris-cur,
     2913        input parroad-tax,
     2914        input parexcise,
     2915        input parvat-pc,
     2916        input parcons-vat-pc,
     2917        input parslt-pc,
     2918        input parbase-rate,
     2919        input parbase-scale,
     2920        input parr-b,
     2921        input parcur-base,
     2922        input parcur-road-tax,
     2923        input parcur-excise,
     2924        input parcur-vat-pc,
     2925        input parcurcons-vat-pc,
     2926        input parcurslt-pc
     2927        ) no-error.
     2928     if error-status:error then do:
     2929       message
     2930         vss-workfile vss-revision vss-description skip
     2931         vss-include-info8 skip
     2932         "Ошибка при обсчете партии" skip
     2933         "Документ партии " bf_tt-clcparts.out-code skip
     2934         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     2935         return-value skip
     2936         error-status:get-message(1) skip
     2937         error-status:get-message(2) skip
     2938         error-status:get-message(3) skip
     2939         view-as alert-box error .
     2940       undo, return error .
     2941     end.
     2942     for each bf_tt-allsum on error undo, return error return-value :
     2943       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     2944       if not available bf_tt-allsum-line then do:
     2945         create bf_tt-allsum-line.
     2946         assign
     2947           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     2948       end.
     2949       assign
     2950         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     2951         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
