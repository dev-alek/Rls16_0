     2724     (input  bf_trn-doc.obj-type
     2725     ,input  bf_trn-doc.obj-code
     2726     ,input  varb-code
     2727     ,input  0
     2728     ,input  bf_trn-doc.fact-order
     2729     ,output vardoc-num
     2730     ,output varprice-sale
     2731     ,output varroad-tax
     2732     ,output varexcise
