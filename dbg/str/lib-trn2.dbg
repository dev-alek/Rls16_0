     3574         where buf_price-list.doc-num    = v-doc-num
     3575           and buf_price-list.price-type = ""
     3576           and buf_price-list.b-code     = v-root-b-code
     3577         .
     3578       find first buf_temp-prt-obj
     3579         where buf_temp-prt-obj.prt-code = v-root-node
     3580         .
     3581       assign
     3582         buf_temp-prt-obj.price-sale       = v-price-sale
     3583         buf_temp-prt-obj.price-list-qnty  = buf_price-list.doc-qnty
     3584         buf_temp-prt-obj.price-list-recid = recid(buf_price-list)
