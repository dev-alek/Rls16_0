     8319   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_acc-cost in g#lib-trn
     8320   (
     8321    input  cb_doc-line.obj-type
     8322   ,input  cb_doc-line.obj-code
     8323   ,input  cb_doc-line.doc-code
     8324   ,input  cb_doc-line.artic
     8325   ,input  cb_doc-line.prod-type
     8326   ,input  cb_doc-line.prod-code
     8327   ,input  cb_doc-line.cli-qnty
     8328   ,input  cb_doc-line.doc-qnty
     8329   ,input  cb_doc-line.fact-qnty
     8330   ,input  cb_doc-line.price-base
     8331   ,input  cb_doc-line.price-rubl
     8332   ,input  ''
     8333   ,output v-ts-doc-line_tot-ov
     8334   ,output v-ts-doc-line_fact-rubl
     8335   ,output v-ts-doc-line_fact-base
     8336   ,output v-ts-doc-line_fact-qnty
     8337   ,output v-ts-doc-line_doc-qnty
     8338   ,output v-ts-doc-line_cli-qnty
     8339   )
     8340   no-error.
     8341             if error-status :error then do:
     8342               return error substitute( "&1 &2", return-value, error-status :get-message( 1 ) ).
     8343             end.
     8344   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_clclninv in g#lib-trn
     8345   (
     8346    input  recid(cb_doc-line)
     8347   ,input  no
     8348   ,input  ''
     8349   ,output vartot-doc
     8350   ,output vartot-rubl
     8351   )
     8352   no-error.
     8353             if error-status :error then do:
     8354               return error return-value.
     8355             end.
     8356           end.
     8357         end.
     8358       end.
     8359     end.
     8360   end procedure.
     8361   procedure recalc-rasr- :
     8362   define input parameter  par-rc-doc-line      as   recid                 no-undo.
     8363   define input parameter  par-rc-cur-qnty      like ub.doc-line.fact-qnty no-undo.
     8364   define input parameter  par-rc-inv-line      as   recid                 no-undo.
     8365   define input parameter  par-rc-cur-cli-qnty  like ub.doc-line.fact-qnty no-undo.
     8366   define output parameter par-rc-chg-inv       as   logical               no-undo.
     8367   do
     8368   on error undo, return error return-value
     8369   :
     8370     define variable var-rc-cur-qnty     like ub.doc-line.fact-qnty no-undo.
     8371     define variable var-rc-cur-cli-qnty like ub.doc-line.fact-qnty no-undo.
     8372     define buffer rc_doc-line for ub.doc-line.
     8373     define buffer rc_inv-line for ub.inv-line.
     8374     define buffer rc_gds-dtl  for ub.gds-dtl.
     8375     define buffer rc_prt-obj  for ub.prt-obj.
     8376     define buffer rc_doc-pl   for ub.doc-pl.
     8377     define buffer rc_pl-gds   for ub.pl-gds.
     8378     define buffer rc_goods    for ub.goods.
     8379     for each gds-list :
     8380       delete gds-list.
     8381     end.
     8382     find first rc_doc-line where recid(rc_doc-line) = par-rc-doc-line.
     8383     if par-rc-inv-line <> ? then do:
     8384       find first rc_inv-line where recid(rc_inv-line) = par-rc-inv-line.
     8385     end.
     8386     find rc_goods no-lock
     8387       where rc_goods.artic     = rc_doc-line.artic
     8388         and rc_goods.prod-type = rc_doc-line.prod-type
     8389         and rc_goods.prod-code = rc_doc-line.prod-code
     8390     .
     8391     if rc_doc-line.doc-qnty <> par-rc-cur-qnty + rc_doc-line.fact-qnty then do:
     8392       assign par-rc-chg-inv = yes.
     8393   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8394   find gds-list
     8395     where gds-list.prod-type = rc_goods.prod-type
     8396       and gds-list.prod-code = rc_goods.prod-code
     8397       and gds-list.artic     = rc_goods.artic
     8398     no-error .
     8399   if available gds-list then do:
     8400     assign
     8401       gds-list.to-del = no
     8402     .
     8403   end.
     8404   else do:
     8405     define variable v-last55 as integer no-undo .
     8406     find last gds-list use-index oi no-error.
     8407     if available gds-list then do:
     8408       v-last55 = gds-list.order-num .
     8409     end.
     8410     else do:
     8411       v-last55 = 0 .
     8412     end.
     8413     create gds-list .
     8414     buffer-copy rc_goods to gds-list
     8415     assign
     8416       gds-list.to-del = no
     8417       gds-list.order-num = v-last55 + 1
     8418     .
     8419     assign
     8420       lns-cnt = lns-cnt + 1
     8421       line-rec = recid (gds-list)
     8422     .
     8423   end.
     8424       assign
     8425         rc_doc-line.doc-qnty = par-rc-cur-qnty + rc_doc-line.fact-qnty
     8426       .
     8427       if available rc_inv-line then do:
     8428         assign
     8429           rc_inv-line.wast-cli-qnty   = rc_doc-line.cli-qnty + par-rc-cur-cli-qnty
     8430         .
     8431       end.
     8432     end.
     8433     for each rc_gds-dtl exclusive-lock
     8434       where rc_gds-dtl.doc-code  = rc_doc-line.doc-code
     8435         and rc_gds-dtl.artic     = rc_doc-line.artic
     8436         and rc_gds-dtl.prod-code = rc_doc-line.prod-code
     8437         and rc_gds-dtl.prod-type = rc_doc-line.prod-type
     8438     on error undo, return error return-value
     8439     :
     8440       find rc_prt-obj no-lock
     8441         where rc_prt-obj.obj-type   = rc_doc-line.obj-type
     8442           and rc_prt-obj.obj-code   = rc_doc-line.obj-code
     8443           and rc_prt-obj.artic      = rc_doc-line.artic
     8444           and rc_prt-obj.prod-type  = rc_doc-line.prod-type
     8445           and rc_prt-obj.prod-code  = rc_doc-line.prod-code
     8446           and rc_prt-obj.prt-code   = rc_gds-dtl.prt-code
     8447         no-error .
     8448       if available rc_prt-obj then do:
     8449         assign
     8450           var-rc-cur-qnty = rc_prt-obj.fact-qnty
     8451         .
     8452       end.
     8453       else do:
     8454         assign
     8455           var-rc-cur-qnty = 0
     8456         .
     8457       end.
     8458       if rc_gds-dtl.fact-qnty <> var-rc-cur-qnty + rc_gds-dtl.doc-qnty then do:
     8459         if par-rc-chg-inv <> yes then do:
     8460           assign par-rc-chg-inv = yes.
     8461   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8462   find gds-list
     8463     where gds-list.prod-type = rc_goods.prod-type
     8464       and gds-list.prod-code = rc_goods.prod-code
     8465       and gds-list.artic     = rc_goods.artic
     8466     no-error .
     8467   if available gds-list then do:
     8468     assign
     8469       gds-list.to-del = no
     8470     .
     8471   end.
     8472   else do:
     8473     define variable v-last56 as integer no-undo .
     8474     find last gds-list use-index oi no-error.
     8475     if available gds-list then do:
     8476       v-last56 = gds-list.order-num .
     8477     end.
     8478     else do:
     8479       v-last56 = 0 .
     8480     end.
     8481     create gds-list .
     8482     buffer-copy rc_goods to gds-list
     8483     assign
     8484       gds-list.to-del = no
     8485       gds-list.order-num = v-last56 + 1
     8486     .
     8487     assign
     8488       lns-cnt = lns-cnt + 1
     8489       line-rec = recid (gds-list)
     8490     .
     8491   end.
     8492         end.
     8493         assign
     8494           rc_gds-dtl.fact-qnty = var-rc-cur-qnty + rc_gds-dtl.doc-qnty
     8495         .
     8496       end.
     8497     end.
     8498     for each rc_doc-pl exclusive-lock
     8499       where rc_doc-pl.out-code = rc_doc-line.doc-code
     8500         and rc_doc-pl.gds-code = rc_goods.gds-code
     8501     on error undo, return error return-value
     8502     :
     8503       find first rc_pl-gds no-lock
     8504         where rc_pl-gds.obj-type   = rc_doc-line.obj-type
     8505           and rc_pl-gds.obj-code   = rc_doc-line.obj-code
     8506           and rc_pl-gds.pl-code    = rc_doc-pl.pl-code
     8507           and rc_pl-gds.gds-code   = rc_goods.gds-code
     8508         no-error .
     8509       if available rc_pl-gds then do:
     8510         assign
     8511           var-rc-cur-qnty     = rc_pl-gds.fact-qnty
     8512           var-rc-cur-cli-qnty = rc_pl-gds.cli-fact-qnty
     8513         .
     8514       end.
     8515       else do:
     8516         assign
     8517           var-rc-cur-qnty     = 0.0
     8518           var-rc-cur-cli-qnty = 0.0
     8519         .
     8520       end.
     8521       if rc_doc-pl.rest-af-qnty <> var-rc-cur-qnty + rc_doc-pl.doc-qnty
     8522         or rc_doc-pl.cli-rest-af-qnty <> var-rc-cur-cli-qnty + rc_doc-pl.cli-doc-qnty
     8523       then do:
     8524         if par-rc-chg-inv <> yes then do:
     8525           assign par-rc-chg-inv = yes.
     8526   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8527   find gds-list
     8528     where gds-list.prod-type = rc_goods.prod-type
     8529       and gds-list.prod-code = rc_goods.prod-code
     8530       and gds-list.artic     = rc_goods.artic
     8531     no-error .
     8532   if available gds-list then do:
     8533     assign
     8534       gds-list.to-del = no
     8535     .
     8536   end.
     8537   else do:
     8538     define variable v-last57 as integer no-undo .
     8539     find last gds-list use-index oi no-error.
     8540     if available gds-list then do:
     8541       v-last57 = gds-list.order-num .
     8542     end.
     8543     else do:
     8544       v-last57 = 0 .
     8545     end.
     8546     create gds-list .
     8547     buffer-copy rc_goods to gds-list
     8548     assign
     8549       gds-list.to-del = no
     8550       gds-list.order-num = v-last57 + 1
     8551     .
     8552     assign
     8553       lns-cnt = lns-cnt + 1
     8554       line-rec = recid (gds-list)
     8555     .
     8556   end.
     8557         end.
     8558         assign
     8559           rc_doc-pl.rest-bf-qnty     = var-rc-cur-qnty
     8560           rc_doc-pl.cli-rest-bf-qnty = var-rc-cur-cli-qnty
     8561           rc_doc-pl.rest-af-qnty     = rc_doc-pl.rest-bf-qnty + rc_doc-pl.doc-qnty
     8562           rc_doc-pl.cli-rest-af-qnty = rc_doc-pl.cli-rest-bf-qnty + rc_doc-pl.cli-doc-qnty
     8563         .
     8564       end.
     8565     end.
     8566   end.
     8567   end procedure.
     8568   procedure lib-trn2_reclcinv :
     8569     define input parameter work-mode   as   character           no-undo.
     8570     define input parameter parrec-line as   recid               no-undo.
     8571     define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
     8572     define input-output parameter vartot-docold                       like ub.trn-doc.tot-doc            no-undo.
     8573     define input-output parameter vartot-rublold                      like ub.trn-doc.tot-rubl           no-undo.
     8574     define input-output parameter i-total-doc-line_tot-ovold          like ub.trn-doc.tot-ov             no-undo.
     8575     define input-output parameter i-total-doc-line_fact-rublold       like ub.trn-doc.fact-rubl          no-undo.
     8576     define input-output parameter i-total-doc-line_fact-baseold       like ub.trn-doc.fact-base          no-undo.
     8577     define input-output parameter i-total-doc-line_fact-qntyold       like ub.trn-doc.fact-qnty          no-undo.
     8578     define input-output parameter i-total-doc-line_doc-qntyold        like ub.trn-doc.doc-qnty           no-undo.
     8579     define input-output parameter i-total-doc-line_cli-qntyold        like ub.trn-doc.cli-qnty           no-undo.
     8580     define input-output parameter i-total-parts_fact-baseold          as   decimal                       no-undo.
     8581     define input-output parameter i-total-parts_fact-rublold          as   decimal                       no-undo.
     8582     define input-output parameter i-total-parts_fact-qntyold          as   decimal                       no-undo.
     8583     define variable vartot-docnew                       like ub.trn-doc.tot-doc            no-undo.
     8584     define variable vartot-rublnew                      like ub.trn-doc.tot-rubl           no-undo.
     8585     define variable i-total-doc-line_tot-ovnew          like ub.trn-doc.tot-ov             no-undo.
     8586     define variable i-total-doc-line_fact-rublnew       like ub.trn-doc.fact-rubl          no-undo.
     8587     define variable i-total-doc-line_fact-basenew       like ub.trn-doc.fact-base          no-undo.
     8588     define variable i-total-doc-line_fact-qntynew       like ub.trn-doc.fact-qnty          no-undo.
     8589     define variable i-total-doc-line_doc-qntynew        like ub.trn-doc.doc-qnty           no-undo.
     8590     define variable i-total-doc-line_cli-qntynew        like ub.trn-doc.cli-qnty           no-undo.
     8591     define variable i-total-parts_fact-basenew          as   decimal                       no-undo.
     8592     define variable i-total-parts_fact-rublnew          as   decimal                       no-undo.
     8593     define variable i-total-parts_fact-qntynew          as   decimal                       no-undo.
     8594     define variable varvalueol                          as   character                     no-undo.
     8595     define variable vartypeol                           as   character                     no-undo.
     8596     define variable varr-b                              as   character                     no-undo.
     8597     define buffer rc_trn-doc           for ub.trn-doc.
     8598     define buffer rc_doc-line          for ub.doc-line.
     8599     define buffer rc_goods             for ub.goods.
     8600     define buffer rc-old_doc-line-sum  for ub.doc-line-sum.
     8601     do on error undo, return error return-value :
     8602       find first rc_doc-line where recid(rc_doc-line)  = parrec-line.
     8603       find first rc_trn-doc  where rc_trn-doc.doc-code = pardoc-code.
     8604       find first rc_goods    where
     8605                  rc_goods.artic      = rc_doc-line.artic     and
     8606                  rc_goods.prod-type  = rc_doc-line.prod-type and
     8607                  rc_goods.prod-code  = rc_doc-line.prod-code no-error.
     8608       if not available rc_goods then do:
     8609         return error substitute( "Не найден товар &1 &2 &3", rc_goods.artic, rc_goods.prod-type, rc_goods.prod-code ).
     8610       end.
     8611       define variable varinvclcspvalue as character no-undo.
     8612   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8613   empty temp-table thbjattr_thbj-attr.
     8614   run adm/shattri.p (
     8615      input "get":U
     8616     ,input rc_trn-doc.obj-type
     8617     ,input rc_trn-doc.obj-code
     8618     ,input 'inv-obj':U
     8619     ,input  ""
     8620     ,output v-value-character
     8621     ,output v-value-date
     8622     ,output v-value-decimal
     8623     ,output v-value-integer
     8624     ,output v-value-logical
     8625     ,output par-type
     8626     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     8627     ) no-error .
     8628       for each thbjattr_thbj-attr :
     8629           if thbjattr_thbj-attr.prop-code = 'invclcsp'  then varinvclcspvalue = string( thbjattr_thbj-attr.property-value-logical, "yes/no").
     8630       end.
     8631       empty temp-table thbjattr_thbj-attr.
     8632       if work-mode = "old":u then do:
     8633         assign
     8634           vartot-docold             = 0
     8635           vartot-rublold            = 0 .
     8636         if rc_trn-doc.ext-doc-type = 'vt':U      or
     8637            rc_trn-doc.ext-doc-type = 'vp':U then do:
     8638           for each tt-old-doc-line-sum where
     8639                    tt-old-doc-line-sum.doc-code  = rc_doc-line.doc-code  and
     8640                    tt-old-doc-line-sum.gds-code  = rc_goods.gds-code     on error undo, return error return-value :
     8641             delete tt-old-doc-line-sum.
     8642           end.
     8643           for each rc-old_doc-line-sum where
     8644                    rc-old_doc-line-sum.doc-code  = rc_doc-line.doc-code  and
     8645                    rc-old_doc-line-sum.gds-code  = rc_goods.gds-code     on error undo, return error return-value :
     8646             create tt-old-doc-line-sum.
     8647             buffer-copy rc-old_doc-line-sum to tt-old-doc-line-sum.
     8648           end.
     8649         end.
     8650   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_clclninv in g#lib-trn
     8651   (
     8652    input  recid(rc_doc-line)
     8653   ,input  no
     8654   ,input  'old'
     8655   ,output vartot-docold
     8656   ,output vartot-rublold
     8657   )
     8658   no-error.
     8659         assign
     8660           i-total-doc-line_tot-ovold       = 0
     8661           i-total-doc-line_fact-rublold    = 0
     8662           i-total-doc-line_fact-baseold    = 0
     8663           i-total-doc-line_fact-qntyold    = 0
     8664           i-total-doc-line_doc-qntyold     = 0
     8665           i-total-doc-line_cli-qntyold     = 0
     8666           i-total-parts_fact-baseold       = 0
     8667           i-total-parts_fact-rublold       = 0
     8668           i-total-parts_fact-qntyold       = 0
     8669         .
     8670   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_acc-cost in g#lib-trn
     8671   (
     8672    input  rc_doc-line.obj-type
     8673   ,input  rc_doc-line.obj-code
     8674   ,input  rc_doc-line.doc-code
     8675   ,input  rc_doc-line.artic
     8676   ,input  rc_doc-line.prod-type
     8677   ,input  rc_doc-line.prod-code
     8678   ,input  rc_doc-line.cli-qnty
     8679   ,input  rc_doc-line.doc-qnty
     8680   ,input  rc_doc-line.fact-qnty
     8681   ,input  rc_doc-line.price-base
     8682   ,input  rc_doc-line.price-rubl
     8683   ,input  'old':u
     8684   ,output i-total-doc-line_tot-ovold
     8685   ,output i-total-doc-line_fact-rublold
     8686   ,output i-total-doc-line_fact-baseold
     8687   ,output i-total-doc-line_fact-qntyold
     8688   ,output i-total-doc-line_doc-qntyold
     8689   ,output i-total-doc-line_cli-qntyold
     8690   )
     8691   no-error.
     8692         if error-status :error then do:
     8693           message
     8694             "Ошибка при обсчете документа инвентаризации." skip
     8695             return-value skip
     8696             trim( error-status :get-message( 1 ) )
     8697           view-as alert-box error.
     8698           undo, return error .
     8699         end.
     8700       end.
     8701       if work-mode = "update":u or
     8702          work-mode = "delete":u then do:
     8703         assign
     8704           vartot-docnew             = 0
     8705           vartot-rublnew            = 0
     8706           .
     8707         if rc_trn-doc.status_ = 'факт':U then do:
     8708           assign
     8709             varvalueol = "yes".
     8710         end.
     8711         else do:
     8712           if rc_trn-doc.status_ = 'разрешен':U then do:
