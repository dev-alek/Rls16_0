     4005   procedure prdoclib-init-temp-prt-obj :
     4006     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
     4007     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
     4008     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
     4009     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
     4010     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
     4011     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
     4012     define buffer buf_prt-obj      for ub.prt-obj .
     4013     define buffer buf_temp-prt-obj for temp-prt-obj .
     4014     do
     4015     on error undo, return error return-value
     4016     :
     4017       run prdoclib-clear-temp-prt-obj in this-procedure .
     4018       for each buf_prt-obj
     4019         where buf_prt-obj.obj-type  = p-obj-type
     4020           and buf_prt-obj.obj-code  = p-obj-code
     4021           and buf_prt-obj.artic     = p-artic
     4022           and buf_prt-obj.prod-type = p-prod-type
     4023           and buf_prt-obj.prod-code = p-prod-code
     4024       on error undo, return error return-value
     4025       :
     4026         run prdoclib-create-temp-prt-obj in this-procedure
     4027           (input  p-root-price-sale
     4028           ,buffer buf_prt-obj
     4029           ,buffer buf_temp-prt-obj
     4030           ).
     4031       end.
     4032     end.
     4033   end procedure.
     4034   procedure prdoclib-calc-fact-sale :
     4035     define input  parameter p-price-list-recid   as recid     no-undo .
     4036     define output parameter p-fact-qnty          as decimal   no-undo .
     4037     define output parameter p-cur-base           as decimal   no-undo .
     4038     define output parameter p-cur-VAT-base       as decimal   no-undo .
     4039     define output parameter p-cur-SLT-base       as decimal   no-undo .
     4040     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     4041     define output parameter p-cur-excise-base    as decimal   no-undo .
     4042     define buffer buf_main_price-list for ub.price-list .
     4043     define buffer buf_price-list      for ub.price-list .
     4044     define buffer buf_goods           for ub.goods .
     4045     define buffer buf_gds-obj         for ub.gds-obj .
     4046     define buffer buf_bar-code        for ub.bar-code .
     4047     define variable l-empty-scale   as logical   no-undo .
     4048     do
     4049     on error undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )
     4050     on stop undo, return error substitute(" stop &1 &2" , return-value , error-status :get-message(1)  )
     4051     on end-key undo, return error substitute(" end-key &1 &2" , return-value , error-status :get-message(1)  )
     4052     :
     4053       find first buf_main_price-list no-lock
     4054         where recid(buf_main_price-list) = p-price-list-recid
     4055         no-error .
     4056       if not available buf_main_price-list
     4057       then do:
     4058         message
     4059           vss-workfile vss-revision vss-description skip
     4060           vss-include-info26 skip
     4061           "Ошибка задания входных параметров" skip
     4062           "Не найдена строка переоценки" skip
     4063           "Код записи (recid)" p-price-list-recid skip
     4064           view-as alert-box error .
     4065         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )   .
     4066       end.
     4067       if buf_main_price-list.main-price <> true
     4068       then do:
     4069         message
     4070           vss-workfile vss-revision vss-description skip
     4071           vss-include-info26 skip
     4072           "Ошибка задания входных параметров" skip
     4073           "Строка переоценки не является основной" skip
     4074           "Код записи (recid)" p-price-list-recid skip
     4075           "Переоценка" buf_main_price-list.doc-num skip
     4076           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     4077           "Бар-код" buf_main_price-list.b-code skip
     4078           view-as alert-box error .
     4079         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )  .
     4080       end.
     4081       find first buf_goods no-lock
     4082         where buf_goods.artic     = buf_main_price-list.artic
     4083           and buf_goods.prod-type = buf_main_price-list.prod-type
     4084           and buf_goods.prod-code = buf_main_price-list.prod-code
     4085         no-error .
     4086       if not available buf_goods
     4087       then do:
     4088         message
     4089           vss-workfile vss-revision vss-description skip
     4090           vss-include-info26 skip
     4091           "Не найден товар" skip
     4092           "Переоценка" buf_main_price-list.doc-num skip
     4093           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     4094           view-as alert-box error .
     4095         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     4096       end.
     4097   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4098   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     4099     (input  buf_main_price-list.artic
     4100     ,input  buf_main_price-list.prod-type
     4101     ,input  buf_main_price-list.prod-code
     4102     ,input  'empty-scale=request':u
     4103     ,output l-empty-scale
     4104     ) no-error .
     4105       if error-status :error
     4106       then do:
     4107         message
     4108           vss-workfile vss-revision vss-description skip
     4109           vss-include-info26 skip
     4110           "Ошибка при определении атрибута товара" skip
     4111           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     4112           'empty-scale=request':u skip
     4113           error-status :get-message(1) skip
     4114           return-value skip
     4115           view-as alert-box error .
     4116         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     4117       end.
     4118       find first buf_gds-obj no-lock
     4119         where buf_gds-obj.gds-code = buf_goods.gds-code
     4120           and buf_gds-obj.obj-type = buf_main_price-list.obj-type
     4121           and buf_gds-obj.obj-code = buf_main_price-list.obj-code
     4122         no-error .
     4123         if not available buf_gds-obj then do:
     4124   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4125   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     4126     (input  buf_main_price-list.obj-type
     4127     ,input  buf_main_price-list.obj-code
     4128     ,input  buf_goods.artic
     4129     ,input  buf_goods.prod-type
     4130     ,input  buf_goods.prod-code
     4131     ,buffer buf_gds-obj
     4132     ) no-error .
     4133           if error-status :error then do:
     4134              undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     4135           end.
     4136         end.
     4137       define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     4138       define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     4139       define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     4140       define variable price-base-without-tax-sale-prl as decimal   no-undo .
     4141       define variable vat-base-sale-prl               as decimal   no-undo .
     4142       define variable vat-rubl-sale-prl               as decimal   no-undo .
     4143       define variable vat-base-buyer-prl              as decimal   no-undo .
     4144       define variable vat-rubl-buyer-prl              as decimal   no-undo .
     4145       define variable slt-base-sale-prl               as decimal   no-undo .
     4146       define variable slt-rubl-sale-prl               as decimal   no-undo .
     4147       define variable road-tax-base-sale-prl          as decimal   no-undo .
     4148       define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     4149       define variable excise-base-sale-prl            as decimal   no-undo .
     4150       define variable excise-rubl-sale-prl            as decimal   no-undo .
     4151       define variable discnt-base-sale-prl            as decimal   no-undo .
     4152       define variable discnt-rubl-sale-prl            as decimal   no-undo .
     4153       if buf_main_price-list.doc-qnty <> 0
     4154       then do:
     4155         run prl-vat in this-procedure
     4156           (input  recid(buf_main_price-list)
     4157           ,output price-rubl-with-tax-sale-prl
     4158           ,output price-base-with-tax-sale-prl
     4159           ,output price-rubl-without-tax-sale-prl
     4160           ,output price-base-without-tax-sale-prl
     4161           ,output vat-base-sale-prl
     4162           ,output vat-rubl-sale-prl
     4163           ,output vat-base-buyer-prl
     4164           ,output vat-rubl-buyer-prl
     4165           ,output slt-base-sale-prl
     4166           ,output slt-rubl-sale-prl
     4167           ,output road-tax-base-sale-prl
     4168           ,output road-tax-rubl-sale-prl
     4169           ,output excise-base-sale-prl
     4170           ,output excise-rubl-sale-prl
     4171           ,output discnt-base-sale-prl
     4172           ,output discnt-rubl-sale-prl
     4173           ) no-error .
     4174         if error-status :error
     4175         then do:
     4176           message
     4177             vss-workfile vss-revision vss-description skip
     4178             vss-include-info26 skip
     4179             "Ошибка при вызове процеды prl-vat" skip
     4180             "Документ" buf_main_price-list.doc-num skip
     4181             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     4182             error-status :get-message(1) skip
     4183             return-value skip
     4184             view-as alert-box error .
     4185           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     4186         end.
     4187       end.
     4188       else do:
     4189         assign
     4190           price-rubl-with-tax-sale-prl    = 0
     4191           price-base-with-tax-sale-prl    = 0
     4192           price-rubl-without-tax-sale-prl = 0
     4193           price-base-without-tax-sale-prl = 0
     4194           vat-base-sale-prl               = 0
     4195           vat-rubl-sale-prl               = 0
     4196           vat-base-buyer-prl              = 0
     4197           vat-rubl-buyer-prl              = 0
     4198           slt-base-sale-prl               = 0
     4199           slt-rubl-sale-prl               = 0
     4200           road-tax-base-sale-prl          = 0
     4201           road-tax-rubl-sale-prl          = 0
     4202           excise-base-sale-prl            = 0
     4203           excise-rubl-sale-prl            = 0
     4204           discnt-base-sale-prl            = 0
     4205           discnt-rubl-sale-prl            = 0
     4206         .
     4207       end.
     4208       define variable v-curr-r-b as character no-undo .
     4209   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4210   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4211     (output v-curr-r-b
     4212     )  .
     4213       if v-curr-r-b = 'base':U
     4214       then do:
     4215         assign
     4216           p-fact-qnty         = buf_main_price-list.doc-qnty
     4217           p-cur-base          = price-base-with-tax-sale-prl * buf_main_price-list.doc-qnty
     4218           p-cur-VAT-base      = vat-base-sale-prl * buf_main_price-list.doc-qnty
     4219           p-cur-SLT-base      = slt-base-sale-prl * buf_main_price-list.doc-qnty
     4220           p-cur-road-tax-base = road-tax-base-sale-prl * buf_main_price-list.doc-qnty
     4221           p-cur-excise-base   = excise-base-sale-prl * buf_main_price-list.doc-qnty
     4222         .
     4223       end.
     4224       else do:
     4225         assign
     4226           p-fact-qnty         = buf_main_price-list.doc-qnty
     4227           p-cur-base          = price-rubl-with-tax-sale-prl * buf_main_price-list.doc-qnty
     4228           p-cur-VAT-base      = vat-rubl-sale-prl * buf_main_price-list.doc-qnty
     4229           p-cur-SLT-base      = slt-rubl-sale-prl * buf_main_price-list.doc-qnty
     4230           p-cur-road-tax-base = road-tax-rubl-sale-prl * buf_main_price-list.doc-qnty
     4231           p-cur-excise-base   = excise-rubl-sale-prl * buf_main_price-list.doc-qnty
     4232         .
     4233       end.
     4234         define variable v-unit-base like ub.goods.unit-base no-undo .
     4235   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4236   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     4237     (input  buf_goods.gds-code
     4238     ,output v-unit-base
     4239     ) no-error .
     4240         if error-status :error
     4241         then do:
     4242           message
     4243             vss-workfile vss-revision vss-description skip
     4244             vss-include-info26 skip
     4245             "Ошибка при определении базовой единицы измерения товара" skip
     4246             "Код товара" buf_goods.gds-code skip
     4247             error-status :get-message(1) skip
     4248             return-value skip
     4249             view-as alert-box error .
     4250           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     4251         end.
     4252         for each buf_price-list no-lock
     4253           where buf_price-list.doc-num    = buf_main_price-list.doc-num
     4254             and buf_price-list.main-price = false
     4255             and buf_price-list.artic      = buf_main_price-list.artic
     4256             and buf_price-list.prod-type  = buf_main_price-list.prod-type
     4257             and buf_price-list.prod-code  = buf_main_price-list.prod-code
     4258         :
     4259           if buf_price-list.doc-qnty = ?
     4260           then do:
     4261             find first buf_bar-code no-lock
     4262               where buf_bar-code.b-code = buf_price-list.b-code
     4263               no-error .
     4264             if available buf_bar-code
     4265             and buf_bar-code.unit-cli = v-unit-base
     4266             then do:
     4267               message
     4268                 vss-workfile vss-revision vss-description skip
     4269                 vss-include-info26 skip
     4270                 "Ошибка при закрытии переоценки" skip
     4271                 "Не задано количество для бар-кода с основной единицей измерения" skip
     4272                 "Переоценка" buf_main_price-list.doc-num skip
     4273                 "Бар-код" buf_price-list.b-code skip
     4274                 "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     4275                 "Количество" buf_price-list.doc-qnty skip
     4276                 "Основная единица измерения" v-unit-base skip
     4277                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
     4278                 view-as alert-box error .
     4279               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     4280             end.
     4281             next .
     4282           end.
     4283           if not can-find
     4284             (first buf_bar-code
     4285             where buf_bar-code.b-code = buf_price-list.b-code
     4286             )
     4287           then do:
     4288             message
     4289               vss-workfile vss-revision vss-description skip
     4290               vss-include-info26 skip
     4291               "В переоценке задан несуществующий бар-код" skip
     4292               "Переоценка" buf_price-list.doc-num skip
     4293               "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     4294               "Бар-код" buf_price-list.b-code skip
     4295               view-as alert-box error .
     4296             undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     4297           end.
     4298           if buf_price-list.doc-qnty <> 0
     4299           then do:
     4300             run prl-vat in this-procedure
     4301               (input  recid(buf_price-list)
     4302               ,output price-rubl-with-tax-sale-prl
     4303               ,output price-base-with-tax-sale-prl
     4304               ,output price-rubl-without-tax-sale-prl
     4305               ,output price-base-without-tax-sale-prl
     4306               ,output vat-base-sale-prl
     4307               ,output vat-rubl-sale-prl
     4308               ,output vat-base-buyer-prl
     4309               ,output vat-rubl-buyer-prl
     4310               ,output slt-base-sale-prl
     4311               ,output slt-rubl-sale-prl
     4312               ,output road-tax-base-sale-prl
     4313               ,output road-tax-rubl-sale-prl
     4314               ,output excise-base-sale-prl
     4315               ,output excise-rubl-sale-prl
     4316               ,output discnt-base-sale-prl
     4317               ,output discnt-rubl-sale-prl
     4318               ) no-error .
     4319             if error-status :error
     4320             then do:
     4321               message
     4322                 vss-workfile vss-revision vss-description skip
     4323                 vss-include-info26 skip
     4324                 "Ошибка при вызове процеды prl-vat" skip
     4325                 "Документ" buf_price-list.doc-num skip
     4326                 "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     4327                 error-status :get-message(1) skip
     4328                 return-value skip
     4329                 view-as alert-box error .
     4330               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     4331             end.
     4332           end.
     4333           else do:
     4334             assign
     4335               price-rubl-with-tax-sale-prl    = 0
     4336               price-base-with-tax-sale-prl    = 0
     4337               price-rubl-without-tax-sale-prl = 0
     4338               price-base-without-tax-sale-prl = 0
     4339               vat-base-sale-prl               = 0
     4340               vat-rubl-sale-prl               = 0
     4341               vat-base-buyer-prl              = 0
     4342               vat-rubl-buyer-prl              = 0
     4343               slt-base-sale-prl               = 0
     4344               slt-rubl-sale-prl               = 0
     4345               road-tax-base-sale-prl          = 0
     4346               road-tax-rubl-sale-prl          = 0
     4347               excise-base-sale-prl            = 0
     4348               excise-rubl-sale-prl            = 0
     4349               discnt-base-sale-prl            = 0
     4350               discnt-rubl-sale-prl            = 0
     4351             .
     4352           end.
     4353           if v-curr-r-b = 'base':U
     4354           then do:
     4355             assign
     4356               p-fact-qnty         = p-fact-qnty
     4357                                   + buf_price-list.doc-qnty
     4358               p-cur-base          = p-cur-base
     4359                                   + price-base-with-tax-sale-prl * buf_price-list.doc-qnty
     4360               p-cur-VAT-base      = p-cur-VAT-base
     4361                                   + vat-base-sale-prl * buf_price-list.doc-qnty
     4362               p-cur-SLT-base      = p-cur-SLT-base
     4363                                   + slt-base-sale-prl * buf_price-list.doc-qnty
     4364               p-cur-road-tax-base = p-cur-road-tax-base
     4365                                   + road-tax-base-sale-prl * buf_price-list.doc-qnty
     4366               p-cur-excise-base   = p-cur-excise-base
     4367                                   + excise-base-sale-prl * buf_price-list.doc-qnty
     4368             .
     4369           end.
     4370           else do:
     4371             assign
     4372               p-fact-qnty         = p-fact-qnty
     4373                                   + buf_price-list.doc-qnty
     4374               p-cur-base          = p-cur-base
     4375                                   + price-rubl-with-tax-sale-prl * buf_price-list.doc-qnty
     4376               p-cur-VAT-base      = p-cur-VAT-base
     4377                                   + vat-rubl-sale-prl * buf_price-list.doc-qnty
     4378               p-cur-SLT-base      = p-cur-SLT-base
     4379                                   + slt-rubl-sale-prl * buf_price-list.doc-qnty
     4380               p-cur-road-tax-base = p-cur-road-tax-base
     4381                                   + road-tax-rubl-sale-prl * buf_price-list.doc-qnty
     4382               p-cur-excise-base   = p-cur-excise-base
