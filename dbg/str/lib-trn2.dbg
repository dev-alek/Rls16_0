     7743   procedure lib-trn2_filinvbd :
     7744     define input parameter  par-cb-ext-doc-type like ub.trn-doc.ext-doc-type    no-undo.
     7745     define input parameter  par-cb-status       like ub.trn-doc.doc-code        no-undo.
     7746     define input parameter  par-cb-flag         like ub.trn-doc.flag_           no-undo.
     7747     define input parameter  par-cb-doc-code     like ub.trn-doc.doc-code        no-undo.
     7748     define input parameter  par-cb-obj-type     like ub.trn-doc.obj-type        no-undo.
     7749     define input parameter  par-cb-obj-code     like ub.trn-doc.obj-code        no-undo.
     7750     define input parameter  par-cb-artic        like ub.doc-line.artic          no-undo.
     7751     define input parameter  par-cb-prod-type    like ub.doc-line.prod-type      no-undo.
     7752     define input parameter  par-cb-prod-code    like ub.doc-line.prod-code      no-undo.
     7753     define input parameter  parinvclcspvalue    as   character                  no-undo.
     7754     define input parameter  parvalueol          as   character                  no-undo.
     7755     define output parameter parcur-qnty         like ub.doc-line.fact-qnty       no-undo.
     7756     define output parameter parcur-cli-qnty     like ub.inv-line.before-cli-qnty no-undo.
     7757     do
     7758     on error undo, return error return-value
     7759     :
     7760       define variable vartot-doc              like ub.trn-doc.doc-code  no-undo.
     7761       define variable vartot-rubl             like ub.trn-doc.tot-rubl  no-undo.
     7762       define variable v-ts-doc-line_tot-ov    like ub.trn-doc.tot-ov    no-undo.
     7763       define variable v-ts-doc-line_fact-rubl like ub.trn-doc.fact-rubl no-undo.
     7764       define variable v-ts-doc-line_fact-base like ub.trn-doc.fact-base no-undo.
     7765       define variable v-ts-doc-line_fact-qnty like ub.trn-doc.fact-qnty no-undo.
     7766       define variable v-ts-doc-line_doc-qnty  like ub.trn-doc.doc-qnty  no-undo.
     7767       define variable v-ts-doc-line_cli-qnty  like ub.trn-doc.cli-qnty  no-undo.
     7768       define variable varfact-date            as date      no-undo.
     7769       define variable varfact-time            as integer   no-undo.
     7770       define variable varfact-num             as integer   no-undo.
     7771       define variable varshift-date           as date      no-undo.
     7772       define variable varshift-num            as integer   no-undo.
     7773       define variable varshift-on             as logical   no-undo.
     7774       define variable varfact-order           as decimal   no-undo.
     7775       define variable varshift-fo             as decimal   no-undo.
     7776       define variable varday-fo               as decimal   no-undo.
     7777       define variable v-pl-qnty               as decimal   no-undo.
     7778       define variable v-pl-cli-qnty           as decimal   no-undo.
     7779       define variable v-reserv-pl             as logical   no-undo .
     7780       define variable v-rowid                 as rowid     no-undo .
     7781       define variable is-petrol               as logical   no-undo.
     7782       define variable is-pieces               as logical   no-undo.
     7783       define variable v-day                   as date      no-undo .
     7784       define variable v-ok                    as logical   no-undo .
     7785       define variable v-value                 as character no-undo .
     7786       define buffer cb_gds-obj    for ub.gds-obj.
     7787       define buffer cb_trn-doc    for ub.trn-doc.
     7788       define buffer cb_doc-line   for ub.doc-line.
     7789       define buffer cb_inv-line   for ub.inv-line .
     7790       define buffer cb_prt-obj    for ub.prt-obj.
     7791       define buffer cb_gds-dtl    for ub.gds-dtl.
     7792       define buffer cb_doc-pl     for ub.doc-pl.
     7793       define buffer cb_goods      for ub.goods .
     7794       define buffer cb_pl-gds     for ub.pl-gds .
     7795       define buffer prev_doc-line for ub.doc-line .
     7796       define buffer prev_inv-line for ub.inv-line .
     7797       find first cb_trn-doc
     7798         where cb_trn-doc.doc-code = par-cb-doc-code
     7799         .
     7800       find first cb_doc-line
     7801         where cb_doc-line.doc-code  = cb_trn-doc.doc-code
     7802           and cb_doc-line.artic     = par-cb-artic
     7803           and cb_doc-line.prod-type = par-cb-prod-type
     7804           and cb_doc-line.prod-code = par-cb-prod-code
     7805         .
     7806       find first cb_goods
     7807         where cb_goods.artic     = par-cb-artic
     7808           and cb_goods.prod-type = par-cb-prod-type
     7809           and cb_goods.prod-code = par-cb-prod-code
     7810         .
     7811   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7812   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     7813     (input  cb_doc-line.obj-type
     7814     ,input  cb_doc-line.obj-code
     7815     ,input  cb_doc-line.artic
     7816     ,input  cb_doc-line.prod-type
     7817     ,input  cb_doc-line.prod-code
     7818     ,input  'place-rsrv=request'
     7819     ,output v-reserv-pl
     7820     )  .
     7821   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     7822     (
     7823        input cb_doc-line.artic
     7824     ,  input cb_doc-line.prod-type
     7825     ,  input cb_doc-line.prod-code
     7826     , output is-petrol
     7827     , output is-pieces
     7828     ) .
     7829       if cb_trn-doc.fact-date = ? then do:
     7830         assign
     7831           varfact-order = ?
     7832         .
     7833         find first cb_gds-obj
     7834             where cb_gds-obj.obj-type  = par-cb-obj-type
     7835               and cb_gds-obj.obj-code  = par-cb-obj-code
     7836               and cb_gds-obj.artic     = par-cb-artic
     7837               and cb_gds-obj.prod-type = par-cb-prod-type
     7838               and cb_gds-obj.prod-code = par-cb-prod-code
     7839             no-error .
     7840         if available cb_gds-obj then do:
     7841           assign
     7842             cb_trn-doc.doc-qnty    = cb_trn-doc.doc-qnty    + cb_gds-obj.fact-qnty
     7843             cb_trn-doc.tot-calc    = cb_trn-doc.tot-calc    + cb_gds-obj.fact-base
     7844             cb_trn-doc.discnt-rubl = cb_trn-doc.discnt-rubl + cb_gds-obj.fact-rubl
     7845             parcur-qnty            = cb_gds-obj.fact-qnty.
     7846         end.
     7847         else do:
     7848           assign
     7849             parcur-qnty = cb_gds-obj.fact-qnty.
     7850         end.
     7851         if cb_trn-doc.ext-doc-type = 'vp':U then do:
     7852           for each cb_gds-dtl exclusive-lock
     7853             where cb_gds-dtl.doc-code  = cb_doc-line.doc-code
     7854               and cb_gds-dtl.artic     = cb_doc-line.artic
     7855               and cb_gds-dtl.prod-type = cb_doc-line.prod-type
     7856               and cb_gds-dtl.prod-code = cb_doc-line.prod-code
     7857           on error undo, return error return-value
     7858           :
     7859             find first cb_prt-obj
     7860               where cb_prt-obj.obj-type  = par-cb-obj-type
     7861                 and cb_prt-obj.obj-code  = par-cb-obj-code
     7862                 and cb_prt-obj.artic     = par-cb-artic
     7863                 and cb_prt-obj.prod-type = par-cb-prod-type
     7864                 and cb_prt-obj.prod-code = par-cb-prod-code
     7865                 and cb_prt-obj.prt-code  = cb_gds-dtl.prt-code
     7866               no-error.
     7867             if available cb_prt-obj then do:
     7868               assign
     7869                 cb_gds-dtl.fact-qnty = cb_gds-dtl.doc-qnty + cb_prt-obj.fact-qnty
     7870               .
     7871             end.
     7872             else do:
     7873               assign
     7874                 cb_gds-dtl.fact-qnty = cb_gds-dtl.doc-qnty
     7875               .
     7876             end.
     7877           end.
     7878         end.
     7879         if v-reserv-pl = true then do:
     7880           for each cb_pl-gds share-lock
     7881             where cb_pl-gds.gds-code  = cb_goods.gds-code
     7882               and cb_pl-gds.obj-type  = cb_doc-line.obj-type
     7883               and cb_pl-gds.obj-code  = cb_doc-line.obj-code
     7884           on error undo, return error return-value
     7885           :
     7886             run placelib_get-attr  ( input "place-com-tanks"
     7887                                     ,input cb_pl-gds.obj-code
     7888                                     ,input cb_pl-gds.obj-type
     7889                                     ,input cb_pl-gds.pl-code
     7890                                     ,output v-value
     7891                                     ,output v-ok      ) no-error.
     7892             if  v-ok
     7893             and v-value > ""
     7894             then do :
     7895               run placelib_get-attr  ( input "place-is-main"
     7896                                       ,input cb_pl-gds.obj-code
     7897                                       ,input cb_pl-gds.obj-type
     7898                                       ,input cb_pl-gds.pl-code
     7899                                       ,output v-value
     7900                                       ,output v-ok      ) no-error.
     7901               if v-ok and logical(v-value)
     7902               then do :
     7903               end .
     7904               else do :
     7905                 next .
     7906               end .
     7907             end .
     7908   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crdocpl in g#lib-trn
     7909   (input  cb_doc-line.doc-code
     7910   ,input  cb_pl-gds.gds-code
     7911   ,input  cb_pl-gds.pl-code
     7912   ,input  cb_pl-gds.obj-type
     7913   ,input  cb_pl-gds.obj-code
     7914   ,output v-rowid
     7915   )
     7916   .
     7917             find first cb_doc-pl exclusive-lock
     7918               where rowid(cb_doc-pl) = v-rowid
     7919               .
     7920             assign
     7921               cb_doc-pl.rest-bf-qnty     = cb_pl-gds.fact-qnty
     7922               cb_doc-pl.cli-rest-bf-qnty = cb_pl-gds.cli-fact-qnty
     7923             .
     7924           end.
     7925         end.
     7926       end.
     7927       else do:
     7928         assign
     7929           varfact-date  = cb_trn-doc.fact-date
     7930           varfact-time  = cb_trn-doc.fact-time
     7931           varfact-num   = current-value( s-trn-fact, ub ) + 1
     7932           varshift-date = cb_trn-doc.shift-date
     7933           varshift-num  = cb_trn-doc.shift-num
     7934         .
     7935   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7936   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     7937     (input  cb_trn-doc.obj-type
     7938     ,input  cb_trn-doc.obj-code
     7939     ,input  'shift-on=request'
     7940     ,output varshift-on
     7941     ) no-error .
     7942         if error-status :error or
     7943           varshift-on = ? then do:
     7944           assign
     7945             varshift-date = ?
     7946             varshift-num  = 0
     7947             varshift-on   = no
     7948           .
     7949         end.
     7950         if varfact-time = ? or
     7951            varfact-time = 0 then do:
     7952           run cur-time in this-procedure
     7953             ( output v-day
     7954              ,output varfact-time
     7955             ) .
     7956         end.
     7957         if varshift-on = yes then do:
     7958           if varshift-date = ? then do:
