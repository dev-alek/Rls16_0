        1   block-level on error undo, throw.
        2   using ibs.th.gbl.gbl-hndllib from propath.
        3   define variable vss-revision    as character no-undo initial "$Revision$":U .
        4   define variable vss-author      as character no-undo initial "$Author$":U .
        5   define variable vss-date        as character no-undo initial "$Date$":U .
        6   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        7   define variable vss-archive     as character no-undo initial "$Archive$":U .
        8   define variable vss-description as character no-undo initial "Библиотека процедур для работы со складскими документами (2)":U .
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   define new global shared variable g#trdcalib as handle no-undo.
       69   function diff-list returns character (
       70     input parfirst-list  as character,
       71     input parsecond-list as character,
       72     input pardelim       as character).
       73     if pardelim = ""
       74     or pardelim = ?
       75     then do:
       76       assign
       77         pardelim = ","
       78       .
       79     end.
       80     def var ind as integer no-undo .
       81     def var v-elem as character no-undo .
       82     def var v-result-list as character no-undo init "".
       83     def var v-num-parfirst-list as integer no-undo .
       84     assign
       85       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
       86     .
       87     do ind = 1 to v-num-parfirst-list
       88     :
       89       assign
       90         v-elem = entry(ind, parfirst-list, pardelim)
       91       .
       92       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
       93         assign
       94           v-result-list = v-result-list
       95                         + (if v-result-list > "" then pardelim else "")
       96                         + v-elem
       97         .
       98       end.
       99     end.
      100     return v-result-list .
      101   end function.
      102   function add-list returns character (
      103    input parfirst-list  as character,
      104    input parsecond-list as character,
      105    input pardelim       as character).
      106     if pardelim = ""
      107     or pardelim = ?
      108     then do:
      109       assign
      110         pardelim = ","
      111       .
      112     end.
      113     def var ind as integer no-undo .
      114     def var v-elem as character no-undo .
      115     def var v-result-list as character no-undo init "".
      116     def var v-num-parfirst-list as integer no-undo .
      117     assign
      118       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      119     .
      120     do ind = 1 to v-num-parfirst-list
      121     :
      122       assign
      123         v-elem = entry(ind, parfirst-list, pardelim)
      124       .
      125       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      126         assign
      127           v-result-list = v-result-list
      128                         + (if v-result-list > "" then pardelim else "")
      129                         + v-elem
      130         .
      131       end.
      132     end.
      133     def var v-num-parsecond-list as integer no-undo .
      134     assign
      135       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      136     .
      137     do ind = 1 to v-num-parsecond-list
      138     :
      139       assign
      140         v-elem = entry(ind, parsecond-list, pardelim)
      141       .
      142       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      143         assign
      144           v-result-list = v-result-list
      145                         + (if v-result-list > "" then pardelim else "")
      146                         + v-elem
      147         .
      148       end.
      149     end.
      150     return v-result-list .
      151   end function.
      152   function cross-list returns character (
      153    input parfirst-list  as character,
      154    input parsecond-list as character,
      155    input pardelim       as character).
      156     if pardelim = ""
      157     or pardelim = ?
      158     then do:
      159       assign
      160         pardelim = ","
      161       .
      162     end.
      163     def var ind as integer no-undo .
      164     def var v-elem as character no-undo .
      165     def var v-result-list as character no-undo init "".
      166     def var v-num-parfirst-list as integer no-undo .
      167     assign
      168       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      169     .
      170     do ind = 1 to v-num-parfirst-list
      171     :
      172       assign
      173         v-elem = entry(ind, parfirst-list, pardelim)
      174       .
      175       if lookup(v-elem, v-result-list, pardelim) = 0
      176       and lookup(v-elem, parsecond-list, pardelim) > 0
      177       then do:
      178         assign
      179           v-result-list = v-result-list
      180                         + (if v-result-list > "" then pardelim else "")
      181                         + v-elem
      182         .
      183       end.
      184     end.
      185     return v-result-list .
      186   end function.
      187   function radio-label returns character (
      188    input par-rs-value  as character,
      189    input par-rs-radio-buttons as character)
      190    .
      191    DEFINE variable v-result-label as character no-undo.
      192    assign
      193    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      194                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      195                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      196                             ), par-rs-radio-buttons
      197                           )
      198    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      199    .
      200   return v-result-label.
      201   end function.
      202   function m-radio-label returns character (
      203    input par-rs-value  as character,
      204    input par-rs-radio-buttons as character,
      205    input par-delim as character
      206    )
      207    .
      208    DEFINE variable v-result-label as character no-undo.
      209    assign
      210    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      211                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      212                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      213                             ), par-rs-radio-buttons, par-delim
      214                           )
      215    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      216    .
      217   return v-result-label.
      218   end function.
      219   FUNCTION mixlist returns character
      220   (
      221    input parfirst-list  as character
      222    ,input parsecond-list as character
      223    ,input pardelim       as character
      224    ,input pardelim-result as character ) :
      225     if pardelim = ""
      226     or pardelim = ?
      227     then do:
      228       assign
      229         pardelim = ","
      230       .
      231     end.
      232     def var ind as integer no-undo .
      233     def var v-elem1 as character no-undo .
      234     def var v-elem2 as character no-undo .
      235     def var v-result-list as character no-undo init "".
      236     do ind = 1 to num-entries(parfirst-list, pardelim)
      237     :
      238       assign
      239         v-elem1 = entry(ind, parfirst-list, pardelim)
      240         v-elem2 = entry(ind, parsecond-list, pardelim)
      241       .
      242         assign
      243           v-result-list = v-result-list
      244                         + (if v-result-list > "" then pardelim-result else "")
      245                         + v-elem1 + pardelim-result + v-elem2
      246         .
      247     end.
      248     return v-result-list .
      249   END FUNCTION.
      250   define new global shared variable g#lib-trn  as handle no-undo .
      251   define new global shared variable g#lib-trn2 as handle no-undo .
      252   define new global shared variable g#lib-trn3 as handle no-undo .
      253   define new global shared variable g#lib-trn4 as handle no-undo .
      254   define new global shared variable g#library  as handle no-undo .
      255   define new global shared variable g#library2 as handle no-undo .
      256   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      257   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      258   procedure partslib-clear-temp-parts :
      259     define buffer buf_temp-parts for temp-parts .
      260     do
      261     on error undo, return error
      262     :
      263       for each buf_temp-parts
      264       on error undo, return error
      265       :
      266         delete buf_temp-parts .
      267       end.
      268     end.
      269   end procedure.
      270   procedure partslib-create-temp-parts :
      271     define parameter buffer buf_parts       for ub.parts .
      272     define parameter buffer buf_temp-parts  for temp-parts .
      273     define input  parameter p-goods-twounit as logical   no-undo .
      274     define variable v-base-part-code as character no-undo .
      275     do
      276     on error undo, return error
      277     :
      278       if p-goods-twounit = true
      279       then do:
      280         assign
      281           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      282         .
      283       end.
      284       else do:
      285         assign
      286           v-base-part-code = buf_parts.part-code
      287         .
      288       end.
      289       find first buf_temp-parts exclusive-lock
      290         where buf_temp-parts.obj-type  = buf_parts.obj-type
      291           and buf_temp-parts.obj-code  = buf_parts.obj-code
      292           and buf_temp-parts.artic     = buf_parts.artic
      293           and buf_temp-parts.prod-type = buf_parts.prod-type
      294           and buf_temp-parts.prod-code = buf_parts.prod-code
      295           and buf_temp-parts.in-code   = buf_parts.in-code
      296           and buf_temp-parts.out-code  = 'free-zone':U
      297           and buf_temp-parts.part-code = v-base-part-code
      298         no-error.
      299       if not available buf_temp-parts
      300       then do:
      301         create buf_temp-parts .
      302         buffer-copy buf_parts to buf_temp-parts
      303         assign
      304           buf_temp-parts.out-code  = 'free-zone':U
      305           buf_temp-parts.part-code = v-base-part-code
      306           buf_temp-parts.rsrv-free = yes
      307           buf_temp-parts.status_   = no
      308           buf_temp-parts.qnty      = 0
      309           buf_temp-parts.fact-qnty = 0
      310           buf_temp-parts.real-qnty = 0
      311           buf_temp-parts.cli-qnty  = 0
      312         .
      313       end.
      314     end.
      315   end procedure.
      316   procedure partslib-init-temp-parts :
      317     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      318     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      319     define input parameter p-artic           like ub.parts.artic     no-undo .
      320     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      321     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      322     define buffer buf_parts      for ub.parts .
      323     define buffer buf_temp-parts for temp-parts .
      324     define variable v-goods-twounit    as logical   no-undo .
      325     do
      326     on error undo, return error
      327     :
      328   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      329   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      330     (input  p-artic
      331     ,input  p-prod-type
      332     ,input  p-prod-code
      333     ,input  'twounit=request':u
      334     ,output v-goods-twounit
      335     ) no-error .
      336       if error-status :error
      337       then do:
      338         message
      339           vss-workfile vss-revision vss-description skip
      340           vss-include-info1 skip
      341           "Ошибка при определении атрибута товара" skip
      342           "Артикул" p-artic p-prod-type p-prod-code skip
      343           "twounit=request" skip
      344           error-status :get-message(1) skip
      345           return-value skip
      346           view-as alert-box error .
      347         undo, return error return-value .
      348       end.
      349       run partslib-clear-temp-parts in this-procedure .
      350       for each buf_parts
      351         where buf_parts.obj-type  = p-obj-type
      352           and buf_parts.obj-code  = p-obj-code
      353           and buf_parts.artic     = p-artic
      354           and buf_parts.prod-type = p-prod-type
      355           and buf_parts.prod-code = p-prod-code
      356           and buf_parts.rsrv-free = yes
      357           and buf_parts.status_   = no
      358           and buf_parts.in-code   <> buf_parts.out-code
      359       on error undo, return error
      360       :
      361         run partslib-create-temp-parts in this-procedure
      362           (buffer buf_parts
      363           ,buffer buf_temp-parts
      364           ,input  v-goods-twounit
      365           ) .
      366         define variable v-parts-qnty          as decimal   no-undo .
      367         define variable v-parts-cli-qnty      as decimal   no-undo .
      368         define variable v-parts-free-qnty     as decimal   no-undo .
      369         define variable v-parts-free-cli-qnty as decimal   no-undo .
      370         if buf_parts.out-code = 'free-zone':U
      371         then do:
      372           assign
      373             v-parts-qnty          = buf_parts.qnty
      374             v-parts-cli-qnty      = buf_parts.cli-qnty
      375             v-parts-free-qnty     = buf_parts.qnty
      376             v-parts-free-cli-qnty = buf_parts.cli-qnty
      377           .
      378         end.
      379         else do:
      380           assign
      381             v-parts-qnty          = abs(buf_parts.qnty)
      382             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      383             v-parts-free-qnty     = 0
      384             v-parts-free-cli-qnty = 0
      385           .
      386         end.
      387         assign
      388           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      389           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      390           buf_temp-parts.real-qnty     = 0
      391           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      392           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      393           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      394         .
      395       end.
      396     end.
      397   end procedure.
      398   procedure partslib-init-temp-parts-by-factord :
      399     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      400     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      401     define input parameter p-artic              like ub.parts.artic     no-undo .
      402     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      403     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      404     define input parameter p-fact-order         as decimal   no-undo .
      405     define input parameter p-include-fact-order as logical   no-undo .
      406     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      407     define buffer buf_gds-obj  for ub.gds-obj .
      408     do
      409     on error undo, return error
      410     :
      411       do transaction
      412       on error undo, return error
      413       :
      414   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      415   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      416     (input  p-obj-type
      417     ,input  p-obj-code
      418     ,input  p-artic
      419     ,input  p-prod-type
      420     ,input  p-prod-code
      421     ,buffer buf_gds-obj
      422     ) no-error .
      423         if error-status :error
      424         then do:
      425           message
      426             vss-workfile vss-revision vss-description skip
      427             vss-include-info1 skip
      428             "Невозможно найти товар на объекте" skip
      429             "Объект" p-obj-type p-obj-code skip
      430             "Артикул" p-artic p-prod-type p-prod-code skip
      431             error-status :get-message(1) skip
      432             return-value skip
      433             view-as alert-box error .
      434           undo, return error .
      435         end.
      436         find current buf_gds-obj exclusive-lock .
      437       end.
      438       run partslib-init-temp-parts in this-procedure
      439         (input p-obj-type
      440         ,input p-obj-code
      441         ,input p-artic
      442         ,input p-prod-type
      443         ,input p-prod-code
      444         ) no-error .
      445       if error-status :error
      446       then do:
      447         message
      448           vss-workfile vss-revision vss-description skip
      449           vss-include-info1 skip
      450           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      451           "Объект" p-obj-type p-obj-code skip
      452           "Артикул" p-artic p-prod-type p-prod-code skip
      453           "p-fact-order" p-fact-order skip
      454           view-as alert-box error .
      455         undo, return error .
      456       end.
      457       if p-include-fact-order = true
      458       then do:
      459         assign
      460           p-fact-order = p-fact-order - 0.0000000001
      461         .
      462       end.
      463       define variable v-max-fact-order as character no-undo .
      464       run factord-max-fact-order in this-procedure
      465         (output v-max-fact-order
      466         ) no-error .
      467       if error-status :error
      468       then do:
      469         message
      470           vss-workfile vss-revision vss-description skip
      471           vss-include-info1 skip
      472           "Ошибка при вызове процедуры factord-max-fact-order" skip
      473           "Объект" p-obj-type p-obj-code skip
      474           "Артикул" p-artic p-prod-type p-prod-code skip
      475           "p-fact-order" p-fact-order skip
      476           view-as alert-box error .
      477         undo, return error .
      478       end.
      479       run partslib-update-by-factord in this-procedure
      480         (input p-obj-type
      481         ,input p-obj-code
      482         ,input p-artic
      483         ,input p-prod-type
      484         ,input p-prod-code
      485         ,input p-fact-order
      486         ,input v-max-fact-order
      487         ,input false
      488         ) no-error .
      489       if error-status :error
      490       then do:
      491         message
      492           vss-workfile vss-revision vss-description skip
      493           vss-include-info1 skip
      494           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      495           "Объект" p-obj-type p-obj-code skip
      496           "Артикул" p-artic p-prod-type p-prod-code skip
      497           "p-fact-order" p-fact-order skip
      498           "v-max-fact-order" v-max-fact-order skip
      499           view-as alert-box error .
      500         undo, return error .
      501       end.
      502     end.
      503   end procedure.
      504   procedure partslib-update-by-factord :
      505     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      506     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      507     define input parameter p-artic              like ub.parts.artic     no-undo .
      508     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      509     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      510     define input parameter p-start-fact-order   as decimal   no-undo .
      511     define input parameter p-end-fact-order     as decimal   no-undo .
      512     define input parameter p-lock-gds-obj       as logical   no-undo .
      513     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      514     define buffer buf_gds-obj  for ub.gds-obj .
      515     define buffer buf_doc-line for ub.doc-line .
      516     define variable v-total-parts-qnty as decimal   no-undo .
      517     define variable v-goods-gds-goods  as logical   no-undo .
      518     define variable v-goods-twounit    as logical   no-undo .
      519     do
      520     on error undo, return error
      521     :
      522       if p-start-fact-order > p-end-fact-order
      523       then do:
      524         message
      525           vss-workfile vss-revision vss-description skip
      526           vss-include-info1 skip
      527           "Ошибка задания входных параметров" skip
      528           "Начало интервала превышает конец интервала" skip
      529           "Объект" p-obj-type p-obj-code skip
      530           "Артикул" p-artic p-prod-type p-prod-code skip
      531           "p-start-fact-order" p-start-fact-order skip
      532           "p-end-fact-order"   p-end-fact-order skip
      533           view-as alert-box error .
      534         undo, return error .
      535       end.
      536       if p-lock-gds-obj = true
      537       then do:
      538         do transaction
      539         on error undo, return error
      540         :
      541   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      542   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      543     (input  p-obj-type
      544     ,input  p-obj-code
      545     ,input  p-artic
      546     ,input  p-prod-type
      547     ,input  p-prod-code
      548     ,buffer buf_gds-obj
      549     ) no-error .
      550           if error-status :error
      551           then do:
      552             message
      553               vss-workfile vss-revision vss-description skip
      554               vss-include-info1 skip
      555               "Невозможно найти gds-obj" skip
      556               error-status :get-message(1) skip
      557               return-value skip
      558               view-as alert-box error .
      559             undo, return error .
      560           end.
      561           find current buf_gds-obj exclusive-lock .
      562         end.
      563       end.
      564   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      565   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      566     (input  p-artic
      567     ,input  p-prod-type
      568     ,input  p-prod-code
      569     ,input  'gds-goods=request':u
      570     ,output v-goods-gds-goods
      571     ) no-error .
      572       if error-status :error
      573       then do:
      574         message
      575           vss-workfile vss-revision vss-description skip
      576           vss-include-info1 skip
      577           "Ошибка при определении атрибута товара" skip
      578           "Артикул" p-artic p-prod-type p-prod-code skip
      579           "gds-goods=request" skip
      580           error-status :get-message(1) skip
      581           return-value skip
      582           view-as alert-box error .
      583         undo, return error return-value .
      584       end.
      585   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      586   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      587     (input  p-artic
      588     ,input  p-prod-type
      589     ,input  p-prod-code
      590     ,input  'twounit=request':u
      591     ,output v-goods-twounit
      592     ) no-error .
      593       if error-status :error
      594       then do:
      595         message
      596           vss-workfile vss-revision vss-description skip
      597           vss-include-info1 skip
      598           "Ошибка при определении атрибута товара" skip
      599           "Артикул" p-artic p-prod-type p-prod-code skip
      600           "twounit=request" skip
      601           error-status :get-message(1) skip
      602           return-value skip
      603           view-as alert-box error .
      604         undo, return error return-value .
      605       end.
      606       for each buf_doc-line no-lock
      607         where buf_doc-line.obj-type   = p-obj-type
      608           and buf_doc-line.obj-code   = p-obj-code
      609           and buf_doc-line.artic      = p-artic
      610           and buf_doc-line.prod-type  = p-prod-type
      611           and buf_doc-line.prod-code  = p-prod-code
      612           and buf_doc-line.status_    = 'факт':U
      613           and buf_doc-line.fact-order > p-start-fact-order
      614           and buf_doc-line.fact-order <= p-end-fact-order
      615       on error undo, return error
      616       :
      617         run partslib-process-document in this-procedure
      618           (input  buf_doc-line.doc-code
      619           ,input  p-obj-type
      620           ,input  p-obj-code
      621           ,input  p-artic
      622           ,input  p-prod-type
      623           ,input  p-prod-code
      624           ,input  v-goods-gds-goods
      625           ,input  v-goods-twounit
      626           ,output v-total-parts-qnty
      627           ) no-error .
      628         if error-status :error
      629         then do:
      630           message
      631             vss-workfile vss-revision vss-description skip
      632             vss-include-info1 skip
      633             "Ошибка при вызове процедуры partslib-process-document" skip
      634             "Документ" buf_doc-line.doc-code skip
      635             "Объект" p-obj-type p-obj-code skip
      636             "Артикул" p-artic p-prod-type p-prod-code skip
      637             "p-start-fact-order" p-start-fact-order skip
      638             "p-end-fact-order" p-end-fact-order skip
      639             error-status :get-message(1) skip
      640             return-value skip
      641             view-as alert-box error .
      642           undo, return error return-value .
      643         end.
      644       end.
      645     end.
      646   end procedure.
      647   procedure partslib-process-document :
      648     define input  parameter p-doc-code         as character no-undo .
      649     define input  parameter p-obj-type         as character no-undo .
      650     define input  parameter p-obj-code         as integer   no-undo .
      651     define input  parameter p-artic            as character no-undo .
      652     define input  parameter p-prod-type        as character no-undo .
      653     define input  parameter p-prod-code        as integer   no-undo .
      654     define input  parameter p-goods-gds-goods  as logical   no-undo .
      655     define input  parameter p-goods-twounit    as logical   no-undo .
      656     define output parameter p-total-parts-qnty as decimal   no-undo .
      657     define variable v-parts-sign as integer   no-undo .
      658     define buffer buf_trn-doc    for ub.trn-doc .
      659     define buffer buf_doc-line   for ub.doc-line .
      660     define buffer buf_parts      for ub.parts .
      661     define buffer buf_temp-parts for temp-parts .
      662     do
      663     on error undo, return error return-value
      664     :
      665       find first buf_trn-doc no-lock
      666         where buf_trn-doc.doc-code = p-doc-code
      667         no-error .
      668       if not available buf_trn-doc
      669       then do:
      670         undo, return error substitute("Ошибка при поиске документа. Документ &1"
      671                                      ,p-doc-code
      672                                      ) .
      673       end.
      674       case buf_trn-doc.doc-type
      675       :
      676         when 'при':U or
      677         when 'возврат':U or
      678         when 'инв':U
      679         then do:
      680           assign
      681             v-parts-sign = -1
      682           .
      683         end.
      684         when 'рас':U or
      685         when 'спи':U
      686         then do:
      687           assign
      688             v-parts-sign = 1
      689           .
      690         end.
      691         otherwise do:
      692           undo, return error substitute("Неизвестный тип документа &1"
      693                                       ,buf_trn-doc.doc-type
      694                                       ) .
      695         end.
      696       end.
      697       find first buf_doc-line no-lock
      698         where buf_doc-line.doc-code  = p-doc-code
      699           and buf_doc-line.artic     = p-artic
      700           and buf_doc-line.prod-type = p-prod-type
      701           and buf_doc-line.prod-code = p-prod-code
      702         no-error .
      703       if not available buf_doc-line
      704       then do:
      705         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
      706                                      ,p-doc-code
      707                                      ,artic
      708                                      ,prod-type
      709                                      ,prod-code
      710                                      ) .
      711       end.
      712       assign
      713         p-total-parts-qnty = 0
      714       .
      715       if p-goods-gds-goods = true
      716       then do:
      717         for each buf_parts no-lock
      718           where buf_parts.out-code  = p-doc-code
      719             and buf_parts.obj-type  = p-obj-type
      720             and buf_parts.obj-code  = p-obj-code
      721             and buf_parts.artic     = p-artic
      722             and buf_parts.prod-type = p-prod-type
      723             and buf_parts.prod-code = p-prod-code
      724         on error undo, return error
      725         :
      726           run partslib-create-temp-parts in this-procedure
      727             (buffer buf_parts
      728             ,buffer buf_temp-parts
      729             ,input  p-goods-twounit
      730             ) .
      731           assign
      732             p-total-parts-qnty        = p-total-parts-qnty
      733                                       + v-parts-sign * buf_parts.fact-qnty
      734             buf_temp-parts.qnty       = buf_temp-parts.qnty
      735                                       + v-parts-sign * buf_parts.fact-qnty
      736             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
      737                                       + v-parts-sign * buf_parts.fact-qnty
      738             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
      739                                       + v-parts-sign * buf_parts.cli-qnty
      740           .
      741           if buf_temp-parts.qnty = 0
      742           then do:
      743             delete buf_temp-parts .
      744           end.
      745         end.
      746       end.
      747       else do:
      748         assign
      749           p-total-parts-qnty = p-total-parts-qnty
      750                              + v-parts-sign * buf_doc-line.fact-qnty
      751         .
      752       end.
      753     end.
      754   end procedure.
      755   procedure partslib-init-temp-parts-by-date :
      756     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      757     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      758     define input parameter p-artic           like ub.parts.artic     no-undo .
      759     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      760     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      761     define input parameter p-fact-date       as date      no-undo .
      762     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
      763     do
      764     on error undo, return error
      765     :
      766       define variable v-fact-order                as decimal   no-undo .
      767       define variable v-shift-end-fact-order      as decimal   no-undo .
      768       define variable v-day-end-fact-order        as decimal   no-undo .
      769       run factord in this-procedure
      770         (input  p-fact-date
      771         ,input  1
      772         ,input  1
      773         ,input  ?
      774         ,input  0
      775         ,input  false
      776         ,output v-fact-order
      777         ,output v-shift-end-fact-order
      778         ,output v-day-end-fact-order
      779         ) no-error .
      780       if error-status :error
      781       then do:
      782         message
      783           vss-workfile vss-revision vss-description skip
      784           vss-include-info1 skip
      785           "Ошибка при определении момента времени, на который требуется остаток" skip
      786           "Объект" p-obj-type p-obj-code skip
      787           "Артикул" p-artic p-prod-type p-prod-code skip
      788           "Дата" p-fact-date skip
      789           view-as alert-box error .
      790         undo, return error .
      791       end.
      792       run partslib-init-temp-parts-by-factord in this-procedure
      793         (input p-obj-type
      794         ,input p-obj-code
      795         ,input p-artic
      796         ,input p-prod-type
      797         ,input p-prod-code
      798         ,input v-day-end-fact-order
      799         ,input false
      800         ) no-error .
      801       if error-status :error
      802       then do:
      803         message
      804           vss-workfile vss-revision vss-description skip
      805           vss-include-info1 skip
      806           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
      807           "Объект" p-obj-type p-obj-code skip
      808           "Артикул" p-artic p-prod-type p-prod-code skip
      809           "Дата" p-fact-date skip
      810           view-as alert-box error .
      811         undo, return error .
      812       end.
      813     end.
      814   end procedure.
      815   procedure partslib-calc-cost :
      816     define output parameter p-fact-qnty      as decimal   no-undo .
      817     define output parameter p-vat-pc         as decimal   no-undo .
      818     define output parameter p-slt-pc         as decimal   no-undo .
      819     define output parameter p-sum-base       as decimal   no-undo .
      820     define output parameter p-sum-rubl       as decimal   no-undo .
      821     define output parameter p-vat-base       as decimal   no-undo .
      822     define output parameter p-vat-rubl       as decimal   no-undo .
      823     define output parameter p-slt-base       as decimal   no-undo .
      824     define output parameter p-slt-rubl       as decimal   no-undo .
      825     define output parameter p-road-tax-base  as decimal   no-undo .
      826     define output parameter p-road-tax-rubl  as decimal   no-undo .
      827     define output parameter p-transport-base as decimal   no-undo .
      828     define output parameter p-transport-rubl as decimal   no-undo .
      829     define output parameter p-other-base     as decimal   no-undo .
      830     define output parameter p-other-rubl     as decimal   no-undo .
      831     define output parameter p-excise-base    as decimal   no-undo .
      832     define output parameter p-excise-rubl    as decimal   no-undo .
      833     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
      834     do
      835     on error undo, return error return-value
      836     :
      837       define buffer buf_temp-parts for temp-parts .
      838       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      839       define buffer   in-vatp-parts    for ub.parts   .
      840       define buffer   in-vatp-doc      for ub.trn-doc .
      841       define buffer   in-vatp-goods    for ub.goods   .
      842       define buffer   in-vatp-sysconf  for ub.sysconf .
      843       define buffer   in-vatp_doc-attr for ub.doc-attr.
      844       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      845       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      846       define variable varinvprb                  as   character              no-undo.
      847       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      848       define variable cli-base-rate              as   decimal                no-undo.
      849       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      850       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      851       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      852       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      853       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      854       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      855       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      856       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      857       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      858       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      859       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      860       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      861       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      862       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      863       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      864       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      865       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      866       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      867       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      868       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      869       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      870       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      871       define variable varinvatp-envd             as   character              no-undo.
      872       define variable varinvatp-type             as   character              no-undo.
      873       for each buf_temp-parts
      874       on error undo, return error
      875       :
      876   assign
      877     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
      878     price-base-with-tax-loc = buf_temp-parts.price-base
      879   .
      880   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      881   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      882     (output varinvprb
      883     )  .
      884     if buf_temp-parts.out-code = 'free-zone':U     or
      885        buf_temp-parts.out-code = 'out-zone':U   or
      886        buf_temp-parts.doc-type = 'акт':U then do:
      887       assign
      888         in-vatp-have-vat-slt = yes.
      889     end.
      890     else do:
      891       find first in-vatp_doc-attr no-lock
      892         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
      893           and in-vatp_doc-attr.attr-code = 'envd':U
      894         no-error .
      895       if not available in-vatp_doc-attr then do:
      896         assign
      897           in-vatp-have-vat-slt = yes.
      898       end.
      899       else do:
      900            in-vatp-have-vat-slt = no.
      901       end.
      902     end.
      903     assign
      904      price-cli-with-tax-loc = buf_temp-parts.price-cli
      905      cli-base-rate          = buf_temp-parts.cli-base-rate.
      906     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
      907              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
      908     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
      909             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
      910             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
      911             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
      912             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
      913             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
      914             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      915       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      916     assign
      917       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
      918     assign
      919       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      920       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      921       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      922       transport-cli-loc  = 0
      923       other-cli-loc      = 0
      924     .
      925   ASSIGN
      926             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      927       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      928   .
      929         assign
      930           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
      931           p-vat-pc         = p-vat-pc         + vat-pc-loc
      932           p-slt-pc         = p-slt-pc         + slt-pc-loc
      933           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
      934           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
      935           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
      936           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
      937           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
      938           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
      939           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
      940           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
      941           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
      942           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
      943           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
      944           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
      945           p-excise-base    = p-excise-base    + 0
      946           p-excise-rubl    = p-excise-rubl    + 0
      947         .
      948       end.
      949       if p-fact-qnty      = ?
      950       or p-sum-base       = ?
      951       or p-sum-rubl       = ?
      952       or p-vat-base       = ?
      953       or p-vat-rubl       = ?
      954       or p-slt-base       = ?
      955       or p-slt-rubl       = ?
      956       or p-road-tax-base  = ?
      957       or p-road-tax-rubl  = ?
      958       or p-transport-base = ?
      959       or p-transport-rubl = ?
      960       or p-other-base     = ?
      961       or p-other-rubl     = ?
      962       or p-excise-base    = ?
      963       or p-excise-rubl    = ?
      964       then do:
      965         message
      966           vss-workfile vss-revision vss-description skip
      967           vss-include-info1 skip
      968           "Программа in-vatp.i вернула неопределенные значения" skip
      969           "p-fact-qnty"      p-fact-qnty      skip
      970           "p-sum-base"       p-sum-base       skip
      971           "p-sum-rubl"       p-sum-rubl       skip
      972           "p-vat-base"       p-vat-base       skip
      973           "p-vat-rubl"       p-vat-rubl       skip
      974           "p-slt-base"       p-slt-base       skip
      975           "p-slt-rubl"       p-slt-rubl       skip
      976           "p-road-tax-base"  p-road-tax-base  skip
      977           "p-road-tax-rubl"  p-road-tax-rubl  skip
      978           "p-transport-base" p-transport-base skip
      979           "p-transport-rubl" p-transport-rubl skip
      980           "p-other-base"     p-other-base     skip
      981           "p-other-rubl"     p-other-rubl     skip
      982           "p-excise-base"    p-excise-base    skip
      983           "p-excise-rubl"    p-excise-rubl    skip
      984           view-as alert-box error .
      985         undo, return error .
      986       end.
      987     end.
      988   end procedure.
