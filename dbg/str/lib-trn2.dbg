     4387     end.
     4388   end procedure.
     4389   procedure prdoclib-calc-prc :
     4390     define input  parameter p-price-doc-recid as   recid                  no-undo.
     4391     define input  parameter p-cons-pay        as   integer                no-undo.
     4392     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     4393     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     4394     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     4395     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     4396     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     4397     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     4398     do
     4399     on error undo, return error return-value
     4400     :
     4401       define buffer buf_price-doc       for ub.price-doc .
     4402       define buffer buf_price-list      for ub.price-list .
     4403       define buffer buf_parts           for ub.parts .
     4404       define variable v-ov-qnty     as decimal   no-undo .
     4405       define variable v-ov-base     as decimal   no-undo .
     4406       define variable v-ov-VAT-base as decimal   no-undo .
     4407       define variable v-ov-SLT-base as decimal   no-undo .
     4408       define variable v-cons-qnty   as decimal   no-undo .
     4409       define variable v-prch-qnty   as decimal   no-undo .
     4410       define variable v-cons-mult   as decimal   no-undo .
     4411       define variable v-prch-mult   as decimal   no-undo .
     4412       find first buf_price-doc no-lock
     4413         where recid(buf_price-doc) = p-price-doc-recid
     4414         no-error .
     4415       if not available buf_price-doc
     4416       then do:
     4417         message
     4418           vss-workfile vss-revision vss-description skip
     4419           vss-include-info26 skip
     4420           "Ошибка задания входных параметров" skip
     4421           "Не найден документ переоценки" skip
     4422           "Код записи (recid)" p-price-doc-recid skip
     4423           view-as alert-box error .
     4424         undo, return error .
     4425       end.
     4426       for each buf_price-list no-lock
     4427         where buf_price-list.doc-num    = buf_price-doc.doc-num
     4428           and buf_price-list.main-price = true
     4429       on error undo, return error return-value
     4430       :
     4431         run prdoclib-calc-ov
     4432           (input recid(buf_price-list)
     4433           ,output v-ov-qnty
     4434           ,output v-ov-base
     4435           ,output v-ov-VAT-base
     4436           ,output v-ov-SLT-base
     4437           ) no-error .
     4438         if error-status :error
     4439         then do:
     4440           if error-status :get-message(1) <> ""
     4441           then do:
     4442             message
     4443               vss-workfile vss-revision vss-description skip
     4444               vss-include-info26 skip
     4445               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     4446               error-status :get-message(1) skip
     4447               return-value skip
     4448               view-as alert-box error .
     4449           end.
     4450           undo, return error return-value .
     4451         end.
     4452         assign
     4453           v-cons-qnty = 0
     4454           v-prch-qnty = 0
     4455         .
     4456         for each buf_parts no-lock
     4457           where buf_parts.out-code  = buf_price-list.doc-num
     4458             and buf_parts.obj-type  = buf_price-list.obj-type
     4459             and buf_parts.obj-code  = buf_price-list.obj-code
     4460             and buf_parts.artic     = buf_price-list.artic
     4461             and buf_parts.prod-type = buf_price-list.prod-type
     4462             and buf_parts.prod-code = buf_price-list.prod-code
     4463         on error undo, return error return-value
     4464         :
     4465           if buf_parts.pay-code = p-cons-pay
     4466           then do:
     4467             assign
     4468               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     4469             .
     4470           end.
     4471           else do:
     4472             assign
     4473               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     4474             .
     4475           end.
     4476         end.
     4477         if (v-cons-qnty + v-prch-qnty) = 0
     4478         then do:
     4479           assign
     4480             v-cons-mult = 0
     4481             v-prch-mult = 1
     4482           .
     4483         end.
     4484         else do:
     4485           assign
     4486             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     4487             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     4488           .
     4489         end.
     4490         assign
     4491           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     4492           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     4493           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     4494           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     4495           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     4496           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     4497         .
     4498       end.
     4499     end.
     4500   end procedure.
     4501   procedure prdoclib-calc-ov :
     4502     define input  parameter p-price-list-recid as recid     no-undo .
     4503     define output parameter p-fact-qnty        as decimal   no-undo .
     4504     define output parameter p-ov-base          as decimal   no-undo .
     4505     define output parameter p-ov-VAT-base      as decimal   no-undo .
     4506     define output parameter p-ov-SLT-base      as decimal   no-undo .
     4507     do
     4508     on error undo, return error return-value
     4509     :
     4510       define buffer buf_main_price-list    for ub.price-list .
     4511       define buffer buf_prev_price-list    for ub.price-list .
     4512       define buffer buf_special_price-list for ub.price-list .
     4513       define buffer buf_goods              for ub.goods .
     4514       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     4515       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     4516       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     4517       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     4518       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     4519       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     4520       define variable v-prev-price-list-recid as   recid                  no-undo.
     4521       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     4522       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     4523       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     4524       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     4525       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     4526       find first buf_main_price-list no-lock
     4527         where recid(buf_main_price-list) = p-price-list-recid
     4528         no-error .
     4529       if not available buf_main_price-list
     4530       then do:
     4531         message
     4532           vss-workfile vss-revision vss-description skip
     4533           vss-include-info26 skip
     4534           "Ошибка задания входных параметров" skip
     4535           "Не найдена строка переоценки" skip
     4536           "Код записи (recid)" p-price-list-recid skip
     4537           view-as alert-box error .
     4538         undo, return error .
     4539       end.
     4540       if buf_main_price-list.main-price <> true
     4541       then do:
     4542         message
     4543           vss-workfile vss-revision vss-description skip
     4544           vss-include-info26 skip
     4545           "Ошибка задания входных параметров" skip
     4546           "Строка переоценки не является основной" skip
     4547           "Код записи (recid)" p-price-list-recid skip
     4548           "Переоценка" buf_main_price-list.doc-num skip
     4549           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     4550           "Бар-код" buf_main_price-list.b-code skip
     4551           view-as alert-box error .
     4552         undo, return error .
     4553       end.
     4554       run prdoclib-calc-fact-sale in this-procedure
     4555         (input  recid(buf_main_price-list)
     4556         ,output v-fact-qnty
     4557         ,output v-cur-base
     4558         ,output v-cur-VAT-base
     4559         ,output v-cur-SLT-base
     4560         ,output v-cur-road-tax-base
     4561         ,output v-cur-excise-base
     4562         ) no-error.
     4563       if error-status :error
     4564       then do:
     4565         message
     4566           vss-workfile vss-revision vss-description skip
     4567           vss-include-info26 skip
     4568           "Ошибка при расчете сумм переоценки." skip
     4569           "Документ переоценки" buf_main_price-list.doc-num skip
     4570           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     4571           error-status :get-message(1) skip
     4572           return-value skip
     4573           view-as alert-box error .
     4574         undo, return error .
     4575       end.
     4576   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4577   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     4578     (input  buf_main_price-list.obj-type
     4579     ,input  buf_main_price-list.obj-code
     4580     ,input  buf_main_price-list.b-code
     4581     ,input  buf_main_price-list.b-code
     4582     ,input  buf_main_price-list.fact-order
     4583     ,output v-prev-price-list-recid
     4584     ,output v-prev-cli-base-rate
     4585     ) no-error .
     4586       if error-status :error
     4587       then do:
     4588         message
     4589           vss-workfile vss-revision vss-description skip
     4590           vss-include-info26 skip
     4591           "Ошибка при поиске предыдущей переоценки." skip
     4592           "Документ переоценки " buf_main_price-list.doc-num skip
     4593           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     4594           error-status :get-message(1) skip
     4595           return-value skip
     4596           view-as alert-box error .
     4597         undo, return error .
     4598       end.
     4599       if v-prev-price-list-recid <> ?
     4600       then do:
     4601         find first buf_prev_price-list no-lock
     4602           where recid(buf_prev_price-list) = v-prev-price-list-recid
     4603           .
     4604         find first buf_special_price-list no-lock
     4605           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     4606             and buf_special_price-list.main-price = false
     4607             and buf_special_price-list.artic      = buf_prev_price-list.artic
     4608             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     4609             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     4610             and buf_special_price-list.doc-qnty   <> ?
     4611           no-error .
     4612         if available buf_special_price-list
     4613         then do:
     4614           message
     4615             "Товар имеет специальные цены на признаки" skip
     4616             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     4617             "Переоценка" buf_prev_price-list.doc-num skip
     4618             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     4619             view-as alert-box error .
     4620           undo, return error .
     4621         end.
     4622         find first buf_goods no-lock
     4623           where buf_goods.artic     = buf_main_price-list.artic
     4624             and buf_goods.prod-type = buf_main_price-list.prod-type
     4625             and buf_goods.prod-code = buf_main_price-list.prod-code
     4626           no-error .
     4627         if not available buf_goods
     4628         then do:
     4629           message
     4630             vss-workfile vss-revision vss-description skip
     4631             vss-include-info26 skip
     4632             "Не найден товар" skip
     4633             "Переоценка" buf_main_price-list.doc-num skip
     4634             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     4635             view-as alert-box error .
     4636           undo, return error .
     4637         end.
     4638         if buf_prev_price-list.vat-pc = ?
     4639         or buf_prev_price-list.slt-pc = ?
     4640         then do:
     4641           message
     4642             "В переоценке не заданы налоги товара" skip
     4643             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     4644             "Переоценка" buf_prev_price-list.doc-num skip
     4645             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     4646             "НДС" buf_prev_price-list.vat-pc skip
     4647             "НП" buf_prev_price-list.slt-pc skip
     4648             view-as alert-box error .
     4649           undo, return error return-value .
     4650         end.
     4651         define variable v-prev-cur-SLT-pc as decimal no-undo .
     4652         assign
     4653           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     4654         .
     4655         assign
     4656           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     4657           v-prev-cur-VAT-base = v-fact-qnty
     4658                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     4659                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     4660           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     4661         .
     4662         assign
     4663           p-fact-qnty   = v-fact-qnty
     4664           p-ov-base     = v-cur-base     - v-prev-cur-base
     4665           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     4666           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     4667         .
     4668       end.
     4669       else do:
     4670         assign
     4671           v-prev-cur-base     = 0
     4672           v-prev-cur-VAT-base = 0
     4673           v-prev-cur-SLT-base = 0
     4674           .
     4675         assign
     4676           p-fact-qnty   = v-fact-qnty
     4677           p-ov-base     = v-cur-base     - v-prev-cur-base
     4678           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     4679           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     4680         .
     4681       end.
     4682     end.
     4683   end procedure.
     4684   procedure prdoclib-init-prt-obj-by-factord :
     4685     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     4686     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     4687     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     4688     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     4689     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     4690     define input parameter p-fact-order         as decimal   no-undo .
     4691     define input parameter p-include-fact-order as logical   no-undo .
     4692     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     4693     define buffer buf_gds-obj      for ub.gds-obj .
     4694     define buffer buf_doc-line     for ub.doc-line .
     4695     define buffer buf_temp-prt-obj for temp-prt-obj .
     4696     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     4697     do
     4698     on error undo, return error return-value
     4699     :
     4700       do transaction
     4701       on error undo, return error return-value
     4702       :
     4703   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4704   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     4705     (input  p-obj-type
     4706     ,input  p-obj-code
     4707     ,input  p-artic
     4708     ,input  p-prod-type
     4709     ,input  p-prod-code
     4710     ,buffer buf_gds-obj
     4711     ) no-error .
     4712         if error-status :error
     4713         then do:
     4714           message
     4715             vss-workfile vss-revision vss-description skip
     4716             vss-include-info26 skip
     4717             "Невозможно найти gds-obj" skip
     4718             error-status :get-message(1) skip
     4719             return-value skip
     4720             view-as alert-box error .
     4721           undo, return error .
     4722         end.
     4723         find current buf_gds-obj exclusive-lock .
     4724       end.
     4725       run prdoclib-init-temp-prt-obj in this-procedure
     4726         (input p-obj-type
     4727         ,input p-obj-code
     4728         ,input p-artic
     4729         ,input p-prod-type
     4730         ,input p-prod-code
     4731         ,input 0
     4732         ) .
     4733       for each buf_temp-prt-obj
     4734         where buf_temp-prt-obj.is-term <> true
     4735       on error undo, return error return-value
     4736       :
     4737         delete buf_temp-prt-obj .
     4738       end.
     4739       if p-include-fact-order = true
     4740       then do:
     4741         assign
     4742          p-fact-order = p-fact-order - 0.0000000001
     4743         .
     4744       end.
     4745       for each buf_doc-line no-lock
     4746         where buf_doc-line.obj-type   = p-obj-type
     4747           and buf_doc-line.obj-code   = p-obj-code
     4748           and buf_doc-line.artic      = p-artic
     4749           and buf_doc-line.prod-type  = p-prod-type
     4750           and buf_doc-line.prod-code  = p-prod-code
     4751           and buf_doc-line.status_    = 'факт':U
     4752           and buf_doc-line.fact-order >= p-fact-order
     4753       on error undo, return error return-value
     4754       :
     4755         run prdoclib-process-document in this-procedure
     4756           (input  buf_doc-line.doc-code
     4757           ,input  p-obj-type
     4758           ,input  p-obj-code
     4759           ,input  p-artic
     4760           ,input  p-prod-type
     4761           ,input  p-prod-code
     4762           ,output v-total-gds-dtl-qnty
     4763           ) .
     4764       end.
     4765     end.
     4766   end procedure.
     4767   procedure prdoclib-process-document :
     4768     define input  parameter p-doc-code           as character no-undo .
     4769     define input  parameter p-obj-type           as character no-undo .
     4770     define input  parameter p-obj-code           as integer   no-undo .
     4771     define input  parameter p-artic              as character no-undo .
     4772     define input  parameter p-prod-type          as character no-undo .
     4773     define input  parameter p-prod-code          as integer   no-undo .
     4774     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     4775     define buffer buf_trn-doc      for ub.trn-doc .
     4776     define buffer buf_gds-dtl      for ub.gds-dtl .
     4777     define buffer buf_temp-prt-obj for temp-prt-obj .
     4778     do
     4779     on error undo, return error return-value
     4780     :
     4781       find first buf_trn-doc no-lock
     4782         where buf_trn-doc.doc-code = p-doc-code
     4783         no-error .
     4784       if not available buf_trn-doc then do:
     4785         message
     4786           vss-workfile vss-revision vss-description skip
     4787           vss-include-info26 skip
     4788           "Ошибка при поиске документа" skip
     4789           "Документ" p-doc-code skip
     4790           "Объект" p-obj-type p-obj-code skip
     4791           "Артикул" p-artic p-prod-type p-prod-code skip
     4792           view-as alert-box error .
     4793         undo, return error .
     4794       end.
     4795       assign
     4796         p-total-gds-dtl-qnty = 0
     4797       .
     4798       for each buf_gds-dtl no-lock
     4799         where buf_gds-dtl.doc-code  = p-doc-code
     4800           and buf_gds-dtl.artic     = p-artic
     4801           and buf_gds-dtl.prod-type = p-prod-type
     4802           and buf_gds-dtl.prod-code = p-prod-code
     4803       on error undo, return error
     4804       :
     4805         define variable v-term-node as integer   no-undo .
     4806   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     4807     (input  buf_gds-dtl.prt-code
     4808     ,output v-term-node
     4809     )  .
     4810         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     4811           (input  v-term-node
     4812           ,buffer buf_temp-prt-obj
     4813           ) .
     4814         if buf_temp-prt-obj.is-term <> true then do:
     4815           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     4816                                        ,buf_gds-dtl.prt-code
     4817                                        ) .
     4818         end.
     4819         case buf_trn-doc.doc-type :
     4820           when 'при':U or
     4821           when 'возврат':U
     4822           then do:
     4823             assign
     4824               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     4825                                           - buf_gds-dtl.fact-qnty
     4826               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     4827                                           - buf_gds-dtl.fact-qnty
     4828             .
     4829           end.
     4830           when 'рас':U or
     4831           when 'спи':U
     4832           then do:
     4833             assign
     4834               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     4835                                           + buf_gds-dtl.fact-qnty
     4836               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     4837                                           + buf_gds-dtl.fact-qnty
     4838             .
     4839           end.
     4840           when 'инв':U
     4841           then do:
     4842             assign
     4843               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     4844                                           - buf_gds-dtl.doc-qnty
     4845               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     4846                                           - buf_gds-dtl.doc-qnty
     4847             .
     4848           end.
     4849           otherwise do:
     4850             undo, return error substitute("Неизвестный тип документа &1"
     4851                                          ,buf_trn-doc.doc-type
     4852                                          ) .
     4853           end.
     4854         end.
     4855       end.
     4856     end.
     4857   end procedure.
     4858   procedure prdoclib-prc-pl-document :
     4859     define input  parameter p-doc-code              as character no-undo .
     4860     define input  parameter p-obj-type              as character no-undo .
     4861     define input  parameter p-obj-code              as integer   no-undo .
     4862     define input  parameter p-gds-code              as integer   no-undo .
     4863     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     4864     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     4865     do
     4866     on error undo, return error return-value
     4867     :
     4868       define buffer buf_trn-doc      for ub.trn-doc .
     4869       define buffer buf_doc-pl       for ub.doc-pl .
     4870       define buffer buf_temp-pl-gds for temp-pl-gds .
     4871       define variable v-sign as decimal   no-undo .
     4872       find first buf_trn-doc no-lock
     4873         where buf_trn-doc.doc-code = p-doc-code
     4874         no-error .
     4875       if not available buf_trn-doc then do:
     4876         message
     4877           vss-workfile vss-revision vss-description skip
     4878           vss-include-info26 skip
     4879           "Ошибка при поиске документа" skip
     4880           "Документ" p-doc-code skip
     4881           "Объект" p-obj-type p-obj-code skip
     4882           "Товар" p-gds-code skip
     4883           view-as alert-box error .
     4884         undo, return error .
     4885       end.
     4886       assign
     4887         p-total-pl-gds-qnty     = 0
     4888         p-total-pl-gds-cli-qnty = 0
     4889       .
     4890       for each buf_doc-pl no-lock
     4891         where buf_doc-pl.out-code  = p-doc-code
     4892           and buf_doc-pl.gds-code  = p-gds-code
     4893       on error undo, return error return-value
     4894       :
     4895         find first buf_temp-pl-gds
     4896           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     4897             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     4898             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     4899           .
     4900         case buf_trn-doc.doc-type :
     4901           when 'при':U
     4902           or when 'возврат':U
     4903           or when 'инв':U
     4904           then do:
     4905             assign
     4906               v-sign = -1.0
     4907             .
     4908           end.
     4909           when 'рас':U or
     4910           when 'спи':U
     4911           then do:
     4912             assign
     4913               v-sign = 1.0
     4914             .
     4915           end.
     4916           otherwise do:
     4917             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     4918           end.
     4919         end case.
     4920         assign
     4921           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     4922           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     4923           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     4924           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     4925         .
     4926       end.
     4927     end.
     4928   end procedure.
     4929   procedure prdoclib-init-prt-obj-by-date :
     4930     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     4931     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     4932     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     4933     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     4934     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     4935     define input parameter p-fact-date  as date      no-undo .
     4936     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     4937     do
     4938     on error undo, return error return-value
     4939     :
     4940       define variable v-fact-order                as decimal   no-undo .
     4941       define variable v-shift-end-fact-order      as decimal   no-undo .
     4942       define variable v-day-end-fact-order        as decimal   no-undo .
     4943       run factord in this-procedure
     4944         (input  p-fact-date
     4945         ,input  1
     4946         ,input  1
     4947         ,input  ?
     4948         ,input  0
     4949         ,input  false
     4950         ,output v-fact-order
     4951         ,output v-shift-end-fact-order
     4952         ,output v-day-end-fact-order
     4953         ) no-error .
     4954       if error-status :error
     4955       then do:
     4956         message
     4957           vss-workfile vss-revision vss-description skip
     4958           vss-include-info26 skip
     4959           "Ошибка при определении момента времени, на который требуется остаток" skip
     4960           "Объект" p-obj-type p-obj-code skip
     4961           "Артикул" p-artic p-prod-type p-prod-code skip
     4962           "Дата" p-fact-date skip
     4963           view-as alert-box error .
     4964         undo, return error .
     4965       end.
     4966       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     4967         (input p-obj-type
     4968         ,input p-obj-code
     4969         ,input p-artic
     4970         ,input p-prod-type
     4971         ,input p-prod-code
     4972         ,input v-day-end-fact-order
     4973         ,input false
     4974         ) no-error .
     4975       if error-status :error
     4976       then do:
     4977         message
     4978           vss-workfile vss-revision vss-description skip
     4979           vss-include-info26 skip
     4980           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     4981           "Объект" p-obj-type p-obj-code skip
     4982           "Артикул" p-artic p-prod-type p-prod-code skip
     4983           "Дата" p-fact-date skip
     4984           view-as alert-box error .
     4985         undo, return error .
     4986       end.
     4987     end.
     4988   end procedure.
     4989   procedure prdoclib-calc-temp-fact-sale :
     4990     define input  parameter p-obj-type           as character no-undo .
     4991     define input  parameter p-obj-code           as integer   no-undo .
     4992     define input  parameter p-gds-code           as integer   no-undo .
     4993     define input  parameter p-day-end-fact-order as decimal   no-undo .
     4994     define input  parameter p-curr-r-b           as character no-undo .
     4995     define output parameter p-fact-qnty          as decimal   no-undo .
     4996     define output parameter p-cur-base           as decimal   no-undo .
     4997     define output parameter p-cur-VAT-base       as decimal   no-undo .
     4998     define output parameter p-cur-SLT-base       as decimal   no-undo .
     4999     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     5000     define output parameter p-cur-excise-base    as decimal   no-undo .
     5001     define buffer buf_temp-prt-obj for temp-prt-obj .
     5002     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     5003     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     5004     define variable parrecid-prl        as recid     no-undo .
     5005     define variable v-fact-qnty         as decimal   no-undo .
     5006     define variable v-cur-base          as decimal   no-undo .
     5007     define variable v-cur-VAT-base      as decimal   no-undo .
     5008     define variable v-cur-SLT-base      as decimal   no-undo .
     5009     define variable v-cur-road-tax-base as decimal   no-undo .
     5010     define variable v-cur-excise-base   as decimal   no-undo .
     5011     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     5012     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     5013     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     5014     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     5015     define variable vat-base-sale-prl               as decimal   no-undo .
     5016     define variable vat-rubl-sale-prl               as decimal   no-undo .
     5017     define variable vat-base-buyer-prl              as decimal   no-undo .
     5018     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     5019     define variable slt-base-sale-prl               as decimal   no-undo .
     5020     define variable slt-rubl-sale-prl               as decimal   no-undo .
     5021     define variable road-tax-base-sale-prl          as decimal   no-undo .
     5022     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     5023     define variable excise-base-sale-prl            as decimal   no-undo .
     5024     define variable excise-rubl-sale-prl            as decimal   no-undo .
     5025     define variable discnt-base-sale-prl            as decimal   no-undo .
     5026     define variable discnt-rubl-sale-prl            as decimal   no-undo .
     5027     do
     5028     on error undo, return error return-value
     5029     :
     5030       for each buf_temp-prt-obj no-lock
     5031       on error undo, return error return-value
     5032       :
     5033   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5034     (input  p-gds-code
     5035     ,input  buf_temp-prt-obj.prt-code
     5036     ,output v-prt-b-code
     5037     ) no-error .
     5038         if error-status :error
     5039         then do:
     5040           message
     5041             vss-workfile vss-revision vss-description skip
     5042             "Ошибка при определении бар-кода признака" skip
     5043             "Код товара"   p-gds-code skip
     5044             "Код признака" buf_temp-prt-obj.prt-code skip
     5045             error-status :get-message(1) skip
     5046             return-value skip
     5047             view-as alert-box error .
     5048           undo, return error .
     5049         end.
     5050   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5051   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     5052     (input  p-obj-type
     5053     ,input  p-obj-code
     5054     ,input  v-prt-b-code
     5055     ,input  0
     5056     ,input  p-day-end-fact-order
     5057     ,output parrecid-prl
     5058     ,output v-cli-base-rate
     5059     ) no-error .
     5060         if error-status :error
     5061         then do:
     5062           message
     5063             vss-workfile vss-revision vss-description skip
     5064             "Ошибка при определении цены бар-кода" skip
     5065             "Объект" p-obj-type p-obj-code skip
     5066             "Бар-код" v-prt-b-code skip
     5067             "fact-order" p-day-end-fact-order skip
     5068             error-status :get-message(1) skip
     5069             return-value skip
     5070             view-as alert-box error .
     5071           undo, return error .
     5072         end.
     5073         if parrecid-prl <> ?
     5074         then do:
     5075           run prl-vat in this-procedure
     5076             (input  parrecid-prl
     5077             ,output price-rubl-with-tax-sale-prl
     5078             ,output price-base-with-tax-sale-prl
     5079             ,output price-rubl-without-tax-sale-prl
     5080             ,output price-base-without-tax-sale-prl
     5081             ,output vat-base-sale-prl
     5082             ,output vat-rubl-sale-prl
     5083             ,output vat-base-buyer-prl
     5084             ,output vat-rubl-buyer-prl
     5085             ,output slt-base-sale-prl
     5086             ,output slt-rubl-sale-prl
     5087             ,output road-tax-base-sale-prl
     5088             ,output road-tax-rubl-sale-prl
     5089             ,output excise-base-sale-prl
     5090             ,output excise-rubl-sale-prl
     5091             ,output discnt-base-sale-prl
     5092             ,output discnt-rubl-sale-prl
     5093             ) no-error .
     5094           if error-status :error
     5095           then do:
     5096             message
     5097               vss-workfile vss-revision vss-description skip
     5098               "Ошибка при вызове процеды prl-vat" skip
     5099               "Объект" p-obj-type p-obj-code skip
     5100               "Код товара" p-gds-code skip
     5101               "Указатель на запись переоценки" parrecid-prl skip
     5102               error-status :get-message(1) skip
     5103               return-value skip
     5104               view-as alert-box error .
     5105             undo, return error .
     5106           end.
     5107         end.
     5108         else do:
     5109           assign
     5110             price-rubl-with-tax-sale-prl    = 0
     5111             price-base-with-tax-sale-prl    = 0
     5112             price-rubl-without-tax-sale-prl = 0
     5113             price-base-without-tax-sale-prl = 0
     5114             vat-base-sale-prl               = 0
     5115             vat-rubl-sale-prl               = 0
     5116             slt-base-sale-prl               = 0
     5117             slt-rubl-sale-prl               = 0
     5118             road-tax-base-sale-prl          = 0
     5119             road-tax-rubl-sale-prl          = 0
     5120             excise-base-sale-prl            = 0
     5121             excise-rubl-sale-prl            = 0
     5122             discnt-base-sale-prl            = 0
     5123             discnt-rubl-sale-prl            = 0
     5124           .
     5125         end.
     5126         assign
     5127           v-fact-qnty         = v-fact-qnty
     5128                               + buf_temp-prt-obj.fact-qnty
     5129           v-cur-base          = v-cur-base
     5130                               + (if p-curr-r-b = 'base':U
     5131                                   then price-base-with-tax-sale-prl
     5132                                   else price-rubl-with-tax-sale-prl
     5133                                 )
     5134                               * buf_temp-prt-obj.fact-qnty
     5135           v-cur-VAT-base      = v-cur-VAT-base
     5136                               + (if p-curr-r-b = 'base':U
     5137                                   then vat-base-sale-prl
     5138                                   else vat-rubl-sale-prl
     5139                                 )
     5140                               * buf_temp-prt-obj.fact-qnty
     5141           v-cur-SLT-base      = v-cur-SLT-base
     5142                               + (if p-curr-r-b = 'base':U
     5143                                   then slt-base-sale-prl
     5144                                   else slt-rubl-sale-prl
     5145                                 )
     5146                               * buf_temp-prt-obj.fact-qnty
     5147           v-cur-road-tax-base = v-cur-road-tax-base
     5148                               + (if p-curr-r-b = 'base':U
     5149                                   then road-tax-base-sale-prl
     5150                                   else road-tax-rubl-sale-prl
     5151                                 )
     5152                               * buf_temp-prt-obj.fact-qnty
     5153           v-cur-excise-base   = v-cur-excise-base
     5154                               + (if p-curr-r-b = 'base':U
     5155                                   then excise-base-sale-prl
     5156                                   else excise-rubl-sale-prl
     5157                                 )
     5158                               * buf_temp-prt-obj.fact-qnty
     5159         .
     5160       end.
     5161       assign
     5162         p-fact-qnty         = v-fact-qnty
     5163         p-cur-base          = v-cur-base
     5164         p-cur-VAT-base      = v-cur-VAT-base
     5165         p-cur-SLT-base      = v-cur-SLT-base
     5166         p-cur-road-tax-base = v-cur-road-tax-base
     5167         p-cur-excise-base   = v-cur-excise-base
     5168       .
     5169     end.
     5170   end procedure.
     5171   procedure prdoclib-clear-temp-pl-gds :
     5172     define buffer buf_temp-pl-gds for temp-pl-gds .
     5173     do
     5174     on error undo, return error return-value
     5175     :
     5176       for each buf_temp-pl-gds
     5177       on error undo, return error return-value
     5178       :
     5179         delete buf_temp-pl-gds .
     5180       end.
     5181     end.
     5182   end procedure.
     5183   procedure prdoclib-init-temp-pl-gds :
     5184     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     5185     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     5186     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     5187     define buffer buf_pl-gds      for ub.pl-gds .
     5188     define buffer buf_temp-pl-gds for temp-pl-gds .
     5189     do
     5190     on error undo, return error return-value
     5191     :
     5192       run prdoclib-clear-temp-pl-gds in this-procedure .
     5193       for each buf_pl-gds
     5194         where buf_pl-gds.obj-type = p-obj-type
     5195           and buf_pl-gds.obj-code = p-obj-code
     5196           and buf_pl-gds.gds-code = p-gds-code
     5197       on error undo, return error return-value
     5198       :
     5199         create buf_temp-pl-gds .
     5200         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     5201       end.
     5202     end.
     5203   end procedure.
     5204   procedure prdoclib-init-pl-gds-by-factord :
     5205     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     5206     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     5207     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     5208     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     5209     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     5210     define input parameter p-fact-order         as decimal   no-undo .
     5211     define input parameter p-include-fact-order as logical   no-undo .
     5212     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     5213     define buffer buf_goods       for ub.goods .
     5214     define buffer buf_gds-obj     for ub.gds-obj .
     5215     define buffer buf_doc-line    for ub.doc-line .
     5216     define buffer buf_temp-pl-gds for temp-pl-gds .
     5217     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     5218     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     5219     do
     5220     on error undo, return error return-value
     5221     :
     5222       do transaction
     5223       on error undo, return error return-value
     5224       :
     5225   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5226   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     5227     (input  p-obj-type
     5228     ,input  p-obj-code
     5229     ,input  p-artic
     5230     ,input  p-prod-type
     5231     ,input  p-prod-code
     5232     ,buffer buf_gds-obj
     5233     ) no-error .
     5234         if error-status :error
     5235         then do:
     5236           message
     5237             vss-workfile vss-revision vss-description skip
     5238             vss-include-info26 skip
     5239             "Невозможно найти gds-obj" skip
     5240             error-status :get-message(1) skip
     5241             return-value skip
     5242             view-as alert-box error .
     5243           undo, return error return-value .
     5244         end.
     5245         find current buf_gds-obj exclusive-lock .
     5246       end.
     5247       find first buf_goods no-lock
     5248         where buf_goods.artic     = p-artic
     5249           and buf_goods.prod-type = p-prod-type
     5250           and buf_goods.prod-code = p-prod-code
     5251         .
     5252       run prdoclib-init-temp-pl-gds in this-procedure
     5253         (input p-obj-type
     5254         ,input p-obj-code
     5255         ,input buf_goods.gds-code
     5256         ) .
     5257       if p-include-fact-order = true
     5258       then do:
     5259         assign
     5260          p-fact-order = p-fact-order - 0.0000000001
     5261         .
     5262       end.
     5263       for each buf_doc-line no-lock
     5264         where buf_doc-line.obj-type   = p-obj-type
     5265           and buf_doc-line.obj-code   = p-obj-code
     5266           and buf_doc-line.artic      = p-artic
     5267           and buf_doc-line.prod-type  = p-prod-type
     5268           and buf_doc-line.prod-code  = p-prod-code
     5269           and buf_doc-line.status_    = 'факт':U
     5270           and buf_doc-line.fact-order >= p-fact-order
     5271       on error undo, return error return-value
     5272       :
     5273         run prdoclib-prc-pl-document in this-procedure
     5274           ( input  buf_doc-line.doc-code
     5275            ,input  p-obj-type
     5276            ,input  p-obj-code
     5277            ,input  buf_goods.gds-code
     5278            ,output v-total-pl-gds-qnty
     5279            ,output v-total-pl-gds-cli-qnty
     5280           ) .
     5281       end.
     5282     end.
     5283   end procedure.
     5284   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5285   procedure factord :
     5286     define input  parameter p-fact-date            as date    no-undo .
     5287     define input  parameter p-fact-time            as integer no-undo .
     5288     define input  parameter p-fact-num             as integer no-undo .
     5289     define input  parameter p-shift-date           as date    no-undo .
     5290     define input  parameter p-shift-num            as integer no-undo .
     5291     define input  parameter p-shift-on             as logical no-undo .
     5292     define output parameter p-fact-order           as decimal no-undo .
     5293     define output parameter p-shift-end-fact-order as decimal no-undo .
     5294     define output parameter p-day-end-fact-order   as decimal no-undo .
     5295     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     5296     if p-fact-date = ?
     5297     then do:
     5298       return error "Не указана фактическая дата" .
     5299     end.
     5300     define variable v-fact-date-num as integer no-undo .
     5301     assign
     5302       v-fact-date-num = integer(p-fact-date)
     5303     .
     5304     if p-fact-num = ?
     5305     or p-fact-num = 0
     5306     then do:
     5307       return error "Не задан p-fact-num " + string(p-fact-num) .
     5308     end.
     5309     if p-fact-num < 0
     5310     then do:
     5311       return error "Отрицательный fact-num " + string(p-fact-num) .
     5312     end.
     5313     if p-fact-num >= 100000000
     5314     then do:
     5315       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     5316     end.
     5317     if p-shift-on = true
     5318     then do:
     5319       if p-shift-date = ?
     5320       then do:
     5321         return error "Не задана дата смены" .
     5322       end.
     5323       if p-shift-num = ?
     5324       or p-shift-num = 0
     5325       then do:
     5326         return error "Не задан номер смены" .
     5327       end.
     5328     end.
     5329     else do:
     5330       assign
     5331         p-shift-date = p-fact-date
     5332         p-shift-num  = 24
     5333       .
     5334     end.
     5335     define variable v-shift-offset as integer no-undo .
     5336     if p-shift-date = p-fact-date
     5337     then do:
     5338       assign
     5339         v-shift-offset = 1
     5340       .
     5341     end.
     5342     if p-shift-date < p-fact-date
     5343     then do:
     5344       assign
     5345         v-shift-offset = 0
     5346       .
     5347     end.
     5348     if p-shift-date > p-fact-date
     5349     then do:
     5350       message
     5351         vss-workfile vss-revision vss-description skip
     5352         "Неправильная дата закрытия смены" skip
     5353         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     5354         view-as alert-box error .
     5355       undo, return error
     5356         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     5357           ,string(p-fact-date, '99/99/9999':U)
     5358           ,string(p-shift-date, '99/99/9999':U)
     5359           )
     5360       .
     5361     end.
     5362     if p-shift-num < 1
     5363     or p-shift-num > 24
     5364     then do:
     5365       message
     5366         vss-workfile vss-revision vss-description skip
     5367         "Неправильный номер смены" skip
     5368         "p-shift-num" p-shift-num skip
     5369         view-as alert-box error .
     5370       undo, return error return-value .
     5371     end.
     5372     assign
     5373       p-fact-order           = v-fact-date-num
     5374                              + v-shift-offset * 0.5
     5375                              + p-shift-num    * 0.02 - 0.01
     5376                              + p-fact-num     * 0.0000000001
     5377       p-shift-end-fact-order = v-fact-date-num
     5378                              + v-shift-offset * 0.5
     5379                              + p-shift-num    * 0.02
     5380       p-day-end-fact-order   = v-fact-date-num
     5381                              + 0.99
     5382     .
     5383     if p-fact-order           <= v-fact-date-num
     5384     or p-shift-end-fact-order <= v-fact-date-num
     5385     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     5386     or p-shift-end-fact-order >= p-day-end-fact-order
     5387     then do:
     5388       message
     5389         vss-workfile vss-revision vss-description skip
     5390         "Внутренняя ошибка при генерации фактического номера" skip
     5391         "p-fact-date"            p-fact-date            skip
     5392         "p-fact-time"            p-fact-time            skip
     5393         "p-fact-num"             p-fact-num             skip
     5394         "p-shift-date"           p-shift-date           skip
     5395         "p-shift-num"            p-shift-num            skip
     5396         "p-shift-on"             p-shift-on             skip
     5397         "p-shift-end-fact-order" p-shift-end-fact-order skip
     5398         "p-day-end-fact-order"   p-day-end-fact-order   skip
     5399         "v-fact-date-num"        v-fact-date-num        skip
     5400         view-as alert-box error .
     5401       undo, return error return-value .
     5402     end.
     5403   end procedure.
     5404   procedure day-begin-fact-order :
     5405     define input  parameter p-fact-date            as date    no-undo .
     5406     define output parameter p-day-begin-fact-order as decimal no-undo .
     5407     do
     5408     on error undo, return error return-value
     5409     :
     5410       if p-fact-date = ?
     5411       then do:
     5412         assign
     5413           p-day-begin-fact-order = 0
     5414         .
     5415       end.
     5416       else do:
     5417         assign
     5418           p-day-begin-fact-order = integer(p-fact-date)
     5419         .
     5420       end.
     5421     end.
     5422   end procedure.
     5423   procedure factord-max-fact-order :
     5424     define output parameter p-max-fact-order as decimal   no-undo .
     5425     do
     5426     on error undo, return error return-value
     5427     :
     5428       run day-begin-fact-order in this-procedure
     5429         (input  date(1, 1, 5000)
     5430         ,output p-max-fact-order
     5431         ) .
     5432     end.
     5433   end procedure.
     5434   procedure factord-cut-archive :
     5435     define input  parameter p-obj-type             as character no-undo .
     5436     define input  parameter p-obj-code             as integer   no-undo .
     5437     define input  parameter p-fact-date            as date      no-undo .
     5438     define output parameter p-shift-on             as logical   no-undo .
     5439     define output parameter p-shift-date           as date      no-undo .
     5440     define output parameter p-shift-num            as integer   no-undo .
     5441     define output parameter p-day-end-fact-order   as decimal   no-undo .
     5442     define output parameter p-shift-end-fact-order as decimal   no-undo .
     5443     define variable v-fact-order as decimal   no-undo .
     5444     define buffer buf_shift-obj for ub.shift-obj .
     5445     do
     5446     on error undo, return error return-value
     5447     :
     5448   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5449   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     5450     (input  p-obj-type
     5451     ,input  p-obj-code
     5452     ,input  'shift-on=request'
     5453     ,output p-shift-on
     5454     ) no-error .
     5455       if error-status :error
     5456       then do:
     5457         message
     5458           vss-workfile vss-revision vss-description skip
     5459           "Ошибка при определении атрибута объекта" skip
     5460           "Объект" p-obj-type p-obj-code skip
     5461           error-status :get-message(1) skip
     5462           return-value skip
     5463           view-as alert-box error .
     5464         undo, return error return-value .
     5465       end.
     5466       if p-shift-on = false
     5467       then do:
     5468         assign
     5469           p-shift-date               = ?
     5470           p-shift-num                = 0
     5471         .
     5472       end.
     5473       else do:
     5474         find first buf_shift-obj share-lock
     5475           where buf_shift-obj.obj-type   = p-obj-type
     5476             and buf_shift-obj.obj-code   = p-obj-code
     5477             and buf_shift-obj.shift-date > p-fact-date
     5478           use-index pi
     5479           no-error .
     5480         if not available buf_shift-obj
     5481         or buf_shift-obj.status_ <> 'зкр':U
     5482         then do:
     5483           message
     5484             vss-workfile vss-revision vss-description skip
     5485             "Невозможно вычислить последнюю смену" skip
     5486             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     5487             "Объект" p-obj-type p-obj-code skip
     5488             "Дата" p-fact-date skip
     5489             view-as alert-box error .
     5490           undo, return error return-value .
     5491         end.
     5492         find last buf_shift-obj share-lock
     5493           where buf_shift-obj.obj-type = p-obj-type
     5494             and buf_shift-obj.obj-code = p-obj-code
     5495             and buf_shift-obj.shift-date <= p-fact-date
     5496           use-index pi
     5497           no-error .
     5498         if available buf_shift-obj
     5499         then do:
     5500           if  buf_shift-obj.status_ = 'зкр':U
     5501           then do:
     5502             assign
     5503               p-shift-date = buf_shift-obj.shift-date
     5504               p-shift-num  = buf_shift-obj.shift-num
     5505             .
     5506           end.
     5507           else do:
     5508             message
     5509               vss-workfile vss-revision vss-description skip
     5510               "Невозможно вычислить последнюю смену" skip
     5511               "Статус смены отличен от статуса" 'зкр':U skip
     5512               "Объект" p-obj-type p-obj-code skip
     5513               "Дата" p-fact-date skip
     5514               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     5515               view-as alert-box error .
     5516             undo, return error return-value .
     5517           end.
     5518         end.
     5519         else do:
     5520           assign
     5521             p-shift-date = p-fact-date - 1
     5522             p-shift-num  = 1
     5523           .
     5524         end.
     5525       end.
     5526       run factord in this-procedure
     5527         (input  p-fact-date
     5528         ,input  1
     5529         ,input  1
     5530         ,input  p-shift-date
     5531         ,input  p-shift-num
     5532         ,input  p-shift-on
     5533         ,output v-fact-order
     5534         ,output p-shift-end-fact-order
     5535         ,output p-day-end-fact-order
     5536         ) no-error .
     5537       if error-status :error
     5538       then do:
     5539         message
     5540           vss-workfile vss-revision vss-description skip
     5541           "Ошибка при вызове процедуры factord"
     5542           error-status :get-message(1) skip
     5543           return-value skip
     5544           view-as alert-box error .
     5545         undo, return error return-value .
     5546       end.
     5547     end.
     5548   end procedure.
     5549   procedure factord-lock-shift :
     5550     define input  parameter p-obj-type  as character no-undo .
     5551     define input  parameter p-obj-code  as integer   no-undo .
     5552     define input  parameter p-fact-date as date      no-undo .
     5553     define parameter buffer buf_shift-obj for ub.shift-obj .
     5554     define variable v-shift-on      as logical   no-undo .
     5555     define variable v-extra-message as character no-undo .
     5556     define variable v-error as character no-undo .
     5557     do
     5558     on error undo, return error return-value
     5559     :
     5560   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5561   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     5562     (input  p-obj-type
     5563     ,input  p-obj-code
     5564     ,input  'shift-on=request'
     5565     ,output v-shift-on
     5566     ) no-error .
     5567       if error-status :error
     5568       then do:
     5569         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     5570         undo, return error v-error .
     5571       end.
     5572       if v-shift-on = true
     5573       then do:
     5574         find first buf_shift-obj share-lock
     5575           where buf_shift-obj.obj-type   = p-obj-type
     5576             and buf_shift-obj.obj-code   = p-obj-code
     5577             and buf_shift-obj.shift-date > p-fact-date
     5578           use-index pi
     5579           no-error .
     5580         if not available buf_shift-obj
     5581         or buf_shift-obj.status_ <> 'зкр':U
     5582         then do:
     5583           find last buf_shift-obj
     5584             where buf_shift-obj.obj-type = p-obj-type
     5585               and buf_shift-obj.obj-code = p-obj-code
     5586               and buf_shift-obj.status_  = 'зкр':U
     5587             use-index stts
     5588             no-error .
     5589           if available buf_shift-obj
     5590           then do:
     5591             assign
     5592               v-extra-message =
     5593                     substitute("Дата начала последеней закрытой смены на объекте &1"
     5594                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     5595                               )
     5596             .
     5597           end.
     5598           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     5599           undo, return error v-error .
     5600         end.
     5601       end.
     5602     end.
     5603   end procedure.
     5604   procedure factord-end-day :
     5605     define input  parameter p-fact-date            as date    no-undo .
     5606     define output parameter p-day-end-fact-order   as decimal no-undo .
     5607     do
     5608     on error undo, return error return-value
     5609     :
     5610       if p-fact-date = ?
     5611       then do:
     5612         return error "Не указана фактическая дата" .
     5613       end.
     5614       assign
     5615         p-day-end-fact-order = integer(p-fact-date) + 0.99
     5616       .
     5617     end.
     5618   end procedure.
     5619   procedure factord-to-date :
     5620     define input  parameter p-fact-order as decimal no-undo .
     5621     define output parameter p-fact-date  as date    no-undo .
     5622     define variable v-ref-date  as date      no-undo .
     5623     define variable v-ref-delta as integer   no-undo .
     5624     do
     5625     on error undo, return error return-value
     5626     :
     5627       if p-fact-order = ?
     5628       or p-fact-order = 0
     5629       then do:
     5630         return error "Не указан fact-order" .
     5631       end.
     5632       assign
     5633         v-ref-date  = date(1, 1, 2000)
     5634       .
     5635       assign
     5636         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     5637       .
     5638       assign
     5639         p-fact-date = v-ref-date + v-ref-delta
     5640       .
     5641     end.
     5642   end procedure.
     5643   procedure factord-to-fact-num :
     5644     define input  parameter p-fact-order as decimal no-undo .
     5645     define output parameter p-fact-num   as integer no-undo .
     5646     define variable v-fact-order-trunc as decimal no-undo .
     5647     do
     5648     on error undo, return error return-value
     5649     :
     5650       if p-fact-order = ?
     5651       or p-fact-order = 0
     5652       then do:
     5653         return error "Не указан fact-order" .
     5654       end.
     5655       assign
     5656        v-fact-order-trunc = truncate(p-fact-order, 2)
     5657       .
     5658       assign
     5659         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     5660       .
     5661     end.
     5662   end procedure.
     5663   procedure factord-to-shift-num :
     5664     define input  parameter p-fact-order as decimal no-undo .
     5665     define output parameter p-shift-num   as integer no-undo .
     5666     define variable  p-shift-numd  as decimal   no-undo .
     5667     define variable v-fact-order-trunc as decimal no-undo .
     5668     do
     5669     on error undo, return error return-value
     5670     :
     5671       if p-fact-order = ?
     5672       or p-fact-order = 0
     5673       then do:
     5674         return error "Не указан fact-order" .
     5675       end.
     5676       assign
     5677        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     5678       .
     5679       if v-fact-order-trunc < 0.5 then do:
     5680         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     5681       end.
     5682       assign
     5683         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     5684         .
     5685        assign
     5686         p-shift-num = truncate (p-shift-numd , 0)
     5687       .
     5688     end.
     5689   end procedure.
     5690     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
     5691       define variable v-answ as logical no-undo .
     5692       if ( p-unit-base-cli-eq = true
     5693            and p-density = 1.0
     5694          )
     5695         or ( p-unit-base-cli-eq = false
     5696              and p-density <> ?
     5697              and p-density > 0.0
     5698              and p-density < 1.0
     5699            )
     5700       then do:
     5701         assign
     5702           v-answ = true
     5703         .
     5704       end.
     5705       else do:
     5706         assign
     5707           v-answ = false
     5708         .
     5709       end.
     5710       return v-answ.
     5711     end function.
     5712   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5713   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5714   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     5715   define variable par-type          as character no-undo.
     5716   define variable v-value-character as character no-undo .
     5717   define variable v-value-date      as date      no-undo .
     5718   define variable v-value-decimal   as decimal   no-undo .
     5719   define variable v-value-integer   as integer   no-undo .
     5720   define variable v-value-logical   as logical   no-undo .
     5721   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5722   procedure cur-time :
     5723      define output parameter p-today as date      no-undo .
     5724      define output parameter p-time  as integer   no-undo .
     5725     do
     5726     on error undo, return error
     5727     :
     5728       define variable v-date1 as date      no-undo .
     5729       define variable v-date2 as date      no-undo .
     5730       define variable v-time  as integer   no-undo .
     5731       assign
     5732         v-date1 = today
     5733         v-time  = time
     5734         v-date2 = today
     5735       .
     5736       if v-date1 <> v-date2
     5737       then do:
     5738         assign
     5739           v-date1 = today
     5740           v-time  = v-time
     5741         .
     5742       end.
     5743       assign
     5744         p-today = v-date1
     5745         p-time  = v-time
     5746       .
     5747     end.
     5748   end.
     5749   function cur-time-date returns character
     5750   :
     5751     return string(today, '99/99/9999':U) .
     5752   end.
     5753   function cur-time-mjd returns decimal
     5754   :
     5755     define variable v-date as date      no-undo .
     5756     define variable v-time as integer   no-undo .
     5757     run cur-time in this-procedure
     5758       (output v-date
     5759       ,output v-time
     5760       ) .
     5761     return integer(v-date) - 2400002 + (v-time / 86400) .
     5762   end.
     5763   function cur-time-get-ending-index returns integer
     5764   (input p-number as integer
     5765   )
     5766   :
     5767     if p-number < 0
     5768     or p-number = ?
     5769     then do:
     5770       return 1 .
     5771     end.
     5772     define variable v-rest as integer   no-undo .
     5773     assign
     5774       p-number = p-number modulo 100
     5775     .
     5776     if p-number < 20
     5777     then do:
     5778       assign
     5779         v-rest = p-number
     5780       .
     5781     end.
     5782     else do:
     5783       assign
     5784         v-rest = p-number modulo 10
     5785       .
     5786     end.
     5787     case v-rest :
     5788       when 1
     5789       then do:
     5790         return 2 .
     5791       end.
     5792       when 2 or
     5793       when 3 or
     5794       when 4
     5795       then do:
     5796         return 3 .
     5797       end.
     5798       otherwise do:
     5799         return 1 .
     5800       end.
     5801     end case .
     5802   end.
     5803   procedure cur-time-mjd-to-date :
     5804      define input  parameter i-mjd-diff as decimal no-undo.
     5805      define output parameter o-Date     as date    no-undo.
     5806      define output parameter o-Time     as integer no-undo.
     5807      define variable v-day-number as integer   no-undo .
     5808      if    i-mjd-diff < 0
     5809         or i-mjd-diff = ?
     5810      then do:
     5811         return "?" .
     5812      end.
     5813      assign
     5814         v-day-number = truncate(i-mjd-diff,0).
     5815         o-Date = date(v-day-number + 2400002).
     5816         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     5817     .
     5818   end.
     5819   function cur-time-mjd-to-string returns character
     5820   (input p-mjd-diff as decimal
     5821   )
     5822   :
     5823     define variable v-day-number as integer   no-undo .
     5824     define variable v-seconds    as integer   no-undo .
     5825     define variable v-hour       as integer   no-undo .
     5826     define variable v-min        as integer   no-undo .
     5827     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     5828     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     5829     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     5830     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     5831     if p-mjd-diff < 0
     5832     or p-mjd-diff = ?
     5833     then do:
     5834       return "?" .
     5835     end.
     5836     assign
     5837       v-day-number = integer(truncate(p-mjd-diff,0))
     5838       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     5839     .
     5840     if v-seconds > 86400
     5841     then do:
     5842       assign
     5843         v-seconds = 86400 - 1
     5844       .
     5845     end.
     5846     if v-seconds < 0
     5847     then do:
     5848       assign
     5849         v-seconds = 0
     5850       .
     5851     end.
     5852     assign
     5853       v-hour = truncate(v-seconds / 3600, 0)
     5854     .
     5855     assign
     5856       v-seconds = v-seconds modulo 3600
     5857     .
     5858     assign
     5859       v-min = truncate(v-seconds / 60, 0)
     5860     .
     5861     assign
     5862       v-seconds = v-seconds modulo 60
     5863     .
     5864     return
     5865         (if v-day-number <> 0
     5866           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     5867           else ""
     5868         )
     5869       + (if v-day-number <> 0 or v-hour <> 0
     5870           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     5871           else ""
     5872         )
     5873       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     5874           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     5875           else ""
     5876         )
     5877       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     5878       .
     5879   end.
     5880   function cur-time-string returns character
     5881   :
     5882     define variable v-date as date      no-undo .
     5883     define variable v-time as integer   no-undo .
     5884     run cur-time in this-procedure
     5885       (output v-date
     5886       ,output v-time
     5887       ) .
     5888     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     5889   end.
     5890   function cur-time-string-sec returns character
     5891   :
     5892     define variable v-date as date      no-undo .
     5893     define variable v-time as integer   no-undo .
     5894     run cur-time in this-procedure
     5895       (output v-date
     5896       ,output v-time
     5897       ) .
     5898     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     5899   end.
     5900   function cur-time-custom  returns character
     5901   (input p-prefix as character
     5902   ,input p-date-format as character
     5903   ,input p-delimiter as character
     5904   ,input p-time-format as character
     5905   ,input p-suffix as character
     5906   )
     5907   :
     5908     define variable v-date as date      no-undo .
     5909     define variable v-time as integer   no-undo .
     5910     run cur-time in this-procedure
     5911       (output v-date
     5912       ,output v-time
     5913       ) .
     5914     return
     5915       p-prefix
     5916       + string(v-date, p-date-format)
     5917       + p-delimiter
     5918       + string(v-time, p-time-format)
     5919       + p-suffix
     5920       .
     5921   end.
     5922   function cur-time-print  returns character
     5923   :
     5924     define variable v-date as date      no-undo .
     5925     define variable v-time as integer   no-undo .
     5926     run cur-time in this-procedure
     5927       (output v-date
     5928       ,output v-time
     5929       ) .
     5930     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     5931   end.
     5932   function cur-time-datetime returns datetime
     5933   :
     5934     define variable v-char as character no-undo .
     5935     define variable v-datetime as datetime no-undo .
     5936     v-char = cur-time-string().
     5937     v-datetime = datetime(v-char).
     5938     return  v-datetime.
     5939   end.
     5940   function cur-time-string-msec returns character
     5941   :
     5942     define variable v-date as datetime  no-undo .
     5943     v-date = now.
     5944     return string(v-date) .
     5945   end.
     5946   procedure placelib_write-attr:
     5947   define input  parameter p-code     like ub.place-attr.attr-code .
     5948   define input  parameter p-obj-code like ub.place-attr.obj-code .
     5949   define input  parameter p-obj-type like ub.place-attr.obj-type .
     5950   define input  parameter p-pl-code  like ub.place-attr.pl-code .
     5951   define input  parameter p-value    like ub.place-attr.attr-value .
     5952   define output parameter p-ok       as logical.
     5953   define buffer buf_place-attr for ub.place-attr .
     5954     do on error undo, return error return-value :
     5955        p-ok = false.
     5956        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     5957                                                   and buf_place-attr.obj-code    = p-obj-code
     5958                                                   and buf_place-attr.obj-type    = p-obj-type
     5959                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     5960        if not available buf_place-attr then do :
     5961           create buf_place-attr.
     5962           assign
     5963             buf_place-attr.attr-code   = p-code
     5964             buf_place-attr.attr-value  = p-value
     5965             buf_place-attr.obj-code    = p-obj-code
     5966             buf_place-attr.obj-type    = p-obj-type
     5967             buf_place-attr.pl-code     = p-pl-code
     5968           .
     5969           p-ok = true.
     5970        end.
     5971        else do:
     5972           buf_place-attr.attr-value  = p-value .
     5973           p-ok = true.
     5974        end.
     5975     end.
     5976   end.
     5977   procedure placelib_get-attr:
     5978   define input  parameter  p-code     like ub.place-attr.attr-code .
     5979   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     5980   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     5981   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     5982   define output parameter  p-value    like ub.place-attr.attr-value .
     5983   define output parameter  p-ok       as logical.
     5984   define buffer buf_place-attr for ub.place-attr .
     5985     do on error undo, return error return-value :
     5986        p-ok = false.
     5987        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     5988                                                   and buf_place-attr.obj-code    = p-obj-code
     5989                                                   and buf_place-attr.obj-type    = p-obj-type
     5990                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     5991        if available buf_place-attr then do :
     5992          p-value = buf_place-attr.attr-value.
     5993          p-ok = true.
     5994        end.
     5995        else do :
     5996          p-ok = false.
     5997        end.
     5998     end.
     5999   end.
     6000   procedure placelib_del-attr:
     6001   define input parameter  p-code     like ub.place-attr.attr-code .
     6002   define input parameter  p-obj-code like ub.place-attr.obj-code .
     6003   define input parameter  p-obj-type like ub.place-attr.obj-type .
     6004   define input parameter  p-pl-code  like ub.place-attr.pl-code .
     6005   define input parameter  p-value    like ub.place-attr.attr-value .
     6006   define output parameter p-ok       as logical.
     6007   define buffer buf_place-attr for ub.place-attr .
     6008     do on error undo, return error return-value :
     6009        p-ok = false.
     6010        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     6011                                                   and buf_place-attr.obj-code    = p-obj-code
     6012                                                   and buf_place-attr.obj-type    = p-obj-type
     6013                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     6014        if available buf_place-attr then do :
     6015           delete buf_place-attr.
     6016           p-ok = true.
     6017        end.
     6018     end.
     6019   end.
     6020   function is-sug returns logical
     6021           (input p-gds-code as integer):
     6022   define variable result as logical no-undo.
     6023   define variable c-value as character no-undo.
     6024   define variable c-type as character no-undo.
     6025   do on error undo, return error:
     6026           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     6027         (input  p-gds-code
     6028         ,input  'fuel-type':U
     6029         ,output c-value
     6030         ,output c-type) no-error.
     6031   end.
     6032   result = logical(c-value = 'lgas':U) no-error.
     6033   return result.
     6034   end function.
     6035   define variable lns-cnt  as integer no-undo.
     6036   define variable line-rec as recid   no-undo.
     6037   if valid-handle (g#lib-trn2)
     6038   and g#lib-trn2 <> this-procedure :handle
     6039   and g#lib-trn2 :get-signature('lib-trn2_crinvdoc':u) <> ""
     6040   then do:
     6041     message
     6042       vss-workfile vss-revision vss-description skip
     6043       "Попытка повторной загрузки библиотеки для работы с документами" skip
     6044       g#lib-trn2 skip
     6045       g#lib-trn2 :type skip
     6046       g#lib-trn2 :file-name skip
     6047       valid-handle(g#lib-trn2) skip
     6048       this-procedure :handle skip
     6049       this-procedure :type skip
     6050       this-procedure :file-name skip
     6051       valid-handle(this-procedure) skip
     6052       view-as alert-box error .
     6053     undo, return error .
     6054   end.
     6055   else do:
     6056     assign
     6057       g#lib-trn2 = this-procedure :handle
     6058     .
     6059     def var gbl-hndllibObj as class gbl-hndllib no-undo.
     6060     gbl-hndllibObj = new gbl-hndllib ().
     6061     gbl-hndllibObj:InitHndl("g#lib-trn2", g#lib-trn2).
     6062     delete object gbl-hndllibObj.
     6063   end.
     6064   on delete of this-procedure do:
     6065     assign
     6066       g#lib-trn2 = ?
     6067     .
     6068     def var gbl-hndllibObj as class gbl-hndllib no-undo.
     6069     gbl-hndllibObj = new gbl-hndllib ().
     6070     gbl-hndllibObj:InitHndl("g#lib-trn2", g#lib-trn2).
     6071     delete object gbl-hndllibObj.
     6072   end.
     6073   define stream str-err.
     6074   procedure lib-trn2_crinvdoc :
     6075   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
     6076   define buffer cr_trn-doc for ub.trn-doc.
     6077   define variable varwastagevalue as character no-undo.
     6078   define variable varwastagetype  as character no-undo.
     6079   define variable varinvclcwt     as character no-undo.
     6080   define variable varinvclcwttype as character no-undo.
     6081   define variable varinvclcas     as character no-undo.
     6082   define variable varinvclcastype as character no-undo.
     6083   do on error undo, return error return-value :
     6084   find first cr_trn-doc where cr_trn-doc.doc-code = pardoc-code no-lock.
     6085   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6086   empty temp-table thbjattr_thbj-attr.
     6087   run adm/shattri.p (
     6088      input "get":U
     6089     ,input ''
     6090     ,input 0
     6091     ,input 'inv-global':U
     6092     ,input  ""
     6093     ,output v-value-character
     6094     ,output v-value-date
     6095     ,output v-value-decimal
     6096     ,output v-value-integer
     6097     ,output v-value-logical
     6098     ,output par-type
     6099     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     6100     ) no-error .
     6101   for each thbjattr_thbj-attr :
     6102       if thbjattr_thbj-attr.prop-code = 'invclcas'  then varinvclcas = string( thbjattr_thbj-attr.property-value-logical, "yes/no").
     6103       if thbjattr_thbj-attr.prop-code = 'invclcwt'  then varinvclcwt = string( thbjattr_thbj-attr.property-value-logical, "yes/no").
     6104   end.
     6105   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6106   empty temp-table thbjattr_thbj-attr.
     6107   run adm/shattri.p (
     6108      input "get":U
     6109     ,input cr_trn-doc.obj-type
     6110     ,input cr_trn-doc.obj-code
     6111     ,input 'inv-obj':U
     6112     ,input  ""
     6113     ,output v-value-character
     6114     ,output v-value-date
     6115     ,output v-value-decimal
     6116     ,output v-value-integer
     6117     ,output v-value-logical
     6118     ,output par-type
     6119     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     6120     ) no-error .
     6121   for each thbjattr_thbj-attr :
     6122       if thbjattr_thbj-attr.prop-code = 'wastage'  then varwastagevalue = string( thbjattr_thbj-attr.property-value-logical, "yes/no").
     6123   end.
     6124   empty temp-table thbjattr_thbj-attr.
     6125   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input cr_trn-doc.doc-code ,
     6126                          input 'othermoves':U ,
     6127                          input yes ) no-error .
     6128   if error-status :error then do:
     6129     return error substitute( "Ошибка при вызове процедуры tdat-wrt &1 &2"
     6130                            , return-value
     6131                            , error-status :get-message( 1 ) ).
     6132   end.
     6133   if varwastagevalue = "yes" and
     6134      varinvclcwt     = "yes" then do:
     6135   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input cr_trn-doc.doc-code ,
     6136                          input 'clcaswt':U ,
     6137                          input yes ) no-error .
     6138      if error-status :error then do:
     6139        return error substitute( "Ошибка при вызове процедуры tdat-wrt &1 &2"
     6140                               , return-value
     6141                               , error-status :get-message( 1 ) ).
     6142      end.
     6143   end.
     6144   else do:
     6145   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input cr_trn-doc.doc-code ,
     6146                          input 'clcaswt':U ,
     6147                          input no ) no-error .
     6148      if error-status :error then do:
     6149        return error substitute( "Ошибка при вызове процедуры tdat-wrt &1 &2"
     6150                               , return-value
     6151                               , error-status :get-message( 1 ) ).
     6152      end.
     6153   end.
     6154   if varinvclcas = "yes" then do:
     6155   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input cr_trn-doc.doc-code ,
     6156                          input 'clcasol':U ,
     6157                          input yes ) no-error .
     6158      if error-status :error then do:
     6159        return error substitute( "Ошибка при вызове процедуры tdat-wrt &1 &2"
     6160                               , return-value
     6161                               , error-status :get-message( 1 ) ).
     6162      end.
     6163   end.
     6164   else do:
     6165   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input cr_trn-doc.doc-code ,
     6166                          input 'clcasol':U ,
     6167                          input no ) no-error .
     6168      if error-status :error then do:
     6169        return error substitute( "Ошибка при вызове процедуры tdat-wrt &1 &2"
     6170                               , return-value
     6171                               , error-status :get-message( 1 ) ).
     6172      end.
     6173   end.
     6174   end.
     6175   end procedure.
     6176   procedure lib-trn2_reclctsl :
     6177   define input parameter pardoc-code like ub.trn-doc.doc-code     no-undo.
     6178   define input parameter parsum-type like ub.trn-doc-sum.sum-type no-undo.
     6179   define buffer bf_trn-doc-sum         for ub.trn-doc-sum.
     6180   define buffer bf-ext_trn-doc-sum     for ub.trn-doc-sum.
     6181   define buffer bf-mis_trn-doc-sum     for ub.trn-doc-sum.
     6182   define buffer bf-ext-cli_trn-doc-sum for ub.trn-doc-sum.
     6183   define buffer bf-mis-cli_trn-doc-sum for ub.trn-doc-sum.
     6184   define buffer bf_doc-line-sum        for ub.doc-line-sum.
     6185   define variable vartime as integer no-undo.
     6186   do on error undo, return error return-value :
     6187   assign
     6188     vartime = time.
     6189   find first bf_trn-doc-sum where bf_trn-doc-sum.doc-code = pardoc-code and
     6190                                   bf_trn-doc-sum.sum-type = parsum-type no-error.
     6191   if error-status :error then do:
     6192     return error substitute( "Не найдена запись дополнительных сумм по документу &1. Тип суммы &2."
     6193                            , pardoc-code
     6194                            , parsum-type ).
     6195   end.
     6196   if valid-handle( g#lib-rwds ) <> yes then do:       run str/lib-rwds.p persistent no-error.       if error-status :error or valid-handle( g#lib-rwds ) <> yes then do:         message "Error starting lib-rwds.p" skip( 0 )           g#lib-rwds                        skip( 0 )           g#lib-rwds   :type                skip( 0 )           g#lib-rwds   :file-name           skip( 0 )           error-status :get-message( 1 )    skip( 0 )           return-value                      skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rwds_cltrnsum in g#lib-rwds ( input pardoc-code ,
     6197                          input parsum-type ) no-error .
     6198   if error-status :error then do:
     6199     return error substitute( "Ошибка при вызове процедуры lib-rwds_cltrnsum для документа &1. Тип суммы &2."
     6200                            , pardoc-code
     6201                            , parsum-type ).
     6202   end.
     6203   if parsum-type = 'gen':U then do:
     6204     find first bf-ext_trn-doc-sum where bf-ext_trn-doc-sum.doc-code = pardoc-code      and
     6205                                         bf-ext_trn-doc-sum.sum-type = 'ext':U no-error.
     6206     if error-status :error then do:
     6207       return error substitute( "Не найдена запись дополнительных сумм по документу &1. Тип суммы &2."
     6208                              , pardoc-code
     6209                              , parsum-type ).
     6210     end.
     6211   if valid-handle( g#lib-rwds ) <> yes then do:       run str/lib-rwds.p persistent no-error.       if error-status :error or valid-handle( g#lib-rwds ) <> yes then do:         message "Error starting lib-rwds.p" skip( 0 )           g#lib-rwds                        skip( 0 )           g#lib-rwds   :type                skip( 0 )           g#lib-rwds   :file-name           skip( 0 )           error-status :get-message( 1 )    skip( 0 )           return-value                      skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rwds_cltrnsum in g#lib-rwds ( input pardoc-code ,
     6212                          input 'ext':U ) no-error .
     6213     if error-status :error then do:
     6214       return error substitute( "Ошибка при вызове процедуры lib-rwds_cltrnsum для документа &1. Тип суммы &2."
     6215                              , pardoc-code
     6216                              , parsum-type ).
     6217     end.
     6218     find first bf-mis_trn-doc-sum where bf-mis_trn-doc-sum.doc-code = pardoc-code      and
     6219                                         bf-mis_trn-doc-sum.sum-type = 'mis':U no-error.
     6220     if error-status :error then do:
     6221       return error substitute( "Не найдена запись дополнительных сумм по документу &1. Тип суммы &2."
