     2737                 varprice-sale = 0
     2738                 varroad-tax   = 0
     2739                 varexcise     = 0
     2740               .
     2741             end.
     2742             assign
     2743               varlastcur-base     = varprice-sale
     2744               varlastcur-road-tax = varroad-tax
     2745               varlastcur-excise   = varexcise
     2746               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     2747               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     2748               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     2749               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     2750             .
     2751         end.
     2752       end.
     2753       if varcur-fact-qnty = 0 then do:
     2754         assign
     2755           varcur-base      = varlastcur-base
     2756           varcur-road-tax  = varlastcur-road-tax
     2757           varcur-excise    = varlastcur-excise
     2758         .
     2759       end.
     2760       else do:
     2761         assign
     2762           varcur-base      = varcur-base      / varcur-fact-qnty
     2763           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     2764           varcur-excise    = varcur-excise    / varcur-fact-qnty
     2765         .
     2766       end.
     2767       if varcur-vat-pc = ?
     2768       then do:
     2769         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2770       end.
