     3983           buf_temp-prt-obj.prt-code         = p-prt-code
     3984           buf_temp-prt-obj.price-sale       = ?
     3985           buf_temp-prt-obj.fact-qnty        = 0
     3986           buf_temp-prt-obj.price-list-qnty  = ?
     3987           buf_temp-prt-obj.prt-obj-recid    = ?
     3988           buf_temp-prt-obj.price-list-recid = ?
     3989         .
     3990         find first buf_gds-prt no-lock
     3991           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     3992           .
     3993         assign
     3994           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     3995         .
     3996         if buf_temp-prt-obj.is-term
     3997         then do:
     3998           assign
     3999             buf_temp-prt-obj.price-sale = 0
     4000           .
     4001         end.
     4002       end.
