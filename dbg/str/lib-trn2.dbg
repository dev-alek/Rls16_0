     3920   procedure prdoclib-clear-temp-prt-obj :
     3921     define buffer buf_temp-prt-obj for temp-prt-obj .
     3922     do
     3923     on error undo, return error return-value
     3924     :
     3925       for each buf_temp-prt-obj
     3926       on error undo, return error return-value
     3927       :
     3928         delete buf_temp-prt-obj .
     3929       end.
     3930     end.
     3931   end procedure.
     3932   procedure prdoclib-create-temp-prt-obj :
     3933     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
     3934     define parameter buffer buf_prt-obj       for ub.prt-obj .
     3935     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     3936     define buffer buf_gds-prt for ub.gds-prt .
     3937     do
     3938     on error undo, return error return-value
     3939     :
     3940       find first buf_temp-prt-obj
     3941         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
     3942         no-error .
     3943       if not available buf_temp-prt-obj
     3944       then do:
     3945         create buf_temp-prt-obj .
     3946         assign
     3947           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
     3948           buf_temp-prt-obj.price-sale       = ?
     3949           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
     3950           buf_temp-prt-obj.price-list-qnty  = ?
     3951           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
     3952           buf_temp-prt-obj.price-list-recid = ?
     3953         .
     3954         find first buf_gds-prt no-lock
     3955           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     3956           .
     3957         assign
     3958           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     3959         .
     3960         if buf_temp-prt-obj.is-term
     3961         then do:
     3962           assign
     3963             buf_temp-prt-obj.price-sale = p-root-price-sale
     3964           .
     3965         end.
     3966       end.
     3967     end.
     3968   end procedure.
