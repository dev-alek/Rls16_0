     3061   procedure gdsoattr-name :
     3062     define input  parameter p-code           as character no-undo .
     3063     define output parameter p-type           as character no-undo .
     3064     define output parameter p-format         as character no-undo .
     3065     define output parameter p-label          as character no-undo .
     3066     define output parameter p-user-can-edit  as logical   no-undo .
     3067     define output parameter p-output-display as logical   no-undo .
     3068     define output parameter p-other          as character no-undo .
     3069     do
     3070     on error undo, return error
     3071     :
     3072           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsoattr-name in g#attr-lib
     3073         (input  p-code
     3074         ,output p-type
     3075         ,output p-format
     3076         ,output p-label
     3077         ,output p-user-can-edit
