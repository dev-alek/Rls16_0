     8914   procedure lib-trn2_chkprdtl :
     8915   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
     8916   define buffer bf_trn-doc for ub.trn-doc.
     8917   define buffer bf_gds-dtl for ub.gds-dtl.
     8918   define buffer bf_goods   for ub.goods  .
     8919   define variable varmax-disc-str              as   character                   no-undo.
     8920   define variable varmax-disc                  as   decimal                     no-undo.
     8921   define variable vartype                      as   character                   no-undo.
     8922   define variable varr-b                       as   character                   no-undo.
     8923   define variable v-is-mdificator-null-price   as   character                   no-undo.
     8924   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8925   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
     8926   define variable gp-price-sale like ub.price-list.price-sale no-undo.
     8927   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
     8928   define variable gp-excise     like ub.price-list.excise     no-undo.
     8929   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
     8930   define variable gp-fact-order as decimal   no-undo .
     8931   define variable gp-price-sale-parts as decimal   no-undo .
     8932   do on error undo, return error return-value :
     8933   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     8934   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     8935     (output varr-b
     8936     )  .
     8937   find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code no-lock.
     8938   for each bf_gds-dtl where bf_gds-dtl.doc-code  = pardoc-code on error undo, return error return-value :
     8939     find first bf_goods where bf_goods.artic     = bf_gds-dtl.artic     and
     8940                               bf_goods.prod-type = bf_gds-dtl.prod-type and
     8941                               bf_goods.prod-code = bf_gds-dtl.prod-code no-lock.
     8942     if bf_trn-doc.ext-doc-type = 'ee':U then do:
     8943       define variable v-limit as decimal no-undo .
     8944       define buffer buf_dis-gds-rule for ub.dis-gds-rule.
     8945       define buffer buf_dis-rule for ub.dis-rule.
     8946       _buf_dis-gds-rule:
     8947       for each buf_dis-gds-rule no-lock where
     8948                 buf_dis-gds-rule.gds-code = bf_goods.gds-code
     8949            and  buf_dis-gds-rule.obj-type = bf_gds-dtl.obj-type
     8950            and  buf_dis-gds-rule.obj-code = bf_gds-dtl.obj-code
     8951            and  buf_dis-gds-rule.pos-type = '-':U
     8952            and  buf_dis-gds-rule.discnt-role = 'max-disc':U,
     8953           first buf_dis-rule no-lock where
     8954                 buf_dis-rule.rule-num = buf_dis-gds-rule.rule-num
     8955             and buf_dis-rule.sts = integer('0':U):
     8956         leave _buf_dis-gds-rule.
     8957       end.
     8958       if available buf_dis-gds-rule then do:
     8959   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8960   gp-fact-order = 0 .
     8961   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     8962     (input  bf_goods.gds-code
     8963     ,input  bf_gds-dtl.prt-code
     8964     ,output gp-b-code
     8965     ) no-error .
     8966   if error-status:error then do:
     8967     message
     8968       error-status :get-message(1) skip
     8969       return-value skip
     8970       view-as alert-box error .
     8971     return error.
     8972   end.
     8973   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8974   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     8975     (input  bf_gds-dtl.obj-type
     8976     ,input  bf_gds-dtl.obj-code
     8977     ,input  gp-b-code
     8978     ,input  0
     8979     ,input  gp-fact-order
     8980     ,output gp-doc-num
     8981     ,output gp-price-sale
     8982     ,output gp-road-tax
     8983     ,output gp-excise
     8984     ) no-error .
     8985   if error-status:error then do:
     8986     return error.
     8987   end.
     8988   gp-price-sale-parts = gp-price-sale.
     8989   define variable vss-include-info63 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8990   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_avprpart in g#lib-trn3
     8991     (input  bf_gds-dtl.obj-type
     8992     ,input  bf_gds-dtl.obj-code
     8993     ,input  gp-b-code
     8994     ,input  0
     8995     ,input  gp-fact-order
     8996     ,output gp-doc-num
     8997     ,output gp-price-sale-parts
     8998     ,output gp-road-tax
     8999     ,output gp-excise
     9000     ) no-error .
     9001   if error-status:error then do:
     9002     return error.
     9003   end.
     9004   if gp-price-sale-parts <> 0 and gp-price-sale-parts <> ? then do:
     9005       gp-price-sale = gp-price-sale-parts.
     9006    end.
     9007         if gp-price-sale <> ? then do:
     9008           if buf_Dis-rule.value-type = integer('1':U) then do:
     9009             v-limit = gp-price-sale * ( 1 - buf_Dis-rule.discnt-value * 0.01 ).
     9010             varmax-disc-str = substitute("&1%", buf_Dis-rule.discnt-value).
     9011           end.
     9012           if buf_Dis-rule.value-type = integer('2':U) then do:
     9013             v-limit = gp-price-sale - varmax-disc.
     9014             varmax-disc-str = substitute("&1 (&2)"
     9015                                         , buf_Dis-rule.discnt-value
     9016                                         , if varr-b = "rubl":u
     9017                                           then "нац.вал."
     9018                                           else "баз.вал."
     9019                                         ).
     9020           end.
     9021           if varr-b = "rubl":u then do:
     9022             if bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl < v-limit then do:
     9023               return error substitute( "Текущая цена по товару &1 &2 &3 &4 равна &5. Максимальная скидка при продаже через расходную накладную &6. Цена в документе &7, равная &8, меньше минимальной цены с максимальной скидкой, равной &9. (gds-dtl)",
     9024                                        bf_goods.artic,
     9025                                        bf_goods.prod-type,
     9026                                        bf_goods.prod-code,
     9027                                        bf_goods.gds-name,
     9028                                        gp-price-sale,
     9029                                        varmax-disc-str,
     9030                                        bf_gds-dtl.doc-code,
     9031                                        bf_gds-dtl.price-rubl,
     9032                                        v-limit
     9033                                       ).
     9034             end.
     9035           end.
     9036           else do:
     9037             if bf_gds-dtl.price-base - bf_gds-dtl.discnt-base < v-limit then do:
     9038               return error substitute( "Текущая цена по товару &1 &2 &3 &4 равна &5. Максимальная скидка при продаже через расходную накладную &6. Цена в документе &7, равная &8, меньше минимальной цены с максимальной скидкой, равной &9. (gds-dtl)",
     9039                                        bf_goods.artic,
     9040                                        bf_goods.prod-type,
     9041                                        bf_goods.prod-code,
     9042                                        bf_goods.gds-name,
     9043                                        gp-price-sale,
     9044                                        varmax-disc-str,
     9045                                        bf_gds-dtl.doc-code,
     9046                                        bf_gds-dtl.price-base,
     9047                                        v-limit
     9048                                       ).
     9049             end.
     9050           end.
     9051         end.
     9052       end.
     9053     end.
     9054   end.
     9055   end.
     9056   end procedure.
