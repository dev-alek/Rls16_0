     3535         indexed-reposition
     3536     .
     3537         assign
     3538           l-query-was-opened = true
     3539         .
     3540     end.
     3541   end.
     3542   else do:
     3543     assign
     3544       doc-rec = recid( buf_c-pl-level )
     3545     .
     3546     do
     3547     on stop undo, leave
     3548     on error undo, leave
     3549     :
     3550       if query br-pl-levels:handle:get-buffer-handle(1) = (buffer buf_c-pl-level:handle) then do:
     3551         assign
     3552         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     3553         parameter-4-27 =
     3554           "where ":u +  substitute(' buf_c-pl-level.obj-type = &1&2&1 and                           buf_c-pl-level.obj-code = &3 and                           buf_c-pl-level.pl-code  = &4' , chr(34), p-obj-type, p-obj-code, p-pl-code)  + " ":u + where-phrase-27 + " ":u + p-find-condition + " " + ""
     3555         parameter-5-27 = "  "
     3556       .
     3557         run fltopend_fltfindd in this-procedure  (
     3558                             input this-procedure:handle
     3559                             ,input query br-pl-levels:handle
     3560                             ,input rowid(buf_c-pl-level)
     3561                             ,input logical(parameter-2-27)
     3562                             ,input no-lock
     3563                             ,input (buffer buf_c-pl-level:handle)
     3564                             ,input parameter-4-27
     3565                             ,input parameter-5-27
     3566                             ) no-error.
     3567         .
     3568         assign
     3569           doc-rec = integer(return-value)
     3570           v-fltopend-rowid[1] = ?
     3571         .
     3572       end.
     3573       else do:
     3574         assign
     3575         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     3576         parameter-3-27 =  "for each buf_c-pl-level"
     3577         parameter-4-27 =
     3578           (
     3579             if ("                           buf_c-pl-level.obj-type = p-obj-type and                           buf_c-pl-level.obj-code = p-obj-code and                           buf_c-pl-level.pl-code  = p-pl-code                         " + " " + where-phrase-27) <> ""
     3580             then  substitute(' buf_c-pl-level.obj-type = &1&2&1 and                           buf_c-pl-level.obj-code = &3 and                           buf_c-pl-level.pl-code  = &4' , chr(34), p-obj-type, p-obj-code, p-pl-code)  + " " + where-phrase-27
     3581             else "true"
     3582           )
     3583         parameter-5-27 = (" " + "" + " " + "" + " " + p-find-condition)
     3584         parameter-6-27 = if sort-phrase-27 = ''
     3585                              then
     3586           (
     3587           " " + "  " +
     3588             " " + sort-column-phrase +
     3589           " " + "  "
     3590           )
     3591                              else
     3592           (
     3593           " " + "  " +
     3594             " " + sort-column-phrase +
     3595           " " + sort-phrase-27
     3596           )
     3597         parameter-7-27 =
     3598           " indexed-reposition  "
     3599       .
     3600         run fltopend_fltfindq in this-procedure  (
     3601                             input this-procedure:handle
     3602                             ,input query br-pl-levels:handle
     3603                             ,input logical(parameter-2-27)
     3604                             ,input no-lock
     3605                             ,input parameter-3-27
     3606                             ,input parameter-4-27
     3607                             ,input parameter-5-27
     3608                             ,input parameter-6-27
     3609                             ,input parameter-7-27
     3610                             ,output v-fltopend-rowid
     3611                             ) no-error.
     3612         .
     3613         doc-rec = ?.
     3614       end.
     3615       assign
     3616         l-query-was-opened = true
     3617       .
     3618     end.
     3619   end.
     3620     run waitfram-hide in this-procedure .
     3621       end.
     3622     end case.
     3623     if p-open-query <> yes then do:
     3624       reposition br-pl-levels to recid doc-rec no-error.
     3625     end.
     3626     if not p-open-query and v-fltopend-rowid[1] <> ? then
     3627     query br-pl-levels:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3628     apply "VALUE-CHANGED":U to br-pl-levels in frame fr-D-pl-level-0.
     3629     apply "ENTRY":U         to br-pl-levels in frame fr-D-pl-level-0.
     3630   end procedure.
     3631   procedure proc-filter :
     3632     assign tbl      = 'c-pl-level'
     3633            join-tbl = 'buf_c-pl-level'
     3634            fld      = '':U
     3635            lab      = '':U
     3636            spr      = '':U
     3637            dim      = '0'.
     3638     run fltfield-add in this-procedure ( input 'pl-code',     input 'Код резервуара', input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3639     run fltfield-add in this-procedure ( input 'obj-type',    input 'Тип объекта',    input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3640     run fltfield-add in this-procedure ( input 'obj-code',    input 'Код объекта',    input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3641     run fltfield-add in this-procedure ( input  'obj-type*obj-code',        input 'Объект',         input 'cli':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3642     run fltfield-add in this-procedure ( input 'pl-level',    input 'Уровень, мм',    input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3643     run fltfield-add in this-procedure ( input 'pl-qnty',     input 'Объем, л',       input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3644     run fltfield-add in this-procedure ( input 'chip-num',    input 'Щепка',          input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3645     run fltfield-add in this-procedure ( input 'corr-user-db-num', input 'БД',             input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3646     run fltfield-add in this-procedure ( input 'corr-user-name',   input 'Имя',            input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3647     run fltfield-add in this-procedure ( input 'corr-date',   input 'Дата корр.',     input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3648     run fltfield-add in this-procedure ( input 'corr-time',   input 'Время',          input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3649     run fltfield-add in this-procedure ( input 'action',      input 'Действие',       input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3650     if num-entries( fld ) <> num-entries( lab ) or num-entries( lab ) <> integer( dim ) or
     3651        num-entries( fld ) <> num-entries( spr ) or num-entries( spr ) <> integer( dim ) or
     3652        num-entries( lab ) <> num-entries( spr ) or num-entries( fld ) <> integer( dim ) then do:
     3653       message "Неверная настройка на фильтры!" view-as alert-box error.
     3654       return no-apply.
     3655     end.
     3656     Filter-Block:
     3657     do on error   undo Filter-Block, leave Filter-Block
     3658        on end-key undo Filter-Block, leave Filter-Block :
     3659       run gbl/filter.w ( input parparentproc,
     3660                      input filter-point,
     3661                      input tbl,
     3662                      input join-tbl,
     3663                      input fld,
     3664                      input lab,
     3665                      input spr,
     3666                      input dim            ).
     3667       if return-value = 'undo':U then do:
     3668         apply "ENTRY":U to browse br-pl-levels.
     3669         return no-apply.
     3670       end.
     3671       assign mark-num = 0
     3672              sch-num  = 0.
     3673       hide   mark-num in frame fr-D-pl-level-0.
     3674       hide   sch-num  in frame fr-D-pl-level-0.
     3675       run OpenBr in this-procedure ( input yes, input no, input '':U ).
     3676     end.
     3677   end procedure.
     3678   procedure proc-view-changes :
     3679     for each temp-changes :
     3680       delete temp-changes.
     3681     end.
     3682     if not available buf_c-pl-level then do:
     3683       run OpenChanges in this-procedure .
     3684       return.
     3685     end.
     3686   define variable v-label-param as character no-undo .
     3687   v-label-param =
     3688     "pl-code" + chr(4) + "Резервуар" + chr(4) + "" + chr(8)
     3689    + "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
     3690    + "obj-code" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
     3691    + "pl-level" + chr(4) + "Уровень мм" + chr(4) + "" + chr(8)
     3692    + "pl-qnty" + chr(4) + "Объем л" + chr(4) + ""  .
     3693    run proc-full-temp-changes in this-procedure (
     3694                                                input  buffer buf_c-pl-level:handle
     3695                                               ,input  'pl-level':U
     3696                                               ,input  "pl-code,obj-type,obj-code,pl-level,pl-qnty"
     3697                                               ,input  v-label-param).
     3698     run OpenChanges in this-procedure .
     3699   end procedure.
     3700   procedure OpenChanges :
     3701   open query br-changes for each buf_changes no-lock.
     3702   end procedure.
     3703   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3704   procedure set-filter-name :
     3705   define input parameter p-filter-name as character no-undo .
     3706     do with frame fr-D-pl-level-0:
     3707       if p-filter-name > "" then do:
     3708         assign
     3709           frame fr-D-pl-level-0:title
     3710             = frame fr-D-pl-level-0:title + "   ФИЛЬТР: " + p-filter-name.
     3711         .
     3712         assign
     3713           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3714         .
     3715       end.
     3716       else do:
     3717         assign
     3718           b-sch :tooltip = ""
     3719         .
     3720       end.
     3721     end.
     3722   end procedure.
     3723   procedure proc-find-plc :
     3724     define input parameter p-next as logical no-undo.
     3725     define input parameter p-code as integer no-undo.
     3726     run OpenBr in this-procedure ( input no, input p-next, input substitute( " and buf_c-pl-level.pl-code = &1 ", p-code ) ).
     3727     if doc-rec <> ? then do:
     3728       if FoundRec = ? then do: assign FoundRec = doc-rec. end.
     3729       if FoundRec = doc-rec then do: assign sch-num = 0. end.
     3730       assign  sch-num = sch-num + 1.
     3731       display sch-num with frame fr-D-pl-level-0.
     3732     end.
     3733     else do:
     3734       assign  sch-num = 0.
     3735       hide    sch-num in frame fr-D-pl-level-0.
     3736     end.
     3737     apply "ENTRY":U to sch-plc in frame fr-D-pl-level-0.
     3738   end procedure.
     3739   procedure get-mark-string :
     3740     define        parameter buffer loc-buf for ub.c-pl-level.
     3741     define output parameter        p-sign  as  character no-undo.
     3742     assign p-sign = ( if lookup( Rec2Char( recid( loc-buf ) ), p-rid-list ) > 0 then chr( 42 ) else chr( 32 ) ).
     3743   end procedure.
     3744   procedure get-action-name :
     3745     define  input parameter p-code as integer   no-undo.
     3746     define output parameter p-name as character no-undo.
     3747     define variable v_code  as character no-undo.
     3748     define variable j_entry as integer   no-undo.
     3749     if p-code = ? or p-code = 0 then do: assign p-name = "":U. end.
     3750     assign v_code  = Int2Char( p-code ).
     3751     assign j_entry = lookup(   v_code, p-act-codes ).
     3752     assign p-name  = ( if j_entry = 0 then "":U else entry( j_entry, p-act-names ) ).
     3753   end procedure.
     3754   procedure get-obj-short-name :
     3755     define  input parameter p-type as character no-undo.
     3756     define  input parameter p-code as integer   no-undo.
     3757     define output parameter p-name as character no-undo.
     3758     assign p-name = ( if p-type = ? or p-code = ? then "":U else ( p-type + " ":U + Int2Char( p-code ) ) ).
     3759   end procedure.
     3760   procedure get-obj-full-name :
     3761     define  input parameter p-type as character no-undo.
     3762     define  input parameter p-code as integer   no-undo.
     3763     define output parameter p-name as character no-undo.
     3764     define buffer buf_clients for ub.clients.
     3765     find buf_clients no-lock where
     3766          buf_clients.obj-type = p-type and
     3767          buf_clients.obj-code = p-code no-error.
     3768     if available buf_clients then do:
     3769       assign p-name = buf_clients.obj-name.
     3770     end.
     3771     else do:
     3772       assign p-name = ( if p-type = ? or p-code = ? then "":U else ( p-type + " ":U + Int2Char( p-code ) ) ).
     3773     end.
     3774   end procedure.
     3775   procedure get-place-name :
     3776     define        parameter buffer buf_loc for ub.c-pl-level.
     3777     define output parameter        p-name  as  character no-undo.
     3778     define buffer buf_place for ub.place.
     3779     find first buf_place no-lock where
     3780                buf_place.obj-type = buf_loc.obj-type and
     3781                buf_place.obj-code = buf_loc.obj-code and
     3782                buf_place.pl-code  = buf_loc.pl-code  no-error.
     3783     assign p-name = ( if available buf_place then buf_place.pl-name else "":U ).
     3784   end procedure.
     3785   procedure get-place-loc1 :
     3786     define        parameter buffer buf_loc for ub.c-pl-level.
     3787     define output parameter        p-loc1  as  character no-undo.
     3788     define buffer buf_place for ub.place.
     3789     find first buf_place no-lock where
     3790                buf_place.obj-type = buf_loc.obj-type and
     3791                buf_place.obj-code = buf_loc.obj-code and
     3792                buf_place.pl-code  = buf_loc.pl-code  no-error.
     3793     assign p-loc1 = ( if available buf_place then buf_place.loc1 else "":U ).
     3794   end procedure.
