     1973                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1974                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1975               .
     1976             end.
     1977           end.
     1978           assign
     1979             v-object-handle = v-object-handle :next-sibling
     1980           .
     1981         end.
     1982         assign
