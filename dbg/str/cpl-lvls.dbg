     1725           end.
     1726         end.
     1727       end.
     1728       if p-move-resize = true
     1729       then do:
     1730         run diasize_position-resize-button in this-procedure .
     1731       end.
     1732       if v-diasize-wndstore = true
     1733       then do:
     1734         if connected("ub") = true
     1735         then do:
     1736           define variable v-cntxt-db-num        as integer   no-undo .
     1737           define variable v-cntxt-userid        as character no-undo .
     1738           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1739                                             , OUTPUT v-cntxt-userid
     1740                                             ) .
     1741           run gbl/wndsizew.p
     1742             (input  v-cntxt-db-num
     1743             ,input  v-cntxt-userid
     1744             ,input  v-diasize-proc-name
     1745             ,input  'height':u
     1746             ,input  string(frame fr-D-pl-level-0 :height - v-diasize-orig-frame-height)
     1747             ) .
     1748         end.
     1749       end.
     1750     end.
     1751     assign
     1752       v-diasize-change-size = false
     1753     .
     1754   end procedure.
     1755   procedure diasize_set-height :
     1756     define input  parameter p-new-height  as decimal   no-undo .
     1757     define input  parameter p-move-resize as logical   no-undo .
     1758     do
     1759     on error undo, return error return-value
     1760     :
     1761       run diasize_change-height in this-procedure
     1762         (input  (p-new-height - frame fr-D-pl-level-0 :height)
     1763         ,input  p-move-resize
     1764         ) .
     1765     end.
     1766   end procedure.
     1767   procedure diasize_change-width :
     1768     define input  parameter p-change-value as decimal   no-undo .
     1769     define input  parameter p-move-resize  as logical   no-undo .
     1770     define variable v-field-group-handle   as handle    no-undo .
     1771     define variable v-object-handle        as handle    no-undo .
     1772     define variable v-frame-width          as decimal   no-undo .
     1773     define variable v-frame-virtual-width  as decimal   no-undo .
     1774     define variable v-browse-width         as decimal   no-undo .
     1775     define variable v-window-width         as decimal   no-undo .
