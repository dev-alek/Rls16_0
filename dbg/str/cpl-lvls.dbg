        1   define input        parameter parparentproc as widget-handle no-undo.
        2   define input        parameter p-bttns       as character     no-undo.
        3   define input        parameter p-mode        as character     no-undo.
        4   define input        parameter p-obj-type    as character     no-undo.
        5   define input        parameter p-obj-code    as integer       no-undo.
        6   define input        parameter p-pl-code     as integer       no-undo.
        7   define input-output parameter p-rid-list    as character     no-undo.
        8   define variable vss-revision    as character no-undo initial "$Revision$":U.
        9   define variable vss-author      as character no-undo initial "$Author$":U.
       10   define variable vss-date        as character no-undo initial "$Date$":U.
       11   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
       12   define variable vss-archive     as character no-undo initial "$Archive$":U.
       13   define variable vss-description as character no-undo initial "Список истории изменения градуировочной таблицы по резервуару на объекте":U.
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   procedure proc-alt-shift-f2:
       75     if not ibs.th.gbl.gbl-var:rcode
       76   then
       77     run gbl\inidebug.p .
       78   end.
       79   procedure proc-alt-shift-f3:
       80     run gbl/prvssinf.p
       81       ( input this-procedure
       82       ) .
       83   end.
       84   define variable v-inform-launched as logical no-undo initial false .
       85   procedure proc-alt-shift-f4:
       86     define variable v-action as character no-undo .
       87     if v-inform-launched = false then do:
       88       assign
       89         v-inform-launched = true
       90       .
       91       run gbl/d-inform.w
       92         (  input self
       93         ,  input this-procedure
       94         , output v-action
       95         ) no-error .
       96       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       97       assign
       98         v-inform-launched = false
       99       .
      100     end.
      101   end.
      102   procedure proc-alt-f1:
      103     run gbl/corrhelp.p
      104       (input this-procedure
      105       ) .
      106   end .
      107   on alt-shift-f2 anywhere do:
      108     run proc-alt-shift-f2.
      109   end.
      110   on alt-shift-f3 anywhere do:
      111     run proc-alt-shift-f3 in this-procedure .
      112   end.
      113   on alt-shift-f4 anywhere do:
      114     run proc-alt-shift-f4 in this-procedure.
      115   end.
      116   on alt-f1 anywhere do:
      117     run proc-alt-f1 in this-procedure .
      118   end.
      119   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120   define variable c-point  as character no-undo .
      121   define variable tbl      as character no-undo .
      122   define variable join-tbl as character no-undo .
      123   define variable fld      as character no-undo .
      124   define variable lab      as character no-undo .
      125   define variable spr      as character no-undo .
      126   define variable dim      as character no-undo .
      127   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128   define variable v-waitfram-action01         as character   no-undo .
      129   define variable v-waitfram-action02         as character   no-undo .
      130   define variable v-waitfram-action03         as character   no-undo .
      131   define variable mWaitFramTextBeg            as character   no-undo.
      132   define variable mWaitFramTextEnd            as character   no-undo.
      133   define variable mWaitFramView               as logical     no-undo.
      134   define variable mWaitProcEvent              as logical     no-undo init yes.
      135   define variable mWaitFramInterval           as integer     no-undo init 1 .
      136   define variable mWaitFramStop               as logical     no-undo.
      137   define variable mWaitFramStopUser           as logical     no-undo.
      138   define variable mWaitFramStopTimeOut        as logical     no-undo.
      139   define variable mWaitFramStartProc          as datetime-tz no-undo.
      140   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      141   define button B-WaitFramStop auto-end-key
      142        label "Стоп"
      143        size 10 by 1 tooltip "Остоновить процесс".
      144   define button B-viewProcInfo
      145        label "Информация"
      146        size 15 by 1 tooltip "Информация о процесс".
      147   define frame waitfram
      148     v-waitfram-action01 format "x(72)" no-label skip
      149     v-waitfram-action02 format "x(72)" no-label skip
      150     v-waitfram-action03 format "x(72)" no-label skip
      151     B-viewProcInfo
      152     B-WaitFramStop at row 4 col 30
      153     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      154     .
      155   define new global shared variable mBatchMode as logical no-undo init ?.
      156   define variable mFramBachModHandle as handle no-undo.
      157   mFramBachModHandle = frame waitfram:handle.
      158   define variable mFameOldVis as logical no-undo.
      159   define variable mVisCUrentVin as logical no-undo.
      160   if session:batch-mode
      161   then
      162      mBatchMode = yes.
      163   if mBatchMode = ? then do:
      164     mVisCUrentVin = current-window:visible.
      165     mFameOldVis = mFramBachModHandle:visible.
      166     mFramBachModHandle:visible  = yes.
      167     mBatchMode = mFramBachModHandle:visible ne yes.
      168     mFramBachModHandle:visible = mFameOldVis.
      169     current-window:visible = mVisCUrentVin.
      170   end.
      171    if  log-manager:logfile-name ne ?
      172     then DO:
      173         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      174         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      175         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      176     end.
      177   on choose of B-WaitFramStop in frame waitfram
      178   do:
      179     mWaitFramStop = yes.
      180     mWaitFramStopUser = yes.
      181   end.
      182   function waitfram-check-timeout returns logical():
      183      define variable vtime as int64 no-undo.
      184      if mWaitFramStopTimeOut
      185      then
      186         return yes.
      187      vtime = ( now - mWaitFramStartProc ) / 1000 .
      188      if     mWaitFramTimeOut ne ?
      189         and mWaitFramTimeOut ne 0
      190         and mWaitFramTimeOut lt vtime
      191      then do:
      192         mWaitFramStopTimeOut = yes.
      193      end.
      194      return mWaitFramStopTimeOut.
      195   end.
      196   procedure waitfram-hide :
      197     if not session:batch-mode
      198     then do
      199     on error undo, return error return-value
      200     :
      201       pause 0 before-hide .
      202       if not mBatchMode then
      203         hide frame waitfram .
      204     if     not mWaitFramView
      205        and mWaitProcEvent
      206     then
      207       process events .
      208     end.
      209   end procedure.
      210   procedure waitfram-show :
      211     define input  parameter p-message as character no-undo .
      212     define variable v-left-margin as integer   no-undo .
      213     if not session:batch-mode
      214     then do
      215     on error undo, return error return-value
      216     :
      217       if length(p-message) <= 70 then do:
      218         assign
      219           v-left-margin = integer((70 - length(p-message)) / 2)
      220         .
      221         assign
      222           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      223         .
      224         assign
      225           v-waitfram-action01 = " "
      226           v-waitfram-action02 = " "
      227                                    + fill(" ", v-left-margin)
      228                                    + p-message
      229           v-waitfram-action03 = " "
      230         .
      231       end.
      232       else do:
      233         define variable vRindex1 as integer no-undo.
      234         define variable vRindex2 as integer no-undo.
      235         vRindex1 = r-index(p-message," ",70).
      236         if vRindex1 = 0
      237         then
      238            vRindex1 = 70.
      239         if length(p-message)  <= vRindex1 + 70 then do:
      240           assign
      241             v-waitfram-action01 = " "
      242             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      243             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      244           .
      245         end.
      246         else do:
      247           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      248           if vRindex2 <= vRindex1
      249           then
      250              vRindex2 = vRindex1 + 70.
      251           assign
      252             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      253             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      254             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      255           .
      256         end.
      257       end.
      258       B-viewProcInfo:visible   in frame waitfram = no.
      259       B-viewProcInfo:sensitive in frame waitfram = no.
      260       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      261       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      262       if  (   mWaitFramView
      263          or  mWaitProcEvent)
      264          and not mBatchMode
      265       then
      266          display
      267             v-waitfram-action01 skip
      268             v-waitfram-action02 skip
      269             v-waitfram-action03 skip
      270          with frame waitfram .
      271       if     mWaitFramView
      272          then do:
      273             if     mWaitFramInterval ne ?
      274                and not mBatchMode
      275             then
      276                wait-for go of frame waitfram pause mWaitFramInterval.
      277          end.
      278          else
      279             if     mWaitProcEvent
      280                and not mBatchMode
      281             then
      282                process events .
      283     end.
      284   end procedure.
      285      procedure waitfram-show-this:
      286         define input  parameter iInterval as int64 no-undo.
      287         define variable vtime as int64 no-undo.
      288         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      289         mWaitFramInterval = iInterval.
      290         run waitfram-show (substitute("&1&2 &3&4" ,
      291                                       mWaitFramTextBeg ,
      292                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      293                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      294                                       mWaitFramTextEnd
      295                                      )
      296                           ).
      297      end.
      298      procedure WaitFramRunPause:
      299         define input  parameter iInterval as dec no-undo.
      300         define variable vStart  as datetime-tz no-undo.
      301         define variable vend    as datetime-tz no-undo.
      302         define variable vint as int64 no-undo.
      303         define variable vOk as logical no-undo.
      304         vStart = now.
      305         vend   = vStart.
      306         publish "WaitFramPause" (iInterval,output vOk).
      307         vend   =  now.
      308         vint = vend - vStart.
      309         vint = iInterval - vint / 1000.
      310         if     not mWaitFramStop
      311            and (   vint > 0
      312                 or (    not vOk
      313                     and iInterval eq ?
      314                     )
      315                 )
      316         then
      317            run waitfram-show-this (iInterval).
      318         vend   =  now.
      319         vint = vend - vStart.
      320         vint = iInterval - vint / 1000.
      321         if     not mWaitFramStop
      322            and vint > 0
      323         then do:
      324            run gbl/pause.p (vint * 1000).
      325         end.
      326         if iInterval ne ?
      327         then
      328            publish "WaitFramStop".
      329         waitfram-check-timeout().
      330      end.
      331      procedure WaitFramWaitFor:
      332         define input  parameter iInterval as dec no-undo.
      333         assign
      334            mWaitFramStartProc   = now
      335            mWaitFramStopUser    = no
      336            mWaitFramStopTimeOut = no
      337         .
      338         block-wait:
      339         do while not mWaitFramStop:
      340            run WaitFramRunPause (iInterval).
      341            if  waitfram-check-timeout()
      342            then do:
      343               leave block-wait.
      344            end.
      345         end.
      346         run waitfram-hide.
      347      end.
      348   procedure waitfram-join :
      349     define input  parameter p-line-1  as character no-undo .
      350     define input  parameter p-line-2  as character no-undo .
      351     define input  parameter p-line-3  as character no-undo .
      352     define output parameter p-message as character no-undo .
      353     do
      354     on error undo, return error return-value
      355     :
      356       assign
      357         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      358                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      359                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      360       .
      361     end.
      362   end procedure.
      363   function waitfram-join-function returns character
      364     (input p-line-1 as character
      365     ,input p-line-2 as character
      366     ,input p-line-3 as character
      367     ).
      368     define variable v-message as character no-undo .
      369     run waitfram-join in this-procedure
      370       (input  p-line-1
      371       ,input  p-line-2
      372       ,input  p-line-3
      373       ,output v-message
      374       ) .
      375     return v-message .
      376   end function .
      377   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      378   procedure fltfield-clear :
      379     define output parameter loc-fld as character no-undo.
      380     define output parameter loc-lab as character no-undo .
      381     define output parameter loc-spr as character no-undo .
      382     define output parameter loc-dim as character no-undo .
      383     assign
      384       loc-fld = ""
      385       loc-lab = ""
      386       loc-spr = ""
      387       loc-dim = "0"
      388     .
      389   end procedure .
      390   procedure fltfield-add :
      391     define input        parameter par-fld as character no-undo.
      392     define input        parameter par-lab as character no-undo .
      393     define input        parameter par-spr as character no-undo .
      394     define input-output parameter loc-fld as character no-undo.
      395     define input-output parameter loc-lab as character no-undo .
      396     define input-output parameter loc-spr as character no-undo .
      397     define input-output parameter loc-dim as character no-undo .
      398     do
      399     on error undo, return error
      400     :
      401       assign
      402       loc-fld = if loc-dim = '0'
      403                 then par-fld
      404                 else (loc-fld + chr(44) + par-fld)
      405       loc-lab = if loc-dim = '0'
      406                 then par-lab
      407                 else (loc-lab + chr(44) + par-lab)
      408       loc-spr = if loc-dim = '0'
      409                 then par-spr
      410                 else (loc-spr + chr(44) + par-spr)
      411       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      412                 string(integer(if num-entries(loc-dim) > 1
      413                               then entry(2, loc-dim)
      414                               else entry(1, loc-dim)
      415                               ) + 1)
      416       no-error
      417       .
      418     end.
      419   end procedure.
      420   FUNCTION Int2Char RETURNS CHARACTER ( INPUT i-num AS INTEGER ) :   DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.   RUN conv-int-to-char IN THIS-PROCEDURE ( INPUT i-num, OUTPUT v-str ) NO-ERROR.   RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-str ). END FUNCTION.      PROCEDURE conv-int-to-char :   DEFINE  INPUT PARAMETER p-num AS INTEGER   NO-UNDO.   DEFINE OUTPUT PARAMETER p-str AS CHARACTER NO-UNDO.   DO ON ERROR UNDO, RETURN ERROR :     ASSIGN p-str = TRIM( STRING( p-num, "->>>>>>>>>>>>":U ) ).   END.  END PROCEDURE.
      421   FUNCTION Rec2Char RETURNS CHARACTER ( INPUT i-rec AS RECID ) :
      422     DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.
      423     RUN conv-rec-to-char IN THIS-PROCEDURE ( INPUT i-rec, OUTPUT v-str ) NO-ERROR.
      424     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-str ).
      425   END FUNCTION.
      426   PROCEDURE conv-rec-to-char :
      427     DEFINE  INPUT PARAMETER p-rec AS RECID     NO-UNDO.
      428     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      429     DO ON ERROR UNDO, RETURN ERROR :
      430       ASSIGN p-res = TRIM( STRING( p-rec, "->>>>>>>>>>>9":U ) ).
      431     END.
      432   END PROCEDURE.
      433   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      434   define   temp-table temp-changes no-undo
      435   field f_name as character
      436   field l_name as character
      437   field v_old as character
      438   field v_new as character
      439   field t_name as character
      440   field num_ as integer
      441   field uniq-key-rec as character
      442   field action as integer
      443   field fNotChange as logical
      444   index pi is unique primary
      445   num_
      446   t_name
      447   f_name
      448   index
      449   Chan
      450   fnotChange
      451   t_name
      452   f_name
      453   index imain uniq-key-rec
      454   .
      455   FUNCTION get-all-fields returns character (p-file-name as character ):
      456   define variable v-dop as character no-undo .
      457     find first _file no-lock where _file._file-name = p-file-name no-error .
      458     if not available _file then return "":U.
      459     for each _field no-lock where
      460              _field._file-recid = recid(_file) :
      461       assign
      462       v-dop = v-dop + _field._field-name + chr(44)
      463       .
      464     end.
      465     return trim(v-dop).
      466   END FUNCTION.
      467   PROCEDURE proc-full-temp-changes :
      468     define input  parameter p-hst-handle as handle    no-undo .
      469     define input  parameter p-main-table as character no-undo .
      470     define input  parameter p-field-list as character no-undo .
      471     define input  parameter p-label-form as character no-undo .
      472     define variable h-new-buf         as handle    no-undo .
      473     define variable h-main-buf        as handle    no-undo .
      474     define variable h-for-comp        as handle    no-undo .
      475     define variable v-inform          as character no-undo .
      476     define variable v-ind             as integer   no-undo .
      477     define variable v-idx-field-qnty  as integer   no-undo .
      478     define variable v-num-entries     as integer   no-undo .
      479     define variable fh                as handle    no-undo .
      480     define variable fh-main           as handle    no-undo .
      481     define variable fh-old            as handle    no-undo .
      482     define variable fh-new            as handle    no-undo .
      483     define variable v-field-name      as character no-undo .
      484     define variable v-field-lvl       as character no-undo .
      485     define variable v-field-form      as character no-undo .
      486     define variable v-search-exp      as character no-undo .
      487     define variable v-srch-main       as character no-undo .
      488     define variable v-word-link       as character no-undo .
      489     define variable v-av-chip-num     as logical   no-undo .
      490     define variable v-main-pi-fld-lst as character no-undo .
      491     define variable v-main-fld-lst    as character no-undo .
      492     define variable v-delim-list      as character no-undo .
      493     define variable v-label           as character no-undo .
      494     define variable v-old-value       as character no-undo case-sensitive.
      495     define variable v-new-value       as character no-undo case-sensitive.
      496     define variable v-chg-fields as character no-undo.
      497     for each temp-changes:
      498       delete temp-changes.
      499     end.
      500     if not p-hst-handle:available then do:
      501       return .
      502     end.
      503     create buffer h-new-buf  for table p-hst-handle .
      504     create buffer h-main-buf for table p-main-table .
      505     assign
      506       v-inform = h-main-buf:index-information(1)
      507       v-ind    = 2
      508     .
      509     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      510     on error undo, return error
      511     :
      512       assign
      513         v-inform = h-main-buf:index-information( v-ind )
      514         v-ind    = v-ind + 1
      515       .
      516     end.
      517     if v-inform = ?
      518       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      519       or entry( 3, v-inform, ",":U ) <> "1":U
      520     then do:
      521       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      522     end.
      523     assign
      524       v-idx-field-qnty = num-entries( v-inform ) - 4
      525     .
      526     if v-idx-field-qnty < 2 then do:
      527       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      528     end.
      529     assign
      530       v-srch-main   = "where":U
      531       v-word-link   = "":U
      532       v-av-chip-num = false
      533       v-delim-list  = "":U
      534     .
      535     do v-ind = 1 to v-idx-field-qnty by 2
      536     on error undo, return error
      537     :
      538       assign
      539         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      540         fh                = p-hst-handle:buffer-field( v-field-name )
      541         fh-main           = h-main-buf:buffer-field( v-field-name )
      542         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      543         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      544       .
      545       if fh:data-type ="character":U then do:
      546         assign
      547           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      548         .
      549       end.
      550       else do:
      551         assign
      552           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      553         .
      554       end.
      555       if v-delim-list = "":U then do:
      556         assign
      557           v-delim-list = ",":U
      558         .
      559       end.
      560       if v-word-link = "":U then do:
      561         assign
      562           v-word-link = "and":U
      563         .
      564       end.
      565     end.
      566     assign
      567       v-delim-list  = "":U
      568     .
      569     do v-ind = 1 to h-main-buf:num-fields
      570     on error undo, return error
      571     :
      572       assign
      573         fh-main      = h-main-buf:buffer-field( v-ind )
      574         v-field-name = fh-main:name
      575       .
      576         assign
      577           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      578         .
      579         if v-delim-list = "":U then do:
      580           assign
      581             v-delim-list = ",":U
      582           .
      583         end.
      584     end.
      585     assign
      586       v-inform = p-hst-handle:index-information(1)
      587       v-ind    = 2
      588     .
      589     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      590     on error undo, return error
      591     :
      592       assign
      593         v-inform = p-hst-handle:index-information( v-ind )
      594         v-ind    = v-ind + 1
      595       .
      596     end.
      597     if v-inform = ?
      598       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      599       or entry( 3, v-inform, ",":U ) <> "1":U
      600     then do:
      601       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      602     end.
      603     assign
      604       v-idx-field-qnty = num-entries( v-inform ) - 4
      605     .
      606     if v-idx-field-qnty < 2 then do:
      607       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      608     end.
      609     assign
      610       v-search-exp  = "where":U
      611       v-word-link   = "":U
      612       v-av-chip-num = false
      613     .
      614     do v-ind = 1 to v-idx-field-qnty by 2
      615     on error undo, return error
      616     :
      617       assign
      618         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      619         fh           = p-hst-handle:buffer-field( v-field-name )
      620         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      621       .
      622       if v-field-name = "chip-num":U then do:
      623         assign
      624           v-search-exp  = substitute( "&1 >", v-search-exp )
      625           v-av-chip-num = true
      626         .
      627       end.
      628       else do:
      629         assign
      630           v-search-exp = substitute( "&1 =", v-search-exp )
      631         .
      632       end.
      633       if fh:data-type ="character":U then do:
      634         assign
      635           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      636         .
      637       end.
      638       else do:
      639         assign
      640           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      641         .
      642       end.
      643       if v-word-link = "":U then do:
      644         assign
      645           v-word-link = "and":U
      646         .
      647       end.
      648     end.
      649     if v-av-chip-num = false then do:
      650       message
      651         vss-workfile vss-revision vss-description skip
      652         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      653         "Использование данной процедуры невозможно!" skip
      654         view-as alert-box error .
      655       return error .
      656     end.
      657     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      658     if not h-new-buf:available then do:
      659       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      660       if not h-main-buf:available then do:
      661         assign
      662           h-for-comp = ?
      663         .
      664       end.
      665       else do:
      666         assign
      667           h-for-comp = h-main-buf
      668         .
      669       end.
      670     end.
      671     else do:
      672       assign
      673         h-for-comp = h-new-buf
      674       .
      675     end.
      676     assign
      677       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      678     .
      679     do v-ind = 1 to v-num-entries
      680     on error undo, return error return-value
      681     :
      682       assign
      683         v-field-name = entry( v-ind, v-main-fld-lst )
      684         fh-old       = p-hst-handle:buffer-field( v-field-name )
      685         v-old-value  = fh-old:buffer-value()
      686         v-label      = trim( fh-old:label )
      687       .
      688       if ( trim( p-field-list ) <> "":U
      689            and lookup( v-field-name, p-field-list ) > 0
      690          )
      691          or trim( p-field-list ) = "":U
      692       then do:
      693         if h-for-comp <> ? then do:
      694           assign
      695             fh-new      = h-for-comp:buffer-field( v-field-name )
      696             v-new-value = fh-new:buffer-value()
      697           .
      698         end.
      699         else do:
      700           assign
      701             v-new-value = "":U
      702           .
      703         end.
      704         if v-old-value <> v-new-value
      705         then do:
      706           create temp-changes.
      707           assign
      708             temp-changes.t_name = p-main-table
      709             temp-changes.f_name = v-field-name
      710             temp-changes.l_name = replace( v-label, "&":U, "":U )
      711             temp-changes.v_old  = trim( v-old-value )
      712             temp-changes.v_new  = trim( v-new-value )
      713             temp-changes.num_   = 0
      714             temp-changes.fNotChange = v-old-value eq v-new-value
      715           .
      716         end.
      717       end.
      718     end.
      719     assign
      720       v-num-entries = num-entries( p-label-form, chr(8) )
      721     .
      722     do v-ind = 1 to v-num-entries
      723     on error undo, return error return-value
      724     :
      725       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      726         assign
      727           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      728           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      729           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      730         .
      731         find first temp-changes
      732           where temp-changes.f_name = v-field-name
      733           no-error .
      734         if available temp-changes then do:
      735           if trim( v-field-lvl ) <> "":U then do:
      736             assign
      737               temp-changes.l_name = v-field-lvl
      738             .
      739           end.
      740           if trim( v-field-form ) <> "":U then do:
      741             assign
      742               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      743             .
      744             if h-for-comp <> ? then do:
      745               assign
      746                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      747               .
      748             end.
      749           end.
      750         end.
      751       end.
      752       else do:
      753         message
      754           vss-workfile vss-revision vss-description skip
      755           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      756           substitute( "список для поля '&1': '&2'"
      757                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      758                       ,entry( v-ind, p-label-form, chr(8) )
      759                     ) skip
      760           substitute( "полный список: &2", p-label-form ) skip
      761           view-as alert-box error .
      762       end.
      763     end.
      764     delete object h-new-buf .
      765     delete object h-main-buf .
      766   END PROCEDURE.
      767   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      768     define variable v-cntxt-db-num        as integer   no-undo .
      769     define variable v-cntxt-userid        as character no-undo .
      770     define variable v-cntxt-level         as character no-undo .
      771     define variable v-cntxt-host-code-obj as integer   no-undo .
      772     define variable v-cntxt-obj-type      as character no-undo .
      773     define variable v-cntxt-obj-code      as integer   no-undo .
      774     define variable v-cntxt-db-num-obj    as integer   no-undo .
      775     define variable v-cntxt-is-admin      as logical   no-undo .
      776   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      777     run mainmenu_getcntxt in parparentproc
      778       (output v-cntxt-db-num
      779       ,output v-cntxt-userid
      780       ,output v-cntxt-level
      781       ,output v-cntxt-host-code-obj
      782       ,output v-cntxt-obj-type
      783       ,output v-cntxt-obj-code
      784       ,output v-cntxt-db-num-obj
      785       ,output v-cntxt-is-admin
      786       ) .
      787   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      788   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      789   procedure fltopend_fltopend :
      790   define input parameter p-parent-handle as handle no-undo .
      791   define input parameter p-qh as handle no-undo .
      792   define input parameter p-flt-open-open-query  as character no-undo .
      793   define input parameter p-where-cond as character no-undo .
      794   define input parameter p-use-indFIRST-query-tail as character no-undo .
      795   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      796   define input parameter p-indexed-reposition as character no-undo .
      797     do
      798     on error undo, return error
      799     :
      800   define variable v-prepare-string as character no-undo .
      801   define variable glog as logical no-undo .
      802   assign
      803   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      804                      p-where-cond + chr(32)  +
      805                      p-use-indFIRST-query-tail + chr(32) +
      806                      p-use-ind-sort-clmn-by + chr(32) +
      807                      p-indexed-reposition
      808   .
      809   assign
      810   glog = p-qh:query-prepare(v-prepare-string) no-error .
      811   if not glog
      812   or error-status:error then do:
      813     message error-status:get-message(1) view-as alert-box .
      814     undo, return error .
      815   end.
      816   assign
      817   glog = p-qh:query-open no-error .
      818   if not glog
      819   or error-status:error then do:
      820     message error-status:get-message(1) view-as alert-box .
      821     undo, return error .
      822   end.
      823     end.
      824   end procedure.
      825   procedure fltopend_fltfindd :
      826   define input parameter p-parent-handle as handle no-undo .
      827   define input parameter p-qh as handle no-undo .
      828   define input parameter p-rowid as rowid no-undo .
      829   define input parameter p-next as logical no-undo .
      830   define input parameter p-lock as integer no-undo .
      831   define input parameter p-bh as handle no-undo .
      832   define input parameter p-where-cond as character no-undo .
      833   define input parameter p-use-index-phrase as character no-undo .
      834   define variable glog as logical no-undo .
      835   define variable v-qh as handle no-undo .
      836   define variable v-bh as handle no-undo .
      837   define variable v-recid as recid no-undo .
      838   define variable v-prepare-string as character no-undo .
      839   do
      840   on error undo, return error
      841   on stop undo, return error
      842   :
      843     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      844     create buffer v-bh for table p-bh buffer-name p-bh:name.
      845     create query v-qh.
      846     v-qh:set-buffers(v-bh).
      847     v-prepare-string = substitute("for each &1 &2 &3"
      848                                     ,v-bh:name
      849                                     ,p-where-cond
      850                                     ,p-use-index-phrase).
      851     glog = v-qh:query-prepare(v-prepare-string) no-error.
      852     if not glog then do:
      853       delete object v-qh.
      854       delete object v-bh.
      855       undo, return error .
      856     end.
      857     glog = v-qh:query-open no-error .
      858     if not glog then do:
      859       delete object v-qh.
      860       delete object v-bh.
      861       undo, return error .
      862     end.
      863     if p-next then do:
      864       v-qh:reposition-to-rowid(p-rowid) no-error .
      865       glog = v-qh:get-next( p-lock) no-error .
      866       glog = v-qh:get-next( p-lock) no-error .
      867       if not glog or v-qh:query-off-end = yes then do:
      868         glog = v-qh:get-first( p-lock) no-error .
      869       end.
      870     end.
      871     else do:
      872       glog = v-qh:get-first( p-lock) no-error .
      873     end.
      874     v-recid = v-bh:recid no-error .
      875     delete object v-qh.
      876     delete object v-bh.
      877     return string(v-recid) .
      878   end.
      879   end procedure.
      880   procedure fltopend_fltfindq :
      881   define input parameter p-parent-handle as handle no-undo .
      882   define input parameter p-qh as handle no-undo .
      883   define input parameter p-next as logical no-undo .
      884   define input parameter p-lock as integer no-undo .
      885   define input parameter p-flt-open-open-query  as character no-undo .
      886   define input parameter p-where-cond as character no-undo .
      887   define input parameter p-use-indFIRST-query-tail as character no-undo .
      888   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      889   define input parameter p-indexed-reposition as character no-undo .
      890   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      891   define variable glog as logical no-undo .
      892   define variable v-qh as handle no-undo .
      893   define variable v-bh as handle no-undo extent 18.
      894   define variable v-rowid as rowid no-undo extent 18.
      895   define variable v-ii as integer no-undo .
      896   define variable v-prepare-string as character no-undo .
      897   do
      898   on error undo, return error
      899   on stop undo, return error
      900   :
      901     create query v-qh.
      902     do v-ii = 1 to p-qh:num-buffers:
      903       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      904       assign
      905       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      906       no-error.
      907       v-qh:add-buffer(v-bh[v-ii]).
      908     end.
      909     assign
      910     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      911                       p-where-cond + chr(32)  +
      912                       p-use-indFIRST-query-tail + chr(32) +
      913                       p-use-ind-sort-clmn-by + chr(32) +
      914                       p-indexed-reposition
      915     .
      916     glog = v-qh:query-prepare( v-prepare-string) no-error .
      917     if not glog then do:
      918       delete object v-qh.
      919       do v-ii = 1 to p-qh:num-buffers:
      920         delete object v-bh[v-ii].
      921       end.
      922       undo, return error .
      923     end.
      924     glog = v-qh:query-open no-error .
      925     if not glog then do:
      926       delete object v-qh.
      927       do v-ii = 1 to p-qh:num-buffers:
      928         delete object v-bh[v-ii].
      929       end.
      930       undo, return error .
      931     end.
      932     if p-next then do:
      933       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      934       glog = v-qh:get-next( p-lock) no-error .
      935       glog = v-qh:get-next( p-lock) no-error .
      936       if not glog or v-qh:query-off-end = yes then do:
      937         glog = v-qh:get-first( p-lock) no-error .
      938       end.
      939     end.
      940     else do:
      941       glog = v-qh:get-first( p-lock) no-error .
      942     end.
      943     do v-ii = 1 to p-qh:num-buffers:
      944       assign
      945       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      946       no-error.
      947     end.
      948     delete object v-qh.
      949     do v-ii = 1 to p-qh:num-buffers:
      950       delete object v-bh[v-ii].
      951     end.
      952   end.
      953   end procedure.
      954   define buffer buf_changes  for temp-changes.
      955   define buffer buf_c-pl-level  for ub.c-pl-level.
      956   define buffer sch_c-pl-level for ub.c-pl-level.
      957   define buffer buf_source   for ub.pl-level.
      958   define buffer buf_object   for ub.clients.
      959   define variable filter-point     as character no-undo initial 'Список истории изменения градуировочной таблицы по резервуару на объекте':U.
      960   define variable filter-point0    as character no-undo initial 'Список истории изменения градуировочной таблицы по резервуару на объекте':U.
      961   define variable sort-change-name as character no-undo.
      962   define variable sort-column-name as character no-undo.
      963   define variable sch-field        as character no-undo.
      964   define variable FoundRec         as recid     no-undo.
      965   define variable p-act-codes      as character no-undo initial '99,1,2,3,4,9,51,79':U.
      966   define variable p-act-names      as character no-undo initial 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U.
      967   define variable doc-rec          as recid     no-undo.
      968   define variable p-host-code      as integer   no-undo.
      969   function mark-string returns character ( buffer loc-buf for ub.c-pl-level ) :
      970     define variable v_mark-sign as character no-undo.
      971     run get-mark-string in this-procedure ( buffer loc-buf, output v_mark-sign ).
      972     return ( v_mark-sign ).
      973   end function.
      974   function ShowAction returns character ( input i-act as integer ) :
      975     define variable v_act as character no-undo.
      976     run get-action-name in this-procedure ( input i-act, output v_act ).
      977     return ( v_act ).
      978   end function.
      979   function obj-short returns character ( input i-type as character, input i-code as integer ) :
      980     define variable v_obj-name as character no-undo.
      981     run get-obj-short-name in this-procedure ( input i-type, input i-code, output v_obj-name ).
      982     return ( v_obj-name ).
      983   end function.
      984   function obj-name returns character ( input i-type as character, input i-code as integer ) :
      985     define variable v_obj-name as character no-undo.
      986     run get-obj-full-name in this-procedure ( input i-type, input i-code, output v_obj-name ).
      987     return ( v_obj-name ).
      988   end function.
      989   function place-name returns character ( buffer loc-buf for ub.c-pl-level ) :
      990     define variable v_name as character no-undo.
      991     run get-place-name in this-procedure ( buffer loc-buf, output v_name ) no-error.
      992     return ( if error-status :error or v_name = ? then "":U else v_name ).
      993   end function.
      994   function place-loc1 returns character ( buffer loc-buf for ub.c-pl-level ) :
      995     define variable v_loc1 as character no-undo.
      996     run get-place-loc1 in this-procedure ( buffer loc-buf, output v_loc1 ) no-error.
      997     return ( if error-status :error or v_loc1 = ? then "":U else v_loc1 ).
      998   end function.
      999   define button b-help   label "Помо&щь"   size-chars 10.00 by 1.00 default.
     1000   define button b-mark   label "&*"        size-chars  3.00 by 1.00 default.
     1001   define button   b-exit    label "Вы&ход"    size-chars 10.00 by 1.00 default auto-end-key.
     1002   define button b-lkp   label "&Просмотр" size-chars 10.00 by 1.00 default.
     1003   define button b-sch label "&Фильтр"   size-chars 10.00 by 1.00 default.
     1004   define button b-sel label "Вы&бор"    size-chars 10.00 by 1.00 default auto-go.
     1005   define variable mark-num as integer no-undo view-as fill-in size-chars  8.00 by 1.00 format "->>>,>>>":U.
     1006   define variable sch-plc  as integer no-undo view-as fill-in size-chars 10.50 by 1.00 format ">>>>>>>>>":U.
     1007   define variable sch-num  as integer no-undo view-as fill-in size-chars  5.00 by 1.00 format ">>>":U.
     1008   define query br-pl-levels for buf_c-pl-level scrolling.
     1009   define query br-changes for buf_changes scrolling.
     1010   define browse br-pl-levels query br-pl-levels display
     1011     mark-string( buffer buf_c-pl-level )  column-label '*'  format 'x(1)':U
     1012     obj-short( buf_c-pl-level.obj-type, buf_c-pl-level.obj-code )  column-label 'Объект'  format "x(13)":U
     1013     obj-name(  buf_c-pl-level.obj-type, buf_c-pl-level.obj-code )  column-label 'Наименование объекта'  format "x(40)":U
     1014     buf_c-pl-level.pl-code  column-label 'Резервуар'  format ">>>>>>>>9":U
     1015     place-name( buffer buf_c-pl-level )  column-label 'Название'  format "x(40)":U
     1016     place-loc1( buffer buf_c-pl-level )  column-label 'Код'  format "x(8)":U
     1017     buf_c-pl-level.pl-level  column-label 'Уровень, мм'  format ">,>>>,>>9":U
     1018     buf_c-pl-level.pl-qnty  column-label 'Объем, л'  format "->,>>>,>>9.999":U
     1019     buf_c-pl-level.corr-user-name  column-label 'Изменил'  format "x(8)":U
     1020     buf_c-pl-level.corr-date column-label 'Дата корр.' format "99/99/9999":U
     1021     STRING( buf_c-pl-level.corr-time, 'HH:MM:SS':U ) column-label 'Время' format "x(8)":U
     1022     buf_c-pl-level.chip-num column-label 'Щепка' format "->,>>>,>>>,>>9":U
     1023     buf_c-pl-level.corr-user-db-num column-label 'БД' format ">>>>9":U
     1024     enable
     1025     buf_c-pl-level.pl-qnty
     1026   with no-row-markers separators size-chars 98.25 by 9.38.
     1027   define browse br-changes query br-changes display
     1028     buf_changes.l_name  column-label 'Изменилось'  format 'x(15)':U
     1029     buf_changes.v_old  column-label 'Было'  format 'x(48)':U
     1030     buf_changes.v_new  column-label 'Стало'  format 'x(48)':U
     1031     enable
     1032     buf_changes.l_name
     1033   with no-row-markers separators size-chars 98.25 by 9.38.
     1034   define rectangle r-rect-0 edge-pixels  3 graphic-edge no-fill size-chars 98.25 by 1.50.
     1035   define rectangle r-rect-1 edge-pixels 18 graphic-edge no-fill size-chars 98.25 by 1.50.
     1036   define frame fr-D-pl-level-0
     1037       r-rect-0     at row  1.25 col  1.50
     1038       b-exit     at row  1.50 col  2.50
     1039     b-mark    at row  1.50 col 12.50
     1040       mark-num     at row  1.50 col 15.75 no-label                              fgcolor 4
     1041     b-sel  at row  1.50 col 24.00
     1042     b-lkp    at row  1.50 col 44.75
     1043     b-sch  at row  1.50 col 68.50
     1044     b-help    at row  1.50 col 88.75
     1045     br-pl-levels at row  3.00 col  1.50
     1046       r-rect-1     at row 12.50 col  1.50
     1047     "          ":U at row 12.75 col  1.62 view-as text size-chars 98.00 by 1.00
     1048     "ПОИСК ПО:"    at row 12.75 col  2.00 view-as text size-chars  9.00 by 1.00 bgcolor 3 fgcolor 15
     1049     sch-plc        at row 12.75 col 11.50    label "&Резервуару"
     1050     sch-num        at row 12.75 col 94.25 no-label                              fgcolor 4
     1051       br-changes   at row 14.25 col  1.50
     1052   with view-as dialog-box keep-tab-order side-labels no-underline three-d scrollable
     1053        title 'Список истории изменения градуировочной таблицы по резервуару на объекте':U
     1054        default-button b-exit cancel-button b-exit.
     1055   assign frame fr-D-pl-level-0 :scrollable = no.
     1056   assign br-pl-levels         :num-locked-columns in frame  fr-D-pl-level-0  = 1
     1057          buf_c-pl-level.pl-qnty :read-only          in browse br-pl-levels = yes
     1058          buf_changes.l_name :read-only          in browse   br-changes   = yes.
     1059   assign b-mark    :tooltip in frame fr-D-pl-level-0 = "Поставить/снять отметку записи"
     1060            b-exit     :tooltip in frame fr-D-pl-level-0 = "Вернуться в окно вызова"
     1061          b-sch  :tooltip in frame fr-D-pl-level-0 = "Установить/снять фильтр"
     1062          b-help    :tooltip in frame fr-D-pl-level-0 = "Интерактивная помощь в формате *.html"
     1063          b-lkp    :tooltip in frame fr-D-pl-level-0 = "Просмотреть текущую запись"
     1064          b-sel  :tooltip in frame fr-D-pl-level-0 = "Выбрать текущую(ие) запись(и)"
     1065          br-pl-levels :tooltip in frame fr-D-pl-level-0 = "Список действий над градуировочной таблицей"
     1066            br-changes   :tooltip in frame fr-D-pl-level-0 = "Список изменений градуировочной таблицы"
     1067            sch-plc      :tooltip in frame fr-D-pl-level-0 = "Код резервуара" + " для поиска. Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>"
     1068            sch-num      :tooltip in frame fr-D-pl-level-0 = "Количество найденных записей"
     1069            mark-num     :tooltip in frame fr-D-pl-level-0 = "Отмеченные записи".
     1070   on delete-character of br-pl-levels in frame fr-D-pl-level-0 do:
     1071     if b-mark :sensitive in frame fr-D-pl-level-0 then do: apply "CHOOSE":U to b-mark in frame fr-D-pl-level-0. end.
     1072   end.
     1073   on insert-mode of br-pl-levels in frame fr-D-pl-level-0 do:
     1074     if           b-mark   :sensitive in frame fr-D-pl-level-0 then do:
     1075       apply "CHOOSE":U to b-mark     in frame fr-D-pl-level-0.
     1076     end. else if b-sel :sensitive in frame fr-D-pl-level-0 then do:
     1077       apply "CHOOSE":U to b-sel   in frame fr-D-pl-level-0.
     1078     end.
     1079   end.
     1080   on choose of b-mark in frame fr-D-pl-level-0 do:
     1081     if available buf_c-pl-level then do:
     1082   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1083   define variable v-str-recid9 as character no-undo .
     1084   define variable v-num-entry9 as integer   no-undo .
     1085   assign
     1086     v-str-recid9 = trim( string( recid( buf_c-pl-level ) , "->>>>>>>>>>>9":U ) )
     1087     v-num-entry9 = lookup( v-str-recid9 , p-rid-list )
     1088   .
     1089   if v-num-entry9 > 0 then do:
     1090     assign
     1091       entry( v-num-entry9, p-rid-list ) = "":U
     1092       p-rid-list = trim( replace( p-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1093     .
     1094   end.
     1095   else do:
     1096     assign
     1097       p-rid-list = p-rid-list + ( if p-rid-list = "":U then "":U else chr(44) ) + v-str-recid9
     1098     .
     1099   end.
     1100       br-pl-levels :refresh( ) in frame fr-D-pl-level-0.
     1101       if last-event :function <> "MOUSE-SELECT-DBLCLICK" then do:
     1102         br-pl-levels :select-next-row( ) in frame fr-D-pl-level-0.
     1103       end.
     1104       apply "VALUE-CHANGED":U to br-pl-levels in frame fr-D-pl-level-0.
     1105       if num-entries( p-rid-list ) = 0 then do: hide                                mark-num   in frame fr-D-pl-level-0. end.
     1106                                        else do: display num-entries( p-rid-list ) @ mark-num with frame fr-D-pl-level-0. end.
     1107     END.
     1108     apply "ENTRY":U to br-pl-levels in frame fr-D-pl-level-0.
     1109   end.
     1110   on choose of b-exit in frame fr-D-pl-level-0 do:
     1111     run gbl/markqwa.p ( input b-mark :sensitive, input p-rid-list ) no-error.
     1112     if error-status :error then do: return no-apply. end.
     1113   end.
     1114   on choose of b-sch in frame fr-D-pl-level-0 do:
     1115     run proc-filter in this-procedure no-error.
     1116     if error-status :error then do: return no-apply. end.
     1117   end.
     1118   on choose of b-sel in frame fr-D-pl-level-0 do:
     1119     if not available buf_c-pl-level then do: return no-apply. end.
     1120     if p-rid-list = "":U or b-mark :sensitive = no then do: assign p-rid-list = string( recid( buf_c-pl-level ) ). end.
     1121   end.
     1122   on choose of b-lkp in frame fr-D-pl-level-0 do:
     1123     define buffer buf_doc for ub.c-pl-level.
     1124   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1125   if lookup(self :type
     1126            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1127            ) = 0
     1128   then do:
     1129     message
     1130       "$Workfile$"
     1131       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1132       "Интерфейсный элемент" self :name  skip
     1133       "Тип" self :type  skip
     1134       "Процедура" this-procedure :file-name skip
     1135       view-as alert-box .
     1136   end.
     1137   else do:
     1138     apply "entry":u to self  .
     1139     if focus :handle <> self :handle  then do:
     1140       return no-apply .
     1141     end.
     1142   end.
     1143     if not available buf_c-pl-level then do:
     1144       message "Неправильно выбрана запись." view-as alert-box error.
     1145       return no-apply.
     1146     end.
     1147     else do:
     1148       assign doc-rec = recid( buf_c-pl-level ).
     1149     end.
     1150     find first buf_doc no-lock where
     1151                buf_doc.obj-type  = buf_c-pl-level.obj-type and
     1152                buf_doc.obj-code  = buf_c-pl-level.obj-code and
     1153                buf_doc.pl-code   = buf_c-pl-level.pl-code  and
     1154                buf_doc.chip-num <> buf_c-pl-level.chip-num and
     1155                recid( buf_doc ) <> recid( buf_c-pl-level ) no-error.
     1156     if not available buf_doc then do:
     1157       message 'Данная запись истории пуста, т.к. соответствует СОЗДАНИЮ записи "ГРАДУИРОВОЧНАЯ ТАБЛИЦА ПО РЕЗЕРВУАРУ".' skip
     1158               'Просмотр невозможен!'
     1159       view-as alert-box.
     1160       return no-apply.
     1161     end.
     1162     run str/cpl-lvla.w ( input 'ПРОСМОТР':U, input-output doc-rec ).
     1163     reposition br-pl-levels to recid doc-rec no-error.
     1164     if error-status :error then do: reposition br-pl-levels to row 1 no-error. end.
     1165     apply "ENTRY":U         to br-pl-levels in frame fr-D-pl-level-0.
     1166     apply "VALUE-CHANGED":U to br-pl-levels in frame fr-D-pl-level-0.
     1167   end.
     1168   on return                of br-pl-levels in frame fr-D-pl-level-0 or
     1169      mouse-select-dblclick of br-pl-levels in frame fr-D-pl-level-0 do:
     1170     if           b-mark   :sensitive in frame fr-D-pl-level-0 then do:
     1171         apply "CHOOSE":U to b-mark   in frame fr-D-pl-level-0.
     1172     end. else IF b-sel :sensitive in frame fr-D-pl-level-0 then do:
     1173         apply "CHOOSE":U to b-sel in frame fr-D-pl-level-0.
     1174     end.
     1175   end.
     1176   on value-changed of br-pl-levels in frame fr-D-pl-level-0 do:
     1177     run proc-view-changes in this-procedure no-error.
     1178   end.
     1179   on entry of sch-plc  in frame fr-D-pl-level-0 do:
     1180     if sch-field <> self :name then do:
     1181       assign sch-num   = 0
     1182              sch-field = self :name
     1183              FoundRec  = ?.
     1184     end.
     1185     display sch-plc with frame fr-D-pl-level-0.
     1186   end.
     1187   on leave of sch-plc  in frame fr-D-pl-level-0 do:
     1188     if lookup( last-event :function, "MOUSE-SELECT-DBLCLICK,RETURN" ) = 0 and last-event :label <> "CTRL-J" then do:
     1189       assign FoundRec  = ?
     1190              sch-field = "":U
     1191              sch-num   = 0.
     1192     end.
     1193     hide sch-num in frame fr-D-pl-level-0.
     1194   end.
     1195   on CTRL-J of sch-plc  in frame fr-D-pl-level-0 do:
     1196     if input frame fr-D-pl-level-0 sch-plc  <> sch-plc  then do:
     1197       assign sch-plc.
     1198       assign FoundRec = ?
     1199              sch-num  = 0.
     1200       hide   sch-num  in frame fr-D-pl-level-0.
     1201     end.
     1202     run proc-find-plc  in this-procedure ( input yes, input sch-plc  ) no-error.
     1203     if error-status :error then do: return no-apply. end.
     1204   end.
     1205   on return of sch-plc  in frame fr-D-pl-level-0 do:
     1206     assign sch-plc.
     1207     assign FoundRec = ?
     1208            sch-num  = 0.
     1209     hide   sch-num  in frame fr-D-pl-level-0.
     1210     run proc-find-plc  in this-procedure ( input no,  input sch-plc  ) no-error.
     1211     if error-status :error then do: return no-apply. end.
     1212   end.
     1213   on mouse-select-dblclick of sch-plc  in frame fr-D-pl-level-0 do:
     1214     if input frame fr-D-pl-level-0 sch-plc  <> sch-plc  then do:
     1215       assign sch-plc.
     1216       assign FoundRec = ?
     1217              sch-num  = 0.
     1218       hide   sch-num  in frame fr-D-pl-level-0.
     1219     end.
     1220     run proc-find-plc  in this-procedure ( input yes, input sch-plc  ) no-error.
     1221     if error-status :error then do: return no-apply. end.
     1222   end.
     1223   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1224   on F1 of frame fr-D-pl-level-0 anywhere do:
     1225     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame fr-D-pl-level-0. END.
     1226     return no-apply.
     1227   end.
     1228   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1229   on INS of frame fr-D-pl-level-0 anywhere do:
     1230     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame fr-D-pl-level-0. END.
     1231     return no-apply.
     1232   end.
     1233   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1234   on F3 of frame fr-D-pl-level-0 anywhere do:
     1235     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame fr-D-pl-level-0. END.
     1236     return no-apply.
     1237   end.
     1238   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1239   on F2 of frame fr-D-pl-level-0 anywhere do:
     1240     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame fr-D-pl-level-0. END.
     1241     return no-apply.
     1242   end.
     1243   if valid-handle( active-window ) and frame fr-D-pl-level-0 :parent = ? then frame fr-D-pl-level-0 :parent = active-window.
     1244   if current-window :window-state = window-minimized then do: current-window :window-state = window-normal. end.
     1245   on window-close of frame fr-D-pl-level-0 do: apply "END-ERROR":U to self. end.
     1246   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1247   on help of frame fr-D-pl-level-0
     1248   do:
     1249     run gbl/app_help.p
     1250       (input this-procedure :file-name
     1251       ,input ''
     1252       ,input ?
     1253       ) no-error.
     1254     if error-status :error then do:
     1255       message
     1256         "Ошибка при вызове помощи"
     1257         error-status :get-message(1)
     1258         view-as alert-box .
     1259     end.
     1260   end.
     1261   run minbtn-set in this-procedure .
     1262   on choose of b-help in frame fr-D-pl-level-0
     1263   do:
     1264     apply "help":u to frame fr-D-pl-level-0 .
     1265   end.
     1266   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1267   procedure minbtn-set :
     1268       do
     1269           on error undo, return error return-value
     1270           :
     1271           define variable ii              as integer       no-undo .
     1272           define variable fh              as widget-handle no-undo .
     1273           define variable hh              as widget-handle no-undo .
     1274           define variable v-h             as handle        extent 4 no-undo .
     1275           define variable v-name-button   as character     no-undo .
     1276           define variable v-help-old-x    as decimal       no-undo .
     1277           define variable v-help-old-y    as decimal       no-undo .
     1278           define variable v-help-old-size as decimal       no-undo .
     1279           define variable v-frame-width   as decimal       no-undo .
     1280           define variable jj              as integer       no-undo .
     1281           do
     1282               on error undo, return error
     1283               :
     1284               assign
     1285                   v-frame-width = frame fr-D-pl-level-0:width - 0.3
     1286                   fh            = frame fr-D-pl-level-0:first-child
     1287                   hh            = fh:first-child
     1288                   ii            = 1
     1289                   .
     1290               do while valid-handle(hh):
     1291                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1292                   do:
     1293                       case lc(hh:name) :
     1294                           when "b-help" then
     1295                               do:
     1296                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1297                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1298                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1299                                   hh:TOOLTIP = "Помощь" .
     1300                                   v-help-old-x = hh:column .
     1301                                   v-help-old-y = hh:row    .
     1302                                   v-help-old-size = hh:width .
     1303                                   hh:width-chars = 2.5 .
     1304                               end.
     1305                           when "b-print" then
     1306                               do:
     1307                                   hh:load-image("cmp/b-print.bmp":u) .
     1308                                   hh:TOOLTIP = "Печать" .
     1309                                   v-h[ii] = hh:handle .
     1310                                   ii = ii + 1 .
     1311                                   hh:width-chars = 3 .
     1312                               end.
     1313                           when "b-history" or
     1314                           when "b-hist" then
     1315                               do:
     1316                                   hh:load-image("cmp/b-hist.bmp":u) .
     1317                                   hh:TOOLTIP = "История" .
     1318                                   v-h[ii] = hh:handle .
     1319                                   ii = ii + 1 .
     1320                                   hh:width-chars = 3 .
     1321                               end.
     1322                           when "b-sch" then
     1323                               do:
     1324                                   hh:load-image("cmp/b-sch.bmp":u) .
     1325                                   hh:TOOLTIP = "Установка Фильтра" .
     1326                                   v-h[ii] = hh:handle .
     1327                                   ii = ii + 1 .
     1328                                   hh:width-chars = 3 .
     1329                               end.
     1330                           when "b-hist-user" then
     1331                               do:
     1332                                   hh:load-image("cmp/b-hist.bmp":u) .
     1333                                   hh:TOOLTIP = "История пользователя" .
     1334                                   ii = ii + 1 .
     1335                               end.
     1336                       end case.
     1337                   end.
     1338                   hh = hh:next-sibling.
     1339               end.
     1340               b-help:column = v-frame-width - b-help:width-chars.
     1341               jj = 0.
     1342               repeat ii = 4 to 1 by -1 :
     1343                   if valid-handle (v-h[ii] ) then
     1344                   do:
     1345                       jj  = jj + 1 .
     1346                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1347                       v-h[ii]:row    = v-help-old-y .
     1348                   end.
     1349               end.
     1350           end.
     1351       end.
     1352   end procedure.
     1353   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1354   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1355   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1356   define variable v-diasize-orig-frame-width     as decimal   no-undo .
