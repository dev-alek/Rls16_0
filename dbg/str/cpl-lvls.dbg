     1655           then do:
     1656             assign
     1657               v-object-handle :row = v-object-handle :row + p-change-value
     1658               no-error .
     1659             if error-status :error
     1660             or error-status :get-message(1) <> ""
     1661             then do:
     1662               undo move_block, retry move_block .
     1663             end.
     1664           end.
     1665         end.
     1666       end.
     1667       else do:
     1668         for each buf_temp-diasize-handle
     1669         on error undo move_block, retry move_block
     1670         :
     1671           assign
     1672             v-object-handle = buf_temp-diasize-handle.handle-value
     1673           .
     1674           if v-object-handle <> v-diasize-resize-button
     1675           then do:
     1676             assign
     1677               v-object-handle :row = v-object-handle :row + p-change-value
