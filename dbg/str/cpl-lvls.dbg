     1379   .
     1380   procedure diasize_change-height :
     1381     define input  parameter p-change-value  as decimal   no-undo .
     1382     define input  parameter p-move-resize   as logical   no-undo .
     1383     define variable v-field-group-handle    as handle    no-undo .
     1384     define variable v-object-handle         as handle    no-undo .
     1385     define variable v-frame-height          as decimal   no-undo .
     1386     define variable v-frame-virtual-height  as decimal   no-undo .
     1387     define variable v-browse-height         as decimal   no-undo .
     1388     define variable v-window-height         as decimal   no-undo .
     1389     define variable v-window-virtual-height as decimal   no-undo .
     1390     define variable v-change-sign           as integer   no-undo .
     1391     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1392     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1393     if p-change-value > 0
     1394     then do:
     1395       if frame fr-D-pl-level-0 :height + p-change-value
     1396           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1397       then do:
     1398         assign
     1399           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1400                           - (frame fr-D-pl-level-0 :height-chars)
     1401         .
     1402         if p-change-value <= 0
     1403         then do:
     1404           run diasize_position-resize-button in this-procedure .
     1405           return .
     1406         end.
     1407       end.
     1408     end.
     1409     if p-change-value < 0
     1410     then do:
     1411       if frame fr-D-pl-level-0 :height + p-change-value < v-diasize-orig-frame-height
     1412       then do:
     1413         assign
     1414           p-change-value = v-diasize-orig-frame-height
     1415                          - (frame fr-D-pl-level-0 :height-chars)
     1416         .
     1417         if p-change-value >= 0
     1418         then do:
     1419           run diasize_position-resize-button in this-procedure .
     1420           return .
     1421         end.
     1422       end.
     1423     end.
     1424     if p-change-value >= 0
     1425     then do:
     1426       assign
     1427         v-change-sign = 1
     1428       .
     1429     end.
     1430     else do:
     1431       assign
     1432         v-change-sign = -1
     1433       .
     1434     end.
     1435     assign
     1436       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1437     .
     1438     if p-change-value = 0
     1439     then do:
     1440       run diasize_position-resize-button in this-procedure .
     1441       return .
     1442     end.
     1443     move_block:
     1444     do
     1445     on error undo move_block, retry move_block
     1446     :
     1447       if retry
     1448       then do:
     1449         do
     1450         on error undo move_block, leave move_block
     1451         :
     1452           if p-change-value > 0
     1453           then do:
     1454             for each buf_temp-diasize-handle
     1455             on error undo, next
     1456             :
     1457               assign
     1458                 v-object-handle = buf_temp-diasize-handle.handle-value
     1459               .
     1460               if v-object-handle <> v-diasize-resize-button
     1461               then do:
     1462                 assign
     1463                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1464                 .
     1465               end.
     1466             end.
     1467             assign
     1468               v-diasize-browse-handle :height = v-browse-height
     1469             .
     1470             for each buf_temp-browse-handle
     1471               where buf_temp-browse-handle.browse-type = 'height':u
     1472             on error undo, next
     1473             :
     1474               assign
     1475                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1476               .
     1477             end.
     1478             assign
     1479               frame fr-D-pl-level-0 :height = v-frame-height
     1480             .
     1481             if frame fr-D-pl-level-0 :scrollable = true
     1482             then do:
     1483               assign
     1484                 frame fr-D-pl-level-0 :virtual-height = v-frame-virtual-height
     1485               .
     1486             end.
     1487             run diasize_position-resize-button in this-procedure .
     1488           end.
     1489           else do:
     1490             if frame fr-D-pl-level-0 :scrollable = true
     1491             then do:
     1492               assign
     1493                 frame fr-D-pl-level-0 :virtual-height = v-frame-virtual-height
     1494               .
     1495             end.
     1496             assign
     1497               frame fr-D-pl-level-0 :height = v-frame-height
     1498             .
     1499             assign
     1500               v-diasize-browse-handle :height = v-browse-height
     1501             .
     1502             for each buf_temp-browse-handle
     1503               where buf_temp-browse-handle.browse-type = 'height':u
     1504             on error undo, next
     1505             :
     1506               assign
     1507                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1508               .
     1509             end.
     1510             for each buf_temp-diasize-handle
     1511             on error undo, next
     1512             :
     1513               assign
     1514                 v-object-handle = buf_temp-diasize-handle.handle-value
     1515               .
     1516               if v-object-handle <> v-diasize-resize-button
     1517               then do:
     1518                 assign
     1519                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1520                 .
     1521               end.
     1522             end.
     1523             run diasize_position-resize-button in this-procedure .
     1524           end.
     1525           assign
     1526             v-diasize-change-size = false
     1527           .
     1528           leave move_block .
     1529         end.
     1530       end.
     1531       assign
     1532         v-diasize-need-full-display = true
     1533       .
     1534       if v-diasize-change-size = false
     1535       then do:
     1536         assign
     1537           v-diasize-change-size = true
     1538         .
     1539       end.
     1540       else do:
     1541         return .
     1542       end.
     1543       assign
     1544         v-frame-height = frame fr-D-pl-level-0 :height
     1545         v-frame-virtual-height = frame fr-D-pl-level-0 :virtual-height
     1546         v-browse-height = v-diasize-browse-handle :height
     1547       .
     1548       for each buf_temp-browse-handle
     1549         where buf_temp-browse-handle.browse-type = 'height':u
     1550       :
     1551         assign
     1552           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1553         .
     1554       end.
     1555       for each buf_temp-diasize-handle
     1556       :
     1557         delete buf_temp-diasize-handle .
     1558       end.
     1559       assign
     1560         v-field-group-handle = frame fr-D-pl-level-0 :first-child
     1561       .
     1562       do while valid-handle(v-field-group-handle)
     1563       :
     1564         assign
     1565           v-object-handle = v-field-group-handle :first-child
     1566         .
     1567         do while valid-handle(v-object-handle)
     1568         :
     1569           if  v-object-handle <> v-diasize-browse-handle :handle
     1570           and can-query(v-object-handle, "row")
     1571           and can-query(v-object-handle, "height")
     1572           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1573           then do:
     1574             find first buf_temp-browse-handle
     1575               where buf_temp-browse-handle.browse-type   = 'height':u
     1576                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1577               no-error .
     1578             if available buf_temp-browse-handle
     1579             then do:
     1580             end.
     1581             else do:
     1582               create buf_temp-diasize-handle .
     1583               assign
     1584                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1585                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1586               .
     1587             end.
     1588           end.
     1589           assign
     1590             v-object-handle = v-object-handle :next-sibling
     1591           .
     1592         end.
     1593         assign
     1594           v-field-group-handle = v-field-group-handle :next-sibling
     1595         .
     1596       end.
     1597       do with frame fr-D-pl-level-0
     1598       :
     1599         hide v-diasize-resize-button .
     1600         assign
     1601           v-diasize-resize-button :row    = 1
     1602           v-diasize-resize-button :column = 1
     1603         .
     1604       end.
     1605       if p-change-value > 0
     1606       then do:
     1607         if frame fr-D-pl-level-0 :scrollable = true
     1608         then do:
     1609           assign
     1610             frame fr-D-pl-level-0 :virtual-height = frame fr-D-pl-level-0 :virtual-height + p-change-value
     1611             no-error .
     1612           if error-status :error
     1613           or error-status :get-message(1) <> ""
     1614           then do:
     1615             undo move_block, retry move_block .
     1616           end.
     1617         end.
     1618         assign
     1619           frame fr-D-pl-level-0 :height = frame fr-D-pl-level-0 :height + p-change-value
     1620           no-error .
     1621         if error-status :error
     1622         or error-status :get-message(1) <> ""
     1623         then do:
     1624           undo move_block, retry move_block .
     1625         end.
     1626         assign
     1627           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1628           no-error .
