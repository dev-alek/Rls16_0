     1984         .
     1985       end.
     1986       do with frame fr-D-pl-level-0
     1987       :
     1988         hide v-diasize-resize-button .
     1989         v-diasize-resize-button :row = 1.
     1990         v-diasize-resize-button :column = 1.
     1991       end.
     1992       if p-change-value > 0
     1993       then do:
     1994         if frame fr-D-pl-level-0 :scrollable = true
     1995         then do:
     1996           assign
     1997             frame fr-D-pl-level-0 :virtual-width = frame fr-D-pl-level-0 :virtual-width + p-change-value
     1998             no-error .
     1999           if error-status :error
     2000           or error-status :get-message(1) <> ""
     2001           then do:
     2002             undo move_block, retry move_block.
     2003           end.
     2004         end.
     2005         assign
     2006           frame fr-D-pl-level-0 :width = v-frame-width + p-change-value
     2007           no-error .
     2008         if error-status :error
     2009         or error-status :get-message(1) <> ""
     2010         then do:
     2011           undo move_block, retry move_block.
     2012         end.
     2013         assign
     2014           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2015         no-error .
     2016         if error-status :error
     2017         or error-status :get-message(1) <> ""
     2018         then do:
     2019           undo move_block, retry move_block.
     2020         end.
     2021         for each buf_temp-browse-handle
     2022           where buf_temp-browse-handle.browse-type = 'width':u
     2023         on error undo move_block, retry move_block
     2024         :
     2025           assign
     2026             buf_temp-browse-handle.browse-handle :width
     2027               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2028             no-error .
     2029           if error-status :error
     2030           or error-status :get-message(1) <> ""
     2031           then do:
     2032             undo move_block, retry move_block .
     2033           end.
     2034         end.
     2035         for each buf_temp-diasize-handle
     2036         on error undo move_block, retry move_block
     2037         :
     2038           assign
     2039             v-object-handle = buf_temp-diasize-handle.handle-value
     2040           .
     2041           if v-object-handle <> v-diasize-resize-button
     2042           then do:
     2043             assign
     2044               v-object-handle :col = v-object-handle :col + p-change-value
     2045               no-error .
     2046             if error-status :error
     2047             or error-status :get-message(1) <> ""
     2048             then do:
     2049               undo move_block, retry move_block .
     2050             end.
     2051           end.
     2052         end.
     2053       end.
     2054       else do:
     2055         for each buf_temp-diasize-handle
     2056         on error undo move_block, retry move_block
     2057         :
     2058           assign
     2059             v-object-handle = buf_temp-diasize-handle.handle-value
     2060           .
     2061           if v-object-handle <> v-diasize-resize-button
     2062           then do:
     2063             assign
     2064               v-object-handle :col = v-object-handle :col + p-change-value
     2065               no-error .
     2066             if error-status :error
     2067             or error-status :get-message(1) <> ""
     2068             then do:
     2069               undo move_block, retry move_block .
     2070             end.
     2071           end.
     2072         end.
     2073         for each buf_temp-browse-handle
     2074           where buf_temp-browse-handle.browse-type = 'width':u
     2075         on error undo move_block, retry move_block
     2076         :
     2077           assign
     2078             buf_temp-browse-handle.browse-handle :width
     2079               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2080             no-error .
     2081           if error-status :error
     2082           or error-status :get-message(1) <> ""
     2083           then do:
     2084             undo move_block, retry move_block .
     2085           end.
     2086         end.
     2087         assign
     2088           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2089           no-error .
     2090         if error-status :error
     2091         or error-status :get-message(1) <> ""
     2092         then do:
     2093           undo move_block, retry move_block.
     2094         end.
     2095         assign
     2096           frame fr-D-pl-level-0 :width = frame fr-D-pl-level-0 :width + p-change-value
     2097         no-error .
     2098         if error-status :error
     2099         or error-status :get-message(1) <> ""
     2100         then do:
     2101           undo move_block, retry move_block.
     2102         end.
     2103         if frame fr-D-pl-level-0 :scrollable = true
     2104         then do:
     2105           assign
     2106             frame fr-D-pl-level-0 :virtual-width = frame fr-D-pl-level-0 :virtual-width + p-change-value
     2107           no-error .
     2108           if error-status :error
     2109           or error-status :get-message(1) <> ""
     2110           then do:
     2111             undo move_block, retry move_block.
     2112           end.
     2113         end.
     2114       end.
     2115       if p-move-resize
     2116       then do:
     2117         run diasize_position-resize-button in this-procedure .
     2118       end.
     2119       if v-diasize-wndstore = true
     2120       then do:
     2121         if connected("ub") = true
     2122         then do:
     2123           define variable v-cntxt-db-num        as integer   no-undo .
     2124           define variable v-cntxt-userid        as character no-undo .
     2125           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2126                                             , OUTPUT v-cntxt-userid
     2127                                             ) .
     2128           run gbl/wndsizew.p
     2129             (input  v-cntxt-db-num
     2130             ,input  v-cntxt-userid
     2131             ,input  v-diasize-proc-name
     2132             ,input  'width':u
     2133             ,input  string(frame fr-D-pl-level-0 :width - v-diasize-orig-frame-width)
     2134             ) .
     2135         end.
     2136       end.
     2137     end.
     2138     assign
     2139       v-diasize-change-size = false
     2140     .
     2141   end procedure.
     2142   procedure diasize_set-width :
     2143     define input  parameter p-new-width  as decimal   no-undo .
     2144     define input  parameter p-move-resize as logical   no-undo .
     2145     do
     2146     on error undo, return error return-value
     2147     :
     2148       run diasize_change-width in this-procedure
     2149         (input  (p-new-width - frame fr-D-pl-level-0 :width)
     2150         ,input  p-move-resize
     2151         ) .
     2152     end.
     2153   end procedure.
     2154   procedure diasize_position-resize-button :
     2155     do with frame fr-D-pl-level-0
     2156     :
     2157       hide v-diasize-resize-button .
     2158       assign
     2159         v-diasize-resize-button :row = frame fr-D-pl-level-0 :height - v-diasize-resize-button :height
     2160                     - 1
     2161                     - (frame fr-D-pl-level-0 :border-bottom-pixels / session :pixels-per-row)
     2162         v-diasize-resize-button :col = frame fr-D-pl-level-0 :width - v-diasize-resize-button :width
     2163                     - 1
     2164                     - (frame fr-D-pl-level-0 :border-right-pixels / session :pixels-per-column)
     2165       .
     2166       view v-diasize-resize-button .
     2167     end.
     2168   end procedure.
     2169   on alt-right anywhere
     2170   do:
     2171     run diasize_change-width in this-procedure
     2172       (input 1
     2173       ,input true
     2174       ) .
     2175     return no-apply .
     2176   end.
     2177   on alt-left anywhere
     2178   do:
     2179     run diasize_change-width in this-procedure
     2180       (input -1
     2181       ,input true
     2182       ) .
     2183     return no-apply .
     2184   end.
     2185   on alt-down anywhere
     2186   do:
     2187     run diasize_change-height in this-procedure
     2188       (input 1
     2189       ,input true
     2190       ) .
     2191     return no-apply .
     2192   end.
     2193   on alt-up anywhere
     2194   do:
     2195     run diasize_change-height in this-procedure
     2196       (input -1
     2197       ,input true
     2198       ) .
     2199     return no-apply .
     2200   end.
     2201   on alt-enter of frame fr-D-pl-level-0
     2202   do:
     2203     run diasize_maximize in this-procedure
     2204       (input  ?
     2205       ).
     2206     return no-apply .
     2207   end.
     2208   procedure diasize_end-move :
     2209     do
     2210     on error undo, return error return-value
     2211     :
     2212       define variable v-row-delta as decimal   no-undo .
     2213       define variable v-col-delta as decimal   no-undo .
     2214       define variable v-new-row as decimal   no-undo .
     2215       define variable v-new-col as decimal   no-undo .
     2216       assign
     2217         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2218         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2219       .
     2220       assign
     2221         v-row-delta = v-new-row - frame fr-D-pl-level-0 :height
     2222         v-col-delta = v-new-col - frame fr-D-pl-level-0 :width
     2223       .
     2224       run diasize_change-height in this-procedure
     2225         (input v-row-delta
     2226         ,input true
     2227         ) .
     2228       run diasize_change-width in this-procedure
     2229         (input v-col-delta
     2230         ,input true
     2231         ) .
     2232     end.
     2233   end procedure.
     2234   procedure diasize_maximize :
     2235     define input  parameter p-action as logical   no-undo .
     2236     do
     2237     on error undo, return error return-value
     2238     :
     2239       if p-action = ?
     2240       then do:
     2241         if v-diasize-need-maximize = true
     2242         then do:
     2243           assign
     2244             p-action = true
     2245           .
     2246         end.
     2247         else do:
     2248           assign
     2249             p-action = false
     2250           .
     2251         end.
     2252       end.
     2253       if p-action = true
     2254       then do:
     2255         run diasize_change-height in this-procedure
     2256           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2257               - frame fr-D-pl-level-0 :height-chars
     2258           ,input true
     2259           ) .
     2260         run diasize_change-width in this-procedure
     2261           (input session :width-chars
     2262               - frame fr-D-pl-level-0 :width-chars
     2263           ,input true
     2264           ) .
     2265         assign
     2266           v-diasize-need-maximize = false
     2267         .
     2268       end.
     2269       else do:
     2270         run diasize_change-width in this-procedure
     2271           (input v-diasize-orig-frame-width
     2272               - frame fr-D-pl-level-0 :width-chars
     2273           ,input true
     2274           ) .
     2275         run diasize_change-height in this-procedure
     2276           (input v-diasize-orig-frame-height
     2277               - frame fr-D-pl-level-0 :height-chars
     2278           ,input true
     2279           ) .
     2280         assign
     2281           v-diasize-need-maximize = true
     2282         .
     2283       end.
     2284     end.
     2285   end procedure.
     2286   procedure diasize_restore-orig-size :
     2287     do
     2288     on error undo, return error return-value
     2289     :
     2290       assign
     2291         v-diasize-current-frame-width  = frame fr-D-pl-level-0 :width
     2292         v-diasize-current-frame-height = frame fr-D-pl-level-0 :height
     2293       .
     2294       run diasize_set-height in this-procedure
     2295         (input  v-diasize-orig-frame-height
     2296         ,input  true
     2297         ) .
     2298       run diasize_set-width in this-procedure
     2299         (input  v-diasize-orig-frame-width
     2300         ,input  true
     2301         ) .
     2302     end.
     2303   end procedure.
     2304   procedure diasize_restore-current-size :
     2305     do
     2306     on error undo, return error return-value
     2307     :
     2308       run diasize_set-height in this-procedure
     2309         (input  v-diasize-current-frame-height
     2310         ,input  true
     2311         ) .
     2312       run diasize_set-width in this-procedure
     2313         (input  v-diasize-current-frame-width
     2314         ,input  true
     2315         ) .
     2316     end.
     2317   end procedure.
     2318   procedure diasize_set-browse-handle :
     2319     define input  parameter p-browse-handle as handle   no-undo .
     2320     define buffer buf_temp-browse-handle for temp-browse-handle .
     2321     do
     2322     on error undo, return error return-value
     2323     :
     2324       assign
     2325         v-diasize-browse-handle = p-browse-handle
     2326       .
     2327       for each buf_temp-browse-handle
     2328       on error undo, return error return-value
     2329       :
     2330         delete buf_temp-browse-handle .
     2331       end.
     2332     end.
     2333   end procedure.
     2334   procedure diasize_add_browse :
     2335     define input  parameter p-browse-type   as character no-undo .
     2336     define input  parameter p-browse-handle as handle    no-undo .
     2337     define buffer buf_temp-browse-handle for temp-browse-handle .
     2338     do
     2339     on error undo, return error return-value
     2340     :
     2341       assign
     2342         v-diasize-browse-number = v-diasize-browse-number + 1
     2343       .
     2344       create buf_temp-browse-handle .
     2345       assign
     2346         buf_temp-browse-handle.browse-type   = p-browse-type
     2347         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2348         buf_temp-browse-handle.browse-handle = p-browse-handle
     2349       .
     2350     end.
     2351   end procedure.
     2352   procedure diasize_init :
     2353     define variable v-default-value    as logical   no-undo .
     2354     define variable v-restore-saved    as logical   no-undo .
     2355     define variable v-resize-value-str as character no-undo .
     2356     do
     2357     on error undo, return error return-value
     2358     :
     2359       do with frame fr-D-pl-level-0
     2360       :
     2361         assign
     2362           v-diasize-orig-frame-height = frame fr-D-pl-level-0 :height
     2363           v-diasize-orig-frame-width  = frame fr-D-pl-level-0 :width
     2364           v-diasize-browse-handle     = browse br-pl-levels :handle
     2365         .
     2366         create button v-diasize-resize-button
     2367         assign
     2368           parent        = frame fr-D-pl-level-0 :first-child
     2369           label         = "s"
     2370           height-pixels = 16
     2371           width-pixels  = 16
     2372           visible       = true
     2373           sensitive     = true
     2374           movable       = true
     2375           triggers:
     2376             on end-move persistent run diasize_end-move in this-procedure .
     2377           end triggers.
     2378         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2379         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2380         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2381         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2382         assign
     2383           v-diasize-wndmax = false
     2384         .
     2385         if connected("ub") = true
     2386         then do:
     2387           define variable v-cntxt-db-num        as integer   no-undo .
     2388           define variable v-cntxt-userid        as character no-undo .
     2389           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2390                                             , OUTPUT v-cntxt-userid
     2391                                             ) .
     2392           run gbl/wndpar_r.p
     2393             (input  v-cntxt-db-num
     2394             ,input  v-cntxt-userid
     2395             ,input  'wndmax':U
     2396             ,output v-diasize-wndmax
     2397             ,output v-default-value
     2398             ) .
     2399         end.
     2400         assign
     2401           v-diasize-wndstore = false
     2402         .
     2403         if connected("ub") = true
     2404         then do:
     2405           run gbl/wndpar_r.p
     2406             (input  v-cntxt-db-num
     2407             ,input  v-cntxt-userid
     2408             ,input  'wndstore':U
     2409             ,output v-diasize-wndstore
     2410             ,output v-default-value
     2411             ) .
     2412         end.
     2413         assign
     2414           v-diasize-proc-name = entry(1, program-name(2), '.')
     2415         .
     2416         if v-diasize-wndstore = true
     2417         then do:
     2418           assign
     2419             v-restore-saved = false
     2420           .
     2421           if connected("ub") = true
     2422           then do:
     2423             run gbl/wndsizer.p
     2424               (input  v-cntxt-db-num
     2425               ,input  v-cntxt-userid
     2426               ,input  v-diasize-proc-name
     2427               ,input  'height':u
     2428               ,output v-resize-value-str
     2429               ) .
     2430             if v-resize-value-str <> '':U
     2431             then do:
     2432               run diasize_change-height in this-procedure
     2433                 (input  integer(v-resize-value-str)
     2434                 ,input  true
     2435                 ) .
     2436               assign
     2437                 v-restore-saved = true
     2438               .
     2439             end.
     2440           end.
     2441           if connected("ub") = true
     2442           then do:
     2443             run gbl/wndsizer.p
     2444               (input  v-cntxt-db-num
     2445               ,input  v-cntxt-userid
     2446               ,input  v-diasize-proc-name
     2447               ,input  'width':u
     2448               ,output v-resize-value-str
     2449               ) .
     2450             if v-resize-value-str <> '':U
     2451             then do:
     2452               run diasize_change-width in this-procedure
     2453                 (input  integer(v-resize-value-str)
     2454                 ,input  true
     2455                 ) .
     2456               assign
     2457                 v-restore-saved = true
     2458               .
     2459             end.
     2460           end.
     2461           if v-restore-saved <> true
     2462           then do:
     2463             if v-diasize-wndmax = true
     2464             then do:
     2465               run diasize_maximize in this-procedure
     2466                 (input  true
     2467                 ) .
     2468             end.
     2469           end.
     2470         end.
     2471         else do:
     2472           if v-diasize-wndmax = true
     2473           then do:
     2474             run diasize_maximize in this-procedure
     2475               (input  true
     2476               ) .
     2477           end.
     2478         end.
     2479       end.
     2480     end.
     2481   end procedure.
     2482   procedure diasize_need-full-display :
     2483     define output parameter p-need-full-display as logical   no-undo .
     2484     do
     2485     on error undo, return error return-value
     2486     :
     2487       assign
     2488         p-need-full-display = v-diasize-need-full-display
     2489       .
     2490       assign
     2491         v-diasize-need-full-display = false
     2492       .
     2493     end.
     2494   end procedure.
     2495   procedure get-context :
     2496      define output parameter p-db-num as integer          no-undo.
     2497      define output parameter p-user-id as character        no-undo.
     2498      define variable v-login               as character    no-undo.
     2499      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2500      define buffer buf_user-login  for ub.user-login .
     2501      do
     2502      on error undo, return error
     2503      :
     2504            FIND FIRST buf_sys-ctrl no-lock.
     2505            ASSIGN
     2506               v-login = USERID("ub")
     2507               p-db-num = buf_sys-ctrl.db-num
     2508            .
     2509            FIND FIRST buf_user-login
     2510                 WHERE buf_user-login.db-num = p-db-num
     2511                   AND buf_user-login.user-login = v-login
     2512                 no-lock
     2513                 no-error
     2514                 .
     2515            IF AVAILABLE buf_user-login
     2516            THEN DO:
     2517               assign
     2518                  p-user-id = buf_user-login.user-id
     2519               .
     2520            END.
     2521      end.
     2522   end procedure.
     2523       run diasize_init in this-procedure .
     2524   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2525   DEF VAR cur-clmn-numbr-pl-levels as INT EXTENT 13 no-undo.
     2526   DEF VAR varmvibr-pl-levels       as INT no-undo.
     2527   DEF VAR varmvjbr-pl-levels       as INT no-undo.
     2528   DEF VAR varmvkbr-pl-levels       as INT no-undo.
     2529   DEF VAR varmvlbr-pl-levels       as INT no-undo.
     2530   DEF VAR move-elementbr-pl-levels as INT no-undo.
     2531   def var jjbr-pl-levels           as int no-undo.
     2532   do varmvibr-pl-levels = 1 to EXTENT(cur-clmn-numbr-pl-levels):
     2533     ASSIGN cur-clmn-numbr-pl-levels[varmvibr-pl-levels] = varmvibr-pl-levels.
     2534   END.
     2535   RUN start-mv-clmnbr-pl-levels.
     2536   PROCEDURE start-mv-clmnbr-pl-levels:
     2537   def var old-session as logical no-undo.
     2538      old-session = SESSION:IMMEDIATE-DISPLAY.
     2539      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2540      SESSION:IMMEDIATE-DISPLAY = old-session.
     2541   END.
     2542   ON ctrl-cursor-right OF BROWSE br-pl-levels do:
     2543     RUN re-move-clmnbr-pl-levels ( 2, 13).
     2544   END.
     2545   ON ctrl-cursor-left OF BROWSE br-pl-levels do:
     2546     RUN re-move-clmnbr-pl-levels (13, 2).
     2547   END.
     2548   PROCEDURE re-move-clmnbr-pl-levels:
     2549     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2550     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2551     DO varmvibr-pl-levels = 1 TO EXTENT(cur-clmn-numbr-pl-levels):
     2552       if cur-clmn-numbr-pl-levels[varmvibr-pl-levels] = source-column THEN cur-clmn-numbr-pl-levels[varmvibr-pl-levels] = -1.
     2553     END.
     2554     if br-pl-levels:MOVE-COLUMN(source-column, target-column) IN FRAME fr-D-pl-level-0 then.
     2555     if source-column > target-column THEN
     2556     DO varmvjbr-pl-levels = source-column - 1 to target-column BY -1:
     2557       DO varmvibr-pl-levels = 1 TO EXTENT(cur-clmn-numbr-pl-levels):
     2558           if cur-clmn-numbr-pl-levels[varmvibr-pl-levels] = varmvjbr-pl-levels THEN DO:
     2559             cur-clmn-numbr-pl-levels[varmvibr-pl-levels] = cur-clmn-numbr-pl-levels[varmvibr-pl-levels] + 1.
     2560           END.
     2561       END.
     2562     END.
     2563     ELSE
     2564     DO varmvjbr-pl-levels = source-column + 1 to target-column:
     2565       DO varmvibr-pl-levels = 1 TO EXTENT(cur-clmn-numbr-pl-levels):
     2566         if cur-clmn-numbr-pl-levels[varmvibr-pl-levels] = varmvjbr-pl-levels THEN DO:
     2567           cur-clmn-numbr-pl-levels[varmvibr-pl-levels] = cur-clmn-numbr-pl-levels[varmvibr-pl-levels] - 1.
     2568         END.
     2569       END.
     2570     END.
     2571     DO varmvibr-pl-levels = 1 TO EXTENT(cur-clmn-numbr-pl-levels):
     2572       if cur-clmn-numbr-pl-levels[varmvibr-pl-levels] = -1 THEN cur-clmn-numbr-pl-levels[varmvibr-pl-levels] = target-column.
     2573     END.
     2574   END PROCEDURE.
     2575   PROCEDURE ch-clmnbr-pl-levels:
     2576     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2577     if cur-clmn-loc <= 2 then do:
     2578       return .
     2579     end.
     2580     DO varmvibr-pl-levels = 1 TO EXTENT(cur-clmn-numbr-pl-levels):
     2581       if cur-clmn-numbr-pl-levels[varmvibr-pl-levels] = cur-clmn-loc THEN move-elementbr-pl-levels = varmvibr-pl-levels.
     2582     END.
     2583     RUN re-move-clmnbr-pl-levels (cur-clmn-loc, 2).
     2584   END PROCEDURE.
     2585   PROCEDURE mv-brw-defaultbr-pl-levels:
     2586   def var old-session as logical no-undo.
     2587     old-session = SESSION:IMMEDIATE-DISPLAY.
     2588     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2589     do varmvlbr-pl-levels = 2 to EXTENT(cur-clmn-numbr-pl-levels):
     2590       RUN re-move-clmnbr-pl-levels (cur-clmn-numbr-pl-levels[varmvlbr-pl-levels], varmvlbr-pl-levels).
     2591     END.
     2592     RUN start-mv-clmnbr-pl-levels.
     2593     SESSION:IMMEDIATE-DISPLAY = old-session.
     2594   END PROCEDURE.
     2595   .
     2596   def var sort-labelbr-pl-levels   as character no-undo .
     2597   def var sort-clmnbr-pl-levels    as handle    no-undo .
     2598   def var cur-clmnbr-pl-levels     as handle    no-undo .
     2599   def var cur-clmn-locbr-pl-levels as integer   no-undo .
     2600   def var re-querybr-pl-levels     as logical   initial no no-undo .
     2601   on start-search, ctrl-o of br-pl-levels in frame fr-D-pl-level-0 do:
     2602      run sort-brbr-pl-levels
     2603        (input (if available buf_c-pl-level
     2604                then recid(buf_c-pl-level)
     2605                else ?
     2606               )
     2607        ).
     2608   end.
     2609   PROCEDURE sort-brbr-pl-levels :
     2610     define input parameter p-recid as recid no-undo .
     2611     if re-querybr-pl-levels = no then do:
     2612       assign
     2613          cur-clmnbr-pl-levels = br-pl-levels:current-column in frame fr-D-pl-level-0
     2614       .
     2615       if sort-clmnbr-pl-levels <> ? then sort-clmnbr-pl-levels:column-fgcolor = 0.
     2616       if cur-clmnbr-pl-levels = sort-clmnbr-pl-levels then do:
     2617         assign
     2618            sort-labelbr-pl-levels = ""
     2619            sort-clmnbr-pl-levels = ?
     2620         .
     2621        end.
     2622        else do:
     2623          assign
     2624            sort-labelbr-pl-levels = cur-clmnbr-pl-levels:label
     2625            sort-clmnbr-pl-levels  = cur-clmnbr-pl-levels
     2626            sort-clmnbr-pl-levels:column-fgcolor = 4
     2627          .
     2628        end.
     2629      end.
     2630     assign
     2631       cur-clmn-locbr-pl-levels = 1
     2632     .
     2633     def var column-handle as handle no-undo .
     2634     column-handle = br-pl-levels:first-column.
     2635     do while valid-handle(column-handle) :
     2636       if column-handle = cur-clmnbr-pl-levels then do:
     2637         leave .
     2638       end.
     2639       column-handle = column-handle:NEXT-COLUMN.
     2640       assign
     2641         cur-clmn-locbr-pl-levels = cur-clmn-locbr-pl-levels + 1
     2642       .
     2643     end.
     2644     case sort-labelbr-pl-levels:
     2645           when 'Объект'  then DO:    assign       sort-column-name = "obj-short( buf_c-pl-level.obj-type, buf_c-pl-level.obj-code )"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2646           when 'Наименование объекта'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1obj-name&1, buf_c-pl-level.obj-type, buf_c-pl-level.obj-code)', chr(34))     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2647           when 'Резервуар'  then DO:    assign       sort-column-name = "buf_c-pl-level.pl-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2648           when 'Уровень, мм'  then DO:    assign       sort-column-name = "buf_c-pl-level.pl-level"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2649           when 'Объем, л'  then DO:    assign       sort-column-name = "buf_c-pl-level.pl-qnty"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2650           when 'Изменил'  then DO:    assign       sort-column-name = "buf_c-pl-level.corr-user-name"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2651           when 'Дата корр.'  then DO:    assign       sort-column-name = "buf_c-pl-level.corr-date"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2652           when 'Время'  then DO:    assign       sort-column-name = "STRING( buf_c-pl-level.corr-time, 'HH:MM:SS':U )"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2653           when 'Щепка'  then DO:    assign       sort-column-name = "buf_c-pl-level.chip-num"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2654           when 'БД'  then DO:    assign       sort-column-name = "buf_c-pl-level.corr-user-db-num"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2655       otherwise do:
     2656         assign
     2657           sort-column-name = ""
     2658         .
     2659         run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2660           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-pl-levels') then do:
     2661             run mv-brw-defaultbr-pl-levels.
     2662           end.
     2663         if sort-labelbr-pl-levels <> "" then do:
     2664           assign
     2665             cur-clmnbr-pl-levels:column-fgcolor = 0
     2666           .
     2667         end.
     2668         assign
     2669           cur-clmn-locbr-pl-levels = ?
     2670         .
     2671       end.
     2672     end case.
     2673     if p-recid <> ? then do:
     2674       reposition br-pl-levels to recid p-recid no-error.
     2675       apply "value-changed" to br-pl-levels in frame fr-D-pl-level-0.
     2676     end.
     2677     apply "entry" to br-pl-levels in frame fr-D-pl-level-0.
     2678   END PROCEDURE.
     2679   procedure re-open-query-srt-clmnbr-pl-levels:
     2680   if cur-clmnbr-pl-levels = ? then do:
     2681      run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2682   end.
     2683   else do:
     2684      assign re-querybr-pl-levels = yes.
     2685      run sort-brbr-pl-levels
     2686        (input (if available buf_c-pl-level
     2687                then recid(buf_c-pl-level)
     2688                else ?
     2689               )
     2690        ).
     2691      assign re-querybr-pl-levels = no.
     2692   end.
     2693   end.
     2694   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2695   DEF VAR cur-clmn-numbr-changes as INT EXTENT 3 no-undo.
     2696   DEF VAR varmvibr-changes       as INT no-undo.
     2697   DEF VAR varmvjbr-changes       as INT no-undo.
     2698   DEF VAR varmvkbr-changes       as INT no-undo.
     2699   DEF VAR varmvlbr-changes       as INT no-undo.
     2700   DEF VAR move-elementbr-changes as INT no-undo.
     2701   def var jjbr-changes           as int no-undo.
     2702   do varmvibr-changes = 1 to EXTENT(cur-clmn-numbr-changes):
     2703     ASSIGN cur-clmn-numbr-changes[varmvibr-changes] = varmvibr-changes.
     2704   END.
     2705   RUN start-mv-clmnbr-changes.
     2706   PROCEDURE start-mv-clmnbr-changes:
     2707   def var old-session as logical no-undo.
     2708      old-session = SESSION:IMMEDIATE-DISPLAY.
     2709      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2710      SESSION:IMMEDIATE-DISPLAY = old-session.
     2711   END.
     2712   ON ctrl-cursor-right OF BROWSE br-changes do:
     2713     RUN re-move-clmnbr-changes ( 1, 3).
     2714   END.
     2715   ON ctrl-cursor-left OF BROWSE br-changes do:
     2716     RUN re-move-clmnbr-changes (3, 1).
     2717   END.
     2718   PROCEDURE re-move-clmnbr-changes:
     2719     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2720     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2721     DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     2722       if cur-clmn-numbr-changes[varmvibr-changes] = source-column THEN cur-clmn-numbr-changes[varmvibr-changes] = -1.
     2723     END.
     2724     if br-changes:MOVE-COLUMN(source-column, target-column) IN FRAME fr-D-pl-level-0 then.
     2725     if source-column > target-column THEN
     2726     DO varmvjbr-changes = source-column - 1 to target-column BY -1:
     2727       DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     2728           if cur-clmn-numbr-changes[varmvibr-changes] = varmvjbr-changes THEN DO:
     2729             cur-clmn-numbr-changes[varmvibr-changes] = cur-clmn-numbr-changes[varmvibr-changes] + 1.
     2730           END.
     2731       END.
     2732     END.
     2733     ELSE
     2734     DO varmvjbr-changes = source-column + 1 to target-column:
     2735       DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     2736         if cur-clmn-numbr-changes[varmvibr-changes] = varmvjbr-changes THEN DO:
     2737           cur-clmn-numbr-changes[varmvibr-changes] = cur-clmn-numbr-changes[varmvibr-changes] - 1.
     2738         END.
     2739       END.
     2740     END.
     2741     DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     2742       if cur-clmn-numbr-changes[varmvibr-changes] = -1 THEN cur-clmn-numbr-changes[varmvibr-changes] = target-column.
     2743     END.
     2744   END PROCEDURE.
     2745   PROCEDURE ch-clmnbr-changes:
     2746     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2747     if cur-clmn-loc <= 1 then do:
     2748       return .
     2749     end.
     2750     DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     2751       if cur-clmn-numbr-changes[varmvibr-changes] = cur-clmn-loc THEN move-elementbr-changes = varmvibr-changes.
     2752     END.
     2753     RUN re-move-clmnbr-changes (cur-clmn-loc, 1).
     2754   END PROCEDURE.
     2755   PROCEDURE mv-brw-defaultbr-changes:
     2756   def var old-session as logical no-undo.
     2757     old-session = SESSION:IMMEDIATE-DISPLAY.
     2758     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2759     do varmvlbr-changes = 1 to EXTENT(cur-clmn-numbr-changes):
     2760       RUN re-move-clmnbr-changes (cur-clmn-numbr-changes[varmvlbr-changes], varmvlbr-changes).
     2761     END.
     2762     RUN start-mv-clmnbr-changes.
     2763     SESSION:IMMEDIATE-DISPLAY = old-session.
     2764   END PROCEDURE.
     2765   .
     2766   Main-Block:
     2767   do on error   undo Main-Block, leave Main-Block
     2768      on end-key undo Main-Block, leave Main-Block :
     2769      p-host-code = v-cntxt-host-code-obj .
     2770     if lookup( p-mode, 'все,obj,pl,one':U ) = 0 then do:
     2771       message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
     2772               "Неверное значение параметра вызова p-mode:" p-mode
     2773       view-as alert-box error.
     2774       return.
     2775     end.
     2776     if p-mode = 'obj':U or
     2777        p-mode = 'one':U then do:
     2778       find first buf_source no-lock where
     2779                  buf_source.obj-type = p-obj-type and
     2780                  buf_source.obj-code = p-obj-code no-error.
     2781       if not available buf_source then do:
     2782         message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
     2783                 'Неверное значение параметров вызова: p-obj-type и p-obj-code - '
     2784                 '"' + p-obj-type + '"' p-obj-code '.'
     2785         view-as alert-box error.
     2786         return.
     2787       end.
     2788     end.
     2789     if p-mode = 'pl':U  or
     2790        p-mode = 'one':U then do:
     2791       find first buf_source no-lock where
     2792                  buf_source.pl-code = p-pl-code no-error.
     2793       if not available buf_source then do:
     2794         message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
     2795                 'Неверное значение параметра вызова p-pl-code:' p-pl-code '.'
     2796         view-as alert-box error.
     2797         return.
     2798       end.
     2799     end.
     2800     if p-mode = 'one':U then do:
     2801       find first buf_source no-lock where
     2802                  buf_source.obj-type = p-obj-type and
     2803                  buf_source.obj-code = p-obj-code and
     2804                  buf_source.pl-code  = p-pl-code  no-error.
     2805       if not available buf_source then do:
     2806         message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
     2807                 'Неверное значение параметров вызова: p-obj-type, p-obj-code и p-pl-code - '
     2808                 '"' + p-obj-type + '"' p-obj-code 'и' p-pl-code '.'
     2809         view-as alert-box error.
     2810         return.
     2811       end.
     2812     end.
     2813     if p-rid-list <> "":U then do:
     2814       find first sch_c-pl-level no-lock where recid( sch_c-pl-level ) = integer( entry( 1, p-rid-list ) ) no-error.
     2815       if not available sch_c-pl-level then do:
     2816         message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
     2817                 'Неверное значение параметра вызова p-rid-list: "' + p-rid-list + '".'
     2818         view-as alert-box error.
     2819         return error.
     2820       end.
     2821       else do:
     2822         assign doc-rec = recid( sch_c-pl-level ).
     2823       end.
     2824     end.
     2825     enable  b-mark   when lookup( "b-mark":U,   p-bttns ) > 0 or p-bttns = "*"
     2826             b-sel when lookup( "b-sel":U, p-bttns ) > 0 or p-bttns = "*"
     2827             b-sch b-help b-exit b-lkp br-pl-levels br-changes sch-plc
     2828     with frame fr-D-pl-level-0.
     2829     run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2830     hide mark-num in frame fr-D-pl-level-0.
     2831     hide  sch-num in frame fr-D-pl-level-0.
     2832     if p-rid-list <> "":U then do: reposition br-pl-levels to recid doc-rec no-error. end.
     2833     br-pl-levels :set-repositioned-row( 5, "CONDITIONAL":U ).
     2834     wait-for go of frame fr-D-pl-level-0.
     2835   end.
     2836   hide frame fr-D-pl-level-0 no-pause.
     2837   procedure OpenBr :
     2838     define input parameter p-open-query     as logical   no-undo.
     2839     define input parameter p-find-next      as logical   no-undo.
     2840     define input parameter p-find-condition as character no-undo.
     2841     define variable l-query-was-opened as logical   no-undo.
     2842     define variable title0             as character no-undo.
     2843     define variable sort-column-phrase as character no-undo.
     2844     define variable p-proc-hand        as handle    no-undo.
     2845     define variable l-open-query       as logical   no-undo.
     2846     assign title0 = "Список истории изменения" + chr(32).
     2847     case sort-column-name :
     2848       when "":U then do: assign sort-column-phrase = "":U. end.
     2849       otherwise      do: assign sort-column-phrase = "by " + sort-column-name. end.
     2850     end case.
     2851     assign filter-point = filter-point0 + " - " + p-mode.
     2852     case p-mode :
     2853       when 'все':U  then do:
     2854           assign frame fr-D-pl-level-0 :title = title0 + "градуировочной таблицы".
     2855   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2856   define variable  l-disable-where-21  as logical   no-undo .
     2857   define variable  l-filter-open-21    as logical   .
     2858   define variable  flt-rec-21       as recid     no-undo .
     2859   define variable  filter-name-21      as character no-undo .
     2860   define variable  where-phrase-21     as character no-undo .
     2861   define variable  sort-phrase-21      as character no-undo .
     2862   define variable  where-phrase-rus-21 as character no-undo .
     2863   define variable  sort-phrase-rus-21  as character no-undo .
     2864     run waitfram-show in this-procedure
     2865       (input "ЖДИТЕ ..."
     2866       ).
     2867   run gbl/flt-get.p
     2868     (input filter-point
     2869     ,output flt-rec-21
     2870     ,output filter-name-21
     2871     ,output where-phrase-21
     2872     ,output sort-phrase-21
     2873     ,output where-phrase-rus-21
     2874     ,output sort-phrase-rus-21
     2875     ).
     2876   if p-open-query then do:
     2877       run set-filter-name in this-procedure
     2878         (INPUT filter-name-21
     2879         ) no-error .
     2880     assign
     2881       l-filter-open-21 = false
     2882     .
     2883     if flt-rec-21 <> ?
     2884       or sort-column-phrase > ""
     2885     then do:
     2886       define variable  parameter-2-21 as character no-undo .
     2887       define variable  parameter-3-21 as character no-undo .
     2888       define variable  parameter-4-21 as character no-undo .
     2889       define variable  parameter-5-21 as character no-undo .
     2890       define variable  parameter-6-21 as character no-undo .
     2891       define variable  parameter-7-21 as character no-undo .
     2892         assign
     2893         parameter-3-21 =
     2894                                 "for each buf_c-pl-level"
     2895         parameter-4-21 =
     2896           (
     2897             if (" yes " + " " + where-phrase-21) <> ""
     2898             then " yes " + " " + where-phrase-21
     2899             else "true"
     2900           )
     2901         parameter-5-21 = (" " + "" + " " + "")
     2902         parameter-6-21 = if sort-phrase-21 = ''
     2903                              then
     2904           (
     2905           " " + "  " +
     2906             " " + sort-column-phrase +
     2907           " " + "  "
     2908           )
     2909                              else
     2910           (
     2911           " " + "  " +
     2912             " " + sort-column-phrase +
     2913           " " + sort-phrase-21
     2914           )
     2915         parameter-7-21 =
     2916           " indexed-reposition  "
     2917       .
     2918       do
     2919       on stop undo, leave
     2920       on error undo, leave
     2921       :
     2922         assign
     2923           l-disable-where-21 =
     2924             (" yes " + " " + where-phrase-21 = "")
     2925         .
     2926         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2927                             ,input query br-pl-levels:handle
     2928                             ,input parameter-3-21
     2929                             ,input parameter-4-21
     2930                             ,input parameter-5-21
     2931                             ,input parameter-6-21
     2932                             ,input parameter-7-21
     2933                             )
     2934         .
     2935         assign
     2936           l-filter-open-21 = true
     2937         .
     2938       end.
     2939       if l-filter-open-21 = false then do:
     2940         message
     2941           "Ошибка при фильтрации / сортировке" skip
     2942           "Будут показаны записи без учета фильтра" skip
     2943           view-as alert-box .
     2944       end.
     2945       else do:
     2946           assign
     2947             l-query-was-opened = true
     2948           .
     2949       end.
     2950     end.
     2951     if l-filter-open-21 = false then do:
     2952       open query br-pl-levels for each buf_c-pl-level
     2953         where  yes
     2954         indexed-reposition
     2955     .
     2956         assign
     2957           l-query-was-opened = true
     2958         .
     2959     end.
     2960   end.
     2961   else do:
     2962     assign
     2963       doc-rec = recid( buf_c-pl-level )
     2964     .
     2965     do
     2966     on stop undo, leave
     2967     on error undo, leave
     2968     :
     2969       if query br-pl-levels:handle:get-buffer-handle(1) = (buffer buf_c-pl-level:handle) then do:
     2970         assign
     2971         parameter-2-21 = (if p-find-next then "true":u else "false":u )
     2972         parameter-4-21 =
     2973           "where ":u + " yes " + " ":u + where-phrase-21 + " ":u + p-find-condition + " " + ""
     2974         parameter-5-21 = "  "
     2975       .
     2976         run fltopend_fltfindd in this-procedure  (
     2977                             input this-procedure:handle
     2978                             ,input query br-pl-levels:handle
     2979                             ,input rowid(buf_c-pl-level)
     2980                             ,input logical(parameter-2-21)
     2981                             ,input no-lock
     2982                             ,input (buffer buf_c-pl-level:handle)
     2983                             ,input parameter-4-21
     2984                             ,input parameter-5-21
     2985                             ) no-error.
     2986         .
     2987         assign
     2988           doc-rec = integer(return-value)
     2989           v-fltopend-rowid[1] = ?
     2990         .
     2991       end.
     2992       else do:
     2993         assign
     2994         parameter-2-21 = (if p-find-next then "true":u else "false":u )
     2995         parameter-3-21 =  "for each buf_c-pl-level"
     2996         parameter-4-21 =
     2997           (
     2998             if (" yes " + " " + where-phrase-21) <> ""
     2999             then " yes " + " " + where-phrase-21
