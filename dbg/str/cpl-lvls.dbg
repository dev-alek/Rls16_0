     1358   define variable v-diasize-current-frame-height as decimal   no-undo .
     1359   define variable v-diasize-change-size          as logical   no-undo .
     1360   define variable v-diasize-resize-button        as handle    no-undo .
     1361   define variable v-diasize-wndmax               as logical   no-undo .
     1362   define variable v-diasize-wndstore             as logical   no-undo .
     1363   define variable v-diasize-proc-name            as character no-undo .
     1364   define variable v-diasize-browse-handle        as handle    no-undo .
