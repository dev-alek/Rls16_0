     1777     define variable v-change-sign          as integer   no-undo .
     1778     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1779     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1780     if p-change-value > 0
     1781     then do:
     1782       if frame fr-D-pl-level-0 :width + p-change-value >
     1783           session :width-chars
     1784       then do:
     1785         assign
     1786           p-change-value = session :width-chars - frame fr-D-pl-level-0 :width
     1787         .
     1788         if p-change-value <= 0
     1789         then do:
     1790           run diasize_position-resize-button in this-procedure .
     1791           return .
     1792         end.
     1793       end.
     1794     end.
     1795     if p-change-value < 0
     1796     then do:
     1797       if frame fr-D-pl-level-0 :width + p-change-value < v-diasize-orig-frame-width
     1798       then do:
     1799         assign
     1800           p-change-value = v-diasize-orig-frame-width
     1801                          - frame fr-D-pl-level-0 :width
     1802         .
     1803         if p-change-value >= 0
     1804         then do:
     1805           run diasize_position-resize-button in this-procedure .
     1806           return .
     1807         end.
     1808       end.
     1809     end.
     1810     if p-change-value >= 0
     1811     then do:
     1812       assign
     1813         v-change-sign = 1
     1814       .
     1815     end.
     1816     else do:
     1817       assign
     1818         v-change-sign = -1
     1819       .
     1820     end.
     1821     assign
     1822       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1823     .
     1824     if p-change-value = 0
     1825     then do:
     1826       run diasize_position-resize-button in this-procedure .
     1827       return .
     1828     end.
     1829     move_block:
