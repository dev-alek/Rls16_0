        1   define temp-table tt-no-marking-gds no-undo
        2     field artic as character label "Артикул"
        3     field gds-name as character label "Имя"
        4     field qnty as character label "Кол-во"
        5   .
        6   define input parameter table for tt-no-marking-gds.
        7   define output parameter p-not-accept as logical no-undo.
        8   DEFINE BUTTON Btn_OK AUTO-GO
        9        LABEL "Да"
       10        SIZE 15 BY 1.13
       11        BGCOLOR 8 .
       12   DEFINE BUTTON Btn_Cancel AUTO-GO
       13        LABEL "Нет"
       14        SIZE 15 BY 1.13
       15        BGCOLOR 8 .
       16   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Подтвердите количество немаркированной продукции"
       17        VIEW-AS FILL-IN
       18        SIZE 51 BY 1 NO-UNDO.
       19   DEFINE QUERY BROWSE-2 FOR
       20         tt-no-marking-gds SCROLLING.
       21   DEFINE BROWSE BROWSE-2
       22     QUERY BROWSE-2 NO-LOCK DISPLAY
       23         tt-no-marking-gds.artic FORMAT "X(12)":U
       24         tt-no-marking-gds.gds-name FORMAT "X(60)":U
       25         tt-no-marking-gds.qnty FORMAT "X(8)":U
       26       WITH NO-ROW-MARKERS SEPARATORS SIZE 82.63 BY 12.5 FIT-LAST-COLUMN.
       27   DEFINE FRAME Dialog-Frame
       28        Btn_OK AT ROW 1.25 COL 2.25
       29        Btn_Cancel AT ROW 1.25 COL 18 WIDGET-ID 2
       30        FILL-IN-1 AT ROW 1.29 COL 32 COLON-ALIGNED NO-LABEL WIDGET-ID 4
       31        BROWSE-2 AT ROW 2.63 COL 2.38 WIDGET-ID 200
       32        SPACE(0.61) SKIP(0.32)
       33       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       34            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       35            TITLE "Кол-во немаркированной продукции"
       36            DEFAULT-BUTTON Btn_OK WIDGET-ID 100.
       37   ASSIGN
       38          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       39          FRAME Dialog-Frame:HIDDEN           = TRUE.
       40   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       41   DO:
       42     APPLY "END-ERROR":U TO SELF.
       43   END.
       44   on choose of Btn_Cancel in frame Dialog-Frame
       45   DO:
       46     p-not-accept = true.
       47   END.
       48   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
       49   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
       50   MAIN-BLOCK:
       51   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
       52      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
       53     RUN enable_UI.
       54     WAIT-FOR GO OF FRAME Dialog-Frame.
       55   END.
       56   RUN disable_UI.
       57   PROCEDURE disable_UI :
       58     HIDE FRAME Dialog-Frame.
       59   END PROCEDURE.
       60   PROCEDURE enable_UI :
       61     DISPLAY FILL-IN-1
       62         WITH FRAME Dialog-Frame.
       63     ENABLE Btn_OK Btn_Cancel BROWSE-2
       64         WITH FRAME Dialog-Frame.
       65     VIEW FRAME Dialog-Frame.
       66     OPEN QUERY BROWSE-2 FOR EACH tt-no-marking-gds NO-LOCK INDEXED-REPOSITION.
       67   END PROCEDURE.
