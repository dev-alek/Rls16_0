        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-mode as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: calladdc.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: str/calladdc.p $":U .
        9   define variable vss-description as character no-undo init "Процедура запуска режимов Список допрасходов".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114     define variable v-cntxt-db-num        as integer   no-undo .
      115     define variable v-cntxt-userid        as character no-undo .
      116     define variable v-cntxt-level         as character no-undo .
      117     define variable v-cntxt-host-code-obj as integer   no-undo .
      118     define variable v-cntxt-obj-type      as character no-undo .
      119     define variable v-cntxt-obj-code      as integer   no-undo .
      120     define variable v-cntxt-db-num-obj    as integer   no-undo .
      121     define variable v-cntxt-is-admin      as logical   no-undo .
      122   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123     run mainmenu_getcntxt in parparentproc
      124       (output v-cntxt-db-num
      125       ,output v-cntxt-userid
      126       ,output v-cntxt-level
      127       ,output v-cntxt-host-code-obj
      128       ,output v-cntxt-obj-type
      129       ,output v-cntxt-obj-code
      130       ,output v-cntxt-db-num-obj
      131       ,output v-cntxt-is-admin
      132       ) .
      133   define variable bttns          as character   no-undo .
      134   define variable par-mode       as character   no-undo .
      135   define variable pardoc-rec     as recid no-undo.
      136   define variable par-host-code  like ub.clients.obj-code no-undo.
      137   define variable p-obj-code     like ub.clients.obj-code no-undo.
      138   define variable p-obj-type     like ub.clients.obj-type no-undo.
      139   define variable p-doc-type     as character no-undo .
      140   define variable p-status_      as character no-undo .
      141   define variable p-char         as character no-undo .
      142   define variable rid-list       as character no-undo .
      143   case p-mode :
      144     when "1"  then do:
      145       assign
      146         par-mode      = "status"
      147         p-status_     = 'новый':U
      148         bttns         = "b-add,b-chg,b-del"
      149         par-host-code = v-cntxt-host-code-obj
      150         p-obj-code    = v-cntxt-obj-code
      151         p-obj-type    = v-cntxt-obj-type
      152       .
      153     end.
      154     when "4"  then do:
      155       assign
      156         par-mode      = "status"
      157         p-status_     = 'закрыт':U
      158         bttns         = ""
      159         par-host-code = v-cntxt-host-code-obj
      160         p-obj-code    = v-cntxt-obj-code
      161         p-obj-type    = v-cntxt-obj-type
      162       .
      163     end.
      164     when "2"  then do:
      165       assign
      166         par-mode      = "status"
      167         p-status_     = 'факт':U
      168         bttns         = ""
      169         par-host-code = v-cntxt-host-code-obj
      170         p-obj-code    = v-cntxt-obj-code
      171         p-obj-type    = v-cntxt-obj-type
      172       .
      173     end.
      174     when "3"  then do:
      175       assign
      176         par-mode      = 'объ':U
      177         p-status_     = 'все':U
      178         bttns         = "b-add,b-chg,b-del"
      179         par-host-code = v-cntxt-host-code-obj
      180         p-obj-code    = v-cntxt-obj-code
      181         p-obj-type    = v-cntxt-obj-type
      182       .
      183     end.
      184     when "11"  then do:
      185       assign
      186         par-mode      = "status-firm"
      187         p-status_     = 'новый':U
      188         bttns         = "b-add,b-chg,b-del"
      189         par-host-code = v-cntxt-host-code-obj
      190         p-obj-code    = v-cntxt-obj-code
      191         p-obj-type    = v-cntxt-obj-type
      192       .
      193     end.
      194     when "14"  then do:
      195       assign
      196         par-mode      = "status-firm"
      197         p-status_     = 'закрыт':U
      198         bttns         = ""
      199         par-host-code = v-cntxt-host-code-obj
      200         p-obj-code    = v-cntxt-obj-code
      201         p-obj-type    = v-cntxt-obj-type
      202       .
      203     end.
      204     when "12"  then do:
      205       assign
      206         par-mode      = "status-firm"
      207         p-status_     = 'факт':U
      208         bttns         = ""
      209         par-host-code = v-cntxt-host-code-obj
      210         p-obj-code    = v-cntxt-obj-code
      211         p-obj-type    = v-cntxt-obj-type
      212       .
      213     end.
      214     when "13"  then do:
      215       assign
      216         par-mode      = "firm"
      217         p-status_     = 'все':U
      218         bttns         = "b-add,b-chg,b-del"
      219         par-host-code = v-cntxt-host-code-obj
      220         p-obj-code    = v-cntxt-obj-code
      221         p-obj-type    = v-cntxt-obj-type
      222       .
      223     end.
      224   end case.
      225   run str/add-docs.w (
      226      input ParParentProc
      227     ,input bttns
      228     ,input par-mode
      229     ,input pardoc-rec
      230     ,input par-host-code
      231     ,input p-obj-code
      232     ,input p-obj-type
      233     ,input p-doc-type
      234     ,input p-status_
      235     ,input p-char
      236     ,output  rid-list
      237     ) no-error .
      238     if error-status :error then do:
      239     message
      240       vss-workfile vss-revision vss-description skip
      241       error-status :get-message(1) skip
      242       return-value skip
      243       ""
      244       view-as alert-box error
      245     .
      246     end.
