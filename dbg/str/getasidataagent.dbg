      304   define variable vss-revision1    as character no-undo init "$Revision:$":U .
      305   define variable vss-author1      as character no-undo init "$Author:$":U .
      306   define variable vss-date1        as character no-undo init "$Date:$":U .
      307   define variable vss-workfile1    as character no-undo init "$Workfile:$":U .
      308   define variable vss-archive1     as character no-undo init "$Archive:$":U .
      309   define variable vss-description1 as character no-undo init "Работа С сокетом".
      310   define new global shared variable g#language as character no-undo .
      311   if g#language <> '' and g#language <> 'rus':U then do:
      312     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      313   end.
      314   procedure PutMesAsunc:
      315       define input  parameter Itext as character no-undo.
      316       define variable vflag as logical no-undo.
      317       Publish "WriteLogAsunc" (Itext, yes)  .
      318   end.
      319   procedure PutMesAsuncNoTime:
      320       define input  parameter Itext as character no-undo.
      321       define variable vflag as logical no-undo.
      322       Publish "WriteLogAsunc" (Itext,no)  .
      323   end.
      324   procedure PutStatAsunc:
      325       define input  parameter Itext as character no-undo.
      326       Publish "PutStatAsunc" (Itext,no) .
      327        run
      328       PutMesAsunc (itext).
      329   end.
