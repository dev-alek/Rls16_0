      344   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      345   define variable v-waitfram-action01         as character   no-undo .
      346   define variable v-waitfram-action02         as character   no-undo .
      347   define variable v-waitfram-action03         as character   no-undo .
      348   define variable mWaitFramTextBeg            as character   no-undo.
      349   define variable mWaitFramTextEnd            as character   no-undo.
      350   define variable mWaitFramView               as logical     no-undo.
      351   define variable mWaitProcEvent              as logical     no-undo init yes.
      352   define variable mWaitFramInterval           as integer     no-undo init 1 .
      353   define variable mWaitFramStop               as logical     no-undo.
      354   define variable mWaitFramStopUser           as logical     no-undo.
      355   define variable mWaitFramStopTimeOut        as logical     no-undo.
      356   define variable mWaitFramStartProc          as datetime-tz no-undo.
      357   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      358   define button B-WaitFramStop auto-end-key
      359        label "Стоп"
      360        size 10 by 1 tooltip "Остоновить процесс".
      361   define button B-viewProcInfo
      362        label "Информация"
      363        size 15 by 1 tooltip "Информация о процесс".
      364   define frame waitfram
      365     v-waitfram-action01 format "x(72)" no-label skip
      366     v-waitfram-action02 format "x(72)" no-label skip
      367     v-waitfram-action03 format "x(72)" no-label skip
      368     B-viewProcInfo
      369     B-WaitFramStop at row 4 col 30
      370     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      371     .
      372   define new global shared variable mBatchMode as logical no-undo init ?.
      373   define variable mFramBachModHandle as handle no-undo.
      374   mFramBachModHandle = frame waitfram:handle.
      375   define variable mFameOldVis as logical no-undo.
      376   define variable mVisCUrentVin as logical no-undo.
      377   if session:batch-mode
      378   then
      379      mBatchMode = yes.
      380   if mBatchMode = ? then do:
      381     mVisCUrentVin = current-window:visible.
      382     mFameOldVis = mFramBachModHandle:visible.
      383     mFramBachModHandle:visible  = yes.
      384     mBatchMode = mFramBachModHandle:visible ne yes.
      385     mFramBachModHandle:visible = mFameOldVis.
      386     current-window:visible = mVisCUrentVin.
      387   end.
      388    if  log-manager:logfile-name ne ?
      389     then DO:
      390         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      391         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      392         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      393     end.
      394   on choose of B-WaitFramStop in frame waitfram
      395   do:
      396     mWaitFramStop = yes.
      397     mWaitFramStopUser = yes.
      398   end.
      399   function waitfram-check-timeout returns logical():
      400      define variable vtime as int64 no-undo.
      401      if mWaitFramStopTimeOut
      402      then
      403         return yes.
      404      vtime = ( now - mWaitFramStartProc ) / 1000 .
      405      if     mWaitFramTimeOut ne ?
      406         and mWaitFramTimeOut ne 0
      407         and mWaitFramTimeOut lt vtime
      408      then do:
      409         mWaitFramStopTimeOut = yes.
      410      end.
      411      return mWaitFramStopTimeOut.
      412   end.
      413   procedure waitfram-hide :
      414     if not session:batch-mode
      415     then do
      416     on error undo, return error return-value
      417     :
      418       pause 0 before-hide .
      419       if not mBatchMode then
      420         hide frame waitfram .
      421     if     not mWaitFramView
      422        and mWaitProcEvent
      423     then
      424       process events .
      425     end.
      426   end procedure.
      427   procedure waitfram-show :
      428     define input  parameter p-message as character no-undo .
      429     define variable v-left-margin as integer   no-undo .
      430     if not session:batch-mode
      431     then do
      432     on error undo, return error return-value
      433     :
      434       if length(p-message) <= 70 then do:
      435         assign
      436           v-left-margin = integer((70 - length(p-message)) / 2)
      437         .
      438         assign
      439           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      440         .
      441         assign
      442           v-waitfram-action01 = " "
      443           v-waitfram-action02 = " "
      444                                    + fill(" ", v-left-margin)
      445                                    + p-message
      446           v-waitfram-action03 = " "
      447         .
      448       end.
      449       else do:
      450         define variable vRindex1 as integer no-undo.
      451         define variable vRindex2 as integer no-undo.
      452         vRindex1 = r-index(p-message," ",70).
      453         if vRindex1 = 0
      454         then
      455            vRindex1 = 70.
      456         if length(p-message)  <= vRindex1 + 70 then do:
      457           assign
      458             v-waitfram-action01 = " "
      459             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      460             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      461           .
      462         end.
      463         else do:
      464           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      465           if vRindex2 <= vRindex1
      466           then
      467              vRindex2 = vRindex1 + 70.
      468           assign
      469             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      470             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      471             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      472           .
      473         end.
      474       end.
      475       B-viewProcInfo:visible   in frame waitfram = no.
      476       B-viewProcInfo:sensitive in frame waitfram = no.
      477       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      478       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      479       if  (   mWaitFramView
      480          or  mWaitProcEvent)
      481          and not mBatchMode
      482       then
      483          display
      484             v-waitfram-action01 skip
      485             v-waitfram-action02 skip
      486             v-waitfram-action03 skip
      487          with frame waitfram .
      488       if     mWaitFramView
      489          then do:
      490             if     mWaitFramInterval ne ?
      491                and not mBatchMode
      492             then
      493                wait-for go of frame waitfram pause mWaitFramInterval.
      494          end.
      495          else
      496             if     mWaitProcEvent
      497                and not mBatchMode
      498             then
      499                process events .
      500     end.
      501   end procedure.
      502      procedure waitfram-show-this:
      503         define input  parameter iInterval as int64 no-undo.
      504         define variable vtime as int64 no-undo.
      505         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      506         mWaitFramInterval = iInterval.
      507         run waitfram-show (substitute("&1&2 &3&4" ,
      508                                       mWaitFramTextBeg ,
      509                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      510                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      511                                       mWaitFramTextEnd
      512                                      )
      513                           ).
      514      end.
      515      procedure WaitFramRunPause:
      516         define input  parameter iInterval as dec no-undo.
      517         define variable vStart  as datetime-tz no-undo.
      518         define variable vend    as datetime-tz no-undo.
      519         define variable vint as int64 no-undo.
      520         define variable vOk as logical no-undo.
      521         vStart = now.
      522         vend   = vStart.
      523         publish "WaitFramPause" (iInterval,output vOk).
      524         vend   =  now.
      525         vint = vend - vStart.
      526         vint = iInterval - vint / 1000.
      527         if     not mWaitFramStop
      528            and (   vint > 0
      529                 or (    not vOk
      530                     and iInterval eq ?
      531                     )
      532                 )
      533         then
      534            run waitfram-show-this (iInterval).
      535         vend   =  now.
      536         vint = vend - vStart.
      537         vint = iInterval - vint / 1000.
      538         if     not mWaitFramStop
      539            and vint > 0
      540         then do:
      541            run gbl/pause.p (vint * 1000).
      542         end.
      543         if iInterval ne ?
      544         then
      545            publish "WaitFramStop".
      546         waitfram-check-timeout().
      547      end.
      548      procedure WaitFramWaitFor:
      549         define input  parameter iInterval as dec no-undo.
      550         assign
      551            mWaitFramStartProc   = now
      552            mWaitFramStopUser    = no
      553            mWaitFramStopTimeOut = no
      554         .
      555         block-wait:
      556         do while not mWaitFramStop:
      557            run WaitFramRunPause (iInterval).
      558            if  waitfram-check-timeout()
      559            then do:
      560               leave block-wait.
      561            end.
      562         end.
      563         run waitfram-hide.
      564      end.
      565   procedure waitfram-join :
      566     define input  parameter p-line-1  as character no-undo .
      567     define input  parameter p-line-2  as character no-undo .
      568     define input  parameter p-line-3  as character no-undo .
      569     define output parameter p-message as character no-undo .
      570     do
      571     on error undo, return error return-value
      572     :
      573       assign
      574         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      575                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      576                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      577       .
      578     end.
      579   end procedure.
      580   function waitfram-join-function returns character
      581     (input p-line-1 as character
      582     ,input p-line-2 as character
      583     ,input p-line-3 as character
      584     ).
      585     define variable v-message as character no-undo .
      586     run waitfram-join in this-procedure
      587       (input  p-line-1
      588       ,input  p-line-2
      589       ,input  p-line-3
      590       ,output v-message
      591       ) .
      592     return v-message .
      593   end function .
      594   define variable mHSocket       as handle      no-undo.
      595   define variable mWebRespHead   as longchar    no-undo.
      596   define variable mWebResp       as longchar    no-undo.
      597   define variable mWebRespMptr   as memptr      no-undo.
      598   define variable OerrMsg        as character   no-undo.
      599   define variable mFileLogSocet  as character   no-undo.
      600   define variable mReturnHttp    as logical     no-undo.
      601   define variable mAddTimeOut    as logical     no-undo init yes.
      602   define variable mSocetBegTime  as datetime-tz no-undo.
      603   define variable mSocetEndTime  as dec         no-undo.
      604   define variable mWriteRespFile as character   no-undo.
      605   define variable mTypeResponse  as character   no-undo init "POST".
      606   publish "getSocetLog" (output mFileLogSocet).
      607   if
      608      (   mFileLogSocet eq ""
      609       or mFileLogSocet eq ?)
      610      and session:debug-alert
      611   then
      612      mFileLogSocet = "socet.log".
      613   procedure ConectSocet:
      614      define input  parameter iHost       as character no-undo.
      615      define input  parameter iPort       as character no-undo.
      616      define input  parameter iUrl        as character no-undo.
      617      define input  parameter iPostData   as longchar  no-undo.
      618      define input  parameter iReturnType as character no-undo.
      619      define input  parameter iTimeOut    as decimal   no-undo.
      620      define input  parameter iSilent     as logical   no-undo.
      621      define input  parameter iTextWait   as character no-undo.
      622      mWaitFramTextBeg = iTextWait.
      623      run SendReqSocet (iHost, iPort, iUrl, iPostData, iReturnType, 'getResponse').
      624      if OerrMsg eq ""
      625      then
      626         run waitrespsocet (iTimeOut, iSilent, iTextWait).
      627      mSocetEndTime = (now - mSocetBegTime) / 1000.
      628   end.
      629   procedure SendReqSocet:
      630      define input  parameter iHost            as character no-undo.
      631      define input  parameter iPort            as character no-undo.
      632      define input  parameter iUrl             as character no-undo.
      633      define input  parameter iPostData        as longchar  no-undo.
      634      define input  parameter iReturnType      as character no-undo.
      635      define input  parameter iProcGetResponse as character no-undo.
      636      mSocetBegTime = now.
      637      run writeLogSocet in this-procedure (substitute("Подключаемся к адресу &1 по порту &2",iHost,iPort )).
      638      assign
      639         mWebResp         = ""
      640         mWebResphead     = ""
      641         OerrMsg          = ""
      642         mReturnHttp      = iReturnType eq "xml" or iReturnType eq "http" or iReturnType eq "yes"
      643         iProcGetResponse = "getResponse"  when iProcGetResponse eq ? or iProcGetResponse eq ""
      644      .
      645      define variable vPostData as longchar                       no-undo.
      646      if    iHost eq ""
      647         or iHost eq ?
      648      then do:
      649         oErrMsg = substitute("Не задан host &1 или port &2.", ihost ,iport).
      650         run writeLogSocet in this-procedure (oErrMsg).
      651         return oErrMsg.
      652      end.
      653      run waitfram-show (substitute("Подключаемся к адресу &1 по порту &2",iHost,iPort )).
      654      create socket mHSocket.
      655      mHSocket:connect('-H ' + iHost + ' -S ' + iPort) no-error.
      656      if mHSocket:connected() = false
      657      then do:
      658         run waitfram-hide .
      659         oErrMsg = substitute( "Не удалось установить соединение: &1" , error-status:get-message(1)).
      660         run writeLogSocet in this-procedure (oErrMsg).
      661         delete object mHSocket.
      662         return oErrMsg.
      663      end.
      664      run waitfram-show ("Отправка данных").
      665      mHSocket:set-read-response-procedure(iProcGetResponse).
      666      run PostRequest (
      667       input iUrl,
      668       input iHost + ":" + iPort,
      669       input iPostData
      670       ).
      671       run waitfram-hide .
      672   end.
      673   procedure WaitRespSocet:
      674      define input  parameter iTimeOut   as decimal   no-undo.
      675      define input  parameter iSilent    as logical   no-undo.
      676      define input  parameter iTextWait  as character no-undo.
      677      if    not valid-handle (mHSocket )
      678      then do:
      679         run writeLogSocet in this-procedure (substitute("Потерян объект соединения")).
      680         return "End connected".
      681      end.
      682      if mHSocket:connected() = false
      683      then do:
      684         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной WaitRespSocet")).
      685         oErrMsg = "Not connected".
      686         return oErrMsg.
      687      end.
      688      mWaitFramView = if iSilent ne yes then yes else no.
      689      mWaitFramTextBeg = iTextWait.
      690      mWaitFramTimeOut = iTimeOut.
      691      mWaitFramTextEnd = "".
      692      mWaitFramStop = no.
      693      if mAddTimeOut
      694      then do:
      695         mWaitFramTimeOut = 300.
      696         run writeLogSocet in this-procedure (substitute ("Таймаут увеличен до &1 при уcтановке соодинения",mWaitFramTimeOut)).
      697      end.
      698      run writeLogSocet in this-procedure (substitute("Ожидаем ответ TimeOut &1 сек.",iTimeOut )).
      699      subscribe   to "WaitFramStop" anywhere run-procedure "WaitRespTestStop".
      700      run WaitFramWaitFor(1).
      701      unsubscribe "WaitFramStop".
      702      if mWaitFramStopUser
      703      then do:
      704         OerrMsg = substitute("Операция прервана пользователем." ).
      705         run writeLogSocet in this-procedure (OerrMsg).
      706      end.
      707      else if mWaitFramStopTimeOut
      708      then do:
      709         OerrMsg = substitute("Привышено время ожидания &1 сек. Ответ не получен.",iTimeOut ).
      710         run writeLogSocet in this-procedure (OerrMsg).
      711      end.
      712      run waitfram-hide .
      713      mHSocket:disconnect() no-error.
      714      delete object mHSocket.
      715   end.
      716   procedure WaitRespTestStop:
      717      if mWaitFramStopTimeOut
      718      then
      719         return.
      720      if     (mWebResp ne ""
      721          and mWebResp ne ?)
      722      then do:
      723         mWaitFramStop = yes.
      724         return.
      725      end.
      726      else if mHSocket:connected() = false
      727      then do:
      728         mWaitFramStop = yes.
      729         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной WaitRespTestStop")).
      730         oErrMsg = "Not connected".
      731         return oErrMsg.
      732      end.
      733      wait-for read-response of mHSocket pause 0.001.
      734   end.
      735   procedure PostRequest:
      736      define input parameter iPostUrl  as char.
      737      define input parameter iPostHost as char.
      738      define input parameter iPostData as longchar.
      739      define variable vCRequest      as longchar.
      740      define variable vMRequest       as memptr.
      741      if iPostUrl ne ?
      742      then do:
      743         vCRequest =substitute(
      744         '&5 /&2 HTTP/1.1&1'                                   +
      745         'Host: &4&1'                                           +
      746         'User-Agent: Apache-HttpClient/4.1.1 (java 1.5)&1'    +
      747         'Accept: */*&1' +
      748         'Content-Type: text/xml&1'               +
      749         'Content-Length: &3&1'                                  +
      750         '&1'
      751         ,
      752         chr(13) + chr(10),
      753         iPostUrl,
      754         length(iPostData),
      755         iPostHost,
      756         mTypeResponse) + iPostData.
      757      end.
      758      else
      759         vCRequest = iPostData.
      760      run writeLogSocet in this-procedure (substitute("Отправляем запрос &1.",chr(13) + chr(10) )).
      761      run writeLogSocet in this-procedure (vCRequest).
      762      SET-SIZE(vMRequest)            = 0.
      763      SET-SIZE(vMRequest)            = length(vCRequest) + 1.
      764      SET-BYTE-ORDER(vMRequest)      = big-endian.
      765      PUT-STRING(vMRequest,1)        = vCRequest .
      766      if mHSocket:connected() = false then
      767      do:
      768         run writeLogSocet in this-procedure ("Соединение было разорвано другой стороной getResponse").
      769         oErrMsg = "Not connected".
      770         delete object mHSocket no-error.
      771         return oErrMsg.
      772      end.
      773      mHSocket:write(vMRequest, 1, length(vCRequest)).
      774      run writeLogSocet in this-procedure ("Запрос отправлен.").
      775   end procedure.
      776   function hex-to-int returns integer (
      777     input p-hex-code  as character  ).
      778     define variable v-int-code as integer   no-undo .
      779     define variable v-ind      as integer   no-undo .
      780     define variable v-digit    as integer   no-undo .
      781     define variable v-letter   as character no-undo .
      782     do v-ind = 1 to length(p-hex-code)
      783     :
      784       assign
      785         v-letter = caps(substring(p-hex-code, v-ind, 1))
      786       .
      787       assign
      788         v-digit = index('123456789ABCDEF':u, v-letter)
      789       .
      790       assign
      791         v-int-code = v-int-code * 16 + v-digit
      792       .
      793     end.
      794     return v-int-code .
      795   end function .
      796   procedure getResponse:
      797      define variable vFlagTag     as logical          no-undo init no.
      798      define variable vResponse    as memptr           no-undo.
      799      define variable vCnt         as int64            no-undo.
      800      define variable vMessage     as longchar         no-undo.
      801      define variable v-cont-length as int64 no-undo.
      802      define variable vi           as integer no-undo.
      803      define variable v-hd-line    as character no-undo.
      804      define variable level        as integer no-undo initial 2.
      805      repeat while program-name(level) <> ?:
      806        if program-name(level) = program-name(1) then do:
      807          run writeLogSocet in this-procedure (substitute("Повторный вызов getResponse.")).
      808          return "".
      809        end.
      810        level = level + 1.
      811      end.
      812      if mHSocket:connected() = false then
      813      do:
      814         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной getResponse")).
      815         oErrMsg = "Not connected".
      816         return oErrMsg.
      817      end.
      818      if mAddTimeOut
      819      then do:
      820         mWaitFramTimeOut = 1000.
      821         run writeLogSocet in this-procedure (substitute ("Таймаут увеличен до &1 при получении ответа",mWaitFramTimeOut)).
      822      end.
      823      run writeLogSocet in this-procedure (substitute("Получаем ответ")).
      824      mWaitFramTextEnd = "Получаем ответ".
      825      define variable vWaitProcEvent as logical no-undo.
      826      vWaitProcEvent = mWaitProcEvent.
      827      mWaitProcEvent = no.
      828      run WaitFramRunPause (?).
      829      define variable vByte as int64 no-undo.
      830      define variable vNextMese as int64 no-undo init 100000.
      831      define variable VFlag as logical no-undo init ? .
      832      mWaitFramStop = no.
      833      mWaitFramStopTimeOut = no.
      834      block-wait:
      835      do while mHSocket:get-bytes-available() > 0:
      836         VFlag = no.
      837         define variable vNumByte as integer no-undo.
      838         vNumByte =   mHSocket:get-bytes-available().
      839         if vNumByte > 30000 then vNumByte = 30000.
      840         SET-SIZE(vResponse) = vNumByte + 1.
      841         SET-BYTE-ORDER(vResponse) = big-endian.
      842         mHSocket:read(vResponse,1,vNumByte).
      843         vMessage = vMessage + GET-STRING(vResponse,1).
      844         if  mReturnHTTp
      845         then do:
      846            vCnt = index(vMessage,chr(13) + chr(10) + chr(13) + chr(10)).
      847            if vCnt > 0
      848            then do:
      849               mReturnHttp = no.
      850               mWebResphead = substring (vMessage,1,vCnt).
      851               vMessage     = substring (vMessage,vCnt + 4).
      852               mWebResphead = replace (mWebResphead,";",chr(13) + chr(10)).
      853               do vi = 1 to num-entries(mWebResphead,chr(13) + chr(10)):
      854                  v-hd-line = trim(entry(vi,mWebResphead,chr(13) + chr(10))).
      855                  if  v-hd-line  begins "Content-Length"  then  do:
      856                     v-cont-length = INT(trim(substring(v-hd-line,16,length(v-hd-line)))).
      857                  end.
      858                  else if v-hd-line  begins "Transfer-Encoding"
      859                  then do :
      860                     define variable vChunked as logical no-undo.
      861                     vchunked = index(v-hd-line,"chunked",19) > 0.
      862                  end.
      863               end.
      864            end.
      865         end.
      866         vByte = vByte + vNumByte.
      867         SET-SIZE(vResponse) = 0.
      868         if v-cont-length > 0 and length (vMessage) >= v-cont-length
      869         then
      870            leave block-wait.
      871         if not mHSocket:get-bytes-available() > 0
      872         then do:
      873            VFlag = yes.
      874            run WaitFramRunPause (?).
      875            run gbl/pause.p (1000) .
      876         end.
      877         else if vByte > vNextMese
      878         then do:
      879            vNextMese = vNextMese + 100000.
      880            mWaitFramTextEnd = substitute ("Получаем ответ прочитано &1 байт ",vByte) .
      881            run WaitFramRunPause (?).
      882         end.
      883         if mWaitFramStopTimeOut
      884         then do:
      885            mWebResp = "".
      886            leave block-wait.
      887         end.
      888      end.
      889      if VFlag ne false
      890      then
      891         run writeLogSocet in this-procedure (substitute ("Завершена обработка &1",If VFlag eq  yes then " 0 байт за последнию секунду" else " пустой ответ(((")).
      892      mWaitFramStop = yes.
      893      run writeLogSocet         in this-procedure ("Получен ответ").
      894      run writeLogSocetOnlyText in this-procedure (mWebResphead).
      895      run writeLogSocetOnlyText in this-procedure (substitute("&1&2&1&2",chr(13) , chr(10) )).
      896      run writeLogSocetOnlyText in this-procedure (vMessage).
      897      run writeLogSocetOnlyText in this-procedure (substitute("&1&2",chr(13) , chr(10) )).
      898      mHSocket:disconnect() no-error.
      899      if v-cont-length > 0
      900      then
      901         mWebResp = substring (vMessage,1,v-cont-length).
      902      else if vChunked
      903      then do:
      904         define variable vByteCopy as int64 no-undo init 1.
      905         Block-Copy:
      906         do while length(vMessage) > 0:
      907            vByteCopy = 1.
      908            vCnt = index (vMessage,chr(13) + chr(10)) - 1.
      909            vByteCopy = vByteCopy +  vCnt + 2.
      910            v-cont-length = hex-to-int(string(substring (vMessage,1,vCnt))).
      911            if v-cont-length eq 0
      912            then
      913               leave Block-copy.
      914            mWebResp = mWebResp + substring (vMessage,vByteCopy,  v-cont-length).
      915            vByteCopy = vByteCopy + v-cont-length + 2.
      916            vMessage = substring  (vMessage,vByteCopy).
      917         end.
      918         run writeLogSocet         in this-procedure ("Заголовок").
      919         run writeLogSocetOnlyText in this-procedure (mWebResphead).
      920         run writeLogSocet         in this-procedure ("Тело ответа").
      921         run writeLogSocetOnlyText in this-procedure (mWebResp).
      922        run writeLogSocetOnlyText in this-procedure (substitute("&1&2",chr(13) , chr(10) )).
      923      end.
      924      else
      925         mWebResp = vMessage.
      926      mWaitProcEvent = vWaitProcEvent.
      927      mSocetEndTime = (now - mSocetBegTime) / 1000.
      928      copy-lob mWebResp to mWebRespMptr.
      929      if     mWriteRespFile ne ""
      930         and mWriteRespFile ne ?
      931      then
      932           run gbl/fileapnd.p
      933                ( mWriteRespFile
      934                , mWebResp + chr(13) + chr(10)
      935                ,input 10
      936                ) no-error .
      937   end procedure.
      938   procedure writeLogSocet:
      939      define input  parameter itext as longchar no-undo.
      940      if mFileLogSocet eq "Async"
      941      then
      942         run PutMesAsunc(itext).
      943      else if     mFileLogSocet ne ?
      944              and mFileLogSocet ne ""
      945      then do:
      946         run gbl/fileapnd.p
      947             ( mFileLogSocet
      948             , substitute("&1 &2 ", string(today), string(time, "HH:MM:SS"))
      949             ,input 10
      950             ) no-error .
      951         run writeLogSocetOnlyText(itext).
      952         run gbl/fileapnd.p
      953             ( mFileLogSocet
      954             , substitute(" &1&2", chr(13) , chr(10))
      955             ,input 10
      956             ) no-error .
      957      end.
      958   end.
      959   procedure writeLogSocetOnlyText:
      960      define input  parameter itext as longchar no-undo.
      961      if mFileLogSocet eq "Async"
      962      then
      963         run PutMesAsunc(itext).
      964      else if     mFileLogSocet ne ?
      965              and mFileLogSocet ne ""
      966      then do:
      967         if length(itext) > 32000
      968         then
      969            copy-lob
      970      from object itext
      971      to file mFileLogSocet append
      972      no-error
      973      .
      974         else
      975         run gbl/fileapnd.p
      976             ( mFileLogSocet
      977             , string(itext)
      978             ,input 10
      979             ) no-error .
      980      end.
      981   end.
      982   procedure Disconect:
      983      mHSocket:disconnect() no-error.
      984      delete object mHSocket no-error.
      985   end.
      986   function objExists return character
      987   (input  ifolder as character,
      988    input  iType   as character  ):
      989       define variable vFileType as character no-undo init "D,F".
      990       define variable vi        as integer no-undo.
      991       define variable vtype as character no-undo.
      992       if iType ne ?
      993       then
      994          vFileType = iType.
      995       do vi = 1 to num-entries(vFileType):
      996          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
      997          vtype = file-information:file-type.
      998          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      999             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
     1000             index(vtype , entry(vi,vFileType )) > 0
     1001          then return file-information:full-pathname .
     1002          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
     1003          vtype = file-information:file-type.
     1004          if file-information:file-name <> "" and
     1005             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
     1006             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
     1007             index( vtype, entry(vi,vFileType )) > 0
     1008          then return file-information:full-pathname .
     1009       end.
     1010       return ? .
     1011   end.
     1012   function SearchFile return character
     1013   (input  ifile as character):
     1014      return objExists(ifile,?).
     1015   end.
     1016   function SearchPFile return character
     1017   (input inFile as char):
     1018        define variable oFile       as character no-undo.
     1019        define variable vFileSearch as character no-undo.
     1020        define variable vNumEntry   as integer no-undo.
     1021        if inFile = "" then return ?.
     1022        vNumEntry = num-entries(inFile,".").
     1023        vFileSearch = inFile.
     1024        if    vNumEntry > 0
     1025           and (   entry(vNumEntry,inFile,".") eq "p"
     1026                or entry(vNumEntry,inFile,".") eq "w")
     1027        then do:
     1028           entry(vNumEntry,vFileSearch, ".") = "r".
     1029           oFile = search(vFileSearch ).
     1030           if oFile eq ?
     1031           then
     1032              oFile = search(inFile).
     1033        end.
     1034        else
     1035           oFile = search(vFileSearch).
     1036        return oFile.
     1037     end.
     1038   define stream str-file.
     1039   procedure readfiletxt:
     1040      define input  parameter i_File-Name   as character no-undo.
     1041      define output parameter Otext as longchar no-undo.
     1042      define variable v_string-tmp as character no-undo.
     1043      if searchfile(i_File-Name) eq ?
     1044      then
     1045         return.
     1046      input  stream str-file from  value (i_File-Name)   .
     1047      repeat :
     1048         import stream str-file unformatted v_string-tmp.
     1049         Otext = Otext + v_string-tmp + chr(10).
     1050      end.
     1051      input  stream str-file close.
     1052   end procedure.
     1053   procedure readrevisetxt:
     1054      define input  parameter i_Str         as Longchar no-undo.
     1055      define input  parameter i_StartString as character no-undo.
     1056      define input  parameter i_comment     as character no-undo.
     1057      define variable v_string-tmp          as character no-undo.
     1058      define variable v-bh                  as handle  no-undo .
     1059      define variable v-fh                  as handle  no-undo .
     1060      define variable vi                    as integer no-undo.
     1061      for each tt-place:
     1062         tt-place.is-error       = yes.
     1063      end.
     1064      rpt:
     1065      do vi = 1 to num-entries(i_Str,chr(10)) :
     1066         v_string-tmp = entry(vi, i_Str,chr(10)).
     1067         if index( v_string-tmp, i_comment ) > 0
     1068         then do:
     1069            v_string-tmp = substring( v_string-tmp, 1, index( v_string-tmp, i_comment ) - 1 ).
     1070         end.
     1071         if v_string-tmp = '':U
     1072         then
     1073            next rpt .
     1074         if index( v_string-tmp, i_StartString ) > 0
     1075         then do:
     1076            find first tt-place where tt-place.loc1 = trim( entry( 2, v_string-tmp, '=' ) ) no-error .
     1077            if not available tt-place
     1078            then do :
     1079              create tt-place .
     1080              assign tt-place.loc1 = trim( entry( 2, v_string-tmp, '=' ) )
     1081                     tt-place.locint   = int(tt-place.loc1)
     1082              no-error .
     1083            end.
     1084            assign
     1085                tt-place.t1             = ?
     1086                tt-place.t2             = ?
     1087                tt-place.t3             = ?
     1088                tt-place.level-total    = ?
     1089                tt-place.level-water    = ?
     1090                tt-place.total-vol      = ?
     1091                tt-place.avrg-temp      = ?
     1092                tt-place.density        = ?
     1093                tt-place.mass           = ?
     1094                tt-place.vapor-density  = ?
     1095                tt-place.vapor-pressure = ?
     1096                tt-place.volume_water   = ?
     1097                tt-place.is-error       = no
     1098                tt-place.error-message  = ?
     1099            .
     1100         end.
     1101         else do:
     1102            if not available tt-place
     1103            then
     1104               next rpt .
     1105            find first tt-param where tt-param.strfrfile = trim( entry( 1, v_string-tmp, '=' ) ) no-error.
     1106            if available tt-param
     1107            then do:
     1108               v-bh = buffer tt-place:handle.
     1109               assign
     1110                  v-fh                = v-bh:buffer-field( tt-param.strasi )
     1111                  v-fh:buffer-value() = decimal( trim( entry( 2, v_string-tmp, '=' ) ) )
     1112               no-error.
     1113               if (tt-param.flddb = "temperature"
     1114                or tt-param.flddb = "water-qnty")
     1115               and trim( entry( 2, v_string-tmp, '=' ) ) = "-"
     1116               then do :
     1117                 assign
     1118                    v-fh:buffer-value() = ?
     1119                 no-error.
     1120               end .
     1121            end.
     1122            else do:
     1123               run gbl/fileapnd.p
     1124                     ( 'revis.err'
     1125                     ,
     1126                  if trim( entry( 1, v_string-tmp, '=' ) ) = "ERROR"
     1127                  then
     1128                     substitute("&1 &2  Ошибка: &3 &4", string(today),string(time, "HH:MM:SS"),  trim( entry( 2, v_string-tmp, '=' ) ), chr(13) + chr(10))
     1129                  else
     1130                     substitute("&1 &2  Неизвестный параметр: &3 &4", string(today),string(time, "HH:MM:SS"), trim( entry( 1, v_string-tmp, '=' ) ), chr(13) + chr(10))
     1131                  ,input 10
     1132                ) no-error .
     1133            end.
     1134         end.
     1135      end.
     1136      for each tt-place:
     1137         tt-place.vapor-pressure = tt-place.vapor-pressure / 1000.
     1138      end.
     1139   end procedure.
     1140   procedure get-from-struna :
     1141     define input  parameter i-log-file-name as character no-undo.
     1142     define input  parameter i-obj-code as integer no-undo.
     1143     define variable v-comstring as character no-undo .
     1144     define variable v_File-Name as character no-undo .
     1145     define variable v_command as character no-undo .
     1146     define variable v-comment     as character no-undo.
     1147     define variable v-StartString as character no-undo.
     1148     define variable Vrevis        as longchar no-undo.
     1149     define variable vi as integer no-undo.
     1150   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_crtt-rvs in g#lib-rvs ( input-output table tt-param ,
     1151                               output       v-comstring ,
     1152                               output       v-comment ,
     1153                               output       v-StartString ) no-error .
     1154       if error-status :error then do:
     1155         return error substitute( 'Ошибка при установке параметров для считывания данных с резервуаров.&1&2&1&3'
     1156                               , chr(10)
     1157                               , error-status :get-message( 1 )
     1158                               , return-value ) .
     1159       end.
     1160      v_File-Name = searchfile('revis.txt').
     1161      if v_File-Name ne ?
     1162      then do:
     1163         block-del-file:
     1164         do vi = 1 to 5:
     1165            os-delete value( v_File-Name ) .
     1166            v_File-Name = searchfile('revis.txt').
     1167            if v_File-Name eq ?
     1168            then
     1169               leave block-del-file.
     1170        end.
     1171      end.
     1172      if v_File-Name ne ?
     1173      then
     1174         return error 'Файл revis.txt заблокирован удалите файл и попробуйте еще раз. ' + v_File-Name .
     1175      if    v-comstring = '':U
     1176         or v-comstring = ?
     1177      then do:
     1178         return error 'Не задан парам. comstr в секции revision ini файла.' .
     1179      end.
     1180      v_File-Name = "wrevis" + string(random(1000000,9999999)) + ".tmp".
     1181      if searchfile(v_File-Name) ne ?
     1182      then do :
     1183         v_File-Name = "wrevis" + string(random(1000000,9999999)) + ".tmp".
     1184         if searchfile(v_File-Name) ne ?
     1185         then do :
     1186           os-delete value(searchfile(v_File-Name)) no-error .
     1187         end.
     1188         if searchfile(v_File-Name) ne ?
     1189         then
     1190           return error "Удалите все файлы wrevis*.tmp".
     1191      end.
     1192      assign
     1193         v_command = substitute( "&1 &2 &3 &4", v-comstring, string(0), v_File-Name, i-obj-code)
     1194      .
     1195      os-command silent value( v_command ) .
     1196      if searchfile(v_File-Name) ne ?
     1197      then
     1198         run readfiletxt (v_File-Name, output Vrevis).
     1199      run gbl/fileapnd.p
     1200             ( i-log-file-name
     1201             ,substitute("&1 &2  Запрос &3&4", string(today),string(time, "HH:MM:SS"), v_command, chr(13) + chr(10))
     1202             ,input 10
     1203             ) no-error .
     1204      if searchfile( v_File-Name ) = ? then do:
     1205         run gbl/fileapnd.p
     1206             ( i-log-file-name
     1207             ,substitute("Файл с прибора не получен. &1",  chr(13) + chr(10))
     1208             ,input 10
     1209             ) no-error .
     1210         return error 'Файл с прибора не получен.' .
     1211     end.
     1212     else do:
     1213         v_File-Name  = searchfile( v_File-Name ) .
     1214     end.
     1215     run gbl/fileapnd.p
     1216             ( i-log-file-name
     1217             ,substitute("&1 &2  Данные &3", string(today),string(time, "HH:MM:SS"), chr(13) + chr(10))
     1218             ,input 10
     1219             ) no-error .
     1220     os-append value(v_File-Name) value(i-log-file-name).
     1221     os-rename value( v_File-Name ) 'revis.txt'.
     1222     os-delete value( v_File-Name ) .
     1223     run gbl/fileapnd.p
     1224             ( i-log-file-name
     1225             , chr(13) + chr(10)
     1226             ,input 10
     1227             ) no-error .
     1228     run readrevisetxt (Vrevis,v-StartString,v-comment).
     1229   end procedure .
     1230   procedure get-from-ifsf :
     1231      define input  parameter i-log-file-name as character no-undo.
     1232      define input  parameter i-asi-ip        as character no-undo.
     1233      define input  parameter i-asi-port      as character no-undo.
     1234     define variable v_command     as   character     no-undo.
     1235     define variable v-log     as logical no-undo .
     1236     define variable v-bytes   as integer no-undo .
     1237     define variable v-out-data as character no-undo .
     1238     define variable v-line-str as character no-undo .
     1239     define variable ii        as integer no-undo .
     1240     define variable str       as character no-undo .
     1241     define variable str1      as character no-undo .
     1242     define variable str2      as character no-undo .
     1243     define variable hSocket   as handle no-undo .
     1244     define variable mDataIn   as memptr no-undo .
     1245     define variable mDataout  as memptr no-undo .
     1246     define variable cmd       as character no-undo .
     1247     define variable connStr   as character no-undo .
     1248     define variable v-attr-type   as character no-undo.
     1249     define variable v-comstring   as character no-undo.
     1250     define variable v-comment     as character no-undo.
     1251     define variable v-StartString as character no-undo.
     1252     define variable Vrevis        as longchar no-undo.
     1253     define variable vi as integer no-undo.
     1254   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_crtt-rvs in g#lib-rvs ( input-output table tt-param ,
     1255                               output       v-comstring ,
     1256                               output       v-comment ,
     1257                               output       v-StartString ) no-error .
     1258       if error-status :error then do:
     1259         return error substitute( 'Ошибка при установке параметров для считывания данных с резервуаров.&1&2&1&3'
     1260                               , chr(10)
     1261                               , error-status :get-message( 1 )
     1262                               , return-value ) .
     1263       end.
     1264     cmd = 'KOI8-R 1 0 1' + chr(10) .
     1265     set-size(mDataIn) = 0 .
     1266     set-size(mDataIn) = length(cmd , "RAW":U) + 1 .
     1267     put-string(mDataIn,1) = cmd .
     1268     find first sys-ctrl no-lock.
     1269     if i-asi-ip eq ? or i-asi-ip eq ""
     1270     then
     1271        run db-attr-value(sys-ctrl.db,"AsiIp",output i-asi-ip,output v-attr-type).
     1272     if i-asi-port eq ? or i-asi-port eq ""
     1273     then
     1274        run db-attr-value(sys-ctrl.db,"AsiPort",output i-asi-port,output v-attr-type).
     1275     create socket hSocket .
     1276     connStr = '-H ' + i-asi-ip + ' -S ' + i-asi-port .
     1277     hSocket:connect(connStr) no-error.
     1278     run gbl/fileapnd.p
     1279             ( i-log-file-name
     1280             ,substitute("&1 &2  Запрос  connStr='-H &3  -S &4 '  cmd='KOI8-R 1 0 1'&5", string(today),string(time, "HH:MM:SS"),i-asi-ip,i-asi-port, chr(13) + chr(10))
     1281             ,input 10
     1282             ) no-error .
     1283     if hSocket:connected() = false
     1284     then do :
     1285       run gbl/fileapnd.p
     1286             ( i-log-file-name
     1287             ,substitute("&1 &2 &3 &4", string(today),string(time, "HH:MM:SS"), "Не могу подключиться к IFSF серверу." , chr(13) + chr(10))
     1288             ,input 10
     1289             ) no-error .
     1290       return error "Не могу подключиться к IFSF серверу." .
     1291     end.
     1292     hSocket:set-socket-option('TCP-NODELAY', 'true').
     1293     hSocket:set-socket-option('SO-KEEPALIVE', 'true').
     1294     hSocket:set-socket-option('SO-REUSEADDR', 'true').
     1295     v-log = hSocket:write(mDataIn, 1, get-size(mDataIn)) no-error.
     1296     if v-log = false or error-status:get-message(1) <> ''
     1297     then do:
     1298       hSocket:disconnect() no-error.
     1299       run gbl/fileapnd.p
     1300             ( i-log-file-name
     1301             ,substitute("&1 &2 &3 &4", string(today),string(time, "HH:MM:SS"), "Не могу отправить команду на IFSF сервер.", chr(13) + chr(10))
     1302             ,input 10
     1303             ) no-error .
     1304       return error "Не могу отправить команду на IFSF сервер." .
     1305     end.
     1306     run sleep (1000) .
     1307     set-size(mDataOut) = 0 .
     1308     v-bytes = hSocket:get-bytes-available() .
     1309     set-size(mDataOut) = v-bytes + 1 .
     1310     v-log = hSocket:read(mDataOut, 1, v-bytes, 2) no-error.
     1311     if v-log = false or error-status:get-message(1) <> ''
     1312     then do:
     1313       hSocket:disconnect() no-error.
     1314       run gbl/fileapnd.p
     1315             ( i-log-file-name
     1316             ,substitute("&1 &2 &3 &4", string(today),string(time, "HH:MM:SS"), "Не могу прочитать ответ от IFSF сервера.", chr(13) + chr(10))
     1317             ,input 10
     1318             ) no-error .
     1319       return error "Не могу прочитать ответ от IFSF сервера." .
     1320     end.
     1321     v-out-data = get-string(mDataOut,1) .
     1322     if v-out-data = ""
     1323     then do :
     1324       hSocket:disconnect() no-error.
     1325       run gbl/fileapnd.p
     1326             ( i-log-file-name
     1327             ,substitute("&1 &2 &3 &4", string(today),string(time, "HH:MM:SS"), "Не могу получить данные от IFSF сервера.", chr(13) + chr(10))
     1328             ,input 10
     1329             ) no-error .
     1330       return error "Не могу получить данные от IFSF сервера." .
     1331     end.
     1332     if index(v-out-data, "Bad Request") > 0
     1333     then do :
     1334       hSocket:disconnect() no-error.
     1335       run gbl/fileapnd.p
     1336             ( i-log-file-name
     1337             ,substitute("&1 &2 &3 &4", string(today),string(time, "HH:MM:SS"), "Bad Request", chr(13) + chr(10))
     1338             ,input 10
     1339             ) no-error .
     1340       return error v-out-data .
     1341     end.
     1342     hSocket:disconnect() no-error.
     1343     delete object hSocket.
     1344     set-size(mDataIn) = 0.
     1345     set-size(mDataOut)   = 0.
     1346     run gbl/fileapnd.p
     1347             ( i-log-file-name
     1348             ,substitute("&1 &2  Данные &3", string(today),string(time, "HH:MM:SS"), chr(13) + chr(10))
     1349             ,input 10
     1350             ) no-error .
     1351      run gbl/fileapnd.p
     1352             ( i-log-file-name
     1353             , v-out-data
     1354             ,input 10
     1355             ) no-error .
     1356      run gbl/fileapnd.p
     1357             ( i-log-file-name
     1358             , chr(13) + chr(10)
     1359             ,input 10
     1360             ) no-error .
     1361     output to "revis.ifsf" .
     1362     do vi = 1 to num-entries(v-out-data, chr(10)) :
     1363       put unformatted entry(vi, v-out-data, chr(10)) skip .
     1364     end.
     1365     output close.
     1366     run readrevisetxt (v-out-data,v-StartString,v-comment).
     1367   end procedure .
     1368   procedure parse-xml :
     1369     define input parameter iStr as longchar .
     1370     define variable hDoc              as handle     no-undo .
     1371     define variable hRoot             as handle     no-undo .
     1372     for each tt-place:
     1373         tt-place.is-error       = yes.
     1374     end.
     1375     CREATE X-DOCUMENT hDoc.
     1376     CREATE X-NODEREF hRoot.
     1377     hDoc:LOAD("longchar",iStr,FALSE).
     1378     hDoc:GET-DOCUMENT-ELEMENT(hRoot).
     1379     RUN GetChildren(hRoot, 1).
     1380     DELETE OBJECT hDoc.
     1381     DELETE OBJECT hRoot.
     1382   end procedure .
     1383   PROCEDURE GetChildren:
     1384   DEFINE INPUT PARAMETER hParent AS HANDLE NO-UNDO.
     1385   DEFINE INPUT PARAMETER level AS INTEGER NO-UNDO.
     1386   DEFINE VARIABLE i AS INTEGER NO-UNDO.
     1387   DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
     1388   DEFINE VARIABLE hText    AS HANDLE NO-UNDO.
     1389   define variable client   as character no-undo.
     1390   define variable good                as logical   no-undo .
     1391   define variable v-asi-error-code    as integer   no-undo initial 0 .
     1392   define variable v-asi-error-message as character no-undo .
     1393   CREATE X-NODEREF hNoderef.
     1394   CREATE X-NODEREF hText .
     1395   REPEAT i = 1 TO hParent:NUM-CHILDREN:
     1396       good = hParent:GET-CHILD(hNoderef,i).
     1397       IF NOT good THEN
     1398           LEAVE.
     1399       IF hNoderef:SUBTYPE <> "element" THEN
     1400           NEXT.
     1401       hNoderef:GET-CHILD(hText, 1) no-error .
     1402       IF hNoderef:NAME = "ErrNum"
     1403       then do :
     1404         v-asi-error-code = integer(hText:node-value) no-error .
     1405       end .
     1406       IF hNoderef:NAME = "ErrMsg"
     1407       then do :
     1408         v-asi-error-message = hText:node-value no-error .
     1409         if     v-asi-error-code > 0
     1410            and v-asi-error-code ne 2
     1411         then do :
     1412           assign
     1413             tt-place.t1             = ?
     1414             tt-place.t2             = ?
     1415             tt-place.t3             = ?
     1416             tt-place.level-total    = ?
     1417             tt-place.level-water    = ?
     1418             tt-place.total-vol      = ?
     1419             tt-place.avrg-temp      = ?
     1420             tt-place.density        = ?
     1421             tt-place.mass           = ?
     1422             tt-place.vapor-density  = ?
     1423             tt-place.vapor-pressure = ?
     1424             tt-place.volume_water   = ?
     1425             tt-place.is-error       = true
     1426             tt-place.error-message  = v-asi-error-message
     1427           .
     1428         end .
     1429       end .
     1430       IF hNoderef:NAME = "Tank"
     1431       then do :
     1432         find first tt-place where tt-place.loc1 = hText:node-value no-error .
     1433         if not available tt-place
     1434         then do :
     1435           create tt-place .
     1436           assign tt-place.loc1     = hText:node-value
     1437                  tt-place.locint   = int(tt-place.loc1)
     1438           no-error .
     1439         end.
     1440         assign
     1441             v-asi-error-code        = 0
     1442             tt-place.t1             = ?
     1443             tt-place.t2             = ?
     1444             tt-place.t3             = ?
     1445             tt-place.level-total    = ?
     1446             tt-place.level-water    = ?
     1447             tt-place.total-vol      = ?
     1448             tt-place.avrg-temp      = ?
     1449             tt-place.density        = ?
     1450             tt-place.mass           = ?
     1451             tt-place.vapor-density  = ?
     1452             tt-place.vapor-pressure = ?
     1453             tt-place.volume_water   = ?
     1454             tt-place.is-error       = no
     1455             tt-place.error-message  = ?
     1456         .
     1457       end.
     1458       if    v-asi-error-code = 0
     1459          or v-asi-error-code = 2
     1460       then do :
     1461         IF hNoderef:NAME = "LevelTotal" then assign tt-place.level-total = decimal(hText:node-value) / 10 no-error .
     1462         IF hNoderef:NAME = "LevelWater" then assign tt-place.level-water = decimal(hText:node-value) / 10 no-error .
     1463         IF hNoderef:NAME = "Temperature" then assign tt-place.avrg-temp = decimal(hText:node-value) no-error .
     1464         IF hNoderef:NAME = "Density" then assign tt-place.density = decimal(hText:node-value) no-error .
     1465         IF hNoderef:NAME = "VolumeTotal" then assign tt-place.total-vol = decimal(hText:node-value) no-error .
     1466         IF hNoderef:NAME = "MassTotal" then assign tt-place.mass = decimal(hText:node-value) no-error .
     1467         IF hNoderef:NAME = "VaporDensity" then assign tt-place.vapor-density = decimal(hText:node-value) no-error .
     1468         IF hNoderef:NAME = "VaporPressure" then assign tt-place.vapor-pressure = decimal(hText:node-value) / 1000 no-error .
     1469         IF hNoderef:NAME = "Temperature1" then assign tt-place.t1 = decimal(hText:node-value) no-error .
     1470         IF hNoderef:NAME = "Temperature2" then assign tt-place.t2 = decimal(hText:node-value) no-error .
     1471         IF hNoderef:NAME = "Temperature3" then assign tt-place.t3 = decimal(hText:node-value) no-error .
     1472       end .
     1473       RUN GetChildren(hNoderef, (level + 1)).
     1474   END.
     1475   DELETE OBJECT hNoderef.
     1476   DELETE OBJECT hText.
     1477   END PROCEDURE.
     1478   define variable v-parsesub        as character  no-undo .
     1479   define variable curl-path         as character  no-undo .
     1480   define variable v-command         as character  no-undo .
     1481   define variable v-addr            as character  no-undo .
     1482   define variable v-log-file-name   as character  no-undo .
     1483   define variable v-asi-ip  as character no-undo .
     1484   define variable v-asi-port as character no-undo .
     1485   define variable v-attr-type as character no-undo .
     1486   define variable v-asi-error-code as integer no-undo initial 0 .
     1487   define variable v-asi-error-message as character no-undo .
     1488   define variable old-BM as logical no-undo .
     1489   v-log-file-name = substitute('&1rvs.log', ibs.th.gbl.gbl-inipar:logDir) .
     1490   if p-loclist = '0':U then p-loclist = "all" .
     1491   find first sys-ctrl no-lock.
     1492   run db-attr-value(sys-ctrl.db,"AsiIp",output v-asi-ip,output v-attr-type).
     1493   run db-attr-value(sys-ctrl.db,"AsiPort",output v-asi-port,output v-attr-type).
     1494   mFileLogSocet = v-log-file-name.
     1495   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1496   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1497   if     objSrv:SystemSetting:asifile ne ?
     1498        and objSrv:SystemSetting:asifile ne ""
     1499        and search(objSrv:SystemSetting:asifile) ne ?
     1500   then do:
     1501      copy-lob from file search(objSrv:SystemSetting:asifile) to mWebResp no-convert no-error.
     1502      output to value (  v-log-file-name  ) append .
     1503      put unformatted string(today) ' ' string(time, "HH:MM:SS") " Прочитан файл  " skip .
     1504      output close .
     1505   end.
     1506   else do:
     1507      old-BM = mBatchMode .
     1508      if p-no-waitfram
     1509      then do :
     1510        mBatchMode = yes .
     1511      end .
     1512      run ConectSocet (v-asi-ip,
     1513                       v-asi-port,
     1514                       ("getmeas/?loclist=" + p-loclist),
     1515                       "",
     1516                       "xml",
     1517                       180,
     1518                       no,
     1519                       "Получение данных от АСИ. ").
     1520      mBatchMode = old-BM .
     1521   end.
     1522   empty temp-table tt-place .
     1523   if length(mWebResp) >0
     1524   then do:
     1525      output to value (  v-log-file-name  ) append .
     1526      put unformatted string(today) ' ' string(time, "HH:MM:SS") " Разбираем полученные данныи  " skip .
     1527      output close .
     1528      copy-lob from mWebResp to file v-log-file-name append no-convert no-error.
     1529      output to value (  v-log-file-name  ) append .
     1530      put unformatted skip .
     1531      output close .
     1532      run parse-xml (input mWebResp) .
     1533   end.
     1534   else do:
     1535      output to value (  v-log-file-name  ) append .
     1536      put unformatted string(today) ' ' string(time, "HH:MM:SS") "  Неудалось получить ответ  " skip .
     1537      output close .
     1538   end.
