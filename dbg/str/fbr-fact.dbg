     3241     ,output v-host-code
     3242     )  .
     3243   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3244   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     3245     (input  p-obj-type
     3246     ,input  p-obj-code
     3247     ,output v-obj-db-num
     3248     )  .
     3249   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3250   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3251     (output v-db-num
     3252     )  .
     3253   if v-obj-db-num <> v-db-num then do:
     3254     return error substitute("Запрещено создание документа производства в чужой БД:&1БД &2&3 - &4&1текущая БД - &5"
     3255                             , chr(10)
     3256                             , p-obj-type
     3257                             , p-obj-code
     3258                             , v-obj-db-num
     3259                             , v-db-num).
     3260   end.
     3261   run cur-time in this-procedure ( output v-today, output v-time).
     3262   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3263   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     3264     (input  p-obj-type
     3265     ,input  p-obj-code
     3266     ,output v-today
     3267     )  .
     3268   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3269   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     3270     (input  v-host-code
     3271     ,output v-base-code
     3272     )  .
     3273   find last buf_curr-accnt no-lock
     3274       where buf_curr-accnt.curr-code = v-base-code
     3275         and buf_curr-accnt.exch-date <= v-today use-index pi
     3276   no-error.
     3277   if not available buf_curr-accnt
     3278   then do:
     3279     undo, return error substitute("На дату &1 неизвестен курс базовой валюты с кодом &2"
     3280                                     , string(v-today, "99/99/9999")
     3281                                     , v-base-code).
     3282   end.
     3283   run doc-code in this-procedure (
     3284         input  "main"
     3285       , input  p-obj-type
     3286       , input  p-obj-code
     3287       , input  ?
     3288       , output v-doc-code
     3289   ) no-error.
     3290   if error-status:error
