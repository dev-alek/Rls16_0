    11699                                     and buf_goods.prod-type = buf_fbr-line.prod-type
    11700                                     and buf_goods.prod-code = buf_fbr-line.prod-code,
    11701           each buf_marking-lines no-lock where buf_marking-lines.gds-code = buf_goods.gds-code
    11702                                            and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
    11703                                            and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
    11704                                            and buf_marking-lines.in-code  = "manufacturing"
    11705                                            and buf_marking-lines.out-code = buf_fbr-doc.doc-code
    11706                                            and buf_marking-lines.part-code = buf_fbr-line.recipe-code
    11707                                            and buf_marking-lines.prt-code = 0
    11708           :
    11709             for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
    11710               assign
    11711                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when not buf_fbr-line.is-comp
    11712                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB when buf_fbr-line.is-comp
    11713               .
    11714             end .
    11715           end .
    11716           find first buf_out_trn-doc
    11717               where buf_out_trn-doc.doc-code = v-in-doc-code
    11718           no-error.
