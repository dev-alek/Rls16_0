     2082   do on error undo, return error return-value :
     2083   for each bf_tt-allsum-line
     2084   on error undo, return error return-value
     2085    :
     2086     delete bf_tt-allsum-line.
     2087   end.
     2088   for each bf_tt-allsum
     2089   on error undo, return error return-value
     2090   :
     2091     delete bf_tt-allsum.
     2092   end.
     2093   for each bf_tt-clcparts
     2094   on error undo, return error return-value
     2095   :
     2096   if v-calcbypart then do:
     2097             assign
     2098             parcur-base =   bf_tt-clcparts.part-cur-base
     2099             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     2100             parcur-excise =   bf_tt-clcparts.part-cur-excise
     2101             .
     2102   end.
     2103      run clcprtsl_calc-parts in this-procedure (
     2104        input recid(bf_tt-clcparts),
     2105        input paris-doc,
     2106        input paris-cur,
     2107        input parroad-tax,
     2108        input parexcise,
     2109        input parvat-pc,
     2110        input parcons-vat-pc,
     2111        input parslt-pc,
     2112        input parbase-rate,
     2113        input parbase-scale,
     2114        input parr-b,
     2115        input parcur-base,
     2116        input parcur-road-tax,
     2117        input parcur-excise,
     2118        input parcur-vat-pc,
     2119        input parcurcons-vat-pc,
     2120        input parcurslt-pc
     2121        ) no-error.
     2122     if error-status:error then do:
     2123       message
     2124         vss-workfile vss-revision vss-description skip
     2125         vss-include-info1 skip
     2126         "Ошибка при обсчете партии" skip
