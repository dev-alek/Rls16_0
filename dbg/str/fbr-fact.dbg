     8196   procedure xmlchar-test :
     8197   define input parameter p-in-string          as character        no-undo.
     8198   define output parameter p-out-string-enc    as character        no-undo.
     8199   define output parameter p-out-string-dec    as character        no-undo.
     8200   do
     8201   on error undo, return error
     8202   :
     8203          run xmlchar-encode in this-procedure
     8204       (
     8205             input p-in-string
     8206           , output p-out-string-enc
     8207       ).
     8208          run xmlchar-decode in this-procedure
     8209       (
     8210             input p-out-string-enc
     8211           , output p-out-string-dec
     8212       ).
     8213   end.
     8214   end .
     8215   procedure xmlchar-encode :
     8216   define input parameter p-in-string      as character        no-undo.
     8217   define output parameter p-out-string    as character        no-undo.
     8218       define variable v-position      as integer      no-undo.
     8219       define variable v-current-char  as character    no-undo.
     8220   do
     8221   on error undo, return error
     8222   :
     8223       assign
     8224           p-out-string = "":U
     8225       .
     8226       case p-in-string
     8227       :
     8228           when ?
     8229           then do:
     8230               assign
     8231                   p-out-string = "?":U
     8232               .
     8233           end.
     8234           when "?":U
     8235           then do:
     8236               assign
     8237                   p-out-string = "&#63;":U
     8238               .
     8239           end.
     8240           otherwise do:
     8241               do v-position = 1 to length( p-in-string )
     8242               :
     8243                   assign
     8244                       v-current-char = substring( p-in-string, v-position, 1 )
     8245                   .
     8246                   case v-current-char
     8247                   :
     8248                       when "&":U
     8249                       then do:
     8250                           assign
     8251                               p-out-string = p-out-string + "&amp;":U
     8252                           .
     8253                       end.
     8254                       when ">":U
     8255                       then do:
     8256                           assign
     8257                               p-out-string = p-out-string + "&gt;":U
     8258                           .
     8259                       end.
     8260                       when "<":U
     8261                       then do:
     8262                           assign
     8263                               p-out-string = p-out-string + "&lt;":U
     8264                           .
     8265                       end.
     8266                       when "'":U
     8267                       then do:
     8268                           assign
     8269                               p-out-string = p-out-string + "&apos;":U
     8270                           .
     8271                       end.
     8272                       when '"':U
     8273                       then do:
     8274                           assign
     8275                               p-out-string = p-out-string + "&quot;":U
     8276                           .
     8277                       end.
     8278                       when chr(1)
     8279                       then do:
     8280                           assign
     8281                               p-out-string = p-out-string + "":U
     8282                           .
     8283                       end.
     8284                       when chr(2)
     8285                       then do:
     8286                           assign
     8287                               p-out-string = p-out-string + "":U
     8288                           .
     8289                       end.
     8290                       when chr(3)
     8291                       then do:
     8292                           assign
     8293                               p-out-string = p-out-string + "":U
     8294                           .
     8295                       end.
     8296                       when chr(4)
     8297                       then do:
     8298                           assign
     8299                               p-out-string = p-out-string + "":U
     8300                           .
     8301                       end.
     8302                       when chr(5)
     8303                       then do:
     8304                           assign
     8305                               p-out-string = p-out-string + "":U
     8306                           .
     8307                       end.
     8308                       when chr(6)
     8309                       then do:
     8310                           assign
     8311                               p-out-string = p-out-string + "":U
     8312                           .
     8313                       end.
     8314                       when chr(7)
     8315                       then do:
     8316                           assign
     8317                               p-out-string = p-out-string + "":U
     8318                           .
     8319                       end.
     8320                       when chr(8)
     8321                       then do:
     8322                           assign
     8323                               p-out-string = p-out-string + "":U
     8324                           .
     8325                       end.
     8326                       when chr(9)
     8327                       then do:
     8328                           assign
     8329                               p-out-string = p-out-string + "":U
     8330                           .
     8331                       end.
     8332                       when chr(29)
     8333                       then do:
     8334                           assign
     8335                               p-out-string = p-out-string + "":U
     8336                           .
     8337                       end.
     8338                       when chr(10)
     8339                       then do:
     8340                           assign
     8341                               p-out-string = p-out-string + "&#10;":U
     8342                           .
     8343                       end.
     8344                       when chr(13)
     8345                       then do:
     8346                           assign
     8347                               p-out-string = p-out-string + "&#13;":U
     8348                           .
     8349                       end.
     8350                       otherwise do:
     8351                           assign
     8352                               p-out-string = p-out-string + v-current-char
     8353                           .
     8354                       end.
     8355                   end case.
     8356               end.
     8357           end.
     8358       end case.
     8359   end.
     8360   end .
