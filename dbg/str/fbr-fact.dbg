    11625   (input  buf_in_trn-doc.doc-code
    11626   ) .
    11627           define variable v-gtin-qnty as character no-undo .
    11628           define variable v-gtin as character no-undo .
    11629           LK_RECEIPT_ :
    11630           for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_out_trn-doc.doc-code,
    11631           first buf_goods no-lock  where buf_goods.artic = buf_doc-line.artic
    11632                                      and buf_goods.prod-code = buf_doc-line.prod-code
    11633                                      and buf_goods.prod-type = buf_doc-line.prod-type
    11634           :
    11635             for first buf_fbr-line no-lock where buf_fbr-line.doc-code = buf_doc-line.doc-code
    11636                                              and buf_fbr-line.trn-type = 'спи':U
    11637                                              and buf_fbr-line.artic = buf_doc-line.artic
    11638                                              and buf_fbr-line.prod-type = buf_doc-line.prod-type
    11639                                              and buf_fbr-line.prod-code = buf_doc-line.prod-code
    11640                                              ,
    11641             first buf_fbr-recipe no-lock where buf_fbr-recipe.doc-code = buf_fbr-line.doc-code
    11642                                            and buf_fbr-recipe.recipe-code = buf_fbr-line.recipe-code
    11643             :
    11644               if buf_fbr-recipe.recipe-type <> 'альтернатива':U
    11645               then next LK_RECEIPT_ .
    11646             end .
    11647             v-gtin-qnty = "" .
    11648             RUN gds-attr-value (
    11649                                 INPUT buf_goods.gds-code,
    11650                                 INPUT 'mark-type':U,
    11651                                 OUTPUT varvalue,
    11652                                 OUTPUT vartype
    11653                                 ).
    11654             if varvalue = "antiseptic" then next LK_RECEIPT_ .
    11655             if varvalue > ""
    11656             and EDOParSec:GetIsArticForType(varvalue)
    11657             then do:
    11658               for each buf_parts no-lock where buf_parts.out-code = buf_doc-line.doc-code
    11659                                            and buf_parts.obj-type = buf_doc-line.obj-type
    11660                                            and buf_parts.obj-code = buf_doc-line.obj-code
    11661                                            and buf_parts.artic = buf_doc-line.artic
    11662                                            and buf_parts.prod-type = buf_doc-line.prod-type
    11663                                            and buf_parts.prod-code = buf_doc-line.prod-code
    11664               :
    11665                 if num-entries(buf_parts.part-code, "_") = 2
    11666                 then do :
    11667                   v-gtin = entry(1, buf_parts.part-code, "_") .
    11668                   if length(v-gtin) = 8
    11669                   or length(v-gtin) = 12
    11670                   or length(v-gtin) = 13
    11671                   or length(v-gtin) = 14
    11672                   then do :
    11673                     v-gtin-qnty = v-gtin-qnty + v-gtin + "=" + string(integer(buf_parts.qnty)) + ";" .
    11674                   end .
    11675                 end .
    11676               end .
    11677             end .
    11678             v-gtin-qnty = trim(v-gtin-qnty, ";") .
    11679             if v-gtin-qnty > ""
    11680             then do :
    11681               find first buf_doc-line-attr exclusive-lock where buf_doc-line-attr.doc-code = buf_doc-line.doc-code
    11682                                                             and buf_doc-line-attr.gds-code = buf_goods.gds-code
    11683                                                             and buf_doc-line-attr.attr-code = "GTIN-qnty"
    11684                                                             no-error .
