    11688                 assign
    11689                   buf_doc-line-attr.doc-code = buf_doc-line.doc-code
    11690                   buf_doc-line-attr.gds-code = buf_goods.gds-code
    11691                   buf_doc-line-attr.attr-code = "GTIN-qnty"
    11692                 .
    11693               end .
    11694               buf_doc-line-attr.attr-value = v-gtin-qnty .
    11695             end .
    11696           end .
    11697           for each buf_fbr-line no-lock where buf_fbr-line.doc-code = buf_fbr-doc.doc-code,
