     3293                                   , chr(10)
     3294                                   , error-status:get-message(1)
     3295                                   , return-value ).
     3296   end.
     3297   run trg/chkdocnm.p (
     3298         input v-doc-code
     3299       , input 'fbr-doc':U
     3300       , input ?
     3301   ) no-error.
     3302   if error-status:error
     3303   then do:
     3304     undo, return error substitute("Ошибка при проверке номера для нового документа производства&1&2&1&3"
     3305                                   , chr(10)
     3306                                   , error-status:get-message(1)
     3307                                   , return-value ).
     3308   end.
     3309   create buf_fbr-doc.
     3310   assign
     3311   buf_fbr-doc.doc-code  = v-doc-code
     3312   buf_fbr-doc.creid     = p-userid
     3313   buf_fbr-doc.doc-date  = v-today
     3314   buf_fbr-doc.doc-type  = 'производство':U
     3315   buf_fbr-doc.host-code = v-host-code
     3316   buf_fbr-doc.obj-code  = p-obj-code
     3317   buf_fbr-doc.obj-type  = p-obj-type
     3318   buf_fbr-doc.PS        = "@"
     3319   buf_fbr-doc.status_   = 'новый':U
     3320   buf_fbr-doc.user-db-num = v-obj-db-num
     3321   buf_fbr-doc.user-name   = p-userid
     3322   .
     3323   run fbrlib_get-default-pay-code in this-procedure (
     3324         input buf_fbr-doc.obj-type
     3325       , input buf_fbr-doc.obj-code
     3326       , output fi-pay-code
     3327   ).
     3328   buf_fbr-doc.pay-code = fi-pay-code.
