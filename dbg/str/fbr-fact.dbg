     7188       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     7189       for each buf_temp_fbrrep-goods
     7190       on error undo, return error
     7191       :
     7192       end.
     7193   end.
     7194   end procedure.
     7195   procedure fbrrep-fill-qnty-and-prices-gds :
     7196   do
     7197   on error undo, return error
     7198   :
     7199   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     7200   define input parameter p-gds-code           as integer      no-undo.
     7201       define variable v-sign      as decimal       no-undo.
     7202       define buffer buf_fbr-line          for ub.fbr-line.
     7203       define buffer buf_goods             for ub.goods.
     7204       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     7205       find first buf_goods no-lock
     7206            where buf_goods.gds-code = p-gds-code
     7207       .
     7208       find first buf_temp_fbrrep-goods
     7209            where buf_temp_fbrrep-goods.artic     = buf_goods.artic
     7210              and buf_temp_fbrrep-goods.prod-type = buf_goods.prod-type
     7211              and buf_temp_fbrrep-goods.prod-code = buf_goods.prod-code
     7212       use-index ar
     7213       no-error.
     7214       if available buf_temp_fbrrep-goods
     7215       then do:
     7216           delete buf_temp_fbrrep-goods.
     7217       end.
     7218       create buf_temp_fbrrep-goods.
     7219   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7220   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     7221     (input  buf_goods.artic
     7222     ,input  buf_goods.prod-type
     7223     ,input  buf_goods.prod-code
     7224     ,input  'gds-goods=request':u
     7225     ,output buf_temp_fbrrep-goods.is-not-office
     7226     )  .
     7227       assign
     7228           buf_temp_fbrrep-goods.gds-code             = p-gds-code
     7229           buf_temp_fbrrep-goods.artic                = buf_goods.artic
     7230           buf_temp_fbrrep-goods.prod-type            = buf_goods.prod-type
     7231           buf_temp_fbrrep-goods.prod-code            = buf_goods.prod-code
     7232           buf_temp_fbrrep-goods.gds-name             = buf_goods.gds-name
     7233           buf_temp_fbrrep-goods.is-waste             = no
     7234           buf_temp_fbrrep-goods.fact-qnty            = 0
     7235           buf_temp_fbrrep-goods.write-off-rsrv-qnty  = 0
     7236           buf_temp_fbrrep-goods.write-off-qnty       = 0
     7237           buf_temp_fbrrep-goods.income-qnty          = 0
     7238           buf_temp_fbrrep-goods.income-rsrv-qnty     = 0
     7239           buf_temp_fbrrep-goods.cost-rubl            = 0
     7240           buf_temp_fbrrep-goods.cost-base            = 0
     7241           buf_temp_fbrrep-goods.sum-cost-rubl        = 0
     7242           buf_temp_fbrrep-goods.sum-cost-base        = 0
     7243           buf_temp_fbrrep-goods.vat-cost-rubl        = 0
     7244           buf_temp_fbrrep-goods.vat-cost-base        = 0
     7245           buf_temp_fbrrep-goods.sum-vat-cost-rubl    = 0
     7246           buf_temp_fbrrep-goods.sum-vat-cost-base    = 0
     7247           buf_temp_fbrrep-goods.price-sale           = 0
     7248           buf_temp_fbrrep-goods.deleted              = no
     7249       .
     7250   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7251   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     7252     (input  p-gds-code
     7253     ,output buf_temp_fbrrep-goods.unit-base
     7254     )  .
     7255       for each buf_fbr-line no-lock
     7256          where buf_fbr-line.prod-type = buf_goods.prod-type
     7257            and buf_fbr-line.prod-code = buf_goods.prod-code
     7258            and buf_fbr-line.artic     = buf_goods.artic
     7259            and buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     7260       on error undo, return error
     7261       :
     7262           case buf_fbr-line.trn-type
     7263           :
     7264               when 'при':U
     7265               then do:
     7266                   assign
     7267                       v-sign                                          = 1
     7268                       buf_temp_fbrrep-goods.income-qnty               = buf_temp_fbrrep-goods.income-qnty                 + buf_fbr-line.fact-qnty
     7269                       buf_temp_fbrrep-goods.sum-cost-income-rubl      = buf_temp_fbrrep-goods.sum-cost-income-rubl        + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     7270                       buf_temp_fbrrep-goods.sum-cost-income-base      = buf_temp_fbrrep-goods.sum-cost-income-base        + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     7271                       buf_temp_fbrrep-goods.sum-vat-cost-income-rubl  = buf_temp_fbrrep-goods.sum-vat-cost-income-rubl    + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     7272                       buf_temp_fbrrep-goods.sum-vat-cost-income-base  = buf_temp_fbrrep-goods.sum-vat-cost-income-base    + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     7273                   .
     7274                   if buf_fbr-line.rsrv-qnty <> ?
     7275                   then do:
     7276                       assign
     7277                           buf_temp_fbrrep-goods.income-rsrv-qnty = buf_temp_fbrrep-goods.income-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     7278                       .
     7279                   end.
     7280               end.
     7281               when 'спи':U
     7282               then do:
     7283                   assign
     7284                       v-sign                                  = -1
     7285                       buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty      + buf_fbr-line.fact-qnty
     7286                       buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     7287                       buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     7288                       buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     7289                       buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     7290                   .
     7291                   if buf_fbr-line.rsrv-qnty <> ?
     7292                   then do:
     7293                       assign
     7294                           buf_temp_fbrrep-goods.write-off-rsrv-qnty           = buf_temp_fbrrep-goods.write-off-rsrv-qnty           + buf_fbr-line.rsrv-qnty
     7295                           buf_temp_fbrrep-goods.sum-write-off-rsrv-rubl       = buf_temp_fbrrep-goods.sum-write-off-rsrv-rubl       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     7296                           buf_temp_fbrrep-goods.sum-write-off-rsrv-base       = buf_temp_fbrrep-goods.sum-write-off-rsrv-base       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     7297                           buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-rubl   = buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-rubl   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     7298                           buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-base   = buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-base   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     7299                       .
     7300                   end.
     7301               end.
     7302           end case.
     7303           assign
     7304               buf_temp_fbrrep-goods.is-waste             = buf_fbr-line.is-waste
     7305               buf_temp_fbrrep-goods.price-sale           = buf_fbr-line.price-sale
     7306               buf_temp_fbrrep-goods.cost-income-rubl     = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-income-rubl      / buf_temp_fbrrep-goods.income-qnty    )
     7307               buf_temp_fbrrep-goods.cost-income-base     = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-income-base      / buf_temp_fbrrep-goods.income-qnty    )
     7308               buf_temp_fbrrep-goods.vat-cost-income-rubl = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-income-rubl  / buf_temp_fbrrep-goods.income-qnty    )
     7309               buf_temp_fbrrep-goods.vat-cost-income-base = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-income-base  / buf_temp_fbrrep-goods.income-qnty    )
     7310               buf_temp_fbrrep-goods.cost-rubl            = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-rubl             / buf_temp_fbrrep-goods.write-off-qnty )
     7311               buf_temp_fbrrep-goods.cost-base            = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-base             / buf_temp_fbrrep-goods.write-off-qnty )
     7312               buf_temp_fbrrep-goods.vat-cost-rubl        = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-rubl         / buf_temp_fbrrep-goods.write-off-qnty )
     7313               buf_temp_fbrrep-goods.vat-cost-base        = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-base         / buf_temp_fbrrep-goods.write-off-qnty )
     7314           .
     7315       end.
     7316       run test-temp-tables in this-procedure .
     7317   end.
     7318   end procedure.
     7319   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7320   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7321       def var log-file-name as char no-undo.
     7322       if search('fbr.log') = ?
     7323       then do:
     7324           assign
     7325               log-file-name = ""
     7326           .
     7327       end.
     7328       else do:
     7329           assign
     7330               log-file-name = 'fbr.log'
     7331           .
     7332       end.
     7333       DEF STREAM stm-log.
     7334       PROCEDURE writelog:
     7335       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
     7336       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
     7337       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
     7338       if p-file-name <> ""
     7339       then do:
     7340       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
     7341           PUT STREAM stm-log UNFORMATTED chr(10).
     7342           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
     7343                                           OR p-log-string = "&Line") THEN "" ELSE
     7344                                           cur-time-string-sec() + " ").
     7345           PUT STREAM stm-log UNFORMATTED
     7346                   (IF p-log-string = "&Line" THEN FILL("-", 80)
     7347                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
     7348                   ELSE fill(" ", p-log-level * 2) + p-log-string).
     7349       OUTPUT STREAM stm-log CLOSE.
     7350       end.
     7351       END PROCEDURE.
     7352   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7353   define variable v-waitfram-action01         as character   no-undo .
     7354   define variable v-waitfram-action02         as character   no-undo .
     7355   define variable v-waitfram-action03         as character   no-undo .
     7356   define variable mWaitFramTextBeg            as character   no-undo.
     7357   define variable mWaitFramTextEnd            as character   no-undo.
     7358   define variable mWaitFramView               as logical     no-undo.
     7359   define variable mWaitProcEvent              as logical     no-undo init yes.
     7360   define variable mWaitFramInterval           as integer     no-undo init 1 .
     7361   define variable mWaitFramStop               as logical     no-undo.
     7362   define variable mWaitFramStopUser           as logical     no-undo.
     7363   define variable mWaitFramStopTimeOut        as logical     no-undo.
     7364   define variable mWaitFramStartProc          as datetime-tz no-undo.
     7365   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     7366   define button B-WaitFramStop auto-end-key
     7367        label "Стоп"
     7368        size 10 by 1 tooltip "Остоновить процесс".
     7369   define button B-viewProcInfo
     7370        label "Информация"
     7371        size 15 by 1 tooltip "Информация о процесс".
     7372   define frame waitfram
     7373     v-waitfram-action01 format "x(72)" no-label skip
     7374     v-waitfram-action02 format "x(72)" no-label skip
     7375     v-waitfram-action03 format "x(72)" no-label skip
     7376     B-viewProcInfo
     7377     B-WaitFramStop at row 4 col 30
     7378     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     7379     .
     7380   define new global shared variable mBatchMode as logical no-undo init ?.
     7381   define variable mFramBachModHandle as handle no-undo.
     7382   mFramBachModHandle = frame waitfram:handle.
     7383   define variable mFameOldVis as logical no-undo.
     7384   define variable mVisCUrentVin as logical no-undo.
     7385   if session:batch-mode
     7386   then
     7387      mBatchMode = yes.
     7388   if mBatchMode = ? then do:
     7389     mVisCUrentVin = current-window:visible.
     7390     mFameOldVis = mFramBachModHandle:visible.
     7391     mFramBachModHandle:visible  = yes.
     7392     mBatchMode = mFramBachModHandle:visible ne yes.
     7393     mFramBachModHandle:visible = mFameOldVis.
     7394     current-window:visible = mVisCUrentVin.
     7395   end.
     7396    if  log-manager:logfile-name ne ?
     7397     then DO:
     7398         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     7399         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     7400         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     7401     end.
     7402   on choose of B-WaitFramStop in frame waitfram
     7403   do:
     7404     mWaitFramStop = yes.
     7405     mWaitFramStopUser = yes.
     7406   end.
     7407   function waitfram-check-timeout returns logical():
     7408      define variable vtime as int64 no-undo.
     7409      if mWaitFramStopTimeOut
     7410      then
     7411         return yes.
     7412      vtime = ( now - mWaitFramStartProc ) / 1000 .
     7413      if     mWaitFramTimeOut ne ?
     7414         and mWaitFramTimeOut ne 0
     7415         and mWaitFramTimeOut lt vtime
     7416      then do:
     7417         mWaitFramStopTimeOut = yes.
     7418      end.
     7419      return mWaitFramStopTimeOut.
     7420   end.
     7421   procedure waitfram-hide :
     7422     if not session:batch-mode
     7423     then do
     7424     on error undo, return error return-value
     7425     :
     7426       pause 0 before-hide .
     7427       if not mBatchMode then
     7428         hide frame waitfram .
     7429     if     not mWaitFramView
     7430        and mWaitProcEvent
     7431     then
     7432       process events .
     7433     end.
     7434   end procedure.
     7435   procedure waitfram-show :
     7436     define input  parameter p-message as character no-undo .
     7437     define variable v-left-margin as integer   no-undo .
     7438     if not session:batch-mode
     7439     then do
     7440     on error undo, return error return-value
     7441     :
     7442       if length(p-message) <= 70 then do:
     7443         assign
     7444           v-left-margin = integer((70 - length(p-message)) / 2)
     7445         .
     7446         assign
     7447           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     7448         .
     7449         assign
     7450           v-waitfram-action01 = " "
     7451           v-waitfram-action02 = " "
     7452                                    + fill(" ", v-left-margin)
     7453                                    + p-message
     7454           v-waitfram-action03 = " "
     7455         .
     7456       end.
     7457       else do:
     7458         define variable vRindex1 as integer no-undo.
     7459         define variable vRindex2 as integer no-undo.
     7460         vRindex1 = r-index(p-message," ",70).
     7461         if vRindex1 = 0
     7462         then
     7463            vRindex1 = 70.
     7464         if length(p-message)  <= vRindex1 + 70 then do:
     7465           assign
     7466             v-waitfram-action01 = " "
     7467             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     7468             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     7469           .
     7470         end.
     7471         else do:
     7472           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     7473           if vRindex2 <= vRindex1
     7474           then
     7475              vRindex2 = vRindex1 + 70.
     7476           assign
     7477             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     7478             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     7479             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     7480           .
     7481         end.
     7482       end.
     7483       B-viewProcInfo:visible   in frame waitfram = no.
     7484       B-viewProcInfo:sensitive in frame waitfram = no.
     7485       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     7486       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     7487       if  (   mWaitFramView
     7488          or  mWaitProcEvent)
     7489          and not mBatchMode
     7490       then
     7491          display
     7492             v-waitfram-action01 skip
     7493             v-waitfram-action02 skip
     7494             v-waitfram-action03 skip
     7495          with frame waitfram .
     7496       if     mWaitFramView
     7497          then do:
     7498             if     mWaitFramInterval ne ?
     7499                and not mBatchMode
     7500             then
     7501                wait-for go of frame waitfram pause mWaitFramInterval.
     7502          end.
     7503          else
     7504             if     mWaitProcEvent
     7505                and not mBatchMode
     7506             then
     7507                process events .
     7508     end.
     7509   end procedure.
     7510      procedure waitfram-show-this:
     7511         define input  parameter iInterval as int64 no-undo.
     7512         define variable vtime as int64 no-undo.
     7513         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     7514         mWaitFramInterval = iInterval.
     7515         run waitfram-show (substitute("&1&2 &3&4" ,
     7516                                       mWaitFramTextBeg ,
     7517                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     7518                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     7519                                       mWaitFramTextEnd
     7520                                      )
     7521                           ).
     7522      end.
     7523      procedure WaitFramRunPause:
     7524         define input  parameter iInterval as dec no-undo.
     7525         define variable vStart  as datetime-tz no-undo.
     7526         define variable vend    as datetime-tz no-undo.
     7527         define variable vint as int64 no-undo.
     7528         define variable vOk as logical no-undo.
     7529         vStart = now.
     7530         vend   = vStart.
     7531         publish "WaitFramPause" (iInterval,output vOk).
     7532         vend   =  now.
     7533         vint = vend - vStart.
     7534         vint = iInterval - vint / 1000.
     7535         if     not mWaitFramStop
     7536            and (   vint > 0
     7537                 or (    not vOk
     7538                     and iInterval eq ?
     7539                     )
     7540                 )
     7541         then
     7542            run waitfram-show-this (iInterval).
     7543         vend   =  now.
     7544         vint = vend - vStart.
     7545         vint = iInterval - vint / 1000.
     7546         if     not mWaitFramStop
     7547            and vint > 0
     7548         then do:
     7549            run gbl/pause.p (vint * 1000).
     7550         end.
     7551         if iInterval ne ?
     7552         then
     7553            publish "WaitFramStop".
     7554         waitfram-check-timeout().
     7555      end.
     7556      procedure WaitFramWaitFor:
     7557         define input  parameter iInterval as dec no-undo.
     7558         assign
     7559            mWaitFramStartProc   = now
     7560            mWaitFramStopUser    = no
     7561            mWaitFramStopTimeOut = no
     7562         .
     7563         block-wait:
     7564         do while not mWaitFramStop:
     7565            run WaitFramRunPause (iInterval).
     7566            if  waitfram-check-timeout()
     7567            then do:
     7568               leave block-wait.
     7569            end.
     7570         end.
     7571         run waitfram-hide.
     7572      end.
     7573   procedure waitfram-join :
     7574     define input  parameter p-line-1  as character no-undo .
     7575     define input  parameter p-line-2  as character no-undo .
     7576     define input  parameter p-line-3  as character no-undo .
     7577     define output parameter p-message as character no-undo .
     7578     do
     7579     on error undo, return error return-value
     7580     :
     7581       assign
     7582         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     7583                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     7584                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     7585       .
     7586     end.
     7587   end procedure.
     7588   function waitfram-join-function returns character
     7589     (input p-line-1 as character
     7590     ,input p-line-2 as character
     7591     ,input p-line-3 as character
     7592     ).
     7593     define variable v-message as character no-undo .
     7594     run waitfram-join in this-procedure
     7595       (input  p-line-1
     7596       ,input  p-line-2
     7597       ,input  p-line-3
     7598       ,output v-message
     7599       ) .
     7600     return v-message .
     7601   end function .
