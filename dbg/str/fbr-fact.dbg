     8420                           assign
     8421                               p-out-string = p-out-string + " ":U
     8422                           .
     8423                       end.
     8424                       when chr(7)
     8425                       then do:
     8426                           assign
     8427                               p-out-string = p-out-string + " ":U
     8428                           .
     8429                       end.
     8430                       when chr(8)
     8431                       then do:
     8432                           assign
     8433                               p-out-string = p-out-string + " ":U
     8434                           .
     8435                       end.
     8436                       when chr(9)
     8437                       then do:
     8438                           assign
     8439                               p-out-string = p-out-string + " ":U
     8440                           .
     8441                       end.
     8442                       when chr(29)
     8443                       then do:
     8444                           assign
     8445                               p-out-string = p-out-string + " ":U
     8446                           .
     8447                       end.
     8448                       when chr(10)
     8449                       then do:
     8450                           assign
     8451                               p-out-string = p-out-string + " ":U
     8452                           .
     8453                       end.
     8454                       when chr(13)
     8455                       then do:
     8456                           assign
     8457                               p-out-string = p-out-string + " ":U
     8458                           .
     8459                       end.
     8460                       otherwise do:
     8461                           assign
     8462                               p-out-string = p-out-string + v-current-char
     8463                           .
     8464                       end.
     8465                   end case.
     8466               end.
     8467           end.
     8468       end case.
     8469   end.
     8470   end .
     8471   procedure xmlchar-decode :
     8472   define input parameter p-in-string      as character        no-undo.
     8473   define output parameter p-out-string    as character        no-undo.
     8474       define variable v-position      as integer      no-undo.
     8475       define variable v-last-position as integer      no-undo.
     8476       define variable v-temp-integer  as integer      no-undo.
     8477       define variable v-current-char  as character    no-undo.
     8478       define variable v-next-char     as character    no-undo.
     8479       define variable v-success       as logical      no-undo.
     8480   do
     8481   on error undo, return error
     8482   :
     8483       assign
     8484           p-out-string = "":U
     8485           v-position   = 0
     8486       .
     8487       replace-cycle:
     8488       do while yes
     8489       on error undo, return error
     8490       :
     8491           assign
     8492               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     8493           .
     8494           if v-last-position <= v-position
     8495           then do:
     8496               if v-position = 0
     8497               then do:
     8498                   assign
     8499                       p-out-string = p-in-string
     8500                   .
     8501               end.
     8502               else do:
     8503                   assign
     8504                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     8505                   .
     8506               end.
     8507               leave replace-cycle.
     8508           end.
     8509           else do:
     8510               assign
     8511                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     8512                   v-position      = v-last-position
     8513                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     8514               .
     8515               if v-current-char = "#":U
     8516               then do:
     8517                   assign
     8518                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     8519                   .
     8520                   if v-last-position > 0
     8521                   then do:
     8522                       run xmlchar-read-integer in this-procedure
     8523                        (
     8524                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     8525                           , output v-temp-integer
     8526                           , output v-success
     8527                       ).
     8528                       if v-success = yes
     8529                       and v-temp-integer >= 1
     8530                       and v-temp-integer <= 255
     8531                       then do:
     8532                           assign
     8533                               p-out-string = p-out-string + chr( v-temp-integer )
     8534                               v-position   = v-last-position + 1
     8535                           .
     8536                       end.
     8537                       else do:
     8538                           assign
     8539                               p-out-string = p-out-string + "&":U
     8540                               v-position   = v-position   + 1
     8541                           .
     8542                       end.
     8543                   end.
     8544                   else do:
     8545                       assign
     8546                           p-out-string = p-out-string + "&":U
     8547                           v-position   = v-position   + 1
     8548                       .
     8549                   end.
     8550               end.
     8551               else do:
     8552                   case substring( p-in-string, v-position + 1, 3 )
     8553                   :
     8554                       when "lt;":U
     8555                       then do:
     8556                           assign
     8557                               p-out-string = p-out-string + "<":U
     8558                               v-position   = v-position   + 3
     8559                           .
     8560                       end.
     8561                       when "gt;":U
     8562                       then do:
     8563                           assign
     8564                               p-out-string = p-out-string + ">":U
     8565                               v-position   = v-position   + 3
     8566                           .
     8567                       end.
     8568                       otherwise do:
     8569                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     8570                           then do:
     8571                               assign
     8572                                   p-out-string = p-out-string + "&":U
     8573                                   v-position   = v-position   + 4
     8574                               .
     8575                           end.
     8576                           else do:
     8577                               case substring( p-in-string, v-position + 1, 5 )
     8578                               :
     8579                                   when "quot;":U
     8580                                   then do:
     8581                                       assign
     8582                                           p-out-string = p-out-string + '"':U
     8583                                           v-position   = v-position   + 5
     8584                                       .
     8585                                   end.
     8586                                   when "apos;":U
     8587                                   then do:
     8588                                       assign
     8589                                           p-out-string = p-out-string + "'":U
     8590                                           v-position   = v-position   + 5
     8591                                       .
     8592                                   end.
     8593                                   otherwise do:
     8594                                       assign
     8595                                           p-out-string = p-out-string + "&":U
     8596                                       .
     8597                                   end.
     8598                               end case.
     8599                           end.
     8600                       end.
     8601                   end case.
     8602               end.
     8603           end.
     8604       end.
     8605   end.
     8606   end .
     8607   procedure xmlchar-read-integer :
     8608   define input parameter p-input-string      as character        no-undo.
     8609   define output parameter p-output-integer   as integer          no-undo.
     8610   define output parameter p-success       as logical          no-undo.
     8611   do
     8612   on error undo, return error
     8613   :
     8614       assign
     8615           p-output-integer = integer( p-input-string )
     8616       no-error.
     8617       if error-status :error
     8618       then do:
     8619           assign
     8620               p-success           = no
     8621               p-output-integer    = 0
     8622           .
     8623       end.
     8624       else do:
     8625           assign
     8626               p-success           = yes
     8627           .
     8628       end.
     8629   end.
     8630   end.
     8631   define variable mMRCCode  as logical    no-undo.
     8632   define variable mTypeMark as character  no-undo.
     8633   function IS-NeedMark returns logical
     8634   ( input ib-code as integer  ,
     8635     input ib-str as character ):
     8636      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     8637      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     8638                                    and buf_prod-bc-attr.b-str  eq ib-str
     8639                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     8640        no-lock no-error.
     8641      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     8642   end.
     8643   function repTegforDm return char
     8644   (iDM as char ):
     8645       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     8646       define variable vteg as character no-undo.
     8647       define variable oDM as character no-undo.
     8648       define variable vi as integer no-undo.
     8649       oDM = iDm.
     8650       do vi = 1 to num-entries(vTeglist):
     8651          vTeg = entry(vi,vTeglist).
     8652          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     8653       end.
     8654       return oDM.
     8655   end.
     8656   function repSpecSimbforDm return char
     8657   (iDM as char ):
     8658       define variable oDM as character no-undo.
     8659     run
     8660       xmlchar-decode(iDM, output oDM).
     8661     return repTegforDm (oDM).
     8662   end.
     8663   function CheckGtin return logical
     8664   (iGtin as char):
     8665      define variable bar_code as character no-undo.
     8666      define variable vGtin as logical no-undo init "yes".
     8667      if length(iGtin) eq 14
     8668      then do:
     8669         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     8670         run str/chk-sum.p
     8671          (input-output bar_code ) no-error .
     8672         if iGtin ne  bar_code
     8673         then
     8674            vGtin = no.
     8675      end.
     8676      else
     8677         vGtin = no.
     8678      return vgtin.
     8679   end.
     8680   function repSpecSimbforXlm return char
     8681   (iDM as char ):
     8682       iDM = replace(iDM,chr(29),"").
     8683       return iDM.
     8684   end.
     8685   function getGtinByDM return char
     8686   (IDM as char):
     8687      define variable VTXT as char no-undo.
     8688      define variable vGtin as char no-undo.
     8689      vTXt = IdM.
     8690      vGtin = IDM.
     8691      if    length(vtxt) > 14
     8692      then do:
     8693         if   vtxt begins "(01)"
     8694                or vtxt begins "(02)"
     8695         then
     8696            vGtin = substring(vtxt,5,14).
     8697         else if   (vtxt begins "01"
     8698                or vtxt begins "02" )
     8699                and (   (    substring(iDm,17,2) eq "21"
     8700                         and length(vtxt) >= 21)
     8701                     or substring(iDm,17,2) eq "37"
     8702                     or substring(iDm,17,4) eq "(37)" )
     8703         then do:
     8704            vGtin = substring(vtxt,3,14).
     8705            if not checkGtin(vGtin)
     8706            then
     8707               vGtin = substring(vtxt,1,14).
     8708         end.
     8709         else if     length(vtxt) eq 14 + 7 + 4 + 4
     8710             or length(vtxt) eq 14 + 7 + 4
     8711             or length(vtxt) eq 14 + 7
     8712         then
     8713            vGtin = substring(vtxt,1,14).
     8714      end.
     8715      if not checkGtin(vGtin)
     8716      then
     8717         vGtin = "".
     8718      return vgtin.
     8719   end.
     8720   function getGdsCodeByGtin return int
     8721   (iGtin as char):
     8722      define buffer prod-bc  for ub.prod-bc.
     8723      define buffer bar-code for ub.bar-code.
     8724      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     8725      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     8726      return if avail bar-code then bar-code.gds-code else ?.
     8727   end.
     8728   function getQntyCodeByGtin return decimal
     8729   (iGtin as char):
     8730      define buffer prod-bc  for ub.prod-bc.
     8731      define buffer bar-code for ub.bar-code.
     8732      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     8733      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     8734      return if avail bar-code then bar-code.cli-base-rate else ?.
     8735   end.
     8736   function getGdsCodeByDM return int
     8737   (iDm as char):
     8738      define variable vGtin as char no-undo.
     8739      define buffer prod-bc for ub.prod-bc.
     8740      vGtin  = getGtinByDM (IDM ).
     8741      return getGdsCodeByGtin (vGtin).
     8742   end.
     8743   function ChekTypeMarkByGds return logical
     8744   (iGds-code as integer ):
     8745      define buffer goods-attr for ub.goods-attr.
     8746      find first goods-attr where goods-attr.gds-code   = iGds-code
     8747                              and goods-attr.attr-code  = 'mark-type':U
     8748      no-lock no-error.
     8749      if available goods-attr
     8750      then do:
     8751         mTypeMark = goods-attr.attr-value.
     8752         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     8753           .
     8754      end.
     8755      else
     8756         return no.
     8757   end.
     8758   function ChekTypeMarkByDm return logical
     8759   (iDM as char ):
     8760      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     8761   end.
     8762   function ChekTypeMarkByGtin return logical
     8763   (iGtin as char ):
     8764      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     8765   end.
     8766   function GetNextElement return character
     8767     (input iAllTeg        as logical
     8768     ,output oteg          as character
     8769     ,output otegval       as character
     8770     ,input-output pstr    as character
     8771      ):
     8772        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     8773        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     8774        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     8775        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     8776        define variable vTeg as character no-undo.
     8777        define variable vLength as integer no-undo.
     8778        define variable vi as integer no-undo.
     8779        define variable vj as integer no-undo.
     8780        define buffer code for ub.code.
     8781        find first code where Code.parent eq "MarkType"
     8782                          and Code.CodeValue   eq mTypeMark
     8783                          no-lock no-error.
     8784        if     available code
     8785           and Code.misc1 ne ""
     8786           and Code.misc1 ne ?
     8787        then do:
     8788           integer (Code.misc1) no-error.
     8789           if not error-status:error
     8790           then
     8791             entry (4,vlistleng) = Code.misc1.
     8792        end.
     8793        if iAllTeg
     8794        then
     8795           assign
     8796              vlistElem     = vlistElem    + vlistElemDop
     8797              vlistleng     = vlistleng    + vlistlengDop
     8798           .
     8799        else if mMRCCode
     8800        then
     8801           assign
     8802              vlistElem     = vlistElem    + ",(8005),8005"
     8803              vlistleng     = vlistleng    + ",000006,0006"
     8804           .
     8805       block-elem:
     8806       do vi = 1 to num-entries(vlistElem):
     8807          vTeg = entry(vi,vlistElem).
     8808          if pstr begins vTeg
     8809          then do:
     8810             if    vTeg eq "21"
     8811             then
     8812                vLength = index(pstr,chr(29)) - 2 no-error.
     8813             if vLength  <= 0
     8814             then
     8815                vLength = int(entry(vi,vlistleng)).
     8816             otegval = substring (pstr,length(vteg) + 1, vLength).
     8817             oteg = replace(replace(vteg,")",""),"(","").
     8818             vTeg = vteg + otegval.
     8819             otegval = replace(otegval,chr(29),"").
     8820             oteg = replace(replace(oteg,")",""),"(","").
     8821             pstr = substring (pstr,length(vTeg)+ 1).
     8822             vTeg = replace(vTeg,chr(29),"").
     8823             leave block-elem.
     8824          end.
     8825          else
     8826             vTeg = "".
     8827       end.
     8828       return vteg.
     8829   end.
     8830   function GetCodeIdent return character
     8831   (iDm as char):
     8832      define variable Velement   as character no-undo init "first".
     8833      define variable oCodeIdent as character no-undo.
     8834      define variable vteg as character no-undo.
     8835      define variable vtegval as character no-undo.
     8836      define variable vGtin as character no-undo.
     8837      define buffer marking for ub.marking.
     8838      for first marking no-lock where
     8839                marking.mark eq iDm
     8840            and marking.unit-ext = "LEVEL2"
     8841      :
     8842        return iDm.
     8843      end.
     8844      vGtin  = getGtinByDM (iDm ).
     8845      ChekTypeMarkByDm(idm).
     8846      if iDm begins 'tech_':U
     8847      then
     8848         oCodeIdent = iDm.
     8849      else if length(iDm) < 21
     8850      then do:
     8851         find first marking where marking.mark eq idm
     8852         no-lock no-error.
     8853         oCodeIdent = if available marking then marking.mark else  ?.
     8854      end.
     8855      else if     length(iDm) eq 29
     8856         and not iDm begins "01"
     8857         and not iDm begins "02"
     8858      then
     8859         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     8860      else  if     length(iDm) >= 24
     8861               and (  iDm begins "01"
     8862                   or iDm begins "02")
     8863               and  substring(iDm,17,2) ne "21"
     8864      then do:
     8865         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     8866                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     8867         then
     8868            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     8869         else
     8870            oCodeIdent = iDM.
     8871      end.
     8872      else  if     (   length(iDm) eq 25
     8873                    or length(iDm) eq 21)
     8874               and (not iDm begins "01"
     8875               and  not iDm begins "02")
     8876      then
     8877         oCodeIdent = substring(iDm,1,21).
     8878      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     8879      then
     8880         oCodeIdent = substring(iDm,1,21).
     8881      else do while Velement ne "" and idm ne "":
     8882         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     8883         oCodeIdent = oCodeIdent + Velement.
     8884      end.
     8885      return oCodeIdent.
     8886   end.
     8887   function GetTegCod return character
     8888   (icodeIdent as char, iTeg as char):
     8889      define variable Velement   as character no-undo init "first".
     8890      define variable oTeg as character no-undo init ?.
     8891      define variable vteg as character no-undo.
     8892      define variable vtegval as character no-undo.
     8893      if     ((length(icodeIdent) eq 21
     8894         and not icodeIdent begins "01"
     8895         and not icodeIdent begins "02")
     8896         or
     8897             ( length(icodeIdent) eq 25
     8898               and not icodeIdent begins "01"
     8899               and not icodeIdent begins "02"))
     8900      then do:
     8901         if iTeg eq "01" or iTeg eq "02"
     8902         then
     8903            oTeg = substring(icodeIdent,1,21).
     8904         else  if  iTeg eq "21"
     8905         then
     8906            oTeg = substring(icodeIdent,15,7).
     8907      end.
     8908      else do:
     8909         ChekTypeMarkByDm(icodeIdent).
     8910         block-teg:
     8911            do while Velement ne "" and icodeIdent ne "":
     8912            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     8913            if    Velement begins iTeg
     8914               or Velement begins "(" + iTeg + ")"
     8915            then do:
     8916               oTeg = vtegval.
     8917               leave block-teg.
     8918            end.
     8919         end.
     8920      end.
     8921      return oTeg.
     8922   end.
     8923   function isOAD return logical
     8924   (icodeIdent as character):
     8925      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     8926   end.
     8927   function isMark return logical
     8928   (icodeIdent as character):
     8929      define buffer buf_marking for ub.marking.
     8930      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     8931             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     8932   end.
     8933   function addBracketForCode return character
     8934   (icodeIdent as char):
     8935      define variable Velement   as character no-undo init "first".
     8936      define variable oTeg as character no-undo.
     8937      define variable vteg as character no-undo.
     8938      define variable vtegval as character no-undo.
     8939      define buffer marking for ub.marking.
     8940      find first marking no-lock where
     8941                 marking.mark begins icodeIdent no-error.
     8942      if    not ChekTypeMarkByDm(icodeIdent)
     8943         or length(icodeIdent) le 24
     8944         or (avail marking and marking.unit-ext = "LEVEL2")
     8945      then
     8946         oTeg = icodeIdent.
     8947      else do:
     8948         if (  icodeIdent begins "01"
     8949            or icodeIdent begins "02"
     8950            ) and CheckGtin(substring (icodeIdent,3,14))
     8951            and substring (icodeIdent,17,2) eq "21"
     8952         then do:
     8953            mMRCCode = yes.
     8954            ChekTypeMarkByDm(icodeIdent).
     8955            block-teg:
     8956            do while Velement ne "" and icodeIdent ne "":
     8957               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     8958               if vteg ne ""
     8959               then
     8960                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     8961            end.
     8962            mMRCCode = no.
     8963         end.
     8964         else do:
     8965            oTeg = icodeIdent.
     8966         end.
     8967      end.
     8968      return oTeg.
     8969   end.
     8970   function getlevelByCodId return int
     8971   (iCode as char):
     8972      define variable vLength as int no-undo.
     8973      define variable vLevel  as int no-undo.
     8974      if not ChekTypeMarkByDM (icode) then return ?.
     8975      vLength = length(iCode).
     8976      if    vLength eq 18
     8977         or vLength eq 20
     8978      then
     8979         Vlevel = 4.
     8980      else if vLength eq 21
     8981      then
     8982         Vlevel = 1.
     8983      else if vLength eq 25
     8984      then do:
     8985         if  iCode begins "01"
     8986         then
     8987            Vlevel = 3.
     8988         else
     8989            Vlevel = 1.
     8990      end.
     8991      else if     vLength >= 26
     8992              and vLength <= 46
     8993      then do:
     8994         if    substring(iCode,17,2) eq "11"
     8995            or substring(iCode,17,2) eq "13"
     8996            or (    substring(iCode,17,2) eq "21"
     8997                and vLength >= 33
     8998                and substring(iCode,26,4) ne "8005")
     8999         then
     9000            Vlevel = 4.
     9001         else if    vLength eq 31
     9002                 or vLength eq 38
     9003                 or vLength eq 39
     9004                 or vLength eq 45
     9005         then
     9006            Vlevel = 1.
     9007         else if    vLength eq 35
     9008                 or vLength eq 43
     9009         then
     9010            Vlevel = 3.
     9011         else
     9012            Vlevel = ?.
     9013      end.
     9014      else
     9015         Vlevel = ?.
     9016      return Vlevel.
     9017   end.
     9018   function getLevelMotpBycodid return character
     9019   (iDm as char):
     9020      define variable vLevel as integer no-undo.
     9021      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     9022      vLevel = getlevelByCodId(iDm).
     9023      if    vLevel eq ?
     9024         or vLevel < 1
     9025         or vLevel > 6
     9026      then
     9027         return ?.
     9028      else
     9029         return entry(vlevel,vList).
     9030   end.
     9031   function getLevelUTDByLevelMotp return character
     9032   (iUnit as char):
     9033      define variable vLevel as integer no-undo.
     9034      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     9035      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     9036      vLevel = lookup(iUnit,vListMOTP).
     9037      if    vLevel eq ?
     9038         or vLevel < 1
     9039         or vLevel > 4
     9040      then
     9041         return ?.
     9042      else
     9043         return entry(vlevel,vListutd).
     9044   end.
     9045   function getLevelMotpByDM return character
     9046   (iDm as char):
     9047      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     9048   end.
     9049   function getLevelUTDByCodId return character
     9050   (iDm as char):
     9051      define variable vLevel as integer no-undo.
     9052      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     9053      vLevel = getlevelByCodId(iDm).
     9054      if    vLevel eq ?
     9055         or vLevel < 1
     9056         or vLevel > 4
     9057      then
     9058         return ?.
     9059      else
     9060         return entry(vlevel,vList).
     9061   end.
     9062   function getLevelUTDByDM return character
     9063   (iDm as char):
     9064      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     9065   end.
     9066   define variable mNotMarkQnty as logical no-undo.
     9067   function getQntyUTDByCodId return decimal
     9068   (iDM as char):
     9069      define variable vLevel as integer no-undo.
     9070      define variable vList as character no-undo init "1,5,10,500".
     9071      define variable vGtin as character no-undo.
     9072      define variable vqnty as decimal no-undo init ?.
     9073      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     9074      if vqnty eq ?
     9075      then do:
     9076         if not mNotMarkQnty
     9077         then do:
     9078            define buffer marking for ub.marking.
     9079            define variable vCodident as character no-undo.
     9080            vCodident = GetCodeIdent(idm).
     9081            find first marking where marking.mark begins vCodident no-lock no-error.
     9082            if     available marking
     9083               and marking.box-qnty ne ?
     9084            then
     9085               return marking.box-qnty.
     9086         end.
     9087         vGtin = getGtinByDm(iDM).
     9088         if ChekTypeMarkByGtin (vGtin)
     9089         then do:
     9090            vLevel = getlevelByCodId(iDM).
     9091            if     vLevel >= 1
     9092               and vLevel <= 4
     9093            then
     9094               vqnty = int(entry(vlevel,vList)).
     9095         end.
     9096         else
     9097            vqnty = getQntyCodeByGtin(vgtin).
     9098      end.
     9099      return vqnty.
     9100   end.
     9101   function getQntyUTDByDM return decimal
     9102   (iDm as char):
     9103      define variable vDM as character no-undo.
     9104      if     length (iDm) ne 25
     9105         and length (iDm) ne 29
     9106         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     9107      then
     9108         vDM = substring (iDm,1,length (iDm) - 6 ).
     9109      else
     9110         vDM = substring (iDm,1,length (iDm) - 4 ).
     9111      return getQntyUTDByCodId(vDM).
     9112   end.
     9113   function getMRC4 return decimal
     9114   (iMRC as char):
     9115      define variable oMrc     as decimal no-undo init ?.
     9116      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     9117      define variable vi       as integer no-undo.
     9118      define variable vfound   as integer no-undo.
     9119      define variable vposStart   as integer no-undo.
     9120      do:
     9121      OMRc = 0.
     9122      do vi = 1 to 4:
     9123         define variable vsimb as character no-undo.
     9124         vsimb = substring(iMRC,vi,1).
     9125         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     9126         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     9127         if vfound > 0
     9128         then
     9129            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     9130         end.
     9131         OMRc = OMRc / 100.
     9132      end.
     9133      return OMRc.
     9134   end.
     9135   function getMRCByDM return decimal
     9136   (iDm as char):
     9137      define variable vMRC     as character no-undo.
     9138      define variable oMrc     as decimal no-undo init ?.
     9139      define variable Velement as character no-undo init "empty".
     9140      define variable vteg as character no-undo.
     9141      define variable vtegval as character no-undo.
     9142      if    length(idm) eq 14 + 7 + 4 + 4
     9143         or length(idm) eq 14 + 7 + 4
     9144      then do:
     9145         vMRC = substring(idm,22,4).
     9146         omrc = getMRC4(vMRC).
     9147      end.
     9148      else do:
     9149          ChekTypeMarkByDm(iDm).
     9150          block-mrc:
     9151          do while Velement ne "" and idm ne "":
     9152             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     9153             if Velement begins "8005"
     9154             then do:
     9155                vMRC = substring(Velement,5,6).
     9156                leave block-mrc.
     9157             end.
     9158             else if Velement begins "(8005)"
     9159             then do:
     9160                vMRC = substring(Velement,7,6).
     9161                leave block-mrc.
     9162             end.
     9163          end.
     9164          if vMRC ne ""
     9165          then
     9166             OMRc = dec(vmrc) / 100 no-error.
     9167      end.
     9168      return OMRc.
     9169   end.
     9170   function MoveDate return Date
     9171   (idate as date,
     9172    iMonth as int64):
     9173      define variable vMonth   as int64 no-undo.
     9174      define variable vYear    as int64 no-undo.
     9175      define variable vDateNew as date  no-undo.
     9176       define variable vDay     as int64 no-undo.
     9177       vMonth = month(iDate) + iMonth.
     9178       vYear =  year(iDate).
     9179       if vMonth <= 0
     9180       then assign
     9181          vMonth = vMonth + 12
     9182           vYear  = vYear - 1
     9183       .
     9184       else if vMonth > 12
     9185       then assign
     9186          vMonth = vMonth - 12
     9187           vYear  = vYear + 1
     9188       .
     9189       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     9190       do while error-status:error eq yes:
     9191          VDay = vDay + 1.
     9192          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     9193       end.
     9194       if VDay > 0
     9195       then
     9196          vDateNew + 1.
     9197       return vDateNew.
     9198   end.
     9199   procedure checkEMRC:
     9200   define input  parameter iDm as character no-undo.
     9201   define output parameter vok as logical   no-undo init yes.
     9202      define variable v-value-emrc as character no-undo.
     9203      define variable v-type-emrc  as character no-undo.
     9204      define variable vDateIso     as character no-undo.
     9205      define variable vMRC         as decimal no-undo.
     9206      define variable vqnty        as decimal no-undo.
     9207      define variable vPrice       as decimal no-undo.
     9208      define variable vparent      as character no-undo.
     9209      define variable vgds-code    as integer no-undo.
     9210      define buffer code for ub.code.
     9211      vMRC = getMRCByDM(iDm).
     9212      if vMRC > 0
     9213      then do:
     9214         vgds-code = getGdsCodeByDM(iDm).
     9215         vqnty     = getQntyUTDByDM(iDm).
     9216               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     9217            (
     9218             input   vgds-code
     9219            ,input   'emrc-type':U
     9220            ,output   v-value-emrc
     9221            ,output   v-type-emrc
     9222          ) no-error.
     9223          if     v-value-emrc ne ""
     9224             and v-value-emrc ne ?
     9225          then do:
     9226             vDateIso = iso-date(today).
     9227             vPrice = vMRC / vqnty.
     9228             vparent ="emc" + chr(4) + v-value-emrc.
     9229             find last code where Code.parent      eq vparent
     9230                              and Code.code        le vDateIso
     9231                              and code.status_  eq 0
     9232             no-lock no-error.
     9233             if not available code or ( vPrice  >= dec(Code.CodeValue))
     9234             then
     9235                vOk = true .
     9236             else do:
     9237                 define variable vText      as character no-undo.
     9238                 define variable vDate      as date no-undo.
     9239                 define variable vDateLast  as character no-undo.
     9240                 define variable vDateFirst as character no-undo.
     9241                 define variable vDate3     as date no-undo.
     9242                 vdate = date(code.misc1).
     9243                 vDateLast = code.misc1.
     9244                 vDate3 = MoveDate(today, - 3 ).
     9245                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     9246                                      string(vDate3  , "99/99/9999"),
     9247                                      string(vDate   , "99/99/9999")
     9248                                      ).
     9249                 vdateIso = iso-date(vdate3).
     9250                 find last code  where Code.parent      eq vparent
     9251                                   and Code.code        le vDateIso
     9252                                   and code.status_  eq 0 no-lock no-error.
     9253                 if available code
     9254                 then
     9255                    vDateIso = code.code.
     9256                 vDateFirst = vDateIso.
     9257                 vDateLast = iso-date(vdate).
     9258                 define variable vGood as logical no-undo.
     9259                 define variable vDateSale as date no-undo.
     9260                 define buffer bcode for code.
     9261                 for last code where Code.parent   eq vparent
     9262                                 and code.status_  eq 0
     9263                                 and code.code     < vDateLast
     9264                                 and code.code     >= vDateFirst
     9265                 no-lock:
     9266                    find first bcode where bCode.parent   eq vparent
     9267                                       and bcode.status_  eq 0
     9268                                       and bcode.code     > code.code no-lock no-error.
     9269                    if available bcode
     9270                    then do:
     9271                       if vPrice < dec(Code.CodeValue)
     9272                       then
     9273                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     9274                                                     chr(10),
     9275                                                     string(    date( code.misc1)       ,"99/99/9999"),
     9276                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     9277                                                     ).
     9278                       else do:
     9279                          vGood = yes.
     9280                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     9281                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     9282                                                     chr(10),
     9283                                                     string(    date( code.misc1)         ,"99/99/9999"),
     9284                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     9285                                                     string(         vDateSale            ,"99/99/9999"),
     9286                                                     string(vDateSale - today)
     9287                                                     ).
     9288                       end.
     9289                    end.
     9290                 end.
     9291                 if vgood
     9292                 then do:
     9293                    define variable choice as integer no-undo .
     9294                    run gbl/d-askw.w (input "Уточнение"
     9295                           ,input  vText
     9296                           ,input "|"
     9297                           ,input "Принять|Вернуть"
     9298                           ,input "Принять данный товар|Вернуть товар постащику"
     9299                           ,input 1
     9300                           ,input 2
     9301                           ,output choice) no-error.
     9302                    vok = choice eq 1.
     9303                 end.
     9304                 else
     9305                    vok =false.
     9306             end.
     9307          end.
     9308      end.
     9309   end.
     9310   function addGs2Mark return character
     9311   (iMark as char):
     9312      define variable vDM   as character no-undo.
     9313      define variable vIdx  as integer   no-undo.
     9314      if index(iMark,chr(29),1) > 0
     9315      then return iMark.
     9316      if substring(iMark,26,4) = "8005" then
     9317      do:
     9318        vIdx = index(iMark,"93",26 + 4 + 5).
     9319        if vIdx > 1 then do:
     9320          vDM = substitute("&1&4&2&4&3",
     9321                           substring(iMark,1,25),
     9322                           substring(iMark,26,vIdx - 25 - 1),
     9323                           substring(iMark,vIdx),
     9324                           chr(29)) no-error.
     9325          vIdx = index(vDm,"240",vIdx + 4).
     9326          if vIdx > 0 then
     9327          do:
     9328            vDM = substitute("&1&3&2",
     9329                             substring(vDm,1,vIdx - 1),
     9330                             substring(vDm,vIdx),
     9331                             chr(29)) no-error.
     9332          end.
     9333        end.
     9334        else
     9335          vDM = substitute("&1&3&2",
     9336                           substring(iMark,1,25),
     9337                           substring(iMark,26),
     9338                           chr(29)) no-error.
     9339      end.
     9340      else if substring(iMark,32,2) = "91" then
     9341      do:
     9342        vIdx = index(iMark,"92",32).
     9343        if vIdx > 1 then
     9344          vDM = substitute("&1&4&2&4&3",
     9345                           substring(iMark,1,31),
     9346                           substring(iMark,32,vIdx - 31 - 1),
     9347                           substring(iMark,vIdx),
     9348                           chr(29)) no-error.
     9349        else
     9350          vDM = substitute("&1&3&2",
     9351                           substring(iMark,1,31),
     9352                           substring(iMark,32),
     9353                           chr(29)) no-error.
     9354      end.
     9355      else if substring(iMark,39,2) = "91" then
     9356      do:
     9357        vIdx = index(iMark,"92",38).
     9358        if vIdx > 1 then
     9359          vDM = substitute("&1&4&2&4&3",
     9360                           substring(iMark,1,38),
     9361                           substring(iMark,39,vIdx - 38 - 1),
     9362                           substring(iMark,vIdx),
     9363                           chr(29)) no-error.
     9364        else
     9365          vDM = substitute("&1&3&2",
     9366                           substring(iMark,1,38),
     9367                           substring(iMark,39),
     9368                           chr(29)) no-error.
     9369      end.
     9370      else if substring(iMark,25,2) = "93" then
     9371      do:
     9372        vIdx = index(iMark,"92",25).
     9373        if vIdx > 1 then
     9374          vDM = substitute("&1&4&2&4&3",
     9375                           substring(iMark,1,24),
     9376                           substring(iMark,25,vIdx - 24 - 1),
     9377                           substring(iMark,vIdx),
     9378                           chr(29)) no-error.
     9379        else
     9380          vIdx = index(iMark,"3103",25).
     9381          if vIdx > 0 then
     9382          vDM = substitute("&1&4&2&4&3",
     9383                           substring(iMark,1,24),
     9384                           substring(iMark,25,vIdx - 24 - 1),
     9385                           substring(iMark,vIdx),
     9386                           chr(29)) no-error.
     9387          else
     9388            vDM = substitute("&1&3&2",
     9389                             substring(iMark,1,24),
     9390                             substring(iMark,25),
     9391                             chr(29)) no-error.
     9392      end.
     9393      else if substring(iMark,32,2) = "93" then
     9394      do:
     9395        vDM = substitute("&1&3&2",
     9396              substring(iMark,1,31),
     9397              substring(iMark,32),
     9398              chr(29)) no-error.
     9399      end.
     9400      return if vDM <> "" then vDm else iMark.
     9401   end.
     9402   def var vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9403   function getattrUtdex returns char
     9404   (idb-num   as integer,
     9405    idoc-id   as integer,
     9406    iattrcode as character,
     9407    iExValue  as character  ):
     9408      define buffer utd-attr for utd-attr.
     9409      find first utd-attr where utd-attr.db-num eq idb-num
     9410                            and utd-attr.doc-id eq idoc-id
     9411                            and utd-attr.attr-code eq iattrcode
     9412      no-lock no-error.
     9413      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     9414   end.
     9415   function getattrUtd returns char
     9416   (idb-num   as integer,
     9417    idoc-id   as integer,
     9418    iattrcode as character ):
     9419     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     9420   end.
     9421   function setattrUtd returns logical
     9422   (idb-num   as integer,
     9423    idoc-id   as integer,
     9424    iattrcode as character,
     9425    iattrval  as character ):
     9426      define buffer utd-attr for utd-attr.
     9427      find first utd-attr where utd-attr.db-num eq idb-num
     9428                            and utd-attr.doc-id eq idoc-id
     9429                            and utd-attr.attr-code eq iattrcode
     9430      no-lock no-error.
     9431      if not available utd-attr
     9432      then do:
     9433         create utd-attr.
     9434         assign
     9435            utd-attr.db-num    = idb-num
     9436            utd-attr.doc-id    = idoc-id
     9437            utd-attr.attr-code = iattrcode
     9438            utd-attr.attr-value = iattrval
     9439         .
     9440      end.
     9441      else do:
     9442         if utd-attr.attr-value ne iattrval
     9443         then do:
     9444            find current utd-attr exclusive-lock no-error.
     9445            if available utd-attr
     9446            then
     9447               utd-attr.attr-value = iattrval.
     9448         end.
     9449      end.
     9450      release utd-attr.
     9451   end.
     9452   function GetAttrUtdlinesEx returns char
     9453   (idb-num   as integer,
     9454    idoc-id   as integer,
     9455    ilinenum  as integer,
     9456    iattrcode as character,
     9457    iExValue  as character  ):
     9458      define buffer utd-lines-attr for utd-lines-attr.
     9459      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     9460                                  and utd-lines-attr.doc-id    eq idoc-id
     9461                                  and utd-lines-attr.lineNum   eq ilineNum
     9462                                  and utd-lines-attr.attr-code eq iattrcode
     9463      no-lock no-error.
     9464      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
     9465   end.
     9466   function GetAttrUtdlines returns char
     9467   (idb-num   as integer,
     9468    idoc-id   as integer,
     9469    ilinenum  as integer,
     9470    iattrcode as character ):
     9471      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
     9472   end.
     9473   function setattrUtdlines returns logical
     9474   (idb-num   as integer,
     9475    idoc-id   as integer,
     9476    ilinenum  as integer,
     9477    iattrcode as character,
     9478    iattrval  as character ):
     9479      define buffer utd-lines-attr for utd-lines-attr.
     9480      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     9481                                  and utd-lines-attr.doc-id    eq idoc-id
     9482                                  and utd-lines-attr.lineNum   eq ilineNum
     9483                                  and utd-lines-attr.attr-code eq iattrcode
     9484      no-lock no-error.
     9485      if not available utd-lines-attr
     9486      then do:
     9487         if iattrval ne ?
     9488            and iattrval ne ""
     9489         then do:
     9490            create utd-lines-attr.
     9491            assign
     9492               utd-lines-attr.db-num    = idb-num
     9493               utd-lines-attr.doc-id    = idoc-id
     9494               utd-lines-attr.lineNum   = ilineNum
     9495               utd-lines-attr.attr-code = iattrcode
     9496               utd-lines-attr.attr-value = iattrval
     9497            .
     9498         end.
     9499      end.
     9500      else do:
     9501         if utd-lines-attr.attr-value ne iattrval
     9502         then do:
     9503            find current utd-lines-attr exclusive-lock no-error.
     9504            if available utd-lines-attr
     9505            then do:
     9506               if    iattrval eq ?
     9507                  or iattrval eq ""
     9508               then do:
     9509                  delete utd-lines-attr.
     9510               end.
     9511               else do:
     9512                  utd-lines-attr.attr-value = iattrval.
     9513               end.
     9514            end.
     9515         end.
     9516      end.
     9517      release utd-lines-attr.
     9518   end.
     9519   function GetAttrUtdMarkingLinesEx returns char
     9520   (idb-num   as integer,
     9521    idoc-id   as integer,
     9522    ilinenum  as integer,
     9523    imark     as character,
     9524    iattrcode as character,
     9525    iExValue  as character  ):
     9526      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
     9527      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
     9528                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     9529                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     9530                                          and utd-marking-lines-attr.mark      eq imark
     9531                                          and utd-marking-lines-attr.attr-code eq iattrcode
     9532      no-lock no-error.
     9533      return if not available utd-marking-lines-attr  then iExValue    else  utd-marking-lines-attr.attr-value.
     9534   end.
     9535   function GetAttrUtdMarkingLines returns char
     9536   (idb-num   as integer,
     9537    idoc-id   as integer,
     9538    ilinenum  as integer,
     9539    imark     as character,
     9540    iattrcode as character ):
     9541      return GetAttrUtdMarkingLinesEx (idb-num,idoc-id,ilinenum,imark,iattrcode,?).
     9542   end.
     9543   function setattrUtdMarkingLines returns logical
     9544   (idb-num   as integer,
     9545    idoc-id   as integer,
     9546    ilinenum  as integer,
     9547    imark     as character,
     9548    iattrcode as character,
     9549    iattrval  as character ):
     9550      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
     9551      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
     9552                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     9553                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     9554                                          and utd-marking-lines-attr.mark      eq imark
     9555                                          and utd-marking-lines-attr.attr-code eq iattrcode
     9556      no-lock no-error.
     9557      if not available utd-marking-lines-attr
     9558      then do:
     9559         if iattrval ne ?
     9560            and iattrval ne ""
     9561         then do:
     9562            create utd-marking-lines-attr.
     9563            assign
     9564               utd-marking-lines-attr.db-num     = idb-num
     9565               utd-marking-lines-attr.doc-id     = idoc-id
     9566               utd-marking-lines-attr.lineNum    = ilineNum
     9567               utd-marking-lines-attr.mark       = imark
     9568               utd-marking-lines-attr.attr-code  = iattrcode
     9569               utd-marking-lines-attr.attr-value = iattrval
     9570            .
     9571         end.
     9572      end.
     9573      else do:
     9574         if utd-marking-lines-attr.attr-value ne iattrval
     9575         then do:
     9576            find current utd-marking-lines-attr exclusive-lock no-error.
     9577            if available utd-marking-lines-attr
     9578            then do:
     9579               if    iattrval eq ?
     9580                  or iattrval eq ""
     9581               then do:
     9582                  delete utd-marking-lines-attr.
     9583               end.
     9584               else do:
     9585                  utd-marking-lines-attr.attr-value = iattrval.
     9586               end.
     9587            end.
     9588         end.
     9589      end.
     9590      release utd-marking-lines-attr.
     9591   end.
     9592   def var vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9593   def var vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9594   def var vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9595   procedure gen-key-rec :
     9596     define input  parameter p-tbl-name    as character no-undo.
     9597     define input  parameter p-bh_tbl-name as handle    no-undo.
     9598     define output parameter p-key-rec     as character no-undo.
     9599     do
     9600     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     9601     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     9602     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     9603     :
     9604       define variable fh               as handle    no-undo .
     9605       define variable v-ok             as logical   no-undo .
     9606       define variable v-inform         as character no-undo .
     9607       define variable v-ind            as integer   no-undo .
     9608       define variable v-idx-field-qnty as integer   no-undo .
     9609       if p-tbl-name = ?
     9610         or p-tbl-name = "":U
     9611       then do:
     9612         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info69 ).
     9613       end.
     9614       if not p-bh_tbl-name:available then do:
     9615         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info69, p-tbl-name ).
     9616       end.
     9617       assign
     9618         p-key-rec = p-tbl-name
     9619         v-inform  = p-bh_tbl-name:index-information(1)
     9620         v-ind     = 2
     9621       .
     9622       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     9623       on error undo, return error
     9624       :
     9625         assign
     9626           v-inform = p-bh_tbl-name:index-information( v-ind )
     9627           v-ind    = v-ind + 1
     9628         .
     9629       end.
     9630       if v-inform = ?
     9631         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     9632         or entry( 3, v-inform, ",":U ) <> "1":U
     9633       then do:
     9634         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info69, p-tbl-name ).
     9635       end.
     9636       else do:
     9637         assign
     9638           v-idx-field-qnty = num-entries( v-inform ) - 4
     9639         .
     9640         if v-idx-field-qnty < 2 then do:
     9641           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info69, v-inform, p-tbl-name ).
     9642         end.
     9643         do v-ind = 1 to v-idx-field-qnty by 2
     9644         on error undo, return error
     9645         :
     9646           assign
     9647             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     9648             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     9649           .
     9650         end.
     9651       end.
     9652       if p-key-rec = ? then do:
     9653         assign
     9654           p-key-rec = "":U
     9655         .
     9656         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info69, p-tbl-name ).
     9657       end.
     9658     end.
     9659     return.
     9660   end procedure.
     9661   procedure gen-where-keyr-tab :
     9662     define input  parameter i-tableSerach as character no-undo.
     9663     define input  parameter i-tablekey   as character  no-undo.
     9664     define input  parameter p-key-rec    as character  no-undo.
     9665     define input  parameter p-key-handle as handle     no-undo .
     9666     define input  parameter p-db-name    as character  no-undo .
     9667     define input  parameter p-tt-handle  as handle     no-undo .
     9668     define output parameter o-Where      as character  no-undo.
     9669     do
     9670     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     9671     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     9672     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     9673     :
     9674       define variable v-full-tbl-name  as character no-undo .
     9675       define variable bh_tbl-name      as handle    no-undo .
     9676       define variable fh_key           as handle    no-undo .
     9677       define variable fh_search        as handle    no-undo .
     9678       define variable v-field-num      as integer   no-undo .
     9679       define variable v-count-fld      as integer   no-undo .
     9680       define variable v-inform         as character no-undo .
     9681       define variable v-ind            as integer   no-undo .
     9682       define variable v-idx-field-qnty as integer   no-undo .
     9683       define variable v-field-name     as character no-undo .
     9684       define variable v-field-val      as character no-undo .
     9685       define variable v-word-link      as character no-undo .
     9686       define variable vTable           as character no-undo.
     9687       define variable bh_tbl-key       as handle    no-undo .
     9688       assign
     9689         p-key-rec = trim( p-key-rec )
     9690       .
     9691       if p-key-handle <> ? then do:
     9692         if not valid-handle(p-key-handle)
     9693            or p-key-handle:type <> "buffer"
     9694         then do:
     9695           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info69 ).
     9696         end.
     9697         if num-entries( p-key-rec, chr(3) ) > 1
     9698           or p-key-rec = ?
     9699           or p-key-rec = "":U
     9700         then do:
     9701           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info69, p-key-rec ).
     9702         end.
     9703       end.
     9704       else do:
     9705         if p-key-rec = ?
     9706           or p-key-rec = "":U
     9707         then do:
     9708           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info69 ).
     9709         end.
     9710       end.
     9711       assign
     9712         vTable = entry( 1 , p-key-rec, chr(3) )
     9713       .
     9714       if p-tt-handle <> ?
     9715         and ( not valid-handle(p-tt-handle)
     9716               or p-tt-handle:type <> "buffer"
     9717             )
     9718       then do:
     9719         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info69, vTable, chr(10) ).
     9720       end.
     9721       if p-tt-handle = ? then do:
     9722         assign
     9723           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     9724         .
     9725         create buffer bh_tbl-name for table v-full-tbl-name .
     9726       end.
     9727       else do:
     9728         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     9729       end.
     9730       assign
     9731         v-inform = bh_tbl-name:index-information(1)
     9732         v-ind    = 2
     9733       .
     9734       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     9735       on error undo, return error
     9736       :
     9737         assign
     9738           v-inform = bh_tbl-name:index-information( v-ind )
     9739           v-ind    = v-ind + 1
     9740         .
     9741       end.
     9742       if v-inform = ?
     9743         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     9744         or entry( 3, v-inform, ",":U ) <> "1":U
     9745       then do:
     9746         delete object bh_tbl-name no-error.
     9747         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info69, vTable ).
     9748       end.
     9749       assign
     9750         v-idx-field-qnty = num-entries( v-inform ) - 4
     9751       .
     9752       if v-idx-field-qnty < 2 then do:
     9753         delete object bh_tbl-name no-error.
     9754         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info69, v-inform, vTable ).
     9755       end.
     9756       assign
     9757         o-where     = "where":U
     9758         v-word-link = "":U
     9759         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     9760         v-count-fld = 0
     9761       .
     9762       if i-tablekey ne "" and i-tablekey ne ?
     9763       then do:
     9764         assign
     9765           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     9766         .
     9767         create buffer bh_tbl-key for table v-full-tbl-name .
     9768       end.
     9769       if i-tableSerach ne "" and i-tableSerach ne ?
     9770       then do:
     9771         delete object bh_tbl-name no-error.
     9772         assign
     9773           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     9774         .
     9775         create buffer bh_tbl-name for table v-full-tbl-name .
     9776       end.
     9777       block_where:
     9778       do v-ind = 1 to v-idx-field-qnty by 2
     9779       on error undo, return error
     9780       :
     9781         assign
     9782           v-count-fld = v-count-fld + 1
     9783         .
     9784         if p-key-handle = ?
     9785           and v-count-fld > v-field-num
     9786         then do:
     9787           leave block_where.
     9788         end.
     9789         define variable VfieldKeyTable as handle no-undo.
     9790         assign
     9791           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     9792           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     9793         .
     9794         if     bh_tbl-key ne ?
     9795         then do:
     9796            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     9797            if VfieldKeyTable eq ?
     9798            then next block_where.
     9799         end.
     9800         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     9801         then
     9802            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     9803         else
     9804            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     9805         if p-key-handle = ? then do:
     9806           assign
     9807             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     9808           .
     9809         end.
     9810         else do:
     9811           assign
     9812             fh_key = p-key-handle:buffer-field( v-field-name )
     9813           .
     9814           if fh_key = ?
     9815             or not valid-handle( fh_key )
     9816           then do:
     9817             delete object bh_tbl-name.
     9818             if     bh_tbl-key ne ?
     9819             then
     9820                delete object bh_tbl-key.
     9821             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info69, p-key-handle:name, v-field-name ).
     9822           end.
     9823           assign
     9824             v-field-val = fh_key:buffer-value
     9825           .
     9826         end.
     9827         if fh_search:data-type ="character":U then do:
     9828           assign
     9829             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     9830             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     9831             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     9832             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     9833             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     9834             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     9835             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     9836             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     9837             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     9838             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     9839             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     9840             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     9841             v-field-val = substitute( '"&1"', v-field-val )
     9842           .
     9843         end.
     9844         assign
     9845           o-where = substitute( "&1 &2", o-where, v-field-val )
     9846         .
     9847         if v-word-link = "":U then do:
     9848           assign
     9849             v-word-link = "and":U
     9850           .
     9851         end.
     9852       end.
     9853       delete object bh_tbl-name.
     9854       if     bh_tbl-key ne ?
     9855       then
     9856          delete object bh_tbl-key.
     9857       if p-key-handle = ?
     9858         and v-count-fld <> v-field-num
     9859       then do:
     9860         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info69, vTable ).
     9861       end.
     9862     end.
     9863   end procedure.
     9864   procedure gen-hn-keyr-tab :
     9865     define input  parameter i-tableSerach as character no-undo.
     9866     define input  parameter i-tablekey   as character no-undo.
     9867     define input  parameter p-key-rec    as character no-undo.
     9868     define input  parameter p-key-handle as handle    no-undo .
     9869     define input  parameter p-db-name    as character no-undo .
     9870     define input  parameter p-tt-handle  as handle    no-undo .
     9871     define input  parameter p-stts-lock  as integer   no-undo .
     9872     define output parameter o-hn         as handle    no-undo.
     9873     define variable v-full-tbl-name as character no-undo.
     9874     define variable v-where         as character no-undo.
     9875     define variable bh_tbl-name     as handle    no-undo.
     9876     define variable vTable          as character no-undo.
     9877     do
     9878     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     9879     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     9880     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     9881         run gen-where-keyr-tab(i-tableSerach,
     9882                                i-tablekey,
     9883                                p-key-rec,
     9884                                p-key-handle,
     9885                                p-db-name,
     9886                                p-tt-handle,
     9887                                output v-where).
     9888         if i-tableSerach ne "" and i-tableSerach ne ?
     9889         then do:
     9890            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     9891            create buffer bh_tbl-name for table v-full-tbl-name .
     9892         end.
     9893         else do:
     9894            if p-tt-handle = ? then do:
     9895               assign
     9896                  vTable = entry( 1 , p-key-rec, chr(3) )
     9897               .
     9898               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     9899               create buffer bh_tbl-name for table v-full-tbl-name .
     9900            end.
     9901            else do:
     9902               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     9903            end.
     9904         end.
     9905         if p-tt-handle = ? then do:
     9906            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     9907         end.
     9908         else do:
     9909            bh_tbl-name:find-first( v-where ) no-error .
     9910         end.
     9911         o-hn = bh_tbl-name.
     9912      end.
     9913   end procedure.
     9914   procedure gen-hn-keyr :
     9915     define input  parameter p-key-rec    as character no-undo.
     9916     define input  parameter p-key-handle as handle    no-undo .
     9917     define input  parameter p-db-name    as character no-undo .
     9918     define input  parameter p-tt-handle  as handle    no-undo .
     9919     define input  parameter p-stts-lock  as integer   no-undo .
     9920     define output parameter o-hn         as handle    no-undo.
     9921     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     9922   end.
     9923   procedure gen-row-keyr :
     9924     define input  parameter p-key-rec    as character no-undo.
     9925     define input  parameter p-key-handle as handle    no-undo .
     9926     define input  parameter p-db-name    as character no-undo .
     9927     define input  parameter p-tt-handle  as handle    no-undo .
     9928     define input  parameter p-stts-lock  as integer   no-undo .
     9929     define output parameter p-tbl-row    as rowid     no-undo.
     9930     define output parameter p-tbl-name   as character no-undo.
     9931     define variable vHn as handle no-undo.
     9932       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     9933       p-tbl-row = if vHn:available then vHn:rowid else ?.
     9934       p-tbl-name =  vHn:table.
     9935       delete object vHn no-error.
     9936     if p-tbl-row = ? then do:
     9937       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info69, p-tbl-name, p-key-rec ).
     9938     end.
     9939     else do:
     9940       return.
     9941     end.
     9942   end procedure.
     9943   procedure gen-key-fv :
     9944     define input  parameter p-key-rec    as character no-undo .
     9945     define output parameter p-field-list as character no-undo .
     9946     define output parameter p-value-list as character no-undo.
     9947     do
     9948     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     9949     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     9950     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     9951     :
     9952       define variable v-full-tbl-name  as character no-undo .
     9953       define variable bh_tbl-name      as handle    no-undo .
     9954       define variable v-tbl-name       as character no-undo .
     9955       define variable v-field-num      as integer   no-undo .
     9956       define variable v-count-fld      as integer   no-undo .
     9957       define variable v-inform         as character no-undo .
     9958       define variable v-ind            as integer   no-undo .
     9959       define variable v-idx-field-qnty as integer   no-undo .
     9960       define variable v-delim-key      as character no-undo .
     9961       if p-key-rec = ?
     9962         or p-key-rec = "":U
     9963       then do:
     9964         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info69 ).
     9965       end.
     9966       assign
     9967         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     9968         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     9969       .
     9970       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     9971       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info69 ).
     9972       assign
     9973         v-inform = bh_tbl-name:index-information(1)
     9974         v-ind    = 2
     9975       .
     9976       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     9977       on error undo, return error
     9978       :
     9979         assign
     9980           v-inform = bh_tbl-name:index-information( v-ind )
     9981           v-ind    = v-ind + 1
     9982         .
     9983       end.
     9984       if v-inform = ?
     9985         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     9986         or entry( 3, v-inform, ",":U ) <> "1":U
     9987       then do:
     9988         delete object bh_tbl-name no-error.
     9989         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info69, v-tbl-name ).
     9990       end.
     9991       assign
     9992         v-idx-field-qnty = num-entries( v-inform ) - 4
     9993       .
     9994       if v-idx-field-qnty < 2 then do:
     9995         delete object bh_tbl-name no-error.
     9996         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info69, v-inform, v-tbl-name ).
     9997       end.
     9998       assign
     9999         p-field-list = "":U
    10000         p-value-list = "":U
    10001         v-delim-key  = "":U
    10002         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
    10003         v-count-fld  = 0
    10004       .
    10005       block_where:
    10006       do v-ind = 1 to v-idx-field-qnty by 2
    10007       on error undo, return error
    10008       :
    10009         assign
    10010           v-count-fld = v-count-fld + 1
    10011         .
    10012         if v-count-fld > v-field-num then do:
    10013           leave block_where.
    10014         end.
    10015         assign
    10016           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
    10017           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
    10018         .
    10019         if v-ind = 1 then do:
    10020           assign
    10021             v-delim-key = chr(3)
    10022           .
    10023         end.
    10024       end.
    10025       delete object bh_tbl-name.
    10026       if v-count-fld <> v-field-num then do:
    10027         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info69, v-tbl-name ).
    10028       end.
    10029     end.
    10030   end procedure.
    10031   procedure gen-key-field :
    10032     define input  parameter p-table      as character no-undo .
    10033     define output parameter p-field-list as character no-undo .
    10034     do
    10035     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    10036     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
    10037     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
    10038     :
    10039       define variable v-full-tbl-name  as character no-undo .
    10040       define variable bh_tbl-name      as handle    no-undo .
    10041       define variable v-tbl-name       as character no-undo .
    10042       define variable v-field-num      as integer   no-undo .
    10043       define variable v-count-fld      as integer   no-undo .
    10044       define variable v-inform         as character no-undo .
    10045       define variable v-ind            as integer   no-undo .
    10046       define variable v-idx-field-qnty as integer   no-undo .
    10047       define variable v-delim-key      as character no-undo .
    10048       if p-table = ?
    10049         or p-table = "":U
    10050       then do:
    10051         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info69 ).
    10052       end.
    10053       assign
    10054         v-tbl-name      = p-table
    10055         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
    10056       .
    10057       create buffer bh_tbl-name for table v-full-tbl-name no-error .
    10058       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info69 ).
    10059       assign
    10060         v-inform = bh_tbl-name:index-information(1)
    10061         v-ind    = 2
    10062       .
    10063       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
    10064       on error undo, return error
    10065       :
    10066         assign
    10067           v-inform = bh_tbl-name:index-information( v-ind )
    10068           v-ind    = v-ind + 1
    10069         .
    10070       end.
    10071       if v-inform = ?
    10072         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
    10073         or entry( 3, v-inform, ",":U ) <> "1":U
    10074       then do:
    10075         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info69, v-tbl-name ).
    10076       end.
    10077       assign
    10078         v-idx-field-qnty = num-entries( v-inform ) - 4
    10079       .
    10080       if v-idx-field-qnty < 2 then do:
    10081         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info69, v-inform, v-tbl-name ).
    10082       end.
    10083       assign
    10084         p-field-list = "":U
    10085         v-delim-key  = "":U
    10086         v-count-fld  = 0
    10087       .
    10088       block_where:
    10089       do v-ind = 1 to v-idx-field-qnty by 2
    10090       on error undo, return error
    10091       :
    10092         assign
    10093           v-count-fld = v-count-fld + 1
    10094         .
    10095         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
    10096         if v-ind = 1 then do:
    10097           assign
    10098             v-delim-key = chr(3)
    10099           .
    10100         end.
    10101       end.
    10102       delete object bh_tbl-name.
    10103     end.
    10104   end procedure.
    10105   function AddUtdErrForTab returns logical
    10106   (idb-num         as integer ,
    10107    idoc-id         as integer ,
    10108    iTab            as character,
    10109    iObj            as handle ,
    10110    iCheckType      as character,
    10111    iCodeErr        as character,
    10112    iCheckObj       as character ):
    10113      define buffer utd-err for utd-err.
    10114      define buffer utd for utd.
    10115      find first utd where utd.db-num     eq idb-num
    10116                       and utd.doc-id     eq idoc-id
    10117                       and utd.Direction  eq 'Outbound'
    10118      no-lock no-error.
    10119      if available utd
    10120      then
    10121         return no.
    10122      define variable vRecKey as character no-undo.
    10123            run gen-key-rec (input iTab,
    10124                             input  iObj,
    10125                             output vRecKey).
    10126      find first utd-err where utd-err.db-num     eq idb-num
    10127                           and utd-err.doc-id     eq idoc-id
    10128                           and utd-err.CheckType  eq iCheckType
    10129                           and utd-err.CodeErr    eq iCodeErr
    10130                           and utd-err.CheckObj   eq iCheckObj
    10131      exclusive-lock no-error.
    10132      if not available utd-err
    10133      then do:
    10134         create utd-err.
    10135         assign
    10136            utd-err.db-num         = idb-num
    10137            utd-err.doc-id         = idoc-id
    10138            utd-err.CheckType      = iCheckType
    10139            utd-err.CodeErr        = iCodeErr
    10140            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
    10141            utd-err.reckey         = vRecKey
    10142            utd-err.qnty           = 1
    10143         .
    10144      end.
    10145      else
    10146         utd-err.qnty = utd-err.qnty + 1.
    10147      return utd-err.qnty eq 1.
    10148   end.
    10149   function AddUtdErr returns logical
    10150   (idb-num         as integer ,
    10151    idoc-id         as integer ,
    10152    iObj            as handle ,
    10153    iCheckType      as character,
    10154    iCodeErr        as character,
    10155    iCheckObj       as character ):
    10156      AddUtdErrForTab
    10157         (idb-num,
    10158          idoc-id,
    10159          iObj:table,
    10160          iObj,
    10161          iCheckType,
    10162          iCodeErr,
    10163          iCheckObj).
    10164   end.
    10165   function ClearUtdErrTypeCode returns logical
    10166   (idb-num         as integer,
    10167    idoc-id         as integer ,
    10168    iCheckType      as character,
    10169    iCodeErr        as character
    10170    ):
    10171      define buffer utd-err for utd-err.
    10172      if    iCheckType eq "*"
    10173         or iCheckType eq ?
    10174      then do:
    10175         if     iCodeErr ne ?
    10176            and iCodeErr ne "*"
    10177         then
    10178            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
    10179            view-as alert-box.
    10180         else
    10181         for each utd-err where utd-err.db-num  eq idb-num
    10182                            and utd-err.doc-id  eq idoc-id
    10183         exclusive-lock:
    10184            delete utd-err.
    10185         end.
    10186      end.
    10187      else do:
    10188         if    iCodeErr eq ?
    10189            or iCodeErr eq "*"
    10190         then do:
    10191            for each utd-err where utd-err.db-num     eq idb-num
    10192                               and utd-err.doc-id     eq idoc-id
    10193                               and utd-err.CheckType  eq iCheckType
    10194            exclusive-lock:
    10195               delete utd-err.
    10196            end.
    10197         end.
    10198         else do:
    10199            for each utd-err where utd-err.db-num     eq idb-num
    10200                               and utd-err.doc-id     eq idoc-id
    10201                               and utd-err.CheckType  eq iCheckType
    10202                               and ub.utd-err.CodeErr eq iCodeErr
    10203            exclusive-lock:
    10204               delete utd-err.
    10205            end.
    10206         end.
    10207      end.
    10208   end.
    10209   function ClearUtdErr returns logical
    10210   (idb-num         as integer,
    10211    idoc-id         as integer ,
    10212    iCheckType      as character
    10213    ):
    10214      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
    10215   end.
    10216   function GetMesError returns character
    10217   (itxt as character,
    10218    iobj as character ):
    10219    define variable vi as integer no-undo.
    10220    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
    10221       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
    10222    end.
    10223    return itxt.
    10224   end.
    10225   function GetTextErrorType returns character
    10226   (iCheckType as character,
    10227    iCodeErr   as character,
    10228    iChechObj  as character,
    10229    iType      as character  ):
    10230      define buffer code    for code.
    10231      define variable vError as character no-undo.
    10232      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
    10233                        and code.code   eq iCodeErr
    10234      no-lock no-error.
    10235      if available code
    10236      then do:
    10237         define variable vType as integer no-undo.
    10238         if code.misc3 eq "error"
    10239         then
    10240            vType = 0.
    10241         else if code.misc3 eq "warning"
    10242         then
    10243            vType = 1.
    10244         else if code.misc3 eq "Hiden"
    10245         then
    10246            vType = 2.
    10247         else
    10248            vtype = int(code.misc3) no-error.
    10249         case itype:
    10250            when "error"
    10251            then do:
    10252               if vtype eq 0
    10253               then
    10254                  vError = GetMesError(Code.CodeValue,iChechObj).
    10255            end.
    10256            when "warning"
    10257            then do:
    10258               if vtype <= 1
    10259               then
    10260                  vError = GetMesError(Code.CodeValue,iChechObj).
    10261            end.
    10262            otherwise do:
    10263               vError = GetMesError(Code.CodeValue,iChechObj).
    10264            end.
    10265         end.
    10266      end.
    10267      else
    10268         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
    10269      return vError.
    10270   end.
    10271   function GetTypeError returns integer
    10272   (iCheckType as character,
    10273    iCodeErr   as character):
    10274      define buffer code    for code.
    10275      define variable vType as integer no-undo.
    10276      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
    10277                        and code.code   eq iCodeErr
    10278      no-lock no-error.
    10279      if     not available code
    10280         and code.misc3 eq "error"
    10281      then
    10282         vType = 0.
    10283      else if code.misc3 eq "warning"
    10284      then
    10285         vType = 1.
    10286      else if code.misc3 eq "Hiden"
    10287      then
    10288         vType = 2.
    10289      else
    10290         vtype = int(code.misc3) no-error.
    10291      return vtype.
    10292   end.
    10293   function GetTextError returns character
    10294   (iCheckType as character,
    10295    iCodeErr   as character,
    10296    iChechObj  as character ):
    10297      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
    10298   end.
    10299   function GetErrForUtdStr returns character
    10300   (idb-num     as integer ,
    10301    idoc-id     as integer ,
    10302    iCheckType  as character
    10303    ):
    10304      define buffer utd-err for utd-err.
    10305      define buffer code    for code.
    10306      define variable vHQry as handle no-undo.
    10307      define variable vError as longchar no-undo.
    10308      define variable vErrorOne as longchar  no-undo.
    10309      define variable oError as character no-undo.
    10310      create query vHQry.
    10311      vHQry:set-buffers(buffer utd-err:handle).
    10312      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
    10313                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
    10314                               + if    iCheckType eq "*"
    10315                                    or iCheckType eq ?
    10316                                 then       ""
    10317                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
    10318      vHQry:query-open().
    10319      vHQry:get-first().
    10320      QRY-BLOCK:
    10321      repeat while not vHQry:query-off-end:
    10322         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
    10323         if     vErrorOne ne ""
    10324            and vErrorOne ne ?
    10325         then
    10326            vError = vError + ", " + vErrorOne.
    10327         vHQry:get-next().
    10328      end.
    10329      oError = substring(vError,3,4002).
    10330      return oError.
    10331   end.
    10332   function GetErrJsonForUtd returns character
    10333   (idb-num         as integer ,
    10334    idoc-id         as integer ,
    10335    iCheckType      as character
    10336    ):
    10337      define buffer utd-err for utd-err.
    10338      define variable vHQry as handle no-undo.
    10339      define variable vError as longchar no-undo.
    10340      define variable oError as character no-undo.
    10341      create query vHQry.
    10342      define variable vi as integer no-undo.
    10343      vHQry:set-buffers(buffer utd-err:handle).
    10344      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
    10345                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
    10346                               + if    iCheckType eq "*"
    10347                                    or iCheckType eq ?
    10348                                 then       ""
    10349                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
    10350      vHQry:query-open().
    10351      vHQry:get-first().
    10352      QRY-BLOCK:
    10353      repeat while not vHQry:query-off-end:
    10354         define variable vErrorOne as character no-undo.
    10355         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
    10356         if     vErrorOne ne ?
    10357            and vErrorOne ne ""
    10358         then do:
    10359            vi = vi + 1.
    10360            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
    10361                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
    10362                            + '","ТекстОш":"' + vErrorOne + '"}'.
    10363         end.
    10364         vHQry:get-next().
    10365      end.
    10366      for first utd where utd.db-num eq idb-num
    10367                      and utd.doc-id eq idoc-id
    10368                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
    10369      no-lock,
    10370         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
    10371                                  and utd-marking-lines.doc-id eq idoc-id
    10372                                  and utd-marking-lines.doc-level eq 1
    10373      no-lock,
    10374         first marking where marking.mark eq utd-marking-lines.mark
    10375                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
    10376      no-lock:
    10377         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
    10378         if     vErrorOne ne ?
    10379            and vErrorOne ne ""
    10380         then do:
    10381            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
    10382                            + '","ОбъектОш":"' + marking.mark
    10383                            + '","ТекстОш":"' + vErrorOne + '"}'.
    10384         end.
    10385      end.
    10386      if vError ne ""
    10387      then
    10388         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
    10389      return oError.
    10390   end.
    10391   function GetErrJsonForUtdReturn returns character
    10392   (idb-num         as integer ,
    10393    idoc-id         as integer ,
    10394    iCheckType      as character
    10395    ):
    10396      define buffer utd-err for utd-err.
    10397      define variable vHQry as handle no-undo.
    10398      define variable vError as longchar no-undo.
    10399      define variable oError as character no-undo.
    10400      define variable vi as integer no-undo.
    10401      create query vHQry.
    10402      vHQry:set-buffers(buffer utd-err:handle).
    10403      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
    10404                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
    10405                               + if    iCheckType eq "*"
    10406                                    or iCheckType eq ?
    10407                                 then       ""
    10408                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
    10409      vHQry:query-open().
    10410      vHQry:get-first().
    10411      QRY-BLOCK:
    10412      repeat while not vHQry:query-off-end:
    10413         define variable vErrorOne as character no-undo.
    10414         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
    10415         if     vErrorOne ne ?
    10416            and vErrorOne ne ""
    10417         then do:
    10418            vi = vi + 1.
    10419            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
    10420                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
    10421                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
    10422         end.
    10423         vHQry:get-next().
    10424      end.
    10425      if vError ne ""
    10426      then
    10427         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
    10428      return oError.
    10429   end.
    10430   function GetCodeTextError returns character
    10431   (iCheckType as character,
    10432    iCodeErr   as character,
    10433    iChechObj  as character,
    10434    output oCode as character,
    10435    output ovalue as character ):
    10436      define buffer code    for code.
    10437      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
    10438                        and code.code   eq iCodeErr
    10439      no-lock no-error.
    10440      if     available code
    10441      then do:
    10442         define variable vi as integer no-undo init ?.
    10443         vi = int(Code.misc3) no-error.
    10444         if    code.misc3 ne "error"
    10445            and vi ne 0
    10446         then
    10447            oCode = ?.
    10448         else if     Code.misc1 ne ?
    10449                 and Code.misc1 ne ""
    10450         then
    10451            assign
    10452               oCode  = GetMesError(Code.misc1,iChechObj)
    10453               ovalue = GetMesError(Code.misc2,iChechObj)
    10454            .
    10455      end.
    10456      return if oCode eq ""
    10457             then ""
    10458             else (oCode + "_" + ovalue).
    10459   end.
    10460   define temp-table TT-err no-undo
    10461     field code_ as character
    10462     field text_ as character
    10463   index code_ code_.
    10464   function GetErrTxtForUtd returns character
    10465   (idb-num         as integer ,
    10466    idoc-id         as integer ,
    10467    iCheckType      as character
    10468    ):
    10469      define buffer utd-err for utd-err.
    10470      define variable vHQry as handle no-undo.
    10471      define variable oError as character no-undo.
    10472      create query vHQry.
    10473      define variable vi as integer no-undo.
    10474      for each tt-err :
    10475         delete tt-err.
    10476      end.
    10477      vHQry:set-buffers(buffer utd-err:handle).
    10478      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
    10479                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
    10480                               + if    iCheckType eq "*"
    10481                                    or iCheckType eq ?
    10482                                 then       ""
    10483                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
    10484      vHQry:query-open().
    10485      vHQry:get-first().
    10486      define variable vcode as character no-undo.
    10487      define variable vvalue as character no-undo.
    10488      QRY-BLOCK:
    10489      repeat while not vHQry:query-off-end:
    10490         vi = vi + 1.
    10491         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
    10492         if vcode ne ?
    10493         then do:
    10494            find first tt-err where tt-err.code eq vcode
    10495            no-error.
    10496            if not available tt-err
    10497            then do:
    10498               create tt-err.
    10499               assign
    10500                  tt-err.code_ = vcode
    10501                  tt-err.text_ = vvalue
    10502               .
    10503            end.
    10504            else
    10505               tt-err.text_ = tt-err.text_ + "||" + vvalue.
    10506         end.
    10507         vHQry:get-next().
    10508      end.
    10509     find first utd where utd.db-num eq idb-num
    10510                         and utd.doc-id eq idoc-id
    10511         no-lock.
    10512      define buffer cancel_utd-lines for utd-lines.
    10513      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
    10514                                  and cancel_utd-lines.doc-id eq idoc-id
    10515      no-lock:
    10516         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
    10517         then do:
    10518            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
    10519                                        and utd-marking-lines.doc-id eq idoc-id
    10520                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
    10521            no-lock,
    10522               first marking where marking.mark eq utd-marking-lines.mark
    10523                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
    10524            no-lock:
    10525               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
    10526               find first tt-err where tt-err.code eq vcode
    10527               no-error.
    10528               if not available tt-err
    10529               then do:
    10530                  create tt-err.
    10531                  assign
    10532                     tt-err.code_ = vcode
    10533                     tt-err.text_ = vvalue
    10534                  .
    10535               end.
    10536               else
    10537                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
    10538            end.
    10539         end.
    10540         else do:
    10541            define variable vqnty as decimal no-undo.
    10542            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
    10543            if vqnty eq ? then vqnty = 0.
    10544            if vqnty ne cancel_utd-lines.Quantity
    10545            then do:
    10546               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
    10547               find first tt-err where tt-err.code eq vcode
    10548               no-error.
    10549               if not available tt-err
    10550               then do:
    10551                  create tt-err.
    10552                  assign
    10553                     tt-err.code_ = vcode
    10554                     tt-err.text_ = vvalue
    10555                  .
    10556               end.
    10557               else
    10558                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
    10559            end.
    10560         end.
    10561      end.
    10562      for each tt-err:
    10563         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
    10564      end.
    10565      return oError.
    10566   end.
    10567   define variable mFormatErr as character no-undo init "text".
    10568   function GetErrForUtd returns character
    10569   (idb-num         as integer ,
    10570    idoc-id         as integer ,
    10571    iType           as character
    10572    ):
    10573      if mFormatErr eq "text"
    10574      then
    10575         return GetErrTxtForUtd(idb-num,idoc-id,iType).
    10576      else do:
    10577         if itype eq "return"
    10578         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
    10579         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
    10580      end.
    10581   end.
    10582   function GetErrComText returns longchar
    10583   (icomment as character,
    10584    itext    as longchar ):
    10585       define variable vText as longchar no-undo.
    10586      if mFormatErr eq "text"
    10587      then do:
    10588         if icomment ne ""
    10589         then
    10590            icomment = substitute("comment:|&1|",icomment).
    10591         vText = icomment + itext.
    10592      end.
    10593      else do:
    10594         icomment = if icomment begins  '"'
    10595                    then icomment
    10596                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
    10597         vText = icomment + "," + itext.
    10598         vText = "~{" + trim(vText,",") + "~}".
    10599      end.
    10600      return vText.
    10601   end.
    10602   function CheckTypeForMarkLineType returns logical
    10603   (iObj            as handle,
    10604    iCheckType      as character,
    10605    iCodeErr        as character ,
    10606    iTypeErr        as character ):
    10607      define variable vRecKey-markLine as character no-undo.
    10608      define variable vGoodMark        as logical no-undo.
    10609      define variable vdb-num          as integer no-undo.
    10610      define variable vdoc-id          as integer no-undo.
    10611      define variable vlinenum         as integer no-undo.
    10612      define variable vErrorOne as character no-undo.
    10613      define buffer buf_utd-err for utd-err.
    10614      run gen-key-rec (input "utd-marking-lines",
    10615                       input  iObj,
    10616                       output vRecKey-markLine).
    10617      vGoodMark = yes.
    10618      vdb-num = iObj::db-num.
    10619      vdoc-id = iObj::doc-id.
    10620      vlinenum = iObj::linenum.
    10621      block-mark-err:
    10622      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
    10623                               and buf_utd-err.db-num = vdb-num
    10624                               and buf_utd-err.reckey = vRecKey-markLine
    10625                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
    10626                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
    10627      no-lock:
    10628         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
    10629         if     vErrorOne ne ?
    10630            and vErrorOne ne ""
    10631         then do:
    10632            vGoodMark = no.
    10633            leave block-mark-err.
    10634         end.
    10635      end.
    10636      return not vGoodMark.
    10637   end.
    10638   function CheckErrForMarkLineType returns logical
    10639   (iObj            as handle,
    10640    iType           as character  ):
    10641      return CheckTypeForMarkLineType (iObj,iType,"*","error").
    10642   end.
    10643   function CheckErrForMarkLine returns logical
    10644   (iObj            as handle):
    10645      return CheckErrForMarkLineType(iObj,"*").
    10646   end.
    10647   function CheckErrForLineTypeCode returns logical
    10648   (iObj                 as handle,
    10649    iCheckType           as character,
    10650    iCodeErr             as character,
    10651    iTypeErr             as character,
    10652    iOneErr              as logical):
    10653      define variable vRecKey-line     as character no-undo.
    10654      define buffer buf_utd-err for utd-err.
    10655      define variable vUtdlineError as logical no-undo.
    10656      define variable vErrorOne as character no-undo.
    10657            run gen-key-rec (input "utd-lines",
    10658                             input  iObj,
    10659                             output vRecKey-line).
    10660         define variable vdb-num as integer no-undo.
    10661         define variable vdoc-id as integer no-undo.
    10662         define variable vlinenum as integer no-undo.
    10663         vdb-num = iObj::db-num.
    10664         vdoc-id = iObj::doc-id.
    10665         vlinenum = iObj::linenum.
    10666         block-err:
    10667         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
    10668                                  and buf_utd-err.db-num = vdb-num
    10669                                  and buf_utd-err.reckey = vRecKey-line
    10670                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
    10671                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
    10672         no-lock:
    10673            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
    10674            if     vErrorOne ne ?
    10675               and vErrorOne ne ""
    10676            then do:
    10677               vUtdlineError = yes.
    10678               leave block-err.
    10679            end.
    10680         end.
    10681         if  not vUtdlineError
    10682         then do:
    10683            define variable vGoodMark as logical no-undo.
    10684            vGoodMark = yes.
    10685            block-line-err:
    10686            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
    10687                                         and utd-marking-lines.doc-id  eq vdoc-id
    10688                                         and utd-marking-lines.LineNum eq vLineNum
    10689            no-lock:
    10690               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
    10691               if     vGoodMark
    10692                  and iOneErr eq no
    10693               then
    10694                  leave block-line-err.
    10695               if     iOneErr = yes
    10696                  and not vGoodMark
    10697               then
    10698                  leave block-line-err.
    10699            end.
    10700            vUtdlineError = not vGoodMark.
    10701         end.
    10702      return vUtdlineError.
    10703   end.
    10704   function getErrForLineType returns character
    10705   (iObj            as handle,
    10706    iType           as character  ):
    10707      define variable vRecKey-line     as character no-undo.
    10708      define buffer buf_utd-err for utd-err.
    10709      define variable vUtdlineError as logical no-undo.
    10710      define variable vErrorOne as character no-undo.
    10711      define variable oError as character no-undo.
    10712            run gen-key-rec (input "utd-lines",
    10713                             input  iObj,
    10714                             output vRecKey-line).
    10715         define variable vdb-num as integer no-undo.
    10716         define variable vdoc-id as integer no-undo.
    10717         define variable vlinenum as integer no-undo.
    10718         vdb-num = iObj::db-num.
    10719         vdoc-id = iObj::doc-id.
    10720         vlinenum = iObj::linenum.
    10721         block-err:
    10722         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
    10723                                  and buf_utd-err.db-num = vdb-num
    10724                                  and buf_utd-err.reckey = vRecKey-line
    10725                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
    10726         no-lock:
    10727            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
    10728            if     vErrorOne ne ?
    10729               and vErrorOne ne ""
    10730            then do:
    10731               oError = oError + vErrorOne + " ".
    10732            end.
    10733         end.
    10734      return oError.
    10735   end.
    10736   function CheckErrForLineType returns logical
    10737   (iObj            as handle,
    10738    iType           as character  ):
    10739       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
    10740   end.
    10741   function CheckErrForLine returns logical
    10742   (iObj            as handle):
    10743      return CheckErrForLineType(iobj,"*").
    10744   end.
    10745   function CheckErrForUtd returns logical
    10746   (idb-num         as integer ,
    10747    idoc-id         as integer ):
    10748      for each utd-lines where utd-lines.db-num eq idb-num
    10749                           and utd-lines.doc-id eq idoc-id
    10750      no-lock :
    10751         if not CheckErrForLine (buffer ub.utd-lines:handle)
    10752         then
    10753            return no.
    10754      end.
    10755      return yes.
    10756   end.
    10757   function CheckMarkUtd-28rel return logical
    10758    (input idb-num as integer,
    10759    input idoc-id as integer):
    10760    define buffer utd                   for utd.
    10761    define buffer utd-lines             for utd-lines.
    10762    define buffer utd-marking-lines     for utd-marking-lines.
    10763    define variable v-par-type as character no-undo.
    10764    define variable vgdsNoMark as logical no-undo.
    10765    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
    10766      define variable v-par-val  as character no-undo.
    10767      find first utd where utd.db-num eq idb-num
    10768                       and utd.doc-id eq idoc-id
    10769      no-lock no-error.
    10770      if available utd
    10771      then do:
    10772         if     utd.obj-code ne ?
    10773            and utd.obj-type ne ?
    10774         then do:
    10775            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
    10776            Block-utd-lines:
    10777            for each utd-lines where utd-lines.db-num eq idb-num
    10778                                 and utd-lines.doc-id eq idoc-id
    10779            no-lock:
    10780               if     utd-lines.gds-code ne ?
    10781                  and utd-lines.gds-code ne 0
    10782               then do:
    10783                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
    10784                       ( utd-lines.gds-code,
    10785                         'mark-type':U,
    10786                          output v-par-val,
    10787                          output v-par-type
    10788                       ).
    10789                  if     EDOParSec:IsEdo
    10790                     and EDOParSec:GetIsEDOForType(v-par-val)
    10791                  then do:
    10792                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
    10793                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
    10794                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
    10795                                                    and length(utd-marking-lines.mark) > 13
    10796                     no-lock no-error.
    10797                     if     avail utd-marking-lines
    10798                        and not CheckErrForLine(buffer utd-lines:handle)
    10799                     then
    10800                        leave Block-utd-lines.
    10801                  end.
    10802                  else
    10803                     vgdsNoMark = yes.
    10804               end.
    10805            end.
    10806            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
    10807            if vgdsNoMark then return available utd-lines . else return yes .
    10808         end.
    10809      end.
    10810      return yes.
    10811   end.
    10812   function CheckMarkUtd return logical
    10813    (input idb-num  as integer,
    10814     input idoc-id  as integer):
    10815     define buffer utd-lines             for ub.utd-lines.
    10816     block-line:
    10817     for each utd-lines where utd-lines.db-num eq idb-num
    10818                          and utd-lines.doc-id eq idoc-id
    10819     no-lock:
    10820        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
    10821        then
    10822           leave block-line.
    10823     end.
    10824     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
    10825     return available utd-lines.
    10826   end.
    10827   function CheckNotMarkUtd return logical
    10828    (input idb-num  as integer,
    10829     input idoc-id  as integer):
    10830     define buffer utd-lines             for ub.utd-lines.
    10831     for each utd-lines where utd-lines.db-num eq idb-num
    10832                          and utd-lines.doc-id eq idoc-id
    10833     no-lock:
    10834        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
    10835        then
    10836           return yes.
    10837     end.
    10838     return no.
    10839   end.
    10840   function CheckMarkUtdLine return logical
    10841    (input idb-num  as integer,
    10842     input idoc-id  as integer,
    10843     input iLineNum as integer):
    10844    define buffer utd                   for utd.
    10845    define buffer utd-lines             for utd-lines.
    10846    define buffer utd-marking-lines     for utd-marking-lines.
    10847    define variable v-par-type as character no-undo.
    10848    define variable vMarking        as logical no-undo.
    10849    define variable vArtic          as logical no-undo.
    10850    define variable vTransitional   as logical no-undo.
    10851    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
    10852      define variable v-par-val  as character no-undo.
    10853      find first utd where utd.db-num eq idb-num
    10854                       and utd.doc-id eq idoc-id
    10855      no-lock no-error.
    10856      if available utd
    10857      then do:
    10858         if     utd.obj-code ne ?
    10859            and utd.obj-type ne ?
    10860         then do:
    10861            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
    10862            Block-utd-lines:
    10863            for each utd-lines where utd-lines.db-num   eq idb-num
    10864                                 and utd-lines.doc-id   eq idoc-id
    10865                                 and utd-lines.LineNum  eq iLineNum
    10866            no-lock:
    10867               if     utd-lines.gds-code ne ?
    10868                  and utd-lines.gds-code ne 0
    10869               then do:
    10870                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
    10871                       ( utd-lines.gds-code,
    10872                         'mark-type':U,
    10873                          output v-par-val,
    10874                          output v-par-type
    10875                       ).
    10876                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
    10877                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
    10878                  if vMarking
    10879                  then do:
    10880                     block-marking:
    10881                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
    10882                                                    and utd-marking-lines.doc-id   eq idoc-id
    10883                                                    and utd-marking-lines.LineNum  eq iLineNum
    10884                                                    and length(utd-marking-lines.mark) > 13
    10885                     no-lock:
    10886                        if isOAD(utd-marking-lines.mark)
    10887                        then do:
    10888                           assign
    10889                              vArtic   = yes
    10890                              vMarking = no
    10891                           .
    10892                           leave block-marking.
    10893                        end.
    10894                     end.
    10895                  end.
    10896                  if vArtic
    10897                  then do:
    10898                     block-artic:
    10899                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
    10900                                                    and utd-marking-lines.doc-id   eq idoc-id
    10901                                                    and utd-marking-lines.LineNum  eq iLineNum
    10902                                                    and length(utd-marking-lines.mark) > 13
    10903                     no-lock:
    10904                        if isMark(utd-marking-lines.mark)
    10905                        then do:
    10906                           assign
    10907                              vArtic   = no
    10908                              vMarking = yes
    10909                           .
    10910                           leave block-artic.
    10911                        end.
    10912                     end.
    10913                  end.
    10914                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
    10915                  if vTransitional
    10916                  then do:
    10917                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
    10918                                                    and utd-marking-lines.doc-id   eq idoc-id
    10919                                                    and utd-marking-lines.LineNum  eq iLineNum
    10920                                                    and length(utd-marking-lines.mark) > 13
    10921                     no-lock no-error.
    10922                     if not available utd-marking-lines
    10923                     then assign
    10924                        vMarking = no
    10925                        vArtic   = no
    10926                     .
    10927                  end.
    10928               end.
    10929               else
    10930                  assign
    10931                     vMarking      = yes
    10932                     vArtic        = no
    10933                     vTransitional = no
    10934                  .
    10935               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
    10936               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
    10937               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
    10938            end.
    10939         end.
    10940      end.
    10941      return vMarking or vArtic.
    10942   end.
    10943   function getMarkUtdLine return logical
    10944    (input  idb-num  as integer,
    10945     input  idoc-id  as integer,
    10946     input  iLineNum as integer,
    10947     output oMarking        as logical,
    10948     output oArtic          as logical,
    10949     output oTransitional   as logical):
    10950     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
    10951     oArtic        = not oMarking
    10952            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
    10953     oTransitional = (oMarking or oArtic)
    10954            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
    10955   end.
    10956   function CheckMarking return logical
    10957    (input idb-num as integer,
    10958    input idoc-id as integer,
    10959    input iTypeErr as character ):
    10960     define variable vMarkutd as logical no-undo.
    10961     define variable vCrErr   as logical no-undo.
    10962     define buffer utd-lines         for utd-lines.
    10963     define buffer utd-marking-lines for utd-marking-lines.
    10964     define buffer marking           for marking.
    10965     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
    10966      block-line:
    10967      for each utd-lines where utd-lines.db-num eq idb-num
    10968                           and utd-lines.doc-id eq idoc-id
    10969      no-lock:
    10970         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
    10971         then do:
    10972            for each utd-marking-lines
    10973                     where utd-marking-lines.db-num  = utd-lines.db-num
    10974                       and utd-marking-lines.doc-id  = utd-lines.doc-id
    10975                       and utd-marking-lines.LineNum = utd-lines.LineNum
    10976            no-lock:
    10977               if isMark(utd-marking-lines.mark)
    10978               then do:
    10979                  find first marking where marking.mark eq utd-marking-lines.mark
    10980                  no-lock no-error.
    10981                  if not available marking
    10982                  then do:
    10983                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
    10984                     vCrErr = yes.
    10985                     next block-line.
    10986                  end.
    10987               end.
    10988            end.
    10989         end.
    10990      end.
    10991      return vCrErr.
    10992   end.
    10993   function CheckMarkForType return logical
    10994    (input idb-num   as integer,
    10995     input idoc-id   as integer):
    10996      define variable vMarking        as logical no-undo.
    10997      define variable vArtic          as logical no-undo.
    10998      define variable vTransitional   as logical no-undo.
    10999      define buffer utd-lines         for utd-lines.
    11000      define buffer utd-marking-lines for utd-marking-lines.
    11001      block-line:
    11002      for each utd-lines where utd-lines.db-num eq idb-num
    11003                           and utd-lines.doc-id eq idoc-id
    11004      no-lock:
    11005         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
    11006                          output vMarking         , output vArtic          , output vTransitional).
    11007         for each utd-marking-lines
    11008                     where utd-marking-lines.db-num  = utd-lines.db-num
    11009                       and utd-marking-lines.doc-id  = utd-lines.doc-id
    11010                       and utd-marking-lines.LineNum = utd-lines.LineNum
    11011         no-lock:
    11012            if length(utd-marking-lines.mark) < 14
    11013            then do:
    11014               if (vMarking or vArtic) and not vTransitional
    11015               then
    11016                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
    11017            end.
    11018            else if not isMark(utd-marking-lines.mark)
    11019            then do:
    11020               if vMarking
    11021               then
    11022                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
    11023            end.
    11024            else do:
    11025            end.
    11026         end.
    11027      end.
    11028   end.
    11029   function WeighedProd return logical
    11030      ( input p-gds-code as integer) :
    11031      define variable v-par-val  as character no-undo.
    11032      define variable v-par-type as character no-undo.
    11033              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
    11034               ( p-gds-code,
    11035                 'weighed-gds':U,
    11036                  output v-par-val,
