     6188   define variable vss-include-info47 as character format "X(65)" no-undo
     6189   initial "@(#)$Workfile$ $Revision$".
     6190   def var vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6191   procedure r-cost :
     6192     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
     6193     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
     6194     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
     6195     define input  parameter v-prod-code      like ub.doc-line.prod-code         no-undo .
     6196     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
     6197     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
     6198     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
     6199     define output parameter v-sum-base       like ub.ot-line.sum-base        no-undo .
     6200     define output parameter v-sum-rubl       like ub.ot-line.sum-rubl        no-undo .
     6201     define output parameter v-vat-base       like ub.ot-line.vat-base        no-undo .
     6202     define output parameter v-vat-rubl       like ub.ot-line.vat-rubl        no-undo .
     6203     define output parameter v-slt-base       like ub.ot-line.slt-base        no-undo .
     6204     define output parameter v-slt-rubl       like ub.ot-line.slt-rubl        no-undo .
     6205     define output parameter v-road-tax-base  like ub.ot-line.road-tax-base   no-undo .
     6206     define output parameter v-road-tax-rubl  like ub.ot-line.road-tax-rubl   no-undo .
     6207     define output parameter v-transport-base like ub.ot-line.transport-base  no-undo .
     6208     define output parameter v-transport-rubl like ub.ot-line.transport-rubl  no-undo .
     6209     define output parameter v-other-base     like ub.ot-line.other-base      no-undo .
     6210     define output parameter v-other-rubl     like ub.ot-line.other-rubl      no-undo .
     6211     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
     6212     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
     6213     do
     6214     on error undo, return error
     6215     :
     6216       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     6217       define buffer   in-vatp-parts    for ub.parts   .
     6218       define buffer   in-vatp-doc      for ub.trn-doc .
     6219       define buffer   in-vatp-goods    for ub.goods   .
     6220       define buffer   in-vatp-sysconf  for ub.sysconf .
     6221       define buffer   in-vatp_doc-attr for ub.doc-attr.
     6222       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     6223       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     6224       define variable varinvprb                  as   character              no-undo.
     6225       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     6226       define variable cli-base-rate              as   decimal                no-undo.
     6227       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     6228       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     6229       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     6230       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     6231       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     6232       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     6233       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     6234       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     6235       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     6236       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     6237       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     6238       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     6239       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     6240       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     6241       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     6242       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     6243       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     6244       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     6245       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     6246       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     6247       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     6248       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     6249       define variable varinvatp-envd             as   character              no-undo.
     6250       define variable varinvatp-type             as   character              no-undo.
     6251       def var v-parts-fact-qnty as decimal   no-undo .
     6252       define buffer buf_parts    for ub.parts    .
     6253       define buffer buf_goods    for ub.goods    .
     6254       define buffer buf_trn-doc  for ub.trn-doc  .
     6255       define buffer buf_doc-line for ub.doc-line .
     6256       find first buf_doc-line no-lock
     6257         where buf_doc-line.doc-code  = v-doc-code
     6258           and buf_doc-line.artic     = v-artic
     6259           and buf_doc-line.prod-type = v-prod-type
     6260           and buf_doc-line.prod-code = v-prod-code
     6261         no-error .
     6262       if not available buf_doc-line then do:
     6263         message
     6264           vss-workfile vss-revision vss-description skip
     6265           vss-include-info48 skip
     6266           "Ошибка задания входных параметров" skip
     6267           "Не найдена строка документа"  skip
     6268           "Документ" v-doc-code skip
     6269           "Артикул" v-artic v-prod-type v-prod-code skip
     6270           view-as alert-box error .
     6271         return error .
     6272       end.
     6273       find first buf_trn-doc no-lock
     6274         where buf_trn-doc.doc-code = v-doc-code
     6275         no-error .
     6276       if not available buf_trn-doc then do:
     6277         message
     6278           vss-workfile vss-revision vss-description skip
     6279           vss-include-info48 skip
     6280           "Ошибка задания входных параметров" skip
     6281           "Не найден документ" skip
     6282           "Документ" v-doc-code skip
     6283           "Артикул" v-artic v-prod-type v-prod-code skip
     6284           view-as alert-box error .
     6285         undo, return error .
     6286       end.
     6287       find first buf_goods no-lock
     6288         where buf_goods.artic     = buf_doc-line.artic
     6289           and buf_goods.prod-type = buf_doc-line.prod-type
     6290           and buf_goods.prod-code = buf_doc-line.prod-code
     6291         no-error .
     6292       if not available buf_goods then do:
     6293         message
     6294           vss-workfile vss-revision vss-description skip
     6295           vss-include-info48 skip
     6296           "Ошибка задания входных параметров" skip
     6297           "Не найден товар" skip
     6298           "Документ" v-doc-code skip
     6299           "Артикул" v-artic v-prod-type v-prod-code skip
     6300           view-as alert-box error .
     6301         undo, return error .
     6302       end.
     6303       if buf_goods.gds-type = 'т':U then do:
     6304             for each buf_parts no-lock
     6305               where buf_parts.out-code  = buf_trn-doc.doc-code
     6306                 and buf_parts.obj-type  = buf_trn-doc.obj-type
     6307                 and buf_parts.obj-code  = buf_trn-doc.obj-code
     6308                 and buf_parts.artic     = buf_doc-line.artic
     6309                 and buf_parts.prod-type = buf_doc-line.prod-type
     6310                 and buf_parts.prod-code = buf_doc-line.prod-code
     6311             on error undo, return error
     6312             :
     6313   assign
     6314     price-rubl-with-tax-loc = buf_parts.price-rubl
     6315     price-base-with-tax-loc = buf_parts.price-base
     6316   .
     6317   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     6318   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     6319     (output varinvprb
     6320     )  .
     6321     if buf_parts.out-code = 'free-zone':U     or
     6322        buf_parts.out-code = 'out-zone':U   or
     6323        buf_parts.doc-type = 'акт':U then do:
     6324       assign
     6325         in-vatp-have-vat-slt = yes.
     6326     end.
     6327     else do:
     6328       find first in-vatp_doc-attr no-lock
     6329         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     6330           and in-vatp_doc-attr.attr-code = 'envd':U
     6331         no-error .
     6332       if not available in-vatp_doc-attr then do:
     6333         assign
     6334           in-vatp-have-vat-slt = yes.
     6335       end.
     6336       else do:
     6337            in-vatp-have-vat-slt = no.
     6338       end.
     6339     end.
     6340     assign
     6341      price-cli-with-tax-loc = buf_parts.price-cli
     6342      cli-base-rate          = buf_parts.cli-base-rate.
     6343     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     6344              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     6345     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     6346             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     6347             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     6348             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     6349             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     6350             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     6351             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6352       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6353     assign
     6354       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     6355     assign
