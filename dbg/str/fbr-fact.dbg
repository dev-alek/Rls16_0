    11040   end.
    11041   function WghProdVariable return logical
    11042       (input p-obj-type as char,
    11043        input p-obj-code as integer,
    11044        input p-gds-code as integer) :
    11045      define variable v-wgh-val  as character no-undo.
    11046      define variable v-par-val  as character no-undo.
    11047      define variable v-par-type as character no-undo.
    11048      define variable vMarking        as logical no-undo.
    11049      define variable vArtic          as logical no-undo.
    11050      define variable vTransitional   as logical no-undo.
    11051      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
    11052         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
    11053           ( p-gds-code,
    11054             'weighed-gds':U,
    11055              output v-wgh-val,
    11056              output v-par-type
    11057           ).
    11058       if logical(v-wgh-val) = yes then do:
    11059           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
    11060               ( p-gds-code,
    11061                 'mark-type':U,
    11062                  output v-par-val,
    11063                  output v-par-type
    11064               ).
    11065           if v-par-val <> "" then do:
    11066               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
    11067               assign
    11068                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
    11069                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
    11070                  .
    11071           end.
    11072      end.
    11073      if v-wgh-val > "" and (vMarking or vArtic)
    11074      then return yes.
    11075      else return no.
    11076   end.
    11077   function MarkWeight return decimal
    11078      ( input p-mark as character) :
    11079      define buffer  buf_marking-attr for  ub.marking-attr.
    11080      define variable vMarkWeight as decimal no-undo.
    11081      vMarkWeight = 0.
    11082      if p-mark <> "" and p-mark <> ?
    11083      then do:
    11084          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
    11085                                        and buf_marking-attr.attr-code eq "weight"
    11086             no-lock no-error.
    11087          if not available buf_marking-attr
    11088          then do :
    11089            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
    11090                                          and buf_marking-attr.attr-code eq "weight"
    11091               no-lock no-error.
    11092          end .
    11093          if avail buf_marking-attr
    11094          then vMarkWeight = dec(buf_marking-attr.attr-value).
    11095      end.
    11096      return vMarkWeight.
    11097   end.
