    11843               run str/deadprts.p (
    11844                     input v-in-doc-code
    11845                   , input parparentproc
    11846               ).
    11847           end.
    11848       end.
    11849   if session :set-wait-state( "" ) then.
    11850       if v-par-gen-mrgn-im = 'after-margin':U
    11851       then do:
    11852           if not available buf_in_trn-doc
    11853           then do:
    11854               find first buf_in_trn-doc no-lock
    11855                    where buf_in_trn-doc.doc-code = v-in-doc-code
    11856               .
    11857           end.
    11858           run str/in-pr.p (input parparentproc, input recid( buf_in_trn-doc ), input "after-margin" ).
    11859       end.
    11860       if v-par-gen-mrgn-im-parts = 'after-margin':U
    11861       then do:
    11862           if not available buf_in_trn-doc
    11863           then do:
    11864               find first buf_in_trn-doc no-lock
    11865                    where buf_in_trn-doc.doc-code = v-in-doc-code
    11866               .
    11867           end.
    11868           run str/in-pr.p (input parparentproc, input recid( buf_in_trn-doc ), input "after-margin-parts" ).
    11869       end.
    11870   end.
    11871   procedure fill-doc-line :
    11872   define input parameter p-trn-doc-doc-code   as character no-undo .
    11873   define input parameter p-fbr-doc-doc-code   as character no-undo .
    11874   define input parameter p-gds-code           as integer   no-undo .
    11875   define input parameter p-price-sale         as decimal   no-undo .
    11876   define input parameter p-required-qnty      as decimal   no-undo .
    11877   define input parameter p-sum-rubl           as decimal   no-undo .
    11878   define input parameter p-sum-base           as decimal   no-undo .
    11879   define input parameter p-sum-vat-rubl       as decimal   no-undo .
    11880   define input parameter p-sum-vat-base       as decimal   no-undo .
    11881   define output parameter p-reserved-qnty     as decimal   no-undo .
    11882       define variable v-doc-line-recid            as recid     no-undo .
    11883       define variable v-out-price-base            as decimal   no-undo .
    11884       define variable v-out-price-rubl            as decimal   no-undo .
    11885       define variable v-allsum-sum-dsc-base-acc   as decimal   no-undo .
    11886       define variable v-allsum-sum-dsc-rubl-acc   as decimal   no-undo .
    11887       define variable v-allsum-vat-base-acc       as decimal   no-undo .
    11888       define variable v-allsum-vat-rubl-acc       as decimal   no-undo .
    11889       define variable v-vat-pc                    as decimal   no-undo .
    11890       define variable v-host-code                 as integer   no-undo.
    11891       define variable v-cons-vat-pc               as decimal   no-undo.
    11892       define buffer buf_fbr-doc       for ub.fbr-doc.
    11893       define buffer buf_goods         for ub.goods.
    11894       define buffer buf_gds-prt       for ub.gds-prt.
    11895       define buffer buf_trn-doc       for ub.trn-doc.
    11896       define buffer buf_doc-line      for ub.doc-line.
    11897       define buffer buf_gds-dtl       for ub.gds-dtl.
    11898   do
    11899   for buf_fbr-doc
    11900     , buf_goods
    11901     , buf_gds-prt
    11902     , buf_trn-doc
    11903     , buf_doc-line
    11904     , buf_gds-dtl
    11905   on error undo, return error
    11906   :
    11907       find first buf_fbr-doc no-lock
    11908            where buf_fbr-doc.doc-code = p-fbr-doc-doc-code
    11909       .
    11910       find first buf_goods no-lock
    11911            where buf_goods.gds-code = p-gds-code
    11912       .
    11913       find first buf_gds-prt no-lock
    11914            where buf_gds-prt.upper-code = buf_goods.prt-root
    11915       .
    11916       find first buf_trn-doc exclusive-lock
    11917            where buf_trn-doc.doc-code = p-trn-doc-doc-code
    11918       .
    11919   define variable vss-include-info82 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11920   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    11921     (input  buf_fbr-doc.obj-type
    11922     ,input  buf_fbr-doc.obj-code
    11923     ,output v-host-code
    11924     )  .
    11925   define variable vss-include-info83 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11926   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcvat in g#library
    11927     (input  v-host-code
    11928     ,output v-cons-vat-pc
    11929     )  .
    11930   define variable vss-include-info84 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11931   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
    11932     (input  buf_goods.gds-code
    11933     ,input  '1':U
    11934     ,input  ?
    11935     ,input  v-host-code
    11936     ,input  buf_fbr-doc.obj-type
    11937     ,input  buf_fbr-doc.obj-code
    11938     ,output v-vat-pc
    11939     )  .
    11940       find first buf_doc-line exclusive-lock
    11941            where buf_doc-line.doc-code  = buf_trn-doc.doc-code
    11942              and buf_doc-line.artic     = buf_goods.artic
    11943              and buf_doc-line.prod-type = buf_goods.prod-type
    11944              and buf_doc-line.prod-code = buf_goods.prod-code
    11945       no-error.
    11946       if not available buf_doc-line
    11947       then do:
    11948           create buf_doc-line.
    11949           assign
    11950               buf_doc-line.artic         = buf_goods.artic
    11951               buf_doc-line.prod-type     = buf_goods.prod-type
    11952               buf_doc-line.prod-code     = buf_goods.prod-code
    11953               buf_doc-line.obj-type      = buf_trn-doc.obj-type
    11954               buf_doc-line.obj-code      = buf_trn-doc.obj-code
    11955               buf_doc-line.doc-code      = buf_trn-doc.doc-code
    11956               buf_doc-line.prt-ok        = yes
    11957               buf_doc-line.prt-root      = buf_goods.prt-root
    11958               buf_doc-line.status_       = buf_trn-doc.status_
    11959               buf_doc-line.doc-qnty      = 0
    11960               buf_doc-line.cli-base-rate = 1
    11961               buf_doc-line.VAT-pc        = p-sum-vat-base * 100.00 /  p-sum-base
    11962               buf_doc-line.cons-vat-pc   = v-cons-vat-pc
    11963               buf_doc-line.price-cli     = ( p-sum-rubl + p-sum-vat-rubl ) / p-required-qnty
    11964               buf_doc-line.price-base    = ( p-sum-base + p-sum-vat-base ) / p-required-qnty
    11965               buf_doc-line.price-rubl    = ( p-sum-rubl + p-sum-vat-rubl ) / p-required-qnty
    11966               buf_doc-line.doc-qnty      = p-required-qnty
    11967               buf_doc-line.fact-qnty     = buf_doc-line.doc-qnty
    11968               buf_doc-line.new-price-sale = p-price-sale.
    11969           .
    11970       end.
    11971       else do:
    11972           assign
    11973               buf_doc-line.doc-qnty      = buf_doc-line.doc-qnty + p-required-qnty
    11974           .
    11975       end.
    11976       assign
    11977           v-doc-line-recid = recid( buf_doc-line )
    11978       .
    11979       run rsrv-good in this-procedure (
    11980             input p-gds-code
    11981           , input p-trn-doc-doc-code
    11982           , input v-doc-line-recid
    11983           , input p-price-sale
    11984           , input p-required-qnty
    11985           , input p-sum-base
    11986           , input p-sum-rubl
    11987           , input p-sum-vat-base
    11988           , input p-sum-vat-rubl
    11989           , output p-reserved-qnty
    11990       ) no-error.
    11991       if error-status :error
    11992       then do:
    11993           undo, return error substitute("&1 &2 &3Ошибка резервирования товара  с кодом &4.&5&6&5&7"
    11994                                        ,vss-workfile
    11995                                        ,vss-revision
    11996                                        ,vss-description
    11997                                        , chr(10)
    11998                                        , error-status:get-message(1)
    11999                                        , return-value ).
    12000       end.
    12001       if p-reserved-qnty <> round( p-required-qnty, 3 ) - buf_doc-line.doc-qnty
    12002       then do:
    12003           assign
    12004               p-required-qnty = 0
    12005           .
    12006       end.
    12007       assign
    12008           buf_doc-line.VAT-pc        = v-vat-pc
    12009       .
    12010       run str/fbrcost.p (
    12011             input recid( buf_doc-line )
    12012           , input 1
    12013           , input p-reserved-qnty
    12014           , output v-allsum-sum-dsc-base-acc
    12015           , output v-allsum-sum-dsc-rubl-acc
    12016           , output v-allsum-vat-base-acc
    12017           , output v-allsum-vat-rubl-acc
    12018           , output v-vat-pc
    12019       ) .
    12020       find first buf_gds-dtl exclusive-lock
    12021            where buf_gds-dtl.doc-code  = buf_trn-doc.doc-code
    12022              and buf_gds-dtl.artic     = buf_goods.artic
    12023              and buf_gds-dtl.prod-type = buf_goods.prod-type
    12024              and buf_gds-dtl.prod-code = buf_goods.prod-code
    12025              and buf_gds-dtl.prt-code  = buf_gds-prt.node-code
    12026        .
    12027       assign
    12028           buf_gds-dtl.doc-qnty    = buf_gds-dtl.doc-qnty  + p-reserved-qnty
    12029           buf_trn-doc.status_     = 'прво':U
    12030           buf_gds-dtl.fact-qnty   = buf_gds-dtl.doc-qnty
    12031       .
    12032   end.
    12033   end procedure.
    12034   procedure rsrv-good :
    12035   define input parameter p-goods-gds-code     as integer     no-undo .
    12036   define input parameter p-trn-doc-doc-code   as character no-undo .
    12037   define input parameter p-doc-line-recid     as recid     no-undo .
    12038   define input parameter p-price-sale         as decimal   no-undo .
    12039   define input parameter p-required-qnty      as decimal   no-undo .
    12040   define input parameter p-sum-cost-base      as decimal   no-undo .
    12041   define input parameter p-sum-cost-rubl      as decimal   no-undo .
    12042   define input parameter p-sum-cost-vat-base  as decimal   no-undo .
    12043   define input parameter p-sum-cost-vat-rubl  as decimal   no-undo .
    12044   define output parameter p-rsrv-qnty         as decimal   no-undo .
    12045       define variable v-cost-base  as decimal   no-undo .
    12046       define variable v-cost-rubl  as decimal   no-undo .
    12047       define buffer buf_goods         for ub.goods.
    12048       define buffer buf_gds-prt       for ub.gds-prt.
    12049       define buffer buf_gds-dtl       for ub.gds-dtl.
    12050       define buffer buf_trn-doc       for ub.trn-doc.
    12051       define buffer buf_doc-line      for ub.doc-line.
    12052   do
    12053   for buf_goods
    12054     , buf_gds-prt
    12055     , buf_gds-dtl
    12056     , buf_trn-doc
    12057     , buf_doc-line
    12058   on error undo, return error
    12059   :
    12060       find first buf_goods no-lock
    12061            where buf_goods.gds-code = p-goods-gds-code
    12062       .
    12063       find first buf_gds-prt no-lock
    12064            where buf_gds-prt.upper-code = buf_goods.prt-root
    12065       .
    12066       find first buf_trn-doc no-lock
    12067            where buf_trn-doc.doc-code = p-trn-doc-doc-code
    12068       .
    12069       find first buf_doc-line no-lock
    12070            where recid( buf_doc-line ) = p-doc-line-recid  .
    12071   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
    12072     ( input buf_trn-doc.obj-code
    12073      ,input buf_trn-doc.obj-type
    12074      ,input buf_trn-doc.doc-code
    12075      ,input buf_goods.artic
    12076      ,input buf_goods.prod-code
    12077      ,input buf_goods.prod-type
    12078      ,input buf_gds-prt.node-code
    12079      ,input yes
    12080     ) no-error .
    12081       if error-status:error = yes and
    12082          p-silent = no
    12083       then do:
    12084           message
    12085               "Ошибка при создании признака."
    12086               skip return-value
    12087           view-as alert-box error.
    12088       end.
    12089       find first buf_gds-dtl
    12090            where buf_gds-dtl.doc-code  = buf_trn-doc.doc-code
    12091              and buf_gds-dtl.artic     = buf_goods.artic
    12092              and buf_gds-dtl.prod-type = buf_goods.prod-type
    12093              and buf_gds-dtl.prod-code = buf_goods.prod-code
    12094              and buf_gds-dtl.prt-code  = buf_gds-prt.node-code
    12095        .
    12096       if v-rb-is-base = yes
    12097       then do:
    12098           assign
    12099               buf_gds-dtl.price-rubl = buf_gds-dtl.price-base * buf_trn-doc.base-rate / buf_trn-doc.base-scale
    12100               buf_gds-dtl.price-base = p-price-sale
    12101           .
    12102       end.
    12103       else do:
    12104           assign
    12105               buf_gds-dtl.price-base = buf_gds-dtl.price-rubl / buf_trn-doc.base-rate * buf_trn-doc.base-scale
    12106               buf_gds-dtl.price-rubl = p-price-sale
    12107           .
    12108       end.
    12109       assign
    12110           buf_gds-dtl.ov      = yes
    12111           buf_trn-doc.status_ = 'накл':U
    12112           buf_trn-doc.flag_   = no
    12113       .
    12114       assign
    12115         p-rsrv-qnty = round( p-required-qnty, 3 )
    12116       .
    12117       if p-required-qnty = 0
    12118       then do:
    12119           message
    12120             vss-workfile vss-revision vss-description
    12121             skip "Невозможно зарезервировать количество 0."
    12122             skip "Товар: " buf_goods.artic buf_goods.gds-name
    12123             skip return-value
    12124             skip trim(error-status :get-message(1))
    12125                  trim(error-status :get-message(2))
    12126                  trim(error-status :get-message(3))
    12127           view-as alert-box error.
    12128           undo, return error .
    12129       end.
    12130       assign
    12131           v-cost-base = ( p-sum-cost-base + p-sum-cost-vat-base ) / p-rsrv-qnty
    12132           v-cost-rubl = ( p-sum-cost-rubl + p-sum-cost-vat-rubl ) / p-rsrv-qnty
    12133       .
    12134       if v-cost-base <= 0
    12135       or v-cost-rubl <= 0
    12136       or ( v-rb-is-base = yes
    12137           and p-sum-cost-base <= 0 )
    12138       or ( v-rb-is-base <> yes
    12139           and p-sum-cost-rubl <= 0 )
    12140       then do:
    12141           undo, return error substitute("Неправильные цены резервирования:&1Учетная цена, &2:  &3&1" +
    12142                                         "Учетная цена, баз.вал.:&4&1" +
    12143                                         "Сумма в учетных ценах: &5"  +
    12144                                         "Товар: &6 &7"
    12145                                         , chr(10)
    12146                                         , "рубли"
    12147                                         , v-cost-rubl
    12148                                         , v-cost-base
    12149                                         ,( if v-rb-is-base = yes then p-sum-cost-base else p-sum-cost-rubl )
    12150                                         ,buf_goods.artic
    12151                                         ,buf_goods.gds-name).
    12152       end.
    12153       run trg/rsrv-dtl.p (
    12154             input parparentproc
    12155           , input 'reserv':U
    12156           , buffer buf_gds-dtl
    12157           , input-output p-rsrv-qnty
    12158           , input-output v-cost-base
    12159           , input-output v-cost-rubl
    12160           , input -1
    12161           , input ""
    12162       ) no-error.
    12163       if error-status :error
    12164       then do:
    12165           if error-status :get-message(1) <> ""
    12166           then do:
    12167               undo, return error substitute("&1 &2 &3&4Ошибка при резервировании товара.&4&5&4&6"
    12168                                            ,vss-workfile
    12169                                            ,vss-revision
    12170                                            ,vss-description
    12171                                            ,chr(10)
    12172                                            ,error-status:get-message(1)
    12173                                            ,return-value ).
    12174           end.
    12175       end.
    12176   end.
    12177   end procedure.
    12178   procedure verify-trn-reason :
    12179   define input  parameter p-reason-code as integer   no-undo .
    12180   define input  parameter p-doc-code as character no-undo .
    12181   define input  parameter p-ext-doc-type as character no-undo .
    12182     do
    12183     on error undo, return error return-value
    12184     :
    12185     if v-reasonm and  lookup( p-ext-doc-type ,v-reasonme) = 0 and
    12186     lookup( p-ext-doc-type , 'es,em,wm,im,ot,rs,mp,pc':U) = 0
    12187     then do:
    12188        if p-reason-code = 0 or p-reason-code = ? then do:
    12189           return error substitute("Документ производства нельзя закрыть.  Не задана ПРИЧИНА СОЗДАНИЯ ДОКУМЕНТА &1."
    12190                                  , p-doc-code) .
    12191        end.
    12192     end.
    12193     end.
    12194   end procedure.
