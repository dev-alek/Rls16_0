     2991   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2992   procedure cur-time :
     2993      define output parameter p-today as date      no-undo .
     2994      define output parameter p-time  as integer   no-undo .
     2995     do
     2996     on error undo, return error
     2997     :
     2998       define variable v-date1 as date      no-undo .
     2999       define variable v-date2 as date      no-undo .
     3000       define variable v-time  as integer   no-undo .
     3001       assign
     3002         v-date1 = today
     3003         v-time  = time
     3004         v-date2 = today
     3005       .
     3006       if v-date1 <> v-date2
     3007       then do:
     3008         assign
     3009           v-date1 = today
     3010           v-time  = v-time
     3011         .
     3012       end.
     3013       assign
     3014         p-today = v-date1
     3015         p-time  = v-time
     3016       .
     3017     end.
     3018   end.
     3019   function cur-time-date returns character
     3020   :
     3021     return string(today, '99/99/9999':U) .
     3022   end.
     3023   function cur-time-mjd returns decimal
     3024   :
     3025     define variable v-date as date      no-undo .
     3026     define variable v-time as integer   no-undo .
     3027     run cur-time in this-procedure
     3028       (output v-date
     3029       ,output v-time
     3030       ) .
     3031     return integer(v-date) - 2400002 + (v-time / 86400) .
     3032   end.
     3033   function cur-time-get-ending-index returns integer
     3034   (input p-number as integer
     3035   )
     3036   :
     3037     if p-number < 0
     3038     or p-number = ?
     3039     then do:
     3040       return 1 .
     3041     end.
     3042     define variable v-rest as integer   no-undo .
     3043     assign
     3044       p-number = p-number modulo 100
     3045     .
     3046     if p-number < 20
     3047     then do:
     3048       assign
     3049         v-rest = p-number
     3050       .
     3051     end.
     3052     else do:
     3053       assign
     3054         v-rest = p-number modulo 10
     3055       .
     3056     end.
     3057     case v-rest :
     3058       when 1
     3059       then do:
     3060         return 2 .
     3061       end.
     3062       when 2 or
     3063       when 3 or
     3064       when 4
     3065       then do:
     3066         return 3 .
     3067       end.
     3068       otherwise do:
     3069         return 1 .
     3070       end.
     3071     end case .
     3072   end.
     3073   procedure cur-time-mjd-to-date :
     3074      define input  parameter i-mjd-diff as decimal no-undo.
     3075      define output parameter o-Date     as date    no-undo.
     3076      define output parameter o-Time     as integer no-undo.
     3077      define variable v-day-number as integer   no-undo .
     3078      if    i-mjd-diff < 0
     3079         or i-mjd-diff = ?
     3080      then do:
     3081         return "?" .
     3082      end.
     3083      assign
     3084         v-day-number = truncate(i-mjd-diff,0).
     3085         o-Date = date(v-day-number + 2400002).
     3086         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     3087     .
     3088   end.
     3089   function cur-time-mjd-to-string returns character
     3090   (input p-mjd-diff as decimal
     3091   )
     3092   :
     3093     define variable v-day-number as integer   no-undo .
     3094     define variable v-seconds    as integer   no-undo .
     3095     define variable v-hour       as integer   no-undo .
     3096     define variable v-min        as integer   no-undo .
     3097     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     3098     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     3099     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     3100     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     3101     if p-mjd-diff < 0
     3102     or p-mjd-diff = ?
     3103     then do:
     3104       return "?" .
     3105     end.
     3106     assign
     3107       v-day-number = integer(truncate(p-mjd-diff,0))
     3108       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     3109     .
     3110     if v-seconds > 86400
     3111     then do:
     3112       assign
     3113         v-seconds = 86400 - 1
     3114       .
     3115     end.
     3116     if v-seconds < 0
     3117     then do:
     3118       assign
     3119         v-seconds = 0
     3120       .
     3121     end.
     3122     assign
     3123       v-hour = truncate(v-seconds / 3600, 0)
     3124     .
     3125     assign
     3126       v-seconds = v-seconds modulo 3600
     3127     .
     3128     assign
     3129       v-min = truncate(v-seconds / 60, 0)
     3130     .
     3131     assign
     3132       v-seconds = v-seconds modulo 60
     3133     .
     3134     return
     3135         (if v-day-number <> 0
     3136           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     3137           else ""
     3138         )
     3139       + (if v-day-number <> 0 or v-hour <> 0
     3140           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     3141           else ""
     3142         )
     3143       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     3144           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     3145           else ""
     3146         )
     3147       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     3148       .
     3149   end.
     3150   function cur-time-string returns character
     3151   :
     3152     define variable v-date as date      no-undo .
     3153     define variable v-time as integer   no-undo .
     3154     run cur-time in this-procedure
     3155       (output v-date
     3156       ,output v-time
     3157       ) .
     3158     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     3159   end.
     3160   function cur-time-string-sec returns character
     3161   :
     3162     define variable v-date as date      no-undo .
     3163     define variable v-time as integer   no-undo .
     3164     run cur-time in this-procedure
     3165       (output v-date
     3166       ,output v-time
     3167       ) .
     3168     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     3169   end.
     3170   function cur-time-custom  returns character
     3171   (input p-prefix as character
     3172   ,input p-date-format as character
     3173   ,input p-delimiter as character
     3174   ,input p-time-format as character
     3175   ,input p-suffix as character
     3176   )
     3177   :
     3178     define variable v-date as date      no-undo .
     3179     define variable v-time as integer   no-undo .
     3180     run cur-time in this-procedure
     3181       (output v-date
     3182       ,output v-time
     3183       ) .
     3184     return
     3185       p-prefix
     3186       + string(v-date, p-date-format)
     3187       + p-delimiter
     3188       + string(v-time, p-time-format)
     3189       + p-suffix
     3190       .
     3191   end.
     3192   function cur-time-print  returns character
     3193   :
     3194     define variable v-date as date      no-undo .
     3195     define variable v-time as integer   no-undo .
     3196     run cur-time in this-procedure
     3197       (output v-date
     3198       ,output v-time
     3199       ) .
     3200     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     3201   end.
     3202   function cur-time-datetime returns datetime
     3203   :
     3204     define variable v-char as character no-undo .
     3205     define variable v-datetime as datetime no-undo .
     3206     v-char = cur-time-string().
     3207     v-datetime = datetime(v-char).
     3208     return  v-datetime.
     3209   end.
     3210   function cur-time-string-msec returns character
     3211   :
     3212     define variable v-date as datetime  no-undo .
     3213     v-date = now.
     3214     return string(v-date) .
     3215   end.
     3216   procedure fbrlib_create-fbr-doc :
     3217   define input parameter p-obj-type as character no-undo .
     3218   define input parameter p-obj-code as integer no-undo .
     3219   define input parameter p-userid as character no-undo .
