     6539      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
     6540                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
     6541                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
     6542      if (not buf_trn-doc.internal and
     6543              buf_trn-doc.doc-type = 'при':U) or
     6544         in-vatp-goods.gds-type = 'у':U then do:
     6545         if varinvprb = "base":u then do:
     6546           assign
     6547             road-tax-base-loc = buf_doc-line.road-tax
     6548             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     6549         end.
     6550         else do:
     6551           ASSIGN
     6552             road-tax-rubl-loc = buf_doc-line.road-tax
     6553             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     6554         end.
     6555         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     6556         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     6557         assign
     6558           road-tax-cli-loc = ?.
     6559         ASSIGN
     6560           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
     6561           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
     6562           transport-cli-loc  = 0
     6563           other-base-loc     = (if buf_doc-line.other-base     = ? then 0 else buf_doc-line.other-base)
     6564           other-rubl-loc     = (if buf_doc-line.other-rubl     = ? then 0 else buf_doc-line.other-rubl)
     6565           other-cli-loc      = 0
     6566           vat-pc-loc         = (if buf_doc-line.vat-pc         = ? then 0 else buf_doc-line.vat-pc)
     6567           slt-pc-loc         = (if buf_doc-line.slt-pc         = ? then 0 else buf_doc-line.slt-pc).
     6568                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6569               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6570         assign
     6571           vat-cli-loc            = ?
     6572           slt-cli-loc            = ?
     6573           price-cli-with-tax-loc = ?.
     6574      end.
     6575      else do:
     6576                                                   for each in-vatp-parts where in-vatp-parts.out-code  = buf_doc-line.doc-code  and
     6577                                         in-vatp-parts.obj-type  = buf_doc-line.obj-type  and
     6578                                         in-vatp-parts.obj-code  = buf_doc-line.obj-code  and
     6579                                         in-vatp-parts.artic     = buf_doc-line.artic     and
     6580                                         in-vatp-parts.prod-type = buf_doc-line.prod-type and
     6581                                         in-vatp-parts.prod-code = buf_doc-line.prod-code
     6582                            use-index out-code no-lock:
     6583             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     6584                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     6585                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     6586                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     6587                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     6588                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     6589                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     6590                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     6591                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     6592                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     6593                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     6594                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     6595                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     6596                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     6597                         .
     6598         end.
     6599         ASSIGN
     6600           road-tax-base-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     6601           road-tax-rubl-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     6602           transport-base-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     6603           transport-rubl-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     6604           other-base-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     6605           other-rubl-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     6606                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     6607           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     6608                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     6609           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     6610           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     6611           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     6612         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     6613         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     6614         if transport-base-loc = ? then transport-base-loc = 0.
     6615         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     6616         if other-base-loc     = ? then other-base-loc     = 0.
     6617         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     6618         assign
     6619           transport-cli-loc      = 0
     6620           other-cli-loc          = 0
     6621           road-tax-cli-loc       = ?
     6622           vat-cli-loc            = ?
     6623           slt-cli-loc            = ?
     6624           price-cli-with-tax-loc = ?.
     6625      end.
     6626   ASSIGN
     6627             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     6628       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     6629   .
     6630             assign
     6631               v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     6632               v-vat-pc              = vat-pc-loc
     6633               v-slt-pc              = slt-pc-loc
     6634               v-sum-base            = v-sum-base       + (price-base-with-tax-loc * v-parts-fact-qnty)
     6635               v-sum-rubl            = v-sum-rubl       + (price-rubl-with-tax-loc * v-parts-fact-qnty)
     6636               v-vat-base            = v-vat-base       + (vat-base-loc            * v-parts-fact-qnty)
     6637               v-vat-rubl            = v-vat-rubl       + (vat-rubl-loc            * v-parts-fact-qnty)
     6638               v-slt-base            = v-slt-base       + (slt-base-loc            * v-parts-fact-qnty)
     6639               v-slt-rubl            = v-slt-rubl       + (slt-rubl-loc            * v-parts-fact-qnty)
     6640               v-road-tax-base       =  0
     6641               v-road-tax-rubl       =  0
     6642               v-excise-base         =  0
     6643               v-excise-rubl         =  0
     6644               v-transport-base      =  0
     6645               v-transport-rubl      =  0
     6646               v-other-base          =  0
     6647               v-other-rubl          =  0
     6648             .
     6649       end.
     6650     end.
     6651   end procedure.
     6652   procedure fbrrep-fill-qnty-and-prices :
     6653   do
     6654   on error undo, return error
     6655   :
     6656   define input parameter p-fbr-doc-doc-code  as character    no-undo.
     6657       define variable v-gds-code  as integer       no-undo.
     6658       define variable v-gds-name  as character     no-undo.
     6659       define variable v-sign      as decimal       no-undo.
     6660       define buffer buf_fbr-line          for ub.fbr-line.
     6661       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     6662       for each buf_fbr-line no-lock
     6663          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     6664       on error undo, return error
     6665       :
     6666           find first buf_temp_fbrrep-goods
     6667                where buf_temp_fbrrep-goods.artic     = buf_fbr-line.artic
     6668                  and buf_temp_fbrrep-goods.prod-type = buf_fbr-line.prod-type
     6669                  and buf_temp_fbrrep-goods.prod-code = buf_fbr-line.prod-code
     6670           use-index ar
     6671           no-error.
     6672           if not available buf_temp_fbrrep-goods
     6673           then do:
     6674               create buf_temp_fbrrep-goods.
     6675   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6676   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     6677     (input  buf_fbr-line.artic
     6678     ,input  buf_fbr-line.prod-type
     6679     ,input  buf_fbr-line.prod-code
     6680     ,output v-gds-code
     6681     )  .
     6682   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6683   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     6684     (input  buf_fbr-line.artic
     6685     ,input  buf_fbr-line.prod-type
     6686     ,input  buf_fbr-line.prod-code
     6687     ,output v-gds-name
     6688     )  .
     6689   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6690   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     6691     (input  buf_fbr-line.artic
     6692     ,input  buf_fbr-line.prod-type
     6693     ,input  buf_fbr-line.prod-code
     6694     ,input  'gds-goods=request':u
     6695     ,output buf_temp_fbrrep-goods.is-not-office
     6696     )  .
     6697               assign
     6698                   buf_temp_fbrrep-goods.gds-code             = v-gds-code
     6699                   buf_temp_fbrrep-goods.artic                = buf_fbr-line.artic
     6700                   buf_temp_fbrrep-goods.prod-type            = buf_fbr-line.prod-type
     6701                   buf_temp_fbrrep-goods.prod-code            = buf_fbr-line.prod-code
     6702                   buf_temp_fbrrep-goods.gds-name             = v-gds-name
     6703                   buf_temp_fbrrep-goods.is-waste             = buf_fbr-line.is-waste
     6704                   buf_temp_fbrrep-goods.fact-qnty            = 0
     6705                   buf_temp_fbrrep-goods.write-off-rsrv-qnty  = 0
     6706                   buf_temp_fbrrep-goods.write-off-qnty       = 0
     6707                   buf_temp_fbrrep-goods.income-qnty          = 0
     6708                   buf_temp_fbrrep-goods.income-rsrv-qnty     = 0
     6709                   buf_temp_fbrrep-goods.cost-rubl            = 0
     6710                   buf_temp_fbrrep-goods.cost-base            = 0
     6711                   buf_temp_fbrrep-goods.sum-cost-rubl        = 0
     6712                   buf_temp_fbrrep-goods.sum-cost-base        = 0
     6713                   buf_temp_fbrrep-goods.vat-cost-rubl        = 0
     6714                   buf_temp_fbrrep-goods.vat-cost-base        = 0
     6715                   buf_temp_fbrrep-goods.sum-vat-cost-rubl    = 0
     6716                   buf_temp_fbrrep-goods.sum-vat-cost-base    = 0
     6717                   buf_temp_fbrrep-goods.price-sale           = buf_fbr-line.price-sale
     6718                   buf_temp_fbrrep-goods.deleted              = no
     6719               .
     6720   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6721   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     6722     (input  v-gds-code
     6723     ,output buf_temp_fbrrep-goods.unit-base
     6724     )  .
     6725           end.
     6726           case buf_fbr-line.trn-type
     6727           :
     6728               when 'при':U
     6729               then do:
     6730                   assign
     6731                       v-sign                                  = 1
     6732                       buf_temp_fbrrep-goods.income-qnty       = buf_temp_fbrrep-goods.income-qnty     + buf_fbr-line.fact-qnty
     6733                   .
     6734                   if buf_fbr-line.rsrv-qnty <> ?
     6735                   then do:
     6736                       assign
     6737                           buf_temp_fbrrep-goods.income-rsrv-qnty = buf_temp_fbrrep-goods.income-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     6738                       .
     6739                   end.
     6740               end.
     6741               when 'спи':U
     6742               then do:
     6743                   assign
     6744                       v-sign                                  = -1
     6745                       buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty  + buf_fbr-line.fact-qnty
     6746                   .
     6747                   if buf_fbr-line.rsrv-qnty <> ?
     6748                   then do:
     6749                       assign
     6750                           buf_temp_fbrrep-goods.write-off-rsrv-qnty = buf_temp_fbrrep-goods.write-off-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     6751                       .
     6752                   end.
     6753               end.
     6754           end case.
     6755           assign
     6756               buf_temp_fbrrep-goods.sum-cost-rubl        = buf_temp_fbrrep-goods.sum-cost-rubl     + v-sign * buf_fbr-line.price-sum-rubl
     6757               buf_temp_fbrrep-goods.sum-cost-base        = buf_temp_fbrrep-goods.sum-cost-base     + v-sign * buf_fbr-line.price-sum-base
     6758               buf_temp_fbrrep-goods.sum-vat-cost-rubl    = buf_temp_fbrrep-goods.sum-vat-cost-rubl + v-sign * buf_fbr-line.price-sum-vat-rubl
     6759               buf_temp_fbrrep-goods.sum-vat-cost-base    = buf_temp_fbrrep-goods.sum-vat-cost-base + v-sign * buf_fbr-line.price-sum-vat-base
     6760           .
     6761       end.
     6762       run test-temp-tables in this-procedure .
     6763   end.
     6764   end procedure.
     6765   procedure fbrrep-fill-for-fbr-actp :
     6766   do
     6767   on error undo, return error
     6768   :
     6769   define input parameter p-fbr-doc-doc-code  as character    no-undo.
     6770       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     6771       define buffer buf_fbr-line          for ub.fbr-line.
     6772       run fbrrep-fill-qnty-and-prices in this-procedure (
     6773           input p-fbr-doc-doc-code
     6774       ).
     6775       for each buf_temp_fbrrep-goods
     6776       :
     6777           assign
     6778               buf_temp_fbrrep-goods.sum-cost-rubl     = 0
     6779               buf_temp_fbrrep-goods.sum-cost-base     = 0
     6780               buf_temp_fbrrep-goods.sum-vat-cost-rubl = 0
     6781               buf_temp_fbrrep-goods.sum-vat-cost-base = 0
     6782               buf_temp_fbrrep-goods.cost-rubl     = 0
     6783               buf_temp_fbrrep-goods.cost-base     = 0
     6784               buf_temp_fbrrep-goods.vat-cost-rubl = 0
     6785               buf_temp_fbrrep-goods.vat-cost-base = 0
     6786           .
     6787           if buf_temp_fbrrep-goods.income-qnty = 0
     6788           or buf_temp_fbrrep-goods.write-off-qnty = 0
     6789           then do:
     6790               assign
     6791                   buf_temp_fbrrep-goods.deleted   = yes
     6792                   buf_temp_fbrrep-goods.fact-qnty = 0
     6793               .
     6794           end.
     6795           else do:
     6796               if buf_temp_fbrrep-goods.income-qnty <= buf_temp_fbrrep-goods.write-off-qnty
     6797               then do:
     6798                   assign
     6799                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty
     6800                   .
     6801                   for each buf_fbr-line no-lock
     6802                      where buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     6803                        and buf_fbr-line.artic     = buf_temp_fbrrep-goods.artic
     6804                        and buf_fbr-line.prod-type = buf_temp_fbrrep-goods.prod-type
     6805                        and buf_fbr-line.prod-code = buf_temp_fbrrep-goods.prod-code
     6806                        and buf_fbr-line.trn-type  = 'при':U
     6807                   :
     6808                       assign
     6809                           buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     + buf_fbr-line.price-sum-rubl
     6810                           buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base     + buf_fbr-line.price-sum-base
     6811                           buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl + buf_fbr-line.price-sum-vat-rubl
     6812                           buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base + buf_fbr-line.price-sum-vat-base
     6813                       .
     6814                   end.
     6815                   assign
     6816                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / buf_temp_fbrrep-goods.fact-qnty
     6817                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / buf_temp_fbrrep-goods.fact-qnty
     6818                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / buf_temp_fbrrep-goods.fact-qnty
     6819                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / buf_temp_fbrrep-goods.fact-qnty
     6820                   .
     6821               end.
     6822               else do:
     6823                   assign
     6824                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty
     6825                   .
     6826                   for each buf_fbr-line no-lock
     6827                      where buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     6828                        and buf_fbr-line.artic     = buf_temp_fbrrep-goods.artic
     6829                        and buf_fbr-line.prod-type = buf_temp_fbrrep-goods.prod-type
     6830                        and buf_fbr-line.prod-code = buf_temp_fbrrep-goods.prod-code
     6831                        and buf_fbr-line.trn-type  = 'спи':U
     6832                   :
     6833                       assign
     6834                           buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     + buf_fbr-line.price-sum-rubl
     6835                           buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base     + buf_fbr-line.price-sum-base
     6836                           buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl + buf_fbr-line.price-sum-vat-rubl
     6837                           buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base + buf_fbr-line.price-sum-vat-base
     6838                       .
     6839                   end.
     6840                   assign
     6841                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / buf_temp_fbrrep-goods.fact-qnty
     6842                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / buf_temp_fbrrep-goods.fact-qnty
     6843                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / buf_temp_fbrrep-goods.fact-qnty
     6844                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / buf_temp_fbrrep-goods.fact-qnty
     6845                   .
     6846               end.
     6847           end.
     6848       end.
     6849       for each buf_temp_fbrrep-goods
     6850          where buf_temp_fbrrep-goods.deleted = yes
     6851       on error undo, return error
     6852       :
     6853           delete buf_temp_fbrrep-goods.
     6854       end.
     6855       run test-temp-tables in this-procedure .
     6856   end.
     6857   end procedure.
     6858   procedure fbrrep-fill-for-op-del :
     6859   do
     6860   on error undo, return error
     6861   :
     6862   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     6863   define input parameter p-db-remote          as logical          no-undo.
     6864       define variable v-serv-code as character    no-undo.
     6865       define variable v-in-code   as character    no-undo.
     6866       define variable v-out-code  as character    no-undo.
     6867       define variable v-trn-qnty  as decimal       no-undo.
     6868       define variable v-sign      as decimal       no-undo.
     6869       define variable v-qnty      as decimal       no-undo.
     6870       define buffer buf_fbr-doc           for ub.fbr-doc.
     6871       define buffer buf_fbr-line          for ub.fbr-line.
     6872       define buffer buf_goods             for ub.goods .
     6873       define buffer buf_doc-line          for ub.doc-line .
     6874       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods .
     6875       run fbrrep-fill-qnty-and-prices in this-procedure (
     6876           input p-fbr-doc-doc-code
     6877       ).
     6878       for each buf_temp_fbrrep-goods
     6879       on error undo, return error
     6880       :
     6881           if buf_temp_fbrrep-goods.income-qnty <> 0
     6882           or buf_temp_fbrrep-goods.write-off-qnty <> 0
     6883           then do:
     6884               assign
     6885                   v-qnty  = ( buf_temp_fbrrep-goods.write-off-qnty - buf_temp_fbrrep-goods.income-qnty )
     6886               .
     6887               if v-qnty = 0
     6888               then do:
     6889                   find first buf_fbr-line no-lock
     6890                        where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     6891                          and buf_fbr-line.artic       = buf_temp_fbrrep-goods.artic
     6892                          and buf_fbr-line.prod-type   = buf_temp_fbrrep-goods.prod-type
     6893                          and buf_fbr-line.prod-code   = buf_temp_fbrrep-goods.prod-code
     6894                          and buf_fbr-line.fact-qnty   <> 0
     6895                   no-error.
     6896                   if available buf_fbr-line
     6897                   then do:
     6898                       assign
     6899                           buf_temp_fbrrep-goods.cost-rubl     = buf_fbr-line.price-rubl
     6900                           buf_temp_fbrrep-goods.cost-base     = buf_fbr-line.price-base
     6901                           buf_temp_fbrrep-goods.vat-cost-rubl = buf_fbr-line.price-sum-vat-rubl / buf_fbr-line.fact-qnty
     6902                           buf_temp_fbrrep-goods.vat-cost-base = buf_fbr-line.price-sum-vat-base / buf_fbr-line.fact-qnty
     6903                       .
     6904                   end.
     6905                   else do:
     6906                       assign
     6907                           buf_temp_fbrrep-goods.cost-rubl     = 0
     6908                           buf_temp_fbrrep-goods.cost-base     = 0
     6909                           buf_temp_fbrrep-goods.vat-cost-rubl = 0
     6910                           buf_temp_fbrrep-goods.vat-cost-base = 0
     6911                       .
     6912                   end.
     6913               end.
     6914               else do:
     6915                   assign
     6916                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / v-qnty
     6917                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / v-qnty
     6918                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / v-qnty
     6919                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / v-qnty
     6920                   .
     6921               end.
     6922           end.
     6923           else do:
     6924               assign
     6925                   buf_temp_fbrrep-goods.cost-rubl     = 0
     6926                   buf_temp_fbrrep-goods.cost-base     = 0
     6927                   buf_temp_fbrrep-goods.vat-cost-rubl = 0
     6928                   buf_temp_fbrrep-goods.vat-cost-base = 0
     6929               .
     6930           end.
     6931       end.
     6932       for each buf_temp_fbrrep-goods
     6933       :
     6934           if buf_temp_fbrrep-goods.is-waste = yes
     6935           then do:
     6936               assign
     6937                   buf_temp_fbrrep-goods.deleted = yes
     6938               .
     6939           end.
     6940           else do:
     6941               if buf_temp_fbrrep-goods.write-off-qnty <> 0
     6942               and buf_temp_fbrrep-goods.income-qnty <> 0
     6943               then do:
     6944                   if buf_temp_fbrrep-goods.write-off-qnty = buf_temp_fbrrep-goods.income-qnty
     6945                   then do:
     6946                       assign
     6947                           buf_temp_fbrrep-goods.deleted = yes
     6948                       .
     6949                   end.
     6950                   else do:
     6951                       if buf_temp_fbrrep-goods.write-off-qnty > buf_temp_fbrrep-goods.income-qnty
     6952                       then do:
     6953                           assign
     6954                               buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty - buf_temp_fbrrep-goods.income-qnty
     6955                               buf_temp_fbrrep-goods.income-qnty       = 0
     6956                           .
     6957                       end.
     6958                       else do:
     6959                           assign
     6960                               buf_temp_fbrrep-goods.income-qnty       = buf_temp_fbrrep-goods.income-qnty - buf_temp_fbrrep-goods.write-off-qnty
     6961                               buf_temp_fbrrep-goods.write-off-qnty    = 0
     6962                           .
     6963                       end.
     6964                   end.
     6965               end.
     6966           end.
     6967       end.
     6968       for each buf_temp_fbrrep-goods
     6969          where buf_temp_fbrrep-goods.deleted = yes
     6970       on error undo, return error
     6971       :
     6972           delete buf_temp_fbrrep-goods.
     6973       end.
     6974       run test-temp-tables in this-procedure .
     6975       find first buf_fbr-doc no-lock
     6976            where buf_fbr-doc.doc-code = p-fbr-doc-doc-code
     6977       .
     6978       assign
     6979           v-out-code = p-fbr-doc-doc-code
     6980       .
     6981       run doc-code in this-procedure (
     6982             input  "pair"
     6983           , input  buf_fbr-doc.obj-type
     6984           , input  buf_fbr-doc.obj-code
     6985           , input  v-out-code
     6986           , output v-in-code
     6987       ) no-error.
     6988       if error-status:error
     6989       then do:
     6990           message
     6991                    vss-workfile vss-revision vss-description
     6992               skip "Ошибка вычисления номера приходной накладной."
     6993               skip return-value
     6994               skip trim(error-status :get-message(1))
     6995                    trim(error-status :get-message(2))
     6996                    trim(error-status :get-message(3))
     6997           view-as alert-box error.
     6998           undo, return error .
     6999       end.
     7000       run doc-code in this-procedure (
     7001             input  "trio"
     7002           , input  buf_fbr-doc.obj-type
     7003           , input  buf_fbr-doc.obj-code
     7004           , input  v-in-code
     7005           , output v-serv-code
     7006       ) no-error.
     7007       if error-status:error
     7008       then do:
     7009           message
     7010                    vss-workfile vss-revision vss-description
     7011               skip "Ошибка вычисления номера накладной расхода."
     7012               skip return-value
     7013               skip trim(error-status :get-message(1))
     7014                    trim(error-status :get-message(2))
     7015                    trim(error-status :get-message(3))
     7016           view-as alert-box error.
     7017           undo, return error .
     7018       end.
     7019       for each buf_temp_fbrrep-goods
     7020       on error undo, return error
     7021       :
     7022           if buf_temp_fbrrep-goods.income-qnty > buf_temp_fbrrep-goods.write-off-qnty
     7023           then do:
     7024               find first buf_doc-line no-lock
     7025                    where buf_doc-line.doc-code  = v-in-code
     7026                      and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     7027                      and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     7028                      and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     7029               no-error.
     7030               if available buf_doc-line
     7031               then do:
     7032                   assign
     7033                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty - buf_doc-line.doc-qnty
     7034                   .
     7035               end.
     7036               else do:
     7037                   assign
     7038                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty
     7039                   .
     7040               end.
     7041           end.
     7042           else do:
     7043               if buf_temp_fbrrep-goods.is-not-office = no
     7044               then do:
     7045                   find first buf_doc-line no-lock
     7046                        where buf_doc-line.doc-code  = v-serv-code
     7047                          and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     7048                          and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     7049                          and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     7050                   no-error.
     7051               end.
     7052               else do:
     7053                   find first buf_doc-line no-lock
     7054                        where buf_doc-line.doc-code  = v-out-code
     7055                          and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     7056                          and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     7057                          and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     7058                   no-error.
     7059               end.
     7060               if available buf_doc-line
     7061               then do:
     7062                   assign
     7063                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty - buf_doc-line.doc-qnty
     7064                   .
     7065               end.
     7066               else do:
     7067                   assign
     7068                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty
     7069                   .
     7070               end.
     7071           end.
     7072           if available buf_doc-line
     7073           then do:
     7074               define variable v-void              as decimal       no-undo.
     7075               define variable v-fact-qnty         as decimal       no-undo.
     7076               define variable v-sum-base          as decimal       no-undo.
     7077               define variable v-sum-rubl          as decimal       no-undo.
     7078               define variable v-vat-base          as decimal       no-undo.
     7079               define variable v-vat-rubl          as decimal       no-undo.
     7080               define variable v-slt-base          as decimal       no-undo.
     7081               define variable v-slt-rubl          as decimal       no-undo.
     7082               define variable v-road-tax-base     as decimal       no-undo.
     7083               define variable v-road-tax-rubl     as decimal       no-undo.
     7084               define variable v-transport-base    as decimal       no-undo.
     7085               define variable v-transport-rubl    as decimal       no-undo.
     7086               define variable v-other-base        as decimal       no-undo.
     7087               define variable v-other-rubl        as decimal       no-undo.
     7088               define variable v-excise-base       as decimal       no-undo.
     7089               define variable v-excise-rubl       as decimal       no-undo.
     7090               run r-cost in this-procedure (
     7091                     input buf_doc-line.doc-code
     7092                   , input buf_doc-line.artic
     7093                   , input buf_doc-line.prod-type
     7094                   , input buf_doc-line.prod-code
     7095                   , output v-fact-qnty
     7096                   , output v-void
     7097                   , output v-void
     7098                   , output v-sum-base
     7099                   , output v-sum-rubl
     7100                   , output v-vat-base
     7101                   , output v-vat-rubl
     7102                   , output v-slt-base
     7103                   , output v-slt-rubl
     7104                   , output v-road-tax-base
     7105                   , output v-road-tax-rubl
     7106                   , output v-transport-base
     7107                   , output v-transport-rubl
     7108                   , output v-other-base
     7109                   , output v-other-rubl
     7110                   , output v-excise-base
     7111                   , output v-excise-rubl
     7112               ).
     7113               assign
     7114                   v-sign = ( if v-fact-qnty >= 0 then 1 else -1 )
     7115               .
     7116               assign
     7117                   v-sum-rubl = v-sum-rubl - v-vat-rubl - v-slt-rubl - v-road-tax-rubl - v-transport-rubl - v-other-rubl - v-excise-rubl
     7118                   v-sum-base = v-sum-base - v-vat-base - v-slt-base - v-road-tax-base - v-transport-base - v-other-base - v-excise-base
     7119                   v-sum-rubl = v-sum-rubl   * v-sign
     7120                   v-sum-base = v-sum-base   * v-sign
     7121                   v-vat-rubl = v-vat-rubl   * v-sign
     7122                   v-vat-base = v-vat-base   * v-sign
     7123                   v-fact-qnty = v-fact-qnty * v-sign
     7124               .
     7125               output to "fbrrep.txt" append .
     7126               put unformatted skip(1) v-fact-qnty "   " v-sum-rubl "    " v-vat-rubl.
     7127               output close.
     7128               assign
     7129                   buf_temp_fbrrep-goods.sum-cost-rubl     = absolute( buf_temp_fbrrep-goods.cost-rubl     * v-fact-qnty ) - absolute( v-sum-rubl )
     7130                   buf_temp_fbrrep-goods.sum-cost-base     = absolute( buf_temp_fbrrep-goods.cost-base     * v-fact-qnty ) - absolute( v-sum-base )
     7131                   buf_temp_fbrrep-goods.sum-vat-cost-rubl = absolute( buf_temp_fbrrep-goods.vat-cost-rubl * v-fact-qnty ) - absolute( v-vat-rubl )
     7132                   buf_temp_fbrrep-goods.sum-vat-cost-base = absolute( buf_temp_fbrrep-goods.vat-cost-base * v-fact-qnty ) - absolute( v-vat-base )
     7133               .
     7134               if buf_temp_fbrrep-goods.fact-qnty          = 0
     7135               and buf_temp_fbrrep-goods.sum-cost-rubl     = 0
     7136               and buf_temp_fbrrep-goods.sum-cost-base     = 0
     7137               and buf_temp_fbrrep-goods.sum-vat-cost-rubl = 0
     7138               and buf_temp_fbrrep-goods.sum-vat-cost-base = 0
     7139               then do:
     7140                   assign
     7141                       buf_temp_fbrrep-goods.deleted = yes
     7142                   .
     7143               end.
     7144           end.
     7145       end.
     7146       for each buf_temp_fbrrep-goods
     7147          where buf_temp_fbrrep-goods.deleted = yes
     7148       on error undo, return error
     7149       :
     7150           delete buf_temp_fbrrep-goods.
     7151       end.
     7152       run test-temp-tables in this-procedure .
     7153   end.
     7154   end procedure.
     7155   procedure test-temp-tables :
     7156   do
     7157   on error undo, return error
     7158   :
     7159       define variable v-str   as character     no-undo.
     7160       assign
     7161           v-str = ""
     7162       .
     7163       for each temp_fbrrep-goods
     7164       :
     7165           assign
     7166               v-str = v-str
     7167                   + chr(10) + temp_fbrrep-goods.artic
     7168                   + chr(9) + string( temp_fbrrep-goods.income-qnty )
     7169                   + chr(9) + string( temp_fbrrep-goods.write-off-qnty )
     7170                   + chr(9) + string( temp_fbrrep-goods.cost-rubl )
     7171                   + chr(9) + string( temp_fbrrep-goods.vat-cost-rubl )
     7172                   + chr(9) + string( temp_fbrrep-goods.sum-cost-rubl )
     7173                   + chr(9) + string( temp_fbrrep-goods.sum-vat-cost-rubl )
     7174                   + chr(9) + string( temp_fbrrep-goods.gds-name )
     7175           .
     7176       end.
     7177       output to "fbrrep.txt" append .
     7178       put unformatted skip(2) v-str.
     7179       output close.
     7180   end.
     7181   end procedure.
     7182   procedure fbrrep-test-fbrdoc-for-fact :
     7183   do
     7184   on error undo, return error
     7185   :
     7186   define output parameter p-have-error        as logical      no-undo.
