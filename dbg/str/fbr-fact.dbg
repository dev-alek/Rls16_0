     1931                 varprice-sale = 0
     1932                 varroad-tax   = 0
     1933                 varexcise     = 0
     1934               .
     1935             end.
     1936             assign
     1937               varlastcur-base     = varprice-sale
     1938               varlastcur-road-tax = varroad-tax
     1939               varlastcur-excise   = varexcise
     1940               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     1941               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     1942               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     1943               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     1944             .
     1945         end.
     1946       end.
     1947       if varcur-fact-qnty = 0 then do:
     1948         assign
     1949           varcur-base      = varlastcur-base
     1950           varcur-road-tax  = varlastcur-road-tax
     1951           varcur-excise    = varlastcur-excise
     1952         .
     1953       end.
     1954       else do:
     1955         assign
     1956           varcur-base      = varcur-base      / varcur-fact-qnty
     1957           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     1958           varcur-excise    = varcur-excise    / varcur-fact-qnty
     1959         .
     1960       end.
     1961       if varcur-vat-pc = ?
     1962       then do:
     1963         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     1964       end.
