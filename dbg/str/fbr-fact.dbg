        1   block-level on error undo, throw.
        2   define input  parameter parparentproc        as widget-handle no-undo .
        3   define input  parameter p-fbr-doc-recid      as recid         no-undo .
        4   define input  parameter p-silent             as logical       no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Создание, заполнение внутренней ПН; закрытие НС и ПН по факту".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   define new global shared variable g#lib-trn  as handle no-undo .
       81   define new global shared variable g#lib-trn2 as handle no-undo .
       82   define new global shared variable g#lib-trn3 as handle no-undo .
       83   define new global shared variable g#lib-trn4 as handle no-undo .
       84   define new global shared variable g#libtfarh as handle no-undo .
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   procedure doc-code:
       87   define input  parameter parmode          as   character           no-undo.
       88   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
       89   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
       90   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
       91   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
       92   define buffer buf_sys-ctrl for ub.sys-ctrl  .
       93   define variable vardb-remote     as   logical             no-undo.
       94   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
       95   define variable v-delimiter as character no-undo .
       96   do
       97   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       98   :
       99   find first buf_sys-ctrl no-lock .
      100   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      101     CASE parmode:
      102       when "main":u then do:
      103         if vardb-remote then do:
      104           assign
      105             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      106         end.
      107         else do:
      108           assign
      109             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      110         end.
      111       end.
      112       when "trio" then do:
      113         assign
      114           pardoc-code = replace (parroot-doc-code, "=", "*").
      115       end.
      116       otherwise do:
      117         assign
      118         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      119         no-error
      120         .
      121         if error-status:error  then do:
      122           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      123                                         ,chr(10)
      124                                         ,parmode
      125                                         ).
      126         end.
      127         if num-entries(parmode) = 1
      128         and parmode <> "chip":U
      129         and parmode <> "chip_s":U
      130         then do:
      131           assign
      132           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      133         end.
      134         else if (lookup("chip":U, parmode) > 0
      135                  or
      136                  lookup("chip_s":U, parmode) > 0) then do:
      137           assign
      138             vartemp-doc-code = parroot-doc-code.
      139           do while true:
      140             if index (vartemp-doc-code , ".") = 0 then
      141               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      142             else
      143               vartemp-doc-code  =
      144               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      145               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      146               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      147             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      148           end.
      149           assign
      150             pardoc-code = vartemp-doc-code.
      151         end.
      152       end.
      153     end CASE.
      154     if pardoc-code = '':U
      155     or (parroot-doc-code <> '':U
      156     and pardoc-code = parroot-doc-code) then do:
      157       undo, return error substitute("Ошибка при генерации номера документа&1"
      158                                     ,chr(10)).
      159     end.
      160   end.
      161   end. // procedure/method
      162   function get-doc-code-int64 returns int64
      163     ( input p-doc-code as character ) :
      164     define variable v-ind              as integer   no-undo .
      165     define variable v-num-entries      as integer   no-undo .
      166     define variable v-doc-code-int64   as int64     no-undo .
      167     define variable v-canonic-doc-code as character no-undo .
      168     assign
      169       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      170       v-canonic-doc-code = p-doc-code
      171     .
      172     do v-ind = 1 to v-num-entries
      173     :
      174       assign
      175         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      176       .
      177     end.
      178     assign
      179       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      180     .
      181     return v-doc-code-int64 .
      182   end. // function/method
