    11778               ""
    11779               view-as alert-box error
    11780             .
    11781               run waitfram-hide in this-procedure no-error.
    11782               undo, return error substitute( 'Ошибка при создании автоматической переоценки. Документ "&1". '
    11783                                           + 'Тип переоценки: &2 &3 &4.'
    11784                                           , buf_in_trn-doc.doc-code
    11785                                           , "before-margin"
    11786                                           , return-value
    11787                                           , buf_in_trn-doc.ext-doc-type ).
    11788             end.
    11789           end.
    11790           if buf_in_trn-doc.fact-date <> v-fact-date
    11791           then do:
    11792             run str/vtrecalc.p ( input parparentproc , input recid (buf_in_trn-doc)) no-error .
    11793             if error-status:error
    11794             then do:
    11795               undo, return error substitute( "Ошибка при закрытие документа прихода производства: &2. &1."
    11796                                             , return-value
    11797                                             , buf_in_trn-doc.doc-code
    11798                                             ).
    11799             end.
    11800           end.
    11801           if buf_in_trn-doc.obj-type = 'маг':U then do:
    11802   define variable vss-include-info80 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11803   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_add-scal in g#lib-trn3
    11804   (input parparentproc
    11805   ,input buf_in_trn-doc.obj-type
    11806   ,input buf_in_trn-doc.obj-code
    11807   ,input buf_in_trn-doc.doc-code
    11808   ,input buf_in_trn-doc.doc-type
    11809   ,input this-procedure
    11810   ) no-error.
    11811             if error-status:error
    11812             then do:
    11813   if session :set-wait-state( "" ) then.
    11814               undo, return error .
    11815             end.
    11816           end.
    11817           define variable v-par-value-l as logical   no-undo init false .
    11818   define variable vss-include-info81 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11819   empty temp-table thbjattr_thbj-attr.
    11820   run adm/shattri.p (
    11821      input "get":U
    11822     ,input buf_fbr-doc.obj-type
