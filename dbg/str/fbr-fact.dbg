     1545       bfacc_tt-allsum.slt-rubl-acc        = bf_tt-allsum.slt-rubl-acc
     1546       bfacc_tt-allsum.slt-cli-acc         = bf_tt-allsum.slt-cli-acc
     1547       bfacc_tt-allsum.excise-base-acc     = bf_tt-allsum.excise-base-acc
     1548       bfacc_tt-allsum.excise-rubl-acc     = bf_tt-allsum.excise-rubl-acc
     1549       bfacc_tt-allsum.excise-cli-acc      = bf_tt-allsum.excise-cli-acc
     1550       bfacc_tt-allsum.road-tax-base-acc   = bf_tt-allsum.road-tax-base-acc
     1551       bfacc_tt-allsum.road-tax-rubl-acc   = bf_tt-allsum.road-tax-rubl-acc
     1552       bfacc_tt-allsum.road-tax-cli-acc    = bf_tt-allsum.road-tax-cli-acc
     1553       bfacc_tt-allsum.transport-base-acc  = bf_tt-allsum.transport-base-acc
     1554       bfacc_tt-allsum.transport-rubl-acc  = bf_tt-allsum.transport-rubl-acc
     1555       bfacc_tt-allsum.transport-cli-acc   = bf_tt-allsum.transport-cli-acc
     1556       bfacc_tt-allsum.other-base-acc      = bf_tt-allsum.other-base-acc
     1557       bfacc_tt-allsum.other-rubl-acc      = bf_tt-allsum.other-rubl-acc
     1558       bfacc_tt-allsum.other-cli-acc       = bf_tt-allsum.other-cli-acc
     1559       .
     1560     assign
     1561       bfsacc_tt-allsum.fact-qnty           = bfs_tt-allsum.fact-qnty
     1562       bfsacc_tt-allsum.cli-qnty            = bfs_tt-allsum.cli-qnty
     1563       bfsacc_tt-allsum.sum-dsc-base-doc    = bfs_tt-allsum.sum-dsc-base-acc
     1564       bfsacc_tt-allsum.sum-dsc-rubl-doc    = bfs_tt-allsum.sum-dsc-rubl-acc
     1565       bfsacc_tt-allsum.dsc-base-doc        = bfs_tt-allsum.dsc-base-acc
     1566       bfsacc_tt-allsum.dsc-rubl-doc        = bfs_tt-allsum.dsc-rubl-acc
     1567       bfsacc_tt-allsum.vat-base-doc        = 0
     1568       bfsacc_tt-allsum.vat-rubl-doc        = 0
     1569       bfsacc_tt-allsum.vat-base-buyer-doc  = bfs_tt-allsum.vat-base-acc
     1570       bfsacc_tt-allsum.vat-rubl-buyer-doc  = bfs_tt-allsum.vat-rubl-acc
     1571       bfsacc_tt-allsum.slt-base-doc        = bfs_tt-allsum.slt-base-acc
     1572       bfsacc_tt-allsum.slt-rubl-doc        = bfs_tt-allsum.slt-rubl-acc
     1573       bfsacc_tt-allsum.road-tax-base-doc   = bfs_tt-allsum.road-tax-base-acc
     1574       bfsacc_tt-allsum.road-tax-rubl-doc   = bfs_tt-allsum.road-tax-rubl-acc
     1575       bfsacc_tt-allsum.excise-base-doc     = bfs_tt-allsum.excise-base-acc
     1576       bfsacc_tt-allsum.excise-rubl-doc     = bfs_tt-allsum.excise-rubl-acc
     1577       bfsacc_tt-allsum.sum-dsc-base-cur    = bfs_tt-allsum.sum-dsc-base-acc
     1578       bfsacc_tt-allsum.sum-dsc-rubl-cur    = bfs_tt-allsum.sum-dsc-rubl-acc
     1579       bfsacc_tt-allsum.dsc-base-cur        = bfs_tt-allsum.dsc-base-acc
     1580       bfsacc_tt-allsum.dsc-rubl-cur        = bfs_tt-allsum.dsc-rubl-acc
     1581       bfsacc_tt-allsum.vat-base-cur        = 0
     1582       bfsacc_tt-allsum.vat-rubl-cur        = 0
     1583       bfsacc_tt-allsum.vat-base-buyer-cur  = bfs_tt-allsum.vat-base-acc
     1584       bfsacc_tt-allsum.vat-rubl-buyer-cur  = bfs_tt-allsum.vat-rubl-acc
     1585       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     1586       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     1587       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     1588       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     1589       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     1590       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     1591       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     1592       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     1593       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     1594       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     1595       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     1596       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     1597       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     1598       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     1599       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     1600       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     1601       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     1602       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     1603       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     1604       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     1605       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     1606       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     1607       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     1608       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     1609       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     1610       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     1611       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     1612       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     1613       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     1614       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     1615       .
     1616   end.
     1617   otherwise do:
     1618     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     1619                              cl_tt-clcparts.purch-code,
     1620                              cl_tt-clcparts.part-code,
     1621                              cl_tt-clcparts.out-code,
     1622                              cl_tt-clcparts.in-code,
     1623                              cl_tt-clcparts.artic,
     1624                              cl_tt-clcparts.prod-type,
     1625                              cl_tt-clcparts.prod-code).
     1626   end.
     1627   end case.
     1628   end.
     1629   end procedure.
     1630   procedure clcprtsl_calc-line :
     1631   define input  parameter parrec-line as recid no-undo.
     1632   define variable v-tax-date         as   date                     no-undo.
     1633   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     1634   define variable varr-b             as   character                no-undo.
     1635   define variable varr-btype         as   character                no-undo.
     1636   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     1637   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     1638   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     1639   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     1640   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     1641   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     1642   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     1643   define variable varb-code          like ub.bar-code.b-code       no-undo.
     1644   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     1645   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     1646   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     1647   define variable varexcise          like ub.price-list.excise     no-undo.
     1648   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     1649   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     1650   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     1651   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     1652   define variable v-varsum           as decimal                  no-undo.
     1653   define variable varprice-salef as decimal   no-undo .
     1654   define buffer bf_trn-doc             for ub.trn-doc.
     1655   define buffer bf_doc-line            for ub.doc-line.
     1656   define buffer bf_gds-dtl             for ub.gds-dtl.
     1657   define buffer bf_goods               for ub.goods.
     1658   define buffer bf_parts               for ub.parts.
     1659   define buffer bf_sysconf             for ub.sysconf.
     1660   define buffer bf_tt-allsum-line      for tt-allsum-line.
     1661   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     1662   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     1663   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     1664   define buffer buf_parts        for ub.parts.
     1665   v-calcbypart = no.
     1666   do on error undo, return error return-value :
     1667   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1668   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1669     (output varr-b
     1670     )  .
     1671     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     1672     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     1673     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     1674                               bf_goods.prod-type = bf_doc-line.prod-type and
     1675                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     1676     if bf_trn-doc.fact-date <> ?        then do:
     1677       assign v-tax-date = bf_trn-doc.fact-date.
     1678     end.
     1679     else do:
     1680       assign v-tax-date = ?.
     1681     end.
     1682   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1683   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1684     (input  bf_goods.gds-code
     1685     ,input  '1':U
     1686     ,input  v-tax-date
     1687     ,input  bf_trn-doc.host-code
     1688     ,input  bf_trn-doc.obj-type
     1689     ,input  bf_trn-doc.obj-code
     1690     ,output v-vat-pc
     1691     ) no-error .
     1692     if error-status :error
     1693     or v-vat-pc = ? then do:
     1694        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     1695     end.
     1696     if bf_goods.gds-type = 'у':U or
     1697        bf_trn-doc.status_ = 'запрос':U then do:
     1698       for each bf_tt-allsum-line
     1699       on error undo, return error return-value
     1700        :
     1701         delete bf_tt-allsum-line.
     1702       end.
     1703       create bf_tt-allsum-line.
     1704       assign
     1705        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     1706       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     1707                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     1708                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     1709                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     1710         assign
     1711           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     1712           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     1713           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     1714           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     1715           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     1716           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1717           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1718           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     1719           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     1720           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     1721           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1722           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1723           bf_tt-allsum-line.vat-cli-acc          =  ?
     1724           .
     1725       end.
     1726       assign
     1727         bf_tt-allsum-line.cli-qnty             =  ?
     1728         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1729         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1730         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1731         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1732         bf_tt-allsum-line.road-tax-base-doc    =  0
     1733         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     1734         bf_tt-allsum-line.excise-base-doc      =  0
     1735         bf_tt-allsum-line.excise-rubl-doc      =  0
     1736         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
