     3333   procedure fbrlib_get-default-pay-code :
     3334   define input parameter p-obj-type   as character        no-undo.
     3335   define input parameter p-obj-code   as integer          no-undo.
     3336   define output parameter p-pay-code  as integer          no-undo.
     3337   define variable v-host-code as integer no-undo .
     3338   define buffer buf_shop          for ub.shop.
     3339   define buffer buf_store         for ub.store.
     3340   define buffer buf_sysconf       for ub.sysconf.
     3341   do
     3342   for buf_shop
     3343     , buf_store
     3344     , buf_sysconf
     3345   on error undo, return error
     3346   :
     3347     case p-obj-type  :
     3348       when 'маг':U then do:
     3349           find first buf_shop no-lock
     3350                 where buf_shop.obj-code = p-obj-code
     3351           no-error.
     3352           if available buf_shop
     3353           then do:
     3354               assign
     3355                   p-pay-code = buf_shop.fbr-pay
     3356               .
     3357           end.
     3358       end.
     3359       when 'скл':U then do:
     3360           find first buf_store no-lock
     3361                 where buf_store.obj-code = p-obj-code
     3362           no-error.
     3363           if available buf_store
     3364           then do:
     3365               assign
     3366                   p-pay-code = buf_store.fbr-pay
     3367               .
     3368           end.
     3369       end.
     3370     end case.
     3371     if p-pay-code = ?
     3372     or p-pay-code = 0
     3373     then do:
     3374   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3375   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3376     (input  p-obj-type
     3377     ,input  p-obj-code
     3378     ,output v-host-code
     3379     )  .
     3380         find first buf_sysconf no-lock
     3381               where buf_sysconf.host-code = v-host-code
     3382         no-error.
     3383         if available buf_sysconf
     3384         then do:
     3385             assign
     3386                 p-pay-code = buf_sysconf.fbr-pay
     3387             .
     3388         end.
     3389     end.
     3390     if p-pay-code = ?
     3391     or p-pay-code = 0
     3392     then do:
     3393   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3394   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdnpay in g#library
     3395     (input  p-obj-type
     3396     ,input  p-obj-code
     3397     ,output p-pay-code
     3398     )  .
     3399     end.
     3400   end.
     3401   end procedure.
     3402   procedure fbrlib-fill-and-check-temp_fbrlib_recipe :
     3403   do
     3404   on error undo, return error
     3405   :
     3406   define input parameter p-fbr-doc-code as character    no-undo.
     3407       define variable vss-description as character    no-undo init "fbrlib-fill-and-check-temp_fbrlib_recipe: ".
     3408       define variable v-gds-name      as character    no-undo.
     3409       define buffer buf_fbr-doc               for ub.fbr-doc.
     3410       define buffer buf_fbr-line              for ub.fbr-line.
     3411       define buffer buf_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     3412       define buffer buf_out_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     3413       find first buf_fbr-doc no-lock
     3414            where buf_fbr-doc.doc-code = p-fbr-doc-code
     3415       .
     3416       for each buf_temp_fbrlib_recipe
     3417       :
     3418           delete buf_temp_fbrlib_recipe.
     3419       end.
     3420       for each buf_fbr-line no-lock
     3421          where buf_fbr-line.doc-code = p-fbr-doc-code
     3422       :
     3423           find first buf_temp_fbrlib_recipe
     3424                where buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     3425           no-error.
     3426           if not available buf_temp_fbrlib_recipe
     3427           then do:
     3428               create buf_temp_fbrlib_recipe.
     3429               assign
     3430                   buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     3431                   buf_temp_fbrlib_recipe.fbr-doc-code = buf_fbr-line.doc-code
     3432               .
     3433           end.
     3434       end.
     3435       for each buf_temp_fbrlib_recipe
     3436       :
     3437           assign
     3438               buf_temp_fbrlib_recipe.count-income                = 0
     3439               buf_temp_fbrlib_recipe.qnty-income                 = 0
     3440               buf_temp_fbrlib_recipe.sum-income-sale             = 0
     3441               buf_temp_fbrlib_recipe.sum-income-cost-base        = 0
     3442               buf_temp_fbrlib_recipe.sum-income-cost-rubl        = 0
     3443               buf_temp_fbrlib_recipe.sum-income-vat-cost-base    = 0
     3444               buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl    = 0
     3445               buf_temp_fbrlib_recipe.count-write-off             = 0
     3446               buf_temp_fbrlib_recipe.qnty-write-off              = 0
     3447               buf_temp_fbrlib_recipe.sum-write-off-sale          = 0
     3448               buf_temp_fbrlib_recipe.sum-write-off-cost-base     = 0
     3449               buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = 0
     3450               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = 0
     3451               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = 0
     3452           .
     3453           for each buf_fbr-line no-lock
     3454              where buf_fbr-line.doc-code     = p-fbr-doc-code
     3455                and buf_fbr-line.trn-type     = 'при':U
     3456                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     3457           :
     3458               if ( buf_fbr-line.price-base   = ?
     3459                   or buf_fbr-line.price-rubl = ?
     3460                   or buf_fbr-line.price-base <= 0
     3461                   or buf_fbr-line.price-rubl <= 0 )
     3462               and buf_fbr-line.fact-qnty <> 0
     3463               and buf_fbr-line.rsrv-qnty <> ?
     3464               and buf_fbr-doc.is-free    = no
     3465               then do:
     3466   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3467   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     3468     (input  buf_fbr-line.artic
     3469     ,input  buf_fbr-line.prod-type
     3470     ,input  buf_fbr-line.prod-code
     3471     ,output v-gds-name
     3472     ) no-error .
     3473                   if error-status :error
     3474                   then do:
     3475                       assign
     3476                           v-gds-name = ""
     3477                       .
     3478                   end.
     3479                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     3480                                                 ,vss-description
     3481                                                 ,buf_fbr-doc.doc-code
     3482                                                 ,chr(10)
     3483                                                 ,buf_fbr-line.recipe-code
     3484                                                 ,buf_fbr-line.artic
     3485                                                 ,v-gds-name).
     3486               end.
     3487               assign
     3488                   buf_temp_fbrlib_recipe.count-income             = buf_temp_fbrlib_recipe.count-income + 1
     3489                   buf_temp_fbrlib_recipe.qnty-income              = buf_temp_fbrlib_recipe.qnty-income
     3490                                                                   + buf_fbr-line.fact-qnty
     3491                   buf_temp_fbrlib_recipe.sum-income-sale          = buf_temp_fbrlib_recipe.sum-income-sale
     3492                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     3493               .
     3494               if buf_fbr-line.is-waste = no
     3495               then do:
     3496                   assign
     3497                       buf_temp_fbrlib_recipe.sum-income-cost-base     = buf_temp_fbrlib_recipe.sum-income-cost-base
     3498                                                                       + buf_fbr-line.price-sum-base
     3499                       buf_temp_fbrlib_recipe.sum-income-cost-rubl     = buf_temp_fbrlib_recipe.sum-income-cost-rubl
     3500                                                                       + buf_fbr-line.price-sum-rubl
     3501                       buf_temp_fbrlib_recipe.sum-income-vat-cost-base = buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     3502                                                                       + buf_fbr-line.price-sum-vat-base
     3503                       buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     3504                                                                       + buf_fbr-line.price-sum-vat-rubl
     3505                   .
     3506               end.
     3507           end.
     3508           for each buf_fbr-line no-lock
     3509              where buf_fbr-line.doc-code     = p-fbr-doc-code
     3510                and buf_fbr-line.trn-type     = 'спи':U
     3511                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     3512           :
     3513               if ( buf_fbr-line.price-base   = ?
     3514                   or buf_fbr-line.price-rubl = ?
     3515                   or buf_fbr-line.price-base <= 0
     3516                   or buf_fbr-line.price-rubl <= 0 )
     3517               and buf_fbr-line.fact-qnty <> 0
     3518               and buf_fbr-line.rsrv-qnty <> ?
     3519               and buf_fbr-doc.is-free    = no
     3520               and buf_fbr-doc.status_    = 'разрешен':U
     3521               then do:
     3522   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3523   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     3524     (input  buf_fbr-line.artic
     3525     ,input  buf_fbr-line.prod-type
     3526     ,input  buf_fbr-line.prod-code
     3527     ,output v-gds-name
     3528     ) no-error .
     3529                   if error-status :error
     3530                   then do:
     3531                       assign
     3532                           v-gds-name = ""
     3533                       .
     3534                   end.
     3535                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     3536                                                 ,vss-description
     3537                                                 ,buf_fbr-doc.doc-code
     3538                                                 ,chr(10)
     3539                                                 ,buf_fbr-line.recipe-code
     3540                                                 ,buf_fbr-line.artic
     3541                                                 ,v-gds-name).
     3542               end.
     3543               assign
     3544                   buf_temp_fbrlib_recipe.count-write-off             = buf_temp_fbrlib_recipe.count-write-off + 1
     3545                   buf_temp_fbrlib_recipe.qnty-write-off              = buf_temp_fbrlib_recipe.qnty-write-off
     3546                                                                   + buf_fbr-line.fact-qnty
     3547                   buf_temp_fbrlib_recipe.sum-write-off-sale          = buf_temp_fbrlib_recipe.sum-write-off-sale
     3548                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     3549               .
     3550               if buf_fbr-line.is-waste = no
     3551               then do:
     3552                   assign
     3553                       buf_temp_fbrlib_recipe.sum-write-off-cost-base     = buf_temp_fbrlib_recipe.sum-write-off-cost-base
     3554                                                                       + buf_fbr-line.price-sum-base
     3555                       buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     3556                                                                       + buf_fbr-line.price-sum-rubl
     3557                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     3558                                                                       + buf_fbr-line.price-sum-vat-base
     3559                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     3560                                                                       + buf_fbr-line.price-sum-vat-rubl
     3561                   .
     3562               end.
     3563           end.
     3564           if buf_fbr-doc.status_    = 'разрешен':U
     3565           and ( abs( buf_temp_fbrlib_recipe.sum-write-off-cost-base     - buf_temp_fbrlib_recipe.sum-income-cost-base     ) > 0.01
     3566           or abs( buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     - buf_temp_fbrlib_recipe.sum-income-cost-rubl     ) > 0.01
     3567           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base - buf_temp_fbrlib_recipe.sum-income-vat-cost-base ) > 0.01
     3568           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl - buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl ) > 0.01
     3569               )
     3570           then do:
     3571            undo, return error
     3572               substitute("В документе пр-ва &1 Не совпадают суммы учетных цен для списанного и оприходованного по рецепту товара.&2" +
     3573                           "Рецепт: &3&2&4&4по списанному товару&4по оприходованному товару&2"  +
     3574                           "Сумма в баз.вал.&4&5&4&4&6&2" +
     3575                           "Сумма в &9.&4&7&4&4&8&2"
     3576                          , buf_fbr-doc.doc-code
     3577                          , chr(10)
     3578                          , buf_temp_fbrlib_recipe.recipe-code
     3579                          , chr(9)
     3580                          , buf_temp_fbrlib_recipe.sum-write-off-cost-base
     3581                          , buf_temp_fbrlib_recipe.sum-income-cost-base
     3582                          , buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     3583                          , buf_temp_fbrlib_recipe.sum-income-cost-rubl
     3584                          , "руб"
     3585                          )
     3586              +
     3587              substitute("НДС в баз.вал.&1&2&1&1&3&4" +
     3588                         "НДС в &7.&1&5&1&1&6&4"
     3589                        ,  chr(9)
     3590                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     3591                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     3592                        ,chr(10)
     3593                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     3594                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     3595                        ,"руб"
     3596                        )       .
     3597           end.
     3598       end.
     3599   end.
     3600   end procedure.
     3601   procedure fbrlib-fill-sum-fbr-doc :
     3602   do
     3603   on error undo, return error
     3604   :
     3605   define input parameter p-fbr-doc-recid  as recid        no-undo.
     3606   define input parameter p-mode           as character    no-undo.
     3607       define variable vss-description as character init "fbrlib-fill-sum-fbr-doc: "  no-undo.
     3608       define buffer buf_fbr-doc           for ub.fbr-doc.
     3609       define buffer buf_fbr-line          for ub.fbr-line.
     3610       define buffer buf_temp_fbrlib_recipe   for temp_fbrlib_recipe.
     3611       define variable v-in-count          as integer       no-undo.
     3612       define variable v-out-count         as integer       no-undo.
     3613       find first buf_fbr-doc exclusive-lock
     3614            where recid ( buf_fbr-doc ) = p-fbr-doc-recid
     3615       .
     3616       find first buf_temp_fbrlib_recipe no-error.
     3617       if not available buf_temp_fbrlib_recipe
     3618       then do:
     3619           run fbrlib-fill-and-check-temp_fbrlib_recipe in this-procedure (
     3620               input buf_fbr-doc.doc-code
     3621           ) no-error.
     3622           if error-status :error
     3623           then do:
     3624               undo, return error substitute("&1 Ошибка расчета сумм при заполнении шапки документа производства.&2&3&2&4"
     3625                                              , vss-description
     3626                                              , chr(10)
     3627                                              , error-status:get-message(1)
     3628                                              , return-value ).
     3629           end.
     3630       end.
     3631       assign
     3632           v-in-count                  = 0
     3633           buf_fbr-doc.in-qnty         = 0
     3634           buf_fbr-doc.in-sale         = 0
     3635           buf_fbr-doc.in-base         = 0
     3636           buf_fbr-doc.in-rubl         = 0
     3637           buf_fbr-doc.in-vat-base     = 0
     3638           buf_fbr-doc.in-vat-rubl     = 0
     3639           v-out-count                 = 0
     3640           buf_fbr-doc.out-qnty        = 0
     3641           buf_fbr-doc.out-sale        = 0
     3642           buf_fbr-doc.out-base        = 0
     3643           buf_fbr-doc.out-rubl        = 0
     3644           buf_fbr-doc.out-vat-base    = 0
     3645           buf_fbr-doc.out-vat-rubl    = 0
     3646       .
     3647       for each buf_temp_fbrlib_recipe
     3648       :
     3649           assign
     3650               v-in-count                  = v-in-count                + buf_temp_fbrlib_recipe.count-income
     3651               buf_fbr-doc.in-qnty         = buf_fbr-doc.in-qnty       + buf_temp_fbrlib_recipe.qnty-income
     3652               buf_fbr-doc.in-sale         = buf_fbr-doc.in-sale       + buf_temp_fbrlib_recipe.sum-income-sale
     3653               buf_fbr-doc.in-base         = buf_fbr-doc.in-base       + buf_temp_fbrlib_recipe.sum-income-cost-base
     3654               buf_fbr-doc.in-rubl         = buf_fbr-doc.in-rubl       + buf_temp_fbrlib_recipe.sum-income-cost-rubl
     3655               buf_fbr-doc.in-vat-base     = buf_fbr-doc.in-vat-base   + buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     3656               buf_fbr-doc.in-vat-rubl     = buf_fbr-doc.in-vat-rubl   + buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     3657               v-out-count                 = v-out-count               + buf_temp_fbrlib_recipe.count-write-off
     3658               buf_fbr-doc.out-qnty        = buf_fbr-doc.out-qnty      + buf_temp_fbrlib_recipe.qnty-write-off
     3659               buf_fbr-doc.out-sale        = buf_fbr-doc.out-sale      + buf_temp_fbrlib_recipe.sum-write-off-sale
     3660               buf_fbr-doc.out-base        = buf_fbr-doc.out-base      + buf_temp_fbrlib_recipe.sum-write-off-cost-base
     3661               buf_fbr-doc.out-rubl        = buf_fbr-doc.out-rubl      + buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     3662               buf_fbr-doc.out-vat-base    = buf_fbr-doc.out-vat-base  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     3663               buf_fbr-doc.out-vat-rubl    = buf_fbr-doc.out-vat-rubl  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     3664           .
     3665       end.
     3666       if ( abs (buf_fbr-doc.in-rubl - buf_fbr-doc.out-rubl) <= 0.01
     3667       and   abs (buf_fbr-doc.in-base - buf_fbr-doc.out-base) <= 0.01 )
     3668       or p-mode <> 'факт':U
     3669       then do:
     3670           if substring( buf_fbr-doc.PS, 1, 1 ) = "@"
     3671           then do:
     3672               assign
     3673                   buf_fbr-doc.PS = "@ Строк полученных товаров : "
     3674                                   + string( v-out-count, ">>>,>>9" )
     3675                                   + chr(10) + "Строк исходных товаров : "
     3676                                   + string( v-in-count, ">>>,>>9" )
     3677               .
     3678           end.
     3679       end.
     3680       else do:
     3681         undo, return error substitute("В док-те пр-ва &1 не совпадают суммы списанных и оприходованных товаров.&2" +
     3682                                       "Сумма списанных товаров в &3 - &4&2" +
     3683                                       "Сумма оприходованных товаров в &3 - &5&2" +
     3684                                       "Сумма оприходованных товаров в &3 - &6&2" +
     3685                                       "Сумма списанных товаров в баз.вал. - &7&2" +
     3686                                       "Сумма оприходованных товаров в баз.вал. - &8&2"
     3687                                       , buf_fbr-doc.doc-code
     3688                                       , chr(10)
     3689                                       , "рублях"
     3690                                       , round( buf_fbr-doc.out-rubl, 2 )
     3691                                       , round( buf_fbr-doc.in-rubl,  2 )
     3692                                       , round( buf_fbr-doc.in-rubl,  2 )
     3693                                       , round( buf_fbr-doc.out-base, 2 )
     3694                                       , round( buf_fbr-doc.in-base,  2 )).
     3695       end.
     3696   end.
     3697   end procedure.
     3698   procedure fbrlib-calc-prices :
     3699   do
     3700   on error undo, return error
     3701   :
     3702   define input parameter p-fbr-line-recid as recid        no-undo.
     3703   define input parameter p-price-obj-type as character    no-undo.
     3704   define input parameter p-price-obj-code as integer      no-undo.
     3705   define output parameter p-current-price as decimal      no-undo.
     3706       define variable v-void          as decimal       no-undo.
     3707       define variable v-void-char     as character     no-undo.
     3708       define variable v-gds-code      as integer       no-undo.
     3709       define variable v-b-code        as integer       no-undo.
     3710       define buffer buf_fbr-doc   for ub.fbr-doc.
     3711       define buffer buf_fbr-line  for ub.fbr-line.
     3712       define buffer buf_gds-prt   for ub.gds-prt.
     3713       define buffer buf_bar-code  for ub.bar-code.
     3714       find first buf_fbr-line no-lock
     3715           where recid( buf_fbr-line ) = p-fbr-line-recid
     3716       .
     3717   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3718   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     3719     (input  buf_fbr-line.artic
     3720     ,input  buf_fbr-line.prod-type
     3721     ,input  buf_fbr-line.prod-code
     3722     ,output v-gds-code
     3723     ) no-error .
     3724       if error-status :error
     3725       then do:
     3726         undo, return error substitute("&1 &2 &3&4Ошибка определения кода товара (артикул &7).&4&5&4&6"
     3727                                         ,vss-workfile
     3728                                         ,vss-revision
     3729                                         ,vss-description
     3730                                         ,chr(10)
     3731                                         , error-status:get-message(1)
     3732                                         , return-value
     3733                                         , buf_fbr-line.artic
     3734                                         ).
     3735       end.
     3736   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3737     (input  v-gds-code
     3738     ,input  ?
     3739     ,output v-b-code
     3740     ) no-error .
     3741       if error-status :error
     3742       then do:
     3743         undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара (код товара) &7.&4&5&4&6"
     3744                                         ,vss-workfile
     3745                                         ,vss-revision
     3746                                         ,vss-description
     3747                                         ,chr(10)
     3748                                         , error-status:get-message(1)
     3749                                         , return-value
     3750                                         , v-gds-code
     3751                                         ).
     3752       end.
     3753       if buf_fbr-line.is-calc = no
     3754       then do:
     3755   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3756   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3757     (input  p-price-obj-type
     3758     ,input  p-price-obj-code
     3759     ,input  v-b-code
     3760     ,input  0
     3761     ,input  0
     3762     ,output v-void-char
     3763     ,output p-current-price
     3764     ,output v-void
     3765     ,output v-void
     3766     ) no-error .
     3767           if error-status :error
     3768           then do:
     3769             undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара (код товара) &7.&4&5&4&6"
     3770                                             ,vss-workfile
     3771                                             ,vss-revision
     3772                                             ,vss-description
     3773                                             ,chr(10)
     3774                                             , error-status:get-message(1)
     3775                                             , return-value
     3776                                             , v-gds-code
     3777                                             ).
     3778           end.
     3779       end.
     3780       else do:
     3781           assign
     3782               p-current-price = buf_fbr-line.price-sale
     3783           .
     3784       end.
     3785   end.
     3786   end procedure.
     3787   procedure fbrlib-put-in-order-recipe :
     3788   do
     3789   on error undo, return error
     3790   :
     3791   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     3792       define variable v-recipe-counter    as integer          no-undo.
     3793       define variable v-recipe-amount     as integer init 0   no-undo.
     3794       define variable v-child-counter     as integer          no-undo.
     3795       define variable v-is-call-cycle     as logical          no-undo.
     3796       define variable v-str as character     no-undo.
     3797       define buffer buf_in_fbr-line       for ub.fbr-line.
     3798       define buffer buf_dress_fbr-line    for ub.fbr-line.
     3799       define buffer buf_fbr-line          for ub.fbr-line.
     3800       define buffer buf_recipe-gds        for ub.recipe-gds.
     3801       define buffer buf_recipe            for ub.recipe.
     3802       for each temp_recipe-childs-qnty
     3803       :
     3804           delete temp_recipe-childs-qnty.
     3805       end.
     3806       for each temp_recipe-childs
     3807       :
     3808           delete temp_recipe-childs.
     3809       end.
     3810       for each temp_recipe-order
     3811       :
     3812           delete temp_recipe-order.
     3813       end.
     3814       for each buf_fbr-line no-lock
     3815          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     3816       on error undo, return error
     3817       :
     3818           find first temp_recipe-childs-qnty
     3819                where temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     3820           no-error.
     3821           if not available temp_recipe-childs-qnty
     3822           then do:
     3823               create temp_recipe-childs-qnty.
     3824               assign
     3825                   v-recipe-amount                     = v-recipe-amount + 1
     3826                   temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     3827                   temp_recipe-childs-qnty.order       = v-recipe-amount
     3828                   temp_recipe-childs-qnty.childs-qnty = 0
     3829                   v-child-counter                     = 0
     3830               .
     3831           end.
     3832       end.
     3833       for each buf_in_fbr-line no-lock
     3834          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     3835            and buf_in_fbr-line.trn-type = 'спи':U
     3836       on error undo, return error
     3837       :
     3838           for each buf_dress_fbr-line no-lock
     3839              where buf_dress_fbr-line.doc-code    = p-fbr-doc-doc-code
     3840                and buf_dress_fbr-line.trn-type    = 'при':U
     3841                and buf_dress_fbr-line.artic       = buf_in_fbr-line.artic
     3842                and buf_dress_fbr-line.prod-type   = buf_in_fbr-line.prod-type
     3843                and buf_dress_fbr-line.prod-code   = buf_in_fbr-line.prod-code
     3844           on error undo, return error
     3845           :
     3846               find first buf_recipe no-lock
     3847                    where buf_recipe.recipe-code = buf_dress_fbr-line.recipe-code
     3848               .
     3849               if buf_in_fbr-line.is-comp = yes
     3850               then do:
     3851                   find last temp_recipe-childs-qnty
     3852                       where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     3853                   .
     3854                   assign
     3855                       temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     3856                   .
     3857                   create temp_recipe-childs.
     3858                   assign
     3859                       temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     3860                       temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     3861                       temp_recipe-childs.child-recipe-code    = buf_dress_fbr-line.recipe-code
     3862                   .
     3863               end.
     3864               else do:
     3865               end.
     3866           end.
     3867       end.
     3868       for each buf_in_fbr-line no-lock
     3869          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     3870            and buf_in_fbr-line.trn-type = 'при':U
     3871       on error undo, return error
     3872       :
     3873           find first buf_recipe no-lock
     3874                where buf_recipe.recipe-code = buf_in_fbr-line.recipe-code
     3875           no-error.
     3876           if buf_in_fbr-line.is-comp = no
     3877           then do:
     3878           end.
     3879           else do:
     3880               for each buf_recipe-gds no-lock
     3881               where buf_recipe-gds.recipe-code = buf_in_fbr-line.recipe-code
     3882               :
     3883                   for each buf_fbr-line no-lock
     3884                   where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     3885                       and buf_fbr-line.trn-type    = 'при':U
     3886                       and buf_fbr-line.artic       = buf_recipe-gds.artic
     3887                       and buf_fbr-line.prod-type   = buf_recipe-gds.prod-type
     3888                       and buf_fbr-line.prod-code   = buf_recipe-gds.prod-code
     3889                   on error undo, return error
     3890                   :
     3891                       find first buf_recipe no-lock
     3892                            where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     3893                       .
     3894                       if buf_recipe.recipe-type = 'разделка':U
     3895                       then do:
     3896                       end.
     3897                       else do:
     3898                           find last temp_recipe-childs-qnty
     3899                               where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     3900                           .
     3901                           assign
     3902                               temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     3903                           .
     3904                           create temp_recipe-childs.
     3905                           assign
     3906                               temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     3907                               temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     3908                               temp_recipe-childs.child-recipe-code    = buf_fbr-line.recipe-code
     3909                           .
     3910                       end.
     3911                   end.
     3912               end.
     3913           end.
     3914       end.
     3915       for each temp_recipe-order
     3916       on error undo, return error
     3917       :
     3918           delete temp_recipe-order.
     3919       end.
     3920       assign
     3921           v-fbrlib-recipe-order = 0
     3922       .
     3923       do v-recipe-counter = 1 to v-recipe-amount
     3924       on error undo, return error
     3925       :
     3926           run fbrlib-add-recipe-in-tmp-order in this-procedure (
     3927                 input v-recipe-counter
     3928               , input 0
     3929               , output v-is-call-cycle
     3930           ).
     3931           if v-is-call-cycle = yes
     3932           then do:
     3933               message
     3934                       "Достигнут максимальный уровень вложенности рецептов."
     3935                   skip(1)
     3936                   skip "Невозможно упорядочить рецепты."
     3937                   skip(1)
     3938                   skip "Необходимо изменить структуру рецептов,"
     3939                   skip "используемых при формировании"
     3940                   skip "данного документа производства."
     3941               view-as alert-box error
     3942               title "Невозможно рассчитать документ производства".
     3943               for each temp_recipe-childs-qnty
     3944               :
     3945                   delete temp_recipe-childs-qnty.
     3946               end.
     3947               for each temp_recipe-childs
     3948               :
     3949                   delete temp_recipe-childs.
     3950               end.
     3951               for each temp_recipe-order
     3952               :
     3953                   delete temp_recipe-order.
     3954               end.
     3955               for each temp_recipe-order
     3956               on error undo, return error
     3957               :
     3958                   delete temp_recipe-order.
     3959               end.
     3960               for each temp_fbrlib_recipe
     3961               on error undo, return error
     3962               :
     3963                   delete temp_recipe-order.
     3964               end.
     3965               undo, return error.
     3966           end.
     3967       end.
     3968   end.
     3969   end procedure.
     3970   procedure fbrlib-add-recipe-in-tmp-order :
     3971   do
     3972   on error undo, return error
     3973   :
     3974   define input parameter p-order              as integer      no-undo.
     3975   define input parameter p-call-counter       as integer      no-undo.
     3976   define output parameter p-is-call-cycle     as logical      no-undo.
     3977       define variable v-nodes-counter     as integer       no-undo.
     3978       define buffer buf_c_temp_recipe-childs-qnty for temp_recipe-childs-qnty.
     3979       define buffer buf_temp_recipe-childs-qnty   for temp_recipe-childs-qnty.
     3980       define buffer buf_temp_recipe-childs        for temp_recipe-childs     .
     3981       define buffer buf_temp_recipe-order         for temp_recipe-order.
     3982       assign
     3983           p-call-counter = p-call-counter + 1
     3984       .
     3985       if p-call-counter > 50
     3986       then do:
     3987           assign
     3988               p-is-call-cycle = yes
     3989           .
     3990       end.
     3991       else do:
     3992           find first buf_temp_recipe-childs-qnty
     3993                where buf_temp_recipe-childs-qnty.order = p-order
     3994           .
     3995           find first buf_temp_recipe-order
     3996                where buf_temp_recipe-order.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     3997           no-error.
     3998           if not available buf_temp_recipe-order
     3999           then do:
     4000               do v-nodes-counter = 1 to buf_temp_recipe-childs-qnty.childs-qnty
     4001               :
     4002                   find first buf_temp_recipe-childs
     4003                        where buf_temp_recipe-childs.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     4004                          and buf_temp_recipe-childs.child-code  = v-nodes-counter
     4005                   .
     4006                   find first buf_c_temp_recipe-childs-qnty
     4007                        where buf_c_temp_recipe-childs-qnty.recipe-code = buf_temp_recipe-childs.child-recipe-code
     4008                   .
     4009                   run fbrlib-add-recipe-in-tmp-order in this-procedure (
     4010                         input buf_c_temp_recipe-childs-qnty.order
     4011                       , input p-call-counter
     4012                       , output p-is-call-cycle
     4013                   ).
     4014                   if p-is-call-cycle = yes
     4015                   then do:
     4016                       return.
     4017                   end.
     4018               end.
     4019               assign
     4020                   v-fbrlib-recipe-order = v-fbrlib-recipe-order + 1
     4021               .
     4022               create buf_temp_recipe-order.
     4023               assign
     4024                   buf_temp_recipe-order.recipe-code   = buf_temp_recipe-childs-qnty.recipe-code
     4025                   buf_temp_recipe-order.order         = v-fbrlib-recipe-order
     4026               .
     4027           end.
     4028       end.
     4029   end.
     4030   end procedure.
     4031   procedure fbrlib-get-trn-type :
     4032   define input parameter p-recipe-code    as character    no-undo.
     4033   define input parameter p-goods-recid    as recid        no-undo.
     4034   define input parameter p-is-integration as logical      no-undo.
     4035   define output parameter p-is-comp       as logical      no-undo.
     4036   define output parameter p-trn-type      as character    no-undo.
     4037   define buffer buf_recipe    for ub.recipe.
     4038   define buffer buf_goods     for ub.goods.
     4039   do
     4040   for buf_recipe
     4041     , buf_goods
     4042   on error undo, return error
     4043   :
     4044       find first buf_goods no-lock
     4045            where recid( buf_goods ) = p-goods-recid
     4046       .
     4047       find first buf_recipe no-lock
     4048            where buf_recipe.recipe-code = p-recipe-code
     4049       no-error.
     4050       if not available buf_recipe
     4051       then do:
     4052           assign
     4053               p-is-comp = no
     4054               p-trn-type = "":U
     4055           .
     4056           undo, return.
     4057       end.
     4058       if  buf_recipe.artic        = buf_goods.artic
     4059       and buf_recipe.prod-type    = buf_goods.prod-type
     4060       and buf_recipe.prod-code    = buf_goods.prod-code
     4061       then do:
     4062           assign
     4063               p-is-comp = yes
     4064           .
     4065       end.
     4066       else do:
     4067           assign
     4068               p-is-comp = no
     4069           .
     4070       end.
     4071       case buf_recipe.recipe-type
     4072       :
     4073           when 'производство':U
     4074           then do:
     4075               if p-is-comp = yes
     4076               then do:
     4077                   assign
     4078                       p-trn-type = 'при':U
     4079                   .
     4080               end.
     4081               else do:
     4082                   assign
     4083                       p-trn-type = 'спи':U
     4084                   .
     4085               end.
     4086           end.
     4087           when 'альтернатива':U
     4088           then do:
     4089               if p-is-comp = yes
     4090               then do:
     4091                   assign
     4092                       p-trn-type = 'при':U
     4093                   .
     4094               end.
     4095               else do:
     4096                   assign
     4097                       p-trn-type = 'спи':U
     4098                   .
     4099               end.
     4100           end.
     4101           when 'разделка':U
     4102           then do:
     4103               if p-is-comp = no
     4104               then do:
     4105                   assign
     4106                       p-trn-type = 'при':U
     4107                   .
     4108               end.
     4109               else do:
     4110                   assign
     4111                       p-trn-type = 'спи':U
     4112                   .
     4113               end.
     4114           end.
     4115           when 'комплектация':U
     4116           then do:
     4117               if p-is-integration = ?
     4118               then do:
     4119                   message
     4120                       "Выберите тип операции по рецепту комплектации:"
     4121                       skip (2) "YES - комплектация"
     4122                       skip     "NO - разукомплектация"
     4123                   view-as alert-box question
     4124                   buttons YES-NO
     4125                   update p-is-integration.
     4126               end.
     4127               if p-is-integration = yes
     4128               then do:
     4129                   if p-is-comp = yes
     4130                   then do:
     4131                       assign
     4132                           p-trn-type = 'при':U
     4133                       .
     4134                   end.
     4135                   else do:
     4136                       assign
     4137                           p-trn-type = 'спи':U
     4138                       .
     4139                   end.
     4140               end.
     4141               else do:
     4142                   if p-is-comp = yes
     4143                   then do:
     4144                       assign
     4145                           p-trn-type = 'спи':U
     4146                       .
     4147                   end.
     4148                   else do:
     4149                       assign
     4150                           p-trn-type = 'при':U
     4151                       .
     4152                   end.
     4153               end.
     4154           end.
     4155       end case.
     4156   end.
     4157   end procedure.
     4158   procedure fbrlib-get-mark :
     4159   define input parameter p-recipe-code    as character    no-undo.
     4160   define output parameter p-mark          as logical    no-undo.
     4161   define buffer buf_goods-attr     for ub.goods-attr.
     4162   define buffer buf_recipe-gds for ub.recipe-gds .
     4163       for each buf_recipe-gds no-lock where buf_recipe-gds.recipe-code = p-recipe-code,
     4164            first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_recipe-gds.gds-code and
     4165                                               buf_goods-attr.attr-code = 'mark-type':U:
     4166            if buf_goods-attr.attr-value <> "" and buf_goods-attr.attr-value <> "not-type" then do:
     4167               p-mark = true .
     4168               return .
     4169            end.
     4170       end.
     4171   end procedure.
     4172   procedure fbrlib-check-temp-tables :
     4173   do
     4174   on error undo, return error
     4175   :
     4176   define input parameter p-title  as character    no-undo.
     4177       define variable v-str               as character        no-undo.
     4178       assign
     4179           v-str = v-str + chr(10) + "temp_recipe-childs-qnty:" + chr(10)
     4180       .
     4181       for each temp_recipe-childs-qnty
     4182       on error undo, return error
     4183       :
     4184           assign
     4185               v-str   = v-str + string( temp_recipe-childs-qnty.recipe-code )
     4186                       + "   " + string( temp_recipe-childs-qnty.childs-qnty )
     4187                       + "   " + string( temp_recipe-childs-qnty.order )
     4188                       + chr(10)
     4189           .
     4190       end.
     4191       assign
     4192           v-str = v-str + "temp_recipe-childs:" + chr(10)
     4193       .
     4194       for each temp_recipe-childs
     4195       on error undo, return error
     4196       :
     4197           assign
     4198               v-str   = v-str + string( temp_recipe-childs.recipe-code )
     4199                       + "   " + string( temp_recipe-childs.child-code )
     4200                       + "   " + string( temp_recipe-childs.child-recipe-code )
     4201                       + chr(10)
     4202           .
     4203       end.
     4204       assign
     4205           v-str = v-str + chr(10) + "temp_recipe-order:" + chr(10)
     4206       .
     4207       for each temp_recipe-order
     4208       on error undo, return error
     4209       :
     4210           assign
     4211               v-str   = v-str + string( temp_recipe-order.recipe-code )
     4212                       + "   " + string( temp_recipe-order.order )
     4213                       + chr(10)
     4214           .
     4215       end.
     4216       assign
     4217           v-str = v-str + chr(10) + "temp_fbrlib_recipe:" + chr(10)
     4218       .
     4219       run writelog in this-procedure ( input "fbr.log", input 0, input p-title ).
     4220       run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     4221       for each temp_fbrlib_recipe
     4222       on error undo, return error
     4223       :
     4224           assign
     4225               v-str   = "recipe-code: "                   + string( temp_fbrlib_recipe.recipe-code                 )
     4226                       + "   " + "count-income: "                  + string( temp_fbrlib_recipe.count-income                )
     4227                       + "   " + "qnty-income: "                   + string( temp_fbrlib_recipe.qnty-income                 )
     4228                       + "   " + "sum-income-sale: "               + string( temp_fbrlib_recipe.sum-income-sale             )
     4229                       + "   " + "sum-income-cost-base: "          + string( temp_fbrlib_recipe.sum-income-cost-base        )
     4230                       + "   " + "sum-income-cost-rubl: "          + string( temp_fbrlib_recipe.sum-income-cost-rubl        )
     4231                       + "   " + "sum-income-vat-cost-base: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-base    )
     4232                       + "   " + "sum-income-vat-cost-rubl: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-rubl    )
     4233                       + "   " + "count-write-off: "               + string( temp_fbrlib_recipe.count-write-off             )
     4234                       + "   " + "qnty-write-off: "                + string( temp_fbrlib_recipe.qnty-write-off              )
     4235                       + "   " + "sum-write-off-sale: "            + string( temp_fbrlib_recipe.sum-write-off-sale          )
     4236                       + "   " + "sum-write-off-cost-base: "       + string( temp_fbrlib_recipe.sum-write-off-cost-base     )
     4237                       + "   " + "sum-write-off-cost-rubl: "       + string( temp_fbrlib_recipe.sum-write-off-cost-rubl     )
     4238                       + "   " + "sum-write-off-vat-cost-base: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-base )
     4239                       + "   " + "sum-write-off-vat-cost-rubl: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-rubl )
     4240                       + chr(10)
     4241           .
     4242           run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     4243       end.
     4244   end.
     4245   end procedure.
     4246   procedure fbrlib-s-coeff-value :
     4247   define input  parameter p-gds-code    as integer        no-undo.
     4248   define input  parameter p-date        as date           no-undo.
     4249   define input  parameter p-obj-type    as character      no-undo.
     4250   define input  parameter p-obj-code    as integer        no-undo.
     4251   define output parameter p-coeff-value as decimal        no-undo.
     4252   define variable vss-description as character init "fbrlib-s-coeff-value-01: определяет значение сезонного коэффициента" no-undo.
     4253       define variable v-date          as date         no-undo.
     4254       define variable v-host-code     as integer      no-undo.
     4255       define buffer buf_goods       for ub.goods.
     4256       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     4257       define buffer buf_clients     for ub.clients.
     4258       define buffer buf_s-coeff     for ub.s-coeff.
     4259   do
     4260   for buf_goods
     4261     , buf_fbr-gds-obj
     4262     , buf_clients
     4263     , buf_s-coeff
     4264   on error undo, return error return-value
     4265   :
     4266       find first buf_goods no-lock
     4267            where buf_goods.gds-code = p-gds-code
     4268       no-error .
     4269       if not available buf_goods
     4270       then do:
     4271          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден товар с кодом &1", p-gds-code).
     4272       end.
     4273       find first buf_clients no-lock
     4274            where buf_clients.obj-type = p-obj-type
     4275              and buf_clients.obj-code = p-obj-code
     4276       no-error.
     4277       if not available buf_clients
     4278       then do:
     4279          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден объект &1&2", p-obj-type, p-obj-code).
     4280       end.
     4281       assign
     4282           v-date = date(month(p-date), day(p-date), Year(01/01/1996))
     4283       .
     4284       find first buf_fbr-gds-obj no-lock
     4285            where buf_fbr-gds-obj.gds-code = p-gds-code
     4286              and buf_fbr-gds-obj.obj-type = p-obj-type
     4287              and buf_fbr-gds-obj.obj-code = p-obj-code
     4288       no-error.
     4289       if not available buf_fbr-gds-obj
     4290       or buf_fbr-gds-obj.is-season = no
     4291       then do:
     4292           assign
     4293               p-coeff-value = 0
     4294           .
     4295           return.
     4296       end.
     4297   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4298   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4299     (input  p-obj-type
     4300     ,input  p-obj-code
     4301     ,output v-host-code
     4302     )  .
     4303       find last buf_s-coeff no-lock
     4304           where buf_s-coeff.gds-code = p-gds-code
     4305             and buf_s-coeff.host-code = v-host-code
     4306             and buf_s-coeff.obj-type = p-obj-type
     4307             and buf_s-coeff.obj-code = p-obj-code
     4308             and buf_s-coeff.s-date <= v-date
     4309       no-error.
     4310       if available buf_s-coeff
     4311       then do:
     4312           assign
     4313               p-coeff-value = buf_s-coeff.coeff-value
     4314           .
     4315           return.
     4316       end.
     4317       find last buf_s-coeff no-lock
     4318           where buf_s-coeff.gds-code = p-gds-code
     4319             and buf_s-coeff.host-code = v-host-code
     4320             and buf_s-coeff.obj-type = "":U
     4321             and buf_s-coeff.obj-code = 0
     4322             and buf_s-coeff.s-date <= v-date
     4323       no-error.
     4324       if available buf_s-coeff
     4325       then do:
     4326           assign
     4327               p-coeff-value = buf_s-coeff.coeff-value
     4328           .
     4329           return.
     4330       end.
     4331       find last buf_s-coeff no-lock
     4332           where buf_s-coeff.gds-code = p-gds-code
     4333             and buf_s-coeff.host-code = 0
     4334             and buf_s-coeff.obj-type = "":U
     4335             and buf_s-coeff.obj-code = 0
     4336             and buf_s-coeff.s-date <= v-date
     4337       no-error.
     4338       if available buf_s-coeff
     4339       then do:
     4340           assign
     4341               p-coeff-value = buf_s-coeff.coeff-value
     4342           .
     4343       end.
     4344       else do:
     4345           assign
     4346               p-coeff-value = 0
     4347           .
     4348       end.
     4349   end.
     4350   end procedure.
     4351   procedure fbrlib_create-fbr-recipe-gds :
     4352   define input parameter p-doc-code         as character      no-undo.
     4353   define input parameter p-recipe-code      as character      no-undo.
     4354   define input parameter p-prod-type        as character      no-undo.
     4355   define input parameter p-prod-code        as integer        no-undo.
     4356   define input parameter p-artic            as character      no-undo.
     4357   define input parameter p-gds-code         as integer        no-undo.
     4358   define input parameter p-is-waste         as logical        no-undo.
     4359   define input parameter p-proc-number      as integer        no-undo.
     4360   define input parameter p-obj-date         as date           no-undo.
     4361   define input parameter p-obj-type         as character      no-undo.
     4362   define input parameter p-obj-code         as integer        no-undo.
     4363   define input parameter p-calc-method      as decimal        no-undo.
     4364   define input parameter p-coeff-waste      as decimal        no-undo.
     4365   define input parameter p-orig-qnty        as decimal        no-undo.
     4366   define input parameter p-orig-brutto-qnty as decimal        no-undo.
     4367       define variable v-coeff-season  as decimal      no-undo.
     4368       define variable v-void-decimal  as decimal      no-undo.
     4369       define variable v-void-integer  as integer      no-undo.
     4370       define variable v-recipe-type   as character    no-undo.
     4371       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4372       define buffer buf_goods             for ub.goods.
     4373       define buffer buf_recipe            for ub.recipe.
     4374   do
     4375   for buf_fbr-recipe-gds
     4376     , buf_recipe
     4377     , buf_goods
     4378   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4379   :
     4380       find first buf_fbr-recipe-gds exclusive-lock
     4381            where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4382              and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4383              and buf_fbr-recipe-gds.prod-type   = p-prod-type
     4384              and buf_fbr-recipe-gds.prod-code   = p-prod-code
     4385              and buf_fbr-recipe-gds.artic       = p-artic
     4386       no-error.
     4387       if not available buf_fbr-recipe-gds
     4388       then do:
     4389           create buf_fbr-recipe-gds.
     4390           assign
     4391               buf_fbr-recipe-gds.doc-code           = p-doc-code
     4392               buf_fbr-recipe-gds.recipe-code        = p-recipe-code
     4393               buf_fbr-recipe-gds.prod-type          = p-prod-type
     4394               buf_fbr-recipe-gds.prod-code          = p-prod-code
     4395               buf_fbr-recipe-gds.artic              = p-artic
     4396               buf_fbr-recipe-gds.gds-code           = p-gds-code
     4397               buf_fbr-recipe-gds.is-waste           = p-is-waste
     4398               buf_fbr-recipe-gds.proc-number        = p-proc-number
     4399               buf_fbr-recipe-gds.recipe-qnty        = p-orig-qnty
     4400               buf_fbr-recipe-gds.recipe-brutto-qnty = p-orig-brutto-qnty
     4401           .
     4402           find first buf_goods no-lock
     4403                where buf_goods.prod-type = buf_fbr-recipe-gds.prod-type
     4404                  and buf_goods.prod-code = buf_fbr-recipe-gds.prod-code
     4405                  and buf_goods.artic     = buf_fbr-recipe-gds.artic
     4406           .
     4407           run fbrlib-s-coeff-value in this-procedure (
     4408                 input buf_goods.gds-code
     4409               , input p-obj-date
     4410               , input p-obj-type
     4411               , input p-obj-code
     4412               , output v-coeff-season
     4413           ) no-error.
     4414           if error-status:error
     4415           then do:
     4416               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     4417           end.
     4418           assign
     4419               buf_fbr-recipe-gds.qnty         = p-orig-qnty
     4420               buf_fbr-recipe-gds.coeff-value  = v-coeff-season
     4421               buf_fbr-recipe-gds.coeff-waste  = p-coeff-waste
     4422           .
     4423           run fbrlib-get-recipe-type in this-procedure (
     4424                 input buf_fbr-recipe-gds.doc-code
     4425               , input buf_fbr-recipe-gds.recipe-code
     4426               , output v-recipe-type
     4427           ).
     4428           if v-recipe-type <> 'производство':U
     4429           then do:
     4430               assign
     4431                   buf_fbr-recipe-gds.coeff-value  = 0
     4432                   buf_fbr-recipe-gds.coeff-waste  = 0
     4433                   buf_fbr-recipe-gds.calc-method  = 1
     4434                   buf_fbr-recipe-gds.brutto-qnty  = buf_fbr-recipe-gds.qnty
     4435               .
     4436           end.
     4437           else do:
     4438               run fbrlib-calc-brutto in this-procedure (
     4439                     input v-recipe-type
     4440                   , input buf_fbr-recipe-gds.qnty
     4441                   , input buf_fbr-recipe-gds.coeff-value
     4442                   , input buf_fbr-recipe-gds.coeff-waste
     4443                   , input 0
     4444                   , input 3
     4445                   , output v-void-decimal
     4446                   , output v-void-decimal
     4447                   , output buf_fbr-recipe-gds.brutto-qnty
     4448                   , output v-void-integer
     4449               ).
     4450               assign
     4451                   buf_fbr-recipe-gds.calc-method  = p-calc-method
     4452               .
     4453               run fbrlib-calc-brutto in this-procedure (
     4454                     input v-recipe-type
     4455                   , input buf_fbr-recipe-gds.qnty
     4456                   , input buf_fbr-recipe-gds.coeff-value
     4457                   , input buf_fbr-recipe-gds.coeff-waste
     4458                   , input buf_fbr-recipe-gds.brutto-qnty
     4459                   , input buf_fbr-recipe-gds.calc-method
     4460                   , output buf_fbr-recipe-gds.qnty
     4461                   , output v-void-decimal
     4462                   , output v-void-decimal
     4463                   , output v-void-integer
     4464               ).
     4465           end.
     4466       end.
     4467   end.
     4468   end procedure.
     4469   procedure fbrlib-set-default-recipe :
     4470   define input parameter p-obj-type   as character    no-undo.
     4471   define input parameter p-obj-code   as integer      no-undo.
     4472   define input parameter p-gds-code   as integer      no-undo.
     4473       define variable v-artic             as character    no-undo.
     4474       define variable v-prod-type         as character    no-undo.
     4475       define variable v-prod-code         as character    no-undo.
     4476       define variable v-recipe-code       as character    no-undo.
     4477       define variable v-fbr-gds-obj-recid as recid        no-undo.
     4478       define variable v-recipe-found      as logical      no-undo.
     4479       define buffer buf_recipe        for ub.recipe.
     4480       define buffer buf_other_recipe  for ub.recipe.
     4481       define buffer buf_goods         for ub.goods.
     4482       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     4483   do
     4484   for buf_recipe
     4485     , buf_goods
     4486     , buf_fbr-gds-obj
     4487   on error undo, return error
     4488   :
     4489       find first buf_goods no-lock
     4490            where buf_goods.gds-code = p-gds-code
     4491       .
     4492       run fbrlib-get-obj-recipe in this-procedure (
     4493             input p-obj-type
     4494           , input p-obj-code
     4495           , input p-gds-code
     4496           , output v-recipe-code
     4497       ).
     4498       if v-recipe-code <> ""
     4499       then do:
     4500           find first buf_recipe no-lock
     4501               where buf_recipe.recipe-code = v-recipe-code
     4502           no-error.
     4503           if not available buf_recipe
     4504           then do:
     4505               assign
     4506                   v-recipe-code = ""
     4507               .
     4508           end.
     4509       end.
     4510       if v-recipe-code = ""
     4511       then do:
     4512           find first buf_fbr-gds-obj exclusive-lock
     4513                where buf_fbr-gds-obj.obj-type = p-obj-type
     4514                  and buf_fbr-gds-obj.obj-code = p-obj-code
     4515                  and buf_fbr-gds-obj.gds-code = p-gds-code
     4516           no-error.
     4517           if not available buf_fbr-gds-obj
     4518           then do:
     4519               run ref/fgdsobj1.p (
     4520                     input-output v-fbr-gds-obj-recid
     4521                   , input 'ДОБАВЛЕНИЕ':U
     4522                   , input no
     4523                   , input p-gds-code
     4524                   , input p-obj-type
     4525                   , input p-obj-code
     4526                   , input 0
     4527                   , input ""
     4528                   , input 0
     4529                   , input no
     4530                   , input no
     4531                   , input no
     4532                   , input no
     4533                   , input no
     4534                   , input no
     4535               ) no-error.
     4536               if error-status:error
     4537               then do:
     4538                   message
     4539                           vss-workfile vss-revision vss-description
     4540                       skip "Ошибка изменения атрибутов товара на объекте"
     4541                       skip return-value
     4542                       skip trim(error-status :get-message(1))
     4543                               trim(error-status :get-message(2))
     4544                               trim(error-status :get-message(3))
     4545                   view-as alert-box error.
     4546                   undo, return error .
     4547               end.
     4548               find first buf_fbr-gds-obj exclusive-lock
     4549                    where recid( buf_fbr-gds-obj ) = v-fbr-gds-obj-recid
     4550               .
     4551           end.
     4552           assign
     4553               v-recipe-found = no
     4554           .
     4555           for first buf_recipe no-lock
     4556               where buf_recipe.obj-type    = p-obj-type
     4557                 and buf_recipe.obj-code    = p-obj-code
     4558                 and buf_recipe.artic       = buf_goods.artic
     4559                 and buf_recipe.prod-type   = buf_goods.prod-type
     4560                 and buf_recipe.prod-code   = buf_goods.prod-code
     4561                 and buf_recipe.recipe-type = 'производство':U
     4562                 or (
     4563                     buf_recipe.obj-type    = ""
     4564                 and buf_recipe.obj-code    = 0
     4565                 and buf_recipe.artic       = buf_goods.artic
     4566                 and buf_recipe.prod-type   = buf_goods.prod-type
     4567                 and buf_recipe.prod-code   = buf_goods.prod-code
     4568                 and buf_recipe.recipe-type = 'производство':U
     4569                     )
     4570           :
     4571               assign
     4572                   v-recipe-found = yes
     4573                   buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     4574               .
     4575           end.
     4576           if v-recipe-found = no
     4577           then do:
     4578               for first buf_recipe no-lock
     4579                   where buf_recipe.obj-type    = p-obj-type
     4580                     and buf_recipe.obj-code    = p-obj-code
     4581                     and buf_recipe.artic       = buf_goods.artic
     4582                     and buf_recipe.prod-type   = buf_goods.prod-type
     4583                     and buf_recipe.prod-code   = buf_goods.prod-code
     4584                     and buf_recipe.recipe-type <> 'альтернатива':U
     4585                     or (
     4586                         buf_recipe.obj-type    = ""
     4587                     and buf_recipe.obj-code    = 0
     4588                     and buf_recipe.artic       = buf_goods.artic
     4589                     and buf_recipe.prod-type   = buf_goods.prod-type
     4590                     and buf_recipe.prod-code   = buf_goods.prod-code
     4591                     and buf_recipe.recipe-type <> 'альтернатива':U
     4592                         )
     4593               :
     4594                   assign
     4595                       v-recipe-found = yes
     4596                       buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     4597                   .
     4598               end.
     4599               if v-recipe-found = no
     4600               then do:
     4601                   for first buf_recipe no-lock
     4602                       where buf_recipe.obj-type    = p-obj-type
     4603                         and buf_recipe.obj-code    = p-obj-code
     4604                         and buf_recipe.artic       = buf_goods.artic
     4605                         and buf_recipe.prod-type   = buf_goods.prod-type
     4606                         and buf_recipe.prod-code   = buf_goods.prod-code
     4607                         or (
     4608                             buf_recipe.obj-type    = ""
     4609                         and buf_recipe.obj-code    = 0
     4610                         and buf_recipe.artic       = buf_goods.artic
     4611                         and buf_recipe.prod-type   = buf_goods.prod-type
     4612                         and buf_recipe.prod-code   = buf_goods.prod-code
     4613                             )
     4614                   :
     4615                       assign
     4616                           v-recipe-found = yes
     4617                           buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     4618                       .
     4619                   end.
     4620                   if v-recipe-found = no
     4621                   then do:
     4622                       assign
     4623                           buf_fbr-gds-obj.default-recipe-code = ""
     4624                       .
     4625                   end.
     4626               end.
     4627           end.
     4628       end.
     4629   end.
     4630   end procedure.
     4631   procedure fbrlib-get-obj-recipe :
     4632   define input parameter p-obj-type       as character    no-undo.
     4633   define input parameter p-obj-code       as integer      no-undo.
     4634   define input parameter p-gds-code       as integer      no-undo.
     4635   define output parameter p-recipe-code   as character    no-undo.
     4636       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     4637   do
     4638   for buf_fbr-gds-obj
     4639   on error undo, return error
     4640   :
     4641       find first buf_fbr-gds-obj no-lock
     4642            where buf_fbr-gds-obj.obj-type = p-obj-type
     4643              and buf_fbr-gds-obj.obj-code = p-obj-code
     4644              and buf_fbr-gds-obj.gds-code = p-gds-code
     4645       no-error.
     4646       if available buf_fbr-gds-obj
     4647       then do:
     4648           assign
     4649               p-recipe-code = buf_fbr-gds-obj.default-recipe-code
     4650           .
     4651       end.
     4652       else do:
     4653           assign
     4654               p-recipe-code = ""
     4655           .
     4656       end.
     4657   end.
     4658   end procedure.
     4659   procedure fbrlib-create-or-update-recipe-gds :
     4660   define input parameter p-recipe-code    as character        no-undo.
     4661   define input parameter p-gds-code       as integer          no-undo.
     4662   define input parameter p-is-waste       as logical          no-undo.
     4663   define input parameter p-qnty           as decimal          no-undo.
     4664   define input parameter p-proc-number    as integer          no-undo.
     4665   define input parameter p-nws-self       as logical          no-undo.
     4666       define variable v-max-proc-num  as integer      no-undo.
     4667       define variable v-recipe-type   as character    no-undo.
     4668       define buffer buf_goods             for ub.goods.
     4669       define buffer buf_recipe-gds        for ub.recipe-gds.
     4670       define buffer buf_recipe            for ub.recipe.
     4671       define buffer buf_proc_recipe-gds   for ub.recipe-gds.
     4672   do
     4673   for buf_goods
     4674     , buf_recipe-gds
     4675     , buf_recipe
     4676     , buf_proc_recipe-gds
     4677   on error undo, return error
     4678   :
     4679       find first buf_recipe no-lock
     4680            where buf_recipe.recipe-code = p-recipe-code
     4681       .
     4682       find first buf_goods no-lock
     4683            where buf_goods.gds-code = p-gds-code
     4684       .
     4685       find first buf_recipe-gds
     4686            where buf_recipe-gds.recipe-code = p-recipe-code
     4687              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     4688              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     4689              and buf_recipe-gds.artic       = buf_goods.artic
     4690       no-error.
     4691       if not available buf_recipe-gds
     4692       then do:
     4693           create buf_recipe-gds.
     4694           assign
     4695               buf_recipe-gds.recipe-code = p-recipe-code
     4696               buf_recipe-gds.gds-code    = p-gds-code
     4697               buf_recipe-gds.prod-type   = buf_goods.prod-type
     4698               buf_recipe-gds.prod-code   = buf_goods.prod-code
     4699               buf_recipe-gds.artic       = buf_goods.artic
     4700           .
     4701           assign
     4702               buf_recipe-gds.is-waste    = no
     4703               buf_recipe-gds.qnty        = 0
     4704               buf_recipe-gds.coeff-waste = 0
     4705               buf_recipe-gds.brutto-qnty = 0
     4706               buf_recipe-gds.proc-number = 0
     4707               buf_recipe-gds.nws-self    = no
     4708           .
     4709       end.
     4710       assign
     4711           buf_recipe-gds.is-waste    = p-is-waste
     4712       .
     4713       run fbrlib-get-recipe-type in this-procedure (
     4714             input "":U
     4715           , input buf_recipe-gds.recipe-code
     4716           , output v-recipe-type
     4717       ).
     4718       if v-recipe-type <> 'производство':U
     4719       then do:
     4720           assign
     4721               buf_recipe-gds.calc-method = 1
     4722               buf_recipe-gds.qnty        = p-qnty
     4723               buf_recipe-gds.brutto-qnty = p-qnty
     4724               buf_recipe-gds.coeff-waste = 0
     4725           .
     4726       end.
     4727       else do:
     4728           assign
     4729               buf_recipe-gds.calc-method = 1
     4730               buf_recipe-gds.brutto-qnty = p-qnty
     4731           .
     4732           run fbrlib-calc-brutto in this-procedure (
     4733                 input v-recipe-type
     4734               , input 0
     4735               , input 0
     4736               , input buf_recipe-gds.coeff-waste
     4737               , input buf_recipe-gds.brutto-qnty
     4738               , input 1
     4739               , output buf_recipe-gds.qnty
     4740               , output buf_recipe-gds.coeff-waste
     4741               , output buf_recipe-gds.brutto-qnty
     4742               , output buf_recipe-gds.calc-method
     4743           ).
     4744       end.
     4745       assign
     4746           buf_recipe-gds.nws-self    = p-nws-self
     4747       .
     4748       if buf_recipe.recipe-type = 'альтернатива':U
     4749       and buf_recipe-gds.proc-number <> 0
     4750       then do:
     4751       end.
     4752       else do:
     4753           if p-proc-number <> 0
     4754           then do:
     4755               assign
     4756                   buf_recipe-gds.proc-number = p-proc-number
     4757               .
     4758           end.
     4759           else do:
     4760               assign
     4761                   v-max-proc-num = 0
     4762               .
     4763               for each buf_proc_recipe-gds no-lock
     4764                  where buf_proc_recipe-gds.recipe-code = p-recipe-code
     4765               :
     4766                   if recid( buf_proc_recipe-gds ) <> recid( buf_recipe-gds )
     4767                   then do:
     4768                       assign
     4769                           v-max-proc-num = ( if v-max-proc-num < buf_proc_recipe-gds.proc-number then buf_proc_recipe-gds.proc-number else v-max-proc-num )
     4770                       .
     4771                   end.
     4772               end.
     4773               assign
     4774                   buf_recipe-gds.proc-number = v-max-proc-num + 1
     4775               .
     4776           end.
     4777       end.
     4778   end.
     4779   end procedure.
     4780   PROCEDURE fbrlib-create-or-update-recipe :
     4781   define input parameter p-mode               as character    no-undo.
     4782   define input parameter p-obj-type           as character    no-undo.
     4783   define input parameter p-obj-code           as integer      no-undo.
     4784   define input parameter p-recipe-code        as character    no-undo.
     4785   define input parameter p-recipe-type        as character    no-undo.
     4786   define input parameter p-gds-code           as integer      no-undo.
     4787   define input parameter p-name               as character    no-undo.
     4788   define input parameter p-design             as character    no-undo.
     4789   define input parameter p-order              as integer      no-undo.
     4790   define input parameter p-quality            as character    no-undo.
     4791   define input parameter p-ref-num            as character    no-undo.
     4792   define input parameter p-technique          as character    no-undo.
     4793   define input parameter p-template           as character    no-undo.
     4794   define input parameter p-qnty               as decimal      no-undo.
     4795   define input parameter p-portion-qnty       as integer      no-undo.
     4796   define input parameter p-portion-weight     as decimal      no-undo.
     4797   define output parameter p-new-recipe-code   as character    no-undo.
     4798       define variable v-host-code         as integer      no-undo.
     4799       define variable v-fbr-gds-obj-recid as recid        no-undo.
     4800       define buffer buf_recipe    for ub.recipe.
     4801       define buffer buf_goods     for ub.goods.
     4802   do
     4803   for buf_recipe
     4804     , buf_goods
     4805   on error undo, return error
     4806   :
     4807       if p-mode <> 'ДОБАВЛЕНИЕ':U
     4808       and p-mode <> 'ИЗМЕНЕНИЕ':U
     4809       then do:
     4810           message
     4811               skip "Ошибка задания типа операции для создания или измения рецепта."
     4812               skip (1)
     4813               skip "Задан тип операции:" p-mode
     4814           view-as alert-box error.
     4815           undo, return error .
     4816       end.
     4817       if p-recipe-code = ""
     4818       then do:
     4819   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4820   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4821     (input  p-obj-type
     4822     ,input  p-obj-code
     4823     ,output v-host-code
     4824     )  .
     4825           find first buf_goods no-lock
     4826                where buf_goods.gds-code = p-gds-code
     4827           .
     4828           create buf_recipe .
     4829           run fbrcode-gen-recipe-code in this-procedure (
     4830                 input p-obj-type
     4831               , input p-obj-code
     4832               , output buf_recipe.recipe-code
     4833           ).
     4834           assign
     4835               buf_recipe.artic               = buf_goods.artic
     4836               buf_recipe.prod-type           = buf_goods.prod-type
     4837               buf_recipe.prod-code           = buf_goods.prod-code
     4838               buf_recipe.recipe-type         = p-recipe-type
     4839               buf_recipe.recipe-name         = ( if p-name = "" then buf_goods.gds-name else p-name )
     4840               buf_recipe.gds-code            = p-gds-code
     4841               buf_recipe.host-code           = v-host-code
     4842               buf_recipe.obj-type            = p-obj-type
     4843               buf_recipe.obj-code            = p-obj-code
     4844               buf_recipe.recipe-design       = ""
     4845               buf_recipe.recipe-order        = 0
     4846               buf_recipe.recipe-quality      = ""
     4847               buf_recipe.recipe-ref-num      = ""
     4848               buf_recipe.recipe-technique    = ""
     4849               buf_recipe.recipe-template     = ""
     4850               buf_recipe.qnty                = 1.0
     4851               buf_recipe.portion-qnty        = 1
     4852               buf_recipe.portion-weight      = 0
     4853           .
     4854       end.
     4855       if p-name <> ""
     4856       then do:
     4857           assign
     4858               buf_recipe.recipe-name = p-name
     4859           .
     4860       end.
     4861       assign
     4862           buf_recipe.recipe-design       = p-design
     4863           buf_recipe.recipe-order        = p-order
     4864           buf_recipe.recipe-quality      = p-quality
     4865           buf_recipe.recipe-ref-num      = p-ref-num
     4866           buf_recipe.recipe-technique    = p-technique
     4867           buf_recipe.recipe-template     = p-template
     4868           buf_recipe.qnty                = p-qnty
     4869           buf_recipe.portion-qnty        = p-portion-qnty
     4870           buf_recipe.portion-weight      = p-portion-weight
     4871       .
     4872       assign
     4873           p-new-recipe-code = buf_recipe.recipe-code
     4874       .
     4875       run fbrlib-set-default-recipe in this-procedure (
     4876             input p-obj-type
     4877           , input p-obj-code
     4878           , input buf_goods.gds-code
     4879       ).
     4880   end.
     4881   END PROCEDURE.
     4882   PROCEDURE fbrlib-delete-fact-fbr-doc :
     4883   define input parameter parparentproc-handle as widget-handle no-undo .
     4884   define input parameter p-doc-code   as character no-undo.
     4885   define input parameter p-chip-num   like ub.c-trn-doc.chip-num no-undo .
     4886       define variable v-shift-on      as logical      no-undo.
     4887       define variable v-shift-date    as date         no-undo.
     4888       define variable v-shift-num     as integer      no-undo.
     4889       define variable v-shift-name    as character    no-undo.
     4890       define variable v-obj-date      as date         no-undo.
     4891       define variable v-chip-num      as integer      no-undo.
     4892       define buffer buf_fbr-doc       for ub.fbr-doc.
     4893       define buffer buf_fbr-line      for ub.fbr-line.
     4894       define buffer buf_c-fbr-doc     for ub.c-fbr-doc.
     4895       define buffer buf_fbr-recipe     for ub.fbr-recipe.
     4896       define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     4897       define buffer buf_marking-lines for ub.marking-lines .
     4898       define buffer buf_marking       for ub.marking .
     4899       define buffer buf_goods         for ub.goods .
     4900   do
     4901   for buf_fbr-doc
     4902     , buf_fbr-line
     4903     , buf_c-fbr-doc
     4904     , buf_fbr-recipe
     4905     , buf_fbr-recipe-gds
     4906     , buf_goods
     4907     , buf_marking
     4908     , buf_marking-lines
     4909   on error undo, return error
     4910   :
     4911   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4912     define variable v-cntxt-db-num        as integer   no-undo .
     4913     define variable v-cntxt-userid        as character no-undo .
     4914     define variable v-cntxt-level         as character no-undo .
     4915     define variable v-cntxt-host-code-obj as integer   no-undo .
     4916     define variable v-cntxt-obj-type      as character no-undo .
     4917     define variable v-cntxt-obj-code      as integer   no-undo .
     4918     define variable v-cntxt-db-num-obj    as integer   no-undo .
     4919     define variable v-cntxt-is-admin      as logical   no-undo .
     4920   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4921     run mainmenu_getcntxt in parparentproc-handle
     4922       (output v-cntxt-db-num
     4923       ,output v-cntxt-userid
     4924       ,output v-cntxt-level
     4925       ,output v-cntxt-host-code-obj
     4926       ,output v-cntxt-obj-type
     4927       ,output v-cntxt-obj-code
     4928       ,output v-cntxt-db-num-obj
     4929       ,output v-cntxt-is-admin
     4930       ) .
     4931       if search ("delfbr.err") <> ?
     4932       then do:
     4933           os-delete "delfbr.err".
     4934       end.
     4935     _del-block:
     4936       do transaction
     4937     on error undo _del-block, return error return-value
     4938     on endkey undo _del-block , return error return-value
     4939     on stop undo _del-block , return error return-value
     4940       :
     4941           find first buf_fbr-doc exclusive-lock
     4942                where buf_fbr-doc.doc-code = p-doc-code
     4943           no-error.
     4944           if not available buf_fbr-doc
     4945           then do:
     4946         undo _del-block, return error substitute("&1 &2 &3&4Не найден документ производства &5 для удаления."
     4947                                           ,vss-workfile
     4948                                           ,vss-revision
     4949                                           ,vss-description
     4950                                           ,chr(10)
     4951                                           , p-doc-code).
     4952           end.
     4953           run fbrlib-delete-fact-trn-doc in this-procedure (
     4954               input parparentproc-handle
     4955              ,input p-doc-code
     4956              ,input 'при':U
     4957              ,input p-chip-num
     4958              ,output v-chip-num
     4959           ) no-error.
     4960           if error-status :error
     4961           then do:
     4962               run fbrlib-print-del-error-message in this-procedure .
     4963         undo _del-block, return error.
     4964           end.
     4965           assign
     4966           p-chip-num = (if p-chip-num = ?
     4967                         then v-chip-num
     4968                         else p-chip-num).
     4969           run fbrlib-delete-fact-trn-doc in this-procedure (
     4970               input parparentproc-handle
     4971              ,input p-doc-code
     4972              ,input 'рас':U
     4973              ,input p-chip-num
     4974              ,output v-chip-num
     4975           ) no-error.
     4976           if error-status :error
     4977           then do:
     4978               run fbrlib-print-del-error-message in this-procedure .
     4979         undo _del-block, return error.
     4980           end.
     4981           run fbrlib-delete-fact-trn-doc in this-procedure (
     4982               input parparentproc-handle
     4983              ,input p-doc-code
     4984              ,input 'спи':U
     4985              ,input p-chip-num
     4986              ,output v-chip-num
     4987           ) no-error.
     4988           if error-status :error
     4989           then do:
     4990               run fbrlib-print-del-error-message in this-procedure .
     4991         undo _del-block, return error.
     4992           end.
     4993           create buf_c-fbr-doc.
     4994           buffer-copy buf_fbr-doc to buf_c-fbr-doc.
     4995   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4996   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     4997     (input  buf_fbr-doc.obj-type
     4998     ,input  buf_fbr-doc.obj-code
     4999     ,output v-obj-date
     5000     ) no-error .
     5001           if error-status :error
     5002           or v-obj-date = ?
     5003           then do:
     5004         undo _del-block, return error "Нет текущей даты на объекте документа.".
     5005           end.
     5006   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5007   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     5008     (input  buf_fbr-doc.obj-type
     5009     ,input  buf_fbr-doc.obj-code
     5010     ,input  'shift-on=request'
     5011     ,output v-shift-on
     5012     )  .
     5013           if v-shift-on
     5014           then do:
     5015   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5016   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     5017     (input  buf_fbr-doc.obj-type
     5018     ,input  buf_fbr-doc.obj-code
     5019     ,output v-shift-date
     5020     ,output v-shift-num
     5021     ,output v-shift-name
     5022     ) no-error .
     5023               if error-status :error
     5024               then do:
     5025           undo _del-block, return error "Ошибка при поиске текущей смены на объекте".
     5026               end.
     5027           end.
     5028           else do:
     5029               assign
     5030                   v-shift-date = ?
     5031                   v-shift-num  = ?
     5032                   v-shift-name = ?
     5033               .
     5034           end.
     5035           define variable v-today       as date         no-undo.
     5036           define variable v-time        as integer      no-undo.
     5037           run cur-time in this-procedure (
     5038                 output v-today
     5039               , output v-time
     5040           ).
     5041           assign
     5042               buf_c-fbr-doc.chip-num         = (if p-chip-num <> ? then p-chip-num else next-value( s-corr-chip, ub  ))
     5043               buf_c-fbr-doc.corr-user-name   = v-cntxt-userid
     5044               buf_c-fbr-doc.corr-user-db-num = v-cntxt-db-num
     5045               buf_c-fbr-doc.corr-date        = v-today
     5046               buf_c-fbr-doc.corr-time        = v-time
     5047               buf_c-fbr-doc.corr-shift-date  = v-shift-date
     5048               buf_c-fbr-doc.corr-shift-num   = v-shift-num
     5049               buf_c-fbr-doc.corr-shift-name  = v-shift-name
     5050               buf_c-fbr-doc.is-del           = yes
     5051           .
     5052           assign
     5053               buf_fbr-doc.is-del = yes
     5054           .
     5055           for each buf_fbr-line exclusive-lock
     5056              where buf_fbr-line.doc-code = p-doc-code
     5057       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5058       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     5059       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     5060           :
     5061               for first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     5062                                             and buf_goods.prod-type  = buf_fbr-line.prod-type
     5063                                             and buf_goods.prod-code  = buf_fbr-line.prod-code,
     5064               each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     5065                                                       and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     5066                                                       and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     5067                                                       and buf_marking-lines.in-code  = "manufacturing"
     5068                                                       and buf_marking-lines.out-code = buf_fbr-line.doc-code
     5069                                                       and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     5070                                                       and buf_marking-lines.prt-code = 0
     5071               :
     5072                 for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
     5073                   assign
     5074                     buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_fbr-line.is-comp
     5075                   .
     5076                 end .
     5077                 delete buf_marking-lines.
     5078               end .
     5079               delete buf_fbr-line.
     5080           end.
     5081           for each buf_fbr-recipe exclusive-lock
     5082              where buf_fbr-recipe.doc-code = p-doc-code
     5083       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5084       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     5085       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     5086           :
     5087               delete buf_fbr-recipe.
     5088           end.
     5089           for each buf_fbr-recipe-gds exclusive-lock
     5090              where buf_fbr-recipe-gds.doc-code = p-doc-code
     5091       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5092       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     5093       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     5094           :
     5095               delete buf_fbr-recipe-gds.
     5096           end.
     5097           delete buf_fbr-doc.
     5098       end.
     5099   end.
     5100   END PROCEDURE.
     5101   PROCEDURE fbrlib-del-trn-doc :
     5102   do
     5103   on error undo, return error
     5104   :
     5105   define input parameter parparentproc        as widget-handle no-undo .
     5106   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     5107   define input parameter p-trn-doc-type       as character    no-undo.
     5108   define input parameter p-phchip-num         like ub.c-trn-doc.chip-num no-undo .
     5109   define output parameter p-chip-num           like ub.c-trn-doc.chip-num no-undo .
     5110       define variable v-trn-doc-doc-code  as character     no-undo.
     5111       define buffer buf_trn-doc       for ub.trn-doc.
     5112   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5113     define variable v-cntxt-db-num        as integer   no-undo .
     5114     define variable v-cntxt-userid        as character no-undo .
     5115     define variable v-cntxt-level         as character no-undo .
     5116     define variable v-cntxt-host-code-obj as integer   no-undo .
     5117     define variable v-cntxt-obj-type      as character no-undo .
     5118     define variable v-cntxt-obj-code      as integer   no-undo .
     5119     define variable v-cntxt-db-num-obj    as integer   no-undo .
     5120     define variable v-cntxt-is-admin      as logical   no-undo .
     5121   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5122     run mainmenu_getcntxt in parparentproc
     5123       (output v-cntxt-db-num
     5124       ,output v-cntxt-userid
     5125       ,output v-cntxt-level
     5126       ,output v-cntxt-host-code-obj
     5127       ,output v-cntxt-obj-type
     5128       ,output v-cntxt-obj-code
     5129       ,output v-cntxt-db-num-obj
     5130       ,output v-cntxt-is-admin
     5131       ) .
     5132       run fbrcode-trn-doc in this-procedure (
     5133             input 'производство':U
     5134           , input p-fbr-doc-doc-code
     5135           , input p-trn-doc-type
     5136           , output v-trn-doc-doc-code
     5137       ).
     5138       find first buf_trn-doc no-lock
     5139            where buf_trn-doc.doc-code = v-trn-doc-doc-code
     5140       no-error.
     5141       if available buf_trn-doc
     5142       then do:
     5143           run str/del-doc.p (
     5144                 input parparentproc
     5145               , input buf_trn-doc.doc-code
     5146               , input v-cntxt-db-num
     5147               , input "del-doc.err"
     5148               , input ?
     5149               , input p-fbr-doc-doc-code
     5150               , input v-cntxt-userid
     5151               , input 0
     5152               , input p-phchip-num
     5153               , output p-chip-num
     5154           ) no-error.
     5155           if error-status :error
     5156           then do:
     5157             undo, return error substitute("Не удалось удалить складской документ &1, созданный по документу производства &2.&3&4&3&5"
     5158                                           ,v-trn-doc-doc-code
     5159                                           ,p-fbr-doc-doc-code
     5160                                           , chr(10)
     5161                                           , error-status:get-message(1)
     5162                                           , return-value ).
     5163           end.
     5164       end.
     5165   end.
     5166   END PROCEDURE.
     5167   PROCEDURE fbrlib-delete-fact-trn-doc :
     5168   define input parameter parparentproc    as widget-handle    no-undo.
     5169   define input parameter p-fbr-doc-code   as character        no-undo.
     5170   define input parameter p-doc-type       as character    no-undo.
     5171   define input parameter p-ph-chip-num       like ub.c-trn-doc.chip-num no-undo .
     5172   define output parameter p-chip-num      like ub.c-trn-doc.chip-num no-undo .
     5173       define variable v-doc-code          as character        no-undo.
     5174       define variable v-ext-doc-type      as character        no-undo.
     5175       define variable v-trn-doc-recid     as recid            no-undo.
     5176       define variable varchip-code        as integer          no-undo.
     5177       define variable varchip-code2       as integer          no-undo.
     5178       define variable v-chip-counter      as integer          no-undo.
     5179       define buffer buf_trn-doc       for ub.trn-doc.
     5180       define buffer buf_pri_trn-doc   for ub.trn-doc.
     5181       define buffer buf_cons_trn-doc  for ub.trn-doc.
     5182   do
     5183   for buf_trn-doc
     5184     , buf_pri_trn-doc
     5185     , buf_cons_trn-doc
     5186   on error undo, return error
     5187   :
     5188   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5189     define variable v-cntxt-db-num        as integer   no-undo .
     5190     define variable v-cntxt-userid        as character no-undo .
     5191     define variable v-cntxt-level         as character no-undo .
     5192     define variable v-cntxt-host-code-obj as integer   no-undo .
     5193     define variable v-cntxt-obj-type      as character no-undo .
     5194     define variable v-cntxt-obj-code      as integer   no-undo .
     5195     define variable v-cntxt-db-num-obj    as integer   no-undo .
     5196     define variable v-cntxt-is-admin      as logical   no-undo .
     5197   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5198     run mainmenu_getcntxt in parparentproc
     5199       (output v-cntxt-db-num
     5200       ,output v-cntxt-userid
     5201       ,output v-cntxt-level
     5202       ,output v-cntxt-host-code-obj
     5203       ,output v-cntxt-obj-type
     5204       ,output v-cntxt-obj-code
     5205       ,output v-cntxt-db-num-obj
     5206       ,output v-cntxt-is-admin
     5207       ) .
     5208       run fbrcode-trn-doc in this-procedure (
     5209             input 'производство':U
     5210           , input p-fbr-doc-code
     5211           , input p-doc-type
     5212           , output v-doc-code
     5213       ).
     5214       find first buf_trn-doc no-lock
     5215            where buf_trn-doc.doc-code = v-doc-code
     5216       no-error.
     5217       if not available buf_trn-doc
     5218       then do:
     5219           if p-doc-type <> 'спи':U
     5220           then do:
     5221               message
     5222                   "Не найден документ '" p-doc-type "'"
     5223                   "по документу производства " p-fbr-doc-code
     5224               view-as alert-box.
     5225               undo, return error.
     5226           end.
     5227           else do:
     5228           end.
     5229       end.
     5230       else do:
     5231           assign
     5232               v-trn-doc-recid = recid( buf_trn-doc )
     5233               v-ext-doc-type  = buf_trn-doc.ext-doc-type
     5234           .
     5235           if v-ext-doc-type = 'ev':U
     5236           then do:
     5237               find first buf_pri_trn-doc no-lock
     5238                    where buf_pri_trn-doc.out-code     = v-doc-code
     5239                      and buf_pri_trn-doc.ext-doc-type = 'iv':U
     5240               no-error.
     5241               if available buf_pri_trn-doc
     5242               then do:
     5243                   run str/del-doc.p (
     5244                         input parparentproc
     5245                       , input buf_pri_trn-doc.doc-code
     5246                       , input v-cntxt-db-num
     5247                       , input "delfbr.err"
     5248                       , input ?
     5249                       , input p-fbr-doc-code
     5250                       , input v-cntxt-userid
     5251                       , input 0
     5252                       , input (if p-ph-chip-num <> ?
     5253                               then p-ph-chip-num
     5254                               else (if varchip-code <> 0
     5255                                   then varchip-code
     5256                                   else ?)
     5257                               )
     5258                       , output varchip-code2
     5259                   ) no-error.
     5260                   if error-status :error
     5261                   then do:
     5262                     undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     5263                                                   ,buf_pri_trn-doc.doc-code
     5264                                                   ,p-fbr-doc-code
     5265                                                   , chr(10)
     5266                                                   , error-status:get-message(1)
     5267                                                   , return-value ).
     5268                   end.
     5269               end.
     5270           end.
     5271           define buffer buf_out_trn-doc       for ub.trn-doc.
     5272           if p-doc-type = 'при':U
     5273           then do:
     5274               assign
     5275                   v-chip-counter = 0
     5276               .
     5277               for each buf_out_trn-doc exclusive-lock
     5278                  where buf_out_trn-doc.out-code = buf_trn-doc.doc-code
     5279               on error undo, return error
     5280               :
     5281                   assign
     5282                       v-chip-counter = v-chip-counter + 1
     5283                   .
     5284                   if v-chip-counter > 1
     5285                   then do:
     5286                       assign
     5287                           varchip-code = varchip-code2
     5288                       .
     5289                   end.
     5290                   run str/del-doc.p (
     5291                         input parparentproc
     5292                       , input buf_out_trn-doc.doc-code
     5293                       , input v-cntxt-db-num
     5294                       , input "delfbr.err"
     5295                       , input ?
     5296                       , input p-fbr-doc-code
     5297                       , input v-cntxt-userid
     5298                       , input 0
     5299                       , input (if p-ph-chip-num <> ?
     5300                               then p-ph-chip-num
     5301                               else (if varchip-code <> 0
     5302                                   then varchip-code
     5303                                   else ?)
     5304                               )
     5305                       , output varchip-code2
     5306                   ) no-error.
     5307                   if error-status :error
     5308                   then do:
     5309                     undo, return error substitute("Ошибка при удалении складского документа &1, связанного со складским документов прихода &2, созданный по документу производства &3.&4&5&4&6"
     5310                                                   ,buf_out_trn-doc.doc-code
     5311                                                   ,buf_trn-doc.doc-code
     5312                                                   ,p-fbr-doc-code
     5313                                                   , chr(10)
     5314                                                   , error-status:get-message(1)
     5315                                                   , return-value ).
     5316                   end.
     5317               end.
     5318           end.
     5319           run str/del-doc.p (
     5320                 input parparentproc
     5321               , input buf_trn-doc.doc-code
     5322               , input v-cntxt-db-num
     5323               , input "delfbr.err"
     5324               , input ?
     5325               , input p-fbr-doc-code
     5326               , input v-cntxt-userid
     5327               , input 0
     5328               , input (if p-ph-chip-num <> ?
     5329                        then p-ph-chip-num
     5330                        else (if varchip-code <> 0
     5331                              then varchip-code
     5332                              else ?)
     5333                        )
     5334               , output varchip-code2
     5335           ) no-error.
     5336           if error-status :error
     5337           then do:
     5338               undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     5339                                             ,buf_trn-doc.doc-code
     5340                                             ,p-fbr-doc-code
     5341                                             , chr(10)
     5342                                             , error-status:get-message(1)
     5343                                             , return-value ).
     5344           end.
     5345           if p-doc-type = 'рас':U
     5346           or p-doc-type = 'спи':U
     5347           then do:
     5348               assign
     5349                   v-chip-counter = 0
     5350               .
     5351               for each buf_cons_trn-doc no-lock
     5352                  where buf_cons_trn-doc.out-code      = v-doc-code
     5353                    and buf_cons_trn-doc.ext-doc-type  = 'pc':U
     5354               :
     5355                   assign
     5356                       v-trn-doc-recid = recid( buf_cons_trn-doc )
     5357                       v-chip-counter = v-chip-counter + 1
     5358                   .
     5359                   assign
     5360                   varchip-code = if v-chip-counter = 2
     5361                                  then varchip-code2
     5362                                  else varchip-code.
     5363                   run str/del-doc.p (
     5364                         input parparentproc
     5365                       , input buf_cons_trn-doc.doc-code
     5366                       , input v-cntxt-db-num
     5367                       , input "delfbr.err"
     5368                       , input ?
     5369                       , input ?
     5370                       , input v-cntxt-userid
     5371                       , input 0
     5372                       , input (if p-ph-chip-num <> ?
     5373                                then p-ph-chip-num
     5374                                else ( if v-chip-counter = 1
     5375                                       then ?
     5376                                       else varchip-code )
     5377                                )
     5378                       , output varchip-code2
     5379                   ) no-error.
     5380                   if error-status :error
     5381                   then do:
     5382                       undo, return error substitute("Ошибка при удалении складского документа смены типа приобретения &1, созданный по документу производства &2.&3&4&3&5"
     5383                                                     ,buf_cons_trn-doc.doc-code
     5384                                                     ,p-fbr-doc-code
     5385                                                     , chr(10)
     5386                                                     , error-status:get-message(1)
     5387                                                     , return-value ).
     5388                   end.
     5389                   assign
     5390                       p-chip-num = varchip-code2
     5391                   .
     5392               end.
     5393           end.
     5394           assign
     5395               p-chip-num = varchip-code2
     5396           .
     5397       end.
     5398   end.
     5399   END PROCEDURE.
     5400   PROCEDURE fbrlib-print-del-error-message :
     5401   do
     5402   on error undo, return error
     5403   :
     5404       define variable v-user-action   as character    no-undo.
     5405       define variable v-printed       as logical      no-undo.
     5406       message
     5407           vss-workfile vss-revision vss-description
     5408           skip "Ошибка при удалении документа."
     5409           skip return-value
     5410           skip trim(error-status :get-message(1))
     5411           skip trim(error-status :get-message(2))
     5412           skip trim(error-status :get-message(3))
     5413       view-as alert-box error.
     5414       if search ("delfbr.err") <> ?
     5415       then do:
     5416         run gbl/prnfilen.w
     5417           (input  "Ошибки при удалении документа производства"
     5418           ,input  0
     5419           ,input  "delfbr.err"
     5420           ,input  7
     5421           ,output v-user-action
     5422           ,output v-printed
     5423           ).
     5424       end.
     5425   end.
     5426   END PROCEDURE.
     5427   procedure fbrlib-calc-brutto :
     5428   define input parameter p-recipe-type        as character        no-undo.
     5429   define input parameter p-netto              as decimal          no-undo.
     5430   define input parameter p-coeff-value        as decimal          no-undo.
     5431   define input parameter p-coeff-waste        as decimal          no-undo.
     5432   define input parameter p-brutto             as decimal          no-undo.
     5433   define input parameter p-calc-method        as integer          no-undo.
     5434   define output parameter p-new-netto         as decimal          no-undo.
     5435   define output parameter p-new-coeff-waste   as decimal          no-undo.
     5436   define output parameter p-new-brutto        as decimal          no-undo.
     5437   define output parameter p-new-calc-method   as integer          no-undo.
     5438   do
     5439   on error undo, return error
     5440   :
     5441       if p-recipe-type <> 'производство':U
     5442       then do:
     5443           assign
     5444               p-new-coeff-waste = 0
     5445               p-new-calc-method = 1
     5446               p-new-netto       = ( if p-calc-method = 1 then p-brutto else p-netto )
     5447               p-new-brutto      = ( if p-calc-method = 1 then p-brutto else p-netto )
     5448           .
     5449       end.
     5450       else do:
     5451           assign
     5452               p-new-calc-method = p-calc-method
     5453           .
     5454           if p-coeff-waste = 0
     5455           then do:
     5456               assign
     5457                   p-coeff-value = 0
     5458               .
     5459           end.
     5460           case p-calc-method
     5461           :
     5462               when 1
     5463               then do:
     5464                   assign
     5465                       p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     5466                       p-new-coeff-waste   = p-coeff-waste
     5467                       p-new-brutto        = p-brutto
     5468                   .
     5469               end.
     5470               when 2
     5471               then do:
     5472                   assign
     5473                       p-new-netto         = p-netto
     5474                       p-new-coeff-waste   = 100 - p-coeff-value - ( 100 * p-netto / p-brutto )
     5475                       p-new-brutto        = p-brutto
     5476                   .
     5477               end.
     5478               when 3
     5479               then do:
     5480                   assign
     5481                       p-new-netto         = p-netto
     5482                       p-new-coeff-waste   = p-coeff-waste
     5483                       p-new-brutto        = 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste )
     5484                   .
     5485               end.
     5486               otherwise do:
     5487                   define variable v-yesno    as logical      no-undo.
     5488                   assign
     5489                       v-yesno = yes
     5490                   .
     5491                   message
     5492                       "Неверный метод для расчета брутто, нетто и процента потерь."
     5493                       skip "Значение метода должно быть 1, 2 или 3."
     5494                       skip(1)
     5495                       skip "Заданное значение:" p-calc-method
     5496                       skip(1)
     5497                       skip "Установить значение метода расчета 1"
     5498                       skip "(расчет нетто по брутто и проценту потерь)?"
     5499                   view-as alert-box warning
     5500                   buttons yes-no
     5501                   title "Неверное значение метода пересчета в строках документа-производства"
     5502                   update v-yesno
     5503                   .
     5504                   if v-yesno = yes
     5505                   then do:
     5506                       assign
     5507                           p-new-calc-method   = 1
     5508                           p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     5509                           p-new-coeff-waste   = p-coeff-waste
     5510                           p-new-brutto        = p-brutto
     5511                       .
     5512                   end.
     5513                   else do:
     5514                       message
     5515                               vss-workfile vss-revision vss-description
     5516                           skip(1)
     5517                           skip "Ошибка расчета брутто, нетто и процента потерь."
     5518                           skip return-value
     5519                           skip trim(error-status :get-message(1))
     5520                               trim(error-status :get-message(2))
     5521                               trim(error-status :get-message(3))
     5522                       view-as alert-box error
     5523                       title "Неверное значение метода расчета"
     5524                       .
     5525                       undo, return error .
     5526                   end.
     5527               end.
     5528           end case.
     5529       end.
     5530   end.
     5531   end procedure.
     5532   procedure fbrlib-check-brutto :
     5533   define input parameter p-recipe-type        as character        no-undo.
     5534   define input parameter p-netto              as decimal          no-undo.
     5535   define input parameter p-coeff-value        as decimal          no-undo.
     5536   define input parameter p-coeff-waste        as decimal          no-undo.
     5537   define input parameter p-brutto             as decimal          no-undo.
     5538   define input parameter p-calc-method        as integer          no-undo.
     5539   define output parameter p-error-message     as character        no-undo.
     5540   define output parameter p-not-good          as logical          no-undo.
     5541   do
     5542   on error undo, return error
     5543   :
     5544       if p-recipe-type <> 'производство':U
     5545       then do:
     5546           if p-netto <> p-brutto
     5547           or p-coeff-waste <> 0
     5548           then do:
     5549               assign
     5550                   p-not-good      = yes
     5551                   p-error-message = substitute( "Во всех рецептах кроме рецепта производства должно выполняться:&1брутто = нетто и процент потерь = 0.&1&1Тип рецепта: &2&1Брутто: &3&1Нетто: &4&1Процент потерь: &5"
     5552                                           , chr(10), p-recipe-type, p-brutto, p-netto, p-coeff-waste )
     5553               .
     5554           end.
     5555       end.
     5556       else do:
     5557           if p-coeff-waste = 0
     5558           then do:
     5559               assign
     5560                   p-coeff-value = 0
     5561               .
     5562           end.
     5563           case p-calc-method
     5564           :
     5565               when 1
     5566               then do:
     5567                   if round( p-netto, 9 ) <> round( p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100, 9 )
     5568                   then do:
     5569                       assign
     5570                           p-not-good      = yes
     5571                           p-error-message = substitute( "Ошибка расчета нетто ( &2 ) &1 по брутто ( &3 ) &1 и процентам потерь ( &4, &5 )."
     5572                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     5573                       .
     5574                   end.
     5575               end.
     5576               when 2
     5577               then do:
     5578                   if round( p-coeff-waste, 9 ) <> round( 100 - p-coeff-value - ( 100 * p-netto / p-brutto ), 9 )
     5579                   then do:
     5580                       assign
     5581                           p-not-good      = yes
     5582                           p-error-message =  substitute( "Ошибка расчета процента потерь ( &2 ) &1 по нетто ( &3 ) &1 брутто ( &4 ) &1 и cезонному проценту ( &5 )."
     5583                                                   , chr(10), p-coeff-waste, p-netto, p-brutto, p-coeff-value )
     5584                       .
     5585                   end.
     5586               end.
     5587               when 3
     5588               then do:
     5589                   if round( p-brutto, 9 ) <> round( 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste ), 9 )
     5590                   then do:
     5591                       assign
     5592                           p-not-good      = yes
     5593                           p-error-message = substitute( "Ошибка расчета брутто ( &3 ) &1 по нетто ( &2 ) &1 и процентам потерь ( &4, &5 )."
     5594                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     5595                       .
     5596                   end.
     5597               end.
     5598               otherwise do:
     5599                   assign
     5600                       p-not-good      = yes
     5601                       p-error-message = substitute( "Ошибка ввода метода расчета ( &1 ).", p-calc-method )
     5602                   .
     5603               end.
     5604           end case.
     5605       end.
     5606   end.
     5607   end procedure.
     5608   procedure fbrlib-check-fbr-recipe :
     5609   define input parameter p-doc-code       as character        no-undo.
     5610   define input parameter p-recipe-code    as character        no-undo.
     5611   define output parameter p-is-correct    as logical          no-undo.
     5612       define variable v-comp-factor    as decimal      no-undo.
     5613       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     5614       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     5615       define buffer buf_fbr-line          for ub.fbr-line.
     5616   do
     5617   for buf_fbr-recipe
     5618     , buf_fbr-recipe-gds
     5619     , buf_fbr-line
     5620   on error undo, return error
     5621   :
     5622       assign
     5623           p-is-correct = yes
     5624       .
     5625       find first buf_fbr-recipe no-lock
     5626            where buf_fbr-recipe.doc-code    = p-doc-code
     5627              and buf_fbr-recipe.recipe-code = p-recipe-code no-error
     5628       .
     5629       if not available buf_fbr-recipe then do:
     5630         undo, return error substitute("Не найден рецепт (fbr-recipe) с кодом &1 для  документа пр-ва &2", p-recipe-code, p-doc-code).
     5631       end.
     5632       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     5633       then do:
     5634       end.
     5635       else do:
     5636           find first buf_fbr-line no-lock
     5637                where buf_fbr-line.doc-code    = buf_fbr-recipe.doc-code
     5638                  and buf_fbr-line.is-comp     = yes
     5639                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     5640                  and buf_fbr-line.artic       = buf_fbr-recipe.artic
     5641                  and buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
     5642                  and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
     5643           .
     5644           assign
     5645               v-comp-factor = buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty
     5646           .
     5647           recipe-line-cycle:
     5648           for each buf_fbr-recipe-gds no-lock
     5649              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     5650                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     5651           on error undo, return error
     5652           :
     5653               find first buf_fbr-line no-lock
     5654                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     5655                      and buf_fbr-line.is-comp     = no
     5656                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     5657                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     5658                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     5659                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     5660               .
     5661               if absolute( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty - v-comp-factor ) > 0.000000001
     5662               then do:
     5663                   assign
     5664                       p-is-correct = no
     5665                   .
     5666                   leave recipe-line-cycle.
     5667               end.
     5668           end.
     5669       end.
     5670   end.
     5671   end procedure.
     5672   procedure fbrlib-get-recipe-type :
     5673   define input parameter p-fbr-doc-code   as character        no-undo.
     5674   define input parameter p-recipe-code    as character        no-undo.
     5675   define output parameter p-recipe-type   as character        no-undo.
     5676       define buffer buf_recipe        for ub.recipe.
     5677       define buffer buf_fbr-recipe    for ub.fbr-recipe.
     5678   do
     5679   for buf_recipe
     5680     , buf_fbr-recipe
     5681   on error undo, return error
     5682   :
     5683       if p-fbr-doc-code = ""
     5684       then do:
     5685           find first buf_recipe no-lock
     5686                where buf_recipe.recipe-code = p-recipe-code
     5687           no-error.
     5688           if available buf_recipe
     5689           then do:
     5690               assign
     5691                   p-recipe-type = buf_recipe.recipe-type
     5692               .
     5693           end.
     5694           else do:
     5695               assign
     5696                   p-recipe-type = "":U
     5697               .
     5698           end.
     5699       end.
     5700       else do:
     5701           find first buf_fbr-recipe no-lock
     5702                where buf_fbr-recipe.doc-code      = p-fbr-doc-code
     5703                  and buf_fbr-recipe.recipe-code   = p-recipe-code
     5704           no-error.
     5705           if available buf_fbr-recipe
     5706           then do:
     5707               assign
     5708                   p-recipe-type = buf_fbr-recipe.recipe-type
     5709               .
     5710           end.
     5711           else do:
     5712               assign
     5713                   p-recipe-type = "":U
     5714               .
     5715           end.
     5716       end.
     5717   end.
     5718   end procedure.
     5719   PROCEDURE calc-comp-from-ingr :
     5720   define input parameter p-fbr-v-fbr-doc-line-recid           as recid        no-undo.
     5721   define input parameter p-fact-qnty                          as decimal      no-undo.
     5722   define output parameter p-comp-fbr-v-fbr-doc-line-recid     as recid        no-undo.
     5723   define output parameter p-comp-qnty                         as decimal      no-undo.
     5724       define variable v-ingr-qnty     as decimal       no-undo.
     5725       define buffer buf_i_fbr-line    for ub.fbr-line.
     5726       define buffer buf_fbr-line      for ub.fbr-line.
     5727       define buffer buf_recipe        for ub.fbr-recipe.
     5728       define buffer buf_recipe-gds    for ub.fbr-recipe-gds.
     5729   do
     5730   for buf_i_fbr-line
     5731     , buf_fbr-line
     5732     , buf_recipe
     5733     , buf_recipe-gds
     5734   on error undo, return error
     5735   :
     5736       find first buf_i_fbr-line no-lock
     5737            where recid( buf_i_fbr-line ) = p-fbr-v-fbr-doc-line-recid
     5738       .
     5739       find first buf_recipe no-lock
     5740            where buf_recipe.doc-code      = buf_i_fbr-line.doc-code
     5741              and buf_recipe.recipe-code   = buf_i_fbr-line.recipe-code
     5742       no-error.
     5743       if not available buf_recipe
     5744       then do:
     5745           message
     5746                   vss-workfile vss-revision vss-description
     5747               skip "В строке производства не указан рецепт."
     5748               skip "Невозможно рассчитать количество составного товара."
     5749               skip return-value
     5750               skip trim(error-status :get-message(1))
     5751                   trim(error-status :get-message(2))
     5752                   trim(error-status :get-message(3))
     5753           view-as alert-box error.
     5754           undo, return error .
     5755       end.
     5756       if buf_recipe.recipe-type = 'альтернатива':U
     5757       then do:
     5758           for each buf_fbr-line no-lock
     5759              where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     5760                and buf_fbr-line.trn-type    = buf_i_fbr-line.trn-type
     5761                and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     5762           on error undo, return error
     5763           :
     5764               find first buf_recipe-gds no-lock
     5765                    where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     5766                      and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     5767                      and buf_recipe-gds.artic       = buf_fbr-line.artic
     5768                      and buf_recipe-gds.prod-type   = buf_fbr-line.prod-type
     5769                      and buf_recipe-gds.prod-code   = buf_fbr-line.prod-code
     5770               .
     5771               assign
     5772                   p-comp-qnty         = p-comp-qnty       + ( buf_fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty )
     5773               .
     5774           end.
     5775           assign
     5776               p-comp-qnty         = p-comp-qnty       / buf_recipe.qnty
     5777           .
     5778       end.
     5779       else do:
     5780           find first buf_recipe-gds no-lock
     5781                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     5782                  and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     5783                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     5784                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     5785                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     5786           .
     5787           assign
     5788               p-comp-qnty = p-fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     5789           .
     5790       end.
     5791       find first buf_fbr-line no-lock
     5792            where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     5793              and buf_fbr-line.is-comp     = yes
     5794              and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     5795       .
     5796       assign
     5797           p-comp-fbr-v-fbr-doc-line-recid = recid( buf_fbr-line )
     5798       .
     5799   end.
     5800   END PROCEDURE.
     5801   PROCEDURE get-temp_dressing-ingr-used-qnty :
     5802   define input parameter p-recipe-code    as character    no-undo.
     5803   define input parameter p-gds-code       as integer      no-undo.
     5804   define output parameter p-line-qnty     as decimal      no-undo.
     5805   define output parameter p-used-qnty     as decimal      no-undo.
     5806   define output parameter p-recipe-qnty   as decimal      no-undo.
     5807       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     5808   do
     5809   for buf_temp_dressing-ingr
     5810   on error undo, return error
     5811   :
     5812       find first buf_temp_dressing-ingr no-lock
     5813            where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     5814              and buf_temp_dressing-ingr.gds-code    = p-gds-code
     5815       no-error.
     5816       if available buf_temp_dressing-ingr
     5817       then do:
     5818           assign
     5819               p-line-qnty     = buf_temp_dressing-ingr.line-qnty
     5820               p-used-qnty     = buf_temp_dressing-ingr.used-qnty
     5821               p-recipe-qnty   = buf_temp_dressing-ingr.recipe-qnty
     5822           .
     5823       end.
     5824       else do:
     5825           assign
     5826               p-line-qnty     = 0
     5827               p-used-qnty     = 0
     5828               p-recipe-qnty   = 0
     5829           .
     5830       end.
     5831   end.
     5832   END PROCEDURE.
     5833   PROCEDURE fbrlib_adjust-recipe :
     5834   do
     5835   on error undo, return error
     5836   :
     5837   define input parameter parparentproc as widget-handle no-undo .
     5838   define input parameter p-fbrhist-handle as handle no-undo .
     5839   define input parameter p-doc-code       as character    no-undo.
     5840   define input parameter p-recipe-code    as character    no-undo.
     5841   define input parameter p-price-sale-obj-type as character no-undo .
     5842   define input parameter p-price-sale-obj-code as integer no-undo .
     5843       define variable v-recipe-qnty       as decimal      no-undo.
     5844       define variable v-comp-qnty         as decimal      no-undo.
     5845       define variable v-recipe-gds-qnty   as decimal      no-undo.
     5846       define variable v-ingr-qnty         as decimal      no-undo.
     5847       define variable v-qnty              as decimal      no-undo.
     5848       define variable v-coeff-waste       as decimal      no-undo.
     5849       define variable v-brutto-qnty       as decimal      no-undo.
     5850       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     5851       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     5852       define buffer buf_fbr-line          for ub.fbr-line.
     5853       define buffer buf_el_fbr-recipe-gds for ub.fbr-recipe-gds.
     5854       find first buf_fbr-recipe no-lock
     5855            where buf_fbr-recipe.doc-code      = p-doc-code
     5856              and buf_fbr-recipe.recipe-code   = p-recipe-code
     5857       .
     5858       assign
     5859           v-recipe-qnty = buf_fbr-recipe.qnty
     5860       .
     5861       find first buf_fbr-line no-lock
     5862            where buf_fbr-line.doc-code    = p-doc-code
     5863              and buf_fbr-line.is-comp     = yes
     5864              and buf_fbr-line.recipe-code = p-recipe-code
     5865       .
     5866       assign
     5867           v-comp-qnty = buf_fbr-line.fact-qnty
     5868       .
     5869       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     5870       then do:
     5871       end.
     5872       else do:
     5873           for each buf_fbr-recipe-gds no-lock
     5874              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     5875                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     5876           on error undo, return error
     5877           :
     5878               find first buf_fbr-line no-lock
     5879                    where buf_fbr-line.doc-code    = p-doc-code
     5880                      and buf_fbr-line.is-comp     = no
     5881                      and buf_fbr-line.recipe-code = p-recipe-code
     5882                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     5883                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     5884                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     5885               .
     5886               if buf_fbr-line.fact-qnty / v-comp-qnty <> buf_fbr-recipe-gds.brutto-qnty / v-recipe-qnty
     5887               then do:
     5888                   do transaction
     5889                   on error undo, return error
     5890                   :
     5891                       find first buf_el_fbr-recipe-gds exclusive-lock
     5892                            where recid( buf_el_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
     5893                       .
     5894                       assign
     5895                           buf_el_fbr-recipe-gds.calc-method   = 1
     5896                           buf_el_fbr-recipe-gds.brutto-qnty   = buf_fbr-line.fact-qnty * v-recipe-qnty / v-comp-qnty
     5897                       .
     5898                       run fbrlib-calc-brutto in this-procedure (
     5899                             input buf_fbr-recipe.recipe-type
     5900                           , input 0
     5901                           , input buf_el_fbr-recipe-gds.coeff-value
     5902                           , input buf_el_fbr-recipe-gds.coeff-waste
     5903                           , input buf_el_fbr-recipe-gds.brutto-qnty
     5904                           , input 1
     5905                           , output buf_el_fbr-recipe-gds.qnty
     5906                           , output buf_el_fbr-recipe-gds.coeff-waste
     5907                           , output buf_el_fbr-recipe-gds.brutto-qnty
     5908                           , output buf_el_fbr-recipe-gds.calc-method
     5909                       ).
     5910                   end.
     5911               end.
     5912           end.
     5913           run fbrlib_adjust-doc-lines in this-procedure (
     5914                 input parparentproc
     5915               , input p-fbrhist-handle
     5916               , input p-doc-code
     5917               , input p-recipe-code
     5918               , input p-price-sale-obj-type
     5919               , input p-price-sale-obj-code
     5920           ).
     5921       end.
     5922   end.
     5923   END PROCEDURE.
     5924   PROCEDURE fbrlib_adjust-doc-lines :
     5925   define input parameter parparentproc as widget-handle no-undo .
     5926   define input parameter p-fbrhist-handle as handle no-undo .
     5927   define input parameter p-doc-code       as character    no-undo.
     5928   define input parameter p-recipe-code    as character    no-undo.
     5929   define input parameter p-price-sale-obj-type as character no-undo .
     5930   define input parameter p-price-sale-obj-code as integer no-undo .
     5931   define variable v-comp-qnty         as decimal      no-undo.
     5932   define variable v-trn-type          as character    no-undo.
     5933   define variable v-ingr-qnty         as decimal      no-undo.
     5934   define variable v-recipe-qnty       as decimal      no-undo.
     5935   define variable v-fbr-v-fbr-doc-line-recid    as recid        no-undo.
     5936   define buffer buf_fbr-recipe        for ub.fbr-recipe.
     5937   define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     5938   define buffer buf_fbr-line          for ub.fbr-line.
     5939   define buffer buf_coeff_fbr-line    for ub.fbr-line.
     5940   define buffer buf_goods             for ub.goods.
     5941   define buffer buf_fbr-doc           for ub.fbr-doc.
     5942   do
     5943   for buf_fbr-recipe
     5944     , buf_fbr-recipe-gds
     5945     , buf_fbr-line
     5946     , buf_coeff_fbr-line
     5947     , buf_goods
     5948     , buf_fbr-doc
     5949   on error undo, return error
     5950   :
     5951       find first buf_fbr-line no-lock
     5952            where buf_fbr-line.doc-code      = p-doc-code
     5953              and buf_fbr-line.is-comp       = yes
     5954              and buf_fbr-line.recipe-code   = p-recipe-code
     5955       .
     5956       find first buf_fbr-doc no-lock
     5957            where buf_fbr-doc.doc-code      = p-doc-code
     5958       .
     5959       assign
     5960           v-comp-qnty = buf_fbr-line.fact-qnty
     5961           v-trn-type  = buf_fbr-line.trn-type
     5962       .
     5963       find first buf_fbr-recipe no-lock
     5964            where buf_fbr-recipe.doc-code    = p-doc-code
     5965              and buf_fbr-recipe.recipe-code = p-recipe-code
     5966       .
     5967       assign
     5968       v-recipe-qnty = buf_fbr-recipe.qnty
     5969       .
     5970       do transaction
     5971       on error undo, return error
     5972       :
     5973           for each buf_fbr-recipe-gds no-lock
     5974              where buf_fbr-recipe-gds.doc-code      = p-doc-code
     5975                and buf_fbr-recipe-gds.recipe-code   = p-recipe-code
     5976           on error undo, return error
     5977           :
     5978               find first buf_fbr-line no-lock
     5979                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     5980                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     5981                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     5982                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     5983                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     5984               no-error.
     5985               if not available buf_fbr-line
     5986               then do:
     5987                   find first buf_goods no-lock
     5988                        where buf_goods.artic      = buf_fbr-recipe-gds.artic
     5989                          and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     5990                          and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     5991                   .
     5992                   run str/fbr-crln.p (
     5993                         input parparentproc
     5994                       , input recid( buf_fbr-doc )
     5995                       , input recid( buf_goods )
     5996                       , input buf_fbr-recipe-gds.recipe-code
     5997                       , input v-trn-type
     5998                       , input no
     5999                       , input no
     6000                       , input buf_fbr-doc.obj-type
     6001                       , input buf_fbr-doc.obj-code
     6002                       , output v-fbr-v-fbr-doc-line-recid
     6003                   ).
     6004                   find first buf_fbr-line no-lock
     6005                        where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     6006                          and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     6007                          and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     6008                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     6009                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     6010                   no-error.
     6011                   if not available buf_fbr-line
     6012                   then do:
     6013                       undo, return error substitute("Не удалось создать строку документа производства &1 &2&3&4"
     6014                                                      , p-doc-code
     6015                                                      , buf_fbr-recipe-gds.artic
     6016                                                      , buf_fbr-recipe-gds.prod-type
     6017                                                      , buf_fbr-recipe-gds.prod-code).
     6018                   end.
     6019               end.
     6020               find first buf_coeff_fbr-line exclusive-lock
     6021                    where recid( buf_coeff_fbr-line ) = recid( buf_fbr-line )
     6022               .
     6023               if buf_coeff_fbr-line.calc-method <> buf_fbr-recipe-gds.calc-method
     6024               or buf_coeff_fbr-line.coeff-value <> buf_fbr-recipe-gds.coeff-value
     6025               or buf_coeff_fbr-line.coeff-waste <> buf_fbr-recipe-gds.coeff-waste
     6026               then do:
     6027                   assign
     6028                       buf_coeff_fbr-line.calc-method = buf_fbr-recipe-gds.calc-method
     6029                       buf_coeff_fbr-line.coeff-value = buf_fbr-recipe-gds.coeff-value
     6030                       buf_coeff_fbr-line.coeff-waste = buf_fbr-recipe-gds.coeff-waste
     6031                   .
     6032               end.
     6033           end.
     6034       end.
     6035       define variable v-need-goods    as logical       no-undo.
     6036       define variable v-need-goods-list       as character     no-undo.
     6037       define variable v-need-goods-qnty-list  as character     no-undo.
     6038       find first buf_fbr-line no-lock
     6039            where buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     6040              and buf_fbr-line.is-comp     = yes
     6041              and buf_fbr-line.recipe-code = p-recipe-code
     6042       .
     6043       run str/fbr-qnty.p (
     6044             input parparentproc
     6045           , input p-fbrhist-handle
     6046           , input recid( buf_fbr-doc )
     6047           , input recid( buf_fbr-line )
     6048           , input no
     6049           , input "ingr"
     6050           , input no
     6051           , input p-price-sale-obj-type
     6052           , input p-price-sale-obj-code
     6053           , input no
     6054           , input no
     6055           , input no
     6056           , output v-need-goods
     6057           , output v-need-goods-list
     6058           , output v-need-goods-qnty-list
     6059       ).
     6060   end.
     6061   END PROCEDURE.
     6062   procedure fbrlib_check-before-close :
     6063   define input parameter p-doc-code as character no-undo .
     6064   define variable same-sale as decimal no-undo .
     6065   define variable is-waste as logical no-undo .
     6066   define variable fix-price as logical no-undo .
     6067   define buffer buf_fbr-doc for ub.fbr-doc.
     6068   define buffer buf_fbr-line for ub.fbr-line.
     6069   define buffer buf_goods for ub.goods.
     6070   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     6071   do
     6072   on error undo, return error
     6073   :
     6074     for each buf_fbr-line no-lock
     6075         where buf_fbr-line.doc-code = p-doc-code
     6076       , each buf_goods no-lock
     6077         where buf_goods.artic     = buf_fbr-line.artic
     6078           and buf_goods.prod-type = buf_fbr-line.prod-type
     6079           and buf_goods.prod-code = buf_fbr-line.prod-code
     6080     break by buf_fbr-line.prod-type
     6081           by buf_fbr-line.prod-code
     6082           by buf_fbr-line.artic
     6083     :
     6084       if first-of (buf_fbr-line.artic)
     6085       then do:
     6086         assign
     6087         same-sale = buf_fbr-line.price-sale
     6088         is-waste = (buf_fbr-line.rsrv-qnty = ?)
     6089         fix-price = buf_fbr-line.is-calc
     6090         .
     6091       end.
     6092       if same-sale <> buf_fbr-line.price-sale
     6093       then do:
     6094           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром должна быть указана одна и та же цена продажи."
     6095                                         ,p-doc-code
     6096                                         ,buf_goods.artic
     6097                                         ,buf_goods.gds-name
     6098                                         ,chr(10)).
     6099       end.
     6100       if fix-price <> buf_fbr-line.is-calc then do:
     6101           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром цена должна быть фиксирована или нет."
     6102                                         ,p-doc-code
     6103                                         ,buf_goods.artic
     6104                                         ,buf_goods.gds-name
     6105                                         ,chr(10)).
     6106       end.
     6107       if is-waste <> (buf_fbr-line.rsrv-qnty = ?)
     6108       then do:
     6109         undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа этот товар должен быть отходом либо не отходом."
     6110                                         ,p-doc-code
     6111                                         ,buf_goods.artic
     6112                                         ,buf_goods.gds-name
     6113                                         ,chr(10)).
     6114       end.
     6115       if buf_fbr-line.rsrv-qnty <> ?
     6116       and buf_goods.gds-type <> 'у':U
     6117       and ( buf_fbr-line.price-sale <= 0 or buf_fbr-line.price-sale = ?  )
     6118       and buf_fbr-line.fact-qnty <> 0
     6119       then do:
     6120         if buf_fbr-line.trn-type     = 'при':U  then for first buf_fbr-doc where buf_fbr-doc.doc-code =  p-doc-code no-lock:
     6121           if  can-find(first buf_fbr-gds-obj no-lock where
     6122                   buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     6123               AND buf_fbr-gds-obj.obj-type = buf_fbr-doc.obj-type
     6124               AND buf_fbr-gds-obj.obj-code = buf_fbr-doc.obj-code
     6125               and buf_fbr-gds-obj.is-null-price  )  then .
     6126                     else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     6127                                         ,p-doc-code
     6128                                         ,buf_goods.artic
     6129                                         ,buf_goods.gds-name
     6130                                         ,chr(10)
     6131                                         ,buf_fbr-line.recipe-code
     6132                                         ).
     6133         end.
     6134         else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     6135                                         ,p-doc-code
     6136                                         ,buf_goods.artic
     6137                                         ,buf_goods.gds-name
     6138                                         ,chr(10)
     6139                                         ,buf_fbr-line.recipe-code
     6140                                         ).
     6141       end.
     6142     end.
     6143   end.
     6144   end procedure.
     6145   define variable vss-include-info46 as character format "X(65)" no-undo
     6146   initial "@(#)$Workfile$ $Revision$".
