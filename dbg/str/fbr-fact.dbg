     2200   end.
     2201   end.
     2202   end procedure.
     2203   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2204   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
     2205   procedure partslib-clear-temp-parts :
     2206     define buffer buf_temp-parts for temp-parts .
     2207     do
     2208     on error undo, return error
     2209     :
     2210       for each buf_temp-parts
     2211       on error undo, return error
     2212       :
     2213         delete buf_temp-parts .
     2214       end.
     2215     end.
     2216   end procedure.
     2217   procedure partslib-create-temp-parts :
     2218     define parameter buffer buf_parts       for ub.parts .
     2219     define parameter buffer buf_temp-parts  for temp-parts .
     2220     define input  parameter p-goods-twounit as logical   no-undo .
     2221     define variable v-base-part-code as character no-undo .
     2222     do
     2223     on error undo, return error
     2224     :
     2225       if p-goods-twounit = true
     2226       then do:
     2227         assign
     2228           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     2229         .
     2230       end.
     2231       else do:
     2232         assign
     2233           v-base-part-code = buf_parts.part-code
     2234         .
     2235       end.
     2236       find first buf_temp-parts exclusive-lock
     2237         where buf_temp-parts.obj-type  = buf_parts.obj-type
     2238           and buf_temp-parts.obj-code  = buf_parts.obj-code
     2239           and buf_temp-parts.artic     = buf_parts.artic
     2240           and buf_temp-parts.prod-type = buf_parts.prod-type
     2241           and buf_temp-parts.prod-code = buf_parts.prod-code
     2242           and buf_temp-parts.in-code   = buf_parts.in-code
     2243           and buf_temp-parts.out-code  = 'free-zone':U
     2244           and buf_temp-parts.part-code = v-base-part-code
     2245         no-error.
     2246       if not available buf_temp-parts
     2247       then do:
     2248         create buf_temp-parts .
     2249         buffer-copy buf_parts to buf_temp-parts
     2250         assign
     2251           buf_temp-parts.out-code  = 'free-zone':U
     2252           buf_temp-parts.part-code = v-base-part-code
     2253           buf_temp-parts.rsrv-free = yes
     2254           buf_temp-parts.status_   = no
     2255           buf_temp-parts.qnty      = 0
     2256           buf_temp-parts.fact-qnty = 0
     2257           buf_temp-parts.real-qnty = 0
     2258           buf_temp-parts.cli-qnty  = 0
     2259         .
     2260       end.
     2261     end.
     2262   end procedure.
     2263   procedure partslib-init-temp-parts :
     2264     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     2265     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     2266     define input parameter p-artic           like ub.parts.artic     no-undo .
     2267     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     2268     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     2269     define buffer buf_parts      for ub.parts .
     2270     define buffer buf_temp-parts for temp-parts .
     2271     define variable v-goods-twounit    as logical   no-undo .
     2272     do
     2273     on error undo, return error
     2274     :
     2275   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2276   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2277     (input  p-artic
     2278     ,input  p-prod-type
     2279     ,input  p-prod-code
     2280     ,input  'twounit=request':u
     2281     ,output v-goods-twounit
     2282     ) no-error .
     2283       if error-status :error
     2284       then do:
     2285         message
     2286           vss-workfile vss-revision vss-description skip
     2287           vss-include-info15 skip
     2288           "Ошибка при определении атрибута товара" skip
     2289           "Артикул" p-artic p-prod-type p-prod-code skip
     2290           "twounit=request" skip
     2291           error-status :get-message(1) skip
     2292           return-value skip
     2293           view-as alert-box error .
     2294         undo, return error return-value .
     2295       end.
     2296       run partslib-clear-temp-parts in this-procedure .
     2297       for each buf_parts
     2298         where buf_parts.obj-type  = p-obj-type
     2299           and buf_parts.obj-code  = p-obj-code
     2300           and buf_parts.artic     = p-artic
     2301           and buf_parts.prod-type = p-prod-type
     2302           and buf_parts.prod-code = p-prod-code
     2303           and buf_parts.rsrv-free = yes
     2304           and buf_parts.status_   = no
     2305           and buf_parts.in-code   <> buf_parts.out-code
     2306       on error undo, return error
     2307       :
     2308         run partslib-create-temp-parts in this-procedure
     2309           (buffer buf_parts
     2310           ,buffer buf_temp-parts
     2311           ,input  v-goods-twounit
     2312           ) .
     2313         define variable v-parts-qnty          as decimal   no-undo .
     2314         define variable v-parts-cli-qnty      as decimal   no-undo .
     2315         define variable v-parts-free-qnty     as decimal   no-undo .
     2316         define variable v-parts-free-cli-qnty as decimal   no-undo .
     2317         if buf_parts.out-code = 'free-zone':U
     2318         then do:
     2319           assign
     2320             v-parts-qnty          = buf_parts.qnty
     2321             v-parts-cli-qnty      = buf_parts.cli-qnty
     2322             v-parts-free-qnty     = buf_parts.qnty
     2323             v-parts-free-cli-qnty = buf_parts.cli-qnty
     2324           .
     2325         end.
     2326         else do:
     2327           assign
     2328             v-parts-qnty          = abs(buf_parts.qnty)
     2329             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     2330             v-parts-free-qnty     = 0
     2331             v-parts-free-cli-qnty = 0
     2332           .
     2333         end.
     2334         assign
     2335           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     2336           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     2337           buf_temp-parts.real-qnty     = 0
     2338           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     2339           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     2340           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     2341         .
     2342       end.
     2343     end.
     2344   end procedure.
     2345   procedure partslib-init-temp-parts-by-factord :
     2346     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     2347     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     2348     define input parameter p-artic              like ub.parts.artic     no-undo .
     2349     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     2350     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     2351     define input parameter p-fact-order         as decimal   no-undo .
     2352     define input parameter p-include-fact-order as logical   no-undo .
     2353     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     2354     define buffer buf_gds-obj  for ub.gds-obj .
     2355     do
     2356     on error undo, return error
     2357     :
     2358       do transaction
     2359       on error undo, return error
     2360       :
     2361   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2362   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2363     (input  p-obj-type
     2364     ,input  p-obj-code
     2365     ,input  p-artic
     2366     ,input  p-prod-type
     2367     ,input  p-prod-code
     2368     ,buffer buf_gds-obj
     2369     ) no-error .
     2370         if error-status :error
     2371         then do:
     2372           message
     2373             vss-workfile vss-revision vss-description skip
     2374             vss-include-info15 skip
     2375             "Невозможно найти товар на объекте" skip
     2376             "Объект" p-obj-type p-obj-code skip
     2377             "Артикул" p-artic p-prod-type p-prod-code skip
     2378             error-status :get-message(1) skip
     2379             return-value skip
     2380             view-as alert-box error .
     2381           undo, return error .
     2382         end.
     2383         find current buf_gds-obj exclusive-lock .
     2384       end.
     2385       run partslib-init-temp-parts in this-procedure
     2386         (input p-obj-type
     2387         ,input p-obj-code
     2388         ,input p-artic
     2389         ,input p-prod-type
     2390         ,input p-prod-code
     2391         ) no-error .
     2392       if error-status :error
     2393       then do:
     2394         message
     2395           vss-workfile vss-revision vss-description skip
     2396           vss-include-info15 skip
     2397           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     2398           "Объект" p-obj-type p-obj-code skip
     2399           "Артикул" p-artic p-prod-type p-prod-code skip
     2400           "p-fact-order" p-fact-order skip
     2401           view-as alert-box error .
     2402         undo, return error .
     2403       end.
     2404       if p-include-fact-order = true
     2405       then do:
     2406         assign
     2407           p-fact-order = p-fact-order - 0.0000000001
     2408         .
     2409       end.
     2410       define variable v-max-fact-order as character no-undo .
     2411       run factord-max-fact-order in this-procedure
     2412         (output v-max-fact-order
     2413         ) no-error .
     2414       if error-status :error
     2415       then do:
     2416         message
     2417           vss-workfile vss-revision vss-description skip
     2418           vss-include-info15 skip
     2419           "Ошибка при вызове процедуры factord-max-fact-order" skip
     2420           "Объект" p-obj-type p-obj-code skip
     2421           "Артикул" p-artic p-prod-type p-prod-code skip
     2422           "p-fact-order" p-fact-order skip
     2423           view-as alert-box error .
     2424         undo, return error .
     2425       end.
     2426       run partslib-update-by-factord in this-procedure
     2427         (input p-obj-type
     2428         ,input p-obj-code
     2429         ,input p-artic
     2430         ,input p-prod-type
     2431         ,input p-prod-code
     2432         ,input p-fact-order
     2433         ,input v-max-fact-order
     2434         ,input false
     2435         ) no-error .
     2436       if error-status :error
     2437       then do:
     2438         message
     2439           vss-workfile vss-revision vss-description skip
     2440           vss-include-info15 skip
     2441           "Ошибка при вызове процедуры partslib-update-by-factord" skip
     2442           "Объект" p-obj-type p-obj-code skip
     2443           "Артикул" p-artic p-prod-type p-prod-code skip
     2444           "p-fact-order" p-fact-order skip
     2445           "v-max-fact-order" v-max-fact-order skip
     2446           view-as alert-box error .
     2447         undo, return error .
     2448       end.
     2449     end.
     2450   end procedure.
     2451   procedure partslib-update-by-factord :
     2452     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     2453     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     2454     define input parameter p-artic              like ub.parts.artic     no-undo .
     2455     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     2456     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     2457     define input parameter p-start-fact-order   as decimal   no-undo .
     2458     define input parameter p-end-fact-order     as decimal   no-undo .
     2459     define input parameter p-lock-gds-obj       as logical   no-undo .
     2460     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     2461     define buffer buf_gds-obj  for ub.gds-obj .
     2462     define buffer buf_doc-line for ub.doc-line .
     2463     define variable v-total-parts-qnty as decimal   no-undo .
     2464     define variable v-goods-gds-goods  as logical   no-undo .
     2465     define variable v-goods-twounit    as logical   no-undo .
     2466     do
     2467     on error undo, return error
     2468     :
     2469       if p-start-fact-order > p-end-fact-order
     2470       then do:
     2471         message
     2472           vss-workfile vss-revision vss-description skip
     2473           vss-include-info15 skip
     2474           "Ошибка задания входных параметров" skip
     2475           "Начало интервала превышает конец интервала" skip
     2476           "Объект" p-obj-type p-obj-code skip
     2477           "Артикул" p-artic p-prod-type p-prod-code skip
     2478           "p-start-fact-order" p-start-fact-order skip
     2479           "p-end-fact-order"   p-end-fact-order skip
     2480           view-as alert-box error .
     2481         undo, return error .
     2482       end.
     2483       if p-lock-gds-obj = true
     2484       then do:
     2485         do transaction
     2486         on error undo, return error
     2487         :
     2488   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2489   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2490     (input  p-obj-type
     2491     ,input  p-obj-code
     2492     ,input  p-artic
     2493     ,input  p-prod-type
     2494     ,input  p-prod-code
     2495     ,buffer buf_gds-obj
     2496     ) no-error .
     2497           if error-status :error
     2498           then do:
     2499             message
     2500               vss-workfile vss-revision vss-description skip
     2501               vss-include-info15 skip
     2502               "Невозможно найти gds-obj" skip
     2503               error-status :get-message(1) skip
     2504               return-value skip
     2505               view-as alert-box error .
     2506             undo, return error .
     2507           end.
     2508           find current buf_gds-obj exclusive-lock .
     2509         end.
     2510       end.
     2511   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2512   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2513     (input  p-artic
     2514     ,input  p-prod-type
     2515     ,input  p-prod-code
     2516     ,input  'gds-goods=request':u
     2517     ,output v-goods-gds-goods
     2518     ) no-error .
     2519       if error-status :error
     2520       then do:
     2521         message
     2522           vss-workfile vss-revision vss-description skip
     2523           vss-include-info15 skip
     2524           "Ошибка при определении атрибута товара" skip
     2525           "Артикул" p-artic p-prod-type p-prod-code skip
     2526           "gds-goods=request" skip
     2527           error-status :get-message(1) skip
     2528           return-value skip
     2529           view-as alert-box error .
     2530         undo, return error return-value .
     2531       end.
     2532   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2533   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2534     (input  p-artic
     2535     ,input  p-prod-type
     2536     ,input  p-prod-code
     2537     ,input  'twounit=request':u
     2538     ,output v-goods-twounit
     2539     ) no-error .
     2540       if error-status :error
     2541       then do:
     2542         message
     2543           vss-workfile vss-revision vss-description skip
     2544           vss-include-info15 skip
     2545           "Ошибка при определении атрибута товара" skip
     2546           "Артикул" p-artic p-prod-type p-prod-code skip
     2547           "twounit=request" skip
     2548           error-status :get-message(1) skip
     2549           return-value skip
     2550           view-as alert-box error .
     2551         undo, return error return-value .
     2552       end.
     2553       for each buf_doc-line no-lock
     2554         where buf_doc-line.obj-type   = p-obj-type
     2555           and buf_doc-line.obj-code   = p-obj-code
     2556           and buf_doc-line.artic      = p-artic
     2557           and buf_doc-line.prod-type  = p-prod-type
     2558           and buf_doc-line.prod-code  = p-prod-code
     2559           and buf_doc-line.status_    = 'факт':U
     2560           and buf_doc-line.fact-order > p-start-fact-order
     2561           and buf_doc-line.fact-order <= p-end-fact-order
     2562       on error undo, return error
     2563       :
     2564         run partslib-process-document in this-procedure
     2565           (input  buf_doc-line.doc-code
     2566           ,input  p-obj-type
     2567           ,input  p-obj-code
     2568           ,input  p-artic
     2569           ,input  p-prod-type
     2570           ,input  p-prod-code
     2571           ,input  v-goods-gds-goods
     2572           ,input  v-goods-twounit
     2573           ,output v-total-parts-qnty
     2574           ) no-error .
     2575         if error-status :error
     2576         then do:
     2577           message
     2578             vss-workfile vss-revision vss-description skip
     2579             vss-include-info15 skip
     2580             "Ошибка при вызове процедуры partslib-process-document" skip
     2581             "Документ" buf_doc-line.doc-code skip
     2582             "Объект" p-obj-type p-obj-code skip
     2583             "Артикул" p-artic p-prod-type p-prod-code skip
     2584             "p-start-fact-order" p-start-fact-order skip
     2585             "p-end-fact-order" p-end-fact-order skip
     2586             error-status :get-message(1) skip
     2587             return-value skip
     2588             view-as alert-box error .
     2589           undo, return error return-value .
     2590         end.
     2591       end.
     2592     end.
     2593   end procedure.
     2594   procedure partslib-process-document :
     2595     define input  parameter p-doc-code         as character no-undo .
     2596     define input  parameter p-obj-type         as character no-undo .
     2597     define input  parameter p-obj-code         as integer   no-undo .
     2598     define input  parameter p-artic            as character no-undo .
     2599     define input  parameter p-prod-type        as character no-undo .
     2600     define input  parameter p-prod-code        as integer   no-undo .
     2601     define input  parameter p-goods-gds-goods  as logical   no-undo .
     2602     define input  parameter p-goods-twounit    as logical   no-undo .
     2603     define output parameter p-total-parts-qnty as decimal   no-undo .
     2604     define variable v-parts-sign as integer   no-undo .
     2605     define buffer buf_trn-doc    for ub.trn-doc .
     2606     define buffer buf_doc-line   for ub.doc-line .
     2607     define buffer buf_parts      for ub.parts .
     2608     define buffer buf_temp-parts for temp-parts .
     2609     do
     2610     on error undo, return error return-value
     2611     :
     2612       find first buf_trn-doc no-lock
     2613         where buf_trn-doc.doc-code = p-doc-code
     2614         no-error .
     2615       if not available buf_trn-doc
     2616       then do:
     2617         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     2618                                      ,p-doc-code
     2619                                      ) .
     2620       end.
     2621       case buf_trn-doc.doc-type
     2622       :
     2623         when 'при':U or
     2624         when 'возврат':U or
     2625         when 'инв':U
     2626         then do:
     2627           assign
     2628             v-parts-sign = -1
     2629           .
     2630         end.
     2631         when 'рас':U or
     2632         when 'спи':U
     2633         then do:
     2634           assign
     2635             v-parts-sign = 1
     2636           .
     2637         end.
     2638         otherwise do:
     2639           undo, return error substitute("Неизвестный тип документа &1"
     2640                                       ,buf_trn-doc.doc-type
     2641                                       ) .
     2642         end.
     2643       end.
     2644       find first buf_doc-line no-lock
     2645         where buf_doc-line.doc-code  = p-doc-code
     2646           and buf_doc-line.artic     = p-artic
     2647           and buf_doc-line.prod-type = p-prod-type
     2648           and buf_doc-line.prod-code = p-prod-code
     2649         no-error .
     2650       if not available buf_doc-line
     2651       then do:
     2652         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     2653                                      ,p-doc-code
     2654                                      ,artic
     2655                                      ,prod-type
     2656                                      ,prod-code
     2657                                      ) .
     2658       end.
     2659       assign
     2660         p-total-parts-qnty = 0
     2661       .
     2662       if p-goods-gds-goods = true
     2663       then do:
     2664         for each buf_parts no-lock
     2665           where buf_parts.out-code  = p-doc-code
     2666             and buf_parts.obj-type  = p-obj-type
     2667             and buf_parts.obj-code  = p-obj-code
     2668             and buf_parts.artic     = p-artic
     2669             and buf_parts.prod-type = p-prod-type
     2670             and buf_parts.prod-code = p-prod-code
     2671         on error undo, return error
     2672         :
     2673           run partslib-create-temp-parts in this-procedure
     2674             (buffer buf_parts
     2675             ,buffer buf_temp-parts
     2676             ,input  p-goods-twounit
     2677             ) .
     2678           assign
     2679             p-total-parts-qnty        = p-total-parts-qnty
     2680                                       + v-parts-sign * buf_parts.fact-qnty
     2681             buf_temp-parts.qnty       = buf_temp-parts.qnty
     2682                                       + v-parts-sign * buf_parts.fact-qnty
     2683             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     2684                                       + v-parts-sign * buf_parts.fact-qnty
     2685             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     2686                                       + v-parts-sign * buf_parts.cli-qnty
     2687           .
     2688           if buf_temp-parts.qnty = 0
     2689           then do:
     2690             delete buf_temp-parts .
     2691           end.
     2692         end.
     2693       end.
     2694       else do:
     2695         assign
     2696           p-total-parts-qnty = p-total-parts-qnty
     2697                              + v-parts-sign * buf_doc-line.fact-qnty
     2698         .
     2699       end.
     2700     end.
     2701   end procedure.
     2702   procedure partslib-init-temp-parts-by-date :
     2703     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     2704     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     2705     define input parameter p-artic           like ub.parts.artic     no-undo .
     2706     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     2707     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     2708     define input parameter p-fact-date       as date      no-undo .
     2709     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     2710     do
     2711     on error undo, return error
     2712     :
     2713       define variable v-fact-order                as decimal   no-undo .
     2714       define variable v-shift-end-fact-order      as decimal   no-undo .
     2715       define variable v-day-end-fact-order        as decimal   no-undo .
     2716       run factord in this-procedure
     2717         (input  p-fact-date
     2718         ,input  1
     2719         ,input  1
     2720         ,input  ?
     2721         ,input  0
     2722         ,input  false
     2723         ,output v-fact-order
     2724         ,output v-shift-end-fact-order
     2725         ,output v-day-end-fact-order
     2726         ) no-error .
     2727       if error-status :error
     2728       then do:
     2729         message
     2730           vss-workfile vss-revision vss-description skip
     2731           vss-include-info15 skip
     2732           "Ошибка при определении момента времени, на который требуется остаток" skip
     2733           "Объект" p-obj-type p-obj-code skip
     2734           "Артикул" p-artic p-prod-type p-prod-code skip
     2735           "Дата" p-fact-date skip
     2736           view-as alert-box error .
     2737         undo, return error .
     2738       end.
     2739       run partslib-init-temp-parts-by-factord in this-procedure
     2740         (input p-obj-type
     2741         ,input p-obj-code
     2742         ,input p-artic
     2743         ,input p-prod-type
     2744         ,input p-prod-code
     2745         ,input v-day-end-fact-order
     2746         ,input false
     2747         ) no-error .
     2748       if error-status :error
     2749       then do:
     2750         message
     2751           vss-workfile vss-revision vss-description skip
     2752           vss-include-info15 skip
     2753           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     2754           "Объект" p-obj-type p-obj-code skip
     2755           "Артикул" p-artic p-prod-type p-prod-code skip
     2756           "Дата" p-fact-date skip
     2757           view-as alert-box error .
     2758         undo, return error .
     2759       end.
     2760     end.
     2761   end procedure.
     2762   procedure partslib-calc-cost :
     2763     define output parameter p-fact-qnty      as decimal   no-undo .
     2764     define output parameter p-vat-pc         as decimal   no-undo .
     2765     define output parameter p-slt-pc         as decimal   no-undo .
     2766     define output parameter p-sum-base       as decimal   no-undo .
     2767     define output parameter p-sum-rubl       as decimal   no-undo .
     2768     define output parameter p-vat-base       as decimal   no-undo .
     2769     define output parameter p-vat-rubl       as decimal   no-undo .
     2770     define output parameter p-slt-base       as decimal   no-undo .
     2771     define output parameter p-slt-rubl       as decimal   no-undo .
     2772     define output parameter p-road-tax-base  as decimal   no-undo .
     2773     define output parameter p-road-tax-rubl  as decimal   no-undo .
     2774     define output parameter p-transport-base as decimal   no-undo .
     2775     define output parameter p-transport-rubl as decimal   no-undo .
     2776     define output parameter p-other-base     as decimal   no-undo .
     2777     define output parameter p-other-rubl     as decimal   no-undo .
     2778     define output parameter p-excise-base    as decimal   no-undo .
     2779     define output parameter p-excise-rubl    as decimal   no-undo .
     2780     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     2781     do
     2782     on error undo, return error return-value
     2783     :
     2784       define buffer buf_temp-parts for temp-parts .
     2785       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     2786       define buffer   in-vatp-parts    for ub.parts   .
     2787       define buffer   in-vatp-doc      for ub.trn-doc .
     2788       define buffer   in-vatp-goods    for ub.goods   .
     2789       define buffer   in-vatp-sysconf  for ub.sysconf .
     2790       define buffer   in-vatp_doc-attr for ub.doc-attr.
     2791       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     2792       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     2793       define variable varinvprb                  as   character              no-undo.
     2794       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     2795       define variable cli-base-rate              as   decimal                no-undo.
     2796       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     2797       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     2798       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     2799       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     2800       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     2801       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     2802       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     2803       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     2804       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     2805       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     2806       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     2807       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     2808       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     2809       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     2810       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     2811       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     2812       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     2813       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     2814       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     2815       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     2816       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     2817       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     2818       define variable varinvatp-envd             as   character              no-undo.
     2819       define variable varinvatp-type             as   character              no-undo.
     2820       for each buf_temp-parts
     2821       on error undo, return error
     2822       :
     2823   assign
     2824     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     2825     price-base-with-tax-loc = buf_temp-parts.price-base
     2826   .
     2827   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2828   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2829     (output varinvprb
     2830     )  .
     2831     if buf_temp-parts.out-code = 'free-zone':U     or
     2832        buf_temp-parts.out-code = 'out-zone':U   or
     2833        buf_temp-parts.doc-type = 'акт':U then do:
     2834       assign
     2835         in-vatp-have-vat-slt = yes.
     2836     end.
     2837     else do:
     2838       find first in-vatp_doc-attr no-lock
     2839         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     2840           and in-vatp_doc-attr.attr-code = 'envd':U
     2841         no-error .
     2842       if not available in-vatp_doc-attr then do:
     2843         assign
     2844           in-vatp-have-vat-slt = yes.
     2845       end.
     2846       else do:
     2847            in-vatp-have-vat-slt = no.
     2848       end.
     2849     end.
     2850     assign
     2851      price-cli-with-tax-loc = buf_temp-parts.price-cli
     2852      cli-base-rate          = buf_temp-parts.cli-base-rate.
     2853     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     2854              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     2855     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     2856             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     2857             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     2858             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     2859             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     2860             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     2861             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2862       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2863     assign
     2864       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     2865     assign
     2866       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     2867       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     2868       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     2869       transport-cli-loc  = 0
     2870       other-cli-loc      = 0
     2871     .
     2872   ASSIGN
     2873             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2874       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2875   .
     2876         assign
     2877           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     2878           p-vat-pc         = p-vat-pc         + vat-pc-loc
     2879           p-slt-pc         = p-slt-pc         + slt-pc-loc
     2880           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     2881           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     2882           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     2883           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     2884           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     2885           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     2886           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     2887           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     2888           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     2889           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     2890           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     2891           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     2892           p-excise-base    = p-excise-base    + 0
     2893           p-excise-rubl    = p-excise-rubl    + 0
     2894         .
     2895       end.
     2896       if p-fact-qnty      = ?
     2897       or p-sum-base       = ?
     2898       or p-sum-rubl       = ?
     2899       or p-vat-base       = ?
     2900       or p-vat-rubl       = ?
     2901       or p-slt-base       = ?
     2902       or p-slt-rubl       = ?
     2903       or p-road-tax-base  = ?
     2904       or p-road-tax-rubl  = ?
     2905       or p-transport-base = ?
     2906       or p-transport-rubl = ?
     2907       or p-other-base     = ?
     2908       or p-other-rubl     = ?
     2909       or p-excise-base    = ?
     2910       or p-excise-rubl    = ?
     2911       then do:
     2912         message
     2913           vss-workfile vss-revision vss-description skip
     2914           vss-include-info15 skip
     2915           "Программа in-vatp.i вернула неопределенные значения" skip
     2916           "p-fact-qnty"      p-fact-qnty      skip
     2917           "p-sum-base"       p-sum-base       skip
     2918           "p-sum-rubl"       p-sum-rubl       skip
     2919           "p-vat-base"       p-vat-base       skip
     2920           "p-vat-rubl"       p-vat-rubl       skip
     2921           "p-slt-base"       p-slt-base       skip
     2922           "p-slt-rubl"       p-slt-rubl       skip
     2923           "p-road-tax-base"  p-road-tax-base  skip
     2924           "p-road-tax-rubl"  p-road-tax-rubl  skip
     2925           "p-transport-base" p-transport-base skip
     2926           "p-transport-rubl" p-transport-rubl skip
     2927           "p-other-base"     p-other-base     skip
     2928           "p-other-rubl"     p-other-rubl     skip
     2929           "p-excise-base"    p-excise-base    skip
     2930           "p-excise-rubl"    p-excise-rubl    skip
     2931           view-as alert-box error .
     2932         undo, return error .
     2933       end.
     2934     end.
     2935   end procedure.
