      774             v-all-total-road-tax-rubl =  v-all-total-road-tax-rubl + (road-tax-rubl-loc * buf_parts.fact-qnty)
      775            .
      776         end.
      777             if v-total-avrg-qnty > 0 then  DO :
      778                 assign
      779                   p-road-tax-base =  v-all-total-road-tax-base  / v-total-avrg-qnty
      780                   p-road-tax-rubl =  v-all-total-road-tax-rubl  / v-total-avrg-qnty
      781                   .
      782             end.
      783               if v-total-avrg-qnty <= 0 then do :
      784                   run last-incom-S in this-procedure
      785                   ( input   p-artic ,
      786                     input   p-prod-type,
      787                     input   p-prod-code ,
      788                     output  v-last-in-code,
      789                     output  v-last-obj-type,
