      544   function hvrdtax return logical (input parrecid as recid):
      545   define variable varresult as logical no-undo.
      546   run hvrdtax-proc (input parrecid, output varresult).
      547   return varresult.
      548   end function.
      549   procedure hvrdtax-proc:
      550   define input  parameter parrecid  as recid   no-undo.
      551   define output parameter parresult as logical no-undo.
      552   define buffer bf_goods for ub.goods.
      553   define buffer bf_units for ub.units.
      554   define buffer rt_tax   for ub.tax.
      555   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      556   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      557   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      558   if available rt_tax and
      559       can-find(first ub.tax-units No-LOCK WHERE
      560                      ub.tax-units.tax-code = rt_tax.tax-code AND
      561                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      562                                                       else assign parresult = no.
      563   end procedure.
      564   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      565   procedure last-incom-S :
      566   define input parameter  p-artic      like ub.gds-obj.artic      no-undo .
      567   define input parameter  p-prod-type  like ub.gds-obj.prod-type  no-undo .
      568   define input parameter  p-prod-code  like ub.gds-obj.prod-code  no-undo .
      569   define output parameter p-in-code   as character no-undo .
      570   define output parameter p-obj-type  as character no-undo .
      571   define output parameter p-obj-code  as integer   no-undo .
      572     do
      573     on error undo, return error return-value
      574     :
      575     define buffer buf_trn-doc for ub.trn-doc .
      576     define buffer buf_gds-obj for ub.gds-obj  .
      577     do
      578     on error undo, return error
      579     :
      580       assign
      581         p-in-code  = ""
      582         p-obj-type = ""
      583         p-obj-code = 0
      584       .
      585        for each x_obj-group ,
      586         each buf_gds-obj no-lock
      587         where buf_gds-obj.obj-type  = x_obj-group.obj-type
      588           and buf_gds-obj.obj-code  = x_obj-group.obj-code
      589           and buf_gds-obj.artic     = p-artic
      590           and buf_gds-obj.prod-type = p-prod-type
      591           and buf_gds-obj.prod-code = p-prod-code
      592       , first buf_trn-doc no-lock
      593         where buf_trn-doc.doc-code = buf_gds-obj.in-code
      594           and buf_trn-doc.status_  = 'факт':U
      595       on error undo, return error
      596       by buf_trn-doc.fact-order descending
      597       :
      598         assign
      599           p-in-code  = buf_gds-obj.in-code
      600           p-obj-type = buf_gds-obj.obj-type
      601           p-obj-code = buf_gds-obj.obj-code
      602         .
      603         leave .
      604       end.
      605     end.
      606     end.
      607   end procedure.
      608   procedure main-road-tax :
      609   def input param p-obj-type  like ub.gds-obj.obj-type  no-undo .
      610   def input param p-obj-code  like ub.gds-obj.obj-code  no-undo .
      611   def input param p-artic     like ub.gds-obj.artic     no-undo .
      612   def input param p-prod-type like ub.gds-obj.prod-type no-undo .
      613   def input param p-prod-code like ub.gds-obj.prod-code no-undo .
      614   def input-output param p-road-tax-base as decimal no-undo .
      615   def input-output param p-road-tax-rubl as decimal no-undo .
      616   define buffer     buff-goods    for ub.goods   .
      617   define buffer     buf_gds-obj   for ub.gds-obj .
      618   define buffer     buf_parts     for ub.parts   .
      619       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      620       define buffer   in-vatp-parts    for ub.parts   .
      621       define buffer   in-vatp-doc      for ub.trn-doc .
      622       define buffer   in-vatp-goods    for ub.goods   .
      623       define buffer   in-vatp-sysconf  for ub.sysconf .
      624       define buffer   in-vatp_doc-attr for ub.doc-attr.
      625       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      626       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      627       define variable varinvprb                  as   character              no-undo.
      628       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      629       define variable cli-base-rate              as   decimal                no-undo.
      630       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      631       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      632       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      633       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      634       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      635       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      636       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      637       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      638       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      639       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      640       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      641       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      642       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      643       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      644       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      645       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      646       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      647       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      648       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      649       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      650       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      651       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      652       define variable varinvatp-envd             as   character              no-undo.
      653       define variable varinvatp-type             as   character              no-undo.
      654   define buffer buf_trn-doc for ub.trn-doc  .
      655   define buffer buf_doc-line for ub.doc-line .
      656   define variable   is-petrolium  as logical             no-undo.
      657   define variable   is-pieces     as logical             no-undo.
      658   define variable v-last-in-code  like ub.gds-obj.in-code  no-undo .
      659   define variable v-last-obj-type like ub.gds-obj.obj-type no-undo .
      660   define variable v-last-obj-code like ub.gds-obj.obj-code no-undo .
      661   def var v-rec as recid no-undo.
      662   def var t-ret as logical no-undo .
      663   def var v-total-avrg-base as decimal no-undo .
      664   def var v-total-avrg-rubl as decimal no-undo .
      665   def var v-total-avrg-qnty as decimal no-undo .
      666   def var v-total-road-tax-base     as decimal no-undo .
      667   def var v-total-road-tax-rubl     as decimal no-undo .
      668   def var v-all-total-road-tax-base as decimal no-undo .
      669   def var v-all-total-road-tax-rubl as decimal no-undo .
      670   assign
      671     p-road-tax-base = ?
      672     p-road-tax-rubl = ?
      673     .
      674     Find first buff-goods no-lock where
      675           buff-goods.artic     = p-artic and
      676           buff-goods.prod-type = p-prod-type and
      677           buff-goods.prod-code = p-prod-code
      678           no-error .
      679         if available buff-goods then do:
      680              v-rec = recid (buff-goods).
      681              t-ret =  session:SET-WAIT-STATE("GENERAL") .
      682   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
      683     (
      684        input p-artic
      685     ,  input p-prod-type
      686     ,  input p-prod-code
      687     , output is-petrolium
      688     , output is-pieces
      689     ) .
      690              t-ret =  session:SET-WAIT-STATE("") .
      691              if not ( hvrdtax( v-rec ) = true and  is-petrolium = false  )   then  do:
      692                 assign
      693                   p-road-tax-base = ?
      694                   p-road-tax-rubl = ?
      695                   .
      696                 return.
      697              end.
      698         end.
      699         assign
      700             v-total-avrg-qnty = 0
      701             v-total-road-tax-base =  0
      702             v-total-road-tax-rubl =  0
      703             v-all-total-road-tax-base =  0
      704             v-all-total-road-tax-rubl =  0
      705             .
      706         for each x_obj-group,
      707            each buf_parts no-lock
      708           where buf_parts.obj-type  = x_obj-group.obj-type
      709             and buf_parts.obj-code  = x_obj-group.obj-code
      710             and buf_parts.artic     = p-artic
      711             and buf_parts.prod-type = p-prod-type
      712             and buf_parts.prod-code = p-prod-code
      713             and buf_parts.status_   = no
      714             and buf_parts.out-code  = 'free-zone':U
      715             and buf_parts.qnty      > 0
      716         on error undo, return error
      717         :
      718            v-total-avrg-qnty = v-total-avrg-qnty + buf_parts.fact-qnty.
      719   assign
      720     price-rubl-with-tax-loc = buf_parts.price-rubl
      721     price-base-with-tax-loc = buf_parts.price-base
      722   .
      723   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      724   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      725     (output varinvprb
      726     )  .
      727     if buf_parts.out-code = 'free-zone':U     or
      728        buf_parts.out-code = 'out-zone':U   or
      729        buf_parts.doc-type = 'акт':U then do:
      730       assign
      731         in-vatp-have-vat-slt = yes.
      732     end.
      733     else do:
      734       find first in-vatp_doc-attr no-lock
      735         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
      736           and in-vatp_doc-attr.attr-code = 'envd':U
      737         no-error .
      738       if not available in-vatp_doc-attr then do:
      739         assign
      740           in-vatp-have-vat-slt = yes.
      741       end.
      742       else do:
      743            in-vatp-have-vat-slt = no.
      744       end.
      745     end.
      746     assign
      747      price-cli-with-tax-loc = buf_parts.price-cli
      748      cli-base-rate          = buf_parts.cli-base-rate.
      749     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
      750              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
      751     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
      752             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
      753             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
      754             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
      755             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
      756             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
      757             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      758       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      759     assign
      760       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
      761     assign
      762       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
