      228   function cross-list returns logical (
      229     input parfirst-stream  as character,
      230     input parsecond-stream as character,
      231     input pardelim         as character).
      232     if pardelim = ""
      233     or pardelim = ?
      234     then do:
      235       assign
      236         pardelim = ","
      237       .
      238     end.
      239     define variable vari            as integer no-undo .
      240     define variable varresult-cross as logical no-undo .
      241     assign
      242       varresult-cross = no
      243     .
      244     def var v-num-parfirst-stream as integer no-undo .
      245     assign
      246       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      247     .
      248     do vari = 1 to v-num-parfirst-stream
      249     :
      250       if lookup(entry(vari, parfirst-stream, pardelim)
      251                ,parsecond-stream
      252                ,pardelim
      253                ) > 0 then do:
      254         assign
      255           varresult-cross = yes
      256         .
      257         leave.
      258       end.
      259     end.
      260     return varresult-cross .
      261   end function.
