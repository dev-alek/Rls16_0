        1   define input parameter fname-out       as character no-undo .
        2   define input parameter fname-in        as character no-undo .
        3   define input parameter mess            as character no-undo .
        4   define input parameter btn-mess-start  as character no-undo .
        5   define input parameter btn-mess-end    as character no-undo .
        6   define input parameter mess-continue-waiting as character no-undo .
        7   define input parameter p-waiting       as integer   no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Диалог ожидания удаления файла".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32       assign
       33         p-vss-parameters = substitute('&1|&2':u,fname-out,p-waiting)
       34       .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   define variable v-continue-waiting as logical no-undo .
      117   define variable v-can-access as logical no-undo .
      118   DEFINE BUTTON Btn_Cancel AUTO-END-KEY DEFAULT
      119        LABEL "Прервать ожидание"
      120        SIZE 30 BY 1.5
      121        BGCOLOR 8 .
      122   DEFINE VARIABLE EDITOR-1 AS CHARACTER
      123        VIEW-AS EDITOR
      124        SIZE 39 BY 4.67
      125        BGCOLOR 8  NO-UNDO.
      126   DEFINE VARIABLE FI-ExecTime AS CHARACTER FORMAT "X(256)":U
      127        VIEW-AS FILL-IN
      128        SIZE 39 BY 1 NO-UNDO.
      129   DEFINE FRAME DIALOG-1
      130        EDITOR-1 AT ROW 1.13 COL 2.13 NO-LABEL
      131        FI-ExecTime AT ROW 6.13 COL 2.13 NO-LABEL
      132        Btn_Cancel AT ROW 7.79 COL 6.63
      133        SPACE(5.61) SKIP(0.45)
      134       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      135            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      136            BGCOLOR 8
      137            TITLE BGCOLOR 8 ""
      138            CANCEL-BUTTON Btn_Cancel.
      139   ASSIGN
      140          FRAME DIALOG-1:SCROLLABLE       = FALSE.
      141   ASSIGN
      142          Btn_Cancel:HIDDEN IN FRAME DIALOG-1           = TRUE.
      143   ASSIGN
      144          EDITOR-1:READ-ONLY IN FRAME DIALOG-1        = TRUE.
      145   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DIALOG-1:PARENT eq ?
      146   THEN FRAME DIALOG-1:PARENT = ACTIVE-WINDOW.
      147   define variable v-exec-time as integer no-undo .
      148   on window-close OF FRAME DIALOG-1 do:
      149     apply "end-error" to frame DIALOG-1.
      150   end.
      151   on "end-error":U of frame DIALOG-1 do:
      152     if v-exec-time < p-waiting then do:
      153       return no-apply .
      154     end.
      155   end.
      156   MAIN-BLOCK:
      157   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      158      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      159     assign
      160       frame DIALOG-1 :title = mess
      161     .
      162     RUN MyEnable .
      163     define variable v-start-time as int64   no-undo .
      164     assign
      165       v-start-time = etime
      166     .
      167     do while true
      168     :
      169       assign
      170         v-exec-time = (etime - v-start-time) / 1000
      171       .
      172       assign
      173         fi-exectime :screen-value = substitute("Время ожидания &1", string(v-exec-time, "HH:MM:SS"))
      174       .
      175       if v-continue-waiting then do:
      176           assign
      177             Editor-1 :screen-value = mess-continue-waiting
      178           .
      179       end.
      180       if v-exec-time >= p-waiting
      181       and not v-continue-waiting
      182       then do:
      183         if fname-out <> "" then do:
      184           assign
      185             Editor-1 :screen-value = btn-mess-end
      186           .
      187           display btn_cancel with frame DIALOG-1.
      188           enable btn_cancel with frame DIALOG-1.
      189         end.
      190         else do:
      191           return .
      192         end.
      193       end.
      194       if fname-out <> "" then do:
      195         if search(fname-out) = ?
      196         then do:
      197           return .
      198         end.
      199         else do:
      200           if search(fname-in) <> ? then do:
      201               assign
      202               v-continue-waiting = yes
      203               .
      204           end.
      205         end.
      206       end.
      207       WAIT-FOR GO OF FRAME DIALOG-1 FOCUS Btn_cancel PAUSE 1 .
      208     end.
      209   END.
      210   if true then do:
      211     return error .
      212   end.
      213   RUN disable_UI.
      214   PROCEDURE disable_UI :
      215     HIDE FRAME DIALOG-1.
      216   END PROCEDURE.
      217   PROCEDURE enable_UI :
      218     DISPLAY EDITOR-1 FI-ExecTime
      219         WITH FRAME DIALOG-1.
      220     ENABLE EDITOR-1 FI-ExecTime
      221         WITH FRAME DIALOG-1.
      222   END PROCEDURE.
      223   PROCEDURE MyEnable :
      224    Enable Editor-1
      225    With Frame DIALOG-1.
      226    DISPLAY
      227    Editor-1
      228    FI-ExecTime
      229    With Frame DIALOG-1.
      230    Editor-1:screen-value = btn-mess-start.
      231   END PROCEDURE.
