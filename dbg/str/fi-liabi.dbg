     4345        )
     4346     then do:
     4347       if self :handle <> focus :handle
     4348       then do:
     4349         apply "entry":u to self .
     4350       end.
     4351       define variable v-ok            as logical   no-undo .
     4352       define variable v-curr-sv-date  as date      no-undo .
     4353       define variable v-description   as character no-undo .
