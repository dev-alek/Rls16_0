     1133        VIEW-AS FILL-IN NATIVE
     1134        SIZE 22 BY 1 TOOLTIP "<<F5>> - пересчет курса баз.вал." NO-UNDO.
     1135   DEFINE VARIABLE loc_sum-contract LIKE fin-ob.sum-contract
     1136        VIEW-AS FILL-IN NATIVE
     1137        SIZE 22 BY 1 TOOLTIP "<<F5>> - пересчет курса валюты договора" NO-UNDO.
     1138   DEFINE VARIABLE loc_sum-doc LIKE fin-ob.sum-doc
     1139        VIEW-AS FILL-IN NATIVE
     1140        SIZE 22 BY 1 TOOLTIP "<<F5>> - пересчет курса платежа" NO-UNDO.
     1141   DEFINE VARIABLE loc_sum-rubl LIKE fin-ob.sum-rubl
     1142        VIEW-AS FILL-IN NATIVE
     1143        SIZE 22 BY .83 NO-UNDO.
     1144   DEFINE VARIABLE loc_sum-tax-base LIKE fin-ob.sum-tax-base
     1145        VIEW-AS FILL-IN NATIVE
     1146        SIZE 22 BY 1 NO-UNDO.
     1147   DEFINE VARIABLE loc_sum-tax-contract LIKE fin-ob.sum-tax-contract
     1148        VIEW-AS FILL-IN NATIVE
     1149        SIZE 22 BY 1 NO-UNDO.
     1150   DEFINE VARIABLE loc_sum-tax-doc LIKE fin-ob.sum-tax-doc
     1151        VIEW-AS FILL-IN NATIVE
     1152        SIZE 22 BY 1 NO-UNDO.
     1153   DEFINE VARIABLE loc_sum-tax-rubl LIKE fin-ob.sum-tax-rubl
     1154        VIEW-AS FILL-IN NATIVE
     1155        SIZE 22 BY .83 NO-UNDO.
     1156   DEFINE VARIABLE p-doc-code AS CHARACTER FORMAT "x(16)"
     1157        LABEL "Внут.№"
     1158         VIEW-AS TEXT
     1159        SIZE 15.75 BY .67 TOOLTIP "Внутренний код документа"
     1160        FGCOLOR 7 .
     1161   DEFINE VARIABLE RADIO-SET-dogovor AS LOGICAL INITIAL yes
     1162        VIEW-AS RADIO-SET HORIZONTAL
     1163        RADIO-BUTTONS
     1164             "по договору", yes,
     1165   "без договора", no
     1166        SIZE 28.5 BY .67
     1167        FGCOLOR 4  NO-UNDO.
     1168   DEFINE RECTANGLE RECT-1
     1169        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1170        SIZE 20.5 BY 5.13.
     1171   DEFINE RECTANGLE RECT-2
     1172        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1173        SIZE 24 BY 5.13.
     1174   DEFINE RECTANGLE RECT-4
     1175        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1176        SIZE 19.25 BY 5.13.
     1177   DEFINE RECTANGLE RECT-5
     1178        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1179        SIZE 24 BY 5.13.
     1180   DEFINE VARIABLE T-base AS LOGICAL INITIAL no
     1181        LABEL ""
     1182        VIEW-AS TOGGLE-BOX
     1183        SIZE 2.13 BY .83 TOOLTIP "Ввод суммы в базовой валюте" NO-UNDO.
     1184   DEFINE VARIABLE T-contract AS LOGICAL INITIAL no
     1185        LABEL ""
     1186        VIEW-AS TOGGLE-BOX
     1187        SIZE 2.13 BY .83 TOOLTIP "Ввод суммы в валюте договора" NO-UNDO.
     1188   DEFINE VARIABLE T-doc AS LOGICAL INITIAL no
     1189        LABEL ""
     1190        VIEW-AS TOGGLE-BOX
     1191        SIZE 2.13 BY .83 TOOLTIP "Ввод суммы в валюте документа" NO-UNDO.
     1192   DEFINE VARIABLE T-rubl AS LOGICAL INITIAL no
     1193        LABEL ""
     1194        VIEW-AS TOGGLE-BOX
     1195        SIZE 2.13 BY .83 TOOLTIP "Ввод суммы в нац. валюте" NO-UNDO.
     1196   DEFINE QUERY BROWSE-1 FOR
     1197         tt_fin-ob-tax SCROLLING.
     1198   DEFINE BROWSE BROWSE-1
     1199     QUERY BROWSE-1 NO-LOCK DISPLAY
     1200         tt_fin-ob-tax.sum-line-doc COLUMN-LABEL "Сумма c налогом!в вал.док-та" FORMAT "->>>>>>>>>>9.99":U
     1201         tt_fin-ob-tax.with-slt COLUMN-LABEL "НП" FORMAT "  /без":U
     1202         tt_fin-ob-tax.slt-pc COLUMN-LABEL "Ставка!НП" FORMAT ">9.9<%":U
     1203         tt_fin-ob-tax.sum-slt-line-doc COLUMN-LABEL "Сумма НП!в вал.док-та" FORMAT "->>>>>>>>>9.99":U
     1204         tt_fin-ob-tax.with-vat COLUMN-LABEL "НДС" FORMAT " /без":U
     1205         tt_fin-ob-tax.vat-pc COLUMN-LABEL "Ставка!НДС" FORMAT ">9.9<%":U
     1206         tt_fin-ob-tax.sum-vat-line-doc COLUMN-LABEL "Сумма НДС!в вал.док-та" FORMAT "->>>>>>>>>>9.99":U
     1207       WITH SEPARATORS SIZE 68 BY 4.5
     1208            BGCOLOR 15  ROW-HEIGHT-CHARS .67.
     1209   DEFINE FRAME Dialog-Frame
     1210        b-exit AT ROW 1 COL 1
     1211        b-quit AT ROW 1 COL 11
     1212        B-contract AT ROW 1 COL 31.5
     1213        B-receiver AT ROW 1 COL 41.5
     1214        B-payer AT ROW 1 COL 54.75
     1215        B-parts AT ROW 1 COL 68
     1216        B-hist AT ROW 1 COL 78
     1217        B-help AT ROW 1 COL 88
     1218        b-prev AT ROW 2 COL 1
     1219        b-next AT ROW 2 COL 6
     1220        r-obj-firm AT ROW 2 COL 64
     1221        RADIO-SET-dogovor AT ROW 2.25 COL 15.5 NO-LABEL
     1222        loc_contract-code AT ROW 3 COL 13 COLON-ALIGNED
     1223        r-con AT ROW 3 COL 34
     1224        loc_pay-date AT ROW 4 COL 13 COLON-ALIGNED
     1225        loc_receiver-code AT ROW 5 COL 13 COLON-ALIGNED NO-LABEL
     1226        r-cli AT ROW 5 COL 27.63
     1227        loc_prn-doc-code AT ROW 5 COL 79.5 COLON-ALIGNED
     1228        loc_payer-code AT ROW 6 COL 13 COLON-ALIGNED NO-LABEL
     1229        loc_corr-doc AT ROW 6 COL 79.5 COLON-ALIGNED HELP
     1230             ""
     1231             LABEL "Корр.ФО" FORMAT ">>>>>>>"
     1232        r-obj AT ROW 6.04 COL 27.63
     1233        r-cur AT ROW 8.25 COL 12.88
     1234        loc_exch-rate AT ROW 8.25 COL 20 COLON-ALIGNED NO-LABEL
     1235        loc_exch-scale AT ROW 8.25 COL 32.38 COLON-ALIGNED NO-LABEL
     1236        loc_sum-doc AT ROW 8.25 COL 39.13 COLON-ALIGNED HELP
     1237             "" NO-LABEL FORMAT "->>>,>>>,>>>,>>9.99"
     1238        loc_sum-tax-doc AT ROW 8.25 COL 62.88 COLON-ALIGNED HELP
     1239             "" NO-LABEL FORMAT "->,>>>,>>>,>>>,>>9.99"
     1240        T-doc AT ROW 8.25 COL 92.88
     1241        loc_sum-rubl AT ROW 9.21 COL 39.13 COLON-ALIGNED HELP
     1242             "" NO-LABEL FORMAT "->,>>>,>>>,>>>,>>9.99"
     1243        loc_sum-tax-rubl AT ROW 9.21 COL 62.88 COLON-ALIGNED HELP
     1244             "" NO-LABEL FORMAT "->,>>>,>>>,>>>,>>9.99"
     1245        T-rubl AT ROW 9.21 COL 92.88
     1246        loc_base-rate AT ROW 10.08 COL 20 COLON-ALIGNED NO-LABEL
     1247        loc_base-scale AT ROW 10.08 COL 32.5 COLON-ALIGNED NO-LABEL
     1248        loc_sum-base AT ROW 10.08 COL 39.13 COLON-ALIGNED HELP
     1249             "" NO-LABEL FORMAT "->,>>>,>>>,>>>,>>9.99"
     1250        loc_sum-tax-base AT ROW 10.08 COL 62.88 COLON-ALIGNED HELP
     1251             "" NO-LABEL FORMAT "->,>>>,>>>,>>>,>>9.99"
     1252        T-base AT ROW 10.08 COL 92.88
     1253        loc_contract-rate AT ROW 11.13 COL 20 COLON-ALIGNED NO-LABEL
     1254        loc_contract-scale AT ROW 11.13 COL 32.5 COLON-ALIGNED NO-LABEL
     1255        loc_sum-contract AT ROW 11.13 COL 39.13 COLON-ALIGNED HELP
     1256             "" NO-LABEL FORMAT "->,>>>,>>>,>>>,>>9.99"
     1257        loc_sum-tax-contract AT ROW 11.13 COL 62.88 COLON-ALIGNED HELP
     1258             "" NO-LABEL FORMAT "->,>>>,>>>,>>>,>>9.99"
     1259        T-contract AT ROW 11.13 COL 92.88
     1260        BROWSE-1 AT ROW 12.5 COL 1.5
     1261        B-calc-exch AT ROW 12.5 COL 70
     1262        B-ins AT ROW 17.25 COL 1.5
     1263        B-chg AT ROW 17.25 COL 11.5
     1264        B-del AT ROW 17.25 COL 21.5
     1265        loc_PS AT ROW 18.5 COL 1 NO-LABEL
     1266        FI-obj AT ROW 2.25 COL 44.5 COLON-ALIGNED NO-LABEL
     1267        FI-obj-type AT ROW 2.25 COL 52.5 COLON-ALIGNED NO-LABEL
     1268        FI-obj-code AT ROW 2.25 COL 56.5 COLON-ALIGNED NO-LABEL
     1269        FI-obj-name AT ROW 2.25 COL 65 COLON-ALIGNED NO-LABEL
     1270        loc_doc-date AT ROW 2.75 COL 79.5 COLON-ALIGNED
     1271        loc_fact-date AT ROW 3.42 COL 79.5 COLON-ALIGNED
     1272        p-doc-code AT ROW 4.17 COL 79.5 COLON-ALIGNED
     1273        loc_receiver-type AT ROW 5 COL 22.5 COLON-ALIGNED NO-LABEL
     1274        loc_receiver-name AT ROW 5 COL 28.5 COLON-ALIGNED NO-LABEL
     1275        f-receiver AT ROW 5.25 COL 1 NO-LABEL
     1276        loc_payer-type AT ROW 5.96 COL 22.5 COLON-ALIGNED NO-LABEL
     1277        loc_payer-name AT ROW 6.04 COL 28.5 COLON-ALIGNED NO-LABEL
     1278       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1279            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1280            CANCEL-BUTTON b-quit.
     1281   DEFINE FRAME Dialog-Frame
     1282        f-payer AT ROW 6.25 COL 1 NO-LABEL
     1283        FILL-IN-4 AT ROW 7.5 COL 1.75 NO-LABEL
     1284        FILL-IN-5 AT ROW 7.5 COL 22 NO-LABEL
     1285        FILL-IN-6 AT ROW 7.5 COL 41.13 NO-LABEL
     1286        FILL-IN-7 AT ROW 7.5 COL 64.88 NO-LABEL
     1287        loc_curr-code AT ROW 8.25 COL 7.88 COLON-ALIGNED
     1288        loc_abbr-doc AT ROW 8.25 COL 14.38 COLON-ALIGNED NO-LABEL
     1289        loc_abbr-rubl AT ROW 9.08 COL 1.75 NO-LABEL
     1290        loc_abbr-base AT ROW 10.08 COL 1.75 NO-LABEL
     1291        f-contract-curr AT ROW 11.13 COL 1.75 NO-LABEL
     1292        loc_contract-curr AT ROW 11.13 COL 10.88 COLON-ALIGNED NO-LABEL
     1293        loc_abbr-contract AT ROW 11.13 COL 14.88 COLON-ALIGNED NO-LABEL
     1294        RECT-1 AT ROW 7.25 COL 1
     1295        RECT-2 AT ROW 7.25 COL 40.5
     1296        RECT-4 AT ROW 7.25 COL 21.38
     1297        RECT-5 AT ROW 7.25 COL 64.13
     1298        SPACE(9.88) SKIP(8.79)
     1299       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1300            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1301            TITLE "Финансовые обязательства"
     1302            CANCEL-BUTTON b-quit.
     1303   ASSIGN
     1304          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1305          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1306   ASSIGN
     1307          b-next:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1308   ASSIGN
     1309          b-prev:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1310   ASSIGN
     1311          T-base:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1312   ASSIGN
     1313          T-contract:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1314   ASSIGN
     1315          T-doc:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1316   ASSIGN
     1317          T-rubl:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1318   ON GO OF FRAME Dialog-Frame
     1319   DO:
     1320     if input loc_prn-doc-code = ""
     1321           or loc_prn-doc-code = ?
     1322     then do:
     1323         message "Номер документа  не может быть не задан" view-as alert-box.
     1324         apply "ENTRY":U to loc_prn-doc-code.
     1325         return no-apply.
     1326     end.
     1327     if ref-mode =  'ДОБАВЛЕНИЕ':U then do:
     1328     end.
     1329     if ref-mode <> 'ПРОСМОТР':U then do:
     1330         assign
     1331         loc_contract-code loc_pay-date loc_receiver-code loc_prn-doc-code loc_payer-code loc_corr-doc loc_exch-rate loc_exch-scale loc_sum-doc loc_base-rate loc_base-scale loc_contract-rate loc_contract-scale loc_PS FI-obj-type FI-obj-code loc_receiver-type loc_payer-type loc_curr-code loc_contract-curr
     1332         .
     1333     end.
     1334    run save-p no-error .
     1335    if error-status :error then return no-apply.
     1336   END.
     1337   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1338   DO:
     1339     APPLY "END-ERROR":U TO SELF.
     1340   END.
     1341   ON CHOOSE OF B-calc-exch IN FRAME Dialog-Frame
     1342   DO:
     1343   define variable p-hide-rubl  as logical init false   no-undo .
     1344   define variable p-hide-base  as logical init false no-undo .
     1345   define variable p-hide-contr as logical init false no-undo .
     1346   define variable p-res as logical no-undo .
     1347    if p-basecode = 0         then   p-hide-base  = true .
     1348    if loc_contract-curr = 0  then   p-hide-contr  = true .
     1349    run str/fo-curr.w (
     1350    input  parParentProc ,
     1351    input  par-host-code ,
     1352    input-output  loc_sum-rubl  ,
     1353    input-output  loc_sum-base  ,
     1354    input-output  loc_sum-contract ,
     1355    input         p-basecode ,
     1356    input-output  loc_base-rate  ,
     1357    input-output  loc_base-scale ,
     1358    input         loc_contract-curr ,
     1359    input-output  loc_contract-rate  ,
     1360    input-output  loc_contract-scale ,
     1361    input loc_curr-code ,
     1362    input p-hide-rubl  ,
     1363    input p-hide-base  ,
     1364    input p-hide-contr ,
     1365    output p-res
     1366         ).
     1367   if p-res = false then return.
     1368   define variable t-v as logical no-undo .
     1369         case loc_curr-code:
     1370           when 0 then do :
     1371            assign
     1372             loc_sum-doc = loc_sum-rubl
     1373             loc_exch-rate = 1
     1374             loc_exch-scale = 1
     1375            .
     1376           end.
     1377           when p-basecode then do :
     1378            assign
     1379             loc_sum-doc    = loc_sum-base
     1380             loc_exch-rate  = loc_base-rate
     1381             loc_exch-scale = loc_base-scale
     1382            .
     1383           end.
     1384           when loc_contract-curr then do :
     1385            assign
     1386             loc_sum-doc    = loc_sum-contract
     1387             loc_exch-rate  = loc_contract-rate
     1388             loc_exch-scale = loc_contract-scale
     1389            .
     1390           end.
     1391         end case.
     1392   if loc_curr-code <> 0 and
     1393       p-basecode = loc_contract-curr and
     1394       loc_curr-code = loc_contract-curr
     1395       and ( loc_base-rate <> loc_contract-rate or
     1396             loc_sum-base  <> loc_sum-contract)
     1397       then do:
     1398       t-v = true .
     1399       message
     1400         "Базовая и валюта договора одна , но курс или сумма разные" skip
     1401         "Платеж будет по валюте договора ?"
     1402         view-as alert-box question
     1403         Buttons yes-no
     1404         update t-v    .
     1405           if t-v = true then do:
     1406            assign
     1407             loc_sum-doc    = loc_sum-contract
     1408             loc_exch-rate  = loc_contract-rate
     1409             loc_exch-scale = loc_contract-scale
     1410            .
     1411           end.
     1412           else do:
     1413            assign
     1414             loc_sum-doc    = loc_sum-base
     1415             loc_exch-rate  = loc_base-rate
     1416             loc_exch-scale = loc_base-scale
     1417            .
     1418           end.
     1419       end.
     1420     run create-tax (
     1421        input loc_sum-doc ,
     1422        input loc_sum-rubl  ,
     1423        input loc_sum-base   ,
     1424        input loc_sum-contract ,
     1425        input "doc":U ,
     1426        output loc_sum-tax-doc) .
     1427   loc_sum-tax-rubl       = (  loc_exch-rate       / loc_exch-scale)    * loc_sum-tax-doc .
     1428   loc_sum-tax-base       = (  loc_base-scale      / loc_base-rate)     * loc_sum-tax-rubl .
     1429   loc_sum-tax-contract   = (  loc_contract-scale  / loc_contract-rate) * loc_sum-tax-rubl .
     1430   display
     1431    loc_sum-doc
     1432    loc_sum-tax-doc
     1433    loc_exch-rate
     1434    loc_exch-scale
     1435    loc_sum-rubl          when loc_sum-rubl     :visible
     1436    loc_sum-tax-rubl      when loc_sum-rubl     :visible
     1437    with frame Dialog-Frame
     1438    .
     1439    if loc_sum-contract <> loc_sum-doc or loc_contract-rate   <> loc_exch-rate then
     1440       display loc_contract-rate loc_contract-scale loc_sum-contract loc_sum-tax-contract f-contract-curr loc_contract-curr loc_abbr-contract  with frame Dialog-Frame .
     1441    if loc_contract-curr <> 0 then do:
     1442    if loc_sum-base <> loc_sum-doc or loc_base-rate   <> loc_exch-rate then
     1443       display loc_base-rate loc_base-scale loc_sum-base loc_sum-tax-base loc_abbr-base  with frame Dialog-Frame .
     1444    end.
     1445   END.
     1446   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1447   DO:
     1448     define variable p-recid            as  recid   no-undo .
     1449     define variable p-res              as  logical no-undo .
     1450     define variable v-slt-pc           like fin-ob-tax.slt-pc           no-undo.
     1451     define variable v-loc_sum-doc      like fin-ob-tax.sum-line-doc     no-undo.
     1452     define variable v-sum-vat-line-doc like fin-ob-tax.sum-vat-line-doc no-undo.
     1453     define variable v-sum-slt-line-doc like fin-ob-tax.sum-slt-line-doc no-undo.
     1454     define variable v-vat-pc           like fin-ob-tax.vat-pc           no-undo.
     1455     define variable v-with-slt         like fin-ob-tax.with-slt         no-undo.
     1456     define variable v-with-vat         like fin-ob-tax.with-vat         no-undo.
     1457     find current tt_fin-ob-tax no-error .
     1458     if not available tt_fin-ob-tax then find first tt_fin-ob-tax no-error .
     1459       if not available tt_fin-ob-tax then return no-apply.
     1460       assign
     1461         p-recid            = recid(tt_fin-ob-tax)
     1462         v-slt-pc           = tt_fin-ob-tax.slt-pc
     1463         v-loc_sum-doc      = tt_fin-ob-tax.sum-line-doc
     1464         v-sum-vat-line-doc = tt_fin-ob-tax.sum-vat-line-doc
     1465         v-sum-slt-line-doc = tt_fin-ob-tax.sum-slt-line-doc
     1466         v-vat-pc           = tt_fin-ob-tax.vat-pc
     1467         v-with-slt         = tt_fin-ob-tax.with-slt
     1468         v-with-vat         = tt_fin-ob-tax.with-vat
     1469       .
     1470   run str/fi-txli.w (
     1471    INPUT  parParentProc ,
     1472    input  par-host-code   ,
     1473    input  'ИЗМЕНЕНИЕ':U             ,
     1474    input  par-host-code         ,
     1475    input  p-doc-code            ,
     1476    input  p-doc-type            ,
     1477    input  loc_sum-doc           ,
     1478    input  loc_curr-code ,
     1479    input  loc_base-rate ,
     1480    input  loc_base-scale,
     1481    input  loc_exch-rate ,
     1482    input  loc_exch-scale,
     1483    input-output v-slt-pc          ,
     1484    input-output v-loc_sum-doc     ,
     1485    input-output v-sum-vat-line-doc,
     1486    input-output v-sum-slt-line-doc,
     1487    input-output v-vat-pc          ,
     1488    input-output v-with-slt        ,
     1489    input-output v-with-vat        ,
     1490    INPUT TABLE tt_fin-ob-tax      ,
     1491    input recid(tt_fin-ob-tax)     ,
     1492    input ?      ,
     1493    output p-res
     1494     ) no-error .
     1495   if p-res = true then do:
     1496       assign
     1497         tt_fin-ob-tax.slt-pc           = v-slt-pc
     1498         tt_fin-ob-tax.sum-line-doc     = v-loc_sum-doc
     1499         tt_fin-ob-tax.sum-vat-line-doc = v-sum-vat-line-doc
     1500         tt_fin-ob-tax.sum-slt-line-doc = v-sum-slt-line-doc
     1501         tt_fin-ob-tax.vat-pc           = v-vat-pc
     1502         tt_fin-ob-tax.with-slt         = v-with-slt
     1503         tt_fin-ob-tax.with-vat         = v-with-vat
     1504       .
     1505       OPEN QUERY BROWSE-1 FOR EACH tt_fin-ob-tax NO-LOCK.
     1506       reposition BROWSE-1 TO RECID p-recid NO-ERROR .
     1507       run calc-tax .
     1508   end.
     1509   END.
     1510   ON return OF B-chg IN FRAME Dialog-Frame
     1511   DO:
     1512     run next-focus in this-procedure  (input  B-chg:handle ) .
     1513     return no-apply .
     1514   END.
     1515   ON CHOOSE OF B-contract IN FRAME Dialog-Frame
     1516   DO:
     1517   assign
     1518      loc_contract-code
     1519   .
     1520   define variable ri as recid no-undo .
     1521   define buffer b_contract for contract.
     1522   find first b_contract no-lock  where b_contract.contract-code     = loc_contract-code-id and
     1523                                        b_contract.host-code         = par-host-code
     1524                                        no-error .
     1525   if error-status :error then return no-apply.
     1526   ri = recid (b_contract) .
     1527   run str/sh-contr.p
     1528       ( input parParentProc ,
     1529         input ri
     1530       ).
     1531   END.
     1532   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1533   DO:
     1534   find current tt_fin-ob-tax   no-error .
     1535   if not available tt_fin-ob-tax  then return .
     1536   define variable g-log as log no-undo.
     1537   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1538   do:
     1539     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1540       (input  v-cntxt-db-num
     1541       ,input  v-cntxt-userid
     1542       ,input  0
     1543       ,input  'actn_fin-liability_deletion':U
     1544       ,input  'firm':U
     1545       ,input  par-host-code
     1546       ,input  '':U
     1547       ,input  0
     1548       ,input  0
     1549       ,input  0
     1550       ,input  0
     1551       ,input  true
     1552       ,output g-log
     1553       )  .
     1554   end.
     1555   if not g-log then  return .
     1556     else do:
     1557         message "Удалить запись ?"
     1558         view-as alert-box question
     1559         buttons yes-no
     1560         update g-log.
     1561         if g-log = false then return no-apply.
     1562     end.
     1563     define variable v-code as integer no-undo .
     1564     delete tt_fin-ob-tax .
     1565     run calc-tax .
     1566     OPEN QUERY BROWSE-1 FOR EACH tt_fin-ob-tax NO-LOCK.
     1567   END.
     1568   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     1569   DO:
     1570       next-prev = ?.
     1571   END.
     1572   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     1573   DO:
     1574       define variable  rid-list AS CHAR NO-UNDO.
     1575          run str/fincliab.w
     1576            (input  parparentproc          ,
     1577             input  ""                      ,
     1578             input  'фирма':U                  ,
     1579             input  par-host-code           ,
     1580             input  p-doc-code   ,
     1581             output rid-list       ).
     1582   END.
     1583   ON CHOOSE OF B-ins IN FRAME Dialog-Frame
     1584   DO:
     1585     define variable p-recid            as  recid   no-undo .
     1586     define variable p-res              as  logical no-undo .
     1587     define variable v-slt-pc           like fin-ob-tax.slt-pc           no-undo.
     1588     define variable v-loc_sum-doc      like fin-ob-tax.sum-line-doc      no-undo.
     1589     define variable v-sum-vat-line-doc like fin-ob-tax.sum-vat-line-doc no-undo.
     1590     define variable v-sum-slt-line-doc like fin-ob-tax.sum-slt-line-doc no-undo.
     1591     define variable v-vat-pc           like fin-ob-tax.vat-pc           no-undo.
     1592     define variable v-with-slt         like fin-ob-tax.with-slt         no-undo.
     1593     define variable v-with-vat         like fin-ob-tax.with-vat         no-undo.
     1594   run str/fi-txli.w (
     1595    INPUT  parParentProc ,
     1596    input  par-host-code ,
     1597    input  'ДОБАВЛЕНИЕ':U    ,
     1598    input  par-host-code ,
     1599    input  p-doc-code    ,
     1600    input  p-doc-type    ,
     1601    input  loc_sum-doc   ,
     1602    input  loc_curr-code ,
     1603    input  loc_base-rate ,
     1604    input  loc_base-scale,
     1605    input  loc_exch-rate ,
     1606    input  loc_exch-scale,
     1607    input-output v-slt-pc          ,
     1608    input-output v-loc_sum-doc     ,
     1609    input-output v-sum-vat-line-doc,
     1610    input-output v-sum-slt-line-doc,
     1611    input-output v-vat-pc          ,
     1612    input-output v-with-slt        ,
     1613    input-output v-with-vat        ,
     1614    INPUT TABLE tt_fin-ob-tax ,
     1615    input ?      ,
     1616    input ?      ,
     1617    output p-res
     1618     ).
     1619   define variable l-num as integer no-undo .
     1620   l-num = 0.
     1621   if p-res = true then do:
     1622     find last tt_fin-ob-tax use-index pi no-error .
     1623        if not available tt_fin-ob-tax
     1624               then l-num = 0.
     1625               else l-num = tt_fin-ob-tax.line-num.
     1626       l-num = l-num + 1.
     1627       create tt_fin-ob-tax.
     1628       assign
     1629         tt_fin-ob-tax.doc-code         = p-doc-code
     1630         tt_fin-ob-tax.host-code        = par-host-code
     1631         tt_fin-ob-tax.line-num         = l-num
     1632         tt_fin-ob-tax.slt-pc           = v-slt-pc
     1633         tt_fin-ob-tax.sum-line-doc     = v-loc_sum-doc
     1634         tt_fin-ob-tax.sum-vat-line-doc = v-sum-vat-line-doc
     1635         tt_fin-ob-tax.sum-slt-line-doc = v-sum-slt-line-doc
     1636         tt_fin-ob-tax.vat-pc           = v-vat-pc
     1637         tt_fin-ob-tax.with-slt         = v-with-slt
     1638         tt_fin-ob-tax.with-vat         = v-with-vat
     1639       .
     1640   end.
     1641   run calc-tax .
     1642   OPEN QUERY BROWSE-1 FOR EACH tt_fin-ob-tax NO-LOCK.
     1643   reposition BROWSE-1 TO RECID p-recid NO-ERROR .
     1644   END.
     1645   ON CHOOSE OF b-next IN FRAME Dialog-Frame
     1646   DO:
     1647   run step-next.
     1648   END.
     1649   ON CHOOSE OF B-parts IN FRAME Dialog-Frame
     1650   DO:
     1651       run str/fi-parts.w
     1652         ( input parParentProc ,
     1653           input p-doc-code ,
     1654           input par-host-code  )
     1655           .
     1656   END.
     1657   ON CHOOSE OF B-payer IN FRAME Dialog-Frame
     1658   DO:
     1659   assign loc_payer-code loc_payer-type .
     1660   run lookup-cli (loc_payer-code , loc_payer-type) no-error .
     1661       if error-status :error then return no-apply.
     1662   END.
     1663   ON CHOOSE OF b-prev IN FRAME Dialog-Frame
     1664   DO:
     1665      run step-prev.
     1666   END.
     1667   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1668   DO:
     1669       next-prev = ?.
     1670       message "Выходим без сохранения изменений ?" view-as alert-box question
     1671               buttons yes-no
     1672               update ll as log
     1673               .
     1674       if ll = no then return no-apply.
     1675   END.
     1676   ON CHOOSE OF B-receiver IN FRAME Dialog-Frame
     1677   DO:
     1678      assign loc_receiver-code loc_receiver-type .
     1679      run lookup-cli (loc_receiver-code , loc_receiver-type) no-error .
     1680          if error-status :error then return no-apply.
     1681   END.
     1682   ON LEAVE OF loc_base-rate IN FRAME Dialog-Frame
     1683   OR "LEAVE" Of loc_base-scale
     1684   OR "LEAVE" Of loc_exch-rate
     1685   OR "LEAVE" Of loc_exch-scale
     1686   OR "LEAVE" Of loc_contract-rate
     1687   OR "LEAVE" Of loc_contract-scale
     1688   DO:
     1689     assign loc_base-rate loc_base-scale loc_exch-rate loc_exch-scale
     1690     loc_contract-rate
     1691     loc_contract-scale
     1692     .
     1693      if T-doc  then apply "leave" to loc_sum-doc  in frame Dialog-Frame .
     1694      if T-rubl then apply "leave" to loc_sum-rubl in frame Dialog-Frame .
     1695      if T-base then apply "leave" to loc_sum-base in frame Dialog-Frame .
     1696      if T-contract then apply "leave" to loc_sum-contract in frame Dialog-Frame .
     1697   END.
     1698   ON return OF loc_base-rate IN FRAME Dialog-Frame
     1699   DO:
     1700       run next-focus in this-procedure  (input  loc_base-rate:handle ) .
     1701     return no-apply .
     1702   END.
     1703   ON return OF loc_base-scale IN FRAME Dialog-Frame
     1704   DO:
     1705       run next-focus in this-procedure  (input  loc_base-scale:handle ) .
     1706     return no-apply .
     1707   END.
     1708   ON LEAVE OF loc_contract-code IN FRAME Dialog-Frame
     1709   DO:
     1710    define buffer buf_contract for contract.
     1711    define buffer buf_contract1 for contract.
     1712    assign
     1713       loc_contract-code
     1714    .
     1715     find  buf_contract1 where buf_contract1.contract-prn-code = loc_contract-code
     1716                               and buf_contract1.host-code         = par-host-code
     1717                               no-lock no-error .
     1718     find first buf_contract where buf_contract.contract-prn-code = loc_contract-code
     1719                               and buf_contract.host-code         = par-host-code
     1720                           no-lock no-error .
     1721     if not available buf_contract1  and available buf_contract then  do:
     1722       message "С номером "  loc_contract-code " найдено несколько договоров !!! "
     1723                view-as alert-box information .
     1724       apply "CHOOSE":U  to r-con in frame Dialog-Frame .
     1725       return.
     1726     end.
     1727     if not available buf_contract then do:
     1728        loc_contract-code = "".
     1729        loc_contract-code-id = 0.
     1730        DISPLAY loc_contract-code WITH FRAME Dialog-Frame .
     1731        message "Не верно введен Номер договора!!! "
     1732                 view-as alert-box information .
     1733        apply "CHOOSE":U  to r-con in frame Dialog-Frame.
     1734        return .
     1735     end.
     1736     ELSE DO:
     1737      loc_contract-code    = buf_contract.contract-prn-code.
     1738      loc_contract-code-id = buf_contract.contract-code.
     1739      run from-contract (
     1740               input buf_contract.contract-code ,
     1741               input buf_contract.host-code,
     1742               input 'singl-mode':u
     1743               )
     1744               no-error .
     1745               if error-status :error then return no-apply.
     1746         END.
     1747   END.
     1748   ON return OF loc_contract-code IN FRAME Dialog-Frame
     1749   DO:
     1750     run next-focus in this-procedure  (input  loc_contract-code:handle ) .
     1751     return no-apply .
     1752   END.
     1753   ON return OF loc_contract-curr IN FRAME Dialog-Frame
     1754   DO:
     1755         run next-focus in this-procedure  (input  loc_contract-curr:handle ) .
     1756     return no-apply .
     1757   END.
     1758   ON return OF loc_contract-rate IN FRAME Dialog-Frame
     1759   DO:
     1760       run next-focus in this-procedure  (input  loc_contract-rate:handle ) .
     1761     return no-apply .
     1762   END.
     1763   ON return OF loc_contract-scale IN FRAME Dialog-Frame
     1764   DO:
     1765       run next-focus in this-procedure  (input  loc_contract-scale:handle ) .
     1766     return no-apply .
     1767   END.
     1768   ON return OF loc_curr-code IN FRAME Dialog-Frame
     1769   DO:
     1770         run next-focus in this-procedure  (input  loc_curr-code:handle ) .
     1771     return no-apply .
     1772   END.
     1773   ON return OF loc_exch-rate IN FRAME Dialog-Frame
     1774   DO:
     1775       run next-focus in this-procedure  (input  loc_exch-rate:handle ) .
     1776     return no-apply .
     1777   END.
     1778   ON return OF loc_exch-scale IN FRAME Dialog-Frame
     1779   DO:
     1780       run next-focus in this-procedure  (input  loc_exch-scale:handle ) .
     1781     return no-apply .
     1782   END.
     1783   ON return OF loc_pay-date IN FRAME Dialog-Frame
     1784   DO:
     1785     run next-focus in this-procedure  (input  loc_pay-date:handle ) .
     1786     return no-apply .
     1787   END.
     1788   ON LEAVE OF loc_payer-code IN FRAME Dialog-Frame
     1789   DO:
     1790   assign loc_payer-code loc_payer-type.
     1791   def buffer b#clients for clients.
     1792    find first b#clients WHERE
     1793       b#clients.obj-code = loc_payer-code  and
     1794       b#clients.obj-type = loc_payer-type
     1795       no-lock no-error.
     1796       if avail b#clients then dO:
     1797           Assign
     1798             loc_payer-code = b#clients.obj-code
     1799             loc_payer-type = b#clients.obj-type
     1800             loc_payer-name = b#clients.obj-name
     1801             .
     1802           Display
     1803            loc_payer-code loc_payer-name loc_payer-type
     1804           with frame Dialog-Frame .
     1805           Enable
     1806            loc_payer-code  loc_payer-type
     1807           with frame Dialog-Frame .
     1808           run ver-data no-error .
     1809           if error-status :error then apply "CHOOSE" to r-obj IN FRAME Dialog-Frame        .
     1810       end.
     1811       else
     1812         apply "CHOOSE" to r-obj IN FRAME Dialog-Frame        .
     1813   END.
     1814   ON RETURN OF loc_payer-code IN FRAME Dialog-Frame
     1815   DO:
     1816       run next-focus in this-procedure  (input  loc_payer-code:handle ) .
     1817     return no-apply .
     1818   END.
     1819   ON return OF loc_prn-doc-code IN FRAME Dialog-Frame
     1820   DO:
     1821       run next-focus in this-procedure  (input  loc_prn-doc-code:handle ) .
     1822     return no-apply .
     1823   END.
     1824   ON LEAVE OF loc_receiver-code IN FRAME Dialog-Frame
     1825   DO:
     1826   assign loc_receiver-code loc_receiver-type.
     1827   def buffer b#clients for clients.
     1828    find first b#clients WHERE
     1829       b#clients.obj-code = loc_receiver-code   and
     1830       b#clients.obj-type = loc_receiver-type
     1831        no-lock no-error.
     1832    if avail b#clients then do:
     1833       Assign
     1834           loc_receiver-code = b#clients.obj-code
     1835           loc_receiver-type = b#clients.obj-type
     1836           loc_receiver-name = b#clients.obj-name
     1837           .
     1838       Display
     1839         loc_receiver-code loc_receiver-name loc_receiver-type
     1840       with frame Dialog-Frame .
     1841       Enable
     1842          loc_receiver-code
     1843       with frame Dialog-Frame .
     1844       run ver-data no-error .
     1845       if error-status :error then do:
     1846          apply "CHOOSE" to r-cli IN FRAME Dialog-Frame        .
     1847          end.
     1848   end.
     1849   else   do:
     1850     apply "CHOOSE" to r-cli IN FRAME Dialog-Frame        .
     1851   end.
     1852   END.
     1853   ON return OF loc_receiver-code IN FRAME Dialog-Frame
     1854   DO:
     1855         run next-focus in this-procedure  (input  loc_receiver-code:handle ) .
     1856     return no-apply .
     1857   END.
     1858   ON F5 OF loc_sum-base IN FRAME Dialog-Frame
     1859   DO:
     1860     loc_base-rate = loc_sum-rubl / (loc_base-scale * DECIMAL ( loc_sum-base:SCREEN-VALUE )) .
     1861     DISPLAY loc_base-rate  WITH FRAME Dialog-Frame.
     1862   END.
     1863   ON LEAVE OF loc_sum-base IN FRAME Dialog-Frame
     1864   DO:
     1865   define variable v-mod as logical no-undo .
     1866    v-mod = loc_sum-base:MODIFIED.
     1867   assign loc_sum-base loc_sum-tax-base
     1868    loc_base-rate loc_base-scale
     1869    loc_exch-rate loc_exch-scale
     1870    loc_contract-rate loc_contract-scale
     1871    .
     1872     loc_sum-rubl    = ( loc_base-rate  / loc_base-scale) * loc_sum-base .
     1873     loc_sum-doc   = (  loc_exch-scale   / loc_exch-rate) * loc_sum-rubl .
     1874     loc_sum-contract   = (  loc_contract-scale   / loc_contract-rate) * loc_sum-rubl .
     1875     if v-mod  then
     1876        run create-tax (
     1877             input loc_sum-doc ,
     1878             input loc_sum-rubl  ,
     1879             input loc_sum-base   ,
     1880             input loc_sum-contract ,
     1881             input "base":U ,
     1882             output loc_sum-tax-base) .
     1883     loc_sum-tax-rubl    = ( loc_base-rate  / loc_base-scale) * loc_sum-tax-base .
     1884     loc_sum-tax-doc   = (  loc_exch-scale   / loc_exch-rate) * loc_sum-tax-rubl .
     1885     loc_sum-tax-contract   = (  loc_contract-scale   / loc_contract-rate) * loc_sum-tax-rubl .
     1886     display
     1887       loc_sum-doc          when loc_sum-doc          :visible
     1888       loc_sum-base         when loc_sum-base         :visible
     1889       loc_sum-rubl         when loc_sum-rubl         :visible
     1890       loc_sum-contract     when loc_sum-contract     :visible
     1891       loc_sum-tax-doc      when loc_sum-tax-doc      :visible
     1892       loc_sum-tax-rubl     when loc_sum-tax-rubl     :visible
     1893       loc_sum-tax-contract when loc_sum-tax-contract :visible
     1894       loc_sum-tax-base     when loc_sum-tax-base     :visible
     1895       with frame Dialog-Frame.
     1896   END.
     1897   ON return OF loc_sum-base IN FRAME Dialog-Frame
     1898   DO:
     1899       run next-focus in this-procedure  (input  loc_sum-base:handle ) .
     1900     return no-apply .
     1901   END.
     1902   ON F5 OF loc_sum-contract IN FRAME Dialog-Frame
     1903   DO:
     1904     loc_contract-rate = loc_sum-rubl / (loc_contract-scale * DECIMAL ( loc_sum-contract:SCREEN-VALUE )) .
     1905     DISPLAY loc_contract-rate  WITH FRAME Dialog-Frame.
     1906   END.
     1907   ON LEAVE OF loc_sum-contract IN FRAME Dialog-Frame
     1908   DO:
     1909   define variable v-mod as logical no-undo .
     1910    v-mod = loc_sum-contract:MODIFIED.
     1911    assign loc_sum-contract loc_sum-tax-contract
     1912    loc_base-rate loc_base-scale
     1913    loc_exch-rate loc_exch-scale
     1914    loc_contract-rate loc_contract-scale
     1915    .
     1916     loc_sum-rubl  =  ( loc_contract-rate  / loc_contract-scale) * loc_sum-contract .
     1917     loc_sum-base   = (  loc_base-scale   / loc_base-rate) * loc_sum-rubl .
     1918     loc_sum-doc   = (  loc_exch-scale   / loc_exch-rate) * loc_sum-rubl .
     1919     if v-mod  then
     1920        run create-tax (
     1921             input loc_sum-doc   ,
     1922             input loc_sum-rubl  ,
     1923             input loc_sum-base  ,
     1924             input loc_sum-contract ,
     1925             input "contract":U ,
     1926             output loc_sum-tax-contract) .
     1927     loc_sum-tax-rubl  =  ( loc_contract-rate  / loc_contract-scale) * loc_sum-tax-contract .
     1928     loc_sum-tax-base   = (  loc_base-scale   / loc_base-rate) * loc_sum-tax-rubl .
     1929     loc_sum-tax-doc   = (  loc_exch-scale   / loc_exch-rate) * loc_sum-tax-rubl .
     1930     display
     1931     loc_sum-base           when loc_sum-base         :visible
     1932     loc_sum-rubl           when loc_sum-rubl         :visible
     1933     loc_sum-tax-base       when loc_sum-tax-base     :visible
     1934     loc_sum-tax-rubl       when loc_sum-tax-rubl     :visible
     1935     loc_sum-contract       when loc_sum-contract     :visible
     1936     loc_sum-tax-contract   when loc_sum-tax-contract :visible
     1937     loc_sum-doc            when loc_sum-doc          :visible
     1938     loc_sum-tax-doc        when loc_sum-tax-doc      :visible
     1939     loc_sum-tax-contract   when loc_sum-tax-contract :visible
     1940     with frame Dialog-Frame.
     1941    END.
     1942   ON return OF loc_sum-contract IN FRAME Dialog-Frame
     1943   DO:
     1944         run next-focus in this-procedure  (input  loc_sum-contract:handle ) .
     1945     return no-apply .
     1946   END.
     1947   ON F5 OF loc_sum-doc IN FRAME Dialog-Frame
     1948   DO:
     1949     IF loc_curr-code <> 0 THEN DO:
     1950         loc_exch-rate = loc_sum-rubl / (loc_exch-scale * DECIMAL ( loc_sum-doc:SCREEN-VALUE )) .
     1951         DISPLAY loc_exch-rate  WITH FRAME Dialog-Frame.
     1952     END.
     1953   END.
     1954   ON LEAVE OF loc_sum-doc IN FRAME Dialog-Frame
     1955   DO:
     1956   define variable v-mod as logical no-undo .
     1957    v-mod = loc_sum-doc:MODIFIED.
     1958    if v-mod = true then  assign loc_sum-doc  .
     1959     loc_sum-rubl    =  ( loc_exch-rate  / loc_exch-scale) * loc_sum-doc .
     1960     loc_sum-base    = (  loc_base-scale   / loc_base-rate) * loc_sum-rubl .
     1961     loc_sum-contract   = (  loc_contract-scale   / loc_contract-rate) * loc_sum-rubl .
     1962     if v-mod  then
     1963        run create-tax (
     1964             input loc_sum-doc ,
     1965             input loc_sum-rubl  ,
     1966             input loc_sum-base   ,
     1967             input loc_sum-contract ,
     1968             input "doc":U ,
     1969             output loc_sum-tax-doc) .
     1970     loc_sum-tax-rubl       = ( loc_exch-rate        / loc_exch-scale)    * loc_sum-tax-doc .
     1971     loc_sum-tax-base       = (  loc_base-scale      / loc_base-rate)     * loc_sum-tax-rubl .
     1972     loc_sum-tax-contract   = (  loc_contract-scale  / loc_contract-rate) * loc_sum-tax-rubl .
     1973     display
     1974         loc_sum-base          when loc_sum-base         :visible
     1975         loc_sum-rubl          when loc_sum-rubl         :visible
     1976         loc_sum-contract      when loc_sum-contract     :visible
     1977         loc_sum-tax-base      when loc_sum-tax-base     :visible
     1978         loc_sum-tax-rubl      when loc_sum-tax-rubl     :visible
     1979         loc_sum-tax-contract  when loc_sum-tax-contract :visible
     1980         loc_sum-tax-doc       when loc_sum-tax-doc      :visible
     1981         with frame Dialog-Frame
     1982         .
     1983    END.
     1984   ON return OF loc_sum-doc IN FRAME Dialog-Frame
     1985   DO:
     1986         run next-focus in this-procedure  (input  loc_sum-doc:handle ) .
     1987     return no-apply .
     1988   END.
     1989   ON LEAVE OF loc_sum-rubl IN FRAME Dialog-Frame
     1990   DO:
     1991   define variable v-mod as logical no-undo .
     1992    v-mod = loc_sum-rubl:MODIFIED.
     1993   assign loc_sum-rubl loc_sum-tax-rubl
     1994    loc_base-rate loc_base-scale
     1995    loc_exch-rate loc_exch-scale
     1996    loc_contract-rate loc_contract-scale
     1997    .
     1998     loc_sum-base    = ( loc_base-scale  / loc_base-rate) * loc_sum-rubl .
     1999     loc_sum-doc      = (  loc_exch-scale    / loc_exch-rate) * loc_sum-rubl .
     2000     loc_sum-contract      = (  loc_contract-scale    / loc_contract-rate) * loc_sum-rubl .
     2001     if v-mod  then
     2002        run create-tax (
     2003             input loc_sum-doc   ,
     2004             input loc_sum-rubl  ,
     2005             input loc_sum-base  ,
     2006             input loc_sum-contract ,
     2007             input "rubl":U ,
     2008             output loc_sum-tax-rubl) .
     2009     loc_sum-tax-base     = ( loc_base-scale  / loc_base-rate) * loc_sum-tax-rubl .
     2010     loc_sum-tax-doc      = (  loc_exch-scale    / loc_exch-rate) * loc_sum-tax-rubl .
     2011     loc_sum-tax-contract = (  loc_contract-scale    / loc_contract-rate) * loc_sum-tax-rubl .
     2012     display
     2013     loc_sum-base            when loc_sum-base         :visible
     2014     loc_sum-doc             when loc_sum-doc          :visible
     2015     loc_sum-tax-base        when loc_sum-tax-base     :visible
     2016     loc_sum-tax-doc         when loc_sum-tax-doc      :visible
     2017     loc_sum-contract        when loc_sum-contract     :visible
     2018     loc_sum-tax-contract    when loc_sum-tax-contract :visible
     2019     loc_sum-tax-rubl        when loc_sum-tax-rubl     :visible
     2020     with frame Dialog-Frame.
     2021   END.
     2022   ON return OF loc_sum-rubl IN FRAME Dialog-Frame
     2023   DO:
     2024       run next-focus in this-procedure  (input  loc_sum-rubl:handle ) .
     2025     return no-apply .
     2026   END.
     2027   ON return OF p-doc-code IN FRAME Dialog-Frame
     2028   DO:
     2029       run next-focus in this-procedure  (input  p-doc-code:handle ) .
     2030     return no-apply .
     2031   END.
     2032   ON CHOOSE OF r-cli IN FRAME Dialog-Frame
     2033   DO:
     2034       if radio-set-dogovor = true and loc_contract-code-id <> 0 then do:
     2035          run from-contract (
     2036              loc_contract-code-id ,
     2037              par-host-code ,
     2038              'trio-mode':u
     2039               ).
     2040       end.
     2041       else do:
     2042             define variable rid-list    as  char no-undo .
     2043             define variable rep-rec2 as recid no-undo .
     2044             def buffer b#clients for clients.
     2045             run ref/cli-all.w ( parParentProc, input "b-sel", 'орг':U, ?, ?, ?, ?, ?, output  rid-list).
     2046             Assign rep-rec2 = integer(rid-list) no-error.
     2047             find first b#clients WHERE recid(b#clients) = rep-rec2 No-LOCK No-ERROR.
     2048             if avail b#clients then do:
     2049                 Assign
     2050                     loc_receiver-code = b#clients.obj-code
     2051                     loc_receiver-type = b#clients.obj-type
     2052                     loc_receiver-name = b#clients.obj-name .
     2053             end.
     2054       end.
     2055       Display  loc_receiver-code loc_receiver-name loc_receiver-type
     2056       with frame Dialog-Frame .
     2057       Enable  loc_receiver-code
     2058       with frame Dialog-Frame .
     2059   END.
     2060   ON CHOOSE OF r-con IN FRAME Dialog-Frame
     2061   DO:
     2062   define variable   p-rid-list   as character no-undo .
     2063   define buffer buf_contract for contract.
     2064     run str/cont-all.w (
     2065         input   parParentProc   ,
     2066         input   par-host-code   ,
     2067         input   "b-sel"         ,
     2068         input   'фирма':U      ,
     2069         input   ?               ,
     2070         input   ?               ,
     2071         input   ?               ,
     2072         input   ?               ,
     2073         input   "current"       ,
     2074         input   (if p-doc-type = 'при':U then 'рас':U  else 'при':U  )  ,
     2075         input-output p-rid-list )
     2076         .
     2077   find first buf_contract no-lock where recid(buf_contract) = integer(p-rid-list) no-error .
     2078   if available buf_contract then do:
     2079      loc_contract-code = buf_contract.contract-prn-code.
     2080      loc_contract-code-id = buf_contract.contract-code.
     2081      display loc_contract-code with frame Dialog-Frame.
     2082            run from-contract (
     2083                 input buf_contract.contract-code ,
     2084                 input buf_contract.host-code,
     2085                 input 'singl-mode':u
     2086                 ) no-error .
     2087       if error-status :error then do:
     2088           if error-status :get-message(1) <> "" then    message error-status :get-message(1) return-value 'from-contract' .
     2089           return no-apply.
     2090       end.
     2091   run next-focus in this-procedure  (input loc_contract-code:handle ) .
     2092   end.
     2093   END.
     2094   ON CHOOSE OF r-cur IN FRAME Dialog-Frame
     2095   DO:
     2096   define variable ref-rec as recid no-undo.
     2097   run ref/currency.w (input  parparentproc , "b-sel", input-output ref-rec ).
     2098   if ref-rec = ? then return no-apply.
     2099   find currency where recid ( currency ) = ref-rec no-lock.
     2100   IF NOT (currency.curr-code = loc_contract-curr   OR
     2101      currency.curr-code = p-basecode        OR
     2102      currency.curr-code = 0 )
     2103       THEN DO:
     2104       MESSAGE "Можно выбрать только национальную валюту, базовую валюту или валюту договора !!! ".
     2105       RETURN NO-APPLY.
     2106   END.
     2107   loc_curr-code  = currency.curr-code .
     2108   loc_abbr-doc   = currency.curr-abbr .
     2109   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2110   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     2111     (input  loc_curr-code
     2112     ,input  loc_doc-date
     2113     ,output loc_exch-rate
     2114     ,output loc_exch-scale
     2115     ,output loc_abbr-doc
     2116     )  .
     2117   display
     2118     loc_curr-code
     2119     loc_abbr-doc
     2120     loc_exch-rate
     2121     loc_exch-scale
     2122     with frame Dialog-Frame .
     2123    apply "LEAVE" to loc_exch-rate  in frame Dialog-Frame .
     2124    run hide-curr ( input "pay":U ) .
     2125   END.
     2126   ON CHOOSE OF r-obj IN FRAME Dialog-Frame
     2127   DO:
     2128       if radio-set-dogovor = true and loc_contract-code-id <> 0 then do:
     2129          run from-contract (
     2130              loc_contract-code-id ,
     2131              par-host-code ,
     2132              'trio-mode':u
     2133               ).
     2134       end.
     2135     else do:
     2136     define variable rid-list    as  char no-undo .
     2137     define variable rep-rec2 as recid no-undo .
     2138     def buffer b#clients for clients.
     2139       run ref/cli-all.w ( parParentProc, input "b-sel", 'орг':U, ?, ?, ?, ?, ?, output  rid-list).
     2140       Assign rep-rec2 = integer(rid-list) no-error.
     2141       find first b#clients WHERE recid(b#clients) = rep-rec2 No-LOCK No-ERROR.
     2142       if avail b#clients then do:
     2143           Assign
     2144               loc_payer-code = b#clients.obj-code
     2145               loc_payer-type = b#clients.obj-type
     2146               loc_payer-name = b#clients.obj-name .
     2147       end.
     2148    end.
     2149       Display  loc_payer-code loc_payer-name loc_payer-type
     2150       with frame Dialog-Frame .
     2151       Enable  loc_payer-code   with frame Dialog-Frame .
     2152   END.
     2153   ON CHOOSE OF r-obj-firm IN FRAME Dialog-Frame
     2154   DO:
     2155   define buffer b#clients for clients.
     2156   define variable v-type as char no-undo.
     2157   define variable v-code as int no-undo.
     2158         run str/chshobj.w (par-host-code, "", 0, output v-type,OUTPUT v-code).
     2159         find first b#clients WHERE
     2160             v-code = b#clients.obj-code AND
     2161             v-type = b#clients.obj-type
     2162             No-LOCK No-ERROR.
     2163         if avail b#clients then do:
     2164             Assign
     2165                 fi-obj-code = b#clients.obj-code
     2166                 fi-obj-type = b#clients.obj-type
     2167                 fi-obj-name = b#clients.obj-name .
     2168         end.
     2169         Display   fi-obj-code  fi-obj-name  fi-obj-type
     2170         with frame Dialog-Frame .
     2171   END.
     2172   ON return OF RADIO-SET-dogovor IN FRAME Dialog-Frame
     2173   DO:
     2174       run next-focus in this-procedure  (input  RADIO-SET-dogovor:handle ) .
     2175       return no-apply .
     2176   END.
     2177   ON VALUE-CHANGED OF RADIO-SET-dogovor IN FRAME Dialog-Frame
     2178   DO:
     2179       ASSIGN radio-set-dogovor.
     2180       IF  radio-set-dogovor = NO THEN DO:
     2181           DISABLE
     2182               B-contract loc_abbr-contract loc_contract-code loc_contract-curr loc_contract-rate loc_contract-scale r-con  T-contract
     2183               WITH FRAME Dialog-Frame.
     2184               loc_contract-code = ""  .
     2185               loc_contract-code-id = 0 .
     2186               DISPLAY loc_contract-code WITH FRAME Dialog-Frame.
     2187       END.
     2188       ELSE DO:
     2189           enable
     2190               B-contract loc_contract-code r-con
     2191               WITH FRAME Dialog-Frame.
     2192       END.
     2193   END.
     2194   ON VALUE-CHANGED OF T-base IN FRAME Dialog-Frame
     2195   DO:
     2196    assign t-base.
     2197     if t-base = yes then do:
     2198         enable
     2199           loc_sum-base
     2200           with frame Dialog-Frame.
     2201         disable
     2202           loc_sum-rubl     loc_sum-doc      loc_sum-contract
     2203           with frame Dialog-Frame.
     2204         t-rubl = no.
     2205         t-doc = no.
     2206         t-contract = no.
     2207         display
     2208             t-rubl      when t-rubl:visible
     2209             t-doc
     2210             t-contract  when t-contract:visible
     2211             with frame  Dialog-Frame.
     2212       end.
     2213           else do:
     2214            t-base = yes.
     2215            display t-base with frame  Dialog-Frame.
     2216            end.
     2217   loc_in-type            = 1.
     2218   END.
     2219   ON VALUE-CHANGED OF T-contract IN FRAME Dialog-Frame
     2220   DO:
     2221     assign t-contract.
     2222     if t-contract = yes then do:
     2223         enable
     2224            loc_sum-contract
     2225            with frame Dialog-Frame.
     2226         disable
     2227            loc_sum-rubl     loc_sum-base     loc_sum-doc
     2228            with frame Dialog-Frame.
     2229         t-rubl = no.
     2230         t-base = no.
     2231         t-doc = no.
     2232         display
     2233            t-rubl   when t-rubl:visible
     2234            t-base   when t-base:visible
     2235            t-doc
     2236            with frame  Dialog-Frame.
     2237       end.
     2238       else do:
     2239            t-contract = yes.
     2240            display t-contract with frame  Dialog-Frame.
     2241            end.
     2242     loc_in-type = 3.
     2243   END.
     2244   ON VALUE-CHANGED OF T-doc IN FRAME Dialog-Frame
     2245   DO:
     2246     assign t-doc.
     2247     if t-doc = yes then do:
     2248         enable
     2249            loc_sum-doc
     2250            with frame Dialog-Frame.
     2251         disable
     2252            loc_sum-rubl     loc_sum-base     loc_sum-contract
     2253            with frame Dialog-Frame.
     2254         t-rubl = no.
     2255         t-base = no.
     2256         t-contract = no.
     2257         display
     2258            t-rubl  when t-rubl:visible
     2259            t-base  when t-base:visible
     2260            t-contract  when t-contract:visible
     2261            with frame  Dialog-Frame.
     2262       end.
     2263       else do:
     2264            t-doc = yes.
     2265            display t-doc with frame  Dialog-Frame.
     2266            end.
     2267     loc_in-type = 0.
     2268   END.
     2269   ON VALUE-CHANGED OF T-rubl IN FRAME Dialog-Frame
     2270   DO:
     2271     assign t-rubl.
     2272     if t-rubl = yes then do:
     2273         enable
     2274            loc_sum-rubl
     2275            with frame Dialog-Frame.
     2276         disable
     2277           loc_sum-doc     loc_sum-base     loc_sum-contract
     2278           with frame Dialog-Frame.
     2279         t-doc = no.
     2280         t-base = no.
     2281         t-contract = no.
     2282         display
     2283         t-doc
     2284         t-base      when t-base:visible
     2285         t-contract  when t-contract:visible
     2286         with frame  Dialog-Frame.
     2287       end.
     2288       else do:
     2289            t-rubl = yes.
     2290            display t-rubl with frame  Dialog-Frame.
     2291            end.
     2292     loc_in-type            = 2.
     2293   END.
     2294   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2295   define buffer buf_file for ub.fin-ob .
     2296   procedure current-db :
     2297    do
     2298    on error undo, return error return-value
     2299    :
     2300   define input parameter  p-host-code as integer no-undo .
     2301   define input parameter  c-host-code as integer no-undo .
     2302   define output parameter ret         as logical no-undo .
     2303   define buffer current_sysconf for ub.sysconf.
     2304   define variable v-current-db as integer no-undo .
     2305   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
     2306   if error-status :error then return error .
     2307      v-current-db = current_sysconf.firm-db-num .
     2308      ret = true .
     2309   find first ub.sysconf where ub.sysconf.host-code = p-host-code no-lock no-error .
     2310   if not( ub.sysconf.firm-db-num = v-current-db or
     2311           ub.sysconf.firm-db-num = 0 )
     2312     then do:
     2313     ret = false .
     2314     message "Нельзя добавлять запись в  справочнике  для фирмы с не главной БД !!!" view-as alert-box information .
     2315     return .
     2316   end.
     2317    end.
     2318   end procedure.
     2319   procedure ver-db :
     2320    do
     2321    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2322    :
     2323   define input parameter  c-host-code as integer no-undo .
     2324   define input parameter  par-ver-db  as integer no-undo .
     2325   define input parameter  p-mess as logical no-undo .
     2326   define output parameter ret         as logical no-undo .
     2327   define buffer current_sysconf for ub.sysconf.
     2328   define variable v-current-db as integer no-undo .
     2329   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
     2330   if error-status :error then return error .
     2331      v-current-db = current_sysconf.firm-db-num .
     2332      ret = true .
     2333   if not( par-ver-db = v-current-db or
     2334           par-ver-db = 0 )
     2335     then do:
     2336     ret = false .
     2337     if p-mess = true then message "База , на которой мы работаем не является главной базой данных текущей фирмы!!!" view-as alert-box information .
     2338     return .
     2339   end.
     2340    end.
     2341   end procedure.
     2342   procedure fin-ob-code :
     2343    do
     2344    on error undo, return error return-value
     2345    :
     2346     define input  parameter p-db-num as integer no-undo .
     2347     define output parameter p-fin-ob-code  as character no-undo .
     2348     if p-db-num = 0 then
     2349         p-fin-ob-code = string( next-value(s-fin-ob, ub)) .
     2350         else
     2351         p-fin-ob-code = string( next-value(s-fin-ob, ub)) + "-" + string(p-db-num).
     2352    end.
     2353   end procedure.
     2354   procedure create-fin-liab :
     2355    do
     2356    on error undo, return error return-value
     2357    :
     2358   define input parameter p-ver as logical no-undo .
     2359   define input parameter p-doc-code            like ub.fin-ob.doc-code             no-undo .
     2360   define input parameter p-doc-date            like ub.fin-ob.doc-date             no-undo .
     2361   define input parameter p-doc-type            like ub.fin-ob.doc-type             no-undo .
     2362   define input parameter p-payer-name            like ub.fin-ob.payer-name             no-undo .
     2363   define input parameter p-receiver-name            like ub.fin-ob.receiver-name             no-undo .
     2364   define input parameter p-curr-code           like ub.fin-ob.curr-code            no-undo .
     2365   define input parameter p-sum-doc             like ub.fin-ob.sum-doc              no-undo .
     2366   define input parameter p-user-db-num-doc     like ub.fin-ob.user-db-num-doc      no-undo .
     2367   define input parameter p-user-name-doc       like ub.fin-ob.user-name-doc        no-undo .
     2368   define input parameter p-base-rate           like ub.fin-ob.base-rate            no-undo .
     2369   define input parameter p-base-scale          like ub.fin-ob.base-scale           no-undo .
     2370   define input parameter p-receiver-code            like ub.fin-ob.receiver-code             no-undo .
     2371   define input parameter p-receiver-type            like ub.fin-ob.receiver-type             no-undo .
     2372   define input parameter p-contract-code       like ub.fin-ob.contract-code        no-undo .
     2373   define input parameter p-exch-rate           like ub.fin-ob.exch-rate            no-undo .
     2374   define input parameter p-exch-scale          like ub.fin-ob.exch-scale           no-undo .
     2375   define input parameter p-contract-curr           like ub.fin-ob.contract-curr            no-undo .
     2376   define input parameter p-contract-rate           like ub.fin-ob.contract-rate            no-undo .
     2377   define input parameter p-contract-scale          like ub.fin-ob.contract-scale           no-undo .
     2378   define input parameter p-fact-date           like ub.fin-ob.fact-date            no-undo .
     2379   define input parameter p-fact-order          like ub.fin-ob.fact-order           no-undo .
     2380   define input parameter p-host-code           like ub.fin-ob.host-code            no-undo .
     2381   define input parameter p-payer-code          like ub.fin-ob.payer-code           no-undo .
     2382   define input parameter p-payer-type          like ub.fin-ob.payer-type           no-undo .
     2383   define input parameter p-pay-date            like ub.fin-ob.pay-date             no-undo .
     2384   define input parameter p-prn-doc-code        like ub.fin-ob.prn-doc-code         no-undo .
     2385   define input parameter p-status_             like ub.fin-ob.status_              no-undo .
     2386   define input parameter p-sum-base-orig       like ub.fin-ob.sum-base-orig        no-undo .
     2387   define input parameter p-sum-base            like ub.fin-ob.sum-base             no-undo .
     2388   define input parameter p-sum-doc-orig        like ub.fin-ob.sum-doc-orig         no-undo .
     2389   define input parameter p-sum-rubl-orig       like ub.fin-ob.sum-rubl-orig        no-undo .
     2390   define input parameter p-sum-rubl            like ub.fin-ob.sum-rubl             no-undo .
     2391   define input parameter p-sum-contract        like ub.fin-ob.sum-contract         no-undo .
     2392   define input parameter p-trn-doc-code        like ub.fin-ob.trn-doc-code         no-undo .
     2393   define input parameter p-user-db-num-fact    like ub.fin-ob.user-db-num-fact     no-undo .
     2394   define input parameter p-user-db-num-pay     like ub.fin-ob.user-db-num-pay     no-undo .
     2395   define input parameter p-user-name-fact      like ub.fin-ob.user-name-fact       no-undo .
     2396   define input parameter p-user-name-pay       like ub.fin-ob.user-name-pay       no-undo .
     2397   define input parameter p-in-type             like ub.fin-ob.in-type              no-undo .
     2398   define input parameter p-sum-tax-base         like ub.fin-ob.sum-tax-base     no-undo .
     2399   define input parameter p-sum-tax-doc          like ub.fin-ob.sum-tax-doc      no-undo .
     2400   define input parameter p-sum-tax-rubl         like ub.fin-ob.sum-tax-rubl     no-undo .
     2401   define input parameter p-sum-tax-contract     like ub.fin-ob.sum-tax-contract no-undo .
     2402   define input parameter p-ps                   like ub.fin-ob.ps               no-undo .
     2403   define output parameter p-rec-id as recid no-undo .
     2404   if p-ver then do:
     2405       find first  buf_file no-lock  where buf_file.host-code = p-host-code and
     2406                                           buf_file.doc-code  = p-doc-code no-error .
     2407       if available buf_file then return error .
     2408   end.
     2409   define variable p-ret as logical no-undo .
     2410   run current-db in this-procedure (
     2411       input p-host-code,
     2412       input p-host-code,
     2413       output p-ret ) .
     2414    if p-ret = no then return.
     2415   p-rec-id = ? .
     2416    create ub.fin-ob.
     2417    assign
     2418      ub.fin-ob.host-code     =     p-host-code
     2419      ub.fin-ob.doc-code      =     p-doc-code
     2420      ub.fin-ob.status_       =     p-status_
     2421      ub.fin-ob.doc-date      =     p-doc-date
     2422      ub.fin-ob.doc-type      =     p-doc-type
     2423      ub.fin-ob.payer-name    =     p-payer-name
     2424      ub.fin-ob.receiver-name =     p-receiver-name
     2425      ub.fin-ob.curr-code     =     p-curr-code
     2426      ub.fin-ob.user-db-num-doc =   p-user-db-num-doc
     2427      ub.fin-ob.user-name-doc   =   p-user-name-doc
     2428      ub.fin-ob.base-rate     =     p-base-rate
     2429      ub.fin-ob.base-scale    =     p-base-scale
     2430      ub.fin-ob.receiver-code =     p-receiver-code
     2431      ub.fin-ob.receiver-type =     p-receiver-type
     2432      ub.fin-ob.contract-code =     p-contract-code
     2433      ub.fin-ob.exch-rate     =     p-exch-rate
     2434      ub.fin-ob.exch-scale    =     p-exch-scale
     2435      ub.fin-ob.contract-curr =     p-contract-curr
     2436      ub.fin-ob.contract-rate =     p-contract-rate
     2437      ub.fin-ob.contract-scale =    p-contract-scale
     2438      ub.fin-ob.fact-date     =     p-fact-date
     2439      ub.fin-ob.fact-order    =     p-fact-order
     2440      ub.fin-ob.host-code     =     p-host-code
     2441      ub.fin-ob.payer-code    =     p-payer-code
     2442      ub.fin-ob.payer-type    =     p-payer-type
     2443      ub.fin-ob.pay-date      =     p-pay-date
     2444      ub.fin-ob.prn-doc-code  =     p-prn-doc-code
     2445      ub.fin-ob.status_       =     p-status_
     2446      ub.fin-ob.sum-doc       =     p-sum-doc
     2447      ub.fin-ob.sum-base      =     p-sum-base
     2448      ub.fin-ob.sum-contract  =     p-sum-contract
     2449      ub.fin-ob.sum-rubl      =     p-sum-rubl
     2450      ub.fin-ob.sum-tax-doc   =     p-sum-tax-doc
     2451      ub.fin-ob.sum-tax-base  =     p-sum-tax-base
     2452      ub.fin-ob.sum-tax-contract =  p-sum-tax-contract
     2453      ub.fin-ob.sum-tax-rubl  =     p-sum-tax-rubl
     2454      ub.fin-ob.sum-doc-orig  =     p-sum-doc-orig
     2455      ub.fin-ob.sum-rubl-orig =     p-sum-rubl-orig
     2456      ub.fin-ob.sum-base-orig =     p-sum-base-orig
     2457      ub.fin-ob.trn-doc-code  =     p-trn-doc-code
     2458      ub.fin-ob.user-db-num-fact =  p-user-db-num-fact
     2459      ub.fin-ob.user-db-num-pay  =  p-user-db-num-pay
     2460      ub.fin-ob.user-name-fact   =  p-user-name-fact
     2461      ub.fin-ob.user-name-pay    =  p-user-name-pay
     2462      ub.fin-ob.in-type          =  p-in-type
     2463      ub.fin-ob.ps               =  p-PS
     2464     no-error .
     2465     if error-status :error then do:
     2466         message vss-include-info6 skip
     2467                 error-status :get-message(1)
     2468                 view-as alert-box error .
     2469         return error .
     2470     end.
     2471     if ub.fin-ob.status_ = 'факт':U then
     2472       run str/calc-bal.p (input "finob", input yes, input ub.fin-ob.doc-type, input ub.fin-ob.host-code, input ub.fin-ob.contract-code, input ub.fin-ob.sum-contract, input ub.fin-ob.sum-rubl, input ub.fin-ob.sum-base) .
     2473     p-rec-id = recid(fin-ob) .
     2474    end.
     2475   end procedure.
     2476   procedure create-fin-ob-before :
     2477    do
     2478    on error undo, return error return-value
     2479    :
     2480   define input parameter p-ver as logical no-undo .
     2481   define input parameter p-doc-id              like ub.fin-ob-before.before-code             no-undo .
     2482   define input parameter p-doc-code            like ub.fin-ob.doc-code             no-undo .
     2483   define input parameter p-doc-date            like ub.fin-ob.doc-date             no-undo .
     2484   define input parameter p-doc-type            like ub.fin-ob.doc-type             no-undo .
     2485   define input parameter p-payer-name            like ub.fin-ob.payer-name             no-undo .
     2486   define input parameter p-receiver-name            like ub.fin-ob.receiver-name             no-undo .
     2487   define input parameter p-curr-code           like ub.fin-ob.curr-code            no-undo .
     2488   define input parameter p-sum-doc             like ub.fin-ob.sum-doc              no-undo .
     2489   define input parameter p-user-db-num-doc     like ub.fin-ob.user-db-num-doc      no-undo .
     2490   define input parameter p-user-name-doc       like ub.fin-ob.user-name-doc        no-undo .
     2491   define input parameter p-base-rate           like ub.fin-ob.base-rate            no-undo .
     2492   define input parameter p-base-scale          like ub.fin-ob.base-scale           no-undo .
     2493   define input parameter p-receiver-code            like ub.fin-ob.receiver-code             no-undo .
     2494   define input parameter p-receiver-type            like ub.fin-ob.receiver-type             no-undo .
     2495   define input parameter p-contract-code       like ub.fin-ob.contract-code        no-undo .
     2496   define input parameter p-exch-rate           like ub.fin-ob.exch-rate            no-undo .
     2497   define input parameter p-exch-scale          like ub.fin-ob.exch-scale           no-undo .
     2498   define input parameter p-contract-curr           like ub.fin-ob.contract-curr            no-undo .
     2499   define input parameter p-contract-rate           like ub.fin-ob.contract-rate            no-undo .
     2500   define input parameter p-contract-scale          like ub.fin-ob.contract-scale           no-undo .
     2501   define input parameter p-fact-date           like ub.fin-ob.fact-date            no-undo .
     2502   define input parameter p-fact-order          like ub.fin-ob.fact-order           no-undo .
     2503   define input parameter p-host-code           like ub.fin-ob.host-code            no-undo .
     2504   define input parameter p-payer-code          like ub.fin-ob.payer-code           no-undo .
     2505   define input parameter p-payer-type          like ub.fin-ob.payer-type           no-undo .
     2506   define input parameter p-pay-date            like ub.fin-ob.pay-date             no-undo .
     2507   define input parameter p-prn-doc-code        like ub.fin-ob.prn-doc-code         no-undo .
     2508   define input parameter p-status_             like ub.fin-ob.status_              no-undo .
     2509   define input parameter p-sum-base-orig       like ub.fin-ob.sum-base-orig        no-undo .
     2510   define input parameter p-sum-base            like ub.fin-ob.sum-base             no-undo .
     2511   define input parameter p-sum-doc-orig        like ub.fin-ob.sum-doc-orig         no-undo .
     2512   define input parameter p-sum-rubl-orig       like ub.fin-ob.sum-rubl-orig        no-undo .
     2513   define input parameter p-sum-rubl            like ub.fin-ob.sum-rubl             no-undo .
     2514   define input parameter p-sum-contract        like ub.fin-ob.sum-contract         no-undo .
     2515   define input parameter p-trn-doc-code        like ub.fin-ob.trn-doc-code         no-undo .
     2516   define input parameter p-trn-doc-code-orig   like ub.fin-ob.trn-doc-code         no-undo .
     2517   define input parameter p-user-db-num-fact    like ub.fin-ob.user-db-num-fact     no-undo .
     2518   define input parameter p-user-db-num-pay     like ub.fin-ob.user-db-num-pay     no-undo .
     2519   define input parameter p-user-name-fact      like ub.fin-ob.user-name-fact       no-undo .
     2520   define input parameter p-user-name-pay       like ub.fin-ob.user-name-pay       no-undo .
     2521   define input parameter p-in-type             like ub.fin-ob.in-type              no-undo .
     2522   define input parameter p-sum-tax-base         like ub.fin-ob.sum-tax-base     no-undo .
     2523   define input parameter p-sum-tax-doc          like ub.fin-ob.sum-tax-doc      no-undo .
     2524   define input parameter p-sum-tax-rubl         like ub.fin-ob.sum-tax-rubl     no-undo .
     2525   define input parameter p-sum-tax-contract     like ub.fin-ob.sum-tax-contract no-undo .
     2526   define input parameter p-ps                   like ub.fin-ob.ps               no-undo .
     2527   define output parameter p-rec-id as recid no-undo .
     2528   define buffer buf_file for ub.fin-ob-before .
     2529   if p-ver then do:
     2530       find first  buf_file no-lock  where buf_file.host-code = p-host-code and
     2531                                           buf_file.doc-code  = p-doc-code  and
     2532                                           buf_file.before-code =  p-doc-id
     2533                                           no-error .
     2534       if available buf_file then return error .
     2535   end.
     2536   define variable p-ret as logical no-undo .
     2537   run current-db in this-procedure  (
     2538       input p-host-code,
     2539       input p-host-code,
     2540       output p-ret ) .
     2541    if p-ret = no then return.
     2542   p-rec-id = ? .
     2543    create ub.fin-ob-before.
     2544    assign
     2545      ub.fin-ob-before.before-code   =  p-doc-id
     2546      ub.fin-ob-before.host-code     =     p-host-code
     2547      ub.fin-ob-before.doc-code      =     p-doc-code
     2548      ub.fin-ob-before.status_       =     p-status_
     2549      ub.fin-ob-before.doc-date      =     p-doc-date
     2550      ub.fin-ob-before.doc-type      =     p-doc-type
     2551      ub.fin-ob-before.payer-name    =     p-payer-name
     2552      ub.fin-ob-before.receiver-name =     p-receiver-name
     2553      ub.fin-ob-before.curr-code     =     p-curr-code
     2554      ub.fin-ob-before.user-db-num-doc =   p-user-db-num-doc
     2555      ub.fin-ob-before.user-name-doc   =   p-user-name-doc
     2556      ub.fin-ob-before.base-rate     =     p-base-rate
     2557      ub.fin-ob-before.base-scale    =     p-base-scale
     2558      ub.fin-ob-before.receiver-code =     p-receiver-code
     2559      ub.fin-ob-before.receiver-type =     p-receiver-type
     2560      ub.fin-ob-before.contract-code =     p-contract-code
     2561      ub.fin-ob-before.exch-rate     =     p-exch-rate
     2562      ub.fin-ob-before.exch-scale    =     p-exch-scale
     2563      ub.fin-ob-before.contract-curr =     p-contract-curr
     2564      ub.fin-ob-before.contract-rate =     p-contract-rate
     2565      ub.fin-ob-before.contract-scale =    p-contract-scale
     2566      ub.fin-ob-before.fact-date     =     p-fact-date
     2567      ub.fin-ob-before.fact-order    =     p-fact-order
     2568      ub.fin-ob-before.host-code     =     p-host-code
     2569      ub.fin-ob-before.payer-code    =     p-payer-code
     2570      ub.fin-ob-before.payer-type    =     p-payer-type
     2571      ub.fin-ob-before.pay-date      =     p-pay-date
     2572      ub.fin-ob-before.prn-doc-code  =     p-prn-doc-code
     2573      ub.fin-ob-before.status_       =     p-status_
     2574      ub.fin-ob-before.sum-doc       =     p-sum-doc
     2575      ub.fin-ob-before.sum-base      =     p-sum-base
     2576      ub.fin-ob-before.sum-contract  =     p-sum-contract
     2577      ub.fin-ob-before.sum-rubl      =     p-sum-rubl
     2578      ub.fin-ob-before.sum-tax-doc   =     p-sum-tax-doc
     2579      ub.fin-ob-before.sum-tax-base  =     p-sum-tax-base
     2580      ub.fin-ob-before.sum-tax-contract =  p-sum-tax-contract
     2581      ub.fin-ob-before.sum-tax-rubl  =     p-sum-tax-rubl
     2582      ub.fin-ob-before.sum-doc-orig  =     p-sum-doc-orig
     2583      ub.fin-ob-before.sum-rubl-orig =     p-sum-rubl-orig
     2584      ub.fin-ob-before.sum-base-orig =     p-sum-base-orig
     2585      ub.fin-ob-before.trn-doc-code  =     p-trn-doc-code
     2586      ub.fin-ob-before.trn-doc-code-orig  =     p-trn-doc-code-orig
     2587      ub.fin-ob-before.user-db-num-fact =  p-user-db-num-fact
     2588      ub.fin-ob-before.user-db-num-pay  =  p-user-db-num-pay
     2589      ub.fin-ob-before.user-name-fact   =  p-user-name-fact
     2590      ub.fin-ob-before.user-name-pay    =  p-user-name-pay
     2591      ub.fin-ob-before.in-type          =  p-in-type
     2592      ub.fin-ob-before.ps               =  p-ps
     2593     no-error .
     2594     if error-status :error then do:
     2595         message vss-include-info6 skip
     2596                 error-status :get-message(1)
     2597                 view-as alert-box error .
     2598         return error .
     2599     end.
     2600     p-rec-id = recid(fin-ob-before) .
     2601    end.
     2602   end procedure.
     2603   procedure make-tax :
     2604    do
     2605    on error undo, return error return-value
     2606    :
     2607   define input parameter p-doc-code  like ub.fin-ob.doc-code no-undo .
     2608   define input parameter p-host-code as integer no-undo .
     2609   define buffer buf_fin-gds-part for  ub.fin-gds-part .
     2610   define buffer buf_fin-ob-tax   for  ub.fin-ob-tax .
     2611   define buffer buf_fin-ob       for  ub.fin-ob     .
     2612   define variable v-line              as integer no-undo .
     2613   define variable v-sum               as decimal no-undo .
     2614   define variable v-sum-rubl          as decimal no-undo .
     2615   define variable v-sum-base          as decimal no-undo .
     2616   define variable v-sum-contract      as decimal no-undo .
     2617   define variable v-sum-slt           as decimal no-undo .
     2618   define variable v-sum-rubl-slt      as decimal no-undo .
     2619   define variable v-sum-base-slt      as decimal no-undo .
     2620   define variable v-sum-contract-slt  as decimal no-undo .
     2621   define variable v-sum-vat           as decimal no-undo .
     2622   define variable v-sum-rubl-vat      as decimal no-undo .
     2623   define variable v-sum-base-vat      as decimal no-undo .
     2624   define variable v-sum-contract-vat  as decimal no-undo .
     2625   define variable v-tax-sum           as decimal no-undo .
     2626   define variable v-tax-sum-rubl      as decimal no-undo .
     2627   define variable v-tax-sum-base      as decimal no-undo .
     2628   define variable v-tax-sum-contr     as decimal no-undo .
     2629   define variable v-tax-sum-doc       as decimal no-undo .
     2630   define variable var-doc             as decimal no-undo .
     2631   define variable var-doc-slt         as decimal no-undo .
     2632   define variable var-doc-vat         as decimal no-undo .
     2633   define variable v-basecode as integer no-undo .
     2634   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2635   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2636     (input  p-host-code
     2637     ,output v-basecode
     2638     )  .
     2639   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
     2640                                               buf_fin-ob.doc-code  = p-doc-code
     2641                                               on error undo, return error :
     2642      assign
     2643       v-tax-sum-rubl  = 0
     2644       v-tax-sum-base  = 0
     2645       v-tax-sum-contr = 0
     2646       v-tax-sum-doc   = 0
     2647       v-sum           = 0
     2648       v-sum-rubl      = 0
     2649       v-sum-base      = 0
     2650       v-sum-contract  = 0
     2651       v-sum-vat       = 0
     2652       v-sum-rubl-vat  = 0
     2653       v-sum-base-vat  = 0
     2654       v-sum-contract-vat  = 0
     2655       v-sum-slt           = 0
     2656       v-sum-rubl-slt      = 0
     2657       v-sum-base-slt      = 0
     2658       v-sum-contract-slt  = 0
     2659       v-line = 0
     2660       .
     2661       for each buf_fin-gds-part no-lock where
     2662                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
     2663                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
     2664                break  by buf_fin-gds-part.SLT-pc
     2665                       by buf_fin-gds-part.vat-pc
     2666                on error undo, return error :
     2667                 case buf_fin-ob.curr-code:
     2668                   when 0 then do :
     2669                   assign
     2670                   var-doc      =  buf_fin-gds-part.sum-rubl
     2671                   var-doc-slt  =  buf_fin-gds-part.slt-rubl
     2672                   var-doc-vat  =  buf_fin-gds-part.vat-rubl
     2673                   .
     2674                   end.
     2675                   when v-basecode then do :
     2676                   assign
     2677                   var-doc      =  buf_fin-gds-part.sum-base
     2678                   var-doc-slt  =  buf_fin-gds-part.slt-base
     2679                   var-doc-vat  =  buf_fin-gds-part.vat-base
     2680                   .
     2681                   end.
     2682                   when buf_fin-ob.contract-curr then do :
     2683                   assign
     2684                   var-doc      =  buf_fin-gds-part.sum-contract
     2685                   var-doc-slt  =  buf_fin-gds-part.slt-contract
     2686                   var-doc-vat  =  buf_fin-gds-part.vat-contract
     2687                   .
     2688                   end.
     2689                 end case.
     2690                assign
     2691                  v-sum           = v-sum          + var-doc
     2692                  v-sum-rubl      = v-sum-rubl     + buf_fin-gds-part.sum-rubl
     2693                  v-sum-base      = v-sum-base     + buf_fin-gds-part.sum-base
     2694                  v-sum-contract  = v-sum-contract + buf_fin-gds-part.sum-contract
     2695                  v-sum-slt           = v-sum-slt          + var-doc-slt
     2696                  v-sum-rubl-slt      = v-sum-rubl-slt     + buf_fin-gds-part.slt-rubl
     2697                  v-sum-base-slt      = v-sum-base-slt     + buf_fin-gds-part.slt-base
     2698                  v-sum-contract-slt  = v-sum-contract-slt + buf_fin-gds-part.slt-contract
     2699                  v-sum-vat           = v-sum-vat          + var-doc-vat
     2700                  v-sum-rubl-vat      = v-sum-rubl-vat     + buf_fin-gds-part.vat-rubl
     2701                  v-sum-base-vat      = v-sum-base-vat     + buf_fin-gds-part.vat-base
     2702                  v-sum-contract-vat  = v-sum-contract-vat + buf_fin-gds-part.vat-contract
     2703                .
     2704                if last-of(buf_fin-gds-part.vat-pc) then do:
     2705                   v-line = v-line + 1.
     2706                   create buf_fin-ob-tax.
     2707                   assign
     2708                       buf_fin-ob-tax.doc-code           = buf_fin-ob.doc-code
     2709                       buf_fin-ob-tax.host-code          = buf_fin-ob.host-code
     2710                       buf_fin-ob-tax.line-num           = v-line
     2711                       buf_fin-ob-tax.slt-pc             = buf_fin-gds-part.slt-pc
     2712                       buf_fin-ob-tax.vat-pc             = buf_fin-gds-part.vat-pc
     2713                       buf_fin-ob-tax.with-slt           = true
     2714                       buf_fin-ob-tax.with-vat           = true
     2715                       buf_fin-ob-tax.sum-line-rubl      = v-sum-rubl
     2716                       buf_fin-ob-tax.sum-slt-line-rubl  = v-sum-rubl-slt
     2717                       buf_fin-ob-tax.sum-vat-line-rubl  = v-sum-rubl-vat
     2718                       buf_fin-ob-tax.sum-line-base       = v-sum-base
     2719                       buf_fin-ob-tax.sum-line-contr      = v-sum-contract
     2720                       buf_fin-ob-tax.sum-line-doc        = v-sum
     2721                       buf_fin-ob-tax.sum-slt-line-base    = v-sum-base-slt
     2722                       buf_fin-ob-tax.sum-slt-line-contr   = v-sum-contract-slt
     2723                       buf_fin-ob-tax.sum-slt-line-doc     = v-sum-slt
     2724                       buf_fin-ob-tax.sum-vat-line-base    = v-sum-base-vat
     2725                       buf_fin-ob-tax.sum-vat-line-contr   = v-sum-contract-vat
     2726                       buf_fin-ob-tax.sum-vat-line-doc     = v-sum-vat
     2727                       .
     2728                       assign
     2729                           buf_fin-ob-tax.with-slt-orig            = buf_fin-ob-tax.with-slt
     2730                           buf_fin-ob-tax.slt-pc-orig              = buf_fin-ob-tax.slt-pc
     2731                           buf_fin-ob-tax.vat-pc-orig              = buf_fin-ob-tax.vat-pc
     2732                           buf_fin-ob-tax.sum-slt-line-doc-orig    = buf_fin-ob-tax.sum-slt-line-doc
     2733                           buf_fin-ob-tax.sum-slt-line-base-orig   = buf_fin-ob-tax.sum-slt-line-base
     2734                           buf_fin-ob-tax.sum-slt-line-contr-orig  = buf_fin-ob-tax.sum-slt-line-contr
     2735                           buf_fin-ob-tax.sum-slt-line-rubl-orig   = buf_fin-ob-tax.sum-slt-line-rubl
     2736                           buf_fin-ob-tax.with-vat-orig            = buf_fin-ob-tax.with-vat
     2737                           buf_fin-ob-tax.sum-vat-line-doc-orig    = buf_fin-ob-tax.sum-vat-line-doc
     2738                           buf_fin-ob-tax.sum-vat-line-base-orig   = buf_fin-ob-tax.sum-vat-line-base
     2739                           buf_fin-ob-tax.sum-vat-line-contr-orig  = buf_fin-ob-tax.sum-vat-line-contr
     2740                           buf_fin-ob-tax.sum-vat-line-rubl-orig   = buf_fin-ob-tax.sum-vat-line-rubl
     2741                       .
     2742                       assign
     2743                          v-tax-sum-rubl   = v-tax-sum-rubl  + v-sum-rubl-slt  + v-sum-rubl-vat
     2744                          v-tax-sum-base   = v-tax-sum-base  + v-sum-base-slt  + v-sum-base-vat
     2745                          v-tax-sum-contr  = v-tax-sum-contr + v-sum-contract-slt + v-sum-contract-vat
     2746                          v-tax-sum-doc    = v-tax-sum-doc   + v-sum-slt   + v-sum-vat
     2747                       .
     2748                       assign
     2749                       v-sum  = 0
     2750                       v-sum-rubl      = 0
     2751                       v-sum-base      = 0
     2752                       v-sum-contract  = 0
     2753                       v-sum-slt           =0
     2754                       v-sum-rubl-slt      =0
     2755                       v-sum-base-slt      =0
     2756                       v-sum-contract-slt  =0
     2757                       v-sum-vat           =0
     2758                       v-sum-rubl-vat      =0
     2759                       v-sum-base-vat      =0
     2760                       v-sum-contract-vat  =0
     2761                       .
     2762                 end.
     2763       end.
     2764       assign
     2765         buf_fin-ob.sum-tax-doc      = v-tax-sum-doc
     2766         buf_fin-ob.sum-tax-rubl     = v-tax-sum-rubl
     2767         buf_fin-ob.sum-tax-base     = v-tax-sum-base
     2768         buf_fin-ob.sum-tax-contract = v-tax-sum-contr
     2769         buf_fin-ob.base-rate        = if buf_fin-ob.base-rate <> 0 then buf_fin-ob.base-rate else round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-base , 4)
     2770         buf_fin-ob.exch-rate        = round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-doc  , 4)
     2771         buf_fin-ob.contract-rate    = round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-contract , 4)
     2772         buf_fin-ob.base-scale       = 1
     2773         buf_fin-ob.exch-scale       = 1
     2774         buf_fin-ob.contract-scale   = 1
     2775       .
     2776       assign
     2777       v-tax-sum-rubl  = 0
     2778       v-tax-sum-base  = 0
     2779       v-tax-sum-contr = 0
     2780       v-tax-sum-doc   = 0
     2781       v-sum-vat          = 0
     2782       v-sum-rubl-vat     = 0
     2783       v-sum-base-vat     = 0
     2784       v-sum-contract-vat    = 0
     2785       v-sum-slt          = 0
     2786       v-sum-rubl-slt     = 0
     2787       v-sum-base-slt     = 0
     2788       v-sum-contract-slt    = 0
     2789       .
     2790   end.
     2791    end.
     2792   end procedure.
     2793   procedure update-fin-ob_obj :
     2794    do
     2795    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2796    :
     2797   define input parameter p-doc-code  like ub.fin-ob.doc-code no-undo .
     2798   define input parameter p-host-code as integer no-undo .
     2799   define buffer buf_fin-gds-part for  ub.fin-gds-part .
     2800   define buffer buf_fin-ob       for  ub.fin-ob     .
     2801   define variable v-obj-code as integer no-undo init 0 .
     2802   define variable v-obj-type as character no-undo init "" .
     2803   define variable var-fin-calc as integer no-undo .
     2804   find first ub.sysconf no-lock where ub.sysconf.host-code = p-host-code no-error .
     2805   var-fin-calc = ub.sysconf.fin-calc   .
     2806   if var-fin-calc = 0 then return.
     2807   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
     2808                                               buf_fin-ob.doc-code = p-doc-code
     2809                                               on error undo, return error :
     2810       for each buf_fin-gds-part no-lock where
     2811                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
     2812                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
     2813                on error undo, return error :
     2814             assign
     2815                v-obj-code  =  buf_fin-gds-part.obj-code
     2816                v-obj-type  =  buf_fin-gds-part.obj-type
     2817                .
     2818              leave.
     2819       end.
     2820       assign
     2821         buf_fin-ob.obj-code  =   v-obj-code
     2822         buf_fin-ob.obj-type  =   v-obj-type
     2823       .
     2824   end.
     2825    end.
     2826   end procedure.
     2827   procedure make-tax-rubl :
     2828    do
     2829    on error undo, return error return-value
     2830    :
     2831   define input parameter p-doc-code like ub.fin-ob.doc-code no-undo .
     2832   define input parameter p-host-code as integer no-undo .
     2833   define buffer buf_fin-gds-part for  ub.fin-gds-part .
     2834   define buffer buf_fin-ob-tax   for  ub.fin-ob-tax .
     2835   define buffer buf_fin-ob       for  ub.fin-ob     .
     2836   define variable v-line    as integer no-undo .
     2837   define variable v-sum         as decimal no-undo .
     2838   define variable v-tax-sum       as decimal no-undo .
     2839   define variable v-tax-sum-rubl  as decimal no-undo .
     2840   define variable v-tax-sum-base  as decimal no-undo .
     2841   define variable v-tax-sum-contr as decimal no-undo .
     2842   define variable v-tax-sum-doc   as decimal no-undo .
     2843   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
     2844                                               buf_fin-ob.doc-code = p-doc-code
     2845                                               on error undo, return error :
     2846      assign
     2847       v-tax-sum-rubl = 0
     2848       v-tax-sum-base = 0
     2849       v-tax-sum-contr = 0
     2850       v-tax-sum-doc  = 0
     2851       v-sum          = 0
     2852       v-line = 0
     2853       .
     2854       for each buf_fin-gds-part no-lock where
     2855                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
     2856                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
     2857                break  by buf_fin-gds-part.SLT-pc
     2858                       by buf_fin-gds-part.vat-pc
     2859                on error undo, return error :
     2860                assign
     2861                  v-sum       = v-sum + buf_fin-gds-part.sum-rubl
     2862                .
     2863                if last-of(buf_fin-gds-part.vat-pc) then do:
     2864                   v-line = v-line + 1.
     2865                   create buf_fin-ob-tax.
     2866                   assign
     2867                       buf_fin-ob-tax.doc-code           = buf_fin-ob.doc-code
     2868                       buf_fin-ob-tax.host-code          = buf_fin-ob.host-code
     2869                       buf_fin-ob-tax.line-num           = v-line
     2870                       buf_fin-ob-tax.slt-pc             = buf_fin-gds-part.slt-pc
     2871                       buf_fin-ob-tax.vat-pc             = buf_fin-gds-part.vat-pc
     2872                       buf_fin-ob-tax.with-slt           = true
     2873                       buf_fin-ob-tax.with-vat           = true
     2874                       buf_fin-ob-tax.sum-line-rubl      = v-sum
     2875                       buf_fin-ob-tax.sum-slt-line-rubl  = buf_fin-ob-tax.slt-PC *  buf_fin-ob-tax.sum-line-rubl  / ( 100 + buf_fin-ob-tax.slt-PC )
     2876                       buf_fin-ob-tax.sum-vat-line-rubl  = buf_fin-ob-tax.vat-PC * (( buf_fin-ob-tax.sum-line-rubl  - buf_fin-ob-tax.sum-slt-line-rubl  ) / ( 100  + buf_fin-ob-tax.vat-PC))
     2877                       buf_fin-ob-tax.sum-line-base       = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-line-rubl
     2878                       buf_fin-ob-tax.sum-line-doc        = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-line-rubl
     2879                       buf_fin-ob-tax.sum-line-contr      = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-line-rubl
     2880                       buf_fin-ob-tax.sum-slt-line-base    = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-slt-line-rubl
     2881                       buf_fin-ob-tax.sum-slt-line-doc     = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-slt-line-rubl
     2882                       buf_fin-ob-tax.sum-slt-line-contr   = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-slt-line-rubl
     2883                       buf_fin-ob-tax.sum-vat-line-base    = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-vat-line-rubl
     2884                       buf_fin-ob-tax.sum-vat-line-doc     = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-vat-line-rubl
     2885                       buf_fin-ob-tax.sum-vat-line-contr   = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-vat-line-rubl
     2886                       .
     2887                       assign
     2888                           buf_fin-ob-tax.with-slt-orig            = buf_fin-ob-tax.with-slt
     2889                           buf_fin-ob-tax.slt-pc-orig              = buf_fin-ob-tax.slt-pc
     2890                           buf_fin-ob-tax.vat-pc-orig              = buf_fin-ob-tax.vat-pc
     2891                           buf_fin-ob-tax.sum-slt-line-doc-orig    = buf_fin-ob-tax.sum-slt-line-doc
     2892                           buf_fin-ob-tax.sum-slt-line-base-orig   = buf_fin-ob-tax.sum-slt-line-base
     2893                           buf_fin-ob-tax.sum-slt-line-contr-orig  = buf_fin-ob-tax.sum-slt-line-contr
     2894                           buf_fin-ob-tax.sum-slt-line-rubl-orig   = buf_fin-ob-tax.sum-slt-line-rubl
     2895                           buf_fin-ob-tax.with-vat-orig            = buf_fin-ob-tax.with-vat
     2896                           buf_fin-ob-tax.sum-vat-line-doc-orig    = buf_fin-ob-tax.sum-vat-line-doc
     2897                           buf_fin-ob-tax.sum-vat-line-base-orig   = buf_fin-ob-tax.sum-vat-line-base
     2898                           buf_fin-ob-tax.sum-vat-line-contr-orig  = buf_fin-ob-tax.sum-vat-line-contr
     2899                           buf_fin-ob-tax.sum-vat-line-rubl-orig   = buf_fin-ob-tax.sum-vat-line-rubl
     2900                       .
     2901                       assign
     2902                          v-tax-sum-rubl   = v-tax-sum-rubl  + buf_fin-ob-tax.sum-slt-line-rubl  + buf_fin-ob-tax.sum-vat-line-rubl
     2903                          v-tax-sum-base   = v-tax-sum-base  + buf_fin-ob-tax.sum-slt-line-base  + buf_fin-ob-tax.sum-vat-line-base
     2904                          v-tax-sum-contr  = v-tax-sum-contr + buf_fin-ob-tax.sum-slt-line-contr + buf_fin-ob-tax.sum-vat-line-contr
     2905                          v-tax-sum-doc    = v-tax-sum-doc   + buf_fin-ob-tax.sum-slt-line-doc   + buf_fin-ob-tax.sum-vat-line-doc
     2906                       .
     2907                       v-sum  = 0 .
     2908                 end.
     2909       end.
     2910       buf_fin-ob.sum-tax-doc   = v-tax-sum-doc   .
     2911       buf_fin-ob.sum-tax-rubl  = v-tax-sum-rubl  .
     2912       buf_fin-ob.sum-tax-base  = v-tax-sum-base  .
     2913       buf_fin-ob.sum-tax-contract = v-tax-sum-contr .
     2914       v-tax-sum-rubl  = 0 .
     2915       v-tax-sum-base  = 0 .
     2916       v-tax-sum-contr = 0 .
     2917       v-tax-sum-doc   = 0 .
     2918   end.
     2919    end.
     2920   end procedure.
     2921   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2922   on help of frame Dialog-Frame
     2923   do:
     2924     run gbl/app_help.p
     2925       (input this-procedure :file-name
     2926       ,input ''
     2927       ,input ?
     2928       ) no-error.
     2929     if error-status :error then do:
     2930       message
     2931         "Ошибка при вызове помощи"
     2932         error-status :get-message(1)
     2933         view-as alert-box .
     2934     end.
     2935   end.
     2936   run minbtn-set in this-procedure .
     2937   on choose of b-help in frame Dialog-Frame
     2938   do:
     2939     apply "help":u to frame Dialog-Frame .
     2940   end.
     2941   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2942   procedure minbtn-set :
     2943       do
     2944           on error undo, return error return-value
     2945           :
     2946           define variable ii              as integer       no-undo .
     2947           define variable fh              as widget-handle no-undo .
     2948           define variable hh              as widget-handle no-undo .
     2949           define variable v-h             as handle        extent 4 no-undo .
     2950           define variable v-name-button   as character     no-undo .
     2951           define variable v-help-old-x    as decimal       no-undo .
     2952           define variable v-help-old-y    as decimal       no-undo .
     2953           define variable v-help-old-size as decimal       no-undo .
     2954           define variable v-frame-width   as decimal       no-undo .
     2955           define variable jj              as integer       no-undo .
     2956           do
     2957               on error undo, return error
     2958               :
     2959               assign
     2960                   v-frame-width = frame Dialog-Frame:width - 0.3
     2961                   fh            = frame Dialog-Frame:first-child
     2962                   hh            = fh:first-child
     2963                   ii            = 1
     2964                   .
     2965               do while valid-handle(hh):
     2966                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2967                   do:
     2968                       case lc(hh:name) :
     2969                           when "b-help" then
     2970                               do:
     2971                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2972                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2973                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2974                                   hh:TOOLTIP = "Помощь" .
     2975                                   v-help-old-x = hh:column .
     2976                                   v-help-old-y = hh:row    .
     2977                                   v-help-old-size = hh:width .
     2978                                   hh:width-chars = 2.5 .
     2979                               end.
     2980                           when "b-print" then
     2981                               do:
     2982                                   hh:load-image("cmp/b-print.bmp":u) .
     2983                                   hh:TOOLTIP = "Печать" .
     2984                                   v-h[ii] = hh:handle .
     2985                                   ii = ii + 1 .
     2986                                   hh:width-chars = 3 .
     2987                               end.
     2988                           when "b-history" or
     2989                           when "b-hist" then
     2990                               do:
     2991                                   hh:load-image("cmp/b-hist.bmp":u) .
     2992                                   hh:TOOLTIP = "История" .
     2993                                   v-h[ii] = hh:handle .
     2994                                   ii = ii + 1 .
     2995                                   hh:width-chars = 3 .
     2996                               end.
     2997                           when "b-sch" then
     2998                               do:
     2999                                   hh:load-image("cmp/b-sch.bmp":u) .
     3000                                   hh:TOOLTIP = "Установка Фильтра" .
     3001                                   v-h[ii] = hh:handle .
     3002                                   ii = ii + 1 .
     3003                                   hh:width-chars = 3 .
     3004                               end.
     3005                           when "b-hist-user" then
     3006                               do:
     3007                                   hh:load-image("cmp/b-hist.bmp":u) .
     3008                                   hh:TOOLTIP = "История пользователя" .
     3009                                   ii = ii + 1 .
     3010                               end.
     3011                       end case.
     3012                   end.
     3013                   hh = hh:next-sibling.
     3014               end.
     3015               b-help:column = v-frame-width - b-help:width-chars.
     3016               jj = 0.
     3017               repeat ii = 4 to 1 by -1 :
     3018                   if valid-handle (v-h[ii] ) then
     3019                   do:
     3020                       jj  = jj + 1 .
     3021                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3022                       v-h[ii]:row    = v-help-old-y .
     3023                   end.
     3024               end.
     3025           end.
     3026       end.
     3027   end procedure.
     3028   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3029   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3030   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3031   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3032   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3033   define variable v-diasize-current-frame-height as decimal   no-undo .
     3034   define variable v-diasize-change-size          as logical   no-undo .
     3035   define variable v-diasize-resize-button        as handle    no-undo .
     3036   define variable v-diasize-wndmax               as logical   no-undo .
     3037   define variable v-diasize-wndstore             as logical   no-undo .
     3038   define variable v-diasize-proc-name            as character no-undo .
     3039   define variable v-diasize-browse-handle        as handle    no-undo .
     3040   define variable v-diasize-browse-number        as integer   no-undo .
     3041   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3042   define temp-table temp-diasize-handle no-undo
     3043     field handle-value  as handle
     3044     field save-position as decimal
     3045     index xpk is primary unique handle-value
     3046     .
     3047   define temp-table temp-browse-handle no-undo
     3048     field browse-type   as character
     3049     field browse-number as integer
     3050     field browse-handle as handle
     3051     field original-size as decimal
     3052     index xpk is primary unique browse-type browse-number
     3053     index xie browse-type browse-handle
     3054   .
     3055   procedure diasize_change-height :
     3056     define input  parameter p-change-value  as decimal   no-undo .
     3057     define input  parameter p-move-resize   as logical   no-undo .
     3058     define variable v-field-group-handle    as handle    no-undo .
     3059     define variable v-object-handle         as handle    no-undo .
     3060     define variable v-frame-height          as decimal   no-undo .
     3061     define variable v-frame-virtual-height  as decimal   no-undo .
     3062     define variable v-browse-height         as decimal   no-undo .
     3063     define variable v-window-height         as decimal   no-undo .
     3064     define variable v-window-virtual-height as decimal   no-undo .
     3065     define variable v-change-sign           as integer   no-undo .
     3066     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3067     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3068     if p-change-value > 0
     3069     then do:
     3070       if frame Dialog-Frame :height + p-change-value
     3071           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3072       then do:
     3073         assign
     3074           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3075                           - (frame Dialog-Frame :height-chars)
     3076         .
     3077         if p-change-value <= 0
     3078         then do:
     3079           run diasize_position-resize-button in this-procedure .
     3080           return .
     3081         end.
     3082       end.
     3083     end.
     3084     if p-change-value < 0
     3085     then do:
     3086       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     3087       then do:
     3088         assign
     3089           p-change-value = v-diasize-orig-frame-height
     3090                          - (frame Dialog-Frame :height-chars)
     3091         .
     3092         if p-change-value >= 0
     3093         then do:
     3094           run diasize_position-resize-button in this-procedure .
     3095           return .
     3096         end.
     3097       end.
     3098     end.
     3099     if p-change-value >= 0
     3100     then do:
     3101       assign
     3102         v-change-sign = 1
     3103       .
     3104     end.
     3105     else do:
     3106       assign
     3107         v-change-sign = -1
     3108       .
     3109     end.
     3110     assign
     3111       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3112     .
     3113     if p-change-value = 0
     3114     then do:
     3115       run diasize_position-resize-button in this-procedure .
     3116       return .
     3117     end.
     3118     move_block:
     3119     do
     3120     on error undo move_block, retry move_block
     3121     :
     3122       if retry
     3123       then do:
     3124         do
     3125         on error undo move_block, leave move_block
     3126         :
     3127           if p-change-value > 0
     3128           then do:
     3129             for each buf_temp-diasize-handle
     3130             on error undo, next
     3131             :
     3132               assign
     3133                 v-object-handle = buf_temp-diasize-handle.handle-value
     3134               .
     3135               if v-object-handle <> v-diasize-resize-button
     3136               then do:
     3137                 assign
     3138                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3139                 .
     3140               end.
     3141             end.
     3142             assign
     3143               v-diasize-browse-handle :height = v-browse-height
     3144             .
     3145             for each buf_temp-browse-handle
     3146               where buf_temp-browse-handle.browse-type = 'height':u
     3147             on error undo, next
     3148             :
     3149               assign
     3150                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3151               .
     3152             end.
     3153             assign
     3154               frame Dialog-Frame :height = v-frame-height
     3155             .
     3156             if frame Dialog-Frame :scrollable = true
     3157             then do:
     3158               assign
     3159                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3160               .
     3161             end.
     3162             run diasize_position-resize-button in this-procedure .
     3163           end.
     3164           else do:
     3165             if frame Dialog-Frame :scrollable = true
     3166             then do:
     3167               assign
     3168                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3169               .
     3170             end.
     3171             assign
     3172               frame Dialog-Frame :height = v-frame-height
     3173             .
     3174             assign
     3175               v-diasize-browse-handle :height = v-browse-height
     3176             .
     3177             for each buf_temp-browse-handle
     3178               where buf_temp-browse-handle.browse-type = 'height':u
     3179             on error undo, next
     3180             :
     3181               assign
     3182                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3183               .
     3184             end.
     3185             for each buf_temp-diasize-handle
     3186             on error undo, next
     3187             :
     3188               assign
     3189                 v-object-handle = buf_temp-diasize-handle.handle-value
     3190               .
     3191               if v-object-handle <> v-diasize-resize-button
     3192               then do:
     3193                 assign
     3194                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3195                 .
     3196               end.
     3197             end.
     3198             run diasize_position-resize-button in this-procedure .
     3199           end.
     3200           assign
     3201             v-diasize-change-size = false
     3202           .
     3203           leave move_block .
     3204         end.
     3205       end.
     3206       assign
     3207         v-diasize-need-full-display = true
     3208       .
     3209       if v-diasize-change-size = false
     3210       then do:
     3211         assign
     3212           v-diasize-change-size = true
     3213         .
     3214       end.
     3215       else do:
     3216         return .
     3217       end.
     3218       assign
     3219         v-frame-height = frame Dialog-Frame :height
     3220         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3221         v-browse-height = v-diasize-browse-handle :height
     3222       .
     3223       for each buf_temp-browse-handle
     3224         where buf_temp-browse-handle.browse-type = 'height':u
     3225       :
     3226         assign
     3227           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3228         .
     3229       end.
     3230       for each buf_temp-diasize-handle
     3231       :
     3232         delete buf_temp-diasize-handle .
     3233       end.
     3234       assign
     3235         v-field-group-handle = frame Dialog-Frame :first-child
     3236       .
     3237       do while valid-handle(v-field-group-handle)
     3238       :
     3239         assign
     3240           v-object-handle = v-field-group-handle :first-child
     3241         .
     3242         do while valid-handle(v-object-handle)
     3243         :
     3244           if  v-object-handle <> v-diasize-browse-handle :handle
     3245           and can-query(v-object-handle, "row")
     3246           and can-query(v-object-handle, "height")
     3247           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3248           then do:
     3249             find first buf_temp-browse-handle
     3250               where buf_temp-browse-handle.browse-type   = 'height':u
     3251                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3252               no-error .
     3253             if available buf_temp-browse-handle
     3254             then do:
     3255             end.
     3256             else do:
     3257               create buf_temp-diasize-handle .
     3258               assign
     3259                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3260                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3261               .
     3262             end.
     3263           end.
     3264           assign
     3265             v-object-handle = v-object-handle :next-sibling
     3266           .
     3267         end.
     3268         assign
     3269           v-field-group-handle = v-field-group-handle :next-sibling
     3270         .
     3271       end.
     3272       do with frame Dialog-Frame
     3273       :
     3274         hide v-diasize-resize-button .
     3275         assign
     3276           v-diasize-resize-button :row    = 1
     3277           v-diasize-resize-button :column = 1
     3278         .
     3279       end.
     3280       if p-change-value > 0
     3281       then do:
     3282         if frame Dialog-Frame :scrollable = true
     3283         then do:
     3284           assign
     3285             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3286             no-error .
     3287           if error-status :error
     3288           or error-status :get-message(1) <> ""
     3289           then do:
     3290             undo move_block, retry move_block .
     3291           end.
     3292         end.
     3293         assign
     3294           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3295           no-error .
     3296         if error-status :error
     3297         or error-status :get-message(1) <> ""
     3298         then do:
     3299           undo move_block, retry move_block .
     3300         end.
     3301         assign
     3302           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3303           no-error .
     3304         if error-status :error
     3305         or error-status :get-message(1) <> ""
     3306         then do:
     3307           undo move_block, retry move_block .
     3308         end.
     3309         for each buf_temp-browse-handle
     3310           where buf_temp-browse-handle.browse-type = 'height':u
     3311         on error undo move_block, retry move_block
     3312         :
     3313           assign
     3314             buf_temp-browse-handle.browse-handle :height
     3315               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3316             no-error .
     3317           if error-status :error
     3318           or error-status :get-message(1) <> ""
     3319           then do:
     3320             undo move_block, retry move_block .
     3321           end.
     3322         end.
     3323         for each buf_temp-diasize-handle
     3324         on error undo move_block, retry move_block
     3325         :
     3326           assign
     3327             v-object-handle = buf_temp-diasize-handle.handle-value
     3328           .
     3329           if v-object-handle <> v-diasize-resize-button
     3330           then do:
     3331             assign
     3332               v-object-handle :row = v-object-handle :row + p-change-value
     3333               no-error .
     3334             if error-status :error
     3335             or error-status :get-message(1) <> ""
     3336             then do:
     3337               undo move_block, retry move_block .
     3338             end.
     3339           end.
     3340         end.
     3341       end.
     3342       else do:
     3343         for each buf_temp-diasize-handle
     3344         on error undo move_block, retry move_block
     3345         :
     3346           assign
     3347             v-object-handle = buf_temp-diasize-handle.handle-value
     3348           .
     3349           if v-object-handle <> v-diasize-resize-button
     3350           then do:
     3351             assign
     3352               v-object-handle :row = v-object-handle :row + p-change-value
     3353               no-error .
     3354             if error-status :error
     3355             or error-status :get-message(1) <> ""
     3356             then do:
     3357               undo move_block, retry move_block .
     3358             end.
     3359           end.
     3360         end.
     3361         assign
     3362           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3363           no-error .
     3364         if error-status :error
     3365         or error-status :get-message(1) <> ""
     3366         then do:
     3367           undo move_block, retry move_block .
     3368         end.
     3369         for each buf_temp-browse-handle
     3370           where buf_temp-browse-handle.browse-type = 'height':u
     3371         on error undo move_block, retry move_block
     3372         :
     3373           assign
     3374             buf_temp-browse-handle.browse-handle :height
     3375               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3376             no-error .
     3377           if error-status :error
     3378           or error-status :get-message(1) <> ""
     3379           then do:
     3380             undo move_block, retry move_block .
     3381           end.
     3382         end.
     3383         assign
     3384           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3385           no-error .
     3386         if error-status :error
     3387         or error-status :get-message(1) <> ""
     3388         then do:
     3389           undo move_block, retry move_block .
     3390         end.
     3391         if frame Dialog-Frame :scrollable = true
     3392         then do:
     3393           assign
     3394             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3395             no-error .
     3396           if error-status :error
     3397           or error-status :get-message(1) <> ""
     3398           then do:
     3399             undo move_block, retry move_block .
     3400           end.
     3401         end.
     3402       end.
     3403       if p-move-resize = true
     3404       then do:
     3405         run diasize_position-resize-button in this-procedure .
     3406       end.
     3407       if v-diasize-wndstore = true
     3408       then do:
     3409         if connected("ub") = true
     3410         then do:
     3411           define variable v-cntxt-db-num        as integer   no-undo .
     3412           define variable v-cntxt-userid        as character no-undo .
     3413           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3414                                             , OUTPUT v-cntxt-userid
     3415                                             ) .
     3416           run gbl/wndsizew.p
     3417             (input  v-cntxt-db-num
     3418             ,input  v-cntxt-userid
     3419             ,input  v-diasize-proc-name
     3420             ,input  'height':u
     3421             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3422             ) .
     3423         end.
     3424       end.
     3425     end.
     3426     assign
     3427       v-diasize-change-size = false
     3428     .
     3429   end procedure.
     3430   procedure diasize_set-height :
     3431     define input  parameter p-new-height  as decimal   no-undo .
     3432     define input  parameter p-move-resize as logical   no-undo .
     3433     do
     3434     on error undo, return error return-value
     3435     :
     3436       run diasize_change-height in this-procedure
     3437         (input  (p-new-height - frame Dialog-Frame :height)
     3438         ,input  p-move-resize
     3439         ) .
     3440     end.
     3441   end procedure.
     3442   procedure diasize_change-width :
     3443     define input  parameter p-change-value as decimal   no-undo .
     3444     define input  parameter p-move-resize  as logical   no-undo .
     3445     define variable v-field-group-handle   as handle    no-undo .
     3446     define variable v-object-handle        as handle    no-undo .
     3447     define variable v-frame-width          as decimal   no-undo .
     3448     define variable v-frame-virtual-width  as decimal   no-undo .
     3449     define variable v-browse-width         as decimal   no-undo .
     3450     define variable v-window-width         as decimal   no-undo .
     3451     define variable v-window-virtual-width as decimal   no-undo .
     3452     define variable v-change-sign          as integer   no-undo .
     3453     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3454     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3455     if p-change-value > 0
     3456     then do:
     3457       if frame Dialog-Frame :width + p-change-value >
     3458           session :width-chars
     3459       then do:
     3460         assign
     3461           p-change-value = session :width-chars - frame Dialog-Frame :width
     3462         .
     3463         if p-change-value <= 0
     3464         then do:
     3465           run diasize_position-resize-button in this-procedure .
     3466           return .
     3467         end.
     3468       end.
     3469     end.
     3470     if p-change-value < 0
     3471     then do:
     3472       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3473       then do:
     3474         assign
     3475           p-change-value = v-diasize-orig-frame-width
     3476                          - frame Dialog-Frame :width
     3477         .
     3478         if p-change-value >= 0
     3479         then do:
     3480           run diasize_position-resize-button in this-procedure .
     3481           return .
     3482         end.
     3483       end.
     3484     end.
     3485     if p-change-value >= 0
     3486     then do:
     3487       assign
     3488         v-change-sign = 1
     3489       .
     3490     end.
     3491     else do:
     3492       assign
     3493         v-change-sign = -1
     3494       .
     3495     end.
     3496     assign
     3497       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3498     .
     3499     if p-change-value = 0
     3500     then do:
     3501       run diasize_position-resize-button in this-procedure .
     3502       return .
     3503     end.
     3504     move_block:
     3505     do
     3506     on error undo move_block, leave move_block
     3507     :
     3508       if retry
     3509       then do:
     3510         do
     3511         on error undo move_block, leave move_block
     3512         :
     3513           if p-change-value > 0
     3514           then do:
     3515             for each buf_temp-diasize-handle
     3516             on error undo, next
     3517             :
     3518               assign
     3519                 v-object-handle = buf_temp-diasize-handle.handle-value
     3520               .
     3521               if v-object-handle <> v-diasize-resize-button
     3522               then do:
     3523                 assign
     3524                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3525                 .
     3526               end.
     3527             end.
     3528             assign
     3529               v-diasize-browse-handle :width = v-browse-width
     3530             .
     3531             for each buf_temp-browse-handle
     3532               where buf_temp-browse-handle.browse-type = 'width':u
     3533             on error undo, next
     3534             :
     3535               assign
     3536                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3537               .
     3538             end.
     3539             assign
     3540               frame Dialog-Frame :width = v-frame-width
     3541             .
     3542             if frame Dialog-Frame :scrollable = true
     3543             then do:
     3544               assign
     3545                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3546               .
     3547             end.
     3548             run diasize_position-resize-button in this-procedure .
     3549           end.
     3550           else do:
     3551             if frame Dialog-Frame :scrollable = true
     3552             then do:
     3553               assign
     3554                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3555               .
     3556             end.
     3557             assign
     3558               frame Dialog-Frame :width = v-frame-width
     3559             .
     3560             for each buf_temp-browse-handle
     3561               where buf_temp-browse-handle.browse-type = 'width':u
     3562             on error undo, next
     3563             :
     3564               assign
     3565                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3566               .
     3567             end.
     3568             assign
     3569               v-diasize-browse-handle :width = v-browse-width
     3570             .
     3571             for each buf_temp-diasize-handle
     3572             on error undo, next
     3573             :
     3574               assign
     3575                 v-object-handle = buf_temp-diasize-handle.handle-value
     3576               .
     3577               if v-object-handle <> v-diasize-resize-button
     3578               then do:
     3579                 assign
     3580                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3581                 .
     3582               end.
     3583             end.
     3584             run diasize_position-resize-button in this-procedure .
     3585           end.
     3586           assign
     3587             v-diasize-change-size = false
     3588           .
     3589           leave move_block .
     3590         end.
     3591       end.
     3592       assign
     3593         v-diasize-need-full-display = true
     3594       .
     3595       if v-diasize-change-size = false
     3596       then do:
     3597         assign
     3598           v-diasize-change-size = true
     3599         .
     3600       end.
     3601       else do:
     3602         return .
     3603       end.
     3604       assign
     3605         v-frame-width = frame Dialog-Frame :width
     3606         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3607         v-browse-width = v-diasize-browse-handle :width
     3608       .
     3609       for each buf_temp-browse-handle
     3610         where buf_temp-browse-handle.browse-type = 'width':u
     3611       :
     3612         assign
     3613           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3614         .
     3615       end.
     3616       for each buf_temp-diasize-handle
     3617       :
     3618         delete buf_temp-diasize-handle .
     3619       end.
     3620       assign
     3621         v-field-group-handle = frame Dialog-Frame :first-child
     3622       .
     3623       do while valid-handle(v-field-group-handle)
     3624       :
     3625         assign
     3626           v-object-handle = v-field-group-handle :first-child
     3627         .
     3628         do while valid-handle(v-object-handle)
     3629         :
     3630           if  v-object-handle <> v-diasize-browse-handle :handle
     3631           and v-object-handle <> v-diasize-resize-button
     3632           and can-query(v-object-handle, "row")
     3633           and can-query(v-object-handle, "height")
     3634           and ( v-object-handle :col + v-object-handle :width
     3635                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3636               )
     3637           then do:
     3638             find first buf_temp-browse-handle
     3639               where buf_temp-browse-handle.browse-type   = 'width':u
     3640                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3641               no-error .
     3642             if available buf_temp-browse-handle
     3643             then do:
     3644             end.
     3645             else do:
     3646               create buf_temp-diasize-handle .
     3647               assign
     3648                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3649                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3650               .
     3651             end.
     3652           end.
     3653           assign
     3654             v-object-handle = v-object-handle :next-sibling
     3655           .
     3656         end.
     3657         assign
     3658           v-field-group-handle = v-field-group-handle :next-sibling
     3659         .
     3660       end.
     3661       do with frame Dialog-Frame
     3662       :
     3663         hide v-diasize-resize-button .
     3664         v-diasize-resize-button :row = 1.
     3665         v-diasize-resize-button :column = 1.
     3666       end.
     3667       if p-change-value > 0
     3668       then do:
     3669         if frame Dialog-Frame :scrollable = true
     3670         then do:
     3671           assign
     3672             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3673             no-error .
     3674           if error-status :error
     3675           or error-status :get-message(1) <> ""
     3676           then do:
     3677             undo move_block, retry move_block.
     3678           end.
     3679         end.
     3680         assign
     3681           frame Dialog-Frame :width = v-frame-width + p-change-value
     3682           no-error .
     3683         if error-status :error
     3684         or error-status :get-message(1) <> ""
     3685         then do:
     3686           undo move_block, retry move_block.
     3687         end.
     3688         assign
     3689           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3690         no-error .
     3691         if error-status :error
     3692         or error-status :get-message(1) <> ""
     3693         then do:
     3694           undo move_block, retry move_block.
     3695         end.
     3696         for each buf_temp-browse-handle
     3697           where buf_temp-browse-handle.browse-type = 'width':u
     3698         on error undo move_block, retry move_block
     3699         :
     3700           assign
     3701             buf_temp-browse-handle.browse-handle :width
     3702               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3703             no-error .
     3704           if error-status :error
     3705           or error-status :get-message(1) <> ""
     3706           then do:
     3707             undo move_block, retry move_block .
     3708           end.
     3709         end.
     3710         for each buf_temp-diasize-handle
     3711         on error undo move_block, retry move_block
     3712         :
     3713           assign
     3714             v-object-handle = buf_temp-diasize-handle.handle-value
     3715           .
     3716           if v-object-handle <> v-diasize-resize-button
     3717           then do:
     3718             assign
     3719               v-object-handle :col = v-object-handle :col + p-change-value
     3720               no-error .
     3721             if error-status :error
     3722             or error-status :get-message(1) <> ""
     3723             then do:
     3724               undo move_block, retry move_block .
     3725             end.
     3726           end.
     3727         end.
     3728       end.
     3729       else do:
     3730         for each buf_temp-diasize-handle
     3731         on error undo move_block, retry move_block
     3732         :
     3733           assign
     3734             v-object-handle = buf_temp-diasize-handle.handle-value
     3735           .
     3736           if v-object-handle <> v-diasize-resize-button
     3737           then do:
     3738             assign
     3739               v-object-handle :col = v-object-handle :col + p-change-value
     3740               no-error .
     3741             if error-status :error
     3742             or error-status :get-message(1) <> ""
     3743             then do:
     3744               undo move_block, retry move_block .
     3745             end.
     3746           end.
     3747         end.
     3748         for each buf_temp-browse-handle
     3749           where buf_temp-browse-handle.browse-type = 'width':u
     3750         on error undo move_block, retry move_block
     3751         :
     3752           assign
     3753             buf_temp-browse-handle.browse-handle :width
     3754               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3755             no-error .
     3756           if error-status :error
     3757           or error-status :get-message(1) <> ""
     3758           then do:
     3759             undo move_block, retry move_block .
     3760           end.
     3761         end.
     3762         assign
     3763           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3764           no-error .
     3765         if error-status :error
     3766         or error-status :get-message(1) <> ""
     3767         then do:
     3768           undo move_block, retry move_block.
     3769         end.
     3770         assign
     3771           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3772         no-error .
     3773         if error-status :error
     3774         or error-status :get-message(1) <> ""
     3775         then do:
     3776           undo move_block, retry move_block.
     3777         end.
     3778         if frame Dialog-Frame :scrollable = true
     3779         then do:
     3780           assign
     3781             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3782           no-error .
     3783           if error-status :error
     3784           or error-status :get-message(1) <> ""
     3785           then do:
     3786             undo move_block, retry move_block.
     3787           end.
     3788         end.
     3789       end.
     3790       if p-move-resize
     3791       then do:
     3792         run diasize_position-resize-button in this-procedure .
     3793       end.
     3794       if v-diasize-wndstore = true
     3795       then do:
     3796         if connected("ub") = true
     3797         then do:
     3798           define variable v-cntxt-db-num        as integer   no-undo .
     3799           define variable v-cntxt-userid        as character no-undo .
     3800           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3801                                             , OUTPUT v-cntxt-userid
     3802                                             ) .
     3803           run gbl/wndsizew.p
     3804             (input  v-cntxt-db-num
     3805             ,input  v-cntxt-userid
     3806             ,input  v-diasize-proc-name
     3807             ,input  'width':u
     3808             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3809             ) .
     3810         end.
     3811       end.
     3812     end.
     3813     assign
     3814       v-diasize-change-size = false
     3815     .
     3816   end procedure.
     3817   procedure diasize_set-width :
     3818     define input  parameter p-new-width  as decimal   no-undo .
     3819     define input  parameter p-move-resize as logical   no-undo .
     3820     do
     3821     on error undo, return error return-value
     3822     :
     3823       run diasize_change-width in this-procedure
     3824         (input  (p-new-width - frame Dialog-Frame :width)
     3825         ,input  p-move-resize
     3826         ) .
     3827     end.
     3828   end procedure.
     3829   procedure diasize_position-resize-button :
     3830     do with frame Dialog-Frame
     3831     :
     3832       hide v-diasize-resize-button .
     3833       assign
     3834         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3835                     - 1
     3836                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3837         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3838                     - 1
     3839                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3840       .
     3841       view v-diasize-resize-button .
     3842     end.
     3843   end procedure.
     3844   on alt-right anywhere
     3845   do:
     3846     run diasize_change-width in this-procedure
     3847       (input 1
     3848       ,input true
     3849       ) .
     3850     return no-apply .
     3851   end.
     3852   on alt-left anywhere
     3853   do:
     3854     run diasize_change-width in this-procedure
     3855       (input -1
     3856       ,input true
     3857       ) .
     3858     return no-apply .
     3859   end.
     3860   on alt-down anywhere
     3861   do:
     3862     run diasize_change-height in this-procedure
     3863       (input 1
     3864       ,input true
     3865       ) .
     3866     return no-apply .
     3867   end.
     3868   on alt-up anywhere
     3869   do:
     3870     run diasize_change-height in this-procedure
     3871       (input -1
     3872       ,input true
     3873       ) .
     3874     return no-apply .
     3875   end.
     3876   on alt-enter of frame Dialog-Frame
     3877   do:
     3878     run diasize_maximize in this-procedure
     3879       (input  ?
     3880       ).
     3881     return no-apply .
     3882   end.
     3883   procedure diasize_end-move :
     3884     do
     3885     on error undo, return error return-value
     3886     :
     3887       define variable v-row-delta as decimal   no-undo .
     3888       define variable v-col-delta as decimal   no-undo .
     3889       define variable v-new-row as decimal   no-undo .
     3890       define variable v-new-col as decimal   no-undo .
     3891       assign
     3892         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3893         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3894       .
     3895       assign
     3896         v-row-delta = v-new-row - frame Dialog-Frame :height
     3897         v-col-delta = v-new-col - frame Dialog-Frame :width
     3898       .
     3899       run diasize_change-height in this-procedure
     3900         (input v-row-delta
     3901         ,input true
     3902         ) .
     3903       run diasize_change-width in this-procedure
     3904         (input v-col-delta
     3905         ,input true
     3906         ) .
     3907     end.
     3908   end procedure.
     3909   procedure diasize_maximize :
     3910     define input  parameter p-action as logical   no-undo .
     3911     do
     3912     on error undo, return error return-value
     3913     :
     3914       if p-action = ?
     3915       then do:
     3916         if v-diasize-need-maximize = true
     3917         then do:
     3918           assign
     3919             p-action = true
     3920           .
     3921         end.
     3922         else do:
     3923           assign
     3924             p-action = false
     3925           .
     3926         end.
     3927       end.
     3928       if p-action = true
     3929       then do:
     3930         run diasize_change-height in this-procedure
     3931           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3932               - frame Dialog-Frame :height-chars
     3933           ,input true
     3934           ) .
     3935         run diasize_change-width in this-procedure
     3936           (input session :width-chars
     3937               - frame Dialog-Frame :width-chars
     3938           ,input true
     3939           ) .
     3940         assign
     3941           v-diasize-need-maximize = false
     3942         .
     3943       end.
     3944       else do:
     3945         run diasize_change-width in this-procedure
     3946           (input v-diasize-orig-frame-width
     3947               - frame Dialog-Frame :width-chars
     3948           ,input true
     3949           ) .
     3950         run diasize_change-height in this-procedure
     3951           (input v-diasize-orig-frame-height
     3952               - frame Dialog-Frame :height-chars
     3953           ,input true
     3954           ) .
     3955         assign
     3956           v-diasize-need-maximize = true
     3957         .
     3958       end.
     3959     end.
     3960   end procedure.
     3961   procedure diasize_restore-orig-size :
     3962     do
     3963     on error undo, return error return-value
     3964     :
     3965       assign
     3966         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3967         v-diasize-current-frame-height = frame Dialog-Frame :height
     3968       .
     3969       run diasize_set-height in this-procedure
     3970         (input  v-diasize-orig-frame-height
     3971         ,input  true
     3972         ) .
     3973       run diasize_set-width in this-procedure
     3974         (input  v-diasize-orig-frame-width
     3975         ,input  true
     3976         ) .
     3977     end.
     3978   end procedure.
     3979   procedure diasize_restore-current-size :
     3980     do
     3981     on error undo, return error return-value
     3982     :
     3983       run diasize_set-height in this-procedure
     3984         (input  v-diasize-current-frame-height
     3985         ,input  true
     3986         ) .
     3987       run diasize_set-width in this-procedure
     3988         (input  v-diasize-current-frame-width
     3989         ,input  true
     3990         ) .
     3991     end.
     3992   end procedure.
     3993   procedure diasize_set-browse-handle :
     3994     define input  parameter p-browse-handle as handle   no-undo .
     3995     define buffer buf_temp-browse-handle for temp-browse-handle .
     3996     do
     3997     on error undo, return error return-value
     3998     :
     3999       assign
     4000         v-diasize-browse-handle = p-browse-handle
     4001       .
     4002       for each buf_temp-browse-handle
     4003       on error undo, return error return-value
     4004       :
     4005         delete buf_temp-browse-handle .
     4006       end.
     4007     end.
     4008   end procedure.
     4009   procedure diasize_add_browse :
     4010     define input  parameter p-browse-type   as character no-undo .
     4011     define input  parameter p-browse-handle as handle    no-undo .
     4012     define buffer buf_temp-browse-handle for temp-browse-handle .
     4013     do
     4014     on error undo, return error return-value
     4015     :
     4016       assign
     4017         v-diasize-browse-number = v-diasize-browse-number + 1
     4018       .
     4019       create buf_temp-browse-handle .
     4020       assign
     4021         buf_temp-browse-handle.browse-type   = p-browse-type
     4022         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     4023         buf_temp-browse-handle.browse-handle = p-browse-handle
     4024       .
     4025     end.
     4026   end procedure.
     4027   procedure diasize_init :
     4028     define variable v-default-value    as logical   no-undo .
     4029     define variable v-restore-saved    as logical   no-undo .
     4030     define variable v-resize-value-str as character no-undo .
     4031     do
     4032     on error undo, return error return-value
     4033     :
     4034       do with frame Dialog-Frame
     4035       :
     4036         assign
     4037           v-diasize-orig-frame-height = frame Dialog-Frame :height
     4038           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     4039           v-diasize-browse-handle     = browse BROWSE-1 :handle
     4040         .
     4041         create button v-diasize-resize-button
     4042         assign
     4043           parent        = frame Dialog-Frame :first-child
     4044           label         = "s"
     4045           height-pixels = 16
     4046           width-pixels  = 16
     4047           visible       = true
     4048           sensitive     = true
     4049           movable       = true
     4050           triggers:
     4051             on end-move persistent run diasize_end-move in this-procedure .
     4052           end triggers.
     4053         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4054         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4055         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4056         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4057         assign
     4058           v-diasize-wndmax = false
     4059         .
     4060         if connected("ub") = true
     4061         then do:
     4062           define variable v-cntxt-db-num        as integer   no-undo .
     4063           define variable v-cntxt-userid        as character no-undo .
     4064           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4065                                             , OUTPUT v-cntxt-userid
     4066                                             ) .
     4067           run gbl/wndpar_r.p
     4068             (input  v-cntxt-db-num
     4069             ,input  v-cntxt-userid
     4070             ,input  'wndmax':U
     4071             ,output v-diasize-wndmax
     4072             ,output v-default-value
     4073             ) .
     4074         end.
     4075         assign
     4076           v-diasize-wndstore = false
     4077         .
     4078         if connected("ub") = true
     4079         then do:
     4080           run gbl/wndpar_r.p
     4081             (input  v-cntxt-db-num
     4082             ,input  v-cntxt-userid
     4083             ,input  'wndstore':U
     4084             ,output v-diasize-wndstore
     4085             ,output v-default-value
     4086             ) .
     4087         end.
     4088         assign
     4089           v-diasize-proc-name = entry(1, program-name(2), '.')
     4090         .
     4091         if v-diasize-wndstore = true
     4092         then do:
     4093           assign
     4094             v-restore-saved = false
     4095           .
     4096           if connected("ub") = true
     4097           then do:
     4098             run gbl/wndsizer.p
     4099               (input  v-cntxt-db-num
     4100               ,input  v-cntxt-userid
     4101               ,input  v-diasize-proc-name
     4102               ,input  'height':u
     4103               ,output v-resize-value-str
     4104               ) .
     4105             if v-resize-value-str <> '':U
     4106             then do:
     4107               run diasize_change-height in this-procedure
     4108                 (input  integer(v-resize-value-str)
     4109                 ,input  true
     4110                 ) .
     4111               assign
     4112                 v-restore-saved = true
     4113               .
     4114             end.
     4115           end.
     4116           if connected("ub") = true
     4117           then do:
     4118             run gbl/wndsizer.p
     4119               (input  v-cntxt-db-num
     4120               ,input  v-cntxt-userid
     4121               ,input  v-diasize-proc-name
     4122               ,input  'width':u
     4123               ,output v-resize-value-str
     4124               ) .
     4125             if v-resize-value-str <> '':U
     4126             then do:
     4127               run diasize_change-width in this-procedure
     4128                 (input  integer(v-resize-value-str)
     4129                 ,input  true
     4130                 ) .
     4131               assign
     4132                 v-restore-saved = true
     4133               .
     4134             end.
     4135           end.
     4136           if v-restore-saved <> true
     4137           then do:
     4138             if v-diasize-wndmax = true
     4139             then do:
     4140               run diasize_maximize in this-procedure
     4141                 (input  true
     4142                 ) .
     4143             end.
     4144           end.
     4145         end.
     4146         else do:
     4147           if v-diasize-wndmax = true
     4148           then do:
     4149             run diasize_maximize in this-procedure
     4150               (input  true
     4151               ) .
     4152           end.
     4153         end.
     4154       end.
     4155     end.
     4156   end procedure.
     4157   procedure diasize_need-full-display :
     4158     define output parameter p-need-full-display as logical   no-undo .
     4159     do
     4160     on error undo, return error return-value
     4161     :
     4162       assign
     4163         p-need-full-display = v-diasize-need-full-display
     4164       .
