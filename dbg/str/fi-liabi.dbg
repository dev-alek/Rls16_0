     4356       .
     4357       if v-curr-sv-date = ?
     4358       then do:
     4359         run gbl/getcurdt.p
     4360           (output v-curr-sv-date
     4361           ) .
     4362       end.
     4363       if v-curr-sv-date <> ?
     4364       then do:
     4365         run gbl/d-inpday.w
     4366           (input ?
     4367           ,input "Выбор даты"
     4368           ,input v-description
     4369           ,input ""
     4370           ,input-output v-curr-sv-date
     4371           ,output v-ok
     4372           ).
     4373         if v-ok = true
     4374         then do:
     4375           assign
     4376             self :screen-value = string(v-curr-sv-date) .
     4377           .
     4378         end.
     4379       end.
     4380     end.
     4381     return no-apply .
     4382   end.
