     4485   run disable_UI.
     4486   PROCEDURE calc-tax :
     4487    do
     4488    on error undo, return error return-value
     4489    :
     4490   define variable v-nalog  as decimal no-undo .
     4491     v-nalog = 0 .
     4492     for each  tt_fin-ob-tax :
     4493        v-nalog = v-nalog + ( tt_fin-ob-tax.sum-vat-line-doc + tt_fin-ob-tax.sum-slt-line-doc ) .
     4494     end.
     4495     loc_sum-tax-doc       = v-nalog .
     4496     loc_sum-tax-rubl      = (  loc_exch-rate       / loc_exch-scale   ) * loc_sum-tax-doc  .
     4497     loc_sum-tax-base      = (  loc_base-scale      / loc_base-rate    ) * loc_sum-tax-rubl .
     4498     loc_sum-tax-contract  = (  loc_contract-scale  / loc_contract-rate) * loc_sum-tax-rubl .
     4499     display
     4500       loc_sum-tax-doc      when loc_sum-tax-doc:visible
     4501       loc_sum-tax-base     when loc_sum-tax-base     :visible
     4502       loc_sum-tax-rubl     when loc_sum-tax-rubl     :visible
     4503       loc_sum-tax-contract when loc_sum-tax-contract :visible
     4504       with frame Dialog-Frame
     4505       .
     4506     end.
     4507   END PROCEDURE.
     4508   PROCEDURE create-tax :
     4509   define input parameter  v-sum-doc    as decimal no-undo .
     4510   define input parameter  v-sum-rubl   as decimal no-undo .
     4511   define input parameter  v-sum-base   as decimal no-undo .
     4512   define input parameter  v-sum-contr  as decimal no-undo .
     4513   define input parameter  v-type as character no-undo .
     4514   define output parameter v-tax  as decimal no-undo .
     4515   define variable v-1 as decimal no-undo .
     4516   define variable  v-col as integer init 0  no-undo .
     4517   define variable v-ok as logical init true no-undo .
     4518   define variable v-vat-pc-init as decimal init ? no-undo .
     4519   define variable v-slt-pc-init as decimal init ? no-undo .
     4520   for each tt_fin-ob-tax :
     4521       v-col = v-col + 1 .
     4522       v-vat-pc-init = tt_fin-ob-tax.vat-pc .
     4523       v-slt-pc-init = tt_fin-ob-tax.slt-pc .
     4524   end.
     4525   if v-vat-pc-init = ? then v-vat-pc-init = glob-vat-pc .
     4526   if v-slt-pc-init = ? then v-slt-pc-init = glob-slt-pc .
     4527       if v-col > 1 then do:
     4528           v-ok = true .
     4529           message
     4530                   "Вы уже ввели несколько строк сумм оплат"   skip
     4531                   "с разбивкой по налогам!"                   skip "" skip
     4532                   "Да- Создать одну новую"                   skip
     4533                   "Нет - Оставить введенные строки"           skip
     4534                   view-as alert-box question
     4535                   buttons yes-no
     4536                   update v-ok .
     4537       end.
     4538       if not v-ok then return .
     4539   if v-col = 1 then do:
     4540      find first  tt_fin-ob-tax no-error .
     4541   end.
     4542   if v-col > 1  or v-col = 0 then do:
     4543     for each tt_fin-ob-tax : delete tt_fin-ob-tax. end.
     4544     v-vat-pc-init = glob-vat-pc .
     4545     v-slt-pc-init = glob-slt-pc .
     4546     create tt_fin-ob-tax.
     4547   end.
     4548   assign
     4549       tt_fin-ob-tax.doc-code                =  p-doc-code
     4550       tt_fin-ob-tax.host-code               =  par-host-code
     4551       tt_fin-ob-tax.line-num                =  1
     4552       tt_fin-ob-tax.sum-line-doc            = v-sum-doc
     4553       tt_fin-ob-tax.sum-line-base           = v-sum-base
     4554       tt_fin-ob-tax.sum-line-contr          = v-sum-contr
     4555       tt_fin-ob-tax.sum-line-rubl           = v-sum-rubl
     4556       tt_fin-ob-tax.with-slt                = true
     4557       tt_fin-ob-tax.slt-pc                  = v-slt-pc-init
     4558       tt_fin-ob-tax.sum-slt-line-doc        = tt_fin-ob-tax.slt-PC *  tt_fin-ob-tax.sum-line-doc   / ( 100 + tt_fin-ob-tax.slt-PC )
     4559       tt_fin-ob-tax.sum-slt-line-base       = tt_fin-ob-tax.slt-PC *  tt_fin-ob-tax.sum-line-base  / ( 100 + tt_fin-ob-tax.slt-PC )
     4560       tt_fin-ob-tax.sum-slt-line-contr      = tt_fin-ob-tax.slt-PC *  tt_fin-ob-tax.sum-line-contr / ( 100 + tt_fin-ob-tax.slt-PC )
     4561       tt_fin-ob-tax.sum-slt-line-rubl       = tt_fin-ob-tax.slt-PC *  tt_fin-ob-tax.sum-line-rubl  / ( 100 + tt_fin-ob-tax.slt-PC )
     4562       tt_fin-ob-tax.with-vat                = true
     4563       tt_fin-ob-tax.vat-pc                  = v-vat-pc-init
     4564       tt_fin-ob-tax.sum-vat-line-doc        = tt_fin-ob-tax.vat-PC * (( tt_fin-ob-tax.sum-line-doc   - tt_fin-ob-tax.sum-slt-line-doc   ) / ( 100  + tt_fin-ob-tax.vat-PC))
     4565       tt_fin-ob-tax.sum-vat-line-base       = tt_fin-ob-tax.vat-PC * (( tt_fin-ob-tax.sum-line-base  - tt_fin-ob-tax.sum-slt-line-base  ) / ( 100  + tt_fin-ob-tax.vat-PC))
     4566       tt_fin-ob-tax.sum-vat-line-contr      = tt_fin-ob-tax.vat-PC * (( tt_fin-ob-tax.sum-line-contr - tt_fin-ob-tax.sum-slt-line-contr ) / ( 100  + tt_fin-ob-tax.vat-PC))
     4567       tt_fin-ob-tax.sum-vat-line-rubl       = tt_fin-ob-tax.vat-PC * (( tt_fin-ob-tax.sum-line-rubl  - tt_fin-ob-tax.sum-slt-line-rubl  ) / ( 100  + tt_fin-ob-tax.vat-PC))
     4568   .
     4569   case v-type :
     4570   when "doc":U then do:
     4571         v-tax = tt_fin-ob-tax.sum-slt-line-doc + tt_fin-ob-tax.sum-vat-line-doc.
     4572   end.
     4573   when "rubl":U then do:
     4574         v-tax = tt_fin-ob-tax.sum-slt-line-rubl + tt_fin-ob-tax.sum-vat-line-rubl.
     4575   end.
     4576   when "base":U then do:
     4577         v-tax = tt_fin-ob-tax.sum-slt-line-base + tt_fin-ob-tax.sum-vat-line-base.
     4578   end.
     4579   when "contract":U then do:
     4580         v-tax = tt_fin-ob-tax.sum-slt-line-contr + tt_fin-ob-tax.sum-vat-line-contr.
     4581   end.
     4582   end case.
     4583   OPEN QUERY BROWSE-1 FOR EACH tt_fin-ob-tax NO-LOCK.
     4584   END PROCEDURE.
     4585   PROCEDURE disable-contract :
     4586    do
     4587    on error undo, return error return-value
     4588    :
     4589   run from-contract (
     4590       input loc_contract-code-id ,
     4591       input par-host-code               ,
     4592       input 'singl-mode':u
     4593         ) no-error .
     4594     if error-status :error then do:
     4595        message vss-workfile vss-revision vss-description skip
     4596                error-status :get-message(1) skip
     4597                "из договора"
     4598                view-as alert-box error .
     4599        return error.
     4600        end.
     4601   disable loc_contract-code  r-con
     4602           loc_payer-code     r-obj
     4603           loc_receiver-code  r-cli
     4604           loc_sum-doc  loc_sum-tax-doc
     4605           loc_sum-rubl loc_sum-tax-rubl
     4606           loc_sum-base loc_sum-tax-base
     4607           loc_sum-contract loc_sum-tax-contract
     4608           loc_exch-rate
     4609           loc_exch-scale
     4610           loc_base-rate
     4611           loc_base-scale
     4612           loc_contract-rate
     4613           loc_contract-scale
     4614           t-doc
     4615           t-rubl
     4616           t-base
     4617           t-contract
     4618           b-ins
     4619           b-chg
     4620           b-del
     4621           radio-set-dogovor
     4622           r-cur
     4623      with frame Dialog-Frame .
     4624     end.
     4625   END PROCEDURE.
     4626   PROCEDURE disable_UI :
     4627     HIDE FRAME Dialog-Frame.
     4628   END PROCEDURE.
     4629   PROCEDURE enable_UI :
     4630     DISPLAY RADIO-SET-dogovor loc_contract-code loc_pay-date loc_receiver-code
     4631             loc_prn-doc-code loc_payer-code loc_corr-doc loc_exch-rate
     4632             loc_exch-scale loc_sum-doc loc_sum-tax-doc loc_sum-rubl
     4633             loc_sum-tax-rubl loc_base-rate loc_base-scale loc_sum-base
     4634             loc_sum-tax-base loc_contract-rate loc_contract-scale loc_sum-contract
     4635             loc_sum-tax-contract loc_PS FI-obj FI-obj-type FI-obj-code FI-obj-name
     4636             loc_doc-date loc_fact-date p-doc-code loc_receiver-type
     4637             loc_receiver-name f-receiver loc_payer-type loc_payer-name f-payer
     4638             FILL-IN-4 FILL-IN-5 FILL-IN-6 FILL-IN-7 loc_curr-code loc_abbr-doc
     4639             loc_abbr-rubl loc_abbr-base f-contract-curr loc_contract-curr
     4640             loc_abbr-contract
     4641         WITH FRAME Dialog-Frame.
     4642     ENABLE b-exit b-quit B-contract B-receiver B-payer B-parts B-hist B-help
     4643            RECT-1 RECT-2 RECT-4 RECT-5 RADIO-SET-dogovor loc_contract-code r-con
     4644            loc_pay-date loc_receiver-code r-cli loc_prn-doc-code loc_payer-code
     4645            loc_corr-doc r-obj r-cur loc_exch-rate loc_exch-scale loc_sum-doc
     4646            loc_sum-contract BROWSE-1 B-calc-exch B-ins B-chg B-del loc_PS FI-obj
     4647            FI-obj-type FI-obj-code FI-obj-name loc_doc-date loc_fact-date
     4648            loc_receiver-type loc_receiver-name f-receiver loc_payer-type
     4649            loc_payer-name f-payer FILL-IN-4 FILL-IN-5 FILL-IN-6 FILL-IN-7
     4650            loc_curr-code loc_abbr-doc loc_abbr-rubl loc_abbr-base f-contract-curr
     4651            loc_contract-curr loc_abbr-contract
     4652         WITH FRAME Dialog-Frame.
     4653     VIEW FRAME Dialog-Frame.
     4654     OPEN QUERY BROWSE-1 FOR EACH tt_fin-ob-tax NO-LOCK.
     4655   END PROCEDURE.
     4656   PROCEDURE from-contract :
     4657    do
     4658    on error undo, return error return-value
     4659    :
     4660   define input parameter p-code like contract.contract-code no-undo .
     4661   define input parameter p-host-code like contract.host-code no-undo .
     4662   define input parameter p-local-mode as character no-undo .
     4663   define buffer buf_contract for contract.
     4664     find first buf_contract no-lock where buf_contract.contract-code = p-code
     4665                                       and buf_contract.host-code     = p-host-code
     4666                                       no-error .
     4667   if error-status :error then do:
     4668      message error-status :get-message(1) "from-contract".
     4669      return error .
     4670      end.
     4671   define variable v-num as integer no-undo .
     4672   define variable v-buttons as character no-undo .
     4673   define variable v-desc as character no-undo .
     4674   define variable v-t as character no-undo .
     4675   if p-doc-type = 'при':U then assign
     4676     v-t = "Плательщика"
     4677   .
     4678   else assign
     4679     v-t = "Получателя"
     4680   .
     4681   v-num = 1.
     4682   if not( buf_contract.posr-name = "" and
     4683           buf_contract.agnt-name = "" ) then do:
     4684       v-buttons  = "Контрагент" + "|" +
     4685                   (if buf_contract.posr-name <> "" then "Посредник" else "Посредник^disable") + "|" +
     4686                   (if buf_contract.agnt-name <> "" then "Агент"     else "Агент^disable" )    + "|" +
     4687                   "Отмена"
     4688       .
     4689       v-desc     = buf_contract.cli-name + "|" +
     4690                   buf_contract.posr-name + "|" +
     4691                   buf_contract.agnt-name + "|" +
     4692                   "Не выбираем ни кого"
     4693         .
     4694       IF p-local-mode = 'singl-mode':u THEN v-num = 1.
     4695          ELSE
     4696           run gbl/d-askw.w
     4697             (input "Внимание!"
     4698             ,input "Выберите " + v-t + " по фин.обязательству."
     4699             ,input "|^"
     4700             ,input v-buttons
     4701             ,input v-desc
     4702             ,input 1
     4703             ,input 4
     4704             ,output v-num
     4705             ).
     4706   end.
     4707   if v-num = 4 then do:
     4708      return error .
     4709   end.
     4710     case p-doc-type :
     4711     when 'при':U then do:
     4712      case v-num :
     4713        when 1 then do:
     4714         assign
     4715           loc_payer-code       =  buf_contract.cli-code
     4716           loc_payer-type       =  buf_contract.cli-type
     4717           loc_payer-name       =  buf_contract.cli-name
     4718           .
     4719        end.
     4720        when 2 then do:
     4721         assign
     4722           loc_payer-code       =  buf_contract.posr-code
     4723           loc_payer-type       =  buf_contract.posr-type
     4724           loc_payer-name       =  buf_contract.posr-name
     4725           .
     4726        end.
     4727        when 3 then do:
     4728         assign
     4729           loc_payer-code       =  buf_contract.agnt-code
     4730           loc_payer-type       =  buf_contract.agnt-type
     4731           loc_payer-name       =  buf_contract.agnt-name
     4732           .
     4733        end.
     4734        end case.
     4735          assign
     4736           loc_receiver-code       =  par-host-code
     4737           loc_receiver-type       =  'орг':U
     4738           loc_receiver-name       =  buf_contract.own-name
     4739         .
     4740     end.
     4741     when 'рас':U then do:
     4742        case v-num :
     4743        when 1 then do:
     4744             assign
     4745                 loc_receiver-code       =  buf_contract.cli-code
     4746                 loc_receiver-type       =  buf_contract.cli-type
     4747                 loc_receiver-name       =  buf_contract.cli-name
     4748                 .
     4749        end.
     4750        when 2 then do:
     4751             assign
     4752                 loc_receiver-code       =  buf_contract.posr-code
     4753                 loc_receiver-type       =  buf_contract.posr-type
     4754                 loc_receiver-name       =  buf_contract.posr-name
     4755                 .
     4756        end.
     4757        when 3 then do:
     4758             assign
     4759                 loc_receiver-code       =  buf_contract.agnt-code
     4760                 loc_receiver-type       =  buf_contract.agnt-type
     4761                 loc_receiver-name       =  buf_contract.agnt-name
     4762                 .
     4763        end.
     4764        end case.
     4765           assign
     4766           loc_payer-code       =  par-host-code
     4767           loc_payer-type       =  'орг':U
     4768           loc_payer-name       =  buf_contract.own-name
     4769         .
     4770     end.
     4771     end case.
     4772     assign
     4773       loc_contract-code-id   =  buf_contract.contract-code
     4774       loc_contract-curr      =  buf_contract.curr-code
     4775       .
     4776   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4777   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     4778     (input  loc_contract-curr
     4779     ,input  loc_doc-date
     4780     ,output loc_contract-rate
     4781     ,output loc_contract-scale
     4782     ,output loc_abbr-contract
     4783     )  .
     4784       display
     4785         loc_receiver-code
     4786         loc_receiver-name
     4787         loc_receiver-type
     4788         loc_abbr-contract
     4789         loc_payer-code
     4790         loc_payer-name
     4791         loc_payer-type
     4792         loc_contract-curr
     4793         loc_contract-rate
     4794         loc_contract-scale
     4795       with frame Dialog-Frame .
     4796    if loc_sum-contract:visible then
     4797       apply "LEAVE" to loc_sum-contract in frame Dialog-Frame .
     4798    run hide-curr ( input "contract":U ) .
     4799     end.
     4800   END PROCEDURE.
     4801   PROCEDURE hide-curr :
     4802    define input parameter p-mode as character no-undo .
     4803    do
     4804    on error undo, return error return-value
     4805    with frame Dialog-Frame :
     4806     disable loc_exch-rate  loc_exch-scale  .
     4807    case p-mode :
     4808    when "init" then do:
     4809         if loc_curr-code = 0 then do:
     4810           hide loc_sum-rubl loc_sum-tax-rubl loc_abbr-rubl in frame Dialog-Frame .
     4811         end.
     4812         if p-basecode = 0 then do:
     4813           hide loc_base-rate loc_base-scale loc_sum-base loc_sum-tax-base loc_abbr-base in frame Dialog-Frame .
     4814         end.
     4815         if loc_contract-curr = 0  or
     4816             (   loc_contract-curr = p-basecode
     4817              and loc_contract-rate = loc_base-rate ) then do:
     4818             hide loc_contract-rate loc_contract-scale loc_sum-contract loc_sum-tax-contract f-contract-curr loc_contract-curr loc_abbr-contract in frame Dialog-Frame .
     4819         end.
     4820    end.
     4821    when "contract" then do:
     4822         if  loc_contract-curr = 0  or
     4823             loc_contract-curr = p-basecode or
     4824             loc_contract-curr = loc_curr-code  then do:
     4825             hide loc_contract-rate loc_contract-scale loc_sum-contract loc_sum-tax-contract f-contract-curr loc_contract-curr loc_abbr-contract in frame Dialog-Frame .
     4826         end.
     4827         else do:
     4828            display  loc_contract-rate loc_contract-scale loc_sum-contract loc_sum-tax-contract f-contract-curr loc_contract-curr loc_abbr-contract .
     4829         end.
     4830    end.
     4831    when "pay" then do:
     4832         if loc_curr-code <> 0 then do:
     4833           display loc_sum-rubl loc_sum-tax-rubl loc_abbr-rubl  .
     4834         end.
     4835         else do:
     4836             hide loc_sum-rubl loc_sum-tax-rubl loc_abbr-rubl .
     4837         end.
     4838         if ( p-basecode = loc_curr-code and
     4839              loc_exch-rate = loc_base-rate )
     4840            or
     4841            p-basecode = 0   then do:
     4842           hide loc_base-rate loc_base-scale loc_sum-base loc_sum-tax-base loc_abbr-base in frame Dialog-Frame .
     4843         end.
     4844         else do:
     4845            display  loc_base-rate loc_base-scale loc_sum-base loc_sum-tax-base loc_abbr-base .
     4846         end.
     4847         if  loc_contract-curr = 0  or
     4848             (loc_contract-curr = p-basecode  and
     4849              loc_contract-rate = loc_base-rate)
     4850             or
     4851             (loc_contract-curr = loc_curr-code  and
     4852              loc_exch-rate = loc_contract-rate )
     4853             then do:
     4854             hide loc_contract-rate loc_contract-scale loc_sum-contract loc_sum-tax-contract f-contract-curr loc_contract-curr loc_abbr-contract in frame Dialog-Frame .
     4855         end.
     4856         else do:
     4857            display  loc_contract-rate loc_contract-scale loc_sum-contract loc_sum-tax-contract f-contract-curr loc_contract-curr loc_abbr-contract .
     4858         end.
     4859    end.
     4860    when "lookup" then do:
     4861         if loc_curr-code <> 0 then do:
     4862           display loc_sum-rubl loc_sum-tax-rubl loc_abbr-rubl  .
     4863         end.
     4864         else do:
     4865             hide loc_sum-rubl loc_sum-tax-rubl loc_abbr-rubl .
     4866         end.
     4867         if ( p-basecode = loc_curr-code
     4868             and loc_exch-rate = loc_base-rate)
     4869            or
     4870            p-basecode = 0   then do:
     4871           hide loc_base-rate loc_base-scale loc_sum-base loc_sum-tax-base loc_abbr-base in frame Dialog-Frame .
     4872         end.
     4873         else do:
     4874            display  loc_base-rate loc_base-scale loc_sum-base loc_sum-tax-base loc_abbr-base .
     4875         end.
     4876         if  loc_contract-curr = 0  or
     4877             (loc_contract-curr = p-basecode  and
     4878              loc_contract-rate = loc_base-rate)
     4879             or
     4880             (loc_contract-curr = loc_curr-code  and
     4881              loc_exch-rate = loc_contract-rate )
     4882              then do:
     4883             hide loc_contract-rate loc_contract-scale loc_sum-contract loc_sum-tax-contract f-contract-curr loc_contract-curr loc_abbr-contract in frame Dialog-Frame .
     4884         end.
     4885         else do:
     4886            display  loc_contract-rate loc_contract-scale loc_sum-contract loc_sum-tax-contract f-contract-curr loc_contract-curr loc_abbr-contract .
     4887         end.
     4888         hide b-quit in frame Dialog-Frame .
     4889    end.
     4890   end case .
     4891     end.
     4892   END PROCEDURE.
     4893   PROCEDURE init-p :
     4894    do
     4895    on error undo, return error return-value
     4896    :
     4897   define buffer buff_contract for contract.
     4898   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4899   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     4900     (input  par-host-code
     4901     ,output p-basecode
     4902     )  .
     4903       find first sysconf no-lock where sysconf.host-code = par-host-code no-error .
     4904       glob-vat-pc  = sysconf.fin-vat-pc .
     4905       glob-slt-pc  = sysconf.fin-slt-pc .
     4906       var-fin-calc = sysconf.fin-calc   .
     4907       define variable g-log as logical no-undo.
     4908       define variable v-view as character no-undo .
     4909       if ref-mode =  'ДОБАВЛЕНИЕ':U
     4910           then  do:
     4911               ri = ?.
     4912               run fin-ob-code (input g#db-num , output p-doc-code) .
     4913               assign
     4914                     p-prn-doc-code     = string(p-doc-code)
     4915                     p-host-code        = par-host-code
     4916                     p-doc-date         = today
     4917                     p-status_          = 'новый':U
     4918                     p-payer-name       = ""
     4919                     p-receiver-name    = ""
     4920                     p-payer-code       = 0
     4921                     p-receiver-code    = 0
     4922                     p-payer-type       = 'орг':U
     4923                     p-receiver-type    = 'орг':U
     4924                     p-in-type          = 0
     4925                     p-sum-doc          = 0
     4926                     p-user-db-num-doc  = g#db-num
     4927                     p-user-name-doc    = g#userid
     4928                     radio-set-dogovor  = YES
     4929               .
     4930                     define buffer b#clients for clients.
     4931                     find first b#clients WHERE
     4932                           b#clients.obj-code = par-host-code and
     4933                           b#clients.obj-type = 'орг':U
     4934                           No-LOCK No-ERROR.
     4935                     if p-doc-type <> 'при':U then do:
     4936                         if avail b#clients then
     4937                             Assign
     4938                                 p-payer-code = b#clients.obj-code
     4939                                 p-payer-type = b#clients.obj-type
     4940                                 p-payer-name = b#clients.obj-name .
     4941                     end.
     4942                     else do:
     4943                         if avail b#clients then
     4944                             Assign
     4945                                 p-receiver-code = b#clients.obj-code
     4946                                 p-receiver-type = b#clients.obj-type
     4947                                 p-receiver-name = b#clients.obj-name .
     4948                     end.
     4949   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4950   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     4951     (input  par-host-code
     4952     ,input  today
     4953     ,output p-base-rate
     4954     ,output p-base-scale
     4955     )  .
     4956                 p-curr-code  = 0.
     4957                 p-exch-rate  = 1.
     4958                 p-exch-scale = 1.
     4959                 p-contract-curr  = p-basecode  .
     4960                 p-contract-rate  = p-base-rate .
     4961                 p-contract-scale = p-base-scale.
     4962               assign
     4963                 loc_base-rate          =  p-base-rate
     4964                 loc_base-scale         =  p-base-scale
     4965                 loc_receiver-code      =  p-receiver-code
     4966                 loc_receiver-name      =  p-receiver-name
     4967                 loc_receiver-type      =  p-receiver-type
     4968                 loc_contract-code-id   =  p-contract-code
     4969                 loc_curr-code          =  p-curr-code
     4970                 loc_doc-date           =  p-doc-date
     4971                 loc_exch-rate          =  p-exch-rate
     4972                 loc_exch-scale         =  p-exch-scale
     4973                 loc_fact-date          =  p-fact-date
     4974                 loc_payer-code         =  p-payer-code
     4975                 loc_payer-name         =  p-payer-name
     4976                 loc_payer-type         =  p-payer-type
     4977                 loc_pay-date           =  p-pay-date
     4978                 loc_prn-doc-code       =  p-prn-doc-code
     4979                 loc_sum-base           =  p-sum-base
     4980                 loc_sum-doc            =  p-sum-doc
     4981                 loc_sum-rubl           =  p-sum-rubl
     4982                 loc_doc-type           =  p-doc-type
     4983                 loc_status_            =  p-status_
     4984                 loc_in-type            =  p-in-type
     4985                 loc_sum-tax-rubl       =  p-sum-tax-rubl
     4986                 loc_sum-tax-base       =  p-sum-tax-base
     4987                 loc_sum-tax-doc        =  p-sum-tax-doc
     4988                 loc_contract-curr     = p-contract-curr
     4989                 loc_contract-rate     = p-contract-rate
     4990                 loc_contract-scale    = p-contract-scale
     4991                 loc_sum-contract      = p-sum-contract
     4992                 loc_sum-tax-contract  = p-sum-tax-contract
     4993                 loc_contract-code   = ""
     4994                 loc_abbr-contract   = ""
     4995                 .
     4996       end.
     4997       else dO:
     4998          find fin-ob where recid( fin-ob ) = ri no-error .
     4999          if error-status :error then return  error .
     5000               assign
     5001                 p-doc-code             =  fin-ob.doc-code
     5002                 loc_base-rate          =  fin-ob.base-rate
     5003                 loc_base-scale         =  fin-ob.base-scale
     5004                 loc_receiver-code      =  fin-ob.receiver-code
     5005                 loc_receiver-name      =  fin-ob.receiver-name
     5006                 loc_receiver-type      =  fin-ob.receiver-type
     5007                 loc_contract-code-id   =  fin-ob.contract-code
     5008                 radio-set-dogovor      =  IF ( fin-ob.contract-code = 0 OR fin-ob.contract-code = ?)
     5009                                              THEN NO ELSE YES
     5010                 loc_curr-code          =  fin-ob.curr-code
     5011                 loc_doc-date           =  fin-ob.doc-date
     5012                 loc_exch-rate          =  fin-ob.exch-rate
     5013                 loc_exch-scale         =  fin-ob.exch-scale
     5014                 loc_fact-date          =  fin-ob.fact-date
     5015                 loc_payer-code         =  fin-ob.payer-code
     5016                 loc_payer-name         =  fin-ob.payer-name
     5017                 loc_payer-type         =  fin-ob.payer-type
     5018                 loc_pay-date           =  fin-ob.pay-date
     5019                 loc_prn-doc-code       =  fin-ob.prn-doc-code
     5020                 loc_sum-base           =  fin-ob.sum-base
     5021                 loc_sum-doc            =  fin-ob.sum-doc
     5022                 loc_sum-rubl           =  fin-ob.sum-rubl
     5023                 loc_doc-type           =  fin-ob.doc-type
     5024                 loc_status_            =  fin-ob.status_
     5025                 loc_in-type            =  fin-ob.in-type
     5026                 loc_sum-tax-rubl       =  fin-ob.sum-tax-rubl
     5027                 loc_sum-tax-base       =  fin-ob.sum-tax-base
     5028                 loc_sum-tax-doc        =  fin-ob.sum-tax-doc
     5029                 loc_contract-curr      =  fin-ob.contract-curr
     5030                 loc_contract-rate      =  fin-ob.contract-rate
     5031                 loc_contract-scale     =  fin-ob.contract-scale
     5032                 loc_sum-contract       =  fin-ob.sum-contract
     5033                 loc_sum-tax-contract   =  fin-ob.sum-tax-contract
     5034                 loc_ps                 =  fin-ob.ps
     5035                 loc_corr-doc           =  fin-ob.corr-doc
     5036                 .
     5037     assign
     5038       fi-obj-type            =  fin-ob.obj-type
     5039       fi-obj-code            =  fin-ob.obj-code
     5040     .
     5041    define buffer b2#clients for clients .
     5042       find first b2#clients where
     5043           b2#clients.obj-code = fi-obj-code and
     5044           b2#clients.obj-type = fi-obj-type
     5045           no-lock no-error.
     5046       if available b2#clients then do:
     5047           fi-obj-name = b2#clients.obj-name.
     5048       end.
     5049       find first buff_contract no-lock where buff_contract.host-code = fin-ob.host-code and
     5050                                              buff_contract.contract-code = fin-ob.contract-code no-error .
     5051       if available buff_contract then
     5052          loc_contract-code        =  buff_contract.contract-prn-code .
     5053          else loc_contract-code   = "".
     5054       loc_abbr-contract  = sel-abbr(loc_contract-curr) .
     5055   end.
     5056       loc_abbr-base = "Баз.вал "  + sel-abbr(p-basecode) .
     5057       loc_abbr-doc  = sel-abbr(loc_curr-code) .
     5058       case loc_in-type :
     5059         when 0 then do:
     5060           t-doc = yes.
     5061         end.
     5062         when 1 then do:
     5063           t-base = yes.
     5064         end.
     5065         when 2 then do:
     5066           t-rubl = yes.
     5067         end.
     5068         when 3 then do:
     5069           t-contract = yes.
     5070         end.
     5071       end case.
     5072       ASSIGN
     5073       loc_in-type = 0
     5074       t-doc = YES
     5075       t-base = NO
     5076       t-rubl = NO
     5077       t-contract = NO
     5078           .
     5079      define buffer buf_fin-ob-tax for fin-ob-tax.
     5080      for each tt_fin-ob-tax : delete tt_fin-ob-tax. end.
     5081      for each buf_fin-ob-tax no-lock where
     5082               buf_fin-ob-tax.host-code = par-host-code and
     5083               buf_fin-ob-tax.doc-code  = p-doc-code
     5084      :
     5085         create tt_fin-ob-tax.
     5086         BUFFER-COPY buf_fin-ob-tax to tt_fin-ob-tax .
     5087      end.
     5088      OPEN QUERY BROWSE-1 FOR EACH tt_fin-ob-tax NO-LOCK.
     5089      define variable loc_doc-type-fff as character no-undo .
     5090      if loc_doc-type = 'при':U then loc_doc-type-fff = "с покупателем " .
     5091         else  loc_doc-type-fff = "с поставщиком " .
     5092      ASSIGN frame Dialog-Frame:TITLE = "Фин.обязательство  "  + " № " + loc_prn-doc-code
     5093      + " Тип: " +     loc_doc-type-fff
     5094      + " Статус: "  +  loc_status_
     5095      + " - " + caps(ref-mode).
     5096     end.
     5097   END PROCEDURE.
