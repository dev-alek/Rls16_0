     4259   on ctrl-b of loc_pay-date in frame Dialog-Frame
     4260   do:
     4261     if (can-query (self, "sensitive")
     4262        and
     4263        self :sensitive = true
     4264        )
     4265     or (can-query (self, "read-only")
     4266        and
     4267        self :read-only = false
     4268        )
