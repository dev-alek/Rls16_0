     4170   procedure get-context :
     4171      define output parameter p-db-num as integer          no-undo.
     4172      define output parameter p-user-id as character        no-undo.
     4173      define variable v-login               as character    no-undo.
     4174      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4175      define buffer buf_user-login  for ub.user-login .
     4176      do
     4177      on error undo, return error
     4178      :
     4179            FIND FIRST buf_sys-ctrl no-lock.
     4180            ASSIGN
     4181               v-login = USERID("ub")
     4182               p-db-num = buf_sys-ctrl.db-num
     4183            .
     4184            FIND FIRST buf_user-login
     4185                 WHERE buf_user-login.db-num = p-db-num
     4186                   AND buf_user-login.user-login = v-login
     4187                 no-lock
     4188                 no-error
     4189                 .
     4190            IF AVAILABLE buf_user-login
     4191            THEN DO:
     4192               assign
     4193                  p-user-id = buf_user-login.user-id
     4194               .
     4195            END.
     4196      end.
     4197   end procedure.
     4198       run diasize_init in this-procedure .
