     5250   PROCEDURE next-focus :
     5251    do
     5252    on error undo, return error return-value
     5253    :
     5254     define input parameter p-widget-handle as handle no-undo .
     5255     define variable l-apply-entry as logical no-undo .
     5256     assign
     5257       l-apply-entry =   true
     5258     .
     5259     do with frame Dialog-Frame :
     5260       if  loc_prn-doc-code   :handle = p-widget-handle then do:  if loc_contract-code    :sensitive then do:
     5261                                                                                           apply "entry":u to loc_contract-code .  return .
     5262                                                                                           end.
     5263                                                                                           else do:  if loc_pay-date      :sensitive then do:
     5264                                                                                                     apply "entry":u to loc_pay-date      .  return . end.
     5265                                                                                           end.
     5266       end.
     5267       if  radio-set-dogovor  :handle = p-widget-handle then do:  if loc_contract-code    :sensitive
     5268                                                                     then do: apply "entry":u to loc_contract-code .  return . end.
     5269                                                                     else do:  if loc_pay-date      :sensitive then do: apply "entry":u to loc_pay-date      .  return . end. end.
     5270       end.
     5271       if  loc_contract-code  :handle = p-widget-handle then do:  if loc_pay-date      :sensitive then do: apply "entry":u to loc_pay-date      .  return . end. end.
     5272       if  loc_pay-date       :handle = p-widget-handle then do:  if loc_receiver-code :sensitive then do: apply "entry":u to loc_receiver-code .  return . end. end.
     5273       if  loc_receiver-code  :handle = p-widget-handle then do:  if loc_payer-code    :sensitive then do:
     5274                                                                    apply "entry":u to loc_payer-code    .  return .
     5275                                                                  end.
     5276                                                                  else do:
     5277                                                                     if loc_sum-doc      :sensitive then do: apply "entry":u to loc_sum-doc      .  return . end.
     5278                                                                     if loc_sum-base     :sensitive then do: apply "entry":u to loc_sum-base     .  return . end.
     5279                                                                     if loc_sum-rubl     :sensitive then do: apply "entry":u to loc_sum-rubl     .  return . end.
     5280                                                                     if loc_sum-contract :sensitive then do: apply "entry":u to loc_sum-contract .  return . end.
     5281                                                                  end.
     5282                                                             end.
     5283       if  loc_payer-code     :handle = p-widget-handle then do:
     5284           if loc_sum-doc      :sensitive then do: apply "entry":u to loc_sum-doc      .  return . end.
     5285           if loc_sum-base     :sensitive then do: apply "entry":u to loc_sum-base     .  return . end.
     5286           if loc_sum-rubl     :sensitive then do: apply "entry":u to loc_sum-rubl     .  return . end.
     5287           if loc_sum-contract :sensitive then do: apply "entry":u to loc_sum-contract .  return . end.
     5288       end.
     5289       if  loc_sum-doc        :handle = p-widget-handle then do:  if B-chg     :sensitive then do:       apply "entry":u to B-chg     .        return . end. end.
     5290       if  loc_sum-base       :handle = p-widget-handle then do:  if B-chg     :sensitive then do:       apply "entry":u to B-chg     .        return . end. end.
     5291       if  loc_sum-rubl       :handle = p-widget-handle then do:  if B-chg     :sensitive then do:       apply "entry":u to B-chg     .        return . end. end.
     5292       if  loc_sum-contract   :handle = p-widget-handle then do:  if B-chg     :sensitive then do:       apply "entry":u to B-chg     .        return . end. end.
     5293       if  b-chg              :handle = p-widget-handle then do:  if B-exit    :sensitive then do:       apply "entry":u to B-exit    .        return . end. end.
     5294       end.
     5295     end.
     5296   END PROCEDURE.
     5297   PROCEDURE save-p :
     5298   do
     5299    on error undo, return error return-value
     5300    :
     5301   if ref-mode <> 'ПРОСМОТР':U then do:
     5302          if loc_sum-doc  = 0 or loc_sum-doc  = ?  or
     5303             loc_sum-base = 0 or loc_sum-base = ?  or
     5304             loc_sum-rubl = 0 or loc_sum-rubl = ?  then do:
     5305             message "Не задана сумма финансового обязательства !" view-as alert-box information  title "Ошибка при вводе".
     5306             return error.
     5307         end.
     5308         if var-fin-calc = 1 and ( fi-obj-code = 0 or fi-obj-code = ? )  then do:
     5309           message "Не задан Объект !"  view-as alert-box information  title "Ошибка при вводе".
     5310           return error .
     5311         end.
     5312         if loc_receiver-code = 0 or loc_receiver-code = ? then do:
     5313           message "Не задан код получателя !"  view-as alert-box information  title "Ошибка при вводе".
     5314           return error .
     5315         end.
     5316         if loc_payer-code = 0 or loc_payer-code = ? then do:
     5317           message "Не задан код плательщика !"  view-as alert-box information  title "Ошибка при вводе".
     5318           return error .
     5319         end.
     5320         if not( loc_receiver-type = 'орг':U or loc_receiver-type = 'чел':U ) then do:
     5321           message "Не верно задан тип получателя !"  view-as alert-box information  title "Ошибка при вводе".
     5322           return error .
     5323         end.
     5324         if not( loc_payer-type = 'орг':U or loc_payer-type = 'чел':U ) then do:
     5325           message "Не верно задан тип плательщика !"  view-as alert-box information  title "Ошибка при вводе".
     5326           return error .
     5327         end.
     5328         if loc_receiver-code = loc_payer-code  and
     5329            loc_receiver-type = loc_payer-type then do:
     5330           message "Код получателя равен коду плательщика !"  view-as alert-box information  title "Ошибка при вводе".
     5331           return error .
     5332         end.
     5333         if not can-find (first clients where clients.obj-code = loc_receiver-code
     5334                                         and clients.obj-type = loc_receiver-type no-lock )
     5335           then do:
     5336           message "Не верно выбран получатель !"  view-as alert-box information  title "Ошибка при вводе".
     5337           return error .
     5338         end.
     5339         if not can-find (first clients where clients.obj-code = loc_payer-code
     5340                                         and clients.obj-type = loc_payer-type no-lock )
     5341           then do:
     5342           message "Не верно выбран плательшик !"  view-as alert-box information  title "Ошибка при вводе".
     5343           return error .
     5344         end.
     5345     case p-doc-type :
     5346     when 'при':U then do:
     5347       if not  ( loc_receiver-code       =  par-host-code       and loc_receiver-type       =  'орг':U)
     5348           then do:
     5349            message
     5350               "Внимание !!!"  skip
     5351               "Данные по ПОЛУЧАТЕЛЮ не верны ! "  skip
     5352               view-as alert-box information
     5353                 .
     5354               return error .
     5355           end.
     5356     end.
     5357     when 'рас':U then do:
     5358       if not         ( loc_payer-code       =  par-host-code       and loc_payer-type       =  'орг':U)    then do:
     5359            message
     5360               "Внимание !!!"  skip
     5361               "Данные по ПЛАТЕЛЬЩИКУ не верны ! "  skip
     5362               view-as alert-box information
     5363                 .
     5364               return error .
     5365           end.
     5366     end.
     5367     end case.
     5368         define variable v-sum1 as decimal no-undo .
     5369         define variable v-ok as logical init true no-undo .
     5370         v-sum1 = 0 .
     5371         for each tt_fin-ob-tax :
     5372             v-sum1  = v-sum1 + tt_fin-ob-tax.sum-line-doc .
     5373         end.
     5374         if  v-sum1 = 0  then do:
     5375           message
     5376            "Не введены налоги !!! "
     5377           view-as alert-box information  title "Ошибка при вводе налогов".
     5378           return error .
     5379         end.
     5380         if p-status_ = 'новый':U   then do:
     5381             if loc_sum-doc <> v-sum1      then do:
     5382               message
     5383               substitute ( "Общая сумма документа &1, а сумма всех компонент , по которым исчислялся налог = &2", loc_sum-doc, v-sum1 )
     5384               view-as alert-box information  title "Ошибка при вводе налогов".
     5385               return error .
     5386             end.
     5387         end.
     5388         if  loc_pay-date = ?
     5389           then do:
     5390             message  "Не задана дата платежа!"  skip
     5391                      "Сохраняем фин.обязательство ? "          skip
     5392                     view-as alert-box question
     5393                     buttons yes-no
     5394                     update v-ok
     5395                   .
     5396              if v-ok = false then  return error.
     5397         end.
     5398    if radio-set-dogovor = true and (
     5399       loc_contract-code-id = 0  or
     5400       loc_contract-code-id = ?
     5401       )
     5402      then do:
     5403             message  "Договор не задан , но указано что ФО с договором !"  skip
     5404                      "Сохраняем фин.обязательство без договора ? "          skip
     5405                     view-as alert-box question
     5406                     buttons yes-no
     5407                     update v-ok
     5408                   .
     5409              if v-ok = false then  return error.
     5410     end.
     5411    run ver-data in this-procedure no-error .
     5412    if error-status :error then do:
     5413    return error .
     5414   end.
     5415   if ref-mode = 'ДОБАВЛЕНИЕ':U then do:
     5416          run create-fin-liab in this-procedure (
     5417                   input no ,
     5418           input  p-doc-code            ,
     5419           input  p-doc-date            ,
     5420           input  p-doc-type            ,
     5421           input  p-payer-name          ,
     5422           input  p-receiver-name       ,
     5423           input  p-curr-code           ,
     5424           input  p-sum-doc             ,
     5425           input  p-user-db-num-doc     ,
     5426           input  p-user-name-doc       ,
     5427           input  p-base-rate           ,
     5428           input  p-base-scale          ,
     5429           input  p-receiver-code       ,
     5430           input  p-receiver-type       ,
     5431           input  p-contract-code       ,
     5432           input  p-exch-rate           ,
     5433           input  p-exch-scale          ,
     5434           input  p-contract-curr       ,
     5435           input  p-contract-rate       ,
     5436           input  p-contract-scale      ,
     5437           input  p-fact-date           ,
     5438           input  p-fact-order          ,
     5439           input  p-host-code           ,
     5440           input  p-payer-code          ,
     5441           input  p-payer-type          ,
     5442           input  p-pay-date            ,
     5443           input  p-prn-doc-code        ,
     5444           input  p-status_             ,
     5445           input  p-sum-base-orig       ,
     5446           input  p-sum-base            ,
     5447           input  p-sum-doc-orig        ,
     5448           input  p-sum-rubl-orig       ,
     5449           input  p-sum-rubl            ,
     5450           input  p-sum-contract        ,
     5451           input  p-trn-doc-code        ,
     5452           input  p-user-db-num-fact    ,
     5453           input  p-user-db-num-pay        ,
     5454           input  p-user-name-fact         ,
     5455           input  p-user-name-pay          ,
     5456           input  p-in-type                ,
     5457           input  p-sum-tax-base           ,
     5458           input  p-sum-tax-doc            ,
     5459           input  p-sum-tax-rubl           ,
     5460           input  p-sum-tax-contract       ,
     5461           input  ""                       ,
     5462           output ri ).
     5463   end.
     5464       find current fin-ob  exclusive-lock   no-error.
     5465       if available fin-ob then do:
     5466         assign
     5467           fin-ob.obj-code             = fi-obj-code
     5468           fin-ob.obj-type             = fi-obj-type
     5469           fin-ob.contract-code        = loc_contract-code-id
     5470           fin-ob.receiver-code        = loc_receiver-code
     5471           fin-ob.receiver-name        = loc_receiver-name
     5472           fin-ob.receiver-type        = loc_receiver-type
     5473           fin-ob.doc-date             = loc_doc-date
     5474           fin-ob.base-rate            = loc_base-rate
     5475           fin-ob.base-scale           = loc_base-scale
     5476           fin-ob.curr-code            = loc_curr-code
     5477           fin-ob.exch-rate            = loc_exch-rate
     5478           fin-ob.exch-scale           = loc_exch-scale
     5479           fin-ob.fact-date            = loc_fact-date
     5480           fin-ob.payer-code           = loc_payer-code
     5481           fin-ob.payer-name           = loc_payer-name
     5482           fin-ob.payer-type           = loc_payer-type
     5483           fin-ob.pay-date             = loc_pay-date
     5484           fin-ob.prn-doc-code         = loc_prn-doc-code
     5485           .
     5486           if p-status_ = 'новый':U then do:
     5487           assign
     5488               fin-ob.sum-base             = loc_sum-base
     5489               fin-ob.sum-doc              = loc_sum-doc
     5490               fin-ob.sum-rubl             = loc_sum-rubl
     5491               fin-ob.sum-contract         = loc_sum-contract
     5492               fin-ob.sum-tax-base             = loc_sum-tax-base
     5493               fin-ob.sum-tax-doc              = loc_sum-tax-doc
     5494               fin-ob.sum-tax-rubl             = loc_sum-tax-rubl
     5495               fin-ob.sum-tax-contract         = loc_sum-tax-contract
     5496           .
     5497           end.
     5498           assign
     5499             fin-ob.contract-curr        = loc_contract-curr
     5500             fin-ob.contract-rate        = loc_contract-rate
     5501             fin-ob.contract-scale       = loc_contract-scale
     5502             fin-ob.ps                   = loc_ps
     5503             fin-ob.corr-doc             = loc_corr-doc
     5504           .
     5505         if t-doc      then fin-ob.in-type  = 0 .
     5506         if t-base     then fin-ob.in-type  = 1 .
     5507         if t-rubl     then fin-ob.in-type  = 2 .
     5508         if t-contract then fin-ob.in-type  = 3 .
     5509           if p-status_ = 'новый':U then do:
     5510                 for each fin-ob-tax  exclusive-lock  where  fin-ob-tax.host-code = fin-ob.host-code and
     5511                                                             fin-ob-tax.doc-code  = fin-ob.doc-code :
     5512                     delete fin-ob-tax .
     5513                 end .
     5514                 for each tt_fin-ob-tax :
     5515                     create fin-ob-tax .
     5516                     BUFFER-COPY tt_fin-ob-tax to fin-ob-tax
     5517                     assign
     5518                       fin-ob-tax.host-code = fin-ob.host-code
     5519                       fin-ob-tax.doc-code  = fin-ob.doc-code
     5520                   .
     5521                 end.
     5522           end.
     5523   end.
     5524   else do:
     5525    message "Ошибка при сохранении данных "  skip vss-workfile vss-revision vss-description skip
     5526            error-status :get-message(1) .
     5527    return no-apply.
     5528   end.
     5529   end.
     5530     end.
     5531   END PROCEDURE.
     5532   PROCEDURE step-next :
     5533    do
     5534    on error undo, return error return-value
     5535    :
     5536   if valid-handle (br-handle) then do:
     5537     g#log = br-handle:select-next-row() no-error .
     5538     if error-status :error then do:
     5539        message "Это режим просмотра одного документа." .
     5540        g#log = false .
     5541        end.
     5542     if not g#log then message "Это последний документ списка.".
     5543   end.
     5544       ri = recid ( buf_fin-liab ).
     5545       next-prev = yes.
     5546     end.
     5547   END PROCEDURE.
     5548   PROCEDURE step-prev :
     5549    do
     5550    on error undo, return error return-value
     5551    :
     5552   if valid-handle (br-handle) then do:
     5553     g#log = br-handle:select-prev-row() no-error .
     5554     if error-status :error then do:
     5555        message "Это режим просмотра одного документа." .
     5556        g#log = false .
     5557     end.
     5558     if not g#log then do: message "Это первый документ списка.".   end.
     5559   end.
     5560   ri = recid (buf_fin-liab).
     5561   next-prev = yes .
     5562     end.
     5563   END PROCEDURE.
     5564   PROCEDURE ver-data :
     5565    do
     5566    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5567    :
     5568   IF  loc_contract-code-id <> 0 THEN DO:
     5569       define buffer buf_contract for contract.
     5570     find first buf_contract where buf_contract.contract-code     = loc_contract-code-id
     5571                               and buf_contract.host-code         = par-host-code
     5572                           no-lock no-error .
     5573     if not available buf_contract then do:
     5574        message "Не верно введен Номер договора!!! " view-as alert-box error  .
     5575        return error .
     5576     end.
     5577     case p-doc-type :
     5578     when 'при':U then do:
     5579       if not ((
     5580           ( loc_payer-code       =  buf_contract.cli-code  and loc_payer-type       =  buf_contract.cli-type  ) or
     5581           ( loc_payer-code       =  buf_contract.posr-code and loc_payer-type       =  buf_contract.posr-type ) or
     5582           ( loc_payer-code       =  buf_contract.agnt-code and loc_payer-type       =  buf_contract.agnt-type ))
     5583           and
     5584           ( loc_receiver-code       =  par-host-code       and loc_receiver-type       =  'орг':U))
     5585           then do:
     5586            message
     5587            "Внимание !!!"  skip
     5588            "Данные по ПЛАТЕЛЬЩИКУ или ПОЛУЧАТЕЛЮ взяты не из договора ! "  skip
     5589            view-as alert-box information
     5590            title "Приходное ФО"
     5591             .
     5592            return error .
     5593           end.
     5594     end.
     5595     when 'рас':U then do:
     5596       if not ((
     5597           ( loc_receiver-code       =  buf_contract.cli-code  and loc_receiver-type       =  buf_contract.cli-type  ) or
     5598           ( loc_receiver-code       =  buf_contract.posr-code and loc_receiver-type       =  buf_contract.posr-type ) or
     5599           ( loc_receiver-code       =  buf_contract.agnt-code and loc_receiver-type       =  buf_contract.agnt-type ))
     5600           and
     5601           ( loc_payer-code       =  par-host-code       and loc_payer-type       =  'орг':U))
     5602           then do:
     5603            message
     5604            "Внимание !!!"  skip
     5605            "Данные по ПЛАТЕЛЬЩИКУ или ПОЛУЧАТЕЛЮ взяты не из договора ! "  skip
     5606            view-as alert-box information
     5607            title "Расходное ФО"
     5608             .
     5609            return error .
     5610           end.
     5611     end.
     5612     end case.
     5613   END.
     5614     end.
     5615   END PROCEDURE.
     5616   FUNCTION sel-abbr RETURNS CHARACTER
     5617     ( p-curr-code as int ) :
     5618     define variable rr as character no-undo .
     5619     find first currency no-lock where  currency.curr-code  = p-curr-code no-error.
     5620     rr = currency.curr-abbr .
     5621     RETURN rr.
     5622   END FUNCTION.
