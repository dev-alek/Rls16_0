      458   procedure uf-get :
      459     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      460     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      461     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      462     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      463     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      464     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      465     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      466     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      467     do
      468     on error undo, return error
      469     :
      470       define buffer buf_usr-flt for ubflt.usr-flt .
      471       define variable v-use-List_     as logical   no-undo .
      472       define variable v-type-List_     as character no-undo .
      473       define variable v-format-List_   as character no-undo .
      474       define variable v-use-Naim      as logical   no-undo .
      475       define variable v-type-Naim      as character no-undo .
      476       define variable v-format-Naim    as character no-undo .
      477       define variable v-use-print-graft as logical   no-undo .
      478       define variable v-use-sort-gr     as logical   no-undo .
      479       define variable v-use-type-price  as logical   no-undo .
      480       define variable v-use-type-val    as logical   no-undo .
      481       define variable v-label          as character no-undo .
      482       define variable v-tooltip        as character no-undo .
      483       define variable v-user-can-edit  as logical   no-undo .
      484       define variable v-output-display as logical   no-undo .
      485       define variable v-other          as character no-undo .
      486       run uf-name in this-procedure
      487          (input  entry(1, p-code, chr(4))
      488         ,output v-use-List_
      489         ,output v-type-List_
      490         ,output v-format-List_
      491         ,output v-use-Naim
      492         ,output v-type-Naim
      493         ,output v-format-Naim
      494         ,output v-use-print-graft
      495         ,output v-use-sort-gr
      496         ,output v-use-type-price
      497         ,output v-use-type-val
      498         ,output v-label
      499         ,output v-tooltip
      500         ,output v-user-can-edit
      501         ,output v-output-display
      502         ,output v-other
      503         ) no-error .
      504       if error-status :error then do:
      505         undo, return error return-value .
      506       end.
      507       find first buf_usr-flt no-lock where
      508                  buf_usr-flt.Call-point     = p-code AND
      509                  buf_usr-flt.user-name       = p-user-name
      510         no-error .
      511       if avail buf_usr-flt then do:
      512         assign
      513         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      514         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      515         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      516         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      517         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      518         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      519         .
      520       end.
      521       else do:
      522         assign
      523         p-List_        = (if v-use-List_       then "":U                    else ?)
      524         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      525         p-print-graft  = (if v-use-print-graft then no                      else ?)
      526         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      527         p-type-price   = (if v-use-type-price  then no                      else ?)
      528         p-type-val     = (if v-use-List_       then no                      else ?)
      529         .
      530       end.
      531     end.
      532   end procedure.
      533   procedure uf-set :
      534     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      535     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      536     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      537     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      538     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      539     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      540     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      541     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      542     do
      543     on error undo, return error
      544     :
      545       define buffer buf_usr-flt for ubflt.usr-flt .
      546       define variable v-use-List_     as logical   no-undo .
      547       define variable v-type-List_     as character no-undo .
      548       define variable v-format-List_   as character no-undo .
      549       define variable v-use-Naim      as logical   no-undo .
      550       define variable v-type-Naim      as character no-undo .
      551       define variable v-format-Naim    as character no-undo .
      552       define variable v-use-print-graft as logical   no-undo .
      553       define variable v-use-sort-gr   as logical   no-undo .
      554       define variable v-use-type-price as logical   no-undo .
      555       define variable v-use-type-val  as logical   no-undo .
      556       define variable v-tooltip        as character no-undo .
      557       define variable v-label          as character no-undo .
      558       define variable v-user-can-edit  as logical   no-undo .
      559       define variable v-output-display as logical   no-undo .
      560       define variable v-other          as character no-undo .
      561       run uf-name in this-procedure
      562         (input  entry(1, p-code, chr(4))
      563         ,output v-use-List_
      564         ,output v-type-List_
      565         ,output v-format-List_
      566         ,output v-use-Naim
      567         ,output v-type-Naim
      568         ,output v-format-Naim
      569         ,output v-use-print-graft
      570         ,output v-use-sort-gr
      571         ,output v-use-type-price
      572         ,output v-use-type-val
      573         ,output v-label
      574         ,output v-tooltip
      575         ,output v-user-can-edit
      576         ,output v-output-display
      577         ,output v-other
      578         ) no-error .
      579       if error-status :error then do:
      580         undo, return error return-value .
      581       end.
      582       find first buf_usr-flt where
      583                  buf_usr-flt.Call-point     = p-code AND
      584                  buf_usr-flt.user-name       = p-user-name
      585         no-error .
      586       if not avail buf_usr-flt then do:
      587           create buf_usr-flt .
      588           assign
      589           buf_usr-flt.call-point = p-code
      590           buf_usr-flt.user-name  = p-user-name
      591           .
      592       end.
      593       if avail buf_usr-flt then do:
      594        assign
      595        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      596        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      597        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      598        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      599        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      600        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      601       .
      602       release buf_usr-flt.
      603       end.
      604       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      605     end.
      606   end procedure.
      607   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      608   define variable v-waitfram-action01         as character   no-undo .
      609   define variable v-waitfram-action02         as character   no-undo .
      610   define variable v-waitfram-action03         as character   no-undo .
      611   define variable mWaitFramTextBeg            as character   no-undo.
      612   define variable mWaitFramTextEnd            as character   no-undo.
      613   define variable mWaitFramView               as logical     no-undo.
      614   define variable mWaitProcEvent              as logical     no-undo init yes.
      615   define variable mWaitFramInterval           as integer     no-undo init 1 .
      616   define variable mWaitFramStop               as logical     no-undo.
      617   define variable mWaitFramStopUser           as logical     no-undo.
      618   define variable mWaitFramStopTimeOut        as logical     no-undo.
      619   define variable mWaitFramStartProc          as datetime-tz no-undo.
      620   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      621   define button B-WaitFramStop auto-end-key
      622        label "Стоп"
      623        size 10 by 1 tooltip "Остоновить процесс".
      624   define button B-viewProcInfo
      625        label "Информация"
      626        size 15 by 1 tooltip "Информация о процесс".
      627   define frame waitfram
      628     v-waitfram-action01 format "x(72)" no-label skip
      629     v-waitfram-action02 format "x(72)" no-label skip
      630     v-waitfram-action03 format "x(72)" no-label skip
      631     B-viewProcInfo
      632     B-WaitFramStop at row 4 col 30
      633     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      634     .
      635   define new global shared variable mBatchMode as logical no-undo init ?.
      636   define variable mFramBachModHandle as handle no-undo.
      637   mFramBachModHandle = frame waitfram:handle.
      638   define variable mFameOldVis as logical no-undo.
      639   define variable mVisCUrentVin as logical no-undo.
      640   if session:batch-mode
      641   then
      642      mBatchMode = yes.
      643   if mBatchMode = ? then do:
      644     mVisCUrentVin = current-window:visible.
      645     mFameOldVis = mFramBachModHandle:visible.
      646     mFramBachModHandle:visible  = yes.
      647     mBatchMode = mFramBachModHandle:visible ne yes.
      648     mFramBachModHandle:visible = mFameOldVis.
      649     current-window:visible = mVisCUrentVin.
      650   end.
      651    if  log-manager:logfile-name ne ?
      652     then DO:
      653         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      654         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      655         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      656     end.
      657   on choose of B-WaitFramStop in frame waitfram
      658   do:
      659     mWaitFramStop = yes.
      660     mWaitFramStopUser = yes.
      661   end.
      662   function waitfram-check-timeout returns logical():
      663      define variable vtime as int64 no-undo.
      664      if mWaitFramStopTimeOut
      665      then
      666         return yes.
      667      vtime = ( now - mWaitFramStartProc ) / 1000 .
      668      if     mWaitFramTimeOut ne ?
      669         and mWaitFramTimeOut ne 0
      670         and mWaitFramTimeOut lt vtime
      671      then do:
      672         mWaitFramStopTimeOut = yes.
      673      end.
      674      return mWaitFramStopTimeOut.
      675   end.
      676   procedure waitfram-hide :
      677     if not session:batch-mode
      678     then do
      679     on error undo, return error return-value
      680     :
      681       pause 0 before-hide .
      682       if not mBatchMode then
      683         hide frame waitfram .
      684     if     not mWaitFramView
      685        and mWaitProcEvent
      686     then
      687       process events .
      688     end.
      689   end procedure.
      690   procedure waitfram-show :
      691     define input  parameter p-message as character no-undo .
      692     define variable v-left-margin as integer   no-undo .
      693     if not session:batch-mode
      694     then do
      695     on error undo, return error return-value
      696     :
      697       if length(p-message) <= 70 then do:
      698         assign
      699           v-left-margin = integer((70 - length(p-message)) / 2)
      700         .
      701         assign
      702           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      703         .
      704         assign
      705           v-waitfram-action01 = " "
      706           v-waitfram-action02 = " "
      707                                    + fill(" ", v-left-margin)
      708                                    + p-message
      709           v-waitfram-action03 = " "
      710         .
      711       end.
      712       else do:
      713         define variable vRindex1 as integer no-undo.
      714         define variable vRindex2 as integer no-undo.
      715         vRindex1 = r-index(p-message," ",70).
      716         if vRindex1 = 0
      717         then
      718            vRindex1 = 70.
      719         if length(p-message)  <= vRindex1 + 70 then do:
      720           assign
      721             v-waitfram-action01 = " "
      722             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      723             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      724           .
      725         end.
      726         else do:
      727           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      728           if vRindex2 <= vRindex1
      729           then
      730              vRindex2 = vRindex1 + 70.
      731           assign
      732             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      733             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      734             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      735           .
      736         end.
      737       end.
      738       B-viewProcInfo:visible   in frame waitfram = no.
      739       B-viewProcInfo:sensitive in frame waitfram = no.
      740       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      741       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      742       if  (   mWaitFramView
      743          or  mWaitProcEvent)
      744          and not mBatchMode
      745       then
      746          display
      747             v-waitfram-action01 skip
      748             v-waitfram-action02 skip
      749             v-waitfram-action03 skip
      750          with frame waitfram .
      751       if     mWaitFramView
      752          then do:
      753             if     mWaitFramInterval ne ?
      754                and not mBatchMode
      755             then
      756                wait-for go of frame waitfram pause mWaitFramInterval.
      757          end.
      758          else
      759             if     mWaitProcEvent
      760                and not mBatchMode
      761             then
      762                process events .
      763     end.
      764   end procedure.
      765      procedure waitfram-show-this:
      766         define input  parameter iInterval as int64 no-undo.
      767         define variable vtime as int64 no-undo.
      768         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      769         mWaitFramInterval = iInterval.
      770         run waitfram-show (substitute("&1&2 &3&4" ,
      771                                       mWaitFramTextBeg ,
      772                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      773                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      774                                       mWaitFramTextEnd
      775                                      )
      776                           ).
      777      end.
      778      procedure WaitFramRunPause:
      779         define input  parameter iInterval as dec no-undo.
      780         define variable vStart  as datetime-tz no-undo.
      781         define variable vend    as datetime-tz no-undo.
      782         define variable vint as int64 no-undo.
      783         define variable vOk as logical no-undo.
      784         vStart = now.
      785         vend   = vStart.
      786         publish "WaitFramPause" (iInterval,output vOk).
      787         vend   =  now.
      788         vint = vend - vStart.
      789         vint = iInterval - vint / 1000.
      790         if     not mWaitFramStop
      791            and (   vint > 0
      792                 or (    not vOk
      793                     and iInterval eq ?
      794                     )
      795                 )
      796         then
      797            run waitfram-show-this (iInterval).
      798         vend   =  now.
      799         vint = vend - vStart.
      800         vint = iInterval - vint / 1000.
      801         if     not mWaitFramStop
      802            and vint > 0
      803         then do:
      804            run gbl/pause.p (vint * 1000).
      805         end.
      806         if iInterval ne ?
      807         then
      808            publish "WaitFramStop".
      809         waitfram-check-timeout().
      810      end.
      811      procedure WaitFramWaitFor:
      812         define input  parameter iInterval as dec no-undo.
      813         assign
      814            mWaitFramStartProc   = now
      815            mWaitFramStopUser    = no
      816            mWaitFramStopTimeOut = no
      817         .
      818         block-wait:
      819         do while not mWaitFramStop:
      820            run WaitFramRunPause (iInterval).
      821            if  waitfram-check-timeout()
      822            then do:
      823               leave block-wait.
      824            end.
      825         end.
      826         run waitfram-hide.
      827      end.
      828   procedure waitfram-join :
      829     define input  parameter p-line-1  as character no-undo .
      830     define input  parameter p-line-2  as character no-undo .
      831     define input  parameter p-line-3  as character no-undo .
      832     define output parameter p-message as character no-undo .
      833     do
      834     on error undo, return error return-value
      835     :
      836       assign
      837         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      838                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      839                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      840       .
      841     end.
      842   end procedure.
      843   function waitfram-join-function returns character
      844     (input p-line-1 as character
      845     ,input p-line-2 as character
      846     ,input p-line-3 as character
      847     ).
      848     define variable v-message as character no-undo .
      849     run waitfram-join in this-procedure
      850       (input  p-line-1
      851       ,input  p-line-2
      852       ,input  p-line-3
      853       ,output v-message
      854       ) .
      855     return v-message .
      856   end function .
