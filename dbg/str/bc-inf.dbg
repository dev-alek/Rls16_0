      164   DEFINE  SHARED TEMP-TABLE anlz-bc NO-UNDO
      165        FIELD nm       as INTEGER
      166        FIELD b-c      as integer
      167        FIELD scn-qnty as DECIMAL
      168        FIELD scn-pl   as CHARACTER
      169        FIELD rez      as CHARACTER
      170        FIELD err-msg  as CHARACTER
      171        FIELD des      as CHARACTER
      172        FIELD upd-line as logical initial no
      173        INDEX pi IS PRIMARY nm
      174        INDEX b-c b-c.
      175   DEFINE  SHARED TEMP-TABLE main-bc NO-UNDO
