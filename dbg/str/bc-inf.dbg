      379        "ИСКОМЫЙ КОД" VIEW-AS TEXT
      380             SIZE 94.88 BY .75 AT ROW 2.92 COL 1.75
      381             BGCOLOR 7 FGCOLOR 15
      382        RECT-4 AT ROW 3.25 COL 1.75
      383        RECT-5 AT ROW 7.96 COL 1.88
      384        RECT-1 AT ROW 11.58 COL 1.88
      385        RECT-2 AT ROW 16.38 COL 1.88
      386        SPACE(0.23) SKIP(1.24)
      387       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      388            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      389            TITLE "Информация по коду (бар-коду)".
      390   ASSIGN
      391          FRAME D-Dialog:SCROLLABLE       = FALSE
      392          FRAME D-Dialog:HIDDEN           = TRUE.
      393   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      394   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      395   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      396   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      397   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      398   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      399   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      400   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      401       ASSIGN adm-object-hdl = FRAME D-Dialog:HANDLE.
      402   RUN ensure-broker.
      403   THIS-PROCEDURE:ADM-DATA =
      404        'ADM1.1~`':U +
      405        'SmartDialog~`':U +
      406        'DIALOG-BOX~`':U +
      407        'NO ~`':U +
      408        '~`':U +
      409        '~`':U +
      410        '~`':U +
      411        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      412           + "~`":U +
      413        'Layout,Hide-on-Init~`':U +
      414        '~`':U +
      415        '~`':U +
      416        '~`~`~`~`~`~`~`~`~`~`~`':U +
      417        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      418            THEN "^^":U
      419        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      420             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      421   PROCEDURE adm-apply-entry :
      422     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      423   END PROCEDURE.
      424   PROCEDURE adm-destroy :
      425    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      426   END PROCEDURE.
      427   PROCEDURE adm-disable :
      428       DISABLE b-exit b-help b-goods b-parts b-place RECT-4 RECT-5 RECT-1 RECT-2 varpl-name WITH FRAME D-Dialog.
      429       RUN dispatch ('disable-fields':U).
      430       RUN set-attribute-list ('ENABLED=no':U).
      431       RETURN.
      432   END PROCEDURE.
      433   PROCEDURE adm-edit-attribute-list :
      434         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
      435         RETURN.
      436   END PROCEDURE.
      437   PROCEDURE adm-enable :
      438       ENABLE UNLESS-HIDDEN b-exit b-help b-goods b-parts b-place RECT-4 RECT-5 RECT-1 RECT-2 varpl-name WITH FRAME D-Dialog.
      439       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      440       RUN set-attribute-list ('ENABLED=yes':U).
      441       RETURN.
      442   END PROCEDURE.
      443   PROCEDURE adm-exit :
      444        RUN notify ('exit':U).
      445     RETURN.
      446   END PROCEDURE.
      447   PROCEDURE adm-hide :
      448     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      449   END PROCEDURE.
      450   PROCEDURE adm-initialize :
      451     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      452   END PROCEDURE.
      453   PROCEDURE adm-show-errors :
      454       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      455       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      456           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      457       END.
      458       RETURN.
      459   END PROCEDURE.
      460   PROCEDURE adm-UIB-mode :
      461     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      462   END PROCEDURE.
      463   PROCEDURE adm-view :
      464     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      465   END PROCEDURE.
      466   PROCEDURE dispatch :
      467       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      468       RUN broker-dispatch IN adm-broker-hdl
      469           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      470       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      471   END PROCEDURE.
      472   PROCEDURE ensure-broker :
      473   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      474   IF RETURN-VALUE NE "ADM-Broker":U THEN
      475   DO:
      476       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      477       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      478   END.
      479   END PROCEDURE.
      480   PROCEDURE get-attribute :
      481     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      482     RUN broker-get-attribute IN adm-broker-hdl
      483         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      484     RETURN RETURN-VALUE.
      485   END PROCEDURE.
      486   PROCEDURE get-attribute-list :
      487     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      488     RUN broker-get-attribute-list IN adm-broker-hdl
      489         (INPUT THIS-PROCEDURE,
      490          INPUT ?,
      491          OUTPUT p-attr-list) NO-ERROR.
      492     RETURN.
      493   END PROCEDURE.
      494   PROCEDURE new-state :
      495     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      496     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      497     RETURN.
      498   END PROCEDURE.
      499   PROCEDURE notify :
      500     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      501     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      502     IF RETURN-VALUE = "ADM-ERROR":U THEN
      503         RETURN "ADM-ERROR":U.
      504     RETURN.
      505   END PROCEDURE.
      506   PROCEDURE set-attribute-list :
      507     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      508     RUN ensure-broker.
      509     RUN broker-set-attribute-list IN adm-broker-hdl
      510         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      511     RETURN.
      512   END PROCEDURE.
      513   PROCEDURE set-position :
      514       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      515       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      516       IF VALID-HANDLE(adm-object-hdl) THEN
      517       DO:
      518           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
      519           IF adm-object-hdl:TYPE = "WINDOW":U THEN
      520           DO:
      521             IF p-row = 0 THEN p-row =
      522               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
      523             IF p-col = 0 THEN p-col =
      524               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
      525           END.
      526           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
      527           DO:
      528             parent-hdl = adm-object-hdl:PARENT.
      529             IF p-row = 0 THEN p-row =
      530               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
      531                 parent-hdl:ROW.
      532             IF p-col = 0 THEN p-col =
      533               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
      534                 parent-hdl:COL.
      535           END.
      536           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
      537           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
      538         ASSIGN adm-object-hdl:ROW    =   p-row
      539                adm-object-hdl:COLUMN =   p-col.
      540       END.
      541       RETURN.
      542   END PROCEDURE.
      543   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
      544       STRING(adm-object-hdl)).
      545   PAUSE 0 BEFORE-HIDE.
      546   PROCEDURE adm-change-page :
      547     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
      548     END PROCEDURE.
      549   PROCEDURE delete-page :
      550     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
      551     RUN broker-delete-page IN adm-broker-hdl
      552         (INPUT THIS-PROCEDURE, INPUT p-page#).
      553     END PROCEDURE.
      554   PROCEDURE init-object :
      555     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
      556     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
      557     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
      558     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
      559     RUN broker-init-object IN adm-broker-hdl
      560         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
      561          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
      562     RETURN.
      563   END PROCEDURE.
      564   PROCEDURE init-pages :
      565     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
      566     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      567         INPUT p-page-list) NO-ERROR.
      568     END PROCEDURE.
      569   PROCEDURE select-page :
      570     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
      571     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      572         INPUT p-page#) NO-ERROR.
      573     END PROCEDURE.
      574   PROCEDURE view-page :
      575     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
      576     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      577         INPUT p-page#).
      578     END PROCEDURE.
      579   ON WINDOW-CLOSE OF FRAME D-Dialog
      580   DO:
      581     APPLY "END-ERROR":U TO SELF.
      582   END.
      583   ON CHOOSE OF b-goods IN FRAME D-Dialog
      584   DO:
      585     find first goods where goods.artic = varartic and
      586                            goods.prod-type = varprod-type and
      587                            goods.prod-code = varprod-code no-lock no-error.
      588     if not available goods then do:
      589       message "Товар не найден." view-as alert-box.
      590       return no-apply.
      591     end.
      592     run str/showgds.p ( input parparentproc
      593                        ,input ?
      594                        ,input goods.gds-code
      595                        ,input 'ПРОСМОТР':U).
      596   END.
      597   ON CHOOSE OF b-parts IN FRAME D-Dialog
      598   DO:
      599   def var rid-list as char no-undo.
      600   define variable prt-rec as recid no-undo .
      601   find goods where goods.artic     = varartic     and
      602                   goods.prod-type = varprod-type and
      603                   goods.prod-code = varprod-code no-lock no-error.
      604   if not available goods then do:
      605     message "Товар не найден."
      606     view-as alert-box error.
      607     return no-apply.
      608   end.
      609      run str/parts-l.w
      610        (input parparentproc
      611        ,input p-obj-type
      612        ,input p-obj-code
      613        ,input goods.gds-code
      614        ,input ""
      615        ,input 'ПРОСМОТР':U
      616        ,input 'все':U
      617        ,input 'все':U
      618        ,input 'справочник':U
      619        ,output prt-rec
      620        ) .
      621   END.
      622   ON CHOOSE OF b-place IN FRAME D-Dialog
      623   DO:
      624   def var rid-list as char no-undo.
      625   find place where place.obj-type = p-obj-type and
      626                    place.obj-code = p-obj-code and
      627                    place.pl-code  = int (varbar-code) no-lock no-error.
      628   if not available place then do:
      629     message "Складское место не найдено." view-as alert-box error.
      630     return no-apply.
      631   end.
      632   run ref/pl-list.w (
      633                     input parparentproc
      634                   , input ""
      635                   , input p-obj-type
      636                   , input p-obj-code
      637                   , input 'объект':U
      638                   , input-output rid-list).
      639   END.
      640   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      641   on help of frame D-Dialog
      642   do:
      643     run gbl/app_help.p
      644       (input this-procedure :file-name
      645       ,input ''
      646       ,input ?
      647       ) no-error.
      648     if error-status :error then do:
      649       message
      650         "Ошибка при вызове помощи"
      651         error-status :get-message(1)
      652         view-as alert-box .
      653     end.
      654   end.
      655   run minbtn-set in this-procedure .
      656   on choose of b-help in frame D-Dialog
      657   do:
      658     apply "help":u to frame D-Dialog .
      659   end.
      660   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      661   procedure minbtn-set :
      662       do
      663           on error undo, return error return-value
      664           :
      665           define variable ii              as integer       no-undo .
      666           define variable fh              as widget-handle no-undo .
      667           define variable hh              as widget-handle no-undo .
      668           define variable v-h             as handle        extent 4 no-undo .
      669           define variable v-name-button   as character     no-undo .
      670           define variable v-help-old-x    as decimal       no-undo .
      671           define variable v-help-old-y    as decimal       no-undo .
      672           define variable v-help-old-size as decimal       no-undo .
      673           define variable v-frame-width   as decimal       no-undo .
      674           define variable jj              as integer       no-undo .
      675           do
      676               on error undo, return error
      677               :
      678               assign
      679                   v-frame-width = frame D-Dialog:width - 0.3
      680                   fh            = frame D-Dialog:first-child
      681                   hh            = fh:first-child
      682                   ii            = 1
      683                   .
      684               do while valid-handle(hh):
      685                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      686                   do:
      687                       case lc(hh:name) :
      688                           when "b-help" then
      689                               do:
      690                                   hh:load-image-up("cmp/b-help.bmp":u) .
      691                                   hh:load-image-down("cmp/b-help.bmp":u) .
      692                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      693                                   hh:TOOLTIP = "Помощь" .
      694                                   v-help-old-x = hh:column .
      695                                   v-help-old-y = hh:row    .
      696                                   v-help-old-size = hh:width .
      697                                   hh:width-chars = 2.5 .
      698                               end.
      699                           when "b-print" then
      700                               do:
      701                                   hh:load-image("cmp/b-print.bmp":u) .
      702                                   hh:TOOLTIP = "Печать" .
      703                                   v-h[ii] = hh:handle .
      704                                   ii = ii + 1 .
      705                                   hh:width-chars = 3 .
      706                               end.
      707                           when "b-history" or
      708                           when "b-hist" then
      709                               do:
      710                                   hh:load-image("cmp/b-hist.bmp":u) .
      711                                   hh:TOOLTIP = "История" .
      712                                   v-h[ii] = hh:handle .
      713                                   ii = ii + 1 .
      714                                   hh:width-chars = 3 .
      715                               end.
      716                           when "b-sch" then
      717                               do:
      718                                   hh:load-image("cmp/b-sch.bmp":u) .
      719                                   hh:TOOLTIP = "Установка Фильтра" .
      720                                   v-h[ii] = hh:handle .
      721                                   ii = ii + 1 .
      722                                   hh:width-chars = 3 .
      723                               end.
      724                           when "b-hist-user" then
      725                               do:
      726                                   hh:load-image("cmp/b-hist.bmp":u) .
      727                                   hh:TOOLTIP = "История пользователя" .
      728                                   ii = ii + 1 .
      729                               end.
      730                       end case.
      731                   end.
      732                   hh = hh:next-sibling.
      733               end.
      734               b-help:column = v-frame-width - b-help:width-chars.
      735               jj = 0.
      736               repeat ii = 4 to 1 by -1 :
      737                   if valid-handle (v-h[ii] ) then
      738                   do:
      739                       jj  = jj + 1 .
      740                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      741                       v-h[ii]:row    = v-help-old-y .
      742                   end.
      743               end.
      744           end.
      745       end.
      746   end procedure.
      747   IF THIS-PROCEDURE:PERSISTENT THEN DO:
      748       MESSAGE "A SmartDialog is not intended ":U SKIP
      749               "to be run Persistent or to be placed ":U SKIP
      750               "in another SmartObject at UIB design time.":U
      751               VIEW-AS ALERT-BOX ERROR.
      752       RUN disable_UI.
      753       DELETE PROCEDURE THIS-PROCEDURE.
      754       RETURN.
      755   END.
      756   RUN dispatch ('create-objects':U).
      757   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME D-Dialog:PARENT eq ?
      758   THEN FRAME D-Dialog:PARENT = ACTIVE-WINDOW.
      759   MAIN-BLOCK:
      760   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      761      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      762     RUN dispatch IN THIS-PROCEDURE ('initialize':U).
      763     WAIT-FOR GO OF FRAME D-Dialog.
      764   END.
      765   RUN dispatch IN THIS-PROCEDURE ('destroy':U).
      766   PROCEDURE adm-create-objects :
      767   END PROCEDURE.
      768   PROCEDURE adm-row-available :
      769     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      770     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      771     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      772     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      773     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      774     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      775     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      776     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      777     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      778     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      779     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      780     IF adm-updating-record THEN RETURN.
      781     RUN get-attribute ('FIELDS-ENABLED':U).
      782     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      783     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      784         OUTPUT link-handle) NO-ERROR.
      785     IF link-handle = "":U THEN
      786         RETURN.
      787     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      788     IF NUM-ENTRIES(link-handle) > 1 THEN
      789         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      790             "encountered more than one RECORD-SOURCE.":U SKIP
      791             "The first - ":U record-source-hdl:file-name " - will be used.":U
      792                VIEW-AS ALERT-BOX ERROR.
      793     RUN get-attribute ('Key-Name':U).
      794     key-name = RETURN-VALUE.
      795     IF key-name = "":U THEN key-name = ?.
      796     IF key-name NE ? THEN DO:
      797       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      798         NO-ERROR.
      799       IF key-value NE ? THEN
      800         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      801     END.
      802   IF VALID-HANDLE (adm-object-hdl) THEN
      803       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      804   RUN notify IN THIS-PROCEDURE ('row-available':U).
      805   END PROCEDURE.
      806   PROCEDURE disable_UI :
      807     HIDE FRAME D-Dialog.
      808   END PROCEDURE.
      809   PROCEDURE enable_UI :
      810     DISPLAY varbar-code varentity vartype-bc varwt varadd-info varb-c-cli
      811             varunit-cli-name varunit-cli-long varrate varb-c varunit-base-name
      812             varunit-base-long varartic vargds-name varprod-type varprod-code
      813             varprod-name varf-name varpart-code varloc1 varloc2 varin-code varloc3
      814             varfact-date varloc4 varTempBarCode varTempGoods varTempAdd varpl-name
      815         WITH FRAME D-Dialog.
      816     ENABLE b-exit b-help b-goods b-parts b-place RECT-4 RECT-5 RECT-1 RECT-2
      817            varpl-name
      818         WITH FRAME D-Dialog.
      819     VIEW FRAME D-Dialog.
      820   END PROCEDURE.
      821   PROCEDURE local-initialize :
      822     find un-bc where recid(un-bc) = rec-id.
      823     assign
      824     varbar-code       = un-bc.bar-code
      825     varentity         = un-bc.entity
      826     vartype-bc        = un-bc.type-bc
      827     varrate           = un-bc.rate
      828     varwt             = un-bc.wt
      829     varb-c-cli        = un-bc.b-c
      830     varunit-cli-name  = un-bc.unit-name
      831     varunit-cli-long  = un-bc.long-name
      832     varb-c            = un-bc.b-c-base
      833     varunit-base-name = un-bc.unit-name-base
      834     varunit-base-long = un-bc.long-name-base
      835     varartic          = un-bc.artic
      836     varprod-type      = un-bc.prod-type
      837     varprod-code      = un-bc.prod-code
      838     vargds-name       = un-bc.gds-name
      839     varprod-name      = un-bc.prod-name
      840     varpl-name        = un-bc.pl-name
      841     varloc1           = un-bc.loc1
      842     varloc2           = un-bc.loc2
      843     varloc3           = un-bc.loc3
      844     varloc4           = un-bc.loc4
      845     varf-name         = un-bc.f-name
      846     varin-code        = un-bc.in-code
      847     varfact-date      = un-bc.fact-date
      848     varpart-code      = un-bc.part-code
      849     varTempAdd        = varentity
      850     .
      851     if length (varbar-code) = 13 then do:
      852       run gbl/bcextinf.p
      853         (input 'EAN13':U
      854         ,input varbar-code
      855         ,output varadd-info
      856         ) .
      857     end.
      858     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
      859     IF varentity <> 'ТОВАР':U    AND
      860        varentity <> 'ПРИЗНАК':U AND
      861        varentity <> 'ПАРТИЯ':U     THEN
      862        HIDE varrate           in frame D-Dialog
      863             varb-c-cli        in frame D-Dialog
      864             varunit-cli-name  in frame D-Dialog
      865             varunit-cli-long  in frame D-Dialog
      866             varb-c            in frame D-Dialog
      867             varunit-base-name in frame D-Dialog
      868             varunit-base-long in frame D-Dialog
      869             varartic          in frame D-Dialog
      870             vargds-name       in frame D-Dialog
      871             varprod-type      in frame D-Dialog
      872             varprod-code      in frame D-Dialog
      873             varprod-name      in frame D-Dialog
      874             b-goods           in frame D-Dialog
      875             RECT-1            in frame D-Dialog
      876             RECT-5            in frame D-Dialog
      877             varTempBarCode    in frame D-Dialog
      878             varTempGoods      in frame D-Dialog.
      879     IF varentity <> 'СКЛАДСКОЕ МЕСТО':U  AND
      880        varentity <> 'ПРИЗНАК':U     AND
      881        varentity <> 'ПАРТИЯ':U         THEN
      882        HIDE
      883          RECT-2     in frame D-Dialog
      884          varTempAdd in frame D-Dialog.
      885     IF varentity <> 'ПРИЗНАК':U THEN
      886        HIDE varf-name in frame D-Dialog.
      887     IF varentity <> 'ПАРТИЯ':U  THEN
      888        HIDE varfact-date in frame D-Dialog
      889             varin-code   in frame D-Dialog
      890             varpart-code in frame D-Dialog
      891             b-parts      in frame D-Dialog.
      892     IF varentity <> 'СКЛАДСКОЕ МЕСТО':U THEN
      893        HIDE varpl-name in frame D-Dialog
      894             varloc1 in frame D-Dialog
      895             varloc2 in frame D-Dialog
      896             varloc3 in frame D-Dialog
      897             varloc4 in frame D-Dialog
      898             b-place in frame D-Dialog.
      899   END PROCEDURE.
      900   PROCEDURE send-records :
      901   END PROCEDURE.
      902   PROCEDURE state-changed :
      903     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
      904     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      905   END PROCEDURE.
