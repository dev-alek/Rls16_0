      133        FIELD file-qnty      as decimal
      134        FIELD scn-qnty       as DECIMAL
      135        FIELD scn-pl         as CHARACTER
      136        FIELD artic          LIKE ub.goods.artic
      137        FIELD prod-type      LIKE ub.goods.prod-type
      138        FIELD prod-code      LIKE ub.goods.prod-code
      139        FIELD gds-name       LIKE ub.goods.gds-name
      140        FIELD prod-name      LIKE ub.clients.obj-name
      141        FIELD unit-base      LIKE ub.goods.unit-base
      142        FIELD units-type     LIKE ub.units.type
      143        FIELD f-name         LIKE ub.gds-prt.f-name
      144        FIELD in-code        LIKE ub.parts.in-code
      145        FIELD fact-date      LIKE ub.parts.fact-date
      146        FIELD part-code      LIKE ub.parts.part-code
      147        FIELD rez            as CHARACTER
      148        FIELD err-msg        as CHARACTER
      149        FIELD des            as CHARACTER
