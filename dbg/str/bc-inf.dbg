      359        varb-c AT ROW 12.04 COL 20.25 COLON-ALIGNED
      360        varunit-base-name AT ROW 12.04 COL 56.75 COLON-ALIGNED
      361        varunit-base-long AT ROW 12.04 COL 62.88 COLON-ALIGNED NO-LABEL
      362        varartic AT ROW 13.29 COL 20.25 COLON-ALIGNED
      363        vargds-name AT ROW 13.29 COL 40.5 COLON-ALIGNED NO-LABEL
      364        varprod-type AT ROW 14.33 COL 20.25 COLON-ALIGNED
      365        varprod-code AT ROW 14.33 COL 26.38 COLON-ALIGNED NO-LABEL
      366        varprod-name AT ROW 14.33 COL 40.5 COLON-ALIGNED NO-LABEL
