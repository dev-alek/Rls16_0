      151        FIELD loc1           AS CHARACTER
      152        FIELD loc2           AS CHARACTER
      153        FIELD loc3           AS CHARACTER
      154        FIELD loc4           AS CHARACTER
      155        FIELD unit-name      LIKE ub.units.unit-name
      156        FIELD long-name      LIKE ub.units.long-name
      157        FIELD b-c-base       LIKE ub.bar-code.b-code
      158        FIELD unit-name-base LIKE ub.units.unit-name
      159        FIELD long-name-base LIKE ub.units.long-name
