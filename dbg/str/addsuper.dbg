        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as handle no-undo .
        3   define input  parameter p-doc-code as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: addsuper.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: str/addsuper.p $":U .
        9   define variable vss-description as character no-undo init "Вкручивание Дополнительных расходов в учетную цену".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define new global shared variable g#trdcalib as handle no-undo.
       72   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       74   define  shared variable RepPathName        as character no-undo .
       75   define  shared variable PrintRubl          as logical   no-undo .
       76   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       77   procedure lineattr-value :
       78     do
       79     on error undo, return error return-value
       80     :
       81       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
       82       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
       83       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
       84       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
       85       define output parameter p-type     as character no-undo .
       86       define buffer buf_doc-line-attr for ub.doc-line-attr .
       87       def var v-format         as character no-undo .
       88       def var v-fillin_width   as integer   no-undo .
       89       def var v-fillin_height  as integer   no-undo .
       90       def var v-label          as character no-undo .
       91       def var v-user-can-edit  as logical   no-undo .
       92       def var v-output-display as logical   no-undo .
       93       def var v-other          as character no-undo .
       94       run lineattr-code in this-procedure
       95         (input  p-code
       96         ,output p-type
       97         ,output v-format
       98         ,output v-fillin_width
       99         ,output v-fillin_height
      100         ,output v-label
      101         ,output v-user-can-edit
      102         ,output v-output-display
      103         ,output v-other
      104         ) no-error .
      105       if error-status :error then do:
      106         undo, return error return-value .
      107       end.
      108       find first buf_doc-line-attr no-lock
      109         where buf_doc-line-attr.doc-code  = p-doc-code
      110           and buf_doc-line-attr.gds-code  = p-gds-code
      111           and buf_doc-line-attr.attr-code = p-code
      112         no-error .
      113       if avail buf_doc-line-attr then do:
      114         assign
      115           p-value =  buf_doc-line-attr.attr-value
      116         .
      117       end.
      118       else do:
      119         assign
      120           p-value = if p-type = 'L':U then "no":U else ""
      121         .
      122       end.
      123     end.
      124   end procedure.
      125   procedure lineattr-write :
      126     do
      127     on error undo, return error return-value
      128     :
      129       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      130       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      131       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      132       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      133       define buffer buf_doc-line-attr for ub.doc-line-attr .
      134       def var v-type           as character no-undo .
      135       def var v-format         as character no-undo .
      136       def var v-fillin_width   as integer   no-undo .
      137       def var v-fillin_height  as integer   no-undo .
      138       def var v-label          as character no-undo .
      139       def var v-user-can-edit  as logical   no-undo .
      140       def var v-output-display as logical   no-undo .
      141       def var v-other          as character no-undo .
      142       run lineattr-code in this-procedure
      143         (input  p-code
      144         ,output v-type
      145         ,output v-format
      146         ,output v-fillin_width
      147         ,output v-fillin_height
      148         ,output v-label
      149         ,output v-user-can-edit
      150         ,output v-output-display
      151         ,output v-other
      152         ) no-error .
      153       if error-status :error then do:
      154         undo, return error return-value .
      155       end.
      156       find first buf_doc-line-attr exclusive-lock
      157         where buf_doc-line-attr.doc-code  = p-doc-code
      158           and buf_doc-line-attr.gds-code  = p-gds-code
      159           and buf_doc-line-attr.attr-code = p-code
      160         no-error .
      161       if not available buf_doc-line-attr then do:
      162         create buf_doc-line-attr .
      163         assign
      164           buf_doc-line-attr.doc-code  = p-doc-code
      165           buf_doc-line-attr.gds-code = p-gds-code
      166           buf_doc-line-attr.attr-code = p-code
      167         .
      168       end.
      169       assign
      170         buf_doc-line-attr.attr-value = p-value
      171       .
      172        release buf_doc-line-attr.
      173     end.
      174   end procedure.
      175   procedure lineattr-exist :
      176     do
      177     on error undo, return error return-value
      178     :
      179       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      180       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      181       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      182       define output parameter p-exist   as logical  no-undo .
      183       define buffer buf_doc-line-attr for ub.doc-line-attr .
      184       def var v-type           as character no-undo .
      185       def var v-format         as character no-undo .
      186       def var v-fillin_width   as integer   no-undo .
      187       def var v-fillin_height  as integer   no-undo .
      188       def var v-label          as character no-undo .
      189       def var v-user-can-edit  as logical   no-undo .
      190       def var v-output-display as logical   no-undo .
      191       def var v-other          as character no-undo .
      192       run lineattr-code in this-procedure
      193         (input  p-code
      194         ,output v-type
      195         ,output v-format
      196         ,output v-fillin_width
      197         ,output v-fillin_height
      198         ,output v-label
      199         ,output v-user-can-edit
      200         ,output v-output-display
      201         ,output v-other
      202         ) no-error .
      203       if error-status :error then do:
      204         undo, return error return-value .
      205       end.
      206       find first buf_doc-line-attr no-lock
      207         where buf_doc-line-attr.doc-code  = p-doc-code
      208           and buf_doc-line-attr.gds-code = p-gds-code
      209           and buf_doc-line-attr.attr-code = p-code
      210         no-error .
      211       if  available buf_doc-line-attr then do:
      212         p-exist = yes.
      213       end.
      214     end.
      215   end procedure.
      216   procedure lineattr-delete :
      217     do
      218     on error undo, return error return-value
      219     :
      220       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      221       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      222       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      223       define output parameter p-deleted  as logical no-undo.
      224       define buffer buf_doc-line-attr for ub.doc-line-attr .
      225       def var v-type           as character no-undo .
      226       def var v-format         as character no-undo .
      227       def var v-fillin_width   as integer   no-undo .
      228       def var v-fillin_height  as integer   no-undo .
      229       def var v-label          as character no-undo .
      230       def var v-user-can-edit  as logical   no-undo .
      231       def var v-output-display as logical   no-undo .
      232       def var v-other          as character no-undo .
      233       run lineattr-code in this-procedure
      234         (input  p-code
      235         ,output v-type
      236         ,output v-format
      237         ,output v-fillin_width
      238         ,output v-fillin_height
      239         ,output v-label
      240         ,output v-user-can-edit
      241         ,output v-output-display
      242         ,output v-other
      243         ) no-error .
      244       if error-status :error then do:
      245         undo, return error return-value .
      246       end.
      247       find first buf_doc-line-attr exclusive-lock
      248         where buf_doc-line-attr.doc-code  = p-doc-code
      249           and buf_doc-line-attr.gds-code  = p-gds-code
      250           and buf_doc-line-attr.attr-code = p-code
      251         no-error NO-WAIT.
      252       if not available buf_doc-line-attr then do:
      253         p-deleted = no.
      254       end.
      255       else do:
      256         delete buf_doc-line-attr.
      257         p-deleted = yes.
      258       end.
      259     end.
      260   end procedure.
      261   procedure lineattr-code :
      262     do on error undo, return error return-value
      263     :
      264       define input  parameter p-code           as character no-undo .
      265       define output parameter p-type           as character no-undo .
      266       define output parameter p-format         as character no-undo .
      267       define output parameter p-fillin_width   as integer   no-undo .
      268       define output parameter p-fillin_height  as integer   no-undo .
      269       define output parameter p-label          as character no-undo .
      270       define output parameter p-user-can-edit  as logical   no-undo .
      271       define output parameter p-output-display as logical   no-undo .
      272       define output parameter p-other          as character no-undo .
      273       case p-code :
      274               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      275               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      276               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      277               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      278               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      279               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      280               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      281               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      282               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      283               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      284               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      285         otherwise do:
      286           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
      287         end.
      288       end.
      289     end.
      290   end procedure.
      291   procedure lineattr-value-flora-gds :
      292     do
      293     on error undo, return error return-value
      294     :
      295       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      296       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      297       define input  parameter p-prt-code    as integer   no-undo .
      298       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      299       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      300       define output parameter p-value       as    decimal   no-undo .
      301       define buffer buf_doc-line-attr for ub.doc-line-attr .
      302       find first buf_doc-line-attr no-lock
      303         where buf_doc-line-attr.doc-code  = p-doc-code
      304           and buf_doc-line-attr.gds-code  = p-gds-code
      305           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      306         no-error .
      307       if avail buf_doc-line-attr then do:
      308         assign
      309           p-value = decimal( buf_doc-line-attr.attr-value)
      310         .
      311       end.
      312       else do:
      313         assign
      314           p-value = 0
      315         .
      316       end.
      317     end.
      318   end procedure.
      319   procedure lineattr-write-flora-gds :
      320     do
      321     on error undo, return error return-value
      322     :
      323       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      324       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      325       define input parameter p-prt-code    as integer   no-undo .
      326       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      327       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      328       define input parameter p-value    as decimal   no-undo .
      329       define buffer buf_doc-line-attr for ub.doc-line-attr .
      330       find first buf_doc-line-attr exclusive-lock
      331         where buf_doc-line-attr.doc-code  = p-doc-code
      332           and buf_doc-line-attr.gds-code  = p-gds-code
      333           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      334         no-error .
      335       if not available buf_doc-line-attr then do:
      336         create buf_doc-line-attr .
      337         assign
      338           buf_doc-line-attr.doc-code  = p-doc-code
      339           buf_doc-line-attr.gds-code  = p-gds-code
      340           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      341         .
      342       end.
      343       assign
      344         buf_doc-line-attr.attr-value = string( p-value )
      345       .
      346     end.
      347   end procedure.
      348   procedure lineattr-delete-flora-gds :
      349     do
      350     on error undo, return error return-value
      351     :
      352       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      353       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      354       define input  parameter p-prt-code    as integer   no-undo .
      355       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      356       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      357       define output parameter p-deleted  as logical no-undo.
      358       define buffer buf_doc-line-attr for ub.doc-line-attr .
      359       find first buf_doc-line-attr exclusive-lock
      360         where buf_doc-line-attr.doc-code  = p-doc-code
      361           and buf_doc-line-attr.gds-code  = p-gds-code
      362           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      363         no-error NO-WAIT.
      364       if not available buf_doc-line-attr then do:
      365         p-deleted = no.
      366       end.
      367       else do:
      368         delete buf_doc-line-attr.
      369         p-deleted = yes.
      370       end.
      371     end.
      372   end procedure.
      373   procedure lineattr-delete-flora-all :
      374     do
      375     on error undo, return error return-value
      376     :
      377       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      378       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      379       define input  parameter p-prt-code    as integer   no-undo .
      380       define buffer buf_doc-line-attr for ub.doc-line-attr .
      381       for each buf_doc-line-attr exclusive-lock
      382         where buf_doc-line-attr.doc-code  = p-doc-code
      383           and buf_doc-line-attr.gds-code  = p-gds-code
      384           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
      385        :
      386         delete buf_doc-line-attr.
      387       end.
      388    end.
      389   end procedure.
      390   procedure lineattr-exist-flora-gds :
      391     do
      392     on error undo, return error return-value
      393     :
      394       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      395       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      396       define input  parameter p-prt-code    as integer   no-undo .
      397       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      398       define output parameter p-exist as logical   no-undo .
      399       define buffer buf_doc-line-attr for ub.doc-line-attr .
      400       p-exist = false .
      401       find first buf_doc-line-attr no-lock
      402         where buf_doc-line-attr.doc-code  = p-doc-code
      403           and buf_doc-line-attr.gds-code  = p-gds-code
      404           and buf_doc-line-attr.attr-code = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      405         no-error .
      406       if avail buf_doc-line-attr then do:
      407         assign
      408          p-exist = true
      409         .
      410       end.
      411     end.
      412   end procedure.
      413   procedure lineattr-write-add-line-cli :
      414   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      415   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      416   define input  parameter p-cli-type      as character no-undo .
      417   define input  parameter p-cli-code      as integer   no-undo .
      418   define input  parameter p-contract-code as integer   no-undo .
      419   define input  parameter p-host-code     as integer   no-undo .
      420   define input  parameter p-exch-code     as integer   no-undo .
      421   define input  parameter p-exch-rate     as decimal   no-undo .
      422   define input  parameter p-exch-scale    as integer   no-undo .
      423   define input  parameter p-sum-cli       as decimal   no-undo .
      424   define input  parameter p-sum-vat       as decimal   no-undo .
      425   define buffer buf_doc-line-attr for ub.doc-line-attr .
      426     do
      427     on error undo, return error return-value
      428     :
      429       find first buf_doc-line-attr exclusive-lock
      430         where buf_doc-line-attr.doc-code  = p-doc-code
      431           and buf_doc-line-attr.gds-code  = p-gds-code
      432           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      433                                             chr(4) + p-cli-type +
      434                                             chr(4) + string(p-cli-code) +
      435                                             chr(4) + string(p-contract-code) +
      436                                             chr(4) + string(p-host-code)
      437         no-error .
      438       if not available buf_doc-line-attr then do:
      439         create buf_doc-line-attr .
      440         assign
      441           buf_doc-line-attr.doc-code  = p-doc-code
      442           buf_doc-line-attr.gds-code  = p-gds-code
      443           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
      444                                         chr(4) + p-cli-type +
      445                                         chr(4) + string(p-cli-code) +
      446                                         chr(4) + string(p-contract-code) +
      447                                         chr(4) + string(p-host-code)
      448         .
      449       end.
      450       assign
      451         buf_doc-line-attr.attr-value =
      452         string(p-exch-code)  + chr(4) +
      453         string(p-exch-rate)  + chr(4) +
      454         string(p-exch-scale) + chr(4) +
      455         string(p-sum-cli)    + chr(4) +
      456         string(p-sum-vat)
      457         .
      458     end.
      459   end procedure.
      460   procedure lineattr-value-add-line-cli :
      461   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      462   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      463   define input   parameter p-cli-type      as character no-undo .
      464   define input   parameter p-cli-code      as integer   no-undo .
      465   define input   parameter p-contract-code as integer   no-undo .
      466   define input   parameter p-host-code     as integer   no-undo .
      467   define output  parameter p-exch-code     as integer   no-undo .
      468   define output  parameter p-exch-rate     as decimal   no-undo .
      469   define output  parameter p-exch-scale    as integer   no-undo .
      470   define output  parameter p-sum-cli       as decimal   no-undo .
      471   define output  parameter p-sum-vat       as decimal   no-undo .
      472   define buffer buf_doc-line-attr for ub.doc-line-attr .
      473     do
      474     on error undo, return error return-value
      475     :
      476       find first buf_doc-line-attr exclusive-lock
      477         where buf_doc-line-attr.doc-code  = p-doc-code
      478           and buf_doc-line-attr.gds-code  = p-gds-code
      479           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      480                                             chr(4) + p-cli-type +
      481                                             chr(4) + string(p-cli-code) +
      482                                             chr(4) + string(p-contract-code) +
      483                                             chr(4) + string(p-host-code)
      484         no-error .
      485       if available buf_doc-line-attr then do:
      486        assign
      487           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
      488           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
      489           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
      490           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
      491           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
      492          .
      493        end.
      494     end.
      495   end procedure.
      496   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
      497     define variable v-code as character no-undo .
      498     define variable v-type as character no-undo .
      499     define variable v-gds-code as integer   no-undo .
      500   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      501   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      502     (input  local-doc-line.artic
      503     ,input  local-doc-line.prod-type
      504     ,input  local-doc-line.prod-code
      505     ,output v-gds-code
      506     )  .
      507     run lineattr-value (
      508         input   local-doc-line.doc-code ,
      509         input   v-gds-code              ,
      510         input   'reason-code':U ,
      511         output  v-code                  ,
      512         output  v-type ) .
      513     find first ub.trn-reason no-lock where
      514                ub.trn-reason.reason-code = integer ( v-code ) no-error.
      515     if not available ub.trn-reason then do:
      516        return "" .
      517     end.
      518     else do:
      519        return ub.trn-reason.reason-name .
      520     end.
      521   end function.
      522   procedure lineattr-value-parts :
      523     do
      524     on error undo, return error return-value
      525     :
      526       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      527       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      528       define input  parameter p-part-code   as character no-undo .
      529       define input  parameter p_in-code     as character no-undo .
      530       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      531       define output parameter p-value       as    decimal   no-undo .
      532       define buffer buf_doc-line-attr for ub.doc-line-attr .
      533       find first buf_doc-line-attr no-lock
      534         where buf_doc-line-attr.doc-code  = p-doc-code
      535           and buf_doc-line-attr.gds-code  = p-gds-code
      536           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
      537         no-error .
      538       if avail buf_doc-line-attr then do:
      539         assign
      540           p-value = decimal( buf_doc-line-attr.attr-value)
      541         .
      542       end.
      543       else do:
      544         assign
      545           p-value = 0
      546         .
      547       end.
      548     end.
      549   end procedure.
      550   procedure lineattr-write-parts :
      551     do
      552     on error undo, return error return-value
      553     :
      554       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      555       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      556       define input parameter p-part-code  as character no-undo .
      557       define input parameter p_in-code    as character no-undo .
      558       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
      559       define input parameter p-value      as decimal   no-undo .
      560       define buffer buf_doc-line-attr for ub.doc-line-attr .
      561       find first buf_doc-line-attr exclusive-lock
      562         where buf_doc-line-attr.doc-code  = p-doc-code
      563           and buf_doc-line-attr.gds-code  = p-gds-code
      564           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      565         no-error .
      566       if not available buf_doc-line-attr then do:
      567         create buf_doc-line-attr .
      568         assign
      569           buf_doc-line-attr.doc-code  = p-doc-code
      570           buf_doc-line-attr.gds-code  = p-gds-code
      571           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      572         .
      573       end.
      574       assign
      575         buf_doc-line-attr.attr-value = string( p-value )
      576       .
      577     end.
      578   end procedure.
      579   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      580     define variable v-cntxt-db-num        as integer   no-undo .
      581     define variable v-cntxt-userid        as character no-undo .
      582     define variable v-cntxt-level         as character no-undo .
      583     define variable v-cntxt-host-code-obj as integer   no-undo .
      584     define variable v-cntxt-obj-type      as character no-undo .
      585     define variable v-cntxt-obj-code      as integer   no-undo .
      586     define variable v-cntxt-db-num-obj    as integer   no-undo .
      587     define variable v-cntxt-is-admin      as logical   no-undo .
      588   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      589     run mainmenu_getcntxt in parparentproc
      590       (output v-cntxt-db-num
      591       ,output v-cntxt-userid
      592       ,output v-cntxt-level
      593       ,output v-cntxt-host-code-obj
      594       ,output v-cntxt-obj-type
      595       ,output v-cntxt-obj-code
      596       ,output v-cntxt-db-num-obj
      597       ,output v-cntxt-is-admin
      598       ) .
      599   define variable v-insalepr as logical   no-undo .
      600   define variable v-method as character no-undo .
      601   define variable varvalue as character no-undo .
      602   define variable vartype  as character no-undo .
      603   define variable v-ves     as decimal   no-undo  init 0.
      604   define variable v-wt-base as decimal   no-undo init 0 .
      605   define variable g#report-num as integer   no-undo .
      606   define stream  errStream  .
      607   define variable v-gds-code as integer   no-undo .
      608   define variable v-old-other as character no-undo .
      609   define variable v-old-other-type as character no-undo .
      610   define variable v-NEW-other as character no-undo .
      611   define variable v-NEW-other-type as character no-undo .
      612   define variable v-old-other-rubl as decimal   no-undo .
      613   define variable v-old-other-base as decimal   no-undo .
      614   define variable v-old-tr-rubl as decimal   no-undo .
      615   define variable v-old-tr-base as decimal   no-undo .
      616   define variable v-NEW-other-rubl as decimal   no-undo .
      617   define variable v-NEW-other-base as decimal   no-undo .
      618   define variable v-delta-base  as decimal   no-undo .
      619   define variable v-delta-rubl  as decimal   no-undo .
      620   run get-report-num   in parParentProc ( output g#report-num ) .
      621   define variable v-exis as logical no-undo .
      622   define variable v-txt as character no-undo .
      623   find first ub.add-doc no-lock where
      624              ub.add-doc.doc-code = p-doc-code no-error .
      625   if error-status :error then return error substitute("Нет документа ДопРасхода  &1" ,p-doc-code ) .
      626   define variable v-method-4 as logical   no-undo .
      627   v-method-4 = false .
      628   for each  ub.add-line no-lock where
      629             ub.add-line.doc-code = ub.add-doc.doc-code :
      630       find first ub.gds-add-charges no-lock where
      631                  ub.gds-add-charges.gds-code = ub.add-line.gds-code and
      632                  ub.gds-add-charges.algoritm = '4' no-error .
      633        if available ub.gds-add-charges then  do:
      634           v-method-4 = true .
      635           leave.
      636        end.
      637   end.
      638   define variable   v-tot-sale  as decimal   no-undo .
      639   define variable   v-fact-qnty  as decimal   no-undo .
      640   define variable   v-cli-qnty  as decimal   no-undo .
      641   define variable vv-dl as decimal   no-undo .
      642   assign
      643     v-tot-sale  = 0
      644     v-fact-qnty = 0
      645     v-cli-qnty  = 0
      646     vv-dl = 0
      647   .
      648   for each ub.add-trn no-lock where ub.add-trn.doc-code = p-doc-code :
      649     for each ub.trn-doc no-lock where
      650              ub.trn-doc.doc-code = ub.add-trn.trn-doc-code :
      651              vv-dl = 0 .
      652              for each ub.doc-line no-lock where
      653                       ub.doc-line.doc-code = ub.trn-doc.doc-code :
      654                vv-dl = vv-dl + ( ub.doc-line.price-cli * ub.doc-line.cli-qnty) * ub.trn-doc.exch-rate  / ub.trn-doc.exch-scale .
      655              end.
      656       v-tot-sale  = v-tot-sale  + vv-dl  .
      657       v-fact-qnty = v-fact-qnty + ub.trn-doc.fact-qnty  .
      658       v-cli-qnty  = v-cli-qnty  + ub.trn-doc.cli-qnty   .
      659     end.
      660   end.
      661   if v-method-4 = true then do:
      662   output stream errStream to value( string( session:temp-directory +
      663                                        "rpt" + string( g#report-num ) ) )
      664                                        page-size 62 .
      665       v-exis = false .
      666      for each ub.add-trn no-lock where ub.add-trn.doc-code = p-doc-code,
      667          each ub.doc-line no-lock where ub.doc-line.doc-code = ub.add-trn.trn-doc-code :
      668          find first ub.goods where ub.goods.artic     = ub.doc-line.artic     and
      669                                 ub.goods.prod-type = ub.doc-line.prod-type and
      670                                 ub.goods.prod-code = ub.doc-line.prod-code no-lock.
      671          find first ub.units no-lock where ub.units.unit-name = ub.goods.unit-base  .
      672          if  ub.units.type = 'вес':U then do:
      673              v-wt-base = ub.doc-line.fact-qnty.
      674          end.
      675          else do:
      676            v-wt-base = ub.goods.wt-base * ub.doc-line.fact-qnty.
      677            if v-wt-base = ? or v-wt-base = 0 then do:
      678               Put  stream  errStream
      679                            ub.goods.artic " " ub.goods.gds-code " " ub.goods.gds-name  skip .
      680               v-exis = true.
      681            end.
      682          end.
      683          v-ves =  v-ves + v-wt-base  .
      684      end.
      685       if v-exis = true then do:
      686           define variable v-user-action   as character no-undo .
      687           define variable v-printed       as logical no-undo .
      688             message
      689             "Обнаружены товары без проставленного веса за штуку ! " skip
      690             "Вы можете просмотреть и распечатать их список . "      skip
      691             "Редактирование веса в карточке товара . "      skip
      692             view-as alert-box error .
      693         Output stream errStream   close .
      694           run gbl/prnfilen.w
      695             (input  "Товары без веса"
      696             ,input  0
      697             ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
      698             ,input 7
      699             ,output v-user-action
      700             ,output v-printed
      701             ) .
      702             if not ( lookup( ' экран':L, v-user-action ,";")  > 0 or
      703                       lookup( ' принтер':L, v-user-action ,";")  > 0  ) then do:
      704                         message "Внимание , вы не просмотрели список товаров ! "  .
      705                       end.
      706             return error.
      707       end.
      708   end.
      709   tr:
      710   do transaction
      711      ON ERROR   UNDO tr, LEAVE
      712      ON END-KEY UNDO tr, LEAVE
      713      ON STOP    UNDO tr , LEAVE :
      714     for each ub.add-trn no-lock where ub.add-trn.doc-code = p-doc-code,
      715         each ub.doc-line exclusive-lock   where ub.doc-line.doc-code = ub.add-trn.trn-doc-code :
      716   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      717   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      718     (input  ub.doc-line.artic
      719     ,input  ub.doc-line.prod-type
      720     ,input  ub.doc-line.prod-code
      721     ,output v-gds-code
      722     )  .
      723           run lineattr-value in this-procedure (
      724               ub.doc-line.doc-code ,
      725               v-gds-code    ,
      726               'new_other-ras':U ,
      727               output v-NEW-other       ,
      728               output v-NEW-other-type
      729               ) no-error .
      730           v-NEW-other-rubl = decimal ( entry(1,v-NEW-other,chr(4))) no-error .
      731           v-NEW-other-base = decimal ( entry(2,v-NEW-other,chr(4))) no-error .
      732           run lineattr-value in this-procedure (
      733               ub.doc-line.doc-code ,
      734               v-gds-code    ,
      735               'old_other-ras':U ,
      736               output v-old-other       ,
      737               output v-old-other-type
      738               ) no-error .
      739            if error-status :error or v-old-other = "" then
      740            assign
      741               v-old-other-rubl = 0
      742               v-old-other-base = 0
      743               v-old-tr-rubl = 0
      744               v-old-tr-base = 0
      745            .
      746            else do:
      747               v-old-other-rubl = decimal ( entry(1,v-old-other,chr(4))) no-error .
      748               v-old-other-base = decimal ( entry(2,v-old-other,chr(4))) no-error .
      749               v-old-tr-rubl    = decimal ( entry(3,v-old-other,chr(4))) no-error .
      750               v-old-tr-base    = decimal ( entry(4,v-old-other,chr(4))) no-error .
      751               if v-old-other-rubl = ? then v-old-other-rubl = 0 .
      752               if v-old-other-base = ? then v-old-other-base = 0 .
      753               if v-old-tr-rubl    = ? then v-old-tr-rubl = 0 .
      754               if v-old-tr-base    = ? then v-old-tr-base = 0 .
      755           end.
      756         assign
      757           ub.doc-line.transport-rubl = ub.doc-line.transport-rubl  -  v-old-tr-rubl
      758           ub.doc-line.transport-base = ub.doc-line.transport-base  -  v-old-tr-base
      759           ub.doc-line.other-rubl = ub.doc-line.other-rubl  -  v-NEW-other-rubl -  v-old-other-rubl
      760           ub.doc-line.other-base = ub.doc-line.other-base  -  v-NEW-other-base -  v-old-other-base
      761           ub.doc-line.price-rubl = ub.doc-line.price-rubl  -  v-NEW-other-rubl -  v-old-other-rubl -  v-old-tr-rubl
      762           ub.doc-line.price-base = ub.doc-line.price-base  -  v-NEW-other-base -  v-old-other-base -  v-old-tr-base
      763         .
      764     end.
      765     for each ub.add-line no-lock where
      766              ub.add-line.doc-code = p-doc-code ,
      767              first ub.gds-add-charges no-lock where
      768                    ub.gds-add-charges.gds-code = ub.add-line.gds-code and
      769                    ub.gds-add-charges.cost-include = true
      770              :
      771      for each ub.add-trn no-lock where
      772               ub.add-trn.doc-code = p-doc-code ,
      773          each ub.doc-line exclusive-lock where
      774               ub.doc-line.doc-code = ub.add-trn.trn-doc-code
      775               :
      776          find first ub.goods where ub.goods.artic     = ub.doc-line.artic     and
      777                                 ub.goods.prod-type = ub.doc-line.prod-type and
      778                                 ub.goods.prod-code = ub.doc-line.prod-code no-lock.
      779          find ub.units where ub.units.unit-name = ub.goods.unit-base no-lock.
      780   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      781   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
      782     (input  ub.doc-line.obj-type
      783     ,input  ub.doc-line.obj-code
      784     ,input  ub.doc-line.artic
      785     ,input  ub.doc-line.prod-type
      786     ,input  ub.doc-line.prod-code
      787     ,input  'insalepr=request':U
      788     ,output v-insalepr
      789     )  .
      790          if v-insalepr = true then do:
      791             undo tr, return error "В накладной " + string(ub.doc-line.doc-code) + " имеется товар " + string(ub.goods.artic) + " "
      792                                   + string(ub.goods.prod-type) + " " + string(ub.goods.prod-code) + " принимаемый по продажной цене." +
      793                                   " Недопустимы  прочие расходы.".
      794          end.
      795          if ub.doc-line.other-rubl     = ? then ub.doc-line.other-rubl     = 0.
      796          if ub.doc-line.other-base     = ? then ub.doc-line.other-base     = 0.
      797          if  ub.units.type = 'вес':U then do:
      798              v-wt-base = ub.doc-line.fact-qnty.
      799             end.
      800             else do:
      801               v-wt-base = ub.goods.wt-base * ub.doc-line.fact-qnty.
      802             end.
      803           assign
      804             v-delta-base = 0
      805             v-delta-rubl = 0
      806           .
      807           case ub.gds-add-charges.algoritm :
      808               when "1"  then do:
      809                     assign
      810                           ub.doc-line.other-base = ub.doc-line.other-base + ( ub.doc-line.price-base * ub.add-line.sum-rubl  / v-tot-sale)
      811                           ub.doc-line.other-rubl = ub.doc-line.other-rubl + ( ub.doc-line.price-rubl * ub.add-line.sum-rubl  / v-tot-sale)
      812                           v-delta-base =  ub.doc-line.price-base * ub.add-line.sum-rubl  / v-tot-sale
      813                           v-delta-rubl =  ub.doc-line.price-rubl * ub.add-line.sum-rubl  / v-tot-sale
      814                       .
      815               end.
      816               when "2"  then do:
      817                     assign
      818                           ub.doc-line.other-base = ub.doc-line.other-base + ( ub.add-line.sum-base  / v-fact-qnty )
      819                           ub.doc-line.other-rubl = ub.doc-line.other-rubl + ( ub.add-line.sum-rubl  / v-fact-qnty )
      820                           v-delta-base =  ub.add-line.sum-base  / v-fact-qnty
      821                           v-delta-rubl =  ub.add-line.sum-rubl  / v-fact-qnty
      822                           .
      823               end.
      824               when "3"  then do:
      825                     assign
      826                           ub.doc-line.other-base = ub.doc-line.other-base + (( ub.doc-line.cli-qnty * ub.add-line.sum-base  / v-cli-qnty ) / ub.doc-line.fact-qnty )
      827                           ub.doc-line.other-rubl = ub.doc-line.other-rubl + (( ub.doc-line.cli-qnty * ub.add-line.sum-rubl  / v-cli-qnty ) / ub.doc-line.fact-qnty )
      828                           v-delta-base = ( ub.doc-line.cli-qnty * ub.add-line.sum-base  / v-cli-qnty ) / ub.doc-line.fact-qnty
      829                           v-delta-rubl = ( ub.doc-line.cli-qnty * ub.add-line.sum-rubl  / v-cli-qnty ) / ub.doc-line.fact-qnty
      830                           .
      831               end.
      832               when "4"  then do:
      833                     assign
      834                           ub.doc-line.other-base = ub.doc-line.other-base + ( v-wt-base * ub.add-line.sum-base  / v-ves) / ub.doc-line.fact-qnty
      835                           ub.doc-line.other-rubl = ub.doc-line.other-rubl + ( v-wt-base * ub.add-line.sum-rubl  / v-ves) / ub.doc-line.fact-qnty
      836                           v-delta-base = ( v-wt-base * ub.add-line.sum-base  / v-ves ) / ub.doc-line.fact-qnty
      837                           v-delta-rubl = ( v-wt-base * ub.add-line.sum-rubl  / v-ves ) / ub.doc-line.fact-qnty
      838                       .
      839               end.
      840           end case.
      841           run add-d-part
      842             (input ub.doc-line.doc-code
      843             ,input p-doc-code
      844             ,input ub.goods.gds-code
      845             ,input ub.gds-add-charges.gds-code
      846             ,input ub.add-line.cli-type
      847             ,input ub.add-line.cli-code
      848             ,input ub.add-line.contract-code
      849             ,input ub.add-line.host-code
      850             ,input ub.add-line.vat-pc
      851             ,input v-delta-base
      852             ,input v-delta-rubl
      853             ) no-error.
      854           if error-status:error then do:
      855             undo tr, return error substitute(" Ошибка создания партий по дополнительному расходу в учетной цене &1 &2" , return-value , error-status :get-message(1)   ) .
      856           end.
      857     end.
      858    end.
      859      for each ub.add-trn no-lock where ub.add-trn.doc-code = p-doc-code,
      860          first ub.trn-doc no-lock  where
      861                ub.trn-doc.doc-code = ub.add-trn.trn-doc-code :
      862          for each ub.doc-line exclusive-lock where
      863                   ub.doc-line.doc-code = ub.trn-doc.doc-code :
      864   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      865   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      866     (input  ub.doc-line.artic
      867     ,input  ub.doc-line.prod-type
      868     ,input  ub.doc-line.prod-code
      869     ,output v-gds-code
      870     )  .
      871               run lineattr-write in this-procedure (
      872                   ub.doc-line.doc-code ,
      873                   v-gds-code    ,
      874                   'new_other-ras':U ,
      875                   string(ub.doc-line.other-rubl) + chr(4) + string(ub.doc-line.other-base)
      876                   ) .
      877               run lineattr-value in this-procedure (
      878                   ub.doc-line.doc-code ,
      879                   v-gds-code    ,
      880                   'old_other-ras':U ,
      881                   output v-old-other       ,
      882                   output v-old-other-type
      883                   ) no-error .
      884                   if error-status :error or  v-old-other = ""  then
      885                   assign
      886                     v-old-other-rubl = 0
      887                     v-old-other-base = 0
      888                     v-old-tr-rubl = 0
      889                     v-old-tr-base = 0
      890                   .
      891                   else do:
      892                     v-old-other-rubl = decimal ( entry(1,v-old-other,chr(4))) no-error .
      893                     v-old-other-base = decimal ( entry(2,v-old-other,chr(4))) no-error .
      894                     v-old-tr-rubl = decimal ( entry(3,v-old-other,chr(4))) no-error .
      895                     v-old-tr-base = decimal ( entry(4,v-old-other,chr(4))) no-error .
      896                     if v-old-other-rubl = ? then v-old-other-rubl = 0 .
      897                     if v-old-other-base = ? then v-old-other-base = 0 .
      898                     if v-old-tr-rubl    = ? then v-old-tr-rubl = 0 .
      899                     if v-old-tr-base    = ? then v-old-tr-base = 0 .
      900                   end.
      901               ub.doc-line.price-rubl = ub.doc-line.price-rubl + ub.doc-line.other-rubl + v-old-other-rubl + v-old-tr-rubl.
      902               ub.doc-line.price-base = ub.doc-line.price-base + ub.doc-line.other-base + v-old-other-base + v-old-tr-base.
      903               ub.doc-line.other-rubl = ub.doc-line.other-rubl + v-old-other-rubl.
      904               ub.doc-line.other-base = ub.doc-line.other-base + v-old-other-base.
      905               ub.doc-line.transport-rubl = ub.doc-line.transport-rubl  +  v-old-tr-rubl .
      906               ub.doc-line.transport-base = ub.doc-line.transport-base  +  v-old-tr-base .
      907             run trg/partsupd.p
      908               (input parparentproc
      909               ,input ub.trn-doc.doc-code
      910               ,input ub.trn-doc.obj-type
      911               ,input ub.trn-doc.obj-code
      912               ,input ub.doc-line.artic
      913               ,input ub.doc-line.prod-type
      914               ,input ub.doc-line.prod-code
      915               ,input true
      916               ,input ""
      917               ) no-error.
      918             if error-status:error then do:
      919               undo tr, return error "Ошибка при редактировании партий.".
      920             end.
      921         end.
      922         run gbl/calc-trn.p (input parparentproc, input recid(ub.trn-doc)) no-error.
      923         if error-status:error then undo tr, return error.
      924      end.
      925   end.
      926   procedure add-d-part :
      927   define input  parameter p-trn-doc-code  as character no-undo .
      928   define input  parameter p-add-doc-code  as character no-undo .
      929   define input  parameter p-gds-code      as integer   no-undo .
      930   define input  parameter p-add-gds-code  as integer   no-undo .
      931   define input  parameter p-cli-type      as character no-undo .
      932   define input  parameter p-cli-code      as integer   no-undo .
      933   define input  parameter p-contract-code as integer   no-undo .
      934   define input  parameter p-host-code     as integer   no-undo .
      935   define input  parameter p-vat-pc        as decimal   no-undo .
      936   define input  parameter p-delta-base    as decimal   no-undo .
      937   define input  parameter p-delta-rubl    as decimal   no-undo .
      938   define buffer buf_parts-add for ub.parts-add .
      939   define buffer buf_add-doc   for ub.add-doc   .
      940   define buffer buf_add-line  for ub.add-line  .
      941   define buffer buf_add-trn   for ub.add-trn   .
      942   define buffer buf_contract for ub.contract  .
      943   define variable varcr-incfo as logical   no-undo .
      944   define variable varundef as logical   no-undo .
      945     do
      946     on error undo, return error return-value
      947     :
      948   find first buf_parts-add exclusive-lock where
      949             buf_parts-add.in-code      =  p-trn-doc-code  and
      950             buf_parts-add.gds-code     =  p-gds-code      and
      951             buf_parts-add.part-code    =  ''              and
      952             buf_parts-add.add-doc-code =  p-add-doc-code  and
      953             buf_parts-add.add-gds-code =  p-add-gds-code  and
      954             buf_parts-add.cli-type     =  p-cli-type      and
      955             buf_parts-add.cli-code     =  p-cli-code      and
      956             buf_parts-add.host-code    =  p-host-code     and
      957             buf_parts-add.contract-code = p-contract-code no-error .
      958         if not available buf_parts-add then do:
      959           create buf_parts-add .
      960         end.
      961         assign
      962           buf_parts-add.in-code      =  p-trn-doc-code
      963           buf_parts-add.gds-code     =  p-gds-code
      964           buf_parts-add.part-code    =  ''
      965           buf_parts-add.add-doc-code =  p-add-doc-code
      966           buf_parts-add.add-gds-code =  p-add-gds-code
      967           buf_parts-add.cli-type     =  p-cli-type
      968           buf_parts-add.cli-code     =  p-cli-code
      969           buf_parts-add.host-code    =  p-host-code
      970           buf_parts-add.contract-code = p-contract-code
      971           buf_parts-add.sum-base      = p-delta-base
      972           buf_parts-add.sum-rubl      = p-delta-rubl
      973           buf_parts-add.sum-other-base = p-vat-pc
      974           buf_parts-add.sum-other-rubl = p-delta-rubl
      975         .
      976         find first buf_contract no-lock where
      977                   buf_contract.host-code     = p-host-code    and
      978                   buf_contract.contract-code = p-contract-code
      979                   no-error .
      980         if available buf_contract then do:
      981             if lookup (buf_contract.usl-opl, 'По факту поставки,Отсрочка платежа (по поставке)') > 0 then do:
      982               assign
      983                 varcr-incfo = yes.
      984             end.
      985             if buf_contract.usl-opl = 'Не определено':U then do:
      986               assign
      987                 varundef = yes.
      988             end.
      989           find first buf_add-doc exclusive-lock where
      990                     buf_add-doc.doc-code = p-add-doc-code no-error .
      991           if varcr-incfo = yes then do:
      992             assign
      993               buf_add-doc.need-incfo = 1
      994               .
      995           end.
      996           else do:
      997             if varundef = yes  and buf_add-doc.need-incfo <> 1 then do:
      998               assign
      999                 buf_add-doc.need-incfo = 2
     1000                 .
     1001             end.
     1002           end.
     1003        if (buf_contract.gen-factur = 1  or
     1004            buf_contract.gen-factur = 11 or
     1005            buf_contract.gen-factur = 101 or
     1006            buf_contract.gen-factur = 111 ) then do:
     1007          assign  buf_add-doc.need-factur = 1 .
     1008        end.
     1009       end.
     1010     end.
     1011   end procedure.
