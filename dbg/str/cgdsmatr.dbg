      431   procedure prn-lib-open-stream :
      432     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      433     define input parameter p-page-size    as integer no-undo .
      434     define input parameter p-is-stream    as logical no-undo .
      435     define input parameter p-append       as logical no-undo .
      436     define variable v-report-name as character no-undo .
      437     do
      438       on error undo, return error
      439       :
      440       run prn-lib-get-report-name  in this-procedure (
      441         input parParentProc
      442         ,output v-report-name
      443         ).
      444       if p-is-stream then
      445       do:
      446         if p-append then
      447         do:
      448           output stream PrnLibStream to value( v-report-name )
      449             page-size value(p-page-size) append .
      450         end.
      451         if not p-append then
      452         do:
      453           output stream PrnLibStream to value( v-report-name )
      454             page-size value(p-page-size) .
      455         end.
      456       end.
      457       if not p-is-stream then
      458       do:
      459         if p-append then
      460         do:
      461           output to value( v-report-name )
      462             page-size value(p-page-size) append .
      463         end.
      464         if not p-append then
      465         do:
      466           output to value( v-report-name )
      467             page-size value(p-page-size) .
      468         end.
      469       end.
      470     end.
      471   end procedure.
      472   procedure prn-lib-open-exp :
      473     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      474     define input parameter p-is-stream    as logical no-undo .
      475     define input parameter p-is-append    as logical no-undo .
      476     define output parameter p-ReportFileName as char init "report" no-undo.
      477     define output parameter p-process as logical no-undo .
      478     define variable glog as logical no-undo .
      479     do
      480       on error undo, return error
      481       :
      482       SYSTEM-DIALOG GET-FILE p-ReportFileName
      483         TITLE      "Укажите путь"
      484         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      485         ASK-OVERWRITE
      486         CREATE-TEST-FILE
      487         SAVE-AS
      488         USE-FILENAME
      489         DEFAULT-EXTENSION "txt"
      490         UPDATE glog
      491         .
      492       if not glog then  return.
      493       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      494       if p-is-stream then
      495       do:
      496         if p-is-append then
      497         do:
      498           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      499         end.
      500         else
      501         do:
      502           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      503         end.
      504       end.
      505       else
      506       do:
      507         if p-is-append then
      508         do:
      509           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      510         end.
      511         else
      512         do:
      513           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      514         end.
      515       end.
      516       p-process = yes.
      517     end.
      518   end procedure.
      519   procedure prn-lib-get-report-name :
      520     define input parameter parParentProc  as widget-handle no-undo.
      521     define output parameter p-report-name as character no-undo .
      522     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      523   end procedure.
      524   procedure prn-lib-reportviewer-report-name :
      525     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      526     define input parameter p-report-name-html as character no-undo .
      527     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      528   end procedure.
      529   procedure prn-lib-reportviewer :
      530     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      531     define input parameter p-report-name-html as character no-undo .
      532     define input parameter p-param        as character no-undo .
      533     define variable v-excel           as character no-undo init 'TRUE' .
      534     define variable v-value-character as character no-undo .
      535     define variable v-value-integer   as character no-undo .
      536     define variable v-value-date      as date      no-undo .
      537     define variable v-value-decimal   as decimal   no-undo .
      538     define variable rep-excel         as logical   no-undo .
      539     define variable excel-string      as character no-undo .
      540     define variable v-param-type      as character no-undo .
      541     define variable v-tth             as handle    no-undo .
      542     run adm/shattri.p (
      543       input "get":U
      544       ,input  ""
      545       ,input  0
      546       ,input  'report-glob':U
      547       ,input  'rep-excel':U
      548       ,output v-value-character
      549       ,output v-value-date
      550       ,output v-value-decimal
      551       ,output v-value-integer
      552       ,output rep-excel
      553       ,output v-param-type
      554       ,INPUT-OUTPUT table-handle v-tth
      555       )  .
      556     if rep-excel then v-excel = "TRUE" .
      557     else v-excel = "FALSE" .
      558     if p-param eq ""
      559     then
      560        p-param = "EXCEL:" + v-excel.
      561     else
      562        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      563     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      564   end procedure.
      565   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      566   procedure cur-time :
      567      define output parameter p-today as date      no-undo .
      568      define output parameter p-time  as integer   no-undo .
      569     do
      570     on error undo, return error
      571     :
      572       define variable v-date1 as date      no-undo .
      573       define variable v-date2 as date      no-undo .
      574       define variable v-time  as integer   no-undo .
      575       assign
      576         v-date1 = today
      577         v-time  = time
      578         v-date2 = today
      579       .
      580       if v-date1 <> v-date2
      581       then do:
      582         assign
      583           v-date1 = today
      584           v-time  = v-time
      585         .
      586       end.
      587       assign
      588         p-today = v-date1
      589         p-time  = v-time
      590       .
      591     end.
      592   end.
      593   function cur-time-date returns character
      594   :
      595     return string(today, '99/99/9999':U) .
      596   end.
      597   function cur-time-mjd returns decimal
      598   :
      599     define variable v-date as date      no-undo .
      600     define variable v-time as integer   no-undo .
      601     run cur-time in this-procedure
      602       (output v-date
      603       ,output v-time
      604       ) .
      605     return integer(v-date) - 2400002 + (v-time / 86400) .
      606   end.
      607   function cur-time-get-ending-index returns integer
      608   (input p-number as integer
      609   )
      610   :
      611     if p-number < 0
      612     or p-number = ?
      613     then do:
      614       return 1 .
      615     end.
      616     define variable v-rest as integer   no-undo .
      617     assign
      618       p-number = p-number modulo 100
      619     .
      620     if p-number < 20
      621     then do:
      622       assign
      623         v-rest = p-number
      624       .
      625     end.
      626     else do:
      627       assign
      628         v-rest = p-number modulo 10
      629       .
      630     end.
      631     case v-rest :
      632       when 1
      633       then do:
      634         return 2 .
      635       end.
      636       when 2 or
      637       when 3 or
      638       when 4
      639       then do:
      640         return 3 .
      641       end.
      642       otherwise do:
      643         return 1 .
      644       end.
      645     end case .
      646   end.
      647   procedure cur-time-mjd-to-date :
      648      define input  parameter i-mjd-diff as decimal no-undo.
      649      define output parameter o-Date     as date    no-undo.
      650      define output parameter o-Time     as integer no-undo.
      651      define variable v-day-number as integer   no-undo .
      652      if    i-mjd-diff < 0
      653         or i-mjd-diff = ?
      654      then do:
      655         return "?" .
      656      end.
      657      assign
      658         v-day-number = truncate(i-mjd-diff,0).
      659         o-Date = date(v-day-number + 2400002).
      660         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      661     .
      662   end.
      663   function cur-time-mjd-to-string returns character
      664   (input p-mjd-diff as decimal
      665   )
      666   :
      667     define variable v-day-number as integer   no-undo .
      668     define variable v-seconds    as integer   no-undo .
      669     define variable v-hour       as integer   no-undo .
      670     define variable v-min        as integer   no-undo .
      671     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      672     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      673     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      674     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      675     if p-mjd-diff < 0
      676     or p-mjd-diff = ?
      677     then do:
      678       return "?" .
      679     end.
      680     assign
      681       v-day-number = integer(truncate(p-mjd-diff,0))
      682       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      683     .
      684     if v-seconds > 86400
      685     then do:
      686       assign
      687         v-seconds = 86400 - 1
      688       .
      689     end.
      690     if v-seconds < 0
      691     then do:
      692       assign
      693         v-seconds = 0
      694       .
      695     end.
      696     assign
      697       v-hour = truncate(v-seconds / 3600, 0)
      698     .
      699     assign
      700       v-seconds = v-seconds modulo 3600
      701     .
      702     assign
      703       v-min = truncate(v-seconds / 60, 0)
      704     .
      705     assign
      706       v-seconds = v-seconds modulo 60
      707     .
      708     return
      709         (if v-day-number <> 0
      710           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      711           else ""
      712         )
      713       + (if v-day-number <> 0 or v-hour <> 0
      714           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      715           else ""
      716         )
      717       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      718           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      719           else ""
      720         )
      721       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      722       .
      723   end.
      724   function cur-time-string returns character
      725   :
      726     define variable v-date as date      no-undo .
      727     define variable v-time as integer   no-undo .
      728     run cur-time in this-procedure
      729       (output v-date
      730       ,output v-time
      731       ) .
      732     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      733   end.
      734   function cur-time-string-sec returns character
      735   :
      736     define variable v-date as date      no-undo .
      737     define variable v-time as integer   no-undo .
      738     run cur-time in this-procedure
      739       (output v-date
      740       ,output v-time
      741       ) .
      742     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      743   end.
      744   function cur-time-custom  returns character
      745   (input p-prefix as character
      746   ,input p-date-format as character
      747   ,input p-delimiter as character
      748   ,input p-time-format as character
      749   ,input p-suffix as character
      750   )
      751   :
      752     define variable v-date as date      no-undo .
      753     define variable v-time as integer   no-undo .
      754     run cur-time in this-procedure
      755       (output v-date
      756       ,output v-time
      757       ) .
      758     return
      759       p-prefix
      760       + string(v-date, p-date-format)
      761       + p-delimiter
      762       + string(v-time, p-time-format)
      763       + p-suffix
      764       .
      765   end.
      766   function cur-time-print  returns character
      767   :
      768     define variable v-date as date      no-undo .
      769     define variable v-time as integer   no-undo .
      770     run cur-time in this-procedure
      771       (output v-date
      772       ,output v-time
      773       ) .
      774     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      775   end.
      776   function cur-time-datetime returns datetime
      777   :
      778     define variable v-char as character no-undo .
      779     define variable v-datetime as datetime no-undo .
      780     v-char = cur-time-string().
      781     v-datetime = datetime(v-char).
      782     return  v-datetime.
      783   end.
      784   function cur-time-string-msec returns character
      785   :
      786     define variable v-date as datetime  no-undo .
      787     v-date = now.
      788     return string(v-date) .
      789   end.
      790   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      791   define variable sort-column-name as character no-undo .
      792   define variable v-db-num LIKE ub.db.db-num no-undo.
      793   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      794   define  temp-table temp-changes no-undo
      795   field f_name as character
      796   field l_name as character
      797   field v_old as character
      798   field v_new as character
      799   field t_name as character
      800   field num_ as integer
      801   field uniq-key-rec as character
      802   field action as integer
      803   field fNotChange as logical
      804   index pi is unique primary
      805   num_
      806   t_name
      807   f_name
      808   index
      809   Chan
      810   fnotChange
      811   t_name
      812   f_name
      813   index imain uniq-key-rec
      814   .
      815   FUNCTION get-all-fields returns character (p-file-name as character ):
      816   define variable v-dop as character no-undo .
      817     find first _file no-lock where _file._file-name = p-file-name no-error .
      818     if not available _file then return "":U.
      819     for each _field no-lock where
      820              _field._file-recid = recid(_file) :
      821       assign
      822       v-dop = v-dop + _field._field-name + chr(44)
      823       .
      824     end.
      825     return trim(v-dop).
      826   END FUNCTION.
      827   PROCEDURE proc-full-temp-changes :
      828     define input  parameter p-hst-handle as handle    no-undo .
      829     define input  parameter p-main-table as character no-undo .
      830     define input  parameter p-field-list as character no-undo .
      831     define input  parameter p-label-form as character no-undo .
      832     define variable h-new-buf         as handle    no-undo .
      833     define variable h-main-buf        as handle    no-undo .
      834     define variable h-for-comp        as handle    no-undo .
      835     define variable v-inform          as character no-undo .
      836     define variable v-ind             as integer   no-undo .
      837     define variable v-idx-field-qnty  as integer   no-undo .
      838     define variable v-num-entries     as integer   no-undo .
      839     define variable fh                as handle    no-undo .
      840     define variable fh-main           as handle    no-undo .
      841     define variable fh-old            as handle    no-undo .
      842     define variable fh-new            as handle    no-undo .
      843     define variable v-field-name      as character no-undo .
      844     define variable v-field-lvl       as character no-undo .
      845     define variable v-field-form      as character no-undo .
      846     define variable v-search-exp      as character no-undo .
      847     define variable v-srch-main       as character no-undo .
      848     define variable v-word-link       as character no-undo .
      849     define variable v-av-chip-num     as logical   no-undo .
      850     define variable v-main-pi-fld-lst as character no-undo .
      851     define variable v-main-fld-lst    as character no-undo .
      852     define variable v-delim-list      as character no-undo .
      853     define variable v-label           as character no-undo .
      854     define variable v-old-value       as character no-undo case-sensitive.
      855     define variable v-new-value       as character no-undo case-sensitive.
      856     define variable v-chg-fields as character no-undo.
      857     for each temp-changes:
      858       delete temp-changes.
      859     end.
      860     if not p-hst-handle:available then do:
      861       return .
      862     end.
      863     create buffer h-new-buf  for table p-hst-handle .
      864     create buffer h-main-buf for table p-main-table .
      865     assign
      866       v-inform = h-main-buf:index-information(1)
      867       v-ind    = 2
      868     .
      869     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      870     on error undo, return error
      871     :
      872       assign
      873         v-inform = h-main-buf:index-information( v-ind )
      874         v-ind    = v-ind + 1
      875       .
      876     end.
      877     if v-inform = ?
      878       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      879       or entry( 3, v-inform, ",":U ) <> "1":U
      880     then do:
      881       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      882     end.
      883     assign
      884       v-idx-field-qnty = num-entries( v-inform ) - 4
      885     .
      886     if v-idx-field-qnty < 2 then do:
      887       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      888     end.
      889     assign
      890       v-srch-main   = "where":U
      891       v-word-link   = "":U
      892       v-av-chip-num = false
      893       v-delim-list  = "":U
      894     .
      895     do v-ind = 1 to v-idx-field-qnty by 2
      896     on error undo, return error
      897     :
      898       assign
      899         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      900         fh                = p-hst-handle:buffer-field( v-field-name )
      901         fh-main           = h-main-buf:buffer-field( v-field-name )
      902         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      903         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      904       .
      905       if fh:data-type ="character":U then do:
      906         assign
      907           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      908         .
      909       end.
      910       else do:
      911         assign
      912           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      913         .
      914       end.
      915       if v-delim-list = "":U then do:
      916         assign
      917           v-delim-list = ",":U
      918         .
      919       end.
      920       if v-word-link = "":U then do:
      921         assign
      922           v-word-link = "and":U
      923         .
      924       end.
      925     end.
      926     assign
      927       v-delim-list  = "":U
      928     .
      929     do v-ind = 1 to h-main-buf:num-fields
      930     on error undo, return error
      931     :
      932       assign
      933         fh-main      = h-main-buf:buffer-field( v-ind )
      934         v-field-name = fh-main:name
      935       .
      936         assign
      937           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      938         .
      939         if v-delim-list = "":U then do:
      940           assign
      941             v-delim-list = ",":U
      942           .
      943         end.
      944     end.
      945     assign
      946       v-inform = p-hst-handle:index-information(1)
      947       v-ind    = 2
      948     .
      949     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      950     on error undo, return error
      951     :
      952       assign
      953         v-inform = p-hst-handle:index-information( v-ind )
      954         v-ind    = v-ind + 1
      955       .
      956     end.
      957     if v-inform = ?
      958       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      959       or entry( 3, v-inform, ",":U ) <> "1":U
      960     then do:
      961       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      962     end.
      963     assign
      964       v-idx-field-qnty = num-entries( v-inform ) - 4
      965     .
      966     if v-idx-field-qnty < 2 then do:
      967       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      968     end.
      969     assign
      970       v-search-exp  = "where":U
      971       v-word-link   = "":U
      972       v-av-chip-num = false
      973     .
      974     do v-ind = 1 to v-idx-field-qnty by 2
      975     on error undo, return error
      976     :
      977       assign
      978         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      979         fh           = p-hst-handle:buffer-field( v-field-name )
      980         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      981       .
      982       if v-field-name = "chip-num":U then do:
      983         assign
      984           v-search-exp  = substitute( "&1 >", v-search-exp )
      985           v-av-chip-num = true
      986         .
      987       end.
      988       else do:
      989         assign
      990           v-search-exp = substitute( "&1 =", v-search-exp )
      991         .
      992       end.
      993       if fh:data-type ="character":U then do:
      994         assign
      995           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      996         .
      997       end.
      998       else do:
      999         assign
     1000           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1001         .
     1002       end.
     1003       if v-word-link = "":U then do:
     1004         assign
     1005           v-word-link = "and":U
     1006         .
     1007       end.
     1008     end.
     1009     if v-av-chip-num = false then do:
     1010       message
     1011         vss-workfile vss-revision vss-description skip
     1012         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1013         "Использование данной процедуры невозможно!" skip
     1014         view-as alert-box error .
     1015       return error .
     1016     end.
     1017     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1018     if not h-new-buf:available then do:
     1019       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1020       if not h-main-buf:available then do:
     1021         assign
     1022           h-for-comp = ?
     1023         .
     1024       end.
     1025       else do:
     1026         assign
     1027           h-for-comp = h-main-buf
     1028         .
     1029       end.
     1030     end.
     1031     else do:
     1032       assign
     1033         h-for-comp = h-new-buf
     1034       .
     1035     end.
     1036     assign
     1037       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1038     .
     1039     do v-ind = 1 to v-num-entries
     1040     on error undo, return error return-value
     1041     :
     1042       assign
     1043         v-field-name = entry( v-ind, v-main-fld-lst )
     1044         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1045         v-old-value  = fh-old:buffer-value()
     1046         v-label      = trim( fh-old:label )
     1047       .
     1048       if ( trim( p-field-list ) <> "":U
     1049            and lookup( v-field-name, p-field-list ) > 0
     1050          )
     1051          or trim( p-field-list ) = "":U
     1052       then do:
     1053         if h-for-comp <> ? then do:
     1054           assign
     1055             fh-new      = h-for-comp:buffer-field( v-field-name )
     1056             v-new-value = fh-new:buffer-value()
     1057           .
     1058         end.
     1059         else do:
     1060           assign
     1061             v-new-value = "":U
     1062           .
     1063         end.
     1064         if v-old-value <> v-new-value
     1065         then do:
     1066           create temp-changes.
     1067           assign
     1068             temp-changes.t_name = p-main-table
     1069             temp-changes.f_name = v-field-name
     1070             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1071             temp-changes.v_old  = trim( v-old-value )
     1072             temp-changes.v_new  = trim( v-new-value )
     1073             temp-changes.num_   = 0
     1074             temp-changes.fNotChange = v-old-value eq v-new-value
     1075           .
     1076         end.
     1077       end.
     1078     end.
     1079     assign
     1080       v-num-entries = num-entries( p-label-form, chr(8) )
     1081     .
     1082     do v-ind = 1 to v-num-entries
     1083     on error undo, return error return-value
     1084     :
     1085       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1086         assign
     1087           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1088           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1089           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1090         .
     1091         find first temp-changes
     1092           where temp-changes.f_name = v-field-name
     1093           no-error .
     1094         if available temp-changes then do:
     1095           if trim( v-field-lvl ) <> "":U then do:
     1096             assign
     1097               temp-changes.l_name = v-field-lvl
     1098             .
     1099           end.
     1100           if trim( v-field-form ) <> "":U then do:
     1101             assign
     1102               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1103             .
     1104             if h-for-comp <> ? then do:
     1105               assign
     1106                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1107               .
     1108             end.
     1109           end.
     1110         end.
     1111       end.
     1112       else do:
     1113         message
     1114           vss-workfile vss-revision vss-description skip
     1115           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1116           substitute( "список для поля '&1': '&2'"
     1117                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1118                       ,entry( v-ind, p-label-form, chr(8) )
     1119                     ) skip
     1120           substitute( "полный список: &2", p-label-form ) skip
     1121           view-as alert-box error .
     1122       end.
     1123     end.
     1124     delete object h-new-buf .
     1125     delete object h-main-buf .
     1126   END PROCEDURE.
     1127   FUNCTION mark-string RETURNS CHARACTER
     1128     ( BUFFER loc-c-assortment-matrix-goods FOR c-assortment-matrix-goods, input mark-list as character )  FORWARD.
     1129   DEFINE BUTTON B-Help
     1130        LABEL "Помо&щь"
     1131        SIZE 10 BY 1
     1132        BGCOLOR 8 .
     1133   DEFINE BUTTON B-lookup
     1134        LABEL "&Просмотр"
     1135        SIZE 1 BY 1.
     1136   DEFINE BUTTON B-mark
     1137        LABEL "&Просмотр"
     1138        SIZE 1 BY 1.
     1139   DEFINE BUTTON b-quit AUTO-END-KEY
     1140        LABEL "&Выход"
     1141        SIZE 10 BY 1
     1142        BGCOLOR 8 .
     1143   DEFINE BUTTON B-sel
     1144        LABEL "&Просмотр"
     1145        SIZE 1 BY 1.
     1146   DEFINE QUERY BR-changes FOR
     1147         temp-changes SCROLLING.
     1148   DEFINE QUERY br-condkeep FOR
     1149         x_c-assortment-matrix-goods SCROLLING.
     1150   DEFINE BROWSE BR-changes
     1151     QUERY BR-changes DISPLAY
     1152         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(15)"
     1153   temp-changes.v_old COLUMn-LABEL "Было" format "X(40)"
     1154   temp-changes.v_new COLUMn-LABEL "Стало" format "X(40)"
     1155       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.54.
     1156   DEFINE BROWSE br-condkeep
     1157     QUERY br-condkeep NO-LOCK DISPLAY
     1158         x_c-assortment-matrix-goods.gds-code
     1159         x_c-assortment-matrix-goods.asmg-date-update COLUMN-LABEL "Дата посл.!изменения" FORMAT "99/99/99":U
     1160               WIDTH 11
     1161         string(x_c-assortment-matrix-goods.asmg-time-update, "HH:MM") COLUMN-LABEL "Время!измен" FORMAT "X(5)":U
     1162         x_c-assortment-matrix-goods.asmg-db-num-update COLUMN-LABEL "БД!изм" FORMAT ">>>>9":U
     1163               WIDTH 3
     1164         x_c-assortment-matrix-goods.asmg-who-update COLUMN-LABEL "Кто!изменил" FORMAT "X(8)":U
     1165         x_c-assortment-matrix-goods.casg-date-his COLUMN-LABEL "Создание!истории" FORMAT "99/99/99":U
     1166               WIDTH 11
     1167         string(x_c-assortment-matrix-goods.casg-time-his, "HH:MM") COLUMN-LABEL "Время!созд" FORMAT "x(5)":U
     1168         x_c-assortment-matrix-goods.corr-user-db-num COLUMN-LABEL "БД!соз" FORMAT ">>>>9":U
     1169               WIDTH 3
     1170         x_c-assortment-matrix-goods.corr-user-name COLUMN-LABEL "Кто!создал" FORMAT "X(8)":U
     1171               WIDTH 29.75
     1172       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 10 ROW-HEIGHT-CHARS .75 EXPANDABLE.
     1173   DEFINE FRAME Dialog-Frame
     1174        b-quit AT ROW 1 COL 1
     1175        B-lookup AT ROW 1 COL 20.5
     1176        B-sel AT ROW 1 COL 21.5
     1177        B-mark AT ROW 1 COL 22.5
     1178        B-Help AT ROW 1 COL 89
     1179        br-condkeep AT ROW 2.25 COL 1
     1180        BR-changes AT ROW 12.5 COL 1
     1181        SPACE(0.12) SKIP(0.00)
     1182       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1183            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1184            TITLE "История товара в ассортиментной матрице"
     1185            CANCEL-BUTTON b-quit.
     1186   ASSIGN
     1187          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1188          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1189   ASSIGN
     1190          B-lookup:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1191   ASSIGN
     1192          B-mark:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1193   ASSIGN
     1194          B-sel:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1195   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1196   DO:
     1197     APPLY "END-ERROR":U TO SELF.
     1198   END.
     1199   ON RETURN OF br-condkeep IN FRAME Dialog-Frame
     1200   or MOUSE-SELECT-DBLCLICK OF br-condkeep IN FRAME Dialog-Frame
     1201       DO:
     1202       run proc-br-condkeep in this-procedure no-error.
     1203     if error-status:error then return no-apply.
     1204   END.
     1205   ON VALUE-CHANGED OF br-condkeep IN FRAME Dialog-Frame
     1206   DO:
     1207     run proc-view-changes in this-procedure no-error.
     1208   END.
     1209   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1210   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1211   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1212   on help of frame Dialog-Frame
     1213   do:
     1214     run gbl/app_help.p
     1215       (input this-procedure :file-name
     1216       ,input ''
     1217       ,input ?
     1218       ) no-error.
     1219     if error-status :error then do:
     1220       message
     1221         "Ошибка при вызове помощи"
     1222         error-status :get-message(1)
     1223         view-as alert-box .
     1224     end.
     1225   end.
     1226   run minbtn-set in this-procedure .
     1227   on choose of b-help in frame Dialog-Frame
     1228   do:
     1229     apply "help":u to frame Dialog-Frame .
     1230   end.
     1231   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1232   procedure minbtn-set :
     1233       do
     1234           on error undo, return error return-value
     1235           :
     1236           define variable ii              as integer       no-undo .
     1237           define variable fh              as widget-handle no-undo .
     1238           define variable hh              as widget-handle no-undo .
     1239           define variable v-h             as handle        extent 4 no-undo .
     1240           define variable v-name-button   as character     no-undo .
     1241           define variable v-help-old-x    as decimal       no-undo .
     1242           define variable v-help-old-y    as decimal       no-undo .
     1243           define variable v-help-old-size as decimal       no-undo .
     1244           define variable v-frame-width   as decimal       no-undo .
     1245           define variable jj              as integer       no-undo .
     1246           do
     1247               on error undo, return error
     1248               :
     1249               assign
     1250                   v-frame-width = frame Dialog-Frame:width - 0.3
     1251                   fh            = frame Dialog-Frame:first-child
     1252                   hh            = fh:first-child
     1253                   ii            = 1
     1254                   .
     1255               do while valid-handle(hh):
     1256                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1257                   do:
     1258                       case lc(hh:name) :
     1259                           when "b-help" then
     1260                               do:
     1261                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1262                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1263                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1264                                   hh:TOOLTIP = "Помощь" .
     1265                                   v-help-old-x = hh:column .
     1266                                   v-help-old-y = hh:row    .
     1267                                   v-help-old-size = hh:width .
     1268                                   hh:width-chars = 2.5 .
     1269                               end.
     1270                           when "b-print" then
     1271                               do:
     1272                                   hh:load-image("cmp/b-print.bmp":u) .
     1273                                   hh:TOOLTIP = "Печать" .
     1274                                   v-h[ii] = hh:handle .
     1275                                   ii = ii + 1 .
     1276                                   hh:width-chars = 3 .
     1277                               end.
     1278                           when "b-history" or
     1279                           when "b-hist" then
     1280                               do:
     1281                                   hh:load-image("cmp/b-hist.bmp":u) .
     1282                                   hh:TOOLTIP = "История" .
     1283                                   v-h[ii] = hh:handle .
     1284                                   ii = ii + 1 .
     1285                                   hh:width-chars = 3 .
     1286                               end.
     1287                           when "b-sch" then
     1288                               do:
     1289                                   hh:load-image("cmp/b-sch.bmp":u) .
     1290                                   hh:TOOLTIP = "Установка Фильтра" .
     1291                                   v-h[ii] = hh:handle .
     1292                                   ii = ii + 1 .
     1293                                   hh:width-chars = 3 .
     1294                               end.
     1295                           when "b-hist-user" then
     1296                               do:
     1297                                   hh:load-image("cmp/b-hist.bmp":u) .
     1298                                   hh:TOOLTIP = "История пользователя" .
     1299                                   ii = ii + 1 .
     1300                               end.
     1301                       end case.
     1302                   end.
     1303                   hh = hh:next-sibling.
     1304               end.
     1305               b-help:column = v-frame-width - b-help:width-chars.
     1306               jj = 0.
     1307               repeat ii = 4 to 1 by -1 :
     1308                   if valid-handle (v-h[ii] ) then
     1309                   do:
     1310                       jj  = jj + 1 .
     1311                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1312                       v-h[ii]:row    = v-help-old-y .
     1313                   end.
     1314               end.
     1315           end.
     1316       end.
     1317   end procedure.
     1318   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1319   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1320   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1321   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1322   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1323   define variable v-diasize-current-frame-height as decimal   no-undo .
     1324   define variable v-diasize-change-size          as logical   no-undo .
     1325   define variable v-diasize-resize-button        as handle    no-undo .
     1326   define variable v-diasize-wndmax               as logical   no-undo .
     1327   define variable v-diasize-wndstore             as logical   no-undo .
     1328   define variable v-diasize-proc-name            as character no-undo .
     1329   define variable v-diasize-browse-handle        as handle    no-undo .
     1330   define variable v-diasize-browse-number        as integer   no-undo .
     1331   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1332   define temp-table temp-diasize-handle no-undo
     1333     field handle-value  as handle
     1334     field save-position as decimal
     1335     index xpk is primary unique handle-value
     1336     .
     1337   define temp-table temp-browse-handle no-undo
     1338     field browse-type   as character
     1339     field browse-number as integer
     1340     field browse-handle as handle
     1341     field original-size as decimal
     1342     index xpk is primary unique browse-type browse-number
     1343     index xie browse-type browse-handle
     1344   .
     1345   procedure diasize_change-height :
     1346     define input  parameter p-change-value  as decimal   no-undo .
     1347     define input  parameter p-move-resize   as logical   no-undo .
     1348     define variable v-field-group-handle    as handle    no-undo .
     1349     define variable v-object-handle         as handle    no-undo .
     1350     define variable v-frame-height          as decimal   no-undo .
     1351     define variable v-frame-virtual-height  as decimal   no-undo .
     1352     define variable v-browse-height         as decimal   no-undo .
     1353     define variable v-window-height         as decimal   no-undo .
     1354     define variable v-window-virtual-height as decimal   no-undo .
     1355     define variable v-change-sign           as integer   no-undo .
     1356     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1357     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1358     if p-change-value > 0
     1359     then do:
     1360       if frame Dialog-Frame :height + p-change-value
     1361           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1362       then do:
     1363         assign
     1364           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1365                           - (frame Dialog-Frame :height-chars)
     1366         .
     1367         if p-change-value <= 0
     1368         then do:
     1369           run diasize_position-resize-button in this-procedure .
     1370           return .
     1371         end.
     1372       end.
     1373     end.
     1374     if p-change-value < 0
     1375     then do:
     1376       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1377       then do:
     1378         assign
     1379           p-change-value = v-diasize-orig-frame-height
     1380                          - (frame Dialog-Frame :height-chars)
     1381         .
     1382         if p-change-value >= 0
     1383         then do:
     1384           run diasize_position-resize-button in this-procedure .
     1385           return .
     1386         end.
     1387       end.
     1388     end.
     1389     if p-change-value >= 0
     1390     then do:
     1391       assign
     1392         v-change-sign = 1
     1393       .
     1394     end.
     1395     else do:
     1396       assign
     1397         v-change-sign = -1
     1398       .
     1399     end.
     1400     assign
     1401       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1402     .
     1403     if p-change-value = 0
     1404     then do:
     1405       run diasize_position-resize-button in this-procedure .
     1406       return .
     1407     end.
     1408     move_block:
     1409     do
     1410     on error undo move_block, retry move_block
     1411     :
     1412       if retry
     1413       then do:
     1414         do
     1415         on error undo move_block, leave move_block
     1416         :
     1417           if p-change-value > 0
     1418           then do:
     1419             for each buf_temp-diasize-handle
     1420             on error undo, next
     1421             :
     1422               assign
     1423                 v-object-handle = buf_temp-diasize-handle.handle-value
     1424               .
     1425               if v-object-handle <> v-diasize-resize-button
     1426               then do:
     1427                 assign
     1428                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1429                 .
     1430               end.
     1431             end.
     1432             assign
     1433               v-diasize-browse-handle :height = v-browse-height
     1434             .
     1435             for each buf_temp-browse-handle
     1436               where buf_temp-browse-handle.browse-type = 'height':u
     1437             on error undo, next
     1438             :
     1439               assign
     1440                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1441               .
     1442             end.
     1443             assign
     1444               frame Dialog-Frame :height = v-frame-height
     1445             .
     1446             if frame Dialog-Frame :scrollable = true
     1447             then do:
     1448               assign
     1449                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1450               .
     1451             end.
     1452             run diasize_position-resize-button in this-procedure .
     1453           end.
     1454           else do:
     1455             if frame Dialog-Frame :scrollable = true
     1456             then do:
     1457               assign
     1458                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1459               .
     1460             end.
     1461             assign
     1462               frame Dialog-Frame :height = v-frame-height
     1463             .
     1464             assign
     1465               v-diasize-browse-handle :height = v-browse-height
     1466             .
     1467             for each buf_temp-browse-handle
     1468               where buf_temp-browse-handle.browse-type = 'height':u
     1469             on error undo, next
     1470             :
     1471               assign
     1472                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1473               .
     1474             end.
     1475             for each buf_temp-diasize-handle
     1476             on error undo, next
     1477             :
     1478               assign
     1479                 v-object-handle = buf_temp-diasize-handle.handle-value
     1480               .
     1481               if v-object-handle <> v-diasize-resize-button
     1482               then do:
     1483                 assign
     1484                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1485                 .
     1486               end.
     1487             end.
     1488             run diasize_position-resize-button in this-procedure .
     1489           end.
     1490           assign
     1491             v-diasize-change-size = false
     1492           .
     1493           leave move_block .
     1494         end.
     1495       end.
     1496       assign
     1497         v-diasize-need-full-display = true
     1498       .
     1499       if v-diasize-change-size = false
     1500       then do:
     1501         assign
     1502           v-diasize-change-size = true
     1503         .
     1504       end.
     1505       else do:
     1506         return .
     1507       end.
     1508       assign
     1509         v-frame-height = frame Dialog-Frame :height
     1510         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1511         v-browse-height = v-diasize-browse-handle :height
     1512       .
     1513       for each buf_temp-browse-handle
     1514         where buf_temp-browse-handle.browse-type = 'height':u
     1515       :
     1516         assign
     1517           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1518         .
     1519       end.
     1520       for each buf_temp-diasize-handle
     1521       :
     1522         delete buf_temp-diasize-handle .
     1523       end.
     1524       assign
     1525         v-field-group-handle = frame Dialog-Frame :first-child
     1526       .
     1527       do while valid-handle(v-field-group-handle)
     1528       :
     1529         assign
     1530           v-object-handle = v-field-group-handle :first-child
     1531         .
     1532         do while valid-handle(v-object-handle)
     1533         :
     1534           if  v-object-handle <> v-diasize-browse-handle :handle
     1535           and can-query(v-object-handle, "row")
     1536           and can-query(v-object-handle, "height")
     1537           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1538           then do:
     1539             find first buf_temp-browse-handle
     1540               where buf_temp-browse-handle.browse-type   = 'height':u
     1541                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1542               no-error .
     1543             if available buf_temp-browse-handle
     1544             then do:
     1545             end.
     1546             else do:
     1547               create buf_temp-diasize-handle .
     1548               assign
     1549                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1550                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1551               .
     1552             end.
     1553           end.
     1554           assign
     1555             v-object-handle = v-object-handle :next-sibling
     1556           .
     1557         end.
     1558         assign
     1559           v-field-group-handle = v-field-group-handle :next-sibling
     1560         .
     1561       end.
     1562       do with frame Dialog-Frame
     1563       :
     1564         hide v-diasize-resize-button .
     1565         assign
     1566           v-diasize-resize-button :row    = 1
     1567           v-diasize-resize-button :column = 1
     1568         .
     1569       end.
     1570       if p-change-value > 0
     1571       then do:
     1572         if frame Dialog-Frame :scrollable = true
     1573         then do:
     1574           assign
     1575             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1576             no-error .
     1577           if error-status :error
     1578           or error-status :get-message(1) <> ""
     1579           then do:
     1580             undo move_block, retry move_block .
     1581           end.
     1582         end.
     1583         assign
     1584           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1585           no-error .
     1586         if error-status :error
     1587         or error-status :get-message(1) <> ""
     1588         then do:
     1589           undo move_block, retry move_block .
     1590         end.
     1591         assign
     1592           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1593           no-error .
     1594         if error-status :error
     1595         or error-status :get-message(1) <> ""
     1596         then do:
     1597           undo move_block, retry move_block .
     1598         end.
     1599         for each buf_temp-browse-handle
     1600           where buf_temp-browse-handle.browse-type = 'height':u
     1601         on error undo move_block, retry move_block
     1602         :
     1603           assign
     1604             buf_temp-browse-handle.browse-handle :height
     1605               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1606             no-error .
     1607           if error-status :error
     1608           or error-status :get-message(1) <> ""
     1609           then do:
     1610             undo move_block, retry move_block .
     1611           end.
     1612         end.
     1613         for each buf_temp-diasize-handle
     1614         on error undo move_block, retry move_block
     1615         :
     1616           assign
     1617             v-object-handle = buf_temp-diasize-handle.handle-value
     1618           .
     1619           if v-object-handle <> v-diasize-resize-button
     1620           then do:
     1621             assign
     1622               v-object-handle :row = v-object-handle :row + p-change-value
     1623               no-error .
     1624             if error-status :error
     1625             or error-status :get-message(1) <> ""
     1626             then do:
     1627               undo move_block, retry move_block .
     1628             end.
     1629           end.
     1630         end.
     1631       end.
     1632       else do:
     1633         for each buf_temp-diasize-handle
     1634         on error undo move_block, retry move_block
     1635         :
     1636           assign
     1637             v-object-handle = buf_temp-diasize-handle.handle-value
     1638           .
     1639           if v-object-handle <> v-diasize-resize-button
     1640           then do:
     1641             assign
     1642               v-object-handle :row = v-object-handle :row + p-change-value
     1643               no-error .
     1644             if error-status :error
     1645             or error-status :get-message(1) <> ""
     1646             then do:
     1647               undo move_block, retry move_block .
     1648             end.
     1649           end.
     1650         end.
     1651         assign
     1652           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1653           no-error .
     1654         if error-status :error
     1655         or error-status :get-message(1) <> ""
     1656         then do:
     1657           undo move_block, retry move_block .
     1658         end.
     1659         for each buf_temp-browse-handle
     1660           where buf_temp-browse-handle.browse-type = 'height':u
     1661         on error undo move_block, retry move_block
     1662         :
     1663           assign
     1664             buf_temp-browse-handle.browse-handle :height
     1665               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1666             no-error .
     1667           if error-status :error
     1668           or error-status :get-message(1) <> ""
     1669           then do:
     1670             undo move_block, retry move_block .
     1671           end.
     1672         end.
     1673         assign
     1674           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1675           no-error .
     1676         if error-status :error
     1677         or error-status :get-message(1) <> ""
     1678         then do:
     1679           undo move_block, retry move_block .
     1680         end.
     1681         if frame Dialog-Frame :scrollable = true
     1682         then do:
     1683           assign
     1684             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1685             no-error .
     1686           if error-status :error
     1687           or error-status :get-message(1) <> ""
     1688           then do:
     1689             undo move_block, retry move_block .
     1690           end.
     1691         end.
     1692       end.
     1693       if p-move-resize = true
     1694       then do:
     1695         run diasize_position-resize-button in this-procedure .
     1696       end.
     1697       if v-diasize-wndstore = true
     1698       then do:
     1699         if connected("ub") = true
     1700         then do:
     1701           define variable v-cntxt-db-num        as integer   no-undo .
     1702           define variable v-cntxt-userid        as character no-undo .
     1703           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1704                                             , OUTPUT v-cntxt-userid
     1705                                             ) .
     1706           run gbl/wndsizew.p
     1707             (input  v-cntxt-db-num
     1708             ,input  v-cntxt-userid
     1709             ,input  v-diasize-proc-name
     1710             ,input  'height':u
     1711             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1712             ) .
     1713         end.
     1714       end.
     1715     end.
     1716     assign
     1717       v-diasize-change-size = false
     1718     .
     1719   end procedure.
     1720   procedure diasize_set-height :
     1721     define input  parameter p-new-height  as decimal   no-undo .
     1722     define input  parameter p-move-resize as logical   no-undo .
     1723     do
     1724     on error undo, return error return-value
     1725     :
     1726       run diasize_change-height in this-procedure
     1727         (input  (p-new-height - frame Dialog-Frame :height)
     1728         ,input  p-move-resize
     1729         ) .
     1730     end.
     1731   end procedure.
     1732   procedure diasize_change-width :
     1733     define input  parameter p-change-value as decimal   no-undo .
     1734     define input  parameter p-move-resize  as logical   no-undo .
     1735     define variable v-field-group-handle   as handle    no-undo .
     1736     define variable v-object-handle        as handle    no-undo .
     1737     define variable v-frame-width          as decimal   no-undo .
     1738     define variable v-frame-virtual-width  as decimal   no-undo .
     1739     define variable v-browse-width         as decimal   no-undo .
     1740     define variable v-window-width         as decimal   no-undo .
     1741     define variable v-window-virtual-width as decimal   no-undo .
     1742     define variable v-change-sign          as integer   no-undo .
     1743     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1744     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1745     if p-change-value > 0
     1746     then do:
     1747       if frame Dialog-Frame :width + p-change-value >
     1748           session :width-chars
     1749       then do:
     1750         assign
     1751           p-change-value = session :width-chars - frame Dialog-Frame :width
     1752         .
     1753         if p-change-value <= 0
     1754         then do:
     1755           run diasize_position-resize-button in this-procedure .
     1756           return .
     1757         end.
     1758       end.
     1759     end.
     1760     if p-change-value < 0
     1761     then do:
     1762       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1763       then do:
     1764         assign
     1765           p-change-value = v-diasize-orig-frame-width
     1766                          - frame Dialog-Frame :width
     1767         .
     1768         if p-change-value >= 0
     1769         then do:
     1770           run diasize_position-resize-button in this-procedure .
     1771           return .
     1772         end.
     1773       end.
     1774     end.
     1775     if p-change-value >= 0
     1776     then do:
     1777       assign
     1778         v-change-sign = 1
     1779       .
     1780     end.
     1781     else do:
     1782       assign
     1783         v-change-sign = -1
     1784       .
     1785     end.
     1786     assign
     1787       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1788     .
     1789     if p-change-value = 0
     1790     then do:
     1791       run diasize_position-resize-button in this-procedure .
     1792       return .
     1793     end.
     1794     move_block:
     1795     do
     1796     on error undo move_block, leave move_block
     1797     :
     1798       if retry
     1799       then do:
     1800         do
     1801         on error undo move_block, leave move_block
     1802         :
     1803           if p-change-value > 0
     1804           then do:
     1805             for each buf_temp-diasize-handle
     1806             on error undo, next
     1807             :
     1808               assign
     1809                 v-object-handle = buf_temp-diasize-handle.handle-value
     1810               .
     1811               if v-object-handle <> v-diasize-resize-button
     1812               then do:
     1813                 assign
     1814                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1815                 .
     1816               end.
     1817             end.
     1818             assign
     1819               v-diasize-browse-handle :width = v-browse-width
     1820             .
     1821             for each buf_temp-browse-handle
     1822               where buf_temp-browse-handle.browse-type = 'width':u
     1823             on error undo, next
     1824             :
     1825               assign
     1826                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1827               .
     1828             end.
     1829             assign
     1830               frame Dialog-Frame :width = v-frame-width
     1831             .
     1832             if frame Dialog-Frame :scrollable = true
     1833             then do:
     1834               assign
     1835                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1836               .
     1837             end.
     1838             run diasize_position-resize-button in this-procedure .
     1839           end.
     1840           else do:
     1841             if frame Dialog-Frame :scrollable = true
     1842             then do:
     1843               assign
     1844                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1845               .
     1846             end.
     1847             assign
     1848               frame Dialog-Frame :width = v-frame-width
     1849             .
     1850             for each buf_temp-browse-handle
     1851               where buf_temp-browse-handle.browse-type = 'width':u
     1852             on error undo, next
     1853             :
     1854               assign
     1855                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1856               .
     1857             end.
     1858             assign
     1859               v-diasize-browse-handle :width = v-browse-width
     1860             .
     1861             for each buf_temp-diasize-handle
     1862             on error undo, next
     1863             :
     1864               assign
     1865                 v-object-handle = buf_temp-diasize-handle.handle-value
     1866               .
     1867               if v-object-handle <> v-diasize-resize-button
     1868               then do:
     1869                 assign
     1870                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1871                 .
     1872               end.
     1873             end.
     1874             run diasize_position-resize-button in this-procedure .
     1875           end.
     1876           assign
     1877             v-diasize-change-size = false
     1878           .
     1879           leave move_block .
     1880         end.
     1881       end.
     1882       assign
     1883         v-diasize-need-full-display = true
     1884       .
     1885       if v-diasize-change-size = false
     1886       then do:
     1887         assign
     1888           v-diasize-change-size = true
     1889         .
     1890       end.
     1891       else do:
     1892         return .
     1893       end.
     1894       assign
     1895         v-frame-width = frame Dialog-Frame :width
     1896         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1897         v-browse-width = v-diasize-browse-handle :width
     1898       .
     1899       for each buf_temp-browse-handle
     1900         where buf_temp-browse-handle.browse-type = 'width':u
     1901       :
     1902         assign
     1903           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1904         .
     1905       end.
     1906       for each buf_temp-diasize-handle
     1907       :
     1908         delete buf_temp-diasize-handle .
     1909       end.
     1910       assign
     1911         v-field-group-handle = frame Dialog-Frame :first-child
     1912       .
     1913       do while valid-handle(v-field-group-handle)
     1914       :
     1915         assign
     1916           v-object-handle = v-field-group-handle :first-child
     1917         .
     1918         do while valid-handle(v-object-handle)
     1919         :
     1920           if  v-object-handle <> v-diasize-browse-handle :handle
     1921           and v-object-handle <> v-diasize-resize-button
     1922           and can-query(v-object-handle, "row")
     1923           and can-query(v-object-handle, "height")
     1924           and ( v-object-handle :col + v-object-handle :width
     1925                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1926               )
     1927           then do:
     1928             find first buf_temp-browse-handle
     1929               where buf_temp-browse-handle.browse-type   = 'width':u
     1930                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1931               no-error .
     1932             if available buf_temp-browse-handle
     1933             then do:
     1934             end.
     1935             else do:
     1936               create buf_temp-diasize-handle .
     1937               assign
     1938                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1939                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1940               .
     1941             end.
     1942           end.
     1943           assign
     1944             v-object-handle = v-object-handle :next-sibling
     1945           .
     1946         end.
     1947         assign
     1948           v-field-group-handle = v-field-group-handle :next-sibling
     1949         .
     1950       end.
     1951       do with frame Dialog-Frame
     1952       :
     1953         hide v-diasize-resize-button .
     1954         v-diasize-resize-button :row = 1.
     1955         v-diasize-resize-button :column = 1.
     1956       end.
     1957       if p-change-value > 0
     1958       then do:
     1959         if frame Dialog-Frame :scrollable = true
     1960         then do:
     1961           assign
     1962             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1963             no-error .
     1964           if error-status :error
     1965           or error-status :get-message(1) <> ""
     1966           then do:
     1967             undo move_block, retry move_block.
     1968           end.
     1969         end.
     1970         assign
     1971           frame Dialog-Frame :width = v-frame-width + p-change-value
     1972           no-error .
     1973         if error-status :error
     1974         or error-status :get-message(1) <> ""
     1975         then do:
     1976           undo move_block, retry move_block.
     1977         end.
     1978         assign
     1979           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1980         no-error .
     1981         if error-status :error
     1982         or error-status :get-message(1) <> ""
     1983         then do:
     1984           undo move_block, retry move_block.
     1985         end.
     1986         for each buf_temp-browse-handle
     1987           where buf_temp-browse-handle.browse-type = 'width':u
     1988         on error undo move_block, retry move_block
     1989         :
     1990           assign
     1991             buf_temp-browse-handle.browse-handle :width
     1992               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1993             no-error .
     1994           if error-status :error
     1995           or error-status :get-message(1) <> ""
     1996           then do:
     1997             undo move_block, retry move_block .
     1998           end.
     1999         end.
     2000         for each buf_temp-diasize-handle
     2001         on error undo move_block, retry move_block
     2002         :
     2003           assign
     2004             v-object-handle = buf_temp-diasize-handle.handle-value
     2005           .
     2006           if v-object-handle <> v-diasize-resize-button
     2007           then do:
     2008             assign
     2009               v-object-handle :col = v-object-handle :col + p-change-value
     2010               no-error .
     2011             if error-status :error
     2012             or error-status :get-message(1) <> ""
     2013             then do:
     2014               undo move_block, retry move_block .
     2015             end.
     2016           end.
     2017         end.
     2018       end.
     2019       else do:
     2020         for each buf_temp-diasize-handle
     2021         on error undo move_block, retry move_block
     2022         :
     2023           assign
     2024             v-object-handle = buf_temp-diasize-handle.handle-value
     2025           .
     2026           if v-object-handle <> v-diasize-resize-button
     2027           then do:
     2028             assign
     2029               v-object-handle :col = v-object-handle :col + p-change-value
     2030               no-error .
     2031             if error-status :error
     2032             or error-status :get-message(1) <> ""
     2033             then do:
     2034               undo move_block, retry move_block .
     2035             end.
     2036           end.
     2037         end.
     2038         for each buf_temp-browse-handle
     2039           where buf_temp-browse-handle.browse-type = 'width':u
     2040         on error undo move_block, retry move_block
     2041         :
     2042           assign
     2043             buf_temp-browse-handle.browse-handle :width
     2044               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2045             no-error .
     2046           if error-status :error
     2047           or error-status :get-message(1) <> ""
     2048           then do:
     2049             undo move_block, retry move_block .
     2050           end.
     2051         end.
     2052         assign
     2053           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2054           no-error .
     2055         if error-status :error
     2056         or error-status :get-message(1) <> ""
     2057         then do:
     2058           undo move_block, retry move_block.
     2059         end.
     2060         assign
     2061           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2062         no-error .
     2063         if error-status :error
     2064         or error-status :get-message(1) <> ""
     2065         then do:
     2066           undo move_block, retry move_block.
     2067         end.
     2068         if frame Dialog-Frame :scrollable = true
     2069         then do:
     2070           assign
     2071             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2072           no-error .
     2073           if error-status :error
     2074           or error-status :get-message(1) <> ""
     2075           then do:
     2076             undo move_block, retry move_block.
     2077           end.
     2078         end.
     2079       end.
     2080       if p-move-resize
     2081       then do:
     2082         run diasize_position-resize-button in this-procedure .
     2083       end.
     2084       if v-diasize-wndstore = true
     2085       then do:
     2086         if connected("ub") = true
     2087         then do:
     2088           define variable v-cntxt-db-num        as integer   no-undo .
     2089           define variable v-cntxt-userid        as character no-undo .
     2090           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2091                                             , OUTPUT v-cntxt-userid
     2092                                             ) .
     2093           run gbl/wndsizew.p
     2094             (input  v-cntxt-db-num
     2095             ,input  v-cntxt-userid
     2096             ,input  v-diasize-proc-name
     2097             ,input  'width':u
     2098             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2099             ) .
     2100         end.
     2101       end.
     2102     end.
     2103     assign
     2104       v-diasize-change-size = false
     2105     .
     2106   end procedure.
     2107   procedure diasize_set-width :
     2108     define input  parameter p-new-width  as decimal   no-undo .
     2109     define input  parameter p-move-resize as logical   no-undo .
     2110     do
     2111     on error undo, return error return-value
     2112     :
     2113       run diasize_change-width in this-procedure
     2114         (input  (p-new-width - frame Dialog-Frame :width)
     2115         ,input  p-move-resize
     2116         ) .
     2117     end.
     2118   end procedure.
     2119   procedure diasize_position-resize-button :
     2120     do with frame Dialog-Frame
     2121     :
     2122       hide v-diasize-resize-button .
     2123       assign
     2124         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2125                     - 1
     2126                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2127         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2128                     - 1
     2129                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2130       .
     2131       view v-diasize-resize-button .
     2132     end.
     2133   end procedure.
     2134   on alt-right anywhere
     2135   do:
     2136     run diasize_change-width in this-procedure
     2137       (input 1
     2138       ,input true
     2139       ) .
     2140     return no-apply .
     2141   end.
     2142   on alt-left anywhere
     2143   do:
     2144     run diasize_change-width in this-procedure
     2145       (input -1
     2146       ,input true
     2147       ) .
     2148     return no-apply .
     2149   end.
     2150   on alt-down anywhere
     2151   do:
     2152     run diasize_change-height in this-procedure
     2153       (input 1
     2154       ,input true
     2155       ) .
     2156     return no-apply .
     2157   end.
     2158   on alt-up anywhere
     2159   do:
     2160     run diasize_change-height in this-procedure
     2161       (input -1
     2162       ,input true
     2163       ) .
     2164     return no-apply .
     2165   end.
     2166   on alt-enter of frame Dialog-Frame
     2167   do:
     2168     run diasize_maximize in this-procedure
     2169       (input  ?
     2170       ).
     2171     return no-apply .
     2172   end.
     2173   procedure diasize_end-move :
     2174     do
     2175     on error undo, return error return-value
     2176     :
     2177       define variable v-row-delta as decimal   no-undo .
     2178       define variable v-col-delta as decimal   no-undo .
     2179       define variable v-new-row as decimal   no-undo .
     2180       define variable v-new-col as decimal   no-undo .
     2181       assign
     2182         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2183         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2184       .
     2185       assign
     2186         v-row-delta = v-new-row - frame Dialog-Frame :height
     2187         v-col-delta = v-new-col - frame Dialog-Frame :width
     2188       .
     2189       run diasize_change-height in this-procedure
     2190         (input v-row-delta
     2191         ,input true
     2192         ) .
     2193       run diasize_change-width in this-procedure
     2194         (input v-col-delta
     2195         ,input true
     2196         ) .
     2197     end.
     2198   end procedure.
     2199   procedure diasize_maximize :
     2200     define input  parameter p-action as logical   no-undo .
     2201     do
     2202     on error undo, return error return-value
     2203     :
     2204       if p-action = ?
     2205       then do:
     2206         if v-diasize-need-maximize = true
     2207         then do:
     2208           assign
     2209             p-action = true
     2210           .
     2211         end.
     2212         else do:
     2213           assign
     2214             p-action = false
     2215           .
     2216         end.
     2217       end.
     2218       if p-action = true
     2219       then do:
     2220         run diasize_change-height in this-procedure
     2221           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2222               - frame Dialog-Frame :height-chars
     2223           ,input true
     2224           ) .
     2225         run diasize_change-width in this-procedure
     2226           (input session :width-chars
     2227               - frame Dialog-Frame :width-chars
     2228           ,input true
     2229           ) .
     2230         assign
     2231           v-diasize-need-maximize = false
     2232         .
     2233       end.
     2234       else do:
     2235         run diasize_change-width in this-procedure
     2236           (input v-diasize-orig-frame-width
     2237               - frame Dialog-Frame :width-chars
     2238           ,input true
     2239           ) .
     2240         run diasize_change-height in this-procedure
     2241           (input v-diasize-orig-frame-height
     2242               - frame Dialog-Frame :height-chars
     2243           ,input true
     2244           ) .
     2245         assign
     2246           v-diasize-need-maximize = true
     2247         .
     2248       end.
     2249     end.
     2250   end procedure.
     2251   procedure diasize_restore-orig-size :
     2252     do
     2253     on error undo, return error return-value
     2254     :
     2255       assign
     2256         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2257         v-diasize-current-frame-height = frame Dialog-Frame :height
     2258       .
     2259       run diasize_set-height in this-procedure
     2260         (input  v-diasize-orig-frame-height
     2261         ,input  true
     2262         ) .
     2263       run diasize_set-width in this-procedure
     2264         (input  v-diasize-orig-frame-width
     2265         ,input  true
     2266         ) .
     2267     end.
     2268   end procedure.
     2269   procedure diasize_restore-current-size :
     2270     do
     2271     on error undo, return error return-value
     2272     :
     2273       run diasize_set-height in this-procedure
     2274         (input  v-diasize-current-frame-height
     2275         ,input  true
     2276         ) .
     2277       run diasize_set-width in this-procedure
     2278         (input  v-diasize-current-frame-width
     2279         ,input  true
     2280         ) .
     2281     end.
     2282   end procedure.
     2283   procedure diasize_set-browse-handle :
     2284     define input  parameter p-browse-handle as handle   no-undo .
     2285     define buffer buf_temp-browse-handle for temp-browse-handle .
     2286     do
     2287     on error undo, return error return-value
     2288     :
     2289       assign
     2290         v-diasize-browse-handle = p-browse-handle
     2291       .
     2292       for each buf_temp-browse-handle
     2293       on error undo, return error return-value
     2294       :
     2295         delete buf_temp-browse-handle .
     2296       end.
     2297     end.
     2298   end procedure.
     2299   procedure diasize_add_browse :
     2300     define input  parameter p-browse-type   as character no-undo .
     2301     define input  parameter p-browse-handle as handle    no-undo .
     2302     define buffer buf_temp-browse-handle for temp-browse-handle .
     2303     do
     2304     on error undo, return error return-value
     2305     :
     2306       assign
     2307         v-diasize-browse-number = v-diasize-browse-number + 1
     2308       .
     2309       create buf_temp-browse-handle .
     2310       assign
     2311         buf_temp-browse-handle.browse-type   = p-browse-type
     2312         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2313         buf_temp-browse-handle.browse-handle = p-browse-handle
     2314       .
     2315     end.
     2316   end procedure.
     2317   procedure diasize_init :
     2318     define variable v-default-value    as logical   no-undo .
     2319     define variable v-restore-saved    as logical   no-undo .
     2320     define variable v-resize-value-str as character no-undo .
     2321     do
     2322     on error undo, return error return-value
     2323     :
     2324       do with frame Dialog-Frame
     2325       :
     2326         assign
     2327           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2328           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2329           v-diasize-browse-handle     = browse BR-changes :handle
     2330         .
     2331         create button v-diasize-resize-button
     2332         assign
     2333           parent        = frame Dialog-Frame :first-child
     2334           label         = "s"
     2335           height-pixels = 16
     2336           width-pixels  = 16
     2337           visible       = true
     2338           sensitive     = true
     2339           movable       = true
     2340           triggers:
     2341             on end-move persistent run diasize_end-move in this-procedure .
     2342           end triggers.
     2343         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2344         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2345         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2346         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2347         assign
     2348           v-diasize-wndmax = false
     2349         .
     2350         if connected("ub") = true
     2351         then do:
     2352           define variable v-cntxt-db-num        as integer   no-undo .
     2353           define variable v-cntxt-userid        as character no-undo .
     2354           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2355                                             , OUTPUT v-cntxt-userid
     2356                                             ) .
     2357           run gbl/wndpar_r.p
     2358             (input  v-cntxt-db-num
     2359             ,input  v-cntxt-userid
     2360             ,input  'wndmax':U
     2361             ,output v-diasize-wndmax
     2362             ,output v-default-value
     2363             ) .
     2364         end.
     2365         assign
     2366           v-diasize-wndstore = false
     2367         .
     2368         if connected("ub") = true
     2369         then do:
     2370           run gbl/wndpar_r.p
     2371             (input  v-cntxt-db-num
     2372             ,input  v-cntxt-userid
     2373             ,input  'wndstore':U
     2374             ,output v-diasize-wndstore
     2375             ,output v-default-value
     2376             ) .
     2377         end.
     2378         assign
     2379           v-diasize-proc-name = entry(1, program-name(2), '.')
     2380         .
     2381         if v-diasize-wndstore = true
     2382         then do:
     2383           assign
     2384             v-restore-saved = false
     2385           .
     2386           if connected("ub") = true
     2387           then do:
     2388             run gbl/wndsizer.p
     2389               (input  v-cntxt-db-num
     2390               ,input  v-cntxt-userid
     2391               ,input  v-diasize-proc-name
     2392               ,input  'height':u
     2393               ,output v-resize-value-str
     2394               ) .
     2395             if v-resize-value-str <> '':U
     2396             then do:
     2397               run diasize_change-height in this-procedure
     2398                 (input  integer(v-resize-value-str)
     2399                 ,input  true
     2400                 ) .
     2401               assign
     2402                 v-restore-saved = true
     2403               .
     2404             end.
     2405           end.
     2406           if connected("ub") = true
     2407           then do:
     2408             run gbl/wndsizer.p
     2409               (input  v-cntxt-db-num
     2410               ,input  v-cntxt-userid
     2411               ,input  v-diasize-proc-name
     2412               ,input  'width':u
     2413               ,output v-resize-value-str
     2414               ) .
     2415             if v-resize-value-str <> '':U
     2416             then do:
     2417               run diasize_change-width in this-procedure
     2418                 (input  integer(v-resize-value-str)
     2419                 ,input  true
     2420                 ) .
     2421               assign
     2422                 v-restore-saved = true
     2423               .
     2424             end.
     2425           end.
     2426           if v-restore-saved <> true
     2427           then do:
     2428             if v-diasize-wndmax = true
     2429             then do:
     2430               run diasize_maximize in this-procedure
     2431                 (input  true
     2432                 ) .
     2433             end.
     2434           end.
     2435         end.
     2436         else do:
     2437           if v-diasize-wndmax = true
     2438           then do:
     2439             run diasize_maximize in this-procedure
     2440               (input  true
     2441               ) .
     2442           end.
     2443         end.
     2444       end.
     2445     end.
     2446   end procedure.
     2447   procedure diasize_need-full-display :
     2448     define output parameter p-need-full-display as logical   no-undo .
     2449     do
     2450     on error undo, return error return-value
     2451     :
     2452       assign
     2453         p-need-full-display = v-diasize-need-full-display
     2454       .
     2455       assign
     2456         v-diasize-need-full-display = false
     2457       .
     2458     end.
     2459   end procedure.
     2460   procedure get-context :
     2461      define output parameter p-db-num as integer          no-undo.
     2462      define output parameter p-user-id as character        no-undo.
     2463      define variable v-login               as character    no-undo.
     2464      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2465      define buffer buf_user-login  for ub.user-login .
     2466      do
     2467      on error undo, return error
     2468      :
     2469            FIND FIRST buf_sys-ctrl no-lock.
     2470            ASSIGN
     2471               v-login = USERID("ub")
     2472               p-db-num = buf_sys-ctrl.db-num
     2473            .
     2474            FIND FIRST buf_user-login
     2475                 WHERE buf_user-login.db-num = p-db-num
     2476                   AND buf_user-login.user-login = v-login
     2477                 no-lock
     2478                 no-error
     2479                 .
     2480            IF AVAILABLE buf_user-login
     2481            THEN DO:
     2482               assign
     2483                  p-user-id = buf_user-login.user-id
     2484               .
     2485            END.
     2486      end.
     2487   end procedure.
     2488       run diasize_init in this-procedure .
     2489   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2490   do:
     2491     BR-changes :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2492   end.
     2493   MAIN-BLOCK:
     2494   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2495      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2496     find first X_assortment-matrix-goods no-lock where
     2497                X_assortment-matrix-goods.gds-code = p-gds-code and
     2498                X_assortment-matrix-goods.db-num = p-db-num and
     2499                X_assortment-matrix-goods.asmt-id = p-asmt-id
     2500                no-error.
     2501       if not available X_assortment-matrix-goods then do:
     2502           message
     2503           "Нет истории по товару asmt-id "  p-asmt-id skip p-db-num skip p-db-num
     2504            view-as alert-box ERROR.
     2505           return.
     2506       end.
     2507   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2508   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2509     (output v-db-num
     2510     )  .
     2511     run myenable in this-procedure .
     2512     run openbr in this-procedure .
     2513     if v-doc-rec <> ? then
     2514     reposition br-condkeep to recid v-doc-rec no-error.
     2515   wait-for go of frame Dialog-Frame.
     2516   end.
     2517   run disable_ui in this-procedure .
     2518   PROCEDURE disable_UI :
     2519     HIDE FRAME Dialog-Frame.
     2520   END PROCEDURE.
     2521   PROCEDURE enable_UI :
     2522     ENABLE b-quit B-Help br-condkeep BR-changes
     2523         WITH FRAME Dialog-Frame.
     2524     VIEW FRAME Dialog-Frame.
     2525     OPEN QUERY br-condkeep FOR EACH x_c-assortment-matrix-goods NO-LOCK INDEXED-REPOSITION.
     2526   END PROCEDURE.
     2527   PROCEDURE MyEnable :
     2528   ENABLE
     2529   b-quit
     2530   B-Help
     2531   br-condkeep
     2532   with FRAME Dialog-Frame.
     2533   VIEW FRAME Dialog-Frame.
     2534   END PROCEDURE.
     2535   PROCEDURE OpenBr :
     2536   OPEN QUERY br-condkeep FOR EACH X_c-assortment-matrix-goods NO-LOCK where
     2537                                   X_c-assortment-matrix-goods.asmt-id = p-asmt-id  and
     2538                                   X_c-assortment-matrix-goods.db-num = p-db-num    and
     2539                                   X_c-assortment-matrix-goods.gds-code = p-gds-code
     2540                                 INDEXED-REPOSITION.
     2541   APPLY "VALUE-CHANGED" TO br-condkeep in frame Dialog-Frame.
     2542   APPLY "ENTRY" TO br-condkeep.
     2543   END PROCEDURE.
     2544   PROCEDURE proc-br-condkeep :
     2545   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2546   if b-sel:sensitive in frame Dialog-Frame then dO:
     2547       if b-mark:sensitive then do:
     2548           apply "choose" to b-mark in frame Dialog-Frame.
     2549       end.
     2550       else do:
     2551           apply "choose" to b-sel in frame Dialog-Frame.
     2552       end.
     2553   end.
     2554   else do:
     2555       if b-lookup:sensitive then
     2556       apply "choose" to b-lookup in frame Dialog-Frame.
     2557   end.
     2558   END PROCEDURE.
     2559   PROCEDURE proc-view-changes :
     2560   define buffer new_c-assortment-matrix-goods for ub.c-assortment-matrix-goods.
     2561   define buffer current_assortment-matrix-goods for ub.assortment-matrix-goods.
     2562   define variable v-chg-fields as character no-undo.
     2563   define variable v-old-fields as character no-undo.
     2564   define variable v-new-fields as character no-undo.
     2565   define variable ii as integer no-undo.
     2566   for each temp-changes:
     2567       delete temp-changes.
     2568   END.
     2569   if not available X_c-assortment-matrix-goods then do:
     2570     Open QUery br-changes for each temp-changes.
     2571     return.
     2572   end.
     2573   find first new_c-assortment-matrix-goods no-lock where
     2574               new_c-assortment-matrix-goods.asmt-id = X_c-assortment-matrix-goods.asmt-id
     2575           and new_c-assortment-matrix-goods.db-num = X_c-assortment-matrix-goods.db-num
     2576           and new_c-assortment-matrix-goods.gds-code = X_c-assortment-matrix-goods.gds-code
     2577           AND new_c-assortment-matrix-goods.chip-num > X_c-assortment-matrix-goods.chip-num
     2578           AND new_c-assortment-matrix-goods.corr-user-db-num >= X_c-assortment-matrix-goods.corr-user-db-num
     2579       no-error.
     2580   if not available new_c-assortment-matrix-goods then do:
     2581       find first current_assortment-matrix-goods no-lock where
     2582                  current_assortment-matrix-goods.asmt-id = X_c-assortment-matrix-goods.asmt-id
     2583              and current_assortment-matrix-goods.db-num = X_c-assortment-matrix-goods.db-num
     2584              and current_assortment-matrix-goods.gds-code = X_c-assortment-matrix-goods.gds-code
     2585              no-error.
     2586       if not available current_assortment-matrix-goods then do:
     2587            return error.
     2588       end.
     2589       buffer-compare current_assortment-matrix-goods to X_c-assortment-matrix-goods
     2590       save result in v-chg-fields.
     2591   end.
     2592   else do:
     2593       buffer-compare new_c-assortment-matrix-goods except chip-num casg-date-his corr-user-db-num casg-time-his corr-user-name to X_c-assortment-matrix-goods
     2594       save result in v-chg-fields.
     2595   end.
     2596   define variable v-nn as integer   no-undo .
     2597   v-nn = num-entries(v-chg-fields).
     2598   do ii = 1 to v-nn:
     2599   CASE entry(ii, v-chg-fields):
     2600   when "asmg-date-update":U then do:     create temp-changes.     assign     temp-changes.f_name = "asmg-date-update":U     temp-changes.l_name = "Дата изменения"     temp-changes.v_old = string(X_c-assortment-matrix-goods.asmg-date-update)     temp-changes.v_new = (if available new_c-assortment-matrix-goods                               then string(new_c-assortment-matrix-goods.asmg-date-update)                               else string(current_assortment-matrix-goods.asmg-date-update))     .   end.
     2601   when "asmg-db-num-update":U then do:     create temp-changes.     assign     temp-changes.f_name = "asmg-db-num-update":U     temp-changes.l_name = "БД изм"     temp-changes.v_old = string(X_c-assortment-matrix-goods.asmg-db-num-update)     temp-changes.v_new = (if available new_c-assortment-matrix-goods                               then string(new_c-assortment-matrix-goods.asmg-db-num-update)                               else string(current_assortment-matrix-goods.asmg-db-num-update))     .   end.
     2602   when "asmg-time-update":U then do:     create temp-changes.     assign     temp-changes.f_name = "asmg-time-update":U     temp-changes.l_name = "Время изменения"     temp-changes.v_old = string(X_c-assortment-matrix-goods.asmg-time-update)     temp-changes.v_new = (if available new_c-assortment-matrix-goods                               then string(new_c-assortment-matrix-goods.asmg-time-update)                               else string(current_assortment-matrix-goods.asmg-time-update))     .   end.
     2603   when "asmg-who-update":U then do:     create temp-changes.     assign     temp-changes.f_name = "asmg-who-update":U     temp-changes.l_name = "Кто"     temp-changes.v_old = string(X_c-assortment-matrix-goods.asmg-who-update)     temp-changes.v_new = (if available new_c-assortment-matrix-goods                               then string(new_c-assortment-matrix-goods.asmg-who-update)                               else string(current_assortment-matrix-goods.asmg-who-update))     .   end.
     2604   when "gds-code":U then do:     create temp-changes.     assign     temp-changes.f_name = "gds-code":U     temp-changes.l_name = "Код товара"     temp-changes.v_old = string(X_c-assortment-matrix-goods.gds-code)     temp-changes.v_new = (if available new_c-assortment-matrix-goods                               then string(new_c-assortment-matrix-goods.gds-code)                               else string(current_assortment-matrix-goods.gds-code))     .   end.
     2605   when "asmg-status":U then do:     create temp-changes.     assign     temp-changes.f_name = "asmg-status":U     temp-changes.l_name = "Статус"     temp-changes.v_old = string(X_c-assortment-matrix-goods.asmg-status)     temp-changes.v_new = (if available new_c-assortment-matrix-goods                               then string(new_c-assortment-matrix-goods.asmg-status)                               else string(current_assortment-matrix-goods.asmg-status))     .   end.
     2606   when "asmg-des":U then do:     create temp-changes.     assign     temp-changes.f_name = "asmg-des":U     temp-changes.l_name = "Описание"     temp-changes.v_old = string(X_c-assortment-matrix-goods.asmg-des)     temp-changes.v_new = (if available new_c-assortment-matrix-goods                               then string(new_c-assortment-matrix-goods.asmg-des)                               else string(current_assortment-matrix-goods.asmg-des))     .   end.
     2607   END CASE.
     2608   end.
     2609   Open QUery br-changes for each temp-changes.
     2610   END PROCEDURE.
     2611   FUNCTION mark-string RETURNS CHARACTER
     2612     ( BUFFER loc-c-assortment-matrix-goods FOR c-assortment-matrix-goods, input mark-list as character ) :
     2613   RETURN ( IF LOOKUP( STRING( RECID( loc-c-assortment-matrix-goods ) ), mark-list ) > 0 THEN "*" ELSE "":U ).
     2614   END FUNCTION.
