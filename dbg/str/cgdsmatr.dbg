        1   DEFINE BUFFER x_c-assortment-matrix-goods FOR c-assortment-matrix-goods.
        2   DEFINE BUFFER X_curr_clients FOR clients.
        3   DEFINE BUFFER x_assortment-matrix-goods FOR assortment-matrix-goods.
        4   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        5   define input parameter p-asmt-id like ub.assortment-matrix-goods.asmt-id no-undo .
        6   define input parameter p-db-num   like ub.clients.db-num no-undo.
        7   define input parameter p-gds-code as integer   no-undo .
        8   define input-output param p-rid-list    as  char no-undo .
        9   define variable bttns  as char   no-undo .
       10   DEF VAR vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       11   DEF VAR vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       12   DEF VAR vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       13   DEF VAR vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       14   DEF VAR vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
