     3847           ( input parparentproc
     3848           ,input v-cntxt-host-code-obj
     3849           ,input v-cntxt-obj-type
     3850           ,input v-cntxt-obj-code
     3851           ).
     3852       if not can-find (first gds-list-flt ) then  do:
     3853           create gds-list-flt.
     3854           gds-list-flt.gds-code = 0 .
     3855           release gds-list-flt .
     3856           message "Расширенный фильтр пуст!" view-as alert-box information .
     3857           ASSIGN
     3858              r-2 = 1.
     3859           RETURN NO-APPLY.
     3860       end.
     3861       b-filter-ext:LOAD-IMAGE ("cmp/b-sche.bmp") .
     3862       find last gds-list-flt-hist.
