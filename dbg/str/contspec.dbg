     2965   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2966   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     2967   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     2968   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     2969   ASSIGN
     2970      v-S_CONTRACT                = "Contract":U
     2971      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     2972      v-DELIM_CHR_3               = ","
     2973      .
     2974   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     2975   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     2976   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     2977   FUNCTION Can-Find-Spec RETURN LOGICAL (
     2978      INPUT iHost-Code    AS INTEGER,
     2979      INPUT iContract-Num AS INTEGER,
     2980      INPUT iGds-Code     AS INTEGER ):
     2981      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     2982      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     2983      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     2984      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     2985      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     2986      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     2987          INPUT  iHost-Code,
     2988          INPUT  iContract-Num,
     2989          OUTPUT iTmp-Extent3
     2990          ).
     2991      IF iTmp-Extent3[1] = 2 THEN DO:
     2992         ASSIGN
     2993            iTmp-Host-Code      = iTmp-Extent3[2]
     2994            iTmp-Contract-Num   = iTmp-Extent3[3]
     2995            .
     2996      END. ELSE DO:
     2997         ASSIGN
     2998            iTmp-Host-Code      = iHost-Code
     2999            iTmp-Contract-Num   = iContract-Num
     3000            .
     3001      END.
     3002      IF iGds-Code = ? THEN DO:
     3003         ASSIGN
     3004            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     3005                                  buf_Spec.Host-Code     = iTmp-Host-Code
     3006                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     3007                           ).
     3008      END. ELSE DO:
     3009            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     3010                                  buf_Spec.Host-Code     = iTmp-Host-Code
     3011                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     3012                              AND buf_Spec.Gds-Code      = iGds-Code
     3013                            ).
     3014      END.
     3015      RETURN (lRet).
     3016   END FUNCTION.
     3017   PROCEDURE MS-Contract-EXTENT-3:
     3018      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     3019      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     3020      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     3021      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     3022      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     3023      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     3024      FIND FIRST buf_Cont-2 WHERE
     3025                 buf_Cont-2.Host-Code      = i-Host-Code
     3026             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     3027           NO-LOCK NO-ERROR.
     3028      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     3029         RETURN.
     3030      END.
     3031      FOR FIRST buf_Ext-Classif WHERE
     3032                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     3033           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     3034                                               STRING(i-Contract-code)
     3035           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     3036          NO-LOCK,
     3037          EACH buf_Cont WHERE
     3038               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     3039           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     3040          NO-LOCK:
     3041          ASSIGN
     3042             i-Ret[1] = 1
     3043             i-Ret[2] = buf_Cont.Host-code
     3044             i-Ret[3] = buf_Cont.Contract-code
     3045             .
     3046          LEAVE.
     3047      END.
     3048      IF i-Ret[1] <> 1 THEN DO:
     3049         FOR FIRST buf_Ext-Classif WHERE
     3050                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     3051              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     3052                                                  STRING(i-Contract-code)
     3053              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     3054             NO-LOCK,
     3055             EACH buf_Cont WHERE
     3056                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     3057              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     3058             NO-LOCK:
     3059             ASSIGN
     3060                i-Ret[1] = 2
     3061                i-Ret[2] = buf_Cont.Host-code
     3062                i-Ret[3] = buf_Cont.Contract-code
     3063                .
     3064             LEAVE.
     3065         END.
     3066      END.
     3067      RETURN.
     3068   END PROCEDURE.
     3069   DEFINE VARIABLE v-gl-Character   AS CHARACTER  NO-UNDO .
     3070   DEFINE VARIABLE v-gl-Date        AS DATE       NO-UNDO .
     3071   DEFINE VARIABLE v-gl-Decimal     AS DECIMAL    NO-UNDO .
     3072   DEFINE VARIABLE v-gl-iMcMode     AS INTEGER    NO-UNDO .
     3073   DEFINE VARIABLE v-gl-Logical     AS LOGICAL    NO-UNDO .
     3074   DEFINE VARIABLE v-gl-Param-Type  AS CHARACTER  NO-UNDO .
     3075   DEFINE VARIABLE v-gl-Error       AS CHARACTER  NO-UNDO  INITIAL "".
     3076   DEFINE VARIABLE iTmpHost-code        AS INTEGER INITIAL 0 NO-UNDO.
     3077   DEFINE VARIABLE iTmpContract-code    AS INTEGER INITIAL 0 NO-UNDO.
     3078   DEFINE VARIABLE i-Cont-Ret           AS INTEGER INITIAL 0 NO-UNDO EXTENT 3.
     3079   RUN adm/shattri.p (
     3080         INPUT  "get":U,
     3081         INPUT  "",
     3082         INPUT  0,
     3083         INPUT  "fin-global",
     3084         INPUT  "fo-mc-mode",
     3085         OUTPUT v-gl-Character,
     3086         OUTPUT v-gl-Date,
     3087         OUTPUT v-gl-Decimal,
     3088         OUTPUT v-gl-iMcMode,
     3089         OUTPUT v-gl-Logical,
     3090         OUTPUT v-gl-Param-Type,
     3091         INPUT-OUTPUT TABLE thbjattr_thbj-attr
     3092       ) NO-ERROR.
     3093   IF ERROR-STATUS:ERROR THEN DO:
     3094      ASSIGN
     3095         v-gl-Error = "Ошибка определения глобального параметра fin-global/fo-mc-mode".
     3096      MESSAGE
     3097         v-gl-Error SKIP
     3098         PROGRAM-NAME(1) ERROR-STATUS:GET-MESSAGE(1) RETURN-VALUE
     3099         VIEW-AS ALERT-BOX.
     3100   END.
     3101   IF (v-gl-iMcMode = 1 OR v-gl-iMcMode = 2) AND v-gl-Error = "" THEN DO:
     3102      ASSIGN
     3103         iTmpHost-code      = p-Host-Code
     3104         iTmpContract-code  = p-Doc-Num
     3105         .
     3106      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     3107          INPUT  p-Host-Code,
     3108          INPUT  p-Doc-Num,
     3109          OUTPUT i-Cont-Ret
     3110         ).
     3111      IF i-Cont-Ret[1] = 2 THEN DO:
     3112         ASSIGN
     3113            p-Host-Code       = i-Cont-Ret[2]
     3114            p-Doc-Num   = i-Cont-Ret[3]
     3115            .
     3116      END.
     3117   END.
