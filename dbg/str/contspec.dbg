     7110       )  .
     7111   end.
     7112   if not g-log then  return .
     7113   run str/diallog.w (
     7114         input parParentProc
     7115       , input this-procedure
     7116       , input ("utl/thbjrumr.w":U + chr(4)
     7117                                   + chr(4)
     7118                 + string(2)       + chr(4)
     7119               )
     7120       , input ('edoc':U + chr(4) +
     7121              'text-import_specif':U + chr(4) +
     7122              string(buf_contract.contract-code)
     7123              )
     7124       , input no
     7125       , input "&Стоп"
     7126       , input substitute("Импорт спецификации из текстового файла") ) no-error .
     7127   run proc-sum in this-procedure .
     7128   run openbr in this-procedure ( input yes, input no, input '':u).
     7129   END PROCEDURE.
     7130   PROCEDURE proc-print :
     7131   if session :set-wait-state( "compiler" ) then.
     7132   define variable Line as character no-undo .
     7133   assign
     7134     Line = fill("-", 299)
     7135      .
     7136   define variable sym1  as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     7137   define variable sym2  as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     7138   define variable sym3  as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     7139   define variable sym4  as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     7140   define variable sym5  as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     7141   define variable sym6  as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     7142   define variable sym7  as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     7143   define variable sym8  as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     7144   define variable sym9  as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     7145   define variable b-code as character no-undo .
     7146   define variable b-prod as character no-undo .
     7147   define variable b-name as character no-undo .
     7148   define variable b-bonus as character no-undo .
     7149   define variable b-ext as character no-undo .
     7150     DEFINE frame f-doc
     7151       sym1 b-code       COLUMN-LABEL 'Код'  Format "X(12)"                          space(0)
     7152       sym9 b-ext        COLUMN-LABEL 'Ед.!изм!пост' Format "X(12)"                          space(0)
     7153       sym2 b-name       COLUMN-LABEL 'Наименование'  format "x(30)"                          space(0)
     7154       sym3 buf_contract-specif.price-cli    COLUMN-LABEL 'Цена!поставщика'  format ">>>,>>>,>>9.99"                 space(0)
     7155       sym4 buf_contract-specif.prc    COLUMN-LABEL '% Отклон в!большую сторону'  Format "->>>9.99"                       space(0)
     7156       sym5 buf_contract-specif.artic    COLUMN-LABEL 'Артикул'  Format "x(16)"                          space(0)
     7157       sym6 b-prod       COLUMN-LABEL 'Произво-!дитель'  Format "x(12)"                          space(0)
     7158       sym7 b-bonus      COLUMN-LABEL 'Группа товара'                                         space(0)
     7159       sym8
     7160     HEADER
     7161           string( "Дата печати : " + string(TODAY , "99.99.9999") + " , " + string(TIME, "HH:MM") ) AT 5 format "X(90)"
     7162           string( "Страница " + string( PAGE-NUMBER( PrnLibStream )  , ">>9") ) AT 105 format "X(15)" SKIP
     7163           Line format "X(129)" AT 1
     7164     with width 136 down stream-io.
     7165     run prn-lib-open-stream  in this-procedure (input parParentProc,input 62,input yes,input no).
     7166     FORM HEADER
     7167         Line format "X(129)" AT 1 SKIP
     7168         "Продолжение - на следующей странице" AT 30 SKIP
     7169         with FRAME BottomFrame width 136 PAGE-BOTTOM NO-LABELS NO-BOX .
     7170     VIEW stream PrnLibStream FRAME BottomFrame .
     7171     FORM with FRAME f-doc .
     7172     PUT stream PrnLibStream  SPACE(30) string("Товарная спецификация к договору " + buf_contract.contract-prn-code + " от " + string(buf_contract.contract-date,"99/99/9999")) format "X(100)"  SKIP .
     7173     FOR EACH buf_contract-specif NO-LOCK where buf_contract-specif.host-code = p-host-code and buf_contract-specif.contract-num = p-doc-num :
     7174       assign
     7175         b-code = get-b-code(buf_contract-specif.gds-code)
     7176         b-name = get-gds-name (buf_contract-specif.gds-code)
     7177         b-ext = get-ext-artic ( recid(buf_contract-specif) )
     7178         b-prod = string( buf_contract-specif.prod-type + ' ' + string(buf_contract-specif.prod-code))
     7179       .
     7180       run read-bonus  in this-procedure (
     7181           input buf_contract-specif.contract-num ,
     7182           input buf_contract-specif.host-code    ,
     7183           input buf_contract-specif.gds-code     ,
     7184           output b-bonus
     7185           ) .
     7186       display stream PrnLibStream  sym1    b-code
     7187                                 sym9   b-ext
     7188                                 sym2   b-name
     7189                                 sym3    buf_contract-specif.price-cli
     7190                                 sym4    buf_contract-specif.prc
     7191                                 sym5    buf_contract-specif.artic
     7192                                 sym6    b-prod
     7193                                 sym7    b-bonus
     7194                                 sym8
     7195       with frame f-doc.
     7196       down stream PrnLibStream with frame f-doc .
     7197     end.
     7198     PUT STREAM PrnLibStream Line format "X(129)".
     7199     HIDE stream PrnLibStream FRAME BottomFrame .
     7200     OUTPUT stream PrnLibStream CLOSE.
     7201   if session :set-wait-state( "" ) then.
     7202     run prn-lib-prn-file in this-procedure (input parParentProc,input 0).
     7203   END PROCEDURE.
     7204   PROCEDURE proc-sum :
     7205   define buffer b_contract-specif for contract-specif .
     7206     assign
     7207       all-sum = 0
     7208       all-qnty = 0
     7209     .
     7210     for each b_contract-specif no-lock where
     7211             b_contract-specif.host-code = p-host-code
     7212         and b_contract-specif.contract-num = p-doc-num :
     7213       if b_contract-specif.sum-cli <> ? then   do:
     7214         assign
     7215         all-sum  = all-sum  + b_contract-specif.sum-cli .
     7216       end.
     7217       if b_contract-specif.qnty    <> ? then  do:
     7218         assign
     7219         all-qnty = all-qnty + b_contract-specif.qnty    .
     7220       end.
     7221     end.
     7222     DISPLAY
     7223     all-qnty
     7224     all-sum
     7225     WITH FRAME Dialog-Frame.
     7226   END PROCEDURE.
     7227   PROCEDURE proc-write :
     7228   do transaction :
     7229     run contrcth_write-hist in this-procedure ( input p-host-code
     7230                                                ,input p-doc-num).
     7231     find first buf_contract exclusive-lock where
     7232                 buf_contract.host-code = p-host-code
     7233             and buf_contract.contract-code = p-doc-num .
     7234   end.
     7235   END PROCEDURE.
     7236   FUNCTION f-bonus RETURNS DECIMAL
     7237     ( input par-recid as recid ) :
     7238     define buffer buf_contract-specif for ub.contract-specif  .
     7239     define variable v-bonus as decimal   no-undo .
     7240     find first buf_contract-specif no-lock where
     7241              recid(buf_contract-specif) = par-recid no-error .
     7242     if error-status :error then return 0.0 .
     7243     v-bonus = 0.0 .
     7244     run read-bonus in this-procedure
     7245     ( buf_contract-specif.contract-num,
     7246       buf_contract-specif.host-code ,
     7247       buf_contract-specif.gds-code ,
     7248       output v-bonus
     7249     ) no-error .
     7250     return v-bonus .
     7251   END FUNCTION.
     7252   FUNCTION f-prc-min RETURNS DECIMAL
     7253     ( input par-recid as recid ) :
     7254     define buffer buf_contract-specif for ub.contract-specif  .
     7255     define variable v-prc-min as decimal   no-undo .
     7256     find first buf_contract-specif no-lock where
     7257              recid(buf_contract-specif) = par-recid no-error .
     7258     if error-status :error then return 0.0 .
     7259     v-prc-min = 0.0 .
     7260     run read-prc-min in this-procedure
     7261     ( buf_contract-specif.contract-num,
     7262       buf_contract-specif.host-code ,
     7263       buf_contract-specif.gds-code ,
     7264       output v-prc-min
     7265     ) no-error .
     7266     return v-prc-min .
     7267   END FUNCTION.
     7268   FUNCTION get-b-code RETURNS CHARACTER
     7269     ( input gds-code as integer ) :
     7270     define variable ret    as character no-undo .
     7271     define variable b-code as integer   no-undo .
     7272     assign ret = "" .
     7273   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     7274     (input  gds-code
     7275     ,input  ?
     7276     ,output b-code
     7277     ) no-error .
     7278     if error-status :error then do:
     7279     end.
     7280     else assign ret = string(b-code) .
     7281     RETURN ret .
     7282   END FUNCTION.
     7283   FUNCTION get-ext-artic RETURNS CHARACTER
     7284     ( input p-recid as recid ) :
     7285     define variable ret    as character no-undo .
     7286     define buffer bf_contract-specif for ub.contract-specif  .
     7287     define buffer bf_contract        for ub.contract  .
     7288     define buffer bf_ext-artic        for ub.ext-artic  .
     7289     define buffer bf_goods for ub.goods  .
     7290     assign ret = "" .
     7291     find first bf_contract-specif no-lock  where recid(bf_contract-specif)  =  p-recid no-error .
     7292           if error-status :error then do:
     7293             message
     7294               vss-workfile vss-revision vss-description skip
     7295               error-status :get-message(1) skip
     7296               return-value skip
     7297               ""
     7298               view-as alert-box error
     7299             .
     7300           end.
     7301     find first bf_contract no-lock  where
     7302                bf_contract.host-code =  bf_contract-specif.host-code and
     7303                bf_contract.contract-code =  bf_contract-specif.contract-num
     7304                no-error .
     7305                 if error-status :error then do:
     7306                   message
     7307                     vss-workfile vss-revision vss-description skip
     7308                     error-status :get-message(1) skip
     7309                     return-value skip
     7310                     ""
     7311                     view-as alert-box error
     7312                   .
     7313                 end.
     7314      find first bf_ext-artic where bf_ext-artic.cli-type   = bf_contract.cli-type
     7315                                and bf_ext-artic.cli-code   = bf_contract.cli-code
     7316                                and bf_ext-artic.gds-code   = bf_contract-specif.gds-code
     7317                                and bf_ext-artic.status_    <> 'удал':U
     7318                                no-error .
     7319       if error-status :error then do:
     7320       ret = ''  .
     7321       end.
     7322      else do:
     7323       assign
     7324         ret = bf_ext-artic.ext-artic
     7325         .
     7326         if ret = ? then ret = "".
     7327      end.
     7328     RETURN ret .
     7329   END FUNCTION.
     7330   FUNCTION get-gds-name RETURNS CHARACTER
     7331     ( input p-gds-code as integer ) :
     7332     define variable ret    as character no-undo .
     7333     define buffer bf_goods for ub.goods  .
     7334     assign ret = "" .
     7335     find first bf_goods no-lock where
     7336               bf_goods.gds-code = p-gds-code no-error  .
     7337     if error-status :error then do:
     7338     end.
     7339     else assign ret = bf_goods.gds-name  .
     7340     RETURN ret .
     7341   END FUNCTION.
     7342   FUNCTION get-grp RETURNS CHARACTER
     7343     ( input gds-code as integer ) :
     7344     define buffer buf_goods for ub.goods.
     7345     find first buf_goods no-lock where buf_goods.gds-code = gds-code .
     7346     RETURN buf_goods.grp-name .
     7347   END FUNCTION.
     7348   FUNCTION mark-string RETURNS CHARACTER
     7349     ( input par-recid as recid ) :
     7350     define variable ret as character no-undo .
     7351     assign ret = "" .
     7352     find first temp-conn where temp-conn.ri = par-recid no-error .
     7353     if available temp-conn then assign ret = "*" .
     7354     RETURN ret .
     7355   END FUNCTION.
