     2306   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2307   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     2308   DEFINE VARIABLE vss-include-info25 AS CHARACTER FORMAT "x(65)" NO-UNDO INITIAL "@(#)$Workfile$ $Revision$".
     2309   FUNCTION indicator-life-gds-n RETURNS CHARACTER ( input p-rec as recid ) FORWARD.
     2310   DEFINE VARIABLE v-gl-iProc-Otkl AS DECIMAL NO-UNDO INITIAL 0.
     2311   DEFINE VARIABLE v-gl-lAM-Is-Obj         AS LOGICAL NO-UNDO INITIAL FALSE.
     2312   DEFINE VARIABLE v-gl-iAM-Gds-All        AS INTEGER NO-UNDO INITIAL 0.
     2313   DEFINE VARIABLE v-gl-iAM-Sbl-Gds-All    AS INTEGER NO-UNDO INITIAL 0.
     2314   DEFINE VARIABLE v-gl-iAM-Gds-Vyv        AS INTEGER NO-UNDO INITIAL 0.
     2315   DEFINE VARIABLE v-gl-lAM-Ref-Shablon    AS LOGICAL NO-UNDO INITIAL FALSE.
     2316   DEFINE VARIABLE v-gl-dAM-Proc-Otkl      AS DECIMAL NO-UNDO INITIAL 0.
     2317   DEFINE VARIABLE v-gl-dAM-Proc-Otkl-Ras  AS DECIMAL NO-UNDO INITIAL 0.
     2318   FUNCTION Is-Gds-In-AssMatr RETURN LOGICAL(
     2319      p-Gds-code AS INTEGER,
     2320      p-Asmt-id  AS INTEGER,
     2321      p-Db-num   AS INTEGER):
     2322      DEFINE BUFFER buf_Gds FOR Ub.Assortment-matrix-goods.
     2323      RETURN CAN-FIND(FIRST buf_Gds WHERE
     2324                            buf_Gds.Asmt-id     = p-Asmt-id
     2325                        AND buf_Gds.Db-num      = p-Db-num
     2326                        AND buf_Gds.Gds-code    = p-Gds-code
     2327                        AND buf_Gds.Asmg-status = INTEGER('0':U)
     2328                      NO-LOCK).
     2329   END FUNCTION.
     2330   PROCEDURE Get-Delta-Gds-2-Matrix:
     2331      DEFINE PARAMETER BUFFER buf_AM-1 FOR ub.Assortment-matrix.
     2332      DEFINE PARAMETER BUFFER buf_AM-2 FOR ub.Assortment-matrix.
     2333      DEFINE OUTPUT PARAMETER iDelta AS INTEGER NO-UNDO INITIAL 0.
     2334      DEFINE BUFFER buf_Gds-1 FOR ub.Assortment-matrix-goods.
     2335      DEFINE BUFFER buf_Gds-2 FOR ub.Assortment-matrix-goods.
     2336      FOR EACH buf_Gds-1 WHERE
     2337               buf_Gds-1.Asmt-id = buf_AM-1.Asmt-id
     2338           AND buf_Gds-1.Db-num  = buf_AM-1.Db-num
     2339           AND buf_Gds-1.Asmg-status = INTEGER('0':U)
     2340          NO-LOCK:
     2341          IF NOT CAN-FIND(FIRST buf_Gds-2 WHERE
     2342                                buf_Gds-2.Asmt-id     = buf_AM-2.Asmt-id
     2343                            AND buf_Gds-2.Db-num      = buf_AM-2.Db-num
     2344                            AND buf_Gds-2.Gds-code    = buf_Gds-1.Gds-code
     2345                            AND buf_Gds-2.Asmg-status = INTEGER('0':U)
     2346                            NO-LOCK) THEN DO:
     2347             ASSIGN
     2348                iDelta = iDelta + 1.
     2349          END.
     2350      END.
     2351      RETURN.
     2352   END PROCEDURE.
     2353   PROCEDURE Cntrl-AM-Add-1:
     2354      DEFINE INPUT PARAMETER iDelta  AS INTEGER   NO-UNDO.
     2355      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     2356      IF v-gl-iProc-Otkl = 0      THEN RETURN.
     2357      IF NOT v-gl-lAM-Is-Obj      THEN RETURN.
     2358      IF NOT v-gl-lAM-Ref-Shablon THEN RETURN.
     2359      RUN Calc-Proc-Otkl IN THIS-PROCEDURE(iDelta).
     2360      IF iDelta = 0 THEN DO:
     2361         IF v-gl-dAM-Proc-Otkl >= v-gl-iProc-Otkl THEN DO:
     2362            cError = "В данной матрице процент отклонения товаров от шаблона (=" + STRING(v-gl-dAM-Proc-Otkl) + ")" + chr(10) +
     2363                     " больше допустимого (=" + STRING( v-gl-iProc-Otkl) +  ")." + chr(10) +
     2364                     "Добавление товаров невозможно !".
     2365         END.
     2366      END. ELSE DO:
     2367         IF v-gl-dAM-Proc-Otkl-Ras >= v-gl-iProc-Otkl THEN DO:
     2368            cError = "В данной матрице будущий расчетный процент отклонения товаров от шаблона (=" + STRING(v-gl-dAM-Proc-Otkl-Ras) + ")" + chr(10) +
     2369                     " больше допустимого (=" + STRING( v-gl-iProc-Otkl ) +  ")." + chr(10) +
     2370                     " Добавление товаров невозможно !".
     2371         END.
     2372      END.
     2373      RETURN.
     2374   END PROCEDURE.
     2375   PROCEDURE Get-Gl-Param-Proc-Otkl:
     2376      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
     2377      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
     2378      DEFINE OUTPUT PARAMETER  cError    AS CHARACTER  NO-UNDO INITIAL "".
     2379      DEFINE BUFFER buf_AM   FOR ub.Assortment-Matrix.
     2380      FIND FIRST buf_AM WHERE
     2381                 buf_AM.asmt-id = p-Asmt-id
     2382             AND buf_AM.db-num  = p-Db-num
     2383           NO-LOCK NO-ERROR.
     2384      IF NOT AVAILABLE buf_AM THEN DO:
     2385         cError = PROGRAM-NAME(1) +  ":Не найдена АМ id=" + STRING(p-Asmt-id) + " db-num=" + STRING(p-Db-num).
     2386         RETURN.
     2387      END.
     2388      RUN Get-Gl-Set-Proc-Otkl IN THIS-PROCEDURE(
     2389          buf_AM.obj-type,
     2390          buf_AM.obj-code
     2391          ).
     2392      RUN Get-Gl-Param-AM-All in THIS-PROCEDURE(
     2393          buf_AM.Asmt-id,
     2394          buf_AM.db-num
     2395          ).
     2396      RETURN.
     2397   END PROCEDURE.
     2398   PROCEDURE Get-Gl-Param-AM-All:
     2399      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
     2400      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
     2401      DEFINE VARIABLE lIsAmObj    AS LOGICAL    NO-UNDO INITIAL FALSE.
     2402      DEFINE VARIABLE iSh-Asmt-id AS INTEGER    NO-UNDO INITIAL 0.
     2403      DEFINE VARIABLE iSh-Db-num  AS INTEGER    NO-UNDO INITIAL 0.
     2404      DEFINE VARIABLE cSh-Type    AS CHARACTER  NO-UNDO INITIAL "".
     2405      DEFINE VARIABLE cError      AS CHARACTER  NO-UNDO INITIAL "".
     2406      DEFINE VARIABLE dAmt        AS DECIMAL    EXTENT 2  NO-UNDO INITIAL 0.
     2407      DEFINE VARIABLE cMode       AS CHARACTER  NO-UNDO INITIAL "".
     2408      ASSIGN
     2409         v-gl-iAM-Gds-All     = 0
     2410         v-gl-iAM-Sbl-Gds-All = 0
     2411         v-gl-iAM-Gds-Vyv     = 0
     2412         v-gl-dAM-Proc-Otkl   = 0
     2413         v-gl-lAM-Ref-Shablon = FALSE
     2414         .
     2415      RUN Get-Param-AM IN THIS-PROCEDURE (
     2416          p-Asmt-id,
     2417          p-Db-num,
     2418          OUTPUT lIsAmObj,
     2419          OUTPUT iSh-Asmt-id,
     2420          OUTPUT iSh-Db-num,
     2421          OUTPUT cSh-Type,
     2422          OUTPUT cError
     2423          ).
     2424      IF cError <> "" THEN DO:
     2425         MESSAGE
     2426            PROGRAM-NAME(1) ":" SKIP
     2427            "Такого быть не должно !!!" SKIP
     2428            cError SKIP
     2429            VIEW-AS ALERT-BOX INFO BUTTONS OK.
     2430         RETURN.
     2431      END.
     2432      ASSIGN
     2433         cMode                 = (IF lIsAmObj THEN "IL_GDS":U ELSE "")
     2434         v-gl-lAM-Ref-Shablon  = (IF iSh-Asmt-id = 0 THEN FALSE ELSE TRUE)
     2435         .
     2436      RUN Get-Param-AM-Gds IN THIS-PROCEDURE(
     2437          p-Asmt-Id,
     2438          p-Db-num,
     2439          '0':U,
     2440          cMode,
     2441          OUTPUT dAmt
     2442          ).
     2443      ASSIGN
     2444         v-gl-iAM-Gds-All = dAmt[1]
     2445         v-gl-iAM-Gds-Vyv = (IF lIsAmObj THEN dAmt[2] ELSE 0)
     2446         .
     2447       IF NOT v-gl-lAM-Ref-Shablon THEN DO:
     2448          RETURN.
     2449       END.
     2450      RUN Get-Param-AM-Gds IN THIS-PROCEDURE(
     2451          iSh-Asmt-id,
     2452          iSh-Db-num,
     2453          '0':U,
     2454          "",
     2455          OUTPUT dAmt
     2456          ).
     2457      ASSIGN
     2458         v-gl-iAM-Sbl-Gds-All = dAmt[1].
     2459      RUN Calc-Proc-Otkl IN THIS-PROCEDURE(0).
     2460      RETURN.
     2461   END PROCEDURE.
     2462   PROCEDURE Get-Param-AM-Gds:
     2463      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
     2464      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
     2465      DEFINE INPUT PARAMETER   p-Stat    AS INTEGER    NO-UNDO.
     2466      DEFINE INPUT PARAMETER   p-Mode    AS CHARACTER  NO-UNDO.
     2467      DEFINE OUTPUT PARAMETER  o-dAmt    AS DECIMAL    EXTENT 2 NO-UNDO INITIAL 0.
     2468      DEFINE BUFFER buf_AM-goods FOR ub.Assortment-matrix-goods.
     2469      FOR EACH buf_AM-goods WHERE
     2470               buf_AM-goods.Asmt-id      = p-Asmt-Id
     2471           AND buf_AM-goods.Db-num       = p-Db-num
     2472           AND buf_AM-goods.asmg-status  = p-Stat
     2473          NO-LOCK:
     2474          ASSIGN
     2475             o-dAmt[1] = o-dAmt[1] + 1.
     2476          IF CAN-DO("IL_GDS":U, p-Mode) THEN DO:
     2477             IF Indicator-life-gds-n(recid(buf_AM-goods)) = 'На вывод из ассортимента':U THEN DO:
     2478                ASSIGN
     2479                   o-dAmt[2] = o-dAmt[2] + 1.
     2480             END.
     2481          END.
     2482      END.
     2483      RETURN.
     2484   END PROCEDURE.
     2485   PROCEDURE Get-Param-AM:
     2486      DEFINE INPUT  PARAMETER  p-Asmt-id   AS INTEGER   NO-UNDO.
     2487      DEFINE INPUT  PARAMETER  p-Db-num    AS INTEGER   NO-UNDO.
     2488      DEFINE OUTPUT PARAMETER  lIsObj      AS LOGICAL   NO-UNDO INITIAL FALSE.
     2489      DEFINE OUTPUT PARAMETER  o-Asmt-id   AS INTEGER   NO-UNDO INITIAL 0.
     2490      DEFINE OUTPUT PARAMETER  o-Db-Num    AS INTEGER   NO-UNDO INITIAL 0.
     2491      DEFINE OUTPUT PARAMETER  v-Type      AS CHARACTER NO-UNDO INITIAL "".
     2492      DEFINE OUTPUT PARAMETER  cError      AS CHARACTER NO-UNDO INITIAL "".
     2493      DEFINE VARIABLE v-value AS  CHARACTER NO-UNDO INITIAL "".
     2494      DEFINE BUFFER buf_AM   FOR ub.Assortment-Matrix.
     2495      DEFINE BUFFER buf_AM-2 FOR ub.Assortment-Matrix.
     2496      ASSIGN
     2497         v-gl-lAM-Is-Obj = FALSE.
     2498      FIND FIRST buf_AM WHERE
     2499                 buf_AM.asmt-id = p-Asmt-id
     2500             AND buf_AM.db-num  = p-Db-num
     2501           NO-LOCK NO-ERROR.
     2502      IF NOT AVAILABLE buf_AM THEN DO:
     2503         cError = "Не найдена АМ id=" + STRING(p-Asmt-id) + " db-num=" + STRING(p-Db-num).
     2504         RETURN.
     2505      END.
     2506      IF buf_AM.asmt-type <> 'Объект':U THEN DO:
     2507         RETURN.
     2508      END. ELSE DO:
     2509         ASSIGN
     2510            lIsObj           = TRUE
     2511            v-gl-lAM-Is-Obj  = TRUE
     2512            .
     2513      END.
     2514      run assmatat-value (
     2515          input buf_AM.asmt-id
     2516         ,input buf_AM.db-num
     2517         ,input 'RootShablon':U
     2518         ,output v-value
     2519         ,output v-type
     2520         ) .
     2521      IF v-value = "" OR v-value = ? THEN DO:
     2522         RETURN.
     2523      END.
     2524      ASSIGN
     2525         o-Asmt-id = INTEGER(ENTRY(1, v-value, chr(4)))
     2526         o-Db-num  = INTEGER(ENTRY(2, v-value, chr(4)))
     2527         NO-ERROR.
     2528      IF ERROR-STATUS:ERROR THEN DO:
     2529         cError = PROGRAM-NAME(1) + ":" + ERROR-STATUS:GET-MESSAGE(1).
     2530         RETURN.
     2531      END.
     2532      FIND FIRST buf_AM-2 WHERE
     2533                 buf_AM-2.asmt-id = o-Asmt-id
     2534             AND buf_AM-2.db-num  = o-Db-num
     2535           NO-LOCK NO-ERROR.
     2536      IF NOT AVAILABLE buf_AM-2 THEN DO:
     2537         cError = "Не найден шаблон АМ id=" + STRING(o-Asmt-id) + " db-num=" + STRING(o-Db-num).
     2538         RETURN.
     2539      END.
     2540      RETURN.
     2541   END PROCEDURE.
     2542   PROCEDURE Get-Gl-Set-Proc-Otkl:
     2543      DEFINE INPUT PARAMETER  cObj-type AS CHARACTER NO-UNDO.
     2544      DEFINE INPUT PARAMETER  iObj-code AS INTEGER   NO-UNDO.
     2545      DEFINE VARIABLE v-Character   AS CHARACTER  NO-UNDO .
     2546      DEFINE VARIABLE v-Date        AS DATE       NO-UNDO .
     2547      DEFINE VARIABLE v-Decimal     AS DECIMAL    NO-UNDO .
     2548      DEFINE VARIABLE v-Integer     AS INTEGER    NO-UNDO .
     2549      DEFINE VARIABLE v-Logical     AS LOGICAL    NO-UNDO .
     2550      DEFINE VARIABLE v-Param-Type  AS CHARACTER  NO-UNDO .
     2551      ASSIGN
     2552         v-gl-iProc-Otkl = 0
     2553         .
     2554      EMPTY TEMP-TABLE thbjattr_thbj-attr .
     2555      RUN adm/shattri.p (
     2556              INPUT  "get":U,
     2557              INPUT  cObj-type,
     2558              INPUT  iObj-code,
     2559              INPUT  'Ass-obj':U,
     2560              INPUT  'ass-proc-matr-shabl':U ,
     2561              OUTPUT v-Character,
     2562              OUTPUT v-Date,
     2563              OUTPUT v-Decimal,
     2564              OUTPUT v-Integer,
     2565              OUTPUT v-Logical,
     2566              OUTPUT v-Param-Type,
     2567              INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2568          ) NO-ERROR.
     2569      IF ERROR-STATUS:ERROR THEN DO:
     2570         ASSIGN
     2571            v-Integer  = 0
     2572            v-Decimal  = 0.
     2573      END. ELSE DO:
     2574         ASSIGN
     2575            v-gl-iProc-Otkl = v-Integer
     2576            .
     2577      END.
     2578      RETURN.
     2579   END PROCEDURE.
     2580   PROCEDURE Calc-Proc-Otkl:
     2581      DEFINE INPUT PARAMETER iDeltaGds AS INTEGER NO-UNDO.
     2582      DEFINE VARIABLE iTmp AS INTEGER NO-UNDO INITIAL 0.
     2583      ASSIGN
     2584         v-gl-dAM-Proc-Otkl     = 0
     2585         v-gl-dAM-Proc-Otkl-Ras = 0
     2586         .
     2587      IF NOT v-gl-lAM-Ref-Shablon THEN DO:
     2588         RETURN.
     2589      END.
     2590      IF v-gl-iAM-Sbl-Gds-All = 0 THEN DO:
     2591         ASSIGN
     2592            v-gl-dAM-Proc-Otkl     = 999999
     2593            v-gl-dAM-Proc-Otkl-Ras = 999999
     2594            .
     2595         RETURN.
     2596      END.
     2597      ASSIGN
     2598         iTmp = (v-gl-iAM-Gds-All - v-gl-iAM-Sbl-Gds-All)
     2599         v-gl-dAM-Proc-Otkl     = ROUND(iTmp * 100 / v-gl-iAM-Sbl-Gds-All, 2)
     2600         v-gl-dAM-Proc-Otkl-Ras = ROUND((iTmp + iDeltaGds)  * 100 / v-gl-iAM-Sbl-Gds-All, 2)
     2601         .
     2602      RETURN.
     2603   END PROCEDURE.
     2604   FUNCTION indicator-life-gds-n RETURNS CHARACTER
     2605   ( input p-rec as recid ) :
     2606   define buffer buf_matrix-goods for ub.assortment-matrix-goods .
     2607   define variable v-gdop-min-stock              as decimal   no-undo .
     2608   define variable v-grop-max-stock              as decimal   no-undo .
     2609   define variable v-grop-level-always-presence  as decimal   no-undo .
     2610   define variable v-grop-min-order              as decimal   no-undo .
     2611   define variable v-assort-min                  as LOGICAL   NO-UNDO.
     2612   DEFINE variable v-indicator-life-gds          as CHARACTER NO-UNDO.
     2613   find first buf_matrix-goods no-lock where recid (buf_matrix-goods) = p-rec no-error .
     2614   if error-status :error then return '' .
     2615   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2616   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjpr in g#library
     2617     (input  buf_Matrix-goods.obj-type
     2618     ,input  buf_Matrix-goods.obj-code
     2619     ,input  ?
     2620     ,input  ?
     2621     ,input  ?
     2622     ,input  buf_Matrix-goods.gds-code
     2623     ,output v-assort-min
     2624     ,output v-indicator-life-gds
     2625     ,output v-gdop-min-stock
     2626     ,output v-grop-max-stock
     2627     ,output v-grop-level-always-presence
     2628     ,output v-grop-min-order
     2629     )  .
     2630     return v-indicator-life-gds.
     2631   end function.
