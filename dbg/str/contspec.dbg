        1   define input  parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
        2   define input  parameter bttns          as char      no-undo .
        3   define input  parameter ref-mode       as character no-undo .
        4   define input  parameter p-host-code    as integer   no-undo .
        5   define input  parameter p-doc-num      as integer   no-undo .
        6   define output parameter rid-list       as char      no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision$":u .
        8   define variable vss-author      as character no-undo init "$Author$":u .
        9   define variable vss-date        as character no-undo init "$Date$":u .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       11   define variable vss-archive     as character no-undo init "$Archive$":u .
       12   define variable vss-description as character no-undo init "Товарная спецификация к договору" .
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117   define variable c-point  as character no-undo .
      118   define variable tbl      as character no-undo .
      119   define variable join-tbl as character no-undo .
      120   define variable fld      as character no-undo .
      121   define variable lab      as character no-undo .
      122   define variable spr      as character no-undo .
      123   define variable dim      as character no-undo .
      124   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   procedure fltfield-clear :
      126     define output parameter loc-fld as character no-undo.
      127     define output parameter loc-lab as character no-undo .
      128     define output parameter loc-spr as character no-undo .
      129     define output parameter loc-dim as character no-undo .
      130     assign
      131       loc-fld = ""
      132       loc-lab = ""
      133       loc-spr = ""
      134       loc-dim = "0"
      135     .
      136   end procedure .
      137   procedure fltfield-add :
      138     define input        parameter par-fld as character no-undo.
      139     define input        parameter par-lab as character no-undo .
      140     define input        parameter par-spr as character no-undo .
      141     define input-output parameter loc-fld as character no-undo.
      142     define input-output parameter loc-lab as character no-undo .
      143     define input-output parameter loc-spr as character no-undo .
      144     define input-output parameter loc-dim as character no-undo .
      145     do
      146     on error undo, return error
      147     :
      148       assign
      149       loc-fld = if loc-dim = '0'
      150                 then par-fld
      151                 else (loc-fld + chr(44) + par-fld)
      152       loc-lab = if loc-dim = '0'
      153                 then par-lab
      154                 else (loc-lab + chr(44) + par-lab)
      155       loc-spr = if loc-dim = '0'
      156                 then par-spr
      157                 else (loc-spr + chr(44) + par-spr)
      158       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      159                 string(integer(if num-entries(loc-dim) > 1
      160                               then entry(2, loc-dim)
      161                               else entry(1, loc-dim)
      162                               ) + 1)
      163       no-error
      164       .
      165     end.
      166   end procedure.
      167   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      168   define variable v-waitfram-action01         as character   no-undo .
      169   define variable v-waitfram-action02         as character   no-undo .
      170   define variable v-waitfram-action03         as character   no-undo .
      171   define variable mWaitFramTextBeg            as character   no-undo.
      172   define variable mWaitFramTextEnd            as character   no-undo.
      173   define variable mWaitFramView               as logical     no-undo.
      174   define variable mWaitProcEvent              as logical     no-undo init yes.
      175   define variable mWaitFramInterval           as integer     no-undo init 1 .
      176   define variable mWaitFramStop               as logical     no-undo.
      177   define variable mWaitFramStopUser           as logical     no-undo.
      178   define variable mWaitFramStopTimeOut        as logical     no-undo.
      179   define variable mWaitFramStartProc          as datetime-tz no-undo.
      180   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      181   define button B-WaitFramStop auto-end-key
      182        label "Стоп"
      183        size 10 by 1 tooltip "Остоновить процесс".
      184   define button B-viewProcInfo
      185        label "Информация"
      186        size 15 by 1 tooltip "Информация о процесс".
      187   define frame waitfram
      188     v-waitfram-action01 format "x(72)" no-label skip
      189     v-waitfram-action02 format "x(72)" no-label skip
      190     v-waitfram-action03 format "x(72)" no-label skip
      191     B-viewProcInfo
      192     B-WaitFramStop at row 4 col 30
      193     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      194     .
      195   define new global shared variable mBatchMode as logical no-undo init ?.
      196   define variable mFramBachModHandle as handle no-undo.
      197   mFramBachModHandle = frame waitfram:handle.
      198   define variable mFameOldVis as logical no-undo.
      199   define variable mVisCUrentVin as logical no-undo.
      200   if session:batch-mode
      201   then
      202      mBatchMode = yes.
      203   if mBatchMode = ? then do:
      204     mVisCUrentVin = current-window:visible.
      205     mFameOldVis = mFramBachModHandle:visible.
      206     mFramBachModHandle:visible  = yes.
      207     mBatchMode = mFramBachModHandle:visible ne yes.
      208     mFramBachModHandle:visible = mFameOldVis.
      209     current-window:visible = mVisCUrentVin.
      210   end.
      211    if  log-manager:logfile-name ne ?
      212     then DO:
      213         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      214         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      215         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      216     end.
      217   on choose of B-WaitFramStop in frame waitfram
      218   do:
      219     mWaitFramStop = yes.
      220     mWaitFramStopUser = yes.
      221   end.
      222   function waitfram-check-timeout returns logical():
      223      define variable vtime as int64 no-undo.
      224      if mWaitFramStopTimeOut
      225      then
      226         return yes.
      227      vtime = ( now - mWaitFramStartProc ) / 1000 .
      228      if     mWaitFramTimeOut ne ?
      229         and mWaitFramTimeOut ne 0
      230         and mWaitFramTimeOut lt vtime
      231      then do:
      232         mWaitFramStopTimeOut = yes.
      233      end.
      234      return mWaitFramStopTimeOut.
      235   end.
      236   procedure waitfram-hide :
      237     if not session:batch-mode
      238     then do
      239     on error undo, return error return-value
      240     :
      241       pause 0 before-hide .
      242       if not mBatchMode then
      243         hide frame waitfram .
      244     if     not mWaitFramView
      245        and mWaitProcEvent
      246     then
      247       process events .
      248     end.
      249   end procedure.
      250   procedure waitfram-show :
      251     define input  parameter p-message as character no-undo .
      252     define variable v-left-margin as integer   no-undo .
      253     if not session:batch-mode
      254     then do
      255     on error undo, return error return-value
      256     :
      257       if length(p-message) <= 70 then do:
      258         assign
      259           v-left-margin = integer((70 - length(p-message)) / 2)
      260         .
      261         assign
      262           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      263         .
      264         assign
      265           v-waitfram-action01 = " "
      266           v-waitfram-action02 = " "
      267                                    + fill(" ", v-left-margin)
      268                                    + p-message
      269           v-waitfram-action03 = " "
      270         .
      271       end.
      272       else do:
      273         define variable vRindex1 as integer no-undo.
      274         define variable vRindex2 as integer no-undo.
      275         vRindex1 = r-index(p-message," ",70).
      276         if vRindex1 = 0
      277         then
      278            vRindex1 = 70.
      279         if length(p-message)  <= vRindex1 + 70 then do:
      280           assign
      281             v-waitfram-action01 = " "
      282             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      283             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      284           .
      285         end.
      286         else do:
      287           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      288           if vRindex2 <= vRindex1
      289           then
      290              vRindex2 = vRindex1 + 70.
      291           assign
      292             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      293             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      294             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      295           .
      296         end.
      297       end.
      298       B-viewProcInfo:visible   in frame waitfram = no.
      299       B-viewProcInfo:sensitive in frame waitfram = no.
      300       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      301       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      302       if  (   mWaitFramView
      303          or  mWaitProcEvent)
      304          and not mBatchMode
      305       then
      306          display
      307             v-waitfram-action01 skip
      308             v-waitfram-action02 skip
      309             v-waitfram-action03 skip
      310          with frame waitfram .
      311       if     mWaitFramView
      312          then do:
      313             if     mWaitFramInterval ne ?
      314                and not mBatchMode
      315             then
      316                wait-for go of frame waitfram pause mWaitFramInterval.
      317          end.
      318          else
      319             if     mWaitProcEvent
      320                and not mBatchMode
      321             then
      322                process events .
      323     end.
      324   end procedure.
      325      procedure waitfram-show-this:
      326         define input  parameter iInterval as int64 no-undo.
      327         define variable vtime as int64 no-undo.
      328         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      329         mWaitFramInterval = iInterval.
      330         run waitfram-show (substitute("&1&2 &3&4" ,
      331                                       mWaitFramTextBeg ,
      332                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      333                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      334                                       mWaitFramTextEnd
      335                                      )
      336                           ).
      337      end.
      338      procedure WaitFramRunPause:
      339         define input  parameter iInterval as dec no-undo.
      340         define variable vStart  as datetime-tz no-undo.
      341         define variable vend    as datetime-tz no-undo.
      342         define variable vint as int64 no-undo.
      343         define variable vOk as logical no-undo.
      344         vStart = now.
      345         vend   = vStart.
      346         publish "WaitFramPause" (iInterval,output vOk).
      347         vend   =  now.
      348         vint = vend - vStart.
      349         vint = iInterval - vint / 1000.
      350         if     not mWaitFramStop
      351            and (   vint > 0
      352                 or (    not vOk
      353                     and iInterval eq ?
      354                     )
      355                 )
      356         then
      357            run waitfram-show-this (iInterval).
      358         vend   =  now.
      359         vint = vend - vStart.
      360         vint = iInterval - vint / 1000.
      361         if     not mWaitFramStop
      362            and vint > 0
      363         then do:
      364            run gbl/pause.p (vint * 1000).
      365         end.
      366         if iInterval ne ?
      367         then
      368            publish "WaitFramStop".
      369         waitfram-check-timeout().
      370      end.
      371      procedure WaitFramWaitFor:
      372         define input  parameter iInterval as dec no-undo.
      373         assign
      374            mWaitFramStartProc   = now
      375            mWaitFramStopUser    = no
      376            mWaitFramStopTimeOut = no
      377         .
      378         block-wait:
      379         do while not mWaitFramStop:
      380            run WaitFramRunPause (iInterval).
      381            if  waitfram-check-timeout()
      382            then do:
      383               leave block-wait.
      384            end.
      385         end.
      386         run waitfram-hide.
      387      end.
      388   procedure waitfram-join :
      389     define input  parameter p-line-1  as character no-undo .
      390     define input  parameter p-line-2  as character no-undo .
      391     define input  parameter p-line-3  as character no-undo .
      392     define output parameter p-message as character no-undo .
      393     do
      394     on error undo, return error return-value
      395     :
      396       assign
      397         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      398                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      399                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      400       .
      401     end.
      402   end procedure.
      403   function waitfram-join-function returns character
      404     (input p-line-1 as character
      405     ,input p-line-2 as character
      406     ,input p-line-3 as character
      407     ).
      408     define variable v-message as character no-undo .
      409     run waitfram-join in this-procedure
      410       (input  p-line-1
      411       ,input  p-line-2
      412       ,input  p-line-3
      413       ,output v-message
      414       ) .
      415     return v-message .
      416   end function .
      417   define new global shared variable g#library  as handle no-undo .
      418   define new global shared variable g#library2 as handle no-undo .
      419   define new global shared variable g#lib-Matrix  as handle no-undo .
      420   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      421   procedure cur-time :
      422      define output parameter p-today as date      no-undo .
      423      define output parameter p-time  as integer   no-undo .
      424     do
      425     on error undo, return error
      426     :
      427       define variable v-date1 as date      no-undo .
      428       define variable v-date2 as date      no-undo .
      429       define variable v-time  as integer   no-undo .
      430       assign
      431         v-date1 = today
      432         v-time  = time
      433         v-date2 = today
      434       .
      435       if v-date1 <> v-date2
      436       then do:
      437         assign
      438           v-date1 = today
      439           v-time  = v-time
      440         .
      441       end.
      442       assign
      443         p-today = v-date1
      444         p-time  = v-time
      445       .
      446     end.
      447   end.
      448   function cur-time-date returns character
      449   :
      450     return string(today, '99/99/9999':U) .
      451   end.
      452   function cur-time-mjd returns decimal
      453   :
      454     define variable v-date as date      no-undo .
      455     define variable v-time as integer   no-undo .
      456     run cur-time in this-procedure
      457       (output v-date
      458       ,output v-time
      459       ) .
      460     return integer(v-date) - 2400002 + (v-time / 86400) .
      461   end.
      462   function cur-time-get-ending-index returns integer
      463   (input p-number as integer
      464   )
      465   :
      466     if p-number < 0
      467     or p-number = ?
      468     then do:
      469       return 1 .
      470     end.
      471     define variable v-rest as integer   no-undo .
      472     assign
      473       p-number = p-number modulo 100
      474     .
      475     if p-number < 20
      476     then do:
      477       assign
      478         v-rest = p-number
      479       .
      480     end.
      481     else do:
      482       assign
      483         v-rest = p-number modulo 10
      484       .
      485     end.
      486     case v-rest :
      487       when 1
      488       then do:
      489         return 2 .
      490       end.
      491       when 2 or
      492       when 3 or
      493       when 4
      494       then do:
      495         return 3 .
      496       end.
      497       otherwise do:
      498         return 1 .
      499       end.
      500     end case .
      501   end.
      502   procedure cur-time-mjd-to-date :
      503      define input  parameter i-mjd-diff as decimal no-undo.
      504      define output parameter o-Date     as date    no-undo.
      505      define output parameter o-Time     as integer no-undo.
      506      define variable v-day-number as integer   no-undo .
      507      if    i-mjd-diff < 0
      508         or i-mjd-diff = ?
      509      then do:
      510         return "?" .
      511      end.
      512      assign
      513         v-day-number = truncate(i-mjd-diff,0).
      514         o-Date = date(v-day-number + 2400002).
      515         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      516     .
      517   end.
      518   function cur-time-mjd-to-string returns character
      519   (input p-mjd-diff as decimal
      520   )
      521   :
      522     define variable v-day-number as integer   no-undo .
      523     define variable v-seconds    as integer   no-undo .
      524     define variable v-hour       as integer   no-undo .
      525     define variable v-min        as integer   no-undo .
      526     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      527     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      528     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      529     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      530     if p-mjd-diff < 0
      531     or p-mjd-diff = ?
      532     then do:
      533       return "?" .
      534     end.
      535     assign
      536       v-day-number = integer(truncate(p-mjd-diff,0))
      537       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      538     .
      539     if v-seconds > 86400
      540     then do:
      541       assign
      542         v-seconds = 86400 - 1
      543       .
      544     end.
      545     if v-seconds < 0
      546     then do:
      547       assign
      548         v-seconds = 0
      549       .
      550     end.
      551     assign
      552       v-hour = truncate(v-seconds / 3600, 0)
      553     .
      554     assign
      555       v-seconds = v-seconds modulo 3600
      556     .
      557     assign
      558       v-min = truncate(v-seconds / 60, 0)
      559     .
      560     assign
      561       v-seconds = v-seconds modulo 60
      562     .
      563     return
      564         (if v-day-number <> 0
      565           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      566           else ""
      567         )
      568       + (if v-day-number <> 0 or v-hour <> 0
      569           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      570           else ""
      571         )
      572       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      573           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      574           else ""
      575         )
      576       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      577       .
      578   end.
      579   function cur-time-string returns character
      580   :
      581     define variable v-date as date      no-undo .
      582     define variable v-time as integer   no-undo .
      583     run cur-time in this-procedure
      584       (output v-date
      585       ,output v-time
      586       ) .
      587     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      588   end.
      589   function cur-time-string-sec returns character
      590   :
      591     define variable v-date as date      no-undo .
      592     define variable v-time as integer   no-undo .
      593     run cur-time in this-procedure
      594       (output v-date
      595       ,output v-time
      596       ) .
      597     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      598   end.
      599   function cur-time-custom  returns character
      600   (input p-prefix as character
      601   ,input p-date-format as character
      602   ,input p-delimiter as character
      603   ,input p-time-format as character
      604   ,input p-suffix as character
      605   )
      606   :
      607     define variable v-date as date      no-undo .
      608     define variable v-time as integer   no-undo .
      609     run cur-time in this-procedure
      610       (output v-date
      611       ,output v-time
      612       ) .
      613     return
      614       p-prefix
      615       + string(v-date, p-date-format)
      616       + p-delimiter
      617       + string(v-time, p-time-format)
      618       + p-suffix
      619       .
      620   end.
      621   function cur-time-print  returns character
      622   :
      623     define variable v-date as date      no-undo .
      624     define variable v-time as integer   no-undo .
      625     run cur-time in this-procedure
      626       (output v-date
      627       ,output v-time
      628       ) .
      629     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      630   end.
      631   function cur-time-datetime returns datetime
      632   :
      633     define variable v-char as character no-undo .
      634     define variable v-datetime as datetime no-undo .
      635     v-char = cur-time-string().
      636     v-datetime = datetime(v-char).
      637     return  v-datetime.
      638   end.
      639   function cur-time-string-msec returns character
      640   :
      641     define variable v-date as datetime  no-undo .
      642     v-date = now.
      643     return string(v-date) .
      644   end.
      645   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      646   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      647   define  shared variable RepPathName        as character no-undo .
      648   define  shared variable PrintRubl          as logical   no-undo .
      649   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      650   define  stream PrnLibStream.
      651   procedure prn-lib-prn-file :
      652     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      653     define input parameter p-DIsabledoptions as integer no-undo .
      654     define variable v-report-name as character no-undo .
      655     define variable v-user-action as character no-undo .
      656     define variable v-printed     as logical   no-undo .
      657     define variable v-exist       as logical   no-undo .
      658     do
      659       on error undo, return error
      660       :
      661       run prn-lib-get-report-name  in this-procedure (
      662         input parParentProc
      663         ,output v-report-name
      664         ).
      665   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      666   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      667     (input  v-report-name
      668     ,input  2
      669     ,output v-exist
      670     )  .
      671       if NOT v-exist then
      672       DO:
      673         Message
      674           "Нет заданий на печать ! "
      675           view-as alert-box .
      676         Return  .
      677       End.
      678       run gbl/prnfilen.w
      679         (input  ""
      680         ,input  p-DisabledOptions
      681         ,input  string(v-report-name )
      682         ,input  7
      683         ,output v-user-action
      684         ,output v-printed
      685         ) .
      686       if v-printed then
      687       do:
      688         return "YES" .
      689       end.
      690       else
      691       do:
      692         return "NO" .
      693       end.
      694     end.
      695   end procedure.
      696   procedure prn-lib-open-stream :
      697     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      698     define input parameter p-page-size    as integer no-undo .
      699     define input parameter p-is-stream    as logical no-undo .
      700     define input parameter p-append       as logical no-undo .
      701     define variable v-report-name as character no-undo .
      702     do
      703       on error undo, return error
      704       :
      705       run prn-lib-get-report-name  in this-procedure (
      706         input parParentProc
      707         ,output v-report-name
      708         ).
      709       if p-is-stream then
      710       do:
      711         if p-append then
      712         do:
      713           output stream PrnLibStream to value( v-report-name )
      714             page-size value(p-page-size) append .
      715         end.
      716         if not p-append then
      717         do:
      718           output stream PrnLibStream to value( v-report-name )
      719             page-size value(p-page-size) .
      720         end.
      721       end.
      722       if not p-is-stream then
      723       do:
      724         if p-append then
      725         do:
      726           output to value( v-report-name )
      727             page-size value(p-page-size) append .
      728         end.
      729         if not p-append then
      730         do:
      731           output to value( v-report-name )
      732             page-size value(p-page-size) .
      733         end.
      734       end.
      735     end.
      736   end procedure.
      737   procedure prn-lib-open-exp :
      738     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      739     define input parameter p-is-stream    as logical no-undo .
      740     define input parameter p-is-append    as logical no-undo .
      741     define output parameter p-ReportFileName as char init "report" no-undo.
      742     define output parameter p-process as logical no-undo .
      743     define variable glog as logical no-undo .
      744     do
      745       on error undo, return error
      746       :
      747       SYSTEM-DIALOG GET-FILE p-ReportFileName
      748         TITLE      "Укажите путь"
      749         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      750         ASK-OVERWRITE
      751         CREATE-TEST-FILE
      752         SAVE-AS
      753         USE-FILENAME
      754         DEFAULT-EXTENSION "txt"
      755         UPDATE glog
      756         .
      757       if not glog then  return.
      758       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      759       if p-is-stream then
      760       do:
      761         if p-is-append then
      762         do:
      763           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      764         end.
      765         else
      766         do:
      767           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      768         end.
      769       end.
      770       else
      771       do:
      772         if p-is-append then
      773         do:
      774           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      775         end.
      776         else
      777         do:
      778           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      779         end.
      780       end.
      781       p-process = yes.
      782     end.
      783   end procedure.
      784   procedure prn-lib-get-report-name :
      785     define input parameter parParentProc  as widget-handle no-undo.
      786     define output parameter p-report-name as character no-undo .
      787     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      788   end procedure.
      789   procedure prn-lib-reportviewer-report-name :
      790     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      791     define input parameter p-report-name-html as character no-undo .
      792     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      793   end procedure.
      794   procedure prn-lib-reportviewer :
      795     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      796     define input parameter p-report-name-html as character no-undo .
      797     define input parameter p-param        as character no-undo .
      798     define variable v-excel           as character no-undo init 'TRUE' .
      799     define variable v-value-character as character no-undo .
      800     define variable v-value-integer   as character no-undo .
      801     define variable v-value-date      as date      no-undo .
      802     define variable v-value-decimal   as decimal   no-undo .
      803     define variable rep-excel         as logical   no-undo .
      804     define variable excel-string      as character no-undo .
      805     define variable v-param-type      as character no-undo .
      806     define variable v-tth             as handle    no-undo .
      807     run adm/shattri.p (
      808       input "get":U
      809       ,input  ""
      810       ,input  0
      811       ,input  'report-glob':U
      812       ,input  'rep-excel':U
      813       ,output v-value-character
      814       ,output v-value-date
      815       ,output v-value-decimal
      816       ,output v-value-integer
      817       ,output rep-excel
      818       ,output v-param-type
      819       ,INPUT-OUTPUT table-handle v-tth
      820       )  .
      821     if rep-excel then v-excel = "TRUE" .
      822     else v-excel = "FALSE" .
      823     if p-param eq ""
      824     then
      825        p-param = "EXCEL:" + v-excel.
      826     else
      827        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      828     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      829   end procedure.
      830   define new global shared variable g#libbcrcn as handle no-undo .
      831   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      832   procedure integerm :
      833     define input  parameter p-string      as character no-undo .
      834     define input  parameter p-allow-sign  as logical   no-undo .
      835     define input  parameter p-allow-comma as logical   no-undo .
      836     define output parameter p-value       as integer   no-undo .
      837     define output parameter p-data-valid  as logical   no-undo .
      838     define output parameter p-message     as character no-undo .
      839     define variable v-replace-string as character no-undo .
      840     do
      841     on error undo, return error return-value
      842     :
      843       if p-string = ?
      844       then do:
      845         assign
      846           p-value      = ?
      847           p-data-valid = false
      848           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
      849         .
      850         return .
      851       end.
      852       if p-string = ""
      853       then do:
      854         assign
      855           p-value      = ?
      856           p-data-valid = false
      857           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      858         .
      859         return .
      860       end.
      861       assign
      862         p-value = integer(p-string) no-error
      863       .
      864       if error-status :error = true
      865       then do:
      866         assign
      867           p-value      = ?
      868           p-data-valid = false
      869           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      870                                    ,p-string
      871                                    )
      872         .
      873         return .
      874       end.
      875       if index(p-string, ' ':u) > 0
      876       then do:
      877         assign
      878           p-value      = ?
      879           p-data-valid = false
      880           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      881                                    + "Строка содержит символы пробела"
      882                                    ,p-string
      883                                    )
      884         .
      885         return .
      886       end.
      887       assign
      888         v-replace-string = p-string
      889         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      890         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      891         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      892         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      893         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      894         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      895         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      896         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      897         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      898       .
      899       if p-allow-sign = true
      900       then do:
      901         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      902         then do:
      903           assign
      904             v-replace-string = substring(v-replace-string, 2)
      905           .
      906         end.
      907       end.
      908       else do:
      909         if substring(v-replace-string, 1, 1) = '+':u
      910         then do:
      911           assign
      912             p-value      = ?
      913             p-data-valid = false
      914             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      915                                     + "Задан параметр недопустимости знака челого числа. "
      916                                     + "Строка содержит символ плюс. "
      917                                     ,p-string
      918                                     )
      919           .
      920           return .
      921         end.
      922         if substring(v-replace-string, 1, 1) = '-':u
      923         then do:
      924           assign
      925             p-value      = ?
      926             p-data-valid = false
      927             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      928                                     + "Задан параметр недопустимости знака челого числа. "
      929                                     + "Строка содержит символ минус. "
      930                                     ,p-string
      931                                     )
      932           .
      933           return .
      934         end.
      935       end.
      936       if p-allow-comma = true
      937       then do:
      938         assign
      939           v-replace-string = replace(v-replace-string, ',', '')
      940         .
      941       end.
      942       else do:
      943         if index(v-replace-string, ',') > 0
      944         then do:
      945           assign
      946             p-value      = ?
      947             p-data-valid = false
      948             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      949                                     + "Задан параметр недопустимости знака разделителя тысяч."
      950                                     + "Строка содержит знак разделителя тысяч. "
      951                                     ,p-string
      952                                     )
      953           .
      954           return .
      955         end.
      956       end.
      957       if index(p-string, '.') > 0
      958       then do:
      959         assign
      960           p-value      = ?
      961           p-data-valid = false
      962           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      963                                    + "Строка содержит знак десятичной точки"
      964                                    ,p-string
      965                                    )
      966         .
      967         return .
      968       end.
      969       if v-replace-string <> fill('9', length(v-replace-string))
      970       then do:
      971         assign
      972           p-value      = ?
      973           p-data-valid = false
      974           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      975                                    + "Встречены символы, недопустимые для целого числа '&2'"
      976                                    ,p-string
      977                                    ,replace(v-replace-string, '9', '')
      978                                    )
      979         .
      980         return .
      981       end.
      982       assign
      983         p-data-valid = true
      984         p-message    = ""
      985       .
      986     end.
      987   end procedure.
      988   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      989   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
      990   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
      991   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      992   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      993   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
      994   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
      995   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      996   procedure uf-name :
      997     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      998     define output parameter p-use-List_     as logical   no-undo .
      999     define output parameter p-type-List_     as character no-undo .
     1000     define output parameter p-format-List_   as character no-undo .
     1001     define output parameter p-use-Naim      as logical   no-undo .
     1002     define output parameter p-type-Naim      as character no-undo .
     1003     define output parameter p-format-Naim    as character no-undo .
     1004     define output parameter p-use-print-graft as logical   no-undo .
     1005     define output parameter p-use-sort-gr   as logical   no-undo .
     1006     define output parameter p-use-type-price as logical   no-undo .
     1007     define output parameter p-use-type-val  as logical   no-undo .
     1008     define output parameter p-label          as character no-undo .
     1009     define output parameter p-tooltip        as character no-undo .
     1010     define output parameter p-user-can-edit  as logical   no-undo .
     1011     define output parameter p-output-display as logical   no-undo .
     1012     define output parameter p-other          as character no-undo .
     1013     do
     1014     on error undo, return error
     1015     :
     1016       case p-code :
     1017               when 'cli-all-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1018               when 'oldscode':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника неиспользуемых весовых кодов"     p-tooltip = "Настройки справочника неиспользуемых весовых кодов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1019               when 'gds-ref-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(8)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = yes      p-label = "Параметры вызова справочника товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1020               when 'gds-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1021               when 'fbr-gds-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп блюд"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп блюд"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
