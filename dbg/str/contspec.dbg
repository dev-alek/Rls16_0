     3892   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     3893   DO:
     3894       define variable v-num-entry as integer no-undo .
     3895     if not available buf_contract-specif then return no-apply.
     3896     find first temp-conn where temp-conn.ri = recid( buf_contract-specif ) no-error  .
     3897     if available temp-conn then do:
     3898       delete temp-conn .
     3899       assign  mark-num = mark-num - 1 .
     3900     end.
     3901     else do:
     3902       if b-sel:sensitive and mark-num >= 4000 then do:
     3903         message "Превышено максимально допустимое количество выбранных строк." skip
     3904                 "Отбирайте необходимые товары по частям"
     3905         view-as alert-box WARNING.
     3906         apply "entry" to spec-List .
     3907         return no-apply.
     3908       end.
     3909       create temp-conn .
     3910       assign
     3911       temp-conn.ri = recid( buf_contract-specif )
     3912       mark-num = mark-num + 1
     3913       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + string(temp-conn.ri).
     3914       .
     3915     end.
     3916     g-log = spec-List:refresh() .
     3917     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then  do:
     3918       g-log = spec-List:select-next-row ().
     3919       apply "value-changed" to spec-List in frame Dialog-Frame.
     3920     end.
     3921     if mark-num = 0 then hide mark-num in frame Dialog-Frame.
     3922     else              display mark-num with frame Dialog-Frame.
     3923     apply "entry" to spec-List .
     3924   END.
     3925   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     3926   DO:
     3927     run proc-print in this-procedure .
     3928   END.
     3929   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     3930   DO:
     3931     find first temp-conn no-error.
     3932     if available temp-conn then do:
     3933       run gbl/markqwa.p ( input b-sel:sensitive, input string(temp-conn.ri)) no-error.
     3934       if error-status:error then do:
     3935         apply "entry" to spec-List .
     3936         return no-apply.
     3937       end.
     3938     end.
     3939     if is-new or is-new1 then do:
     3940       run proc-write in this-procedure .
     3941     end.
     3942   END.
