     3308        buf_contract-specif.vat-type   COLUMN-LABEL 'тип!НДС'
     3309        buf_contract-specif.income-qnty   COLUMN-LABEL 'Принято'
     3310        get-grp(buf_contract-specif.gds-code) @ p-grp COLUMN-LABEL 'Группа товара'  Format "x(100)"
     3311        buf_contract-specif.unit-cli   COLUMN-LABEL 'Ед.!изм!пост'
     3312        buf_contract-specif.unit-cli-ord   COLUMN-LABEL 'Ед.изм!пост в!заказе'
     3313        buf_contract-specif.cli-base-rate-ord   COLUMN-LABEL 'Коэф.!в!заказе'
     3314        buf_contract-specif.unit-cli-rcv   COLUMN-LABEL 'Ед.изм!пост в!поставке'
     3315        buf_contract-specif.cli-base-rate-rcv   COLUMN-LABEL 'Коэф.!в!поставке'
     3316        f-bonus(recid(buf_contract-specif))   COLUMN-LABEL '%!Бонус' Format "->>9.99"
     3317        get-ext-artic(recid(buf_contract-specif))   COLUMN-LABEL 'Внешний!Артикул' Format "X(16)"
     3318        enable buf_contract-specif.artic
     3319       WITH NO-ROW-MARKERS SEPARATORS SIZE 99 BY 17.25.
     3320   DEFINE FRAME Dialog-Frame
     3321        b-quit AT ROW 1 COL 1
     3322        B-mark AT ROW 1 COL 11
     3323        b-sel AT ROW 1 COL 20
     3324        B-add AT ROW 1 COL 30
     3325        b-chg AT ROW 1 COL 40
     3326        B-del AT ROW 1 COL 50
     3327        b-exp AT ROW 1 COL 60
     3328        b-imp AT ROW 1 COL 70
     3329        b-filter-ext AT ROW 1 COL 80 WIDGET-ID 14
     3330        b-uf AT ROW 1 COL 83 WIDGET-ID 12
     3331        b-sch1 AT ROW 1 COL 88.75
     3332        B-print AT ROW 1 COL 91.88
     3333        b-hist AT ROW 1 COL 94.88
     3334        B-Help AT ROW 1 COL 97.88
     3335        B-allmark AT ROW 2 COL 11
     3336        B-unmark AT ROW 2 COL 14.13
     3337        B-add-AssMatr AT ROW 2 COL 20 WIDGET-ID 2
     3338        B-del-AssMatr AT ROW 2 COL 30 WIDGET-ID 4
     3339        b-func AT ROW 2 COL 40 WIDGET-ID 26
     3340        RADIO-find AT ROW 3.38 COL 12 NO-LABEL
     3341        sch-str AT ROW 3.38 COL 54.5 COLON-ALIGNED NO-LABEL
     3342        spec-List AT ROW 4.55 COL 1
     3343        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     3344        all-qnty AT ROW 21.9 COL 13 COLON-ALIGNED
     3345        all-sum AT ROW 21.9 COL 48.5 COLON-ALIGNED
     3346        "Поиск по" VIEW-AS TEXT
     3347             SIZE 9 BY 1 AT ROW 3.38 COL 1
     3348             FGCOLOR 4
     3349        SPACE(91.37) SKIP(18.95)
     3350       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3351            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     3352            TITLE "Товарная спецификация к договору"
     3353            DEFAULT-BUTTON b-quit CANCEL-BUTTON b-quit.
     3354   ASSIGN
     3355          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     3356          FRAME Dialog-Frame:HIDDEN           = TRUE.
     3357   ASSIGN
     3358          b-exp:POPUP-MENU IN FRAME Dialog-Frame       = MENU m-export:HANDLE.
     3359   ASSIGN
     3360          b-func:POPUP-MENU IN FRAME Dialog-Frame       = MENU m-func:HANDLE.
     3361   ASSIGN
     3362          b-imp:POPUP-MENU IN FRAME Dialog-Frame       = MENU m-import:HANDLE.
     3363   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     3364   DO:
     3365     APPLY "END-ERROR":U TO SELF.
     3366   END.
     3367   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     3368   DO:
     3369   define variable vss-include-info31 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3370   do:
     3371     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3372       (input  v-cntxt-db-num
     3373       ,input  v-cntxt-userid
     3374       ,input  0
     3375       ,input  'actn_fin-contract_modernization':U
     3376       ,input  'firm':U
     3377       ,input  p-host-code
     3378       ,input  '':U
     3379       ,input  0
     3380       ,input  0
     3381       ,input  0
     3382       ,input  0
     3383       ,input  true
     3384       ,output g-log
     3385       )  .
     3386   end.
     3387     if not g-log then  return .
     3388     run proc-add in this-procedure .
     3389     run proc-sum in this-procedure .
     3390     run openbr in this-procedure ( input yes, input no, input '':u).
     3391     if v-doc-rec-tmp <> ? THEN DO:
     3392        REPOSITION spec-List to RECID v-doc-rec-tmp NO-ERROR.
     3393        ASSIGN
     3394           v-doc-rec-tmp = ?.
     3395     END.
     3396   END.
     3397   ON CHOOSE OF B-add-AssMatr IN FRAME Dialog-Frame
     3398   DO:
     3399   define variable vss-include-info32 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3400   do:
     3401     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3402       (input  v-cntxt-db-num
     3403       ,input  v-cntxt-userid
     3404       ,input  0
     3405       ,input  'actn_fin-contract_modernization':U
     3406       ,input  'firm':U
     3407       ,input  p-host-code
     3408       ,input  '':U
     3409       ,input  0
     3410       ,input  0
     3411       ,input  0
     3412       ,input  0
     3413       ,input  true
     3414       ,output g-log
     3415       )  .
     3416   end.
     3417     if not g-log then  return .
     3418     run proc-add-Ass in this-procedure .
     3419   END.
     3420   ON CHOOSE OF B-allmark IN FRAME Dialog-Frame
     3421   DO:
     3422     for each temp-conn: delete temp-conn . end.
     3423     assign mark-num = 0 .
     3424     GET FIRST spec-List NO-LOCK .
     3425     DO WHILE AVAILABLE(buf_contract-specif):
     3426       create temp-conn .
     3427       assign
     3428         temp-conn.ri = recid( buf_contract-specif )
     3429         mark-num = mark-num + 1
     3430       .
     3431       GET next spec-List NO-LOCK .
     3432     end.
     3433     if mark-num = 0 then hide    mark-num in frame Dialog-Frame.
     3434     else                 display mark-num  with frame Dialog-Frame.
     3435     RUN OpenBr in this-procedure ( input yes, input no, input '':U) .
     3436   END.
     3437   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     3438   DO:
     3439   define variable vss-include-info33 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3440   do:
     3441     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3442       (input  v-cntxt-db-num
     3443       ,input  v-cntxt-userid
     3444       ,input  0
     3445       ,input  'actn_fin-contract_modernization':U
     3446       ,input  'firm':U
     3447       ,input  p-host-code
     3448       ,input  '':U
     3449       ,input  0
     3450       ,input  0
     3451       ,input  0
     3452       ,input  0
     3453       ,input  true
     3454       ,output g-log
     3455       )  .
     3456   end.
     3457     if not g-log then return .
     3458     if not available buf_contract-specif then return no-apply.
     3459     assign g-log = no .
     3460     if mark-num > 0 then do:
     3461       message "Вы действительно хотите изменить все выделенные спецификации?"
     3462       view-as alert-box QUESTION BUTTONS YES-NO UPDATE g-log .
     3463       if g-log = no then return no-apply.
     3464     end.
     3465     IF AVAILABLE buf_contract-specif THEN DO:
     3466        ASSIGN
     3467           v-Doc-rec-tmp = RECID(buf_Contract-Specif)
     3468           .
     3469     END.
     3470     if mark-num > 1 then do:
     3471       assign
     3472         v-price    = ?
     3473         v-vat-type = ?
     3474         v-qnty     = ?
     3475         v-vat-pc   = ?
     3476         v-cli-base-rate = ?
     3477         v-unit-cli = ?
     3478         v-cli-base-rate-ord = ?
     3479         v-unit-cli-ord = ?
     3480         v-cli-base-rate-rcv = ?
     3481         v-unit-cli-rcv = ?
     3482         v-bonus   = 0
     3483         v-retro-bonus = ""
     3484       .
     3485       run str/contspc1.w
     3486                          ( input parParentProc
     3487                          , input 'ИЗМЕНЕНИЕ':U
     3488                          , input 0 // gds-code для выбора v-unit-cli
     3489                          , input ""
     3490                          , input ""
     3491                          , input "?????? ???????"
     3492                          , input ""
     3493                          , input-output v-price
     3494                          , input-output v-prc
     3495                          , input-output v-prc-2
     3496                          , input-output v-vat-type
     3497                          , input-output v-qnty
     3498                          , input-output v-cli-base-rate
     3499                          , input-output v-vat-pc
     3500                          , input-output v-unit-cli
     3501                          , input-output v-unit-cli-ord
     3502                          , input-output v-cli-base-rate-ord
     3503                          , input-output v-unit-cli-rcv
     3504                          , input-output v-cli-base-rate-rcv
     3505                          , input-output v-bonus
     3506                          , input-output v-retro-bonus
     3507                          , output v-res ) .
     3508       if v-res then do:
     3509         do transaction :
     3510           for each temp-conn :
     3511             find first ub.contract-specif exclusive-lock where recid(ub.contract-specif) = temp-conn.ri .
     3512           if v-cli-base-rate <> ? then do:
     3513               find first buf_goods no-lock where
     3514                        buf_goods.gds-code = contract-specif.gds-code .
     3515               if v-cli-base-rate <> 1 and
     3516                        v-unit-cli = buf_goods.unit-base then do:
     3517                 message
     3518                 substitute("Товар: &1 &2&3 &4&5" +
     3519                           "Единица измерения совпадает с базовой, а коэффициент <> 1. Изменение по товару не произведено.&5"
     3520                          ,buf_goods.artic
     3521                          ,buf_goods.prod-type
     3522                          ,buf_goods.prod-code
     3523                          ,buf_goods.gds-name
     3524                          ,chr(10)
     3525                          )
     3526                 view-as alert-box error.
     3527                 next.
     3528               end.
     3529               if v-cli-base-rate <> buf_goods.cli-base-rate and
     3530                        v-unit-cli = buf_goods.unit-cli then do:
     3531                 message
     3532                 substitute("Товар: &1 &2&3 &4&5" +
     3533                          "Единица измерения совпадает с ед.изм.поставщика, а коэффициент нет. Изменение по товару не произведено.&5"
     3534                          ,buf_goods.artic
     3535                          ,buf_goods.prod-type
     3536                          ,buf_goods.prod-code
     3537                          ,buf_goods.gds-name
     3538                          ,chr(10)
     3539                          )
     3540                 view-as alert-box error.
     3541                 next.
     3542               end.
     3543               assign
     3544                 ub.contract-specif.cli-base-rate-rcv = v-cli-base-rate-rcv
     3545                 ub.contract-specif.cli-base-rate     = v-cli-base-rate
     3546               .
     3547           end.
     3548           assign
     3549             ub.contract-specif.price-cli    = v-price        when (v-price <> ?)
     3550             ub.contract-specif.prc          = v-prc          when (v-prc <> ?)
     3551             ub.contract-specif.vat-type     = v-vat-type     when (v-vat-type <> ?)
     3552             ub.contract-specif.qnty         = v-qnty         when (v-qnty <> ?)
     3553             ub.contract-specif.sum-cli      = ub.contract-specif.price-cli * ub.contract-specif.qnty
     3554             ub.contract-specif.VAT-pc       = v-vat-pc       when (v-vat-pc <> ?)
     3555             ub.contract-specif.unit-cli     = v-unit-cli     when (v-unit-cli <> ?)
     3556             ub.contract-specif.unit-cli-ord = v-unit-cli-ord when (v-unit-cli-ord <> ?)
     3557             ub.contract-specif.unit-cli-rcv = v-unit-cli-rcv when (v-unit-cli-rcv <> ?)
     3558           .
     3559              run write-bonus in this-procedure (
     3560                  buf_contract.contract-code  ,
     3561                  buf_contract.host-code     ,
     3562                  ub.contract-specif.gds-code      ,
     3563                  v-bonus ).
     3564              run write-prc-min in this-procedure (
     3565                  buf_contract.contract-code  ,
     3566                  buf_contract.host-code     ,
     3567                  contract-specif.gds-code      ,
     3568                  v-prc-2 ).
     3569              run write-retro-bonus in this-procedure (
     3570                  buf_contract.contract-code  ,
     3571                  buf_contract.host-code     ,
     3572                  contract-specif.gds-code      ,
     3573                  v-retro-bonus ).
     3574             assign
     3575               is-new = yes
     3576             .
     3577           end.
     3578         end.
     3579         run proc-sum in this-procedure .
     3580         RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     3581       end.
     3582     end.
     3583     else do:
     3584       if mark-num = 1 then do:
     3585         find first temp-conn .
     3586         find first buf_contract-specif no-lock where recid(buf_contract-specif) = temp-conn.ri .
     3587       end.
     3588       assign
     3589         v-price    = buf_contract-specif.price-cli
     3590         v-prc      = buf_contract-specif.prc
     3591         v-vat-type = buf_contract-specif.vat-type
     3592         v-qnty     = buf_contract-specif.qnty
     3593         v-cli-base-rate = buf_contract-specif.cli-base-rate
     3594         v-vat-pc   = buf_contract-specif.VAT-pc
     3595         v-unit-cli = buf_contract-specif.unit-cli
     3596         v-cli-base-rate-ord = buf_contract-specif.cli-base-rate-ord
     3597         v-unit-cli-ord = buf_contract-specif.unit-cli-ord
     3598         v-cli-base-rate-rcv = buf_contract-specif.cli-base-rate-rcv
     3599         v-unit-cli-rcv = buf_contract-specif.unit-cli-rcv
     3600       .
     3601       run read-bonus  in this-procedure (
     3602           buf_contract.contract-code  ,
     3603           buf_contract.host-code     ,
     3604           buf_contract-specif.gds-code      ,
     3605           output v-bonus ).
     3606       run read-prc-min in this-procedure (
     3607           buf_contract.contract-code  ,
     3608           buf_contract.host-code     ,
     3609           buf_contract-specif.gds-code      ,
     3610           output v-prc-2 ).
     3611       run read-retro-bonus in this-procedure (
     3612           buf_contract.contract-code ,
     3613           buf_contract.host-code     ,
     3614           buf_contract-specif.gds-code   ,
     3615           output v-retro-bonus ) .
     3616       find first buf_goods no-lock where buf_goods.gds-code = buf_contract-specif.gds-code .
     3617       run str/contspc1.w
     3618                          ( input parParentProc
     3619                          , input 'ИЗМЕНЕНИЕ':U
     3620                          , input buf_contract-specif.gds-code
     3621                          , input buf_contract-specif.artic
     3622                          , input (buf_contract-specif.prod-type + string(buf_contract-specif.prod-code))
     3623                          , input buf_contract-specif.gds-name
     3624                          , input buf_contract-specif.unit-base
     3625                          , input-output v-price
     3626                          , input-output v-prc
     3627                          , input-output v-prc-2
     3628                          , input-output v-vat-type
     3629                          , input-output v-qnty
     3630                          , input-output v-cli-base-rate
     3631                          , input-output v-vat-pc
     3632                          , input-output  v-unit-cli
     3633                          , input-output v-unit-cli-ord
     3634                          , input-output v-cli-base-rate-ord
     3635                          , input-output v-unit-cli-rcv
     3636                          , input-output v-cli-base-rate-rcv
     3637                          , input-output v-bonus
     3638                          , input-output v-retro-bonus
     3639                          , output v-res ) .
     3640       if v-res then do:
     3641         run read-bonus in this-procedure (
     3642             buf_contract.contract-code  ,
     3643             buf_contract.host-code     ,
     3644             buf_contract-specif.gds-code      ,
     3645             output old-bonus ).
     3646         run read-prc-min in this-procedure (
     3647             buf_contract.contract-code  ,
     3648             buf_contract.host-code     ,
     3649             buf_contract-specif.gds-code      ,
     3650             output old-prc-min ).
     3651         run read-retro-bonus in this-procedure (
     3652             buf_contract.contract-code ,
     3653             buf_contract.host-code     ,
     3654             buf_contract-specif.gds-code   ,
     3655             output old-retro-bonus ) .
     3656         if   v-price <> buf_contract-specif.price-cli
     3657           or v-prc <> buf_contract-specif.prc
     3658           or v-qnty <> buf_contract-specif.qnty
     3659           or v-vat-pc <> buf_contract-specif.vat-pc
     3660           or v-vat-type <> buf_contract-specif.vat-type
     3661           or v-cli-base-rate <> buf_contract-specif.cli-base-rate
     3662           or v-unit-cli <> buf_contract-specif.unit-cli
     3663           or v-cli-base-rate-ord <> buf_contract-specif.cli-base-rate-ord
     3664           or v-unit-cli-ord <> buf_contract-specif.unit-cli-ord
     3665           or v-cli-base-rate-rcv <> buf_contract-specif.cli-base-rate-rcv
     3666           or v-unit-cli-rcv <> buf_contract-specif.unit-cli-rcv
     3667           or v-bonus <> old-bonus
     3668           or v-prc-2 <> old-prc-min
     3669           or v-retro-bonus <> old-retro-bonus
     3670         then do:
     3671           do transaction :
     3672             find first ub.contract-specif exclusive-lock where recid (ub.contract-specif) = recid(buf_contract-specif) .
     3673             if v-cli-base-rate <> ? then do:
     3674               find first buf_goods no-lock where buf_goods.gds-code = contract-specif.gds-code .
     3675               if v-cli-base-rate <> 1 and
     3676                        v-unit-cli = buf_goods.unit-base then do:
     3677                 message
     3678                 substitute("Товар: &1 &2&3 &4&5" +
     3679                           "Единица измерения совпадает с базовой, а коэффициент <> 1. Изменение по товару не произведено.&5"
     3680                          ,buf_goods.artic
     3681                          ,buf_goods.prod-type
     3682                          ,buf_goods.prod-code
     3683                          ,buf_goods.gds-name
     3684                          ,chr(10)
     3685                          )
     3686                 view-as alert-box error.
     3687                 undo, return no-apply.
     3688               end.
     3689               if v-cli-base-rate <> buf_goods.cli-base-rate and
     3690                        v-unit-cli = buf_goods.unit-cli then do:
     3691                 message
     3692                 substitute("Товар: &1 &2&3 &4&5" +
     3693                          "Единица измерения совпадает с ед.изм.поставщика, а коэффициент нет. Изменение по товару не произведено.&5"
     3694                          ,buf_goods.artic
     3695                          ,buf_goods.prod-type
     3696                          ,buf_goods.prod-code
     3697                          ,buf_goods.gds-name
     3698                          ,chr(10)
     3699                          )
     3700                 view-as alert-box error.
     3701                 undo, return no-apply.
     3702               end.
     3703               assign
     3704                 ub.contract-specif.cli-base-rate-rcv = v-cli-base-rate-rcv
     3705                 ub.contract-specif.cli-base-rate     = v-cli-base-rate
     3706               .
     3707             end.
     3708             assign
     3709               ub.contract-specif.price-cli    = v-price
     3710               ub.contract-specif.prc          = v-prc
     3711               ub.contract-specif.vat-type     = v-vat-type
     3712               ub.contract-specif.qnty         = v-qnty
     3713               ub.contract-specif.sum-cli      = v-price * v-qnty
     3714               ub.contract-specif.VAT-pc       = v-vat-pc
     3715               ub.contract-specif.unit-cli     = v-unit-cli
     3716               ub.contract-specif.unit-cli-ord = v-unit-cli-ord
     3717               ub.contract-specif.unit-cli-rcv = v-unit-cli-rcv
     3718               is-new = yes
     3719             .
     3720              run write-bonus in this-procedure (
     3721                  buf_contract.contract-code ,
     3722                  buf_contract.host-code     ,
     3723                  ub.contract-specif.gds-code      ,
     3724                  v-bonus ).
     3725              run write-prc-min in this-procedure (
     3726                  buf_contract.contract-code ,
     3727                  buf_contract.host-code     ,
     3728                  contract-specif.gds-code      ,
     3729                  v-prc-2 ).
     3730              run write-retro-bonus in this-procedure (
     3731                  buf_contract.contract-code  ,
     3732                  buf_contract.host-code     ,
     3733                  contract-specif.gds-code      ,
