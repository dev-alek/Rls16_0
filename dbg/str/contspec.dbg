     1794              buf_assortment-matrix-goods.gds-code = p-gds-code
     1795              :
     1796       for each buf_gds-obj-prop exclusive-lock where
     1797               buf_gds-obj-prop.obj-type = buf_assortment-matrix.obj-type and
     1798               buf_gds-obj-prop.obj-code = buf_assortment-matrix.obj-code and
     1799               buf_gds-obj-prop.gds-code = buf_assortment-matrix-goods.gds-code
     1800               :
     1801               if not (buf_gds-obj-prop.gdop-igt = 'Пусто':U or
     1802                       buf_gds-obj-prop.gdop-igt = 'На вывод из ассортимента':U ) then do:
     1803                 v-err-ext = true .
     1804                 v-longchar = v-longchar +
     1805                 substitute("Принудительная смена ИЖТ &1 на ПУСТО у товара &2 на объекте &3 &4&5" ,
     1806                   buf_gds-obj-prop.gdop-igt ,
     1807                   buf_gds-obj-prop.gds-code ,
     1808                   buf_assortment-matrix.obj-type ,
     1809                   buf_assortment-matrix.obj-code , chr(10) )   .
     1810               assign
     1811                 buf_gds-obj-prop.gdop-igt = 'Пусто':U
     1812                 .
     1813               end.
     1814       end.
     1815       release buf_gds-obj-prop .
     1816       if buf_assortment-matrix-goods.asmg-status = int('0':U) then do:
     1817           v-sts = int('1':U) .
