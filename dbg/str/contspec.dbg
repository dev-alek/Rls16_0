     2885   procedure thbjattr_set-section :
     2886   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
     2887   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
     2888   define input  parameter p-upper-code  like ub.thbj-attr.upper-prop-code  no-undo .
     2889   define input  parameter table-handle p-tth.
     2890   do
     2891   on error undo, return error return-value
     2892   :
     2893       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_set-section in g#attr-lib
     2894       (input  p-obj-type
     2895       ,input  p-obj-code
     2896       ,input  p-upper-code
     2897       ,input  table-handle p-tth
     2898       ) no-error .
     2899     if error-status :error
     2900     then do:
     2901       delete object p-tth.
     2902       undo, return error return-value .
     2903     end.
     2904     delete object p-tth.
     2905   end.
     2906   end procedure.
     2907   procedure thbjattr_delete :
     2908   define input  parameter p-obj-type   like ub.thbj-attr.obj-type   no-undo .
     2909   define input  parameter p-obj-code   like ub.thbj-attr.obj-code   no-undo .
     2910   define input  parameter p-upper-code like ub.thbj-attr.upper-prop-code  no-undo .
     2911   define input  parameter p-code       like ub.thbj-attr.prop-code  no-undo .
     2912   define output parameter p-deleted  as logical no-undo.
     2913   do
     2914   on error undo, return error return-value
     2915   :
     2916       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_delete in g#attr-lib
     2917       (input  p-obj-type
     2918       ,input  p-obj-code
     2919       ,input  p-upper-code
     2920       ,input  p-code
     2921       ,output p-deleted
     2922       ) no-error .
     2923     if error-status :error
     2924     then do:
     2925       undo, return error return-value .
     2926     end.
     2927   end.
     2928   end procedure.
