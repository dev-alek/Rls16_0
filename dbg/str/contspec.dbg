     2679   procedure thbjattr_code :
     2680      define input  parameter p-upper-code     as character no-undo .
     2681      define input  parameter p-code           as character no-undo .
     2682      define output parameter p-label          as character no-undo .
     2683      define output parameter p-user-can-edit  as logical   no-undo .
     2684      define output parameter p-output-display as logical   no-undo .
     2685      define output parameter p-other          as character no-undo .
     2686      define output parameter p-prop-list      as character no-undo .
     2687      define output parameter p-prop-type-list as character no-undo .
     2688      define output parameter p-prop-label-list as character no-undo .
     2689      define output parameter p-global          as logical no-undo .
     2690      define output parameter p-host           as logical no-undo .
     2691      define output parameter p-shop           as logical no-undo .
     2692      define output parameter p-store          as logical no-undo .
     2693      define output parameter p-db             as logical no-undo .
     2694      define variable p-region as logical no-undo.
     2695      run thbjattr_code_reg in this-procedure (
     2696                                               p-upper-code,
     2697                                               p-code,
     2698                                               output p-label,
     2699                                               output p-user-can-edit,
     2700                                               output p-output-display,
     2701                                               output p-other,
     2702                                               output p-prop-list,
     2703                                               output p-prop-type-list,
     2704                                               output p-prop-label-list,
     2705                                               output p-global,
     2706                                               output p-host,
     2707                                               output p-shop,
     2708                                               output p-store,
     2709                                               output p-db,
     2710                                               output p-region
     2711                                               ).
     2712   end procedure.
