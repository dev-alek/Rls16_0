     2726   define output parameter p-store          as logical no-undo .
     2727   define output parameter p-db             as logical no-undo .
     2728   define output parameter p-region         as logical no-undo .
     2729   do
     2730   on error undo, return error return-value
     2731   :
     2732       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
     2733       (input  p-upper-code
     2734       ,input  p-code
     2735       ,output p-label
     2736       ,output p-user-can-edit
     2737       ,output p-output-display
     2738       ,output p-other
     2739       ,output p-prop-list
     2740       ,output p-prop-type-list
     2741       ,output p-prop-label-list
     2742       ,output p-global
     2743       ,output p-host
     2744       ,output p-shop
     2745       ,output p-store
     2746       ,output p-db
     2747       ,output p-region
     2748       ) no-error .
     2749     if error-status :error
     2750     then do:
     2751       undo, return error substitute( "&1. &2&3&4", vss-include-info28, return-value, chr(10), error-status :get-message (1)).
