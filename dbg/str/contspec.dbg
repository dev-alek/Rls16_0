     4008   ON CHOOSE OF MENU-ITEM m-func-all-values
     4009   DO:
     4010    define variable v-user-action as character    no-undo.
     4011    define variable v-printed     as logical      no-undo.
     4012    define variable is-ok-all     as logical      no-undo.
     4013    define variable v-file-err    as character    no-undo.
     4014   define variable vss-include-info36 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4015   do:
     4016     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4017       (input  v-cntxt-db-num
     4018       ,input  v-cntxt-userid
     4019       ,input  0
     4020       ,input  'actn_fin-contract_modernization':U
     4021       ,input  'firm':U
     4022       ,input  p-host-code
     4023       ,input  '':U
     4024       ,input  0
     4025       ,input  0
     4026       ,input  0
     4027       ,input  0
     4028       ,input  true
     4029       ,output g-log
     4030       )  .
     4031   end.
     4032     if not g-log then  return .
     4033    v-file-err = string(session:TEMP-DIRECTORY) + '/writeSpec.err':U .
     4034    if search (v-file-err) <> ? then do:
     4035      os-delete value(v-file-err).
     4036    end.
     4037    run str\contspc2.w (input parParentProc,
     4038                        output v-prc,
     4039                        output v-prc-2,
     4040                        output v-bonus,
     4041                        output v-vat-pc,
     4042                        output v-vat-type,
     4043                        output v-retro-bonus,
     4044                        output v-change-fields) .
     4045     if v-change-fields <> ? and v-change-fields <> "" then do :
     4046         output stream stream-err to value(v-file-err) append .
     4047         put stream stream-err unformatted "Товары из спецификации, для которых не удалось проставить параметры ретро-бонуса (из-за пересекающихся периодов) :" skip.
     4048         is-ok-all = true.
     4049         for each  contract-specif exclusive-lock where
     4050                   contract-specif.host-code = p-host-code and
     4051                   contract-specif.contract-num = p-doc-num
     4052         , first temp-trn-doc where  ( r-2 = 1 or contract-specif.gds-code = temp-trn-doc.gds-code ) :
     4053           if lookup("prc", v-change-fields) > 1 then
     4054             assign
     4055               contract-specif.prc = v-prc
     4056             .
     4057           if lookup("prc-2", v-change-fields) > 1 then
     4058             run write-prc-min in this-procedure (
     4059                 contract-specif.contract-num  ,
     4060                 contract-specif.host-code     ,
     4061                 contract-specif.gds-code      ,
     4062                 v-prc-2 ).
     4063           if lookup("bonus", v-change-fields) > 1 then
     4064             run write-bonus in this-procedure (
     4065                 contract-specif.contract-num,
     4066                 contract-specif.host-code,
     4067                 contract-specif.gds-code,
     4068                 v-bonus).
     4069           if lookup("vat-pc", v-change-fields) > 1 then
     4070             assign
     4071                 contract-specif.VAT-pc = v-vat-pc
     4072                 contract-specif.vat-type = v-vat-type
     4073             .
     4074           if lookup("retro-bonus", v-change-fields) > 1 then do :
     4075             find first ub.contract-specif-attr exclusive-lock  where
     4076                        ub.contract-specif-attr.contract-num = contract-specif.contract-num  and
     4077                        ub.contract-specif-attr.host-code    = contract-specif.host-code     and
     4078                        ub.contract-specif-attr.gds-code     = contract-specif.gds-code      and
     4079                        ub.contract-specif-attr.attr-code    = "retro-bonus"
     4080                        no-error .
     4081                if not available ub.contract-specif-attr then do:
     4082                  create ub.contract-specif-attr .
     4083                  assign
     4084                        ub.contract-specif-attr.contract-num = contract-specif.contract-num
     4085                        ub.contract-specif-attr.host-code    = contract-specif.host-code
     4086                        ub.contract-specif-attr.gds-code     = contract-specif.gds-code
     4087                        ub.contract-specif-attr.attr-code    = "retro-bonus"
     4088                        ub.contract-specif-attr.attr-value  = v-retro-bonus
     4089                  .
     4090                end.
     4091                else do:
     4092                  define variable i as integer no-undo .
     4093                  define variable is-ok as logical no-undo .
     4094                  is-ok = true.
     4095                  do i = 1 to num-entries(ub.contract-specif-attr.attr-value, ';') - 1 :
     4096                    if ( date(entry(1, v-retro-bonus)) <= date(entry(2, entry(i, ub.contract-specif-attr.attr-value, ';')))   and
     4097                         date(entry(1, v-retro-bonus)) >= date(entry(1, entry(i, ub.contract-specif-attr.attr-value, ';'))) ) or
     4098                       ( date(entry(2, v-retro-bonus)) <= date(entry(2, entry(i, ub.contract-specif-attr.attr-value, ';')))   and
     4099                         date(entry(2, v-retro-bonus)) >= date(entry(1, entry(i, ub.contract-specif-attr.attr-value, ';'))) ) or
     4100                       ( date(entry(1, v-retro-bonus)) <= date(entry(1, entry(i, ub.contract-specif-attr.attr-value, ';')))   and
     4101                         date(entry(2, v-retro-bonus)) >= date(entry(2, entry(i, ub.contract-specif-attr.attr-value, ';'))) ) then do :
     4102                      is-ok = false.
     4103                      is-ok-all = false.
     4104                    end.
     4105                  end.
     4106                  if not is-ok then do :
     4107                      put stream stream-err unformatted
     4108                         substitute ("Код: &1   артикул: &2   наименование: &3"
     4109                                      , contract-specif.gds-code
     4110                                      , contract-specif.artic
     4111                                      , contract-specif.gds-name
     4112                                    ) skip.
     4113                  end.
     4114                  else do :
     4115                     ub.contract-specif-attr.attr-value = ub.contract-specif-attr.attr-value + v-retro-bonus no-error.
     4116                     if error-status:error then
     4117                         message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     4118                  end.
     4119                end.
     4120           end.
     4121         end.
     4122         assign
     4123           is-new = yes
     4124         .
     4125         output stream stream-err close .
     4126         RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     4127         if not is-ok-all then do :
     4128            MESSAGE
     4129             "Для некоторых товаров из данной спецификации не удалось установить параметры 'ретро-бонуса'" skip
     4130             "Хотите просмотреть отчет?"
     4131             VIEW-AS ALERT-BOX QUESTION buttons YES-NO update glog as logical.
     4132             if not glog then    RETURN NO-APPLY.
     4133             else do :
     4134               run gbl/prnfilen.w
     4135                   (input  "Ошибки при установки 'ретро-бонуса'"
     4136                   ,input  0
     4137                   ,input  v-file-err
     4138                   ,input  7
     4139                   ,output v-user-action
     4140                   ,output v-printed
     4141                   ).
     4142             end.
     4143         end.
     4144     end.
     4145   END.
     4146   ON CHOOSE OF MENU-ITEM m-export-text
     4147   DO:
     4148     run proc-export-text in this-procedure .
     4149   END.
     4150   ON CHOOSE OF MENU-ITEM m-func-vat-all
     4151   DO:
     4152   define variable vss-include-info37 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4153   do:
     4154     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4155       (input  v-cntxt-db-num
     4156       ,input  v-cntxt-userid
     4157       ,input  0
     4158       ,input  'actn_fin-contract_modernization':U
     4159       ,input  'firm':U
     4160       ,input  p-host-code
     4161       ,input  '':U
     4162       ,input  0
     4163       ,input  0
     4164       ,input  0
     4165       ,input  0
     4166       ,input  true
     4167       ,output g-log
     4168       )  .
