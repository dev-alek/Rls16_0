     1772             if error-status :error then message
     1773               vss-workfile vss-revision vss-description skip
     1774               error-status :get-message(1) skip
     1775               return-value skip
     1776               ""
     1777               view-as alert-box error
     1778             .
     1779         end.
     1780       end.
     1781   end.
     1782   if num-entries(v-list-mat) = 0 then return .
     1783   define buffer buf_gds-obj-prop          for ub.gds-obj-prop  .
     1784   define buffer buf_assortment-matrix     for ub.assortment-matrix  .
     1785   define buffer buf_assortment-matrix-goods for ub.assortment-matrix-goods  .
     1786   define variable i as integer   no-undo .
