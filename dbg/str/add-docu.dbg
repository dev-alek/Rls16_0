     1673   on ctrl-f of x_add-doc.shift-date in frame Dialog-Frame
     1674   do:
     1675     if (can-query (self, "sensitive")
     1676        and
     1677        self :sensitive = true
     1678        )
     1679     or (can-query (self, "read-only")
     1680        and
     1681        self :read-only = false
     1682        )
     1683     then do:
     1684       if self :handle <> focus :handle
     1685       then do:
     1686         apply "entry":u to self .
     1687       end.
     1688       define variable v-ok            as logical   no-undo .
     1689       define variable v-curr-sv-date  as date      no-undo .
     1690       define variable v-description   as character no-undo .
     1691       assign
     1692         v-curr-sv-date = date(self :screen-value) no-error
     1693       .
     1694       if v-curr-sv-date = ?
     1695       then do:
     1696         run gbl/getcurdt.p
     1697           (output v-curr-sv-date
     1698           ) .
     1699       end.
     1700       if v-curr-sv-date <> ?
     1701       then do:
     1702         run gbl/d-inpday.w
     1703           (input ?
     1704           ,input "Выбор даты"
     1705           ,input v-description
     1706           ,input ""
     1707           ,input-output v-curr-sv-date
     1708           ,output v-ok
     1709           ).
     1710         if v-ok = true
     1711         then do:
     1712           assign
     1713             self :screen-value = string(v-curr-sv-date) .
     1714           .
     1715         end.
     1716       end.
     1717     end.
     1718     return no-apply .
     1719   end.
