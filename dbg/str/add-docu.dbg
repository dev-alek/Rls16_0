      120   define new global shared variable g#library  as handle no-undo .
      121   define new global shared variable g#library2 as handle no-undo .
      122   define new global shared variable g#lib-trn  as handle no-undo .
      123   define new global shared variable g#lib-trn2 as handle no-undo .
      124   define new global shared variable g#lib-trn3 as handle no-undo .
      125   define new global shared variable g#lib-trn4 as handle no-undo .
      126   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127   procedure doc-code:
      128   define input  parameter parmode          as   character           no-undo.
      129   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      130   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      131   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      132   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      133   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      134   define variable vardb-remote     as   logical             no-undo.
      135   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      136   define variable v-delimiter as character no-undo .
      137   do
      138   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      139   :
      140   find first buf_sys-ctrl no-lock .
      141   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      142     CASE parmode:
      143       when "main":u then do:
      144         if vardb-remote then do:
      145           assign
      146             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      147         end.
      148         else do:
      149           assign
      150             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      151         end.
      152       end.
      153       when "trio" then do:
      154         assign
      155           pardoc-code = replace (parroot-doc-code, "=", "*").
      156       end.
      157       otherwise do:
      158         assign
      159         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      160         no-error
      161         .
      162         if error-status:error  then do:
      163           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      164                                         ,chr(10)
      165                                         ,parmode
      166                                         ).
      167         end.
      168         if num-entries(parmode) = 1
      169         and parmode <> "chip":U
      170         and parmode <> "chip_s":U
      171         then do:
      172           assign
      173           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      174         end.
      175         else if (lookup("chip":U, parmode) > 0
      176                  or
      177                  lookup("chip_s":U, parmode) > 0) then do:
      178           assign
      179             vartemp-doc-code = parroot-doc-code.
      180           do while true:
      181             if index (vartemp-doc-code , ".") = 0 then
      182               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      183             else
      184               vartemp-doc-code  =
      185               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      186               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      187               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      188             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      189           end.
      190           assign
      191             pardoc-code = vartemp-doc-code.
      192         end.
      193       end.
      194     end CASE.
      195     if pardoc-code = '':U
      196     or (parroot-doc-code <> '':U
      197     and pardoc-code = parroot-doc-code) then do:
      198       undo, return error substitute("Ошибка при генерации номера документа&1"
      199                                     ,chr(10)).
      200     end.
      201   end.
      202   end. // procedure/method
      203   function get-doc-code-int64 returns int64
      204     ( input p-doc-code as character ) :
      205     define variable v-ind              as integer   no-undo .
      206     define variable v-num-entries      as integer   no-undo .
      207     define variable v-doc-code-int64   as int64     no-undo .
      208     define variable v-canonic-doc-code as character no-undo .
      209     assign
      210       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      211       v-canonic-doc-code = p-doc-code
      212     .
      213     do v-ind = 1 to v-num-entries
      214     :
      215       assign
      216         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      217       .
      218     end.
      219     assign
      220       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      221     .
      222     return v-doc-code-int64 .
      223   end. // function/method
      224   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      225     define variable v-cntxt-db-num        as integer   no-undo .
      226     define variable v-cntxt-userid        as character no-undo .
      227     define variable v-cntxt-level         as character no-undo .
      228     define variable v-cntxt-host-code-obj as integer   no-undo .
      229     define variable v-cntxt-obj-type      as character no-undo .
      230     define variable v-cntxt-obj-code      as integer   no-undo .
      231     define variable v-cntxt-db-num-obj    as integer   no-undo .
      232     define variable v-cntxt-is-admin      as logical   no-undo .
      233   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      234     run mainmenu_getcntxt in parparentproc
      235       (output v-cntxt-db-num
      236       ,output v-cntxt-userid
      237       ,output v-cntxt-level
      238       ,output v-cntxt-host-code-obj
      239       ,output v-cntxt-obj-type
      240       ,output v-cntxt-obj-code
      241       ,output v-cntxt-db-num-obj
      242       ,output v-cntxt-is-admin
      243       ) .
      244   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      245   define variable v-waitfram-action01         as character   no-undo .
      246   define variable v-waitfram-action02         as character   no-undo .
      247   define variable v-waitfram-action03         as character   no-undo .
      248   define variable mWaitFramTextBeg            as character   no-undo.
      249   define variable mWaitFramTextEnd            as character   no-undo.
      250   define variable mWaitFramView               as logical     no-undo.
      251   define variable mWaitProcEvent              as logical     no-undo init yes.
      252   define variable mWaitFramInterval           as integer     no-undo init 1 .
      253   define variable mWaitFramStop               as logical     no-undo.
      254   define variable mWaitFramStopUser           as logical     no-undo.
      255   define variable mWaitFramStopTimeOut        as logical     no-undo.
      256   define variable mWaitFramStartProc          as datetime-tz no-undo.
      257   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      258   define button B-WaitFramStop auto-end-key
      259        label "Стоп"
      260        size 10 by 1 tooltip "Остоновить процесс".
      261   define button B-viewProcInfo
      262        label "Информация"
      263        size 15 by 1 tooltip "Информация о процесс".
      264   define frame waitfram
      265     v-waitfram-action01 format "x(72)" no-label skip
      266     v-waitfram-action02 format "x(72)" no-label skip
      267     v-waitfram-action03 format "x(72)" no-label skip
      268     B-viewProcInfo
      269     B-WaitFramStop at row 4 col 30
      270     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      271     .
      272   define new global shared variable mBatchMode as logical no-undo init ?.
      273   define variable mFramBachModHandle as handle no-undo.
      274   mFramBachModHandle = frame waitfram:handle.
      275   define variable mFameOldVis as logical no-undo.
      276   define variable mVisCUrentVin as logical no-undo.
      277   if session:batch-mode
      278   then
      279      mBatchMode = yes.
      280   if mBatchMode = ? then do:
      281     mVisCUrentVin = current-window:visible.
      282     mFameOldVis = mFramBachModHandle:visible.
      283     mFramBachModHandle:visible  = yes.
      284     mBatchMode = mFramBachModHandle:visible ne yes.
      285     mFramBachModHandle:visible = mFameOldVis.
      286     current-window:visible = mVisCUrentVin.
      287   end.
      288    if  log-manager:logfile-name ne ?
      289     then DO:
      290         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      291         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      292         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      293     end.
      294   on choose of B-WaitFramStop in frame waitfram
      295   do:
      296     mWaitFramStop = yes.
      297     mWaitFramStopUser = yes.
      298   end.
      299   function waitfram-check-timeout returns logical():
      300      define variable vtime as int64 no-undo.
      301      if mWaitFramStopTimeOut
      302      then
      303         return yes.
      304      vtime = ( now - mWaitFramStartProc ) / 1000 .
      305      if     mWaitFramTimeOut ne ?
      306         and mWaitFramTimeOut ne 0
      307         and mWaitFramTimeOut lt vtime
      308      then do:
      309         mWaitFramStopTimeOut = yes.
      310      end.
      311      return mWaitFramStopTimeOut.
      312   end.
      313   procedure waitfram-hide :
      314     if not session:batch-mode
      315     then do
      316     on error undo, return error return-value
      317     :
      318       pause 0 before-hide .
      319       if not mBatchMode then
      320         hide frame waitfram .
      321     if     not mWaitFramView
      322        and mWaitProcEvent
      323     then
      324       process events .
      325     end.
      326   end procedure.
      327   procedure waitfram-show :
      328     define input  parameter p-message as character no-undo .
      329     define variable v-left-margin as integer   no-undo .
      330     if not session:batch-mode
      331     then do
      332     on error undo, return error return-value
      333     :
      334       if length(p-message) <= 70 then do:
      335         assign
      336           v-left-margin = integer((70 - length(p-message)) / 2)
      337         .
      338         assign
      339           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      340         .
      341         assign
      342           v-waitfram-action01 = " "
      343           v-waitfram-action02 = " "
      344                                    + fill(" ", v-left-margin)
      345                                    + p-message
      346           v-waitfram-action03 = " "
      347         .
      348       end.
      349       else do:
      350         define variable vRindex1 as integer no-undo.
      351         define variable vRindex2 as integer no-undo.
      352         vRindex1 = r-index(p-message," ",70).
      353         if vRindex1 = 0
      354         then
      355            vRindex1 = 70.
      356         if length(p-message)  <= vRindex1 + 70 then do:
      357           assign
      358             v-waitfram-action01 = " "
      359             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      360             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      361           .
      362         end.
      363         else do:
      364           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      365           if vRindex2 <= vRindex1
      366           then
      367              vRindex2 = vRindex1 + 70.
      368           assign
      369             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      370             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      371             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      372           .
      373         end.
      374       end.
      375       B-viewProcInfo:visible   in frame waitfram = no.
      376       B-viewProcInfo:sensitive in frame waitfram = no.
      377       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      378       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      379       if  (   mWaitFramView
      380          or  mWaitProcEvent)
      381          and not mBatchMode
      382       then
      383          display
      384             v-waitfram-action01 skip
      385             v-waitfram-action02 skip
      386             v-waitfram-action03 skip
      387          with frame waitfram .
      388       if     mWaitFramView
      389          then do:
      390             if     mWaitFramInterval ne ?
      391                and not mBatchMode
      392             then
      393                wait-for go of frame waitfram pause mWaitFramInterval.
      394          end.
      395          else
      396             if     mWaitProcEvent
      397                and not mBatchMode
      398             then
      399                process events .
      400     end.
      401   end procedure.
      402      procedure waitfram-show-this:
      403         define input  parameter iInterval as int64 no-undo.
      404         define variable vtime as int64 no-undo.
      405         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      406         mWaitFramInterval = iInterval.
      407         run waitfram-show (substitute("&1&2 &3&4" ,
      408                                       mWaitFramTextBeg ,
      409                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      410                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      411                                       mWaitFramTextEnd
      412                                      )
      413                           ).
      414      end.
      415      procedure WaitFramRunPause:
      416         define input  parameter iInterval as dec no-undo.
      417         define variable vStart  as datetime-tz no-undo.
      418         define variable vend    as datetime-tz no-undo.
      419         define variable vint as int64 no-undo.
      420         define variable vOk as logical no-undo.
      421         vStart = now.
      422         vend   = vStart.
      423         publish "WaitFramPause" (iInterval,output vOk).
      424         vend   =  now.
      425         vint = vend - vStart.
      426         vint = iInterval - vint / 1000.
      427         if     not mWaitFramStop
      428            and (   vint > 0
      429                 or (    not vOk
      430                     and iInterval eq ?
      431                     )
      432                 )
      433         then
      434            run waitfram-show-this (iInterval).
      435         vend   =  now.
      436         vint = vend - vStart.
      437         vint = iInterval - vint / 1000.
      438         if     not mWaitFramStop
      439            and vint > 0
      440         then do:
      441            run gbl/pause.p (vint * 1000).
      442         end.
      443         if iInterval ne ?
      444         then
      445            publish "WaitFramStop".
      446         waitfram-check-timeout().
      447      end.
      448      procedure WaitFramWaitFor:
      449         define input  parameter iInterval as dec no-undo.
      450         assign
      451            mWaitFramStartProc   = now
      452            mWaitFramStopUser    = no
      453            mWaitFramStopTimeOut = no
      454         .
      455         block-wait:
      456         do while not mWaitFramStop:
      457            run WaitFramRunPause (iInterval).
      458            if  waitfram-check-timeout()
      459            then do:
      460               leave block-wait.
      461            end.
      462         end.
      463         run waitfram-hide.
      464      end.
      465   procedure waitfram-join :
      466     define input  parameter p-line-1  as character no-undo .
      467     define input  parameter p-line-2  as character no-undo .
      468     define input  parameter p-line-3  as character no-undo .
      469     define output parameter p-message as character no-undo .
      470     do
      471     on error undo, return error return-value
      472     :
      473       assign
      474         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      475                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      476                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      477       .
      478     end.
      479   end procedure.
      480   function waitfram-join-function returns character
      481     (input p-line-1 as character
      482     ,input p-line-2 as character
      483     ,input p-line-3 as character
      484     ).
      485     define variable v-message as character no-undo .
      486     run waitfram-join in this-procedure
      487       (input  p-line-1
      488       ,input  p-line-2
      489       ,input  p-line-3
      490       ,output v-message
      491       ) .
      492     return v-message .
      493   end function .
      494   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      495   FUNCTION alg-name RETURNS CHARACTER
      496     ( buffer loc-table for ub.gds-add-charges ) :
      497   if not available  loc-table  then return "678" .
      498   if loc-table.cost-include = no then return "".
      499   case loc-table.algoritm :
      500     when "1" then do:
      501       return "сумме приходных цен".
      502     end.
      503     when "2" then do:
      504       return "количеству(в баз. ед.изм.)".
      505     end.
      506     when "3" then do:
      507       return "количеству(в пост. ед.изм.)" .
      508     end.
      509     when "4" then do:
      510       return "весу".
      511     end.
      512   end case.
      513   END FUNCTION.
      514   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      515   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      516   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      517   define variable par-type          as character no-undo.
      518   define variable v-value-character as character no-undo .
      519   define variable v-value-date      as date      no-undo .
      520   define variable v-value-decimal   as decimal   no-undo .
      521   define variable v-value-integer   as integer   no-undo .
      522   define variable v-value-logical   as logical   no-undo .
      523   define variable v-doc-code as character no-undo .
      524   define variable v-curr-abbr as character no-undo .
      525   define variable ref-rec as recid no-undo.
      526   define variable varvat-type  as integer   no-undo .
      527   define variable varvat-type-type            as   character initial ?    no-undo.
      528   define variable varvat-type-def             as   character              no-undo.
      529   define variable v-recid as recid no-undo .
      530   define variable v-mode-exit  as character no-undo .
      531   DEFINE TEMP-TABLE old_add-line NO-UNDO LIKE ub.add-line.
      532   empty temp-table old_add-line.
      533   DEFINE BUTTON B-add
      534        LABEL "&Добавить"
      535        SIZE 10 BY 1 TOOLTIP "Добавить Дополнительный расход"
      536        BGCOLOR 8 .
      537   DEFINE BUTTON B-chg
      538        LABEL "&Изменить"
      539        SIZE 10 BY 1
      540        BGCOLOR 8 .
      541   DEFINE BUTTON B-del
      542        LABEL "&Удалить"
      543        SIZE 10 BY 1
      544        BGCOLOR 8 .
      545   DEFINE BUTTON B-exit AUTO-GO
      546        LABEL "&Ввод"
      547        SIZE 10 BY 1
      548        BGCOLOR 8 .
      549   DEFINE BUTTON B-Help
      550        LABEL "&Help"
      551        SIZE 3 BY 1
      552        BGCOLOR 8 .
      553   DEFINE BUTTON B-lkp
      554        LABEL "&Просмотр"
      555        SIZE 10 BY 1
      556        BGCOLOR 8 .
      557   DEFINE BUTTON B-print
      558        LABEL "&p"
      559        SIZE 3 BY 1 TOOLTIP "Печать документа"
      560        BGCOLOR 8 .
      561   DEFINE BUTTON B-quit AUTO-END-KEY
      562        LABEL "&Отмена"
      563        SIZE 10 BY 1
      564        BGCOLOR 8 .
      565   DEFINE BUTTON B-trn
      566        LABEL "&+ПН"
      567        SIZE 5.5 BY 1 TOOLTIP "Добавить Приходные накладные в список"
      568        BGCOLOR 8 .
      569   DEFINE BUTTON B-trn-del
      570        LABEL "&-ПН"
      571        SIZE 5.5 BY 1 TOOLTIP "Удалить приходные накладные из списка"
      572        BGCOLOR 8 .
      573   DEFINE BUTTON B-trn-sel
      574        LABEL "Просмотр ПН"
      575        SIZE 13.5 BY 1 TOOLTIP "Просмотр приходной накладной"
      576        BGCOLOR 8 .
      577   DEFINE BUTTON r-acc
      578        IMAGE-UP FILE "btn-down-arrow":U
      579        IMAGE-DOWN FILE "btn-down-arrow":U
      580        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      581        LABEL ""
      582        SIZE 3 BY 1.
      583   DEFINE BUTTON r-currency
      584        IMAGE-UP FILE "btn-down-arrow":U
      585        IMAGE-DOWN FILE "btn-down-arrow":U
      586        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      587        LABEL ""
      588        SIZE 3 BY 1.
      589   DEFINE BUTTON r-sht
      590        IMAGE-UP FILE "btn-down-arrow":U
      591        IMAGE-DOWN FILE "btn-down-arrow":U
      592        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      593        LABEL ""
      594        SIZE 3 BY .88.
      595   DEFINE VARIABLE f-summa AS CHARACTER FORMAT "X(256)":U INITIAL " Сумма"
      596         VIEW-AS TEXT
      597        SIZE 7.5 BY .79
      598        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      599   DEFINE VARIABLE f-vat AS CHARACTER FORMAT "X(256)":U INITIAL " НДС"
      600         VIEW-AS TEXT
      601        SIZE 5 BY .79
      602        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      603   DEFINE VARIABLE scr-curr-abbr AS CHARACTER FORMAT "X(3)":U
      604         VIEW-AS TEXT
      605        SIZE 4 BY .79
      606        FGCOLOR 4  NO-UNDO.
      607   DEFINE VARIABLE v-obj-name AS CHARACTER FORMAT "X(256)":U
      608         VIEW-AS TEXT
      609        SIZE 26 BY .79
      610        FGCOLOR 1  NO-UNDO.
      611   DEFINE QUERY BR-docsa FOR
      612         x_add-line,
      613         x_goods,
      614         x_gds-add-charges SCROLLING.
      615   DEFINE QUERY BROWSE-7 FOR
      616         x_add-trn,
      617         x_trn-doc SCROLLING.
      618   DEFINE QUERY Dialog-Frame FOR
      619         x_add-doc SCROLLING.
      620   DEFINE BROWSE BR-docsa
      621     QUERY BR-docsa NO-LOCK DISPLAY
      622         x_goods.artic FORMAT "X(16)":U
      623         x_add-line.gds-code FORMAT "999999999":U
      624         x_goods.gds-name FORMAT "X(48)":U
      625         x_add-line.cli-type + string(x_add-line.cli-code) FORMAT "X(11)":U
      626         x_add-line.contract-code FORMAT ">>>>>>>>>>":U  label "Договор"
      627         x_add-line.sum-base FORMAT "->>>,>>>,>>9.99":U
      628         x_add-line.sum-rubl FORMAT "->>>,>>>,>>9.99":U
      629         x_add-line.vat-pc FORMAT "->>,>>9.99":U
      630         alg-name( buffer x_gds-add-charges) label "Алгоритм" format "x(30)":u
      631       WITH NO-ROW-MARKERS SEPARATORS SIZE 95.5 BY 10 FIT-LAST-COLUMN.
      632   DEFINE BROWSE BROWSE-7
      633     QUERY BROWSE-7 NO-LOCK DISPLAY
      634         x_add-trn.trn-doc-code FORMAT "X(14)"
      635         (SUBSTRING(x_trn-doc.status_,1,4) + STRING(x_trn-doc.flag_,"+/-")) FORMAT "X(5)":U COLUMN-LABEL "Статус"
      636         x_trn-doc.doc-date FORMAT "99/99/99":U
      637         x_trn-doc.cli-name FORMAT "X(40)":U
      638       WITH NO-ROW-MARKERS SEPARATORS SIZE 43 BY 9 FIT-LAST-COLUMN.
      639   DEFINE FRAME Dialog-Frame
      640        B-exit AT ROW 1 COL 1
      641        B-quit AT ROW 1 COL 11
      642        B-print AT ROW 1 COL 91.38 WIDGET-ID 72
      643        B-Help AT ROW 1 COL 94.5
      644        x_add-doc.exch-rate AT ROW 3 COL 32.5 COLON-ALIGNED WIDGET-ID 14
      645             VIEW-AS FILL-IN
      646             SIZE 10 BY 1 TOOLTIP "Курс валюты документа"
      647             FGCOLOR 4
      648        x_add-doc.exch-scale AT ROW 3 COL 42.63 COLON-ALIGNED NO-LABEL WIDGET-ID 16
      649             VIEW-AS FILL-IN
      650             SIZE 5 BY 1
      651             FGCOLOR 4
      652        r-acc AT ROW 3 COL 49.63 WIDGET-ID 54
      653        B-trn AT ROW 3 COL 54 WIDGET-ID 50
      654        B-trn-del AT ROW 3 COL 59.5 WIDGET-ID 66
      655        B-trn-sel AT ROW 3 COL 65 WIDGET-ID 68
      656        x_add-doc.exch-code AT ROW 3.25 COL 8.5 COLON-ALIGNED WIDGET-ID 10
      657             LABEL "Валюта"
      658             VIEW-AS FILL-IN
      659             SIZE 4 BY 1 TOOLTIP "Валюта документа"
      660             FGCOLOR 4
      661        r-currency AT ROW 3.25 COL 14.5 WIDGET-ID 52
      662        x_add-doc.exch-date AT ROW 3.25 COL 19.5 COLON-ALIGNED NO-LABEL WIDGET-ID 12
      663             VIEW-AS FILL-IN
      664             SIZE 9 BY 1 TOOLTIP "Дата курса"
      665        BROWSE-7 AT ROW 4.21 COL 53.75 WIDGET-ID 300
      666        x_add-doc.base-rate AT ROW 4.33 COL 8.5 COLON-ALIGNED WIDGET-ID 2
      667             LABEL "Баз.вал"
      668             VIEW-AS FILL-IN
      669             SIZE 10 BY 1
      670        x_add-doc.base-scale AT ROW 4.33 COL 18.63 COLON-ALIGNED NO-LABEL WIDGET-ID 4
      671             VIEW-AS FILL-IN
      672             SIZE 5 BY 1
      673        x_add-doc.doc-date AT ROW 5.38 COL 8.5 COLON-ALIGNED WIDGET-ID 8
      674             VIEW-AS FILL-IN
      675             SIZE 9 BY 1
      676        x_add-doc.fact-date AT ROW 6.42 COL 8.38 COLON-ALIGNED WIDGET-ID 18
      677             VIEW-AS FILL-IN
      678             SIZE 9 BY 1
      679        x_add-doc.shift-date AT ROW 6.42 COL 25.88 COLON-ALIGNED WIDGET-ID 26
      680             LABEL "Смена"
      681             VIEW-AS FILL-IN
      682             SIZE 9 BY 1
      683        x_add-doc.shift-name AT ROW 6.42 COL 38.13 COLON-ALIGNED WIDGET-ID 28
      684             LABEL "№"
      685             VIEW-AS FILL-IN
      686             SIZE 3 BY 1
      687        x_add-doc.shift-num AT ROW 6.42 COL 44.38 COLON-ALIGNED WIDGET-ID 30
      688             LABEL "П"
      689             VIEW-AS FILL-IN
      690             SIZE 3 BY 1
      691        r-sht AT ROW 6.42 COL 49.88 WIDGET-ID 56
      692        x_add-doc.VAT-type AT ROW 11 COL 30 COLON-ALIGNED WIDGET-ID 70
      693             LABEL "НДС" FORMAT "X(8)"
      694             VIEW-AS COMBO-BOX INNER-LINES 5
      695             LIST-ITEMS "Item 1"
      696             DROP-DOWN-LIST
      697             SIZE 13.5 BY 1
      698        B-add AT ROW 12.13 COL 1.75 WIDGET-ID 42
      699        B-lkp AT ROW 12.13 COL 11.75 WIDGET-ID 44
      700        B-chg AT ROW 12.13 COL 21.75 WIDGET-ID 46
      701        B-del AT ROW 12.13 COL 31.75 WIDGET-ID 48
      702        BR-docsa AT ROW 13.25 COL 1.5 WIDGET-ID 200
      703        x_add-doc.obj-type AT ROW 2.13 COL 7.25 COLON-ALIGNED WIDGET-ID 22
      704             LABEL "Объект" FORMAT "X(3)"
      705              VIEW-AS TEXT
      706             SIZE 4 BY .79
      707             FGCOLOR 1
      708        x_add-doc.obj-code AT ROW 2.13 COL 11.88 COLON-ALIGNED NO-LABEL WIDGET-ID 20 FORMAT ">>>>9"
      709              VIEW-AS TEXT
      710             SIZE 6 BY .79
      711             FGCOLOR 1
      712        v-obj-name AT ROW 2.13 COL 18.75 COLON-ALIGNED NO-LABEL WIDGET-ID 58
      713        x_add-doc.doc-code AT ROW 2.13 COL 49.13 COLON-ALIGNED WIDGET-ID 6
      714             LABEL "№" FORMAT "X(14)"
      715              VIEW-AS TEXT
      716             SIZE 15 BY .79
      717        scr-curr-abbr AT ROW 3.29 COL 15.5 COLON-ALIGNED NO-LABEL WIDGET-ID 60
      718        f-summa AT ROW 8.42 COL 8.5 COLON-ALIGNED NO-LABEL WIDGET-ID 62
      719       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      720            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      721            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit WIDGET-ID 100.
      722   DEFINE FRAME Dialog-Frame
      723        f-vat AT ROW 8.42 COL 30 COLON-ALIGNED NO-LABEL WIDGET-ID 64
      724        x_add-doc.sum-base AT ROW 9.33 COL 10 COLON-ALIGNED WIDGET-ID 32
      725             LABEL "Сумма"
      726              VIEW-AS TEXT
      727             SIZE 21 BY .67
      728        x_add-doc.VAT-base AT ROW 9.33 COL 30 COLON-ALIGNED NO-LABEL WIDGET-ID 36
      729              VIEW-AS TEXT
      730             SIZE 20.5 BY .67
      731        x_add-doc.sum-rubl AT ROW 10.33 COL 10 COLON-ALIGNED WIDGET-ID 34
      732              VIEW-AS TEXT
      733             SIZE 20.5 BY .67
      734        x_add-doc.VAT-rubl AT ROW 10.33 COL 30 COLON-ALIGNED NO-LABEL WIDGET-ID 38
      735              VIEW-AS TEXT
      736             SIZE 20.5 BY .67
      737        SPACE(45.12) SKIP(12.41)
      738       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      739            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      740            TITLE "Документ Дополнительных расходов"
      741            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit WIDGET-ID 100.
      742   ASSIGN
      743          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      744          FRAME Dialog-Frame:HIDDEN           = TRUE.
      745   ASSIGN
      746          x_add-doc.exch-code:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      747   ASSIGN
      748          x_add-doc.exch-date:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      749   ASSIGN
      750          x_add-doc.exch-rate:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      751   ASSIGN
      752          x_add-doc.exch-scale:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      753   ASSIGN
      754          r-acc:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      755   ASSIGN
      756          r-currency:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      757   ASSIGN
      758          scr-curr-abbr:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      759   ON GO OF FRAME Dialog-Frame
      760   DO:
      761     if  p-mode <> 'ПРОСМОТР':U then do:
      762         run proc-save in this-procedure no-error.
      763         if error-status :error then return no-apply .
      764     end.
      765   END.
      766   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      767   DO:
      768     APPLY "choose":U TO b-quit.
      769   END.
      770   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      771   DO:
      772   define variable v-rid-list as character no-undo .
      773   define variable v-cnt      as integer   no-undo .
      774   define variable v-vat-pc   as decimal   no-undo .
      775   define variable v-mode as character no-undo .
      776   define buffer buf_goods for ub.goods  .
      777   define buffer buf_add-line for ub.add-line  .
      778     run ref/addchls.w
      779       ( input parParentProc ,
      780         input 'b-mark,b-sel',
      781         output v-rid-list
      782       ) no-error .
      783       if error-status :error then return .
      784     do while v-cnt <= num-entries (v-rid-list):
      785       assign
      786         v-cnt = v-cnt + 1
      787         .
      788       find first buf_goods no-lock where recid(buf_goods) = integer (entry (v-cnt, v-rid-list)) no-error .
      789       if error-status :error then do:
      790       next.
      791       end.
      792        run str/add-dlu.w
      793        (  input parParentProc ,
      794           input this-procedure  ,
      795           input 'ДОБАВЛЕНИЕ':U ,
      796           input  x_add-doc.doc-code ,
      797           input  buf_goods.gds-code ,
      798           input-output v-recid ,
      799           output       v-mode-exit )
      800           no-error .
      801           if error-status :error then do:
      802             message
      803               vss-workfile vss-revision vss-description skip
      804               error-status :get-message(1) skip
      805               return-value skip
      806               "Ошибка"
      807               view-as alert-box error
      808             .
      809             undo, return .
      810           end.
      811           if v-mode-exit <> "" then do:
      812                 find first buf_add-line exclusive-lock where recid ( buf_add-line ) = v-recid no-error .
      813                 if available buf_add-line then do:
      814                   if v-mode-exit = "stop-cycle" then do:
      815                       leave.
      816                   end.
      817                   if v-mode-exit = "cancel" then do:
      818                       next.
      819                   end.
      820                 end.
      821           end.
      822     end.
      823     OPEN QUERY BR-docsa FOR EACH x_add-line OF x_add-doc NO-LOCK,              EACH x_goods OF x_add-line NO-LOCK,              EACH x_gds-add-charges OF x_add-line NO-LOCK INDEXED-REPOSITION. .
      824     reposition BR-docsa to recid v-recid no-error .
      825     apply "entry" to BR-docsa  in frame Dialog-Frame .
      826     run redisp.
      827   END.
      828   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
      829   DO:
      830     IF NOT AVAILABLE  x_add-line THEN RETURN NO-APPLY.
      831     v-recid = recid (x_add-line) .
      832        run str/add-dlu.w
      833        (  input parParentProc ,
      834           input this-procedure  ,
      835           input 'ИЗМЕНЕНИЕ':U ,
      836           input  x_add-doc.doc-code ,
      837           input  x_add-line.gds-code ,
      838           input-output v-recid ,
      839           output       v-mode-exit )
      840           no-error .
      841           if error-status :error then do:
      842           message
      843             vss-workfile vss-revision vss-description skip
      844             error-status :get-message(1) skip
      845             return-value skip
      846             ""
      847             view-as alert-box error
      848           .
      849             undo, return .
      850           end.
      851     OPEN QUERY BR-docsa FOR EACH x_add-line OF x_add-doc NO-LOCK,              EACH x_goods OF x_add-line NO-LOCK,              EACH x_gds-add-charges OF x_add-line NO-LOCK INDEXED-REPOSITION. .
      852     reposition BR-docsa to recid v-recid no-error .
      853     apply "entry" to BR-docsa  in frame Dialog-Frame .
      854       run redisp.
      855   END.
      856   ON CHOOSE OF B-del IN FRAME Dialog-Frame
      857   DO:
      858     IF NOT AVAILABLE  x_add-line THEN RETURN NO-APPLY.
      859      message "Удалить запись ?"
      860         view-as alert-box question
      861         buttons yes-no
      862         update g-log as log.
      863     if g-log = false then return no-apply.
      864     find current x_add-line exclusive-lock   .
      865     delete x_add-line.
      866     OPEN QUERY BR-docsa FOR EACH x_add-line OF x_add-doc NO-LOCK,              EACH x_goods OF x_add-line NO-LOCK,              EACH x_gds-add-charges OF x_add-line NO-LOCK INDEXED-REPOSITION.
      867     OPEN QUERY BROWSE-7 FOR EACH x_add-trn OF x_add-doc NO-LOCK,              EACH x_trn-doc WHERE x_trn-doc.doc-code = x_add-trn.trn-doc-code NO-LOCK INDEXED-REPOSITION.
      868     apply "entry" to BR-docsa  in frame Dialog-Frame .
      869      run redisp.
      870   END.
      871   ON CHOOSE OF B-lkp IN FRAME Dialog-Frame
      872   DO:
      873   find current x_add-line no-lock no-error .
      874   IF NOT AVAILABLE  x_add-line THEN RETURN NO-APPLY.
      875     v-recid = recid (x_add-line) .
      876     run str/add-dlu.w
      877        (  input parParentProc ,
      878           input this-procedure  ,
      879           input 'ПРОСМОТР':U ,
      880           input  x_add-doc.doc-code ,
      881           input  x_add-line.gds-code ,
      882           input-output v-recid ,
      883           output       v-mode-exit )
      884           no-error .
      885           if error-status :error then do:
      886             undo, return .
      887           end.
      888     reposition BR-docsa to recid v-recid no-error .
      889     apply "entry" to BR-docsa  in frame Dialog-Frame .
      890   END.
      891   ON CHOOSE OF B-print IN FRAME Dialog-Frame
      892   DO:
      893     if not available x_add-doc then return .
      894     run rep/r-addu.p ( parparentproc, x_add-doc.doc-code ) .
      895   END.
      896   ON CHOOSE OF B-quit IN FRAME Dialog-Frame
      897   DO:
      898   if p-mode = 'ПРОСМОТР':U then return .
      899   define variable v-k as integer   no-undo .
      900     message "Вы действительно хотите отменить все изменения ?"
      901     view-as alert-box question
      902     button yes-no
      903     update v-ok as log
      904     .
      905     if v-ok = false then return no-apply.
      906     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      907         for each ub.add-line exclusive-lock where
      908                 ub.add-line.doc-code  = v-doc-code :
      909             delete ub.add-line .
      910         end.
      911         for each old_add-line where
      912               old_add-line.doc-code  = v-doc-code :
      913               create  ub.add-line .
      914               buffer-copy old_add-line to ub.add-line .
      915         end.
      916         p-recid = ?.
      917     end.
      918     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      919         for each ub.add-line exclusive-lock where
      920                 ub.add-line.doc-code  = v-doc-code :
      921             delete ub.add-line .
      922         end.
      923         for each ub.add-doc exclusive-lock where
      924                 ub.add-doc.doc-code  = v-doc-code :
      925             delete ub.add-doc .
      926         end.
      927     end.
      928   APPLY "END-ERROR":U TO SELF.
      929   END.
      930   ON CHOOSE OF B-trn IN FRAME Dialog-Frame
      931   DO:
      932     define buffer buf_trn-doc for ub.trn-doc  .
      933     define variable loc-ref-list as character no-undo .
      934     run str/all-docs.w
      935    ( input  parparentproc
      936    ,input   x_add-doc.host-code
      937    ,input   x_add-doc.obj-type
      938    ,input   x_add-doc.obj-code
      939    ,input  "status-all":U
      940    ,input  'накл':U
      941    ,input  'при':U
      942    ,input  ?
      943    ,input  no
      944    ,input  "b-sel":U
      945    ,input  'ie':U
      946    ,input  false
      947    ,input  ?
      948    ,output loc-ref-list
      949    ).
      950   if loc-ref-list = ?  or loc-ref-list = '' then return.
      951     find first   buf_trn-doc no-lock where recid(buf_trn-doc) = int(loc-ref-list) no-error .
      952     if error-status :error then return .
      953     define buffer buf_add-trn for ub.add-trn  .
      954     find first buf_add-trn where
      955       buf_add-trn.trn-doc-code = buf_trn-doc.doc-code
      956       no-error .
      957       if available buf_add-trn then do:
      958       message substitute(" Накладная &1 уже привязана к документу доп.расхода &2" , buf_trn-doc.doc-code , buf_add-trn.doc-code ) .
      959          return no-apply.
      960       end.
      961     find first x_add-trn where
      962       x_add-trn.trn-doc-code = buf_trn-doc.doc-code and
      963       x_add-trn.doc-code     = v-doc-code  no-error .
      964     if not available x_add-trn then do:
      965       create x_add-trn .
      966       assign
      967         x_add-trn.trn-doc-code = buf_trn-doc.doc-code
      968         x_add-trn.doc-code     = v-doc-code
      969       .
      970       release x_add-trn.
      971     end.
      972     else do:
      973      message substitute(" Накладная &1 уже привязана к документу доп.расхода" , buf_trn-doc.doc-code ) .
      974     end.
      975     OPEN QUERY BR-docsa FOR EACH x_add-line OF x_add-doc NO-LOCK,              EACH x_goods OF x_add-line NO-LOCK,              EACH x_gds-add-charges OF x_add-line NO-LOCK INDEXED-REPOSITION. .
      976     OPEN QUERY BROWSE-7 FOR EACH x_add-trn OF x_add-doc NO-LOCK,              EACH x_trn-doc WHERE x_trn-doc.doc-code = x_add-trn.trn-doc-code NO-LOCK INDEXED-REPOSITION.
      977   END.
      978   ON CHOOSE OF B-trn-del IN FRAME Dialog-Frame
      979   DO:
      980     if not available x_add-trn then return .
      981     find current x_add-trn exclusive-lock no-error .
      982     delete x_add-trn.
      983     OPEN QUERY BR-docsa FOR EACH x_add-line OF x_add-doc NO-LOCK,              EACH x_goods OF x_add-line NO-LOCK,              EACH x_gds-add-charges OF x_add-line NO-LOCK INDEXED-REPOSITION. .
      984     OPEN QUERY BROWSE-7 FOR EACH x_add-trn OF x_add-doc NO-LOCK,              EACH x_trn-doc WHERE x_trn-doc.doc-code = x_add-trn.trn-doc-code NO-LOCK INDEXED-REPOSITION.
      985   END.
      986   ON CHOOSE OF B-trn-sel IN FRAME Dialog-Frame
      987   DO:
      988       IF NOT AVAILABLE  x_add-trn THEN RETURN NO-APPLY.
      989       run str/showdoc.p
      990       ( input parparentproc
      991        ,input x_add-trn.trn-doc-code
      992        ,input ?
      993        ,input ?
      994        ,input ?
      995        ,input true
      996       ) .
      997   END.
      998   on leave of x_add-doc.base-rate  in frame Dialog-Frame or
      999      leave of x_add-doc.base-scale in frame Dialog-Frame do:
     1000     if input frame Dialog-Frame x_add-doc.base-rate  <> x_add-doc.base-rate  or
     1001        input frame Dialog-Frame x_add-doc.base-scale <> x_add-doc.base-scale then do:
     1002       run check-rate no-error.
     1003       if error-status :error then do:
     1004          message
     1005           "Ошибка при проверке курса" skip
     1006           return-value
     1007           view-as alert-box error.
     1008          return no-apply.
     1009       end.
     1010     end.
     1011   end.
     1012   on choose of r-acc in frame Dialog-Frame
     1013   do:
     1014     run choose-r-acc no-error.
     1015     if error-status :error then return no-apply.
     1016   end.
     1017   ON LEAVE OF x_add-doc.exch-code IN FRAME Dialog-Frame
     1018   or return of x_add-doc.exch-code in frame Dialog-Frame
     1019   do:
     1020     if input frame Dialog-Frame  x_add-doc.exch-code <> x_add-doc.exch-code then do:
     1021       run choice-currency in this-procedure no-error.
     1022       if error-status :error then do: return no-apply. end.
     1023       run update-rate-doc in this-procedure no-error.
     1024     end.
     1025   end.
     1026   ON LEAVE OF x_add-doc.exch-rate IN FRAME Dialog-Frame
     1027   or return of x_add-doc.exch-rate in frame Dialog-Frame
     1028   or leave, return of x_add-doc.exch-scale in frame Dialog-Frame
     1029   or leave, return of x_add-doc.base-rate  in frame Dialog-Frame
     1030   or leave, return of x_add-doc.base-scale in frame Dialog-Frame
     1031   do:
     1032     run update-rate-doc in this-procedure no-error.
     1033     if error-status :error then do:
     1034       run disp-exch in this-procedure.
     1035       return no-apply.
     1036     end.
     1037   end.
     1038   ON LEAVE OF x_add-doc.fact-date IN FRAME Dialog-Frame
     1039   DO:
     1040     run chk-upd-date in this-procedure .
     1041   END.
     1042   ON CHOOSE OF r-currency IN FRAME Dialog-Frame
     1043   DO:
     1044     run r-proc-currency in this-procedure.
     1045   END.
     1046   ON LEAVE OF x_add-doc.shift-date IN FRAME Dialog-Frame
     1047   do:
     1048     if input frame Dialog-Frame x_add-doc.shift-date <> x_add-doc.shift-date then do:
     1049       assign
     1050         x_add-doc.shift-name = ""
     1051         x_add-doc.shift-num  = 0.
     1052       display x_add-doc.shift-name x_add-doc.shift-num with frame Dialog-Frame.
     1053       apply "entry" to x_add-doc.shift-name in frame Dialog-Frame.
     1054       return no-apply.
     1055     end.
     1056   end.
     1057   on return of x_add-doc.shift-date in frame Dialog-Frame do:
     1058     apply "entry" to x_add-doc.shift-name in frame Dialog-Frame.
     1059     return no-apply.
     1060   end.
     1061   on return of x_add-doc.shift-name in frame Dialog-Frame do:
     1062     apply "entry" to b-add in frame Dialog-Frame.
     1063     return no-apply.
     1064   end.
     1065   on return of x_add-doc.shift-num in frame Dialog-Frame do:
     1066     apply "entry" to b-add in frame Dialog-Frame.
     1067     return no-apply.
     1068   end.
     1069   on choose of r-sht in frame Dialog-Frame do:
     1070     run proc-sht.
     1071   end.
     1072   on leave of x_add-doc.shift-num  in frame Dialog-Frame do:
     1073     run proc-shift-num no-error.
     1074     if error-status:error then do:
     1075       return no-apply.
     1076     end.
     1077   end.
     1078   on leave of x_add-doc.shift-name in frame Dialog-Frame do:
     1079     run proc-shift-name no-error.
     1080     if error-status:error then do:
     1081       return no-apply.
     1082     end.
     1083   end.
     1084   ON VALUE-CHANGED OF x_add-doc.VAT-type IN FRAME Dialog-Frame
     1085   DO:
     1086     assign x_add-doc.VAT-type.
     1087   END.
     1088   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1089   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1090   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1091   on ' ' of x_add-doc.doc-date in frame Dialog-Frame
     1092   do:
