     1596   on ctrl-b of x_add-doc.shift-date in frame Dialog-Frame
     1597   do:
     1598     if (can-query (self, "sensitive")
     1599        and
     1600        self :sensitive = true
     1601        )
     1602     or (can-query (self, "read-only")
     1603        and
     1604        self :read-only = false
     1605        )
     1606     then do:
     1607       if self :handle <> focus :handle
     1608       then do:
     1609         apply "entry":u to self .
     1610       end.
     1611       define variable v-curr-sv-date as date no-undo .
     1612       define variable v-new-sv-date  as date no-undo .
     1613       assign
     1614         v-curr-sv-date = date(self :screen-value) no-error
     1615       .
     1616       if v-curr-sv-date = ?
     1617       then do:
     1618         run gbl/getcurdt.p
     1619           (output v-curr-sv-date
     1620           ) .
     1621       end.
     1622       if v-curr-sv-date <> ?
     1623       then do:
     1624         assign
     1625           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1626         .
     1627         assign
     1628           self :screen-value = string(v-new-sv-date) .
     1629         .
     1630       end.
     1631     end.
     1632     return no-apply .
     1633   end.
     1634   on ctrl-e of x_add-doc.shift-date in frame Dialog-Frame
     1635   do:
     1636     if (can-query (self, "sensitive")
     1637        and
     1638        self :sensitive = true
     1639        )
     1640     or (can-query (self, "read-only")
     1641        and
     1642        self :read-only = false
     1643        )
     1644     then do:
     1645       if self :handle <> focus :handle
     1646       then do:
     1647         apply "entry":u to self .
     1648       end.
     1649       define variable v-curr-sv-date as date no-undo .
     1650       define variable v-new-sv-date  as date no-undo .
     1651       assign
     1652         v-curr-sv-date = date(self :screen-value) no-error
     1653       .
     1654       if v-curr-sv-date = ?
     1655       then do:
     1656         run gbl/getcurdt.p
     1657           (output v-curr-sv-date
     1658           ) .
     1659       end.
     1660       if v-curr-sv-date <> ?
     1661       then do:
     1662         run gbl/lastdate.p
     1663           (input  v-curr-sv-date
     1664           ,output v-new-sv-date
     1665           ).
     1666         assign
     1667           self :screen-value = string(v-new-sv-date) .
     1668         .
