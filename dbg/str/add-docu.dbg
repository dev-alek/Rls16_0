     1759   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1760   on help of frame Dialog-Frame
     1761   do:
     1762     run gbl/app_help.p
     1763       (input this-procedure :file-name
     1764       ,input ''
     1765       ,input ?
     1766       ) no-error.
     1767     if error-status :error then do:
     1768       message
     1769         "Ошибка при вызове помощи"
     1770         error-status :get-message(1)
     1771         view-as alert-box .
     1772     end.
     1773   end.
     1774   run minbtn-set in this-procedure .
     1775   on choose of b-help in frame Dialog-Frame
     1776   do:
     1777     apply "help":u to frame Dialog-Frame .
     1778   end.
     1779   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1780   procedure minbtn-set :
     1781       do
     1782           on error undo, return error return-value
     1783           :
     1784           define variable ii              as integer       no-undo .
     1785           define variable fh              as widget-handle no-undo .
     1786           define variable hh              as widget-handle no-undo .
     1787           define variable v-h             as handle        extent 4 no-undo .
     1788           define variable v-name-button   as character     no-undo .
     1789           define variable v-help-old-x    as decimal       no-undo .
     1790           define variable v-help-old-y    as decimal       no-undo .
     1791           define variable v-help-old-size as decimal       no-undo .
     1792           define variable v-frame-width   as decimal       no-undo .
     1793           define variable jj              as integer       no-undo .
     1794           do
     1795               on error undo, return error
     1796               :
     1797               assign
     1798                   v-frame-width = frame Dialog-Frame:width - 0.3
     1799                   fh            = frame Dialog-Frame:first-child
     1800                   hh            = fh:first-child
     1801                   ii            = 1
     1802                   .
     1803               do while valid-handle(hh):
     1804                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1805                   do:
     1806                       case lc(hh:name) :
     1807                           when "b-help" then
     1808                               do:
     1809                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1810                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1811                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1812                                   hh:TOOLTIP = "Помощь" .
     1813                                   v-help-old-x = hh:column .
     1814                                   v-help-old-y = hh:row    .
     1815                                   v-help-old-size = hh:width .
     1816                                   hh:width-chars = 2.5 .
     1817                               end.
     1818                           when "b-print" then
     1819                               do:
     1820                                   hh:load-image("cmp/b-print.bmp":u) .
     1821                                   hh:TOOLTIP = "Печать" .
     1822                                   v-h[ii] = hh:handle .
     1823                                   ii = ii + 1 .
     1824                                   hh:width-chars = 3 .
     1825                               end.
     1826                           when "b-history" or
     1827                           when "b-hist" then
     1828                               do:
     1829                                   hh:load-image("cmp/b-hist.bmp":u) .
     1830                                   hh:TOOLTIP = "История" .
     1831                                   v-h[ii] = hh:handle .
     1832                                   ii = ii + 1 .
     1833                                   hh:width-chars = 3 .
     1834                               end.
     1835                           when "b-sch" then
     1836                               do:
     1837                                   hh:load-image("cmp/b-sch.bmp":u) .
     1838                                   hh:TOOLTIP = "Установка Фильтра" .
     1839                                   v-h[ii] = hh:handle .
     1840                                   ii = ii + 1 .
     1841                                   hh:width-chars = 3 .
     1842                               end.
     1843                           when "b-hist-user" then
     1844                               do:
     1845                                   hh:load-image("cmp/b-hist.bmp":u) .
     1846                                   hh:TOOLTIP = "История пользователя" .
     1847                                   ii = ii + 1 .
     1848                               end.
     1849                       end case.
     1850                   end.
     1851                   hh = hh:next-sibling.
     1852               end.
     1853               b-help:column = v-frame-width - b-help:width-chars.
     1854               jj = 0.
     1855               repeat ii = 4 to 1 by -1 :
     1856                   if valid-handle (v-h[ii] ) then
     1857                   do:
     1858                       jj  = jj + 1 .
     1859                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1860                       v-h[ii]:row    = v-help-old-y .
     1861                   end.
     1862               end.
     1863           end.
     1864       end.
     1865   end procedure.
     1866   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1867   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1868   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1869   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1870   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1871   define variable v-diasize-current-frame-height as decimal   no-undo .
     1872   define variable v-diasize-change-size          as logical   no-undo .
     1873   define variable v-diasize-resize-button        as handle    no-undo .
     1874   define variable v-diasize-wndmax               as logical   no-undo .
     1875   define variable v-diasize-wndstore             as logical   no-undo .
     1876   define variable v-diasize-proc-name            as character no-undo .
     1877   define variable v-diasize-browse-handle        as handle    no-undo .
     1878   define variable v-diasize-browse-number        as integer   no-undo .
     1879   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1880   define temp-table temp-diasize-handle no-undo
     1881     field handle-value  as handle
     1882     field save-position as decimal
     1883     index xpk is primary unique handle-value
     1884     .
     1885   define temp-table temp-browse-handle no-undo
     1886     field browse-type   as character
     1887     field browse-number as integer
     1888     field browse-handle as handle
     1889     field original-size as decimal
     1890     index xpk is primary unique browse-type browse-number
     1891     index xie browse-type browse-handle
     1892   .
     1893   procedure diasize_change-height :
     1894     define input  parameter p-change-value  as decimal   no-undo .
     1895     define input  parameter p-move-resize   as logical   no-undo .
     1896     define variable v-field-group-handle    as handle    no-undo .
     1897     define variable v-object-handle         as handle    no-undo .
     1898     define variable v-frame-height          as decimal   no-undo .
     1899     define variable v-frame-virtual-height  as decimal   no-undo .
     1900     define variable v-browse-height         as decimal   no-undo .
     1901     define variable v-window-height         as decimal   no-undo .
     1902     define variable v-window-virtual-height as decimal   no-undo .
     1903     define variable v-change-sign           as integer   no-undo .
     1904     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1905     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1906     if p-change-value > 0
     1907     then do:
     1908       if frame Dialog-Frame :height + p-change-value
     1909           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1910       then do:
     1911         assign
     1912           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1913                           - (frame Dialog-Frame :height-chars)
     1914         .
     1915         if p-change-value <= 0
     1916         then do:
     1917           run diasize_position-resize-button in this-procedure .
     1918           return .
     1919         end.
     1920       end.
     1921     end.
     1922     if p-change-value < 0
     1923     then do:
     1924       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1925       then do:
     1926         assign
     1927           p-change-value = v-diasize-orig-frame-height
     1928                          - (frame Dialog-Frame :height-chars)
     1929         .
     1930         if p-change-value >= 0
     1931         then do:
     1932           run diasize_position-resize-button in this-procedure .
     1933           return .
     1934         end.
     1935       end.
     1936     end.
     1937     if p-change-value >= 0
     1938     then do:
     1939       assign
     1940         v-change-sign = 1
     1941       .
     1942     end.
     1943     else do:
     1944       assign
     1945         v-change-sign = -1
     1946       .
     1947     end.
     1948     assign
     1949       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1950     .
     1951     if p-change-value = 0
     1952     then do:
     1953       run diasize_position-resize-button in this-procedure .
     1954       return .
     1955     end.
     1956     move_block:
     1957     do
     1958     on error undo move_block, retry move_block
     1959     :
     1960       if retry
     1961       then do:
     1962         do
     1963         on error undo move_block, leave move_block
     1964         :
     1965           if p-change-value > 0
     1966           then do:
     1967             for each buf_temp-diasize-handle
     1968             on error undo, next
     1969             :
     1970               assign
     1971                 v-object-handle = buf_temp-diasize-handle.handle-value
     1972               .
     1973               if v-object-handle <> v-diasize-resize-button
     1974               then do:
     1975                 assign
     1976                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1977                 .
     1978               end.
     1979             end.
     1980             assign
     1981               v-diasize-browse-handle :height = v-browse-height
     1982             .
     1983             for each buf_temp-browse-handle
     1984               where buf_temp-browse-handle.browse-type = 'height':u
     1985             on error undo, next
     1986             :
     1987               assign
     1988                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1989               .
     1990             end.
     1991             assign
     1992               frame Dialog-Frame :height = v-frame-height
     1993             .
     1994             if frame Dialog-Frame :scrollable = true
     1995             then do:
     1996               assign
     1997                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1998               .
     1999             end.
     2000             run diasize_position-resize-button in this-procedure .
     2001           end.
     2002           else do:
     2003             if frame Dialog-Frame :scrollable = true
     2004             then do:
     2005               assign
     2006                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2007               .
     2008             end.
     2009             assign
     2010               frame Dialog-Frame :height = v-frame-height
     2011             .
     2012             assign
     2013               v-diasize-browse-handle :height = v-browse-height
     2014             .
     2015             for each buf_temp-browse-handle
     2016               where buf_temp-browse-handle.browse-type = 'height':u
     2017             on error undo, next
     2018             :
     2019               assign
     2020                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2021               .
     2022             end.
     2023             for each buf_temp-diasize-handle
     2024             on error undo, next
     2025             :
     2026               assign
     2027                 v-object-handle = buf_temp-diasize-handle.handle-value
     2028               .
     2029               if v-object-handle <> v-diasize-resize-button
     2030               then do:
     2031                 assign
     2032                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2033                 .
     2034               end.
     2035             end.
     2036             run diasize_position-resize-button in this-procedure .
     2037           end.
     2038           assign
     2039             v-diasize-change-size = false
     2040           .
     2041           leave move_block .
     2042         end.
     2043       end.
     2044       assign
     2045         v-diasize-need-full-display = true
     2046       .
     2047       if v-diasize-change-size = false
     2048       then do:
     2049         assign
     2050           v-diasize-change-size = true
     2051         .
     2052       end.
     2053       else do:
     2054         return .
     2055       end.
     2056       assign
     2057         v-frame-height = frame Dialog-Frame :height
     2058         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2059         v-browse-height = v-diasize-browse-handle :height
     2060       .
     2061       for each buf_temp-browse-handle
     2062         where buf_temp-browse-handle.browse-type = 'height':u
     2063       :
     2064         assign
     2065           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2066         .
     2067       end.
     2068       for each buf_temp-diasize-handle
     2069       :
     2070         delete buf_temp-diasize-handle .
     2071       end.
     2072       assign
     2073         v-field-group-handle = frame Dialog-Frame :first-child
     2074       .
     2075       do while valid-handle(v-field-group-handle)
     2076       :
     2077         assign
     2078           v-object-handle = v-field-group-handle :first-child
     2079         .
     2080         do while valid-handle(v-object-handle)
     2081         :
     2082           if  v-object-handle <> v-diasize-browse-handle :handle
     2083           and can-query(v-object-handle, "row")
     2084           and can-query(v-object-handle, "height")
     2085           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2086           then do:
     2087             find first buf_temp-browse-handle
     2088               where buf_temp-browse-handle.browse-type   = 'height':u
     2089                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2090               no-error .
     2091             if available buf_temp-browse-handle
     2092             then do:
     2093             end.
     2094             else do:
     2095               create buf_temp-diasize-handle .
     2096               assign
     2097                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2098                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2099               .
     2100             end.
     2101           end.
     2102           assign
     2103             v-object-handle = v-object-handle :next-sibling
     2104           .
     2105         end.
     2106         assign
     2107           v-field-group-handle = v-field-group-handle :next-sibling
     2108         .
     2109       end.
     2110       do with frame Dialog-Frame
     2111       :
     2112         hide v-diasize-resize-button .
     2113         assign
     2114           v-diasize-resize-button :row    = 1
     2115           v-diasize-resize-button :column = 1
     2116         .
     2117       end.
     2118       if p-change-value > 0
     2119       then do:
     2120         if frame Dialog-Frame :scrollable = true
     2121         then do:
     2122           assign
     2123             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2124             no-error .
     2125           if error-status :error
     2126           or error-status :get-message(1) <> ""
     2127           then do:
     2128             undo move_block, retry move_block .
     2129           end.
     2130         end.
     2131         assign
     2132           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2133           no-error .
     2134         if error-status :error
     2135         or error-status :get-message(1) <> ""
     2136         then do:
     2137           undo move_block, retry move_block .
     2138         end.
     2139         assign
     2140           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2141           no-error .
     2142         if error-status :error
     2143         or error-status :get-message(1) <> ""
     2144         then do:
     2145           undo move_block, retry move_block .
     2146         end.
     2147         for each buf_temp-browse-handle
     2148           where buf_temp-browse-handle.browse-type = 'height':u
     2149         on error undo move_block, retry move_block
     2150         :
     2151           assign
     2152             buf_temp-browse-handle.browse-handle :height
     2153               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2154             no-error .
     2155           if error-status :error
     2156           or error-status :get-message(1) <> ""
     2157           then do:
     2158             undo move_block, retry move_block .
     2159           end.
     2160         end.
     2161         for each buf_temp-diasize-handle
     2162         on error undo move_block, retry move_block
     2163         :
     2164           assign
     2165             v-object-handle = buf_temp-diasize-handle.handle-value
     2166           .
     2167           if v-object-handle <> v-diasize-resize-button
     2168           then do:
     2169             assign
     2170               v-object-handle :row = v-object-handle :row + p-change-value
     2171               no-error .
     2172             if error-status :error
     2173             or error-status :get-message(1) <> ""
     2174             then do:
     2175               undo move_block, retry move_block .
     2176             end.
     2177           end.
     2178         end.
     2179       end.
     2180       else do:
     2181         for each buf_temp-diasize-handle
     2182         on error undo move_block, retry move_block
     2183         :
     2184           assign
     2185             v-object-handle = buf_temp-diasize-handle.handle-value
     2186           .
     2187           if v-object-handle <> v-diasize-resize-button
     2188           then do:
     2189             assign
     2190               v-object-handle :row = v-object-handle :row + p-change-value
     2191               no-error .
     2192             if error-status :error
     2193             or error-status :get-message(1) <> ""
     2194             then do:
     2195               undo move_block, retry move_block .
     2196             end.
     2197           end.
     2198         end.
     2199         assign
     2200           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2201           no-error .
     2202         if error-status :error
     2203         or error-status :get-message(1) <> ""
     2204         then do:
     2205           undo move_block, retry move_block .
     2206         end.
     2207         for each buf_temp-browse-handle
     2208           where buf_temp-browse-handle.browse-type = 'height':u
     2209         on error undo move_block, retry move_block
     2210         :
     2211           assign
     2212             buf_temp-browse-handle.browse-handle :height
     2213               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2214             no-error .
     2215           if error-status :error
     2216           or error-status :get-message(1) <> ""
     2217           then do:
     2218             undo move_block, retry move_block .
     2219           end.
     2220         end.
     2221         assign
     2222           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2223           no-error .
     2224         if error-status :error
     2225         or error-status :get-message(1) <> ""
     2226         then do:
     2227           undo move_block, retry move_block .
     2228         end.
     2229         if frame Dialog-Frame :scrollable = true
     2230         then do:
     2231           assign
     2232             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2233             no-error .
     2234           if error-status :error
     2235           or error-status :get-message(1) <> ""
     2236           then do:
     2237             undo move_block, retry move_block .
     2238           end.
     2239         end.
     2240       end.
     2241       if p-move-resize = true
     2242       then do:
     2243         run diasize_position-resize-button in this-procedure .
     2244       end.
     2245       if v-diasize-wndstore = true
     2246       then do:
     2247         if connected("ub") = true
     2248         then do:
     2249           define variable v-cntxt-db-num        as integer   no-undo .
     2250           define variable v-cntxt-userid        as character no-undo .
     2251           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2252                                             , OUTPUT v-cntxt-userid
     2253                                             ) .
     2254           run gbl/wndsizew.p
     2255             (input  v-cntxt-db-num
     2256             ,input  v-cntxt-userid
     2257             ,input  v-diasize-proc-name
     2258             ,input  'height':u
     2259             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2260             ) .
     2261         end.
     2262       end.
     2263     end.
     2264     assign
     2265       v-diasize-change-size = false
     2266     .
     2267   end procedure.
     2268   procedure diasize_set-height :
     2269     define input  parameter p-new-height  as decimal   no-undo .
     2270     define input  parameter p-move-resize as logical   no-undo .
     2271     do
     2272     on error undo, return error return-value
     2273     :
     2274       run diasize_change-height in this-procedure
     2275         (input  (p-new-height - frame Dialog-Frame :height)
     2276         ,input  p-move-resize
     2277         ) .
     2278     end.
     2279   end procedure.
     2280   procedure diasize_change-width :
     2281     define input  parameter p-change-value as decimal   no-undo .
     2282     define input  parameter p-move-resize  as logical   no-undo .
     2283     define variable v-field-group-handle   as handle    no-undo .
     2284     define variable v-object-handle        as handle    no-undo .
     2285     define variable v-frame-width          as decimal   no-undo .
     2286     define variable v-frame-virtual-width  as decimal   no-undo .
     2287     define variable v-browse-width         as decimal   no-undo .
     2288     define variable v-window-width         as decimal   no-undo .
     2289     define variable v-window-virtual-width as decimal   no-undo .
     2290     define variable v-change-sign          as integer   no-undo .
     2291     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2292     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2293     if p-change-value > 0
     2294     then do:
     2295       if frame Dialog-Frame :width + p-change-value >
     2296           session :width-chars
     2297       then do:
     2298         assign
     2299           p-change-value = session :width-chars - frame Dialog-Frame :width
     2300         .
     2301         if p-change-value <= 0
     2302         then do:
     2303           run diasize_position-resize-button in this-procedure .
     2304           return .
     2305         end.
     2306       end.
     2307     end.
     2308     if p-change-value < 0
     2309     then do:
     2310       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2311       then do:
     2312         assign
     2313           p-change-value = v-diasize-orig-frame-width
     2314                          - frame Dialog-Frame :width
     2315         .
     2316         if p-change-value >= 0
     2317         then do:
     2318           run diasize_position-resize-button in this-procedure .
     2319           return .
     2320         end.
     2321       end.
     2322     end.
     2323     if p-change-value >= 0
     2324     then do:
     2325       assign
     2326         v-change-sign = 1
     2327       .
     2328     end.
     2329     else do:
     2330       assign
     2331         v-change-sign = -1
     2332       .
     2333     end.
     2334     assign
     2335       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2336     .
     2337     if p-change-value = 0
     2338     then do:
     2339       run diasize_position-resize-button in this-procedure .
     2340       return .
     2341     end.
     2342     move_block:
     2343     do
     2344     on error undo move_block, leave move_block
     2345     :
     2346       if retry
     2347       then do:
     2348         do
     2349         on error undo move_block, leave move_block
     2350         :
     2351           if p-change-value > 0
     2352           then do:
     2353             for each buf_temp-diasize-handle
     2354             on error undo, next
     2355             :
     2356               assign
     2357                 v-object-handle = buf_temp-diasize-handle.handle-value
     2358               .
     2359               if v-object-handle <> v-diasize-resize-button
     2360               then do:
     2361                 assign
     2362                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2363                 .
     2364               end.
     2365             end.
     2366             assign
     2367               v-diasize-browse-handle :width = v-browse-width
     2368             .
     2369             for each buf_temp-browse-handle
     2370               where buf_temp-browse-handle.browse-type = 'width':u
     2371             on error undo, next
     2372             :
     2373               assign
     2374                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2375               .
     2376             end.
     2377             assign
     2378               frame Dialog-Frame :width = v-frame-width
     2379             .
     2380             if frame Dialog-Frame :scrollable = true
     2381             then do:
     2382               assign
     2383                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2384               .
     2385             end.
     2386             run diasize_position-resize-button in this-procedure .
     2387           end.
     2388           else do:
     2389             if frame Dialog-Frame :scrollable = true
     2390             then do:
     2391               assign
     2392                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2393               .
     2394             end.
     2395             assign
     2396               frame Dialog-Frame :width = v-frame-width
     2397             .
     2398             for each buf_temp-browse-handle
     2399               where buf_temp-browse-handle.browse-type = 'width':u
     2400             on error undo, next
     2401             :
     2402               assign
     2403                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2404               .
     2405             end.
     2406             assign
     2407               v-diasize-browse-handle :width = v-browse-width
     2408             .
     2409             for each buf_temp-diasize-handle
     2410             on error undo, next
     2411             :
     2412               assign
     2413                 v-object-handle = buf_temp-diasize-handle.handle-value
     2414               .
     2415               if v-object-handle <> v-diasize-resize-button
     2416               then do:
     2417                 assign
     2418                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2419                 .
     2420               end.
     2421             end.
     2422             run diasize_position-resize-button in this-procedure .
     2423           end.
     2424           assign
     2425             v-diasize-change-size = false
     2426           .
     2427           leave move_block .
     2428         end.
     2429       end.
     2430       assign
     2431         v-diasize-need-full-display = true
     2432       .
     2433       if v-diasize-change-size = false
     2434       then do:
     2435         assign
     2436           v-diasize-change-size = true
     2437         .
     2438       end.
     2439       else do:
     2440         return .
     2441       end.
     2442       assign
     2443         v-frame-width = frame Dialog-Frame :width
     2444         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2445         v-browse-width = v-diasize-browse-handle :width
     2446       .
     2447       for each buf_temp-browse-handle
     2448         where buf_temp-browse-handle.browse-type = 'width':u
     2449       :
     2450         assign
     2451           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2452         .
     2453       end.
     2454       for each buf_temp-diasize-handle
     2455       :
     2456         delete buf_temp-diasize-handle .
     2457       end.
     2458       assign
     2459         v-field-group-handle = frame Dialog-Frame :first-child
     2460       .
     2461       do while valid-handle(v-field-group-handle)
     2462       :
     2463         assign
     2464           v-object-handle = v-field-group-handle :first-child
     2465         .
     2466         do while valid-handle(v-object-handle)
     2467         :
     2468           if  v-object-handle <> v-diasize-browse-handle :handle
     2469           and v-object-handle <> v-diasize-resize-button
     2470           and can-query(v-object-handle, "row")
     2471           and can-query(v-object-handle, "height")
     2472           and ( v-object-handle :col + v-object-handle :width
     2473                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2474               )
     2475           then do:
     2476             find first buf_temp-browse-handle
     2477               where buf_temp-browse-handle.browse-type   = 'width':u
     2478                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2479               no-error .
     2480             if available buf_temp-browse-handle
     2481             then do:
     2482             end.
     2483             else do:
     2484               create buf_temp-diasize-handle .
     2485               assign
     2486                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2487                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2488               .
     2489             end.
     2490           end.
     2491           assign
     2492             v-object-handle = v-object-handle :next-sibling
     2493           .
     2494         end.
     2495         assign
     2496           v-field-group-handle = v-field-group-handle :next-sibling
     2497         .
     2498       end.
     2499       do with frame Dialog-Frame
     2500       :
     2501         hide v-diasize-resize-button .
     2502         v-diasize-resize-button :row = 1.
     2503         v-diasize-resize-button :column = 1.
     2504       end.
     2505       if p-change-value > 0
     2506       then do:
     2507         if frame Dialog-Frame :scrollable = true
     2508         then do:
     2509           assign
     2510             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2511             no-error .
     2512           if error-status :error
     2513           or error-status :get-message(1) <> ""
     2514           then do:
     2515             undo move_block, retry move_block.
     2516           end.
     2517         end.
     2518         assign
     2519           frame Dialog-Frame :width = v-frame-width + p-change-value
     2520           no-error .
     2521         if error-status :error
     2522         or error-status :get-message(1) <> ""
     2523         then do:
     2524           undo move_block, retry move_block.
     2525         end.
     2526         assign
     2527           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2528         no-error .
     2529         if error-status :error
     2530         or error-status :get-message(1) <> ""
     2531         then do:
     2532           undo move_block, retry move_block.
     2533         end.
     2534         for each buf_temp-browse-handle
     2535           where buf_temp-browse-handle.browse-type = 'width':u
     2536         on error undo move_block, retry move_block
     2537         :
     2538           assign
     2539             buf_temp-browse-handle.browse-handle :width
     2540               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2541             no-error .
     2542           if error-status :error
     2543           or error-status :get-message(1) <> ""
     2544           then do:
     2545             undo move_block, retry move_block .
     2546           end.
     2547         end.
     2548         for each buf_temp-diasize-handle
     2549         on error undo move_block, retry move_block
     2550         :
     2551           assign
     2552             v-object-handle = buf_temp-diasize-handle.handle-value
     2553           .
     2554           if v-object-handle <> v-diasize-resize-button
     2555           then do:
     2556             assign
     2557               v-object-handle :col = v-object-handle :col + p-change-value
     2558               no-error .
     2559             if error-status :error
     2560             or error-status :get-message(1) <> ""
     2561             then do:
     2562               undo move_block, retry move_block .
     2563             end.
     2564           end.
     2565         end.
     2566       end.
     2567       else do:
     2568         for each buf_temp-diasize-handle
     2569         on error undo move_block, retry move_block
     2570         :
     2571           assign
     2572             v-object-handle = buf_temp-diasize-handle.handle-value
     2573           .
     2574           if v-object-handle <> v-diasize-resize-button
     2575           then do:
     2576             assign
     2577               v-object-handle :col = v-object-handle :col + p-change-value
     2578               no-error .
     2579             if error-status :error
     2580             or error-status :get-message(1) <> ""
     2581             then do:
     2582               undo move_block, retry move_block .
     2583             end.
     2584           end.
     2585         end.
     2586         for each buf_temp-browse-handle
     2587           where buf_temp-browse-handle.browse-type = 'width':u
     2588         on error undo move_block, retry move_block
     2589         :
     2590           assign
     2591             buf_temp-browse-handle.browse-handle :width
     2592               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2593             no-error .
     2594           if error-status :error
     2595           or error-status :get-message(1) <> ""
     2596           then do:
     2597             undo move_block, retry move_block .
     2598           end.
     2599         end.
     2600         assign
     2601           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2602           no-error .
     2603         if error-status :error
     2604         or error-status :get-message(1) <> ""
     2605         then do:
     2606           undo move_block, retry move_block.
     2607         end.
     2608         assign
     2609           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2610         no-error .
     2611         if error-status :error
     2612         or error-status :get-message(1) <> ""
     2613         then do:
     2614           undo move_block, retry move_block.
     2615         end.
     2616         if frame Dialog-Frame :scrollable = true
     2617         then do:
     2618           assign
     2619             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2620           no-error .
     2621           if error-status :error
     2622           or error-status :get-message(1) <> ""
     2623           then do:
     2624             undo move_block, retry move_block.
     2625           end.
     2626         end.
     2627       end.
     2628       if p-move-resize
     2629       then do:
     2630         run diasize_position-resize-button in this-procedure .
     2631       end.
     2632       if v-diasize-wndstore = true
     2633       then do:
     2634         if connected("ub") = true
     2635         then do:
     2636           define variable v-cntxt-db-num        as integer   no-undo .
     2637           define variable v-cntxt-userid        as character no-undo .
     2638           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2639                                             , OUTPUT v-cntxt-userid
     2640                                             ) .
     2641           run gbl/wndsizew.p
     2642             (input  v-cntxt-db-num
     2643             ,input  v-cntxt-userid
     2644             ,input  v-diasize-proc-name
     2645             ,input  'width':u
     2646             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2647             ) .
     2648         end.
     2649       end.
     2650     end.
     2651     assign
     2652       v-diasize-change-size = false
     2653     .
     2654   end procedure.
     2655   procedure diasize_set-width :
     2656     define input  parameter p-new-width  as decimal   no-undo .
     2657     define input  parameter p-move-resize as logical   no-undo .
     2658     do
     2659     on error undo, return error return-value
     2660     :
     2661       run diasize_change-width in this-procedure
     2662         (input  (p-new-width - frame Dialog-Frame :width)
     2663         ,input  p-move-resize
     2664         ) .
     2665     end.
     2666   end procedure.
     2667   procedure diasize_position-resize-button :
     2668     do with frame Dialog-Frame
     2669     :
     2670       hide v-diasize-resize-button .
     2671       assign
     2672         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2673                     - 1
     2674                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2675         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2676                     - 1
     2677                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2678       .
     2679       view v-diasize-resize-button .
     2680     end.
     2681   end procedure.
     2682   on alt-right anywhere
     2683   do:
     2684     run diasize_change-width in this-procedure
     2685       (input 1
     2686       ,input true
     2687       ) .
     2688     return no-apply .
     2689   end.
     2690   on alt-left anywhere
     2691   do:
     2692     run diasize_change-width in this-procedure
     2693       (input -1
     2694       ,input true
     2695       ) .
     2696     return no-apply .
     2697   end.
     2698   on alt-down anywhere
     2699   do:
     2700     run diasize_change-height in this-procedure
     2701       (input 1
     2702       ,input true
     2703       ) .
     2704     return no-apply .
     2705   end.
     2706   on alt-up anywhere
     2707   do:
     2708     run diasize_change-height in this-procedure
     2709       (input -1
     2710       ,input true
     2711       ) .
     2712     return no-apply .
     2713   end.
     2714   on alt-enter of frame Dialog-Frame
     2715   do:
     2716     run diasize_maximize in this-procedure
     2717       (input  ?
     2718       ).
     2719     return no-apply .
     2720   end.
     2721   procedure diasize_end-move :
     2722     do
     2723     on error undo, return error return-value
     2724     :
     2725       define variable v-row-delta as decimal   no-undo .
     2726       define variable v-col-delta as decimal   no-undo .
     2727       define variable v-new-row as decimal   no-undo .
     2728       define variable v-new-col as decimal   no-undo .
     2729       assign
     2730         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2731         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2732       .
     2733       assign
     2734         v-row-delta = v-new-row - frame Dialog-Frame :height
     2735         v-col-delta = v-new-col - frame Dialog-Frame :width
     2736       .
     2737       run diasize_change-height in this-procedure
     2738         (input v-row-delta
     2739         ,input true
     2740         ) .
     2741       run diasize_change-width in this-procedure
     2742         (input v-col-delta
     2743         ,input true
     2744         ) .
     2745     end.
     2746   end procedure.
     2747   procedure diasize_maximize :
     2748     define input  parameter p-action as logical   no-undo .
     2749     do
     2750     on error undo, return error return-value
     2751     :
     2752       if p-action = ?
     2753       then do:
     2754         if v-diasize-need-maximize = true
     2755         then do:
     2756           assign
     2757             p-action = true
     2758           .
     2759         end.
     2760         else do:
     2761           assign
     2762             p-action = false
     2763           .
     2764         end.
     2765       end.
     2766       if p-action = true
     2767       then do:
     2768         run diasize_change-height in this-procedure
     2769           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2770               - frame Dialog-Frame :height-chars
     2771           ,input true
     2772           ) .
     2773         run diasize_change-width in this-procedure
     2774           (input session :width-chars
     2775               - frame Dialog-Frame :width-chars
     2776           ,input true
     2777           ) .
     2778         assign
     2779           v-diasize-need-maximize = false
     2780         .
     2781       end.
     2782       else do:
     2783         run diasize_change-width in this-procedure
     2784           (input v-diasize-orig-frame-width
     2785               - frame Dialog-Frame :width-chars
     2786           ,input true
     2787           ) .
     2788         run diasize_change-height in this-procedure
     2789           (input v-diasize-orig-frame-height
     2790               - frame Dialog-Frame :height-chars
     2791           ,input true
     2792           ) .
     2793         assign
     2794           v-diasize-need-maximize = true
     2795         .
     2796       end.
     2797     end.
     2798   end procedure.
     2799   procedure diasize_restore-orig-size :
     2800     do
     2801     on error undo, return error return-value
     2802     :
     2803       assign
     2804         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2805         v-diasize-current-frame-height = frame Dialog-Frame :height
     2806       .
     2807       run diasize_set-height in this-procedure
     2808         (input  v-diasize-orig-frame-height
     2809         ,input  true
     2810         ) .
     2811       run diasize_set-width in this-procedure
     2812         (input  v-diasize-orig-frame-width
     2813         ,input  true
     2814         ) .
     2815     end.
     2816   end procedure.
     2817   procedure diasize_restore-current-size :
     2818     do
     2819     on error undo, return error return-value
     2820     :
     2821       run diasize_set-height in this-procedure
     2822         (input  v-diasize-current-frame-height
     2823         ,input  true
     2824         ) .
     2825       run diasize_set-width in this-procedure
     2826         (input  v-diasize-current-frame-width
     2827         ,input  true
     2828         ) .
     2829     end.
     2830   end procedure.
     2831   procedure diasize_set-browse-handle :
     2832     define input  parameter p-browse-handle as handle   no-undo .
     2833     define buffer buf_temp-browse-handle for temp-browse-handle .
     2834     do
     2835     on error undo, return error return-value
     2836     :
     2837       assign
     2838         v-diasize-browse-handle = p-browse-handle
     2839       .
     2840       for each buf_temp-browse-handle
     2841       on error undo, return error return-value
     2842       :
     2843         delete buf_temp-browse-handle .
     2844       end.
     2845     end.
     2846   end procedure.
     2847   procedure diasize_add_browse :
     2848     define input  parameter p-browse-type   as character no-undo .
     2849     define input  parameter p-browse-handle as handle    no-undo .
     2850     define buffer buf_temp-browse-handle for temp-browse-handle .
     2851     do
     2852     on error undo, return error return-value
     2853     :
     2854       assign
     2855         v-diasize-browse-number = v-diasize-browse-number + 1
     2856       .
     2857       create buf_temp-browse-handle .
     2858       assign
     2859         buf_temp-browse-handle.browse-type   = p-browse-type
     2860         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2861         buf_temp-browse-handle.browse-handle = p-browse-handle
     2862       .
     2863     end.
     2864   end procedure.
     2865   procedure diasize_init :
     2866     define variable v-default-value    as logical   no-undo .
     2867     define variable v-restore-saved    as logical   no-undo .
     2868     define variable v-resize-value-str as character no-undo .
     2869     do
     2870     on error undo, return error return-value
     2871     :
     2872       do with frame Dialog-Frame
     2873       :
     2874         assign
     2875           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2876           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2877           v-diasize-browse-handle     = browse BR-docsa :handle
     2878         .
     2879         create button v-diasize-resize-button
     2880         assign
     2881           parent        = frame Dialog-Frame :first-child
     2882           label         = "s"
     2883           height-pixels = 16
     2884           width-pixels  = 16
     2885           visible       = true
     2886           sensitive     = true
     2887           movable       = true
     2888           triggers:
     2889             on end-move persistent run diasize_end-move in this-procedure .
     2890           end triggers.
     2891         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2892         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2893         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2894         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2895         assign
     2896           v-diasize-wndmax = false
     2897         .
     2898         if connected("ub") = true
     2899         then do:
     2900           define variable v-cntxt-db-num        as integer   no-undo .
     2901           define variable v-cntxt-userid        as character no-undo .
     2902           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2903                                             , OUTPUT v-cntxt-userid
     2904                                             ) .
     2905           run gbl/wndpar_r.p
     2906             (input  v-cntxt-db-num
     2907             ,input  v-cntxt-userid
     2908             ,input  'wndmax':U
     2909             ,output v-diasize-wndmax
     2910             ,output v-default-value
     2911             ) .
     2912         end.
     2913         assign
     2914           v-diasize-wndstore = false
     2915         .
     2916         if connected("ub") = true
     2917         then do:
     2918           run gbl/wndpar_r.p
     2919             (input  v-cntxt-db-num
     2920             ,input  v-cntxt-userid
     2921             ,input  'wndstore':U
     2922             ,output v-diasize-wndstore
     2923             ,output v-default-value
     2924             ) .
     2925         end.
     2926         assign
     2927           v-diasize-proc-name = entry(1, program-name(2), '.')
     2928         .
     2929         if v-diasize-wndstore = true
     2930         then do:
     2931           assign
     2932             v-restore-saved = false
     2933           .
     2934           if connected("ub") = true
     2935           then do:
     2936             run gbl/wndsizer.p
     2937               (input  v-cntxt-db-num
     2938               ,input  v-cntxt-userid
     2939               ,input  v-diasize-proc-name
     2940               ,input  'height':u
     2941               ,output v-resize-value-str
     2942               ) .
     2943             if v-resize-value-str <> '':U
     2944             then do:
     2945               run diasize_change-height in this-procedure
     2946                 (input  integer(v-resize-value-str)
     2947                 ,input  true
     2948                 ) .
     2949               assign
     2950                 v-restore-saved = true
     2951               .
     2952             end.
     2953           end.
     2954           if connected("ub") = true
     2955           then do:
     2956             run gbl/wndsizer.p
     2957               (input  v-cntxt-db-num
     2958               ,input  v-cntxt-userid
     2959               ,input  v-diasize-proc-name
     2960               ,input  'width':u
     2961               ,output v-resize-value-str
     2962               ) .
     2963             if v-resize-value-str <> '':U
     2964             then do:
     2965               run diasize_change-width in this-procedure
     2966                 (input  integer(v-resize-value-str)
     2967                 ,input  true
     2968                 ) .
     2969               assign
     2970                 v-restore-saved = true
     2971               .
     2972             end.
     2973           end.
     2974           if v-restore-saved <> true
     2975           then do:
     2976             if v-diasize-wndmax = true
     2977             then do:
     2978               run diasize_maximize in this-procedure
     2979                 (input  true
     2980                 ) .
     2981             end.
     2982           end.
     2983         end.
     2984         else do:
     2985           if v-diasize-wndmax = true
     2986           then do:
     2987             run diasize_maximize in this-procedure
     2988               (input  true
     2989               ) .
     2990           end.
     2991         end.
     2992       end.
     2993     end.
     2994   end procedure.
     2995   procedure diasize_need-full-display :
     2996     define output parameter p-need-full-display as logical   no-undo .
     2997     do
     2998     on error undo, return error return-value
     2999     :
     3000       assign
     3001         p-need-full-display = v-diasize-need-full-display
     3002       .
     3003       assign
     3004         v-diasize-need-full-display = false
     3005       .
     3006     end.
     3007   end procedure.
     3008   procedure get-context :
     3009      define output parameter p-db-num as integer          no-undo.
     3010      define output parameter p-user-id as character        no-undo.
     3011      define variable v-login               as character    no-undo.
     3012      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3013      define buffer buf_user-login  for ub.user-login .
     3014      do
     3015      on error undo, return error
     3016      :
     3017            FIND FIRST buf_sys-ctrl no-lock.
     3018            ASSIGN
     3019               v-login = USERID("ub")
     3020               p-db-num = buf_sys-ctrl.db-num
     3021            .
     3022            FIND FIRST buf_user-login
     3023                 WHERE buf_user-login.db-num = p-db-num
     3024                   AND buf_user-login.user-login = v-login
     3025                 no-lock
     3026                 no-error
     3027                 .
     3028            IF AVAILABLE buf_user-login
     3029            THEN DO:
     3030               assign
     3031                  p-user-id = buf_user-login.user-id
     3032               .
     3033            END.
     3034      end.
     3035   end procedure.
     3036       run diasize_init in this-procedure .
     3037   MAIN-BLOCK:
     3038   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3039      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3040   define variable curclivalue      as character no-undo .
     3041   define variable curclitype       as character no-undo .
     3042   define variable base-abbr as character no-undo .
     3043   define variable exch-abbr as character no-undo .
     3044   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3045   empty temp-table thbjattr_thbj-attr.
     3046   run adm/shattri.p (
     3047      input "get":U
     3048     ,input v-cntxt-obj-type
     3049     ,input v-cntxt-obj-code
     3050     ,input 'nakl-glob':U
     3051     ,input  ""
     3052     ,output v-value-character
     3053     ,output v-value-date
     3054     ,output v-value-decimal
     3055     ,output v-value-integer
     3056     ,output v-value-logical
     3057     ,output par-type
     3058     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     3059     ) no-error .
     3060   for each thbjattr_thbj-attr :
     3061       if thbjattr_thbj-attr.prop-code = 'curcli'   then curclivalue   = string (thbjattr_thbj-attr.property-value-logical) .
     3062   end.
     3063   x_goods.gds-name:resizable in browse BR-docsa   = true .
     3064   x_goods.gds-name:width     in browse BR-docsa   = 15 .
     3065   define variable varbase-code as integer no-undo.
     3066   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3067   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     3068     (input  v-cntxt-host-code-obj
     3069     ,output varbase-code
     3070     )  .
     3071   run init-proc in this-procedure .
     3072   run  get-var-2 in this-procedure
     3073       ( output base-abbr
     3074          ) .
     3075   x_add-doc.sum-base:label in frame Dialog-Frame  = "Сумма,"  + base-abbr .
     3076   x_add-doc.sum-rubl:label in frame Dialog-Frame  = "Сумма,руб"  .
     3077     if p-mode = 'ПРОСМОТР':U
     3078        then run enable_lkp in this-procedure .
     3079        else run enable_my  in this-procedure .
     3080     disable x_add-doc.VAT-type
     3081     r-currency
     3082     x_add-doc.exch-code
     3083     with frame Dialog-Frame .
     3084     WAIT-FOR GO OF FRAME Dialog-Frame.
     3085   END.
     3086   run disable_ui in this-procedure .
     3087   PROCEDURE check-exch :
     3088       x_add-doc.exch-date  = today .
     3089       x_add-doc.exch-code = 0 .
     3090     find currency where currency.curr-code = x_add-doc.exch-code  no-lock no-error.
     3091     if not available currency then do:
     3092       message "Неправильная валюта  - такой валюты нет.".
     3093       apply "entry" to x_add-doc.exch-code in frame Dialog-Frame.
     3094       return error.
     3095     end.
     3096     if x_add-doc.exch-code <> currency.curr-code then do:
     3097       if currency.curr-code = 0 then do:
     3098         if (x_add-doc.exch-rate <> ? and x_add-doc.exch-scale <> ? and
     3099             (x_add-doc.exch-rate <> 1 or x_add-doc.exch-scale <> 1)) then do:
     3100         end.
     3101         assign
     3102           x_add-doc.exch-rate = 1
     3103           x_add-doc.exch-scale = 1.
     3104         disable x_add-doc.exch-rate x_add-doc.exch-scale r-acc with frame Dialog-Frame.
     3105       end.
     3106       else do:
     3107         find last curr-accnt where curr-accnt.curr-code = currency.curr-code
     3108                                and curr-accnt.exch-date <= input x_add-doc.exch-date use-index pi no-lock no-error.
     3109         if available curr-accnt then do:
     3110           assign
     3111             x_add-doc.exch-rate = curr-accnt.exch-rate
     3112             x_add-doc.exch-scale = curr-accnt.exch-scale.
     3113         end.
     3114         else do:
     3115           assign
     3116             x_add-doc.exch-rate = ?
     3117             x_add-doc.exch-scale = ?.
     3118         end.
     3119         if x_add-doc.exch-code = 0 and
     3120           (x_add-doc.exch-rate  <> ? and
     3121            x_add-doc.exch-scale <> ? and
     3122            (x_add-doc.exch-rate <> 1 or x_add-doc.exch-scale <> 1)
     3123           ) then do:
     3124         end.
     3125         enable x_add-doc.exch-rate x_add-doc.exch-scale r-acc with frame Dialog-Frame.
     3126       end.
     3127       assign
     3128         x_add-doc.exch-code = currency.curr-code.
     3129     end.
     3130   END PROCEDURE.
     3131   PROCEDURE check-rate :
     3132   define variable flag-recount as logical initial no no-undo.
     3133   if
     3134      input frame Dialog-Frame x_add-doc.base-rate  <> x_add-doc.base-rate  or
     3135      input frame Dialog-Frame x_add-doc.base-scale <> x_add-doc.base-scale then flag-recount = yes.
     3136   if input frame Dialog-Frame x_add-doc.base-rate = ? or
     3137      input frame Dialog-Frame x_add-doc.base-rate = 0 then do:
     3138     message "Не задан курс базовой валюты.".
     3139     apply "entry" to x_add-doc.base-rate in frame Dialog-Frame.
     3140     return error.
     3141   end.
     3142   if input frame Dialog-Frame x_add-doc.base-scale = ? or
     3143      input frame Dialog-Frame x_add-doc.base-scale = 0 then do:
     3144     message "Не задан масштаб базовой валюты.".
     3145     apply "entry" to x_add-doc.base-scale in frame Dialog-Frame.
     3146     return error.
     3147   end.
     3148   assign frame Dialog-Frame
     3149     x_add-doc.base-rate
     3150     x_add-doc.base-scale.
     3151   run waitfram-show in this-procedure  ("ЖДИТЕ.  Пересчет документа ...").
     3152   if flag-recount then do:
     3153      run full-recount.
     3154   end.
     3155   run waitfram-hide in this-procedure  .
     3156   END PROCEDURE.
     3157   PROCEDURE check-update :
     3158   END PROCEDURE.
     3159   PROCEDURE chk-upd-date :
     3160   END PROCEDURE.
     3161   PROCEDURE choice-currency :
     3162   find currency where currency.curr-code = input frame Dialog-Frame x_add-doc.exch-code no-error.
     3163   if not available currency then do:
     3164     run ref/currency.w ( input parparentproc, input "b-sel", input-output ref-rec ).
     3165     if ref-rec = ? then do: return error. end.
     3166     find currency where recid ( currency ) = ref-rec.
     3167   end.
     3168   RUN exch-rate in this-procedure.
     3169   END PROCEDURE.
     3170   PROCEDURE choose-r-acc :
     3171   define variable v-today      as date    no-undo.
     3172   run check-update no-error.
     3173   if error-status :error then return error.
     3174   run check-exch no-error.
     3175   if error-status :error then return error.
     3176   define variable varlog as logical   no-undo .
     3177   varlog = yes.
     3178   message "Подставить БИРЖЕВЫЕ курсы базовой валюты и валюты документа :"
     3179           currency.curr-abbr "на дату растаможивания ?"
     3180   view-as alert-box question buttons OK-Cancel update varlog.
     3181   if varlog <> true then do:
     3182     return error.
     3183   end.
     3184   find last curr-accnt where curr-accnt.curr-code = varbase-code and
     3185                            curr-accnt.exch-date <= input frame Dialog-Frame x_add-doc.exch-date use-index pi no-lock no-error.
     3186   if not available curr-accnt then do:
     3187     message "На эту дату неизвестен курс базовой валюты.".
     3188     apply "entry" to x_add-doc.base-rate in frame Dialog-Frame.
     3189     return error.
     3190   end.
     3191   disp curr-accnt.exch-rate  @ x_add-doc.base-rate
     3192        curr-accnt.exch-scale @ x_add-doc.base-scale with frame Dialog-Frame.
     3193   run check-rate.
     3194   find last curr-accnt where curr-accnt.curr-code = input x_add-doc.exch-code
     3195             and curr-accnt.exch-date <= input x_add-doc.exch-date use-index pi no-lock no-error.
     3196   if not available curr-accnt then do:
     3197     message "На дату " + input x_add-doc.exch-date + " неизвестен курс валюты поставщика.".
     3198     apply "entry" to x_add-doc.exch-rate.
     3199     return error.
     3200   end.
     3201   display curr-accnt.exch-rate  @ x_add-doc.exch-rate
     3202           curr-accnt.exch-scale @ x_add-doc.exch-scale with frame Dialog-Frame.
     3203   run check-rate.
     3204   END PROCEDURE.
     3205   PROCEDURE disable_UI :
     3206     HIDE FRAME Dialog-Frame.
     3207   END PROCEDURE.
     3208   PROCEDURE disp-exch :
     3209   END PROCEDURE.
     3210   PROCEDURE enable_lkp :
     3211     OPEN QUERY Dialog-Frame FOR EACH x_add-doc SHARE-LOCK.
     3212     GET FIRST Dialog-Frame.
     3213     DISPLAY v-obj-name  f-summa f-vat
     3214         WITH FRAME Dialog-Frame.
     3215     IF AVAILABLE x_add-doc THEN
     3216       DISPLAY x_add-doc.base-rate x_add-doc.base-scale
     3217             x_add-doc.doc-date x_add-doc.fact-date x_add-doc.shift-date
     3218             x_add-doc.shift-name x_add-doc.shift-num x_add-doc.VAT-type
     3219             x_add-doc.obj-type x_add-doc.obj-code x_add-doc.doc-code
     3220             x_add-doc.sum-base x_add-doc.VAT-base x_add-doc.sum-rubl
     3221             x_add-doc.VAT-rubl
     3222         WITH FRAME Dialog-Frame.
     3223     VIEW FRAME Dialog-Frame.
     3224     hide B-exit in frame Dialog-Frame .
     3225     enable B-trn-sel B-quit B-lkp BROWSE-7 BR-docsa b-help B-print with frame Dialog-Frame .
     3226     B-quit:label = "Выход" .
     3227     B-quit:column = 1 .
     3228     OPEN QUERY BR-docsa FOR EACH x_add-line OF x_add-doc NO-LOCK,              EACH x_goods OF x_add-line NO-LOCK,              EACH x_gds-add-charges OF x_add-line NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-7 FOR EACH x_add-trn OF x_add-doc NO-LOCK,              EACH x_trn-doc WHERE x_trn-doc.doc-code = x_add-trn.trn-doc-code NO-LOCK INDEXED-REPOSITION.
     3229   END PROCEDURE.
     3230   PROCEDURE enable_my :
     3231     OPEN QUERY Dialog-Frame FOR EACH x_add-doc SHARE-LOCK.
     3232     GET FIRST Dialog-Frame.
     3233     DISPLAY v-obj-name  f-summa f-vat
     3234         WITH FRAME Dialog-Frame.
     3235     IF AVAILABLE x_add-doc THEN
     3236       DISPLAY
     3237             x_add-doc.base-rate x_add-doc.base-scale
     3238             x_add-doc.doc-date x_add-doc.fact-date x_add-doc.shift-date
     3239             x_add-doc.shift-name x_add-doc.shift-num x_add-doc.VAT-type
     3240             x_add-doc.obj-type x_add-doc.obj-code x_add-doc.doc-code
     3241             x_add-doc.sum-base x_add-doc.VAT-base x_add-doc.sum-rubl
     3242             x_add-doc.VAT-rubl
     3243         WITH FRAME Dialog-Frame.
     3244     ENABLE B-exit B-quit B-Help B-trn B-trn-del B-trn-sel
     3245    BROWSE-7
     3246            x_add-doc.base-rate x_add-doc.base-scale
     3247            x_add-doc.doc-date x_add-doc.VAT-type
     3248            B-add B-lkp B-chg B-del BR-docsa  f-summa f-vat
     3249            B-print
     3250         WITH FRAME Dialog-Frame.
     3251     VIEW FRAME Dialog-Frame.
     3252     OPEN QUERY BR-docsa FOR EACH x_add-line OF x_add-doc NO-LOCK,              EACH x_goods OF x_add-line NO-LOCK,              EACH x_gds-add-charges OF x_add-line NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-7 FOR EACH x_add-trn OF x_add-doc NO-LOCK,              EACH x_trn-doc WHERE x_trn-doc.doc-code = x_add-trn.trn-doc-code NO-LOCK INDEXED-REPOSITION.
     3253     if curclivalue <> "no" then do:
     3254         if  x_add-doc.exch-code <> 0 then do:
     3255           enable r-acc x_add-doc.exch-rate x_add-doc.exch-scale with frame Dialog-Frame.
     3256         end.
     3257     end.
     3258     else do:
     3259       hide r-acc r-currency in frame Dialog-Frame.
     3260     end.
     3261     if x_add-doc.exch-rate = 1 and  x_add-doc.exch-scale = 1 then
     3262        disable x_add-doc.exch-rate x_add-doc.exch-scale r-acc with frame Dialog-Frame.
     3263     define variable l-shift-on as logical no-undo .
     3264   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3265   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3266     (input  v-cntxt-obj-type
     3267     ,input  v-cntxt-obj-code
     3268     ,input  'shift-on=request'
     3269     ,output l-shift-on
     3270     )  .
     3271     if l-shift-on = false then hide
     3272        x_add-doc.shift-date
     3273        x_add-doc.shift-num
     3274        x_add-doc.shift-name
     3275        r-sht in frame Dialog-Frame .
     3276      if varbase-code = 0 then disable x_add-doc.base-rate x_add-doc.base-scale with frame Dialog-Frame .
     3277   END PROCEDURE.
     3278   PROCEDURE enable_UI :
     3279     OPEN QUERY Dialog-Frame FOR EACH x_add-doc SHARE-LOCK.
     3280     GET FIRST Dialog-Frame.
     3281     DISPLAY v-obj-name f-summa f-vat
     3282         WITH FRAME Dialog-Frame.
     3283     IF AVAILABLE x_add-doc THEN
     3284       DISPLAY x_add-doc.base-rate x_add-doc.base-scale x_add-doc.doc-date
     3285             x_add-doc.fact-date x_add-doc.shift-date x_add-doc.shift-name
     3286             x_add-doc.shift-num x_add-doc.VAT-type x_add-doc.obj-type
     3287             x_add-doc.obj-code x_add-doc.doc-code x_add-doc.sum-base
     3288             x_add-doc.VAT-base x_add-doc.sum-rubl x_add-doc.VAT-rubl
     3289         WITH FRAME Dialog-Frame.
     3290     ENABLE B-exit B-quit B-print B-Help B-trn B-trn-del B-trn-sel BROWSE-7
     3291            x_add-doc.base-rate x_add-doc.base-scale x_add-doc.doc-date
     3292            x_add-doc.fact-date x_add-doc.shift-date x_add-doc.shift-name
     3293            x_add-doc.shift-num r-sht x_add-doc.VAT-type B-add B-lkp B-chg B-del
     3294            BR-docsa x_add-doc.obj-type f-summa f-vat
     3295         WITH FRAME Dialog-Frame.
     3296     VIEW FRAME Dialog-Frame.
     3297     OPEN QUERY BR-docsa FOR EACH x_add-line OF x_add-doc NO-LOCK,              EACH x_goods OF x_add-line NO-LOCK,              EACH x_gds-add-charges OF x_add-line NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-7 FOR EACH x_add-trn OF x_add-doc NO-LOCK,              EACH x_trn-doc WHERE x_trn-doc.doc-code = x_add-trn.trn-doc-code NO-LOCK INDEXED-REPOSITION.
     3298   END PROCEDURE.
     3299   PROCEDURE exch-rate :
     3300   display currency.curr-code @ x_add-doc.exch-code with frame Dialog-Frame.
     3301   do transaction on error   undo, return error :
     3302      run check-exch   in this-procedure.
     3303      run check-rate   in this-procedure.
     3304      run full-recount in this-procedure.
     3305   end.
     3306   END PROCEDURE.
     3307   PROCEDURE f-curr :
     3308     define variable   vdoc-date   as date no-undo .
     3309     define variable vexch-rate  as decimal   no-undo .
     3310     define variable vexch-scale as decimal   no-undo .
     3311     assign
     3312     vdoc-date    =    x_add-doc.doc-date
     3313     vexch-rate   =    x_add-doc.exch-rate
     3314     vexch-scale  =    x_add-doc.exch-scale
     3315     .
     3316   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3317   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     3318     (input  x_add-doc.exch-code
     3319     ,input  vdoc-date
     3320     ,output vexch-rate
     3321     ,output vexch-scale
     3322     ,output scr-curr-abbr
     3323     )  .
     3324   END PROCEDURE.
     3325   PROCEDURE full-recount :
     3326   for each x_add-line exclusive-lock  where
     3327              x_add-line.doc-code = x_add-doc.doc-code
     3328              :
     3329              x_add-line.sum-base = x_add-line.sum-rubl / x_add-doc.base-rate * x_add-doc.base-scale.
     3330              x_add-line.vat-base = x_add-line.vat-rubl / x_add-doc.base-rate * x_add-doc.base-scale.
     3331     end.
     3332   END PROCEDURE.
     3333   PROCEDURE get-var :
     3334   define output parameter pbase-rate  as decimal   no-undo .
     3335   define output parameter pbase-scale as decimal   no-undo .
     3336   define output parameter pvat-type   as character no-undo .
     3337   find first  x_add-doc.
     3338   assign frame Dialog-Frame
     3339   x_add-doc.base-rate x_add-doc.base-scale x_add-doc.doc-date x_add-doc.fact-date x_add-doc.shift-date x_add-doc.shift-name x_add-doc.shift-num x_add-doc.VAT-type x_add-doc.obj-type
     3340   .
     3341   assign
     3342   pbase-rate  = x_add-doc.base-rate
     3343   pbase-scale = x_add-doc.base-scale
     3344   pvat-type   = x_add-doc.vat-type
     3345   .
     3346   END PROCEDURE.
     3347   PROCEDURE get-var-2 :
     3348   define output parameter base-code-abbr as character no-undo .
     3349   define variable v-base-code    as integer   no-undo .
     3350   define variable vv-exch-rate   as decimal   no-undo .
     3351   define variable vv-exch-scale  as integer   no-undo .
     3352   find first  x_add-doc .
     3353   assign frame Dialog-Frame
     3354   x_add-doc.base-rate x_add-doc.base-scale x_add-doc.doc-date x_add-doc.fact-date x_add-doc.shift-date x_add-doc.shift-name x_add-doc.shift-num x_add-doc.VAT-type x_add-doc.obj-type
     3355   .
     3356   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3357   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     3358     (input  x_add-doc.host-code
     3359     ,output v-base-code
     3360     )  .
     3361   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3362   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     3363     (input  v-base-code
     3364     ,input  today
     3365     ,output vv-exch-rate
     3366     ,output vv-exch-scale
     3367     ,output base-code-abbr
     3368     )  .
     3369   END PROCEDURE.
     3370   PROCEDURE init-proc :
     3371   x_add-doc.VAT-type:LIST-ITEMS in frame Dialog-Frame =  'нет':U + "," + 'в т. ч.':U + "," + 'без':U .
     3372   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     3373      run doc-code in this-procedure (
     3374        input   "main":u
     3375       ,input   v-cntxt-obj-type
     3376       ,input   v-cntxt-obj-code
     3377       ,input   ""
     3378       ,output  v-doc-code ) .
     3379      if p-doc-code <> "" then do:
     3380         message "Из накладной" view-as alert-box information .
     3381           create x_add-trn .
     3382           assign
     3383             x_add-trn.trn-doc-code = p-doc-code
     3384             x_add-trn.doc-code     = v-doc-code
     3385           .
     3386         release x_add-trn.
     3387      end.
     3388      create x_add-doc.
     3389      assign
     3390        x_add-doc.doc-code   = v-doc-code
     3391        x_add-doc.doc-date   = today
     3392        x_add-doc.exch-code  = 0
     3393        x_add-doc.exch-date  = x_add-doc.doc-date
     3394        x_add-doc.host-code  = v-cntxt-host-code-obj
     3395        x_add-doc.obj-code   = v-cntxt-obj-code
     3396        x_add-doc.obj-type   = v-cntxt-obj-type
     3397        x_add-doc.status_    = 'новый':U
     3398        x_add-doc.cr-db-num  = v-cntxt-db-num
     3399        x_add-doc.creid      = v-cntxt-userid
     3400        x_add-doc.doc-type   = 'при':U
     3401      .
     3402   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3403   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     3404     (input  x_add-doc.host-code
     3405     ,input  x_add-doc.doc-date
     3406     ,output x_add-doc.base-rate
     3407     ,output x_add-doc.base-scale
     3408     )  .
     3409   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3410   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     3411     (input  x_add-doc.exch-code
     3412     ,input  x_add-doc.doc-date
     3413     ,output x_add-doc.exch-rate
     3414     ,output x_add-doc.exch-scale
     3415     ,output v-curr-abbr
     3416     )  .
     3417     define variable l-shift-on as logical no-undo .
     3418   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3419   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3420     (input  v-cntxt-obj-type
     3421     ,input  v-cntxt-obj-code
     3422     ,input  'shift-on=request'
     3423     ,output l-shift-on
     3424     )  .
     3425     if l-shift-on = true then do:
     3426   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3427   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     3428     (input  v-cntxt-obj-type
     3429     ,input  v-cntxt-obj-code
     3430     ,output x_add-doc.shift-date
     3431     ,output x_add-doc.shift-num
     3432     ,output x_add-doc.shift-name
     3433     )  .
     3434     end.
     3435     run adm/shattri.p (
     3436         input "get":U
     3437         ,input v-cntxt-obj-type
     3438         ,input v-cntxt-obj-code
     3439         ,input 'nakl_par':U
     3440         ,input  "type-vat"
     3441         ,output v-value-character
     3442         ,output v-value-date
     3443         ,output v-value-decimal
     3444         ,output varvat-type
     3445         ,output v-value-logical
     3446         ,output varvat-type-type
     3447         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     3448         ) no-error .
     3449         if error-status :error then varvat-type = 1 .
     3450       case varvat-type:
     3451       when 1 or when ? then do:
     3452         assign
     3453           x_add-doc.vat-type = 'в т. ч.':U.
     3454       end.
     3455       when 2 then do:
     3456         assign
     3457           x_add-doc.vat-type = 'нет':U.
     3458       end.
     3459       when 3 then do:
     3460          assign
     3461           x_add-doc.vat-type = 'без':U.
     3462       end.
     3463       otherwise do:
     3464         message "Не верно задан атрибут 'Тип заведения НДС' (type-vat)."
     3465                 "Задано значение: " varvat-type
     3466                 "Допустимые значения: 1,2,3."
     3467         view-as alert-box error.
     3468         return error.
     3469       end.
     3470       end case.
     3471   end.
     3472   else do:
     3473      if p-mode = 'ПРОСМОТР':U then find first ub.add-doc no-lock where recid(ub.add-doc) = p-recid no-error .
     3474         else  find first ub.add-doc exclusive-lock where recid(ub.add-doc) = p-recid no-error .
     3475      if error-status :error then do:
     3476         message
     3477           vss-workfile vss-revision vss-description skip
     3478           error-status :get-message(1) skip
     3479           return-value skip
     3480           "Ошибка"
     3481           view-as alert-box error
     3482         .
     3483         return .
     3484      end.
     3485      create x_add-doc.
     3486      buffer-copy ub.add-doc to x_add-doc .
     3487      v-doc-code = ub.add-doc.doc-code .
     3488   end.
     3489   if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     3490    for each ub.add-line where
     3491             ub.add-line.doc-code  = v-doc-code :
     3492     create  old_add-line .
     3493     buffer-copy ub.add-line to old_add-line .
     3494    end.
     3495   end.
     3496   define buffer obj_clients for ub.clients  .
     3497   find first obj_clients no-lock where
     3498              obj_clients.obj-code = v-cntxt-obj-code and
     3499              obj_clients.obj-type = v-cntxt-obj-type  .
     3500   v-obj-name = obj_clients.obj-name .
     3501   display v-obj-name with frame Dialog-Frame .
     3502   run f-curr in this-procedure .
     3503   OPEN QUERY BROWSE-7 FOR EACH x_add-trn OF x_add-doc NO-LOCK,              EACH x_trn-doc WHERE x_trn-doc.doc-code = x_add-trn.trn-doc-code NO-LOCK INDEXED-REPOSITION.
     3504   END PROCEDURE.
     3505   PROCEDURE proc-save :
     3506   define variable v-sum-rubl as decimal   no-undo .
     3507   define variable v-sum-base as decimal   no-undo .
     3508   define variable v-vat-rubl as decimal   no-undo .
     3509   define variable v-vat-base as decimal   no-undo .
     3510     assign frame Dialog-Frame
     3511       x_add-doc.base-rate x_add-doc.base-scale x_add-doc.doc-date x_add-doc.fact-date x_add-doc.shift-date x_add-doc.shift-name x_add-doc.shift-num x_add-doc.VAT-type x_add-doc.obj-type
     3512     .
     3513     assign
     3514       v-sum-rubl = 0
     3515       v-sum-base = 0
     3516       v-vat-rubl = 0
     3517       v-vat-base = 0
     3518     .
     3519   define variable v-kol-l as integer   no-undo .
     3520    v-kol-l = 0 .
     3521     for each x_add-line no-lock  where
     3522              x_add-line.doc-code = x_add-doc.doc-code
     3523              :
     3524         assign
     3525           v-sum-rubl = v-sum-rubl + x_add-line.sum-rubl
     3526           v-sum-base = v-sum-base + x_add-line.sum-base
     3527           v-vat-rubl = v-vat-rubl + x_add-line.vat-rubl
     3528           v-vat-base = v-vat-base + x_add-line.vat-base
     3529           v-kol-l = v-kol-l + 1
     3530           .
     3531     end.
     3532     for EACH x_trn-doc no-lock  WHERE x_trn-doc.doc-code = x_add-trn.trn-doc-code :
     3533           v-kol-l = v-kol-l + 1 .
     3534     end.
     3535     if v-kol-l = 0 then do:
     3536        p-recid = ? .
     3537        message  "Документ не содержит ни одной строки и ни одной связки с ПН , ДопРасход будет удален !"  view-as alert-box information .
     3538        delete x_add-doc .
     3539        return.
     3540     end.
     3541     assign
     3542       x_add-doc.sum-rubl = v-sum-rubl
     3543       x_add-doc.sum-base = v-sum-base
     3544       x_add-doc.vat-rubl = v-vat-rubl
     3545       x_add-doc.vat-base = v-vat-base
     3546     .
     3547     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     3548       create ub.add-doc.
     3549     end.
     3550     buffer-copy x_add-doc to ub.add-doc .
     3551     p-recid = recid (ub.add-doc) .
     3552   END PROCEDURE.
     3553   PROCEDURE proc-shift-num :
     3554   define buffer bf_shift-obj   for ub.shift-obj.
     3555     if input frame Dialog-Frame x_add-doc.shift-num <> x_add-doc.shift-num then do:
     3556       if input frame Dialog-Frame x_add-doc.shift-date <> ? then do:
     3557         find first bf_shift-obj where bf_shift-obj.obj-type   = x_add-doc.obj-type                             and
     3558                                       bf_shift-obj.obj-code   = x_add-doc.obj-code                             and
     3559                                       bf_shift-obj.shift-date = input frame Dialog-Frame x_add-doc.shift-date and
     3560                                       bf_shift-obj.shift-num  = input frame Dialog-Frame x_add-doc.shift-num  no-lock no-error.
     3561         if not available bf_shift-obj then do:
     3562           message "Не найдена смена: " x_add-doc.obj-type " " x_add-doc.obj-code
     3563                   " Дата " input frame Dialog-Frame x_add-doc.shift-date " Порядок смены " input frame Dialog-Frame x_add-doc.shift-num " ."
     3564           view-as alert-box error.
     3565           display x_add-doc.shift-num with frame Dialog-Frame.
     3566           run proc-sht no-error.
     3567           if error-status:error then do:
     3568             return error.
     3569           end.
     3570         end.
     3571         else do:
     3572           assign
     3573             x_add-doc.shift-date = bf_shift-obj.shift-date
     3574             x_add-doc.shift-num  = bf_shift-obj.shift-num
     3575             x_add-doc.shift-name = bf_shift-obj.shift-name.
     3576           display x_add-doc.shift-date x_add-doc.shift-num x_add-doc.shift-name with frame Dialog-Frame.
     3577           if x_add-doc.fact-date = ? then do:
     3578             assign
     3579               x_add-doc.fact-date = x_add-doc.shift-date
     3580               x_add-doc.fact-time = (24 * 60 * 60).
     3581             display x_add-doc.fact-date with frame Dialog-Frame.
     3582           end.
     3583         end.
     3584       end.
     3585     end.
     3586   end procedure.
     3587   procedure proc-shift-name :
     3588     define buffer bf_shift-obj   for ub.shift-obj.
     3589     define variable varfind-shift as integer initial 0.
     3590     define variable varshift-date like ub.shift-obj.shift-date no-undo.
     3591     define variable varshift-num  like ub.shift-obj.shift-num  no-undo.
     3592     if input frame Dialog-Frame x_add-doc.shift-name <> x_add-doc.shift-name then do:
     3593       if input frame Dialog-Frame x_add-doc.shift-date <> ? then do:
     3594         for each  bf_shift-obj where bf_shift-obj.obj-type   = x_add-doc.obj-type                             and
     3595                                      bf_shift-obj.obj-code   = x_add-doc.obj-code                             and
     3596                                      bf_shift-obj.shift-date = input frame Dialog-Frame x_add-doc.shift-date and
     3597                                      bf_shift-obj.shift-name = input frame Dialog-Frame x_add-doc.shift-name no-lock on error undo, return error return-value :
     3598           assign
     3599             varfind-shift = varfind-shift + 1
     3600             varshift-date = bf_shift-obj.shift-date
     3601             varshift-num  = bf_shift-obj.shift-num.
     3602         end.
     3603         if varfind-shift = 0 or varfind-shift > 1 then do:
     3604           if varfind-shift = 0 then do:
     3605             message "Не найдена смена: " x_add-doc.obj-type " " x_add-doc.obj-code
     3606                     " Дата " input frame Dialog-Frame x_add-doc.shift-date " Номер смены " input frame Dialog-Frame x_add-doc.shift-name " ."
     3607             view-as alert-box error.
     3608           end.
     3609           else do:
     3610             message "Найдено более одной смены с одним номером в сменном дне. Объект: " x_add-doc.obj-type " " x_add-doc.obj-code
     3611                     " Дата " input frame Dialog-Frame x_add-doc.shift-date " Номер смены " input frame Dialog-Frame x_add-doc.shift-name " ."
     3612             view-as alert-box error.
     3613           end.
     3614           display x_add-doc.shift-name with frame Dialog-Frame.
     3615           run proc-sht no-error.
     3616           if error-status:error then do: return error. end.
     3617         end.
     3618         else do:
     3619           assign frame Dialog-Frame
     3620             x_add-doc.shift-name.
     3621           assign
     3622             x_add-doc.shift-date = varshift-date
     3623             x_add-doc.shift-num  = varshift-num.
     3624           display x_add-doc.shift-date x_add-doc.shift-num x_add-doc.shift-name with frame Dialog-Frame.
     3625           if x_add-doc.fact-date = ? then do: assign x_add-doc.fact-date = x_add-doc.shift-date x_add-doc.fact-time = (24 * 60 * 60). display x_add-doc.fact-date with frame Dialog-Frame. end.
     3626         end.
     3627       end.
     3628     end.
     3629   end procedure.
     3630   PROCEDURE proc-sht :
     3631   define buffer bf_shift-obj   for ub.shift-obj.
     3632     define variable varrid-list as character no-undo.
     3633     define variable varrecid    as recid     no-undo.
     3634     assign
     3635       varrid-list = "".
     3636     run str/sht-all.w (parparentproc, v-cntxt-obj-type, v-cntxt-obj-code, 'b-sel', 'obj', x_add-doc.obj-type, x_add-doc.obj-code ,'':u, input-output varrid-list) no-error.
     3637     if error-status:error or varrid-list = "":u then do:
     3638       return error.
     3639     end.
     3640     else do:
     3641       assign
     3642         varrecid = integer (entry(1, varrid-list)).
     3643       find first bf_shift-obj where recid(bf_shift-obj) = varrecid no-lock no-error.
     3644       if available bf_shift-obj then do:
     3645         assign
     3646           x_add-doc.shift-date = bf_shift-obj.shift-date
     3647           x_add-doc.shift-num  = bf_shift-obj.shift-num
     3648           x_add-doc.shift-name = bf_shift-obj.shift-name.
     3649         display x_add-doc.shift-date x_add-doc.shift-num x_add-doc.shift-name with frame Dialog-Frame.
     3650         if x_add-doc.fact-date = ? then do:
     3651           assign
     3652             x_add-doc.fact-date = x_add-doc.shift-date
     3653             x_add-doc.fact-time = (24 * 60 * 60).
     3654           display x_add-doc.fact-date with frame Dialog-Frame.
     3655         end.
     3656       end.
     3657     end.
     3658   END PROCEDURE.
     3659   PROCEDURE r-proc-currency :
     3660   run ref/currency.w ( input parparentproc, input "b-sel", input-output ref-rec ).
     3661     if ref-rec = ? then do:
     3662        return no-apply.
     3663     end.
     3664     find ub.currency no-lock where recid( ub.currency ) = ref-rec no-error.
     3665     if not available ub.currency then do:
     3666        return no-apply.
     3667     end.
     3668     if ub.currency.curr-code <> x_add-doc.exch-code then do:
     3669      display ub.currency.curr-code @ x_add-doc.exch-code with frame Dialog-Frame .
     3670     end.
     3671     RUN exch-rate    in this-procedure.
     3672     RUN full-recount in this-procedure.
     3673   END PROCEDURE.
     3674   PROCEDURE redisp :
     3675   define variable v-sum-rubl as decimal   no-undo .
     3676   define variable v-sum-base as decimal   no-undo .
     3677   define variable v-vat-rubl as decimal   no-undo .
     3678   define variable v-vat-base as decimal   no-undo .
     3679     assign
     3680       v-sum-rubl = 0
     3681       v-sum-base = 0
     3682       v-vat-rubl = 0
     3683       v-vat-base = 0
     3684     .
     3685     for each x_add-line no-lock  where
     3686              x_add-line.doc-code = x_add-doc.doc-code
     3687              :
     3688         assign
     3689           v-sum-rubl = v-sum-rubl + x_add-line.sum-rubl
     3690           v-sum-base = v-sum-base + x_add-line.sum-base
     3691           v-vat-rubl = v-vat-rubl + x_add-line.vat-rubl
     3692           v-vat-base = v-vat-base + x_add-line.vat-base
     3693           .
     3694     end.
     3695    display v-sum-rubl @ x_add-doc.sum-rubl
     3696            v-sum-base @ x_add-doc.sum-base
     3697            v-vat-rubl @ x_add-doc.vat-rubl
     3698            v-vat-base @ x_add-doc.vat-base
     3699            with frame Dialog-Frame .
     3700   END PROCEDURE.
     3701   PROCEDURE update-rate-doc :
     3702   if input frame Dialog-Frame x_add-doc.exch-rate  <> x_add-doc.exch-rate  or
     3703      input frame Dialog-Frame x_add-doc.exch-scale <> x_add-doc.exch-scale or
     3704      input frame Dialog-Frame x_add-doc.base-rate  <> x_add-doc.base-rate  or
     3705      input frame Dialog-Frame x_add-doc.base-scale <> x_add-doc.base-scale then
     3706      do transaction on error undo, return error return-value :
     3707        run check-exch   in this-procedure no-error.
     3708        if error-status :error then do: return error return-value. end.
     3709        run check-update in this-procedure no-error.
     3710        if error-status :error then do: return error return-value. end.
     3711        run check-rate   in this-procedure no-error.
     3712        if error-status :error then do: return error return-value. end.
     3713       end.
     3714   END PROCEDURE.
