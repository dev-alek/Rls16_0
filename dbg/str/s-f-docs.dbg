     1808   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1809   on help of frame Dialog-Frame
     1810   do:
     1811     run gbl/app_help.p
     1812       (input this-procedure :file-name
     1813       ,input ''
     1814       ,input ?
     1815       ) no-error.
     1816     if error-status :error then do:
     1817       message
     1818         "Ошибка при вызове помощи"
     1819         error-status :get-message(1)
     1820         view-as alert-box .
     1821     end.
     1822   end.
     1823   run minbtn-set in this-procedure .
     1824   on choose of b-help in frame Dialog-Frame
     1825   do:
     1826     apply "help":u to frame Dialog-Frame .
     1827   end.
     1828   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1829   procedure minbtn-set :
     1830       do
     1831           on error undo, return error return-value
     1832           :
     1833           define variable ii              as integer       no-undo .
     1834           define variable fh              as widget-handle no-undo .
     1835           define variable hh              as widget-handle no-undo .
     1836           define variable v-h             as handle        extent 4 no-undo .
     1837           define variable v-name-button   as character     no-undo .
     1838           define variable v-help-old-x    as decimal       no-undo .
     1839           define variable v-help-old-y    as decimal       no-undo .
     1840           define variable v-help-old-size as decimal       no-undo .
     1841           define variable v-frame-width   as decimal       no-undo .
     1842           define variable jj              as integer       no-undo .
     1843           do
     1844               on error undo, return error
     1845               :
     1846               assign
     1847                   v-frame-width = frame Dialog-Frame:width - 0.3
     1848                   fh            = frame Dialog-Frame:first-child
     1849                   hh            = fh:first-child
     1850                   ii            = 1
     1851                   .
     1852               do while valid-handle(hh):
     1853                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1854                   do:
     1855                       case lc(hh:name) :
     1856                           when "b-help" then
     1857                               do:
     1858                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1859                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1860                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1861                                   hh:TOOLTIP = "Помощь" .
     1862                                   v-help-old-x = hh:column .
     1863                                   v-help-old-y = hh:row    .
     1864                                   v-help-old-size = hh:width .
     1865                                   hh:width-chars = 2.5 .
     1866                               end.
     1867                           when "b-print" then
     1868                               do:
     1869                                   hh:load-image("cmp/b-print.bmp":u) .
     1870                                   hh:TOOLTIP = "Печать" .
     1871                                   v-h[ii] = hh:handle .
     1872                                   ii = ii + 1 .
     1873                                   hh:width-chars = 3 .
     1874                               end.
     1875                           when "b-history" or
     1876                           when "b-hist" then
     1877                               do:
     1878                                   hh:load-image("cmp/b-hist.bmp":u) .
     1879                                   hh:TOOLTIP = "История" .
     1880                                   v-h[ii] = hh:handle .
     1881                                   ii = ii + 1 .
     1882                                   hh:width-chars = 3 .
     1883                               end.
     1884                           when "b-sch" then
     1885                               do:
     1886                                   hh:load-image("cmp/b-sch.bmp":u) .
     1887                                   hh:TOOLTIP = "Установка Фильтра" .
     1888                                   v-h[ii] = hh:handle .
     1889                                   ii = ii + 1 .
     1890                                   hh:width-chars = 3 .
     1891                               end.
     1892                           when "b-hist-user" then
     1893                               do:
     1894                                   hh:load-image("cmp/b-hist.bmp":u) .
     1895                                   hh:TOOLTIP = "История пользователя" .
     1896                                   ii = ii + 1 .
     1897                               end.
     1898                       end case.
     1899                   end.
     1900                   hh = hh:next-sibling.
     1901               end.
     1902               b-help:column = v-frame-width - b-help:width-chars.
     1903               jj = 0.
     1904               repeat ii = 4 to 1 by -1 :
     1905                   if valid-handle (v-h[ii] ) then
     1906                   do:
     1907                       jj  = jj + 1 .
     1908                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1909                       v-h[ii]:row    = v-help-old-y .
     1910                   end.
     1911               end.
     1912           end.
     1913       end.
     1914   end procedure.
     1915   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1916   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1917   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1918   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1919   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1920   define variable v-diasize-current-frame-height as decimal   no-undo .
     1921   define variable v-diasize-change-size          as logical   no-undo .
     1922   define variable v-diasize-resize-button        as handle    no-undo .
     1923   define variable v-diasize-wndmax               as logical   no-undo .
     1924   define variable v-diasize-wndstore             as logical   no-undo .
     1925   define variable v-diasize-proc-name            as character no-undo .
     1926   define variable v-diasize-browse-handle        as handle    no-undo .
     1927   define variable v-diasize-browse-number        as integer   no-undo .
     1928   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1929   define temp-table temp-diasize-handle no-undo
     1930     field handle-value  as handle
     1931     field save-position as decimal
     1932     index xpk is primary unique handle-value
     1933     .
     1934   define temp-table temp-browse-handle no-undo
     1935     field browse-type   as character
     1936     field browse-number as integer
     1937     field browse-handle as handle
     1938     field original-size as decimal
     1939     index xpk is primary unique browse-type browse-number
     1940     index xie browse-type browse-handle
     1941   .
     1942   procedure diasize_change-height :
     1943     define input  parameter p-change-value  as decimal   no-undo .
     1944     define input  parameter p-move-resize   as logical   no-undo .
     1945     define variable v-field-group-handle    as handle    no-undo .
     1946     define variable v-object-handle         as handle    no-undo .
     1947     define variable v-frame-height          as decimal   no-undo .
     1948     define variable v-frame-virtual-height  as decimal   no-undo .
     1949     define variable v-browse-height         as decimal   no-undo .
     1950     define variable v-window-height         as decimal   no-undo .
     1951     define variable v-window-virtual-height as decimal   no-undo .
     1952     define variable v-change-sign           as integer   no-undo .
     1953     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1954     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1955     if p-change-value > 0
     1956     then do:
     1957       if frame Dialog-Frame :height + p-change-value
     1958           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1959       then do:
     1960         assign
     1961           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1962                           - (frame Dialog-Frame :height-chars)
     1963         .
     1964         if p-change-value <= 0
     1965         then do:
     1966           run diasize_position-resize-button in this-procedure .
     1967           return .
     1968         end.
     1969       end.
     1970     end.
     1971     if p-change-value < 0
     1972     then do:
     1973       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1974       then do:
     1975         assign
     1976           p-change-value = v-diasize-orig-frame-height
     1977                          - (frame Dialog-Frame :height-chars)
     1978         .
     1979         if p-change-value >= 0
     1980         then do:
     1981           run diasize_position-resize-button in this-procedure .
     1982           return .
     1983         end.
     1984       end.
     1985     end.
     1986     if p-change-value >= 0
     1987     then do:
     1988       assign
     1989         v-change-sign = 1
     1990       .
     1991     end.
     1992     else do:
     1993       assign
     1994         v-change-sign = -1
     1995       .
     1996     end.
     1997     assign
     1998       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1999     .
     2000     if p-change-value = 0
     2001     then do:
     2002       run diasize_position-resize-button in this-procedure .
     2003       return .
     2004     end.
     2005     move_block:
     2006     do
     2007     on error undo move_block, retry move_block
     2008     :
     2009       if retry
     2010       then do:
     2011         do
     2012         on error undo move_block, leave move_block
     2013         :
     2014           if p-change-value > 0
     2015           then do:
     2016             for each buf_temp-diasize-handle
     2017             on error undo, next
     2018             :
     2019               assign
     2020                 v-object-handle = buf_temp-diasize-handle.handle-value
     2021               .
     2022               if v-object-handle <> v-diasize-resize-button
     2023               then do:
     2024                 assign
     2025                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2026                 .
     2027               end.
     2028             end.
     2029             assign
     2030               v-diasize-browse-handle :height = v-browse-height
     2031             .
     2032             for each buf_temp-browse-handle
     2033               where buf_temp-browse-handle.browse-type = 'height':u
     2034             on error undo, next
     2035             :
     2036               assign
     2037                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2038               .
     2039             end.
     2040             assign
     2041               frame Dialog-Frame :height = v-frame-height
     2042             .
     2043             if frame Dialog-Frame :scrollable = true
     2044             then do:
     2045               assign
     2046                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2047               .
     2048             end.
     2049             run diasize_position-resize-button in this-procedure .
     2050           end.
     2051           else do:
     2052             if frame Dialog-Frame :scrollable = true
     2053             then do:
     2054               assign
     2055                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2056               .
     2057             end.
     2058             assign
     2059               frame Dialog-Frame :height = v-frame-height
     2060             .
     2061             assign
     2062               v-diasize-browse-handle :height = v-browse-height
     2063             .
     2064             for each buf_temp-browse-handle
     2065               where buf_temp-browse-handle.browse-type = 'height':u
     2066             on error undo, next
     2067             :
     2068               assign
     2069                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2070               .
     2071             end.
     2072             for each buf_temp-diasize-handle
     2073             on error undo, next
     2074             :
     2075               assign
     2076                 v-object-handle = buf_temp-diasize-handle.handle-value
     2077               .
     2078               if v-object-handle <> v-diasize-resize-button
     2079               then do:
     2080                 assign
     2081                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2082                 .
     2083               end.
     2084             end.
     2085             run diasize_position-resize-button in this-procedure .
     2086           end.
     2087           assign
     2088             v-diasize-change-size = false
     2089           .
     2090           leave move_block .
     2091         end.
     2092       end.
     2093       assign
     2094         v-diasize-need-full-display = true
     2095       .
     2096       if v-diasize-change-size = false
     2097       then do:
     2098         assign
     2099           v-diasize-change-size = true
     2100         .
     2101       end.
     2102       else do:
     2103         return .
     2104       end.
     2105       assign
     2106         v-frame-height = frame Dialog-Frame :height
     2107         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2108         v-browse-height = v-diasize-browse-handle :height
     2109       .
     2110       for each buf_temp-browse-handle
     2111         where buf_temp-browse-handle.browse-type = 'height':u
     2112       :
     2113         assign
     2114           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2115         .
     2116       end.
     2117       for each buf_temp-diasize-handle
     2118       :
     2119         delete buf_temp-diasize-handle .
     2120       end.
     2121       assign
     2122         v-field-group-handle = frame Dialog-Frame :first-child
     2123       .
     2124       do while valid-handle(v-field-group-handle)
     2125       :
     2126         assign
     2127           v-object-handle = v-field-group-handle :first-child
     2128         .
     2129         do while valid-handle(v-object-handle)
     2130         :
     2131           if  v-object-handle <> v-diasize-browse-handle :handle
     2132           and can-query(v-object-handle, "row")
     2133           and can-query(v-object-handle, "height")
     2134           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2135           then do:
     2136             find first buf_temp-browse-handle
     2137               where buf_temp-browse-handle.browse-type   = 'height':u
     2138                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2139               no-error .
     2140             if available buf_temp-browse-handle
     2141             then do:
     2142             end.
     2143             else do:
     2144               create buf_temp-diasize-handle .
     2145               assign
     2146                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2147                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2148               .
     2149             end.
     2150           end.
     2151           assign
     2152             v-object-handle = v-object-handle :next-sibling
     2153           .
     2154         end.
     2155         assign
     2156           v-field-group-handle = v-field-group-handle :next-sibling
     2157         .
     2158       end.
     2159       do with frame Dialog-Frame
     2160       :
     2161         hide v-diasize-resize-button .
     2162         assign
     2163           v-diasize-resize-button :row    = 1
     2164           v-diasize-resize-button :column = 1
     2165         .
     2166       end.
     2167       if p-change-value > 0
     2168       then do:
     2169         if frame Dialog-Frame :scrollable = true
     2170         then do:
     2171           assign
     2172             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2173             no-error .
     2174           if error-status :error
     2175           or error-status :get-message(1) <> ""
     2176           then do:
     2177             undo move_block, retry move_block .
     2178           end.
     2179         end.
     2180         assign
     2181           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2182           no-error .
     2183         if error-status :error
     2184         or error-status :get-message(1) <> ""
     2185         then do:
     2186           undo move_block, retry move_block .
     2187         end.
     2188         assign
     2189           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2190           no-error .
     2191         if error-status :error
     2192         or error-status :get-message(1) <> ""
     2193         then do:
     2194           undo move_block, retry move_block .
     2195         end.
     2196         for each buf_temp-browse-handle
     2197           where buf_temp-browse-handle.browse-type = 'height':u
     2198         on error undo move_block, retry move_block
     2199         :
     2200           assign
     2201             buf_temp-browse-handle.browse-handle :height
     2202               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2203             no-error .
     2204           if error-status :error
     2205           or error-status :get-message(1) <> ""
     2206           then do:
     2207             undo move_block, retry move_block .
     2208           end.
     2209         end.
     2210         for each buf_temp-diasize-handle
     2211         on error undo move_block, retry move_block
     2212         :
     2213           assign
     2214             v-object-handle = buf_temp-diasize-handle.handle-value
     2215           .
     2216           if v-object-handle <> v-diasize-resize-button
     2217           then do:
     2218             assign
     2219               v-object-handle :row = v-object-handle :row + p-change-value
     2220               no-error .
     2221             if error-status :error
     2222             or error-status :get-message(1) <> ""
     2223             then do:
     2224               undo move_block, retry move_block .
     2225             end.
     2226           end.
     2227         end.
     2228       end.
     2229       else do:
     2230         for each buf_temp-diasize-handle
     2231         on error undo move_block, retry move_block
     2232         :
     2233           assign
     2234             v-object-handle = buf_temp-diasize-handle.handle-value
     2235           .
     2236           if v-object-handle <> v-diasize-resize-button
     2237           then do:
     2238             assign
     2239               v-object-handle :row = v-object-handle :row + p-change-value
     2240               no-error .
     2241             if error-status :error
     2242             or error-status :get-message(1) <> ""
     2243             then do:
     2244               undo move_block, retry move_block .
     2245             end.
     2246           end.
     2247         end.
     2248         assign
     2249           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2250           no-error .
     2251         if error-status :error
     2252         or error-status :get-message(1) <> ""
     2253         then do:
     2254           undo move_block, retry move_block .
     2255         end.
     2256         for each buf_temp-browse-handle
     2257           where buf_temp-browse-handle.browse-type = 'height':u
     2258         on error undo move_block, retry move_block
     2259         :
     2260           assign
     2261             buf_temp-browse-handle.browse-handle :height
     2262               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2263             no-error .
     2264           if error-status :error
     2265           or error-status :get-message(1) <> ""
     2266           then do:
     2267             undo move_block, retry move_block .
     2268           end.
     2269         end.
     2270         assign
     2271           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2272           no-error .
     2273         if error-status :error
     2274         or error-status :get-message(1) <> ""
     2275         then do:
     2276           undo move_block, retry move_block .
     2277         end.
     2278         if frame Dialog-Frame :scrollable = true
     2279         then do:
     2280           assign
     2281             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2282             no-error .
     2283           if error-status :error
     2284           or error-status :get-message(1) <> ""
     2285           then do:
     2286             undo move_block, retry move_block .
     2287           end.
     2288         end.
     2289       end.
     2290       if p-move-resize = true
     2291       then do:
     2292         run diasize_position-resize-button in this-procedure .
     2293       end.
     2294       if v-diasize-wndstore = true
     2295       then do:
     2296         if connected("ub") = true
     2297         then do:
     2298           define variable v-cntxt-db-num        as integer   no-undo .
     2299           define variable v-cntxt-userid        as character no-undo .
     2300           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2301                                             , OUTPUT v-cntxt-userid
     2302                                             ) .
     2303           run gbl/wndsizew.p
     2304             (input  v-cntxt-db-num
     2305             ,input  v-cntxt-userid
     2306             ,input  v-diasize-proc-name
     2307             ,input  'height':u
     2308             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2309             ) .
     2310         end.
     2311       end.
     2312     end.
     2313     assign
     2314       v-diasize-change-size = false
     2315     .
     2316   end procedure.
     2317   procedure diasize_set-height :
     2318     define input  parameter p-new-height  as decimal   no-undo .
     2319     define input  parameter p-move-resize as logical   no-undo .
     2320     do
     2321     on error undo, return error return-value
     2322     :
     2323       run diasize_change-height in this-procedure
     2324         (input  (p-new-height - frame Dialog-Frame :height)
     2325         ,input  p-move-resize
     2326         ) .
     2327     end.
     2328   end procedure.
     2329   procedure diasize_change-width :
     2330     define input  parameter p-change-value as decimal   no-undo .
     2331     define input  parameter p-move-resize  as logical   no-undo .
     2332     define variable v-field-group-handle   as handle    no-undo .
     2333     define variable v-object-handle        as handle    no-undo .
     2334     define variable v-frame-width          as decimal   no-undo .
     2335     define variable v-frame-virtual-width  as decimal   no-undo .
     2336     define variable v-browse-width         as decimal   no-undo .
     2337     define variable v-window-width         as decimal   no-undo .
     2338     define variable v-window-virtual-width as decimal   no-undo .
     2339     define variable v-change-sign          as integer   no-undo .
     2340     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2341     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2342     if p-change-value > 0
     2343     then do:
     2344       if frame Dialog-Frame :width + p-change-value >
     2345           session :width-chars
     2346       then do:
     2347         assign
     2348           p-change-value = session :width-chars - frame Dialog-Frame :width
     2349         .
     2350         if p-change-value <= 0
     2351         then do:
     2352           run diasize_position-resize-button in this-procedure .
     2353           return .
     2354         end.
     2355       end.
     2356     end.
     2357     if p-change-value < 0
     2358     then do:
     2359       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2360       then do:
     2361         assign
     2362           p-change-value = v-diasize-orig-frame-width
     2363                          - frame Dialog-Frame :width
     2364         .
     2365         if p-change-value >= 0
     2366         then do:
     2367           run diasize_position-resize-button in this-procedure .
     2368           return .
     2369         end.
     2370       end.
     2371     end.
     2372     if p-change-value >= 0
     2373     then do:
     2374       assign
     2375         v-change-sign = 1
     2376       .
     2377     end.
     2378     else do:
     2379       assign
     2380         v-change-sign = -1
     2381       .
     2382     end.
     2383     assign
     2384       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2385     .
     2386     if p-change-value = 0
     2387     then do:
     2388       run diasize_position-resize-button in this-procedure .
     2389       return .
     2390     end.
     2391     move_block:
     2392     do
     2393     on error undo move_block, leave move_block
     2394     :
     2395       if retry
     2396       then do:
     2397         do
     2398         on error undo move_block, leave move_block
     2399         :
     2400           if p-change-value > 0
     2401           then do:
     2402             for each buf_temp-diasize-handle
     2403             on error undo, next
     2404             :
     2405               assign
     2406                 v-object-handle = buf_temp-diasize-handle.handle-value
     2407               .
     2408               if v-object-handle <> v-diasize-resize-button
     2409               then do:
     2410                 assign
     2411                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2412                 .
     2413               end.
     2414             end.
     2415             assign
     2416               v-diasize-browse-handle :width = v-browse-width
     2417             .
     2418             for each buf_temp-browse-handle
     2419               where buf_temp-browse-handle.browse-type = 'width':u
     2420             on error undo, next
     2421             :
     2422               assign
     2423                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2424               .
     2425             end.
     2426             assign
     2427               frame Dialog-Frame :width = v-frame-width
     2428             .
     2429             if frame Dialog-Frame :scrollable = true
     2430             then do:
     2431               assign
     2432                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2433               .
     2434             end.
     2435             run diasize_position-resize-button in this-procedure .
     2436           end.
     2437           else do:
     2438             if frame Dialog-Frame :scrollable = true
     2439             then do:
     2440               assign
     2441                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2442               .
     2443             end.
     2444             assign
     2445               frame Dialog-Frame :width = v-frame-width
     2446             .
     2447             for each buf_temp-browse-handle
     2448               where buf_temp-browse-handle.browse-type = 'width':u
     2449             on error undo, next
     2450             :
     2451               assign
     2452                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2453               .
     2454             end.
     2455             assign
     2456               v-diasize-browse-handle :width = v-browse-width
     2457             .
     2458             for each buf_temp-diasize-handle
     2459             on error undo, next
     2460             :
     2461               assign
     2462                 v-object-handle = buf_temp-diasize-handle.handle-value
     2463               .
     2464               if v-object-handle <> v-diasize-resize-button
     2465               then do:
     2466                 assign
     2467                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2468                 .
     2469               end.
     2470             end.
     2471             run diasize_position-resize-button in this-procedure .
     2472           end.
     2473           assign
     2474             v-diasize-change-size = false
     2475           .
     2476           leave move_block .
     2477         end.
     2478       end.
     2479       assign
     2480         v-diasize-need-full-display = true
     2481       .
     2482       if v-diasize-change-size = false
     2483       then do:
     2484         assign
     2485           v-diasize-change-size = true
     2486         .
     2487       end.
     2488       else do:
     2489         return .
     2490       end.
     2491       assign
     2492         v-frame-width = frame Dialog-Frame :width
     2493         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2494         v-browse-width = v-diasize-browse-handle :width
     2495       .
     2496       for each buf_temp-browse-handle
     2497         where buf_temp-browse-handle.browse-type = 'width':u
     2498       :
     2499         assign
     2500           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2501         .
     2502       end.
     2503       for each buf_temp-diasize-handle
     2504       :
     2505         delete buf_temp-diasize-handle .
     2506       end.
     2507       assign
     2508         v-field-group-handle = frame Dialog-Frame :first-child
     2509       .
     2510       do while valid-handle(v-field-group-handle)
     2511       :
     2512         assign
     2513           v-object-handle = v-field-group-handle :first-child
     2514         .
     2515         do while valid-handle(v-object-handle)
     2516         :
     2517           if  v-object-handle <> v-diasize-browse-handle :handle
     2518           and v-object-handle <> v-diasize-resize-button
     2519           and can-query(v-object-handle, "row")
     2520           and can-query(v-object-handle, "height")
     2521           and ( v-object-handle :col + v-object-handle :width
     2522                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2523               )
     2524           then do:
     2525             find first buf_temp-browse-handle
     2526               where buf_temp-browse-handle.browse-type   = 'width':u
     2527                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2528               no-error .
     2529             if available buf_temp-browse-handle
     2530             then do:
     2531             end.
     2532             else do:
     2533               create buf_temp-diasize-handle .
     2534               assign
     2535                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2536                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2537               .
     2538             end.
     2539           end.
     2540           assign
     2541             v-object-handle = v-object-handle :next-sibling
     2542           .
     2543         end.
     2544         assign
     2545           v-field-group-handle = v-field-group-handle :next-sibling
     2546         .
     2547       end.
     2548       do with frame Dialog-Frame
     2549       :
     2550         hide v-diasize-resize-button .
     2551         v-diasize-resize-button :row = 1.
     2552         v-diasize-resize-button :column = 1.
     2553       end.
     2554       if p-change-value > 0
     2555       then do:
     2556         if frame Dialog-Frame :scrollable = true
     2557         then do:
     2558           assign
     2559             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2560             no-error .
     2561           if error-status :error
     2562           or error-status :get-message(1) <> ""
     2563           then do:
     2564             undo move_block, retry move_block.
     2565           end.
     2566         end.
     2567         assign
     2568           frame Dialog-Frame :width = v-frame-width + p-change-value
     2569           no-error .
     2570         if error-status :error
     2571         or error-status :get-message(1) <> ""
     2572         then do:
     2573           undo move_block, retry move_block.
     2574         end.
     2575         assign
     2576           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2577         no-error .
     2578         if error-status :error
     2579         or error-status :get-message(1) <> ""
     2580         then do:
     2581           undo move_block, retry move_block.
     2582         end.
     2583         for each buf_temp-browse-handle
     2584           where buf_temp-browse-handle.browse-type = 'width':u
     2585         on error undo move_block, retry move_block
     2586         :
     2587           assign
     2588             buf_temp-browse-handle.browse-handle :width
     2589               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2590             no-error .
     2591           if error-status :error
     2592           or error-status :get-message(1) <> ""
     2593           then do:
     2594             undo move_block, retry move_block .
     2595           end.
     2596         end.
     2597         for each buf_temp-diasize-handle
     2598         on error undo move_block, retry move_block
     2599         :
     2600           assign
     2601             v-object-handle = buf_temp-diasize-handle.handle-value
     2602           .
     2603           if v-object-handle <> v-diasize-resize-button
     2604           then do:
     2605             assign
     2606               v-object-handle :col = v-object-handle :col + p-change-value
     2607               no-error .
     2608             if error-status :error
     2609             or error-status :get-message(1) <> ""
     2610             then do:
     2611               undo move_block, retry move_block .
     2612             end.
     2613           end.
     2614         end.
     2615       end.
     2616       else do:
     2617         for each buf_temp-diasize-handle
     2618         on error undo move_block, retry move_block
     2619         :
     2620           assign
     2621             v-object-handle = buf_temp-diasize-handle.handle-value
     2622           .
     2623           if v-object-handle <> v-diasize-resize-button
     2624           then do:
     2625             assign
     2626               v-object-handle :col = v-object-handle :col + p-change-value
     2627               no-error .
     2628             if error-status :error
     2629             or error-status :get-message(1) <> ""
     2630             then do:
     2631               undo move_block, retry move_block .
     2632             end.
     2633           end.
     2634         end.
     2635         for each buf_temp-browse-handle
     2636           where buf_temp-browse-handle.browse-type = 'width':u
     2637         on error undo move_block, retry move_block
     2638         :
     2639           assign
     2640             buf_temp-browse-handle.browse-handle :width
     2641               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2642             no-error .
     2643           if error-status :error
     2644           or error-status :get-message(1) <> ""
     2645           then do:
     2646             undo move_block, retry move_block .
     2647           end.
     2648         end.
     2649         assign
     2650           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2651           no-error .
     2652         if error-status :error
     2653         or error-status :get-message(1) <> ""
     2654         then do:
     2655           undo move_block, retry move_block.
     2656         end.
     2657         assign
     2658           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2659         no-error .
     2660         if error-status :error
     2661         or error-status :get-message(1) <> ""
     2662         then do:
     2663           undo move_block, retry move_block.
     2664         end.
     2665         if frame Dialog-Frame :scrollable = true
     2666         then do:
     2667           assign
     2668             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2669           no-error .
     2670           if error-status :error
     2671           or error-status :get-message(1) <> ""
     2672           then do:
     2673             undo move_block, retry move_block.
     2674           end.
     2675         end.
     2676       end.
     2677       if p-move-resize
     2678       then do:
     2679         run diasize_position-resize-button in this-procedure .
     2680       end.
     2681       if v-diasize-wndstore = true
     2682       then do:
     2683         if connected("ub") = true
     2684         then do:
     2685           define variable v-cntxt-db-num        as integer   no-undo .
     2686           define variable v-cntxt-userid        as character no-undo .
     2687           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2688                                             , OUTPUT v-cntxt-userid
     2689                                             ) .
     2690           run gbl/wndsizew.p
     2691             (input  v-cntxt-db-num
     2692             ,input  v-cntxt-userid
     2693             ,input  v-diasize-proc-name
     2694             ,input  'width':u
     2695             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2696             ) .
     2697         end.
     2698       end.
     2699     end.
     2700     assign
     2701       v-diasize-change-size = false
     2702     .
     2703   end procedure.
     2704   procedure diasize_set-width :
     2705     define input  parameter p-new-width  as decimal   no-undo .
     2706     define input  parameter p-move-resize as logical   no-undo .
     2707     do
     2708     on error undo, return error return-value
     2709     :
     2710       run diasize_change-width in this-procedure
     2711         (input  (p-new-width - frame Dialog-Frame :width)
     2712         ,input  p-move-resize
     2713         ) .
     2714     end.
     2715   end procedure.
     2716   procedure diasize_position-resize-button :
     2717     do with frame Dialog-Frame
     2718     :
     2719       hide v-diasize-resize-button .
     2720       assign
     2721         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2722                     - 1
     2723                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2724         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2725                     - 1
     2726                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2727       .
     2728       view v-diasize-resize-button .
     2729     end.
     2730   end procedure.
     2731   on alt-right anywhere
     2732   do:
     2733     run diasize_change-width in this-procedure
     2734       (input 1
     2735       ,input true
     2736       ) .
     2737     return no-apply .
     2738   end.
     2739   on alt-left anywhere
     2740   do:
     2741     run diasize_change-width in this-procedure
     2742       (input -1
     2743       ,input true
     2744       ) .
     2745     return no-apply .
     2746   end.
     2747   on alt-down anywhere
     2748   do:
     2749     run diasize_change-height in this-procedure
     2750       (input 1
     2751       ,input true
     2752       ) .
     2753     return no-apply .
     2754   end.
     2755   on alt-up anywhere
     2756   do:
     2757     run diasize_change-height in this-procedure
     2758       (input -1
     2759       ,input true
     2760       ) .
     2761     return no-apply .
     2762   end.
     2763   on alt-enter of frame Dialog-Frame
     2764   do:
     2765     run diasize_maximize in this-procedure
     2766       (input  ?
     2767       ).
     2768     return no-apply .
     2769   end.
     2770   procedure diasize_end-move :
     2771     do
     2772     on error undo, return error return-value
     2773     :
     2774       define variable v-row-delta as decimal   no-undo .
     2775       define variable v-col-delta as decimal   no-undo .
     2776       define variable v-new-row as decimal   no-undo .
     2777       define variable v-new-col as decimal   no-undo .
     2778       assign
     2779         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2780         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2781       .
     2782       assign
     2783         v-row-delta = v-new-row - frame Dialog-Frame :height
     2784         v-col-delta = v-new-col - frame Dialog-Frame :width
     2785       .
     2786       run diasize_change-height in this-procedure
     2787         (input v-row-delta
     2788         ,input true
     2789         ) .
     2790       run diasize_change-width in this-procedure
     2791         (input v-col-delta
     2792         ,input true
     2793         ) .
     2794     end.
     2795   end procedure.
     2796   procedure diasize_maximize :
     2797     define input  parameter p-action as logical   no-undo .
     2798     do
     2799     on error undo, return error return-value
     2800     :
     2801       if p-action = ?
     2802       then do:
     2803         if v-diasize-need-maximize = true
     2804         then do:
     2805           assign
     2806             p-action = true
     2807           .
     2808         end.
     2809         else do:
     2810           assign
     2811             p-action = false
     2812           .
     2813         end.
     2814       end.
     2815       if p-action = true
     2816       then do:
     2817         run diasize_change-height in this-procedure
     2818           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2819               - frame Dialog-Frame :height-chars
     2820           ,input true
     2821           ) .
     2822         run diasize_change-width in this-procedure
     2823           (input session :width-chars
     2824               - frame Dialog-Frame :width-chars
     2825           ,input true
     2826           ) .
     2827         assign
     2828           v-diasize-need-maximize = false
     2829         .
     2830       end.
     2831       else do:
     2832         run diasize_change-width in this-procedure
     2833           (input v-diasize-orig-frame-width
     2834               - frame Dialog-Frame :width-chars
     2835           ,input true
     2836           ) .
     2837         run diasize_change-height in this-procedure
     2838           (input v-diasize-orig-frame-height
     2839               - frame Dialog-Frame :height-chars
     2840           ,input true
     2841           ) .
     2842         assign
     2843           v-diasize-need-maximize = true
     2844         .
     2845       end.
     2846     end.
     2847   end procedure.
     2848   procedure diasize_restore-orig-size :
     2849     do
     2850     on error undo, return error return-value
     2851     :
     2852       assign
     2853         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2854         v-diasize-current-frame-height = frame Dialog-Frame :height
     2855       .
     2856       run diasize_set-height in this-procedure
     2857         (input  v-diasize-orig-frame-height
     2858         ,input  true
     2859         ) .
     2860       run diasize_set-width in this-procedure
     2861         (input  v-diasize-orig-frame-width
     2862         ,input  true
     2863         ) .
     2864     end.
     2865   end procedure.
     2866   procedure diasize_restore-current-size :
     2867     do
     2868     on error undo, return error return-value
     2869     :
     2870       run diasize_set-height in this-procedure
     2871         (input  v-diasize-current-frame-height
     2872         ,input  true
     2873         ) .
     2874       run diasize_set-width in this-procedure
     2875         (input  v-diasize-current-frame-width
     2876         ,input  true
     2877         ) .
     2878     end.
     2879   end procedure.
     2880   procedure diasize_set-browse-handle :
     2881     define input  parameter p-browse-handle as handle   no-undo .
     2882     define buffer buf_temp-browse-handle for temp-browse-handle .
     2883     do
     2884     on error undo, return error return-value
     2885     :
     2886       assign
     2887         v-diasize-browse-handle = p-browse-handle
     2888       .
     2889       for each buf_temp-browse-handle
     2890       on error undo, return error return-value
     2891       :
     2892         delete buf_temp-browse-handle .
     2893       end.
     2894     end.
     2895   end procedure.
     2896   procedure diasize_add_browse :
     2897     define input  parameter p-browse-type   as character no-undo .
     2898     define input  parameter p-browse-handle as handle    no-undo .
     2899     define buffer buf_temp-browse-handle for temp-browse-handle .
     2900     do
     2901     on error undo, return error return-value
     2902     :
     2903       assign
     2904         v-diasize-browse-number = v-diasize-browse-number + 1
     2905       .
     2906       create buf_temp-browse-handle .
     2907       assign
     2908         buf_temp-browse-handle.browse-type   = p-browse-type
     2909         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2910         buf_temp-browse-handle.browse-handle = p-browse-handle
     2911       .
     2912     end.
     2913   end procedure.
     2914   procedure diasize_init :
     2915     define variable v-default-value    as logical   no-undo .
     2916     define variable v-restore-saved    as logical   no-undo .
     2917     define variable v-resize-value-str as character no-undo .
     2918     do
     2919     on error undo, return error return-value
     2920     :
     2921       do with frame Dialog-Frame
     2922       :
     2923         assign
     2924           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2925           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2926           v-diasize-browse-handle     = browse Doc-List :handle
     2927         .
     2928         create button v-diasize-resize-button
     2929         assign
     2930           parent        = frame Dialog-Frame :first-child
     2931           label         = "s"
     2932           height-pixels = 16
     2933           width-pixels  = 16
     2934           visible       = true
     2935           sensitive     = true
     2936           movable       = true
     2937           triggers:
     2938             on end-move persistent run diasize_end-move in this-procedure .
     2939           end triggers.
     2940         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2941         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2942         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2943         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2944         assign
     2945           v-diasize-wndmax = false
     2946         .
     2947         if connected("ub") = true
     2948         then do:
     2949           define variable v-cntxt-db-num        as integer   no-undo .
     2950           define variable v-cntxt-userid        as character no-undo .
     2951           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2952                                             , OUTPUT v-cntxt-userid
     2953                                             ) .
     2954           run gbl/wndpar_r.p
     2955             (input  v-cntxt-db-num
     2956             ,input  v-cntxt-userid
     2957             ,input  'wndmax':U
     2958             ,output v-diasize-wndmax
     2959             ,output v-default-value
     2960             ) .
     2961         end.
     2962         assign
     2963           v-diasize-wndstore = false
     2964         .
     2965         if connected("ub") = true
     2966         then do:
     2967           run gbl/wndpar_r.p
     2968             (input  v-cntxt-db-num
     2969             ,input  v-cntxt-userid
     2970             ,input  'wndstore':U
     2971             ,output v-diasize-wndstore
     2972             ,output v-default-value
     2973             ) .
     2974         end.
     2975         assign
     2976           v-diasize-proc-name = entry(1, program-name(2), '.')
     2977         .
     2978         if v-diasize-wndstore = true
     2979         then do:
     2980           assign
     2981             v-restore-saved = false
     2982           .
     2983           if connected("ub") = true
     2984           then do:
     2985             run gbl/wndsizer.p
     2986               (input  v-cntxt-db-num
     2987               ,input  v-cntxt-userid
     2988               ,input  v-diasize-proc-name
     2989               ,input  'height':u
     2990               ,output v-resize-value-str
     2991               ) .
     2992             if v-resize-value-str <> '':U
     2993             then do:
     2994               run diasize_change-height in this-procedure
     2995                 (input  integer(v-resize-value-str)
     2996                 ,input  true
     2997                 ) .
     2998               assign
     2999                 v-restore-saved = true
     3000               .
     3001             end.
     3002           end.
     3003           if connected("ub") = true
     3004           then do:
     3005             run gbl/wndsizer.p
     3006               (input  v-cntxt-db-num
     3007               ,input  v-cntxt-userid
     3008               ,input  v-diasize-proc-name
     3009               ,input  'width':u
     3010               ,output v-resize-value-str
     3011               ) .
     3012             if v-resize-value-str <> '':U
     3013             then do:
     3014               run diasize_change-width in this-procedure
     3015                 (input  integer(v-resize-value-str)
     3016                 ,input  true
     3017                 ) .
     3018               assign
     3019                 v-restore-saved = true
     3020               .
     3021             end.
     3022           end.
     3023           if v-restore-saved <> true
     3024           then do:
     3025             if v-diasize-wndmax = true
     3026             then do:
     3027               run diasize_maximize in this-procedure
     3028                 (input  true
     3029                 ) .
     3030             end.
     3031           end.
     3032         end.
     3033         else do:
     3034           if v-diasize-wndmax = true
     3035           then do:
     3036             run diasize_maximize in this-procedure
     3037               (input  true
     3038               ) .
     3039           end.
     3040         end.
     3041       end.
     3042     end.
     3043   end procedure.
     3044   procedure diasize_need-full-display :
     3045     define output parameter p-need-full-display as logical   no-undo .
     3046     do
     3047     on error undo, return error return-value
     3048     :
     3049       assign
     3050         p-need-full-display = v-diasize-need-full-display
     3051       .
     3052       assign
     3053         v-diasize-need-full-display = false
     3054       .
     3055     end.
     3056   end procedure.
     3057   procedure get-context :
     3058      define output parameter p-db-num as integer          no-undo.
     3059      define output parameter p-user-id as character        no-undo.
     3060      define variable v-login               as character    no-undo.
     3061      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3062      define buffer buf_user-login  for ub.user-login .
     3063      do
     3064      on error undo, return error
     3065      :
     3066            FIND FIRST buf_sys-ctrl no-lock.
     3067            ASSIGN
     3068               v-login = USERID("ub")
     3069               p-db-num = buf_sys-ctrl.db-num
     3070            .
     3071            FIND FIRST buf_user-login
     3072                 WHERE buf_user-login.db-num = p-db-num
     3073                   AND buf_user-login.user-login = v-login
     3074                 no-lock
     3075                 no-error
     3076                 .
     3077            IF AVAILABLE buf_user-login
     3078            THEN DO:
     3079               assign
     3080                  p-user-id = buf_user-login.user-id
     3081               .
     3082            END.
     3083      end.
     3084   end procedure.
     3085       run diasize_init in this-procedure .
     3086   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3087   on f5 of frame Dialog-Frame anywhere
     3088   do:
     3089      v-doc-rec = recid(buf_schet-fact-doc).    run OpenBR in this-procedure (yes, no, '':U). REPOSITION Doc-List to recid v-doc-rec No-ERROR.   apply 'value-changed' to Doc-List.
     3090       apply "VALUE-CHANGED" to Doc-List.
     3091   end.
     3092   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3093   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3094   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3095   do:
     3096     Doc-List :SET-REPOSITIONED-ROW(15, "CONDITIONAL") .
     3097   end.
     3098   def var sort-labelDoc-List   as character no-undo .
     3099   def var sort-clmnDoc-List    as handle    no-undo .
     3100   def var cur-clmnDoc-List     as handle    no-undo .
     3101   def var cur-clmn-locDoc-List as integer   no-undo .
     3102   def var re-queryDoc-List     as logical   initial no no-undo .
     3103   on start-search, ctrl-o of Doc-List in frame Dialog-Frame do:
     3104      run sort-brDoc-List
     3105        (input (if available buf_schet-fact-doc
     3106                then recid(buf_schet-fact-doc)
     3107                else ?
     3108               )
     3109        ).
     3110   end.
     3111   PROCEDURE sort-brDoc-List :
     3112     define input parameter p-recid as recid no-undo .
     3113     if re-queryDoc-List = no then do:
     3114       assign
     3115          cur-clmnDoc-List = Doc-List:current-column in frame Dialog-Frame
     3116       .
     3117       if sort-clmnDoc-List <> ? then sort-clmnDoc-List:column-fgcolor = 0.
     3118       if cur-clmnDoc-List = sort-clmnDoc-List then do:
     3119         assign
     3120            sort-labelDoc-List = ""
     3121            sort-clmnDoc-List = ?
     3122         .
     3123        end.
     3124        else do:
     3125          assign
     3126            sort-labelDoc-List = cur-clmnDoc-List:label
     3127            sort-clmnDoc-List  = cur-clmnDoc-List
     3128            sort-clmnDoc-List:column-fgcolor = 4
     3129          .
     3130        end.
     3131      end.
     3132     assign
     3133       cur-clmn-locDoc-List = 1
     3134     .
     3135     def var column-handle as handle no-undo .
     3136     column-handle = Doc-List:first-column.
     3137     do while valid-handle(column-handle) :
     3138       if column-handle = cur-clmnDoc-List then do:
     3139         leave .
     3140       end.
     3141       column-handle = column-handle:NEXT-COLUMN.
     3142       assign
     3143         cur-clmn-locDoc-List = cur-clmn-locDoc-List + 1
     3144       .
     3145     end.
     3146     case sort-labelDoc-List:
     3147           when 'Номер'  then DO:    assign       sort-column-name = "buf_schet-fact-doc.doc-code"     .     run OpenBr(yes, no, '':U).   . END.
     3148           when 'БД'  then DO:    assign       sort-column-name = "buf_schet-fact-doc.db-num"     .     run OpenBr(yes, no, '':U).   . END.
     3149           when '№ в книге'  then DO:    assign       sort-column-name = "buf_schet-fact-doc.book-code"     .     run OpenBr(yes, no, '':U).   . END.
     3150           when 'Дата'  then DO:    assign       sort-column-name = "buf_schet-fact-doc.doc-date"     .     run OpenBr(yes, no, '':U).   . END.
     3151           when 'Статус'  then DO:    assign       sort-column-name = "buf_schet-fact-doc.status_"     .     run OpenBr(yes, no, '':U).   . END.
     3152           when 'Дата факт'  then DO:    assign       sort-column-name = "buf_schet-fact-doc.fact-date"     .     run OpenBr(yes, no, '':U).   . END.
     3153           when 'Поставщик'  then DO:    assign       sort-column-name = "string( buf_schet-fact-doc.cli-type + ' ' + string(buf_schet-fact-doc.cli-code))"     .     run OpenBr(yes, no, '':U).   . END.
     3154           when 'Сумма'  then DO:    assign       sort-column-name = "buf_schet-fact-doc.sum-rubl"     .     run OpenBr(yes, no, '':U).   . END.
     3155           when 'Наим. поставщика'  then DO:    assign       sort-column-name = "buf_schet-fact-doc.cli-name"     .     run OpenBr(yes, no, '':U).   . END.
     3156           when 'Тип'  then DO:    assign       sort-column-name = "buf_schet-fact-doc.ext-doc-type"     .     run OpenBr(yes, no, '':U).   . END.
     3157           when 'По док-ту'  then DO:    assign       sort-column-name = "buf_schet-fact-doc.in-doc-code"     .     run OpenBr(yes, no, '':U).   . END.
     3158           when 'Вн.N договора'  then DO:    assign       sort-column-name = "buf_schet-fact-doc.contract-code"     .     run OpenBr(yes, no, '':U).   . END.
     3159           when 'Оператор'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1usrfulnf&1, &1&2&1)', chr(34), buf_schet-fact-doc.user-name)     .     run OpenBr(yes, no, '':U).   . END.
     3160       otherwise do:
     3161         assign
     3162           sort-column-name = ""
     3163         .
     3164         run OpenBr(yes, no, '':U).
     3165           if can-do( this-procedure:internal-entries, 'mv-brw-defaultDoc-List') then do:
     3166             run mv-brw-defaultDoc-List.
     3167           end.
     3168         if sort-labelDoc-List <> "" then do:
     3169           assign
     3170             cur-clmnDoc-List:column-fgcolor = 0
     3171           .
     3172         end.
     3173         assign
     3174           cur-clmn-locDoc-List = ?
     3175         .
     3176       end.
     3177     end case.
     3178       if cur-clmn-locDoc-List <> ? then do:
     3179         if can-do( this-procedure:internal-entries, 'ch-clmnDoc-List') then do:
     3180           run ch-clmnDoc-List in this-procedure (cur-clmn-locDoc-List).
     3181         end.
     3182       end.
     3183     if p-recid <> ? then do:
     3184       reposition Doc-List to recid p-recid no-error.
     3185       apply "value-changed" to Doc-List in frame Dialog-Frame.
     3186     end.
     3187     apply "entry" to Doc-List in frame Dialog-Frame.
     3188   END PROCEDURE.
     3189   procedure re-open-query-srt-clmnDoc-List:
     3190   if cur-clmnDoc-List = ? then do:
     3191      run OpenBr(yes, no, '':U).
     3192   end.
     3193   else do:
     3194      assign re-queryDoc-List = yes.
     3195      run sort-brDoc-List
     3196        (input (if available buf_schet-fact-doc
     3197                then recid(buf_schet-fact-doc)
     3198                else ?
     3199               )
     3200        ).
     3201      assign re-queryDoc-List = no.
     3202   end.
     3203   end.
     3204   MAIN-BLOCK:
     3205   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3206      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3207   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3208     run mainmenu_getcntxt in parparentproc
     3209       (output v-cntxt-db-num
     3210       ,output v-cntxt-userid
     3211       ,output v-cntxt-level
     3212       ,output v-cntxt-host-code-obj
     3213       ,output v-cntxt-obj-type
     3214       ,output v-cntxt-obj-code
     3215       ,output v-cntxt-db-num-obj
     3216       ,output v-cntxt-is-admin
     3217       ) .
     3218     assign
     3219       Doc-List:num-locked-columns = 1
     3220       buf_schet-fact-doc.doc-date:read-only in browse Doc-List = yes
     3221     .
     3222   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3223   procedure set-filter-name :
     3224   define input parameter p-filter-name as character no-undo .
     3225     do with frame Dialog-Frame:
     3226       if p-filter-name > "" then do:
     3227         assign
     3228           frame Dialog-Frame:title
     3229             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     3230         .
     3231         assign
     3232           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3233         .
     3234       end.
     3235       else do:
     3236         assign
     3237           b-sch :tooltip = ""
     3238         .
     3239       end.
     3240     end.
     3241   end procedure.
     3242     if p-mode = "new" then  assign p-type = 'новый':U .
     3243     else if p-mode = "fact" then assign p-type = 'факт':U .
     3244     if p-doc-num <> ? then do:
     3245       find first ub.contract no-lock where ub.contract.contract-code = p-doc-num .
     3246       assign cont-list = string(recid(ub.contract)) .
     3247       assign Sel-Contr = "sel" .
     3248     end.
     3249     if p-cli-type <> ? and p-cli-code <> ? then do:
     3250       find first ub.clients no-lock where ub.clients.obj-type = p-cli-type and ub.clients.obj-code = p-cli-code .
     3251       assign cli-list = string(recid(ub.clients)) .
     3252       assign Sel-Client = "sel" .
     3253     end.
     3254     RUN enable_UI.
     3255     Run OpenBR(yes, no, '':U) .
     3256   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3257   DEF VAR cur-clmn-numDoc-List as INT EXTENT 12 no-undo.
     3258   DEF VAR varmviDoc-List       as INT no-undo.
     3259   DEF VAR varmvjDoc-List       as INT no-undo.
     3260   DEF VAR varmvkDoc-List       as INT no-undo.
     3261   DEF VAR varmvlDoc-List       as INT no-undo.
     3262   DEF VAR move-elementDoc-List as INT no-undo.
     3263   def var jjDoc-List           as int no-undo.
     3264   do varmviDoc-List = 1 to EXTENT(cur-clmn-numDoc-List):
     3265     ASSIGN cur-clmn-numDoc-List[varmviDoc-List] = varmviDoc-List.
     3266   END.
     3267   RUN start-mv-clmnDoc-List.
     3268   PROCEDURE start-mv-clmnDoc-List:
     3269   def var old-session as logical no-undo.
     3270      old-session = SESSION:IMMEDIATE-DISPLAY.
     3271      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3272      SESSION:IMMEDIATE-DISPLAY = old-session.
     3273   END.
     3274   ON ctrl-cursor-right OF BROWSE Doc-List do:
     3275     RUN re-move-clmnDoc-List ( 2, 12).
     3276   END.
     3277   ON ctrl-cursor-left OF BROWSE Doc-List do:
     3278     RUN re-move-clmnDoc-List (12, 2).
     3279   END.
     3280   PROCEDURE re-move-clmnDoc-List:
     3281     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3282     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3283     DO varmviDoc-List = 1 TO EXTENT(cur-clmn-numDoc-List):
     3284       if cur-clmn-numDoc-List[varmviDoc-List] = source-column THEN cur-clmn-numDoc-List[varmviDoc-List] = -1.
     3285     END.
     3286     if Doc-List:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3287     if source-column > target-column THEN
     3288     DO varmvjDoc-List = source-column - 1 to target-column BY -1:
     3289       DO varmviDoc-List = 1 TO EXTENT(cur-clmn-numDoc-List):
     3290           if cur-clmn-numDoc-List[varmviDoc-List] = varmvjDoc-List THEN DO:
     3291             cur-clmn-numDoc-List[varmviDoc-List] = cur-clmn-numDoc-List[varmviDoc-List] + 1.
     3292           END.
     3293       END.
     3294     END.
     3295     ELSE
     3296     DO varmvjDoc-List = source-column + 1 to target-column:
     3297       DO varmviDoc-List = 1 TO EXTENT(cur-clmn-numDoc-List):
     3298         if cur-clmn-numDoc-List[varmviDoc-List] = varmvjDoc-List THEN DO:
     3299           cur-clmn-numDoc-List[varmviDoc-List] = cur-clmn-numDoc-List[varmviDoc-List] - 1.
     3300         END.
     3301       END.
     3302     END.
     3303     DO varmviDoc-List = 1 TO EXTENT(cur-clmn-numDoc-List):
     3304       if cur-clmn-numDoc-List[varmviDoc-List] = -1 THEN cur-clmn-numDoc-List[varmviDoc-List] = target-column.
     3305     END.
     3306   END PROCEDURE.
     3307   PROCEDURE ch-clmnDoc-List:
     3308     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3309     if cur-clmn-loc <= 2 then do:
     3310       return .
     3311     end.
     3312     DO varmviDoc-List = 1 TO EXTENT(cur-clmn-numDoc-List):
     3313       if cur-clmn-numDoc-List[varmviDoc-List] = cur-clmn-loc THEN move-elementDoc-List = varmviDoc-List.
     3314     END.
     3315     RUN re-move-clmnDoc-List (cur-clmn-loc, 2).
     3316   END PROCEDURE.
     3317   PROCEDURE mv-brw-defaultDoc-List:
     3318   def var old-session as logical no-undo.
     3319     old-session = SESSION:IMMEDIATE-DISPLAY.
     3320     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3321     do varmvlDoc-List = 2 to EXTENT(cur-clmn-numDoc-List):
     3322       RUN re-move-clmnDoc-List (cur-clmn-numDoc-List[varmvlDoc-List], varmvlDoc-List).
     3323     END.
     3324     RUN start-mv-clmnDoc-List.
     3325     SESSION:IMMEDIATE-DISPLAY = old-session.
     3326   END PROCEDURE.
     3327   .
     3328     WAIT-FOR GO OF FRAME Dialog-Frame.
     3329   END.
     3330   RUN disable_UI.
     3331   PROCEDURE disable_UI :
     3332     HIDE FRAME Dialog-Frame.
     3333   END PROCEDURE.
     3334   PROCEDURE enable_UI :
     3335     DISPLAY Sel-Client Sel-Contr sch-str sch-str-2 mark-num
     3336         WITH FRAME Dialog-Frame.
     3337     ENABLE b-quit B-mark B-add b-lkp b-chg B-del B-book B-close b-gen B-Help b-exp B-open
     3338            B-print b-hist Sel-Client Sel-Contr sch-str sch-str-2 Doc-List mark-num  b-sch
     3339         WITH FRAME Dialog-Frame.
     3340     VIEW FRAME Dialog-Frame.
     3341   END PROCEDURE.
     3342   PROCEDURE OpenBr :
     3343     define input  parameter p-open-query     as logical   no-undo .
     3344     define input  parameter p-find-next      as logical   no-undo .
     3345     define input  parameter p-find-condition as character no-undo .
     3346     define variable l-query-was-opened as logical no-undo .
     3347     define variable sort-column-phrase as character no-undo .
     3348     assign frame Dialog-Frame:title =  " Фирма: (" + string(p-host-code) + ")":U + chr(32) + "Счета-фактуры".
     3349     if sort-column-name = "" then assign sort-column-phrase = "" .
     3350     else                          assign sort-column-phrase = "by " + sort-column-name .
     3351     if available buf_schet-fact-doc then assign v-doc-rec = recid (buf_schet-fact-doc) .
     3352     case p-mode:
     3353     when "all" then do:
     3354       if Sel-Contr = "all" then do:
     3355         if Sel-Client = "all" then do:
     3356   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3357   define variable  l-disable-where-32  as logical   no-undo .
     3358   define variable  l-filter-open-32    as logical   .
     3359   define variable  flt-rec-32       as recid     no-undo .
     3360   define variable  filter-name-32      as character no-undo .
     3361   define variable  where-phrase-32     as character no-undo .
     3362   define variable  sort-phrase-32      as character no-undo .
     3363   define variable  where-phrase-rus-32 as character no-undo .
     3364   define variable  sort-phrase-rus-32  as character no-undo .
     3365     run waitfram-show in this-procedure
     3366       (input "ЖДИТЕ ..."
     3367       ).
     3368   run gbl/flt-get.p
     3369     (input filter-point
     3370     ,output flt-rec-32
     3371     ,output filter-name-32
     3372     ,output where-phrase-32
     3373     ,output sort-phrase-32
     3374     ,output where-phrase-rus-32
     3375     ,output sort-phrase-rus-32
     3376     ).
     3377   if p-open-query then do:
     3378       run set-filter-name in this-procedure
     3379         (INPUT filter-name-32
     3380         ) no-error .
     3381     assign
     3382       l-filter-open-32 = false
     3383     .
     3384     if flt-rec-32 <> ?
     3385       or sort-column-phrase > ""
     3386     then do:
     3387       define variable  parameter-2-32 as character no-undo .
     3388       define variable  parameter-3-32 as character no-undo .
     3389       define variable  parameter-4-32 as character no-undo .
     3390       define variable  parameter-5-32 as character no-undo .
     3391       define variable  parameter-6-32 as character no-undo .
     3392       define variable  parameter-7-32 as character no-undo .
     3393         assign
     3394         parameter-3-32 =
     3395                                 "FOR EACH buf_schet-fact-doc"
     3396         parameter-4-32 =
     3397           (
     3398             if (" buf_schet-fact-doc.host-code = p-host-code " + " " + where-phrase-32) <> ""
     3399             then  substitute(' buf_schet-fact-doc.host-code = &1 ', p-host-code) + " " + where-phrase-32
     3400             else "true"
     3401           )
     3402         parameter-5-32 = (" " + "" + " " + "")
     3403         parameter-6-32 = if sort-phrase-32 = ''
     3404                              then
     3405           (
     3406           " " + "  " +
     3407             " " + sort-column-phrase +
     3408           " " + " by int(buf_schet-fact-doc.doc-code) descending "
     3409           )
     3410                              else
     3411           (
     3412           " " + "  " +
     3413             " " + sort-column-phrase +
     3414           " " + sort-phrase-32
     3415           )
     3416         parameter-7-32 =
     3417           "   "
     3418       .
     3419       do
     3420       on stop undo, leave
     3421       on error undo, leave
     3422       :
     3423         assign
     3424           l-disable-where-32 =
     3425             (" buf_schet-fact-doc.host-code = p-host-code " + " " + where-phrase-32 = "")
     3426         .
     3427         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3428                             ,input query Doc-List:handle
     3429                             ,input parameter-3-32
     3430                             ,input parameter-4-32
     3431                             ,input parameter-5-32
     3432                             ,input parameter-6-32
     3433                             ,input parameter-7-32
     3434                             )
     3435         .
     3436         assign
     3437           l-filter-open-32 = true
     3438         .
     3439       end.
     3440       if l-filter-open-32 = false then do:
     3441         message
     3442           "Ошибка при фильтрации / сортировке" skip
     3443           "Будут показаны записи без учета фильтра" skip
     3444           view-as alert-box .
     3445       end.
     3446       else do:
     3447           assign
     3448             l-query-was-opened = true
     3449           .
     3450       end.
     3451     end.
     3452     if l-filter-open-32 = false then do:
     3453       OPEN QUERY Doc-List FOR EACH buf_schet-fact-doc NO-LOCK
     3454         where  buf_schet-fact-doc.host-code = p-host-code
     3455          by int(buf_schet-fact-doc.doc-code) descending
     3456     .
     3457         assign
     3458           l-query-was-opened = true
     3459         .
     3460     end.
     3461   end.
     3462   else do:
     3463     assign
     3464       v-doc-rec = recid( buf_schet-fact-doc )
     3465     .
     3466     do
     3467     on stop undo, leave
     3468     on error undo, leave
     3469     :
     3470       if query Doc-List:handle:get-buffer-handle(1) = (buffer buf_schet-fact-doc:handle) then do:
     3471         assign
     3472         parameter-2-32 = (if p-find-next then "true":u else "false":u )
     3473         parameter-4-32 =
     3474           "where ":u +  substitute(' buf_schet-fact-doc.host-code = &1 ', p-host-code) + " ":u + where-phrase-32 + " ":u + p-find-condition + " " + ""
     3475         parameter-5-32 = "  "
     3476       .
     3477         run fltopend_fltfindd in this-procedure  (
     3478                             input this-procedure:handle
     3479                             ,input query Doc-List:handle
     3480                             ,input rowid(buf_schet-fact-doc)
     3481                             ,input logical(parameter-2-32)
     3482                             ,input no-lock
     3483                             ,input (buffer buf_schet-fact-doc:handle)
     3484                             ,input parameter-4-32
     3485                             ,input parameter-5-32
     3486                             ) no-error.
     3487         .
     3488         assign
     3489           v-doc-rec = integer(return-value)
     3490           v-fltopend-rowid[1] = ?
     3491         .
     3492       end.
     3493       else do:
     3494         assign
     3495         parameter-2-32 = (if p-find-next then "true":u else "false":u )
     3496         parameter-3-32 =  "FOR EACH buf_schet-fact-doc"
     3497         parameter-4-32 =
     3498           (
     3499             if (" buf_schet-fact-doc.host-code = p-host-code " + " " + where-phrase-32) <> ""
     3500             then  substitute(' buf_schet-fact-doc.host-code = &1 ', p-host-code) + " " + where-phrase-32
     3501             else "true"
     3502           )
     3503         parameter-5-32 = (" " + "" + " " + "" + " " + p-find-condition)
     3504         parameter-6-32 = if sort-phrase-32 = ''
     3505                              then
     3506           (
     3507           " " + "  " +
     3508             " " + sort-column-phrase +
     3509           " " + " by int(buf_schet-fact-doc.doc-code) descending "
     3510           )
     3511                              else
     3512           (
     3513           " " + "  " +
     3514             " " + sort-column-phrase +
     3515           " " + sort-phrase-32
     3516           )
     3517         parameter-7-32 =
     3518           "   "
     3519       .
     3520         run fltopend_fltfindq in this-procedure  (
     3521                             input this-procedure:handle
     3522                             ,input query Doc-List:handle
     3523                             ,input logical(parameter-2-32)
     3524                             ,input no-lock
     3525                             ,input parameter-3-32
     3526                             ,input parameter-4-32
     3527                             ,input parameter-5-32
     3528                             ,input parameter-6-32
     3529                             ,input parameter-7-32
     3530                             ,output v-fltopend-rowid
     3531                             ) no-error.
     3532         .
     3533         v-doc-rec = ?.
     3534       end.
     3535       assign
     3536         l-query-was-opened = true
     3537       .
     3538     end.
     3539   end.
     3540     run waitfram-hide in this-procedure .
     3541         end.
     3542         else do:
     3543   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3544   define variable  l-disable-where-34  as logical   no-undo .
     3545   define variable  l-filter-open-34    as logical   .
     3546   define variable  flt-rec-34       as recid     no-undo .
     3547   define variable  filter-name-34      as character no-undo .
     3548   define variable  where-phrase-34     as character no-undo .
     3549   define variable  sort-phrase-34      as character no-undo .
     3550   define variable  where-phrase-rus-34 as character no-undo .
     3551   define variable  sort-phrase-rus-34  as character no-undo .
     3552     run waitfram-show in this-procedure
     3553       (input "ЖДИТЕ ..."
     3554       ).
     3555   run gbl/flt-get.p
     3556     (input filter-point
     3557     ,output flt-rec-34
