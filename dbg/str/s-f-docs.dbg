     1308         string( buf_schet-fact-doc.cli-type + ' ' + string(buf_schet-fact-doc.cli-code))    COLUMN-LABEL 'Поставщик'  format "x(12)"
     1309         buf_schet-fact-doc.sum-rubl    COLUMN-LABEL 'Сумма'  format "->>>,>>>,>>>,>>9.99"
     1310         buf_schet-fact-doc.cli-name    COLUMN-LABEL 'Наим. поставщика'  Format "X(30)"
