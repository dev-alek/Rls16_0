      444   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      445   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      446     (input  v-report-name
      447     ,input  2
      448     ,output v-exist
      449     )  .
      450       if NOT v-exist then
      451       DO:
      452         Message
      453           "Нет заданий на печать ! "
      454           view-as alert-box .
      455         Return  .
      456       End.
      457       run gbl/prnfilen.w
      458         (input  ""
      459         ,input  p-DisabledOptions
      460         ,input  string(v-report-name )
      461         ,input  7
      462         ,output v-user-action
      463         ,output v-printed
      464         ) .
      465       if v-printed then
      466       do:
      467         return "YES" .
      468       end.
      469       else
      470       do:
      471         return "NO" .
      472       end.
      473     end.
      474   end procedure.
      475   procedure prn-lib-open-stream :
      476     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      477     define input parameter p-page-size    as integer no-undo .
      478     define input parameter p-is-stream    as logical no-undo .
      479     define input parameter p-append       as logical no-undo .
      480     define variable v-report-name as character no-undo .
      481     do
      482       on error undo, return error
      483       :
      484       run prn-lib-get-report-name  in this-procedure (
      485         input parParentProc
      486         ,output v-report-name
      487         ).
      488       if p-is-stream then
      489       do:
      490         if p-append then
      491         do:
      492           output stream PrnLibStream to value( v-report-name )
      493             page-size value(p-page-size) append .
      494         end.
      495         if not p-append then
      496         do:
      497           output stream PrnLibStream to value( v-report-name )
      498             page-size value(p-page-size) .
      499         end.
      500       end.
      501       if not p-is-stream then
      502       do:
      503         if p-append then
      504         do:
      505           output to value( v-report-name )
      506             page-size value(p-page-size) append .
      507         end.
      508         if not p-append then
      509         do:
      510           output to value( v-report-name )
      511             page-size value(p-page-size) .
      512         end.
      513       end.
      514     end.
      515   end procedure.
      516   procedure prn-lib-open-exp :
      517     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      518     define input parameter p-is-stream    as logical no-undo .
      519     define input parameter p-is-append    as logical no-undo .
      520     define output parameter p-ReportFileName as char init "report" no-undo.
      521     define output parameter p-process as logical no-undo .
      522     define variable glog as logical no-undo .
      523     do
      524       on error undo, return error
      525       :
      526       SYSTEM-DIALOG GET-FILE p-ReportFileName
      527         TITLE      "Укажите путь"
      528         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      529         ASK-OVERWRITE
      530         CREATE-TEST-FILE
      531         SAVE-AS
      532         USE-FILENAME
      533         DEFAULT-EXTENSION "txt"
      534         UPDATE glog
      535         .
      536       if not glog then  return.
      537       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      538       if p-is-stream then
      539       do:
      540         if p-is-append then
      541         do:
      542           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      543         end.
      544         else
      545         do:
      546           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      547         end.
      548       end.
      549       else
      550       do:
      551         if p-is-append then
      552         do:
      553           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      554         end.
      555         else
      556         do:
      557           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      558         end.
      559       end.
      560       p-process = yes.
      561     end.
      562   end procedure.
      563   procedure prn-lib-get-report-name :
      564     define input parameter parParentProc  as widget-handle no-undo.
      565     define output parameter p-report-name as character no-undo .
      566     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      567   end procedure.
      568   procedure prn-lib-reportviewer-report-name :
      569     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      570     define input parameter p-report-name-html as character no-undo .
      571     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      572   end procedure.
      573   procedure prn-lib-reportviewer :
      574     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      575     define input parameter p-report-name-html as character no-undo .
      576     define input parameter p-param        as character no-undo .
      577     define variable v-excel           as character no-undo init 'TRUE' .
      578     define variable v-value-character as character no-undo .
      579     define variable v-value-integer   as character no-undo .
      580     define variable v-value-date      as date      no-undo .
      581     define variable v-value-decimal   as decimal   no-undo .
      582     define variable rep-excel         as logical   no-undo .
      583     define variable excel-string      as character no-undo .
      584     define variable v-param-type      as character no-undo .
      585     define variable v-tth             as handle    no-undo .
      586     run adm/shattri.p (
      587       input "get":U
      588       ,input  ""
      589       ,input  0
      590       ,input  'report-glob':U
      591       ,input  'rep-excel':U
      592       ,output v-value-character
      593       ,output v-value-date
      594       ,output v-value-decimal
      595       ,output v-value-integer
      596       ,output rep-excel
      597       ,output v-param-type
      598       ,INPUT-OUTPUT table-handle v-tth
      599       )  .
      600     if rep-excel then v-excel = "TRUE" .
      601     else v-excel = "FALSE" .
      602     if p-param eq ""
      603     then
      604        p-param = "EXCEL:" + v-excel.
      605     else
      606        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      607     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      608   end procedure.
      609   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      610   procedure factord :
      611     define input  parameter p-fact-date            as date    no-undo .
      612     define input  parameter p-fact-time            as integer no-undo .
      613     define input  parameter p-fact-num             as integer no-undo .
      614     define input  parameter p-shift-date           as date    no-undo .
      615     define input  parameter p-shift-num            as integer no-undo .
      616     define input  parameter p-shift-on             as logical no-undo .
      617     define output parameter p-fact-order           as decimal no-undo .
      618     define output parameter p-shift-end-fact-order as decimal no-undo .
      619     define output parameter p-day-end-fact-order   as decimal no-undo .
      620     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      621     if p-fact-date = ?
      622     then do:
      623       return error "Не указана фактическая дата" .
      624     end.
      625     define variable v-fact-date-num as integer no-undo .
      626     assign
      627       v-fact-date-num = integer(p-fact-date)
      628     .
      629     if p-fact-num = ?
      630     or p-fact-num = 0
      631     then do:
      632       return error "Не задан p-fact-num " + string(p-fact-num) .
      633     end.
      634     if p-fact-num < 0
      635     then do:
      636       return error "Отрицательный fact-num " + string(p-fact-num) .
      637     end.
      638     if p-fact-num >= 100000000
      639     then do:
      640       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      641     end.
      642     if p-shift-on = true
      643     then do:
      644       if p-shift-date = ?
      645       then do:
      646         return error "Не задана дата смены" .
      647       end.
      648       if p-shift-num = ?
      649       or p-shift-num = 0
      650       then do:
      651         return error "Не задан номер смены" .
      652       end.
      653     end.
      654     else do:
      655       assign
      656         p-shift-date = p-fact-date
      657         p-shift-num  = 24
      658       .
      659     end.
      660     define variable v-shift-offset as integer no-undo .
      661     if p-shift-date = p-fact-date
      662     then do:
      663       assign
      664         v-shift-offset = 1
      665       .
      666     end.
      667     if p-shift-date < p-fact-date
      668     then do:
      669       assign
      670         v-shift-offset = 0
      671       .
      672     end.
      673     if p-shift-date > p-fact-date
      674     then do:
      675       message
      676         vss-workfile vss-revision vss-description skip
      677         "Неправильная дата закрытия смены" skip
      678         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      679         view-as alert-box error .
      680       undo, return error
      681         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      682           ,string(p-fact-date, '99/99/9999':U)
      683           ,string(p-shift-date, '99/99/9999':U)
      684           )
      685       .
      686     end.
      687     if p-shift-num < 1
      688     or p-shift-num > 24
      689     then do:
      690       message
      691         vss-workfile vss-revision vss-description skip
      692         "Неправильный номер смены" skip
      693         "p-shift-num" p-shift-num skip
      694         view-as alert-box error .
      695       undo, return error return-value .
      696     end.
      697     assign
      698       p-fact-order           = v-fact-date-num
      699                              + v-shift-offset * 0.5
      700                              + p-shift-num    * 0.02 - 0.01
      701                              + p-fact-num     * 0.0000000001
      702       p-shift-end-fact-order = v-fact-date-num
      703                              + v-shift-offset * 0.5
      704                              + p-shift-num    * 0.02
      705       p-day-end-fact-order   = v-fact-date-num
      706                              + 0.99
      707     .
      708     if p-fact-order           <= v-fact-date-num
      709     or p-shift-end-fact-order <= v-fact-date-num
      710     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      711     or p-shift-end-fact-order >= p-day-end-fact-order
      712     then do:
      713       message
      714         vss-workfile vss-revision vss-description skip
      715         "Внутренняя ошибка при генерации фактического номера" skip
      716         "p-fact-date"            p-fact-date            skip
      717         "p-fact-time"            p-fact-time            skip
      718         "p-fact-num"             p-fact-num             skip
      719         "p-shift-date"           p-shift-date           skip
      720         "p-shift-num"            p-shift-num            skip
      721         "p-shift-on"             p-shift-on             skip
      722         "p-shift-end-fact-order" p-shift-end-fact-order skip
      723         "p-day-end-fact-order"   p-day-end-fact-order   skip
      724         "v-fact-date-num"        v-fact-date-num        skip
      725         view-as alert-box error .
      726       undo, return error return-value .
      727     end.
      728   end procedure.
      729   procedure day-begin-fact-order :
      730     define input  parameter p-fact-date            as date    no-undo .
      731     define output parameter p-day-begin-fact-order as decimal no-undo .
      732     do
      733     on error undo, return error return-value
      734     :
      735       if p-fact-date = ?
      736       then do:
      737         assign
      738           p-day-begin-fact-order = 0
      739         .
      740       end.
      741       else do:
      742         assign
      743           p-day-begin-fact-order = integer(p-fact-date)
      744         .
      745       end.
      746     end.
      747   end procedure.
      748   procedure factord-max-fact-order :
      749     define output parameter p-max-fact-order as decimal   no-undo .
      750     do
      751     on error undo, return error return-value
      752     :
      753       run day-begin-fact-order in this-procedure
      754         (input  date(1, 1, 5000)
      755         ,output p-max-fact-order
      756         ) .
      757     end.
      758   end procedure.
      759   procedure factord-cut-archive :
      760     define input  parameter p-obj-type             as character no-undo .
      761     define input  parameter p-obj-code             as integer   no-undo .
      762     define input  parameter p-fact-date            as date      no-undo .
      763     define output parameter p-shift-on             as logical   no-undo .
      764     define output parameter p-shift-date           as date      no-undo .
      765     define output parameter p-shift-num            as integer   no-undo .
      766     define output parameter p-day-end-fact-order   as decimal   no-undo .
      767     define output parameter p-shift-end-fact-order as decimal   no-undo .
      768     define variable v-fact-order as decimal   no-undo .
      769     define buffer buf_shift-obj for ub.shift-obj .
      770     do
      771     on error undo, return error return-value
      772     :
      773   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      774   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      775     (input  p-obj-type
      776     ,input  p-obj-code
      777     ,input  'shift-on=request'
      778     ,output p-shift-on
      779     ) no-error .
      780       if error-status :error
      781       then do:
      782         message
      783           vss-workfile vss-revision vss-description skip
      784           "Ошибка при определении атрибута объекта" skip
      785           "Объект" p-obj-type p-obj-code skip
      786           error-status :get-message(1) skip
      787           return-value skip
      788           view-as alert-box error .
      789         undo, return error return-value .
      790       end.
      791       if p-shift-on = false
      792       then do:
      793         assign
      794           p-shift-date               = ?
      795           p-shift-num                = 0
      796         .
      797       end.
      798       else do:
      799         find first buf_shift-obj share-lock
      800           where buf_shift-obj.obj-type   = p-obj-type
      801             and buf_shift-obj.obj-code   = p-obj-code
      802             and buf_shift-obj.shift-date > p-fact-date
      803           use-index pi
      804           no-error .
      805         if not available buf_shift-obj
      806         or buf_shift-obj.status_ <> 'зкр':U
      807         then do:
      808           message
      809             vss-workfile vss-revision vss-description skip
      810             "Невозможно вычислить последнюю смену" skip
      811             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      812             "Объект" p-obj-type p-obj-code skip
      813             "Дата" p-fact-date skip
      814             view-as alert-box error .
      815           undo, return error return-value .
      816         end.
      817         find last buf_shift-obj share-lock
      818           where buf_shift-obj.obj-type = p-obj-type
      819             and buf_shift-obj.obj-code = p-obj-code
      820             and buf_shift-obj.shift-date <= p-fact-date
      821           use-index pi
      822           no-error .
      823         if available buf_shift-obj
      824         then do:
      825           if  buf_shift-obj.status_ = 'зкр':U
      826           then do:
      827             assign
      828               p-shift-date = buf_shift-obj.shift-date
      829               p-shift-num  = buf_shift-obj.shift-num
      830             .
      831           end.
      832           else do:
      833             message
      834               vss-workfile vss-revision vss-description skip
      835               "Невозможно вычислить последнюю смену" skip
      836               "Статус смены отличен от статуса" 'зкр':U skip
      837               "Объект" p-obj-type p-obj-code skip
      838               "Дата" p-fact-date skip
      839               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      840               view-as alert-box error .
      841             undo, return error return-value .
      842           end.
      843         end.
      844         else do:
      845           assign
      846             p-shift-date = p-fact-date - 1
      847             p-shift-num  = 1
      848           .
      849         end.
      850       end.
      851       run factord in this-procedure
      852         (input  p-fact-date
      853         ,input  1
      854         ,input  1
      855         ,input  p-shift-date
      856         ,input  p-shift-num
      857         ,input  p-shift-on
      858         ,output v-fact-order
      859         ,output p-shift-end-fact-order
      860         ,output p-day-end-fact-order
      861         ) no-error .
      862       if error-status :error
      863       then do:
      864         message
      865           vss-workfile vss-revision vss-description skip
      866           "Ошибка при вызове процедуры factord"
      867           error-status :get-message(1) skip
      868           return-value skip
      869           view-as alert-box error .
      870         undo, return error return-value .
      871       end.
      872     end.
      873   end procedure.
      874   procedure factord-lock-shift :
      875     define input  parameter p-obj-type  as character no-undo .
      876     define input  parameter p-obj-code  as integer   no-undo .
      877     define input  parameter p-fact-date as date      no-undo .
      878     define parameter buffer buf_shift-obj for ub.shift-obj .
      879     define variable v-shift-on      as logical   no-undo .
      880     define variable v-extra-message as character no-undo .
      881     define variable v-error as character no-undo .
      882     do
      883     on error undo, return error return-value
      884     :
      885   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      886   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      887     (input  p-obj-type
      888     ,input  p-obj-code
      889     ,input  'shift-on=request'
      890     ,output v-shift-on
      891     ) no-error .
      892       if error-status :error
      893       then do:
      894         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      895         undo, return error v-error .
      896       end.
      897       if v-shift-on = true
      898       then do:
      899         find first buf_shift-obj share-lock
      900           where buf_shift-obj.obj-type   = p-obj-type
      901             and buf_shift-obj.obj-code   = p-obj-code
      902             and buf_shift-obj.shift-date > p-fact-date
      903           use-index pi
      904           no-error .
      905         if not available buf_shift-obj
      906         or buf_shift-obj.status_ <> 'зкр':U
      907         then do:
      908           find last buf_shift-obj
      909             where buf_shift-obj.obj-type = p-obj-type
      910               and buf_shift-obj.obj-code = p-obj-code
      911               and buf_shift-obj.status_  = 'зкр':U
      912             use-index stts
      913             no-error .
      914           if available buf_shift-obj
      915           then do:
      916             assign
      917               v-extra-message =
      918                     substitute("Дата начала последеней закрытой смены на объекте &1"
      919                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      920                               )
      921             .
      922           end.
      923           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      924           undo, return error v-error .
      925         end.
      926       end.
      927     end.
      928   end procedure.
      929   procedure factord-end-day :
      930     define input  parameter p-fact-date            as date    no-undo .
      931     define output parameter p-day-end-fact-order   as decimal no-undo .
      932     do
      933     on error undo, return error return-value
      934     :
      935       if p-fact-date = ?
      936       then do:
      937         return error "Не указана фактическая дата" .
      938       end.
      939       assign
      940         p-day-end-fact-order = integer(p-fact-date) + 0.99
      941       .
      942     end.
      943   end procedure.
      944   procedure factord-to-date :
      945     define input  parameter p-fact-order as decimal no-undo .
      946     define output parameter p-fact-date  as date    no-undo .
      947     define variable v-ref-date  as date      no-undo .
      948     define variable v-ref-delta as integer   no-undo .
      949     do
      950     on error undo, return error return-value
      951     :
      952       if p-fact-order = ?
      953       or p-fact-order = 0
      954       then do:
      955         return error "Не указан fact-order" .
      956       end.
      957       assign
      958         v-ref-date  = date(1, 1, 2000)
      959       .
      960       assign
      961         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      962       .
      963       assign
      964         p-fact-date = v-ref-date + v-ref-delta
      965       .
      966     end.
      967   end procedure.
      968   procedure factord-to-fact-num :
      969     define input  parameter p-fact-order as decimal no-undo .
      970     define output parameter p-fact-num   as integer no-undo .
      971     define variable v-fact-order-trunc as decimal no-undo .
      972     do
      973     on error undo, return error return-value
      974     :
      975       if p-fact-order = ?
      976       or p-fact-order = 0
      977       then do:
      978         return error "Не указан fact-order" .
      979       end.
      980       assign
      981        v-fact-order-trunc = truncate(p-fact-order, 2)
      982       .
      983       assign
      984         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      985       .
      986     end.
      987   end procedure.
      988   procedure factord-to-shift-num :
      989     define input  parameter p-fact-order as decimal no-undo .
      990     define output parameter p-shift-num   as integer no-undo .
      991     define variable  p-shift-numd  as decimal   no-undo .
      992     define variable v-fact-order-trunc as decimal no-undo .
      993     do
      994     on error undo, return error return-value
      995     :
      996       if p-fact-order = ?
      997       or p-fact-order = 0
      998       then do:
      999         return error "Не указан fact-order" .
     1000       end.
     1001       assign
     1002        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1003       .
     1004       if v-fact-order-trunc < 0.5 then do:
     1005         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1006       end.
     1007       assign
     1008         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1009         .
     1010        assign
     1011         p-shift-num = truncate (p-shift-numd , 0)
     1012       .
     1013     end.
     1014   end procedure.
     1015   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1016     define variable v-cntxt-db-num        as integer   no-undo .
     1017     define variable v-cntxt-userid        as character no-undo .
     1018     define variable v-cntxt-level         as character no-undo .
     1019     define variable v-cntxt-host-code-obj as integer   no-undo .
     1020     define variable v-cntxt-obj-type      as character no-undo .
     1021     define variable v-cntxt-obj-code      as integer   no-undo .
     1022     define variable v-cntxt-db-num-obj    as integer   no-undo .
