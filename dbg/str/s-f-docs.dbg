     1718       end.
     1719       else do:
     1720         define variable ii as integer   no-undo .
     1721         do ii = 1 to num-entries (cli-list):
     1722           find first ub.clients no-lock where recid(ub.clients) = integer (entry (ii, cli-list)) .
     1723           assign
     1724             p-cli-type = ub.clients.obj-type
     1725             p-cli-code = ub.clients.obj-code
     1726           .
     1727         end.
     1728       end.
     1729     end .
     1730     RUN OpenBr(yes, no, '':U) .
     1731   END.
