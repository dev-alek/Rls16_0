     1314         usrfulnf(buf_schet-fact-doc.user-name)   COLUMN-LABEL 'Оператор' Format "X(15)"
     1315         enable buf_schet-fact-doc.doc-date
     1316       WITH NO-ROW-MARKERS SEPARATORS SIZE 99 BY 19.13.
