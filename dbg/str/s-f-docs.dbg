     1432       ,input  '':U
     1433       ,input  0
     1434       ,input  0
     1435       ,input  0
     1436       ,input  0
     1437       ,input  true
     1438       ,output g-log
     1439       )  .
     1440   end.
     1441     if not g-log then  return .
     1442     if  mark-num = 0 then do:
     1443       message "Закрыть cчет-фактуру № " buf_schet-fact-doc.doc-code "?" view-as alert-box QUESTION BUTTONS YES-NO update g-log .
     1444       if g-log = no then return no-apply.
