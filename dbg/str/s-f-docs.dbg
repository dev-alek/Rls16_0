     5042         v-doc-rec = ?.
     5043       end.
     5044       assign
     5045         l-query-was-opened = true
     5046       .
     5047     end.
     5048   end.
     5049     run waitfram-hide in this-procedure .
     5050     end.
     5051     otherwise do:
     5052       message "Не верно задан параметр p-mode = " p-mode view-as alert-box error .
     5053     end.
     5054     end case.
     5055     REPOSITION Doc-List to recid v-doc-rec No-ERROR.
     5056     display mark-num  with frame Dialog-Frame.
     5057   END PROCEDURE.
     5058   PROCEDURE proc-find-code :
     5059     define input parameter p-next as logical no-undo.
     5060     define input parameter p-code as character no-undo .
     5061     assign p-code = chr(34) + p-code + chr(34).
     5062     run OpenBr in this-procedure (input false, input p-next, input substitute("and buf_schet-fact-doc.doc-code = &1 ", p-code)).
     5063   END PROCEDURE.
     5064   PROCEDURE proc-find-doc-code :
     5065     define input parameter p-next as logical no-undo.
     5066     define input parameter p-code as character no-undo .
     5067     assign p-code = chr(34) + p-code + chr(34).
     5068     run OpenBr in this-procedure ( input false, input true , input substitute(" and buf_schet-fact-doc.in-doc-code = &1 ", p-code )).
     5069   END PROCEDURE.
     5070   FUNCTION mark-string RETURNS CHARACTER
     5071     ( input par-recid as recid ) :
     5072     define variable ret as character no-undo .
     5073     assign ret = "" .
     5074     find first temp-conn where temp-conn.ri = par-recid no-error .
     5075     if available temp-conn then assign ret = "*" .
     5076     RETURN ret .
     5077   END FUNCTION.
     5078   procedure proc-del :
     5079     define input  parameter p-ri as recid   no-undo .
     5080     do on error undo, return error return-value :
     5081       define buffer buf_factur-connect  for ub.factur-connect.
     5082       define buffer buf_schet-fact-line for ub.schet-fact-line.
     5083       do transaction :
     5084         find first ub.schet-fact-doc exclusive-lock where recid(ub.schet-fact-doc) = p-ri no-error .
     5085         if available ub.schet-fact-doc then do:
     5086           if ub.schet-fact-doc.status_ = 'факт':U then do:
     5087             message "Удалять закрытый счет-фактуру " string(ub.schet-fact-doc.doc-code) " нельзя!" view-as alert-box.
     5088             return error.
     5089           end.
     5090           if ub.schet-fact-doc.db-num <> v-cntxt-db-num and v-cntxt-db-num > 0 then do:
     5091             message "Удалять счет-фактуру другой БД нельзя!" string(ub.schet-fact-doc.doc-code) " нельзя!" view-as alert-box.
     5092             return error.
     5093           end.
     5094           define buffer buf_c-schet-fact-doc for ub.c-schet-fact-doc.
     5095           create buf_c-schet-fact-doc .
     5096           BUFFER-COPY ub.schet-fact-doc TO buf_c-schet-fact-doc .
     5097   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5098   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
     5099     (output buf_c-schet-fact-doc.corr-user-db-num
     5100     ,output buf_c-schet-fact-doc.corr-user-name
     5101     ,output buf_c-schet-fact-doc.corr-date
     5102     ,output p-sys-time
     5103     ,output buf_c-schet-fact-doc.corr-time
     5104     )  .
     5105           assign buf_c-schet-fact-doc.chip-num = next-value (s-corr-chip, ub) .
     5106           delete ub.schet-fact-doc .
     5107         end.
     5108       end.
     5109     end.
     5110   end procedure.
     5111   procedure proc-close :
     5112     define input  parameter p-ri as recid   no-undo .
     5113     do on error undo, return error return-value :
     5114       define variable v-shift-end-fact-order as decimal   no-undo .
     5115       define variable v-day-end-fact-order   as decimal   no-undo .
     5116       do transaction :
     5117         find first ub.schet-fact-doc exclusive-lock where recid(ub.schet-fact-doc) = p-ri no-error .
     5118         if available ub.schet-fact-doc then do:
     5119           if ub.schet-fact-doc.status_ = 'факт':U then do:
     5120             message "Счет-фактура " string(ub.schet-fact-doc.doc-code) " уже закрыт!" view-as alert-box.
     5121             return error.
     5122           end.
     5123   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5124   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
     5125     (output ub.schet-fact-doc.fact-user-db-num
     5126     ,output ub.schet-fact-doc.fact-user-name
     5127     ,output ub.schet-fact-doc.fact-date
     5128     ,output p-sys-time
     5129     ,output ub.schet-fact-doc.fact-time
     5130     )  .
     5131           run factord (
     5132             input  ub.schet-fact-doc.fact-date
     5133            ,input  ub.schet-fact-doc.fact-time
     5134            ,input  int(ub.schet-fact-doc.doc-code)
     5135            ,input  ?
     5136            ,input  ?
     5137            ,input  no
     5138            ,output ub.schet-fact-doc.fact-order
     5139            ,output v-shift-end-fact-order
     5140            ,output v-day-end-fact-order
     5141           ).
     5142           assign ub.schet-fact-doc.status_ = 'факт':U  .
     5143         end.
     5144       end.
     5145     end.
     5146   end procedure.
     5147   procedure proc-open :
     5148     define input  parameter p-ri as recid   no-undo .
     5149     do on error undo, return error return-value :
     5150       do transaction :
     5151         find first ub.schet-fact-doc exclusive-lock where recid(ub.schet-fact-doc) = p-ri no-error .
     5152         if available ub.schet-fact-doc then do:
     5153             if ub.schet-fact-doc.db-num <> 0 and
     5154               v-cntxt-db-num = 0 then do:
     5155               message "Открывать на изменение  счет-фактуру чужой БД нельзя! " view-as alert-box .
     5156               return error.
     5157             end.
     5158            if ub.schet-fact-doc.status_ = 'новый':U then do:
     5159              message "Счет-фактура " string(ub.schet-fact-doc.doc-code) " уже открыт!" view-as alert-box.
     5160              return error.
     5161           end.
     5162   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5163   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
     5164     (output ub.schet-fact-doc.fact-user-db-num
     5165     ,output ub.schet-fact-doc.fact-user-name
     5166     ,output p-sys-date
     5167     ,output p-sys-time
     5168     ,output p-sys-time-int
     5169     )  .
     5170           assign
     5171             ub.schet-fact-doc.status_    = 'новый':U
     5172             ub.schet-fact-doc.fact-date  = ?
     5173             ub.schet-fact-doc.fact-order = ?
     5174           .
     5175         end.
     5176       end.
     5177     end.
     5178   end procedure.
     5179   PROCEDURE proc-b-exp :
     5180     define variable v-file-name as character no-undo .
     5181     define variable v-sys-key   as character         no-undo.
     5182   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     5183   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     5184     (output v-sys-key
     5185     ) no-error .
     5186     assign  v-file-name =  ? .
     5187     run str/xml-s-f.p (input parParentProc, input buf_schet-fact-doc.host-code, input  buf_schet-fact-doc.doc-code, input-output v-file-name, yes, yes) no-error .
     5188     if error-status:error then do:
     5189       message   "Ошибка при выгрузке счета-фактуры в XML-формате"  view-as alert-box .
     5190       return error .
     5191     end.
     5192     if search ("exmldoc.bat") <> ? then do:
     5193       os-command silent value(search ("exmldoc.bat") + " " + v-file-name + " " + v-sys-key).
     5194     end.
     5195     else do:
     5196       if search (v-file-name ) <> ? then message "Документ " buf_schet-fact-doc.doc-code " выгружен в файл " v-file-name view-as alert-box.
     5197     end.
     5198   END PROCEDURE.
