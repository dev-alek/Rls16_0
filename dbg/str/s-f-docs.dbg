     1041   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1042   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1043   procedure fltopend_fltopend :
     1044   define input parameter p-parent-handle as handle no-undo .
     1045   define input parameter p-qh as handle no-undo .
     1046   define input parameter p-flt-open-open-query  as character no-undo .
     1047   define input parameter p-where-cond as character no-undo .
     1048   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1049   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1050   define input parameter p-indexed-reposition as character no-undo .
     1051     do
     1052     on error undo, return error
     1053     :
     1054   define variable v-prepare-string as character no-undo .
     1055   define variable glog as logical no-undo .
     1056   assign
     1057   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1058                      p-where-cond + chr(32)  +
     1059                      p-use-indFIRST-query-tail + chr(32) +
     1060                      p-use-ind-sort-clmn-by + chr(32) +
     1061                      p-indexed-reposition
     1062   .
     1063   assign
     1064   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1065   if not glog
     1066   or error-status:error then do:
     1067     message error-status:get-message(1) view-as alert-box .
     1068     undo, return error .
     1069   end.
     1070   assign
     1071   glog = p-qh:query-open no-error .
     1072   if not glog
     1073   or error-status:error then do:
     1074     message error-status:get-message(1) view-as alert-box .
     1075     undo, return error .
     1076   end.
     1077     end.
     1078   end procedure.
     1079   procedure fltopend_fltfindd :
     1080   define input parameter p-parent-handle as handle no-undo .
     1081   define input parameter p-qh as handle no-undo .
     1082   define input parameter p-rowid as rowid no-undo .
     1083   define input parameter p-next as logical no-undo .
     1084   define input parameter p-lock as integer no-undo .
     1085   define input parameter p-bh as handle no-undo .
     1086   define input parameter p-where-cond as character no-undo .
     1087   define input parameter p-use-index-phrase as character no-undo .
     1088   define variable glog as logical no-undo .
     1089   define variable v-qh as handle no-undo .
     1090   define variable v-bh as handle no-undo .
     1091   define variable v-recid as recid no-undo .
     1092   define variable v-prepare-string as character no-undo .
     1093   do
     1094   on error undo, return error
     1095   on stop undo, return error
     1096   :
     1097     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1098     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1099     create query v-qh.
     1100     v-qh:set-buffers(v-bh).
     1101     v-prepare-string = substitute("for each &1 &2 &3"
     1102                                     ,v-bh:name
     1103                                     ,p-where-cond
     1104                                     ,p-use-index-phrase).
     1105     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1106     if not glog then do:
     1107       delete object v-qh.
     1108       delete object v-bh.
     1109       undo, return error .
     1110     end.
     1111     glog = v-qh:query-open no-error .
     1112     if not glog then do:
     1113       delete object v-qh.
     1114       delete object v-bh.
     1115       undo, return error .
     1116     end.
     1117     if p-next then do:
     1118       v-qh:reposition-to-rowid(p-rowid) no-error .
     1119       glog = v-qh:get-next( p-lock) no-error .
     1120       glog = v-qh:get-next( p-lock) no-error .
     1121       if not glog or v-qh:query-off-end = yes then do:
     1122         glog = v-qh:get-first( p-lock) no-error .
     1123       end.
     1124     end.
     1125     else do:
     1126       glog = v-qh:get-first( p-lock) no-error .
     1127     end.
     1128     v-recid = v-bh:recid no-error .
     1129     delete object v-qh.
     1130     delete object v-bh.
     1131     return string(v-recid) .
     1132   end.
     1133   end procedure.
     1134   procedure fltopend_fltfindq :
     1135   define input parameter p-parent-handle as handle no-undo .
     1136   define input parameter p-qh as handle no-undo .
     1137   define input parameter p-next as logical no-undo .
     1138   define input parameter p-lock as integer no-undo .
     1139   define input parameter p-flt-open-open-query  as character no-undo .
     1140   define input parameter p-where-cond as character no-undo .
     1141   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1142   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1143   define input parameter p-indexed-reposition as character no-undo .
     1144   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1145   define variable glog as logical no-undo .
     1146   define variable v-qh as handle no-undo .
     1147   define variable v-bh as handle no-undo extent 18.
     1148   define variable v-rowid as rowid no-undo extent 18.
     1149   define variable v-ii as integer no-undo .
     1150   define variable v-prepare-string as character no-undo .
     1151   do
     1152   on error undo, return error
     1153   on stop undo, return error
     1154   :
     1155     create query v-qh.
     1156     do v-ii = 1 to p-qh:num-buffers:
     1157       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1158       assign
     1159       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1160       no-error.
     1161       v-qh:add-buffer(v-bh[v-ii]).
     1162     end.
     1163     assign
     1164     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1165                       p-where-cond + chr(32)  +
     1166                       p-use-indFIRST-query-tail + chr(32) +
     1167                       p-use-ind-sort-clmn-by + chr(32) +
     1168                       p-indexed-reposition
     1169     .
     1170     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1171     if not glog then do:
     1172       delete object v-qh.
     1173       do v-ii = 1 to p-qh:num-buffers:
     1174         delete object v-bh[v-ii].
     1175       end.
     1176       undo, return error .
     1177     end.
     1178     glog = v-qh:query-open no-error .
     1179     if not glog then do:
     1180       delete object v-qh.
     1181       do v-ii = 1 to p-qh:num-buffers:
     1182         delete object v-bh[v-ii].
     1183       end.
     1184       undo, return error .
     1185     end.
     1186     if p-next then do:
     1187       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1188       glog = v-qh:get-next( p-lock) no-error .
     1189       glog = v-qh:get-next( p-lock) no-error .
     1190       if not glog or v-qh:query-off-end = yes then do:
     1191         glog = v-qh:get-first( p-lock) no-error .
     1192       end.
     1193     end.
     1194     else do:
     1195       glog = v-qh:get-first( p-lock) no-error .
     1196     end.
     1197     do v-ii = 1 to p-qh:num-buffers:
     1198       assign
     1199       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1200       no-error.
     1201     end.
     1202     delete object v-qh.
     1203     do v-ii = 1 to p-qh:num-buffers:
     1204       delete object v-bh[v-ii].
     1205     end.
     1206   end.
     1207   end procedure.
     1208   define buffer buf_schet-fact-doc  for ub.schet-fact-doc .
     1209   define variable p-type    as character no-undo .
     1210   define variable v-doc-rec as recid no-undo .
     1211   define variable sort-column-name as character no-undo .
     1212   define variable f-name    as character no-undo .
     1213   define variable is-new    as logical  initial no  no-undo .
     1214   define variable is-new1   as logical  initial no  no-undo .
     1215   define variable v-res     as logical  initial no  no-undo .
     1216   define variable g-log     as logical   no-undo .
     1217   define variable b-code    as integer   no-undo .
     1218   define variable cli-list  as character no-undo .
     1219   define variable cont-list as character no-undo .
     1220   define variable  p-sys-date     as date      no-undo .
     1221   define variable  p-sys-time     as character no-undo .
     1222   define variable  p-sys-time-int as integer   no-undo .
     1223   define variable filter-point as character no-undo init "Список счетов-фактур" .
     1224     DEFINE temp-table temp-conn no-undo
     1225       field   ri             as  recid
     1226       INDEX pi  IS PRIMARY   ri
     1227     .
     1228   FUNCTION mark-string RETURNS CHARACTER
     1229     ( input par-recid as recid )  FORWARD.
     1230   DEFINE BUTTON B-add
     1231        LABEL "&Добавить"
     1232        SIZE 10 BY 1.
     1233   DEFINE BUTTON b-chg
     1234        LABEL "&Изменить"
     1235        SIZE 10 BY 1.
     1236   DEFINE BUTTON B-close
     1237        LABEL "&Закрыть"
     1238        SIZE 10 BY 1.
     1239   DEFINE BUTTON B-open
     1240        LABEL "&Открыть"
     1241        SIZE 10 BY 1.
     1242   DEFINE BUTTON B-del
     1243        LABEL "&Удалить"
     1244        SIZE 10 BY 1.
     1245   DEFINE BUTTON B-book
     1246        LABEL "&Книга"
     1247        SIZE 10 BY 1.
     1248   DEFINE BUTTON b-exp
     1249        LABEL "&Экспорт"
     1250        SIZE 10 BY 1.
     1251   DEFINE BUTTON b-gen
     1252        LABEL "&Генерация"
     1253        SIZE 10 BY 1.
     1254   DEFINE BUTTON B-Help
     1255        LABEL "Помо&щь"
     1256        SIZE 10 BY 1
     1257        BGCOLOR 8 .
     1258   DEFINE BUTTON b-sch
     1259        LABEL "&Фильтр"
     1260        SIZE 10 BY 1.
     1261   DEFINE BUTTON b-hist
     1262        LABEL "Ис&тория"
     1263        SIZE 10 BY 1.
     1264   DEFINE BUTTON b-lkp
     1265        LABEL "&Просмотр"
     1266        SIZE 10 BY 1.
     1267   DEFINE BUTTON B-mark
     1268        LABEL "&*"
     1269        SIZE 3 BY 1.
     1270   DEFINE BUTTON B-print
     1271        LABEL "Пе&чать"
     1272        SIZE 10 BY 1.
     1273   DEFINE BUTTON b-quit AUTO-END-KEY
     1274        LABEL "&Выход"
     1275        SIZE 10 BY 1
     1276        BGCOLOR 8 .
     1277   DEFINE VARIABLE mark-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1278         VIEW-AS TEXT
     1279        SIZE 6 BY 1 NO-UNDO.
     1280   DEFINE VARIABLE sch-str as character FORMAT "X(16)" INITIAL ""
     1281        VIEW-AS FILL-IN
     1282        SIZE 13 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J> по номеру СФ" NO-UNDO.
     1283   DEFINE VARIABLE sch-str-2 as character FORMAT "X(16)" INITIAL ""
     1284        VIEW-AS FILL-IN
     1285        SIZE 13 BY 1 TOOLTIP "Поиск по номеру документа" NO-UNDO.
     1286   DEFINE VARIABLE Sel-Client AS CHARACTER INITIAL "all"
     1287        VIEW-AS RADIO-SET HORIZONTAL
