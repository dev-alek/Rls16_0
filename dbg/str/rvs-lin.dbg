     1286   define   shared variable g#esys-source-esys as integer no-undo.
     1287   define   shared variable g#db-num as integer   no-undo .
     1288   define   shared variable g#userid as character no-undo .
     1289   define   shared variable g#passwd as character no-undo .
     1290   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1291   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1292   define variable par-type          as character no-undo.
     1293   define variable v-value-character as character no-undo .
     1294   define variable v-value-date      as date      no-undo .
     1295   define variable v-value-decimal   as decimal   no-undo .
     1296   define variable v-value-integer   as integer   no-undo .
     1297   define variable v-value-logical   as logical   no-undo .
     1298   define variable v-initiator  as character no-undo.
     1299   case true:
     1300     when g#auto then v-initiator = "Auto".
     1301     when g#news then v-initiator = "Nws".
     1302     when g#esys then v-initiator = "Esys".
