     1323   function MM6 returns logical
     1324     (
     1325     input H as decimal,
     1326     input H_water as decimal,
     1327     input CalibrationTable as character,
     1328     input CalibrationBelt as character,
     1329     input P0 as decimal,
     1330     input Tv as decimal,
     1331     input Tr as decimal,
     1332     input R as decimal,
     1333     input Tcy as decimal,
     1334     input ToolType as integer,
     1335     input DeltaOtn_K as decimal,
     1336     input DeadZone_Reservoir as decimal,
     1337     input A_Reservoir as decimal,
     1338     input A_LevelMeasurementTool as decimal,
     1339     input ToolAutomationLevel_H as integer,
     1340     input ToolAutomationLevel_H_Water as integer,
     1341     input ToolAutomationLevel_R as integer,
     1342     input ToolAutomationLevel_Tv as integer,
     1343     input ToolAutomationLevel_Tr as integer,
     1344     input DeltaAbs_H_CalcType as integer,
     1345     input DeltaAbs_H_Water_CalcType as integer,
     1346     input DeltaAbs_H as decimal,
     1347     input DeltaAbs_H_Water as decimal,
     1348     input DeltaAbs_R as decimal,
     1349     input DeltaAbs_Tv as decimal,
     1350     input DeltaAbs_Tr as decimal,
     1351     input DeltaOtn_N as decimal,
     1352     input Round_M as integer,
     1353     input Round_T as integer,
     1354     input Round_R as integer,
     1355     output V_total as decimal,
     1356     output V_water as decimal,
     1357     output DeltaV as decimal,
     1358     output V_product as decimal,
     1359     output Vcy as decimal,
     1360     output Rcy as decimal,
     1361     output V as decimal,
     1362     output CTL_base_alt as decimal,
     1363     output CPL_base_alt as decimal,
     1364     output CTPL_base_alt as decimal,
     1365     output Fp_base_alt as decimal,
     1366     output CTL_obs_base as decimal,
     1367     output CPL_obs_base as decimal,
     1368     output CTPL_obs_base as decimal,
     1369     output Fp_obs_base as decimal,
     1370     output Rv as decimal,
     1371     output DeltaOtn_Vcy as decimal,
     1372     output DeltaOtn_Vm as decimal,
     1373     output M as decimal,
     1374     output DeltaOtn_M as decimal,
     1375     output VolumetricExpansion as decimal,
     1376     output Err as character,
     1377     output Wrn as character,
     1378     output DllVersion as character
     1379     )
     1380   :
     1381     define variable libName as character no-undo .
     1382     define variable hCall   AS handle    no-undo .
     1383     define variable mErr as memptr no-undo .
     1384     define variable mWrn as memptr no-undo .
     1385     define variable mDllVersion as memptr no-undo .
     1386     SET-SIZE(mErr) = 1024 .
     1387     SET-SIZE(mWrn) = 1024 .
     1388     SET-SIZE(mDllVersion) = 20 .
     1389     libName = search("exe/MM.dll") .
     1390     create call hCall.
     1391     assign
     1392       hCall:CALL-NAME      = "MethodCt6"
     1393       hCall:LIBRARY        = libName
     1394       hCall:CALL-TYPE      = DLL-CALL-TYPE
     1395       hCall:NUM-PARAMETERS = 56
