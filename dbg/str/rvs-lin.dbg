     5072            and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     5073            and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     5074            and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
