        1   DEFINE TEMP-TABLE tt-rvs-line NO-UNDO LIKE rvs-line
        2   field meas-calc-qnty     AS DECIMAL FORMAT "->>,>>>,>>9":U INITIAL 0
        3   field meas-calc-dens     AS DECIMAL FORMAT "9.9999":U INITIAL 0
        4   field meas-cli-calc-qnty AS DECIMAL FORMAT "->>,>>>,>>9":U INITIAL 0
        5   field izmer-density      AS DECIMAL FORMAT "9.9999":U INITIAL 0 decimals 10
        6   field calc-add-mass      AS DECIMAL FORMAT "->>,>>>,>>9.9":U INITIAL 0
        7   field sum-mass           AS DECIMAL FORMAT "->>,>>>,>>9.9":U INITIAL 0
        8   field sum-vol            AS DECIMAL FORMAT "->>,>>>,>>9":U INITIAL 0
