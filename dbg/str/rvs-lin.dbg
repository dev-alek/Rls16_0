     5381   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5382   run get-ptrl-prop in this-procedure
     5383     ( input tt-rvs-line.obj-type
     5384     , input tt-rvs-line.obj-code
     5385     ) .
     5386   if buf_rvs-doc.rvs-type = 'перед_док':U
     5387   then do :
     5388   if ptrlprop-calc-free-vol then do:
     5389     define variable infoSectionsTotal as class ibs.th.str.InfoSectionsTotal no-undo.
     5390     define variable iisec as integer no-undo .
     5391     define variable v-doc-volume as decimal no-undo init 0.0 .
     5392     define buffer buf_trn-doc for ub.trn-doc .
     5393     find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_rvs-doc.out-code no-error .
     5394     find first buf_place no-lock where buf_place.obj-code = tt-rvs-line.obj-code
     5395                                    and buf_place.obj-type = tt-rvs-line.obj-type
     5396                                    and buf_place.pl-code  = tt-rvs-line.pl-code
     5397                                    no-error.
     5398     assign v-free-vol = 0.95 * buf_place.max-qnty - varstate-sum-vol .
     5399     infoSectionsTotal = new ibs.th.str.InfoSectionsTotal(buf_trn-doc.doc-code, tt-rvs-line.gds-code, 'ПРОСМОТР':U).
     5400     sect_ :
     5401     do iisec = 1 to infoSectionsTotal:SectionNum :
     5402       infoSectionsTotal:GetInfoSectionProp (iisec).
     5403       if infoSectionsTotal:InfoSectionCurr:ListTank <> buf_place.loc1
     5404       then
     5405         next sect_ .
     5406       if v-sec-num <> ""
     5407       and v-sec-num <> infoSectionsTotal:InfoSectionCurr:SectionName
     5408       then
     5409         next sect_ .
     5410       if infoSectionsTotal:InfoSectionCurr:DocVolume > 0
     5411       then do :
     5412         v-doc-volume = v-doc-volume + infoSectionsTotal:InfoSectionCurr:DocVolume .
     5413       end .
     5414       else do :
     5415         v-doc-volume = v-doc-volume + infoSectionsTotal:InfoSectionCurr:DocQnty .
     5416       end .
     5417     end .
     5418     if v-doc-volume > 0
     5419     then do :
     5420       if v-free-vol >= v-doc-volume
     5421       then do :
     5422         find first buf_doc-pl-attr exclusive-lock
     5423             where buf_doc-pl-attr.obj-code  = tt-rvs-line.obj-code
     5424             and buf_doc-pl-attr.obj-type  = tt-rvs-line.obj-type
     5425             and buf_doc-pl-attr.gds-code  = tt-rvs-line.gds-code
     5426             and buf_doc-pl-attr.pl-code   = tt-rvs-line.pl-code
     5427             and buf_doc-pl-attr.out-code  = buf_rvs-doc.out-code
     5428             and buf_doc-pl-attr.attr-code = "free-vol-exceed"
     5429         no-error.
     5430         if available buf_doc-pl-attr then
     5431         do :
     5432           buf_doc-pl-attr.attr-value = string(no)  .
     5433         end.
     5434         else
     5435         do :
     5436           create buf_doc-pl-attr.
     5437           assign
     5438             buf_doc-pl-attr.obj-code   = tt-rvs-line.obj-code
     5439             buf_doc-pl-attr.obj-type   = tt-rvs-line.obj-type
     5440             buf_doc-pl-attr.gds-code   = tt-rvs-line.gds-code
     5441             buf_doc-pl-attr.pl-code    = tt-rvs-line.pl-code
     5442             buf_doc-pl-attr.out-code   = buf_rvs-doc.out-code
     5443             buf_doc-pl-attr.attr-code  = "free-vol-exceed"
     5444             buf_doc-pl-attr.attr-value = string(no)
     5445             .
     5446         end.
     5447       end .
     5448       else
     5449       do :
     5450         run ref/message_volue.w(input string(round(v-doc-volume, 0)),
     5451           input buf_place.loc1,
     5452           input string(round(v-free-vol, 0)),
     5453           input true) no-error .
     5454         find first buf_doc-pl-attr exclusive-lock
     5455           where buf_doc-pl-attr.obj-code  = tt-rvs-line.obj-code
     5456           and buf_doc-pl-attr.obj-type  = tt-rvs-line.obj-type
     5457           and buf_doc-pl-attr.gds-code  = tt-rvs-line.gds-code
     5458           and buf_doc-pl-attr.pl-code   = tt-rvs-line.pl-code
     5459           and buf_doc-pl-attr.out-code  = buf_rvs-doc.out-code
     5460           and buf_doc-pl-attr.attr-code = "free-vol-exceed" no-error.
     5461         if available buf_doc-pl-attr then
     5462         do :
     5463           buf_doc-pl-attr.attr-value = string(yes)  .
     5464         end.
     5465         else
     5466         do :
     5467           create buf_doc-pl-attr.
     5468           assign
     5469             buf_doc-pl-attr.obj-code   = tt-rvs-line.obj-code
     5470             buf_doc-pl-attr.obj-type   = tt-rvs-line.obj-type
     5471             buf_doc-pl-attr.gds-code   = tt-rvs-line.gds-code
     5472             buf_doc-pl-attr.pl-code    = tt-rvs-line.pl-code
     5473             buf_doc-pl-attr.out-code   = buf_rvs-doc.out-code
     5474             buf_doc-pl-attr.attr-code  = "free-vol-exceed"
     5475             buf_doc-pl-attr.attr-value = string(yes)
     5476             .
     5477         end.
     5478       end .
     5479     end .
     5480   end .
     5481   end.
     5482     if buf_rvs-doc.rvs-type = 'после_док':U then
     5483     do:
     5484       find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_rvs-doc.out-code no-error .
     5485       find first buf_place no-lock where buf_place.obj-code = tt-rvs-line.obj-code
     5486         and buf_place.obj-type = tt-rvs-line.obj-type
     5487         and buf_place.pl-code  = tt-rvs-line.pl-code
     5488         no-error.
     5489       assign
     5490         v-free-vol = 0.95 * buf_place.max-qnty.
     5491       v-doc-volume = tt-rvs-line.fact-sum-vol .
     5492       if v-doc-volume > 0
     5493         then
     5494       do :
     5495         if v-free-vol >= v-doc-volume
     5496           then
     5497         do :
     5498           find first buf_doc-pl-attr exclusive-lock
     5499             where buf_doc-pl-attr.obj-code  = tt-rvs-line.obj-code
     5500             and buf_doc-pl-attr.obj-type  = tt-rvs-line.obj-type
     5501             and buf_doc-pl-attr.gds-code  = tt-rvs-line.gds-code
     5502             and buf_doc-pl-attr.pl-code   = tt-rvs-line.pl-code
     5503             and buf_doc-pl-attr.out-code  = buf_rvs-doc.out-code
     5504             and buf_doc-pl-attr.attr-code = "free-vol-exceed-after" no-error.
     5505           if available buf_doc-pl-attr then
     5506           do :
     5507             buf_doc-pl-attr.attr-value = string(no)  .
     5508           end.
     5509           else
     5510           do :
     5511             create buf_doc-pl-attr.
     5512             assign
     5513               buf_doc-pl-attr.obj-code   = tt-rvs-line.obj-code
     5514               buf_doc-pl-attr.obj-type   = tt-rvs-line.obj-type
     5515               buf_doc-pl-attr.gds-code   = tt-rvs-line.gds-code
     5516               buf_doc-pl-attr.pl-code    = tt-rvs-line.pl-code
     5517               buf_doc-pl-attr.out-code   = buf_rvs-doc.out-code
     5518               buf_doc-pl-attr.attr-code  = "free-vol-exceed-after"
     5519               buf_doc-pl-attr.attr-value = string(no)
     5520               .
     5521           end.
     5522         end .
     5523         else
     5524         do :
     5525           find first buf_doc-pl-attr exclusive-lock
     5526             where buf_doc-pl-attr.obj-code  = tt-rvs-line.obj-code
     5527             and buf_doc-pl-attr.obj-type  = tt-rvs-line.obj-type
     5528             and buf_doc-pl-attr.gds-code  = tt-rvs-line.gds-code
     5529             and buf_doc-pl-attr.pl-code   = tt-rvs-line.pl-code
     5530             and buf_doc-pl-attr.out-code  = buf_rvs-doc.out-code
     5531             and buf_doc-pl-attr.attr-code = "free-vol-exceed"
     5532             and buf_doc-pl-attr.attr-value = string(yes) no-error.
     5533           if available (buf_doc-pl-attr) then
     5534           do:
     5535                 find first buf_doc-pl-attr exclusive-lock
     5536                   where buf_doc-pl-attr.obj-code  = tt-rvs-line.obj-code
     5537                   and buf_doc-pl-attr.obj-type  = tt-rvs-line.obj-type
     5538                   and buf_doc-pl-attr.gds-code  = tt-rvs-line.gds-code
     5539                   and buf_doc-pl-attr.pl-code   = tt-rvs-line.pl-code
     5540                   and buf_doc-pl-attr.out-code  = buf_rvs-doc.out-code
     5541                   and buf_doc-pl-attr.attr-code = "free-vol-exceed-after" no-error.
     5542                 if available (buf_doc-pl-attr) then
     5543                   buf_doc-pl-attr.attr-value = string(yes)  .
     5544                 else
     5545                 do :
     5546                   create buf_doc-pl-attr.
     5547                   assign
     5548                     buf_doc-pl-attr.obj-code   = tt-rvs-line.obj-code
     5549                     buf_doc-pl-attr.obj-type   = tt-rvs-line.obj-type
     5550                     buf_doc-pl-attr.gds-code   = tt-rvs-line.gds-code
     5551                     buf_doc-pl-attr.pl-code    = tt-rvs-line.pl-code
     5552                     buf_doc-pl-attr.out-code   = buf_rvs-doc.out-code
     5553                     buf_doc-pl-attr.attr-code  = "free-vol-exceed-after"
     5554                     buf_doc-pl-attr.attr-value = string(yes)
     5555                     .
     5556                 end.
     5557           end .
     5558           else
     5559           do:
     5560             find first buf_doc-pl-attr exclusive-lock
     5561               where buf_doc-pl-attr.obj-code  = tt-rvs-line.obj-code
     5562               and buf_doc-pl-attr.obj-type  = tt-rvs-line.obj-type
     5563               and buf_doc-pl-attr.gds-code  = tt-rvs-line.gds-code
     5564               and buf_doc-pl-attr.pl-code   = tt-rvs-line.pl-code
     5565               and buf_doc-pl-attr.out-code  = buf_rvs-doc.out-code
     5566               and buf_doc-pl-attr.attr-code = "free-vol-exceed-after" no-error.
     5567             if available (buf_doc-pl-attr) then
     5568               buf_doc-pl-attr.attr-value = string(yes)  .
     5569             else
     5570             do :
     5571               create buf_doc-pl-attr.
     5572               assign
     5573                 buf_doc-pl-attr.obj-code   = tt-rvs-line.obj-code
     5574                 buf_doc-pl-attr.obj-type   = tt-rvs-line.obj-type
     5575                 buf_doc-pl-attr.gds-code   = tt-rvs-line.gds-code
     5576                 buf_doc-pl-attr.pl-code    = tt-rvs-line.pl-code
     5577                 buf_doc-pl-attr.out-code   = buf_rvs-doc.out-code
     5578                 buf_doc-pl-attr.attr-code  = "free-vol-exceed-after"
     5579                 buf_doc-pl-attr.attr-value = string(yes)
     5580                 .
     5581             end.
     5582           end.
     5583         end.
     5584       end.
     5585     end.
     5586     define variable v-mi-par-list as character no-undo .
     5587     define variable v-mi-par-list-text as character no-undo .
     5588     define variable v-mi-old-val-list as character no-undo .
     5589     define variable v-mi-new-val-list as character no-undo .
     5590     v-mi-par-list = "" .
     5591     v-mi-old-val-list = "" .
     5592     v-mi-new-val-list = "" .
     5593     if rdc-value = "pomi-rn"
     5594     then do :
     5595       if v-dnst-mi-old = v-mi-dnst
     5596       and v-lvl-mi-old = v-mi-lvl
     5597       and v-tmp-mi-old = v-mi-tmp
     5598       then do :
     5599       end .
     5600       else do :
     5601         if v-dnst-mi-old <> v-mi-dnst
     5602         then do :
     5603           assign
     5604             v-mi-par-list = v-mi-par-list + "p" + ","
     5605             v-mi-old-val-list = v-mi-old-val-list + string(v-dnst-mi-old) + ","
     5606             v-mi-new-val-list = v-mi-new-val-list + string(v-mi-dnst) + ","
     5607           .
     5608         end .
     5609         if v-lvl-mi-old <> v-mi-lvl
     5610         then do :
     5611           assign
     5612             v-mi-par-list = v-mi-par-list + "l" + ","
     5613             v-mi-old-val-list = v-mi-old-val-list + string(v-lvl-mi-old) + ","
     5614             v-mi-new-val-list = v-mi-new-val-list + string(v-mi-lvl) + ","
     5615           .
     5616         end .
     5617         if v-tmp-mi-old <> v-mi-tmp
     5618         then do :
     5619           assign
     5620             v-mi-par-list = v-mi-par-list + "t"
     5621             v-mi-old-val-list = v-mi-old-val-list + string(v-tmp-mi-old)
     5622             v-mi-new-val-list = v-mi-new-val-list + string(v-mi-tmp)
     5623           .
     5624         end .
     5625         assign
     5626           v-mi-par-list = trim(v-mi-par-list, ",")
     5627           v-mi-old-val-list = trim(v-mi-old-val-list, ",")
     5628           v-mi-new-val-list = trim(v-mi-new-val-list, ",")
     5629           v-mi-par-list-text = v-mi-par-list
     5630         .
     5631         v-mi-par-list-text = replace(v-mi-par-list-text, "p", " плотность") .
     5632         v-mi-par-list-text = replace(v-mi-par-list-text, "l", " уровень") .
     5633         v-mi-par-list-text = replace(v-mi-par-list-text, "t", " температура") .
     5634         run trg/userlog.p (
     5635                 input 'mi-change'
     5636               , input ("Изменение средств измерений на объекте " +
     5637                       buf_rvs-doc.obj-type + string(buf_rvs-doc.obj-code) +
     5638                       "в сверке " + string(buf_rvs-doc.rvs-code) +
     5639                       " рез. " + string(tt-rvs-line.pl-code) + ": " +
     5640                       v-mi-par-list + ";" +
     5641                       v-mi-old-val-list + ";" +
     5642                       v-mi-new-val-list +
     5643                       chr(3) +
     5644                       buf_rvs-doc.obj-type + chr(6) +
     5645                       string(buf_rvs-doc.obj-code) + chr(6) +
     5646                       string(v-shift-date) + chr(6) +
     5647                       string(v-shift-num) + chr(6) +
     5648                       string(tt-rvs-line.pl-code) + chr(6) +
     5649                       v-mi-par-list + chr(6) +
     5650                       v-mi-old-val-list + chr(6) +
     5651                       v-mi-new-val-list + chr(6) +
     5652                       string(buf_rvs-doc.rvs-code)   )
     5653               , input ?
     5654               , input ?
     5655               , input ""
     5656               ) no-error.
     5657         if error-status :error
     5658         then do:
     5659             message return-value + error-status:get-message(1) view-as alert-box title "Ошибка записи истории действий пользователя".
     5660         end.
     5661         define variable v-log as logical no-undo .
     5662         find first buf_place no-lock
     5663              where buf_place.obj-code = tt-rvs-line.obj-code
     5664                and buf_place.obj-type = tt-rvs-line.obj-type
     5665                and buf_place.pl-code  = tt-rvs-line.pl-code no-error.
     5666         message
     5667           "Для параметра/ов" v-mi-par-list-text " изменены дополнительные средства измерения. Сохранить выбранные средства измерения"
     5668           v-mi-par-list-text " в качестве средств измерения по умолчанию для резервуара " buf_place.loc1 " " buf_place.pl-name "?"
     5669         view-as alert-box question buttons yes-no update v-log .
     5670         if v-log
     5671         then do :
     5672           if v-dnst-mi-old <> v-mi-dnst
     5673           then do :
     5674             run placelib_write-attr  ( input "place-SI-dens"
     5675                                       ,input buf_place.obj-code
     5676                                       ,input buf_place.obj-type
     5677                                       ,input buf_place.pl-code
     5678                                       ,input string(v-mi-dnst)
     5679                                       ,output v-ok      ) no-error.
     5680           end .
     5681           if v-lvl-mi-old <> v-mi-lvl
     5682           then do :
     5683             run placelib_write-attr  ( input "place-SI-level"
     5684                                       ,input buf_place.obj-code
     5685                                       ,input buf_place.obj-type
     5686                                       ,input buf_place.pl-code
     5687                                       ,input string(v-mi-lvl)
     5688                                       ,output v-ok      ) no-error.
     5689           end .
     5690           if v-tmp-mi-old <> v-mi-tmp
     5691           then do :
     5692             run placelib_write-attr  ( input "place-SI-temp"
     5693                                       ,input buf_place.obj-code
     5694                                       ,input buf_place.obj-type
     5695                                       ,input buf_place.pl-code
     5696                                       ,input string(v-mi-tmp)
     5697                                       ,output v-ok      ) no-error.
     5698           end .
     5699         end .
     5700       end .
     5701     end .
     5702     v-vid-action = 56 .
     5703     v-vid-param =
     5704             "Initiator=" + v-initiator + chr(4) +
     5705             "SHOP_NUM=" + string(buf_rvs-doc.obj-code) + chr(4) +
     5706             "DocType=" + string(buf_rvs-doc.rvs-type) + chr(4) +
     5707             "DocNum=" + string(buf_rvs-doc.rvs-code) + chr(4) +
     5708             "SHIFT_NUM_DOC=" + (if string(buf_rvs-doc.shift-num) = ? then '' else string(buf_rvs-doc.shift-num)) + (if string(buf_rvs-doc.shift-date) = ? then '' else string(buf_rvs-doc.shift-date, "99999999")) + chr(4) +
     5709             "SHIFT_NUM=" + (if string(v-shift-num) = ? then '' else string(v-shift-num)) + (if string(v-shift-date) = ? then '' else string(v-shift-date, "99999999")) + chr(4) +
     5710             "PlCode=" + string( tt-rvs-line.pl-code) + chr(4) +
     5711             "RESULT=0" + chr(4) +
     5712             "Temperature=" +  (if string(tt-rvs-line.state-temperature) = ? then '' else string(tt-rvs-line.state-temperature)) + chr(4) +
     5713             "StateDensity="        +  (if string(tt-rvs-line.state-density) = ? then '' else string(tt-rvs-line.state-density)) + chr(4) +
     5714             "StateMeasureQnty="    +  (if string( tt-rvs-line.state-measure-qnty) = ? then '' else string( tt-rvs-line.state-measure-qnty)) + chr(4) +
     5715             "StateBruttoQnty="  +  (if string(  tt-rvs-line.state-brutto-qnty) = ? then '' else string(  tt-rvs-line.state-brutto-qnty)) + chr(4) +
     5716             "StateMeasureCliQnty=" +  (if string(  tt-rvs-line.state-measure-cli-qnty) = ? then '' else string(  tt-rvs-line.state-measure-cli-qnty)) + chr(4) +
     5717             "StateBruttoCliQnty=" +  (if string(  tt-rvs-line.state-brutto-cli-qnty) = ? then '' else string(   tt-rvs-line.state-brutto-cli-qnty)) + chr(4) +
     5718             "StateLevelTotal="  +  (if string(  tt-rvs-line.state-level-total) = ? then '' else string(  tt-rvs-line.state-level-total)) + chr(4) +
     5719             "StateLevelPetrol=" +  (if string(  tt-rvs-line.state-level-petrol) = ? then '' else string( tt-rvs-line.state-level-petrol)) + chr(4) +
     5720             "StateLevelWater=" +  (if string(  tt-rvs-line.state-level-water) = ? then '' else string(  tt-rvs-line.state-level-water)) + chr(4) +
     5721             "StateMeasureTcQnty="  +  (if string(  tt-rvs-line.state-measure-tc-qnty  ) = ? then '' else string(   tt-rvs-line.state-measure-tc-qnty  )) + chr(4) +
     5722             "StateBruttoTcQnty="  +  (if string(  tt-rvs-line.state-brutto-tc-qnty  ) = ? then '' else string(    tt-rvs-line.state-brutto-tc-qnty  )) + chr(4) +
     5723             "Description=".
     5724     run trg/userlog.p (
     5725         input 'create':U
     5726         , input 'rvs-doc':U
     5727         , input ( buffer buf_rvs-doc:handle )
     5728         , input v-vid-action
     5729         , input v-vid-param
     5730         ) no-error.
     5731     if error-status :error
     5732     then do:
     5733       message substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
     5734               , chr(10)
     5735               , vss-workfile
     5736               , return-value
     5737               , error-status :get-message ( 1 ) )
     5738               view-as alert-box.
     5739       return no-apply.
     5740     end.
     5741   END.
     5742   ON LEAVE OF tt-rvs-line.state-add-qnty IN FRAME Dialog-Frame
     5743   DO:
     5744     assign frame Dialog-Frame tt-rvs-line.state-add-qnty.
     5745     assign tt-rvs-line.fact-sum-vol = tt-rvs-line.state-measure-qnty + tt-rvs-line.state-add-qnty .
     5746     display tt-rvs-line.fact-sum-vol with frame Dialog-Frame .
     5747   END.
     5748   ON return OF tt-rvs-line.state-add-qnty IN FRAME Dialog-Frame
     5749   DO:
     5750     apply "entry" to tt-rvs-line.state-brutto-qnty in frame Dialog-Frame.
     5751     return no-apply.
     5752   END.
     5753   ON LEAVE OF tt-rvs-line.state-brutto-cli-qnty IN FRAME Dialog-Frame
     5754   DO:
     5755   if input frame Dialog-Frame tt-rvs-line.state-brutto-cli-qnty <> tt-rvs-line.state-brutto-cli-qnty then do:
     5756     run weath-water no-error.
     5757     if error-status:error then return no-apply.
     5758   end.
     5759   END.
     5760   ON return OF tt-rvs-line.state-brutto-cli-qnty IN FRAME Dialog-Frame
     5761   DO:
     5762     apply "entry" to tt-rvs-line.state-level-petrol in frame Dialog-Frame.
     5763     return no-apply.
     5764   END.
     5765   ON LEAVE OF tt-rvs-line.state-brutto-qnty IN FRAME Dialog-Frame
     5766   DO:
     5767   if input frame Dialog-Frame tt-rvs-line.state-brutto-qnty <> tt-rvs-line.state-brutto-qnty then do:
     5768     run volume-water no-error.
     5769     if error-status:error then return no-apply.
     5770   end.
     5771   END.
     5772   ON return OF tt-rvs-line.state-brutto-qnty IN FRAME Dialog-Frame
     5773   DO:
     5774     apply "entry" to tt-rvs-line.state-measure-tc-qnty in frame Dialog-Frame.
     5775     return no-apply.
     5776   END.
     5777   ON LEAVE OF tt-rvs-line.state-brutto-tc-qnty IN FRAME Dialog-Frame
     5778   DO:
     5779     assign frame Dialog-Frame tt-rvs-line.state-brutto-tc-qnty.
     5780   END.
     5781   ON LEAVE OF tt-rvs-line.state-density IN FRAME Dialog-Frame
     5782   DO:
     5783     if input frame Dialog-Frame tt-rvs-line.state-density <> tt-rvs-line.state-density
     5784     then do:
     5785       assign frame Dialog-Frame tt-rvs-line.state-density.
     5786       run chg-density no-error.
     5787       if error-status:error then return no-apply.
     5788       run weath-water no-error.
     5789       if error-status:error then return no-apply.
     5790       if tarir-value = 'yes'
     5791       then do :
     5792         run local-tarir("state-level-total") .
     5793       end.
     5794       assign v-hand-input-dnst = true .
     5795     end.
     5796   END.
     5797   ON LEAVE OF varstate-water-qnty IN FRAME Dialog-Frame
     5798   DO:
     5799     if input frame Dialog-Frame varstate-water-qnty <> varstate-water-qnty
     5800     then do:
     5801       assign varstate-sum-vol = input frame Dialog-Frame tt-rvs-line.state-measure-qnty + input frame Dialog-Frame varstate-water-qnty .
     5802       display varstate-sum-vol with frame Dialog-Frame.
     5803     end.
     5804   END.
     5805   ON LEAVE OF tt-rvs-line.state-measure-qnty IN FRAME Dialog-Frame
     5806   DO:
     5807     if input frame Dialog-Frame tt-rvs-line.state-measure-qnty <> tt-rvs-line.state-measure-qnty
     5808     then do:
     5809       assign frame Dialog-Frame tt-rvs-line.state-measure-qnty .
     5810       tt-rvs-line.fact-sum-vol = input frame Dialog-Frame tt-rvs-line.state-measure-qnty + input frame Dialog-Frame tt-rvs-line.state-add-qnty .
     5811       varstate-sum-vol = input frame Dialog-Frame tt-rvs-line.state-measure-qnty + (if input frame Dialog-Frame varstate-water-qnty = ? then 0 else input frame Dialog-Frame varstate-water-qnty) .
     5812       tt-rvs-line.state-brutto-qnty = varstate-sum-vol .
     5813       display tt-rvs-line.fact-sum-vol varstate-sum-vol with frame Dialog-Frame.
     5814       run volume-water no-error.
     5815       if error-status:error then return no-apply.
     5816       if tt-rvs-line.state-density <> 0
     5817       and tt-rvs-line.state-density <> ?
     5818       then do:
     5819         run chg-density no-error.
     5820         if error-status:error then return no-apply.
     5821         run weath-water no-error.
     5822         if error-status:error then return no-apply.
     5823       end.
     5824       tt-rvs-line.fact-sum-mass = tt-rvs-line.fact-calc-add-mass + tt-rvs-line.state-measure-cli-qnty .
     5825       abs-delta-mass-add-qnty = tt-rvs-line.fact-calc-add-mass * pl-error-mass / 100 no-error .
     5826       display tt-rvs-line.fact-sum-mass tt-rvs-line.state-measure-qnty abs-delta-mass-add-qnty with frame Dialog-Frame.
     5827     end.
     5828   END.
     5829   ON return OF tt-rvs-line.state-density IN FRAME Dialog-Frame
     5830   DO:
     5831     apply "entry" to tt-rvs-line.state-add-qnty in frame Dialog-Frame.
     5832     return no-apply.
     5833   END.
     5834   ON LEAVE OF tt-rvs-line.izmer-density IN FRAME Dialog-Frame
     5835   DO:
     5836     if input frame Dialog-Frame tt-rvs-line.izmer-density <> tt-rvs-line.izmer-density
     5837     then do:
     5838       if input frame Dialog-Frame tt-rvs-line.izmer-density = ?
     5839       or ( buf_goods.unit-base <> buf_goods.unit-cli
     5840           and ( input frame Dialog-Frame tt-rvs-line.izmer-density < 0
     5841                 or input frame Dialog-Frame tt-rvs-line.izmer-density >= 1
     5842               )
     5843         )
     5844       or ( buf_goods.unit-base = buf_goods.unit-cli
     5845           and input frame Dialog-Frame tt-rvs-line.izmer-density <> 1
     5846         )
     5847       then do:
     5848         message "Неверно определена плотность топлива измер. для ПОкМИ." view-as alert-box error.
     5849         apply "entry" to tt-rvs-line.izmer-density .
     5850         return no-apply.
     5851       end.
     5852       assign frame Dialog-Frame tt-rvs-line.izmer-density.
     5853       assign v-hand-input-dnst = true .
     5854     end.
     5855   END.
     5856   ON LEAVE OF tt-rvs-line.state-level-water IN FRAME Dialog-Frame
     5857   DO:
     5858     if input frame Dialog-Frame tt-rvs-line.state-level-water <> tt-rvs-line.state-level-water
     5859     then do:
     5860       assign v-hand-input-lvl = true .
     5861       find first rvs-line-attr exclusive-lock
     5862          where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     5863            and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     5864            and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     5865            and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     5866            and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     5867            and rvs-line-attr.attr-code = "is-calc" no-error.
     5868       if available rvs-line-attr
     5869       then do :
     5870         rvs-line-attr.attr-value = string(no) .
     5871       end .
     5872       run level-water in this-procedure ( input no )  .
     5873       RUN local-tarir ("state-level-total").
     5874     end.
     5875   END.
     5876   ON return OF tt-rvs-line.state-level-petrol IN FRAME Dialog-Frame
     5877   DO:
     5878     apply "entry" to tt-rvs-line.state-level-total in frame Dialog-Frame.
     5879     return no-apply.
     5880   END.
     5881   ON LEAVE OF tt-rvs-line.state-level-total IN FRAME Dialog-Frame
     5882   DO:
     5883     if input frame Dialog-Frame tt-rvs-line.state-level-total <> ?
     5884     and input frame Dialog-Frame tt-rvs-line.state-level-total > 0
     5885     then do :
     5886       if (pl-rvd-temp or v-revision-mode)
     5887       and rdc-value = "pomi-rn"
     5888       then do :
     5889         if v-revision-mode
     5890         and v-mi-lvl > 0
     5891         and v-mi-dnst > 0
     5892         and v-mi-tmp > 0
     5893         then
     5894           enable b-temperature with frame Dialog-Frame.
     5895         if not v-revision-mode
     5896         and v-mi-tmp > 0
     5897         then
     5898           enable b-temperature with frame Dialog-Frame.
     5899       end .
     5900       if (pl-rvd-dens or v-revision-mode)
     5901       and rdc-value = "pomi-rn"
     5902       then do :
     5903         if v-revision-mode
     5904         and v-mi-lvl > 0
     5905         and v-mi-dnst > 0
     5906         and v-mi-tmp > 0
     5907         then
     5908           enable b-density with frame Dialog-Frame.
     5909         if not v-revision-mode
     5910         and v-mi-dnst > 0
     5911         then
     5912           enable b-density with frame Dialog-Frame.
     5913       end .
     5914       if ((pl-rvd-dens and pl-rvd-temp)
     5915        or v-revision-mode)
     5916       and v-mi-dnst > 0
     5917       and v-mi-tmp > 0
     5918       and rdc-value = "pomi-rn"
     5919       then do :
     5920         find first dnst_sr-izmerenia no-lock where dnst_sr-izmerenia.node-code = v-mi-dnst no-error .
     5921         find first tmp_sr-izmerenia no-lock where tmp_sr-izmerenia.node-code = v-mi-tmp no-error .
     5922         if available dnst_sr-izmerenia
     5923         and available tmp_sr-izmerenia
     5924         and dnst_sr-izmerenia.node-code <> tmp_sr-izmerenia.node-code
     5925         and ((dnst_sr-izmerenia.sr-density and dnst_sr-izmerenia.sr-temperature)
     5926           or (tmp_sr-izmerenia.sr-density and tmp_sr-izmerenia.sr-temperature))
     5927         then do :
     5928           disable b-temperature with frame Dialog-Frame .
     5929           disable b-density with frame Dialog-Frame .
     5930         end .
     5931       end .
     5932       if v-revision-mode
     5933       and t-tank-cleaning:visible
     5934       then do :
     5935         if input frame Dialog-Frame tt-rvs-line.state-level-total < 1
     5936         then do :
     5937           enable t-tank-cleaning with frame Dialog-Frame .
     5938         end .
     5939         else do :
     5940           assign t-tank-cleaning = no .
     5941           display t-tank-cleaning with frame Dialog-Frame .
     5942           disable t-tank-cleaning with frame Dialog-Frame .
     5943         end .
     5944       end .
     5945     end .
     5946     else do :
     5947       disable b-temperature with frame Dialog-Frame .
     5948       disable b-density with frame Dialog-Frame .
     5949       if v-revision-mode
     5950       and t-tank-cleaning:visible
     5951       then do :
     5952         assign t-tank-cleaning = no .
     5953         display t-tank-cleaning with frame Dialog-Frame .
     5954         disable t-tank-cleaning with frame Dialog-Frame .
     5955       end .
     5956     end .
     5957     if input frame Dialog-Frame tt-rvs-line.state-level-total <> tt-rvs-line.state-level-total then do:
     5958       assign v-hand-input-lvl = true .
     5959       empty temp-table tt-temps .
     5960       empty temp-table tt-dens .
     5961       empty temp-table tt-dens-temp .
     5962       find first rvs-line-attr exclusive-lock
     5963              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     5964                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     5965                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     5966                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     5967                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     5968                and rvs-line-attr.attr-code = "izm-temps" no-error.
     5969       if available rvs-line-attr
     5970       then do :
     5971         rvs-line-attr.attr-value = "0;" .
     5972       end .
     5973       find first rvs-line-attr exclusive-lock
     5974              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     5975                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     5976                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     5977                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     5978                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     5979                and rvs-line-attr.attr-code = "izm-denses" no-error.
     5980       if available rvs-line-attr
     5981       then do :
     5982         rvs-line-attr.attr-value = "0;" .
     5983       end .
     5984       find first rvs-line-attr exclusive-lock
     5985          where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     5986            and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     5987            and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     5988            and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     5989            and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     5990            and rvs-line-attr.attr-code = "is-calc" no-error.
     5991       if available rvs-line-attr
     5992       then do :
     5993         rvs-line-attr.attr-value = string(no) .
     5994       end .
     5995       run level-water in this-procedure ( input no )  .
     5996       RUN local-tarir ("state-level-total").
     5997     end.
     5998   END.
     5999   ON return OF tt-rvs-line.state-level-total IN FRAME Dialog-Frame
     6000   DO:
     6001     return no-apply.
     6002   END.
     6003   ON leave OF tt-rvs-line.state-measure-cli-qnty IN FRAME Dialog-Frame
     6004   DO:
     6005     assign frame Dialog-Frame tt-rvs-line.state-measure-cli-qnty .
     6006     if not tt-rvs-line.state-measure-qnty:sensitive
     6007     and rdc-value <> 'pomi-rn'
     6008     then do :
     6009       assign
     6010         tt-rvs-line.state-measure-qnty = tt-rvs-line.state-measure-cli-qnty / tt-rvs-line.state-density
     6011         varstate-sum-vol = (if varstate-water-qnty <> ? then varstate-water-qnty else 0) + tt-rvs-line.state-measure-qnty
     6012         tt-rvs-line.fact-sum-mass = tt-rvs-line.fact-calc-add-mass + tt-rvs-line.state-measure-cli-qnty
     6013         tt-rvs-line.state-brutto-qnty     = tt-rvs-line.state-measure-qnty + (if varstate-water-qnty <> ? then varstate-water-qnty else 0)
     6014         tt-rvs-line.state-brutto-cli-qnty = tt-rvs-line.state-measure-cli-qnty + (if varstate-water-qnty <> ? then varstate-water-qnty else 0)
     6015       .
     6016       display tt-rvs-line.state-measure-cli-qnty tt-rvs-line.state-measure-qnty tt-rvs-line.fact-sum-mass varstate-sum-vol with frame Dialog-Frame.
     6017     end .
     6018   END.
     6019   ON return OF tt-rvs-line.state-measure-qnty IN FRAME Dialog-Frame
     6020   DO:
     6021     apply "entry" to tt-rvs-line.state-measure-tc-qnty in frame Dialog-Frame.
     6022     return no-apply.
     6023   END.
     6024   ON LEAVE OF tt-rvs-line.state-measure-tc-qnty IN FRAME Dialog-Frame
     6025   DO:
     6026     assign frame Dialog-Frame tt-rvs-line.state-measure-tc-qnty.
     6027   END.
     6028   ON return OF tt-rvs-line.state-measure-tc-qnty IN FRAME Dialog-Frame
     6029   DO:
