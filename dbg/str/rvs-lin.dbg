     2782   ASSIGN
     2783          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2784          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2785   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2786   DO:
     2787     assign
     2788       v-return-val = "cancel"
     2789     .
     2790     APPLY "END-ERROR":U TO SELF.
     2791   END.
     2792   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
     2793   DO:
     2794   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2795   if lookup(self :type
     2796            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2797            ) = 0
     2798   then do:
     2799     message
     2800       "$Workfile$"
     2801       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2802       "Интерфейсный элемент" self :name  skip
     2803       "Тип" self :type  skip
     2804       "Процедура" this-procedure :file-name skip
     2805       view-as alert-box .
     2806   end.
     2807   else do:
     2808     apply "entry":u to self  .
     2809     if focus :handle <> self :handle  then do:
     2810       return no-apply .
     2811     end.
     2812   end.
     2813     assign
     2814       v-return-val = "cancel"
     2815     .
     2816     release rvs-line-attr no-error .
     2817     APPLY "END-ERROR":U TO SELF.
     2818   END.
     2819   ON CHOOSE OF b-POkMI-result IN FRAME Dialog-Frame
     2820   DO:
     2821     if trim(v-POkMI-warnings) > ""
     2822     then do :
     2823       message (v-POkMI-result-attr + chr(10) + " " + chr(10) + " " + chr(10) + "Предупреждения:" + chr(10) + v-POkMI-warnings) view-as alert-box information .
     2824     end .
     2825     else do :
     2826       message v-POkMI-result-attr view-as alert-box information .
     2827     end .
     2828   END.
     2829   ON CHOOSE OF b-mi-lvl IN FRAME Dialog-Frame
     2830   DO:
     2831     define variable v-node-code as integer no-undo.
     2832     define variable v-sr-type as character no-undo.
     2833     v-node-code = 0 .
     2834     run ref/sr-izm.w (input parparentproc ,
     2835                       input "b-sel"       ,
     2836                       input 'ПРОСМОТР':U     ,
     2837                       input "0,1"         ,
     2838                       input "lvl"         ,
     2839                       input-output v-node-code,
     2840                       output v-sr-type) no-error.
     2841     if v-node-code <> 0 and v-node-code <> ? then do :
     2842       v-mi-lvl = v-node-code.
     2843       v-mi-lvl:screen-value = string(v-node-code).
     2844       find first lvl_sr-izmerenia no-lock where lvl_sr-izmerenia.node-code = v-mi-lvl .
     2845       apply "leave" to v-mi-lvl in frame Dialog-Frame .
     2846     end.
     2847   END.
     2848   on entry of v-mi-lvl-name IN FRAME Dialog-Frame
     2849   do:
     2850     apply "entry" to v-mi-lvl in frame Dialog-Frame.
     2851   end .
     2852   on entry of v-mi-lvl IN FRAME Dialog-Frame
     2853   do:
     2854     hide v-mi-lvl-name in frame Dialog-Frame.
     2855   end .
     2856   on return of v-mi-lvl IN FRAME Dialog-Frame
     2857   do:
     2858     apply "leave" to v-mi-lvl IN FRAME Dialog-Frame .
     2859   end .
     2860   on del, backspace, "?" of v-mi-lvl in frame Dialog-Frame
     2861   do :
     2862     v-mi-lvl = ? .
     2863     v-mi-lvl:screen-value = "?" .
     2864   end .
     2865   on leave of v-mi-lvl IN FRAME Dialog-Frame
     2866   do:
     2867     define variable v-old-val as character no-undo .
     2868     v-old-val = string(v-mi-lvl) .
     2869     find first lvl_sr-izmerenia no-lock where lvl_sr-izmerenia.node-code = integer(v-mi-lvl:screen-value) no-error .
     2870     if not available lvl_sr-izmerenia
     2871     then do :
     2872       if v-mi-lvl:screen-value <> "?"
     2873       and v-mi-lvl:screen-value <> "0"
     2874       then do :
     2875         message ("Не найдено средтсво измерения с кодом " + v-mi-lvl:screen-value) view-as alert-box .
     2876         v-mi-lvl:screen-value = v-old-val .
     2877       end .
     2878       return .
     2879     end .
     2880     else do :
     2881       if lvl_sr-izmerenia.sr-type-izm = 2
     2882       then do :
     2883         message "Средство измерения является Измерительной Системой!" view-as alert-box .
     2884         v-mi-lvl:screen-value = v-old-val .
     2885         return .
     2886       end .
     2887       if not lvl_sr-izmerenia.sr-level
     2888       then do :
     2889         message "Средство измерения НЕ измеряет уровень!" view-as alert-box .
     2890         v-mi-lvl:screen-value = v-old-val .
     2891         return .
     2892       end .
     2893     end .
     2894     v-mi-lvl-name = lvl_sr-izmerenia.sr-model .
     2895     display v-mi-lvl-name with frame Dialog-Frame.
     2896     enable v-mi-lvl-name with frame Dialog-Frame.
     2897     assign v-mi-lvl .
     2898     if string(v-mi-lvl) <> v-old-val
     2899     then do :
     2900       tt-rvs-line.state-level-total = 0 .
     2901       tt-rvs-line.state-level-water = 0 .
     2902     end .
     2903     display tt-rvs-line.state-level-total tt-rvs-line.state-level-water with frame Dialog-Frame.
     2904     if v-revision-mode
     2905     then do :
     2906       if v-mi-dnst > 0
     2907       and v-mi-tmp > 0
     2908       then do :
     2909         enable
     2910           tt-rvs-line.state-level-total
     2911           tt-rvs-line.state-level-water
     2912           b-temperature
     2913           b-density
     2914         with frame Dialog-Frame.
     2915       end .
     2916     end .
     2917     else do :
     2918       if ((pl-rvd-lvl and v-mi-lvl > 0) or not pl-rvd-lvl)
     2919       and ((pl-rvd-dens and v-mi-dnst > 0) or not pl-rvd-dens)
     2920       and ((pl-rvd-temp and v-mi-tmp > 0) or not pl-rvd-temp)
     2921       then do :
     2922         if pl-rvd-lvl
     2923         then do :
     2924           enable
     2925             tt-rvs-line.state-level-total
     2926             tt-rvs-line.state-level-water
     2927           with frame Dialog-Frame.
     2928         end .
     2929         if pl-rvd-dens
     2930         then do :
     2931           enable
     2932             b-density
     2933           with frame Dialog-Frame.
     2934         end .
     2935         if pl-rvd-temp
     2936         then do :
     2937           enable
     2938             b-temperature
     2939           with frame Dialog-Frame.
     2940         end .
     2941       end .
     2942     end .
     2943     apply "leave" to tt-rvs-line.state-level-total in frame Dialog-Frame .
     2944   end .
     2945   ON CHOOSE OF b-mi-dnst IN FRAME Dialog-Frame
     2946   DO:
     2947     define variable v-node-code as integer no-undo.
     2948     define variable v-sr-type-id as character no-undo.
     2949     define variable v-sr-type-izm as character no-undo .
     2950     v-node-code = 0 .
     2951       v-sr-type-izm = "0,1" .
     2952     run ref/sr-izm.w (input parparentproc ,
     2953                       input "b-sel"       ,
     2954                       input 'ПРОСМОТР':U     ,
     2955                       input v-sr-type-izm ,
     2956                       input "dnst"        ,
     2957                       input-output v-node-code,
     2958                       output v-sr-type-id) no-error.
     2959     if v-node-code <> 0 and v-node-code <> ? then do :
     2960       if v-mi-dnst:screen-value <> "?"
     2961       then do :
     2962         if integer(v-mi-dnst:screen-value) <> v-node-code
     2963         then do :
     2964           v-mi-tmp-dnst = 0 .
     2965           find first rvs-line-attr exclusive-lock
     2966                where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     2967                  and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     2968                  and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     2969                  and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     2970                  and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     2971                  and rvs-line-attr.attr-code = "mi-tmp-dnst" no-error.
     2972           if available rvs-line-attr
     2973           then do :
     2974             rvs-line-attr.attr-value = string(v-mi-tmp-dnst) .
     2975           end.
     2976         end .
     2977       end .
     2978       v-mi-dnst = v-node-code.
     2979       v-mi-dnst:screen-value = string(v-node-code).
     2980       find first dnst_sr-izmerenia no-lock where dnst_sr-izmerenia.node-code = v-mi-dnst .
     2981       apply "leave" to v-mi-dnst in frame Dialog-Frame .
     2982     end.
     2983   END.
     2984   on entry of v-mi-dnst-name IN FRAME Dialog-Frame
     2985   do:
     2986     apply "entry" to v-mi-dnst in frame Dialog-Frame.
     2987   end .
     2988   on entry of v-mi-dnst IN FRAME Dialog-Frame
     2989   do:
     2990     hide v-mi-dnst-name in frame Dialog-Frame.
     2991   end .
     2992   on return of v-mi-dnst IN FRAME Dialog-Frame
     2993   do:
     2994     apply "leave" to v-mi-dnst IN FRAME Dialog-Frame .
     2995   end .
     2996   on del, backspace, "?" of v-mi-dnst in frame Dialog-Frame
     2997   do :
     2998     v-mi-dnst = ? .
     2999     v-mi-dnst:screen-value = "?" .
     3000   end .
     3001   on leave of v-mi-dnst IN FRAME Dialog-Frame
     3002   do:
     3003     define variable vlog as logical no-undo .
     3004     define variable v-old-val as character no-undo .
     3005     v-old-val = string(v-mi-dnst) .
     3006     find first dnst_sr-izmerenia no-lock where dnst_sr-izmerenia.node-code = integer(v-mi-dnst:screen-value) no-error .
     3007     if not available dnst_sr-izmerenia
     3008     then do :
     3009       if v-mi-dnst:screen-value <> "?"
     3010       and v-mi-dnst:screen-value <> "0"
     3011       then do :
     3012         message ("Не найдено средство измерения с кодом " + v-mi-dnst:screen-value) view-as alert-box .
     3013         v-mi-dnst:screen-value = v-old-val .
     3014       end .
     3015       return .
     3016     end .
     3017     else do :
     3018       if dnst_sr-izmerenia.sr-type-izm = 2
     3019       then do :
     3020         message "Средство измерения является Измерительной Системой!" view-as alert-box .
     3021         v-mi-dnst:screen-value = v-old-val .
     3022         return .
     3023       end .
     3024       if not dnst_sr-izmerenia.sr-density
     3025       then do :
     3026         message "Средство измерения НЕ измеряет плотность!" view-as alert-box .
     3027         v-mi-dnst:screen-value = v-old-val .
     3028         return .
     3029       end .
     3030     end .
     3031     v-mi-dnst-name = dnst_sr-izmerenia.sr-model .
     3032     display v-mi-dnst-name with frame Dialog-Frame.
     3033     enable v-mi-dnst-name with frame Dialog-Frame.
     3034     assign v-mi-dnst .
     3035     if rdc-value = 'pomi-rn'
     3036     then do :
     3037       if string(v-mi-dnst) <> v-old-val
     3038       then do :
     3039         v-mi-tmp-dnst = 0 .
     3040         find first rvs-line-attr exclusive-lock
     3041              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     3042                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     3043                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     3044                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     3045                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     3046                and rvs-line-attr.attr-code = "mi-tmp-dnst" no-error.
     3047         if available rvs-line-attr
     3048         then do :
     3049           rvs-line-attr.attr-value = string(v-mi-tmp-dnst) .
     3050         end.
     3051         tt-rvs-line.izmer-density = 0 .
     3052         tt-rvs-line.state-temperature = ? .
     3053       end .
     3054       display tt-rvs-line.izmer-density tt-rvs-line.state-temperature with frame Dialog-Frame.
     3055       if v-revision-mode
     3056       then do :
     3057         if v-mi-lvl > 0
     3058         and v-mi-tmp > 0
     3059         then do :
     3060           enable
     3061             tt-rvs-line.state-level-total
     3062             tt-rvs-line.state-level-water
     3063             b-temperature
     3064             b-density
     3065           with frame Dialog-Frame.
     3066         end .
     3067       end .
     3068       else do :
     3069         if ((pl-rvd-lvl and v-mi-lvl > 0) or not pl-rvd-lvl)
     3070         and ((pl-rvd-dens and v-mi-dnst > 0) or not pl-rvd-dens)
     3071         and ((pl-rvd-temp and v-mi-tmp > 0) or not pl-rvd-temp)
     3072         then do :
     3073           if pl-rvd-lvl
     3074           then do :
     3075             enable
     3076               tt-rvs-line.state-level-total
     3077               tt-rvs-line.state-level-water
     3078             with frame Dialog-Frame.
     3079           end .
     3080           if pl-rvd-dens
     3081           then do :
     3082             enable
     3083               b-density
     3084             with frame Dialog-Frame.
     3085           end .
     3086           if pl-rvd-temp
     3087           then do :
     3088             enable
     3089               b-temperature
     3090             with frame Dialog-Frame.
     3091           end .
     3092         end .
     3093       end .
     3094       if pl-rvd-dens <> pl-rvd-temp
     3095       then do :
     3096         find first tmp_sr-izmerenia no-lock where tmp_sr-izmerenia.node-code = v-mi-tmp no-error .
     3097         if (available tmp_sr-izmerenia and tmp_sr-izmerenia.sr-type-izm = 0 and tmp_sr-izmerenia.sr-density and tmp_sr-izmerenia.sr-temperature)
     3098         or (available dnst_sr-izmerenia and dnst_sr-izmerenia.sr-type-izm = 0 and dnst_sr-izmerenia.sr-density and dnst_sr-izmerenia.sr-temperature)
     3099         then do :
     3100           message "Бизнес-процессом не предусмотрено использование неравнозначных положений разрешения РВД по параметрам температура и плотность, "
     3101                   "если дополнительное автоматизированное СИ предназначено для измерения обоих параметров." skip
     3102                   "Подайте заявку в службу поддержки для приведения параметров в соответствие требованиям бизнес-процесса."
     3103           view-as alert-box .
     3104         end .
     3105       end .
     3106       if dnst_sr-izmerenia.sr-temperature
     3107       and v-mi-dnst <> v-mi-tmp
     3108       and b-mi-tmp:sensitive
     3109       then do :
     3110           v-mi-tmp = v-mi-dnst .
     3111           v-mi-tmp:screen-value = v-mi-dnst:screen-value .
     3112           v-mi-tmp-name = v-mi-dnst-name .
     3113           apply "leave" to v-mi-tmp in frame Dialog-Frame .
     3114       end .
     3115     end .
     3116     else do :
     3117       if string(v-mi-dnst) <> v-old-val
     3118       then do :
     3119         tt-rvs-line.state-density = 0 .
     3120       end .
     3121       display tt-rvs-line.state-density with frame Dialog-Frame.
     3122       if v-revision-mode
     3123       then do :
     3124         if v-mi-lvl > 0
     3125         and v-mi-tmp > 0
     3126         then do :
     3127           enable
     3128             tt-rvs-line.state-level-total
     3129             tt-rvs-line.state-level-water
     3130             tt-rvs-line.state-temperature
     3131             tt-rvs-line.state-density
     3132           with frame Dialog-Frame.
     3133         end .
     3134       end .
     3135       else do :
     3136         if ((pl-rvd-lvl and v-mi-lvl > 0) or not pl-rvd-lvl)
     3137         and ((pl-rvd-dens and v-mi-dnst > 0) or not pl-rvd-dens)
     3138         and ((pl-rvd-temp and v-mi-tmp > 0) or not pl-rvd-temp)
     3139         then do :
     3140           if pl-rvd-lvl
     3141           then do :
     3142             enable
     3143               tt-rvs-line.state-level-total
     3144               tt-rvs-line.state-level-water
     3145             with frame Dialog-Frame.
     3146           end .
     3147           if pl-rvd-dens
     3148           then do :
     3149             enable
     3150               tt-rvs-line.state-density
     3151             with frame Dialog-Frame.
     3152           end .
     3153           if pl-rvd-temp
     3154           then do :
     3155             enable
     3156               tt-rvs-line.state-temperature
     3157             with frame Dialog-Frame.
     3158           end .
     3159         end .
     3160       end .
     3161     end .
     3162     apply "leave" to tt-rvs-line.state-level-total in frame Dialog-Frame .
     3163   end .
     3164   ON CHOOSE OF b-mi-tmp IN FRAME Dialog-Frame
     3165   DO:
     3166     define variable v-node-code as integer no-undo.
     3167     define variable v-sr-type-id as character no-undo.
     3168     define variable v-sr-type-izm as character no-undo .
     3169     v-node-code = 0 .
     3170       v-sr-type-izm = "0,1" .
     3171     run ref/sr-izm.w (input parparentproc ,
     3172                       input "b-sel"       ,
     3173                       input 'ПРОСМОТР':U     ,
     3174                       input v-sr-type-izm ,
     3175                       input "tmp"         ,
     3176                       input-output v-node-code,
     3177                       output v-sr-type-id) no-error.
     3178     if v-node-code <> 0 and v-node-code <> ? then do :
     3179       v-mi-tmp = v-node-code.
     3180       v-mi-tmp:screen-value = string(v-node-code).
     3181       find first tmp_sr-izmerenia no-lock where tmp_sr-izmerenia.node-code = v-mi-tmp .
     3182       apply "leave" to v-mi-tmp in frame Dialog-Frame .
     3183     end.
     3184   END.
     3185   on entry of v-mi-tmp-name IN FRAME Dialog-Frame
     3186   do:
     3187     apply "entry" to v-mi-tmp in frame Dialog-Frame.
     3188   end .
     3189   on entry of v-mi-tmp IN FRAME Dialog-Frame
     3190   do:
     3191     hide v-mi-tmp-name in frame Dialog-Frame.
     3192   end .
     3193   on return of v-mi-tmp IN FRAME Dialog-Frame
     3194   do:
     3195     apply "leave" to v-mi-tmp IN FRAME Dialog-Frame .
     3196   end .
     3197   on del, backspace, "?" of v-mi-tmp in frame Dialog-Frame
     3198   do :
     3199     v-mi-tmp = ? .
     3200     v-mi-tmp:screen-value = "?" .
     3201   end .
     3202   on leave of v-mi-tmp IN FRAME Dialog-Frame
     3203   do:
     3204     define variable vlog as logical no-undo .
     3205     define variable v-old-val as character no-undo .
     3206     v-old-val = string(v-mi-tmp) .
     3207     find first tmp_sr-izmerenia no-lock where tmp_sr-izmerenia.node-code = integer(v-mi-tmp:screen-value) no-error .
     3208     if not available tmp_sr-izmerenia
     3209     then do :
     3210       if v-mi-tmp:screen-value <> "?"
     3211       and v-mi-tmp:screen-value <> "0"
     3212       then do :
     3213         message ("Не найдено средтсво измерения с кодом " + v-mi-tmp:screen-value) view-as alert-box .
     3214         v-mi-tmp:screen-value = v-old-val .
     3215       end .
     3216       return .
     3217     end .
     3218     else do :
     3219       if tmp_sr-izmerenia.sr-type-izm = 2
     3220       then do :
     3221         message "Средство измерения является Измерительной Системой!" view-as alert-box .
     3222         v-mi-tmp:screen-value = v-old-val .
     3223         return .
     3224       end .
     3225       if not tmp_sr-izmerenia.sr-temperature
     3226       then do :
     3227         message "Средство измерения НЕ измеряет температуру!" view-as alert-box .
     3228         v-mi-tmp:screen-value = v-old-val .
     3229         return .
     3230       end .
     3231     end .
     3232     v-mi-tmp-name = tmp_sr-izmerenia.sr-model .
     3233     display v-mi-tmp-name with frame Dialog-Frame.
     3234     enable v-mi-tmp-name with frame Dialog-Frame.
     3235     assign v-mi-tmp .
     3236     if string(v-mi-tmp) <> v-old-val
     3237     then do :
     3238       tt-rvs-line.temp-izm-vol = ? .
     3239     end .
     3240     display tt-rvs-line.temp-izm-vol with frame Dialog-Frame.
     3241     if v-revision-mode
     3242     then do :
     3243       if v-mi-dnst > 0
     3244       and v-mi-lvl > 0
     3245       then do :
     3246         enable
     3247           tt-rvs-line.state-level-total
     3248           tt-rvs-line.state-level-water
     3249           b-temperature
     3250           b-density
     3251         with frame Dialog-Frame.
     3252       end .
     3253     end .
     3254     else do :
     3255       if ((pl-rvd-lvl and v-mi-lvl > 0) or not pl-rvd-lvl)
     3256       and ((pl-rvd-dens and v-mi-dnst > 0) or not pl-rvd-dens)
     3257       and ((pl-rvd-temp and v-mi-tmp > 0) or not pl-rvd-temp)
     3258       then do :
     3259         if pl-rvd-lvl
     3260         then do :
     3261           enable
     3262             tt-rvs-line.state-level-total
     3263             tt-rvs-line.state-level-water
     3264           with frame Dialog-Frame.
     3265         end .
     3266         if pl-rvd-dens
     3267         then do :
     3268           enable
     3269             b-density
     3270           with frame Dialog-Frame.
     3271         end .
     3272         if pl-rvd-temp
     3273         then do :
     3274           enable
     3275             b-temperature
     3276           with frame Dialog-Frame.
     3277         end .
     3278       end .
     3279     end .
     3280     if pl-rvd-dens <> pl-rvd-temp
     3281     then do :
     3282       find first dnst_sr-izmerenia no-lock where dnst_sr-izmerenia.node-code = v-mi-dnst no-error .
     3283       if (available tmp_sr-izmerenia and tmp_sr-izmerenia.sr-type-izm = 0 and tmp_sr-izmerenia.sr-density and tmp_sr-izmerenia.sr-temperature)
     3284       or (available dnst_sr-izmerenia and dnst_sr-izmerenia.sr-type-izm = 0 and dnst_sr-izmerenia.sr-density and dnst_sr-izmerenia.sr-temperature)
     3285       then do :
     3286         message "Бизнес-процессом не предусмотрено использование неравнозначных положений разрешения РВД по параметрам температура и плотность, "
     3287                 "если дополнительное автоматизированное СИ предназначено для измерения обоих параметров." skip
     3288                 "Подайте заявку в службу поддержки для приведения параметров в соответствие требованиям бизнес-процесса."
     3289         view-as alert-box .
     3290       end .
     3291     end .
     3292     if tmp_sr-izmerenia.sr-density
     3293     and v-mi-tmp <> v-mi-dnst
     3294     and b-mi-dnst:sensitive
     3295     then do :
     3296         v-mi-dnst = v-mi-tmp .
     3297         v-mi-dnst:screen-value = v-mi-tmp:screen-value .
     3298         v-mi-dnst-name = v-mi-tmp-name .
     3299         apply "leave" to v-mi-dnst in frame Dialog-Frame .
     3300     end .
     3301     apply "leave" to tt-rvs-line.state-level-total in frame Dialog-Frame .
     3302   end .
     3303   on value-changed of t-tank-cleaning in frame Dialog-Frame
     3304   do :
     3305     assign t-tank-cleaning .
     3306     find first rvs-line-attr exclusive-lock
     3307        where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     3308          and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     3309          and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     3310          and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     3311          and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     3312          and rvs-line-attr.attr-code = "is-calc" no-error.
     3313     if available rvs-line-attr
     3314     then do :
     3315       rvs-line-attr.attr-value = string(no) .
     3316     end .
     3317   end .
     3318   ON CHOOSE OF b-calc IN FRAME Dialog-Frame
     3319   DO:
     3320   define variable v-proc as character no-undo.
     3321   define variable v-pokmi-dll-version as character no-undo .
     3322   define variable v-code            as character no-undo.
     3323   define variable ii                as integer   no-undo.
     3324   define variable place-ratio-error as decimal no-undo.
     3325   define variable dens-prov         as decimal no-undo format "9.9999999999":U.
     3326   define variable CalibTable        as character no-undo initial "".
     3327   define variable CalibBelt         as character no-undo initial "".
     3328   define variable ToolType          as integer no-undo.
     3329   define variable LevelToolType          as integer no-undo.
     3330   define variable A_LevelMeasurementTool  as decimal no-undo.
     3331   define variable DeltaAbs_H              as decimal no-undo.
     3332   define variable DeltaAbs_H_Water        as decimal no-undo.
     3333   define variable DeltaAbs_R              as decimal no-undo.
     3334   define variable DeltaAbs_Tv             as decimal no-undo.
     3335   define variable DeltaAbs_Tr             as decimal no-undo.
     3336   define variable DeltaOtn_N              as decimal no-undo init 0.05 .
     3337   define variable DeltaOtn_K              as decimal no-undo.
     3338   define variable A_Reservoir             as decimal no-undo init 0.0000125 .
     3339   define variable DeadZone_Reservoir      as decimal no-undo.
     3340   define variable DeltaOtn_H              as decimal no-undo.
     3341   define variable DeltaOtn_H_Water        as decimal no-undo.
     3342   define variable DeltaOtn_R              as decimal no-undo.
     3343   define variable ToolAutomationLevel_H   as integer no-undo.
     3344   define variable ToolAutomationLevel_H_Water as integer no-undo.
     3345   define variable ToolAutomationLevel_R   as integer no-undo.
     3346   define variable ToolAutomationLevel_Tv  as integer no-undo.
     3347   define variable ToolAutomationLevel_Tr  as integer no-undo.
     3348   define variable DeltaAbs_H_CalcType     as integer no-undo.
     3349   define variable DeltaAbs_H_Water_CalcType   as integer no-undo.
     3350   define variable temp-for-pomi           as integer no-undo.
     3351   define variable error-string            as character no-undo.
     3352   define variable v-is-meas               as logical no-undo.
     3353   define variable v-mm-density            as decimal no-undo.
     3354   define variable place-ponton            as logical no-undo .
     3355   define variable place-ponton-mass       as decimal no-undo .
     3356   define variable place-ponton-height     as decimal no-undo .
     3357   define variable DeltaV1                 as decimal no-undo .
     3358   define variable DeltaV2                 as decimal no-undo .
     3359   define variable WaterDeltaV1            as decimal no-undo .
     3360   define variable WaterDeltaV2            as decimal no-undo .
     3361   define variable Tv                      as decimal no-undo .
     3362   define variable Tr                      as decimal no-undo .
     3363   define variable R                       as decimal no-undo .
     3364   define variable v-POkMI-result          as character no-undo.
     3365   define buffer buf_sr-izmerenia for sr-izmerenia .
     3366   define buffer dens_sr-izmerenia for sr-izmerenia .
     3367   define buffer temp_sr-izmerenia for sr-izmerenia .
     3368   define buffer level_sr-izmerenia for sr-izmerenia .
     3369   define buffer temp-dens_sr-izmerenia for sr-izmerenia .
     3370   define buffer buf_place     for ub.place.
     3371   define buffer water1_pl-level  for ub.pl-level .
     3372   define buffer water2_pl-level  for ub.pl-level .
     3373   define buffer total1_pl-level  for ub.pl-level .
     3374   define buffer total2_pl-level  for ub.pl-level .
     3375   define buffer buf_pl-level-attr for ub.pl-level-attr .
     3376   define buffer bf_goods for ub.goods .
     3377   define buffer bf_place for ub.place .
     3378   define variable vErr as character no-undo .
     3379   define variable vWrn as character no-undo .
     3380   define variable vDllVersion as character no-undo .
     3381   define variable V_total      as decimal no-undo .
     3382   define variable V_water      as decimal no-undo .
     3383   define variable DeltaV       as decimal no-undo .
     3384   define variable Vcy          as decimal no-undo .
     3385   define variable Rcy          as decimal no-undo .
     3386   define variable V_product    as decimal no-undo .
     3387   define variable V            as decimal no-undo .
     3388   define variable Rv           as decimal no-undo .
     3389   define variable M            as decimal no-undo .
     3390   define variable CTL_base_alt as decimal no-undo .
     3391   define variable CPL_base_alt as decimal no-undo .
     3392   define variable CTPL_base_alt as decimal no-undo .
     3393   define variable Fp_base_alt  as decimal no-undo .
     3394   define variable CTL_obs_base as decimal no-undo .
     3395   define variable CPL_obs_base as decimal no-undo .
     3396   define variable CTPL_obs_base as decimal no-undo .
     3397   define variable Fp_obs_base  as decimal no-undo .
     3398   define variable DeltaOtn_Vcy as decimal no-undo .
     3399   define variable DeltaOtn_Vm  as decimal no-undo .
     3400   define variable DeltaOtn_M   as decimal no-undo .
     3401   define variable VolumetricExpansion as decimal no-undo .
     3402     assign frame Dialog-Frame tt-rvs-line.state-level-total   .
     3403     assign frame Dialog-Frame tt-rvs-line.state-level-water   .
     3404     assign frame Dialog-Frame tt-rvs-line.state-temperature   .
     3405     assign frame Dialog-Frame tt-rvs-line.izmer-density       .
     3406     assign frame Dialog-Frame tt-rvs-line.temp-izm-vol       .
     3407     assign frame Dialog-Frame CriticalDif .
     3408     assign frame Dialog-Frame delta-mass-qnty .
     3409     _trpomi :
     3410       do on error undo, return no-apply :
     3411       if tt-rvs-line.izmer-density = ? or tt-rvs-line.izmer-density = 0 then do :
     3412         message
     3413           "Заполнены не все поля, необходимые" skip
     3414           "для работы библиотеки ПОкМИ"        skip
     3415           "Введите плотность измер.для ПОкМИ"
     3416         view-as alert-box error.
     3417         apply "entry" to tt-rvs-line.izmer-density in frame Dialog-Frame.
     3418         undo _trpomi, return .
     3419       end.
     3420       if tt-rvs-line.state-level-total = ? or tt-rvs-line.state-level-total = 0 then do :
     3421         message
     3422           "Заполнены не все поля, необходимые" skip
     3423           "для работы библиотеки ПОкМИ"        skip
     3424           "Введите факт. общий уровень"
     3425         view-as alert-box error.
     3426         apply "entry" to tt-rvs-line.state-level-total in frame Dialog-Frame.
     3427         undo _trpomi, return .
     3428       end.
     3429       if tt-rvs-line.state-level-water = ? then do :
     3430         message
     3431           "Заполнены не все поля, необходимые" skip
     3432           "для работы библиотеки ПОкМИ"        skip
     3433           "Введите факт. уровень воды"
     3434         view-as alert-box error.
     3435         apply "entry" to tt-rvs-line.state-level-water in frame Dialog-Frame.
     3436         undo _trpomi, return .
     3437       end.
     3438       if tt-rvs-line.state-temperature = ?
     3439       then do :
     3440         message
     3441           "Заполнены не все поля, необходимые" skip
     3442           "для работы библиотеки ПОкМИ"        skip
     3443           "Введите температуру"
     3444         view-as alert-box error.
     3445         apply "entry" to tt-rvs-line.state-temperature in frame Dialog-Frame.
     3446         undo _trpomi, return .
     3447       end.
     3448       if tt-rvs-line.temp-izm-vol = ?
     3449       then do :
     3450         message
     3451           "Заполнены не все поля, необходимые" skip
     3452           "для работы библиотеки ПОкМИ"        skip
     3453           "Введите температуру измерения объема"
     3454         view-as alert-box error.
     3455         apply "entry" to tt-rvs-line.temp-izm-vol in frame Dialog-Frame.
     3456         undo _trpomi, return .
     3457       end.
     3458       do ii = 1 to num-entries('place-type,place-SI,place-diameter,dead-balance,water-level,dens-prov,place-virtual,place-twice-code,place-sert-urov,place-local,place-error-mass,place-asi-sertif,place-rvd-dnsty,place-rvd-lvl,place-rvd-tmp,place-SI-dens,place-SI-level,place-SI-temp,place-passp-num,place-passp-type,place-dead-high,place-temp-coef,disable-water-alarm,disable-level-alarm,place-ponton,place-ponton-mass,place-ponton-height,place-com-vessel,place-com-tanks,place-is-main,place-gate-valve,place-gate-valve-tanks,place-auto-gate-valve':u,','):
     3459         v-code = entry(ii,'place-type,place-SI,place-diameter,dead-balance,water-level,dens-prov,place-virtual,place-twice-code,place-sert-urov,place-local,place-error-mass,place-asi-sertif,place-rvd-dnsty,place-rvd-lvl,place-rvd-tmp,place-SI-dens,place-SI-level,place-SI-temp,place-passp-num,place-passp-type,place-dead-high,place-temp-coef,disable-water-alarm,disable-level-alarm,place-ponton,place-ponton-mass,place-ponton-height,place-com-vessel,place-com-tanks,place-is-main,place-gate-valve,place-gate-valve-tanks,place-auto-gate-valve':u) .
     3460         run placelib_get-attr  ( input v-code
     3461                                 ,input tt-rvs-line.obj-code
     3462                                 ,input tt-rvs-line.obj-type
     3463                                 ,input tt-rvs-line.pl-code
     3464                                 ,output v-value
     3465                                 ,output v-ok      ) no-error.
     3466         case v-code :
     3467           when "place-type" then do :
     3468             if v-ok then place-type = integer(v-value) .
     3469           end.
     3470           when "place-SI" then do :
     3471             if v-ok then place-si = integer(v-value) .
     3472           end.
     3473           when "place-diameter" then do :
     3474             if v-ok then place-diameter = decimal(v-value) .
     3475           end.
     3476           when "dens-prov" then do :
     3477             if v-ok then dens-prov = decimal(v-value) .
     3478           end.
     3479           when "place-dead-high" then do :
     3480             if v-ok then DeadZone_Reservoir = decimal(v-value) .
     3481           end.
     3482           when "place-ponton" then do :
     3483             if v-ok then place-ponton = logical(v-value) .
     3484           end.
     3485           when "place-ponton-mass" then do :
     3486             if v-ok then place-ponton-mass = decimal(v-value) .
     3487           end.
     3488           when "place-ponton-height" then do :
     3489             if v-ok then place-ponton-height = decimal(v-value) .
     3490           end.
     3491         end case.
     3492       end.
     3493       if tt-rvs-line.state-level-water > 0
     3494       then do :
     3495         find last water1_pl-level no-lock where water1_pl-level.pl-code  = tt-rvs-line.pl-code
     3496                                             and water1_pl-level.obj-code = tt-rvs-line.obj-code
     3497                                             and water1_pl-level.obj-type = tt-rvs-line.obj-type
     3498                                             and water1_pl-level.pl-level <= tt-rvs-line.state-level-water
     3499                                             no-error .
     3500         if available water1_pl-level
     3501         then do :
     3502           WaterDeltaV1 = ? .
     3503           for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = water1_pl-level.pl-code
     3504                                                 and buf_pl-level-attr.obj-code = water1_pl-level.obj-code
     3505                                                 and buf_pl-level-attr.obj-type = water1_pl-level.obj-type
     3506                                                 and buf_pl-level-attr.pl-level = water1_pl-level.pl-level
     3507                                                 and buf_pl-level-attr.attr-code = "deltaV"
     3508                                                 :
     3509             WaterDeltaV1 = decimal(buf_pl-level-attr.attr-value) no-error .
     3510           end .
     3511         end .
     3512         if available water1_pl-level
     3513         and water1_pl-level.pl-level <> tt-rvs-line.state-level-water
     3514         then do :
     3515           find first water2_pl-level no-lock where water2_pl-level.pl-code  = tt-rvs-line.pl-code
     3516                                               and water2_pl-level.obj-code = tt-rvs-line.obj-code
     3517                                               and water2_pl-level.obj-type = tt-rvs-line.obj-type
     3518                                               and water2_pl-level.pl-level >= tt-rvs-line.state-level-water
     3519                                               no-error .
     3520           if available water2_pl-level
     3521           then do :
     3522             WaterDeltaV2 = ? .
     3523             for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = water2_pl-level.pl-code
     3524                                                   and buf_pl-level-attr.obj-code = water2_pl-level.obj-code
     3525                                                   and buf_pl-level-attr.obj-type = water2_pl-level.obj-type
     3526                                                   and buf_pl-level-attr.pl-level = water2_pl-level.pl-level
     3527                                                   and buf_pl-level-attr.attr-code = "deltaV"
     3528                                                   :
     3529               WaterDeltaV2 = decimal(buf_pl-level-attr.attr-value) no-error .
     3530             end .
     3531           end .
     3532         end .
     3533       end .
     3534       find last total1_pl-level no-lock where total1_pl-level.pl-code  = tt-rvs-line.pl-code
     3535                                           and total1_pl-level.obj-code = tt-rvs-line.obj-code
     3536                                           and total1_pl-level.obj-type = tt-rvs-line.obj-type
     3537                                           and total1_pl-level.pl-level <= tt-rvs-line.state-level-total
     3538                                           no-error .
     3539       if not available total1_pl-level
     3540       then do :
     3541         find first bf_goods no-lock where bf_goods.gds-code = tt-rvs-line.gds-code no-error .
     3542         find first bf_place no-lock where bf_place.pl-code = tt-rvs-line.pl-code no-error .
     3543         message
     3544           substitute( 'Для резервуара &1 (&2 &3) не заполнена градуировочная таблица. Запуск ПОкМИ невозможен.'
     3545                      ,(if available bf_place then bf_place.loc1 else "?")
     3546                      ,(if available bf_goods then string(bf_goods.gds-code) else "?")
     3547                      ,(if available bf_goods then bf_goods.gds-name else "?") )
     3548         view-as alert-box .
     3549         undo _trpomi, return .
     3550       end .
     3551       DeltaOtn_K = ? .
     3552       for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = total1_pl-level.pl-code
     3553                                             and buf_pl-level-attr.obj-code = total1_pl-level.obj-code
     3554                                             and buf_pl-level-attr.obj-type = total1_pl-level.obj-type
     3555                                             and buf_pl-level-attr.pl-level = total1_pl-level.pl-level
     3556                                             and buf_pl-level-attr.attr-code = "tarir-delta"
     3557                                             :
     3558         DeltaOtn_K = decimal(buf_pl-level-attr.attr-value) .
     3559       end .
     3560       if DeltaOtn_K = ? then DeltaOtn_K = 0.25 .
     3561       DeltaV1 = ? .
     3562       for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = total1_pl-level.pl-code
     3563                                             and buf_pl-level-attr.obj-code = total1_pl-level.obj-code
     3564                                             and buf_pl-level-attr.obj-type = total1_pl-level.obj-type
     3565                                             and buf_pl-level-attr.pl-level = total1_pl-level.pl-level
     3566                                             and buf_pl-level-attr.attr-code = "deltaV"
     3567                                             :
     3568         DeltaV1 = decimal(buf_pl-level-attr.attr-value) no-error .
     3569       end .
     3570       find first total2_pl-level no-lock where total2_pl-level.pl-code  = tt-rvs-line.pl-code
     3571                                           and total2_pl-level.obj-code = tt-rvs-line.obj-code
     3572                                           and total2_pl-level.obj-type = tt-rvs-line.obj-type
     3573                                           and total2_pl-level.pl-level > tt-rvs-line.state-level-total
     3574                                           no-error .
     3575       if not available total2_pl-level
     3576       then do :
     3577         find first bf_goods no-lock where bf_goods.gds-code = tt-rvs-line.gds-code no-error .
     3578         find first bf_place no-lock where bf_place.pl-code = tt-rvs-line.pl-code no-error .
     3579         message
     3580           substitute( 'Для резервуара &1 (&2 &3) не заполнена градуировочная таблица. Запуск ПОкМИ невозможен.'
     3581                      ,(if available bf_place then bf_place.loc1 else "?")
     3582                      ,(if available bf_goods then string(bf_goods.gds-code) else "?")
     3583                      ,(if available bf_goods then bf_goods.gds-name else "?") )
     3584         view-as alert-box .
     3585         undo _trpomi, return .
     3586       end .
     3587       DeltaV2 = ? .
     3588       for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = total2_pl-level.pl-code
     3589                                             and buf_pl-level-attr.obj-code = total2_pl-level.obj-code
     3590                                             and buf_pl-level-attr.obj-type = total2_pl-level.obj-type
     3591                                             and buf_pl-level-attr.pl-level = total2_pl-level.pl-level
     3592                                             and buf_pl-level-attr.attr-code = "deltaV"
     3593                                             :
     3594         DeltaV2 = decimal(buf_pl-level-attr.attr-value) no-error .
     3595       end .
     3596       if available water1_pl-level
     3597       then do :
     3598         CalibTable = Substitute("&1=&2", water1_pl-level.pl-level, (water1_pl-level.pl-qnty / 1000)) + (if WaterDeltaV1 > 0 then ("=" + trim(string(WaterDeltaV1, ">>9.9999"))) else "") + chr(10) .
     3599       end .
     3600       if available water2_pl-level
     3601       then do :
     3602         CalibTable = CalibTable + Substitute("&1=&2", water2_pl-level.pl-level, (water2_pl-level.pl-qnty / 1000)) + (if WaterDeltaV2 > 0 then ("=" + trim(string(WaterDeltaV2, ">>9.9999"))) else "") + chr(10) .
     3603       end .
     3604       CalibTable = CalibTable + Substitute("&1=&2", total1_pl-level.pl-level, (total1_pl-level.pl-qnty / 1000)) + (if DeltaV1 > 0 then ("=" + trim(string(DeltaV1, ">>9.9999"))) else "") + chr(10) .
     3605       CalibTable = CalibTable + Substitute("&1=&2", total2_pl-level.pl-level, (total2_pl-level.pl-qnty / 1000)) + (if DeltaV2 > 0 then ("=" + trim(string(DeltaV2, ">>9.9999"))) else "") .
     3606       if t-tank-cleaning
     3607       then do :
     3608         CalibTable = "0=0" + chr(10) + "1=0" .
     3609       end .
     3610       CalibBelt = getCalibrationBelt(
     3611           tt-rvs-line.obj-type,
     3612           tt-rvs-line.obj-code,
     3613           tt-rvs-line.pl-code,
     3614           tt-rvs-line.state-level-total,
     3615           if tt-rvs-line.state-level-water <> ? then tt-rvs-line.state-level-water else 0
     3616       ).
     3617       if t-tank-cleaning
     3618       then do :
     3619         assign CalibBelt = "" .
     3620       end .
     3621       if (pl-rvd-lvl
     3622       and pl-rvd-dens
     3623       and pl-rvd-temp)
     3624       or v-revision-mode
     3625       then do : end .
     3626       else do :
     3627         if place-si = 0
     3628         or place-si = ?
     3629         then do :
     3630           message
     3631             substitute ("Для складского места &1 не заданно средство измерения",tt-rvs-line.pl-code)
     3632           view-as alert-box error.
     3633           undo _trpomi, return no-apply.
     3634         end.
     3635         else do :
     3636           find first buf_sr-izmerenia no-lock where buf_sr-izmerenia.node-code = place-si no-error.
     3637           if not available buf_sr-izmerenia then do :
     3638             message
     3639             "Ошибка работы с библиотекой ПОкМИ"
     3640             substitute( 'Не найдено средство измерения с кодом &1', place-si ) skip
     3641             view-as alert-box error.
     3642             undo _trpomi, return no-apply.
     3643           end.
     3644           else do :
     3645             assign
     3646               ToolType               = buf_sr-izmerenia.sr-type-id
     3647               A_LevelMeasurementTool = buf_sr-izmerenia.sr-temp-line
     3648               ToolAutomationLevel_H  = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3649               ToolAutomationLevel_H_Water = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3650               DeltaAbs_H             = buf_sr-izmerenia.sr-abs-err-neft-water
     3651               DeltaAbs_H_Water       = buf_sr-izmerenia.sr-abs-err-water
     3652               ToolAutomationLevel_R  = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3653               DeltaAbs_R             = buf_sr-izmerenia.sr-abs-err-dens
     3654               ToolAutomationLevel_Tv = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3655               DeltaAbs_Tv            = buf_sr-izmerenia.sr-abs-err-temp-vol
     3656               ToolAutomationLevel_Tr = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3657               DeltaAbs_Tr            = buf_sr-izmerenia.sr-abs-err-temp-dens
     3658               DeltaOtn_N             = 0.05
     3659               DeltaOtn_H             = buf_sr-izmerenia.sr-relative-err-neft-water
     3660               DeltaOtn_H_Water       = buf_sr-izmerenia.sr-relative-err-water
     3661               DeltaOtn_R             = buf_sr-izmerenia.sr-relative-err-dens
     3662               DeltaAbs_H_CalcType    = buf_sr-izmerenia.sr-type-level-measuring + 1
     3663               DeltaAbs_H_Water_CalcType = buf_sr-izmerenia.sr-type-level-measuring + 1
     3664             .
     3665           end.
     3666         end.
     3667       end.
     3668       if pl-rvd-lvl
     3669       or v-revision-mode
     3670       then do :
     3671         if v-mi-lvl = 0
     3672         or v-mi-lvl = ?
     3673         then do :
     3674           message
     3675             substitute ("Для складского места &1 не заданно дополнительное средство измерения уровня",tt-rvs-line.pl-code)
     3676           view-as alert-box error.
     3677           undo _trpomi, return no-apply.
     3678         end .
     3679         else
     3680         if v-mi-lvl <> place-si
     3681         or not available buf_sr-izmerenia
     3682         then do :
     3683           find first level_sr-izmerenia no-lock where level_sr-izmerenia.node-code = v-mi-lvl no-error.
     3684           if not available level_sr-izmerenia then do :
     3685             message
     3686             "Ошибка работы с библиотекой ПОкМИ"
     3687             substitute( 'Не найдено средство измерения с кодом &1', v-mi-lvl ) skip
     3688             view-as alert-box error.
     3689             undo _trpomi, return no-apply.
     3690           end.
     3691           else do :
     3692             assign
     3693               A_LevelMeasurementTool = level_sr-izmerenia.sr-temp-line
     3694               DeltaAbs_H             = level_sr-izmerenia.sr-abs-err-neft-water
     3695               DeltaAbs_H_Water       = level_sr-izmerenia.sr-abs-err-water
     3696               DeltaOtn_H             = level_sr-izmerenia.sr-relative-err-neft-water
     3697               DeltaOtn_H_Water       = level_sr-izmerenia.sr-relative-err-water
     3698             .
     3699           end.
     3700         end .
     3701       end .
     3702       if pl-rvd-dens
     3703       or v-revision-mode
     3704       then do :
     3705         if v-mi-dnst = 0
     3706         or v-mi-dnst = ?
     3707         then do :
     3708           message
     3709             substitute ("Для складского места &1 не заданно дополнительное средство измерения плотности",tt-rvs-line.pl-code)
     3710           view-as alert-box error.
     3711           undo _trpomi, return no-apply.
     3712         end .
     3713         else
     3714         if v-mi-dnst <> place-si
     3715         or not available buf_sr-izmerenia
     3716         then do :
     3717           find first dens_sr-izmerenia no-lock where dens_sr-izmerenia.node-code = v-mi-dnst no-error.
     3718           if not available dens_sr-izmerenia then do :
     3719             message
     3720             "Ошибка работы с библиотекой ПОкМИ"
     3721             substitute( 'Не найдено средство измерения с кодом &1', v-mi-dnst ) skip
     3722             view-as alert-box error.
     3723             undo _trpomi, return no-apply.
     3724           end.
     3725           else do :
     3726             assign
     3727               ToolType               = dens_sr-izmerenia.sr-type-id
     3728               DeltaAbs_R             = dens_sr-izmerenia.sr-abs-err-dens
     3729               DeltaOtn_R             = dens_sr-izmerenia.sr-relative-err-dens
     3730             .
     3731           end.
     3732         end .
     3733       end .
     3734       if pl-rvd-temp
     3735       or v-revision-mode
     3736       then do :
     3737         if v-mi-tmp = 0
     3738         or v-mi-tmp = ?
     3739         then do :
     3740           message
     3741             substitute ("Для складского места &1 не заданно дополнительное средство измерения температуры",tt-rvs-line.pl-code)
     3742           view-as alert-box error.
     3743           undo _trpomi, return no-apply.
     3744         end .
     3745         else
     3746         if v-mi-tmp <> place-si
     3747         or not available buf_sr-izmerenia
     3748         then do :
     3749           find first temp_sr-izmerenia no-lock where temp_sr-izmerenia.node-code = v-mi-tmp no-error.
     3750           if not available temp_sr-izmerenia then do :
     3751             message
     3752             "Ошибка работы с библиотекой ПОкМИ"
     3753             substitute( 'Не найдено средство измерения с кодом &1', v-mi-tmp ) skip
     3754             view-as alert-box error.
     3755             undo _trpomi, return no-apply.
     3756           end.
     3757           else do :
     3758             assign
     3759               DeltaAbs_Tv            = temp_sr-izmerenia.sr-abs-err-temp-vol
     3760               DeltaAbs_Tr            = temp_sr-izmerenia.sr-abs-err-temp-dens
     3761               ToolAutomationLevel_Tr = vAutomationDegree[temp_sr-izmerenia.sr-type-izm + 1]
     3762             .
     3763           end.
     3764         end .
     3765       end .
     3766       if v-mi-tmp-dnst > 0
     3767       and v-mi-tmp-dnst <> v-mi-tmp
     3768       then do :
     3769         for first temp-dens_sr-izmerenia no-lock where temp-dens_sr-izmerenia.node-code = v-mi-tmp-dnst :
     3770           assign
     3771             DeltaAbs_Tr = temp-dens_sr-izmerenia.sr-abs-err-temp-dens when temp-dens_sr-izmerenia.sr-abs-err-temp-dens > 0
     3772             ToolAutomationLevel_Tr = vAutomationDegree[temp-dens_sr-izmerenia.sr-type-izm + 1]
     3773           .
     3774         end .
     3775       end .
     3776       if available level_sr-izmerenia
     3777       then assign
     3778         LevelToolType = level_sr-izmerenia.sr-type-level-measuring
     3779         ToolAutomationLevel_H  = vAutomationDegree[level_sr-izmerenia.sr-type-izm + 1]
     3780         ToolAutomationLevel_H_Water = vAutomationDegree[level_sr-izmerenia.sr-type-izm + 1]
     3781         DeltaAbs_H_CalcType = level_sr-izmerenia.sr-type-level-measuring + 1
     3782         DeltaAbs_H_Water_CalcType = level_sr-izmerenia.sr-type-level-measuring + 1
     3783       .
     3784       else assign
     3785         LevelToolType = buf_sr-izmerenia.sr-type-level-measuring
     3786         ToolAutomationLevel_H  = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3787         ToolAutomationLevel_H_Water = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3788         DeltaAbs_H_CalcType = buf_sr-izmerenia.sr-type-level-measuring + 1
     3789         DeltaAbs_H_Water_CalcType = buf_sr-izmerenia.sr-type-level-measuring + 1
     3790       .
     3791       if avail temp_sr-izmerenia then
     3792         ToolAutomationLevel_Tv = vAutomationDegree[temp_sr-izmerenia.sr-type-izm + 1].
     3793       else
     3794         ToolAutomationLevel_Tv = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1].
     3795       if avail dens_sr-izmerenia then
     3796         ToolAutomationLevel_R  = vAutomationDegree[dens_sr-izmerenia.sr-type-izm + 1].
     3797       else
     3798         ToolAutomationLevel_R = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1].
     3799       if available dens_sr-izmerenia
     3800       and dens_sr-izmerenia.sr-type-izm = 3
     3801       and dens_sr-izmerenia.sr-temperature
     3802       then do :
     3803         DeltaAbs_Tr = dens_sr-izmerenia.sr-abs-err-temp-dens .
     3804         ToolAutomationLevel_Tr = vAutomationDegree[dens_sr-izmerenia.sr-type-izm + 1].
     3805       end .
     3806       if DeltaAbs_H       = ? then DeltaAbs_H = 0 .
     3807       if DeltaAbs_H_Water = ? then DeltaAbs_H_Water = 0 .
     3808       if DeltaAbs_R       = ? then DeltaAbs_R = 0 .
     3809       if DeltaAbs_Tv      = ? then DeltaAbs_Tv = 0 .
     3810       if DeltaAbs_Tr      = ? then DeltaAbs_Tr = 0 .
     3811       if DeltaOtn_N       = ? then DeltaOtn_N = 0 .
     3812       if DeltaOtn_H       = ? then DeltaOtn_H = 0 .
     3813       if DeltaOtn_H_Water = ? then DeltaOtn_H_Water = 0 .
     3814       if DeltaOtn_R       = ? then DeltaOtn_R = 0 .
     3815       if LevelToolType    = ? then LevelToolType = 0 .
     3816       if ToolType         = ? then ToolType = 0 .
     3817       if A_LevelMeasurementTool      = ? then A_LevelMeasurementTool = 0 .
     3818       if ToolAutomationLevel_Tr      = ? then ToolAutomationLevel_Tr =0.
     3819       if ToolAutomationLevel_H       = ? then ToolAutomationLevel_H = 0.
     3820       if ToolAutomationLevel_H_Water = ? then ToolAutomationLevel_H_Water = 0.
     3821       if ToolAutomationLevel_Tv      = ? then ToolAutomationLevel_Tv = 0.
     3822       if ToolAutomationLevel_R       = ? then ToolAutomationLevel_R = 0.
     3823       if DeltaAbs_H_CalcType         = ? then DeltaAbs_H_CalcType = 0.
     3824       if DeltaAbs_H_Water_CalcType   = ? then DeltaAbs_H_Water_CalcType = 0.
     3825       if tt-rvs-line.state-level-water = 0
     3826       then do :
     3827         ToolAutomationLevel_H_Water = 3 .
     3828         DeltaAbs_H_Water_CalcType = 1 .
     3829         DeltaAbs_H_Water = 0 .
     3830         DeltaOtn_H_Water = 0 .
     3831       end .
     3832       if LevelToolType > 0
     3833       then do :
     3834         MM57
     3835           (input tt-rvs-line.state-level-total * 10,
     3836            input LevelToolType,
     3837            output DeltaAbs_H,
     3838            output vErr,
     3839            output vWrn,
     3840            output vDllVersion)
     3841         .
     3842         OUTPUT stream outstream to value ("pomi.log") append.
     3843         PUT STREAM outstream unformatted
     3844                     "    " SKIP
     3845                     "    " SKIP
     3846                     cur-time-string()           FORMAT "x(16)"    SKIP
     3847                     'Процедура             "CMethodOfMetering57"'       SKIP
     3848                     'Версия dll: '            vDllVersion   skip
     3849                     'CODE_PL                = ' tt-rvs-line.pl-code                           SKIP
     3850                     'H                      = ' tt-rvs-line.state-level-total * 10                  SKIP
     3851                     'ToolType               = ' LevelToolType                                      SKIP
     3852                         SKIP SKIP
     3853         .
     3854         output stream outstream close.
     3855         if trim(vErr) > "" then do :
     3856           output stream outstream to value ("pomi.log")  append.
     3857           put stream outstream vErr format "X(1024)" skip.
     3858           output stream outstream close.
     3859           message substitute('Ошибка работы библиотеки ПОкМИ &1', vErr) view-as alert-box .
     3860           undo _trpomi, return no-apply .
     3861         end.
     3862         else do :
     3863           OUTPUT stream outstream to value ("pomi.log")  append.
     3864           PUT STREAM outstream unformatted
     3865               "DeltaAbs_H = " DeltaAbs_H  SKIP
     3866           .
     3867           OUTPUT stream outstream close.
     3868         end .
     3869       end .
     3870   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3871   run get-ptrl-prop in this-procedure
     3872     ( input tt-rvs-line.obj-type
     3873     , input tt-rvs-line.obj-code
     3874     ) .
     3875       if not error-status :error then do:
     3876         if ptrlprop-temp-for-pomi = 1 then temp-for-pomi = 15 .
     3877                                       else temp-for-pomi = 20 .
     3878       end.
     3879       assign
     3880         Tr = tt-rvs-line.state-temperature
     3881         Tv = if tt-rvs-line.temp-izm-vol <> ? then tt-rvs-line.temp-izm-vol else tt-rvs-line.state-temperature
     3882         R = ( tt-rvs-line.izmer-density * 1000 )
     3883       .
     3884       for first rvs-line-attr no-lock where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     3885                                         and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     3886                                         and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     3887                                         and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     3888                                         and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     3889                                         and rvs-line-attr.attr-code = "Tr"
     3890                                         :
     3891         assign Tr = decimal(rvs-line-attr.attr-value) .
     3892       end .
     3893       for first rvs-line-attr no-lock where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     3894                                         and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     3895                                         and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     3896                                         and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     3897                                         and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     3898                                         and rvs-line-attr.attr-code = "Tv"
     3899                                         :
     3900         assign Tv = decimal(rvs-line-attr.attr-value) .
     3901       end .
     3902       for first rvs-line-attr no-lock where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     3903                                         and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     3904                                         and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     3905                                         and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     3906                                         and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     3907                                         and rvs-line-attr.attr-code = "R"
     3908                                         :
     3909         assign R = decimal(rvs-line-attr.attr-value) * 1000 .
     3910       end .
     3911       find first buf_place no-lock
     3912            where buf_place.obj-code = tt-rvs-line.obj-code
     3913              and buf_place.obj-type = tt-rvs-line.obj-type
     3914              and buf_place.pl-code  = tt-rvs-line.pl-code no-error.
     3915       if place-type = 1 then do :
     3916         v-proc = "CMethodOfMetering13" .
     3917         MM13
     3918           (input 0.0,
     3919            input 0.0,
     3920            input 0.0,
     3921            input 0.0,
     3922            input tt-rvs-line.state-level-total * 10,
     3923            input (if tt-rvs-line.state-level-water <> ? then tt-rvs-line.state-level-water * 10 else 0.0),
     3924            input CalibTable,
     3925            input CalibBelt,
     3926            input 0.0,
     3927            input 0.0,
     3928            input Tv,
     3929            input Tr,
     3930            input R,
     3931            input temp-for-pomi,
     3932            input ToolType,
     3933            input DeltaOtn_K,
     3934            input DeadZone_Reservoir,
     3935            input A_Reservoir,
     3936            input A_LevelMeasurementTool,
     3937            input ToolAutomationLevel_H,
     3938            input ToolAutomationLevel_H_Water,
     3939            input ToolAutomationLevel_R,
     3940            input ToolAutomationLevel_Tv,
     3941            input ToolAutomationLevel_Tr,
     3942            input DeltaAbs_H_CalcType,
     3943            input DeltaAbs_H_Water_CalcType,
     3944            input DeltaAbs_H,
     3945            input DeltaAbs_H_Water,
     3946            input DeltaAbs_R,
     3947            input DeltaAbs_Tv,
     3948            input DeltaAbs_Tr,
     3949            input DeltaOtn_N,
     3950            input 1,
     3951            input 2,
     3952            input 2,
     3953            output V_total,
     3954            output V_water,
     3955            output DeltaV,
     3956            output V_product,
     3957            output Vcy,
     3958            output Rcy,
     3959            output V,
     3960            output CTL_base_alt,
     3961            output CPL_base_alt,
     3962            output CTPL_base_alt,
     3963            output Fp_base_alt,
     3964            output CTL_obs_base,
     3965            output CPL_obs_base,
     3966            output CTPL_obs_base,
     3967            output Fp_obs_base,
     3968            output Rv,
     3969            output DeltaOtn_Vcy,
     3970            output DeltaOtn_Vm,
     3971            output M,
     3972            output DeltaOtn_M,
     3973            output VolumetricExpansion,
     3974            output vErr,
     3975            output vWrn,
     3976            output vDllVersion)
     3977         no-error .
     3978       end.
     3979       else do :
     3980         v-proc = "CMethodOfMetering6" .
     3981         MM6
     3982           (input tt-rvs-line.state-level-total * 10,
     3983            input (if tt-rvs-line.state-level-water <> ? then tt-rvs-line.state-level-water * 10 else 0.0),
     3984            input CalibTable,
     3985            input CalibBelt,
     3986            input 0.0,
     3987            input Tv,
     3988            input Tr,
     3989            input R,
     3990            input temp-for-pomi,
     3991            input ToolType,
     3992            input DeltaOtn_K,
     3993            input DeadZone_Reservoir,
     3994            input A_Reservoir,
     3995            input A_LevelMeasurementTool,
     3996            input ToolAutomationLevel_H,
     3997            input ToolAutomationLevel_H_Water,
     3998            input ToolAutomationLevel_R,
     3999            input ToolAutomationLevel_Tv,
     4000            input ToolAutomationLevel_Tr,
     4001            input DeltaAbs_H_CalcType,
     4002            input DeltaAbs_H_Water_CalcType,
     4003            input DeltaAbs_H,
     4004            input DeltaAbs_H_Water,
     4005            input DeltaAbs_R,
     4006            input DeltaAbs_Tv,
     4007            input DeltaAbs_Tr,
     4008            input DeltaOtn_N,
     4009            input 1,
     4010            input 2,
     4011            input 2,
     4012            output V_total,
     4013            output V_water,
     4014            output DeltaV,
     4015            output V_product,
     4016            output Vcy,
     4017            output Rcy,
     4018            output V,
     4019            output CTL_base_alt,
     4020            output CPL_base_alt,
     4021            output CTPL_base_alt,
     4022            output Fp_base_alt,
     4023            output CTL_obs_base,
     4024            output CPL_obs_base,
     4025            output CTPL_obs_base,
     4026            output Fp_obs_base,
     4027            output Rv,
     4028            output DeltaOtn_Vcy,
     4029            output DeltaOtn_Vm,
     4030            output M,
     4031            output DeltaOtn_M,
     4032            output VolumetricExpansion,
     4033            output vErr,
     4034            output vWrn,
     4035            output vDllVersion)
     4036         no-error .
     4037       end.
     4038       OUTPUT stream outstream to value ("pomi.log") append.
     4039       PUT STREAM outstream unformatted
     4040         "    " SKIP
     4041         "    " SKIP
     4042         cur-time-string()           FORMAT "x(16)"    SKIP
     4043         'Процедура   "'              v-proc       '"'               FORMAT "x(128)"   SKIP
     4044         'Версия dll: '              vDllVersion                           SKIP
     4045         'CODE_PL                     = ' tt-rvs-line.pl-code                      SKIP
     4046         'H                           = ' tt-rvs-line.state-level-total * 10 SKIP
     4047         'H_water                     = ' (if tt-rvs-line.state-level-water <> ? then tt-rvs-line.state-level-water * 10 else 0.0) SKIP
     4048         'CalibrationTable            = ' CalibTable                    SKIP
     4049         'CalibrationBelt             = ' CalibBelt                    SKIP
     4050         'ToolAutomationLevel_H       = ' ToolAutomationLevel_H     SKIP
     4051         'ToolAutomationLevel_H_Water = ' ToolAutomationLevel_H_Water    SKIP
     4052         'ToolAutomationLevel_R       = ' ToolAutomationLevel_R     SKIP
     4053         'ToolAutomationLevel_Tv      = ' ToolAutomationLevel_Tv    SKIP
     4054         'ToolAutomationLevel_Tr      = ' ToolAutomationLevel_Tr    SKIP
     4055         'DeltaAbs_H_CalcType         = ' DeltaAbs_H_CalcType       SKIP
     4056         'DeltaAbs_H_Water_CalcType   = ' DeltaAbs_H_Water_CalcType SKIP
     4057         'Tv                          = ' round(Tv, 2)              SKIP
     4058         'Tr                          = ' round(Tr, 2)              SKIP
     4059         'R                           = ' round(R, 2)               SKIP
     4060         'Tcy                         = ' temp-for-pomi                       SKIP
     4061         'ToolType                    = ' ToolType                            SKIP
     4062         'DeadZone_Reservoir          = ' DeadZone_Reservoir                  SKIP
     4063         'DeltaOtn_K                  = ' DeltaOtn_K                          SKIP
     4064         'A_Reservoir                 = ' A_Reservoir                         SKIP
     4065         'A_LevelMeasurementTool      = ' A_LevelMeasurementTool              skip
     4066         'DeltaAbs_H                  = ' DeltaAbs_H                          SKIP
     4067         'DeltaAbs_H_Water            = ' DeltaAbs_H_Water                    SKIP
     4068         'DeltaAbs_R                  = ' DeltaAbs_R                          SKIP
     4069         'DeltaAbs_Tv                 = ' DeltaAbs_Tv                         SKIP
     4070         'DeltaAbs_Tr                 = ' DeltaAbs_Tr                         SKIP
     4071         'DeltaOtn_N                  = ' DeltaOtn_N                          SKIP
     4072         'Round_M                     = ' 1                                   SKIP
     4073         'Round_T                     = ' 2                                   SKIP
     4074         'Round_R                     = ' 2                                   SKIP
     4075       .
     4076       if place-type = 1
     4077       and place-ponton
     4078       then do :
     4079         put stream outstream unformatted
     4080           "Rprov                  = " 0.0 skip
     4081           "Mpokr                  = " 0.0 skip
     4082           "Vdisp                  = " 0.0 skip
     4083           "CoverFloatingHeight    = " 0.0 skip
     4084         .
     4085       end.
     4086       output stream outstream close.
     4087       if trim(vErr) > "" then do :
     4088         error-string = substitute("~nРезервуар: &1.~n", if avail buf2_place then buf2_place.loc1 else "")
     4089                      + replace(vErr,";0x","~n0x") .
     4090         output stream outstream to value ("pomi.log")  append.
     4091         put stream outstream error-string format "X(1024)" skip.
     4092         message
     4093         substitute('Ошибка работы библиотеки ПОкМИ. &1',error-string)
     4094         view-as alert-box error.
     4095         output stream outstream close.
     4096         undo _trpomi, return no-apply .
     4097       end.
     4098       else do :
     4099         v-mm-density = Rv / 1000 .
     4100         varstate-water-qnty = V_water * 1000 .
     4101         assign
     4102           tt-rvs-line.state-measure-qnty     = V * 1000
     4103           tt-rvs-line.state-measure-cli-qnty = M
     4104           tt-rvs-line.state-brutto-qnty      = tt-rvs-line.state-measure-qnty + varstate-water-qnty
     4105           tt-rvs-line.state-density          = v-mm-density
     4106         .
     4107         assign
     4108           tt-rvs-line.fact-calc-add-mass = tt-rvs-line.state-add-qnty * tt-rvs-line.state-density
     4109           tt-rvs-line.fact-sum-vol = tt-rvs-line.state-measure-qnty + tt-rvs-line.state-add-qnty
     4110           tt-rvs-line.fact-sum-mass = tt-rvs-line.fact-calc-add-mass + tt-rvs-line.state-measure-cli-qnty
     4111           varstate-sum-vol = varstate-water-qnty + tt-rvs-line.state-measure-qnty
     4112         .
     4113         abs-delta-mass-add-qnty = tt-rvs-line.fact-calc-add-mass * pl-error-mass / 100 .
     4114         tt-rvs-line.state-brutto-cli-qnty  = tt-rvs-line.state-brutto-qnty * tt-rvs-line.state-density .
     4115         if  tt-rvs-line.state-measure-cli-qnty > 200000 then delta-mass-qnty = 0.5 . else delta-mass-qnty = 0.65.
     4116         abs-delta-mass-qnty = tt-rvs-line.state-measure-cli-qnty * delta-mass-qnty / 100 .
     4117         display
     4118           delta-mass-qnty
     4119           tt-rvs-line.state-density
     4120           tt-rvs-line.state-measure-cli-qnty
     4121           tt-rvs-line.state-measure-qnty
     4122           tt-rvs-line.fact-sum-vol
     4123           tt-rvs-line.fact-sum-mass
     4124           tt-rvs-line.fact-calc-add-mass
     4125           abs-delta-mass-add-qnty
     4126           abs-delta-mass-qnty
     4127           varstate-sum-vol
     4128           varstate-water-qnty
     4129         with frame Dialog-Frame .
     4130         find first rvs-line-attr exclusive-lock
     4131               where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4132                 and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4133                 and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4134                 and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4135                 and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4136                 and rvs-line-attr.attr-code = "pokmi-water-qnty" no-error.
     4137         if available rvs-line-attr then do :
     4138           rvs-line-attr.attr-value = string(V_water * 1000) .
     4139         end.
     4140         else do :
     4141           create rvs-line-attr.
     4142             assign
     4143                 rvs-line-attr.obj-code   = tt-rvs-line.obj-code
     4144                 rvs-line-attr.obj-type   = tt-rvs-line.obj-type
     4145                 rvs-line-attr.gds-code   = tt-rvs-line.gds-code
     4146                 rvs-line-attr.pl-code    = tt-rvs-line.pl-code
     4147                 rvs-line-attr.rvs-code   = tt-rvs-line.rvs-code
     4148                 rvs-line-attr.attr-code  = "pokmi-water-qnty"
     4149                 rvs-line-attr.attr-value = string(V_water * 1000)
     4150             .
     4151         END.
     4152         assign
     4153           v-POkMI-result =
     4154             "V_total             = " + string(V_total)       + chr(10) +
     4155             "V_water             = " + string(V_water)       + chr(10) +
     4156             "DeltaV              = " + string(DeltaV)         + chr(10) +
     4157             "Vcy                 = " + string(Vcy)           + chr(10) +
     4158             "Rcy                 = " + string(Rcy)            + chr(10) +
     4159             "V_product           = " + string(V_product)      + chr(10) +
     4160             "V                   = " + string(V)              + chr(10) +
     4161             "Rv                  = " + string(Rv)               + chr(10) +
     4162             "M                   = " + string(M)                 + chr(10) +
     4163             "CTL_base_alt        = " + string(CTL_base_alt)  + chr(10) +
     4164             "CPL_base_alt        = " + string(CPL_base_alt)  + chr(10) +
     4165             "CTPL_base_alt       = " + string(CTPL_base_alt)  + chr(10) +
     4166             "Fp_base_alt         = " + string(Fp_base_alt)   + chr(10) +
     4167             "CTL_obs_base        = " + string(CTL_obs_base)  + chr(10) +
     4168             "CPL_obs_base        = " + string(CPL_obs_base)  + chr(10) +
     4169             "CTPL_obs_base       = " + string(CTPL_obs_base)  + chr(10) +
     4170             "Fp_obs_base         = " + string(Fp_obs_base)   + chr(10) +
     4171             "DeltaOtn_Vcy        = " + string(DeltaOtn_Vcy)  + chr(10) +
     4172             "DeltaOtn_Vm         = " + string(DeltaOtn_Vm)   + chr(10) +
     4173             "DeltaOtn_M          = " + string(DeltaOtn_M)       + chr(10) +
     4174             "VolumetricExpansion = " + string(VolumetricExpansion) + chr(10) +
     4175             "Warnings            = " + vWrn
     4176         .
     4177         OUTPUT stream outstream to value ("pomi.log")  append.
     4178         PUT STREAM outstream unformatted v-POkMI-result skip .
     4179         OUTPUT stream outstream close.
     4180         assign
     4181           v-POkMI-result-attr =
     4182             "Масса НП, кг: " + string(M, "->>,>>>,>>9.9":U) + chr(10) +
     4183             "Относительная погрешность измерения массы нефтепродукта, %: "  + string(DeltaOtn_M, "->>,>>9.99":U) + chr(10) +
     4184             "Плотность, приведенная к стандартным условиям, г/см3: " + string((Rcy / 1000), "9.9999":U) + chr(10) +
     4185             "Объем, приведенный к стандартным условиям, л: " + string((Vcy * 1000), "->>,>>>,>>9":U) + chr(10) +
     4186             "Объем НП при температуре его измерения, л: " + string((V * 1000), "->>,>>>,>>9":U) + chr(10) +
     4187             "Объем воды, л: " + string((V_water * 1000), "->>,>>>,>>9":U)
     4188           v-POkMI-warnings = vWrn
     4189         .
     4190         find first rvs-line-attr exclusive-lock
     4191               where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4192                 and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4193                 and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4194                 and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4195                 and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4196                 and rvs-line-attr.attr-code = "POkMI-result" no-error.
     4197         if available rvs-line-attr then do :
     4198           rvs-line-attr.attr-value = v-POkMI-result-attr .
     4199         end.
     4200         else do :
     4201           create rvs-line-attr.
     4202           assign
     4203             rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4204             rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4205             rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4206             rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4207             rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4208             rvs-line-attr.attr-code = "POkMI-result"
     4209             rvs-line-attr.attr-value = v-POkMI-result-attr
     4210           .
     4211         end.
     4212         find first rvs-line-attr exclusive-lock
     4213               where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4214                 and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4215                 and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4216                 and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4217                 and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4218                 and rvs-line-attr.attr-code = "POkMI-warnings" no-error.
     4219         if available rvs-line-attr then do :
     4220           rvs-line-attr.attr-value = v-POkMI-warnings .
     4221         end.
     4222         else do :
     4223           create rvs-line-attr.
     4224           assign
     4225             rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4226             rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4227             rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4228             rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4229             rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4230             rvs-line-attr.attr-code = "POkMI-warnings"
     4231             rvs-line-attr.attr-value = v-POkMI-warnings
     4232           .
     4233         end.
     4234         enable
     4235           b-POkMI-result
     4236         with frame Dialog-Frame.
     4237         run volume-water no-error.
     4238         if error-status :error then do :
     4239                                  undo _trpomi, return .
     4240                                end.
     4241         run chg-density no-error.
     4242         if error-status :error then do :
     4243                                  undo _trpomi, return .
     4244                                end.
     4245         run weath-water no-error.
     4246         if error-status:error then do :
     4247                                 undo _trpomi, return .
     4248                               end.
     4249       end.
     4250     end.
     4251     find first rvs-line-attr exclusive-lock
     4252          where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4253            and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4254            and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4255            and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4256            and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4257            and rvs-line-attr.attr-code = "is-calc" no-error.
     4258     if not available rvs-line-attr then do :
     4259       create rvs-line-attr.
     4260       assign
     4261         rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4262         rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4263         rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4264         rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4265         rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4266         rvs-line-attr.attr-code = "is-calc"
     4267       .
     4268     end.
     4269     assign rvs-line-attr.attr-value = "yes" .
     4270     release rvs-line-attr no-error .
     4271   END.
     4272   ON CHOOSE OF b-temperature IN FRAME Dialog-Frame
     4273   DO:
     4274     define buffer temp_sr-izmerenia for sr-izmerenia .
     4275     define buffer dens_sr-izmerenia for sr-izmerenia .
     4276     define variable vOk as logical no-undo .
     4277     define variable v-out-temp as decimal no-undo .
     4278     define variable v-calc-type as integer no-undo init 1 .
     4279     define variable v-izm-temps as character no-undo .
     4280     define variable v-izm-temps-tab as character no-undo .
     4281     if pl-rvd-temp
     4282     or v-revision-mode
     4283     then do :
     4284       find first temp_sr-izmerenia no-lock where temp_sr-izmerenia.node-code = v-mi-tmp no-error.
     4285     end .
     4286     else do :
     4287       find first temp_sr-izmerenia no-lock where temp_sr-izmerenia.node-code = place-si no-error.
     4288     end .
     4289     if not available temp_sr-izmerenia
     4290     then do :
     4291       message "Для резервуара не задано основное средство измерения или средство измерения температуры!" view-as alert-box .
     4292       return no-apply .
     4293     end .
     4294     if not temp_sr-izmerenia.sr-temperature
     4295     then do :
     4296       message "Средство измерения " string(temp_sr-izmerenia.node-code) " не может измерять температуру!" view-as alert-box .
     4297       return no-apply .
     4298     end .
     4299     if temp_sr-izmerenia.sr-type-izm = 2
     4300     then do :
     4301       message "Средство измерения температуры " string(temp_sr-izmerenia.node-code) " является измерительной системой! Значение температуры определяется показателями СИ." view-as alert-box .
     4302       return no-apply .
     4303     end .
     4304     for first rvs-line-attr no-lock where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4305                                       and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4306                                       and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4307                                       and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4308                                       and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4309                                       and rvs-line-attr.attr-code = "temp-calc-type"
     4310                                       :
     4311       v-calc-type = integer(rvs-line-attr.attr-value) .
     4312     end .
     4313     run str/rvs-lin-temperature.w (input temp_sr-izmerenia.sr-type-izm,
     4314                                    input place-type,
     4315                                    input place-diameter,
     4316                                    input (if place-type = 1 then ((tt-rvs-line.state-level-total - tt-rvs-line.state-level-water) * 10) else (tt-rvs-line.state-level-total * 10)),
     4317                                    input-output v-calc-type,
     4318                                    output v-out-temp,
     4319                                    output vOk)
     4320                                    .
     4321     if vOk
     4322     then do :
     4323       tt-rvs-line.temp-izm-vol = v-out-temp .
     4324       find first rvs-line-attr exclusive-lock
     4325            where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4326              and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4327              and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4328              and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4329              and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4330              and rvs-line-attr.attr-code = "Tv" no-error.
     4331       if not available rvs-line-attr then do :
     4332         create rvs-line-attr.
     4333         assign
     4334           rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4335           rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4336           rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4337           rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4338           rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4339           rvs-line-attr.attr-code = "Tv"
     4340           rvs-line-attr.attr-value = string(v-out-temp)
     4341         .
     4342       end.
     4343       else do :
     4344         rvs-line-attr.attr-value = string(v-out-temp) .
     4345       end.
     4346       display tt-rvs-line.temp-izm-vol with frame Dialog-Frame .
     4347       assign v-hand-input-tmp = true .
     4348       find first rvs-line-attr exclusive-lock
     4349            where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4350              and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4351              and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4352              and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4353              and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4354              and rvs-line-attr.attr-code = "temp-calc-type" no-error.
     4355       if not available rvs-line-attr then do :
     4356         create rvs-line-attr.
     4357         assign
     4358           rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4359           rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4360           rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4361           rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4362           rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4363           rvs-line-attr.attr-code = "temp-calc-type"
     4364           rvs-line-attr.attr-value = string(v-calc-type)
     4365         .
     4366       end.
     4367       else do :
     4368         rvs-line-attr.attr-value = string(v-calc-type) .
     4369       end.
     4370       if pl-rvd-temp
     4371       and not pl-rvd-dens
     4372       then do :
     4373         tt-rvs-line.state-temperature = v-out-temp .
     4374         find first rvs-line-attr exclusive-lock
     4375              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4376                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4377                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4378                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4379                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4380                and rvs-line-attr.attr-code = "Tr" no-error.
     4381         if not available rvs-line-attr then do :
     4382           create rvs-line-attr.
     4383           assign
     4384             rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4385             rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4386             rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4387             rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4388             rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4389             rvs-line-attr.attr-code = "Tr"
     4390             rvs-line-attr.attr-value = string(v-out-temp)
     4391           .
     4392         end.
     4393         else do :
     4394           rvs-line-attr.attr-value = string(v-out-temp) .
     4395         end.
     4396         display tt-rvs-line.state-temperature with frame Dialog-Frame .
     4397       end .
     4398       if (pl-rvd-temp
     4399       and pl-rvd-dens)
     4400       or v-revision-mode
     4401       then do :
     4402         find first rvs-line-attr no-lock
     4403              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4404                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4405                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4406                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4407                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4408                and rvs-line-attr.attr-code = "state-temp-changed" no-error.
     4409         if available rvs-line-attr
     4410         and logical(rvs-line-attr.attr-value)
     4411         then do : end .
     4412         else do :
     4413           tt-rvs-line.state-temperature = v-out-temp .
     4414           find first rvs-line-attr exclusive-lock
     4415                where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4416                  and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4417                  and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4418                  and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4419                  and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4420                  and rvs-line-attr.attr-code = "Tr" no-error.
     4421           if not available rvs-line-attr then do :
     4422             create rvs-line-attr.
     4423             assign
     4424               rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4425               rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4426               rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4427               rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4428               rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4429               rvs-line-attr.attr-code = "Tr"
     4430               rvs-line-attr.attr-value = string(v-out-temp)
     4431             .
     4432           end.
     4433           else do :
     4434             rvs-line-attr.attr-value = string(v-out-temp) .
     4435           end.
     4436           display tt-rvs-line.state-temperature with frame Dialog-Frame .
     4437         end .
     4438       end .
     4439       find first rvs-line-attr exclusive-lock
     4440          where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4441            and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4442            and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4443            and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4444            and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4445            and rvs-line-attr.attr-code = "is-calc" no-error.
     4446       if available rvs-line-attr
     4447       then do :
     4448         rvs-line-attr.attr-value = string(no) .
     4449       end .
     4450       v-izm-temps-tab = string(temp_sr-izmerenia.sr-type-izm) + ";" .
     4451       if temp_sr-izmerenia.sr-type-izm = 0
     4452       then do :
     4453         for each tt-temps-tab no-lock by tt-temps-tab.ii descending :
     4454           v-izm-temps-tab = v-izm-temps-tab + string(tt-temps-tab.temperature) + "," .
     4455         end .
     4456       end .
     4457       else do :
     4458         for each tt-temps-tab no-lock by tt-temps-tab.ii :
     4459           v-izm-temps-tab = v-izm-temps-tab + string(tt-temps-tab.temperature) + "," .
     4460         end .
     4461       end .
     4462       v-izm-temps-tab = trim(v-izm-temps-tab, ",") .
     4463       find first rvs-line-attr exclusive-lock
     4464            where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4465              and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4466              and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4467              and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4468              and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4469              and rvs-line-attr.attr-code = "izm-temps-tab" no-error.
     4470       if not available rvs-line-attr then do :
     4471         create rvs-line-attr.
     4472         assign
     4473           rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4474           rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4475           rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4476           rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4477           rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4478           rvs-line-attr.attr-code = "izm-temps-tab"
     4479           rvs-line-attr.attr-value = v-izm-temps-tab
     4480         .
     4481       end.
     4482       else do :
     4483         rvs-line-attr.attr-value = v-izm-temps-tab .
     4484       end.
     4485       if pl-rvd-dens
     4486       or v-revision-mode
     4487       then do :
     4488         find first dens_sr-izmerenia no-lock where dens_sr-izmerenia.node-code = v-mi-dnst no-error.
     4489       end .
     4490       else do :
     4491         find first dens_sr-izmerenia no-lock where dens_sr-izmerenia.node-code = place-si no-error.
     4492       end .
     4493       if available dens_sr-izmerenia
     4494       and dens_sr-izmerenia.sr-type-izm = 0
     4495       then do :
     4496         v-izm-temps = string(dens_sr-izmerenia.sr-type-izm) + ";" .
     4497         for each tt-temps no-lock by tt-temps.ii descending :
     4498           v-izm-temps = v-izm-temps + string(tt-temps.temperature) + "," .
     4499         end .
     4500         v-izm-temps = trim(v-izm-temps, ",") .
     4501         find first rvs-line-attr exclusive-lock
     4502              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4503                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4504                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4505                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4506                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4507                and rvs-line-attr.attr-code = "izm-temps" no-error.
     4508         if not available rvs-line-attr then do :
     4509           create rvs-line-attr.
     4510           assign
     4511             rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4512             rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4513             rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4514             rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4515             rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4516             rvs-line-attr.attr-code = "izm-temps"
     4517             rvs-line-attr.attr-value = v-izm-temps
     4518           .
     4519         end.
     4520         else do :
     4521           rvs-line-attr.attr-value = v-izm-temps .
     4522         end.
     4523       end .
     4524     end .
     4525   END.
     4526   ON CHOOSE OF b-density IN FRAME Dialog-Frame
     4527   DO:
     4528     define buffer dens_sr-izmerenia for sr-izmerenia .
     4529     define variable vOk as logical no-undo .
     4530     define variable v-out-dens as decimal no-undo .
     4531     define variable v-out-temp as decimal no-undo .
     4532     define variable v-izm-temps as character no-undo .
     4533     define variable v-izm-denses as character no-undo .
     4534     define variable v-calc-type as integer no-undo init 1 .
     4535     if pl-rvd-dens
     4536     or v-revision-mode
     4537     then do :
     4538       find first dens_sr-izmerenia no-lock where dens_sr-izmerenia.node-code = v-mi-dnst no-error.
     4539     end .
     4540     else do :
     4541       find first dens_sr-izmerenia no-lock where dens_sr-izmerenia.node-code = place-si no-error.
     4542     end .
     4543     if not available dens_sr-izmerenia
     4544     then do :
     4545       message "Для резервуара не задано основное средство измерения или средство измерения плотности!" view-as alert-box .
     4546       return no-apply .
     4547     end .
     4548     if not dens_sr-izmerenia.sr-density
     4549     then do :
     4550       message "Средство измерения " string(dens_sr-izmerenia.node-code) " не может измерять плотность!" view-as alert-box .
     4551       return no-apply .
     4552     end .
     4553     if dens_sr-izmerenia.sr-type-izm = 2
     4554     then do :
     4555       message "Средство измерения плотности " string(dens_sr-izmerenia.node-code) " является измерительной системой! Значение плотности определяется показателями СИ." view-as alert-box .
     4556       return no-apply .
     4557     end .
     4558     if dens_sr-izmerenia.sr-type-izm = 0
     4559     then do :
     4560       for first rvs-line-attr no-lock where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4561                                         and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4562                                         and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4563                                         and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4564                                         and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4565                                         and rvs-line-attr.attr-code = "dens-calc-type"
     4566                                         :
     4567         v-calc-type = integer(rvs-line-attr.attr-value) .
     4568       end .
     4569       run str/rvs-lin-density.w (input dens_sr-izmerenia.sr-type-izm,
     4570                                  input place-type,
     4571                                  input place-diameter,
     4572                                  input (if place-type = 1 then ((tt-rvs-line.state-level-total - tt-rvs-line.state-level-water) * 10) else (tt-rvs-line.state-level-total * 10)),
     4573                                  input-output v-calc-type,
     4574                                  output v-out-dens,
     4575                                  output vOk)
     4576                                  .
     4577       if vOk
     4578       then do :
     4579         assign
     4580           tt-rvs-line.izmer-density = v-out-dens
     4581           tt-rvs-line.state-density = tt-rvs-line.izmer-density
     4582         .
     4583         find first rvs-line-attr exclusive-lock
     4584              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4585                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4586                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4587                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4588                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4589                and rvs-line-attr.attr-code = "R" no-error.
     4590         if not available rvs-line-attr then do :
     4591           create rvs-line-attr.
     4592           assign
     4593             rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4594             rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4595             rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4596             rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4597             rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4598             rvs-line-attr.attr-code = "R"
     4599             rvs-line-attr.attr-value = string(v-out-dens)
     4600           .
     4601         end.
     4602         else do :
     4603           rvs-line-attr.attr-value = string(v-out-dens) .
     4604         end.
     4605         display tt-rvs-line.izmer-density tt-rvs-line.state-density with frame Dialog-Frame .
     4606         assign v-hand-input-dnst = true .
     4607         find first rvs-line-attr exclusive-lock
     4608              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4609                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4610                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4611                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4612                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4613                and rvs-line-attr.attr-code = "dens-calc-type" no-error.
     4614         if not available rvs-line-attr then do :
     4615           create rvs-line-attr.
     4616           assign
     4617             rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4618             rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4619             rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4620             rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4621             rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4622             rvs-line-attr.attr-code = "dens-calc-type"
     4623             rvs-line-attr.attr-value = string(v-calc-type)
     4624           .
     4625         end.
     4626         else do :
     4627           rvs-line-attr.attr-value = string(v-calc-type) .
     4628         end.
     4629         find first rvs-line-attr exclusive-lock
     4630            where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4631              and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4632              and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4633              and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4634              and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4635              and rvs-line-attr.attr-code = "is-calc" no-error.
     4636         if available rvs-line-attr
     4637         then do :
     4638           rvs-line-attr.attr-value = string(no) .
     4639         end .
     4640         v-izm-denses = string(dens_sr-izmerenia.sr-type-izm) + ";" .
     4641         for each tt-dens no-lock by tt-dens.ii descending :
     4642           v-izm-denses = v-izm-denses + string(tt-dens.density) + "," .
     4643         end .
     4644         v-izm-denses = trim(v-izm-denses, ",") .
     4645         find first rvs-line-attr exclusive-lock
     4646              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4647                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4648                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4649                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4650                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4651                and rvs-line-attr.attr-code = "izm-denses" no-error.
     4652         if not available rvs-line-attr then do :
     4653           create rvs-line-attr.
     4654           assign
     4655             rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4656             rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4657             rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4658             rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4659             rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4660             rvs-line-attr.attr-code = "izm-denses"
     4661             rvs-line-attr.attr-value = v-izm-denses
     4662           .
     4663         end.
     4664         else do :
     4665           rvs-line-attr.attr-value = v-izm-denses .
     4666         end.
     4667       end .
     4668     end .
     4669     if dens_sr-izmerenia.sr-type-izm = 1
     4670     then do :
     4671       v-mi-tmp-dnst = v-mi-tmp .
     4672       for first rvs-line-attr no-lock where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4673                                         and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4674                                         and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4675                                         and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4676                                         and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4677                                         and rvs-line-attr.attr-code = "mi-tmp-dnst"
     4678                                         :
     4679         v-mi-tmp-dnst = integer(rvs-line-attr.attr-value) .
     4680       end .
     4681       if v-mi-tmp-dnst = ? then v-mi-tmp-dnst = 0 .
     4682       run str/rvs-lin-dens-temp.w (input parparentproc,
     4683                                    input dens_sr-izmerenia.sr-type-izm,
     4684                                    input place-type,
     4685                                    input place-diameter,
     4686                                    input tt-rvs-line.state-level-total * 10,
     4687                                    input-output v-mi-tmp-dnst,
     4688                                    output v-out-dens,
     4689                                    output v-out-temp,
     4690                                    output vOk)
     4691                                    .
     4692       if vOk
     4693       then do :
     4694         assign
     4695           tt-rvs-line.izmer-density = v-out-dens
     4696           tt-rvs-line.state-density = tt-rvs-line.izmer-density
     4697         .
     4698         find first rvs-line-attr exclusive-lock
     4699              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4700                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4701                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4702                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4703                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4704                and rvs-line-attr.attr-code = "R" no-error.
     4705         if not available rvs-line-attr then do :
     4706           create rvs-line-attr.
     4707           assign
     4708             rvs-line-attr.obj-code  = tt-rvs-line.obj-code
