     4857   ON CHOOSE OF b-save IN FRAME Dialog-Frame
     4858   DO:
     4859     define variable v-water     as decimal   no-undo .
     4860     define variable v-water-cli as decimal   no-undo .
     4861     define variable v-free-vol  as decimal   no-undo .
     4862     define variable v-vid-action        as integer no-undo .
     4863     define variable v-vid-param         as longchar no-undo .
     4864   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4865   if lookup(self :type
     4866            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     4867            ) = 0
