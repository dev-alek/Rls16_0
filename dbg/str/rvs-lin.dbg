     6469           undo, return error.
     6470        end.
     6471     end.
     6472     if buf_rvs-doc.rvs-type = 'контроль':U
     6473     and buf_rvs-doc.status_ = 'разрешен':U
     6474     then do :
     6475       find first rvs-line-attr no-lock
     6476             where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     6477               and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     6478               and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     6479               and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     6480               and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     6481               and rvs-line-attr.attr-code = "tank-cleaning" no-error.
     6482       if available rvs-line-attr
     6483       then do :
     6484         t-tank-cleaning = logical(rvs-line-attr.attr-value) .
     6485       end .
     6486       display
     6487         t-tank-cleaning
     6488         t-tank-cleaning-text1
     6489         t-tank-cleaning-text2
     6490       with frame Dialog-Frame .
     6491       if v-revision-mode
     6492       and tt-rvs-line.state-level-total > 0
     6493       and tt-rvs-line.state-level-total < 1
     6494       and parmode = 'ИЗМЕНЕНИЕ':U
     6495       then do :
     6496         enable t-tank-cleaning with frame Dialog-Frame .
     6497       end .
     6498     end .
     6499     else do :
     6500       hide
     6501         t-tank-cleaning
     6502         t-tank-cleaning-text1
     6503         t-tank-cleaning-text2
     6504       in frame Dialog-Frame .
     6505     end .
     6506     run placelib_get-attr  ( input "place-SI"
     6507                             ,input tt-rvs-line.obj-code
     6508                             ,input tt-rvs-line.obj-type
     6509                             ,input tt-rvs-line.pl-code
     6510                             ,output v-value
     6511                             ,output v-ok      ) no-error.
     6512     if v-ok
     6513     then place-si = integer(v-value) .
     6514     else place-si = ? .
     6515     run placelib_get-attr  ( input "place-SI-temp"
     6516                             ,input tt-rvs-line.obj-code
     6517                             ,input tt-rvs-line.obj-type
     6518                             ,input tt-rvs-line.pl-code
     6519                             ,output v-value
     6520                             ,output v-ok      ) no-error.
     6521     if v-ok
     6522     then pl-temp-sr-izm = integer(v-value) .
     6523     else pl-temp-sr-izm = ? .
     6524     run placelib_get-attr  ( input "place-SI-dens"
     6525                             ,input tt-rvs-line.obj-code
     6526                             ,input tt-rvs-line.obj-type
     6527                             ,input tt-rvs-line.pl-code
     6528                             ,output v-value
     6529                             ,output v-ok      ) no-error.
     6530     if v-ok
     6531     then pl-dens-sr-izm = integer(v-value) .
     6532     else pl-dens-sr-izm = ? .
     6533     run placelib_get-attr  ( input "place-SI-level"
     6534                             ,input tt-rvs-line.obj-code
     6535                             ,input tt-rvs-line.obj-type
     6536                             ,input tt-rvs-line.pl-code
     6537                             ,output v-value
     6538                             ,output v-ok      ) no-error.
     6539     if v-ok
     6540     then pl-level-sr-izm = integer(v-value) .
     6541     else pl-level-sr-izm = ? .
     6542     if parmode <> 'ИЗМЕНЕНИЕ':U then do:
     6543       disable b-save with frame Dialog-Frame.
     6544     end.
     6545     else do :
     6546       if pl-rvd-dens <> pl-rvd-temp
     6547       then do :
     6548         find first tmp_sr-izmerenia no-lock where tmp_sr-izmerenia.node-code = pl-temp-sr-izm no-error .
     6549         find first dnst_sr-izmerenia no-lock where dnst_sr-izmerenia.node-code = pl-dens-sr-izm no-error .
     6550         if (available tmp_sr-izmerenia and tmp_sr-izmerenia.sr-type-izm = 0 and tmp_sr-izmerenia.sr-density and tmp_sr-izmerenia.sr-temperature)
     6551         or (available dnst_sr-izmerenia and dnst_sr-izmerenia.sr-type-izm = 0 and dnst_sr-izmerenia.sr-density and dnst_sr-izmerenia.sr-temperature)
     6552         then do :
     6553           message "Бизнес-процессом не предусмотрено использование неравнозначных положений разрешения РВД по параметрам температура и плотность, "
     6554                   "если дополнительное автоматизированное СИ предназначено для измерения обоих параметров." skip
     6555                   "Подайте заявку в службу поддержки для приведения параметров в соответствие требованиям бизнес-процесса."
     6556           view-as alert-box .
     6557         end .
     6558       end .
     6559     end .
     6560     RUN gbl/conf-rd.p ("rdc-dnst", "", "", 0, "", "", "", NO, OUTPUT rdc-value, OUTPUT rdc-type) NO-ERROR.
     6561     run gbl/conf-rd.p ("tarir", "", "", 0, "", "", "", no, output tarir-value, output tarir-type) no-error.
     6562     run volume-measure-water in this-procedure                 no-error.
     6563     run weath-measure-water  in this-procedure                 no-error.
     6564     run level-measure-water  in this-procedure                 no-error.
     6565     run volume-water         in this-procedure                 no-error.
     6566     run weath-water          in this-procedure                 no-error.
     6567     run level-water          in this-procedure ( input no )  .
     6568     find first buf_goods no-lock
     6569       where buf_goods.gds-code = tt-rvs-line.gds-code
     6570       .
     6571     if buf_goods.unit-base = buf_goods.unit-cli then do:
     6572       assign
     6573         tt-rvs-line.density       = 1.0
     6574         tt-rvs-line.state-density = 1.0
     6575       .
     6576       disable
     6577         tt-rvs-line.density
     6578         tt-rvs-line.state-density
     6579         with frame Dialog-Frame.
     6580     end.
     6581     hide
     6582       tt-rvs-line.meas-am-qnty
     6583       tt-rvs-line.meas-cf-qnty
     6584       tt-rvs-line.meas-mh-qnty
     6585       tt-rvs-line.level-petrol
     6586       tt-rvs-line.state-level-petrol
     6587       tt-rvs-line.brutto-cli-qnty
     6588       tt-rvs-line.state-brutto-cli-qnty
     6589       tt-rvs-line.meas-cli-calc-qnty
     6590       varmeasure-water-cli-qnty
     6591       varstate-water-cli-qnty
     6592       tt-rvs-line.brutto-tc-qnty
     6593       tt-rvs-line.state-brutto-tc-qnty
     6594       tt-rvs-line.brutto-qnty
     6595       tt-rvs-line.state-brutto-qnty
     6596       tt-rvs-line.meas-calc-dens
     6597       tt-rvs-line.measure-tc-qnty
     6598       tt-rvs-line.state-measure-tc-qnty
     6599       tt-rvs-line.measure-qnty
     6600       tt-rvs-line.state-measure-qnty
     6601       tt-rvs-line.meas-calc-qnty
     6602     in frame Dialog-Frame.
     6603     if rdc-value <>  "pomi-rn" then do :
     6604       hide
     6605         tt-rvs-line.izmer-density
     6606         delta-mass-qnty
     6607         abs-delta-mass-qnty
     6608         b-calc
     6609       in frame Dialog-Frame.
     6610     end.
     6611     else  do :
     6612       view
     6613         tt-rvs-line.izmer-density
     6614       in frame Dialog-Frame.
     6615       enable
     6616         tt-rvs-line.izmer-density
     6617       with frame Dialog-Frame.
     6618       disable
     6619         tt-rvs-line.state-density
     6620         tt-rvs-line.state-measure-qnty
     6621         tt-rvs-line.state-add-qnty
     6622         tt-rvs-line.state-brutto-qnty
     6623         tt-rvs-line.state-brutto-cli-qnty
     6624       with frame Dialog-Frame.
     6625     end.
     6626     for each rvs-line-attr no-lock
     6627        where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     6628          and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     6629          and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     6630          and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     6631          and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     6632          :
     6633           case rvs-line-attr.attr-code :
     6634             when "meas-calc-qnty" then do :
     6635               tt-rvs-line.meas-calc-qnty = decimal(rvs-line-attr.attr-value) .
     6636             end.
     6637             when "meas-calc-dens" then do :
     6638               tt-rvs-line.meas-calc-dens = decimal(rvs-line-attr.attr-value) .
     6639             end.
     6640             when "meas-cli-calc-qnty" then do :
     6641               tt-rvs-line.meas-cli-calc-qnty = decimal(rvs-line-attr.attr-value) .
     6642             end.
     6643             when "izmer-density" then do :
     6644               tt-rvs-line.izmer-density = decimal(rvs-line-attr.attr-value) .
     6645             end.
     6646             when "temp-izm-vol" then do :
     6647               tt-rvs-line.temp-izm-vol = decimal(rvs-line-attr.attr-value) .
     6648             end.
     6649             when "delta-mass-qnty" then do :
     6650               delta-mass-qnty = decimal(rvs-line-attr.attr-value) .
     6651             end.
     6652             when "CriticalDif" then do :
     6653               CriticalDif = decimal(rvs-line-attr.attr-value) .
     6654             end.
     6655           end case.
     6656     end.
     6657     release rvs-line-attr no-error .
     6658     if rdc-value =  "pomi-rn" then do :
     6659       display
     6660         tt-rvs-line.izmer-density
     6661         delta-mass-qnty
     6662       with frame Dialog-Frame.
     6663     end.
     6664     display
     6665       CriticalDif
     6666     with frame Dialog-Frame.
     6667     find first rvs-line-attr no-lock
     6668           where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     6669             and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     6670             and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     6671             and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     6672             and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     6673             and rvs-line-attr.attr-code = "first-enter" no-error.
     6674     if available rvs-line-attr
     6675     then do :
     6676       v-first-enter = logical(rvs-line-attr.attr-value) .
     6677     end .
     6678     else do :
     6679       v-first-enter = yes .
     6680     end .
     6681     run placelib_get-attr  ( input "place-asi-sertif"
     6682                               ,input tt-rvs-line.obj-code
     6683                               ,input tt-rvs-line.obj-type
     6684                               ,input tt-rvs-line.pl-code
     6685                               ,output v-value
     6686                               ,output v-ok      ) no-error.
     6687     if not v-ok
     6688     then pl-asi-sertif = no.
     6689     else
     6690     if v-value > ""
     6691     then pl-asi-sertif = logical(v-value) .
     6692     else pl-asi-sertif = no.
     6693     run placelib_get-attr  ( input "place-diameter"
     6694                             ,input tt-rvs-line.obj-code
     6695                             ,input tt-rvs-line.obj-type
     6696                             ,input tt-rvs-line.pl-code
     6697                             ,output v-value
     6698                             ,output v-ok      ) no-error.
     6699     if v-ok
     6700     then place-diameter = decimal(v-value) .
     6701     else place-diameter = ? .
     6702     if rdc-value =  "pomi-rn"
     6703     then do :
     6704       define buffer dop_sr-izmerenia for sr-izmerenia .
     6705       find first rvs-line-attr no-lock
     6706             where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     6707               and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     6708               and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     6709               and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     6710               and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     6711               and rvs-line-attr.attr-code = "mi-lvl" no-error.
     6712       if available rvs-line-attr
     6713       then do :
     6714         v-mi-lvl = integer(rvs-line-attr.attr-value) .
     6715       end .
     6716       else do :
     6717         v-mi-lvl = pl-level-sr-izm .
     6718       end .
     6719       for first dop_sr-izmerenia no-lock where dop_sr-izmerenia.node-code = v-mi-lvl :
     6720         v-mi-lvl-name = dop_sr-izmerenia.sr-model .
     6721         display v-mi-lvl-name with frame Dialog-Frame.
     6722       end .
     6723       if parmode = 'ИЗМЕНЕНИЕ':U then enable v-mi-lvl-name with frame Dialog-Frame.
     6724       if v-mi-lvl = 0 then v-mi-lvl = ? .
     6725       find first rvs-line-attr no-lock
     6726             where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     6727               and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     6728               and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     6729               and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     6730               and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     6731               and rvs-line-attr.attr-code = "mi-dnst" no-error.
     6732       if available rvs-line-attr
     6733       then do :
     6734         v-mi-dnst = integer(rvs-line-attr.attr-value) .
     6735       end .
     6736       else do :
     6737         v-mi-dnst = pl-dens-sr-izm .
     6738       end .
     6739       for first dop_sr-izmerenia no-lock where dop_sr-izmerenia.node-code = v-mi-dnst :
     6740         v-mi-dnst-name = dop_sr-izmerenia.sr-model .
     6741         display v-mi-dnst-name with frame Dialog-Frame.
     6742       end .
     6743       if parmode = 'ИЗМЕНЕНИЕ':U then enable v-mi-dnst-name with frame Dialog-Frame.
     6744       if v-mi-dnst = 0 then v-mi-dnst = ? .
     6745       find first rvs-line-attr no-lock
     6746             where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     6747               and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     6748               and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     6749               and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     6750               and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     6751               and rvs-line-attr.attr-code = "mi-tmp" no-error.
     6752       if available rvs-line-attr
     6753       then do :
     6754         v-mi-tmp = integer(rvs-line-attr.attr-value) .
     6755       end .
     6756       else do :
     6757         v-mi-tmp = pl-temp-sr-izm .
     6758       end .
     6759       for first dop_sr-izmerenia no-lock where dop_sr-izmerenia.node-code = v-mi-tmp :
     6760         v-mi-tmp-name = dop_sr-izmerenia.sr-model .
     6761         display v-mi-tmp-name with frame Dialog-Frame.
     6762       end .
     6763       if parmode = 'ИЗМЕНЕНИЕ':U then enable v-mi-tmp-name with frame Dialog-Frame.
     6764       if v-mi-tmp = 0 then v-mi-tmp = ? .
     6765       for first rvs-line-attr no-lock where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     6766                                         and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     6767                                         and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     6768                                         and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     6769                                         and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     6770                                         and rvs-line-attr.attr-code = "mi-tmp-dnst"
     6771                                         :
     6772         v-mi-tmp-dnst = integer(rvs-line-attr.attr-value) .
     6773       end .
     6774       assign
     6775         v-dnst-mi-old = v-mi-dnst
     6776         v-tmp-mi-old  = v-mi-tmp
     6777         v-lvl-mi-old  = v-mi-lvl
     6778       .
     6779     end .
     6780     run placelib_get-attr  ( input "place-error-mass"
     6781                               ,input tt-rvs-line.obj-code
     6782                               ,input tt-rvs-line.obj-type
     6783                               ,input tt-rvs-line.pl-code
     6784                               ,output v-value
     6785                               ,output v-ok      ) no-error.
     6786     if not v-ok then pl-error-mass = ?.
     6787     else pl-error-mass = decimal(v-value) .
     6788     assign
     6789       tt-rvs-line.calc-add-mass = tt-rvs-line.add-qnty * input frame Dialog-Frame tt-rvs-line.density
     6790       tt-rvs-line.sum-vol = tt-rvs-line.measure-qnty + tt-rvs-line.add-qnty
     6791       tt-rvs-line.sum-mass = tt-rvs-line.calc-add-mass + tt-rvs-line.measure-cli-qnty
     6792       varsum-vol = tt-rvs-line.brutto-qnty
     6793       tt-rvs-line.fact-calc-add-mass = tt-rvs-line.state-add-qnty * input frame Dialog-Frame tt-rvs-line.state-density
     6794       tt-rvs-line.fact-sum-vol = tt-rvs-line.state-measure-qnty + tt-rvs-line.state-add-qnty
     6795       tt-rvs-line.fact-sum-mass = tt-rvs-line.fact-calc-add-mass + tt-rvs-line.state-measure-cli-qnty
     6796       varstate-sum-vol = tt-rvs-line.state-brutto-qnty
     6797     .
     6798     abs-delta-mass-add-qnty = tt-rvs-line.fact-calc-add-mass * pl-error-mass / 100 .
     6799     abs-delta-mass-qnty = tt-rvs-line.state-measure-cli-qnty * delta-mass-qnty / 100 .
     6800     display
     6801       tt-rvs-line.calc-add-mass
     6802       tt-rvs-line.measure-qnty
     6803       tt-rvs-line.sum-vol
     6804       tt-rvs-line.sum-mass
     6805       varsum-vol
     6806       tt-rvs-line.fact-calc-add-mass
     6807       tt-rvs-line.state-measure-qnty
     6808       tt-rvs-line.fact-sum-vol
     6809       tt-rvs-line.fact-sum-mass
     6810       varstate-sum-vol
     6811       abs-delta-mass-add-qnty
     6812       tt-rvs-line.temp-izm-vol
     6813     with frame Dialog-Frame.
     6814     if rdc-value = 'pomi-rn'
     6815     then do :
     6816       display
     6817         abs-delta-mass-qnty
     6818       with frame Dialog-Frame.
     6819     end.
     6820     else
     6821     if tt-rvs-line.density = ? and parmode = 'ИЗМЕНЕНИЕ':U and tarir-value <> "yes"
     6822     then do :
     6823       enable
     6824         tt-rvs-line.state-measure-qnty
     6825         varstate-water-qnty
     6826       with frame Dialog-Frame.
     6827     end.
     6828     if parmode <> 'ИЗМЕНЕНИЕ':U then do:
     6829       disable tt-rvs-line.izmer-density with frame Dialog-Frame.
     6830       disable tt-rvs-line.temp-izm-vol with frame Dialog-Frame.
     6831       disable b-calc b-temperature b-density with frame Dialog-Frame.
     6832       if rdc-value =  "pomi-rn"
     6833       then do :
     6834         hide
     6835           hide-text-dop-si
     6836         in frame Dialog-Frame.
     6837       end .
     6838       else do :
     6839         hide
     6840           v-mi-lvl b-mi-lvl v-mi-lvl-name
     6841           v-mi-dnst b-mi-dnst v-mi-dnst-name
     6842           v-mi-tmp b-mi-tmp v-mi-tmp-name
     6843         in frame Dialog-Frame.
     6844         display
     6845           hide-text-dop-si
     6846         with frame Dialog-Frame.
     6847       end .
     6848     end.
     6849     else do :
     6850       disable
     6851         tt-rvs-line.izmer-density
     6852         tt-rvs-line.state-temperature
     6853         tt-rvs-line.state-density
     6854       with frame Dialog-Frame.
     6855       if pl-rvd-dens and rdc-value = 'pomi-rn'
     6856       then do :
     6857         if v-first-enter
     6858         then do :
     6859           tt-rvs-line.izmer-density = 0 .
     6860           tt-rvs-line.state-density = 0 .
     6861           display tt-rvs-line.izmer-density tt-rvs-line.state-density with frame Dialog-Frame.
     6862         end .
     6863         if not v-revision-mode
     6864         and v-mi-dnst > 0
     6865         and tt-rvs-line.state-level-total > 0
     6866         then
     6867           enable b-density with frame Dialog-Frame.
     6868       end.
     6869       else do :
     6870         if tt-rvs-line.state-level-total = 0
     6871         or tt-rvs-line.state-level-total = ?
     6872         then
     6873           disable b-density with frame Dialog-Frame.
     6874       end.
     6875       if pl-rvd-dens and rdc-value <> 'pomi-rn'
     6876       and tt-rvs-line.state-level-total > 0
     6877       then do :
     6878         enable tt-rvs-line.state-density with frame Dialog-Frame.
     6879       end.
     6880       else do :
     6881         disable tt-rvs-line.state-density with frame Dialog-Frame.
     6882       end.
     6883       if pl-rvd-lvl
     6884       then do :
     6885         if rdc-value =  "pomi-rn"
     6886         then do :
     6887           if v-first-enter
     6888           then do :
     6889             tt-rvs-line.state-level-total = 0 .
     6890             tt-rvs-line.state-level-water = 0 .
     6891             display tt-rvs-line.state-level-total tt-rvs-line.state-level-water with frame Dialog-Frame.
     6892           end .
     6893           if not v-revision-mode
     6894           and v-mi-lvl > 0
     6895           then
     6896             enable tt-rvs-line.state-level-total tt-rvs-line.state-level-water with frame Dialog-Frame.
     6897         end .
     6898         else do :
     6899           enable tt-rvs-line.state-level-total tt-rvs-line.state-level-water with frame Dialog-Frame.
     6900         end .
     6901       end.
     6902       else do :
     6903         disable tt-rvs-line.state-level-total tt-rvs-line.state-level-water with frame Dialog-Frame.
     6904       end.
     6905       if (pl-rvd-temp or tt-rvs-line.density = ?)
     6906       then do :
     6907         if rdc-value =  "pomi-rn"
     6908         then do :
     6909           if v-first-enter
     6910           then do :
     6911             tt-rvs-line.temp-izm-vol = ? .
     6912             tt-rvs-line.state-temperature = ? .
     6913             display tt-rvs-line.temp-izm-vol tt-rvs-line.state-temperature with frame Dialog-Frame.
     6914           end .
     6915           if not v-revision-mode
     6916           and v-mi-tmp > 0
     6917           and tt-rvs-line.state-level-total > 0
     6918           then
     6919             enable b-temperature with frame Dialog-Frame.
     6920         end .
     6921       end.
     6922       else do :
     6923         if tt-rvs-line.state-level-total = 0
     6924         or tt-rvs-line.state-level-total = ?
     6925         then
     6926           disable b-temperature with frame Dialog-Frame.
     6927       end.
     6928       if rdc-value =  "pomi-rn"
     6929       then do :
     6930         enable
     6931           v-mi-lvl b-mi-lvl v-mi-lvl-name
     6932           v-mi-dnst b-mi-dnst v-mi-dnst-name
     6933           v-mi-tmp b-mi-tmp v-mi-tmp-name
     6934         with frame Dialog-Frame.
     6935         hide
     6936           hide-text-dop-si
     6937         in frame Dialog-Frame.
     6938         tt-rvs-line.izmer-density:fgcolor = RED_COLOR .
     6939         tt-rvs-line.state-level-total:fgcolor = RED_COLOR .
     6940         tt-rvs-line.state-level-water:fgcolor = RED_COLOR .
     6941         tt-rvs-line.state-temperature:fgcolor = RED_COLOR .
     6942         tt-rvs-line.temp-izm-vol:fgcolor = RED_COLOR .
     6943       end .
     6944       else do :
     6945         hide
     6946           v-mi-lvl b-mi-lvl v-mi-lvl-name
     6947           v-mi-dnst b-mi-dnst v-mi-dnst-name
     6948           v-mi-tmp b-mi-tmp v-mi-tmp-name
     6949         in frame Dialog-Frame.
     6950         display
     6951           hide-text-dop-si
     6952         with frame Dialog-Frame.
     6953       end .
     6954     end.
     6955     if v-revision-mode
     6956     and v-first-enter
     6957     and rdc-value =  "pomi-rn"
     6958     then do :
     6959       assign
     6960         tt-rvs-line.state-level-total = 0
     6961         tt-rvs-line.state-level-water = 0
     6962         tt-rvs-line.temp-izm-vol = ?
     6963         tt-rvs-line.izmer-density = 0
     6964         tt-rvs-line.state-density = 0
     6965         tt-rvs-line.state-temperature = ?
     6966       .
     6967       display
     6968         tt-rvs-line.state-level-total
     6969         tt-rvs-line.state-level-water
     6970         tt-rvs-line.temp-izm-vol
     6971         tt-rvs-line.izmer-density
     6972         tt-rvs-line.state-density
     6973         tt-rvs-line.state-temperature
     6974       with frame Dialog-Frame.
     6975       disable
     6976         b-density
     6977         b-temperature
     6978         tt-rvs-line.state-density
     6979       with frame Dialog-Frame.
     6980     end .
     6981     if rdc-value =  "pomi-rn"
     6982     and parmode = 'ИЗМЕНЕНИЕ':U
     6983     then do :
     6984       if v-revision-mode
     6985       then do :
     6986         if v-mi-lvl > 0
     6987         and v-mi-dnst > 0
     6988         and v-mi-tmp > 0
     6989         then do :
     6990           enable
     6991             tt-rvs-line.state-level-total
     6992             tt-rvs-line.state-level-water
     6993           with frame Dialog-Frame.
     6994         end .
     6995         else do :
     6996           disable
     6997             tt-rvs-line.state-level-total
     6998             tt-rvs-line.state-level-water
     6999           with frame Dialog-Frame.
     7000         end .
     7001       end .
     7002       else do :
     7003         if not pl-rvd-temp
     7004         then do :
     7005           disable v-mi-tmp b-mi-tmp v-mi-tmp-name with frame Dialog-Frame.
     7006         end .
     7007         if not pl-rvd-dens
     7008         then do :
     7009           disable v-mi-dnst b-mi-dnst v-mi-dnst-name with frame Dialog-Frame.
     7010         end .
     7011         if not pl-rvd-lvl
     7012         then do :
     7013           disable v-mi-lvl b-mi-lvl v-mi-lvl-name with frame Dialog-Frame.
     7014         end .
     7015         if (pl-rvd-lvl and v-mi-lvl > 0)
     7016         then do :
     7017           enable
     7018             tt-rvs-line.state-level-total
     7019             tt-rvs-line.state-level-water
     7020           with frame Dialog-Frame.
     7021         end .
     7022         else do :
     7023           disable
     7024             tt-rvs-line.state-level-total
     7025             tt-rvs-line.state-level-water
     7026           with frame Dialog-Frame.
     7027         end .
     7028       end .
     7029     end .
     7030     if parmode = 'ИЗМЕНЕНИЕ':U
     7031     and rdc-value =  "pomi-rn"
     7032     then do :
     7033       if not b-density:sensitive
     7034       and (tt-rvs-line.izmer-density = 0 or tt-rvs-line.izmer-density = ?)
     7035       then do :
     7036         tt-rvs-line.izmer-density = tt-rvs-line.state-density .
     7037         display tt-rvs-line.izmer-density with frame Dialog-Frame .
     7038       end .
     7039       apply "leave" to tt-rvs-line.state-level-total in frame Dialog-Frame .
     7040       if pl-rvd-dens
     7041       and pl-rvd-temp
     7042       and v-mi-dnst > 0
     7043       and v-mi-tmp > 0
     7044       then do :
     7045         find first dnst_sr-izmerenia no-lock where dnst_sr-izmerenia.node-code = v-mi-dnst no-error .
     7046         find first tmp_sr-izmerenia no-lock where tmp_sr-izmerenia.node-code = v-mi-tmp no-error .
     7047         if available dnst_sr-izmerenia
     7048         and available tmp_sr-izmerenia
     7049         and dnst_sr-izmerenia.node-code <> tmp_sr-izmerenia.node-code
     7050         and ((dnst_sr-izmerenia.sr-density and dnst_sr-izmerenia.sr-temperature)
     7051           or (tmp_sr-izmerenia.sr-density and tmp_sr-izmerenia.sr-temperature))
     7052         then do :
     7053           message "Бизнес-процессом не предусмотрено использование разных дополнительных СИ по параметрам температура и плотность, при условии, что одно из установленных дополнительных СИ, предназначено для измерения обоих параметров." skip
     7054                   "Установите для температуры и плотности соответствующие требованиям дополнительные СИ."
     7055           view-as alert-box .
     7056           disable b-temperature with frame Dialog-Frame .
     7057           disable b-density with frame Dialog-Frame .
     7058         end .
     7059       end .
     7060     end .
     7061     find first rvs-line-attr no-lock
     7062           where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     7063             and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     7064             and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     7065             and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     7066             and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     7067             and rvs-line-attr.attr-code = "POkMI-result" no-error.
     7068     if available rvs-line-attr then do :
     7069       v-POkMI-result-attr = rvs-line-attr.attr-value .
     7070       enable
     7071         b-POkMI-result
     7072       with frame Dialog-Frame.
     7073     end.
     7074     else do :
     7075       disable
     7076         b-POkMI-result
     7077       with frame Dialog-Frame.
     7078     end.
     7079     for first rvs-line-attr no-lock
     7080           where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     7081             and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     7082             and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     7083             and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     7084             and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     7085             and rvs-line-attr.attr-code = "POkMI-warnings"
     7086     :
     7087       v-POkMI-warnings = rvs-line-attr.attr-value .
     7088     end .
     7089     if rdc-value <> 'pomi-rn'
     7090     then do :
     7091       hide
     7092         b-temperature
     7093         b-density
     7094         tt-rvs-line.temp-izm-vol
     7095         b-POkMI-result
     7096       in frame Dialog-Frame.
     7097       if parmode = 'ИЗМЕНЕНИЕ':U
     7098       then do :
     7099         enable
     7100           tt-rvs-line.state-density
     7101           tt-rvs-line.state-temperature
     7102           tt-rvs-line.state-measure-cli-qnty
     7103           tt-rvs-line.state-level-total
     7104           tt-rvs-line.state-level-water
     7105           tt-rvs-line.state-measure-qnty
     7106         with frame Dialog-Frame.
     7107       end .
     7108     end .
     7109     define variable sr-type-temp as integer no-undo .
     7110     define variable sr-type-temp-tab as integer no-undo .
     7111     define variable sr-type-dens as integer no-undo .
     7112     define variable v-izm-temps-attr as character no-undo .
     7113     define variable v-izm-temps-tab-attr as character no-undo .
     7114     define variable v-izm-denses-attr as character no-undo .
     7115     define variable it as integer no-undo .
     7116     define variable id as integer no-undo .
     7117     define variable ikey as integer no-undo .
     7118     find first rvs-line-attr no-lock
     7119              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     7120                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     7121                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     7122                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     7123                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     7124                and rvs-line-attr.attr-code = "izm-temps-tab" no-error.
     7125     if available rvs-line-attr then do :
     7126       sr-type-temp-tab = integer(entry(1, rvs-line-attr.attr-value, ";")) no-error .
     7127       v-izm-temps-tab-attr = entry(2, rvs-line-attr.attr-value, ";") no-error .
     7128     end .
     7129     case sr-type-temp-tab :
     7130       when 0
     7131       then do :
     7132         ikey = num-entries(v-izm-temps-tab-attr) .
     7133         do it = 1 to num-entries(v-izm-temps-tab-attr) :
     7134           find first tt-temps-tab no-lock where tt-temps-tab.ii = ikey no-error .
     7135           if not available tt-temps-tab
     7136           then do :
     7137             create tt-temps-tab .
     7138             assign
     7139               tt-temps-tab.ii = ikey
     7140               tt-temps-tab.key_ = "t" + string(ikey)
     7141               tt-temps-tab.temperature = decimal(entry(it, v-izm-temps-tab-attr))
     7142             .
     7143           end .
     7144           ikey = ikey - 1 .
     7145         end .
     7146       end .
     7147       when 1
     7148       then do :
     7149         do it = 1 to num-entries(v-izm-temps-tab-attr) :
     7150           find first tt-temps-tab no-lock where tt-temps-tab.ii = it no-error .
     7151           if not available tt-temps-tab
     7152           then do :
     7153             if place-type = 1
     7154             and it = 3
     7155             then do :
     7156               tt-temps-tab.key_ = "tср" no-error .
     7157             end .
     7158             create tt-temps-tab .
     7159             assign
     7160               tt-temps-tab.ii = it
     7161               tt-temps-tab.temperature = decimal(entry(it, v-izm-temps-tab-attr))
     7162             .
     7163             case it :
     7164               when 1 then tt-temps-tab.key_ = "tн" .
     7165               when 2 then tt-temps-tab.key_ = "tср" .
     7166               when 3 then tt-temps-tab.key_ = "tв" .
     7167             end case .
     7168             if place-type = 1
     7169             and it = 2
     7170             then do :
     7171               tt-temps-tab.key_ = "tв" no-error .
     7172             end .
     7173           end .
     7174         end .
     7175       end .
     7176     end case .
     7177     find first rvs-line-attr no-lock
     7178              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     7179                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     7180                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     7181                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     7182                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     7183                and rvs-line-attr.attr-code = "izm-temps" no-error.
     7184     if available rvs-line-attr then do :
     7185       sr-type-temp = integer(entry(1, rvs-line-attr.attr-value, ";")) no-error .
     7186       v-izm-temps-attr = entry(2, rvs-line-attr.attr-value, ";") no-error .
     7187     end .
     7188     find first rvs-line-attr no-lock
     7189              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     7190                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     7191                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     7192                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     7193                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     7194                and rvs-line-attr.attr-code = "izm-denses" no-error.
     7195     if available rvs-line-attr then do :
     7196       sr-type-dens = integer(entry(1, rvs-line-attr.attr-value, ";")) no-error .
     7197       v-izm-denses-attr = entry(2, rvs-line-attr.attr-value, ";") no-error .
     7198     end .
     7199     case sr-type-temp :
     7200       when 0
     7201       then do :
     7202         ikey = num-entries(v-izm-temps-attr) .
     7203         do it = 1 to num-entries(v-izm-temps-attr) :
     7204           find first tt-temps no-lock where tt-temps.ii = ikey no-error .
     7205           if not available tt-temps
     7206           then do :
     7207             create tt-temps .
     7208             assign
     7209               tt-temps.ii = ikey
     7210               tt-temps.key_ = "t" + string(ikey)
     7211               tt-temps.temperature = decimal(entry(it, v-izm-temps-attr))
     7212             .
     7213           end .
     7214           ikey = ikey - 1 .
     7215         end .
     7216       end .
     7217       when 1
     7218       then do :
     7219         do it = 1 to num-entries(v-izm-temps-attr) :
     7220           find first tt-temps no-lock where tt-temps.ii = it no-error .
     7221           if not available tt-temps
     7222           then do :
     7223             if place-type = 1
     7224             and it = 3
     7225             then do :
     7226               tt-temps.key_ = "tср" no-error .
     7227             end .
     7228             create tt-temps .
     7229             assign
     7230               tt-temps.ii = it
     7231               tt-temps.temperature = decimal(entry(it, v-izm-temps-attr))
     7232             .
     7233             case it :
     7234               when 1 then tt-temps.key_ = "tн" .
     7235               when 2 then tt-temps.key_ = "tср" .
     7236               when 3 then tt-temps.key_ = "tв" .
     7237             end case .
     7238             if place-type = 1
     7239             and it = 2
     7240             then do :
     7241               tt-temps.key_ = "tв" no-error .
     7242             end .
     7243           end .
     7244         end .
     7245       end .
     7246     end case .
     7247     case sr-type-dens :
     7248       when 0
     7249       then do :
     7250         ikey = num-entries(v-izm-denses-attr) .
     7251         do id = 1 to num-entries(v-izm-denses-attr) :
     7252           find first tt-dens no-lock where tt-dens.ii = ikey no-error .
     7253           if not available tt-dens
     7254           then do :
     7255             create tt-dens .
     7256             assign
     7257               tt-dens.ii = ikey
     7258               tt-dens.key_ = "P" + string(ikey) + (if ikey = 1 then "(низ)" else "")
     7259               tt-dens.density = decimal(entry(id, v-izm-denses-attr))
     7260             .
     7261           end .
     7262           ikey = ikey - 1 .
     7263         end .
     7264       end .
     7265       when 1
     7266       then do :
     7267         do id = 1 to num-entries(v-izm-denses-attr) :
     7268           find first tt-dens-temp no-lock where tt-dens-temp.ii = id no-error .
     7269           if not available tt-dens-temp
     7270           then do :
     7271             create tt-dens-temp .
     7272             assign
     7273               tt-dens-temp.ii = id
     7274               tt-dens-temp.density = decimal(entry(id, v-izm-denses-attr))
     7275             .
     7276             tt-dens-temp.temperature = decimal(entry(id, v-izm-temps-attr)) no-error .
     7277             case id :
     7278               when 1 then tt-dens-temp.key_ = "Pн" .
     7279               when 2 then tt-dens-temp.key_ = "Pср" .
     7280               when 3 then tt-dens-temp.key_ = "Pв" .
     7281             end case .
     7282           end .
     7283         end .
     7284       end .
     7285     end case .
     7286     assign frame Dialog-Frame :title = frame Dialog-Frame :title + " - " + parmode
     7287                                       + " - " +  partitle.
     7288     WAIT-FOR GO OF FRAME Dialog-Frame.
     7289   END.
     7290   RUN disable_UI.
     7291   return v-return-val .
     7292   PROCEDURE chg-density :
     7293   if input frame Dialog-Frame tt-rvs-line.state-density = ?
     7294     or ( buf_goods.unit-base <> buf_goods.unit-cli
     7295          and ( input frame Dialog-Frame tt-rvs-line.state-density <= 0
     7296                or input frame Dialog-Frame tt-rvs-line.state-density >= 1
     7297              )
     7298        )
     7299     or ( buf_goods.unit-base = buf_goods.unit-cli
     7300          and input frame Dialog-Frame tt-rvs-line.state-density <> 1
     7301        )
     7302   then do:
     7303      message "Неверно определена плотность топлива." skip buf_goods.unit-base skip buf_goods.unit-cli skip tt-rvs-line.state-density view-as alert-box error.
     7304      return error.
     7305   end.
     7306   run gds-attr-value in this-procedure
     7307     ( input  buf_goods.gds-code
     7308     ,input  'gds-ptrl-densities':U
     7309     ,output v-gds-ptrl-densities
     7310     ,output v-attr-type
     7311     ) .
     7312     if v-gds-ptrl-densities <> "" and v-gds-ptrl-densities <> ? then do:
     7313       assign
     7314         v-min-dens = decimal(replace(entry(1, v-gds-ptrl-densities, "-":U ), "кг\л", "":U))
     7315         v-max-dens = decimal(replace(entry(2, v-gds-ptrl-densities, "-":U ), "кг\л":U, "":U))
     7316       no-error .
     7317       if (input frame Dialog-Frame tt-rvs-line.state-density) < v-min-dens
     7318       or (input frame Dialog-Frame tt-rvs-line.state-density) > v-max-dens
     7319       then do:
     7320         message
     7321           substitute("Введенное значение плотности находится вне заданного диапазона: &1.",
     7322           v-gds-ptrl-densities )
     7323           view-as alert-box error .
     7324         return error.
     7325       end.
     7326     end.
     7327   if tt-rvs-line.state-measure-qnty:sensitive
     7328   then
     7329     tt-rvs-line.state-measure-cli-qnty = tt-rvs-line.state-measure-qnty * tt-rvs-line.state-density
     7330   .
     7331   else
     7332   assign
     7333     tt-rvs-line.state-measure-qnty = tt-rvs-line.state-measure-cli-qnty / tt-rvs-line.state-density
     7334   .
     7335   assign
     7336     tt-rvs-line.state-brutto-cli-qnty = tt-rvs-line.state-measure-cli-qnty + (if varstate-water-qnty <> ? then varstate-water-qnty else 0)
     7337     tt-rvs-line.fact-calc-add-mass = tt-rvs-line.state-add-qnty  * tt-rvs-line.state-density
     7338     tt-rvs-line.fact-sum-mass = tt-rvs-line.fact-calc-add-mass + tt-rvs-line.state-measure-cli-qnty
     7339     varstate-sum-vol = tt-rvs-line.state-brutto-qnty
     7340   .
     7341   abs-delta-mass-add-qnty = tt-rvs-line.fact-calc-add-mass * pl-error-mass / 100 no-error .
     7342   display tt-rvs-line.state-measure-cli-qnty tt-rvs-line.fact-calc-add-mass tt-rvs-line.state-measure-qnty tt-rvs-line.fact-sum-mass varstate-sum-vol with frame Dialog-Frame.
     7343   END PROCEDURE.
     7344   PROCEDURE disable_UI :
     7345     HIDE FRAME Dialog-Frame.
     7346   END PROCEDURE.
     7347   PROCEDURE enable_UI :
     7348     OPEN QUERY Dialog-Frame FOR EACH tt-rvs-line SHARE-LOCK.
     7349     GET FIRST Dialog-Frame.
     7350     DISPLAY varmeasure-water-qnty varstate-water-qnty varmeasure-water-cli-qnty
     7351             varstate-water-cli-qnty delta-mass-qnty varstate-sum-vol varsum-vol
     7352         WITH FRAME Dialog-Frame.
     7353     IF AVAILABLE tt-rvs-line THEN
     7354       DISPLAY tt-rvs-line.system-qnty tt-rvs-line.system-cli-qnty
     7355             tt-rvs-line.orig-system-qnty tt-rvs-line.orig-system-cli-qnty
     7356             tt-rvs-line.measure-qnty tt-rvs-line.state-measure-qnty
     7357             tt-rvs-line.meas-calc-qnty tt-rvs-line.measure-tc-qnty tt-rvs-line.state-measure-tc-qnty
     7358             tt-rvs-line.density tt-rvs-line.state-density
     7359             tt-rvs-line.meas-calc-dens tt-rvs-line.izmer-density
     7360             tt-rvs-line.add-qnty tt-rvs-line.state-add-qnty
     7361             tt-rvs-line.brutto-qnty tt-rvs-line.state-brutto-qnty
     7362             tt-rvs-line.brutto-tc-qnty tt-rvs-line.state-brutto-tc-qnty
     7363             tt-rvs-line.measure-cli-qnty tt-rvs-line.state-measure-cli-qnty
     7364             tt-rvs-line.meas-cli-calc-qnty tt-rvs-line.temp-izm-vol
     7365             tt-rvs-line.brutto-cli-qnty tt-rvs-line.state-brutto-cli-qnty
     7366             tt-rvs-line.level-petrol tt-rvs-line.state-level-petrol
     7367             tt-rvs-line.level-total tt-rvs-line.state-level-total
     7368             tt-rvs-line.level-water tt-rvs-line.state-level-water
     7369             tt-rvs-line.temperature tt-rvs-line.state-temperature
     7370             tt-rvs-line.meas-mh-qnty tt-rvs-line.state-mh-qnty
     7371             tt-rvs-line.meas-am-qnty tt-rvs-line.state-am-qnty
     7372             tt-rvs-line.meas-cf-qnty tt-rvs-line.state-cf-qnty
     7373         WITH FRAME Dialog-Frame.
     7374     ENABLE b-save b-cancel b-help RECT-2 RECT-3 tt-rvs-line.state-measure-qnty
     7375            tt-rvs-line.state-density b-calc tt-rvs-line.state-add-qnty
     7376            tt-rvs-line.state-brutto-qnty tt-rvs-line.state-brutto-cli-qnty
     7377            tt-rvs-line.state-level-petrol tt-rvs-line.state-level-total
     7378            tt-rvs-line.state-temperature
     7379         WITH FRAME Dialog-Frame.
     7380     VIEW FRAME Dialog-Frame.
     7381   END PROCEDURE.
     7382   PROCEDURE level-measure-water :
     7383   display input frame Dialog-Frame tt-rvs-line.level-total -
     7384           input frame Dialog-Frame tt-rvs-line.level-petrol @
     7385           tt-rvs-line.level-water with frame Dialog-Frame.
     7386   END PROCEDURE.
     7387   PROCEDURE level-water :
     7388     define input parameter p-mode as logical no-undo.
     7389     define variable is_OK as logical no-undo initial yes.
     7390     tt-rvs-line.state-level-petrol = input frame Dialog-Frame tt-rvs-line.state-level-total - input frame Dialog-Frame tt-rvs-line.state-level-water .
     7391     if is_OK = yes then do:
     7392       assign frame Dialog-Frame tt-rvs-line.state-level-water
     7393                                  tt-rvs-line.state-level-petrol
     7394                                  tt-rvs-line.state-level-total.
     7395     end.
     7396   END PROCEDURE.
     7397   PROCEDURE local-tarir :
     7398   DEFINE INPUT PARAMETER paraction AS CHARACTER NO-UNDO.
     7399   DEFINE VARIABLE varlevel-sm-q AS DECIMAL NO-UNDO.
     7400   define variable vartarirvalue as character no-undo.
     7401   define variable vartarirtype  as character no-undo.
     7402   define variable varlevel-sm   as integer   no-undo.
     7403   define buffer buf_place for ub.place.
     7404   define variable  v-file-name as character no-undo.
     7405   define variable v-delta-mas-qnty as decimal no-undo.
     7406   define variable v-full-name as character no-undo.
     7407       define variable tt-level-water     as integer no-undo.
     7408       define variable tt-level-water-dec as decimal no-undo.
     7409       define variable v-water-qnty       as decimal no-undo.
     7410       define buffer bf-water-nxt_pl-level for pl-level.
     7411       define variable varlevel-sm-water as decimal no-undo.
     7412   run gbl/conf-rd.p ("tarir", "", "", 0, "", "", "", no, output vartarirvalue, output vartarirtype) no-error.
     7413   if vartarirvalue = "yes" then do:
     7414     CASE paraction:
     7415       WHEN "state-level-total" THEN DO:
     7416         ASSIGN
     7417           varlevel-sm-q = input frame Dialog-Frame tt-rvs-line.state-level-total.
     7418       END.
     7419       WHEN "state-level-petrol" THEN DO:
     7420         ASSIGN
     7421           varlevel-sm-q = input frame Dialog-Frame tt-rvs-line.state-level-petrol.
     7422       END.
     7423     END CASE.
     7424     assign
     7425       varlevel-sm = trunc (varlevel-sm-q, 0).
     7426     find first buf_place no-lock
     7427       where buf_place.pl-code = tt-rvs-line.pl-code
     7428       .
     7429     find first bf_pl-level
     7430       where bf_pl-level.obj-type = tt-rvs-line.obj-type
     7431         and bf_pl-level.obj-code = tt-rvs-line.obj-code
     7432         and bf_pl-level.pl-code  = buf_place.pl-code
     7433         and bf_pl-level.pl-level = varlevel-sm
     7434       no-error.
     7435     if not available bf_pl-level then do:
     7436       message "Вычисляем объем резервуаров через градуировочные таблицы. Для резервуара " buf_place.loc1 " не задан объем для уровня " varlevel-sm view-as alert-box error.
     7437       return no-apply.
     7438     end.
     7439     else do:
     7440       if varlevel-sm = varlevel-sm-q then do:
     7441         if error-status:error then return no-apply.
     7442         display
     7443           bf_pl-level.pl-qnty @ tt-rvs-line.state-measure-qnty
     7444           bf_pl-level.pl-qnty + tt-rvs-line.state-add-qnty @ tt-rvs-line.fact-sum-vol
     7445           with frame Dialog-Frame.
     7446       end.
     7447       else do:
     7448         assign
     7449           varlevel-sm = varlevel-sm + 1.
     7450         find first buf-nxt_pl-level
     7451           where buf-nxt_pl-level.obj-type = tt-rvs-line.obj-type
     7452             and buf-nxt_pl-level.obj-code = tt-rvs-line.obj-code
     7453             and buf-nxt_pl-level.pl-code  = buf_place.pl-code
     7454             and buf-nxt_pl-level.pl-level = varlevel-sm
     7455           no-error.
     7456         if not available buf-nxt_pl-level then do:
     7457           message "Вычисляем объем резервуаров через градуировочные таблицы. Для резервуара " buf_place.loc1 " не задан объем для уровня " varlevel-sm " измерение " varlevel-sm-q view-as alert-box error.
     7458           return no-apply.
     7459         end.
     7460         else do:
     7461           display
     7462             bf_pl-level.pl-qnty + (buf-nxt_pl-level.pl-qnty - bf_pl-level.pl-qnty) * (varlevel-sm-q - trunc(varlevel-sm-q, 0)) @ tt-rvs-line.state-measure-qnty
     7463             bf_pl-level.pl-qnty + (buf-nxt_pl-level.pl-qnty - bf_pl-level.pl-qnty) * (varlevel-sm-q - trunc(varlevel-sm-q, 0)) + tt-rvs-line.state-add-qnty @ tt-rvs-line.fact-sum-vol
     7464             with frame Dialog-Frame.
     7465         end.
     7466       end.
     7467         if  tt-rvs-line.state-level-water <> 0 then
     7468         do:
     7469             find first bf_pl-level where bf_pl-level.obj-type = tt-rvs-line.obj-type      and
     7470                 bf_pl-level.obj-code = tt-rvs-line.obj-code      and
     7471                 bf_pl-level.pl-code  = buf_place.pl-code          and
     7472                 bf_pl-level.pl-level = tt-rvs-line.state-level-water           no-error.
     7473             if not available bf_pl-level then
     7474             do:
     7475                     assign
     7476                         varlevel-sm-water = tt-rvs-line.state-level-water  + 1.
     7477                     for each  bf-water-nxt_pl-level where bf-water-nxt_pl-level.obj-type = tt-rvs-line.obj-type  and
     7478                         bf-water-nxt_pl-level.obj-code = tt-rvs-line.obj-code  and
     7479                         bf-water-nxt_pl-level.pl-code  = buf_place.pl-code  and
     7480                         bf-water-nxt_pl-level.pl-level  <  varlevel-sm-water   and
     7481                         bf-water-nxt_pl-level.pl-level > tt-rvs-line.state-level-water  - 1 no-lock  :
     7482                         v-water-qnty = abs (  abs (v-water-qnty )  -  bf-water-nxt_pl-level.pl-qnty / 10 )  .
     7483                         if  bf-water-nxt_pl-level.pl-level > tt-rvs-line.state-level-water  - 1 and bf-water-nxt_pl-level.pl-level < tt-rvs-line.state-level-water  then
     7484                         do:
     7485                             tt-level-water =  bf-water-nxt_pl-level.pl-qnty.
     7486                             tt-level-water-dec =  tt-rvs-line.state-level-water - bf-water-nxt_pl-level.pl-level .
     7487                         end.
     7488                     end.
     7489                     varstate-water-qnty =  tt-level-water +  tt-level-water-dec *  v-water-qnty * 10  .
     7490                     display  varstate-water-qnty with frame Dialog-Frame.
     7491                     display tt-rvs-line.state-measure-qnty + varstate-water-qnty  @ varstate-sum-vol
     7492                         with frame Dialog-Frame.
     7493             end.
     7494             else
     7495             do:
     7496                 assign
     7497                     varstate-water-qnty = bf_pl-level.pl-qnty  .
     7498                 display  varstate-water-qnty with frame Dialog-Frame.
     7499                 display tt-rvs-line.state-measure-qnty + varstate-water-qnty  @ varstate-sum-vol
     7500                         with frame Dialog-Frame.
     7501             end.
     7502         end.
     7503             else do:
     7504                 assign
     7505                     varstate-water-qnty = 0  .
     7506                 display  varstate-water-qnty with frame Dialog-Frame.
     7507                 display tt-rvs-line.state-measure-qnty @ varstate-sum-vol
     7508                 with frame Dialog-Frame.
     7509             end.
     7510         assign
     7511           tt-rvs-line.state-measure-qnty
     7512           tt-rvs-line.state-measure-qnty = tt-rvs-line.state-measure-qnty - varstate-water-qnty
     7513           tt-rvs-line.state-brutto-qnty = tt-rvs-line.state-measure-qnty + varstate-water-qnty
     7514         .
     7515           display tt-rvs-line.state-measure-qnty with frame Dialog-Frame.
     7516           if tt-rvs-line.state-density <> 0 and
     7517               tt-rvs-line.state-density <> ? then
     7518           do:
     7519               run chg-density.
     7520               run weath-water.
     7521           end.
     7522         if rdc-value = "pomi-rn"  then do:
     7523           run placelib_get-attr in this-procedure  (
     7524               input "place-type"
     7525               ,input tt-rvs-line.obj-code
     7526               ,input tt-rvs-line.obj-type
     7527               ,input tt-rvs-line.pl-code
     7528               ,output v-value
     7529               ,output v-ok      ) no-error.
     7530           if v-ok then
     7531           do :
     7532   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7533   empty temp-table thbjattr_thbj-attr.
     7534   run adm/shattri.p (
     7535      input "get":U
     7536     ,input tt-rvs-line.obj-type
     7537     ,input tt-rvs-line.obj-code
     7538     ,input 'petrol':U
     7539     ,input  ""
     7540     ,output v-value-character
     7541     ,output v-value-date
     7542     ,output v-value-decimal
     7543     ,output v-value-integer
     7544     ,output v-value-logical
     7545     ,output par-type
     7546     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     7547     ) no-error .
     7548               if integer(v-value) = 1 then
     7549               do:
     7550                   for each thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'Delta-mass-vert':U:
     7551                       assign
     7552                           v-full-name = thbjattr_thbj-attr.property-value-character .
     7553                   end.
     7554               end.
     7555               else
     7556               do:
     7557                   for each thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'Delta-mass-horiz':U:
     7558                       assign
     7559                           v-full-name = thbjattr_thbj-attr.property-value-character .
     7560                   end.
     7561               end.
     7562               do ii = 1 to NUM-ENTRIES(v-full-name,chr(10)):
     7563                   v-file-name = string(entry(ii,v-full-name,chr(10))).
     7564                   if    tt-rvs-line.state-level-petrol = decimal ( entry(1, v-file-name, ";")  )  then
     7565                   do:
     7566                       v-delta-mas-qnty =  decimal( entry(2, v-file-name, ";") ) no-error.
     7567                   end.
     7568               end.
     7569           end.
     7570           if v-delta-mas-qnty > 0.65 then v-delta-mas-qnty = 0.65 .
     7571           delta-mass-qnty = v-delta-mas-qnty.
     7572           display  delta-mass-qnty with frame Dialog-Frame.
     7573           end.
     7574       abs-delta-mass-add-qnty = tt-rvs-line.fact-calc-add-mass * pl-error-mass / 100 no-error .
     7575          tt-rvs-line.state-measure-cli-qnty = input frame Dialog-Frame tt-rvs-line.state-measure-qnty * tt-rvs-line.state-density .
     7576          tt-rvs-line.fact-sum-mass = tt-rvs-line.state-measure-cli-qnty + tt-rvs-line.fact-calc-add-mass .
     7577       tt-rvs-line.fact-sum-vol = tt-rvs-line.state-measure-qnty + tt-rvs-line.state-add-qnty .
     7578       varstate-sum-vol = input frame Dialog-Frame tt-rvs-line.state-measure-qnty + varstate-water-qnty .
     7579       display
     7580         abs-delta-mass-add-qnty
     7581         tt-rvs-line.fact-sum-vol
     7582         tt-rvs-line.state-measure-cli-qnty
     7583         tt-rvs-line.fact-sum-mass
     7584         varstate-sum-vol
     7585       with frame Dialog-Frame.
     7586       run volume-water.
     7587     end.
     7588   end.
     7589   END PROCEDURE.
     7590   PROCEDURE volume-measure-water :
     7591     display ? @ varmeasure-water-qnty with frame Dialog-Frame.
     7592     for first rvs-line-attr no-lock
     7593           where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     7594             and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     7595             and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     7596             and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     7597             and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     7598             and rvs-line-attr.attr-code = "measure-water-qnty"
     7599     :
     7600       display decimal(rvs-line-attr.attr-value) @ varmeasure-water-qnty with frame Dialog-Frame.
     7601     end .
     7602   END PROCEDURE.
     7603   PROCEDURE volume-water :
     7604   if rdc-value <>  "pomi-rn"
     7605   then do :
     7606     if tt-rvs-line.state-brutto-qnty -
     7607        tt-rvs-line.state-measure-qnty <> ?
     7608     then
     7609     display tt-rvs-line.state-brutto-qnty - tt-rvs-line.state-measure-qnty @
     7610             varstate-water-qnty with frame Dialog-Frame.
     7611     else
     7612     if input frame Dialog-Frame tt-rvs-line.state-brutto-qnty -
     7613        input frame Dialog-Frame tt-rvs-line.state-measure-qnty <> ?
     7614     then
     7615     display input frame Dialog-Frame tt-rvs-line.state-brutto-qnty -
     7616             input frame Dialog-Frame tt-rvs-line.state-measure-qnty @
     7617             varstate-water-qnty with frame Dialog-Frame.
     7618   end.
     7619   else do :
     7620     for first rvs-line-attr no-lock
     7621           where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     7622             and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     7623             and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     7624             and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     7625             and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     7626             and rvs-line-attr.attr-code = "pokmi-water-qnty"
     7627     :
     7628       display decimal(rvs-line-attr.attr-value) @ varstate-water-qnty with frame Dialog-Frame.
     7629     end .
     7630   end .
     7631   END PROCEDURE.
     7632   PROCEDURE weath-measure-water :
     7633   display input frame Dialog-Frame tt-rvs-line.brutto-cli-qnty -
     7634           input frame Dialog-Frame tt-rvs-line.measure-cli-qnty @
     7635           varmeasure-water-cli-qnty with frame Dialog-Frame.
     7636   END PROCEDURE.
     7637   PROCEDURE weath-water :
     7638   END PROCEDURE.
