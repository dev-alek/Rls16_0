     4997         assign
     4998           rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4999           rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     5000           rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     5001           rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     5002           rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     5003           rvs-line-attr.attr-code = "rvd-reason"
