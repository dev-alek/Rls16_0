     4894   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4895   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     4896     (input  buf_rvs-doc.obj-type
     4897     ,input  buf_rvs-doc.obj-code
     4898     ,output v-shift-date
     4899     ,output v-shift-num
     4900     ,output v-shift-name
     4901     ) no-error .
     4902     if rdc-value = "pomi-rn" then do :
     4903       if tt-rvs-line.izmer-density = ? or tt-rvs-line.izmer-density = 0
     4904       then do :
     4905         message "Сохранение введенных параметров НП невозможно." skip (1)
     4906                 "Плотность НП унаследована у предыдущего документа сверки." skip
     4907                 'Введите измеренную плотность и нажмите кнопку "Рассчитать".'
     4908         view-as alert-box information.
     4909         apply "entry" to tt-rvs-line.izmer-density in frame Dialog-Frame.
     4910         return no-apply.
     4911       end.
     4912       find first rvs-line-attr no-lock
     4913            where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4914              and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4915              and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4916              and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4917              and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4918              and rvs-line-attr.attr-code = "is-calc" no-error.
     4919       if not available rvs-line-attr
     4920       or (available rvs-line-attr and rvs-line-attr.attr-value <> "yes")
     4921       then do :
     4922         message "Сохранение введенных параметров НП невозможно." skip (1)
     4923                 "Не выполнено приведение параметров НП к стандартной температуре." skip
     4924                 'Нажмите кнопку "Рассчитать" и повторите попытку.'
