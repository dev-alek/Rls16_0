     1028           end.
     1029                 when 'rvd-own-nb':U then do:
     1030             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1031               assign
     1032                 ptrlprop-rvd-own-nb = thbjattr_thbj-attr.property-value-logical
     1033               .
     1034             end.
     1035           end.
     1036           when 'qr-scan-time':U then do:
     1037             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1038               assign
