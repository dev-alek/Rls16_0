     1047               .
     1048             end.
     1049           end.
     1050         end case.
     1051         delete thbjattr_thbj-attr .
     1052       end.
     1053     end.
     1054     return .
     1055   end procedure.
     1056   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1057   procedure cur-time :
     1058      define output parameter p-today as date      no-undo .
     1059      define output parameter p-time  as integer   no-undo .
     1060     do
     1061     on error undo, return error
     1062     :
     1063       define variable v-date1 as date      no-undo .
     1064       define variable v-date2 as date      no-undo .
     1065       define variable v-time  as integer   no-undo .
     1066       assign
     1067         v-date1 = today
     1068         v-time  = time
     1069         v-date2 = today
     1070       .
     1071       if v-date1 <> v-date2
     1072       then do:
     1073         assign
     1074           v-date1 = today
     1075           v-time  = v-time
     1076         .
     1077       end.
     1078       assign
     1079         p-today = v-date1
     1080         p-time  = v-time
     1081       .
     1082     end.
     1083   end.
     1084   function cur-time-date returns character
     1085   :
     1086     return string(today, '99/99/9999':U) .
     1087   end.
     1088   function cur-time-mjd returns decimal
     1089   :
     1090     define variable v-date as date      no-undo .
     1091     define variable v-time as integer   no-undo .
     1092     run cur-time in this-procedure
     1093       (output v-date
     1094       ,output v-time
     1095       ) .
     1096     return integer(v-date) - 2400002 + (v-time / 86400) .
     1097   end.
     1098   function cur-time-get-ending-index returns integer
     1099   (input p-number as integer
     1100   )
     1101   :
     1102     if p-number < 0
     1103     or p-number = ?
     1104     then do:
     1105       return 1 .
     1106     end.
     1107     define variable v-rest as integer   no-undo .
     1108     assign
     1109       p-number = p-number modulo 100
     1110     .
     1111     if p-number < 20
     1112     then do:
     1113       assign
     1114         v-rest = p-number
     1115       .
     1116     end.
     1117     else do:
     1118       assign
     1119         v-rest = p-number modulo 10
     1120       .
     1121     end.
     1122     case v-rest :
     1123       when 1
     1124       then do:
     1125         return 2 .
     1126       end.
     1127       when 2 or
     1128       when 3 or
     1129       when 4
     1130       then do:
     1131         return 3 .
     1132       end.
     1133       otherwise do:
     1134         return 1 .
     1135       end.
     1136     end case .
     1137   end.
     1138   procedure cur-time-mjd-to-date :
     1139      define input  parameter i-mjd-diff as decimal no-undo.
     1140      define output parameter o-Date     as date    no-undo.
     1141      define output parameter o-Time     as integer no-undo.
     1142      define variable v-day-number as integer   no-undo .
     1143      if    i-mjd-diff < 0
     1144         or i-mjd-diff = ?
     1145      then do:
     1146         return "?" .
     1147      end.
     1148      assign
     1149         v-day-number = truncate(i-mjd-diff,0).
     1150         o-Date = date(v-day-number + 2400002).
     1151         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1152     .
     1153   end.
     1154   function cur-time-mjd-to-string returns character
     1155   (input p-mjd-diff as decimal
     1156   )
     1157   :
     1158     define variable v-day-number as integer   no-undo .
     1159     define variable v-seconds    as integer   no-undo .
     1160     define variable v-hour       as integer   no-undo .
     1161     define variable v-min        as integer   no-undo .
     1162     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1163     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1164     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1165     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1166     if p-mjd-diff < 0
     1167     or p-mjd-diff = ?
     1168     then do:
     1169       return "?" .
     1170     end.
     1171     assign
     1172       v-day-number = integer(truncate(p-mjd-diff,0))
     1173       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1174     .
     1175     if v-seconds > 86400
     1176     then do:
     1177       assign
     1178         v-seconds = 86400 - 1
     1179       .
     1180     end.
     1181     if v-seconds < 0
     1182     then do:
     1183       assign
     1184         v-seconds = 0
     1185       .
     1186     end.
     1187     assign
     1188       v-hour = truncate(v-seconds / 3600, 0)
     1189     .
     1190     assign
     1191       v-seconds = v-seconds modulo 3600
     1192     .
     1193     assign
     1194       v-min = truncate(v-seconds / 60, 0)
     1195     .
     1196     assign
     1197       v-seconds = v-seconds modulo 60
     1198     .
     1199     return
     1200         (if v-day-number <> 0
     1201           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1202           else ""
     1203         )
     1204       + (if v-day-number <> 0 or v-hour <> 0
     1205           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1206           else ""
     1207         )
     1208       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1209           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1210           else ""
     1211         )
     1212       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1213       .
     1214   end.
     1215   function cur-time-string returns character
     1216   :
     1217     define variable v-date as date      no-undo .
     1218     define variable v-time as integer   no-undo .
     1219     run cur-time in this-procedure
     1220       (output v-date
     1221       ,output v-time
     1222       ) .
     1223     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1224   end.
     1225   function cur-time-string-sec returns character
     1226   :
     1227     define variable v-date as date      no-undo .
     1228     define variable v-time as integer   no-undo .
     1229     run cur-time in this-procedure
     1230       (output v-date
     1231       ,output v-time
     1232       ) .
     1233     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1234   end.
     1235   function cur-time-custom  returns character
     1236   (input p-prefix as character
     1237   ,input p-date-format as character
     1238   ,input p-delimiter as character
     1239   ,input p-time-format as character
     1240   ,input p-suffix as character
     1241   )
     1242   :
     1243     define variable v-date as date      no-undo .
     1244     define variable v-time as integer   no-undo .
     1245     run cur-time in this-procedure
     1246       (output v-date
     1247       ,output v-time
     1248       ) .
     1249     return
     1250       p-prefix
     1251       + string(v-date, p-date-format)
     1252       + p-delimiter
     1253       + string(v-time, p-time-format)
     1254       + p-suffix
     1255       .
     1256   end.
     1257   function cur-time-print  returns character
     1258   :
     1259     define variable v-date as date      no-undo .
     1260     define variable v-time as integer   no-undo .
     1261     run cur-time in this-procedure
     1262       (output v-date
     1263       ,output v-time
     1264       ) .
     1265     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1266   end.
     1267   function cur-time-datetime returns datetime
     1268   :
     1269     define variable v-char as character no-undo .
     1270     define variable v-datetime as datetime no-undo .
     1271     v-char = cur-time-string().
     1272     v-datetime = datetime(v-char).
     1273     return  v-datetime.
     1274   end.
     1275   function cur-time-string-msec returns character
     1276   :
     1277     define variable v-date as datetime  no-undo .
     1278     v-date = now.
     1279     return string(v-date) .
     1280   end.
     1281   define   shared variable g#auto as logical no-undo.
     1282   define   shared variable g#news as logical no-undo.
     1283   define   shared variable g#oxml as logical no-undo.
