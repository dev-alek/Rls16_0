     6245                               ,input tt-rvs-line.obj-type
     6246                               ,input tt-rvs-line.pl-code
     6247                               ,output v-value
     6248                               ,output v-ok      ) no-error.
     6249     if not v-ok then pl-rvd-lvl = no.
