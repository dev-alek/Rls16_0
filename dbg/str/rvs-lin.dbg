      757   procedure placelib_write-attr:
      758   define input  parameter p-code     like ub.place-attr.attr-code .
      759   define input  parameter p-obj-code like ub.place-attr.obj-code .
      760   define input  parameter p-obj-type like ub.place-attr.obj-type .
      761   define input  parameter p-pl-code  like ub.place-attr.pl-code .
      762   define input  parameter p-value    like ub.place-attr.attr-value .
      763   define output parameter p-ok       as logical.
      764   define buffer buf_place-attr for ub.place-attr .
      765     do on error undo, return error return-value :
      766        p-ok = false.
      767        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      768                                                   and buf_place-attr.obj-code    = p-obj-code
      769                                                   and buf_place-attr.obj-type    = p-obj-type
      770                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      771        if not available buf_place-attr then do :
      772           create buf_place-attr.
      773           assign
      774             buf_place-attr.attr-code   = p-code
      775             buf_place-attr.attr-value  = p-value
      776             buf_place-attr.obj-code    = p-obj-code
      777             buf_place-attr.obj-type    = p-obj-type
      778             buf_place-attr.pl-code     = p-pl-code
      779           .
      780           p-ok = true.
      781        end.
      782        else do:
      783           buf_place-attr.attr-value  = p-value .
      784           p-ok = true.
      785        end.
      786     end.
      787   end.
      788   procedure placelib_get-attr:
      789   define input  parameter  p-code     like ub.place-attr.attr-code .
      790   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      791   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      792   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      793   define output parameter  p-value    like ub.place-attr.attr-value .
      794   define output parameter  p-ok       as logical.
      795   define buffer buf_place-attr for ub.place-attr .
      796     do on error undo, return error return-value :
      797        p-ok = false.
      798        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      799                                                   and buf_place-attr.obj-code    = p-obj-code
      800                                                   and buf_place-attr.obj-type    = p-obj-type
      801                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      802        if available buf_place-attr then do :
      803          p-value = buf_place-attr.attr-value.
      804          p-ok = true.
      805        end.
      806        else do :
      807          p-ok = false.
      808        end.
      809     end.
      810   end.
      811   procedure placelib_del-attr:
      812   define input parameter  p-code     like ub.place-attr.attr-code .
      813   define input parameter  p-obj-code like ub.place-attr.obj-code .
      814   define input parameter  p-obj-type like ub.place-attr.obj-type .
      815   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      816   define input parameter  p-value    like ub.place-attr.attr-value .
      817   define output parameter p-ok       as logical.
      818   define buffer buf_place-attr for ub.place-attr .
      819     do on error undo, return error return-value :
      820        p-ok = false.
      821        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      822                                                   and buf_place-attr.obj-code    = p-obj-code
      823                                                   and buf_place-attr.obj-type    = p-obj-type
      824                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      825        if available buf_place-attr then do :
      826           delete buf_place-attr.
      827           p-ok = true.
      828        end.
      829     end.
      830   end.
