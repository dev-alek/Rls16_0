     2313   function getCalibrationBelt returns character
     2314     (
     2315     input iObjType as character,
     2316     input iObjCode as integer,
     2317     input iPlCode  as integer,
     2318     input iLevelNP as decimal,
     2319     input iLevelWater as decimal
     2320     )
     2321   :
     2322     define variable vCalibBelt      as  character         no-undo.
     2323     define buffer   buf_pl-level-mm for ub.pl-level-mm.
     2324     for each buf_pl-level-mm where
     2325              buf_pl-level-mm.obj-type = iObjType
     2326          and buf_pl-level-mm.obj-code = iObjCode
     2327          and buf_pl-level-mm.pl-code  = iPlCode
     2328          and ((buf_pl-level-mm.min-level <= iLevelNP and buf_pl-level-mm.max-level >= iLevelNP) or
     2329               (buf_pl-level-mm.min-level <= iLevelWater and buf_pl-level-mm.max-level >= iLevelWater))
     2330         no-lock
     2331         break by buf_pl-level-mm.zone by buf_pl-level-mm.level:
     2332       if first-of(buf_pl-level-mm.zone) then do:
     2333         vCalibBelt = substitute("&1&2;&3=",vCalibBelt, buf_pl-level-mm.min-level,buf_pl-level-mm.max-level).
     2334       end.
     2335       vCalibBelt = substitute("&1&2&3",vCalibBelt, if buf_pl-level-mm.level = 1 then "" else ";", trim(string(buf_pl-level-mm.capacity / 1000, ">>>>>9.999"))).
     2336       if last-of(buf_pl-level-mm.zone) and not last(buf_pl-level-mm.zone) then
     2337         vCalibBelt = substitute("&1&2",vCalibBelt, chr(10)).
     2338     end.
     2339     return vCalibBelt.
     2340   end.
