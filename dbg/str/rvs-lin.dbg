     6208     if tt-rvs-line.system-qnty <> tt-rvs-line.orig-system-qnty then do:
     6209       display
     6210         tt-rvs-line.orig-system-qnty
     6211         with frame Dialog-Frame.
     6212     end.
     6213     else do:
     6214       hide
     6215         tt-rvs-line.orig-system-qnty
     6216         in frame Dialog-Frame.
     6217     end.
     6218     if tt-rvs-line.system-cli-qnty <> tt-rvs-line.orig-system-cli-qnty then do:
     6219       display
     6220         tt-rvs-line.orig-system-cli-qnty
     6221         with frame Dialog-Frame.
     6222     end.
     6223     else do:
     6224       hide
     6225         tt-rvs-line.orig-system-cli-qnty
     6226         in frame Dialog-Frame.
     6227     end.
     6228     run placelib_get-attr  ( input "place-type"
     6229                               ,input tt-rvs-line.obj-code
     6230                               ,input tt-rvs-line.obj-type
     6231                               ,input tt-rvs-line.pl-code
     6232                               ,output v-value
     6233                               ,output v-ok      ) no-error.
