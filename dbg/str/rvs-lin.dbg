       47   define  input parameter parparentproc   as handle    no-undo .
       48   define  input parameter parrec-rvs-line as recid     no-undo .
       49   define  input parameter parmode         as character no-undo .
       50   define  input parameter partitle        as character no-undo .
       51   define variable vss-revision    as character no-undo initial "$Revision$":U.
       52   define variable vss-author      as character no-undo initial "$Author$":U.
       53   define variable vss-date        as character no-undo initial "$Date$":U.
       54   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
       55   define variable vss-archive     as character no-undo initial "$Archive$":U.
       56   define variable vss-description as character no-undo initial "Экран работы со строкой сверки":U.
       57   procedure vss-get-info :
       58     define output parameter p-vss-revision    like vss-revision    no-undo .
       59     define output parameter p-vss-author      like vss-author      no-undo .
       60     define output parameter p-vss-date        like vss-date        no-undo .
       61     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       62     define output parameter p-vss-archive     like vss-archive     no-undo .
       63     define output parameter p-vss-description like vss-description no-undo .
       64     assign
       65       p-vss-revision    = vss-revision
       66       p-vss-author      = vss-author
       67       p-vss-date        = vss-date
       68       p-vss-workfile    = vss-workfile
       69       p-vss-archive     = vss-archive
       70       p-vss-description = vss-description
       71     .
       72   end procedure.
       73   procedure vss-get-parameters :
       74     define output parameter p-vss-parameters as character no-undo .
       75   end procedure.
       76   define new global shared variable g#vssrevis-logger as handle    no-undo .
       77   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       78   define variable v-vssrevis-logger                   as handle    no-undo .
       79   procedure vss-logevent :
       80     define input  parameter p-extra-paramters as character no-undo .
       81     define variable v-vssrevis-parameters as character no-undo .
       82     do
       83     on error undo, return error return-value
       84     :
       85       if  valid-handle(v-vssrevis-logger)
       86       and v-vssrevis-logger :get-signature("logevent") <> ""
       87       then do:
       88         run vss-get-parameters in this-procedure
       89           (output v-vssrevis-parameters
       90           ).
       91         run logevent in v-vssrevis-logger
       92           (input vss-workfile
       93           ,input vss-revision
       94           ,input v-vssrevis-parameters
       95           ,input p-extra-paramters
       96           ).
       97       end.
       98     end.
       99   end procedure.
      100   assign
      101     v-vssrevis-logger = g#vssrevis-logger
      102   .
      103   if  valid-handle(v-vssrevis-logger)
      104   and v-vssrevis-logger :get-signature("logevent") <> ""
      105   then do:
      106     assign
      107       v-vssrevis-logevent = true
      108     .
      109     run vss-logevent in this-procedure (input vss-description) .
      110   end.
      111   define new global shared variable g#language as character no-undo .
      112   if g#language <> '' and g#language <> 'rus':U then do:
      113     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      114   end.
      115   procedure proc-alt-shift-f2:
      116     if not ibs.th.gbl.gbl-var:rcode
      117   then
      118     run gbl\inidebug.p .
      119   end.
      120   procedure proc-alt-shift-f3:
      121     run gbl/prvssinf.p
      122       ( input this-procedure
      123       ) .
      124   end.
      125   define variable v-inform-launched as logical no-undo initial false .
      126   procedure proc-alt-shift-f4:
      127     define variable v-action as character no-undo .
      128     if v-inform-launched = false then do:
      129       assign
      130         v-inform-launched = true
      131       .
      132       run gbl/d-inform.w
      133         (  input self
      134         ,  input this-procedure
      135         , output v-action
      136         ) no-error .
      137       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      138       assign
      139         v-inform-launched = false
      140       .
      141     end.
      142   end.
      143   procedure proc-alt-f1:
      144     run gbl/corrhelp.p
      145       (input this-procedure
      146       ) .
      147   end .
      148   on alt-shift-f2 anywhere do:
      149     run proc-alt-shift-f2.
      150   end.
      151   on alt-shift-f3 anywhere do:
      152     run proc-alt-shift-f3 in this-procedure .
      153   end.
      154   on alt-shift-f4 anywhere do:
      155     run proc-alt-shift-f4 in this-procedure.
      156   end.
      157   on alt-f1 anywhere do:
      158     run proc-alt-f1 in this-procedure .
      159   end.
