     6031     return no-apply.
     6032   END.
     6033   ON LEAVE OF tt-rvs-line.state-temperature IN FRAME Dialog-Frame
     6034   DO:
     6035       assign frame Dialog-Frame tt-rvs-line.state-temperature.
     6036   END.
     6037   ON return OF tt-rvs-line.state-temperature IN FRAME Dialog-Frame
     6038   DO:
     6039     return no-apply.
     6040   END.
     6041   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     6042   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     6043   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6044   on help of frame Dialog-Frame
     6045   do:
     6046     run gbl/app_help.p
     6047       (input this-procedure :file-name
     6048       ,input ''
     6049       ,input ?
     6050       ) no-error.
     6051     if error-status :error then do:
     6052       message
     6053         "Ошибка при вызове помощи"
     6054         error-status :get-message(1)
     6055         view-as alert-box .
     6056     end.
     6057   end.
     6058   run minbtn-set in this-procedure .
     6059   on choose of b-help in frame Dialog-Frame
     6060   do:
     6061     apply "help":u to frame Dialog-Frame .
     6062   end.
     6063   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6064   procedure minbtn-set :
     6065       do
     6066           on error undo, return error return-value
     6067           :
     6068           define variable ii              as integer       no-undo .
     6069           define variable fh              as widget-handle no-undo .
     6070           define variable hh              as widget-handle no-undo .
     6071           define variable v-h             as handle        extent 4 no-undo .
     6072           define variable v-name-button   as character     no-undo .
     6073           define variable v-help-old-x    as decimal       no-undo .
     6074           define variable v-help-old-y    as decimal       no-undo .
     6075           define variable v-help-old-size as decimal       no-undo .
     6076           define variable v-frame-width   as decimal       no-undo .
     6077           define variable jj              as integer       no-undo .
     6078           do
     6079               on error undo, return error
     6080               :
     6081               assign
     6082                   v-frame-width = frame Dialog-Frame:width - 0.3
     6083                   fh            = frame Dialog-Frame:first-child
     6084                   hh            = fh:first-child
     6085                   ii            = 1
     6086                   .
     6087               do while valid-handle(hh):
     6088                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     6089                   do:
     6090                       case lc(hh:name) :
     6091                           when "b-help" then
     6092                               do:
     6093                                   hh:load-image-up("cmp/b-help.bmp":u) .
     6094                                   hh:load-image-down("cmp/b-help.bmp":u) .
     6095                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     6096                                   hh:TOOLTIP = "Помощь" .
     6097                                   v-help-old-x = hh:column .
     6098                                   v-help-old-y = hh:row    .
     6099                                   v-help-old-size = hh:width .
     6100                                   hh:width-chars = 2.5 .
     6101                               end.
     6102                           when "b-print" then
     6103                               do:
     6104                                   hh:load-image("cmp/b-print.bmp":u) .
     6105                                   hh:TOOLTIP = "Печать" .
     6106                                   v-h[ii] = hh:handle .
     6107                                   ii = ii + 1 .
     6108                                   hh:width-chars = 3 .
     6109                               end.
     6110                           when "b-history" or
     6111                           when "b-hist" then
     6112                               do:
     6113                                   hh:load-image("cmp/b-hist.bmp":u) .
     6114                                   hh:TOOLTIP = "История" .
     6115                                   v-h[ii] = hh:handle .
     6116                                   ii = ii + 1 .
     6117                                   hh:width-chars = 3 .
     6118                               end.
     6119                           when "b-sch" then
     6120                               do:
     6121                                   hh:load-image("cmp/b-sch.bmp":u) .
     6122                                   hh:TOOLTIP = "Установка Фильтра" .
     6123                                   v-h[ii] = hh:handle .
     6124                                   ii = ii + 1 .
     6125                                   hh:width-chars = 3 .
     6126                               end.
     6127                           when "b-hist-user" then
     6128                               do:
     6129                                   hh:load-image("cmp/b-hist.bmp":u) .
     6130                                   hh:TOOLTIP = "История пользователя" .
     6131                                   ii = ii + 1 .
     6132                               end.
     6133                       end case.
     6134                   end.
     6135                   hh = hh:next-sibling.
     6136               end.
     6137               b-help:column = v-frame-width - b-help:width-chars.
     6138               jj = 0.
     6139               repeat ii = 4 to 1 by -1 :
     6140                   if valid-handle (v-h[ii] ) then
     6141                   do:
     6142                       jj  = jj + 1 .
     6143                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     6144                       v-h[ii]:row    = v-help-old-y .
     6145                   end.
     6146               end.
     6147           end.
     6148       end.
     6149   end procedure.
     6150   MAIN-BLOCK:
     6151   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     6152      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     6153   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6154     run mainmenu_getcntxt in parparentproc
     6155       (output v-cntxt-db-num
