      856   procedure get-ptrl-prop :
      857     define input  parameter p-obj-type as character no-undo .
      858     define input  parameter p-obj-code as integer   no-undo .
      859     do
      860     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      861     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
      862     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
      863     :
      864       define variable par-type          as character no-undo.
      865       define variable v-value-character as character no-undo .
      866       define variable v-value-date      as date      no-undo .
      867       define variable v-value-decimal   as decimal   no-undo .
      868       define variable v-value-integer   as integer   no-undo .
      869       define variable v-value-logical   as logical   no-undo .
      870       for each thbjattr_thbj-attr
      871       :
      872         delete thbjattr_thbj-attr .
      873       end.
      874       run adm/shattri.p
      875         ( input "get":U
      876         , input p-obj-type
      877         , input p-obj-code
      878         , input 'petrol':U
      879         , input  ""
      880         , output v-value-character
      881         , output v-value-date
      882         , output v-value-decimal
      883         , output v-value-integer
      884         , output v-value-logical
      885         , output par-type
      886         , input-output table thbjattr_thbj-attr
      887         ) no-error .
      888       for each thbjattr_thbj-attr
      889       on error undo, return error return-value
      890       :
      891         case thbjattr_thbj-attr.prop-code :
      892           when 'denstclc':U then do:
      893             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      894               assign
      895                 ptrlprop-denstclc = thbjattr_thbj-attr.property-value-character
      896               .
      897             end.
      898           end.
      899           when 'expptrl':U then do:
      900             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      901               and thbjattr_thbj-attr.prop-value-type = 'character':U
      902             then do:
      903               assign
      904                 ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
      905               .
      906             end.
      907           end.
      908           when 'inpptrl':U then do:
      909             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      910               and thbjattr_thbj-attr.prop-value-type = 'character':U
      911             then do:
      912               assign
      913                 ptrlprop-inpptrl = thbjattr_thbj-attr.property-value-character
      914               .
      915             end.
      916           end.
      917           when 'autopump':U then do:
      918             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      919               assign
      920                 ptrlprop-autopump = thbjattr_thbj-attr.property-value-logical
      921               .
      922             end.
      923           end.
      924           when 'rvsnmter':U then do:
      925             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      926               assign
      927                 ptrlprop-rvsnmter = thbjattr_thbj-attr.property-value-logical
      928               .
      929             end.
      930           end.
      931           when 'avtinvpm':U then do:
      932             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      933               assign
      934                 ptrlprop-avtinvpm = thbjattr_thbj-attr.property-value-logical
      935               .
      936             end.
      937           end.
      938           when 'invclipt':U then do:
      939             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      940               assign
      941                 ptrlprop-invclipt = thbjattr_thbj-attr.property-value-integer
      942               .
      943             end.
      944           end.
      945           when 'olddens':U then do:
      946             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      947               assign
      948                 ptrlprop-olddens = thbjattr_thbj-attr.property-value-logical
      949               .
      950             end.
      951           end.
      952           when 'algrvspt':U then do:
      953             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      954               assign
      955                 ptrlprop-algrvspt = thbjattr_thbj-attr.property-value-integer
      956               .
      957             end.
      958           end.
      959           when 'temp-for-pomi':U then do:
      960             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      961               assign
      962                 ptrlprop-temp-for-pomi = thbjattr_thbj-attr.property-value-integer
      963               .
      964             end.
      965           end.
      966           when 'algoincome':U then do:
      967             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      968               assign
      969                 ptrlprop-algoincome = thbjattr_thbj-attr.property-value-integer
      970               .
      971             end.
      972           end.
      973           when 'mand-choice-autocar':U then do:
      974             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      975               assign
      976                 ptrlprop-mand-choice-autocar = thbjattr_thbj-attr.property-value-logical
      977               .
      978             end.
      979           end.
      980           when 'block-nozzle':U then do:
      981             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      982               assign
      983                 ptrlprop-block-nozzle = thbjattr_thbj-attr.property-value-logical
      984               .
      985             end.
      986           end.
      987           when 'timeout-block-nozzle':U then do:
      988             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      989               assign
      990                 ptrlprop-timeout-block-nozzle = thbjattr_thbj-attr.property-value-integer
      991               .
      992             end.
      993           end.
      994           when 'Delta-mass-horiz':U then do:
      995             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      996               assign
      997                 ptrlprop-Delta-mass-horiz = thbjattr_thbj-attr.property-value-character
      998               .
      999             end.
     1000           end.
     1001           when 'Delta-mass-vert':U then do:
     1002             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
     1003               assign
