     6185       .
     6186     end.
     6187     else do:
     6188     find first buf_rvs-doc no-lock
     6189       where buf_rvs-doc.rvs-code = tt-rvs-line.rvs-code
     6190       .
     6191     end.
     6192     RUN enable_UI IN THIS-PROCEDURE.
     6193     if num-entries(buf_rvs-doc.rvs-code, "-") = 3
