     1005               .
     1006             end.
     1007           end.
     1008           when 'calc-free-vol':U then do:
     1009             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1010               assign
     1011                 ptrlprop-calc-free-vol = thbjattr_thbj-attr.property-value-logical
     1012               .
     1013             end.
     1014           end.
     1015           when 'calc-free-vol-sug':U then do:
     1016             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1017               assign
     1018                 ptrlprop-calc-free-vol-sug = thbjattr_thbj-attr.property-value-logical
     1019               .
     1020             end.
     1021           end.
     1022           when 'trn-reas-sug':U then do:
     1023             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1024               assign
     1025                 ptrlprop-trn-reas-sug = thbjattr_thbj-attr.property-value-logical
     1026               .
