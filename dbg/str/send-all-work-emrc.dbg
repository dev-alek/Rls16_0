        1   block-level on error undo, throw.
        2   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        3   define new global shared variable g#language as character no-undo .
        4   if g#language <> '' and g#language <> 'rus':U then do:
        5     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        6   end.
        7   procedure putc :
        8   define input  parameter iSAXWriter as handle no-undo .
        9   define input  parameter i-action   as character  no-undo .
       10   define input  parameter i-value    as character  no-undo .
       11   define output parameter oOK       as logical no-undo.
       12   define buffer code for ub.code.
       13   define buffer code-emc for ub.code.
       14   define variable vi as integer no-undo.
       15     define variable vDate  as character no-undo.
       16     if i-action ne "U"
       17     then do:
       18        run putc-emrcdel(iSAXWriter).
       19     end.
       20     else do:
       21        for each code-emc where Code-emc.parent = "EMC"
       22        on error undo, return error
       23        :
       24            iSAXWriter:start-element("EMRC_Type") .
       25            iSAXWriter:insert-attribute("ctrl",   if Code-emc.status_ eq 0 then "ADD" else "DEL").
       26            iSAXWriter:insert-attribute("tsm",    "0").
       27            iSAXWriter:insert-attribute("code",    string(int(Code-emc.code))).
       28            iSAXWriter:write-data-element("EMRC_TypeName" , Code-emc.CodeName ) .
       29            iSAXWriter:end-element("EMRC_Type" ).
       30            vdate = iso-date(today - 93).
       31            find last code where Code.parent eq Code-emc.parent + chr(4) + Code-emc.code
       32                             and code.code < vdate
       33            no-lock no-error.
       34            if avail code
       35            then
       36               vdate = code.code.
       37            for each code where Code.parent eq Code-emc.parent + chr(4) + Code-emc.code
       38                            and code.code >= vdate
       39            on error undo, return error
       40            :
       41               define variable vcode as character no-undo.
       42               define variable vEMRCDate as character no-undo.
       43               vEMRCDate = Code.code + " 00:00:00".
       44               vcode = Code-emc.code.
       45               vi = vi + 1.
       46               iSAXWriter:start-element("EMRC_Value") .
       47               iSAXWriter:insert-attribute("ctrl",   if Code.status_ eq 0 then "ADD" else "DEL").
       48               iSAXWriter:insert-attribute("tsm",    "0").
       49               iSAXWriter:insert-attribute("code",    string(vi)).
       50               iSAXWriter:write-data-element("EMRC_ValueType" , trim(string(dec(vcode),">>>>9.9")) ) .
       51               iSAXWriter:write-data-element("EMRC_ValueData" , vEMRCDate).
       52               iSAXWriter:write-data-element("EMRC_ValuePrice" , Code.CodeValue).
       53               iSAXWriter:end-element("EMRC_Value" ).
       54            end.
       55         end.
       56      end.
       57      oOK = true.
       58   end procedure.
       59   procedure putc-emrcdel :
       60   define input parameter iSAXWriter as handle no-undo .
       61      iSAXWriter:start-element("EMRC_Type") .
       62         iSAXWriter:insert-attribute("ctrl",   "DEL").
       63         iSAXWriter:insert-attribute("tsm",    "0").
       64         iSAXWriter:insert-attribute("code",    "*").
       65      iSAXWriter:end-element("EMRC_Type" ).
       66      iSAXWriter:start-element("EMRC_Value") .
       67         iSAXWriter:insert-attribute("ctrl",   "DEL").
       68         iSAXWriter:insert-attribute("tsm",    "0").
       69         iSAXWriter:insert-attribute("code",    "*").
       70      iSAXWriter:end-element("EMRC_Value" ).
       71   end procedure.
