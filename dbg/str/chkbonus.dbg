     2878   define variable sort-column-phrase as character no-undo .
     2879   DEFINE VARIABLE title0 AS CHARACTER NO-UNDO INIT "Список бонусов, начисленных на кассе".
     2880   case sort-column-name :
     2881     when "" then do:
     2882       assign
     2883         sort-column-phrase = ""
     2884       .
     2885     end.
     2886     otherwise do:
     2887       assign
     2888         sort-column-phrase = "by " + sort-column-name
     2889       .
     2890     end.
     2891   end case.
     2892   define variable l-open-query as logical   no-undo .
     2893     CASE p-list-mode :
     2894       WHEN 'объект':U THEN DO:
     2895         ASSIGN
     2896         filter-point = filter-point0 + p-list-mode
     2897         filter-label = SUBSTITUTE("&1 Один объект", filter-label0)
     2898         .
     2899         if p-open-query then do:
     2900           frame Dialog-Frame:TITLE = substitute("&1 Объект: &2&3", title0 , p-obj-type , p-obj-code).
     2901         end.
     2902   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
