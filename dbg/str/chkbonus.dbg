      539   procedure prn-lib-reportviewer :
      540     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      541     define input parameter p-report-name-html as character no-undo .
      542     define input parameter p-param        as character no-undo .
      543     define variable v-excel           as character no-undo init 'TRUE' .
      544     define variable v-value-character as character no-undo .
      545     define variable v-value-integer   as character no-undo .
      546     define variable v-value-date      as date      no-undo .
      547     define variable v-value-decimal   as decimal   no-undo .
      548     define variable rep-excel         as logical   no-undo .
      549     define variable excel-string      as character no-undo .
      550     define variable v-param-type      as character no-undo .
      551     define variable v-tth             as handle    no-undo .
      552     run adm/shattri.p (
      553       input "get":U
      554       ,input  ""
      555       ,input  0
      556       ,input  'report-glob':U
      557       ,input  'rep-excel':U
      558       ,output v-value-character
      559       ,output v-value-date
      560       ,output v-value-decimal
      561       ,output v-value-integer
      562       ,output rep-excel
      563       ,output v-param-type
      564       ,INPUT-OUTPUT table-handle v-tth
      565       )  .
      566     if rep-excel then v-excel = "TRUE" .
      567     else v-excel = "FALSE" .
      568     if p-param eq ""
      569     then
      570        p-param = "EXCEL:" + v-excel.
      571     else
      572        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      573     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      574   end procedure.
      575   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      576   procedure fltfield-clear :
      577     define output parameter loc-fld as character no-undo.
      578     define output parameter loc-lab as character no-undo .
      579     define output parameter loc-spr as character no-undo .
      580     define output parameter loc-dim as character no-undo .
      581     assign
      582       loc-fld = ""
      583       loc-lab = ""
      584       loc-spr = ""
      585       loc-dim = "0"
      586     .
      587   end procedure .
      588   procedure fltfield-add :
      589     define input        parameter par-fld as character no-undo.
      590     define input        parameter par-lab as character no-undo .
      591     define input        parameter par-spr as character no-undo .
      592     define input-output parameter loc-fld as character no-undo.
      593     define input-output parameter loc-lab as character no-undo .
      594     define input-output parameter loc-spr as character no-undo .
      595     define input-output parameter loc-dim as character no-undo .
      596     do
      597     on error undo, return error
      598     :
      599       assign
      600       loc-fld = if loc-dim = '0'
      601                 then par-fld
      602                 else (loc-fld + chr(44) + par-fld)
      603       loc-lab = if loc-dim = '0'
      604                 then par-lab
      605                 else (loc-lab + chr(44) + par-lab)
      606       loc-spr = if loc-dim = '0'
      607                 then par-spr
      608                 else (loc-spr + chr(44) + par-spr)
      609       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      610                 string(integer(if num-entries(loc-dim) > 1
      611                               then entry(2, loc-dim)
      612                               else entry(1, loc-dim)
      613                               ) + 1)
      614       no-error
      615       .
      616     end.
      617   end procedure.
      618   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      619   procedure cur-time :
      620      define output parameter p-today as date      no-undo .
      621      define output parameter p-time  as integer   no-undo .
      622     do
      623     on error undo, return error
      624     :
      625       define variable v-date1 as date      no-undo .
      626       define variable v-date2 as date      no-undo .
      627       define variable v-time  as integer   no-undo .
      628       assign
      629         v-date1 = today
      630         v-time  = time
      631         v-date2 = today
      632       .
      633       if v-date1 <> v-date2
      634       then do:
      635         assign
      636           v-date1 = today
      637           v-time  = v-time
      638         .
      639       end.
      640       assign
      641         p-today = v-date1
      642         p-time  = v-time
      643       .
      644     end.
      645   end.
      646   function cur-time-date returns character
      647   :
      648     return string(today, '99/99/9999':U) .
      649   end.
      650   function cur-time-mjd returns decimal
      651   :
      652     define variable v-date as date      no-undo .
      653     define variable v-time as integer   no-undo .
      654     run cur-time in this-procedure
      655       (output v-date
      656       ,output v-time
      657       ) .
      658     return integer(v-date) - 2400002 + (v-time / 86400) .
      659   end.
      660   function cur-time-get-ending-index returns integer
      661   (input p-number as integer
      662   )
      663   :
      664     if p-number < 0
      665     or p-number = ?
      666     then do:
      667       return 1 .
      668     end.
      669     define variable v-rest as integer   no-undo .
      670     assign
      671       p-number = p-number modulo 100
      672     .
      673     if p-number < 20
      674     then do:
      675       assign
      676         v-rest = p-number
      677       .
      678     end.
      679     else do:
      680       assign
      681         v-rest = p-number modulo 10
      682       .
      683     end.
      684     case v-rest :
      685       when 1
      686       then do:
      687         return 2 .
      688       end.
      689       when 2 or
      690       when 3 or
      691       when 4
      692       then do:
      693         return 3 .
      694       end.
      695       otherwise do:
      696         return 1 .
      697       end.
      698     end case .
      699   end.
      700   procedure cur-time-mjd-to-date :
      701      define input  parameter i-mjd-diff as decimal no-undo.
      702      define output parameter o-Date     as date    no-undo.
      703      define output parameter o-Time     as integer no-undo.
      704      define variable v-day-number as integer   no-undo .
      705      if    i-mjd-diff < 0
      706         or i-mjd-diff = ?
      707      then do:
      708         return "?" .
      709      end.
      710      assign
      711         v-day-number = truncate(i-mjd-diff,0).
      712         o-Date = date(v-day-number + 2400002).
      713         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      714     .
      715   end.
      716   function cur-time-mjd-to-string returns character
      717   (input p-mjd-diff as decimal
      718   )
      719   :
      720     define variable v-day-number as integer   no-undo .
      721     define variable v-seconds    as integer   no-undo .
      722     define variable v-hour       as integer   no-undo .
      723     define variable v-min        as integer   no-undo .
      724     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      725     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      726     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      727     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      728     if p-mjd-diff < 0
      729     or p-mjd-diff = ?
      730     then do:
      731       return "?" .
      732     end.
      733     assign
      734       v-day-number = integer(truncate(p-mjd-diff,0))
      735       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      736     .
      737     if v-seconds > 86400
      738     then do:
      739       assign
      740         v-seconds = 86400 - 1
      741       .
      742     end.
      743     if v-seconds < 0
      744     then do:
      745       assign
      746         v-seconds = 0
      747       .
      748     end.
      749     assign
      750       v-hour = truncate(v-seconds / 3600, 0)
      751     .
      752     assign
      753       v-seconds = v-seconds modulo 3600
      754     .
      755     assign
      756       v-min = truncate(v-seconds / 60, 0)
      757     .
      758     assign
      759       v-seconds = v-seconds modulo 60
      760     .
      761     return
      762         (if v-day-number <> 0
      763           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      764           else ""
      765         )
      766       + (if v-day-number <> 0 or v-hour <> 0
      767           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      768           else ""
      769         )
      770       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      771           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      772           else ""
      773         )
      774       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      775       .
      776   end.
      777   function cur-time-string returns character
      778   :
      779     define variable v-date as date      no-undo .
      780     define variable v-time as integer   no-undo .
      781     run cur-time in this-procedure
      782       (output v-date
      783       ,output v-time
      784       ) .
      785     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      786   end.
      787   function cur-time-string-sec returns character
      788   :
      789     define variable v-date as date      no-undo .
      790     define variable v-time as integer   no-undo .
      791     run cur-time in this-procedure
      792       (output v-date
      793       ,output v-time
      794       ) .
      795     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      796   end.
      797   function cur-time-custom  returns character
      798   (input p-prefix as character
      799   ,input p-date-format as character
      800   ,input p-delimiter as character
      801   ,input p-time-format as character
      802   ,input p-suffix as character
      803   )
      804   :
      805     define variable v-date as date      no-undo .
      806     define variable v-time as integer   no-undo .
      807     run cur-time in this-procedure
      808       (output v-date
      809       ,output v-time
      810       ) .
      811     return
      812       p-prefix
      813       + string(v-date, p-date-format)
      814       + p-delimiter
      815       + string(v-time, p-time-format)
      816       + p-suffix
      817       .
      818   end.
      819   function cur-time-print  returns character
      820   :
      821     define variable v-date as date      no-undo .
      822     define variable v-time as integer   no-undo .
      823     run cur-time in this-procedure
      824       (output v-date
      825       ,output v-time
      826       ) .
      827     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      828   end.
      829   function cur-time-datetime returns datetime
      830   :
      831     define variable v-char as character no-undo .
      832     define variable v-datetime as datetime no-undo .
      833     v-char = cur-time-string().
      834     v-datetime = datetime(v-char).
      835     return  v-datetime.
      836   end.
      837   function cur-time-string-msec returns character
      838   :
      839     define variable v-date as datetime  no-undo .
      840     v-date = now.
      841     return string(v-date) .
      842   end.
