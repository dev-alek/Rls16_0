     2945             then  substitute(' X_chk-bonus.obj-type  = &1&2&1            AND X_chk-bonus.obj-code  = &3                AND X_chk-bonus.chk-date  >= 01/01/1990           AND X_chk-bonus.chk-date  <= 31/12/9999                AND X_chk-bonus.record-type  = 4  ', chr(34), p-obj-type, p-obj-code)  + " " + where-phrase-27
