     2796       ,output v-cntxt-obj-code
     2797       ,output v-cntxt-db-num-obj
     2798       ,output v-cntxt-is-admin
     2799       ) .
     2800     if lookup(p-list-mode, 'объект':U + chr(44) + "chk-date") = 0 THEN DO:
     2801       message vss-workfile vss-revision vss-description skip
     2802       "Неверный вызов - p-list-mode=" p-list-mode
     2803       view-as alert-box ERROR.
     2804       return.
     2805     END.
     2806     IF p-list-mode = 'объект':U
     2807     OR p-list-mode = "chk-date":U THEN DO:
     2808       FIND FIRST buf_obj No-LOCK WHERE
     2809                   buf_obj.obj-type = p-obj-type and
     2810                   buf_obj.obj-code = p-obj-code No-ERROR.
     2811       if not avail buf_obj then do:
     2812         message vss-workfile vss-revision vss-description skip
     2813         "Неверное значение параметров вызова p-obj-type и/или p-obj-code"
     2814         p-obj-type p-obj-code
     2815         view-as alert-box ERROR.
     2816         return.
     2817       end.
     2818     end.
     2819     IF p-list-mode = "chk-date":U then do:
     2820         if p-start-date > p-end-date
     2821         or p-start-date = ?
     2822         or p-end-date = ?
     2823         then do:
     2824             message vss-workfile vss-revision vss-description skip
     2825             "Неверное значение параметров p-start-date p-end-date" p-start-date p-end-date
     2826             view-as alert-box ERROR.
     2827             return.
     2828       end.
     2829     END.
     2830     RUN Myenable IN THIS-PROCEDURE.
     2831     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     2832     ASSIGN
     2833     v-rid-list = p-rid-list.
     2834     HIDE mark-num in frame Dialog-Frame .
     2835     if entry(1, v-rid-list) <> '':U then
     2836     REPOSITION br-bonus to recid integer(entry(1, v-rid-list)) No-ERROR.
     2837     WAIT-FOR GO OF FRAME Dialog-Frame.
     2838   END.
     2839   RUN disable_UI.
     2840   PROCEDURE disable_UI :
     2841     HIDE FRAME Dialog-Frame.
     2842   END PROCEDURE.
     2843   PROCEDURE enable_UI :
     2844     DISPLAY sch-code sch-date sch-sum mark-num
     2845         WITH FRAME Dialog-Frame.
     2846     ENABLE b-quit b-mark b-sel b-chk-doc b-sch B-Help br-bonus sch-code sch-date
     2847            sch-sum mark-num
     2848         WITH FRAME Dialog-Frame.
     2849     VIEW FRAME Dialog-Frame.
     2850   END PROCEDURE.
     2851   PROCEDURE MyEnable :
     2852   DISPLAY
     2853   sch-code
     2854   sch-date
     2855   sch-sum
     2856   mark-num
     2857   WITH FRAME Dialog-Frame .
     2858   ENABLE
     2859   b-quit
     2860   b-mark when lookup("b-sel", bttns) > 0
     2861   b-sel  when lookup("b-sel", bttns) > 0
     2862   b-chk-doc
     2863   b-sch
     2864   B-Help
     2865   br-bonus
     2866   sch-code
     2867   sch-date
     2868   sch-sum
     2869   mark-num
     2870   WITH FRAME Dialog-Frame .
     2871   VIEW FRAME Dialog-Frame .
     2872   END PROCEDURE.
     2873   PROCEDURE OpenBr :
     2874   define input  parameter p-open-query     as logical   no-undo .
     2875   define input  parameter p-find-next      as logical   no-undo .
