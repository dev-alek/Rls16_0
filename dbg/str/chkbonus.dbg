      867   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      868   FUNCTION mark-string RETURNS CHARACTER
      869     ( input p-recid as recid, input mark-list as character  ) :
      870     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      871   END FUNCTION.
      872   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      873     define variable v-cntxt-db-num        as integer   no-undo .
      874     define variable v-cntxt-userid        as character no-undo .
      875     define variable v-cntxt-level         as character no-undo .
      876     define variable v-cntxt-host-code-obj as integer   no-undo .
      877     define variable v-cntxt-obj-type      as character no-undo .
      878     define variable v-cntxt-obj-code      as integer   no-undo .
      879     define variable v-cntxt-db-num-obj    as integer   no-undo .
      880     define variable v-cntxt-is-admin      as logical   no-undo .
      881   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      882   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      883   procedure fltopend_fltopend :
      884   define input parameter p-parent-handle as handle no-undo .
      885   define input parameter p-qh as handle no-undo .
      886   define input parameter p-flt-open-open-query  as character no-undo .
      887   define input parameter p-where-cond as character no-undo .
      888   define input parameter p-use-indFIRST-query-tail as character no-undo .
      889   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      890   define input parameter p-indexed-reposition as character no-undo .
      891     do
      892     on error undo, return error
      893     :
      894   define variable v-prepare-string as character no-undo .
      895   define variable glog as logical no-undo .
      896   assign
      897   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      898                      p-where-cond + chr(32)  +
      899                      p-use-indFIRST-query-tail + chr(32) +
      900                      p-use-ind-sort-clmn-by + chr(32) +
      901                      p-indexed-reposition
      902   .
      903   assign
      904   glog = p-qh:query-prepare(v-prepare-string) no-error .
      905   if not glog
      906   or error-status:error then do:
      907     message error-status:get-message(1) view-as alert-box .
      908     undo, return error .
      909   end.
      910   assign
      911   glog = p-qh:query-open no-error .
      912   if not glog
      913   or error-status:error then do:
      914     message error-status:get-message(1) view-as alert-box .
      915     undo, return error .
      916   end.
      917     end.
      918   end procedure.
      919   procedure fltopend_fltfindd :
      920   define input parameter p-parent-handle as handle no-undo .
      921   define input parameter p-qh as handle no-undo .
      922   define input parameter p-rowid as rowid no-undo .
      923   define input parameter p-next as logical no-undo .
      924   define input parameter p-lock as integer no-undo .
      925   define input parameter p-bh as handle no-undo .
      926   define input parameter p-where-cond as character no-undo .
      927   define input parameter p-use-index-phrase as character no-undo .
      928   define variable glog as logical no-undo .
      929   define variable v-qh as handle no-undo .
      930   define variable v-bh as handle no-undo .
      931   define variable v-recid as recid no-undo .
      932   define variable v-prepare-string as character no-undo .
      933   do
      934   on error undo, return error
      935   on stop undo, return error
      936   :
      937     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      938     create buffer v-bh for table p-bh buffer-name p-bh:name.
      939     create query v-qh.
      940     v-qh:set-buffers(v-bh).
      941     v-prepare-string = substitute("for each &1 &2 &3"
      942                                     ,v-bh:name
      943                                     ,p-where-cond
      944                                     ,p-use-index-phrase).
      945     glog = v-qh:query-prepare(v-prepare-string) no-error.
      946     if not glog then do:
      947       delete object v-qh.
      948       delete object v-bh.
      949       undo, return error .
      950     end.
      951     glog = v-qh:query-open no-error .
      952     if not glog then do:
      953       delete object v-qh.
      954       delete object v-bh.
      955       undo, return error .
      956     end.
      957     if p-next then do:
      958       v-qh:reposition-to-rowid(p-rowid) no-error .
      959       glog = v-qh:get-next( p-lock) no-error .
      960       glog = v-qh:get-next( p-lock) no-error .
      961       if not glog or v-qh:query-off-end = yes then do:
      962         glog = v-qh:get-first( p-lock) no-error .
      963       end.
      964     end.
      965     else do:
      966       glog = v-qh:get-first( p-lock) no-error .
      967     end.
      968     v-recid = v-bh:recid no-error .
      969     delete object v-qh.
      970     delete object v-bh.
      971     return string(v-recid) .
      972   end.
      973   end procedure.
      974   procedure fltopend_fltfindq :
      975   define input parameter p-parent-handle as handle no-undo .
      976   define input parameter p-qh as handle no-undo .
      977   define input parameter p-next as logical no-undo .
      978   define input parameter p-lock as integer no-undo .
      979   define input parameter p-flt-open-open-query  as character no-undo .
      980   define input parameter p-where-cond as character no-undo .
      981   define input parameter p-use-indFIRST-query-tail as character no-undo .
      982   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      983   define input parameter p-indexed-reposition as character no-undo .
      984   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      985   define variable glog as logical no-undo .
      986   define variable v-qh as handle no-undo .
      987   define variable v-bh as handle no-undo extent 18.
      988   define variable v-rowid as rowid no-undo extent 18.
      989   define variable v-ii as integer no-undo .
      990   define variable v-prepare-string as character no-undo .
      991   do
      992   on error undo, return error
      993   on stop undo, return error
      994   :
      995     create query v-qh.
      996     do v-ii = 1 to p-qh:num-buffers:
      997       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      998       assign
      999       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1000       no-error.
     1001       v-qh:add-buffer(v-bh[v-ii]).
     1002     end.
     1003     assign
     1004     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1005                       p-where-cond + chr(32)  +
     1006                       p-use-indFIRST-query-tail + chr(32) +
     1007                       p-use-ind-sort-clmn-by + chr(32) +
     1008                       p-indexed-reposition
     1009     .
     1010     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1011     if not glog then do:
     1012       delete object v-qh.
     1013       do v-ii = 1 to p-qh:num-buffers:
     1014         delete object v-bh[v-ii].
     1015       end.
     1016       undo, return error .
     1017     end.
     1018     glog = v-qh:query-open no-error .
     1019     if not glog then do:
     1020       delete object v-qh.
     1021       do v-ii = 1 to p-qh:num-buffers:
     1022         delete object v-bh[v-ii].
     1023       end.
     1024       undo, return error .
     1025     end.
     1026     if p-next then do:
     1027       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1028       glog = v-qh:get-next( p-lock) no-error .
     1029       glog = v-qh:get-next( p-lock) no-error .
     1030       if not glog or v-qh:query-off-end = yes then do:
     1031         glog = v-qh:get-first( p-lock) no-error .
     1032       end.
     1033     end.
     1034     else do:
     1035       glog = v-qh:get-first( p-lock) no-error .
     1036     end.
     1037     do v-ii = 1 to p-qh:num-buffers:
     1038       assign
     1039       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1040       no-error.
     1041     end.
     1042     delete object v-qh.
     1043     do v-ii = 1 to p-qh:num-buffers:
     1044       delete object v-bh[v-ii].
     1045     end.
     1046   end.
     1047   end procedure.
