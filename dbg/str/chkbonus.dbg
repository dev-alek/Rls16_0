      344       ( input this-procedure
      345       ) .
      346   end.
      347   define variable v-inform-launched as logical no-undo initial false .
      348   procedure proc-alt-shift-f4:
      349     define variable v-action as character no-undo .
      350     if v-inform-launched = false then do:
      351       assign
      352         v-inform-launched = true
      353       .
      354       run gbl/d-inform.w
      355         (  input self
      356         ,  input this-procedure
      357         , output v-action
      358         ) no-error .
      359       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      360       assign
      361         v-inform-launched = false
      362       .
      363     end.
      364   end.
