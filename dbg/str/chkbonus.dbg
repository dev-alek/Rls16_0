     3263           )
     3264         parameter-7-29 =
     3265           " indexed-reposition  "
     3266       .
     3267         run fltopend_fltfindq in this-procedure  (
     3268                             input this-procedure:handle
     3269                             ,input QUERY br-bonus:handle
     3270                             ,input logical(parameter-2-29)
     3271                             ,input no-lock
     3272                             ,input parameter-3-29
     3273                             ,input parameter-4-29
     3274                             ,input parameter-5-29
     3275                             ,input parameter-6-29
     3276                             ,input parameter-7-29
     3277                             ,output v-fltopend-rowid
     3278                             ) no-error.
     3279         .
     3280         v-doc-rec = ?.
     3281       end.
     3282       assign
     3283         l-query-was-opened = true
     3284       .
     3285     end.
     3286   end.
     3287     run waitfram-hide in this-procedure .
     3288       end.
     3289     END CASE.
     3290   if not p-open-query and v-doc-rec <> ? then
     3291   REPOSITION br-bonus to recid v-doc-rec No-ERROR.
     3292   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3293   query br-bonus:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3294   run waitfram-hide in this-procedure .
     3295   APPLY "VALUE-CHANGED" TO br-bonus in frame Dialog-Frame.
     3296   APPLY "ENTRY" TO br-bonus.
     3297   END PROCEDURE.
     3298   PROCEDURE proc-b-sch :
     3299   assign
     3300     tbl = 'chk-discnt'
     3301     join-tbl = 'X_chk-bonus'
     3302     fld = ""
     3303     lab = ""
     3304     spr = ""
     3305     dim = '0'
     3306     .
     3307   run fltfield-add in this-procedure('doc-code', 'Номер в базе', '',
     3308   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3309   run fltfield-add in this-procedure('chk-date', '', '',
     3310   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3311   run fltfield-add in this-procedure('chk-time', '', 'time',
     3312   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3313   run fltfield-add in this-procedure('pay-desk', '', '',
     3314   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3315   run fltfield-add in this-procedure('discnt-value-abs', 'Кол-во бонусов', '',
     3316   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3317   run fltfield-add in this-procedure('out-code', 'Номер продажи', '',
     3318   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3319   run fltfield-add in this-procedure('d-card', 'N дис.карты', '',
     3320   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3321   Filter-Block:
     3322   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     3323       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     3324       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     3325     run gbl/filter.w ( input parparentproc
     3326                      , INPUT filter-point
     3327                      , INPUT tbl
     3328                      , INPUT join-tbl
     3329                      , INPUT fld
     3330                      , INPUT lab
     3331                      , INPUT spr
     3332                      , INPUT dim ).
     3333     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     3334   END.
     3335   END PROCEDURE.
     3336   PROCEDURE proc-find-code :
     3337   define input parameter par-next as logical no-undo.
     3338   define input parameter p-doc-code like ub.chk-doc.doc-code no-undo.
     3339   assign
     3340   sch-date = ?
     3341   .
     3342   display
     3343   sch-date
     3344   0 @ sch-sum
     3345   with frame Dialog-Frame.
     3346   assign
     3347   p-doc-code = chr(34) + p-doc-code + chr(34).
     3348   run OpenBr in this-procedure (
     3349        input false
     3350       ,input par-next
     3351       ,input substitute("and X_chk-bonus.doc-code   begins &1 "
     3352         , p-doc-code)
     3353       ).
     3354   apply "entry":u to sch-code in frame Dialog-Frame .
     3355   END PROCEDURE.
     3356   PROCEDURE proc-find-date :
     3357   define input parameter par-next as logical no-undo.
     3358   define input parameter parchk-date like ub.chk-doc.chk-date no-undo.
     3359   define variable varchk-datechr as character no-undo.
     3360   display
     3361   '':U @ sch-code
     3362   0 @ sch-sum
     3363   with frame Dialog-Frame.
     3364   assign
     3365   varchk-datechr = string(day(parchk-date)) + chr(47) +
     3366                    string(month(parchk-date)) + chr(47) +
     3367                    string(year(parchk-date)).
     3368   run OpenBr in this-procedure (
     3369      input false
     3370     ,input true
     3371     ,input substitute("and X_chk-bonus.chk-date = &1 "
     3372       , varchk-datechr)
     3373     ).
     3374   apply "entry":u to sch-date in frame Dialog-Frame.
     3375   END PROCEDURE.
     3376   PROCEDURE proc-find-sum :
     3377   define input parameter par-next as logical no-undo.
     3378   define input parameter p-value-abs like ub.chk-discnt.discnt-value-abs no-undo.
     3379   assign
     3380   sch-date = ?
     3381   .
     3382   display
     3383   sch-date
     3384   "":U @ sch-code
     3385   with frame Dialog-Frame.
     3386   run OpenBr in this-procedure (
     3387        input false
     3388       ,input par-next
     3389       ,input substitute("and X_chk-bonus.discnt-value-abs = &1 "
     3390         , p-value-abs)
     3391       ).
     3392   apply "entry":u to sch-sum in frame Dialog-Frame .
     3393   END PROCEDURE.
     3394   PROCEDURE reposition-chk-doc :
     3395   define input  parameter p-direction   as character no-undo .
     3396   define output parameter p-chk-doc-recid as recid no-undo .
     3397   DEFINE BUFFER buf_chk-doc FOR ub.chk-doc.
     3398     case p-direction :
     3399       when "first":U
     3400       then do:
     3401         get first br-bonus.
     3402       end.
     3403       when "last":U
     3404       then do:
     3405         get last br-bonus.
     3406       end.
     3407       when "prev":U
     3408       then do:
     3409         get prev br-bonus.
     3410         if not available X_chk-bonus then do:
     3411           message
     3412           "Это первая запись списка"
     3413           view-as alert-box.
     3414         end.
     3415       end.
     3416       when "next":U
     3417       then do:
     3418         get next br-bonus.
     3419         if not available X_chk-bonus then do:
     3420           message
     3421           "Это последняя запись списка"
     3422           view-as alert-box.
     3423         end.
     3424       end.
     3425     end case .
     3426     FIND FIRST buf_chk-doc NO-LOCK WHERE
     3427               buf_chk-doc.doc-code = X_chk-bonus.doc-code no-error .
     3428     assign
     3429     p-chk-doc-recid = (if available buf_chk-doc
     3430                        then recid(buf_chk-doc)
     3431                        else ?)
     3432     v-chk-bonus-recid = RECID(X_chk-bonus)
     3433     .
     3434     run reposition-query in this-procedure
     3435       (input v-chk-bonus-recid
     3436       ).
     3437   END PROCEDURE.
     3438   PROCEDURE reposition-query :
     3439   define input parameter p-recid as recid no-undo .
     3440     if p-recid <> ?
     3441     then do:
     3442       reposition br-bonus to recid p-recid no-error.
     3443     end.
     3444     do with frame Dialog-Frame:
     3445       apply "entry":u to browse br-bonus .
     3446       apply "VALUE-CHANGED":u to browse br-bonus .
     3447     end.
     3448   END PROCEDURE.
