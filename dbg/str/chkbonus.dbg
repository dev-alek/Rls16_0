     2553   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2554   on ' ' of sch-date in frame Dialog-Frame
     2555   do:
     2556     if (can-query (self, "sensitive")
     2557        and
     2558        self :sensitive = true
     2559        )
     2560     or (can-query (self, "read-only")
     2561        and
     2562        self :read-only = false
     2563        )
     2564     then do:
     2565       assign
     2566         self :screen-value = ?
     2567       .
     2568     end.
     2569     return no-apply.
     2570   end.
     2571   on delete-character of sch-date in frame Dialog-Frame
     2572   do:
     2573     if (can-query (self, "sensitive")
     2574        and
     2575        self :sensitive = true
     2576        )
     2577     or (can-query (self, "read-only")
     2578        and
     2579        self :read-only = false
     2580        )
     2581     then do:
     2582       assign
     2583         self :screen-value = ?
     2584       .
     2585     end.
     2586     return no-apply.
     2587   end.
     2588   on ctrl-d of sch-date in frame Dialog-Frame
     2589   do:
     2590     define variable v-curr-sv-date as date no-undo .
     2591     if (can-query (self, "sensitive")
     2592        and
     2593        self :sensitive = true
     2594        )
     2595     or (can-query (self, "read-only")
     2596        and
     2597        self :read-only = false
     2598        )
     2599     then do:
     2600       if self :handle <> focus :handle
     2601       then do:
     2602         apply "entry":u to self .
     2603       end.
     2604       run gbl/getcurdt.p
     2605         (output v-curr-sv-date
     2606         ) .
     2607       assign
     2608         self :screen-value = string(v-curr-sv-date) .
     2609       .
     2610     end.
     2611     return no-apply.
     2612   end.
     2613   on ctrl-b of sch-date in frame Dialog-Frame
     2614   do:
     2615     if (can-query (self, "sensitive")
     2616        and
     2617        self :sensitive = true
     2618        )
     2619     or (can-query (self, "read-only")
     2620        and
     2621        self :read-only = false
     2622        )
     2623     then do:
     2624       if self :handle <> focus :handle
     2625       then do:
     2626         apply "entry":u to self .
     2627       end.
     2628       define variable v-curr-sv-date as date no-undo .
     2629       define variable v-new-sv-date  as date no-undo .
     2630       assign
     2631         v-curr-sv-date = date(self :screen-value) no-error
     2632       .
     2633       if v-curr-sv-date = ?
     2634       then do:
     2635         run gbl/getcurdt.p
     2636           (output v-curr-sv-date
     2637           ) .
     2638       end.
     2639       if v-curr-sv-date <> ?
     2640       then do:
     2641         assign
     2642           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     2643         .
     2644         assign
     2645           self :screen-value = string(v-new-sv-date) .
     2646         .
     2647       end.
     2648     end.
     2649     return no-apply .
     2650   end.
     2651   on ctrl-e of sch-date in frame Dialog-Frame
     2652   do:
     2653     if (can-query (self, "sensitive")
     2654        and
     2655        self :sensitive = true
     2656        )
     2657     or (can-query (self, "read-only")
     2658        and
     2659        self :read-only = false
     2660        )
     2661     then do:
     2662       if self :handle <> focus :handle
     2663       then do:
     2664         apply "entry":u to self .
     2665       end.
     2666       define variable v-curr-sv-date as date no-undo .
     2667       define variable v-new-sv-date  as date no-undo .
     2668       assign
     2669         v-curr-sv-date = date(self :screen-value) no-error
     2670       .
     2671       if v-curr-sv-date = ?
     2672       then do:
     2673         run gbl/getcurdt.p
     2674           (output v-curr-sv-date
     2675           ) .
     2676       end.
     2677       if v-curr-sv-date <> ?
     2678       then do:
     2679         run gbl/lastdate.p
     2680           (input  v-curr-sv-date
     2681           ,output v-new-sv-date
     2682           ).
     2683         assign
     2684           self :screen-value = string(v-new-sv-date) .
     2685         .
     2686       end.
     2687     end.
     2688     return no-apply .
     2689   end.
     2690   on ctrl-f of sch-date in frame Dialog-Frame
     2691   do:
     2692     if (can-query (self, "sensitive")
     2693        and
     2694        self :sensitive = true
     2695        )
     2696     or (can-query (self, "read-only")
     2697        and
     2698        self :read-only = false
     2699        )
     2700     then do:
     2701       if self :handle <> focus :handle
     2702       then do:
     2703         apply "entry":u to self .
     2704       end.
     2705       define variable v-ok            as logical   no-undo .
     2706       define variable v-curr-sv-date  as date      no-undo .
     2707       define variable v-description   as character no-undo .
     2708       assign
     2709         v-curr-sv-date = date(self :screen-value) no-error
     2710       .
     2711       if v-curr-sv-date = ?
     2712       then do:
     2713         run gbl/getcurdt.p
     2714           (output v-curr-sv-date
     2715           ) .
     2716       end.
     2717       if v-curr-sv-date <> ?
     2718       then do:
     2719         run gbl/d-inpday.w
     2720           (input ?
     2721           ,input "Выбор даты"
     2722           ,input v-description
     2723           ,input ""
     2724           ,input-output v-curr-sv-date
     2725           ,output v-ok
     2726           ).
     2727         if v-ok = true
     2728         then do:
     2729           assign
     2730             self :screen-value = string(v-curr-sv-date) .
     2731           .
     2732         end.
     2733       end.
     2734     end.
     2735     return no-apply .
     2736   end.
     2737     define MENU m-ed-date22
     2738       MENU-ITEM m-ed-date22-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     2739       MENU-ITEM m-ed-date22-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     2740       MENU-ITEM m-ed-date22-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
