     2769     END.
     2770     ON CHOOSE OF MENU-ITEM m-ed-date22-3 in menu m-ed-date22 DO:
     2771       apply "ctrl-e":U to sch-date in frame Dialog-Frame .
     2772     END.
     2773     ON CHOOSE OF MENU-ITEM m-ed-date22-4 in menu m-ed-date22 DO:
     2774       apply "ctrl-f":U to sch-date in frame Dialog-Frame .
     2775     END.
