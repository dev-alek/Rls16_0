     1074        SIZE 21 BY 1 NO-UNDO.
     1075   DEFINE VARIABLE sch-date AS DATE FORMAT "99/99/9999":U INITIAL ?
     1076        LABEL "Дата"
     1077        VIEW-AS FILL-IN
     1078        SIZE 13 BY 1 NO-UNDO.
     1079   DEFINE VARIABLE sch-sum AS CHARACTER FORMAT "X(256)":U
     1080        LABEL "Кол-во бонусов"
     1081        VIEW-AS FILL-IN
     1082        SIZE 20 BY 1 NO-UNDO.
     1083   DEFINE QUERY br-bonus FOR
     1084         X_chk-bonus SCROLLING.
     1085   DEFINE BROWSE br-bonus
     1086     QUERY br-bonus NO-LOCK DISPLAY
     1087         mark-string(recid(X_chk-bonus), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1088   X_chk-bonus.chk-date COLUMN-LABEL "Дата" FORMAT "99/99/9999":U
     1089   string(X_chk-bonus.chk-time, "HH:MM") COLUMN-LABEL "Время" FORMAT "X(5)"
     1090   X_chk-bonus.discnt-value-abs COLUMN-LABEL "Кол-во бонусов" FORMAT "->>>,>>>,>>9.99":U
     1091   entry (lookup (string(X_chk-bonus.line-type), '0,1,2,3,4,5,7,8':U), 'Неизв,Товар,Подитог,Итог,Чек,Оплата,Товар_б/итог.скидки,Группа':U) COLUMN-LABEL "Объект бонуса" FORMAT "X(20)"
     1092   X_chk-bonus.doc-code COLUMN-LABEL "Номер чека" FORMAT "X(20)":U
     1093   X_chk-bonus.obj-type COLUMN-LABEL "Тип!Объ" FORMAT "X(3)":U
     1094   X_chk-bonus.obj-code COLUMN-LABEL "Код!обЪ" FORMAT ">>>>9":U
     1095   X_chk-bonus.object-line-num COLUMN-LABEL "N строки товара!-объекта" FORMAT "999":U
     1096   X_chk-bonus.out-code COLUMN-LABEL "Номер_РН" FORMAT "X(14)":U
     1097   X_chk-bonus.src-d-card COLUMN-LABEL "№ Карты!для начисления" FORMAT "X(19)":U
     1098   X_chk-bonus.discnt-type COLUMN-LABEL "№ схемы!начисления"
     1099   X_chk-bonus.kateg COLUMN-LABEL "Код !валюты" FORMAT "->>>9"
     1100   X_chk-bonus.discnt-id COLUMN-LABEL "ID транзакц" FORMAT ">>>>>>>>9"
     1101       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.8 BY 20 FIT-LAST-COLUMN.
     1102   DEFINE FRAME Dialog-Frame
     1103        b-quit AT ROW 1 COL 1
     1104        b-mark AT ROW 1 COL 21 WIDGET-ID 52
     1105        b-sel AT ROW 1 COL 24 WIDGET-ID 54
     1106        b-chk-doc AT ROW 1 COL 41 WIDGET-ID 50
     1107        b-sch AT ROW 1 COL 92 WIDGET-ID 60
     1108        B-Help AT ROW 1 COL 95
     1109        br-bonus AT ROW 2 COL 1 WIDGET-ID 100
     1110        sch-code AT ROW 22.27 COL 17 COLON-ALIGNED WIDGET-ID 64
     1111        sch-date AT ROW 22.27 COL 44.5 COLON-ALIGNED WIDGET-ID 56
     1112        sch-sum AT ROW 22.27 COL 76 COLON-ALIGNED WIDGET-ID 66
     1113        mark-num AT ROW 1 COL 9 COLON-ALIGNED NO-LABEL WIDGET-ID 62
     1114        "Поиск по:" VIEW-AS TEXT
     1115             SIZE 11 BY 1.27 AT ROW 22 COL 1 WIDGET-ID 58
     1116             FGCOLOR 4
     1117        SPACE(87.75) SKIP(0.00)
     1118       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1119            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1120            TITLE ""
     1121            CANCEL-BUTTON b-quit.
     1122   ASSIGN
     1123          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1124          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1125   ON GO OF FRAME Dialog-Frame
     1126   DO:
     1127     p-rid-list = v-rid-list.
     1128   END.
     1129   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1130   DO:
     1131     APPLY "END-ERROR":U TO SELF.
     1132   END.
     1133   ON CHOOSE OF b-chk-doc IN FRAME Dialog-Frame
     1134   DO:
     1135   define variable next-prev as character no-undo .
     1136   define variable v-doc-rec as recid no-undo .
     1137   define variable v-chk-doc-rec as recid no-undo .
     1138   DEFINE BUFFER buf_chk-doc FOR ub.chk-doc.
     1139   assign
     1140   next-prev = '':U
     1141   v-chk-bonus-recid = (if available X_chk-bonus then recid(X_chk-bonus) else ?)
     1142   .
     1143   DO WHILE next-prev = '':U:
     1144       if NOT available X_chk-bonus then do:
     1145               message "Неправильно выбрана строка бонусов." view-as alert-box ERROR.
     1146               return no-apply.
     1147       end.
     1148       FIND FIRST buf_chk-doc NO-LOCK WHERE
     1149                  buf_chk-doc.doc-code = X_chk-bonus.doc-code.
     1150       v-chk-doc-rec = recid(buf_chk-doc).
     1151       run str/superchk.w
     1152                     (
     1153                        input parparentproc
     1154                       ,input 'ПРОСМОТР':U
     1155                       ,input buf_chk-doc.obj-type
     1156                       ,input buf_chk-doc.obj-code
     1157                       ,input-output v-chk-doc-rec
     1158                       ,input this-procedure:handle
     1159                       ,input-output next-prev
     1160                                   )
     1161       .
     1162   END .
     1163   reposition br-bonus to recid v-chk-bonus-recid no-error.
     1164   apply "entry" to br-bonus in frame Dialog-Frame.
     1165   apply "value-changed" to br-bonus in frame Dialog-Frame.
     1166   END.
     1167   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1168   DO:
     1169     define variable glog as logical no-undo .
     1170     if available X_chk-bonus then do:
     1171   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1172   define variable v-str-recid14 as character no-undo .
     1173   define variable v-num-entry14 as integer   no-undo .
     1174   assign
     1175     v-str-recid14 = trim( string( recid( X_chk-bonus ) , "->>>>>>>>>>>9":U ) )
     1176     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1177   .
     1178   if v-num-entry14 > 0 then do:
     1179     assign
     1180       entry( v-num-entry14, v-rid-list ) = "":U
     1181       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1182     .
     1183   end.
     1184   else do:
     1185     assign
     1186       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1187     .
     1188   end.
     1189       glog = br-bonus:refresh() .
     1190       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1191           glog = br-bonus:select-next-row ().
     1192           apply "VALUE-CHANGED" to br-bonus in frame Dialog-Frame.
     1193       end.
     1194       if num-entries( v-rid-list ) = 0
     1195       then
     1196           hide mark-num in frame Dialog-Frame.
     1197       else
     1198           display
     1199           num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1200     end.
     1201     apply "entry" to br-bonus in frame Dialog-Frame.
     1202   END.
     1203   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
     1204   DO:
     1205       run proc-b-sch in this-procedure no-error.
     1206     if error-status:error then return no-apply.
     1207   END.
     1208   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1209   DO:
     1210       if ( available X_chk-bonus ) AND ( v-rid-list = "" ) then
     1211       v-rid-list = string( recid( X_chk-bonus ) ) .
     1212   END.
     1213   ON CTRL-J OF sch-code IN FRAME Dialog-Frame
     1214   DO:
     1215       run proc-find-code in this-procedure ( input yes, input frame Dialog-Frame sch-code) no-error.
     1216     if error-status:error then return no-apply.
     1217   END.
     1218   ON RETURN OF sch-code IN FRAME Dialog-Frame
     1219   DO:
     1220       run proc-find-code in this-procedure ( input NO, input frame Dialog-Frame sch-code) no-error.
     1221     if error-status:error then return no-apply.
     1222   END.
     1223   ON CTRL-J OF sch-date IN FRAME Dialog-Frame
     1224   DO:
     1225       run proc-find-date in this-procedure ( input YES, input frame Dialog-Frame sch-date) no-error.
     1226     if error-status:error then return no-apply.
     1227   END.
     1228   ON RETURN OF sch-date IN FRAME Dialog-Frame
     1229   DO:
     1230     run proc-find-date in this-procedure ( input no, input frame Dialog-Frame sch-date) no-error.
     1231     if error-status:error then return no-apply.
     1232   END.
     1233   ON CTRL-J OF sch-sum IN FRAME Dialog-Frame
     1234   DO:
     1235       run proc-find-sum in this-procedure ( input NO, input frame Dialog-Frame sch-sum) no-error.
     1236     if error-status:error then return no-apply.
     1237   END.
     1238   ON RETURN OF sch-sum IN FRAME Dialog-Frame
     1239   DO:
     1240     run proc-find-sum in this-procedure ( input NO, input frame Dialog-Frame sch-sum) no-error.
     1241     if error-status:error then return no-apply.
     1242   END.
     1243   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1244   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1245   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1246   on help of frame Dialog-Frame
     1247   do:
     1248     run gbl/app_help.p
     1249       (input this-procedure :file-name
     1250       ,input ''
     1251       ,input ?
     1252       ) no-error.
     1253     if error-status :error then do:
     1254       message
     1255         "Ошибка при вызове помощи"
     1256         error-status :get-message(1)
     1257         view-as alert-box .
     1258     end.
     1259   end.
     1260   run minbtn-set in this-procedure .
     1261   on choose of b-help in frame Dialog-Frame
     1262   do:
     1263     apply "help":u to frame Dialog-Frame .
     1264   end.
     1265   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1266   procedure minbtn-set :
     1267       do
     1268           on error undo, return error return-value
     1269           :
     1270           define variable ii              as integer       no-undo .
     1271           define variable fh              as widget-handle no-undo .
     1272           define variable hh              as widget-handle no-undo .
     1273           define variable v-h             as handle        extent 4 no-undo .
     1274           define variable v-name-button   as character     no-undo .
     1275           define variable v-help-old-x    as decimal       no-undo .
     1276           define variable v-help-old-y    as decimal       no-undo .
     1277           define variable v-help-old-size as decimal       no-undo .
     1278           define variable v-frame-width   as decimal       no-undo .
     1279           define variable jj              as integer       no-undo .
     1280           do
     1281               on error undo, return error
     1282               :
     1283               assign
     1284                   v-frame-width = frame Dialog-Frame:width - 0.3
     1285                   fh            = frame Dialog-Frame:first-child
     1286                   hh            = fh:first-child
     1287                   ii            = 1
     1288                   .
     1289               do while valid-handle(hh):
     1290                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1291                   do:
     1292                       case lc(hh:name) :
     1293                           when "b-help" then
     1294                               do:
     1295                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1296                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1297                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1298                                   hh:TOOLTIP = "Помощь" .
     1299                                   v-help-old-x = hh:column .
     1300                                   v-help-old-y = hh:row    .
     1301                                   v-help-old-size = hh:width .
     1302                                   hh:width-chars = 2.5 .
     1303                               end.
     1304                           when "b-print" then
     1305                               do:
     1306                                   hh:load-image("cmp/b-print.bmp":u) .
     1307                                   hh:TOOLTIP = "Печать" .
     1308                                   v-h[ii] = hh:handle .
     1309                                   ii = ii + 1 .
     1310                                   hh:width-chars = 3 .
     1311                               end.
     1312                           when "b-history" or
     1313                           when "b-hist" then
     1314                               do:
     1315                                   hh:load-image("cmp/b-hist.bmp":u) .
     1316                                   hh:TOOLTIP = "История" .
     1317                                   v-h[ii] = hh:handle .
     1318                                   ii = ii + 1 .
     1319                                   hh:width-chars = 3 .
     1320                               end.
     1321                           when "b-sch" then
     1322                               do:
     1323                                   hh:load-image("cmp/b-sch.bmp":u) .
     1324                                   hh:TOOLTIP = "Установка Фильтра" .
     1325                                   v-h[ii] = hh:handle .
     1326                                   ii = ii + 1 .
     1327                                   hh:width-chars = 3 .
     1328                               end.
     1329                           when "b-hist-user" then
     1330                               do:
     1331                                   hh:load-image("cmp/b-hist.bmp":u) .
     1332                                   hh:TOOLTIP = "История пользователя" .
     1333                                   ii = ii + 1 .
     1334                               end.
     1335                       end case.
     1336                   end.
     1337                   hh = hh:next-sibling.
     1338               end.
     1339               b-help:column = v-frame-width - b-help:width-chars.
     1340               jj = 0.
     1341               repeat ii = 4 to 1 by -1 :
     1342                   if valid-handle (v-h[ii] ) then
     1343                   do:
     1344                       jj  = jj + 1 .
     1345                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1346                       v-h[ii]:row    = v-help-old-y .
     1347                   end.
     1348               end.
     1349           end.
     1350       end.
     1351   end procedure.
     1352   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1353   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1354   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1355   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1356   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1357   define variable v-diasize-current-frame-height as decimal   no-undo .
     1358   define variable v-diasize-change-size          as logical   no-undo .
     1359   define variable v-diasize-resize-button        as handle    no-undo .
     1360   define variable v-diasize-wndmax               as logical   no-undo .
     1361   define variable v-diasize-wndstore             as logical   no-undo .
     1362   define variable v-diasize-proc-name            as character no-undo .
     1363   define variable v-diasize-browse-handle        as handle    no-undo .
     1364   define variable v-diasize-browse-number        as integer   no-undo .
     1365   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1366   define temp-table temp-diasize-handle no-undo
     1367     field handle-value  as handle
     1368     field save-position as decimal
     1369     index xpk is primary unique handle-value
     1370     .
     1371   define temp-table temp-browse-handle no-undo
     1372     field browse-type   as character
     1373     field browse-number as integer
     1374     field browse-handle as handle
     1375     field original-size as decimal
     1376     index xpk is primary unique browse-type browse-number
     1377     index xie browse-type browse-handle
     1378   .
     1379   procedure diasize_change-height :
     1380     define input  parameter p-change-value  as decimal   no-undo .
     1381     define input  parameter p-move-resize   as logical   no-undo .
     1382     define variable v-field-group-handle    as handle    no-undo .
     1383     define variable v-object-handle         as handle    no-undo .
     1384     define variable v-frame-height          as decimal   no-undo .
     1385     define variable v-frame-virtual-height  as decimal   no-undo .
     1386     define variable v-browse-height         as decimal   no-undo .
     1387     define variable v-window-height         as decimal   no-undo .
     1388     define variable v-window-virtual-height as decimal   no-undo .
     1389     define variable v-change-sign           as integer   no-undo .
     1390     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1391     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1392     if p-change-value > 0
     1393     then do:
     1394       if frame Dialog-Frame :height + p-change-value
     1395           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1396       then do:
     1397         assign
     1398           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1399                           - (frame Dialog-Frame :height-chars)
     1400         .
     1401         if p-change-value <= 0
     1402         then do:
     1403           run diasize_position-resize-button in this-procedure .
     1404           return .
     1405         end.
     1406       end.
     1407     end.
     1408     if p-change-value < 0
     1409     then do:
     1410       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1411       then do:
     1412         assign
     1413           p-change-value = v-diasize-orig-frame-height
     1414                          - (frame Dialog-Frame :height-chars)
     1415         .
     1416         if p-change-value >= 0
     1417         then do:
     1418           run diasize_position-resize-button in this-procedure .
     1419           return .
     1420         end.
     1421       end.
     1422     end.
     1423     if p-change-value >= 0
     1424     then do:
     1425       assign
     1426         v-change-sign = 1
     1427       .
     1428     end.
     1429     else do:
     1430       assign
     1431         v-change-sign = -1
     1432       .
     1433     end.
     1434     assign
     1435       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1436     .
     1437     if p-change-value = 0
     1438     then do:
     1439       run diasize_position-resize-button in this-procedure .
     1440       return .
     1441     end.
     1442     move_block:
     1443     do
     1444     on error undo move_block, retry move_block
     1445     :
     1446       if retry
     1447       then do:
     1448         do
     1449         on error undo move_block, leave move_block
     1450         :
     1451           if p-change-value > 0
     1452           then do:
     1453             for each buf_temp-diasize-handle
     1454             on error undo, next
     1455             :
     1456               assign
     1457                 v-object-handle = buf_temp-diasize-handle.handle-value
     1458               .
     1459               if v-object-handle <> v-diasize-resize-button
     1460               then do:
     1461                 assign
     1462                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1463                 .
     1464               end.
     1465             end.
     1466             assign
     1467               v-diasize-browse-handle :height = v-browse-height
     1468             .
     1469             for each buf_temp-browse-handle
     1470               where buf_temp-browse-handle.browse-type = 'height':u
     1471             on error undo, next
     1472             :
     1473               assign
     1474                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1475               .
     1476             end.
     1477             assign
     1478               frame Dialog-Frame :height = v-frame-height
     1479             .
     1480             if frame Dialog-Frame :scrollable = true
     1481             then do:
     1482               assign
     1483                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1484               .
     1485             end.
     1486             run diasize_position-resize-button in this-procedure .
     1487           end.
     1488           else do:
     1489             if frame Dialog-Frame :scrollable = true
     1490             then do:
     1491               assign
     1492                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1493               .
     1494             end.
     1495             assign
     1496               frame Dialog-Frame :height = v-frame-height
     1497             .
     1498             assign
     1499               v-diasize-browse-handle :height = v-browse-height
     1500             .
     1501             for each buf_temp-browse-handle
     1502               where buf_temp-browse-handle.browse-type = 'height':u
     1503             on error undo, next
     1504             :
     1505               assign
     1506                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1507               .
     1508             end.
     1509             for each buf_temp-diasize-handle
     1510             on error undo, next
     1511             :
     1512               assign
     1513                 v-object-handle = buf_temp-diasize-handle.handle-value
     1514               .
     1515               if v-object-handle <> v-diasize-resize-button
     1516               then do:
     1517                 assign
     1518                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1519                 .
     1520               end.
     1521             end.
     1522             run diasize_position-resize-button in this-procedure .
     1523           end.
     1524           assign
     1525             v-diasize-change-size = false
     1526           .
     1527           leave move_block .
     1528         end.
     1529       end.
     1530       assign
     1531         v-diasize-need-full-display = true
     1532       .
     1533       if v-diasize-change-size = false
     1534       then do:
     1535         assign
     1536           v-diasize-change-size = true
     1537         .
     1538       end.
     1539       else do:
     1540         return .
     1541       end.
     1542       assign
     1543         v-frame-height = frame Dialog-Frame :height
     1544         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1545         v-browse-height = v-diasize-browse-handle :height
     1546       .
     1547       for each buf_temp-browse-handle
     1548         where buf_temp-browse-handle.browse-type = 'height':u
     1549       :
     1550         assign
     1551           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1552         .
     1553       end.
     1554       for each buf_temp-diasize-handle
     1555       :
     1556         delete buf_temp-diasize-handle .
     1557       end.
     1558       assign
     1559         v-field-group-handle = frame Dialog-Frame :first-child
     1560       .
     1561       do while valid-handle(v-field-group-handle)
     1562       :
     1563         assign
     1564           v-object-handle = v-field-group-handle :first-child
     1565         .
     1566         do while valid-handle(v-object-handle)
     1567         :
     1568           if  v-object-handle <> v-diasize-browse-handle :handle
     1569           and can-query(v-object-handle, "row")
     1570           and can-query(v-object-handle, "height")
     1571           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1572           then do:
     1573             find first buf_temp-browse-handle
     1574               where buf_temp-browse-handle.browse-type   = 'height':u
     1575                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1576               no-error .
     1577             if available buf_temp-browse-handle
     1578             then do:
     1579             end.
     1580             else do:
     1581               create buf_temp-diasize-handle .
     1582               assign
     1583                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1584                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1585               .
     1586             end.
     1587           end.
     1588           assign
     1589             v-object-handle = v-object-handle :next-sibling
     1590           .
     1591         end.
     1592         assign
     1593           v-field-group-handle = v-field-group-handle :next-sibling
     1594         .
     1595       end.
     1596       do with frame Dialog-Frame
     1597       :
     1598         hide v-diasize-resize-button .
     1599         assign
     1600           v-diasize-resize-button :row    = 1
     1601           v-diasize-resize-button :column = 1
     1602         .
     1603       end.
     1604       if p-change-value > 0
     1605       then do:
     1606         if frame Dialog-Frame :scrollable = true
     1607         then do:
     1608           assign
     1609             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1610             no-error .
     1611           if error-status :error
     1612           or error-status :get-message(1) <> ""
     1613           then do:
     1614             undo move_block, retry move_block .
     1615           end.
     1616         end.
     1617         assign
     1618           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1619           no-error .
     1620         if error-status :error
     1621         or error-status :get-message(1) <> ""
     1622         then do:
     1623           undo move_block, retry move_block .
     1624         end.
     1625         assign
     1626           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1627           no-error .
     1628         if error-status :error
     1629         or error-status :get-message(1) <> ""
     1630         then do:
     1631           undo move_block, retry move_block .
     1632         end.
     1633         for each buf_temp-browse-handle
     1634           where buf_temp-browse-handle.browse-type = 'height':u
     1635         on error undo move_block, retry move_block
     1636         :
     1637           assign
     1638             buf_temp-browse-handle.browse-handle :height
     1639               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1640             no-error .
     1641           if error-status :error
     1642           or error-status :get-message(1) <> ""
     1643           then do:
     1644             undo move_block, retry move_block .
     1645           end.
     1646         end.
     1647         for each buf_temp-diasize-handle
     1648         on error undo move_block, retry move_block
     1649         :
     1650           assign
     1651             v-object-handle = buf_temp-diasize-handle.handle-value
     1652           .
     1653           if v-object-handle <> v-diasize-resize-button
     1654           then do:
     1655             assign
     1656               v-object-handle :row = v-object-handle :row + p-change-value
     1657               no-error .
     1658             if error-status :error
     1659             or error-status :get-message(1) <> ""
     1660             then do:
     1661               undo move_block, retry move_block .
     1662             end.
     1663           end.
     1664         end.
     1665       end.
     1666       else do:
     1667         for each buf_temp-diasize-handle
     1668         on error undo move_block, retry move_block
     1669         :
     1670           assign
     1671             v-object-handle = buf_temp-diasize-handle.handle-value
     1672           .
     1673           if v-object-handle <> v-diasize-resize-button
     1674           then do:
     1675             assign
     1676               v-object-handle :row = v-object-handle :row + p-change-value
     1677               no-error .
     1678             if error-status :error
     1679             or error-status :get-message(1) <> ""
     1680             then do:
     1681               undo move_block, retry move_block .
     1682             end.
     1683           end.
     1684         end.
     1685         assign
     1686           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1687           no-error .
     1688         if error-status :error
     1689         or error-status :get-message(1) <> ""
     1690         then do:
     1691           undo move_block, retry move_block .
     1692         end.
     1693         for each buf_temp-browse-handle
     1694           where buf_temp-browse-handle.browse-type = 'height':u
     1695         on error undo move_block, retry move_block
     1696         :
     1697           assign
     1698             buf_temp-browse-handle.browse-handle :height
     1699               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1700             no-error .
     1701           if error-status :error
     1702           or error-status :get-message(1) <> ""
     1703           then do:
     1704             undo move_block, retry move_block .
     1705           end.
     1706         end.
     1707         assign
     1708           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1709           no-error .
     1710         if error-status :error
     1711         or error-status :get-message(1) <> ""
     1712         then do:
     1713           undo move_block, retry move_block .
     1714         end.
     1715         if frame Dialog-Frame :scrollable = true
     1716         then do:
     1717           assign
     1718             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1719             no-error .
     1720           if error-status :error
     1721           or error-status :get-message(1) <> ""
     1722           then do:
     1723             undo move_block, retry move_block .
     1724           end.
     1725         end.
     1726       end.
     1727       if p-move-resize = true
     1728       then do:
     1729         run diasize_position-resize-button in this-procedure .
     1730       end.
     1731       if v-diasize-wndstore = true
     1732       then do:
     1733         if connected("ub") = true
     1734         then do:
     1735           define variable v-cntxt-db-num        as integer   no-undo .
     1736           define variable v-cntxt-userid        as character no-undo .
     1737           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1738                                             , OUTPUT v-cntxt-userid
     1739                                             ) .
     1740           run gbl/wndsizew.p
     1741             (input  v-cntxt-db-num
     1742             ,input  v-cntxt-userid
     1743             ,input  v-diasize-proc-name
     1744             ,input  'height':u
     1745             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1746             ) .
     1747         end.
     1748       end.
     1749     end.
     1750     assign
     1751       v-diasize-change-size = false
     1752     .
     1753   end procedure.
     1754   procedure diasize_set-height :
     1755     define input  parameter p-new-height  as decimal   no-undo .
     1756     define input  parameter p-move-resize as logical   no-undo .
     1757     do
     1758     on error undo, return error return-value
     1759     :
     1760       run diasize_change-height in this-procedure
     1761         (input  (p-new-height - frame Dialog-Frame :height)
     1762         ,input  p-move-resize
     1763         ) .
     1764     end.
     1765   end procedure.
     1766   procedure diasize_change-width :
     1767     define input  parameter p-change-value as decimal   no-undo .
     1768     define input  parameter p-move-resize  as logical   no-undo .
     1769     define variable v-field-group-handle   as handle    no-undo .
     1770     define variable v-object-handle        as handle    no-undo .
     1771     define variable v-frame-width          as decimal   no-undo .
     1772     define variable v-frame-virtual-width  as decimal   no-undo .
     1773     define variable v-browse-width         as decimal   no-undo .
     1774     define variable v-window-width         as decimal   no-undo .
     1775     define variable v-window-virtual-width as decimal   no-undo .
     1776     define variable v-change-sign          as integer   no-undo .
     1777     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1778     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1779     if p-change-value > 0
     1780     then do:
     1781       if frame Dialog-Frame :width + p-change-value >
     1782           session :width-chars
     1783       then do:
     1784         assign
     1785           p-change-value = session :width-chars - frame Dialog-Frame :width
     1786         .
     1787         if p-change-value <= 0
     1788         then do:
     1789           run diasize_position-resize-button in this-procedure .
     1790           return .
     1791         end.
     1792       end.
     1793     end.
     1794     if p-change-value < 0
     1795     then do:
     1796       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1797       then do:
     1798         assign
     1799           p-change-value = v-diasize-orig-frame-width
     1800                          - frame Dialog-Frame :width
     1801         .
     1802         if p-change-value >= 0
     1803         then do:
     1804           run diasize_position-resize-button in this-procedure .
     1805           return .
     1806         end.
     1807       end.
     1808     end.
     1809     if p-change-value >= 0
     1810     then do:
     1811       assign
     1812         v-change-sign = 1
     1813       .
     1814     end.
     1815     else do:
     1816       assign
     1817         v-change-sign = -1
     1818       .
     1819     end.
     1820     assign
     1821       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1822     .
     1823     if p-change-value = 0
     1824     then do:
     1825       run diasize_position-resize-button in this-procedure .
     1826       return .
     1827     end.
     1828     move_block:
     1829     do
     1830     on error undo move_block, leave move_block
     1831     :
     1832       if retry
     1833       then do:
     1834         do
     1835         on error undo move_block, leave move_block
     1836         :
     1837           if p-change-value > 0
     1838           then do:
     1839             for each buf_temp-diasize-handle
     1840             on error undo, next
     1841             :
     1842               assign
     1843                 v-object-handle = buf_temp-diasize-handle.handle-value
     1844               .
     1845               if v-object-handle <> v-diasize-resize-button
     1846               then do:
     1847                 assign
     1848                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1849                 .
     1850               end.
     1851             end.
     1852             assign
     1853               v-diasize-browse-handle :width = v-browse-width
     1854             .
     1855             for each buf_temp-browse-handle
     1856               where buf_temp-browse-handle.browse-type = 'width':u
     1857             on error undo, next
     1858             :
     1859               assign
     1860                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1861               .
     1862             end.
     1863             assign
     1864               frame Dialog-Frame :width = v-frame-width
     1865             .
     1866             if frame Dialog-Frame :scrollable = true
     1867             then do:
     1868               assign
     1869                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1870               .
     1871             end.
     1872             run diasize_position-resize-button in this-procedure .
     1873           end.
     1874           else do:
     1875             if frame Dialog-Frame :scrollable = true
     1876             then do:
     1877               assign
     1878                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1879               .
     1880             end.
     1881             assign
     1882               frame Dialog-Frame :width = v-frame-width
     1883             .
     1884             for each buf_temp-browse-handle
     1885               where buf_temp-browse-handle.browse-type = 'width':u
     1886             on error undo, next
     1887             :
     1888               assign
     1889                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1890               .
     1891             end.
     1892             assign
     1893               v-diasize-browse-handle :width = v-browse-width
     1894             .
     1895             for each buf_temp-diasize-handle
     1896             on error undo, next
     1897             :
     1898               assign
     1899                 v-object-handle = buf_temp-diasize-handle.handle-value
     1900               .
     1901               if v-object-handle <> v-diasize-resize-button
     1902               then do:
     1903                 assign
     1904                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1905                 .
     1906               end.
     1907             end.
     1908             run diasize_position-resize-button in this-procedure .
     1909           end.
     1910           assign
     1911             v-diasize-change-size = false
     1912           .
     1913           leave move_block .
     1914         end.
     1915       end.
     1916       assign
     1917         v-diasize-need-full-display = true
     1918       .
     1919       if v-diasize-change-size = false
     1920       then do:
     1921         assign
     1922           v-diasize-change-size = true
     1923         .
     1924       end.
     1925       else do:
     1926         return .
     1927       end.
     1928       assign
     1929         v-frame-width = frame Dialog-Frame :width
     1930         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1931         v-browse-width = v-diasize-browse-handle :width
     1932       .
     1933       for each buf_temp-browse-handle
     1934         where buf_temp-browse-handle.browse-type = 'width':u
     1935       :
     1936         assign
     1937           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1938         .
     1939       end.
     1940       for each buf_temp-diasize-handle
     1941       :
     1942         delete buf_temp-diasize-handle .
     1943       end.
     1944       assign
     1945         v-field-group-handle = frame Dialog-Frame :first-child
     1946       .
     1947       do while valid-handle(v-field-group-handle)
     1948       :
     1949         assign
     1950           v-object-handle = v-field-group-handle :first-child
     1951         .
     1952         do while valid-handle(v-object-handle)
     1953         :
     1954           if  v-object-handle <> v-diasize-browse-handle :handle
     1955           and v-object-handle <> v-diasize-resize-button
     1956           and can-query(v-object-handle, "row")
     1957           and can-query(v-object-handle, "height")
     1958           and ( v-object-handle :col + v-object-handle :width
     1959                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1960               )
     1961           then do:
     1962             find first buf_temp-browse-handle
     1963               where buf_temp-browse-handle.browse-type   = 'width':u
     1964                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1965               no-error .
     1966             if available buf_temp-browse-handle
     1967             then do:
     1968             end.
     1969             else do:
     1970               create buf_temp-diasize-handle .
     1971               assign
     1972                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1973                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1974               .
     1975             end.
     1976           end.
     1977           assign
     1978             v-object-handle = v-object-handle :next-sibling
     1979           .
     1980         end.
     1981         assign
     1982           v-field-group-handle = v-field-group-handle :next-sibling
     1983         .
     1984       end.
     1985       do with frame Dialog-Frame
     1986       :
     1987         hide v-diasize-resize-button .
     1988         v-diasize-resize-button :row = 1.
     1989         v-diasize-resize-button :column = 1.
     1990       end.
     1991       if p-change-value > 0
     1992       then do:
     1993         if frame Dialog-Frame :scrollable = true
     1994         then do:
     1995           assign
     1996             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1997             no-error .
     1998           if error-status :error
     1999           or error-status :get-message(1) <> ""
     2000           then do:
     2001             undo move_block, retry move_block.
     2002           end.
     2003         end.
     2004         assign
     2005           frame Dialog-Frame :width = v-frame-width + p-change-value
     2006           no-error .
     2007         if error-status :error
     2008         or error-status :get-message(1) <> ""
     2009         then do:
     2010           undo move_block, retry move_block.
     2011         end.
     2012         assign
     2013           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2014         no-error .
     2015         if error-status :error
     2016         or error-status :get-message(1) <> ""
     2017         then do:
     2018           undo move_block, retry move_block.
     2019         end.
     2020         for each buf_temp-browse-handle
     2021           where buf_temp-browse-handle.browse-type = 'width':u
     2022         on error undo move_block, retry move_block
     2023         :
     2024           assign
     2025             buf_temp-browse-handle.browse-handle :width
     2026               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2027             no-error .
     2028           if error-status :error
     2029           or error-status :get-message(1) <> ""
     2030           then do:
     2031             undo move_block, retry move_block .
     2032           end.
     2033         end.
     2034         for each buf_temp-diasize-handle
     2035         on error undo move_block, retry move_block
     2036         :
     2037           assign
     2038             v-object-handle = buf_temp-diasize-handle.handle-value
     2039           .
     2040           if v-object-handle <> v-diasize-resize-button
     2041           then do:
     2042             assign
     2043               v-object-handle :col = v-object-handle :col + p-change-value
     2044               no-error .
     2045             if error-status :error
     2046             or error-status :get-message(1) <> ""
     2047             then do:
     2048               undo move_block, retry move_block .
     2049             end.
     2050           end.
     2051         end.
     2052       end.
     2053       else do:
     2054         for each buf_temp-diasize-handle
     2055         on error undo move_block, retry move_block
     2056         :
     2057           assign
     2058             v-object-handle = buf_temp-diasize-handle.handle-value
     2059           .
     2060           if v-object-handle <> v-diasize-resize-button
     2061           then do:
     2062             assign
     2063               v-object-handle :col = v-object-handle :col + p-change-value
     2064               no-error .
     2065             if error-status :error
     2066             or error-status :get-message(1) <> ""
     2067             then do:
     2068               undo move_block, retry move_block .
     2069             end.
     2070           end.
     2071         end.
     2072         for each buf_temp-browse-handle
     2073           where buf_temp-browse-handle.browse-type = 'width':u
     2074         on error undo move_block, retry move_block
     2075         :
     2076           assign
     2077             buf_temp-browse-handle.browse-handle :width
     2078               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2079             no-error .
     2080           if error-status :error
     2081           or error-status :get-message(1) <> ""
     2082           then do:
     2083             undo move_block, retry move_block .
     2084           end.
     2085         end.
     2086         assign
     2087           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2088           no-error .
     2089         if error-status :error
     2090         or error-status :get-message(1) <> ""
     2091         then do:
     2092           undo move_block, retry move_block.
     2093         end.
     2094         assign
     2095           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2096         no-error .
     2097         if error-status :error
     2098         or error-status :get-message(1) <> ""
     2099         then do:
     2100           undo move_block, retry move_block.
     2101         end.
     2102         if frame Dialog-Frame :scrollable = true
     2103         then do:
     2104           assign
     2105             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2106           no-error .
     2107           if error-status :error
     2108           or error-status :get-message(1) <> ""
     2109           then do:
     2110             undo move_block, retry move_block.
     2111           end.
     2112         end.
     2113       end.
     2114       if p-move-resize
     2115       then do:
     2116         run diasize_position-resize-button in this-procedure .
     2117       end.
     2118       if v-diasize-wndstore = true
     2119       then do:
     2120         if connected("ub") = true
     2121         then do:
     2122           define variable v-cntxt-db-num        as integer   no-undo .
     2123           define variable v-cntxt-userid        as character no-undo .
     2124           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2125                                             , OUTPUT v-cntxt-userid
     2126                                             ) .
     2127           run gbl/wndsizew.p
     2128             (input  v-cntxt-db-num
     2129             ,input  v-cntxt-userid
     2130             ,input  v-diasize-proc-name
     2131             ,input  'width':u
     2132             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2133             ) .
     2134         end.
     2135       end.
     2136     end.
     2137     assign
     2138       v-diasize-change-size = false
     2139     .
     2140   end procedure.
     2141   procedure diasize_set-width :
     2142     define input  parameter p-new-width  as decimal   no-undo .
     2143     define input  parameter p-move-resize as logical   no-undo .
     2144     do
     2145     on error undo, return error return-value
     2146     :
     2147       run diasize_change-width in this-procedure
     2148         (input  (p-new-width - frame Dialog-Frame :width)
     2149         ,input  p-move-resize
     2150         ) .
     2151     end.
     2152   end procedure.
     2153   procedure diasize_position-resize-button :
     2154     do with frame Dialog-Frame
     2155     :
     2156       hide v-diasize-resize-button .
     2157       assign
     2158         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2159                     - 1
     2160                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2161         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2162                     - 1
     2163                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2164       .
     2165       view v-diasize-resize-button .
     2166     end.
     2167   end procedure.
     2168   on alt-right anywhere
     2169   do:
     2170     run diasize_change-width in this-procedure
     2171       (input 1
     2172       ,input true
     2173       ) .
     2174     return no-apply .
     2175   end.
     2176   on alt-left anywhere
     2177   do:
     2178     run diasize_change-width in this-procedure
     2179       (input -1
     2180       ,input true
     2181       ) .
     2182     return no-apply .
     2183   end.
     2184   on alt-down anywhere
     2185   do:
     2186     run diasize_change-height in this-procedure
     2187       (input 1
     2188       ,input true
     2189       ) .
     2190     return no-apply .
     2191   end.
     2192   on alt-up anywhere
     2193   do:
     2194     run diasize_change-height in this-procedure
     2195       (input -1
     2196       ,input true
     2197       ) .
     2198     return no-apply .
     2199   end.
     2200   on alt-enter of frame Dialog-Frame
     2201   do:
     2202     run diasize_maximize in this-procedure
     2203       (input  ?
     2204       ).
     2205     return no-apply .
     2206   end.
     2207   procedure diasize_end-move :
     2208     do
     2209     on error undo, return error return-value
     2210     :
     2211       define variable v-row-delta as decimal   no-undo .
     2212       define variable v-col-delta as decimal   no-undo .
     2213       define variable v-new-row as decimal   no-undo .
     2214       define variable v-new-col as decimal   no-undo .
     2215       assign
     2216         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2217         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2218       .
     2219       assign
     2220         v-row-delta = v-new-row - frame Dialog-Frame :height
     2221         v-col-delta = v-new-col - frame Dialog-Frame :width
     2222       .
     2223       run diasize_change-height in this-procedure
     2224         (input v-row-delta
     2225         ,input true
     2226         ) .
     2227       run diasize_change-width in this-procedure
     2228         (input v-col-delta
     2229         ,input true
     2230         ) .
     2231     end.
     2232   end procedure.
     2233   procedure diasize_maximize :
     2234     define input  parameter p-action as logical   no-undo .
     2235     do
     2236     on error undo, return error return-value
     2237     :
     2238       if p-action = ?
     2239       then do:
     2240         if v-diasize-need-maximize = true
     2241         then do:
     2242           assign
     2243             p-action = true
     2244           .
     2245         end.
     2246         else do:
     2247           assign
     2248             p-action = false
     2249           .
     2250         end.
     2251       end.
     2252       if p-action = true
     2253       then do:
     2254         run diasize_change-height in this-procedure
     2255           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2256               - frame Dialog-Frame :height-chars
     2257           ,input true
     2258           ) .
     2259         run diasize_change-width in this-procedure
     2260           (input session :width-chars
     2261               - frame Dialog-Frame :width-chars
     2262           ,input true
     2263           ) .
     2264         assign
     2265           v-diasize-need-maximize = false
     2266         .
     2267       end.
     2268       else do:
     2269         run diasize_change-width in this-procedure
     2270           (input v-diasize-orig-frame-width
     2271               - frame Dialog-Frame :width-chars
     2272           ,input true
     2273           ) .
     2274         run diasize_change-height in this-procedure
     2275           (input v-diasize-orig-frame-height
     2276               - frame Dialog-Frame :height-chars
     2277           ,input true
     2278           ) .
     2279         assign
     2280           v-diasize-need-maximize = true
     2281         .
     2282       end.
     2283     end.
     2284   end procedure.
     2285   procedure diasize_restore-orig-size :
     2286     do
     2287     on error undo, return error return-value
     2288     :
     2289       assign
     2290         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2291         v-diasize-current-frame-height = frame Dialog-Frame :height
     2292       .
     2293       run diasize_set-height in this-procedure
     2294         (input  v-diasize-orig-frame-height
     2295         ,input  true
     2296         ) .
     2297       run diasize_set-width in this-procedure
     2298         (input  v-diasize-orig-frame-width
     2299         ,input  true
     2300         ) .
     2301     end.
     2302   end procedure.
     2303   procedure diasize_restore-current-size :
     2304     do
     2305     on error undo, return error return-value
     2306     :
     2307       run diasize_set-height in this-procedure
     2308         (input  v-diasize-current-frame-height
     2309         ,input  true
     2310         ) .
     2311       run diasize_set-width in this-procedure
     2312         (input  v-diasize-current-frame-width
     2313         ,input  true
     2314         ) .
     2315     end.
     2316   end procedure.
     2317   procedure diasize_set-browse-handle :
     2318     define input  parameter p-browse-handle as handle   no-undo .
     2319     define buffer buf_temp-browse-handle for temp-browse-handle .
     2320     do
     2321     on error undo, return error return-value
     2322     :
     2323       assign
     2324         v-diasize-browse-handle = p-browse-handle
     2325       .
     2326       for each buf_temp-browse-handle
     2327       on error undo, return error return-value
     2328       :
     2329         delete buf_temp-browse-handle .
     2330       end.
     2331     end.
     2332   end procedure.
     2333   procedure diasize_add_browse :
     2334     define input  parameter p-browse-type   as character no-undo .
     2335     define input  parameter p-browse-handle as handle    no-undo .
     2336     define buffer buf_temp-browse-handle for temp-browse-handle .
     2337     do
     2338     on error undo, return error return-value
     2339     :
     2340       assign
     2341         v-diasize-browse-number = v-diasize-browse-number + 1
     2342       .
     2343       create buf_temp-browse-handle .
     2344       assign
     2345         buf_temp-browse-handle.browse-type   = p-browse-type
     2346         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2347         buf_temp-browse-handle.browse-handle = p-browse-handle
     2348       .
     2349     end.
     2350   end procedure.
     2351   procedure diasize_init :
     2352     define variable v-default-value    as logical   no-undo .
     2353     define variable v-restore-saved    as logical   no-undo .
     2354     define variable v-resize-value-str as character no-undo .
     2355     do
     2356     on error undo, return error return-value
     2357     :
     2358       do with frame Dialog-Frame
     2359       :
     2360         assign
     2361           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2362           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2363           v-diasize-browse-handle     = browse br-bonus :handle
     2364         .
     2365         create button v-diasize-resize-button
     2366         assign
     2367           parent        = frame Dialog-Frame :first-child
     2368           label         = "s"
     2369           height-pixels = 16
     2370           width-pixels  = 16
     2371           visible       = true
     2372           sensitive     = true
     2373           movable       = true
     2374           triggers:
     2375             on end-move persistent run diasize_end-move in this-procedure .
     2376           end triggers.
     2377         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2378         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2379         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2380         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2381         assign
     2382           v-diasize-wndmax = false
     2383         .
     2384         if connected("ub") = true
     2385         then do:
     2386           define variable v-cntxt-db-num        as integer   no-undo .
     2387           define variable v-cntxt-userid        as character no-undo .
     2388           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2389                                             , OUTPUT v-cntxt-userid
     2390                                             ) .
     2391           run gbl/wndpar_r.p
     2392             (input  v-cntxt-db-num
     2393             ,input  v-cntxt-userid
     2394             ,input  'wndmax':U
     2395             ,output v-diasize-wndmax
     2396             ,output v-default-value
     2397             ) .
     2398         end.
     2399         assign
     2400           v-diasize-wndstore = false
     2401         .
     2402         if connected("ub") = true
     2403         then do:
     2404           run gbl/wndpar_r.p
     2405             (input  v-cntxt-db-num
     2406             ,input  v-cntxt-userid
     2407             ,input  'wndstore':U
     2408             ,output v-diasize-wndstore
     2409             ,output v-default-value
     2410             ) .
     2411         end.
     2412         assign
     2413           v-diasize-proc-name = entry(1, program-name(2), '.')
     2414         .
     2415         if v-diasize-wndstore = true
     2416         then do:
     2417           assign
     2418             v-restore-saved = false
     2419           .
     2420           if connected("ub") = true
     2421           then do:
     2422             run gbl/wndsizer.p
     2423               (input  v-cntxt-db-num
     2424               ,input  v-cntxt-userid
     2425               ,input  v-diasize-proc-name
     2426               ,input  'height':u
     2427               ,output v-resize-value-str
     2428               ) .
     2429             if v-resize-value-str <> '':U
     2430             then do:
     2431               run diasize_change-height in this-procedure
     2432                 (input  integer(v-resize-value-str)
     2433                 ,input  true
     2434                 ) .
     2435               assign
     2436                 v-restore-saved = true
     2437               .
     2438             end.
     2439           end.
     2440           if connected("ub") = true
     2441           then do:
     2442             run gbl/wndsizer.p
     2443               (input  v-cntxt-db-num
     2444               ,input  v-cntxt-userid
     2445               ,input  v-diasize-proc-name
     2446               ,input  'width':u
     2447               ,output v-resize-value-str
     2448               ) .
     2449             if v-resize-value-str <> '':U
     2450             then do:
     2451               run diasize_change-width in this-procedure
     2452                 (input  integer(v-resize-value-str)
     2453                 ,input  true
     2454                 ) .
     2455               assign
     2456                 v-restore-saved = true
     2457               .
     2458             end.
     2459           end.
     2460           if v-restore-saved <> true
     2461           then do:
     2462             if v-diasize-wndmax = true
     2463             then do:
     2464               run diasize_maximize in this-procedure
     2465                 (input  true
     2466                 ) .
     2467             end.
     2468           end.
     2469         end.
     2470         else do:
     2471           if v-diasize-wndmax = true
     2472           then do:
     2473             run diasize_maximize in this-procedure
     2474               (input  true
     2475               ) .
     2476           end.
     2477         end.
     2478       end.
     2479     end.
     2480   end procedure.
     2481   procedure diasize_need-full-display :
     2482     define output parameter p-need-full-display as logical   no-undo .
     2483     do
     2484     on error undo, return error return-value
     2485     :
     2486       assign
     2487         p-need-full-display = v-diasize-need-full-display
     2488       .
     2489       assign
     2490         v-diasize-need-full-display = false
     2491       .
     2492     end.
     2493   end procedure.
     2494   procedure get-context :
     2495      define output parameter p-db-num as integer          no-undo.
     2496      define output parameter p-user-id as character        no-undo.
     2497      define variable v-login               as character    no-undo.
     2498      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2499      define buffer buf_user-login  for ub.user-login .
     2500      do
     2501      on error undo, return error
     2502      :
     2503            FIND FIRST buf_sys-ctrl no-lock.
     2504            ASSIGN
     2505               v-login = USERID("ub")
     2506               p-db-num = buf_sys-ctrl.db-num
     2507            .
     2508            FIND FIRST buf_user-login
     2509                 WHERE buf_user-login.db-num = p-db-num
     2510                   AND buf_user-login.user-login = v-login
     2511                 no-lock
     2512                 no-error
     2513                 .
     2514            IF AVAILABLE buf_user-login
     2515            THEN DO:
     2516               assign
     2517                  p-user-id = buf_user-login.user-id
     2518               .
     2519            END.
     2520      end.
     2521   end procedure.
     2522       run diasize_init in this-procedure .
