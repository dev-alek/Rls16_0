     1022   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1023   procedure cur-time :
     1024      define output parameter p-today as date      no-undo .
     1025      define output parameter p-time  as integer   no-undo .
     1026     do
     1027     on error undo, return error
     1028     :
     1029       define variable v-date1 as date      no-undo .
     1030       define variable v-date2 as date      no-undo .
     1031       define variable v-time  as integer   no-undo .
     1032       assign
     1033         v-date1 = today
     1034         v-time  = time
     1035         v-date2 = today
     1036       .
     1037       if v-date1 <> v-date2
     1038       then do:
     1039         assign
     1040           v-date1 = today
     1041           v-time  = v-time
     1042         .
     1043       end.
     1044       assign
     1045         p-today = v-date1
     1046         p-time  = v-time
     1047       .
     1048     end.
     1049   end.
     1050   function cur-time-date returns character
     1051   :
     1052     return string(today, '99/99/9999':U) .
     1053   end.
     1054   function cur-time-mjd returns decimal
     1055   :
     1056     define variable v-date as date      no-undo .
     1057     define variable v-time as integer   no-undo .
     1058     run cur-time in this-procedure
     1059       (output v-date
     1060       ,output v-time
     1061       ) .
     1062     return integer(v-date) - 2400002 + (v-time / 86400) .
     1063   end.
     1064   function cur-time-get-ending-index returns integer
     1065   (input p-number as integer
     1066   )
     1067   :
     1068     if p-number < 0
     1069     or p-number = ?
     1070     then do:
     1071       return 1 .
     1072     end.
     1073     define variable v-rest as integer   no-undo .
     1074     assign
     1075       p-number = p-number modulo 100
     1076     .
     1077     if p-number < 20
     1078     then do:
     1079       assign
     1080         v-rest = p-number
     1081       .
     1082     end.
     1083     else do:
     1084       assign
     1085         v-rest = p-number modulo 10
     1086       .
     1087     end.
     1088     case v-rest :
     1089       when 1
     1090       then do:
     1091         return 2 .
     1092       end.
     1093       when 2 or
     1094       when 3 or
     1095       when 4
     1096       then do:
     1097         return 3 .
     1098       end.
     1099       otherwise do:
     1100         return 1 .
     1101       end.
     1102     end case .
     1103   end.
     1104   procedure cur-time-mjd-to-date :
     1105      define input  parameter i-mjd-diff as decimal no-undo.
     1106      define output parameter o-Date     as date    no-undo.
     1107      define output parameter o-Time     as integer no-undo.
     1108      define variable v-day-number as integer   no-undo .
     1109      if    i-mjd-diff < 0
     1110         or i-mjd-diff = ?
     1111      then do:
     1112         return "?" .
     1113      end.
     1114      assign
     1115         v-day-number = truncate(i-mjd-diff,0).
     1116         o-Date = date(v-day-number + 2400002).
     1117         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1118     .
     1119   end.
     1120   function cur-time-mjd-to-string returns character
     1121   (input p-mjd-diff as decimal
     1122   )
     1123   :
     1124     define variable v-day-number as integer   no-undo .
     1125     define variable v-seconds    as integer   no-undo .
     1126     define variable v-hour       as integer   no-undo .
     1127     define variable v-min        as integer   no-undo .
     1128     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1129     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1130     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1131     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1132     if p-mjd-diff < 0
     1133     or p-mjd-diff = ?
     1134     then do:
     1135       return "?" .
     1136     end.
     1137     assign
     1138       v-day-number = integer(truncate(p-mjd-diff,0))
     1139       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1140     .
     1141     if v-seconds > 86400
     1142     then do:
     1143       assign
     1144         v-seconds = 86400 - 1
     1145       .
     1146     end.
     1147     if v-seconds < 0
     1148     then do:
     1149       assign
     1150         v-seconds = 0
     1151       .
     1152     end.
     1153     assign
     1154       v-hour = truncate(v-seconds / 3600, 0)
     1155     .
     1156     assign
     1157       v-seconds = v-seconds modulo 3600
     1158     .
     1159     assign
     1160       v-min = truncate(v-seconds / 60, 0)
     1161     .
     1162     assign
     1163       v-seconds = v-seconds modulo 60
     1164     .
     1165     return
     1166         (if v-day-number <> 0
     1167           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1168           else ""
     1169         )
     1170       + (if v-day-number <> 0 or v-hour <> 0
     1171           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1172           else ""
     1173         )
     1174       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1175           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1176           else ""
     1177         )
     1178       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1179       .
     1180   end.
     1181   function cur-time-string returns character
     1182   :
     1183     define variable v-date as date      no-undo .
     1184     define variable v-time as integer   no-undo .
     1185     run cur-time in this-procedure
     1186       (output v-date
     1187       ,output v-time
     1188       ) .
     1189     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1190   end.
     1191   function cur-time-string-sec returns character
     1192   :
     1193     define variable v-date as date      no-undo .
     1194     define variable v-time as integer   no-undo .
     1195     run cur-time in this-procedure
     1196       (output v-date
     1197       ,output v-time
     1198       ) .
     1199     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1200   end.
     1201   function cur-time-custom  returns character
     1202   (input p-prefix as character
     1203   ,input p-date-format as character
     1204   ,input p-delimiter as character
     1205   ,input p-time-format as character
     1206   ,input p-suffix as character
     1207   )
     1208   :
     1209     define variable v-date as date      no-undo .
     1210     define variable v-time as integer   no-undo .
     1211     run cur-time in this-procedure
     1212       (output v-date
     1213       ,output v-time
     1214       ) .
     1215     return
     1216       p-prefix
     1217       + string(v-date, p-date-format)
     1218       + p-delimiter
     1219       + string(v-time, p-time-format)
     1220       + p-suffix
     1221       .
     1222   end.
     1223   function cur-time-print  returns character
     1224   :
     1225     define variable v-date as date      no-undo .
     1226     define variable v-time as integer   no-undo .
     1227     run cur-time in this-procedure
     1228       (output v-date
     1229       ,output v-time
     1230       ) .
     1231     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1232   end.
     1233   function cur-time-datetime returns datetime
     1234   :
     1235     define variable v-char as character no-undo .
     1236     define variable v-datetime as datetime no-undo .
     1237     v-char = cur-time-string().
     1238     v-datetime = datetime(v-char).
     1239     return  v-datetime.
     1240   end.
     1241   function cur-time-string-msec returns character
     1242   :
     1243     define variable v-date as datetime  no-undo .
     1244     v-date = now.
     1245     return string(v-date) .
     1246   end.
     1247   define variable vss-include-info6 as character format "X(65)" no-undo
     1248   initial "@(#)$Workfile$ $Revision$".
     1249   procedure xmlchar-test :
     1250   define input parameter p-in-string          as character        no-undo.
     1251   define output parameter p-out-string-enc    as character        no-undo.
     1252   define output parameter p-out-string-dec    as character        no-undo.
     1253   do
     1254   on error undo, return error
     1255   :
     1256          run xmlchar-encode in this-procedure
     1257       (
     1258             input p-in-string
     1259           , output p-out-string-enc
     1260       ).
     1261          run xmlchar-decode in this-procedure
     1262       (
     1263             input p-out-string-enc
     1264           , output p-out-string-dec
     1265       ).
     1266   end.
     1267   end .
     1268   procedure xmlchar-encode :
     1269   define input parameter p-in-string      as character        no-undo.
     1270   define output parameter p-out-string    as character        no-undo.
     1271       define variable v-position      as integer      no-undo.
     1272       define variable v-current-char  as character    no-undo.
     1273   do
     1274   on error undo, return error
     1275   :
     1276       assign
     1277           p-out-string = "":U
     1278       .
     1279       case p-in-string
     1280       :
     1281           when ?
     1282           then do:
     1283               assign
     1284                   p-out-string = "?":U
     1285               .
     1286           end.
     1287           when "?":U
     1288           then do:
     1289               assign
     1290                   p-out-string = "&#63;":U
     1291               .
     1292           end.
     1293           otherwise do:
     1294               do v-position = 1 to length( p-in-string )
     1295               :
     1296                   assign
     1297                       v-current-char = substring( p-in-string, v-position, 1 )
     1298                   .
     1299                   case v-current-char
     1300                   :
     1301                       when "&":U
     1302                       then do:
     1303                           assign
     1304                               p-out-string = p-out-string + "&amp;":U
     1305                           .
     1306                       end.
     1307                       when ">":U
     1308                       then do:
     1309                           assign
     1310                               p-out-string = p-out-string + "&gt;":U
     1311                           .
     1312                       end.
     1313                       when "<":U
     1314                       then do:
     1315                           assign
     1316                               p-out-string = p-out-string + "&lt;":U
     1317                           .
     1318                       end.
     1319                       when "'":U
     1320                       then do:
     1321                           assign
     1322                               p-out-string = p-out-string + "&apos;":U
     1323                           .
     1324                       end.
     1325                       when '"':U
     1326                       then do:
     1327                           assign
     1328                               p-out-string = p-out-string + "&quot;":U
     1329                           .
     1330                       end.
     1331                       when chr(1)
     1332                       then do:
     1333                           assign
     1334                               p-out-string = p-out-string + "":U
     1335                           .
     1336                       end.
     1337                       when chr(2)
     1338                       then do:
     1339                           assign
     1340                               p-out-string = p-out-string + "":U
     1341                           .
     1342                       end.
     1343                       when chr(3)
     1344                       then do:
     1345                           assign
     1346                               p-out-string = p-out-string + "":U
     1347                           .
     1348                       end.
     1349                       when chr(4)
     1350                       then do:
     1351                           assign
     1352                               p-out-string = p-out-string + "":U
     1353                           .
     1354                       end.
     1355                       when chr(5)
     1356                       then do:
     1357                           assign
     1358                               p-out-string = p-out-string + "":U
     1359                           .
     1360                       end.
     1361                       when chr(6)
     1362                       then do:
     1363                           assign
     1364                               p-out-string = p-out-string + "":U
     1365                           .
     1366                       end.
     1367                       when chr(7)
     1368                       then do:
     1369                           assign
     1370                               p-out-string = p-out-string + "":U
     1371                           .
     1372                       end.
     1373                       when chr(8)
     1374                       then do:
     1375                           assign
     1376                               p-out-string = p-out-string + "":U
     1377                           .
     1378                       end.
     1379                       when chr(9)
     1380                       then do:
     1381                           assign
     1382                               p-out-string = p-out-string + "":U
     1383                           .
     1384                       end.
     1385                       when chr(29)
     1386                       then do:
     1387                           assign
     1388                               p-out-string = p-out-string + "":U
     1389                           .
     1390                       end.
     1391                       when chr(10)
     1392                       then do:
     1393                           assign
     1394                               p-out-string = p-out-string + "&#10;":U
     1395                           .
     1396                       end.
     1397                       when chr(13)
     1398                       then do:
     1399                           assign
     1400                               p-out-string = p-out-string + "&#13;":U
     1401                           .
     1402                       end.
     1403                       otherwise do:
     1404                           assign
     1405                               p-out-string = p-out-string + v-current-char
     1406                           .
     1407                       end.
     1408                   end case.
     1409               end.
     1410           end.
     1411       end case.
     1412   end.
     1413   end .
     1414   procedure xmlchar-encode-1c :
     1415   define input parameter p-in-string      as character        no-undo.
     1416   define output parameter p-out-string    as character        no-undo.
     1417       define variable v-position      as integer      no-undo.
     1418       define variable v-current-char  as character    no-undo.
     1419   do
     1420   on error undo, return error
     1421   :
     1422       assign
     1423           p-out-string = "":U
     1424       .
     1425       case p-in-string
     1426       :
     1427           when ?
     1428           then do:
     1429               assign
     1430                   p-out-string = "?":U
     1431               .
     1432           end.
     1433           otherwise do:
     1434               do v-position = 1 to length( p-in-string )
     1435               :
     1436                   assign
     1437                       v-current-char = substring( p-in-string, v-position, 1 )
     1438                   .
     1439                   case v-current-char
     1440                   :
     1441                       when chr(1)
     1442                       then do:
     1443                           assign
     1444                               p-out-string = p-out-string + " ":U
     1445                           .
     1446                       end.
     1447                       when chr(2)
     1448                       then do:
     1449                           assign
     1450                               p-out-string = p-out-string + " ":U
     1451                           .
     1452                       end.
     1453                       when chr(3)
     1454                       then do:
     1455                           assign
     1456                               p-out-string = p-out-string + " ":U
     1457                           .
     1458                       end.
     1459                       when chr(4)
     1460                       then do:
     1461                           assign
     1462                               p-out-string = p-out-string + " ":U
     1463                           .
     1464                       end.
     1465                       when chr(5)
     1466                       then do:
     1467                           assign
     1468                               p-out-string = p-out-string + " ":U
     1469                           .
     1470                       end.
     1471                       when chr(6)
     1472                       then do:
     1473                           assign
     1474                               p-out-string = p-out-string + " ":U
     1475                           .
     1476                       end.
     1477                       when chr(7)
     1478                       then do:
     1479                           assign
     1480                               p-out-string = p-out-string + " ":U
     1481                           .
     1482                       end.
     1483                       when chr(8)
     1484                       then do:
     1485                           assign
     1486                               p-out-string = p-out-string + " ":U
     1487                           .
     1488                       end.
     1489                       when chr(9)
     1490                       then do:
     1491                           assign
     1492                               p-out-string = p-out-string + " ":U
     1493                           .
     1494                       end.
     1495                       when chr(29)
     1496                       then do:
     1497                           assign
     1498                               p-out-string = p-out-string + " ":U
     1499                           .
     1500                       end.
     1501                       when chr(10)
     1502                       then do:
     1503                           assign
     1504                               p-out-string = p-out-string + " ":U
     1505                           .
     1506                       end.
     1507                       when chr(13)
     1508                       then do:
     1509                           assign
     1510                               p-out-string = p-out-string + " ":U
     1511                           .
     1512                       end.
     1513                       otherwise do:
     1514                           assign
     1515                               p-out-string = p-out-string + v-current-char
     1516                           .
     1517                       end.
     1518                   end case.
     1519               end.
     1520           end.
     1521       end case.
     1522   end.
     1523   end .
     1524   procedure xmlchar-decode :
     1525   define input parameter p-in-string      as character        no-undo.
     1526   define output parameter p-out-string    as character        no-undo.
     1527       define variable v-position      as integer      no-undo.
     1528       define variable v-last-position as integer      no-undo.
     1529       define variable v-temp-integer  as integer      no-undo.
     1530       define variable v-current-char  as character    no-undo.
     1531       define variable v-next-char     as character    no-undo.
     1532       define variable v-success       as logical      no-undo.
     1533   do
     1534   on error undo, return error
     1535   :
     1536       assign
     1537           p-out-string = "":U
     1538           v-position   = 0
     1539       .
     1540       replace-cycle:
     1541       do while yes
     1542       on error undo, return error
     1543       :
     1544           assign
     1545               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1546           .
     1547           if v-last-position <= v-position
     1548           then do:
     1549               if v-position = 0
     1550               then do:
     1551                   assign
     1552                       p-out-string = p-in-string
     1553                   .
     1554               end.
     1555               else do:
     1556                   assign
     1557                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1558                   .
     1559               end.
     1560               leave replace-cycle.
     1561           end.
     1562           else do:
     1563               assign
     1564                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1565                   v-position      = v-last-position
     1566                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1567               .
     1568               if v-current-char = "#":U
     1569               then do:
     1570                   assign
     1571                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1572                   .
     1573                   if v-last-position > 0
     1574                   then do:
     1575                       run xmlchar-read-integer in this-procedure
     1576                        (
     1577                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1578                           , output v-temp-integer
     1579                           , output v-success
     1580                       ).
     1581                       if v-success = yes
     1582                       and v-temp-integer >= 1
     1583                       and v-temp-integer <= 255
     1584                       then do:
     1585                           assign
     1586                               p-out-string = p-out-string + chr( v-temp-integer )
     1587                               v-position   = v-last-position + 1
     1588                           .
     1589                       end.
     1590                       else do:
     1591                           assign
     1592                               p-out-string = p-out-string + "&":U
     1593                               v-position   = v-position   + 1
     1594                           .
     1595                       end.
     1596                   end.
     1597                   else do:
     1598                       assign
     1599                           p-out-string = p-out-string + "&":U
     1600                           v-position   = v-position   + 1
     1601                       .
     1602                   end.
     1603               end.
     1604               else do:
     1605                   case substring( p-in-string, v-position + 1, 3 )
     1606                   :
     1607                       when "lt;":U
     1608                       then do:
     1609                           assign
     1610                               p-out-string = p-out-string + "<":U
     1611                               v-position   = v-position   + 3
     1612                           .
     1613                       end.
     1614                       when "gt;":U
     1615                       then do:
     1616                           assign
     1617                               p-out-string = p-out-string + ">":U
     1618                               v-position   = v-position   + 3
     1619                           .
     1620                       end.
     1621                       otherwise do:
     1622                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1623                           then do:
     1624                               assign
     1625                                   p-out-string = p-out-string + "&":U
     1626                                   v-position   = v-position   + 4
     1627                               .
     1628                           end.
     1629                           else do:
     1630                               case substring( p-in-string, v-position + 1, 5 )
     1631                               :
     1632                                   when "quot;":U
     1633                                   then do:
     1634                                       assign
     1635                                           p-out-string = p-out-string + '"':U
     1636                                           v-position   = v-position   + 5
     1637                                       .
     1638                                   end.
     1639                                   when "apos;":U
     1640                                   then do:
     1641                                       assign
     1642                                           p-out-string = p-out-string + "'":U
     1643                                           v-position   = v-position   + 5
     1644                                       .
     1645                                   end.
     1646                                   otherwise do:
     1647                                       assign
     1648                                           p-out-string = p-out-string + "&":U
     1649                                       .
     1650                                   end.
     1651                               end case.
     1652                           end.
     1653                       end.
     1654                   end case.
     1655               end.
     1656           end.
     1657       end.
     1658   end.
     1659   end .
     1660   procedure xmlchar-read-integer :
     1661   define input parameter p-input-string      as character        no-undo.
     1662   define output parameter p-output-integer   as integer          no-undo.
     1663   define output parameter p-success       as logical          no-undo.
     1664   do
     1665   on error undo, return error
     1666   :
     1667       assign
     1668           p-output-integer = integer( p-input-string )
     1669       no-error.
     1670       if error-status :error
     1671       then do:
     1672           assign
     1673               p-success           = no
     1674               p-output-integer    = 0
     1675           .
     1676       end.
     1677       else do:
     1678           assign
     1679               p-success           = yes
     1680           .
     1681       end.
     1682   end.
     1683   end.
     1684   define variable v-bgelib-bgeclall           as logical      no-undo.
     1685   define variable v-bgelib-bgedict            as logical      no-undo.
     1686   define temp-table temp_ext-doc-type no-undo
     1687       field edt-key               as integer
     1688       field ext-doc-type          as character
     1689       field ext-doc-type-label    as character
     1690       index pi is primary unique
     1691           edt-key
     1692   .
     1693   define temp-table temp_bgelib_goods no-undo
     1694       field gds-code as integer
     1695       index pi is primary unique
     1696           gds-code
     1697   .
     1698   define temp-table temp_bgelib_clients no-undo
     1699       field obj-type as character
     1700       field obj-code as integer
     1701       index pi is primary unique
     1702           obj-type
     1703           obj-code
     1704   .
     1705   define temp-table temp_bgelib_dis-card no-undo
     1706       field d-card as character
     1707       index pi is primary unique
     1708           d-card
     1709   .
     1710   define temp-table temp_bgelib_trn-doc no-undo
     1711       field doc-code as integer
     1712   .
     1713   procedure bgelib-tag-open:
     1714   do
     1715   on error undo, return error
     1716   :
     1717   define input parameter v-tag-level  as integer      no-undo.
     1718   define input parameter v-tag-name   as character    no-undo.
     1719   define input parameter v-tag-value  as character    no-undo.
     1720       put stream stmXMLOut unformatted
     1721           chr(10)
     1722           + fill(" ", 4 * v-tag-level)
     1723           + "<" + v-tag-name
     1724           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
     1725           + v-tag-value + ">"
     1726       .
     1727   end.
     1728   end procedure.
     1729   procedure bgelib-tag-put:
     1730   do
     1731   on error undo, return error
     1732   :
     1733   define input parameter v-tag-level      as integer      no-undo.
     1734   define input parameter v-tag-name       as character    no-undo.
     1735   define input parameter v-tag-value      as character    no-undo.
     1736   define input parameter v-empty-mode     as integer      no-undo.
     1737       v-tag-name = trim(v-tag-name).
     1738       if  v-empty-mode = 1
     1739       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
     1740       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
     1741       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
     1742       then do:
     1743           run xmlchar-encode in this-procedure (
     1744                 input v-tag-value
     1745               , output v-tag-value
     1746           ).
     1747           put stream stmXMLOut unformatted
     1748               chr(10) + fill(" ", 4 * v-tag-level)
     1749                           + '<' + v-tag-name + '>'
     1750                           + v-tag-value
     1751                           + '</' + v-tag-name + '>'
     1752           .
     1753       end.
     1754   end.
     1755   end procedure.
     1756   procedure bgelib-tag-close:
     1757   do
     1758   on error undo, return error
     1759   :
     1760   define input parameter v-tag-level as integer      no-undo.
     1761   define input parameter v-tag-name  as character    no-undo.
     1762       put stream stmXMLOut unformatted
     1763           chr(10)
     1764           + fill( " ", 4 * v-tag-level)
     1765           + '</' + v-tag-name + '>'
     1766       .
     1767   end.
     1768   end procedure.
     1769   procedure bgelib-write-log:
     1770   do
     1771   on error undo, return error
     1772   :
     1773   define input parameter v-filename   as character    no-undo.
     1774   define input parameter v-log-level  as integer      no-undo.
     1775   define input parameter v-out-string as character    no-undo.
     1776       output stream stmXMLLog to value( v-filename ) append.
     1777       put stream stmXMLLog unformatted
     1778           chr(10)
     1779       .
     1780       put stream stmXMLLog unformatted
     1781           ( if v-log-level = 0
     1782             or v-out-string = "&DLine"
     1783             or v-out-string = "&Line"
     1784             then ""
     1785             else cur-time-string-sec() + " " )
     1786       .
     1787       put stream stmXMLLog unformatted
     1788           ( if v-out-string = "&Line"
     1789             then fill( "-", 80 )
     1790             else if v-out-string = "&DLine"
     1791                  then fill( "=", 80 )
     1792                  else v-out-string )
     1793       .
     1794       output stream stmXMLLog close.
     1795   end.
     1796   end procedure.
     1797   procedure bgelib-write-edt:
     1798   do
     1799   on error undo, return error
     1800   :
     1801   define input parameter v-editor-handle    as handle       no-undo.
     1802   define input parameter v-log-level        as integer      no-undo.
     1803   define input parameter v-out-string       as character    no-undo.
     1804       if valid-handle ( v-editor-handle )
     1805       then do:
     1806           v-editor-handle :move-to-eof().
     1807           v-editor-handle :insert-string( ( if v-log-level = 0
     1808                                             or v-out-string = "&DLine"
     1809                                             or v-out-string = "&Line"
     1810                                             then ""
     1811                                             else cur-time-string-sec() + " "
     1812                                         ) ).
     1813           v-editor-handle :insert-string( ( if v-out-string = "&Line"
     1814                                             then fill( "-", 80 )
     1815                                             else if v-out-string = "&DLine" then fill("=", 80)
     1816                                             else fill( " ", v-log-level) + v-out-string
     1817                                         ) ).
     1818           v-editor-handle :insert-string( chr(10) ).
     1819       end.
     1820       process events.
     1821       output to 'bgescn.txt' append.
     1822           put unformatted
     1823               chr(10)
     1824               string( ( if v-log-level = 0
     1825                         or v-out-string = "&DLine"
     1826                         or v-out-string = "&Line"
     1827                         then ""
     1828                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
     1829                     ) )
     1830               string( ( if v-out-string = "&Line"
     1831                         then fill( "-", 80 )
     1832                         else if v-out-string = "&DLine"
     1833                              then fill( "=", 80 )
     1834                              else fill( " ", v-log-level ) + v-out-string
     1835                     ) )
     1836           .
     1837       output close.
     1838   end.
     1839   end procedure.
     1840   procedure bgelib-show-cnt:
     1841   do
     1842   on error undo, return error
     1843   :
     1844   define input parameter v-fillin-handle     as handle   no-undo.
     1845       if valid-handle( v-fillin-handle )
     1846       then do:
     1847           assign
     1848               v-fillin-handle :visible = true
     1849           .
     1850       end.
     1851   end.
     1852   end procedure.
     1853   procedure bgelib-hide-cnt:
     1854   do
     1855   on error undo, return error
     1856   :
     1857   define input parameter v-fillin-handle     as handle   no-undo.
     1858       if valid-handle( v-fillin-handle )
     1859       then do:
     1860           assign v-fillin-handle :visible = false.
     1861       end.
     1862   end.
     1863   end procedure.
     1864   procedure bgelib-write-cnt:
     1865   do
     1866   on error undo, return error
     1867   :
     1868   define input parameter v-fillin-handle    as handle       no-undo.
     1869   define input parameter v-fillin-string    as character    no-undo.
     1870       if valid-handle( v-fillin-handle )
     1871       then do:
     1872           assign
     1873               v-fillin-handle :SCREEN-value = v-fillin-string
     1874           .
     1875       end.
     1876   end.
     1877   end procedure.
     1878   procedure bgelib-write-header:
     1879   do
     1880   on error undo, return error
     1881   :
     1882   define input parameter p-first-file     as logical      no-undo.
     1883   define input parameter p-xml-file-name  as character    no-undo.
     1884   define input parameter p-list-file-name as character    no-undo.
     1885   define input parameter p-file-number    as integer      no-undo.
     1886   define input parameter p-have-prev      as logical      no-undo.
     1887   define input parameter p-prev-filename  as character    no-undo.
     1888   define input parameter p-obj-list       as character    no-undo.
     1889   define input parameter p-doc-type-list  as character    no-undo.
     1890   define input parameter p-parameter-list as character    no-undo.
     1891       define variable v-counter    as integer        no-undo.
     1892       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1893       put stream stmXMLOut unformatted
     1894           "<?xml version='1.0' encoding='windows-1251'?>"
     1895       .
     1896       run bgelib-tag-open( input 0, input "root"  , input "" ).
     1897       run bgelib-tag-open( input 0, input "header", input "" ).
     1898       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1899       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1900       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1901       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1902       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     1903       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1904       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1905       :
     1906           run bgelib-tag-put(
     1907                 input 1
     1908               , input entry( 2 * v-counter, p-parameter-list )
     1909               , input entry( 2 * v-counter + 1, p-parameter-list )
     1910               , input 0
     1911           ).
     1912       end.
     1913       run bgelib-tag-close( input 0, input "header" ).
     1914       output stream stmXMLOut close.
     1915       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1916       if p-first-file = yes
     1917       then do:
     1918           put stream stmXMLOut unformatted
     1919               "<?xml version='1.0' encoding='windows-1251'?>"
     1920           .
     1921           run bgelib-tag-open( input 0, input "export", input "" ).
     1922       end.
     1923       run bgelib-tag-open( input 1, input "file", input "" ).
     1924       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1925       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1926       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1927       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1928       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1929       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1930       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1931       :
     1932           run bgelib-tag-put(
     1933                 input 2
     1934               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1935               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1936               , input 0
     1937           ).
     1938       end.
     1939       run bgelib-tag-close( input 1, input "file" ).
     1940       output stream stmXMLOut close.
     1941   end.
     1942   end procedure.
     1943   procedure bgelib-write-footer:
     1944   do
     1945   on error undo, return error
     1946   :
     1947   define input parameter p-last-file      as logical      no-undo.
     1948   define input parameter p-xml-file-name  as character    no-undo.
     1949   define input parameter p-list-file-name as character    no-undo.
     1950   define input parameter p-have-next      as logical      no-undo.
     1951   define input parameter p-next-file-name as character    no-undo.
     1952       define variable v-error-num     as integer           no-undo.
     1953       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1954       if p-have-next = yes
     1955       then do:
     1956           run bgelib-tag-open( input 0, input "footer", "" ).
     1957           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1958           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1959           run bgelib-tag-close( input 0, input "footer" ).
     1960       end.
     1961       run bgelib-tag-close( input 0, input "root" ).
     1962       output stream stmXMLOut close.
     1963       run bge/os_copy.p (
     1964             input "M"
     1965           , input p-xml-file-name + "tmp"
     1966           , input p-xml-file-name + "xml"
     1967           , output v-error-num
     1968       ).
     1969       if p-last-file = yes
     1970       then do:
     1971           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1972               run bgelib-tag-close( input 0, input "export" ).
     1973           output stream stmXMLOut close.
     1974           run bge/os_copy.p (
     1975                 input "M"
     1976               , input p-list-file-name + "tmp"
     1977               , input p-list-file-name + "xml"
     1978               , output v-error-num
     1979           ).
     1980       end.
     1981   end.
     1982   end procedure.
     1983   procedure bgelib-filename :
     1984   do
     1985   on error undo, return error
     1986   :
     1987   define input parameter p-prefix             as character    no-undo.
     1988   define output parameter p-xml-file-name     as character    no-undo.
     1989   define output parameter p-log-file-name     as character    no-undo.
     1990   define output parameter p-list-file-name    as character    no-undo.
     1991       define variable v-home-dir  as character    no-undo.
     1992       define variable v-error-num as integer      no-undo.
     1993       get-key-value section "BGE" key "outdir" value v-home-dir.
     1994       if v-home-dir = ?
     1995       then do:
     1996           message
     1997             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1998             skip(1)
     1999             skip "Обратитесь к администратору."
     2000           view-as alert-box error.
     2001           undo, return error .
     2002       end.
     2003       run gbl/dir-cre.p (
     2004           input v-home-dir
     2005       ) no-error.
     2006       if error-status :error
     2007       then do:
     2008           message
     2009             skip "Неверно задан каталог экспорта."
     2010             skip(1)
     2011             skip "Обратитесь к администратору."
     2012           view-as alert-box error.
     2013           undo, return error .
     2014       end.
     2015       run bge/genfname.p (
     2016             input v-home-dir
     2017           , input p-prefix
     2018           , input ""
     2019           , input "xml"
     2020           , input "tmp"
     2021           , output p-xml-file-name
     2022       ).
     2023       assign
     2024           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2025           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     2026           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     2027       .
     2028   end.
     2029   end procedure.
     2030   procedure bgelib-read-config :
     2031   do
     2032   on error undo, return error
     2033   :
     2034   define variable v-par-type as character     no-undo.
     2035     define variable v-param-type      as character  no-undo .
     2036     define variable v-value-character as character  no-undo .
     2037     define variable v-value-date      as date       no-undo .
     2038     define variable v-value-decimal   as decimal    no-undo .
     2039     define variable v-value-integer   as integer    no-undo .
     2040     define variable v-value-logical   as logical    no-undo .
     2041     define variable v-tth             as handle     no-undo .
     2042       assign
     2043           v-bgelib-bgeclall = no
     2044           v-bgelib-bgedict  = no
     2045       .
     2046       run adm/shattri.p ( input "get":U
     2047                         , input  '':u
     2048                         , input  0
     2049                         , input  'bge-export':U
     2050                         , input  'bgeclall':U
     2051                         , output v-value-character
     2052                         , output v-value-date
     2053                         , output v-value-decimal
     2054                         , output v-value-integer
     2055                         , output v-value-logical
     2056                         , output v-param-type
     2057                         , input-output table-handle v-tth
     2058                         ) no-error .
     2059       if error-status :error
     2060       then do:
     2061         assign
     2062           v-bgelib-bgeclall = no
     2063         .
     2064       end.
     2065       else do:
     2066         assign
     2067           v-bgelib-bgeclall = v-value-logical
     2068         .
     2069       end.
     2070       delete object v-tth.
     2071       run adm/shattri.p ( input "get":U
     2072                         , input  '':u
     2073                         , input  0
     2074                         , input  'bge-export':U
     2075                         , input  'bgedict':U
     2076                         , output v-value-character
     2077                         , output v-value-date
     2078                         , output v-value-decimal
     2079                         , output v-value-integer
     2080                         , output v-value-logical
     2081                         , output v-param-type
     2082                         , input-output table-handle v-tth
     2083                         ) no-error .
     2084       if error-status :error
     2085       then do:
     2086         assign
     2087           v-bgelib-bgedict = no
     2088         .
     2089       end.
     2090       else do:
     2091         assign
     2092           v-bgelib-bgedict = v-value-logical
     2093         .
     2094       end.
     2095       delete object v-tth.
     2096       run adm/shattri.p ( input "get":U
     2097                         , input  '':u
     2098                         , input  0
     2099                         , input  'bge-export':U
     2100                         , input  'bgefmt':U
     2101                         , output v-value-character
     2102                         , output v-value-date
     2103                         , output v-value-decimal
     2104                         , output v-value-integer
     2105                         , output v-value-logical
     2106                         , output v-param-type
     2107                         , input-output table-handle v-tth
     2108                         ) no-error .
     2109       if error-status :error
     2110       then do:
     2111         assign
     2112           v-bgelib-bgefmt  = "xml":U
     2113         .
     2114       end.
     2115       else do:
     2116         assign
     2117           v-bgelib-bgefmt  = v-value-character
     2118         .
     2119       end.
     2120       delete object v-tth.
     2121       run adm/shattri.p ( input "get":U
     2122                         , input  '':u
     2123                         , input  0
     2124                         , input  'bge-export':U
     2125                         , input  'bgeflold':U
     2126                         , output v-value-character
     2127                         , output v-value-date
     2128                         , output v-value-decimal
     2129                         , output v-value-integer
     2130                         , output v-value-logical
     2131                         , output v-param-type
     2132                         , input-output table-handle v-tth
     2133                         ) no-error .
     2134       if error-status :error
     2135       then do:
     2136         assign
     2137           v-bgelib-bgeflold  = "old":U
     2138         .
     2139       end.
     2140       else do:
     2141         assign
     2142           v-bgelib-bgeflold  = v-value-character
     2143         .
     2144       end.
     2145       delete object v-tth.
     2146   end.
     2147   end procedure.
     2148   procedure bgelib-check-file-size :
     2149   do
     2150   on error undo, return error
     2151   :
     2152   define input parameter p-out-filename   as character    no-undo.
     2153   define output parameter p-is-big        as logical      no-undo.
     2154       define variable v-current-position    as integer        no-undo.
     2155       assign
     2156           v-current-position = seek( stmXMLOut )
     2157       .
     2158       if v-current-position / 1024 / 1024  >= 100
     2159       then do:
     2160           assign
     2161               p-is-big = yes
     2162           .
     2163       end.
     2164   end.
     2165   end procedure.
     2166   procedure bgelib-init-ext-doc-type :
     2167       define variable v-counter    as integer      no-undo.
     2168       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2169   do
     2170   for buf_temp_ext-doc-type
     2171   on error undo, return error
     2172   :
     2173       empty temp-table buf_temp_ext-doc-type.
     2174       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2175       :
     2176           create buf_temp_ext-doc-type.
     2177           assign
     2178               buf_temp_ext-doc-type.edt-key               = v-counter
     2179               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2180               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2181           .
     2182       end.
     2183   end.
     2184   end procedure.
     2185   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2186   define variable v-xml-file-name     as character            no-undo.
     2187   define variable v-xml-file-name-path as character            no-undo.
     2188   define variable v-log-file-name     as character            no-undo.
     2189   define variable v-locked            as logical              no-undo.
     2190   define variable v-log-string        as character            no-undo.
     2191   define variable v-oper-num          as integer              no-undo.
     2192   define variable v-obj-list          as character            no-undo.
     2193   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
     2194   DEF VAR intRep      AS INT NO-UNDO.
     2195   define variable hEDT             AS HANDLE NO-UNDO.
     2196   define variable hCNT             AS HANDLE NO-UNDO.
     2197   procedure xml-cd-write-header:
     2198   do
     2199   on error undo, return error
     2200   :
     2201   define input parameter p-xml-file-name       as character    no-undo.
     2202   define input parameter p-xml-file-name-path  as character    no-undo.
     2203   define input parameter p-doc-name            as character    no-undo.
     2204   define input parameter p-version             as character    no-undo.
     2205   define input parameter p-obj-list            as character    no-undo.
     2206   define input parameter p-correspondent       as character    no-undo .
     2207   define input parameter p-write-header        as logical      no-undo .
     2208   define variable OS-time as character no-undo .
     2209   define variable id as character no-undo .
     2210   define buffer buf_db for ub.db.
     2211   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     2212   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     2213   assign
     2214   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     2215   .
     2216   run bgelib-tag-open in this-procedure (
     2217                                        1
     2218                                       ,p-doc-name
     2219                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     2220                                         ).
     2221   if p-write-header then do:
     2222     run bgelib-tag-open(2, "Header","").
     2223     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     2224     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     2225     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     2226     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     2227     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     2228     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     2229     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     2230     find first buf_db where buf_db.db-num = g#db-num no-lock.
     2231     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     2232     run bgelib-tag-close( 2, "Header" ).
     2233   end.
     2234   output stream stmXMLOut close.
     2235   end.
     2236   end procedure.
     2237   procedure xml-cd-write-footer:
     2238   do
     2239   on error undo, return error
     2240   :
     2241   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     2242   define input parameter p-xml-file-name as character    no-undo.
     2243   define input parameter p-doc-name      as character    no-undo .
     2244   define variable v-error-num     as integer           no-undo.
     2245   define variable v-md5-signature as character no-undo .
     2246   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     2247   run bgelib-tag-close( 0, p-doc-name ).
     2248   put stream stmXMLOut unformatted skip.
     2249   output stream stmXMLOut close.
     2250   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     2251   if v-error-num > 0
     2252   then do:
     2253      return error.
     2254   end.
     2255   if opsys = "unix"
     2256   then do:
     2257       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     2258   end.
     2259   end.
     2260   end procedure.
     2261   procedure xml-cd-filename :
     2262   do
     2263   on error undo, return error
     2264   :
     2265   define input parameter  p-out               as character no-undo .
     2266   define output parameter p-xml-file-name     as character    no-undo.
     2267   define output parameter p-xml-file-name-path   as character    no-undo.
     2268   define output parameter p-log-file-name     as character    no-undo.
     2269   define output parameter p-locked            as logical      no-undo.
     2270   define variable v-out as character     no-undo.
     2271   define variable loc#log as logical no-undo .
     2272   define variable BadFlag as logical no-undo .
     2273   define variable fq as integer no-undo .
     2274   define variable v-remote as character no-undo .
     2275   assign
     2276   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     2277   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     2278   p-log-file-name = p-out + "actions.log"
     2279   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     2280   .
     2281   end.
     2282   end procedure.
     2283   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     2284   define variable v-date-str as character no-undo .
     2285   assign
     2286   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     2287                string(Month(p-date), "99":U) + "-":U +
     2288                string(DAY(p-date), "99":U).
     2289   return v-date-str.
     2290   END FUNCTION.
     2291   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     2292   define variable v-date-str as character no-undo .
     2293   assign
     2294   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     2295                string(Month(p-date), "99":U) + "-":U +
     2296                string(DAY(p-date), "99":U) + chr(32) +
     2297                string(p-time, "HH:MM:SS").
     2298   return v-date-str.
     2299   END FUNCTION.
     2300   function string-to-date returns date ( input p-string  as character):
     2301     define variable v-date as date no-undo .
     2302     assign
     2303     v-date = date(integer(substring(p-string, 4, 2))
     2304                   ,integer(substring(p-string, 1, 2))
     2305                   ,integer(substring(p-string, 7, 4))
     2306                  ) no-error .
     2307     if error-status:error then return ?.
     2308     return v-date.
     2309   END FUNCTION.
     2310   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     2311   define variable v-time as integer no-undo init ?.
     2312   define variable v-dop1 as character no-undo .
     2313   define variable v-dop2 as character no-undo .
     2314   assign
     2315   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     2316   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     2317   no-error .
     2318   if error-status:error then return ?.
     2319   assign
     2320   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     2321             integer(entry(2, v-dop2, ";":U)) * 60 +
     2322             integer(entry(3, v-dop2, ";":U)) no-error .
     2323   return v-time.
     2324   END FUNCTION.
     2325   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2326   procedure gen-key-rec :
     2327     define input  parameter p-tbl-name    as character no-undo.
     2328     define input  parameter p-bh_tbl-name as handle    no-undo.
     2329     define output parameter p-key-rec     as character no-undo.
     2330     do
     2331     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2332     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     2333     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     2334     :
     2335       define variable fh               as handle    no-undo .
     2336       define variable v-ok             as logical   no-undo .
     2337       define variable v-inform         as character no-undo .
     2338       define variable v-ind            as integer   no-undo .
     2339       define variable v-idx-field-qnty as integer   no-undo .
     2340       if p-tbl-name = ?
     2341         or p-tbl-name = "":U
     2342       then do:
     2343         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info8 ).
     2344       end.
     2345       if not p-bh_tbl-name:available then do:
     2346         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info8, p-tbl-name ).
     2347       end.
     2348       assign
     2349         p-key-rec = p-tbl-name
     2350         v-inform  = p-bh_tbl-name:index-information(1)
     2351         v-ind     = 2
     2352       .
     2353       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2354       on error undo, return error
     2355       :
     2356         assign
     2357           v-inform = p-bh_tbl-name:index-information( v-ind )
     2358           v-ind    = v-ind + 1
     2359         .
     2360       end.
     2361       if v-inform = ?
     2362         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2363         or entry( 3, v-inform, ",":U ) <> "1":U
     2364       then do:
     2365         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, p-tbl-name ).
     2366       end.
     2367       else do:
     2368         assign
     2369           v-idx-field-qnty = num-entries( v-inform ) - 4
     2370         .
     2371         if v-idx-field-qnty < 2 then do:
     2372           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, p-tbl-name ).
     2373         end.
     2374         do v-ind = 1 to v-idx-field-qnty by 2
     2375         on error undo, return error
     2376         :
     2377           assign
     2378             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     2379             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     2380           .
     2381         end.
     2382       end.
     2383       if p-key-rec = ? then do:
     2384         assign
     2385           p-key-rec = "":U
     2386         .
     2387         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info8, p-tbl-name ).
     2388       end.
     2389     end.
     2390     return.
     2391   end procedure.
     2392   procedure gen-where-keyr-tab :
     2393     define input  parameter i-tableSerach as character no-undo.
     2394     define input  parameter i-tablekey   as character  no-undo.
     2395     define input  parameter p-key-rec    as character  no-undo.
     2396     define input  parameter p-key-handle as handle     no-undo .
     2397     define input  parameter p-db-name    as character  no-undo .
     2398     define input  parameter p-tt-handle  as handle     no-undo .
     2399     define output parameter o-Where      as character  no-undo.
     2400     do
     2401     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2402     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2403     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     2404     :
     2405       define variable v-full-tbl-name  as character no-undo .
     2406       define variable bh_tbl-name      as handle    no-undo .
     2407       define variable fh_key           as handle    no-undo .
     2408       define variable fh_search        as handle    no-undo .
     2409       define variable v-field-num      as integer   no-undo .
     2410       define variable v-count-fld      as integer   no-undo .
     2411       define variable v-inform         as character no-undo .
     2412       define variable v-ind            as integer   no-undo .
     2413       define variable v-idx-field-qnty as integer   no-undo .
     2414       define variable v-field-name     as character no-undo .
     2415       define variable v-field-val      as character no-undo .
     2416       define variable v-word-link      as character no-undo .
     2417       define variable vTable           as character no-undo.
     2418       define variable bh_tbl-key       as handle    no-undo .
     2419       assign
     2420         p-key-rec = trim( p-key-rec )
     2421       .
     2422       if p-key-handle <> ? then do:
     2423         if not valid-handle(p-key-handle)
     2424            or p-key-handle:type <> "buffer"
     2425         then do:
     2426           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info8 ).
     2427         end.
     2428         if num-entries( p-key-rec, chr(3) ) > 1
     2429           or p-key-rec = ?
     2430           or p-key-rec = "":U
     2431         then do:
     2432           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info8, p-key-rec ).
     2433         end.
     2434       end.
     2435       else do:
     2436         if p-key-rec = ?
     2437           or p-key-rec = "":U
     2438         then do:
     2439           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info8 ).
     2440         end.
     2441       end.
     2442       assign
     2443         vTable = entry( 1 , p-key-rec, chr(3) )
     2444       .
     2445       if p-tt-handle <> ?
     2446         and ( not valid-handle(p-tt-handle)
     2447               or p-tt-handle:type <> "buffer"
     2448             )
     2449       then do:
     2450         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info8, vTable, chr(10) ).
     2451       end.
     2452       if p-tt-handle = ? then do:
     2453         assign
     2454           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     2455         .
     2456         create buffer bh_tbl-name for table v-full-tbl-name .
     2457       end.
     2458       else do:
     2459         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2460       end.
     2461       assign
     2462         v-inform = bh_tbl-name:index-information(1)
     2463         v-ind    = 2
     2464       .
     2465       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2466       on error undo, return error
     2467       :
     2468         assign
     2469           v-inform = bh_tbl-name:index-information( v-ind )
     2470           v-ind    = v-ind + 1
     2471         .
     2472       end.
     2473       if v-inform = ?
     2474         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2475         or entry( 3, v-inform, ",":U ) <> "1":U
     2476       then do:
     2477         delete object bh_tbl-name no-error.
     2478         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info8, vTable ).
     2479       end.
     2480       assign
     2481         v-idx-field-qnty = num-entries( v-inform ) - 4
     2482       .
     2483       if v-idx-field-qnty < 2 then do:
     2484         delete object bh_tbl-name no-error.
     2485         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, vTable ).
     2486       end.
     2487       assign
     2488         o-where     = "where":U
     2489         v-word-link = "":U
     2490         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     2491         v-count-fld = 0
     2492       .
     2493       if i-tablekey ne "" and i-tablekey ne ?
     2494       then do:
     2495         assign
     2496           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     2497         .
     2498         create buffer bh_tbl-key for table v-full-tbl-name .
     2499       end.
     2500       if i-tableSerach ne "" and i-tableSerach ne ?
     2501       then do:
     2502         delete object bh_tbl-name no-error.
     2503         assign
     2504           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     2505         .
     2506         create buffer bh_tbl-name for table v-full-tbl-name .
     2507       end.
     2508       block_where:
     2509       do v-ind = 1 to v-idx-field-qnty by 2
     2510       on error undo, return error
     2511       :
     2512         assign
     2513           v-count-fld = v-count-fld + 1
     2514         .
     2515         if p-key-handle = ?
     2516           and v-count-fld > v-field-num
     2517         then do:
     2518           leave block_where.
     2519         end.
     2520         define variable VfieldKeyTable as handle no-undo.
     2521         assign
     2522           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2523           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     2524         .
     2525         if     bh_tbl-key ne ?
     2526         then do:
     2527            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     2528            if VfieldKeyTable eq ?
     2529            then next block_where.
     2530         end.
     2531         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     2532         then
     2533            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     2534         else
     2535            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     2536         if p-key-handle = ? then do:
     2537           assign
     2538             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     2539           .
     2540         end.
     2541         else do:
     2542           assign
     2543             fh_key = p-key-handle:buffer-field( v-field-name )
     2544           .
     2545           if fh_key = ?
     2546             or not valid-handle( fh_key )
     2547           then do:
     2548             delete object bh_tbl-name.
     2549             if     bh_tbl-key ne ?
     2550             then
     2551                delete object bh_tbl-key.
     2552             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info8, p-key-handle:name, v-field-name ).
     2553           end.
     2554           assign
     2555             v-field-val = fh_key:buffer-value
     2556           .
     2557         end.
     2558         if fh_search:data-type ="character":U then do:
     2559           assign
     2560             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     2561             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     2562             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     2563             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     2564             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     2565             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2566             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2567             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2568             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2569             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2570             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2571             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2572             v-field-val = substitute( '"&1"', v-field-val )
     2573           .
     2574         end.
     2575         assign
     2576           o-where = substitute( "&1 &2", o-where, v-field-val )
     2577         .
     2578         if v-word-link = "":U then do:
     2579           assign
     2580             v-word-link = "and":U
     2581           .
     2582         end.
     2583       end.
     2584       delete object bh_tbl-name.
     2585       if     bh_tbl-key ne ?
     2586       then
     2587          delete object bh_tbl-key.
     2588       if p-key-handle = ?
     2589         and v-count-fld <> v-field-num
     2590       then do:
     2591         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info8, vTable ).
     2592       end.
     2593     end.
     2594   end procedure.
     2595   procedure gen-hn-keyr-tab :
     2596     define input  parameter i-tableSerach as character no-undo.
     2597     define input  parameter i-tablekey   as character no-undo.
     2598     define input  parameter p-key-rec    as character no-undo.
     2599     define input  parameter p-key-handle as handle    no-undo .
     2600     define input  parameter p-db-name    as character no-undo .
     2601     define input  parameter p-tt-handle  as handle    no-undo .
     2602     define input  parameter p-stts-lock  as integer   no-undo .
     2603     define output parameter o-hn         as handle    no-undo.
     2604     define variable v-full-tbl-name as character no-undo.
     2605     define variable v-where         as character no-undo.
     2606     define variable bh_tbl-name     as handle    no-undo.
     2607     define variable vTable          as character no-undo.
     2608     do
     2609     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2610     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2611     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     2612         run gen-where-keyr-tab(i-tableSerach,
     2613                                i-tablekey,
     2614                                p-key-rec,
     2615                                p-key-handle,
     2616                                p-db-name,
     2617                                p-tt-handle,
     2618                                output v-where).
     2619         if i-tableSerach ne "" and i-tableSerach ne ?
     2620         then do:
     2621            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     2622            create buffer bh_tbl-name for table v-full-tbl-name .
     2623         end.
     2624         else do:
     2625            if p-tt-handle = ? then do:
     2626               assign
     2627                  vTable = entry( 1 , p-key-rec, chr(3) )
     2628               .
     2629               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     2630               create buffer bh_tbl-name for table v-full-tbl-name .
     2631            end.
     2632            else do:
     2633               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2634            end.
     2635         end.
     2636         if p-tt-handle = ? then do:
     2637            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     2638         end.
     2639         else do:
     2640            bh_tbl-name:find-first( v-where ) no-error .
     2641         end.
     2642         o-hn = bh_tbl-name.
     2643      end.
     2644   end procedure.
     2645   procedure gen-hn-keyr :
     2646     define input  parameter p-key-rec    as character no-undo.
     2647     define input  parameter p-key-handle as handle    no-undo .
     2648     define input  parameter p-db-name    as character no-undo .
     2649     define input  parameter p-tt-handle  as handle    no-undo .
     2650     define input  parameter p-stts-lock  as integer   no-undo .
     2651     define output parameter o-hn         as handle    no-undo.
     2652     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     2653   end.
     2654   procedure gen-row-keyr :
     2655     define input  parameter p-key-rec    as character no-undo.
     2656     define input  parameter p-key-handle as handle    no-undo .
     2657     define input  parameter p-db-name    as character no-undo .
     2658     define input  parameter p-tt-handle  as handle    no-undo .
     2659     define input  parameter p-stts-lock  as integer   no-undo .
     2660     define output parameter p-tbl-row    as rowid     no-undo.
     2661     define output parameter p-tbl-name   as character no-undo.
     2662     define variable vHn as handle no-undo.
     2663       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     2664       p-tbl-row = if vHn:available then vHn:rowid else ?.
     2665       p-tbl-name =  vHn:table.
     2666       delete object vHn no-error.
     2667     if p-tbl-row = ? then do:
     2668       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info8, p-tbl-name, p-key-rec ).
     2669     end.
     2670     else do:
     2671       return.
     2672     end.
     2673   end procedure.
     2674   procedure gen-key-fv :
     2675     define input  parameter p-key-rec    as character no-undo .
     2676     define output parameter p-field-list as character no-undo .
     2677     define output parameter p-value-list as character no-undo.
     2678     do
     2679     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2680     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2681     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2682     :
     2683       define variable v-full-tbl-name  as character no-undo .
     2684       define variable bh_tbl-name      as handle    no-undo .
     2685       define variable v-tbl-name       as character no-undo .
     2686       define variable v-field-num      as integer   no-undo .
     2687       define variable v-count-fld      as integer   no-undo .
     2688       define variable v-inform         as character no-undo .
     2689       define variable v-ind            as integer   no-undo .
     2690       define variable v-idx-field-qnty as integer   no-undo .
     2691       define variable v-delim-key      as character no-undo .
     2692       if p-key-rec = ?
     2693         or p-key-rec = "":U
     2694       then do:
     2695         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info8 ).
     2696       end.
     2697       assign
     2698         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     2699         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2700       .
     2701       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2702       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info8 ).
     2703       assign
     2704         v-inform = bh_tbl-name:index-information(1)
     2705         v-ind    = 2
     2706       .
     2707       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2708       on error undo, return error
     2709       :
     2710         assign
     2711           v-inform = bh_tbl-name:index-information( v-ind )
     2712           v-ind    = v-ind + 1
     2713         .
     2714       end.
     2715       if v-inform = ?
     2716         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2717         or entry( 3, v-inform, ",":U ) <> "1":U
     2718       then do:
     2719         delete object bh_tbl-name no-error.
     2720         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, v-tbl-name ).
     2721       end.
     2722       assign
     2723         v-idx-field-qnty = num-entries( v-inform ) - 4
     2724       .
     2725       if v-idx-field-qnty < 2 then do:
     2726         delete object bh_tbl-name no-error.
     2727         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, v-tbl-name ).
     2728       end.
     2729       assign
     2730         p-field-list = "":U
     2731         p-value-list = "":U
     2732         v-delim-key  = "":U
     2733         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     2734         v-count-fld  = 0
     2735       .
     2736       block_where:
     2737       do v-ind = 1 to v-idx-field-qnty by 2
     2738       on error undo, return error
     2739       :
     2740         assign
     2741           v-count-fld = v-count-fld + 1
     2742         .
     2743         if v-count-fld > v-field-num then do:
     2744           leave block_where.
     2745         end.
     2746         assign
     2747           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     2748           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     2749         .
     2750         if v-ind = 1 then do:
     2751           assign
     2752             v-delim-key = chr(3)
     2753           .
     2754         end.
     2755       end.
     2756       delete object bh_tbl-name.
     2757       if v-count-fld <> v-field-num then do:
     2758         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info8, v-tbl-name ).
     2759       end.
     2760     end.
     2761   end procedure.
     2762   procedure gen-key-field :
     2763     define input  parameter p-table      as character no-undo .
     2764     define output parameter p-field-list as character no-undo .
     2765     do
     2766     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2767     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2768     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2769     :
     2770       define variable v-full-tbl-name  as character no-undo .
     2771       define variable bh_tbl-name      as handle    no-undo .
     2772       define variable v-tbl-name       as character no-undo .
     2773       define variable v-field-num      as integer   no-undo .
     2774       define variable v-count-fld      as integer   no-undo .
     2775       define variable v-inform         as character no-undo .
     2776       define variable v-ind            as integer   no-undo .
     2777       define variable v-idx-field-qnty as integer   no-undo .
     2778       define variable v-delim-key      as character no-undo .
     2779       if p-table = ?
     2780         or p-table = "":U
     2781       then do:
     2782         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info8 ).
     2783       end.
     2784       assign
     2785         v-tbl-name      = p-table
     2786         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2787       .
     2788       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2789       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info8 ).
     2790       assign
     2791         v-inform = bh_tbl-name:index-information(1)
     2792         v-ind    = 2
     2793       .
     2794       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2795       on error undo, return error
     2796       :
     2797         assign
     2798           v-inform = bh_tbl-name:index-information( v-ind )
     2799           v-ind    = v-ind + 1
     2800         .
     2801       end.
     2802       if v-inform = ?
     2803         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2804         or entry( 3, v-inform, ",":U ) <> "1":U
     2805       then do:
     2806         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, v-tbl-name ).
     2807       end.
     2808       assign
     2809         v-idx-field-qnty = num-entries( v-inform ) - 4
     2810       .
     2811       if v-idx-field-qnty < 2 then do:
     2812         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, v-tbl-name ).
     2813       end.
     2814       assign
     2815         p-field-list = "":U
     2816         v-delim-key  = "":U
     2817         v-count-fld  = 0
     2818       .
     2819       block_where:
     2820       do v-ind = 1 to v-idx-field-qnty by 2
     2821       on error undo, return error
     2822       :
     2823         assign
     2824           v-count-fld = v-count-fld + 1
     2825         .
     2826         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     2827         if v-ind = 1 then do:
     2828           assign
     2829             v-delim-key = chr(3)
     2830           .
     2831         end.
     2832       end.
     2833       delete object bh_tbl-name.
     2834     end.
     2835   end procedure.
     2836   define variable v-tth                as handle    no-undo.
     2837   define variable v-Param-Type         as character no-undo.
     2838   define variable glog                 as logical   no-undo.
     2839   define variable v-value-character    as character no-undo.
     2840   define variable v-value-date         as date      no-undo.
     2841   define variable v-value-decimal      as decimal   no-undo.
     2842   define variable v-value-integer      as integer   no-undo.
     2843   define variable v-value-logical      as logical   no-undo.
     2844   define variable v-no-get-chk         as logical   no-undo.
     2845   define variable log-file-name        as character no-undo .
     2846   define variable p-auto               as integer   no-undo .
     2847   define variable m-obj-code           as integer   no-undo.
     2848   define variable m-cash-num           as integer   no-undo.
     2849   define variable m-post-file-name     as character no-undo.
     2850   define variable m-response-file-name as character no-undo.
     2851   define variable m-xml-file-name      as character no-undo.
     2852   define variable m-obj-list           as character no-undo.
     2853   define variable m-correspondent      as character no-undo.
     2854   define variable m-timestamp          as character no-undo.
     2855   define variable Check-ctrl           as character no-undo.
     2856   define variable ErrorMessage         as character no-undo.
     2857   define variable mElement             as character no-undo.
     2858   define variable mCount               as int64     no-undo.
     2859   define variable m-err-msg            as character no-undo.
     2860   define variable v-host-code          like ub.sysconf.host-code no-undo .
     2861   define variable p-parameter          as character no-undo .
     2862   define variable p-other              as character no-undo .
     2863   define buffer buf_cash-desk for cash-desk.
     2864   define variable v-uniq-key-rec as character no-undo .
     2865   define variable v-view-log     as logical   no-undo .
     2866   define variable v-spec-command as character no-undo .
     2867   define variable vMsg           as character no-undo.
     2868   define variable Mreq           as longchar  no-undo.
     2869   define variable hSAXWriter     as handle    no-undo.
     2870   define variable vss-revision9    as character no-undo init "$Revision:$":U .
     2871   define variable vss-author9      as character no-undo init "$Author:$":U .
     2872   define variable vss-date9        as character no-undo init "$Date:$":U .
     2873   define variable vss-workfile9    as character no-undo init "$Workfile:$":U .
     2874   define variable vss-archive9     as character no-undo init "$Archive:$":U .
     2875   define variable vss-description9 as character no-undo init "Работа С сокетом".
     2876   procedure PutMesAsunc:
     2877       define input  parameter Itext as character no-undo.
     2878       define variable vflag as logical no-undo.
     2879       Publish "WriteLogAsunc" (Itext, yes)  .
     2880   end.
     2881   procedure PutMesAsuncNoTime:
     2882       define input  parameter Itext as character no-undo.
     2883       define variable vflag as logical no-undo.
     2884       Publish "WriteLogAsunc" (Itext,no)  .
     2885   end.
     2886   procedure PutStatAsunc:
     2887       define input  parameter Itext as character no-undo.
     2888       Publish "PutStatAsunc" (Itext,no) .
     2889        run
     2890       PutMesAsunc (itext).
     2891   end.
     2892   procedure PutStatAsuncNoTime:
     2893       define input  parameter Itext as character no-undo.
     2894       Publish "PutStatAsunc" (Itext,no)  .
     2895        run
     2896       PutMesAsuncNoTime (itext).
     2897   end.
     2898   procedure PutStatAsuncAdd:
     2899       define input  parameter Itext as character no-undo.
     2900       Publish "PutStatAsunc" (Itext,yes)  .
     2901   end.
     2902   procedure PutFileLogAsunc:
     2903       define input  parameter IFile as character no-undo.
     2904       Publish "PutFileLogAsunc" (ifile)  .
     2905   end.
     2906   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2907   define variable v-waitfram-action01         as character   no-undo .
     2908   define variable v-waitfram-action02         as character   no-undo .
     2909   define variable v-waitfram-action03         as character   no-undo .
     2910   define variable mWaitFramTextBeg            as character   no-undo.
     2911   define variable mWaitFramTextEnd            as character   no-undo.
     2912   define variable mWaitFramView               as logical     no-undo.
     2913   define variable mWaitProcEvent              as logical     no-undo init yes.
     2914   define variable mWaitFramInterval           as integer     no-undo init 1 .
     2915   define variable mWaitFramStop               as logical     no-undo.
     2916   define variable mWaitFramStopUser           as logical     no-undo.
     2917   define variable mWaitFramStopTimeOut        as logical     no-undo.
     2918   define variable mWaitFramStartProc          as datetime-tz no-undo.
     2919   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     2920   define button B-WaitFramStop auto-end-key
     2921        label "Стоп"
     2922        size 10 by 1 tooltip "Остоновить процесс".
     2923   define button B-viewProcInfo
     2924        label "Информация"
     2925        size 15 by 1 tooltip "Информация о процесс".
     2926   define frame waitfram
     2927     v-waitfram-action01 format "x(72)" no-label skip
     2928     v-waitfram-action02 format "x(72)" no-label skip
     2929     v-waitfram-action03 format "x(72)" no-label skip
     2930     B-viewProcInfo
     2931     B-WaitFramStop at row 4 col 30
     2932     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     2933     .
     2934   define new global shared variable mBatchMode as logical no-undo init ?.
     2935   define variable mFramBachModHandle as handle no-undo.
     2936   mFramBachModHandle = frame waitfram:handle.
     2937   define variable mFameOldVis as logical no-undo.
     2938   define variable mVisCUrentVin as logical no-undo.
     2939   if session:batch-mode
     2940   then
     2941      mBatchMode = yes.
     2942   if mBatchMode = ? then do:
     2943     mVisCUrentVin = current-window:visible.
     2944     mFameOldVis = mFramBachModHandle:visible.
     2945     mFramBachModHandle:visible  = yes.
     2946     mBatchMode = mFramBachModHandle:visible ne yes.
     2947     mFramBachModHandle:visible = mFameOldVis.
     2948     current-window:visible = mVisCUrentVin.
     2949   end.
     2950    if  log-manager:logfile-name ne ?
     2951     then DO:
     2952         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2953         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2954         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     2955     end.
     2956   on choose of B-WaitFramStop in frame waitfram
     2957   do:
     2958     mWaitFramStop = yes.
     2959     mWaitFramStopUser = yes.
     2960   end.
     2961   function waitfram-check-timeout returns logical():
     2962      define variable vtime as int64 no-undo.
     2963      if mWaitFramStopTimeOut
     2964      then
     2965         return yes.
     2966      vtime = ( now - mWaitFramStartProc ) / 1000 .
     2967      if     mWaitFramTimeOut ne ?
     2968         and mWaitFramTimeOut ne 0
     2969         and mWaitFramTimeOut lt vtime
     2970      then do:
     2971         mWaitFramStopTimeOut = yes.
     2972      end.
     2973      return mWaitFramStopTimeOut.
     2974   end.
     2975   procedure waitfram-hide :
     2976     if not session:batch-mode
     2977     then do
     2978     on error undo, return error return-value
     2979     :
     2980       pause 0 before-hide .
     2981       if not mBatchMode then
     2982         hide frame waitfram .
     2983     if     not mWaitFramView
     2984        and mWaitProcEvent
     2985     then
     2986       process events .
     2987     end.
     2988   end procedure.
     2989   procedure waitfram-show :
     2990     define input  parameter p-message as character no-undo .
     2991     define variable v-left-margin as integer   no-undo .
     2992     if not session:batch-mode
     2993     then do
     2994     on error undo, return error return-value
     2995     :
     2996       if length(p-message) <= 70 then do:
     2997         assign
     2998           v-left-margin = integer((70 - length(p-message)) / 2)
     2999         .
     3000         assign
     3001           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     3002         .
     3003         assign
     3004           v-waitfram-action01 = " "
     3005           v-waitfram-action02 = " "
     3006                                    + fill(" ", v-left-margin)
     3007                                    + p-message
     3008           v-waitfram-action03 = " "
     3009         .
     3010       end.
     3011       else do:
     3012         define variable vRindex1 as integer no-undo.
     3013         define variable vRindex2 as integer no-undo.
     3014         vRindex1 = r-index(p-message," ",70).
     3015         if vRindex1 = 0
     3016         then
     3017            vRindex1 = 70.
     3018         if length(p-message)  <= vRindex1 + 70 then do:
     3019           assign
     3020             v-waitfram-action01 = " "
     3021             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     3022             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     3023           .
     3024         end.
     3025         else do:
     3026           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     3027           if vRindex2 <= vRindex1
     3028           then
     3029              vRindex2 = vRindex1 + 70.
     3030           assign
     3031             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     3032             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     3033             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     3034           .
     3035         end.
     3036       end.
     3037       B-viewProcInfo:visible   in frame waitfram = no.
     3038       B-viewProcInfo:sensitive in frame waitfram = no.
     3039       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3040       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3041       if  (   mWaitFramView
     3042          or  mWaitProcEvent)
     3043          and not mBatchMode
     3044       then
     3045          display
     3046             v-waitfram-action01 skip
     3047             v-waitfram-action02 skip
     3048             v-waitfram-action03 skip
     3049          with frame waitfram .
     3050       if     mWaitFramView
     3051          then do:
     3052             if     mWaitFramInterval ne ?
     3053                and not mBatchMode
     3054             then
     3055                wait-for go of frame waitfram pause mWaitFramInterval.
     3056          end.
     3057          else
     3058             if     mWaitProcEvent
     3059                and not mBatchMode
     3060             then
     3061                process events .
     3062     end.
     3063   end procedure.
     3064      procedure waitfram-show-this:
     3065         define input  parameter iInterval as int64 no-undo.
     3066         define variable vtime as int64 no-undo.
     3067         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     3068         mWaitFramInterval = iInterval.
     3069         run waitfram-show (substitute("&1&2 &3&4" ,
     3070                                       mWaitFramTextBeg ,
     3071                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     3072                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     3073                                       mWaitFramTextEnd
     3074                                      )
     3075                           ).
     3076      end.
     3077      procedure WaitFramRunPause:
     3078         define input  parameter iInterval as dec no-undo.
     3079         define variable vStart  as datetime-tz no-undo.
     3080         define variable vend    as datetime-tz no-undo.
     3081         define variable vint as int64 no-undo.
     3082         define variable vOk as logical no-undo.
     3083         vStart = now.
     3084         vend   = vStart.
     3085         publish "WaitFramPause" (iInterval,output vOk).
     3086         vend   =  now.
     3087         vint = vend - vStart.
     3088         vint = iInterval - vint / 1000.
     3089         if     not mWaitFramStop
     3090            and (   vint > 0
     3091                 or (    not vOk
     3092                     and iInterval eq ?
     3093                     )
     3094                 )
     3095         then
     3096            run waitfram-show-this (iInterval).
     3097         vend   =  now.
     3098         vint = vend - vStart.
     3099         vint = iInterval - vint / 1000.
     3100         if     not mWaitFramStop
     3101            and vint > 0
     3102         then do:
     3103            run gbl/pause.p (vint * 1000).
     3104         end.
     3105         if iInterval ne ?
     3106         then
     3107            publish "WaitFramStop".
     3108         waitfram-check-timeout().
     3109      end.
     3110      procedure WaitFramWaitFor:
     3111         define input  parameter iInterval as dec no-undo.
     3112         assign
     3113            mWaitFramStartProc   = now
     3114            mWaitFramStopUser    = no
     3115            mWaitFramStopTimeOut = no
     3116         .
     3117         block-wait:
     3118         do while not mWaitFramStop:
     3119            run WaitFramRunPause (iInterval).
     3120            if  waitfram-check-timeout()
     3121            then do:
     3122               leave block-wait.
     3123            end.
     3124         end.
     3125         run waitfram-hide.
     3126      end.
     3127   procedure waitfram-join :
     3128     define input  parameter p-line-1  as character no-undo .
     3129     define input  parameter p-line-2  as character no-undo .
     3130     define input  parameter p-line-3  as character no-undo .
     3131     define output parameter p-message as character no-undo .
     3132     do
     3133     on error undo, return error return-value
     3134     :
     3135       assign
     3136         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     3137                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     3138                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     3139       .
     3140     end.
     3141   end procedure.
     3142   function waitfram-join-function returns character
     3143     (input p-line-1 as character
     3144     ,input p-line-2 as character
     3145     ,input p-line-3 as character
     3146     ).
     3147     define variable v-message as character no-undo .
     3148     run waitfram-join in this-procedure
     3149       (input  p-line-1
     3150       ,input  p-line-2
     3151       ,input  p-line-3
     3152       ,output v-message
     3153       ) .
     3154     return v-message .
     3155   end function .
     3156   define variable mHSocket       as handle      no-undo.
     3157   define variable mWebRespHead   as longchar    no-undo.
     3158   define variable mWebResp       as longchar    no-undo.
     3159   define variable mWebRespMptr   as memptr      no-undo.
     3160   define variable OerrMsg        as character   no-undo.
     3161   define variable mFileLogSocet  as character   no-undo.
     3162   define variable mReturnHttp    as logical     no-undo.
     3163   define variable mAddTimeOut    as logical     no-undo init yes.
     3164   define variable mSocetBegTime  as datetime-tz no-undo.
     3165   define variable mSocetEndTime  as dec         no-undo.
     3166   define variable mWriteRespFile as character   no-undo.
     3167   define variable mTypeResponse  as character   no-undo init "POST".
     3168   publish "getSocetLog" (output mFileLogSocet).
     3169   if
     3170      (   mFileLogSocet eq ""
     3171       or mFileLogSocet eq ?)
     3172      and session:debug-alert
     3173   then
     3174      mFileLogSocet = "socet.log".
     3175   procedure ConectSocet:
     3176      define input  parameter iHost       as character no-undo.
     3177      define input  parameter iPort       as character no-undo.
     3178      define input  parameter iUrl        as character no-undo.
     3179      define input  parameter iPostData   as longchar  no-undo.
     3180      define input  parameter iReturnType as character no-undo.
     3181      define input  parameter iTimeOut    as decimal   no-undo.
     3182      define input  parameter iSilent     as logical   no-undo.
     3183      define input  parameter iTextWait   as character no-undo.
     3184      mWaitFramTextBeg = iTextWait.
     3185      run SendReqSocet (iHost, iPort, iUrl, iPostData, iReturnType, 'getResponse').
     3186      if OerrMsg eq ""
     3187      then
     3188         run waitrespsocet (iTimeOut, iSilent, iTextWait).
     3189      mSocetEndTime = (now - mSocetBegTime) / 1000.
     3190   end.
     3191   procedure SendReqSocet:
     3192      define input  parameter iHost            as character no-undo.
     3193      define input  parameter iPort            as character no-undo.
     3194      define input  parameter iUrl             as character no-undo.
     3195      define input  parameter iPostData        as longchar  no-undo.
     3196      define input  parameter iReturnType      as character no-undo.
     3197      define input  parameter iProcGetResponse as character no-undo.
     3198      mSocetBegTime = now.
     3199      run writeLogSocet in this-procedure (substitute("Подключаемся к адресу &1 по порту &2",iHost,iPort )).
     3200      assign
     3201         mWebResp         = ""
     3202         mWebResphead     = ""
     3203         OerrMsg          = ""
     3204         mReturnHttp      = iReturnType eq "xml" or iReturnType eq "http" or iReturnType eq "yes"
     3205         iProcGetResponse = "getResponse"  when iProcGetResponse eq ? or iProcGetResponse eq ""
     3206      .
     3207      define variable vPostData as longchar                       no-undo.
     3208      if    iHost eq ""
     3209         or iHost eq ?
     3210      then do:
     3211         oErrMsg = substitute("Не задан host &1 или port &2.", ihost ,iport).
     3212         run writeLogSocet in this-procedure (oErrMsg).
     3213         return oErrMsg.
     3214      end.
     3215      run waitfram-show (substitute("Подключаемся к адресу &1 по порту &2",iHost,iPort )).
     3216      create socket mHSocket.
     3217      mHSocket:connect('-H ' + iHost + ' -S ' + iPort) no-error.
     3218      if mHSocket:connected() = false
     3219      then do:
     3220         run waitfram-hide .
     3221         oErrMsg = substitute( "Не удалось установить соединение: &1" , error-status:get-message(1)).
     3222         run writeLogSocet in this-procedure (oErrMsg).
     3223         delete object mHSocket.
     3224         return oErrMsg.
     3225      end.
     3226      run waitfram-show ("Отправка данных").
     3227      mHSocket:set-read-response-procedure(iProcGetResponse).
     3228      run PostRequest (
     3229       input iUrl,
     3230       input iHost + ":" + iPort,
     3231       input iPostData
     3232       ).
     3233       run waitfram-hide .
     3234   end.
     3235   procedure WaitRespSocet:
     3236      define input  parameter iTimeOut   as decimal   no-undo.
     3237      define input  parameter iSilent    as logical   no-undo.
     3238      define input  parameter iTextWait  as character no-undo.
     3239      if    not valid-handle (mHSocket )
     3240      then do:
     3241         run writeLogSocet in this-procedure (substitute("Потерян объект соединения")).
     3242         return "End connected".
     3243      end.
     3244      if mHSocket:connected() = false
     3245      then do:
     3246         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной WaitRespSocet")).
     3247         oErrMsg = "Not connected".
     3248         return oErrMsg.
     3249      end.
     3250      mWaitFramView = if iSilent ne yes then yes else no.
     3251      mWaitFramTextBeg = iTextWait.
     3252      mWaitFramTimeOut = iTimeOut.
     3253      mWaitFramTextEnd = "".
     3254      mWaitFramStop = no.
     3255      if mAddTimeOut
     3256      then do:
     3257         mWaitFramTimeOut = 300.
     3258         run writeLogSocet in this-procedure (substitute ("Таймаут увеличен до &1 при уcтановке соодинения",mWaitFramTimeOut)).
     3259      end.
     3260      run writeLogSocet in this-procedure (substitute("Ожидаем ответ TimeOut &1 сек.",iTimeOut )).
     3261      subscribe   to "WaitFramStop" anywhere run-procedure "WaitRespTestStop".
     3262      run WaitFramWaitFor(1).
     3263      unsubscribe "WaitFramStop".
     3264      if mWaitFramStopUser
     3265      then do:
     3266         OerrMsg = substitute("Операция прервана пользователем." ).
     3267         run writeLogSocet in this-procedure (OerrMsg).
     3268      end.
     3269      else if mWaitFramStopTimeOut
     3270      then do:
     3271         OerrMsg = substitute("Привышено время ожидания &1 сек. Ответ не получен.",iTimeOut ).
     3272         run writeLogSocet in this-procedure (OerrMsg).
     3273      end.
     3274      run waitfram-hide .
     3275      mHSocket:disconnect() no-error.
     3276      delete object mHSocket.
     3277   end.
     3278   procedure WaitRespTestStop:
     3279      if mWaitFramStopTimeOut
     3280      then
     3281         return.
     3282      if     (mWebResp ne ""
     3283          and mWebResp ne ?)
     3284      then do:
     3285         mWaitFramStop = yes.
     3286         return.
     3287      end.
     3288      else if mHSocket:connected() = false
     3289      then do:
     3290         mWaitFramStop = yes.
     3291         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной WaitRespTestStop")).
     3292         oErrMsg = "Not connected".
     3293         return oErrMsg.
     3294      end.
     3295      wait-for read-response of mHSocket pause 0.001.
     3296   end.
     3297   procedure PostRequest:
     3298      define input parameter iPostUrl  as char.
     3299      define input parameter iPostHost as char.
     3300      define input parameter iPostData as longchar.
     3301      define variable vCRequest      as longchar.
     3302      define variable vMRequest       as memptr.
     3303      if iPostUrl ne ?
     3304      then do:
     3305         vCRequest =substitute(
     3306         '&5 /&2 HTTP/1.1&1'                                   +
     3307         'Host: &4&1'                                           +
     3308         'User-Agent: Apache-HttpClient/4.1.1 (java 1.5)&1'    +
     3309         'Accept: */*&1' +
     3310         'Content-Type: text/xml&1'               +
     3311         'Content-Length: &3&1'                                  +
     3312         '&1'
     3313         ,
     3314         chr(13) + chr(10),
     3315         iPostUrl,
     3316         length(iPostData),
     3317         iPostHost,
     3318         mTypeResponse) + iPostData.
     3319      end.
     3320      else
     3321         vCRequest = iPostData.
     3322      run writeLogSocet in this-procedure (substitute("Отправляем запрос &1.",chr(13) + chr(10) )).
     3323      run writeLogSocet in this-procedure (vCRequest).
     3324      SET-SIZE(vMRequest)            = 0.
     3325      SET-SIZE(vMRequest)            = length(vCRequest) + 1.
     3326      SET-BYTE-ORDER(vMRequest)      = big-endian.
     3327      PUT-STRING(vMRequest,1)        = vCRequest .
     3328      if mHSocket:connected() = false then
     3329      do:
     3330         run writeLogSocet in this-procedure ("Соединение было разорвано другой стороной getResponse").
     3331         oErrMsg = "Not connected".
     3332         delete object mHSocket no-error.
     3333         return oErrMsg.
     3334      end.
     3335      mHSocket:write(vMRequest, 1, length(vCRequest)).
     3336      run writeLogSocet in this-procedure ("Запрос отправлен.").
     3337   end procedure.
     3338   function hex-to-int returns integer (
     3339     input p-hex-code  as character  ).
     3340     define variable v-int-code as integer   no-undo .
     3341     define variable v-ind      as integer   no-undo .
     3342     define variable v-digit    as integer   no-undo .
     3343     define variable v-letter   as character no-undo .
     3344     do v-ind = 1 to length(p-hex-code)
     3345     :
     3346       assign
     3347         v-letter = caps(substring(p-hex-code, v-ind, 1))
     3348       .
     3349       assign
     3350         v-digit = index('123456789ABCDEF':u, v-letter)
     3351       .
     3352       assign
     3353         v-int-code = v-int-code * 16 + v-digit
     3354       .
     3355     end.
     3356     return v-int-code .
     3357   end function .
     3358   procedure getResponse:
     3359      define variable vFlagTag     as logical          no-undo init no.
     3360      define variable vResponse    as memptr           no-undo.
     3361      define variable vCnt         as int64            no-undo.
     3362      define variable vMessage     as longchar         no-undo.
     3363      define variable v-cont-length as int64 no-undo.
     3364      define variable vi           as integer no-undo.
     3365      define variable v-hd-line    as character no-undo.
     3366      define variable level        as integer no-undo initial 2.
     3367      repeat while program-name(level) <> ?:
     3368        if program-name(level) = program-name(1) then do:
     3369          run writeLogSocet in this-procedure (substitute("Повторный вызов getResponse.")).
     3370          return "".
     3371        end.
     3372        level = level + 1.
     3373      end.
     3374      if mHSocket:connected() = false then
     3375      do:
     3376         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной getResponse")).
     3377         oErrMsg = "Not connected".
     3378         return oErrMsg.
     3379      end.
     3380      if mAddTimeOut
     3381      then do:
     3382         mWaitFramTimeOut = 1000.
     3383         run writeLogSocet in this-procedure (substitute ("Таймаут увеличен до &1 при получении ответа",mWaitFramTimeOut)).
     3384      end.
     3385      run writeLogSocet in this-procedure (substitute("Получаем ответ")).
     3386      mWaitFramTextEnd = "Получаем ответ".
     3387      define variable vWaitProcEvent as logical no-undo.
     3388      vWaitProcEvent = mWaitProcEvent.
     3389      mWaitProcEvent = no.
     3390      run WaitFramRunPause (?).
     3391      define variable vByte as int64 no-undo.
     3392      define variable vNextMese as int64 no-undo init 100000.
     3393      define variable VFlag as logical no-undo init ? .
     3394      mWaitFramStop = no.
     3395      mWaitFramStopTimeOut = no.
     3396      block-wait:
     3397      do while mHSocket:get-bytes-available() > 0:
     3398         VFlag = no.
     3399         define variable vNumByte as integer no-undo.
     3400         vNumByte =   mHSocket:get-bytes-available().
     3401         if vNumByte > 30000 then vNumByte = 30000.
     3402         SET-SIZE(vResponse) = vNumByte + 1.
     3403         SET-BYTE-ORDER(vResponse) = big-endian.
     3404         mHSocket:read(vResponse,1,vNumByte).
     3405         vMessage = vMessage + GET-STRING(vResponse,1).
     3406         if  mReturnHTTp
     3407         then do:
     3408            vCnt = index(vMessage,chr(13) + chr(10) + chr(13) + chr(10)).
     3409            if vCnt > 0
     3410            then do:
     3411               mReturnHttp = no.
     3412               mWebResphead = substring (vMessage,1,vCnt).
     3413               vMessage     = substring (vMessage,vCnt + 4).
     3414               mWebResphead = replace (mWebResphead,";",chr(13) + chr(10)).
     3415               do vi = 1 to num-entries(mWebResphead,chr(13) + chr(10)):
     3416                  v-hd-line = trim(entry(vi,mWebResphead,chr(13) + chr(10))).
     3417                  if  v-hd-line  begins "Content-Length"  then  do:
     3418                     v-cont-length = INT(trim(substring(v-hd-line,16,length(v-hd-line)))).
     3419                  end.
     3420                  else if v-hd-line  begins "Transfer-Encoding"
     3421                  then do :
     3422                     define variable vChunked as logical no-undo.
     3423                     vchunked = index(v-hd-line,"chunked",19) > 0.
     3424                  end.
     3425               end.
     3426            end.
     3427         end.
     3428         vByte = vByte + vNumByte.
     3429         SET-SIZE(vResponse) = 0.
     3430         if v-cont-length > 0 and length (vMessage) >= v-cont-length
     3431         then
     3432            leave block-wait.
     3433         if not mHSocket:get-bytes-available() > 0
     3434         then do:
     3435            VFlag = yes.
     3436            run WaitFramRunPause (?).
     3437            run gbl/pause.p (1000) .
     3438         end.
     3439         else if vByte > vNextMese
     3440         then do:
     3441            vNextMese = vNextMese + 100000.
     3442            mWaitFramTextEnd = substitute ("Получаем ответ прочитано &1 байт ",vByte) .
     3443            run WaitFramRunPause (?).
     3444         end.
     3445         if mWaitFramStopTimeOut
     3446         then do:
     3447            mWebResp = "".
     3448            leave block-wait.
     3449         end.
     3450      end.
     3451      if VFlag ne false
     3452      then
     3453         run writeLogSocet in this-procedure (substitute ("Завершена обработка &1",If VFlag eq  yes then " 0 байт за последнию секунду" else " пустой ответ(((")).
     3454      mWaitFramStop = yes.
     3455      run writeLogSocet         in this-procedure ("Получен ответ").
     3456      run writeLogSocetOnlyText in this-procedure (mWebResphead).
     3457      run writeLogSocetOnlyText in this-procedure (substitute("&1&2&1&2",chr(13) , chr(10) )).
     3458      run writeLogSocetOnlyText in this-procedure (vMessage).
     3459      run writeLogSocetOnlyText in this-procedure (substitute("&1&2",chr(13) , chr(10) )).
     3460      mHSocket:disconnect() no-error.
     3461      if v-cont-length > 0
     3462      then
     3463         mWebResp = substring (vMessage,1,v-cont-length).
     3464      else if vChunked
     3465      then do:
     3466         define variable vByteCopy as int64 no-undo init 1.
     3467         Block-Copy:
     3468         do while length(vMessage) > 0:
     3469            vByteCopy = 1.
     3470            vCnt = index (vMessage,chr(13) + chr(10)) - 1.
     3471            vByteCopy = vByteCopy +  vCnt + 2.
     3472            v-cont-length = hex-to-int(string(substring (vMessage,1,vCnt))).
     3473            if v-cont-length eq 0
     3474            then
     3475               leave Block-copy.
     3476            mWebResp = mWebResp + substring (vMessage,vByteCopy,  v-cont-length).
     3477            vByteCopy = vByteCopy + v-cont-length + 2.
     3478            vMessage = substring  (vMessage,vByteCopy).
     3479         end.
     3480         run writeLogSocet         in this-procedure ("Заголовок").
     3481         run writeLogSocetOnlyText in this-procedure (mWebResphead).
     3482         run writeLogSocet         in this-procedure ("Тело ответа").
     3483         run writeLogSocetOnlyText in this-procedure (mWebResp).
     3484        run writeLogSocetOnlyText in this-procedure (substitute("&1&2",chr(13) , chr(10) )).
     3485      end.
     3486      else
     3487         mWebResp = vMessage.
     3488      mWaitProcEvent = vWaitProcEvent.
     3489      mSocetEndTime = (now - mSocetBegTime) / 1000.
     3490      copy-lob mWebResp to mWebRespMptr.
     3491      if     mWriteRespFile ne ""
     3492         and mWriteRespFile ne ?
     3493      then
     3494           run gbl/fileapnd.p
     3495                ( mWriteRespFile
     3496                , mWebResp + chr(13) + chr(10)
     3497                ,input 10
     3498                ) no-error .
     3499   end procedure.
     3500   procedure writeLogSocet:
     3501      define input  parameter itext as longchar no-undo.
     3502      if mFileLogSocet eq "Async"
     3503      then
     3504         run PutMesAsunc(itext).
     3505      else if     mFileLogSocet ne ?
     3506              and mFileLogSocet ne ""
     3507      then do:
     3508         run gbl/fileapnd.p
     3509             ( mFileLogSocet
     3510             , substitute("&1 &2 ", string(today), string(time, "HH:MM:SS"))
     3511             ,input 10
     3512             ) no-error .
     3513         run writeLogSocetOnlyText(itext).
     3514         run gbl/fileapnd.p
     3515             ( mFileLogSocet
     3516             , substitute(" &1&2", chr(13) , chr(10))
     3517             ,input 10
     3518             ) no-error .
     3519      end.
     3520   end.
     3521   procedure writeLogSocetOnlyText:
     3522      define input  parameter itext as longchar no-undo.
     3523      if mFileLogSocet eq "Async"
     3524      then
     3525         run PutMesAsunc(itext).
     3526      else if     mFileLogSocet ne ?
     3527              and mFileLogSocet ne ""
     3528      then do:
     3529         if length(itext) > 32000
     3530         then
     3531            copy-lob
     3532      from object itext
     3533      to file mFileLogSocet append
     3534      no-error
     3535      .
     3536         else
     3537         run gbl/fileapnd.p
     3538             ( mFileLogSocet
     3539             , string(itext)
     3540             ,input 10
     3541             ) no-error .
     3542      end.
     3543   end.
     3544   procedure Disconect:
     3545      mHSocket:disconnect() no-error.
     3546      delete object mHSocket no-error.
     3547   end.
     3548   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3549   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3550     (input  p-obj-type
     3551     ,input  p-obj-code
     3552     ,output v-host-code
     3553     )  .
     3554   _cash-desk:
     3555   FOR EACH buf_cash-desk WHERE
     3556      buf_cash-desk.db-num   = g#db-num
     3557      and buf_cash-desk.obj-code = p-obj-code
     3558      and buf_cash-desk.pos-type = 'IBM-XML':U
     3559      and buf_cash-desk.cash-on  = yes
     3560      no-lock:
     3561      run gen-key-rec in this-procedure ( input 'cash-desk':U
     3562         ,input (buffer buf_cash-desk:handle)
     3563         ,output v-uniq-key-rec).
     3564      p-parameter = substitute("&1=ffd,&2"
     3565         ,buf_cash-desk.pos-type
     3566         ,v-uniq-key-rec).
     3567      if num-entries(p-parameter, chr(4)) > 7 then
     3568      do:
     3569         p-other = p-parameter.
     3570         entry(1, p-other, chr(4)) = ''.
     3571         p-other = substring(p-other, 2).
     3572         entry(1, p-other, chr(4)) = ''.
     3573         p-other = substring(p-other, 2).
     3574         entry(1, p-other, chr(4)) = ''.
     3575         p-other = substring(p-other, 2).
     3576         entry(1, p-other, chr(4)) = ''.
     3577         p-other = substring(p-other, 2).
     3578         entry(1, p-other, chr(4)) = ''.
     3579         p-other = substring(p-other, 2).
     3580         entry(1, p-other, chr(4)) = ''.
     3581         p-other = substring(p-other, 2).
     3582         entry(1, p-other, chr(4)) = ''.
     3583         p-other = substring(p-other, 2).
     3584      end.
     3585      run xml-cd-filename in this-procedure (
     3586         input out
     3587         ,output v-xml-file-name
     3588         ,output v-xml-file-name-path
     3589         ,output v-log-file-name
     3590         ,output v-locked
     3591         ).
     3592      assign
     3593         v-obj-list = 'маг':U + string(buf_cash-desk.obj-code)
     3594         .
     3595      create sax-writer hSAXWriter.
     3596      hSAXWriter:set-output-destination("longchar", Mreq) no-error.
     3597      hSAXWriter:formatted = true.
     3598      hSAXWriter:encoding = "windows-1251".
     3599      hSAXWriter:start-document() no-error.
     3600      define variable OS-time as character  no-undo.
     3601      OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" ).
     3602      hSAXWriter:start-element("config") no-error.
     3603      hSAXWriter:insert-attribute("type",   "REQUEST")       no-error.
     3604      hSAXWriter:insert-attribute("id",     v-xml-file-name) no-error.
     3605      hSAXWriter:insert-attribute("from",   string(v-obj-list))      no-error.
     3606      hSAXWriter:insert-attribute("to",     (v-obj-list + "_":U + "касса" + string(buf_cash-desk.cash-num))) no-error.
     3607      hSAXWriter:insert-attribute("tstamp", string(OS-time))     no-error.
     3608      define variable mi as integer no-undo.
     3609      define variable vListParam as character no-undo init "~
     3610   USE_FFD_VERSION,~
     3611   KKT_FFD_VERSION,~
     3612   KKT_SCHEMA,~
     3613   GISMT_CHECK_TIMEOUT,~
     3614   GISMT_OPENCON_TIMEOUT,~
     3615   GISMT_FAST_ANSWER".
     3616      do mi = 1 to num-entries(vListParam):
     3617         hSAXWriter:START-ELEMENT("Param").
     3618         hSAXWriter:insert-attribute("ctrl",   "READ"              )   no-error.
     3619         hSAXWriter:insert-attribute("group",  "OFD"               )    no-error.
     3620         hSAXWriter:insert-attribute("key",    entry(mi,vListParam))    no-error.
     3621         hSAXWriter:END-ELEMENT("Param" ).
     3622      end.
     3623      hSAXWriter:end-element("config") no-error.
     3624      hSAXWriter:end-document() no-error.
     3625      if hSAXWriter:write-status = 7 then do:
     3626         delete object hSAXWriter no-error.
     3627         return error.
     3628      end.
     3629      delete object hSAXWriter no-error.
     3630      log-file-name = (if p-auto = 0 then 'get-chkf.log' else 'extgetcd.log').
     3631      run str/get-inis.p (
     3632         input p-obj-type
     3633         , input p-obj-code
     3634         , input buf_cash-desk.pos-type
     3635         , input buf_cash-desk.remote
     3636         , input "get":U
     3637         , output out
     3638         , output out2
     3639         , output in_
     3640         , output spl
     3641         , output sav
     3642         , output v-remote
     3643         )  no-error .
     3644      if error-status:error then
     3645      do:
     3646         run write-log-and-file in p-log-handle (
     3647            input 1
     3648            , input log-file-name
     3649            , input 1
     3650            , input substitute(
     3651            "!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     3652            , buf_cash-desk.pos-type
     3653            , p-obj-code
     3654            , chr(10)
     3655            , error-status:get-message(1)
     3656            , return-value
     3657            )).
     3658         assign
     3659            v-view-log = yes.
     3660      end.
     3661      run write-log-and-file in p-log-handle (
     3662                         input 1
     3663                       , input log-file-name
     3664                       , input 1
     3665                       , input substitute('Получаем параметры ФФД с кассы &1://&2'
     3666                                     ,entry(1, buf_cash-desk.addr-path, chr(4))
     3667                                     ,entry(2, buf_cash-desk.addr-path, chr(4))
     3668                                   )
     3669                                                         ).
     3670      mWriteRespFile = replace(in_ + sav + "/" + v-xml-file-name, "/", "\" ) + ".xml_sckt".
     3671      run ConectSocet (entry(1,entry(2, buf_cash-desk.addr-path, chr(4)),":"),
     3672                       entry(2,entry(2, buf_cash-desk.addr-path, chr(4)),":"),
     3673                       "",
     3674                       Mreq,
     3675                       "xml",
     3676                       30,
     3677                       no,
     3678                       substitute ("Чтение параметры ФФД с кассы &1. ",entry(2, buf_cash-desk.addr-path, chr(4)))
     3679                       ).
     3680      if mWebResp eq ""
     3681      then do:
     3682         run write-log-and-file in p-log-handle (
     3683             input 1
     3684           , input log-file-name
     3685           , input 1
     3686           , input substitute( "!!!Касса &1 маг&2 не ответила:&3&4 &5"
     3687                                 ,buf_cash-desk.cash-num
     3688                                 ,buf_cash-desk.obj-code
     3689                                 , chr(10)
     3690                                 , OerrMsg
     3691                                 , return-value
     3692                             )
     3693                                             ).
     3694          NEXT _cash-desk.
     3695       end.
     3696       else do:
     3697          run write-log-and-file in p-log-handle (
     3698             input 1
     3699           , input log-file-name
     3700           , input 1
     3701           , input substitute('Время ожидания выполнения задания на кассе - &1 c',
     3702                         mSocetEndTime
     3703                       )
     3704                                             ).
     3705      end.
     3706      assign
     3707         v-index = index(p-other, buf_cash-desk.pos-type + '=').
     3708      if v-index > 0 then
     3709      do:
     3710         assign
     3711            v-spec-command = substring(p-other, v-index)
     3712            v-index        = index(v-spec-command , chr(4))
     3713            v-spec-command = if v-index > 0
     3714                           then substring(v-spec-command , 1, v-index - 1)
     3715                           else v-spec-command
     3716            v-spec-command = replace(v-spec-command, buf_cash-desk.pos-type + '=', '':U)
     3717            .
     3718      end.
     3719      run str/getxibmf.p (
     3720         input parparentproc
     3721         ,input p-log-handle
     3722         ,input p-obj-type
     3723         ,input p-obj-code
     3724         ,input v-host-code
     3725         ,input in_
     3726         ,input spl
     3727         ,input (in_ + sav)
     3728         ,input buf_cash-desk.pos-type
     3729         ,input "utf-8":U
     3730         ,input log-file-name
     3731         ,input "readbuffer_config":U + chr(4) + v-spec-command
     3732         ,input mWebResp
     3733         ,input-output v-view-log
     3734         ) no-error .
     3735      run write-log-and-file in p-log-handle (
     3736         input 1
     3737         , input p-log-file-name
     3738         , input 1
     3739         , input "Получение параметров ФФД завершено").
     3740      p-ok = true.
     3741   end.
