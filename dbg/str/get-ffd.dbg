      652   procedure get-last-check-date-time :
      653       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      654       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      655       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      656       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      657       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      658       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      659       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      660       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      661       define variable v-character as character no-undo .
      662       define variable v-date      as date      no-undo .
      663       define variable v-decimal   as decimal   no-undo .
      664       define variable v-integer   as integer   no-undo .
      665       define variable v-logical   as logical   no-undo .
      666       define variable v-attr-type as character no-undo .
      667       define buffer buf_chk-doc     for ub.chk-doc.
      668       define buffer buf_c-cash-desk for ub.c-cash-desk.
      669       do
      670           on error undo, return error
      671           :
      672           run cd-attr-value in this-procedure (
      673               input g#db-num
      674               ,input p-obj-code
      675               ,input p-pos-type
      676               ,input p-cash-num
      677               ,input 'MAGIA-XML_operative':U
      678               ,input 'last-check-date-time':U
      679               ,output v-character
      680               ,output v-date
      681               ,output v-decimal
      682               ,output v-integer
      683               ,output v-logical
      684               ,output v-attr-type     ) no-error.
      685           if v-character = "":U
      686               or v-character = ?
      687               then
      688           do:
      689               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      690                   buf_c-cash-desk.db-num = g#db-num
      691                   AND buf_c-cash-desk.pos-type = p-pos-type
      692                   AND buf_c-cash-desk.cash-num = p-cash-num
      693                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      694                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      695               if available buf_c-cash-desk then
      696               do:
      697                   assign
      698                       p-date = buf_c-cash-desk.corr-date
      699                       p-time = buf_c-cash-desk.corr-time
      700                       .
      701               end.
      702               else
      703               do:
      704                   find first buf_chk-doc no-lock where
      705                       buf_chk-doc.obj-type = 'маг':U
      706                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      707                   if not available buf_chk-doc then
      708                   do:
      709                       return error.
      710                   end.
      711                   assign
      712                       p-date = buf_chk-doc.chk-date - 1
      713                       p-time = buf_chk-doc.chk-time
      714                       .
      715               end.
      716           end.
      717           else
      718           do:
      719               assign
      720                   p-date = cd-attr-parse-date-time( v-character, output p-time )
      721           no-error .
      722               if error-status:error then return error .
      723           end.
      724       end.
      725   end procedure.
      726   procedure get-last-check-params :
      727       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      728       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      729       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      730       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      731       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      732       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      733       define output parameter p-shift-num like ub.chk-doc.shift-num no-undo init 0.
      734       define output parameter p-z-count like ub.chk-doc.z-number no-undo init 0.
      735       define output parameter p-chk-num like ub.chk-doc.chk-num no-undo init 0.
      736       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      737       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      738       define variable v-character as character no-undo .
      739       define variable v-date      as date      no-undo .
      740       define variable v-decimal   as decimal   no-undo .
      741       define variable v-integer   as integer   no-undo .
      742       define variable v-logical   as logical   no-undo .
      743       define variable v-attr-type as character no-undo .
      744       define buffer buf_chk-doc     for ub.chk-doc.
      745       define buffer buf_c-cash-desk for ub.c-cash-desk.
      746       do
      747           on error undo, return error
      748           :
      749           run cd-attr-value in this-procedure (
      750               input g#db-num
      751               ,input p-obj-code
      752               ,input p-pos-type
      753               ,input p-cash-num
      754               ,input if p-pos-type eq 'IBM-XML':U
      755               then 'IBM-XML_operative':U
      756               else 'AUTOTANK_operative':U
      757               ,input if p-pos-type = 'IBM-XML':U
      758               then 'last-check-params':U
      759               else 'last-check-params':U
      760               ,output v-character
      761               ,output v-date
      762               ,output v-decimal
      763               ,output v-integer
      764               ,output v-logical
      765               ,output v-attr-type     ) no-error.
      766           if v-character = "":U
      767               or v-character = ?
      768               then
      769           do:
      770               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      771                   buf_c-cash-desk.db-num = g#db-num
      772                   AND buf_c-cash-desk.pos-type = p-pos-type
      773                   AND buf_c-cash-desk.cash-num = p-cash-num
      774                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      775                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      776               if available buf_c-cash-desk then
      777               do:
      778                   assign
      779                       p-date = buf_c-cash-desk.corr-date
      780                       p-time = buf_c-cash-desk.corr-time
      781                       .
      782               end.
      783               else
      784               do:
      785                   find first buf_chk-doc no-lock where
      786                       buf_chk-doc.obj-type = 'маг':U
      787                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      788                   if not available buf_chk-doc then
      789                   do:
      790                       return error.
      791                   end.
      792                   assign
      793                       p-date      = buf_chk-doc.chk-date - 1
      794                       p-time      = buf_chk-doc.chk-time
      795                       p-shift-num = buf_chk-doc.shift-num
      796                       p-z-count   = buf_chk-doc.z-number
      797                       p-chk-num   = buf_chk-doc.chk-num
      798                       .
      799               end.
      800           end.
      801           else
      802           do:
      803               assign
      804                   p-date      = cd-attr-parse-date-time( substring(v-character, 1, 19), output p-time )
      805                   p-shift-num = integer(entry(3, v-character, chr(32) ))
      806                   p-shift-num = (if p-shift-num = ? then 0 else p-shift-num)
      807                   p-z-count   = integer(entry(4, v-character, chr(32) ))
      808                   p-z-count   = (if p-z-count = ? then 0 else p-z-count)
      809                   p-chk-num   = integer(entry(5, v-character, chr(32) ))
      810           no-error .
      811               if error-status:error then return error .
      812           end.
      813       end.
      814   end procedure.
      815   procedure get-last-report-params :
      816       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      817       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      818       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      819       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      820       define output parameter p-date like ub.chk-slip-head.slip-dt no-undo .
      821       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      822       define output parameter p-shift-num like ub.chk-slip-head.CashShiftNum no-undo init 0.
      823       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      824       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      825       define variable v-character as character no-undo .
      826       define variable v-date      as date      no-undo .
      827       define variable v-decimal   as decimal   no-undo .
      828       define variable v-integer   as integer   no-undo .
      829       define variable v-logical   as logical   no-undo .
      830       define variable v-date1     as character no-undo .
      831       define variable v-date2     as character no-undo .
      832       define variable v-attr-type as character no-undo .
      833       define buffer buf_chk-slip-head for ub.chk-slip-head.
      834       define buffer buf_c-cash-desk   for ub.c-cash-desk.
      835       do
      836           on error undo, return error
      837           :
      838           run cd-attr-value in this-procedure (
      839               input g#db-num
      840               ,input p-obj-code
      841               ,input p-pos-type
      842               ,input p-cash-num
      843               ,input if p-pos-type eq 'IBM-XML':U
      844               then 'IBM-XML_operative':U
      845               else 'AUTOTANK_operative':U
      846               ,input if p-pos-type = 'IBM-XML':U
      847               then 'last-report-params':U
      848               else 'last-report-params':U
      849               ,output v-character
      850               ,output v-date
      851               ,output v-decimal
      852               ,output v-integer
      853               ,output v-logical
      854               ,output v-attr-type     ) no-error.
      855           if v-character = "":U
      856               or v-character = ?
      857               then
      858           do:
      859               find last buf_chk-slip-head no-lock where
      860                   buf_chk-slip-head.obj-code = p-obj-code
      861                   and buf_chk-slip-head.cash-num = p-cash-num
      862                   and buf_chk-slip-head.db-num = p-db-num
      863                   and buf_chk-slip-head.is-report = 1 no-error.
      864               if not available buf_chk-slip-head then
      865               do:
      866                   return error.
      867               end.
      868               v-date2 = entry(2,string(buf_chk-slip-head.slip-dt)," ") .
      869               v-date1 = string(substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 7, 4 )) + "-" +
      870                   string( substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 4, 2 ) ) + "-" +
      871                   string( substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 1, 2 ) )
      872                   + " " + entry(1,v-date2,".") .
      873               assign
      874                   p-date      = cd-attr-parse-date-time( string(v-date1), output p-time )
      875                   p-shift-num = buf_chk-slip-head.CashShiftNum
      876                   .
      877           end.
      878           else
      879           do:
      880               assign
      881                   p-date      = cd-attr-parse-date-time( substring(v-character, 1, 19), output p-time )
      882                   p-shift-num = integer(entry(3, v-character, chr(32) ))
      883                   p-shift-num = (if p-shift-num = ? then 0 else p-shift-num)
      884           no-error .
      885               if error-status:error then return error .
      886           end.
      887       end.
      888   end procedure.
      889   procedure get-last-check-maria :
      890       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      891       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      892       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      893       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      894       define output parameter p-z-count like ub.chk-doc.z-number no-undo init 0.
      895       define output parameter p-num-recs as integer no-undo .
      896       define output parameter p-p-date like ub.chk-doc.chk-date no-undo .
      897       define output parameter p-p-z-count like ub.chk-doc.z-number no-undo init 0.
      898       define output parameter p-p-num-recs as integer no-undo .
      899       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      900       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      901       define variable v-character as character no-undo .
      902       define variable v-date      as date      no-undo .
      903       define variable v-decimal   as decimal   no-undo .
      904       define variable v-integer   as integer   no-undo .
      905       define variable v-logical   as logical   no-undo .
      906       define variable v-attr-type as character no-undo .
      907       define buffer buf_chk-doc     for ub.chk-doc.
      908       define buffer buf_c-cash-desk for ub.c-cash-desk.
      909       do
      910           on error undo, return error
      911           :
      912           run cd-attr-value in this-procedure (
      913               input p-db-num
      914               ,input p-obj-code
      915               ,input 'MARIA':U
      916               ,input p-cash-num
      917               ,input 'MARIA_operative':U
      918               ,input 'last-check-maria':U
      919               ,output v-character
      920               ,output v-date
      921               ,output v-decimal
      922               ,output v-integer
      923               ,output v-logical
      924               ,output v-attr-type     ) no-error.
      925           if v-character = "":U
      926               or v-character = ?
      927               then
      928           do:
      929               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      930                   buf_c-cash-desk.db-num = p-db-num
      931                   AND buf_c-cash-desk.pos-type = 'MARIA':U
      932                   AND buf_c-cash-desk.cash-num = p-cash-num
      933                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      934                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      935               if available buf_c-cash-desk then
      936               do:
      937                   assign
      938                       p-date   = buf_c-cash-desk.corr-date
      939                       p-p-date = buf_c-cash-desk.corr-date
      940                       .
      941               end.
      942               else
      943               do:
      944                   find first buf_chk-doc no-lock where
      945                       buf_chk-doc.obj-type = 'маг':U
      946                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      947                   if not available buf_chk-doc then
      948                   do:
      949                       assign
      950                           p-date       = 01/01/1990
      951                           p-z-count    = 1
      952                           p-num-recs   = 0
      953                           p-p-date     = 01/01/1990
      954                           p-p-z-count  = 1
      955                           p-p-num-recs = 0
      956                           .
      957                   end.
      958                   assign
      959                       p-date       = buf_chk-doc.chk-date - 1
      960                       p-z-count    = (if buf_chk-doc.z-number = ? then 1 else  buf_chk-doc.z-number)
      961                       p-num-recs   = 0
      962                       p-p-date     = buf_chk-doc.chk-date - 1
      963                       p-p-z-count  = (if buf_chk-doc.z-number = ? then 1 else  buf_chk-doc.z-number)
      964                       p-p-num-recs = 0
      965                       .
      966               end.
      967           end.
      968           else
      969           do:
      970               assign
      971                   p-date       = date( integer(entry(2, entry(1, v-character, chr(32)), '-':U))
      972                         ,integer(entry(3, entry(1, v-character, chr(32)), '-':U))
      973                         ,integer(entry(1, entry(1, v-character, chr(32)), '-':U))
      974                         )
      975                   p-z-count    = integer(entry(2, v-character, chr(32) ))
      976                   p-z-count    = (if p-z-count = ? then 0 else p-z-count)
      977                   p-num-recs   = integer(entry(3, v-character, chr(32) ))
      978                   p-num-recs   = (if p-num-recs = ? then 0 else p-num-recs)
      979                   p-p-date     = date( integer(entry(2, entry(4, v-character, chr(32)), '-':U))
      980                         ,integer(entry(3, entry(4, v-character, chr(32)), '-':U))
      981                         ,integer(entry(1, entry(4, v-character, chr(32)), '-':U))
      982                         )
      983                   p-p-z-count  = integer(entry(5, v-character, chr(32) ))
      984                   p-p-z-count  = (if p-z-count = ? then 0 else p-z-count)
      985                   p-p-num-recs = integer(entry(6, v-character, chr(32) ))
      986                   p-p-num-recs = (if p-p-num-recs = ? then 0 else p-p-num-recs)
      987           no-error .
      988               if error-status:error then return error .
      989           end.
      990       end.
      991   end procedure.
