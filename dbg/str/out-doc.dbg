    12969         error-status :get-message(1) skip
    12970         return-value skip
    12971         view-as alert-box error .
    12972     end.
    12973     run UI-on in this-procedure ( input "line" ).
    12974   end.
    12975   assign
    12976     br-dtl :num-locked-columns in frame d-out-doc = 3
    12977     frame d-out-doc :scrollable = no
    12978     r-outs     :popup-menu in frame d-out-doc = menu m-outs :handle
    12979     r-outs     :menu-mouse = 1
    12980     b-cur      :popup-menu in frame d-out-doc = menu m-acc_price :handle
    12981     b-cur      :menu-mouse = 1
    12982     b-fixprice :popup-menu in frame d-out-doc = menu m-fixprice :handle
    12983     b-fixprice :menu-mouse = 1
    12984     b-revis    :popup-menu in frame d-out-doc = menu m-ptrl :handle
    12985     b-revis    :menu-mouse = 1
    12986     b-print:popup-menu in frame d-out-doc   = menu m-print:handle
    12987     b-print:menu-mouse                          = 1
    12988   .
    12989   assign
    12990     r-reas            :tooltip in frame d-out-doc = "Основание (причина) создания документа"
    12991     t-doc.reason-code :tooltip in frame d-out-doc = "Основание (причина) создания документа"
    12992     rsn-name          :tooltip in frame d-out-doc = "Основание (причина) создания документа"
    12993   .
    12994   if valid-handle(active-window) and frame d-out-doc:parent eq ?
    12995   then frame d-out-doc:parent = active-window.
    12996   on window-close of frame d-out-doc apply "end-error":u to self.
    12997   define variable vss-include-info92 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12998   on help of frame d-out-doc
    12999   do:
    13000     run gbl/app_help.p
    13001       (input this-procedure :file-name
    13002       ,input ''
    13003       ,input ?
    13004       ) no-error.
    13005     if error-status :error then do:
    13006       message
    13007         "Ошибка при вызове помощи"
    13008         error-status :get-message(1)
    13009         view-as alert-box .
    13010     end.
    13011   end.
    13012   run minbtn-set in this-procedure .
    13013   on choose of b-help in frame d-out-doc
    13014   do:
    13015     apply "help":u to frame d-out-doc .
    13016   end.
    13017   define variable vss-include-info93 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13018   procedure minbtn-set :
    13019       do
    13020           on error undo, return error return-value
    13021           :
    13022           define variable ii              as integer       no-undo .
    13023           define variable fh              as widget-handle no-undo .
    13024           define variable hh              as widget-handle no-undo .
    13025           define variable v-h             as handle        extent 4 no-undo .
    13026           define variable v-name-button   as character     no-undo .
    13027           define variable v-help-old-x    as decimal       no-undo .
    13028           define variable v-help-old-y    as decimal       no-undo .
    13029           define variable v-help-old-size as decimal       no-undo .
    13030           define variable v-frame-width   as decimal       no-undo .
    13031           define variable jj              as integer       no-undo .
    13032           do
    13033               on error undo, return error
    13034               :
    13035               assign
    13036                   v-frame-width = frame d-out-doc:width - 0.3
    13037                   fh            = frame d-out-doc:first-child
    13038                   hh            = fh:first-child
    13039                   ii            = 1
    13040                   .
    13041               do while valid-handle(hh):
    13042                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
    13043                   do:
    13044                       case lc(hh:name) :
    13045                           when "b-help" then
    13046                               do:
    13047                                   hh:load-image-up("cmp/b-help.bmp":u) .
    13048                                   hh:load-image-down("cmp/b-help.bmp":u) .
    13049                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
    13050                                   hh:TOOLTIP = "Помощь" .
    13051                                   v-help-old-x = hh:column .
    13052                                   v-help-old-y = hh:row    .
    13053                                   v-help-old-size = hh:width .
    13054                                   hh:width-chars = 2.5 .
    13055                               end.
    13056                           when "b-print" then
    13057                               do:
    13058                                   hh:load-image("cmp/b-print.bmp":u) .
    13059                                   hh:TOOLTIP = "Печать" .
    13060                                   v-h[ii] = hh:handle .
    13061                                   ii = ii + 1 .
    13062                                   hh:width-chars = 3 .
    13063                               end.
    13064                           when "b-history" or
    13065                           when "b-hist" then
    13066                               do:
    13067                                   hh:load-image("cmp/b-hist.bmp":u) .
    13068                                   hh:TOOLTIP = "История" .
    13069                                   v-h[ii] = hh:handle .
    13070                                   ii = ii + 1 .
    13071                                   hh:width-chars = 3 .
    13072                               end.
    13073                           when "b-sch" then
    13074                               do:
    13075                                   hh:load-image("cmp/b-sch.bmp":u) .
    13076                                   hh:TOOLTIP = "Установка Фильтра" .
    13077                                   v-h[ii] = hh:handle .
    13078                                   ii = ii + 1 .
    13079                                   hh:width-chars = 3 .
    13080                               end.
    13081                           when "b-hist-user" then
    13082                               do:
    13083                                   hh:load-image("cmp/b-hist.bmp":u) .
    13084                                   hh:TOOLTIP = "История пользователя" .
    13085                                   ii = ii + 1 .
    13086                               end.
    13087                       end case.
    13088                   end.
    13089                   hh = hh:next-sibling.
    13090               end.
    13091               b-help:column = v-frame-width - b-help:width-chars.
    13092               jj = 0.
    13093               repeat ii = 4 to 1 by -1 :
    13094                   if valid-handle (v-h[ii] ) then
    13095                   do:
    13096                       jj  = jj + 1 .
    13097                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
    13098                       v-h[ii]:row    = v-help-old-y .
    13099                   end.
    13100               end.
    13101           end.
    13102       end.
    13103   end procedure.
    13104   define variable vss-include-info94 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
    13105   define variable v-diasize-need-maximize        as logical   no-undo init true  .
    13106   define variable v-diasize-orig-frame-height    as decimal   no-undo .
    13107   define variable v-diasize-orig-frame-width     as decimal   no-undo .
    13108   define variable v-diasize-current-frame-width  as decimal   no-undo .
    13109   define variable v-diasize-current-frame-height as decimal   no-undo .
    13110   define variable v-diasize-change-size          as logical   no-undo .
    13111   define variable v-diasize-resize-button        as handle    no-undo .
    13112   define variable v-diasize-wndmax               as logical   no-undo .
    13113   define variable v-diasize-wndstore             as logical   no-undo .
    13114   define variable v-diasize-proc-name            as character no-undo .
    13115   define variable v-diasize-browse-handle        as handle    no-undo .
    13116   define variable v-diasize-browse-number        as integer   no-undo .
    13117   define variable v-diasize-need-full-display    as logical   no-undo init false .
    13118   define temp-table temp-diasize-handle no-undo
    13119     field handle-value  as handle
    13120     field save-position as decimal
    13121     index xpk is primary unique handle-value
    13122     .
    13123   define temp-table temp-browse-handle no-undo
    13124     field browse-type   as character
    13125     field browse-number as integer
    13126     field browse-handle as handle
    13127     field original-size as decimal
    13128     index xpk is primary unique browse-type browse-number
    13129     index xie browse-type browse-handle
    13130   .
    13131   procedure diasize_change-height :
    13132     define input  parameter p-change-value  as decimal   no-undo .
    13133     define input  parameter p-move-resize   as logical   no-undo .
    13134     define variable v-field-group-handle    as handle    no-undo .
    13135     define variable v-object-handle         as handle    no-undo .
    13136     define variable v-frame-height          as decimal   no-undo .
    13137     define variable v-frame-virtual-height  as decimal   no-undo .
    13138     define variable v-browse-height         as decimal   no-undo .
    13139     define variable v-window-height         as decimal   no-undo .
    13140     define variable v-window-virtual-height as decimal   no-undo .
    13141     define variable v-change-sign           as integer   no-undo .
    13142     define buffer buf_temp-diasize-handle for temp-diasize-handle .
    13143     define buffer buf_temp-browse-handle  for temp-browse-handle .
    13144     if p-change-value > 0
    13145     then do:
    13146       if frame d-out-doc :height + p-change-value
    13147           > decimal(session :work-area-height-pixels) / session :pixels-per-row
    13148       then do:
    13149         assign
    13150           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
    13151                           - (frame d-out-doc :height-chars)
    13152         .
    13153         if p-change-value <= 0
    13154         then do:
    13155           run diasize_position-resize-button in this-procedure .
    13156           return .
    13157         end.
    13158       end.
    13159     end.
    13160     if p-change-value < 0
    13161     then do:
    13162       if frame d-out-doc :height + p-change-value < v-diasize-orig-frame-height
    13163       then do:
    13164         assign
    13165           p-change-value = v-diasize-orig-frame-height
    13166                          - (frame d-out-doc :height-chars)
    13167         .
    13168         if p-change-value >= 0
    13169         then do:
    13170           run diasize_position-resize-button in this-procedure .
    13171           return .
    13172         end.
    13173       end.
    13174     end.
    13175     if p-change-value >= 0
    13176     then do:
    13177       assign
    13178         v-change-sign = 1
    13179       .
    13180     end.
    13181     else do:
    13182       assign
    13183         v-change-sign = -1
    13184       .
    13185     end.
    13186     assign
    13187       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
    13188     .
    13189     if p-change-value = 0
    13190     then do:
    13191       run diasize_position-resize-button in this-procedure .
    13192       return .
    13193     end.
    13194     move_block:
    13195     do
    13196     on error undo move_block, retry move_block
    13197     :
    13198       if retry
    13199       then do:
    13200         do
    13201         on error undo move_block, leave move_block
    13202         :
    13203           if p-change-value > 0
    13204           then do:
    13205             for each buf_temp-diasize-handle
    13206             on error undo, next
    13207             :
    13208               assign
    13209                 v-object-handle = buf_temp-diasize-handle.handle-value
    13210               .
    13211               if v-object-handle <> v-diasize-resize-button
    13212               then do:
    13213                 assign
    13214                   v-object-handle :row = buf_temp-diasize-handle.save-position
    13215                 .
    13216               end.
    13217             end.
    13218             assign
    13219               v-diasize-browse-handle :height = v-browse-height
    13220             .
    13221             for each buf_temp-browse-handle
    13222               where buf_temp-browse-handle.browse-type = 'height':u
    13223             on error undo, next
    13224             :
    13225               assign
    13226                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
    13227               .
    13228             end.
    13229             assign
    13230               frame d-out-doc :height = v-frame-height
    13231             .
    13232             if frame d-out-doc :scrollable = true
    13233             then do:
    13234               assign
    13235                 frame d-out-doc :virtual-height = v-frame-virtual-height
    13236               .
    13237             end.
    13238             run diasize_position-resize-button in this-procedure .
    13239           end.
    13240           else do:
    13241             if frame d-out-doc :scrollable = true
    13242             then do:
    13243               assign
    13244                 frame d-out-doc :virtual-height = v-frame-virtual-height
    13245               .
    13246             end.
    13247             assign
    13248               frame d-out-doc :height = v-frame-height
    13249             .
    13250             assign
    13251               v-diasize-browse-handle :height = v-browse-height
    13252             .
    13253             for each buf_temp-browse-handle
    13254               where buf_temp-browse-handle.browse-type = 'height':u
    13255             on error undo, next
    13256             :
    13257               assign
    13258                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
    13259               .
    13260             end.
    13261             for each buf_temp-diasize-handle
    13262             on error undo, next
    13263             :
    13264               assign
    13265                 v-object-handle = buf_temp-diasize-handle.handle-value
    13266               .
    13267               if v-object-handle <> v-diasize-resize-button
    13268               then do:
    13269                 assign
    13270                   v-object-handle :row = buf_temp-diasize-handle.save-position
    13271                 .
    13272               end.
    13273             end.
    13274             run diasize_position-resize-button in this-procedure .
    13275           end.
    13276           assign
    13277             v-diasize-change-size = false
    13278           .
    13279           leave move_block .
    13280         end.
    13281       end.
    13282       assign
    13283         v-diasize-need-full-display = true
