     4845   procedure xmlchar-test :
     4846   define input parameter p-in-string          as character        no-undo.
     4847   define output parameter p-out-string-enc    as character        no-undo.
     4848   define output parameter p-out-string-dec    as character        no-undo.
     4849   do
     4850   on error undo, return error
     4851   :
     4852          run xmlchar-encode in this-procedure
     4853       (
     4854             input p-in-string
     4855           , output p-out-string-enc
     4856       ).
     4857          run xmlchar-decode in this-procedure
     4858       (
     4859             input p-out-string-enc
     4860           , output p-out-string-dec
     4861       ).
     4862   end.
     4863   end .
     4864   procedure xmlchar-encode :
     4865   define input parameter p-in-string      as character        no-undo.
     4866   define output parameter p-out-string    as character        no-undo.
     4867       define variable v-position      as integer      no-undo.
     4868       define variable v-current-char  as character    no-undo.
     4869   do
     4870   on error undo, return error
     4871   :
     4872       assign
     4873           p-out-string = "":U
     4874       .
     4875       case p-in-string
     4876       :
     4877           when ?
     4878           then do:
     4879               assign
     4880                   p-out-string = "?":U
     4881               .
     4882           end.
     4883           when "?":U
     4884           then do:
     4885               assign
     4886                   p-out-string = "&#63;":U
     4887               .
     4888           end.
     4889           otherwise do:
     4890               do v-position = 1 to length( p-in-string )
     4891               :
     4892                   assign
     4893                       v-current-char = substring( p-in-string, v-position, 1 )
     4894                   .
     4895                   case v-current-char
     4896                   :
     4897                       when "&":U
     4898                       then do:
     4899                           assign
     4900                               p-out-string = p-out-string + "&amp;":U
     4901                           .
     4902                       end.
     4903                       when ">":U
     4904                       then do:
     4905                           assign
     4906                               p-out-string = p-out-string + "&gt;":U
     4907                           .
     4908                       end.
     4909                       when "<":U
     4910                       then do:
     4911                           assign
     4912                               p-out-string = p-out-string + "&lt;":U
     4913                           .
     4914                       end.
     4915                       when "'":U
     4916                       then do:
     4917                           assign
     4918                               p-out-string = p-out-string + "&apos;":U
     4919                           .
     4920                       end.
     4921                       when '"':U
     4922                       then do:
     4923                           assign
     4924                               p-out-string = p-out-string + "&quot;":U
     4925                           .
     4926                       end.
     4927                       when chr(1)
     4928                       then do:
     4929                           assign
     4930                               p-out-string = p-out-string + "":U
     4931                           .
     4932                       end.
     4933                       when chr(2)
     4934                       then do:
     4935                           assign
     4936                               p-out-string = p-out-string + "":U
     4937                           .
     4938                       end.
     4939                       when chr(3)
     4940                       then do:
     4941                           assign
     4942                               p-out-string = p-out-string + "":U
     4943                           .
     4944                       end.
     4945                       when chr(4)
     4946                       then do:
     4947                           assign
     4948                               p-out-string = p-out-string + "":U
     4949                           .
     4950                       end.
     4951                       when chr(5)
     4952                       then do:
     4953                           assign
     4954                               p-out-string = p-out-string + "":U
     4955                           .
     4956                       end.
     4957                       when chr(6)
     4958                       then do:
     4959                           assign
     4960                               p-out-string = p-out-string + "":U
     4961                           .
     4962                       end.
     4963                       when chr(7)
     4964                       then do:
     4965                           assign
     4966                               p-out-string = p-out-string + "":U
     4967                           .
     4968                       end.
     4969                       when chr(8)
     4970                       then do:
     4971                           assign
     4972                               p-out-string = p-out-string + "":U
     4973                           .
     4974                       end.
     4975                       when chr(9)
     4976                       then do:
     4977                           assign
     4978                               p-out-string = p-out-string + "":U
     4979                           .
     4980                       end.
     4981                       when chr(29)
     4982                       then do:
     4983                           assign
     4984                               p-out-string = p-out-string + "":U
     4985                           .
     4986                       end.
     4987                       when chr(10)
     4988                       then do:
     4989                           assign
     4990                               p-out-string = p-out-string + "&#10;":U
     4991                           .
     4992                       end.
     4993                       when chr(13)
     4994                       then do:
     4995                           assign
     4996                               p-out-string = p-out-string + "&#13;":U
     4997                           .
     4998                       end.
     4999                       otherwise do:
     5000                           assign
     5001                               p-out-string = p-out-string + v-current-char
     5002                           .
     5003                       end.
     5004                   end case.
     5005               end.
     5006           end.
     5007       end case.
     5008   end.
     5009   end .
     5010   procedure xmlchar-encode-1c :
     5011   define input parameter p-in-string      as character        no-undo.
     5012   define output parameter p-out-string    as character        no-undo.
     5013       define variable v-position      as integer      no-undo.
     5014       define variable v-current-char  as character    no-undo.
     5015   do
     5016   on error undo, return error
     5017   :
     5018       assign
     5019           p-out-string = "":U
     5020       .
     5021       case p-in-string
     5022       :
     5023           when ?
     5024           then do:
     5025               assign
     5026                   p-out-string = "?":U
     5027               .
     5028           end.
     5029           otherwise do:
     5030               do v-position = 1 to length( p-in-string )
     5031               :
     5032                   assign
     5033                       v-current-char = substring( p-in-string, v-position, 1 )
     5034                   .
     5035                   case v-current-char
     5036                   :
     5037                       when chr(1)
     5038                       then do:
     5039                           assign
     5040                               p-out-string = p-out-string + " ":U
     5041                           .
     5042                       end.
     5043                       when chr(2)
     5044                       then do:
     5045                           assign
     5046                               p-out-string = p-out-string + " ":U
     5047                           .
     5048                       end.
     5049                       when chr(3)
     5050                       then do:
     5051                           assign
     5052                               p-out-string = p-out-string + " ":U
     5053                           .
     5054                       end.
     5055                       when chr(4)
     5056                       then do:
     5057                           assign
     5058                               p-out-string = p-out-string + " ":U
     5059                           .
     5060                       end.
     5061                       when chr(5)
     5062                       then do:
     5063                           assign
     5064                               p-out-string = p-out-string + " ":U
     5065                           .
     5066                       end.
     5067                       when chr(6)
     5068                       then do:
     5069                           assign
     5070                               p-out-string = p-out-string + " ":U
     5071                           .
     5072                       end.
     5073                       when chr(7)
     5074                       then do:
     5075                           assign
     5076                               p-out-string = p-out-string + " ":U
     5077                           .
     5078                       end.
     5079                       when chr(8)
     5080                       then do:
     5081                           assign
     5082                               p-out-string = p-out-string + " ":U
     5083                           .
     5084                       end.
     5085                       when chr(9)
     5086                       then do:
     5087                           assign
     5088                               p-out-string = p-out-string + " ":U
     5089                           .
     5090                       end.
     5091                       when chr(29)
     5092                       then do:
     5093                           assign
     5094                               p-out-string = p-out-string + " ":U
     5095                           .
     5096                       end.
     5097                       when chr(10)
     5098                       then do:
     5099                           assign
     5100                               p-out-string = p-out-string + " ":U
     5101                           .
     5102                       end.
     5103                       when chr(13)
     5104                       then do:
     5105                           assign
     5106                               p-out-string = p-out-string + " ":U
     5107                           .
     5108                       end.
     5109                       otherwise do:
     5110                           assign
     5111                               p-out-string = p-out-string + v-current-char
     5112                           .
     5113                       end.
     5114                   end case.
     5115               end.
     5116           end.
     5117       end case.
     5118   end.
     5119   end .
     5120   procedure xmlchar-decode :
     5121   define input parameter p-in-string      as character        no-undo.
     5122   define output parameter p-out-string    as character        no-undo.
     5123       define variable v-position      as integer      no-undo.
     5124       define variable v-last-position as integer      no-undo.
     5125       define variable v-temp-integer  as integer      no-undo.
     5126       define variable v-current-char  as character    no-undo.
     5127       define variable v-next-char     as character    no-undo.
     5128       define variable v-success       as logical      no-undo.
     5129   do
     5130   on error undo, return error
     5131   :
     5132       assign
     5133           p-out-string = "":U
     5134           v-position   = 0
     5135       .
     5136       replace-cycle:
     5137       do while yes
     5138       on error undo, return error
     5139       :
     5140           assign
     5141               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     5142           .
     5143           if v-last-position <= v-position
     5144           then do:
     5145               if v-position = 0
     5146               then do:
     5147                   assign
     5148                       p-out-string = p-in-string
     5149                   .
     5150               end.
     5151               else do:
     5152                   assign
     5153                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     5154                   .
     5155               end.
     5156               leave replace-cycle.
     5157           end.
     5158           else do:
     5159               assign
     5160                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     5161                   v-position      = v-last-position
     5162                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     5163               .
     5164               if v-current-char = "#":U
     5165               then do:
     5166                   assign
     5167                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     5168                   .
     5169                   if v-last-position > 0
     5170                   then do:
     5171                       run xmlchar-read-integer in this-procedure
     5172                        (
     5173                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     5174                           , output v-temp-integer
     5175                           , output v-success
     5176                       ).
     5177                       if v-success = yes
     5178                       and v-temp-integer >= 1
     5179                       and v-temp-integer <= 255
     5180                       then do:
     5181                           assign
     5182                               p-out-string = p-out-string + chr( v-temp-integer )
     5183                               v-position   = v-last-position + 1
     5184                           .
     5185                       end.
     5186                       else do:
     5187                           assign
     5188                               p-out-string = p-out-string + "&":U
     5189                               v-position   = v-position   + 1
     5190                           .
     5191                       end.
     5192                   end.
     5193                   else do:
     5194                       assign
     5195                           p-out-string = p-out-string + "&":U
     5196                           v-position   = v-position   + 1
     5197                       .
     5198                   end.
     5199               end.
     5200               else do:
     5201                   case substring( p-in-string, v-position + 1, 3 )
     5202                   :
     5203                       when "lt;":U
     5204                       then do:
     5205                           assign
     5206                               p-out-string = p-out-string + "<":U
     5207                               v-position   = v-position   + 3
     5208                           .
     5209                       end.
     5210                       when "gt;":U
     5211                       then do:
     5212                           assign
     5213                               p-out-string = p-out-string + ">":U
     5214                               v-position   = v-position   + 3
     5215                           .
     5216                       end.
     5217                       otherwise do:
     5218                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     5219                           then do:
     5220                               assign
     5221                                   p-out-string = p-out-string + "&":U
     5222                                   v-position   = v-position   + 4
     5223                               .
     5224                           end.
     5225                           else do:
     5226                               case substring( p-in-string, v-position + 1, 5 )
     5227                               :
     5228                                   when "quot;":U
     5229                                   then do:
     5230                                       assign
     5231                                           p-out-string = p-out-string + '"':U
     5232                                           v-position   = v-position   + 5
     5233                                       .
     5234                                   end.
     5235                                   when "apos;":U
     5236                                   then do:
     5237                                       assign
     5238                                           p-out-string = p-out-string + "'":U
     5239                                           v-position   = v-position   + 5
     5240                                       .
     5241                                   end.
     5242                                   otherwise do:
     5243                                       assign
     5244                                           p-out-string = p-out-string + "&":U
     5245                                       .
     5246                                   end.
     5247                               end case.
     5248                           end.
     5249                       end.
     5250                   end case.
     5251               end.
     5252           end.
     5253       end.
     5254   end.
     5255   end .
     5256   procedure xmlchar-read-integer :
     5257   define input parameter p-input-string      as character        no-undo.
     5258   define output parameter p-output-integer   as integer          no-undo.
     5259   define output parameter p-success       as logical          no-undo.
     5260   do
     5261   on error undo, return error
     5262   :
     5263       assign
     5264           p-output-integer = integer( p-input-string )
     5265       no-error.
     5266       if error-status :error
     5267       then do:
     5268           assign
     5269               p-success           = no
     5270               p-output-integer    = 0
     5271           .
     5272       end.
     5273       else do:
     5274           assign
     5275               p-success           = yes
     5276           .
     5277       end.
     5278   end.
     5279   end.
     5280   define variable mMRCCode  as logical    no-undo.
     5281   define variable mTypeMark as character  no-undo.
     5282   function IS-NeedMark returns logical
     5283   ( input ib-code as integer  ,
     5284     input ib-str as character ):
     5285      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     5286      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     5287                                    and buf_prod-bc-attr.b-str  eq ib-str
     5288                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     5289        no-lock no-error.
     5290      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     5291   end.
     5292   function repTegforDm return char
     5293   (iDM as char ):
     5294       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     5295       define variable vteg as character no-undo.
     5296       define variable oDM as character no-undo.
     5297       define variable vi as integer no-undo.
     5298       oDM = iDm.
     5299       do vi = 1 to num-entries(vTeglist):
     5300          vTeg = entry(vi,vTeglist).
     5301          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     5302       end.
     5303       return oDM.
     5304   end.
     5305   function repSpecSimbforDm return char
     5306   (iDM as char ):
     5307       define variable oDM as character no-undo.
     5308     run
     5309       xmlchar-decode(iDM, output oDM).
     5310     return repTegforDm (oDM).
     5311   end.
     5312   function CheckGtin return logical
     5313   (iGtin as char):
     5314      define variable bar_code as character no-undo.
     5315      define variable vGtin as logical no-undo init "yes".
     5316      if length(iGtin) eq 14
     5317      then do:
     5318         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     5319         run str/chk-sum.p
     5320          (input-output bar_code ) no-error .
     5321         if iGtin ne  bar_code
     5322         then
     5323            vGtin = no.
     5324      end.
     5325      else
     5326         vGtin = no.
     5327      return vgtin.
     5328   end.
     5329   function repSpecSimbforXlm return char
     5330   (iDM as char ):
     5331       iDM = replace(iDM,chr(29),"").
     5332       return iDM.
     5333   end.
     5334   function getGtinByDM return char
     5335   (IDM as char):
     5336      define variable VTXT as char no-undo.
     5337      define variable vGtin as char no-undo.
     5338      vTXt = IdM.
     5339      vGtin = IDM.
     5340      if    length(vtxt) > 14
     5341      then do:
     5342         if   vtxt begins "(01)"
     5343                or vtxt begins "(02)"
     5344         then
     5345            vGtin = substring(vtxt,5,14).
     5346         else if   (vtxt begins "01"
     5347                or vtxt begins "02" )
     5348                and (   (    substring(iDm,17,2) eq "21"
     5349                         and length(vtxt) >= 21)
     5350                     or substring(iDm,17,2) eq "37"
     5351                     or substring(iDm,17,4) eq "(37)" )
     5352         then do:
     5353            vGtin = substring(vtxt,3,14).
     5354            if not checkGtin(vGtin)
     5355            then
     5356               vGtin = substring(vtxt,1,14).
     5357         end.
     5358         else if     length(vtxt) eq 14 + 7 + 4 + 4
     5359             or length(vtxt) eq 14 + 7 + 4
     5360             or length(vtxt) eq 14 + 7
     5361         then
     5362            vGtin = substring(vtxt,1,14).
     5363      end.
     5364      if not checkGtin(vGtin)
     5365      then
     5366         vGtin = "".
     5367      return vgtin.
     5368   end.
     5369   function getGdsCodeByGtin return int
     5370   (iGtin as char):
     5371      define buffer prod-bc  for ub.prod-bc.
     5372      define buffer bar-code for ub.bar-code.
     5373      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     5374      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     5375      return if avail bar-code then bar-code.gds-code else ?.
     5376   end.
     5377   function getQntyCodeByGtin return decimal
     5378   (iGtin as char):
     5379      define buffer prod-bc  for ub.prod-bc.
     5380      define buffer bar-code for ub.bar-code.
     5381      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     5382      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     5383      return if avail bar-code then bar-code.cli-base-rate else ?.
     5384   end.
     5385   function getGdsCodeByDM return int
     5386   (iDm as char):
     5387      define variable vGtin as char no-undo.
     5388      define buffer prod-bc for ub.prod-bc.
     5389      vGtin  = getGtinByDM (IDM ).
     5390      return getGdsCodeByGtin (vGtin).
     5391   end.
     5392   function ChekTypeMarkByGds return logical
     5393   (iGds-code as integer ):
     5394      define buffer goods-attr for ub.goods-attr.
     5395      find first goods-attr where goods-attr.gds-code   = iGds-code
     5396                              and goods-attr.attr-code  = 'mark-type':U
     5397      no-lock no-error.
     5398      if available goods-attr
     5399      then do:
     5400         mTypeMark = goods-attr.attr-value.
     5401         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     5402           .
     5403      end.
     5404      else
     5405         return no.
     5406   end.
     5407   function ChekTypeMarkByDm return logical
     5408   (iDM as char ):
     5409      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     5410   end.
     5411   function ChekTypeMarkByGtin return logical
     5412   (iGtin as char ):
     5413      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     5414   end.
     5415   function GetNextElement return character
     5416     (input iAllTeg        as logical
     5417     ,output oteg          as character
     5418     ,output otegval       as character
     5419     ,input-output pstr    as character
     5420      ):
     5421        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     5422        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     5423        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     5424        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     5425        define variable vTeg as character no-undo.
     5426        define variable vLength as integer no-undo.
     5427        define variable vi as integer no-undo.
     5428        define variable vj as integer no-undo.
     5429        define buffer code for ub.code.
     5430        find first code where Code.parent eq "MarkType"
     5431                          and Code.CodeValue   eq mTypeMark
     5432                          no-lock no-error.
     5433        if     available code
     5434           and Code.misc1 ne ""
     5435           and Code.misc1 ne ?
     5436        then do:
     5437           integer (Code.misc1) no-error.
     5438           if not error-status:error
     5439           then
     5440             entry (4,vlistleng) = Code.misc1.
     5441        end.
     5442        if iAllTeg
     5443        then
     5444           assign
     5445              vlistElem     = vlistElem    + vlistElemDop
     5446              vlistleng     = vlistleng    + vlistlengDop
     5447           .
     5448        else if mMRCCode
     5449        then
     5450           assign
     5451              vlistElem     = vlistElem    + ",(8005),8005"
     5452              vlistleng     = vlistleng    + ",000006,0006"
     5453           .
     5454       block-elem:
     5455       do vi = 1 to num-entries(vlistElem):
     5456          vTeg = entry(vi,vlistElem).
     5457          if pstr begins vTeg
     5458          then do:
     5459             if    vTeg eq "21"
     5460             then
     5461                vLength = index(pstr,chr(29)) - 2 no-error.
     5462             if vLength  <= 0
     5463             then
     5464                vLength = int(entry(vi,vlistleng)).
     5465             otegval = substring (pstr,length(vteg) + 1, vLength).
     5466             oteg = replace(replace(vteg,")",""),"(","").
     5467             vTeg = vteg + otegval.
     5468             otegval = replace(otegval,chr(29),"").
     5469             oteg = replace(replace(oteg,")",""),"(","").
     5470             pstr = substring (pstr,length(vTeg)+ 1).
     5471             vTeg = replace(vTeg,chr(29),"").
     5472             leave block-elem.
     5473          end.
     5474          else
     5475             vTeg = "".
     5476       end.
     5477       return vteg.
     5478   end.
     5479   function GetCodeIdent return character
     5480   (iDm as char):
     5481      define variable Velement   as character no-undo init "first".
     5482      define variable oCodeIdent as character no-undo.
     5483      define variable vteg as character no-undo.
     5484      define variable vtegval as character no-undo.
     5485      define variable vGtin as character no-undo.
     5486      define buffer marking for ub.marking.
     5487      for first marking no-lock where
     5488                marking.mark eq iDm
     5489            and marking.unit-ext = "LEVEL2"
     5490      :
     5491        return iDm.
     5492      end.
     5493      vGtin  = getGtinByDM (iDm ).
     5494      ChekTypeMarkByDm(idm).
     5495      if iDm begins 'tech_':U
     5496      then
     5497         oCodeIdent = iDm.
     5498      else if length(iDm) < 21
     5499      then do:
     5500         find first marking where marking.mark eq idm
     5501         no-lock no-error.
     5502         oCodeIdent = if available marking then marking.mark else  ?.
     5503      end.
     5504      else if     length(iDm) eq 29
     5505         and not iDm begins "01"
     5506         and not iDm begins "02"
     5507      then
     5508         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     5509      else  if     length(iDm) >= 24
     5510               and (  iDm begins "01"
     5511                   or iDm begins "02")
     5512               and  substring(iDm,17,2) ne "21"
     5513      then do:
     5514         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     5515                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     5516         then
     5517            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     5518         else
     5519            oCodeIdent = iDM.
     5520      end.
     5521      else  if     (   length(iDm) eq 25
     5522                    or length(iDm) eq 21)
     5523               and (not iDm begins "01"
     5524               and  not iDm begins "02")
     5525      then
     5526         oCodeIdent = substring(iDm,1,21).
     5527      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     5528      then
     5529         oCodeIdent = substring(iDm,1,21).
     5530      else do while Velement ne "" and idm ne "":
     5531         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     5532         oCodeIdent = oCodeIdent + Velement.
     5533      end.
     5534      return oCodeIdent.
     5535   end.
     5536   function GetTegCod return character
     5537   (icodeIdent as char, iTeg as char):
     5538      define variable Velement   as character no-undo init "first".
     5539      define variable oTeg as character no-undo init ?.
     5540      define variable vteg as character no-undo.
     5541      define variable vtegval as character no-undo.
     5542      if     ((length(icodeIdent) eq 21
     5543         and not icodeIdent begins "01"
     5544         and not icodeIdent begins "02")
     5545         or
     5546             ( length(icodeIdent) eq 25
     5547               and not icodeIdent begins "01"
     5548               and not icodeIdent begins "02"))
     5549      then do:
     5550         if iTeg eq "01" or iTeg eq "02"
     5551         then
     5552            oTeg = substring(icodeIdent,1,21).
     5553         else  if  iTeg eq "21"
     5554         then
     5555            oTeg = substring(icodeIdent,15,7).
     5556      end.
     5557      else do:
     5558         ChekTypeMarkByDm(icodeIdent).
     5559         block-teg:
     5560            do while Velement ne "" and icodeIdent ne "":
     5561            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     5562            if    Velement begins iTeg
     5563               or Velement begins "(" + iTeg + ")"
     5564            then do:
     5565               oTeg = vtegval.
     5566               leave block-teg.
     5567            end.
     5568         end.
     5569      end.
     5570      return oTeg.
     5571   end.
     5572   function isOAD return logical
     5573   (icodeIdent as character):
     5574      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     5575   end.
     5576   function isMark return logical
     5577   (icodeIdent as character):
     5578      define buffer buf_marking for ub.marking.
     5579      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     5580             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     5581   end.
     5582   function addBracketForCode return character
     5583   (icodeIdent as char):
     5584      define variable Velement   as character no-undo init "first".
     5585      define variable oTeg as character no-undo.
     5586      define variable vteg as character no-undo.
     5587      define variable vtegval as character no-undo.
     5588      define buffer marking for ub.marking.
     5589      find first marking no-lock where
     5590                 marking.mark begins icodeIdent no-error.
     5591      if    not ChekTypeMarkByDm(icodeIdent)
     5592         or length(icodeIdent) le 24
     5593         or (avail marking and marking.unit-ext = "LEVEL2")
     5594      then
     5595         oTeg = icodeIdent.
     5596      else do:
     5597         if (  icodeIdent begins "01"
     5598            or icodeIdent begins "02"
     5599            ) and CheckGtin(substring (icodeIdent,3,14))
     5600            and substring (icodeIdent,17,2) eq "21"
     5601         then do:
     5602            mMRCCode = yes.
     5603            ChekTypeMarkByDm(icodeIdent).
     5604            block-teg:
     5605            do while Velement ne "" and icodeIdent ne "":
     5606               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     5607               if vteg ne ""
     5608               then
     5609                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     5610            end.
     5611            mMRCCode = no.
     5612         end.
     5613         else do:
     5614            oTeg = icodeIdent.
     5615         end.
     5616      end.
     5617      return oTeg.
     5618   end.
     5619   function getlevelByCodId return int
     5620   (iCode as char):
     5621      define variable vLength as int no-undo.
     5622      define variable vLevel  as int no-undo.
     5623      if not ChekTypeMarkByDM (icode) then return ?.
     5624      vLength = length(iCode).
     5625      if    vLength eq 18
     5626         or vLength eq 20
     5627      then
     5628         Vlevel = 4.
     5629      else if vLength eq 21
     5630      then
     5631         Vlevel = 1.
     5632      else if vLength eq 25
     5633      then do:
     5634         if  iCode begins "01"
     5635         then
     5636            Vlevel = 3.
     5637         else
     5638            Vlevel = 1.
     5639      end.
     5640      else if     vLength >= 26
     5641              and vLength <= 46
     5642      then do:
     5643         if    substring(iCode,17,2) eq "11"
     5644            or substring(iCode,17,2) eq "13"
     5645            or (    substring(iCode,17,2) eq "21"
     5646                and vLength >= 33
     5647                and substring(iCode,26,4) ne "8005")
     5648         then
     5649            Vlevel = 4.
     5650         else if    vLength eq 31
     5651                 or vLength eq 38
     5652                 or vLength eq 39
     5653                 or vLength eq 45
     5654         then
     5655            Vlevel = 1.
     5656         else if    vLength eq 35
     5657                 or vLength eq 43
     5658         then
     5659            Vlevel = 3.
     5660         else
     5661            Vlevel = ?.
     5662      end.
     5663      else
     5664         Vlevel = ?.
     5665      return Vlevel.
     5666   end.
     5667   function getLevelMotpBycodid return character
     5668   (iDm as char):
     5669      define variable vLevel as integer no-undo.
     5670      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     5671      vLevel = getlevelByCodId(iDm).
     5672      if    vLevel eq ?
     5673         or vLevel < 1
     5674         or vLevel > 6
     5675      then
     5676         return ?.
     5677      else
     5678         return entry(vlevel,vList).
     5679   end.
     5680   function getLevelUTDByLevelMotp return character
     5681   (iUnit as char):
     5682      define variable vLevel as integer no-undo.
     5683      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     5684      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     5685      vLevel = lookup(iUnit,vListMOTP).
     5686      if    vLevel eq ?
     5687         or vLevel < 1
     5688         or vLevel > 4
     5689      then
     5690         return ?.
     5691      else
     5692         return entry(vlevel,vListutd).
     5693   end.
     5694   function getLevelMotpByDM return character
     5695   (iDm as char):
     5696      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     5697   end.
     5698   function getLevelUTDByCodId return character
     5699   (iDm as char):
     5700      define variable vLevel as integer no-undo.
     5701      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     5702      vLevel = getlevelByCodId(iDm).
     5703      if    vLevel eq ?
     5704         or vLevel < 1
     5705         or vLevel > 4
     5706      then
     5707         return ?.
     5708      else
     5709         return entry(vlevel,vList).
     5710   end.
     5711   function getLevelUTDByDM return character
     5712   (iDm as char):
     5713      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     5714   end.
     5715   define variable mNotMarkQnty as logical no-undo.
     5716   function getQntyUTDByCodId return decimal
     5717   (iDM as char):
     5718      define variable vLevel as integer no-undo.
     5719      define variable vList as character no-undo init "1,5,10,500".
     5720      define variable vGtin as character no-undo.
     5721      define variable vqnty as decimal no-undo init ?.
     5722      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     5723      if vqnty eq ?
     5724      then do:
     5725         if not mNotMarkQnty
     5726         then do:
     5727            define buffer marking for ub.marking.
     5728            define variable vCodident as character no-undo.
     5729            vCodident = GetCodeIdent(idm).
     5730            find first marking where marking.mark begins vCodident no-lock no-error.
     5731            if     available marking
     5732               and marking.box-qnty ne ?
     5733            then
     5734               return marking.box-qnty.
     5735         end.
     5736         vGtin = getGtinByDm(iDM).
     5737         if ChekTypeMarkByGtin (vGtin)
     5738         then do:
     5739            vLevel = getlevelByCodId(iDM).
     5740            if     vLevel >= 1
     5741               and vLevel <= 4
     5742            then
     5743               vqnty = int(entry(vlevel,vList)).
     5744         end.
     5745         else
     5746            vqnty = getQntyCodeByGtin(vgtin).
     5747      end.
     5748      return vqnty.
     5749   end.
     5750   function getQntyUTDByDM return decimal
     5751   (iDm as char):
     5752      define variable vDM as character no-undo.
     5753      if     length (iDm) ne 25
     5754         and length (iDm) ne 29
     5755         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     5756      then
     5757         vDM = substring (iDm,1,length (iDm) - 6 ).
     5758      else
     5759         vDM = substring (iDm,1,length (iDm) - 4 ).
     5760      return getQntyUTDByCodId(vDM).
     5761   end.
     5762   function getMRC4 return decimal
     5763   (iMRC as char):
     5764      define variable oMrc     as decimal no-undo init ?.
     5765      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     5766      define variable vi       as integer no-undo.
     5767      define variable vfound   as integer no-undo.
     5768      define variable vposStart   as integer no-undo.
     5769      do:
     5770      OMRc = 0.
     5771      do vi = 1 to 4:
     5772         define variable vsimb as character no-undo.
     5773         vsimb = substring(iMRC,vi,1).
     5774         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     5775         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     5776         if vfound > 0
     5777         then
     5778            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     5779         end.
     5780         OMRc = OMRc / 100.
     5781      end.
     5782      return OMRc.
     5783   end.
     5784   function getMRCByDM return decimal
     5785   (iDm as char):
     5786      define variable vMRC     as character no-undo.
     5787      define variable oMrc     as decimal no-undo init ?.
     5788      define variable Velement as character no-undo init "empty".
     5789      define variable vteg as character no-undo.
     5790      define variable vtegval as character no-undo.
     5791      if    length(idm) eq 14 + 7 + 4 + 4
     5792         or length(idm) eq 14 + 7 + 4
     5793      then do:
     5794         vMRC = substring(idm,22,4).
     5795         omrc = getMRC4(vMRC).
     5796      end.
     5797      else do:
     5798          ChekTypeMarkByDm(iDm).
     5799          block-mrc:
     5800          do while Velement ne "" and idm ne "":
     5801             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     5802             if Velement begins "8005"
     5803             then do:
     5804                vMRC = substring(Velement,5,6).
     5805                leave block-mrc.
     5806             end.
     5807             else if Velement begins "(8005)"
     5808             then do:
     5809                vMRC = substring(Velement,7,6).
     5810                leave block-mrc.
     5811             end.
     5812          end.
     5813          if vMRC ne ""
     5814          then
     5815             OMRc = dec(vmrc) / 100 no-error.
     5816      end.
     5817      return OMRc.
     5818   end.
     5819   function MoveDate return Date
     5820   (idate as date,
     5821    iMonth as int64):
     5822      define variable vMonth   as int64 no-undo.
     5823      define variable vYear    as int64 no-undo.
     5824      define variable vDateNew as date  no-undo.
     5825       define variable vDay     as int64 no-undo.
     5826       vMonth = month(iDate) + iMonth.
     5827       vYear =  year(iDate).
     5828       if vMonth <= 0
     5829       then assign
     5830          vMonth = vMonth + 12
     5831           vYear  = vYear - 1
     5832       .
     5833       else if vMonth > 12
     5834       then assign
     5835          vMonth = vMonth - 12
     5836           vYear  = vYear + 1
     5837       .
     5838       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     5839       do while error-status:error eq yes:
     5840          VDay = vDay + 1.
     5841          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     5842       end.
     5843       if VDay > 0
     5844       then
     5845          vDateNew + 1.
     5846       return vDateNew.
     5847   end.
     5848   procedure checkEMRC:
     5849   define input  parameter iDm as character no-undo.
     5850   define output parameter vok as logical   no-undo init yes.
     5851      define variable v-value-emrc as character no-undo.
     5852      define variable v-type-emrc  as character no-undo.
     5853      define variable vDateIso     as character no-undo.
     5854      define variable vMRC         as decimal no-undo.
     5855      define variable vqnty        as decimal no-undo.
     5856      define variable vPrice       as decimal no-undo.
     5857      define variable vparent      as character no-undo.
     5858      define variable vgds-code    as integer no-undo.
     5859      define buffer code for ub.code.
     5860      vMRC = getMRCByDM(iDm).
     5861      if vMRC > 0
     5862      then do:
     5863         vgds-code = getGdsCodeByDM(iDm).
     5864         vqnty     = getQntyUTDByDM(iDm).
     5865               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     5866            (
     5867             input   vgds-code
     5868            ,input   'emrc-type':U
     5869            ,output   v-value-emrc
     5870            ,output   v-type-emrc
     5871          ) no-error.
     5872          if     v-value-emrc ne ""
     5873             and v-value-emrc ne ?
     5874          then do:
     5875             vDateIso = iso-date(today).
     5876             vPrice = vMRC / vqnty.
     5877             vparent ="emc" + chr(4) + v-value-emrc.
     5878             find last code where Code.parent      eq vparent
     5879                              and Code.code        le vDateIso
     5880                              and code.status_  eq 0
     5881             no-lock no-error.
     5882             if not available code or ( vPrice  >= dec(Code.CodeValue))
     5883             then
     5884                vOk = true .
     5885             else do:
     5886                 define variable vText      as character no-undo.
     5887                 define variable vDate      as date no-undo.
     5888                 define variable vDateLast  as character no-undo.
     5889                 define variable vDateFirst as character no-undo.
     5890                 define variable vDate3     as date no-undo.
     5891                 vdate = date(code.misc1).
     5892                 vDateLast = code.misc1.
     5893                 vDate3 = MoveDate(today, - 3 ).
     5894                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     5895                                      string(vDate3  , "99/99/9999"),
     5896                                      string(vDate   , "99/99/9999")
     5897                                      ).
     5898                 vdateIso = iso-date(vdate3).
     5899                 find last code  where Code.parent      eq vparent
     5900                                   and Code.code        le vDateIso
     5901                                   and code.status_  eq 0 no-lock no-error.
     5902                 if available code
     5903                 then
     5904                    vDateIso = code.code.
     5905                 vDateFirst = vDateIso.
     5906                 vDateLast = iso-date(vdate).
     5907                 define variable vGood as logical no-undo.
     5908                 define variable vDateSale as date no-undo.
     5909                 define buffer bcode for code.
     5910                 for last code where Code.parent   eq vparent
     5911                                 and code.status_  eq 0
     5912                                 and code.code     < vDateLast
     5913                                 and code.code     >= vDateFirst
     5914                 no-lock:
     5915                    find first bcode where bCode.parent   eq vparent
     5916                                       and bcode.status_  eq 0
     5917                                       and bcode.code     > code.code no-lock no-error.
     5918                    if available bcode
     5919                    then do:
     5920                       if vPrice < dec(Code.CodeValue)
     5921                       then
     5922                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     5923                                                     chr(10),
     5924                                                     string(    date( code.misc1)       ,"99/99/9999"),
     5925                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     5926                                                     ).
     5927                       else do:
     5928                          vGood = yes.
     5929                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     5930                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     5931                                                     chr(10),
     5932                                                     string(    date( code.misc1)         ,"99/99/9999"),
     5933                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     5934                                                     string(         vDateSale            ,"99/99/9999"),
     5935                                                     string(vDateSale - today)
     5936                                                     ).
     5937                       end.
     5938                    end.
     5939                 end.
     5940                 if vgood
     5941                 then do:
     5942                    define variable choice as integer no-undo .
     5943                    run gbl/d-askw.w (input "Уточнение"
     5944                           ,input  vText
     5945                           ,input "|"
     5946                           ,input "Принять|Вернуть"
     5947                           ,input "Принять данный товар|Вернуть товар постащику"
     5948                           ,input 1
     5949                           ,input 2
     5950                           ,output choice) no-error.
     5951                    vok = choice eq 1.
     5952                 end.
     5953                 else
     5954                    vok =false.
     5955             end.
     5956          end.
     5957      end.
     5958   end.
     5959   function addGs2Mark return character
     5960   (iMark as char):
     5961      define variable vDM   as character no-undo.
     5962      define variable vIdx  as integer   no-undo.
     5963      if index(iMark,chr(29),1) > 0
     5964      then return iMark.
     5965      if substring(iMark,26,4) = "8005" then
     5966      do:
     5967        vIdx = index(iMark,"93",26 + 4 + 5).
     5968        if vIdx > 1 then do:
     5969          vDM = substitute("&1&4&2&4&3",
     5970                           substring(iMark,1,25),
     5971                           substring(iMark,26,vIdx - 25 - 1),
     5972                           substring(iMark,vIdx),
     5973                           chr(29)) no-error.
     5974          vIdx = index(vDm,"240",vIdx + 4).
     5975          if vIdx > 0 then
     5976          do:
     5977            vDM = substitute("&1&3&2",
     5978                             substring(vDm,1,vIdx - 1),
     5979                             substring(vDm,vIdx),
     5980                             chr(29)) no-error.
     5981          end.
     5982        end.
     5983        else
     5984          vDM = substitute("&1&3&2",
     5985                           substring(iMark,1,25),
     5986                           substring(iMark,26),
     5987                           chr(29)) no-error.
     5988      end.
     5989      else if substring(iMark,32,2) = "91" then
     5990      do:
     5991        vIdx = index(iMark,"92",32).
     5992        if vIdx > 1 then
     5993          vDM = substitute("&1&4&2&4&3",
     5994                           substring(iMark,1,31),
     5995                           substring(iMark,32,vIdx - 31 - 1),
     5996                           substring(iMark,vIdx),
     5997                           chr(29)) no-error.
     5998        else
     5999          vDM = substitute("&1&3&2",
     6000                           substring(iMark,1,31),
     6001                           substring(iMark,32),
     6002                           chr(29)) no-error.
     6003      end.
     6004      else if substring(iMark,39,2) = "91" then
     6005      do:
     6006        vIdx = index(iMark,"92",38).
     6007        if vIdx > 1 then
     6008          vDM = substitute("&1&4&2&4&3",
     6009                           substring(iMark,1,38),
     6010                           substring(iMark,39,vIdx - 38 - 1),
     6011                           substring(iMark,vIdx),
     6012                           chr(29)) no-error.
     6013        else
     6014          vDM = substitute("&1&3&2",
     6015                           substring(iMark,1,38),
     6016                           substring(iMark,39),
     6017                           chr(29)) no-error.
     6018      end.
     6019      else if substring(iMark,25,2) = "93" then
     6020      do:
     6021        vIdx = index(iMark,"92",25).
     6022        if vIdx > 1 then
     6023          vDM = substitute("&1&4&2&4&3",
     6024                           substring(iMark,1,24),
     6025                           substring(iMark,25,vIdx - 24 - 1),
     6026                           substring(iMark,vIdx),
     6027                           chr(29)) no-error.
     6028        else
     6029          vIdx = index(iMark,"3103",25).
     6030          if vIdx > 0 then
     6031          vDM = substitute("&1&4&2&4&3",
     6032                           substring(iMark,1,24),
     6033                           substring(iMark,25,vIdx - 24 - 1),
     6034                           substring(iMark,vIdx),
     6035                           chr(29)) no-error.
     6036          else
     6037            vDM = substitute("&1&3&2",
     6038                             substring(iMark,1,24),
     6039                             substring(iMark,25),
     6040                             chr(29)) no-error.
     6041      end.
     6042      else if substring(iMark,32,2) = "93" then
     6043      do:
     6044        vDM = substitute("&1&3&2",
     6045              substring(iMark,1,31),
     6046              substring(iMark,32),
     6047              chr(29)) no-error.
     6048      end.
     6049      return if vDM <> "" then vDm else iMark.
     6050   end.
     6051   def var vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6052   function getattrUtdex returns char
     6053   (idb-num   as integer,
     6054    idoc-id   as integer,
     6055    iattrcode as character,
     6056    iExValue  as character  ):
     6057      define buffer utd-attr for utd-attr.
     6058      find first utd-attr where utd-attr.db-num eq idb-num
     6059                            and utd-attr.doc-id eq idoc-id
     6060                            and utd-attr.attr-code eq iattrcode
     6061      no-lock no-error.
     6062      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     6063   end.
     6064   function getattrUtd returns char
     6065   (idb-num   as integer,
     6066    idoc-id   as integer,
     6067    iattrcode as character ):
     6068     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     6069   end.
     6070   function setattrUtd returns logical
     6071   (idb-num   as integer,
     6072    idoc-id   as integer,
     6073    iattrcode as character,
     6074    iattrval  as character ):
     6075      define buffer utd-attr for utd-attr.
     6076      find first utd-attr where utd-attr.db-num eq idb-num
     6077                            and utd-attr.doc-id eq idoc-id
     6078                            and utd-attr.attr-code eq iattrcode
     6079      no-lock no-error.
     6080      if not available utd-attr
     6081      then do:
     6082         create utd-attr.
     6083         assign
     6084            utd-attr.db-num    = idb-num
     6085            utd-attr.doc-id    = idoc-id
     6086            utd-attr.attr-code = iattrcode
     6087            utd-attr.attr-value = iattrval
     6088         .
     6089      end.
     6090      else do:
     6091         if utd-attr.attr-value ne iattrval
     6092         then do:
     6093            find current utd-attr exclusive-lock no-error.
     6094            if available utd-attr
     6095            then
     6096               utd-attr.attr-value = iattrval.
     6097         end.
     6098      end.
     6099      release utd-attr.
     6100   end.
     6101   function GetAttrUtdlinesEx returns char
     6102   (idb-num   as integer,
     6103    idoc-id   as integer,
     6104    ilinenum  as integer,
     6105    iattrcode as character,
     6106    iExValue  as character  ):
     6107      define buffer utd-lines-attr for utd-lines-attr.
     6108      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     6109                                  and utd-lines-attr.doc-id    eq idoc-id
     6110                                  and utd-lines-attr.lineNum   eq ilineNum
     6111                                  and utd-lines-attr.attr-code eq iattrcode
     6112      no-lock no-error.
     6113      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
     6114   end.
     6115   function GetAttrUtdlines returns char
     6116   (idb-num   as integer,
     6117    idoc-id   as integer,
     6118    ilinenum  as integer,
     6119    iattrcode as character ):
     6120      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
     6121   end.
     6122   function setattrUtdlines returns logical
     6123   (idb-num   as integer,
     6124    idoc-id   as integer,
     6125    ilinenum  as integer,
     6126    iattrcode as character,
     6127    iattrval  as character ):
     6128      define buffer utd-lines-attr for utd-lines-attr.
     6129      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     6130                                  and utd-lines-attr.doc-id    eq idoc-id
     6131                                  and utd-lines-attr.lineNum   eq ilineNum
     6132                                  and utd-lines-attr.attr-code eq iattrcode
     6133      no-lock no-error.
     6134      if not available utd-lines-attr
     6135      then do:
     6136         if iattrval ne ?
     6137            and iattrval ne ""
     6138         then do:
     6139            create utd-lines-attr.
     6140            assign
     6141               utd-lines-attr.db-num    = idb-num
     6142               utd-lines-attr.doc-id    = idoc-id
     6143               utd-lines-attr.lineNum   = ilineNum
     6144               utd-lines-attr.attr-code = iattrcode
     6145               utd-lines-attr.attr-value = iattrval
     6146            .
     6147         end.
     6148      end.
     6149      else do:
     6150         if utd-lines-attr.attr-value ne iattrval
     6151         then do:
     6152            find current utd-lines-attr exclusive-lock no-error.
     6153            if available utd-lines-attr
     6154            then do:
     6155               if    iattrval eq ?
     6156                  or iattrval eq ""
     6157               then do:
     6158                  delete utd-lines-attr.
     6159               end.
     6160               else do:
     6161                  utd-lines-attr.attr-value = iattrval.
     6162               end.
     6163            end.
     6164         end.
     6165      end.
     6166      release utd-lines-attr.
     6167   end.
     6168   function GetAttrUtdMarkingLinesEx returns char
     6169   (idb-num   as integer,
     6170    idoc-id   as integer,
     6171    ilinenum  as integer,
     6172    imark     as character,
     6173    iattrcode as character,
     6174    iExValue  as character  ):
     6175      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
     6176      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
     6177                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     6178                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     6179                                          and utd-marking-lines-attr.mark      eq imark
     6180                                          and utd-marking-lines-attr.attr-code eq iattrcode
     6181      no-lock no-error.
     6182      return if not available utd-marking-lines-attr  then iExValue    else  utd-marking-lines-attr.attr-value.
     6183   end.
     6184   function GetAttrUtdMarkingLines returns char
     6185   (idb-num   as integer,
     6186    idoc-id   as integer,
     6187    ilinenum  as integer,
     6188    imark     as character,
     6189    iattrcode as character ):
     6190      return GetAttrUtdMarkingLinesEx (idb-num,idoc-id,ilinenum,imark,iattrcode,?).
     6191   end.
     6192   function setattrUtdMarkingLines returns logical
     6193   (idb-num   as integer,
     6194    idoc-id   as integer,
     6195    ilinenum  as integer,
     6196    imark     as character,
     6197    iattrcode as character,
     6198    iattrval  as character ):
     6199      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
     6200      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
     6201                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     6202                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     6203                                          and utd-marking-lines-attr.mark      eq imark
     6204                                          and utd-marking-lines-attr.attr-code eq iattrcode
     6205      no-lock no-error.
     6206      if not available utd-marking-lines-attr
     6207      then do:
     6208         if iattrval ne ?
     6209            and iattrval ne ""
     6210         then do:
     6211            create utd-marking-lines-attr.
     6212            assign
     6213               utd-marking-lines-attr.db-num     = idb-num
     6214               utd-marking-lines-attr.doc-id     = idoc-id
     6215               utd-marking-lines-attr.lineNum    = ilineNum
     6216               utd-marking-lines-attr.mark       = imark
     6217               utd-marking-lines-attr.attr-code  = iattrcode
     6218               utd-marking-lines-attr.attr-value = iattrval
     6219            .
     6220         end.
     6221      end.
     6222      else do:
     6223         if utd-marking-lines-attr.attr-value ne iattrval
     6224         then do:
     6225            find current utd-marking-lines-attr exclusive-lock no-error.
     6226            if available utd-marking-lines-attr
     6227            then do:
     6228               if    iattrval eq ?
     6229                  or iattrval eq ""
     6230               then do:
     6231                  delete utd-marking-lines-attr.
     6232               end.
     6233               else do:
     6234                  utd-marking-lines-attr.attr-value = iattrval.
     6235               end.
     6236            end.
     6237         end.
     6238      end.
     6239      release utd-marking-lines-attr.
     6240   end.
     6241   def var vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6242   def var vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6243   def var vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6244   function AddUtdErrForTab returns logical
     6245   (idb-num         as integer ,
     6246    idoc-id         as integer ,
     6247    iTab            as character,
     6248    iObj            as handle ,
     6249    iCheckType      as character,
     6250    iCodeErr        as character,
     6251    iCheckObj       as character ):
     6252      define buffer utd-err for utd-err.
     6253      define buffer utd for utd.
     6254      find first utd where utd.db-num     eq idb-num
     6255                       and utd.doc-id     eq idoc-id
     6256                       and utd.Direction  eq 'Outbound'
     6257      no-lock no-error.
     6258      if available utd
     6259      then
     6260         return no.
     6261      define variable vRecKey as character no-undo.
     6262            run gen-key-rec (input iTab,
     6263                             input  iObj,
     6264                             output vRecKey).
     6265      find first utd-err where utd-err.db-num     eq idb-num
     6266                           and utd-err.doc-id     eq idoc-id
     6267                           and utd-err.CheckType  eq iCheckType
     6268                           and utd-err.CodeErr    eq iCodeErr
     6269                           and utd-err.CheckObj   eq iCheckObj
     6270      exclusive-lock no-error.
     6271      if not available utd-err
     6272      then do:
     6273         create utd-err.
     6274         assign
     6275            utd-err.db-num         = idb-num
     6276            utd-err.doc-id         = idoc-id
     6277            utd-err.CheckType      = iCheckType
     6278            utd-err.CodeErr        = iCodeErr
     6279            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     6280            utd-err.reckey         = vRecKey
     6281            utd-err.qnty           = 1
     6282         .
     6283      end.
     6284      else
     6285         utd-err.qnty = utd-err.qnty + 1.
     6286      return utd-err.qnty eq 1.
     6287   end.
     6288   function AddUtdErr returns logical
     6289   (idb-num         as integer ,
     6290    idoc-id         as integer ,
     6291    iObj            as handle ,
     6292    iCheckType      as character,
     6293    iCodeErr        as character,
     6294    iCheckObj       as character ):
     6295      AddUtdErrForTab
     6296         (idb-num,
     6297          idoc-id,
     6298          iObj:table,
     6299          iObj,
     6300          iCheckType,
     6301          iCodeErr,
     6302          iCheckObj).
     6303   end.
     6304   function ClearUtdErrTypeCode returns logical
     6305   (idb-num         as integer,
     6306    idoc-id         as integer ,
     6307    iCheckType      as character,
     6308    iCodeErr        as character
     6309    ):
     6310      define buffer utd-err for utd-err.
     6311      if    iCheckType eq "*"
     6312         or iCheckType eq ?
     6313      then do:
     6314         if     iCodeErr ne ?
     6315            and iCodeErr ne "*"
     6316         then
     6317            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     6318            view-as alert-box.
     6319         else
     6320         for each utd-err where utd-err.db-num  eq idb-num
     6321                            and utd-err.doc-id  eq idoc-id
     6322         exclusive-lock:
     6323            delete utd-err.
     6324         end.
     6325      end.
     6326      else do:
     6327         if    iCodeErr eq ?
     6328            or iCodeErr eq "*"
     6329         then do:
     6330            for each utd-err where utd-err.db-num     eq idb-num
     6331                               and utd-err.doc-id     eq idoc-id
     6332                               and utd-err.CheckType  eq iCheckType
     6333            exclusive-lock:
     6334               delete utd-err.
     6335            end.
     6336         end.
     6337         else do:
     6338            for each utd-err where utd-err.db-num     eq idb-num
     6339                               and utd-err.doc-id     eq idoc-id
     6340                               and utd-err.CheckType  eq iCheckType
     6341                               and ub.utd-err.CodeErr eq iCodeErr
     6342            exclusive-lock:
     6343               delete utd-err.
     6344            end.
     6345         end.
     6346      end.
     6347   end.
     6348   function ClearUtdErr returns logical
     6349   (idb-num         as integer,
     6350    idoc-id         as integer ,
     6351    iCheckType      as character
     6352    ):
     6353      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     6354   end.
     6355   function GetMesError returns character
     6356   (itxt as character,
     6357    iobj as character ):
     6358    define variable vi as integer no-undo.
     6359    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     6360       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     6361    end.
     6362    return itxt.
     6363   end.
     6364   function GetTextErrorType returns character
     6365   (iCheckType as character,
     6366    iCodeErr   as character,
     6367    iChechObj  as character,
     6368    iType      as character  ):
     6369      define buffer code    for code.
     6370      define variable vError as character no-undo.
     6371      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     6372                        and code.code   eq iCodeErr
     6373      no-lock no-error.
     6374      if available code
     6375      then do:
     6376         define variable vType as integer no-undo.
     6377         if code.misc3 eq "error"
     6378         then
     6379            vType = 0.
     6380         else if code.misc3 eq "warning"
     6381         then
     6382            vType = 1.
     6383         else if code.misc3 eq "Hiden"
     6384         then
     6385            vType = 2.
     6386         else
     6387            vtype = int(code.misc3) no-error.
     6388         case itype:
     6389            when "error"
     6390            then do:
     6391               if vtype eq 0
     6392               then
     6393                  vError = GetMesError(Code.CodeValue,iChechObj).
     6394            end.
     6395            when "warning"
     6396            then do:
     6397               if vtype <= 1
     6398               then
     6399                  vError = GetMesError(Code.CodeValue,iChechObj).
     6400            end.
     6401            otherwise do:
     6402               vError = GetMesError(Code.CodeValue,iChechObj).
     6403            end.
     6404         end.
     6405      end.
     6406      else
     6407         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     6408      return vError.
     6409   end.
     6410   function GetTypeError returns integer
     6411   (iCheckType as character,
     6412    iCodeErr   as character):
     6413      define buffer code    for code.
     6414      define variable vType as integer no-undo.
     6415      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     6416                        and code.code   eq iCodeErr
     6417      no-lock no-error.
     6418      if     not available code
     6419         and code.misc3 eq "error"
     6420      then
     6421         vType = 0.
     6422      else if code.misc3 eq "warning"
     6423      then
     6424         vType = 1.
     6425      else if code.misc3 eq "Hiden"
     6426      then
     6427         vType = 2.
     6428      else
     6429         vtype = int(code.misc3) no-error.
     6430      return vtype.
     6431   end.
     6432   function GetTextError returns character
     6433   (iCheckType as character,
     6434    iCodeErr   as character,
     6435    iChechObj  as character ):
     6436      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     6437   end.
     6438   function GetErrForUtdStr returns character
     6439   (idb-num     as integer ,
     6440    idoc-id     as integer ,
     6441    iCheckType  as character
     6442    ):
     6443      define buffer utd-err for utd-err.
     6444      define buffer code    for code.
     6445      define variable vHQry as handle no-undo.
     6446      define variable vError as longchar no-undo.
     6447      define variable vErrorOne as longchar  no-undo.
     6448      define variable oError as character no-undo.
     6449      create query vHQry.
     6450      vHQry:set-buffers(buffer utd-err:handle).
     6451      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6452                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6453                               + if    iCheckType eq "*"
     6454                                    or iCheckType eq ?
     6455                                 then       ""
     6456                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6457      vHQry:query-open().
     6458      vHQry:get-first().
     6459      QRY-BLOCK:
     6460      repeat while not vHQry:query-off-end:
     6461         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     6462         if     vErrorOne ne ""
     6463            and vErrorOne ne ?
     6464         then
     6465            vError = vError + ", " + vErrorOne.
     6466         vHQry:get-next().
     6467      end.
     6468      oError = substring(vError,3,4002).
     6469      return oError.
     6470   end.
     6471   function GetErrJsonForUtd returns character
     6472   (idb-num         as integer ,
     6473    idoc-id         as integer ,
     6474    iCheckType      as character
     6475    ):
     6476      define buffer utd-err for utd-err.
     6477      define variable vHQry as handle no-undo.
     6478      define variable vError as longchar no-undo.
     6479      define variable oError as character no-undo.
     6480      create query vHQry.
     6481      define variable vi as integer no-undo.
     6482      vHQry:set-buffers(buffer utd-err:handle).
     6483      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6484                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6485                               + if    iCheckType eq "*"
     6486                                    or iCheckType eq ?
     6487                                 then       ""
     6488                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6489      vHQry:query-open().
     6490      vHQry:get-first().
     6491      QRY-BLOCK:
     6492      repeat while not vHQry:query-off-end:
     6493         define variable vErrorOne as character no-undo.
     6494         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     6495         if     vErrorOne ne ?
     6496            and vErrorOne ne ""
     6497         then do:
     6498            vi = vi + 1.
     6499            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     6500                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     6501                            + '","ТекстОш":"' + vErrorOne + '"}'.
     6502         end.
     6503         vHQry:get-next().
     6504      end.
     6505      for first utd where utd.db-num eq idb-num
     6506                      and utd.doc-id eq idoc-id
     6507                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     6508      no-lock,
     6509         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     6510                                  and utd-marking-lines.doc-id eq idoc-id
     6511                                  and utd-marking-lines.doc-level eq 1
     6512      no-lock,
     6513         first marking where marking.mark eq utd-marking-lines.mark
     6514                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     6515      no-lock:
     6516         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     6517         if     vErrorOne ne ?
     6518            and vErrorOne ne ""
     6519         then do:
     6520            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     6521                            + '","ОбъектОш":"' + marking.mark
     6522                            + '","ТекстОш":"' + vErrorOne + '"}'.
     6523         end.
     6524      end.
     6525      if vError ne ""
     6526      then
     6527         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     6528      return oError.
     6529   end.
     6530   function GetErrJsonForUtdReturn returns character
     6531   (idb-num         as integer ,
     6532    idoc-id         as integer ,
     6533    iCheckType      as character
     6534    ):
     6535      define buffer utd-err for utd-err.
     6536      define variable vHQry as handle no-undo.
     6537      define variable vError as longchar no-undo.
     6538      define variable oError as character no-undo.
     6539      define variable vi as integer no-undo.
     6540      create query vHQry.
     6541      vHQry:set-buffers(buffer utd-err:handle).
     6542      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6543                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6544                               + if    iCheckType eq "*"
     6545                                    or iCheckType eq ?
     6546                                 then       ""
     6547                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6548      vHQry:query-open().
     6549      vHQry:get-first().
     6550      QRY-BLOCK:
     6551      repeat while not vHQry:query-off-end:
     6552         define variable vErrorOne as character no-undo.
     6553         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     6554         if     vErrorOne ne ?
     6555            and vErrorOne ne ""
     6556         then do:
     6557            vi = vi + 1.
     6558            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     6559                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     6560                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     6561         end.
     6562         vHQry:get-next().
     6563      end.
     6564      if vError ne ""
     6565      then
     6566         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     6567      return oError.
     6568   end.
     6569   function GetCodeTextError returns character
     6570   (iCheckType as character,
     6571    iCodeErr   as character,
     6572    iChechObj  as character,
     6573    output oCode as character,
     6574    output ovalue as character ):
     6575      define buffer code    for code.
     6576      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     6577                        and code.code   eq iCodeErr
     6578      no-lock no-error.
     6579      if     available code
     6580      then do:
     6581         define variable vi as integer no-undo init ?.
     6582         vi = int(Code.misc3) no-error.
     6583         if    code.misc3 ne "error"
     6584            and vi ne 0
     6585         then
     6586            oCode = ?.
     6587         else if     Code.misc1 ne ?
     6588                 and Code.misc1 ne ""
     6589         then
     6590            assign
     6591               oCode  = GetMesError(Code.misc1,iChechObj)
     6592               ovalue = GetMesError(Code.misc2,iChechObj)
     6593            .
     6594      end.
     6595      return if oCode eq ""
     6596             then ""
     6597             else (oCode + "_" + ovalue).
     6598   end.
     6599   define temp-table TT-err no-undo
     6600     field code_ as character
     6601     field text_ as character
     6602   index code_ code_.
     6603   function GetErrTxtForUtd returns character
     6604   (idb-num         as integer ,
     6605    idoc-id         as integer ,
     6606    iCheckType      as character
     6607    ):
     6608      define buffer utd-err for utd-err.
     6609      define variable vHQry as handle no-undo.
     6610      define variable oError as character no-undo.
     6611      create query vHQry.
     6612      define variable vi as integer no-undo.
     6613      for each tt-err :
     6614         delete tt-err.
     6615      end.
     6616      vHQry:set-buffers(buffer utd-err:handle).
     6617      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6618                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6619                               + if    iCheckType eq "*"
     6620                                    or iCheckType eq ?
     6621                                 then       ""
     6622                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6623      vHQry:query-open().
     6624      vHQry:get-first().
     6625      define variable vcode as character no-undo.
     6626      define variable vvalue as character no-undo.
     6627      QRY-BLOCK:
     6628      repeat while not vHQry:query-off-end:
     6629         vi = vi + 1.
     6630         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     6631         if vcode ne ?
     6632         then do:
     6633            find first tt-err where tt-err.code eq vcode
     6634            no-error.
     6635            if not available tt-err
     6636            then do:
     6637               create tt-err.
     6638               assign
     6639                  tt-err.code_ = vcode
     6640                  tt-err.text_ = vvalue
     6641               .
     6642            end.
     6643            else
     6644               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     6645         end.
     6646         vHQry:get-next().
     6647      end.
     6648     find first utd where utd.db-num eq idb-num
     6649                         and utd.doc-id eq idoc-id
     6650         no-lock.
     6651      define buffer cancel_utd-lines for utd-lines.
     6652      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     6653                                  and cancel_utd-lines.doc-id eq idoc-id
     6654      no-lock:
     6655         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     6656         then do:
     6657            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     6658                                        and utd-marking-lines.doc-id eq idoc-id
     6659                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     6660            no-lock,
     6661               first marking where marking.mark eq utd-marking-lines.mark
     6662                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     6663            no-lock:
     6664               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     6665               find first tt-err where tt-err.code eq vcode
     6666               no-error.
     6667               if not available tt-err
     6668               then do:
     6669                  create tt-err.
     6670                  assign
     6671                     tt-err.code_ = vcode
     6672                     tt-err.text_ = vvalue
     6673                  .
     6674               end.
     6675               else
     6676                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     6677            end.
     6678         end.
     6679         else do:
     6680            define variable vqnty as decimal no-undo.
     6681            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     6682            if vqnty eq ? then vqnty = 0.
     6683            if vqnty ne cancel_utd-lines.Quantity
     6684            then do:
     6685               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     6686               find first tt-err where tt-err.code eq vcode
     6687               no-error.
     6688               if not available tt-err
     6689               then do:
     6690                  create tt-err.
     6691                  assign
     6692                     tt-err.code_ = vcode
     6693                     tt-err.text_ = vvalue
     6694                  .
     6695               end.
     6696               else
     6697                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     6698            end.
     6699         end.
     6700      end.
     6701      for each tt-err:
     6702         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     6703      end.
     6704      return oError.
     6705   end.
     6706   define variable mFormatErr as character no-undo init "text".
     6707   function GetErrForUtd returns character
     6708   (idb-num         as integer ,
     6709    idoc-id         as integer ,
     6710    iType           as character
     6711    ):
     6712      if mFormatErr eq "text"
     6713      then
     6714         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     6715      else do:
     6716         if itype eq "return"
     6717         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     6718         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     6719      end.
     6720   end.
     6721   function GetErrComText returns longchar
     6722   (icomment as character,
     6723    itext    as longchar ):
     6724       define variable vText as longchar no-undo.
     6725      if mFormatErr eq "text"
     6726      then do:
     6727         if icomment ne ""
     6728         then
     6729            icomment = substitute("comment:|&1|",icomment).
     6730         vText = icomment + itext.
     6731      end.
     6732      else do:
     6733         icomment = if icomment begins  '"'
     6734                    then icomment
     6735                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     6736         vText = icomment + "," + itext.
     6737         vText = "~{" + trim(vText,",") + "~}".
     6738      end.
     6739      return vText.
     6740   end.
     6741   function CheckTypeForMarkLineType returns logical
     6742   (iObj            as handle,
     6743    iCheckType      as character,
     6744    iCodeErr        as character ,
     6745    iTypeErr        as character ):
     6746      define variable vRecKey-markLine as character no-undo.
     6747      define variable vGoodMark        as logical no-undo.
     6748      define variable vdb-num          as integer no-undo.
     6749      define variable vdoc-id          as integer no-undo.
     6750      define variable vlinenum         as integer no-undo.
     6751      define variable vErrorOne as character no-undo.
     6752      define buffer buf_utd-err for utd-err.
     6753      run gen-key-rec (input "utd-marking-lines",
     6754                       input  iObj,
     6755                       output vRecKey-markLine).
     6756      vGoodMark = yes.
     6757      vdb-num = iObj::db-num.
     6758      vdoc-id = iObj::doc-id.
     6759      vlinenum = iObj::linenum.
     6760      block-mark-err:
     6761      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     6762                               and buf_utd-err.db-num = vdb-num
     6763                               and buf_utd-err.reckey = vRecKey-markLine
     6764                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     6765                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     6766      no-lock:
     6767         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     6768         if     vErrorOne ne ?
     6769            and vErrorOne ne ""
     6770         then do:
     6771            vGoodMark = no.
     6772            leave block-mark-err.
     6773         end.
     6774      end.
     6775      return not vGoodMark.
     6776   end.
     6777   function CheckErrForMarkLineType returns logical
     6778   (iObj            as handle,
     6779    iType           as character  ):
     6780      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     6781   end.
     6782   function CheckErrForMarkLine returns logical
     6783   (iObj            as handle):
     6784      return CheckErrForMarkLineType(iObj,"*").
     6785   end.
     6786   function CheckErrForLineTypeCode returns logical
     6787   (iObj                 as handle,
     6788    iCheckType           as character,
     6789    iCodeErr             as character,
     6790    iTypeErr             as character,
     6791    iOneErr              as logical):
     6792      define variable vRecKey-line     as character no-undo.
     6793      define buffer buf_utd-err for utd-err.
     6794      define variable vUtdlineError as logical no-undo.
     6795      define variable vErrorOne as character no-undo.
     6796            run gen-key-rec (input "utd-lines",
     6797                             input  iObj,
     6798                             output vRecKey-line).
     6799         define variable vdb-num as integer no-undo.
     6800         define variable vdoc-id as integer no-undo.
     6801         define variable vlinenum as integer no-undo.
     6802         vdb-num = iObj::db-num.
     6803         vdoc-id = iObj::doc-id.
     6804         vlinenum = iObj::linenum.
     6805         block-err:
     6806         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     6807                                  and buf_utd-err.db-num = vdb-num
     6808                                  and buf_utd-err.reckey = vRecKey-line
     6809                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     6810                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     6811         no-lock:
     6812            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     6813            if     vErrorOne ne ?
     6814               and vErrorOne ne ""
     6815            then do:
     6816               vUtdlineError = yes.
     6817               leave block-err.
     6818            end.
     6819         end.
     6820         if  not vUtdlineError
     6821         then do:
     6822            define variable vGoodMark as logical no-undo.
     6823            vGoodMark = yes.
     6824            block-line-err:
     6825            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     6826                                         and utd-marking-lines.doc-id  eq vdoc-id
     6827                                         and utd-marking-lines.LineNum eq vLineNum
     6828            no-lock:
     6829               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     6830               if     vGoodMark
     6831                  and iOneErr eq no
     6832               then
     6833                  leave block-line-err.
     6834               if     iOneErr = yes
     6835                  and not vGoodMark
     6836               then
     6837                  leave block-line-err.
     6838            end.
     6839            vUtdlineError = not vGoodMark.
     6840         end.
     6841      return vUtdlineError.
     6842   end.
     6843   function getErrForLineType returns character
     6844   (iObj            as handle,
     6845    iType           as character  ):
     6846      define variable vRecKey-line     as character no-undo.
     6847      define buffer buf_utd-err for utd-err.
     6848      define variable vUtdlineError as logical no-undo.
     6849      define variable vErrorOne as character no-undo.
     6850      define variable oError as character no-undo.
     6851            run gen-key-rec (input "utd-lines",
     6852                             input  iObj,
     6853                             output vRecKey-line).
     6854         define variable vdb-num as integer no-undo.
     6855         define variable vdoc-id as integer no-undo.
     6856         define variable vlinenum as integer no-undo.
     6857         vdb-num = iObj::db-num.
     6858         vdoc-id = iObj::doc-id.
     6859         vlinenum = iObj::linenum.
     6860         block-err:
     6861         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     6862                                  and buf_utd-err.db-num = vdb-num
     6863                                  and buf_utd-err.reckey = vRecKey-line
     6864                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     6865         no-lock:
     6866            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     6867            if     vErrorOne ne ?
     6868               and vErrorOne ne ""
     6869            then do:
     6870               oError = oError + vErrorOne + " ".
     6871            end.
     6872         end.
     6873      return oError.
     6874   end.
     6875   function CheckErrForLineType returns logical
     6876   (iObj            as handle,
     6877    iType           as character  ):
     6878       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     6879   end.
     6880   function CheckErrForLine returns logical
     6881   (iObj            as handle):
     6882      return CheckErrForLineType(iobj,"*").
     6883   end.
     6884   function CheckErrForUtd returns logical
     6885   (idb-num         as integer ,
     6886    idoc-id         as integer ):
     6887      for each utd-lines where utd-lines.db-num eq idb-num
     6888                           and utd-lines.doc-id eq idoc-id
     6889      no-lock :
     6890         if not CheckErrForLine (buffer ub.utd-lines:handle)
     6891         then
     6892            return no.
     6893      end.
     6894      return yes.
     6895   end.
     6896   function CheckMarkUtd-28rel return logical
     6897    (input idb-num as integer,
     6898    input idoc-id as integer):
     6899    define buffer utd                   for utd.
     6900    define buffer utd-lines             for utd-lines.
     6901    define buffer utd-marking-lines     for utd-marking-lines.
     6902    define variable v-par-type as character no-undo.
     6903    define variable vgdsNoMark as logical no-undo.
     6904    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     6905      define variable v-par-val  as character no-undo.
     6906      find first utd where utd.db-num eq idb-num
     6907                       and utd.doc-id eq idoc-id
     6908      no-lock no-error.
     6909      if available utd
     6910      then do:
     6911         if     utd.obj-code ne ?
     6912            and utd.obj-type ne ?
     6913         then do:
     6914            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     6915            Block-utd-lines:
     6916            for each utd-lines where utd-lines.db-num eq idb-num
     6917                                 and utd-lines.doc-id eq idoc-id
     6918            no-lock:
     6919               if     utd-lines.gds-code ne ?
     6920                  and utd-lines.gds-code ne 0
     6921               then do:
     6922                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     6923                       ( utd-lines.gds-code,
     6924                         'mark-type':U,
     6925                          output v-par-val,
     6926                          output v-par-type
     6927                       ).
     6928                  if     EDOParSec:IsEdo
     6929                     and EDOParSec:GetIsEDOForType(v-par-val)
     6930                  then do:
     6931                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     6932                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     6933                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     6934                                                    and length(utd-marking-lines.mark) > 13
     6935                     no-lock no-error.
     6936                     if     avail utd-marking-lines
     6937                        and not CheckErrForLine(buffer utd-lines:handle)
     6938                     then
     6939                        leave Block-utd-lines.
     6940                  end.
     6941                  else
     6942                     vgdsNoMark = yes.
     6943               end.
     6944            end.
     6945            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     6946            if vgdsNoMark then return available utd-lines . else return yes .
     6947         end.
     6948      end.
     6949      return yes.
     6950   end.
     6951   function CheckMarkUtd return logical
     6952    (input idb-num  as integer,
     6953     input idoc-id  as integer):
     6954     define buffer utd-lines             for ub.utd-lines.
     6955     block-line:
     6956     for each utd-lines where utd-lines.db-num eq idb-num
     6957                          and utd-lines.doc-id eq idoc-id
     6958     no-lock:
     6959        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     6960        then
     6961           leave block-line.
     6962     end.
     6963     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     6964     return available utd-lines.
     6965   end.
     6966   function CheckNotMarkUtd return logical
     6967    (input idb-num  as integer,
     6968     input idoc-id  as integer):
     6969     define buffer utd-lines             for ub.utd-lines.
     6970     for each utd-lines where utd-lines.db-num eq idb-num
     6971                          and utd-lines.doc-id eq idoc-id
     6972     no-lock:
     6973        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     6974        then
     6975           return yes.
     6976     end.
     6977     return no.
     6978   end.
     6979   function CheckMarkUtdLine return logical
     6980    (input idb-num  as integer,
     6981     input idoc-id  as integer,
     6982     input iLineNum as integer):
     6983    define buffer utd                   for utd.
     6984    define buffer utd-lines             for utd-lines.
     6985    define buffer utd-marking-lines     for utd-marking-lines.
     6986    define variable v-par-type as character no-undo.
     6987    define variable vMarking        as logical no-undo.
     6988    define variable vArtic          as logical no-undo.
     6989    define variable vTransitional   as logical no-undo.
     6990    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     6991      define variable v-par-val  as character no-undo.
     6992      find first utd where utd.db-num eq idb-num
     6993                       and utd.doc-id eq idoc-id
     6994      no-lock no-error.
     6995      if available utd
     6996      then do:
     6997         if     utd.obj-code ne ?
     6998            and utd.obj-type ne ?
     6999         then do:
     7000            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     7001            Block-utd-lines:
     7002            for each utd-lines where utd-lines.db-num   eq idb-num
     7003                                 and utd-lines.doc-id   eq idoc-id
     7004                                 and utd-lines.LineNum  eq iLineNum
     7005            no-lock:
     7006               if     utd-lines.gds-code ne ?
     7007                  and utd-lines.gds-code ne 0
     7008               then do:
     7009                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     7010                       ( utd-lines.gds-code,
     7011                         'mark-type':U,
     7012                          output v-par-val,
     7013                          output v-par-type
     7014                       ).
     7015                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     7016                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     7017                  if vMarking
     7018                  then do:
     7019                     block-marking:
     7020                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     7021                                                    and utd-marking-lines.doc-id   eq idoc-id
     7022                                                    and utd-marking-lines.LineNum  eq iLineNum
     7023                                                    and length(utd-marking-lines.mark) > 13
     7024                     no-lock:
     7025                        if isOAD(utd-marking-lines.mark)
     7026                        then do:
     7027                           assign
     7028                              vArtic   = yes
     7029                              vMarking = no
     7030                           .
     7031                           leave block-marking.
     7032                        end.
     7033                     end.
     7034                  end.
     7035                  if vArtic
     7036                  then do:
     7037                     block-artic:
     7038                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     7039                                                    and utd-marking-lines.doc-id   eq idoc-id
     7040                                                    and utd-marking-lines.LineNum  eq iLineNum
     7041                                                    and length(utd-marking-lines.mark) > 13
     7042                     no-lock:
     7043                        if isMark(utd-marking-lines.mark)
     7044                        then do:
     7045                           assign
     7046                              vArtic   = no
     7047                              vMarking = yes
     7048                           .
     7049                           leave block-artic.
     7050                        end.
     7051                     end.
     7052                  end.
     7053                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     7054                  if vTransitional
     7055                  then do:
     7056                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     7057                                                    and utd-marking-lines.doc-id   eq idoc-id
     7058                                                    and utd-marking-lines.LineNum  eq iLineNum
     7059                                                    and length(utd-marking-lines.mark) > 13
     7060                     no-lock no-error.
     7061                     if not available utd-marking-lines
     7062                     then assign
     7063                        vMarking = no
     7064                        vArtic   = no
     7065                     .
     7066                  end.
     7067               end.
     7068               else
     7069                  assign
     7070                     vMarking      = yes
     7071                     vArtic        = no
     7072                     vTransitional = no
     7073                  .
     7074               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     7075               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     7076               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     7077            end.
     7078         end.
     7079      end.
     7080      return vMarking or vArtic.
     7081   end.
     7082   function getMarkUtdLine return logical
     7083    (input  idb-num  as integer,
     7084     input  idoc-id  as integer,
     7085     input  iLineNum as integer,
     7086     output oMarking        as logical,
     7087     output oArtic          as logical,
     7088     output oTransitional   as logical):
     7089     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     7090     oArtic        = not oMarking
     7091            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     7092     oTransitional = (oMarking or oArtic)
     7093            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     7094   end.
     7095   function CheckMarking return logical
     7096    (input idb-num as integer,
     7097    input idoc-id as integer,
     7098    input iTypeErr as character ):
     7099     define variable vMarkutd as logical no-undo.
     7100     define variable vCrErr   as logical no-undo.
     7101     define buffer utd-lines         for utd-lines.
     7102     define buffer utd-marking-lines for utd-marking-lines.
     7103     define buffer marking           for marking.
     7104     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     7105      block-line:
     7106      for each utd-lines where utd-lines.db-num eq idb-num
     7107                           and utd-lines.doc-id eq idoc-id
     7108      no-lock:
     7109         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     7110         then do:
     7111            for each utd-marking-lines
     7112                     where utd-marking-lines.db-num  = utd-lines.db-num
     7113                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     7114                       and utd-marking-lines.LineNum = utd-lines.LineNum
     7115            no-lock:
     7116               if isMark(utd-marking-lines.mark)
     7117               then do:
     7118                  find first marking where marking.mark eq utd-marking-lines.mark
     7119                  no-lock no-error.
     7120                  if not available marking
     7121                  then do:
     7122                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     7123                     vCrErr = yes.
     7124                     next block-line.
     7125                  end.
     7126               end.
     7127            end.
     7128         end.
     7129      end.
     7130      return vCrErr.
     7131   end.
     7132   function CheckMarkForType return logical
     7133    (input idb-num   as integer,
     7134     input idoc-id   as integer):
     7135      define variable vMarking        as logical no-undo.
     7136      define variable vArtic          as logical no-undo.
     7137      define variable vTransitional   as logical no-undo.
     7138      define buffer utd-lines         for utd-lines.
     7139      define buffer utd-marking-lines for utd-marking-lines.
     7140      block-line:
     7141      for each utd-lines where utd-lines.db-num eq idb-num
     7142                           and utd-lines.doc-id eq idoc-id
     7143      no-lock:
     7144         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     7145                          output vMarking         , output vArtic          , output vTransitional).
     7146         for each utd-marking-lines
     7147                     where utd-marking-lines.db-num  = utd-lines.db-num
     7148                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     7149                       and utd-marking-lines.LineNum = utd-lines.LineNum
     7150         no-lock:
     7151            if length(utd-marking-lines.mark) < 14
     7152            then do:
     7153               if (vMarking or vArtic) and not vTransitional
     7154               then
     7155                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     7156            end.
     7157            else if not isMark(utd-marking-lines.mark)
     7158            then do:
     7159               if vMarking
     7160               then
     7161                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     7162            end.
     7163            else do:
     7164            end.
     7165         end.
     7166      end.
     7167   end.
     7168   function WeighedProd return logical
     7169      ( input p-gds-code as integer) :
     7170      define variable v-par-val  as character no-undo.
     7171      define variable v-par-type as character no-undo.
     7172              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     7173               ( p-gds-code,
     7174                 'weighed-gds':U,
     7175                  output v-par-val,
     7176                  output v-par-type
     7177               ).
     7178      return logical(v-par-val).
     7179   end.
     7180   function WghProdVariable return logical
     7181       (input p-obj-type as char,
     7182        input p-obj-code as integer,
     7183        input p-gds-code as integer) :
     7184      define variable v-wgh-val  as character no-undo.
     7185      define variable v-par-val  as character no-undo.
     7186      define variable v-par-type as character no-undo.
     7187      define variable vMarking        as logical no-undo.
     7188      define variable vArtic          as logical no-undo.
     7189      define variable vTransitional   as logical no-undo.
     7190      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     7191         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     7192           ( p-gds-code,
     7193             'weighed-gds':U,
     7194              output v-wgh-val,
     7195              output v-par-type
     7196           ).
     7197       if logical(v-wgh-val) = yes then do:
     7198           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     7199               ( p-gds-code,
     7200                 'mark-type':U,
     7201                  output v-par-val,
     7202                  output v-par-type
     7203               ).
     7204           if v-par-val <> "" then do:
     7205               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     7206               assign
     7207                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     7208                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     7209                  .
     7210           end.
     7211      end.
     7212      if v-wgh-val > "" and (vMarking or vArtic)
     7213      then return yes.
     7214      else return no.
     7215   end.
     7216   function MarkWeight return decimal
     7217      ( input p-mark as character) :
     7218      define buffer  buf_marking-attr for  ub.marking-attr.
     7219      define variable vMarkWeight as decimal no-undo.
     7220      vMarkWeight = 0.
     7221      if p-mark <> "" and p-mark <> ?
     7222      then do:
     7223          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     7224                                        and buf_marking-attr.attr-code eq "weight"
     7225             no-lock no-error.
     7226          if not available buf_marking-attr
     7227          then do :
     7228            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     7229                                          and buf_marking-attr.attr-code eq "weight"
     7230               no-lock no-error.
     7231          end .
     7232          if avail buf_marking-attr
     7233          then vMarkWeight = dec(buf_marking-attr.attr-value).
     7234      end.
     7235      return vMarkWeight.
     7236   end.
