    14334   end.
    14335   on ctrl-b of t-doc.fact-date in frame d-out-doc
    14336   do:
    14337     if (can-query (self, "sensitive")
    14338        and
    14339        self :sensitive = true
    14340        )
    14341     or (can-query (self, "read-only")
    14342        and
    14343        self :read-only = false
    14344        )
    14345     then do:
    14346       if self :handle <> focus :handle
    14347       then do:
    14348         apply "entry":u to self .
    14349       end.
    14350       define variable v-curr-sv-date as date no-undo .
