    17529   PROCEDURE inv-line_price :
    17530     define  input parameter p-gds-dtl-rec  as   recid                 no-undo.
    17531     define  input parameter p-print-rubl   as   logical               no-undo.
    17532     define output parameter p-out-price-kg like ub.gds-dtl.price-rubl no-undo initial 0.0.
    17533     define variable p-inv-line-rec as recid   no-undo.
    17534     define variable is-petrol      as logical no-undo.
    17535     define variable is-pieces      as logical no-undo.
    17536     define buffer buf_inv-line for ub.inv-line.
    17537     define buffer buf_gds-dtl  for ub.gds-dtl.
    17538     do on error undo, return error return-value :
    17539       find buf_gds-dtl        no-lock where recid( buf_gds-dtl ) = p-gds-dtl-rec no-error.
    17540       if not available buf_gds-dtl then do:
    17541         assign p-out-price-kg = ?.
    17542         undo, return error "inv-line_price: не найдена строка накладной".
    17543       end.
    17544   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
    17545     (
    17546        input buf_gds-dtl.artic
    17547     ,  input buf_gds-dtl.prod-type
    17548     ,  input buf_gds-dtl.prod-code
    17549     , output is-petrol
    17550     , output is-pieces
    17551     ) no-error.
    17552       if error-status :error or v-is-ptrl <> "yes" or is-petrol <> yes or is-pieces <> no then do:
    17553         undo, return error substitute( 'inv-line_price: &1 (произв. &2 &3) не топливный товар',
    17554                                        buf_gds-dtl.artic, buf_gds-dtl.prod-type, buf_gds-dtl.prod-code ).
    17555       end.
    17556       find buf_inv-line no-lock where
    17557            buf_inv-line.doc-code  = buf_gds-dtl.doc-code  and
    17558            buf_inv-line.artic     = buf_gds-dtl.artic     and
    17559            buf_inv-line.prod-code = buf_gds-dtl.prod-code and
    17560            buf_inv-line.prod-type = buf_gds-dtl.prod-type no-error.
    17561       if available buf_inv-line then do:
    17562         assign
    17563           p-inv-line-rec = recid( buf_inv-line )
    17564         .
    17565         find buf_gds-dtl  exclusive-lock where recid( buf_gds-dtl  ) = p-gds-dtl-rec.
    17566         find buf_inv-line exclusive-lock where recid( buf_inv-line ) = p-inv-line-rec.
    17567         assign
    17568           p-out-price-kg = ( if p-print-rubl = yes then buf_inv-line.wast-rubl else buf_inv-line.wast-base )
    17569         .
    17570         find buf_inv-line        no-lock where recid( buf_inv-line ) = p-inv-line-rec.
    17571         find buf_gds-dtl         no-lock where recid( buf_gds-dtl  ) = p-gds-dtl-rec.
    17572         release buf_inv-line.
    17573         release buf_gds-dtl.
    17574       end.
    17575     end.
    17576   END PROCEDURE.
    17577   PROCEDURE inv-line_qnty :
    17578     define  input parameter p-gds-dtl-rec as   recid                no-undo.
    17579     define output parameter p-out-qnty-kg like ub.gds-dtl.fact-qnty no-undo initial 0.0.
    17580     define variable is-petrol as logical no-undo.
    17581     define variable is-pieces as logical no-undo.
    17582     define buffer buf_inv-line for ub.inv-line.
    17583     define buffer buf_gds-dtl  for ub.gds-dtl.
    17584     do on error undo, return error return-value :
    17585       find buf_gds-dtl no-lock where recid( buf_gds-dtl ) = p-gds-dtl-rec no-error.
    17586       if not available buf_gds-dtl then do:
    17587         assign p-out-qnty-kg = ?.
    17588         undo, return error "inv-line_qnty: не найдена строка накладной".
    17589       end.
    17590   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
    17591     (
    17592        input buf_gds-dtl.artic
    17593     ,  input buf_gds-dtl.prod-type
    17594     ,  input buf_gds-dtl.prod-code
    17595     , output is-petrol
    17596     , output is-pieces
    17597     ) no-error.
    17598       if error-status :error or v-is-ptrl <> "yes" or is-petrol <> yes or is-pieces <> no then do:
    17599         undo, return error substitute( 'inv-line_qnty: &1 (произв. &2 &3) не топливный товар',
    17600                                        buf_gds-dtl.artic, buf_gds-dtl.prod-type, buf_gds-dtl.prod-code ).
    17601       end.
    17602       find buf_inv-line no-lock where
    17603            buf_inv-line.doc-code  = buf_gds-dtl.doc-code  and
    17604            buf_inv-line.artic     = buf_gds-dtl.artic     and
    17605            buf_inv-line.prod-code = buf_gds-dtl.prod-code and
    17606            buf_inv-line.prod-type = buf_gds-dtl.prod-type no-error.
    17607       if available buf_inv-line then do: assign p-out-qnty-kg = buf_inv-line.wast-cli-qnty. end.
    17608     end.
    17609   END PROCEDURE.
    17610   PROCEDURE inv-line_recalc-qty :
    17611     define input parameter p-doc-code  like ub.gds-dtl.doc-code  no-undo.
    17612     define input parameter p-artic     like ub.gds-dtl.artic     no-undo.
    17613     define input parameter p-prod-type like ub.gds-dtl.prod-type no-undo.
    17614     define input parameter p-prod-code like ub.gds-dtl.prod-code no-undo.
    17615     define input parameter p-is-fact   as   logical              no-undo.
    17616     define input parameter p-doc-qnty  like ub.gds-dtl.doc-qnty  no-undo.
    17617     define input parameter p-fact-qnty like ub.gds-dtl.fact-qnty no-undo.
    17618     define variable is_OK     as logical no-undo.
    17619     define variable is_petrol as logical no-undo.
    17620     define variable is_pieces as logical no-undo.
    17621     define variable r-inv-lin as recid   no-undo.
    17622     define variable r-doc-lin as recid   no-undo.
    17623     define variable d_doc-qty as decimal no-undo.
    17624     define buffer buf_doc-line for ub.doc-line.
    17625     define buffer buf_gds-dtl  for ub.gds-dtl.
    17626     do on error undo, return return-value :
    17627       if v-is-ptrl <> "yes" then do: undo, return. end.
    17628   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
    17629     (
    17630        input p-artic
    17631     ,  input p-prod-type
    17632     ,  input p-prod-code
    17633     , output is_petrol
    17634     , output is_pieces
    17635     ) no-error.
    17636       if error-status :error or is_petrol <> yes or is_pieces <> no then do: undo, return. end.
    17637       find first buf_doc-line no-lock where
    17638                  buf_doc-line.doc-code  = p-doc-code  and
    17639                  buf_doc-line.artic     = p-artic     and
    17640                  buf_doc-line.prod-type = p-prod-type and
    17641                  buf_doc-line.prod-code = p-prod-code no-error.
    17642       if not available buf_doc-line then do: undo, return error "не найдена строка накладной". end.
    17643       assign r-doc-lin = recid( buf_doc-line ).
    17644       for each buf_gds-dtl no-lock where
    17645                buf_gds-dtl.doc-code  = p-doc-code  and
    17646                buf_gds-dtl.artic     = p-artic     and
    17647                buf_gds-dtl.prod-type = p-prod-type and
    17648                buf_gds-dtl.prod-code = p-prod-code :
    17649         assign d_doc-qty = d_doc-qty + ( if buf_gds-dtl.doc-qnty = ? then 0 else buf_gds-dtl.doc-qnty ).
    17650       end.
    17651       if d_doc-qty * buf_doc-line.doc-density <> buf_doc-line.cli-qnty then do:
    17652         find buf_doc-line exclusive-lock where recid( buf_doc-line ) = r-doc-lin.
    17653         assign buf_doc-line.cli-qnty = d_doc-qty * buf_doc-line.doc-density.
    17654         find buf_doc-line        no-lock where recid( buf_doc-line ) = r-doc-lin.
    17655       end.
    17656   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_corinvln in g#lib-trn3
    17657   ( input  p-doc-code
    17658    ,input  p-artic
    17659    ,input  p-prod-type
    17660    ,input  p-prod-code
    17661    ,input  0
    17662    ,input  0
    17663    ,input  0
    17664    ,input  0
    17665    ,input  ( if p-is-fact = yes then p-doc-qnty * buf_doc-line.doc-density else p-fact-qnty * buf_doc-line.fact-density )
    17666    ,input  ( if p-is-fact = yes then buf_doc-line.doc-density else buf_doc-line.fact-density )
    17667    ,output r-inv-lin
    17668    ) no-error.
    17669       if error-status :error then do: undo, return. end.
    17670       assign is_OK = br-dtl :refresh( ) in frame d-out-doc.
    17671     end.
    17672   END PROCEDURE.
    17673   PROCEDURE local-add :
    17674   define buffer buf_assortment-matrix for ub.assortment-matrix  .
    17675   define buffer bf_contract-specif for ub.contract-specif.
    17676   define buffer bf-hv_doc-line     for ub.doc-line.
    17677   define buffer bf_goods           for ub.goods.
    17678   define buffer bf_parts           for ub.parts .
    17679   define buffer bf_doc-line        for ub.doc-line.
    17680   define buffer bf_gds-dtl         for ub.gds-dtl .
    17681   define buffer bf_marking-lines   for ub.marking-lines .
    17682   define buffer bf_gds-obj            for ub.gds-obj .
    17683   define variable varlog   as logical   no-undo.
    17684   define variable varnotes as character no-undo.
    17685   define buffer bbb_goods for ub.goods  .
    17686   define variable  var_is-petrol as logical   no-undo .
    17687   define variable  var_is-pieces as logical   no-undo .
    17688   define variable varvalue        as character no-undo .
    17689   define variable vartype         as character no-undo .
    17690   define variable vIsExemplarGoods as logical no-undo .
    17691   define variable v-type-mode-spr as character no-undo .
    17692   define variable varschartic like doc-line.artic initial " " no-undo.
    17693   define variable v-choice    as   integer                    no-undo.
    17694   define variable v-rid       as   integer                    no-undo.
    17695   define variable v-rid-list  as   char                       no-undo.
    17696   define variable i           as   integer                    no-undo.
    17697   define variable v-mark-weight as decimal no-undo .
    17698   define variable v-isweighed as logical no-undo .
    17699   do on error undo, return error return-value :
    17700   run check-rate no-error.
    17701   if error-status :error then do:
    17702     message "Ошибка при проверке курса валют." skip
    17703             return-value
    17704     view-as alert-box error.
    17705     return error return-value.
    17706   end.
    17707   .
    17708   if t-doc.reason-code <> ?
    17709   and t-doc.reason-code > 0
    17710   then do :
    17711     if (lookup( string(t-doc.reason-code), v-reasons-for-return) > 0
    17712       or v-is-return)
    17713     and t-doc.ext-doc-type = 'ee':U
    17714     then do :
    17715       v-choice = 5.
    17716     end.
    17717     else do :
    17718       v-choice = 0.
    17719     end.
    17720   end.
    17721   else do :
    17722     v-choice = 0.
    17723     if v-reasonm and
    17724     lookup( t-doc.ext-doc-type, v-reasonme) = 0 and
    17725     lookup( t-doc.ext-doc-type, 'es,em,wm,im,ot,rs,mp,pc':U) = 0
    17726     then do:
    17727       message "Сначала укажите Основание" view-as alert-box .
    17728       apply "choose" to r-reas in frame d-out-doc.
    17729       return .
    17730     end.
    17731   end.
    17732   if t-doc.contract-code <> 0 and v-choice <> 5 then do:
    17733   define variable vss-include-info115 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    17734   ASSIGN
    17735      i-gl-Host-Code      = 0
    17736      i-gl-Contract-Code  = 0
    17737      i-gl-Extent3        = 0
    17738      .
    17739   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
    17740       INPUT  t-doc.host-code,
    17741       INPUT  t-doc.contract-code,
    17742       OUTPUT i-gl-Extent3
    17743      ).
    17744   IF i-gl-Extent3[1] = 2 THEN DO:
    17745      ASSIGN
    17746         i-gl-Host-Code      = i-gl-Extent3[2]
    17747         i-gl-Contract-Code  = i-gl-Extent3[3]
    17748         .
    17749   END. ELSE DO:
    17750      ASSIGN
    17751         i-gl-Host-Code      = t-doc.host-code
    17752         i-gl-Contract-Code  = t-doc.contract-code
    17753         .
    17754   END.
    17755       FIND FIRST bf_contract-specif
    17756              NO-LOCK
    17757              WHERE
    17758                  bf_contract-specif.Host-code    = i-gl-Host-Code
    17759              AND bf_contract-specif.Contract-num = i-gl-Contract-Code
    17760              NO-ERROR
    17761              .
    17762       if available bf_contract-specif and not t-doc.is-flora then do:
    17763         run gbl/d-askw.w
    17764           (input "Добавление товаров"
    17765           ,input "Выберите один из пунктов для добавления в накладную" + chr(10)
    17766                + "товаров по спецификации к договору" + chr(10)
    17767           ,input "|"
    17768           ,input "Все|Выборочно|По справочнику|Отказ"
    17769           ,input "Все недобавленные товары по спецификации|"
    17770                + "Выборочно товары по спецификации|"
    17771                + "Выбор товаров из справочника|"
    17772                + "Отказ от выполнения операции"
    17773           ,input 1
    17774           ,input 4
    17775           ,output v-choice
    17776           ).
    17777         if v-choice = 4 then do:
    17778           run UI-on in this-procedure ( input "line" ).
    17779           return.
    17780         end.
    17781       end.
    17782   end.
    17783     if v-choice = 0 then
    17784       v-choice = 3.
    17785      assign
    17786       varnotes = '':u
    17787       varlns-cnt = 1.
    17788     case v-choice:
    17789       when 1 then do:
    17790   define variable vss-include-info116 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    17791   ASSIGN
    17792      i-gl-Host-Code      = 0
    17793      i-gl-Contract-Code  = 0
    17794      i-gl-Extent3        = 0
    17795      .
    17796   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
    17797       INPUT  t-doc.host-code,
    17798       INPUT  t-doc.contract-code,
    17799       OUTPUT i-gl-Extent3
    17800      ).
    17801   IF i-gl-Extent3[1] = 2 THEN DO:
    17802      ASSIGN
    17803         i-gl-Host-Code      = i-gl-Extent3[2]
    17804         i-gl-Contract-Code  = i-gl-Extent3[3]
    17805         .
    17806   END. ELSE DO:
    17807      ASSIGN
    17808         i-gl-Host-Code      = t-doc.host-code
    17809         i-gl-Contract-Code  = t-doc.contract-code
    17810         .
    17811   END.
    17812   FOR EACH
    17813       bf_contract-specif
    17814        NO-LOCK
    17815        WHERE
    17816            bf_contract-specif.Host-code    = i-gl-Host-Code
    17817        AND bf_contract-specif.Contract-num = i-gl-Contract-Code
    17818          on error undo, return error return-value :
    17819       find first bf_goods where bf_goods.gds-code = bf_contract-specif.gds-code no-lock.
    17820       find first bf-hv_doc-line where bf-hv_doc-line.doc-code  = t-doc.doc-code     and
    17821                                       bf-hv_doc-line.artic     = bf_goods.artic     and
    17822                                       bf-hv_doc-line.prod-type = bf_goods.prod-type and
    17823                                       bf-hv_doc-line.prod-code = bf_goods.prod-code no-lock no-error.
    17824       if not available bf-hv_doc-line then do:
    17825         assign
    17826           varnotes = varnotes + (if varnotes = '':u then '':u else ',':u) + string(recid(bf_goods)).
    17827       end.
    17828     end.
    17829     if varnotes = '':u then do:
    17830       message "Вы добавили уже все товары по спецификации."
    17831       view-as alert-box.
    17832       return error.
    17833     end.
    17834   end.
    17835       when 2 then do:
    17836         run str/contspec.w (input parparentproc,
    17837                         input "b-sel,b-mark",
    17838                         input 'ПРОСМОТР':U,
    17839                     input t-doc.host-code,
    17840                         input t-doc.contract-code,
    17841                         output v-rid-list) .
    17842         if v-rid-list = '':u then do:
    17843           message "Нет выбранных товаров по спецификации."
    17844             view-as alert-box.
    17845         end.
    17846         do i = 1 to num-entries(v-rid-list):
    17847           v-rid = integer(entry(i, v-rid-list)).
    17848           find bf_contract-specif where recid(bf_contract-specif) = v-rid no-lock no-error.
    17849           if available bf_contract-specif then do:
    17850             find first bf_goods where bf_goods.gds-code = bf_contract-specif.gds-code no-lock.
    17851             assign
    17852               varnotes = varnotes + (if varnotes = '':u then '':u else ',':u) + string(recid(bf_goods)).
    17853           end.
    17854         end.
    17855       end.
    17856       when 3 then do:
    17857       find first buf_assortment-matrix no-lock where
    17858                  buf_assortment-matrix.obj-code = v-cntxt-obj-code and
    17859                  buf_assortment-matrix.obj-type = v-cntxt-obj-type and
    17860                  buf_assortment-matrix.asmt-status = integer ('0':U) no-error .
    17861                   if available buf_assortment-matrix then do:
    17862                       v-type-mode-spr = 'объект':U .
    17863                   end.
    17864                   else do:
    17865                       v-type-mode-spr = 'все':U .
    17866                   end.
    17867         run str/chs-gds.w ( input parparentproc
    17868                       , input v-cntxt-obj-type
    17869                       , input v-cntxt-obj-code
    17870                       , input parlist-mode
    17871                       , input t-doc.status_
    17872                       , input "Строка ПН № " + t-doc.doc-code + " " + t-doc.status_ + " " + string (t-doc.flag_, "+/-")
    17873                       , input v-type-mode-spr
    17874                       , input t-doc.cli-type
    17875                       , input t-doc.cli-code
    17876                       , input t-doc.host-code
    17877                       , input t-doc.ext-doc-type
    17878                       , input-output varschartic
    17879                       , output varnotes) no-error.
    17880       end.
    17881       when 5 then do:
    17882         if v-is-return
    17883             then do :
    17884               run gbl/d-askw.w
    17885                 (input "Добавление товаров"
    17886                 ,input "Выберите один из пунктов для добавления в накладную" + chr(10)
    17887                 ,input "|"
    17888                 ,input "По документам|По справочнику|Отказ"
    17889                 ,input "Добавление товаров из конкретной ПН|"
    17890                 + "Добавление товаров из справочника|"
    17891                 + "Отказ от выполнения операции"
    17892                 ,input 1
    17893                 ,input 3
    17894                 ,output v-choice
    17895                 ).
    17896               if v-choice = 3 then
    17897               do:
    17898                 run UI-on in this-procedure ( input "line" ).
    17899                 return.
    17900               end.
    17901               if v-choice = 1
    17902               then do :
    17903                 define variable ret-doc-code as character no-undo .
    17904                 run local-outs-ret-doc (output ret-doc-code) no-error .
    17905                 if error-status :error then undo, return .
    17906                 if ret-doc-code > ""
    17907                 and can-find(ub.trn-doc no-lock where ub.trn-doc.doc-code = ret-doc-code)
    17908                 then do :
    17909                   run ref/nakl-gds-ch.w (input ret-doc-code, input edo-return, output varnotes) .
    17910                 end .
    17911               end .
    17912               if v-choice = 2
    17913               then do :
    17914                 find first buf_assortment-matrix no-lock where
    17915                   buf_assortment-matrix.obj-code = v-cntxt-obj-code and
    17916                   buf_assortment-matrix.obj-type = v-cntxt-obj-type and
    17917                   buf_assortment-matrix.asmt-status = integer ('0':U) no-error .
    17918                 if available buf_assortment-matrix then
    17919                 do:
    17920                   v-type-mode-spr = 'объект':U .
    17921                 end.
    17922                 else
    17923                 do:
    17924                   v-type-mode-spr = 'все':U .
    17925                 end.
    17926                 run str/chs-gds.w ( input parparentproc
    17927                   , input v-cntxt-obj-type
    17928                   , input v-cntxt-obj-code
    17929                   , input parlist-mode
    17930                   , input t-doc.status_
    17931                   , input "Строка ПН № " + t-doc.doc-code + " " + t-doc.status_ + " " + string (t-doc.flag_, "+/-")
    17932                   , input v-type-mode-spr
    17933                   , input t-doc.cli-type
    17934                   , input t-doc.cli-code
    17935                   , input t-doc.host-code
    17936                   , input t-doc.ext-doc-type
    17937                   , input-output varschartic
    17938                   , output varnotes) no-error.
    17939               end .
    17940             end .
    17941             else do :
    17942               if t-doc.out-code = ?
    17943               or t-doc.out-code = ""
    17944               or not can-find(ub.trn-doc no-lock where ub.trn-doc.doc-code = t-doc.out-code)
    17945               then do :
    17946                 message "Сначала выберите корректный источник (ПН)" view-as alert-box .
    17947                 return.
    17948               end.
    17949               run ref/nakl-gds-ch.w (input t-doc.out-code, input ?, output varnotes) .
    17950             end .
    17951       end.
    17952     end case.
    17953   if varnotes = '' then return.
    17954   assign
    17955     varline-mode = 'ДОБАВЛЕНИЕ':U
    17956     prt-rec = ?
    17957     varlns-cnt = 1.
    17958    if available ub.gds-dtl then do:
    17959      assign prt-rec = recid(ub.gds-dtl).
    17960    end.
    17961    else do:
    17962      assign prt-rec = ?.
    17963    end.
    17964   add-goods_ :
    17965   do while varlns-cnt <= num-entries (varnotes):
    17966     assign
    17967       gds-rec = integer (entry (varlns-cnt, varnotes))
    17968       varlns-cnt = varlns-cnt + 1.
    17969     v-param = if v-exist then string(v-buket-gds-code)
    17970                 else ? .
    17971     if t-doc.doc-type = 'рас':U and
    17972        t-doc.status_ = 'запрос':U then do:
    17973        find first bbb_goods no-lock where
    17974                   recid(bbb_goods) = gds-rec .
    17975   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
    17976     (
    17977        input bbb_goods.artic
    17978     ,  input bbb_goods.prod-type
    17979     ,  input bbb_goods.prod-code
    17980     , output var_is-petrol
    17981     , output var_is-pieces
    17982     ) .
    17983        if var_is-petrol = true then return error "Топливо нельзя продавать через ЗАПРОС ! " .
    17984     end.
    17985     find first bf_goods where recid(bf_goods) = gds-rec no-lock.
    17986     RUN gds-attr-value (
    17987             INPUT bf_goods.gds-code,
    17988             INPUT 'mark-type':U,
    17989             OUTPUT varvalue,
    17990             OUTPUT vartype
    17991             ).
    17992     if t-doc.ext-doc-type = 'ep':U
    17993     then do :
    17994       if EDOParSec:GetIsEDOForType(varvalue)
    17995       or EDOParSec:GetIsArticForType(varvalue)
    17996       or EDOParSec:GetIsMarkingForType(varvalue)
    17997       then do :
    17998         message "Товар " bf_goods.artic " " bf_goods.prod-type " " bf_goods.prod-code " " bf_goods.gds-name " подлежит обязательной маркировке. Для возврата используйте документ Расход внешний"
    17999         view-as alert-box .
    18000         assign
    18001           varlns-cnt = varlns-cnt + 1.
    18002         next.
    18003       end .
    18004     end .
    18005     if varvalue > ""
    18006     and EDOParSec:GetIsMarkingForType(varvalue)
    18007     and not v-is-return
    18008     then do :
    18009       message "Товар:" bf_goods.artic " " bf_goods.prod-type " " bf_goods.prod-code " " bf_goods.gds-name " " skip
    18010               "нельзя добавлять в ручном режиме, так как он подлежит маркировке и должен добавляться помарочно."
    18011       view-as alert-box error.
    18012       assign
    18013         varlns-cnt = varlns-cnt + 1.
    18014       next.
    18015     end .
    18016     if v-is-return
    18017     then do :
    18018       find first bf_gds-obj no-lock where bf_gds-obj.obj-type  = t-doc.obj-type
    18019                                       and bf_gds-obj.obj-code  = t-doc.obj-code
    18020                                       and bf_gds-obj.artic     = bf_goods.artic
    18021                                       and bf_gds-obj.prod-type = bf_goods.prod-type
    18022                                       and bf_gds-obj.prod-code = bf_goods.prod-code
    18023                                       no-error .
    18024       if not available bf_gds-obj
    18025       then do:
    18026         message "Критическая ошибка!" skip
    18027                 "Не найдена запись товара на объекте (gds-obj) " bf_goods.artic " " bf_goods.gds-name
    18028         view-as alert-box error .
    18029         assign
    18030           varlns-cnt = varlns-cnt + 1.
    18031         next.
    18032       end.
    18033       if bf_gds-obj.free-qnty <= 0
    18034       then do :
    18035         message "Невозможно выполнить возврат товара " bf_goods.artic " " bf_goods.gds-name ", т.к. текущие свободные остатки равны 0."
    18036         view-as alert-box .
    18037         assign
    18038           varlns-cnt = varlns-cnt + 1.
    18039         next.
    18040       end .
    18041       if can-find(first bf_doc-line no-lock where bf_doc-line.doc-code = t-doc.doc-code
    18042                                               and bf_doc-line.artic = bf_goods.artic
    18043                                               and bf_doc-line.prod-code = bf_goods.prod-code
    18044                                               and bf_doc-line.prod-type = bf_goods.prod-type)
    18045       then do :
    18046         message "Товар " bf_goods.artic " " bf_goods.gds-name
    18047                 " уже добавлен. Запрещено выбирать более одной партии в рамках одной накладной."
    18048         view-as alert-box .
    18049         assign
    18050           varlns-cnt = varlns-cnt + 1.
    18051         next.
    18052       end .
    18053       if v-choice = 1
    18054       then do :
    18055         run str/parts-l.w
    18056         (  input parparentproc
    18057          ,  input t-doc.obj-type
    18058          ,  input t-doc.obj-code
    18059          ,  input bf_goods.gds-code
    18060          ,  input ret-doc-code
    18061          ,  input 'ПРОСМОТР':U
    18062          ,  input 'документ':U
    18063          ,  input 'текущий':U
    18064          ,  input 'документ':U + chr(4) + "return"
    18065          , output varpart-rec
    18066         ) .
    18067       end .
    18068       if v-choice = 2
    18069       then do :
    18070         run str/parts-l-ret.w
    18071         (input ParParentProc
    18072         ,input t-doc.obj-type
    18073         ,input t-doc.obj-code
    18074         ,input bf_goods.gds-code
    18075         ,input t-doc.doc-code
    18076         ,input 'ПРОСМОТР':U
    18077         ,input 'документ':U
    18078         ,input 'текущий':U
    18079         ,input 'документ':U
    18080         ,output varpart-rec
    18081         ) no-error .
    18082       end .
    18083       find first bf_parts no-lock where recid(bf_parts) = varpart-rec no-error .
    18084       if not available bf_parts
    18085       then do :
    18086         assign
    18087           varlns-cnt = varlns-cnt + 1.
    18088         next.
    18089       end .
    18090       if t-doc.reason-code = 25
    18091       then do :
    18092         if t-doc.out-code = ?
    18093         or t-doc.out-code = ""
    18094         then do :
    18095           t-doc.out-code = bf_parts.in-code .
    18096           display t-doc.out-code with frame d-out-doc.
    18097         end .
    18098         else do :
    18099           if t-doc.out-code <> bf_parts.in-code
    18100           then do :
    18101             message 'Для схемы возврата "Корректировка поступления" нельзя выбрать партии из разных ПН' view-as alert-box .
    18102             assign
    18103               varlns-cnt = varlns-cnt + 1.
    18104             next.
    18105           end .
    18106         end .
    18107       end .
    18108       if EDOParSec:GetIsEDOForType(varvalue)
    18109       or EDOParSec:GetIsArticForType(varvalue)
    18110       or EDOParSec:GetIsMarkingForType(varvalue)
    18111       then do :
    18112         find first bf_marking-lines no-lock where bf_marking-lines.gds-code  = bf_goods.gds-code
    18113                                               and bf_marking-lines.obj-type  = bf_parts.obj-type
    18114                                               and bf_marking-lines.obj-code  = bf_parts.obj-code
    18115                                               and bf_marking-lines.in-code   = bf_parts.in-code
    18116                                               and bf_marking-lines.out-code  = bf_parts.out-code
    18117                                               and bf_marking-lines.part-code = bf_parts.part-code
    18118                                               no-error .
    18119         if available bf_marking-lines
    18120         or (num-entries(bf_parts.part-code, "_") = 2 and length(entry(1, bf_parts.part-code, "_")) = 14)
    18121         then do :
    18122           message "Товар подлежит обязательной маркировке и прослеживаемости, для возврата поставщику необходимо просканировать КМ" view-as alert-box .
    18123           run scanMark in this-procedure (recid(bf_parts), buffer bf_goods, output vOk) no-error.
    18124           if not vOk then
    18125             next add-goods_ .
    18126         end .
    18127         else do :
    18128           if EDOParSec:GetIsTransitionalForType(varvalue)
    18129           then do :
    18130             message "Возвращаем маркированные упаковки товара?" view-as alert-box question buttons yes-no update varlog .
    18131             if varlog
    18132             then do :
    18133               run scanMark in this-procedure (recid(bf_parts), buffer bf_goods, output vOk) no-error.
    18134               if not vOk then
    18135                 next add-goods_ .
    18136             end .
    18137             else do :
    18138               run str/out-add.p (parparentproc,
    18139                   recid(t-doc),
    18140                   ?,
    18141                   ?,
    18142                   gds-rec,
    18143                   'ДОБАВЛЕНИЕ':U + chr(4) + "return=" + string(recid(bf_parts)),
    18144                   "Transitional") no-error.
    18145               if error-status :error then
    18146               do:
    18147                 next add-goods_ .
    18148               end.
    18149             end .
    18150           end .
    18151           else do :
    18152             message "Товар подлежит обязательной маркировке и прослеживаемости, для возврата поставщику необходимо просканировать КМ" view-as alert-box .
    18153             run scanMark in this-procedure (recid(bf_parts), buffer bf_goods, output vOk) no-error.
    18154             if not vOk then
    18155               next add-goods_ .
    18156           end .
    18157         end .
    18158       end .
    18159       else do :
    18160         run str/out-add.p (parparentproc,
    18161             recid(t-doc),
    18162             ?,
    18163             ?,
    18164             gds-rec,
    18165             'ДОБАВЛЕНИЕ':U + chr(4) + "return=" + string(recid(bf_parts)),
    18166             v-param) no-error.
    18167         if error-status :error then
    18168         do:
    18169           next add-goods_ .
    18170         end.
    18171       end .
    18172     end .
    18173     else
    18174     if v-choice = 5
    18175     then do :
    18176       run str/out-add.p (parparentproc,
    18177                      recid(t-doc),
    18178                      ?,
    18179                      ?,
    18180                      gds-rec,
    18181                      'ДОБАВЛЕНИЕ':U + chr(4) + "return",
    18182                      v-param) no-error.
    18183       if error-status :error then do:
    18184         next.
    18185       end.
    18186     end .
    18187     else do :
    18188       run isExemplarGoods in this-procedure
    18189          (t-doc.obj-type, t-doc.obj-code, bf_goods.gds-code, output vIsExemplarGoods).
    18190       v-isweighed = WghProdVariable(t-doc.obj-type, t-doc.obj-code, bf_goods.gds-code) .
    18191       if vIsExemplarGoods
    18192       or v-isweighed
    18193       then do:
    18194         message "Товар подлежит обязательной маркировке и прослеживаемости, для списания необходимо просканировать КМ" view-as alert-box .
    18195         run scanMark in this-procedure (?, buffer bf_goods, output vOk) no-error.
    18196         if not vOk then
    18197           next add-goods_ .
    18198       end.
    18199       else
    18200       do:
    18201           run str/out-add.p (parparentproc,
    18202                          recid(t-doc),
    18203                          ?,
    18204                          ?,
    18205                          gds-rec,
    18206                          'ДОБАВЛЕНИЕ':U,
    18207                          v-param) no-error.
    18208           if error-status :error then do:
    18209             next.
    18210           end.
    18211       end.
    18212     end.
    18213   end.
    18214   if t-doc.ext-doc-type = 'ev':U
    18215   then do :
    18216     run local-cur in this-procedure (input 4) no-error.
    18217     if error-status :error then return .
    18218   end .
    18219   run ui-on ("line").
    18220   if prt-rec <> ? then do:
    18221     reposition br-dtl to recid prt-rec no-error.
    18222   end.
    18223   end.
    18224   END PROCEDURE.
    18225   PROCEDURE local-check-gds :
    18226     define variable l-inv-on as logical no-undo .
    18227   define variable vss-include-info117 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    18228   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
    18229     (input  ub.doc-line.obj-type
    18230     ,input  ub.doc-line.obj-code
    18231     ,input  ub.doc-line.artic
    18232     ,input  ub.doc-line.prod-type
    18233     ,input  ub.doc-line.prod-code
    18234     ,input  'inv-on=request'
    18235     ,output l-inv-on
    18236     ) no-error .
    18237     if error-status :error then do:
    18238       message
    18239         "Ошибка получения признака товара на объекте" skip
    18240         error-status :get-message(1) skip
    18241         return-value skip
    18242         view-as alert-box error .
    18243       undo, return no-apply .
    18244     end.
    18245     if l-inv-on then do:
    18246       message "Артикул :" ub.doc-line.artic ub.goods.gds-name
    18247                       "- товар в инвентаризации."
    18248                       skip (2) "Операция невозможна.".
    18249       return error.
    18250     end.
    18251     if t-doc.status_ = 'запрос':U then do:
    18252       message "Документ имеет статус ЗАПРОС. Изменение партий невозможно.".
    18253       return error.
    18254     end.
    18255   END PROCEDURE.
    18256   PROCEDURE local-cur :
    18257   define input parameter parwith-tax as integer no-undo.
    18258   define buffer cur-doc-line  for ub.doc-line.
    18259   define buffer cur-goods     for ub.goods.
