    10683   on entry of t-doc.cli-code, r-clients in frame d-out-doc
    10684   DO:
    10685   if t-doc.ret-supp = yes and
    10686     can-find (first ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code no-lock) then do:
    10687       message "Уже есть строки возврата. Изменение контрагента невозможно."
    10688       view-as alert-box error buttons ok.
    10689       apply "entry" to browse br-dtl.
    10690       return no-apply.
    10691   end.
    10692   if t-doc.cli-code <> ? then do:
    10693     pardoc-mode = 'ДОБАВЛЕНИЕ':U.
    10694     run UI-on ("enable").
    10695   end.
    10696   end.
    10697   on leave of t-doc.print-rubl in frame d-out-doc do:
    10698     if input frame d-out-doc t-doc.print-rubl <> t-doc.print-rubl then do:
    10699      run print-rubl.
    10700     end.
    10701   END.
    10702   procedure print-rubl:
    10703   assign frame d-out-doc t-doc.print-rubl.
    10704   define variable varbase-code as integer no-undo.
    10705   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10706   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
    10707     (input  v-cntxt-host-code-obj
    10708     ,output varbase-code
    10709     )  .
    10710   if t-doc.print-rubl then
    10711     assign
    10712       t-doc.exch-code  = 0
    10713       t-doc.exch-rate  = 1
    10714       t-doc.exch-scale = 1.
    10715     else
    10716     assign
    10717       t-doc.exch-code  = varbase-code
    10718       t-doc.exch-rate  = t-doc.base-rate
    10719       t-doc.exch-scale = t-doc.base-scale.
    10720   end procedure.
    10721   on leave of t-doc.base-rate  in frame d-out-doc or
    10722      leave of t-doc.base-scale in frame d-out-doc do:
    10723     if input frame d-out-doc t-doc.base-rate  <> t-doc.base-rate  or
    10724        input frame d-out-doc t-doc.base-scale <> t-doc.base-scale then do:
    10725       run check-rate no-error.
    10726       if error-status :error then do:
    10727          message "Ошибка при проверке курса" skip
    10728                  return-value
    10729          view-as alert-box error.
    10730          return no-apply.
    10731       end.
    10732       run gbl/calc-trn.p (input parparentproc, input recid(t-doc)) no-error.
    10733       if error-status :error then undo, return no-apply.
    10734       run ui-on ("line").
    10735     end.
    10736   end.
    10737   on leave of t-doc.pay-code in frame d-out-doc
    10738   do:
    10739   if input frame d-out-doc t-doc.pay-code <> t-doc.pay-code then do:
    10740     run leave-pay-code no-error.
    10741     if error-status :error then return no-apply.
    10742   end.
    10743   end.
    10744   on leave of t-doc.doc-date in frame d-out-doc do:
    10745   if input frame d-out-doc t-doc.doc-date <> t-doc.doc-date then do:
    10746     assign
    10747       t-doc.doc-date = input frame d-out-doc t-doc.doc-date.
    10748   end.
    10749   end.
    10750   on mouse-select-dblclick, return of t-doc.pay-code in frame d-out-doc
    10751   do:
    10752   if input frame d-out-doc t-doc.pay-code <> t-doc.pay-code then do:
    10753     run return-pay-code no-error.
    10754     if error-status :error then return no-apply.
    10755   end.
    10756   apply "entry" to t-doc.wrkr in frame d-out-doc.
    10757   return no-apply.
    10758   end.
    10759   on choose of r-pay in frame d-out-doc
    10760   do:
    10761     run choose-r-pay no-error.
    10762     if error-status :error then return no-apply.
    10763   end.
    10764   on return, mouse-select-dblclick of br-dtl in frame d-out-doc
    10765   do:
    10766     if b-chg:sensitive then do:
    10767       apply "choose" to b-chg in frame d-out-doc.
    10768     end.
    10769     else do:
    10770       apply "choose" to b-lkp in frame d-out-doc.
    10771     end.
    10772   end.
    10773   on choose of r-acc in frame d-out-doc
    10774   do:
    10775     run choose-r-acc no-error.
    10776     if error-status :error then return no-apply.
    10777   end.
    10778   procedure choose-r-acc:
    10779   define variable v-today      as date    no-undo.
    10780   define variable varbase-code as integer no-undo.
    10781   varlog = yes.
    10782   message "Подставить курс базовой валюты : из справочника на текущую дату ?"
    10783   view-as alert-box question buttons OK-Cancel update varlog.
    10784   if varlog <> true then do:
    10785     run UI-on ("line").
    10786     return error.
    10787   end.
    10788   define variable vss-include-info73 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10789   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
    10790     (input  t-doc.obj-type
    10791     ,input  t-doc.obj-code
    10792     ,output v-today
    10793     )  .
    10794   if v-today <> ? then do:
    10795     find last ub.curr-accnt where ub.curr-accnt.curr-code  = varbase-code and
    10796                                ub.curr-accnt.exch-date <= v-today      use-index pi no-lock no-error.
    10797   end.
    10798   else do:
    10799     find last ub.curr-accnt where ub.curr-accnt.curr-code  = varbase-code   and
    10800                                ub.curr-accnt.exch-date <= t-doc.doc-date use-index pi no-lock no-error.
    10801   end.
    10802   if not available ub.curr-accnt then do:
    10803     message "На эту дату неизвестен курс базовой валюты.".
    10804     apply "entry" to t-doc.base-rate in frame d-out-doc.
    10805     return error.
    10806   end.
    10807   disp ub.curr-accnt.exch-rate  @ t-doc.base-rate
    10808        ub.curr-accnt.exch-scale @ t-doc.base-scale with frame d-out-doc.
    10809   run check-rate.
    10810     apply "entry" to b-add in frame d-out-doc.
    10811     return error.
    10812   end procedure.
    10813   on mouse-select-dblclick, return of t-doc.cli-code, t-doc.cli-type
    10814     in frame d-out-doc
    10815   do:
    10816     run choose-cli in this-procedure no-error.
    10817     if error-status :error then do:
    10818       display ? @ t-doc.cli-type ? @ t-doc.cli-code with frame d-out-doc.
    10819     end.
    10820     return no-apply.
    10821   end.
    10822   on choose of r-clients in frame d-out-doc
    10823   do:
    10824   define variable varfirm-code like ub.firm.firm-code no-undo.
    10825   define variable v-rid-list as character no-undo .
    10826   define variable v-types as character no-undo .
    10827   define buffer bf_clients for ub.clients.
    10828   if t-doc.internal then v-types = 'маг':U.
    10829                     else v-types = 'все':U.
    10830   if (t-doc.ext-doc-type = 'ee':U or t-doc.ext-doc-type = 'ep':U) and
    10831      varhold            = "yes"              and
    10832      paris-hold         = yes                then do:
    10833     assign
    10834       varfirm-code = ?.
    10835     run adm/sconfs.w ( input parparentproc
    10836                      , input "b-sel":U
    10837                      , input no
    10838                      , input ?
    10839                      , output varfirm-code
    10840                      , input-output v-rid-list) no-error.
    10841     if error-status :error or
    10842        varfirm-code = ?   then do:
    10843       return no-apply.
    10844     end.
    10845     find first bf_clients where bf_clients.obj-type = 'орг':U       and
    10846                                 bf_clients.obj-code = varfirm-code no-lock.
    10847     assign ref-list = string(recid (bf_clients)).
    10848     run check-base-code in this-procedure (recid(bf_clients)).
    10849   end.
    10850   else do:
    10851     if transaction = yes then do:
    10852       message "Критическая ошибка." skip
    10853               "Вы находитесь в транзакции." skip
    10854               "Работа со справочником клиентов невозможна."
    10855       view-as alert-box error.
    10856       return no-apply.
    10857     end.
    10858     def var supp-type as character no-undo.
    10859     run ref/cli-all.w (parparentproc
    10860                   , "b-sel,b-add"
    10861                   , v-types
    10862                   , ?
    10863                   , ?
    10864                   , ?
    10865                   , ?
    10866                   , supp-type
    10867                   , output ref-list) .
    10868   end.
    10869   if ref-list <> "" then do:
    10870     ref-rec = integer (ref-list).
    10871     find ub.clients where recid ( ub.clients ) = ref-rec no-lock.
    10872     disp ub.clients.obj-code @ t-doc.cli-code
    10873             ub.clients.obj-name with frame d-out-doc.
    10874   if pardoc-mode = 'ДОБАВЛЕНИЕ':U then
    10875     disp ub.clients.obj-type @ t-doc.cli-type with frame d-out-doc.
    10876   end.
    10877   if trn-type = 1
    10878   then do :
    10879     define variable v-tmp-char like ub.thbj-attr.property-value-character no-undo .
    10880     define variable v-tmp-date      like ub.thbj-attr.property-value-date    no-undo .
    10881     define variable v-tmp-decimal   like ub.thbj-attr.property-value-decimal no-undo .
    10882     define variable v-tmp-integer   like ub.thbj-attr.property-value-integer no-undo .
    10883     define variable v-rvd-own-nb as logical no-undo .
    10884     define variable v-rvd-own-nb-type as   character no-undo .
    10885     find ub.clients where ub.clients.obj-code = input frame d-out-doc t-doc.cli-code
    10886                  and ub.clients.obj-type = input frame d-out-doc t-doc.cli-type no-error.
    10887     if not available ub.clients then do:
    10888       if input frame d-out-doc t-doc.cli-code <> ? and input t-doc.cli-type <> ? then
    10889         message "Неправильный код или тип контрагента.".
    10890       apply "entry" to t-doc.cli-code in frame d-out-doc.
    10891       return no-apply .
    10892     end.
    10893     run adm/shattri.p (
    10894         input "get":U
    10895         ,input t-doc.obj-type
    10896         ,input t-doc.obj-code
    10897         ,input 'petrol':U
    10898         ,input  "rvd-own-nb"
    10899         ,output v-tmp-char
    10900         ,output v-tmp-date
    10901         ,output v-tmp-decimal
    10902         ,output v-tmp-integer
    10903         ,output v-rvd-own-nb
    10904         ,output v-rvd-own-nb-type
    10905         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
    10906         ) no-error .
    10907     if error-status :error then v-rvd-own-nb = false .
    10908     if v-rvd-own-nb = false
    10909     then do :
    10910       find first ub.clients-attr no-lock where ub.clients-attr.obj-type = ub.clients.obj-type
    10911                                            and ub.clients-attr.obj-code = ub.clients.obj-code
    10912                                            and ub.clients-attr.attr-code = 'owner-code':U
    10913                                            no-error .
    10914       if available ub.clients-attr
    10915       and ub.clients-attr.attr-value > ""
    10916       then do :
    10917         if ub.clients-attr.attr-value = "орг" + string(t-doc.host-code)
    10918         then do :
    10919           message "Для данного поставщика документ может быть заполнен только в автоматическом режиме путем сканирования 2D кода. Просканируйте код с ТТН, при возникновении проблемы обратитесь в тех. поддержку".
    10920           run str/trnscanqr.w (parparentproc, t-doc.doc-code, "", this-procedure).
    10921           return no-apply .
    10922         end .
    10923       end .
    10924     end .
    10925   end .
    10926   run check-cli no-error.
    10927   if error-status :error then return no-apply.
    10928   run fill-mol in this-procedure.
    10929   if error-status :error then return no-apply.
    10930   end.
    10931   procedure check-cli :
    10932   define variable v-today as date      no-undo.
    10933   define variable v-time  as integer   no-undo.
    10934   define buffer buf_sysconf      for ub.sysconf.
    10935   define buffer buf_firm         for ub.firm.
    10936   define buffer in-cli           for ub.trn-doc.
    10937   define buffer buf-hold_clients for ub.clients.
    10938   define buffer buf-hold_shop    for ub.shop.
    10939   define buffer buf-hold_store   for ub.store.
    10940   define buffer bf_clients       for ub.clients.
    10941   define buffer bf_contract      for ub.contract.
    10942   define buffer buf_contract-attr for ub.contract-attr.
    10943   define buffer bf_currency      for ub.currency.
    10944   define buffer buf_trn-reason   for ub.trn-reason.
    10945   define variable varexch-rate     like ub.trn-doc.exch-rate            no-undo.
    10946   define variable varexch-scale    like ub.trn-doc.exch-scale           no-undo.
    10947   define variable varcurr-abbr     as   character                       no-undo.
    10948   define variable parhold-obj-type like ub.firm.main-obj-type           no-undo.
    10949   define variable parhold-obj-code like ub.firm.main-obj-code initial ? no-undo.
    10950   define variable varcontract-code like ub.contract.contract-code       no-undo.
    10951   define variable varr-b           as   character                       no-undo.
    10952   define variable varis-fin        as   character                       no-undo.
    10953   define variable varis-finby      as   character                       no-undo.
    10954   define variable vartype          as   character                       no-undo.
    10955   define variable varcontract      as   character                       no-undo.
    10956   define variable varcontract-cli  as   character                       no-undo.
    10957   define variable varcontract-type  as character no-undo .
    10958   define variable v-value-character like ub.thbj-attr.property-value-character no-undo .
    10959   define variable v-value-date      like ub.thbj-attr.property-value-date    no-undo .
    10960   define variable v-value-decimal   like ub.thbj-attr.property-value-decimal no-undo .
    10961   define variable v-value-logical   like ub.thbj-attr.property-value-logical no-undo .
    10962   define variable v-value-integer   like ub.thbj-attr.property-value-integer no-undo .
    10963   define variable v-tth as handle no-undo .
    10964   define variable v-tth1 as handle no-undo .
    10965   define variable varintprmvq      as logical   no-undo .
    10966   define variable varintprmvq-type as   character                       no-undo.
    10967   define variable v-num            as   integer       initial 1         no-undo.
    10968   define variable varis-perm       as   logical       initial no        no-undo.
    10969   define buffer bf-f_contract-specif    for ub.contract-specif.
    10970   define variable v-master as character no-undo.
    10971   define variable trn-is-return          as logical   no-undo init no .
    10972   define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
    10973   define buffer bf_shop for ub.shop.
    10974   do on error undo, return error return-value :
    10975   define variable vss-include-info74 as character format "x(65)" no-undo initial "@(#)$Workfile$".
    10976   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
    10977     (output varr-b
    10978     )  .
    10979   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
    10980     (input  'is-fin'
    10981     ,input  0
    10982     ,input  ''
    10983     ,input  0
    10984     ,input  ''
    10985     ,input  ''
    10986     ,input  ''
    10987     ,input  no
    10988     ,output varis-fin
    10989     ,output vartype
    10990     ) no-error .
    10991   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
    10992     (input  'is-finby'
    10993     ,input  0
    10994     ,input  ''
    10995     ,input  0
    10996     ,input  ''
    10997     ,input  ''
    10998     ,input  ''
    10999     ,input  no
    11000     ,output varis-finby
    11001     ,output vartype
    11002     ) no-error .
    11003     run adm/shattri.p (
    11004         input "get":U
    11005         ,input t-doc.obj-type
    11006         ,input t-doc.obj-code
    11007         ,input 'nakl_par':U
    11008         ,input  "intprmvq"
    11009         ,output v-value-character
    11010         ,output v-value-date
    11011         ,output v-value-decimal
    11012         ,output v-value-integer
    11013         ,output varintprmvq
    11014         ,output varintprmvq-type
    11015         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
    11016         ) no-error .
    11017         if error-status :error then varintprmvq = false .
    11018   if input frame d-out-doc t-doc.cli-type = ? or input frame d-out-doc t-doc.cli-type = "" then do:
    11019     if t-doc.internal then do:
    11020       if can-find (ub.clients where ub.clients.obj-code = input frame d-out-doc t-doc.cli-code
    11021                                        and ub.clients.obj-type = 'скл':U no-lock) then do:
    11022         disp 'скл':U @ t-doc.cli-type with frame d-out-doc.
    11023       end.
    11024       else do:
    11025         disp 'маг':U @ t-doc.cli-type with frame d-out-doc.
    11026       end.
    11027     end.
    11028     else do:
    11029       if can-find (ub.clients where ub.clients.obj-code = input frame d-out-doc t-doc.cli-code
    11030                                        and ub.clients.obj-type = 'орг':U no-lock) then do:
    11031         disp 'орг':U @ t-doc.cli-type with frame d-out-doc.
    11032       end.
    11033       else do:
    11034         disp 'чел':U @ t-doc.cli-type with frame d-out-doc.
    11035       end.
    11036     end.
    11037   end.
    11038   define variable conf-par as character no-undo.
    11039   define variable mode-erprn as logical no-undo.
    11040   define variable par-type as character no-undo.
    11041   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
    11042     (input  'is-erpRN'
    11043     ,input  0
    11044     ,input  ''
    11045     ,input  0
    11046     ,input  ''
    11047     ,input  ''
    11048     ,input  ''
    11049     ,input  NO
    11050     ,output conf-par
    11051     ,output par-type
    11052     ) no-error .
    11053   if not error-status:error and conf-par = "yes":U then mode-erprn = yes.
    11054     else mode-erprn = no.
    11055   find ub.clients where ub.clients.obj-code = input frame d-out-doc t-doc.cli-code
    11056                  and ub.clients.obj-type = input frame d-out-doc t-doc.cli-type no-error.
    11057   if not available ub.clients then do:
    11058     if input frame d-out-doc t-doc.cli-code <> ? and input t-doc.cli-type <> ? then
    11059       message "Неправильный код или тип контрагента.".
    11060     apply "entry" to t-doc.cli-code in frame d-out-doc.
    11061     return error.
    11062   end.
    11063   disp ub.clients.obj-type @ t-doc.cli-type with frame d-out-doc.
    11064   if (ub.clients.obj-type = v-cntxt-obj-type and ub.clients.obj-code = v-cntxt-obj-code) or
    11065      (ub.clients.obj-type = 'орг':U and ub.clients.obj-code = v-cntxt-host-code-obj) then do:
    11066     release ub.clients no-error.
    11067     message "Запрещенный код и тип контрагента.".
    11068     apply "entry" to t-doc.cli-code in frame d-out-doc.
    11069     return error.
    11070   end.
    11071   if ub.clients.stts <> 0 then do:
    11072    message "Данный клиент имеет статус 'неактивный'.".
    11073    apply "entry" to t-doc.cli-code in frame d-out-doc.
    11074    return error.
    11075   end.
    11076   define variable v-err as logical   no-undo .
    11077     run ver-clients  ( ub.clients.obj-type , ub.clients.obj-code , output v-err ) .
    11078     if  v-err then do:
    11079     apply "entry" to t-doc.cli-code in frame d-out-doc.
    11080     return error.
    11081     end.
    11082   if lookup(ub.clients.obj-type, 'скл':U + ',' + 'маг':U) > 0
    11083   then do:
    11084     if t-doc.internal then do:
    11085       if ub.clients.obj-type = 'скл':U then do:
    11086         find ub.store where ub.store.obj-code = ub.clients.obj-code no-lock.
    11087         if ub.store.host-code <> v-cntxt-host-code-obj then do:
    11088           release ub.clients no-error.
    11089           message "Выбран склад другой фирмы. Используйте внешний документ.".
    11090           apply "entry" to t-doc.cli-code in frame d-out-doc.
    11091           return error.
    11092         end.
    11093       end.
    11094       else do:
    11095         find ub.shop where ub.shop.obj-code = ub.clients.obj-code no-lock.
    11096         if ub.shop.host-code <> v-cntxt-host-code-obj then do:
    11097           release ub.clients no-error.
    11098           message "Выбран магазин другой фирмы. Используйте внешний документ.".
    11099           apply "entry" to t-doc.cli-code in frame d-out-doc.
    11100           return error.
    11101         end.
    11102       end.
    11103     end.
    11104     else do:
    11105       release ub.clients no-error.
    11106       message "Это не внутреннее перемещение. Выберите организацию или человека.".
    11107       apply "entry" to t-doc.cli-code in frame d-out-doc.
    11108       return error.
    11109     end.
    11110   end.
    11111   else do:
    11112     if t-doc.internal then do:
