    18311       )  .
    18312   end.
    18313          end.
    18314          when 'спи':U
    18315          then do:
    18316   define variable vss-include-info120 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    18317   do:
    18318     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    18319       (input  v-cntxt-db-num
    18320       ,input  v-cntxt-userid
    18321       ,input  0
    18322       ,input  'actn_write-off_price':U
    18323       ,input  'object':U
    18324       ,input  t-doc.host-code
    18325       ,input  t-doc.obj-type
    18326       ,input  t-doc.obj-code
    18327       ,input  0
    18328       ,input  0
    18329       ,input  0
    18330       ,input  true
    18331       ,output varlog
    18332       )  .
    18333   end.
    18334          end.
    18335          otherwise do:
    18336            message
    18337              vss-workfile vss-revision vss-description skip
    18338              "Неизвестный тип документа" t-doc.doc-type skip
    18339              "Документ" t-doc.doc-code skip
    18340              view-as alert-box error .
    18341            undo, return error return-value .
    18342          end.
    18343        end case .
    18344      end .
    18345      if varlog = no then return error.
    18346      for each cur-doc-line no-lock where
    18347               cur-doc-line.doc-code = t-doc.doc-code
    18348      :
    18349   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
    18350     (
    18351        input cur-doc-line.artic
    18352     ,  input cur-doc-line.prod-type
    18353     ,  input cur-doc-line.prod-code
    18354     , output is-petrolium
    18355     , output is-pieces
    18356     ) no-error.
    18357           if error-status :error then do:
    18358             message "Ошибка при вызове процедуры lib-trn_is-petrl из файла out-doc.w."
    18359             view-as alert-box.
    18360             return error.
    18361           end.
    18362           if is-petrolium = yes then do: assign varlog = no. end.
    18363      end.
    18364      if varlog = no then do:
    18365         message "В накладной есть топливо. Запрещено устанавливать учетные цены."
    18366         view-as alert-box.
    18367         return error.
    18368      end.
    18369      assign varpc       = 0.00
    18370             varflag-ret = no.
    18371      if parwith-tax <> 3
    18372      and parwith-tax <> 4
    18373      then do:
    18374        run str/pc-ov.w (input  parwith-tax,
    18375                     output varpc,
    18376                     output varflag-ret,
    18377                     output round-base,
    18378                     output round-method) no-error.
    18379        if error-status :error or
    18380           varflag-ret <> yes then return error.
    18381      end.
    18382      if parwith-tax = 4
    18383      then do :
    18384        assign
    18385          varpc = 0
    18386          varflag-ret = yes
    18387          round-base = 0
    18388          round-method = "Отключено"
    18389        .
    18390        parwith-tax = 2 .
    18391      end .
    18392      run waitfram-show in this-procedure (input "Простановка учетных цен").
    18393      tr:
    18394      do transaction:
    18395      for each  cur-doc-line where cur-doc-line.doc-code   = t-doc.doc-code         ,
    18396          first cur-goods    where cur-goods.artic         = cur-doc-line.artic     and
    18397                                   cur-goods.prod-type     = cur-doc-line.prod-type and
    18398                                   cur-goods.prod-code     = cur-doc-line.prod-code no-lock,
    18399          each  cur-gds-dtl  where cur-gds-dtl.doc-code    = cur-doc-line.doc-code  and
    18400                                   cur-gds-dtl.artic       = cur-doc-line.artic     and
    18401                                   cur-gds-dtl.prod-type   = cur-doc-line.prod-type and
    18402                                   cur-gds-dtl.prod-code   = cur-doc-line.prod-code no-lock:
    18403          assign
    18404          line-rec = recid(cur-doc-line)
    18405          gds-rec  = recid(cur-goods)
    18406          prt-rec  = recid(cur-gds-dtl).
    18407   assign
    18408     price-rubl-with-tax-loc = cur-doc-line.price-rubl
    18409     price-base-with-tax-loc = cur-doc-line.price-base
    18410   .
    18411   define variable vss-include-info121 as character format "x(65)" no-undo initial "@(#)$Workfile$".
    18412   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
    18413     (output varinvprb
    18414     )  .
    18415      find first in-vatp_doc-attr no-lock
    18416       where in-vatp_doc-attr.doc-code  = t-doc.doc-code
    18417         and in-vatp_doc-attr.attr-code = 'envd':U
    18418       no-error .
    18419       if available in-vatp_doc-attr
    18420          then do:
    18421          assign
    18422            in-vatp-have-vat-slt = no.
    18423      end.
    18424      else do:
    18425        assign
    18426          in-vatp-have-vat-slt = yes.
    18427      end.
    18428      find first in-vatp-goods where in-vatp-goods.artic     = cur-doc-line.artic     and
    18429                                        in-vatp-goods.prod-type = cur-doc-line.prod-type and
    18430                                        in-vatp-goods.prod-code = cur-doc-line.prod-code no-lock.
    18431      if (not t-doc.internal and
    18432              t-doc.doc-type = 'при':U) or
    18433         in-vatp-goods.gds-type = 'у':U then do:
    18434         if varinvprb = "base":u then do:
    18435           assign
    18436             road-tax-base-loc = cur-doc-line.road-tax
    18437             road-tax-rubl-loc = cur-doc-line.road-tax * t-doc.base-rate / t-doc.base-scale.
    18438         end.
    18439         else do:
    18440           ASSIGN
    18441             road-tax-rubl-loc = cur-doc-line.road-tax
    18442             road-tax-base-loc = cur-doc-line.road-tax / t-doc.base-rate * t-doc.base-scale.
    18443         end.
    18444         if road-tax-base-loc = ? then road-tax-base-loc = 0.
    18445         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
    18446         assign
    18447           road-tax-cli-loc = ?.
    18448         ASSIGN
    18449           transport-base-loc = (if cur-doc-line.transport-base = ? then 0 else cur-doc-line.transport-base)
    18450           transport-rubl-loc = (if cur-doc-line.transport-rubl = ? then 0 else cur-doc-line.transport-rubl)
    18451           transport-cli-loc  = 0
    18452           other-base-loc     = (if cur-doc-line.other-base     = ? then 0 else cur-doc-line.other-base)
    18453           other-rubl-loc     = (if cur-doc-line.other-rubl     = ? then 0 else cur-doc-line.other-rubl)
    18454           other-cli-loc      = 0
    18455           vat-pc-loc         = (if cur-doc-line.vat-pc         = ? then 0 else cur-doc-line.vat-pc)
