    18698       if not varlog then return error.
    18699       assign
    18700         prt-rec = recid (ub.doc-line)
    18701         del-list = string (recid (ub.gds-dtl)).
    18702       get next br-dtl.
    18703       if available ub.doc-line then del-rec = recid (ub.doc-line).
    18704       else do:
    18705         reposition br-dtl to recid prt-rec no-error.
    18706         get prev br-dtl.
    18707         del-rec = recid (ub.doc-line).
    18708       end.
    18709     end.
    18710     else do:
    18711       varlog = no.
    18712       message "УДАЛИТЬ  ВСЕ  ОТМЕЧЕННЫЕ  строки накладной ?   Вы уверены ?"
    18713                       view-as alert-box question buttons ok-cancel update varlog.
    18714       if not varlog then return error.
    18715       del-rec = ?.
    18716     end.
    18717     assign
    18718       varlns-cnt = 1.
    18719     do while varlns-cnt <= num-entries (del-list):
    18720       assign
    18721         prt-rec = integer (entry (varlns-cnt, del-list))
    18722         varlns-cnt = varlns-cnt + 1.
    18723       find ub.gds-dtl where recid (ub.gds-dtl) = prt-rec exclusive.
    18724       find ub.doc-line where ub.doc-line.doc-code = ub.gds-dtl.doc-code
    18725                             and ub.doc-line.prod-code = ub.gds-dtl.prod-code
    18726                             and ub.doc-line.prod-type = ub.gds-dtl.prod-type
    18727                             and ub.doc-line.artic     = ub.gds-dtl.artic exclusive.
    18728       define variable l-inv-on as logical no-undo .
    18729   define variable vss-include-info124 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    18730   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
    18731     (input  ub.doc-line.obj-type
    18732     ,input  ub.doc-line.obj-code
    18733     ,input  ub.doc-line.artic
    18734     ,input  ub.doc-line.prod-type
    18735     ,input  ub.doc-line.prod-code
    18736     ,input  'inv-on=request'
    18737     ,output l-inv-on
    18738     ) no-error .
    18739       if error-status :error then do:
    18740         message
    18741           "Ошибка получения признака товара на объекте" skip
    18742           error-status :get-message(1) skip
    18743           return-value skip
    18744           view-as alert-box error .
    18745         undo, return no-apply .
    18746       end.
    18747       if l-inv-on then do:
    18748         message
    18749           "Товар в инвентаризации." skip
    18750           "Артикул" ub.doc-line.artic ub.doc-line.prod-type ub.doc-line.prod-code skip
    18751           "Операция невозможна.".
    18752         undo, return error.
    18753       end.
    18754       find ub.goods where ub.goods.prod-code = ub.gds-dtl.prod-code
    18755                    and ub.goods.prod-type = ub.gds-dtl.prod-type
    18756                    and ub.goods.artic     = ub.gds-dtl.artic no-lock.
    18757       if lookup( string(t-doc.reason-code), v-reasons-for-return) > 0
    18758       and t-doc.ext-doc-type = 'ee':U
    18759       then do :
    18760         run str/out-add.p (parparentproc,
    18761                        recid(t-doc),
    18762                        recid(ub.doc-line),
    18763                        recid(ub.gds-dtl),
    18764                        recid (ub.goods),
    18765                        "delete" + chr(4) + "return",
    18766                        ?) no-error.
    18767         if error-status :error then return error.
    18768       end.
    18769       else do :
    18770         run str/out-add.p (parparentproc,
    18771                        recid(t-doc),
    18772                        recid(ub.doc-line),
    18773                        recid(ub.gds-dtl),
    18774                        recid (ub.goods),
    18775                        "delete",
    18776                        ?) no-error.
    18777         if error-status :error then return error.
    18778       end.
    18779     end.
    18780   end.
    18781   END PROCEDURE.
    18782   PROCEDURE local-lookup :
    18783   assign
    18784   varline-mode = 'ПРОСМОТР':U
    18785   varprt-mode  = 'ПРОСМОТР':U.
    18786   find ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code
    18787                           and ub.doc-line.prod-code = ub.gds-dtl.prod-code
    18788                           and ub.doc-line.prod-type = ub.gds-dtl.prod-type
    18789                           and ub.doc-line.artic         = ub.gds-dtl.artic no-lock.
    18790   find ub.goods where ub.goods.prod-code = ub.gds-dtl.prod-code
    18791                and ub.goods.prod-type = ub.gds-dtl.prod-type
    18792                and ub.goods.artic     = ub.gds-dtl.artic no-lock.
    18793   run str/out-add.p (
    18794       parparentproc,
    18795       recid(t-doc),
    18796       recid(ub.doc-line),
    18797       recid(ub.gds-dtl),
    18798       recid (ub.goods),
    18799       varline-mode,
    18800       ?)
    18801       no-error.
    18802       if error-status :error then return error return-value .
    18803   apply "entry" to br-dtl in frame d-out-doc.
    18804   END PROCEDURE.
    18805   PROCEDURE local-m-outs-1 :
    18806   define variable loc-ref-list     as character no-undo .
    18807   define variable v-hold           as logical   no-undo .
    18808   define variable v-ext-doc-type   as character no-undo .
    18809   define variable v-doc-rec        as recid     no-undo .
    18810   define variable v-stat           as character no-undo .
    18811   define variable v-type           as character no-undo .
    18812   define variable v-internal       as logical   no-undo .
    18813   define variable v-list-mode      as character no-undo .
    18814   assign
    18815     v-list-mode = 'выбор':U
    18816     v-stat = ?
    18817     v-type = ?
    18818     v-internal = ?
    18819     v-doc-rec = ?
    18820     v-hold = ?
    18821     v-ext-doc-type = ?
    18822     .
    18823   run str/all-docs.w
    18824       ( input parparentproc,
    18825         input t-doc.host-code ,
    18826         input t-doc.obj-type ,
    18827         input t-doc.obj-code ,
    18828         input v-list-mode,
    18829         input v-stat     ,
    18830         input v-type     ,
    18831         input     ?      ,
    18832         input v-internal ,
    18833         input "b-sel":u,
    18834         input v-ext-doc-type,
    18835         input v-hold,
    18836         input v-doc-rec,
    18837         output loc-ref-list).
    18838   find first t-d-b where recid (t-d-b) = integer (loc-ref-list) no-lock no-error.
    18839   if not available t-d-b then do:
    18840     display ? @ t-doc.out-code with frame d-out-doc.
    18841     apply "entry" to b-add in frame d-out-doc.
    18842     return error.
    18843   end.
    18844   display t-d-b.doc-code @ t-doc.out-code with frame d-out-doc.
    18845   run ask-copy in this-procedure no-error .
    18846   if error-status :error then return error return-value .
    18847   END PROCEDURE.
    18848   PROCEDURE local-outs-ret-doc :
    18849     define output parameter ret-doc-code   as character no-undo .
    18850     define variable v-at-value     as character no-undo .
    18851     define variable v-at-type      as character no-undo .
    18852     run str/choose-docs-for-return.w
    18853       ( input t-doc.reason-code ,
    18854         input edo-return,
    18855         input t-doc.doc-code ,
    18856         output ret-doc-code).
    18857     find first t-d-b where t-d-b.doc-code = ret-doc-code no-lock no-error.
    18858     if not available t-d-b then
    18859     do:
    18860       ret-doc-code = "" .
    18861       return error.
    18862     end.
    18863   END PROCEDURE.
    18864   PROCEDURE local-m-outs-1-ret :
    18865   define variable loc-ref-list     as character no-undo .
    18866   define variable v-hold           as logical   no-undo .
    18867   define variable v-ext-doc-type   as character no-undo .
    18868   define variable v-doc-rec        as recid     no-undo .
    18869   define variable v-stat           as character no-undo .
    18870   define variable v-type           as character no-undo .
    18871   define variable v-internal       as logical   no-undo .
    18872   define variable v-list-mode      as character no-undo .
    18873   define variable v-at-value     as character no-undo .
    18874   define variable v-at-type      as character no-undo .
    18875   find first ub.clients no-lock where ub.clients.obj-type = t-doc.cli-type
    18876                                   and ub.clients.obj-code = t-doc.cli-code .
    18877   assign
