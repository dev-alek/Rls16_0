    18288       ,input  true
    18289       ,output varlog
    18290       )  .
    18291   end.
    18292          end.
    18293          when 'возврат':U
    18294          then do:
    18295   define variable vss-include-info119 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    18296   do:
    18297     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    18298       (input  v-cntxt-db-num
    18299       ,input  v-cntxt-userid
    18300       ,input  0
    18301       ,input  'actn_return_price':U
    18302       ,input  'object':U
