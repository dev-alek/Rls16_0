    13506   procedure diasize_set-height :
    13507     define input  parameter p-new-height  as decimal   no-undo .
    13508     define input  parameter p-move-resize as logical   no-undo .
    13509     do
    13510     on error undo, return error return-value
    13511     :
    13512       run diasize_change-height in this-procedure
    13513         (input  (p-new-height - frame d-out-doc :height)
    13514         ,input  p-move-resize
    13515         ) .
    13516     end.
    13517   end procedure.
    13518   procedure diasize_change-width :
    13519     define input  parameter p-change-value as decimal   no-undo .
    13520     define input  parameter p-move-resize  as logical   no-undo .
