    18266   define variable v-vat-pc        like ub.doc-line.vat-pc    no-undo.
    18267   define variable v-host-code     like ub.sysconf.host-code  no-undo.
    18268      if parwith-tax <> 4
    18269      then do :
    18270        case t-doc.doc-type
    18271        :
    18272          when 'рас':U
    18273          then do:
    18274   define variable vss-include-info118 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    18275   do:
    18276     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    18277       (input  v-cntxt-db-num
    18278       ,input  v-cntxt-userid
    18279       ,input  0
    18280       ,input  'actn_expense_price':U
