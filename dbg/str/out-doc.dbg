     7969          b-revis:HIDDEN IN FRAME d-out-doc           = TRUE.
     7970   ON MOUSE-SELECT-DBLCLICK OF g-image IN FRAME d-out-doc
     7971   DO:
     7972     RUN ref/imagelist.w (PARPARENTPROC, "":U, ub.goods.gds-code,'ПРОСМОТР':U).
     7973   END.
     7974   ON WINDOW-CLOSE OF FRAME d-out-doc
     7975   DO:
     7976     APPLY "END-ERROR":U TO SELF.
     7977   END.
     7978   ON CHOOSE OF b-add IN FRAME d-out-doc
     7979   DO:
     7980   run local-add in this-procedure no-error.
     7981   if error-status :error then do:
     7982     message "Ошибка при добавлении." skip
     7983             return-value
     7984     view-as alert-box error.
     7985     return no-apply.
     7986   end.
     7987   run ui-on ("enable":u).
     7988   apply "entry" to b-add in frame d-out-doc.
     7989   END.
     7990   on choose of menu-item m-print-1 in menu m-print do:
     7991     if not available t-doc then return .
     7992     define variable v-user-action       as character    no-undo.
     7993     define variable v-printed           as logical      no-undo.
     7994     run rep/tick-doc.p (parparentproc , recid(t-doc), 'trn' , 1 , no, no ) .
     7995   end.
     7996   on choose of menu-item m-print-3 in menu m-print do:
     7997     if not available t-doc then return .
     7998     define variable v-user-action       as character    no-undo.
     7999     define variable v-printed           as logical      no-undo.
     8000     run rep/mbb-doc.p (parparentproc , recid(t-doc), 'trn'  ) no-error .
     8001     if error-status :error then message
     8002       error-status :get-message(1) skip
     8003       return-value skip
     8004       "Вывод в список кодов"
     8005       view-as alert-box error
     8006     .
     8007   end.
     8008   ON CHOOSE OF MENU-ITEM m_add-marks
     8009     DO:
     8010       define buffer buf_marking-lines for ub.marking-lines .
     8011       define buffer pri_marking-lines for ub.marking-lines .
     8012       define buffer buf_marking       for ub.marking .
     8013       define buffer buf_goods         for ub.goods .
     8014       define buffer buf_doc-line      for ub.doc-line .
     8015       define buffer buf_gds-dtl       for ub.gds-dtl .
     8016       define buffer buf_parts         for ub.parts .
     8017       define buffer bf_parts          for ub.parts .
     8018       define buffer cpl_gds-dtl       for ub.gds-dtl .
     8019       define buffer pri_trn-doc       for ub.trn-doc .
     8020       define variable mark       as character no-undo .
     8021       define variable ii         as integer   no-undo .
     8022       define variable jj         as integer   no-undo .
     8023       define variable v-GTIN     as character no-undo .
     8024       define variable v-gds-code as integer   no-undo .
     8025       define variable ungroup    as logical   no-undo .
     8026       define variable v-message  as character no-undo .
     8027       define variable vIsExemplarGoods as logical no-undo .
     8028       define variable varvalue        as character no-undo .
     8029       define variable vartype         as character no-undo .
     8030       define variable v-mark-weight as decimal no-undo .
     8031       define variable v-isweighed as logical no-undo .
     8032       define variable v-recid as recid no-undo .
     8033       if lookup( string(t-doc.reason-code), v-reasons-for-return) > 0
     8034       and t-doc.ext-doc-type = 'ee':U
     8035       and not v-is-return
     8036       then do :
     8037         if t-doc.out-code = ?
     8038         or t-doc.out-code = ""
     8039         or not can-find(pri_trn-doc no-lock where pri_trn-doc.doc-code = t-doc.out-code)
     8040         then do :
     8041           message "Сначала выберите корректный источник (ПН)" view-as alert-box .
     8042           return no-apply.
     8043         end.
     8044       end .
     8045       v-add = yes .
     8046       if not avail ub.goods then
     8047       do:
     8048         message "Сначала добавьте товар в документ" view-as alert-box .
     8049         return no-apply.
     8050       end.
     8051       v-recid = recid (ub.doc-line) .
     8052       v-isweighed = WghProdVariable(t-doc.obj-type, t-doc.obj-code, ub.goods.gds-code) .
     8053       run isExemplarGoods in this-procedure
     8054          (t-doc.obj-type, t-doc.obj-code, ub.goods.gds-code, output vIsExemplarGoods).
     8055       if not vIsExemplarGoods
     8056       and not v-isweighed
     8057       then do:
     8058         message "Для выбранного товара в документе не требуется ввод марок." skip
     8059                 "Выполняется ручное добавление товара и ввод количества." view-as alert-box .
     8060         return no-apply.
     8061       end.
     8062       do while v-add:
     8063       run str/chs-alcmarks.w (
     8064         input parparentproc,
     8065         input t-doc.doc-code,
     8066         input 'ДОБАВЛЕНИЕ':U,
     8067         input ub.goods.gds-code,
     8068         input "",
     8069         output mark) no-error.
     8070       if error-status :error or mark = "" or mark = ? then
     8071       do:
     8072         return no-apply.
     8073       end.
     8074       v-message = "" .
     8075       find first marking where marking.mark begins mark
     8076         no-lock no-error  .
     8077       if available marking then
     8078       do:
     8079           find first buf_goods no-lock where recid(buf_goods) = recid(ub.goods) no-error .
     8080           find first buf_doc-line exclusive-lock where buf_doc-line.doc-code = t-doc.doc-code
     8081             and buf_doc-line.artic = buf_goods.artic and buf_doc-line.prod-code = buf_goods.prod-code
     8082             and buf_doc-line.prod-type = buf_goods.prod-type no-error .
     8083           if not available (buf_doc-line) then
     8084           do:
     8085           find first buf_marking-lines exclusive-lock where buf_marking-lines.out-code = 'free-zone':U and
     8086             buf_marking-lines.gds-code = buf_goods.gds-code and buf_marking-lines.obj-code = t-doc.obj-code and buf_marking-lines.obj-type = t-doc.obj-type
     8087             and buf_marking-lines.mark begins mark no-error .
     8088           if available (buf_marking-lines) then
     8089           do:
     8090             if buf_marking-lines.doc-level > 1 then
     8091             do:
     8092                 if tree:UnGroupDoc(buf_marking-lines.mark, buf_marking-lines.in-code, buf_marking-lines.out-code, buf_marking-lines.obj-code, buf_marking-lines.obj-type) then
     8093                 do:
     8094               end.
     8095             end.
     8096           end.
     8097             if lookup( string(t-doc.reason-code), v-reasons-for-return) > 0
     8098             and t-doc.ext-doc-type = 'ee':U
     8099             then do :
     8100               if not can-find (pri_marking-lines no-lock where pri_marking-lines.out-code = t-doc.out-code
     8101                                                            and pri_marking-lines.mark begins mark)
     8102               then do :
     8103                 message "Марка " mark " не найдена в документе-источнике (" t-doc.out-code ")" view-as alert-box .
     8104                 return no-apply.
     8105               end .
     8106               run str/out-add.p (parparentproc,
     8107                 recid(t-doc),
     8108                 ?,
     8109                 ?,
     8110                 recid(buf_goods),
     8111                 'ДОБАВЛЕНИЕ':U + chr(4) + "return",
     8112                 'scan-marks' + chr(3) + mark) no-error.
     8113             end .
     8114             else do :
     8115               run str/out-add.p (parparentproc,
     8116                 recid(t-doc),
     8117                 ?,
     8118                 ?,
     8119                 recid(buf_goods),
     8120                 'ДОБАВЛЕНИЕ':U,
     8121                 'scan-marks' + chr(3) + mark) no-error.
     8122             end .
     8123           end.
     8124           else
     8125           do:
     8126           find first buf_marking-lines exclusive-lock where buf_marking-lines.out-code = 'free-zone':U and
     8127             buf_marking-lines.gds-code = buf_goods.gds-code and buf_marking-lines.obj-code = buf_doc-line.obj-code and buf_marking-lines.obj-type = buf_doc-line.obj-type
     8128             and buf_marking-lines.mark begins mark no-error .
     8129           if available (buf_marking-lines) then
     8130           do:
     8131             if buf_marking-lines.doc-level > 1 then
     8132             do:
     8133                 if tree:UnGroupDoc(buf_marking-lines.mark, buf_marking-lines.in-code, buf_marking-lines.out-code, buf_marking-lines.obj-code, buf_marking-lines.obj-type) then
     8134                 do:
     8135               end.
     8136             end.
     8137          end.
     8138          else do:
     8139            v-message = "У марки нет свободной зоны" .
     8140          end.
     8141           find first cpl_gds-dtl exclusive-lock where cpl_gds-dtl.doc-code = buf_doc-line.doc-code
     8142             and cpl_gds-dtl.artic = buf_doc-line.artic and buf_doc-line.prod-code = cpl_gds-dtl.prod-code
     8143             and buf_doc-line.prod-type = cpl_gds-dtl.prod-type no-error.
     8144             if lookup( string(t-doc.reason-code), v-reasons-for-return) > 0
     8145             and t-doc.ext-doc-type = 'ee':U
     8146             then do :
     8147               run str/out-add.p
     8148                 ( input parparentproc
     8149                 ,input recid(t-doc)
     8150                 ,input recid(buf_doc-line)
     8151                 ,input recid(cpl_gds-dtl)
     8152                 ,input recid (buf_goods)
     8153                 ,input 'ИЗМЕНЕНИЕ':U + chr(4) + "return"
     8154                 ,input 'scan-marks' + chr(3) + mark)
     8155                 no-error.
     8156             end .
     8157             else do :
     8158               run str/out-add.p
     8159                 ( input parparentproc
     8160                 ,input recid(t-doc)
     8161                 ,input recid(buf_doc-line)
     8162                 ,input recid(cpl_gds-dtl)
     8163                 ,input recid (buf_goods)
     8164                 ,input 'ИЗМЕНЕНИЕ':U
     8165                 ,input 'scan-marks' + chr(3) + mark)
     8166                 no-error.
     8167             end .
     8168           end.
     8169       end.
     8170       run ui-on in this-procedure ( input "line" ).
     8171       reposition br-dtl to recid v-recid no-error.
     8172       end.
     8173     END.
     8174   ON CHOOSE OF MENU-ITEM m_lookup-marks
     8175     DO:
     8176       define buffer bf_doc-line for ub.doc-line .
     8177       define buffer bf_goods    for ub.goods.
     8178       define variable par-alcohol as character no-undo .
     8179       define variable par-type    as character no-undo .
     8180       define variable p-alcohol   as logical   no-undo .
     8181       define variable v-type      as integer   no-undo .
     8182       define variable v-fact-qnty as decimal   no-undo .
     8183       define variable v-fact-part as decimal   no-undo .
     8184       define variable vGtin       as character no-undo .
     8185       define variable vGtinQnty   as integer   no-undo .
     8186       define variable v-mark-weight as decimal no-undo .
     8187       define variable v-isweighed as logical   no-undo .
     8188       define buffer buf_doc-line for ub.doc-line.
     8189       define buffer buf_gds-dtl  for ub.gds-dtl.
     8190       define buffer buf_parts    for ub.parts.
     8191       if t-doc.ext-doc-type = 'rv':U or t-doc.ext-doc-type = 'ev':U then v-type = 0. else v-type = 2 .
     8192       for each bf_doc-line no-lock where bf_doc-line.doc-code = t-doc.doc-code :
     8193         find first bf_goods no-lock where bf_goods.artic     = bf_doc-line.artic
     8194           and bf_goods.prod-type = bf_doc-line.prod-type
     8195           and bf_goods.prod-code = bf_doc-line.prod-code
     8196           no-error .
     8197         run gds-attr-value(
     8198           bf_goods.gds-code,
     8199           'alcohol-prod':U,
     8200           output par-alcohol,
     8201           output par-type
     8202           ).
     8203         if par-alcohol = "yes" then p-alcohol = yes .
     8204       end.
     8205       if p-alcohol then
     8206       do:
     8207         run bge/egais-control-marks.w (input parparentproc).
     8208       end.
     8209       else
     8210       do:
     8211         if available (t-doc) then
     8212         do:
     8213           for each ub.marking-lines no-lock where
     8214             ub.marking-lines.obj-type = t-doc.obj-type
     8215             and ub.marking-lines.obj-code = t-doc.obj-code
     8216             and ub.marking-lines.out-code = t-doc.doc-code
     8217             and ub.marking-lines.gds-code = ub.goods.gds-code:
     8218               find first ub.marking no-lock where ub.marking.mark begins ub.marking-lines.mark and ub.marking.sts <> ObjSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB no-error.
     8219               if available (ub.marking)
     8220                 then
     8221               do:
     8222                 find first tt-marking-lines no-lock where
     8223                            tt-marking-lines.mark = ub.marking-lines.mark
     8224                      no-error.
     8225                 if not avail tt-marking-lines or
     8226                    ub.marking.unit-ext <> "unit" then
     8227                 do:
     8228                     if ub.marking.box-qnty = 0 then
     8229                     do:
     8230                       vGtin     = getGtinByDM(ub.marking.mark) .
     8231                       vGtinQnty = getQntyCodeByGtin(vGtin).
     8232                     end.
     8233                     else
     8234                       vGtinQnty = ub.marking.box-qnty.
     8235                     create tt-marking-lines.
     8236                     buffer-copy ub.marking-lines to tt-marking-lines.
     8237                     tt-marking-lines.sts = ub.marking.sts.
     8238                     tt-marking-lines.stts = objSrv:Env:Marking:Sts:Mark:GetLabel(ub.marking.sts).
     8239                     tt-marking-lines.sts-utd = ub.marking-lines.sts.
     8240                     tt-marking-lines.stts-utd = objSrv:Env:Marking:Sts:Mark:GetLabel(ub.marking-lines.sts).
     8241                     tt-marking-lines.box-qnty = vGtinQnty .
     8242                     tt-marking-lines.unit = ub.marking.unit .
     8243                     tt-marking-lines.unit-ext = ub.marking.unit-ext .
     8244                     tt-marking-lines.doc-level = ub.marking-lines.doc-level.
     8245                     tt-marking-lines.mark-parent = ub.marking.mark-parent.
     8246                 end.
     8247               end.
     8248           end.
     8249         end.
     8250         if available (tt-marking-lines) then
     8251         do:
     8252           run str/mark_browse.w (input parparentproc,
     8253             input-output table tt-marking-lines by-reference,
     8254             input if t-doc.ext-doc-type = 'iv':U then 'ИЗМЕНЕНИЕ':U else 'ПРОСМОТР':U,
     8255             input "Марки по: " + t-doc.doc-code + chr(4) + t-doc.ext-doc-type,
     8256             input v-type,
     8257             input ""
     8258             )  .
     8259             if pardoc-mode <> 'ПРОСМОТР':U and t-doc.ext-doc-type = 'iv':U then
     8260             do:
     8261                v-isweighed = WghProdVariable(t-doc.obj-type, t-doc.obj-code, ub.goods.gds-code) .
     8262                for each buf_parts exclusive-lock where
     8263                         buf_parts.artic = ub.goods.artic
     8264                     and buf_parts.prod-type = ub.goods.prod-type
     8265                     and buf_parts.prod-code = ub.goods.prod-code
     8266                     and buf_parts.obj-type = t-doc.obj-type
     8267                     and buf_parts.obj-code = t-doc.obj-code
     8268                     and buf_parts.out-code = t-doc.doc-code
     8269                    :
     8270                  v-fact-part = 0.
     8271                  for each tt-marking-lines no-lock where
     8272                           tt-marking-lines.doc-level = 1
     8273                       and tt-marking-lines.in-code = buf_parts.in-code
     8274                       and tt-marking-lines.out-code = buf_parts.out-code
     8275                       and tt-marking-lines.part-code = buf_parts.part-code
     8276                       and tt-marking-lines.prt-code = buf_parts.prt-code
     8277                  :
     8278                      if tt-marking-lines.sts-utd <> objSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB and
     8279                         tt-marking-lines.sts-utd <> objSrv:Env:Marking:Sts:Mark:DeliveryControl:KeyIntDB
     8280                      then do :
     8281                        if v-isweighed
     8282                        then do :
     8283                          v-fact-part = v-fact-part + MarkWeight(tt-marking-lines.mark) .
     8284                        end .
     8285                        else do :
     8286                          v-fact-part = v-fact-part + tt-marking-lines.box-qnty.
     8287                        end .
     8288                      end .
     8289                  end.
     8290                  if buf_parts.fact-qnty <> v-fact-part then
     8291                    buf_parts.fact-qnty = v-fact-part.
     8292                  v-fact-qnty = v-fact-qnty + v-fact-part.
     8293                end.
     8294                if ub.gds-dtl.fact-qnty <> v-fact-qnty then
     8295                do:
     8296                  find first buf_doc-line where rowid(buf_doc-line) = rowid(ub.doc-line) exclusive-lock.
     8297                  find first buf_gds-dtl where rowid(buf_gds-dtl) = rowid(ub.gds-dtl) exclusive-lock.
     8298                  assign
     8299                    buf_doc-line.fact-qnty = v-fact-qnty
     8300                    buf_gds-dtl.fact-qnty  = v-fact-qnty
     8301                  .
     8302                  br-dtl:refresh() in frame d-out-doc.
     8303                  for each bf_doc-line no-lock where
     8304                           bf_doc-line.obj-type = t-doc.obj-type
     8305                       and bf_doc-line.obj-code = t-doc.obj-code
     8306                       and bf_doc-line.doc-code = t-doc.doc-code
     8307                  :
     8308                    accum bf_doc-line.fact-qnty (total).
     8309                  end.
     8310                  if t-doc.fact-qnty <> accum total bf_doc-line.fact-qnty then
     8311                  do:
     8312                    t-doc.fact-qnty = accum total bf_doc-line.fact-qnty.
     8313                    display t-doc.fact-qnty with frame d-out-doc.
     8314                  end.
     8315                end.
     8316             end.
     8317         end.
     8318         else
     8319         do:
     8320           message "Нет марок для просмотра"
     8321             view-as alert-box.
     8322         end.
     8323         for each tt-marking-lines:
     8324           delete tt-marking-lines.
     8325         end.
     8326       end.
     8327     END.
     8328   ON CHOOSE OF MENU-ITEM m_no-marks
     8329     DO:
     8330       define buffer bf_doc-line for ub.doc-line .
     8331       define buffer bf_goods    for ub.goods.
     8332       define buffer buf_marking-lines for ub.marking-lines .
     8333       define buffer buf_marking       for ub.marking .
     8334       define buffer buf_goods         for ub.goods .
     8335       define buffer buf_doc-line      for ub.doc-line .
     8336       define buffer buf_gds-dtl       for ub.gds-dtl .
     8337       define buffer buf_parts         for ub.parts .
     8338       define buffer bf_parts          for ub.parts .
     8339       define buffer cpl_gds-dtl       for ub.gds-dtl .
     8340       define variable mark       as character no-undo .
     8341       define variable jj         as integer   no-undo .
     8342       define variable v-GTIN     as character no-undo .
     8343       define variable v-gds-code as integer   no-undo .
     8344       define variable ungroup    as logical   no-undo .
     8345       define variable v-message  as character no-undo .
     8346       define variable qnty-mark-doc as integer no-undo .
     8347       define variable qnty-mark-fact as integer no-undo .
     8348       define variable ii as integer no-undo .
     8349       define variable v-ok as logical no-undo .
     8350         if available (t-doc) then
     8351         do:
     8352          for each bf_doc-line no-lock where bf_doc-line.doc-code = t-doc.doc-code,
     8353           first bf_goods no-lock where bf_goods.artic = bf_doc-line.artic
     8354                                    and bf_goods.prod-code = bf_doc-line.prod-code
     8355                                    and bf_goods.prod-type = bf_doc-line.prod-type:
     8356            qnty-mark-doc = 0 .
     8357            qnty-mark-fact = 0 .
     8358           for each ub.marking-lines no-lock where
     8359             ub.marking-lines.obj-type = t-doc.obj-type
     8360             and ub.marking-lines.obj-code = t-doc.obj-code
     8361             and ub.marking-lines.out-code = t-doc.doc-code
     8362             and ub.marking-lines.gds-code = bf_goods.gds-code
     8363             and ub.marking-lines.mark begins 'tech_':U:
     8364             find first ub.marking no-lock where ub.marking.mark = ub.marking-lines.mark and ub.marking.unit-ext = "UNIT" no-error.
     8365             if available (ub.marking)
     8366               then
     8367             do:
     8368               qnty-mark-doc = qnty-mark-doc + 1 .
     8369               if ub.marking-lines.sts = Marking:Checked_:KeyIntDB then qnty-mark-fact = qnty-mark-fact + 1 .
     8370             end.
     8371           end.
     8372           if qnty-mark-doc > 0 then do:
     8373           create tt-tech-mark.
     8374           assign
     8375             tt-tech-mark.doc-code  = bf_doc-line.doc-code
     8376             tt-tech-mark.line-num  = bf_doc-line.line-num
     8377             tt-tech-mark.gds-code  = bf_goods.gds-code
     8378             tt-tech-mark.gds-name  = bf_goods.gds-name
     8379             tt-tech-mark.qnty-doc  = qnty-mark-doc
     8380             tt-tech-mark.qnty-fact = qnty-mark-fact
     8381             .
     8382             end.
     8383         end.
     8384         if available (tt-tech-mark) then
     8385         do:
     8386           run str/no_mark.w (input parparentproc,
     8387             input-output table tt-tech-mark by-reference,
     8388             input pardoc-mode,
     8389             output v-ok
     8390             )
     8391             .
     8392   if v-ok then do:
     8393   for each ub.marking-lines exclusive-lock where
     8394             ub.marking-lines.obj-type = t-doc.obj-type
     8395             and ub.marking-lines.obj-code = t-doc.obj-code
     8396             and ub.marking-lines.out-code = t-doc.doc-code
     8397             and ub.marking-lines.mark begins 'tech_':U:
     8398             ub.marking-lines.sts = Marking:PendingVerification:KeyIntDB .
     8399   end.
     8400   for each tt-tech-mark:
     8401   ii = 0 .
     8402   for each ub.marking-lines exclusive-lock where
     8403             ub.marking-lines.obj-type = t-doc.obj-type
     8404             and ub.marking-lines.obj-code = t-doc.obj-code
     8405             and ub.marking-lines.out-code = tt-tech-mark.doc-code
     8406             and ub.marking-lines.gds-code = tt-tech-mark.gds-code
     8407             and ub.marking-lines.mark begins 'tech_':U:
     8408             ii = ii + 1 .
     8409             if ii > tt-tech-mark.qnty-fact then leave .
     8410             ub.marking-lines.sts = Marking:Checked_:KeyIntDB .
     8411   end.
     8412   end.
     8413       ii = 0 .
     8414           for each buf_doc-line exclusive-lock where buf_doc-line.doc-code = t-doc.doc-code,
     8415             first buf_gds-dtl exclusive-lock where buf_gds-dtl.doc-code = buf_doc-line.doc-code and
     8416                                                    buf_gds-dtl.artic = buf_doc-line.artic and
     8417                                                    buf_gds-dtl.prod-code = buf_doc-line.prod-code and
     8418                                                    buf_gds-dtl.prod-type = buf_doc-line.prod-type:
     8419             jj = 0 .
     8420             find first buf_goods no-lock where buf_goods.artic = buf_doc-line.artic and
     8421                                                buf_goods.prod-code = buf_doc-line.prod-code and
     8422                                                buf_goods.prod-type = buf_doc-line.prod-type no-error .
     8423             for each buf_marking-lines exclusive-lock where buf_marking-lines.obj-code = buf_doc-line.obj-code and
     8424                                                             buf_marking-lines.obj-type = buf_doc-line.obj-type and
     8425                                                             buf_marking-lines.out-code = buf_doc-line.doc-code and
     8426                                                             buf_marking-lines.gds-code = buf_goods.gds-code,
     8427               first buf_marking no-lock where buf_marking.mark = buf_marking-lines.mark and
     8428                                               buf_marking.obj-code = buf_marking-lines.obj-code and
     8429                                               buf_marking.obj-type = buf_marking-lines.obj-type and buf_marking.unit-ext = "UNIT":
     8430             if buf_marking-lines.sts = ObjSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB then do:
     8431             jj = jj + 1 .
     8432             ii = ii + 1 .
     8433             end.
     8434             buf_doc-line.fact-qnty = jj .
     8435             buf_gds-dtl.fact-qnty = buf_doc-line.fact-qnty .
     8436             for first buf_parts exclusive-lock where buf_parts.out-code = buf_marking-lines.out-code and
     8437                                                      buf_parts.artic = buf_doc-line.artic and
     8438                                                      buf_parts.prod-code = buf_doc-line.prod-code and
     8439                                                      buf_parts.prod-type = buf_doc-line.prod-type and
     8440                                                      buf_parts.obj-code = buf_marking-lines.obj-code and
     8441                                                      buf_parts.obj-type = buf_marking-lines.obj-type and
     8442                                                      buf_parts.part-code = buf_marking-lines.part-code and
     8443                                                      buf_parts.in-code = buf_marking-lines.in-code :
     8444               buf_parts.fact-qnty = buf_doc-line.fact-qnty .
     8445             end.
     8446             end.
     8447           t-doc.fact-qnty = ii .
     8448           end.
     8449    end.
     8450         end.
     8451         else
     8452         do:
     8453           message "Нет технических марок"
     8454             view-as alert-box.
     8455         end.
     8456       end.
     8457       empty temp-table tt-tech-mark .
     8458       run ui-on in this-procedure ( input "line" ).
     8459     END.
     8460   ON CHOOSE OF b-arch IN FRAME d-out-doc
     8461   DO:
     8462   define variable vss-include-info47 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8463   do:
     8464     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8465       (input  v-cntxt-db-num
     8466       ,input  v-cntxt-userid
     8467       ,input  0
     8468       ,input  'actn_archive_cost':U
     8469       ,input  'object':U
     8470       ,input  t-doc.host-code
     8471       ,input  t-doc.obj-type
     8472       ,input  t-doc.obj-code
     8473       ,input  0
     8474       ,input  0
     8475       ,input  0
     8476       ,input  true
     8477       ,output varlog
     8478       )  .
     8479   end.
     8480     if varlog <> yes
     8481     then do:
     8482       return no-apply.
     8483     end.
     8484     run str/docsuppn.w
     8485       (input parparentproc
     8486       ,input recid( t-doc )
     8487       ).
     8488   END.
     8489   ON CHOOSE OF b-attr IN FRAME d-out-doc
     8490   DO:
     8491       run init-attr-general in this-procedure .
     8492       if t-doc.status_ <> 'факт':U then do:
     8493         run str/doc-attr.w (input ParParentproc, input "b-lkp,b-chg,b-add,b-del", input t-doc.doc-code, input table tt-upd-attr) no-error.
     8494       end.
     8495       else do:
     8496         run str/doc-attr.w (input ParParentproc, input "b-lkp,b-chg,b-add", input t-doc.doc-code, input table tt-upd-attr) no-error.
     8497       end.
     8498   END.
     8499   ON CHOOSE OF b-bc IN FRAME d-out-doc
     8500   DO:
     8501     run check-rate no-error.
     8502   if error-status :error then return no-apply.
     8503   if t-doc.doc-type = 'при':U and
     8504      t-doc.internal = yes       and
     8505      t-doc.status_  = 'накл':U   and
     8506      t-doc.flag_                then do:
     8507      if avail ub.bar-code then
     8508      do:
     8509        run checkTypeByBarCode in this-procedure (ub.bar-code.b-code, t-doc.ext-doc-type) no-error.
     8510        if error-status:error then return no-apply.
     8511      end.
     8512      run fact-bc in this-procedure (t-doc.doc-code)  no-error.
     8513      if error-status :error then do:
     8514        message
     8515          vss-workfile vss-revision vss-description skip
     8516          "Ошибка при редактировании фактических количеств." skip
     8517          return-value skip
     8518          view-as alert-box error.
     8519        undo, return no-apply.
     8520      end.
     8521   end.
     8522   else do:
     8523     assign
     8524       v-cond = 'свободно':U
     8525       varline-mode = 'ИЗМЕНЕНИЕ':U
     8526       prt-rec = ?
     8527       varlns-cnt = 1
     8528       add-sens = b-add:sensitive
     8529       b-c = 0
     8530       gds-rec = ?.
     8531     do while b-c <> ?:
     8532        run str/chs-bc.w (parparentproc, "Строка накладной № " + t-doc.doc-code, add-sens, no, yes, output b-c-char, output rate, output ret-mode, input-output add-scan, input-output bar-str).
     8533        b-c = integer(b-c-char).
     8534        if b-c <> ? then do:
     8535           run checkTypeByBarCode in this-procedure (b-c, t-doc.ext-doc-type) no-error.
     8536           if error-status:error then next.
     8537           do transaction on error undo, return no-apply :
     8538              if t-doc.flag_ and t-doc.status_ = 'разрешен':U then do:
     8539                 run find-gds no-error.
     8540                 if error-status :error then undo, return no-apply.
     8541              end.
     8542              if add-scan and t-doc.flag_ and t-doc.status_ = 'разрешен':U then do:
     8543                 run add-rate no-error.
     8544                 if error-status :error then undo, return no-apply.
     8545   define buffer out-dtl for ub.gds-dtl.
     8546   if available ub.gds-dtl then do:
     8547       prt-rec = recid(ub.gds-dtl).
     8548       if dec(ub.gds-dtl.fact-qnty:screen-value in browse br-dtl) = ?
     8549       then do:
     8550         message "Не указано количество.".
     8551         disp ub.gds-dtl.fact-qnty with browse br-dtl.
     8552         return no-apply.
     8553       end.
     8554       if (can-do ('при,возврат':U, t-doc.doc-type)
     8555          and t-doc.internal
     8556          and ( ub.gds-prt.upper-code = ub.goods.prt-root  or
     8557            can-find (out-dtl where out-dtl.doc-code = t-doc.out-code and
     8558                                                 out-dtl.artic = ub.gds-dtl.artic and
     8559                                                 out-dtl.prod-type = ub.gds-dtl.prod-type and
     8560                                                 out-dtl.prod-code = ub.gds-dtl.prod-code and
     8561                                                 out-dtl.prt-code = ub.gds-dtl.prt-code no-lock))
     8562           or not can-do ('при,возврат':U, t-doc.doc-type)
     8563           or (t-doc.doc-type = 'возврат':U and not t-doc.internal)
     8564           )
     8565           and input browse br-dtl ub.gds-dtl.fact-qnty > ub.gds-dtl.doc-qnty then do:
     8566         message "Фактическое количество товара не может быть больше количества по накладной.".
     8567         disp ub.gds-dtl.fact-qnty with browse br-dtl.
     8568         return no-apply.
     8569       end.
     8570       find ub.units where ub.units.unit-name = ub.goods.unit-base no-lock.
     8571       if lookup('сер':U, ub.units.type) > 0 then do:
     8572          message "В серийном товаре нельзя редактировать количество".
     8573          disp ub.gds-dtl.fact-qnty with browse br-dtl.
     8574          return no-apply.
     8575       end.
     8576       find ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code
     8577                          and ub.doc-line.prod-code = ub.gds-dtl.prod-code
     8578                          and ub.doc-line.prod-type = ub.gds-dtl.prod-type
     8579                          and ub.doc-line.artic         = ub.gds-dtl.artic no-lock no-error.
     8580       find ub.goods where ub.goods.prod-code = ub.gds-dtl.prod-code
     8581                  and ub.goods.prod-type = ub.gds-dtl.prod-type
     8582                  and ub.goods.artic     = ub.gds-dtl.artic no-lock.
     8583       run str/out-add.p (parparentproc,
     8584                      recid(t-doc),
     8585                      recid(ub.doc-line),
     8586                      recid(ub.gds-dtl),
     8587                      recid(ub.goods),
     8588                      "ch-fact-qnty",
     8589                      string(input browse br-dtl ub.gds-dtl.fact-qnty)) no-error.
     8590       if error-status:error then return no-apply.
     8591       if query br-dtl:GET-BUFFER-HANDLE (1):NAME = "gds-dtl" then
     8592           prt-rec = recid(ub.gds-dtl).
     8593       else
     8594           prt-rec = recid(ub.doc-line).
     8595       run ui-on("line").
     8596       reposition br-dtl to recid prt-rec.
     8597   end.
     8598              end.
     8599              else do:
     8600                 assign
     8601                   varline-mode = 'ИЗМЕНЕНИЕ':U
     8602                   prt-rec   = ?
     8603                   line-rec  = ?.
     8604                 run str/out-add.p (parparentproc,
     8605                                recid(t-doc),
     8606                                ?,
     8607                                ?,
     8608                                ?,
     8609                                "b-c",
     8610                                string(b-c)             + "," +
     8611                                string(rate)            + "," +
     8612                                ret-mode                + "," +
     8613                                string(b-add:sensitive) + "," +
     8614                                string(add-scan)).
     8615              end.
     8616           end.
     8617        end.
     8618     end.
     8619   end.
     8620   run ui-on ("line").
     8621   if prt-rec <> ? then
     8622     reposition br-dtl to recid prt-rec no-error.
     8623   return no-apply.
     8624   END.
     8625   ON CHOOSE OF b-chg IN FRAME d-out-doc
     8626   DO:
     8627   define buffer bin_parts for ub.parts .
     8628   define buffer bout_parts for ub.parts .
     8629   define buffer buf_gen-attr for ub.gen-attr .
     8630   define variable v-recid as recid no-undo .
     8631     if not available ub.gds-dtl then do:
     8632       message "Неправильный выбор строки.".
     8633       return no-apply.
     8634     end.
     8635     v-recid = recid (ub.doc-line) .
     8636     run check-rate in this-procedure
     8637       no-error.
     8638     if error-status :error then do:
     8639       return no-apply.
     8640     end.
     8641     assign
     8642       varline-mode = 'ИЗМЕНЕНИЕ':U
     8643     .
     8644     run check-inv in this-procedure
     8645       no-error.
     8646     if error-status :error then do:
     8647       return no-apply.
     8648     end.
     8649     find first ub.doc-line
     8650       where ub.doc-line.doc-code  = ub.gds-dtl.doc-code
     8651         and ub.doc-line.artic     = ub.gds-dtl.artic
     8652         and ub.doc-line.prod-type = ub.gds-dtl.prod-type
     8653         and ub.doc-line.prod-code = ub.gds-dtl.prod-code
     8654       .
     8655     if v-is-return
     8656     then do :
     8657       for first bout_parts no-lock where bout_parts.obj-type  = doc-line.obj-type
     8658                                      and bout_parts.obj-code  = doc-line.obj-code
     8659                                      and bout_parts.artic     = doc-line.artic
     8660                                      and bout_parts.prod-type = doc-line.prod-type
     8661                                      and bout_parts.prod-code = doc-line.prod-code
     8662                                      and bout_parts.out-code  = doc-line.doc-code
     8663       :
     8664         find first buf_gen-attr no-lock where buf_gen-attr.table-name = 'parts':U
     8665                                           and buf_gen-attr.p-key      =  "parts"                + chr(3) +
     8666    bout_parts.obj-type           + chr(3) +
     8667    string(bout_parts.obj-code)   + chr(3) +
     8668    bout_parts.artic              + chr(3) +
     8669    bout_parts.prod-type          + chr(3) +
     8670    string(bout_parts.prod-code)  + chr(3) +
     8671    bout_parts.In-code            + chr(3) +
     8672    bout_parts.Out-code           + chr(3) +
     8673    bout_parts.part-Code          + chr(3) +
     8674    string(bout_parts.prt-code)
     8675                                           and buf_gen-attr.attr-code  = "in-part-key"
     8676                                           no-error .
     8677         if available buf_gen-attr
     8678         then do :
     8679           find first bin_parts no-lock where bin_parts.obj-type  = entry(2, buf_gen-attr.attr-value, chr(3))
     8680                                          and bin_parts.obj-code  = integer(entry(3, buf_gen-attr.attr-value, chr(3)))
     8681                                          and bin_parts.artic     = entry(4, buf_gen-attr.attr-value, chr(3))
     8682                                          and bin_parts.prod-type = entry(5, buf_gen-attr.attr-value, chr(3))
     8683                                          and bin_parts.prod-code = integer(entry(6, buf_gen-attr.attr-value, chr(3)))
     8684                                          and bin_parts.in-code   = entry(7, buf_gen-attr.attr-value, chr(3))
     8685                                          and bin_parts.out-code  = entry(8, buf_gen-attr.attr-value, chr(3))
     8686                                          and bin_parts.part-code = entry(9, buf_gen-attr.attr-value, chr(3))
     8687                                          no-error .
     8688         end .
     8689       end .
     8690       if available bin_parts
     8691       then do :
     8692         run str/out-add.p
     8693           ( input parparentproc
     8694           ,input recid(t-doc)
     8695           ,input recid(doc-line)
     8696           ,input recid(gds-dtl)
     8697           ,input recid (goods)
     8698           ,input varline-mode + chr(4) + "return=" + string(recid(bin_parts))
     8699           ,input ?
     8700           ) no-error.
     8701         if error-status :error then
     8702         do:
     8703           return no-apply.
     8704         end.
     8705       end .
     8706       else do :
     8707         run str/out-add.p
     8708          ( input parparentproc
     8709           ,input recid(t-doc)
     8710           ,input recid(doc-line)
     8711           ,input recid(gds-dtl)
     8712           ,input recid (goods)
     8713           ,input varline-mode + chr(4) + "return"
     8714           ,input ?
     8715           ) no-error.
     8716         if error-status :error then
     8717         do:
     8718           return no-apply.
     8719         end.
     8720       end .
     8721     end .
     8722     else
     8723     if (lookup( string(t-doc.reason-code), v-reasons-for-return) > 0
     8724     and t-doc.ext-doc-type = 'ee':U)
     8725     then do :
     8726       run str/out-add.p
     8727         ( input parparentproc
     8728         ,input recid(t-doc)
     8729         ,input recid(ub.doc-line)
     8730         ,input recid(ub.gds-dtl)
     8731         ,input recid (ub.goods)
     8732         ,input varline-mode + chr(4) + "return"
     8733         ,input ?
     8734         ) no-error.
     8735       if error-status :error then do:
     8736         return no-apply.
     8737       end.
     8738     end.
     8739     else do :
     8740       run str/out-add.p
     8741         ( input parparentproc
     8742         ,input recid(t-doc)
     8743         ,input recid(ub.doc-line)
     8744         ,input recid(ub.gds-dtl)
     8745         ,input recid (ub.goods)
     8746         ,input varline-mode
     8747         ,input ?
     8748         ) no-error.
     8749       if error-status :error then do:
     8750         return no-apply.
     8751       end.
     8752     end.
     8753     if t-doc.ext-doc-type = 'ev':U
     8754     then do :
     8755       run local-cur in this-procedure (input 4) no-error.
     8756       if error-status :error then return .
     8757     end .
     8758     run ui-on in this-procedure
     8759       ( input "line"
     8760       ).
     8761     apply "entry" to br-dtl in frame d-out-doc .
     8762     reposition br-dtl to recid v-recid no-error.
     8763   END.
     8764   ON CHOOSE OF b-cnt IN FRAME d-out-doc
     8765   DO:
     8766   define variable vss-include-info48 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8767   do:
     8768     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8769       (input  v-cntxt-db-num
     8770       ,input  v-cntxt-userid
     8771       ,input  0
     8772       ,input  'actn_archive_cost':U
     8773       ,input  'object':U
     8774       ,input  t-doc.host-code
     8775       ,input  t-doc.obj-type
     8776       ,input  t-doc.obj-code
     8777       ,input  0
     8778       ,input  0
     8779       ,input  0
     8780       ,input  true
     8781       ,output varlog
     8782       )  .
     8783   end.
     8784     if varlog <> yes then do: return no-apply. end.
     8785     run str/scntdoc.w ( input t-doc.doc-code, input ( v-cntxt-db-num = ub.sysconf.firm-db-num ) ).
     8786   END.
     8787   ON CHOOSE OF b-contr-lkp IN FRAME d-out-doc
     8788   DO:
     8789    define buffer buf_contract for ub.contract  .
     8790    if t-doc.contract-code <> 0 then do:
     8791      if is-doc-hold then do:
     8792         find first buf_contract no-lock where
     8793               buf_contract.contract-code = t-doc.contract-code no-error .
     8794      end.
     8795      else do:
     8796         find first buf_contract no-lock where
     8797               buf_contract.host-code     = t-doc.host-code   and
     8798               buf_contract.contract-code = t-doc.contract-code no-error .
     8799      end.
     8800         if available buf_contract then do:
     8801             run str/sh-contr.p
     8802                 ( input parParentProc ,
     8803                   input recid(buf_contract)
     8804                 ).
     8805         end.
     8806     end.
     8807   END.
     8808   ON CHOOSE OF b-del IN FRAME d-out-doc
     8809   DO:
     8810     run local-del no-error.
     8811   if error-status :error then return no-apply.
     8812   run ui-on ("enable":u).
     8813   apply "entry" to br-dtl in frame d-out-doc .
     8814   prt-rec = del-rec.
     8815   if prt-rec <> ? then reposition br-dtl to recid prt-rec no-error.
     8816   IF mImagePh THEN
     8817   DO:
     8818       DEFINE VARIABLE vImageList AS LONGCHAR    NO-UNDO.
     8819       DEFINE VARIABLE vCh        AS CHARACTER   NO-UNDO.
     8820   if AVAILABLE goods then do:
     8821       RUN gds-attr-value ( goods.gds-code, "image-list":U, OUTPUT vImageList, OUTPUT vCh).
     8822       RUN imagelist_decode IN THIS-PROCEDURE (INPUT vImageList, goods.gds-code, OUTPUT vImageList).
     8823       vCh = ENTRY (1, vImageList, ",":U).
     8824       g-image:LOAD-IMAGE (ENTRY (1, vCh)) NO-ERROR.
     8825       ASSIGN
     8826           g-image:HIDDEN     = NO
     8827           g-image:VISIBLE    = YES
     8828           g-image:SENSITIVE  = YES
     8829           .
     8830   end.
     8831   else
     8832         ASSIGN
     8833           g-image:HIDDEN     = YES
     8834           g-image:VISIBLE    = NO
     8835           g-image:SENSITIVE  = NO
     8836           .
     8837   END.
     8838   ELSE
     8839       ASSIGN
     8840           g-image:HIDDEN     = YES
     8841           g-image:VISIBLE    = NO
     8842           g-image:SENSITIVE  = NO
     8843           .
     8844   apply "value-changed" to br-dtl in frame d-out-doc.
     8845   END.
     8846   ON CHOOSE OF b-dopinf IN FRAME d-out-doc
