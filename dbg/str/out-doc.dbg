    16259        end.
    16260        when 'спи':U
    16261        then do:
    16262   define variable vss-include-info112 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    16263   do:
    16264     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    16265       (input  v-cntxt-db-num
    16266       ,input  v-cntxt-userid
    16267       ,input  0
    16268       ,input  'actn_write-off_add-back-date':U
    16269       ,input  'object':U
    16270       ,input  t-doc.host-code
    16271       ,input  t-doc.obj-type
    16272       ,input  t-doc.obj-code
    16273       ,input  0
