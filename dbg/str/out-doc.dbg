     2972       PROCEDURE cr-rvs-doc :
     2973         define input  parameter parparentproc as   handle              no-undo .
     2974         define input  parameter p-doc-code    like ub.trn-doc.doc-code no-undo .
     2975         tr:
     2976         do transaction
     2977         on error  undo, return error substitute( "&1 (cr-rvs-doc). &2&3&4", vss-include-info21, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2978         on stop   undo, return error substitute( "&1 (cr-rvs-doc). stop", vss-include-info21 )
     2979         on endkey undo, return error substitute( "&1 (cr-rvs-doc). endkey", vss-include-info21 )
     2980         :
     2981   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2982     define variable v-cntxt-db-num        as integer   no-undo .
     2983     define variable v-cntxt-userid        as character no-undo .
     2984     define variable v-cntxt-level         as character no-undo .
     2985     define variable v-cntxt-host-code-obj as integer   no-undo .
     2986     define variable v-cntxt-obj-type      as character no-undo .
     2987     define variable v-cntxt-obj-code      as integer   no-undo .
     2988     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2989     define variable v-cntxt-is-admin      as logical   no-undo .
     2990   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2991     run mainmenu_getcntxt in parparentproc
     2992       (output v-cntxt-db-num
     2993       ,output v-cntxt-userid
     2994       ,output v-cntxt-level
     2995       ,output v-cntxt-host-code-obj
     2996       ,output v-cntxt-obj-type
     2997       ,output v-cntxt-obj-code
     2998       ,output v-cntxt-db-num-obj
     2999       ,output v-cntxt-is-admin
     3000       ) .
     3001           define buffer buf_trn-doc    for ub.trn-doc .
     3002           define buffer buf_doc-line   for ub.doc-line .
     3003           define buffer buf_goods      for ub.goods .
     3004           define buffer buf_rvs-doc    for ub.rvs-doc .
     3005           define buffer cur_shift-obj  for ub.shift-obj.
     3006           define buffer prev_shift-obj for ub.shift-obj.
     3007           define buffer prev_rvs-doc   for ub.rvs-doc.
     3008           define buffer prev_icnt-doc  for ub.icnt-doc.
     3009           define buffer buf_doc-pl     for ub.doc-pl.
     3010           define variable is-petrolium       as logical   no-undo.
     3011           define variable is-pieces          as logical   no-undo.
     3012           define variable v-ptrl-without-rvs as character no-undo .
     3013           define variable v-attr-type        as character no-undo .
     3014           define variable v-ptrl-avail       as logical   no-undo .
     3015           define variable v-doc-pl-avail     as logical   no-undo .
     3016           define variable v-today            as date      no-undo.
     3017           define variable varlog             as logical   no-undo .
     3018           find first buf_trn-doc
     3019             where buf_trn-doc.doc-code = p-doc-code
     3020             .
     3021   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3022   do:
     3023     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3024       (input  v-cntxt-db-num
     3025       ,input  v-cntxt-userid
     3026       ,input  0
     3027       ,input  'actn_rvs-on-doc_cr-revision':U
     3028       ,input  'object':U
     3029       ,input  buf_trn-doc.host-code
     3030       ,input  buf_trn-doc.obj-type
     3031       ,input  buf_trn-doc.obj-code
     3032       ,input  0
     3033       ,input  0
     3034       ,input  0
     3035       ,input  true
     3036       ,output varlog
     3037       ) no-error .
     3038   end.
     3039           if varlog <> yes then do:
     3040             return error return-value .
     3041           end.
     3042           find first buf_rvs-doc no-lock
     3043             where buf_rvs-doc.out-code = buf_trn-doc.doc-code
     3044             no-error.
     3045           if available buf_rvs-doc then do:
     3046             message "Прототипы документов сверки уже созданы." skip
     3047                     "Можно задавать кол-ва по приборам."       skip
     3048             view-as alert-box error.
     3049             return error.
     3050           end.
     3051           find first cur_shift-obj
     3052             where cur_shift-obj.obj-type = buf_trn-doc.obj-type
     3053               and cur_shift-obj.obj-code = buf_trn-doc.obj-code
     3054               and cur_shift-obj.status_  = 'тек':U
     3055               use-index pi no-lock no-error .
     3056           if not available cur_shift-obj then do:
     3057             message "Нет открытой смены на объекте " buf_trn-doc.obj-type
     3058                                                     buf_trn-doc.obj-code
     3059             view-as alert-box error.
