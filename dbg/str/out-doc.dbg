     8868   ON CHOOSE OF b-notes-line IN FRAME d-out-doc
     8869   DO:
     8870     define variable v-ps as character no-undo.
     8871   define variable  p-type     as character no-undo .
     8872   if not available t-doc then return .
     8873   if not available ub.goods then return .
     8874       run lineattr-value (
     8875         input   t-doc.doc-code ,
     8876         input   ub.goods.gds-code ,
     8877         input   'flora_ps':U,
     8878         output  v-ps ,
     8879         output  p-type      )
     8880       .
     8881   run gbl/d-prompt.w (
     8882           'title=':u + "Изменение атрибутов строки документа" + '\':u
     8883         + 'text1=':u + "Примечание по позиции: " + ub.goods.gds-name + '\':u
     8884         + 'format=' + "x(1000)" + '\':u
     8885         + 'type=' + "edit" + '\':u
     8886         + 'fillin_row=2\':u
     8887         + 'fillin_col=4\':u
     8888         + 'fillin_width=60\':u
     8889         + 'fillin_height=5\':u
     8890         + 'max-chars=1000\':u
     8891         + 'readonly=' + (if pardoc-mode = 'ИЗМЕНЕНИЕ':U then 'no':u else 'yes':u) + '\':u
     8892         , input-output v-ps
     8893         ) no-error.
     8894     if caps(return-value) = "TRUE"  then do:
     8895     if pardoc-mode = 'ИЗМЕНЕНИЕ':U then do:
     8896       if not error-status :error then do:
     8897         run  lineattr-write (
     8898           input   t-doc.doc-code ,
     8899           input   ub.goods.gds-code ,
     8900           input   'flora_ps':U,
     8901           input   v-ps )
     8902         .
     8903       end.
     8904     end.
     8905   end.
     8906   apply "value-changed" to br-dtl in frame d-out-doc.
     8907   END.
     8908   ON CHOOSE OF b-parts IN FRAME d-out-doc
     8909   DO:
     8910       define variable varloc-prt-rec as recid no-undo.
     8911     if not available ub.doc-line then do:
     8912       message "Неправильный выбор строки - партии недоступны." view-as alert-box.
     8913       return no-apply.
     8914     end.
     8915     assign
     8916       varloc-prt-rec = recid( ub.doc-line )
     8917     .
     8918     run local-parts in this-procedure no-error.
     8919     if error-status :error then do:
     8920        message
     8921          vss-workfile vss-revision vss-description skip
     8922          error-status :get-message(1) skip
     8923          return-value skip
     8924          ""
     8925          view-as alert-box error
     8926        .
     8927        return no-apply.
     8928     end.
     8929     if t-doc.ext-doc-type = 'ev':U
     8930     then do :
     8931       run local-cur in this-procedure (input 4) no-error.
     8932       if error-status :error then return .
     8933     end .
     8934     run ui-on in this-procedure ( input "line" ) .
     8935     apply "ENTRY":U to br-dtl in frame d-out-doc.
     8936     reposition br-dtl to recid varloc-prt-rec no-error .
     8937     if error-status :error then do: reposition br-dtl to row 1 no-error. end.
     8938   END.
     8939   ON CHOOSE OF b-prt IN FRAME d-out-doc
     8940   DO:
     8941     if not available ub.gds-dtl then do:
     8942     message "Неправильный выбор строки - шкала недоступна.".
     8943     return no-apply.
     8944   end.
     8945   if pardoc-mode <> 'ПРОСМОТР':U then do:
     8946     run check-rate no-error.
     8947     if error-status :error then return no-apply.
     8948   end.
     8949   run set-work-mode-prt no-error.
     8950   if error-status :error then return no-apply.
     8951   if pardoc-mode = 'ПРОСМОТР':U then do:
     8952     find first ub.doc-line where ub.doc-line.doc-code  = ub.gds-dtl.doc-code  and
     8953                               ub.doc-line.artic     = ub.gds-dtl.artic     and
     8954                               ub.doc-line.prod-type = ub.gds-dtl.prod-type and
     8955                               ub.doc-line.prod-code = ub.gds-dtl.prod-code no-lock.
     8956   end.
     8957   else do:
     8958     find first ub.doc-line where ub.doc-line.doc-code  = ub.gds-dtl.doc-code  and
     8959                               ub.doc-line.artic     = ub.gds-dtl.artic     and
     8960                               ub.doc-line.prod-type = ub.gds-dtl.prod-type and
     8961                               ub.doc-line.prod-code = ub.gds-dtl.prod-code .
     8962   end.
     8963   prt-rec = recid(ub.doc-line).
     8964   find first ub.goods where ub.goods.artic     = ub.gds-dtl.artic     and
     8965                          ub.goods.prod-type = ub.gds-dtl.prod-type and
     8966                          ub.goods.prod-code = ub.gds-dtl.prod-code no-lock.
     8967   if lookup( string(t-doc.reason-code), v-reasons-for-return) > 0
     8968   and t-doc.ext-doc-type = 'ee':U
     8969   then do :
     8970     run str/out-add.p (parparentproc,
     8971                    recid(t-doc),
     8972                    recid(ub.doc-line),
     8973                    recid(ub.gds-dtl),
     8974                    recid (ub.goods),
     8975                    work-mode + chr(4) + "return",
     8976                    ?) no-error.
     8977     if error-status :error then return no-apply.
     8978   end.
     8979   else do :
     8980     run str/out-add.p (parparentproc,
     8981                    recid(t-doc),
     8982                    recid(ub.doc-line),
     8983                    recid(ub.gds-dtl),
     8984                    recid (ub.goods),
     8985                    work-mode,
     8986                    ?) no-error.
     8987     if error-status :error then return no-apply.
     8988   end.
     8989   if varprt-mode = 'ШКАЛА':U then run ui-on ("line").
     8990   apply "entry" to br-dtl in frame d-out-doc .
     8991   reposition br-dtl to recid prt-rec no-error.
     8992   END.
     8993   ON CHOOSE OF b-re-price IN FRAME d-out-doc
     8994   DO:
