     7734   DEFINE QUERY br-dtl FOR
     7735         ub.doc-line,
     7736         ub.gds-dtl,
     7737         ub.gds-prt,
     7738         ub.goods,
     7739         ub.bar-code SCROLLING.
     7740   DEFINE BROWSE br-dtl
     7741     QUERY br-dtl DISPLAY
     7742     get-mark(BUFFER ub.gds-dtl)                       column-label '*'  format "x(1)"
     7743     ub.doc-line.line-num                       column-label 'П/П'  format ">>>>>9"
     7744     ub.bar-code.b-code                       column-label 'Бар-код'  format "99999999999"
     7745     ub.gds-dtl.artic                       column-label 'Артикул'
     7746     (if ub.gds-prt.node-name <> '_Пустая шкала':U and ub.gds-prt.upper-code <> ub.goods.prt-root then ub.goods.gds-name + ' - ' + ub.gds-prt.f-name else ub.goods.gds-name)     @ v-gds-name      column-label 'Имя '  format "x(150)"
     7747     ub.gds-dtl.doc-qnty                       column-label 'По документу'  format ">>>,>>>,>>9.999"
     7748     ub.gds-dtl.fact-qnty                       column-label 'Факт'  format ">>>,>>>,>>9.999"
     7749     ub.goods.unit-base                       column-label 'Изм'  format "x(3)"
     7750     ub.gds-dtl.price-base                       column-label 'Цена (вал.)'
     7751     ub.gds-dtl.ov                      column-label '' format "+/-"
     7752     (ub.gds-dtl.price-base * ub.gds-dtl.fact-qnty)                      column-label 'Сумма (вал.)' format "->>,>>>,>>>,>>9.99"
     7753     (ub.gds-dtl.discnt-base * ub.gds-dtl.fact-qnty)                      column-label 'Скидка (вал.)' format "->>,>>>,>>>,>>9.99"
     7754     ((ub.gds-dtl.price-base - ub.gds-dtl.discnt-base) * ub.gds-dtl.fact-qnty)                      column-label 'Итого (вал.).' format "->>,>>>,>>>,>>9.99"
     7755     ub.gds-dtl.discnt-pc                      column-label 'Скидка %' format "->>>9.99"
     7756     ub.gds-dtl.price-rubl                      column-label 'Цена (руб.)'
     7757     (ub.gds-dtl.price-rubl * ub.gds-dtl.fact-qnty)                      column-label 'Сумма (руб.)' format "->,>>>,>>>,>>>,>>9.99"
     7758     (ub.gds-dtl.discnt-rubl * ub.gds-dtl.fact-qnty)                      column-label 'Скидка (руб.)' format "->,>>>,>>>,>>>,>>9.99"
     7759     ((ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl) * ub.gds-dtl.fact-qnty)                      column-label 'Итого (руб.)' format "->,>>>,>>>,>>>,>>9.99"
     7760     (if ub.gds-prt.node-name = '_Пустая шкала':U then '-' else if ub.gds-prt.upper-code = ub.goods.prt-root then '-------------------' else ub.gds-prt.f-name)                      column-label 'Признак' format "x(30)"
     7761     get-kg-fact-qnty(  buffer ub.gds-dtl )    @ d-kg-fact-qnty  column-label 'Факт, кг' format ">>>,>>>,>>9.999":U
     7762     get-kg-sale-base(  buffer ub.gds-dtl )    @ d-kg-price-base column-label 'Цена за кг (вал.)' format "->>,>>>,>>>,>>9.999":U
     7763     get-kg-sale-rubl(  buffer ub.gds-dtl )    @ d-kg-price-rubl column-label 'Цена за кг (руб.)' format "->,>>>,>>>,>>>,>>9.999":U
