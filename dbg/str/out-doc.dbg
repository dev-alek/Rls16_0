    14085   procedure diasize_add_browse :
    14086     define input  parameter p-browse-type   as character no-undo .
    14087     define input  parameter p-browse-handle as handle    no-undo .
    14088     define buffer buf_temp-browse-handle for temp-browse-handle .
    14089     do
    14090     on error undo, return error return-value
    14091     :
    14092       assign
    14093         v-diasize-browse-number = v-diasize-browse-number + 1
    14094       .
    14095       create buf_temp-browse-handle .
    14096       assign
    14097         buf_temp-browse-handle.browse-type   = p-browse-type
    14098         buf_temp-browse-handle.browse-number = v-diasize-browse-number
    14099         buf_temp-browse-handle.browse-handle = p-browse-handle
    14100       .
