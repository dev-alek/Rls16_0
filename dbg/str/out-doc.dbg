    16283   define variable vss-include-info113 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    16284   do:
    16285     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    16286       (input  v-cntxt-db-num
    16287       ,input  v-cntxt-userid
    16288       ,input  0
    16289       ,input  'actn_inventory_add-back-date':U
    16290       ,input  'object':U
