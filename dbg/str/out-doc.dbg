    14246   procedure get-context :
    14247      define output parameter p-db-num as integer          no-undo.
    14248      define output parameter p-user-id as character        no-undo.
    14249      define variable v-login               as character    no-undo.
    14250      define buffer buf_sys-ctrl    for ub.sys-ctrl .
    14251      define buffer buf_user-login  for ub.user-login .
    14252      do
    14253      on error undo, return error
    14254      :
    14255            FIND FIRST buf_sys-ctrl no-lock.
    14256            ASSIGN
    14257               v-login = USERID("ub")
    14258               p-db-num = buf_sys-ctrl.db-num
    14259            .
    14260            FIND FIRST buf_user-login
    14261                 WHERE buf_user-login.db-num = p-db-num
    14262                   AND buf_user-login.user-login = v-login
    14263                 no-lock
    14264                 no-error
    14265                 .
    14266            IF AVAILABLE buf_user-login
    14267            THEN DO:
    14268               assign
    14269                  p-user-id = buf_user-login.user-id
    14270               .
    14271            END.
    14272      end.
    14273   end procedure.
    14274       run diasize_init in this-procedure .
    14275   define variable vss-include-info95 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14276   on ' ' of t-doc.fact-date in frame d-out-doc
