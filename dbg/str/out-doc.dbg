    16208       ,input  t-doc.obj-type
    16209       ,input  t-doc.obj-code
    16210       ,input  0
    16211       ,input  0
    16212       ,input  0
    16213       ,input  true
    16214       ,output varlog
    16215       )  .
    16216   end.
    16217        end.
    16218        when 'рас':U
    16219        then do:
    16220   define variable vss-include-info110 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    16221   do:
    16222     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    16223       (input  v-cntxt-db-num
    16224       ,input  v-cntxt-userid
    16225       ,input  0
    16226       ,input  'actn_expense_add-back-date':U
    16227       ,input  'object':U
    16228       ,input  t-doc.host-code
    16229       ,input  t-doc.obj-type
    16230       ,input  t-doc.obj-code
