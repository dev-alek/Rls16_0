     2161   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2162   procedure fact-bc:
     2163   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
     2164   define variable g-log       as logical              no-undo.
     2165   define variable varnum      as integer              no-undo.
