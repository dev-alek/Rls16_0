      827   define variable mWaitFramStopTimeOut        as logical     no-undo.
      828   define variable mWaitFramStartProc          as datetime-tz no-undo.
      829   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      830   define button B-WaitFramStop auto-end-key
      831        label "Стоп"
      832        size 10 by 1 tooltip "Остоновить процесс".
      833   define button B-viewProcInfo
      834        label "Информация"
      835        size 15 by 1 tooltip "Информация о процесс".
      836   define frame waitfram
      837     v-waitfram-action01 format "x(72)" no-label skip
      838     v-waitfram-action02 format "x(72)" no-label skip
      839     v-waitfram-action03 format "x(72)" no-label skip
      840     B-viewProcInfo
      841     B-WaitFramStop at row 4 col 30
      842     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      843     .
      844   define new global shared variable mBatchMode as logical no-undo init ?.
      845   define variable mFramBachModHandle as handle no-undo.
      846   mFramBachModHandle = frame waitfram:handle.
      847   define variable mFameOldVis as logical no-undo.
      848   define variable mVisCUrentVin as logical no-undo.
      849   if session:batch-mode
      850   then
      851      mBatchMode = yes.
      852   if mBatchMode = ? then do:
      853     mVisCUrentVin = current-window:visible.
      854     mFameOldVis = mFramBachModHandle:visible.
      855     mFramBachModHandle:visible  = yes.
      856     mBatchMode = mFramBachModHandle:visible ne yes.
      857     mFramBachModHandle:visible = mFameOldVis.
      858     current-window:visible = mVisCUrentVin.
      859   end.
      860    if  log-manager:logfile-name ne ?
      861     then DO:
      862         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      863         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      864         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      865     end.
      866   on choose of B-WaitFramStop in frame waitfram
      867   do:
      868     mWaitFramStop = yes.
      869     mWaitFramStopUser = yes.
      870   end.
      871   function waitfram-check-timeout returns logical():
      872      define variable vtime as int64 no-undo.
      873      if mWaitFramStopTimeOut
      874      then
      875         return yes.
      876      vtime = ( now - mWaitFramStartProc ) / 1000 .
      877      if     mWaitFramTimeOut ne ?
      878         and mWaitFramTimeOut ne 0
      879         and mWaitFramTimeOut lt vtime
      880      then do:
      881         mWaitFramStopTimeOut = yes.
      882      end.
      883      return mWaitFramStopTimeOut.
      884   end.
      885   procedure waitfram-hide :
      886     if not session:batch-mode
      887     then do
      888     on error undo, return error return-value
      889     :
      890       pause 0 before-hide .
      891       if not mBatchMode then
      892         hide frame waitfram .
      893     end.
      894   end procedure.
      895   procedure waitfram-show :
      896     define input  parameter p-message as character no-undo .
      897     define variable v-left-margin as integer   no-undo .
      898     if not session:batch-mode
      899     then do
      900     on error undo, return error return-value
      901     :
      902       if length(p-message) <= 70 then do:
      903         assign
      904           v-left-margin = integer((70 - length(p-message)) / 2)
      905         .
      906         assign
      907           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      908         .
      909         assign
      910           v-waitfram-action01 = " "
      911           v-waitfram-action02 = " "
      912                                    + fill(" ", v-left-margin)
      913                                    + p-message
      914           v-waitfram-action03 = " "
      915         .
      916       end.
      917       else do:
      918         define variable vRindex1 as integer no-undo.
      919         define variable vRindex2 as integer no-undo.
      920         vRindex1 = r-index(p-message," ",70).
      921         if vRindex1 = 0
      922         then
      923            vRindex1 = 70.
      924         if length(p-message)  <= vRindex1 + 70 then do:
      925           assign
      926             v-waitfram-action01 = " "
      927             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      928             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      929           .
      930         end.
      931         else do:
      932           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      933           if vRindex2 <= vRindex1
      934           then
      935              vRindex2 = vRindex1 + 70.
      936           assign
      937             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      938             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      939             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      940           .
      941         end.
      942       end.
      943       B-viewProcInfo:visible   in frame waitfram = no.
      944       B-viewProcInfo:sensitive in frame waitfram = no.
      945       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      946       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      947       if  (   mWaitFramView
      948          or  mWaitProcEvent)
      949          and not mBatchMode
      950       then
      951          display
      952             v-waitfram-action01 skip
      953             v-waitfram-action02 skip
      954             v-waitfram-action03 skip
      955          with frame waitfram .
      956     end.
      957   end procedure.
      958      procedure waitfram-show-this:
      959         define input  parameter iInterval as int64 no-undo.
      960         define variable vtime as int64 no-undo.
      961         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      962         mWaitFramInterval = iInterval.
      963         run waitfram-show (substitute("&1&2 &3&4" ,
      964                                       mWaitFramTextBeg ,
      965                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      966                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      967                                       mWaitFramTextEnd
      968                                      )
      969                           ).
      970      end.
      971      procedure WaitFramRunPause:
      972         define input  parameter iInterval as dec no-undo.
      973         define variable vStart  as datetime-tz no-undo.
      974         define variable vend    as datetime-tz no-undo.
      975         define variable vint as int64 no-undo.
      976         define variable vOk as logical no-undo.
      977         vStart = now.
      978         vend   = vStart.
      979         publish "WaitFramPause" (iInterval,output vOk).
      980         vend   =  now.
      981         vint = vend - vStart.
      982         vint = iInterval - vint / 1000.
      983         if     not mWaitFramStop
      984            and (   vint > 0
      985                 or (    not vOk
      986                     and iInterval eq ?
      987                     )
      988                 )
      989         then
      990            run waitfram-show-this (iInterval).
      991         vend   =  now.
      992         vint = vend - vStart.
      993         vint = iInterval - vint / 1000.
      994         if     not mWaitFramStop
      995            and vint > 0
      996         then do:
      997            run gbl/pause.p (vint * 1000).
      998         end.
      999         if iInterval ne ?
     1000         then
     1001            publish "WaitFramStop".
     1002         waitfram-check-timeout().
     1003      end.
     1004      procedure WaitFramWaitFor:
     1005         define input  parameter iInterval as dec no-undo.
     1006         assign
     1007            mWaitFramStartProc   = now
     1008            mWaitFramStopUser    = no
     1009            mWaitFramStopTimeOut = no
     1010         .
     1011         block-wait:
     1012         do while not mWaitFramStop:
     1013            run WaitFramRunPause (iInterval).
     1014            if  waitfram-check-timeout()
     1015            then do:
     1016               leave block-wait.
     1017            end.
     1018         end.
     1019         run waitfram-hide.
     1020      end.
     1021   procedure waitfram-join :
     1022     define input  parameter p-line-1  as character no-undo .
     1023     define input  parameter p-line-2  as character no-undo .
     1024     define input  parameter p-line-3  as character no-undo .
     1025     define output parameter p-message as character no-undo .
     1026     do
     1027     on error undo, return error return-value
     1028     :
     1029       assign
     1030         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1031                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1032                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1033       .
     1034     end.
     1035   end procedure.
     1036   function waitfram-join-function returns character
     1037     (input p-line-1 as character
     1038     ,input p-line-2 as character
     1039     ,input p-line-3 as character
     1040     ).
     1041     define variable v-message as character no-undo .
     1042     run waitfram-join in this-procedure
     1043       (input  p-line-1
     1044       ,input  p-line-2
     1045       ,input  p-line-3
     1046       ,output v-message
     1047       ) .
     1048     return v-message .
     1049   end function .
     1050   procedure check-contract-code :
     1051   define input  parameter parmode           as   character                     no-undo.
     1052   define input  parameter parhost-code      like ub.trn-doc.host-code          no-undo.
     1053   define input  parameter parcli-type       like ub.trn-doc.cli-type           no-undo.
     1054   define input  parameter parcli-code       like ub.trn-doc.cli-code           no-undo.
     1055   define input  parameter parframe-value    as   character                     no-undo.
     1056   define input  parameter parmenu-handle    as   handle                        no-undo.
     1057   define input  parameter parobj-date       as   date                          no-undo.
     1058   define input  parameter partype-contract  as   character                     no-undo .
     1059   define output parameter parcontract-code  like ub.contract.contract-code     no-undo.
     1060   define buffer bf_contract     for ub.contract.
     1061   define buffer bf-oth_contract for ub.contract.
     1062   define variable varrid-list as character no-undo.
     1063   define variable varrecid    as recid     no-undo.
     1064   define variable varlog      as logical   no-undo.
     1065   define variable var-args    as char      no-undo.
     1066   define variable var-ext-doc-type as char     no-undo.
     1067   do on error undo, return error return-value :
     1068   var-args = parmode.
     1069   parmode = entry(1, parmode).
     1070   run cntrcode-get-arg-val(var-args, "doc-type", output var-ext-doc-type).
     1071   if partype-contract = "" or partype-contract = ? then
     1072      partype-contract = 'при':U .
     1073   assign
     1074     parcontract-code = 0
     1075   .
     1076   if parmode = "input":u
     1077   then do:
     1078     if parframe-value = ""
     1079     then do:
     1080       assign
     1081         parcontract-code = 0
     1082       .
     1083     end.
     1084     else do:
     1085       find first bf_contract no-lock
     1086         where bf_contract.host-code         = parhost-code
     1087           and bf_contract.cli-type          = parcli-type
     1088           and bf_contract.cli-code          = parcli-code
     1089           and bf_contract.contract-prn-code = parframe-value
     1090         no-error.
     1091       if available bf_contract
     1092       then do:
     1093         find first bf-oth_contract no-lock
     1094           where bf-oth_contract.host-code          = parhost-code
     1095             and bf-oth_contract.contract-prn-code  = parframe-value
     1096             and bf-oth_contract.cli-type           = parcli-type
     1097             and bf-oth_contract.cli-code           = parcli-code
     1098             and rowid(bf_contract)                 <> rowid(bf-oth_contract)
     1099           no-error .
     1100         if available bf-oth_contract
     1101         then do:
     1102           message
     1103             "На фирме " parhost-code skip
     1104             "у контрагента" parcli-type parcli-code skip
     1105             "имеются два контракта с номером" parframe-value skip
     1106           view-as alert-box .
     1107         end.
     1108         else do:
     1109           assign
     1110             parcontract-code = bf_contract.contract-code
     1111           .
     1112         end.
     1113       end.
     1114     end.
     1115   end.
     1116   if parmode <> "input":u
     1117   or parcontract-code = 0
     1118   then do:
     1119     run str/cont-all.w (input parmenu-handle,
     1120                     input parhost-code,
     1121                     input "b-sel",
     1122                     input if var-ext-doc-type = 'ee':U then 'фирма':U else "firm-curr" ,
     1123                     input parcli-type,
     1124                     input parcli-code,
     1125                     input ?,
     1126                     input ?,
     1127                     input "current":u,
     1128                     input partype-contract,
     1129                     input-output varrid-list ) no-error.
     1130     if error-status:error then do:
     1131       message "Ошибка при вызове справочника договоров." skip
     1132               return-value                skip
     1133               error-status:get-message(1) skip
     1134               error-status:get-message(2)
     1135       view-as alert-box error.
     1136       return error.
     1137     end.
     1138     assign
     1139       varrecid = integer(entry(1, varrid-list)).
     1140     find first bf_contract where recid(bf_contract) = varrecid no-lock no-error.
     1141     if available bf_contract then do:
     1142       assign
     1143         parcontract-code = bf_contract.contract-code.
     1144     end.
     1145   end.
     1146   if parcontract-code <> 0
     1147   then do:
     1148     if (bf_contract.status_ = 'зкр':U or
     1149         (bf_contract.contract-date-end <> ? and bf_contract.contract-date-end < parobj-date)) then do:
     1150       if lookup(var-ext-doc-type, 'ep,re,rs,ee') = 0
     1151       then do:
     1152           assign
     1153             varlog = no.
     1154           message "Договор с номером " bf_contract.contract-prn-code " закрыт." skip
     1155           view-as alert-box.
     1156           assign
     1157             parcontract-code = 0
     1158           .
     1159       end.
     1160     end.
     1161     if bf_contract.contract-date-beg > parobj-date then do:
     1162       assign
     1163         varlog = no.
     1164       message "Дата открытия договора " bf_contract.contract-date-beg " . Договор с номером " bf_contract.contract-prn-code " еще не открыт." skip
     1165       view-as alert-box.
     1166       assign
     1167         parcontract-code = 0
     1168       .
     1169     end.
     1170     if parcontract-code <> 0
     1171     then do:
     1172       if bf_contract.cli-type <> parcli-type
     1173       or bf_contract.cli-code <> parcli-code
     1174       then do:
     1175          message "По договору " bf_contract.contract-code
     1176                  ( if bf_contract.doc-type =  'при':U
     1177                    then " поставщиком является "
     1178                    else " покупателем является " )
     1179                  bf_contract.cli-type " " bf_contract.cli-code " ." skip
     1180                  "По документу контрагент " parcli-type " " parcli-code " ." skip
     1181          view-as alert-box error.
     1182          assign
     1183            parcontract-code = 0.
     1184       end.
     1185       if parcontract-code <> ? then do:
     1186         if not ( bf_contract.doc-type =  'при':U or bf_contract.doc-type =  'рас':U ) then do:
     1187           message "Контракт имеет недопустимый тип." view-as alert-box.
     1188           assign
     1189             parcontract-code = 0.
     1190         end.
     1191       end.
     1192     end.
     1193   end.
     1194   end.
     1195   end procedure.
     1196   procedure cntrcode-get-arg-val:
     1197       def input param p-args as char no-undo.
     1198       def input param p-key as char no-undo.
     1199       def output param p-val as char no-undo.
     1200       def var i as int no-undo.
     1201       def var nums as int no-undo.
     1202       def var key-val as char no-undo.
     1203       nums = num-entries(p-args).
     1204       do i = 1 to nums:
     1205           key-val = entry(i, p-args).
     1206           if key-val begins (p-key + "=") then do:
     1207               p-val = entry(2, key-val, "=").
     1208               return.
     1209           end.
     1210       end.
     1211       p-val = "".
     1212   end.
     1213   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
