    13529     define buffer buf_temp-diasize-handle for temp-diasize-handle .
    13530     define buffer buf_temp-browse-handle  for temp-browse-handle .
    13531     if p-change-value > 0
    13532     then do:
    13533       if frame d-out-doc :width + p-change-value >
    13534           session :width-chars
    13535       then do:
    13536         assign
    13537           p-change-value = session :width-chars - frame d-out-doc :width
    13538         .
    13539         if p-change-value <= 0
    13540         then do:
    13541           run diasize_position-resize-button in this-procedure .
    13542           return .
    13543         end.
    13544       end.
    13545     end.
    13546     if p-change-value < 0
    13547     then do:
    13548       if frame d-out-doc :width + p-change-value < v-diasize-orig-frame-width
    13549       then do:
    13550         assign
    13551           p-change-value = v-diasize-orig-frame-width
    13552                          - frame d-out-doc :width
    13553         .
    13554         if p-change-value >= 0
    13555         then do:
    13556           run diasize_position-resize-button in this-procedure .
    13557           return .
    13558         end.
    13559       end.
    13560     end.
    13561     if p-change-value >= 0
    13562     then do:
    13563       assign
    13564         v-change-sign = 1
    13565       .
    13566     end.
    13567     else do:
    13568       assign
    13569         v-change-sign = -1
    13570       .
    13571     end.
    13572     assign
    13573       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
    13574     .
    13575     if p-change-value = 0
    13576     then do:
    13577       run diasize_position-resize-button in this-procedure .
    13578       return .
    13579     end.
