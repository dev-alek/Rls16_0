    16326   PROCEDURE copy-lst :
    16327   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
    16328     define input parameter parcash-pay like ub.sysconf.cash-pay no-undo.
    16329     define input parameter pardoc-prt  as   logical             no-undo.
    16330     define input parameter table for tt-gds-list.
    16331     define input parameter p-marks-par as character no-undo .
    16332     define variable chg-qnty    like ub.gds-dtl.doc-qnty    no-undo.
    16333     define variable legal-node  like ub.gds-prt.node-code   no-undo.
    16334     define variable varcount    as   integer             no-undo.
    16335     define variable varchg-qnty like ub.gds-dtl.doc-qnty no-undo.
    16336     define variable vardoc-qnty like ub.gds-dtl.doc-qnty no-undo.
    16337     define variable v-is-petrol as   logical             no-undo.
    16338     define variable v-is-pieces as   logical             no-undo.
    16339     define variable var-kg-qnty like ub.gds-dtl.doc-qnty no-undo.
    16340     define variable rr-inv-line as   recid               no-undo.
    16341     define variable v-tech-marks-qnty like gds-dtl.doc-qnty no-undo.
    16342     define buffer cpl_goods    for ub.goods.
    16343     define buffer cpl_gds-obj  for ub.gds-obj.
    16344     define buffer cpl_prt-obj  for ub.prt-obj.
    16345     define buffer cpl_trn-doc  for ub.trn-doc.
    16346     define buffer cpl_gds-prt  for ub.gds-prt.
    16347     define buffer cpl_gds-dtl  for ub.gds-dtl.
    16348     define buffer cpl_doc-line for ub.doc-line.
    16349     define buffer cpl_inv-line for ub.inv-line.
    16350     define buffer buf_marking-lines for ub.marking-lines .
    16351   c-l:
    16352   do on error undo c-l, return error :
    16353   find first cpl_trn-doc where cpl_trn-doc.doc-code = pardoc-code.
    16354   r-l:
    16355   for each tt-gds-list,
    16356        each cpl_goods where cpl_goods.prod-type = tt-gds-list.prod-type
    16357                         and cpl_goods.prod-code = tt-gds-list.prod-code
    16358                         and cpl_goods.artic     = tt-gds-list.artic     no-lock :
    16359     assign varcount = varcount + 1.
    16360     if varcount modulo 100 = 0 then do:
    16361       run waitfram-show in this-procedure (input "ЖДИТЕ.  Обработано строк списка : " + string (varcount)).
    16362     end.
    16363     if p-marks-par = "tech-marks"
    16364     then do :
    16365       assign
    16366         v-tech-marks-qnty = 0
    16367       .
    16368       for each buf_marking-lines no-lock where buf_marking-lines.gds-code = cpl_goods.gds-code
    16369                                            and buf_marking-lines.obj-type = cpl_trn-doc.obj-type
    16370                                            and buf_marking-lines.obj-code = cpl_trn-doc.obj-code
    16371                                            and buf_marking-lines.out-code = 'free-zone':U
    16372                                            and buf_marking-lines.mark begins 'tech_':U
    16373                                            :
    16374         assign
    16375           v-tech-marks-qnty = v-tech-marks-qnty + 1
    16376         .
    16377       end .
    16378       if v-tech-marks-qnty = 0 then next r-l.
    16379     end .
    16380     find cpl_gds-obj where cpl_gds-obj.obj-type  = cpl_trn-doc.obj-type
    16381                        and cpl_gds-obj.obj-code  = cpl_trn-doc.obj-code
    16382                        and cpl_gds-obj.prod-type = cpl_goods.prod-type
    16383                        and cpl_gds-obj.prod-code = cpl_goods.prod-code
    16384                        and cpl_gds-obj.artic     = cpl_goods.artic    no-lock no-error.
    16385     if not available cpl_gds-obj or cpl_gds-obj.fact-qnty = 0 then next r-l.
    16386   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crdoclno in g#lib-trn
    16387   ( input cpl_trn-doc.doc-code
    16388    ,input cpl_trn-doc.obj-type
    16389    ,input cpl_trn-doc.obj-code
    16390    ,input cpl_goods.artic
    16391    ,input cpl_goods.prod-type
    16392    ,input cpl_goods.prod-code
    16393    ,input cpl_goods.gds-name
    16394    ,input cpl_goods.prt-root
    16395    ,input ?
    16396    ,input ?
    16397    ,input parcash-pay
    16398     ) no-error .
    16399     if error-status :error then do:
    16400       message
    16401         vss-workfile vss-revision vss-description skip
    16402         "Ошибка при создании строки." skip
    16403         return-value skip
    16404         trim(error-status :get-message(1))
    16405         trim(error-status :get-message(2))
    16406         trim(error-status :get-message(3))
    16407         trim(error-status :get-message(4))
    16408         trim(error-status :get-message(5)) skip
    16409         view-as alert-box error.
    16410       undo c-l, return error return-value.
    16411     end.
    16412     if return-value = "next" then do:
    16413       next r-l.
    16414     end.
    16415     find first cpl_doc-line where cpl_doc-line.doc-code  = cpl_trn-doc.doc-code and
    16416                                   cpl_doc-line.artic     = cpl_goods.artic      and
    16417                                   cpl_doc-line.prod-type = cpl_goods.prod-type  and
    16418                                   cpl_doc-line.prod-code = cpl_goods.prod-code .
    16419     find first cpl_gds-prt where cpl_gds-prt.upper-code = cpl_goods.prt-root no-lock.
    16420     for each cpl_prt-obj where cpl_prt-obj.obj-type  = cpl_trn-doc.obj-type
    16421                            and cpl_prt-obj.obj-code  = cpl_trn-doc.obj-code
    16422                            and cpl_prt-obj.artic     = cpl_goods.artic
    16423                            and cpl_prt-obj.prod-type = cpl_goods.prod-type
    16424                            and cpl_prt-obj.prod-code = cpl_goods.prod-code
    16425                            and cpl_prt-obj.fact-qnty > 0              no-lock :
    16426       if (pardoc-prt and not can-find (first cpl_gds-prt where cpl_gds-prt.upper-code = cpl_prt-obj.prt-code no-lock))
    16427           or
    16428          (not pardoc-prt and cpl_prt-obj.prt-code = cpl_gds-prt.node-code)
    16429           then do:
    16430         assign legal-node = cpl_prt-obj.prt-code.
    16431   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
    16432     ( input cpl_trn-doc.obj-code
    16433      ,input cpl_trn-doc.obj-type
    16434      ,input cpl_trn-doc.doc-code
    16435      ,input cpl_goods.artic
    16436      ,input cpl_goods.prod-code
    16437      ,input cpl_goods.prod-type
    16438      ,input legal-node
    16439      ,input yes
    16440     ) no-error .
    16441         if error-status :error then do:
    16442            return error substitute("Ошибка при создании признака &1.", return-value).
    16443         end.
    16444         find first cpl_gds-dtl where cpl_gds-dtl.doc-code  = cpl_trn-doc.doc-code and
    16445                                      cpl_gds-dtl.artic     = cpl_goods.artic      and
    16446                                      cpl_gds-dtl.prod-code = cpl_goods.prod-code  and
    16447                                      cpl_gds-dtl.prod-type = cpl_goods.prod-type  and
