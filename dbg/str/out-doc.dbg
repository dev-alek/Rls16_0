    20548     , input t-doc.exch-code
    20549     , input t-doc.vat-type
    20550     , input t-doc.doc-code
    20551     , input t-doc.discnt-type:sensitive in frame d-out-doc
    20552     , input input frame d-out-doc t-doc.discnt-pc
    20553     , input input frame d-out-doc t-doc.agnt
    20554     , input input frame d-out-doc t-doc.boss
    20555     , input input frame d-out-doc t-doc.wrkr
    20556     , input input frame d-out-doc t-doc.base-rate
    20557     , input input frame d-out-doc t-doc.base-scale
    20558     , input ub.sysconf.cash-pay
    20559     , input ub.sysconf.base-code
    20560     , input-output table t-d-b-doc-line
    20561     , input-output table t-d-b-gds-dtl
    20562     , input-output table t-d-b-parts
    20563     , input yes
    20564     , input yes
    20565     , input yes
    20566     , input yes
    20567     ) no-error.
    20568     if error-status :error then do:
    20569       message "Ошибка при копировании документа." skip
    20570               return-value skip
    20571               error-status:get-message(1) skip
    20572               error-status:get-message(2) skip
    20573               error-status:get-message(3) skip
    20574       view-as alert-box error.
    20575       return error.
    20576     end.
    20577     run str/crdocpl.p
    20578       ( input t-doc.doc-code
    20579        ,input ?
    20580        ,input "dens_doc-line":U
    20581       ) no-error .
    20582     if error-status :error then do:
    20583       message
    20584         "Ошибка при копировании документа (создание информации по складским местам)." skip
    20585         return-value skip
    20586         error-status:get-message(1) skip
    20587         error-status:get-message(2) skip
    20588         error-status:get-message(3) skip
    20589         view-as alert-box error.
    20590       return error .
    20591     end.
    20592     run gbl/calc-trn.p (input parparentproc, input recid(t-doc)) no-error.
    20593     if error-status :error then do:
    20594       message
    20595         "Ошибка при копировании документа (расчет шапки документа)." skip
    20596         return-value skip
    20597         error-status:get-message(1) skip
    20598         error-status:get-message(2) skip
    20599         error-status:get-message(3) skip
    20600         view-as alert-box error.
    20601       return error .
    20602     end.
    20603   end.
    20604   for each t-d-b-doc-line :
    20605     delete t-d-b-doc-line.
    20606   end.
    20607   for each t-d-b-gds-dtl :
    20608     delete t-d-b-gds-dtl.
    20609   end.
    20610   for each t-d-b-parts :
