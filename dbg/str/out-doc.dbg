     1293   .
     1294   procedure cli-grplib-get-sort-name :
     1295   do
     1296   on error undo, return error
     1297   :
     1298   define input parameter p-node-code  as integer      no-undo.
     1299   define output parameter p-sort-name as character    no-undo.
     1300       define variable v-upper-code    as integer           no-undo.
     1301       define buffer buf_cli-grp       for ub.cli-grp.
     1302       define buffer buf_upper_cli-grp for ub.cli-grp.
     1303       find first buf_cli-grp no-lock
     1304            where buf_cli-grp.node-code = p-node-code
     1305       no-error.
     1306       if not available buf_cli-grp
     1307       then do:
     1308           undo, return error "cli-grplib-get-sort-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
     1309       end.
     1310       assign
     1311           p-sort-name  = ""
     1312           v-upper-code = 1
     1313       .
     1314       do while buf_cli-grp.upper-code <> 0
     1315       on error undo, return error "cli-grplib-get-sort-name: Ошибка составления полного имени группы"
     1316       :
     1317           assign
     1318               p-sort-name  = buf_cli-grp.node-name
     1319                            + (if p-sort-name <> "" then chr(2) else "")
     1320                            + p-sort-name
     1321               v-upper-code = buf_cli-grp.upper-code
     1322           .
     1323           find first buf_cli-grp no-lock
     1324                where buf_cli-grp.node-code = v-upper-code
     1325           no-error.
     1326           if not available buf_cli-grp
     1327           then do:
     1328               undo, return error "cli-grplib-get-sort-name: Не найдена группа клиентов с кодом "
     1329                                   + string( v-upper-code )
     1330                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1331           end.
     1332       end.
     1333   end.
     1334   end procedure.
     1335   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1336   procedure cli-grplib-get-full-name :
     1337      define input parameter  p-node-code  as integer      no-undo.
     1338      define output parameter p-full-name as character    no-undo.
     1339   do
     1340   on error undo, return error
     1341   :
     1342       define variable v-upper-code    as integer           no-undo.
     1343       define buffer buf_cli-grp       for ub.cli-grp.
     1344       define buffer buf_upper_cli-grp for ub.cli-grp.
     1345       find first buf_cli-grp no-lock
     1346            where buf_cli-grp.node-code = p-node-code
     1347       no-error.
     1348       if not available buf_cli-grp
     1349       then do:
     1350           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
     1351       end.
     1352       assign
     1353           p-full-name  = ""
     1354           v-upper-code = 1
     1355       .
     1356       do while buf_cli-grp.upper-code <> 0
     1357       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1358       :
     1359           assign
     1360               p-full-name  = buf_cli-grp.node-name
     1361                            + (if p-full-name <> "" then chr(47) else "")
     1362                            + p-full-name
     1363               v-upper-code = buf_cli-grp.upper-code
     1364           .
     1365           find first buf_cli-grp no-lock
     1366                where buf_cli-grp.node-code = v-upper-code
     1367           no-error.
     1368           if not available buf_cli-grp
     1369           then do:
     1370               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
     1371                                   + string( v-upper-code )
     1372                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1373           end.
     1374       end.
     1375       assign
     1376       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1377       .
     1378   end.
     1379   end .
     1380   procedure cgrplib-get-node-from-full-name :
     1381   define input parameter p-full-name as character no-undo .
     1382   define output parameter p-node-code as integer no-undo .
     1383   define variable v-ii as integer no-undo .
     1384   define variable v-upper-code as integer no-undo .
     1385   define variable v-root-code as integer no-undo .
     1386   define variable v-entry as character no-undo .
     1387   define buffer buf_cli-grp       for ub.cli-grp.
     1388   do
     1389   on error undo, return error
     1390   :
     1391     find first buf_cli-grp no-lock
     1392         where buf_cli-grp.upper-code = 0
     1393     no-error .
     1394     if not available buf_cli-grp
     1395     then do:
     1396         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
     1397     end.
     1398     else do:
     1399       assign
     1400       v-root-code = buf_cli-grp.node-code
     1401       .
     1402     end.
     1403     v-upper-code = v-root-code.
     1404     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1405       assign
     1406       v-entry = entry(v-ii, p-full-name, chr(47)).
     1407       if v-entry = '' then leave.
     1408       find first buf_cli-grp no-lock where
     1409                 buf_cli-grp.node-name = v-entry
     1410             and buf_cli-grp.upper-code = v-upper-code
     1411             no-error.
     1412       if not available buf_cli-grp then do:
     1413         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1414       end.
     1415       else do:
     1416         p-node-code = buf_cli-grp.node-code.
     1417         v-upper-code = buf_cli-grp.node-code.
     1418       end.
     1419     end.
     1420   end.
     1421   end .
     1422   procedure cgrplib-get-root-code :
     1423   do
     1424   on error undo, return error
     1425   :
     1426   define output parameter p-root-code as integer      no-undo.
     1427       define buffer buf_cli-grp       for ub.cli-grp.
     1428       find first buf_cli-grp no-lock
     1429           where buf_cli-grp.upper-code = 0
     1430       no-error .
     1431       if not available buf_cli-grp
     1432       then do:
     1433           undo, return error .
     1434       end.
     1435       else do:
     1436           assign
     1437               p-root-code = buf_cli-grp.node-code
     1438           .
     1439       end.
     1440   end.
     1441   end procedure.
     1442   procedure cgrplib-find-grp-by-full-name :
     1443   do
     1444   on error undo, return error
     1445   :
     1446   define input parameter p-search-name  as character    no-undo.
     1447   define input parameter p-fill-path    as logical      no-undo.
     1448       define variable v-upper-code    as integer          no-undo.
     1449       define variable v-not-found     as logical init yes no-undo.
     1450       define variable v-counter       as integer           no-undo.
     1451       define variable v-level         as integer           no-undo.
     1452       define variable v-full-name     as character         no-undo.
     1453       define variable v-sort-name     as character         no-undo.
     1454       define buffer buf_cli-grp       for ub.cli-grp.
     1455       assign
     1456           p-search-name = replace( p-search-name, chr(47), chr(2) )
     1457       .
     1458       run cgrplib-get-root-code ( output v-upper-code ) no-error .
     1459       if error-status :error
     1460       then do:
     1461           undo, return error "cgrplib-expand-name: Ошибка при поиске корневого узла".
     1462       end.
     1463       assign
     1464           v-full-name  = ""
     1465           v-level      = num-entries( p-search-name, chr(2) )
     1466       .
     1467       for each temp_cgrplib_found-grp
     1468       :
     1469           delete temp_cgrplib_found-grp.
     1470       end.
     1471       start-name-analyze:
     1472       do v-counter = 1 to v-level
     1473       :
     1474           if v-counter < v-level
     1475           then do:
     1476               find first buf_cli-grp no-lock
     1477                    where buf_cli-grp.upper-code = v-upper-code
     1478                      and buf_cli-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     1479               no-error .
     1480               if not available buf_cli-grp
     1481               then do:
     1482                   assign
     1483                       v-full-name  = p-search-name
     1484                       v-sort-name  = p-search-name
     1485                   .
     1486                   return error "cgrplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1487               end.
     1488               else do:
     1489                   assign
     1490                       v-full-name = v-full-name + (if v-full-name = "" then "" else chr(47) )         + buf_cli-grp.node-name
     1491                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_cli-grp.node-name
     1492                       v-upper-code = buf_cli-grp.node-code
     1493                   .
     1494                   if p-fill-path = yes
     1495                   then do:
     1496                       create temp_cgrplib_found-grp.
     1497                       assign
     1498                           temp_cgrplib_found-grp.full-name = v-full-name + chr(47)
     1499                           temp_cgrplib_found-grp.sort-name = v-sort-name
     1500                           temp_cgrplib_found-grp.node-code = v-upper-code
     1501                           temp_cgrplib_found-grp.level     = v-counter
     1502                       .
     1503                   end.
     1504               end.
     1505           end.
     1506           else do:
     1507               for each buf_cli-grp no-lock
     1508                  where buf_cli-grp.upper-code = v-upper-code
     1509                    and buf_cli-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     1510               :
     1511                   assign
     1512                       v-not-found = no
     1513                   .
     1514                   create temp_cgrplib_found-grp.
     1515                   assign
     1516                       temp_cgrplib_found-grp.full-name = v-full-name
     1517                                                           + ( if v-full-name = "" then "" else chr(47) )
     1518                                                           + buf_cli-grp.node-name + chr(47)
     1519                       temp_cgrplib_found-grp.sort-name = v-sort-name
     1520                                                           + ( if v-sort-name = "" then "" else chr(2) )
     1521                                                           + buf_cli-grp.node-name
     1522                       temp_cgrplib_found-grp.node-code = buf_cli-grp.node-code
     1523                       temp_cgrplib_found-grp.level     = v-level
     1524                   .
     1525               end.
     1526               if v-not-found = yes
     1527               then do:
     1528                   assign
     1529                       v-full-name  = p-search-name
     1530                       v-sort-name  = p-search-name
     1531                   .
     1532                   for each temp_cgrplib_found-grp
     1533                   :
     1534                       delete temp_cgrplib_found-grp.
     1535                   end.
     1536                   return error "cgrplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1537               end.
     1538           end.
     1539       end.
     1540   end.
     1541   end procedure.
     1542   procedure cgrplib-find-all-subgroup :
     1543   do
     1544   on error undo, return error
     1545   :
     1546   define input parameter p-start-node-code    as integer      no-undo.
     1547   define input parameter p-terminal-only      as logical      no-undo.
     1548       define variable v-start-full-name   as character     no-undo.
     1549       define variable v-start-sort-name   as character     no-undo.
     1550       define variable v-not-found         as logical       no-undo.
     1551       define variable v-is-terminal       as logical       no-undo.
     1552       define variable v-d-pcnt            as decimal       no-undo.
     1553       define buffer buf_cli-grp           for ub.cli-grp.
     1554       create temp_cfound-result-nodelist.
     1555       assign
     1556           temp_cfound-result-nodelist.node-code = p-start-node-code
     1557           temp_cfound-result-nodelist.processed = no
     1558       .
     1559       run cli-grplib-get-full-name in this-procedure (
     1560             input p-start-node-code
     1561           , output v-start-full-name
     1562       ).
     1563       run cli-grplib-get-sort-name in this-procedure (
     1564             input p-start-node-code
     1565           , output v-start-sort-name
     1566       ).
     1567       process-nodes:
     1568       do while yes
     1569       :
     1570           find first temp_cfound-result-nodelist
     1571                where temp_cfound-result-nodelist.node-code = p-start-node-code
     1572           .
     1573           assign
     1574               temp_cfound-result-nodelist.processed = yes
     1575           .
     1576           for each buf_cli-grp no-lock
     1577              where buf_cli-grp.upper-code = p-start-node-code
     1578           on error undo, return error
     1579           :
     1580               run cgrplib-is-terminal in this-procedure (
     1581                     input buf_cli-grp.node-code
     1582                   , output v-is-terminal
     1583               ).
     1584               if v-is-terminal = yes
     1585               then do:
     1586                   create temp_cgrplib_found-grp.
     1587                   assign
     1588                       temp_cgrplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1589                                                           chr(47) + buf_cli-grp.node-name + chr(47)
     1590                       temp_cgrplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1591                                                           chr(2) + buf_cli-grp.node-name + chr(2)
     1592                       temp_cgrplib_found-grp.node-code   = buf_cli-grp.node-code
     1593                       temp_cgrplib_found-grp.is-terminal = yes
     1594                   .
     1595                  run cgrplib-get-pcnt-value in this-procedure ( input temp_cgrplib_found-grp.node-code , output v-d-pcnt) no-error .
     1596                  if not error-status:error then do:
     1597                    temp_cgrplib_found-grp.d-pcnt = v-d-pcnt.
     1598                  end.
     1599                  else do:
     1600                    temp_cgrplib_found-grp.d-pcnt = ?.
     1601                  end.
     1602               end.
     1603               else do:
     1604                   create temp_cfound-result-nodelist.
     1605                   assign
     1606                       temp_cfound-result-nodelist.node-code = buf_cli-grp.node-code
     1607                       temp_cfound-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     1608                                                              chr(47) + buf_cli-grp.node-name + chr(47)
     1609                       temp_cfound-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     1610                                                              chr(2) + buf_cli-grp.node-name + chr(2)
     1611                       temp_cfound-result-nodelist.processed = no
     1612                   .
     1613                   if p-terminal-only = no
     1614                   then do:
     1615                       create temp_cgrplib_found-grp.
     1616                       assign
     1617                           temp_cgrplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1618                                                               chr(47) + buf_cli-grp.node-name + chr(47)
     1619                           temp_cgrplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1620                                                               chr(2) + buf_cli-grp.node-name + chr(2)
     1621                           temp_cgrplib_found-grp.node-code   = buf_cli-grp.node-code
     1622                           temp_cgrplib_found-grp.is-terminal = no
     1623                       .
     1624                   end.
     1625               end.
     1626           end.
     1627           find first temp_cfound-result-nodelist
     1628                where temp_cfound-result-nodelist.processed = no
     1629           no-error.
     1630           if not available temp_cfound-result-nodelist
     1631           then do:
     1632               leave process-nodes.
     1633           end.
     1634           else do:
     1635               assign
     1636                   p-start-node-code = temp_cfound-result-nodelist.node-code
     1637                   v-start-full-name = temp_cfound-result-nodelist.full-name
     1638                   v-start-sort-name = temp_cfound-result-nodelist.sort-name
     1639               .
     1640           end.
     1641       end.
     1642   end.
     1643   end procedure.
     1644   procedure cgrplib-expand-name :
     1645   do
     1646   on error undo, return error
     1647   :
     1648   define input parameter p-start-name as character        no-undo.
     1649   define output parameter p-end-name  as character        no-undo.
     1650       define variable v-is-terminal     as logical           no-undo.
     1651       define buffer buf_temp_cgrplib_found-grp     for temp_cgrplib_found-grp.
     1652       run cgrplib-find-grp-by-full-name in this-procedure (
     1653             input p-start-name
     1654           , input no
     1655       ) no-error.
     1656       run cgrplib-get-max-substring in this-procedure (
     1657                   input length( p-start-name )
     1658                 , output p-end-name
     1659       ) no-error .
     1660       if error-status :error
     1661       then do:
     1662           assign
     1663               p-end-name = ""
     1664           .
     1665       end.
     1666       else do:
     1667           find first temp_cgrplib_found-grp
     1668               where temp_cgrplib_found-grp.full-name = p-end-name
     1669           no-error.
     1670           if available temp_cgrplib_found-grp
     1671           then do:
     1672               find first buf_temp_cgrplib_found-grp
     1673                   where buf_temp_cgrplib_found-grp.full-name begins p-end-name
     1674                   and recid( buf_temp_cgrplib_found-grp ) <> recid( temp_cgrplib_found-grp )
     1675               no-error.
     1676               if not available buf_temp_cgrplib_found-grp
     1677               then do:
     1678                   run cgrplib-is-terminal in this-procedure (
     1679                       input temp_cgrplib_found-grp.node-code
     1680                       , output v-is-terminal
     1681                   ).
     1682               end.
     1683           end.
     1684       end.
     1685   end.
     1686   end procedure.
     1687   procedure cgrplib-get-max-substring :
     1688   do
     1689   on error undo, return error
     1690   :
     1691   define input parameter p-min-substring-length   as integer      no-undo.
     1692   define output parameter p-substring             as character    no-undo.
     1693           define variable v-char-counter  as integer           no-undo.
     1694           define variable v-current-char  as character         no-undo.
     1695           define variable v-names-counter  as integer           no-undo.
     1696           define variable v-base-string   as character         no-undo.
     1697           assign
     1698               v-char-counter  = p-min-substring-length
     1699           .
     1700           find first temp_cgrplib_found-grp no-error.
     1701           if not available temp_cgrplib_found-grp
     1702           then do:
     1703               undo, return error "cgrplib-get-max-substring: Нет строк для вычисления общей подстроки".
     1704           end.
     1705           else do:
     1706               assign
     1707                   v-base-string = temp_cgrplib_found-grp.full-name
     1708               .
     1709               counter-block:
     1710               do while yes
     1711               on error undo, return error "cgrplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     1712               :
     1713                   assign
     1714                       v-char-counter  = v-char-counter + 1
     1715                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     1716                       v-names-counter = 0
     1717                   .
     1718                   compare-block:
     1719                   for each temp_cgrplib_found-grp
     1720                   :
     1721                       assign
     1722                           v-names-counter = v-names-counter + 1
     1723                       .
     1724                       if v-names-counter = 1
     1725                       then do:
     1726                           next compare-block.
     1727                       end.
     1728                       if substring( temp_cgrplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     1729                       then do:
     1730                           leave counter-block.
     1731                       end.
     1732                   end.
     1733                   if v-names-counter = 1
     1734                   then do:
     1735                       assign
     1736                           p-substring = v-base-string
     1737                       .
     1738                       return.
     1739                   end.
     1740               end.
     1741               assign
     1742                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     1743               .
     1744           end.
     1745   end.
     1746   end procedure.
     1747   procedure cgrplib-is-terminal :
     1748   do
     1749   on error undo, return error "Ошибка процедуры cgrplib-is-terminal"
     1750   :
     1751   define input parameter p-node-code      as integer      no-undo.
     1752   define output parameter p-is-terminal   as logical      no-undo.
     1753       define buffer buf_cli-grp       for ub.cli-grp.
     1754       find first buf_cli-grp no-lock
     1755           where buf_cli-grp.upper-code = p-node-code
     1756       no-error .
     1757       if not available buf_cli-grp
     1758       then do:
     1759           assign
     1760               p-is-terminal = yes
     1761           .
     1762       end.
     1763       else do:
     1764           assign
     1765               p-is-terminal = no
     1766           .
     1767       end.
     1768   end.
     1769   end procedure.
     1770   procedure cgrplib-have-clients :
     1771   do
     1772   on error undo, return error
     1773   :
     1774   define input parameter p-node-code      as integer      no-undo.
     1775   define output parameter p-have-clients   as logical      no-undo.
     1776       define buffer buf_clients         for ub.clients.
     1777       find first buf_clients no-lock
     1778            where buf_clients.grp-code = p-node-code
     1779       no-error .
     1780       if available buf_clients
     1781       then do:
     1782           assign
     1783               p-have-clients = yes
     1784           .
     1785       end.
     1786       else do:
     1787           assign
     1788               p-have-clients = no
     1789           .
     1790       end.
     1791   end.
     1792   end procedure.
     1793   procedure cgrplib-find-by-substring :
     1794   do
     1795   on error undo, return error
     1796   :
     1797   define input parameter p-start-code         as integer      no-undo.
     1798   define input parameter p-full-search-string as character    no-undo.
     1799   define output parameter p-found-code        as integer      no-undo.
     1800   define output parameter p-full-name         as character    no-undo.
     1801       define variable v-start-code     as integer           no-undo.
     1802       define variable v-found          as logical  init no  no-undo.
     1803       define buffer buf_cli-grp       for ub.cli-grp.
     1804       search-grp:
     1805       for each buf_cli-grp no-lock
     1806           where buf_cli-grp.node-code > p-start-code
     1807       :
     1808           if index( buf_cli-grp.node-name, p-full-search-string ) <> 0
     1809           then do:
     1810               assign
     1811                   p-found-code = buf_cli-grp.node-code
     1812                   v-found      = yes
     1813               .
     1814               run cli-grplib-get-full-name in this-procedure (
     1815                     input p-found-code
     1816                   , output p-full-name
     1817               ) no-error .
     1818               if error-status :error
     1819               then do:
     1820                   undo, return error "cgrplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1821               end.
     1822               leave search-grp.
     1823           end.
     1824       end.
     1825       if v-found = yes
     1826       then do:
     1827       end.
     1828       else do:
     1829           assign
     1830               p-full-name  = ""
     1831               p-found-code = 0
     1832           .
     1833       end.
     1834   end.
     1835   end procedure.
     1836   procedure cgrplib-analyze-grp-name :
     1837   do
     1838   on error undo, return error
     1839   :
     1840   define input parameter p-grp-name       as character            no-undo.
     1841   define input parameter p-upper-code     as integer              no-undo.
     1842   define output parameter p-error-message as character init ""    no-undo.
     1843       define variable v-char-list     as character    no-undo.
     1844       define variable v-char-counter  as integer      no-undo.
     1845       define variable v-full-name     as character    no-undo.
     1846       if p-grp-name = "" then do:
     1847           assign
     1848               p-error-message = "Название группы не может быть пустым.".
     1849           .
     1850       end.
     1851       else do:
     1852           assign
     1853               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1854           .
     1855           do v-char-counter = 1 to num-entries( v-char-list )
     1856           :
     1857               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1858               then do:
     1859                   assign
     1860                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1861                   .
     1862                   return.
     1863               end.
     1864           end.
     1865           run cli-grplib-get-full-name in this-procedure (
     1866                 input p-upper-code
     1867               , output v-full-name
     1868           ) no-error .
     1869           if error-status :error
     1870           then do:
     1871               undo, return error "cgrplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1872           end.
     1873           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
     1874           then do:
     1875               assign
     1876                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
     1877               .
     1878           end.
     1879       end.
     1880   end.
     1881   end procedure.
     1882   procedure cgrplib-get-lvl-num :
     1883   define input parameter p-node-code  as integer      no-undo.
     1884   define output parameter p-lvl-num   as integer      no-undo.
     1885       define variable v-full-name    as character    no-undo.
     1886   do
     1887   on error undo, return error
     1888   :
     1889       run cli-grplib-get-full-name in this-procedure (
     1890             input p-node-code
     1891           , output v-full-name
     1892       ).
     1893       assign
     1894           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     1895       .
     1896       if p-lvl-num = -1
     1897       then do:
     1898           assign
     1899               p-lvl-num = 0
     1900           .
     1901       end.
     1902   end.
     1903   end procedure.
     1904   PROCEDURE cgrplib-get-pcnt-value :
     1905   DEFINE INPUT PARAMETER p-node-code AS INTEGER NO-UNDO.
     1906   DEFINE output PARAMETER p-pcnt-value AS DECIMAL NO-UNDO.
     1907   define buffer buf_dis-grp-rule for ub.dis-grp-rule.
     1908   define buffer buf_dis-rule for ub.dis-rule.
     1909   find first buf_dis-grp-rule no-lock where
     1910             buf_dis-grp-rule.classif-type = 'cli-grp':U
     1911         and buf_dis-grp-rule.node-code = p-node-code
     1912         and buf_dis-grp-rule.host-code = 0
     1913         and buf_dis-grp-rule.obj-type = '':U
     1914         and buf_dis-grp-rule.obj-code = 0
     1915         and buf_dis-grp-rule.pos-type = '-':U
     1916         and buf_dis-grp-rule.discnt-role = 'cli-grp-pcnt':U no-error.
     1917   if available buf_dis-grp-rule then do:
     1918     find first buf_dis-rule no-lock where
     1919               buf_dis-rule.rule-num = buf_dis-grp-rule.rule-num no-error.
     1920     if available buf_dis-rule then do:
     1921       assign
     1922       p-pcnt-value        = buf_dis-rule.discnt-value.
     1923       .
     1924     end.
     1925   end.
     1926   END PROCEDURE.
