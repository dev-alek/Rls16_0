    14891   end.
    14892   define variable vss-include-info100 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14893   DEF VAR cur-clmn-numbr-dtl as INT EXTENT 23 no-undo.
    14894   DEF VAR varmvibr-dtl       as INT no-undo.
    14895   DEF VAR varmvjbr-dtl       as INT no-undo.
    14896   DEF VAR varmvkbr-dtl       as INT no-undo.
    14897   DEF VAR varmvlbr-dtl       as INT no-undo.
    14898   DEF VAR move-elementbr-dtl as INT no-undo.
    14899   def var jjbr-dtl           as int no-undo.
    14900   do varmvibr-dtl = 1 to EXTENT(cur-clmn-numbr-dtl):
    14901     ASSIGN cur-clmn-numbr-dtl[varmvibr-dtl] = varmvibr-dtl.
    14902   END.
    14903   RUN start-mv-clmnbr-dtl.
    14904   PROCEDURE start-mv-clmnbr-dtl:
    14905   def var old-session as logical no-undo.
    14906      old-session = SESSION:IMMEDIATE-DISPLAY.
    14907      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
    14908      SESSION:IMMEDIATE-DISPLAY = old-session.
    14909   END.
    14910   ON ctrl-cursor-right OF BROWSE br-dtl do:
    14911     RUN re-move-clmnbr-dtl ( 4, 23).
    14912   END.
    14913   ON ctrl-cursor-left OF BROWSE br-dtl do:
    14914     RUN re-move-clmnbr-dtl (23, 4).
    14915   END.
    14916   PROCEDURE re-move-clmnbr-dtl:
    14917     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
    14918     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
    14919     DO varmvibr-dtl = 1 TO EXTENT(cur-clmn-numbr-dtl):
    14920       if cur-clmn-numbr-dtl[varmvibr-dtl] = source-column THEN cur-clmn-numbr-dtl[varmvibr-dtl] = -1.
    14921     END.
    14922     if br-dtl:MOVE-COLUMN(source-column, target-column) IN FRAME d-out-doc then.
    14923     if source-column > target-column THEN
    14924     DO varmvjbr-dtl = source-column - 1 to target-column BY -1:
    14925       DO varmvibr-dtl = 1 TO EXTENT(cur-clmn-numbr-dtl):
    14926           if cur-clmn-numbr-dtl[varmvibr-dtl] = varmvjbr-dtl THEN DO:
    14927             cur-clmn-numbr-dtl[varmvibr-dtl] = cur-clmn-numbr-dtl[varmvibr-dtl] + 1.
    14928           END.
    14929       END.
    14930     END.
    14931     ELSE
    14932     DO varmvjbr-dtl = source-column + 1 to target-column:
    14933       DO varmvibr-dtl = 1 TO EXTENT(cur-clmn-numbr-dtl):
    14934         if cur-clmn-numbr-dtl[varmvibr-dtl] = varmvjbr-dtl THEN DO:
    14935           cur-clmn-numbr-dtl[varmvibr-dtl] = cur-clmn-numbr-dtl[varmvibr-dtl] - 1.
    14936         END.
    14937       END.
    14938     END.
    14939     DO varmvibr-dtl = 1 TO EXTENT(cur-clmn-numbr-dtl):
    14940       if cur-clmn-numbr-dtl[varmvibr-dtl] = -1 THEN cur-clmn-numbr-dtl[varmvibr-dtl] = target-column.
    14941     END.
    14942   END PROCEDURE.
    14943   PROCEDURE ch-clmnbr-dtl:
    14944     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
    14945     if cur-clmn-loc <= 4 then do:
    14946       return .
    14947     end.
    14948     DO varmvibr-dtl = 1 TO EXTENT(cur-clmn-numbr-dtl):
    14949       if cur-clmn-numbr-dtl[varmvibr-dtl] = cur-clmn-loc THEN move-elementbr-dtl = varmvibr-dtl.
    14950     END.
    14951     RUN re-move-clmnbr-dtl (cur-clmn-loc, 4).
    14952   END PROCEDURE.
    14953   PROCEDURE mv-brw-defaultbr-dtl:
    14954   def var old-session as logical no-undo.
    14955     old-session = SESSION:IMMEDIATE-DISPLAY.
    14956     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
    14957     do varmvlbr-dtl = 4 to EXTENT(cur-clmn-numbr-dtl):
    14958       RUN re-move-clmnbr-dtl (cur-clmn-numbr-dtl[varmvlbr-dtl], varmvlbr-dtl).
    14959     END.
    14960     RUN start-mv-clmnbr-dtl.
    14961     SESSION:IMMEDIATE-DISPLAY = old-session.
    14962   END PROCEDURE.
