    16180             ,output v-value-date
    16181             ,output v-value-decimal
    16182             ,output v-value-integer
    16183             ,output v-back-date
    16184             ,output v-back-date-type
    16185             ,INPUT-OUTPUT table-handle v-tth
    16186             ) no-error .
    16187             if error-status :error  then v-back-date = false .
    16188             delete object v-tth no-error.
    16189       if v-back-date <> true then do:
    16190         message "Запрещено работать задним числом !" view-as alert-box information .
    16191         display t-doc.fact-date with frame d-out-doc.
    16192         return error.
    16193       end.
    16194      varlog = no.
    16195      case t-doc.doc-type
    16196      :
    16197        when 'при':U
    16198        then do:
    16199   define variable vss-include-info109 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    16200   do:
    16201     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    16202       (input  v-cntxt-db-num
    16203       ,input  v-cntxt-userid
    16204       ,input  0
    16205       ,input  'actn_income_add-back-date':U
    16206       ,input  'object':U
