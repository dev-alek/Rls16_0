     7287   FUNCTION title-mode RETURNS CHARACTER
     7288     ( INPUT pmode as character ) :
     7289   DEFINE VARIABLE ptitle-mode as character no-undo.
     7290   CASE ENTRY(1, pmode) :
     7291     when 'ДОБАВЛЕНИЕ':U then ptitle-mode = "ДОБАВЛЕНИЕ".
     7292     when 'ИЗМЕНЕНИЕ':U  then ptitle-mode = "ИЗМЕНЕНИЕ".
     7293     when 'ПРОСМОТР':U  then ptitle-mode = "ПРОСМОТР".
     7294   END CASE.
     7295     RETURN ptitle-mode.
     7296   END FUNCTION.
