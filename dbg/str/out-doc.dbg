    14358           (output v-curr-sv-date
    14359           ) .
    14360       end.
    14361       if v-curr-sv-date <> ?
    14362       then do:
    14363         assign
    14364           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
    14365         .
    14366         assign
    14367           self :screen-value = string(v-new-sv-date) .
    14368         .
    14369       end.
    14370     end.
    14371     return no-apply .
    14372   end.
    14373   on ctrl-e of t-doc.fact-date in frame d-out-doc
    14374   do:
    14375     if (can-query (self, "sensitive")
    14376        and
    14377        self :sensitive = true
    14378        )
