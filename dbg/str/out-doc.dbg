    20431   PROCEDURE copy-bb-list :
    20432   define buffer tdb_doc-line    for ub.doc-line.
    20433   define buffer tdb_gds-dtl     for ub.gds-dtl.
    20434   define buffer tdb_parts       for ub.parts .
    20435   define buffer buf_parts       for ub.parts .
    20436   define buffer buf-cli_clients for ub.clients  .
    20437   define variable v-num as integer initial 1 no-undo.
    20438   define variable  v-fact-qnty  as decimal   no-undo .
    20439   define variable  v-cli-qnty   as decimal   no-undo .
    20440   define variable  v-root-node  as integer   no-undo .
    20441   define buffer doc_parts for ub.parts  .
    20442   for each t-d-b-doc-line :
    20443     delete t-d-b-doc-line.
    20444   end.
    20445   for each t-d-b-gds-dtl :
    20446     delete t-d-b-gds-dtl.
    20447   end.
    20448   for each t-d-b-parts :
    20449     delete t-d-b-parts.
    20450   end.
    20451    for each bb-list :
    20452           for each doc_parts no-lock where
    20453                    doc_parts.in-code    = bb-list.in-code and
    20454                    doc_parts.part-code  = bb-list.part-code and
    20455                    doc_parts.obj-type   = t-doc.obj-type and
    20456                    doc_parts.obj-code   = t-doc.obj-code and
    20457                    doc_parts.artic      = bb-list.artic and
    20458                    doc_parts.prod-type  = bb-list.prod-type and
    20459                    doc_parts.prod-code  = bb-list.prod-code and
    20460                    doc_parts.out-code   = 'free-zone':U
    20461           :
    20462           find first  t-d-b-parts where
    20463                    t-d-b-parts.in-code    = bb-list.in-code and
    20464                    t-d-b-parts.part-code  = bb-list.part-code and
    20465                    t-d-b-parts.obj-type   = t-doc.obj-type and
    20466                    t-d-b-parts.obj-code   = t-doc.obj-code and
    20467                    t-d-b-parts.artic      = bb-list.artic and
    20468                    t-d-b-parts.prod-type  = bb-list.prod-type and
    20469                    t-d-b-parts.prod-code  = bb-list.prod-code and
    20470                    t-d-b-parts.out-code   = t-doc.doc-code no-error .
    20471          if not available t-d-b-parts then do:
    20472             create t-d-b-parts.
    20473             buffer-copy doc_parts to t-d-b-parts
    20474             assign
    20475               t-d-b-parts.out-code   = t-doc.doc-code
    20476             .
    20477          end.
    20478      end.
    20479    end.
    20480     for each t-d-b-parts :
    20481         find first t-d-b-doc-line where
    20482                   t-d-b-doc-line.doc-code  =  t-doc.doc-code and
    20483                   t-d-b-doc-line.artic     =  t-d-b-parts.artic and
    20484                   t-d-b-doc-line.prod-type =  t-d-b-parts.prod-type and
    20485                   t-d-b-doc-line.prod-code =  t-d-b-parts.prod-code no-error .
    20486         if not available t-d-b-doc-line then do:
    20487           create t-d-b-doc-line.
    20488           v-fact-qnty = 0.
    20489           v-cli-qnty  = 0.
    20490         end.
    20491         else do:
    20492           v-fact-qnty = t-d-b-doc-line.fact-qnty.
    20493           v-cli-qnty  = t-d-b-doc-line.cli-qnty.
    20494         end.
    20495         buffer-copy t-d-b-parts except status_ to t-d-b-doc-line
    20496         assign
    20497             t-d-b-doc-line.doc-code   = t-doc.doc-code
    20498             t-d-b-doc-line.doc-qnty   = t-d-b-parts.fact-qnty + v-fact-qnty
    20499             t-d-b-doc-line.fact-qnty  = t-d-b-parts.fact-qnty + v-fact-qnty
    20500             t-d-b-doc-line.cli-qnty   = t-d-b-parts.cli-qnty  + v-cli-qnty
    20501         .
    20502     end.
    20503     for each  t-d-b-doc-line where
    20504                   t-d-b-doc-line.doc-code  =  t-doc.doc-code :
    20505         find first t-d-b-gds-dtl where
    20506                   t-d-b-gds-dtl.doc-code  =  t-doc.doc-code and
    20507                   t-d-b-gds-dtl.artic     =  t-d-b-doc-line.artic and
    20508                   t-d-b-gds-dtl.prod-type =  t-d-b-doc-line.prod-type and
    20509                   t-d-b-gds-dtl.prod-code =  t-d-b-doc-line.prod-code no-error .
    20510         if not available t-d-b-gds-dtl then do:
    20511           create t-d-b-gds-dtl.
    20512         end.
    20513   define variable vss-include-info144 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    20514   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
    20515     (input  t-d-b-doc-line.artic
    20516     ,input  t-d-b-doc-line.prod-type
    20517     ,input  t-d-b-doc-line.prod-code
    20518     ,output v-root-node
    20519     )  .
