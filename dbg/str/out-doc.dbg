     9037   ON row-leave OF br-dtl IN FRAME d-out-doc
     9038   DO:
     9039       define variable var_is-petrol as logical no-undo .
     9040     define variable var_is-pieces as logical no-undo .
     9041     if available ub.gds-dtl  and
     9042        (decimal( ub.gds-dtl.doc-qnty :screen-value in browse br-dtl ) <> ub.gds-dtl.doc-qnty or
     9043         decimal( ub.gds-dtl.fact-qnty :screen-value in browse br-dtl ) <> ub.gds-dtl.fact-qnty ) then do:
     9044   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     9045     (
     9046        input ub.gds-dtl.artic
     9047     ,  input ub.gds-dtl.prod-type
     9048     ,  input ub.gds-dtl.prod-code
     9049     , output var_is-petrol
     9050     , output var_is-pieces
     9051     ) .
     9052       if var_is-petrol = yes and
     9053          var_is-pieces = no
     9054       then do:
     9055         if decimal( ub.gds-dtl.doc-qnty :screen-value in browse br-dtl ) <> ub.gds-dtl.doc-qnty
     9056         then do:
     9057           display ub.gds-dtl.doc-qnty with browse br-dtl .
     9058           message substitute( 'В жидком топливе нельзя редактировать количество.&1'
     9059                           , ( if b-chg :sensitive in frame d-out-doc
     9060                               then substitute( '&1Воспользуйтесь кнопкой "&2".'
     9061                                              , chr(10)
     9062                                              , replace( b-chg :label in frame d-out-doc, "&", "":U )
     9063                                              )
     9064                               else '':U )
     9065                           )
     9066           view-as alert-box error .
     9067         end.
     9068         else do:
     9069           if decimal( ub.gds-dtl.fact-qnty :screen-value in browse br-dtl ) <> ub.gds-dtl.fact-qnty
     9070           then do:
     9071             display ub.gds-dtl.fact-qnty with browse br-dtl .
     9072             message substitute( 'В жидком топливе нельзя редактировать фактическое количество.&1'
     9073                               , ( if b-chg :sensitive in frame d-out-doc
     9074                                   then substitute( '&1Воспользуйтесь кнопкой "&2".'
     9075                                                  , chr(10)
     9076                                                  , replace( b-chg :label in frame d-out-doc, "&", "":U )
     9077                                                  )
     9078                                   else '':U )
     9079                               )
     9080             view-as alert-box error .
     9081           end.
     9082         end.
     9083         return no-apply.
     9084       end.
     9085       find first ub.goods no-lock where
     9086                  ub.goods.artic     = ub.gds-dtl.artic     and
     9087                  ub.goods.prod-type = ub.gds-dtl.prod-type and
     9088                  ub.goods.prod-code = ub.gds-dtl.prod-code .
     9089       find first ub.units no-lock where ub.units.unit-name = ub.goods.unit-base .
     9090       if decimal( ub.gds-dtl.doc-qnty :screen-value in browse br-dtl ) <> ub.gds-dtl.doc-qnty and
     9091           lookup( '2ед':U, ub.units.type ) > 0 then do:
     9092          message "Товар с двумя единицами измерения резервируется через партии." view-as alert-box.
     9093          return no-apply.
     9094       end.
     9095       if decimal( ub.gds-dtl.doc-qnty  :screen-value in browse br-dtl ) <> ub.gds-dtl.doc-qnty  then do:
     9096   if available ub.gds-dtl then do:
     9097       prt-rec = recid(ub.gds-dtl).
     9098       if dec(ub.gds-dtl.doc-qnty:screen-value in browse br-dtl) = ?
     9099          or dec(ub.gds-dtl.doc-qnty:screen-value in browse br-dtl) = 0
     9100       then do:
     9101         message "Не указано количество.".
     9102         disp ub.gds-dtl.doc-qnty with browse br-dtl.
     9103         return no-apply.
     9104       end.
     9105       find ub.units where ub.units.unit-name = ub.goods.unit-base no-lock.
     9106       if lookup('сер':U, ub.units.type) > 0 then do:
     9107          message "В серийном товаре нельзя редактировать количество".
     9108          disp ub.gds-dtl.doc-qnty with browse br-dtl.
     9109          return no-apply.
     9110       end.
     9111       find ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code
     9112                          and ub.doc-line.prod-code = ub.gds-dtl.prod-code
     9113                          and ub.doc-line.prod-type = ub.gds-dtl.prod-type
     9114                          and ub.doc-line.artic         = ub.gds-dtl.artic no-lock no-error.
     9115       find ub.goods where ub.goods.prod-code = ub.gds-dtl.prod-code
     9116                  and ub.goods.prod-type = ub.gds-dtl.prod-type
     9117                  and ub.goods.artic     = ub.gds-dtl.artic no-lock.
     9118       run str/out-add.p (parparentproc,
     9119                      recid(t-doc),
     9120                      recid(ub.doc-line),
     9121                      recid(ub.gds-dtl),
     9122                      recid(ub.goods),
     9123                      "ch-doc-qnty",
     9124                      string(input browse br-dtl ub.gds-dtl.doc-qnty)) no-error.
     9125       if error-status:error then return no-apply.
     9126       if query br-dtl:GET-BUFFER-HANDLE (1):NAME = "gds-dtl" then
     9127           prt-rec = recid(ub.gds-dtl).
     9128       else
     9129           prt-rec = recid(ub.doc-line).
     9130       run ui-on("line").
     9131       reposition br-dtl to recid prt-rec.
     9132   end.
     9133         if v-is-ptrl = "yes":U then do:
     9134           run inv-line_recalc-qty in this-procedure
     9135             ( input ub.gds-dtl.doc-code
     9136             ,input ub.gds-dtl.artic
     9137             ,input ub.gds-dtl.prod-type
     9138             ,input ub.gds-dtl.prod-code
     9139             ,input false
     9140             ,input decimal( ub.gds-dtl.doc-qnty  :screen-value in browse br-dtl )
     9141             ,input decimal( ub.gds-dtl.fact-qnty :screen-value in browse br-dtl )
     9142             ) no-error.
     9143           if error-status :error then do: return no-apply. end.
     9144         end.
     9145       end.
     9146       if decimal( ub.gds-dtl.fact-qnty :screen-value in browse br-dtl ) <> ub.gds-dtl.fact-qnty then do:
     9147   define buffer out-dtl for ub.gds-dtl.
     9148   if available ub.gds-dtl then do:
     9149       prt-rec = recid(ub.gds-dtl).
     9150       if dec(ub.gds-dtl.fact-qnty:screen-value in browse br-dtl) = ?
     9151       then do:
     9152         message "Не указано количество.".
     9153         disp ub.gds-dtl.fact-qnty with browse br-dtl.
     9154         return no-apply.
     9155       end.
     9156       if (can-do ('при,возврат':U, t-doc.doc-type)
     9157          and t-doc.internal
     9158          and ( ub.gds-prt.upper-code = ub.goods.prt-root  or
     9159            can-find (out-dtl where out-dtl.doc-code = t-doc.out-code and
     9160                                                 out-dtl.artic = ub.gds-dtl.artic and
     9161                                                 out-dtl.prod-type = ub.gds-dtl.prod-type and
     9162                                                 out-dtl.prod-code = ub.gds-dtl.prod-code and
     9163                                                 out-dtl.prt-code = ub.gds-dtl.prt-code no-lock))
     9164           or not can-do ('при,возврат':U, t-doc.doc-type)
     9165           or (t-doc.doc-type = 'возврат':U and not t-doc.internal)
     9166           )
     9167           and input browse br-dtl ub.gds-dtl.fact-qnty > ub.gds-dtl.doc-qnty then do:
     9168         message "Фактическое количество товара не может быть больше количества по накладной.".
     9169         disp ub.gds-dtl.fact-qnty with browse br-dtl.
     9170         return no-apply.
     9171       end.
     9172       find ub.units where ub.units.unit-name = ub.goods.unit-base no-lock.
     9173       if lookup('сер':U, ub.units.type) > 0 then do:
     9174          message "В серийном товаре нельзя редактировать количество".
     9175          disp ub.gds-dtl.fact-qnty with browse br-dtl.
     9176          return no-apply.
     9177       end.
     9178       find ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code
     9179                          and ub.doc-line.prod-code = ub.gds-dtl.prod-code
     9180                          and ub.doc-line.prod-type = ub.gds-dtl.prod-type
     9181                          and ub.doc-line.artic         = ub.gds-dtl.artic no-lock no-error.
     9182       find ub.goods where ub.goods.prod-code = ub.gds-dtl.prod-code
     9183                  and ub.goods.prod-type = ub.gds-dtl.prod-type
     9184                  and ub.goods.artic     = ub.gds-dtl.artic no-lock.
     9185       run str/out-add.p (parparentproc,
     9186                      recid(t-doc),
     9187                      recid(ub.doc-line),
     9188                      recid(ub.gds-dtl),
     9189                      recid(ub.goods),
     9190                      "ch-fact-qnty",
     9191                      string(input browse br-dtl ub.gds-dtl.fact-qnty)) no-error.
     9192       if error-status:error then return no-apply.
     9193       if query br-dtl:GET-BUFFER-HANDLE (1):NAME = "gds-dtl" then
     9194           prt-rec = recid(ub.gds-dtl).
     9195       else
     9196           prt-rec = recid(ub.doc-line).
     9197       run ui-on("line").
     9198       reposition br-dtl to recid prt-rec.
     9199   end.
     9200         if v-is-ptrl = "yes":U then do:
     9201           run inv-line_recalc-qty in this-procedure
     9202             ( input ub.gds-dtl.doc-code
     9203             ,input ub.gds-dtl.artic
     9204             ,input ub.gds-dtl.prod-type
     9205             ,input ub.gds-dtl.prod-code
     9206             ,input true
     9207             ,input decimal( ub.gds-dtl.doc-qnty  :screen-value in browse br-dtl )
     9208             ,input decimal( ub.gds-dtl.fact-qnty :screen-value in browse br-dtl )
     9209             ) no-error.
     9210           if error-status :error then do: return no-apply. end.
     9211         end.
     9212       end.
     9213     end.
     9214   END.
     9215   ON LEAVE OF ub.gds-dtl.doc-qnty IN BROWSE br-dtl
     9216   DO:
     9217     define variable vIsExemplarGoods as logical no-undo .
     9218     define variable vGtin     as character no-undo.
     9219     define variable vGtinQnty as integer no-undo.
     9220     define variable varvalue        as character no-undo .
     9221     define variable vartype         as character no-undo .
     9222     define variable v-mark-weight as decimal no-undo .
     9223     define variable v-isweighed as logical no-undo .
     9224     define buffer buf_marking-lines for ub.marking-lines.
     9225     define buffer buf_marking       for ub.marking.
     9226     define buffer buf_goods         for ub.goods.
     9227     if available ub.gds-dtl
     9228     then do :
     9229       find first buf_goods where
     9230             buf_goods.artic     = ub.gds-dtl.artic
     9231         and buf_goods.prod-type = ub.gds-dtl.prod-type
     9232         and buf_goods.prod-code = ub.gds-dtl.prod-code.
     9233       v-isweighed = WghProdVariable(t-doc.obj-type, t-doc.obj-code, buf_goods.gds-code) .
     9234       run isExemplarGoods in this-procedure
     9235            (t-doc.obj-type, t-doc.obj-code, buf_goods.gds-code, output vIsExemplarGoods).
     9236       if v-isweighed
     9237       then do :
     9238         for each buf_marking-lines no-lock where
     9239                  buf_marking-lines.out-code = t-doc.doc-code
     9240              and buf_marking-lines.obj-type = t-doc.obj-type
     9241              and buf_marking-lines.obj-code = t-doc.obj-code
     9242              and buf_marking-lines.gds-code = buf_goods.gds-code
     9243              and buf_marking-lines.doc-level = 1,
     9244             first buf_marking no-lock where
     9245                   buf_marking.mark = buf_marking-lines.mark
     9246         :
     9247           v-mark-weight = v-mark-weight + MarkWeight(buf_marking.mark) .
     9248         end.
     9249         if v-mark-weight > decimal(ub.gds-dtl.doc-qnty:screen-value IN BROWSE br-dtl) then
     9250         do:
     9251           message "Нельзя ввести количество меньше, чем просканировано марок по товару" view-as alert-box.
     9252           ub.gds-dtl.doc-qnty:screen-value IN BROWSE br-dtl = string(v-mark-weight).
     9253           return no-apply.
     9254         end.
     9255       end .
     9256       else
     9257       if vIsExemplarGoods
     9258       then do:
     9259         for each buf_marking-lines no-lock where
     9260                  buf_marking-lines.out-code = t-doc.doc-code
     9261              and buf_marking-lines.obj-type = t-doc.obj-type
     9262              and buf_marking-lines.obj-code = t-doc.obj-code
     9263              and buf_marking-lines.gds-code = buf_goods.gds-code
     9264              and buf_marking-lines.doc-level = 1,
     9265             first buf_marking no-lock where
     9266                   buf_marking.mark = buf_marking-lines.mark
     9267         :
     9268           assign
     9269             vGtin     = getGtinByDM(buf_marking.mark)
     9270             vGtinQnty = vGtinQnty  + getQntyCodeByGtin(vGtin)
     9271           .
     9272         end.
     9273         if vGtinQnty > int(ub.gds-dtl.doc-qnty:screen-value IN BROWSE br-dtl) then
     9274         do:
     9275           message "Нельзя ввести количество меньше, чем просканировано марок по товару" view-as alert-box.
     9276           ub.gds-dtl.doc-qnty:screen-value IN BROWSE br-dtl = string(vGtinQnty).
     9277           return no-apply.
     9278         end.
     9279       end.
     9280     end .
     9281   END.
     9282   ON LEAVE OF t-doc.discnt-pc IN FRAME d-out-doc
     9283   DO:
     9284   if input frame d-out-doc t-doc.discnt-pc <> t-doc.discnt-pc then do:
     9285   if input frame d-out-doc t-doc.discnt-pc = ? then do:
     9286     message "Ошибка. Установлен неизвестный процент скидки."
     9287     view-as alert-box error.
     9288     display t-doc.discnt-pc with frame d-out-doc.
     9289     return no-apply.
     9290   end.
     9291   if available t-doc then do transaction:
     9292     assign
     9293       t-doc.discnt-pc = input frame d-out-doc t-doc.discnt-pc.
     9294     run gbl/calc-trn.p (input parparentproc, input recid(t-doc)) no-error.
     9295     if error-status :error then do:
     9296       undo, return no-apply.
     9297     end.
     9298     run ui-on ("line").
     9299   end.
     9300   end.
     9301   END.
     9302   ON LEAVE OF t-doc.fact-date IN FRAME d-out-doc
     9303   DO:
     9304   define variable v-value-character as character no-undo .
     9305   define variable v-value-date      as date      no-undo .
     9306   define variable v-value-decimal   as decimal   no-undo .
     9307   define variable v-value-integer   as integer   no-undo .
     9308   define variable v-avail-on-date   as logical   no-undo .
     9309   define variable v-avail-on-date-type as character no-undo .
     9310   define variable v-tth             as handle no-undo .
     9311     delete object v-tth no-error.
     9312     run adm/shattri.p (
     9313         input "get":U
     9314         ,input t-doc.obj-type
     9315         ,input t-doc.obj-code
     9316         ,input 'nakl_par':U
     9317         ,input  "avail-on-date"
     9318         ,output v-value-character
     9319         ,output v-value-date
     9320         ,output v-value-decimal
     9321         ,output v-value-integer
     9322         ,output v-avail-on-date
     9323         ,output v-avail-on-date-type
     9324         ,INPUT-OUTPUT table-handle v-tth
     9325         ) no-error .
     9326         if error-status :error  then v-avail-on-date = false .
     9327         delete object v-tth no-error.
     9328         if v-avail-on-date = true  and not ( t-doc.fact-date:screen-value = "" or t-doc.fact-date:screen-value = string(t-doc.fact-date)) then do:
     9329            if available ub.gds-dtl  then do:
     9330               message " Установлен параметр проверки резервирования не раньше даты прихода, поэтому так как строки документа введены дату менять нельзя "  view-as alert-box information   .
     9331               t-doc.fact-date:screen-value = string(t-doc.fact-date) .
     9332               return no-apply .
     9333            end.
     9334         end.
     9335       if input frame d-out-doc t-doc.fact-date <> t-doc.fact-date then do:
     9336       run chk-upd-date no-error.
     9337       if error-status :error then return no-apply.
     9338       assign frame d-out-doc t-doc.fact-date.
     9339     end.
     9340   END.
     9341   ON return OF t-doc.fact-date IN FRAME d-out-doc
     9342   DO:
     9343       if t-doc.fact-date:sensitive in frame d-out-doc then do:
     9344       apply "entry" to t-doc.shift-date in frame d-out-doc.
     9345     end.
     9346     else do:
     9347       apply "entry" to b-add in frame d-out-doc.
     9348     end.
     9349     return no-apply.
     9350   END.
     9351   ON VALUE-CHANGED OF edo-return IN FRAME d-out-doc
     9352     DO:
     9353       define variable vLog as logical no-undo .
     9354       define variable vFlgGenAttr as logical no-undo .
     9355       define buffer buf_doc-line  for ub.doc-line.
     9356       define buffer parts         for ub.parts.
     9357       if edo-return:screen-value = "no"
     9358       then do :
     9359         message "По договору с поставщиком осуществляется ЭДО, уверены в возврате без ЭДО?" view-as alert-box question buttons yes-no update vLog .
     9360         if not vLog
     9361         then do :
     9362           edo-return:screen-value = "yes" .
     9363           return no-apply .
     9364         end .
     9365       end .
     9366       if (t-doc.reason-code = 25 or t-doc.reason-code = 23)
     9367           and edo-return:screen-value = "yes"
     9368       then do:
     9369          vFlgGenAttr = yes.
     9370          bdl:
     9371          for each buf_doc-line where buf_doc-line.doc-code eq t-doc.doc-code
     9372              no-lock,
     9373              each parts where parts.out-code  = buf_doc-line.doc-code
     9374                           and parts.obj-type  = buf_doc-line.obj-type
     9375                           and parts.obj-code  = buf_doc-line.obj-code
     9376                           and parts.artic     = buf_doc-line.artic
     9377                           and parts.prod-type = buf_doc-line.prod-type
     9378                           and parts.prod-code = buf_doc-line.prod-code
     9379              no-lock:
     9380              find first gen-attr where gen-attr.table-name = 'parts':U
     9381                                    and gen-attr.p-key      =  "parts"                + chr(3) +
     9382    parts.obj-type           + chr(3) +
     9383    string(parts.obj-code)   + chr(3) +
     9384    parts.artic              + chr(3) +
     9385    parts.prod-type          + chr(3) +
     9386    string(parts.prod-code)  + chr(3) +
     9387    parts.In-code            + chr(3) +
     9388    parts.Out-code           + chr(3) +
     9389    parts.part-Code          + chr(3) +
     9390    string(parts.prt-code)
     9391                                    and gen-attr.attr-code  = "in-part-key"
     9392                 no-lock no-error.
     9393              if available gen-attr
     9394                 then vFlgGenAttr = yes.
     9395              else do:
     9396                 vFlgGenAttr = no.
     9397                 leave bdl.
     9398              end.
     9399          end.
     9400          if vFlgGenAttr = yes then
     9401             disable b-bc with frame d-out-doc.
     9402          else do:
     9403             message "Строки документа введены без указания возвращаемой партии."
     9404                skip "Удалите все строки документа, что бы установить признак 'Возврат по ЭДО'."
     9405             view-as alert-box.
     9406             edo-return:screen-value = "no" .
     9407             return no-apply .
     9408          end.
     9409       end.
     9410       assign edo-return .
     9411   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t-doc.doc-code ,
     9412                          input 'edo-return':U ,
     9413                          input string(edo-return) )  .
     9414     END.
     9415   ON VALUE-CHANGED OF is-cons IN FRAME d-out-doc
     9416   DO:
     9417     run val-chg-is-cons.
     9418   END.
     9419   ON VALUE-CHANGED OF is-oldcons IN FRAME d-out-doc
     9420   DO:
     9421     run val-chg-is-oldcons.
     9422   END.
     9423   ON VALUE-CHANGED OF is-repay IN FRAME d-out-doc
     9424   DO:
     9425     run val-chg-is-repay.
     9426   END.
     9427   ON VALUE-CHANGED OF is-storage IN FRAME d-out-doc
     9428   DO:
     9429     run val-chg-is-storage.
     9430   END.
     9431   on value-changed of t-doc.discnt-type in frame d-out-doc
     9432   do:
     9433   define variable g#log as logical   no-undo .
     9434   g#log = no.
     9435   run check-discnt no-error.
     9436   if error-status:error then return no-apply.
     9437   do transaction:
     9438      run ch-discnt no-error.
     9439      if return-value = "error" then do:
     9440         if t-doc.discnt-type = 'процент':U then do:
     9441            run ui-on ("enable").
     9442            apply "entry" to t-doc.discnt-pc in frame d-out-doc.
     9443            return no-apply.
     9444         end.
     9445         else undo, leave.
     9446      end.
     9447   end.
     9448   display t-doc.discnt-type with frame d-out-doc.
     9449   run ui-on ("enable").
     9450   end.
     9451   ON CHOOSE OF r-reas IN FRAME d-out-doc
     9452   DO:
     9453     run select-reason in this-procedure.
     9454   END.
     9455   ON return OF t-doc.shift-date IN FRAME d-out-doc
     9456   DO:
     9457     apply "entry" to t-doc.shift-name in frame d-out-doc.
     9458     return no-apply.
     9459   end.
     9460   on return of t-doc.shift-name in frame d-out-doc do:
     9461     apply "entry" to b-add in frame d-out-doc.
     9462     return no-apply.
     9463   end.
     9464   on return of t-doc.shift-num in frame d-out-doc do:
     9465     apply "entry" to b-add in frame d-out-doc.
     9466     return no-apply.
     9467   end.
     9468   on choose of r-sht in frame d-out-doc do:
     9469     run proc-sht.
     9470   end.
     9471   on leave of t-doc.shift-num  in frame d-out-doc do:
     9472     run proc-shift-num no-error.
     9473     if error-status:error then do:
     9474       return no-apply.
     9475     end.
     9476   end.
     9477   on leave of t-doc.shift-name in frame d-out-doc do:
     9478     run proc-shift-name no-error.
     9479     if error-status:error then do:
     9480       return no-apply.
     9481     end.
     9482   end.
     9483   on leave of t-doc.shift-date in frame d-out-doc do:
     9484     if input frame d-out-doc t-doc.shift-date <> t-doc.shift-date then do:
     9485       assign
     9486         t-doc.shift-name = ""
     9487         t-doc.shift-num  = 0.
     9488       display t-doc.shift-name t-doc.shift-num with frame d-out-doc.
     9489       apply "entry" to t-doc.shift-name in frame d-out-doc.
     9490       return no-apply.
     9491     end.
     9492   end.
     9493   ON VALUE-CHANGED OF varpurch-chs IN FRAME d-out-doc
     9494   DO:
     9495       define variable varchs-tg as logical no-undo.
     9496     if varpurch-chs <> input frame d-out-doc varpurch-chs then do:
     9497       assign
     9498         frame d-out-doc varpurch-chs.
     9499       if varpurch-chs = 0 then do:
     9500   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t-doc.doc-code ,
     9501                          input 'purchlimit':U ,
     9502                          input 'no':U )  .
     9503         assign
     9504           varchs-tg = no.
     9505         if is-repay = no then do:
     9506           assign
     9507             is-repay  = yes
     9508             varchs-tg = yes.
     9509         end.
     9510         if is-cons = no then do:
     9511           assign
     9512             is-cons   = yes
     9513             varchs-tg = yes.
     9514         end.
     9515         if is-storage = no then do:
     9516           assign
     9517             is-storage  = yes
     9518             varchs-tg = yes.
     9519         end.
     9520         if is-oldcons = no then do:
     9521           assign
     9522             is-oldcons  = yes
     9523             varchs-tg = yes.
     9524         end.
     9525         if varchs-tg = yes then do:
     9526   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t-doc.doc-code ,
     9527                          input 'purchcodelist':U ,
     9528                          input '1,2,3,4':U )  .
     9529           display is-repay is-cons is-storage is-oldcons with frame d-out-doc.
     9530         end.
     9531         disable is-repay is-cons is-storage is-oldcons with frame d-out-doc.
     9532       end.
     9533       else do:
     9534   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t-doc.doc-code ,
     9535                          input 'purchlimit':U ,
     9536                          input 'yes':U )  .
     9537         enable is-repay is-cons is-storage is-oldcons with frame d-out-doc.
     9538       end.
     9539       display varpurch-chs with frame d-out-doc.
     9540     end.
     9541   END.
     9542   define menu m-ptrl
     9543       menu-item m-ptrl-1   label "Создать документы сверки и зафиксировать  книжное кол-во"  accelerator "alt-1"
     9544       menu-item m-ptrl-2   label "Удалить документы сверки и расфиксировать книжное кол-во"  accelerator "alt-2".
     9545   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9546   on F9 of frame d-out-doc anywhere do:
     9547     if not available ub.goods then
