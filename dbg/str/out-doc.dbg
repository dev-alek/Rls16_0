     3492               run waitfram-hide in this-procedure .
     3493               message
     3494                 vss-workfile vss-revision vss-description skip
     3495                 substitute( 'Ошибка при открытии документа сверки "&1" номер &2', 'после_док':U, aft-rvs-doc.rvs-code ) skip
     3496                 error-status :get-message(1) skip
     3497                 return-value skip
     3498                 view-as alert-box error .
     3499               undo tr, return error.
     3500             end.
     3501             release aft-rvs-doc no-error .
     3502             if error-status :error then do:
     3503               run waitfram-hide in this-procedure .
     3504               message
     3505                 vss-workfile vss-revision vss-description skip
     3506                 substitute( 'Ошибка при открытии документа сверки "&1" номер &2', 'после_док':U, aft-rvs-doc.rvs-code ) skip
     3507                 error-status :get-message(1) skip
     3508                 return-value skip
     3509                 view-as alert-box error .
     3510               undo tr, return error.
     3511             end.
     3512             find first aft-rvs-doc
     3513               where aft-rvs-doc.out-code = buf_trn-doc.doc-code
     3514                 and aft-rvs-doc.rvs-type = 'после_док':U
     3515               no-error.
     3516             delete aft-rvs-doc no-error .
     3517             if error-status :error then do:
     3518               message
     3519                 vss-workfile vss-revision vss-description skip
     3520                 substitute( 'Ошибка при удалении документа сверки "&1"', 'после_док':U ) skip
     3521                 error-status :get-message(1) skip
     3522                 return-value skip
     3523                 view-as alert-box error .
     3524               undo tr, return error.
     3525             end.
     3526           end.
     3527         end.
     3528         run waitfram-hide in this-procedure .
     3529         return .
     3530       END PROCEDURE.
     3531   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3532   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3533   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     3534   define variable par-type          as character no-undo.
     3535   define variable v-value-character as character no-undo .
     3536   define variable v-value-date      as date      no-undo .
     3537   define variable v-value-decimal   as decimal   no-undo .
     3538   define variable v-value-integer   as integer   no-undo .
     3539   define variable v-value-logical   as logical   no-undo .
     3540   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3541   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3542   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     3543   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     3544   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     3545   ASSIGN
     3546      v-S_CONTRACT                = "Contract":U
     3547      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     3548      v-DELIM_CHR_3               = ","
     3549      .
     3550   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     3551   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     3552   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     3553   FUNCTION Can-Find-Spec RETURN LOGICAL (
     3554      INPUT iHost-Code    AS INTEGER,
     3555      INPUT iContract-Num AS INTEGER,
     3556      INPUT iGds-Code     AS INTEGER ):
     3557      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     3558      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     3559      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     3560      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     3561      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     3562      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     3563          INPUT  iHost-Code,
     3564          INPUT  iContract-Num,
     3565          OUTPUT iTmp-Extent3
     3566          ).
     3567      IF iTmp-Extent3[1] = 2 THEN DO:
     3568         ASSIGN
     3569            iTmp-Host-Code      = iTmp-Extent3[2]
     3570            iTmp-Contract-Num   = iTmp-Extent3[3]
     3571            .
     3572      END. ELSE DO:
     3573         ASSIGN
     3574            iTmp-Host-Code      = iHost-Code
     3575            iTmp-Contract-Num   = iContract-Num
     3576            .
     3577      END.
     3578      IF iGds-Code = ? THEN DO:
     3579         ASSIGN
     3580            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     3581                                  buf_Spec.Host-Code     = iTmp-Host-Code
     3582                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     3583                           ).
     3584      END. ELSE DO:
     3585            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     3586                                  buf_Spec.Host-Code     = iTmp-Host-Code
     3587                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     3588                              AND buf_Spec.Gds-Code      = iGds-Code
     3589                            ).
     3590      END.
     3591      RETURN (lRet).
     3592   END FUNCTION.
     3593   PROCEDURE MS-Contract-EXTENT-3:
     3594      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     3595      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     3596      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     3597      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     3598      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     3599      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     3600      FIND FIRST buf_Cont-2 WHERE
     3601                 buf_Cont-2.Host-Code      = i-Host-Code
     3602             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     3603           NO-LOCK NO-ERROR.
     3604      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     3605         RETURN.
     3606      END.
     3607      FOR FIRST buf_Ext-Classif WHERE
     3608                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     3609           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     3610                                               STRING(i-Contract-code)
     3611           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     3612          NO-LOCK,
     3613          EACH buf_Cont WHERE
     3614               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     3615           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     3616          NO-LOCK:
     3617          ASSIGN
     3618             i-Ret[1] = 1
     3619             i-Ret[2] = buf_Cont.Host-code
     3620             i-Ret[3] = buf_Cont.Contract-code
     3621             .
     3622          LEAVE.
     3623      END.
     3624      IF i-Ret[1] <> 1 THEN DO:
     3625         FOR FIRST buf_Ext-Classif WHERE
     3626                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     3627              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     3628                                                  STRING(i-Contract-code)
     3629              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     3630             NO-LOCK,
     3631             EACH buf_Cont WHERE
     3632                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     3633              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     3634             NO-LOCK:
     3635             ASSIGN
     3636                i-Ret[1] = 2
     3637                i-Ret[2] = buf_Cont.Host-code
     3638                i-Ret[3] = buf_Cont.Contract-code
     3639                .
     3640             LEAVE.
     3641         END.
     3642      END.
     3643      RETURN.
     3644   END PROCEDURE.
     3645   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3646   DEFINE VARIABLE v-gl-UVEDOMLENIE as CHARACTER NO-UNDO INITIAL "Uvedomlenie":U.
     3647   FUNCTION Get-Contract-Attr RETURN CHARACTER(
     3648            INPUT iHost-Code AS INTEGER,
     3649            INPUT iContract-Code  AS INTEGER,
     3650            INPUT cAttr-code      AS CHARACTER):
     3651      DEFINE BUFFER buf_Contract-Attr FOR ub.Contract-Attr.
     3652      FIND FIRST buf_Contract-Attr WHERE
     3653                 buf_Contract-Attr.Host-code     = iHost-Code
     3654             AND buf_Contract-Attr.Contract-code = iContract-Code
     3655             AND buf_Contract-Attr.Attr-code     = cAttr-code
     3656           NO-LOCK NO-ERROR.
     3657      RETURN (IF AVAILABLE buf_Contract-Attr THEN buf_Contract-Attr.Attr-value ELSE ?).
     3658   END FUNCTION.
     3659   PROCEDURE Modify-Contract-Attr:
     3660      DEFINE INPUT  PARAMETER iHost-Code      AS INTEGER   NO-UNDO.
     3661      DEFINE INPUT  PARAMETER iContract-Code  AS INTEGER   NO-UNDO.
     3662      DEFINE INPUT  PARAMETER cAttr-code      AS CHARACTER NO-UNDO.
     3663      DEFINE INPUT  PARAMETER cAttr-value     AS CHARACTER NO-UNDO.
     3664      DEFINE OUTPUT PARAMETER cError          AS CHARACTER NO-UNDO INITIAL "".
     3665      DEFINE BUFFER buf_Contract-Attr FOR  ub.Contract-Attr.
     3666      Tran:
     3667      DO TRANSACTION
     3668         ON ENDKEY UNDO Tran, RETRY Tran
     3669         ON ERROR  UNDO Tran, RETRY Tran
     3670         ON QUIT   UNDO Tran, RETRY Tran
     3671         ON STOP   UNDO Tran, RETRY Tran:
     3672         IF RETRY THEN DO:       cError = "Ошибка транзакции:":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     3673         FIND FIRST buf_Contract-Attr WHERE
     3674                    buf_Contract-Attr.Host-Code      = iHost-Code
     3675                AND buf_Contract-Attr.Contract-Code  = iContract-Code
     3676                AND buf_Contract-Attr.Attr-code      = cAttr-code
     3677              NO-LOCK NO-ERROR.
     3678         IF NOT AVAILABLE buf_Contract-Attr THEN DO:
     3679            CREATE buf_Contract-Attr NO-ERROR.
     3680            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     3681         END. ELSE DO:
     3682            FIND CURRENT buf_Contract-Attr EXCLUSIVE-LOCK NO-ERROR.
     3683            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     3684         END.
     3685         ASSIGN
     3686            buf_Contract-Attr.Host-Code      = iHost-Code
     3687            buf_Contract-Attr.Contract-Code  = iContract-Code
     3688            buf_Contract-Attr.Attr-code      = cAttr-code
     3689            buf_Contract-Attr.Attr-value     = cAttr-value
     3690            NO-ERROR.
     3691         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     3692         RELEASE buf_Contract-Attr NO-ERROR.
     3693         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     3694      END.
     3695      RETURN.
     3696   END PROCEDURE.
     3697   PROCEDURE Create-Contract-Attr:
     3698      DEFINE INPUT  PARAMETER iHost-Code      AS INTEGER   NO-UNDO.
     3699      DEFINE INPUT  PARAMETER iContract-Code  AS INTEGER   NO-UNDO.
     3700      DEFINE INPUT  PARAMETER cAttr-code      AS CHARACTER NO-UNDO.
     3701      DEFINE INPUT  PARAMETER cAttr-value     AS CHARACTER NO-UNDO.
     3702      DEFINE OUTPUT PARAMETER cError          AS CHARACTER NO-UNDO INITIAL "".
     3703      DEFINE BUFFER buf_Contract-Attr FOR  ub.Contract-Attr.
     3704      Tran:
     3705      DO TRANSACTION
     3706         ON ENDKEY UNDO Tran, RETRY Tran
     3707         ON ERROR  UNDO Tran, RETRY Tran
     3708         ON QUIT   UNDO Tran, RETRY Tran
     3709         ON STOP   UNDO Tran, RETRY Tran:
     3710         IF RETRY THEN DO:       cError = "Ошибка транзакции:":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     3711         CREATE buf_Contract-Attr NO-ERROR.
     3712         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     3713         ASSIGN
     3714            buf_Contract-Attr.Host-Code      = iHost-Code
     3715            buf_Contract-Attr.Contract-Code  = iContract-Code
     3716            buf_Contract-Attr.Attr-code      = cAttr-code
     3717            buf_Contract-Attr.Attr-value     = cAttr-value
     3718            NO-ERROR.
     3719         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     3720         RELEASE buf_Contract-Attr NO-ERROR.
     3721         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     3722      END.
     3723      RETURN.
     3724   END PROCEDURE.
     3725   FUNCTION Is-MS-Contract RETURN LOGICAL(BUFFER buf_Master FOR ub.Contract, BUFFER buf_Slave  FOR ub.Contract) FORWARD.
     3726   FUNCTION Is-Master-Slave-Contract RETURN CHARACTER( BUFFER buf_Contract FOR ub.Contract) FORWARD.
     3727   FUNCTION Is-MS-Contract-Int RETURN INTEGER (BUFFER buf_Contract FOR ub.Contract) FORWARD.
     3728   PROCEDURE Delete-Contract-Specif:
     3729      DEFINE PARAMETER BUFFER buf_Contract FOR ub.Contract.
     3730      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     3731      DEFINE BUFFER buf_Specif      FOR ub.Contract-Specif.
     3732      DEFINE BUFFER buf_Specif-Attr FOR ub.Contract-Specif-Attr.
     3733      Tran:
     3734      DO TRANSACTION
     3735         ON ENDKEY UNDO Tran, RETRY Tran
     3736         ON ERROR  UNDO Tran, RETRY Tran
     3737         ON QUIT   UNDO Tran, RETRY Tran
     3738         ON STOP   UNDO Tran, RETRY Tran:
     3739         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     3740         FOR EACH buf_Specif-Attr WHERE
     3741                  buf_Specif-Attr.Host-code     = buf_Contract.Host-code
     3742              AND buf_Specif-Attr.Contract-Num  = buf_Contract.Contract-code
     3743             EXCLUSIVE-LOCK:
     3744             DELETE buf_Specif-Attr NO-ERROR.
     3745             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     3746         END.
     3747         FOR EACH buf_Specif WHERE
     3748                  buf_Specif.Host-code     = buf_Contract.Host-code
     3749              AND buf_Specif.Contract-Num  = buf_Contract.Contract-code
     3750             EXCLUSIVE-LOCK:
     3751             DELETE buf_Specif NO-ERROR.
     3752            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     3753         END.
     3754      END.
     3755      RETURN.
     3756   END PROCEDURE.
     3757   PROCEDURE Modify-Slave-Contract:
     3758      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     3759      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     3760      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     3761      DEFINE BUFFER buf_Slave FOR ub.Contract.
     3762      Tran:
     3763      DO TRANSACTION
     3764         ON ENDKEY UNDO Tran, RETRY Tran
     3765         ON ERROR  UNDO Tran, RETRY Tran
     3766         ON QUIT   UNDO Tran, RETRY Tran
     3767         ON STOP   UNDO Tran, RETRY Tran:
     3768         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     3769         FOR EACH buf_Ext-Classif WHERE
     3770                  buf_Ext-Classif.Classif-name = v-S_CONTRACT
     3771              AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     3772              AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     3773             NO-LOCK,
     3774             FIRST buf_Slave WHERE
     3775                   buf_Slave.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     3776               AND buf_Slave.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     3777             EXCLUSIVE-LOCK:
     3778             BUFFER-COPY
     3779               buf_Master
     3780             EXCEPT
     3781               Host-code                               Contract-code                           Own-name                                an-uchet-code-out                       cel-nazn-code-out                       cor-acc-out                             cor-acc1-out                            an-uchet-code-in                        cel-nazn-code-in                        cor-acc-in                              cor-acc1-in                             an-uchet-code-out-cash                  cel-nazn-code-out-cash                  cor-acc-out-cash                        cor-acc1-out-cash                       an-uchet-code-in-cash                   cel-nazn-code-in-cash                   cor-acc-in-cash                         cor-acc1-in-cash                        an-uchet-code-out-payoff                cel-nazn-code-out-payoff                cor-acc-out-payoff                      cor-acc1-out-payoff                     an-uchet-code-in-payoff                 cel-nazn-code-in-payoff                 cor-acc-in-payoff                       cor-acc1-in-payoff                      transport-cli-type                      transport-cli-code                      transport-host                          transport-contract                      transport-uslov                         transport-value                         own-code-schet-start                    own-sign-post                           own-sign                                contract-city                           fin-VAT-pc                              srok-opl                                gen-factur-srok                         own-addres                              own-inn                                 own-kpp
     3782             TO buf_Slave
     3783             NO-ERROR.
     3784             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     3785             RELEASE buf_Slave NO-ERROR.
     3786             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     3787         END.
     3788      END.
     3789      RETURN.
     3790   END PROCEDURE.
     3791   PROCEDURE Change-Stat-Slave-Contract:
     3792      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     3793      DEFINE INPUT PARAMETER cStatus  AS CHARACTER NO-UNDO.
     3794      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     3795      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     3796      DEFINE BUFFER buf_Slave FOR ub.Contract.
     3797      Tran:
     3798      DO TRANSACTION
     3799         ON ENDKEY UNDO Tran, RETRY Tran
     3800         ON ERROR  UNDO Tran, RETRY Tran
     3801         ON QUIT   UNDO Tran, RETRY Tran
     3802         ON STOP   UNDO Tran, RETRY Tran:
     3803         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     3804         FOR EACH buf_Ext-Classif WHERE
     3805                  buf_Ext-Classif.Classif-name = v-S_CONTRACT
     3806              AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     3807              AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     3808             NO-LOCK,
     3809             FIRST buf_Slave WHERE
     3810                   buf_Slave.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     3811               AND buf_Slave.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     3812             EXCLUSIVE-LOCK:
     3813             ASSIGN
     3814                buf_Slave.Status_ = cStatus
     3815                NO-ERROR.
     3816             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     3817             RELEASE buf_Slave NO-ERROR.
     3818             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     3819         END.
     3820      END.
     3821      RETURN.
     3822   END PROCEDURE.
     3823   PROCEDURE Delete-Ref-Master-Slave:
     3824      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     3825      DEFINE PARAMETER BUFFER buf_Slave  FOR ub.Contract.
     3826      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     3827      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     3828      IF NOT Is-MS-Contract(BUFFER buf_Master, BUFFER buf_Slave) THEN DO:
     3829         cError = PROGRAM-NAME(1) + ":" + "Между договорами нет связи Master->Slave".
     3830         RETURN.
     3831      END.
     3832      Tran:
     3833      FOR FIRST buf_Ext-Classif WHERE
     3834                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     3835            AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     3836            AND buf_Ext-Classif.CharKey_Two  = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
     3837            AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     3838          EXCLUSIVE-LOCK
     3839          TRANSACTION
     3840          ON ENDKEY UNDO Tran, RETRY Tran
     3841          ON ERROR  UNDO Tran, RETRY Tran
     3842          ON QUIT   UNDO Tran, RETRY Tran
     3843          ON STOP   UNDO Tran, RETRY Tran:
     3844          IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     3845          DELETE buf_Ext-Classif NO-ERROR.
     3846          IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     3847      END.
     3848      RETURN.
     3849   END PROCEDURE.
     3850   PROCEDURE Create-Ref-Master-Slave:
     3851      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     3852      DEFINE PARAMETER BUFFER buf_Slave  FOR ub.Contract.
     3853      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     3854      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     3855      DEFINE VARIABLE cKeyRec AS CHARACTER NO-UNDO INITIAL "".
     3856      IF Is-MS-Contract(BUFFER buf_Master, BUFFER buf_Slave) THEN DO:
     3857         cError = PROGRAM-NAME(1) + ":" + "Между договорами  уже есть связь Master->Slave".
     3858         RETURN.
     3859      END.
     3860      RUN gen-key-rec IN THIS-PROCEDURE(
     3861          INPUT  v-S_CONTRACT,
     3862          INPUT  BUFFER buf_Master:HANDLE,
     3863          OUTPUT cKeyRec
     3864          ) NO-ERROR.
     3865      IF ERROR-STATUS:ERROR THEN DO:
     3866         cError = PROGRAM-NAME(1) + ":" + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.
     3867         RETURN.
     3868      END.
     3869      Tran:
     3870      DO TRANSACTION
     3871         ON ENDKEY UNDO Tran, RETRY Tran
     3872         ON ERROR  UNDO Tran, RETRY Tran
     3873         ON QUIT   UNDO Tran, RETRY Tran
     3874         ON STOP   UNDO Tran, RETRY Tran:
     3875         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     3876         CREATE buf_Ext-Classif NO-ERROR.
     3877         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     3878         ASSIGN
     3879            buf_Ext-Classif.Classif-name    = v-S_CONTRACT
     3880            buf_Ext-Classif.Classif-subject = v-S_CONTRACT
     3881            buf_Ext-Classif.CharKey_One     = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     3882            buf_Ext-Classif.CharKey_Two     = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
     3883            buf_Ext-Classif.DB-num          = buf_Master.Db-num
     3884            buf_Ext-Classif.Uniq-key-rec    = cKeyRec
     3885            NO-ERROR.
     3886         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     3887         RELEASE buf_Ext-Classif NO-ERROR.
     3888         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     3889      END.
     3890      RETURN.
     3891   END PROCEDURE.
     3892   FUNCTION Is-MS-Contract-Int-2 RETURN INTEGER (
     3893                                 i-Host-Code AS INTEGER,
     3894                                 i-Contract-Code AS INTEGER):
     3895      DEFINE BUFFER buf_Contract FOR ub.Contract.
     3896      DEFINE VARIABLE iRet AS INTEGER NO-UNDO INITIAL 0.
     3897      FIND FIRST buf_Contract WHERE
     3898                 buf_Contract.Host-Code      = i-Host-Code
     3899             AND buf_Contract.Contract-code  = i-Contract-Code
     3900           NO-LOCK NO-ERROR.
     3901      IF AVAILABLE buf_Contract THEN DO:
     3902         ASSIGN
     3903            iRet = Is-MS-Contract-Int(BUFFER buf_Contract).
     3904      END.
     3905      RETURN (iRet).
     3906   END FUNCTION.
     3907   FUNCTION Is-MS-Contract-Int RETURN INTEGER (BUFFER buf_Contract FOR ub.Contract):
     3908      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     3909      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     3910      DEFINE VARIABLE iRet AS INTEGER NO-UNDO INITIAL 0.
     3911      FOR FIRST buf_Ext-Classif WHERE
     3912                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     3913           AND  buf_Ext-Classif.CharKey_One  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     3914                                               STRING(buf_Contract.contract-code)
     3915           AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     3916          NO-LOCK,
     3917          EACH buf_Cont WHERE
     3918               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     3919           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     3920          NO-LOCK:
     3921          ASSIGN
     3922             iRet = 1.
     3923          LEAVE.
     3924      END.
     3925      IF iRet <> 1 THEN DO:
     3926         FOR FIRST buf_Ext-Classif WHERE
     3927                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     3928              AND  buf_Ext-Classif.CharKey_Two  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     3929                                                  STRING(buf_Contract.contract-code)
     3930              AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     3931             NO-LOCK,
     3932             EACH buf_Cont WHERE
     3933                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     3934              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     3935             NO-LOCK:
     3936             ASSIGN
     3937                iRet = 2.
     3938             LEAVE.
     3939         END.
     3940      END.
     3941      RETURN (iRet).
     3942   END FUNCTION.
     3943   FUNCTION Is-Master-Slave-Contract RETURN CHARACTER( BUFFER buf_Contract FOR ub.Contract):
     3944      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     3945      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     3946      DEFINE VARIABLE cRet AS CHARACTER NO-UNDO INITIAL "".
     3947      FOR FIRST buf_Ext-Classif WHERE
     3948                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     3949           AND  buf_Ext-Classif.CharKey_One  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     3950                                               STRING(buf_Contract.contract-code)
     3951           AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     3952          NO-LOCK,
     3953          EACH buf_Cont WHERE
     3954               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     3955           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     3956          NO-LOCK:
     3957          ASSIGN
     3958             cRet = "+".
     3959          LEAVE.
     3960      END.
     3961      IF cRet = "" THEN DO:
     3962         FOR FIRST buf_Ext-Classif WHERE
     3963                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     3964              AND  buf_Ext-Classif.CharKey_Two  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     3965                                                  STRING(buf_Contract.contract-code)
     3966              AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     3967             NO-LOCK,
     3968             EACH buf_Cont WHERE
     3969                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     3970              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     3971             NO-LOCK:
     3972             ASSIGN
     3973                cRet = (IF buf_Cont.Contract-prn-code = "" THEN  STRING(buf_Cont.Contract-code) ELSE buf_Cont.Contract-prn-code).
     3974             LEAVE.
     3975         END.
     3976      END.
     3977      RETURN (cRet).
     3978   END FUNCTION.
     3979   FUNCTION Is-MS-Contract RETURN LOGICAL(
     3980            BUFFER buf_Master FOR ub.Contract,
     3981            BUFFER buf_Slave  FOR ub.Contract):
     3982      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     3983      RETURN CAN-FIND ( FIRST buf_Ext-Classif WHERE
     3984                          buf_Ext-Classif.Classif-name = v-S_CONTRACT
     3985                      AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     3986                      AND buf_Ext-Classif.CharKey_Two  = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
     3987                      AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     3988                    NO-LOCK).
     3989   END FUNCTION.
     3990   FUNCTION Get-Num-Slave-Contract RETURN CHARACTER(
     3991            BUFFER buf_Master FOR ub.Contract,
     3992            INPUT iSlave-Host-Code AS INTEGER
     3993            ):
     3994      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     3995      DEFINE BUFFER buf_Contract    FOR ub.Contract.
     3996      DEFINE VARIABLE cRet AS CHARACTER NO-UNDO INITIAL "".
     3997      FIND FIRST buf_Ext-Classif WHERE
     3998                 buf_Ext-Classif.Classif-name = v-S_CONTRACT
     3999             AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     4000             AND buf_Ext-Classif.CharKey_Two  BEGINS STRING(iSlave-Host-Code) + v-DELIM_CHR_3
     4001             AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     4002           NO-LOCK NO-ERROR.
     4003      IF AVAILABLE buf_Ext-Classif THEN DO:
     4004         IF CAN-FIND (FIRST buf_Contract WHERE
     4005                            buf_Contract.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     4006                        AND buf_Contract.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     4007                       NO-LOCK) THEN DO:
     4008            ASSIGN
     4009               cRet = ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3).
     4010         END. ELSE DO:
     4011            ASSIGN
     4012               cRet = "ERROR:" + "Ошибка связи мастер договора " +
     4013                      STRING(buf_Master.Host-Code) + "," + STRING(buf_Master.Contract-code) + " " +
     4014                      "c Host-code=" + STRING(iSlave-Host-Code).
     4015         END.
     4016      END.
     4017      RETURN (cRet).
     4018   END FUNCTION.
     4019   DEFINE VARIABLE mImagePath     AS CHARACTER   NO-UNDO.
     4020   DEFINE VARIABLE mImageDir      AS CHARACTER   NO-UNDO.
     4021   DEFINE VARIABLE mImagePreDir   AS CHARACTER   NO-UNDO.
     4022   DEFINE VARIABLE mImageTrash    AS CHARACTER   NO-UNDO.
     4023   DEFINE VARIABLE mPhotomgd      AS LOGICAL     NO-UNDO.
     4024   DEFINE VARIABLE mImagePh       AS LOGICAL     NO-UNDO.
     4025   define variable v-param-types   as character  no-undo.
     4026   define variable v-value-char    as character  no-undo.
     4027   define variable v-val-date      as date       no-undo.
     4028   define variable v-val-decimal   as decimal    no-undo.
     4029   define variable v-val-integer   as integer    no-undo.
     4030   define variable v-val-logical   as logical    no-undo.
     4031   define variable v-tthd          as handle     no-undo.
     4032   RUN imagelist_loaddef IN THIS-PROCEDURE NO-ERROR.
     4033   PROCEDURE imagelist_loaddef:
     4034       DEFINE VARIABLE vPar-val       AS CHARACTER   NO-UNDO.
     4035       DEFINE VARIABLE vPar-type      AS CHARACTER   NO-UNDO.
     4036       ASSIGN
     4037           vPar-val  = "":U
     4038           vPar-type = "":U
     4039           .
     4040   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     4041     (input  'photo':u
     4042     ,input  '':u
     4043     ,input  '':u
     4044     ,input  0
     4045     ,input  '':u
     4046     ,input  '':u
     4047     ,input  '':u
     4048     ,input  no
     4049     ,output vPar-val
     4050     ,output vPar-type
     4051     ) no-error .
     4052           mImagePh = LOOKUP (vPar-val, "true,yes":U) > 0.
     4053       IF mImagePh THEN .
     4054       ELSE RETURN.
     4055       ASSIGN
     4056           vPar-val  = "":U
     4057           vPar-type = "":U
     4058           .
     4059   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     4060     (input  'ph-dir':u
     4061     ,input  '':u
     4062     ,input  '':u
     4063     ,input  0
     4064     ,input  '':u
     4065     ,input  '':u
     4066     ,input  '':u
     4067     ,input  NO
     4068     ,output vPar-val
     4069     ,output vPar-type
     4070     ) no-error .
     4071       IF LENGTH (vPar-val) = 0 THEN
     4072           RUN verify-ini-entry("ph-dir":U, "REP-SETS":U, "":U, YES, OUTPUT vPar-val) NO-ERROR.
     4073       IF LENGTH (vPar-val) = 0 THEN vPar-val = "c:\temp\":U.
     4074       ASSIGN
     4075           mImagePath   = RIGHT-TRIM (vPar-val, "~\~/":U)
     4076           mImagePath   = mImagePath + (IF LENGTH (mImagePath) > 0 THEN "\":U ELSE "":U)
     4077           mImagePreDir = mImagePath
     4078           mImageDir    = mImagePreDir
     4079           mImageTrash  = mImagePath + "trash\":U
     4080           .
     4081       ASSIGN
     4082           vPar-val  = "":U
     4083           vPar-type = "":U
     4084           .
     4085               run adm/shattri.p (
     4086           input "get":U
     4087           ,input  '':U
     4088           ,input  0
     4089           ,input  'gds-ref':U
     4090           ,input  'shema-foto':U
     4091           ,output v-value-char
     4092           ,output v-val-date
     4093           ,output v-val-decimal
     4094           ,output v-val-integer
     4095           ,output v-val-logical
     4096           ,output v-param-types
     4097           ,INPUT-OUTPUT table-handle v-tthd
     4098           ) no-error.
     4099           delete object v-tthd.
     4100           mPhotomgd = IF v-val-integer = 2 then yes else no.
     4101   END PROCEDURE.
     4102   PROCEDURE imagelist_decode:
     4103       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
     4104       DEFINE INPUT  PARAMETER iImageGdsCode AS int    NO-UNDO.
     4105       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
     4106       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
     4107       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
     4108       ASSIGN
     4109           oImageList = iImageList
     4110           .
     4111       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
     4112           vCh =ENTRY (vInt, iImageList, ",":U).
     4113           IF SUBSTRING (vCh, 1, 2) = "~\~\":U THEN .
     4114           ELSE
     4115           DO:
     4116               ASSIGN
     4117                   vCh = REPLACE (vCh, "~/":U, "\":U)
     4118                   vCh = REPLACE (vCh, "~\":U, "\":U)
     4119                   .
     4120               IF SUBSTRING (vCh, 2, 2) = ":\":U OR vCh BEGINS mImageDir THEN .
     4121               ELSE vCh = mImagePreDir + (if mPhotomgd then string(iImageGdsCode) + "\":U else '':U ) +  vCh.
     4122               ENTRY (vInt, oImageList, ",":U) = vCh.
     4123           END.
     4124       END.
     4125   END PROCEDURE.
     4126   PROCEDURE imagelist_encode:
     4127       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
     4128       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
     4129       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
     4130       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
     4131       DEFINE VARIABLE vLen               AS INTEGER   NO-UNDO.
     4132       ASSIGN
     4133           oImageList = iImageList
     4134           vLen       = LENGTH (mImageDir)
     4135           .
     4136       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
     4137           vCh =ENTRY (vInt, iImageList, ",":U).
     4138           IF LENGTH (vCh) > 0 AND vLen > 0 AND vCh BEGINS mImageDir THEN
     4139               ENTRY (vInt, oImageList, ",":U) =
     4140                   SUBSTRING (vCh, vLen + 1).
     4141       END.
     4142   END PROCEDURE.
     4143   def var vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4144   procedure gen-key-rec :
     4145     define input  parameter p-tbl-name    as character no-undo.
     4146     define input  parameter p-bh_tbl-name as handle    no-undo.
     4147     define output parameter p-key-rec     as character no-undo.
     4148     do
     4149     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4150     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     4151     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     4152     :
     4153       define variable fh               as handle    no-undo .
     4154       define variable v-ok             as logical   no-undo .
     4155       define variable v-inform         as character no-undo .
     4156       define variable v-ind            as integer   no-undo .
     4157       define variable v-idx-field-qnty as integer   no-undo .
     4158       if p-tbl-name = ?
     4159         or p-tbl-name = "":U
     4160       then do:
     4161         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info35 ).
     4162       end.
     4163       if not p-bh_tbl-name:available then do:
     4164         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info35, p-tbl-name ).
     4165       end.
     4166       assign
     4167         p-key-rec = p-tbl-name
     4168         v-inform  = p-bh_tbl-name:index-information(1)
     4169         v-ind     = 2
     4170       .
     4171       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     4172       on error undo, return error
     4173       :
     4174         assign
     4175           v-inform = p-bh_tbl-name:index-information( v-ind )
     4176           v-ind    = v-ind + 1
     4177         .
     4178       end.
     4179       if v-inform = ?
     4180         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     4181         or entry( 3, v-inform, ",":U ) <> "1":U
     4182       then do:
     4183         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info35, p-tbl-name ).
     4184       end.
     4185       else do:
     4186         assign
     4187           v-idx-field-qnty = num-entries( v-inform ) - 4
     4188         .
     4189         if v-idx-field-qnty < 2 then do:
     4190           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info35, v-inform, p-tbl-name ).
     4191         end.
     4192         do v-ind = 1 to v-idx-field-qnty by 2
     4193         on error undo, return error
     4194         :
     4195           assign
     4196             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     4197             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     4198           .
     4199         end.
     4200       end.
     4201       if p-key-rec = ? then do:
     4202         assign
     4203           p-key-rec = "":U
     4204         .
     4205         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info35, p-tbl-name ).
     4206       end.
     4207     end.
     4208     return.
     4209   end procedure.
     4210   procedure gen-where-keyr-tab :
     4211     define input  parameter i-tableSerach as character no-undo.
     4212     define input  parameter i-tablekey   as character  no-undo.
     4213     define input  parameter p-key-rec    as character  no-undo.
     4214     define input  parameter p-key-handle as handle     no-undo .
     4215     define input  parameter p-db-name    as character  no-undo .
     4216     define input  parameter p-tt-handle  as handle     no-undo .
     4217     define output parameter o-Where      as character  no-undo.
     4218     do
     4219     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4220     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     4221     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     4222     :
     4223       define variable v-full-tbl-name  as character no-undo .
     4224       define variable bh_tbl-name      as handle    no-undo .
     4225       define variable fh_key           as handle    no-undo .
     4226       define variable fh_search        as handle    no-undo .
     4227       define variable v-field-num      as integer   no-undo .
     4228       define variable v-count-fld      as integer   no-undo .
     4229       define variable v-inform         as character no-undo .
     4230       define variable v-ind            as integer   no-undo .
     4231       define variable v-idx-field-qnty as integer   no-undo .
     4232       define variable v-field-name     as character no-undo .
     4233       define variable v-field-val      as character no-undo .
     4234       define variable v-word-link      as character no-undo .
     4235       define variable vTable           as character no-undo.
     4236       define variable bh_tbl-key       as handle    no-undo .
     4237       assign
     4238         p-key-rec = trim( p-key-rec )
     4239       .
     4240       if p-key-handle <> ? then do:
     4241         if not valid-handle(p-key-handle)
     4242            or p-key-handle:type <> "buffer"
     4243         then do:
     4244           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info35 ).
     4245         end.
     4246         if num-entries( p-key-rec, chr(3) ) > 1
     4247           or p-key-rec = ?
     4248           or p-key-rec = "":U
     4249         then do:
     4250           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info35, p-key-rec ).
     4251         end.
     4252       end.
     4253       else do:
     4254         if p-key-rec = ?
     4255           or p-key-rec = "":U
     4256         then do:
     4257           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info35 ).
     4258         end.
     4259       end.
     4260       assign
     4261         vTable = entry( 1 , p-key-rec, chr(3) )
     4262       .
     4263       if p-tt-handle <> ?
     4264         and ( not valid-handle(p-tt-handle)
     4265               or p-tt-handle:type <> "buffer"
     4266             )
     4267       then do:
     4268         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info35, vTable, chr(10) ).
     4269       end.
     4270       if p-tt-handle = ? then do:
     4271         assign
     4272           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     4273         .
     4274         create buffer bh_tbl-name for table v-full-tbl-name .
     4275       end.
     4276       else do:
     4277         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     4278       end.
     4279       assign
     4280         v-inform = bh_tbl-name:index-information(1)
     4281         v-ind    = 2
     4282       .
     4283       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     4284       on error undo, return error
     4285       :
     4286         assign
     4287           v-inform = bh_tbl-name:index-information( v-ind )
     4288           v-ind    = v-ind + 1
     4289         .
     4290       end.
     4291       if v-inform = ?
     4292         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     4293         or entry( 3, v-inform, ",":U ) <> "1":U
     4294       then do:
     4295         delete object bh_tbl-name no-error.
     4296         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info35, vTable ).
     4297       end.
     4298       assign
     4299         v-idx-field-qnty = num-entries( v-inform ) - 4
     4300       .
     4301       if v-idx-field-qnty < 2 then do:
     4302         delete object bh_tbl-name no-error.
     4303         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info35, v-inform, vTable ).
     4304       end.
     4305       assign
     4306         o-where     = "where":U
     4307         v-word-link = "":U
     4308         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     4309         v-count-fld = 0
     4310       .
     4311       if i-tablekey ne "" and i-tablekey ne ?
     4312       then do:
     4313         assign
     4314           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     4315         .
     4316         create buffer bh_tbl-key for table v-full-tbl-name .
     4317       end.
     4318       if i-tableSerach ne "" and i-tableSerach ne ?
     4319       then do:
     4320         delete object bh_tbl-name no-error.
     4321         assign
     4322           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     4323         .
     4324         create buffer bh_tbl-name for table v-full-tbl-name .
     4325       end.
     4326       block_where:
     4327       do v-ind = 1 to v-idx-field-qnty by 2
     4328       on error undo, return error
     4329       :
     4330         assign
     4331           v-count-fld = v-count-fld + 1
     4332         .
     4333         if p-key-handle = ?
     4334           and v-count-fld > v-field-num
     4335         then do:
     4336           leave block_where.
     4337         end.
     4338         define variable VfieldKeyTable as handle no-undo.
     4339         assign
     4340           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     4341           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     4342         .
     4343         if     bh_tbl-key ne ?
     4344         then do:
     4345            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     4346            if VfieldKeyTable eq ?
     4347            then next block_where.
     4348         end.
     4349         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     4350         then
     4351            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     4352         else
     4353            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     4354         if p-key-handle = ? then do:
     4355           assign
     4356             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     4357           .
     4358         end.
     4359         else do:
     4360           assign
     4361             fh_key = p-key-handle:buffer-field( v-field-name )
     4362           .
     4363           if fh_key = ?
     4364             or not valid-handle( fh_key )
     4365           then do:
     4366             delete object bh_tbl-name.
     4367             if     bh_tbl-key ne ?
     4368             then
     4369                delete object bh_tbl-key.
     4370             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info35, p-key-handle:name, v-field-name ).
     4371           end.
     4372           assign
     4373             v-field-val = fh_key:buffer-value
     4374           .
     4375         end.
     4376         if fh_search:data-type ="character":U then do:
     4377           assign
     4378             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     4379             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     4380             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     4381             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     4382             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     4383             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     4384             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     4385             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     4386             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     4387             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     4388             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     4389             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     4390             v-field-val = substitute( '"&1"', v-field-val )
     4391           .
     4392         end.
     4393         assign
     4394           o-where = substitute( "&1 &2", o-where, v-field-val )
     4395         .
     4396         if v-word-link = "":U then do:
     4397           assign
     4398             v-word-link = "and":U
     4399           .
     4400         end.
     4401       end.
     4402       delete object bh_tbl-name.
     4403       if     bh_tbl-key ne ?
     4404       then
     4405          delete object bh_tbl-key.
     4406       if p-key-handle = ?
     4407         and v-count-fld <> v-field-num
     4408       then do:
     4409         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info35, vTable ).
     4410       end.
     4411     end.
     4412   end procedure.
     4413   procedure gen-hn-keyr-tab :
     4414     define input  parameter i-tableSerach as character no-undo.
     4415     define input  parameter i-tablekey   as character no-undo.
     4416     define input  parameter p-key-rec    as character no-undo.
     4417     define input  parameter p-key-handle as handle    no-undo .
     4418     define input  parameter p-db-name    as character no-undo .
     4419     define input  parameter p-tt-handle  as handle    no-undo .
     4420     define input  parameter p-stts-lock  as integer   no-undo .
     4421     define output parameter o-hn         as handle    no-undo.
     4422     define variable v-full-tbl-name as character no-undo.
     4423     define variable v-where         as character no-undo.
     4424     define variable bh_tbl-name     as handle    no-undo.
     4425     define variable vTable          as character no-undo.
     4426     do
     4427     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4428     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     4429     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     4430         run gen-where-keyr-tab(i-tableSerach,
     4431                                i-tablekey,
     4432                                p-key-rec,
     4433                                p-key-handle,
     4434                                p-db-name,
     4435                                p-tt-handle,
     4436                                output v-where).
     4437         if i-tableSerach ne "" and i-tableSerach ne ?
     4438         then do:
     4439            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     4440            create buffer bh_tbl-name for table v-full-tbl-name .
     4441         end.
     4442         else do:
     4443            if p-tt-handle = ? then do:
     4444               assign
     4445                  vTable = entry( 1 , p-key-rec, chr(3) )
     4446               .
     4447               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     4448               create buffer bh_tbl-name for table v-full-tbl-name .
     4449            end.
     4450            else do:
     4451               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     4452            end.
     4453         end.
     4454         if p-tt-handle = ? then do:
     4455            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     4456         end.
     4457         else do:
     4458            bh_tbl-name:find-first( v-where ) no-error .
     4459         end.
     4460         o-hn = bh_tbl-name.
     4461      end.
     4462   end procedure.
     4463   procedure gen-hn-keyr :
     4464     define input  parameter p-key-rec    as character no-undo.
     4465     define input  parameter p-key-handle as handle    no-undo .
     4466     define input  parameter p-db-name    as character no-undo .
     4467     define input  parameter p-tt-handle  as handle    no-undo .
     4468     define input  parameter p-stts-lock  as integer   no-undo .
     4469     define output parameter o-hn         as handle    no-undo.
     4470     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     4471   end.
     4472   procedure gen-row-keyr :
     4473     define input  parameter p-key-rec    as character no-undo.
     4474     define input  parameter p-key-handle as handle    no-undo .
     4475     define input  parameter p-db-name    as character no-undo .
     4476     define input  parameter p-tt-handle  as handle    no-undo .
     4477     define input  parameter p-stts-lock  as integer   no-undo .
     4478     define output parameter p-tbl-row    as rowid     no-undo.
     4479     define output parameter p-tbl-name   as character no-undo.
     4480     define variable vHn as handle no-undo.
     4481       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     4482       p-tbl-row = if vHn:available then vHn:rowid else ?.
     4483       p-tbl-name =  vHn:table.
     4484       delete object vHn no-error.
     4485     if p-tbl-row = ? then do:
     4486       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info35, p-tbl-name, p-key-rec ).
     4487     end.
     4488     else do:
     4489       return.
     4490     end.
     4491   end procedure.
     4492   procedure gen-key-fv :
     4493     define input  parameter p-key-rec    as character no-undo .
     4494     define output parameter p-field-list as character no-undo .
     4495     define output parameter p-value-list as character no-undo.
     4496     do
     4497     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4498     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     4499     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     4500     :
     4501       define variable v-full-tbl-name  as character no-undo .
     4502       define variable bh_tbl-name      as handle    no-undo .
     4503       define variable v-tbl-name       as character no-undo .
     4504       define variable v-field-num      as integer   no-undo .
     4505       define variable v-count-fld      as integer   no-undo .
     4506       define variable v-inform         as character no-undo .
     4507       define variable v-ind            as integer   no-undo .
     4508       define variable v-idx-field-qnty as integer   no-undo .
     4509       define variable v-delim-key      as character no-undo .
     4510       if p-key-rec = ?
     4511         or p-key-rec = "":U
     4512       then do:
     4513         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info35 ).
     4514       end.
     4515       assign
     4516         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     4517         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     4518       .
     4519       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     4520       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info35 ).
     4521       assign
     4522         v-inform = bh_tbl-name:index-information(1)
     4523         v-ind    = 2
     4524       .
     4525       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     4526       on error undo, return error
     4527       :
     4528         assign
     4529           v-inform = bh_tbl-name:index-information( v-ind )
     4530           v-ind    = v-ind + 1
     4531         .
     4532       end.
     4533       if v-inform = ?
     4534         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     4535         or entry( 3, v-inform, ",":U ) <> "1":U
     4536       then do:
     4537         delete object bh_tbl-name no-error.
     4538         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info35, v-tbl-name ).
     4539       end.
     4540       assign
     4541         v-idx-field-qnty = num-entries( v-inform ) - 4
     4542       .
     4543       if v-idx-field-qnty < 2 then do:
     4544         delete object bh_tbl-name no-error.
     4545         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info35, v-inform, v-tbl-name ).
     4546       end.
     4547       assign
     4548         p-field-list = "":U
     4549         p-value-list = "":U
     4550         v-delim-key  = "":U
     4551         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     4552         v-count-fld  = 0
     4553       .
     4554       block_where:
     4555       do v-ind = 1 to v-idx-field-qnty by 2
     4556       on error undo, return error
     4557       :
     4558         assign
     4559           v-count-fld = v-count-fld + 1
     4560         .
     4561         if v-count-fld > v-field-num then do:
     4562           leave block_where.
     4563         end.
     4564         assign
     4565           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     4566           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     4567         .
     4568         if v-ind = 1 then do:
     4569           assign
     4570             v-delim-key = chr(3)
     4571           .
     4572         end.
     4573       end.
     4574       delete object bh_tbl-name.
     4575       if v-count-fld <> v-field-num then do:
     4576         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info35, v-tbl-name ).
     4577       end.
     4578     end.
     4579   end procedure.
     4580   procedure gen-key-field :
     4581     define input  parameter p-table      as character no-undo .
     4582     define output parameter p-field-list as character no-undo .
     4583     do
     4584     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4585     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     4586     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     4587     :
     4588       define variable v-full-tbl-name  as character no-undo .
     4589       define variable bh_tbl-name      as handle    no-undo .
     4590       define variable v-tbl-name       as character no-undo .
     4591       define variable v-field-num      as integer   no-undo .
     4592       define variable v-count-fld      as integer   no-undo .
     4593       define variable v-inform         as character no-undo .
     4594       define variable v-ind            as integer   no-undo .
     4595       define variable v-idx-field-qnty as integer   no-undo .
     4596       define variable v-delim-key      as character no-undo .
     4597       if p-table = ?
     4598         or p-table = "":U
     4599       then do:
     4600         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info35 ).
     4601       end.
     4602       assign
     4603         v-tbl-name      = p-table
     4604         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     4605       .
     4606       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     4607       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info35 ).
     4608       assign
     4609         v-inform = bh_tbl-name:index-information(1)
     4610         v-ind    = 2
     4611       .
     4612       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     4613       on error undo, return error
     4614       :
     4615         assign
     4616           v-inform = bh_tbl-name:index-information( v-ind )
     4617           v-ind    = v-ind + 1
     4618         .
     4619       end.
     4620       if v-inform = ?
     4621         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     4622         or entry( 3, v-inform, ",":U ) <> "1":U
     4623       then do:
     4624         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info35, v-tbl-name ).
     4625       end.
     4626       assign
     4627         v-idx-field-qnty = num-entries( v-inform ) - 4
     4628       .
     4629       if v-idx-field-qnty < 2 then do:
     4630         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info35, v-inform, v-tbl-name ).
     4631       end.
     4632       assign
     4633         p-field-list = "":U
     4634         v-delim-key  = "":U
     4635         v-count-fld  = 0
     4636       .
     4637       block_where:
     4638       do v-ind = 1 to v-idx-field-qnty by 2
     4639       on error undo, return error
     4640       :
     4641         assign
     4642           v-count-fld = v-count-fld + 1
     4643         .
     4644         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     4645         if v-ind = 1 then do:
     4646           assign
     4647             v-delim-key = chr(3)
     4648           .
     4649         end.
     4650       end.
     4651       delete object bh_tbl-name.
     4652     end.
     4653   end procedure.
     4654   define temp-table tt-act-header
     4655       field num           as character        label "№ акта"      format "X(30)"
     4656       field date_         as date             label "Дата акта"
     4657       field is-sent       as logical
     4658       field answer_       as character        label "Ответ"       format "X(1500)"
     4659       field type_         as character        label "Основание"   format "X(35)"
     4660       field RegID         as character        label "Рег. номер"  format "X(50)"
     4661       index pi as primary unique
     4662           num
     4663   .
     4664   define temp-table tt-gds-act
     4665       field num           as character                label "№ акта"
     4666       field position_     as integer                  label "№ пп"                    format ">>>9"
     4667       field gds-code      like ub.goods.gds-code      label "Код товара   "
     4668       field part-code     like ub.parts.part-code     label "Партия"
     4669       field doc-code      as character                label "№ накладной TH"
     4670       field doc-date      like ub.trn-doc.fact-date   label "Дата TH"
     4671       field alc-code      as character                label "Алкогольный код"         format "X(21)"
     4672       field gds-name      like ub.goods.gds-name      label "Наименование товара"     format "X(35)"
     4673       field qnty          as decimal                  label "Количество"
     4674       field inform-A      as character                label "Справка А"               format "X(20)"
     4675       field A-qnty        as decimal                  label "Кол-во в справке"
     4676       field A-bottleDate  as date                     label "Дата розлива"
     4677       field A-ttnNumber   as character                label "№ ТТН справки А"         format "X(15)"
     4678       field A-ttnDate     as date                     label "Дата"
     4679       field A-fixNumber   as character                label "№ фиксации в ЕГАИС"      format "X(20)"
     4680       field A-fixDate     as date                     label "Дата фикс."
     4681       field inform-B      as character                label "Справка Б"               format "X(20)"
     4682       field marks-qnty    as integer                  label "Кол-во марок"
     4683       field egais-name    as character
     4684       index pi as primary unique
     4685           position_
     4686       index code
     4687           gds-code doc-code
     4688   .
     4689   define new shared temp-table tt-marks
     4690       field num                 as character            label "№ акта"
     4691       field gds-part-position_  as integer
     4692       field mark                as character            label "Марка"          format "X(100)"
     4693       field new_                as logical
     4694       field gds-code            like ub.goods.gds-code  LABEL "Код товара"
     4695       field gds-name            as character            LABEL "Наименование"   FORMAT "X(30)"
     4696       field alc-code            as character            LABEL "Алк. код"       FORMAT "X(20)"
     4697       field impor-full-name     as character            LABEL "Импортер"       FORMAT "X(130)"
     4698       field prod-full-name      as character            LABEL "Производитель"  FORMAT "X(130)"
     4699       field flag                as logical              label "T"
     4700       field reserv              as integer              label "R"
     4701       field parts               as character            label "Партия"         format "X(130)"
     4702       index pi as primary unique
     4703           mark
     4704   .
     4705   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4706   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
     4707   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
     4708   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
     4709   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
     4710   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
     4711   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
     4712   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
     4713   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
     4714   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
     4715   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
     4716   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
     4717   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
     4718   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
     4719   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
     4720   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
     4721   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
     4722   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
     4723   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4724   define temp-table tt-utd like ub.utd
     4725     field stts        as character
     4726     field stts-edi    as character
     4727     field cli-name    as character
     4728     field EDoTypeName as character
     4729     field ModifyTime_ as character
