    12930    message "Если Вы расфиксируете цены, то при изменении цены в прайс-листе до закрытия документа она проставится в документ." skip
    12931            "Вы уверены?" view-as alert-box buttons yes-no update varlog.
    12932    if varlog = yes then do:
    12933      for each bf_gds-dtl where bf_gds-dtl.doc-code = t-doc.doc-code on error undo, return no-apply :
