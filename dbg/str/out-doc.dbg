    20238   PROCEDURE ask-copy-ord :
    20239     define input parameter p-ord-code  as character no-undo .
    20240     define input parameter parcash-pay like ub.sysconf.cash-pay no-undo.
    20241     define input parameter pardoc-prt  as   logical             no-undo.
    20242     define variable chg-qnty    like gds-dtl.doc-qnty    no-undo.
    20243     define variable legal-node  like ub.gds-prt.node-code   no-undo.
    20244     define variable varcount    as   integer             no-undo.
    20245     define variable varchg-qnty like ub.gds-dtl.doc-qnty no-undo.
    20246     define variable vardoc-qnty like ub.gds-dtl.doc-qnty no-undo.
    20247     define variable v-is-petrol as   logical             no-undo.
    20248     define variable v-is-pieces as   logical             no-undo.
    20249     define variable var-kg-qnty like ub.gds-dtl.doc-qnty no-undo.
    20250     define variable rr-inv-line as   recid               no-undo.
    20251     define buffer cpl_goods    for ub.goods   .
    20252     define buffer cpl_gds-obj  for ub.gds-obj .
    20253     define buffer cpl_prt-obj  for ub.prt-obj .
    20254     define buffer cpl_gds-prt  for ub.gds-prt .
    20255     define buffer cpl_gds-dtl  for ub.gds-dtl .
    20256     define buffer cpl_doc-line for ub.doc-line.
    20257     define buffer cpl_inv-line for ub.inv-line.
    20258     define buffer buf_ord-doc  for ub.ord-doc .
    20259     define buffer buf_ord-line for ub.ord-line.
    20260   c-l:
    20261   do on error undo c-l, return error :
    20262   find first buf_ord-doc where buf_ord-doc.doc-code = p-ord-code.
    20263   r-l:
    20264   for each buf_ord-line where buf_ord-line.doc-code  = p-ord-code ,
    20265        each cpl_goods where cpl_goods.prod-type = buf_ord-line.prod-type
    20266                         and cpl_goods.prod-code = buf_ord-line.prod-code
    20267                         and cpl_goods.artic     = buf_ord-line.artic     no-lock :
    20268     assign varcount = varcount + 1.
    20269     if varcount modulo 100 = 0 then do:
    20270       run waitfram-show in this-procedure (input "ЖДИТЕ.  Обработано строк списка : " + string (varcount)).
    20271     end.
