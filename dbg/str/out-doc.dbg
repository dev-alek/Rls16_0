    14763   hbrowse = browse br-dtl:handle.
    14764   extent (bcol) = hbrowse:num-columns.
    14765   bcol[1] = hbrowse:first-column.
    14766   do ii = 1 to extent (bcol).
    14767     bcol[ii] = hbrowse:get-browse-column (ii).
    14768   end.
    14769   assign
    14770     v-gds-name:resizable in browse br-dtl   = true
    14771     v-gds-name:width     in browse br-dtl   = 40
    14772     d-kg-after-qnty :visible in browse br-dtl = ( v-is-ptrl = "yes" )
    14773     d-kg-fact-qnty  :visible in browse br-dtl = ( v-is-ptrl = "yes" )
    14774     d-kg-price-base :visible in browse br-dtl = ( v-is-ptrl = "yes" )
    14775     d-kg-price-rubl :visible in browse br-dtl = ( v-is-ptrl = "yes" )
    14776   .
    14777   def var sort-labelbr-dtl   as character no-undo .
    14778   def var sort-clmnbr-dtl    as handle    no-undo .
    14779   def var cur-clmnbr-dtl     as handle    no-undo .
    14780   def var cur-clmn-locbr-dtl as integer   no-undo .
    14781   def var re-querybr-dtl     as logical   initial no no-undo .
    14782   on start-search, ctrl-o of br-dtl in frame d-out-doc do:
    14783      run sort-brbr-dtl
    14784        (input (if available ub.gds-dtl
    14785                then recid(ub.gds-dtl)
    14786                else ?
    14787               )
    14788        ).
    14789   end.
    14790   PROCEDURE sort-brbr-dtl :
    14791     define input parameter p-recid as recid no-undo .
    14792     if re-querybr-dtl = no then do:
    14793       assign
    14794          cur-clmnbr-dtl = br-dtl:current-column in frame d-out-doc
    14795       .
    14796       if sort-clmnbr-dtl <> ? then sort-clmnbr-dtl:column-fgcolor = 0.
    14797       if cur-clmnbr-dtl = sort-clmnbr-dtl then do:
    14798         assign
    14799            sort-labelbr-dtl = ""
    14800            sort-clmnbr-dtl = ?
    14801         .
    14802        end.
    14803        else do:
    14804          assign
    14805            sort-labelbr-dtl = cur-clmnbr-dtl:label
    14806            sort-clmnbr-dtl  = cur-clmnbr-dtl
    14807            sort-clmnbr-dtl:column-fgcolor = 4
    14808          .
    14809        end.
    14810      end.
    14811     assign
    14812       cur-clmn-locbr-dtl = 1
    14813     .
    14814     def var column-handle as handle no-undo .
    14815     column-handle = br-dtl:first-column.
    14816     do while valid-handle(column-handle) :
    14817       if column-handle = cur-clmnbr-dtl then do:
    14818         leave .
    14819       end.
    14820       column-handle = column-handle:NEXT-COLUMN.
    14821       assign
    14822         cur-clmn-locbr-dtl = cur-clmn-locbr-dtl + 1
    14823       .
    14824     end.
    14825     case sort-labelbr-dtl:
    14826           when '*'  then DO:   open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base  by get-mark(BUFFER ub.gds-dtl)     . END.
    14827           when 'П/П'  then DO:   open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base  by ub.doc-line.line-num     . END.
    14828           when 'Бар-код'  then DO:   open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base  by ub.bar-code.b-code     . END.
    14829           when 'Артикул'  then DO:   open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base  by ub.gds-dtl.artic     . END.
    14830           when 'Имя '  then DO:   open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base  by (if ub.gds-prt.node-name <> '_Пустая шкала':U and ub.gds-prt.upper-code <> ub.goods.prt-root then ub.goods.gds-name + ' - ' + ub.gds-prt.f-name else ub.goods.gds-name)     . END.
    14831           when 'По документу'  then DO:   open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base  by ub.gds-dtl.doc-qnty     . END.
    14832           when 'Факт'  then DO:   open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base  by ub.gds-dtl.fact-qnty     . END.
    14833           when 'Изм'  then DO:   open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base  by ub.goods.unit-base     . END.
    14834           when 'Цена (вал.)'  then DO:   open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base  by ub.gds-dtl.price-base     . END.
    14835           when ''  then DO:   open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base  by ub.gds-dtl.ov     . END.
    14836           when 'Сумма (вал.)'  then DO:   open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base  by (ub.gds-dtl.price-base * ub.gds-dtl.fact-qnty)     . END.
    14837           when 'Скидка (вал.)'  then DO:   open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base  by (ub.gds-dtl.discnt-base * ub.gds-dtl.fact-qnty)     . END.
    14838           when 'Итого (вал.).'  then DO:   open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base  by ((ub.gds-dtl.price-base - ub.gds-dtl.discnt-base) * ub.gds-dtl.fact-qnty)     . END.
    14839           when 'Скидка %'  then DO:   open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base  by ub.gds-dtl.discnt-pc     . END.
    14840           when 'Цена (руб.)'  then DO:   open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base  by ub.gds-dtl.price-rubl     . END.
    14841           when 'Сумма (руб.)'  then DO:   open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base  by (ub.gds-dtl.price-rubl * ub.gds-dtl.fact-qnty)     . END.
    14842           when 'Скидка (руб.)'  then DO:   open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base  by (ub.gds-dtl.discnt-rubl * ub.gds-dtl.fact-qnty)     . END.
    14843           when 'Итого (руб.)'  then DO:   open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base  by ((ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl) * ub.gds-dtl.fact-qnty)     . END.
    14844           when 'Признак'  then DO:   open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base  by (if ub.gds-prt.node-name = '_Пустая шкала':U then '-' else if ub.gds-prt.upper-code = ub.goods.prt-root then '-------------------' else ub.gds-prt.f-name)     . END.
    14845           when 'Факт, кг'  then DO:   open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base  by get-kg-fact-qnty(  buffer ub.gds-dtl )     . END.
    14846           when 'Цена за кг (вал.)'  then DO:   open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base  by get-kg-sale-base(  buffer ub.gds-dtl )     . END.
    14847           when 'Цена за кг (руб.)'  then DO:   open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base  by get-kg-sale-rubl(  buffer ub.gds-dtl )     . END.
    14848           when 'Итого, кг'  then DO:   open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base  by get-kg-after-qnty( buffer ub.gds-dtl )     . END.
    14849           when 'НДС'  then DO:   open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base  by ub.doc-line.vat-sum-rubl * ub.gds-dtl.fact-qnty / ub.doc-line.fact-qnty     . END.
    14850           when 'НДС %'  then DO:   open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base  by ub.doc-line.vat-pc     . END.
    14851       otherwise do:
    14852         open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base by ub.doc-line.line-num .
    14853           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-dtl') then do:
