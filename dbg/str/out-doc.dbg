     9907   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9908   def var vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9909   function func-get-name-from-ext-type   returns char
     9910     ( p-ext-type as character   ,
     9911       p-caps     as logical ).
     9912   define variable v-ext-name as character no-undo .
     9913   run get-name-from-ext-type in this-procedure (
     9914       input p-ext-type  ,
     9915       input p-caps  ,
     9916       output v-ext-name )
     9917       no-error .
     9918       if error-status :error then do:
     9919          assign
     9920            v-ext-name = p-ext-type
     9921          .
     9922       end.
     9923    return (v-ext-name) .
     9924   end.
     9925   procedure get-name-from-ext-type :
     9926    do
     9927    on error undo, return error return-value
     9928    :
     9929   define input  parameter p-ext-type as character no-undo .
     9930   define input  parameter p-caps     as logical no-undo   .
     9931   define output parameter p-ext-name as character no-undo .
     9932   define variable v-num as integer no-undo .
     9933     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
     9934       message
     9935         vss-include-info55 skip
     9936         "Неправильно задано значение входящего параметра! "
     9937         "Нет такого типа документов " p-ext-type
     9938         view-as alert-box error .
     9939         undo, return error .
     9940     end.
     9941     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
     9942     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
     9943     if p-caps  = true then do :
     9944        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
     9945     end .
     9946     end.
     9947   end procedure.
