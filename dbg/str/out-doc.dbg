     1256   define variable vss-include-info10 as character format "X(65)" no-undo
     1257   initial "@(#)$Workfile$ $Revision$".
     1258   define temp-table temp_cgrplib_grp no-undo
     1259       field sel           as character
     1260       field full-name     as character
     1261       field sort-name     as character
     1262       field node-code     as integer
     1263       field upper-code    as integer
     1264       field d-pcnt        as decimal
