    12809      pardoc-rec = recid (t-doc).
    12810      run waitfram-show in this-procedure (input "ЖДИТЕ.  Список добавляется в документ...").
    12811      run copy-bb-list in this-procedure no-error .
    12812      if error-status :error then do:
    12813        apply "entry" to b-add in frame d-out-doc.
    12814        run waitfram-hide in this-procedure .
    12815        return no-apply.
    12816      end.
    12817      run waitfram-hide in this-procedure .
    12818   end.
    12819   pardoc-mode = 'ИЗМЕНЕНИЕ':U.
    12820   run ui-on ("line").
    12821   apply "entry" to br-dtl in frame d-out-doc.
