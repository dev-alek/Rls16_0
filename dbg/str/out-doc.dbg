     7961    FRAME d-out-doc:SCROLLABLE = FALSE
     7962    FRAME d-out-doc:HIDDEN     = TRUE
     7963    FRAME d-out-doc:SENSITIVE  = FALSE.
     7964   ASSIGN
     7965    b-marks:POPUP-MENU IN FRAME d-out-doc = MENU m-marks:HANDLE.
