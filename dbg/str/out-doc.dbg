     2358   procedure checkTypeByBarCode:
     2359     define input parameter iBarCode    as integer no-undo.
     2360     define input parameter iExtDocType as character no-undo.
     2361     define variable vValue as character no-undo.
     2362     define variable vType  as character no-undo.
     2363     define buffer buf_bar-code for ub.bar-code.
     2364     define buffer buf_goods    for ub.goods.
     2365     if iExtDocType = ? or
     2366        iExtDocType = 'ee':U or
     2367        iExtDocType = 'ie':U or
     2368        iExtDocType = 'iv':U or
     2369        iExtDocType = 'ev':U or
     2370        iExtDocType = 'we':U then
     2371         find buf_bar-code where buf_bar-code.b-code = iBarCode no-lock.
     2372         find buf_goods where buf_goods.gds-code = buf_bar-code.gds-code no-lock.
     2373         RUN gds-attr-value (
     2374            INPUT buf_goods.gds-code,
     2375            INPUT 'mark-type':U,
     2376            OUTPUT vValue,
     2377            OUTPUT vType
     2378         ).
     2379         if vValue <> "" then
     2380         do:
     2381           message
     2382             substitute("Товар: &1 &2", b-c, buf_goods.gds-name) skip
     2383             "нельзя добавлять в ручном режиме, так как он подлежит маркировке."
     2384             view-as alert-box error buttons ok.
     2385           return error.
     2386         end.
     2387   end procedure.
