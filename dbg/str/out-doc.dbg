    10284           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-manual-edit in g#attr-lib
    10285         (input  p-code
    10286         ,output p-section-num
    10287         ) no-error .
    10288       if error-status :error
    10289       then do:
    10290         undo, return error return-value .
    10291       end.
    10292     end.
    10293   end procedure.
    10294   procedure clntattr-batch-edit :
    10295     define input  parameter p-code           as character no-undo .
    10296     define output parameter p-section-num    as integer no-undo .
    10297     do
    10298     on error undo, return error
    10299     :
    10300           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-batch-edit in g#attr-lib
    10301         (input  p-code
    10302         ,output p-section-num
    10303         ) no-error .
    10304       if error-status :error
    10305       then do:
