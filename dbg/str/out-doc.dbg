    14863         .
    14864       end.
    14865     end case.
    14866       if cur-clmn-locbr-dtl <> ? then do:
    14867         if can-do( this-procedure:internal-entries, 'ch-clmnbr-dtl') then do:
    14868           run ch-clmnbr-dtl in this-procedure (cur-clmn-locbr-dtl).
    14869         end.
    14870       end.
    14871     if p-recid <> ? then do:
