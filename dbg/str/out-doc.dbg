    11965   do on error undo, return error :
    11966   case pardoc-mode :
    11967     when 'ДОБАВЛЕНИЕ':U then do:
    11968   define variable vss-include-info83 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11969   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
    11970     (input  v-cntxt-obj-type
    11971     ,input  v-cntxt-obj-code
    11972     ,output v-today
    11973     )  .
    11974       find last ub.curr-accnt where ub.curr-accnt.curr-code = varbase-code
    11975           and ub.curr-accnt.exch-date <= v-today use-index pi no-lock no-error.
    11976       if not available ub.curr-accnt then do:
    11977         message "На дату" v-today "неизвестен курс базовой валюты.".
    11978         undo, return error.
    11979       end.
    11980       if v-cntxt-db-num-obj <> v-cntxt-db-num and parstat <> 'запрос':U  then do:
    11981         message "Накладная не может быть выписана на пассивной стороне."
    11982                         "Используйте запрос.".
    11983         undo, return error.
    11984       end.
    11985       if parinternal = ? then do:
    11986         message "Неизвестно, внутренний или внешний документ.".
    11987         undo, return error.
    11988       end.
    11989       if parinternal and partype = 'возврат':U then do:
    11990         message "Для внутреннего перемещения можно создать только расход."
    11991                         "Остальные документы создаются автоматически.".
    11992         undo, return error.
    11993       end.
    11994       case partype :
    11995        when 'при':U    then do:
    11996          assign
    11997          varout-ret-supp = no.
    11998          varout-pay-code = v-cntxp-out-pay.
    11999        end.
    12000        when 'рас':U   then do:
    12001           if parext-doc-type = 'ep':U then do:
    12002              assign
    12003              varout-ret-supp = yes
    12004              varout-pay-code = v-cntxp-ret-sup-pay.
    12005           end.
    12006           else do:
    12007             assign
    12008             varout-pay-code = v-cntxp-out-pay.
    12009           end.
    12010        end.
    12011        when 'спи':U then do:
    12012          assign
    12013          varout-ret-supp = no
    12014          varout-pay-code = v-cntxp-down-pay.
    12015        end.
    12016        when 'возврат':U then do:
    12017          assign
    12018          varout-ret-supp = no.
    12019          varout-pay-code = v-cntxp-ret-pay.
    12020        end.
    12021       end case.
    12022   define variable vss-include-info84 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12023   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
    12024     (input  v-cntxt-obj-type
    12025     ,input  v-cntxt-obj-code
    12026     ,output v-today
    12027     )  .
    12028       run doc-code in this-procedure
    12029         (input  "main",
    12030          input  v-cntxt-obj-type,
    12031          input  v-cntxt-obj-code,
    12032          input  ?,
    12033          output vardoc-code ) no-error.
    12034       if error-status :error then do:
    12035         message "Ошибка при генерации номера документа." return-value view-as alert-box.
    12036         return error.
    12037       end.
    12038   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crtrndoc in g#lib-trn
    12039   (input ?
    12040   ,input ?
    12041   ,input ub.curr-accnt.exch-rate
    12042   ,input ub.curr-accnt.exch-scale
    12043   ,input ?
    12044   ,input ?
    12045   ,input ?
    12046   ,input v-cntxt-db-num
    12047   ,input v-cntxt-userid
    12048   ,input  'процент':U
    12049   ,input vardoc-code
    12050   ,input v-today
    12051   ,input  partype
    12052   ,input no
    12053   ,input v-cntxt-host-code-obj
    12054   ,input parinternal
    12055   ,input v-cntxt-obj-code
    12056   ,input v-cntxt-obj-type
    12057   ,input no
    12058   ,input  varout-pay-code
    12059   ,input '@  '
    12060   ,input  varout-ret-supp
    12061   ,input  ?
    12062   ,input  parstat
    12063   ,input  ?
    12064   ,input parext-doc-type
    12065   ,input
    12066           ?
    12067   ) no-error
    12068   .
    12069       if error-status :error then do:
    12070         undo, return error return-value.
    12071       end.
    12072       find t-doc where t-doc.doc-code = vardoc-code.
    12073       assign
    12074         pardoc-rec = recid (t-doc)
    12075         .
    12076          if not can-find(first ub.pay-type where ub.pay-type.obj-code = t-doc.pay-code no-lock) then do:
    12077             case t-doc.doc-type :
    12078               when 'при':U or  when 'рас':U then
    12079                  message "В настройках текущего объекта указан вид оплаты: " v-cntxp-out-pay ", которого нет в справочнике!"
    12080                      view-as alert-box error buttons ok.
    12081               when 'спи':U then
    12082                 message "В настройках текущего объекта указан вид оплаты списания: " v-cntxp-down-pay ", которого нет в справочнике!"
    12083                      view-as alert-box error buttons ok.
    12084               when 'возврат':U then
    12085                message "В настройках текущего объекта указан вид оплаты возврата: " v-cntxp-ret-pay ", которого нет в справочнике!"
    12086                      view-as alert-box error buttons ok.
    12087             end.
    12088             undo, return error.
    12089          end.
    12090     end.
    12091     when 'ПРОСМОТР':U then do:
    12092       find t-doc no-lock where recid( t-doc ) = pardoc-rec no-error.
    12093       if available t-doc then do:
    12094         if t-doc.internal = ? then do:
    12095           message "Документ был заведен неверно и удаляется!!!" view-as alert-box.
    12096           find t-doc exclusive-lock where recid( t-doc ) = pardoc-rec.
    12097           delete t-doc.
    12098           return.
    12099         end.
    12100         if parext-doc-mode <> "":U then do:
    12101           find t-doc exclusive-lock where recid( t-doc ) = pardoc-rec.
    12102         end.
    12103       end.
    12104     end.
    12105     when 'ИЗМЕНЕНИЕ':U then do:
    12106       find t-doc where recid (t-doc) = pardoc-rec no-error.
    12107       if available t-doc then do:
    12108         if t-doc.cli-code = ? then do:
    12109           message "Документ был заведен неверно и удаляется!!!" view-as alert-box.
    12110           delete t-doc.
    12111           return.
    12112         end.
    12113         if t-doc.flag_ = yes and t-doc.status_ = 'накл':U and t-doc.doc-type <> 'при':U and t-doc.ext-doc-type <> 'eo':U then do:
    12114           find t-doc where recid (t-doc) = pardoc-rec.
    12115           message "Факт. кол-во можно проставлять только в статусе разрешен.".
    12116           undo, return error.
    12117         end.
    12118         if t-doc.status_ = 'касс':U then do:
    12119           find t-doc where recid (t-doc) = pardoc-rec.
    12120           message "Все действия с кассовыми отчетами выполняются из АРМ Магазин.".
    12121           undo, return error.
    12122         end.
    12123         if t-doc.status_ = 'факт':U or
    12124            (t-doc.flag_ = yes and t-doc.status_ = 'запрос':U) then do:
    12125           find t-doc where recid (t-doc) = pardoc-rec.
    12126           message "Документ уже закрыт. Изменение невозможно.".
    12127           undo, return error.
    12128         end.
    12129         if  t-doc.flag_ = yes
    12130         then do:
    12131           define variable v-obj-active  as logical   no-undo .
    12132   define variable vss-include-info85 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12133   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
    12134     (input  t-doc.obj-type
    12135     ,input  t-doc.obj-code
    12136     ,input  'active=request':u
    12137     ,output v-obj-active
    12138     )  .
    12139           if v-obj-active <> true
    12140           then do:
    12141             find t-doc
    12142               where recid (t-doc) = pardoc-rec.
    12143             message
    12144               "Коррекция фактического количества допустима только в базе данных объекта" skip
    12145               "Документ" t-doc.doc-code skip
    12146               "Объект" t-doc.obj-type t-doc.obj-code skip
    12147               view-as alert-box information .
    12148             undo, return error.
    12149           end.
    12150         end.
    12151         find t-doc exclusive-lock
    12152           where recid (t-doc) = pardoc-rec
    12153           .
    12154       end.
    12155     end.
    12156   end.
    12157   if not available t-doc
    12158   then do:
    12159     message "Неправильно выбран документ.".
    12160     undo, return error.
    12161   end.
    12162   end.
    12163   end procedure.
    12164   procedure recalc-slt:
    12165   def var v-slt-pc        like ub.doc-line.slt-pc    no-undo.
    12166   def var v-host-code     like ub.sysconf.host-code  no-undo.
    12167   do on error undo, return error return-value :
    12168   find ub.sysconf where ub.sysconf.host-code = v-cntxt-host-code-obj no-lock.
    12169   if t-doc.pay-code = ub.sysconf.cash-pay then t-doc.slt-type = 'в т. ч.':U.
    12170   define variable vss-include-info86 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12171   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    12172     (input  t-doc.obj-type
    12173     ,input  t-doc.obj-code
    12174     ,output v-host-code
    12175     )  .
    12176   for each ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code exclusive,
    12177       each ub.goods where ub.goods.artic     = ub.doc-line.artic and
    12178                        ub.goods.prod-code = ub.doc-line.prod-code and
    12179                        ub.goods.prod-type = ub.doc-line.prod-type no-lock on error undo, return error return-value :
    12180     if t-doc.pay-code = ub.sysconf.cash-pay
    12181        and not t-doc.internal
    12182        and can-do ('рас,возврат':U, t-doc.doc-type)
    12183     then do:
    12184   define variable vss-include-info87 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12185   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
    12186     (input  ub.goods.gds-code
    12187     ,input  '2':U
    12188     ,input  ?
    12189     ,input  v-host-code
    12190     ,input  t-doc.obj-type
    12191     ,input  t-doc.obj-code
    12192     ,output v-slt-pc
    12193     ) no-error .
    12194        assign ub.doc-line.slt-pc =  v-slt-PC.
    12195     end.
    12196     else do:
    12197        assign ub.doc-line.slt-pc =  0.
    12198     end.
    12199   end.
    12200   run gbl/calc-trn.p (input parparentproc, input recid(t-doc)).
    12201   end.
    12202   end procedure.
    12203   procedure notes-tr:
    12204   define variable notes as character no-undo.
    12205   assign
    12206     notes = t-doc.PS.
    12207   if pardoc-mode = 'ПРОСМОТР':U then do:
    12208     run gbl/d-prompt.w (
    12209         'title=Примечание\'
    12210       + 'type=editor\'
    12211       + 'fillin_width=96\'
    12212       + 'fillin_height=15\'
    12213       + 'readonly=yes\'
    12214       , input-output notes).
    12215   end.
    12216   else do:
    12217      run gbl/d-prompt.w (
    12218         'title=примечание\'
    12219       + 'type=editor\'
    12220       + 'fillin_width=96\'
    12221       + 'fillin_height=15\'
    12222       , input-output notes).
    12223       if return-value = 'false':u then return .
    12224     if t-doc.PS <> notes then do:
    12225     if pardoc-rec = ? then pardoc-rec = recid (t-doc).
    12226       do transaction on error undo, return error return-value :
    12227         find t-doc where recid (t-doc) = pardoc-rec exclusive.
    12228         assign
    12229           t-doc.PS = notes.
    12230       end.
    12231     end.
    12232   end.
    12233   end procedure.
    12234   procedure choose-cli:
    12235   define variable varfirm-code like ub.firm.firm-code no-undo.
    12236   define variable v-types as character no-undo .
    12237   define buffer bf_clients for ub.clients.
    12238   define variable ref-rec as recid no-undo.
    12239   define variable v-rid-list as character no-undo .
    12240   do on error undo, return error return-value :
    12241   run check-cli no-error.
    12242   if error-status :error then do:
    12243     if t-doc.internal then v-types = 'маг':U.
    12244                       else v-types = 'все':U.
    12245     if (t-doc.ext-doc-type = 'ee':U or t-doc.ext-doc-type = 'ep':U) and
    12246        varhold            = "yes"              and
    12247        paris-hold         = yes                then do:
    12248       assign
    12249         varfirm-code = ?.
    12250       run adm/sconfs.w ( input parparentproc
    12251                       , input "b-sel":U
    12252                       , input no
    12253                       , input ?
    12254                       , output varfirm-code
    12255                       , input-output v-rid-list) no-error.
    12256       if error-status :error or
    12257          varfirm-code = ?   then do:
    12258         return error.
    12259       end.
    12260       find first bf_clients where bf_clients.obj-type = 'орг':U       and
    12261                                   bf_clients.obj-code = varfirm-code no-lock.
    12262       assign ref-list = string(recid (bf_clients)).
    12263       run check-base-code in this-procedure (recid(bf_clients)).
    12264     end.
    12265     else do:
    12266       if transaction = yes then do:
    12267         message "Критическая ошибка." skip
    12268                 "Вы находитесь в транзакции." skip
    12269                 "Работа со справочником клиентов невозможна."
    12270         view-as alert-box error.
    12271         return error.
    12272       end.
    12273       run ref/cli-all.w ( parparentproc
    12274                      , "b-sel,b-add"
    12275                      , v-types
    12276                      , ?
    12277                      , ?
    12278                      , ?
    12279                      , ?
    12280                      , ?
    12281                     , output ref-list) .
    12282     end.
    12283     if ref-list <> "" then do:
    12284       ref-rec = integer (ref-list).
    12285       find ub.clients where recid ( ub.clients ) = ref-rec no-lock.
    12286       disp ub.clients.obj-code @ t-doc.cli-code
    12287               ub.clients.obj-name with frame d-out-doc.
    12288     if pardoc-mode = 'ДОБАВЛЕНИЕ':U then
    12289       disp ub.clients.obj-type @ t-doc.cli-type with frame d-out-doc.
    12290     end.
    12291     run check-cli no-error.
    12292     if error-status :error then do:
    12293       return error return-value.
    12294     end.
    12295   end.
    12296   end.
    12297   end procedure.
    12298   procedure state-pay-code:
    12299   do transaction on error undo, return error :
    12300      if input frame d-out-doc t-doc.pay-code = v-cntxp-ret-sup-pay then do:
    12301         message "Нельзя устанавливаться код возврата поставщику." skip
    12302                 "Возврат поставщику оформляется из отдельнего пункта меню."
    12303         view-as alert-box error.
    12304         undo, return error.
    12305      end.
    12306      assign t-doc.pay-code = input frame d-out-doc t-doc.pay-code no-error.
    12307      if t-doc.ext-doc-type = 'iv':U
    12308      then do :
    12309        for each ub.parts where ub.parts.out-code = t-doc.doc-code:
    12310          assign ub.parts.pay-code = t-doc.pay-code.
    12311        end.
    12312      end .
    12313      else do :
    12314        run recalc-slt in this-procedure.
    12315      end .
    12316   end.
    12317      run ui-on("line").
    12318   end procedure.
    12319   procedure return-pay-code:
    12320   if input frame d-out-doc t-doc.pay-code <> t-doc.pay-code then do:
    12321      if input frame d-out-doc t-doc.pay-code = v-cntxp-ret-sup-pay then do:
    12322         message "Нельзя устанавливаться код возврата поставщику." skip
    12323                 "Возврат поставщику оформляется из отдельнего пункта меню."
    12324         view-as alert-box error.
    12325         display t-doc.pay-code with frame d-out-doc.
    12326         return error.
    12327      end.
    12328   end.
    12329   find ub.pay-type where ub.pay-type.obj-code = input frame d-out-doc t-doc.pay-code no-lock no-error.
    12330   if not available ub.pay-type then apply "choose" to r-pay.
    12331   end procedure.
    12332   procedure choose-r-pay:
    12333   define variable varrecid-pay as recid no-undo.
    12334   define variable v-rid-list as character no-undo .
    12335   run ref/paytype.w (input parparentproc, "b-sel", output v-rid-list ).
    12336   find ub.pay-type where recid ( ub.pay-type ) = integer(v-rid-list) no-lock no-error.
    12337   if not available ub.pay-type then return no-apply.
    12338   if ub.pay-type.obj-code = v-cntxp-ret-sup-pay then do:
    12339      message "Нельзя устанавливаться код возврата поставщику." skip
    12340              "Возврат поставщику оформляется из отдельнего пункта меню."
    12341      view-as alert-box error.
    12342      display t-doc.pay-code with frame d-out-doc.
    12343      return error.
    12344   end.
    12345   display ub.pay-type.obj-code @ t-doc.pay-code with frame d-out-doc.
    12346   assign varrecid-pay = recid(ub.pay-type).
    12347   run state-pay-code no-error.
    12348   if error-status :error then do:
    12349     display t-doc.pay-code with frame d-out-doc.
    12350     apply "entry" to t-doc.pay-code in frame d-out-doc.
    12351     return error.
    12352   end.
    12353   find ub.pay-type where recid(ub.pay-type) = varrecid-pay no-lock.
    12354   display t-doc.pay-code ub.pay-type.obj-name with frame d-out-doc.
    12355   end procedure.
    12356   procedure leave-pay-code:
    12357   define variable varrecid-pay as recid no-undo.
    12358   if input frame d-out-doc t-doc.pay-code = v-cntxp-ret-sup-pay then do:
    12359      message "Нельзя устанавливаться код возврата поставщику." skip
    12360              "Возврат поставщику оформляется из отдельнего пункта меню."
    12361      view-as alert-box error.
    12362      display t-doc.pay-code with frame d-out-doc.
    12363      return error.
    12364   end.
    12365   find ub.pay-type where ub.pay-type.obj-code = input frame d-out-doc t-doc.pay-code no-lock no-error.
    12366   if not available ub.pay-type then do:
    12367     message "Нет вида оплаты с таким кодом.".
    12368     display t-doc.pay-code with frame d-out-doc.
    12369     apply "entry" to t-doc.pay-code in frame d-out-doc.
    12370     return error.
    12371   end.
    12372   assign varrecid-pay = recid(ub.pay-type).
    12373   run state-pay-code no-error.
    12374   if error-status :error then do:
    12375     display t-doc.pay-code with frame d-out-doc.
    12376     apply "entry" to t-doc.pay-code in frame d-out-doc.
    12377     return error.
    12378   end.
    12379   find ub.pay-type where recid(ub.pay-type) = varrecid-pay no-lock.
    12380   display ub.pay-type.obj-name with frame d-out-doc.
    12381   end procedure.
    12382   procedure proc-exit :
    12383     define variable v-vat-pc   as decimal no-undo .
    12384     define variable v-slt-pc   as decimal no-undo .
    12385     define variable v-insalepr as logical no-undo .
    12386     assign parnext-prev = ?.
    12387     if lookup( pardoc-mode, 'ДОБАВЛЕНИЕ':U ) > 0 then do:
    12388       if not can-find (first ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code no-lock) then do:
    12389         delete t-doc.
    12390         assign pardoc-rec = ?.
    12391       end.
    12392       return.
    12393     end.
    12394     if lookup( pardoc-mode, 'ИЗМЕНЕНИЕ':U ) > 0 then do:
    12395       if not can-find (first ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code no-lock) and t-doc.is-flora = false then do:
    12396         assign varlog = true .
    12397         message "В документе нет строк, поэтому он удаляется." view-as alert-box question buttons OK-Cancel update varlog.
    12398         if varlog = yes then do:
    12399           if t-doc.is-flora = false then do:
    12400               define variable varchip-code as decimal   no-undo .
    12401                     run str/del-doc.p
    12402                         ( input  parparentproc,
    12403                           input  t-doc.doc-code,
    12404                           input  v-cntxt-db-num,
    12405                           input  "del-doc.err",
    12406                           input  ?,
    12407                           input  ?,
    12408                           input  v-cntxt-userid,
    12409                           input  t-doc.doc-code,
    12410                           input  ?,
    12411                           output varchip-code )
    12412                           .
    12413             assign pardoc-rec = ?.
    12414             return.
    12415           end.
    12416           else do:
    12417             assign varlog = false .
    12418             message "ВНИМАНИЕ !!! Документ удалится, так как в нем НЕТ ТОВАРОВ!!!"
    12419                        view-as alert-box  question buttons OK-Cancel update varlog .
    12420             if varlog = yes then do:
    12421               delete t-doc.
    12422               assign pardoc-rec = ?.
    12423               return.
    12424             end.
    12425             return error.
    12426           end.
    12427         end.
    12428         else do: return error. end.
    12429       end.
    12430       run check-rate no-error.
    12431       if error-status :error then do: return error. end.
    12432       assign frame d-out-doc t-doc.wrkr t-doc.agnt t-doc.boss .
    12433       define variable v-err as logical   no-undo .
    12434       run str/ver-fl.p ( input pardoc-mode, input t-doc.doc-code , output v-err ) no-error .
    12435       if error-status :error then return error.
    12436     end.
    12437     if t-doc.ext-doc-type = 'ep':U  and pardoc-mode <> 'ПРОСМОТР':U then do:
    12438        run str/ep-corrp.p (input parparentproc , input t-doc.doc-code ) no-error.
    12439     end.
    12440     run fill-mol in this-procedure.
    12441   end procedure.
    12442   procedure check-base-code :
    12443   define input parameter parrec-id as recid no-undo.
    12444   define variable varmy-host-code  like ub.sysconf.host-code no-undo.
    12445   define variable varmy-base-code  like ub.sysconf.base-code no-undo.
    12446   define variable varcli-base-code like ub.sysconf.base-code no-undo.
    12447   define buffer bf-my_currency  for ub.currency.
    12448   define buffer bf-cli_currency for ub.currency.
    12449   define buffer bf_clients for ub.clients.
    12450   do on error undo, return error return-value :
    12451     find first bf_clients where recid(bf_clients) = parrec-id no-lock.
    12452   define variable vss-include-info88 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12453   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    12454     (input  v-cntxt-obj-type
    12455     ,input  v-cntxt-obj-code
    12456     ,output varmy-host-code
    12457     ) no-error .
    12458     if error-status :error then do:
    12459       message "Ошибка при поиске фирмы для объекта " v-cntxt-obj-type " " v-cntxt-obj-code " ." skip
    12460               return-value skip
    12461               error-status :get-message( 1 )
    12462       view-as alert-box error.
    12463       return no-apply.
    12464     end.
    12465   define variable vss-include-info89 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12466   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
    12467     (input  varmy-host-code
    12468     ,output varmy-base-code
    12469     ) no-error .
    12470     if error-status :error then do:
    12471       message "Ошибка при поиске базовой валюты для фирмы " varmy-base-code " ." skip
    12472               return-value skip
    12473               error-status :get-message( 1 )
    12474       view-as alert-box error.
    12475       return no-apply.
    12476     end.
    12477   define variable vss-include-info90 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12478   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
    12479     (input  bf_clients.obj-code
    12480     ,output varcli-base-code
    12481     ) no-error .
    12482     if error-status :error then do:
    12483       message "Ошибка при поиске базовой валюты для фирмы " bf_clients.obj-code " ." skip
    12484               return-value skip
    12485               error-status :get-message( 1 )
    12486       view-as alert-box error.
    12487       return no-apply.
    12488     end.
    12489     if varmy-base-code <> varcli-base-code then do:
    12490       find first bf-my_currency  where bf-my_currency.curr-code  = varmy-base-code  no-lock.
    12491       find first bf-cli_currency where bf-cli_currency.curr-code = varcli-base-code no-lock.
    12492       message "Несоответствие базовых валют фирм при межфирменном перемещении." skip
    12493               "У нашей фирмы " varmy-host-code " базовая валюта " bf-my_currency.curr-abbr " " bf-my_currency.curr-name " с кодом " bf-my_currency.curr-code " ." skip
    12494               "У фирмы контрагента " bf_clients.obj-code " базовая валюта " bf-cli_currency.curr-abbr " " bf-cli_currency.curr-name " с кодом " bf-cli_currency.curr-code " ." skip
    12495               "Межфирменное перемещение невозможно."
    12496       view-as alert-box error.
    12497       return error.
    12498     end.
    12499   end.
    12500   end procedure.
    12501   procedure proc-history :
    12502     define variable loc-ref-list as character no-undo.
    12503     define variable loc-doc-save as recid     no-undo.
    12504     define variable loc-mode     as character no-undo.
    12505     define variable loc#stat     as character no-undo.
    12506     define variable loc#type     as character no-undo.
    12507     define variable loc#internal as logical   no-undo.
    12508     define buffer buffer_trn-doc for ub.trn-doc.
    12509     do on error undo, return error return-value :
    12510       if not available ub.gds-dtl then do:
    12511         message "Неправильный выбор записи." view-as alert-box.
    12512         return error.
    12513       end.
    12514       find buffer_trn-doc no-lock where buffer_trn-doc.doc-code = ub.gds-dtl.doc-code.
    12515       assign pardoc-rec      = recid( ub.gds-dtl ).
    12516   define variable vss-include-info91 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12517   do:
    12518     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    12519       (input  v-cntxt-db-num
    12520       ,input  v-cntxt-userid
    12521       ,input  0
    12522       ,input  'actn_c-documents_all':U
    12523       ,input  'object':U
    12524       ,input  v-cntxt-host-code-obj
    12525       ,input  v-cntxt-obj-type
    12526       ,input  v-cntxt-obj-code
    12527       ,input  0
    12528       ,input  0
    12529       ,input  0
    12530       ,input  true
    12531       ,output varlog
    12532       )  .
    12533   end.
    12534       if varlog <> yes then do: return no-apply. end.
    12535       run str/calldocs.w (  input  parparentproc,
    12536                         input  'doc':U,
    12537                         input  buffer_trn-doc.status_,
    12538                         input  buffer_trn-doc.doc-type,
    12539                         input  buffer_trn-doc.flag_,
    12540                         input  buffer_trn-doc.internal,
    12541                         input  "":U,
    12542                         input  buffer_trn-doc.doc-code,
    12543                         input  paris-hold ,
    12544                         input  recid(buffer_trn-doc),
    12545                         input  ub.gds-dtl.obj-type,
    12546                         input  ub.gds-dtl.obj-code,
    12547                         output loc-ref-list ).
    12548       apply "ENTRY":U to br-dtl in frame d-out-doc.
    12549     end.
    12550     end procedure.
    12551   procedure fill-mol:
    12552     if pardoc-mode = 'ИЗМЕНЕНИЕ':U or pardoc-mode = 'ДОБАВЛЕНИЕ':U
    12553     then
    12554     do:
    12555       find first ub.user-account no-lock where ub.user-account.user-id = v-cntxt-userid.
    12556       if ub.user-account.psn-code <> 0 and ub.user-account.psn-code <> ?
    12557         then
    12558       do:
    12559         if t-doc.boss = ? then do:
    12560           t-doc.boss:screen-value in frame d-out-doc = string (ub.user-account.psn-code).
    12561           apply "leave" to t-doc.boss in frame d-out-doc.
    12562         end.
    12563         if t-doc.wrkr = ?
    12564         then do:
    12565           t-doc.wrkr:screen-value in frame d-out-doc = string (ub.user-account.psn-code).
    12566           apply "leave" to t-doc.wrkr in frame d-out-doc.
    12567         end.
    12568         t-doc.agnt:screen-value in frame d-out-doc = string (ub.user-account.psn-code).
    12569         apply "leave" to t-doc.agnt in frame d-out-doc.
    12570       end.
    12571       release ub.user-account.
    12572     end.
    12573   end.
    12574   on return, leave of t-doc.tot-calc in frame d-out-doc do:
    12575   if input frame d-out-doc t-doc.tot-calc <> t-doc.tot-calc then do:
    12576     assign t-doc.tot-calc = input frame d-out-doc t-doc.tot-calc.
    12577     run gbl/calc-trn.p (input parparentproc, input recid(t-doc)) no-error.
    12578     if error-status :error then undo, return no-apply.
    12579     run ui-on ("line").
    12580   end.
    12581   end.
    12582   on return, leave of t-doc.discnt-rubl in frame d-out-doc do:
    12583     if input frame d-out-doc t-doc.discnt-rubl <> t-doc.discnt-rubl then do:
    12584       assign
    12585         frame d-out-doc t-doc.discnt-rubl.
    12586       run gbl/calc-trn.p (input parparentproc, input recid(t-doc)) no-error.
    12587       if error-status :error then do:
    12588         undo, return no-apply.
    12589       end.
    12590       run ui-on ("line").
    12591     end.
    12592   end.
    12593   on mouse-select-dblclick, return of t-doc.out-code in frame d-out-doc
    12594   do:
    12595   define buffer tdb_doc-line for ub.doc-line.
    12596   define buffer tdb_gds-dtl  for ub.gds-dtl.
    12597   find t-d-b where t-d-b.doc-code = input frame d-out-doc t-doc.out-code no-lock no-error.
    12598   if not available t-d-b then do:
    12599     apply "choose" to r-outs in frame d-out-doc.
    12600     return no-apply.
    12601   end.
    12602   run ask-copy in this-procedure no-error .
    12603   if error-status :error then return no-apply .
    12604   end.
    12605   on choose of menu-item m-outs-1 do:
    12606   if not b-add:sensitive in frame d-out-doc then do:
    12607     message "Добавление строк для этого статуса запрещено.".
    12608     return no-apply.
    12609   end.
    12610   apply "row-leave" to browse br-dtl.
    12611   if t-doc.ext-doc-type = 'ee':U
    12612   then do :
    12613     if t-doc.reason-code <> ?
    12614     and t-doc.reason-code > 0
    12615     then do :
    12616       if lookup( string(t-doc.reason-code), v-reasons-for-return) > 0
    12617       and t-doc.ext-doc-type = 'ee':U
    12618       then do :
    12619         if v-is-return
    12620         then do :
    12621           run local-outs-ret-doc no-error.
    12622           if error-status :error then undo, return no-apply.
    12623         end .
    12624         else do :
    12625           run local-m-outs-1-ret no-error.
    12626           if error-status :error then undo, return no-apply.
    12627         end .
    12628       end.
    12629       else do :
    12630         run local-m-outs-1 no-error.
    12631         if error-status :error then undo, return no-apply.
    12632       end.
    12633     end.
    12634     else do :
    12635       if v-reasonm and
    12636       lookup( t-doc.ext-doc-type, v-reasonme) = 0 and
    12637       lookup( t-doc.ext-doc-type, 'es,em,wm,im,ot,rs,mp,pc':U) = 0
    12638       then do:
    12639         message "Сначала укажите Основание" view-as alert-box .
    12640         apply "choose" to r-reas in frame d-out-doc.
    12641       end.
    12642       else do :
    12643         run local-m-outs-1 no-error.
    12644         if error-status :error then undo, return no-apply.
    12645       end.
    12646     end.
    12647   end.
    12648   else do :
    12649     run local-m-outs-1 no-error.
    12650     if error-status :error then undo, return no-apply.
    12651     if t-doc.ext-doc-type = 'ep':U  then do:
    12652        run str/ep-corrp.p (input parparentproc, input t-doc.doc-code ) no-error.
    12653     end.
    12654   end.
    12655   run ui-on ("line").
    12656   apply "entry" to br-dtl in frame d-out-doc.
    12657   end.
    12658   on choose of menu-item m-outs-10
    12659     do:
    12660       define variable old-mode     as character no-undo.
    12661       define variable old-handle   as handle    no-undo.
    12662       define variable old-type     as character no-undo.
    12663       define variable old-stat     as character no-undo.
    12664       define variable old-flag     as logical   no-undo.
    12665       define variable old-internal as logical   no-undo.
    12666       if not b-add:sensitive in frame d-out-doc then
    12667       do:
    12668         message "Добавление строк для этого статуса запрещено.".
    12669         return no-apply.
    12670       end.
    12671       apply "row-leave" to browse br-dtl.
    12672       do transaction:
    12673         run check-rate no-error.
    12674         if error-status :error then return no-apply.
    12675         run str/gds-list.w (parparentproc, t-doc.host-code, t-doc.obj-type, t-doc.obj-code).
    12676         pardoc-rec = recid (t-doc).
    12677         run waitfram-show in this-procedure (input "ЖДИТЕ.  Список добавляется в документ...").
    12678         run copy-lst in this-procedure (
    12679           input t-doc.doc-code,
    12680           input ub.sysconf.cash-pay,
    12681           input v-cntxp-doc-prt,
    12682           input table gds-list,
    12683           input "tech-marks")
    12684           no-error.
    12685         if error-status :error then
    12686         do:
    12687           apply "entry" to b-add in frame d-out-doc.
    12688           run waitfram-hide in this-procedure .
    12689           return no-apply.
    12690         end.
    12691         run waitfram-hide in this-procedure .
    12692         run gbl/calc-trn.p (input parparentproc, input recid(t-doc)) no-error.
    12693         if error-status :error then
    12694         do:
    12695           undo, return no-apply.
    12696         end.
    12697       end.
    12698       pardoc-mode = 'ИЗМЕНЕНИЕ':U.
    12699       run ui-on ("line").
    12700       apply "entry" to br-dtl in frame d-out-doc.
    12701     end.
    12702   on choose of menu-item m-outs-5 do:
    12703   if not b-add:sensitive in frame d-out-doc then do:
    12704     message "Добавление строк для этого статуса запрещено.".
    12705     return no-apply.
    12706   end.
    12707   apply "row-leave" to browse br-dtl.
    12708   run local-m-outs-5 no-error.
    12709   if error-status :error then undo, return no-apply.
    12710   if t-doc.ext-doc-type = 'ep':U  then do:
    12711      run str/ep-corrp.p (input parparentproc, input t-doc.doc-code ) no-error.
    12712   end.
    12713   run ui-on ("line").
    12714   apply "entry" to br-dtl in frame d-out-doc.
    12715   end.
    12716   on choose of menu-item m-outs-2 do:
    12717   apply "row-leave" to browse br-dtl.
    12718   do transaction :
    12719      if b-add:sensitive in frame d-out-doc then do:
    12720         run check-rate no-error.
    12721         if error-status :error then return no-apply.
    12722      end.
    12723      run str/scan.p (parparentproc, b-add:sensitive , input recid(t-doc)  , input ?) no-error.
    12724      if error-status :error then undo, return no-apply.
    12725      if t-doc.ext-doc-type = 'ep':U  then do:
    12726         run str/ep-corrp.p ( input parparentproc, input t-doc.doc-code ) no-error.
    12727       end.
    12728      else do:
    12729         run gbl/calc-trn.p ( input parparentproc, input recid(t-doc)) no-error.
    12730      end.
    12731      if error-status :error then do:
    12732        undo, return no-apply.
    12733      end.
    12734   end.
    12735   run ui-on ("line").
    12736   if prt-rec <> ? then reposition br-dtl to recid prt-rec no-error.
    12737   apply "entry" to br-dtl in frame d-out-doc.
    12738   end.
    12739   on choose of menu-item m-outs-3 do:
    12740   define variable old-mode     as   character         no-undo.
    12741   define variable old-handle   as   handle            no-undo.
    12742   define variable old-type     as   character         no-undo.
    12743   define variable old-stat     as   character         no-undo.
    12744   define variable old-flag     as   logical           no-undo.
    12745   define variable old-internal as   logical           no-undo.
    12746   if not b-add:sensitive in frame d-out-doc then do:
    12747     message "Добавление строк для этого статуса запрещено.".
    12748     return no-apply.
    12749   end.
    12750   apply "row-leave" to browse br-dtl.
    12751   do transaction:
    12752      run check-rate no-error.
    12753      if error-status :error then return no-apply.
    12754      varlog = yes.
    12755      message "Добавить товары из списка в заполняемый документ ?" skip (2)
    12756              "- добавляются, если доступны, ВСЕ ФАКТ количества по списку с текущего объекта;" skip
    12757              "- цены ставятся текущие по объекту (кроме возврата поставщику и перемещения по цене магазина);" skip
    12758              "- если цены нет или количество 0, товар пропускается."
    12759                     view-as alert-box question buttons OK-Cancel update varlog.
    12760      if varlog <> true then return no-apply.
    12761      run str/gds-list.w (parparentproc, t-doc.host-code, t-doc.obj-type, t-doc.obj-code).
    12762      pardoc-rec = recid (t-doc).
    12763      run waitfram-show in this-procedure (input "ЖДИТЕ.  Список добавляется в документ...").
    12764      run copy-lst in this-procedure (
    12765        input t-doc.doc-code,
    12766        input ub.sysconf.cash-pay,
    12767        input v-cntxp-doc-prt,
    12768        input table gds-list,
    12769        input "")
    12770        no-error.
    12771      if error-status :error then do:
    12772        apply "entry" to b-add in frame d-out-doc.
    12773        run waitfram-hide in this-procedure .
    12774        return no-apply.
    12775      end.
    12776      run waitfram-hide in this-procedure .
    12777      run gbl/calc-trn.p (input parparentproc, input recid(t-doc)) no-error.
    12778      if error-status :error then do:
    12779        undo, return no-apply.
    12780      end.
    12781   end.
    12782   pardoc-mode = 'ИЗМЕНЕНИЕ':U.
    12783   run ui-on ("line").
    12784   apply "entry" to br-dtl in frame d-out-doc.
    12785   end.
    12786   on choose of menu-item m-outs-6 do:
    12787   define variable old-mode     as   character         no-undo.
