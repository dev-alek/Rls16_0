     9968   ON CHOOSE OF b-next IN FRAME d-out-doc
     9969   DO:
     9970     RUN step-next in this-procedure .
     9971   END.
     9972   procedure step-next:
     9973   define variable cur-form as char no-undo.
     9974   define variable new-form as char no-undo.
     9975   define buffer new_trn-doc for ub.trn-doc  .
     9976   case t-doc.doc-type:
     9977     when 'при':U then
     9978       cur-form = if t-doc.internal then 'рас':U else 'при':U.
     9979     when 'рас':U or when 'возврат':U or when 'спи':U then
     9980       cur-form = 'рас':U.
     9981     when 'инв':U then cur-form = 'инв':U.
     9982   end case.
     9983   if bf-handle = ? then return .
     9984   if valid-handle (br-handle) then do:
     9985     varlog = br-handle:select-next-row().
     9986     find first new_trn-doc no-lock where  recid( new_trn-doc ) = bf-handle:recid no-error .
     9987     if not varlog then message "Это последний документ списка.".
     9988   end.
     9989   case new_trn-doc.doc-type:
     9990     when 'при':U then
     9991       new-form = if new_trn-doc.internal then 'рас':U else 'при':U.
     9992     when 'рас':U or when 'возврат':U or when 'спи':U then
     9993       new-form = 'рас':U.
     9994     when 'инв':U then new-form = 'инв':U.
     9995   end case.
     9996   assign
     9997       pardoc-rec   = bf-handle:recid
     9998       parnext-prev = ( cur-form = new-form ) .
     9999   end procedure.
    10000   ON CHOOSE OF b-prev IN FRAME d-out-doc
    10001   DO:
    10002     run step-prev in this-procedure .
    10003   END.
    10004   procedure step-prev:
    10005   define variable cur-form as char no-undo.
    10006   define variable new-form as char no-undo.
    10007   define buffer new_trn-doc for ub.trn-doc  .
    10008   case t-doc.doc-type:
    10009     when 'при':U then if t-doc.internal then cur-form = 'рас':U. else cur-form = 'при':U.
    10010     when 'рас':U or when 'возврат':U or when 'спи':U then cur-form = 'рас':U.
    10011     when 'инв':U then cur-form = 'инв':U.
    10012   end case.
    10013   if bf-handle = ? then return .
    10014   if valid-handle (br-handle) then do:
    10015     varlog = br-handle:select-prev-row().
    10016     find first new_trn-doc no-lock where  recid( new_trn-doc ) = bf-handle:recid no-error .
    10017     if not varlog then message "Это первый документ списка.".
    10018   end.
    10019   case new_trn-doc.doc-type :
    10020     when 'при':U then if new_trn-doc.internal then new-form = 'рас':U. else new-form = 'при':U.
    10021     when 'рас':U or when 'возврат':U or when 'спи':U then  new-form = 'рас':U.
    10022     when 'инв':U then new-form = 'инв':U.
    10023   end case.
    10024   assign
    10025     pardoc-rec   = bf-handle:recid
    10026     parnext-prev = (cur-form = new-form)
    10027   .
    10028   end procedure.
