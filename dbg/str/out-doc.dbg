    10307       end.
    10308     end.
    10309   end procedure.
    10310   procedure ver-clients :
    10311   define input  parameter p-obj-type as character no-undo .
    10312   define input  parameter p-obj-code as integer   no-undo .
    10313   define output parameter p-error as logical   no-undo .
    10314   define variable v-veto-man-doc as character no-undo .
    10315   define variable v-type        as character no-undo .
    10316     do
    10317     on error undo, return error return-value
    10318     :
    10319     p-error = false .
    10320   run clntattr-value in this-procedure (
    10321    input p-obj-type ,
    10322    input p-obj-code ,
    10323    input 'veto-man-doc':U     ,
    10324    output v-veto-man-doc ,
    10325    output v-type        ) no-error .
    10326    if error-status :error then message
    10327      error-status :get-message(1) skip
    10328      return-value skip
    10329      "Ошибка clntattr-veto-man-doc"
    10330      view-as alert-box error
    10331    .
    10332     if v-veto-man-doc = 'ALL' then do:
    10333         message "Запрещено создание документа на этого контрагента оператору вручную." view-as alert-box error  .
    10334         p-error = true .
    10335     end.
    10336    end.
    10337   end procedure.
    10338   on end-error, stop of frame d-out-doc do:
    10339     apply "choose" to b-exit in frame d-out-doc.
    10340     return no-apply.
    10341   end.
    10342   on choose of b-notes in frame d-out-doc run notes-tr.
    10343   on choose of b-history   in frame d-out-doc do:
    10344     run proc-history in this-procedure no-error.
    10345     if error-status :error then do: return no-apply. end.
    10346   end.
    10347   on choose of b-exit  in frame d-out-doc
    10348   do:
    10349     run proc-exit no-error.
    10350     if error-status :error then do: return no-apply. end.
    10351   end.
    10352   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10353   ON MOUSE-SELECT-DBLCLICK, return OF t-doc.agnt IN FRAME d-out-doc
    10354   DO:
    10355     run local-psn-chk ("agnt", "ret-mouse").
    10356     apply "entry" to t-doc.boss in frame d-out-doc.
    10357     return no-apply.
    10358   END.
    10359   ON MOUSE-SELECT-DBLCLICK, return OF t-doc.boss IN FRAME d-out-doc
    10360   DO:
    10361     RUN local-psn-chk ("boss", "ret-mouse").
    10362     apply "entry" to b-exit in frame d-out-doc.
    10363     return no-apply.
    10364   END.
    10365   ON MOUSE-SELECT-DBLCLICK, return OF t-doc.wrkr IN FRAME d-out-doc
    10366   DO:
    10367     RUN local-psn-chk ("wrkr", "ret-mouse").
    10368     apply "entry" to t-doc.agnt in frame d-out-doc.
    10369     return no-apply.
    10370   END.
    10371   ON CHOOSE OF r-agnt IN FRAME d-out-doc
    10372   DO:
    10373     RUN local-psn-chk ("agnt", "button").
    10374     apply "entry" to t-doc.boss in frame d-out-doc.
    10375     return no-apply.
    10376   END.
    10377   ON CHOOSE OF r-boss IN FRAME d-out-doc
    10378   DO:
    10379     RUN local-psn-chk ("boss", "button").
    10380     apply "entry" to b-exit in frame d-out-doc.
    10381     return no-apply.
    10382   END.
    10383   ON CHOOSE OF r-wrkr IN FRAME d-out-doc
    10384   DO:
    10385     run local-psn-chk ("wrkr", "button").
    10386     apply "entry" to t-doc.agnt in frame d-out-doc.
    10387     return no-apply.
    10388   END.
    10389   on leave of t-doc.agnt in frame d-out-doc  do:
    10390     if not available t-doc then return .
    10391     if input frame d-out-doc t-doc.agnt <> t-doc.agnt then do:
    10392       run local-psn-chk ("agnt", "leave").
    10393     end.
    10394   end.
    10395   on leave of t-doc.boss in frame d-out-doc   do:
    10396     if not available t-doc then return .
    10397     if input frame d-out-doc t-doc.boss <> t-doc.boss then do:
    10398       run local-psn-chk ("boss", "leave").
    10399     end.
    10400   end.
    10401   on leave of t-doc.wrkr in frame d-out-doc  do:
    10402     if not available t-doc then return .
    10403     if input frame d-out-doc t-doc.wrkr <> t-doc.wrkr then do:
    10404       run local-psn-chk ("wrkr", "leave").
    10405     end.
    10406   end.
    10407   procedure local-psn-chk :
    10408     define input parameter parman    as character no-undo.
    10409     define input parameter paraction as character no-undo.
    10410     if parman = "agnt" and paraction = "ret-mouse" then do:
    10411     define variable v-ref-rec63   as recid no-undo .
    10412     find cli-buf where cli-buf.obj-code = input frame d-out-doc t-doc.agnt
    10413                    and cli-buf.obj-type = 'чел':U no-lock no-error.
    10414     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:
    10415       if input frame d-out-doc t-doc.agnt <> ""
    10416          and input frame d-out-doc t-doc.agnt <> ? then
    10417         message "Из справочника клиентов Вы должны выбрать человека.".
    10418       run ref/cli-all.w (  input parparentproc
    10419                     ,  input "b-sel"
    10420                     ,  input 'чел':U
    10421                     ,  input ?
    10422                     ,  input ?
    10423                     ,  input ref-rec
    10424                     ,  input ",,,,,,NO"
    10425                     ,  input "lock-cli-type"
    10426                     , output ref-list ) .
    10427       assign v-ref-rec63 = integer( ref-list ).
    10428       ref-rec = integer( ref-list ) .
    10429       find cli-buf where recid (cli-buf) =
    10430          ref-rec
    10431          no-lock no-error.
    10432       if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then
    10433         find cli-buf where cli-buf.obj-code = input frame d-out-doc t-doc.agnt
    10434                              and cli-buf.obj-type = 'чел':U no-lock no-error.
    10435     end.
    10436     if available cli-buf and can-do( 'чел':U, cli-buf.obj-type ) then do:
    10437       display cli-buf.obj-code @ t-doc.agnt
    10438               cli-buf.obj-name @ agnt-name with frame d-out-doc.
    10439       assign frame d-out-doc t-doc.agnt.
    10440     end.
    10441     else display ? @ t-doc.agnt
    10442                  ? @ agnt-name with frame d-out-doc.
    10443     apply "entry" to t-doc.boss
    10444                               in frame d-out-doc.
    10445   if available cli-buf then do:
    10446         display cli-buf.obj-code @ t-doc.agnt cli-buf.obj-name @ agnt-name with frame d-out-doc.
    10447     end.
