    15197             find first buf_contract-attr no-lock where buf_contract-attr.host-code = reas_contract.host-code
    15198                                                    and buf_contract-attr.contract-code = reas_contract.contract-code
    15199                                                    and buf_contract-attr.attr-code = "contract-edi"
    15200                                                    no-error .
    15201             if available buf_contract-attr
    15202             and logical(buf_contract-attr.attr-value) = true
    15203             then do :
    15204               is-contract-edo = yes .
    15205             end .
    15206             else do :
    15207               find first buf_contract-attr no-lock where buf_contract-attr.host-code = reas_contract.host-code
    15208                                                      and buf_contract-attr.contract-code = reas_contract.contract-code
    15209                                                      and buf_contract-attr.attr-code = "contract-diadoc"
    15210                                                      no-error .
    15211               if available buf_contract-attr
    15212               and logical(buf_contract-attr.attr-value) = true
    15213               then do :
    15214                 is-contract-edo = yes .
    15215               end .
    15216             end .
    15217             if is-contract-edo
    15218             and EDOParSec:IsEdo
    15219             then do :
    15220               edo-return = yes .
    15221   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t-doc.doc-code ,
    15222                          input 'edo-return':U ,
    15223                          input yes ) no-error .
    15224               if error-status :error then
    15225               do:
    15226                 message error-status :error error-status :get-message( 1 ) '"' + 'edo-return':U + '"'
    15227                   view-as alert-box error.
    15228               end.
    15229             end .
    15230             else do :
    15231               edo-return = no .
    15232   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t-doc.doc-code ,
    15233                          input 'edo-return':U ,
    15234                          input no ) no-error .
    15235               if error-status :error then
    15236               do:
    15237                 message error-status :error error-status :get-message( 1 ) '"' + 'edo-return':U + '"'
    15238                   view-as alert-box error.
    15239               end.
    15240             end .
    15241           end .
    15242         end .
    15243         if v-is-return
    15244         then do :
    15245           if t-doc.contract-code > 0
    15246           then do :
    15247             find first reas_contract where reas_contract.host-code     = t-doc.host-code  and
    15248                                            reas_contract.contract-code = t-doc.contract-code no-lock no-error.
    15249             if available reas_contract
    15250             then do :
    15251               find first buf_contract-attr no-lock where buf_contract-attr.host-code = reas_contract.host-code
    15252                                                      and buf_contract-attr.contract-code = reas_contract.contract-code
    15253                                                      and buf_contract-attr.attr-code = "contract-edi"
    15254                                                      no-error .
    15255               if available buf_contract-attr
    15256               and logical(buf_contract-attr.attr-value) = true
    15257               then do :
    15258                 is-contract-edo = yes .
    15259               end .
    15260               else do :
    15261                 find first buf_contract-attr no-lock where buf_contract-attr.host-code = reas_contract.host-code
    15262                                                        and buf_contract-attr.contract-code = reas_contract.contract-code
    15263                                                        and buf_contract-attr.attr-code = "contract-diadoc"
    15264                                                        no-error .
    15265                 if available buf_contract-attr
    15266                 and logical(buf_contract-attr.attr-value) = true
    15267                 then do :
    15268                   is-contract-edo = yes .
    15269                 end .
    15270               end .
    15271               if is-contract-edo
    15272               and EDOParSec:IsEdo
    15273               then do :
    15274   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
    15275                           input 'edo-return':U ,
    15276                          output varvalue ,
    15277                          output vartype ) no-error .
    15278                 if varvalue = "yes"
    15279                 then do:
    15280                   edo-return = yes .
    15281                   disable b-bc with frame d-out-doc.
    15282                 end.
    15283                 else do :
    15284                   edo-return = no .
    15285                 end .
    15286                 display edo-return with frame d-out-doc.
    15287                 if pardoc-mode <> 'ПРОСМОТР':U
    15288                 then do :
    15289                   enable edo-return with frame d-out-doc.
    15290                 end .
    15291               end .
    15292               else do :
    15293                 edo-return = no .
    15294                 display edo-return with frame d-out-doc.
    15295                 disable edo-return with frame d-out-doc.
    15296               end .
    15297             end .
    15298           end .
    15299           if pardoc-mode <> 'ДОБАВЛЕНИЕ':U
    15300           then do :
    15301             disable r-reas r-clients t-doc.cli-code b-cur r-outs with frame d-out-doc.
    15302           end .
    15303         end .
    15304     if pardoc-mode = 'ДОБАВЛЕНИЕ':U and
    15305        (t-doc.ext-doc-type = 'iv':U or
    15306         t-doc.ext-doc-type = 'ev':U) then do:
    15307         run create-record in this-procedure (  input t-doc.doc-code
    15308                                              , input 'othermoves':U
    15309                                              , input "yes":U
    15310                                              , output vExist ) .
    15311     end.
    15312   if pardoc-mode = 'ДОБАВЛЕНИЕ':U then do:
    15313     wait-for go of frame d-out-doc focus t-doc.cli-code.
    15314   end.
    15315   else do:
    15316     wait-for go of frame d-out-doc focus br-dtl.
    15317   end.
    15318   end.
    15319   end.
    15320   run disable_ui in this-procedure.
    15321   PROCEDURE add-doc-line-local :
    15322   define buffer bf_contract-specif for ub.contract-specif.
    15323   define buffer bf-hv_doc-line     for ub.doc-line.
    15324   define buffer bf_goods           for ub.goods.
    15325   define variable varschartic like ub.doc-line.artic initial " " no-undo.
    15326   define variable v-choice    as   integer                    no-undo.
    15327   define variable v-rid       as   integer                    no-undo.
    15328   define variable v-rid-list  as   char                       no-undo.
    15329   define variable i           as   integer                    no-undo.
    15330   do on stop undo, return error return-value :
    15331     run corr-t-doc in this-procedure no-error.
    15332     if error-status:error then do:
    15333       return error return-value.
    15334     end.
    15335     v-choice = 0.
    15336     if t-doc.contract-code <> 0 then do:
    15337       find first bf_contract-specif where bf_contract-specif.host-code    = ( if is-doc-hold then t-doc.cli-code  else t-doc.host-code )      and
    15338                                           bf_contract-specif.contract-num = t-doc.contract-code no-lock no-error.
    15339       if available bf_contract-specif then do:
    15340         run gbl/d-askw.w
    15341           (input "Добавление товаров"
    15342           ,input "Выберите один из пунктов для добавления в накладную" + chr(10)
    15343                + "товаров по спецификации к договору" + chr(10)
    15344           ,input "|"
    15345           ,input "Все|Выборочно|По справочнику|Отказ"
    15346           ,input "Все недобавленные товары по спецификации|"
    15347                + "Выборочно товары по спецификации|"
    15348                + "Выбор товаров из справочника|"
    15349                + "Отказ от выполнения операции"
    15350           ,input 1
    15351           ,input 4
    15352           ,output v-choice
    15353           ).
    15354         if v-choice = 4 then do:
    15355           run UI-on in this-procedure ( input "line" ).
    15356           return.
    15357         end.
    15358       end.
    15359     end.
    15360     if v-choice = 0 then
    15361       v-choice = 3.
    15362   define variable  varnotes  as character no-undo .
    15363     assign
    15364       varnotes = '':u
    15365       varlns-cnt = 1.
    15366     case v-choice:
    15367       when 1 then do:
    15368         for each bf_contract-specif where bf_contract-specif.host-code    = ( if is-doc-hold then t-doc.cli-code  else t-doc.host-code )      and
    15369                                           bf_contract-specif.contract-num = t-doc.contract-code no-lock
    15370             on error undo, return error return-value :
    15371           find first bf_goods where bf_goods.gds-code = bf_contract-specif.gds-code no-lock.
    15372           find first bf-hv_doc-line where bf-hv_doc-line.doc-code  = t-doc.doc-code     and
    15373                                           bf-hv_doc-line.artic     = bf_goods.artic     and
    15374                                           bf-hv_doc-line.prod-type = bf_goods.prod-type and
    15375                                           bf-hv_doc-line.prod-code = bf_goods.prod-code no-lock no-error.
    15376           if not available bf-hv_doc-line then do:
    15377             assign
    15378               varnotes = varnotes + (if varnotes = '':u then '':u else ',':u) + string(recid(bf_goods)).
    15379           end.
    15380         end.
    15381         if varnotes = '':u then do:
    15382           message "Вы добавили уже все товары по спецификации."
    15383           view-as alert-box.
    15384         end.
    15385       end.
    15386       when 2 then do:
    15387         run str/contspec.w (input parparentproc,
    15388                         input "b-sel,b-mark",
    15389                         input 'ПРОСМОТР':U,
    15390                         input ( if is-doc-hold then t-doc.cli-code  else t-doc.host-code ) ,
    15391                         input t-doc.contract-code,
    15392                         output v-rid-list) .
    15393         if v-rid-list = '':u then do:
    15394           message "Нет выбранных товаров по спецификации."
    15395             view-as alert-box.
    15396         end.
    15397         do i = 1 to num-entries(v-rid-list):
    15398           v-rid = integer(entry(i, v-rid-list)).
    15399           find bf_contract-specif where recid(bf_contract-specif) = v-rid no-lock no-error.
    15400           if available bf_contract-specif then do:
    15401             find first bf_goods where bf_goods.gds-code = bf_contract-specif.gds-code no-lock.
    15402             assign
    15403               varnotes = varnotes + (if varnotes = '':u then '':u else ',':u) + string(recid(bf_goods)).
    15404           end.
    15405         end.
    15406       end.
    15407       when 3 then do:
    15408         run str/chs-gds.w ( input parparentproc
    15409                       , input v-cntxt-obj-type
    15410                       , input v-cntxt-obj-code
    15411                       , input parlist-mode
    15412                       , input t-doc.status_
    15413                       , input "Строка ПН № " + t-doc.doc-code + " " + t-doc.status_ + " " + string (t-doc.flag_, "+/-")
    15414                       , 'факт':U
    15415                       , input t-doc.cli-type
    15416                       , input t-doc.cli-code
    15417                       , input t-doc.host-code
    15418                       , input t-doc.ext-doc-type
    15419                       , input-output varschartic
    15420                       , output varnotes) no-error.
    15421       end.
    15422     end case.
    15423     run cycle-add in this-procedure.
    15424     run UI-on     in this-procedure ( input "line" ).
    15425   end.
    15426   END PROCEDURE.
    15427   PROCEDURE add-rate :
    15428   reposition br-dtl to recid recid(ub.doc-line).
    15429   display ub.gds-dtl.fact-qnty + rate @ ub.gds-dtl.fact-qnty with browse br-dtl.
    15430   END PROCEDURE.
    15431   PROCEDURE after_qnty :
    15432     define  input parameter p-gds-dtl-rec  as   recid                no-undo.
    15433     define output parameter p-out-qnty-kg  like ub.gds-dtl.fact-qnty no-undo initial 0.0.
    15434     define variable p-inv-line-rec as recid   no-undo.
    15435     define variable is-petrol      as logical no-undo.
    15436     define variable is-pieces      as logical no-undo.
    15437     define buffer buf_inv-line for ub.inv-line.
    15438     define buffer buf_gds-dtl  for ub.gds-dtl.
    15439     do on error undo, return error return-value :
    15440       find buf_gds-dtl        no-lock where recid( buf_gds-dtl ) = p-gds-dtl-rec no-error.
    15441       if not available buf_gds-dtl then do:
    15442         assign p-out-qnty-kg = ?.
    15443         undo, return error "after_qnty: не найдена строка накладной".
    15444       end.
    15445   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
    15446     (
    15447        input buf_gds-dtl.artic
    15448     ,  input buf_gds-dtl.prod-type
    15449     ,  input buf_gds-dtl.prod-code
    15450     , output is-petrol
    15451     , output is-pieces
    15452     ) no-error.
    15453       if error-status :error or v-is-ptrl <> "yes" or is-petrol <> yes or is-pieces <> no then do:
    15454         undo, return error substitute( 'inv-line_price: &1 (произв. &2 &3) не топливный товар',
    15455                                        buf_gds-dtl.artic, buf_gds-dtl.prod-type, buf_gds-dtl.prod-code ).
    15456       end.
    15457       find buf_inv-line          no-lock where
    15458            buf_inv-line.doc-code  = buf_gds-dtl.doc-code  and
    15459            buf_inv-line.artic     = buf_gds-dtl.artic     and
    15460            buf_inv-line.prod-code = buf_gds-dtl.prod-code and
    15461            buf_inv-line.prod-type = buf_gds-dtl.prod-type no-error.
    15462       if available buf_inv-line then do:
    15463         assign
    15464           p-inv-line-rec = recid( buf_inv-line )
    15465         .
    15466         find buf_gds-dtl  exclusive-lock where recid( buf_gds-dtl  ) = p-gds-dtl-rec.
    15467         find buf_inv-line exclusive-lock where recid( buf_inv-line ) = p-inv-line-rec.
    15468         assign
    15469           p-out-qnty-kg = buf_inv-line.after-cli-qnty
    15470         .
    15471         find buf_inv-line        no-lock where recid( buf_inv-line ) = p-inv-line-rec.
    15472         find buf_gds-dtl         no-lock where recid( buf_gds-dtl  ) = p-gds-dtl-rec.
    15473         release buf_inv-line.
    15474         release buf_gds-dtl.
    15475       end.
    15476     end.
    15477   END PROCEDURE.
    15478   PROCEDURE ask-copy :
    15479   define buffer tdb_doc-line    for ub.doc-line.
    15480   define buffer tdb_gds-dtl     for ub.gds-dtl.
    15481   define buffer tdb_parts       for ub.parts .
    15482   define buffer buf_parts       for ub.parts .
    15483   define buffer buf-cli_clients for ub.clients  .
    15484   define variable v-num as integer initial 1 no-undo.
    15485   for each t-d-b-doc-line :
    15486     delete t-d-b-doc-line.
    15487   end.
    15488   for each t-d-b-gds-dtl :
    15489     delete t-d-b-gds-dtl.
    15490   end.
    15491   for each t-d-b-parts :
    15492     delete t-d-b-parts.
    15493   end.
    15494   for each tdb_doc-line where tdb_doc-line.doc-code = t-d-b.doc-code on error undo, return no-apply :
    15495     create t-d-b-doc-line.
    15496     buffer-copy tdb_doc-line to t-d-b-doc-line.
    15497   end.
    15498   for each tdb_gds-dtl where tdb_gds-dtl.doc-code = t-d-b.doc-code on error undo, return no-apply :
    15499     create t-d-b-gds-dtl.
    15500     buffer-copy tdb_gds-dtl to t-d-b-gds-dtl.
    15501   end.
    15502   if t-doc.ext-doc-type = 'ep':U then do:
    15503     run gbl/d-askw.w
    15504       (input "Вопрос"
    15505       ,input "По каким количествам будем производить копирование?"
    15506               + chr(10) + (if t-d-b.status_ <> 'запрос':U then "Внимание ! Если добавляемое количество какого-либо товара недоступно, оно будет уменьшено." else "":U)
    15507       ,input "|^"
    15508       ,input "Фактическим|"
    15509              + "Документарным|"
    15510              + "Партии источн.|"
    15511              +  "Отмена"
    15512       ,input "Исходя из фактических количеств в строке документа. При этом берутся любые партии от этого поставщика|"
    15513           + "Исходя из документарных количеств в строке документа. При этом берутся любые партии от этого поставщика|"
    15514           + "Исходя из фактических количеств в партиях документа. Если свободное количество данной партии меньше чем в документе источнике, то берется все свободное количество.|"
    15515           + "Отменить копирование."
    15516       ,input 1
    15517       ,input 4
    15518       ,output v-num
    15519       ).
    15520     if v-num = 4 then do:
    15521       return no-apply.
    15522     end.
    15523     if v-num = 3 then do:
    15524       for each t-d-b-doc-line where t-d-b-doc-line.doc-code = t-d-b.doc-code on error undo, return no-apply :
    15525         for each buf_parts
    15526           where buf_parts.obj-type  = t-d-b-doc-line.obj-type
    15527             and buf_parts.obj-code  = t-d-b-doc-line.obj-code
    15528             and buf_parts.artic     = t-d-b-doc-line.artic
    15529             and buf_parts.prod-type = t-d-b-doc-line.prod-type
    15530             and buf_parts.prod-code = t-d-b-doc-line.prod-code
    15531             and buf_parts.out-code  = t-d-b.doc-code
    15532         on error undo, return no-apply
    15533         :
    15534           if buf_parts.supp-type = t-doc.cli-type
    15535             and buf_parts.supp-code = t-doc.cli-code
    15536           then do:
    15537             find first tdb_parts
    15538               where tdb_parts.obj-type  = buf_parts.obj-type
    15539                 and tdb_parts.obj-code  = buf_parts.obj-code
    15540                 and tdb_parts.artic     = buf_parts.artic
    15541                 and tdb_parts.prod-type = buf_parts.prod-type
    15542                 and tdb_parts.prod-code = buf_parts.prod-code
    15543                 and tdb_parts.in-code   = buf_parts.in-code
    15544                 and tdb_parts.out-code  = 'free-zone':U
    15545                 and tdb_parts.part-code = buf_parts.part-code
    15546               no-error .
    15547             if available tdb_parts then do:
    15548               create t-d-b-parts.
    15549               if tdb_parts.fact-qnty > buf_parts.fact-qnty then do:
    15550                 buffer-copy buf_parts to t-d-b-parts .
    15551               end.
    15552               else do:
    15553                 buffer-copy tdb_parts to t-d-b-parts
    15554                   assign
    15555                     t-d-b-parts.out-code = t-d-b-doc-line.doc-code
    15556                   .
    15557               end.
    15558             end.
    15559           end.
    15560         end.
    15561       end.
    15562     end.
    15563   end.
    15564   block_copy:
    15565   do transaction
    15566   on error undo, return error return-value
    15567   on stop  undo, return error "stop"
    15568   :
    15569     if t-doc.ext-doc-type <> 'ep':U then do:
    15570       run gbl/d-askw.w
    15571         (input "Вопрос"
    15572         ,input "По каким количествам будем производить копирование?"
    15573               + chr(10) + (if t-d-b.status_ <> 'запрос':U then "Внимание ! Если добавляемое количество какого-либо товара недоступно, оно будет уменьшено." else "":U)
    15574         ,input "|^"
    15575         ,input "Фактическим|"
    15576             + "Документарным|"
    15577             + "По Партиям|"
    15578             + "Отмена"
    15579         ,input "Исходя из фактических количеств в признаках.|"
    15580             + "Исходя из документарных количеств в признаках.|"
    15581             + "Копировать партии источника.|"
    15582             + "Отменить копирование."
    15583         ,input 1
    15584         ,input 4
    15585         ,output v-num
    15586         ).
    15587       if v-num = 4 then do:
    15588         undo, leave block_copy .
    15589       end.
    15590     if v-num = 3 then do:
    15591       for each t-d-b-doc-line where t-d-b-doc-line.doc-code = t-d-b.doc-code on error undo, return no-apply :
    15592         for each buf_parts
    15593           where buf_parts.obj-type  = t-d-b-doc-line.obj-type
    15594             and buf_parts.obj-code  = t-d-b-doc-line.obj-code
    15595             and buf_parts.artic     = t-d-b-doc-line.artic
    15596             and buf_parts.prod-type = t-d-b-doc-line.prod-type
    15597             and buf_parts.prod-code = t-d-b-doc-line.prod-code
    15598             and buf_parts.out-code  = t-d-b.doc-code
    15599         on error undo, return no-apply
    15600         :
    15601             find first tdb_parts
    15602               where tdb_parts.obj-type  = buf_parts.obj-type
    15603                 and tdb_parts.obj-code  = buf_parts.obj-code
    15604                 and tdb_parts.artic     = buf_parts.artic
    15605                 and tdb_parts.prod-type = buf_parts.prod-type
    15606                 and tdb_parts.prod-code = buf_parts.prod-code
    15607                 and tdb_parts.in-code   = buf_parts.in-code
    15608                 and tdb_parts.out-code  = 'free-zone':U
    15609                 and tdb_parts.part-code = buf_parts.part-code
    15610               no-error .
    15611             if available tdb_parts then do:
    15612               create t-d-b-parts.
    15613               if tdb_parts.fact-qnty > buf_parts.fact-qnty then do:
    15614                 buffer-copy buf_parts to t-d-b-parts .
    15615               end.
    15616               else do:
    15617                 buffer-copy tdb_parts to t-d-b-parts
    15618                   assign
    15619                     t-d-b-parts.out-code = t-d-b-doc-line.doc-code
    15620                   .
    15621               end.
    15622           end.
    15623         end.
    15624       end.
    15625     end.
    15626     end.
    15627   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_copy-ret in g#lib-trn
    15628     (
    15629       input parparentproc
    15630     , input t-d-b.doc-code
    15631     , input t-d-b.doc-type
    15632     , input t-d-b.status_
    15633     , input t-d-b.internal
    15634     , input t-d-b.cli-type
    15635     , input t-d-b.cli-code
    15636     , input t-d-b.discnt-type
    15637     , input t-d-b.tot-calc
    15638     , input t-d-b.discnt-pc
    15639     , input t-d-b.agnt
    15640     , input t-d-b.boss
    15641     , input t-d-b.wrkr
    15642     , input t-d-b.base-rate
    15643     , input t-d-b.base-scale
    15644     , input t-d-b.exch-code
    15645     , input t-d-b.vat-type
    15646     , input t-doc.doc-code
    15647     , input t-doc.discnt-type:sensitive in frame d-out-doc
    15648     , input input frame d-out-doc t-doc.discnt-pc
    15649     , input input frame d-out-doc t-doc.agnt
    15650     , input input frame d-out-doc t-doc.boss
    15651     , input input frame d-out-doc t-doc.wrkr
    15652     , input input frame d-out-doc t-doc.base-rate
    15653     , input input frame d-out-doc t-doc.base-scale
    15654     , input ub.sysconf.cash-pay
    15655     , input ub.sysconf.base-code
    15656     , input-output table t-d-b-doc-line
    15657     , input-output table t-d-b-gds-dtl
    15658     , input-output table t-d-b-parts
    15659     , input (if v-num = 3 then yes else no)
    15660     , input (if v-num = 3 then yes else no)
    15661     , input no
    15662     , input (if v-num = 1 or v-num = 3 then yes else no)
    15663     ) no-error.
    15664     if error-status :error then do:
    15665       message "Ошибка при копировании документа." skip
    15666               return-value skip
    15667               error-status:get-message(1) skip
    15668               error-status:get-message(2) skip
    15669               error-status:get-message(3) skip
    15670       view-as alert-box error.
    15671       return error.
    15672     end.
    15673     run str/crdocpl.p
    15674       ( input t-doc.doc-code
    15675        ,input ?
    15676        ,input "dens_doc-line":U
    15677       ) no-error .
    15678     if error-status :error then do:
    15679       message
    15680         "Ошибка при копировании документа (создание информации по складским местам)." skip
    15681         return-value skip
    15682         error-status:get-message(1) skip
    15683         error-status:get-message(2) skip
    15684         error-status:get-message(3) skip
    15685         view-as alert-box error.
    15686       return error .
    15687     end.
    15688     run gbl/calc-trn.p (input parparentproc, input recid(t-doc)) no-error.
    15689     if error-status :error then do:
    15690       message
    15691         "Ошибка при копировании документа (расчет шапки документа)." skip
    15692         return-value skip
    15693         error-status:get-message(1) skip
    15694         error-status:get-message(2) skip
    15695         error-status:get-message(3) skip
    15696         view-as alert-box error.
    15697       return error .
    15698     end.
    15699   end.
    15700   for each t-d-b-doc-line :
    15701     delete t-d-b-doc-line.
    15702   end.
    15703   for each t-d-b-gds-dtl :
    15704     delete t-d-b-gds-dtl.
    15705   end.
    15706   for each t-d-b-parts :
    15707     delete t-d-b-parts.
    15708   end.
    15709   pardoc-mode = 'ИЗМЕНЕНИЕ':U.
    15710   run ui-on ("line").
    15711   apply "entry" to br-dtl in frame d-out-doc.
    15712   END PROCEDURE.
    15713   procedure chg-purch-contract :
    15714   end procedure.
    15715   PROCEDURE ch-discnt :
    15716   define variable hist-list as character no-undo.
    15717   define buffer buf_c-dis-card for ub.c-dis-card.
    15718   define buffer buf_c-dc-hist for ub.c-dc-hist.
    15719   if input frame d-out-doc t-doc.discnt-type = 'карта':U then do:
    15720     run ref/discards.w (
    15721                      input parparentproc
    15722                     ,input "b-sel"
    15723                     ,input "client":U
    15724                     ,input t-doc.host-code
    15725                     ,input t-doc.obj-type
    15726                     ,input t-doc.obj-code
    15727                     ,input '':U
    15728                     ,input recid (ub.clients)
    15729                     ,output ref-list).
    15730     if ref-list = "" then do:
    15731       display t-doc.discnt-type with frame d-out-doc.
    15732       return error.
    15733     end.
    15734     find ub.dis-card where recid (ub.dis-card) = integer (ref-list) no-lock.
    15735     if ub.dis-card.status_ = 'неисп':U
    15736     or ub.dis-card.status_ = 'смкли':U
    15737     then do:
    15738       message
    15739       substitute("Нельзя создать докуиент с картой &1&2" +
    15740                   "Карта имеет статус &3, &4"
    15741                   , ub.dis-card.d-card
    15742                   , chr(10)
    15743                   , ub.dis-card.status_
    15744                   , (if ub.dis-card.status_ = 'неисп':U
    15745                       then "карта должна быть ОКОНЧАТЕЛЬНО удалена"
    15746                       else "карта будет доступна по окончании процесса смены владельца")
    15747                   )
    15748       view-as alert-box error .
    15749       return error.
    15750     end.
    15751     assign
    15752       t-doc.d-card    = ub.dis-card.d-card.
    15753     assign varlog = yes.
    15754     message "Текущий процент по дисконтной карте " ub.dis-card.d-card " равен " ub.dis-card.d-pcnt " ." skip
    15755             "Будем оформлять накладную, исходя из данного процента?" view-as alert-box question buttons yes-no update varlog.
    15756     if varlog then do:
    15757       assign
    15758         t-doc.discnt-pc = ub.dis-card.d-pcnt
    15759         t-doc.d-card    = ub.dis-card.d-card.
    15760     end.
    15761     else do:
    15762       run ref/cdchist.w (
    15763                       INPUT  parparentproc
    15764                       ,input t-doc.host-code
    15765                       ,input t-doc.obj-type
    15766                       ,input t-doc.obj-code
    15767                       ,input "b-sel":U
    15768                       ,input "subject":U
    15769                       ,input ub.dis-card.d-card
    15770                       ,input ub.dis-card.card-num
    15771                       ,input t-doc.obj-type
    15772                       ,input t-doc.obj-code
    15773                       ,input t-doc.host-code
    15774                       ,input v-cntxt-db-num
    15775                       ,input "":U
    15776                       ,input 'dis-card':U
    15777                       ,input v-cntxt-db-num
    15778                       ,input-output hist-list
    15779                    ) no-error .
    15780       if error-status :error or
    15781          hist-list = "" then do:
    15782          message "Не смог взять процент из истории. Берем текущий процент."
    15783          view-as alert-box information.
    15784          assign
    15785            t-doc.discnt-pc = ub.dis-card.d-pcnt
    15786            t-doc.d-card    = ub.dis-card.d-card.
    15787       end.
    15788       else do:
    15789         find first buf_c-dc-hist where
    15790                 recid(buf_c-dc-hist) = integer(hist-list) no-lock no-error.
    15791         if available buf_c-dc-hist then do:
    15792           find first buf_c-dis-card no-lock where
    15793                     buf_c-dis-card.d-card           = buf_c-dc-hist.d-card
    15794                 AND buf_c-dis-card.chip-num         = buf_c-dc-hist.chip-num
    15795                 AND buf_c-dis-card.corr-user-db-num = buf_c-dc-hist.corr-user-db-num  no-error .
    15796         end.
    15797         if not available buf_c-dc-hist
    15798         or not available buf_c-dis-card
    15799         then do:
    15800            message "Не смог взять процент из истории. Берем текущий процент."
    15801            view-as alert-box information.
    15802            assign
    15803            t-doc.discnt-pc = ub.dis-card.d-pcnt
    15804            t-doc.d-card    = ub.dis-card.d-card.
    15805         end.
    15806         else do:
    15807           assign
    15808           t-doc.discnt-pc = decimal(buf_c-dis-card.d-pcnt)
    15809           t-doc.d-card    = ub.dis-card.d-card.
    15810         end.
    15811       end.
    15812     end.
    15813   end.
    15814   else do:
    15815     assign
    15816       t-doc.d-card = ?.
    15817   end.
    15818   display t-doc.d-card t-doc.discnt-pc with frame d-out-doc.
    15819   if input frame d-out-doc t-doc.discnt-type = 'группа':U then do:
    15820     define variable v-d-pcnt as decimal no-undo .
    15821     run cgrplib-get-pcnt-value in this-procedure ( input ub.clients.grp-code , output v-d-pcnt) no-error .
    15822     if error-status:error then do:
    15823       message
    15824       "Ошибка при установлениее скидки для группы клиентов."
    15825       error-status:get-message(1) skip
    15826       return-value
    15827       view-as alert-box.
    15828       display t-doc.discnt-type with frame d-out-doc.
    15829       return error.
    15830     end.
    15831     else do:
    15832       if v-d-pcnt = ?
    15833       or v-d-pcnt = 0 then do:
    15834         message "Скидка для группы клиентов не установлена." view-as alert-box.
    15835         display t-doc.discnt-type with frame d-out-doc.
    15836         return error.
    15837       end.
    15838     end.
    15839     t-doc.discnt-pc = v-d-pcnt.
    15840   end.
    15841   assign t-doc.discnt-type.
    15842   run gbl/calc-trn.p (input parparentproc, input recid(t-doc)) no-error.
    15843   if error-status :error then return "error".
    15844   END PROCEDURE.
    15845   PROCEDURE check-discnt :
    15846   varlog = no.
    15847   if input frame d-out-doc t-doc.discnt-type = 'строка':U then
    15848     if not v-cntxp-out-line-discnt then message "Скидки по строкам запрещены.".
    15849     else message "Включение разных скидок по строкам. Вы уверены ?"
    15850                             view-as alert-box question buttons ok-cancel update varlog.
    15851     else message "Включение общей скидки для всего документа."
    15852                           "Все скидки по строкам будут пересчитаны. Вы уверены ?"
    15853                           view-as alert-box question buttons ok-cancel update varlog.
    15854   if varlog <> true then do:
    15855     display t-doc.discnt-type with frame d-out-doc.
    15856     return error.
    15857   end.
    15858   END PROCEDURE.
    15859   PROCEDURE check-inv :
    15860   find ub.doc-line where ub.doc-line.doc-code         = t-doc.doc-code
    15861                          and ub.doc-line.prod-code = ub.gds-dtl.prod-code
    15862                          and ub.doc-line.prod-type = ub.gds-dtl.prod-type
    15863                          and ub.doc-line.artic     = ub.gds-dtl.artic no-lock.
    15864   line-rec = recid (ub.doc-line).
    15865   find ub.goods where ub.goods.prod-code = ub.gds-dtl.prod-code
    15866                and ub.goods.prod-type = ub.gds-dtl.prod-type
    15867                and ub.goods.artic     = ub.gds-dtl.artic no-lock.
    15868   define variable l-inv-on as logical no-undo .
    15869   define variable vss-include-info106 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    15870   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
    15871     (input  ub.doc-line.obj-type
    15872     ,input  ub.doc-line.obj-code
    15873     ,input  ub.doc-line.artic
    15874     ,input  ub.doc-line.prod-type
    15875     ,input  ub.doc-line.prod-code
    15876     ,input  'inv-on=request'
    15877     ,output l-inv-on
    15878     ) no-error .
    15879   if error-status :error then do:
    15880     message
    15881       "Ошибка получения признака товара на объекте" skip
    15882       error-status :get-message(1) skip
    15883       return-value skip
    15884       view-as alert-box error .
    15885     undo, return no-apply .
    15886   end.
    15887   if l-inv-on = yes and t-doc.status_ <> 'запрос':U then do:
    15888     message "Артикул :" ub.doc-line.artic ub.goods.gds-name "- товар в инвентаризации." skip( 2 )
    15889             "Операция невозможна."
    15890     view-as alert-box error.
    15891     return error.
    15892   end.
    15893   END PROCEDURE.
    15894   PROCEDURE proc-m-outs-8 :
    15895   define buffer bf_trn-doc for ub.trn-doc.
    15896   define buffer bf_doc-line for ub.doc-line .
    15897   define buffer bf_goods for ub.goods .
    15898   define variable vardoc-code like ub.trn-doc.doc-code no-undo.
    15899   define variable par-alcohol as character no-undo .
    15900   define variable par-mark as character no-undo .
    15901   define variable par-type as character no-undo .
    15902   define variable v-is-alc as logical no-undo .
    15903   define variable v-mark-alchol     as logical no-undo .
    15904   define variable v-type as character no-undo .
    15905   define variable v-tth             as handle no-undo .
    15906   define variable v-value-character as character no-undo .
    15907   define variable v-value-date      as date      no-undo .
    15908   define variable v-value-decimal   as decimal   no-undo .
    15909   define variable v-value-integer   as integer   no-undo .
    15910   delete object v-tth no-error.
    15911   run adm/shattri.p (
    15912      input "get":U
    15913     ,input t-doc.obj-type
    15914     ,input t-doc.obj-code
    15915     ,input 'nakl_par':U
    15916     ,input  "mark-alchol"
    15917     ,output v-value-character
    15918     ,output v-value-date
    15919     ,output v-value-decimal
    15920     ,output v-value-integer
    15921     ,output v-mark-alchol
    15922     ,output v-type
    15923     ,INPUT-OUTPUT table-handle v-tth
    15924     ) no-error .
    15925     delete object v-tth no-error.
    15926   if error-status:error then do:
    15927     message "Ошибка при получение параметра mark-alchol"
    15928     view-as alert-box.
    15929     return error.
    15930   end.
    15931   if not v-mark-alchol
    15932   then do :
    15933       message "В системе не включен помарочный учёт. Импорт акцизных марок невозможен." view-as alert-box .
    15934       return.
    15935   end.
    15936   do transaction:
    15937       run str/imp-marks.p (parparentproc, t-doc.doc-code, "out") .
    15938   end.
    15939   END PROCEDURE.
    15940   PROCEDURE proc-m-outs-9 :
    15941     define variable chg-qnty    like gds-dtl.doc-qnty no-undo.
    15942     define variable legal-node  like gds-prt.node-code no-undo.
    15943     define variable varcount    as integer no-undo.
    15944     define variable varchg-qnty like ub.gds-dtl.doc-qnty no-undo.
    15945     define variable vardoc-qnty like ub.gds-dtl.doc-qnty no-undo.
    15946     define variable v-is-petrol as logical no-undo.
    15947     define variable v-is-pieces as logical no-undo.
    15948     define variable var-kg-qnty like ub.gds-dtl.doc-qnty no-undo.
    15949     define variable rr-inv-line as recid   no-undo.
    15950     define variable v-rec-list as character no-undo .
    15951     define variable ii as integer no-undo .
    15952     define buffer cpl_goods    for ub.goods   .
    15953     define buffer cpl_gds-obj  for ub.gds-obj .
    15954     define buffer cpl_prt-obj  for ub.prt-obj .
    15955     define buffer cpl_gds-prt  for ub.gds-prt .
    15956     define buffer cpl_gds-dtl  for ub.gds-dtl .
    15957     define buffer cpl_doc-line for ub.doc-line.
    15958     define buffer cpl_inv-line for ub.inv-line.
    15959     define buffer buf_utd       for ub.utd  .
    15960     define buffer buf_utd-lines for ub.utd-lines .
    15961     define variable vconnect as com-handle no-undo.
    15962     run str/UPD.w ( parparentproc, 'ВЫБОР':U, 0,"" , input-output vconnect , output v-rec-list)  .
    15963     if trim(v-rec-list) = ""
    15964     or v-rec-list = ?
    15965     then
    15966     return .
    15967     do ii = 1 to num-entries (v-rec-list) :
    15968       find first buf_utd no-lock where recid(buf_utd) = integer(entry(ii,v-rec-list)) no-error .
    15969       if not available buf_utd then next .
    15970       c-l:
    15971       do on error undo c-l, return error :
    15972         r-l:
    15973         for each buf_utd-lines no-lock where buf_utd-lines.db-num = buf_utd.db-num
    15974                                          and buf_utd-lines.doc-id = buf_utd.doc-id,
    15975         first cpl_goods no-lock where cpl_goods.gds-code = buf_utd-lines.gds-code :
    15976           assign
    15977             varcount = varcount + 1
    15978           .
    15979           if varcount modulo 100 = 0 then
    15980           do:
    15981             run waitfram-show in this-procedure (input "ЖДИТЕ.  Обработано строк списка : " + string (varcount)).
    15982           end.
    15983   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crdoclno in g#lib-trn
    15984   ( input t-doc.doc-code
    15985    ,input t-doc.obj-type
    15986    ,input t-doc.obj-code
    15987    ,input cpl_goods.artic
    15988    ,input cpl_goods.prod-type
    15989    ,input cpl_goods.prod-code
    15990    ,input cpl_goods.gds-name
    15991    ,input cpl_goods.prt-root
    15992    ,input ?
    15993    ,input ?
    15994    ,input ub.sysconf.cash-pay
    15995     ) no-error .
    15996           if error-status :error then
    15997           do:
    15998             message
    15999               vss-workfile vss-revision vss-description skip
    16000               "Ошибка при создании строки." skip
    16001               return-value skip
    16002               trim(error-status :get-message(1))
    16003               trim(error-status :get-message(2))
    16004               trim(error-status :get-message(3))
    16005               trim(error-status :get-message(4))
    16006               trim(error-status :get-message(5)) skip
    16007               view-as alert-box error.
    16008             undo c-l, return error return-value.
    16009           end.
    16010           if return-value = "next" then
    16011           do:
    16012             next r-l.
    16013           end.
    16014           find first cpl_doc-line where cpl_doc-line.doc-code  = t-doc.doc-code and
    16015             cpl_doc-line.artic     = cpl_goods.artic      and
    16016             cpl_doc-line.prod-type = cpl_goods.prod-type  and
    16017             cpl_doc-line.prod-code = cpl_goods.prod-code .
    16018           find first cpl_gds-prt where cpl_gds-prt.upper-code = cpl_goods.prt-root no-lock.
    16019           find first  cpl_prt-obj where cpl_prt-obj.obj-type  = t-doc.obj-type
    16020             and cpl_prt-obj.obj-code  = t-doc.obj-code
    16021             and cpl_prt-obj.artic     = cpl_goods.artic
    16022             and cpl_prt-obj.prod-type = cpl_goods.prod-type
    16023             and cpl_prt-obj.prod-code = cpl_goods.prod-code no-error .
    16024           if error-status :error then
    16025           do:
    16026           end.
    16027           assign
    16028             legal-node = if available cpl_prt-obj then cpl_prt-obj.prt-code else cpl_gds-prt.node-code .
    16029   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
    16030     ( input t-doc.obj-code
    16031      ,input t-doc.obj-type
    16032      ,input t-doc.doc-code
    16033      ,input cpl_goods.artic
    16034      ,input cpl_goods.prod-code
    16035      ,input cpl_goods.prod-type
    16036      ,input legal-node
    16037      ,input yes
    16038     ) no-error .
    16039           find first cpl_gds-dtl where cpl_gds-dtl.doc-code  = t-doc.doc-code and
    16040             cpl_gds-dtl.artic     = cpl_goods.artic      and
    16041             cpl_gds-dtl.prod-code = cpl_goods.prod-code  and
    16042             cpl_gds-dtl.prod-type = cpl_goods.prod-type  and
    16043             cpl_gds-dtl.prt-code  = legal-node.
    16044           assign
    16045             cpl_gds-dtl.ov = no.
    16046   define variable vss-include-info107 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    16047   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_set-pr in g#lib-trn3
    16048     ( input recid(cpl_gds-dtl)
    16049     , input no
    16050     , input ?
    16051     ) no-error.
    16052           if error-status :error then
    16053           do:
    16054             message
    16055               vss-workfile vss-revision vss-description skip
    16056               error-status :get-message(1) skip
    16057               return-value skip
    16058               ""
    16059               view-as alert-box error
    16060               .
    16061           end.
    16062           assign
    16063             chg-qnty = buf_utd-lines.Quantity
    16064           .
    16065           run trg/rsrv-dtl.p (input parparentproc,
    16066                               'reserv':U,
    16067                               buffer cpl_gds-dtl,
    16068                               input-output chg-qnty,
    16069                               input-output cpl_doc-line.price-base,
    16070                               input-output cpl_doc-line.price-rubl,
    16071                               -1,
    16072                               input ("copy-utd-line" + chr(4) + string(recid(buf_utd-lines)))) no-error.
    16073           if error-status:error
    16074           then do :
    16075             message ("Ошибка при копировании товара " + string(cpl_goods.gds-code) + "  " + cpl_goods.gds-name + chr(10) + return-value)
    16076             view-as alert-box .
    16077             undo c-l, return error.
    16078           end .
    16079           assign
    16080             cpl_doc-line.doc-qnty  = cpl_doc-line.doc-qnty + chg-qnty
    16081             cpl_gds-dtl.doc-qnty   = cpl_gds-dtl.doc-qnty  + chg-qnty
    16082             cpl_gds-dtl.fact-qnty  = cpl_gds-dtl.doc-qnty
    16083             cpl_doc-line.fact-qnty = cpl_doc-line.doc-qnty.
    16084           assign
    16085             varchg-qnty = varchg-qnty + chg-qnty
    16086             vardoc-qnty = vardoc-qnty + cpl_gds-dtl.doc-qnty.
    16087           if cpl_gds-dtl.doc-qnty = 0 then delete cpl_gds-dtl.
    16088         end .
    16089       end.
    16090     end.
    16091     run gbl/calc-trn.p (input parparentproc, input recid(t-doc)) no-error.
    16092     if error-status :error then
    16093     do:
    16094       message
    16095         "Ошибка при копировании документа (расчет шапки документа)." skip
    16096         return-value skip
    16097         error-status:get-message(1) skip
    16098         view-as alert-box error.
    16099       return error .
    16100     end.
    16101     pardoc-mode = 'ИЗМЕНЕНИЕ':U.
    16102     run ui-on ("line").
    16103     apply "entry" to br-dtl in frame d-out-doc.
    16104   END PROCEDURE.
    16105   PROCEDURE check-reason :
    16106     define variable j_rsn-code like ub.trn-reason.reason-code no-undo.
    16107     assign j_rsn-code = ( input frame d-out-doc t-doc.reason-code ).
    16108     find first ub.trn-reason no-lock where
    16109                ub.trn-reason.reason-code = j_rsn-code no-error.
    16110     if not available ub.trn-reason then do:
    16111       if j_rsn-code <> ? and j_rsn-code <> 0 then do:
    16112         message "Неверно указано основание (причина) создания документа." view-as alert-box error.
    16113       end.
    16114       assign  rsn-name = "".
    16115       display rsn-name with frame d-out-doc.
    16116       if j_rsn-code = ? or j_rsn-code = 0 then do:
    16117         assign t-doc.reason-code = 0.
    16118         return.
    16119       end.
    16120       else do:
    16121         return error.
    16122       end.
    16123     end.
    16124     assign  rsn-name = ub.trn-reason.reason-name.
    16125     display rsn-name with frame d-out-doc.
    16126     assign  frame d-out-doc t-doc.reason-code.
    16127   END PROCEDURE.
    16128   PROCEDURE chk-upd-date :
    16129   define variable v-today as date      no-undo.
    16130   define variable v-time  as integer   no-undo.
    16131   if t-doc.ext-doc-type <> 'ee':U          and
    16132      t-doc.ext-doc-type <> 'ep':U       and
    16133      t-doc.ext-doc-type <> 're':U      and
    16134      t-doc.ext-doc-type <> 'rs':U and
    16135      t-doc.ext-doc-type <> 'we':U          and
    16136      t-doc.ext-doc-type <> 'eo':U     then do:
    16137      message "Дату факт можно редактировать только во внешнем расходе, внутриобъектном расходе, возврате поставщику, внешнем возврате, внешнем возврате через кассу или списании."
    16138      view-as alert-box.
    16139      display t-doc.fact-date with frame d-out-doc.
    16140      return error.
    16141   end.
    16142   define variable vss-include-info108 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    16143   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
    16144     (input  v-cntxt-obj-type
    16145     ,input  v-cntxt-obj-code
    16146     ,output v-today
    16147     )  .
    16148   if input frame d-out-doc t-doc.fact-date > v-today then do:
    16149      message "Дата больше сегодняшней даты на объекте." view-as alert-box error.
    16150      display t-doc.fact-date with frame d-out-doc.
    16151      return error.
    16152   end.
    16153   if input frame d-out-doc t-doc.fact-date < v-today - 7 then do:
    16154      varlog = yes.
    16155      message "Заведенная факт дата отличается более чем на 7 дней от сегодняшней даты на объекте."
    16156              "Отказаться от заведения даты?" view-as alert-box question
    16157              buttons yes-no update varlog.
    16158      if varlog then do:
    16159         display t-doc.fact-date with frame d-out-doc.
    16160         return error.
    16161      end.
    16162   end.
    16163   if input frame d-out-doc t-doc.fact-date <> t-doc.fact-date then do:
    16164   define variable v-value-character as character no-undo .
    16165   define variable v-value-date      as date no-undo .
    16166   define variable v-value-decimal   as decimal no-undo .
    16167   define variable v-value-integer   as integer no-undo .
    16168   define variable v-value-logical   as logical no-undo .
    16169   define variable v-tth             as handle no-undo .
    16170   define variable v-back-date as logical   no-undo .
    16171   define variable v-back-date-type as character no-undo .
    16172         delete object v-tth no-error.
    16173         run adm/shattri.p (
    16174              input "get":U
    16175             ,input v-cntxt-obj-type
    16176             ,input v-cntxt-obj-code
    16177             ,input 'nakl_par':U
    16178             ,input  "back-date"
