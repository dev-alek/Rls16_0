    20612   end.
    20613   pardoc-mode = 'ИЗМЕНЕНИЕ':U.
    20614   run ui-on ("line").
    20615   apply "entry" to br-dtl in frame d-out-doc.
    20616   END PROCEDURE.
    20617   procedure rowdisp :
    20618     do ii = 1 to extent (bcol).
    20619       if valid-handle (bcol[ii])
    20620       then do:
    20621         assign
    20622           bcol[ii]:bgcolor = RED_COLOR when get-vsdsts(buffer ub.gds-dtl) = "-".
    20623       end.
    20624     end.
    20625   end procedure.
    20626   procedure scanMark :
    20627     define input parameter iRecidParts as recid no-undo.
    20628     define parameter buffer iBufGoods for goods.
    20629     define output parameter oOk as logical no-undo init true.
    20630     define variable vRightChngQntyCode as character no-undo .
    20631     define variable vRightChngQnty     as logical   no-undo .
    20632     define buffer buf_doc-line for ub.doc-line.
    20633     define buffer bf_gds-dtl   for ub.gds-dtl.
    20634     v-add = yes .
    20635     do while v-add :
    20636       run str/chs-alcmarks.w (
    20637         input parparentproc,
    20638         input t-doc.doc-code,
    20639         input 'ДОБАВЛЕНИЕ':U,
    20640         input iBufGoods.gds-code,
    20641         input if iRecidParts <> ? then string(iRecidParts) else "",
    20642         output mark) no-error.
    20643       if error-status :error or mark = "" or mark = ? then
    20644       do:
    20645         oOk = false.
    20646         find first buf_doc-line no-lock where
    20647                    buf_doc-line.doc-code = t-doc.doc-code
    20648                and buf_doc-line.artic = iBufGoods.artic
    20649                and buf_doc-line.prod-code = iBufGoods.prod-code
    20650                and buf_doc-line.prod-type = iBufGoods.prod-type
    20651              no-error .
    20652         release bf_gds-dtl.
    20653         if avail buf_doc-line then
    20654             find first bf_gds-dtl no-lock where
    20655                        bf_gds-dtl.doc-code = buf_doc-line.doc-code
    20656                    and bf_gds-dtl.artic = buf_doc-line.artic
    20657                    and bf_gds-dtl.prod-type = buf_doc-line.prod-type
    20658                    and bf_gds-dtl.prod-code = buf_doc-line.prod-code
    20659                  no-error.
    20660         if not avail bf_gds-dtl and
    20661            (t-doc.ext-doc-type = 'ev':U or t-doc.ext-doc-type = 'we':U) then
    20662         do:
    20663             vRightChngQntyCode = if t-doc.ext-doc-type = 'we':U
    20664                                  then 'actn_write-off_add-no-mark':U
    20665                                  else 'actn_tdedt-ras-perem_add-no-mark':U.
    20666   define variable vss-include-info145 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    20667   do:
    20668     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    20669       (input  v-cntxt-db-num
    20670       ,input  v-cntxt-userid
    20671       ,input  0
    20672       ,input  vRightChngQntyCode
    20673       ,input  'object':U
    20674       ,input  t-doc.host-code
    20675       ,input  t-doc.obj-type
    20676       ,input  t-doc.obj-code
    20677       ,input  0
    20678       ,input  0
    20679       ,input  0
    20680       ,input  false
    20681       ,output vRightChngQnty
    20682       )  .
    20683   end.
    20684             if not vRightChngQnty then
    20685             do:
    20686               message "Товар не добавлен, т.к. не просканировано ни одой марки."
    20687                 view-as alert-box.
    20688               return.
    20689             end.
    20690         end.
    20691         run str/out-add.p (parparentproc,
    20692             recid(t-doc),
    20693             input recid(buf_doc-line),
    20694             input (if available bf_gds-dtl then recid(bf_gds-dtl) else ?),
    20695             gds-rec,
    20696             (if available bf_gds-dtl then 'ИЗМЕНЕНИЕ':U else 'ДОБАВЛЕНИЕ':U) +
    20697             if iRecidParts <> ? then (chr(4) + "return=" + string(iRecidParts)) else "",
    20698             '') no-error.
    20699         return.
    20700       end.
    20701       find first buf_doc-line exclusive-lock where buf_doc-line.doc-code = t-doc.doc-code
    20702                                               and buf_doc-line.artic = iBufGoods.artic
    20703                                               and buf_doc-line.prod-code = iBufGoods.prod-code
    20704                                               and buf_doc-line.prod-type = iBufGoods.prod-type
    20705                                               no-error .
    20706       if not available (buf_doc-line)
    20707       then do:
    20708         run str/out-add.p (parparentproc,
    20709             recid(t-doc),
    20710             ?,
    20711             ?,
    20712             gds-rec,
    20713             'ДОБАВЛЕНИЕ':U +
    20714             if iRecidParts <> ? then (chr(4) + "return=" + string(iRecidParts)) else "",
    20715             'scan-marks' + chr(3) + mark) no-error.
    20716         if error-status :error then
    20717         do:
    20718           next .
    20719         end.
    20720         if return-value = "stop-add-marks"
    20721         then do :
    20722           v-add = no .
    20723         end .
    20724       end .
    20725       else do :
    20726         find first bf_gds-dtl exclusive-lock where bf_gds-dtl.doc-code = buf_doc-line.doc-code
    20727                                                and bf_gds-dtl.artic = buf_doc-line.artic
    20728                                                and bf_gds-dtl.prod-type = buf_doc-line.prod-type
    20729                                                and bf_gds-dtl.prod-code = buf_doc-line.prod-code
    20730                                                no-error.
    20731         run str/out-add.p
    20732           ( input parparentproc
    20733           ,input recid(t-doc)
    20734           ,input recid(buf_doc-line)
    20735           ,input (if available bf_gds-dtl then recid(bf_gds-dtl) else ?)
    20736           ,input gds-rec
    20737           ,input 'ИЗМЕНЕНИЕ':U +
    20738                  if iRecidParts <> ? then (chr(4) + "return=" + string(iRecidParts)) else ""
    20739           ,input 'scan-marks' + chr(3) + mark)
    20740         no-error.
    20741         if error-status :error then
    20742         do:
    20743           return error.
    20744         end.
    20745         if return-value = "stop-add-marks"
    20746         then do :
    20747           v-add = no .
    20748         end .
    20749       end .
    20750     end .
    20751   end procedure.
