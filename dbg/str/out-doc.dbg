     9604   on value-changed of a-n-c in frame d-out-doc do:
     9605     run proc-valchg-a-n-c in this-procedure  no-error.
     9606     return no-apply.
     9607   end.
     9608   on any-printable of br-dtl in frame d-out-doc do:
     9609     run proc-any-printable-br-dtl in this-procedure   no-error.
     9610     return no-apply.
     9611   end.
     9612   on backspace of br-dtl in frame d-out-doc do:
     9613     run proc-backspace-br-dtl in this-procedure   no-error.
     9614     return no-apply.
     9615   end.
     9616   ON return OF loc-code IN FRAME d-out-doc do:
     9617     run proc-mouse-dbl-click-loc-code in this-procedure   no-error.
     9618     return no-apply.
     9619   end.
     9620   ON return, Ctrl-J OF loc-name IN FRAME d-out-doc do:
     9621     run proc-mouse-dbl-click-loc-name in this-procedure   no-error.
     9622     return no-apply.
     9623   end.
     9624   PROCEDURE proc-valchg-a-n-c:
     9625     case input frame d-out-doc a-n-c :
     9626       when "art" then do:
     9627         apply "entry" to br-dtl in frame d-out-doc.
     9628         hide loc-name loc-code
     9629         in frame d-out-doc.
     9630         loc-art = "".
     9631       end.
     9632       when "name" then do:
     9633         enable loc-name with frame d-out-doc.
     9634         disp loc-name with frame d-out-doc.
     9635         hide loc-art loc-code
     9636         in frame d-out-doc.
     9637         apply "entry" to loc-name in frame d-out-doc.
     9638       end.
     9639       when "code"
     9640    or when "DataMatrix" then
     9641       do:
     9642         enable loc-code with frame d-out-doc.
     9643         disp loc-code with frame d-out-doc.
     9644         hide loc-art loc-name
     9645         in frame d-out-doc.
     9646         apply "entry" to loc-code in frame d-out-doc.
     9647       end.
     9648     end CASE.
     9649   END PROCEDURE.
     9650   PROCEDURE proc-any-printable-br-dtl :
     9651     if input frame d-out-doc a-n-c = "art" then do:
     9652       if last-event:label = " " and
     9653          loc-art = "" then
     9654       return error.
     9655       find first l-doc-line where
     9656                  l-doc-line.doc-code = t-doc.doc-code and l-doc-line.artic begins (loc-art + last-event:label)
     9657                  no-lock no-error.
     9658       if available l-doc-line then do:
     9659         loc-art = loc-art + last-event:label.
     9660         disp loc-art with frame d-out-doc.
     9661         line-rec = recid (l-doc-line).
     9662         reposition br-dtl to recid line-rec no-error.
     9663       end.
     9664     end.
     9665   END PROCEDURE.
     9666   PROCEDURE proc-backspace-br-dtl:
     9667     if input frame d-out-doc a-n-c = "art" then do:
     9668       if loc-art = "" then
     9669         return error.
     9670       loc-art = substr (loc-art, 1, length (loc-art) - 1).
     9671       find first l-doc-line where
     9672                  l-doc-line.doc-code = t-doc.doc-code and l-doc-line.artic begins loc-art
     9673                  no-lock.
     9674       disp loc-art with frame d-out-doc.
     9675       line-rec = recid (l-doc-line).
     9676       reposition br-dtl to recid line-rec no-error.
     9677     end.
     9678   END PROCEDURE.
     9679   PROCEDURE proc-mouse-dbl-click-loc-code:
     9680   def var str-code as integer no-undo.
     9681   define variable varresult   as character         no-undo.
     9682   define variable vartype-bc  as character         no-undo.
     9683   define variable varweight   as decimal           no-undo.
     9684   define buffer l-goods for ub.goods.
     9685   define buffer l-bar-code for ub.bar-code.
     9686   define buffer buf_bar-code for ub.bar-code .
     9687   define buffer buf_prod-bc for ub.prod-bc.
     9688   define buffer buf_place for ub.place.
     9689     assign
     9690     frame d-out-doc
     9691     loc-code
     9692     a-n-c.
     9693     if a-n-c = "datamatrix"
     9694     then do:
     9695   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_dm-rcnz in g#libbcrcn
     9696   (
     9697    input  parparentproc
     9698   ,input  loc-code
     9699   ,input  ?
     9700   ,input  v-cntxt-obj-type
     9701   ,input  v-cntxt-obj-code
     9702   ,input  yes
     9703   ,input  no
     9704   ,input  varscales-pref51
     9705   ,input  varpgscales-pref51
     9706   ,output varresult
     9707   ,output vartype-bc
     9708   ,output varweight
     9709   ,buffer buf_bar-code
     9710   ,buffer buf_prod-bc
     9711   ,buffer buf_place
     9712   ) no-error.
     9713        if varresult eq "prod-bc"
     9714        then
     9715           loc-code:screen-value in frame d-out-doc = buf_prod-bc.b-str.
     9716     end.
     9717     else do:
     9718   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     9719   (
     9720    input  parparentproc
     9721   ,input  loc-code
     9722   ,input  ?
     9723   ,input  v-cntxt-obj-type
     9724   ,input  v-cntxt-obj-code
     9725   ,input  yes
     9726   ,input  no
     9727   ,input  varscales-pref51
     9728   ,input  varpgscales-pref51
     9729   ,output varresult
     9730   ,output vartype-bc
     9731   ,output varweight
     9732   ,buffer buf_bar-code
     9733   ,buffer buf_prod-bc
     9734   ,buffer buf_place
     9735   ) no-error.
     9736   end.
     9737     if available buf_bar-code then do:
     9738           find first l-goods where
     9739                     l-goods.gds-code =
     9740     buf_bar-code.gds-code No-LOCK.
     9741           find first l-doc-line where l-doc-line.doc-code = t-doc.doc-code and
     9742                     l-doc-line.artic = l-goods.artic AND
     9743                     l-doc-line.prod-type = l-goods.prod-type AND
     9744                     l-doc-line.prod-code = l-goods.prod-code no-lock no-error.
     9745       if available l-doc-line then do:
     9746         line-rec = recid (l-doc-line).
     9747         reposition br-dtl to recid line-rec no-error.
     9748       end.
     9749       else do:
     9750         message "Строка не найдена."
     9751                 view-as alert-box error.
     9752       end.
     9753     end.
     9754     else
     9755       message "Бар-код не найден."
     9756               view-as alert-box error.
     9757     apply "entry" to loc-code in frame d-out-doc.
     9758   END PROCEDURE.
     9759   PROCEDURE  proc-mouse-dbl-click-loc-name:
     9760     assign
     9761     frame d-out-doc
     9762     loc-name.
     9763       if last-event:label = "Ctrl-J" then
     9764         find next l-doc-line where l-doc-line.doc-code = t-doc.doc-code and
     9765                   can-find (ub.goods where ub.goods.artic = l-doc-line.artic and
     9766                   ub.goods.prod-type = l-doc-line.prod-type and
     9767                   ub.goods.prod-code = l-doc-line.prod-code and
     9768                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     9769       else
     9770         find first l-doc-line where l-doc-line.doc-code = t-doc.doc-code and
     9771                   can-find (ub.goods where ub.goods.artic = l-doc-line.artic and
     9772                   ub.goods.prod-type = l-doc-line.prod-type and
     9773                   ub.goods.prod-code = l-doc-line.prod-code and
     9774                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     9775       if available l-doc-line then do:
     9776         line-rec = recid (l-doc-line).
     9777         reposition br-dtl to recid line-rec no-error.
     9778       end.
     9779       else do:
     9780         message "Строка не найдена."
     9781                 view-as alert-box error.
     9782       end.
     9783     apply "entry" to loc-name in frame d-out-doc.
     9784   END PROCEDURE.
     9785   on value-changed of br-dtl in frame d-out-doc do:
     9786   if not available ub.doc-line or recid (ub.doc-line) <> line-rec then do:
     9787       hide loc-art in frame d-out-doc.
     9788       loc-art = "".
     9789   end.
     9790   if available ub.goods
     9791   then do :
     9792     define variable  p-type     as character no-undo .
     9793     define variable v-isweighed as logical no-undo .
     9794     define variable vRightChngQntyCode as character no-undo .
     9795     define variable vIsExemplarGoods as logical no-undo .
     9796     define variable vRightChngQnty as logical no-undo .
     9797     define buffer buf_marking-lines for ub.marking-lines.
     9798     run lineattr-value (
     9799       input   t-doc.doc-code ,
     9800       input   ub.goods.gds-code ,
     9801       input   'flora_ps':U,
     9802       output  flora-ps ,
     9803       output  p-type      )
     9804     .
     9805     display flora-ps with frame d-out-doc .
     9806     if t-doc.ext-doc-type = 'ev':U or
     9807        t-doc.ext-doc-type = 'we':U then
     9808     do:
     9809         run isExemplarGoods in this-procedure
     9810           (t-doc.obj-type, t-doc.obj-code, ub.goods.gds-code, output vIsExemplarGoods).
     9811         v-isweighed = WghProdVariable(t-doc.obj-type, t-doc.obj-code, ub.goods.gds-code).
     9812         if vIsExemplarGoods
     9813         or v-isweighed
     9814         then do:
     9815           if t-doc.ext-doc-type = 'ev':U and
     9816              can-find(first buf_marking-lines no-lock where
     9817                               buf_marking-lines.out-code = ub.gds-dtl.doc-code
     9818                           and buf_marking-lines.gds-code = ub.goods.gds-code) then
     9819           do:
     9820             vRightChngQnty = false.
     9821           end.
     9822           else
     9823           do:
     9824               vRightChngQntyCode = if t-doc.ext-doc-type = 'we':U
     9825                   then 'actn_write-off_add-no-mark':U
     9826                   else 'actn_tdedt-ras-perem_add-no-mark':U.
     9827   define variable vss-include-info53 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9828   do:
     9829     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     9830       (input  v-cntxt-db-num
     9831       ,input  v-cntxt-userid
     9832       ,input  0
     9833       ,input  vRightChngQntyCode
     9834       ,input  'object':U
     9835       ,input  t-doc.host-code
     9836       ,input  t-doc.obj-type
     9837       ,input  t-doc.obj-code
     9838       ,input  0
     9839       ,input  0
     9840       ,input  0
     9841       ,input  false
     9842       ,output vRightChngQnty
     9843       )  .
     9844   end.
     9845           end.
     9846           if not vRightChngQnty then
     9847           assign
     9848             ub.gds-dtl.doc-qnty:read-only  in browse br-dtl = yes
     9849             ub.gds-dtl.fact-qnty:read-only  in browse br-dtl = yes
     9850           .
     9851           else
     9852           assign
     9853             ub.gds-dtl.doc-qnty:read-only  in browse br-dtl = no
     9854             ub.gds-dtl.fact-qnty:read-only  in browse br-dtl = no
     9855           .
     9856         end.
     9857         else do :
     9858           assign
     9859             ub.gds-dtl.doc-qnty:read-only  in browse br-dtl = no
     9860             ub.gds-dtl.fact-qnty:read-only  in browse br-dtl = no
     9861           .
     9862         end .
     9863         case t-doc.status_ :
     9864           when 'накл':U then do:
     9865              if t-doc.flag_ then assign ub.gds-dtl.doc-qnty:read-only  in browse br-dtl = yes.
     9866              assign ub.gds-dtl.fact-qnty:read-only  in browse br-dtl = yes.
     9867           end.
     9868           when 'разрешен':U then assign ub.gds-dtl.doc-qnty:read-only  in browse br-dtl = yes.
     9869           otherwise   assign ub.gds-dtl.doc-qnty:read-only  in browse br-dtl = yes
     9870                             ub.gds-dtl.fact-qnty:read-only in browse br-dtl = yes.
     9871         end case.
     9872     end.
     9873   end .
     9874   IF mImagePh THEN
     9875   DO:
     9876       DEFINE VARIABLE vImageList AS LONGCHAR    NO-UNDO.
     9877       DEFINE VARIABLE vCh        AS CHARACTER   NO-UNDO.
     9878   if AVAILABLE goods then do:
     9879       RUN gds-attr-value ( goods.gds-code, "image-list":U, OUTPUT vImageList, OUTPUT vCh).
     9880       RUN imagelist_decode IN THIS-PROCEDURE (INPUT vImageList, goods.gds-code, OUTPUT vImageList).
     9881       vCh = ENTRY (1, vImageList, ",":U).
     9882       g-image:LOAD-IMAGE (ENTRY (1, vCh)) NO-ERROR.
     9883       ASSIGN
     9884           g-image:HIDDEN     = NO
     9885           g-image:VISIBLE    = YES
     9886           g-image:SENSITIVE  = YES
     9887           .
     9888   end.
     9889   END.
     9890   ELSE
     9891       ASSIGN
     9892           g-image:HIDDEN     = YES
     9893           g-image:VISIBLE    = NO
     9894           g-image:SENSITIVE  = NO
