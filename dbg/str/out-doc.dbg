     7386   function get-mark return character (buffer local-gds-dtl for ub.gds-dtl ).
     7387      if lookup (string (recid (local-gds-dtl)), del-list) > 0  then return "*".
     7388                                                                else return "".
     7389   end function.
     7390   function get-kg-sale-rubl returns decimal ( buffer local-gds-dtl for ub.gds-dtl ) :
     7391     define variable d_out-kg-sale-price like ub.gds-dtl.price-rubl no-undo.
     7392     run inv-line_price in this-procedure ( input recid( local-gds-dtl ), input yes, output d_out-kg-sale-price ) no-error.
     7393     return ( if error-status :error then ? else d_out-kg-sale-price ).
     7394   end function.
     7395   function get-kg-sale-base returns decimal ( buffer local-gds-dtl for ub.gds-dtl ) :
     7396     define variable d_out-kg-sale-price like ub.gds-dtl.price-rubl no-undo.
     7397     run inv-line_price in this-procedure ( input recid( local-gds-dtl ), input  no, output d_out-kg-sale-price ) no-error.
     7398     return ( if error-status :error then ? else d_out-kg-sale-price ).
     7399   end function.
     7400   function get-kg-fact-qnty returns decimal ( buffer local-gds-dtl for ub.gds-dtl ) :
     7401     define variable d_out-qnty-kg like ub.gds-dtl.fact-qnty no-undo.
     7402     run inv-line_qnty in this-procedure ( input recid( local-gds-dtl ),             output d_out-qnty-kg       ) no-error.
     7403     return ( if error-status :error then ? else d_out-qnty-kg ).
     7404   end function.
     7405   function get-kg-after-qnty returns decimal ( buffer local-gds-dtl for ub.gds-dtl ) :
     7406     define variable d_out-qnty-kg like ub.gds-dtl.fact-qnty no-undo.
     7407     run after_qnty in this-procedure    ( input recid( local-gds-dtl ),             output d_out-qnty-kg       ) no-error.
     7408     return ( if error-status :error then ? else d_out-qnty-kg ).
     7409   end function.
     7410   FUNCTION get-vsdsts RETURNS CHARACTER
     7411   (buffer local-gds-dtl for ub.gds-dtl ):
     7412     if parext-doc-type <> 'iv':U
     7413     and not v-is-return
     7414       then return "".
     7415     def var v-mercury-prod as logical no-undo.
     7416     def buffer bf_gds for ub.goods.
     7417     find first bf_gds where
     7418           local-gds-dtl.artic = bf_gds.artic
     7419       and local-gds-dtl.prod-type = bf_gds.prod-type
     7420       and local-gds-dtl.prod-code = bf_gds.prod-code.
     7421     if lookup(v-mercury-value, 'no':u) = 0
     7422     then do:
     7423   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
     7424     (input  bf_gds.gds-code
     7425     ,input  'mercur_FGIS=request':u
     7426     ,output v-mercury-prod
     7427     ) no-error .
     7428       if error-status :error
     7429       then do:
     7430         message
     7431           vss-workfile vss-revision vss-description skip
     7432           "Ошибка при определении атрибута товара" skip
     7433           "Код товара" bf_gds.gds-code skip
     7434           'mercur_FGIS=request':u skip
     7435           error-status :get-message(1) skip
     7436           return-value skip
     7437           view-as alert-box error .
     7438         undo, return error .
     7439       end.
     7440       if v-mercury-prod
     7441       then do:
     7442         vsdstrObj = new vsdtostorage ().
     7443         if vsdstrObj:exsistvsd( buffer local-gds-dtl )
     7444         then do:
     7445           delete object vsdstrObj no-error.
     7446           return "+".
     7447         end.
     7448         else do with frame d-out-doc:
     7449           delete object vsdstrObj no-error.
     7450           return "-".
     7451         end.
     7452       end.
     7453     end.
     7454     return "".
     7455   end function.
