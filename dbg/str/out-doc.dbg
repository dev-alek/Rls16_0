    17365   END PROCEDURE.
    17366   PROCEDURE create-record :
    17367   define  input parameter p-doc-code   like ub.trn-doc.doc-code    no-undo.
    17368   define  input parameter p-attr-code  like ub.doc-attr.attr-code  no-undo.
    17369   define  input parameter p-attr-value like ub.doc-attr.attr-value no-undo.
    17370   define output parameter p-exist      as   logical                no-undo.
    17371   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-xst in g#trdcalib (  input p-doc-code ,
    17372                           input p-attr-code ,
    17373                          output p-exist )  .
    17374     if p-exist = no then do:
    17375   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input p-doc-code ,
    17376                          input p-attr-code ,
    17377                          input p-attr-value ) no-error .
    17378       if error-status :error then do:
    17379         message error-status :error error-status :get-message( 1 ) '"' + p-attr-code + '"'
    17380         view-as alert-box error.
    17381       end.
    17382     end.
    17383   END PROCEDURE.
    17384   PROCEDURE disable_UI :
    17385     HIDE FRAME d-out-doc.
    17386   END PROCEDURE.
    17387   PROCEDURE enable_UI :
    17388     DISPLAY varpurch-chs is-repay is-cons is-storage is-oldcons a-n-c loc-code
    17389             loc-name loc-art varcontract-prn-code sum-base sum-rubl wrkr-name
    17390             fact-base fact-rubl TEXT-RUBL agnt-name pay-rubl boss-name rsn-name
    17391             flora-PS
    17392         WITH FRAME d-out-doc.
    17393     IF AVAILABLE ub.clients THEN
    17394       DISPLAY ub.clients.obj-name
    17395         WITH FRAME d-out-doc.
    17396     IF AVAILABLE ub.pay-type THEN
    17397       DISPLAY ub.pay-type.obj-name
    17398         WITH FRAME d-out-doc.
    17399     IF AVAILABLE t-doc THEN
    17400       DISPLAY t-doc.cli-code t-doc.cli-type t-doc.hold-obj-code t-doc.hold-obj-type
    17401             t-doc.print-rubl t-doc.doc-date t-doc.fact-date t-doc.shift-date
    17402             t-doc.shift-name t-doc.shift-num t-doc.d-card t-doc.discnt-pc
    17403             t-doc.discnt-type t-doc.out-code t-doc.base-rate t-doc.base-scale
    17404             t-doc.tot-calc t-doc.discnt-rubl t-doc.pay-code t-doc.wrkr t-doc.agnt
    17405             t-doc.boss t-doc.doc-qnty t-doc.fact-qnty t-doc.VAT-base
    17406             t-doc.VAT-rubl t-doc.tot-cli t-doc.reason-code
    17407         WITH FRAME d-out-doc.
    17408     ENABLE b-exit rect-tot rect-prc b-cur b-arch b-notes b-attr b-cnt b-fixprice
    17409            b-re-price b-rsrv-doc-list b-dopinf b-history b-help b-prev b-next
    17410            t-doc.cli-code t-doc.cli-type r-clients ub.clients.obj-name
    17411            t-doc.hold-obj-code t-doc.hold-obj-type t-doc.print-rubl
    17412            t-doc.doc-date t-doc.fact-date t-doc.shift-date t-doc.shift-name
    17413            t-doc.shift-num r-sht t-doc.d-card t-doc.discnt-pc t-doc.discnt-type
    17414            t-doc.out-code r-outs t-doc.base-rate t-doc.base-scale r-acc
    17415            t-doc.tot-calc t-doc.discnt-rubl varpurch-chs t-doc.pay-code r-pay
    17416            is-repay t-doc.wrkr r-wrkr is-cons t-doc.agnt r-agnt is-storage
    17417            is-oldcons t-doc.boss r-boss r-reas a-n-c loc-code loc-name loc-art
    17418            varcontract-prn-code b-contr-lkp b-mark b-add b-prt b-parts b-lkp
    17419            b-chg b-del b-notes-line br-dtl t-doc.doc-qnty t-doc.fact-qnty
    17420            sum-base sum-rubl ub.pay-type.obj-name t-doc.VAT-base t-doc.VAT-rubl
    17421            wrkr-name fact-base fact-rubl TEXT-RUBL agnt-name t-doc.tot-cli
    17422            pay-rubl boss-name t-doc.reason-code rsn-name flora-PS b-marks
    17423         WITH FRAME d-out-doc.
    17424     open query br-dtl  for each ub.doc-line where        ub.doc-line.doc-code = t-doc.doc-code no-lock,   each ub.gds-dtl where        ub.gds-dtl.doc-code  = t-doc.doc-code    and ub.gds-dtl.artic     = ub.doc-line.artic    and ub.gds-dtl.prod-code = ub.doc-line.prod-code    and ub.gds-dtl.prod-type = ub.doc-line.prod-type no-lock,   each ub.gds-prt where        ub.gds-prt.node-code = ub.gds-dtl.prt-code no-lock ,   each ub.goods where        ub.goods.artic = ub.gds-dtl.artic    and ub.goods.prod-code = ub.gds-dtl.prod-code    and ub.goods.prod-type = ub.gds-dtl.prod-type no-lock ,  each ub.bar-code no-lock where       ub.bar-code.gds-code = ub.goods.gds-code   and ub.bar-code.node-code = ub.gds-dtl.prt-code   and ub.bar-code.part-code = ''   and ub.bar-code.in-code = ''   and ub.bar-code.unit-cli = ub.goods.unit-base .
    17425     FRAME d-out-doc:SENSITIVE = NO.
    17426   END PROCEDURE.
    17427   PROCEDURE find-gds :
    17428   find ub.bar-code where ub.bar-code.b-code = b-c no-lock.
    17429   find ub.goods where ub.goods.gds-code = ub.bar-code.gds-code no-lock.
    17430   assign gds-rec = recid (ub.goods).
    17431   find first ub.gds-dtl where
    17432        ub.gds-dtl.doc-code  = t-doc.doc-code     and
    17433        ub.gds-dtl.artic     = ub.goods.artic     and
    17434        ub.gds-dtl.prod-type = ub.goods.prod-type and
    17435        ub.gds-dtl.prod-code = ub.goods.prod-code and
    17436        ub.gds-dtl.prt-code  = ub.bar-code.node-code no-lock no-error.
    17437   if not available ub.gds-dtl then do:
    17438      message "В накладной не найден товар по данному бар-коду."
    17439       view-as alert-box error buttons ok.
    17440       return error.
    17441   end.
    17442   END PROCEDURE.
    17443   PROCEDURE init-attr-flora :
    17444   do on error undo, return error return-value :
    17445   run cr-tt-upd in this-procedure no-error.
    17446   define variable varexist                  as logical   no-undo.
    17447   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input '0rsrv-date':U                                                         ,  input  string(today)                                                         , output varexist ) no-error.
    17448   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input '1ord_time':U                                                         ,  input  ""                                                         , output varexist ) no-error.
    17449   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input '2befpay':U                                                         ,  input  ""                                                         , output varexist ) no-error.
    17450   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input '3ord_Nchek':U                                                         ,  input  ""                                                         , output varexist ) no-error.
    17451   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input '5deliv':U                                                         ,  input  ""                                                         , output varexist ) no-error.
    17452   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input '6sumwrk':U                                                         ,  input  ""                                                         , output varexist ) no-error.
    17453   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input '22ord_contact':U                                                         ,  input  ""                                                         , output varexist ) no-error.
    17454   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input '21ord_phone':U                                                         ,  input  ""                                                         , output varexist ) no-error.
    17455   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input '8ord_adr':U                                                         ,  input  ""                                                         , output varexist ) no-error.
    17456   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input '4ord_dl':U                                                         ,  input  ""                                                         , output varexist ) no-error.
    17457   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input 'delivery-date':U                                                         ,  input  ""                                                         , output varexist ) no-error.
    17458   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input 'delivery-time':U                                                         ,  input  ""                                                         , output varexist ) no-error.
    17459   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input 'zakaz-date':U                                                         ,  input  ""                                                         , output varexist ) no-error.
    17460   define buffer buf_clients for ub.clients.
    17461   define buffer buf_person  for ub.person.
    17462   define buffer buf_firm    for ub.firm.
    17463   define variable v-adr as character no-undo init "" .
    17464   define variable v-h   as character no-undo init "" .
    17465   find first buf_clients no-lock where
    17466              buf_clients.obj-code =  t-doc.cli-code  and
    17467              buf_clients.obj-type =  t-doc.cli-type    no-error .
    17468   if  available buf_clients then do:
    17469     v-h = buf_clients.obj-name .
    17470     if t-doc.cli-type = 'орг':U then do:
    17471       find first buf_firm no-lock where buf_firm.firm-code = t-doc.cli-code no-error .
    17472            v-adr = trim ( buf_firm.post-addr1 ) .
    17473       end.
    17474       else do:
    17475           find first buf_person no-lock where buf_person.psn-code = t-doc.cli-code no-error .
    17476           v-adr = string(buf_person.ind) + " " + buf_person.city + " " + buf_person.address .
    17477       end.
    17478   end.
    17479   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input '4dchek':U                                                         ,  input  string(t-doc.doc-date)                                                         , output varexist ) no-error.
    17480   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input '8ord_adr':U                                                         ,  input  v-adr                                                         , output varexist ) no-error.
    17481   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input '9ord_hwo':U                                                         ,  input  v-h                                                         , output varexist ) no-error.
    17482   end.
    17483   END PROCEDURE.
