    13882             ,input  v-diasize-proc-name
    13883             ,input  'width':u
    13884             ,input  string(frame d-out-doc :width - v-diasize-orig-frame-width)
    13885             ) .
    13886         end.
    13887       end.
    13888     end.
    13889     assign
    13890       v-diasize-change-size = false
    13891     .
    13892   end procedure.
    13893   procedure diasize_set-width :
    13894     define input  parameter p-new-width  as decimal   no-undo .
    13895     define input  parameter p-move-resize as logical   no-undo .
    13896     do
    13897     on error undo, return error return-value
    13898     :
    13899       run diasize_change-width in this-procedure
    13900         (input  (p-new-width - frame d-out-doc :width)
    13901         ,input  p-move-resize
    13902         ) .
    13903     end.
    13904   end procedure.
    13905   procedure diasize_position-resize-button :
    13906     do with frame d-out-doc
    13907     :
    13908       hide v-diasize-resize-button .
    13909       assign
    13910         v-diasize-resize-button :row = frame d-out-doc :height - v-diasize-resize-button :height
    13911                     - 1
    13912                     - (frame d-out-doc :border-bottom-pixels / session :pixels-per-row)
    13913         v-diasize-resize-button :col = frame d-out-doc :width - v-diasize-resize-button :width
    13914                     - 1
    13915                     - (frame d-out-doc :border-right-pixels / session :pixels-per-column)
    13916       .
    13917       view v-diasize-resize-button .
    13918     end.
    13919   end procedure.
    13920   on alt-right anywhere
    13921   do:
    13922     run diasize_change-width in this-procedure
    13923       (input 1
    13924       ,input true
    13925       ) .
    13926     return no-apply .
    13927   end.
    13928   on alt-left anywhere
    13929   do:
    13930     run diasize_change-width in this-procedure
    13931       (input -1
    13932       ,input true
    13933       ) .
    13934     return no-apply .
    13935   end.
    13936   on alt-down anywhere
    13937   do:
    13938     run diasize_change-height in this-procedure
    13939       (input 1
    13940       ,input true
    13941       ) .
    13942     return no-apply .
    13943   end.
    13944   on alt-up anywhere
    13945   do:
    13946     run diasize_change-height in this-procedure
    13947       (input -1
    13948       ,input true
    13949       ) .
    13950     return no-apply .
    13951   end.
    13952   on alt-enter of frame d-out-doc
    13953   do:
    13954     run diasize_maximize in this-procedure
    13955       (input  ?
    13956       ).
    13957     return no-apply .
    13958   end.
    13959   procedure diasize_end-move :
    13960     do
    13961     on error undo, return error return-value
    13962     :
    13963       define variable v-row-delta as decimal   no-undo .
    13964       define variable v-col-delta as decimal   no-undo .
    13965       define variable v-new-row as decimal   no-undo .
    13966       define variable v-new-col as decimal   no-undo .
    13967       assign
    13968         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
    13969         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
    13970       .
    13971       assign
    13972         v-row-delta = v-new-row - frame d-out-doc :height
    13973         v-col-delta = v-new-col - frame d-out-doc :width
    13974       .
    13975       run diasize_change-height in this-procedure
    13976         (input v-row-delta
    13977         ,input true
    13978         ) .
    13979       run diasize_change-width in this-procedure
    13980         (input v-col-delta
    13981         ,input true
    13982         ) .
    13983     end.
    13984   end procedure.
    13985   procedure diasize_maximize :
    13986     define input  parameter p-action as logical   no-undo .
    13987     do
    13988     on error undo, return error return-value
    13989     :
    13990       if p-action = ?
    13991       then do:
    13992         if v-diasize-need-maximize = true
    13993         then do:
    13994           assign
    13995             p-action = true
    13996           .
    13997         end.
    13998         else do:
    13999           assign
    14000             p-action = false
    14001           .
    14002         end.
    14003       end.
    14004       if p-action = true
    14005       then do:
    14006         run diasize_change-height in this-procedure
    14007           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
    14008               - frame d-out-doc :height-chars
    14009           ,input true
    14010           ) .
    14011         run diasize_change-width in this-procedure
    14012           (input session :width-chars
    14013               - frame d-out-doc :width-chars
    14014           ,input true
    14015           ) .
    14016         assign
    14017           v-diasize-need-maximize = false
    14018         .
    14019       end.
    14020       else do:
    14021         run diasize_change-width in this-procedure
    14022           (input v-diasize-orig-frame-width
    14023               - frame d-out-doc :width-chars
    14024           ,input true
    14025           ) .
    14026         run diasize_change-height in this-procedure
    14027           (input v-diasize-orig-frame-height
    14028               - frame d-out-doc :height-chars
    14029           ,input true
    14030           ) .
    14031         assign
    14032           v-diasize-need-maximize = true
    14033         .
    14034       end.
    14035     end.
    14036   end procedure.
    14037   procedure diasize_restore-orig-size :
    14038     do
    14039     on error undo, return error return-value
    14040     :
    14041       assign
    14042         v-diasize-current-frame-width  = frame d-out-doc :width
    14043         v-diasize-current-frame-height = frame d-out-doc :height
    14044       .
    14045       run diasize_set-height in this-procedure
    14046         (input  v-diasize-orig-frame-height
    14047         ,input  true
    14048         ) .
    14049       run diasize_set-width in this-procedure
    14050         (input  v-diasize-orig-frame-width
    14051         ,input  true
    14052         ) .
    14053     end.
    14054   end procedure.
    14055   procedure diasize_restore-current-size :
    14056     do
    14057     on error undo, return error return-value
    14058     :
    14059       run diasize_set-height in this-procedure
    14060         (input  v-diasize-current-frame-height
    14061         ,input  true
    14062         ) .
    14063       run diasize_set-width in this-procedure
    14064         (input  v-diasize-current-frame-width
    14065         ,input  true
    14066         ) .
    14067     end.
    14068   end procedure.
    14069   procedure diasize_set-browse-handle :
    14070     define input  parameter p-browse-handle as handle   no-undo .
    14071     define buffer buf_temp-browse-handle for temp-browse-handle .
    14072     do
    14073     on error undo, return error return-value
    14074     :
    14075       assign
    14076         v-diasize-browse-handle = p-browse-handle
    14077       .
    14078       for each buf_temp-browse-handle
    14079       on error undo, return error return-value
    14080       :
    14081         delete buf_temp-browse-handle .
    14082       end.
    14083     end.
