    14103   procedure diasize_init :
    14104     define variable v-default-value    as logical   no-undo .
    14105     define variable v-restore-saved    as logical   no-undo .
    14106     define variable v-resize-value-str as character no-undo .
    14107     do
    14108     on error undo, return error return-value
    14109     :
    14110       do with frame d-out-doc
    14111       :
    14112         assign
    14113           v-diasize-orig-frame-height = frame d-out-doc :height
    14114           v-diasize-orig-frame-width  = frame d-out-doc :width
    14115           v-diasize-browse-handle     = browse br-dtl :handle
    14116         .
    14117         create button v-diasize-resize-button
    14118         assign
    14119           parent        = frame d-out-doc :first-child
    14120           label         = "s"
    14121           height-pixels = 16
    14122           width-pixels  = 16
    14123           visible       = true
    14124           sensitive     = true
    14125           movable       = true
    14126           triggers:
    14127             on end-move persistent run diasize_end-move in this-procedure .
    14128           end triggers.
    14129         v-diasize-resize-button :load-mouse-pointer("SIZE") .
    14130         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
    14131         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
    14132         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
    14133         assign
    14134           v-diasize-wndmax = false
    14135         .
    14136         if connected("ub") = true
    14137         then do:
    14138           define variable v-cntxt-db-num        as integer   no-undo .
    14139           define variable v-cntxt-userid        as character no-undo .
    14140           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
    14141                                             , OUTPUT v-cntxt-userid
    14142                                             ) .
    14143           run gbl/wndpar_r.p
    14144             (input  v-cntxt-db-num
    14145             ,input  v-cntxt-userid
    14146             ,input  'wndmax':U
    14147             ,output v-diasize-wndmax
    14148             ,output v-default-value
    14149             ) .
    14150         end.
    14151         assign
    14152           v-diasize-wndstore = false
    14153         .
    14154         if connected("ub") = true
    14155         then do:
    14156           run gbl/wndpar_r.p
    14157             (input  v-cntxt-db-num
    14158             ,input  v-cntxt-userid
    14159             ,input  'wndstore':U
    14160             ,output v-diasize-wndstore
    14161             ,output v-default-value
    14162             ) .
    14163         end.
    14164         assign
    14165           v-diasize-proc-name = entry(1, program-name(2), '.')
    14166         .
    14167         if v-diasize-wndstore = true
    14168         then do:
    14169           assign
    14170             v-restore-saved = false
    14171           .
    14172           if connected("ub") = true
    14173           then do:
    14174             run gbl/wndsizer.p
    14175               (input  v-cntxt-db-num
    14176               ,input  v-cntxt-userid
    14177               ,input  v-diasize-proc-name
    14178               ,input  'height':u
    14179               ,output v-resize-value-str
    14180               ) .
    14181             if v-resize-value-str <> '':U
    14182             then do:
    14183               run diasize_change-height in this-procedure
    14184                 (input  integer(v-resize-value-str)
    14185                 ,input  true
    14186                 ) .
    14187               assign
    14188                 v-restore-saved = true
    14189               .
    14190             end.
    14191           end.
    14192           if connected("ub") = true
    14193           then do:
    14194             run gbl/wndsizer.p
    14195               (input  v-cntxt-db-num
    14196               ,input  v-cntxt-userid
    14197               ,input  v-diasize-proc-name
    14198               ,input  'width':u
    14199               ,output v-resize-value-str
    14200               ) .
    14201             if v-resize-value-str <> '':U
    14202             then do:
    14203               run diasize_change-width in this-procedure
    14204                 (input  integer(v-resize-value-str)
    14205                 ,input  true
    14206                 ) .
    14207               assign
    14208                 v-restore-saved = true
    14209               .
    14210             end.
    14211           end.
    14212           if v-restore-saved <> true
    14213           then do:
    14214             if v-diasize-wndmax = true
    14215             then do:
    14216               run diasize_maximize in this-procedure
    14217                 (input  true
    14218                 ) .
    14219             end.
    14220           end.
    14221         end.
    14222         else do:
    14223           if v-diasize-wndmax = true
    14224           then do:
    14225             run diasize_maximize in this-procedure
    14226               (input  true
    14227               ) .
    14228           end.
    14229         end.
    14230       end.
    14231     end.
    14232   end procedure.
    14233   procedure diasize_need-full-display :
    14234     define output parameter p-need-full-display as logical   no-undo .
    14235     do
    14236     on error undo, return error return-value
    14237     :
    14238       assign
    14239         p-need-full-display = v-diasize-need-full-display
    14240       .
