     2168   define variable is-petrolium as logical no-undo.
     2169   define variable is-pieces    as logical no-undo.
     2170   define variable v-part-code  as character no-undo.
     2171   define variable v-alcohol-prod as logical no-undo .
     2172   define buffer bf_trn-doc  for ub.trn-doc.
     2173   define buffer bf_doc-line for ub.doc-line.
     2174   define buffer bf_gds-dtl  for ub.gds-dtl.
     2175   define buffer bf_goods    for ub.goods.
     2176   define buffer bf_gds-prt  for ub.gds-prt.
     2177   define buffer bf_units    for ub.units.
     2178   define buffer bf_parts    for ub.parts.
     2179   do on error undo, return error return-value :
     2180   find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code.
     2181   for each tt-bar-code-ne:
     2182     delete tt-bar-code-ne.
     2183   end.
     2184   assign
     2185     g-log = yes.
     2186   if bf_trn-doc.doc-qnty <> bf_trn-doc.fact-qnty and
     2187      bf_trn-doc.fact-qnty <> 0 then do:
     2188     message "Начать заполнять фактическое количество с нуля?" view-as alert-box question
     2189     buttons yes-no update g-log.
     2190   end.
     2191   for each bf_doc-line where bf_doc-line.doc-code = bf_trn-doc.doc-code no-lock by bf_doc-line.line-num :
     2192     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     2193                               bf_goods.prod-type = bf_doc-line.prod-type and
     2194                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     2195     for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_trn-doc.doc-code     and
     2196                               bf_gds-dtl.artic     = bf_goods.artic     and
     2197                               bf_gds-dtl.prod-type = bf_goods.prod-type and
     2198                               bf_gds-dtl.prod-code = bf_goods.prod-code
     2199                               no-lock :
     2200       find first bf_gds-prt where bf_gds-prt.node-code = bf_gds-dtl.prt-code no-lock.
     2201   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2202     (input  bf_goods.gds-code
     2203     ,input  bf_gds-prt.node-code
     2204     ,output varbar-code
     2205     )  .
     2206       assign
     2207         varnum = varnum + 1.
     2208       create tt-bar-code-ne.
     2209       assign
     2210        tt-bar-code-ne.nm             = varnum
     2211        tt-bar-code-ne.mark           = (if bf_gds-dtl.fact-qnty < bf_gds-dtl.doc-qnty then "<" else "")
     2212        tt-bar-code-ne.b-c            = varbar-code
     2213        tt-bar-code-ne.scn-qnty-doc   = bf_gds-dtl.doc-qnty
     2214        tt-bar-code-ne.scn-qnty-file  = (if g-log = yes then 0 else bf_gds-dtl.fact-qnty)
     2215        tt-bar-code-ne.mem-qnty       = tt-bar-code-ne.scn-qnty-file
     2216        tt-bar-code-ne.bef-qnty       = bf_gds-dtl.fact-qnty
     2217        tt-bar-code-ne.artic          = bf_goods.artic
     2218        tt-bar-code-ne.prod-type      = bf_goods.prod-type
     2219        tt-bar-code-ne.prod-code      = bf_goods.prod-code
     2220        tt-bar-code-ne.gds-name       = bf_goods.gds-name
     2221        tt-bar-code-ne.node-name      = (if bf_gds-prt.node-name = '_Пустая шкала':U then "--------------------" else bf_gds-prt.node-name)
     2222        tt-bar-code-ne.part-code      = ''
     2223        tt-bar-code-ne.in-code        = ''.
     2224     end.
     2225   end.
     2226   run str/scr-neb.w (input parparentproc, input-output table tt-bar-code-ne, input "in-doc", input yes, input v-cntxt-obj-type, input v-cntxt-obj-code).
     2227   for each bf_doc-line where bf_doc-line.doc-code = bf_trn-doc.doc-code no-lock by bf_doc-line.line-num :
     2228     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     2229                               bf_goods.prod-type = bf_doc-line.prod-type and
     2230                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     2231     for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_trn-doc.doc-code     and
     2232                               bf_gds-dtl.artic     = bf_goods.artic     and
     2233                               bf_gds-dtl.prod-type = bf_goods.prod-type and
     2234                               bf_gds-dtl.prod-code = bf_goods.prod-code
     2235                               no-lock on error undo, return error return-value :
     2236       find first bf_gds-prt where bf_gds-prt.node-code = bf_gds-dtl.prt-code no-lock.
     2237   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2238     (input  bf_goods.gds-code
     2239     ,input  bf_gds-prt.node-code
     2240     ,output varbar-code
     2241     )  .
     2242       find first tt-bar-code-ne where tt-bar-code-ne.b-c = varbar-code.
     2243       if tt-bar-code-ne.scn-qnty-file <> bf_gds-dtl.fact-qnty then do :
     2244         find bf_units where bf_units.unit-name = bf_goods.unit-base no-lock.
     2245         if lookup('сер':U, bf_units.type) > 0 then do:
     2246            message "В серийном товаре нельзя редактировать количество. Пропускаем.".
     2247            next.
     2248         end.
     2249         if tt-bar-code-ne.scn-qnty-file > bf_gds-dtl.doc-qnty then do:
     2250           message "По признаку " bf_gds-dtl.artic " "
     2251                   bf_gds-dtl.prod-type " "
     2252                   bf_gds-dtl.prod-code " "
     2253                   bf_gds-prt.f-name " "
     2254                   "количество факт уже больше чем по документу. Устанавливаем по документу."
     2255           view-as alert-box.
     2256           assign
     2257             tt-bar-code-ne.scn-qnty-file = bf_gds-dtl.doc-qnty.
     2258         end.
     2259         assign varrecid = recid(bf_doc-line).
     2260         if bf_trn-doc.doc-type = 'при':U and
     2261            bf_trn-doc.internal = no        then do:
     2262   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     2263     (
     2264        input bf_goods.artic
     2265     ,  input bf_goods.prod-type
     2266     ,  input bf_goods.prod-code
     2267     , output is-petrolium
     2268     , output is-pieces
     2269     ) no-error.
     2270           if is-petrolium and not is-pieces then do:
     2271             MESSAGE "В жидком топливе нельзя редактировать фактическое количество" view-as alert-box.
     2272             next.
     2273           end.
     2274           assign
     2275             v-part-code = ?
     2276           .
     2277   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
     2278     (input  bf_goods.gds-code
     2279     ,input  'alcohol-prod=request':u
     2280     ,output v-alcohol-prod
     2281     )  .
     2282           if v-alcohol-prod then do:
     2283             find first bf_parts no-lock
     2284               where bf_parts.obj-type  = bf_doc-line.obj-type  and
     2285                     bf_parts.obj-code  = bf_doc-line.obj-code  and
     2286                     bf_parts.prod-type = bf_doc-line.prod-type and
     2287                     bf_parts.prod-code = bf_doc-line.prod-code and
     2288                     bf_parts.artic     = bf_doc-line.artic     and
     2289                     bf_parts.out-code  = bf_doc-line.doc-code
     2290               no-error.
     2291             if available bf_parts then do:
     2292               assign
     2293                 v-part-code = bf_parts.part-code
     2294               .
     2295             end.
     2296           end.
     2297           run str/cor-line.p
     2298             (input parparentproc
     2299             ,input-output varrecid
     2300             ,input bf_doc-line.doc-code
     2301             ,input bf_doc-line.prod-type
