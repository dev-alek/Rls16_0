     7765     ub.doc-line.vat-sum-rubl * ub.gds-dtl.fact-qnty / ub.doc-line.fact-qnty    @ Vat-sum         column-label 'НДС' format "->,>>>,>>>,>>>,>>9.999":U
     7766     ub.doc-line.vat-pc                      column-label 'НДС' format "->>>,>>9.99999999":U
