    18895         input v-internal ,
    18896         input "b-sel":u,
    18897         input v-ext-doc-type,
    18898         input v-hold,
    18899         input v-doc-rec,
    18900         output loc-ref-list).
    18901   find first t-d-b where recid (t-d-b) = integer (loc-ref-list) no-lock no-error.
    18902   if not available t-d-b then do:
    18903     display ? @ t-doc.out-code with frame d-out-doc.
    18904     apply "entry" to b-add in frame d-out-doc.
    18905     return error.
    18906   end.
    18907   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-d-b.doc-code ,
    18908                           input 'nsf':U ,
    18909                          output v-at-value ,
    18910                          output v-at-type )  .
    18911   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t-doc.doc-code ,
    18912                          input 'nsf':U ,
    18913                          input v-at-value ) no-error .
    18914   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-d-b.doc-code ,
    18915                           input 'dsf':U ,
    18916                          output v-at-value ,
    18917                          output v-at-type )  .
    18918   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t-doc.doc-code ,
    18919                          input 'dsf':U ,
    18920                          input v-at-value ) no-error .
    18921   assign t-doc.out-code = t-d-b.doc-code .
    18922   display t-doc.out-code with frame d-out-doc.
    18923   END PROCEDURE.
    18924   PROCEDURE local-m-outs-5 :
    18925   define variable loc-ref-list     as character no-undo .
    18926   define variable v-hold           as logical   no-undo .
    18927   define variable v-ext-doc-type   as character no-undo .
    18928   define variable v-doc-rec        as recid     no-undo .
    18929   define variable v-stat           as character no-undo .
    18930   define variable v-type           as character no-undo .
    18931   define variable v-internal       as logical   no-undo .
    18932   define variable v-list-mode      as character no-undo .
    18933   define variable i as integer   no-undo .
    18934   run ref/all-zakz.w
    18935       ( input  parParentProc
    18936       ,input   ?
    18937       ,input   ?
    18938       ,input   "firmord"
    18939       ,input   ""
    18940       ,input   "b-sel,b-mark"
    18941       ,input   ""
    18942       ,output  loc-ref-list ) no-error .
    18943      if loc-ref-list = "" or loc-ref-list = ? then do:
    18944          message "Ни чего не отметили в списке заказов !"
    18945          view-as alert-box information .
    18946           display
    18947               ? @ t-doc.out-code
    18948           with frame d-out-doc.
    18949           apply "entry" to b-add in frame d-out-doc.
    18950           return no-apply.
    18951      end.
    18952       if num-entries( loc-ref-list ) = 0  or  loc-ref-list = ""  or error-status :error
    18953       then do:
    18954           display
    18955               ? @ out-code
    18956           with frame d-out-doc.
    18957           apply "entry" to b-add in frame d-out-doc.
    18958           return no-apply.
    18959       end.
    18960       else do:
    18961        repeat i = 1 to  num-entries( loc-ref-list ) :
    18962           find first ub.ord-doc no-lock
    18963               where recid( ub.ord-doc ) = integer( entry( i , loc-ref-list ) )  no-error.
    18964           display
    18965               ub.ord-doc.doc-code @ t-doc.out-code
    18966           with frame d-out-doc.
    18967                run ask-copy-ord  in this-procedure (
    18968                 input ub.ord-doc.doc-code,
    18969                 input ub.sysconf.cash-pay,
    18970                 input v-cntxp-doc-prt   )
    18971                 no-error .
    18972                 if error-status :error
    18973                 then do:
    18974                     message
    18975                             vss-workfile vss-revision vss-description
    18976                         skip(1)
    18977                         skip "Ошибка копирования заказа в документ ."
    18978                         skip return-value
    18979                         skip trim( error-status :get-message( 1 ) )
    18980                     view-as alert-box error.
    18981                     undo, return error return-value .
    18982                 end.
    18983           end.
    18984       end.
    18985   END PROCEDURE.
    18986   PROCEDURE local-parts :
    18987   do
    18988     on error undo, return error return-value
    18989     :
    18990       define variable var_is-petrol as logical no-undo .
    18991       define variable var_is-pieces as logical no-undo .
    18992   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
    18993     (
    18994        input ub.gds-dtl.artic
    18995     ,  input ub.gds-dtl.prod-type
    18996     ,  input ub.gds-dtl.prod-code
    18997     , output var_is-petrol
    18998     , output var_is-pieces
    18999     ) .
    19000       if pardoc-mode <> 'ПРОСМОТР':U then do:
    19001         run check-rate.
    19002       end.
    19003       find ub.doc-line where ub.doc-line.doc-code  = t-doc.doc-code
    19004                       and ub.doc-line.prod-code = ub.gds-dtl.prod-code
    19005                       and ub.doc-line.prod-type = ub.gds-dtl.prod-type
    19006                       and ub.doc-line.artic     = ub.gds-dtl.artic .
    19007       find ub.goods where ub.goods.prod-code = ub.gds-dtl.prod-code
    19008                   and ub.goods.prod-type = ub.gds-dtl.prod-type
    19009                   and ub.goods.artic     = ub.gds-dtl.artic      no-lock.
    19010       if pardoc-mode = 'ПРОСМОТР':U or (var_is-petrol = yes and var_is-pieces = no) or t-doc.ext-doc-type = 'rv':U then do:
    19011         assign
    19012           work-mode = "lookup-parts":U
    19013         .
    19014       end.
    19015       else do:
    19016         run local-check-gds.
    19017         assign
    19018           work-mode = "update-parts":U
    19019         .
    19020       end.
    19021       if (lookup( string(t-doc.reason-code), v-reasons-for-return) > 0
    19022       and t-doc.ext-doc-type = 'ee':U)
    19023       or v-is-return
    19024       then do :
    19025         run str/out-add.p
    19026           ( input parparentproc
    19027            ,input recid(t-doc)
    19028            ,input recid(ub.doc-line)
    19029            ,input recid(ub.gds-dtl)
    19030            ,input recid (ub.goods)
    19031            ,input work-mode + chr(4) + "return"
    19032            ,input ?
    19033           ).
    19034       end.
    19035       else do :
    19036         run str/out-add.p
    19037           ( input parparentproc
    19038            ,input recid(t-doc)
    19039            ,input recid(ub.doc-line)
    19040            ,input recid(ub.gds-dtl)
    19041            ,input recid (ub.goods)
    19042            ,input work-mode
    19043            ,input ?
    19044           ).
    19045       end.
    19046       if var_is-petrol = true
    19047         and var_is-pieces = false
    19048         and work-mode <> "lookup-parts"
    19049       then do:
    19050         run inv-line_recalc-qty in this-procedure
    19051           ( input ub.gds-dtl.doc-code
    19052             ,input ub.gds-dtl.artic
    19053             ,input ub.gds-dtl.prod-type
    19054             ,input ub.gds-dtl.prod-code
    19055             ,input true
    19056             ,input ub.gds-dtl.doc-qnty
    19057             ,input ub.gds-dtl.fact-qnty
    19058           ) .
    19059       end.
    19060     end.
    19061   END PROCEDURE.
    19062   PROCEDURE mark-list :
    19063   if not available ub.gds-dtl then do:
    19064       message "Неправильный выбор строки.".
    19065       return no-apply.
    19066     end.
    19067   define variable vss-include-info125 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    19068   define variable v-str-recid126 as character no-undo .
    19069   define variable v-num-entry126 as integer   no-undo .
    19070   assign
    19071     v-str-recid126 = trim( string( recid( ub.gds-dtl ) , "->>>>>>>>>>>9":U ) )
    19072     v-num-entry126 = lookup( v-str-recid126 , del-list )
    19073   .
    19074   if v-num-entry126 > 0 then do:
    19075     assign
    19076       entry( v-num-entry126, del-list ) = "":U
    19077       del-list = trim( replace( del-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
    19078     .
    19079   end.
    19080   else do:
    19081     assign
    19082       del-list = del-list + ( if del-list = "":U then "":U else chr(44) ) + v-str-recid126
    19083     .
    19084   end.
    19085     br-dtl:refresh() in frame d-out-doc .
    19086     varlog = br-dtl:select-next-row () in frame d-out-doc.
    19087     apply "entry" to br-dtl in frame d-out-doc.
    19088   END PROCEDURE.
    19089   PROCEDURE proc-b-re-price :
    19090     do
    19091     on error undo, return error return-value
    19092     :
    19093   define buffer bf_gds-dtl for ub.gds-dtl  .
    19094     find first bf_gds-dtl no-lock where bf_gds-dtl.doc-code = t-doc.doc-code and bf_gds-dtl.ov = false  no-error .
    19095     if not available bf_gds-dtl then do:
    19096        message "Цены зафиксированы , пересчет цен невозможен." view-as alert-box information  .
    19097        return .
    19098     end.
    19099   define variable p-update as logical   no-undo .
    19100      run str/re-prsum.p
    19101          (input parparentproc,
    19102           input t-doc.doc-code,
    19103           output p-update
    19104          ) no-error .
    19105           if error-status :error then message
    19106             vss-workfile vss-revision vss-description skip
    19107             error-status :get-message(1) skip
    19108             return-value skip
    19109             "re-prsum.p"
    19110             view-as alert-box error
    19111           .
    19112           if  p-update then do:
    19113               run gbl/calc-trn.p (input parparentproc, input recid(t-doc)) no-error.
    19114               if error-status :error then do:
    19115                 undo, return error.
    19116               end.
    19117               run ui-on ("line").
    19118           end.
    19119     end.
    19120   END PROCEDURE.
    19121   PROCEDURE proc-row-display :
    19122     do
    19123     on error undo, return error return-value
    19124     :
    19125   define variable v-ok as logical   no-undo .
    19126   define variable vss-include-info127 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    19127   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_grp-nabor in g#lib-trn3
    19128   ( input  ub.goods.gds-code ,
    19129     output v-ok
    19130   )
    19131   .
    19132    if v-ok then  do:
    19133       assign
    19134         ub.bar-code.b-code:fgcolor in browse br-dtl = 2
    19135         ub.gds-dtl.artic:fgcolor in browse br-dtl = 2
    19136         v-gds-name :fgcolor in browse br-dtl = 2
    19137         ub.gds-dtl.doc-qnty:fgcolor in browse br-dtl = 2
    19138         ub.gds-dtl.fact-qnty:fgcolor in browse br-dtl = 2
    19139       .
    19140    end.
    19141     end.
    19142   END PROCEDURE.
    19143   PROCEDURE proc-shift-name :
    19144   define buffer bf_shift-obj   for ub.shift-obj.
    19145     define variable varfind-shift as integer initial 0.
    19146     define variable varshift-date like ub.shift-obj.shift-date no-undo.
    19147     define variable varshift-num  like ub.shift-obj.shift-num  no-undo.
    19148     if input frame d-out-doc t-doc.shift-date <> ? then do:
    19149       for each  bf_shift-obj where bf_shift-obj.obj-type   = t-doc.obj-type                             and
    19150                                    bf_shift-obj.obj-code   = t-doc.obj-code                             and
    19151                                    bf_shift-obj.shift-date = input frame d-out-doc t-doc.shift-date and
    19152                                    bf_shift-obj.shift-name = input frame d-out-doc t-doc.shift-name no-lock on error undo, return error return-value :
    19153         assign
    19154           varfind-shift = varfind-shift + 1
    19155           varshift-date = bf_shift-obj.shift-date
    19156           varshift-num  = bf_shift-obj.shift-num.
    19157       end.
    19158       if varfind-shift = 0 or varfind-shift > 1 then do:
    19159         if varfind-shift = 0 then do:
    19160           message "Не найдена смена: " t-doc.obj-type " " t-doc.obj-code
    19161                   " Дата " input frame d-out-doc t-doc.shift-date " Номер смены " input frame d-out-doc t-doc.shift-name " ."
    19162           view-as alert-box error.
    19163         end.
    19164         else do:
    19165           message "Найдено более одной смены с одним номером в сменном дне. Объект: " t-doc.obj-type " " t-doc.obj-code
    19166                   " Дата " input frame d-out-doc t-doc.shift-date " Номер смены " input frame d-out-doc t-doc.shift-name " ."
    19167           view-as alert-box error.
    19168         end.
    19169         display t-doc.shift-name with frame d-out-doc.
    19170         run proc-sht no-error.
    19171         if error-status:error then do: return error. end.
    19172       end.
    19173       else do:
    19174         assign frame d-out-doc
    19175           t-doc.shift-name.
    19176         assign
    19177           t-doc.shift-date = varshift-date
    19178           t-doc.shift-num  = varshift-num.
    19179         display t-doc.shift-date t-doc.shift-num t-doc.shift-name with frame d-out-doc.
    19180         if t-doc.fact-date = ? then do: assign t-doc.fact-date = t-doc.shift-date t-doc.fact-time = (24 * 60 * 60). display t-doc.fact-date with frame d-out-doc. end.
    19181       end.
    19182     end.
    19183   END PROCEDURE.
    19184   PROCEDURE proc-shift-num :
    19185     define buffer bf_shift-obj   for ub.shift-obj.
    19186     if input frame d-out-doc t-doc.shift-date <> ? then do:
    19187       find first bf_shift-obj where bf_shift-obj.obj-type   = t-doc.obj-type                             and
    19188                                     bf_shift-obj.obj-code   = t-doc.obj-code                             and
    19189                                     bf_shift-obj.shift-date = input frame d-out-doc t-doc.shift-date and
    19190                                     bf_shift-obj.shift-num  = input frame d-out-doc t-doc.shift-num  no-lock no-error.
    19191       if not available bf_shift-obj then do:
    19192         message "Не найдена смена: " t-doc.obj-type " " t-doc.obj-code
    19193                 " Дата " input frame d-out-doc t-doc.shift-date " Порядок смены " input frame d-out-doc t-doc.shift-num " ."
    19194         view-as alert-box error.
    19195         display t-doc.shift-num with frame d-out-doc.
    19196         run proc-sht no-error.
    19197         if error-status:error then do:
    19198           return error.
    19199         end.
    19200       end.
    19201       else do:
    19202         assign
    19203           t-doc.shift-date = bf_shift-obj.shift-date
    19204           t-doc.shift-num  = bf_shift-obj.shift-num
    19205           t-doc.shift-name = bf_shift-obj.shift-name.
    19206         display t-doc.shift-date t-doc.shift-num t-doc.shift-name with frame d-out-doc.
    19207         if t-doc.fact-date = ? then do:
    19208           assign
    19209             t-doc.fact-date = t-doc.shift-date
    19210             t-doc.fact-time = (24 * 60 * 60).
    19211           display t-doc.fact-date with frame d-out-doc.
    19212         end.
    19213       end.
    19214     end.
    19215   END PROCEDURE.
    19216   PROCEDURE proc-sht :
    19217     define buffer bf_shift-obj   for ub.shift-obj.
    19218     define variable varrid-list as character no-undo.
    19219     define variable varrecid    as recid     no-undo.
    19220     assign
    19221       varrid-list = "".
    19222     run str/sht-all.w (parparentproc, t-doc.obj-type, t-doc.obj-code, 'b-sel', 'obj',t-doc.obj-type, t-doc.obj-code, '':u, input-output varrid-list) no-error.
    19223     if error-status:error or varrid-list = "":u then do:
    19224       return error.
    19225     end.
    19226     else do:
    19227       assign
    19228         varrecid = integer (entry(1, varrid-list)).
    19229       find first bf_shift-obj where recid(bf_shift-obj) = varrecid no-lock no-error.
    19230       if available bf_shift-obj then do:
    19231         assign
    19232           t-doc.shift-date = bf_shift-obj.shift-date
    19233           t-doc.shift-num  = bf_shift-obj.shift-num
    19234           t-doc.shift-name = bf_shift-obj.shift-name.
    19235         display t-doc.shift-date t-doc.shift-num t-doc.shift-name with frame d-out-doc.
    19236         if t-doc.fact-date = ? then do:
    19237           assign
    19238             t-doc.fact-date = t-doc.shift-date
    19239             t-doc.fact-time = (24 * 60 * 60).
    19240           display t-doc.fact-date with frame d-out-doc.
    19241         end.
    19242       end.
    19243     end.
    19244   END PROCEDURE.
    19245   PROCEDURE select-reason :
    19246     define variable j-rsn-code like ub.trn-reason.reason-code no-undo.
    19247     assign j-rsn-code = ( input frame d-out-doc t-doc.reason-code ).
    19248     run str/trn-reas.w ( input ParParentProc, input 'выбор':U, input-output j-rsn-code ).
    19249     find first ub.trn-reason no-lock where ub.trn-reason.reason-code = j-rsn-code no-error.
    19250     if available ub.trn-reason then do:
    19251       if   t-doc.ext-doc-type = 'ee':U
    19252          and (
    19253               (    lookup( string(     t-doc.reason-code), v-reasons-for-return) gt 0
    19254                and lookup( string(ub.trn-reason.reason-code), v-reasons-for-return) eq 0)
    19255          or   (    lookup( string(     t-doc.reason-code), v-reasons-for-return) eq 0
    19256                and lookup( string(ub.trn-reason.reason-code), v-reasons-for-return) gt 0)
    19257              )
    19258       then do:
    19259         if not v-is-return
    19260         then do :
    19261           message "Данное основание используется для возврата поставщику. Выберите другое основание из списка." view-as alert-box .
    19262           return no-apply.
    19263         end .
    19264         assign
    19265           rsn-name          = ub.trn-reason.reason-name
    19266           t-doc.reason-code = ub.trn-reason.reason-code
    19267         .
    19268         run check-cli in this-procedure no-error.
    19269         if error-status :error then return no-apply.
    19270       end.
    19271       else do:
    19272         assign
    19273           rsn-name          = ub.trn-reason.reason-name
    19274           t-doc.reason-code = ub.trn-reason.reason-code
    19275         .
    19276       end.
    19277       display t-doc.reason-code rsn-name with frame d-out-doc.
    19278     end.
    19279     if lookup( string(t-doc.reason-code), v-reasons-for-return) > 0
    19280     and t-doc.ext-doc-type = 'ee':U
    19281     then do :
    19282       disable b-cur with frame d-out-doc.
    19283     end.
    19284     else do:
    19285       enable b-cur with frame d-out-doc.
    19286     end.
    19287     if (t-doc.reason-code = 23 or t-doc.reason-code = 25)
    19288        and edo-return = yes then
    19289        disable b-bc with frame d-out-doc.
    19290   END PROCEDURE.
    19291   PROCEDURE set-work-mode-prt :
    19292   prt-rec = recid(ub.gds-dtl).
    19293   find ub.doc-line where ub.doc-line.doc-code  = t-doc.doc-code
    19294                   and ub.doc-line.prod-code = ub.gds-dtl.prod-code
    19295                   and ub.doc-line.prod-type = ub.gds-dtl.prod-type
    19296                   and ub.doc-line.artic     = ub.gds-dtl.artic no-lock.
    19297   line-rec = recid (ub.doc-line).
    19298   find ub.goods where ub.goods.prod-code = ub.gds-dtl.prod-code
    19299                and ub.goods.prod-type = ub.gds-dtl.prod-type
    19300                and ub.goods.artic     = ub.gds-dtl.artic no-lock.
    19301   gds-rec = recid  (ub.goods).
    19302   find ub.gds-prt where ub.gds-prt.upper-code = ub.goods.prt-root no-lock.
    19303   if ub.gds-prt.node-name = '_Пустая шкала':U then do:
    19304     message "Товар :" ub.goods.artic ub.goods.gds-name "не делится на признаки - шкала недoступна.".
    19305     return error.
    19306   end.
    19307   if pardoc-mode = 'ПРОСМОТР':U then do:
    19308     assign
    19309       varprt-mode  = 'ПРОСМОТР':U
    19310       varline-mode = 'ПРОСМОТР':U
    19311       work-mode    = "lookup-scale".
    19312   end.
    19313   else do:
    19314     define variable l-inv-on as logical no-undo .
    19315   define variable vss-include-info128 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    19316   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
    19317     (input  ub.doc-line.obj-type
    19318     ,input  ub.doc-line.obj-code
    19319     ,input  ub.doc-line.artic
    19320     ,input  ub.doc-line.prod-type
    19321     ,input  ub.doc-line.prod-code
    19322     ,input  'inv-on=request'
    19323     ,output l-inv-on
    19324     ) no-error .
    19325     if error-status :error then do:
    19326       message
    19327         "Ошибка получения признака товара на объекте" skip
    19328         error-status :get-message(1) skip
    19329         return-value skip
    19330         view-as alert-box error .
    19331       undo, return no-apply .
    19332     end.
    19333     if l-inv-on then do:
    19334       message "Артикул :" ub.doc-line.artic ub.goods.gds-name
    19335                       "- товар в инвентаризации."
    19336                       skip (2) "Операция невозможна.".
    19337       return error.
    19338     end.
    19339     assign
    19340       varprt-mode  = 'ШКАЛА':U
    19341       varline-mode = 'ИЗМЕНЕНИЕ':U
    19342       work-mode = "update-scale".
    19343   end.
    19344   END PROCEDURE.
    19345   PROCEDURE ui-on :
    19346   define input parameter fnc as character no-undo.
    19347   define variable varexist                  as logical   no-undo.
    19348   define variable varpurch-limit            as character no-undo.
    19349   define variable varpurch-limit-type       as character no-undo.
    19350   define variable varpurch-code-string      as character no-undo.
    19351   define variable varpurch-code-string-type as character no-undo.
    19352   define buffer bf_doc-line for ub.doc-line.
    19353   define buffer bf_contract for ub.contract.
    19354   assign
    19355     del-list = "":U
    19356     loc-art  = "":U
    19357   .
    19358   if fnc = "enable" then do:
    19359     disable all with frame d-out-doc.
    19360     hide loc-art in frame d-out-doc loc-name loc-code in frame d-out-doc.
    19361     enable b-exit b-lkp b-help br-dtl b-arch b-history a-n-c b-notes b-cnt b-attr with frame d-out-doc.
    19362     if  t-doc.status_      = 'накл':U
    19363     and t-doc.flag_        = false
    19364     and t-doc.ext-doc-type = 're':U
    19365     then do:
    19366       enable b-rsrv-doc-list with frame d-out-doc .
    19367     end.
    19368     if t-doc.ext-doc-type = 'ee':U
    19369     then do:
    19370       find first ub.global-state no-lock no-error .
    19371       if pardoc-mode <> 'ПРОСМОТР':U and available ub.global-state and  ub.global-state.pl-use-sum-group then do:
    19372           enable b-re-price with frame d-out-doc .
    19373         end.
    19374     end.
    19375     else do:
    19376       hide b-re-price in frame d-out-doc .
    19377     end.
    19378     if t-doc.status_ = 'готов':U or
    19379        t-doc.status_ = 'отказ':U
    19380     then do:
    19381        enable b-dopinf b-notes-line  with frame d-out-doc.
    19382     end.
    19383     else do:
    19384      if  v-is-flora-ord then  do:
    19385               enable   b-dopinf  b-notes-line  with frame d-out-doc.
    19386          end.
    19387          else hide  b-dopinf  b-notes-line  in frame d-out-doc.
    19388     end.
    19389     enable b-parts b-marks with frame d-out-doc.
    19390     if prtvalue = "yes" and v-cntxp-doc-prt then enable b-prt with frame d-out-doc.
    19391     if t-doc.ext-doc-type = 'ep':U then enable b-parts b-marks with frame d-out-doc.
    19392     if pardoc-mode = 'ДОБАВЛЕНИЕ':U then do:
    19393       run create-record in this-procedure (  input t-doc.doc-code
    19394                                           ,  input 'purchlimit':U
    19395                                           ,  input "no":U
    19396                                           , output varexist ) .
    19397       if varexist = no then do:
    19398   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t-doc.doc-code ,
    19399                          input 'purchcodelist':U ,
    19400                          input '1,2,3,4':U )  .
    19401       end.
    19402     end.
    19403   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
    19404                           input 'purchlimit':U ,
    19405                          output varpurch-limit ,
    19406                          output varpurch-limit-type )  .
    19407     if varpurch-limit = "no":u then do:
    19408       assign
    19409         varpurch-chs = 0.
    19410       assign
    19411         is-repay   = yes
    19412         is-cons    = yes
    19413         is-storage = yes
    19414         is-oldcons = yes.
    19415     end.
    19416     else do:
    19417       assign
    19418         varpurch-chs = 1.
    19419   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
    19420                           input 'purchcodelist':U ,
    19421                          output varpurch-code-string ,
    19422                          output varpurch-code-string-type )  .
    19423       if lookup ('1':U, varpurch-code-string) > 0 then do:
    19424         assign
    19425           is-repay = yes.
    19426       end.
    19427       if lookup ('2':U, varpurch-code-string) > 0 then do:
    19428         assign
    19429           is-cons = yes.
    19430       end.
    19431       if lookup ('3':U, varpurch-code-string) > 0 then do:
    19432         assign
    19433           is-storage = yes.
    19434       end.
    19435       if lookup ('4':U, varpurch-code-string) > 0 then do:
    19436         assign
    19437           is-oldcons = yes.
    19438       end.
    19439     end.
    19440     case t-doc.status_ :
    19441          when 'накл':U then do:
    19442              if t-doc.flag_ then assign ub.gds-dtl.doc-qnty:read-only  in browse br-dtl = yes.
    19443              assign ub.gds-dtl.fact-qnty:read-only  in browse br-dtl = yes.
    19444          end.
    19445          when 'разрешен':U then assign ub.gds-dtl.doc-qnty:read-only  in browse br-dtl = yes.
    19446          otherwise   assign ub.gds-dtl.doc-qnty:read-only  in browse br-dtl = yes
    19447                             ub.gds-dtl.fact-qnty:read-only in browse br-dtl = yes.
    19448     end case.
    19449     case pardoc-mode :
    19450       when 'ПРОСМОТР':U  then do:
    19451            assign ub.gds-dtl.doc-qnty:read-only  in browse br-dtl = yes
    19452                   ub.gds-dtl.fact-qnty:read-only in browse br-dtl = yes.
    19453            if parext-doc-mode = "":U then do:
    19454               if br-handle = ? then hide b-prev b-next in frame d-out-doc .
    19455                                else enable b-prev b-next with frame d-out-doc.
    19456            end.
    19457            if parext-doc-mode = "reason-code" then do:
    19458               enable r-reas t-doc.reason-code with frame d-out-doc.
    19459             end.
    19460       end.
    19461       when 'ДОБАВЛЕНИЕ':U then do: enable t-doc.cli-code t-doc.cli-type r-clients with frame d-out-doc. end.
    19462       when 'ИЗМЕНЕНИЕ':U  then do:
    19463         if t-doc.ext-doc-type = 'rv':U then do:
    19464            assign ub.gds-dtl.doc-qnty:read-only  in browse br-dtl = yes
    19465                   ub.gds-dtl.fact-qnty:read-only in browse br-dtl = yes.
    19466         end.
    19467         if lookup(t-doc.doc-type, 'рас,спи':U) > 0
    19468         then do:
    19469           varlog = no.
    19470           case t-doc.doc-type
    19471           :
    19472             when 'рас':U
    19473             then do:
    19474   define variable vss-include-info129 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    19475   do:
    19476     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    19477       (input  v-cntxt-db-num
    19478       ,input  v-cntxt-userid
    19479       ,input  0
    19480       ,input  'actn_expense_price':U
    19481       ,input  'object':U
    19482       ,input  t-doc.host-code
    19483       ,input  t-doc.obj-type
    19484       ,input  t-doc.obj-code
    19485       ,input  0
    19486       ,input  0
    19487       ,input  0
    19488       ,input  false
    19489       ,output varlog
    19490       )  .
    19491   end.
    19492             end.
    19493             when 'спи':U
    19494             then do:
    19495   define variable vss-include-info130 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    19496   do:
    19497     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    19498       (input  v-cntxt-db-num
    19499       ,input  v-cntxt-userid
    19500       ,input  0
    19501       ,input  'actn_write-off_price':U
    19502       ,input  'object':U
    19503       ,input  t-doc.host-code
