     5169   ON CHOOSE OF b-verify IN FRAME Dlg-grp
     5170   DO:
     5171   message "Запускать утилиту проверки проставленных ограничений по всем уровням ? "
     5172    view-as alert-box question
     5173          BUTTONS yes-no
     5174         update v-ok as logical.
     5175     if not v-ok then return .
     5176   define variable v-str as character no-undo .
     5177   define variable v-i as integer   no-undo .
     5178   v-str = "" .
     5179   v-i   = 0  .
     5180   for each temp_grplib_grp :
     5181       find first temp_cons where temp_cons.node-code = temp_grplib_grp.node-code no-error .
     5182           if not available temp_cons then create temp_cons.
     5183           assign
     5184               temp_cons.full-name  = temp_grplib_grp.full-name
     5185               temp_cons.node-code  = temp_grplib_grp.node-code
     5186               temp_cons.upper-code = temp_grplib_grp.upper-code
     5187               temp_cons.min-marg   = temp_grplib_grp.min-marg
     5188               temp_cons.max-marg   = temp_grplib_grp.max-marg
     5189               temp_cons.cli-type   = temp_grplib_grp.cli-type
     5190           .
     5191   end.
     5192     for each temp_cons where
     5193             int(temp_cons.cli-type) < int(temp_cons.min-marg)
     5194         and int(temp_cons.cli-type) <> ?
     5195         and temp_cons.cli-type <> ""
     5196         and int(temp_cons.min-marg) <> ?
     5197         :
     5198           v-i = v-i + 1.
     5199           v-str = v-str + trim(temp_cons.full-name) + " ограничение : " + temp_cons.cli-type + " должно быть >= " + temp_cons.min-marg + chr(10) .
     5200     end.
     5201   for each temp_cons where
     5202           int(temp_cons.cli-type) < int(temp_cons.max-marg)
     5203       and int(temp_cons.cli-type) <> ?
     5204       and temp_cons.cli-type <> ""
     5205       and int(temp_cons.max-marg) <> ?
     5206       :
     5207     v-i = v-i + 1.
     5208     v-str = v-str + trim(temp_cons.full-name) + " ограничение : " + temp_cons.cli-type + " (а товара в группе " + temp_cons.max-marg + " !)" + chr(10) .
     5209   end.
     5210      if v-i > 0 then
     5211      run gbl/notes.w ('ПРОСМОТР':U,input-output v-str) .
     5212      else message "Все ОК!" view-as alert-box information .
     5213   END.
