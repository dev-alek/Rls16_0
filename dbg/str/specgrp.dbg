     4880       then do:
     4881           message
     4882             vss-workfile vss-revision vss-description
     4883             skip "Ошибка операции с деревом групп."
     4884             skip return-value
     4885             skip trim(error-status :get-message(1))
     4886                  trim(error-status :get-message(2))
     4887                  trim(error-status :get-message(3))
     4888                  trim(error-status :get-message(4))
     4889                  trim(error-status :get-message(5))
     4890           view-as alert-box error.
     4891           undo, return no-apply .
     4892       end.
     4893       RUN OpenBr(yes, no, '':U).
     4894   END.
