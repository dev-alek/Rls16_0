     4412     assign g-log = no .
     4413     if mark-num > 0 then do:
     4414       message "Вы действительно хотите изменить все выделенные спецификации?"
     4415       view-as alert-box QUESTION BUTTONS YES-NO UPDATE g-log .
     4416       if g-log = no then return no-apply.
     4417     end.
     4418     if mark-num > 1 then do:
     4419       if b-prc then assign v-prc = FILL-prc .
     4420       else          assign v-prc = 0 .
