        1   DEFINE BUFFER buf_contract-specif FOR ub.contract-specif.
        2   DEFINE BUFFER buf_goods FOR ub.goods.
        3   define input parameter parparentproc        as handle           no-undo.
        4   define input parameter p-host-code          as integer   no-undo .
        5   define input parameter p-contract-num       as integer   no-undo .
        6   define input parameter p-button-list        as character        no-undo.
        7   define input parameter p-current-obj-type   as character        no-undo.
        8   define input parameter p-current-obj-code   as integer          no-undo.
        9   define input-output parameter p-recid-list  as character        no-undo.
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       14   define variable vss-archive     as character no-undo init "$Archive$":U .
       15   define variable vss-description as character no-undo init "Управление деревом групп".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   procedure proc-alt-shift-f2:
       86     if not ibs.th.gbl.gbl-var:rcode
       87   then
       88     run gbl\inidebug.p .
       89   end.
       90   procedure proc-alt-shift-f3:
       91     run gbl/prvssinf.p
       92       ( input this-procedure
       93       ) .
       94   end.
       95   define variable v-inform-launched as logical no-undo initial false .
       96   procedure proc-alt-shift-f4:
       97     define variable v-action as character no-undo .
       98     if v-inform-launched = false then do:
       99       assign
      100         v-inform-launched = true
      101       .
      102       run gbl/d-inform.w
      103         (  input self
      104         ,  input this-procedure
      105         , output v-action
      106         ) no-error .
      107       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      108       assign
      109         v-inform-launched = false
      110       .
      111     end.
      112   end.
      113   procedure proc-alt-f1:
      114     run gbl/corrhelp.p
      115       (input this-procedure
      116       ) .
      117   end .
      118   on alt-shift-f2 anywhere do:
      119     run proc-alt-shift-f2.
      120   end.
      121   on alt-shift-f3 anywhere do:
      122     run proc-alt-shift-f3 in this-procedure .
      123   end.
      124   on alt-shift-f4 anywhere do:
      125     run proc-alt-shift-f4 in this-procedure.
      126   end.
      127   on alt-f1 anywhere do:
      128     run proc-alt-f1 in this-procedure .
      129   end.
      130   define variable vss-include-info0 as character format "X(65)" no-undo
      131   initial "@(#)$Workfile$ $Revision$".
      132   define temp-table temp_grplib_grp no-undo
      133       field sel           as character
      134       field nabor         as character
      135       field full-name     as character
      136       field print-code    as character
      137       field sort-name     as character
      138       field node-code     as integer
      139       field upper-code    as integer
      140       field calc-method   as character
      141       field round-method  as character
      142       field increase-pc   as decimal
      143       field min-marg      as character
      144       field max-marg      as character
      145       field cli-type      as character
      146       field cli-code      as integer
      147       field notcorr      as character
      148       field name          as character
      149       field level         as integer
      150       field mark          as character
      151       index pi is primary unique sort-name
      152       index fn full-name
      153       index nc is unique node-code
      154       index sl sel
      155       index uc upper-code
      156   .
      157   define temp-table temp_grplib_found-grp no-undo
      158       field full-name   as character
      159       field sort-name   as character
      160       field node-code   as integer
      161       field level       as integer
      162       field is-terminal as logical
      163       index pi is primary unique sort-name
      164       index fn full-name
      165       index lv level
      166       index it is-terminal
      167   .
      168   define temp-table temp_found-result-nodelist no-undo
      169       field node-code     as recid
      170       field processed     as logical
      171       field sort-name     as character
      172       field full-name     as character
      173       index pi is primary unique node-code
      174       index ps processed
      175   .
      176   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
      177   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
      178   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
      179   procedure grplib-get-parameters :
      180   define input parameter p-store-type     as character        no-undo.
      181   define input parameter p-store-code     as integer          no-undo.
      182   do
      183   on error undo, return error
      184   :
      185       assign
      186           v-grplib-not-fill-extra-info = no
      187       .
      188   end.
      189   end procedure.
      190   procedure grplib-get-sort-name :
      191   do
      192   on error undo, return error
      193   :
      194   define input parameter p-node-code  as integer      no-undo.
      195   define output parameter p-sort-name as character    no-undo.
      196       define variable v-upper-code    as integer           no-undo.
      197       define buffer buf_gds-grp       for ub.gds-grp.
      198       define buffer buf_upper_gds-grp for ub.gds-grp.
      199       find first buf_gds-grp no-lock
      200            where buf_gds-grp.node-code = p-node-code
      201       no-error.
      202       if not available buf_gds-grp
      203       then do:
      204           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      205       end.
      206       assign
      207           p-sort-name  = ""
      208           v-upper-code = 1
      209       .
      210       do while buf_gds-grp.upper-code <> 0
      211       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
      212       :
      213           assign
      214               p-sort-name  = buf_gds-grp.node-name
      215                            + (if p-sort-name <> "" then chr(2) else "")
      216                            + p-sort-name
      217               v-upper-code = buf_gds-grp.upper-code
      218           .
      219           find first buf_gds-grp no-lock
      220                where buf_gds-grp.node-code = v-upper-code
      221           no-error.
      222           if not available buf_gds-grp
      223           then do:
      224               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
      225                                   + string( v-upper-code )
      226                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      227           end.
      228       end.
      229   end.
      230   end procedure.
      231   define variable vss-include-info1 as character format "X(65)" no-undo
      232   initial "@(#)$Workfile$ $Revision$".
      233   procedure grplib-get-full-name :
      234      define input parameter p-node-code  as integer      no-undo.
      235      define output parameter p-full-name as character    no-undo.
      236      do
      237   on error undo, return error
      238   :
      239       define variable v-upper-code    as integer           no-undo.
      240       define buffer buf_gds-grp       for ub.gds-grp.
      241       define buffer buf_upper_gds-grp for ub.gds-grp.
      242       find first buf_gds-grp no-lock
      243            where buf_gds-grp.node-code = p-node-code
      244       no-error.
      245       if not available buf_gds-grp
      246       then do:
      247           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      248       end.
      249       assign
      250           p-full-name  = ""
      251           v-upper-code = 1
      252       .
      253       do while buf_gds-grp.upper-code <> 0
      254       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      255       :
      256           assign
      257               p-full-name  = buf_gds-grp.node-name
      258                            + (if p-full-name <> "" then chr(47) else "")
      259                            + p-full-name
      260               v-upper-code = buf_gds-grp.upper-code
      261           .
      262           find first buf_gds-grp no-lock
      263                where buf_gds-grp.node-code = v-upper-code
      264           no-error.
      265           if not available buf_gds-grp
      266           then do:
      267               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      268                                   + string( v-upper-code )
      269                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      270           end.
      271       end.
      272       assign
      273       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      274       .
      275   end.
      276   end .
      277   procedure grplib-get-node-from-full-name :
      278   define input parameter p-full-name as character no-undo .
      279   define output parameter p-node-code as integer no-undo .
      280   define variable v-ii as integer no-undo .
      281   define variable v-upper-code as integer no-undo .
      282   define variable v-root-code as integer no-undo .
      283   define variable v-entry as character no-undo .
      284   define buffer buf_gds-grp       for ub.gds-grp.
      285   do
      286   on error undo, return error
      287   :
      288     find first buf_gds-grp no-lock
      289         where buf_gds-grp.upper-code = 0
      290     no-error .
      291     if not available buf_gds-grp
      292     then do:
      293         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      294     end.
      295     else do:
      296       assign
      297       v-root-code = buf_gds-grp.node-code
      298       .
      299     end.
      300     v-upper-code = v-root-code.
      301     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      302       assign
      303       v-entry = entry(v-ii, p-full-name, chr(47)).
      304       if v-entry = '' then leave.
      305       find first buf_gds-grp no-lock where
      306                 buf_gds-grp.node-name = v-entry
      307             and buf_gds-grp.upper-code = v-upper-code
      308             no-error.
      309       if not available buf_gds-grp then do:
      310         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      311       end.
      312       else do:
      313         p-node-code = buf_gds-grp.node-code.
      314         v-upper-code = buf_gds-grp.node-code.
      315       end.
      316     end.
      317   end.
      318   end .
      319   procedure grplib-get-root-code :
      320   do
      321   on error undo, return error
      322   :
      323   define output parameter p-root-code as integer      no-undo.
      324       define buffer buf_gds-grp       for ub.gds-grp.
      325       find first buf_gds-grp no-lock
      326           where buf_gds-grp.upper-code = 0
      327       no-error .
      328       if not available buf_gds-grp
      329       then do:
      330           undo, return error .
      331       end.
      332       else do:
      333           assign
      334               p-root-code = buf_gds-grp.node-code
      335           .
      336       end.
      337   end.
      338   end procedure.
      339   procedure grplib-find-grp-by-full-name :
      340   do
      341   on error undo, return error
      342   :
      343   define input parameter p-search-name  as character    no-undo.
      344   define input parameter p-fill-path    as logical      no-undo.
      345   define output parameter p-found       as logical      no-undo.
      346       define variable v-upper-code    as integer          no-undo.
      347       define variable v-counter       as integer           no-undo.
      348       define variable v-level         as integer           no-undo.
      349       define variable v-full-name     as character         no-undo.
      350       define variable v-sort-name     as character         no-undo.
      351       define buffer buf_gds-grp       for ub.gds-grp.
      352       assign
      353           p-search-name = replace( p-search-name, chr(47), chr(2) )
      354       .
      355       run grplib-get-root-code ( output v-upper-code ) no-error .
      356       if error-status :error
      357       then do:
      358           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
      359       end.
      360       assign
      361           v-full-name  = ""
      362           v-level      = num-entries( p-search-name, chr(2) )
      363       .
      364       for each temp_grplib_found-grp
      365       :
      366           delete temp_grplib_found-grp.
      367       end.
      368       start-name-analyze:
      369       do v-counter = 1 to v-level
      370       :
      371           if v-counter < v-level
      372           then do:
      373               find first buf_gds-grp no-lock
      374                    where buf_gds-grp.upper-code = v-upper-code
      375                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      376               no-error .
      377               if not available buf_gds-grp
      378               then do:
      379                   assign
      380                       v-full-name  = p-search-name
      381                       v-sort-name  = p-search-name
      382                   .
      383                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      384               end.
      385               else do:
      386                   assign
      387                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
      388                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
      389                       v-upper-code = buf_gds-grp.node-code
      390                   .
      391                   if p-fill-path = yes
      392                   then do:
      393                       create temp_grplib_found-grp.
      394                       assign
      395                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
      396                           temp_grplib_found-grp.sort-name = v-sort-name
      397                           temp_grplib_found-grp.node-code = v-upper-code
      398                           temp_grplib_found-grp.level     = v-counter
      399                       .
      400                   end.
      401               end.
      402           end.
      403           else do:
      404               for each buf_gds-grp no-lock
      405                  where buf_gds-grp.upper-code = v-upper-code
      406                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      407               :
      408                   assign
      409                       p-found = yes
      410                   .
      411                   create temp_grplib_found-grp.
      412                   assign
      413                       temp_grplib_found-grp.full-name = v-full-name
      414                                                           + (if v-full-name = "" then "" else chr(47) )
      415                                                           + buf_gds-grp.node-name + chr(47)
      416                       temp_grplib_found-grp.sort-name = v-sort-name
      417                                                           + ( if v-sort-name = "" then "" else chr(2) )
      418                                                           + buf_gds-grp.node-name
      419                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
      420                       temp_grplib_found-grp.level     = v-level
      421                   .
      422               end.
      423               if p-found = no
      424               then do:
      425                   assign
      426                       v-full-name  = p-search-name
      427                       v-sort-name  = p-search-name
      428                   .
      429                   for each temp_grplib_found-grp
      430                   :
      431                       delete temp_grplib_found-grp.
      432                   end.
      433                   assign
      434                       p-found = no
      435                   .
      436               end.
      437           end.
      438       end.
      439   end.
      440   end procedure.
      441   procedure grplib-find-all-subgroup :
      442   do
      443   on error undo, return error
      444   :
      445   define input parameter p-start-node-code    as integer      no-undo.
      446   define input parameter p-terminal-only      as logical      no-undo.
      447       define variable v-start-full-name   as character     no-undo.
      448       define variable v-start-sort-name   as character     no-undo.
      449       define variable v-not-found         as logical       no-undo.
      450       define variable v-is-terminal       as logical       no-undo.
      451       define buffer buf_gds-grp           for ub.gds-grp.
      452       create temp_found-result-nodelist.
      453       assign
      454           temp_found-result-nodelist.node-code = p-start-node-code
      455           temp_found-result-nodelist.processed = no
      456       .
      457       run grplib-get-full-name in this-procedure (
      458             input p-start-node-code
      459           , output v-start-full-name
      460       ).
      461       run grplib-get-full-name in this-procedure (
      462             input p-start-node-code
      463           , output v-start-sort-name
      464       ).
      465       process-nodes:
      466       do while yes
      467       :
      468           find first temp_found-result-nodelist
      469                where temp_found-result-nodelist.node-code = p-start-node-code
      470           .
      471           assign
      472               temp_found-result-nodelist.processed = yes
      473           .
      474           for each buf_gds-grp no-lock
      475              where buf_gds-grp.upper-code = p-start-node-code
      476           on error undo, return error
      477           :
      478               run grplib-is-terminal in this-procedure (
      479                     input buf_gds-grp.node-code
      480                   , output v-is-terminal
      481               ).
      482               if v-is-terminal = yes
      483               then do:
      484                   create temp_grplib_found-grp.
      485                   assign
      486                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      487                                                           chr(47) + buf_gds-grp.node-name + chr(47)
      488                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      489                                                           chr(2) + buf_gds-grp.node-name + chr(2)
      490                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      491                       temp_grplib_found-grp.is-terminal = yes
      492                   .
      493               end.
      494               else do:
      495                   create temp_found-result-nodelist.
      496                   assign
      497                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
      498                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      499                                                              chr(47) + buf_gds-grp.node-name + chr(47)
      500                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      501                                                              chr(2) + buf_gds-grp.node-name + chr(2)
      502                       temp_found-result-nodelist.processed = no
      503                   .
      504                   if p-terminal-only = no
      505                   then do:
      506                       create temp_grplib_found-grp.
      507                       assign
      508                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      509                                                               chr(47) + buf_gds-grp.node-name + chr(47)
      510                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      511                                                               chr(2) + buf_gds-grp.node-name + chr(2)
      512                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      513                           temp_grplib_found-grp.is-terminal = no
      514                       .
      515                   end.
      516               end.
      517           end.
      518           find first temp_found-result-nodelist
      519                where temp_found-result-nodelist.processed = no
      520           no-error.
      521           if not available temp_found-result-nodelist
      522           then do:
      523               leave process-nodes.
      524           end.
      525           else do:
      526               assign
      527                   p-start-node-code = temp_found-result-nodelist.node-code
      528                   v-start-full-name = temp_found-result-nodelist.full-name
      529                   v-start-sort-name = temp_found-result-nodelist.sort-name
      530               .
      531           end.
      532       end.
      533   end.
      534   end procedure.
      535   procedure grplib-expand-name :
      536   define input parameter p-start-name as character        no-undo.
      537   define output parameter p-end-name  as character        no-undo.
      538       define variable v-is-terminal   as logical      no-undo.
      539       define variable v-found         as character    no-undo.
      540       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
      541   do
      542   for buf_temp_grplib_found-grp
      543   on error undo, return error
      544   :
      545       run grplib-find-grp-by-full-name in this-procedure (
      546             input p-start-name
      547           , input no
      548           , output v-found
      549       ) no-error.
      550       run grplib-get-max-substring in this-procedure (
      551                   input length( p-start-name )
      552                 , output p-end-name
      553       ) no-error .
      554       if error-status :error
      555       then do:
      556           assign
      557               p-end-name = ""
      558           .
      559       end.
      560       else do:
      561           find first temp_grplib_found-grp
      562               where temp_grplib_found-grp.full-name = p-end-name
      563           no-error.
      564           if available temp_grplib_found-grp
      565           then do:
      566               find first buf_temp_grplib_found-grp
      567                   where buf_temp_grplib_found-grp.full-name begins p-end-name
      568                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
      569               no-error.
      570               if not available buf_temp_grplib_found-grp
      571               then do:
      572                   run grplib-is-terminal in this-procedure (
      573                       input temp_grplib_found-grp.node-code
      574                       , output v-is-terminal
      575                   ).
      576               end.
      577           end.
      578       end.
      579   end.
      580   end procedure.
      581   procedure grplib-get-max-substring :
      582   do
      583   on error undo, return error
      584   :
      585   define input parameter p-min-substring-length   as integer      no-undo.
      586   define output parameter p-substring             as character    no-undo.
      587           define variable v-char-counter  as integer           no-undo.
      588           define variable v-current-char  as character         no-undo.
      589           define variable v-names-counter  as integer           no-undo.
      590           define variable v-base-string   as character         no-undo.
      591           assign
      592               v-char-counter  = p-min-substring-length
      593           .
      594           find first temp_grplib_found-grp no-error.
      595           if not available temp_grplib_found-grp
      596           then do:
      597               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
      598           end.
      599           else do:
      600               assign
      601                   v-base-string  = temp_grplib_found-grp.full-name
      602                   v-char-counter = 0
      603               .
      604               counter-block:
      605               do while yes
      606               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
      607               :
      608                   assign
      609                       v-char-counter  = v-char-counter + 1
      610                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      611                       v-names-counter = 0
      612                   .
      613                   compare-block:
      614                   for each temp_grplib_found-grp
      615                   :
      616                       assign
      617                           v-names-counter = v-names-counter + 1
      618                       .
      619                       if v-names-counter = 1
      620                       then do:
      621                           next compare-block.
      622                       end.
      623                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      624                       then do:
      625                           leave counter-block.
      626                       end.
      627                   end.
      628                   if v-names-counter = 1
      629                   then do:
      630                       assign
      631                           p-substring = v-base-string
      632                       .
      633                       return.
      634                   end.
      635               end.
      636               assign
      637                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      638               .
      639           end.
      640   end.
      641   end procedure.
      642   procedure grplib-is-terminal :
      643   do
      644   on error undo, return error "Ошибка процедуры grplib-is-terminal"
      645   :
      646   define input parameter p-node-code      as integer      no-undo.
      647   define output parameter p-is-terminal   as logical      no-undo.
      648       define buffer buf_gds-grp       for ub.gds-grp.
      649       find first buf_gds-grp no-lock
      650           where buf_gds-grp.upper-code = p-node-code
      651       no-error .
      652       if not available buf_gds-grp
      653       then do:
      654           assign
      655               p-is-terminal = yes
      656           .
      657       end.
      658       else do:
      659           assign
      660               p-is-terminal = no
      661           .
      662       end.
      663   end.
      664   end procedure.
      665   procedure grplib-have-goods :
      666   do
      667   on error undo, return error
      668   :
      669   define input parameter p-node-code      as integer      no-undo.
      670   define output parameter p-have-goods   as logical      no-undo.
      671       define buffer buf_goods         for ub.goods.
      672       find first buf_goods no-lock
      673            where buf_goods.grp-code = p-node-code
      674       no-error .
      675       if available buf_goods
      676       then do:
      677           assign
      678               p-have-goods = yes
      679           .
      680       end.
      681       else do:
      682           assign
      683               p-have-goods = no
      684           .
      685       end.
      686   end.
      687   end procedure.
      688   procedure grplib-find-by-substring :
      689   do
      690   on error undo, return error
      691   :
      692   define input parameter p-start-code         as integer      no-undo.
      693   define input parameter p-full-search-string as character    no-undo.
      694   define output parameter p-found-code        as integer      no-undo.
      695   define output parameter p-full-name         as character    no-undo.
      696       define variable v-start-code     as integer           no-undo.
      697       define variable v-found          as logical  init no  no-undo.
      698       define buffer buf_gds-grp       for ub.gds-grp.
      699       search-grp:
      700       for each buf_gds-grp no-lock
      701           where buf_gds-grp.node-code > p-start-code
      702       :
      703           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
      704           then do:
      705               assign
      706                   p-found-code = buf_gds-grp.node-code
      707                   v-found      = yes
      708               .
      709               run grplib-get-full-name in this-procedure (
      710                     input p-found-code
      711                   , output p-full-name
      712               ) no-error .
      713               if error-status :error
      714               then do:
      715                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
      716               end.
      717               leave search-grp.
      718           end.
      719       end.
      720       if v-found = yes
      721       then do:
      722       end.
      723       else do:
      724           assign
      725               p-full-name  = ""
      726               p-found-code = 0
      727           .
      728       end.
      729   end.
      730   end procedure.
      731   procedure grplib-analyze-grp-name :
      732   do
      733   on error undo, return error
      734   :
      735   define input parameter p-grp-name       as character            no-undo.
      736   define input parameter p-upper-code     as integer              no-undo.
      737   define output parameter p-error-message as character init ""    no-undo.
      738       define variable v-char-list     as character    no-undo.
      739       define variable v-char-counter  as integer      no-undo.
      740       define variable v-full-name     as character    no-undo.
      741       if p-grp-name = "" then do:
      742           assign
      743               p-error-message = "Название группы не может быть пустым.".
      744           .
      745       end.
      746       else do:
      747           assign
      748               v-char-list = "47,92,58,63,34,60,62,171,187,183"
      749           .
      750           do v-char-counter = 1 to num-entries( v-char-list )
      751           :
      752               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
      753               then do:
      754                   assign
      755                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
      756                   .
      757                   return.
      758               end.
      759           end.
      760           if p-upper-code > 0
      761           then do:
      762               run grplib-get-full-name in this-procedure (
      763                     input p-upper-code
      764                   , output v-full-name
      765               ) no-error .
      766               if error-status :error
      767               then do:
      768                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
      769               end.
      770               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
      771               then do:
      772                   assign
      773                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
      774                   .
      775               end.
      776           end.
      777       end.
      778   end.
      779   end procedure.
      780   procedure grplib-get-lvl-num :
      781   define input parameter p-node-code  as integer      no-undo.
      782   define output parameter p-lvl-num   as integer      no-undo.
      783       define variable v-full-name    as character    no-undo.
      784   do
      785   on error undo, return error
      786   :
      787       run grplib-get-full-name in this-procedure (
      788             input p-node-code
      789           , output v-full-name
      790       ).
      791       assign
      792           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
      793       .
      794       if p-lvl-num = -1
      795       then do:
      796           assign
      797               p-lvl-num = 0
      798           .
      799       end.
      800   end.
      801   end procedure.
      802   define new global shared variable g#lib-Matrix  as handle no-undo .
      803   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      804   procedure cur-time :
      805      define output parameter p-today as date      no-undo .
      806      define output parameter p-time  as integer   no-undo .
      807     do
      808     on error undo, return error
      809     :
      810       define variable v-date1 as date      no-undo .
      811       define variable v-date2 as date      no-undo .
      812       define variable v-time  as integer   no-undo .
      813       assign
      814         v-date1 = today
      815         v-time  = time
      816         v-date2 = today
      817       .
      818       if v-date1 <> v-date2
      819       then do:
      820         assign
      821           v-date1 = today
      822           v-time  = v-time
      823         .
      824       end.
      825       assign
      826         p-today = v-date1
      827         p-time  = v-time
      828       .
      829     end.
      830   end.
      831   function cur-time-date returns character
      832   :
      833     return string(today, '99/99/9999':U) .
      834   end.
      835   function cur-time-mjd returns decimal
      836   :
      837     define variable v-date as date      no-undo .
      838     define variable v-time as integer   no-undo .
      839     run cur-time in this-procedure
      840       (output v-date
      841       ,output v-time
      842       ) .
      843     return integer(v-date) - 2400002 + (v-time / 86400) .
      844   end.
      845   function cur-time-get-ending-index returns integer
      846   (input p-number as integer
      847   )
      848   :
      849     if p-number < 0
      850     or p-number = ?
      851     then do:
      852       return 1 .
      853     end.
      854     define variable v-rest as integer   no-undo .
      855     assign
      856       p-number = p-number modulo 100
      857     .
      858     if p-number < 20
      859     then do:
      860       assign
      861         v-rest = p-number
      862       .
      863     end.
      864     else do:
      865       assign
      866         v-rest = p-number modulo 10
      867       .
      868     end.
      869     case v-rest :
      870       when 1
      871       then do:
      872         return 2 .
      873       end.
      874       when 2 or
      875       when 3 or
      876       when 4
      877       then do:
      878         return 3 .
      879       end.
      880       otherwise do:
      881         return 1 .
      882       end.
      883     end case .
      884   end.
      885   procedure cur-time-mjd-to-date :
      886      define input  parameter i-mjd-diff as decimal no-undo.
      887      define output parameter o-Date     as date    no-undo.
      888      define output parameter o-Time     as integer no-undo.
      889      define variable v-day-number as integer   no-undo .
      890      if    i-mjd-diff < 0
      891         or i-mjd-diff = ?
      892      then do:
      893         return "?" .
      894      end.
      895      assign
      896         v-day-number = truncate(i-mjd-diff,0).
      897         o-Date = date(v-day-number + 2400002).
      898         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      899     .
      900   end.
      901   function cur-time-mjd-to-string returns character
      902   (input p-mjd-diff as decimal
      903   )
      904   :
      905     define variable v-day-number as integer   no-undo .
      906     define variable v-seconds    as integer   no-undo .
      907     define variable v-hour       as integer   no-undo .
      908     define variable v-min        as integer   no-undo .
      909     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      910     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      911     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      912     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      913     if p-mjd-diff < 0
      914     or p-mjd-diff = ?
      915     then do:
      916       return "?" .
      917     end.
      918     assign
      919       v-day-number = integer(truncate(p-mjd-diff,0))
      920       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      921     .
      922     if v-seconds > 86400
      923     then do:
      924       assign
      925         v-seconds = 86400 - 1
      926       .
      927     end.
      928     if v-seconds < 0
      929     then do:
      930       assign
      931         v-seconds = 0
      932       .
      933     end.
      934     assign
      935       v-hour = truncate(v-seconds / 3600, 0)
      936     .
      937     assign
      938       v-seconds = v-seconds modulo 3600
      939     .
      940     assign
      941       v-min = truncate(v-seconds / 60, 0)
      942     .
      943     assign
      944       v-seconds = v-seconds modulo 60
      945     .
      946     return
      947         (if v-day-number <> 0
      948           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      949           else ""
      950         )
      951       + (if v-day-number <> 0 or v-hour <> 0
      952           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      953           else ""
      954         )
      955       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      956           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      957           else ""
      958         )
      959       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      960       .
      961   end.
      962   function cur-time-string returns character
      963   :
      964     define variable v-date as date      no-undo .
      965     define variable v-time as integer   no-undo .
      966     run cur-time in this-procedure
      967       (output v-date
      968       ,output v-time
      969       ) .
      970     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      971   end.
      972   function cur-time-string-sec returns character
      973   :
      974     define variable v-date as date      no-undo .
      975     define variable v-time as integer   no-undo .
      976     run cur-time in this-procedure
      977       (output v-date
      978       ,output v-time
      979       ) .
      980     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      981   end.
      982   function cur-time-custom  returns character
      983   (input p-prefix as character
      984   ,input p-date-format as character
      985   ,input p-delimiter as character
      986   ,input p-time-format as character
      987   ,input p-suffix as character
      988   )
      989   :
      990     define variable v-date as date      no-undo .
      991     define variable v-time as integer   no-undo .
      992     run cur-time in this-procedure
      993       (output v-date
      994       ,output v-time
      995       ) .
      996     return
      997       p-prefix
      998       + string(v-date, p-date-format)
      999       + p-delimiter
     1000       + string(v-time, p-time-format)
     1001       + p-suffix
     1002       .
     1003   end.
     1004   function cur-time-print  returns character
     1005   :
     1006     define variable v-date as date      no-undo .
     1007     define variable v-time as integer   no-undo .
     1008     run cur-time in this-procedure
     1009       (output v-date
     1010       ,output v-time
     1011       ) .
     1012     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1013   end.
     1014   function cur-time-datetime returns datetime
     1015   :
     1016     define variable v-char as character no-undo .
     1017     define variable v-datetime as datetime no-undo .
     1018     v-char = cur-time-string().
     1019     v-datetime = datetime(v-char).
     1020     return  v-datetime.
     1021   end.
     1022   function cur-time-string-msec returns character
     1023   :
     1024     define variable v-date as datetime  no-undo .
     1025     v-date = now.
     1026     return string(v-date) .
     1027   end.
     1028   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1029   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
     1030   define new shared variable RepPathName        as character no-undo .
     1031   define new shared variable PrintRubl          as logical   no-undo .
     1032   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1033   define variable v-waitfram-action01         as character   no-undo .
     1034   define variable v-waitfram-action02         as character   no-undo .
     1035   define variable v-waitfram-action03         as character   no-undo .
     1036   define variable mWaitFramTextBeg            as character   no-undo.
     1037   define variable mWaitFramTextEnd            as character   no-undo.
     1038   define variable mWaitFramView               as logical     no-undo.
     1039   define variable mWaitProcEvent              as logical     no-undo init yes.
     1040   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1041   define variable mWaitFramStop               as logical     no-undo.
     1042   define variable mWaitFramStopUser           as logical     no-undo.
     1043   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1044   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1045   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1046   define button B-WaitFramStop auto-end-key
     1047        label "Стоп"
     1048        size 10 by 1 tooltip "Остоновить процесс".
     1049   define button B-viewProcInfo
     1050        label "Информация"
     1051        size 15 by 1 tooltip "Информация о процесс".
     1052   define frame waitfram
     1053     v-waitfram-action01 format "x(72)" no-label skip
     1054     v-waitfram-action02 format "x(72)" no-label skip
     1055     v-waitfram-action03 format "x(72)" no-label skip
     1056     B-viewProcInfo
     1057     B-WaitFramStop at row 4 col 30
     1058     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1059     .
     1060   define new global shared variable mBatchMode as logical no-undo init ?.
     1061   define variable mFramBachModHandle as handle no-undo.
     1062   mFramBachModHandle = frame waitfram:handle.
     1063   define variable mFameOldVis as logical no-undo.
     1064   define variable mVisCUrentVin as logical no-undo.
     1065   if session:batch-mode
     1066   then
     1067      mBatchMode = yes.
     1068   if mBatchMode = ? then do:
     1069     mVisCUrentVin = current-window:visible.
     1070     mFameOldVis = mFramBachModHandle:visible.
     1071     mFramBachModHandle:visible  = yes.
     1072     mBatchMode = mFramBachModHandle:visible ne yes.
     1073     mFramBachModHandle:visible = mFameOldVis.
     1074     current-window:visible = mVisCUrentVin.
     1075   end.
     1076    if  log-manager:logfile-name ne ?
     1077     then DO:
     1078         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1079         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1080         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1081     end.
     1082   on choose of B-WaitFramStop in frame waitfram
     1083   do:
     1084     mWaitFramStop = yes.
     1085     mWaitFramStopUser = yes.
     1086   end.
     1087   function waitfram-check-timeout returns logical():
     1088      define variable vtime as int64 no-undo.
     1089      if mWaitFramStopTimeOut
     1090      then
     1091         return yes.
     1092      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1093      if     mWaitFramTimeOut ne ?
     1094         and mWaitFramTimeOut ne 0
     1095         and mWaitFramTimeOut lt vtime
     1096      then do:
     1097         mWaitFramStopTimeOut = yes.
     1098      end.
     1099      return mWaitFramStopTimeOut.
     1100   end.
     1101   procedure waitfram-hide :
     1102     if not session:batch-mode
     1103     then do
     1104     on error undo, return error return-value
     1105     :
     1106       pause 0 before-hide .
     1107       if not mBatchMode then
     1108         hide frame waitfram .
     1109     if     not mWaitFramView
     1110        and mWaitProcEvent
     1111     then
     1112       process events .
     1113     end.
     1114   end procedure.
     1115   procedure waitfram-show :
     1116     define input  parameter p-message as character no-undo .
     1117     define variable v-left-margin as integer   no-undo .
     1118     if not session:batch-mode
     1119     then do
     1120     on error undo, return error return-value
     1121     :
     1122       if length(p-message) <= 70 then do:
     1123         assign
     1124           v-left-margin = integer((70 - length(p-message)) / 2)
     1125         .
     1126         assign
     1127           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1128         .
     1129         assign
     1130           v-waitfram-action01 = " "
     1131           v-waitfram-action02 = " "
     1132                                    + fill(" ", v-left-margin)
     1133                                    + p-message
     1134           v-waitfram-action03 = " "
     1135         .
     1136       end.
     1137       else do:
     1138         define variable vRindex1 as integer no-undo.
     1139         define variable vRindex2 as integer no-undo.
     1140         vRindex1 = r-index(p-message," ",70).
     1141         if vRindex1 = 0
     1142         then
     1143            vRindex1 = 70.
     1144         if length(p-message)  <= vRindex1 + 70 then do:
     1145           assign
     1146             v-waitfram-action01 = " "
     1147             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1148             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1149           .
     1150         end.
     1151         else do:
     1152           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1153           if vRindex2 <= vRindex1
     1154           then
     1155              vRindex2 = vRindex1 + 70.
     1156           assign
     1157             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1158             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1159             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1160           .
     1161         end.
     1162       end.
     1163       B-viewProcInfo:visible   in frame waitfram = no.
     1164       B-viewProcInfo:sensitive in frame waitfram = no.
     1165       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1166       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1167       if  (   mWaitFramView
     1168          or  mWaitProcEvent)
     1169          and not mBatchMode
     1170       then
     1171          display
     1172             v-waitfram-action01 skip
     1173             v-waitfram-action02 skip
     1174             v-waitfram-action03 skip
     1175          with frame waitfram .
     1176       if     mWaitFramView
     1177          then do:
     1178             if     mWaitFramInterval ne ?
     1179                and not mBatchMode
     1180             then
     1181                wait-for go of frame waitfram pause mWaitFramInterval.
     1182          end.
     1183          else
     1184             if     mWaitProcEvent
     1185                and not mBatchMode
     1186             then
     1187                process events .
     1188     end.
     1189   end procedure.
     1190      procedure waitfram-show-this:
     1191         define input  parameter iInterval as int64 no-undo.
     1192         define variable vtime as int64 no-undo.
     1193         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1194         mWaitFramInterval = iInterval.
     1195         run waitfram-show (substitute("&1&2 &3&4" ,
     1196                                       mWaitFramTextBeg ,
     1197                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1198                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1199                                       mWaitFramTextEnd
     1200                                      )
     1201                           ).
     1202      end.
     1203      procedure WaitFramRunPause:
     1204         define input  parameter iInterval as dec no-undo.
     1205         define variable vStart  as datetime-tz no-undo.
     1206         define variable vend    as datetime-tz no-undo.
     1207         define variable vint as int64 no-undo.
     1208         define variable vOk as logical no-undo.
     1209         vStart = now.
     1210         vend   = vStart.
     1211         publish "WaitFramPause" (iInterval,output vOk).
     1212         vend   =  now.
     1213         vint = vend - vStart.
     1214         vint = iInterval - vint / 1000.
     1215         if     not mWaitFramStop
     1216            and (   vint > 0
     1217                 or (    not vOk
     1218                     and iInterval eq ?
     1219                     )
     1220                 )
     1221         then
     1222            run waitfram-show-this (iInterval).
     1223         vend   =  now.
     1224         vint = vend - vStart.
     1225         vint = iInterval - vint / 1000.
     1226         if     not mWaitFramStop
     1227            and vint > 0
     1228         then do:
     1229            run gbl/pause.p (vint * 1000).
     1230         end.
     1231         if iInterval ne ?
     1232         then
     1233            publish "WaitFramStop".
     1234         waitfram-check-timeout().
     1235      end.
     1236      procedure WaitFramWaitFor:
     1237         define input  parameter iInterval as dec no-undo.
     1238         assign
     1239            mWaitFramStartProc   = now
     1240            mWaitFramStopUser    = no
     1241            mWaitFramStopTimeOut = no
     1242         .
     1243         block-wait:
     1244         do while not mWaitFramStop:
     1245            run WaitFramRunPause (iInterval).
     1246            if  waitfram-check-timeout()
     1247            then do:
     1248               leave block-wait.
     1249            end.
     1250         end.
     1251         run waitfram-hide.
     1252      end.
     1253   procedure waitfram-join :
     1254     define input  parameter p-line-1  as character no-undo .
     1255     define input  parameter p-line-2  as character no-undo .
     1256     define input  parameter p-line-3  as character no-undo .
     1257     define output parameter p-message as character no-undo .
     1258     do
     1259     on error undo, return error return-value
     1260     :
     1261       assign
     1262         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1263                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1264                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1265       .
     1266     end.
     1267   end procedure.
     1268   function waitfram-join-function returns character
     1269     (input p-line-1 as character
     1270     ,input p-line-2 as character
     1271     ,input p-line-3 as character
     1272     ).
     1273     define variable v-message as character no-undo .
     1274     run waitfram-join in this-procedure
     1275       (input  p-line-1
     1276       ,input  p-line-2
     1277       ,input  p-line-3
     1278       ,output v-message
     1279       ) .
     1280     return v-message .
     1281   end function .
     1282   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
