     4427         v-cli-base-rate = 0
     4428         v-cli-base-rate-ord = 0
     4429         v-unit-cli-ord      = ""
     4430         v-cli-base-rate-rcv = 0
     4431         v-unit-cli-rcv      = ""
     4432         v-unit-cli = ""
     4433         v-vat-pc   = 0
     4434         v-bonus    =  0
     4435       .
     4436       run str/contspc1.w
     4437          ( input Parparentproc,
     4438            input 'ИЗМЕНЕНИЕ':U,
     4439            input 0, // gds-code для выбора v-unit-cli
     4440            input "",
     4441            input "",
     4442            "Список товаров",
     4443            ""   ,
     4444            input-output v-price,
     4445            input-output v-prc,
     4446            input-output v-prc-2,
     4447            input-output v-vat-type,
     4448            input-output v-qnty,
     4449            input-output v-cli-base-rate,
