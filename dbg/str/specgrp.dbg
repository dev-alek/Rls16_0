     4686               ub.contract-specif.vat-type     = v-vat-type
     4687               ub.contract-specif.qnty         = v-qnty
     4688               ub.contract-specif.sum-cli      = v-price * v-qnty
     4689               ub.contract-specif.VAT-pc       = v-vat-pc
