     5349   ON - OF br-list IN FRAME Dlg-grp
     5350   DO:
     5351       if temp_grplib_grp.mark = "«"
     5352       then do:
     5353           run collapse-item in this-procedure ( input temp_grplib_grp.node-code, input yes ) no-error .
     5354           if error-status :error
     5355           then do:
     5356               message
     5357                 vss-workfile vss-revision vss-description
     5358                 skip "Не удалось закрыть подуровни группы."
     5359                 skip return-value
     5360                 skip trim(error-status :get-message(1))
     5361                      trim(error-status :get-message(2))
     5362                      trim(error-status :get-message(3))
     5363                      trim(error-status :get-message(4))
     5364                      trim(error-status :get-message(5))
