     5026   ON CHOOSE OF b-mark IN FRAME Dlg-grp
     5027   DO:
     5028     if not available buf_contract-specif then return no-apply.
     5029     find first temp-conn where temp-conn.ri = recid( buf_contract-specif ) no-error  .
     5030     if available temp-conn then do:
     5031       delete temp-conn .
     5032       assign  mark-num = mark-num - 1 .
     5033     end.
     5034     else do:
     5035       create temp-conn .
     5036       assign
     5037         temp-conn.ri = recid( buf_contract-specif )
     5038         mark-num = mark-num + 1
     5039       .
     5040     end.
     5041     g-log = spec-List:refresh() .
     5042     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then  do:
     5043       g-log = spec-List:select-next-row ().
     5044       apply "value-changed" to spec-List in frame Dlg-grp.
     5045     end.
     5046     if mark-num = 0 then hide mark-num in frame Dlg-grp.
     5047     else              display mark-num with frame Dlg-grp.
     5048     apply "entry" to spec-List .
     5049   END.
     5050   ON VALUE-CHANGED OF b-prc IN FRAME Dlg-grp
     5051   DO:
     5052   define variable vss-include-info38 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5053   do:
     5054     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5055       (input  v-cntxt-db-num
     5056       ,input  v-cntxt-userid
     5057       ,input  0
     5058       ,input  'actn_fin-contract_modernization':U
     5059       ,input  'firm':U
     5060       ,input  p-host-code
     5061       ,input  '':U
     5062       ,input  0
     5063       ,input  0
     5064       ,input  0
     5065       ,input  0
     5066       ,input  true
     5067       ,output g-log
     5068       )  .
     5069   end.
     5070     if not g-log then  return .
     5071     assign b-prc .
     5072     if b-prc then ENABLE FILL-prc b-all WITH FRAME Dlg-grp.
     5073     else  do:
     5074       assign FILL-prc = 0 .
     5075       DISABLE FILL-prc b-all WITH FRAME Dlg-grp.
     5076       if dec(FILL-prc:screen-value) <> FILL-prc then assign is-new1 = yes .
     5077     end.
     5078     display FILL-prc b-all WITH FRAME Dlg-grp.
     5079   END.
