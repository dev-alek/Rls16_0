     2615                 p-ask = true .
     2616                 return .
     2617             end.
     2618             else do:
     2619                 run SpecGr-gds-code-yes (
     2620                    input   p-gds-code
     2621                   ,input   buf_gds-grp.upper-code
     2622                   ,input   p-contract-num
     2623                   ,input   p-host-code
     2624                   ,output  p-ask
     2625                   ).
     2626                 if p-ask <> ? then return .
     2627           end.
     2628         end.
     2629     end.
     2630     else do:
     2631       v-grp-lim = int (buf_gds-grp-obj-attr.attr-value) no-error  .
     2632       if v-grp-lim > 0 then do:
     2633           v-grp-qnty = 0 .
     2634           find first buf1_gds-grp-obj-attr no-lock where
     2635                      buf1_gds-grp-obj-attr.attr-code = 'QntySpecGr':U and
     2636                      buf1_gds-grp-obj-attr.obj-type  = string(p-contract-num) and
     2637                      buf1_gds-grp-obj-attr.obj-code  = p-host-code and
     2638                      buf1_gds-grp-obj-attr.host-code = 0 and
     2639                      buf1_gds-grp-obj-attr.node-code = p-node-code no-error .
     2640           if available buf1_gds-grp-obj-attr then do:
     2641             v-grp-qnty = int(buf1_gds-grp-obj-attr.attr-value) .
     2642           end.
     2643           if v-grp-lim >= v-grp-qnty + 1 then p-ask = true .
     2644           else p-ask = false .
     2645           return .
     2646       end.
     2647     end.
     2648     end.
     2649   end procedure.
     2650   procedure recalc-gds-SpecGr :
     2651   define input  parameter p-action     as character no-undo .
     2652   define input  parameter p-node-code  as integer   no-undo .
     2653   define input  parameter p-contract-num         as integer   no-undo .
     2654   define input  parameter p-host-code     as integer   no-undo .
     2655   define buffer buf_gds-grp for ub.gds-grp  .
     2656   define buffer curr_gds-grp for ub.gds-grp  .
     2657   define buffer buf1_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     2658   define variable kk as character no-undo .
     2659     do
     2660     on error undo, return error return-value
     2661     :
     2662       find first buf1_gds-grp-obj-attr exclusive-lock where
     2663                  buf1_gds-grp-obj-attr.attr-code = 'QntySpecGr':U and
     2664                  buf1_gds-grp-obj-attr.obj-type  = string(p-contract-num) and
     2665                  buf1_gds-grp-obj-attr.obj-code  = p-host-code and
     2666                  buf1_gds-grp-obj-attr.host-code = 0 and
     2667                  buf1_gds-grp-obj-attr.node-code = p-node-code
     2668                  no-error .
     2669       if available buf1_gds-grp-obj-attr then do:
     2670          if p-action = '+' then  do:
     2671             kk = string( int( buf1_gds-grp-obj-attr.attr-value ) + 1 ).
     2672          end.
     2673          else do:
     2674             kk = string( int( buf1_gds-grp-obj-attr.attr-value ) - 1 ).
     2675          end.
     2676          buf1_gds-grp-obj-attr.attr-value = kk .
     2677       end.
     2678       else do:
     2679           if p-action = '+' then  do:
     2680               create buf1_gds-grp-obj-attr .
     2681                 assign
     2682                   buf1_gds-grp-obj-attr.attr-code  = 'QntySpecGr':U
     2683                   buf1_gds-grp-obj-attr.obj-type   = string(p-contract-num)
     2684                   buf1_gds-grp-obj-attr.obj-code   = p-host-code
     2685                   buf1_gds-grp-obj-attr.host-code  = 0
     2686                   buf1_gds-grp-obj-attr.node-code  = p-node-code
     2687                   buf1_gds-grp-obj-attr.attr-value = "1"
     2688                 .
     2689           end.
     2690       end.
     2691      FIND FIRST curr_gds-grp WHERE
     2692                 curr_gds-grp.node-code = p-node-code
     2693           NO-LOCK NO-ERROR.
     2694      if AVAILABLE curr_gds-grp AND curr_gds-grp.upper-code > 0 then do:
     2695         run recalc-gds-SpecGr (p-action ,curr_gds-grp.upper-code,p-contract-num,p-host-code ) .
     2696      end.
     2697     end.
