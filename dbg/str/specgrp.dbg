     4333       ,input  true
     4334       ,output g-log
     4335       )  .
     4336   end.
     4337     if not g-log then  return .
     4338     message "Вы действительно хотите изменить % по всей спецификации ?" view-as alert-box QUESTION BUTTONS YES-NO UPDATE g-log .
     4339     if g-log = no then return no-apply.
     4340     assign FILL-prc .
     4341     do transaction :
     4342       for each  ub.contract-specif exclusive-lock where
     4343                 ub.contract-specif.host-code = p-host-code and
     4344                 ub.contract-specif.contract-num = p-contract-num :
     4345         assign  ub.contract-specif.prc = FILL-prc .
     4346       end.
     4347       assign is-new = yes .
     4348     end.
     4349     run openbr in this-procedure (yes, no, '':u).
     4350   END.
