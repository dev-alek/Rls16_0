     4995                   v-full-search-string     = ""
     4996                   v-full-search-next       = no
     4997                   v-full-search-start-code = 0
     4998               .
     4999           end.
     5000           else do:
     5001               assign
     5002                   v-full-search-start-code = v-new-code
     5003               .
     5004           end.
     5005           assign
     5006               fi-search :screen-value  = right-trim( v-new-name, chr(47) )
     5007               fi-search :cursor-offset = length( v-new-name ) + 1
     5008           .
     5009       end.
     5010       else do:
     5011           message
     5012               v-err-message
     5013               skip(1)
     5014               "Поиск в названиях групп производится по подстроке,"
     5015               skip "введённой в поле названия группы."
