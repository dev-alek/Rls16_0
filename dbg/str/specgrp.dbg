     7117     if v-size-col1 = 0 or v-size-col1 = ? then v-size-col1 = 40.
     7118     buf_contract-specif.gds-name:resizable in browse spec-List   = true .
     7119     buf_contract-specif.gds-name:width     in browse spec-List  = v-size-col1  .
     7120     frame Dlg-grp:TITLE = frame Dlg-grp:TITLE + " " + buf_contract.contract-prn-code .
     7121     buf_contract-specif.artic:read-only in browse spec-List = yes .
     7122       if p-current-obj-code = 0
     7123       then do:
     7124          assign
     7125          v-current-store-type = v-cntxt-obj-type
     7126          v-current-store-code = v-cntxt-obj-code
     7127          v-current-host-code = v-cntxt-host-code-obj
     7128          .
     7129       end.
     7130       else do:
     7131           assign
     7132               v-current-store-type = p-current-obj-type
     7133               v-current-store-code = p-current-obj-code
     7134           .
