     3194   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3195   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     3196   DEFINE VARIABLE vss-include-info25 AS CHARACTER FORMAT "x(65)" NO-UNDO INITIAL "@(#)$Workfile$ $Revision$".
     3197   FUNCTION indicator-life-gds-n RETURNS CHARACTER ( input p-rec as recid ) FORWARD.
     3198   DEFINE VARIABLE v-gl-iProc-Otkl AS DECIMAL NO-UNDO INITIAL 0.
     3199   DEFINE VARIABLE v-gl-lAM-Is-Obj         AS LOGICAL NO-UNDO INITIAL FALSE.
     3200   DEFINE VARIABLE v-gl-iAM-Gds-All        AS INTEGER NO-UNDO INITIAL 0.
     3201   DEFINE VARIABLE v-gl-iAM-Sbl-Gds-All    AS INTEGER NO-UNDO INITIAL 0.
     3202   DEFINE VARIABLE v-gl-iAM-Gds-Vyv        AS INTEGER NO-UNDO INITIAL 0.
     3203   DEFINE VARIABLE v-gl-lAM-Ref-Shablon    AS LOGICAL NO-UNDO INITIAL FALSE.
     3204   DEFINE VARIABLE v-gl-dAM-Proc-Otkl      AS DECIMAL NO-UNDO INITIAL 0.
     3205   DEFINE VARIABLE v-gl-dAM-Proc-Otkl-Ras  AS DECIMAL NO-UNDO INITIAL 0.
     3206   FUNCTION Is-Gds-In-AssMatr RETURN LOGICAL(
     3207      p-Gds-code AS INTEGER,
     3208      p-Asmt-id  AS INTEGER,
     3209      p-Db-num   AS INTEGER):
     3210      DEFINE BUFFER buf_Gds FOR Ub.Assortment-matrix-goods.
     3211      RETURN CAN-FIND(FIRST buf_Gds WHERE
     3212                            buf_Gds.Asmt-id     = p-Asmt-id
     3213                        AND buf_Gds.Db-num      = p-Db-num
     3214                        AND buf_Gds.Gds-code    = p-Gds-code
     3215                        AND buf_Gds.Asmg-status = INTEGER('0':U)
     3216                      NO-LOCK).
     3217   END FUNCTION.
     3218   PROCEDURE Get-Delta-Gds-2-Matrix:
     3219      DEFINE PARAMETER BUFFER buf_AM-1 FOR ub.Assortment-matrix.
     3220      DEFINE PARAMETER BUFFER buf_AM-2 FOR ub.Assortment-matrix.
     3221      DEFINE OUTPUT PARAMETER iDelta AS INTEGER NO-UNDO INITIAL 0.
     3222      DEFINE BUFFER buf_Gds-1 FOR ub.Assortment-matrix-goods.
     3223      DEFINE BUFFER buf_Gds-2 FOR ub.Assortment-matrix-goods.
     3224      FOR EACH buf_Gds-1 WHERE
     3225               buf_Gds-1.Asmt-id = buf_AM-1.Asmt-id
     3226           AND buf_Gds-1.Db-num  = buf_AM-1.Db-num
     3227           AND buf_Gds-1.Asmg-status = INTEGER('0':U)
     3228          NO-LOCK:
     3229          IF NOT CAN-FIND(FIRST buf_Gds-2 WHERE
     3230                                buf_Gds-2.Asmt-id     = buf_AM-2.Asmt-id
     3231                            AND buf_Gds-2.Db-num      = buf_AM-2.Db-num
     3232                            AND buf_Gds-2.Gds-code    = buf_Gds-1.Gds-code
     3233                            AND buf_Gds-2.Asmg-status = INTEGER('0':U)
     3234                            NO-LOCK) THEN DO:
     3235             ASSIGN
     3236                iDelta = iDelta + 1.
     3237          END.
     3238      END.
     3239      RETURN.
     3240   END PROCEDURE.
     3241   PROCEDURE Cntrl-AM-Add-1:
     3242      DEFINE INPUT PARAMETER iDelta  AS INTEGER   NO-UNDO.
     3243      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     3244      IF v-gl-iProc-Otkl = 0      THEN RETURN.
     3245      IF NOT v-gl-lAM-Is-Obj      THEN RETURN.
     3246      IF NOT v-gl-lAM-Ref-Shablon THEN RETURN.
     3247      RUN Calc-Proc-Otkl IN THIS-PROCEDURE(iDelta).
     3248      IF iDelta = 0 THEN DO:
     3249         IF v-gl-dAM-Proc-Otkl >= v-gl-iProc-Otkl THEN DO:
     3250            cError = "В данной матрице процент отклонения товаров от шаблона (=" + STRING(v-gl-dAM-Proc-Otkl) + ")" + chr(10) +
     3251                     " больше допустимого (=" + STRING( v-gl-iProc-Otkl) +  ")." + chr(10) +
     3252                     "Добавление товаров невозможно !".
     3253         END.
     3254      END. ELSE DO:
     3255         IF v-gl-dAM-Proc-Otkl-Ras >= v-gl-iProc-Otkl THEN DO:
     3256            cError = "В данной матрице будущий расчетный процент отклонения товаров от шаблона (=" + STRING(v-gl-dAM-Proc-Otkl-Ras) + ")" + chr(10) +
     3257                     " больше допустимого (=" + STRING( v-gl-iProc-Otkl ) +  ")." + chr(10) +
     3258                     " Добавление товаров невозможно !".
     3259         END.
     3260      END.
     3261      RETURN.
     3262   END PROCEDURE.
     3263   PROCEDURE Get-Gl-Param-Proc-Otkl:
     3264      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
     3265      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
     3266      DEFINE OUTPUT PARAMETER  cError    AS CHARACTER  NO-UNDO INITIAL "".
     3267      DEFINE BUFFER buf_AM   FOR ub.Assortment-Matrix.
     3268      FIND FIRST buf_AM WHERE
     3269                 buf_AM.asmt-id = p-Asmt-id
     3270             AND buf_AM.db-num  = p-Db-num
     3271           NO-LOCK NO-ERROR.
     3272      IF NOT AVAILABLE buf_AM THEN DO:
     3273         cError = PROGRAM-NAME(1) +  ":Не найдена АМ id=" + STRING(p-Asmt-id) + " db-num=" + STRING(p-Db-num).
     3274         RETURN.
     3275      END.
     3276      RUN Get-Gl-Set-Proc-Otkl IN THIS-PROCEDURE(
     3277          buf_AM.obj-type,
     3278          buf_AM.obj-code
     3279          ).
     3280      RUN Get-Gl-Param-AM-All in THIS-PROCEDURE(
     3281          buf_AM.Asmt-id,
     3282          buf_AM.db-num
     3283          ).
     3284      RETURN.
     3285   END PROCEDURE.
     3286   PROCEDURE Get-Gl-Param-AM-All:
     3287      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
     3288      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
     3289      DEFINE VARIABLE lIsAmObj    AS LOGICAL    NO-UNDO INITIAL FALSE.
     3290      DEFINE VARIABLE iSh-Asmt-id AS INTEGER    NO-UNDO INITIAL 0.
     3291      DEFINE VARIABLE iSh-Db-num  AS INTEGER    NO-UNDO INITIAL 0.
     3292      DEFINE VARIABLE cSh-Type    AS CHARACTER  NO-UNDO INITIAL "".
     3293      DEFINE VARIABLE cError      AS CHARACTER  NO-UNDO INITIAL "".
     3294      DEFINE VARIABLE dAmt        AS DECIMAL    EXTENT 2  NO-UNDO INITIAL 0.
     3295      DEFINE VARIABLE cMode       AS CHARACTER  NO-UNDO INITIAL "".
     3296      ASSIGN
     3297         v-gl-iAM-Gds-All     = 0
     3298         v-gl-iAM-Sbl-Gds-All = 0
     3299         v-gl-iAM-Gds-Vyv     = 0
     3300         v-gl-dAM-Proc-Otkl   = 0
     3301         v-gl-lAM-Ref-Shablon = FALSE
     3302         .
     3303      RUN Get-Param-AM IN THIS-PROCEDURE (
     3304          p-Asmt-id,
     3305          p-Db-num,
     3306          OUTPUT lIsAmObj,
     3307          OUTPUT iSh-Asmt-id,
     3308          OUTPUT iSh-Db-num,
     3309          OUTPUT cSh-Type,
     3310          OUTPUT cError
     3311          ).
     3312      IF cError <> "" THEN DO:
     3313         MESSAGE
     3314            PROGRAM-NAME(1) ":" SKIP
     3315            "Такого быть не должно !!!" SKIP
     3316            cError SKIP
     3317            VIEW-AS ALERT-BOX INFO BUTTONS OK.
     3318         RETURN.
     3319      END.
     3320      ASSIGN
     3321         cMode                 = (IF lIsAmObj THEN "IL_GDS":U ELSE "")
     3322         v-gl-lAM-Ref-Shablon  = (IF iSh-Asmt-id = 0 THEN FALSE ELSE TRUE)
     3323         .
     3324      RUN Get-Param-AM-Gds IN THIS-PROCEDURE(
     3325          p-Asmt-Id,
     3326          p-Db-num,
     3327          '0':U,
     3328          cMode,
     3329          OUTPUT dAmt
     3330          ).
     3331      ASSIGN
     3332         v-gl-iAM-Gds-All = dAmt[1]
     3333         v-gl-iAM-Gds-Vyv = (IF lIsAmObj THEN dAmt[2] ELSE 0)
     3334         .
     3335       IF NOT v-gl-lAM-Ref-Shablon THEN DO:
     3336          RETURN.
     3337       END.
     3338      RUN Get-Param-AM-Gds IN THIS-PROCEDURE(
     3339          iSh-Asmt-id,
     3340          iSh-Db-num,
     3341          '0':U,
     3342          "",
     3343          OUTPUT dAmt
     3344          ).
     3345      ASSIGN
     3346         v-gl-iAM-Sbl-Gds-All = dAmt[1].
     3347      RUN Calc-Proc-Otkl IN THIS-PROCEDURE(0).
     3348      RETURN.
     3349   END PROCEDURE.
     3350   PROCEDURE Get-Param-AM-Gds:
     3351      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
     3352      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
     3353      DEFINE INPUT PARAMETER   p-Stat    AS INTEGER    NO-UNDO.
     3354      DEFINE INPUT PARAMETER   p-Mode    AS CHARACTER  NO-UNDO.
     3355      DEFINE OUTPUT PARAMETER  o-dAmt    AS DECIMAL    EXTENT 2 NO-UNDO INITIAL 0.
     3356      DEFINE BUFFER buf_AM-goods FOR ub.Assortment-matrix-goods.
     3357      FOR EACH buf_AM-goods WHERE
     3358               buf_AM-goods.Asmt-id      = p-Asmt-Id
     3359           AND buf_AM-goods.Db-num       = p-Db-num
     3360           AND buf_AM-goods.asmg-status  = p-Stat
     3361          NO-LOCK:
     3362          ASSIGN
     3363             o-dAmt[1] = o-dAmt[1] + 1.
     3364          IF CAN-DO("IL_GDS":U, p-Mode) THEN DO:
     3365             IF Indicator-life-gds-n(recid(buf_AM-goods)) = 'На вывод из ассортимента':U THEN DO:
     3366                ASSIGN
     3367                   o-dAmt[2] = o-dAmt[2] + 1.
     3368             END.
     3369          END.
     3370      END.
     3371      RETURN.
     3372   END PROCEDURE.
     3373   PROCEDURE Get-Param-AM:
     3374      DEFINE INPUT  PARAMETER  p-Asmt-id   AS INTEGER   NO-UNDO.
     3375      DEFINE INPUT  PARAMETER  p-Db-num    AS INTEGER   NO-UNDO.
     3376      DEFINE OUTPUT PARAMETER  lIsObj      AS LOGICAL   NO-UNDO INITIAL FALSE.
     3377      DEFINE OUTPUT PARAMETER  o-Asmt-id   AS INTEGER   NO-UNDO INITIAL 0.
     3378      DEFINE OUTPUT PARAMETER  o-Db-Num    AS INTEGER   NO-UNDO INITIAL 0.
     3379      DEFINE OUTPUT PARAMETER  v-Type      AS CHARACTER NO-UNDO INITIAL "".
     3380      DEFINE OUTPUT PARAMETER  cError      AS CHARACTER NO-UNDO INITIAL "".
     3381      DEFINE VARIABLE v-value AS  CHARACTER NO-UNDO INITIAL "".
     3382      DEFINE BUFFER buf_AM   FOR ub.Assortment-Matrix.
     3383      DEFINE BUFFER buf_AM-2 FOR ub.Assortment-Matrix.
     3384      ASSIGN
     3385         v-gl-lAM-Is-Obj = FALSE.
     3386      FIND FIRST buf_AM WHERE
     3387                 buf_AM.asmt-id = p-Asmt-id
     3388             AND buf_AM.db-num  = p-Db-num
     3389           NO-LOCK NO-ERROR.
     3390      IF NOT AVAILABLE buf_AM THEN DO:
     3391         cError = "Не найдена АМ id=" + STRING(p-Asmt-id) + " db-num=" + STRING(p-Db-num).
     3392         RETURN.
     3393      END.
     3394      IF buf_AM.asmt-type <> 'Объект':U THEN DO:
     3395         RETURN.
     3396      END. ELSE DO:
     3397         ASSIGN
     3398            lIsObj           = TRUE
     3399            v-gl-lAM-Is-Obj  = TRUE
     3400            .
     3401      END.
     3402      run assmatat-value (
     3403          input buf_AM.asmt-id
     3404         ,input buf_AM.db-num
     3405         ,input 'RootShablon':U
     3406         ,output v-value
     3407         ,output v-type
     3408         ) .
     3409      IF v-value = "" OR v-value = ? THEN DO:
     3410         RETURN.
     3411      END.
     3412      ASSIGN
     3413         o-Asmt-id = INTEGER(ENTRY(1, v-value, chr(4)))
     3414         o-Db-num  = INTEGER(ENTRY(2, v-value, chr(4)))
     3415         NO-ERROR.
     3416      IF ERROR-STATUS:ERROR THEN DO:
     3417         cError = PROGRAM-NAME(1) + ":" + ERROR-STATUS:GET-MESSAGE(1).
     3418         RETURN.
     3419      END.
     3420      FIND FIRST buf_AM-2 WHERE
     3421                 buf_AM-2.asmt-id = o-Asmt-id
     3422             AND buf_AM-2.db-num  = o-Db-num
     3423           NO-LOCK NO-ERROR.
     3424      IF NOT AVAILABLE buf_AM-2 THEN DO:
     3425         cError = "Не найден шаблон АМ id=" + STRING(o-Asmt-id) + " db-num=" + STRING(o-Db-num).
     3426         RETURN.
     3427      END.
     3428      RETURN.
     3429   END PROCEDURE.
     3430   PROCEDURE Get-Gl-Set-Proc-Otkl:
     3431      DEFINE INPUT PARAMETER  cObj-type AS CHARACTER NO-UNDO.
     3432      DEFINE INPUT PARAMETER  iObj-code AS INTEGER   NO-UNDO.
     3433      DEFINE VARIABLE v-Character   AS CHARACTER  NO-UNDO .
     3434      DEFINE VARIABLE v-Date        AS DATE       NO-UNDO .
     3435      DEFINE VARIABLE v-Decimal     AS DECIMAL    NO-UNDO .
     3436      DEFINE VARIABLE v-Integer     AS INTEGER    NO-UNDO .
     3437      DEFINE VARIABLE v-Logical     AS LOGICAL    NO-UNDO .
     3438      DEFINE VARIABLE v-Param-Type  AS CHARACTER  NO-UNDO .
     3439      ASSIGN
     3440         v-gl-iProc-Otkl = 0
     3441         .
     3442      EMPTY TEMP-TABLE thbjattr_thbj-attr .
     3443      RUN adm/shattri.p (
     3444              INPUT  "get":U,
     3445              INPUT  cObj-type,
     3446              INPUT  iObj-code,
     3447              INPUT  'Ass-obj':U,
     3448              INPUT  'ass-proc-matr-shabl':U ,
     3449              OUTPUT v-Character,
     3450              OUTPUT v-Date,
     3451              OUTPUT v-Decimal,
     3452              OUTPUT v-Integer,
     3453              OUTPUT v-Logical,
     3454              OUTPUT v-Param-Type,
     3455              INPUT-OUTPUT TABLE thbjattr_thbj-attr
     3456          ) NO-ERROR.
     3457      IF ERROR-STATUS:ERROR THEN DO:
     3458         ASSIGN
     3459            v-Integer  = 0
     3460            v-Decimal  = 0.
     3461      END. ELSE DO:
     3462         ASSIGN
     3463            v-gl-iProc-Otkl = v-Integer
     3464            .
     3465      END.
     3466      RETURN.
     3467   END PROCEDURE.
     3468   PROCEDURE Calc-Proc-Otkl:
     3469      DEFINE INPUT PARAMETER iDeltaGds AS INTEGER NO-UNDO.
     3470      DEFINE VARIABLE iTmp AS INTEGER NO-UNDO INITIAL 0.
     3471      ASSIGN
     3472         v-gl-dAM-Proc-Otkl     = 0
     3473         v-gl-dAM-Proc-Otkl-Ras = 0
     3474         .
     3475      IF NOT v-gl-lAM-Ref-Shablon THEN DO:
     3476         RETURN.
     3477      END.
     3478      IF v-gl-iAM-Sbl-Gds-All = 0 THEN DO:
     3479         ASSIGN
     3480            v-gl-dAM-Proc-Otkl     = 999999
     3481            v-gl-dAM-Proc-Otkl-Ras = 999999
     3482            .
     3483         RETURN.
     3484      END.
     3485      ASSIGN
     3486         iTmp = (v-gl-iAM-Gds-All - v-gl-iAM-Sbl-Gds-All)
     3487         v-gl-dAM-Proc-Otkl     = ROUND(iTmp * 100 / v-gl-iAM-Sbl-Gds-All, 2)
     3488         v-gl-dAM-Proc-Otkl-Ras = ROUND((iTmp + iDeltaGds)  * 100 / v-gl-iAM-Sbl-Gds-All, 2)
     3489         .
     3490      RETURN.
     3491   END PROCEDURE.
     3492   FUNCTION indicator-life-gds-n RETURNS CHARACTER
     3493   ( input p-rec as recid ) :
     3494   define buffer buf_matrix-goods for ub.assortment-matrix-goods .
     3495   define variable v-gdop-min-stock              as decimal   no-undo .
     3496   define variable v-grop-max-stock              as decimal   no-undo .
     3497   define variable v-grop-level-always-presence  as decimal   no-undo .
     3498   define variable v-grop-min-order              as decimal   no-undo .
     3499   define variable v-assort-min                  as LOGICAL   NO-UNDO.
     3500   DEFINE variable v-indicator-life-gds          as CHARACTER NO-UNDO.
     3501   find first buf_matrix-goods no-lock where recid (buf_matrix-goods) = p-rec no-error .
     3502   if error-status :error then return '' .
     3503   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3504   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjpr in g#library
     3505     (input  buf_Matrix-goods.obj-type
     3506     ,input  buf_Matrix-goods.obj-code
     3507     ,input  ?
     3508     ,input  ?
     3509     ,input  ?
     3510     ,input  buf_Matrix-goods.gds-code
     3511     ,output v-assort-min
     3512     ,output v-indicator-life-gds
     3513     ,output v-gdop-min-stock
     3514     ,output v-grop-max-stock
     3515     ,output v-grop-level-always-presence
     3516     ,output v-grop-min-order
     3517     )  .
     3518     return v-indicator-life-gds.
     3519   end function.
