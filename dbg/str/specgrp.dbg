     5502           fi-search :screen-value  = right-trim( v-new-name, chr(47) )
     5503           fi-search :cursor-offset = length( v-new-name ) + 1
     5504       .
     5505   END.
     5506   ON CTRL-S OF fi-search IN FRAME Dlg-grp
     5507   DO:
     5508       define variable v-new-name as character no-undo.
     5509       define variable v-new-code as integer   no-undo.
     5510       if v-full-search-next = no
     5511       then do:
     5512           assign
     5513               v-full-search-string     = fi-search :screen-value
     5514               v-full-search-next       = yes
     5515               v-full-search-start-code = 0
     5516           .
     5517       end.
     5518   if session :set-wait-state( "compiler" ) then.
     5519       run grplib-find-by-substring in this-procedure (
     5520                             input v-full-search-start-code
     5521                           , input v-full-search-string
     5522                           , output v-new-code
     5523                           , output v-new-name
     5524       ) no-error.
     5525       if error-status :error
     5526       then do:
     5527   if session :set-wait-state( "" ) then.
     5528           message return-value.
     5529           undo, return no-apply.
     5530       end.
     5531   if session :set-wait-state( "" ) then.
     5532       if v-new-code = 0
     5533       then do:
     5534           message
     5535               skip "Не найдена строка '" v-full-search-string "' в имени группы."
     5536           view-as alert-box information
     5537           title "Поиск завершен".
     5538           assign
     5539               v-new-name               = fi-search :screen-value
     5540               v-full-search-string     = ""
     5541               v-full-search-next       = no
     5542               v-full-search-start-code = 0
     5543           .
     5544       end.
     5545       else do:
     5546           assign
     5547               v-full-search-start-code = v-new-code
     5548           .
     5549       end.
     5550       assign
     5551           fi-search :screen-value  = right-trim( v-new-name, chr(47) )
     5552           fi-search :cursor-offset = length( v-new-name ) + 1
     5553       .
     5554   END.
     5555   ON LEAVE OF fi-search IN FRAME Dlg-grp
     5556   DO:
     5557       if fi-search :screen-value <> v-full-search-string
     5558       then do:
     5559           assign
     5560               v-full-search-string     = ""
     5561               v-full-search-next       = no
     5562               v-full-search-start-code = 0
     5563           .
     5564       end.
     5565   END.
     5566   ON RETURN OF fi-search IN FRAME Dlg-grp
     5567   DO:
     5568       define variable v-found    as logical      no-undo.
     5569       if fi-search :screen-value = ""
     5570       or fi-search :screen-value = ?
     5571       then do:
     5572           return no-apply.
     5573       end.
     5574       run find-grp-in-browse in this-procedure (
     5575             input fi-search :screen-value
     5576           , output v-found
     5577       ) no-error.
     5578       if error-status :error
     5579       then do:
     5580           message
     5581                    vss-workfile vss-revision vss-description
     5582               skip(1)
     5583               skip "Ошибка поиска группы."
     5584               skip return-value
     5585               skip trim(error-status :get-message(1))
     5586                    trim(error-status :get-message(2))
     5587                    trim(error-status :get-message(3))
     5588           view-as alert-box error.
     5589           undo, return no-apply .
     5590       end.
     5591       if v-found = no
     5592       then do:
     5593           message
     5594             skip "Группа не найдена."
     5595           view-as alert-box information.
     5596       end.
     5597       apply "ENTRY" to b-search in frame Dlg-grp.
     5598       return no-apply.
     5599   END.
