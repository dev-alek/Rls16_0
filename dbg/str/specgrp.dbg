     3877   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3878   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     3879   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     3880   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     3881   ASSIGN
     3882      v-S_CONTRACT                = "Contract":U
     3883      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     3884      v-DELIM_CHR_3               = ","
     3885      .
     3886   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     3887   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     3888   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     3889   FUNCTION Can-Find-Spec RETURN LOGICAL (
     3890      INPUT iHost-Code    AS INTEGER,
     3891      INPUT iContract-Num AS INTEGER,
     3892      INPUT iGds-Code     AS INTEGER ):
     3893      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     3894      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     3895      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     3896      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     3897      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     3898      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     3899          INPUT  iHost-Code,
     3900          INPUT  iContract-Num,
     3901          OUTPUT iTmp-Extent3
     3902          ).
     3903      IF iTmp-Extent3[1] = 2 THEN DO:
     3904         ASSIGN
     3905            iTmp-Host-Code      = iTmp-Extent3[2]
     3906            iTmp-Contract-Num   = iTmp-Extent3[3]
     3907            .
     3908      END. ELSE DO:
     3909         ASSIGN
     3910            iTmp-Host-Code      = iHost-Code
     3911            iTmp-Contract-Num   = iContract-Num
     3912            .
     3913      END.
     3914      IF iGds-Code = ? THEN DO:
     3915         ASSIGN
     3916            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     3917                                  buf_Spec.Host-Code     = iTmp-Host-Code
     3918                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     3919                           ).
     3920      END. ELSE DO:
     3921            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     3922                                  buf_Spec.Host-Code     = iTmp-Host-Code
     3923                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     3924                              AND buf_Spec.Gds-Code      = iGds-Code
     3925                            ).
     3926      END.
     3927      RETURN (lRet).
     3928   END FUNCTION.
     3929   PROCEDURE MS-Contract-EXTENT-3:
     3930      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     3931      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     3932      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     3933      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     3934      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     3935      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     3936      FIND FIRST buf_Cont-2 WHERE
     3937                 buf_Cont-2.Host-Code      = i-Host-Code
     3938             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     3939           NO-LOCK NO-ERROR.
     3940      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     3941         RETURN.
     3942      END.
     3943      FOR FIRST buf_Ext-Classif WHERE
     3944                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     3945           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     3946                                               STRING(i-Contract-code)
     3947           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     3948          NO-LOCK,
     3949          EACH buf_Cont WHERE
     3950               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     3951           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     3952          NO-LOCK:
     3953          ASSIGN
     3954             i-Ret[1] = 1
     3955             i-Ret[2] = buf_Cont.Host-code
     3956             i-Ret[3] = buf_Cont.Contract-code
     3957             .
     3958          LEAVE.
     3959      END.
     3960      IF i-Ret[1] <> 1 THEN DO:
     3961         FOR FIRST buf_Ext-Classif WHERE
     3962                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     3963              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     3964                                                  STRING(i-Contract-code)
     3965              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     3966             NO-LOCK,
     3967             EACH buf_Cont WHERE
     3968                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     3969              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     3970             NO-LOCK:
     3971             ASSIGN
     3972                i-Ret[1] = 2
     3973                i-Ret[2] = buf_Cont.Host-code
     3974                i-Ret[3] = buf_Cont.Contract-code
     3975                .
     3976             LEAVE.
     3977         END.
     3978      END.
     3979      RETURN.
     3980   END PROCEDURE.
     3981   DEFINE VARIABLE v-gl-Character   AS CHARACTER  NO-UNDO .
     3982   DEFINE VARIABLE v-gl-Date        AS DATE       NO-UNDO .
     3983   DEFINE VARIABLE v-gl-Decimal     AS DECIMAL    NO-UNDO .
     3984   DEFINE VARIABLE v-gl-iMcMode     AS INTEGER    NO-UNDO .
     3985   DEFINE VARIABLE v-gl-Logical     AS LOGICAL    NO-UNDO .
     3986   DEFINE VARIABLE v-gl-Param-Type  AS CHARACTER  NO-UNDO .
     3987   DEFINE VARIABLE v-gl-Error       AS CHARACTER  NO-UNDO  INITIAL "".
     3988   DEFINE VARIABLE iTmpHost-code        AS INTEGER INITIAL 0 NO-UNDO.
     3989   DEFINE VARIABLE iTmpContract-code    AS INTEGER INITIAL 0 NO-UNDO.
     3990   DEFINE VARIABLE i-Cont-Ret           AS INTEGER INITIAL 0 NO-UNDO EXTENT 3.
     3991   RUN adm/shattri.p (
     3992         INPUT  "get":U,
     3993         INPUT  "",
     3994         INPUT  0,
     3995         INPUT  "fin-global",
     3996         INPUT  "fo-mc-mode",
     3997         OUTPUT v-gl-Character,
     3998         OUTPUT v-gl-Date,
     3999         OUTPUT v-gl-Decimal,
     4000         OUTPUT v-gl-iMcMode,
     4001         OUTPUT v-gl-Logical,
     4002         OUTPUT v-gl-Param-Type,
     4003         INPUT-OUTPUT TABLE thbjattr_thbj-attr
     4004       ) NO-ERROR.
     4005   IF ERROR-STATUS:ERROR THEN DO:
     4006      ASSIGN
     4007         v-gl-Error = "Ошибка определения глобального параметра fin-global/fo-mc-mode".
     4008      MESSAGE
     4009         v-gl-Error SKIP
     4010         PROGRAM-NAME(1) ERROR-STATUS:GET-MESSAGE(1) RETURN-VALUE
     4011         VIEW-AS ALERT-BOX.
     4012   END.
     4013   IF (v-gl-iMcMode = 1 OR v-gl-iMcMode = 2) AND v-gl-Error = "" THEN DO:
     4014      ASSIGN
     4015         iTmpHost-code      = p-Host-Code
     4016         iTmpContract-code  = p-Contract-Num
     4017         .
     4018      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     4019          INPUT  p-Host-Code,
     4020          INPUT  p-Contract-Num,
     4021          OUTPUT i-Cont-Ret
     4022         ).
     4023      IF i-Cont-Ret[1] = 2 THEN DO:
     4024         ASSIGN
     4025            p-Host-Code       = i-Cont-Ret[2]
     4026            p-Contract-Num   = i-Cont-Ret[3]
     4027            .
     4028      END.
     4029   END.
     4030   define buffer buf_contract for ub.contract .
     4031   find first buf_contract no-lock where
     4032              buf_contract.contract-code  = p-contract-num     and
     4033              buf_contract.host-code   = p-host-code no-error .
     4034   if p-button-list <> "buttons-for-move"
     4035   then do:
