     5699   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5700   procedure minbtn-set :
     5701       do
     5702           on error undo, return error return-value
     5703           :
     5704           define variable ii              as integer       no-undo .
     5705           define variable fh              as widget-handle no-undo .
     5706           define variable hh              as widget-handle no-undo .
     5707           define variable v-h             as handle        extent 4 no-undo .
     5708           define variable v-name-button   as character     no-undo .
     5709           define variable v-help-old-x    as decimal       no-undo .
     5710           define variable v-help-old-y    as decimal       no-undo .
     5711           define variable v-help-old-size as decimal       no-undo .
     5712           define variable v-frame-width   as decimal       no-undo .
     5713           define variable jj              as integer       no-undo .
     5714           do
     5715               on error undo, return error
     5716               :
     5717               assign
     5718                   v-frame-width = frame Dlg-grp:width - 0.3
     5719                   fh            = frame Dlg-grp:first-child
     5720                   hh            = fh:first-child
     5721                   ii            = 1
     5722                   .
     5723               do while valid-handle(hh):
     5724                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     5725                   do:
     5726                       case lc(hh:name) :
     5727                           when "b-help" then
     5728                               do:
     5729                                   hh:load-image-up("cmp/b-help.bmp":u) .
     5730                                   hh:load-image-down("cmp/b-help.bmp":u) .
     5731                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     5732                                   hh:TOOLTIP = "Помощь" .
     5733                                   v-help-old-x = hh:column .
     5734                                   v-help-old-y = hh:row    .
     5735                                   v-help-old-size = hh:width .
     5736                                   hh:width-chars = 2.5 .
     5737                               end.
     5738                           when "b-print" then
     5739                               do:
     5740                                   hh:load-image("cmp/b-print.bmp":u) .
     5741                                   hh:TOOLTIP = "Печать" .
     5742                                   v-h[ii] = hh:handle .
     5743                                   ii = ii + 1 .
     5744                                   hh:width-chars = 3 .
     5745                               end.
     5746                           when "b-history" or
     5747                           when "b-hist" then
     5748                               do:
     5749                                   hh:load-image("cmp/b-hist.bmp":u) .
     5750                                   hh:TOOLTIP = "История" .
     5751                                   v-h[ii] = hh:handle .
     5752                                   ii = ii + 1 .
     5753                                   hh:width-chars = 3 .
     5754                               end.
     5755                           when "b-sch" then
     5756                               do:
     5757                                   hh:load-image("cmp/b-sch.bmp":u) .
     5758                                   hh:TOOLTIP = "Установка Фильтра" .
     5759                                   v-h[ii] = hh:handle .
     5760                                   ii = ii + 1 .
     5761                                   hh:width-chars = 3 .
     5762                               end.
     5763                           when "b-hist-user" then
     5764                               do:
     5765                                   hh:load-image("cmp/b-hist.bmp":u) .
     5766                                   hh:TOOLTIP = "История пользователя" .
     5767                                   ii = ii + 1 .
     5768                               end.
     5769                       end case.
     5770                   end.
     5771                   hh = hh:next-sibling.
     5772               end.
     5773               b-help:column = v-frame-width - b-help:width-chars.
     5774               jj = 0.
     5775               repeat ii = 4 to 1 by -1 :
     5776                   if valid-handle (v-h[ii] ) then
     5777                   do:
     5778                       jj  = jj + 1 .
     5779                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     5780                       v-h[ii]:row    = v-help-old-y .
     5781                   end.
     5782               end.
     5783           end.
     5784       end.
     5785   end procedure.
     5786   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     5787   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     5788   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     5789   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     5790   define variable v-diasize-current-frame-width  as decimal   no-undo .
     5791   define variable v-diasize-current-frame-height as decimal   no-undo .
     5792   define variable v-diasize-change-size          as logical   no-undo .
     5793   define variable v-diasize-resize-button        as handle    no-undo .
     5794   define variable v-diasize-wndmax               as logical   no-undo .
     5795   define variable v-diasize-wndstore             as logical   no-undo .
     5796   define variable v-diasize-proc-name            as character no-undo .
     5797   define variable v-diasize-browse-handle        as handle    no-undo .
     5798   define variable v-diasize-browse-number        as integer   no-undo .
     5799   define variable v-diasize-need-full-display    as logical   no-undo init false .
     5800   define temp-table temp-diasize-handle no-undo
     5801     field handle-value  as handle
     5802     field save-position as decimal
     5803     index xpk is primary unique handle-value
     5804     .
     5805   define temp-table temp-browse-handle no-undo
     5806     field browse-type   as character
     5807     field browse-number as integer
     5808     field browse-handle as handle
     5809     field original-size as decimal
     5810     index xpk is primary unique browse-type browse-number
     5811     index xie browse-type browse-handle
     5812   .
     5813   procedure diasize_change-height :
     5814     define input  parameter p-change-value  as decimal   no-undo .
     5815     define input  parameter p-move-resize   as logical   no-undo .
     5816     define variable v-field-group-handle    as handle    no-undo .
     5817     define variable v-object-handle         as handle    no-undo .
     5818     define variable v-frame-height          as decimal   no-undo .
     5819     define variable v-frame-virtual-height  as decimal   no-undo .
     5820     define variable v-browse-height         as decimal   no-undo .
     5821     define variable v-window-height         as decimal   no-undo .
     5822     define variable v-window-virtual-height as decimal   no-undo .
     5823     define variable v-change-sign           as integer   no-undo .
     5824     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     5825     define buffer buf_temp-browse-handle  for temp-browse-handle .
     5826     if p-change-value > 0
     5827     then do:
     5828       if frame Dlg-grp :height + p-change-value
     5829           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     5830       then do:
     5831         assign
     5832           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     5833                           - (frame Dlg-grp :height-chars)
     5834         .
     5835         if p-change-value <= 0
     5836         then do:
     5837           run diasize_position-resize-button in this-procedure .
     5838           return .
     5839         end.
     5840       end.
     5841     end.
     5842     if p-change-value < 0
     5843     then do:
     5844       if frame Dlg-grp :height + p-change-value < v-diasize-orig-frame-height
     5845       then do:
     5846         assign
     5847           p-change-value = v-diasize-orig-frame-height
     5848                          - (frame Dlg-grp :height-chars)
     5849         .
     5850         if p-change-value >= 0
     5851         then do:
     5852           run diasize_position-resize-button in this-procedure .
     5853           return .
     5854         end.
     5855       end.
     5856     end.
     5857     if p-change-value >= 0
     5858     then do:
     5859       assign
     5860         v-change-sign = 1
     5861       .
     5862     end.
     5863     else do:
     5864       assign
     5865         v-change-sign = -1
     5866       .
     5867     end.
     5868     assign
     5869       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     5870     .
     5871     if p-change-value = 0
     5872     then do:
     5873       run diasize_position-resize-button in this-procedure .
     5874       return .
     5875     end.
     5876     move_block:
     5877     do
     5878     on error undo move_block, retry move_block
     5879     :
     5880       if retry
     5881       then do:
     5882         do
     5883         on error undo move_block, leave move_block
     5884         :
     5885           if p-change-value > 0
     5886           then do:
     5887             for each buf_temp-diasize-handle
     5888             on error undo, next
     5889             :
     5890               assign
     5891                 v-object-handle = buf_temp-diasize-handle.handle-value
     5892               .
     5893               if v-object-handle <> v-diasize-resize-button
     5894               then do:
     5895                 assign
     5896                   v-object-handle :row = buf_temp-diasize-handle.save-position
     5897                 .
     5898               end.
     5899             end.
     5900             assign
     5901               v-diasize-browse-handle :height = v-browse-height
     5902             .
     5903             for each buf_temp-browse-handle
     5904               where buf_temp-browse-handle.browse-type = 'height':u
     5905             on error undo, next
     5906             :
     5907               assign
     5908                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     5909               .
     5910             end.
     5911             assign
     5912               frame Dlg-grp :height = v-frame-height
     5913             .
     5914             if frame Dlg-grp :scrollable = true
     5915             then do:
     5916               assign
     5917                 frame Dlg-grp :virtual-height = v-frame-virtual-height
     5918               .
     5919             end.
     5920             run diasize_position-resize-button in this-procedure .
     5921           end.
     5922           else do:
     5923             if frame Dlg-grp :scrollable = true
     5924             then do:
     5925               assign
     5926                 frame Dlg-grp :virtual-height = v-frame-virtual-height
     5927               .
     5928             end.
     5929             assign
     5930               frame Dlg-grp :height = v-frame-height
     5931             .
     5932             assign
     5933               v-diasize-browse-handle :height = v-browse-height
     5934             .
     5935             for each buf_temp-browse-handle
     5936               where buf_temp-browse-handle.browse-type = 'height':u
     5937             on error undo, next
     5938             :
     5939               assign
     5940                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     5941               .
     5942             end.
     5943             for each buf_temp-diasize-handle
     5944             on error undo, next
     5945             :
     5946               assign
     5947                 v-object-handle = buf_temp-diasize-handle.handle-value
     5948               .
     5949               if v-object-handle <> v-diasize-resize-button
     5950               then do:
     5951                 assign
     5952                   v-object-handle :row = buf_temp-diasize-handle.save-position
     5953                 .
     5954               end.
     5955             end.
     5956             run diasize_position-resize-button in this-procedure .
     5957           end.
     5958           assign
     5959             v-diasize-change-size = false
     5960           .
     5961           leave move_block .
     5962         end.
     5963       end.
     5964       assign
     5965         v-diasize-need-full-display = true
     5966       .
     5967       if v-diasize-change-size = false
     5968       then do:
     5969         assign
     5970           v-diasize-change-size = true
     5971         .
     5972       end.
     5973       else do:
     5974         return .
     5975       end.
     5976       assign
     5977         v-frame-height = frame Dlg-grp :height
     5978         v-frame-virtual-height = frame Dlg-grp :virtual-height
     5979         v-browse-height = v-diasize-browse-handle :height
     5980       .
     5981       for each buf_temp-browse-handle
     5982         where buf_temp-browse-handle.browse-type = 'height':u
     5983       :
     5984         assign
     5985           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     5986         .
     5987       end.
     5988       for each buf_temp-diasize-handle
     5989       :
     5990         delete buf_temp-diasize-handle .
     5991       end.
     5992       assign
     5993         v-field-group-handle = frame Dlg-grp :first-child
     5994       .
     5995       do while valid-handle(v-field-group-handle)
     5996       :
     5997         assign
     5998           v-object-handle = v-field-group-handle :first-child
     5999         .
     6000         do while valid-handle(v-object-handle)
     6001         :
     6002           if  v-object-handle <> v-diasize-browse-handle :handle
     6003           and can-query(v-object-handle, "row")
     6004           and can-query(v-object-handle, "height")
     6005           and ( v-object-handle :row > v-diasize-browse-handle :row )
     6006           then do:
     6007             find first buf_temp-browse-handle
     6008               where buf_temp-browse-handle.browse-type   = 'height':u
     6009                 and buf_temp-browse-handle.browse-handle = v-object-handle
     6010               no-error .
     6011             if available buf_temp-browse-handle
     6012             then do:
     6013             end.
     6014             else do:
     6015               create buf_temp-diasize-handle .
     6016               assign
     6017                 buf_temp-diasize-handle.handle-value  = v-object-handle
     6018                 buf_temp-diasize-handle.save-position = v-object-handle :row
     6019               .
     6020             end.
     6021           end.
     6022           assign
     6023             v-object-handle = v-object-handle :next-sibling
     6024           .
     6025         end.
     6026         assign
     6027           v-field-group-handle = v-field-group-handle :next-sibling
     6028         .
     6029       end.
     6030       do with frame Dlg-grp
     6031       :
     6032         hide v-diasize-resize-button .
     6033         assign
     6034           v-diasize-resize-button :row    = 1
     6035           v-diasize-resize-button :column = 1
     6036         .
     6037       end.
     6038       if p-change-value > 0
     6039       then do:
     6040         if frame Dlg-grp :scrollable = true
     6041         then do:
     6042           assign
     6043             frame Dlg-grp :virtual-height = frame Dlg-grp :virtual-height + p-change-value
     6044             no-error .
     6045           if error-status :error
     6046           or error-status :get-message(1) <> ""
     6047           then do:
     6048             undo move_block, retry move_block .
     6049           end.
     6050         end.
     6051         assign
     6052           frame Dlg-grp :height = frame Dlg-grp :height + p-change-value
     6053           no-error .
     6054         if error-status :error
     6055         or error-status :get-message(1) <> ""
     6056         then do:
     6057           undo move_block, retry move_block .
     6058         end.
     6059         assign
     6060           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     6061           no-error .
     6062         if error-status :error
     6063         or error-status :get-message(1) <> ""
     6064         then do:
     6065           undo move_block, retry move_block .
     6066         end.
     6067         for each buf_temp-browse-handle
     6068           where buf_temp-browse-handle.browse-type = 'height':u
     6069         on error undo move_block, retry move_block
     6070         :
     6071           assign
     6072             buf_temp-browse-handle.browse-handle :height
     6073               = buf_temp-browse-handle.browse-handle :height + p-change-value
     6074             no-error .
     6075           if error-status :error
     6076           or error-status :get-message(1) <> ""
     6077           then do:
     6078             undo move_block, retry move_block .
     6079           end.
     6080         end.
     6081         for each buf_temp-diasize-handle
     6082         on error undo move_block, retry move_block
     6083         :
     6084           assign
     6085             v-object-handle = buf_temp-diasize-handle.handle-value
     6086           .
     6087           if v-object-handle <> v-diasize-resize-button
     6088           then do:
     6089             assign
     6090               v-object-handle :row = v-object-handle :row + p-change-value
     6091               no-error .
     6092             if error-status :error
     6093             or error-status :get-message(1) <> ""
     6094             then do:
     6095               undo move_block, retry move_block .
     6096             end.
     6097           end.
     6098         end.
     6099       end.
     6100       else do:
     6101         for each buf_temp-diasize-handle
     6102         on error undo move_block, retry move_block
     6103         :
     6104           assign
     6105             v-object-handle = buf_temp-diasize-handle.handle-value
     6106           .
     6107           if v-object-handle <> v-diasize-resize-button
     6108           then do:
     6109             assign
     6110               v-object-handle :row = v-object-handle :row + p-change-value
     6111               no-error .
     6112             if error-status :error
     6113             or error-status :get-message(1) <> ""
     6114             then do:
     6115               undo move_block, retry move_block .
     6116             end.
     6117           end.
     6118         end.
     6119         assign
     6120           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     6121           no-error .
     6122         if error-status :error
     6123         or error-status :get-message(1) <> ""
     6124         then do:
     6125           undo move_block, retry move_block .
     6126         end.
     6127         for each buf_temp-browse-handle
     6128           where buf_temp-browse-handle.browse-type = 'height':u
     6129         on error undo move_block, retry move_block
     6130         :
     6131           assign
     6132             buf_temp-browse-handle.browse-handle :height
     6133               = buf_temp-browse-handle.browse-handle :height + p-change-value
     6134             no-error .
     6135           if error-status :error
     6136           or error-status :get-message(1) <> ""
     6137           then do:
     6138             undo move_block, retry move_block .
     6139           end.
     6140         end.
     6141         assign
     6142           frame Dlg-grp :height = frame Dlg-grp :height + p-change-value
     6143           no-error .
     6144         if error-status :error
     6145         or error-status :get-message(1) <> ""
     6146         then do:
     6147           undo move_block, retry move_block .
     6148         end.
     6149         if frame Dlg-grp :scrollable = true
     6150         then do:
     6151           assign
     6152             frame Dlg-grp :virtual-height = frame Dlg-grp :virtual-height + p-change-value
     6153             no-error .
     6154           if error-status :error
     6155           or error-status :get-message(1) <> ""
     6156           then do:
     6157             undo move_block, retry move_block .
     6158           end.
     6159         end.
     6160       end.
     6161       if p-move-resize = true
     6162       then do:
     6163         run diasize_position-resize-button in this-procedure .
     6164       end.
     6165       if v-diasize-wndstore = true
     6166       then do:
     6167         if connected("ub") = true
     6168         then do:
     6169           define variable v-cntxt-db-num        as integer   no-undo .
     6170           define variable v-cntxt-userid        as character no-undo .
     6171           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     6172                                             , OUTPUT v-cntxt-userid
     6173                                             ) .
     6174           run gbl/wndsizew.p
     6175             (input  v-cntxt-db-num
     6176             ,input  v-cntxt-userid
     6177             ,input  v-diasize-proc-name
     6178             ,input  'height':u
     6179             ,input  string(frame Dlg-grp :height - v-diasize-orig-frame-height)
     6180             ) .
     6181         end.
     6182       end.
     6183     end.
     6184     assign
     6185       v-diasize-change-size = false
     6186     .
     6187   end procedure.
     6188   procedure diasize_set-height :
     6189     define input  parameter p-new-height  as decimal   no-undo .
     6190     define input  parameter p-move-resize as logical   no-undo .
     6191     do
     6192     on error undo, return error return-value
     6193     :
     6194       run diasize_change-height in this-procedure
     6195         (input  (p-new-height - frame Dlg-grp :height)
     6196         ,input  p-move-resize
     6197         ) .
     6198     end.
     6199   end procedure.
     6200   procedure diasize_change-width :
     6201     define input  parameter p-change-value as decimal   no-undo .
     6202     define input  parameter p-move-resize  as logical   no-undo .
     6203     define variable v-field-group-handle   as handle    no-undo .
     6204     define variable v-object-handle        as handle    no-undo .
     6205     define variable v-frame-width          as decimal   no-undo .
     6206     define variable v-frame-virtual-width  as decimal   no-undo .
     6207     define variable v-browse-width         as decimal   no-undo .
     6208     define variable v-window-width         as decimal   no-undo .
     6209     define variable v-window-virtual-width as decimal   no-undo .
     6210     define variable v-change-sign          as integer   no-undo .
     6211     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     6212     define buffer buf_temp-browse-handle  for temp-browse-handle .
     6213     if p-change-value > 0
     6214     then do:
     6215       if frame Dlg-grp :width + p-change-value >
     6216           session :width-chars
     6217       then do:
     6218         assign
     6219           p-change-value = session :width-chars - frame Dlg-grp :width
     6220         .
     6221         if p-change-value <= 0
     6222         then do:
     6223           run diasize_position-resize-button in this-procedure .
     6224           return .
     6225         end.
     6226       end.
     6227     end.
     6228     if p-change-value < 0
     6229     then do:
     6230       if frame Dlg-grp :width + p-change-value < v-diasize-orig-frame-width
     6231       then do:
     6232         assign
     6233           p-change-value = v-diasize-orig-frame-width
     6234                          - frame Dlg-grp :width
     6235         .
     6236         if p-change-value >= 0
     6237         then do:
     6238           run diasize_position-resize-button in this-procedure .
     6239           return .
     6240         end.
     6241       end.
     6242     end.
     6243     if p-change-value >= 0
     6244     then do:
     6245       assign
     6246         v-change-sign = 1
     6247       .
     6248     end.
     6249     else do:
     6250       assign
     6251         v-change-sign = -1
     6252       .
     6253     end.
     6254     assign
     6255       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     6256     .
     6257     if p-change-value = 0
     6258     then do:
     6259       run diasize_position-resize-button in this-procedure .
     6260       return .
     6261     end.
     6262     move_block:
     6263     do
     6264     on error undo move_block, leave move_block
     6265     :
     6266       if retry
     6267       then do:
     6268         do
     6269         on error undo move_block, leave move_block
     6270         :
     6271           if p-change-value > 0
     6272           then do:
     6273             for each buf_temp-diasize-handle
     6274             on error undo, next
     6275             :
     6276               assign
     6277                 v-object-handle = buf_temp-diasize-handle.handle-value
     6278               .
     6279               if v-object-handle <> v-diasize-resize-button
     6280               then do:
     6281                 assign
     6282                   v-object-handle :col = buf_temp-diasize-handle.save-position
     6283                 .
     6284               end.
     6285             end.
     6286             assign
     6287               v-diasize-browse-handle :width = v-browse-width
     6288             .
     6289             for each buf_temp-browse-handle
     6290               where buf_temp-browse-handle.browse-type = 'width':u
     6291             on error undo, next
     6292             :
     6293               assign
     6294                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     6295               .
     6296             end.
     6297             assign
     6298               frame Dlg-grp :width = v-frame-width
     6299             .
     6300             if frame Dlg-grp :scrollable = true
     6301             then do:
     6302               assign
     6303                 frame Dlg-grp :virtual-width = v-frame-virtual-width
     6304               .
     6305             end.
     6306             run diasize_position-resize-button in this-procedure .
     6307           end.
     6308           else do:
     6309             if frame Dlg-grp :scrollable = true
     6310             then do:
     6311               assign
     6312                 frame Dlg-grp :virtual-width = v-frame-virtual-width
     6313               .
     6314             end.
     6315             assign
     6316               frame Dlg-grp :width = v-frame-width
     6317             .
     6318             for each buf_temp-browse-handle
     6319               where buf_temp-browse-handle.browse-type = 'width':u
     6320             on error undo, next
     6321             :
     6322               assign
     6323                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     6324               .
     6325             end.
     6326             assign
     6327               v-diasize-browse-handle :width = v-browse-width
     6328             .
     6329             for each buf_temp-diasize-handle
     6330             on error undo, next
     6331             :
     6332               assign
     6333                 v-object-handle = buf_temp-diasize-handle.handle-value
     6334               .
     6335               if v-object-handle <> v-diasize-resize-button
     6336               then do:
     6337                 assign
     6338                   v-object-handle :col = buf_temp-diasize-handle.save-position
     6339                 .
     6340               end.
     6341             end.
     6342             run diasize_position-resize-button in this-procedure .
     6343           end.
     6344           assign
     6345             v-diasize-change-size = false
     6346           .
     6347           leave move_block .
     6348         end.
     6349       end.
     6350       assign
     6351         v-diasize-need-full-display = true
     6352       .
     6353       if v-diasize-change-size = false
     6354       then do:
     6355         assign
     6356           v-diasize-change-size = true
     6357         .
     6358       end.
     6359       else do:
     6360         return .
     6361       end.
     6362       assign
     6363         v-frame-width = frame Dlg-grp :width
     6364         v-frame-virtual-width = frame Dlg-grp :virtual-width
     6365         v-browse-width = v-diasize-browse-handle :width
     6366       .
     6367       for each buf_temp-browse-handle
     6368         where buf_temp-browse-handle.browse-type = 'width':u
     6369       :
     6370         assign
     6371           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     6372         .
     6373       end.
     6374       for each buf_temp-diasize-handle
     6375       :
     6376         delete buf_temp-diasize-handle .
     6377       end.
     6378       assign
     6379         v-field-group-handle = frame Dlg-grp :first-child
     6380       .
     6381       do while valid-handle(v-field-group-handle)
     6382       :
     6383         assign
     6384           v-object-handle = v-field-group-handle :first-child
     6385         .
     6386         do while valid-handle(v-object-handle)
     6387         :
     6388           if  v-object-handle <> v-diasize-browse-handle :handle
     6389           and v-object-handle <> v-diasize-resize-button
     6390           and can-query(v-object-handle, "row")
     6391           and can-query(v-object-handle, "height")
     6392           and ( v-object-handle :col + v-object-handle :width
     6393                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     6394               )
     6395           then do:
     6396             find first buf_temp-browse-handle
     6397               where buf_temp-browse-handle.browse-type   = 'width':u
     6398                 and buf_temp-browse-handle.browse-handle = v-object-handle
     6399               no-error .
     6400             if available buf_temp-browse-handle
     6401             then do:
     6402             end.
     6403             else do:
     6404               create buf_temp-diasize-handle .
     6405               assign
     6406                 buf_temp-diasize-handle.handle-value  = v-object-handle
     6407                 buf_temp-diasize-handle.save-position = v-object-handle :col
     6408               .
     6409             end.
     6410           end.
     6411           assign
     6412             v-object-handle = v-object-handle :next-sibling
     6413           .
     6414         end.
     6415         assign
     6416           v-field-group-handle = v-field-group-handle :next-sibling
     6417         .
     6418       end.
     6419       do with frame Dlg-grp
     6420       :
     6421         hide v-diasize-resize-button .
     6422         v-diasize-resize-button :row = 1.
     6423         v-diasize-resize-button :column = 1.
     6424       end.
     6425       if p-change-value > 0
     6426       then do:
     6427         if frame Dlg-grp :scrollable = true
     6428         then do:
     6429           assign
     6430             frame Dlg-grp :virtual-width = frame Dlg-grp :virtual-width + p-change-value
     6431             no-error .
     6432           if error-status :error
     6433           or error-status :get-message(1) <> ""
     6434           then do:
     6435             undo move_block, retry move_block.
     6436           end.
     6437         end.
     6438         assign
     6439           frame Dlg-grp :width = v-frame-width + p-change-value
     6440           no-error .
     6441         if error-status :error
     6442         or error-status :get-message(1) <> ""
     6443         then do:
     6444           undo move_block, retry move_block.
     6445         end.
     6446         assign
     6447           v-diasize-browse-handle :width = v-browse-width + p-change-value
     6448         no-error .
     6449         if error-status :error
     6450         or error-status :get-message(1) <> ""
     6451         then do:
     6452           undo move_block, retry move_block.
     6453         end.
     6454         for each buf_temp-browse-handle
     6455           where buf_temp-browse-handle.browse-type = 'width':u
     6456         on error undo move_block, retry move_block
     6457         :
     6458           assign
     6459             buf_temp-browse-handle.browse-handle :width
     6460               = buf_temp-browse-handle.browse-handle :width + p-change-value
     6461             no-error .
     6462           if error-status :error
     6463           or error-status :get-message(1) <> ""
     6464           then do:
     6465             undo move_block, retry move_block .
     6466           end.
     6467         end.
     6468         for each buf_temp-diasize-handle
     6469         on error undo move_block, retry move_block
     6470         :
     6471           assign
     6472             v-object-handle = buf_temp-diasize-handle.handle-value
     6473           .
     6474           if v-object-handle <> v-diasize-resize-button
     6475           then do:
     6476             assign
     6477               v-object-handle :col = v-object-handle :col + p-change-value
     6478               no-error .
     6479             if error-status :error
     6480             or error-status :get-message(1) <> ""
     6481             then do:
     6482               undo move_block, retry move_block .
     6483             end.
     6484           end.
     6485         end.
     6486       end.
     6487       else do:
     6488         for each buf_temp-diasize-handle
     6489         on error undo move_block, retry move_block
     6490         :
     6491           assign
     6492             v-object-handle = buf_temp-diasize-handle.handle-value
     6493           .
     6494           if v-object-handle <> v-diasize-resize-button
     6495           then do:
     6496             assign
     6497               v-object-handle :col = v-object-handle :col + p-change-value
     6498               no-error .
     6499             if error-status :error
     6500             or error-status :get-message(1) <> ""
     6501             then do:
     6502               undo move_block, retry move_block .
     6503             end.
     6504           end.
     6505         end.
     6506         for each buf_temp-browse-handle
     6507           where buf_temp-browse-handle.browse-type = 'width':u
     6508         on error undo move_block, retry move_block
     6509         :
     6510           assign
     6511             buf_temp-browse-handle.browse-handle :width
     6512               = buf_temp-browse-handle.browse-handle :width + p-change-value
     6513             no-error .
     6514           if error-status :error
     6515           or error-status :get-message(1) <> ""
     6516           then do:
     6517             undo move_block, retry move_block .
     6518           end.
     6519         end.
     6520         assign
     6521           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     6522           no-error .
     6523         if error-status :error
     6524         or error-status :get-message(1) <> ""
     6525         then do:
     6526           undo move_block, retry move_block.
     6527         end.
     6528         assign
     6529           frame Dlg-grp :width = frame Dlg-grp :width + p-change-value
     6530         no-error .
     6531         if error-status :error
     6532         or error-status :get-message(1) <> ""
     6533         then do:
     6534           undo move_block, retry move_block.
     6535         end.
     6536         if frame Dlg-grp :scrollable = true
     6537         then do:
     6538           assign
     6539             frame Dlg-grp :virtual-width = frame Dlg-grp :virtual-width + p-change-value
     6540           no-error .
     6541           if error-status :error
     6542           or error-status :get-message(1) <> ""
     6543           then do:
     6544             undo move_block, retry move_block.
     6545           end.
     6546         end.
     6547       end.
     6548       if p-move-resize
     6549       then do:
     6550         run diasize_position-resize-button in this-procedure .
     6551       end.
     6552       if v-diasize-wndstore = true
     6553       then do:
     6554         if connected("ub") = true
     6555         then do:
     6556           define variable v-cntxt-db-num        as integer   no-undo .
     6557           define variable v-cntxt-userid        as character no-undo .
     6558           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     6559                                             , OUTPUT v-cntxt-userid
     6560                                             ) .
     6561           run gbl/wndsizew.p
     6562             (input  v-cntxt-db-num
     6563             ,input  v-cntxt-userid
     6564             ,input  v-diasize-proc-name
     6565             ,input  'width':u
     6566             ,input  string(frame Dlg-grp :width - v-diasize-orig-frame-width)
     6567             ) .
     6568         end.
     6569       end.
     6570     end.
     6571     assign
     6572       v-diasize-change-size = false
     6573     .
     6574   end procedure.
     6575   procedure diasize_set-width :
     6576     define input  parameter p-new-width  as decimal   no-undo .
     6577     define input  parameter p-move-resize as logical   no-undo .
     6578     do
     6579     on error undo, return error return-value
     6580     :
     6581       run diasize_change-width in this-procedure
     6582         (input  (p-new-width - frame Dlg-grp :width)
     6583         ,input  p-move-resize
     6584         ) .
     6585     end.
     6586   end procedure.
     6587   procedure diasize_position-resize-button :
     6588     do with frame Dlg-grp
     6589     :
     6590       hide v-diasize-resize-button .
     6591       assign
     6592         v-diasize-resize-button :row = frame Dlg-grp :height - v-diasize-resize-button :height
     6593                     - 1
     6594                     - (frame Dlg-grp :border-bottom-pixels / session :pixels-per-row)
     6595         v-diasize-resize-button :col = frame Dlg-grp :width - v-diasize-resize-button :width
     6596                     - 1
     6597                     - (frame Dlg-grp :border-right-pixels / session :pixels-per-column)
     6598       .
     6599       view v-diasize-resize-button .
     6600     end.
     6601   end procedure.
     6602   on alt-right anywhere
     6603   do:
     6604     run diasize_change-width in this-procedure
     6605       (input 1
     6606       ,input true
     6607       ) .
     6608     return no-apply .
     6609   end.
     6610   on alt-left anywhere
     6611   do:
     6612     run diasize_change-width in this-procedure
     6613       (input -1
     6614       ,input true
     6615       ) .
     6616     return no-apply .
     6617   end.
     6618   on alt-down anywhere
     6619   do:
     6620     run diasize_change-height in this-procedure
     6621       (input 1
     6622       ,input true
     6623       ) .
     6624     return no-apply .
     6625   end.
     6626   on alt-up anywhere
     6627   do:
     6628     run diasize_change-height in this-procedure
     6629       (input -1
     6630       ,input true
     6631       ) .
     6632     return no-apply .
     6633   end.
     6634   on alt-enter of frame Dlg-grp
     6635   do:
     6636     run diasize_maximize in this-procedure
     6637       (input  ?
     6638       ).
     6639     return no-apply .
     6640   end.
     6641   procedure diasize_end-move :
     6642     do
     6643     on error undo, return error return-value
     6644     :
     6645       define variable v-row-delta as decimal   no-undo .
     6646       define variable v-col-delta as decimal   no-undo .
     6647       define variable v-new-row as decimal   no-undo .
     6648       define variable v-new-col as decimal   no-undo .
     6649       assign
     6650         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     6651         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     6652       .
     6653       assign
     6654         v-row-delta = v-new-row - frame Dlg-grp :height
     6655         v-col-delta = v-new-col - frame Dlg-grp :width
     6656       .
     6657       run diasize_change-height in this-procedure
     6658         (input v-row-delta
     6659         ,input true
     6660         ) .
     6661       run diasize_change-width in this-procedure
     6662         (input v-col-delta
     6663         ,input true
     6664         ) .
     6665     end.
     6666   end procedure.
     6667   procedure diasize_maximize :
     6668     define input  parameter p-action as logical   no-undo .
     6669     do
     6670     on error undo, return error return-value
     6671     :
     6672       if p-action = ?
     6673       then do:
     6674         if v-diasize-need-maximize = true
     6675         then do:
     6676           assign
     6677             p-action = true
     6678           .
     6679         end.
     6680         else do:
     6681           assign
     6682             p-action = false
     6683           .
     6684         end.
     6685       end.
     6686       if p-action = true
     6687       then do:
     6688         run diasize_change-height in this-procedure
     6689           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     6690               - frame Dlg-grp :height-chars
     6691           ,input true
     6692           ) .
     6693         run diasize_change-width in this-procedure
     6694           (input session :width-chars
     6695               - frame Dlg-grp :width-chars
     6696           ,input true
     6697           ) .
     6698         assign
     6699           v-diasize-need-maximize = false
     6700         .
     6701       end.
     6702       else do:
     6703         run diasize_change-width in this-procedure
     6704           (input v-diasize-orig-frame-width
     6705               - frame Dlg-grp :width-chars
     6706           ,input true
     6707           ) .
     6708         run diasize_change-height in this-procedure
     6709           (input v-diasize-orig-frame-height
     6710               - frame Dlg-grp :height-chars
     6711           ,input true
     6712           ) .
     6713         assign
     6714           v-diasize-need-maximize = true
     6715         .
     6716       end.
     6717     end.
     6718   end procedure.
     6719   procedure diasize_restore-orig-size :
     6720     do
     6721     on error undo, return error return-value
     6722     :
     6723       assign
     6724         v-diasize-current-frame-width  = frame Dlg-grp :width
     6725         v-diasize-current-frame-height = frame Dlg-grp :height
     6726       .
     6727       run diasize_set-height in this-procedure
     6728         (input  v-diasize-orig-frame-height
     6729         ,input  true
     6730         ) .
     6731       run diasize_set-width in this-procedure
     6732         (input  v-diasize-orig-frame-width
     6733         ,input  true
     6734         ) .
     6735     end.
     6736   end procedure.
     6737   procedure diasize_restore-current-size :
     6738     do
     6739     on error undo, return error return-value
     6740     :
     6741       run diasize_set-height in this-procedure
     6742         (input  v-diasize-current-frame-height
     6743         ,input  true
     6744         ) .
     6745       run diasize_set-width in this-procedure
     6746         (input  v-diasize-current-frame-width
     6747         ,input  true
     6748         ) .
     6749     end.
     6750   end procedure.
     6751   procedure diasize_set-browse-handle :
     6752     define input  parameter p-browse-handle as handle   no-undo .
     6753     define buffer buf_temp-browse-handle for temp-browse-handle .
     6754     do
     6755     on error undo, return error return-value
     6756     :
     6757       assign
     6758         v-diasize-browse-handle = p-browse-handle
     6759       .
     6760       for each buf_temp-browse-handle
     6761       on error undo, return error return-value
     6762       :
     6763         delete buf_temp-browse-handle .
     6764       end.
     6765     end.
     6766   end procedure.
     6767   procedure diasize_add_browse :
     6768     define input  parameter p-browse-type   as character no-undo .
     6769     define input  parameter p-browse-handle as handle    no-undo .
     6770     define buffer buf_temp-browse-handle for temp-browse-handle .
     6771     do
     6772     on error undo, return error return-value
     6773     :
     6774       assign
     6775         v-diasize-browse-number = v-diasize-browse-number + 1
     6776       .
     6777       create buf_temp-browse-handle .
     6778       assign
     6779         buf_temp-browse-handle.browse-type   = p-browse-type
     6780         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     6781         buf_temp-browse-handle.browse-handle = p-browse-handle
     6782       .
     6783     end.
     6784   end procedure.
     6785   procedure diasize_init :
     6786     define variable v-default-value    as logical   no-undo .
     6787     define variable v-restore-saved    as logical   no-undo .
     6788     define variable v-resize-value-str as character no-undo .
     6789     do
     6790     on error undo, return error return-value
     6791     :
     6792       do with frame Dlg-grp
     6793       :
     6794         assign
     6795           v-diasize-orig-frame-height = frame Dlg-grp :height
     6796           v-diasize-orig-frame-width  = frame Dlg-grp :width
     6797           v-diasize-browse-handle     = browse br-list :handle
     6798         .
     6799         create button v-diasize-resize-button
     6800         assign
     6801           parent        = frame Dlg-grp :first-child
     6802           label         = "s"
     6803           height-pixels = 16
     6804           width-pixels  = 16
     6805           visible       = true
     6806           sensitive     = true
     6807           movable       = true
     6808           triggers:
     6809             on end-move persistent run diasize_end-move in this-procedure .
     6810           end triggers.
     6811         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     6812         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     6813         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     6814         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     6815         assign
     6816           v-diasize-wndmax = false
     6817         .
     6818         if connected("ub") = true
     6819         then do:
     6820           define variable v-cntxt-db-num        as integer   no-undo .
     6821           define variable v-cntxt-userid        as character no-undo .
     6822           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     6823                                             , OUTPUT v-cntxt-userid
     6824                                             ) .
     6825           run gbl/wndpar_r.p
     6826             (input  v-cntxt-db-num
     6827             ,input  v-cntxt-userid
     6828             ,input  'wndmax':U
     6829             ,output v-diasize-wndmax
     6830             ,output v-default-value
     6831             ) .
     6832         end.
     6833         assign
     6834           v-diasize-wndstore = false
     6835         .
     6836         if connected("ub") = true
     6837         then do:
     6838           run gbl/wndpar_r.p
     6839             (input  v-cntxt-db-num
     6840             ,input  v-cntxt-userid
     6841             ,input  'wndstore':U
     6842             ,output v-diasize-wndstore
     6843             ,output v-default-value
     6844             ) .
     6845         end.
     6846         assign
     6847           v-diasize-proc-name = entry(1, program-name(2), '.')
     6848         .
     6849         if v-diasize-wndstore = true
     6850         then do:
     6851           assign
     6852             v-restore-saved = false
     6853           .
     6854           if connected("ub") = true
     6855           then do:
     6856             run gbl/wndsizer.p
     6857               (input  v-cntxt-db-num
     6858               ,input  v-cntxt-userid
     6859               ,input  v-diasize-proc-name
     6860               ,input  'height':u
     6861               ,output v-resize-value-str
     6862               ) .
     6863             if v-resize-value-str <> '':U
     6864             then do:
     6865               run diasize_change-height in this-procedure
     6866                 (input  integer(v-resize-value-str)
     6867                 ,input  true
     6868                 ) .
     6869               assign
     6870                 v-restore-saved = true
     6871               .
     6872             end.
     6873           end.
     6874           if connected("ub") = true
     6875           then do:
     6876             run gbl/wndsizer.p
     6877               (input  v-cntxt-db-num
     6878               ,input  v-cntxt-userid
     6879               ,input  v-diasize-proc-name
     6880               ,input  'width':u
     6881               ,output v-resize-value-str
     6882               ) .
     6883             if v-resize-value-str <> '':U
     6884             then do:
     6885               run diasize_change-width in this-procedure
     6886                 (input  integer(v-resize-value-str)
     6887                 ,input  true
     6888                 ) .
     6889               assign
     6890                 v-restore-saved = true
     6891               .
     6892             end.
     6893           end.
     6894           if v-restore-saved <> true
     6895           then do:
     6896             if v-diasize-wndmax = true
     6897             then do:
     6898               run diasize_maximize in this-procedure
     6899                 (input  true
     6900                 ) .
     6901             end.
     6902           end.
     6903         end.
     6904         else do:
     6905           if v-diasize-wndmax = true
     6906           then do:
     6907             run diasize_maximize in this-procedure
     6908               (input  true
     6909               ) .
     6910           end.
     6911         end.
     6912       end.
     6913     end.
     6914   end procedure.
     6915   procedure diasize_need-full-display :
     6916     define output parameter p-need-full-display as logical   no-undo .
     6917     do
     6918     on error undo, return error return-value
     6919     :
     6920       assign
     6921         p-need-full-display = v-diasize-need-full-display
     6922       .
     6923       assign
     6924         v-diasize-need-full-display = false
     6925       .
     6926     end.
     6927   end procedure.
     6928   procedure get-context :
     6929      define output parameter p-db-num as integer          no-undo.
     6930      define output parameter p-user-id as character        no-undo.
     6931      define variable v-login               as character    no-undo.
     6932      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     6933      define buffer buf_user-login  for ub.user-login .
     6934      do
     6935      on error undo, return error
     6936      :
     6937            FIND FIRST buf_sys-ctrl no-lock.
     6938            ASSIGN
     6939               v-login = USERID("ub")
     6940               p-db-num = buf_sys-ctrl.db-num
     6941            .
     6942            FIND FIRST buf_user-login
     6943                 WHERE buf_user-login.db-num = p-db-num
     6944                   AND buf_user-login.user-login = v-login
     6945                 no-lock
     6946                 no-error
     6947                 .
     6948            IF AVAILABLE buf_user-login
     6949            THEN DO:
     6950               assign
     6951                  p-user-id = buf_user-login.user-id
     6952               .
     6953            END.
     6954      end.
     6955   end procedure.
     6956   run diasize_add_browse in this-procedure
     6957     (input  'width':u
     6958     ,input  browse spec-list:handle
     6959     ) .
     6960   run diasize_init in this-procedure .
     6961   on F9 of frame Dlg-grp anywhere do:
     6962     if not available buf_contract-specif then  return no-apply.
     6963     find first ub.goods no-lock where ub.goods.gds-code = buf_contract-specif.gds-code .
     6964     gds-rec = recid(goods) .
     6965     run ref/gds-form.w
     6966       (input  parParentProc
     6967       ,input  'ПРОСМОТР':U
     6968       ,input  v-cntxt-obj-type
     6969       ,input  v-cntxt-obj-code
     6970       ,input  ?
     6971       ,input-output gds-rec
     6972       ).
     6973     apply "entry" to spec-List in frame Dlg-grp.
     6974     return no-apply.
     6975   end.
     6976   def var sort-labelspec-List   as character no-undo .
     6977   def var sort-clmnspec-List    as handle    no-undo .
     6978   def var cur-clmnspec-List     as handle    no-undo .
     6979   def var cur-clmn-locspec-List as integer   no-undo .
     6980   def var re-queryspec-List     as logical   initial no no-undo .
     6981   on start-search, ctrl-o of spec-List in frame Dlg-grp do:
     6982      run sort-brspec-List
     6983        (input (if available buf_contract-specif
     6984                then recid(buf_contract-specif)
     6985                else ?
     6986               )
     6987        ).
     6988   end.
     6989   PROCEDURE sort-brspec-List :
     6990     define input parameter p-recid as recid no-undo .
     6991     if re-queryspec-List = no then do:
     6992       assign
     6993          cur-clmnspec-List = spec-List:current-column in frame Dlg-grp
     6994       .
     6995       if sort-clmnspec-List <> ? then sort-clmnspec-List:column-fgcolor = 0.
     6996       if cur-clmnspec-List = sort-clmnspec-List then do:
     6997         assign
     6998            sort-labelspec-List = ""
     6999            sort-clmnspec-List = ?
     7000         .
     7001        end.
     7002        else do:
     7003          assign
     7004            sort-labelspec-List = cur-clmnspec-List:label
     7005            sort-clmnspec-List  = cur-clmnspec-List
     7006            sort-clmnspec-List:column-fgcolor = 4
     7007          .
     7008        end.
     7009      end.
     7010     assign
     7011       cur-clmn-locspec-List = 1
     7012     .
     7013     def var column-handle as handle no-undo .
     7014     column-handle = spec-List:first-column.
     7015     do while valid-handle(column-handle) :
     7016       if column-handle = cur-clmnspec-List then do:
     7017         leave .
     7018       end.
     7019       column-handle = column-handle:NEXT-COLUMN.
     7020       assign
     7021         cur-clmn-locspec-List = cur-clmn-locspec-List + 1
     7022       .
     7023     end.
     7024     case sort-labelspec-List:
     7025           when 'БарКод'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1get-b-code&1, &2)', chr(34), buf_contract-specif.gds-code)     .     run OpenBr(yes, no, '':U).   . END.
     7026           when 'Артикул'  then DO:    assign       sort-column-name = "buf_contract-specif.artic"     .     run OpenBr(yes, no, '':U).   . END.
     7027           when 'Производитель'  then DO:    assign       sort-column-name = "string (buf_contract-specif.prod-type + ' ' + string(buf_contract-specif.prod-code))"     .     run OpenBr(yes, no, '':U).   . END.
     7028           when 'Наименование'  then DO:    assign       sort-column-name = "buf_contract-specif.gds-name"     .     run OpenBr(yes, no, '':U).   . END.
     7029           when 'Цена поставщика'  then DO:    assign       sort-column-name = "buf_contract-specif.price-cli"     .     run OpenBr(yes, no, '':U).   . END.
     7030           when '% отклон. в большую сторону'  then DO:    assign       sort-column-name = "buf_contract-specif.prc"     .     run OpenBr(yes, no, '':U).   . END.
     7031           when '% отклон. в меньшую сторону'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1f-prc-min&1, recid(buf_contract-specif))', chr(34) )     .     run OpenBr(yes, no, '':U).   . END.
     7032           when 'Код товара'  then DO:    assign       sort-column-name = "buf_contract-specif.gds-code"     .     run OpenBr(yes, no, '':U).   . END.
     7033           when 'Количество'  then DO:    assign       sort-column-name = "buf_contract-specif.qnty"     .     run OpenBr(yes, no, '':U).   . END.
     7034           when 'Е.И.'  then DO:    assign       sort-column-name = "buf_contract-specif.unit-base"     .     run OpenBr(yes, no, '':U).   . END.
     7035           when 'Сумма'  then DO:    assign       sort-column-name = "buf_contract-specif.sum-cli"     .     run OpenBr(yes, no, '':U).   . END.
     7036           when 'НДС'  then DO:    assign       sort-column-name = "buf_contract-specif.vat-pc"     .     run OpenBr(yes, no, '':U).   . END.
     7037           when 'тип НДС'  then DO:    assign       sort-column-name = "buf_contract-specif.vat-type"     .     run OpenBr(yes, no, '':U).   . END.
     7038       otherwise do:
     7039         assign
     7040           sort-column-name = ""
     7041         .
     7042         run OpenBr(yes, no, '':U).
     7043           if can-do( this-procedure:internal-entries, 'mv-brw-defaultspec-List') then do:
     7044             run mv-brw-defaultspec-List.
     7045           end.
     7046         if sort-labelspec-List <> "" then do:
     7047           assign
     7048             cur-clmnspec-List:column-fgcolor = 0
     7049           .
     7050         end.
     7051         assign
     7052           cur-clmn-locspec-List = ?
     7053         .
     7054       end.
     7055     end case.
     7056       if cur-clmn-locspec-List <> ? then do:
     7057         if can-do( this-procedure:internal-entries, 'ch-clmnspec-List') then do:
     7058           run ch-clmnspec-List in this-procedure (cur-clmn-locspec-List).
     7059         end.
     7060       end.
     7061     if p-recid <> ? then do:
     7062       reposition spec-List to recid p-recid no-error.
     7063       apply "value-changed" to spec-List in frame Dlg-grp.
     7064     end.
     7065     apply "entry" to spec-List in frame Dlg-grp.
     7066   END PROCEDURE.
     7067   procedure re-open-query-srt-clmnspec-List:
     7068   if cur-clmnspec-List = ? then do:
     7069      run OpenBr(yes, no, '':U).
     7070   end.
     7071   else do:
     7072      assign re-queryspec-List = yes.
     7073      run sort-brspec-List
     7074        (input (if available buf_contract-specif
     7075                then recid(buf_contract-specif)
     7076                else ?
     7077               )
     7078        ).
     7079      assign re-queryspec-List = no.
     7080   end.
     7081   end.
