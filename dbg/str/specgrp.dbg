    10450   FUNCTION f-prc-min RETURNS DECIMAL
    10451     ( input par-recid as recid ) :
    10452     define buffer buf_contract-specif for ub.contract-specif  .
    10453     define variable v-prc-min as decimal   no-undo .
    10454     find first buf_contract-specif no-lock where
    10455              recid(buf_contract-specif) = par-recid no-error .
    10456     if error-status :error then return 0.0 .
    10457     v-prc-min = 0.0 .
    10458     run read-prc-min in this-procedure
    10459     ( buf_contract-specif.contract-num,
    10460       buf_contract-specif.host-code ,
    10461       buf_contract-specif.gds-code ,
    10462       output v-prc-min
    10463     ) no-error .
    10464     return v-prc-min .
    10465   END FUNCTION.
