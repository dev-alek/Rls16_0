     2984   procedure correct-message :
     2985   define input  parameter p-longchar as longchar no-undo .
     2986   define variable v-longchar as longchar no-undo .
     2987   define variable v-err-ext  as logical  no-undo .
     2988     do
     2989     on error undo, return error return-value
     2990     :
     2991      run get-long-message in this-procedure  (output v-longchar ).
     2992       v-longchar = v-longchar + p-longchar.
     2993       v-err-ext  = true .
     2994       run set-long-message  in this-procedure  (input v-longchar,  input v-err-ext ).
     2995     end.
     2996   end procedure.
