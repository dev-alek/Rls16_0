     5487       then do:
     5488           message return-value.
     5489           undo, return no-apply.
     5490       end.
     5491       if v-new-name = ""
     5492       then do:
     5493           message
     5494               "Не найдена группа с полным именем, начинающимся на"
     5495               skip "'" + fi-search :screen-value + "'"
     5496           view-as alert-box information.
     5497           assign
     5498               v-new-name = fi-search :screen-value
     5499           .
     5500       end.
