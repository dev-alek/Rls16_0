     7169       RUN OpenBr(yes, no, '':U).
     7170   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7171   DEF VAR cur-clmn-numspec-List as INT EXTENT 13 no-undo.
     7172   DEF VAR varmvispec-List       as INT no-undo.
     7173   DEF VAR varmvjspec-List       as INT no-undo.
     7174   DEF VAR varmvkspec-List       as INT no-undo.
     7175   DEF VAR varmvlspec-List       as INT no-undo.
     7176   DEF VAR move-elementspec-List as INT no-undo.
     7177   def var jjspec-List           as int no-undo.
     7178   do varmvispec-List = 1 to EXTENT(cur-clmn-numspec-List):
     7179     ASSIGN cur-clmn-numspec-List[varmvispec-List] = varmvispec-List.
     7180   END.
     7181   RUN start-mv-clmnspec-List.
     7182   PROCEDURE start-mv-clmnspec-List:
     7183   def var old-session as logical no-undo.
     7184      old-session = SESSION:IMMEDIATE-DISPLAY.
     7185      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     7186      SESSION:IMMEDIATE-DISPLAY = old-session.
     7187   END.
     7188   ON ctrl-cursor-right OF BROWSE spec-List do:
     7189     RUN re-move-clmnspec-List ( 2, 13).
     7190   END.
     7191   ON ctrl-cursor-left OF BROWSE spec-List do:
     7192     RUN re-move-clmnspec-List (13, 2).
     7193   END.
     7194   PROCEDURE re-move-clmnspec-List:
     7195     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     7196     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     7197     DO varmvispec-List = 1 TO EXTENT(cur-clmn-numspec-List):
     7198       if cur-clmn-numspec-List[varmvispec-List] = source-column THEN cur-clmn-numspec-List[varmvispec-List] = -1.
     7199     END.
     7200     if spec-List:MOVE-COLUMN(source-column, target-column) IN FRAME Dlg-grp then.
     7201     if source-column > target-column THEN
     7202     DO varmvjspec-List = source-column - 1 to target-column BY -1:
     7203       DO varmvispec-List = 1 TO EXTENT(cur-clmn-numspec-List):
     7204           if cur-clmn-numspec-List[varmvispec-List] = varmvjspec-List THEN DO:
     7205             cur-clmn-numspec-List[varmvispec-List] = cur-clmn-numspec-List[varmvispec-List] + 1.
     7206           END.
     7207       END.
     7208     END.
     7209     ELSE
     7210     DO varmvjspec-List = source-column + 1 to target-column:
     7211       DO varmvispec-List = 1 TO EXTENT(cur-clmn-numspec-List):
     7212         if cur-clmn-numspec-List[varmvispec-List] = varmvjspec-List THEN DO:
     7213           cur-clmn-numspec-List[varmvispec-List] = cur-clmn-numspec-List[varmvispec-List] - 1.
     7214         END.
     7215       END.
     7216     END.
     7217     DO varmvispec-List = 1 TO EXTENT(cur-clmn-numspec-List):
     7218       if cur-clmn-numspec-List[varmvispec-List] = -1 THEN cur-clmn-numspec-List[varmvispec-List] = target-column.
     7219     END.
     7220   END PROCEDURE.
     7221   PROCEDURE ch-clmnspec-List:
     7222     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     7223     if cur-clmn-loc <= 2 then do:
     7224       return .
     7225     end.
     7226     DO varmvispec-List = 1 TO EXTENT(cur-clmn-numspec-List):
     7227       if cur-clmn-numspec-List[varmvispec-List] = cur-clmn-loc THEN move-elementspec-List = varmvispec-List.
     7228     END.
     7229     RUN re-move-clmnspec-List (cur-clmn-loc, 2).
     7230   END PROCEDURE.
     7231   PROCEDURE mv-brw-defaultspec-List:
     7232   def var old-session as logical no-undo.
     7233     old-session = SESSION:IMMEDIATE-DISPLAY.
     7234     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     7235     do varmvlspec-List = 2 to EXTENT(cur-clmn-numspec-List):
     7236       RUN re-move-clmnspec-List (cur-clmn-numspec-List[varmvlspec-List], varmvlspec-List).
     7237     END.
     7238     RUN start-mv-clmnspec-List.
     7239     SESSION:IMMEDIATE-DISPLAY = old-session.
     7240   END PROCEDURE.
     7241   .
     7242     if v-cntxt-db-num = 0 and b-prc:SENSITIVE then  apply "VALUE-CHANGED" to b-prc IN FRAME Dlg-grp  .
     7243     if v-cntxt-db-num = 0 and b-prc-2:SENSITIVE then  apply "VALUE-CHANGED" to b-prc-2 IN FRAME Dlg-grp .
     7244     WAIT-FOR GO OF FRAME Dlg-grp.
     7245   END.
     7246   RUN disable_UI.
     7247   PROCEDURE add-assmatr :
     7248   define input  parameter p-gds-code as integer   no-undo .
     7249   define input  parameter p-rid-list as character no-undo .
     7250   DEFINE VARIABLE cError as CHARACTER NO-UNDO INITIAL "".
     7251   if v-cntxt-db-num <> 0 then do :
     7252      if not can-find ( first ub.assortment-matrix no-lock where  ub.assortment-matrix.asmt-status = integer ('0':U) and
     7253                                                               ub.assortment-matrix.db-num = v-cntxt-db-num )  then return .
     7254   end.
     7255   else do:
     7256      if not can-find ( first ub.assortment-matrix no-lock where  ub.assortment-matrix.asmt-status = integer ('0':U))  then return .
     7257   end.
     7258   define variable v-kol as integer   no-undo .
     7259   v-kol = num-entries (p-rid-list).
     7260   if v-kol = 0  then do:
     7261      return .
     7262   end.
     7263   define variable v-i as integer   no-undo .
     7264   define buffer buf_assortment-matrix for ub.assortment-matrix.
     7265   define variable p-doc-rec  as recid no-undo .
     7266   v-err-ext  = false .
     7267   v-longchar = "".
     7268   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clear-longmess in g#lib-Matrix
     7269      .
     7270   repeat v-i = 1 to v-kol :
     7271     find first  buf_assortment-matrix no-lock where recid(buf_assortment-matrix) = integer (entry(v-i,p-rid-list )) no-error .
     7272     if available buf_assortment-matrix then do:
     7273     if buf_assortment-matrix.asmt-status <> integer ('0':U)   then do: message substitute("АМ &1 - удалена , в нее добавлять товар нельзя !" ,  buf_assortment-matrix.asmt-name , buf_assortment-matrix.db-num-obj ) view-as alert-box information . next. end.
     7274     if v-cntxt-db-num <> 0 and
     7275        (( buf_assortment-matrix.asmt-type = 'Объект':U     and buf_assortment-matrix.db-num-obj         <> v-cntxt-db-num ) or
     7276         ( buf_assortment-matrix.asmt-type = 'Шаблон':U and buf_assortment-matrix.asmt-db-num-create <> v-cntxt-db-num ))
     7277         then do:
     7278            v-err-ext  = true .
     7279            v-longchar = v-longchar +  substitute("АМ &1 чужой БД &2 , в нее добавлять товар нельзя ! &3" ,  buf_assortment-matrix.asmt-name , buf_assortment-matrix.db-num-obj , chr(10)).
     7280            next.
     7281         end.
     7282         IF NOT Is-Gds-In-AssMatr(p-gds-code,
     7283                                  buf_assortment-matrix.asmt-id,
     7284                                  buf_assortment-matrix.db-num) THEN DO:
     7285            RUN Get-Gl-Param-Proc-Otkl in THIS-PROCEDURE(
     7286                buf_assortment-matrix.asmt-id,
     7287                buf_assortment-matrix.db-num,
     7288                OUTPUT cError
     7289                ).
     7290            if cError <> "" THEN DO:
     7291                v-err-ext = true .
     7292                v-longchar = v-longchar +
     7293                             PROGRAM-NAME(1) + ":" + cError +
     7294                             substitute("&1 &2 &3 " ,  buf_assortment-matrix.asmt-name , buf_assortment-matrix.db-num-obj, chr(10))
     7295                             .
     7296                NEXT.
     7297            END.
     7298            RUN Cntrl-AM-Add-1 IN THIS-PROCEDURE(
     7299               1,
     7300               OUTPUT cError
     7301               ).
     7302            if cError <> "" THEN DO:
     7303                v-err-ext = true .
     7304                v-longchar = v-longchar +
     7305                             PROGRAM-NAME(1) + ":" + cError +
     7306                             substitute("&1 &2 &3 " ,  buf_assortment-matrix.asmt-name , buf_assortment-matrix.db-num-obj, chr(10))
     7307                             .
     7308                NEXT.
     7309            END.
     7310         END.
     7311   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat1 in g#lib-Matrix
     7312    (input this-procedure
     7313    ,input-output p-doc-rec
     7314    ,input 'ДОБАВЛЕНИЕ':U
     7315    ,input buf_assortment-matrix.asmt-id
     7316    ,input buf_assortment-matrix.db-num
     7317    ,input p-gds-code
     7318    ,input ''
     7319     ) no-error .
     7320         if error-status :error then do:
     7321              v-err-ext = true .
     7322              v-longchar = v-longchar + return-value + chr(10) .
     7323         end.
     7324     end.
     7325   end.
     7326   if v-err-ext = true  then do:
     7327   define variable v-ok as logical   no-undo .
     7328     run gbl/d-longchar.w (
     7329           ?,
     7330           'Editor_row=2\':u
     7331         + 'title=При корректировке в Ассортиментные матрицы\':u
     7332         + 'Editor_col=1\':u
     7333         + 'Editor_width=96\':u
     7334         + 'Editor_height=21\':u
     7335         + 'readonly=yes\':u
     7336       ,input-output v-longchar
     7337       ,output v-ok ) no-error .
     7338           v-longchar = "" .
     7339   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clear-longmess in g#lib-Matrix
     7340      .
     7341   end.
     7342   END PROCEDURE.
     7343   PROCEDURE add-grp :
     7344   do
     7345   on error undo, return error
     7346   :
     7347   define input parameter p-node-code  as integer      no-undo.
     7348       define variable v-gds-grp-recid     as recid    no-undo.
     7349       define variable v-focused-row       as integer  no-undo.
     7350       define variable v-repositioned-row  as integer  no-undo.
     7351       define variable v-have-goods        as logical  no-undo.
     7352       define variable v-have-rights       as logical       no-undo.
     7353       define buffer buf_gds-grp           for ub.gds-grp.
     7354       define buffer buf_temp_grplib_grp   for temp_grplib_grp.
     7355       run check-rights-for-change-grp in this-procedure (
     7356           input p-node-code
     7357           ,output v-have-rights
     7358       ) no-error.
     7359       if error-status :error
     7360       or v-have-rights = no
     7361       then do:
     7362           message
     7363             vss-workfile vss-revision vss-description
     7364             skip "Нет прав на изменение справочника групп товаров."
     7365             skip "Удаление группы невозможно."
     7366             skip return-value
     7367             skip trim(error-status :get-message(1))
     7368                  trim(error-status :get-message(2))
     7369                  trim(error-status :get-message(3))
     7370           view-as alert-box error.
     7371           undo, return error .
     7372       end.
     7373       assign
     7374           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     7375           v-repositioned-row = current-result-row( "br-list" )
     7376       .
     7377       run grplib-have-goods in this-procedure (
     7378             input p-node-code
     7379           , output v-have-goods
     7380       ) no-error .
     7381       if error-status :error
     7382       then do:
     7383           undo, return error "add-grp: Ошибка определения наличия товаров в группе." + chr(10) + return-value.
     7384       end.
     7385       if v-have-goods = yes
     7386       then do:
     7387           message "В данной группе есть товары. Добавить в нее подгруппу,"
     7388                   "включающую эти товары ?"
     7389           view-as alert-box question
     7390           buttons OK-Cancel
     7391           update v-yesno as logical.
     7392           if v-yesno = no
     7393           then do:
     7394               apply "entry" to br-list in frame Dlg-grp.
     7395               return no-apply.
     7396           end.
     7397       end.
     7398       find first buf_temp_grplib_grp
     7399            where buf_temp_grplib_grp.node-code = p-node-code
     7400       no-error .
     7401       if not available buf_temp_grplib_grp
     7402       then do:
     7403           undo, return error "add-grp: Не найдена группа в browse.".
     7404       end.
     7405       if buf_temp_grplib_grp.mark = "»"
     7406       then do:
     7407           run expand-item in this-procedure ( input p-node-code, input no ) no-error.
     7408           if error-status :error
     7409           then do:
     7410               undo, return error "add-grp: Не удается раскрыть группу.".
     7411           end.
     7412       end.
     7413       run ref/g-grp-f.w (
     7414             input parparentproc
     7415           , input v-current-store-type
     7416           , input v-current-store-code
     7417           , input 'ДОБАВЛЕНИЕ':U
     7418           , input p-node-code
     7419           , input-output v-gds-grp-recid
     7420       ) no-error .
     7421       if v-gds-grp-recid = ?
     7422       then do:
     7423           apply "entry" to br-list in frame Dlg-grp.
     7424           return no-apply.
     7425       end.
     7426       find first buf_gds-grp
     7427            where recid ( buf_gds-grp ) =  v-gds-grp-recid
     7428       no-error.
     7429       if not available buf_gds-grp
     7430       then do:
     7431           undo, return error "add-grp: Ошибка добавления группы.".
     7432       end.
     7433       run create-new-line in this-procedure (
     7434             input buf_gds-grp.node-code
     7435           , input buf_gds-grp.upper-code
     7436           , input buf_temp_grplib_grp.level + 1
     7437           , input buf_gds-grp.is-term
     7438           , input buf_gds-grp.node-name
     7439           , input buf_gds-grp.increase-pc
     7440           , input buf_gds-grp.calc-method
     7441           , input buf_temp_grplib_grp.full-name
     7442           , input buf_temp_grplib_grp.sort-name
     7443       ) no-error .
     7444       if error-status :error
     7445       then do:
     7446           undo, return error "add-grp: Ошибка добавления строки в список групп.".
     7447       end.
     7448       if buf_temp_grplib_grp.level > 0
     7449       then do:
     7450           assign
     7451               buf_temp_grplib_grp.mark = "«"
     7452               buf_temp_grplib_grp.name = substring( buf_temp_grplib_grp.name, 1, buf_temp_grplib_grp.level * 4 )
     7453                                   + "«"
     7454                                   + substring( buf_temp_grplib_grp.name, buf_temp_grplib_grp.level * 4 + 2 )
     7455           .
     7456       end.
     7457       OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.
     7458       br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     7459       reposition br-list to row v-repositioned-row.
     7460       RUN OpenBr(yes, no, '':U).
     7461   end.
     7462   END PROCEDURE.
     7463   PROCEDURE bind-to-scales :
     7464   do
     7465   on error undo, return error
     7466   :
     7467   define input parameter p-node-code as integer      no-undo.
     7468       define variable v-is-terminal   as logical           no-undo.
     7469       run grplib-is-terminal (  input p-node-code
     7470                               , output v-is-terminal
     7471       ) no-error .
     7472       if error-status :error
     7473       then do:
     7474           message
     7475           vss-workfile vss-revision vss-description
     7476           skip "Ошибка при определении типа группы (терм/корн)"
     7477           skip return-value
     7478           skip trim(error-status :get-message(1))
     7479               trim(error-status :get-message(2))
     7480               trim(error-status :get-message(3))
     7481               trim(error-status :get-message(4))
     7482               trim(error-status :get-message(5))
     7483           view-as alert-box error.
     7484           undo, return error .
     7485       end.
     7486       if v-is-terminal = no
     7487       then do:
     7488           message
     7489               "Требуется выбрать самую подробную группу товаров,"
     7490               skip "в которой НЕТ других групп."
     7491           view-as alert-box information .
     7492           apply "entry" to br-list in frame Dlg-grp.
     7493           return no-apply.
     7494       end.
     7495       run ref/scal-grp.w (
     7496             input parparentproc
     7497           , input 'b-add'
     7498           , input v-current-store-type
     7499           , input v-current-store-code
     7500           , input ('db':U + chr(44) + 'gds-grp':U)
     7501           , input g#db-num
     7502           , input 0
     7503           , input p-node-code
     7504       ) no-error .
     7505       if error-status :error
     7506       then do:
     7507           undo, return error return-value.
     7508       end.
     7509   end.
     7510   END PROCEDURE.
     7511   PROCEDURE calc-down-lim :
     7512   define input  parameter p-node-code as integer   no-undo .
     7513   define output parameter kk  as integer   no-undo .
     7514   define variable  kk2 as integer   no-undo .
     7515   define buffer d_temp_grplib_grp for temp_cons  .
     7516   define buffer curr_temp_grplib_grp for temp_cons  .
     7517   define variable v-is-terminal as logical   no-undo .
     7518     do
     7519     on error undo, return error return-value
     7520     :
     7521       find first curr_temp_grplib_grp where curr_temp_grplib_grp.node-code =  p-node-code no-error .
     7522       kk = 0 .
     7523       for each d_temp_grplib_grp where
     7524                d_temp_grplib_grp.upper-code = p-node-code :
     7525              if not ( d_temp_grplib_grp.cli-type =  ?  or  trim(d_temp_grplib_grp.cli-type) = "" )
     7526              then do:
     7527                     kk = kk +  int(d_temp_grplib_grp.cli-type).
     7528              end.
     7529              else do:
     7530                 run grplib-is-terminal in this-procedure (
     7531                     input d_temp_grplib_grp.node-code
     7532                   , output v-is-terminal ) .
     7533                   if v-is-terminal = true then kk = ? .
     7534                   else do:
     7535                      run calc-down-lim (input d_temp_grplib_grp.node-code , output kk2) .
     7536                      kk = kk + kk2.
     7537                   end.
     7538              end.
     7539       end.
     7540     end.
     7541   END PROCEDURE.
     7542   PROCEDURE check-rights-for-change-grp :
     7543   do
     7544   on error undo, return error
     7545   :
     7546   define input  parameter p-node-code     as integer      no-undo.
     7547   define output parameter p-have-rights   as logical      no-undo.
     7548       define variable v-enable-change-grp as logical       no-undo.
     7549       if g#db-num <> 0
     7550       then do:
     7551           message
     7552             vss-workfile vss-revision vss-description
     7553             skip "Операция определена только в ГБД."
     7554             skip return-value
     7555             skip trim(error-status :get-message(1))
     7556                  trim(error-status :get-message(2))
     7557                  trim(error-status :get-message(3))
     7558           view-as alert-box error.
     7559           assign
     7560               p-have-rights = no
     7561           .
     7562       end.
     7563       else do:
     7564   define variable vss-include-info49 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7565   do:
     7566     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     7567       (input  v-cntxt-db-num
     7568       ,input  v-cntxt-userid
     7569       ,input  0
     7570       ,input  'actn_reference_groups-edit':U
     7571       ,input  'firm':U
     7572       ,input  v-cntxt-host-code-obj
     7573       ,input  '':U
     7574       ,input  0
     7575       ,input  0
     7576       ,input  p-node-code
     7577       ,input  0
     7578       ,input  no
     7579       ,output p-have-rights
     7580       )  .
     7581   end.
     7582       end.
     7583   end.
     7584   END PROCEDURE.
     7585   PROCEDURE collapse-all-on-first-level :
     7586   do
     7587   on error undo, return error
     7588   :
     7589       define buffer buf_gds-grp       for ub.gds-grp.
     7590       define buffer buf_temp_grplib_grp       for temp_grplib_grp.
     7591       for each buf_temp_grplib_grp no-lock
     7592          where buf_temp_grplib_grp.upper-code = v-root-code
     7593       :
     7594           run collapse-item in this-procedure (
     7595                 input buf_temp_grplib_grp.node-code
     7596               , input no
     7597           ) no-error .
     7598           if error-status :error
     7599           then do:
     7600               undo, return error "Не удалось закрыть подуровни группы "
     7601                                   + chr(10) + "'" + buf_temp_grplib_grp.full-name + "'"
     7602                                   + chr(10) + return-value.
     7603           end.
     7604       end.
     7605       OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.
     7606   end.
     7607   END PROCEDURE.
     7608   PROCEDURE collapse-item :
     7609   do
     7610   on error undo, return error
     7611   :
     7612   define input parameter p-node-code as integer      no-undo.
     7613   define input parameter p-refresh    as logical      no-undo.
     7614       define variable v-focused-row       as integer              no-undo.
     7615       define variable v-repositioned-row  as integer              no-undo.
     7616       define buffer buf_del_temp_grplib_grp   for temp_grplib_grp.
     7617       define buffer buf_temp_grplib_grp       for temp_grplib_grp.
     7618       find first buf_temp_grplib_grp
     7619            where buf_temp_grplib_grp.node-code = p-node-code
     7620       no-error.
     7621       if error-status :error
     7622       then do:
     7623           undo, return error "collapse-item: Неверно передан код группы. Нет группы с кодом " + string( p-node-code ).
     7624       end.
     7625       assign
     7626           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     7627           v-repositioned-row = current-result-row( "br-list" )
     7628       .
     7629       for each buf_del_temp_grplib_grp
     7630          where buf_del_temp_grplib_grp.full-name begins buf_temp_grplib_grp.full-name
     7631            and buf_del_temp_grplib_grp.full-name <> buf_temp_grplib_grp.full-name
     7632            and buf_del_temp_grplib_grp.level     <> buf_temp_grplib_grp.level
     7633       :
     7634           delete buf_del_temp_grplib_grp.
     7635       end.
     7636       assign
     7637           buf_temp_grplib_grp.mark = "»"
     7638           buf_temp_grplib_grp.name = replace( buf_temp_grplib_grp.name
     7639                                           , "«"
     7640                                           , "»"
     7641                                           )
     7642       .
     7643       if p-refresh = yes
     7644       then do:
     7645           OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.
     7646           br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     7647           reposition br-list to row v-repositioned-row.
     7648           RUN OpenBr(yes, no, '':U).
     7649       end.
     7650   end.
     7651   END PROCEDURE.
     7652   PROCEDURE create-new-line :
     7653   do
     7654   on error undo, return error
     7655   :
     7656   define input parameter p-node-code      as integer      no-undo.
     7657   define input parameter p-upper-code     as integer      no-undo.
     7658   define input parameter p-level          as integer      no-undo.
     7659   define input parameter p-is-terminal    as logical          no-undo.
     7660   define input parameter p-node-name      as character    no-undo.
     7661   define input parameter p-increase-pc    as decimal      no-undo.
     7662   define input parameter p-calc-method    as character    no-undo.
     7663   define input parameter p-full-name      as character    no-undo.
     7664   define input parameter p-sort-name      as character    no-undo.
     7665   define variable v-margins-range     as integer           no-undo.
     7666   define variable v-margins-exists    as logical           no-undo.
     7667   define variable v-increase-range    as integer          no-undo.
     7668   define variable v-increase-exists   as logical          no-undo.
     7669   define variable v-min-marg          as decimal           no-undo.
     7670   define variable v-max-marg          as decimal           no-undo.
     7671   define variable v-increase-pc       as decimal           no-undo.
     7672   define variable v-round-method      as character         no-undo .
     7673   define variable v-base              as decimal           no-undo .
     7674   define variable v-rmethod-range     as integer           no-undo.
     7675   define variable v-rmethod-exists    as logical           no-undo.
     7676   define variable  v-cli-type         as character no-undo .
     7677   define variable  v-cli-code         as integer no-undo .
     7678   define variable  v-income-cli-range  as integer no-undo .
     7679   define variable  v-income-cli-exists as logical no-undo .
     7680   define buffer buf_temp_grplib_grp       for temp_grplib_grp.
     7681       create buf_temp_grplib_grp.
     7682       assign
     7683           buf_temp_grplib_grp.node-code   = p-node-code
     7684           buf_temp_grplib_grp.upper-code  = p-upper-code
     7685           buf_temp_grplib_grp.level       = p-level
     7686           buf_temp_grplib_grp.full-name   = p-full-name + (if p-full-name <> "" then chr(47)         else "") + p-node-name
     7687           buf_temp_grplib_grp.sort-name   = p-sort-name + (if p-full-name <> "" then chr(2)  else "") + p-node-name
     7688           buf_temp_grplib_grp.calc-method = p-calc-method
     7689           buf_temp_grplib_grp.increase-pc = p-increase-pc
     7690         .
     7691       find first temp_cons where temp_cons.node-code = p-node-code no-error .
     7692       if available temp_cons then do:
     7693           assign
     7694             buf_temp_grplib_grp.min-marg = temp_cons.min-marg
     7695             buf_temp_grplib_grp.max-marg = temp_cons.max-marg
     7696             buf_temp_grplib_grp.cli-type = temp_cons.cli-type
     7697           .
     7698       end.
     7699       run get-first-char in this-procedure (
     7700             input p-node-code
     7701           , input p-is-terminal
     7702           , input no
     7703           , output buf_temp_grplib_grp.mark
     7704       ) no-error.
     7705       if error-status :error
     7706       then do:
     7707           undo, return error "create-new-line: Ошибка вычисления первого символа для отображения группы." .
     7708       end.
     7709       assign
     7710           buf_temp_grplib_grp.name = fill( " ", 4 * p-level )
     7711                                           + buf_temp_grplib_grp.mark
     7712                                           + " "
     7713                                           + p-node-name
     7714       .
     7715   end.
     7716   END PROCEDURE.
     7717   PROCEDURE delete-grp :
     7718   do
     7719   on error undo, return error
     7720   :
     7721   define input parameter p-node-code  as integer      no-undo.
     7722   define input parameter p-refresh    as logical      no-undo.
     7723       define variable v-gds-grp-recid     as recid    no-undo.
     7724       define variable v-focused-row       as integer  no-undo.
     7725       define variable v-repositioned-row  as integer  no-undo.
     7726       define variable v-upper-code        as integer  no-undo.
     7727       define variable v-answer            as logical  no-undo.
     7728       define variable v-is-terminal       as logical  no-undo.
     7729       define variable v-have-goods        as logical  no-undo.
     7730       define variable v-counter           as integer  no-undo.
     7731       define variable v-have-rights       as logical  no-undo.
     7732       define buffer buf_gds-grp           for ub.gds-grp.
     7733       define buffer buf_same_gds-grp      for ub.gds-grp.
     7734       define buffer buf_temp_grplib_grp   for temp_grplib_grp.
     7735       run check-rights-for-change-grp in this-procedure (
     7736           input  p-node-code
     7737           ,output v-have-rights
     7738       ) no-error.
     7739       if error-status :error
     7740       or v-have-rights = no
     7741       then do:
     7742           message
     7743             vss-workfile vss-revision vss-description
     7744             skip "Нет прав на изменение справочника групп товаров."
     7745             skip "Удаление группы невозможно."
     7746             skip return-value
     7747             skip trim(error-status :get-message(1))
     7748                  trim(error-status :get-message(2))
     7749                  trim(error-status :get-message(3))
     7750           view-as alert-box error.
     7751           undo, return error .
     7752       end.
     7753       assign
     7754           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     7755           v-repositioned-row = current-result-row( "br-list" )
     7756       .
     7757       if p-node-code = v-root-code
     7758       then do:
     7759           message
     7760               "Нельзя удалить корневую группу."
     7761           view-as alert-box.
     7762           undo, return.
     7763       end.
     7764       find first buf_temp_grplib_grp
     7765            where buf_temp_grplib_grp.node-code = p-node-code
     7766       no-error .
     7767       if error-status :error
     7768       then do:
     7769           undo, return error "Неверно выбрана группа." .
     7770       end.
     7771       if buf_temp_grplib_grp.upper-code = v-root-code
     7772       then do:
     7773           assign
     7774               v-counter = v-counter + 1
     7775           .
     7776           count-first-level-grp:
     7777           for each buf_gds-grp no-lock
     7778              where buf_gds-grp.upper-code = v-root-code
     7779           :
     7780               assign
     7781                   v-counter = v-counter + 1
     7782               .
     7783               if v-counter > 1
     7784               then do:
     7785                   leave count-first-level-grp.
     7786               end.
     7787               else do:
     7788                   message
     7789                       "Нельзя удалить последнюю группу первого уровня."
     7790                   view-as alert-box.
     7791                   return error.
     7792               end.
     7793           end.
     7794       end.
     7795       find first buf_gds-grp no-lock
     7796            where buf_gds-grp.node-code = p-node-code
     7797       no-error.
     7798       if error-status :error
     7799       then do:
     7800           undo, return error "change-grp: Нет группы БД, соответствующей значению в списке.".
     7801       end.
     7802       assign
     7803           v-upper-code    = buf_gds-grp.upper-code
     7804           v-answer        = no
     7805       .
     7806       run grplib-is-terminal in this-procedure ( input p-node-code, output v-is-terminal ) no-error.
     7807       if error-status :error
     7808       then do:
     7809           undo, return error return-value.
     7810       end.
     7811       if v-is-terminal = no
     7812       then do:
     7813           for each buf_gds-grp
     7814           where buf_gds-grp.upper-code = v-upper-code
     7815             and buf_gds-grp.node-code <> p-node-code
     7816           :
     7817               find first buf_same_gds-grp no-lock
     7818                   where buf_same_gds-grp.upper-code  = p-node-code
     7819                   and buf_same_gds-grp.node-name   = buf_gds-grp.node-name
     7820               no-error.
     7821               if available buf_same_gds-grp
     7822               then do:
     7823                   message
     7824                       "Одна из подгрупп удаляемой группы имеет название:" buf_gds-grp.node-name "-" skip
     7825                       "такое же, как одна из соседних к удаляемой групп." skip
     7826                       "После удаления получились бы 2 группы на одном уровне, имеющие одинаковые названия, что запрещено."
     7827                   view-as alert-box error.
     7828                   return no-apply.
     7829               end.
     7830           end.
     7831           message "Текущая группа будет удалена."
     7832               skip "Ее подгруппы будут перенесены в вышестоящую группу."
     7833               skip (1) "Слить группу с вышестоящей?"
     7834           view-as alert-box question buttons yes-no update v-answer.
     7835       end.
     7836       if v-is-terminal = yes
     7837       then do:
     7838           run grplib-have-goods in this-procedure (
     7839                 input p-node-code
     7840               , output v-have-goods
     7841           ) no-error .
     7842           if error-status :error
     7843           then do:
     7844               undo, return error "delete-grp: Ошибка определения наличия товаров в группе." + chr(10) + return-value.
     7845           end.
     7846           if v-have-goods = yes
     7847           then do:
     7848               find first buf_gds-grp no-lock
     7849                    where buf_gds-grp.upper-code = v-upper-code
     7850                      and buf_gds-grp.node-code <> p-node-code
     7851               no-error .
     7852               if available buf_gds-grp
     7853               then do:
     7854                   message "В одной группе не могут быть одновременно подгруппы и товары."
     7855                       skip "Эта группа не может быть слита с вышестоящей."
     7856                   view-as alert-box error.
     7857                   apply "entry" to br-list in frame Dlg-grp.
     7858                   return no-apply.
     7859               end.
     7860               message "Текущая группа будет удалена."
     7861                   skip "Товары будут перенесены в вышестоящую группу."
     7862                   skip (1) "Слить группу с вышестоящей?"
     7863               view-as alert-box question buttons yes-no update v-answer.
     7864           end.
     7865           else do:
     7866               message "Удалить группу ? Вы уверены ?"
     7867               view-as alert-box question buttons yes-no update v-answer.
     7868           end.
     7869       end.
     7870       if not v-answer
     7871       then do:
     7872           apply "entry" to br-list in frame Dlg-grp.
     7873           return no-apply.
     7874       end.
     7875       delete-from-base:
     7876       do
     7877       ON ERROR UNDO delete-from-base, return no-apply
     7878       ON stop UNDO delete-from-base, return no-apply:
     7879           find first buf_gds-grp exclusive-lock
     7880                where buf_gds-grp.node-code = p-node-code
     7881           no-error.
     7882           if error-status :error
     7883           then do:
     7884               undo, return error "change-grp: Нет группы БД, соответствующей значению в списке.".
     7885           end.
     7886           delete buf_gds-grp.
     7887       end.
     7888       if p-refresh = yes
     7889       then do:
     7890           find first buf_gds-grp no-lock
     7891                where buf_gds-grp.node-code = v-upper-code
     7892           no-error.
     7893           if not available buf_gds-grp
     7894           then do:
     7895               undo, return error "delete-grp: Не найдена группа в БД".
     7896           end.
     7897           assign
     7898               p-recid-list = string( recid( buf_gds-grp ) )
     7899               gds-grp-row  = recid( buf_gds-grp )
     7900           .
     7901           run UI-on in this-procedure no-error .
     7902           if error-status :error
     7903           then do:
     7904               undo, return error "delete-grp: Ошибка при загрузке дерева групп.".
     7905           end.
     7906       end.
     7907   end.
     7908   END PROCEDURE.
     7909   PROCEDURE disable_UI :
     7910     HIDE FRAME Dlg-grp.
     7911   END PROCEDURE.
     7912   PROCEDURE enable_UI :
     7913     DISPLAY fi-search b-prc FILL-prc b-prc-2 FILL-prc-2 RADIO-find sch-str
     7914             mark-num
     7915         WITH FRAME Dlg-grp.
     7916     ENABLE b-exit b-verify b-recalc B-print b-help b-expand b-expand-all
     7917            fi-search b-find-by-full-name b-find-by-substring b-search br-list
     7918            b-mark B-add b-chg B-del B-add-AssMatr B-del-AssMatr b-all b-prc
     7919            FILL-prc b-all-2 b-prc-2 FILL-prc-2 RADIO-find sch-str spec-List
     7920            mark-num
     7921         WITH FRAME Dlg-grp.
     7922     VIEW FRAME Dlg-grp.
     7923     OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.
     7924   END PROCEDURE.
     7925   PROCEDURE expand-all-from-current :
     7926   do
     7927   on error undo, return error
     7928   :
     7929   define input parameter p-node-code as integer      no-undo.
     7930       define variable v-full-name         as character    no-undo.
     7931       define variable v-focused-row       as integer      no-undo.
     7932       define variable v-repositioned-row  as integer      no-undo.
     7933       define variable v-grp-counter       as integer      no-undo.
     7934       define buffer buf_temp_grplib_grp       for temp_grplib_grp.
     7935       assign
     7936           v-grplib-no-warning-grp-amount = no
     7937       .
     7938       run expand-item in this-procedure (
     7939             input p-node-code
     7940           , input no
     7941       ) no-error .
     7942       if error-status :error
     7943       then do:
     7944           undo, return error "expand-all-from-current: Не удалось раскрыть подуровни группы.".
     7945       end.
     7946       assign
     7947           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     7948           v-repositioned-row = current-result-row( "br-list" )
     7949       .
     7950       run grplib-get-full-name in this-procedure (
     7951             input p-node-code
     7952           , output v-full-name
     7953       ) no-error .
     7954       if error-status :error
     7955       then do:
     7956           undo, return error "expand-all-from-current: Ошибка вычисления полного имени группы".
     7957       end.
     7958       assign
     7959           v-grplib-grp-amount-for-load = 1
     7960       .
     7961       load-grp-list:
     7962       for each buf_temp_grplib_grp
     7963          where buf_temp_grplib_grp.full-name begins v-full-name
     7964       :
     7965           assign
     7966               v-grp-counter = v-grp-counter + 1
     7967           .
     7968           run expand-item in this-procedure (
     7969                 input buf_temp_grplib_grp.node-code
     7970               , input no
     7971           ) no-error .
     7972           if error-status :error
     7973           then do:
     7974               undo, return error "expand-all-from-current: Не удалось раскрыть подуровни группы.".
     7975           end.
     7976           if v-grp-counter > 1000
     7977           and v-grplib-grp-amount-for-load <> 0
     7978           then do:
     7979               define variable v-choice    as integer      no-undo.
     7980               run gbl/d-askw.w (
     7981                     input "Большой список групп"
     7982                   , input substitute( "В список добавлено более &2 групп&1&1Вы можете добавить следующие &2 групп,&1заполнить весь список&1или остановить создание списка.", chr(10), 1000 )
     7983                   , input "|^":U
     7984                   , input substitute( "Следующие &1|Заполнить все|Прервать", 1000 )
     7985                   , input substitute( "Загрузить список следующих &1 групп|Загрузить список всех групп|Не загружать список полностью", 1000 )
     7986                   , input 1
     7987                   , input 3
     7988                   , output v-choice
     7989               ).
     7990               case v-choice
     7991               :
     7992                   when 1
     7993                   then do:
     7994                       assign
     7995                           v-grplib-grp-amount-for-load    = 1
     7996                           v-grp-counter                   = 0
     7997                       .
     7998                   end.
     7999                   when 2
     8000                   then do:
     8001                       assign
     8002                           v-grplib-grp-amount-for-load    = 0
     8003                       .
     8004                   end.
     8005                   otherwise do:
     8006                       leave load-grp-list.
     8007                   end.
     8008               end case.
     8009           end.
     8010       end.
     8011       OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.
     8012       br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     8013       reposition br-list to row v-repositioned-row.
     8014       RUN OpenBr(yes, no, '':U).
     8015   end.
     8016   END PROCEDURE.
     8017   PROCEDURE expand-item :
     8018   do
     8019   on error undo, return error
     8020   :
     8021   define input parameter p-node-code  as integer      no-undo.
     8022   define input parameter p-refresh    as logical      no-undo.
     8023       define variable v-focused-row       as integer              no-undo.
     8024       define variable v-repositioned-row  as integer              no-undo.
     8025       define buffer buf_gds-grp           for ub.gds-grp.
     8026       define buffer buf_temp_grplib_grp   for temp_grplib_grp.
     8027   if session :set-wait-state( "compiler" ) then.
     8028       assign
     8029           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     8030           v-repositioned-row = current-result-row( "br-list" )
     8031       .
     8032       find first buf_temp_grplib_grp
     8033            where buf_temp_grplib_grp.node-code = p-node-code
     8034       no-error .
     8035       if not available buf_temp_grplib_grp
     8036       then do:
     8037           undo, return error "expand-item: Неверно задан код группы.".
     8038       end.
     8039       if buf_temp_grplib_grp.mark <> "»"
     8040       then do:
     8041       end.
     8042       else do:
     8043           for each buf_gds-grp no-lock
     8044              where buf_gds-grp.upper-code = p-node-code
     8045           on error undo, return error
     8046           :
     8047               run create-new-line in this-procedure (
     8048                     input buf_gds-grp.node-code
     8049                   , input buf_gds-grp.upper-code
     8050                   , input buf_temp_grplib_grp.level + 1
     8051                   , input buf_gds-grp.is-term
     8052                   , input buf_gds-grp.node-name
     8053                   , input buf_gds-grp.increase-pc
     8054                   , input buf_gds-grp.calc-method
     8055                   , input buf_temp_grplib_grp.full-name
     8056                   , input buf_temp_grplib_grp.sort-name
     8057               ) no-error .
     8058               if error-status :error
     8059               then do:
     8060                   message
     8061                   vss-workfile vss-revision vss-description
     8062                   skip "expand-item: Ошибка добавления строки в список групп."
     8063                   skip return-value
     8064                   skip trim(error-status :get-message(1))
     8065                       trim(error-status :get-message(2))
     8066                       trim(error-status :get-message(3))
     8067                       trim(error-status :get-message(4))
     8068                       trim(error-status :get-message(5))
     8069                   view-as alert-box error.
     8070   if session :set-wait-state( "" ) then.
     8071                   undo, return error .
     8072               end.
     8073           end.
     8074           assign
     8075               buf_temp_grplib_grp.mark = "«"
     8076               buf_temp_grplib_grp.name = replace( buf_temp_grplib_grp.name
     8077                                               , "»"
     8078                                               , "«"
     8079                                               )
     8080           .
     8081           if p-refresh = yes
     8082           then do:
     8083               OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.
     8084               if v-focused-row > br-list :height - 2
     8085               then do:
     8086                   assign
     8087                       v-focused-row       = br-list :height - 2
     8088                   .
     8089               end.
     8090               br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     8091               reposition br-list to row v-repositioned-row.
     8092               RUN OpenBr(yes, no, '':U).
     8093           end.
     8094       end.
     8095   if session :set-wait-state( "" ) then.
     8096   end.
     8097   END PROCEDURE.
     8098   PROCEDURE expand-or-collapse-item :
     8099   do
     8100   on error undo, return error
     8101   :
     8102       case temp_grplib_grp.mark
     8103       :
     8104       when "»"
     8105       then do:
     8106           run expand-item in this-procedure ( input temp_grplib_grp.node-code, input yes ) no-error .
     8107           if error-status :error
     8108           then do:
     8109               undo, return error "Не удалось раскрыть подуровни группы.".
     8110           end.
     8111       end.
     8112       when "«"
     8113       then do:
     8114           run collapse-item in this-procedure ( input temp_grplib_grp.node-code, input yes ) no-error .
     8115           if error-status :error
     8116           then do:
     8117               undo, return error "Не удалось закрыть подуровни группы.".
     8118           end.
     8119       end.
     8120       end case.
     8121   end.
     8122   END PROCEDURE.
     8123   PROCEDURE expand-tree-for-grp :
     8124   do
     8125   on error undo, return error
     8126   :
     8127   define input parameter p-node-code              as integer          no-undo.
     8128   define output parameter p-focused-row           as integer          no-undo.
     8129   define output parameter p-reposition-row        as integer          no-undo.
     8130   define output parameter p-reposition-to-recid   as logical init no  no-undo.
     8131   define variable v-full-name     as character    no-undo.
     8132   define variable v-found         as logical      no-undo.
     8133   define buffer buf_temp_grplib_grp       for temp_grplib_grp.
     8134       run grplib-get-full-name in this-procedure ( input p-node-code, output v-full-name ) no-error .
     8135       if error-status :error
     8136       then do:
     8137       end.
     8138       else do:
     8139           run grplib-find-grp-by-full-name in this-procedure (
     8140                 input right-trim( v-full-name, chr(47) )
     8141               , input yes
     8142               , output v-found
     8143           ) no-error .
     8144           if v-found = no
     8145           then do:
     8146           end.
     8147           else do:
     8148               process-initial-grp:
     8149               for each temp_grplib_found-grp
     8150               break by temp_grplib_found-grp.level
     8151               on error undo, leave process-initial-grp :
     8152                   if last ( temp_grplib_found-grp.level )
     8153                   then do:
     8154                       assign
     8155                           p-focused-row       = integer( br-list :height in frame Dlg-grp / 2 ) + 1
     8156                       .
     8157                       find first buf_temp_grplib_grp
     8158                            where buf_temp_grplib_grp.node-code = temp_grplib_found-grp.node-code
     8159                       no-error .
     8160                       if error-status :error
     8161                       then do:
     8162                           leave process-initial-grp.
     8163                       end.
     8164                       assign
     8165                           p-reposition-row = recid( buf_temp_grplib_grp )
     8166                           p-reposition-to-recid = yes
     8167                       .
     8168                       leave process-initial-grp.
     8169                   end.
     8170                   else do:
     8171                       run expand-item in this-procedure ( input temp_grplib_found-grp.node-code, input no ) no-error .
     8172                       if error-status :error
     8173                       then do:
     8174                           leave process-initial-grp.
     8175                       end.
     8176                       find first buf_temp_grplib_grp
     8177                               where buf_temp_grplib_grp.node-code = temp_grplib_found-grp.node-code
     8178                       no-error .
     8179                       if error-status :error
     8180                       then do:
     8181                           leave process-initial-grp.
     8182                       end.
     8183                       assign
     8184                           p-reposition-row = recid( buf_temp_grplib_grp )
     8185                           p-reposition-to-recid = yes
     8186                       .
     8187                   end.
     8188               end.
     8189           end.
     8190       end.
     8191   end.
     8192   END PROCEDURE.
     8193   PROCEDURE fill-db :
     8194   do
     8195   on error undo, return error
     8196   :
     8197   define input parameter parnode-code like ub.gds-grp.node-code no-undo .
     8198   define input parameter parupper-code like ub.gds-grp.node-code no-undo .
     8199     run ref/dtaxgrpu.p (input parnode-code,
     8200                    input parupper-code,
     8201                    input yes,
     8202                    input v-current-host-code,
     8203                    v-current-store-type,
     8204                    v-current-store-code) no-error.
     8205   end.
     8206   END PROCEDURE.
     8207   PROCEDURE fill-marg :
     8208   do
     8209   on error undo, return error
     8210   :
     8211   define input parameter p-node-code as integer      no-undo.
     8212       define variable v-focused-row       as integer  no-undo.
     8213       define variable v-repositioned-row  as integer  no-undo.
     8214       define variable v-margins-range     as integer  no-undo.
     8215       define variable v-margins-exists    as logical  no-undo.
     8216       define variable v-increase-range     as integer  no-undo.
     8217       define variable v-increase-exists    as logical  no-undo.
     8218       define variable v-min-marg          as decimal  no-undo.
     8219       define variable v-max-marg          as decimal  no-undo.
     8220       define variable v-increase-pc          as decimal  no-undo.
     8221       define variable v-round-method      as character   no-undo .
     8222       define variable v-base              as decimal     no-undo .
     8223       define variable v-rmethod-range     as integer     no-undo.
     8224       define variable v-rmethod-exists    as logical     no-undo.
     8225       define variable v-cli-type           as character no-undo .
     8226       define variable v-cli-code           as integer no-undo .
     8227       define variable v-income-cli-range   as integer no-undo .
     8228       define variable v-income-cli-exists  as logical no-undo .
     8229       define buffer buf_gds-grp           for ub.gds-grp.
     8230       define buffer buf_temp_grplib_grp   for temp_grplib_grp.
     8231       assign
     8232           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     8233           v-repositioned-row = current-result-row( "br-list" )
     8234       .
     8235       run ref/pr-marg.w (
     8236             input parparentproc
     8237           , input p-node-code
     8238       ) no-error.
     8239       if error-status :error
     8240       then do:
     8241           undo, return error "fill-marg: Ошибка при установке диапазона торговых наценок." + chr(10) + return-value.
     8242       end.
     8243       find first buf_temp_grplib_grp
     8244            where buf_temp_grplib_grp.node-code = p-node-code
     8245       no-error .
     8246       if error-status :error
     8247       then do:
     8248           undo, return error "fill-marg: Неверно задан код группы.".
     8249       end.
     8250       OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.
     8251       br-list :set-repositioned-row( v-focused-row, "ALWAYS" ) in frame Dlg-grp.
     8252       reposition br-list to row v-repositioned-row.
     8253       RUN OpenBr(yes, no, '':U).
     8254   end.
     8255   END PROCEDURE.
     8256   PROCEDURE fill-output-parameters-on-exit :
     8257   do
     8258   on error undo, return error
     8259   :
     8260   define input parameter p-node-code as integer      no-undo.
     8261       define variable v-selected      as logical  init no  no-undo.
     8262       define variable v-is-terminal    as logical           no-undo.
     8263       define buffer buf_gds-grp           for ub.gds-grp.
     8264       define buffer buf_temp_grplib_grp   for temp_grplib_grp.
     8265       run grplib-is-terminal in this-procedure ( input p-node-code, output v-is-terminal ) no-error.
     8266       if error-status :error
     8267       then do:
     8268           undo, return error "fill-output-parameters-on-exit: Не удается определить, корневая группа или терминальная." + chr(10) + return-value.
     8269       end.
     8270       if lookup ( 'терм':U, p-button-list ) <> 0 and v-is-terminal = no
     8271       then do:
     8272               message "Требуется выбрать группу товаров, в которой нет других групп.".
     8273               apply "entry" to br-list in frame Dlg-grp.
     8274               undo, return "no-term".
     8275       end.
     8276       assign
     8277           p-recid-list = ""
     8278       .
     8279       for each buf_temp_grplib_grp
     8280          where buf_temp_grplib_grp.sel = "*"
     8281       :
     8282           find first buf_gds-grp no-lock
     8283                where buf_gds-grp.node-code = buf_temp_grplib_grp.node-code
     8284           no-error .
     8285           if error-status :error
     8286           then do:
     8287               undo, return error "fill-output-parameters-on-exit: Не найдена запись выбранной группы '"
     8288                                   + "'" + buf_temp_grplib_grp.full-name + "'".
     8289           end.
     8290           assign
     8291               p-recid-list = p-recid-list + ( if p-recid-list = "" then "" else "," ) + string( recid( buf_gds-grp ) )
     8292               v-selected = yes
     8293           .
     8294       end.
     8295       if v-selected = no
     8296       then do:
     8297           find first buf_gds-grp no-lock
     8298                where buf_gds-grp.node-code = p-node-code
     8299           no-error .
     8300           if not available buf_gds-grp
     8301           then do:
     8302               find first buf_temp_grplib_grp
     8303                    where buf_temp_grplib_grp.node-code = p-node-code
     8304               no-error .
     8305               if not available buf_temp_grplib_grp
     8306               then do:
     8307                   undo, return error "fill-output-parameters-on-exit: Неверно выбрана группа с кодом "
     8308                                       + string( p-node-code ).
     8309               end.
     8310               undo, return error "fill-output-parameters-on-exit: Не найдена запись выбранной группы '"
     8311                               + buf_temp_grplib_grp.full-name + "'".
     8312           end.
     8313           assign
     8314               p-recid-list = string( recid( buf_gds-grp ) )
     8315           .
     8316       end.
     8317       assign
     8318           gds-grp-row  = integer( entry( 1, p-recid-list ) )
     8319       .
     8320   assign
     8321   v-uf-List_ = (if gds-grp-row = ? then chr(63) else string(gds-grp-row))
     8322   .
     8323   run uf-set in this-procedure(
     8324       input  'gds-grp-p':U
     8325       ,input  g#userid
     8326       ,input v-uf-List_
     8327       ,input v-uf-Naim
     8328       ,input v-uf-print-graft
     8329       ,input v-uf-sort-gr
     8330       ,input v-uf-type-price
     8331       ,input v-uf-type-val
     8332   )  no-error .
     8333   end.
     8334   END PROCEDURE.
     8335   PROCEDURE fill-tt :
     8336   do
     8337   on error undo, return error
     8338   :
     8339   define input parameter parnode-code like ub.gds-grp.node-code no-undo .
     8340   define input parameter parupper-code like ub.gds-grp.node-code no-undo .
     8341   run ref/dtaxgrps.p (parnode-code,
     8342                  parupper-code,
     8343                  v-current-host-code,
     8344                  v-current-store-type,
     8345                  v-current-store-code) no-error.
     8346   end.
     8347   END PROCEDURE.
     8348   PROCEDURE find-grp-in-browse :
     8349   do
     8350   on error undo, return error
     8351   :
     8352   define input parameter p-search-grp-full-name   as character        no-undo.
     8353   define output parameter p-found                 as logical          no-undo.
     8354       define variable v-focused-row       as integer      no-undo.
     8355       define variable v-repositioned-row  as integer      no-undo.
     8356       define variable v-counter           as integer      no-undo.
     8357       define variable v-level             as integer      no-undo.
     8358       define buffer buf_temp_grplib_grp       for temp_grplib_grp.
     8359       assign
     8360           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     8361           v-repositioned-row = current-result-row( "br-list" )
     8362       .
     8363       assign
     8364       v-level = num-entries( right-trim(p-search-grp-full-name, chr(47) ) , chr(47))
     8365       .
     8366       if v-found-grp-num  <> 0
     8367       then do:
     8368           assign
     8369               v-counter = 0
     8370           .
     8371           find first temp_grplib_found-grp
     8372                where temp_grplib_found-grp.level = v-level
     8373           no-error .
     8374           if not available temp_grplib_found-grp
     8375           then do:
     8376               undo, return error "Не найдено ни одной группы уровня " + string( v-level ).
     8377           end.
     8378           do v-counter = 1 to v-found-grp-num
     8379           :
     8380               find next temp_grplib_found-grp
     8381                   where temp_grplib_found-grp.level = v-level
     8382               no-error .
     8383               if not available temp_grplib_found-grp
     8384               then do:
     8385                   undo, return error "Не найдена следующая группа уровня " + string( v-level ).
     8386               end.
     8387           end.
     8388           find first buf_temp_grplib_grp
     8389                   where buf_temp_grplib_grp.node-code = temp_grplib_found-grp.node-code
     8390           no-error .
     8391           if not available buf_temp_grplib_grp
     8392           then do:
     8393               undo, return error "Найденной группы нет в списке групп".
     8394           end.
     8395           OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.
     8396           br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     8397           reposition br-list to recid recid( buf_temp_grplib_grp ).
     8398           RUN OpenBr(yes, no, '':U).
     8399       end.
     8400       else do:
     8401           run grplib-find-grp-by-full-name (
     8402                 input fi-search :screen-value in frame Dlg-grp
     8403               , input yes
     8404               , output p-found
     8405           ).
     8406           if p-found = yes
     8407           then do:
     8408               found-group:
     8409               for each temp_grplib_found-grp no-lock
     8410               by temp_grplib_found-grp.level
     8411               :
     8412                   if temp_grplib_found-grp.level = v-level
     8413                   then do:
     8414                       leave.
     8415                   end.
     8416                   run expand-item in this-procedure (
     8417                         input temp_grplib_found-grp.node-code
     8418                       , input no
     8419                   ).
     8420               end.
     8421               find first temp_grplib_found-grp
     8422                    where temp_grplib_found-grp.level = v-level
     8423               no-error .
     8424               if not available temp_grplib_found-grp
     8425               then do:
     8426                   undo, return error "Нет последней найденной группы для уровня " + string( v-level ).
     8427               end.
     8428               find first buf_temp_grplib_grp
     8429                    where buf_temp_grplib_grp.node-code = temp_grplib_found-grp.node-code
     8430               no-error .
     8431               if not available buf_temp_grplib_grp
     8432               then do:
     8433                   undo, return error "Найденной группы нет в списке групп".
     8434               end.
     8435               OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.
     8436               br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     8437               reposition br-list to recid recid( buf_temp_grplib_grp ).
     8438               RUN OpenBr(yes, no, '':U).
     8439           end.
     8440       end.
     8441       find next temp_grplib_found-grp
     8442           where temp_grplib_found-grp.level = v-level
     8443       no-error .
     8444       if available temp_grplib_found-grp
     8445       then do:
     8446           assign
     8447               v-found-grp-num  = v-found-grp-num + 1
     8448               b-search :label = "Далее"
     8449           .
     8450       end.
     8451       else do:
     8452           assign
     8453               v-found-grp-num  = 0
     8454               b-search :label = "Поиск"
     8455           .
     8456       end.
     8457   end.
     8458   END PROCEDURE.
     8459   PROCEDURE get-current-recid :
     8460   do
     8461   on error undo, return error
     8462   :
     8463   define input parameter p-node-code as integer      no-undo.
     8464   define output parameter p-gds-grp-recid as recid   no-undo.
     8465       define buffer buf_gds-grp       for ub.gds-grp.
     8466       find first buf_gds-grp no-lock
     8467            where buf_gds-grp.node-code = p-node-code
     8468       no-error .
     8469       if not available buf_gds-grp
     8470       then do:
     8471           undo, return error "get-current-recid: Не найдена группа." .
     8472       end.
     8473       assign
     8474           p-gds-grp-recid = recid( buf_gds-grp )
     8475       .
     8476   end.
     8477   END PROCEDURE.
     8478   PROCEDURE get-first-char :
     8479   do
     8480   on error undo, return error
     8481   :
     8482   define input parameter p-node-code      as integer      no-undo.
     8483   define input parameter p-terminal       as logical      no-undo.
     8484   define input parameter p-calc-terminal  as logical      no-undo.
     8485   define output parameter p-prefix        as character    no-undo.
     8486   define variable v-name          as character    no-undo.
     8487   define variable v-is-terminal   as logical      no-undo.
     8488   define variable v-have-goods    as logical      no-undo.
     8489   define buffer buf_gds-grp               for ub.gds-grp.
     8490   define buffer buf_temp_grplib_grp       for temp_grplib_grp.
     8491   if p-calc-terminal = yes
     8492   then do:
     8493       run grplib-is-terminal in this-procedure (
     8494             input p-node-code
     8495           , output v-is-terminal
     8496       ) no-error .
     8497       if error-status :error
     8498       then do:
     8499           undo, return error "get-first-char: Ошибка при определении типа группы (терм/корн).".
     8500       end.
     8501   end.
     8502   else do:
     8503       assign
     8504           v-is-terminal = p-terminal
     8505       .
     8506   end.
     8507   if v-is-terminal = yes
     8508   then do:
     8509       run grplib-have-goods in this-procedure (
     8510             input p-node-code
     8511           , output v-have-goods
     8512       ) no-error .
     8513       if error-status :error
     8514       then do:
     8515           undo, return error "get-first-char: Ошибка определения наличия товаров в группе." + chr(10) + return-value.
     8516       end.
     8517       if v-have-goods = yes
     8518       then do:
     8519           assign
     8520               p-prefix = "•"
     8521           .
     8522       end.
     8523       else do:
     8524           assign
     8525               p-prefix = " "
     8526           .
     8527       end.
     8528   end.
     8529   else do:
     8530       find first buf_temp_grplib_grp no-lock
     8531            where buf_temp_grplib_grp.upper-code = p-node-code
     8532       no-error.
     8533       if available buf_temp_grplib_grp
     8534       then do:
     8535           assign
     8536               p-prefix = "«"
     8537           .
     8538       end.
     8539       else do:
     8540           assign
     8541               p-prefix = "»"
     8542           .
     8543       end.
     8544   end.
     8545   end.
     8546   END PROCEDURE.
     8547   PROCEDURE get-row-amount :
     8548   do
     8549   on error undo, return error
     8550   :
     8551   define output parameter p-row-amount as integer      no-undo.
     8552       define buffer buf_temp_grplib_grp       for temp_grplib_grp.
     8553       for each buf_temp_grplib_grp
     8554       :
     8555           assign
     8556               p-row-amount = p-row-amount + 1
     8557           .
     8558       end.
     8559   end.
     8560   END PROCEDURE.
     8561   PROCEDURE init-tt :
     8562    define buffer buf_gds-grp-obj-attr  for ub.gds-grp-obj-attr  .
     8563       for each temp_grplib_grp :
     8564           find first buf_gds-grp-obj-attr no-lock  where
     8565                      buf_gds-grp-obj-attr.attr-code = 'LimSpecGr':U and
     8566                      buf_gds-grp-obj-attr.obj-type  = string(buf_contract.contract-code) and
     8567                      buf_gds-grp-obj-attr.obj-code  = buf_contract.host-code and
     8568                      buf_gds-grp-obj-attr.host-code = 0 and
     8569                      buf_gds-grp-obj-attr.node-code = temp_grplib_grp.node-code no-error .
     8570           if not available buf_gds-grp-obj-attr then temp_grplib_grp.cli-type  = "".
     8571           else temp_grplib_grp.cli-type = buf_gds-grp-obj-attr.attr-value .
     8572       end.
     8573   END PROCEDURE.
     8574   PROCEDURE move-item :
     8575   do
     8576   on error undo, return error
     8577   :
     8578   define input parameter p-node-code  as integer      no-undo.
     8579   define input parameter p-upper-code as integer      no-undo.
     8580       define variable v-node-full-name    as character    no-undo.
     8581       define variable v-upper-full-name   as character    no-undo.
     8582       define variable v-focused-row       as integer      no-undo.
     8583       define variable v-repositioned-row  as integer      no-undo.
     8584       define variable v-have-goods        as logical      no-undo.
     8585       define buffer buf_gds-grp           for ub.gds-grp.
     8586       define buffer buf_upper_gds-grp     for ub.gds-grp.
     8587       define buffer buf_temp_grplib_grp   for temp_grplib_grp.
     8588   if session :set-wait-state( "compiler" ) then.
     8589       run grplib-have-goods in this-procedure (
     8590             input p-upper-code
     8591           , output v-have-goods
     8592       ) no-error .
     8593       if error-status :error
     8594       then do:
     8595           undo, return error "move-item: Ошибка определения наличия товаров в группе." + chr(10) + return-value.
     8596       end.
     8597       if v-have-goods = yes
     8598       then do:
     8599               message
     8600                   "В эту группу переместить нельзя, т.к. в одной группе"
     8601                   skip "не могут быть одновременно подгруппы и товары.".
     8602               apply "entry" to br-list in frame Dlg-grp.
     8603               return no-apply.
     8604       end.
     8605       run grplib-get-full-name in this-procedure (
     8606               input p-node-code
     8607               , output v-node-full-name
     8608       ) no-error .
     8609       if error-status :error
     8610       then do:
     8611           undo, return error "move-item: Ошибка вычисления полного имени перемещаемой группы".
     8612       end.
     8613       run grplib-get-full-name in this-procedure (
     8614               input p-upper-code
     8615               , output v-upper-full-name
     8616       ) no-error .
     8617       if error-status :error
     8618       then do:
     8619           undo, return error "move-item: Ошибка вычисления полного имени группы".
     8620       end.
     8621       if v-upper-full-name begins v-node-full-name
     8622       then do:
     8623           message
     8624           "Группу нельзя переместить в ее собственную подгруппу."
     8625           view-as alert-box.
     8626           undo, return.
     8627       end.
     8628       do transaction
     8629       on error undo, return error "move-item: Ошибка перемещения группы.".
     8630           find first buf_gds-grp exclusive-lock
     8631               where buf_gds-grp.node-code = p-node-code
     8632           no-error .
     8633           if not available buf_gds-grp
     8634           then do:
     8635               undo, return error "move-item: Не найдена группа для перемещения.".
     8636           end.
     8637           assign
     8638               buf_gds-grp.upper-code = p-upper-code
     8639           .
     8640       end.
     8641       assign
     8642           p-recid-list = string( recid( buf_gds-grp ) )
     8643           gds-grp-row  = recid( buf_gds-grp )
     8644       .
     8645       run UI-on in this-procedure no-error .
     8646       if error-status :error
     8647       then do:
     8648           undo, return error "move-item: Ошибка при загрузке дерева групп." + chr(10) + return-value.
     8649       end.
     8650   end.
     8651   END PROCEDURE.
     8652   PROCEDURE openbr :
     8653     define input  parameter p-open-query     as logical   no-undo .
     8654     define input  parameter p-find-next      as logical   no-undo .
     8655     define input  parameter p-find-condition as character no-undo .
     8656     define variable l-query-was-opened as logical no-undo .
     8657     define variable sort-column-phrase as character no-undo .
     8658     case sort-column-name :
     8659       when "" then assign  sort-column-phrase = ""  .
     8660       otherwise    assign  sort-column-phrase = "by " + sort-column-name .
     8661     end case.
     8662     define variable l-open-query as logical   no-undo .
     8663       filter-point = filter-point0 .
     8664       if available buf_contract-specif then assign v-doc-rec = recid (buf_contract-specif) .
     8665   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8666   define variable  l-disable-where-51  as logical   no-undo .
     8667   define variable  l-filter-open-51    as logical   .
     8668   define variable  flt-rec-51       as recid     no-undo .
     8669   define variable  filter-name-51      as character no-undo .
     8670   define variable  where-phrase-51     as character no-undo .
     8671   define variable  sort-phrase-51      as character no-undo .
     8672   define variable  where-phrase-rus-51 as character no-undo .
     8673   define variable  sort-phrase-rus-51  as character no-undo .
     8674     run waitfram-show in this-procedure
     8675       (input "ЖДИТЕ ..."
     8676       ).
     8677   run gbl/flt-get.p
     8678     (input filter-point
     8679     ,output flt-rec-51
     8680     ,output filter-name-51
     8681     ,output where-phrase-51
     8682     ,output sort-phrase-51
     8683     ,output where-phrase-rus-51
     8684     ,output sort-phrase-rus-51
     8685     ).
     8686   if p-open-query then do:
     8687     assign
     8688       l-filter-open-51 = false
     8689     .
     8690     if flt-rec-51 <> ?
     8691       or sort-column-phrase > ""
     8692     then do:
     8693       define variable  parameter-2-51 as character no-undo .
     8694       define variable  parameter-3-51 as character no-undo .
     8695       define variable  parameter-4-51 as character no-undo .
     8696       define variable  parameter-5-51 as character no-undo .
     8697       define variable  parameter-6-51 as character no-undo .
     8698       define variable  parameter-7-51 as character no-undo .
     8699         assign
     8700         parameter-3-51 =
     8701                                 "FOR EACH buf_contract-specif"
     8702         parameter-4-51 =
     8703           (
     8704             if (" buf_contract-specif.host-code = p-host-code and                     buf_contract-specif.contract-num = p-contract-num " + " " + where-phrase-51) <> ""
     8705             then  substitute(' buf_contract-specif.host-code = &1 and buf_contract-specif.contract-num = &2', p-host-code, p-contract-num)  + " " + where-phrase-51
     8706             else "true"
     8707           )
     8708         parameter-5-51 = (" " + "" + " " + substitute(' , first buf_goods no-lock where                     buf_goods.gds-code  = buf_contract-specif.gds-code   and                     ( &1 = 0 OR                     ( buf_goods.grp-name begins &2&3&2 )) ',temp_grplib_grp.level, chr(34),temp_grplib_grp.full-name ))
     8709         parameter-6-51 = if sort-phrase-51 = ''
     8710                              then
     8711           (
     8712           " " + "  " +
     8713             " " + sort-column-phrase +
     8714           " " + " "
     8715           )
     8716                              else
     8717           (
     8718           " " + "  " +
     8719             " " + sort-column-phrase +
     8720           " " + sort-phrase-51
     8721           )
     8722         parameter-7-51 =
     8723           "   "
     8724       .
     8725       do
     8726       on stop undo, leave
     8727       on error undo, leave
     8728       :
     8729         assign
     8730           l-disable-where-51 =
     8731             (" buf_contract-specif.host-code = p-host-code and                     buf_contract-specif.contract-num = p-contract-num " + " " + where-phrase-51 = "")
     8732         .
     8733         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     8734                             ,input query spec-List:handle
     8735                             ,input parameter-3-51
     8736                             ,input parameter-4-51
     8737                             ,input parameter-5-51
     8738                             ,input parameter-6-51
     8739                             ,input parameter-7-51
     8740                             )
     8741         .
     8742         assign
     8743           l-filter-open-51 = true
     8744         .
     8745       end.
     8746       if l-filter-open-51 = false then do:
     8747         message
     8748           "Ошибка при фильтрации / сортировке" skip
     8749           "Будут показаны записи без учета фильтра" skip
     8750           view-as alert-box .
     8751       end.
     8752       else do:
     8753           assign
     8754             l-query-was-opened = true
     8755           .
     8756       end.
     8757     end.
     8758     if l-filter-open-51 = false then do:
     8759       OPEN QUERY spec-List FOR EACH buf_contract-specif NO-LOCK
     8760         where  buf_contract-specif.host-code = p-host-code and                     buf_contract-specif.contract-num = p-contract-num
     8761       , first buf_goods no-lock where                     buf_goods.gds-code  = buf_contract-specif.gds-code   and                     ( temp_grplib_grp.level = 0 OR                     ( buf_goods.grp-name begins temp_grplib_grp.full-name ))
     8762     .
     8763         assign
     8764           l-query-was-opened = true
     8765         .
     8766     end.
     8767   end.
     8768   else do:
     8769     assign
     8770       v-doc-rec = recid( buf_contract-specif )
     8771     .
     8772     do
     8773     on stop undo, leave
     8774     on error undo, leave
     8775     :
     8776       if query spec-List:handle:get-buffer-handle(1) = (buffer buf_contract-specif:handle) then do:
     8777         assign
     8778         parameter-2-51 = (if p-find-next then "true":u else "false":u )
     8779         parameter-4-51 =
     8780           "where ":u +  substitute(' buf_contract-specif.host-code = &1 and buf_contract-specif.contract-num = &2', p-host-code, p-contract-num)  + " ":u + where-phrase-51 + " ":u + p-find-condition + " " + ""
     8781         parameter-5-51 = "  "
     8782       .
     8783         run fltopend_fltfindd in this-procedure  (
     8784                             input this-procedure:handle
     8785                             ,input query spec-List:handle
     8786                             ,input rowid(buf_contract-specif)
     8787                             ,input logical(parameter-2-51)
     8788                             ,input no-lock
     8789                             ,input (buffer buf_contract-specif:handle)
     8790                             ,input parameter-4-51
     8791                             ,input parameter-5-51
     8792                             ) no-error.
     8793         .
     8794         assign
     8795           v-doc-rec = integer(return-value)
     8796           v-fltopend-rowid[1] = ?
     8797         .
     8798       end.
     8799       else do:
     8800         assign
     8801         parameter-2-51 = (if p-find-next then "true":u else "false":u )
     8802         parameter-3-51 =  "FOR EACH buf_contract-specif"
     8803         parameter-4-51 =
     8804           (
     8805             if (" buf_contract-specif.host-code = p-host-code and                     buf_contract-specif.contract-num = p-contract-num " + " " + where-phrase-51) <> ""
     8806             then  substitute(' buf_contract-specif.host-code = &1 and buf_contract-specif.contract-num = &2', p-host-code, p-contract-num)  + " " + where-phrase-51
     8807             else "true"
     8808           )
     8809         parameter-5-51 = (" " + "" + " " + substitute(' , first buf_goods no-lock where                     buf_goods.gds-code  = buf_contract-specif.gds-code   and                     ( &1 = 0 OR                     ( buf_goods.grp-name begins &2&3&2 )) ',temp_grplib_grp.level, chr(34),temp_grplib_grp.full-name ) + " " + p-find-condition)
     8810         parameter-6-51 = if sort-phrase-51 = ''
     8811                              then
     8812           (
     8813           " " + "  " +
     8814             " " + sort-column-phrase +
     8815           " " + " "
     8816           )
     8817                              else
     8818           (
     8819           " " + "  " +
     8820             " " + sort-column-phrase +
     8821           " " + sort-phrase-51
     8822           )
     8823         parameter-7-51 =
     8824           "   "
     8825       .
     8826         run fltopend_fltfindq in this-procedure  (
     8827                             input this-procedure:handle
     8828                             ,input query spec-List:handle
     8829                             ,input logical(parameter-2-51)
     8830                             ,input no-lock
     8831                             ,input parameter-3-51
     8832                             ,input parameter-4-51
     8833                             ,input parameter-5-51
     8834                             ,input parameter-6-51
     8835                             ,input parameter-7-51
     8836                             ,output v-fltopend-rowid
     8837                             ) no-error.
     8838         .
     8839         v-doc-rec = ?.
     8840       end.
     8841       assign
     8842         l-query-was-opened = true
     8843       .
     8844     end.
     8845   end.
     8846     run waitfram-hide in this-procedure .
     8847     if not p-open-query then do:
     8848        REPOSITION spec-List to recid v-doc-rec No-ERROR.
     8849        end.
     8850     else do:
     8851        REPOSITION spec-List to row 1 No-ERROR.
     8852     end.
     8853   END PROCEDURE.
     8854   PROCEDURE print-browse :
     8855   define variable Line as character no-undo.
     8856   define variable v-vat-pc as decimal no-undo .
     8857   define variable v-bonus as decimal no-undo .
     8858   define variable v-slt-pc as decimal no-undo .
     8859   define variable date_string as character no-undo.
     8860   define buffer buf_temp_grplib_grp for temp_grplib_grp.
     8861   define buffer buf_tax-rate-gds-grp for ub.tax-rate-gds-grp.
     8862   DEFINE FRAME brFrame
     8863   buf_temp_grplib_grp.name          format "X(71)"      column-label " Наименование группы"
     8864   buf_temp_grplib_grp.calc-method   format "X(11)"      column-label " Исходная"
     8865   buf_temp_grplib_grp.increase-pc   format "->>>>9.99"  column-label " Наценка"
     8866   buf_temp_grplib_grp.min-marg      format "X(10)"  column-label " Мин.Нац."
     8867   buf_temp_grplib_grp.max-marg      format "X(10)"  column-label " Макс.Нац."
     8868   buf_temp_grplib_grp.round-method  format "X(22)"  column-label "Метод округл"
     8869   v-vat-pc                          format "99.99"  column-label "НДС"
     8870   v-bonus                           format "99.99"  column-label "Бонус"
     8871   v-slt-pc                          format "99.99"  column-label "НП"
     8872   HEADER  date_string AT 5 format "X(35)"
     8873   string( "Страница " ) format "X(9)" AT 85 PAGE-NUMBER(PrnLibStream) AT 95 FORMAT ">>9" SKIP
     8874   Line format "X(150)" AT 1
     8875   with width 232 down stream-io use-text    .
     8876   Line = fill("-", 150).
     8877   date_string = cur-time-print() .
     8878   run prn-lib-open-stream  in this-procedure (
     8879         input parparentproc
     8880       , input 43
     8881       , input yes
     8882       , input no
     8883   ).
     8884   PUT  STREAM PrnLibStream
     8885       SPACE(25) ( frame Dlg-grp:title )
     8886       format "x(90)" SKIP(1)
     8887   .
     8888   FORM HEADER
     8889   Line format "X(150)" AT 1 SKIP
     8890   "Продолжение - на следующей странице" AT 30 SKIP
     8891   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     8892   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     8893   FORM with FRAME BrFrame  .
     8894   run waitfram-show in this-procedure ("Ждите...").
     8895   FOR EACH buf_temp_grplib_grp :
     8896     FIND LAST buf_tax-rate-gds-grp No-LOCK WHERE
     8897               buf_tax-rate-gds-grp.node-code = buf_temp_grplib_grp.node-code AND
     8898               buf_tax-rate-gds-grp.tax-code = integer('1':U) AND
     8899               buf_tax-rate-gds-grp.host-code = 0 AND
     8900               buf_tax-rate-gds-grp.obj-type = "" AND
     8901               buf_tax-rate-gds-grp.obj-code = 0 NO-ERROR.
     8902     if avail buf_tax-rate-gds-grp then do:
     8903   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8904   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
     8905     (input  ?
     8906     ,input  buf_tax-rate-gds-grp.tax-code
     8907     ,input  buf_tax-rate-gds-grp.rate-code
     8908     ,input  ?
     8909     ,input  v-current-host-code
     8910     ,input  v-current-store-type
     8911     ,input  v-current-store-code
     8912     ,output v-vat-pc
     8913     ) no-error .
     8914     end.
     8915     FIND LAST buf_tax-rate-gds-grp No-LOCK WHERE
     8916               buf_tax-rate-gds-grp.node-code = buf_temp_grplib_grp.node-code AND
     8917               buf_tax-rate-gds-grp.tax-code = integer('2':U) AND
     8918               buf_tax-rate-gds-grp.host-code = 0 AND
     8919               buf_tax-rate-gds-grp.obj-type = "" AND
     8920               buf_tax-rate-gds-grp.obj-code = 0 NO-ERROR.
     8921     if avail buf_tax-rate-gds-grp then do:
     8922   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8923   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
     8924     (input  ?
     8925     ,input  buf_tax-rate-gds-grp.tax-code
     8926     ,input  buf_tax-rate-gds-grp.rate-code
     8927     ,input  ?
     8928     ,input  v-current-host-code
     8929     ,input  v-current-store-type
     8930     ,input  v-current-store-code
     8931     ,output v-slt-pc
     8932     ) no-error .
     8933     end.
     8934     DISPLAY stream PrnLibStream
     8935     buf_temp_grplib_grp.name
     8936     buf_temp_grplib_grp.calc-method
     8937     buf_temp_grplib_grp.increase-pc
     8938     buf_temp_grplib_grp.min-marg
     8939     buf_temp_grplib_grp.max-marg
     8940     buf_temp_grplib_grp.round-method
     8941     v-vat-pc
     8942     v-bonus
     8943     v-slt-pc
     8944     with frame BrFrame.
     8945     down stream PrnLibStream
     8946     with frame BrFrame.
     8947   END.
     8948   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     8949   HIDE  STREAM PrnLibStream FRAME BrFrame.
     8950   output  STREAM PrnLibStream CLOSE.
     8951   run waitfram-hide in this-procedure .
     8952   run prn-lib-prn-file in this-procedure (
     8953         input parparentproc
     8954       , input 8
     8955   ).
     8956   END PROCEDURE.
     8957   PROCEDURE proc-add :
     8958   define variable varschartic  like ub.doc-line.artic initial " " no-undo.
     8959   define variable ref-list  as character no-undo .
     8960   define variable lns-cnt   as integer initial 1  no-undo .
     8961   define buffer b_goods for ub.goods .
     8962   define buffer b_contract-specif for ub.contract-specif .
     8963   define variable is-con as logical   no-undo .
     8964   define variable is-create as logical   no-undo .
     8965     if buf_contract.contract-type =  'о Дополнительных расходах':U then do:
     8966         run ref/addchls.w (
     8967           input parparentproc ,
     8968           input "b-sel,b-mark",
     8969           output ref-list )
     8970           no-error .
     8971         if error-status :error then do:
     8972             message
     8973               vss-workfile vss-revision vss-description skip
     8974               error-status :get-message(1) skip
     8975               return-value skip
     8976               "ref/addchls.w"
     8977               view-as alert-box error
     8978             .
     8979         end.
     8980     end.
     8981     else do:
     8982         run str/chs-gds.w (
     8983              input parparentproc
     8984             ,input v-cntxt-obj-type
     8985             ,input v-cntxt-obj-code
     8986             ,input '':U
     8987             ,input '':U
     8988             ,input "Строка товар. специф. к договору " + buf_contract.contract-prn-code + " от " + string(buf_contract.contract-date,"99/99/9999")
     8989             ,input 'все':U
     8990             ,input buf_contract.cli-type
     8991             ,input buf_contract.cli-code
     8992             ,input v-cntxt-host-code-obj
     8993             ,input ?
     8994             ,input-output varschartic
     8995             ,output ref-list)
     8996             no-error.
     8997         if error-status :error then do:
     8998           message
     8999             vss-workfile vss-revision vss-description skip
     9000             error-status :get-message(1) skip
     9001             return-value skip
     9002             "chs-gds.w"
     9003             view-as alert-box error
     9004           .
     9005         end.
     9006     end.
     9007   if ref-list = "" then  return .
     9008   define variable v-ass-m as logical   no-undo init false .
     9009   if v-cntxt-db-num <> 0 then do :
     9010      if can-find ( first ub.assortment-matrix no-lock where  ub.assortment-matrix.asmt-status = integer ('0':U) and
     9011                                                           ub.assortment-matrix.db-num = v-cntxt-db-num )  then v-ass-m = true  .
     9012   end.
     9013   else do:
     9014      if can-find ( first ub.assortment-matrix no-lock where  ub.assortment-matrix.asmt-status = integer ('0':U))  then v-ass-m = true  .
     9015   end.
     9016   define variable v-log as logical   no-undo .
     9017   define variable vss-include-info54 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9018   do:
     9019     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     9020       (input  v-cntxt-db-num
     9021       ,input  v-cntxt-userid
     9022       ,input  0
     9023       ,input  'actn_assort-matr-gds_add-def':U
     9024       ,input  'global':U
     9025       ,input  0
     9026       ,input  '':U
     9027       ,input  0
     9028       ,input  0
     9029       ,input  0
     9030       ,input  0
     9031       ,input  false
     9032       ,output v-log
     9033       )  .
     9034   end.
     9035    if not v-log then v-ass-m = false .
     9036   if v-ass-m = true then do:
     9037     message "Добавлять НОВЫЕ товары спецификации в Ассортиментные матрицы ?"
     9038             "Если ДА , укажите в какие."
     9039             view-as alert-box question
     9040                     buttons yes-no
     9041                     update v-okk as logical
     9042                     .
     9043     if v-okk then do:
     9044          define variable p-rid-list as character no-undo .
     9045          run ref/assmatr.w (
     9046                input parParentProc
     9047               ,input "b-sel,b-mark"
     9048               ,input v-cntxt-obj-type
     9049               ,input v-cntxt-obj-code
     9050               ,input ?
     9051               ,input ?
     9052               ,input-output p-rid-list
     9053          ) no-error  .
     9054          if error-status :error then message
     9055            vss-workfile vss-revision vss-description skip
     9056            error-status :get-message(1) skip
     9057            return-value skip
     9058            ""
     9059            view-as alert-box error
     9060          .
     9061     end.
     9062   end.
     9063     do while lns-cnt <= num-entries (ref-list):
     9064       find b_goods no-lock where recid(b_goods) = integer (entry (lns-cnt, ref-list)).
     9065       run  SpecGr-gds-code-yes (
     9066           input  b_goods.gds-code ,
     9067           input  b_goods.grp-code ,
     9068           input  p-contract-num   ,
     9069           input  p-host-code      ,
     9070           output p-ask        ) no-error .
     9071           if error-status :error  or p-ask = false  then do:
     9072               message substitute("Нельзя добавлять товар &1 &2 в Спецификацию из-за ограничения по ассортименту в группе", b_goods.gds-code , b_goods.gds-name) skip
     9073               return-value skip error-status :get-message(1)
     9074               view-as alert-box information .
     9075               return .
     9076           end.
     9077   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9078   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     9079     (input  b_goods.gds-code
     9080     ,input  '1':U
     9081     ,input  ?
     9082     ,input  v-cntxt-host-code-obj
     9083     ,input  v-cntxt-obj-type
     9084     ,input  v-cntxt-obj-code
     9085     ,output v-vat-pc
     9086     ) no-error .
     9087       ASSIGN lns-cnt = lns-cnt + 1 .
     9088       find first ub.contract-specif no-lock
     9089         where ub.contract-specif.host-code    = p-host-code
     9090           and ub.contract-specif.contract-num = p-contract-num
     9091           and ub.contract-specif.gds-code     = b_goods.gds-code
     9092       no-error .
     9093       if available ub.contract-specif then do:
     9094         message "Спецификация по товару " b_goods.gds-name " уже есть. Вы хотите изменить спецификацию?"
     9095         view-as alert-box QUESTION BUTTONS YES-NO UPDATE is-con .
     9096         assign  is-create = no .
     9097       end.
     9098       else do:
     9099         assign
     9100           is-create = yes
     9101           is-con = yes
     9102           is-new = yes
     9103         .
     9104       end.
     9105       if is-con = yes then do:
     9106         if is-create then
     9107           assign
     9108             v-price         = 0
     9109             v-qnty          = ?
     9110             v-prc           = buf_contract.spec-prc
     9111             v-vat-type      = 'в т. ч.':U
     9112             v-cli-base-rate = b_goods.cli-base-rate
     9113             v-unit-cli      = b_goods.unit-cli
     9114           .
     9115           find first buf_ext-artic no-lock
     9116             where buf_ext-artic.gds-code = b_goods.gds-code
     9117               and buf_ext-artic.cli-type = buf_contract.cli-type
     9118               and buf_ext-artic.cli-code = buf_contract.cli-code
     9119           no-error .
     9120           if available buf_ext-artic then do:
     9121             assign
     9122               v-unit-cli          = buf_ext-artic.unit-cli
     9123               v-cli-base-rate     = buf_ext-artic.cli-base-rate
     9124               v-unit-cli-ord      = buf_ext-artic.unit-cli-ord
     9125               v-cli-base-rate-ord = buf_ext-artic.cli-base-rate-ord
     9126               v-unit-cli-rcv      = buf_ext-artic.unit-cli-rcv
     9127               v-cli-base-rate-rcv = buf_ext-artic.cli-base-rate-rcv
     9128             .
     9129           end.
     9130           else do:
     9131             assign
     9132               v-unit-cli          = b_goods.unit-cli
     9133               v-cli-base-rate     = b_goods.cli-base-rate
     9134               v-unit-cli-ord      = b_goods.unit-cli
     9135               v-cli-base-rate-ord = b_goods.cli-base-rate
     9136               v-unit-cli-rcv      = b_goods.unit-cli
     9137               v-cli-base-rate-rcv = b_goods.cli-base-rate
     9138             .
     9139           end.
     9140         end.
     9141         else do:
     9142           assign
     9143             v-price         = ub.contract-specif.price-cli
     9144             v-qnty          = ub.contract-specif.qnty
     9145             v-prc           = ub.contract-specif.prc
     9146             v-vat-type      = ub.contract-specif.vat-type
     9147             v-cli-base-rate = ub.contract-specif.cli-base-rate
     9148             v-unit-cli      = ub.contract-specif.unit-cli
     9149             v-cli-base-rate-ord = ub.contract-specif.cli-base-rate-ord
     9150             v-unit-cli-ord      = ub.contract-specif.unit-cli-ord
     9151             v-cli-base-rate-rcv = ub.contract-specif.cli-base-rate-rcv
     9152             v-unit-cli-rcv      = ub.contract-specif.unit-cli-rcv
     9153           .
     9154         end.
     9155         if b-prc then assign v-prc = FILL-prc .
     9156         if b-prc-2 then assign v-prc-2 = FILL-prc-2 .
     9157           run read-bonus (
     9158           buf_contract.contract-code ,
     9159           buf_contract.host-code ,
     9160           b_goods.gds-code ,
     9161           output v-bonus )
     9162           .
     9163           run read-prc-min in this-procedure (
     9164             buf_contract.contract-code ,
     9165             buf_contract.host-code     ,
     9166             b_goods.gds-code   ,
     9167             output v-prc-2 ) .
     9168           run read-retro-bonus in this-procedure (
     9169             buf_contract.contract-code ,
     9170             buf_contract.host-code     ,
     9171             b_goods.gds-code   ,
     9172             output v-retro-bonus ) .
     9173         run str/contspc1.w ( input parParentProc
     9174                            , input 'ИЗМЕНЕНИЕ':U
     9175                            , input b_goods.gds-code
     9176                            , input b_goods.artic
     9177                            , input ( b_goods.prod-type + string(b_goods.prod-code))
     9178                            , input b_goods.gds-name
     9179                            , input b_goods.unit-base
     9180                            , input-output v-price
     9181                            , input-output v-prc
     9182                            , input-output v-prc-2
     9183                            , input-output v-vat-type
     9184                            , input-output v-qnty
     9185                            , input-output v-cli-base-rate
     9186                            , input-output v-vat-pc
     9187                            , input-output v-unit-cli
     9188                            , input-output v-unit-cli-ord
     9189                            , input-output v-cli-base-rate-ord
     9190                            , input-output v-unit-cli-rcv
     9191                            , input-output v-cli-base-rate-rcv
     9192                            , input-output v-bonus
     9193                            , input-output v-retro-bonus
     9194                            , output v-res) .
     9195         if v-res then do:
     9196           if is-create then run add-assmatr in this-procedure (input b_goods.gds-code ,input p-rid-list) .
     9197           do transaction :
     9198             if is-create then do:
     9199               create b_contract-specif .
     9200               assign
     9201                 b_contract-specif.host-code     = p-host-code
     9202                 b_contract-specif.contract-num  = p-contract-num
     9203                 b_contract-specif.gds-code      = b_goods.gds-code
     9204                 b_contract-specif.gds-name      = b_goods.gds-name
     9205                 b_contract-specif.artic         = b_goods.artic
     9206                 b_contract-specif.prod-type     = b_goods.prod-type
     9207                 b_contract-specif.prod-code     = b_goods.prod-code
     9208                 b_contract-specif.unit-base     = b_goods.unit-base
     9209                 b_contract-specif.cli-base-rate = b_goods.cli-base-rate
     9210                 b_contract-specif.unit-base     = b_goods.unit-base
     9211                 b_contract-specif.VAT-type      = 'в т. ч.':U
     9212                 b_contract-specif.VAT-pc        = v-vat-pc
     9213                 b_contract-specif.prc           = buf_contract.spec-prc
     9214                 b_contract-specif.db-num        = v-cntxt-db-num
     9215               .
     9216         run write-bonus (
     9217         buf_contract.contract-code ,
     9218         buf_contract.host-code    ,
     9219         b_goods.gds-code     ,
     9220         v-bonus) .
     9221         run write-prc-min in this-procedure (
     9222             buf_contract.contract-code ,
     9223             buf_contract.host-code     ,
     9224             b_goods.gds-code   ,
     9225             v-prc-2 ) .
     9226         run write-retro-bonus in this-procedure (
     9227             buf_contract.contract-code ,
     9228             buf_contract.host-code     ,
     9229             b_goods.gds-code   ,
     9230             v-retro-bonus ) .
     9231               run recalc-gds-SpecGr
     9232                 (
     9233                   input  '+'              ,
     9234                   input  b_goods.grp-code ,
     9235                   input  p-contract-num   ,
     9236                   input  p-host-code  )
     9237                   no-error .
     9238             end.
     9239             else do:
     9240               find first b_contract-specif exclusive-lock where recid(b_contract-specif) = recid (ub.contract-specif) .
     9241             end.
     9242             assign
     9243               b_contract-specif.price-cli = v-price
     9244               b_contract-specif.prc       = v-prc
     9245               b_contract-specif.vat-type  = v-vat-type
     9246               b_contract-specif.qnty      = v-qnty
     9247               b_contract-specif.sum-cli   = v-price * v-qnty
     9248               b_contract-specif.cli-base-rate = v-cli-base-rate
     9249               b_contract-specif.unit-cli  = v-unit-cli
     9250               b_contract-specif.VAT-pc    = v-vat-pc
     9251               b_contract-specif.cli-base-rate-ord = v-cli-base-rate-ord
     9252               b_contract-specif.unit-cli-ord      = v-unit-cli-ord
     9253               b_contract-specif.cli-base-rate-rcv = v-cli-base-rate-rcv
     9254               b_contract-specif.unit-cli-rcv      = v-unit-cli-rcv
     9255               is-new = yes
     9256             .
     9257               run write-bonus (
     9258                   buf_contract.contract-code ,
     9259                   buf_contract.host-code     ,
     9260                   b_goods.gds-code           ,
     9261                   v-bonus ) .
     9262              run write-prc-min in this-procedure (
     9263                  buf_contract.contract-code ,
     9264                  buf_contract.host-code     ,
     9265                  b_goods.gds-code   ,
     9266                  v-prc-2 ) .
     9267              run write-retro-bonus in this-procedure (
     9268                  buf_contract.contract-code ,
     9269                  buf_contract.host-code     ,
     9270                  b_goods.gds-code   ,
     9271                  v-retro-bonus ) .
     9272           end.
     9273         end.
     9274       end.
     9275   END PROCEDURE.
     9276   PROCEDURE proc-add-ass :
     9277   define buffer bb_contract-specif for ub.contract-specif  .
     9278   define variable v-ass-m as logical   no-undo init false .
     9279   define variable v-log as logical   no-undo .
     9280   define variable p-rid-list as character no-undo .
     9281   if not can-find( first temp-conn) then do:
     9282       message "Не выделено ни одного товара !" view-as alert-box .
     9283       return .
     9284   end.
     9285   if v-cntxt-db-num <> 0 then do :
     9286      if can-find ( first ub.assortment-matrix no-lock where  ub.assortment-matrix.asmt-status = integer ('0':U) and
     9287                                                           ub.assortment-matrix.db-num = v-cntxt-db-num )  then v-ass-m = true  .
     9288   end.
     9289   else do:
     9290      if can-find ( first ub.assortment-matrix no-lock where  ub.assortment-matrix.asmt-status = integer ('0':U))  then v-ass-m = true  .
     9291   end.
     9292   if v-ass-m = false  then return .
     9293   define variable vss-include-info56 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9294   do:
     9295     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     9296       (input  v-cntxt-db-num
     9297       ,input  v-cntxt-userid
     9298       ,input  0
     9299       ,input  'actn_assort-matr-gds_add-def':U
     9300       ,input  'global':U
     9301       ,input  0
     9302       ,input  '':U
     9303       ,input  0
     9304       ,input  0
     9305       ,input  0
     9306       ,input  0
     9307       ,input  true
     9308       ,output v-log
     9309       )  .
     9310   end.
     9311    if not v-log then return  .
     9312     message "Добавлять Выбранные товары спецификации в Ассортиментные матрицы ?"
     9313             "Если ДА , укажите в какие."
     9314             view-as alert-box question
     9315                     buttons yes-no
     9316                     update v-okk as logical
     9317                     .
     9318     if not v-okk then return .
     9319         run ref/assmatr.w (
     9320               input parParentProc
     9321             ,input "b-sel,b-mark"
     9322             ,input v-cntxt-obj-type
     9323             ,input v-cntxt-obj-code
     9324             ,input ?
     9325             ,input ?
     9326             ,input-output p-rid-list
     9327         ) no-error  .
     9328         if error-status :error then message
     9329           vss-workfile vss-revision vss-description skip
     9330           error-status :get-message(1) skip
     9331           return-value skip
     9332           ""
     9333           view-as alert-box error
     9334         .
     9335       run waitfram-show ("Добавление в Ассортиментные матрицы")  .
     9336       for each temp-conn,
     9337           first bb_contract-specif no-lock  where
     9338           recid(bb_contract-specif) = temp-conn.ri :
     9339           run add-assmatr in this-procedure (input bb_contract-specif.gds-code ,input p-rid-list) .
     9340       end.
     9341       run waitfram-hide .
     9342   END PROCEDURE.
     9343   PROCEDURE proc-b-print :
     9344   define variable v-doc-rec as recid no-undo .
     9345   define variable accum-count as integer.
     9346   define variable date_string     as      character    no-undo.
     9347   define variable Line            as      character    no-undo.
     9348   define variable v-time-cr as character no-undo .
     9349   define variable v-time-up as character no-undo .
     9350   define variable v-st      as character no-undo .
     9351   DEFINE FRAME contract-list
     9352         Buf_goods.artic FORMAT "X(16)":U
     9353         Buf_goods.gds-name FORMAT "X(30)":U
     9354   HEADER  date_string AT 5 format "X(35)"
     9355    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     9356   Line format "X(195)" AT 1
     9357   with width 232 down stream-io use-text    .
     9358   Line = fill("-", 195).
     9359   date_string = cur-time-print() .
     9360   run prn-lib-open-stream  in this-procedure (
     9361                                                input parParentProc
     9362                                               ,input 43
     9363                                               ,input yes
     9364                                               ,input no
     9365                                               ).
     9366   PUT  STREAM PrnLibStream
     9367   SPACE(25) ( frame Dlg-grp:title )
     9368   format "x(90)" SKIP(1) .
     9369   FORM HEADER
     9370   Line format "X(195)" AT 1 SKIP
     9371   "Продолжение - на следующей странице" AT 30 SKIP
     9372   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     9373   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     9374   FORM with FRAME contract-list  .
     9375   run waitfram-show in this-procedure ("Ждите...").
     9376   v-doc-rec = recid(buf_contract-specif).
     9377   DO WHILE available buf_contract-specif :
     9378     GET prev spec-list.
     9379   END.
     9380   GET next spec-list.
     9381   DO WHILE available buf_contract-specif :
     9382     Display STREAM PrnLibStream
     9383               Buf_goods.artic
     9384               Buf_goods.gds-name
     9385    with FRAME contract-list .
     9386     DOWN STREAM PrnLibStream 1
     9387     with FRAME contract-list  .
     9388     assign
     9389     accum-count = accum-count + 1
     9390     .
     9391     GET next spec-list.
     9392   END.
     9393   UNDERLINE  STREAM PrnLibStream
     9394       Buf_goods.artic
     9395       Buf_goods.gds-name
     9396   with FRAME contract-list .
     9397   DISPLAY STREAM PrnLibStream
     9398   "ИТОГО"     @ Buf_goods.artic
     9399   accum-count @ Buf_goods.gds-name
     9400   with frame contract-list.
     9401   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     9402   HIDE  STREAM PrnLibStream FRAME contract-list.
     9403   output  STREAM PrnLibStream CLOSE.
     9404   REPOSITION spec-list to recid v-doc-rec no-error.
     9405   APPLY "entry" to spec-list.
     9406   run waitfram-hide in this-procedure .
     9407   run prn-lib-prn-file in this-procedure (
     9408                                             input parParentProc
     9409                                             ,input 8
     9410                                             ).
     9411   END PROCEDURE.
     9412   PROCEDURE proc-del :
     9413   define variable is-con as logical no-undo .
     9414   define buffer b_goods for ub.goods  .
     9415   define variable v-recid as recid no-undo .
     9416   define buffer buf2_contract-specif for ub.contract-specif  .
     9417   v-err-ext = false  .
     9418   v-longchar = "".
     9419   if mark-num = 0 then do:
     9420       if not available buf_contract-specif then return no-apply.
     9421       message "Вы действительно хотите удалить спецификацию по товару " buf_contract-specif.gds-name "?"
     9422       view-as alert-box QUESTION BUTTONS YES-NO UPDATE is-con .
     9423       if is-con = no then return no-apply.
     9424       v-recid =  recid(buf_contract-specif) .
     9425       do transaction :
     9426         find first buf2_contract-specif exclusive-lock where recid(buf2_contract-specif) = v-recid .
     9427         find b_goods no-lock where b_goods.gds-code = buf2_contract-specif.gds-code.
     9428         run recalc-gds-SpecGr
     9429           (
     9430             input  '-'                          ,
     9431             input  b_goods.grp-code             ,
     9432             input  buf2_contract-specif.contract-num ,
     9433             input  buf2_contract-specif.host-code  )
     9434             no-error .
     9435             if error-status :error then message
     9436               vss-workfile vss-revision vss-description skip
     9437               error-status :get-message(1) skip
     9438               return-value skip
     9439               "1"
     9440               view-as alert-box error
     9441             .
     9442         delete buf2_contract-specif .
     9443         v-ask = true .
     9444         run spedlass-proc in this-procedure
     9445         ( input parParentProc    ,
     9446           input b_goods.gds-code ,
     9447           input p-contract-num   ,
     9448           input p-host-code      ,
     9449           input v-ask            ,
     9450           input-output v-list-mat ,
     9451           input-output v-err-ext ,
     9452           input-output v-longchar
     9453         ) no-error .
     9454           if error-status :error then message
     9455             vss-workfile vss-revision vss-description skip
     9456             error-status :get-message(1) skip
     9457             return-value skip
     9458             "2"
     9459             view-as alert-box error
     9460           .
     9461         assign is-new = yes .
     9462       end.
     9463     end.
     9464     else do:
     9465       message "Вы действительно хотите удалить выбранные товары из спецификации?"
     9466       view-as alert-box QUESTION BUTTONS YES-NO UPDATE is-con .
     9467       if is-con = no then return no-apply.
     9468       do transaction :
     9469         v-ask = true .
     9470         for each temp-conn :
     9471           find first buf2_contract-specif exclusive-lock where recid(buf2_contract-specif) = temp-conn.ri .
     9472         find b_goods no-lock where b_goods.gds-code = buf2_contract-specif.gds-code.
     9473         run recalc-gds-SpecGr
     9474           (
     9475             input  '-'                          ,
     9476             input  b_goods.grp-code             ,
     9477             input  buf2_contract-specif.contract-num ,
     9478             input  buf2_contract-specif.host-code  )
     9479             no-error .
     9480           delete buf2_contract-specif .
     9481           delete temp-conn .
     9482           run spedlass-proc in this-procedure
     9483             ( input parParentProc    ,
     9484               input b_goods.gds-code ,
     9485               input p-contract-num   ,
     9486               input p-host-code      ,
     9487               input v-ask            ,
     9488               input-output v-list-mat ,
     9489               input-output v-err-ext ,
     9490               input-output v-longchar
     9491               ) no-error .
     9492           v-ask = false .
     9493         end.
     9494         assign
     9495           is-new = yes
     9496           mark-num = 0
     9497         .
     9498       end.
     9499     end.
     9500     if v-err-ext = true  then do:
     9501     define variable v-ok as logical   no-undo .
     9502       run gbl/d-longchar.w (
     9503             ?,
     9504             'Editor_row=2\':u
     9505           + 'title=При удалении из Ассортиментных матриц\':u
     9506           + 'Editor_col=1\':u
     9507           + 'Editor_width=96\':u
     9508           + 'Editor_height=21\':u
     9509           + 'readonly=yes\':u
     9510         ,input-output v-longchar
     9511         ,output v-ok ) no-error .
     9512             v-longchar = "" .
     9513   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clear-longmess in g#lib-Matrix
     9514      .
     9515     end.
     9516     define variable loc#log as logical   no-undo .
     9517     loc#log = spec-list:select-next-row( ) IN FRAME Dlg-grp.
     9518     apply "ENTRY" to spec-list.
     9519   END PROCEDURE.
     9520   PROCEDURE proc-del-assMat :
     9521   define buffer bb_contract-specif for ub.contract-specif  .
     9522   define buffer buf_assortment-matrix for ub.assortment-matrix  .
     9523   define buffer buf_assortment-matrix-goods for ub.assortment-matrix-goods  .
     9524   define variable v-ass-m as logical   no-undo init false .
     9525   define variable v-log as logical   no-undo .
     9526   define variable v-sts as integer   no-undo .
     9527   define variable p-rid-list as character no-undo .
     9528   define variable i as integer   no-undo .
     9529   if not can-find( first temp-conn) then do:
     9530       message "Не выделено ни одного товара !" view-as alert-box .
     9531       return .
     9532   end.
     9533   if v-cntxt-db-num <> 0 then do :
     9534      if can-find ( first ub.assortment-matrix no-lock where  ub.assortment-matrix.asmt-status = integer ('0':U) and
     9535                                                              ub.assortment-matrix.db-num = v-cntxt-db-num )  then v-ass-m = true  .
     9536   end.
     9537   else do:
     9538      if can-find ( first ub.assortment-matrix no-lock where  ub.assortment-matrix.asmt-status = integer ('0':U))  then v-ass-m = true  .
     9539   end.
     9540   if v-ass-m = false  then return .
     9541   define variable vss-include-info57 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9542   do:
     9543     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     9544       (input  v-cntxt-db-num
     9545       ,input  v-cntxt-userid
     9546       ,input  0
     9547       ,input  'actn_assort-matr-gds_deletion':U
     9548       ,input  'global':U
     9549       ,input  0
     9550       ,input  '':U
     9551       ,input  0
     9552       ,input  0
     9553       ,input  0
     9554       ,input  0
     9555       ,input  true
     9556       ,output v-log
     9557       )  .
     9558   end.
     9559    if not v-log then return  .
     9560     message "Удалить Выбранные товары спецификации  из  Ассортиментных матриц ?"
     9561             "Если ДА , укажите из каких."
     9562             view-as alert-box question
     9563                     buttons yes-no
     9564                     update v-okk as logical
     9565                     .
     9566     if not v-okk then return .
     9567         run ref/assmatr.w (
     9568               input parParentProc
     9569             ,input "b-sel,b-mark"
     9570             ,input v-cntxt-obj-type
     9571             ,input v-cntxt-obj-code
     9572             ,input ?
     9573             ,input ?
     9574             ,input-output p-rid-list
     9575         ) no-error  .
     9576         if error-status :error then message
     9577           vss-workfile vss-revision vss-description skip
     9578           error-status :get-message(1) skip
     9579           return-value skip
     9580           ""
     9581           view-as alert-box error
     9582         .
     9583   define buffer buf_gds-obj-prop for ub.gds-obj-prop  .
     9584   run waitfram-show ("Удаление из Ассортиментных матриц")  .
     9585   v-err-ext = false  .
     9586   v-longchar = "" .
     9587   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clear-longmess in g#lib-Matrix
     9588      .
     9589   for each temp-conn,
     9590       first bb_contract-specif no-lock  where
     9591       recid(bb_contract-specif) = temp-conn.ri :
     9592   repeat i = 1 to num-entries(p-rid-list) :
     9593     find first buf_assortment-matrix no-lock where
     9594                recid(buf_assortment-matrix) = int(entry(i,p-rid-list)) no-error .
     9595     for each buf_assortment-matrix-goods no-lock where
     9596              buf_assortment-matrix-goods.asmt-id  = buf_assortment-matrix.asmt-id and
     9597              buf_assortment-matrix-goods.db-num   = buf_assortment-matrix.db-num  and
     9598              buf_assortment-matrix-goods.gds-code = bb_contract-specif.gds-code
     9599              :
     9600       for each buf_gds-obj-prop exclusive-lock where
     9601               buf_gds-obj-prop.obj-type = buf_assortment-matrix.obj-type and
     9602               buf_gds-obj-prop.obj-code = buf_assortment-matrix.obj-code and
     9603               buf_gds-obj-prop.gds-code = buf_assortment-matrix-goods.gds-code
     9604               :
     9605               if not (buf_gds-obj-prop.gdop-igt = 'Пусто':U or
     9606                       buf_gds-obj-prop.gdop-igt = 'На вывод из ассортимента':U ) then do:
     9607                 v-err-ext = true  .
     9608                 v-longchar = v-longchar +
     9609                 substitute ( "Принудительная смена ИЖТ &1 на <<&6>> товар &2 &3&4&5 " ,
     9610                               buf_gds-obj-prop.gdop-igt ,
     9611                               buf_assortment-matrix-goods.gds-code,
     9612                               buf_assortment-matrix.obj-type,
     9613                               buf_assortment-matrix.obj-code  ,
     9614                               chr(10) ,
     9615                               'Пусто':U
     9616                               ) .
     9617               assign
     9618                 buf_gds-obj-prop.gdop-igt = 'Пусто':U
     9619                 .
     9620               end.
     9621       end.
     9622       if buf_assortment-matrix-goods.asmg-status = int('0':U) then do:
     9623           v-sts = int('1':U) .
     9624   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat2 in g#lib-Matrix
     9625    (input this-procedure
     9626    ,input recid(buf_assortment-matrix-goods)
     9627    ,input-output v-sts
     9628    ,input no
     9629     ) no-error .
     9630           if error-status :error then do:
     9631              v-err-ext = true .
     9632              v-longchar = v-longchar + return-value + chr(10) .
     9633           end.
     9634       end.
     9635     end.
     9636   end.
     9637   end.
     9638   run waitfram-hide .
     9639   if v-err-ext = true  then do:
     9640   define variable v-ok as logical   no-undo .
     9641     run gbl/d-longchar.w (
     9642           ?,
     9643           'Editor_row=2\':u
     9644         + 'title=При удалении из Ассортиментных матриц\':u
     9645         + 'Editor_col=1\':u
     9646         + 'Editor_width=96\':u
     9647         + 'Editor_height=21\':u
     9648         + 'readonly=yes\':u
     9649       ,input-output v-longchar
     9650       ,output v-ok ) no-error .
     9651           v-longchar = "" .
     9652   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clear-longmess in g#lib-Matrix
     9653      .
     9654   end.
     9655   END PROCEDURE.
     9656   PROCEDURE proc-find-code :
     9657   define input parameter p-next as logical no-undo.
     9658   define input parameter p-code as character no-undo .
     9659   define variable p-value       as integer   no-undo .
     9660   define variable p-data-valid  as logical   no-undo .
     9661   define variable p-message     as character no-undo .
     9662     assign p-code = replace(p-code, chr(39), chr(39) + chr(39)) .
     9663     case RADIO-find :
     9664       when 1 then do:
     9665         run integerm ( p-code, false, false, output p-value, output p-data-valid, output p-message) .
     9666         if p-data-valid then run OpenBr in this-procedure (input false, input p-next, input substitute('and buf_contract-specif.gds-code = &1 ', p-code)).
     9667       end.
     9668       when 2 then run OpenBr in this-procedure (input false, input p-next, input substitute('and buf_contract-specif.artic = "&1" ', p-code)).
     9669       when 3 then run OpenBr in this-procedure (input false, input p-next, input substitute('and buf_contract-specif.gds-name begins "&1" ', p-code)).
     9670       when 4 then do:
     9671         assign p-code = lc (p-code) + "*" .
     9672         run OpenBr in this-procedure (input false, input p-next, input substitute('and buf_contract-specif.gds-name contains "&1" ', p-code)).
     9673       end.
     9674     end.
     9675   END PROCEDURE.
     9676   PROCEDURE proc-sum :
     9677   END PROCEDURE.
     9678   PROCEDURE recalc-add :
     9679   define variable v-qntySpecGr as integer  no-undo .
     9680   define variable ll as integer   no-undo .
     9681   define buffer buf2_goods for ub.goods  .
     9682   define buffer loc_temp_grplib_grp for temp_cons  .
     9683   define buffer buf1_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     9684   define variable v-recid as recid no-undo .
     9685   v-recid = recid (temp_grplib_grp) .
     9686       for each loc_temp_grplib_grp :
     9687           v-qntySpecGr = 0.
     9688           find first buf1_gds-grp-obj-attr no-lock where
     9689                      buf1_gds-grp-obj-attr.attr-code = 'QntySpecGr':U and
     9690                      buf1_gds-grp-obj-attr.obj-type  = string(p-contract-num) and
     9691                      buf1_gds-grp-obj-attr.obj-code  = p-host-code and
     9692                      buf1_gds-grp-obj-attr.host-code = 0 and
     9693                      buf1_gds-grp-obj-attr.node-code = loc_temp_grplib_grp.node-code
     9694           no-error .
     9695           if available buf1_gds-grp-obj-attr then v-qntySpecGr = int(buf1_gds-grp-obj-attr.attr-value) .
     9696           assign
     9697             loc_temp_grplib_grp.max-marg = string(v-qntySpecGr)
     9698           .
     9699       end.
     9700   find first temp_grplib_grp where recid(temp_grplib_grp)  = v-recid no-error .
     9701   OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.
     9702   reposition BR-list to recid v-recid no-error.
     9703   RUN OpenBr(yes, no, '':U).
     9704   END PROCEDURE.
     9705   PROCEDURE recalc-lim :
     9706   define buffer loc_temp_grplib_grp for temp_grplib_grp  .
     9707   define variable v-recid as recid no-undo .
     9708   v-recid = recid (temp_grplib_grp) .
     9709   for each temp_cons :
     9710     run calc-down-lim ( input temp_cons.node-code , output temp_cons.min-marg).
     9711     find first loc_temp_grplib_grp where
     9712                loc_temp_grplib_grp.node-code = temp_cons.node-code no-error .
     9713         if available loc_temp_grplib_grp then loc_temp_grplib_grp.min-marg  = temp_cons.min-marg .
     9714   end.
     9715   find first temp_grplib_grp where recid (temp_grplib_grp)  = v-recid no-error .
     9716   OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.
     9717   reposition BR-list to recid v-recid no-error.
     9718   END PROCEDURE.
     9719   PROCEDURE recalc-marg-ass :
     9720   define variable v-qntyAssgrp as integer  no-undo .
     9721   define variable ll as integer   no-undo .
     9722   define buffer buf2_contract-specif for ub.contract-specif  .
     9723   define buffer buf2_goods for ub.goods  .
     9724   define buffer loc_temp_grplib_grp for temp_grplib_grp  .
     9725   define buffer buf1_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     9726   define variable v-recid as recid no-undo .
     9727   v-recid = recid (temp_grplib_grp) .
     9728       for each loc_temp_grplib_grp :
     9729         run calc-down-lim   (
     9730             input loc_temp_grplib_grp.node-code ,
     9731             output loc_temp_grplib_grp.min-marg).
     9732           v-qntyAssgrp = 0.
     9733           find first buf1_gds-grp-obj-attr no-lock where
     9734                      buf1_gds-grp-obj-attr.attr-code = 'QntySpecGr':U and
     9735                      buf1_gds-grp-obj-attr.obj-type  = string(p-contract-num) and
     9736                      buf1_gds-grp-obj-attr.obj-code  = p-host-code and
     9737                      buf1_gds-grp-obj-attr.host-code = 0 and
     9738                      buf1_gds-grp-obj-attr.node-code = loc_temp_grplib_grp.node-code
     9739           no-error .
     9740           if available buf1_gds-grp-obj-attr then v-qntyAssgrp = int(buf1_gds-grp-obj-attr.attr-value) .
     9741           assign
     9742             loc_temp_grplib_grp.max-marg = string(v-qntyAssgrp)
     9743           .
     9744       end.
     9745   run init-tt.
     9746   find first temp_grplib_grp where recid(temp_grplib_grp)  = v-recid no-error .
     9747   OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.
     9748   reposition BR-list to recid v-recid no-error.
     9749   RUN OpenBr(yes, no, '':U).
     9750   END PROCEDURE.
     9751   PROCEDURE save-alla :
     9752   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr .
     9753   if temp_grplib_grp.cli-type:read-only in browse br-list = false then do:
     9754     for each temp_cons :
     9755           find first buf_gds-grp-obj-attr exclusive-lock where
     9756                      buf_gds-grp-obj-attr.attr-code = 'LimSpecGr':U and
     9757                      buf_gds-grp-obj-attr.obj-type  = string(buf_contract.contract-code) and
     9758                      buf_gds-grp-obj-attr.obj-code  = buf_contract.host-code and
     9759                      buf_gds-grp-obj-attr.host-code = 0 and
     9760                      buf_gds-grp-obj-attr.node-code = temp_cons.node-code no-error .
     9761           if not available buf_gds-grp-obj-attr then create buf_gds-grp-obj-attr.
     9762           assign
     9763               buf_gds-grp-obj-attr.attr-code = 'LimSpecGr':U
     9764               buf_gds-grp-obj-attr.obj-type  = string(buf_contract.contract-code)
     9765               buf_gds-grp-obj-attr.obj-code  = buf_contract.host-code
     9766               buf_gds-grp-obj-attr.host-code = 0
     9767               buf_gds-grp-obj-attr.node-code  = temp_cons.node-code
     9768               buf_gds-grp-obj-attr.attr-value = temp_cons.cli-type
     9769           .
     9770     end.
     9771     end.
     9772   END PROCEDURE.
     9773   PROCEDURE save-attr :
     9774   define buffer buf_gds-grp-obj-attr  for ub.gds-grp-obj-attr  .
     9775   if temp_grplib_grp.cli-type:read-only in browse br-list = false then do:
     9776       if available  temp_grplib_grp then do:
     9777           find first buf_gds-grp-obj-attr exclusive-lock where
     9778                      buf_gds-grp-obj-attr.attr-code = 'LimSpecGr':U and
     9779                      buf_gds-grp-obj-attr.obj-type  = string(buf_contract.contract-code) and
     9780                      buf_gds-grp-obj-attr.obj-code  = buf_contract.host-code and
     9781                      buf_gds-grp-obj-attr.host-code = 0 and
     9782                      buf_gds-grp-obj-attr.node-code = temp_grplib_grp.node-code no-error .
     9783           if not available buf_gds-grp-obj-attr then create buf_gds-grp-obj-attr.
     9784           assign
     9785               buf_gds-grp-obj-attr.attr-code = 'LimSpecGr':U
     9786               buf_gds-grp-obj-attr.obj-type  = string(buf_contract.contract-code)
     9787               buf_gds-grp-obj-attr.obj-code  = buf_contract.host-code
     9788               buf_gds-grp-obj-attr.host-code = 0
     9789               buf_gds-grp-obj-attr.node-code = temp_grplib_grp.node-code
     9790               buf_gds-grp-obj-attr.attr-value = temp_grplib_grp.cli-type
     9791           .
     9792        end.
     9793     end.
     9794   END PROCEDURE.
     9795   PROCEDURE select-and-move-item :
     9796   do
     9797   on error undo, return error
     9798   :
     9799   define input parameter p-node-code as integer      no-undo.
     9800       define variable v-upper-code        as integer           no-undo.
     9801       define variable v-upper-recid-list  as character         no-undo.
     9802       define variable v-yesno             as logical           no-undo.
     9803       define variable v-node-full-name    as character         no-undo.
     9804       define variable v-upper-full-name   as character         no-undo.
     9805       define buffer buf_gds-grp       for ub.gds-grp.
     9806       if p-node-code = v-root-code
     9807       then do:
     9808           message
     9809           "Корневую группу переместить невозможно."
     9810           view-as alert-box warning.
     9811           undo, return .
     9812       end.
     9813       find first buf_gds-grp no-lock
     9814            where buf_gds-grp.node-code = p-node-code
     9815       no-error .
     9816       if error-status :error
     9817       then do:
     9818           undo, return error "select-and-move-item: Группа не найдена в базе данных.".
     9819       end.
     9820       assign
     9821           v-upper-recid-list = string( recid( buf_gds-grp ) )
     9822       .
     9823       run ref/gds-grp.w (
     9824             input parparentproc
     9825           , input "buttons-for-move"
     9826           , input p-current-obj-type
     9827           , input p-current-obj-code
     9828           , input-output v-upper-recid-list
     9829       ) no-error .
     9830       if error-status :error
     9831       then do:
     9832           message
     9833             vss-workfile vss-revision vss-description
     9834             skip "Ошибка выбора группы для перемещения."
     9835             skip return-value
     9836             skip trim(error-status :get-message(1))
     9837                  trim(error-status :get-message(2))
     9838                  trim(error-status :get-message(3))
     9839                  trim(error-status :get-message(4))
     9840                  trim(error-status :get-message(5))
     9841           view-as alert-box error.
     9842           undo, return no-apply .
     9843       end.
     9844       find first buf_gds-grp no-lock
     9845            where recid( buf_gds-grp ) = integer( entry( 1, v-upper-recid-list ) )
     9846       no-error .
     9847       if error-status :error
     9848       then do:
     9849           undo, return error "Группа не найдена.".
     9850       end.
     9851       run grplib-get-full-name in this-procedure (  input p-node-code
     9852                                                   , output v-node-full-name
     9853       ) no-error .
     9854       if error-status :error
     9855       then do:
     9856           undo, return error "Ошибка вычисления полного имени перемещаемой группы.".
     9857       end.
     9858       run grplib-get-full-name in this-procedure (  input buf_gds-grp.node-code
     9859                                                   , output v-upper-full-name
     9860       ) no-error .
     9861       if error-status :error
     9862       then do:
     9863           undo, return error "Ошибка вычисления полного имени новой группы".
     9864       end.
     9865       message
     9866           "Переместить группу"
     9867           skip "    '" + v-node-full-name + "'"
     9868           skip "в группу"
     9869           skip "    '" + v-upper-full-name + "'"
     9870       view-as alert-box question
     9871       buttons yes-no
     9872       title "Перемещение группы"
     9873       update v-yesno.
     9874       if v-yesno = no
     9875       then do:
     9876       end.
     9877       else do:
     9878           run move-item in this-procedure ( input p-node-code
     9879                                           , input buf_gds-grp.node-code
     9880           ) no-error.
     9881           if error-status :error
     9882           then do:
     9883               message
     9884               vss-workfile vss-revision vss-description
     9885               skip "Ошибка перемещения группы."
     9886               skip return-value
     9887               skip trim(error-status :get-message(1))
     9888                   trim(error-status :get-message(2))
     9889                   trim(error-status :get-message(3))
     9890                   trim(error-status :get-message(4))
     9891                   trim(error-status :get-message(5))
     9892               view-as alert-box error.
     9893               undo, return no-apply .
     9894           end.
     9895       end.
     9896   end.
     9897   END PROCEDURE.
     9898   PROCEDURE UI-on :
     9899   do
     9900   on error undo, return error
     9901   :
     9902   define variable v-reposition-row        as integer          no-undo.
     9903   define variable v-focused-row           as integer          no-undo.
     9904   define variable v-reposition-to-recid   as logical init no  no-undo.
     9905   define variable v-enable-change-grp     as logical          no-undo.
     9906   define variable v-margins-range         as integer          no-undo.
     9907   define variable v-margins-exists        as logical          no-undo.
     9908   define variable v-increase-range         as integer          no-undo.
     9909   define variable v-increase-exists        as logical          no-undo.
     9910   define variable v-min-marg              as decimal          no-undo.
     9911   define variable v-max-marg              as decimal          no-undo.
     9912   define variable v-increase-pc              as decimal          no-undo.
     9913   define variable v-have-goods            as logical          no-undo.
     9914   define variable v-round-method      as character   no-undo .
     9915   define variable v-base                  as decimal no-undo .
     9916   define variable v-rmethod-range     as integer     no-undo.
     9917   define variable v-rmethod-exists    as logical     no-undo.
     9918   define variable v-cli-type          as character no-undo .
     9919   define variable v-cli-code          as integer     no-undo.
     9920   define variable v-income-cli-range    as integer  no-undo.
     9921   define variable v-income-cli-exists   as logical  no-undo.
     9922   define variable v-dop                   as character no-undo .
     9923   define variable v-full-name             as character    no-undo.
     9924   define variable v-sort-name             as character    no-undo.
     9925   define buffer buf_gds-grp           for ub.gds-grp.
     9926   define buffer buf_temp_grplib_grp   for temp_grplib_grp.
     9927   define variable vss-include-info58 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9928   do:
     9929     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     9930       (input  v-cntxt-db-num
     9931       ,input  v-cntxt-userid
     9932       ,input  0
     9933       ,input  'actn_reference_groups-edit':U
     9934       ,input  'firm':U
     9935       ,input  v-cntxt-host-code-obj
     9936       ,input  '':U
     9937       ,input  0
     9938       ,input  0
     9939       ,input  0
     9940       ,input  0
     9941       ,input  no
     9942       ,output v-enable-change-grp
     9943       )  .
     9944   end.
     9945   run grplib-get-root-code in this-procedure ( output v-root-code ) no-error.
     9946   if error-status :error
     9947   then do:
     9948       undo, return error "Не найден корневой узел." + chr(10) + return-value.
     9949   end.
     9950   if v-from-b-gds then do:
     9951     run uf-get in this-procedure(
     9952         input  'gds-grp-p':U
     9953         ,input  g#userid
     9954         ,output v-uf-List_
     9955         ,output v-uf-Naim
     9956         ,output v-uf-print-graft
     9957         ,output v-uf-sort-gr
     9958         ,output v-uf-type-price
     9959         ,output v-uf-type-val
     9960     )  no-error .
     9961     if not error-status:error then
     9962     assign
     9963     v-dop = string((if v-uf-List_ =  chr(63) then ? else integer(v-uf-LIst_)))
     9964     .
     9965     if v-dop = v-old-recid-list then do:
     9966       assign
     9967       gds-grp-row = v-old-recid
     9968       .
     9969     end.
     9970     else do:
     9971       assign
     9972       gds-grp-row = (if v-uf-List_ =  chr(63) then ? else integer(v-uf-LIst_))
     9973       .
     9974     end.
     9975     assign
     9976         p-recid-list = string( gds-grp-row )
     9977     .
     9978     assign
     9979     v-from-b-gds = no
     9980     v-old-recid-list = "":U.
     9981   end.
     9982   else do:
     9983     run uf-get in this-procedure(
     9984         input  'gds-grp-p':U
     9985         ,input  g#userid
     9986         ,output v-uf-List_
     9987         ,output v-uf-Naim
     9988         ,output v-uf-print-graft
     9989         ,output v-uf-sort-gr
     9990         ,output v-uf-type-price
     9991         ,output v-uf-type-val
     9992     )  no-error .
     9993     if not error-status:error then
     9994     assign
     9995     gds-grp-row = (if v-uf-List_ =  chr(63) then ? else integer(v-uf-LIst_))
     9996     .
     9997     assign
     9998         p-recid-list = string( gds-grp-row )
     9999     .
    10000   end.
    10001   find first buf_gds-grp no-lock
    10002        where buf_gds-grp.node-code = v-root-code
    10003   no-error .
    10004   if error-status :error
    10005   then do:
    10006       message
    10007         vss-workfile vss-revision vss-description
    10008         skip "Не найдена запись корневого узла."
    10009         skip return-value
    10010         skip trim(error-status :get-message(1))
    10011              trim(error-status :get-message(2))
    10012              trim(error-status :get-message(3))
    10013              trim(error-status :get-message(4))
    10014              trim(error-status :get-message(5))
    10015       view-as alert-box error.
    10016       undo, return error .
    10017   end.
    10018   if buf_gds-grp.is-term = yes
    10019   then do:
    10020       run grplib-have-goods in this-procedure (
    10021             input buf_gds-grp.node-code
    10022           , output v-have-goods
    10023       ) no-error .
    10024       if error-status :error
    10025       then do:
    10026           undo, return error "move-item: Ошибка определения наличия товаров в группе." + chr(10) + return-value.
    10027       end.
    10028   end.
    10029   for each buf_temp_grplib_grp
    10030   :
    10031       delete buf_temp_grplib_grp.
    10032   end.
    10033   create buf_temp_grplib_grp.
    10034   assign
    10035       buf_temp_grplib_grp.node-code   = buf_gds-grp.node-code
    10036       buf_temp_grplib_grp.upper-code  = buf_gds-grp.upper-code
    10037       buf_temp_grplib_grp.level       = 0
    10038       buf_temp_grplib_grp.mark        = ( if v-have-goods = yes then "•" else " " )
    10039       buf_temp_grplib_grp.full-name   = chr(4)
    10040       buf_temp_grplib_grp.sort-name   = chr(4)
    10041       buf_temp_grplib_grp.name        = buf_gds-grp.node-name
    10042       buf_temp_grplib_grp.increase-pc = buf_gds-grp.increase-pc
    10043       buf_temp_grplib_grp.calc-method = buf_gds-grp.calc-method
    10044   .
    10045   for each buf_gds-grp no-lock
    10046      where buf_gds-grp.upper-code = v-root-code
    10047   :
    10048       run grplib-get-full-name in this-procedure (
    10049             input buf_gds-grp.node-code
    10050           , output v-full-name
    10051       ) no-error .
    10052       if error-status :error
    10053       then do:
    10054           undo, return error "create-new-line: Ошибка вычисления полного имени группы." .
    10055       end.
    10056       run grplib-get-sort-name in this-procedure (
    10057             input buf_gds-grp.node-code
    10058           , output v-sort-name
    10059       ) no-error .
    10060       if error-status :error
    10061       then do:
    10062           undo, return error "create-new-line: Ошибка вычисления полного имени группы." .
    10063       end.
    10064       run create-new-line in this-procedure (
    10065             input buf_gds-grp.node-code
    10066           , input buf_gds-grp.upper-code
    10067           , input 1
    10068           , input buf_gds-grp.is-term
    10069           , input buf_gds-grp.node-name
    10070           , input buf_gds-grp.increase-pc
    10071           , input buf_gds-grp.calc-method
    10072           , input "":U
    10073           , input "":U
    10074       ) no-error .
    10075       if error-status :error
    10076       then do:
    10077           message
    10078             vss-workfile vss-revision vss-description
    10079             skip "UI-on: Ошибка добавления строки в список групп."
    10080             skip return-value
    10081             skip trim(error-status :get-message(1))
    10082                  trim(error-status :get-message(2))
    10083                  trim(error-status :get-message(3))
    10084                  trim(error-status :get-message(4))
    10085                  trim(error-status :get-message(5))
    10086           view-as alert-box error.
    10087           undo, return error .
    10088       end.
    10089   end.
    10090   if  p-recid-list <> "" and p-recid-list <> ?
    10091   then do:
    10092       assign
    10093           v-reposition-row = 1
    10094           v-focused-row    = 1
    10095       .
    10096       find first buf_gds-grp no-lock
    10097            where recid( buf_gds-grp ) = integer( entry( num-entries( p-recid-list ), p-recid-list ) )
    10098       no-error .
    10099       if not available buf_gds-grp
    10100       then do:
    10101       end.
    10102       else do:
    10103           run expand-tree-for-grp in this-procedure (
    10104               input buf_gds-grp.node-code
    10105               , output v-focused-row
    10106               , output v-reposition-row
    10107               , output v-reposition-to-recid
    10108           ) no-error .
    10109           if error-status :error
    10110           then do:
    10111               undo, return error "UI-on: Не удалось раскрыть дерево групп." + chr(10) + return-value.
    10112           end.
    10113       end.
    10114   end.
    10115   run enable_UI.
    10116   hide
    10117           b-mark      in frame Dlg-grp
    10118        .
    10119   case p-button-list
    10120   :
    10121   when "buttons-for-move"
    10122   then do:
    10123       disable
    10124           b-exit    with frame Dlg-grp
    10125       .
    10126   end.
    10127   when "buttons-for-admin"
    10128   then do:
    10129   end.
    10130   when 'терм':U + ",b-scales"
    10131   then do:
    10132   end.
    10133   when 'терм':U + ",b-sel" or when "b-sel"
    10134   then do:
    10135   end.
    10136   when "b-sel,b-mark"
    10137   then do:
    10138       view
    10139           b-mark in frame Dlg-grp
    10140       .
    10141   end.
    10142   end case.
    10143   if v-current-store-code = 0
    10144   or transaction
    10145   then do:
    10146   end.
    10147   br-list :set-repositioned-row( v-focused-row, "ALWAYS" ) in frame Dlg-grp.
    10148   run recalc-marg-ass.
    10149   if v-reposition-to-recid = no
    10150   then do:
    10151       reposition br-list to row v-reposition-row.
    10152   end.
    10153   else do:
    10154       reposition br-list to recid v-reposition-row.
    10155   end.
    10156   RUN OpenBr(yes, no, '':U).
    10157   end.
    10158   END PROCEDURE.
    10159   PROCEDURE UI-on-0 :
    10160   do
    10161   on error undo, return error
    10162   :
    10163   define variable v-reposition-row        as integer          no-undo.
    10164   define variable v-focused-row           as integer          no-undo.
    10165   define variable v-reposition-to-recid   as logical init no  no-undo.
    10166   define variable v-enable-change-grp     as logical          no-undo.
    10167   define variable v-margins-range         as integer          no-undo.
    10168   define variable v-margins-exists        as logical          no-undo.
    10169   define variable v-increase-range         as integer          no-undo.
    10170   define variable v-increase-exists        as logical          no-undo.
    10171   define variable v-min-marg              as decimal          no-undo.
    10172   define variable v-max-marg              as decimal          no-undo.
    10173   define variable v-increase-pc              as decimal          no-undo.
    10174   define variable v-have-goods            as logical          no-undo.
    10175   define variable v-round-method      as character   no-undo .
    10176   define variable v-base                  as decimal no-undo .
    10177   define variable v-rmethod-range     as integer     no-undo.
    10178   define variable v-rmethod-exists    as logical     no-undo.
    10179   define variable v-cli-type          as character no-undo .
    10180   define variable v-cli-code          as integer     no-undo.
    10181   define variable v-income-cli-range    as integer  no-undo.
    10182   define variable v-income-cli-exists   as logical  no-undo.
    10183   define variable v-dop                   as character no-undo .
    10184   define variable v-full-name             as character    no-undo.
    10185   define variable v-sort-name             as character    no-undo.
    10186   define buffer buf_gds-grp           for ub.gds-grp.
    10187   define buffer buf_temp_grplib_grp   for temp_grplib_grp.
    10188   define variable vss-include-info59 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10189   do:
    10190     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    10191       (input  v-cntxt-db-num
    10192       ,input  v-cntxt-userid
    10193       ,input  0
    10194       ,input  'actn_reference_groups-edit':U
    10195       ,input  'firm':U
    10196       ,input  v-cntxt-host-code-obj
    10197       ,input  '':U
    10198       ,input  0
    10199       ,input  0
    10200       ,input  0
    10201       ,input  0
    10202       ,input  no
    10203       ,output v-enable-change-grp
    10204       )  .
    10205   end.
    10206   run grplib-get-root-code in this-procedure ( output v-root-code ) no-error.
    10207   if error-status :error
    10208   then do:
    10209       undo, return error "Не найден корневой узел." + chr(10) + return-value.
    10210   end.
    10211   if v-from-b-gds then do:
    10212     run uf-get in this-procedure(
    10213         input  'gds-grp-p':U
    10214         ,input  g#userid
    10215         ,output v-uf-List_
    10216         ,output v-uf-Naim
    10217         ,output v-uf-print-graft
    10218         ,output v-uf-sort-gr
    10219         ,output v-uf-type-price
    10220         ,output v-uf-type-val
    10221     )  no-error .
    10222     if not error-status:error then
    10223     assign
    10224     v-dop = string((if v-uf-List_ =  chr(63) then ? else integer(v-uf-LIst_)))
    10225     .
    10226     if v-dop = v-old-recid-list then do:
    10227       assign
    10228       gds-grp-row = v-old-recid
    10229       .
    10230     end.
    10231     else do:
    10232       assign
    10233       gds-grp-row = (if v-uf-List_ =  chr(63) then ? else integer(v-uf-LIst_))
    10234       .
    10235     end.
    10236     assign
    10237         p-recid-list = string( gds-grp-row )
    10238     .
    10239     assign
    10240     v-from-b-gds = no
    10241     v-old-recid-list = "":U.
    10242   end.
    10243   else do:
    10244     run uf-get in this-procedure(
    10245         input  'gds-grp-p':U
    10246         ,input  g#userid
    10247         ,output v-uf-List_
    10248         ,output v-uf-Naim
    10249         ,output v-uf-print-graft
    10250         ,output v-uf-sort-gr
    10251         ,output v-uf-type-price
    10252         ,output v-uf-type-val
    10253     )  no-error .
    10254     if not error-status:error then
    10255     assign
    10256     gds-grp-row = (if v-uf-List_ =  chr(63) then ? else integer(v-uf-LIst_))
    10257     .
    10258     assign
    10259         p-recid-list = string( gds-grp-row )
    10260     .
    10261   end.
    10262   find first buf_gds-grp no-lock
    10263        where buf_gds-grp.node-code = v-root-code
    10264   no-error .
    10265   if error-status :error
    10266   then do:
    10267       message
    10268         vss-workfile vss-revision vss-description
    10269         skip "Не найдена запись корневого узла."
    10270         skip return-value
    10271         skip trim(error-status :get-message(1))
    10272              trim(error-status :get-message(2))
    10273              trim(error-status :get-message(3))
    10274              trim(error-status :get-message(4))
    10275              trim(error-status :get-message(5))
    10276       view-as alert-box error.
    10277       undo, return error .
    10278   end.
    10279   if buf_gds-grp.is-term = yes
    10280   then do:
    10281       run grplib-have-goods in this-procedure (
    10282             input buf_gds-grp.node-code
    10283           , output v-have-goods
    10284       ) no-error .
    10285       if error-status :error
    10286       then do:
    10287           undo, return error "move-item: Ошибка определения наличия товаров в группе." + chr(10) + return-value.
    10288       end.
    10289   end.
    10290   for each buf_temp_grplib_grp
    10291   :
    10292       delete buf_temp_grplib_grp.
    10293   end.
    10294   create buf_temp_grplib_grp.
    10295   assign
    10296       buf_temp_grplib_grp.node-code   = buf_gds-grp.node-code
    10297       buf_temp_grplib_grp.upper-code  = buf_gds-grp.upper-code
    10298       buf_temp_grplib_grp.level       = 0
    10299       buf_temp_grplib_grp.mark        = ( if v-have-goods = yes then "•" else " " )
    10300       buf_temp_grplib_grp.full-name   = chr(4)
    10301       buf_temp_grplib_grp.sort-name   = chr(4)
    10302       buf_temp_grplib_grp.name        = buf_gds-grp.node-name
    10303       buf_temp_grplib_grp.increase-pc = buf_gds-grp.increase-pc
    10304       buf_temp_grplib_grp.calc-method = buf_gds-grp.calc-method
    10305   .
    10306   for each buf_gds-grp no-lock
    10307      where buf_gds-grp.upper-code = v-root-code
    10308   :
    10309       run grplib-get-full-name in this-procedure (
    10310             input buf_gds-grp.node-code
    10311           , output v-full-name
    10312       ) no-error .
    10313       if error-status :error
    10314       then do:
    10315           undo, return error "create-new-line: Ошибка вычисления полного имени группы." .
    10316       end.
    10317       run grplib-get-sort-name in this-procedure (
    10318             input buf_gds-grp.node-code
    10319           , output v-sort-name
    10320       ) no-error .
    10321       if error-status :error
    10322       then do:
    10323           undo, return error "create-new-line: Ошибка вычисления полного имени группы." .
    10324       end.
    10325       run create-new-line in this-procedure (
    10326             input buf_gds-grp.node-code
    10327           , input buf_gds-grp.upper-code
    10328           , input 1
    10329           , input buf_gds-grp.is-term
    10330           , input buf_gds-grp.node-name
    10331           , input buf_gds-grp.increase-pc
    10332           , input buf_gds-grp.calc-method
    10333           , input "":U
    10334           , input "":U
    10335       ) no-error .
    10336       if error-status :error
    10337       then do:
    10338           message
    10339             vss-workfile vss-revision vss-description
    10340             skip "UI-on: Ошибка добавления строки в список групп."
    10341             skip return-value
    10342             skip trim(error-status :get-message(1))
    10343                  trim(error-status :get-message(2))
    10344                  trim(error-status :get-message(3))
    10345                  trim(error-status :get-message(4))
    10346                  trim(error-status :get-message(5))
    10347           view-as alert-box error.
    10348           undo, return error .
    10349       end.
    10350   end.
    10351       assign
    10352           v-reposition-row = 1
    10353           v-focused-row    = 1
    10354       .
    10355       for each buf_gds-grp no-lock
    10356            :
    10357           run expand-tree-for-grp in this-procedure (
    10358               input buf_gds-grp.node-code
    10359               , output v-focused-row
    10360               , output v-reposition-row
    10361               , output v-reposition-to-recid
    10362           ) no-error .
    10363           if error-status :error
    10364           then do:
    10365               undo, return error "UI-on: Не удалось раскрыть дерево групп." + chr(10) + return-value.
    10366           end.
    10367       end.
    10368   run enable_UI.
    10369   display b-mark with frame Dlg-grp .
    10370   enable  b-mark with frame Dlg-grp .
    10371   if v-current-store-code = 0
    10372   or transaction
    10373   then do:
    10374   end.
    10375   br-list :set-repositioned-row( v-focused-row, "ALWAYS" ) in frame Dlg-grp.
    10376   run recalc-marg-ass.
    10377   if v-reposition-to-recid = no
    10378   then do:
    10379       reposition br-list to row v-reposition-row.
    10380   end.
    10381   else do:
    10382       reposition br-list to recid v-reposition-row.
    10383   end.
    10384   RUN OpenBr(yes, no, '':U).
    10385   end.
    10386   for each temp_grplib_grp :
    10387       find first temp_cons where temp_cons.node-code = temp_grplib_grp.node-code no-error .
    10388           if not available temp_cons then create temp_cons.
    10389           assign
    10390               temp_cons.full-name  = temp_grplib_grp.full-name
    10391               temp_cons.node-code  = temp_grplib_grp.node-code
    10392               temp_cons.upper-code = temp_grplib_grp.upper-code
    10393               temp_cons.min-marg   = temp_grplib_grp.min-marg
    10394               temp_cons.max-marg   = temp_grplib_grp.max-marg
    10395               temp_cons.cli-type   = temp_grplib_grp.cli-type
    10396           .
    10397   end.
    10398   run recalc-lim in this-procedure .
    10399   END PROCEDURE.
    10400   PROCEDURE ver-attr :
    10401   define buffer buf1_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
    10402   find first buf1_gds-grp-obj-attr no-lock where
    10403              buf1_gds-grp-obj-attr.attr-code = 'QntySpecGr':U and
    10404              buf1_gds-grp-obj-attr.obj-type  = string(p-contract-num) and
    10405              buf1_gds-grp-obj-attr.obj-code  = p-host-code and
    10406              buf1_gds-grp-obj-attr.host-code = 0 no-error .
    10407   if not available buf1_gds-grp-obj-attr then do:
    10408      run utl/uspemgrp.p ( input p-contract-num,input p-host-code ) no-error .
    10409      if error-status :error then message
    10410        vss-workfile vss-revision vss-description skip
    10411        error-status :get-message(1) skip
    10412        return-value skip
    10413        ""
    10414        view-as alert-box error
    10415      .
    10416   end.
    10417   END PROCEDURE.
