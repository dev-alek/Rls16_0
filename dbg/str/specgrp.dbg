     2699   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2700   procedure spedlass-proc :
     2701   define input  parameter parParentProc   as handle no-undo .
     2702   define input  parameter p-gds-code      as integer   no-undo .
     2703   define input  parameter p-contract-code as integer   no-undo .
     2704   define input  parameter p-host-code     as integer   no-undo .
     2705   define input  parameter p-ask           as logical   no-undo .
     2706   define input-output     parameter v-list-mat as character no-undo .
     2707   define input-output     parameter v-err-ext  as logical   no-undo .
     2708   define input-output     parameter v-longchar as longchar no-undo .
     2709   define buffer buf_contract-specif for ub.contract-specif  .
     2710   define buffer buf_contract        for ub.contract  .
     2711   define variable v-log as logical   no-undo .
     2712     do
     2713     on error undo, return error return-value
     2714     :
     2715   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2716   do:
     2717     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2718       (input  v-cntxt-db-num
     2719       ,input  v-cntxt-userid
     2720       ,input  0
     2721       ,input  'actn_assort-matr-gds_deletion':U
     2722       ,input  'global':U
     2723       ,input  0
     2724       ,input  '':U
     2725       ,input  0
     2726       ,input  0
     2727       ,input  0
     2728       ,input  0
     2729       ,input  false
     2730       ,output v-log
     2731       )  .
     2732   end.
     2733    if not v-log then return  .
     2734       for each buf_contract-specif  no-lock where
     2735                buf_contract-specif.gds-code = p-gds-code  and not
     2736              ( buf_contract-specif.contract-num  = p-contract-code and
     2737                buf_contract-specif.host-code     = p-host-code ) ,
     2738               first buf_contract no-lock where
     2739                     buf_contract.contract-code = buf_contract.contract-code and
     2740                     buf_contract.host-code     = buf_contract.host-code    and
     2741                     buf_contract.status_       =  'тек':U
     2742                       :
     2743                       return .
     2744       end.
     2745   define variable v-ass-m as logical   no-undo init false .
     2746   if can-find ( first ub.assortment-matrix no-lock where
     2747                       ub.assortment-matrix.asmt-status = integer ('0':U))
     2748                       then v-ass-m = true.
     2749   if p-ask then do:
     2750       if v-ass-m = true then do:
     2751         message "Удалить товары спецификации из Ассортиментных матриц ?"
     2752                 "Если ДА , укажите в каких."
     2753                 view-as alert-box question
     2754                         buttons yes-no
     2755                         update v-okk as logical
     2756                         .
     2757         if v-okk then do:
     2758             run ref/assmatr.w (
     2759                   input parParentProc
     2760                   ,input "b-sel,b-mark"
     2761                   ,input v-cntxt-obj-type
     2762                   ,input v-cntxt-obj-code
     2763                   ,input ?
     2764                   ,input ?
     2765                   ,input-output v-list-mat
     2766                   ) no-error  .
     2767             if error-status :error then message
     2768               vss-workfile vss-revision vss-description skip
     2769               error-status :get-message(1) skip
     2770               return-value skip
     2771               ""
     2772               view-as alert-box error
     2773             .
     2774         end.
     2775       end.
     2776   end.
     2777   if num-entries(v-list-mat) = 0 then return .
     2778   define buffer buf_gds-obj-prop          for ub.gds-obj-prop  .
     2779   define buffer buf_assortment-matrix     for ub.assortment-matrix  .
     2780   define buffer buf_assortment-matrix-goods for ub.assortment-matrix-goods  .
     2781   define variable i as integer   no-undo .
     2782   define variable v-sts as integer   no-undo .
     2783   repeat i = 1 to num-entries(v-list-mat) :
     2784     find first buf_assortment-matrix no-lock where
     2785                recid(buf_assortment-matrix) = int(entry(i,v-list-mat)) no-error .
     2786     for each buf_assortment-matrix-goods no-lock where
     2787              buf_assortment-matrix-goods.asmt-id  = buf_assortment-matrix.asmt-id and
     2788              buf_assortment-matrix-goods.db-num   = buf_assortment-matrix.db-num  and
     2789              buf_assortment-matrix-goods.gds-code = p-gds-code
     2790              :
     2791       for each buf_gds-obj-prop exclusive-lock where
     2792               buf_gds-obj-prop.obj-type = buf_assortment-matrix.obj-type and
     2793               buf_gds-obj-prop.obj-code = buf_assortment-matrix.obj-code and
     2794               buf_gds-obj-prop.gds-code = buf_assortment-matrix-goods.gds-code
     2795               :
     2796               if not (buf_gds-obj-prop.gdop-igt = 'Пусто':U or
     2797                       buf_gds-obj-prop.gdop-igt = 'На вывод из ассортимента':U ) then do:
     2798                 v-err-ext = true .
     2799                 v-longchar = v-longchar +
     2800                 substitute("Принудительная смена ИЖТ &1 на ПУСТО у товара &2 на объекте &3 &4&5" ,
     2801                   buf_gds-obj-prop.gdop-igt ,
     2802                   buf_gds-obj-prop.gds-code ,
     2803                   buf_assortment-matrix.obj-type ,
     2804                   buf_assortment-matrix.obj-code , chr(10) )   .
     2805               assign
     2806                 buf_gds-obj-prop.gdop-igt = 'Пусто':U
     2807                 .
     2808               end.
     2809       end.
     2810       release buf_gds-obj-prop .
     2811       if buf_assortment-matrix-goods.asmg-status = int('0':U) then do:
     2812           v-sts = int('1':U) .
     2813   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat2 in g#lib-Matrix
     2814    (input this-procedure
     2815    ,input recid(buf_assortment-matrix-goods)
     2816    ,input-output v-sts
     2817    ,input no
     2818     ) no-error .
     2819              if error-status :error then message
     2820                 error-status :get-message(1)
     2821                 return-value
     2822                 "Ошибка изменения статуса товара в ассортиментной матрице" skip
     2823                 buf_assortment-matrix-goods.asmg-status  v-sts
     2824                 .
     2825       end.
     2826     end.
     2827   end.
     2828   end.
