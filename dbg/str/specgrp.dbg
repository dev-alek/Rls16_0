     1374               when 'e-eslg-e':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Оперативный балансовый отчет движения нефтепродуктов"     p-tooltip = "Оперативный балансовый отчет движения нефтепродуктов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1375               when 'prphoto':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(2256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(2256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Прайс-лист с фото товаров"     p-tooltip = "Прайс-лист с фото товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1376               when 'chkgdsfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Товарная строка чека - доп поля"     p-tooltip = "Товарная строка чека - доп поля "     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1377               when 'chkdocfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Чек - доп поля"     p-tooltip = "Чек - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1378               when 'barcodfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Бар-код - доп поля"     p-tooltip = "Бар-код - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1379                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1380               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1381         otherwise do:
     1382           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
     1383         end.
     1384       end CASE.
     1385     end.
     1386   end procedure.
     1387   procedure uf-get :
     1388     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1389     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1390     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1391     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1392     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1393     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1394     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1395     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1396     do
     1397     on error undo, return error
     1398     :
     1399       define buffer buf_usr-flt for ubflt.usr-flt .
     1400       define variable v-use-List_     as logical   no-undo .
     1401       define variable v-type-List_     as character no-undo .
     1402       define variable v-format-List_   as character no-undo .
     1403       define variable v-use-Naim      as logical   no-undo .
     1404       define variable v-type-Naim      as character no-undo .
     1405       define variable v-format-Naim    as character no-undo .
     1406       define variable v-use-print-graft as logical   no-undo .
     1407       define variable v-use-sort-gr     as logical   no-undo .
     1408       define variable v-use-type-price  as logical   no-undo .
     1409       define variable v-use-type-val    as logical   no-undo .
     1410       define variable v-label          as character no-undo .
     1411       define variable v-tooltip        as character no-undo .
     1412       define variable v-user-can-edit  as logical   no-undo .
     1413       define variable v-output-display as logical   no-undo .
     1414       define variable v-other          as character no-undo .
     1415       run uf-name in this-procedure
     1416          (input  entry(1, p-code, chr(4))
     1417         ,output v-use-List_
     1418         ,output v-type-List_
     1419         ,output v-format-List_
     1420         ,output v-use-Naim
     1421         ,output v-type-Naim
     1422         ,output v-format-Naim
     1423         ,output v-use-print-graft
     1424         ,output v-use-sort-gr
     1425         ,output v-use-type-price
     1426         ,output v-use-type-val
     1427         ,output v-label
     1428         ,output v-tooltip
     1429         ,output v-user-can-edit
     1430         ,output v-output-display
     1431         ,output v-other
     1432         ) no-error .
     1433       if error-status :error then do:
     1434         undo, return error return-value .
     1435       end.
     1436       find first buf_usr-flt no-lock where
     1437                  buf_usr-flt.Call-point     = p-code AND
     1438                  buf_usr-flt.user-name       = p-user-name
     1439         no-error .
     1440       if avail buf_usr-flt then do:
     1441         assign
     1442         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1443         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1444         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1445         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1446         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1447         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1448         .
     1449       end.
     1450       else do:
     1451         assign
     1452         p-List_        = (if v-use-List_       then "":U                    else ?)
     1453         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1454         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1455         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1456         p-type-price   = (if v-use-type-price  then no                      else ?)
     1457         p-type-val     = (if v-use-List_       then no                      else ?)
     1458         .
     1459       end.
     1460     end.
     1461   end procedure.
     1462   procedure uf-set :
     1463     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1464     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1465     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1466     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1467     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1468     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1469     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1470     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1471     do
     1472     on error undo, return error
     1473     :
     1474       define buffer buf_usr-flt for ubflt.usr-flt .
     1475       define variable v-use-List_     as logical   no-undo .
     1476       define variable v-type-List_     as character no-undo .
     1477       define variable v-format-List_   as character no-undo .
     1478       define variable v-use-Naim      as logical   no-undo .
     1479       define variable v-type-Naim      as character no-undo .
     1480       define variable v-format-Naim    as character no-undo .
     1481       define variable v-use-print-graft as logical   no-undo .
     1482       define variable v-use-sort-gr   as logical   no-undo .
     1483       define variable v-use-type-price as logical   no-undo .
     1484       define variable v-use-type-val  as logical   no-undo .
     1485       define variable v-tooltip        as character no-undo .
     1486       define variable v-label          as character no-undo .
     1487       define variable v-user-can-edit  as logical   no-undo .
     1488       define variable v-output-display as logical   no-undo .
     1489       define variable v-other          as character no-undo .
     1490       run uf-name in this-procedure
     1491         (input  entry(1, p-code, chr(4))
     1492         ,output v-use-List_
     1493         ,output v-type-List_
     1494         ,output v-format-List_
     1495         ,output v-use-Naim
     1496         ,output v-type-Naim
     1497         ,output v-format-Naim
     1498         ,output v-use-print-graft
     1499         ,output v-use-sort-gr
     1500         ,output v-use-type-price
     1501         ,output v-use-type-val
     1502         ,output v-label
     1503         ,output v-tooltip
     1504         ,output v-user-can-edit
     1505         ,output v-output-display
     1506         ,output v-other
     1507         ) no-error .
     1508       if error-status :error then do:
     1509         undo, return error return-value .
     1510       end.
     1511       find first buf_usr-flt where
     1512                  buf_usr-flt.Call-point     = p-code AND
     1513                  buf_usr-flt.user-name       = p-user-name
     1514         no-error .
     1515       if not avail buf_usr-flt then do:
     1516           create buf_usr-flt .
     1517           assign
     1518           buf_usr-flt.call-point = p-code
     1519           buf_usr-flt.user-name  = p-user-name
     1520           .
     1521       end.
     1522       if avail buf_usr-flt then do:
     1523        assign
     1524        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1525        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1526        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1527        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1528        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1529        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1530       .
     1531       release buf_usr-flt.
     1532       end.
     1533       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1534     end.
     1535   end procedure.
     1536   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1537   procedure grp-attr-name :
     1538   do
     1539     on error undo, return error
     1540     :
     1541     define input  parameter p-code           as character no-undo .
     1542     define output parameter p-type           as character no-undo .
     1543     define output parameter p-format         as character no-undo .
     1544     define output parameter p-label          as character no-undo .
     1545     define output parameter p-user-can-edit  as logical   no-undo .
     1546     define output parameter p-output-display as logical   no-undo .
     1547     define output parameter p-other          as character no-undo .
     1548       case p-code :
     1549               when 'gds-grp-nabor':U then do:     assign     p-label = "Набор"     p-type = 'L':U      p-format = "yes/no"     p-label = "Набор"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     1550         otherwise do:
     1551           undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
     1552         end.
     1553       end.
     1554     end.
     1555   end procedure.
     1556   procedure grp-attr-tooltip :
     1557   do
     1558     on error undo, return error
     1559     :
     1560       define input  parameter p-code    as character no-undo .
     1561       define output parameter p-tooltip as character no-undo .
     1562       define output parameter p-label   as character no-undo .
     1563       case p-code :
     1564               when 'gds-grp-nabor':U then do:     assign     p-tooltip = "Набор - не товарные позиции"     p-label = "Набор" .   end.
     1565         otherwise do:
     1566               undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
     1567         end.
     1568       end.
     1569     end.
     1570   end procedure.
     1571   procedure grp-attr-value :
     1572   do
     1573   on error undo, return error
     1574   :
     1575   define input  parameter p-node-code   as integer    no-undo.
     1576   define input  parameter p-code        as character  no-undo.
     1577   define input  parameter p-host-code   as integer    no-undo.
     1578   define input  parameter p-obj-type    as character  no-undo.
     1579   define input  parameter p-obj-code    as integer    no-undo.
     1580   define output parameter p-value       as character  no-undo.
     1581   define output parameter p-type        as character  no-undo.
     1582       define variable v-format         as character no-undo .
     1583       define variable v-label          as character no-undo .
     1584       define variable v-user-can-edit  as logical   no-undo .
     1585       define variable v-output-display as logical   no-undo .
     1586       define variable v-other          as character no-undo .
     1587       define buffer buf_gds-grp-attr for ub.gds-grp-attr.
     1588       run grp-attr-name in this-procedure (
     1589             input  p-code
     1590           , output p-type
     1591           , output v-format
     1592           , output v-label
     1593           , output v-user-can-edit
     1594           , output v-output-display
     1595           , output v-other
     1596       ) no-error .
     1597       if error-status :error
     1598       then do:
     1599           undo, return error return-value .
     1600       end.
     1601       find first buf_gds-grp-attr no-lock
     1602            where buf_gds-grp-attr.node-code = p-node-code
     1603              and buf_gds-grp-attr.attr-code = p-code
     1604              and buf_gds-grp-attr.host-code = p-host-code
     1605              and buf_gds-grp-attr.obj-type  = p-obj-type
     1606              and buf_gds-grp-attr.obj-code  = p-obj-code
     1607       no-error .
     1608       if available buf_gds-grp-attr
     1609       then do:
     1610           assign
     1611               p-value = buf_gds-grp-attr.attr-value
     1612           .
     1613       end.
     1614       else do:
     1615           assign
     1616               p-value = if p-type = 'L':U then "no":U else ""
     1617           .
     1618       end.
     1619   end.
     1620   end procedure.
     1621   procedure grp-attr-write :
     1622   do
     1623   on error undo, return error
     1624   :
     1625   define input parameter p-node-code  like ub.gds-grp-attr.node-code      no-undo.
     1626   define input parameter p-code       like ub.gds-grp-attr.attr-code      no-undo.
     1627   define input parameter p-host-code  as integer                          no-undo.
     1628   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
     1629   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
     1630   define input parameter p-value      like ub.gds-grp-attr.attr-value     no-undo.
     1631       define variable v-type              as character                no-undo.
     1632       define variable v-format            as character                no-undo.
     1633       define variable v-label             as character                no-undo.
     1634       define variable v-user-can-edit     as logical                  no-undo.
     1635       define variable v-output-display    as logical                  no-undo.
     1636       define variable v-other             as character                no-undo.
     1637       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
     1638       run grp-attr-name in this-procedure (
     1639                         input  p-code
     1640                       , output v-type
     1641                       , output v-format
     1642                       , output v-label
     1643                       , output v-user-can-edit
     1644                       , output v-output-display
     1645                       , output v-other
     1646       ) no-error.
     1647       if error-status :error
     1648       then do:
     1649           undo, return error return-value.
     1650       end.
     1651       find first buf_gds-grp-attr exclusive-lock
     1652            where buf_gds-grp-attr.node-code  = p-node-code
     1653              and buf_gds-grp-attr.attr-code  = p-code
     1654              and buf_gds-grp-attr.host-code  = p-host-code
     1655              and buf_gds-grp-attr.obj-type   = p-obj-type
     1656              and buf_gds-grp-attr.obj-code   = p-obj-code
     1657       no-error.
     1658       if not available buf_gds-grp-attr
     1659       then do:
     1660           create buf_gds-grp-attr.
     1661           assign
     1662                   buf_gds-grp-attr.node-code  = p-node-code
     1663                   buf_gds-grp-attr.attr-code  = p-code
     1664                   buf_gds-grp-attr.host-code  = p-host-code
     1665                   buf_gds-grp-attr.obj-type   = p-obj-type
     1666                   buf_gds-grp-attr.obj-code   = p-obj-code
     1667                   buf_gds-grp-attr.attr-value = p-value
     1668           .
     1669       end.
     1670       else do:
     1671           assign
     1672               buf_gds-grp-attr.attr-value = p-value
     1673           .
     1674       end.
     1675   end.
     1676   end procedure.
     1677   procedure grp-attr-delete :
     1678   do
     1679   on error undo, return error
     1680   :
     1681   define input parameter p-node-code  like ub.gds-grp-attr.node-code  no-undo.
     1682   define input parameter p-code       like ub.gds-grp-attr.attr-code  no-undo.
     1683   define input parameter p-host-code  as integer                      no-undo.
     1684   define input parameter p-obj-type   like ub.clients.obj-type        no-undo.
     1685   define input parameter p-obj-code   like ub.clients.obj-code        no-undo.
     1686   define output parameter p-deleted   as logical                      no-undo.
     1687       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
     1688       define variable v-type              as character                no-undo.
     1689       define variable v-format            as character                no-undo.
     1690       define variable v-label             as character                no-undo.
     1691       define variable v-user-can-edit     as logical                  no-undo.
     1692       define variable v-output-display    as logical                  no-undo.
     1693       define variable v-other             as character                no-undo.
     1694       run grp-attr-name in this-procedure
     1695       ( input  p-code
     1696       , output v-type
     1697       , output v-format
     1698       , output v-label
     1699       , output v-user-can-edit
     1700       , output v-output-display
     1701       , output v-other
     1702       ) no-error .
     1703       if error-status :error then do:
     1704           undo, return error return-value .
     1705       end.
     1706       find first buf_gds-grp-attr exclusive-lock
     1707            where buf_gds-grp-attr.node-code  = p-node-code
     1708              and buf_gds-grp-attr.attr-code  = p-code
     1709              and buf_gds-grp-attr.host-code  = p-host-code
     1710              and buf_gds-grp-attr.obj-type   = p-obj-type
     1711              and buf_gds-grp-attr.obj-code   = p-obj-code
     1712       no-error.
     1713       if not available buf_gds-grp-attr
     1714       then do:
     1715           assign
     1716               p-deleted = no
     1717           .
     1718       end.
     1719       else do:
     1720          delete buf_gds-grp-attr.
     1721          assign
     1722               p-deleted = yes
     1723           .
     1724       end.
     1725   end.
     1726   end procedure.
     1727   procedure grp-attr-news :
     1728   do
     1729   on error undo, return error
     1730   :
     1731       define input  parameter p-code           as character no-undo .
     1732       define output parameter p-news           as logical   no-undo .
     1733       case p-code :
     1734               when 'gds-grp-nabor':U then do:     assign     p-news = true.   end.
     1735         otherwise do:
     1736           undo, return error "неизвестный атрибут товара на фирме" + " " + p-code .
     1737         end.
     1738       end.
     1739   end.
     1740   end procedure.
     1741   procedure grp-attr-obj-value :
     1742   do
     1743   on error undo, return error
     1744   :
     1745   define input parameter p-node-code as integer      no-undo.
     1746   define input parameter p-obj-type  as character    no-undo.
     1747   define input parameter p-obj-code  as integer      no-undo.
     1748   define input parameter p-attr-code as character    no-undo .
     1749   define output parameter p-attr-value     as character   no-undo.
     1750   define output parameter p-range     as integer      no-undo.
     1751   define output parameter p-exists    as logical      no-undo.
     1752   define variable v-host-code as integer      no-undo.
     1753   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1754   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1755     (input  p-obj-type
     1756     ,input  p-obj-code
     1757     ,output v-host-code
     1758     ) no-error .
     1759   if error-status :error
     1760   then do:
     1761       message
     1762         vss-workfile vss-revision vss-description
     1763         skip "Не удалось найти фирму объекта"
     1764         skip p-obj-type p-obj-code
     1765         skip return-value
     1766         skip trim(error-status :get-message(1))
     1767              trim(error-status :get-message(2))
     1768              trim(error-status :get-message(3))
     1769              trim(error-status :get-message(4))
     1770              trim(error-status :get-message(5))
     1771       view-as alert-box error.
     1772       undo, return error .
     1773   end.
     1774   define buffer buf_gds-grp-attr      for ub.gds-grp-attr.
     1775   find first buf_gds-grp-attr no-lock
     1776        where buf_gds-grp-attr.node-code = p-node-code
     1777          and buf_gds-grp-attr.attr-code = p-attr-code
     1778          and buf_gds-grp-attr.host-code = v-host-code
     1779          and buf_gds-grp-attr.obj-type  = p-obj-type
     1780          and buf_gds-grp-attr.obj-code  = p-obj-code
     1781   no-error .
     1782   if not available buf_gds-grp-attr
     1783   then do:
     1784       find first buf_gds-grp-attr no-lock
     1785            where buf_gds-grp-attr.node-code = p-node-code
     1786              and buf_gds-grp-attr.attr-code = p-attr-code
     1787              and buf_gds-grp-attr.host-code = v-host-code
     1788              and buf_gds-grp-attr.obj-type  = ""
     1789              and buf_gds-grp-attr.obj-code  = 0
     1790       no-error .
     1791       if not available buf_gds-grp-attr
     1792       then do:
     1793           find first buf_gds-grp-attr no-lock
     1794               where buf_gds-grp-attr.node-code = p-node-code
     1795               and buf_gds-grp-attr.attr-code = p-attr-code
     1796               and buf_gds-grp-attr.host-code = 0
     1797               and buf_gds-grp-attr.obj-type  = ""
     1798               and buf_gds-grp-attr.obj-code  = 0
     1799           no-error .
     1800           if not available buf_gds-grp-attr
     1801           then do:
     1802               assign
     1803                   p-exists = no
     1804               .
     1805           end.
     1806           else do:
     1807               assign
     1808                   p-exists = yes
     1809                   p-range  = 1
     1810               .
     1811           end.
     1812       end.
     1813       else do:
     1814           assign
     1815               p-exists = yes
     1816               p-range  = 2
     1817           .
     1818       end.
     1819   end.
     1820   else do:
     1821       assign
     1822           p-exists = yes
     1823           p-range  = 3
     1824       .
     1825   end.
     1826   if available buf_gds-grp-attr
     1827   then do:
     1828     assign
     1829     p-attr-value = buf_gds-grp-attr.attr-value
     1830     .
     1831   end.
     1832   end.
     1833   end procedure.
     1834   procedure ver-gds-grp-nabor :
     1835   do
     1836   on error undo, return error return-value
     1837   :
     1838   define input  parameter p-gds-code as integer   no-undo .
     1839   define output parameter p-nabor as logical   no-undo .
     1840   define buffer buf_goods for ub.goods.
     1841   p-nabor = false .
     1842   find first  buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     1843   if error-status :error then return error .
     1844   define variable v-value       as character  no-undo.
     1845   define variable v-type        as character  no-undo.
     1846     run grp-attr-value (
     1847        input   buf_goods.grp-code
     1848       ,input   'gds-grp-nabor':U
     1849       ,input   0
     1850       ,input   ""
     1851       ,input   0
     1852       ,output  v-value
     1853       ,output  v-type       ) no-error .
     1854       if error-status :error then return error .
     1855     if v-value = "yes" then p-nabor = true  .
     1856   end.
     1857   end procedure.
     1858   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1859   define  stream PrnLibStream.
     1860   procedure prn-lib-prn-file :
     1861     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1862     define input parameter p-DIsabledoptions as integer no-undo .
     1863     define variable v-report-name as character no-undo .
     1864     define variable v-user-action as character no-undo .
     1865     define variable v-printed     as logical   no-undo .
     1866     define variable v-exist       as logical   no-undo .
     1867     do
     1868       on error undo, return error
     1869       :
     1870       run prn-lib-get-report-name  in this-procedure (
     1871         input parParentProc
     1872         ,output v-report-name
     1873         ).
     1874   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1875   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1876     (input  v-report-name
     1877     ,input  2
     1878     ,output v-exist
     1879     )  .
     1880       if NOT v-exist then
     1881       DO:
     1882         Message
     1883           "Нет заданий на печать ! "
     1884           view-as alert-box .
     1885         Return  .
     1886       End.
     1887       run gbl/prnfilen.w
     1888         (input  ""
     1889         ,input  p-DisabledOptions
     1890         ,input  string(v-report-name )
     1891         ,input  7
     1892         ,output v-user-action
     1893         ,output v-printed
     1894         ) .
     1895       if v-printed then
     1896       do:
     1897         return "YES" .
     1898       end.
     1899       else
     1900       do:
     1901         return "NO" .
     1902       end.
     1903     end.
     1904   end procedure.
     1905   procedure prn-lib-open-stream :
     1906     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1907     define input parameter p-page-size    as integer no-undo .
     1908     define input parameter p-is-stream    as logical no-undo .
     1909     define input parameter p-append       as logical no-undo .
     1910     define variable v-report-name as character no-undo .
     1911     do
     1912       on error undo, return error
     1913       :
     1914       run prn-lib-get-report-name  in this-procedure (
     1915         input parParentProc
     1916         ,output v-report-name
     1917         ).
     1918       if p-is-stream then
     1919       do:
     1920         if p-append then
     1921         do:
     1922           output stream PrnLibStream to value( v-report-name )
     1923             page-size value(p-page-size) append .
     1924         end.
     1925         if not p-append then
     1926         do:
     1927           output stream PrnLibStream to value( v-report-name )
     1928             page-size value(p-page-size) .
     1929         end.
     1930       end.
     1931       if not p-is-stream then
     1932       do:
     1933         if p-append then
     1934         do:
     1935           output to value( v-report-name )
     1936             page-size value(p-page-size) append .
     1937         end.
     1938         if not p-append then
     1939         do:
     1940           output to value( v-report-name )
     1941             page-size value(p-page-size) .
     1942         end.
     1943       end.
     1944     end.
     1945   end procedure.
     1946   procedure prn-lib-open-exp :
     1947     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1948     define input parameter p-is-stream    as logical no-undo .
     1949     define input parameter p-is-append    as logical no-undo .
     1950     define output parameter p-ReportFileName as char init "report" no-undo.
     1951     define output parameter p-process as logical no-undo .
     1952     define variable glog as logical no-undo .
     1953     do
     1954       on error undo, return error
     1955       :
     1956       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1957         TITLE      "Укажите путь"
     1958         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1959         ASK-OVERWRITE
     1960         CREATE-TEST-FILE
     1961         SAVE-AS
     1962         USE-FILENAME
     1963         DEFAULT-EXTENSION "txt"
     1964         UPDATE glog
     1965         .
     1966       if not glog then  return.
     1967       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1968       if p-is-stream then
     1969       do:
     1970         if p-is-append then
     1971         do:
     1972           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1973         end.
     1974         else
     1975         do:
     1976           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1977         end.
     1978       end.
     1979       else
     1980       do:
     1981         if p-is-append then
     1982         do:
     1983           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1984         end.
     1985         else
     1986         do:
     1987           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1988         end.
     1989       end.
     1990       p-process = yes.
     1991     end.
     1992   end procedure.
     1993   procedure prn-lib-get-report-name :
