     4597                          , input buf_contract-specif.gds-name
     4598                          , input buf_contract-specif.unit-base
     4599                          , input-output v-price
     4600                          , input-output v-prc
     4601                          , input-output v-prc-2
     4602                          , input-output v-vat-type
     4603                          , input-output v-qnty
