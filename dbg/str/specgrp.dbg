     2831   PROCEDURE write-bonus :
     2832   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2833   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2834   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2835   define input  parameter v-bonus as decimal   no-undo .
     2836     do
     2837     on error undo, return error return-value
     2838     :
     2839       find first ub.contract-specif-attr exclusive-lock  where
     2840                  ub.contract-specif-attr.contract-num = p-contract-num  and
     2841                  ub.contract-specif-attr.host-code    = p-host-code     and
     2842                  ub.contract-specif-attr.gds-code     = p-gds-code      and
     2843                  ub.contract-specif-attr.attr-code    = 'bonus':U
     2844                 no-error .
     2845         if not available ub.contract-specif-attr then do:
     2846            create ub.contract-specif-attr .
     2847            assign
     2848                 ub.contract-specif-attr.contract-num = p-contract-num
     2849                 ub.contract-specif-attr.host-code    = p-host-code
     2850                 ub.contract-specif-attr.gds-code     = p-gds-code
     2851                 ub.contract-specif-attr.attr-code    = 'bonus':U
     2852            .
     2853         end.
     2854         ub.contract-specif-attr.attr-value  = string (v-bonus) .
     2855   end.
     2856   END PROCEDURE.
