     4952   END.
     4953   ON CHOOSE OF b-find-by-substring IN FRAME Dlg-grp
     4954   DO:
     4955       define variable v-new-name      as character    no-undo.
     4956       define variable v-new-code      as integer      no-undo.
     4957       define variable v-err-message   as character    no-undo.
     4958       if v-full-search-next = no
     4959       then do:
     4960           assign
     4961               v-full-search-string     = fi-search :screen-value
     4962               v-full-search-next       = yes
     4963               v-full-search-start-code = 0
     4964           .
     4965       end.
     4966       run grplib-analyze-grp-name in this-procedure (
     4967             input v-full-search-string
     4968           , input -1
     4969           , output v-err-message
     4970       ).
     4971       if v-err-message = "":U
