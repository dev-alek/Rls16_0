     4771       find first temp_cons where temp_cons.node-code = temp_grplib_grp.node-code no-error .
     4772           if available temp_cons then do:
     4773           if temp_cons.max-marg <>  temp_grplib_grp.max-marg then do:
     4774           assign
     4775               temp_cons.full-name  = temp_grplib_grp.full-name
     4776               temp_cons.node-code  = temp_grplib_grp.node-code
     4777               temp_cons.upper-code = temp_grplib_grp.upper-code
     4778               temp_cons.min-marg   = temp_grplib_grp.min-marg
     4779               temp_cons.max-marg   = temp_grplib_grp.max-marg
     4780               temp_cons.cli-type   = temp_grplib_grp.cli-type
     4781           .
     4782           end.
     4783           end.
     4784   end.
     4785   define variable  v-str as character no-undo .
     4786   define variable v-i as integer   no-undo .
     4787   v-str = "".
     4788   v-i =0.
     4789   for each temp_cons where int(temp_cons.cli-type) < int(temp_cons.min-marg)
     4790    and int(temp_cons.cli-type) <> ?
     4791    and temp_cons.cli-type <> ""
     4792    and int(temp_cons.min-marg) <> ?
     4793   :
     4794     v-i = v-i + 1.
     4795     v-str = v-str + trim(temp_cons.full-name) + " ограничение : " + temp_cons.cli-type + " (должно быть >= " + temp_cons.min-marg + ")" + chr(10) .
     4796   end.
     4797   for each temp_cons where int(temp_cons.cli-type) < int(temp_cons.max-marg)
     4798    and int(temp_cons.cli-type) <> ?
     4799    and temp_cons.cli-type <> ""
     4800    and int(temp_cons.max-marg) <> ?
     4801   :
     4802     v-i = v-i + 1.
     4803     v-str = v-str + trim(temp_cons.full-name) + " ограничение : " + temp_cons.cli-type + " (а товара в группе " + temp_cons.max-marg + " !)" + chr(10) .
     4804   end.
     4805   if v-i <> 0 then do:
     4806       message "Внимание ! Ограничения по Спецификации назначены некорректно !!!" view-as alert-box error .
     4807       run gbl/notes.w ('ПРОСМОТР':U,input-output v-str) .
     4808       return no-apply .
     4809   end.
     4810   find first temp_grplib_grp no-error .
     4811       define variable v-gds-grp-recid     as recid             no-undo.
     4812       run get-current-recid in this-procedure (
     4813             input temp_grplib_grp.node-code
     4814           , output v-gds-grp-recid
     4815       ) no-error .
     4816       if error-status :error
     4817       then do:
     4818           message
     4819             vss-workfile vss-revision vss-description
     4820             skip "Не найдена группа для восстановления"
     4821             skip "предыдущего состояния справочника групп."
     4822             skip return-value
     4823             skip trim(error-status :get-message(1))
     4824                  trim(error-status :get-message(2))
     4825                  trim(error-status :get-message(3))
     4826                  trim(error-status :get-message(4))
     4827                  trim(error-status :get-message(5))
     4828           view-as alert-box error.
     4829           undo, return no-apply .
     4830       end.
     4831       assign
     4832           gds-grp-row  = v-gds-grp-recid
     4833           p-recid-list = ""
     4834       .
     4835       assign
     4836       v-uf-List_ = (if gds-grp-row = ? then chr(63) else string(gds-grp-row))
     4837       .
