     4454            input-output v-unit-cli-rcv,
     4455            input-output v-cli-base-rate-rcv,
     4456            input-output v-bonus,
     4457            input-output v-retro-bonus,
     4458   output v-res ) .
     4459       if v-res then do:
     4460         do transaction :
     4461           for each temp-conn :
     4462             find first ub.contract-specif exclusive-lock where recid(ub.contract-specif) = temp-conn.ri .
     4463           if v-cli-base-rate <> ? then do:
     4464               find first buf_goods no-lock where buf_goods.gds-code = ub.contract-specif.gds-code .
     4465               if v-cli-base-rate <> buf_goods.cli-base-rate and
     4466                        v-unit-cli = buf_goods.unit-base then do:
