     2086   procedure fltopend_fltopend :
     2087   define input parameter p-parent-handle as handle no-undo .
     2088   define input parameter p-qh as handle no-undo .
     2089   define input parameter p-flt-open-open-query  as character no-undo .
     2090   define input parameter p-where-cond as character no-undo .
     2091   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2092   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2093   define input parameter p-indexed-reposition as character no-undo .
     2094     do
     2095     on error undo, return error
     2096     :
     2097   define variable v-prepare-string as character no-undo .
     2098   define variable glog as logical no-undo .
     2099   assign
     2100   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2101                      p-where-cond + chr(32)  +
     2102                      p-use-indFIRST-query-tail + chr(32) +
     2103                      p-use-ind-sort-clmn-by + chr(32) +
     2104                      p-indexed-reposition
     2105   .
     2106   assign
     2107   glog = p-qh:query-prepare(v-prepare-string) no-error .
     2108   if not glog
     2109   or error-status:error then do:
     2110     message error-status:get-message(1) view-as alert-box .
     2111     undo, return error .
     2112   end.
     2113   assign
     2114   glog = p-qh:query-open no-error .
     2115   if not glog
     2116   or error-status:error then do:
     2117     message error-status:get-message(1) view-as alert-box .
     2118     undo, return error .
     2119   end.
     2120     end.
     2121   end procedure.
     2122   procedure fltopend_fltfindd :
     2123   define input parameter p-parent-handle as handle no-undo .
     2124   define input parameter p-qh as handle no-undo .
     2125   define input parameter p-rowid as rowid no-undo .
     2126   define input parameter p-next as logical no-undo .
     2127   define input parameter p-lock as integer no-undo .
     2128   define input parameter p-bh as handle no-undo .
     2129   define input parameter p-where-cond as character no-undo .
     2130   define input parameter p-use-index-phrase as character no-undo .
     2131   define variable glog as logical no-undo .
     2132   define variable v-qh as handle no-undo .
     2133   define variable v-bh as handle no-undo .
     2134   define variable v-recid as recid no-undo .
     2135   define variable v-prepare-string as character no-undo .
     2136   do
     2137   on error undo, return error
     2138   on stop undo, return error
     2139   :
     2140     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     2141     create buffer v-bh for table p-bh buffer-name p-bh:name.
     2142     create query v-qh.
     2143     v-qh:set-buffers(v-bh).
     2144     v-prepare-string = substitute("for each &1 &2 &3"
     2145                                     ,v-bh:name
     2146                                     ,p-where-cond
     2147                                     ,p-use-index-phrase).
     2148     glog = v-qh:query-prepare(v-prepare-string) no-error.
     2149     if not glog then do:
     2150       delete object v-qh.
     2151       delete object v-bh.
     2152       undo, return error .
     2153     end.
     2154     glog = v-qh:query-open no-error .
     2155     if not glog then do:
     2156       delete object v-qh.
     2157       delete object v-bh.
     2158       undo, return error .
     2159     end.
     2160     if p-next then do:
     2161       v-qh:reposition-to-rowid(p-rowid) no-error .
     2162       glog = v-qh:get-next( p-lock) no-error .
     2163       glog = v-qh:get-next( p-lock) no-error .
     2164       if not glog or v-qh:query-off-end = yes then do:
     2165         glog = v-qh:get-first( p-lock) no-error .
     2166       end.
     2167     end.
     2168     else do:
     2169       glog = v-qh:get-first( p-lock) no-error .
     2170     end.
     2171     v-recid = v-bh:recid no-error .
     2172     delete object v-qh.
     2173     delete object v-bh.
     2174     return string(v-recid) .
     2175   end.
     2176   end procedure.
     2177   procedure fltopend_fltfindq :
     2178   define input parameter p-parent-handle as handle no-undo .
     2179   define input parameter p-qh as handle no-undo .
     2180   define input parameter p-next as logical no-undo .
     2181   define input parameter p-lock as integer no-undo .
     2182   define input parameter p-flt-open-open-query  as character no-undo .
     2183   define input parameter p-where-cond as character no-undo .
     2184   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2185   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2186   define input parameter p-indexed-reposition as character no-undo .
     2187   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     2188   define variable glog as logical no-undo .
     2189   define variable v-qh as handle no-undo .
     2190   define variable v-bh as handle no-undo extent 18.
     2191   define variable v-rowid as rowid no-undo extent 18.
     2192   define variable v-ii as integer no-undo .
     2193   define variable v-prepare-string as character no-undo .
     2194   do
     2195   on error undo, return error
     2196   on stop undo, return error
     2197   :
     2198     create query v-qh.
     2199     do v-ii = 1 to p-qh:num-buffers:
     2200       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     2201       assign
     2202       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     2203       no-error.
     2204       v-qh:add-buffer(v-bh[v-ii]).
     2205     end.
     2206     assign
     2207     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2208                       p-where-cond + chr(32)  +
     2209                       p-use-indFIRST-query-tail + chr(32) +
     2210                       p-use-ind-sort-clmn-by + chr(32) +
     2211                       p-indexed-reposition
     2212     .
     2213     glog = v-qh:query-prepare( v-prepare-string) no-error .
     2214     if not glog then do:
     2215       delete object v-qh.
     2216       do v-ii = 1 to p-qh:num-buffers:
     2217         delete object v-bh[v-ii].
     2218       end.
     2219       undo, return error .
     2220     end.
     2221     glog = v-qh:query-open no-error .
     2222     if not glog then do:
     2223       delete object v-qh.
     2224       do v-ii = 1 to p-qh:num-buffers:
     2225         delete object v-bh[v-ii].
     2226       end.
     2227       undo, return error .
     2228     end.
     2229     if p-next then do:
     2230       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     2231       glog = v-qh:get-next( p-lock) no-error .
     2232       glog = v-qh:get-next( p-lock) no-error .
     2233       if not glog or v-qh:query-off-end = yes then do:
     2234         glog = v-qh:get-first( p-lock) no-error .
     2235       end.
     2236     end.
     2237     else do:
     2238       glog = v-qh:get-first( p-lock) no-error .
     2239     end.
     2240     do v-ii = 1 to p-qh:num-buffers:
     2241       assign
     2242       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     2243       no-error.
     2244     end.
     2245     delete object v-qh.
     2246     do v-ii = 1 to p-qh:num-buffers:
     2247       delete object v-bh[v-ii].
     2248     end.
     2249   end.
     2250   end procedure.
     2251   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2252   procedure integerm :
     2253     define input  parameter p-string      as character no-undo .
     2254     define input  parameter p-allow-sign  as logical   no-undo .
     2255     define input  parameter p-allow-comma as logical   no-undo .
     2256     define output parameter p-value       as integer   no-undo .
     2257     define output parameter p-data-valid  as logical   no-undo .
     2258     define output parameter p-message     as character no-undo .
     2259     define variable v-replace-string as character no-undo .
     2260     do
     2261     on error undo, return error return-value
     2262     :
     2263       if p-string = ?
     2264       then do:
     2265         assign
     2266           p-value      = ?
     2267           p-data-valid = false
     2268           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
     2269         .
     2270         return .
     2271       end.
     2272       if p-string = ""
     2273       then do:
     2274         assign
     2275           p-value      = ?
     2276           p-data-valid = false
     2277           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
     2278         .
     2279         return .
     2280       end.
     2281       assign
     2282         p-value = integer(p-string) no-error
     2283       .
     2284       if error-status :error = true
     2285       then do:
     2286         assign
     2287           p-value      = ?
     2288           p-data-valid = false
     2289           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
     2290                                    ,p-string
     2291                                    )
     2292         .
     2293         return .
     2294       end.
     2295       if index(p-string, ' ':u) > 0
     2296       then do:
     2297         assign
     2298           p-value      = ?
     2299           p-data-valid = false
     2300           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
     2301                                    + "Строка содержит символы пробела"
     2302                                    ,p-string
     2303                                    )
     2304         .
     2305         return .
     2306       end.
     2307       assign
     2308         v-replace-string = p-string
     2309         v-replace-string = replace(v-replace-string, '0':u, '9':u)
     2310         v-replace-string = replace(v-replace-string, '1':u, '9':u)
     2311         v-replace-string = replace(v-replace-string, '2':u, '9':u)
     2312         v-replace-string = replace(v-replace-string, '3':u, '9':u)
     2313         v-replace-string = replace(v-replace-string, '4':u, '9':u)
     2314         v-replace-string = replace(v-replace-string, '5':u, '9':u)
     2315         v-replace-string = replace(v-replace-string, '6':u, '9':u)
     2316         v-replace-string = replace(v-replace-string, '7':u, '9':u)
     2317         v-replace-string = replace(v-replace-string, '8':u, '9':u)
     2318       .
     2319       if p-allow-sign = true
     2320       then do:
     2321         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
     2322         then do:
     2323           assign
     2324             v-replace-string = substring(v-replace-string, 2)
     2325           .
     2326         end.
     2327       end.
     2328       else do:
     2329         if substring(v-replace-string, 1, 1) = '+':u
     2330         then do:
     2331           assign
     2332             p-value      = ?
     2333             p-data-valid = false
     2334             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
     2335                                     + "Задан параметр недопустимости знака челого числа. "
     2336                                     + "Строка содержит символ плюс. "
     2337                                     ,p-string
     2338                                     )
     2339           .
     2340           return .
     2341         end.
     2342         if substring(v-replace-string, 1, 1) = '-':u
     2343         then do:
     2344           assign
     2345             p-value      = ?
     2346             p-data-valid = false
     2347             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
     2348                                     + "Задан параметр недопустимости знака челого числа. "
     2349                                     + "Строка содержит символ минус. "
     2350                                     ,p-string
     2351                                     )
     2352           .
     2353           return .
     2354         end.
     2355       end.
     2356       if p-allow-comma = true
     2357       then do:
     2358         assign
     2359           v-replace-string = replace(v-replace-string, ',', '')
     2360         .
     2361       end.
     2362       else do:
     2363         if index(v-replace-string, ',') > 0
     2364         then do:
     2365           assign
     2366             p-value      = ?
     2367             p-data-valid = false
     2368             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
     2369                                     + "Задан параметр недопустимости знака разделителя тысяч."
     2370                                     + "Строка содержит знак разделителя тысяч. "
     2371                                     ,p-string
     2372                                     )
     2373           .
     2374           return .
     2375         end.
     2376       end.
     2377       if index(p-string, '.') > 0
     2378       then do:
     2379         assign
     2380           p-value      = ?
     2381           p-data-valid = false
     2382           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
     2383                                    + "Строка содержит знак десятичной точки"
     2384                                    ,p-string
     2385                                    )
     2386         .
     2387         return .
     2388       end.
     2389       if v-replace-string <> fill('9', length(v-replace-string))
     2390       then do:
     2391         assign
     2392           p-value      = ?
     2393           p-data-valid = false
     2394           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
     2395                                    + "Встречены символы, недопустимые для целого числа '&2'"
     2396                                    ,p-string
     2397                                    ,replace(v-replace-string, '9', '')
     2398                                    )
     2399         .
     2400         return .
     2401       end.
     2402       assign
     2403         p-data-valid = true
     2404         p-message    = ""
     2405       .
     2406     end.
     2407   end procedure.
     2408   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2409   FUNCTION mark-string RETURNS CHARACTER
     2410     ( input p-recid as recid, input mark-list as character  ) :
     2411     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     2412   END FUNCTION.
     2413   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2414   procedure ass-grp-gds-code-yes :
     2415   define input  parameter p-gds-code   as integer   no-undo .
     2416   define input  parameter p-node-code  as integer   no-undo .
     2417   define input  parameter p-id         as integer   no-undo .
     2418   define input  parameter p-db-num     as integer   no-undo .
     2419   define output parameter p-ask        as logical   no-undo .
     2420   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     2421   define buffer buf1_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     2422   define buffer buf_goods   for ub.goods  .
     2423   define buffer buf_gds-grp for ub.gds-grp  .
     2424   define buffer buf_gds-obj-prop for ub.gds-obj-prop  .
     2425   define variable v-grp-qnty as integer   no-undo .
     2426   define variable v-grp-lim as integer   no-undo .
     2427     do
     2428     on error undo, return error return-value
     2429     :
     2430   p-ask = ? .
     2431   find first  ub.assortment-matrix no-lock where
     2432               ub.assortment-matrix.asmt-id  = p-id and
     2433               ub.assortment-matrix.db-num   = p-db-num and
     2434               ub.assortment-matrix.asmt-type =  'Шаблон':U
     2435               no-error .
     2436   if available ub.assortment-matrix then do:
     2437     p-ask = true .
     2438     return .
     2439   end.
     2440   find first buf_gds-obj-prop no-lock where
     2441             buf_gds-obj-prop.gds-code = p-gds-code and
     2442             buf_gds-obj-prop.obj-type = ub.assortment-matrix.obj-type and
     2443             buf_gds-obj-prop.obj-code = ub.assortment-matrix.obj-code and
     2444             buf_gds-obj-prop.gdop-igt = 'На вывод из ассортимента':U no-error .
     2445   if available buf_gds-obj-prop then do:
     2446     p-ask = true .
     2447     return .
     2448   end.
     2449   find first buf_goods no-lock where buf_goods.gds-code = p-gds-code .
     2450   find first buf_gds-grp-obj-attr no-lock where
     2451              buf_gds-grp-obj-attr.attr-code = 'LimAssMat':U and
     2452              buf_gds-grp-obj-attr.obj-type  = string(p-id) and
     2453              buf_gds-grp-obj-attr.obj-code  = p-db-num and
     2454              buf_gds-grp-obj-attr.host-code = 0 and
     2455              buf_gds-grp-obj-attr.node-code = p-node-code no-error .
     2456   if error-status :error then do:
     2457     p-ask = true .
     2458     return .
     2459   end.
     2460   if buf_gds-grp-obj-attr.attr-value  = "0" then do:
     2461     p-ask = false  .
     2462     return .
     2463   end.
     2464     if buf_gds-grp-obj-attr.attr-value  = "" or
     2465       buf_gds-grp-obj-attr.attr-value  = ?  or
     2466       buf_gds-grp-obj-attr.attr-value  = "?" then do:
     2467       find first buf_gds-grp no-lock where
     2468                   buf_gds-grp.node-code = p-node-code no-error .
     2469         if available buf_gds-grp  then do:
     2470             if buf_gds-grp.upper-code = 0 then do:
     2471                 p-ask = true .
     2472                 return .
     2473             end.
     2474             else do:
     2475                 run ass-grp-gds-code-yes (
     2476                    input   p-gds-code
     2477                   ,input   buf_gds-grp.upper-code
     2478                   ,input   p-id
     2479                   ,input   p-db-num
     2480                   ,output  p-ask
     2481                   ).
     2482                 if p-ask <> ? then return .
     2483           end.
     2484         end.
     2485     end.
     2486     else do:
     2487       v-grp-lim = int (buf_gds-grp-obj-attr.attr-value) no-error  .
     2488       if v-grp-lim > 0 then do:
     2489           v-grp-qnty = 0 .
     2490           find first buf1_gds-grp-obj-attr no-lock where
     2491                      buf1_gds-grp-obj-attr.attr-code = 'QntyAssMat':U and
     2492                      buf1_gds-grp-obj-attr.obj-type  = string(p-id) and
     2493                      buf1_gds-grp-obj-attr.obj-code  = p-db-num and
     2494                      buf1_gds-grp-obj-attr.host-code = 0 and
     2495                      buf1_gds-grp-obj-attr.node-code = p-node-code no-error .
     2496           if available buf1_gds-grp-obj-attr then do:
     2497             v-grp-qnty = int(buf1_gds-grp-obj-attr.attr-value) .
     2498           end.
     2499           if v-grp-lim >= v-grp-qnty + 1 then p-ask = true .
     2500           else p-ask = false .
     2501           return .
     2502       end.
     2503     end.
     2504     end.
     2505   end procedure.
     2506   procedure recalc-gds-assgrp :
     2507   define input  parameter p-action     as character no-undo .
     2508   define input  parameter p-gds-code  as integer   no-undo .
     2509   define input  parameter p-node-code  as integer   no-undo .
     2510   define input  parameter p-id         as integer   no-undo .
     2511   define input  parameter p-db-num     as integer   no-undo .
     2512   define buffer buf_gds-grp for ub.gds-grp  .
     2513   define buffer curr_gds-grp for ub.gds-grp  .
     2514   define buffer buf1_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     2515   define buffer buf_gds-obj-prop for ub.gds-obj-prop  .
     2516   define variable kk as character no-undo .
     2517     do
     2518     on error undo, return error return-value
     2519     :
     2520   find first  ub.assortment-matrix no-lock where
     2521               ub.assortment-matrix.asmt-id  = p-id and
     2522               ub.assortment-matrix.db-num   = p-db-num and
     2523               ub.assortment-matrix.asmt-type =  'Шаблон':U
     2524               no-error .
     2525       if available ub.assortment-matrix then do:
     2526         return .
     2527       end.
     2528       find first buf_gds-obj-prop no-lock where
     2529                  buf_gds-obj-prop.gds-code = p-gds-code and
     2530                  buf_gds-obj-prop.obj-type = ub.assortment-matrix.obj-type and
     2531                  buf_gds-obj-prop.obj-code = ub.assortment-matrix.obj-code and
     2532                  buf_gds-obj-prop.gdop-igt = 'На вывод из ассортимента':U
     2533                  no-error .
     2534       if available buf_gds-obj-prop then do:
     2535         if p-action <> '--' then  do:
     2536            return .
     2537         end.
     2538       end.
     2539       find first buf1_gds-grp-obj-attr exclusive-lock where
     2540                  buf1_gds-grp-obj-attr.attr-code = 'QntyAssMat':U and
     2541                  buf1_gds-grp-obj-attr.obj-type  = string(p-id) and
     2542                  buf1_gds-grp-obj-attr.obj-code  = p-db-num and
     2543                  buf1_gds-grp-obj-attr.host-code = 0 and
     2544                  buf1_gds-grp-obj-attr.node-code = p-node-code
     2545                  no-error .
     2546       if available buf1_gds-grp-obj-attr then do:
     2547          if p-action = '+' then  do:
     2548             kk = string( int( buf1_gds-grp-obj-attr.attr-value ) + 1 ).
     2549          end.
     2550          else do:
     2551             kk = string( int( buf1_gds-grp-obj-attr.attr-value ) - 1 ).
     2552          end.
     2553          buf1_gds-grp-obj-attr.attr-value = kk .
     2554       end.
     2555       else do:
     2556           if p-action = '+' then  do:
     2557               create buf1_gds-grp-obj-attr .
     2558                 assign
     2559                   buf1_gds-grp-obj-attr.attr-code  = 'QntyAssMat':U
     2560                   buf1_gds-grp-obj-attr.obj-type   = string(p-id)
     2561                   buf1_gds-grp-obj-attr.obj-code   = p-db-num
     2562                   buf1_gds-grp-obj-attr.host-code  = 0
     2563                   buf1_gds-grp-obj-attr.node-code  = p-node-code
     2564                   buf1_gds-grp-obj-attr.attr-value = "1"
     2565                 .
     2566           end.
     2567       end.
     2568      FIND FIRST curr_gds-grp WHERE
     2569                 curr_gds-grp.node-code = p-node-code
     2570           NO-LOCK NO-ERROR.
     2571      if AVAILABLE curr_gds-grp AND curr_gds-grp.upper-code > 0 then do:
     2572         run recalc-gds-assgrp (p-action ,p-gds-code , curr_gds-grp.upper-code,p-id,p-db-num ) .
     2573      end.
     2574     end.
     2575   end procedure.
     2576   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2577   procedure SpecGr-gds-code-yes :
