    10377           + 'fillin_row=2\':u
    10378           + 'fillin_col=4\':u
    10379           + 'fillin_width=20\':u
    10380           + 'fillin_height=1\':u
    10381           + 'max-chars=70\':u
    10382           + 'readonly=no' + '\':u
    10383           , input-output v-date-chr
    10384           ).
    10385           if return-value = 'false':u then return error.
    10386           assign
    10387           v-date = date( integer(substr(v-date-chr, 4, 2))
    10388                         ,integer(substr(v-date-chr, 1, 2))
    10389                         ,integer(substr(v-date-chr, 7, 4))
    10390                        )
    10391           no-error .
    10392           if error-status:error then return error.
    10393           run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    10394                                               , input-output v-seq
    10395                                               , input 0
    10396                                               , input '':U
    10397                                               , input substitute("Дата начала периода: &1", v-date)
    10398                                               , input tot-lns
    10399                                               , input rs-list-method
    10400                                               , input rs-status
    10401                                               , input v-date
    10402                                               , input '':U
    10403                                               , input ?
    10404                                               ).
    10405         end.
    10406       end.
    10407       if tot-lns <> 0 then do:
    10408         run get-operation in this-procedure (input dsp-rs, output v-operation) no-error .
    10409         CASE v-operation:
    10410           when 1 then do:
    10411             run proc-b-add in this-procedure(no, ?, rs-list-method, rs-status) no-error  .
    10412           end.
    10413           when 2 then do:
    10414             run proc-b-del in this-procedure(no, ?, rs-list-method, rs-status ) no-error  .
    10415           end.
    10416           when 3 then do:
    10417             run proc-b-rest in this-procedure(no, ?, rs-list-method, rs-status) no-error  .
    10418           end.
    10419           otherwise do:
    10420             assign
    10421             dsp-rs = "":U.
    10422             run UI-on in this-procedure.
    10423             return error.
    10424           end.
    10425         END CASE.
    10426         if error-status:error then do:
    10427           run UI-on in this-procedure.
    10428           return error return-value .
    10429         end.
    10430       end.
    10431       assign
    10432       rs-list-method = temp-list.fvalue
    10433       .
    10434       find last buf_gds-list-hist no-lock where
    10435                 buf_gds-list-hist.id = (v-seq - 1)
    10436           and  buf_gds-list-hist.line = 0 no-error .
    10437       DISPLAY
    10438       (if available buf_gds-list-hist
    10439       then buf_gds-list-hist.des
    10440       else '') @ dsp-rs
    10441       with frame Dialog-Frame.
    10442       if tot-lns = 0
    10443       and not p-keep-query
    10444       then do:
    10445         run proc-b-add in this-procedure(no, ?, rs-list-method, rs-status)  .
    10446       end.
    10447     end.
    10448   end.
    10449   end procedure.
    10450   PROCEDURE trig-attr :
    10451   define input parameter p-attr-table as character no-undo .
    10452   define input parameter p-list       as character no-undo .
    10453   DEFINE VARIABLE ii as integer no-undo .
    10454   DEFINE VARIABLE vattr-codes          as character           no-undo.
    10455   DEFINE VARIABLE vattr-labels         as character           no-undo.
    10456   DEFINE VARIABLE vtooltip             as character           no-undo.
    10457   DEFINE VARIABLE vlabel               as character           no-undo .
    10458   DEFINE VARIABLE vtype                as character           no-undo .
    10459   DEFINE VARIABLE vformat              as character           no-undo .
    10460   DEFINE VARIABLE vuser-can-edit       as logical             no-undo .
    10461   DEFINE VARIABLE voutput-display      as logical             no-undo .
    10462   DEFINE VARIABLE vother               as character           no-undo .
    10463   DEFINE VARIABLE v-ref-list           as character           no-undo .
    10464   DEFINE VARIABLE jj                   as integer             no-undo .
    10465   DEFINE VARIABLE v-spr                as character           no-undo .
    10466   DEFINE VARIABLE v-spr-param          as character           no-undo .
    10467   DEFINE VARIABLE v-setted             as logical             no-undo .
    10468   define variable v-init               as character           no-undo .
    10469   define variable v-item               as character           no-undo .
    10470   define variable glog as logical no-undo .
    10471   define variable v-list               as character           no-undo .
    10472   assign
    10473   v-attr-code = ""
    10474   vattr-codes = ""
    10475   vattr-labels = ""
    10476   vvalue = ""
    10477   .
    10478   DO ii = 1 to num-entries ( p-list):
    10479       CASE p-attr-table:
    10480         when "gds-obj-attr" then do:
    10481           run gdsoattr-name  in this-procedure (
    10482                                                 input entry(ii, p-list)
    10483                                                 ,output vtype
    10484                                                 ,output vformat
    10485                                                 ,output vlabel
    10486                                                 ,output vuser-can-edit
    10487                                                 ,output voutput-display
    10488                                                 ,output vother) no-error.
    10489         end.
    10490         when "gds-host-attr" then do:
    10491           v-list = 'no-envd,':u.
    10492           run gdshattr-name in this-procedure (
    10493                                                 input entry(ii, p-list)
    10494                                               ,output vtype
    10495                                               ,output vformat
    10496                                               ,output vlabel
    10497                                               ,output vuser-can-edit
    10498                                               ,output voutput-display
    10499                                               ,output vother) no-error.
    10500         end.
    10501         WHEN "goods-attr" then do:
    10502           run gds-attr-name in this-procedure (
    10503                                                 input entry(ii, p-list)
    10504                                                 ,output vtype
    10505                                                 ,output vformat
    10506                                                 ,output vlabel
    10507                                                 ,output vuser-can-edit
    10508                                                 ,output voutput-display
    10509                                                 ,output vother) no-error.
    10510         end.
    10511       END CASE.
    10512       if NOT error-status:error anD VOUTPUT-DISPLAY = yes then do:
    10513           assign
    10514           vattr-codes = vattr-codes + chr(4) + entry(ii, p-list)
    10515           vattr-labels = vattr-labels + chr(4) + vlabel
    10516           .
    10517       end.
    10518   end.
    10519   run gbl/d-list.w ( input "b-sel":U
    10520                     ,input "Выберите атрибут"
    10521                     ,input vattr-codes
    10522                     ,input vattr-labels
    10523                     ,input chr(4)
    10524                     ,input "":U
    10525                     ,output v-attr-code).
    10526   if v-attr-code = "" then do:
    10527     return error.
    10528   end.
    10529   glog = yes.
    10530   CASE rs-list-method:
    10531     when "gds-obj-attr":U then do:
    10532       run gdsoattr-tooltip  in this-procedure( input v-attr-code,
    10533                            output vtooltip,
    10534                            output vlabel).
    10535       message
    10536       "Все товары с установленным атрибутом на объекте" vlabel skip
    10537       stat-line(rs-status)
    10538       view-as alert-box question buttons OK-Cancel update glog.
    10539       if not glog then do:
    10540         return error.
    10541       end.
    10542   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10543   run userobjs_select-one in this-procedure
    10544     (input  parparentproc
    10545     ,input  v-cntxt-db-num
    10546     ,input  v-cntxt-userid
    10547     ,input  v-cntxt-host-code-obj
    10548     ,input  v-cntxt-obj-type
    10549     ,input  v-cntxt-obj-code
    10550     ,output v-user-select
    10551     ,output v-sel-obj-type
    10552     ,output v-sel-obj-code
    10553     )  .
    10554       if not v-user-select then do:
    10555         return error.
    10556       end.
    10557       assign
    10558       dsp-rs = substitute("ВСЕ товары с установленным атрибутом на объекте &1 &2", vlabel, stat-line(rs-status))
    10559       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code) + chr(3) + v-attr-code
    10560       .
    10561     end.
    10562     when "gds-obj-attr-val":U then do:
    10563       run gdsoattr-name  in this-procedure (
    10564                            input v-attr-code,
    10565                            output vtype,
    10566                            output vformat,
    10567                            output vlabel,
    10568                            output vuser-can-edit,
    10569                            output voutput-display,
    10570                            output vother).
    10571       do jj = 1 to num-entries(vother, chr(47)):
    10572         if entry(1, entry(jj, vother, chr(47)), "=":U) = "init":U then do:
    10573           assign
    10574           v-init = string(entry(2, entry(jj, vother, chr(47)), "=":U))
    10575           .
    10576         end.
    10577       end.
    10578       do jj = 1 to num-entries(vother, chr(47)):
    10579         if entry(1, entry(jj, vother, chr(47)), "=":U) = "spr":U then do:
    10580           assign
    10581           v-spr = entry(2, entry(jj, vother, chr(47)), "=":U)
    10582           .
    10583         end.
    10584         if entry(1, entry(jj, vother, chr(47)), "=":U) = "spr-param":U then do:
    10585           assign
    10586           v-spr-param = entry(2, entry(jj, vother, chr(47)), "=":U)
    10587           .
    10588         end.
    10589       end.
    10590   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10591   run userobjs_select-one in this-procedure
    10592     (input  parparentproc
    10593     ,input  v-cntxt-db-num
    10594     ,input  v-cntxt-userid
    10595     ,input  v-cntxt-host-code-obj
    10596     ,input  v-cntxt-obj-type
    10597     ,input  v-cntxt-obj-code
    10598     ,output v-user-select
    10599     ,output v-sel-obj-type
    10600     ,output v-sel-obj-code
    10601     )  .
    10602       if not v-user-select then do:
    10603         return error.
    10604       end.
    10605       if  v-init <> "":U then do:
    10606           run  value(v-init)
    10607                       in this-procedure (
    10608                                            input 0
    10609                                          , input v-sel-obj-type
    10610                                          , input v-sel-obj-code
    10611                                          , output vvalue) no-error .
    10612             if error-status:error then do:
    10613                 assign
    10614                 vvalue = "":U
    10615                 .
    10616             end.
    10617       end.
    10618       CASE vtype:
    10619         when 'L':U then do:
    10620           assign
    10621           vvalue = "yes":U
    10622           .
    10623         end.
    10624         when 'I':U or when 'D':U then do:
    10625           assign
    10626           vvalue = if v-init <> "":U
    10627                         then vvalue
    10628                         else string(0)
    10629           .
    10630         end.
    10631         when 'T':U then do:
    10632           assign
    10633           vvalue = ?
    10634           .
    10635         end.
    10636         when 'C':U then do:
    10637           assign
    10638           vvalue = if v-init <> "":U
    10639                         then vvalue
    10640                         else "":U
    10641           .
    10642         end.
    10643       END CASE.
    10644       if v-spr = "":U then do:
    10645         run gbl/d-prompt.w (
    10646           'title=':u + "Значение атрибута товара на объекте" + '\':u
    10647         + 'text1=':u + vlabel + '\':u
    10648         + 'format=' + (if vtype = 'L':U then "yes/no" else vformat) + '\':u
    10649         + 'type=' + vtype + '\':u
    10650         + 'fillin_row=2\':u
    10651         + 'fillin_col=4\':u
    10652         + 'fillin_width=20\':u
    10653         + 'fillin_height=1\':u
    10654         + 'max-chars=70\':u
    10655         + 'readonly=no\':u
    10656         , input-output vvalue
    10657         ).
    10658         if return-value = 'false':U then do:
    10659           return error.
    10660         end.
    10661       end.
    10662       else do:
    10663         if v-spr-param = "":U then do:
    10664           run  value(v-spr)
    10665                         in this-procedure (
    10666                                           input 0
    10667                                           ,input v-sel-obj-type
    10668                                           ,input v-sel-obj-code
    10669                                           ,input-output vvalue
    10670                                           ,output v-setted) no-error .
    10671         end.
    10672         else do:
    10673           run  value(v-spr)
    10674                         in this-procedure (
    10675                                           input 0
    10676                                           ,input v-sel-obj-type
    10677                                           ,input v-sel-obj-code
    10678                                           ,input v-spr-param
    10679                                           ,input-output vvalue
    10680                                           ,output v-setted) no-error .
    10681         end.
    10682         if not v-setted then do:
    10683           return error.
    10684         end.
    10685       end.
    10686       message
    10687       ("Все товары с атрибутом товара на объекте" + chr(32) + vlabel + " = ":U + vvalue) skip
    10688       stat-line(rs-status)
    10689       view-as alert-box question buttons OK-Cancel update glog.
    10690       if not glog then do:
    10691         return error.
    10692       end.
    10693       assign
    10694       dsp-rs = substitute("ВСЕ товары с атрибутом товара на объекте &1 =&2 &3", vlabel, vvalue, stat-line(rs-status))
    10695       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code) + chr(3) + v-attr-code + chr(3) + vvalue
    10696       .
    10697     end.
    10698     when "gds-host-attr":U then do:
    10699       run gdshattr-tooltip  in this-procedure
    10700                            (input v-attr-code,
    10701                            output vtooltip,
    10702                            output vlabel).
    10703       message "Все товары с установленным атрибутом на фирме" vlabel skip
    10704       stat-line(rs-status)
    10705       view-as alert-box question buttons OK-Cancel update glog.
    10706       if not glog then do:
