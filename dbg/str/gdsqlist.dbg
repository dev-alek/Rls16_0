    11253       dsp-rs = substitute("ВСЕ топлива &1", v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    11254       v-item = '':U
    11255       .
    11256     end.
    11257     when "gds-office":U then do:
    11258       assign
    11259       dsp-rs = substitute("ВСЕ услуги &1", v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    11260       v-item = '':U
    11261       .
    11262     end.
    11263   END CASE.
    11264   v-no-hist = 0.
    11265   run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    11266                                       , input-output v-seq
    11267                                       , input 0
    11268                                       , input '':U
    11269                                       , input dsp-rs
    11270                                       , input tot-lns
    11271                                       , input rs-list-method
    11272                                       , input rs-status
    11273                                       , input v-item
    11274                                       , input '':U
    11275                                       , input ?
    11276                                       ).
    11277   END PROCEDURE.
    11278   PROCEDURE trig-dis-gds-rule :
    11279   define variable v-rid-list as character no-undo .
    11280   define variable v-pos-type as character no-undo .
    11281   define variable v-templ-rl-root as integer no-undo .
    11282   define variable v-time-templ-rl-root as integer no-undo .
    11283   define variable v-cfg-nonunique as character no-undo .
    11284   define variable v-nonunique as character no-undo .
    11285   define variable v-discnt-role as character no-undo .
    11286   define variable v-obj-type as character no-undo .
    11287   define variable v-obj-code as integer no-undo .
    11288   define variable r-b-code as integer no-undo .
    11289   define variable v-sts as integer no-undo .
    11290   define variable glog as logical no-undo .
    11291   define variable v-mode as character no-undo .
    11292   define variable v-item as character no-undo .
    11293   define variable v-rule-num as integer no-undo .
    11294   define variable dflt-cd as character no-undo .
    11295   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
    11296   define buffer buf_dis-rule for ub.dis-rule.
    11297   if v-cntxt-obj-type = 'скл':U then do:
    11298     dflt-cd = '-':U.
    11299   end.
    11300   else do:
    11301   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11302   define variable v-param-type72 as character no-undo .
    11303   define variable v-value-date72 as date no-undo .
    11304   define variable v-value-decimal72 as decimal no-undo .
    11305   define variable v-value-integer72 as INTEGER no-undo .
    11306   define variable v-value-logical72 AS LOGICAL no-undo .
    11307   define variable v-tth72 as handle no-undo .
    11308   run adm/shattri.p (
    11309       input "get":U
    11310       ,input  v-cntxt-obj-type
    11311       ,input  v-cntxt-obj-code
    11312       ,input  'cd-sending':U
    11313       ,input  'dflt-cd':U
    11314       ,output dflt-cd
    11315       ,output v-value-date72
    11316       ,output v-value-decimal72
    11317       ,output v-value-integer72
    11318       ,output v-value-logical72
    11319       ,output v-param-type72
    11320       ,INPUT-OUTPUT table-handle v-tth72
    11321       )  .
    11322   delete object v-tth72 no-error.
    11323     assign
    11324     v-pos-type = dflt-cd + chr(44) + '-':U + chr(44) + 'bo':U.
    11325   end.
    11326   run ref/dis-pos.w ( INPUT parparentproc
    11327                       ,INPUT "b-sel":U
    11328                       ,INPUT (if rs-list-method = "dis-gds-rule"
    11329                              then "cd-type-list-without-template-pos"
    11330                              else "cd-type-list")
    11331                       ,INPUT 1
    11332                       ,INPUT 1
    11333                       ,INPUT 1
    11334                       ,input 'dis-gds-rule':U
    11335                       ,input '':U
    11336                       ,input ?
    11337                       ,INPUT v-pos-type
    11338                       ,input '':U
    11339                       ,INPUT-OUTPUT v-rid-list) NO-ERROR.
    11340   IF ERROR-STATUS:ERROR
    11341   OR v-rid-list = '':U THEN DO:
    11342     RETURN.
    11343   END.
    11344   FIND FIRST buf_dis-cfg-rule NO-LOCK where
    11345             recid(buf_dis-cfg-rule) = INTEGER(v-rid-list).
    11346   assign
    11347   v-templ-rl-root = buf_dis-cfg-rule.templ-rl-root
    11348   v-time-templ-rl-root = buf_dis-cfg-rule.time-templ-rl-root
    11349   V-cfg-NONUNIQUE = buf_dis-cfg-rule.nonunique
    11350   v-discnt-role = buf_dis-cfg-rule.discnt-role
    11351   .
    11352   if rs-list-method = "dis-gds-rule" then do:
    11353     message
    11354     "Все товары со скидкой типа" entry (lookup (buf_dis-cfg-rule.discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u) skip
    11355     stat-line(rs-status)
    11356     view-as alert-box question buttons OK-Cancel update glog.
    11357   end.
    11358   else do:
    11359     message
    11360     "Все товары со скидкой типа" entry (lookup (buf_dis-cfg-rule.discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u) "и определенным номером правила скидки" skip
    11361     stat-line(rs-status)
    11362     view-as alert-box question buttons OK-Cancel update glog.
    11363   end.
    11364   if not glog then do:
    11365     return error.
    11366   end.
    11367   if (buf_dis-cfg-rule.has-global +
    11368       buf_dis-cfg-rule.has-host +
    11369       buf_dis-cfg-rule.has-obj) > 1 then do:
    11370     define variable v-sel-vals as character no-undo .
    11371     define variable v-sel-labels as character no-undo .
    11372     define variable var-region as character no-undo .
    11373     assign
    11374     v-sel-vals = v-sel-vals +
    11375                   (if buf_dis-cfg-rule.has-global = 1
    11376                   then (fill(chr(32), 3)  + string(0) + chr(4) )
    11377                   else "":U)
    11378     v-sel-labels = v-sel-labels +
    11379                   (if buf_dis-cfg-rule.has-global  = 1
    11380                   then ("Глобально" + chr(4) )
    11381                   else "":U)
    11382     .
    11383     assign
    11384     v-sel-vals = v-sel-vals +
    11385                   (if buf_dis-cfg-rule.has-host = 1
    11386                   then ('орг':U  + string(v-cntxt-host-code-obj)  + chr(4) )
    11387                   else "":U)
    11388     v-sel-labels = v-sel-labels +
    11389                   (if buf_dis-cfg-rule.has-host = 1
    11390                   then ("Фирма"  + string(v-cntxt-host-code-obj) + chr(4) )
    11391                   else "":U)
    11392     .
    11393     assign
    11394     v-sel-vals = v-sel-vals +
    11395                   (if buf_dis-cfg-rule.has-obj = 1
    11396                   then (v-cntxt-obj-type  + string(v-cntxt-obj-code)  + chr(4) )
    11397                   else "":U)
    11398     v-sel-labels = v-sel-labels +
    11399                   (if buf_dis-cfg-rule.has-obj = 1
    11400                   then (v-cntxt-obj-type  + string(v-cntxt-obj-code)  + chr(4) )
    11401                   else "":U)
    11402     .
    11403     run gbl/d-list.w (
    11404                         input "b-sel":U
    11405                         ,input "Выберите область действия"
    11406                         ,input v-sel-vals
    11407                         ,input v-sel-labels
    11408                         ,input chr(4)
    11409                         ,input "":U
    11410                         ,output var-region) no-error.
    11411     if error-status:error then do:
    11412       return error.
    11413     end.
    11414     assign
    11415     v-obj-type = substring(var-region, 1, 3)
    11416     v-obj-code = integer(substring(var-region, 4))
    11417     v-sel-obj-type = v-obj-type
    11418     v-sel-obj-code = v-obj-code
    11419     .
    11420   end.
    11421   else do:
    11422     if buf_dis-cfg-rule.has-obj = 1 then do:
    11423   define variable vss-include-info73 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11424   run userobjs_select-one in this-procedure
    11425     (input  parparentproc
    11426     ,input  v-cntxt-db-num
    11427     ,input  v-cntxt-userid
    11428     ,input  v-cntxt-host-code-obj
    11429     ,input  v-cntxt-obj-type
    11430     ,input  v-cntxt-obj-code
    11431     ,output v-user-select
    11432     ,output v-sel-obj-type
    11433     ,output v-sel-obj-code
    11434     )  .
    11435       if not v-user-select then do:
    11436         return error.
    11437       end.
    11438       assign
    11439       v-obj-type = v-sel-obj-type
    11440       v-obj-code = v-sel-obj-code
    11441       .
    11442     end.
    11443     if buf_dis-cfg-rule.has-host = 1 then do:
    11444       define variable v-host-code as integer no-undo .
    11445       assign
    11446       v-obj-type = 'орг':U
    11447       v-obj-code = v-cntxt-host-code-obj
    11448       .
    11449     end.
    11450     if buf_dis-cfg-rule.has-glob = 1 then do:
    11451       assign
    11452       v-obj-type = '':U
    11453       v-obj-code = 0
    11454       .
    11455     end.
    11456   end.
    11457   if rs-list-method = "dis-gds-rule" then do:
    11458     assign
    11459     dsp-rs = substitute("ВСЕ товары с установленным типом скидки &1 &2"
    11460                       , get-objregion(v-obj-type, v-obj-code), stat-line(rs-status))
    11461     v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code) + chr(3) + v-discnt-role   .
    11462   end.
    11463   else do:
    11464     v-mode = (if v-obj-type = 'маг':U
    11465               or v-obj-type = 'скл':U
    11466               then "upper-rule-num-object":u
    11467               else ('dis-gds-rule':U + "=" + v-discnt-role)).
    11468     run ref/dis-ruls.w (
    11469                  input parparentproc
    11470                 ,input 0
    11471                 ,input v-obj-type
    11472                 ,input v-obj-code
    11473                 ,input "b-add,b-sel":U
    11474                 ,input v-mode
    11475                 ,input v-templ-rl-root
    11476                 ,input v-time-templ-rl-root
    11477                 ,input r-b-code
    11478                 ,input-output v-sts
    11479                 ,input-output v-rid-list ) no-error .
    11480     if v-rid-list = '':u then do:
    11481       return error.
    11482     end.
    11483     find first buf_dis-rule no-lock where
    11484              recid(buf_dis-rule) = integer(v-rid-list) no-error.
    11485     if available buf_dis-rule then do:
    11486     assign
    11487     dsp-rs = substitute("ВСЕ товары с установленным типом скидки: &1, № правила &2 &3"
    11488                         ,get-objregion(v-obj-type, v-obj-code)
    11489                         ,v-rule-num
    11490                         ,stat-line(rs-status))
    11491     v-item = v-sel-obj-type + chr(3) +
    11492               string(v-sel-obj-code) + chr(3) +
    11493                 v-discnt-role + chr(3) + string(buf_dis-rule.rule-num)
    11494     .
    11495   end.
    11496     else do:
    11497       message
    11498       substitute("Не найдено провило скидки с recid &1", v-rid-list)
    11499       view-as alert-box error .
    11500       return error.
    11501     end.
    11502   end.
    11503   v-no-hist = 0.
    11504   run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    11505                                       , input-output v-seq
    11506                                       , input 0
    11507                                       , input '':U
    11508                                       , input dsp-rs
    11509                                       , input tot-lns
    11510                                       , input rs-list-method
    11511                                       , input rs-status
    11512                                       , input v-item
    11513                                       , input '':U
    11514                                       , input ?
    11515                                       ).
    11516   END PROCEDURE.
    11517   procedure proc-scn-tsd :
    11518   define variable glog as logical no-undo .
    11519   define buffer buf_gds-list-hist for gds-list-hist.
    11520     do
    11521     on error undo, return error
    11522     :
    11523     run str/diallog.w (parparentproc
    11524                 , this-procedure
    11525                 , 'str/rsendtsd.p':U
    11526                 , (p-curr-obj-type + chr(4) + string(p-curr-obj-code))
    11527                 , no
    11528                 , '':U
    11529                 , 'Пересылка товаров на ТСД') no-error .
    11530     end.
    11531   end procedure.
    11532   procedure proc-macros :
    11533   define variable glog as logical no-undo .
    11534   define variable v-option as integer no-undo .
    11535   define buffer buf_gds-list-hist for gds-list-hist.
    11536   define buffer buf_macro-list-hist for macro-list-hist.
    11537   if can-find(first macro-list-hist) then do:
    11538     run gbl/d-askw.w ( input "Сохранение макроса"
    11539                   ,input "Выберите какие действия по формированию списка Вы хотите сохранить"
    11540                   ,input "|"
    11541                   ,input "Посл.ЗАПИСЬ|Все|Отказ"
    11542                   ,input "Действия при нажатой кнопке ЗАПИСЬ|ВСЯ последовательность действий|Отказ"
    11543                   ,input 1
    11544                   ,input 3
    11545                   ,output v-option).
    11546     if v-option = 3 then return no-apply.
    11547     v-option = 1.
    11548   end.
    11549   else do:
    11550     message
    11551     "Будет сохранена в файл ВСЯ последовательность действий по формированию списка" skip
    11552     view-as alert-box question buttons yes-no update glog.
    11553     v-option = 2.
    11554     if not glog then do:
    11555       return no-apply.
    11556     end.
    11557   end.
    11558     do
    11559     on error undo, return error
    11560     :
    11561     assign
    11562       f-name = "default.gdm"
    11563       glog = yes
    11564       .
    11565     system-dialog get-file f-name
    11566       filters "Макрос создания списка товара *.gdm" "*.gdm"
    11567       ask-overwrite
    11568       save-as
    11569       use-filename
    11570       update glog
    11571       default-extension "gdm".
    11572     if not glog then do:
    11573       apply "entry" to br-list in frame Dialog-Frame.
    11574       return no-apply.
    11575     end.
    11576     run waitfram-show in this-procedure ("Сохранение макроса формирования списка товара.    ЖДИТЕ...").
    11577     output stream PrnLibStream to value (f-name).
    11578     case v-option:
    11579       when 1 then do:
    11580         for each buf_macro-list-hist:
    11581           export stream PrnLibStream
    11582           buf_macro-list-hist.
    11583         end.
    11584       end.
    11585       when 2 then do:
    11586     for each buf_gds-list-hist:
    11587         export stream PrnLibStream
    11588         buf_gds-list-hist.
    11589     end.
    11590       end.
    11591     end case.
    11592     output stream PrnLibStream close.
    11593     run waitfram-hide in this-procedure .
    11594     end.
    11595   end procedure.
    11596   PROCEDURE trig-tax-rate-value :
    11597   define input parameter p-rs-list-method as character no-undo .
    11598   define output parameter p-date as date no-undo .
    11599   DEFINE VARIABLE v-codes          as character           no-undo.
    11600   DEFINE VARIABLE v-labels         as character           no-undo.
    11601   DEFINE VARIABLE v-type           as character           no-undo.
    11602   DEFINE VARIABLE v-format         as character           no-undo.
    11603   DEFINE VARIABLE v-values         as character           no-undo.
    11604   DEFINE VARIABLE v-code-output    as character           no-undo.
    11605   DEFINE VARIABLE v-value-output   as character           no-undo.
    11606   define variable vlabel           as character           no-undo .
    11607   define variable v-date-chr       as character           no-undo .
    11608   DEFINE VARIABLE v-time           as integer             no-undo .
    11609   DEFINE VARIABLE v-ref-list           as character           no-undo .
    11610   DEFINE VARIABLE jj                   as integer             no-undo .
    11611   define variable glog as logical no-undo .
    11612   assign
    11613   v-attr-code = ""
    11614   vvalue = ""
    11615   v-codes = '1':U + chr(4) + '2':U
    11616   v-labels = "НДС" + chr(4) +  "НП"
    11617   v-values = "0" + chr(4) + "0"
    11618   v-format = ">9.99":U + chr(4) + ">9.99":U
    11619   v-type = 'D':U + chr(4) + 'D':U
    11620   .
    11621   run gbl/d-listv.w (
    11622                  "b-mark,b-sel":U
    11623                 ,"Выберите налоги"
    11624                 , v-codes
    11625                 , v-labels
    11626                 , v-values
    11627                 , v-format
    11628                 , v-type
    11629                 , chr(4)
    11630                 , "":U
    11631                 , output v-attr-code
    11632                 , output vvalue
    11633                 ).
    11634   if v-attr-code = "" then do:
    11635     return error.
    11636   end.
    11637   do jj = 1 to num-entries(v-attr-code, chr(4)):
    11638     assign
    11639     vlabel = vlabel + entry(LOOKUP(entry(jj, v-attr-code, chr(4)), v-codes, chr(4)), v-labels, chr(4)) + "=":U + entry(jj, vvalue, chr(4)) + chr(10)
    11640     .
    11641   end.
    11642   run cur-time in this-procedure(output p-date, output v-time).
    11643   assign
    11644   v-date-chr = string(p-date, "99/99/9999":U)
    11645   .
    11646   run gbl/d-prompt.w (
    11647     'title=':u + "Введите дату значения налогов" + '\':u
    11648   + 'text1=':u + "Дата" + '\':u
    11649   + 'format=' + "99/99/9999" + '\':u
    11650   + 'type=' + 'T':U + '\':u
    11651   + 'fillin_row=2\':u
    11652   + 'fillin_col=4\':u
    11653   + 'fillin_width=20\':u
    11654   + 'fillin_height=1\':u
    11655   + 'max-chars=70\':u
    11656   + 'readonly=no' + '\':u
    11657   , input-output v-date-chr
    11658   ).
    11659   if return-value = 'false':u then return error.
    11660   assign
    11661   p-date = date( integer(substr(v-date-chr, 4, 2))
    11662                 ,integer(substr(v-date-chr, 1, 2))
    11663                 ,integer(substr(v-date-chr, 7, 4))
    11664                )
    11665   no-error .
    11666   if error-status:error then return error.
    11667   define variable vss-include-info74 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11668   run userobjs_select-one in this-procedure
    11669     (input  parparentproc
    11670     ,input  v-cntxt-db-num
    11671     ,input  v-cntxt-userid
    11672     ,input  v-cntxt-host-code-obj
    11673     ,input  v-cntxt-obj-type
    11674     ,input  v-cntxt-obj-code
    11675     ,output v-user-select
    11676     ,output v-sel-obj-type
    11677     ,output v-sel-obj-code
    11678     )  .
    11679   if not v-user-select then do:
    11680     return error.
    11681   end.
    11682   glog = yes.
    11683   if p-rs-list-method = "tax-rate-value":U then do:
    11684     message
    11685     "Все товары с заданными значениями налогов на объекте на дату" v-date-chr skip
    11686     vlabel skip
    11687     stat-line(rs-status)
    11688     view-as alert-box question buttons OK-Cancel update glog.
    11689   end.
    11690   if p-rs-list-method = "tax-rate-value-obj":U then do:
    11691     message
    11692     "Товары объекта с заданными значениями налогов на объекте на дату" v-date-chr skip
    11693     vlabel skip
    11694     stat-line(rs-status)
    11695     view-as alert-box question buttons OK-Cancel update glog.
    11696   end.
    11697   if not glog then do:
    11698     return error.
    11699   end.
    11700   if p-rs-list-method = "tax-rate-value":U then do:
    11701     dsp-rs = substitute("ВСЕ товары с заданными значениями налогов на объекте &1 на дату &2 &3", vlabel, p-date, stat-line(rs-status)).
    11702   end.
    11703   if p-rs-list-method = "tax-rate-value-obj":U then do:
    11704     dsp-rs = substitute("Товары объекта &1 с заданными значениями налогов на объекте &2 на дату &3 &4", vlabel, vlabel, p-date, stat-line(rs-status)).
    11705   end.
    11706   run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    11707                                       , input-output v-seq
    11708                                       , input 0
    11709                                       , input '':U
    11710                                       , input dsp-rs
    11711                                       , input tot-lns
    11712                                       , input rs-list-method
    11713                                       , input rs-status
    11714                                       , input v-sel-obj-type + chr(3) + string(v-sel-obj-code) + chr(3) +
    11715                                               string(p-date, "99/99/9999") + chr(3) + v-attr-code + chr(3) + vvalue
    11716                                       , input '':U
    11717                                       , input ?
    11718                                       ).
    11719   END PROCEDURE.
    11720   procedure proc-b-add :
    11721   define input parameter p-from-macro as logical no-undo .
    11722   define input parameter p-rowid as rowid no-undo .
    11723   define input parameter rs-list-method as character no-undo .
    11724   define input parameter rs-status as character no-undo .
    11725     do
    11726     on error undo, return error
    11727     :
    11728     line-mode = 'ДОБАВЛЕНИЕ':U.
    11729     if rs-list-method = "single" then do:
    11730        v-no-hist = - 1.
    11731       if p-from-macro then do:
    11732         find ub.goods where rowid(ub.goods) = p-rowid no-lock no-error .
    11733       end.
    11734       else do:
    11735         run ref/gds-ref.p ( parparentproc
    11736                         ,"b-sel,b-add"
    11737                         ,?
    11738                         ,?
    11739                         ,?
    11740                         ,?
    11741                         ,?
    11742                         ,?
    11743                         ,?
    11744                         ,p-curr-obj-type
    11745                         ,p-curr-obj-code
    11746                         ,?
    11747                         , output ref-list).
    11748         apply "entry" to br-list in frame Dialog-Frame.
    11749         if ref-list = "" then
    11750           return no-apply.
    11751         find ub.goods where recid (ub.goods) = integer (ref-list) no-lock.
    11752       end.
    11753       if available goods then do:
    11754         run ex-gds  in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    11755         tot-lns = tot-lns + 1.
    11756         run write-hist in this-procedure ( p-from-macro, rs-list-method, rs-status, line-mode).
    11757       end.
    11758       else do:
    11759         return error "Нет в БД такого товара".
    11760       end.
    11761       run UI-on  in this-procedure.
    11762     end.
    11763     else
    11764       run rs-do  in this-procedure( no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
    11765     end.
    11766   end procedure.
    11767   procedure proc-b-del :
    11768   define input parameter p-from-macro as logical no-undo .
    11769   define input parameter p-rowid as rowid no-undo .
    11770   define input parameter rs-list-method as character no-undo .
    11771   define input parameter rs-status as character no-undo .
    11772   define variable v-rep-rec as recid no-undo .
    11773   define variable glog as logical no-undo .
    11774     do
    11775     on error undo, return error
    11776     :
    11777       line-mode = 'удаление':U.
    11778       if rs-list-method = "single" then do:
    11779         v-no-hist = - 1.
    11780         if p-from-macro then do:
    11781           find first ub.goods where rowid(ub.goods) = p-rowid no-error.
    11782           if not available ub.goods then return error "Нет в БД такого товара".
    11783           find first gds-list where gds-list.gds-code = ub.goods.gds-code no-error.
    11784         end.
    11785         if available gds-list then do:
    11786           line-rec = recid (gds-list).
    11787           get next br-list.
    11788           if available gds-list then v-rep-rec = recid (gds-list).
    11789           else do:
    11790             reposition br-list to recid line-rec no-error.
    11791             get prev br-list.
    11792             if available gds-list then v-rep-rec = recid (gds-list).
    11793           end.
    11794           reposition br-list to recid line-rec no-error.
    11795           tot-lns = tot-lns - 1.
    11796           run write-hist in this-procedure ( p-from-macro, rs-list-method, rs-status, line-mode).
    11797           delete gds-list.
    11798           line-rec = v-rep-rec.
    11799           run UI-on in this-procedure.
    11800         end.
    11801         else do:
    11802           return error "Нет в списке товаров такого товара".
    11803         end.
    11804       end.
    11805       else do:
    11806         glog = no.
    11807         message "Удалить товары ПО заданному УСЛОВИЮ ?   Вы уверены ?"
    11808         view-as alert-box question buttons OK-Cancel update glog.
    11809         if not glog then
    11810           return no-apply.
    11811         run rs-do  in this-procedure( no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
    11812       end.
    11813     end.
    11814   end procedure.
    11815   procedure proc-b-rest :
    11816   define input parameter p-from-macro as logical no-undo .
    11817   define input parameter p-rowid as rowid no-undo .
    11818   define input parameter rs-list-method as character no-undo .
    11819   define input parameter rs-status as character no-undo .
    11820   define buffer buf_gds-list-hist for gds-list-hist.
    11821   define variable glog as logical no-undo .
    11822     do
    11823     on error undo, return error
    11824     :
    11825       line-mode = 'ОСТАВИТЬ':U.
    11826       if rs-list-method = "single" then do:
    11827         v-no-hist = - 1.
    11828         if p-from-macro then do:
    11829           find first ub.goods where rowid(ub.goods) = p-rowid no-error.
    11830           if not available ub.goods then return error substitute("Нет в БД такого товара").
    11831           find first gds-list where gds-list.gds-code = ub.goods.gds-code no-error.
    11832         end.
    11833         if available gds-list then do:
    11834           if p-from-macro then do:
    11835             glog = yes.
    11836           end.
    11837           else do:
    11838             glog = no.
    11839             message "Оставить отмеченную строку и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
    11840             view-as alert-box question buttons OK-Cancel update glog.
    11841             if not glog then return error.
    11842           end.
    11843           line-rec = recid (gds-list).
    11844           v-seq = 1.
    11845           for each buf_gds-list-hist:
    11846             delete buf_gds-list-hist.
    11847           end.
    11848           run write-hist  in this-procedure ( p-from-macro, rs-list-method, rs-status, line-mode).
    11849           for each gds-list:
    11850             if line-rec <> recid (gds-list) then delete gds-list.
    11851           end.
    11852           assign
    11853           tot-lns = 1
    11854           .
    11855           run UI-on  in this-procedure.
    11856         end.
    11857         else do:
    11858           return error substitute("Нет в списке такого товара").
    11859         end.
    11860       end.
    11861       else do:
    11862         glog = no.
    11863         if not p-from-macro then do:
    11864           message "Оставить товары ПО заданному УСЛОВИЮ и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
    11865           view-as alert-box question buttons OK-Cancel update glog.
    11866           if not glog then
    11867             return no-apply.
    11868         end.
    11869         assign
    11870         lns-cnt = 0
    11871         lns-ignore = 0
    11872         .
    11873         run rs-do  in this-procedure ( no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
    11874         for each gds-list:
    11875           if gds-list.to-del = ? then do:
    11876             assign
    11877             gds-list.to-del = no
    11878             .
    11879           end.
    11880           else do:
    11881             delete gds-list.
    11882           end.
    11883         end.
    11884         tot-lns = lns-cnt.
    11885         run UI-on  in this-procedure.
    11886         message
    11887         "Оставлено строк :" lns-cnt skip(0)
    11888         string(if lns-ignore <> 0
    11889         then ("Проигнорировано строк :" + string(lns-ignore))
    11890         else "":U)
    11891         .
    11892       end.
    11893     end.
    11894   end procedure.
    11895   procedure proc-b-obj :
    11896     define input parameter p-mode as character no-undo .
    11897     define buffer buf_clients  for ub.clients.
    11898     do
    11899     on error undo, return error
    11900     :
    11901       if p-mode = "change":U then do:
    11902   define variable vss-include-info75 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11903   run userobjs_select-one in this-procedure
    11904     (input  parparentproc
    11905     ,input  v-cntxt-db-num
    11906     ,input  v-cntxt-userid
    11907     ,input  v-cntxt-host-code-obj
    11908     ,input  v-cntxt-obj-type
    11909     ,input  v-cntxt-obj-code
    11910     ,output v-user-select
    11911     ,output v-sel-obj-type
    11912     ,output v-sel-obj-code
    11913     )  .
    11914       end.
    11915       if v-user-select then do:
    11916         find first buf_clients no-lock where
    11917                    buf_clients.obj-type = v-sel-obj-type
    11918                and buf_clients.obj-code = v-sel-obj-code no-error.
    11919         if not available buf_clients then do: return error. end.
    11920         assign
    11921           p-curr-obj-type = buf_clients.obj-type
    11922           p-curr-obj-code = buf_clients.obj-code
    11923           p-curr-host-code = buf_clients.host-code
    11924           v-obj-type = buf_clients.obj-type
    11925           v-obj-code = buf_clients.obj-code
    11926           v-obj-name = buf_clients.obj-name
    11927         .
    11928         if lookup(bttns, "hide") = 0 then do:
    11929           display
    11930           v-obj-name
    11931           v-obj-type
    11932           v-obj-code
    11933           with frame Dialog-Frame.
    11934         end.
    11935       end.
    11936     end.
    11937   end procedure.
    11938   procedure proc-file-list-methods :
    11939   define input parameter p-from-macro as logical no-undo .
    11940   define input parameter rs-list-method as character no-undo .
    11941   define input parameter rs-status as character no-undo .
    11942   define input parameter line-mode as character no-undo .
    11943   define input parameter p-id      as integer no-undo .
    11944   define variable ss as character no-undo .
    11945   define variable b-c as integer no-undo.
    11946   define variable imp-type like ub.goods.prod-type no-undo.
    11947   define variable imp-code like ub.goods.prod-code no-undo.
    11948   define variable imp-art like ub.goods.artic no-undo.
    11949   define variable imp-doc-code like ub.trn-doc.doc-code no-undo.
    11950   define variable imp-doc-type as character no-undo.
    11951   define variable scan-qnty as dec no-undo.
    11952   define variable bc-qnty as dec no-undo.
    11953   define variable varresult   as character         no-undo.
    11954   define variable vartype-bc  as character         no-undo.
    11955   define variable varweight   as decimal           no-undo.
    11956   define variable v-full-path        as character no-undo .
    11957   define variable v-path             as character no-undo .
    11958   define variable v-file-name        as character no-undo .
    11959   define variable v-file-name-no-ext as character no-undo .
    11960   define variable v-file-name-ext    as character no-undo .
    11961   define variable v-num-add          as integer no-undo .
    11962   define variable v-num-ignored      as integer no-undo .
    11963   define variable v-tbl-row          as rowid no-undo .
    11964   define variable v-tbl-name         as character no-undo .
    11965   define buffer buf_gds-list-hist for gds-list-hist.
    11966   define buffer buf_clob-data for ub.clob-data.
    11967   define buffer buf_clob-bind for ub.clob-bind.
    11968   do
    11969   on error undo, return error
    11970   :
    11971   find first buf_gds-list-hist where
    11972             buf_gds-list-hist.id = p-id
    11973         AND buf_gds-list-hist.item_ <> '':U .
    11974   if rs-list-method = "clob-data" then do:
    11975     run gen-row-keyr in this-procedure (
    11976      input  buf_gds-list-hist.item_
    11977     ,input  ?
    11978     ,input  "ub"
    11979     ,input  ?
    11980     ,input NO-LOCK
    11981     ,output v-tbl-row
    11982     ,output v-tbl-name  ) no-error.
    11983     if error-status :error then do:
    11984       message
    11985       "Ошибка при поиске хранимого файла"
    11986       view-as alert-box error.
    11987       return error.
    11988     end.
    11989     find first buf_clob-bind no-lock where
    11990               rowid(buf_clob-bind) = v-tbl-row .
    11991     find first buf_clob-data no-lock where
    11992               buf_clob-data.db-num = buf_clob-bind.db-num
    11993           and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
    11994     if error-status :error then do:
    11995       message
    11996       "Ошибка при пополучении хранимого файла"
    11997       view-as alert-box error.
    11998       return error.
    11999     end.
    12000     run gbl/_tmpfile.p ( input ""
    12001                   ,input "tmp"
    12002                   ,output v-file-name) .
    12003     copy-lob from object buf_clob-data.cdata
    12004     to file v-file-name.
    12005   end.
    12006   run gbl/filename.p
    12007       (input  (if rs-list-method = "clob-data" then v-file-name else buf_gds-list-hist.item_  )
    12008     ,output v-full-path
    12009     ,output v-path
    12010     ,output v-file-name
    12011     ,output v-file-name-no-ext
    12012     ,output v-file-name-ext
    12013     ) no-error .
    12014     if error-status:error then do: end. else do:
    12015     input stream sout from value (v-full-path).
    12016     CASE rs-list-method:
    12017       when "doc-list" then do:
    12018         repeat:
    12019           import stream sout imp-doc-code imp-doc-type no-error.
    12020           if imp-doc-type = 'переоценка':U then do:
    12021             find first ub.price-doc No-LOCK WHERE
    12022                       ub.price-doc.doc-num = imp-doc-code No-ERROR.
    12023             if avail(ub.price-doc) then do:
    12024               FOR EACH ub.price-list No-LOCK WHERE
    12025                       ub.price-list.doc-num = ub.price-doc.doc-num,
    12026                   FIRST ub.goods No-LOCK WHERE
    12027                         ub.goods.artic = ub.price-list.artic AND
    12028                         ub.goods.prod-type = ub.price-list.prod-type AND
    12029                         ub.goods.prod-code = ub.price-list.prod-code:
    12030                 run ex-gds  in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12031                 if available gds-list and
    12032                   gds-list.artic = ub.goods.artic and
    12033                   gds-list.prod-type = ub.goods.prod-type and
    12034                   gds-list.prod-code = ub.goods.prod-code then
    12035                   gds-list.qnty = scan-qnty.
    12036               END.
    12037             end.
    12038           end.
    12039           else do:
    12040             find first ub.trn-doc NO-LOCK where
    12041                       ub.trn-doc.doc-code = imp-doc-code No-ERROR.
    12042             if avail(ub.trn-doc) then do:
    12043               FOR EACH ub.doc-line NO-LOCK where
    12044                       ub.doc-line.doc-code = ub.trn-doc.doc-code,
    12045                   FIRST ub.goods where ub.goods.artic = ub.doc-line.artic
    12046                               and ub.goods.prod-type = ub.doc-line.prod-type
    12047                               and ub.goods.prod-code = ub.doc-line.prod-code NO-LOCK:
    12048                 run ex-gds  in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12049                 if available gds-list and
    12050                   gds-list.artic = ub.goods.artic and
    12051                   gds-list.prod-type = ub.goods.prod-type and
    12052                   gds-list.prod-code = ub.goods.prod-code then
    12053                   gds-list.qnty = scan-qnty.
    12054               end.
    12055             end.
    12056           end.
    12057         end.
    12058       end.
    12059       when "prod-list" then do:
    12060         repeat:
    12061           import stream sout imp-type imp-code no-error.
    12062           for each ub.goods where ub.goods.prod-type = imp-type
    12063                       and ub.goods.prod-code = imp-code no-lock:
    12064             run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12065           end.
    12066         end.
    12067       end.
    12068       when "supp-list" then do:
    12069         repeat:
    12070           import stream sout imp-type imp-code no-error.
    12071           for each ub.cli-gds where ub.cli-gds.cli-type = imp-type
    12072                               and ub.cli-gds.cli-code = imp-code
    12073                               and ub.cli-gds.host-code = p-curr-host-code no-lock,
    12074                 first ub.goods where ub.goods.artic = ub.cli-gds.artic
    12075                             and ub.goods.prod-type = ub.cli-gds.prod-type
    12076                             and ub.goods.prod-code = ub.cli-gds.prod-code no-lock:
    12077             run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12078           end.
    12079         end.
    12080       end.
    12081       when "cli-list" then do:
    12082         input stream sout from value (f-cli-name).
    12083         repeat:
    12084           import stream sout imp-type imp-code no-error.
    12085           for each ub.trn-doc where ub.trn-doc.cli-type = imp-type
    12086                             and ub.trn-doc.cli-code = imp-code no-lock:
    12087             for each ub.doc-line where ub.doc-line.doc-code = ub.trn-doc.doc-code no-lock,
    12088                 first ub.goods where ub.goods.artic = ub.doc-line.artic
    12089                               and ub.goods.prod-type = ub.doc-line.prod-type
    12090                               and ub.goods.prod-code = ub.doc-line.prod-code no-lock:
    12091               run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12092             end.
    12093           end.
    12094         end.
    12095       end.
    12096       when "file"
    12097       or when "clob-data"
    12098       then do:
    12099         repeat:
    12100           import stream sout imp-type imp-code imp-art scan-qnty no-error.
    12101           find ub.goods where ub.goods.prod-type = imp-type
    12102                       and ub.goods.prod-code = imp-code
    12103                       and ub.goods.artic     = imp-art no-lock no-error.
    12104           if available ub.goods then run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12105           if available ub.goods and  available gds-list and
    12106             gds-list.artic = ub.goods.artic and
    12107             gds-list.prod-type = ub.goods.prod-type and
    12108             gds-list.prod-code = ub.goods.prod-code then
    12109             gds-list.qnty = scan-qnty.
    12110         end.
    12111         if rs-list-method = "clob-data" then do:
    12112           os-delete value(v-full-path) .
    12113         end.
    12114       end.
    12115       when "scaner" then do:
    12116         repeat:
    12117           import stream sout unformatted ss.
    12118           ss = trim (ss).
    12119           if ss = "" then next.
    12120           if substr (ss, 1, 1) < "0" or substr (ss, 1, 1) > "9" then
    12121             if substr (ss, 1, 4) = "data" then ss = entry (2, ss, ":").
    12122             else next.
    12123           assign
    12124             scan-qnty = dec (entry (2, ss))
    12125             ss = trim (entry (1, ss)).
    12126   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
    12127   (
    12128    input  parparentproc
    12129   ,input  ss
    12130   ,input  ?
    12131   ,input  p-curr-obj-type
    12132   ,input  p-curr-obj-code
    12133   ,input  yes
    12134   ,input  no
    12135   ,input  varscales-pref
    12136   ,input  varpgscales-pref
    12137   ,output varresult
    12138   ,output vartype-bc
    12139   ,output varweight
    12140   ,buffer ub.bar-code
    12141   ,buffer ub.prod-bc
    12142   ,buffer ub.place
    12143   ) no-error.
    12144           if not available ub.bar-code then next.
    12145           bc-qnty = ub.bar-code.cli-base-rate.
    12146           find ub.goods where ub.goods.gds-code = ub.bar-code.gds-code NO-LOCK.
    12147           run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12148           if available gds-list and
    12149             gds-list.artic = ub.goods.artic and
    12150             gds-list.prod-type = ub.goods.prod-type and
    12151             gds-list.prod-code = ub.goods.prod-code then
    12152             gds-list.qnty = gds-list.qnty + scan-qnty * bc-qnty.
    12153         end.
    12154       end.
    12155     END CASE.
    12156     input stream sout close.
    12157     assign                                                           buf_gds-list-hist.num-add  = lns-cnt - v-num-add                       buf_gds-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_gds-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_gds-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
    12158     end.
    12159   end.
    12160   end procedure.
    12161   procedure analysis:
    12162   define input  parameter p-method as character no-undo .
    12163   define variable glog as logical   no-undo .
    12164   define variable v-run as character no-undo .
    12165   define variable an-option as character no-undo .
    12166   define variable v-tbl-name as character no-undo .
    12167   define variable v-bh as handle no-undo .
    12168   define variable v-recs as integer   no-undo .
    12169   define variable v-temp-seq as integer   no-undo .
    12170   define variable v-line as integer   no-undo .
    12171   define variable v-item as character no-undo .
    12172   define variable v-tot-lns as integer   no-undo .
    12173   do
    12174   on error undo, return error return-value
    12175   :
    12176     glog = yes.
    12177     CASE p-method:
    12178       when "abcxyz":U then do:
    12179         assign
    12180         dsp-rs = substitute("Товары ABC/XYZ анализа.&1&2",  stat-line(rs-status))
    12181         v-run = 'ref/abcxyzv.w':U
    12182         an-option = "abcxyz"
    12183         v-tbl-name = 'abcxyz-analysis':U
    12184         v-bh       = buffer ub.abcxyz-analysis:handle
    12185         .
    12186       end.
    12187       when "abc-analysis":U then do:
    12188         assign
    12189         dsp-rs = substitute("Товары ABC анализа.&1&2",  stat-line(rs-status))
    12190         v-run = 'ref/abcanal.w':U
    12191         an-option = "abc"
    12192         v-tbl-name = 'abc-analysis':U
    12193         v-bh       = buffer ub.abc-analysis:Handle
    12194         .
    12195       end.
    12196       when "xyz-analysis":U then do:
    12197         assign
    12198         dsp-rs = substitute("Товары XYZ анализа.&1&2",  stat-line(rs-status))
    12199         v-run = 'ref/xyzanal.w':U
    12200         an-option = "xyz"
    12201         v-tbl-name = 'xyz-analysis':U
    12202         v-bh       = buffer ub.xyz-analysis:Handle
    12203         .
    12204       end.
    12205     END CASE.
    12206     message
    12207     dsp-rs
    12208     view-as alert-box question buttons OK-Cancel update glog.
    12209     if not glog then do:
    12210       run UI-on  in this-procedure.
    12211       return error.
    12212     end.
    12213     run value(v-run)(parparentproc,"b-sel":U, output ref-list).
    12214     if ref-list <> "" then run ref/togabc.w (input an-option, output list-abcxyz).
    12215     if ref-list = "" or list-abcxyz = "" then do:
    12216       run UI-on in this-procedure.
    12217       return error.
    12218     end.
    12219     if num-entries(ref-list) = 1 then do:
    12220       CASE rs-list-method:
    12221         when "abcxyz":U then do:
    12222           find abcxyz-analysis where recid (abcxyz-analysis) = integer(entry(1, ref-list)) no-lock.
    12223           dsp-rs = substitute("ABCXYZ Анализ : &1&2&3"
    12224                               ,abcxyz-analysis.abcx-name
    12225                               , chr(10)
    12226                               , stat-line(rs-status)
    12227                               ).
    12228         end.
    12229         when "abc-analysis":U then do:
    12230           find abc-analysis where recid (abc-analysis) = integer(entry(1, ref-list)) no-lock.
    12231           dsp-rs = substitute("ABC Анализ : &1&2&3"
    12232                               ,abc-analysis.abc-name
    12233                               , chr(10)
    12234                               , stat-line(rs-status)
    12235                               ).
    12236         end.
    12237         when "xyz-analysis":U then do:
    12238           find xyz-analysis where recid (xyz-analysis) = integer(entry(1, ref-list)) no-lock.
    12239           dsp-rs = substitute("XYZ Анализ : &1&2&3"
    12240                               ,xyz-analysis.xyz-name
    12241                               ,chr(10)
    12242                               ,stat-line(rs-status)
    12243                               ).
    12244         end.
    12245       end CASE.
    12246       v-recs = num-entries(list-abcxyz).
    12247       do num-rec = 0 to v-recs:
    12248         if num-rec = 0 then do:
    12249           assign
    12250           v-temp-seq = v-seq
    12251           v-line     = 0
    12252           v-item     = '':U
    12253           v-tot-lns = tot-lns
    12254           .
    12255         end.
    12256         else do:
    12257           assign
    12258           v-temp-seq = v-seq - 1
    12259           v-line     = num-rec
    12260           dsp-rs = substitute("Группа &1", entry(num-rec, list-abcxyz))
    12261           v-item     = entry(num-rec, list-abcxyz)
    12262           v-tbl-name = '':U
    12263           v-bh       = ?
    12264           v-tot-lns = tot-lns + num-rec
    12265           .
    12266         end.
    12267         v-no-hist = (if num-rec = 1 then 0 else num-rec).
    12268         run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    12269                                             , input-output v-temp-seq
    12270                                             , input v-line
    12271                                             , input '':U
    12272                                             , input dsp-rs
    12273                                             , input v-tot-lns
    12274                                             , input rs-list-method
    12275                                             , input rs-status
    12276                                             , input v-item
    12277                                             , input v-tbl-name
    12278                                             , input v-bh
    12279                                             ).
    12280         if num-rec = 0 then v-seq  = v-temp-seq.
    12281       end.
    12282     end.
    12283   end.
    12284   end procedure.
    12285   procedure collection :
    12286   define input  parameter p-method as character no-undo .
    12287   define variable glog as logical   no-undo .
    12288   define variable v-run as character no-undo .
    12289   define variable an-option as character no-undo .
    12290   define variable v-tbl-name as character no-undo .
    12291   define variable v-bh as handle no-undo .
    12292   define variable v-recs as integer   no-undo .
    12293   define variable v-temp-seq as integer   no-undo .
    12294   define variable v-line as integer   no-undo .
    12295   define variable v-item as character no-undo .
    12296   define variable v-tot-lns as integer   no-undo .
    12297   do
    12298   on error undo, return error return-value
    12299   :
    12300     glog = yes.
    12301     CASE p-method:
    12302       when "collection":U then do:
    12303         assign
    12304         dsp-rs = substitute("Товары по коллекции.&1&2",  stat-line(rs-status))
    12305         v-run = 'ref/collec.w':U
    12306         an-option = "sea"
    12307         v-tbl-name = 'season'
    12308         v-bh       = buffer ub.season:Handle
    12309         .
    12310       end.
    12311     END CASE.
    12312     message
    12313     dsp-rs
    12314     view-as alert-box question buttons OK-Cancel update glog.
    12315     if not glog then do:
    12316       run UI-on.
    12317       return error.
    12318     end.
    12319     run value(v-run) (parParentProc, "b-sel":U, output ref-list).
    12320     if ref-list = "" then do:
    12321       run UI-on.
    12322       return error.
    12323     end.
    12324     if num-entries(ref-list) = 1 then do:
    12325       CASE rs-list-method:
    12326         when "collection":U then do:
    12327           find ub.season where recid (ub.season) = integer(entry(1, ref-list)) no-lock.
    12328           dsp-rs = substitute("Коллекция : &1&2&3"
    12329                               ,ub.season.sea-name
    12330                               , chr(10)
    12331                               , stat-line(rs-status)
    12332                               ).
    12333         end.
    12334       end CASE.
    12335       v-recs = num-entries(ref-list).
    12336       do num-rec = 0 to v-recs:
    12337         if num-rec = 0 then do:
    12338           assign
    12339           v-temp-seq = v-seq
    12340           v-line     = 0
    12341           v-item     = '':U
    12342           v-tot-lns = tot-lns
    12343           .
    12344         end.
    12345         else do:
    12346           assign
    12347           v-temp-seq = v-seq - 1
    12348           v-line     = num-rec
    12349           v-item     = entry(num-rec, ref-list)
    12350           v-tbl-name = '':U
    12351           v-bh       = ?
    12352           v-tot-lns = tot-lns + num-rec
    12353           .
    12354         end.
    12355         v-no-hist = (if num-rec = 1 then 0 else num-rec).
    12356         run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    12357                                             , input-output v-temp-seq
    12358                                             , input v-line
    12359                                             , input '':U
    12360                                             , input dsp-rs
    12361                                             , input v-tot-lns
    12362                                             , input rs-list-method
    12363                                             , input rs-status
    12364                                             , input v-item
    12365                                             , input v-tbl-name
    12366                                             , input v-bh
    12367                                             ).
    12368         if num-rec = 0 then v-seq  = v-temp-seq.
    12369       end.
    12370     end.
    12371   end.
    12372   end procedure.
    12373   procedure object-options :
    12374   define input  parameter p-method as character no-undo .
    12375   define variable glog as logical   no-undo .
    12376   define variable v-message as character no-undo .
    12377   define buffer buf_gds-list-hist for gds-list-hist.
    12378   define buffer buf_user-obj for ub.user-obj.
    12379   do
    12380   on error undo, return error return-value
    12381   :
    12382     glog = yes.
    12383     case p-method:
    12384       when "object" then do:
    12385         assign
    12386         v-message = substitute("Все товары из справочника товаров по объекту.&1&2"
    12387                                 , chr(10)
    12388                                 , stat-line(rs-status))
    12389         dsp-rs    = "Все товары по объекту : &1 &2"
    12390         .
    12391       end.
    12392       when "available"  then do:
    12393           assign
    12394           v-message = substitute("Все товары, остаток которых на объекте > 0.&1&2"
    12395                                 , chr(10)
    12396                                 , stat-line(rs-status))
    12397           dsp-rs =   "ВСЕ товары, имеющиеся в наличии на/в &1 &2"
    12398           .
    12399       end.
    12400       when "neg-rest" then do:
    12401           assign
    12402           v-message = substitute("Все товары с отрицательными остатками на объекте.&1&2"
    12403                                 , chr(10)
    12404                                 , stat-line(rs-status))
    12405           dsp-rs     = "ВСЕ товары с отрицательными остатками на/в &1 &2"
    12406           .
    12407       end.
    12408       when "neg-part" then do:
    12409           assign
    12410           v-message = substitute("Все товары, имеющие отрицательные партии на объекте (остаток при этом может быть любым).&1&2"
    12411                                 , chr(10)
    12412                                 , stat-line(rs-status))
    12413           dsp-rs    = "ВСЕ товары с отрицательными партиями на/в &1 &2"
    12414           .
    12415       end.
    12416       when "neg-part-free" then do:
    12417           assign
    12418           v-message = substitute("Все товары, имеющие отрицательные партии в свободной зоне на объекте (остаток при этом может быть любым).&1&2"
    12419                                 , chr(10)
    12420                                 , stat-line(rs-status))
    12421           dsp-rs    = "ВСЕ товары с отрицательными партиями в свободной зоне на/в &1 &2"
    12422           .
    12423       end.
    12424       when "neg-prt" then do:
    12425           assign
    12426           v-message = substitute("Все товары с признаками с отрицательными остатками по признакам на объекте.&1&2"
    12427                                 , chr(10)
    12428                                 , stat-line(rs-status))
    12429           dsp-rs    =  "ВСЕ товары с признаками с отриц. ост. по признаку на/в &1 &2"
    12430           .
    12431       end.
    12432       when "nul-rest" then do:
    12433           assign
    12434           v-message = substitute("Все товары с нулевыми остатками на объекте.&1&2"
    12435                                 , chr(10)
    12436                                 , stat-line(rs-status))
    12437           dsp-rs     = "ВСЕ товары с нулевыми остатками на/в &1 &2"
    12438           .
    12439       end.
    12440       when  "input" then do:
    12441         assign
    12442         v-message = substitute("Все товары, когда либо бывшие (или имеющиеся сейчас) на объекте.&1&2"
    12443                                 , chr(10)
    12444                                 , stat-line(rs-status))
    12445         dsp-rs = "ВСЕ товары, проходившие когда-либо по &1 &2"
    12446         .
    12447       end.
    12448       when "with-price" then do:
    12449         assign
    12450         v-message = substitute("Все товары на объекте, имеющие продажную цену > 0 .&1&2"
    12451                                 , chr(10)
    12452                                 , stat-line(rs-status))
    12453         dsp-rs     = "ВСЕ товары, имеющие цену > 0 по &1 &2"
    12454         .
    12455       end.
    12456       when "ov-req" then do:
    12457         assign
    12458         v-message = substitute("Товары, которые нельзя расходовать с объекта без переоценки&1" +
    12459                               "(попадающие под действие настройки, требующей переоценки после&1" +
    12460                               "любого прихода на объект).&1&2"
    12461                                 , chr(10)
    12462                                 , stat-line(rs-status))
    12463         dsp-rs = "Товары, по которым требуется переоценка после ПРИХОДА на/в &1 &2 "
    12464         .
    12465       end.
    12466       WHEN "inv-req" then do:
    12467         assign
    12468         v-message = substitute("Товары, количество по которым изменялось со времени последней&1" +
    12469                                 "инвентаризации на объекте (своей для каждого товара).&1&2"
    12470                                 , chr(10)
    12471                                 , stat-line(rs-status))
    12472         dsp-rs = "Товары, по которым были ОБОРОТЫ после ИНВЕНТАРИЗАЦИИ на/в &1 &2"
    12473         .
    12474       end.
    12475       when "etalon" then do:
    12476         ASSIGN
    12477         v-message = substitute("Все товары из справочника товаров по ТЕКУЩЕМУ объекту, цены по которым&1" +
    12478                                 "НЕ совпадают с ценами на выбранном ЭТАЛОННОМ объекте&1" +
    12479                                 "(только при условии, что цена есть на том и другом объектах).&1&2"
    12480                                 , chr(10)
    12481                                 , stat-line(rs-status))
    12482         dsp-rs = "Цены на/в &1 &2, не совпадающие с ценами на &3 &4"
    12483         .
    12484       end.
    12485     END CASE.
    12486     message v-message
    12487     view-as alert-box question buttons OK-Cancel update glog.
    12488     if not glog then do:
    12489       run UI-on  in this-procedure.
    12490       return error.
    12491     end.
    12492       ref-list = "":U.
    12493   define variable vss-include-info76 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12494   run userobjs_select-one in this-procedure
    12495     (input  parparentproc
    12496     ,input  v-cntxt-db-num
    12497     ,input  v-cntxt-userid
    12498     ,input  v-cntxt-host-code-obj
    12499     ,input  v-cntxt-obj-type
    12500     ,input  v-cntxt-obj-code
    12501     ,output v-user-select
    12502     ,output v-sel-obj-type
    12503     ,output v-sel-obj-code
    12504     )  .
    12505                            if not v-user-select then do:     run UI-on in this-procedure .     return no-apply.   end.
    12506       find first buf_user-obj no-lock where
    12507                 buf_user-obj.obj-type = v-sel-obj-type
    12508             and buf_user-obj.obj-code = v-sel-obj-code
    12509             AND buf_user-obj.db-num = v-cntxt-db-num
    12510             AND buf_user-obj.user-id = v-cntxt-userid  no-error .
    12511       if not available buf_user-obj then do:
    12512         run ui-on in this-procedure .
    12513         return error.
    12514       end.
    12515       if p-method = "etalon"
    12516       and p-curr-obj-type = v-sel-obj-type
    12517       and p-curr-obj-code = v-sel-obj-code then do:
    12518         message "Бессмысленно сравнивать цены для одного и того же объекта.".
    12519         run UI-on  in this-procedure.
    12520         return error.
    12521       end.
    12522       if p-method = "etalon":U then do:
    12523         assign
    12524         dsp-rs = replace(dsp-rs, "&1", p-curr-obj-type)
    12525         dsp-rs = replace(dsp-rs, "&2", string(p-curr-obj-code))
    12526         dsp-rs = replace(dsp-rs, "&3", v-sel-obj-type)
    12527         dsp-rs = replace(dsp-rs, "&4", string(v-sel-obj-code))
    12528         dsp-rs = substitute("&1 &2", dsp-rs, stat-line(rs-status))
    12529         .
    12530       end.
    12531       else do:
    12532         assign
    12533         dsp-rs = replace(dsp-rs, "&1", v-sel-obj-type)
    12534         dsp-rs = replace(dsp-rs, "&2", string(v-sel-obj-code))
    12535         dsp-rs = substitute("&1 &2", dsp-rs, stat-line(rs-status))
    12536         .
    12537       end.
    12538       run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    12539                                           , input-output v-seq
    12540                                           , input 0
    12541                                           , input '':U
    12542                                           , input dsp-rs
    12543                                           , input tot-lns
    12544                                           , input p-method
    12545                                           , input rs-status
    12546                                           , input '':U
    12547                                           , input 'user-obj':U
    12548                                           , input buffer buf_user-obj:handle
    12549                                           ).
    12550   end.
    12551   end procedure.
    12552   PROCEDURE reposition-goods :
    12553   define input  parameter p-direction   as character no-undo .
    12554   define output parameter p-recid as recid no-undo .
    12555   define buffer buf_goods for ub.goods.
    12556   case p-direction :
    12557     when "first":U
    12558     then do:
    12559       get first br-list.
    12560     end.
    12561     when "last":U
    12562     then do:
    12563       get last br-list.
    12564     end.
    12565     when "prev":U
    12566     then do:
    12567       get prev br-list.
    12568       if not available gds-list then do:
    12569         message
    12570         "Это первый товар списка"
    12571         view-as alert-box.
    12572       end.
    12573     end.
    12574     when "next":U
    12575     then do:
    12576       get next br-list.
    12577       if not available gds-list then do:
    12578         message
    12579         "Это последний товар списка"
    12580         view-as alert-box.
    12581       end.
    12582     end.
    12583   end case .
    12584   find first buf_goods no-lock where
    12585           buf_goods.gds-code = gds-list.gds-code no-error.
    12586   if available gds-list then do:
    12587     assign
    12588     p-recid = recid(buf_goods)
    12589     .
    12590   end.
    12591   run reposition-query in this-procedure
    12592     (input recid(gds-list)
    12593     ).
    12594   END PROCEDURE.
    12595   PROCEDURE reposition-query :
    12596   define input parameter p-recid as recid no-undo .
    12597   if p-recid <> ?
    12598   then do:
    12599     reposition br-list to recid p-recid no-error.
    12600   end.
    12601   do with frame Dialog-Frame:
    12602     apply "entry":u to browse br-list .
    12603     apply "VALUE-CHANGED":u to browse br-list .
    12604   end.
    12605   END PROCEDURE.
    12606   procedure cb_fill-lob-res-list :
    12607   define input  parameter p-full-path as character no-undo .
    12608   output to value (p-full-path).
    12609   for each gds-list:
    12610     export gds-list.prod-type
    12611           gds-list.prod-code
    12612           gds-list.artic
    12613           gds-list.qnty
    12614           .
    12615   end.
    12616   output close.
    12617   end procedure.
    12618   procedure cb_fill-lob-res-list-macro :
    12619   define input  parameter p-full-path as character no-undo .
    12620   define buffer buf_gds-list-hist for gds-list-hist.
    12621   output to value (p-full-path).
    12622   for each buf_gds-list-hist:
    12623       export
    12624       buf_gds-list-hist.
    12625   end.
    12626   output close.
    12627   end procedure.
    12628   procedure cb_get-next-gds-by-gds-code :
    12629   define input parameter p-gds-code as integer no-undo .
    12630   define input parameter p-bh as handle no-undo .
    12631   define buffer buf_gds-list for gds-list.
    12632   find first buf_gds-list no-lock where
    12633             buf_gds-list.gds-code > p-gds-code no-error.
    12634   if available buf_gds-list then do:
    12635     p-bh:buffer-create().
    12636     p-bh:buffer-copy(buffer buf_gds-list:handle).
    12637   end.
    12638   else do:
    12639   end.
    12640   end procedure.
    12641   procedure m-gds-save-db-proc :
    12642   define variable v-rid-list as character no-undo .
    12643   run ref/clobbnds.w ( input parparentproc
    12644                       ,input this-procedure:handle
    12645                       ,input 'b-add'
    12646                       ,input "uniq-key-rec"
    12647                       ,input 'ИЗМЕНЕНИЕ':U
    12648                       ,input 'list':U
    12649                       ,input 'gds-list'
    12650                       ,input -1
    12651                       ,input-output v-rid-list) no-error.
    12652   end procedure.
    12653   procedure m-macros-save-db-proc :
    12654   define variable v-rid-list as character no-undo .
    12655   run ref/clobbnds.w ( input parparentproc
    12656                       ,input this-procedure:handle
    12657                       ,input 'b-add'
    12658                       ,input "uniq-key-rec"
    12659                       ,input 'ИЗМЕНЕНИЕ':U
    12660                       ,input 'list-macro':U
    12661                       ,input 'gds-list'
    12662                       ,input -1
    12663                       ,input-output v-rid-list) no-error.
    12664   end procedure.
    12665   procedure grplib-get-full-name-alc-type :
    12666   do
    12667   on error undo, return error
    12668   :
    12669   define input parameter p-node-code  as integer      no-undo.
    12670   define output parameter p-full-name as character    no-undo.
    12671       define buffer buf_alc-type       for ub.alc-type.
    12672       find first buf_alc-type no-lock
    12673            where buf_alc-type.alc-type-inner-code = p-node-code
    12674       no-error.
    12675       if not available buf_alc-type
    12676       then do:
    12677           undo, return error "grplib-get-full-name-alc-type: Не найден вид алкогольной продукции с кодом " + string( p-node-code ).
    12678       end.
    12679       assign
    12680       p-full-name = buf_alc-type.alc-type-name
    12681       .
    12682   end.
    12683   end procedure.
