     1948   procedure fltfield-clear :
     1949     define output parameter loc-fld as character no-undo.
     1950     define output parameter loc-lab as character no-undo .
     1951     define output parameter loc-spr as character no-undo .
     1952     define output parameter loc-dim as character no-undo .
     1953     assign
     1954       loc-fld = ""
     1955       loc-lab = ""
     1956       loc-spr = ""
     1957       loc-dim = "0"
     1958     .
     1959   end procedure .
     1960   procedure fltfield-add :
     1961     define input        parameter par-fld as character no-undo.
     1962     define input        parameter par-lab as character no-undo .
     1963     define input        parameter par-spr as character no-undo .
     1964     define input-output parameter loc-fld as character no-undo.
     1965     define input-output parameter loc-lab as character no-undo .
     1966     define input-output parameter loc-spr as character no-undo .
     1967     define input-output parameter loc-dim as character no-undo .
     1968     do
     1969     on error undo, return error
     1970     :
     1971       assign
     1972       loc-fld = if loc-dim = '0'
     1973                 then par-fld
     1974                 else (loc-fld + chr(44) + par-fld)
     1975       loc-lab = if loc-dim = '0'
     1976                 then par-lab
     1977                 else (loc-lab + chr(44) + par-lab)
     1978       loc-spr = if loc-dim = '0'
     1979                 then par-spr
     1980                 else (loc-spr + chr(44) + par-spr)
     1981       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
     1982                 string(integer(if num-entries(loc-dim) > 1
     1983                               then entry(2, loc-dim)
     1984                               else entry(1, loc-dim)
     1985                               ) + 1)
     1986       no-error
     1987       .
     1988     end.
     1989   end procedure.
