     6734     gds-list.grp-name:resizable in browse br-list = true
     6735     RS-status:radio-buttons = "Текущие&+" + chr(44) + 'текущие':U + chr(44) +
     6736                               "Все!" + chr(44) + 'все':U + chr(44) +
     6737                               "Неактивные-" + chr(44) + 'удаленные':U
