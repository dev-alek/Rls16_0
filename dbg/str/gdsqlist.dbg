     6657         p-curr-obj-code = buf_clients.obj-code
     6658         p-curr-host-code = buf_clients.host-code
     6659         v-no-obj = yes
     6660         .
     6661       end.
     6662       else do:
     6663         message
     6664         "Текущий объект не может быть установлен" skip
     6665         view-as alert-box error .
     6666         undo, return error.
     6667       end.
     6668     end.
     6669     if not (p-curr-obj-type = '':U
     6670             and
     6671             p-curr-obj-code = 0) then do:
     6672       find first buf_clients no-lock
     6673           where buf_clients.obj-type = p-curr-obj-type
     6674           AND    buf_clients.obj-code = p-curr-obj-code no-error.
     6675       if not available buf_clients
     6676       or not (buf_clients.obj-type = 'маг':U
     6677         or
     6678         buf_clients.obj-type = 'скл':U
     6679         or buf_clients.host-code <> p-curr-host-code
     6680         )
     6681       then do:
     6682         assign
     6683         p-curr-obj-type = '':U
     6684         p-curr-obj-code = 0
     6685         p-curr-host-code = 0
     6686         .
     6687         message
     6688         vss-workfile vss-revision vss-description skip
     6689         "Неверно заданы входные параметры p-curr-host-code и/или p-curr-obj-type и/или p-curr-obj-code"
     6690         p-curr-host-code p-curr-obj-type p-curr-obj-code
