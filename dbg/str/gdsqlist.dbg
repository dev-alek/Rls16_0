    10323           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
    10324           assign
    10325           fld = fld
    10326           lab = lab
    10327           dim = dim + chr(44)
    10328           .
    10329           run fltfield-add in this-procedure('obj-name', 'Название производителя', '',
    10330           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
    10331           run fltfield-add in this-procedure('grp-name', 'Группа производителей', '',
    10332           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
    10333           run gbl/filter.w ( input parparentproc
    10334                             ,input c-point
    10335                             ,input tbl
    10336                             ,input join-tbl
    10337                             ,input fld
    10338                             ,input lab
    10339                             ,input spr
    10340                             ,input dim).
    10341           run gbl/flt-get.p (
    10342                            input  c-point
    10343                           ,output v-flt-rec
