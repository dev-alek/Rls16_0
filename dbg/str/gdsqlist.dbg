     3992   PROCEDURE proc-valchg-a-n-c:
     3993     case input frame Dialog-Frame a-n-c :
     3994       when "art" then do:
     3995         apply "entry" to br-list in frame Dialog-Frame.
     3996         hide loc-name loc-code
     3997         in frame Dialog-Frame.
     3998         loc-art = "".
     3999       end.
     4000       when "name" then do:
     4001         enable loc-name with frame Dialog-Frame.
     4002         disp loc-name with frame Dialog-Frame.
     4003         hide loc-art loc-code
     4004         in frame Dialog-Frame.
     4005         apply "entry" to loc-name in frame Dialog-Frame.
     4006       end.
     4007       when "code"
     4008    or when "DataMatrix" then
     4009       do:
     4010         enable loc-code with frame Dialog-Frame.
     4011         disp loc-code with frame Dialog-Frame.
     4012         hide loc-art loc-name
     4013         in frame Dialog-Frame.
     4014         apply "entry" to loc-code in frame Dialog-Frame.
     4015       end.
     4016     end CASE.
     4017   END PROCEDURE.
     4018   PROCEDURE proc-any-printable-br-list :
     4019     if input frame Dialog-Frame a-n-c = "art" then do:
     4020       if last-event:label = " " and
     4021          loc-art = "" then
     4022       return error.
     4023       find first l-gds-list where
     4024                   l-gds-list.artic begins (loc-art + last-event:label)
     4025                  no-lock no-error.
     4026       if available l-gds-list then do:
     4027         loc-art = loc-art + last-event:label.
     4028         disp loc-art with frame Dialog-Frame.
     4029         line-rec = recid (l-gds-list).
     4030         reposition br-list to recid line-rec no-error.
     4031         apply "value-changed" to br-list in frame Dialog-Frame.
     4032       end.
     4033     end.
     4034   END PROCEDURE.
     4035   PROCEDURE proc-backspace-br-list:
     4036     if input frame Dialog-Frame a-n-c = "art" then do:
     4037       if loc-art = "" then
     4038         return error.
     4039       loc-art = substr (loc-art, 1, length (loc-art) - 1).
     4040       find first l-gds-list where
     4041                   l-gds-list.artic begins loc-art
     4042                  no-lock.
     4043       disp loc-art with frame Dialog-Frame.
     4044       line-rec = recid (l-gds-list).
     4045       reposition br-list to recid line-rec no-error.
     4046       apply "value-changed" to br-list in frame Dialog-Frame.
     4047     end.
     4048   END PROCEDURE.
     4049   PROCEDURE proc-mouse-dbl-click-loc-code:
     4050   def var str-code as integer no-undo.
     4051   define variable varresult   as character         no-undo.
     4052   define variable vartype-bc  as character         no-undo.
     4053   define variable varweight   as decimal           no-undo.
     4054   define buffer l-goods for ub.goods.
     4055   define buffer l-bar-code for ub.bar-code.
     4056   define buffer buf_bar-code for ub.bar-code .
     4057   define buffer buf_prod-bc for ub.prod-bc.
     4058   define buffer buf_place for ub.place.
     4059     assign
     4060     frame Dialog-Frame
     4061     loc-code
     4062     a-n-c.
     4063     if a-n-c = "datamatrix"
     4064     then do:
     4065   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_dm-rcnz in g#libbcrcn
     4066   (
     4067    input  parparentproc
     4068   ,input  loc-code
     4069   ,input  ?
     4070   ,input  p-curr-obj-type
     4071   ,input  p-curr-obj-code
     4072   ,input  yes
     4073   ,input  no
     4074   ,input  varscales-pref30
     4075   ,input  varpgscales-pref30
     4076   ,output varresult
     4077   ,output vartype-bc
     4078   ,output varweight
     4079   ,buffer buf_bar-code
     4080   ,buffer buf_prod-bc
     4081   ,buffer buf_place
     4082   ) no-error.
     4083        if varresult eq "prod-bc"
     4084        then
     4085           loc-code:screen-value in frame Dialog-Frame = buf_prod-bc.b-str.
     4086     end.
     4087     else do:
     4088   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     4089   (
     4090    input  parparentproc
     4091   ,input  loc-code
     4092   ,input  ?
     4093   ,input  p-curr-obj-type
     4094   ,input  p-curr-obj-code
     4095   ,input  yes
     4096   ,input  no
     4097   ,input  varscales-pref30
