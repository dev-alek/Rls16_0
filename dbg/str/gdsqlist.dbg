    11228   define variable v-message as character no-undo .
    11229   define variable v-item as character no-undo .
    11230   define buffer buf_scales for ub.scales.
    11231   glog = yes.
    11232   CASE rs-list-method:
    11233     when "is-ptrl":U then do:
    11234       assign
    11235       v-message = substitute("Все топлива&1&2", chr(10), stat-line(rs-status))
    11236       .
    11237     end.
    11238     when "gds-office":U then do:
    11239       assign
    11240       v-message = substitute("Все услуги&1&2", chr(10), stat-line(rs-status))
    11241       .
    11242     end.
    11243   END CASE.
    11244   message
    11245   v-message
