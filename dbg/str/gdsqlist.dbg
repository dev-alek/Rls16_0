     5184           or error-status :get-message(1) <> ""
     5185           then do:
     5186             undo move_block, retry move_block .
     5187           end.
     5188         end.
     5189         assign
     5190           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     5191           no-error .
     5192         if error-status :error
     5193         or error-status :get-message(1) <> ""
     5194         then do:
     5195           undo move_block, retry move_block.
     5196         end.
     5197         assign
     5198           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     5199         no-error .
     5200         if error-status :error
     5201         or error-status :get-message(1) <> ""
     5202         then do:
     5203           undo move_block, retry move_block.
     5204         end.
     5205         if frame Dialog-Frame :scrollable = true
     5206         then do:
     5207           assign
     5208             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     5209           no-error .
     5210           if error-status :error
     5211           or error-status :get-message(1) <> ""
     5212           then do:
     5213             undo move_block, retry move_block.
     5214           end.
     5215         end.
     5216       end.
     5217       if p-move-resize
     5218       then do:
     5219         run diasize_position-resize-button in this-procedure .
     5220       end.
     5221       if v-diasize-wndstore = true
     5222       then do:
     5223         if connected("ub") = true
     5224         then do:
     5225           define variable v-cntxt-db-num        as integer   no-undo .
     5226           define variable v-cntxt-userid        as character no-undo .
     5227           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5228                                             , OUTPUT v-cntxt-userid
     5229                                             ) .
     5230           run gbl/wndsizew.p
     5231             (input  v-cntxt-db-num
     5232             ,input  v-cntxt-userid
     5233             ,input  v-diasize-proc-name
     5234             ,input  'width':u
     5235             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     5236             ) .
     5237         end.
     5238       end.
     5239     end.
     5240     assign
     5241       v-diasize-change-size = false
     5242     .
     5243   end procedure.
     5244   procedure diasize_set-width :
     5245     define input  parameter p-new-width  as decimal   no-undo .
     5246     define input  parameter p-move-resize as logical   no-undo .
     5247     do
     5248     on error undo, return error return-value
     5249     :
     5250       run diasize_change-width in this-procedure
     5251         (input  (p-new-width - frame Dialog-Frame :width)
     5252         ,input  p-move-resize
     5253         ) .
     5254     end.
     5255   end procedure.
     5256   procedure diasize_position-resize-button :
     5257     do with frame Dialog-Frame
     5258     :
     5259       hide v-diasize-resize-button .
     5260       assign
     5261         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     5262                     - 1
     5263                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     5264         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     5265                     - 1
     5266                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     5267       .
     5268       view v-diasize-resize-button .
     5269     end.
     5270   end procedure.
     5271   on alt-right anywhere
     5272   do:
     5273     run diasize_change-width in this-procedure
     5274       (input 1
     5275       ,input true
     5276       ) .
     5277     return no-apply .
     5278   end.
     5279   on alt-left anywhere
     5280   do:
     5281     run diasize_change-width in this-procedure
     5282       (input -1
     5283       ,input true
     5284       ) .
     5285     return no-apply .
     5286   end.
     5287   on alt-down anywhere
     5288   do:
     5289     run diasize_change-height in this-procedure
     5290       (input 1
     5291       ,input true
     5292       ) .
     5293     return no-apply .
     5294   end.
     5295   on alt-up anywhere
     5296   do:
     5297     run diasize_change-height in this-procedure
     5298       (input -1
     5299       ,input true
     5300       ) .
     5301     return no-apply .
     5302   end.
     5303   on alt-enter of frame Dialog-Frame
     5304   do:
     5305     run diasize_maximize in this-procedure
     5306       (input  ?
     5307       ).
     5308     return no-apply .
     5309   end.
     5310   procedure diasize_end-move :
     5311     do
     5312     on error undo, return error return-value
     5313     :
     5314       define variable v-row-delta as decimal   no-undo .
     5315       define variable v-col-delta as decimal   no-undo .
     5316       define variable v-new-row as decimal   no-undo .
     5317       define variable v-new-col as decimal   no-undo .
     5318       assign
     5319         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     5320         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     5321       .
     5322       assign
     5323         v-row-delta = v-new-row - frame Dialog-Frame :height
     5324         v-col-delta = v-new-col - frame Dialog-Frame :width
     5325       .
     5326       run diasize_change-height in this-procedure
     5327         (input v-row-delta
     5328         ,input true
     5329         ) .
     5330       run diasize_change-width in this-procedure
     5331         (input v-col-delta
     5332         ,input true
     5333         ) .
     5334     end.
     5335   end procedure.
     5336   procedure diasize_maximize :
     5337     define input  parameter p-action as logical   no-undo .
     5338     do
     5339     on error undo, return error return-value
     5340     :
     5341       if p-action = ?
     5342       then do:
     5343         if v-diasize-need-maximize = true
     5344         then do:
     5345           assign
     5346             p-action = true
     5347           .
     5348         end.
     5349         else do:
     5350           assign
     5351             p-action = false
     5352           .
     5353         end.
     5354       end.
     5355       if p-action = true
     5356       then do:
     5357         run diasize_change-height in this-procedure
     5358           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     5359               - frame Dialog-Frame :height-chars
     5360           ,input true
     5361           ) .
     5362         run diasize_change-width in this-procedure
     5363           (input session :width-chars
     5364               - frame Dialog-Frame :width-chars
     5365           ,input true
     5366           ) .
     5367         assign
     5368           v-diasize-need-maximize = false
     5369         .
     5370       end.
     5371       else do:
     5372         run diasize_change-width in this-procedure
     5373           (input v-diasize-orig-frame-width
     5374               - frame Dialog-Frame :width-chars
     5375           ,input true
     5376           ) .
     5377         run diasize_change-height in this-procedure
     5378           (input v-diasize-orig-frame-height
     5379               - frame Dialog-Frame :height-chars
     5380           ,input true
     5381           ) .
     5382         assign
     5383           v-diasize-need-maximize = true
     5384         .
     5385       end.
     5386     end.
     5387   end procedure.
     5388   procedure diasize_restore-orig-size :
     5389     do
     5390     on error undo, return error return-value
     5391     :
     5392       assign
     5393         v-diasize-current-frame-width  = frame Dialog-Frame :width
     5394         v-diasize-current-frame-height = frame Dialog-Frame :height
     5395       .
     5396       run diasize_set-height in this-procedure
     5397         (input  v-diasize-orig-frame-height
     5398         ,input  true
     5399         ) .
     5400       run diasize_set-width in this-procedure
     5401         (input  v-diasize-orig-frame-width
     5402         ,input  true
     5403         ) .
     5404     end.
     5405   end procedure.
     5406   procedure diasize_restore-current-size :
     5407     do
     5408     on error undo, return error return-value
     5409     :
     5410       run diasize_set-height in this-procedure
     5411         (input  v-diasize-current-frame-height
     5412         ,input  true
     5413         ) .
     5414       run diasize_set-width in this-procedure
     5415         (input  v-diasize-current-frame-width
     5416         ,input  true
     5417         ) .
     5418     end.
     5419   end procedure.
     5420   procedure diasize_set-browse-handle :
     5421     define input  parameter p-browse-handle as handle   no-undo .
     5422     define buffer buf_temp-browse-handle for temp-browse-handle .
     5423     do
     5424     on error undo, return error return-value
     5425     :
     5426       assign
     5427         v-diasize-browse-handle = p-browse-handle
     5428       .
     5429       for each buf_temp-browse-handle
     5430       on error undo, return error return-value
     5431       :
     5432         delete buf_temp-browse-handle .
     5433       end.
     5434     end.
     5435   end procedure.
     5436   procedure diasize_add_browse :
     5437     define input  parameter p-browse-type   as character no-undo .
     5438     define input  parameter p-browse-handle as handle    no-undo .
     5439     define buffer buf_temp-browse-handle for temp-browse-handle .
     5440     do
     5441     on error undo, return error return-value
     5442     :
     5443       assign
     5444         v-diasize-browse-number = v-diasize-browse-number + 1
     5445       .
     5446       create buf_temp-browse-handle .
     5447       assign
     5448         buf_temp-browse-handle.browse-type   = p-browse-type
     5449         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     5450         buf_temp-browse-handle.browse-handle = p-browse-handle
     5451       .
     5452     end.
     5453   end procedure.
     5454   procedure diasize_init :
     5455     define variable v-default-value    as logical   no-undo .
     5456     define variable v-restore-saved    as logical   no-undo .
     5457     define variable v-resize-value-str as character no-undo .
     5458     do
     5459     on error undo, return error return-value
     5460     :
     5461       do with frame Dialog-Frame
     5462       :
     5463         assign
     5464           v-diasize-orig-frame-height = frame Dialog-Frame :height
     5465           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     5466           v-diasize-browse-handle     = browse br-list :handle
     5467         .
     5468         create button v-diasize-resize-button
     5469         assign
     5470           parent        = frame Dialog-Frame :first-child
     5471           label         = "s"
     5472           height-pixels = 16
     5473           width-pixels  = 16
     5474           visible       = true
     5475           sensitive     = true
     5476           movable       = true
     5477           triggers:
     5478             on end-move persistent run diasize_end-move in this-procedure .
     5479           end triggers.
     5480         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     5481         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     5482         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     5483         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     5484         assign
     5485           v-diasize-wndmax = false
     5486         .
     5487         if connected("ub") = true
     5488         then do:
     5489           define variable v-cntxt-db-num        as integer   no-undo .
     5490           define variable v-cntxt-userid        as character no-undo .
     5491           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5492                                             , OUTPUT v-cntxt-userid
     5493                                             ) .
     5494           run gbl/wndpar_r.p
     5495             (input  v-cntxt-db-num
     5496             ,input  v-cntxt-userid
     5497             ,input  'wndmax':U
     5498             ,output v-diasize-wndmax
     5499             ,output v-default-value
     5500             ) .
     5501         end.
     5502         assign
     5503           v-diasize-wndstore = false
     5504         .
     5505         if connected("ub") = true
     5506         then do:
     5507           run gbl/wndpar_r.p
     5508             (input  v-cntxt-db-num
     5509             ,input  v-cntxt-userid
     5510             ,input  'wndstore':U
     5511             ,output v-diasize-wndstore
     5512             ,output v-default-value
     5513             ) .
     5514         end.
     5515         assign
     5516           v-diasize-proc-name = entry(1, program-name(2), '.')
     5517         .
     5518         if v-diasize-wndstore = true
     5519         then do:
     5520           assign
     5521             v-restore-saved = false
     5522           .
     5523           if connected("ub") = true
     5524           then do:
     5525             run gbl/wndsizer.p
     5526               (input  v-cntxt-db-num
     5527               ,input  v-cntxt-userid
     5528               ,input  v-diasize-proc-name
     5529               ,input  'height':u
     5530               ,output v-resize-value-str
     5531               ) .
     5532             if v-resize-value-str <> '':U
     5533             then do:
     5534               run diasize_change-height in this-procedure
     5535                 (input  integer(v-resize-value-str)
     5536                 ,input  true
     5537                 ) .
     5538               assign
     5539                 v-restore-saved = true
     5540               .
     5541             end.
     5542           end.
     5543           if connected("ub") = true
     5544           then do:
     5545             run gbl/wndsizer.p
     5546               (input  v-cntxt-db-num
     5547               ,input  v-cntxt-userid
     5548               ,input  v-diasize-proc-name
     5549               ,input  'width':u
     5550               ,output v-resize-value-str
     5551               ) .
     5552             if v-resize-value-str <> '':U
     5553             then do:
     5554               run diasize_change-width in this-procedure
     5555                 (input  integer(v-resize-value-str)
     5556                 ,input  true
     5557                 ) .
     5558               assign
     5559                 v-restore-saved = true
     5560               .
     5561             end.
     5562           end.
     5563           if v-restore-saved <> true
     5564           then do:
     5565             if v-diasize-wndmax = true
     5566             then do:
     5567               run diasize_maximize in this-procedure
     5568                 (input  true
     5569                 ) .
     5570             end.
     5571           end.
     5572         end.
     5573         else do:
     5574           if v-diasize-wndmax = true
     5575           then do:
     5576             run diasize_maximize in this-procedure
     5577               (input  true
     5578               ) .
     5579           end.
     5580         end.
     5581       end.
     5582     end.
     5583   end procedure.
     5584   procedure diasize_need-full-display :
     5585     define output parameter p-need-full-display as logical   no-undo .
     5586     do
     5587     on error undo, return error return-value
     5588     :
     5589       assign
     5590         p-need-full-display = v-diasize-need-full-display
     5591       .
     5592       assign
     5593         v-diasize-need-full-display = false
     5594       .
     5595     end.
     5596   end procedure.
     5597   procedure get-context :
     5598      define output parameter p-db-num as integer          no-undo.
     5599      define output parameter p-user-id as character        no-undo.
     5600      define variable v-login               as character    no-undo.
     5601      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     5602      define buffer buf_user-login  for ub.user-login .
     5603      do
     5604      on error undo, return error
     5605      :
     5606            FIND FIRST buf_sys-ctrl no-lock.
     5607            ASSIGN
     5608               v-login = USERID("ub")
     5609               p-db-num = buf_sys-ctrl.db-num
     5610            .
     5611            FIND FIRST buf_user-login
     5612                 WHERE buf_user-login.db-num = p-db-num
     5613                   AND buf_user-login.user-login = v-login
     5614                 no-lock
     5615                 no-error
     5616                 .
     5617            IF AVAILABLE buf_user-login
     5618            THEN DO:
     5619               assign
     5620                  p-user-id = buf_user-login.user-id
     5621               .
     5622            END.
     5623      end.
     5624   end procedure.
     5625   def var vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5626   def var vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5627   define variable v-no-context as logical no-undo .
     5628   define variable v-user-obj-type as character no-undo .
     5629   define variable v-user-obj-code as integer no-undo .
     5630   FUNCTION prepare-rowid returns character ( input p-uniq-key-rec as character
     5631                                            , input p-no-context as logical ):
     5632   define variable v-uniq-key-rec as character no-undo .
     5633   if p-no-context and p-uniq-key-rec begins 'user-obj':U then do:
     5634     v-uniq-key-rec = 'clients':U + chr(3) +
     5635                     entry(4, p-uniq-key-rec, chr(3)) + chr(3) +
     5636                     entry(5, p-uniq-key-rec, chr(3)).
     5637   end.
     5638   else do:
     5639     v-uniq-key-rec = p-uniq-key-rec.
     5640     case entry(1, p-uniq-key-rec, chr(3)):
     5641        when 'user-obj':U then do:
     5642          entry(lookup("user-id", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = v-cntxt-userid.
     5643          entry(lookup("db-num", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = string(v-cntxt-db-num).
     5644        end.
     5645     end case.
     5646   end.
     5647   return v-uniq-key-rec.
     5648   end function.
     5649   procedure find-user-obj-rowid :
     5650   define input parameter p-rowid as rowid no-undo .
     5651   define input parameter p-no-context as logical no-undo .
     5652   define output parameter p-user-obj-type as character no-undo .
     5653   define output parameter p-user-obj-code as integer no-undo .
     5654   define buffer user-obj_clients for ub.clients.
     5655   define buffer user-obj_user-obj for ub.user-obj .
     5656   if p-no-context then do:
     5657     find first user-obj_clients no-lock where rowid(user-obj_clients) = p-rowid.
     5658     assign
     5659     p-user-obj-type = user-obj_clients.obj-type
     5660     p-user-obj-code = user-obj_clients.obj-code.
     5661   end.
     5662   else do:
     5663     find first user-obj_user-obj no-lock where rowid(user-obj_user-obj) = p-rowid no-error.
     5664     if not available user-obj_user-obj then do:
     5665       undo, return error substitute("Не удалось выполнить в данной БД записанные действия пользователя").
     5666     end.
     5667     assign
     5668     p-user-obj-type = user-obj_user-obj.obj-type
     5669     p-user-obj-code = user-obj_user-obj.obj-code.
     5670   end.
     5671   end procedure.
     5672   define variable an-listp-start-macro-id as integer no-undo init ?.
     5673   define variable an-listp-end-macro-id as integer no-undo  init ?.
     5674   define variable an-listp-macros-label-id as integer   no-undo .
     5675   define variable v-macro-is-running as logical no-undo .
     5676   define variable v-current-step as integer no-undo .
     5677   define variable v-expand as logical no-undo .
     5678   define variable v-downed as character no-undo .
     5679   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5680   define     temp-table keep-macro-list-hist no-undo
     5681   field list-table as character
     5682   field id as integer
     5683   field line as integer
     5684   field hist-mode as character
     5685   field des as character
     5686   field num-recs as integer
     5687   field option_ as character
     5688   field item_ as character
     5689   field status_ as character
     5690   field num-add as integer
     5691   field num-ignored as integer
     5692   field done as logical
     5693   field err_ as logical
     5694   field err-mes as character
     5695   index pi is primary
     5696   id
     5697   line
     5698   index isdone
     5699   done
     5700   .
     5701   procedure assign-nums :
     5702   define input-output parameter p-num-add as integer no-undo .
     5703   define input-output parameter p-num-rec as integer no-undo .
     5704   define input-output parameter p-num-ignored as integer no-undo .
     5705   define input parameter p-line-mode as character no-undo .
     5706   assign
     5707   p-num-add  = lns-cnt - v-num-add
     5708   p-num-rec = (if line-mode = 'ОСТАВИТЬ':U
     5709                             then (tot-lns + p-num-add)
     5710                             else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))
     5711   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)
     5712   p-num-ignored = lns-ignore  - v-num-ignored
     5713   v-num-add             = lns-cnt
     5714   v-num-ignored         = lns-ignore
     5715   .
     5716   END PROCEDURE.
     5717   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     5718   or INSERT-MODE of br-list
     5719   DO:
     5720   define variable glog as logical no-undo .
     5721   define buffer buf-gds-list-hist for gds-list-hist.
     5722   define buffer buf_macro-list-hist for macro-list-hist.
     5723   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     5724    if p-keep-query then do:
     5725       glog = no.
     5726       message "Реинициализация списка. Вы уверены ?"
     5727               view-as alert-box question buttons OK-Cancel update glog.
     5728       if not glog then return no-apply.
     5729       if session:set-wait-state( "COMPILER" )  then .
     5730       for each gds-list:
     5731         delete gds-list.
     5732       end.
     5733       if session:set-wait-state( "" )  then .
     5734       tot-lns = 0.
     5735       v-seq = 1.
     5736       for each buf-gds-list-hist:
     5737         delete buf-gds-list-hist.
     5738       end.
     5739      for each buf_keep-macro-list-hist:
     5740        create buf_macro-list-hist.
     5741      end.
     5742      run proc-macro-play in this-procedure ( input 0, input yes, input 0).
     5743      run create-gds-list-hist in this-procedure (
     5744                                             input 'ДОБАВЛЕНИЕ':U
     5745                                           , input-output v-seq
     5746                                           , input 0
     5747                                           , input '0':U
     5748                                           , input "# Реинициализация списка."
     5749                                           , input 0
     5750                                           , input "init"
     5751                                           , input '':U
     5752                                           , input '':U
     5753                                           , input '':U
     5754                                           , input ?
     5755                                           ).
     5756       display
     5757       tot-lns @ f-tot-lns
     5758       ? @ ub.clients.obj-name
     5759       ? @ ub.gds-prt.node-name
     5760       ? @ ub.bar-code.b-code
     5761       with frame Dialog-Frame.
     5762       run ui-on in this-procedure .
     5763    end.
     5764    else do:
     5765      assign rs-list-method = "single".
     5766      run proc-b-add in this-procedure(input no
     5767                                     ,input ?
     5768                                     ,input rs-list-method
     5769                                     ,input rs-status)  no-error .
     5770     if error-status:error then return no-apply.
     5771   end.
     5772   END.
     5773   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     5774   or DELETE-CHARACTER of br-list
     5775   DO:
     5776     if not available gds-list then return no-apply.
     5777     assign rs-list-method = "single".
     5778       run proc-b-del in this-procedure(
     5779                                                  input no
     5780                                                 ,input ?
     5781                                                 ,input rs-list-method
     5782                                                 ,input rs-status) no-error .
     5783     if error-status:error then return no-apply.
     5784   END.
     5785   ON CHOOSE OF B-rest IN FRAME Dialog-Frame
     5786   DO:
     5787   if not available gds-list then return no-apply.
     5788     assign rs-list-method = "single".
     5789    run proc-b-rest in this-procedure(
     5790                                                   input no
     5791                                                  ,input ?
     5792                                                  ,input rs-list-method
     5793                                                  ,input rs-status) no-error .
     5794     if error-status:error then return no-apply.
     5795   END.
     5796   on choose of MENU-ITEM m-macro-file in menu m-play DO:
     5797     assign
     5798     macro-play-option = 'file':U.
     5799     APPLY "CHOOSE" to b-macro in frame Dialog-Frame.
     5800   end.
     5801   on choose of MENU-ITEM m-macro-lob in menu m-play DO:
     5802     assign
     5803     macro-play-option = 'lob':U.
     5804     APPLY "CHOOSE" to b-macro in frame Dialog-Frame.
     5805   end.
     5806   ON CHOOSE OF B-macro IN FRAME Dialog-Frame
     5807   DO:
     5808   if macro-play-option = '':U then do:
     5809         run gbl/pop-up.p ( input self:handle, input no) no-error.
     5810   end.
     5811   if macro-play-option = '':U then return no-apply.
     5812   run proc-b-macro in this-procedure ( input macro-play-option) no-error .
     5813   if error-status:error then return no-apply.
     5814   END.
     5815   ON CHOOSE OF B-record IN FRAME Dialog-Frame
     5816   DO:
     5817   define variable glog as logical no-undo .
     5818   message
     5819   "Начать запись макроса формирования списка?"
     5820   view-as alert-box QUESTION buttons yes-no update glog.
     5821   if not glog then return no-apply.
     5822   assign
     5823   an-listp-start-macro-id = v-seq
     5824   an-listp-end-macro-id = ?
     5825   .
     5826     menu-item m-macro-file:label in menu m-play = "Ранее записанный макрос формирования списка товаров".
     5827     menu-item m-macro-lob:sensitive in menu m-play = no.
     5828   disable
     5829   b-record with frame Dialog-Frame .
     5830   hide
     5831   b-record
     5832   b-macro
     5833   in frame Dialog-Frame .
     5834   enable
     5835   b-stop with frame Dialog-Frame .
     5836   run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     5837                                       , input-output v-seq
     5838                                       , input 0
     5839                                       , input 'o':U
     5840                                       , input "Начата запись макроса формирования списка"
     5841                                       , input tot-lns
     5842                                       , input 'macro':U
     5843                                       , input '':U
     5844                                       , input '':U
     5845                                       , input '':U
     5846                                       , input ?
     5847                                       ).
     5848   END.
     5849   ON CHOOSE OF B-stop IN FRAME Dialog-Frame
     5850   DO:
     5851   define variable glog as logical no-undo .
     5852   define variable v-id as integer no-undo .
     5853   define buffer buf_gds-list-hist for gds-list-hist.
     5854   message
     5855   "Закончить запись макроса формирования списка?"
     5856   view-as alert-box QUESTION buttons yes-no update glog.
     5857   if not glog then return no-apply.
     5858   assign
     5859   an-listp-end-macro-id = v-seq.
     5860   disable
     5861   b-stop with frame Dialog-Frame .
     5862   hide
     5863   b-stop in frame Dialog-Frame .
     5864   enable
     5865   b-record
     5866   b-macro
     5867   with frame Dialog-Frame .
     5868   run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     5869                                       , input-output v-seq
     5870                                       , input 0
     5871                                       , input '[]':U
     5872                                       , input "Закончена запись макроса формирования списка"
     5873                                       , input tot-lns
     5874                                       , input 'macro':U
     5875                                       , input '':U
     5876                                       , input '':U
     5877                                       , input '':U
     5878                                       , input ?
     5879                                       ).
     5880   for each macro-list-hist:
     5881     delete macro-list-hist.
     5882   end.
     5883   for each buf_gds-list-hist where
     5884           buf_gds-list-hist.id >=  an-listp-start-macro-id
     5885     and  buf_gds-list-hist.id <=  an-listp-end-macro-id:
     5886     create macro-list-hist.
     5887     buffer-copy buf_gds-list-hist
     5888     except id num-recs num-add num-ignored
     5889     to macro-list-hist
     5890     assign
     5891     macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     5892     v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     5893     .
     5894   end.
     5895   END.
     5896   ON CHOOSE OF b-clear-macro IN FRAME Dialog-Frame
     5897   DO:
     5898   disable
     5899   b-clear-macro with frame Dialog-Frame .
     5900   assign
     5901   an-listp-start-macro-id = ?
     5902   an-listp-end-macro-id = ?
     5903   an-listp-macros-label-id = 0
     5904   .
     5905   menu-item m-macro-lob:sensitive in menu m-play = yes.
     5906   for each macro-list-hist:
     5907     delete macro-list-hist.
     5908   end.
     5909   hide
     5910   b-clear-macro in frame Dialog-Frame .
     5911   enable
     5912   b-record
     5913   b-macro
     5914   with frame Dialog-Frame .
     5915   END.
     5916   ON VALUE-CHANGED OF br-option IN FRAME Dialog-Frame
     5917   DO:
     5918     assign
     5919     Rs-list-method = temp-list.fvalue
     5920     .
     5921     run proc-vc-rs-list-method in this-procedure no-error .
     5922     if error-status:error then return no-apply.
     5923   END.
     5924   PROCEDURE get-operation :
     5925   define input parameter p-message as character no-undo .
     5926   define output parameter p-operation as integer no-undo .
     5927     do
     5928     on error undo, return error
     5929     :
     5930       run gbl/d-askw.w (
     5931                     input "Выбор операции над заданным списком"
     5932                    ,input (p-message + chr(10) +
     5933                            "Выберите операцию, которую Вы хотите применить к полученному списку" +  chr(10) )
     5934                    ,input "|"
     5935                   ,input  ("Добавить" + (if p-keep-query then "^disable" else '':U) + "|" +
     5936                            "Удалить" + "|" +
     5937                            "Оставить" + "|" +
     5938                            "Отказ")
     5939                    ,input ("Добавить полученный список к уже имеющемуся" + "|" +
     5940                           "Удалить полученный список из уже имеющегося" + "|" +
     5941                           "Оставить в уже имеющемся списке только элементы полученного списка" +  "|" +
     5942                           "Ничего не делать")
     5943                    ,input  (if p-keep-query then 2 else 1)
     5944                    ,input  4
     5945                    ,output p-operation).
     5946      if p-operation = 4 then do:
     5947         return error .
     5948      end.
     5949     end.
     5950   END PROCEDURE.
