    11166   PROCEDURE proc-parts-fib :
    11167   define input parameter rs-list-method as character no-undo .
    11168   define variable v-value-integer as integer   no-undo .
    11169   define variable glog as logical no-undo .
    11170   define variable v-message as character no-undo .
