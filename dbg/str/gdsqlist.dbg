     5978   END PROCEDURE.
     5979   procedure proc-b-macro :
     5980   define input parameter p-option as character no-undo .
     5981   define variable glog as logical no-undo .
     5982   define variable v-id as integer no-undo .
     5983   define variable v-result as character no-undo .
     5984   define variable v-des as character no-undo .
     5985   define variable v-hist-mode as character no-undo .
     5986   define variable v-file as logical no-undo .
     5987   define variable v-full-path        as character no-undo .
     5988   define variable v-path             as character no-undo .
     5989   define variable v-file-name        as character no-undo .
     5990   define variable v-file-name-no-ext as character no-undo .
     5991   define variable v-file-name-ext    as character no-undo .
     5992   define variable v-rid-list as character no-undo .
     5993   define variable v-ok as logical no-undo .
     5994   define buffer buf_gds-list-hist for gds-list-hist.
     5995   define buffer buf_clob-bind for ub.clob-bind.
     5996   define buffer buf_clob-data for ub.clob-data.
     5997   do
     5998   on error undo, return error
     5999   :
     6000     if v-macro-is-running then do:
     6001     end.
     6002     else do:
     6003       glog = yes.
     6004       if an-listp-start-macro-id >= 1 then do:
     6005         case p-option:
     6006           when "file" then do:
     6007         message
     6008         "Согласно командам формирования списка из записанного макроса"
     6009         view-as alert-box question buttons OK-Cancel update glog.
     6010           end.
     6011           when "lob" then do:
     6012             message
     6013             "Нелья!"
     6014             view-as alert-box question buttons OK-Cancel update glog.
     6015             run ui-on in this-procedure .
     6016             return error.
     6017           end.
     6018         end case.
     6019         if not glog then do:
     6020           run ui-on in this-procedure .
     6021           return error.
     6022         end.
     6023         if an-listp-end-macro-id = ? then do:
     6024           assign
     6025           an-listp-end-macro-id  = v-seq.
     6026           for each macro-list-hist:
     6027             delete macro-list-hist.
     6028           end.
     6029           for each buf_gds-list-hist where
     6030                   buf_gds-list-hist.id >=  an-listp-start-macro-id
     6031             and  buf_gds-list-hist.id <=  an-listp-end-macro-id:
     6032             create macro-list-hist.
     6033             buffer-copy buf_gds-list-hist
     6034             except id num-recs num-add num-ignored
     6035             to macro-list-hist
     6036             assign
     6037             macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6038             v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6039             macro-list-hist.done = no
     6040             .
     6041           end.
     6042         end.
     6043         else do:
     6044           find last macro-list-hist no-error.
     6045           if available macro-list-hist then do:
     6046             v-id = macro-list-hist.id.
     6047           end.
     6048         end.
     6049       end.
     6050       else do:
     6051         case p-option:
     6052           when "file" then do:
     6053         message
     6054         "Согласно командам формирования списка из ранее сохраненного в файле макроса"
     6055         view-as alert-box question buttons OK-Cancel update glog.
     6056         if not glog then do:
     6057           run ui-on in this-procedure .
     6058           return error.
     6059         end.
     6060         system-dialog get-file f-name
     6061           filters "Макрос формирования списка *.gdm" "*.gdm"
     6062           title "Выберите файл макроса"
     6063           INITIAL-DIR "."
     6064           return-to-start-dir
     6065           must-exist
     6066           update glog
     6067           default-extension "gdm".
     6068         if not glog then do:
     6069           run ui-on in this-procedure .
     6070           return error.
     6071         end.
     6072           end.
     6073           when "lob" then do:
     6074             message
     6075             "Согласно командам формирования списка из макроса, сохраненного в БД"
     6076             view-as alert-box question buttons OK-Cancel update glog.
     6077             if not glog then do:
     6078               run ui-on in this-procedure .
     6079               return error.
     6080             end.
     6081             run ref/clobbnds.w ( input parparentproc
     6082                                 ,input this-procedure:handle
     6083                                 ,input 'b-sel'
     6084                                 ,input "uniq-key-rec"
     6085                                 ,input ""
     6086                                 ,input 'list-macro':U
     6087                                 ,input 'gds-list'
     6088                                 ,input -1
     6089                                 ,input-output v-rid-list) no-error.
     6090             if v-rid-list = '' then do:
     6091               run ui-on in this-procedure.
     6092               return error.
     6093             end.
     6094             find first buf_clob-bind no-lock where
     6095                       recid(buf_clob-bind) = integer(v-rid-list) no-error.
     6096             if not available buf_clob-bind then do:
     6097               message
     6098               "Не найдена ссылка на макрос, сохраненный в БД!"
     6099               view-as alert-box error .
     6100               run ui-on in this-procedure .
     6101               return error.
     6102             end.
     6103             find first buf_clob-data no-lock where
     6104                       buf_clob-data.db-num = buf_clob-bind.db-num
     6105                   and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     6106             if not available buf_clob-data then do:
     6107               message
     6108               "Не найдена ссылка на макрос, сохраненный в БД!"
     6109               view-as alert-box error .
     6110               run ui-on in this-procedure .
     6111               return error.
     6112             end.
     6113             if buf_clob-data.db-num <> v-cntxt-db-num then do:
     6114               message
     6115               substitute("Возможно, не все действия пользователя БД &1 удастся воспроизвести!&2Продолжить?"
     6116                         , buf_clob-data.db-num
     6117                         , chr(10))
     6118              view-as alert-box question buttons yes-no update v-ok.
     6119              if not v-ok then do:
     6120                 run ui-on in this-procedure .
     6121                 return error.
     6122              end.
     6123             end.
     6124             run gbl/_tmpfile.p ( input ""
     6125                           ,input "tmp"
     6126                           ,output v-file-name) .
     6127             copy-lob from object buf_clob-data.cdata
     6128             to file f-name.
     6129             run gbl/filename.p
     6130               (input  v-file-name
     6131               ,output f-name
     6132               ,output v-path
     6133               ,output v-file-name
     6134               ,output v-file-name-no-ext
     6135               ,output v-file-name-ext
     6136               ) no-error .
     6137             if error-status:error then do:
     6138             end.
     6139           end.
     6140         end case.
     6141         for each macro-list-hist:
     6142           delete macro-list-hist.
     6143         end.
     6144         input stream sout from value (f-name).
     6145         _macro:
     6146         repeat:
     6147           create macro-list-hist.
     6148           import stream sout macro-list-hist no-error.
     6149           if error-status:error then do:
     6150               undo _macro, next _macro.
     6151           end.
     6152           assign
     6153           macro-list-hist.num-rec = 0
     6154           macro-list-hist.num-add = 0
     6155           macro-list-hist.num-ignored = 0
     6156           v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6157           macro-list-hist.done = no
     6158           .
     6159         end.
     6160         find first macro-list-hist where
     6161                 macro-list-hist.id = 0.
     6162         delete macro-list-hist.
     6163         input stream sout close.
     6164         If p-option = "lob" then do:
     6165          os-delete value(f-name).
     6166         end.
     6167         v-file = yes.
     6168       end.
     6169       an-listp-macros-label-id = v-seq.
     6170       run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     6171                                           , input-output v-seq
     6172                                           , input 0
     6173                                           , input '>':U
     6174                                           , input (if v-file
     6175                                                   then substitute("Файл макроса : &1", f-name)
     6176                                                   else substitute("Записанный макрос")
     6177                                                   )
     6178                                           , input tot-lns
     6179                                           , input 'macro':U
     6180                                           , input '':U
     6181                                           , input (if v-file then f-name else '':U)
     6182                                           , input '':U
     6183                                           , input ?
     6184                                           ).
     6185     end.
     6186     disable
     6187     b-record
     6188     b-macro
     6189     with frame Dialog-Frame .
     6190     hide
     6191     b-record in frame Dialog-Frame .
     6192     enable
     6193     b-clear-macro with frame Dialog-Frame .
     6194     v-macro-is-running = yes.
     6195     run str/listmcro.w (input parparentproc
     6196                   ,input this-procedure:handle
     6197                   ,input "Макрос формирования списка товаров" + chr(4) + "gdm"
     6198                   ,input "b-play,b-step"
     6199                   ,input-output v-current-step
     6200                   ,input v-id
     6201                   ,output v-result) no-error .
     6202     if error-status:error
     6203     or v-result = "b-stop"
     6204     or v-result = 'end':U
     6205     then do:
     6206       for each macro-list-hist:
     6207         delete macro-list-hist.
     6208       end.
     6209       assign
     6210       an-listp-start-macro-id = ?
     6211       an-listp-end-macro-id = ?
     6212       an-listp-macros-label-id = 0
     6213       .
     6214       menu-item m-macro-file:label in menu m-play = "Сохраненный в файле макрос формирования списка товаров".
     6215       menu-item m-macro-lob:sensitive in menu m-play = yes.
     6216       if v-result = 'b-stop' then do:
     6217         assign
     6218         v-hist-mode = '[]':U
     6219         v-des = "Выполнение макроса прекращено пользователем"
     6220         .
     6221         hide
     6222         b-clear-macro
     6223         b-stop
     6224         in frame Dialog-Frame .
     6225         enable
     6226         b-record
     6227         with frame Dialog-Frame .
     6228       end.
     6229       if v-result = 'end' then do:
     6230         assign
     6231         v-hist-mode = '<':U
     6232         v-des = "Выполнение макроса завершено"
     6233         .
     6234         hide
     6235         b-clear-macro
     6236         b-stop
     6237         in frame Dialog-Frame .
     6238         enable
     6239         b-record
     6240         with frame Dialog-Frame .
     6241       end.
     6242       if error-status:error then do:
     6243         assign
     6244         v-hist-mode = 'E':U
     6245         v-des = "Выполнение макроса прекращено из-за ошибки"
     6246         .
     6247       end.
     6248       run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     6249                                           , input-output v-seq
     6250                                           , input 0
     6251                                           , input v-hist-mode
     6252                                           , input v-des
     6253                                           , input tot-lns
     6254                                           , input 'macro':U
     6255                                           , input '':U
     6256                                           , input f-name
     6257                                           , input '':U
     6258                                           , input ?
     6259                                           ) no-error .
     6260       assign
     6261       v-macro-is-running = no
     6262       v-current-step = 0
     6263       .
     6264     end.
     6265     enable
     6266     b-macro
     6267     with frame Dialog-Frame .
     6268   end.
     6269   end procedure.
     6270   procedure proc-create-macro-list-hist :
     6271   define input parameter p-list-table as character no-undo .
     6272   define input parameter p-id as integer           no-undo .
     6273   define input parameter p-line as integer         no-undo .
     6274   define input parameter p-hist-mode as character  no-undo .
     6275   define input parameter p-des as character        no-undo .
     6276   define input parameter p-option_ as character    no-undo .
     6277   define input parameter p-item_ as character      no-undo .
     6278   define input parameter p-status_ as character    no-undo .
     6279   define buffer buf_macro-list-hist for macro-list-hist.
     6280   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     6281     do
     6282     on error undo, return error return-value
     6283     :
     6284       create buf_macro-list-hist.
     6285       assign
     6286       buf_macro-list-hist.list-table = p-list-table
     6287       buf_macro-list-hist.id         = p-id
     6288       buf_macro-list-hist.line       = p-line
     6289       buf_macro-list-hist.hist-mode  = p-hist-mode
     6290       buf_macro-list-hist.des        = p-des
     6291       buf_macro-list-hist.option_    = p-option_
     6292       buf_macro-list-hist.item_      = p-item_
     6293       buf_macro-list-hist.status_    = p-status_
     6294       .
     6295       if p-keep-query then do:
     6296         create buf_keep-macro-list-hist.
     6297         buffer-copy buf_macro-list-hist to buf_keep-macro-list-hist.
     6298       end.
     6299     end.
     6300   end procedure.
     6301   procedure proc-macro-play :
     6302   define input parameter p-id as integer no-undo .
     6303   define input parameter p-step as logical no-undo .
     6304   define input parameter p-max-id as integer no-undo .
     6305   define variable v-id as integer no-undo .
     6306   define variable v-rowid   as rowid no-undo .
     6307   define variable v-tbl-name as character no-undo .
     6308   define variable v-old-seq as integer no-undo .
     6309   define variable v-current-id as integer no-undo .
     6310   define variable v-temp-seq as integer no-undo .
     6311   define variable v-rs-do-error as logical no-undo .
     6312   define  buffer buf_macro-list-hist for macro-list-hist.
     6313   define  buffer buf_gds-list-hist for gds-list-hist.
     6314   do
     6315   on error undo, return error return-value
     6316   :
     6317     for each macro-list-hist where (p-id = 0 or macro-list-hist.id = p-id):
     6318       assign
     6319       v-current-id = v-current-id + 1
     6320       v-id = macro-list-hist.id.
     6321       CASE entry(1, macro-list-hist.option_, chr(4)):
     6322         when 'macro':U
     6323         or
     6324         when 'title':U
     6325         or
     6326         when 'start':U
     6327         then do:
     6328         end.
     6329         when 'clear':U then do:
     6330           for each gds-list:
     6331             delete gds-list.
     6332           end.
     6333           for each gds-list-hist where gds-list-hist.id > an-listp-macros-label-id:
     6334             delete gds-list-hist.
     6335           end.
     6336           tot-lns = 0.
     6337           v-seq = an-listp-macros-label-id + 1.
     6338           v-no-hist = 0.
     6339           create buf_gds-list-hist.
     6340           buffer-copy macro-list-hist
     6341           to buf_gds-list-hist
     6342           assign buf_gds-list-hist.id = v-seq
     6343           v-temp-seq = v-seq
     6344           v-seq = v-seq + 1
     6345           v-no-hist = v-no-hist + 1
     6346           .
     6347           run ui-on in this-procedure .
     6348         end.
     6349         when 'single' then do:
     6350            run gen-row-keyr  in this-procedure (  input  macro-list-hist.item_
     6351                                                 ,input ?
     6352                                                 ,input 'ub'
     6353                                                 ,input ?
     6354                                                 ,input no-lock
     6355                                                 ,output v-rowid
     6356                                                 ,output v-tbl-name) no-error .
     6357           if not error-status:error then do:
     6358             CASE macro-list-hist.hist-mode:
     6359               when '+':U then do:
     6360                 run proc-b-add in this-procedure(input yes
     6361                                                 ,input v-rowid
     6362                                                 ,input macro-list-hist.option_
     6363                                                 ,input macro-list-hist.status_) no-error .
     6364               end.
     6365               when '-':U then do:
     6366                 run proc-b-del in this-procedure(input yes
     6367                                                 ,input v-rowid
     6368                                                 ,input macro-list-hist.option_
     6369                                                 ,input macro-list-hist.status_) no-error .
     6370               end.
     6371               when '*':U then do:
     6372                 run proc-b-rest in this-procedure(input yes
     6373                                                  ,input v-rowid
     6374                                                  ,input macro-list-hist.option_
     6375                                                  ,input macro-list-hist.status_) no-error .
     6376               end.
     6377             END.
     6378             if error-status:error then do:
     6379                 return ("error" + chr(4) + return-value) .
     6380             end.
     6381             find first  buf_gds-list-hist where
     6382                     buf_gds-list-hist.id = v-seq - 1 no-error .
     6383             if available buf_gds-list-hist then
     6384             assign
     6385             macro-list-hist.num-recs = buf_gds-list-hist.num-recs
     6386             macro-list-hist.num-add = buf_gds-list-hist.num-add
     6387             macro-list-hist.num-ignored = buf_gds-list-hist.num-ignored
     6388             .
     6389           end.
     6390           else do:
     6391             return ("error" + chr(4) + return-value).
     6392           end.
     6393         end.
     6394         otherwise do:
     6395           if can-find(first temp-list where temp-list.fvalue = macro-list-hist.option_)
     6396           or lookup(macro-list-hist.option_, '':U) > 0
     6397           then do:
     6398             if macro-list-hist.line = 0 then do:
     6399               v-no-hist = 0.
     6400               for each buf_macro-list-hist where
     6401                       buf_macro-list-hist.id = v-id:
     6402                 create buf_gds-list-hist.
     6403                 buffer-copy buf_macro-list-hist
     6404                 except id  num-recs num-add num-ignored done
     6405                 to buf_gds-list-hist
     6406                 assign
     6407                 buf_gds-list-hist.id = (if buf_macro-list-hist.line =0 then v-seq else v-temp-seq)
     6408                 v-temp-seq = (if buf_macro-list-hist.line = 0 then v-seq else v-temp-seq )
     6409                 v-seq = (if buf_macro-list-hist.line = 0
     6410                         then (v-seq + 1)
     6411                         else v-seq)
     6412                 v-no-hist = v-no-hist + 1
     6413                 .
     6414               end.
     6415               if v-no-hist = 1 then v-no-hist = 0.
     6416               run rs-do in this-procedure (input yes
     6417                                         , input p-step
     6418                                         , input macro-list-hist.option_
     6419                                         , input macro-list-hist.status_
     6420                                         , input get-line-mode(macro-list-hist.hist-mode)
     6421                                         , input v-temp-seq
     6422                                         ) no-error .
     6423               if error-status:error then do:
     6424                 assign
     6425                 v-rs-do-error = yes.
     6426               end.
     6427               if get-line-mode(macro-list-hist.hist-mode) = 'ОСТАВИТЬ':U then do:
     6428                 run proc-b-rest-2 in this-procedure .
     6429                 run ui-on in this-procedure .
     6430               end.
     6431               for each buf_gds-list-hist where
     6432                       buf_gds-list-hist.id = v-temp-seq,
     6433                  first buf_macro-list-hist where
     6434                       buf_macro-list-hist.id = v-id
     6435                   AND buf_macro-list-hist.line = buf_gds-list-hist.line:
     6436                  assign
     6437                  buf_macro-list-hist.num-recs = buf_gds-list-hist.num-recs
     6438                  buf_macro-list-hist.num-add = buf_gds-list-hist.num-add
     6439                  buf_macro-list-hist.num-ignored = buf_gds-list-hist.num-ignored
     6440                  .
     6441               end.
     6442               if v-rs-do-error then do:
     6443                 run ui-on in this-procedure .
     6444                 return ("error" + chr(4) + return-value).
     6445               end.
     6446               v-id = macro-list-hist.id.
     6447             end.
     6448           end.
     6449         end.
     6450       END CASE.
     6451     end.
     6452   end.
     6453   end procedure.
     6454   procedure proc-b-rest-2 :
     6455     do
     6456     on error undo, return error
     6457     :
     6458       for each gds-list:
     6459         if gds-list.to-del = ? then do:
     6460           assign
     6461           gds-list.to-del = no
     6462           .
     6463         end.
     6464         else do:
     6465           delete gds-list.
     6466         end.
     6467       end.
     6468       tot-lns = lns-cnt.
     6469     end.
     6470   end procedure.
     6471   PROCEDURE proc-expand :
     6472   define input parameter p-shift as integer no-undo .
     6473   define input parameter p-from as integer no-undo .
     6474   define input parameter p-to as integer no-undo .
     6475   define input parameter p-forcer-name as character no-undo .
     6476   define variable fh as widget-handle no-undo .
     6477   define variable hh as widget-handle no-undo .
     6478   define variable lh as widget-handle no-undo .
     6479   define variable ii as INTEGER no-undo .
     6480   ASSIGN
     6481   fh = frame Dialog-Frame:first-child
     6482   hh = fh:first-child
     6483   .
     6484   CASE v-expand:
     6485     WHEN YES THEN DO:
     6486       ASSIGN
     6487       v-expand = NO.
     6488       DO ii = 1 TO NUM-ENTRIES(v-downed):
     6489         ASSIGN
     6490         hh              = WIDGET-HANDLE(ENTRY(ii, v-downed))
     6491         hh:ROW          = (hh:ROW - p-shift).
     6492         hh:height-chars = (if hh:type = "browse" then (hh:height-chars + p-shift) else hh:height-chars).
     6493       END.
     6494     END.
     6495     WHEN NO THEN DO:
     6496       v-expand = YES.
     6497       v-downed = ''.
     6498       _do:
     6499       do while valid-handle(hh):
     6500         IF lookup(hh:type, "radio-set,browse,button,fill-in,literal,text,rectangle") > 0
     6501          AND hh:ROW >= p-from
     6502          AND hh:ROW <= p-to
     6503          and lookup(hh:name, p-forcer-name) = 0
     6504          THEN DO:
     6505           hh:height-chars = (if hh:type = "browse" then (hh:height-chars - p-shift) else hh:height-chars).
     6506           hh:ROW          = (hh:ROW + p-shift).
     6507           ASSIGN
     6508           v-downed = v-downed + chr(44) + STRING(hh).
     6509           IF hh:TYPE = "fill-in"
     6510           AND valid-handle(hh:side-label-handle) THEN dO:
     6511             assign
     6512             lh = hh:SIDE-LABEL-HANDLE
     6513             lh:ROW = lh:ROW + p-shift
     6514             v-downed = v-downed + chr(44) + STRING(lh)
     6515             .
     6516            END.
     6517          END.
     6518          hh = hh:next-sibling.
     6519       END.
     6520       v-downed = trim(v-downed, chr(44)).
     6521     END.
     6522   END CASE.
     6523   END PROCEDURE.
     6524   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     6525   DO:
     6526   define variable glog as logical no-undo .
     6527   define buffer buf_gds-list for gds-list.
     6528   if available gds-list then   do:
     6529     find first buf_gds-list where
     6530              recid(buf_gds-list) = recid(gds-list).
     6531     assign
     6532     buf_gds-list.to-sel = not (buf_gds-list.to-sel).
     6533     glog = br-list:refresh().
     6534     if LOOKUP(last-event:function,  "MOUSE-SELECT-DBLCLICK,RETURN":U) = 0  then  do:
     6535        glog = br-list:select-next-row ().
     6536        APPLY "VALUE-CHANGED" to br-list.
     6537     end.
     6538   end.
     6539   APPLY "ENTRY" to br-list in frame Dialog-Frame .
     6540   END.
     6541   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     6542   DO:
     6543   define buffer buf_gds-list for gds-list.
     6544   if not available gds-list then return no-apply.
     6545   find first buf_gds-list where
     6546             recid(buf_gds-list) = recid(gds-list).
     6547   assign
     6548   buf_gds-list.to-sel = not (buf_gds-list.to-sel)
     6549   .
     6550   APPLY "CHOOSE" to b-exit.
     6551   END.
     6552   if lookup(bttns, "hide") = 0 then do:
     6553     run diasize_add_browse in this-procedure
     6554       (input  'height':u
     6555       ,input  browse BR-option :handle
     6556       ) .
     6557     run diasize_init in this-procedure .
     6558   end.
     6559   define variable v-ok as logical   no-undo .
     6560   assign
     6561     v-ok = br-list :set-repositioned-row(5, 'conditional':u)
     6562   .
     6563   ON WINDOW-CLOSE OF FRAME Dialog-Frame APPLY "END-ERROR":U TO SELF.
     6564   MAIN-BLOCK:
     6565   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     6566     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     6567   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6568   define variable varscales-pref-type42 as character no-undo.
     6569   varscales-pref  = ?.
     6570   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     6571     (input  'sclspref':u
     6572     ,input  '':u
     6573     ,input  '':u
     6574     ,input  0
     6575     ,input  '':u
     6576     ,input  '':u
     6577     ,input  '':u
     6578     ,input  no
     6579     ,output varscales-pref
     6580     ,output varscales-pref-type42
     6581     ) no-error .
     6582   if varscales-pref = ? then do:
     6583     assign
     6584     varscales-pref = '21,23,25':U.
     6585   end.
     6586   define variable varpgscales-pref-type42 as character no-undo.
     6587   varpgscales-pref  = ?.
     6588   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     6589     (input  'scpgpref':u
     6590     ,input  '':u
     6591     ,input  '':u
     6592     ,input  0
     6593     ,input  '':u
     6594     ,input  '':u
     6595     ,input  '':u
     6596     ,input  no
