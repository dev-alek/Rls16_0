     4191   run prn-lib-open-stream  in this-procedure (
     4192                                                input parParentProc
     4193                                               ,input 43
     4194                                               ,input yes
     4195                                               ,input no
     4196                                               ).
     4197   find first buf_gds-list-hist no-lock where buf_gds-list-hist.id = 0 no-error .
     4198   PUT  STREAM PrnLibStream unformatted
     4199   SPACE(25) "История создания списка товаров "
     4200   (if available buf_gds-list-hist
     4201   then buf_gds-list-hist.des
     4202   else "БЕЗЫМЯННЫЙ") skip(0)
     4203   space(25) cur-time-print() skip(1)
     4204   .
     4205   put stream PrnLibStream unformatted
     4206   string("№", "X(9)") chr(32)
     4207   string("Действие", "X(9)") chr(32)
     4208   string("записей", "X(9)") chr(32)
     4209   string(" = итого", "X(12)") chr(32)
     4210   string("Множество", "X(155)")
     4211   skip(0)
     4212   fill('-':U, 9) chr(32)
     4213   fill('-':U, 9) chr(32)
     4214   fill('-':U, 9) chr(32)
     4215   fill('-':U, 12) chr(32)
     4216   fill('-':U, 155)
     4217   skip(0)
     4218   .
     4219   for each buf_gds-list-hist where buf_gds-list-hist.id > 0
     4220   by buf_gds-list-hist.id
     4221   :
     4222     put stream PrnLibStream unformatted
     4223     (if buf_gds-list-hist.line = 0
     4224      then string(buf_gds-list-hist.id, ">>>>>>>>9")
     4225      else fill(chr(32) , 9)
     4226     )  chr(32)
     4227     (if buf_gds-list-hist.item_ <> '':U
     4228      then string(buf_gds-list-hist.hist-mode, "X(8)")
     4229      else fill( chr(32), 8)) chr(32)
     4230     string(buf_gds-list-hist.num-add, ">>>>>>>>9") chr(32) chr(32) chr(32) chr(32)
     4231     string(buf_gds-list-hist.num-recs, ">>>>>>>>9")  chr(32)
     4232     string(buf_gds-list-hist.des, "X(155)") skip.
     4233   end.
     4234   output stream prnlibstream close.
