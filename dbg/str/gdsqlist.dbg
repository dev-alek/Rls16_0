    10345                           ,output where-phrase
    10346                           ,output sort-phrase
    10347                           ,output where-phrase-rus
    10348                           ,output sort-phrase-rus  ).
    10349           if v-flt-rec = ? then do:
    10350             run UI-on in this-procedure.
    10351             return error.
    10352           end.
    10353           else do:
    10354             find ubflt.filter where recid (ubflt.filter) = v-flt-rec no-lock.
    10355             run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    10356                                                 , input-output v-seq
    10357                                                 , input 0
    10358                                                 , input '':U
    10359                                                 , input substitute("Фильтр : &1 &2 &3", ubflt.filter.naim, ubflt.filter.where-ysl-rus, stat-line(rs-status))
    10360                                                 , input tot-lns
    10361                                                 , input rs-list-method
    10362                                                 , input rs-status
    10363                                                 , input ubflt.filter.where-ysl
