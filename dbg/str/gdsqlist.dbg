    10859   PROCEDURE trig-fbr :
    10860   define input parameter p-method as character no-undo .
    10861   DEFINE VARIABLE vattr-codes          as character           no-undo.
    10862   DEFINE VARIABLE vattr-labels         as character           no-undo.
    10863   DEFINE VARIABLE vlabel               as character           no-undo .
    10864   DEFINE VARIABLE v-ref-list           as character           no-undo .
    10865   DEFINE VARIABLE v-fbr-list           as character           no-undo .
    10866   define variable v-grp-recid          as recid               no-undo .
    10867   define variable v-grp-code like ub.fbr-gds-obj.fbr-grp-code no-undo.
    10868   define variable glog as logical no-undo .
    10869   define variable v-item               as character           no-undo .
    10870   define variable v-fbr-obj-type       like ub.fbr-gds-obj.obj-type no-undo .
    10871   define variable v-fbr-obj-code       like ub.fbr-gds-obj.obj-code no-undo .
    10872   define buffer buf_fbr-gds-grp for ub.fbr-gds-grp.
    10873   if p-method = "fbr-gds-obj-val" then do:
    10874     assign
    10875     v-attr-code = ""
    10876     vattr-codes = "is-cd,is-menu,is-null-price,is-modificator,is-season,is-semi-finished,fbr-grp-code,fbr-obj-code"
    10877     vattr-labels = "Отправлять на кассу РЕСТОРАНА,Является блюдом меню,Без цены,Модификатор блюда,Применять сезонный коэффициент," +
    10878                   "Является полуфабрикатом,Группа меню,Кухня"
    10879     vvalue = ""
    10880     .
    10881     run gbl/d-list.w ( input "b-sel":U
    10882                       ,input "Выберите атрибут"
    10883                       ,input vattr-codes
    10884                       ,input vattr-labels
    10885                       ,input chr(44)
    10886                       ,input "":U
    10887                       ,output v-attr-code).
    10888     if v-attr-code = "" then do:
    10889       return error.
    10890     end.
    10891     assign
    10892     vlabel =  entry(lookup(v-attr-code, vattr-codes) ,vattr-labels)
    10893     glog = yes.
    10894   end.
    10895   define variable vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10896   run userobjs_select-one in this-procedure
    10897     (input  parparentproc
    10898     ,input  v-cntxt-db-num
    10899     ,input  v-cntxt-userid
    10900     ,input  v-cntxt-host-code-obj
    10901     ,input  v-cntxt-obj-type
    10902     ,input  v-cntxt-obj-code
    10903     ,output v-user-select
    10904     ,output v-sel-obj-type
    10905     ,output v-sel-obj-code
    10906     )  .
    10907     if not v-user-select then do:
    10908       return error.
    10909     end.
    10910   if p-method = "fbr-gds-obj-val" then do:
    10911     CASE v-attr-code:
    10912       when "fbr-grp-code" then do:
    10913           run ref/fbrggrp.w (
    10914                   input ?
    10915                 ,input v-sel-obj-type
    10916                 ,input v-sel-obj-code
    10917                 ,input "b-sel"
    10918                 ,input-output v-grp-recid
    10919             ).
    10920         if v-grp-recid = ? then return error.
    10921         FIND FIRST buf_fbr-gds-grp no-lock where
    10922                 recid(buf_fbr-gds-grp) = v-grp-recid No-ERROR.
    10923         if not avail buf_fbr-gds-grp then return error.
    10924         assign
    10925         vvalue = string(buf_fbr-gds-grp.node-code)
    10926         vlabel = vlabel + " = ":U + buf_fbr-gds-grp.node-name
    10927         .
    10928       end.
    10929       when "fbr-obj-code" then do:
    10930         message
    10931         "Выберите объект-КУХНЮ для товара объекта" v-sel-obj-type v-sel-obj-code
    10932         view-as alert-box.
    10933   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10934   run userobjs_select-one in this-procedure
    10935     (input  parparentproc
    10936     ,input  v-cntxt-db-num
    10937     ,input  v-cntxt-userid
    10938     ,input  v-cntxt-host-code-obj
    10939     ,input  v-cntxt-obj-type
    10940     ,input  v-cntxt-obj-code
    10941     ,output v-user-select
    10942     ,output v-fbr-obj-type
    10943     ,output v-fbr-obj-code
    10944     )  .
    10945         assign
    10946         vvalue = string(v-fbr-obj-code)
    10947         .
    10948       end.
    10949       otherwise do:
    10950         assign
    10951         vvalue = "yes":U
    10952         .
    10953         run gbl/d-prompt.w (
    10954           'title=':u + "Значение атрибута товара на объекте" + '\':u
    10955         + 'text1=':u + vlabel + '\':u
    10956         + 'format=yes/no' + '\':u
    10957         + 'type=logical' + '\':u
    10958         + 'fillin_row=2\':u
    10959         + 'fillin_col=4\':u
    10960         + 'fillin_width=20\':u
    10961         + 'fillin_height=1\':u
    10962         + 'max-chars=70\':u
    10963         + 'readonly=no\':u
    10964         , input-output vvalue
    10965         ).
    10966         if return-value = 'false':U then do:
    10967           return error.
    10968         end.
    10969       end.
    10970     END CASE.
    10971     assign
    10972     dsp-rs = substitute("Товары объекта &1&2 с атрибутом РЕСТОРАН &3 =&4&5&5"
    10973                          ,  v-sel-obj-type, v-sel-obj-code, vlabel, vvalue
    10974                          , chr(10)
    10975                          , stat-line(rs-status)
    10976                          )
    10977     v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code) + chr(3) + v-attr-code + chr(3) + vvalue
    10978     .
    10979   end.
    10980   else do:
    10981     assign
    10982     dsp-rs = substitute("Товары объекта &1&2, имеющие атрибут РЕСТОРАН&3&4"
    10983                        ,  v-sel-obj-type
    10984                         , v-sel-obj-code
    10985                          , chr(10)
    10986                          , stat-line(rs-status)
    10987                        )
    10988      v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code) + chr(3)
    10989      .
    10990   end.
    10991     message
    10992     dsp-rs skip
    10993     view-as alert-box question buttons OK-Cancel update glog.
    10994   if not glog then do:
    10995     return error.
    10996   end.
    10997   run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    10998                                       , input-output v-seq
    10999                                       , input 0
    11000                                       , input '':U
    11001                                       , input dsp-rs
    11002                                       , input tot-lns
    11003                                       , input rs-list-method
    11004                                       , input rs-status
    11005                                       , input v-item
    11006                                       , input '':U
    11007                                       , input ?
    11008                                       ).
    11009   END PROCEDURE.
    11010   PROCEDURE proc-scales-gds :
    11011   define input parameter rs-list-method as character no-undo .
    11012   define variable v-ref-list as character no-undo .
    11013   define variable v-rid-list as character no-undo .
    11014   define variable glog as logical no-undo .
    11015   define variable v-message as character no-undo .
    11016   define variable v-item as character no-undo .
    11017   define buffer buf_scales for ub.scales.
    11018   glog = yes.
    11019   CASE rs-list-method:
    11020     when "scales-gds":U then do:
    11021       assign
    11022       v-message = substitute("Все товары на весах на объекте&1&2", chr(10), stat-line(rs-status))
    11023       .
    11024     end.
    11025     when "scales-gds-num":U then do:
    11026       assign
    11027       v-message = substitute("Товары на одних весах на объекте &1&2", chr(10), stat-line(rs-status))
    11028       .
    11029     end.
    11030   END CASE.
    11031   message
    11032   v-message
    11033   view-as alert-box question buttons OK-Cancel update glog.
    11034   if not glog then do:
    11035     return error.
    11036   end.
    11037   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11038   run userobjs_select-one in this-procedure
    11039     (input  parparentproc
    11040     ,input  v-cntxt-db-num
    11041     ,input  v-cntxt-userid
    11042     ,input  v-cntxt-host-code-obj
    11043     ,input  v-cntxt-obj-type
    11044     ,input  v-cntxt-obj-code
    11045     ,output v-user-select
    11046     ,output v-sel-obj-type
    11047     ,output v-sel-obj-code
    11048     )  .
    11049   if not v-user-select then do:
    11050     return error.
    11051   end.
    11052   if rs-list-method = "scales-gds-num" then do:
    11053     run ref/scales.w ( input parparentproc
    11054                       ,input v-sel-obj-type
    11055                       ,input v-sel-obj-code
    11056                       ,input "b-sel"
    11057                       ,input 'db':U
    11058                       ,output v-rid-list).
    11059     if v-rid-list = '':U then do:
    11060       return error.
    11061     end.
    11062     find first buf_scales no-lock where
    11063               recid(buf_scales) = integer(v-rid-list).
    11064   end.
    11065   CASE rs-list-method:
    11066     when "scales-gds":U then do:
    11067       assign
    11068       dsp-rs = substitute("ВСЕ товары на весах на объекте &1&2 &3", v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    11069       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)
    11070       .
    11071     end.
    11072     when "scales-gds-num":U then do:
    11073       assign
    11074       dsp-rs = substitute("Товары на весах &1 на объекте &2&3 &4", buf_scales.scales-num, v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    11075       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)  + chr(3) + string(buf_scales.scales-num)
    11076       .
    11077     end.
    11078   END CASE.
    11079   v-no-hist = 0.
    11080   run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    11081                                       , input-output v-seq
    11082                                       , input 0
    11083                                       , input '':U
    11084                                       , input dsp-rs
    11085                                       , input tot-lns
    11086                                       , input rs-list-method
    11087                                       , input rs-status
    11088                                       , input v-item
    11089                                       , input '':U
    11090                                       , input ?
    11091                                       ).
    11092   END PROCEDURE.
