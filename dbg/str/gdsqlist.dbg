     4368   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4369   procedure minbtn-set :
     4370       do
     4371           on error undo, return error return-value
     4372           :
     4373           define variable ii              as integer       no-undo .
     4374           define variable fh              as widget-handle no-undo .
     4375           define variable hh              as widget-handle no-undo .
     4376           define variable v-h             as handle        extent 4 no-undo .
     4377           define variable v-name-button   as character     no-undo .
     4378           define variable v-help-old-x    as decimal       no-undo .
     4379           define variable v-help-old-y    as decimal       no-undo .
     4380           define variable v-help-old-size as decimal       no-undo .
     4381           define variable v-frame-width   as decimal       no-undo .
     4382           define variable jj              as integer       no-undo .
     4383           do
     4384               on error undo, return error
     4385               :
     4386               assign
     4387                   v-frame-width = frame Dialog-Frame:width - 0.3
     4388                   fh            = frame Dialog-Frame:first-child
     4389                   hh            = fh:first-child
     4390                   ii            = 1
     4391                   .
     4392               do while valid-handle(hh):
     4393                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     4394                   do:
     4395                       case lc(hh:name) :
     4396                           when "b-help" then
     4397                               do:
     4398                                   hh:load-image-up("cmp/b-help.bmp":u) .
     4399                                   hh:load-image-down("cmp/b-help.bmp":u) .
     4400                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     4401                                   hh:TOOLTIP = "Помощь" .
     4402                                   v-help-old-x = hh:column .
     4403                                   v-help-old-y = hh:row    .
     4404                                   v-help-old-size = hh:width .
     4405                                   hh:width-chars = 2.5 .
     4406                               end.
     4407                           when "b-print" then
     4408                               do:
     4409                                   hh:load-image("cmp/b-print.bmp":u) .
     4410                                   hh:TOOLTIP = "Печать" .
     4411                                   v-h[ii] = hh:handle .
     4412                                   ii = ii + 1 .
     4413                                   hh:width-chars = 3 .
     4414                               end.
     4415                           when "b-history" or
     4416                           when "b-hist" then
     4417                               do:
     4418                                   hh:load-image("cmp/b-hist.bmp":u) .
     4419                                   hh:TOOLTIP = "История" .
     4420                                   v-h[ii] = hh:handle .
     4421                                   ii = ii + 1 .
     4422                                   hh:width-chars = 3 .
     4423                               end.
     4424                           when "b-sch" then
     4425                               do:
     4426                                   hh:load-image("cmp/b-sch.bmp":u) .
     4427                                   hh:TOOLTIP = "Установка Фильтра" .
     4428                                   v-h[ii] = hh:handle .
     4429                                   ii = ii + 1 .
     4430                                   hh:width-chars = 3 .
     4431                               end.
     4432                           when "b-hist-user" then
     4433                               do:
     4434                                   hh:load-image("cmp/b-hist.bmp":u) .
     4435                                   hh:TOOLTIP = "История пользователя" .
     4436                                   ii = ii + 1 .
     4437                               end.
     4438                       end case.
     4439                   end.
     4440                   hh = hh:next-sibling.
     4441               end.
     4442               b-help:column = v-frame-width - b-help:width-chars.
     4443               jj = 0.
     4444               repeat ii = 4 to 1 by -1 :
     4445                   if valid-handle (v-h[ii] ) then
     4446                   do:
     4447                       jj  = jj + 1 .
     4448                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     4449                       v-h[ii]:row    = v-help-old-y .
     4450                   end.
     4451               end.
     4452           end.
     4453       end.
     4454   end procedure.
     4455   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     4456   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     4457   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     4458   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     4459   define variable v-diasize-current-frame-width  as decimal   no-undo .
     4460   define variable v-diasize-current-frame-height as decimal   no-undo .
     4461   define variable v-diasize-change-size          as logical   no-undo .
     4462   define variable v-diasize-resize-button        as handle    no-undo .
     4463   define variable v-diasize-wndmax               as logical   no-undo .
     4464   define variable v-diasize-wndstore             as logical   no-undo .
     4465   define variable v-diasize-proc-name            as character no-undo .
     4466   define variable v-diasize-browse-handle        as handle    no-undo .
     4467   define variable v-diasize-browse-number        as integer   no-undo .
     4468   define variable v-diasize-need-full-display    as logical   no-undo init false .
     4469   define temp-table temp-diasize-handle no-undo
     4470     field handle-value  as handle
     4471     field save-position as decimal
     4472     index xpk is primary unique handle-value
     4473     .
     4474   define temp-table temp-browse-handle no-undo
     4475     field browse-type   as character
     4476     field browse-number as integer
     4477     field browse-handle as handle
     4478     field original-size as decimal
     4479     index xpk is primary unique browse-type browse-number
     4480     index xie browse-type browse-handle
     4481   .
     4482   procedure diasize_change-height :
     4483     define input  parameter p-change-value  as decimal   no-undo .
     4484     define input  parameter p-move-resize   as logical   no-undo .
     4485     define variable v-field-group-handle    as handle    no-undo .
     4486     define variable v-object-handle         as handle    no-undo .
     4487     define variable v-frame-height          as decimal   no-undo .
     4488     define variable v-frame-virtual-height  as decimal   no-undo .
     4489     define variable v-browse-height         as decimal   no-undo .
     4490     define variable v-window-height         as decimal   no-undo .
     4491     define variable v-window-virtual-height as decimal   no-undo .
     4492     define variable v-change-sign           as integer   no-undo .
     4493     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     4494     define buffer buf_temp-browse-handle  for temp-browse-handle .
     4495     if p-change-value > 0
     4496     then do:
     4497       if frame Dialog-Frame :height + p-change-value
     4498           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     4499       then do:
     4500         assign
     4501           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     4502                           - (frame Dialog-Frame :height-chars)
     4503         .
     4504         if p-change-value <= 0
     4505         then do:
     4506           run diasize_position-resize-button in this-procedure .
     4507           return .
     4508         end.
     4509       end.
     4510     end.
     4511     if p-change-value < 0
     4512     then do:
     4513       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     4514       then do:
     4515         assign
     4516           p-change-value = v-diasize-orig-frame-height
     4517                          - (frame Dialog-Frame :height-chars)
     4518         .
     4519         if p-change-value >= 0
     4520         then do:
     4521           run diasize_position-resize-button in this-procedure .
     4522           return .
     4523         end.
     4524       end.
     4525     end.
     4526     if p-change-value >= 0
     4527     then do:
     4528       assign
     4529         v-change-sign = 1
     4530       .
     4531     end.
     4532     else do:
     4533       assign
     4534         v-change-sign = -1
     4535       .
     4536     end.
     4537     assign
     4538       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4539     .
     4540     if p-change-value = 0
     4541     then do:
     4542       run diasize_position-resize-button in this-procedure .
     4543       return .
     4544     end.
     4545     move_block:
     4546     do
     4547     on error undo move_block, retry move_block
     4548     :
     4549       if retry
     4550       then do:
     4551         do
     4552         on error undo move_block, leave move_block
     4553         :
     4554           if p-change-value > 0
     4555           then do:
     4556             for each buf_temp-diasize-handle
     4557             on error undo, next
     4558             :
     4559               assign
     4560                 v-object-handle = buf_temp-diasize-handle.handle-value
     4561               .
     4562               if v-object-handle <> v-diasize-resize-button
     4563               then do:
     4564                 assign
     4565                   v-object-handle :row = buf_temp-diasize-handle.save-position
     4566                 .
     4567               end.
     4568             end.
     4569             assign
     4570               v-diasize-browse-handle :height = v-browse-height
     4571             .
     4572             for each buf_temp-browse-handle
