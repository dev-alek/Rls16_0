     3760     system-dialog get-file f-name
     3761       filters "Списки товаров *.gds" "*.gds"
     3762       ask-overwrite
     3763       save-as
     3764       use-filename
     3765       update glog
     3766       default-extension "gds".
     3767     if not glog then do:
     3768       apply "entry" to br-list in frame Dialog-Frame.
     3769       return no-apply.
     3770     end.
     3771     output to value (f-name).
     3772     for each gds-list:
     3773       export gds-list.prod-type
     3774             gds-list.prod-code
     3775             gds-list.artic
     3776             gds-list.qnty
     3777             .
     3778     end.
     3779     output close.
     3780   END.
