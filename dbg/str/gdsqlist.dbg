     1651   procedure prn-lib-reportviewer :
     1652     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1653     define input parameter p-report-name-html as character no-undo .
     1654     define input parameter p-param        as character no-undo .
     1655     define variable v-excel           as character no-undo init 'TRUE' .
     1656     define variable v-value-character as character no-undo .
     1657     define variable v-value-integer   as character no-undo .
     1658     define variable v-value-date      as date      no-undo .
     1659     define variable v-value-decimal   as decimal   no-undo .
     1660     define variable rep-excel         as logical   no-undo .
     1661     define variable excel-string      as character no-undo .
     1662     define variable v-param-type      as character no-undo .
     1663     define variable v-tth             as handle    no-undo .
     1664     run adm/shattri.p (
     1665       input "get":U
     1666       ,input  ""
     1667       ,input  0
     1668       ,input  'report-glob':U
     1669       ,input  'rep-excel':U
     1670       ,output v-value-character
     1671       ,output v-value-date
     1672       ,output v-value-decimal
     1673       ,output v-value-integer
     1674       ,output rep-excel
     1675       ,output v-param-type
     1676       ,INPUT-OUTPUT table-handle v-tth
     1677       )  .
     1678     if rep-excel then v-excel = "TRUE" .
     1679     else v-excel = "FALSE" .
     1680     if p-param eq ""
     1681     then
     1682        p-param = "EXCEL:" + v-excel.
     1683     else
     1684        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1685     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1686   end procedure.
