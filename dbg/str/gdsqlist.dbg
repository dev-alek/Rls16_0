      334   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      335   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      336   procedure gen-key-rec :
      337     define input  parameter p-tbl-name    as character no-undo.
      338     define input  parameter p-bh_tbl-name as handle    no-undo.
      339     define output parameter p-key-rec     as character no-undo.
      340     do
      341     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      342     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      343     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      344     :
      345       define variable fh               as handle    no-undo .
      346       define variable v-ok             as logical   no-undo .
      347       define variable v-inform         as character no-undo .
      348       define variable v-ind            as integer   no-undo .
      349       define variable v-idx-field-qnty as integer   no-undo .
      350       if p-tbl-name = ?
      351         or p-tbl-name = "":U
      352       then do:
      353         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
      354       end.
      355       if not p-bh_tbl-name:available then do:
      356         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
      357       end.
      358       assign
      359         p-key-rec = p-tbl-name
      360         v-inform  = p-bh_tbl-name:index-information(1)
      361         v-ind     = 2
      362       .
      363       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      364       on error undo, return error
      365       :
      366         assign
      367           v-inform = p-bh_tbl-name:index-information( v-ind )
      368           v-ind    = v-ind + 1
      369         .
      370       end.
      371       if v-inform = ?
      372         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      373         or entry( 3, v-inform, ",":U ) <> "1":U
      374       then do:
      375         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
      376       end.
      377       else do:
      378         assign
      379           v-idx-field-qnty = num-entries( v-inform ) - 4
      380         .
      381         if v-idx-field-qnty < 2 then do:
      382           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
      383         end.
      384         do v-ind = 1 to v-idx-field-qnty by 2
      385         on error undo, return error
      386         :
      387           assign
      388             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      389             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      390           .
      391         end.
      392       end.
      393       if p-key-rec = ? then do:
      394         assign
      395           p-key-rec = "":U
      396         .
      397         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
      398       end.
      399     end.
      400     return.
      401   end procedure.
      402   procedure gen-where-keyr-tab :
      403     define input  parameter i-tableSerach as character no-undo.
      404     define input  parameter i-tablekey   as character  no-undo.
      405     define input  parameter p-key-rec    as character  no-undo.
      406     define input  parameter p-key-handle as handle     no-undo .
      407     define input  parameter p-db-name    as character  no-undo .
      408     define input  parameter p-tt-handle  as handle     no-undo .
      409     define output parameter o-Where      as character  no-undo.
      410     do
      411     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      412     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      413     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      414     :
      415       define variable v-full-tbl-name  as character no-undo .
      416       define variable bh_tbl-name      as handle    no-undo .
      417       define variable fh_key           as handle    no-undo .
      418       define variable fh_search        as handle    no-undo .
      419       define variable v-field-num      as integer   no-undo .
      420       define variable v-count-fld      as integer   no-undo .
      421       define variable v-inform         as character no-undo .
      422       define variable v-ind            as integer   no-undo .
      423       define variable v-idx-field-qnty as integer   no-undo .
      424       define variable v-field-name     as character no-undo .
      425       define variable v-field-val      as character no-undo .
      426       define variable v-word-link      as character no-undo .
      427       define variable vTable           as character no-undo.
      428       define variable bh_tbl-key       as handle    no-undo .
      429       assign
      430         p-key-rec = trim( p-key-rec )
      431       .
      432       if p-key-handle <> ? then do:
      433         if not valid-handle(p-key-handle)
      434            or p-key-handle:type <> "buffer"
      435         then do:
      436           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
      437         end.
      438         if num-entries( p-key-rec, chr(3) ) > 1
      439           or p-key-rec = ?
      440           or p-key-rec = "":U
      441         then do:
      442           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
      443         end.
      444       end.
      445       else do:
      446         if p-key-rec = ?
      447           or p-key-rec = "":U
      448         then do:
      449           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      450         end.
      451       end.
      452       assign
      453         vTable = entry( 1 , p-key-rec, chr(3) )
      454       .
      455       if p-tt-handle <> ?
      456         and ( not valid-handle(p-tt-handle)
      457               or p-tt-handle:type <> "buffer"
      458             )
      459       then do:
      460         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
      461       end.
      462       if p-tt-handle = ? then do:
      463         assign
      464           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      465         .
      466         create buffer bh_tbl-name for table v-full-tbl-name .
      467       end.
      468       else do:
      469         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      470       end.
      471       assign
      472         v-inform = bh_tbl-name:index-information(1)
      473         v-ind    = 2
      474       .
      475       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      476       on error undo, return error
      477       :
      478         assign
      479           v-inform = bh_tbl-name:index-information( v-ind )
      480           v-ind    = v-ind + 1
      481         .
      482       end.
      483       if v-inform = ?
      484         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      485         or entry( 3, v-inform, ",":U ) <> "1":U
      486       then do:
      487         delete object bh_tbl-name no-error.
      488         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
      489       end.
      490       assign
      491         v-idx-field-qnty = num-entries( v-inform ) - 4
      492       .
      493       if v-idx-field-qnty < 2 then do:
      494         delete object bh_tbl-name no-error.
      495         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
      496       end.
      497       assign
      498         o-where     = "where":U
      499         v-word-link = "":U
      500         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      501         v-count-fld = 0
      502       .
      503       if i-tablekey ne "" and i-tablekey ne ?
      504       then do:
      505         assign
      506           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      507         .
      508         create buffer bh_tbl-key for table v-full-tbl-name .
      509       end.
      510       if i-tableSerach ne "" and i-tableSerach ne ?
      511       then do:
      512         delete object bh_tbl-name no-error.
      513         assign
      514           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      515         .
      516         create buffer bh_tbl-name for table v-full-tbl-name .
      517       end.
      518       block_where:
      519       do v-ind = 1 to v-idx-field-qnty by 2
      520       on error undo, return error
      521       :
      522         assign
      523           v-count-fld = v-count-fld + 1
      524         .
      525         if p-key-handle = ?
      526           and v-count-fld > v-field-num
      527         then do:
      528           leave block_where.
      529         end.
      530         define variable VfieldKeyTable as handle no-undo.
      531         assign
      532           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      533           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      534         .
      535         if     bh_tbl-key ne ?
      536         then do:
      537            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      538            if VfieldKeyTable eq ?
      539            then next block_where.
      540         end.
      541         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      542         then
      543            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      544         else
      545            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      546         if p-key-handle = ? then do:
      547           assign
      548             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      549           .
      550         end.
      551         else do:
      552           assign
      553             fh_key = p-key-handle:buffer-field( v-field-name )
      554           .
      555           if fh_key = ?
      556             or not valid-handle( fh_key )
      557           then do:
      558             delete object bh_tbl-name.
      559             if     bh_tbl-key ne ?
      560             then
      561                delete object bh_tbl-key.
      562             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
      563           end.
      564           assign
      565             v-field-val = fh_key:buffer-value
      566           .
      567         end.
      568         if fh_search:data-type ="character":U then do:
      569           assign
      570             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      571             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      572             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      573             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      574             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      575             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      576             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      577             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      578             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      579             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      580             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      581             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      582             v-field-val = substitute( '"&1"', v-field-val )
      583           .
      584         end.
      585         assign
      586           o-where = substitute( "&1 &2", o-where, v-field-val )
      587         .
      588         if v-word-link = "":U then do:
      589           assign
      590             v-word-link = "and":U
      591           .
      592         end.
      593       end.
      594       delete object bh_tbl-name.
      595       if     bh_tbl-key ne ?
      596       then
      597          delete object bh_tbl-key.
      598       if p-key-handle = ?
      599         and v-count-fld <> v-field-num
      600       then do:
      601         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
      602       end.
      603     end.
      604   end procedure.
      605   procedure gen-hn-keyr-tab :
      606     define input  parameter i-tableSerach as character no-undo.
      607     define input  parameter i-tablekey   as character no-undo.
      608     define input  parameter p-key-rec    as character no-undo.
      609     define input  parameter p-key-handle as handle    no-undo .
      610     define input  parameter p-db-name    as character no-undo .
      611     define input  parameter p-tt-handle  as handle    no-undo .
      612     define input  parameter p-stts-lock  as integer   no-undo .
      613     define output parameter o-hn         as handle    no-undo.
      614     define variable v-full-tbl-name as character no-undo.
      615     define variable v-where         as character no-undo.
      616     define variable bh_tbl-name     as handle    no-undo.
      617     define variable vTable          as character no-undo.
      618     do
      619     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      620     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      621     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      622         run gen-where-keyr-tab(i-tableSerach,
      623                                i-tablekey,
      624                                p-key-rec,
      625                                p-key-handle,
      626                                p-db-name,
      627                                p-tt-handle,
      628                                output v-where).
      629         if i-tableSerach ne "" and i-tableSerach ne ?
      630         then do:
      631            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      632            create buffer bh_tbl-name for table v-full-tbl-name .
      633         end.
      634         else do:
      635            if p-tt-handle = ? then do:
      636               assign
      637                  vTable = entry( 1 , p-key-rec, chr(3) )
      638               .
      639               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      640               create buffer bh_tbl-name for table v-full-tbl-name .
      641            end.
      642            else do:
      643               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      644            end.
      645         end.
      646         if p-tt-handle = ? then do:
      647            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      648         end.
      649         else do:
      650            bh_tbl-name:find-first( v-where ) no-error .
      651         end.
      652         o-hn = bh_tbl-name.
      653      end.
      654   end procedure.
      655   procedure gen-hn-keyr :
      656     define input  parameter p-key-rec    as character no-undo.
      657     define input  parameter p-key-handle as handle    no-undo .
      658     define input  parameter p-db-name    as character no-undo .
      659     define input  parameter p-tt-handle  as handle    no-undo .
      660     define input  parameter p-stts-lock  as integer   no-undo .
      661     define output parameter o-hn         as handle    no-undo.
      662     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      663   end.
      664   procedure gen-row-keyr :
      665     define input  parameter p-key-rec    as character no-undo.
      666     define input  parameter p-key-handle as handle    no-undo .
      667     define input  parameter p-db-name    as character no-undo .
      668     define input  parameter p-tt-handle  as handle    no-undo .
      669     define input  parameter p-stts-lock  as integer   no-undo .
      670     define output parameter p-tbl-row    as rowid     no-undo.
      671     define output parameter p-tbl-name   as character no-undo.
      672     define variable vHn as handle no-undo.
      673       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      674       p-tbl-row = if vHn:available then vHn:rowid else ?.
      675       p-tbl-name =  vHn:table.
      676       delete object vHn no-error.
      677     if p-tbl-row = ? then do:
      678       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
      679     end.
      680     else do:
      681       return.
      682     end.
      683   end procedure.
      684   procedure gen-key-fv :
      685     define input  parameter p-key-rec    as character no-undo .
      686     define output parameter p-field-list as character no-undo .
      687     define output parameter p-value-list as character no-undo.
      688     do
      689     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      690     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      691     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      692     :
      693       define variable v-full-tbl-name  as character no-undo .
      694       define variable bh_tbl-name      as handle    no-undo .
      695       define variable v-tbl-name       as character no-undo .
      696       define variable v-field-num      as integer   no-undo .
      697       define variable v-count-fld      as integer   no-undo .
      698       define variable v-inform         as character no-undo .
      699       define variable v-ind            as integer   no-undo .
      700       define variable v-idx-field-qnty as integer   no-undo .
      701       define variable v-delim-key      as character no-undo .
      702       if p-key-rec = ?
      703         or p-key-rec = "":U
      704       then do:
      705         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      706       end.
      707       assign
      708         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      709         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      710       .
      711       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      712       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
      713       assign
      714         v-inform = bh_tbl-name:index-information(1)
      715         v-ind    = 2
      716       .
      717       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      718       on error undo, return error
      719       :
      720         assign
      721           v-inform = bh_tbl-name:index-information( v-ind )
      722           v-ind    = v-ind + 1
      723         .
      724       end.
      725       if v-inform = ?
      726         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      727         or entry( 3, v-inform, ",":U ) <> "1":U
      728       then do:
      729         delete object bh_tbl-name no-error.
      730         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      731       end.
      732       assign
      733         v-idx-field-qnty = num-entries( v-inform ) - 4
      734       .
      735       if v-idx-field-qnty < 2 then do:
      736         delete object bh_tbl-name no-error.
      737         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      738       end.
      739       assign
      740         p-field-list = "":U
      741         p-value-list = "":U
      742         v-delim-key  = "":U
      743         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      744         v-count-fld  = 0
      745       .
      746       block_where:
      747       do v-ind = 1 to v-idx-field-qnty by 2
      748       on error undo, return error
      749       :
      750         assign
      751           v-count-fld = v-count-fld + 1
      752         .
      753         if v-count-fld > v-field-num then do:
      754           leave block_where.
      755         end.
      756         assign
      757           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      758           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      759         .
      760         if v-ind = 1 then do:
      761           assign
      762             v-delim-key = chr(3)
      763           .
      764         end.
      765       end.
      766       delete object bh_tbl-name.
      767       if v-count-fld <> v-field-num then do:
      768         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
      769       end.
      770     end.
      771   end procedure.
      772   procedure gen-key-field :
      773     define input  parameter p-table      as character no-undo .
      774     define output parameter p-field-list as character no-undo .
      775     do
      776     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      777     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      778     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      779     :
      780       define variable v-full-tbl-name  as character no-undo .
      781       define variable bh_tbl-name      as handle    no-undo .
      782       define variable v-tbl-name       as character no-undo .
      783       define variable v-field-num      as integer   no-undo .
      784       define variable v-count-fld      as integer   no-undo .
      785       define variable v-inform         as character no-undo .
      786       define variable v-ind            as integer   no-undo .
      787       define variable v-idx-field-qnty as integer   no-undo .
      788       define variable v-delim-key      as character no-undo .
      789       if p-table = ?
      790         or p-table = "":U
      791       then do:
      792         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
      793       end.
      794       assign
      795         v-tbl-name      = p-table
      796         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      797       .
      798       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      799       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
      800       assign
      801         v-inform = bh_tbl-name:index-information(1)
      802         v-ind    = 2
      803       .
      804       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      805       on error undo, return error
      806       :
      807         assign
      808           v-inform = bh_tbl-name:index-information( v-ind )
      809           v-ind    = v-ind + 1
      810         .
      811       end.
      812       if v-inform = ?
      813         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      814         or entry( 3, v-inform, ",":U ) <> "1":U
      815       then do:
      816         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      817       end.
      818       assign
      819         v-idx-field-qnty = num-entries( v-inform ) - 4
      820       .
      821       if v-idx-field-qnty < 2 then do:
      822         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      823       end.
      824       assign
      825         p-field-list = "":U
      826         v-delim-key  = "":U
      827         v-count-fld  = 0
      828       .
      829       block_where:
      830       do v-ind = 1 to v-idx-field-qnty by 2
      831       on error undo, return error
      832       :
      833         assign
      834           v-count-fld = v-count-fld + 1
      835         .
      836         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      837         if v-ind = 1 then do:
      838           assign
      839             v-delim-key = chr(3)
      840           .
      841         end.
      842       end.
      843       delete object bh_tbl-name.
      844     end.
      845   end procedure.
      846   procedure create-gds-list-hist :
      847   define input parameter p-mode as character no-undo .
      848   define input-output parameter p-seq as integer no-undo .
      849   define input parameter p-line as integer no-undo .
      850   define variable p-list-table as character no-undo .
      851   define input parameter p-hist-mode as character no-undo .
      852   define input parameter p-des as character no-undo .
      853   define input parameter p-num-recs as integer no-undo .
      854   define input parameter p-option as character no-undo .
      855   define input parameter p-status_ as character no-undo .
      856   define input parameter p-item as character no-undo .
      857   define input parameter p-tbl-name as character no-undo .
      858   define input parameter p-bh_tbl-name as handle no-undo .
      859   define variable v-num-add as integer no-undo .
      860   define variable v-num-ignored as integer no-undo .
      861   define buffer buf_gds-list-hist for gds-list-hist.
      862     do
      863     on error undo, return error
      864     :
      865       CASE p-mode:
      866         when 'title' then do:
      867           find first buf_gds-list-hist where
      868                      buf_gds-list-hist.id = 0   no-error.
      869           if not available buf_gds-list-hist then do:
      870             create buf_gds-list-hist.
      871             assign
      872             buf_gds-list-hist.id = 0
      873             buf_gds-list-hist.line = 0
      874             buf_gds-list-hist.list-table = '':U
      875             .
      876           end.
      877           assign
      878           buf_gds-list-hist.des =  p-des
      879           buf_gds-list-hist.num-recs = p-num-recs
      880           buf_gds-list-hist.option_  = p-option
      881           buf_gds-list-hist.item_ = p-item
      882           .
      883         end.
      884         when 'ДОБАВЛЕНИЕ':U then do:
      885           if p-option begins 'single' then do:
      886             CASE p-hist-mode:
      887               when '+':U then do:
      888                 assign
      889                 v-num-add = 1
      890                 v-num-ignored  = 0
      891                 .
      892               end.
      893               when '-':U then do:
      894                 assign
      895                 v-num-add = 1
      896                 v-num-ignored  = 0
      897                 .
      898               end.
      899               when '*':U then do:
      900                 assign
      901                 v-num-add = p-num-recs - 1
      902                 p-num-recs = 1
      903                 v-num-ignored  = 0
      904                 .
      905               end.
      906             END CASE.
      907           end.
      908           create buf_gds-list-hist.
      909           assign
      910           buf_gds-list-hist.id = p-seq
      911           buf_gds-list-hist.list-table = p-list-table
      912            p-seq = (if p-line = 0 then (p-seq + 1) else p-seq)
      913           buf_gds-list-hist.des =  p-des
      914           buf_gds-list-hist.line = p-line
      915           buf_gds-list-hist.num-recs = p-num-recs
      916           buf_gds-list-hist.option_  = p-option
      917           buf_gds-list-hist.item_ = p-item
      918           buf_gds-list-hist.hist-mode =  p-hist-mode
      919           buf_gds-list-hist.status_ =  p-status_
      920           buf_gds-list-hist.num-add = v-num-add
      921           buf_gds-list-hist.num-ignored = v-num-ignored
      922           .
      923         end.
      924         when 'ИЗМЕНЕНИЕ':U + chr(4) + 'des' then do:
      925           find first buf_gds-list-hist where
      926                     buf_gds-list-hist.id = p-seq
      927                 and buf_gds-list-hist.line = p-line no-error .
      928           if  available buf_gds-list-hist then do:
      929             assign
      930             buf_gds-list-hist.des =  p-des
      931             buf_gds-list-hist.num-recs = p-num-recs
      932             buf_gds-list-hist.option_  = p-option
      933             buf_gds-list-hist.item_ = p-item
      934             buf_gds-list-hist.list-table = (if p-list-table <> '':U and p-list-table <> ?
      935                                        then p-list-table
      936                                        else buf_gds-list-hist.list-table)
      937             .
      938           end.
      939         end.
      940         when 'ИЗМЕНЕНИЕ':U + chr(4) + 'mode' then do:
      941           find first buf_gds-list-hist where
      942                     buf_gds-list-hist.id = p-seq
      943                 and buf_gds-list-hist.line = p-line  no-error .
      944           if available buf_gds-list-hist then do:
      945             assign
      946             buf_gds-list-hist.hist-mode =  p-hist-mode
      947             buf_gds-list-hist.num-recs  = (if buf_gds-list-hist.line = 0 then p-num-recs else buf_gds-list-hist.num-recs)
      948             buf_gds-list-hist.list-table = (if p-list-table <> '':U and p-list-table <> ?
      949                                        then p-list-table
      950                                        else buf_gds-list-hist.list-table)
      951             .
      952           end.
      953         end.
      954       END CASE.
      955       if p-tbl-name <> "":U
      956       and valid-handle(p-bh_tbl-name)
      957       then do:
      958         run gen-key-rec  in this-procedure (
      959                                               input  p-tbl-name
      960                                              ,input  p-bh_tbl-name
      961                                              ,output p-item) no-error .
      962         if not error-status:error then do:
      963           assign
      964           buf_gds-list-hist.item_ = p-item
      965           .
      966         end.
      967         else do:
      968           assign
      969           buf_gds-list-hist.item_ = "!ERROR"
      970           .
      971         end.
      972       end.
      973     end.
      974   end procedure.
      975   FUNCTION get-line-mode returns character(input p-hist-mode as character):
      976   case p-hist-mode:
      977     when '+':U then
      978       return  'ДОБАВЛЕНИЕ':U.
      979     when '-':U then
      980       return  'удаление':U.
      981     when '*':U then
      982       return  'ОСТАВИТЬ':U.
      983   end CASE.
      984   END FUNCTION.
      985   FUNCTION get-hist-mode returns character(input p-line-mode as character):
      986   case p-line-mode:
      987     when 'ДОБАВЛЕНИЕ':U then
      988       return  "+".
      989     when 'удаление':U then
      990       return  "-".
      991     when 'ОСТАВИТЬ':U then
      992       return  "*".
      993   end CASE.
      994   END FUNCTION.
      995   procedure proc-write-filter-expression :
      996   define input parameter p-filter-expression as character no-undo .
      997   define variable v-ii as integer no-undo .
      998   output to value(string(g#report-num) + ".whr").
      999   put .
     1000   if num-entries(p-filter-expression) > 0 then do:
     1001      put unformatted 'and ('.
     1002      do v-ii = 1 to num-entries(p-filter-expression):
     1003        put unformatted entry(v-ii, p-filter-expression) skip.
     1004      end.
     1005      put unformatted ')'.
     1006   end.
     1007   output close.
     1008   end procedure.
     1009   procedure proc-write-filter-expression-var :
     1010   define input parameter p-filter-expression as character no-undo .
     1011   define output parameter p-string as character no-undo .
     1012   define variable v-ii as integer no-undo .
     1013   if num-entries(p-filter-expression) > 0 then do:
     1014      p-string = 'and ('.
     1015      do v-ii = 1 to num-entries(p-filter-expression):
     1016        p-string = p-string + entry(v-ii, p-filter-expression) + chr(10).
     1017      end.
     1018      p-string = p-string + ')'.
     1019   end.
     1020   end procedure.
     1021   define new global shared variable g#libbcrcn as handle no-undo .
     1022   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1023   define variable v-waitfram-action01         as character   no-undo .
     1024   define variable v-waitfram-action02         as character   no-undo .
     1025   define variable v-waitfram-action03         as character   no-undo .
     1026   define variable mWaitFramTextBeg            as character   no-undo.
     1027   define variable mWaitFramTextEnd            as character   no-undo.
     1028   define variable mWaitFramView               as logical     no-undo.
     1029   define variable mWaitProcEvent              as logical     no-undo init yes.
     1030   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1031   define variable mWaitFramStop               as logical     no-undo.
     1032   define variable mWaitFramStopUser           as logical     no-undo.
     1033   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1034   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1035   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1036   define button B-WaitFramStop auto-end-key
     1037        label "Стоп"
     1038        size 10 by 1 tooltip "Остоновить процесс".
     1039   define button B-viewProcInfo
     1040        label "Информация"
     1041        size 15 by 1 tooltip "Информация о процесс".
     1042   define frame waitfram
     1043     v-waitfram-action01 format "x(72)" no-label skip
     1044     v-waitfram-action02 format "x(72)" no-label skip
     1045     v-waitfram-action03 format "x(72)" no-label skip
     1046     B-viewProcInfo
     1047     B-WaitFramStop at row 4 col 30
     1048     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1049     .
     1050   define new global shared variable mBatchMode as logical no-undo init ?.
     1051   define variable mFramBachModHandle as handle no-undo.
     1052   mFramBachModHandle = frame waitfram:handle.
     1053   define variable mFameOldVis as logical no-undo.
     1054   define variable mVisCUrentVin as logical no-undo.
     1055   if session:batch-mode
     1056   then
     1057      mBatchMode = yes.
     1058   if mBatchMode = ? then do:
     1059     mVisCUrentVin = current-window:visible.
     1060     mFameOldVis = mFramBachModHandle:visible.
     1061     mFramBachModHandle:visible  = yes.
     1062     mBatchMode = mFramBachModHandle:visible ne yes.
     1063     mFramBachModHandle:visible = mFameOldVis.
     1064     current-window:visible = mVisCUrentVin.
     1065   end.
     1066    if  log-manager:logfile-name ne ?
     1067     then DO:
     1068         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1069         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1070         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1071     end.
     1072   on choose of B-WaitFramStop in frame waitfram
     1073   do:
     1074     mWaitFramStop = yes.
     1075     mWaitFramStopUser = yes.
     1076   end.
     1077   function waitfram-check-timeout returns logical():
     1078      define variable vtime as int64 no-undo.
     1079      if mWaitFramStopTimeOut
     1080      then
     1081         return yes.
     1082      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1083      if     mWaitFramTimeOut ne ?
     1084         and mWaitFramTimeOut ne 0
     1085         and mWaitFramTimeOut lt vtime
     1086      then do:
     1087         mWaitFramStopTimeOut = yes.
     1088      end.
     1089      return mWaitFramStopTimeOut.
     1090   end.
     1091   procedure waitfram-hide :
     1092     if not session:batch-mode
     1093     then do
     1094     on error undo, return error return-value
     1095     :
     1096       pause 0 before-hide .
     1097       if not mBatchMode then
     1098         hide frame waitfram .
     1099     if     not mWaitFramView
     1100        and mWaitProcEvent
     1101     then
     1102       process events .
     1103     end.
     1104   end procedure.
     1105   procedure waitfram-show :
     1106     define input  parameter p-message as character no-undo .
     1107     define variable v-left-margin as integer   no-undo .
     1108     if not session:batch-mode
     1109     then do
     1110     on error undo, return error return-value
     1111     :
     1112       if length(p-message) <= 70 then do:
     1113         assign
     1114           v-left-margin = integer((70 - length(p-message)) / 2)
     1115         .
     1116         assign
     1117           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1118         .
     1119         assign
     1120           v-waitfram-action01 = " "
     1121           v-waitfram-action02 = " "
     1122                                    + fill(" ", v-left-margin)
     1123                                    + p-message
     1124           v-waitfram-action03 = " "
     1125         .
     1126       end.
     1127       else do:
     1128         define variable vRindex1 as integer no-undo.
     1129         define variable vRindex2 as integer no-undo.
     1130         vRindex1 = r-index(p-message," ",70).
     1131         if vRindex1 = 0
     1132         then
     1133            vRindex1 = 70.
     1134         if length(p-message)  <= vRindex1 + 70 then do:
     1135           assign
     1136             v-waitfram-action01 = " "
     1137             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1138             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1139           .
     1140         end.
     1141         else do:
     1142           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1143           if vRindex2 <= vRindex1
     1144           then
     1145              vRindex2 = vRindex1 + 70.
     1146           assign
     1147             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1148             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1149             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1150           .
     1151         end.
     1152       end.
     1153       B-viewProcInfo:visible   in frame waitfram = no.
     1154       B-viewProcInfo:sensitive in frame waitfram = no.
     1155       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1156       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1157       if  (   mWaitFramView
     1158          or  mWaitProcEvent)
     1159          and not mBatchMode
     1160       then
     1161          display
     1162             v-waitfram-action01 skip
     1163             v-waitfram-action02 skip
     1164             v-waitfram-action03 skip
     1165          with frame waitfram .
     1166       if     mWaitFramView
     1167          then do:
     1168             if     mWaitFramInterval ne ?
     1169                and not mBatchMode
     1170             then
     1171                wait-for go of frame waitfram pause mWaitFramInterval.
     1172          end.
     1173          else
     1174             if     mWaitProcEvent
     1175                and not mBatchMode
     1176             then
     1177                process events .
     1178     end.
     1179   end procedure.
     1180      procedure waitfram-show-this:
     1181         define input  parameter iInterval as int64 no-undo.
     1182         define variable vtime as int64 no-undo.
     1183         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1184         mWaitFramInterval = iInterval.
     1185         run waitfram-show (substitute("&1&2 &3&4" ,
     1186                                       mWaitFramTextBeg ,
     1187                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1188                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1189                                       mWaitFramTextEnd
     1190                                      )
     1191                           ).
     1192      end.
     1193      procedure WaitFramRunPause:
     1194         define input  parameter iInterval as dec no-undo.
     1195         define variable vStart  as datetime-tz no-undo.
     1196         define variable vend    as datetime-tz no-undo.
     1197         define variable vint as int64 no-undo.
     1198         define variable vOk as logical no-undo.
     1199         vStart = now.
     1200         vend   = vStart.
     1201         publish "WaitFramPause" (iInterval,output vOk).
     1202         vend   =  now.
     1203         vint = vend - vStart.
     1204         vint = iInterval - vint / 1000.
     1205         if     not mWaitFramStop
     1206            and (   vint > 0
     1207                 or (    not vOk
     1208                     and iInterval eq ?
     1209                     )
     1210                 )
     1211         then
     1212            run waitfram-show-this (iInterval).
     1213         vend   =  now.
     1214         vint = vend - vStart.
     1215         vint = iInterval - vint / 1000.
     1216         if     not mWaitFramStop
     1217            and vint > 0
     1218         then do:
     1219            run gbl/pause.p (vint * 1000).
     1220         end.
     1221         if iInterval ne ?
     1222         then
     1223            publish "WaitFramStop".
     1224         waitfram-check-timeout().
     1225      end.
     1226      procedure WaitFramWaitFor:
     1227         define input  parameter iInterval as dec no-undo.
     1228         assign
     1229            mWaitFramStartProc   = now
     1230            mWaitFramStopUser    = no
     1231            mWaitFramStopTimeOut = no
     1232         .
     1233         block-wait:
     1234         do while not mWaitFramStop:
     1235            run WaitFramRunPause (iInterval).
     1236            if  waitfram-check-timeout()
     1237            then do:
     1238               leave block-wait.
     1239            end.
     1240         end.
     1241         run waitfram-hide.
     1242      end.
     1243   procedure waitfram-join :
     1244     define input  parameter p-line-1  as character no-undo .
     1245     define input  parameter p-line-2  as character no-undo .
     1246     define input  parameter p-line-3  as character no-undo .
     1247     define output parameter p-message as character no-undo .
     1248     do
     1249     on error undo, return error return-value
     1250     :
     1251       assign
     1252         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1253                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1254                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1255       .
     1256     end.
     1257   end procedure.
     1258   function waitfram-join-function returns character
     1259     (input p-line-1 as character
     1260     ,input p-line-2 as character
     1261     ,input p-line-3 as character
     1262     ).
     1263     define variable v-message as character no-undo .
     1264     run waitfram-join in this-procedure
     1265       (input  p-line-1
     1266       ,input  p-line-2
     1267       ,input  p-line-3
     1268       ,output v-message
     1269       ) .
     1270     return v-message .
     1271   end function .
     1272   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1273   procedure cur-time :
     1274      define output parameter p-today as date      no-undo .
     1275      define output parameter p-time  as integer   no-undo .
     1276     do
     1277     on error undo, return error
     1278     :
     1279       define variable v-date1 as date      no-undo .
     1280       define variable v-date2 as date      no-undo .
     1281       define variable v-time  as integer   no-undo .
     1282       assign
     1283         v-date1 = today
     1284         v-time  = time
     1285         v-date2 = today
     1286       .
     1287       if v-date1 <> v-date2
     1288       then do:
     1289         assign
     1290           v-date1 = today
     1291           v-time  = v-time
     1292         .
     1293       end.
     1294       assign
     1295         p-today = v-date1
     1296         p-time  = v-time
     1297       .
     1298     end.
     1299   end.
     1300   function cur-time-date returns character
     1301   :
     1302     return string(today, '99/99/9999':U) .
     1303   end.
     1304   function cur-time-mjd returns decimal
     1305   :
     1306     define variable v-date as date      no-undo .
     1307     define variable v-time as integer   no-undo .
     1308     run cur-time in this-procedure
     1309       (output v-date
     1310       ,output v-time
     1311       ) .
     1312     return integer(v-date) - 2400002 + (v-time / 86400) .
     1313   end.
     1314   function cur-time-get-ending-index returns integer
     1315   (input p-number as integer
     1316   )
     1317   :
     1318     if p-number < 0
     1319     or p-number = ?
     1320     then do:
     1321       return 1 .
     1322     end.
     1323     define variable v-rest as integer   no-undo .
     1324     assign
     1325       p-number = p-number modulo 100
     1326     .
     1327     if p-number < 20
     1328     then do:
     1329       assign
     1330         v-rest = p-number
     1331       .
     1332     end.
     1333     else do:
     1334       assign
     1335         v-rest = p-number modulo 10
     1336       .
     1337     end.
     1338     case v-rest :
     1339       when 1
     1340       then do:
     1341         return 2 .
     1342       end.
     1343       when 2 or
     1344       when 3 or
     1345       when 4
     1346       then do:
     1347         return 3 .
     1348       end.
     1349       otherwise do:
     1350         return 1 .
     1351       end.
     1352     end case .
     1353   end.
     1354   procedure cur-time-mjd-to-date :
     1355      define input  parameter i-mjd-diff as decimal no-undo.
     1356      define output parameter o-Date     as date    no-undo.
     1357      define output parameter o-Time     as integer no-undo.
     1358      define variable v-day-number as integer   no-undo .
     1359      if    i-mjd-diff < 0
     1360         or i-mjd-diff = ?
     1361      then do:
     1362         return "?" .
     1363      end.
     1364      assign
     1365         v-day-number = truncate(i-mjd-diff,0).
     1366         o-Date = date(v-day-number + 2400002).
     1367         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1368     .
     1369   end.
     1370   function cur-time-mjd-to-string returns character
     1371   (input p-mjd-diff as decimal
     1372   )
     1373   :
     1374     define variable v-day-number as integer   no-undo .
     1375     define variable v-seconds    as integer   no-undo .
     1376     define variable v-hour       as integer   no-undo .
     1377     define variable v-min        as integer   no-undo .
     1378     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1379     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1380     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1381     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1382     if p-mjd-diff < 0
     1383     or p-mjd-diff = ?
     1384     then do:
     1385       return "?" .
     1386     end.
     1387     assign
     1388       v-day-number = integer(truncate(p-mjd-diff,0))
     1389       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1390     .
     1391     if v-seconds > 86400
     1392     then do:
     1393       assign
     1394         v-seconds = 86400 - 1
     1395       .
     1396     end.
     1397     if v-seconds < 0
     1398     then do:
     1399       assign
     1400         v-seconds = 0
     1401       .
     1402     end.
     1403     assign
     1404       v-hour = truncate(v-seconds / 3600, 0)
     1405     .
     1406     assign
     1407       v-seconds = v-seconds modulo 3600
     1408     .
     1409     assign
     1410       v-min = truncate(v-seconds / 60, 0)
     1411     .
     1412     assign
     1413       v-seconds = v-seconds modulo 60
     1414     .
     1415     return
     1416         (if v-day-number <> 0
     1417           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1418           else ""
     1419         )
     1420       + (if v-day-number <> 0 or v-hour <> 0
     1421           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1422           else ""
     1423         )
     1424       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1425           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1426           else ""
     1427         )
     1428       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1429       .
     1430   end.
     1431   function cur-time-string returns character
     1432   :
     1433     define variable v-date as date      no-undo .
     1434     define variable v-time as integer   no-undo .
     1435     run cur-time in this-procedure
     1436       (output v-date
     1437       ,output v-time
     1438       ) .
     1439     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1440   end.
     1441   function cur-time-string-sec returns character
     1442   :
     1443     define variable v-date as date      no-undo .
     1444     define variable v-time as integer   no-undo .
     1445     run cur-time in this-procedure
     1446       (output v-date
     1447       ,output v-time
     1448       ) .
     1449     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1450   end.
     1451   function cur-time-custom  returns character
     1452   (input p-prefix as character
     1453   ,input p-date-format as character
     1454   ,input p-delimiter as character
     1455   ,input p-time-format as character
     1456   ,input p-suffix as character
     1457   )
     1458   :
     1459     define variable v-date as date      no-undo .
     1460     define variable v-time as integer   no-undo .
     1461     run cur-time in this-procedure
     1462       (output v-date
     1463       ,output v-time
     1464       ) .
     1465     return
     1466       p-prefix
     1467       + string(v-date, p-date-format)
     1468       + p-delimiter
     1469       + string(v-time, p-time-format)
     1470       + p-suffix
     1471       .
     1472   end.
     1473   function cur-time-print  returns character
     1474   :
     1475     define variable v-date as date      no-undo .
     1476     define variable v-time as integer   no-undo .
     1477     run cur-time in this-procedure
     1478       (output v-date
     1479       ,output v-time
     1480       ) .
     1481     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1482   end.
     1483   function cur-time-datetime returns datetime
     1484   :
     1485     define variable v-char as character no-undo .
     1486     define variable v-datetime as datetime no-undo .
     1487     v-char = cur-time-string().
     1488     v-datetime = datetime(v-char).
     1489     return  v-datetime.
     1490   end.
     1491   function cur-time-string-msec returns character
     1492   :
     1493     define variable v-date as datetime  no-undo .
     1494     v-date = now.
     1495     return string(v-date) .
     1496   end.
     1497   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1498     define variable v-cntxt-db-num        as integer   no-undo .
     1499     define variable v-cntxt-userid        as character no-undo .
     1500     define variable v-cntxt-level         as character no-undo .
     1501     define variable v-cntxt-host-code-obj as integer   no-undo .
     1502     define variable v-cntxt-obj-type      as character no-undo .
     1503     define variable v-cntxt-obj-code      as integer   no-undo .
     1504     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1505     define variable v-cntxt-is-admin      as logical   no-undo .
     1506   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1507   define  stream PrnLibStream.
     1508   procedure prn-lib-prn-file :
     1509     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1510     define input parameter p-DIsabledoptions as integer no-undo .
     1511     define variable v-report-name as character no-undo .
     1512     define variable v-user-action as character no-undo .
     1513     define variable v-printed     as logical   no-undo .
     1514     define variable v-exist       as logical   no-undo .
     1515     do
     1516       on error undo, return error
     1517       :
     1518       run prn-lib-get-report-name  in this-procedure (
     1519         input parParentProc
     1520         ,output v-report-name
     1521         ).
     1522   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1523   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1524     (input  v-report-name
     1525     ,input  2
     1526     ,output v-exist
     1527     )  .
     1528       if NOT v-exist then
     1529       DO:
     1530         Message
     1531           "Нет заданий на печать ! "
     1532           view-as alert-box .
     1533         Return  .
     1534       End.
     1535       run gbl/prnfilen.w
     1536         (input  ""
     1537         ,input  p-DisabledOptions
     1538         ,input  string(v-report-name )
     1539         ,input  7
     1540         ,output v-user-action
     1541         ,output v-printed
     1542         ) .
     1543       if v-printed then
     1544       do:
     1545         return "YES" .
     1546       end.
     1547       else
     1548       do:
     1549         return "NO" .
     1550       end.
     1551     end.
     1552   end procedure.
     1553   procedure prn-lib-open-stream :
     1554     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1555     define input parameter p-page-size    as integer no-undo .
     1556     define input parameter p-is-stream    as logical no-undo .
     1557     define input parameter p-append       as logical no-undo .
     1558     define variable v-report-name as character no-undo .
     1559     do
     1560       on error undo, return error
     1561       :
     1562       run prn-lib-get-report-name  in this-procedure (
     1563         input parParentProc
     1564         ,output v-report-name
     1565         ).
     1566       if p-is-stream then
     1567       do:
     1568         if p-append then
     1569         do:
     1570           output stream PrnLibStream to value( v-report-name )
     1571             page-size value(p-page-size) append .
     1572         end.
     1573         if not p-append then
     1574         do:
     1575           output stream PrnLibStream to value( v-report-name )
     1576             page-size value(p-page-size) .
     1577         end.
     1578       end.
     1579       if not p-is-stream then
     1580       do:
     1581         if p-append then
     1582         do:
     1583           output to value( v-report-name )
     1584             page-size value(p-page-size) append .
     1585         end.
     1586         if not p-append then
     1587         do:
     1588           output to value( v-report-name )
     1589             page-size value(p-page-size) .
     1590         end.
     1591       end.
     1592     end.
     1593   end procedure.
     1594   procedure prn-lib-open-exp :
     1595     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1596     define input parameter p-is-stream    as logical no-undo .
     1597     define input parameter p-is-append    as logical no-undo .
     1598     define output parameter p-ReportFileName as char init "report" no-undo.
     1599     define output parameter p-process as logical no-undo .
     1600     define variable glog as logical no-undo .
     1601     do
     1602       on error undo, return error
     1603       :
     1604       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1605         TITLE      "Укажите путь"
     1606         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1607         ASK-OVERWRITE
     1608         CREATE-TEST-FILE
     1609         SAVE-AS
     1610         USE-FILENAME
     1611         DEFAULT-EXTENSION "txt"
     1612         UPDATE glog
     1613         .
     1614       if not glog then  return.
     1615       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1616       if p-is-stream then
     1617       do:
     1618         if p-is-append then
     1619         do:
     1620           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1621         end.
     1622         else
     1623         do:
     1624           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1625         end.
     1626       end.
     1627       else
     1628       do:
     1629         if p-is-append then
     1630         do:
     1631           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1632         end.
     1633         else
     1634         do:
     1635           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1636         end.
     1637       end.
     1638       p-process = yes.
     1639     end.
     1640   end procedure.
     1641   procedure prn-lib-get-report-name :
     1642     define input parameter parParentProc  as widget-handle no-undo.
     1643     define output parameter p-report-name as character no-undo .
     1644     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1645   end procedure.
     1646   procedure prn-lib-reportviewer-report-name :
     1647     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1648     define input parameter p-report-name-html as character no-undo .
