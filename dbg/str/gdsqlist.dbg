    11172   glog = yes.
    11173   CASE rs-list-method:
    11174     when "parts-last-date":U then do:
    11175       assign
    11176       v-message = substitute("ФиБ партии свободной зоны на &1&2", chr(10), stat-line(rs-status))
    11177       .
    11178     end.
    11179   END CASE.
    11180   message
    11181   v-message
    11182   view-as alert-box question buttons OK-Cancel update glog.
    11183   if not glog then do:
    11184     return error.
    11185   end.
    11186   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11187   run userobjs_select-one in this-procedure
    11188     (input  parparentproc
    11189     ,input  v-cntxt-db-num
    11190     ,input  v-cntxt-userid
    11191     ,input  v-cntxt-host-code-obj
    11192     ,input  v-cntxt-obj-type
    11193     ,input  v-cntxt-obj-code
    11194     ,output v-user-select
    11195     ,output v-sel-obj-type
    11196     ,output v-sel-obj-code
    11197     )  .
    11198   if not v-user-select then do:
    11199     return error.
    11200   end.
    11201   CASE rs-list-method:
    11202     when "parts-fib":U then do:
    11203       assign
    11204       dsp-rs = substitute("ФиБ партии свободной зоны на &1&2 &4", v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    11205       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)
    11206       .
    11207     end.
    11208   END CASE.
    11209   v-no-hist = 0.
    11210   run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    11211                                       , input-output v-seq
    11212                                       , input 0
    11213                                       , input '':U
    11214                                       , input dsp-rs
    11215                                       , input tot-lns
    11216                                       , input rs-list-method
    11217                                       , input rs-status
    11218                                       , input v-item
    11219                                       , input '':U
    11220                                       , input ?
    11221                                       ).
    11222   END PROCEDURE.
    11223   PROCEDURE proc-simple :
    11224   define input parameter rs-list-method as character no-undo .
    11225   define variable v-ref-list as character no-undo .
    11226   define variable v-rid-list as character no-undo .
