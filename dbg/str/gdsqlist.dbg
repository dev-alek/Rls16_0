     4107     if available buf_bar-code then do:
     4108           find first l-goods where
     4109                     l-goods.gds-code =
     4110     buf_bar-code.gds-code No-LOCK.
     4111           find first l-gds-list where
     4112                     l-gds-list.artic = l-goods.artic AND
     4113                     l-gds-list.prod-type = l-goods.prod-type AND
     4114                     l-gds-list.prod-code = l-goods.prod-code no-lock no-error.
     4115       if available l-gds-list then do:
     4116         line-rec = recid (l-gds-list).
     4117         reposition br-list to recid line-rec no-error.
     4118         apply "value-changed" to br-list in frame Dialog-Frame.
     4119       end.
     4120       else do:
     4121         message "Строка не найдена."
     4122                 view-as alert-box error.
     4123       end.
     4124     end.
     4125     else
     4126       message "Бар-код не найден."
     4127               view-as alert-box error.
     4128     apply "entry" to loc-code in frame Dialog-Frame.
     4129   END PROCEDURE.
     4130   PROCEDURE  proc-mouse-dbl-click-loc-name:
     4131     assign
     4132     frame Dialog-Frame
     4133     loc-name.
     4134       if last-event:label = "Ctrl-J" then
     4135         find next l-gds-list where
     4136                   can-find (ub.goods where ub.goods.artic = l-gds-list.artic and
     4137                   ub.goods.prod-type = l-gds-list.prod-type and
     4138                   ub.goods.prod-code = l-gds-list.prod-code and
     4139                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     4140       else
     4141         find first l-gds-list where
     4142                   can-find (ub.goods where ub.goods.artic = l-gds-list.artic and
     4143                   ub.goods.prod-type = l-gds-list.prod-type and
     4144                   ub.goods.prod-code = l-gds-list.prod-code and
     4145                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     4146       if available l-gds-list then do:
     4147         line-rec = recid (l-gds-list).
     4148         reposition br-list to recid line-rec no-error.
     4149            apply "value-changed" to br-list in frame Dialog-Frame.
     4150       end.
     4151       else do:
     4152         message "Строка не найдена."
     4153                 view-as alert-box error.
     4154       end.
     4155     apply "entry" to loc-name in frame Dialog-Frame.
     4156   END PROCEDURE.
     4157   on value-changed of br-list in frame Dialog-Frame do:
     4158   if not available gds-list or recid (gds-list) <> line-rec then do:
     4159       hide loc-art in frame Dialog-Frame.
     4160       loc-art = "".
     4161   end.
     4162   if available gds-list then do:     find ub.clients where ub.clients.obj-type = gds-list.prod-type                    and ub.clients.obj-code = gds-list.prod-code no-lock.     find ub.gds-prt where ub.gds-prt.upper-code = gds-list.prt-root no-lock.     find ub.bar-code where ub.bar-code.gds-code  = gds-list.gds-code                     and ub.bar-code.node-code = ub.gds-prt.node-code                     and ub.bar-code.unit-cli  = gds-list.unit-base                     and ub.bar-code.in-code   = ""                     and ub.bar-code.part-code = "" no-lock.     disp ub.clients.obj-name ub.gds-prt.node-name ub.bar-code.b-code tot-lns @ f-tot-lns with frame Dialog-Frame.   end.   else display f-tot-lns with frame Dialog-Frame.
     4163   end.
