     8161                buf_gds-list-hist.id = p-id
     8162           and  buf_gds-list-hist.item_ <> '':U:
     8163         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_gds-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     8164         grp-path = "".
     8165         find first gds-grp no-lock where rowid(gds-grp) = v-rowid.
     8166         run grplib-get-full-name in this-procedure (gds-grp.node-code, output grp-path).
     8167         goods:
     8168         for each goods where goods.grp-name begins grp-path no-lock,
     8169             each recipe no-lock where recipe.artic = ub.goods.artic
     8170                           and recipe.prod-type = ub.goods.prod-type
     8171                           and recipe.prod-code = ub.goods.prod-code :
     8172             for each recipe-gds where recipe-gds.recipe-code = recipe.recipe-code no-lock:
     8173             if can-find(first gds-obj no-lock where gds-obj.obj-type = v-cntxt-obj-type
     8174                                     and gds-obj.obj-code = v-cntxt-obj-code
     8175                                     and gds-obj.gds-code = recipe-gds.gds-code
     8176                                     and gds-obj.fact-qnty > 0) then.
     8177             else do:
     8178                   run ex-gds  in this-procedure ( buffer goods, input rs-list-method, input rs-status, input line-mode).
     8179                   next goods.
     8180               end.
     8181             end.
     8182         end.
     8183         assign                                                           buf_gds-list-hist.num-add  = lns-cnt - v-num-add                       buf_gds-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_gds-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_gds-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8184        end.
     8185     end.
     8186     when "move-date":U then do:
     8187         find first buf_gds-list-hist where
     8188             buf_gds-list-hist.id = p-id
     8189         AND buf_gds-list-hist.item_ <> '':U .
     8190         for each gds-obj  no-lock where gds-obj.obj-type = v-cntxt-obj-type
     8191                                     and gds-obj.obj-code = v-cntxt-obj-code
     8192                                     and gds-obj.last-doc >= date(buf_gds-list-hist.item_):
     8193             for first goods no-lock where
     8194                   goods.artic = ub.gds-obj.artic
     8195               and goods.prod-type = ub.gds-obj.prod-type
     8196               and goods.prod-code = ub.gds-obj.prod-code:
     8197               run ex-gds in this-procedure ( buffer goods, input rs-list-method, input rs-status, input line-mode).
     8198               assign                                                           buf_gds-list-hist.num-add  = lns-cnt - v-num-add                       buf_gds-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_gds-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_gds-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8199             end.
     8200         end.
     8201     end.
     8202   end.
     8203   dsp-rs:fgcolor in frame Dialog-Frame = 4.
     8204   if session:set-wait-state( "" )  then .
     8205   case line-mode :
     8206     when 'ДОБАВЛЕНИЕ':U then do:
     8207       tot-lns = tot-lns + lns-cnt.
     8208     end.
     8209     when 'удаление':U then do:
     8210       tot-lns = tot-lns - lns-cnt.
     8211     end.
     8212   end.
     8213   if line-mode <> 'ОСТАВИТЬ':U then  run UI-on in this-procedure.
     8214   end.
     8215   END PROCEDURE.
     8216   PROCEDURE write-hist :
     8217   define input parameter p-from-macro as logical no-undo .
     8218   define input parameter rs-list-method as character no-undo .
     8219   define input parameter rs-status as character no-undo .
     8220   define input parameter line-mode as character no-undo .
     8221   define variable v-ii as integer no-undo .
     8222   define variable v-temp-seq as integer no-undo .
     8223   if rs-list-method = "single" then do:
     8224     if v-no-hist < 0 then do:
     8225       run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8226                                           , input-output v-seq
     8227                                           , input 0
     8228                                           , input get-hist-mode(line-mode)
     8229                                           , input substitute("ТОВАР код &1 &2 &3&4 &5", gds-list.gds-code, gds-list.artic, gds-list.prod-type, gds-list.prod-code, gds-list.gds-name)
     8230                                           , input tot-lns
     8231                                           , input rs-list-method
     8232                                           , input rs-status
     8233                                           , input ('goods':U + chr(3) + string(gds-list.gds-code))
     8234                                           , input '':U
     8235                                           , input ?
     8236                                           ).
     8237     end.
     8238     else do:
     8239       v-temp-seq = v-seq - 1.
     8240       do v-ii = 0 to v-no-hist:
     8241         run create-gds-list-hist in this-procedure(input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     8242                                             , input-output v-temp-seq
     8243                                             , input v-ii
     8244                                             , input get-hist-mode(line-mode)
     8245                                             , input substitute("ТОВАР код &1 &2 &3&4 &5", gds-list.gds-code, gds-list.artic, gds-list.prod-type, gds-list.prod-code, gds-list.gds-name)
     8246                                             , input tot-lns
     8247                                             , input '':U
     8248                                             , input '':U
     8249                                             , input ('goods':U + chr(3) + string(gds-list.gds-code))
     8250                                             , input '':U
     8251                                             , input ?
     8252                                             ).
     8253       end.
     8254     end.
     8255   end.
     8256   else do:
     8257     v-temp-seq = v-seq - 1.
     8258     do v-ii = 0 to v-no-hist:
     8259       run create-gds-list-hist in this-procedure(input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     8260                                           , input-output  v-temp-seq
     8261                                           , input v-ii
     8262                                           , input get-hist-mode(line-mode)
     8263                                           , input '':U
     8264                                           , input tot-lns
     8265                                           , input rs-list-method
     8266                                           , input '':U
     8267                                           , input '':U
     8268                                           , input '':U
     8269                                           , input ?
     8270                                           ).
     8271     end.
     8272   end.
     8273   END PROCEDURE.
     8274   procedure list_inf-local:
     8275   define variable glog as logical no-undo .
     8276   for each tt-goods:
     8277     delete tt-goods.
     8278   end.
     8279   for each tt-clients:
     8280     delete tt-clients.
     8281   end.
     8282   for each gds-list:
     8283   find ub.goods where ub.goods.artic     = gds-list.artic     and
     8284                   ub.goods.prod-type = gds-list.prod-type and
     8285                   ub.goods.prod-code = gds-list.prod-code no-lock.
     8286       create tt-goods.
     8287       buffer-copy ub.goods to tt-goods.
     8288   end.
     8289   create tt-clients.
     8290   assign tt-clients.obj-type = p-curr-obj-type
     8291         tt-clients.obj-code = p-curr-obj-code.
     8292   define variable vss-include-info57 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8293   do:
     8294     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8295       (input  v-cntxt-db-num
     8296       ,input  v-cntxt-userid
     8297       ,input  0
     8298       ,input  'actn_reference_archive':U
     8299       ,input  'global':U
     8300       ,input  0
     8301       ,input  '':U
     8302       ,input  0
     8303       ,input  0
     8304       ,input  0
     8305       ,input  0
     8306       ,input  true
     8307       ,output glog
     8308       )  .
     8309   end.
     8310   if glog then run arc/gds_inf.w
     8311   (input  parparentproc
     8312   ,input  v-cntxt-obj-type
     8313   ,input  v-cntxt-obj-code ).
     8314   end procedure.
     8315   FUNCTION stat-line RETURNS CHARACTER(input p-status-chr as character):
     8316   DEFINE VARIABLE var-stat-line as character no-undo .
     8317   CASE p-status-chr:
     8318     when 'все':U then do:
     8319       assign
     8320       var-stat-line = "(текущие и неактивные товары)"
     8321       .
     8322     end.
     8323     when 'текущие':U then do:
     8324       assign
     8325       var-stat-line = "(текущие товары)"
     8326       .
     8327     end.
     8328     when 'удаленные':U then do:
     8329       assign
     8330       var-stat-line = "(неактивные товары)"
     8331       .
     8332     end.
     8333   END CASE.
     8334   return var-stat-line .
     8335   END.
     8336   procedure proc-vc-rs-list-method :
     8337   define variable v-operation as integer no-undo .
     8338   define variable glog as logical no-undo .
     8339   define variable ii as integer no-undo .
     8340   define variable v-recs as integer no-undo .
     8341   define variable v-line as integer no-undo .
     8342   define variable v-item as character no-undo .
     8343   define variable v-tbl-name as character no-undo .
     8344   define variable v-bh as handle no-undo .
     8345   define variable v-tot-lns as integer no-undo .
     8346   define variable v-grp-rec as recid no-undo .
     8347   define variable v-ref-rec as recid no-undo .
     8348   define variable v-dopstr as character no-undo .
     8349   define variable v-input-output as character no-undo .
     8350   define variable v-doc-rec as recid no-undo .
     8351   define variable v-temp-seq as integer no-undo .
     8352   define variable v-message as character no-undo .
     8353   define variable grp-path as character no-undo .
     8354   define variable v-rid-list as character no-undo .
     8355   define variable v-uniq-key-rec as character no-undo .
     8356   define buffer buf_gds-list-hist for gds-list-hist.
     8357   define buffer buf_clob-bind for ub.clob-bind.
     8358   do
     8359   on error undo, return error
     8360   :
     8361     v-no-hist = - 1.
     8362     if temp-list.fvalue = "single" then
     8363     run UI-on in this-procedure.
     8364     else do:
     8365       v-no-hist = 0.
     8366       case rs-list-method:
     8367         when "all" then do:
     8368           glog = yes.
     8369           message "Все товары из справочника товаров"
     8370           skip stat-line(rs-status)
     8371           view-as alert-box question buttons OK-Cancel update glog.
     8372           if not glog then do:
     8373             run UI-on in this-procedure.
     8374             return error .
     8375           end.
     8376           v-no-hist = 1.
     8377           run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8378                                               , input-output v-seq
     8379                                               , input 0
     8380                                               , input '':U
     8381                                               , input substitute('Все товары &1', stat-line(rs-status))
     8382                                               , input tot-lns
     8383                                               , input rs-list-method
     8384                                               , input rs-status
     8385                                               , input 'all':U
     8386                                               , input '':U
     8387                                               , input ?
     8388                                               ).
     8389         end.
     8390         when "gds-grp" or
     8391         when "goods" or
     8392         when "gds-obj":U or
     8393         when "gds-obj-fact":U or
     8394         when "gds-obj-free":U or
     8395         when "no-recipe-gds":U
     8396         then do:
     8397           if rs-list-method = "gds-grp" or rs-list-method = "no-recipe-gds" then do:
     8398             glog = yes.
     8399             message "1 или несколько групп товаров"
     8400             skip stat-line(rs-status)
     8401             view-as alert-box question buttons OK-Cancel update glog.
     8402             if not glog then do:
     8403               run UI-on in this-procedure.
     8404               return error.
     8405             end.
     8406             grp-list = "".
     8407             ref-list = "".
     8408             run ref/gds-grp.w (input parparentproc
     8409                           ,input "b-sel,b-mark"
     8410                           ,input p-curr-obj-type
     8411                           ,input p-curr-obj-code
     8412                           ,input-output grp-list).
     8413           end.
     8414           else do:
     8415             glog = yes.
     8416             message "1 или несколько произвольных товаров из справочника."
     8417             skip stat-line(rs-status)
     8418             view-as alert-box question buttons OK-Cancel update glog.
     8419             if not glog then do:
     8420               run UI-on in this-procedure.
     8421               return error.
     8422             end.
     8423             run ref/gds-ref.p ( parparentproc
     8424                             ,"b-sel,b-mark,b-add"
     8425                             ,?
     8426                             ,?
     8427                             ,(if rs-list-method = "goods"
     8428                               then 'все':U
     8429                               else (if rs-list-method = "gds-obj":U
     8430                                     then 'объект':U
     8431                                     else (if rs-list-method = "gds-obj-fact":U
     8432                                           then 'факт':U
     8433                                           else (if rs-list-method = "gds-obj-free":U
     8434                                                 then 'свободно':U
     8435                                                 else ?
     8436                                                 )
     8437                                           )
     8438                                     )
     8439                             )
     8440                             ,?
     8441                             ,?
     8442                             ,?
     8443                             ,?
     8444                             ,p-curr-obj-type
     8445                             ,p-curr-obj-code
     8446                             ,?
     8447                             , output ref-list).
     8448             grp-list = ?.
     8449           end.
     8450           if grp-list <> ? and
     8451           grp-list <> "" then do:
     8452             v-recs = num-entries (grp-list).
     8453             do num-rec = 0 to v-recs:
     8454               if v-recs = 1 then do:
     8455                 num-rec = 1 .
     8456               end.
     8457               if num-rec > 0 then do:
     8458                 v-grp-rec = integer (entry (num-rec, grp-list)).
     8459                 find ub.gds-grp where recid (ub.gds-grp) = v-grp-rec no-lock.
     8460                 run grplib-get-full-name in this-procedure (ub.gds-grp.node-code, output grp-path).
     8461               end.
     8462               if v-recs = 1 then do:
     8463                 assign
     8464                 v-temp-seq = v-seq
     8465                 v-line     = 0
     8466                 dsp-rs = substitute("Группа : &1 &3", grp-path, stat-line(rs-status))
     8467                 v-item     = '':U
     8468                 v-tbl-name = 'gds-grp':U
     8469                 v-bh       = buffer ub.gds-grp:handle
     8470                 v-tot-lns = tot-lns
     8471                 .
     8472               end.
     8473               else do:
     8474                 if num-rec = 0 then do:
     8475                   assign
     8476                   v-temp-seq = v-seq
     8477                   v-line     = 0
     8478                   dsp-rs = substitute("Группы : &1", stat-line(rs-status))
     8479                   v-item     = '':U
     8480                   v-tbl-name = '':U
     8481                   v-bh       = ?
     8482                   v-tot-lns = tot-lns
     8483                   .
     8484                 end.
     8485                 else do:
     8486                   assign
     8487                   v-temp-seq = v-seq - 1
     8488                   v-line     = num-rec
     8489                   dsp-rs = substitute("&1", grp-path)
     8490                   v-item     = '':U
     8491                   v-tbl-name = 'gds-grp':U
     8492                   v-bh       = buffer ub.gds-grp:handle
     8493                   v-tot-lns = tot-lns + num-rec
     8494                   .
     8495                 end.
     8496               end.
     8497               v-no-hist = (if num-rec = 1 then 0 else num-rec).
     8498               run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8499                                                   , input-output v-temp-seq
     8500                                                   , input v-line
     8501                                                   , input '':U
     8502                                                   , input dsp-rs
     8503                                                   , input v-tot-lns
     8504                                                   , input rs-list-method
     8505                                                   , input rs-status
     8506                                                   , input v-item
     8507                                                   , input v-tbl-name
     8508                                                   , input v-bh
     8509                                                   ).
     8510               if num-rec = 0 or v-recs = 1 then v-seq  = v-temp-seq.
     8511             end.
     8512           end.
     8513           else if ref-list <> "" then do:
     8514             v-recs = num-entries (ref-list).
     8515             do num-rec = 0 to v-recs:
     8516               if v-recs = 1 then do:
     8517                 num-rec = 1 .
     8518               end.
     8519               if num-rec > 0 then do:
     8520                 v-ref-rec = integer (entry (num-rec, ref-list)).
     8521                 find ub.goods where recid (ub.goods) = v-ref-rec no-lock.
     8522               end.
     8523               if v-recs = 1 then do:
     8524                 assign
     8525                 v-temp-seq = v-seq
     8526                 v-line     = 0
     8527                 dsp-rs = substitute("Товар :&1 &2", ub.goods.gds-name, stat-line(rs-status))
     8528                 v-item     = '':U
     8529                 v-tbl-name = 'goods':U
     8530                 v-bh       = buffer goods:handle
     8531                 v-tot-lns = tot-lns
     8532                 .
     8533               end.
     8534               else do:
     8535                 if num-rec = 0 then do:
     8536                   assign
     8537                   v-temp-seq = v-seq
     8538                   v-line     = 0
     8539                   dsp-rs = substitute("Товары : &1", stat-line(rs-status))
     8540                   v-item     = '':U
     8541                   v-tbl-name = '':U
     8542                   v-bh       = ?
     8543                   v-tot-lns = tot-lns
     8544                   .
     8545                 end.
     8546                 else do:
     8547                   assign
     8548                   v-temp-seq = v-seq - 1
     8549                   v-line     = num-rec
     8550                   dsp-rs = substitute("код &1 &2 &3&4 &5", goods.gds-code, goods.artic, goods.prod-type, goods.prod-code, goods.gds-name)
     8551                   v-item     = '':U
     8552                   v-tbl-name = 'goods':U
     8553                   v-bh       = buffer ub.goods:handle
     8554                   v-tot-lns = tot-lns + num-rec
     8555                   .
     8556                 end.
     8557               end.
     8558               v-no-hist = (if num-rec = 1 then 0 else num-rec).
     8559               run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8560                                                   , input-output v-temp-seq
     8561                                                   , input v-line
     8562                                                   , input '':U
     8563                                                   , input dsp-rs
     8564                                                   , input v-tot-lns
     8565                                                   , input rs-list-method
     8566                                                   , input rs-status
     8567                                                   , input v-item
     8568                                                   , input v-tbl-name
     8569                                                   , input v-bh
     8570                                                   ).
     8571               if num-rec = 0 or v-recs = 1 then v-seq  = v-temp-seq.
     8572             end.
     8573           end.
     8574           else do:
     8575             run UI-on in this-procedure.
     8576             return error.
     8577           end.
     8578         end.
     8579         when "grp-prod" or
     8580         when "producer" then do:
     8581           if rs-list-method = "grp-prod" then do:
     8582             glog = yes.
     8583             message "товары по производителям из 1 или нескольких групп."
     8584             skip stat-line(rs-status)
     8585             view-as alert-box question buttons OK-Cancel update glog.
     8586             if not glog then do:
     8587               run UI-on in this-procedure.
     8588               return error.
     8589             end.
     8590             grp-list = "".
     8591             ref-list = "".
     8592             run ref/cli-grps.w ( input parparentproc
     8593                                 ,input "b-sel,b-mark"
     8594                                 ,input-output grp-list).
     8595           end.
     8596           else do:
     8597             glog = yes.
     8598             message "товары по 1 или нескольким производителям из справочника."
     8599             skip stat-line(rs-status)
     8600             view-as alert-box question buttons OK-Cancel update glog.
     8601             if not glog then do:
     8602               run UI-on in this-procedure.
     8603               return error.
     8604             end.
     8605             grp-list = "".
     8606             run ref/cli-all.w ( parparentproc
     8607                           ,"b-sel,b-mark"
     8608                           , ?
     8609                           , ?
     8610                           , ?
     8611                           , ?
     8612                           , ?
     8613                           , ?
     8614                           , output ref-list) .
     8615           end.
     8616           if grp-list <> ? and
     8617           grp-list <> "" then do:
     8618             v-recs = num-entries (grp-list).
     8619             do num-rec = 0 to v-recs:
     8620               if v-recs = 1 then do:
     8621                 num-rec = 1 .
     8622               end.
     8623               if num-rec > 0 then do:
     8624                 v-grp-rec = integer (entry (num-rec, grp-list)).
     8625                 find ub.cli-grp where recid (ub.cli-grp) = v-grp-rec no-lock.
     8626                 run cli-grplib-get-full-name in this-procedure (ub.cli-grp.node-code, output grp-path).
     8627               end.
     8628               if v-recs = 1 then do:
     8629                 assign
     8630                 v-temp-seq = v-seq
     8631                 v-line     = 0
     8632                 dsp-rs = substitute("Группа пр-лей: &1 &2", grp-path, stat-line(rs-status))
     8633                 v-item     = '':U
     8634                 v-tbl-name = 'cli-grp':U
     8635                 v-bh       = buffer cli-grp:handle
     8636                 v-tot-lns = tot-lns
     8637                 .
