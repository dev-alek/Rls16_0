     6785   HIDE FRAME Dialog-Frame.
     6786   PROCEDURE UI-on:
     6787   define variable v-recid0 as recid no-undo.
     6788   define variable v-start as logical no-undo .
     6789   define buffer buf_temp-list for temp-list.
     6790   define buffer buf_gds-list-hist for gds-list-hist.
     6791     find first buf_gds-list-hist where buf_gds-list-hist.id = 0 no-error.
     6792     if available buf_gds-list-hist then
     6793     assign
     6794     frame Dialog-Frame:title = substitute("СПИСОК  ТОВАРОВ &1",  string(buf_gds-list-hist.des, "X(60)"))
     6795     .
     6796       assign
     6797       frame Dialog-Frame:title = p-title
     6798       .
     6799     if tot-lns = ? then do:
     6800       v-start = yes.
     6801       for each l-gds-list :
     6802         accumulate l-gds-list.artic (count).
     6803       end.
     6804       tot-lns = (accum count l-gds-list.artic).
     6805       if tot-lns > 0 then do:
     6806         find last  buf_gds-list-hist no-error .
     6807         v-seq = (if available buf_gds-list-hist then buf_gds-list-hist.id else 0)  + 1.
     6808         run create-gds-list-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     6809                                              , input-output v-seq
     6810                                              , input 0
     6811                                              , input 'S':U
     6812                                              , input substitute("# Исходный список: &1 строк", tot-lns)
     6813                                              , input tot-lns
     6814                                              , input "start":U
     6815                                              , input '':U
     6816                                              , input '':U
     6817                                              , input '':U
     6818                                              , input ?
     6819                                              ).
     6820       end.
     6821       else do:
     6822         line-mode = 'ДОБАВЛЕНИЕ':U.
     6823         for each buf_gds-list-hist:
     6824           delete buf_gds-list-hist.
     6825         end.
     6826         v-seq = 1.
     6827         run create-gds-list-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     6828                                              , input-output v-seq
     6829                                              , input 0
     6830                                              , input '':U
     6831                                              , input "# Исходный список товаров пуст."
     6832                                              , input tot-lns
     6833                                              , input 'start':U
     6834                                              , input '':U
     6835                                              , input '':U
     6836                                              , input '':U
     6837                                              , input ?
     6838                                              ).
     6839       end.
     6840     end.
     6841     hide loc-art in frame Dialog-Frame loc-name loc-code in frame Dialog-Frame.
     6842     assign
     6843     loc-art = ""
     6844     RS-list-method = "single"
     6845     .
     6846     find first buf_temp-list no-lock where
     6847                buf_temp-list.fvalue = rs-list-method.
     6848     assign
     6849     v-recid0 = recid(buf_temp-list).
     6850     open query br-option for each temp-list no-lock .
     6851     if v-seq > 1 then
     6852     find last buf_gds-list-hist no-lock where
     6853               buf_gds-list-hist.id = (v-seq - 1)
     6854          and  buf_gds-list-hist.line = 0 no-error .
     6855     DISPLAY br-option
     6856     (if available buf_gds-list-hist
     6857     then buf_gds-list-hist.des
     6858     else '') @ dsp-rs
     6859     RS-Status WITH FRAME Dialog-Frame.
     6860     ENABLE
     6861     b-macro  when v-start
     6862     b-record when v-start
     6863     b-exit b-add b-hist b-help br-option br-list RS-Status WITH FRAME Dialog-Frame.
     6864     assign
     6865     b-add:label = "Исходн.сп."
     6866     .
     6867     if v-start then do:
     6868       hide
     6869       b-sel
     6870       b-mark
     6871       b-stop
     6872       b-clear-macro
     6873       in frame Dialog-Frame.
     6874       if lookup("b-sel", bttns) > 0
     6875       or lookup("b-mark", bttns) > 0
     6876       then do:
     6877         gds-list.to-sel:visible in browse br-list = yes.
     6878       end.
     6879       else do:
     6880         gds-list.to-sel:visible in browse br-list = no.
     6881       end.
     6882       if bttns <> '':U then do:
     6883         run proc-expand in this-procedure ( input 1, input b-sel:row, input br-list:row, input "b-sel,b-mark").
     6884       end.
     6885     end.
     6886     v-start = no.
     6887     if is-tsd = no then do:
     6888       menu-item m-scn-save:sensitive in menu m-save = no.
     6889     end.
     6890     reposition br-option to recid v-recid0.
     6891     if tot-lns > 0 then do:
     6892       Enable b-print b-arch b-rest b-save b-del b-lkp b-clr a-n-c
     6893       b-mark when lookup("b-mark", bttns) > 0
     6894       b-sel  when lookup("b-sel", bttns) > 0
     6895       WITH FRAME Dialog-Frame.
     6896     end.
     6897     else do:
     6898       DISABLE b-print b-arch b-rest b-save b-del b-lkp b-clr a-n-c
     6899       b-mark b-sel
     6900       WITH FRAME Dialog-Frame.
     6901     end.
     6902     open query br-list for each gds-list no-lock indexed-reposition.
     6903     if line-rec <> ? then
     6904       reposition br-list to recid line-rec no-error.
     6905     apply "entry" to br-list in frame Dialog-Frame.
     6906     if available gds-list then do:     find ub.clients where ub.clients.obj-type = gds-list.prod-type                    and ub.clients.obj-code = gds-list.prod-code no-lock.     find ub.gds-prt where ub.gds-prt.upper-code = gds-list.prt-root no-lock.     find ub.bar-code where ub.bar-code.gds-code  = gds-list.gds-code                     and ub.bar-code.node-code = ub.gds-prt.node-code                     and ub.bar-code.unit-cli  = gds-list.unit-base                     and ub.bar-code.in-code   = ""                     and ub.bar-code.part-code = "" no-lock.     disp ub.clients.obj-name ub.gds-prt.node-name ub.bar-code.b-code tot-lns @ f-tot-lns with frame Dialog-Frame.   end.   else display f-tot-lns with frame Dialog-Frame.
     6907   END PROCEDURE.
     6908   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6909   PROCEDURE ex-gds :
     6910       define parameter buffer buf_goods for ub.goods.
     6911       define input parameter rs-list-method as character no-undo .
     6912       define input parameter rs-status as character no-undo .
     6913       define input parameter line-mode as character no-undo .
     6914       if rs-list-method = "single":U or
     6915           (buf_goods.stts = 0  and rs-status <> 'удаленные':U) or
     6916           (buf_goods.stts <> 0 and rs-status <> 'текущие':U) then
     6917       do:
     6918           if line-mode = 'удаление':U or line-mode = 'ОСТАВИТЬ':U then
     6919           do:
     6920               if rs-list-method = "tsd":U then
     6921               do:
     6922                   for first ub.Code no-lock where ub.Code.parent = "TiketPrint" and
     6923                       ub.code.status_ = 0 and ub.Code.code = string(buf_goods.gds-code):
     6924                       find first gds-list where gds-list.artic = buf_goods.artic
     6925                           and gds-list.prod-type = buf_goods.prod-type
     6926                           and gds-list.prod-code = buf_goods.prod-code no-error.
     6927                       if available gds-list then
     6928                       do:
     6929                           if line-mode = 'удаление':U then
     6930                           do:
     6931                               lns-cnt = lns-cnt + 1.
     6932                               delete gds-list.
     6933                           end.
     6934                           else
     6935                           do:
     6936                               if gds-list.to-del = ? then.
     6937                               else
     6938                               do:
     6939                                   lns-cnt = lns-cnt + 1.
     6940                                   gds-list.to-del = ?.
     6941                               end.
     6942                           end.
     6943                       end.
     6944                   end.
     6945               end.
     6946               else
     6947               do:
     6948                   find first gds-list where gds-list.artic = buf_goods.artic
     6949                       and gds-list.prod-type = buf_goods.prod-type
     6950                       and gds-list.prod-code = buf_goods.prod-code no-error.
     6951                   if available gds-list then
     6952                   do:
     6953                       if line-mode = 'удаление':U then
     6954                       do:
     6955                           lns-cnt = lns-cnt + 1.
     6956                           delete gds-list.
     6957                       end.
     6958                       else
     6959                       do:
     6960                           if gds-list.to-del = ? then.
     6961                           else
     6962                           do:
     6963                               lns-cnt = lns-cnt + 1.
     6964                               gds-list.to-del = ?.
     6965                           end.
     6966                       end.
     6967                   end.
     6968               end.
     6969           end.
     6970           else
     6971               if line-mode = 'ДОБАВЛЕНИЕ':U then
     6972               do:
     6973   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6974   find gds-list
     6975     where gds-list.prod-type = buf_goods.prod-type
     6976       and gds-list.prod-code = buf_goods.prod-code
     6977       and gds-list.artic     = buf_goods.artic
     6978     no-error .
     6979   if available gds-list then do:
     6980     assign
     6981       gds-list.to-del = no
     6982     .
     6983   end.
     6984   else do:
     6985     define variable v-last48 as integer no-undo .
     6986     find last gds-list use-index oi no-error.
     6987     if available gds-list then do:
     6988       v-last48 = gds-list.order-num .
     6989     end.
     6990     else do:
     6991       v-last48 = 0 .
     6992     end.
     6993     create gds-list .
     6994     buffer-copy buf_goods to gds-list
     6995     assign
     6996       gds-list.to-del = no
     6997       gds-list.order-num = v-last48 + 1
     6998     .
     6999     assign
     7000       lns-cnt = lns-cnt + 1
     7001       line-rec = recid (gds-list)
     7002     .
     7003   end.
     7004                   if rs-list-method = "tsd":U  then
     7005                   do:
     7006                       for first ub.Code no-lock where ub.Code.parent = "TiketPrint" and
     7007                           ub.code.status_ = 0 and ub.Code.code = string(buf_goods.gds-code):
     7008                           find first gds-list where gds-list.gds-code = buf_goods.gds-code no-error.
     7009                           if available gds-list then
     7010                           do:
     7011                               gds-list.qnty = decimal(ub.Code.CodeValue) .
     7012                           end.
     7013                       end.
     7014                   end.
     7015               end.
     7016           if lns-cnt modulo 25 = 0 then
     7017               disp "ЖДИТЕ...    Обработано товаров :" + string (lns-cnt) @ dsp-rs with frame Dialog-Frame.
     7018       end.
     7019       else
     7020           assign
     7021               lns-ignore = lns-ignore + 1
     7022               .
     7023   end.
     7024   PROCEDURE rs-do:
     7025   define input parameter p-from-macro as logical no-undo .
     7026   define input parameter p-step as logical no-undo .
     7027   define input parameter rs-list-method as character no-undo .
     7028   define input parameter rs-status as character no-undo .
     7029   define input parameter line-mode as character no-undo .
     7030   define input parameter p-id      as integer no-undo .
     7031   define variable grp-path like ub.goods.grp-name no-undo.
     7032   define variable another-price like ub.price-list.price-sale no-undo.
     7033   define variable var-root-code like ub.gds-prt.node-code no-undo .
     7034   define variable v-rowid   as rowid no-undo .
     7035   define variable v-tbl-name as character no-undo .
     7036   define variable v-discnt-role as character no-undo .
     7037   define variable v-nonunique as character no-undo .
     7038   define variable vvalue-int as integer no-undo .
     7039   define variable glog as logical no-undo .
     7040   define variable v-date-chr as character no-undo .
     7041   define variable v-date as date no-undo .
     7042   define buffer buf_gds-list-hist for gds-list-hist.
     7043   define buffer buf_user-obj for ub.user-obj.
     7044   define buffer buf_units for ub.units.
     7045   define buffer buf_parts for ub.parts.
     7046   do
     7047   on error undo, return error return-value
     7048   :
     7049   assign
     7050   lns-cnt = 0
     7051   lns-ignore = 0
     7052   v-num-add     = 0
     7053   v-num-ignored = 0
     7054   tot-lns = (if line-mode = 'ОСТАВИТЬ':U then 0 else tot-lns)
     7055   .
     7056   run write-hist in this-procedure ( input p-from-macro
     7057                                     ,input rs-list-method
     7058                                     ,input rs-status
     7059                                     ,input line-mode).
     7060   if session:set-wait-state( "COMPILER" )  then .
     7061   dsp-rs:fgcolor in frame Dialog-Frame = 12.
     7062   case rs-list-method:
     7063     when "all" then do:
     7064       find first buf_gds-list-hist where
     7065                  buf_gds-list-hist.id = p-id .
     7066       for each ub.goods no-lock:
     7067         run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
     7068       end.
     7069       assign                                                           buf_gds-list-hist.num-add  = lns-cnt - v-num-add                       buf_gds-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_gds-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_gds-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7070     end.
     7071     when "gds-grp" then do:
     7072       for each buf_gds-list-hist where
     7073                buf_gds-list-hist.id = p-id
