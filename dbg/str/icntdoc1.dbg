        1   block-level on error undo, throw.
        2   define input parameter p-mode as character no-undo .
        3   define input parameter p-silent as logical no-undo .
        4   define input-output parameter p-recid as recid no-undo .
        5   define input parameter p-doc-code as character no-undo .
        6   define input parameter p-obj-type as character no-undo .
        7   define input parameter p-obj-code as integer no-undo .
        8   define input parameter p-host-code as integer no-undo .
        9   define input parameter p-doc-type as character no-undo .
       10   define input parameter p-ext-doc-type as character no-undo .
       11   define input parameter p-wrkr as integer no-undo .
       12   define input parameter p-agnt as integer no-undo .
       13   define input parameter p-boss as integer no-undo .
       14   define input parameter p-doc-date as date no-undo .
       15   define input parameter p-meas-el-cnt as decimal no-undo .
       16   define input parameter p-state-el-cnt as decimal no-undo .
       17   define input parameter p-state-mh-cnt as decimal no-undo .
       18   define input parameter p-PS as character no-undo .
       19   define input parameter p-creid as character no-undo .
       20   define input parameter p-ptrlcheck as character no-undo .
       21   define temp-table tt-icnt-line no-undo like ub.icnt-line.
       22   DEFINE INPUT PARAMETER TABLE FOR tt-icnt-line.
       23   define variable vss-revision    as character no-undo init "$Revision$":U .
       24   define variable vss-author      as character no-undo init "$Author$":U .
       25   define variable vss-date        as character no-undo init "$Date$":U .
       26   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       27   define variable vss-archive     as character no-undo init "$Archive$":U .
       28   define variable vss-description as character no-undo init "Сохранение документа счетчиков ТРК".
       29   procedure vss-get-info :
       30     define output parameter p-vss-revision    like vss-revision    no-undo .
       31     define output parameter p-vss-author      like vss-author      no-undo .
       32     define output parameter p-vss-date        like vss-date        no-undo .
       33     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       34     define output parameter p-vss-archive     like vss-archive     no-undo .
       35     define output parameter p-vss-description like vss-description no-undo .
       36     assign
       37       p-vss-revision    = vss-revision
       38       p-vss-author      = vss-author
       39       p-vss-date        = vss-date
       40       p-vss-workfile    = vss-workfile
       41       p-vss-archive     = vss-archive
       42       p-vss-description = vss-description
       43     .
       44   end procedure.
       45   procedure vss-get-parameters :
       46     define output parameter p-vss-parameters as character no-undo .
       47   end procedure.
       48   define new global shared variable g#vssrevis-logger as handle    no-undo .
       49   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       50   define variable v-vssrevis-logger                   as handle    no-undo .
       51   procedure vss-logevent :
       52     define input  parameter p-extra-paramters as character no-undo .
       53     define variable v-vssrevis-parameters as character no-undo .
       54     do
       55     on error undo, return error return-value
       56     :
       57       if  valid-handle(v-vssrevis-logger)
       58       and v-vssrevis-logger :get-signature("logevent") <> ""
       59       then do:
       60         run vss-get-parameters in this-procedure
       61           (output v-vssrevis-parameters
       62           ).
       63         run logevent in v-vssrevis-logger
       64           (input vss-workfile
       65           ,input vss-revision
       66           ,input v-vssrevis-parameters
       67           ,input p-extra-paramters
       68           ).
       69       end.
       70     end.
       71   end procedure.
       72   assign
       73     v-vssrevis-logger = g#vssrevis-logger
       74   .
       75   if  valid-handle(v-vssrevis-logger)
       76   and v-vssrevis-logger :get-signature("logevent") <> ""
       77   then do:
       78     assign
       79       v-vssrevis-logevent = true
       80     .
       81     run vss-logevent in this-procedure (input vss-description) .
       82   end.
       83   define new global shared variable g#language as character no-undo .
       84   if g#language <> '' and g#language <> 'rus':U then do:
       85     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       86   end.
       87   define new global shared variable g#library  as handle no-undo .
       88   define new global shared variable g#library2 as handle no-undo .
       89   define   shared variable g#auto as logical no-undo.
       90   define   shared variable g#news as logical no-undo.
       91   define   shared variable g#oxml as logical no-undo.
       92   define   shared variable g#esys as logical no-undo.
       93   define   shared variable g#news-source-db as integer no-undo.
       94   define   shared variable g#esys-source-esys as integer no-undo.
       95   define   shared variable g#db-num as integer   no-undo .
       96   define   shared variable g#userid as character no-undo .
       97   define   shared variable g#passwd as character no-undo .
       98   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       99   procedure doc-code:
      100   define input  parameter parmode          as   character           no-undo.
      101   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      102   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      103   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      104   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      105   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      106   define variable vardb-remote     as   logical             no-undo.
      107   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      108   define variable v-delimiter as character no-undo .
      109   do
      110   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      111   :
      112   find first buf_sys-ctrl no-lock .
      113   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      114     CASE parmode:
      115       when "main":u then do:
      116         if vardb-remote then do:
      117           assign
      118             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      119         end.
      120         else do:
      121           assign
      122             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      123         end.
      124       end.
      125       when "trio" then do:
      126         assign
      127           pardoc-code = replace (parroot-doc-code, "=", "*").
      128       end.
      129       otherwise do:
      130         assign
      131         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      132         no-error
      133         .
      134         if error-status:error  then do:
      135           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      136                                         ,chr(10)
      137                                         ,parmode
      138                                         ).
      139         end.
      140         if num-entries(parmode) = 1
      141         and parmode <> "chip":U
      142         and parmode <> "chip_s":U
      143         then do:
      144           assign
      145           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      146         end.
      147         else if (lookup("chip":U, parmode) > 0
      148                  or
      149                  lookup("chip_s":U, parmode) > 0) then do:
      150           assign
      151             vartemp-doc-code = parroot-doc-code.
      152           do while true:
      153             if index (vartemp-doc-code , ".") = 0 then
      154               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      155             else
      156               vartemp-doc-code  =
      157               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      158               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      159               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      160             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      161           end.
      162           assign
      163             pardoc-code = vartemp-doc-code.
      164         end.
      165       end.
      166     end CASE.
      167     if pardoc-code = '':U
      168     or (parroot-doc-code <> '':U
      169     and pardoc-code = parroot-doc-code) then do:
      170       undo, return error substitute("Ошибка при генерации номера документа&1"
      171                                     ,chr(10)).
      172     end.
      173   end.
      174   end. // procedure/method
      175   function get-doc-code-int64 returns int64
      176     ( input p-doc-code as character ) :
      177     define variable v-ind              as integer   no-undo .
      178     define variable v-num-entries      as integer   no-undo .
      179     define variable v-doc-code-int64   as int64     no-undo .
      180     define variable v-canonic-doc-code as character no-undo .
      181     assign
      182       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      183       v-canonic-doc-code = p-doc-code
      184     .
      185     do v-ind = 1 to v-num-entries
      186     :
      187       assign
      188         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      189       .
      190     end.
      191     assign
      192       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      193     .
      194     return v-doc-code-int64 .
      195   end. // function/method
      196   define variable v-mess as character no-undo .
      197   define variable v-db-num as integer no-undo .
      198   define variable v-ii as integer no-undo .
      199   define buffer buf_icnt-doc for ub.icnt-doc.
      200   define buffer buf_icnt-line for ub.icnt-line.
      201   define buffer buf_rvs-doc for ub.rvs-doc.
      202   define buffer old_icnt-doc for ub.icnt-doc.
      203   define buffer buf_chk-doc for ub.chk-doc.
      204   if p-mode <> 'ДОБАВЛЕНИЕ':U
      205   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      206     message vss-workfile vss-revision vss-description skip
      207             "Неверный параметр p-mode - " p-mode
      208     view-as alert-box error .
      209     return error '':u.
      210   end.
      211   main-block:
      212   do for buf_icnt-doc
      213   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      214   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      215   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      216   :
      217     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      218       if p-doc-type = 'инв-сч-трк':U then do:
      219         find first buf_rvs-doc no-lock
      220           where buf_rvs-doc.obj-type =  p-obj-type
      221             and buf_rvs-doc.obj-code =  p-obj-code
      222             and buf_rvs-doc.status_  <> 'факт':U
      223             and buf_rvs-doc.rvs-type <> 'перед_док':U
      224             and buf_rvs-doc.rvs-type <> 'после_док':U
      225             and buf_rvs-doc.rvs-type <> 'проверка':U
      226           no-error.
      227         if available buf_rvs-doc then do:
      228           if not( buf_rvs-doc.rvs-type = 'смена':U and buf_rvs-doc.rvs-code = p-PS ) then do:
      229             v-mess = substitute("Имеется открытый документ сверки под номером &1", buf_rvs-doc.rvs-code).
      230             run err-mess in this-procedure ( input-output v-mess).
      231             undo main-block, return error (if p-silent = yes then v-mess else '':U).
      232           end.
      233         end.
      234         find first old_icnt-doc no-lock
      235           where old_icnt-doc.obj-type =  p-obj-type
      236             and old_icnt-doc.obj-code =  p-obj-code
      237             and old_icnt-doc.status_  <> 'факт':U
      238           no-error.
      239         if available old_icnt-doc then do:
      240           v-mess = substitute( "Уже есть открытый документ инвентаризации счетчиков ТРК под номером &1", old_icnt-doc.doc-code ).
      241           run err-mess in this-procedure ( input-output v-mess).
      242           undo main-block, return error (if p-silent = yes then v-mess else '':U).
      243         end.
      244       end.
      245       run doc-code in this-procedure
      246         ( input  "main"
      247          ,input  p-obj-type
      248          ,input  p-obj-code
      249          ,input  ?
      250          ,output p-doc-code
      251         ) no-error.
      252       if error-status:error then do:
      253         v-mess = substitute( "Ошибка при генерации номера документа&1&2&1&3"
      254                              ,chr(10)
      255                              ,error-status:get-message(1)
      256                              ,return-value
      257                            ).
      258         run err-mess in this-procedure ( input-output v-mess).
      259         undo main-block, return error (if p-silent = yes then v-mess else '':U).
      260       end.
      261       create buf_icnt-doc.
      262       assign
      263         p-doc-code             = (if p-doc-type = 'инв-сч-трк':U
      264                                   then p-doc-code
      265                                   else substitute("e&1", p-doc-code))
      266         buf_icnt-doc.doc-code  = p-doc-code
      267         buf_icnt-doc.obj-type  = p-obj-type
      268         buf_icnt-doc.obj-code  = p-obj-code
      269         buf_icnt-doc.host-code = p-host-code
      270         buf_icnt-doc.doc-type  = p-doc-type
      271         buf_icnt-doc.ext-doc-type  = p-ext-doc-type
      272         buf_icnt-doc.status_   = 'новый':U
      273         buf_icnt-doc.flag_     = no
      274         buf_icnt-doc.creid     = p-creid
      275         buf_icnt-doc.PS        = p-ps
      276         buf_icnt-doc.doc-date  = p-doc-date
      277         buf_icnt-doc.boss      = p-boss
      278         buf_icnt-doc.wrkr      = p-wrkr
      279         buf_icnt-doc.agnt      = p-agnt
      280         buf_icnt-doc.meas-el-cnt = p-meas-el-cnt
      281         buf_icnt-doc.state-el-cnt = p-state-el-cnt
      282         buf_icnt-doc.state-mh-cnt = p-state-mh-cnt
      283       .
      284       for each tt-icnt-line
      285       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      286       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      287       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      288       :
      289          find first buf_icnt-line where
      290                   buf_icnt-line.doc-code = buf_icnt-doc.doc-code
      291              and  buf_icnt-line.obj-type = buf_icnt-doc.obj-type
      292              and  buf_icnt-line.obj-code = buf_icnt-doc.obj-code
      293              and  buf_icnt-line.pump-code = (if tt-icnt-line.pump-code = ? then 0 else tt-icnt-line.pump-code)
      294              and  buf_icnt-line.nozzle-code = (if tt-icnt-line.nozzle-code = ? then 0 else tt-icnt-line.nozzle-code) no-error .
      295         if not available buf_icnt-line then do:
      296           create buf_icnt-line.
      297         end.
      298         buffer-copy tt-icnt-line except doc-code
      299         to buf_icnt-line
      300         assign
      301         buf_icnt-line.doc-code = buf_icnt-doc.doc-code
      302         buf_icnt-line.nozzle-code = (if tt-icnt-line.nozzle-code = ? then 0 else tt-icnt-line.nozzle-code)
      303         buf_icnt-line.pump-code = (if tt-icnt-line.pump-code = ? then 0 else tt-icnt-line.pump-code)
      304         .
      305       end.
      306       p-recid = recid(buf_icnt-doc).
      307     end.
      308     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      309       find first buf_icnt-doc  exclusive-lock where
      310                 recid(buf_icnt-doc) = p-recid .
      311       if buf_icnt-doc.doc-code <> p-doc-code
      312       or buf_icnt-doc.obj-type <> p-obj-type
      313       or buf_icnt-doc.obj-code <> p-obj-code
      314       or buf_icnt-doc.doc-date <> p-doc-date
      315       then do:
      316         assign
      317         v-mess = substitute("Для уже имеющегося документа счетчиков ТРК нельзя менять номер документа и/или&1" +
      318                             "объект и/или дату док-та"
      319                             , chr(10)).
      320         run err-mess in this-procedure ( input-output v-mess).
      321         undo main-block, return error (if p-silent = yes then v-mess else '':U).
      322       end.
      323       assign
      324         buf_icnt-doc.PS        = p-ps
      325         buf_icnt-doc.boss      = p-boss
      326         buf_icnt-doc.wrkr      = p-wrkr
      327         buf_icnt-doc.agnt      = p-agnt
      328         buf_icnt-doc.meas-el-cnt = p-meas-el-cnt
      329         buf_icnt-doc.state-el-cnt = p-state-el-cnt
      330         buf_icnt-doc.state-mh-cnt = p-state-mh-cnt
      331       .
      332       for each tt-icnt-line
      333       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      334       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      335       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      336       :
      337         find first buf_icnt-line where
      338                 buf_icnt-line.doc-code = buf_icnt-doc.doc-code
      339             and  buf_icnt-line.obj-type = buf_icnt-doc.obj-type
      340             and  buf_icnt-line.obj-code = buf_icnt-doc.obj-code
      341             and  buf_icnt-line.pump-code = tt-icnt-line.pump-code
      342             and  buf_icnt-line.nozzle-code = tt-icnt-line.nozzle-code no-error .
      343         if not available buf_icnt-line then do:
      344           assign
      345           v-mess = substitute("Для уже имеющегося документа счетчиков ТРК нельзя добавлять новые строки&1"
      346                               , chr(10)).
      347           run err-mess in this-procedure ( input-output v-mess).
      348           undo main-block, return error (if p-silent = yes then v-mess else '':U).
      349         end.
      350         buffer-copy tt-icnt-line
      351         to buf_icnt-line
      352         .
      353       end.
      354       for each buf_icnt-line
      355         where buf_icnt-line.doc-code = buf_icnt-doc.doc-code
      356       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      357       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      358       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      359       :
      360         find first tt-icnt-line
      361           where tt-icnt-line.doc-code = buf_icnt-doc.doc-code
      362             and tt-icnt-line.obj-type = buf_icnt-doc.obj-type
      363             and tt-icnt-line.obj-code = buf_icnt-doc.obj-code
      364             and tt-icnt-line.pump-code = buf_icnt-line.pump-code
      365             and tt-icnt-line.nozzle-code = buf_icnt-line.nozzle-code
      366           no-error .
      367         if not available tt-icnt-line then do:
      368           assign
      369           v-mess = substitute("Для уже имеющегося документа счетчиков ТРК нельзя удалять строки&1", chr(10)).
      370           run err-mess in this-procedure ( input-output v-mess).
      371           undo main-block, return error (if p-silent = yes then v-mess else '':U).
      372         end.
      373       end.
      374     end.
      375     release buf_icnt-doc no-error.
      376     if error-status:error then do:
      377       assign
      378       v-mess = substitute("Ошибка при сохранении записи:&1&2&1&3", chr(10), error-status:get-message(1) , return-value ).
      379       run err-mess in this-procedure ( input-output v-mess).
      380       return error (if p-silent = yes then v-mess else '':U).
      381     end.
      382     if p-ptrlcheck <> '':U then do:
      383       do v-ii = 1 to num-entries(p-ptrlcheck):
      384         find first buf_chk-doc exclusive-lock
      385           where buf_chk-doc.doc-code = entry(v-ii, p-ptrlcheck)
      386         .
      387         assign
      388           buf_chk-doc.out-2-code = p-doc-code
      389         .
      390       end.
      391     end.
      392     return '':U.
      393   end.
      394   PROCEDURE err-mess:
      395     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      396     CASE p-silent:
      397       when true then do:
      398         assign
      399           p-mess = substitute("Документ счетчиков ТРК &1 &2&3&4&5"
      400                               ,p-doc-code
      401                               ,p-obj-type
      402                               ,p-obj-code
      403                               ,chr(10)
      404                               ,p-mess)
      405         .
      406       end.
      407       when no then do:
      408         message
      409           p-mess
      410           view-as alert-box error .
      411       end.
      412     end.
      413   END PROCEDURE.
