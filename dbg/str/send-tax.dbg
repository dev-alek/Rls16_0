       83   DEFINE NEW SHARED TEMP-TABLE cash-txn no-undo
       84   FIELD tax-code like ub.tax.tax-code
       85   FIELD tax-name like ub.tax.tax-name
       86   FIELD news-action as logical
       87   index pi IS UNIQUE PRIMARY tax-code.
       88   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   define NEW SHARED temp-table cash-txr no-undo
       90     field tax-code    like ub.tax.tax-code
       91     field rate-code   like ub.tax-rate.rate-code
       92     field host-code   like ub.sysconf.host-code
       93     field obj-type    like ub.clients.obj-type
       94     field obj-code    like ub.clients.obj-code
       95     field tax-type    like ub.tax.tax-type
       96     field status_     like ub.tax-rate-value.status_
       97     field rate-value  as decimal
       98     field rc          as recid
       99     field crf         as integer
      100     field news-action as logical
      101     index pi is unique primary tax-code host-code obj-type obj-code status_ rc
      102     index crf-i  crf host-code obj-type obj-code rc
      103   .
      104   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      105     define variable v-cntxt-db-num        as integer   no-undo .
