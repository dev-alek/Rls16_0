      128       ,output v-cntxt-is-admin
      129       ) .
      130   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      132     (input  p-obj-type
      133     ,input  p-obj-code
      134     ,output v-host-code
      135     )  .
      136   CASE p-pos-type:
      137     when 'IBM':U
      138     or
      139     when 'IBM-XML':U then do:
      140       FIND FIRST ub.cash-desk NO-LOCK WHERE
      141                 ub.cash-desk.db-num = g#db-num AND
      142                 (ub.cash-desk.pos-type = 'IBM':U
      143                 or ub.cash-desk.pos-type = 'IBM-XML':U )
      144                 No-error.
      145       IF not avail(ub.cash-desk) then do:
      146           message
      147           "Передача категорий и ставок налогов" skip
      148           "реализуется только для касс фирмы IBM."
      149           view-as alert-box INFORMATION .
      150           return.
      151       end.
      152       if action = "U"
      153       then do:
      154   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      155   do:
      156     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      157       (input  v-cntxt-db-num
      158       ,input  v-cntxt-userid
      159       ,input  0
      160       ,input  'actn_cashdesk-taxn_add-def':U
      161       ,input  'object':U
      162       ,input  v-host-code
      163       ,input  p-obj-type
      164       ,input  p-obj-code
      165       ,input  0
      166       ,input  0
      167       ,input  0
      168       ,input  true
      169       ,output glog
      170       )  .
      171   end.
      172       end.
      173       else do:
      174   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      175   do:
      176     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      177       (input  v-cntxt-db-num
      178       ,input  v-cntxt-userid
      179       ,input  0
      180       ,input  'actn_cashdesk-taxn_deletion':U
      181       ,input  'object':U
      182       ,input  v-host-code
      183       ,input  p-obj-type
      184       ,input  p-obj-code
      185       ,input  0
      186       ,input  0
      187       ,input  0
      188       ,input  true
      189       ,output glog
      190       )  .
      191   end.
      192       end.
      193       if NOT glog then return .
      194     end.
      195     when 'MAGIA-XML':U then do:
      196       FIND FIRST ub.cash-desk NO-LOCK WHERE
      197                 ub.cash-desk.db-num = g#db-num AND
      198                 ub.cash-desk.pos-type = 'IBM':U No-error.
      199       IF not avail(ub.cash-desk) then do:
      200         message
      201         "Передача категорий и ставок налогово" skip
      202         "реализуется только для POS" 'MAGIA-XML':U
      203         view-as alert-box INFORMATION .
      204         return.
      205       end.
      206       if not g#news then do:
      207   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      208   do:
      209     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      210       (input  v-cntxt-db-num
      211       ,input  v-cntxt-userid
      212       ,input  0
      213       ,input  'actn_cashdesk-restaurant_work':U
      214       ,input  'object':U
      215       ,input  v-host-code
      216       ,input  p-obj-type
      217       ,input  p-obj-code
      218       ,input  0
      219       ,input  0
      220       ,input  0
      221       ,input  true
      222       ,output glog
      223       )  .
      224   end.
      225         if NOT glog then return .
      226       end.
      227     end.
      228   END CASE.
      229   for each cash-txn:
      230       delete cash-txn.
      231   end.
      232   for each cash-txr:
      233       delete cash-txr.
      234   end.
      235   run gbl/d-askw.w (input "Выбор категорий и ставок налогов для пересылки на кассу",
      236                       input ((if action = "U" then "Переслать на кассу" else "удалить с кассы") +
      237                                 " категории и ставки налогов"),
      238                       input "|",
      239                       input "Все|Выборочно|Отказ",
      240                       input "||",
      241                       input 1,
      242                       input 3,
      243                       output choice).
      244   if choice  = 3 then return.
      245   if    choice = 1
      246      or choice = 5
      247         then do:
      248       FOR EACH ub.tax NO-LOCK WHERE ub.tax.to-cashdesk = yes:
      249           create cash-txn.
      250           assign
      251           cash-txn.tax-code = tax.tax-code
      252           cash-txn.tax-name = tax.tax-name
      253           .
      254           _tax-rate:
      255           FOR EACH ub.tax-rate NO-LOCK WHERE
      256                             ub.tax-rate.tax-code = ub.tax.tax-code
      257                         and ub.tax-rate.status_  <>   'удал':U:
      258               create cash-txr.
      259               assign
      260               cash-txr.tax-code = tax.tax-code
      261               cash-txr.rate-code = tax-rate.rate-code
      262               cash-txr.tax-type = tax.tax-type
      263               cash-txr.host-code = v-host-code
      264               cash-txr.obj-type = p-obj-type
      265               cash-txr.obj-code = p-obj-code
      266               cash-txr.status_ = tax-rate.status_
      267               cash-txr.rc = ii
      268               cash-txr.crf = ii
      269               ii = ii + 1
      270               .
