      272   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
      273     (input  recid(ub.tax-rate)
      274     ,input  0
      275     ,input  0
      276     ,input  ?
      277     ,input  v-host-code
      278     ,input  p-obj-type
      279     ,input  p-obj-code
      280     ,output cash-txr.rate-value
      281     ) no-error .
      282               if error-status:error then NEXT _tax-rate.
      283           END.
      284       END.
      285   end.
      286   else if choice = 4 then do:
      287     create cash-txn.
      288     assign
      289        cash-txn.tax-code = ?.
      290   end.
      291   else do:
      292       tax-rate-rid = "".
      293       run ref/tax-tree.w (parparentproc,
      294                      "b-marktax-rate,b-seltax-rate":U,
      295                      "ALl-TAX-RATES":U,
      296                      v-host-code,
      297                      p-obj-type,
      298                      p-obj-code,
      299                      ?,
      300                      input-output tax-rate-rid) no-error .
      301       if error-status:error then return error.
      302       if tax-rate-rid = "" then do:
      303           message "Не выбрано ни одного налога для отсылки на кассу" view-as alert-box.
      304           return.
      305       end.
      306       else do:
      307               _ii:
      308       DO  ii = 1 to num-entries(tax-rate-rid) :
      309           FIND FIRST ub.tax-rate NO-LOCK WHERE recid(tax-rate) = integer(entry(ii,tax-rate-rid)) NO-ERROR.
      310           if avail ub.tax-rate then do:
      311               FIND FIRST ub.tax NO-LOCK WHERE ub.tax.tax-code = ub.tax-rate.tax-code No-ERROR.
      312               if ub.tax.to-cashdesk then do:
      313                   FIND FIRST cash-txn where cash-txn.tax-code = ub.tax.tax-code NO-ERROR.
      314                   IF NOT avail cash-txn then do:
      315                       create cash-txn.
      316                       assign
      317                       cash-txn.tax-code = ub.tax.tax-code
      318                       cash-txn.tax-name = ub.tax.tax-name
      319                       .
      320                       define variable mi as integer no-undo.
      321                        FOR EACH ub.tax-rate NO-LOCK WHERE
      322                             ub.tax-rate.tax-code = ub.tax.tax-code
      323                         and ub.tax-rate.status_  <>   'удал':U:
      324                           create cash-txr.
      325                           assign
      326                           cash-txr.tax-code = tax.tax-code
      327                           cash-txr.rate-code = tax-rate.rate-code
      328                           cash-txr.tax-type = tax.tax-type
      329                           cash-txr.host-code = v-host-code
      330                           cash-txr.obj-type = p-obj-type
      331                           cash-txr.obj-code = p-obj-code
      332                           cash-txr.status_ = tax-rate.status_
      333                           cash-txr.rc = mi
      334                           cash-txr.crf = mi
      335                           mi = mi + 1
      336                           .
      337   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      338   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
      339     (input  recid(ub.tax-rate)
      340     ,input  0
      341     ,input  0
      342     ,input  ?
      343     ,input  v-host-code
      344     ,input  p-obj-type
      345     ,input  p-obj-code
      346     ,output cash-txr.rate-value
      347     ) no-error .
      348                           if error-status:error then next _ii.
      349                       END.
      350                   end.
      351               end.
      352           end.
      353       END.
      354       FOR EACH ub.tax where ub.tax.individual = yes AND ub.tax.to-cashdesk = yes:
      355                       create cash-txn.
      356                       assign
      357                       cash-txn.tax-code = ub.tax.tax-code
      358                       cash-txn.tax-name = ub.tax.tax-name
      359                       .
      360       END.
      361       end.
      362   end.
      363   if can-find(first cash-txr NO-LOCK) OR can-find(first cash-txn) then
      364         run str/diallog.w (   ?
      365                       , this-procedure
      366                       , 'str/sendtaxn.p':U
      367                       , (string(p-obj-code) + chr(4) + action)
      368                       , if    choice = 4  or choice = 5 then yes else no
      369                       , '':U
      370                       , 'Отправка информации по налогам кассу') no-error .
      371   else do:
      372       message "Не выбрано ни одного налога, отсылаемого на кассу" view-as alert-box.
      373   end.
