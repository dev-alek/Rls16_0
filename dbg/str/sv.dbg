        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Документ сверки".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   procedure proc-alt-shift-f2:
       62     if not ibs.th.gbl.gbl-var:rcode
       63   then
       64     run gbl\inidebug.p .
       65   end.
       66   procedure proc-alt-shift-f3:
       67     run gbl/prvssinf.p
       68       ( input this-procedure
       69       ) .
       70   end.
       71   define variable v-inform-launched as logical no-undo initial false .
       72   procedure proc-alt-shift-f4:
       73     define variable v-action as character no-undo .
       74     if v-inform-launched = false then do:
       75       assign
       76         v-inform-launched = true
       77       .
       78       run gbl/d-inform.w
       79         (  input self
       80         ,  input this-procedure
       81         , output v-action
       82         ) no-error .
       83       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       84       assign
       85         v-inform-launched = false
       86       .
       87     end.
       88   end.
       89   procedure proc-alt-f1:
       90     run gbl/corrhelp.p
       91       (input this-procedure
       92       ) .
       93   end .
       94   on alt-shift-f2 anywhere do:
       95     run proc-alt-shift-f2.
       96   end.
       97   on alt-shift-f3 anywhere do:
       98     run proc-alt-shift-f3 in this-procedure .
       99   end.
      100   on alt-shift-f4 anywhere do:
      101     run proc-alt-shift-f4 in this-procedure.
      102   end.
      103   on alt-f1 anywhere do:
      104     run proc-alt-f1 in this-procedure .
      105   end.
      106   DEFINE BUTTON b-exit AUTO-GO
      107        LABEL "&Ввод"
      108        SIZE 10 BY 1
      109        BGCOLOR 8 .
      110   DEFINE BUTTON b-help
      111        LABEL "&Помощь"
      112        SIZE 10 BY 1
      113        BGCOLOR 8 .
      114   DEFINE BUTTON b-quit AUTO-END-KEY
      115        LABEL "&Отмена"
      116        SIZE 10 BY 1
      117        BGCOLOR 8 .
      118   DEFINE VARIABLE parbrutto-cli-qnty-2 AS CHARACTER FORMAT "X(256)":U
      119        LABEL "Вес жидк."
      120        VIEW-AS FILL-IN
      121        SIZE 18.88 BY 1.08 NO-UNDO.
      122   DEFINE VARIABLE parlevel-petrol AS CHARACTER FORMAT "X(256)":U
      123        LABEL "Уровень топлива"
      124        VIEW-AS FILL-IN
      125        SIZE 19 BY 1 NO-UNDO.
      126   DEFINE VARIABLE parlevel-petrol-4 AS CHARACTER FORMAT "X(256)":U
      127        LABEL "Уровень водоэмульсионной жидкости"
      128        VIEW-AS FILL-IN
      129        SIZE 19 BY 1 NO-UNDO.
      130   DEFINE VARIABLE parlevel-total AS CHARACTER FORMAT "X(256)":U
      131        LABEL "Общий уровень в танке"
      132        VIEW-AS FILL-IN
      133        SIZE 19 BY 1 NO-UNDO.
      134   DEFINE VARIABLE parlevel-water AS CHARACTER FORMAT "X(256)":U
      135        LABEL "Уровень воды"
      136        VIEW-AS FILL-IN
      137        SIZE 19 BY 1 NO-UNDO.
      138   DEFINE VARIABLE parmeasure-cli-qnty AS CHARACTER FORMAT "X(256)":U
      139        LABEL "Вес топл."
      140        VIEW-AS FILL-IN
      141        SIZE 18.88 BY 1.08 NO-UNDO.
      142   DEFINE VARIABLE parmeasure-qnty AS CHARACTER FORMAT "X(256)":U
      143        LABEL "V топлива"
      144        VIEW-AS FILL-IN
      145        SIZE 19 BY 1 NO-UNDO.
      146   DEFINE VARIABLE parsystem-cli-qnty-2 AS CHARACTER FORMAT "X(256)":U
      147        LABEL "Вес топл.(книж.)"
      148        VIEW-AS FILL-IN
      149        SIZE 18.88 BY 1.08 NO-UNDO.
      150   DEFINE VARIABLE parsystem-qnty AS CHARACTER FORMAT "X(256)":U
      151        LABEL "V топлива(книж.)"
      152        VIEW-AS FILL-IN
      153        SIZE 19.75 BY 1 NO-UNDO.
      154   DEFINE VARIABLE partemp-layer1 AS CHARACTER FORMAT "X(256)":U
      155        LABEL "T1"
      156        VIEW-AS FILL-IN
      157        SIZE 10 BY 1 NO-UNDO.
      158   DEFINE VARIABLE partemp-layer2 AS CHARACTER FORMAT "X(256)":U
      159        LABEL "T2"
      160        VIEW-AS FILL-IN
      161        SIZE 10 BY 1 NO-UNDO.
      162   DEFINE VARIABLE partemp-layer3 AS CHARACTER FORMAT "X(256)":U
      163        LABEL "T3"
      164        VIEW-AS FILL-IN
      165        SIZE 10 BY 1 NO-UNDO.
      166   DEFINE VARIABLE partemperature AS CHARACTER FORMAT "X(256)":U
      167        LABEL "T"
      168        VIEW-AS FILL-IN
      169        SIZE 10 BY 1 NO-UNDO.
      170   DEFINE VARIABLE varbrutto-qnty AS CHARACTER FORMAT "X(256)":U
      171        LABEL "V танка"
      172        VIEW-AS FILL-IN
      173        SIZE 19 BY 1 NO-UNDO.
      174   DEFINE VARIABLE vardensity AS CHARACTER FORMAT "X(256)":U
      175        LABEL "Плотность"
      176        VIEW-AS FILL-IN
      177        SIZE 19 BY 1 NO-UNDO.
      178   DEFINE RECTANGLE RECT-1
      179        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      180        SIZE 30.75 BY 6.13.
      181   DEFINE RECTANGLE RECT-2
      182        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      183        SIZE 67.13 BY 6.13.
      184   DEFINE FRAME Dialog-Frame
      185        b-exit AT ROW 1 COL 1
      186        b-quit AT ROW 1 COL 11
      187        b-help AT ROW 1 COL 21
      188        varbrutto-qnty AT ROW 2.88 COL 9.5 COLON-ALIGNED
      189        parmeasure-qnty AT ROW 2.92 COL 31.38
      190        parsystem-qnty AT ROW 2.96 COL 78.13 COLON-ALIGNED
      191        vardensity AT ROW 4.33 COL 40.5 COLON-ALIGNED
      192        parbrutto-cli-qnty-2 AT ROW 5.54 COL 10 COLON-ALIGNED
      193        parmeasure-cli-qnty AT ROW 5.67 COL 40.38 COLON-ALIGNED
      194        parsystem-cli-qnty-2 AT ROW 5.75 COL 78.88 COLON-ALIGNED
      195        partemp-layer1 AT ROW 7.67 COL 16.63
      196        parlevel-petrol AT ROW 7.71 COL 71.13 COLON-ALIGNED
      197        parlevel-total AT ROW 9.25 COL 71 COLON-ALIGNED
      198        partemperature AT ROW 9.58 COL 3.13
      199        partemp-layer2 AT ROW 9.58 COL 16.63
      200        parlevel-water AT ROW 10.67 COL 70.88 COLON-ALIGNED
      201        partemp-layer3 AT ROW 11.63 COL 16.88
      202        parlevel-petrol-4 AT ROW 12.08 COL 70.88 COLON-ALIGNED
      203        RECT-1 AT ROW 7.17 COL 1.5
      204        RECT-2 AT ROW 7.21 COL 32.63
      205        SPACE(0.36) SKIP(0.32)
      206       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      207            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      208            TITLE "Документ сверки".
      209   ASSIGN
      210          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      211          FRAME Dialog-Frame:HIDDEN           = TRUE.
      212   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      213   DO:
      214     APPLY "END-ERROR":U TO SELF.
      215   END.
      216   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      217   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      218   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      219   on help of frame Dialog-Frame
      220   do:
      221     run gbl/app_help.p
      222       (input this-procedure :file-name
      223       ,input ''
      224       ,input ?
      225       ) no-error.
      226     if error-status :error then do:
      227       message
      228         "Ошибка при вызове помощи"
      229         error-status :get-message(1)
      230         view-as alert-box .
      231     end.
      232   end.
      233   run minbtn-set in this-procedure .
      234   on choose of b-help in frame Dialog-Frame
      235   do:
      236     apply "help":u to frame Dialog-Frame .
      237   end.
      238   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      239   procedure minbtn-set :
      240       do
      241           on error undo, return error return-value
      242           :
      243           define variable ii              as integer       no-undo .
      244           define variable fh              as widget-handle no-undo .
      245           define variable hh              as widget-handle no-undo .
      246           define variable v-h             as handle        extent 4 no-undo .
      247           define variable v-name-button   as character     no-undo .
      248           define variable v-help-old-x    as decimal       no-undo .
      249           define variable v-help-old-y    as decimal       no-undo .
      250           define variable v-help-old-size as decimal       no-undo .
      251           define variable v-frame-width   as decimal       no-undo .
      252           define variable jj              as integer       no-undo .
      253           do
      254               on error undo, return error
      255               :
      256               assign
      257                   v-frame-width = frame Dialog-Frame:width - 0.3
      258                   fh            = frame Dialog-Frame:first-child
      259                   hh            = fh:first-child
      260                   ii            = 1
      261                   .
      262               do while valid-handle(hh):
      263                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      264                   do:
      265                       case lc(hh:name) :
      266                           when "b-help" then
      267                               do:
      268                                   hh:load-image-up("cmp/b-help.bmp":u) .
      269                                   hh:load-image-down("cmp/b-help.bmp":u) .
      270                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      271                                   hh:TOOLTIP = "Помощь" .
      272                                   v-help-old-x = hh:column .
      273                                   v-help-old-y = hh:row    .
      274                                   v-help-old-size = hh:width .
      275                                   hh:width-chars = 2.5 .
      276                               end.
      277                           when "b-print" then
      278                               do:
      279                                   hh:load-image("cmp/b-print.bmp":u) .
      280                                   hh:TOOLTIP = "Печать" .
      281                                   v-h[ii] = hh:handle .
      282                                   ii = ii + 1 .
      283                                   hh:width-chars = 3 .
      284                               end.
      285                           when "b-history" or
      286                           when "b-hist" then
      287                               do:
      288                                   hh:load-image("cmp/b-hist.bmp":u) .
      289                                   hh:TOOLTIP = "История" .
      290                                   v-h[ii] = hh:handle .
      291                                   ii = ii + 1 .
      292                                   hh:width-chars = 3 .
      293                               end.
      294                           when "b-sch" then
      295                               do:
      296                                   hh:load-image("cmp/b-sch.bmp":u) .
      297                                   hh:TOOLTIP = "Установка Фильтра" .
      298                                   v-h[ii] = hh:handle .
      299                                   ii = ii + 1 .
      300                                   hh:width-chars = 3 .
      301                               end.
      302                           when "b-hist-user" then
      303                               do:
      304                                   hh:load-image("cmp/b-hist.bmp":u) .
      305                                   hh:TOOLTIP = "История пользователя" .
      306                                   ii = ii + 1 .
      307                               end.
      308                       end case.
      309                   end.
      310                   hh = hh:next-sibling.
      311               end.
      312               b-help:column = v-frame-width - b-help:width-chars.
      313               jj = 0.
      314               repeat ii = 4 to 1 by -1 :
      315                   if valid-handle (v-h[ii] ) then
      316                   do:
      317                       jj  = jj + 1 .
      318                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      319                       v-h[ii]:row    = v-help-old-y .
      320                   end.
      321               end.
      322           end.
      323       end.
      324   end procedure.
      325   MAIN-BLOCK:
      326   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      327      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      328     RUN enable_UI.
      329     WAIT-FOR GO OF FRAME Dialog-Frame.
      330   END.
      331   RUN disable_UI.
      332   PROCEDURE disable_UI :
      333     HIDE FRAME Dialog-Frame.
      334   END PROCEDURE.
      335   PROCEDURE enable_UI :
      336     DISPLAY varbrutto-qnty parmeasure-qnty parsystem-qnty vardensity
      337             parbrutto-cli-qnty-2 parmeasure-cli-qnty parsystem-cli-qnty-2
      338             partemp-layer1 parlevel-petrol parlevel-total partemperature
      339             partemp-layer2 parlevel-water partemp-layer3 parlevel-petrol-4
      340         WITH FRAME Dialog-Frame.
      341     ENABLE b-exit b-quit b-help RECT-1 RECT-2 partemp-layer1 partemperature
      342            partemp-layer2 partemp-layer3
      343         WITH FRAME Dialog-Frame.
      344     VIEW FRAME Dialog-Frame.
      345   END PROCEDURE.
