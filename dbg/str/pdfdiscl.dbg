        1   block-level on error undo, throw.
        2   define input  parameter parParentProc as handle no-undo .
        3   define input  parameter p-doc-code    as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: pdfdiscl.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: str/pdfdiscl.p $":U .
        9   define variable vss-description as character no-undo init "Закрытие связных ДНЦ по атрибутам переоценки".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define buffer buf_price-doc         for ub.price-doc  .
       69   define buffer buf_price-doc-forming for ub.price-doc-forming  .
       70   define buffer buf_price-doc-attr    for ub.doc-attr  .
       71   define variable v-notall-relation as logical   no-undo .
       72   define variable v-exis            as logical   no-undo .
       73   define variable v-str-err as character no-undo .
       74   define variable v-1 as character no-undo .
       75   define variable v-str as character no-undo .
       76   define variable ii1 as integer   no-undo .
       77   define variable ii2 as integer   no-undo .
       78   define variable ii3 as integer   no-undo .
       79   define variable ii4 as integer   no-undo .
       80     do
       81     on error undo, return error return-value
       82     :
       83   find first buf_price-doc no-lock where
       84              buf_price-doc.doc-num = p-doc-code no-error .
       85       if error-status :error then do:
       86           message
       87             vss-workfile vss-revision vss-description skip
       88             error-status :get-message(1) skip
       89             return-value skip
       90             ""
       91             view-as alert-box error
       92           .
       93           return error return-value .
       94       end.
       95     v-exis  = false .
       96     for each buf_price-doc-attr no-lock where
       97              buf_price-doc-attr.attr-code begins 'relprpdf':U + chr(4) and
       98              buf_price-doc-attr.doc-code  = p-doc-code :
       99              v-exis  = true  .
      100     end.
      101     if v-exis  = false then return .
      102     v-notall-relation = false .
      103     v-str-err = "" .
      104     for each buf_price-doc-attr no-lock where
      105              buf_price-doc-attr.attr-code begins 'relprpdf':U + chr(4) and
      106              buf_price-doc-attr.doc-code  = p-doc-code :
      107              assign
      108                 ii1 =  int(entry(1,buf_price-doc-attr.attr-value))
      109                 ii2 =  int(entry(2,buf_price-doc-attr.attr-value))
      110                 ii3 =  int(entry(3,buf_price-doc-attr.attr-value))
      111                 ii4 =  int(entry(4,buf_price-doc-attr.attr-value))
      112               no-error .
      113               if error-status :error then do:
      114                 message "Неверно заведен атрибут переоценки" view-as alert-box error .
      115                 return error "Неверно заведен атрибут переоценки"  .
      116               end.
      117         find first buf_price-doc-forming no-lock  where
      118                    buf_price-doc-forming.plt-id     = int(entry(1,buf_price-doc-attr.attr-value)) and
      119                    buf_price-doc-forming.plt-db-num = int(entry(2,buf_price-doc-attr.attr-value)) and
      120                    buf_price-doc-forming.pdf-id     = int(entry(3,buf_price-doc-attr.attr-value)) and
      121                    buf_price-doc-forming.pdf-db     = int(entry(4,buf_price-doc-attr.attr-value)) no-error .
      122            if not available buf_price-doc-forming then do:
      123               v-notall-relation = true  .
      124               v-str-err = v-str-err  +  substitute(" &1(&2),",
      125                 entry(3,buf_price-doc-attr.attr-value) ,
      126                 entry(4,buf_price-doc-attr.attr-value)).
      127            end.
      128     end.
      129     if v-notall-relation = true  then do:
      130       v-str = substitute("Не все скидочные ДНЦ доступны для обработки, нет: &1 " , v-str-err )  .
      131       message v-str  view-as alert-box information .
      132       return error v-str .
      133     end.
      134     for each buf_price-doc-attr no-lock where
      135              buf_price-doc-attr.attr-code begins 'relprpdf':U + chr(4) and
      136              buf_price-doc-attr.doc-code  = p-doc-code ,
      137         first buf_price-doc-forming no-lock  where
      138               buf_price-doc-forming.plt-id     = int(entry(1,buf_price-doc-attr.attr-value)) and
      139               buf_price-doc-forming.plt-db-num = int(entry(2,buf_price-doc-attr.attr-value)) and
      140               buf_price-doc-forming.pdf-id     = int(entry(3,buf_price-doc-attr.attr-value)) and
      141               buf_price-doc-forming.pdf-db     = int(entry(4,buf_price-doc-attr.attr-value))
      142               :
      143                 run str/diallog.w
      144                   ( parparentproc
      145                   , this-procedure
      146                   , 'str/pdf-clos.p':U
      147                   , ( string(recid(buf_price-doc-forming)) + chr(4) +
      148                     'no' + chr(4) +
      149                     'no' + chr(4) +
      150                     '?'  + chr(4) +
      151                     '?'  + chr(4) +
      152                     string('факт':U) + chr(4) +
      153                     '?'  + chr(4) +
      154                     'yes'  )
      155                   , yes
      156                   , '':U
      157                   , 'Закрытие порожденных ДНЦ') no-error .
      158                   if error-status :error then do:
      159                      v-str = substitute("_Закрытие порожденных ДНЦ ошибка &1 &2" , return-value ,  error-status :get-message(1) ) .
      160                      return error v-str .
      161                   end.
      162       end.
      163    end.
