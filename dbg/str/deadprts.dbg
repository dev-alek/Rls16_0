     1877           and bf_parts.obj-code  = bf_doc-line.obj-code
     1878           and bf_parts.artic     = bf_doc-line.artic
     1879           and bf_parts.prod-type = bf_doc-line.prod-type
     1880           and bf_parts.prod-code = bf_doc-line.prod-code
     1881       on error undo, return error return-value
