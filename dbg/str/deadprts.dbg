      646   end.
      647   else do:
      648     for each out-vatp_partscl where out-vatp_partscl.out-code   = pardoc-code
      649                                  and out-vatp_partscl.obj-type   = parobj-type
      650                                  and out-vatp_partscl.obj-code   = parobj-code
      651                                  and out-vatp_partscl.artic      = parartic
      652                                  and out-vatp_partscl.prod-type  = parprod-type
      653                                  and out-vatp_partscl.prod-code  = parprod-code no-lock :
      654       if out-vatp_partscl.purch-code = 2 then do:
      655   assign
      656     price-rubl-with-tax-lococl = out-vatp_partscl.price-rubl
      657     price-base-with-tax-lococl = out-vatp_partscl.price-base
      658   .
      659   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      660   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      661     (output varinvprbocl
      662     )  .
      663     if out-vatp_partscl.out-code = 'free-zone':U     or
      664        out-vatp_partscl.out-code = 'out-zone':U   or
      665        out-vatp_partscl.doc-type = 'акт':U then do:
      666       assign
      667         in-vatp-have-vat-sltocl = yes.
      668     end.
      669     else do:
      670       find first in-vatp_doc-attrocl no-lock
      671         where in-vatp_doc-attrocl.doc-code  = out-vatp_partscl.out-code
      672           and in-vatp_doc-attrocl.attr-code = 'envd':U
      673         no-error .
      674       if not available in-vatp_doc-attrocl then do:
      675         assign
      676           in-vatp-have-vat-sltocl = yes.
      677       end.
      678       else do:
      679            in-vatp-have-vat-sltocl = no.
      680       end.
      681     end.
      682     assign
      683      price-cli-with-tax-lococl = out-vatp_partscl.price-cli
      684      cli-base-rateocl          = out-vatp_partscl.cli-base-rate.
      685     ASSIGN   road-tax-base-lococl  = (if out-vatp_partscl.road-tax-base  = ? then 0 else out-vatp_partscl.road-tax-base)
      686              road-tax-rubl-lococl  = (if out-vatp_partscl.road-tax-rubl  = ? then 0 else out-vatp_partscl.road-tax-rubl).
      687     ASSIGN  transport-base-lococl = (if out-vatp_partscl.transport-base = ? then 0 else out-vatp_partscl.transport-base)
      688             transport-rubl-lococl = (if out-vatp_partscl.transport-rubl = ? then 0 else out-vatp_partscl.transport-rubl)
      689             other-base-lococl     = (if out-vatp_partscl.other-base     = ? then 0 else out-vatp_partscl.other-base)
      690             other-rubl-lococl     = (if out-vatp_partscl.other-rubl     = ? then 0 else out-vatp_partscl.other-rubl)
      691             vat-pc-lococl         = (if out-vatp_partscl.vat-pc         = ? then 0 else out-vatp_partscl.vat-pc)
      692             slt-pc-lococl         = (if out-vatp_partscl.slt-pc         = ? then 0 else out-vatp_partscl.slt-pc).
      693             ASSIGN   slt-base-lococl    = (if in-vatp-have-vat-sltocl = no then 0 else (price-base-with-tax-lococl - ((if road-tax-base-lococl  = ? then 0 else road-tax-base-lococl) + (if transport-base-lococl = ? then 0 else transport-base-lococl) + (if other-base-lococl = ? then 0 else other-base-lococl)))                           * slt-pc-lococl / (100 + slt-pc-lococl))                        vat-base-lococl    = (if in-vatp-have-vat-sltocl = no then 0 else (price-base-with-tax-lococl - ((if road-tax-base-lococl  = ? then 0 else road-tax-base-lococl) + (if transport-base-lococl = ? then 0 else transport-base-lococl) + (if other-base-lococl = ? then 0 else other-base-lococl))) * (1 - slt-pc-lococl / (100 + slt-pc-lococl)) * vat-pc-lococl / (100 + vat-pc-lococl)).
      694       ASSIGN   slt-rubl-lococl    = (if in-vatp-have-vat-sltocl = no then 0 else (price-rubl-with-tax-lococl - ((if road-tax-rubl-lococl  = ? then 0 else road-tax-rubl-lococl) + (if transport-rubl-lococl = ? then 0 else transport-rubl-lococl) + (if other-rubl-lococl = ? then 0 else other-rubl-lococl)))                           * slt-pc-lococl / (100 + slt-pc-lococl))                        vat-rubl-lococl    = (if in-vatp-have-vat-sltocl = no then 0 else (price-rubl-with-tax-lococl - ((if road-tax-rubl-lococl  = ? then 0 else road-tax-rubl-lococl) + (if transport-rubl-lococl = ? then 0 else transport-rubl-lococl) + (if other-rubl-lococl = ? then 0 else other-rubl-lococl))) * (1 - slt-pc-lococl / (100 + slt-pc-lococl)) * vat-pc-lococl / (100 + vat-pc-lococl)).
      695     assign
      696       exch-rate-cli-lococl = (out-vatp_partscl.price-rubl - transport-rubl-lococl - other-rubl-lococl - road-tax-rubl-lococl - (if out-vatp_partscl.vat-type <> 'в т. ч.':U then vat-rubl-lococl else 0) - (if out-vatp_partscl.slt-type <> 'в т. ч.':U then slt-rubl-lococl else 0)) / out-vatp_partscl.price-cli .
      697     assign
      698       slt-cli-lococl        = slt-rubl-lococl       / exch-rate-cli-lococl
      699       vat-cli-lococl        = vat-rubl-lococl       / exch-rate-cli-lococl
      700       road-tax-cli-lococl   = road-tax-rubl-lococl  / exch-rate-cli-lococl
      701       transport-cli-lococl  = 0
      702       other-cli-lococl      = 0
      703     .
      704   ASSIGN
