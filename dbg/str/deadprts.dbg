     1809   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1810   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1811     (input  bf_trn-doc.obj-type
     1812     ,input  bf_trn-doc.obj-code
     1813     ,input  varb-code
     1814     ,input  0
     1815     ,input  bf_trn-doc.fact-order
     1816     ,output vardoc-num
     1817     ,output varprice-sale
     1818     ,output varroad-tax
     1819     ,output varexcise
     1820     )  .
     1821             if varprice-sale = ?
     1822             then do:
     1823               assign
     1824                 varprice-sale = 0
     1825                 varroad-tax   = 0
     1826                 varexcise     = 0
     1827               .
     1828             end.
     1829             assign
     1830               varlastcur-base     = varprice-sale
     1831               varlastcur-road-tax = varroad-tax
     1832               varlastcur-excise   = varexcise
     1833               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     1834               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     1835               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     1836               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     1837             .
     1838         end.
     1839       end.
     1840       if varcur-fact-qnty = 0 then do:
     1841         assign
     1842           varcur-base      = varlastcur-base
     1843           varcur-road-tax  = varlastcur-road-tax
     1844           varcur-excise    = varlastcur-excise
     1845         .
     1846       end.
     1847       else do:
     1848         assign
     1849           varcur-base      = varcur-base      / varcur-fact-qnty
     1850           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     1851           varcur-excise    = varcur-excise    / varcur-fact-qnty
     1852         .
     1853       end.
     1854       if varcur-vat-pc = ?
     1855       then do:
     1856         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     1857       end.
     1858       if varcur-slt-pc = ?
     1859       then do:
     1860         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     1861       end.
     1862       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     1863       assign
