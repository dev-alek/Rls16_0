      482   do on error undo, return error return-value :
      483   find first cl_tt-clcparts where recid(cl_tt-clcparts) = parrec-parts no-lock.
      484   for each bf_tt-allsum on error undo, return error return-value :
      485     delete bf_tt-allsum.
      486   end.
      487   assign
      488     price-rubl-with-tax-loccl = cl_tt-clcparts.price-rubl
      489     price-base-with-tax-loccl = cl_tt-clcparts.price-base
      490   .
      491   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      492   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      493     (output varinvprbcl
      494     )  .
      495     if cl_tt-clcparts.out-code = 'free-zone':U     or
      496        cl_tt-clcparts.out-code = 'out-zone':U   or
      497        cl_tt-clcparts.doc-type = 'акт':U then do:
      498       assign
      499         in-vatp-have-vat-sltcl = yes.
      500     end.
      501     else do:
      502       find first in-vatp_doc-attrcl no-lock
      503         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
      504           and in-vatp_doc-attrcl.attr-code = 'envd':U
      505         no-error .
      506       if not available in-vatp_doc-attrcl then do:
      507         assign
      508           in-vatp-have-vat-sltcl = yes.
      509       end.
      510       else do:
      511            in-vatp-have-vat-sltcl = no.
      512       end.
      513     end.
      514     assign
      515      price-cli-with-tax-loccl = cl_tt-clcparts.price-cli
      516      cli-base-ratecl          = cl_tt-clcparts.cli-base-rate.
      517     ASSIGN   road-tax-base-loccl  = (if cl_tt-clcparts.road-tax-base  = ? then 0 else cl_tt-clcparts.road-tax-base)
      518              road-tax-rubl-loccl  = (if cl_tt-clcparts.road-tax-rubl  = ? then 0 else cl_tt-clcparts.road-tax-rubl).
      519     ASSIGN  transport-base-loccl = (if cl_tt-clcparts.transport-base = ? then 0 else cl_tt-clcparts.transport-base)
      520             transport-rubl-loccl = (if cl_tt-clcparts.transport-rubl = ? then 0 else cl_tt-clcparts.transport-rubl)
      521             other-base-loccl     = (if cl_tt-clcparts.other-base     = ? then 0 else cl_tt-clcparts.other-base)
      522             other-rubl-loccl     = (if cl_tt-clcparts.other-rubl     = ? then 0 else cl_tt-clcparts.other-rubl)
      523             vat-pc-loccl         = (if cl_tt-clcparts.vat-pc         = ? then 0 else cl_tt-clcparts.vat-pc)
      524             slt-pc-loccl         = (if cl_tt-clcparts.slt-pc         = ? then 0 else cl_tt-clcparts.slt-pc).
      525             ASSIGN   slt-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
      526       ASSIGN   slt-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
      527     assign
      528       exch-rate-cli-loccl = (cl_tt-clcparts.price-rubl - transport-rubl-loccl - other-rubl-loccl - road-tax-rubl-loccl - (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-rubl-loccl else 0) - (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-rubl-loccl else 0)) / cl_tt-clcparts.price-cli .
      529     assign
      530       slt-cli-loccl        = slt-rubl-loccl       / exch-rate-cli-loccl
      531       vat-cli-loccl        = vat-rubl-loccl       / exch-rate-cli-loccl
      532       road-tax-cli-loccl   = road-tax-rubl-loccl  / exch-rate-cli-loccl
      533       transport-cli-loccl  = 0
      534       other-cli-loccl      = 0
      535     .
      536   ASSIGN
      537             price-base-without-tax-loccl = price-base-with-tax-loccl - vat-base-loccl - slt-base-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))
      538       price-rubl-without-tax-loccl = price-rubl-with-tax-loccl - vat-rubl-loccl - slt-rubl-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))
      539   .
      540   if paris-doc then do:
      541     assign
      542       parartic     = cl_tt-clcparts.artic
      543       parprod-type = cl_tt-clcparts.prod-type
      544       parprod-code = cl_tt-clcparts.prod-code
      545       pardoc-type  = cl_tt-clcparts.doc-type
      546       pardoc-code  = cl_tt-clcparts.out-code
      547       parobj-type  = cl_tt-clcparts.obj-type
      548       parobj-code  = cl_tt-clcparts.obj-code.
      549   if parext-doc-type = 'ot':U or
      550      parext-doc-type = ?                 then do:
      551     assign
      552      out-vatp-have-vat-sltcl = yes.
      553   end.
      554   else do:
      555     find first out-vatp_doc-attrcl no-lock
      556       where out-vatp_doc-attrcl.doc-code  = pardoc-code
      557         and out-vatp_doc-attrcl.attr-code = 'envd':U
      558         no-error .
      559     if not available out-vatp_doc-attrcl then do:
      560       assign
      561         out-vatp-have-vat-sltcl = yes.
      562     end.
      563     else do:
      564        out-vatp-have-vat-sltcl = no.
      565     end.
      566   end.
      567   find first out-vatp_goodscl where out-vatp_goodscl.artic     = parartic     and
      568                                      out-vatp_goodscl.prod-type = parprod-type and
      569                                      out-vatp_goodscl.prod-code = parprod-code no-lock.
      570   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      571   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
      572     (input  parartic
      573     ,input  parprod-type
      574     ,input  parprod-code
      575     ,output varroot-nodecl
      576     ) no-error .
      577   if error-status :error then do:
      578     message
      579       vss-workfile vss-revision vss-description skip
      580       "Ошибка при определении корневого признака товара" skip
      581       "Артикул" parartic parprod-type parprod-code skip
      582       error-status :get-message(1) skip
      583       return-value skip
      584       view-as alert-box error .
      585     undo, return error .
      586   end.
      587   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
      588     (input  varroot-nodecl
      589     ,input  'empty-scale=request'
      590     ,output varempty-scalecl
      591     ) no-error .
      592   if error-status :error then do:
      593     message
      594       vss-workfile vss-revision vss-description skip
      595       "Ошибка при определении атрибута признака" skip
      596       "Артикул" parartic parprod-type parprod-code skip
      597       "Признак" varroot-nodecl skip
      598       "Запрашивался атрибут" "empty-scale=request" skip
      599       error-status :get-message(1) skip
      600       return-value skip
      601       view-as alert-box error .
      602     undo, return error .
      603   end.
      604   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      605   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      606     (output varoutvprbcl
      607     )  .
      608   if varoutvprbcl = "base":u then do:
      609     assign
      610           road-tax-base-salecl    =  (if parroad-tax = ? then 0 else parroad-tax * 1)
      611       excise-base-salecl      =  (if parexcise   = ? then 0 else parexcise   * 1)
      612     .
      613   end.
      614   else do:
      615     assign
      616           road-tax-base-salecl    =  (if parroad-tax = ? then 0 else parroad-tax / parbase-rate * parbase-scale)
      617       excise-base-salecl      =  (if parexcise   = ? then 0 else parexcise   / parbase-rate * parbase-scale)
      618     .
      619   end.
      620   if varoutvprbcl = "rubl":u then do:
      621     assign
      622           road-tax-rubl-salecl    = (if parroad-tax = ? then 0 else parroad-tax * 1)
      623       excise-rubl-salecl      = (if parexcise   = ? then 0 else parexcise   * 1) .
      624   end.
      625   else do:
      626     assign
      627           road-tax-rubl-salecl    = (if parroad-tax = ? then 0 else parroad-tax * parbase-rate / parbase-scale)
      628       excise-rubl-salecl      = (if parexcise   = ? then 0 else parexcise   * parbase-rate / parbase-scale) .
      629   end.
      630   assign
      631     varis-cons-parts-havecl =  no.
      632   assign
      633     varfact-qntycl       = 0
      634     varcons-qntycl       = 0
      635     varprice-base-conscl = 0
      636     varprice-rubl-conscl = 0.
      637   find first out-vatp_doc-linecl where
      638              out-vatp_doc-linecl.doc-code   = pardoc-code
      639          and out-vatp_doc-linecl.artic      = parartic
      640          and out-vatp_doc-linecl.prod-type  = parprod-type
      641          and out-vatp_doc-linecl.prod-code  = parprod-code no-lock no-error.
      642   if available out-vatp_doc-linecl           and
      643     (out-vatp_doc-linecl.status_ = 'запрос':U or out-vatp_goodscl.gds-type = 'у':U) then do:
      644     assign
