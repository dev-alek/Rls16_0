     2096   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2097   procedure doc-code:
     2098   define input  parameter parmode          as   character           no-undo.
     2099   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
     2100   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
     2101   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
     2102   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
     2103   define buffer buf_sys-ctrl for ub.sys-ctrl  .
     2104   define variable vardb-remote     as   logical             no-undo.
     2105   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
     2106   define variable v-delimiter as character no-undo .
     2107   do
     2108   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2109   :
     2110   find first buf_sys-ctrl no-lock .
     2111   vardb-remote = buf_sys-ctrl.db-num <> 0 .
     2112     CASE parmode:
     2113       when "main":u then do:
     2114         if vardb-remote then do:
     2115           assign
     2116             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
     2117         end.
     2118         else do:
     2119           assign
     2120             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
     2121         end.
     2122       end.
     2123       when "trio" then do:
     2124         assign
     2125           pardoc-code = replace (parroot-doc-code, "=", "*").
     2126       end.
     2127       otherwise do:
     2128         assign
     2129         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
     2130         no-error
     2131         .
     2132         if error-status:error  then do:
     2133           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     2134                                         ,chr(10)
     2135                                         ,parmode
     2136                                         ).
     2137         end.
     2138         if num-entries(parmode) = 1
     2139         and parmode <> "chip":U
     2140         and parmode <> "chip_s":U
     2141         then do:
     2142           assign
     2143           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     2144         end.
     2145         else if (lookup("chip":U, parmode) > 0
     2146                  or
     2147                  lookup("chip_s":U, parmode) > 0) then do:
     2148           assign
     2149             vartemp-doc-code = parroot-doc-code.
     2150           do while true:
     2151             if index (vartemp-doc-code , ".") = 0 then
     2152               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     2153             else
     2154               vartemp-doc-code  =
     2155               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     2156               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     2157               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     2158             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     2159           end.
     2160           assign
     2161             pardoc-code = vartemp-doc-code.
     2162         end.
     2163       end.
     2164     end CASE.
     2165     if pardoc-code = '':U
     2166     or (parroot-doc-code <> '':U
     2167     and pardoc-code = parroot-doc-code) then do:
     2168       undo, return error substitute("Ошибка при генерации номера документа&1"
     2169                                     ,chr(10)).
     2170     end.
     2171   end.
     2172   end. // procedure/method
     2173   function get-doc-code-int64 returns int64
     2174     ( input p-doc-code as character ) :
     2175     define variable v-ind              as integer   no-undo .
     2176     define variable v-num-entries      as integer   no-undo .
     2177     define variable v-doc-code-int64   as int64     no-undo .
     2178     define variable v-canonic-doc-code as character no-undo .
     2179     assign
     2180       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     2181       v-canonic-doc-code = p-doc-code
     2182     .
     2183     do v-ind = 1 to v-num-entries
     2184     :
     2185       assign
     2186         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     2187       .
     2188     end.
     2189     assign
     2190       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     2191     .
     2192     return v-doc-code-int64 .
     2193   end. // function/method
     2194   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2195   function octal-to-char return character
     2196   ( p-string as character ) :
     2197     def var v-asc     as integer no-undo .
     2198     def var v-new-asc as integer no-undo .
     2199     def var ind       as integer no-undo .
     2200     if length(p-string) <> 3 then do:
     2201       return ? .
     2202     end.
     2203     assign
     2204       v-asc = 0
     2205     .
     2206     do ind = 1 to length(p-string)
     2207     :
     2208       assign
     2209         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
     2210       .
     2211       if v-new-asc < 0 or v-new-asc >= 8 then do:
     2212         return ? .
     2213       end.
     2214       assign
     2215         v-asc = v-asc * 8 + v-new-asc
     2216       .
     2217     end.
     2218     return chr(v-asc) .
     2219   end function .
     2220   function char-to-octal return character
     2221   ( p-chr as character ) :
     2222     def var v-asc    as integer   no-undo .
     2223     def var ind      as integer   no-undo .
     2224     def var v-string as character no-undo .
     2225     if length(p-chr) <> 1 then do:
     2226       return ? .
     2227     end.
     2228     assign
     2229       v-asc    = asc(p-chr)
     2230       v-string = ""
     2231     .
     2232     do ind = 1 to 3
     2233     :
     2234       assign
     2235         v-string = chr( v-asc mod 8 + asc('0')) + v-string
     2236       .
     2237       assign
     2238         v-asc = truncate(v-asc / 8, 0)
     2239       .
     2240     end.
     2241     return v-string .
     2242   end.
     2243   function str-encode return character
     2244   (   p-init-string       as character
     2245     , p-encode-char       as character
     2246     , p-special-char-list as character
     2247   ) :
     2248     def var p-encode-string as character no-undo .
     2249     def var ind                as integer no-undo .
     2250     def var v-num-special-char as integer no-undo .
     2251     def var v-special-char     as character no-undo .
     2252     if p-encode-char = ?
     2253     or p-encode-char = "" then do:
     2254       assign
     2255         p-encode-char = "~~"
     2256       .
     2257     end.
     2258     if p-init-string = ? then do:
     2259       return "?" .
     2260     end.
     2261     if p-init-string = "?" then do:
     2262       return p-encode-char + char-to-octal("?") .
     2263     end.
     2264     assign
     2265       v-num-special-char = length(p-special-char-list)
     2266       p-encode-string    = replace(p-init-string
     2267                                   ,p-encode-char
     2268                                   ,p-encode-char + char-to-octal(p-encode-char)
     2269                                   )
     2270     .
     2271     do ind = 1 to v-num-special-char
     2272     :
     2273       assign
     2274         v-special-char = substring(p-special-char-list, ind, 1)
     2275       .
     2276       if v-special-char <> p-encode-char then do:
     2277         assign
     2278           p-encode-string = replace (p-encode-string
     2279                                     ,v-special-char
     2280                                     ,p-encode-char + char-to-octal(v-special-char)
     2281                                     )
     2282         .
     2283       end.
     2284     end.
     2285     return p-encode-string .
     2286   end.
     2287   function str-decode returns character
     2288     (p-init-string   as character
     2289     ,p-encode-char   as character
     2290     ) :
     2291     def var p-decode-string as character no-undo .
     2292     def var ind                       as integer no-undo .
     2293     def var v-num-entries-init-string as integer no-undo .
     2294     def var v-sub-phrase              as character no-undo .
     2295     def var v-special-char            as character no-undo .
     2296     if p-encode-char = ?
     2297     or p-encode-char = "" then do:
     2298       assign
     2299         p-encode-char = "~~"
     2300       .
     2301     end.
     2302     if p-init-string = "?" then do:
     2303       return ? .
     2304     end.
     2305     assign
     2306       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
     2307     .
     2308     if v-num-entries-init-string > 1 then do:
     2309       assign
     2310         p-decode-string = entry(1, p-init-string, p-encode-char)
     2311       .
     2312       do ind = 2 to v-num-entries-init-string
     2313       :
     2314         assign
     2315           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
     2316         .
     2317         assign
     2318           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
     2319         .
     2320         if v-special-char <> ? then do:
     2321           assign
     2322             p-decode-string = p-decode-string
     2323                             + v-special-char
     2324                             + substring(v-sub-phrase, 4)
     2325           .
     2326         end.
     2327         else do:
     2328           assign
     2329             p-decode-string = p-decode-string
     2330                             + p-encode-char
     2331                             + v-sub-phrase
     2332           .
     2333         end.
     2334       end.
     2335     end.
     2336     else do:
     2337       assign
     2338         p-decode-string = p-init-string
     2339       .
     2340     end.
     2341     return p-decode-string .
     2342   end.
