     1950   procedure clcprtsl_calc-ttable :
     1951   define input parameter paris-doc           as   logical                 no-undo.
     1952   define input parameter paris-cur           as   logical                 no-undo.
     1953   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     1954   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     1955   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     1956   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     1957   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     1958   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     1959   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     1960   define input parameter parr-b              as   character               no-undo.
     1961   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     1962   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     1963   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     1964   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     1965   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     1966   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     1967   define buffer bf_tt-allsum      for tt-allsum.
     1968   define buffer bf_tt-clcparts    for tt-clcparts.
     1969   define buffer bf_tt-allsum-line for tt-allsum-line.
     1970   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     1971   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     1972   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     1973   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     1974   define variable varexcise          like ub.price-list.excise     no-undo.
     1975   do on error undo, return error return-value :
     1976   for each bf_tt-allsum-line
     1977   on error undo, return error return-value
     1978    :
     1979     delete bf_tt-allsum-line.
     1980   end.
     1981   for each bf_tt-allsum
     1982   on error undo, return error return-value
     1983   :
     1984     delete bf_tt-allsum.
     1985   end.
     1986   for each bf_tt-clcparts
     1987   on error undo, return error return-value
     1988   :
     1989   if v-calcbypart then do:
     1990             assign
     1991             parcur-base =   bf_tt-clcparts.part-cur-base
     1992             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     1993             parcur-excise =   bf_tt-clcparts.part-cur-excise
     1994             .
     1995   end.
     1996      run clcprtsl_calc-parts in this-procedure (
     1997        input recid(bf_tt-clcparts),
     1998        input paris-doc,
     1999        input paris-cur,
     2000        input parroad-tax,
     2001        input parexcise,
     2002        input parvat-pc,
     2003        input parcons-vat-pc,
     2004        input parslt-pc,
     2005        input parbase-rate,
     2006        input parbase-scale,
     2007        input parr-b,
     2008        input parcur-base,
     2009        input parcur-road-tax,
     2010        input parcur-excise,
     2011        input parcur-vat-pc,
     2012        input parcurcons-vat-pc,
     2013        input parcurslt-pc
     2014        ) no-error.
     2015     if error-status:error then do:
     2016       message
     2017         vss-workfile vss-revision vss-description skip
     2018         vss-include-info1 skip
     2019         "Ошибка при обсчете партии" skip
     2020         "Документ партии " bf_tt-clcparts.out-code skip
     2021         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     2022         return-value skip
     2023         error-status:get-message(1) skip
     2024         error-status:get-message(2) skip
     2025         error-status:get-message(3) skip
     2026         view-as alert-box error .
     2027       undo, return error .
     2028     end.
     2029     for each bf_tt-allsum on error undo, return error return-value :
     2030       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     2031       if not available bf_tt-allsum-line then do:
     2032         create bf_tt-allsum-line.
     2033         assign
     2034           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     2035       end.
     2036       assign
     2037         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     2038         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     2039         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     2040         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     2041         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     2042         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     2043         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     2044         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     2045         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
