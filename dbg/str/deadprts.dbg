      732     varslt-base-factovpcl     = 0
      733     varvat-base-factovpcl     = 0
      734     varvatcons-base-factovpcl = 0
      735     vardsc-base-factovpcl     = 0
      736     varsum-base-docovpcl      = 0
      737     varslt-base-docovpcl      = 0
      738     varvat-base-docovpcl      = 0
      739     varvatcons-base-docovpcl  = 0
      740     vardsc-base-docovpcl      = 0
      741     varsum-rubl-factovpcl     = 0
      742     varslt-rubl-factovpcl     = 0
      743     varvat-rubl-factovpcl     = 0
      744     varvatcons-rubl-factovpcl = 0
      745     vardsc-rubl-factovpcl     = 0
      746     varsum-rubl-docovpcl      = 0
      747     varslt-rubl-docovpcl      = 0
      748     varvat-rubl-docovpcl      = 0
      749     varvatcons-rubl-docovpcl  = 0
      750     vardsc-rubl-docovpcl      = 0.
      751   assign
      752     varis-one-gds-dtlcl = no.
      753   find first out-vatp_gds-dtlcl where out-vatp_gds-dtlcl.doc-code  = pardoc-code  and
      754                                        out-vatp_gds-dtlcl.artic     = parartic     and
      755                                        out-vatp_gds-dtlcl.prod-type = parprod-type and
      756                                        out-vatp_gds-dtlcl.prod-code = parprod-code no-lock no-error.
      757   if available out-vatp_gds-dtlcl then do:
      758     find first buf_out-vatp_gds-dtlcl where buf_out-vatp_gds-dtlcl.doc-code  =  pardoc-code                and
      759                                              buf_out-vatp_gds-dtlcl.artic     =  parartic                   and
      760                                              buf_out-vatp_gds-dtlcl.prod-type =  parprod-type               and
      761                                              buf_out-vatp_gds-dtlcl.prod-code =  parprod-code               and
      762                                              recid(buf_out-vatp_gds-dtlcl)    <> recid(out-vatp_gds-dtlcl) no-lock no-error.
