     3110           bf-expp_trn-doc-sum.cost-excise-rubl    = bf-expp_trn-doc-sum.cost-excise-rubl    +  bf-expp_doc-line-sum.cost-excise-rubl
     3111           bf-expp_trn-doc-sum.cost-transport-base = bf-expp_trn-doc-sum.cost-transport-base +  bf-expp_doc-line-sum.cost-transport-base
     3112           bf-expp_trn-doc-sum.cost-transport-rubl = bf-expp_trn-doc-sum.cost-transport-rubl +  bf-expp_doc-line-sum.cost-transport-rubl
     3113           bf-expp_trn-doc-sum.cost-other-base     = bf-expp_trn-doc-sum.cost-other-base     +  bf-expp_doc-line-sum.cost-other-base
     3114           bf-expp_trn-doc-sum.cost-other-rubl     = bf-expp_trn-doc-sum.cost-other-rubl     +  bf-expp_doc-line-sum.cost-other-rubl
     3115         .
