        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: prch-del.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: str/prch-del.p $":U .
        7   define variable vss-description as character no-undo init "Выплевывание файлов в прайс-чекер на удаление информации".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable  out                  as character no-undo .
       67   define variable out2                  as character      no-undo .
       68   DEFINE VARIABLE in_                   as character      no-undo .
       69   DEFINE VARIABLE spl                   as character      no-undo .
       70   DEFINE VARIABLE sav                   as character      no-undo .
       71   DEFINE VARIABLE v-remote              as character      no-undo .
       72   define variable  vv-full-path         as character no-undo .
       73   define variable  vv-path              as character no-undo .
       74   define variable  vv-file-name         as character no-undo .
       75   define variable  vv-file-name2        as character no-undo .
       76   define variable  vv-file-name-no-ext as character no-undo .
       77   define variable  vv-file-name-ext    as character no-undo .
       78   define stream cash-non.
       79     do
       80     on error undo, return error return-value
       81     :
       82     find first ub.cash-desk no-lock where
       83                ub.cash-desk.pos-type = 'pricecheck-Servis+':U no-error .
       84   if error-status :error then do:
       85      message "Нет прайс-чекеров Сервис+" view-as alert-box .
       86      return .
       87   end.
       88       run str/get-inis.p (
       89           input 'маг':U
       90         , input ub.cash-desk.obj-code
       91         , input 'pricecheck-Servis+':U
       92         , input ub.cash-desk.remote
       93         , input "send":U
       94         , output out
       95         , output out2
       96         , output in_
       97         , output spl
       98         , output sav
       99         , output v-remote
      100         ) no-error .
      101       run str/waitp.w (
      102            input (out + 'cash.upd')
      103           ,input ( 'Не считана предыдущая информация' )
      104           ,input ' Подождите 15 сек '
      105           ,input 'Прайс-чекер не ответил. Если Вы уверены, что с ним нет связи нажмите кнопку!'
      106           ,input 15
      107           )
      108           no-error.
      109     if  error-status :error then do:
      110       message  "Прайс-чекер не обработал предыдущую информацию... "  view-as alert-box .
      111       return .
      112     end.
      113     else do:
      114     run gbl/filename.p (
      115          input  (out + 'cash.non')
      116         ,output vv-full-path
      117         ,output vv-path
      118         ,output vv-file-name
      119         ,output vv-file-name-no-ext
      120         ,output vv-file-name-ext    ) no-error .
      121         if vv-file-name = "" then do:
      122             output stream cash-non to value (out + 'cash.non') .
      123             put stream cash-non unformatted skip.
      124             output stream cash-non close.
      125         end.
      126     run gbl/filename.p (
      127          input  (out + 'plucash.dat')
      128         ,output vv-full-path
      129         ,output vv-path
      130         ,output vv-file-name
      131         ,output vv-file-name-no-ext
      132         ,output vv-file-name-ext    ) no-error .
      133         if vv-file-name = "" then do:
      134             output stream cash-non to value (out + 'plucash.dat') .
      135             put stream cash-non unformatted
      136             "0,0,0,1,,1,,0,0,0,NOSIZE,,,,,,100,0,,18,1,,0,0"
      137             skip.
      138             output stream cash-non close.
      139         end.
      140     run gbl/filename.p (
      141          input  (out + 'bar.dat')
      142         ,output vv-full-path
      143         ,output vv-path
      144         ,output vv-file-name
      145         ,output vv-file-name-no-ext
      146         ,output vv-file-name-ext    ) no-error .
      147         if vv-file-name = "" then do:
      148             output stream cash-non to value (out + 'bar.dat') .
      149             put stream cash-non unformatted
      150             "0,0,NOSIZE,1"
      151             skip.
      152             output stream cash-non close.
      153         end.
      154     os-rename value( out + 'cash.non') value( out + 'cash.cng').
      155     message "Файл с заданием cash.cng выложен" view-as alert-box information .
      156   end.
      157     end.
