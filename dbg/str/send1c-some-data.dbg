        1   block-level on error undo, throw.
        2   using Ibs.Th.Rul.Route-data_.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   define input parameter p-parent-handle as handle no-undo .
        5   define input parameter p-log-handle  as handle no-undo .
        6   define input parameter p-data as memptr no-undo .
        7   define input parameter p-init-sec-tag as character no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: fc55a7295616, 2779, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
       10   define variable vss-date        as character no-undo init "$Date: Чт апр 08 19:52:17 2021 +0300 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: send1C-some-data.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: str/send1C-some-data.p $":U .
       13   define variable vss-description as character no-undo init "Экспорт любых данных в 1C ERP RN".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   define  variable garbcoll_ii as integer no-undo .
       85   define  temp-table temp-gc no-undo
       86   field ii as integer
       87   field obj-r as handle
       88   field cn as character
       89   index pi is unique primary
       90   ii
       91   index icn
       92   cn.
       93   procedure garbcoll_create-gc-entry :
       94   define input parameter p-cn as character no-undo .
       95   define input parameter p-obj-r as handle no-undo .
       96     do
       97     on error undo, return error
       98     :
       99       create temp-gc.
      100       assign
      101       temp-gc.ii = garbcoll_ii
      102       garbcoll_ii = garbcoll_ii + 1
      103       temp-gc.cn = p-cn
      104       temp-gc.obj-r = p-obj-r
      105       .
      106     end.
      107   end procedure.
      108   procedure garbcoll_clear :
      109     do
      110     on error undo, return error
      111     :
      112       for each temp-gc:
      113         delete object temp-gc.obj-r.
      114         delete temp-gc.
      115       end.
      116     end.
      117   end procedure.
      118   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119   procedure cur-time :
      120      define output parameter p-today as date      no-undo .
      121      define output parameter p-time  as integer   no-undo .
      122     do
      123     on error undo, return error
      124     :
      125       define variable v-date1 as date      no-undo .
      126       define variable v-date2 as date      no-undo .
      127       define variable v-time  as integer   no-undo .
      128       assign
      129         v-date1 = today
      130         v-time  = time
      131         v-date2 = today
      132       .
      133       if v-date1 <> v-date2
      134       then do:
      135         assign
      136           v-date1 = today
      137           v-time  = v-time
      138         .
      139       end.
      140       assign
      141         p-today = v-date1
      142         p-time  = v-time
      143       .
      144     end.
      145   end.
      146   function cur-time-date returns character
      147   :
      148     return string(today, '99/99/9999':U) .
      149   end.
      150   function cur-time-mjd returns decimal
      151   :
      152     define variable v-date as date      no-undo .
      153     define variable v-time as integer   no-undo .
      154     run cur-time in this-procedure
      155       (output v-date
      156       ,output v-time
      157       ) .
      158     return integer(v-date) - 2400002 + (v-time / 86400) .
      159   end.
      160   function cur-time-get-ending-index returns integer
      161   (input p-number as integer
      162   )
      163   :
      164     if p-number < 0
      165     or p-number = ?
      166     then do:
      167       return 1 .
      168     end.
      169     define variable v-rest as integer   no-undo .
      170     assign
      171       p-number = p-number modulo 100
      172     .
      173     if p-number < 20
      174     then do:
      175       assign
      176         v-rest = p-number
      177       .
      178     end.
      179     else do:
      180       assign
      181         v-rest = p-number modulo 10
      182       .
      183     end.
      184     case v-rest :
      185       when 1
      186       then do:
      187         return 2 .
      188       end.
      189       when 2 or
      190       when 3 or
      191       when 4
      192       then do:
      193         return 3 .
      194       end.
      195       otherwise do:
      196         return 1 .
      197       end.
      198     end case .
      199   end.
      200   procedure cur-time-mjd-to-date :
      201      define input  parameter i-mjd-diff as decimal no-undo.
      202      define output parameter o-Date     as date    no-undo.
      203      define output parameter o-Time     as integer no-undo.
      204      define variable v-day-number as integer   no-undo .
      205      if    i-mjd-diff < 0
      206         or i-mjd-diff = ?
      207      then do:
      208         return "?" .
      209      end.
      210      assign
      211         v-day-number = truncate(i-mjd-diff,0).
      212         o-Date = date(v-day-number + 2400002).
      213         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      214     .
      215   end.
      216   function cur-time-mjd-to-string returns character
      217   (input p-mjd-diff as decimal
      218   )
      219   :
      220     define variable v-day-number as integer   no-undo .
      221     define variable v-seconds    as integer   no-undo .
      222     define variable v-hour       as integer   no-undo .
      223     define variable v-min        as integer   no-undo .
      224     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      225     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      226     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      227     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      228     if p-mjd-diff < 0
      229     or p-mjd-diff = ?
      230     then do:
      231       return "?" .
      232     end.
      233     assign
      234       v-day-number = integer(truncate(p-mjd-diff,0))
      235       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      236     .
      237     if v-seconds > 86400
      238     then do:
      239       assign
      240         v-seconds = 86400 - 1
      241       .
      242     end.
      243     if v-seconds < 0
      244     then do:
      245       assign
      246         v-seconds = 0
      247       .
      248     end.
      249     assign
      250       v-hour = truncate(v-seconds / 3600, 0)
      251     .
      252     assign
      253       v-seconds = v-seconds modulo 3600
      254     .
      255     assign
      256       v-min = truncate(v-seconds / 60, 0)
      257     .
      258     assign
      259       v-seconds = v-seconds modulo 60
      260     .
      261     return
      262         (if v-day-number <> 0
      263           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      264           else ""
      265         )
      266       + (if v-day-number <> 0 or v-hour <> 0
      267           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      268           else ""
      269         )
      270       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      271           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      272           else ""
      273         )
      274       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      275       .
      276   end.
      277   function cur-time-string returns character
      278   :
      279     define variable v-date as date      no-undo .
      280     define variable v-time as integer   no-undo .
      281     run cur-time in this-procedure
      282       (output v-date
      283       ,output v-time
      284       ) .
      285     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      286   end.
      287   function cur-time-string-sec returns character
      288   :
      289     define variable v-date as date      no-undo .
      290     define variable v-time as integer   no-undo .
      291     run cur-time in this-procedure
      292       (output v-date
      293       ,output v-time
      294       ) .
      295     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      296   end.
      297   function cur-time-custom  returns character
      298   (input p-prefix as character
      299   ,input p-date-format as character
      300   ,input p-delimiter as character
      301   ,input p-time-format as character
      302   ,input p-suffix as character
      303   )
      304   :
      305     define variable v-date as date      no-undo .
      306     define variable v-time as integer   no-undo .
      307     run cur-time in this-procedure
      308       (output v-date
      309       ,output v-time
      310       ) .
      311     return
      312       p-prefix
      313       + string(v-date, p-date-format)
      314       + p-delimiter
      315       + string(v-time, p-time-format)
      316       + p-suffix
      317       .
      318   end.
      319   function cur-time-print  returns character
      320   :
      321     define variable v-date as date      no-undo .
      322     define variable v-time as integer   no-undo .
      323     run cur-time in this-procedure
      324       (output v-date
      325       ,output v-time
      326       ) .
      327     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      328   end.
      329   function cur-time-datetime returns datetime
      330   :
      331     define variable v-char as character no-undo .
      332     define variable v-datetime as datetime no-undo .
      333     v-char = cur-time-string().
      334     v-datetime = datetime(v-char).
      335     return  v-datetime.
      336   end.
      337   function cur-time-string-msec returns character
      338   :
      339     define variable v-date as datetime  no-undo .
      340     v-date = now.
      341     return string(v-date) .
      342   end.
      343   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      344   define new global shared variable g#lib-nws as handle no-undo .
      345   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      346   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      347   define variable tempcxml_v-num_ as integer no-undo .
      348   define  temp-table temp-xml-tables no-undo
      349   field order as integer
      350   field tbl-name as character
      351   field tbl-handle_ as handle
      352   field table-handle_ as handle
      353   field uniq-gate-rec as character
      354   field gate-name as character
      355   field gate-handle_ as handle
      356   field is-parent as logical
      357   index pi is unique primary
      358   uniq-gate-rec
      359   tbl-name
      360   index iorder
      361   order
      362   index gr
      363   uniq-gate-rec
      364   index gh
      365   gate-handle_
      366   index iparent
      367   is-parent
      368   .
      369   define  temp-table temp-xml-records no-undo
      370   field tbl-name as character
      371   field uniq-key-rec as character
      372   index pi is unique primary
      373   tbl-name
      374   uniq-key-rec
      375   .
      376   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   procedure gen-key-rec :
      378     define input  parameter p-tbl-name    as character no-undo.
      379     define input  parameter p-bh_tbl-name as handle    no-undo.
      380     define output parameter p-key-rec     as character no-undo.
      381     do
      382     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      383     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      384     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      385     :
      386       define variable fh               as handle    no-undo .
      387       define variable v-ok             as logical   no-undo .
      388       define variable v-inform         as character no-undo .
      389       define variable v-ind            as integer   no-undo .
      390       define variable v-idx-field-qnty as integer   no-undo .
      391       if p-tbl-name = ?
      392         or p-tbl-name = "":U
      393       then do:
      394         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
      395       end.
      396       if not p-bh_tbl-name:available then do:
      397         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
      398       end.
      399       assign
      400         p-key-rec = p-tbl-name
      401         v-inform  = p-bh_tbl-name:index-information(1)
      402         v-ind     = 2
      403       .
      404       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      405       on error undo, return error
      406       :
      407         assign
      408           v-inform = p-bh_tbl-name:index-information( v-ind )
      409           v-ind    = v-ind + 1
      410         .
      411       end.
      412       if v-inform = ?
      413         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      414         or entry( 3, v-inform, ",":U ) <> "1":U
      415       then do:
      416         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
      417       end.
      418       else do:
      419         assign
      420           v-idx-field-qnty = num-entries( v-inform ) - 4
      421         .
      422         if v-idx-field-qnty < 2 then do:
      423           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
      424         end.
      425         do v-ind = 1 to v-idx-field-qnty by 2
      426         on error undo, return error
      427         :
      428           assign
      429             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      430             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      431           .
      432         end.
      433       end.
      434       if p-key-rec = ? then do:
      435         assign
      436           p-key-rec = "":U
      437         .
      438         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
      439       end.
      440     end.
      441     return.
      442   end procedure.
      443   procedure gen-where-keyr-tab :
      444     define input  parameter i-tableSerach as character no-undo.
      445     define input  parameter i-tablekey   as character  no-undo.
      446     define input  parameter p-key-rec    as character  no-undo.
      447     define input  parameter p-key-handle as handle     no-undo .
      448     define input  parameter p-db-name    as character  no-undo .
      449     define input  parameter p-tt-handle  as handle     no-undo .
      450     define output parameter o-Where      as character  no-undo.
      451     do
      452     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      453     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      454     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      455     :
      456       define variable v-full-tbl-name  as character no-undo .
      457       define variable bh_tbl-name      as handle    no-undo .
      458       define variable fh_key           as handle    no-undo .
      459       define variable fh_search        as handle    no-undo .
      460       define variable v-field-num      as integer   no-undo .
      461       define variable v-count-fld      as integer   no-undo .
      462       define variable v-inform         as character no-undo .
      463       define variable v-ind            as integer   no-undo .
      464       define variable v-idx-field-qnty as integer   no-undo .
      465       define variable v-field-name     as character no-undo .
      466       define variable v-field-val      as character no-undo .
      467       define variable v-word-link      as character no-undo .
      468       define variable vTable           as character no-undo.
      469       define variable bh_tbl-key       as handle    no-undo .
      470       assign
      471         p-key-rec = trim( p-key-rec )
      472       .
      473       if p-key-handle <> ? then do:
      474         if not valid-handle(p-key-handle)
      475            or p-key-handle:type <> "buffer"
      476         then do:
      477           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
      478         end.
      479         if num-entries( p-key-rec, chr(3) ) > 1
      480           or p-key-rec = ?
      481           or p-key-rec = "":U
      482         then do:
      483           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
      484         end.
      485       end.
      486       else do:
      487         if p-key-rec = ?
      488           or p-key-rec = "":U
      489         then do:
      490           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      491         end.
      492       end.
      493       assign
      494         vTable = entry( 1 , p-key-rec, chr(3) )
      495       .
      496       if p-tt-handle <> ?
      497         and ( not valid-handle(p-tt-handle)
      498               or p-tt-handle:type <> "buffer"
      499             )
      500       then do:
      501         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
      502       end.
      503       if p-tt-handle = ? then do:
      504         assign
      505           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      506         .
      507         create buffer bh_tbl-name for table v-full-tbl-name .
      508       end.
      509       else do:
      510         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      511       end.
      512       assign
      513         v-inform = bh_tbl-name:index-information(1)
      514         v-ind    = 2
      515       .
      516       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      517       on error undo, return error
      518       :
      519         assign
      520           v-inform = bh_tbl-name:index-information( v-ind )
      521           v-ind    = v-ind + 1
      522         .
      523       end.
      524       if v-inform = ?
      525         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      526         or entry( 3, v-inform, ",":U ) <> "1":U
      527       then do:
      528         delete object bh_tbl-name no-error.
      529         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
      530       end.
      531       assign
      532         v-idx-field-qnty = num-entries( v-inform ) - 4
      533       .
      534       if v-idx-field-qnty < 2 then do:
      535         delete object bh_tbl-name no-error.
      536         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
      537       end.
      538       assign
      539         o-where     = "where":U
      540         v-word-link = "":U
      541         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      542         v-count-fld = 0
      543       .
      544       if i-tablekey ne "" and i-tablekey ne ?
      545       then do:
      546         assign
      547           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      548         .
      549         create buffer bh_tbl-key for table v-full-tbl-name .
      550       end.
      551       if i-tableSerach ne "" and i-tableSerach ne ?
      552       then do:
      553         delete object bh_tbl-name no-error.
      554         assign
      555           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      556         .
      557         create buffer bh_tbl-name for table v-full-tbl-name .
      558       end.
      559       block_where:
      560       do v-ind = 1 to v-idx-field-qnty by 2
      561       on error undo, return error
      562       :
      563         assign
      564           v-count-fld = v-count-fld + 1
      565         .
      566         if p-key-handle = ?
      567           and v-count-fld > v-field-num
      568         then do:
      569           leave block_where.
      570         end.
      571         define variable VfieldKeyTable as handle no-undo.
      572         assign
      573           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      574           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      575         .
      576         if     bh_tbl-key ne ?
      577         then do:
      578            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      579            if VfieldKeyTable eq ?
      580            then next block_where.
      581         end.
      582         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      583         then
      584            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      585         else
      586            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      587         if p-key-handle = ? then do:
      588           assign
      589             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      590           .
      591         end.
      592         else do:
      593           assign
      594             fh_key = p-key-handle:buffer-field( v-field-name )
      595           .
      596           if fh_key = ?
      597             or not valid-handle( fh_key )
      598           then do:
      599             delete object bh_tbl-name.
      600             if     bh_tbl-key ne ?
      601             then
      602                delete object bh_tbl-key.
      603             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
      604           end.
      605           assign
      606             v-field-val = fh_key:buffer-value
      607           .
      608         end.
      609         if fh_search:data-type ="character":U then do:
      610           assign
      611             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      612             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      613             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      614             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      615             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      616             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      617             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      618             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      619             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      620             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      621             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      622             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      623             v-field-val = substitute( '"&1"', v-field-val )
      624           .
      625         end.
      626         assign
      627           o-where = substitute( "&1 &2", o-where, v-field-val )
      628         .
      629         if v-word-link = "":U then do:
      630           assign
      631             v-word-link = "and":U
      632           .
      633         end.
      634       end.
      635       delete object bh_tbl-name.
      636       if     bh_tbl-key ne ?
      637       then
      638          delete object bh_tbl-key.
      639       if p-key-handle = ?
      640         and v-count-fld <> v-field-num
      641       then do:
      642         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
      643       end.
      644     end.
      645   end procedure.
      646   procedure gen-hn-keyr-tab :
      647     define input  parameter i-tableSerach as character no-undo.
      648     define input  parameter i-tablekey   as character no-undo.
      649     define input  parameter p-key-rec    as character no-undo.
      650     define input  parameter p-key-handle as handle    no-undo .
      651     define input  parameter p-db-name    as character no-undo .
      652     define input  parameter p-tt-handle  as handle    no-undo .
      653     define input  parameter p-stts-lock  as integer   no-undo .
      654     define output parameter o-hn         as handle    no-undo.
      655     define variable v-full-tbl-name as character no-undo.
      656     define variable v-where         as character no-undo.
      657     define variable bh_tbl-name     as handle    no-undo.
      658     define variable vTable          as character no-undo.
      659     do
      660     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      661     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      662     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      663         run gen-where-keyr-tab(i-tableSerach,
      664                                i-tablekey,
      665                                p-key-rec,
      666                                p-key-handle,
      667                                p-db-name,
      668                                p-tt-handle,
      669                                output v-where).
      670         if i-tableSerach ne "" and i-tableSerach ne ?
      671         then do:
      672            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      673            create buffer bh_tbl-name for table v-full-tbl-name .
      674         end.
      675         else do:
      676            if p-tt-handle = ? then do:
      677               assign
      678                  vTable = entry( 1 , p-key-rec, chr(3) )
      679               .
      680               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      681               create buffer bh_tbl-name for table v-full-tbl-name .
      682            end.
      683            else do:
      684               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      685            end.
      686         end.
      687         if p-tt-handle = ? then do:
      688            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      689         end.
      690         else do:
      691            bh_tbl-name:find-first( v-where ) no-error .
      692         end.
      693         o-hn = bh_tbl-name.
      694      end.
      695   end procedure.
      696   procedure gen-hn-keyr :
      697     define input  parameter p-key-rec    as character no-undo.
      698     define input  parameter p-key-handle as handle    no-undo .
      699     define input  parameter p-db-name    as character no-undo .
      700     define input  parameter p-tt-handle  as handle    no-undo .
      701     define input  parameter p-stts-lock  as integer   no-undo .
      702     define output parameter o-hn         as handle    no-undo.
      703     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      704   end.
      705   procedure gen-row-keyr :
      706     define input  parameter p-key-rec    as character no-undo.
      707     define input  parameter p-key-handle as handle    no-undo .
      708     define input  parameter p-db-name    as character no-undo .
      709     define input  parameter p-tt-handle  as handle    no-undo .
      710     define input  parameter p-stts-lock  as integer   no-undo .
      711     define output parameter p-tbl-row    as rowid     no-undo.
      712     define output parameter p-tbl-name   as character no-undo.
      713     define variable vHn as handle no-undo.
      714       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      715       p-tbl-row = if vHn:available then vHn:rowid else ?.
      716       p-tbl-name =  vHn:table.
      717       delete object vHn no-error.
      718     if p-tbl-row = ? then do:
      719       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
      720     end.
      721     else do:
      722       return.
      723     end.
      724   end procedure.
      725   procedure gen-key-fv :
      726     define input  parameter p-key-rec    as character no-undo .
      727     define output parameter p-field-list as character no-undo .
      728     define output parameter p-value-list as character no-undo.
      729     do
      730     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      731     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      732     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      733     :
      734       define variable v-full-tbl-name  as character no-undo .
      735       define variable bh_tbl-name      as handle    no-undo .
      736       define variable v-tbl-name       as character no-undo .
      737       define variable v-field-num      as integer   no-undo .
      738       define variable v-count-fld      as integer   no-undo .
      739       define variable v-inform         as character no-undo .
      740       define variable v-ind            as integer   no-undo .
      741       define variable v-idx-field-qnty as integer   no-undo .
      742       define variable v-delim-key      as character no-undo .
      743       if p-key-rec = ?
      744         or p-key-rec = "":U
      745       then do:
      746         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      747       end.
      748       assign
      749         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      750         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      751       .
      752       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      753       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
      754       assign
      755         v-inform = bh_tbl-name:index-information(1)
      756         v-ind    = 2
      757       .
      758       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      759       on error undo, return error
      760       :
      761         assign
      762           v-inform = bh_tbl-name:index-information( v-ind )
      763           v-ind    = v-ind + 1
      764         .
      765       end.
      766       if v-inform = ?
      767         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      768         or entry( 3, v-inform, ",":U ) <> "1":U
      769       then do:
      770         delete object bh_tbl-name no-error.
      771         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      772       end.
      773       assign
      774         v-idx-field-qnty = num-entries( v-inform ) - 4
      775       .
      776       if v-idx-field-qnty < 2 then do:
      777         delete object bh_tbl-name no-error.
      778         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      779       end.
      780       assign
      781         p-field-list = "":U
      782         p-value-list = "":U
      783         v-delim-key  = "":U
      784         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      785         v-count-fld  = 0
      786       .
      787       block_where:
      788       do v-ind = 1 to v-idx-field-qnty by 2
      789       on error undo, return error
      790       :
      791         assign
      792           v-count-fld = v-count-fld + 1
      793         .
      794         if v-count-fld > v-field-num then do:
      795           leave block_where.
      796         end.
      797         assign
      798           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      799           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      800         .
      801         if v-ind = 1 then do:
      802           assign
      803             v-delim-key = chr(3)
      804           .
      805         end.
      806       end.
      807       delete object bh_tbl-name.
      808       if v-count-fld <> v-field-num then do:
      809         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
      810       end.
      811     end.
      812   end procedure.
      813   procedure gen-key-field :
      814     define input  parameter p-table      as character no-undo .
      815     define output parameter p-field-list as character no-undo .
      816     do
      817     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      818     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      819     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      820     :
      821       define variable v-full-tbl-name  as character no-undo .
      822       define variable bh_tbl-name      as handle    no-undo .
      823       define variable v-tbl-name       as character no-undo .
      824       define variable v-field-num      as integer   no-undo .
      825       define variable v-count-fld      as integer   no-undo .
      826       define variable v-inform         as character no-undo .
      827       define variable v-ind            as integer   no-undo .
      828       define variable v-idx-field-qnty as integer   no-undo .
      829       define variable v-delim-key      as character no-undo .
      830       if p-table = ?
      831         or p-table = "":U
      832       then do:
      833         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
      834       end.
      835       assign
      836         v-tbl-name      = p-table
      837         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      838       .
      839       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      840       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
      841       assign
      842         v-inform = bh_tbl-name:index-information(1)
      843         v-ind    = 2
      844       .
      845       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      846       on error undo, return error
      847       :
      848         assign
      849           v-inform = bh_tbl-name:index-information( v-ind )
      850           v-ind    = v-ind + 1
      851         .
      852       end.
      853       if v-inform = ?
      854         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      855         or entry( 3, v-inform, ",":U ) <> "1":U
      856       then do:
      857         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      858       end.
      859       assign
      860         v-idx-field-qnty = num-entries( v-inform ) - 4
      861       .
      862       if v-idx-field-qnty < 2 then do:
      863         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      864       end.
      865       assign
      866         p-field-list = "":U
      867         v-delim-key  = "":U
      868         v-count-fld  = 0
      869       .
      870       block_where:
      871       do v-ind = 1 to v-idx-field-qnty by 2
      872       on error undo, return error
      873       :
      874         assign
      875           v-count-fld = v-count-fld + 1
      876         .
      877         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      878         if v-ind = 1 then do:
      879           assign
      880             v-delim-key = chr(3)
      881           .
      882         end.
      883       end.
      884       delete object bh_tbl-name.
      885     end.
      886   end procedure.
      887   procedure get-gate-file-name :
      888   define input parameter p-gate-rec as character no-undo .
      889   define output  parameter p-gate-file-name as character no-undo .
      890   define buffer buf_clob-data for ub.clob-data.
      891   define variable v-tbl-row as rowid no-undo .
      892   define variable v-tbl-name as character no-undo .
      893   run gen-row-keyr in this-procedure ( input p-gate-rec
      894                                       ,input ?
      895                                       ,input "ub"
      896                                       ,input ?
      897                                       ,input no-lock
      898                                       ,output v-tbl-row
      899                                       ,output v-tbl-name) no-error.
      900   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      901                                                           ,vss-include-info3
      902                                                           ,p-gate-rec).
      903   find first buf_clob-data no-lock where
      904             rowid(buf_clob-data) = v-tbl-row no-error.
      905   if not available buf_clob-data then do:
      906     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      907                                                             ,vss-include-info3
      908                                                             ,p-gate-rec).
      909   end.
      910   p-gate-file-name = buf_clob-data.file-name.
      911   end procedure.
      912   procedure get-gate-rec :
      913   define input  parameter p-gate-name as character no-undo .
      914   define output parameter p-gate-rec as character no-undo .
      915   define buffer buf_clob-bind for ub.clob-bind.
      916   define buffer buf_clob-data for ub.clob-data.
      917   main-block:
      918   do
      919   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1))
      920   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info3 )
      921   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info3 )
      922   :
      923       find first buf_clob-bind no-lock where
      924                 buf_clob-bind.uniq-key-rec = p-gate-name
      925             and buf_clob-bind.field-name = '':U
      926             and buf_clob-bind.part-num = 1
      927             and buf_clob-bind.resource-type = 'gate':U
      928             no-error.
      929       if not available buf_clob-bind then do:
      930         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      931                                         , p-gate-name
      932                                         ).
      933       end.
      934       find first buf_clob-data no-lock where
      935                 buf_clob-data.db-num = buf_clob-bind.db-num
      936             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
      937       if not available buf_clob-data then do:
      938         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
      939                                         , buf_clob-bind.db-num
      940                                         , buf_clob-bind.int64-id
      941                                         , p-gate-name
      942                                         ).
      943       end.
      944       run gen-key-rec in this-procedure ( input 'clob-data':U
      945                                 ,input buffer buf_clob-data:handle
      946                                 ,output p-gate-rec).
      947   end.
      948   end procedure.
      949   procedure get-gate-by-name :
      950   define input  parameter p-gate-name as character no-undo .
      951   define output parameter p-gate-rec as character no-undo .
      952   define output parameter p-dsh as handle no-undo .
      953   define input-output  parameter p-xmlh as handle no-undo .
      954   define variable v-ii as integer   no-undo .
      955   define variable glog as logical   no-undo .
      956   define variable v-longchar as longchar no-undo .
      957   define variable v-txmlh as handle no-undo .
      958   define variable v-db-num as integer no-undo .
      959   define variable v-int64-id as int64 no-undo .
      960   define buffer buf_clob-bind for ub.clob-bind.
      961   define buffer buf_clob-data for ub.clob-data.
      962   main-block:
      963   do
      964   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1))
      965   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info3 )
      966   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info3 )
      967   :
      968       find first buf_clob-bind no-lock where
      969                 buf_clob-bind.uniq-key-rec = p-gate-name
      970             and buf_clob-bind.field-name = '':U
      971             and buf_clob-bind.part-num = 1
      972             and buf_clob-bind.resource-type = 'gate':U
      973             no-error.
      974       if not available buf_clob-bind then do:
      975         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      976                                         , p-gate-name
      977                                         ).
      978       end.
      979       find first buf_clob-data no-lock where
      980                 buf_clob-data.db-num = buf_clob-bind.db-num
      981             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
      982       if not available buf_clob-data then do:
      983         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
      984                                         , buf_clob-bind.db-num
      985                                         , buf_clob-bind.int64-id
      986                                         , p-gate-name
      987                                         ).
      988       end.
      989       assign
      990       v-longchar = buf_clob-data.cdata
      991       .
      992       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
      993       if error-status :error then do:
      994         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
      995       end.
      996       create dataset p-dsh .
      997       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
      998                                     , v-longchar
      999                                     , ?
     1000                                     , ?
     1001                                     , ?
     1002                                     ) no-error.
     1003       v-longchar = '':U.
     1004       if error-status :error
     1005       or not glog
     1006       then do:
     1007         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1008       end.
     1009       if not valid-handle(p-xmlh)
     1010       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1011         create temp-table v-txmlh.
     1012         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1013         v-txmlh:temp-table-prepare("temp-xml-tables").
     1014         p-xmlh = v-txmlh:default-buffer-handle.
     1015       end.
     1016       run gen-key-rec in this-procedure ( input 'clob-data':U
     1017                                 ,input buffer buf_clob-data:handle
     1018                                 ,output p-gate-rec).
     1019       do v-ii = 1 to p-dsh:num-buffers:
     1020         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1021         if not p-xmlh:available then do:
     1022           p-xmlh:buffer-create().
     1023           assign
     1024           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1025           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1026           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1027           p-xmlh::gate-handle_ = p-dsh
     1028           p-xmlh::uniq-gate-rec = p-gate-rec
     1029           p-xmlh::gate-name = p-dsh:name
     1030           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1031           .
     1032           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1033             assign
     1034             p-xmlh::order = -3.
     1035           end.
     1036         end.
     1037       end.
     1038   end.
     1039   end procedure.
     1040   procedure get-gate-by-rec :
     1041   define input  parameter p-gate-rec as character no-undo .
     1042   define output parameter p-dsh as handle no-undo .
     1043   define input-output  parameter p-xmlh as handle no-undo .
     1044   define input-output parameter p-longchar  as longchar no-undo .
     1045   define variable v-ii as integer   no-undo .
     1046   define variable glog as logical   no-undo .
     1047   define variable v-rowid as rowid no-undo .
     1048   define variable v-tbl-name as character no-undo .
     1049   define variable v-longchar as longchar no-undo .
     1050   define variable v-txmlh as handle no-undo .
     1051   define buffer buf_clob-data for ub.clob-data.
     1052   main-block:
     1053   do
     1054   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1))
     1055   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info3 )
     1056   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info3 )
     1057   :
     1058     run gen-row-keyr in this-procedure (
     1059                                           input  p-gate-rec
     1060                                           ,input  ?
     1061                                           ,input  "ub"
     1062                                           ,input  ?
     1063                                           ,input  NO-LOCK
     1064                                           ,output v-rowid
     1065                                           ,output v-tbl-name   ) no-error.
     1066       find first buf_clob-data no-lock where
     1067                 rowid(buf_clob-data) = v-rowid  no-error.
     1068       if not available buf_clob-data then do:
     1069         undo, return error substitute("Не найден CLOB  &1"
     1070                                         , p-gate-rec
     1071                                         ).
     1072       end.
     1073       assign
     1074       v-longchar = buf_clob-data.cdata
     1075       .
     1076       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1077       if error-status :error then do:
     1078         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1079       end.
     1080       create dataset p-dsh .
     1081       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1082                                     , v-longchar
     1083                                     , ?
     1084                                     , ?
     1085                                     , ?
     1086                                     ) no-error.
     1087       define variable v-esm as character no-undo .
     1088       v-esm = error-status:get-message(1) .
     1089       if p-longchar <> ? then do:
     1090         p-longchar = v-longchar.
     1091       end.
     1092       v-longchar = '':U.
     1093       if error-status :error
     1094       or not glog
     1095       then do:
     1096         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1097                                      , p-gate-rec
     1098                                      , p-gate-rec
     1099                                      , v-esm
     1100                                      ).
     1101       end.
     1102       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1103       if not valid-handle(p-xmlh)
     1104       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1105         create temp-table v-txmlh.
     1106         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1107         v-txmlh:temp-table-prepare("temp-xml-tables").
     1108         p-xmlh = v-txmlh:default-buffer-handle.
     1109       end.
     1110       do v-ii = 1 to p-dsh:num-buffers:
     1111         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1112         if not p-xmlh:available then do:
     1113           p-xmlh:buffer-create().
     1114           assign
     1115           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1116           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1117           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1118           p-xmlh::gate-handle_ = p-dsh
     1119           p-xmlh::uniq-gate-rec = p-gate-rec
     1120           p-xmlh::gate-name = p-dsh:name
     1121           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1122           .
     1123           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1124             assign
     1125             p-xmlh::order = -3.
     1126           end.
     1127           p-xmlh:buffer-release().
     1128         end.
     1129       end.
     1130   end.
     1131   end procedure.
     1132   procedure get-gate-by-file :
     1133   define input  parameter p-schema-file-name as character no-undo .
     1134   define input  parameter p-gate-rec as character no-undo .
     1135   define output parameter p-dsh as handle no-undo .
     1136   define input-output  parameter p-xmlh as handle no-undo .
     1137   define variable v-ii as integer   no-undo .
     1138   define variable glog as logical   no-undo .
     1139   define variable v-rowid as rowid no-undo .
     1140   define variable v-tbl-name as character no-undo .
     1141   define variable v-longchar as longchar no-undo .
     1142   define variable v-txmlh as handle no-undo .
     1143   main-block:
     1144   do
     1145   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1))
     1146   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info3 )
     1147   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info3 )
     1148   :
     1149       COPY-LOB
     1150       FROM  FILE p-schema-file-name
     1151       TO  OBJECT v-longchar
     1152       no-convert
     1153       NO-ERROR .
     1154       if error-status :error then do:
     1155           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1156                                     , p-schema-file-name
     1157                                 , chr(10)
     1158                                 , error-status:get-message(1) ).
     1159       end.
     1160       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1161       if error-status :error then do:
     1162         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1163       end.
     1164       create dataset p-dsh .
     1165       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1166                                     , v-longchar
     1167                                     , ?
     1168                                     , ?
     1169                                     , ?
     1170                                     ) no-error.
     1171       v-longchar = ''.
     1172       if error-status :error
     1173       or not glog
     1174       then do:
     1175         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1176                                      , p-schema-file-name
     1177                                      ,chr(10)
     1178                                      , error-status:get-message(1)
     1179                                      ).
     1180       end.
     1181       if not valid-handle(p-xmlh)
     1182       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1183         create temp-table v-txmlh.
     1184         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1185         v-txmlh:temp-table-prepare("temp-xml-tables").
     1186         p-xmlh = v-txmlh:default-buffer-handle.
     1187       end.
     1188       do v-ii = 1 to p-dsh:num-buffers:
     1189         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1190                                      ,p-dsh:get-buffer-handle(v-ii):name
     1191                                      ,p-gate-rec
     1192                                      )) no-error.
     1193         if not p-xmlh:available then do:
     1194           p-xmlh:buffer-create().
     1195           assign
     1196           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1197           p-xmlh::uniq-gate-rec = p-gate-rec
     1198           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1199           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1200           p-xmlh::gate-handle_ = p-dsh
     1201           p-xmlh::gate-name = p-dsh:name
     1202           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1203           .
     1204           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1205             assign
     1206             p-xmlh::order = -3.
     1207           end.
     1208           p-xmlh:buffer-release().
     1209         end.
     1210       end.
     1211   end.
     1212   end procedure.
     1213   procedure gate-clear :
     1214   define input  parameter p-dsh as handle no-undo .
     1215   define input  parameter p-xmlh as handle no-undo .
     1216   define variable v-dsh as handle no-undo .
     1217   define variable v-th as handle no-undo .
     1218     do
     1219     on error undo, return error return-value
     1220     :
     1221       if valid-handle(p-dsh) then do:
     1222         delete object p-dsh.
     1223         v-dsh = p-dsh.
     1224         p-dsh = ?.
     1225       end.
     1226       repeat while true:
     1227         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1228                            , share-lock) no-error.
     1229         if p-xmlh:available then do:
     1230           assign
     1231           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1232           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1233           and valid-handle(v-th)
     1234           and v-th:dynamic = yes
     1235           then do:
     1236             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1237             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1238           end.
     1239           p-xmlh:buffer-delete().
     1240         end.
     1241         else do:
     1242           leave.
     1243         end.
     1244       end.
     1245       if p-xmlh:dynamic = yes
     1246       and valid-handle(p-xmlh)
     1247       then do:
     1248         delete object p-xmlh:table-handle.
     1249         p-xmlh = ?.
     1250       end.
     1251       v-dsh = ?.
     1252     end.
     1253   end procedure.
     1254   procedure all-gates-clear :
     1255   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1256   do
     1257   on error undo, return error
     1258   :
     1259     for each buf_temp-xml-tables
     1260     break
     1261     by buf_temp-xml-tables.uniq-gate-rec
     1262     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1263     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1264     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1265     :
     1266         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1267           delete object buf_temp-xml-tables.gate-handle_.
     1268           buf_temp-xml-tables.gate-handle_ = ?.
     1269         end.
     1270         if valid-handle(buf_temp-xml-tables.table-handle_)
     1271         and buf_temp-xml-tables.table-handle_:dynamic = no
     1272         then do:
     1273           delete object buf_temp-xml-tables.table-handle_.
     1274           buf_temp-xml-tables.table-handle_ = ?.
     1275         end.
     1276         delete buf_temp-xml-tables.
     1277     end.
     1278   end.
     1279   end procedure.
     1280   procedure fix-schemalocation :
     1281   define input-output  parameter p-longchar as longchar no-undo .
     1282   DEFINE VARIABLE hdoc AS HANDLE.
     1283   DEFINE VARIABLE hroot AS HANDLE.
     1284   DEFINE VARIABLE hnode-child AS HANDLE.
     1285   DEFINE VARIABLE hnode-attr AS HANDLE.
     1286   define variable v-jj as integer   no-undo .
     1287   define variable ok as logical   no-undo .
     1288   define variable v-path1                    as character                no-undo .
     1289   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1290   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1291   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1292   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1293   define variable v-schema-location          as character                no-undo .
     1294   do
     1295   on error undo, return error return-value
     1296   :
     1297     CREATE X-DOCUMENT hdoc.
     1298     CREATE X-noderef hroot.
     1299     CREATE X-noderef hnode-child.
     1300     CREATE X-noderef hnode-attr.
     1301     hdoc:load("longchar", p-longchar, no) no-error.
     1302     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1303     hdoc:get-document-element(hroot).
     1304     _repeat:
     1305     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1306       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1307       if not ok then next.
     1308       if hNode-Child:local-name = "include"
     1309       then do:
     1310         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1311           v-schema-location = hnode-attr:node-value.
     1312           run gbl/filename.p (
     1313                           input "exe/" + hnode-attr:node-value
     1314                         ,output v-full-path1
     1315                         ,output v-path1
     1316                         ,output v-file-name1
     1317                         ,output v-file-name-no-ext1
     1318                         ,output v-file-name-ext1
     1319                         ) no-error .
     1320           if error-status :error then do:
     1321             delete object hnode-attr.
     1322             delete object hnode-child.
     1323             delete object hroot.
     1324             delete object hdoc.
     1325             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1326           end.
     1327         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1328         leave  _repeat.
     1329       end.
     1330     END.
     1331     hdoc:save("longchar", p-longchar).
     1332     delete object hnode-attr.
     1333     delete object hnode-child.
     1334     delete object hroot.
     1335     delete object hdoc.
     1336   end.
     1337   end procedure.
     1338   procedure gate-clb_fill-xml-tables :
     1339   define input parameter p-dsh as handle no-undo .
     1340   define input-output parameter p-xmlh as handle no-undo .
     1341   define variable v-ii as integer no-undo .
     1342     do
     1343     on error undo, return error
     1344     :
     1345       do v-ii = 1 to p-dsh:num-buffers:
     1346         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1347         if not p-xmlh:available then do:
     1348           p-xmlh:buffer-create().
     1349           assign
     1350           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1351           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1352           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1353           p-xmlh::gate-handle_ = p-dsh
     1354           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1355           p-xmlh::gate-name = p-dsh:name
     1356           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1357           .
     1358           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1359             assign
     1360             p-xmlh::order = -3.
     1361           end.
     1362           p-xmlh:buffer-release().
     1363         end.
     1364       end.
     1365     end.
     1366   end procedure.
     1367   procedure all-gates-empty :
     1368   define buffer buf_temp-xml-tables for temp-xml-tables.
     1369   do
     1370   on error undo, return error
     1371   :
     1372     for each buf_temp-xml-tables
     1373     break
     1374     by buf_temp-xml-tables.uniq-gate-rec
     1375     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1376     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1377     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1378     :
     1379       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1380         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1381       end.
     1382     end.
     1383   end.
     1384   end procedure.
     1385   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1386   FUNCTION rum-fn_get-next-file-name returns character (
     1387                                       input p-base-file-name as character
     1388                                     , input p-index as integer):
     1389   define variable v-loc-file-name as character no-undo .
     1390   v-loc-file-name = substitute("&1_&2.&3"
     1391                               ,substring(p-base-file-name, 1, (if r-index(p-base-file-name, ".") > 1
     1392                                                         then (r-index(p-base-file-name, ".") - 1)
     1393                                                         else length(p-base-file-name)
     1394                                                         )
     1395                                           )
     1396                               ,p-index
     1397                               ,(if r-index(p-base-file-name, ".") > 1
     1398                                 then substring(p-base-file-name, r-index(p-base-file-name, ".") + 1)
     1399                                 else '')
     1400                                 )
     1401                                 .
     1402   return v-loc-file-name.
     1403   end function.
     1404   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1405   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1406   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1407   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1408   function context_get-thobj-es return logical
     1409   (
     1410      input p-esys-id as integer
     1411     ,input p-eobj-type as character
     1412     ,input p-eobj-code as integer
     1413     ,output p-obj-type as character
     1414     ,output p-obj-code as integer
     1415   ):
     1416      define variable v-value-list as character no-undo .
     1417      define variable v-field-list as character no-undo .
     1418      define buffer buf_clients for ub.clients.
     1419      define buffer buf_ext-classif for ub.ext-classif.
     1420      find first buf_ext-classif no-lock where
     1421                buf_ext-classif.classif-name = 'clients-esys':U
     1422            and buf_ext-classif.classif-subject = 'clients':U
     1423            and buf_ext-classif.db-num = 0
     1424            and buf_Ext-classif.key#_one = p-esys-id
     1425            and buf_Ext-classif.charkey_one = p-eobj-type
     1426            and buf_Ext-classif.key#_two = p-eobj-code no-error .
     1427      if available buf_Ext-classif
     1428      then do:
     1429         ObjSrv:Lib:KeyRec:GenKeyFv (
     1430                                         input buf_Ext-classif.uniq-key-rec
     1431                                         ,output v-field-list
     1432                                         ,output v-value-list).
     1433         assign
     1434            p-obj-type = entry(lookup("obj-type":U
     1435                                     , v-field-list
     1436                                     , chr(3))
     1437                                     , v-value-list, chr(3))
     1438            p-obj-code = integer(entry(lookup("obj-code":U
     1439                                            , v-field-list
     1440                                            , chr(3))
     1441                                      , v-value-list
     1442                                      , chr(3)))
     1443         no-error .
     1444      end.
     1445      if     available buf_ext-classif
     1446         and (p-obj-type = 'маг':U
     1447              or
     1448              p-obj-type = 'скл':U
     1449              )
     1450         and (p-obj-code > 0 and p-obj-code <= 99999)
     1451      then do:
     1452         find first buf_clients no-lock where
     1453                    buf_clients.obj-type = p-obj-type
     1454                and buf_clients.obj-code = p-obj-code no-error.
     1455         if available buf_clients then do:
     1456            return yes.
     1457         end.
     1458         else do:
     1459            assign
     1460               p-obj-type = '':U
     1461               p-obj-code = 0
     1462            .
     1463            return no.
     1464         end.
     1465      end.
     1466      else do:
     1467         assign
     1468            p-obj-type = '':U
     1469            p-obj-code = 0
     1470         .
     1471         return no.
     1472      end.
     1473   end.
