     2226      end.
     2227   end.
     2228   on delete of this-procedure do:
     2229     run garbcoll_clear in this-procedure .
     2230   end.
     2231   define variable ExpData1 as class Route-data_ no-undo .
     2232   ExpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle) .
     2233   if not this-procedure:persistent then do:
     2234     run proc-main in this-procedure no-error .
     2235     if error-status:error then do:
     2236       v-esm = error-status :get-message (1).
     2237       v-es = error-status:error .
     2238       v-rv = return-value .
     2239     end.
     2240     if v-es then do:
     2241         run write-to-log in p-log-handle (substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm)) .
     2242         run garbcoll_clear in this-procedure .
     2243         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     2244     end.
     2245     run garbcoll_clear in this-procedure .
     2246   end.
     2247   procedure proc-main :
     2248   _main:
     2249   do
     2250   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     2251   :
     2252     define variable v-ii as integer no-undo .
     2253     define variable v-err as logical no-undo .
     2254     define variable v-custom-pack-name as character no-undo .
     2255     define variable v-success as logical   no-undo .
     2256     define variable v-datetimechar as character no-undo .
     2257     define variable v-dump-ord-int64 as int64 no-undo .
     2258     define buffer buf_ext-system for ub.ext-system .
     2259     define buffer buf_sys-ctrl for ub.sys-ctrl .
     2260     find first buf_sys-ctrl no-lock .
     2261     v-esys-id-list = "" .
     2262     for each buf_ext-system no-lock where buf_ext-system.delivery-method = integer('11':U)
     2263                                       and buf_ext-system.esys-have-export = yes
     2264                                       and buf_ext-system.esys-db-num-exp = buf_sys-ctrl.db-num :
     2265       v-esys-id-list = v-esys-id-list + string(buf_ext-system.esys-id) + chr(1) .
     2266     end.
     2267     v-esys-id-list = trim(v-esys-id-list, chr(1)) .
     2268     if v-esys-id-list = ""
     2269     then do :
     2270       run write-to-log in p-log-handle ( "Нет внешней системы с методом доставки 1C-RN." ) .
     2271       return .
     2272     end.
     2273     if  context_begin-esys-command( input v-esys-id-list, input-output v-esys-cmd-proc-handle, output v-esys-cmd-code) = false
     2274     then do:
     2275       undo _main, return error v-last-error-message .
     2276     end.
     2277     if ExpData1:esys-add-dump-data ( input p-data,
     2278                                      input v-esys-cmd-proc-handle,
     2279                                      input v-esys-cmd-code,
     2280                                      ('+update' + chr(4) + entry(1,p-init-sec-tag,chr(4))  +
     2281                                       (if num-entries(p-init-sec-tag,chr(4)) > 1
     2282                                        then substitute("&1&2&3&4",
     2283                                                        chr(4),
     2284                                                        entry(2,p-init-sec-tag,chr(4))
     2285                                                        )
     2286                                        else "")) ) = false
     2287     then do:
     2288       undo _main, return error v-last-error-message .
     2289     end.
     2290     v-dump-ord-int64 = context_send-esys-command( input v-esys-id-list
     2291                                 , input v-esys-cmd-proc-handle
     2292                                 , input v-esys-cmd-code
     2293                                 , input g#userid).
     2294     if v-dump-ord-int64 = 0
     2295     then do:
     2296       undo _main, return error v-last-error-message .
     2297     end.
     2298         num-rec-ok = num-rec-ok + 1.
     2299           ExpData1:Route-data_clear-data ( ) .
     2300   end.
     2301   end procedure.
