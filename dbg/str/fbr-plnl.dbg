        1   define input parameter p-mode       as character    no-undo.
        2   define input parameter p-doc-code   as character    no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "АРМ Ресторан. Редактирование строки документа план-меню или счет-заказа.".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   DEFINE BUTTON b-exit
      115        LABEL "&Выход"
      116        SIZE 10 BY 1
      117        BGCOLOR 8 .
      118   DEFINE BUTTON b-help
      119        LABEL "Помощ&ь"
      120        SIZE 10 BY 1
      121        BGCOLOR 8 .
      122   DEFINE BUTTON b-recipe
      123        IMAGE-UP FILE "btn-down-arrow":U
      124        IMAGE-DOWN FILE "btn-down-arrow":U
      125        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      126        LABEL ""
      127        SIZE 3 BY .88.
      128   DEFINE VARIABLE ed-goods AS CHARACTER
      129        VIEW-AS EDITOR
      130        SIZE 37.25 BY 2.58
      131        FGCOLOR 4  NO-UNDO.
      132   DEFINE VARIABLE fi-qnty AS DECIMAL FORMAT ">>,>>>,>>9.99":U INITIAL 0
      133        LABEL "Количество"
      134        VIEW-AS FILL-IN
      135        SIZE 14 BY 1 NO-UNDO.
      136   DEFINE VARIABLE fi-recipe AS CHARACTER FORMAT "X(25)":U
      137        LABEL "Рецепт"
      138        VIEW-AS FILL-IN
      139        SIZE 14 BY 1 NO-UNDO.
      140   DEFINE FRAME Dialog-Frame
      141        b-help AT ROW 1.13 COL 37
      142        b-exit AT ROW 1.17 COL 2
      143        ed-goods AT ROW 2.38 COL 9.75 NO-LABEL
      144        fi-qnty AT ROW 5.25 COL 12.13 COLON-ALIGNED
      145        fi-recipe AT ROW 6.46 COL 12.13 COLON-ALIGNED
      146        b-recipe AT ROW 6.58 COL 28.75
      147        "Товар:" VIEW-AS TEXT
      148             SIZE 7.25 BY 1.04 AT ROW 2.38 COL 2.25
      149        SPACE(38.74) SKIP(4.40)
      150       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      151            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      152            TITLE "Редактирование строки".
      153   ASSIGN
      154          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      155          FRAME Dialog-Frame:HIDDEN           = TRUE.
      156   ASSIGN
      157          b-recipe:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      158   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      159   DO:
      160     APPLY "END-ERROR":U TO SELF.
      161   END.
      162   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      163   DO:
      164       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
      165   END.
      166   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      167   on help of frame Dialog-Frame
      168   do:
      169     run gbl/app_help.p
      170       (input this-procedure :file-name
      171       ,input ''
      172       ,input ?
      173       ) no-error.
      174     if error-status :error then do:
      175       message
      176         "Ошибка при вызове помощи"
      177         error-status :get-message(1)
      178         view-as alert-box .
      179     end.
      180   end.
      181   run minbtn-set in this-procedure .
      182   on choose of b-help in frame Dialog-Frame
      183   do:
      184     apply "help":u to frame Dialog-Frame .
      185   end.
      186   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      187   procedure minbtn-set :
      188       do
      189           on error undo, return error return-value
      190           :
      191           define variable ii              as integer       no-undo .
      192           define variable fh              as widget-handle no-undo .
      193           define variable hh              as widget-handle no-undo .
      194           define variable v-h             as handle        extent 4 no-undo .
      195           define variable v-name-button   as character     no-undo .
      196           define variable v-help-old-x    as decimal       no-undo .
      197           define variable v-help-old-y    as decimal       no-undo .
      198           define variable v-help-old-size as decimal       no-undo .
      199           define variable v-frame-width   as decimal       no-undo .
      200           define variable jj              as integer       no-undo .
      201           do
      202               on error undo, return error
      203               :
      204               assign
      205                   v-frame-width = frame Dialog-Frame:width - 0.3
      206                   fh            = frame Dialog-Frame:first-child
      207                   hh            = fh:first-child
      208                   ii            = 1
      209                   .
      210               do while valid-handle(hh):
      211                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      212                   do:
      213                       case lc(hh:name) :
      214                           when "b-help" then
      215                               do:
      216                                   hh:load-image-up("cmp/b-help.bmp":u) .
      217                                   hh:load-image-down("cmp/b-help.bmp":u) .
      218                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      219                                   hh:TOOLTIP = "Помощь" .
      220                                   v-help-old-x = hh:column .
      221                                   v-help-old-y = hh:row    .
      222                                   v-help-old-size = hh:width .
      223                                   hh:width-chars = 2.5 .
      224                               end.
      225                           when "b-print" then
      226                               do:
      227                                   hh:load-image("cmp/b-print.bmp":u) .
      228                                   hh:TOOLTIP = "Печать" .
      229                                   v-h[ii] = hh:handle .
      230                                   ii = ii + 1 .
      231                                   hh:width-chars = 3 .
      232                               end.
      233                           when "b-history" or
      234                           when "b-hist" then
      235                               do:
      236                                   hh:load-image("cmp/b-hist.bmp":u) .
      237                                   hh:TOOLTIP = "История" .
      238                                   v-h[ii] = hh:handle .
      239                                   ii = ii + 1 .
      240                                   hh:width-chars = 3 .
      241                               end.
      242                           when "b-sch" then
      243                               do:
      244                                   hh:load-image("cmp/b-sch.bmp":u) .
      245                                   hh:TOOLTIP = "Установка Фильтра" .
      246                                   v-h[ii] = hh:handle .
      247                                   ii = ii + 1 .
      248                                   hh:width-chars = 3 .
      249                               end.
      250                           when "b-hist-user" then
      251                               do:
      252                                   hh:load-image("cmp/b-hist.bmp":u) .
      253                                   hh:TOOLTIP = "История пользователя" .
      254                                   ii = ii + 1 .
      255                               end.
      256                       end case.
      257                   end.
      258                   hh = hh:next-sibling.
      259               end.
      260               b-help:column = v-frame-width - b-help:width-chars.
      261               jj = 0.
      262               repeat ii = 4 to 1 by -1 :
      263                   if valid-handle (v-h[ii] ) then
      264                   do:
      265                       jj  = jj + 1 .
      266                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      267                       v-h[ii]:row    = v-help-old-y .
      268                   end.
      269               end.
      270           end.
      271       end.
      272   end procedure.
      273   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      274   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      275   MAIN-BLOCK:
      276   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      277      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      278       case p-mode
      279       :
      280           when 'ДОБАВЛЕНИЕ':U
      281           then do:
      282           end.
      283           when 'ИЗМЕНЕНИЕ':U
      284           then do:
      285           end.
      286           when 'ПРОСМОТР':U
      287           then do:
      288           end.
      289       end case.
      290       RUN enable_UI.
      291       WAIT-FOR GO OF FRAME Dialog-Frame.
      292   END.
      293   RUN disable_UI.
      294   PROCEDURE disable_UI :
      295     HIDE FRAME Dialog-Frame.
      296   END PROCEDURE.
      297   PROCEDURE enable_UI :
      298     DISPLAY ed-goods fi-qnty fi-recipe
      299         WITH FRAME Dialog-Frame.
      300     ENABLE b-help b-exit fi-qnty fi-recipe
      301         WITH FRAME Dialog-Frame.
      302     VIEW FRAME Dialog-Frame.
      303   END PROCEDURE.
