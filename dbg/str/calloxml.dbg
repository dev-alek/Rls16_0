        1   block-level on error undo, throw.
        2   define input parameter p-action     as character        no-undo.
        3   define input parameter p-tbl-name   like ub.esys-route.esr-name-rec no-undo .
        4   define input parameter p-tbl-handle as handle           no-undo .
        5   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo initial "$Workfile: calloxml.p $":U .
        9   define variable vss-archive     as character no-undo initial "$Archive: str/calloxml.p $":U .
       10   define variable vss-description as character no-undo initial "Маршрутизация OpenXML":U .
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29       assign
       30         p-vss-parameters = substitute('&1|&2',p-tbl-name,p-tbl-handle)
       31       .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74       define variable v-cur-db-num        as integer      no-undo.
       75       define variable v-ext-sys-id-list   as character    no-undo.
       76       define buffer buf_datatype-table        for ub.datatype-table.
       77       define buffer buf_datatype-table-exp    for ub.datatype-table-exp.
       78       define buffer buf_ext-system            for ub.ext-system.
       79       define buffer buf_esys-datatype-exp     for ub.esys-datatype-exp.
       80       define buffer buf_BatchProcess          for ub.BatchProcess.
       81   do
       82   for buf_datatype-table
       83     , buf_datatype-table-exp
       84     , buf_esys-datatype-exp
       85     , buf_ext-system
       86     , buf_BatchProcess
       87   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       88   :
       89       find first buf_datatype-table no-lock
       90            where buf_datatype-table.dtt-name = p-tbl-name
       91       no-error.
       92       if available buf_datatype-table
       93       then do:
       94           assign
       95               v-ext-sys-id-list = "":U
       96           .
       97   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       98   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
       99     (output v-cur-db-num
      100     )  .
      101           for each buf_datatype-table-exp no-lock
      102              where buf_datatype-table-exp.dtt-name = buf_datatype-table.dtt-name
      103           on error undo, return error
      104           :
      105                   for each buf_esys-datatype-exp no-lock
      106                      where buf_esys-datatype-exp.db-num    = v-cur-db-num
      107                        and buf_esys-datatype-exp.dte-id    = buf_datatype-table-exp.dte-id
      108                   on error undo, return error
      109                   :
      110                           for each buf_ext-system no-lock
      111                              where buf_ext-system.esys-id = buf_esys-datatype-exp.esys-id
      112                                and buf_ext-system.db-num  = buf_esys-datatype-exp.db-num
      113                           on error undo, return error
      114                           :
      115                               if buf_ext-system.esys-type = integer('0':U)
      116                               and ( buf_ext-system.esys-status = -1
      117                                  or buf_ext-system.esys-status = 1 )
      118                               then do:
      119     find first buf_BatchProcess exclusive-lock
      120       where buf_BatchProcess.bp_type   = 'oxmlnew':U
      121         and buf_BatchProcess.bp_status = 'N':U
      122         and  buf_BatchProcess.key#_one  = buf_ext-system.esys-id
      123         and buf_BatchProcess.key#_two = buf_ext-system.db-num
      124     no-error .
      125                                   if available buf_BatchProcess
      126                                   then do:
      127                                       undo, return error
      128                                           substitute( "Идёт инициализация внешней системы '&3'&1&2 записи возможно только после завершения инициализации."
      129                                               , chr(10)
      130                                               , ( if p-action = 'delete':U then "Удаление" else "Изменение" )
      131                                               , buf_ext-system.esys-name
      132                                           ).
      133                                   end.
      134                                   assign
      135                                       v-ext-sys-id-list = substitute( "&1&2&3":U
      136                                                               , v-ext-sys-id-list
      137                                                               , ( if v-ext-sys-id-list = "":U then "":U else chr(1) )
      138                                                               , buf_ext-system.esys-id
      139                                                           )
      140                                   .
      141                               end.
      142                           end.
      143                   end.
      144           end.
      145           if v-ext-sys-id-list <> "":U
      146           then do:
      147               run nws/cr-route.p (
      148                     input substitute( "&1,&2", 'send-tbl-oxml':U, p-action )
      149                   , input p-tbl-name
      150                   , input p-tbl-handle
      151                   , input v-ext-sys-id-list
      152               ) no-error.
      153               if error-status :error
      154               then do:
      155                   return error return-value.
      156               end.
      157           end.
      158       end.
      159   end.
