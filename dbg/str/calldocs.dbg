      237     define variable v-cntxp-ret-pay         like ub.store.ret-pay         no-undo.
      238     define variable v-cntxp-ret-sup-pay     like ub.store.ret-sup-pay     no-undo.
      239     define variable v-cntxp-down-pay        like ub.store.down-pay        no-undo.
