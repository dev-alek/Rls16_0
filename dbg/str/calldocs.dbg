     8635       define variable  parameter-7-77 as character no-undo .
     8636         assign
     8637         parameter-3-77 =
     8638                                 "FOR EACH c-t-doc"
     8639         parameter-4-77 =
     8640           (
     8641             if (" c-t-doc.doc-code = parext-doc-type " + " " + where-phrase-77) <> ""
     8642             then  substitute ( '        c-t-doc.doc-code = &1&2&1       ', chr(34) ,  parext-doc-type )  + " " + where-phrase-77
     8643             else "true"
     8644           )
     8645         parameter-5-77 = (" " + "" + " " + "")
     8646         parameter-6-77 = if sort-phrase-77 = ''
     8647                              then
     8648           (
     8649           " " + " " +
     8650             " " + sort-column-phrase +
     8651           " " + "  "
     8652           )
     8653                              else
     8654           (
     8655           " " + " " +
     8656             " " + sort-column-phrase +
     8657           " " + sort-phrase-77
     8658           )
     8659         parameter-7-77 =
     8660           " indexed-reposition  "
     8661       .
     8662       do
     8663       on stop undo, leave
     8664       on error undo, leave
     8665       :
     8666         assign
     8667           l-disable-where-77 =
     8668             (" c-t-doc.doc-code = parext-doc-type " + " " + where-phrase-77 = "")
     8669         .
     8670         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     8671                             ,input query br-docs:handle
     8672                             ,input parameter-3-77
     8673                             ,input parameter-4-77
     8674                             ,input parameter-5-77
     8675                             ,input parameter-6-77
     8676                             ,input parameter-7-77
     8677                             )
     8678         .
     8679         assign
     8680           l-filter-open-77 = true
     8681         .
     8682       end.
     8683       if l-filter-open-77 = false then do:
     8684         message
     8685           "Ошибка при фильтрации / сортировке" skip
     8686           "Будут показаны записи без учета фильтра" skip
     8687           view-as alert-box .
     8688       end.
     8689       else do:
     8690           assign
     8691             l-query-was-opened = true
     8692           .
     8693       end.
     8694     end.
     8695     if l-filter-open-77 = false then do:
     8696       OPEN QUERY br-docs FOR EACH c-t-doc
     8697         where  c-t-doc.doc-code = parext-doc-type
     8698         indexed-reposition
     8699     .
     8700         assign
     8701           l-query-was-opened = true
     8702         .
     8703     end.
     8704   end.
     8705   else do:
     8706     assign
     8707       doc-rec = recid( c-t-doc )
     8708     .
     8709     do
     8710     on stop undo, leave
     8711     on error undo, leave
     8712     :
     8713       if query br-docs:handle:get-buffer-handle(1) = (buffer c-t-doc:handle) then do:
     8714         assign
     8715         parameter-2-77 = (if p-find-next then "true":u else "false":u )
     8716         parameter-4-77 =
     8717           "where ":u +  substitute ( '        c-t-doc.doc-code = &1&2&1       ', chr(34) ,  parext-doc-type )  + " ":u + where-phrase-77 + " ":u + p-find-condition + " " + ""
     8718         parameter-5-77 = " "
     8719       .
     8720         run fltopend_fltfindd in this-procedure  (
     8721                             input this-procedure:handle
     8722                             ,input query br-docs:handle
     8723                             ,input rowid(c-t-doc)
     8724                             ,input logical(parameter-2-77)
     8725                             ,input no-lock
     8726                             ,input (buffer c-t-doc:handle)
     8727                             ,input parameter-4-77
     8728                             ,input parameter-5-77
     8729                             ) no-error.
     8730         .
     8731         assign
     8732           doc-rec = integer(return-value)
     8733           v-fltopend-rowid[1] = ?
     8734         .
     8735       end.
     8736       else do:
     8737         assign
     8738         parameter-2-77 = (if p-find-next then "true":u else "false":u )
     8739         parameter-3-77 =  "FOR EACH c-t-doc"
     8740         parameter-4-77 =
     8741           (
     8742             if (" c-t-doc.doc-code = parext-doc-type " + " " + where-phrase-77) <> ""
     8743             then  substitute ( '        c-t-doc.doc-code = &1&2&1       ', chr(34) ,  parext-doc-type )  + " " + where-phrase-77
     8744             else "true"
     8745           )
     8746         parameter-5-77 = (" " + "" + " " + "" + " " + p-find-condition)
     8747         parameter-6-77 = if sort-phrase-77 = ''
     8748                              then
     8749           (
     8750           " " + " " +
     8751             " " + sort-column-phrase +
     8752           " " + "  "
     8753           )
     8754                              else
     8755           (
     8756           " " + " " +
     8757             " " + sort-column-phrase +
     8758           " " + sort-phrase-77
     8759           )
     8760         parameter-7-77 =
     8761           " indexed-reposition  "
     8762       .
     8763         run fltopend_fltfindq in this-procedure  (
     8764                             input this-procedure:handle
     8765                             ,input query br-docs:handle
     8766                             ,input logical(parameter-2-77)
     8767                             ,input no-lock
     8768                             ,input parameter-3-77
     8769                             ,input parameter-4-77
     8770                             ,input parameter-5-77
     8771                             ,input parameter-6-77
     8772                             ,input parameter-7-77
     8773                             ,output v-fltopend-rowid
     8774                             ) no-error.
     8775         .
     8776         doc-rec = ?.
     8777       end.
     8778       assign
     8779         l-query-was-opened = true
     8780       .
     8781     end.
     8782   end.
     8783     run waitfram-hide in this-procedure .
     8784     end.
     8785   end case.
     8786   if parlist-mode <> 'doc':U then do:
     8787     assign frame d-calldocs :title = frame d-calldocs :title + " (межфирменные перемещения)".
     8788   end.
     8789   end procedure.
