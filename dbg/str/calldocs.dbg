      247     define variable v-cntxp-obj-type        like ub.clients.obj-type      no-undo.
      248     define variable v-cntxp-obj-code        like ub.clients.obj-code      no-undo.
      249     define variable v-cntxp-db-num          as integer   no-undo .
      250     define variable v-cntxp-userid          as character no-undo .
      251     define variable v-cntxp-level           as character no-undo .
      252     define variable v-cntxp-db-num-obj      as integer   no-undo .
      253     define variable v-cntxp-is-admin        as logical   no-undo .
      254     define buffer bf-cntxp_store for ub.store.
      255     define buffer bf-cntxp_shop  for ub.shop.
      256     define buffer bf-cntxp_sysconf for ub.sysconf.
      257   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      258     run mainmenu_getcntxt in parparentproc
      259       (output v-cntxp-db-num
      260       ,output v-cntxp-userid
      261       ,output v-cntxp-level
      262       ,output v-cntxp-curr-host-code
      263       ,output v-cntxp-obj-type
      264       ,output v-cntxp-obj-code
      265       ,output v-cntxp-db-num-obj
      266       ,output v-cntxp-is-admin
      267       ) .
      268     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
      269        v-cntxp-obj-code <> 0 then do:
      270   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      271     (input  'is-prt'
      272     ,input  0
      273     ,input  ''
      274     ,input  0
      275     ,input  ''
      276     ,input  ''
      277     ,input  ''
      278     ,input  yes
      279     ,output v-cntxp-conf-par
      280     ,output v-cntxp-par-type
      281     ) no-error .
      282       case v-cntxp-obj-type :
      283         when 'скл':U then do:
      284           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
      285           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
      286           assign
      287             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_store.doc-prt
      288             v-cntxp-price-calc      = bf-cntxp_store.price-calc
      289             v-cntxp-inout-price     = bf-cntxp_store.inout-price
      290             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
      291             v-cntxp-out-rate        = bf-cntxp_store.out-rate
      292             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
      293             v-cntxp-in-ov           = bf-cntxp_store.in-ov
      294             v-cntxp-in-perm         = bf-cntxp_store.in-perm
      295             v-cntxp-no-eq           = bf-cntxp_store.no-eq
      296             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
      297             v-cntxp-load-time       = bf-cntxp_store.load-time
      298             v-cntxp-holidays        = bf-cntxp_store.holidays
      299             v-cntxp-in-pay          = bf-cntxp_store.in-pay
      300             v-cntxp-out-pay         = bf-cntxp_store.out-pay
      301             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
      302             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
      303             v-cntxp-down-pay        = bf-cntxp_store.down-pay
      304             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
      305             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
      306             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      307             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      308             .
      309         end.
      310         when 'маг':U then do:
      311           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
      312           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
      313           assign
      314             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
      315             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
      316             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
      317             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
      318             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
      319             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
      320             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
      321             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
      322             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
      323             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
      324             v-cntxp-load-time       = bf-cntxp_shop.load-time
      325             v-cntxp-holidays        = bf-cntxp_shop.holidays
      326             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
      327             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
      328             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
      329             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
      330             v-cntxp-down-pay        = bf-cntxp_shop.down-pay
      331             v-cntxp-inv-pay         = bf-cntxp_shop.inv-pay
      332             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
      333             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      334             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      335             .
      336         end.
      337       end case.
      338     end.
      339   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      340   define variable v-waitfram-action01         as character   no-undo .
      341   define variable v-waitfram-action02         as character   no-undo .
      342   define variable v-waitfram-action03         as character   no-undo .
      343   define variable mWaitFramTextBeg            as character   no-undo.
      344   define variable mWaitFramTextEnd            as character   no-undo.
      345   define variable mWaitFramView               as logical     no-undo.
      346   define variable mWaitProcEvent              as logical     no-undo init yes.
      347   define variable mWaitFramInterval           as integer     no-undo init 1 .
      348   define variable mWaitFramStop               as logical     no-undo.
      349   define variable mWaitFramStopUser           as logical     no-undo.
      350   define variable mWaitFramStopTimeOut        as logical     no-undo.
      351   define variable mWaitFramStartProc          as datetime-tz no-undo.
      352   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      353   define button B-WaitFramStop auto-end-key
      354        label "Стоп"
      355        size 10 by 1 tooltip "Остоновить процесс".
      356   define button B-viewProcInfo
      357        label "Информация"
      358        size 15 by 1 tooltip "Информация о процесс".
      359   define frame waitfram
      360     v-waitfram-action01 format "x(72)" no-label skip
      361     v-waitfram-action02 format "x(72)" no-label skip
      362     v-waitfram-action03 format "x(72)" no-label skip
      363     B-viewProcInfo
      364     B-WaitFramStop at row 4 col 30
      365     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      366     .
      367   define new global shared variable mBatchMode as logical no-undo init ?.
      368   define variable mFramBachModHandle as handle no-undo.
      369   mFramBachModHandle = frame waitfram:handle.
      370   define variable mFameOldVis as logical no-undo.
      371   define variable mVisCUrentVin as logical no-undo.
      372   if session:batch-mode
      373   then
      374      mBatchMode = yes.
      375   if mBatchMode = ? then do:
      376     mVisCUrentVin = current-window:visible.
      377     mFameOldVis = mFramBachModHandle:visible.
      378     mFramBachModHandle:visible  = yes.
      379     mBatchMode = mFramBachModHandle:visible ne yes.
      380     mFramBachModHandle:visible = mFameOldVis.
      381     current-window:visible = mVisCUrentVin.
      382   end.
      383    if  log-manager:logfile-name ne ?
      384     then DO:
      385         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      386         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      387         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      388     end.
      389   on choose of B-WaitFramStop in frame waitfram
      390   do:
      391     mWaitFramStop = yes.
      392     mWaitFramStopUser = yes.
      393   end.
      394   function waitfram-check-timeout returns logical():
      395      define variable vtime as int64 no-undo.
      396      if mWaitFramStopTimeOut
      397      then
      398         return yes.
      399      vtime = ( now - mWaitFramStartProc ) / 1000 .
      400      if     mWaitFramTimeOut ne ?
      401         and mWaitFramTimeOut ne 0
      402         and mWaitFramTimeOut lt vtime
      403      then do:
      404         mWaitFramStopTimeOut = yes.
      405      end.
      406      return mWaitFramStopTimeOut.
      407   end.
      408   procedure waitfram-hide :
      409     if not session:batch-mode
      410     then do
      411     on error undo, return error return-value
      412     :
      413       pause 0 before-hide .
      414       if not mBatchMode then
      415         hide frame waitfram .
      416     if     not mWaitFramView
      417        and mWaitProcEvent
      418     then
      419       process events .
      420     end.
      421   end procedure.
      422   procedure waitfram-show :
      423     define input  parameter p-message as character no-undo .
      424     define variable v-left-margin as integer   no-undo .
      425     if not session:batch-mode
      426     then do
      427     on error undo, return error return-value
      428     :
      429       if length(p-message) <= 70 then do:
      430         assign
      431           v-left-margin = integer((70 - length(p-message)) / 2)
      432         .
      433         assign
      434           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      435         .
      436         assign
      437           v-waitfram-action01 = " "
      438           v-waitfram-action02 = " "
      439                                    + fill(" ", v-left-margin)
      440                                    + p-message
      441           v-waitfram-action03 = " "
      442         .
      443       end.
      444       else do:
      445         define variable vRindex1 as integer no-undo.
      446         define variable vRindex2 as integer no-undo.
      447         vRindex1 = r-index(p-message," ",70).
      448         if vRindex1 = 0
      449         then
      450            vRindex1 = 70.
      451         if length(p-message)  <= vRindex1 + 70 then do:
      452           assign
      453             v-waitfram-action01 = " "
      454             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      455             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      456           .
      457         end.
      458         else do:
      459           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      460           if vRindex2 <= vRindex1
      461           then
      462              vRindex2 = vRindex1 + 70.
      463           assign
      464             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      465             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      466             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      467           .
      468         end.
      469       end.
      470       B-viewProcInfo:visible   in frame waitfram = no.
      471       B-viewProcInfo:sensitive in frame waitfram = no.
      472       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      473       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      474       if  (   mWaitFramView
      475          or  mWaitProcEvent)
      476          and not mBatchMode
      477       then
      478          display
      479             v-waitfram-action01 skip
      480             v-waitfram-action02 skip
      481             v-waitfram-action03 skip
      482          with frame waitfram .
      483       if     mWaitFramView
      484          then do:
      485             if     mWaitFramInterval ne ?
      486                and not mBatchMode
      487             then
      488                wait-for go of frame waitfram pause mWaitFramInterval.
      489          end.
      490          else
      491             if     mWaitProcEvent
      492                and not mBatchMode
      493             then
      494                process events .
      495     end.
      496   end procedure.
      497      procedure waitfram-show-this:
      498         define input  parameter iInterval as int64 no-undo.
      499         define variable vtime as int64 no-undo.
      500         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      501         mWaitFramInterval = iInterval.
      502         run waitfram-show (substitute("&1&2 &3&4" ,
      503                                       mWaitFramTextBeg ,
      504                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      505                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      506                                       mWaitFramTextEnd
      507                                      )
      508                           ).
      509      end.
      510      procedure WaitFramRunPause:
      511         define input  parameter iInterval as dec no-undo.
      512         define variable vStart  as datetime-tz no-undo.
      513         define variable vend    as datetime-tz no-undo.
      514         define variable vint as int64 no-undo.
      515         define variable vOk as logical no-undo.
      516         vStart = now.
      517         vend   = vStart.
      518         publish "WaitFramPause" (iInterval,output vOk).
      519         vend   =  now.
      520         vint = vend - vStart.
      521         vint = iInterval - vint / 1000.
      522         if     not mWaitFramStop
      523            and (   vint > 0
      524                 or (    not vOk
      525                     and iInterval eq ?
      526                     )
      527                 )
      528         then
      529            run waitfram-show-this (iInterval).
      530         vend   =  now.
      531         vint = vend - vStart.
      532         vint = iInterval - vint / 1000.
      533         if     not mWaitFramStop
      534            and vint > 0
      535         then do:
      536            run gbl/pause.p (vint * 1000).
      537         end.
      538         if iInterval ne ?
      539         then
      540            publish "WaitFramStop".
      541         waitfram-check-timeout().
      542      end.
      543      procedure WaitFramWaitFor:
      544         define input  parameter iInterval as dec no-undo.
      545         assign
      546            mWaitFramStartProc   = now
      547            mWaitFramStopUser    = no
      548            mWaitFramStopTimeOut = no
      549         .
      550         block-wait:
      551         do while not mWaitFramStop:
      552            run WaitFramRunPause (iInterval).
      553            if  waitfram-check-timeout()
      554            then do:
      555               leave block-wait.
      556            end.
      557         end.
      558         run waitfram-hide.
      559      end.
      560   procedure waitfram-join :
      561     define input  parameter p-line-1  as character no-undo .
      562     define input  parameter p-line-2  as character no-undo .
      563     define input  parameter p-line-3  as character no-undo .
      564     define output parameter p-message as character no-undo .
      565     do
      566     on error undo, return error return-value
      567     :
      568       assign
      569         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      570                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      571                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      572       .
      573     end.
      574   end procedure.
      575   function waitfram-join-function returns character
      576     (input p-line-1 as character
      577     ,input p-line-2 as character
      578     ,input p-line-3 as character
      579     ).
      580     define variable v-message as character no-undo .
      581     run waitfram-join in this-procedure
      582       (input  p-line-1
      583       ,input  p-line-2
      584       ,input  p-line-3
      585       ,output v-message
      586       ) .
      587     return v-message .
      588   end function .
      589   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      590   function usrfulnf returns character ( input p-user-id as character):
      591   define variable v-user-name as character no-undo .
      592   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      593   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      594     (input  p-user-id
      595     ,output v-user-name
      596     ) no-error .
      597   if error-status:error
      598   or v-user-name = ""
      599   then do:
      600     return p-user-id.
      601   end.
      602   else do:
      603     return v-user-name.
      604   end.
      605   end function.
