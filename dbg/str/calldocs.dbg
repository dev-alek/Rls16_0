     8888   procedure make-gen-button :
     8889     do
     8890     on error undo, return error return-value
     8891     :
     8892       if parlist-mode = 'doc':U then return .
     8893       define variable  but-gen  as widget-handle.
     8894       create button but-gen
     8895       assign
     8896         row          = 1
     8897         column       = 63
     8898         HEIGHT-CHARS = 1
     8899         WIDTH-CHARS  = 10
     8900         name         = "but-gen"
     8901         label        = "Г&енерация"
     8902         tooltip      = "Генерация Фин.обязательств по удаленным накладным"
     8903         frame        = frame d-calldocs:handle
     8904         sensitive    = true
     8905         visible      = true
     8906         POPUP-MENU   = MENU POPUP-MENU-b-gen :HANDLE
     8907         MENU-MOUSE   = 1
     8908           .
     8909     end.
     8910   end procedure.
     8911   procedure make-fo-button :
     8912     do
     8913     on error undo, return error return-value
     8914     :
     8915     if parlist-mode = 'doc':U then return .
     8916     define variable  but-fo  as widget-handle.
     8917     create button but-fo
     8918     assign
     8919         row = 1
     8920         column = 73
     8921         HEIGHT-CHARS = 1
     8922         WIDTH-CHARS = 10
     8923         name = "but-fo"
     8924         label = "Фин.Об"
     8925         tooltip = "Список Фин.обязательств по накладной"
     8926         frame = frame d-calldocs:handle
     8927         sensitive = true
     8928         visible = true
     8929           triggers :
     8930             on choose persistent run list-fo in this-procedure.
     8931           end triggers.
     8932    end.
     8933   end procedure.
     8934   procedure list-fo :
     8935     do
     8936     on error undo, return error return-value
     8937     :
     8938       find current c-t-doc no-lock no-error .
     8939       if available c-t-doc then do:
     8940         run str/fi-trns.w (
     8941             input parparentproc,
     8942             input v-host-code,
     8943             input ?              ,
     8944             input c-t-doc.doc-code ,
     8945             input "trn-doc":U
     8946             ) .
     8947       end.
     8948     end.
     8949   end procedure.
     8950   procedure local-mark :
     8951     if not available c-t-doc then do:
     8952       message "Неправильный выбор строки." view-as alert-box.
     8953       return no-apply.
     8954     end.
     8955   define variable vss-include-info78 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8956   define variable v-str-recid79 as character no-undo .
     8957   define variable v-num-entry79 as integer   no-undo .
     8958   assign
     8959     v-str-recid79 = trim( string( recid( c-t-doc ) , "->>>>>>>>>>>9":U ) )
     8960     v-num-entry79 = lookup( v-str-recid79 , mark-list )
     8961   .
     8962   if v-num-entry79 > 0 then do:
     8963     assign
     8964       entry( v-num-entry79, mark-list ) = "":U
     8965       mark-list = trim( replace( mark-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     8966     .
     8967   end.
     8968   else do:
     8969     assign
     8970       mark-list = mark-list + ( if mark-list = "":U then "":U else chr(44) ) + v-str-recid79
     8971     .
     8972   end.
     8973     br-docs :refresh() in frame d-calldocs.
     8974     apply "entry" to br-docs in frame d-calldocs.
     8975   end procedure.
     8976   procedure proc-m_gen-1 :
     8977     do
     8978     on error undo, return error return-value
     8979     :
     8980       if num-entries(mark-list) = 0 then do:
     8981         message "Не выделено ни одной накладной для генерации финансовых обязательств !" view-as alert-box .
     8982         return error .
     8983       end.
     8984       run str/gen-fl.w (
     8985           input parparentproc,
     8986           input v-host-code,
     8987           input mark-list,
     8988           input "del"
     8989       )   .
     8990       assign
     8991         mark-list = ""
     8992         .
     8993       run OpenBr in this-procedure ( input yes, input no, input no ).
     8994     end.
     8995   end procedure.
     8996   procedure proc-m_gen-2 :
     8997     define buffer bf_sysconf   for ub.sysconf.
     8998     define buffer bf_c-trn-doc for ub.c-trn-doc.
     8999     define variable vari        as integer no-undo.
     9000     define variable vardoc-code as integer no-undo.
     9001     do
     9002     on error undo, return error return-value
     9003     :
     9004       if mark-list = "" then do:
     9005         if available c-t-doc then do:
     9006           assign
     9007             mark-list = string( recid( c-t-doc ) ).
     9008         end.
     9009       end.
     9010       do vari = 1 to num-entries( mark-list ) :
     9011         assign
     9012           vardoc-code = integer( entry( vari, mark-list ) ).
     9013         find first bf_c-trn-doc exclusive-lock where recid( bf_c-trn-doc ) = vardoc-code.
     9014         find first bf_sysconf no-lock where bf_sysconf.host-code = bf_c-trn-doc.host-code.
     9015         if bf_sysconf.firm-db-num <> v-cntxt-db-num then do:
     9016           message "Главная БД для фирмы по документу с кодом " bf_c-trn-doc.doc-code " не является текущей БД." skip
     9017                   "Текущая БД: " v-cntxt-db-num skip
     9018                   "Главная БД фирмы: " bf_sysconf.firm-db-num
     9019           view-as alert-box error.
     9020           return error.
     9021         end.
     9022         if bf_c-trn-doc.cr-incfo = yes then do:
     9023           message "По документу " bf_c-trn-doc.doc-code " уже генерилось финансовое обязательство от "
     9024                   bf_c-trn-doc.incfo-date " числа."
     9025           view-as alert-box error.
     9026         end.
     9027         else do:
     9028           assign
     9029             bf_c-trn-doc.need-incfo = 0.
     9030           if bf_c-trn-doc.need-incfo = 0 and
     9031              bf_c-trn-doc.need-expfo = 0 then do:
     9032             assign
     9033               bf_c-trn-doc.need-incorexpfo = 0.
     9034           end.
     9035           reposition br-docs to recid recid( bf_c-trn-doc ) no-error.
     9036           if not error-status :error then do:
     9037             display fo-postavka( recid( bf_c-trn-doc) ) @ varpost with browse br-docs.
     9038           end.
     9039         end.
     9040       end.
     9041       assign
     9042         mark-list = "":U.
     9043     end.
     9044   end procedure.
     9045   procedure proc-m_gen-3 :
     9046     define buffer bf_sysconf   for ub.sysconf.
     9047     define buffer bf_c-trn-doc for ub.c-trn-doc.
     9048     define variable vari        as integer no-undo.
     9049     define variable vardoc-code as integer no-undo.
     9050     do
     9051     on error undo, return error return-value
     9052     :
     9053       if mark-list = "" then do:
     9054         if available c-t-doc then do:
     9055           assign
     9056             mark-list = string( recid( c-t-doc ) ).
     9057         end.
     9058       end.
     9059       do vari = 1 to num-entries( mark-list ) :
     9060         assign
     9061           vardoc-code = integer( entry( vari, mark-list ) ).
     9062         find first bf_c-trn-doc exclusive-lock where recid( bf_c-trn-doc ) = vardoc-code.
     9063         find first bf_sysconf no-lock where bf_sysconf.host-code = bf_c-trn-doc.host-code.
     9064         if bf_sysconf.firm-db-num <> v-cntxt-db-num then do:
     9065           message "Главная БД для фирмы по документу с кодом " bf_c-trn-doc.doc-code " не является текущей БД." skip
     9066                   "Текущая БД: " v-cntxt-db-num skip
     9067                   "Главная БД фирмы: " bf_sysconf.firm-db-num
     9068           view-as alert-box error.
     9069           return error.
     9070         end.
     9071         if bf_c-trn-doc.cr-expfo = yes then do:
     9072           message "По документу " bf_c-trn-doc.doc-code " уже генерилось финансовое обязательство от "
     9073                   bf_c-trn-doc.expfo-date " числа."
     9074           view-as alert-box error.
     9075         end.
     9076         else do:
     9077           assign
     9078             bf_c-trn-doc.need-expfo = 0.
     9079           if bf_c-trn-doc.need-incfo = 0 and
     9080              bf_c-trn-doc.need-expfo = 0 then do:
     9081             assign
     9082               bf_c-trn-doc.need-incorexpfo = 0.
     9083           end.
     9084           reposition br-docs to recid recid( bf_c-trn-doc ) no-error.
     9085           if not error-status :error then do:
     9086             display fo-postavka( recid( bf_c-trn-doc )) @ varpost with browse br-docs.
     9087           end.
     9088         end.
     9089       end.
     9090       assign
     9091         mark-list = "":U.
     9092     end.
     9093   end procedure.
     9094   procedure proc-m_gen-4 :
     9095     define buffer bf_sysconf   for ub.sysconf.
     9096     define buffer bf_c-trn-doc for ub.c-trn-doc.
     9097     define variable vari        as integer no-undo.
     9098     define variable vardoc-code as integer no-undo.
     9099     define variable varcr-incfo as logical no-undo.
     9100     define variable varinc-exp  as integer no-undo.
     9101     define buffer buf_parts    for ub.parts.
     9102     define buffer buf_contract for ub.contract.
     9103     do
     9104     on error undo, return error return-value
     9105     :
     9106       if mark-list = "" then do:
     9107         if available c-t-doc then do:
     9108           assign
     9109             mark-list = string( recid( c-t-doc ) ).
     9110         end.
     9111       end.
     9112       vari-cycle:
     9113       do vari = 1 to num-entries( mark-list ) :
     9114         assign
     9115           vardoc-code = integer( entry( vari, mark-list ) ).
     9116         find first bf_c-trn-doc exclusive-lock where recid( bf_c-trn-doc ) = vardoc-code.
     9117         find first bf_sysconf no-lock where bf_sysconf.host-code = bf_c-trn-doc.host-code.
     9118         if bf_sysconf.firm-db-num <> v-cntxt-db-num then do:
     9119           message "Главная БД для фирмы по документу с кодом " bf_c-trn-doc.doc-code " не является текущей БД." skip
     9120                   "Текущая БД: " v-cntxt-db-num skip
     9121                   "Главная БД фирмы: " bf_sysconf.firm-db-num
     9122           view-as alert-box error.
     9123           return error.
     9124         end.
     9125         if bf_c-trn-doc.cr-incfo = yes then do:
     9126           assign
     9127             varlog = no.
     9128           message "По документу " bf_c-trn-doc.doc-code " было создано финансовое обязательство от " bf_c-trn-doc.incfo-date " ." skip
     9129                   "Вы действительно хотите снять признак, что по этому документу было создано фин. обязательство?"
     9130           view-as alert-box question buttons yes-no update varlog.
     9131           if varlog <> yes then do:
     9132             next vari-cycle.
     9133           end.
     9134           assign
     9135             bf_c-trn-doc.cr-incfo   = no
     9136             bf_c-trn-doc.incfo-date = 01/01/1990.
     9137           if bf_c-trn-doc.cr-incfo = no and
     9138              bf_c-trn-doc.cr-expfo = no then do:
     9139             assign
     9140               bf_c-trn-doc.cr-incorexpfo = no.
     9141           end.
     9142           reposition br-docs to recid recid( bf_c-trn-doc ) no-error.
     9143           if not error-status :error then do:
     9144             display fo-postavka( recid( bf_c-trn-doc) ) @ varpost with browse br-docs.
     9145           end.
     9146         end.
     9147       end.
     9148       assign
     9149         mark-list = "":U.
     9150     end.
     9151   end procedure.
     9152   procedure proc-m_gen-5 :
     9153     define buffer bf_sysconf   for ub.sysconf.
     9154     define buffer bf_c-trn-doc for ub.c-trn-doc.
     9155     define variable vari        as integer no-undo.
     9156     define variable vardoc-code as integer no-undo.
     9157     define variable varcr-expfo as logical no-undo.
     9158     define variable varinc-exp  as integer no-undo.
     9159     define buffer buf_parts    for ub.parts.
     9160     define buffer buf_contract for ub.contract.
     9161     do
     9162     on error undo, return error return-value
     9163     :
     9164       if mark-list = "" then do:
     9165         if available c-t-doc then do:
     9166           assign
     9167             mark-list = string( recid( c-t-doc ) ).
     9168         end.
     9169       end.
     9170       vari-cycle:
     9171       do vari = 1 to num-entries( mark-list ) :
