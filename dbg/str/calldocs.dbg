      920   function first-symb-type returns character ( p-rec as recid ) :
      921   def buffer loc-c-t-doc for ub.c-trn-doc .
      922   find first loc-c-t-doc no-lock where recid(loc-c-t-doc) = p-rec no-error . if error-status :error then return "" .
      923     return ( substring( loc-c-t-doc.doc-type, 1, 1 ) ).
      924   end function.
      925   function day-month returns character ( p-rec as recid ) :
      926   def buffer loc-c-t-doc for ub.c-trn-doc .
      927   find first loc-c-t-doc no-lock where recid(loc-c-t-doc) = p-rec no-error . if error-status :error then return "" .
      928     return ( substring( ( string( loc-c-t-doc.doc-date ) ), 1, 5 ) ).
      929   end function.
      930   function shift-day-month returns character ( p-rec as recid ) :
      931   def buffer loc-c-t-doc for ub.c-trn-doc .
      932   find first loc-c-t-doc no-lock where recid(loc-c-t-doc) = p-rec no-error . if error-status :error then return "" .
      933     return ( substring( ( string( loc-c-t-doc.shift-date ) ), 1, 5 ) ).
      934   end function.
      935   function shift-name return char  ( p-rec as recid ) :
      936   def buffer c-loc-t-doc for ub.c-trn-doc .
      937   find first c-loc-t-doc no-lock where recid(c-loc-t-doc) = p-rec no-error . if error-status :error then return "" .
      938     if c-loc-t-doc.shift-date = ? then do:
      939       return "":u.
      940     end.
      941     else do:
      942       if c-loc-t-doc.shift-num = integer(c-loc-t-doc.shift-name) then do:
      943         return c-loc-t-doc.shift-name.
      944       end.
      945       else do:
      946         return c-loc-t-doc.shift-name + "(" + string(c-loc-t-doc.shift-num) + ")".
      947       end.
      948     end.
      949   end function.
      950   function object-label returns character ( p-rec as recid ) :
      951   def buffer loc-c-t-doc for ub.c-trn-doc .
      952   find first loc-c-t-doc no-lock where recid(loc-c-t-doc) = p-rec no-error . if error-status :error then return "" .
      953     return ( trim( loc-c-t-doc.obj-type ) + " ":U + string( loc-c-t-doc.obj-code, ">>>>9":U ) ).
      954   end function.
      955   function total-sum returns decimal ( p-rec as recid ) :
      956   def buffer loc-c-t-doc for ub.c-trn-doc .
      957   find first loc-c-t-doc no-lock where recid(loc-c-t-doc) = p-rec no-error . if error-status :error then return ? .
      958     return ( if loc-c-t-doc.print-rubl then loc-c-t-doc.tot-rubl else loc-c-t-doc.tot-doc ).
      959   end function.
      960   function total-dsc returns decimal ( p-rec as recid ) :
      961   def buffer loc-c-t-doc for ub.c-trn-doc .
      962   find first loc-c-t-doc no-lock where recid(loc-c-t-doc) = p-rec no-error . if error-status :error then return ? .
      963     if lookup( loc-c-t-doc.doc-type, 'рас,спи,возврат':U ) > 0 then do:
      964       return ( if loc-c-t-doc.print-rubl then loc-c-t-doc.discnt-rubl
      965                                          else loc-c-t-doc.tot-doc - loc-c-t-doc.tot-cli ).
      966     end.
      967     else do:
      968       return ( 0.00 ).
      969     end.
      970   end function.
      971   function total-fact returns decimal ( p-rec as recid ) :
      972   def buffer loc-c-t-doc for ub.c-trn-doc .
      973   find first loc-c-t-doc no-lock where recid(loc-c-t-doc) = p-rec no-error . if error-status :error then return ? .
      974     return ( if loc-c-t-doc.print-rubl then loc-c-t-doc.tot-sale else loc-c-t-doc.tot-fact ).
      975   end function.
      976   function total-dsc-fact returns decimal ( p-rec as recid ) :
      977   def buffer loc-c-t-doc for ub.c-trn-doc .
      978   find first loc-c-t-doc no-lock where recid(loc-c-t-doc) = p-rec no-error . if error-status :error then return ?.
      979     if lookup( loc-c-t-doc.doc-type, 'рас,спи,возврат':U ) > 0 then do:
      980       return ( if loc-c-t-doc.print-rubl then loc-c-t-doc.discnt-rubl else loc-c-t-doc.tot-calc ).
      981     end.
      982     else do:
      983       return ( 0.00 ).
      984     end.
      985   end function.
      986   function total-pay-fact returns decimal ( p-rec as recid ) :
      987   def buffer loc-c-t-doc for ub.c-trn-doc .
      988   find first loc-c-t-doc no-lock where recid(loc-c-t-doc) = p-rec no-error . if error-status :error then return ? .
      989     if loc-c-t-doc.doc-type = 'при':U and
      990        loc-c-t-doc.internal = no        then do:
      991       return ( loc-c-t-doc.tot-calc ).
      992     end.
      993     else do:
      994       return ( if loc-c-t-doc.print-rubl then ( loc-c-t-doc.tot-sale - loc-c-t-doc.discnt-rubl )
      995                                          else ( loc-c-t-doc.tot-fact - loc-c-t-doc.tot-calc    ) ).
      996     end.
      997   end function.
      998   function total-vat returns decimal ( p-rec as recid ) :
      999   def buffer loc-c-t-doc for ub.c-trn-doc .
     1000   find first loc-c-t-doc no-lock where recid(loc-c-t-doc) = p-rec no-error . if error-status :error then return ? .
     1001     return ( if loc-c-t-doc.print-rubl then loc-c-t-doc.vat-rubl else loc-c-t-doc.vat-base ).
     1002   end function.
     1003   function total-slt returns decimal ( p-rec as recid ) :
     1004   def buffer loc-c-t-doc for ub.c-trn-doc .
     1005   find first loc-c-t-doc no-lock where recid(loc-c-t-doc) = p-rec no-error . if error-status :error then return ? .
     1006     return ( if loc-c-t-doc.print-rubl then loc-c-t-doc.slt-rubl else loc-c-t-doc.slt-base ).
     1007   end function.
     1008   function fo-postavka returns character ( p-rec as recid ) :
     1009   def buffer loc-c-t-doc for ub.c-trn-doc .
     1010   find first loc-c-t-doc no-lock where recid(loc-c-t-doc) = p-rec no-error . if error-status :error then return "" .
     1011     if loc-c-t-doc.cr-incfo = yes then do:
     1012       return string( loc-c-t-doc.incfo-date, "99/99/99":U ).
     1013     end.
     1014     else do:
     1015       if loc-c-t-doc.need-incfo = 0 then do:
     1016         return "--------".
     1017       end.
     1018       if loc-c-t-doc.need-incfo = 1 then do:
     1019         return "".
     1020       end.
     1021       if loc-c-t-doc.need-incfo = 2 then do:
     1022         return "не опред".
     1023       end.
     1024     end.
     1025   end function.
     1026   function fo-realiz returns character ( p-rec as recid ) :
     1027   def buffer loc-c-t-doc for ub.c-trn-doc .
     1028   find first loc-c-t-doc no-lock where recid(loc-c-t-doc) = p-rec no-error . if error-status :error then return "" .
     1029     if loc-c-t-doc.cr-expfo = yes then do:
     1030       return string( loc-c-t-doc.expfo-date, "99/99/99":U ).
     1031     end.
     1032     else do:
     1033       if loc-c-t-doc.need-expfo = 0 then do:
     1034         return "--------".
     1035       end.
     1036       if loc-c-t-doc.need-expfo = 1 then do:
     1037         return "".
     1038       end.
     1039       if loc-c-t-doc.need-expfo = 2 then do:
     1040         return "не опред".
     1041       end.
     1042     end.
     1043   end function.
     1044   function c-holding returns logical ( p-rec as recid ) :
     1045   def buffer loc-c-t-doc for ub.c-trn-doc .
     1046   find first loc-c-t-doc no-lock where recid(loc-c-t-doc) = p-rec no-error . if error-status :error then return false  .
     1047     define variable l_holding as logical no-undo.
     1048     run get-c-holding in this-procedure ( input loc-c-t-doc.doc-code, output l_holding ) no-error.
     1049     return ( if error-status :error or l_holding <> yes then no else yes ).
     1050   end function.
     1051   define browse br-docs query br-docs no-lock display
     1052     mark-string( recid (c-t-doc) )              column-label '*'  format "x(1)"
     1053     first-symb-type( recid (c-t-doc) )              column-label 'Т'  format "x(1)"
     1054     c-t-doc.status_              column-label 'Стат'  format "x(4)"
     1055     c-t-doc.flag_              column-label 'OK'  format "+/-"
     1056     c-t-doc.doc-code              column-label 'Номер'
     1057     day-month( recid (c-t-doc) )              column-label 'Дата'  format "x(5)"
     1058     c-t-doc.fact-date              column-label 'Факт'
     1059     c-t-doc.corr-date              column-label 'Удал(корр)'
     1060     string(c-t-doc.corr-time, "HH:MM")             column-label 'Время'
     1061     c-t-doc.ship-date             column-label 'Дата'
     1062     c-t-doc.corr-user-name             column-label 'Кто'
     1063     usrfulnf(c-t-doc.user-name)        column-label "Исправил"
     1064     c-t-doc.action             column-label 'Действие'
     1065     c-t-doc.chip-num             column-label '№ изменения' format ">>>,>>>,>>9"
     1066     c-t-doc.reason-code             column-label 'Код причины'
     1067     shift-day-month( recid (c-t-doc) )              column-label 'Смена'  format "x(6)"
     1068     shift-name (recid (c-t-doc))             column-label '№' format "99"
     1069     c-t-doc.internal             column-label 'В' format "+/-"
     1070     c-t-doc.cli-name             column-label 'Контрагент' format "x(26)"
     1071     object-label( recid (c-t-doc) )             column-label 'Объект' format "x(9)"
     1072     c-t-doc.office             column-label 'У' format "+/-"
     1073     c-t-doc.doc-qnty             column-label 'Кол-во по док.'
     1074     c-t-doc.fact-qnty             column-label 'Кол-во факт'
     1075     c-t-doc.print-rubl             column-label '$' format "-/$"
     1076     total-sum( recid (c-t-doc) )             column-label 'Сумма по док' format "->,>>>,>>>,>>>,>>9.99"
     1077     total-dsc( recid (c-t-doc) )             column-label 'Скидка по док' format "->,>>>,>>>,>>>,>>9.99"
     1078     total-fact( recid (c-t-doc) )             column-label 'Сумма факт' format "->,>>>,>>>,>>>,>>9.99"
     1079     total-dsc-fact( recid (c-t-doc) )             column-label 'Скидка факт' format "->,>>>,>>>,>>>,>>9.99"
     1080     total-pay-fact( recid (c-t-doc) )             column-label 'К оплате факт' format "->,>>>,>>>,>>>,>>9.99"
     1081     total-vat( recid (c-t-doc) )             column-label 'НДС' format "->,>>>,>>>,>>>,>>9.99"
     1082     total-slt( recid (c-t-doc) )             column-label 'Налог прод.' format "->,>>>,>>>,>>>,>>9.99"
     1083     c-t-doc.discnt-pc             column-label 'Скидка (%)' format "->,>>9.99"
     1084     c-t-doc.discnt-type             column-label 'Тип скидки'
     1085     c-t-doc.base-rate             column-label 'Курс'
     1086     c-t-doc.ov             column-label 'А'
     1087     c-t-doc.tot-ov             column-label 'Авт. переоц. (баз.вал.)'
     1088     c-t-doc.inv-num             column-label 'Инвойс'
     1089     c-t-doc.ord-num             column-label 'Заказ'
     1090     c-t-doc.ship-num             column-label 'Отгрузка'
     1091     c-t-doc.out-code             column-label 'На док-т'
     1092     c-t-doc.is-back-date             column-label 'Задним числом'
     1093     c-t-doc.bge-date             column-label 'Выгрузка'
     1094     c-t-doc.rsrv-date             column-label 'Резерв'
     1095     fo-postavka( recid (c-t-doc) ) @ varpost   column-label 'ФО.поставка' format "x(8)"
     1096     fo-realiz( recid (c-t-doc) ) @ varrealiz column-label 'ФО.реализация' format "x(8)"
     1097     c-holding( recid (c-t-doc) ) @ varchold  column-label 'Меж.фирм' format "Межфирм/ ":U
     1098     usrfulnf(c-t-doc.creid)            column-label "Создал"
     1099   enable
     1100     c-t-doc.ship-num
     1101   with size 98 by 14.5 separators.
     1102   DEFINE BROWSE BR-changes
     1103     QUERY BR-changes DISPLAY
     1104         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(25)"
     1105         temp-changes.v_old COLUMn-LABEL "Было" format "X(35)"
     1106         temp-changes.v_new COLUMn-LABEL "Стало" format "X(35)"
     1107       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.
     1108   define frame d-calldocs
     1109     b-quit            at row  1.00 col  1.00
     1110     b-mark            at row  1.00 col 10.00
     1111     b-sel             at row  1.00 col 13.00
     1112     b-lkp             at row  1.00 col 23.00
     1113     b-lines           at row  1.00 col 53.00
     1114     b-sch             at row  1.00 col 92.00
     1115     b-help            at row  1.00 col 95.00
     1116     br-docs           at row  2.30 col  1.00
     1117     sch-code          at row 20.00 col  2.00                  label "&Начало номера"
     1118     sch-date          at row 20.00 col 32.00                  label "Д&ата"
     1119     sch-fact          at row 20.00 col 52.00                  label "Фа&кт"
     1120     sch-num           at row 20.00 col 70.00                  label "Найдено"                             fgcolor 12
     1121     pay-type.obj-name at row 18.00 col  5.00 colon-aligned    label "Опл"    view-as fill-in size 34 by 1 fgcolor  4
     1122     obj-name          at row 18.00 col 55.00 colon-aligned    label "Объект" view-as fill-in size 34 by 1 fgcolor  4
     1123     boss-name         at row 19.00 col  5.00 colon-aligned    label "М-р"    view-as fill-in size 14 by 1 fgcolor  4
     1124     agnt-name         at row 19.00 col 30.00 colon-aligned    label "Исп"    view-as fill-in size 14 by 1 fgcolor  4
     1125     wrkr-name         at row 19.00 col 55.00 colon-aligned    label "Кл-к"   view-as fill-in size 14 by 1 fgcolor  4
     1126     c-t-doc.creid     at row 19.00 col 80.00 colon-aligned    label "Опер"   view-as fill-in size 14 by 1 fgcolor  4
     1127     ed-notes          at row 21.00 col  1.00               no-label                             bgcolor 8 fgcolor  4
     1128     br-changes        at row 17    col 1
     1129     space( 0 ) skip( 0.5 )
     1130   with view-as dialog-box keep-tab-order
     1131            side-labels no-underline three-d scrollable
     1132            default-button b-quit.
     1133   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1134   on ' ' of sch-date in frame d-calldocs
     1135   do:
     1136     if (can-query (self, "sensitive")
     1137        and
     1138        self :sensitive = true
     1139        )
     1140     or (can-query (self, "read-only")
     1141        and
     1142        self :read-only = false
     1143        )
     1144     then do:
     1145       assign
     1146         self :screen-value = ?
     1147       .
     1148     end.
     1149     return no-apply.
     1150   end.
     1151   on delete-character of sch-date in frame d-calldocs
     1152   do:
     1153     if (can-query (self, "sensitive")
     1154        and
     1155        self :sensitive = true
     1156        )
     1157     or (can-query (self, "read-only")
     1158        and
     1159        self :read-only = false
     1160        )
     1161     then do:
     1162       assign
     1163         self :screen-value = ?
     1164       .
     1165     end.
     1166     return no-apply.
     1167   end.
     1168   on ctrl-d of sch-date in frame d-calldocs
     1169   do:
     1170     define variable v-curr-sv-date as date no-undo .
     1171     if (can-query (self, "sensitive")
     1172        and
     1173        self :sensitive = true
     1174        )
     1175     or (can-query (self, "read-only")
     1176        and
     1177        self :read-only = false
     1178        )
     1179     then do:
     1180       if self :handle <> focus :handle
     1181       then do:
     1182         apply "entry":u to self .
     1183       end.
     1184       run gbl/getcurdt.p
     1185         (output v-curr-sv-date
     1186         ) .
     1187       assign
     1188         self :screen-value = string(v-curr-sv-date) .
     1189       .
     1190     end.
     1191     return no-apply.
     1192   end.
     1193   on ctrl-b of sch-date in frame d-calldocs
     1194   do:
     1195     if (can-query (self, "sensitive")
     1196        and
     1197        self :sensitive = true
     1198        )
     1199     or (can-query (self, "read-only")
     1200        and
     1201        self :read-only = false
     1202        )
     1203     then do:
     1204       if self :handle <> focus :handle
     1205       then do:
     1206         apply "entry":u to self .
     1207       end.
     1208       define variable v-curr-sv-date as date no-undo .
     1209       define variable v-new-sv-date  as date no-undo .
     1210       assign
     1211         v-curr-sv-date = date(self :screen-value) no-error
     1212       .
     1213       if v-curr-sv-date = ?
     1214       then do:
     1215         run gbl/getcurdt.p
     1216           (output v-curr-sv-date
     1217           ) .
     1218       end.
     1219       if v-curr-sv-date <> ?
     1220       then do:
     1221         assign
     1222           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1223         .
     1224         assign
     1225           self :screen-value = string(v-new-sv-date) .
     1226         .
     1227       end.
     1228     end.
     1229     return no-apply .
     1230   end.
     1231   on ctrl-e of sch-date in frame d-calldocs
     1232   do:
     1233     if (can-query (self, "sensitive")
     1234        and
     1235        self :sensitive = true
     1236        )
     1237     or (can-query (self, "read-only")
     1238        and
     1239        self :read-only = false
     1240        )
     1241     then do:
     1242       if self :handle <> focus :handle
     1243       then do:
     1244         apply "entry":u to self .
     1245       end.
     1246       define variable v-curr-sv-date as date no-undo .
     1247       define variable v-new-sv-date  as date no-undo .
     1248       assign
     1249         v-curr-sv-date = date(self :screen-value) no-error
     1250       .
     1251       if v-curr-sv-date = ?
     1252       then do:
     1253         run gbl/getcurdt.p
     1254           (output v-curr-sv-date
     1255           ) .
     1256       end.
     1257       if v-curr-sv-date <> ?
     1258       then do:
     1259         run gbl/lastdate.p
     1260           (input  v-curr-sv-date
     1261           ,output v-new-sv-date
     1262           ).
     1263         assign
     1264           self :screen-value = string(v-new-sv-date) .
     1265         .
     1266       end.
     1267     end.
     1268     return no-apply .
     1269   end.
     1270   on ctrl-f of sch-date in frame d-calldocs
     1271   do:
     1272     if (can-query (self, "sensitive")
     1273        and
     1274        self :sensitive = true
     1275        )
     1276     or (can-query (self, "read-only")
     1277        and
     1278        self :read-only = false
     1279        )
     1280     then do:
     1281       if self :handle <> focus :handle
     1282       then do:
     1283         apply "entry":u to self .
     1284       end.
     1285       define variable v-ok            as logical   no-undo .
     1286       define variable v-curr-sv-date  as date      no-undo .
     1287       define variable v-description   as character no-undo .
     1288       assign
     1289         v-curr-sv-date = date(self :screen-value) no-error
     1290       .
     1291       if v-curr-sv-date = ?
     1292       then do:
     1293         run gbl/getcurdt.p
     1294           (output v-curr-sv-date
     1295           ) .
     1296       end.
     1297       if v-curr-sv-date <> ?
     1298       then do:
     1299         run gbl/d-inpday.w
     1300           (input ?
     1301           ,input "Выбор даты"
     1302           ,input v-description
     1303           ,input ""
     1304           ,input-output v-curr-sv-date
     1305           ,output v-ok
     1306           ).
     1307         if v-ok = true
     1308         then do:
     1309           assign
     1310             self :screen-value = string(v-curr-sv-date) .
     1311           .
     1312         end.
     1313       end.
     1314     end.
     1315     return no-apply .
     1316   end.
     1317     define MENU m-ed-date14
     1318       MENU-ITEM m-ed-date14-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1319       MENU-ITEM m-ed-date14-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1320       MENU-ITEM m-ed-date14-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1321       MENU-ITEM m-ed-date14-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1322       .
     1323     if sch-date :POPUP-MENU in frame d-calldocs = ?
     1324     then do:
     1325       ASSIGN
     1326         sch-date :POPUP-MENU in frame d-calldocs = MENU m-ed-date14 :HANDLE
     1327         sch-date :MENU-MOUSE in frame d-calldocs = 3
     1328       .
     1329     end.
     1330     define variable v-label-handle14 as handle no-undo .
     1331     assign
     1332       v-label-handle14 = sch-date :side-label-handle in frame d-calldocs
     1333     .
     1334     if valid-handle (v-label-handle14)
     1335     then do:
     1336       if v-label-handle14 :tooltip = ""
     1337       or v-label-handle14 :tooltip = ?
     1338       then do:
     1339         assign
     1340           v-label-handle14 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1341         .
     1342       end.
     1343     end.
     1344     ON CHOOSE OF MENU-ITEM m-ed-date14-1 in menu m-ed-date14 DO:
     1345       apply "ctrl-b":U to sch-date in frame d-calldocs .
     1346     END.
