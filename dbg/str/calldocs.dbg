     9181         if bf_sysconf.firm-db-num <> v-cntxt-db-num then do:
     9182           message "Главная БД для фирмы по документу с кодом " bf_c-trn-doc.doc-code " не является текущей БД." skip
     9183                   "Текущая БД: " v-cntxt-db-num skip
     9184                   "Главная БД фирмы: " bf_sysconf.firm-db-num
     9185           view-as alert-box error.
     9186           return error.
     9187         end.
     9188         if bf_c-trn-doc.cr-expfo = yes then do:
     9189           assign
     9190             varlog = no.
     9191           message "По документу " bf_c-trn-doc.doc-code " было создано финансовое обязательство от " bf_c-trn-doc.incfo-date " ." skip
     9192                   "Вы действительно хотите снять признак, что по этому документу было создано фин. обязательство?"
     9193           view-as alert-box question buttons yes-no update varlog.
     9194           if varlog <> yes then do:
     9195             next vari-cycle.
     9196           end.
     9197           assign
     9198             bf_c-trn-doc.cr-expfo   = no
     9199             bf_c-trn-doc.expfo-date = 01/01/1990.
     9200           if bf_c-trn-doc.cr-incfo = no and
     9201              bf_c-trn-doc.cr-expfo = no then do:
     9202             assign
     9203               bf_c-trn-doc.cr-incorexpfo = no.
     9204           end.
     9205           reposition br-docs to recid recid( bf_c-trn-doc ) no-error.
     9206           if not error-status :error then do:
     9207             display fo-realiz( recid( bf_c-trn-doc )) @ varrealiz with browse br-docs.
     9208           end.
     9209         end.
     9210       end.
     9211       assign
     9212         mark-list = "":U.
     9213     end.
     9214   end procedure.
     9215   procedure get-c-holding :
     9216     define  input parameter p-doc-code as character no-undo.
     9217     define output parameter p-holding  as logical   no-undo.
     9218     define variable l_is-holding as logical no-undo.
     9219     do on error undo, return error return-value :
     9220   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_holdcdoc in g#lib-trn3
     9221   (
     9222      input p-doc-code
     9223   , output l_is-holding
     9224   )
     9225            no-error .
     9226       assign p-holding = ( if error-status :error or l_is-holding <> yes then no else yes ).
     9227     end.
     9228   end procedure.
     9229   procedure local-sel :
     9230   if not available c-t-doc then do:
     9231     message "Неправильный выбор документа.".
     9232     return error.
     9233   end.
     9234   if mark-list <> "" then do:
     9235     assign doc-rec = recid (c-t-doc).
     9236   end.
     9237   else do:
     9238     mark-list = string(recid(c-t-doc)).
     9239     assign doc-rec = recid (c-t-doc).
     9240   end.
     9241   apply "go" to frame d-calldocs.
     9242   end procedure.
     9243   PROCEDURE proc-find-date :
     9244   define input parameter p-next as logical no-undo.
     9245   define input parameter p-date like ub.trn-doc.doc-date no-undo.
     9246   define input parameter p-what-date as character no-undo.
     9247   define variable v-date-chr as character no-undo.
     9248   if p-date = ? then return .
     9249   display
     9250   "":U @ sch-code
     9251   "":U @ sch-num
     9252   with frame d-calldocs.
     9253   CASE p-what-date:
     9254       when "doc-date":U then do:
     9255         assign
     9256         sch-fact = ?
     9257         .
     9258         display
     9259         sch-fact
     9260         '' @ sch-code
     9261         with frame d-calldocs.
     9262       end.
     9263       when "fact-date":U then do:
     9264         assign
     9265         sch-date = ?
     9266         .
     9267         display
     9268         sch-date
     9269         '' @ sch-code
     9270         with frame d-calldocs.
     9271       end.
     9272   END CASE.
     9273   assign
     9274   v-date-chr = string(day(p-date)) + chr(47) +
     9275                    string(month(p-date)) + chr(47) +
     9276                    string(year(p-date)).
     9277   CASE p-what-date:
     9278       when "doc-date":U then do:
     9279          run OpenBr in this-procedure
     9280           (input false
     9281           ,input true
     9282           ,input substitute("and c-t-doc.doc-date = &1 "
     9283             , v-date-chr)
     9284           ).
     9285         apply "entry":u to sch-date in frame d-calldocs.
     9286       end.
     9287       when "fact-date":U then do:
     9288          run OpenBr in this-procedure
     9289           (input false
     9290           ,input true
     9291           ,input substitute("and c-t-doc.fact-date = &1 "
     9292             , v-date-chr)
     9293           ).
     9294         apply "entry":u to sch-fact in frame d-calldocs.
     9295       end.
     9296   END CASE.
     9297   END PROCEDURE.
     9298   PROCEDURE proc-find-code :
     9299   define input parameter p-next as logical no-undo.
     9300   define input parameter p-doc-code like ub.c-trn-doc.doc-code no-undo.
     9301   assign
     9302   sch-date = ?
     9303   sch-fact = ?
     9304   .
     9305   display
     9306   sch-date
     9307   sch-fact
     9308   with frame d-calldocs.
     9309   assign
     9310     p-doc-code = replace(p-doc-code, chr(39), chr(39) + chr(39))
     9311   .
     9312   run OpenBr in this-procedure
     9313       (input false
     9314       ,input p-next
     9315       ,input substitute("and c-t-doc.doc-code begins '&1'"
     9316         ,p-doc-code)
     9317       ).
     9318   apply "entry":u to sch-code in frame d-calldocs .
     9319   END PROCEDURE.
     9320   PROCEDURE proc-view-changes :
     9321   define buffer new_c-trn-doc for ub.c-trn-doc.
     9322   define buffer current_trn-doc for ub.trn-doc.
     9323   define variable v-chg-fields as character no-undo.
     9324   define variable v-old-fields as character no-undo.
     9325   define variable v-new-fields as character no-undo.
     9326   define variable ii as integer no-undo.
     9327   for each temp-changes:
     9328       delete temp-changes.
     9329   END.
     9330   if not available c-t-doc then do:
     9331     open query br-changes for each temp-changes.
     9332     return.
     9333   end.
     9334   find first new_c-trn-doc no-lock where
     9335              new_c-trn-doc.doc-code  = c-t-doc.doc-code
     9336          and new_c-trn-doc.chip-num  > c-t-doc.chip-num no-error.
     9337   if not available new_c-trn-doc then do:
     9338       find first current_trn-doc no-lock where
     9339                  current_trn-doc.doc-code  = c-t-doc.doc-code no-error.
     9340            if not available current_trn-doc then do:
     9341            return error.
     9342       end.
     9343       buffer-compare current_trn-doc to c-t-doc
     9344       save result in v-chg-fields.
     9345   end.
     9346   else do:
     9347       buffer-compare new_c-trn-doc except chip-num corr-date corr-user-db-num  action to c-t-doc
     9348       save result in v-chg-fields.
     9349   end.
     9350   define variable v-nn as integer   no-undo .
     9351   v-nn = num-entries(v-chg-fields) .
     9352   do ii = 1 to v-nn :
     9353   CASE entry(ii, v-chg-fields):
     9354   when "acc-date":U then do:     create temp-changes.     assign     temp-changes.f_name = "acc-date":U     temp-changes.l_name = "дата"     temp-changes.v_old = string(c-t-doc.acc-date)     temp-changes.v_new = (if available new_c-trn-doc                               then string(new_c-trn-doc.acc-date)                               else string(current_trn-doc.acc-date))     .   end.
     9355   when "agnt":U then do:     create temp-changes.     assign     temp-changes.f_name = "agnt":U     temp-changes.l_name = "исполнитель"     temp-changes.v_old = string(c-t-doc.agnt)     temp-changes.v_new = (if available new_c-trn-doc                               then string(new_c-trn-doc.agnt)                               else string(current_trn-doc.agnt))     .   end.
     9356   when "bge-date":U then do:     create temp-changes.     assign     temp-changes.f_name = "bge-date":U     temp-changes.l_name = "дата выгрузки"     temp-changes.v_old = string(c-t-doc.bge-date)     temp-changes.v_new = (if available new_c-trn-doc                               then string(new_c-trn-doc.bge-date)                               else string(current_trn-doc.bge-date))     .   end.
     9357   when "boss":U then do:     create temp-changes.     assign     temp-changes.f_name = "boss":U     temp-changes.l_name = "менеджер"     temp-changes.v_old = string(c-t-doc.boss)     temp-changes.v_new = (if available new_c-trn-doc                               then string(new_c-trn-doc.boss)                               else string(current_trn-doc.boss))     .   end.
     9358   when "buyer-fo-date":U then do:     create temp-changes.     assign     temp-changes.f_name = "buyer-fo-date":U     temp-changes.l_name = "ФО покупателя"     temp-changes.v_old = string(c-t-doc.buyer-fo-date)     temp-changes.v_new = (if available new_c-trn-doc                               then string(new_c-trn-doc.buyer-fo-date)                               else string(current_trn-doc.buyer-fo-date))     .   end.
     9359   when "cli-code":U then do:     create temp-changes.     assign     temp-changes.f_name = "cli-code":U     temp-changes.l_name = "Код контрагента"     temp-changes.v_old = string(c-t-doc.cli-code)     temp-changes.v_new = (if available new_c-trn-doc                               then string(new_c-trn-doc.cli-code)                               else string(current_trn-doc.cli-code))     .   end.
     9360   when "cli-name":U then do:     create temp-changes.     assign     temp-changes.f_name = "cli-name":U     temp-changes.l_name = "Контрагент"     temp-changes.v_old = string(c-t-doc.cli-name)     temp-changes.v_new = (if available new_c-trn-doc                               then string(new_c-trn-doc.cli-name)                               else string(current_trn-doc.cli-name))     .   end.
     9361   when "hold-obj-code":U then do:     create temp-changes.     assign     temp-changes.f_name = "hold-obj-code":U     temp-changes.l_name = "Объект МФ"     temp-changes.v_old = string(c-t-doc.hold-obj-code)     temp-changes.v_new = (if available new_c-trn-doc                               then string(new_c-trn-doc.hold-obj-code)                               else string(current_trn-doc.hold-obj-code))     .   end.
     9362   when "hold-obj-type":U then do:     create temp-changes.     assign     temp-changes.f_name = "hold-obj-type":U     temp-changes.l_name = "Тип объекта МФ"     temp-changes.v_old = string(c-t-doc.hold-obj-type)     temp-changes.v_new = (if available new_c-trn-doc                               then string(new_c-trn-doc.hold-obj-type)                               else string(current_trn-doc.hold-obj-type))     .   end.
     9363   when "cli-qnty":U then do:     create temp-changes.     assign     temp-changes.f_name = "cli-qnty":U     temp-changes.l_name = "Кол-во в ед.пос-ка"     temp-changes.v_old = string(c-t-doc.cli-qnty)     temp-changes.v_new = (if available new_c-trn-doc                               then string(new_c-trn-doc.cli-qnty)                               else string(current_trn-doc.cli-qnty))     .   end.
     9364   when "cli-type":U then do:     create temp-changes.     assign     temp-changes.f_name = "cli-type":U     temp-changes.l_name = "Тип Контрагента"     temp-changes.v_old = string(c-t-doc.cli-type)     temp-changes.v_new = (if available new_c-trn-doc                               then string(new_c-trn-doc.cli-type)                               else string(current_trn-doc.cli-type))     .   end.
     9365   when "closed":U then do:     create temp-changes.     assign     temp-changes.f_name = "closed":U     temp-changes.l_name = "партии закрыты."     temp-changes.v_old = string(c-t-doc.closed)     temp-changes.v_new = (if available new_c-trn-doc                               then string(new_c-trn-doc.closed)                               else string(current_trn-doc.closed))     .   end.
     9366   when "cr-db-num":U then do:     create temp-changes.     assign     temp-changes.f_name = "cr-db-num":U     temp-changes.l_name = "БД создания"     temp-changes.v_old = string(c-t-doc.cr-db-num)     temp-changes.v_new = (if available new_c-trn-doc                               then string(new_c-trn-doc.cr-db-num)                               else string(current_trn-doc.cr-db-num))     .   end.
     9367   when "cr-expfo":U then do:     create temp-changes.     assign     temp-changes.f_name = "cr-expfo":U     temp-changes.l_name = "Создано ФО по расх"     temp-changes.v_old = string(c-t-doc.cr-expfo)     temp-changes.v_new = (if available new_c-trn-doc                               then string(new_c-trn-doc.cr-expfo)                               else string(current_trn-doc.cr-expfo))     .   end.
     9368   when "cr-factur":U then do:     create temp-changes.     assign     temp-changes.f_name = "cr-factur":U     temp-changes.l_name = "Создан счет-фактура"     temp-changes.v_old = string(c-t-doc.cr-factur)     temp-changes.v_new = (if available new_c-trn-doc                               then string(new_c-trn-doc.cr-factur)                               else string(current_trn-doc.cr-factur))     .   end.
     9369   when "cr-fo-buyer":U then do:     create temp-changes.     assign     temp-changes.f_name = "cr-fo-buyer":U     temp-changes.l_name = "Создано ФО покупателя"     temp-changes.v_old = string(c-t-doc.cr-fo-buyer)     temp-changes.v_new = (if available new_c-trn-doc                               then string(new_c-trn-doc.cr-fo-buyer)                               else string(current_trn-doc.cr-fo-buyer))     .   end.
     9370   when "cr-incfo":U then do:     create temp-changes.     assign     temp-changes.f_name = "cr-incfo":U     temp-changes.l_name = "Создано ФО по прих"     temp-changes.v_old = string(c-t-doc.cr-incfo)     temp-changes.v_new = (if available new_c-trn-doc                               then string(new_c-trn-doc.cr-incfo)                               else string(current_trn-doc.cr-incfo))     .   end.
     9371   when "cr-incorexpfo":U then do:     create temp-changes.     assign     temp-changes.f_name = "cr-incorexpfo":U     temp-changes.l_name = "Создано ФО поставщика"     temp-changes.v_old = string(c-t-doc.cr-incorexpfo)     temp-changes.v_new = (if available new_c-trn-doc                               then string(new_c-trn-doc.cr-incorexpfo)                               else string(current_trn-doc.cr-incorexpfo))     .   end.
     9372   when "creid":U then do:     create temp-changes.     assign     temp-changes.f_name = "creid":U     temp-changes.l_name = "создал"     temp-changes.v_old = string(c-t-doc.creid)     temp-changes.v_new = (if available new_c-trn-doc                               then string(new_c-trn-doc.creid)                               else string(current_trn-doc.creid))     .   end.
     9373   when "cst-code":U then do:     create temp-changes.     assign     temp-changes.f_name = "cst-code":U     temp-changes.l_name = "ГТД"     temp-changes.v_old = string(c-t-doc.cst-code)     temp-changes.v_new = (if available new_c-trn-doc                               then string(new_c-trn-doc.cst-code)                               else string(current_trn-doc.cst-code))     .   end.
     9374   when "d-card":U then do:     create temp-changes.     assign     temp-changes.f_name = "d-card":U     temp-changes.l_name = "Дисконтная карта"     temp-changes.v_old = string(c-t-doc.d-card)     temp-changes.v_new = (if available new_c-trn-doc                               then string(new_c-trn-doc.d-card)                               else string(current_trn-doc.d-card))     .   end.
