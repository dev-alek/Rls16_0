     1517           (output v-curr-sv-date
     1518           ) .
     1519       end.
     1520       if v-curr-sv-date <> ?
     1521       then do:
     1522         run gbl/d-inpday.w
     1523           (input ?
     1524           ,input "Выбор даты"
     1525           ,input v-description
     1526           ,input ""
     1527           ,input-output v-curr-sv-date
     1528           ,output v-ok
     1529           ).
     1530         if v-ok = true
     1531         then do:
     1532           assign
     1533             self :screen-value = string(v-curr-sv-date) .
     1534           .
     1535         end.
     1536       end.
     1537     end.
     1538     return no-apply .
     1539   end.
