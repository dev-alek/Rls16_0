      137   procedure fltfield-clear :
      138     define output parameter loc-fld as character no-undo.
      139     define output parameter loc-lab as character no-undo .
      140     define output parameter loc-spr as character no-undo .
      141     define output parameter loc-dim as character no-undo .
      142     assign
      143       loc-fld = ""
      144       loc-lab = ""
      145       loc-spr = ""
      146       loc-dim = "0"
      147     .
      148   end procedure .
      149   procedure fltfield-add :
      150     define input        parameter par-fld as character no-undo.
      151     define input        parameter par-lab as character no-undo .
      152     define input        parameter par-spr as character no-undo .
      153     define input-output parameter loc-fld as character no-undo.
      154     define input-output parameter loc-lab as character no-undo .
      155     define input-output parameter loc-spr as character no-undo .
      156     define input-output parameter loc-dim as character no-undo .
      157     do
      158     on error undo, return error
      159     :
      160       assign
      161       loc-fld = if loc-dim = '0'
      162                 then par-fld
      163                 else (loc-fld + chr(44) + par-fld)
      164       loc-lab = if loc-dim = '0'
      165                 then par-lab
      166                 else (loc-lab + chr(44) + par-lab)
      167       loc-spr = if loc-dim = '0'
      168                 then par-spr
      169                 else (loc-spr + chr(44) + par-spr)
      170       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      171                 string(integer(if num-entries(loc-dim) > 1
      172                               then entry(2, loc-dim)
      173                               else entry(1, loc-dim)
      174                               ) + 1)
      175       no-error
      176       .
      177     end.
      178   end procedure.
