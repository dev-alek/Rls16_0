     9173           vardoc-code = integer( entry( vari, mark-list ) ).
     9174         find first bf_c-trn-doc exclusive-lock where recid( bf_c-trn-doc ) = vardoc-code.
     9175         if bf_c-trn-doc.status_ <> 'факт':U then do:
     9176           message "Документ " bf_c-trn-doc.status_ " не в статусе " 'факт':U " . Пропускаем."
     9177           view-as alert-box.
