      607   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      608   procedure fltopend_fltopend :
      609   define input parameter p-parent-handle as handle no-undo .
      610   define input parameter p-qh as handle no-undo .
      611   define input parameter p-flt-open-open-query  as character no-undo .
      612   define input parameter p-where-cond as character no-undo .
      613   define input parameter p-use-indFIRST-query-tail as character no-undo .
      614   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      615   define input parameter p-indexed-reposition as character no-undo .
      616     do
      617     on error undo, return error
      618     :
      619   define variable v-prepare-string as character no-undo .
      620   define variable glog as logical no-undo .
      621   assign
      622   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      623                      p-where-cond + chr(32)  +
      624                      p-use-indFIRST-query-tail + chr(32) +
      625                      p-use-ind-sort-clmn-by + chr(32) +
      626                      p-indexed-reposition
      627   .
      628   assign
      629   glog = p-qh:query-prepare(v-prepare-string) no-error .
      630   if not glog
      631   or error-status:error then do:
      632     message error-status:get-message(1) view-as alert-box .
      633     undo, return error .
      634   end.
      635   assign
      636   glog = p-qh:query-open no-error .
      637   if not glog
      638   or error-status:error then do:
      639     message error-status:get-message(1) view-as alert-box .
      640     undo, return error .
      641   end.
      642     end.
      643   end procedure.
      644   procedure fltopend_fltfindd :
      645   define input parameter p-parent-handle as handle no-undo .
      646   define input parameter p-qh as handle no-undo .
      647   define input parameter p-rowid as rowid no-undo .
      648   define input parameter p-next as logical no-undo .
      649   define input parameter p-lock as integer no-undo .
      650   define input parameter p-bh as handle no-undo .
      651   define input parameter p-where-cond as character no-undo .
      652   define input parameter p-use-index-phrase as character no-undo .
      653   define variable glog as logical no-undo .
      654   define variable v-qh as handle no-undo .
      655   define variable v-bh as handle no-undo .
      656   define variable v-recid as recid no-undo .
      657   define variable v-prepare-string as character no-undo .
      658   do
      659   on error undo, return error
      660   on stop undo, return error
      661   :
      662     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      663     create buffer v-bh for table p-bh buffer-name p-bh:name.
      664     create query v-qh.
      665     v-qh:set-buffers(v-bh).
      666     v-prepare-string = substitute("for each &1 &2 &3"
      667                                     ,v-bh:name
      668                                     ,p-where-cond
      669                                     ,p-use-index-phrase).
      670     glog = v-qh:query-prepare(v-prepare-string) no-error.
      671     if not glog then do:
      672       delete object v-qh.
      673       delete object v-bh.
      674       undo, return error .
      675     end.
      676     glog = v-qh:query-open no-error .
      677     if not glog then do:
      678       delete object v-qh.
      679       delete object v-bh.
      680       undo, return error .
      681     end.
      682     if p-next then do:
      683       v-qh:reposition-to-rowid(p-rowid) no-error .
      684       glog = v-qh:get-next( p-lock) no-error .
      685       glog = v-qh:get-next( p-lock) no-error .
      686       if not glog or v-qh:query-off-end = yes then do:
      687         glog = v-qh:get-first( p-lock) no-error .
      688       end.
      689     end.
      690     else do:
      691       glog = v-qh:get-first( p-lock) no-error .
      692     end.
      693     v-recid = v-bh:recid no-error .
      694     delete object v-qh.
      695     delete object v-bh.
      696     return string(v-recid) .
      697   end.
      698   end procedure.
      699   procedure fltopend_fltfindq :
      700   define input parameter p-parent-handle as handle no-undo .
      701   define input parameter p-qh as handle no-undo .
      702   define input parameter p-next as logical no-undo .
      703   define input parameter p-lock as integer no-undo .
      704   define input parameter p-flt-open-open-query  as character no-undo .
      705   define input parameter p-where-cond as character no-undo .
      706   define input parameter p-use-indFIRST-query-tail as character no-undo .
      707   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      708   define input parameter p-indexed-reposition as character no-undo .
      709   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      710   define variable glog as logical no-undo .
      711   define variable v-qh as handle no-undo .
      712   define variable v-bh as handle no-undo extent 18.
      713   define variable v-rowid as rowid no-undo extent 18.
      714   define variable v-ii as integer no-undo .
      715   define variable v-prepare-string as character no-undo .
      716   do
      717   on error undo, return error
      718   on stop undo, return error
      719   :
      720     create query v-qh.
      721     do v-ii = 1 to p-qh:num-buffers:
      722       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      723       assign
      724       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      725       no-error.
      726       v-qh:add-buffer(v-bh[v-ii]).
      727     end.
      728     assign
      729     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      730                       p-where-cond + chr(32)  +
      731                       p-use-indFIRST-query-tail + chr(32) +
      732                       p-use-ind-sort-clmn-by + chr(32) +
      733                       p-indexed-reposition
      734     .
      735     glog = v-qh:query-prepare( v-prepare-string) no-error .
      736     if not glog then do:
      737       delete object v-qh.
      738       do v-ii = 1 to p-qh:num-buffers:
      739         delete object v-bh[v-ii].
      740       end.
      741       undo, return error .
      742     end.
      743     glog = v-qh:query-open no-error .
      744     if not glog then do:
      745       delete object v-qh.
      746       do v-ii = 1 to p-qh:num-buffers:
      747         delete object v-bh[v-ii].
      748       end.
      749       undo, return error .
      750     end.
      751     if p-next then do:
      752       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      753       glog = v-qh:get-next( p-lock) no-error .
      754       glog = v-qh:get-next( p-lock) no-error .
      755       if not glog or v-qh:query-off-end = yes then do:
      756         glog = v-qh:get-first( p-lock) no-error .
      757       end.
      758     end.
      759     else do:
      760       glog = v-qh:get-first( p-lock) no-error .
      761     end.
      762     do v-ii = 1 to p-qh:num-buffers:
      763       assign
      764       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      765       no-error.
      766     end.
      767     delete object v-qh.
      768     do v-ii = 1 to p-qh:num-buffers:
      769       delete object v-bh[v-ii].
      770     end.
      771   end.
      772   end procedure.
