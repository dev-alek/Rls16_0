      199   FUNCTION get-curr RETURNS CHARACTER
      200     (buffer loc-wealth for ub.wealth ) :
      201   define buffer buf_currency for ub.currency.
      202   if loc-wealth.curr-code = ? or loc-wealth.is-money = no then
      203   return loc-wealth.unit-base.
      204   FIND FIRST buf_currency no-lock where
      205             buf_currency.curr-code = loc-wealth.curr-code No-ERROR.
      206   if avail buf_currency then
      207     RETURN buf_currency.curr-abbr.
      208   else return "".
      209   END FUNCTION.
