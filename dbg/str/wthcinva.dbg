        1   DEFINE BUFFER buf_c-wth-line FOR ub.c-wth-line.
        2   DEFINE BUFFER buf_wealth FOR ub.wealth.
        3   DEFINE BUFFER buf_wth-place FOR ub.wth-place.
        4   DEFINE TEMP-TABLE tt-c-wth-line NO-UNDO LIKE ub.c-wth-line.
        5   define input parameter parparentproc as widget-handle no-undo .
        6   DEFINE TEMP-TABLE tt-par-dtl NO-UNDO LIKE ub.wth-par
        7   FIELD q-ty-bef     AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Кол-во план"
        8   FIELD q-ty-aft     AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Кол-во факт"
        9   FIELD sum-bef  like ub.wth-line.bef-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма план"
       10   FIELD sum-aft  like ub.wth-line.aft-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма факт"
       11   FIELD sum-fact  like ub.wth-line.fact-sum FORM "->,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Расхождение"
       12   INDEX tt-pi    IS   PRIMARY UNIQUE par-code
       13   INDEX tt-i1                        par-feat par-unit par-val
       14   INDEX tt-i2                        sum-bef  q-ty-bef
       15    .
       16   define input parameter par-mode as character no-undo .
       17   define input parameter pardoc-rec as recid no-undo.
       18   define input-output parameter parline-rec as recid no-undo.
       19   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       20   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       21   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       22   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       23   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       24   define variable vss-description AS CHAR NO-UNDO INIT "Добавление, изменение, просмотр истории строки документа МЦ (инвентаризация)":U.
       25   procedure vss-get-info :
       26     define output parameter p-vss-revision    like vss-revision    no-undo .
       27     define output parameter p-vss-author      like vss-author      no-undo .
       28     define output parameter p-vss-date        like vss-date        no-undo .
       29     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       30     define output parameter p-vss-archive     like vss-archive     no-undo .
       31     define output parameter p-vss-description like vss-description no-undo .
       32     assign
       33       p-vss-revision    = vss-revision
       34       p-vss-author      = vss-author
       35       p-vss-date        = vss-date
       36       p-vss-workfile    = vss-workfile
       37       p-vss-archive     = vss-archive
       38       p-vss-description = vss-description
       39     .
       40   end procedure.
       41   procedure vss-get-parameters :
       42     define output parameter p-vss-parameters as character no-undo .
       43   end procedure.
       44   define new global shared variable g#vssrevis-logger as handle    no-undo .
       45   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       46   define variable v-vssrevis-logger                   as handle    no-undo .
       47   procedure vss-logevent :
       48     define input  parameter p-extra-paramters as character no-undo .
       49     define variable v-vssrevis-parameters as character no-undo .
       50     do
       51     on error undo, return error return-value
       52     :
       53       if  valid-handle(v-vssrevis-logger)
       54       and v-vssrevis-logger :get-signature("logevent") <> ""
       55       then do:
       56         run vss-get-parameters in this-procedure
       57           (output v-vssrevis-parameters
       58           ).
       59         run logevent in v-vssrevis-logger
       60           (input vss-workfile
       61           ,input vss-revision
       62           ,input v-vssrevis-parameters
       63           ,input p-extra-paramters
       64           ).
       65       end.
       66     end.
       67   end procedure.
       68   assign
       69     v-vssrevis-logger = g#vssrevis-logger
       70   .
       71   if  valid-handle(v-vssrevis-logger)
       72   and v-vssrevis-logger :get-signature("logevent") <> ""
       73   then do:
       74     assign
       75       v-vssrevis-logevent = true
       76     .
       77     run vss-logevent in this-procedure (input vss-description) .
       78   end.
       79   define new global shared variable g#language as character no-undo .
       80   if g#language <> '' and g#language <> 'rus':U then do:
       81     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       82   end.
       83   procedure proc-alt-shift-f2:
       84     if not ibs.th.gbl.gbl-var:rcode
       85   then
       86     run gbl\inidebug.p .
       87   end.
       88   procedure proc-alt-shift-f3:
       89     run gbl/prvssinf.p
       90       ( input this-procedure
       91       ) .
       92   end.
       93   define variable v-inform-launched as logical no-undo initial false .
       94   procedure proc-alt-shift-f4:
       95     define variable v-action as character no-undo .
       96     if v-inform-launched = false then do:
       97       assign
       98         v-inform-launched = true
       99       .
      100       run gbl/d-inform.w
      101         (  input self
      102         ,  input this-procedure
      103         , output v-action
      104         ) no-error .
      105       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      106       assign
      107         v-inform-launched = false
      108       .
      109     end.
      110   end.
      111   procedure proc-alt-f1:
      112     run gbl/corrhelp.p
      113       (input this-procedure
      114       ) .
      115   end .
      116   on alt-shift-f2 anywhere do:
      117     run proc-alt-shift-f2.
      118   end.
      119   on alt-shift-f3 anywhere do:
      120     run proc-alt-shift-f3 in this-procedure .
      121   end.
      122   on alt-shift-f4 anywhere do:
      123     run proc-alt-shift-f4 in this-procedure.
      124   end.
      125   on alt-f1 anywhere do:
      126     run proc-alt-f1 in this-procedure .
      127   end.
      128   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129   procedure wth-lib_cur-stock-place:
      130   define input  parameter parobj-type like ub.clients.obj-type   no-undo.
      131   define input  parameter parobj-code like ub.clients.obj-code   no-undo.
      132   define input  parameter parw-p-code like ub.wth-pobj.w-p-code  no-undo.
      133   define input  parameter parwth-code like ub.wth-pobj.wth-code  no-undo.
      134   define output parameter parstock    like ub.wth-pobj.income-pl no-undo.
      135   define buffer bf_wth-pobj for ub.wth-pobj.
      136   find first bf_wth-pobj where bf_wth-pobj.obj-type = parobj-type and
      137                                bf_wth-pobj.obj-code = parobj-code and
      138                                bf_wth-pobj.w-p-code = parw-p-code and
      139                                bf_wth-pobj.wth-code = parwth-code no-lock no-error.
      140   if available bf_wth-pobj then assign parstock = bf_wth-pobj.income-pl - bf_wth-pobj.incass-pl.
      141                            else assign parstock = 0.
      142   end procedure.
      143   procedure wth-lib_cur-stock-obj:
      144   define input  parameter parobj-type like ub.clients.obj-type   no-undo.
      145   define input  parameter parobj-code like ub.clients.obj-code   no-undo.
      146   define input  parameter parwth-code like ub.wth-obj.wth-code   no-undo.
      147   define output parameter parstock    like ub.wth-obj.income     no-undo.
      148   define buffer bf_wth-obj for ub.wth-obj.
      149   find first bf_wth-obj where bf_wth-obj.obj-type = parobj-type and
      150                               bf_wth-obj.obj-code = parobj-code and
      151                               bf_wth-obj.wth-code = parwth-code no-lock no-error.
      152   if available bf_wth-obj then assign parstock = bf_wth-obj.income - bf_wth-obj.incass.
      153                           else assign parstock = 0.
      154   end.
      155   FUNCTION wth-lib_cur-stock-obj-func RETURNS DECIMAL (INPUT parobj-type AS CHARACTER,
      156                                                        INPUT parobj-code AS INTEGER,
      157                                                        INPUT parwth-code AS INTEGER):
      158   define buffer bf_wth-obj for ub.wth-obj.
      159   find first bf_wth-obj where bf_wth-obj.obj-type = parobj-type and
      160                               bf_wth-obj.obj-code = parobj-code and
      161                               bf_wth-obj.wth-code = parwth-code no-lock no-error.
      162   if available bf_wth-obj then return (bf_wth-obj.income - bf_wth-obj.incass).
      163                           else return 0.00.
      164   end function.
      165   FUNCTION wth-lib_cur-stock-host-func RETURNS DECIMAL (INPUT parhost-code AS INTEGER,
      166                                                         INPUT parwth-code  AS INTEGER):
      167   define buffer bf_wth-obj for ub.wth-obj.
      168   define variable v-stock like ub.wth-obj.income no-undo.
      169   for each bf_wth-obj no-lock where bf_wth-obj.host-code = parhost-code and
      170                                     bf_wth-obj.wth-code = parwth-code :
      171     v-stock = v-stock +  bf_wth-obj.income - bf_wth-obj.incass.
      172   end.
      173   return v-stock.
      174   end function.
      175   procedure wth-lib_full-inf-shift:
      176   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parshift-date   like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num    like ub.shift-obj.shift-num   no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                                                                                       cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.shift-date = parshift-date and                        cur_wth-line.shift-num  = parshift-num  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-sdn no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                                                                             start_wth-line.wth-code   = parwth-code         and                                (start_wth-line.shift-date = parshift-date and                           start_wth-line.shift-num  < parshift-num  or                            start_wth-line.shift-date < parshift-date ) and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-sdn no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income - cur_wth-line.incass              parincome        = cur_wth-line.income                     parincome-cassa  = cur_wth-line.income-cassa               parincome-other  = cur_wth-line.income-other               parincass        = cur_wth-line.incass                     parincass-bank   = cur_wth-line.incass-bank                parincass-other  = cur_wth-line.incass-other.              parincass-cassa  = cur_wth-line.incass-cassa.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income     - start_wth-line.incass               parstock-end     = cur_wth-line.income       - cur_wth-line.incass                 parincome        = cur_wth-line.income       - start_wth-line.income               parincome-cassa  = cur_wth-line.income-cassa - start_wth-line.income-cassa         parincome-other  = cur_wth-line.income-other - start_wth-line.income-other         parincass        = cur_wth-line.incass       - start_wth-line.incass               parincass-bank   = cur_wth-line.incass-bank  - start_wth-line.incass-bank          parincass-other  = cur_wth-line.incass-other - start_wth-line.incass-other.        parincass-cassa  = cur_wth-line.incass-cassa - start_wth-line.incass-cassa.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income - start_wth-line.incass                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      177   end procedure.
      178   procedure wth-lib_full-inf-shift-inter:
      179   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parshift-date   like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num    like ub.shift-obj.shift-num   no-undo.                        define input  parameter parshift-date1  like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num1   like ub.shift-obj.shift-num   no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                                                                                       cur_wth-line.wth-code   = parwth-code   and                                        ((cur_wth-line.shift-date = parshift-date1 and                           cur_wth-line.shift-num  <= parshift-num1)  or                            cur_wth-line.shift-date < parshift-date1 ) and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-sdn no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                                                                             start_wth-line.wth-code   = parwth-code         and                                (start_wth-line.shift-date = parshift-date and                           start_wth-line.shift-num  < parshift-num  or                            start_wth-line.shift-date < parshift-date ) and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-sdn no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income - cur_wth-line.incass              parincome        = cur_wth-line.income                     parincome-cassa  = cur_wth-line.income-cassa               parincome-other  = cur_wth-line.income-other               parincass        = cur_wth-line.incass                     parincass-bank   = cur_wth-line.incass-bank                parincass-other  = cur_wth-line.incass-other.              parincass-cassa  = cur_wth-line.incass-cassa.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income     - start_wth-line.incass               parstock-end     = cur_wth-line.income       - cur_wth-line.incass                 parincome        = cur_wth-line.income       - start_wth-line.income               parincome-cassa  = cur_wth-line.income-cassa - start_wth-line.income-cassa         parincome-other  = cur_wth-line.income-other - start_wth-line.income-other         parincass        = cur_wth-line.incass       - start_wth-line.incass               parincass-bank   = cur_wth-line.incass-bank  - start_wth-line.incass-bank          parincass-other  = cur_wth-line.incass-other - start_wth-line.incass-other.        parincass-cassa  = cur_wth-line.incass-cassa - start_wth-line.incass-cassa.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income - start_wth-line.incass                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      180   end procedure.
      181   procedure wth-lib_full-inf-shift-period-place:
      182   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parw-p-code     like ub.wth-pobj.w-p-code  no-undo.                        define input  parameter parshift-date   like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num    like ub.shift-obj.shift-num   no-undo.                        define input  parameter parshift-date1  like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num1   like ub.shift-obj.shift-num   no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                        cur_wth-line.w-p-code = parw-p-code and                                                               cur_wth-line.wth-code   = parwth-code   and                                        ((cur_wth-line.shift-date = parshift-date1 and                           cur_wth-line.shift-num  <= parshift-num1)  or                            cur_wth-line.shift-date < parshift-date1 ) and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-sdn no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                start_wth-line.w-p-code = parw-p-code and                                                             start_wth-line.wth-code   = parwth-code         and                                (start_wth-line.shift-date = parshift-date and                           start_wth-line.shift-num  < parshift-num  or                            start_wth-line.shift-date < parshift-date ) and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-sdn no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income-pl - cur_wth-line.incass-pl              parincome        = cur_wth-line.income-pl                     parincome-cassa  = cur_wth-line.income-cassa-pl               parincome-other  = cur_wth-line.income-other-pl               parincass        = cur_wth-line.incass-pl                     parincass-bank   = cur_wth-line.incass-bank-pl                parincass-other  = cur_wth-line.incass-other-pl.              parincass-cassa  = cur_wth-line.incass-cassa-pl.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income-pl     - start_wth-line.incass-pl               parstock-end     = cur_wth-line.income-pl       - cur_wth-line.incass-pl                 parincome        = cur_wth-line.income-pl       - start_wth-line.income-pl               parincome-cassa  = cur_wth-line.income-cassa-pl - start_wth-line.income-cassa-pl         parincome-other  = cur_wth-line.income-other-pl - start_wth-line.income-other-pl         parincass        = cur_wth-line.incass-pl       - start_wth-line.incass-pl               parincass-bank   = cur_wth-line.incass-bank-pl  - start_wth-line.incass-bank-pl          parincass-other  = cur_wth-line.incass-other-pl - start_wth-line.incass-other-pl.        parincass-cassa  = cur_wth-line.incass-cassa-pl - start_wth-line.incass-cassa-pl.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income-pl - start_wth-line.incass-pl                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
