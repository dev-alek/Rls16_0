      245             LABEL "Сумма факт"
      246             VIEW-AS FILL-IN
      247             SIZE 17.5 BY 1
      248        T-dtl AT ROW 9.5 COL 5.5
      249        B-dtl AT ROW 9.53 COL 28.8
      250        ub.wealth.wth-name AT ROW 2.93 COL 56.4 COLON-ALIGNED NO-LABEL
      251              VIEW-AS TEXT
      252             SIZE 24.5 BY 1
      253             FGCOLOR 4
      254        tt-c-wth-line.wth-code AT ROW 3 COL 23.8 COLON-ALIGNED
      255             LABEL "Материальная ценность"
      256              VIEW-AS TEXT
      257             SIZE 12 BY .67
      258        ub.wth-place.w-p-name AT ROW 4.57 COL 56.5 COLON-ALIGNED NO-LABEL
      259              VIEW-AS TEXT
      260             SIZE 24.8 BY 1
      261             FGCOLOR 4
      262        tt-c-wth-line.w-p-code AT ROW 4.7 COL 23.8 COLON-ALIGNED
      263             LABEL "Код места"
      264              VIEW-AS TEXT
      265             SIZE 12 BY .67
      266        tt-c-wth-line.bef-sum AT ROW 6.83 COL 23.5 COLON-ALIGNED
      267             LABEL "Сумма план"
      268              VIEW-AS TEXT
      269             SIZE 17.5 BY .67
      270        tt-c-wth-line.fact-sum AT ROW 8.2 COL 39.9 COLON-ALIGNED
      271             LABEL "Расхождение"
      272              VIEW-AS TEXT
      273             SIZE 17.5 BY .67
      274             FGCOLOR 4
      275        SPACE(33.34) SKIP(3.08)
      276       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      277            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      278            TITLE "Строка удаленного документа движения МЦ"
      279            CANCEL-BUTTON b-quit.
      280   ASSIGN
      281          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      282          FRAME Dialog-Frame:HIDDEN           = TRUE.
      283   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      284   DO:
      285     APPLY "END-ERROR":U TO SELF.
      286   END.
      287   ON LEAVE OF tt-c-wth-line.aft-sum IN FRAME Dialog-Frame
      288   DO:
      289     if ub.c-wth-doc.status_ = 'разрешен':U   then do:
      290     DISPLAY
      291           (input frame Dialog-Frame tt-c-wth-line.aft-sum - tt-c-wth-line.bef-sum) @ tt-c-wth-line.fact-sum
      292           WITH FRAME Dialog-Frame.
      293     end.
      294   END.
      295   ON CHOOSE OF B-dtl IN FRAME Dialog-Frame
      296   DO:
      297     assign
      298     tt-c-wth-line.bef-sum
      299     tt-c-wth-line.AFT-sum
      300     tt-c-wth-line.fact-sum
      301     tt-c-wth-line.wth-code
      302     .
      303     run str/wthcdtlv.w (
      304                      input parparentproc
      305                     ,INPUT par-mode
      306                     ,INPUT parline-rec
      307                     ,INPUT tt-c-wth-line.doc-code
      308                     ,INPUT tt-c-wth-line.wth-code
      309                     ,INPUT tt-c-wth-line.w-p-code
      310                     ,INPUT tt-c-wth-line.corr-user-db-num
      311                     ,INPUT tt-c-wth-line.chip-num
      312                     ,INPUT ?
      313                     ,INPUT tt-c-wth-line.fact-sum
      314                     ,INPUT tt-c-wth-line.bef-sum
      315                     ,INPUT tt-c-wth-line.aft-sum
      316                     ,INPUT ub.c-wth-doc.doc-type
      317                     ,input-output table tt-par-dtl ).
      318     run control-dtl in this-procedure(output lock-line).
      319     run lock-proc in this-procedure.
      320   END.
      321   ON CHOOSE OF B-next IN FRAME Dialog-Frame
      322   DO:
      323         run proc-b-move(input self:name) no-error.
      324     if error-status:error then return no-apply.
      325   END.
      326   ON CHOOSE OF B-prev IN FRAME Dialog-Frame
      327   DO:
      328         run proc-b-move(input self:name) no-error.
      329     if error-status:error then return no-apply.
      330   END.
      331   ON LEAVE OF tt-c-wth-line.w-p-code IN FRAME Dialog-Frame
      332   DO:
      333      FIND FIRST buf_wth-place NO-LOCK WHERE
      334       buf_wth-place.host-code = ub.c-wth-doc.host-code AND
      335       buf_wth-place.obj-type = tt-c-wth-line.obj-type AND
      336       buf_wth-place.obj-code = tt-c-wth-line.obj-code AND
      337       buf_wth-place.w-p-code = INPUT FRAME Dialog-Frame tt-c-wth-line.w-p-code    NO-ERROR.
      338     IF NOT AVAIL buf_wth-place THEN DO:
      339       IF tt-c-wth-line.w-p-code = INPUT FRAME Dialog-Frame tt-c-wth-line.w-p-code THEN DO:
      340           RETURN.
      341       END.
      342       MESSAGE
      343         "Место хранения МЦ" INPUT FRAME Dialog-Frame tt-c-wth-line.w-p-code
      344         "отсутствует в справочнике или принадлежит другому объекту!"
      345       VIEW-AS ALERT-BOX ERROR.
      346       RETURN NO-APPLY.
      347     END.
      348     DISPLAY
      349     buf_wth-place.w-p-name @ ub.wth-place.w-p-name
      350     WITH FRAME Dialog-Frame.
      351     run display-bef-sum in this-procedure no-error.
      352   END.
      353   ON LEAVE OF tt-c-wth-line.wth-code IN FRAME Dialog-Frame
      354   DO:
      355     FIND FIRST buf_wealth NO-LOCK WHERE
      356                      buf_wealth.wth-code = INPUT FRAME Dialog-Frame tt-c-wth-line.wth-code NO-ERROR.
      357     IF AVAIL buf_wealth THEN DO:
      358       DISPLAY
      359       buf_wealth.wth-name @ ub.wealth.wth-name
      360       WITH FRAME Dialog-Frame.
      361     END.
      362       run display-bef-sum in this-procedure no-error.
      363   END.
      364   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      365   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      366   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      367   on help of frame Dialog-Frame
      368   do:
      369     run gbl/app_help.p
      370       (input this-procedure :file-name
      371       ,input ''
      372       ,input ?
      373       ) no-error.
      374     if error-status :error then do:
      375       message
      376         "Ошибка при вызове помощи"
      377         error-status :get-message(1)
      378         view-as alert-box .
      379     end.
      380   end.
      381   run minbtn-set in this-procedure .
      382   on choose of b-help in frame Dialog-Frame
      383   do:
      384     apply "help":u to frame Dialog-Frame .
      385   end.
      386   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      387   procedure minbtn-set :
      388       do
      389           on error undo, return error return-value
      390           :
      391           define variable ii              as integer       no-undo .
      392           define variable fh              as widget-handle no-undo .
      393           define variable hh              as widget-handle no-undo .
      394           define variable v-h             as handle        extent 4 no-undo .
      395           define variable v-name-button   as character     no-undo .
      396           define variable v-help-old-x    as decimal       no-undo .
      397           define variable v-help-old-y    as decimal       no-undo .
      398           define variable v-help-old-size as decimal       no-undo .
      399           define variable v-frame-width   as decimal       no-undo .
      400           define variable jj              as integer       no-undo .
      401           do
      402               on error undo, return error
      403               :
      404               assign
      405                   v-frame-width = frame Dialog-Frame:width - 0.3
      406                   fh            = frame Dialog-Frame:first-child
      407                   hh            = fh:first-child
      408                   ii            = 1
      409                   .
      410               do while valid-handle(hh):
      411                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      412                   do:
      413                       case lc(hh:name) :
      414                           when "b-help" then
      415                               do:
      416                                   hh:load-image-up("cmp/b-help.bmp":u) .
      417                                   hh:load-image-down("cmp/b-help.bmp":u) .
      418                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      419                                   hh:TOOLTIP = "Помощь" .
      420                                   v-help-old-x = hh:column .
      421                                   v-help-old-y = hh:row    .
      422                                   v-help-old-size = hh:width .
      423                                   hh:width-chars = 2.5 .
      424                               end.
      425                           when "b-print" then
      426                               do:
      427                                   hh:load-image("cmp/b-print.bmp":u) .
      428                                   hh:TOOLTIP = "Печать" .
      429                                   v-h[ii] = hh:handle .
      430                                   ii = ii + 1 .
      431                                   hh:width-chars = 3 .
      432                               end.
      433                           when "b-history" or
      434                           when "b-hist" then
      435                               do:
      436                                   hh:load-image("cmp/b-hist.bmp":u) .
      437                                   hh:TOOLTIP = "История" .
      438                                   v-h[ii] = hh:handle .
      439                                   ii = ii + 1 .
      440                                   hh:width-chars = 3 .
      441                               end.
      442                           when "b-sch" then
      443                               do:
      444                                   hh:load-image("cmp/b-sch.bmp":u) .
      445                                   hh:TOOLTIP = "Установка Фильтра" .
      446                                   v-h[ii] = hh:handle .
      447                                   ii = ii + 1 .
      448                                   hh:width-chars = 3 .
      449                               end.
      450                           when "b-hist-user" then
      451                               do:
      452                                   hh:load-image("cmp/b-hist.bmp":u) .
      453                                   hh:TOOLTIP = "История пользователя" .
      454                                   ii = ii + 1 .
      455                               end.
      456                       end case.
      457                   end.
      458                   hh = hh:next-sibling.
      459               end.
      460               b-help:column = v-frame-width - b-help:width-chars.
      461               jj = 0.
      462               repeat ii = 4 to 1 by -1 :
      463                   if valid-handle (v-h[ii] ) then
      464                   do:
      465                       jj  = jj + 1 .
      466                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      467                       v-h[ii]:row    = v-help-old-y .
      468                   end.
      469               end.
      470           end.
      471       end.
      472   end procedure.
      473   MAIN-BLOCK:
      474   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      475      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      476     if par-mode <> 'ПРОСМОТР':U then do:
      477         message vss-workfile vss-revision vss-description skip
      478                     "Неверный параметр вызова par-mode"
      479         view-as alert-box ERROR.
      480         return error.
      481     end.
      482     if par-mode = 'ПРОСМОТР':U then do:
      483       FIND FIRST ub.c-wth-doc No-LOCK WHERE
      484                  recid(ub.c-wth-doc) = pardoc-rec No-ERROR.
      485     end.
      486     IF NOT avail ub.c-wth-doc then do:
      487       message
      488       vss-workfile vss-revision vss-description skip
      489       "Не найден документ движения МЦ"
      490       view-as alert-box.
      491       return error.
      492     end.
      493     assign
      494     vardoc-code = ub.c-wth-doc.doc-code
      495     varcorr-user-db-num = ub.c-wth-doc.corr-user-db-num
      496     varchip-num = ub.c-wth-doc.chip-num
      497     .
      498     OPEN QUERY QUERY-lines
      499     FOR EACH buf_c-wth-line WHERE
      500               buf_c-wth-line.doc-code = vardoc-code
      501           and buf_c-wth-line.corr-user-db-num = varcorr-user-db-num
      502           and buf_c-wth-line.chip-num = varchip-num
      503               NO-LOCK INDEXED-REPOSITION.
      504       if par-mode = 'ПРОСМОТР':U then do:
      505         get first QUERY-lines.
      506         repeat while parline-rec <> recid(buf_c-wth-line):
      507           get next QUERY-lines.
      508         end.
      509       end.
      510       IF error-status:error then do:
      511         message
      512         vss-workfile vss-revision vss-description skip
      513         "Не найдена строка по документу движения МЦ"
      514         view-as alert-box.
      515         return error.
      516       end.
      517     run fill-tables in this-procedure.
      518     RUN Myenable in this-procedure.
      519     WAIT-FOR GO OF FRAME Dialog-Frame.
      520   END.
      521   RUN disable_UI.
      522   PROCEDURE control-dtl :
      523   define output parameter lock-line as logical no-undo.
      524      if not avail tt-c-wth-line then return error.
      525      if par-mode = 'ДОБАВЛЕНИЕ':U or can-find(first tt-par-dtl) then dO:
      526           find first tt-par-dtl No-LOCK  where
      527                      tt-par-dtl.sum-bef > 0 No-ERROR .
      528           t-dtl:screen-value in frame Dialog-Frame = (if available tt-par-dtl then "yes" else "no").
      529      end.
      530      else do:
      531             find first ub.c-wth-dtl No-LOCK  where
      532                          ub.c-wth-dtl.doc-code = tt-c-wth-line.doc-code AND
      533                          ub.c-wth-dtl.wth-code = tt-c-wth-line.wth-code AND
      534                          ub.c-wth-dtl.w-p-code = tt-c-wth-line.w-p-code No-ERROR .
      535           t-dtl:screen-value in frame Dialog-Frame = (if available ub.c-wth-dtl then "yes" else "no").
      536      end.
      537      if t-dtl:screen-value in frame Dialog-Frame = "yes" or
      538            par-mode = 'ПРОСМОТР':U then lock-line = yes.
      539   END PROCEDURE.
      540   PROCEDURE disable_UI :
      541     HIDE FRAME Dialog-Frame.
      542   END PROCEDURE.
      543   PROCEDURE display-bef-sum :
      544   if available buf_wealth and
      545      available buf_wth-place then do:
      546   end.
      547   IF AVAIL buf_wealth THEN DO:
      548     RUN wth-lib_cur-stock-place (
      549                                    INPUT tt-c-wth-line.obj-type,
      550                                    INPUT tt-c-wth-line.obj-code,
      551                                    INPUT ( INPUT FRAME Dialog-Frame tt-c-wth-line.w-p-code ),
      552                                    INPUT ( INPUT FRAME Dialog-Frame tt-c-wth-line.wth-code ),
      553                                   OUTPUT for-bef-sum
      554                                 ).
      555         DISPLAY
      556         foR-bef-sum @ tt-c-wth-line.bef-sum
      557         WITH FRAME Dialog-Frame.
      558   END.
      559   END PROCEDURE.
      560   PROCEDURE enable_UI :
      561     DISPLAY T-dtl
      562         WITH FRAME Dialog-Frame.
      563     IF AVAILABLE tt-c-wth-line THEN
      564       DISPLAY tt-c-wth-line.aft-sum tt-c-wth-line.wth-code tt-c-wth-line.w-p-code
      565             tt-c-wth-line.bef-sum tt-c-wth-line.fact-sum
      566         WITH FRAME Dialog-Frame.
      567     IF AVAILABLE ub.wealth THEN
      568       DISPLAY ub.wealth.wth-name
      569         WITH FRAME Dialog-Frame.
      570     IF AVAILABLE ub.wth-place THEN
      571       DISPLAY ub.wth-place.w-p-name
      572         WITH FRAME Dialog-Frame.
      573     ENABLE b-quit B-prev B-next B-Help tt-c-wth-line.aft-sum T-dtl B-dtl
      574            ub.wealth.wth-name tt-c-wth-line.wth-code ub.wth-place.w-p-name
      575            tt-c-wth-line.w-p-code tt-c-wth-line.bef-sum tt-c-wth-line.fact-sum
      576         WITH FRAME Dialog-Frame.
      577     VIEW FRAME Dialog-Frame.
      578   END PROCEDURE.
      579   PROCEDURE fill-tables :
      580     for each tt-c-wth-line:
      581       delete tt-c-wth-line.
      582     end.
      583   for each tt-par-dtl:
      584       delete tt-par-dtl.
      585   end.
      586       create tt-c-wth-line.
      587       buffer-copy buf_c-wth-line to tt-c-wth-line.
      588       FIND FIRST buf_wealth No-LOCK WHERE
      589                  buf_wealth.wth-code = tt-c-wth-line.wth-code No-error.
      590           FIND FIRST buf_wth-place No-LOCK WHERE
      591                  buf_wth-place.w-p-code = tt-c-wth-line.w-p-code No-error.
      592       find first ub.c-wth-dtl No-LOCK WHERE
      593                     ub.c-wth-dtl.wth-code = tt-c-wth-line.wth-code
      594                 AND ub.c-wth-dtl.doc-code = tt-c-wth-line.doc-code
      595                 AND ub.c-wth-dtl.w-p-code = tt-c-wth-line.w-p-code
      596                 AND ub.c-wth-dtl.corr-user-db-num = tt-c-wth-line.corr-user-db-num
      597                 AND ub.c-wth-dtl.chip-num = tt-c-wth-line.chip-num No-ERROR.
      598   END PROCEDURE.
      599   PROCEDURE lock-proc :
      600   DISABLE
      601     tt-c-wth-line.wth-code
      602     tt-c-wth-line.w-p-code
      603     with frame Dialog-Frame
      604     .
      605   END PROCEDURE.
      606   PROCEDURE MyEnable :
      607   IF AVAILABLE tt-c-wth-line THEN
      608       DISPLAY
      609       tt-c-wth-line.wth-code
      610       tt-c-wth-line.BEF-sum
      611       tt-c-wth-line.AFT-sum
      612       tt-c-wth-line.fact-sum
      613       tt-c-wth-line.w-p-code
      614     WITH FRAME Dialog-Frame.
      615     IF AVAILABLE buf_wealth THEN
      616       DISPLAY
      617       buf_wealth.wth-name @ ub.wealth.wth-name
      618       WITH FRAME Dialog-Frame.
      619     ELSE
      620     DISPLAY
      621     '':u @ WEALTH.WTH-NAME
      622     WITH FRAME Dialog-Frame.
      623     IF AVAILABLE BUF_WTH-PLACE THEN
      624       DISPLAY
      625       BUF_WTH-PLACE.w-P-name @ ub.wth-place.w-p-name
      626      WITH FRAME Dialog-Frame.
      627     ELSE
      628     DISPLAY
      629     '':u @ WTH-PLACE.W-P-NAME
      630     WITH FRAME Dialog-Frame.
      631     HIDE
      632     tt-c-wth-line.AFT-sum
      633     tt-c-wth-line.fact-sum
      634     IN FRAME Dialog-Frame.
      635   CASE par-mode:
      636       when 'ПРОСМОТР':U  THEN DO:
      637         IF ub.c-wth-doc.status_ = 'накл':U THEN DO:
      638           HIDE
      639           tt-c-wth-line.fact-sum IN FRAME Dialog-Frame
      640           tt-c-wth-line.Aft-sum IN FRAME Dialog-Frame.
      641         end.
      642         else do:
      643           DISPLAY
      644           TT-c-wth-line.AFT-SUM
      645           (tt-c-wth-line.aft-sum - tt-c-wth-line.bef-sum) @ tt-c-wth-line.fact-sum WITH FRAME Dialog-Frame.
      646         END.
      647         ENABLE
      648         B-Next
      649         B-Prev
      650         b-quit
      651         b-dtl when avail ub.c-wth-dtl
      652         WITH FRAME Dialog-Frame.
      653         locked-wth = yes.
      654       END.
      655     END CASE.
      656     run control-dtl in this-procedure (output lock-line).
      657     run lock-proc in this-procedure.
      658     ENABLE
      659     b-help
      660     WITH FRAME Dialog-Frame.
      661     FRAME Dialog-Frame:TITLE =
      662         "Удаленный документ № " + ub.c-wth-doc.doc-code + " (" + TRIM(
      663         ( IF ub.c-wth-doc.doc-type = 'при':U     THEN "ПРИХОД"         ELSE
      664         ( IF ub.c-wth-doc.doc-type = 'рас':U    THEN "РАСХОД"         ELSE
      665         ( IF ub.c-wth-doc.doc-type = 'спи':U  THEN "СПИСАНИЕ"       ELSE
      666         ( IF ub.c-wth-doc.doc-type = 'инв':U  THEN "ИНВЕНТАРИЗАЦИЯ" ELSE ub.c-wth-doc.doc-type ) ) ) ) +
      667         STRING( ub.c-wth-doc.inter_, "ВНУТ/":U ) + STRING( ub.c-wth-doc.exter_, "ВНЕШ/":U ) ) + ")" +
      668         "  - " + CAPS( par-mode ) + " матценности".
      669     VIEW FRAME Dialog-Frame.
      670   END PROCEDURE.
      671   PROCEDURE proc-b-move :
      672   DEFINE INPUT PARAMETER par-action as character No-UNDO.
      673   define variable v-line-rec as recid no-undo .
      674     ASSIGN v-line-rec = RECID( buf_c-wth-line ).
      675     CASE par-action:
      676       when "b-next":U then do:
      677           GET NEXT QUERY-lines NO-LOCK.
      678       end.
      679       when "b-prev":U then do:
      680           GET PREV QUERY-lines NO-LOCK.
      681       end.
      682     END CASE.
      683     IF AVAIL buf_c-wth-line THEN DO:
      684       ASSIGN v-line-rec = RECID( buf_c-wth-line ).
      685       run fill-tables in this-procedure.
      686       run MyEnable in this-procedure.
      687     END.
      688     ELSE DO:
      689       CASE par-action:
      690           when "b-next":U then do:
      691               GET PREV QUERY-lines NO-LOCK.
      692           end.
      693           when "b-prev":U then do:
      694               GET NEXT QUERY-lines NO-LOCK.
      695           end.
      696       END CASE.
      697       FIND FIRST buf_c-wth-line NO-LOCK WHERE
      698                       RECID( buf_c-wth-line ) = v-line-rec NO-ERROR.
      699       MESSAGE
      700         "Это" ( IF par-action = "B-Next":U THEN "последняя" ELSE "первая" )
      701         "строка в документе!"
      702       VIEW-AS ALERT-BOX INFORMATION.
      703       RETURN NO-APPLY.
      704     END.
      705   END PROCEDURE.
