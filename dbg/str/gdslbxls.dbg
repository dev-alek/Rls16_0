     3353     ,input  p-curr-obj-code
     3354     ,output vat-value
     3355     ) no-error .
     3356   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3357   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3358     (input  bb-list.gds-code
     3359     ,input  '2':U
     3360     ,input  ?
     3361     ,input  v-host-code
     3362     ,input  p-curr-obj-type
     3363     ,input  p-curr-obj-code
     3364     ,output slt-value
     3365     ) no-error .
     3366     do jj = 1 to j-n:
     3367       assign
     3368       f-value = "":U
     3369       v-dop0 = entry(jj, f-name)
     3370       v-dop1 = entry(1, entry(jj, f-name), ".")
     3371       v-dop2 = entry(2, entry(jj, f-name), ".")
     3372       .
     3373       CASE v-dop1 :
     3374         when "function":U then do:
     3375           if Make-Excel then  put   stream ForExcel unformatted
     3376           get-function(substr(v-dop0 ,10 ), entry(jj, ubflt.filter.Where-ysl-rus, chr(4)))
     3377           (if jj < j-n
     3378           then
     3379           CHR(9)
     3380           else chr(10))
     3381           .
     3382         end.
     3383         when 'bar-code':U then do:
     3384           if index(v-dop0, "*":U) > 0 then do:
     3385             do jj-1 = 1 to num-entries(v-dop0, "*":U):
     3386               assign
     3387               f-value-1 = "":U.
     3388               run barcodfi in this-procedure (
     3389                                buffer bar-code
     3390                               ,INPUT entry(jj-1, v-dop0, "*":U)
     3391                               ,INPUT-OUTPUT f-value-1
     3392                               )  NO-ERROR .
     3393               assign
     3394               f-value = f-value + (if f-value = "":U then "":U else chr(32)) + f-value-1
     3395               .
     3396             end.
     3397           end.
     3398           else do:
     3399             run barcodfi in this-procedure (
     3400                              buffer bar-code
     3401                             ,INPUT v-dop0
     3402                             ,INPUT-OUTPUT f-value
     3403                             )  NO-ERROR .
     3404           end.
     3405           if Make-Excel then  put   stream ForExcel unformatted
     3406           string(f-value, substitute("X(&1)", entry(jj, ubflt.filter.Where-ysl)))
     3407           (if jj < j-n
     3408           then
     3409           CHR(9)
     3410           else chr(10))
     3411           .
     3412         end.
     3413         when 'prod-bc':U then do:
     3414             if available prod-bc then  do:
     3415               prod-bc-field-handle = BUFFER prod-bc:BUFFER-FIELD(v-dop2 ).
     3416               if Make-Excel then  put   stream ForExcel unformatted
     3417               string((if v-dop2 = "b-str":U
     3418                       then chr(4)
     3419                       else "":U) + prod-bc-field-handle:buffer-value
     3420                     , (chr(34) + entry(jj, ubflt.filter.Where-ysl-rus, chr(4)) + chr(34)))
     3421               (if jj < j-n
     3422               then
     3423               CHR(9)
     3424               else chr(10))
     3425               .
     3426             end.
     3427             else do:
     3428               if bb-list.loc-ean or bb-list.b-str <> "":U then do:
     3429                 CASE v-dop2:
