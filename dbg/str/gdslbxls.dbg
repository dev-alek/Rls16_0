     2216         undo, return error return-value .
     2217       end.
     2218     end.
     2219   end procedure.
     2220   procedure gdshattr-copy :
     2221   define input  parameter p-code           as character no-undo .
     2222   define output parameter p-copy           as logical   no-undo .
     2223     do
     2224     on error undo, return error
     2225     :
     2226           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdshattr-copy in g#attr-lib
     2227         (input  p-code
     2228         ,output p-copy
     2229         ) no-error .
     2230       if error-status :error
     2231       then do:
     2232         undo, return error return-value .
     2233       end.
     2234     end.
     2235   end procedure.
     2236   def new shared var bc-frmt as character no-undo .
     2237   def new shared var bc-pfx  as character no-undo .
     2238   def var bc-par-type as character no-undo .
     2239       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
     2240       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
     2241           do:
     2242               message "Не задан или не верно задан ТИП собственного бар-кода!"
     2243                   view-as alert-box ERROR TITLE "".
     2244               return error.
     2245           end.
     2246       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
     2247       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
     2248           do:
     2249               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
     2250                   view-as alert-box ERROR TITLE "".
     2251               return error.
     2252           end.
     2253   PROCEDURE gen-bc:
     2254     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
     2255     def output parameter full-b-code     as character init ""    no-undo .
     2256   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2257     define variable tmp-str22  as character no-undo.
     2258     define variable tmp-num22  as character no-undo.
     2259     define variable i22        as integer   no-undo.
     2260     define variable sum22      as integer   no-undo.
     2261     define variable len-code22 as integer   no-undo.
     2262     define variable varcont22  as logical   initial yes no-undo.
     2263     CASE bc-frmt :
     2264       WHEN "EAN13" THEN do:
     2265         assign
     2266           tmp-str22 = string( internal-b-code, "999999999999" )
     2267         .
     2268       end.
     2269       WHEN "EAN8" THEN do:
     2270         assign
     2271           tmp-str22 = string( internal-b-code, "9999999" )
     2272         .
     2273       end.
     2274       OTHERWISE DO:
     2275           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
     2276           view-as alert-box error.
     2277           return error.
     2278       END.
     2279     END CASE.
     2280     if varcont22 = yes then do:
     2281       if integer( substring( tmp-str22, 1, length( bc-pfx ) ) ) <> 0
     2282       then do:
     2283         message
     2284           "Невозможно сформировать бар-код" SKIP
     2285           "для товара с кодом: " internal-b-code
     2286           view-as alert-box error title "подрезание кода".
     2287         return error.
     2288       end.
     2289       else do:
     2290         assign
     2291           full-b-code = bc-pfx + substring( tmp-str22, length( bc-pfx ) + 1, length( tmp-str22 ) - length( bc-pfx ) )
     2292           len-code22    = length( full-b-code )
     2293         .
     2294         define variable v-sum-char22 as character no-undo .
     2295         assign
     2296           sum22 = 0
     2297         .
     2298         do i22 = 1 to len-code22 by 2
     2299         :
     2300           assign
     2301             v-sum-char22 = substr(full-b-code, len-code22 - i22 + 1, 1)
     2302           .
     2303           if v-sum-char22 < "0"
     2304           or v-sum-char22 > "9"
     2305           then do:
     2306             message
     2307               "Невозможно сформировать бар-код" skip
     2308               "для товара с кодом: " internal-b-code skip
     2309               view-as alert-box error title "подсчет контрольной суммы".
     2310             return error.
     2311           end.
     2312           assign
     2313             sum22 = sum22 + integer(v-sum-char22)
     2314           .
     2315         end.
     2316         if varcont22 = yes then do:
     2317           assign
     2318             sum22 = sum22 * 3
     2319           .
     2320           do i22 = 2 to len-code22 by 2
     2321           :
     2322             assign
     2323               v-sum-char22 = substr(full-b-code, len-code22 - i22 + 1, 1)
     2324             .
     2325             if v-sum-char22 < "0"
     2326             or v-sum-char22 > "9"
     2327             then do:
     2328               message
     2329                 "Невозможно сформировать бар-код" skip
     2330                 "для товара с кодом: " internal-b-code skip
     2331                 view-as alert-box error title "подсчет контрольной суммы".
     2332               return error.
     2333             end.
     2334             assign
     2335               sum22 = sum22 + integer(v-sum-char22)
     2336             .
     2337           end.
     2338           if varcont22 = yes then do:
     2339              if sum22 mod 10 = 0 then do:
     2340                assign
     2341                  full-b-code = full-b-code + '0'
     2342                .
     2343              end.
     2344              else do:
     2345                assign
     2346                  full-b-code = full-b-code + string(10 - sum22 mod 10)
     2347                .
     2348              end.
     2349           end.
     2350         end.
     2351       end.
     2352     end.
     2353   END PROCEDURE.
     2354   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
