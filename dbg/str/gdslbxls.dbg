      197   def
      198   new shared
      199   temp-table  obj-list no-undo
      200     field obj-type like ub.clients.obj-type
      201     field obj-code like ub.clients.obj-code
      202     field obj-name like ub.clients.obj-name
      203     field obj-id   as integer
