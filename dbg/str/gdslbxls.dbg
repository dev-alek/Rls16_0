     3442                 else chr(10))
     3443                 .
     3444               end.
     3445               else do:
     3446                 if Make-Excel then  put   stream ForExcel unformatted
     3447                 "":U
     3448                 (if jj < j-n
     3449                 then
     3450                 CHR(9)
     3451                 else chr(10))
     3452                 .
     3453               end.
     3454             end.
     3455         end.
     3456         otherwise do:
     3457           if index(v-dop0, "*":U) > 0 then do:
     3458             do jj-1 = 1 to num-entries(v-dop0, "*":U):
     3459               assign
     3460               f-value-1 = "":U.
     3461               run gds-ref-fi in this-procedure (
