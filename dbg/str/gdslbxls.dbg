      207     index ie2 obj-name
      208   .
      209   procedure create_obj-list :
      210      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      211      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      212      do
      213      on error undo, return error return-value
      214      :
      215         define buffer cli-obj for ub.clients .
      216         define variable p-var as integer no-undo .
      217         define buffer buf_obj-list for obj-list .
      218         find last buf_obj-list  use-index pi no-error .
      219         if available buf_obj-list
      220         then
      221            p-var = buf_obj-list.obj-id + 1.
      222         else
      223            p-var = 1.
      224         find first cli-obj where
      225                   cli-obj.obj-type = p-obj-type
      226               and cli-obj.obj-code = p-obj-code
      227         no-lock no-error.
      228         if available cli-obj
      229         then do:
      230            create buf_obj-list.
      231            assign
      232               buf_obj-list.obj-id   = p-var
      233               buf_obj-list.obj-code = cli-obj.obj-code
      234               buf_obj-list.obj-type = cli-obj.obj-type
      235               buf_obj-list.obj-name = cli-obj.obj-name
      236               buf_obj-list.db-num   = cli-obj.db-num
      237            .
      238         end.
      239      end.
      240   end.
