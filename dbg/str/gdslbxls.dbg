      763   procedure prnfield-clear :
      764     define output parameter loc-fld as character no-undo.
      765     define output parameter loc-lab as character no-undo .
      766     define output parameter loc-spr as character no-undo .
      767     define output parameter loc-dim as character no-undo .
      768     define output parameter loc-size as character no-undo .
      769     define output parameter loc-format as character no-undo .
      770     define output parameter loc-type as character no-undo .
      771     assign
      772       loc-fld = ""
      773       loc-lab = ""
      774       loc-spr = ""
      775       loc-dim = "0"
      776       loc-size = "":U
      777       loc-format = "":U
      778       loc-type = "":U
      779     .
      780   end procedure .
      781   procedure prnfield-add :
      782     define input        parameter par-fld as character no-undo.
      783     define input        parameter par-lab as character no-undo .
      784     define input        parameter par-spr as character no-undo .
      785     define input        parameter par-size as integer no-undo .
      786     define input        parameter par-format as character no-undo .
      787     define input-output parameter loc-fld as character no-undo.
      788     define input-output parameter loc-lab as character no-undo .
      789     define input-output parameter loc-spr as character no-undo .
      790     define input-output parameter loc-size as character no-undo .
      791     define input-output parameter loc-format as character no-undo .
      792     define input-output parameter loc-dim as character no-undo .
      793     do
      794     on error undo, return error
      795     :
      796       assign
      797       loc-fld = if loc-dim = '0'
      798                 then par-fld
      799                 else (loc-fld + chr(44) + par-fld)
      800       loc-lab = if loc-dim = '0'
      801                 then par-lab
      802                 else (loc-lab + chr(44) + par-lab)
      803       loc-spr = if loc-dim = '0'
      804                 then par-spr
      805                 else (loc-spr + chr(44) + par-spr)
      806       loc-size = if loc-dim = '0'
      807                 then string(par-size)
      808                 else (loc-size + chr(44) + string(par-size))
      809       loc-format = if loc-dim = '0'
      810                 then par-format
      811                 else (loc-format + chr(4) + string(par-format))
      812       no-error
      813       .
      814       assign
      815       entry(num-entries(loc-dim), loc-dim) = string(integer(entry(num-entries(loc-dim), loc-dim)) + 1)
      816       no-error
      817       .
      818     end.
      819   end procedure.
      820   FUNCTION prnfield_get-fsize returns integer(
      821   input p-type as character,
      822   input p-format as character,
      823   input p-label as character
      824   ):
      825   define variable ii as integer no-undo .
      826   define variable v-max as integer no-undo .
      827     do
      828     on error undo, return error
      829     :
      830       do ii = 1 to num-entries(p-label, chr(32)):
      831         assign
      832         v-max = maximum(v-max, length(entry(ii, p-label, chr(32))))
      833         .
      834       end.
      835       if p-format = "99:99" then return MAXIMUM(v-max,8).
      836       CASE p-type:
      837          when 'C':U or when 'character':U then do:
      838           if p-format = "99:99" or p-format = "99:99-99:99" then return maximum(v-max, 8).
      839           else
      840           return maximum(v-max, integer(left-trim(right-trim(left-trim(left-trim(p-format, "X":U), "(":U), ")":U),">") )).
      841         end.
      842         when 'I':U or when 'D':U or when 'T':U or
      843         when 'integer':U or when 'decimal':U or when 'date':U
      844         then do:
      845           return maximum(v-max,length(p-format)).
      846         end.
      847         when 'L':U or when 'logical':U then do:
      848           return MAXIMUM(v-max, length(entry(1, p-format, chr(47))), length(entry(2, p-format, chr(47)))).
      849         end.
      850       END CASE.
      851     end.
      852   end FUNCTION.
      853   function prnfield_get-fformat returns character ( input p-data-type as character
      854                                           ,input p-format as character ):
      855   define variable v-excel-format as character no-undo .
      856   case p-data-type:
      857     when 'character':U then do:
      858       v-excel-format = "@".
      859     end.
      860     when 'integer':U then do:
      861       v-excel-format = "0".
      862     end.
      863     when 'decimal':U then do:
      864       v-excel-format = substitute("0.&1", fill("0", length(entry(2, p-format, ".")))) no-error.
      865     end.
      866     when 'date':U then do:
      867       v-excel-format = "d/m/yyyy".
      868     end.
      869     otherwise do:
      870       v-excel-format = "@".
      871     end.
      872   end.
      873   if v-excel-format = '' then
      874   v-excel-format = "@".
      875   return v-excel-format .
      876   end function.
      877   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      878   define variable v-waitfram-action01         as character   no-undo .
      879   define variable v-waitfram-action02         as character   no-undo .
      880   define variable v-waitfram-action03         as character   no-undo .
      881   define variable mWaitFramTextBeg            as character   no-undo.
      882   define variable mWaitFramTextEnd            as character   no-undo.
      883   define variable mWaitFramView               as logical     no-undo.
      884   define variable mWaitProcEvent              as logical     no-undo init yes.
      885   define variable mWaitFramInterval           as integer     no-undo init 1 .
      886   define variable mWaitFramStop               as logical     no-undo.
      887   define variable mWaitFramStopUser           as logical     no-undo.
      888   define variable mWaitFramStopTimeOut        as logical     no-undo.
      889   define variable mWaitFramStartProc          as datetime-tz no-undo.
      890   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      891   define button B-WaitFramStop auto-end-key
      892        label "Стоп"
      893        size 10 by 1 tooltip "Остоновить процесс".
      894   define button B-viewProcInfo
      895        label "Информация"
      896        size 15 by 1 tooltip "Информация о процесс".
      897   define frame waitfram
      898     v-waitfram-action01 format "x(72)" no-label skip
      899     v-waitfram-action02 format "x(72)" no-label skip
      900     v-waitfram-action03 format "x(72)" no-label skip
      901     B-viewProcInfo
      902     B-WaitFramStop at row 4 col 30
      903     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      904     .
      905   define new global shared variable mBatchMode as logical no-undo init ?.
      906   define variable mFramBachModHandle as handle no-undo.
      907   mFramBachModHandle = frame waitfram:handle.
      908   define variable mFameOldVis as logical no-undo.
      909   define variable mVisCUrentVin as logical no-undo.
      910   if session:batch-mode
      911   then
      912      mBatchMode = yes.
      913   if mBatchMode = ? then do:
      914     mVisCUrentVin = current-window:visible.
      915     mFameOldVis = mFramBachModHandle:visible.
      916     mFramBachModHandle:visible  = yes.
      917     mBatchMode = mFramBachModHandle:visible ne yes.
      918     mFramBachModHandle:visible = mFameOldVis.
      919     current-window:visible = mVisCUrentVin.
      920   end.
      921    if  log-manager:logfile-name ne ?
      922     then DO:
      923         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      924         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      925         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      926     end.
      927   on choose of B-WaitFramStop in frame waitfram
      928   do:
      929     mWaitFramStop = yes.
      930     mWaitFramStopUser = yes.
      931   end.
      932   function waitfram-check-timeout returns logical():
      933      define variable vtime as int64 no-undo.
      934      if mWaitFramStopTimeOut
      935      then
      936         return yes.
      937      vtime = ( now - mWaitFramStartProc ) / 1000 .
      938      if     mWaitFramTimeOut ne ?
      939         and mWaitFramTimeOut ne 0
      940         and mWaitFramTimeOut lt vtime
      941      then do:
      942         mWaitFramStopTimeOut = yes.
      943      end.
      944      return mWaitFramStopTimeOut.
      945   end.
      946   procedure waitfram-hide :
      947     if not session:batch-mode
      948     then do
      949     on error undo, return error return-value
      950     :
      951       pause 0 before-hide .
      952       if not mBatchMode then
      953         hide frame waitfram .
      954     if     not mWaitFramView
      955        and mWaitProcEvent
      956     then
      957       process events .
      958     end.
      959   end procedure.
      960   procedure waitfram-show :
      961     define input  parameter p-message as character no-undo .
      962     define variable v-left-margin as integer   no-undo .
      963     if not session:batch-mode
      964     then do
      965     on error undo, return error return-value
      966     :
      967       if length(p-message) <= 70 then do:
      968         assign
      969           v-left-margin = integer((70 - length(p-message)) / 2)
      970         .
      971         assign
      972           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      973         .
      974         assign
      975           v-waitfram-action01 = " "
      976           v-waitfram-action02 = " "
      977                                    + fill(" ", v-left-margin)
      978                                    + p-message
      979           v-waitfram-action03 = " "
      980         .
      981       end.
      982       else do:
      983         define variable vRindex1 as integer no-undo.
      984         define variable vRindex2 as integer no-undo.
      985         vRindex1 = r-index(p-message," ",70).
      986         if vRindex1 = 0
      987         then
      988            vRindex1 = 70.
      989         if length(p-message)  <= vRindex1 + 70 then do:
      990           assign
      991             v-waitfram-action01 = " "
      992             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      993             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      994           .
      995         end.
      996         else do:
      997           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      998           if vRindex2 <= vRindex1
      999           then
     1000              vRindex2 = vRindex1 + 70.
     1001           assign
     1002             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1003             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1004             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1005           .
     1006         end.
     1007       end.
     1008       B-viewProcInfo:visible   in frame waitfram = no.
     1009       B-viewProcInfo:sensitive in frame waitfram = no.
     1010       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1011       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1012       if  (   mWaitFramView
     1013          or  mWaitProcEvent)
     1014          and not mBatchMode
     1015       then
     1016          display
     1017             v-waitfram-action01 skip
     1018             v-waitfram-action02 skip
     1019             v-waitfram-action03 skip
     1020          with frame waitfram .
     1021       if     mWaitFramView
     1022          then do:
     1023             if     mWaitFramInterval ne ?
     1024                and not mBatchMode
     1025             then
     1026                wait-for go of frame waitfram pause mWaitFramInterval.
     1027          end.
     1028          else
     1029             if     mWaitProcEvent
     1030                and not mBatchMode
     1031             then
     1032                process events .
     1033     end.
     1034   end procedure.
     1035      procedure waitfram-show-this:
     1036         define input  parameter iInterval as int64 no-undo.
     1037         define variable vtime as int64 no-undo.
     1038         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1039         mWaitFramInterval = iInterval.
     1040         run waitfram-show (substitute("&1&2 &3&4" ,
     1041                                       mWaitFramTextBeg ,
     1042                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1043                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1044                                       mWaitFramTextEnd
     1045                                      )
     1046                           ).
     1047      end.
     1048      procedure WaitFramRunPause:
     1049         define input  parameter iInterval as dec no-undo.
     1050         define variable vStart  as datetime-tz no-undo.
     1051         define variable vend    as datetime-tz no-undo.
     1052         define variable vint as int64 no-undo.
     1053         define variable vOk as logical no-undo.
     1054         vStart = now.
     1055         vend   = vStart.
     1056         publish "WaitFramPause" (iInterval,output vOk).
     1057         vend   =  now.
     1058         vint = vend - vStart.
     1059         vint = iInterval - vint / 1000.
     1060         if     not mWaitFramStop
     1061            and (   vint > 0
     1062                 or (    not vOk
     1063                     and iInterval eq ?
     1064                     )
     1065                 )
     1066         then
     1067            run waitfram-show-this (iInterval).
     1068         vend   =  now.
     1069         vint = vend - vStart.
     1070         vint = iInterval - vint / 1000.
     1071         if     not mWaitFramStop
     1072            and vint > 0
     1073         then do:
     1074            run gbl/pause.p (vint * 1000).
     1075         end.
     1076         if iInterval ne ?
     1077         then
     1078            publish "WaitFramStop".
     1079         waitfram-check-timeout().
     1080      end.
     1081      procedure WaitFramWaitFor:
     1082         define input  parameter iInterval as dec no-undo.
     1083         assign
     1084            mWaitFramStartProc   = now
     1085            mWaitFramStopUser    = no
     1086            mWaitFramStopTimeOut = no
     1087         .
     1088         block-wait:
     1089         do while not mWaitFramStop:
     1090            run WaitFramRunPause (iInterval).
     1091            if  waitfram-check-timeout()
     1092            then do:
     1093               leave block-wait.
     1094            end.
     1095         end.
     1096         run waitfram-hide.
     1097      end.
     1098   procedure waitfram-join :
     1099     define input  parameter p-line-1  as character no-undo .
     1100     define input  parameter p-line-2  as character no-undo .
     1101     define input  parameter p-line-3  as character no-undo .
     1102     define output parameter p-message as character no-undo .
     1103     do
     1104     on error undo, return error return-value
     1105     :
     1106       assign
     1107         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1108                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1109                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1110       .
     1111     end.
     1112   end procedure.
     1113   function waitfram-join-function returns character
     1114     (input p-line-1 as character
     1115     ,input p-line-2 as character
     1116     ,input p-line-3 as character
     1117     ).
     1118     define variable v-message as character no-undo .
     1119     run waitfram-join in this-procedure
     1120       (input  p-line-1
     1121       ,input  p-line-2
     1122       ,input  p-line-3
     1123       ,output v-message
     1124       ) .
     1125     return v-message .
     1126   end function .
