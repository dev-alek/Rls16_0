      649   define variable g#report-num as integer no-undo .
      650   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      651   procedure OpenForExcel :
      652      define variable v-ch#ExcelApplication as com-handle no-undo .
      653      define variable v-ch#Workbook         as com-handle no-undo .
      654      define variable v-ch#Worksheet        as com-handle no-undo .
      655      os-delete value( string( session:temp-directory ) +
      656                                 "rpt" + string( g#report-num ) + ".txt":U ) .
      657      os-delete value( string( session:temp-directory ) +
      658                                 "rpt" + string( g#report-num ) + ".frm":U ) .
      659      os-delete value( string( session:temp-directory ) +
      660                                 "rpt" + string( g#report-num ) + ".txl":U ) .
      661      if Make-Excel
      662      then do:
      663         output stream ForExcel to value( string( session:temp-directory +
      664                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
      665         assign
      666            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
      667            number-list = 1
      668         .
      669         if make-excel-com
      670         then do:
      671   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      672   if valid-handle(ch#WorkSheet) then
      673   RELEASE OBJECT ch#WorkSheet no-error.
      674   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      675   if valid-handle(ch#Workbook) then
      676   RELEASE OBJECT ch#Workbook no-error.
      677   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      678   if valid-handle(ch#ExcelApplication) then
      679   RELEASE OBJECT ch#ExcelApplication no-error.
      680            create "Excel.Application" ch#excelApplication connect no-error.
      681            if error-status:error
      682            then do :
      683           create "Excel.Application" ch#excelApplication no-error.
      684       if error-status :error then do:
      685           message
      686           "Ошибка при запуске Excel" skip
      687           error-status :get-message(1) skip
      688           view-as alert-box error .
      689           undo, return error .
      690       end.
      691            end.
      692            assign
      693               num#str#  = 0.
      694               v-ch#excelApplication  = ch#excelApplication.
      695               v-ch#excelApplication:Interactive = false.
      696               v-ch#excelApplication:ScreenUpdating = false.
      697               v-ch#excelApplication:Visible = false.
      698               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
      699               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
      700               v-ch#Worksheet = ch#WorkSheet.
      701               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
      702               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
      703               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
      704               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
      705            no-error .
      706            if error-status:error
      707            then do:
      708               Make-Excel-com = false .
      709               Make-Excel = false .
      710               output Stream  ForExcel close.
      711               os-delete value( string( session:temp-directory ) +
      712                              "rpt" + string( g#report-num ) + ".txt":U ) .
      713               os-delete value( string( session:temp-directory ) +
      714                              "rpt" + string( g#report-num ) + ".frm":U ) .
      715               return.
      716            end.
      717         end.
      718      end.
      719   end.
      720   procedure CloseForExcel :
      721      define variable ii as integer no-undo .
      722      define variable vsheet-num as integer no-undo.
      723      if Make-Excel
      724      then  do:
      725         output Stream  ForExcel close.
      726         os-delete value( string( session:temp-directory ) +
      727                                "rpt" + string( g#report-num ) + ".txt":U ) .
      728         os-delete value( string( session:temp-directory ) +
      729                                "rpt" + string( g#report-num ) + ".frm":U ) .
      730         define buffer buf_sheetf for sheetf.
      731         find last buf_sheetf no-error .
      732         if available buf_sheetf
      733         then
      734            vsheet-num = buf_sheetf.sheet-num.
      735         if vsheet-num > 1
      736         then do:
      737            do ii = 2 to vsheet-num:
      738               os-delete value( string( session:temp-directory ) +
      739                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
      740            end.
      741         end.
