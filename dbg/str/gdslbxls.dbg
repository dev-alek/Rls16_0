     3234           entry(1, f-n, ".") = "attr-value_"
     3235           f-n = replace(f-n, ".", "")
     3236           t-name = entry(1, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), ".").
     3237         end.
     3238         when "function":U then do:
     3239           assign
