     2457     end.
     2458   end procedure.
     2459   procedure uf-get :
     2460     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     2461     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     2462     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     2463     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     2464     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     2465     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     2466     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     2467     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     2468     do
     2469     on error undo, return error
     2470     :
     2471       define buffer buf_usr-flt for ubflt.usr-flt .
     2472       define variable v-use-List_     as logical   no-undo .
     2473       define variable v-type-List_     as character no-undo .
     2474       define variable v-format-List_   as character no-undo .
     2475       define variable v-use-Naim      as logical   no-undo .
     2476       define variable v-type-Naim      as character no-undo .
     2477       define variable v-format-Naim    as character no-undo .
     2478       define variable v-use-print-graft as logical   no-undo .
     2479       define variable v-use-sort-gr     as logical   no-undo .
     2480       define variable v-use-type-price  as logical   no-undo .
     2481       define variable v-use-type-val    as logical   no-undo .
     2482       define variable v-label          as character no-undo .
     2483       define variable v-tooltip        as character no-undo .
     2484       define variable v-user-can-edit  as logical   no-undo .
     2485       define variable v-output-display as logical   no-undo .
     2486       define variable v-other          as character no-undo .
     2487       run uf-name in this-procedure
     2488          (input  entry(1, p-code, chr(4))
     2489         ,output v-use-List_
     2490         ,output v-type-List_
     2491         ,output v-format-List_
     2492         ,output v-use-Naim
     2493         ,output v-type-Naim
     2494         ,output v-format-Naim
     2495         ,output v-use-print-graft
     2496         ,output v-use-sort-gr
     2497         ,output v-use-type-price
     2498         ,output v-use-type-val
     2499         ,output v-label
     2500         ,output v-tooltip
     2501         ,output v-user-can-edit
     2502         ,output v-output-display
     2503         ,output v-other
     2504         ) no-error .
     2505       if error-status :error then do:
     2506         undo, return error return-value .
     2507       end.
     2508       find first buf_usr-flt no-lock where
     2509                  buf_usr-flt.Call-point     = p-code AND
     2510                  buf_usr-flt.user-name       = p-user-name
     2511         no-error .
     2512       if avail buf_usr-flt then do:
     2513         assign
     2514         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     2515         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     2516         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     2517         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     2518         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     2519         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     2520         .
     2521       end.
     2522       else do:
     2523         assign
     2524         p-List_        = (if v-use-List_       then "":U                    else ?)
     2525         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     2526         p-print-graft  = (if v-use-print-graft then no                      else ?)
     2527         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     2528         p-type-price   = (if v-use-type-price  then no                      else ?)
     2529         p-type-val     = (if v-use-List_       then no                      else ?)
     2530         .
     2531       end.
     2532     end.
     2533   end procedure.
     2534   procedure uf-set :
     2535     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     2536     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     2537     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     2538     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     2539     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     2540     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     2541     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     2542     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     2543     do
     2544     on error undo, return error
     2545     :
     2546       define buffer buf_usr-flt for ubflt.usr-flt .
     2547       define variable v-use-List_     as logical   no-undo .
     2548       define variable v-type-List_     as character no-undo .
     2549       define variable v-format-List_   as character no-undo .
     2550       define variable v-use-Naim      as logical   no-undo .
     2551       define variable v-type-Naim      as character no-undo .
     2552       define variable v-format-Naim    as character no-undo .
     2553       define variable v-use-print-graft as logical   no-undo .
     2554       define variable v-use-sort-gr   as logical   no-undo .
     2555       define variable v-use-type-price as logical   no-undo .
     2556       define variable v-use-type-val  as logical   no-undo .
     2557       define variable v-tooltip        as character no-undo .
     2558       define variable v-label          as character no-undo .
     2559       define variable v-user-can-edit  as logical   no-undo .
     2560       define variable v-output-display as logical   no-undo .
     2561       define variable v-other          as character no-undo .
     2562       run uf-name in this-procedure
     2563         (input  entry(1, p-code, chr(4))
     2564         ,output v-use-List_
     2565         ,output v-type-List_
     2566         ,output v-format-List_
     2567         ,output v-use-Naim
     2568         ,output v-type-Naim
     2569         ,output v-format-Naim
     2570         ,output v-use-print-graft
     2571         ,output v-use-sort-gr
     2572         ,output v-use-type-price
     2573         ,output v-use-type-val
     2574         ,output v-label
     2575         ,output v-tooltip
     2576         ,output v-user-can-edit
     2577         ,output v-output-display
     2578         ,output v-other
     2579         ) no-error .
     2580       if error-status :error then do:
     2581         undo, return error return-value .
     2582       end.
     2583       find first buf_usr-flt where
     2584                  buf_usr-flt.Call-point     = p-code AND
     2585                  buf_usr-flt.user-name       = p-user-name
     2586         no-error .
     2587       if not avail buf_usr-flt then do:
     2588           create buf_usr-flt .
     2589           assign
     2590           buf_usr-flt.call-point = p-code
     2591           buf_usr-flt.user-name  = p-user-name
     2592           .
     2593       end.
     2594       if avail buf_usr-flt then do:
     2595        assign
     2596        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     2597        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     2598        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     2599        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     2600        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     2601        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     2602       .
     2603       release buf_usr-flt.
     2604       end.
     2605       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     2606     end.
     2607   end procedure.
     2608   DEFINE VARIABLE iColumn                 AS INTEGER no-undo.
     2609   DEFINE VARIABLE ii as integer no-undo.
     2610   DEFINE VARIABLE vat-value like ub.doc-line.vat-pc no-undo .
     2611   DEFINE VARIABLE slt-value like ub.doc-line.slt-pc no-undo .
