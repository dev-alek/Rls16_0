     2649   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2650   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2651   function native-string returns character ( input p-string as character
     2652                                             ,input p-data-type as character
     2653                                             ,input p-format as character):
     2654   define variable v-string as character no-undo .
     2655   case p-data-type:
     2656     when 'character':U then do:
     2657       assign
     2658       v-string = string(p-string, p-format)
     2659       no-error .
     2660     end.
     2661     when 'date':U then do:
     2662       assign
     2663       v-string = string(date(p-string), p-format)
     2664       no-error .
     2665     end.
     2666     when 'decimal':U then do:
     2667       assign
     2668       v-string = string(decimal(p-string), p-format)
     2669       no-error .
     2670     end.
     2671     when 'integer':U then do:
     2672       assign
     2673       v-string = string(integer(p-string), p-format)
     2674       no-error .
     2675     end.
     2676     when 'logical':U then do:
     2677       assign
     2678       v-string = string(logical(p-string), p-format)
     2679       no-error .
     2680     end.
     2681   end case.
     2682   return v-string.
     2683   end function.
     2684   FUNCTION gdsreffi_cond-keep-name returns character ( buffer buf_goods for ub.goods):
     2685   define buffer buf_condition-keeping for ub.condition-keeping.
     2686   find first buf_condition-keeping no-lock where
     2687            buf_condition-keeping.cond-keep-code = buf_goods.cond-keep-code no-error.
     2688   IF AVAIL buf_condition-keeping then do:
     2689     return buf_condition-keeping.cond-keep-name.
     2690   end.
     2691   return "[!!Неизвестные УСЛОВИЯ ХРАНЕНИЯ]".
     2692   end function.
     2693   function gdsreffi_prod-grp-name returns character ( buffer buf_goods for ub.goods):
     2694   define buffer buf_clients for ub.clients.
     2695   find first buf_clients no-lock WHERE
     2696             buf_clients.obj-type = buf_goods.prod-type
     2697         and buf_clients.obj-code = buf_goods.prod-code no-error.
     2698   if available buf_clients then do:
     2699     return buf_clients.grp-name.
     2700   end.
     2701   return "[!!Неизвестная группа ПРОИЗВОДИТЕЛЯ]".
     2702   end function.
     2703   function gdsreffi_prod-name returns character ( buffer buf_goods for ub.goods):
     2704   define buffer buf_clients for ub.clients.
     2705   find first buf_clients no-lock WHERE
     2706             buf_clients.obj-type = buf_goods.prod-type
     2707         and buf_clients.obj-code = buf_goods.prod-code no-error.
     2708   if available buf_clients then do:
     2709     return buf_clients.obj-name.
     2710   end.
     2711   return "[!!Неизвестный ПРОИЗВОДИТЕЛЬ]".
     2712   end function.
     2713   function gdsreffi_prt-root-name returns character ( buffer buf_goods for ub.goods):
     2714   define buffer buf_gds-prt for ub.gds-prt.
     2715   find first buf_gds-prt no-lock where
     2716           buf_gds-prt.upper-code = buf_goods.prt-root NO-ERROR.
     2717   if available buf_gds-prt then do:
     2718     return buf_gds-prt.node-name.
     2719   end.
     2720   return "[!!Неизвестный корень ШКАЛЫ]".
     2721   end function.
     2722   function gdsreffi_last-inv returns character ( buffer buf_goods for ub.goods
     2723                                                 ,input p-obj-type as character
     2724                                                 ,input p-obj-code as integer  ):
     2725   define variable v-last-inv-date-num as character format "X(45)" no-undo.
     2726   define buffer buf_doc-line for ub.doc-line.
     2727   define buffer buf_trn-doc  for ub.trn-doc.
     2728   find last buf_doc-line no-lock where
     2729             buf_doc-line.artic = buf_goods.artic
     2730         and buf_doc-line.prod-code = buf_goods.prod-code
     2731         and buf_doc-line.prod-type = buf_goods.prod-type
     2732         and buf_doc-line.obj-code = p-obj-code
     2733         and buf_doc-line.obj-type = p-obj-type
     2734         and buf_doc-line.status_ = 'факт':U
     2735         and buf_doc-line.ext-doc-type = 'vt':U no-error.
     2736   if available buf_doc-line then do :
     2737     find first buf_trn-doc no-lock where
     2738                buf_trn-doc.doc-code = buf_doc-line.doc-code no-error.
     2739     if available buf_trn-doc then do :
     2740       assign
     2741         v-last-inv-date-num = string(buf_trn-doc.fact-date) + " № " + buf_trn-doc.doc-code
     2742       .
     2743       return v-last-inv-date-num.
     2744     end.
     2745   end.
     2746   return "[!!Нет инвентаризаций по данному товару]" .
     2747   end function.
