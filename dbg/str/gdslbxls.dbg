     3596          and buf_usr-flt_custom-labels.call-point = 'barcodfi':U
     3597          and buf_usr-flt_custom-labels.tbl-name = 'bar-code':U
     3598       by buf_usr-flt_custom-labels.custom-label
     3599          :
