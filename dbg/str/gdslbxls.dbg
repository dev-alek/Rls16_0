     3463                               ,buffer ub.gds-obj
     3464                               ,input p-curr-obj-type
     3465                               ,input p-curr-obj-code
     3466                               ,INPUT entry(jj-1, v-dop0, "*":U)
     3467                               ,input yes
     3468                               ,INPUT-OUTPUT f-value-1
     3469                               )  NO-ERROR .
     3470               assign
     3471               f-value = f-value + (if f-value = "":U then "":U else chr(32)) + f-value-1
     3472               .
     3473             end.
     3474           end.
     3475           else do:
     3476             run gds-ref-fi in this-procedure (
     3477                              buffer ub.goods
     3478                             ,buffer ub.gds-obj
     3479                             ,input p-curr-obj-type
     3480                             ,input p-curr-obj-code
     3481                             ,INPUT v-dop0
     3482                             ,input yes
     3483                             ,INPUT-OUTPUT f-value
     3484                             )  NO-ERROR .
     3485           end.
     3486           if Make-Excel then  put   stream ForExcel unformatted
     3487           if entry(jj, f-name) = "artic" then chr(4) else "":U
     3488           string(replace(f-value, chr(10), ""), substitute("X(&1)", entry(jj, ubflt.filter.Where-ysl)))
     3489           (if jj < j-n
     3490           then
     3491           CHR(9)
     3492           else chr(10))
     3493           .
     3494         end.
     3495       END CASE.
     3496     end.
     3497   END.
