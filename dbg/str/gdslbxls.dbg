     2804   FUNCTION gdsreffi_last-pcnt returns decimal ( buffer buf_goods for ub.goods
     2805                                             ,input p-obj-type as character
     2806                                             ,input p-obj-code as integer):
     2807   define buffer buf_gds-obj for ub.gds-obj.
     2808   define variable v-value as decimal no-undo .
     2809   find first buf_gds-obj no-lock where
     2810               buf_gds-obj.gds-code = buf_goods.gds-code
     2811         AND  buf_gds-obj.obj-type = p-obj-type
     2812         AND  buf_gds-obj.obj-code = p-obj-code no-error .
     2813   if available buf_gds-obj then do:
     2814     assign
     2815     v-value =
     2816               (buf_gds-obj.price-sale / (if v-curr-r-b = 'base':U
     2817                                         then buf_gds-obj.last-base
     2818                                         else buf_gds-obj.last-rubl)
     2819                 * 100 - 100)
     2820     no-error
     2821     .
     2822   end.
     2823   else do:
     2824     v-value = ?  .
     2825   end.
     2826   return v-value.
     2827   end FUNCTION.
     2828   FUNCTION gdsreffi_in-doc-cli-name returns character ( buffer buf_goods for ub.goods
     2829                                             ,input p-obj-type as character
     2830                                             ,input p-obj-code as integer):
     2831   define buffer buf_gds-obj for ub.gds-obj.
     2832   define buffer buf_trn-doc for ub.trn-doc.
     2833   define buffer buf_clients for ub.clients.
     2834   define buffer buf_parts for ub.parts.
     2835   define variable v-value as decimal no-undo .
     2836   for first buf_gds-obj no-lock where
     2837               buf_gds-obj.gds-code = buf_goods.gds-code
     2838         AND  buf_gds-obj.obj-type = p-obj-type
     2839         AND  buf_gds-obj.obj-code = p-obj-code ,
     2840             first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_gds-obj.in-code,
     2841             first buf_clients no-lock where buf_clients.obj-type = buf_trn-doc.cli-type and  buf_clients.obj-code = buf_trn-doc.cli-code:
     2842           return buf_clients.obj-name .
     2843   end.
     2844   for first buf_parts no-lock where
     2845              buf_parts.artic = buf_goods.artic
     2846         and  buf_parts.prod-type = buf_goods.prod-type
     2847         and  buf_parts.prod-code = buf_goods.prod-code
     2848         AND  buf_parts.obj-type = p-obj-type
     2849         AND  buf_parts.obj-code = p-obj-code
     2850         and  buf_parts.out-code = 'free-zone':U ,
     2851             first buf_clients no-lock where buf_clients.obj-type = buf_parts.supp-type and  buf_clients.obj-code = buf_parts.supp-code:
     2852           return buf_clients.obj-name .
     2853   end.
     2854   end FUNCTION.
     2855   PROCEDURE gds-ref-fi:
     2856   DEFINE PARAMETER BUFFER fi-goods for ub.goods.
     2857   DEFINE PARAMETER BUFFER fi-gds-obj for ub.gds-obj.
     2858   DEFINE INPUT PARAMETER v-obj-type like ub.clients.obj-type.
     2859   DEFINE INPUT PARAMETER v-obj-code like ub.clients.obj-code.
     2860   DEFINE INPUT PARAMETER v-gds-ref-fi as char no-undo.
     2861   define input parameter p-excel as logical no-undo .
     2862   DEFINE INPUT-OUTPUT PARAMETER fi-1 as char no-undo.
     2863   DEFINE VARiable II AS INTEGER NO-UNDO.
     2864   DEFINE BUFFER fi-gds-prt for ub.gds-prt.
     2865   define buffer fi-condition-keeping for ub.condition-keeping .
     2866   DEFINE variable myfi as char no-undo extent 1.
     2867   DEFINE VARiable jj as integer no-undo init 1.
     2868   DEFINE variable Myformat as character no-undo.
     2869   DEFINE VARiable vNum-entries as integer no-undo.
     2870   DEFINE VARiable entry-ii as character no-undo.
     2871   DEFINE VARiable vvalue as character no-undo.
     2872   DEFINE VARiable vtype as character no-undo.
     2873   DEFINE VARiable vlabel as character no-undo.
     2874   define buffer buf_usr-flt_custom-labels for usr-flt_custom-labels.
     2875     IF v-gds-ref-fi = "" then
     2876     v-gds-ref-fi = 'goods.gds-name,goods.#prod-name,goods.#prt-root-name,goods.negative-rest,gds-obj.#VAT-PC,goods.ALPHA1,gds-obj.in-date':U.
     2877    if avail fi-goods then do:
     2878         FIND FIRST fi-gds-obj NO-LOCK where
     2879                    fi-gds-obj.gds-code = fi-goods.gds-code AND
     2880                    fi-gds-obj.obj-type = p-curr-obj-type AND
     2881                    fi-gds-obj.obj-code = p-curr-obj-code NO-ERROR.
     2882   vNum-entries = NUm-ENTRIES(v-gds-ref-fi).
     2883     DO ii = 1 to vNum-entries:
     2884       entry-ii = ENTRY(ii, v-gds-ref-fi).
     2885       find first buf_usr-flt_custom-labels where
     2886                 buf_usr-flt_custom-labels.tbl-name = entry(1, entry-ii, ".")
     2887            and  buf_usr-flt_custom-labels.fld-name = entry(2, entry-ii, ".")
     2888            and  buf_usr-flt_custom-labels.call-point =  'gdsreffi':U
     2889            and  buf_usr-flt_custom-labels.call-type = 'add-fields':U no-error.
     2890       if  available buf_usr-flt_custom-labels then do:
     2891         case buf_usr-flt_custom-labels.tbl-name:
     2892           when 'goods':U then do:
     2893             if entry(2, entry-ii, ".") begins "#" then do:
     2894               assign
     2895               myfi[jj] =
     2896                          string(dynamic-function(buf_usr-flt_custom-labels.custom-view-func, buffer fi-goods)
     2897                                 , buf_usr-flt_custom-labels.custom-format) no-error .
     2898             end.
     2899             else do:
     2900               myfi[jj] =
     2901                           string(buffer fi-goods:buffer-field(buf_usr-flt_custom-labels.fld-name):buffer-value, buf_usr-flt_custom-labels.custom-format).
     2902             end.
     2903           end.
     2904           when 'gds-obj':U then do:
     2905             if entry(2, entry-ii, ".") begins "#" then do:
     2906               assign
     2907               myfi[jj] =
     2908                          string(dynamic-function(buf_usr-flt_custom-labels.custom-view-func
     2909                                         ,buffer fi-goods
     2910                                         ,input v-obj-type
     2911                                         ,input v-obj-code
     2912                                         )
     2913                          , buf_usr-flt_custom-labels.custom-format) no-error .
     2914             end.
     2915             else do:
     2916               if available fi-gds-obj then do:
     2917                 myfi[jj] =
     2918                             string(buffer fi-gds-obj:buffer-field(buf_usr-flt_custom-labels.fld-name):buffer-value, buf_usr-flt_custom-labels.custom-format).
     2919               end.
     2920               else do:
     2921                 myfi[jj] =
     2922                 ""
     2923                 .
     2924               end.
     2925             end.
     2926           end.
     2927           when 'goods-attr':U then do:
     2928             if entry(2, entry-ii, ".") begins "#" then do:
     2929             end.
     2930             else do:
     2931               vvalue = "[!!Ошибка]".
     2932               run gds-attr-value in this-procedure ( fi-goods.gds-code
     2933                                                     ,input entry(2, buf_usr-flt_custom-labels.fld-name, "_")
     2934                                                     ,output vvalue
     2935                                                     ,output vtype) no-error.
     2936               myfi[jj] =
     2937                          native-string(vvalue, buf_usr-flt_custom-labels.fld-data-type, buf_usr-flt_custom-labels.custom-format).
     2938             end.
     2939           end.
     2940           when 'gds-obj-attr':U then do:
     2941             if entry(2, entry-ii, ".") begins "#" then do:
     2942             end.
     2943             else do:
     2944               vvalue = "[!!Ошибка]".
     2945               run gdsoattr-value in this-procedure (
     2946                                                     input  entry(2, buf_usr-flt_custom-labels.fld-name, "_")
     2947                                                    ,input  fi-goods.gds-code
     2948                                                    ,input v-obj-type
     2949                                                    ,input v-obj-code
     2950                                                    ,output vvalue
     2951                                                    ,output vtype
     2952                                                    ) no-error .
     2953               myfi[jj] =
     2954                          native-string(vvalue, buf_usr-flt_custom-labels.fld-data-type, buf_usr-flt_custom-labels.custom-format).
     2955             end.
     2956           end.
     2957           when 'gds-host-attr':U then do:
     2958             if entry(2, entry-ii, ".") begins "#" then do:
     2959             end.
     2960             else do:
     2961               vvalue = "[!!Ошибка]".
     2962               run gdshattr-value in this-procedure (
     2963                                                     input  entry(2, buf_usr-flt_custom-labels.fld-name, "_")
     2964                                                    ,input  fi-goods.gds-code
     2965                                                    ,input v-obj-type
     2966                                                    ,input v-obj-code
     2967                                                    ,output vvalue
     2968                                                    ,output vtype
     2969                                                    ) no-error .
     2970               myfi[jj] =
     2971                          native-string(vvalue, buf_usr-flt_custom-labels.fld-data-type, buf_usr-flt_custom-labels.custom-format).
     2972             end.
     2973           end.
     2974         end case.
     2975         if p-excel then do:
     2976           if buf_usr-flt_custom-labels.fld-data-type = 'decimal':U
     2977           or buf_usr-flt_custom-labels.fld-data-type = 'integer':U
     2978           then do:
     2979             myfi[jj] = replace(myfi[jj], chr(44), "").
     2980           end.
     2981         end.
     2982         if jj = 9 then LEAVE.
     2983       end.
     2984         else if entry(1, entry-ii, ".") = 'goods-attr':U then  do:
     2985           vvalue = "[!!Ошибка]".
     2986                   run gds-attr-value in this-procedure ( fi-goods.gds-code
     2987                                                         ,input (SUBSTRING (entry-ii,INDEX(entry-ii,"_") + 1))
     2988                                                         ,output vvalue
     2989                                                         ,output vtype) no-error.
     2990                   myfi[jj] = vvalue.
     2991         end.
     2992     END.
     2993     end.
     2994     assign
     2995     fi-1 = myfi[1]
     2996     .
     2997   END PROCEDURE.
     2998   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2999   FUNCTION barcodfi_node-code-name returns character ( buffer buf_bar-code for ub.bar-code):
     3000   define variable v-f-name as character no-undo .
     3001   FIND FIRST buf_gds-prt No-LOCK where
     3002               buf_gds-prt.node-code = buf_bar-code.node-code NO-ERROR.
     3003   if available buf_gds-prt then do:
     3004     assign
     3005     v-f-name = buf_gds-prt.f-name.
     3006   end.
     3007   else do:
     3008     v-f-name = "!!!Неизвестный признак".
     3009   end.
     3010   return v-f-name .
     3011   end function.
     3012   PROCEDURE barcodfi:
     3013   DEFINE PARAMETER BUFFER fi-bar-code for ub.bar-code.
     3014   DEFINE INPUT PARAMETER v-barcodfi as char no-undo.
     3015   define input parameter p-excel as logical no-undo .
     3016   DEFINE INPUT-OUTPUT PARAMETER fi-1 as char no-undo.
     3017   DEFINE VARiable II AS INTEGER NO-UNDO.
     3018   DEFINE variable myfi as char no-undo extent 1.
     3019   DEFINE VARiable jj as integer no-undo init 1.
     3020   DEFINE variable Myformat as character no-undo.
     3021   DEFINE VARiable vNum-entries as integer no-undo.
     3022   DEFINE VARiable entry-ii as character no-undo.
     3023   DEFINE VARiable vvalue as character no-undo.
     3024   DEFINE VARiable vtype as character no-undo.
     3025   DEFINE VARiable vlabel as character no-undo.
     3026   define buffer buf_usr-flt_custom-labels for usr-flt_custom-labels.
     3027     IF v-barcodfi = "" then
     3028     v-barcodfi = 'bar-code.b-code,bar-code.unit-cli,bar-code.cli-base-rate,bar-code.gds-code,bar-code.#node-code-name,bar-code.in-code,bar-code.part-code,bar-code.cr-db-num':U.
     3029    if avail fi-bar-code then do:
     3030   vNum-entries = NUm-ENTRIES(v-barcodfi).
     3031     DO ii = 1 to vNum-entries:
     3032       entry-ii = ENTRY(ii, v-barcodfi).
     3033       find first buf_usr-flt_custom-labels where
     3034                 buf_usr-flt_custom-labels.tbl-name = entry(1, entry-ii, ".")
     3035            and  buf_usr-flt_custom-labels.fld-name = entry(2, entry-ii, ".")
     3036            and  buf_usr-flt_custom-labels.call-point = 'barcodfi':U
     3037            and  buf_usr-flt_custom-labels.call-type = 'add-fields':U no-error.
     3038       if  available buf_usr-flt_custom-labels then do:
     3039         case buf_usr-flt_custom-labels.tbl-name:
     3040           when 'bar-code':U then do:
     3041             if entry(2, entry-ii, ".") begins "#" then do:
     3042               assign
     3043               myfi[jj] = string(dynamic-function(buf_usr-flt_custom-labels.custom-view-func, buffer fi-bar-code)
     3044                                 , buf_usr-flt_custom-labels.custom-format) no-error .
     3045             end.
     3046             else do:
     3047               myfi[jj] =  string(buffer fi-bar-code:buffer-field(buf_usr-flt_custom-labels.fld-name):buffer-value, buf_usr-flt_custom-labels.custom-format).
     3048             end.
     3049           end.
     3050         end case.
     3051         if p-excel then do:
     3052           if buf_usr-flt_custom-labels.fld-data-type = 'decimal':U
     3053           or buf_usr-flt_custom-labels.fld-data-type = 'integer':U
     3054           then do:
     3055             myfi[jj] = replace(myfi[jj], chr(44), "").
     3056           end.
     3057         end.
     3058       end.
     3059     END.
     3060     end.
     3061     assign
     3062     fi-1 = myfi[1]
     3063     .
     3064   END PROCEDURE.
     3065   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3066   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3067     (output v-curr-r-b
     3068     )  .
     3069   FUNCTION get-function returns character(
     3070   input p-f-name as character,
     3071   input p-format as character
     3072   ):
     3073   define variable main-b-code like ub.bar-code.b-code no-undo .
     3074   define variable bar_code as character no-undo .
     3075   define variable bar_bar_code as character no-undo .
     3076   define variable price-sale as decimal no-undo .
     3077   define variable for-road as decimal no-undo .
     3078   define variable for-excise as decimal no-undo .
     3079   define variable v-doc-num as character no-undo .
     3080   define variable v-last-inv-date-num as character no-undo.
     3081     do
     3082     on error undo, return error
     3083     :
     3084       CASE p-f-name:
     3085         when "iColumn":U then do:
     3086           return string(iColumn, p-format).
     3087         end.
     3088         when "qnty":U then do:
     3089           return string(bb-list.qnty,  p-format).
     3090         end.
     3091         when "vat-value":U then do:
     3092           return string(vat-value, p-format).
     3093         end.
     3094         when "slt-value":U then do:
     3095           return string(slt-value, p-format).
     3096         end.
     3097         when "price-sale":U then do:
     3098   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3099     (input  bb-list.gds-code
     3100     ,input  ?
     3101     ,output main-b-code
     3102     )  .
     3103   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3104   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3105     (input  p-curr-obj-type
     3106     ,input  p-curr-obj-code
     3107     ,input  bb-list.b-code
     3108     ,input  main-b-code
     3109     ,input  0
     3110     ,output v-doc-num
     3111     ,output price-sale
     3112     ,output for-road
     3113     ,output for-excise
     3114     ) no-error .
     3115           return string(price-sale, p-format).
     3116         end.
     3117         when "node-name":U then do:
     3118           return string(v-f-name, p-format).
     3119         end.
     3120         when "gdsbcode-graphic":U then do:
     3121   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3122     (input  bb-list.gds-code
     3123     ,input  ?
     3124     ,output main-b-code
     3125     )  .
     3126           RUN gen-bc in this-procedure ( input main-b-code, output bar_code ).
     3127           run gbl/bctotext.p (
     3128                           input (if length(bar_code) = 13 then 'ean13':U else 'ean8':U)
     3129                          ,input bar_code
     3130                          ,output bar_bar_code) no-error .
     3131           return (chr(4) + bar_bar_code).
     3132         end.
     3133         when "last-inv" then do :
     3134           find last buf_doc-line no-lock where
     3135                     buf_doc-line.artic = bb-list.artic
     3136                 and buf_doc-line.prod-code = bb-list.prod-code
     3137                 and buf_doc-line.prod-type = bb-list.prod-type
     3138                 and buf_doc-line.obj-code = p-curr-obj-code
     3139                 and buf_doc-line.obj-type = p-curr-obj-type
     3140                 and buf_doc-line.status_ = 'факт':U
     3141                 and buf_doc-line.ext-doc-type = 'vt':U no-error.
     3142           if available buf_doc-line then do :
     3143             find first buf_trn-doc no-lock where
     3144                       buf_trn-doc.doc-code = buf_doc-line.doc-code no-error.
     3145             if available buf_trn-doc then do :
     3146               assign
     3147                 v-last-inv-date-num = string(buf_trn-doc.fact-date) + " № " + buf_trn-doc.doc-code
     3148               .
     3149             end.
     3150           end.
     3151           else do :
     3152             assign
     3153               v-last-inv-date-num = "[!!Нет инвентаризаций по данному товару]"
     3154             .
     3155           end.
     3156           return v-last-inv-date-num.
     3157         end.
     3158       END CASE.
     3159     end.
     3160   end FUNCTION.
     3161   for each buf_usr-flt_custom-labels:
     3162     delete buf_usr-flt_custom-labels.
     3163   end.
     3164   for each  buf_custom-labels no-lock where
     3165             buf_custom-labels.call-type = 'add-fields':U
     3166         and buf_custom-labels.call-point = 'gdsreffi':U:
     3167     create buf_usr-flt_custom-labels.
     3168     buffer-copy buf_custom-labels to buf_usr-flt_custom-labels.
     3169   end.
     3170   for each  buf_custom-labels no-lock where
     3171             buf_custom-labels.call-type = 'add-fields':U
     3172         and buf_custom-labels.call-point = 'barcodfi':U:
     3173     create buf_usr-flt_custom-labels.
     3174     buffer-copy buf_custom-labels to buf_usr-flt_custom-labels.
     3175   end.
     3176   if not valid-handle(my-handle) then do:
     3177     assign
     3178     my-handle = parparentproc.
     3179   end.
     3180   run init-prn-template in this-procedure .
     3181   run gbl/prntput.p (c-point, output v-rec).
     3182   run gbl/prntmpl.w (
     3183                   input parparentproc
     3184                 , input "":U
     3185                 , input c-point
     3186                 , input Tbl
     3187                 , input join-tbl
     3188                 , input Fld
     3189                 , input Lab
     3190                 , input Spr
     3191                 , input v-size
     3192                 , input v-format
     3193                 , input Dim
     3194                 , input-output v-rec
     3195                 , OUTPUT V-LENGTH
     3196                 , OUTPUT V-NUM-CLMN
     3197               ).
     3198   if v-rec = ? then return.
     3199   find first ubflt.filter no-lock where
     3200              recid(ubflt.filter) = v-rec no-error .
     3201   if not avail ubflt.filter then return.
     3202   do jj = 1 to num-entries(ubflt.filter.Fields-sort):
     3203     assign
     3204     f-name-1 = "":U
     3205     v-frm-set = no
     3206     .
     3207     do jj-1 = 1 to num-entries(entry(jj, ubflt.filter.Fields-sort), "*":U):
     3208       if (entry(2, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), ".") = "artic"
     3209           or
     3210           entry(2, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), ".") = "b-str")
     3211       and lookup(string(jj) + "=@":U, v-eng-frm) = 0
     3212       then
     3213       assign
     3214       v-osn-frm = v-osn-frm + (if v-osn-frm = "":U then "":U else ";") + string(jj) + "=0":U
     3215       v-eng-frm = v-eng-frm + (if v-eng-frm = "":U then "":U else ";") + string(jj) + "=@":U
     3216       sheetf.colformat = v-osn-frm + chr(4) + v-eng-frm
     3217       v-frm-set = yes
     3218       .
     3219       case entry(1, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), "."):
     3220         when 'goods':U or when 'gds-obj':U then do:
     3221           assign
     3222           f-n = entry(2, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), ".")
     3223           t-name = entry(1, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), ".")
     3224           .
     3225         end.
     3226         when 'gds-obj-attr':U
     3227         or
     3228         when 'gds-host-attr':U
     3229         or
     3230         when 'goods-attr':U
     3231         then do:
     3232           assign
