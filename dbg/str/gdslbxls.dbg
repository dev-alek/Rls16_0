     2634   define variable v-dop0 as character no-undo .
     2635   define variable v-dop1 as character no-undo .
     2636   define variable v-dop2 as character no-undo .
     2637   define buffer buf_custom-labels for ub.custom-labels.
     2638   define buffer buf_usr-flt_custom-labels for usr-flt_custom-labels.
     2639   define buffer buf_gds-prt for ub.gds-prt.
