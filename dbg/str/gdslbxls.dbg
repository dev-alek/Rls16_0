     3431                     f-value-1 = chr(4) + bb-list.b-str.
     3432                   end.
     3433                   when "b-on" then do:
     3434                     f-value-1 = "yes":U.
     3435                   end.
     3436                 END CASE.
     3437                 if Make-Excel then  put   stream ForExcel unformatted
     3438                 string(f-value-1, (chr(34) + entry(jj, ubflt.filter.Where-ysl-rus, chr(4)) + chr(34)))
     3439                 (if jj < j-n
