     3241           f-n = entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U)
     3242           .
     3243           if entry(2, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), ".") = 'gdsbcode-graphic':U
     3244           then do:
     3245             assign
     3246             v-osn-frm = v-osn-frm + (if v-osn-frm = "":U then "":U else ";") + string(jj) + "=0":U
     3247             v-eng-frm = v-eng-frm + (if v-eng-frm = "":U then "":U else ";") + string(jj) + "=@":U
     3248             v-frm-set = yes
     3249             .
     3250             assign
     3251             sheetf.colformat = v-osn-frm + chr(4) + v-eng-frm
     3252             Sheetf.Bas-File = "exe/anyl-xls.bas"
     3253             Sheetf.Bas-Params = Sheetf.Bas-Params +
     3254                                 (if Sheetf.Bas-Params = '':U
     3255                                  then '':U
     3256                                  else chr(4)) + string(jj)
     3257             .
     3258           end.
     3259         end.
     3260         when 'bar-code':U
     3261         or
     3262         when 'prod-bc':U
     3263         then do:
     3264           assign
     3265           f-n = entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U)
     3266           t-name = ''
     3267           .
     3268           if num-entries(f-n, ".") = 2 and
     3269           entry(2, f-n, ".":U) = "b-str" then do:
     3270             assign
     3271             v-osn-frm = v-osn-frm + (if v-osn-frm = "":U then "":U else ";") + string(jj) + "=0":U
     3272             v-eng-frm = v-eng-frm + (if v-eng-frm = "":U then "":U else ";") + string(jj) + "=@":U
     3273             v-frm-set = yes
     3274             .
     3275           end.
     3276         end.
     3277       END CASE.
     3278       assign
     3279       f-name-1 = f-name-1 + (if f-name-1 = "":U then "":U else "*":U) + (if t-name <> '':U then (t-name + ".") else '') + f-n
     3280       .
     3281       if v-frm-set = no then do:
     3282         assign
     3283         v-osn-frm = v-osn-frm + (if v-osn-frm = "":U then "":U else ";") + string(jj) + "=" +
     3284                     prnfield_get-fformat(entry(jj, ubflt.filter.lst-cend)
     3285                                ,entry(jj, ubflt.filter.where-ysl-rus, chr(4)))
     3286         .
     3287       end.
     3288     end.
     3289     assign
     3290     f-name = f-name + (if f-name = "":U then "":U else chr(44)) + f-name-1
     3291     .
     3292   end.
     3293   assign
     3294   j-n = num-entries(f-name)
     3295   .
     3296   Sheetf.Bas-Params = string(5) + chr(4) + Sheetf.Bas-Params.
     3297   Make-excel = yes.
     3298   run get-report-num  in parParentProc(output g#report-num).
     3299   if Make-Excel then
     3300   RUN OpenForExcel in this-procedure .
