     3601                                           ,input buf_usr-flt_custom-labels.custom-label
     3602                                           ,input (if buf_usr-flt_custom-labels.custom-view-func <> ''
     3603                                                   then substitute("attr.&1", buf_usr-flt_custom-labels.fld-data-type)
     3604                                                   else '')
     3605                                           ,input integer(buf_usr-flt_custom-labels.widget-width)
     3606                                           ,input buf_usr-flt_custom-labels.custom-format
     3607                                           ,input-output fld
     3608                                           ,input-output lab
     3609                                           ,input-output spr
     3610                                           ,input-output v-size
     3611                                           ,input-output v-format
     3612                                           ,input-output dim)  no-error.
     3613       end.
     3614       assign
     3615       fld = fld
     3616       lab = lab
     3617       dim = dim + chr(44)
