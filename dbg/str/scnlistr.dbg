      153   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      154   def  new shared  temp-table goa-list no-undo like ub.gds-obj-attr
      155                           field rc as recid
      156                           field to-del as  logical
      157                           field order-num as integer
      158                           index rci is unique rc to-del
      159                           index gds-code-i is primary gds-code obj-type obj-code attr-code to-del
      160                           index iobj obj-type obj-code
      161                           index io order-num
      162                           .
      163   do
      164   on error undo, return error return-value
      165   :
      166     run str/scn-list.w (
      167                    input parparentproc
      168                   ,input p-curr-host-code
      169                   ,input p-curr-obj-type
      170                   ,input p-curr-obj-code).
      171   end.
