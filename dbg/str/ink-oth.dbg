      771               WIDTH 15
      772         pay-tot-rubl-return COLUMN-LABEL "Разн.по запр.за нал" FORMAT "->>>,>>>,>>9.99":U
      773         ub.inkas-pay.tot-sum FORMAT "->>>,>>>,>>9.99":U
      774         ub.inkas-pay.tot-base FORMAT "->>>,>>>,>>9.99":U
      775       WITH SEPARATORS SIZE 85 BY 8
