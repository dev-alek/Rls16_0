      758   temp-inkas-cash-desk.tot-rubl FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "abbr_rub_firstshift.эквивалент"
      759   temp-inkas-cash-desk.tot-rubl-return
      760             FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Разн.по запр.за нал"
      761   temp-inkas-cash-desk.tot-base FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "В баз.вал."
      762       WITH NO-ROW-MARKERS SEPARATORS SIZE 74.5 BY 5.46
      763            BGCOLOR 8 FONT 4
      764            TITLE BGCOLOR 8 "Выручка по кассам ОБЩАЯ" ROW-HEIGHT-CHARS .6 FIT-LAST-COLUMN.
      765   DEFINE BROWSE BR-INKAS-PAY
