      824        SPACE(8.09) SKIP(0.01)
      825       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      826            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      827            TITLE "Отчет о выручке":L.
      828   ASSIGN
      829          FRAME DIALOG-1:SCROLLABLE       = FALSE.
      830   ASSIGN
      831          BR-INKAS-PAY:NUM-LOCKED-COLUMNS IN FRAME DIALOG-1     = 1.
      832   ON CHOOSE OF b-print IN FRAME DIALOG-1
      833   DO:
      834   define variable sym1 as character init ":"   no-undo.
      835   define variable sym3 as character init ":"   no-undo.
      836   define variable sym4 as character init ":"   no-undo.
      837   define variable sym5 as character init ":"   no-undo.
      838   define variable sym6 as character init ":"   no-undo.
      839   define variable sym8 as character init ":"   no-undo.
      840   define variable Log-Res     as  logical      no-undo.
      841   define variable Line        as  character    no-undo.
      842   define variable date_string as  character    no-undo.
      843   define variable v-base-code LIKE ub.sysconf.base-code no-undo.
      844   define BUFFER buf_currency FOR ub.currency.
      845   define buffer b-ink-pay    for ub.inkas-pay .
      846   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      847   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      848     (input  inkas.host-code
      849     ,output v-base-code
      850     )  .
      851   FIND FIRST buf_currency NO-LOCK WHERE
      852               buf_currency.curr-code = v-base-code.
      853   DEFINE FRAME Benefit-Tot
      854   sym1 column-label ":" format "X(1)"
      855   ub.cash-pay.obj-name column-label "Вид оплаты" format "X(30)"
      856   sym3 column-label ":" format "X(1)"
      857   ub.currency.curr-name column-label "Валюта" format "X(20)"
      858   sym4 column-label ":" format "X(1)"
      859   b-ink-pay.tot-sum column-label "Сумма (в валюте)" format "->,>>>,>>>,>>>,>>9.99"
      860   sym5 column-label ":" format "X(1)"
      861   b-ink-pay.tot-base column-label "Сумма (в Б.Вал.)" format "->,>>>>,>>>,>>9.99"
      862   sym6 column-label ":" format "X(1)"
      863   b-ink-pay.tot-rubl column-label "Сумма (в рублях)" format "->,>>>,>>>,>>>,>>9.99"
      864   sym8 column-label ":" format "X(1)"
      865   HEADER  date_string AT 5 format "X(35)"
      866   string( "( Б.Вал. - " + caps( trim( buf_currency.curr-abbr ) ) + " )" ) format "X(20)" AT 42
      867   string( "Страница " ) format "x(9)" AT 105 PAGE-NUMBER(Prnlibstream) AT 115 FORMAT ">>9" SKIP
      868   Line format "X(126)" AT 1
      869   with width 160 down stream-io use-text .
      870   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      871   do:
      872     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      873       (input  v-cntxt-db-num
      874       ,input  v-cntxt-userid
      875       ,input  0
      876       ,input  'actn_cur-obj-proceeds_print':U
      877       ,input  'firm':U
      878       ,input  inkas.host-code
      879       ,input  '':U
      880       ,input  0
      881       ,input  0
      882       ,input  0
      883       ,input  0
      884       ,input  true
      885       ,output glog
      886       )  .
      887   end.
      888   if not glog then return "NO".
      889   if can-find( FIRST b-ink-pay WHERE b-ink-pay.inkas-code = inp-inkas-code ) then do:
      890     date_string = cur-time-print() .
      891     Line = fill( "-", 136 ).
      892     run prn-lib-open-stream  in this-procedure (
      893                                                 input parParentProc
      894                                                 ,input 62
      895                                                 ,input yes
      896                                                 ,input no
      897                                                 ).
      898     FORM HEADER
      899         Line format "X(126)" AT 1 SKIP
      900         "Продолжение - на следующей странице" AT 30 SKIP
      901         with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX .
      902     VIEW stream PrnLibstream FRAME BottomFrame .
      903     PUT stream PrnLibstream
      904     space(15) string( "ВЫРУЧКА  по  отчету  о  продажах  N  " + inp-inkas-code )
      905     format "X(120)" SKIP(1) .
      906     FOR EACH b-ink-pay WHERE
      907              b-ink-pay.inkas-code = inp-inkas-code NO-LOCK
      908     BREAK
      909     BY b-ink-pay.inkas-code
      910     BY b-ink-pay.pay-code
      911     BY b-ink-pay.curr-code
      912     with frame Benefit-Tot :
      913     ACCUMULATE
      914     b-ink-pay.tot-sum ( SUB-TOTAL BY b-ink-pay.curr-code )
      915     b-ink-pay.tot-base ( SUB-TOTAL BY b-ink-pay.curr-code )
      916     b-ink-pay.tot-rubl ( SUB-TOTAL BY b-ink-pay.curr-code )
      917     b-ink-pay.tot-rubl ( TOTAL )
      918     b-ink-pay.tot-base ( TOTAL )
      919     b-ink-pay.curr-code ( COUNT ) .
      920     if last-of( b-ink-pay.curr-code ) then do:
      921       FIND FIRST ub.cash-pay WHERE
      922                  ub.cash-pay.cdpay-code = b-ink-pay.pay-code AND
      923                  ub.cash-pay.curr-code = b-ink-pay.curr-code NO-LOCK .
      924       FIND FIRST ub.currency WHERE
      925                  ub.currency.curr-code = b-ink-pay.curr-code NO-LOCK.
      926       DISPLAY stream PrnLibstream
      927       sym1 ub.cash-pay.obj-name
      928       sym3 ub.currency.curr-name
      929       sym4 b-ink-pay.tot-sum
      930       sym5 b-ink-pay.tot-base
      931       sym6 b-ink-pay.tot-rubl
      932       sym8    .
      933       DOWN 1 stream PrnLibstream.
      934     end.
      935     if last( b-ink-pay.inkas-code ) then do:
      936       UNDERLINE stream PRnLibStream
      937       ub.cash-pay.obj-name
      938       b-ink-pay.tot-base
      939       b-ink-pay.tot-rubl .
      940       DISPLAY stream PrnLibstream
      941       sym1 " ИТОГО" @ ub.cash-pay.obj-name
      942                       ( ACCUM TOTAL b-ink-pay.tot-base ) @ b-ink-pay.tot-base
      943                       ( ACCUM TOTAL b-ink-pay.tot-rubl ) @ b-ink-pay.tot-rubl
      944                       sym8 .
      945      end.
      946    END.
      947    HIDE FRAME BottomFrame .
      948    PUT stream PrnLibstream
      949    Line format "X(126)" SKIP(2)
      950   space(10) "Директор _______________" format "X(30)"
      951                   "Старший продавец ______________" format "X(30)" SKIP(2)
      952   space(10) "Бухгалтер ______________" format "X(30)"
      953                   "Кассир ________________________" format "X(30)" SKIP .
      954    output stream PrnLibstream  CLOSE.
      955   run prn-lib-prn-file in this-procedure (
      956                                             input parParentProc
      957                                             ,input 0
      958                                             ).
      959   end.
      960   else
      961       message "Выручка НУЛЕВАЯ !" view-as alert-box information .
      962   END.
      963   ON ROW-DISPLAY OF BR-INKAS-PAY IN FRAME DIALOG-1
      964   DO:
      965     assign
      966         pay-tot-rubl = 0
      967         pay-tot-rubl-return = 0
      968         .
      969     IF available ub.inkas-pay THEN
      970     DO:
      971         pay-tot-rubl = inkas-pay.tot-rubl .
      972         RUN autotank-inkas-pay(input ub.inkas-pay.inkas-code  ,
      973                              input ub.inkas-pay.pay-code    ,
      974                              input ub.inkas-pay.curr-code   ,
      975                              input "autotank-sum-return" ,
      976                              output a-sum-return) .
      977            assign
      978                pay-tot-rubl = pay-tot-rubl - a-sum-return
      979                pay-tot-rubl-return = pay-tot-rubl-return - a-sum-return
      980                .
      981     END.
      982   END.
      983   ON VALUE-CHANGED OF BR-INKAS-PAY IN FRAME DIALOG-1
      984   DO:
      985     OPEN QUERY BR-pay-desk FOR EACH ub.inkas-pay-desk       WHERE ub.inkas-pay-desk.inkas-code = inp-inkas-code  AND ub.inkas-pay-desk.pay-code = ub.inkas-pay.pay-code  AND ub.inkas-pay-desk.curr-code = ub.inkas-pay.curr-code NO-LOCK     BY ub.inkas-pay-desk.pay-code.
      986   END.
      987   ON ROW-DISPLAY OF BR-pay-desk IN FRAME DIALOG-1
      988   DO:
      989       assign
      990         pay-desk-tot-rubl = 0
      991         .
      992     IF available ub.inkas-pay-desk THEN
      993     DO:
      994         pay-desk-tot-rubl = ub.inkas-pay-desk.tot-rubl .
      995         RUN autotank-inkas-pay-desk( input ub.inkas-pay-desk.inkas-code,
      996                                    input ub.inkas-pay-desk.pay-code ,
      997                                    input ub.inkas-pay-desk.curr-code ,
      998                                    input ub.inkas-pay-desk.pay-desk ,
      999                                    input ub.inkas-pay-desk.cashier ,
     1000                                    input "autotank-sum-return":U    ,
     1001                                    output a-sum-return)
     1002          .
     1003            assign
     1004                pay-desk-tot-rubl = pay-desk-tot-rubl - a-sum-return
     1005                .
     1006     END.
     1007   END.
     1008   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DIALOG-1:PARENT eq ?
     1009   THEN FRAME DIALOG-1:PARENT = ACTIVE-WINDOW.
     1010   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1011   on f5 of frame DIALOG-1 anywhere
     1012   do:
     1013     V-DOC-REC  = recid(inkas-pay).                reposition br-inkas-pay to recid v-doc-rec no-error. OPEN QUERY BR-pay-desk FOR EACH ub.inkas-pay-desk       WHERE ub.inkas-pay-desk.inkas-code = inp-inkas-code  AND ub.inkas-pay-desk.pay-code = ub.inkas-pay.pay-code  AND ub.inkas-pay-desk.curr-code = ub.inkas-pay.curr-code NO-LOCK     BY ub.inkas-pay-desk.pay-code.
     1014       apply "VALUE-CHANGED" to BR-cash-desk.
     1015   end.
     1016   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1017   on help of frame DIALOG-1
     1018   do:
     1019     run gbl/app_help.p
     1020       (input this-procedure :file-name
     1021       ,input ''
     1022       ,input ?
     1023       ) no-error.
     1024     if error-status :error then do:
     1025       message
     1026         "Ошибка при вызове помощи"
     1027         error-status :get-message(1)
     1028         view-as alert-box .
     1029     end.
     1030   end.
     1031   run minbtn-set in this-procedure .
     1032   on choose of b-help in frame DIALOG-1
     1033   do:
     1034     apply "help":u to frame DIALOG-1 .
     1035   end.
     1036   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1037   procedure minbtn-set :
     1038       do
     1039           on error undo, return error return-value
     1040           :
     1041           define variable ii              as integer       no-undo .
     1042           define variable fh              as widget-handle no-undo .
     1043           define variable hh              as widget-handle no-undo .
     1044           define variable v-h             as handle        extent 4 no-undo .
     1045           define variable v-name-button   as character     no-undo .
     1046           define variable v-help-old-x    as decimal       no-undo .
     1047           define variable v-help-old-y    as decimal       no-undo .
     1048           define variable v-help-old-size as decimal       no-undo .
     1049           define variable v-frame-width   as decimal       no-undo .
     1050           define variable jj              as integer       no-undo .
     1051           do
     1052               on error undo, return error
     1053               :
     1054               assign
     1055                   v-frame-width = frame DIALOG-1:width - 0.3
     1056                   fh            = frame DIALOG-1:first-child
     1057                   hh            = fh:first-child
     1058                   ii            = 1
     1059                   .
     1060               do while valid-handle(hh):
     1061                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1062                   do:
     1063                       case lc(hh:name) :
     1064                           when "b-help" then
     1065                               do:
     1066                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1067                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1068                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1069                                   hh:TOOLTIP = "Помощь" .
     1070                                   v-help-old-x = hh:column .
     1071                                   v-help-old-y = hh:row    .
     1072                                   v-help-old-size = hh:width .
     1073                                   hh:width-chars = 2.5 .
     1074                               end.
     1075                           when "b-print" then
     1076                               do:
     1077                                   hh:load-image("cmp/b-print.bmp":u) .
     1078                                   hh:TOOLTIP = "Печать" .
     1079                                   v-h[ii] = hh:handle .
     1080                                   ii = ii + 1 .
     1081                                   hh:width-chars = 3 .
     1082                               end.
     1083                           when "b-history" or
     1084                           when "b-hist" then
     1085                               do:
     1086                                   hh:load-image("cmp/b-hist.bmp":u) .
     1087                                   hh:TOOLTIP = "История" .
     1088                                   v-h[ii] = hh:handle .
     1089                                   ii = ii + 1 .
     1090                                   hh:width-chars = 3 .
     1091                               end.
     1092                           when "b-sch" then
     1093                               do:
     1094                                   hh:load-image("cmp/b-sch.bmp":u) .
     1095                                   hh:TOOLTIP = "Установка Фильтра" .
     1096                                   v-h[ii] = hh:handle .
     1097                                   ii = ii + 1 .
     1098                                   hh:width-chars = 3 .
     1099                               end.
     1100                           when "b-hist-user" then
     1101                               do:
     1102                                   hh:load-image("cmp/b-hist.bmp":u) .
     1103                                   hh:TOOLTIP = "История пользователя" .
     1104                                   ii = ii + 1 .
     1105                               end.
     1106                       end case.
     1107                   end.
     1108                   hh = hh:next-sibling.
     1109               end.
     1110               b-help:column = v-frame-width - b-help:width-chars.
     1111               jj = 0.
     1112               repeat ii = 4 to 1 by -1 :
     1113                   if valid-handle (v-h[ii] ) then
     1114                   do:
     1115                       jj  = jj + 1 .
     1116                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1117                       v-h[ii]:row    = v-help-old-y .
     1118                   end.
     1119               end.
     1120           end.
     1121       end.
     1122   end procedure.
     1123   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1124   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1125   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1126   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1127   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1128   define variable v-diasize-current-frame-height as decimal   no-undo .
     1129   define variable v-diasize-change-size          as logical   no-undo .
     1130   define variable v-diasize-resize-button        as handle    no-undo .
     1131   define variable v-diasize-wndmax               as logical   no-undo .
     1132   define variable v-diasize-wndstore             as logical   no-undo .
     1133   define variable v-diasize-proc-name            as character no-undo .
     1134   define variable v-diasize-browse-handle        as handle    no-undo .
     1135   define variable v-diasize-browse-number        as integer   no-undo .
     1136   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1137   define temp-table temp-diasize-handle no-undo
     1138     field handle-value  as handle
     1139     field save-position as decimal
     1140     index xpk is primary unique handle-value
     1141     .
     1142   define temp-table temp-browse-handle no-undo
     1143     field browse-type   as character
     1144     field browse-number as integer
     1145     field browse-handle as handle
     1146     field original-size as decimal
     1147     index xpk is primary unique browse-type browse-number
     1148     index xie browse-type browse-handle
     1149   .
     1150   procedure diasize_change-height :
     1151     define input  parameter p-change-value  as decimal   no-undo .
     1152     define input  parameter p-move-resize   as logical   no-undo .
     1153     define variable v-field-group-handle    as handle    no-undo .
     1154     define variable v-object-handle         as handle    no-undo .
     1155     define variable v-frame-height          as decimal   no-undo .
     1156     define variable v-frame-virtual-height  as decimal   no-undo .
     1157     define variable v-browse-height         as decimal   no-undo .
     1158     define variable v-window-height         as decimal   no-undo .
     1159     define variable v-window-virtual-height as decimal   no-undo .
     1160     define variable v-change-sign           as integer   no-undo .
     1161     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1162     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1163     if p-change-value > 0
     1164     then do:
     1165       if frame DIALOG-1 :height + p-change-value
     1166           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1167       then do:
     1168         assign
     1169           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1170                           - (frame DIALOG-1 :height-chars)
     1171         .
     1172         if p-change-value <= 0
     1173         then do:
     1174           run diasize_position-resize-button in this-procedure .
     1175           return .
     1176         end.
     1177       end.
     1178     end.
     1179     if p-change-value < 0
     1180     then do:
     1181       if frame DIALOG-1 :height + p-change-value < v-diasize-orig-frame-height
     1182       then do:
     1183         assign
     1184           p-change-value = v-diasize-orig-frame-height
     1185                          - (frame DIALOG-1 :height-chars)
     1186         .
     1187         if p-change-value >= 0
     1188         then do:
     1189           run diasize_position-resize-button in this-procedure .
     1190           return .
     1191         end.
     1192       end.
     1193     end.
     1194     if p-change-value >= 0
     1195     then do:
     1196       assign
     1197         v-change-sign = 1
     1198       .
     1199     end.
     1200     else do:
     1201       assign
     1202         v-change-sign = -1
     1203       .
     1204     end.
     1205     assign
     1206       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1207     .
     1208     if p-change-value = 0
     1209     then do:
     1210       run diasize_position-resize-button in this-procedure .
     1211       return .
     1212     end.
     1213     move_block:
     1214     do
     1215     on error undo move_block, retry move_block
     1216     :
     1217       if retry
     1218       then do:
     1219         do
     1220         on error undo move_block, leave move_block
     1221         :
     1222           if p-change-value > 0
     1223           then do:
     1224             for each buf_temp-diasize-handle
     1225             on error undo, next
     1226             :
     1227               assign
     1228                 v-object-handle = buf_temp-diasize-handle.handle-value
     1229               .
     1230               if v-object-handle <> v-diasize-resize-button
     1231               then do:
     1232                 assign
     1233                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1234                 .
     1235               end.
     1236             end.
     1237             assign
     1238               v-diasize-browse-handle :height = v-browse-height
     1239             .
     1240             for each buf_temp-browse-handle
     1241               where buf_temp-browse-handle.browse-type = 'height':u
     1242             on error undo, next
     1243             :
     1244               assign
     1245                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1246               .
     1247             end.
     1248             assign
     1249               frame DIALOG-1 :height = v-frame-height
     1250             .
     1251             if frame DIALOG-1 :scrollable = true
     1252             then do:
     1253               assign
     1254                 frame DIALOG-1 :virtual-height = v-frame-virtual-height
     1255               .
     1256             end.
     1257             run diasize_position-resize-button in this-procedure .
     1258           end.
     1259           else do:
     1260             if frame DIALOG-1 :scrollable = true
     1261             then do:
     1262               assign
     1263                 frame DIALOG-1 :virtual-height = v-frame-virtual-height
     1264               .
     1265             end.
     1266             assign
     1267               frame DIALOG-1 :height = v-frame-height
     1268             .
     1269             assign
     1270               v-diasize-browse-handle :height = v-browse-height
     1271             .
     1272             for each buf_temp-browse-handle
     1273               where buf_temp-browse-handle.browse-type = 'height':u
     1274             on error undo, next
     1275             :
     1276               assign
     1277                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1278               .
     1279             end.
     1280             for each buf_temp-diasize-handle
     1281             on error undo, next
     1282             :
     1283               assign
     1284                 v-object-handle = buf_temp-diasize-handle.handle-value
     1285               .
     1286               if v-object-handle <> v-diasize-resize-button
     1287               then do:
     1288                 assign
     1289                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1290                 .
     1291               end.
     1292             end.
     1293             run diasize_position-resize-button in this-procedure .
     1294           end.
     1295           assign
     1296             v-diasize-change-size = false
     1297           .
     1298           leave move_block .
     1299         end.
     1300       end.
     1301       assign
     1302         v-diasize-need-full-display = true
     1303       .
     1304       if v-diasize-change-size = false
     1305       then do:
     1306         assign
     1307           v-diasize-change-size = true
     1308         .
     1309       end.
     1310       else do:
     1311         return .
     1312       end.
     1313       assign
     1314         v-frame-height = frame DIALOG-1 :height
     1315         v-frame-virtual-height = frame DIALOG-1 :virtual-height
     1316         v-browse-height = v-diasize-browse-handle :height
     1317       .
     1318       for each buf_temp-browse-handle
     1319         where buf_temp-browse-handle.browse-type = 'height':u
     1320       :
     1321         assign
     1322           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1323         .
     1324       end.
     1325       for each buf_temp-diasize-handle
     1326       :
     1327         delete buf_temp-diasize-handle .
     1328       end.
     1329       assign
     1330         v-field-group-handle = frame DIALOG-1 :first-child
     1331       .
     1332       do while valid-handle(v-field-group-handle)
     1333       :
     1334         assign
     1335           v-object-handle = v-field-group-handle :first-child
     1336         .
     1337         do while valid-handle(v-object-handle)
     1338         :
     1339           if  v-object-handle <> v-diasize-browse-handle :handle
     1340           and can-query(v-object-handle, "row")
     1341           and can-query(v-object-handle, "height")
     1342           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1343           then do:
     1344             find first buf_temp-browse-handle
     1345               where buf_temp-browse-handle.browse-type   = 'height':u
     1346                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1347               no-error .
     1348             if available buf_temp-browse-handle
     1349             then do:
     1350             end.
     1351             else do:
     1352               create buf_temp-diasize-handle .
     1353               assign
     1354                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1355                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1356               .
     1357             end.
     1358           end.
     1359           assign
     1360             v-object-handle = v-object-handle :next-sibling
     1361           .
     1362         end.
     1363         assign
     1364           v-field-group-handle = v-field-group-handle :next-sibling
     1365         .
     1366       end.
     1367       do with frame DIALOG-1
     1368       :
     1369         hide v-diasize-resize-button .
     1370         assign
     1371           v-diasize-resize-button :row    = 1
     1372           v-diasize-resize-button :column = 1
     1373         .
     1374       end.
     1375       if p-change-value > 0
     1376       then do:
     1377         if frame DIALOG-1 :scrollable = true
     1378         then do:
     1379           assign
     1380             frame DIALOG-1 :virtual-height = frame DIALOG-1 :virtual-height + p-change-value
     1381             no-error .
     1382           if error-status :error
     1383           or error-status :get-message(1) <> ""
     1384           then do:
     1385             undo move_block, retry move_block .
     1386           end.
     1387         end.
     1388         assign
     1389           frame DIALOG-1 :height = frame DIALOG-1 :height + p-change-value
     1390           no-error .
     1391         if error-status :error
     1392         or error-status :get-message(1) <> ""
     1393         then do:
     1394           undo move_block, retry move_block .
     1395         end.
     1396         assign
     1397           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1398           no-error .
     1399         if error-status :error
     1400         or error-status :get-message(1) <> ""
     1401         then do:
     1402           undo move_block, retry move_block .
     1403         end.
     1404         for each buf_temp-browse-handle
     1405           where buf_temp-browse-handle.browse-type = 'height':u
     1406         on error undo move_block, retry move_block
     1407         :
     1408           assign
     1409             buf_temp-browse-handle.browse-handle :height
     1410               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1411             no-error .
     1412           if error-status :error
     1413           or error-status :get-message(1) <> ""
     1414           then do:
     1415             undo move_block, retry move_block .
     1416           end.
     1417         end.
     1418         for each buf_temp-diasize-handle
     1419         on error undo move_block, retry move_block
     1420         :
     1421           assign
     1422             v-object-handle = buf_temp-diasize-handle.handle-value
     1423           .
     1424           if v-object-handle <> v-diasize-resize-button
     1425           then do:
     1426             assign
     1427               v-object-handle :row = v-object-handle :row + p-change-value
     1428               no-error .
     1429             if error-status :error
     1430             or error-status :get-message(1) <> ""
     1431             then do:
     1432               undo move_block, retry move_block .
     1433             end.
     1434           end.
     1435         end.
     1436       end.
     1437       else do:
     1438         for each buf_temp-diasize-handle
     1439         on error undo move_block, retry move_block
     1440         :
     1441           assign
     1442             v-object-handle = buf_temp-diasize-handle.handle-value
     1443           .
     1444           if v-object-handle <> v-diasize-resize-button
     1445           then do:
     1446             assign
     1447               v-object-handle :row = v-object-handle :row + p-change-value
     1448               no-error .
     1449             if error-status :error
     1450             or error-status :get-message(1) <> ""
     1451             then do:
     1452               undo move_block, retry move_block .
     1453             end.
     1454           end.
     1455         end.
     1456         assign
     1457           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1458           no-error .
     1459         if error-status :error
     1460         or error-status :get-message(1) <> ""
     1461         then do:
     1462           undo move_block, retry move_block .
     1463         end.
     1464         for each buf_temp-browse-handle
     1465           where buf_temp-browse-handle.browse-type = 'height':u
     1466         on error undo move_block, retry move_block
     1467         :
     1468           assign
     1469             buf_temp-browse-handle.browse-handle :height
     1470               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1471             no-error .
     1472           if error-status :error
     1473           or error-status :get-message(1) <> ""
     1474           then do:
     1475             undo move_block, retry move_block .
     1476           end.
     1477         end.
     1478         assign
     1479           frame DIALOG-1 :height = frame DIALOG-1 :height + p-change-value
     1480           no-error .
     1481         if error-status :error
     1482         or error-status :get-message(1) <> ""
     1483         then do:
     1484           undo move_block, retry move_block .
     1485         end.
     1486         if frame DIALOG-1 :scrollable = true
     1487         then do:
     1488           assign
     1489             frame DIALOG-1 :virtual-height = frame DIALOG-1 :virtual-height + p-change-value
     1490             no-error .
     1491           if error-status :error
     1492           or error-status :get-message(1) <> ""
     1493           then do:
     1494             undo move_block, retry move_block .
     1495           end.
     1496         end.
     1497       end.
     1498       if p-move-resize = true
     1499       then do:
     1500         run diasize_position-resize-button in this-procedure .
     1501       end.
     1502       if v-diasize-wndstore = true
     1503       then do:
     1504         if connected("ub") = true
     1505         then do:
     1506           define variable v-cntxt-db-num        as integer   no-undo .
     1507           define variable v-cntxt-userid        as character no-undo .
     1508           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1509                                             , OUTPUT v-cntxt-userid
     1510                                             ) .
     1511           run gbl/wndsizew.p
     1512             (input  v-cntxt-db-num
     1513             ,input  v-cntxt-userid
     1514             ,input  v-diasize-proc-name
     1515             ,input  'height':u
     1516             ,input  string(frame DIALOG-1 :height - v-diasize-orig-frame-height)
     1517             ) .
     1518         end.
     1519       end.
     1520     end.
     1521     assign
     1522       v-diasize-change-size = false
     1523     .
     1524   end procedure.
     1525   procedure diasize_set-height :
     1526     define input  parameter p-new-height  as decimal   no-undo .
     1527     define input  parameter p-move-resize as logical   no-undo .
     1528     do
     1529     on error undo, return error return-value
     1530     :
     1531       run diasize_change-height in this-procedure
     1532         (input  (p-new-height - frame DIALOG-1 :height)
     1533         ,input  p-move-resize
     1534         ) .
     1535     end.
     1536   end procedure.
     1537   procedure diasize_change-width :
     1538     define input  parameter p-change-value as decimal   no-undo .
     1539     define input  parameter p-move-resize  as logical   no-undo .
     1540     define variable v-field-group-handle   as handle    no-undo .
     1541     define variable v-object-handle        as handle    no-undo .
     1542     define variable v-frame-width          as decimal   no-undo .
     1543     define variable v-frame-virtual-width  as decimal   no-undo .
     1544     define variable v-browse-width         as decimal   no-undo .
     1545     define variable v-window-width         as decimal   no-undo .
     1546     define variable v-window-virtual-width as decimal   no-undo .
     1547     define variable v-change-sign          as integer   no-undo .
     1548     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1549     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1550     if p-change-value > 0
     1551     then do:
     1552       if frame DIALOG-1 :width + p-change-value >
     1553           session :width-chars
     1554       then do:
     1555         assign
     1556           p-change-value = session :width-chars - frame DIALOG-1 :width
     1557         .
     1558         if p-change-value <= 0
     1559         then do:
     1560           run diasize_position-resize-button in this-procedure .
     1561           return .
     1562         end.
     1563       end.
     1564     end.
     1565     if p-change-value < 0
     1566     then do:
     1567       if frame DIALOG-1 :width + p-change-value < v-diasize-orig-frame-width
     1568       then do:
     1569         assign
     1570           p-change-value = v-diasize-orig-frame-width
     1571                          - frame DIALOG-1 :width
     1572         .
     1573         if p-change-value >= 0
     1574         then do:
     1575           run diasize_position-resize-button in this-procedure .
     1576           return .
     1577         end.
     1578       end.
     1579     end.
     1580     if p-change-value >= 0
     1581     then do:
     1582       assign
     1583         v-change-sign = 1
     1584       .
     1585     end.
     1586     else do:
     1587       assign
     1588         v-change-sign = -1
     1589       .
     1590     end.
     1591     assign
     1592       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1593     .
     1594     if p-change-value = 0
     1595     then do:
     1596       run diasize_position-resize-button in this-procedure .
     1597       return .
     1598     end.
     1599     move_block:
     1600     do
     1601     on error undo move_block, leave move_block
     1602     :
     1603       if retry
     1604       then do:
     1605         do
     1606         on error undo move_block, leave move_block
     1607         :
     1608           if p-change-value > 0
     1609           then do:
     1610             for each buf_temp-diasize-handle
     1611             on error undo, next
     1612             :
     1613               assign
     1614                 v-object-handle = buf_temp-diasize-handle.handle-value
     1615               .
     1616               if v-object-handle <> v-diasize-resize-button
     1617               then do:
     1618                 assign
     1619                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1620                 .
     1621               end.
     1622             end.
     1623             assign
     1624               v-diasize-browse-handle :width = v-browse-width
     1625             .
     1626             for each buf_temp-browse-handle
     1627               where buf_temp-browse-handle.browse-type = 'width':u
     1628             on error undo, next
     1629             :
     1630               assign
     1631                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1632               .
     1633             end.
     1634             assign
     1635               frame DIALOG-1 :width = v-frame-width
     1636             .
     1637             if frame DIALOG-1 :scrollable = true
     1638             then do:
     1639               assign
     1640                 frame DIALOG-1 :virtual-width = v-frame-virtual-width
     1641               .
     1642             end.
     1643             run diasize_position-resize-button in this-procedure .
     1644           end.
     1645           else do:
     1646             if frame DIALOG-1 :scrollable = true
     1647             then do:
     1648               assign
     1649                 frame DIALOG-1 :virtual-width = v-frame-virtual-width
     1650               .
     1651             end.
     1652             assign
     1653               frame DIALOG-1 :width = v-frame-width
     1654             .
     1655             for each buf_temp-browse-handle
     1656               where buf_temp-browse-handle.browse-type = 'width':u
     1657             on error undo, next
     1658             :
     1659               assign
     1660                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1661               .
     1662             end.
     1663             assign
     1664               v-diasize-browse-handle :width = v-browse-width
     1665             .
     1666             for each buf_temp-diasize-handle
     1667             on error undo, next
     1668             :
     1669               assign
     1670                 v-object-handle = buf_temp-diasize-handle.handle-value
     1671               .
     1672               if v-object-handle <> v-diasize-resize-button
     1673               then do:
     1674                 assign
     1675                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1676                 .
     1677               end.
     1678             end.
     1679             run diasize_position-resize-button in this-procedure .
     1680           end.
     1681           assign
     1682             v-diasize-change-size = false
     1683           .
     1684           leave move_block .
     1685         end.
     1686       end.
     1687       assign
     1688         v-diasize-need-full-display = true
     1689       .
     1690       if v-diasize-change-size = false
     1691       then do:
     1692         assign
     1693           v-diasize-change-size = true
     1694         .
     1695       end.
     1696       else do:
     1697         return .
     1698       end.
     1699       assign
     1700         v-frame-width = frame DIALOG-1 :width
     1701         v-frame-virtual-width = frame DIALOG-1 :virtual-width
     1702         v-browse-width = v-diasize-browse-handle :width
     1703       .
     1704       for each buf_temp-browse-handle
     1705         where buf_temp-browse-handle.browse-type = 'width':u
     1706       :
     1707         assign
     1708           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1709         .
     1710       end.
     1711       for each buf_temp-diasize-handle
     1712       :
     1713         delete buf_temp-diasize-handle .
     1714       end.
     1715       assign
     1716         v-field-group-handle = frame DIALOG-1 :first-child
     1717       .
     1718       do while valid-handle(v-field-group-handle)
     1719       :
     1720         assign
     1721           v-object-handle = v-field-group-handle :first-child
     1722         .
     1723         do while valid-handle(v-object-handle)
     1724         :
     1725           if  v-object-handle <> v-diasize-browse-handle :handle
     1726           and v-object-handle <> v-diasize-resize-button
     1727           and can-query(v-object-handle, "row")
     1728           and can-query(v-object-handle, "height")
     1729           and ( v-object-handle :col + v-object-handle :width
     1730                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1731               )
     1732           then do:
     1733             find first buf_temp-browse-handle
     1734               where buf_temp-browse-handle.browse-type   = 'width':u
     1735                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1736               no-error .
     1737             if available buf_temp-browse-handle
     1738             then do:
     1739             end.
     1740             else do:
     1741               create buf_temp-diasize-handle .
     1742               assign
     1743                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1744                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1745               .
     1746             end.
     1747           end.
     1748           assign
     1749             v-object-handle = v-object-handle :next-sibling
     1750           .
     1751         end.
     1752         assign
     1753           v-field-group-handle = v-field-group-handle :next-sibling
     1754         .
     1755       end.
     1756       do with frame DIALOG-1
     1757       :
     1758         hide v-diasize-resize-button .
     1759         v-diasize-resize-button :row = 1.
     1760         v-diasize-resize-button :column = 1.
     1761       end.
     1762       if p-change-value > 0
     1763       then do:
     1764         if frame DIALOG-1 :scrollable = true
     1765         then do:
     1766           assign
     1767             frame DIALOG-1 :virtual-width = frame DIALOG-1 :virtual-width + p-change-value
     1768             no-error .
     1769           if error-status :error
     1770           or error-status :get-message(1) <> ""
     1771           then do:
     1772             undo move_block, retry move_block.
     1773           end.
     1774         end.
     1775         assign
     1776           frame DIALOG-1 :width = v-frame-width + p-change-value
     1777           no-error .
     1778         if error-status :error
     1779         or error-status :get-message(1) <> ""
     1780         then do:
     1781           undo move_block, retry move_block.
     1782         end.
     1783         assign
     1784           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1785         no-error .
     1786         if error-status :error
     1787         or error-status :get-message(1) <> ""
     1788         then do:
     1789           undo move_block, retry move_block.
     1790         end.
     1791         for each buf_temp-browse-handle
     1792           where buf_temp-browse-handle.browse-type = 'width':u
     1793         on error undo move_block, retry move_block
     1794         :
     1795           assign
     1796             buf_temp-browse-handle.browse-handle :width
     1797               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1798             no-error .
     1799           if error-status :error
     1800           or error-status :get-message(1) <> ""
     1801           then do:
     1802             undo move_block, retry move_block .
     1803           end.
     1804         end.
     1805         for each buf_temp-diasize-handle
     1806         on error undo move_block, retry move_block
     1807         :
     1808           assign
     1809             v-object-handle = buf_temp-diasize-handle.handle-value
     1810           .
     1811           if v-object-handle <> v-diasize-resize-button
     1812           then do:
     1813             assign
     1814               v-object-handle :col = v-object-handle :col + p-change-value
     1815               no-error .
     1816             if error-status :error
     1817             or error-status :get-message(1) <> ""
     1818             then do:
     1819               undo move_block, retry move_block .
     1820             end.
     1821           end.
     1822         end.
     1823       end.
     1824       else do:
     1825         for each buf_temp-diasize-handle
     1826         on error undo move_block, retry move_block
     1827         :
     1828           assign
     1829             v-object-handle = buf_temp-diasize-handle.handle-value
     1830           .
     1831           if v-object-handle <> v-diasize-resize-button
     1832           then do:
     1833             assign
     1834               v-object-handle :col = v-object-handle :col + p-change-value
     1835               no-error .
     1836             if error-status :error
     1837             or error-status :get-message(1) <> ""
     1838             then do:
     1839               undo move_block, retry move_block .
     1840             end.
     1841           end.
     1842         end.
     1843         for each buf_temp-browse-handle
     1844           where buf_temp-browse-handle.browse-type = 'width':u
     1845         on error undo move_block, retry move_block
     1846         :
     1847           assign
     1848             buf_temp-browse-handle.browse-handle :width
     1849               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1850             no-error .
     1851           if error-status :error
     1852           or error-status :get-message(1) <> ""
     1853           then do:
     1854             undo move_block, retry move_block .
     1855           end.
     1856         end.
     1857         assign
     1858           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1859           no-error .
     1860         if error-status :error
     1861         or error-status :get-message(1) <> ""
     1862         then do:
     1863           undo move_block, retry move_block.
     1864         end.
     1865         assign
     1866           frame DIALOG-1 :width = frame DIALOG-1 :width + p-change-value
     1867         no-error .
     1868         if error-status :error
     1869         or error-status :get-message(1) <> ""
     1870         then do:
     1871           undo move_block, retry move_block.
     1872         end.
     1873         if frame DIALOG-1 :scrollable = true
     1874         then do:
     1875           assign
     1876             frame DIALOG-1 :virtual-width = frame DIALOG-1 :virtual-width + p-change-value
     1877           no-error .
     1878           if error-status :error
     1879           or error-status :get-message(1) <> ""
     1880           then do:
     1881             undo move_block, retry move_block.
     1882           end.
     1883         end.
     1884       end.
     1885       if p-move-resize
     1886       then do:
     1887         run diasize_position-resize-button in this-procedure .
     1888       end.
     1889       if v-diasize-wndstore = true
     1890       then do:
     1891         if connected("ub") = true
     1892         then do:
     1893           define variable v-cntxt-db-num        as integer   no-undo .
     1894           define variable v-cntxt-userid        as character no-undo .
     1895           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1896                                             , OUTPUT v-cntxt-userid
     1897                                             ) .
     1898           run gbl/wndsizew.p
     1899             (input  v-cntxt-db-num
     1900             ,input  v-cntxt-userid
     1901             ,input  v-diasize-proc-name
     1902             ,input  'width':u
     1903             ,input  string(frame DIALOG-1 :width - v-diasize-orig-frame-width)
     1904             ) .
     1905         end.
     1906       end.
     1907     end.
     1908     assign
     1909       v-diasize-change-size = false
     1910     .
     1911   end procedure.
     1912   procedure diasize_set-width :
     1913     define input  parameter p-new-width  as decimal   no-undo .
     1914     define input  parameter p-move-resize as logical   no-undo .
     1915     do
     1916     on error undo, return error return-value
     1917     :
     1918       run diasize_change-width in this-procedure
     1919         (input  (p-new-width - frame DIALOG-1 :width)
     1920         ,input  p-move-resize
     1921         ) .
     1922     end.
     1923   end procedure.
     1924   procedure diasize_position-resize-button :
     1925     do with frame DIALOG-1
     1926     :
     1927       hide v-diasize-resize-button .
     1928       assign
     1929         v-diasize-resize-button :row = frame DIALOG-1 :height - v-diasize-resize-button :height
     1930                     - 1
     1931                     - (frame DIALOG-1 :border-bottom-pixels / session :pixels-per-row)
     1932         v-diasize-resize-button :col = frame DIALOG-1 :width - v-diasize-resize-button :width
     1933                     - 1
     1934                     - (frame DIALOG-1 :border-right-pixels / session :pixels-per-column)
     1935       .
     1936       view v-diasize-resize-button .
     1937     end.
     1938   end procedure.
     1939   on alt-right anywhere
     1940   do:
     1941     run diasize_change-width in this-procedure
     1942       (input 1
     1943       ,input true
     1944       ) .
     1945     return no-apply .
     1946   end.
     1947   on alt-left anywhere
     1948   do:
     1949     run diasize_change-width in this-procedure
     1950       (input -1
     1951       ,input true
     1952       ) .
     1953     return no-apply .
     1954   end.
     1955   on alt-down anywhere
     1956   do:
     1957     run diasize_change-height in this-procedure
     1958       (input 1
     1959       ,input true
     1960       ) .
     1961     return no-apply .
     1962   end.
     1963   on alt-up anywhere
     1964   do:
     1965     run diasize_change-height in this-procedure
     1966       (input -1
     1967       ,input true
     1968       ) .
     1969     return no-apply .
     1970   end.
     1971   on alt-enter of frame DIALOG-1
     1972   do:
     1973     run diasize_maximize in this-procedure
     1974       (input  ?
     1975       ).
     1976     return no-apply .
     1977   end.
     1978   procedure diasize_end-move :
     1979     do
     1980     on error undo, return error return-value
     1981     :
     1982       define variable v-row-delta as decimal   no-undo .
     1983       define variable v-col-delta as decimal   no-undo .
     1984       define variable v-new-row as decimal   no-undo .
     1985       define variable v-new-col as decimal   no-undo .
     1986       assign
     1987         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1988         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1989       .
     1990       assign
     1991         v-row-delta = v-new-row - frame DIALOG-1 :height
     1992         v-col-delta = v-new-col - frame DIALOG-1 :width
     1993       .
     1994       run diasize_change-height in this-procedure
     1995         (input v-row-delta
     1996         ,input true
     1997         ) .
     1998       run diasize_change-width in this-procedure
     1999         (input v-col-delta
     2000         ,input true
     2001         ) .
     2002     end.
     2003   end procedure.
     2004   procedure diasize_maximize :
     2005     define input  parameter p-action as logical   no-undo .
     2006     do
     2007     on error undo, return error return-value
     2008     :
     2009       if p-action = ?
     2010       then do:
     2011         if v-diasize-need-maximize = true
     2012         then do:
     2013           assign
     2014             p-action = true
     2015           .
     2016         end.
     2017         else do:
     2018           assign
     2019             p-action = false
     2020           .
     2021         end.
     2022       end.
     2023       if p-action = true
     2024       then do:
     2025         run diasize_change-height in this-procedure
     2026           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2027               - frame DIALOG-1 :height-chars
     2028           ,input true
     2029           ) .
     2030         run diasize_change-width in this-procedure
     2031           (input session :width-chars
     2032               - frame DIALOG-1 :width-chars
     2033           ,input true
     2034           ) .
     2035         assign
     2036           v-diasize-need-maximize = false
     2037         .
     2038       end.
     2039       else do:
     2040         run diasize_change-width in this-procedure
     2041           (input v-diasize-orig-frame-width
     2042               - frame DIALOG-1 :width-chars
     2043           ,input true
     2044           ) .
     2045         run diasize_change-height in this-procedure
     2046           (input v-diasize-orig-frame-height
     2047               - frame DIALOG-1 :height-chars
     2048           ,input true
     2049           ) .
     2050         assign
     2051           v-diasize-need-maximize = true
     2052         .
     2053       end.
     2054     end.
     2055   end procedure.
     2056   procedure diasize_restore-orig-size :
     2057     do
     2058     on error undo, return error return-value
     2059     :
     2060       assign
     2061         v-diasize-current-frame-width  = frame DIALOG-1 :width
     2062         v-diasize-current-frame-height = frame DIALOG-1 :height
     2063       .
     2064       run diasize_set-height in this-procedure
     2065         (input  v-diasize-orig-frame-height
     2066         ,input  true
     2067         ) .
     2068       run diasize_set-width in this-procedure
     2069         (input  v-diasize-orig-frame-width
     2070         ,input  true
     2071         ) .
     2072     end.
     2073   end procedure.
     2074   procedure diasize_restore-current-size :
     2075     do
     2076     on error undo, return error return-value
     2077     :
     2078       run diasize_set-height in this-procedure
     2079         (input  v-diasize-current-frame-height
     2080         ,input  true
     2081         ) .
     2082       run diasize_set-width in this-procedure
     2083         (input  v-diasize-current-frame-width
     2084         ,input  true
     2085         ) .
     2086     end.
     2087   end procedure.
     2088   procedure diasize_set-browse-handle :
     2089     define input  parameter p-browse-handle as handle   no-undo .
     2090     define buffer buf_temp-browse-handle for temp-browse-handle .
     2091     do
     2092     on error undo, return error return-value
     2093     :
     2094       assign
     2095         v-diasize-browse-handle = p-browse-handle
     2096       .
     2097       for each buf_temp-browse-handle
     2098       on error undo, return error return-value
     2099       :
     2100         delete buf_temp-browse-handle .
     2101       end.
     2102     end.
     2103   end procedure.
     2104   procedure diasize_add_browse :
     2105     define input  parameter p-browse-type   as character no-undo .
     2106     define input  parameter p-browse-handle as handle    no-undo .
     2107     define buffer buf_temp-browse-handle for temp-browse-handle .
     2108     do
     2109     on error undo, return error return-value
     2110     :
     2111       assign
     2112         v-diasize-browse-number = v-diasize-browse-number + 1
     2113       .
     2114       create buf_temp-browse-handle .
     2115       assign
     2116         buf_temp-browse-handle.browse-type   = p-browse-type
     2117         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2118         buf_temp-browse-handle.browse-handle = p-browse-handle
     2119       .
     2120     end.
     2121   end procedure.
     2122   procedure diasize_init :
     2123     define variable v-default-value    as logical   no-undo .
     2124     define variable v-restore-saved    as logical   no-undo .
     2125     define variable v-resize-value-str as character no-undo .
     2126     do
     2127     on error undo, return error return-value
     2128     :
     2129       do with frame DIALOG-1
     2130       :
     2131         assign
     2132           v-diasize-orig-frame-height = frame DIALOG-1 :height
     2133           v-diasize-orig-frame-width  = frame DIALOG-1 :width
     2134           v-diasize-browse-handle     = browse BR-cash-desk :handle
     2135         .
     2136         create button v-diasize-resize-button
     2137         assign
     2138           parent        = frame DIALOG-1 :first-child
     2139           label         = "s"
     2140           height-pixels = 16
     2141           width-pixels  = 16
     2142           visible       = true
     2143           sensitive     = true
     2144           movable       = true
     2145           triggers:
     2146             on end-move persistent run diasize_end-move in this-procedure .
     2147           end triggers.
     2148         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2149         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2150         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2151         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2152         assign
     2153           v-diasize-wndmax = false
     2154         .
     2155         if connected("ub") = true
     2156         then do:
     2157           define variable v-cntxt-db-num        as integer   no-undo .
     2158           define variable v-cntxt-userid        as character no-undo .
     2159           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2160                                             , OUTPUT v-cntxt-userid
     2161                                             ) .
     2162           run gbl/wndpar_r.p
     2163             (input  v-cntxt-db-num
     2164             ,input  v-cntxt-userid
     2165             ,input  'wndmax':U
     2166             ,output v-diasize-wndmax
     2167             ,output v-default-value
     2168             ) .
     2169         end.
     2170         assign
     2171           v-diasize-wndstore = false
     2172         .
     2173         if connected("ub") = true
     2174         then do:
     2175           run gbl/wndpar_r.p
     2176             (input  v-cntxt-db-num
     2177             ,input  v-cntxt-userid
     2178             ,input  'wndstore':U
     2179             ,output v-diasize-wndstore
     2180             ,output v-default-value
     2181             ) .
     2182         end.
     2183         assign
     2184           v-diasize-proc-name = entry(1, program-name(2), '.')
     2185         .
     2186         if v-diasize-wndstore = true
     2187         then do:
     2188           assign
     2189             v-restore-saved = false
     2190           .
     2191           if connected("ub") = true
     2192           then do:
     2193             run gbl/wndsizer.p
     2194               (input  v-cntxt-db-num
     2195               ,input  v-cntxt-userid
     2196               ,input  v-diasize-proc-name
     2197               ,input  'height':u
     2198               ,output v-resize-value-str
     2199               ) .
     2200             if v-resize-value-str <> '':U
     2201             then do:
     2202               run diasize_change-height in this-procedure
     2203                 (input  integer(v-resize-value-str)
     2204                 ,input  true
     2205                 ) .
     2206               assign
     2207                 v-restore-saved = true
     2208               .
     2209             end.
     2210           end.
     2211           if connected("ub") = true
     2212           then do:
     2213             run gbl/wndsizer.p
     2214               (input  v-cntxt-db-num
     2215               ,input  v-cntxt-userid
     2216               ,input  v-diasize-proc-name
     2217               ,input  'width':u
     2218               ,output v-resize-value-str
     2219               ) .
     2220             if v-resize-value-str <> '':U
     2221             then do:
     2222               run diasize_change-width in this-procedure
     2223                 (input  integer(v-resize-value-str)
     2224                 ,input  true
     2225                 ) .
     2226               assign
     2227                 v-restore-saved = true
     2228               .
     2229             end.
     2230           end.
     2231           if v-restore-saved <> true
     2232           then do:
     2233             if v-diasize-wndmax = true
     2234             then do:
     2235               run diasize_maximize in this-procedure
     2236                 (input  true
     2237                 ) .
     2238             end.
     2239           end.
     2240         end.
     2241         else do:
     2242           if v-diasize-wndmax = true
     2243           then do:
     2244             run diasize_maximize in this-procedure
     2245               (input  true
     2246               ) .
     2247           end.
     2248         end.
     2249       end.
     2250     end.
     2251   end procedure.
     2252   procedure diasize_need-full-display :
     2253     define output parameter p-need-full-display as logical   no-undo .
     2254     do
     2255     on error undo, return error return-value
     2256     :
     2257       assign
     2258         p-need-full-display = v-diasize-need-full-display
     2259       .
     2260       assign
     2261         v-diasize-need-full-display = false
     2262       .
     2263     end.
     2264   end procedure.
     2265   procedure get-context :
     2266      define output parameter p-db-num as integer          no-undo.
     2267      define output parameter p-user-id as character        no-undo.
     2268      define variable v-login               as character    no-undo.
     2269      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2270      define buffer buf_user-login  for ub.user-login .
     2271      do
     2272      on error undo, return error
     2273      :
     2274            FIND FIRST buf_sys-ctrl no-lock.
     2275            ASSIGN
     2276               v-login = USERID("ub")
     2277               p-db-num = buf_sys-ctrl.db-num
     2278            .
     2279            FIND FIRST buf_user-login
     2280                 WHERE buf_user-login.db-num = p-db-num
     2281                   AND buf_user-login.user-login = v-login
     2282                 no-lock
     2283                 no-error
     2284                 .
     2285            IF AVAILABLE buf_user-login
     2286            THEN DO:
     2287               assign
     2288                  p-user-id = buf_user-login.user-id
     2289               .
     2290            END.
     2291      end.
     2292   end procedure.
     2293       run diasize_init in this-procedure .
     2294   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2295   on F2 of frame DIALOG-1 anywhere do:
     2296     if b-EXIT :sensitive then DO: apply "CHOOSE":U to b-EXIT in frame DIALOG-1. END.
     2297     return no-apply.
     2298   end.
     2299   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2300   on CTRL-P, CTRL-З of frame DIALOG-1 anywhere do:
     2301     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame DIALOG-1. END.
     2302     return no-apply.
     2303   end.
     2304   ON WINDOW-CLOSE OF FRAME DIALOG-1 APPLY "END-ERROR":U TO SELF.
     2305   MAIN-BLOCK:
     2306   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2307      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2308   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2309     run mainmenu_getcntxt in parparentproc
     2310       (output v-cntxt-db-num
     2311       ,output v-cntxt-userid
     2312       ,output v-cntxt-level
     2313       ,output v-cntxt-host-code-obj
     2314       ,output v-cntxt-obj-type
     2315       ,output v-cntxt-obj-code
     2316       ,output v-cntxt-db-num-obj
     2317       ,output v-cntxt-is-admin
     2318       ) .
     2319       find ub.inkas where ub.inkas.inkas-code = inp-inkas-code no-lock no-error.
     2320       if not available ub.inkas then
     2321           do:
     2322               message "Отчет по выручке пустой!" view-as alert-box WARNING.
     2323               return.
     2324           end.
     2325           IF CAN-FIND(FIRST ub.cash-desk WHERE ub.cash-desk.db-num >=0
     2326                          AND ub.cash-desk.obj-code = ub.inkas.obj-code
     2327                          AND ub.cash-desk.pos-type = 'Autotank':U) THEN
     2328               v-exist-autotank = YES .
     2329           define variable v-curr-r-b as character no-undo .
     2330   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2331   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2332     (output v-curr-r-b
     2333     )  .
     2334           FOR EACH ub.inkas-pay where ub.inkas-pay.inkas-code = ub.inkas.inkas-code no-lock:
     2335               accumpay = accumpay + ROUND(if v-curr-r-b = 'base':U
     2336                                then ub.inkas-pay.tot-base
     2337                                else ub.inkas-pay.tot-rubl, 2) .
     2338               RUN autotank-inkas-pay(input ub.inkas-pay.inkas-code  ,
     2339                                      input ub.inkas-pay.pay-code    ,
     2340                                      input ub.inkas-pay.curr-code   ,
     2341                                      input "autotank-sum-return" ,
     2342                                      output a-sum-return) .
     2343               assign
     2344                     accumpay = accumpay - a-sum-return
     2345                     autotank-sum-return = autotank-sum-return - a-sum-return
     2346                   .
     2347           END.
     2348           assign
     2349           f% = ub.inkas.discnt / ub.inkas.tot-doc * 100
     2350           fnetto = ub.inkas.netto
     2351           frame DIALOG-1:title =
     2352               "Отчет о выручке: " + inp-inkas-code + ". Дата: " + string( ub.inkas.doc-date )
     2353           g-discnt = ub.inkas.discnt .
     2354           run get-inkas-ps in this-procedure (
     2355                                               buffer ub.inkas
     2356                                             , output chk-amount
     2357                                             , output gds-amount
     2358                                             , output line-out
     2359                                             , output dtl-out
     2360                                             , output line-ret
     2361                                             , output dtl-ret
     2362                                             , output nf-chk-amount
     2363                                             , output nf-gds-amount
     2364                                             , output ps-where-rus
     2365                                             ).
     2366     RUN fill-inkas-cash-desk IN THIS-PROCEDURE.
     2367     RUN MYenable IN THIS-PROCEDURE.
     2368     APPLY "VALUE-CHANGED" to BR-INKAS-PAY.
     2369     WAIT-FOR GO OF FRAME DIALOG-1.
     2370   END.
     2371   RUN disable_UI.
     2372   PROCEDURE autotank-inkas-pay :
     2373   define input  PARAMETER i-code    as CHARACTER no-undo .
     2374   define input  parameter p-code    as INTEGER   no-undo .
     2375   define input  parameter c-code    as INTEGER   no-undo .
     2376   define input  PARAMETER a-code    as CHARacter no-undo .
     2377   define output PARAMETER a-return  as DECImal   no-undo .
     2378   define BUFFER buf_inkas        FOR ub.inkas .
     2379   define BUFFER buf_chk-pay      FOR ub.chk-pay .
     2380   define BUFFER buf_chk-pay-attr FOR ub.chk-pay-attr .
     2381   assign
     2382       a-return = 0
     2383       .
     2384   FIND FIRST buf_inkas NO-LOCK WHERE buf_inkas.inkas-code = i-code NO-ERROR.
     2385   IF available buf_inkas THEN
     2386   DO:
     2387       FOR EACH buf_chk-pay NO-LOCK where buf_chk-pay.out-code = buf_inkas.inkas-code
     2388                                  AND  buf_chk-pay.pay-code = p-code
     2389                                  AND  buf_chk-pay.curr-code = c-code,
     2390           FIRST buf_chk-pay-attr NO-LOCK WHERE buf_chk-pay-attr.doc-code = buf_chk-pay.doc-code
     2391                                    AND buf_chk-pay-attr.line-num = buf_chk-pay.line-num
     2392                                    AND buf_chk-pay-attr.attr-code = a-code :
     2393          a-return = a-return + decimal(buf_chk-pay-attr.attr-value) .
     2394       END.
     2395   END.
     2396   END PROCEDURE.
     2397   PROCEDURE autotank-inkas-pay-desk :
     2398   define input  parameter i-code   as character no-undo .
     2399   define input  parameter p-code   as integer   no-undo .
     2400   define input  parameter c-code   as integer   no-undo .
     2401   define input  parameter p-desk   as integer   no-undo .
     2402   define input  parameter ccashier as integer   no-undo .
     2403   define input  parameter a-code   as character no-undo .
     2404   define output parameter a-return as decimal   no-undo .
     2405   define BUFFER buf_inkas        FOR ub.inkas .
     2406   define BUFFER buf_chk-pay      FOR ub.chk-pay .
     2407   define BUFFER buf_chk-pay-attr FOR ub.chk-pay-attr .
     2408   define BUFFER buf_chk-doc      FOR ub.chk-doc .
     2409   assign
     2410       a-return = 0
     2411       .
     2412   FIND FIRST buf_inkas NO-LOCK WHERE buf_inkas.inkas-code = i-code NO-ERROR.
     2413   IF available buf_inkas THEN
     2414   DO:
     2415       FOR EACH buf_chk-doc NO-LOCK where buf_chk-doc.out-code = buf_inkas.inkas-code
     2416                                 AND buf_chk-doc.pay-desk = p-desk
     2417                                 AND buf_chk-doc.cashier = ccashier,
     2418           EACH buf_chk-pay NO-LOCK where buf_chk-pay.doc-code = buf_chk-doc.doc-code
     2419                                  AND  buf_chk-pay.pay-code = p-code
     2420                                  AND  buf_chk-pay.curr-code = c-code,
     2421           FIRST buf_chk-pay-attr NO-LOCK WHERE buf_chk-pay-attr.doc-code = buf_chk-pay.doc-code
     2422                                    AND buf_chk-pay-attr.line-num = buf_chk-pay.line-num
     2423                                    AND buf_chk-pay-attr.attr-code = a-code:
     2424          a-return = a-return + DECI(buf_chk-pay-attr.attr-value) .
     2425       END.
     2426   END.
     2427   END PROCEDURE.
     2428   PROCEDURE disable_UI :
     2429     HIDE FRAME DIALOG-1.
     2430   END PROCEDURE.
     2431   PROCEDURE enable_UI :
     2432     DISPLAY f% f-num-chk g-discnt autotank-sum-return fnetto accumpay
     2433         WITH FRAME DIALOG-1.
     2434     IF AVAILABLE ub.inkas THEN
     2435       DISPLAY ub.inkas.tot-doc ub.inkas.num-chk ub.inkas.discnt ub.inkas.sub-discnt
     2436         WITH FRAME DIALOG-1.
     2437     ENABLE b-exit b-print B-help BR-INKAS-PAY BR-pay-desk BR-cash-desk
     2438         WITH FRAME DIALOG-1.
     2439     OPEN QUERY BR-cash-desk FOR EACH temp-inkas-cash-desk.    OPEN QUERY BR-INKAS-PAY FOR EACH ub.inkas-pay       WHERE ub.inkas-pay.inkas-code = inp-inkas-code NO-LOCK,       FIRST ub.cash-pay WHERE ub.cash-pay.cdpay-code = ub.inkas-pay.pay-code AND ub.cash-pay.curr-code = ub.inkas-pay.curr-code NO-LOCK,       FIRST ub.currency WHERE ub.currency.curr-code = ub.inkas-pay.curr-code NO-LOCK.    OPEN QUERY BR-pay-desk FOR EACH ub.inkas-pay-desk       WHERE ub.inkas-pay-desk.inkas-code = inp-inkas-code  AND ub.inkas-pay-desk.pay-code = ub.inkas-pay.pay-code  AND ub.inkas-pay-desk.curr-code = ub.inkas-pay.curr-code NO-LOCK     BY ub.inkas-pay-desk.pay-code.
     2440   END PROCEDURE.
     2441   PROCEDURE fill-inkas-cash-desk :
     2442   define BUFFER buf_temp-inkas-cash-desk FOR temp-inkas-cash-desk .
     2443   define BUFFER buf_inkas-pay-desk       FOR ub.inkas-pay-desk .
     2444   define BUFFER buf_inkas-pay-desk-attr  FOR ub.inkas-pay-desk-attr .
     2445   for each buf_temp-inkas-cash-desk :
     2446     delete buf_temp-inkas-cash-desk .
     2447   end.
     2448   FOR EACH buf_inkas-pay-desk NO-LOCK WHERE
     2449   buf_inkas-pay-desk.inkas-code = inp-inkas-code
     2450   BREAK BY buf_inkas-pay-desk.pay-desk:
     2451     FIND FIRST buf_temp-inkas-cash-desk WHERE
     2452           buf_temp-inkas-cash-desk.inkas-code = buf_inkas-pay-desk.inkas-code
     2453       AND buf_temp-inkas-cash-desk.pay-desk = buf_inkas-pay-desk.pay-desk NO-ERROR.
     2454     IF NOT AVAILABLE buf_temp-inkas-cash-desk THEN DO:
     2455         CREATE buf_temp-inkas-cash-desk.
     2456         assign
     2457             buf_temp-inkas-cash-desk.inkas-code = buf_inkas-pay-desk.inkas-code
     2458             buf_temp-inkas-cash-desk.pay-desk = buf_inkas-pay-desk.pay-desk.
     2459     END.
     2460     assign
     2461     buf_temp-inkas-cash-desk.tot-base = buf_temp-inkas-cash-desk.tot-base + buf_inkas-pay-desk.tot-base
     2462     buf_temp-inkas-cash-desk.tot-rubl = buf_temp-inkas-cash-desk.tot-rubl + buf_inkas-pay-desk.tot-rubl
     2463     .
     2464     IF buf_inkas-pay-desk.doc-type <> '':U THEN
     2465      RUN autotank-inkas-pay-desk( input buf_inkas-pay-desk.inkas-code,
     2466                                   input buf_inkas-pay-desk.pay-code ,
     2467                                   input buf_inkas-pay-desk.curr-code ,
     2468                                   input buf_inkas-pay-desk.pay-desk ,
     2469                                   input buf_inkas-pay-desk.cashier ,
     2470                                   input "autotank-sum-return":U    ,
     2471                                   output a-sum-return)
     2472         .
     2473         assign
     2474         buf_temp-inkas-cash-desk.tot-rubl-return = buf_temp-inkas-cash-desk.tot-rubl-return
     2475             - a-sum-return
     2476         .
     2477   END.
     2478   END PROCEDURE.
     2479   PROCEDURE MyEnable :
     2480   define buffer buf_sale-doc for ub.sale-doc.
     2481   define variable v-hdl as HANDLE no-undo .
     2482   find first BUF_sale-doc no-lock where
     2483             buf_sale-doc.inkas-code = inp-inkas-code
     2484         and buf_sale-doc.doc-kind = 'trf':U no-error .
     2485   assign
     2486   f-num-chk = inkas.num-chk - nf-chk-amount - (if available buf_sale-doc
     2487                                                then buf_sale-doc.chk-amount
     2488                                                else 0).
     2489   find first BUF_sale-doc no-lock where
     2490             buf_sale-doc.inkas-code = inp-inkas-code
     2491         and buf_sale-doc.doc-kind = 'swo':U no-error .
     2492   assign
     2493   f-num-chk = inkas.num-chk - nf-chk-amount - (if available buf_sale-doc
     2494                                                then buf_sale-doc.chk-amount
     2495                                                else 0).
     2496   assign
     2497   temp-inkas-cash-desk.tot-rubl:LABEL IN BROWSE br-cash-desk = 'Руб.эквивалент'
     2498   ub.inkas-pay.tot-rubl:LABEL IN BROWSE br-inkas-pay = 'Руб.эквивалент'
     2499   ub.inkas-pay-desk.tot-rubl:LABEL IN BROWSE br-pay-desk = 'Руб.эквивалент'
     2500   .
     2501   DISPLAY
     2502   f%
     2503   f-num-chk
     2504   g-discnt
     2505   autotank-sum-return
     2506   fnetto
     2507   accumpay
     2508   WITH FRAME DIALOG-1.
     2509   IF AVAILABLE ub.inkas THEN
     2510   DISPLAY
     2511   ub.inkas.num-chk
     2512   ub.inkas.tot-doc
     2513   ub.inkas.discnt
     2514   ub.inkas.sub-discnt
     2515   WITH FRAME DIALOG-1.
     2516   IF v-exist-autotank = NO THEN
     2517   DO:
     2518    assign
     2519     autotank-sum-return:HIDDEN = YES
     2520     autotank-sum-return:VISIBLE = NO
     2521        .
     2522     v-hdl = br-inkas-pay:FIRST-COLUMN .
     2523     DO WHILE VALID-HANDLE(v-hdl):
     2524         IF v-hdl:LABEL BEGINS "Выручка(руб.)":U THEN v-hdl:VISIBLE = NO .
     2525         IF v-hdl:LABEL BEGINS "Разн.по запр.за нал":U THEN v-hdl:VISIBLE = NO .
     2526         v-hdl = v-hdl:NEXT-COLUMN .
     2527     END.
     2528     v-hdl = br-pay-desk:FIRST-COLUMN .
     2529     DO WHILE VALID-HANDLE(v-hdl):
     2530         IF v-hdl:LABEL BEGINS "Выручка(руб.)":U THEN v-hdl:VISIBLE = NO .
     2531         IF v-hdl:LABEL BEGINS "Разн.по запр.за нал":U THEN v-hdl:VISIBLE = NO .
     2532         v-hdl = v-hdl:NEXT-COLUMN .
     2533     END.
     2534     v-hdl = br-cash-desk:FIRST-COLUMN .
     2535     DO WHILE VALID-HANDLE(v-hdl):
     2536         IF v-hdl:LABEL BEGINS "Выручка(руб.)":U THEN v-hdl:VISIBLE = NO .
     2537         IF v-hdl:LABEL BEGINS "Разн.по запр.за нал":U THEN v-hdl:VISIBLE = NO .
     2538         v-hdl = v-hdl:NEXT-COLUMN .
     2539     END.
     2540   END.
     2541   ENABLE
     2542   b-exit
     2543   b-print
     2544   B-help
     2545   BR-INKAS-PAY
     2546   BR-pay-desk
     2547   BR-cash-desk
     2548   WITH FRAME DIALOG-1.
     2549   OPEN QUERY BR-cash-desk FOR EACH temp-inkas-cash-desk.    OPEN QUERY BR-INKAS-PAY FOR EACH ub.inkas-pay       WHERE ub.inkas-pay.inkas-code = inp-inkas-code NO-LOCK,       FIRST ub.cash-pay WHERE ub.cash-pay.cdpay-code = ub.inkas-pay.pay-code AND ub.cash-pay.curr-code = ub.inkas-pay.curr-code NO-LOCK,       FIRST ub.currency WHERE ub.currency.curr-code = ub.inkas-pay.curr-code NO-LOCK.    OPEN QUERY BR-pay-desk FOR EACH ub.inkas-pay-desk       WHERE ub.inkas-pay-desk.inkas-code = inp-inkas-code  AND ub.inkas-pay-desk.pay-code = ub.inkas-pay.pay-code  AND ub.inkas-pay-desk.curr-code = ub.inkas-pay.curr-code NO-LOCK     BY ub.inkas-pay-desk.pay-code.
     2550   END PROCEDURE.
     2551   FUNCTION get-cash-pay RETURNS CHARACTER
     2552     ( input p-pay-code as integer, input p-curr-code as integer ) :
     2553   define buffer buf_cash-pay for ub.cash-pay.
     2554   find first buf_cash-pay no-lock where
     2555               buf_cash-pay.curr-code = p-curr-code
     2556           AND buf_cash-pay.cdpay-code  = p-pay-code
     2557               no-error.
     2558     if available buf_cash-pay then do:
     2559         return buf_cash-pay.obj-name.
     2560     end.
     2561     RETURN chr(63).
     2562   END FUNCTION.
     2563   FUNCTION get-chk-type RETURNS CHARACTER
     2564     ( input par-doc-type as character ) :
     2565    if par-doc-type = 'при':U then return "Продажа".
     2566    RETURN "Возврат".
     2567   END FUNCTION.
     2568   FUNCTION get-currency RETURNS CHARACTER
     2569     ( input p-curr-code as integer ) :
     2570   define buffer buf_currency for ub.currency.
     2571   find first buf_currency no-lock where
     2572               buf_currency.curr-code = p-curr-code no-error.
     2573   if available buf_currency then do:
     2574       return buf_currency.curr-abbr.
     2575   end.
     2576     RETURN chr(63).
     2577   END FUNCTION.
