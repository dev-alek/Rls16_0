      340   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      341   define new shared variable RepPathName        as character no-undo .
      342   define new shared variable PrintRubl          as logical   no-undo .
      343   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      344   define  stream PrnLibStream.
      345   procedure prn-lib-prn-file :
      346     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      347     define input parameter p-DIsabledoptions as integer no-undo .
      348     define variable v-report-name as character no-undo .
      349     define variable v-user-action as character no-undo .
      350     define variable v-printed     as logical   no-undo .
      351     define variable v-exist       as logical   no-undo .
      352     do
      353       on error undo, return error
      354       :
      355       run prn-lib-get-report-name  in this-procedure (
      356         input parParentProc
      357         ,output v-report-name
      358         ).
      359   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      360   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      361     (input  v-report-name
      362     ,input  2
      363     ,output v-exist
      364     )  .
      365       if NOT v-exist then
      366       DO:
      367         Message
      368           "Нет заданий на печать ! "
      369           view-as alert-box .
      370         Return  .
      371       End.
      372       run gbl/prnfilen.w
      373         (input  ""
      374         ,input  p-DisabledOptions
      375         ,input  string(v-report-name )
      376         ,input  7
      377         ,output v-user-action
      378         ,output v-printed
      379         ) .
      380       if v-printed then
      381       do:
      382         return "YES" .
      383       end.
      384       else
      385       do:
      386         return "NO" .
      387       end.
      388     end.
      389   end procedure.
      390   procedure prn-lib-open-stream :
      391     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      392     define input parameter p-page-size    as integer no-undo .
      393     define input parameter p-is-stream    as logical no-undo .
      394     define input parameter p-append       as logical no-undo .
      395     define variable v-report-name as character no-undo .
      396     do
      397       on error undo, return error
      398       :
      399       run prn-lib-get-report-name  in this-procedure (
      400         input parParentProc
      401         ,output v-report-name
      402         ).
      403       if p-is-stream then
      404       do:
      405         if p-append then
      406         do:
      407           output stream PrnLibStream to value( v-report-name )
      408             page-size value(p-page-size) append .
      409         end.
      410         if not p-append then
      411         do:
      412           output stream PrnLibStream to value( v-report-name )
      413             page-size value(p-page-size) .
      414         end.
      415       end.
      416       if not p-is-stream then
      417       do:
      418         if p-append then
      419         do:
      420           output to value( v-report-name )
      421             page-size value(p-page-size) append .
      422         end.
      423         if not p-append then
      424         do:
      425           output to value( v-report-name )
      426             page-size value(p-page-size) .
      427         end.
      428       end.
      429     end.
      430   end procedure.
      431   procedure prn-lib-open-exp :
      432     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      433     define input parameter p-is-stream    as logical no-undo .
      434     define input parameter p-is-append    as logical no-undo .
      435     define output parameter p-ReportFileName as char init "report" no-undo.
      436     define output parameter p-process as logical no-undo .
      437     define variable glog as logical no-undo .
      438     do
      439       on error undo, return error
      440       :
      441       SYSTEM-DIALOG GET-FILE p-ReportFileName
      442         TITLE      "Укажите путь"
      443         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      444         ASK-OVERWRITE
      445         CREATE-TEST-FILE
      446         SAVE-AS
      447         USE-FILENAME
      448         DEFAULT-EXTENSION "txt"
      449         UPDATE glog
      450         .
      451       if not glog then  return.
      452       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      453       if p-is-stream then
      454       do:
      455         if p-is-append then
      456         do:
      457           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      458         end.
      459         else
      460         do:
      461           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      462         end.
      463       end.
      464       else
      465       do:
      466         if p-is-append then
      467         do:
      468           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      469         end.
      470         else
      471         do:
      472           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      473         end.
      474       end.
      475       p-process = yes.
      476     end.
      477   end procedure.
      478   procedure prn-lib-get-report-name :
      479     define input parameter parParentProc  as widget-handle no-undo.
      480     define output parameter p-report-name as character no-undo .
      481     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      482   end procedure.
      483   procedure prn-lib-reportviewer-report-name :
      484     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      485     define input parameter p-report-name-html as character no-undo .
      486     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      487   end procedure.
      488   procedure prn-lib-reportviewer :
      489     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      490     define input parameter p-report-name-html as character no-undo .
      491     define input parameter p-param        as character no-undo .
      492     define variable v-excel           as character no-undo init 'TRUE' .
      493     define variable v-value-character as character no-undo .
      494     define variable v-value-integer   as character no-undo .
      495     define variable v-value-date      as date      no-undo .
      496     define variable v-value-decimal   as decimal   no-undo .
      497     define variable rep-excel         as logical   no-undo .
      498     define variable excel-string      as character no-undo .
      499     define variable v-param-type      as character no-undo .
      500     define variable v-tth             as handle    no-undo .
      501     run adm/shattri.p (
      502       input "get":U
      503       ,input  ""
      504       ,input  0
      505       ,input  'report-glob':U
      506       ,input  'rep-excel':U
      507       ,output v-value-character
      508       ,output v-value-date
      509       ,output v-value-decimal
      510       ,output v-value-integer
      511       ,output rep-excel
      512       ,output v-param-type
      513       ,INPUT-OUTPUT table-handle v-tth
      514       )  .
      515     if rep-excel then v-excel = "TRUE" .
      516     else v-excel = "FALSE" .
      517     if p-param eq ""
      518     then
      519        p-param = "EXCEL:" + v-excel.
      520     else
      521        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      522     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      523   end procedure.
      524   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      525   FUNCTION set-inkas-PS returns character(    input p-ps as character,
      526                                               input p-chk-amount as integer,
      527                                               input p-gds-amount as integer,
      528                                               input p-line-out as integer,
      529                                               input p-dtl-out as integer,
      530                                               input p-line-ret as integer,
      531                                               input p-dtl-ret as integer,
      532                                               input p-nf-chk-amount as integer,
      533                                               input p-nf-gds-amount as integer,
      534                                               input p-ps-where-rus as character
      535                                               ):
      536   define variable v-ps as character no-undo .
      537   define variable v-other as character no-undo .
      538   v-other = p-ps.
      539   entry(1, v-other, "@") = ''.
      540   v-other = trim(v-other, "@").
      541   v-PS = substitute('Кол-во_чеков &2&1строк_чеков &3&1товаров_расход &4&1признаков_расход &5&1товаров_возврат &6&1признаков_возврат &7&1'
      542                       , chr(4)
      543                       , p-chk-amount
      544                       , p-gds-amount
      545                       , p-line-out
      546                       , p-dtl-out
      547                       , p-line-ret
      548                       , p-dtl-ret).
      549   v-ps = v-ps +  substitute("без_докум_чеков &1&2без_докум_строк_чеков &3&2&4@&5"
      550                               , p-nf-chk-amount
      551                               , chr(4)
      552                               , p-nf-gds-amount
      553                               , p-ps-where-rus
      554                               , v-other)
      555                       .
      556   return v-ps.
      557   END FUNCTION.
      558   FUNCTION set-inkas-PS-simple returns character(
      559                                               input p-chk-amount as integer,
      560                                               input p-gds-amount as integer,
      561                                               input p-line-out as integer,
      562                                               input p-dtl-out as integer,
      563                                               input p-line-ret as integer,
      564                                               input p-dtl-ret as integer,
      565                                               input p-nf-chk-amount as integer,
      566                                               input p-nf-gds-amount as integer
      567                                               ):
      568   define variable v-ps as character no-undo .
      569   define variable v-str1 as character no-undo .
      570   assign
      571     v-ps = fill( chr(32) +  chr(4), 9).
      572     v-str1 = ENTRY(1, v-PS, chr(4)).
      573     entry(2, v-str1, chr(32))  = string(p-chk-amount).
      574     ENTRY(1, v-PS, chr(4)) = v-str1.
      575     v-str1 = ENTRY(2, v-PS, chr(4)).
      576     entry(2, v-str1, chr(32))  = string(p-gds-amount).
      577     ENTRY(2, v-PS, chr(4)) = v-str1.
      578     v-str1 = ENTRY(3, v-PS, chr(4)).
      579     entry(2, v-str1, chr(32))  = string(p-line-out).
      580     ENTRY(3, v-PS, chr(4)) = v-str1.
      581     v-str1 = ENTRY(4, v-PS, chr(4)).
      582     entry(2, v-str1, chr(32))  = string(p-dtl-out).
      583     ENTRY(4, v-PS, chr(4)) = v-str1.
      584     v-str1 = ENTRY(5, v-PS, chr(4)).
      585     entry(2, v-str1, chr(32))  = string(p-line-ret).
      586     ENTRY(5, v-PS, chr(4)) = v-str1.
      587     v-str1 = ENTRY(6, v-PS, chr(4)).
      588     entry(2, v-str1, chr(32))  = string(p-dtl-ret).
      589     ENTRY(5, v-PS, chr(4)) = v-str1.
      590     v-str1 = ENTRY(7, v-PS, chr(4)).
      591     entry(2, v-str1, chr(32))  = string(p-nf-chk-amount).
      592     ENTRY(5, v-PS, chr(4)) = v-str1.
      593     v-str1 = ENTRY(8, v-PS, chr(4)).
      594     entry(2, v-str1, chr(32))  = string(p-nf-gds-amount).
      595     ENTRY(5, v-PS, chr(4)) = v-str1.
      596   return v-ps.
      597   END FUNCTION.
      598   FUNCTION get-inkas-nf-PS-simple returns logical (
      599                                                input p-ps as character
      600                                               ,output p-gds-amount as integer
      601                                               ,output p-nf-gds-amount as integer
      602                                               ):
      603   if num-entries(p-ps, chr(4)) >= 8 then do:
      604     assign
      605     p-gds-amount = integer(entry(2, ENTRY(2, p-PS, chr(4)), chr(32)))
      606     p-nf-gds-amount = integer(entry(2, ENTRY(8, p-PS, chr(4)), chr(32)))
      607     no-error .
      608   end.
      609   return not error-status:error .
      610   END FUNCTION.
      611   PROCEDURE get-inkas-PS:
      612   define parameter buffer buf_inkas for ub.inkas.
      613   define output parameter p-chk-amount as integer no-undo .
      614   define output parameter p-gds-amount as integer no-undo .
      615   define output parameter p-line-out as integer no-undo .
      616   define output parameter p-dtl-out as integer no-undo .
      617   define output parameter p-line-ret as integer no-undo .
      618   define output parameter p-dtl-ret as integer no-undo .
      619   define output parameter p-nf-chk-amount as integer no-undo .
      620   define output parameter p-nf-gds-amount as integer no-undo .
      621   define output parameter p-ps-where-rus as character no-undo .
      622   define variable v-gds-amount as integer no-undo .
      623   define variable v-nf-gds-amount as integer no-undo .
      624   define buffer buf_sale-doc for ub.sale-doc.
      625   for each buf_sale-doc no-lock where
      626           buf_sale-doc.inkas-code = buf_inkas.inkas-code
      627       and buf_sale-doc.order > 0:
      628     assign
      629     p-gds-amount = p-gds-amount + (if buf_sale-doc.in-inkas = yes
      630                                    or buf_sale-doc.doc-kind = 'trf':U
      631                                    then buf_sale-doc.gds-amount
      632                                    else 0)
      633     p-line-out = p-line-out  + (if buf_sale-doc.in-inkas = yes
      634                                 and buf_sale-doc.dir = 1
      635                                 then buf_sale-doc.tot-lines
      636                                 else 0)
      637     p-dtl-out = p-dtl-out + (if buf_sale-doc.in-inkas = yes
      638                             and buf_sale-doc.dir = 1
      639                             then buf_sale-doc.tot-dtl
      640                             else 0)
      641     p-line-ret = p-line-ret  + (if buf_sale-doc.in-inkas = yes
      642                                 and buf_sale-doc.dir = -1
      643                                 then buf_sale-doc.tot-lines
      644                                 else 0)
      645     p-dtl-ret = p-dtl-ret + (if buf_sale-doc.in-inkas = yes
      646                              and buf_sale-doc.dir = -1
      647                             then buf_sale-doc.tot-dtl
      648                             else 0)
      649     .
      650   end.
      651   if get-inkas-nf-PS-simple( input buf_inkas.ps
      652                             ,output v-gds-amount
      653                             ,output v-nf-gds-amount) then do:
      654     assign
      655     p-gds-amount = v-gds-amount
      656     p-nf-gds-amount = v-nf-gds-amount
      657     .
      658   end.
      659   assign
      660   p-ps-where-rus = buf_inkas.sale-filter-rus
      661   p-nf-chk-amount = buf_inkas.num-chk-nf
      662   p-chk-amount = buf_inkas.num-chk
      663   .
      664   END PROCEDURE.
      665   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      666   define new global shared variable g#trdcalib as handle no-undo.
