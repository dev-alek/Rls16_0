      618   procedure proc-alt-shift-f2:
      619     if not ibs.th.gbl.gbl-var:rcode
      620   then
      621     run gbl\inidebug.p .
      622   end.
      623   procedure proc-alt-shift-f3:
      624     run gbl/prvssinf.p
      625       ( input this-procedure
      626       ) .
      627   end.
      628   define variable v-inform-launched as logical no-undo initial false .
      629   procedure proc-alt-shift-f4:
      630     define variable v-action as character no-undo .
      631     if v-inform-launched = false then do:
      632       assign
      633         v-inform-launched = true
      634       .
      635       run gbl/d-inform.w
      636         (  input self
      637         ,  input this-procedure
      638         , output v-action
      639         ) no-error .
      640       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      641       assign
      642         v-inform-launched = false
      643       .
      644     end.
      645   end.
      646   procedure proc-alt-f1:
      647     run gbl/corrhelp.p
      648       (input this-procedure
      649       ) .
      650   end .
      651   on alt-shift-f2 anywhere do:
      652     run proc-alt-shift-f2.
      653   end.
      654   on alt-shift-f3 anywhere do:
      655     run proc-alt-shift-f3 in this-procedure .
      656   end.
      657   on alt-shift-f4 anywhere do:
      658     run proc-alt-shift-f4 in this-procedure.
      659   end.
      660   on alt-f1 anywhere do:
      661     run proc-alt-f1 in this-procedure .
      662   end.
      663   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      664     define variable v-cntxt-db-num        as integer   no-undo .
      665     define variable v-cntxt-userid        as character no-undo .
      666     define variable v-cntxt-level         as character no-undo .
      667     define variable v-cntxt-host-code-obj as integer   no-undo .
      668     define variable v-cntxt-obj-type      as character no-undo .
      669     define variable v-cntxt-obj-code      as integer   no-undo .
      670     define variable v-cntxt-db-num-obj    as integer   no-undo .
      671     define variable v-cntxt-is-admin      as logical   no-undo .
      672   DEFINE BUTTON B-exit AUTO-GO
      673        LABEL "&Ввод"
      674        SIZE 10 BY 1
      675        BGCOLOR 8 .
      676   DEFINE BUTTON B-Help
      677        LABEL "Помо&щь"
      678        SIZE 10 BY 1
      679        BGCOLOR 8 .
      680   DEFINE BUTTON b-quit AUTO-END-KEY
      681        LABEL "&Отмена"
      682        SIZE 10 BY 1
      683        BGCOLOR 8 .
      684   DEFINE VARIABLE E-cashier AS CHARACTER
      685        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      686        SIZE 60.5 BY 2.79 NO-UNDO.
      687   DEFINE VARIABLE E-dcard AS CHARACTER
      688        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      689        SIZE 60.5 BY 2.79 NO-UNDO.
      690   DEFINE VARIABLE E-fgrp AS CHARACTER
      691        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      692        SIZE 60.5 BY 2.79 NO-UNDO.
      693   DEFINE VARIABLE E-gds AS CHARACTER
      694        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      695        SIZE 60.5 BY 2.79 NO-UNDO.
      696   DEFINE VARIABLE E-seller AS CHARACTER
      697        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      698        SIZE 60.5 BY 2.79 NO-UNDO.
      699   DEFINE VARIABLE T-cashier AS LOGICAL INITIAL no
      700        LABEL "Кассиры"
      701        VIEW-AS TOGGLE-BOX
      702        SIZE 30 BY 1 NO-UNDO.
      703   DEFINE VARIABLE T-dcard AS LOGICAL INITIAL no
      704        LABEL "Клиенты (дисконтные карты)"
      705        VIEW-AS TOGGLE-BOX
      706        SIZE 30 BY 1 NO-UNDO.
      707   DEFINE VARIABLE T-fgrp AS LOGICAL INITIAL no
      708        LABEL "Группы блюд"
      709        VIEW-AS TOGGLE-BOX
      710        SIZE 30 BY 1 NO-UNDO.
      711   DEFINE VARIABLE T-gds AS LOGICAL INITIAL no
      712        LABEL "Товары"
      713        VIEW-AS TOGGLE-BOX
      714        SIZE 30 BY 1 NO-UNDO.
      715   DEFINE VARIABLE t-maria AS LOGICAL INITIAL no
      716        LABEL "Товары на кассе МАРКЕТЕР/МАРИЯ"
      717        VIEW-AS TOGGLE-BOX
      718        SIZE 30 BY 1 NO-UNDO.
      719   DEFINE VARIABLE T-seller AS LOGICAL INITIAL no
      720        LABEL "Продавцы"
      721        VIEW-AS TOGGLE-BOX
      722        SIZE 30 BY 1 NO-UNDO.
      723   DEFINE FRAME Dialog-Frame
      724        b-quit AT ROW 1 COL 1
      725        B-exit AT ROW 1 COL 11
      726        B-Help AT ROW 1 COL 41
      727        T-gds AT ROW 2.29 COL 1.75
      728        E-gds AT ROW 2.33 COL 37.13 NO-LABEL
      729        T-dcard AT ROW 5.29 COL 1.75
      730        E-dcard AT ROW 5.33 COL 37.13 NO-LABEL
      731        T-seller AT ROW 8.29 COL 1.75
      732        E-seller AT ROW 8.33 COL 37.13 NO-LABEL
      733        T-cashier AT ROW 11.29 COL 1.75
      734        E-cashier AT ROW 11.33 COL 37.13 NO-LABEL
      735        T-fgrp AT ROW 14.29 COL 1.75
      736        E-fgrp AT ROW 14.33 COL 37.13 NO-LABEL
      737        t-maria AT ROW 17.29 COL 1.75
      738        SPACE(67.24) SKIP(0.74)
      739       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      740            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      741            TITLE "Отложенные задания для пересылки на кассу"
      742            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      743   ASSIGN
      744          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      745          FRAME Dialog-Frame:HIDDEN           = TRUE.
      746   ASSIGN
      747          E-cashier:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      748   ASSIGN
      749          E-dcard:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      750   ASSIGN
      751          E-fgrp:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      752   ASSIGN
      753          E-gds:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      754   ASSIGN
      755          E-seller:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      756   ON GO OF FRAME Dialog-Frame
      757   DO:
      758     assign
      759     T-cashier
      760     T-dcard
      761     T-gds
      762     T-seller
      763     T-fgrp
      764     p-cashier =  T-cashier
      765     p-dcard = T-dcard
      766     p-gds = T-gds
      767     p-seller = T-seller
      768     p-fgrp =  T-fgrp
      769     .
      770   END.
      771   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      772   DO:
      773     APPLY "END-ERROR":U TO SELF.
      774     return "error":U.
      775   END.
      776   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      777   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      778   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      779   on help of frame Dialog-Frame
      780   do:
      781     run gbl/app_help.p
      782       (input this-procedure :file-name
      783       ,input ''
      784       ,input ?
      785       ) no-error.
      786     if error-status :error then do:
      787       message
      788         "Ошибка при вызове помощи"
      789         error-status :get-message(1)
      790         view-as alert-box .
      791     end.
      792   end.
      793   run minbtn-set in this-procedure .
      794   on choose of b-help in frame Dialog-Frame
      795   do:
      796     apply "help":u to frame Dialog-Frame .
      797   end.
      798   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      799   procedure minbtn-set :
      800       do
      801           on error undo, return error return-value
      802           :
      803           define variable ii              as integer       no-undo .
      804           define variable fh              as widget-handle no-undo .
      805           define variable hh              as widget-handle no-undo .
      806           define variable v-h             as handle        extent 4 no-undo .
      807           define variable v-name-button   as character     no-undo .
      808           define variable v-help-old-x    as decimal       no-undo .
      809           define variable v-help-old-y    as decimal       no-undo .
      810           define variable v-help-old-size as decimal       no-undo .
      811           define variable v-frame-width   as decimal       no-undo .
      812           define variable jj              as integer       no-undo .
      813           do
      814               on error undo, return error
      815               :
      816               assign
      817                   v-frame-width = frame Dialog-Frame:width - 0.3
      818                   fh            = frame Dialog-Frame:first-child
      819                   hh            = fh:first-child
      820                   ii            = 1
      821                   .
      822               do while valid-handle(hh):
      823                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      824                   do:
      825                       case lc(hh:name) :
      826                           when "b-help" then
      827                               do:
      828                                   hh:load-image-up("cmp/b-help.bmp":u) .
      829                                   hh:load-image-down("cmp/b-help.bmp":u) .
      830                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      831                                   hh:TOOLTIP = "Помощь" .
      832                                   v-help-old-x = hh:column .
      833                                   v-help-old-y = hh:row    .
      834                                   v-help-old-size = hh:width .
      835                                   hh:width-chars = 2.5 .
      836                               end.
      837                           when "b-print" then
      838                               do:
      839                                   hh:load-image("cmp/b-print.bmp":u) .
      840                                   hh:TOOLTIP = "Печать" .
      841                                   v-h[ii] = hh:handle .
      842                                   ii = ii + 1 .
      843                                   hh:width-chars = 3 .
      844                               end.
      845                           when "b-history" or
      846                           when "b-hist" then
      847                               do:
      848                                   hh:load-image("cmp/b-hist.bmp":u) .
      849                                   hh:TOOLTIP = "История" .
      850                                   v-h[ii] = hh:handle .
      851                                   ii = ii + 1 .
      852                                   hh:width-chars = 3 .
      853                               end.
      854                           when "b-sch" then
      855                               do:
      856                                   hh:load-image("cmp/b-sch.bmp":u) .
      857                                   hh:TOOLTIP = "Установка Фильтра" .
      858                                   v-h[ii] = hh:handle .
      859                                   ii = ii + 1 .
      860                                   hh:width-chars = 3 .
      861                               end.
      862                           when "b-hist-user" then
      863                               do:
      864                                   hh:load-image("cmp/b-hist.bmp":u) .
      865                                   hh:TOOLTIP = "История пользователя" .
      866                                   ii = ii + 1 .
      867                               end.
      868                       end case.
      869                   end.
      870                   hh = hh:next-sibling.
      871               end.
      872               b-help:column = v-frame-width - b-help:width-chars.
      873               jj = 0.
      874               repeat ii = 4 to 1 by -1 :
      875                   if valid-handle (v-h[ii] ) then
      876                   do:
      877                       jj  = jj + 1 .
      878                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      879                       v-h[ii]:row    = v-help-old-y .
      880                   end.
      881               end.
      882           end.
      883       end.
      884   end procedure.
      885   MAIN-BLOCK:
      886   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      887      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      888   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      889     run mainmenu_getcntxt in parparentproc
      890       (output v-cntxt-db-num
      891       ,output v-cntxt-userid
      892       ,output v-cntxt-level
      893       ,output v-cntxt-host-code-obj
      894       ,output v-cntxt-obj-type
      895       ,output v-cntxt-obj-code
      896       ,output v-cntxt-db-num-obj
      897       ,output v-cntxt-is-admin
      898       ) .
      899     if v-cntxt-db-num <> v-cntxt-db-num-obj then do:
      900       message substitute("Невозможен Запуск имеющихся отложенных заданий отсылки на кассу в чужой БД&1" +
      901                          "БД текущего объекта &2, текущая БД &3"
      902                          , chr(10)
      903                          , v-cntxt-db-num-obj
      904                          , v-cntxt-db-num)
      905       view-as alert-box error .
      906       return error.
      907     end.
      908     RUN MYenable.
      909     WAIT-FOR GO OF FRAME Dialog-Frame.
      910   END.
      911   RUN disable_UI.
      912   PROCEDURE disable_UI :
      913     HIDE FRAME Dialog-Frame.
      914   END PROCEDURE.
      915   PROCEDURE enable_UI :
      916     DISPLAY T-gds E-gds T-dcard E-dcard T-seller E-seller T-cashier E-cashier
      917             T-fgrp E-fgrp t-maria
      918         WITH FRAME Dialog-Frame.
      919     ENABLE b-quit B-exit B-Help T-gds E-gds T-dcard E-dcard T-seller E-seller
      920            T-cashier E-cashier T-fgrp E-fgrp
      921         WITH FRAME Dialog-Frame.
      922     VIEW FRAME Dialog-Frame.
      923   END PROCEDURE.
      924   PROCEDURE Myenable :
      925   define variable v-send-maria as logical no-undo .
      926   define variable v-send as logical no-undo .
      927   run str/mrkt-ts.p (input p-curr-obj-type
      928                ,input p-curr-obj-code
      929                ,input 'MARIA':U
      930                ,output v-send-maria) no-error .
      931   assign
      932   v-send = (if v-send-maria <> ?
      933             then v-send-maria
      934             else no)
      935   .
      936   assign
      937   T-cashier = p-cashier
      938   T-dcard  = p-dcard
      939   T-gds  = p-gds
      940   T-seller = p-seller
      941   T-fgrp = p-fgrp
      942   E-gds = p-gds-note
      943   E-dcard = p-dcard-note
      944   E-seller = p-seller-note
      945   E-cashier = p-cashier-note
      946   E-fgrp = p-fgrp-note
      947   t-maria = v-send
      948   .
      949   DISPLAY
      950   E-dcard E-cashier E-gds E-seller E-fgrp
      951   T-gds
      952   T-dcard
      953   T-seller
      954   T-cashier
      955   T-fgrp
      956   t-maria WHEN v-send <> ?
      957   WITH FRAME Dialog-Frame.
      958     ENABLE
      959     b-quit
      960     B-exit
      961     B-Help
      962     T-gds when p-gds
      963     T-dcard when p-dcard
      964     T-seller when p-seller
      965     T-cashier when p-cashier
      966     T-fgrp when p-fgrp
      967     E-gds when p-gds
      968     E-dcard when p-dcard
      969     E-seller when p-seller
      970     E-cashier when p-cashier
      971     E-fgrp when p-fgrp
      972      WITH FRAME Dialog-Frame.
      973   assign
      974   p-gds = no
      975   p-dcard = no
      976   p-seller = no
      977   p-cashier = no
      978   p-fgrp = no
      979   .
      980   VIEW FRAME Dialog-Frame.
      981   IF v-send =? THEN DO:
      982       HIDE
      983       t-maria
      984       IN FRAME Dialog-Frame.
      985   END.
      986   END PROCEDURE.
