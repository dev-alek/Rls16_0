      894   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      895   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      896   procedure fltopend_fltopend :
      897   define input parameter p-parent-handle as handle no-undo .
      898   define input parameter p-qh as handle no-undo .
      899   define input parameter p-flt-open-open-query  as character no-undo .
      900   define input parameter p-where-cond as character no-undo .
      901   define input parameter p-use-indFIRST-query-tail as character no-undo .
      902   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      903   define input parameter p-indexed-reposition as character no-undo .
      904     do
      905     on error undo, return error
      906     :
      907   define variable v-prepare-string as character no-undo .
      908   define variable glog as logical no-undo .
      909   assign
      910   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      911                      p-where-cond + chr(32)  +
      912                      p-use-indFIRST-query-tail + chr(32) +
      913                      p-use-ind-sort-clmn-by + chr(32) +
      914                      p-indexed-reposition
      915   .
      916   assign
      917   glog = p-qh:query-prepare(v-prepare-string) no-error .
      918   if not glog
      919   or error-status:error then do:
      920     message error-status:get-message(1) view-as alert-box .
      921     undo, return error .
      922   end.
      923   assign
      924   glog = p-qh:query-open no-error .
      925   if not glog
      926   or error-status:error then do:
      927     message error-status:get-message(1) view-as alert-box .
      928     undo, return error .
      929   end.
      930     end.
      931   end procedure.
      932   procedure fltopend_fltfindd :
      933   define input parameter p-parent-handle as handle no-undo .
      934   define input parameter p-qh as handle no-undo .
      935   define input parameter p-rowid as rowid no-undo .
      936   define input parameter p-next as logical no-undo .
      937   define input parameter p-lock as integer no-undo .
      938   define input parameter p-bh as handle no-undo .
      939   define input parameter p-where-cond as character no-undo .
      940   define input parameter p-use-index-phrase as character no-undo .
      941   define variable glog as logical no-undo .
      942   define variable v-qh as handle no-undo .
      943   define variable v-bh as handle no-undo .
      944   define variable v-recid as recid no-undo .
      945   define variable v-prepare-string as character no-undo .
      946   do
      947   on error undo, return error
      948   on stop undo, return error
      949   :
      950     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      951     create buffer v-bh for table p-bh buffer-name p-bh:name.
      952     create query v-qh.
      953     v-qh:set-buffers(v-bh).
      954     v-prepare-string = substitute("for each &1 &2 &3"
      955                                     ,v-bh:name
      956                                     ,p-where-cond
      957                                     ,p-use-index-phrase).
      958     glog = v-qh:query-prepare(v-prepare-string) no-error.
      959     if not glog then do:
      960       delete object v-qh.
      961       delete object v-bh.
      962       undo, return error .
      963     end.
      964     glog = v-qh:query-open no-error .
      965     if not glog then do:
      966       delete object v-qh.
      967       delete object v-bh.
      968       undo, return error .
      969     end.
      970     if p-next then do:
      971       v-qh:reposition-to-rowid(p-rowid) no-error .
      972       glog = v-qh:get-next( p-lock) no-error .
      973       glog = v-qh:get-next( p-lock) no-error .
      974       if not glog or v-qh:query-off-end = yes then do:
      975         glog = v-qh:get-first( p-lock) no-error .
      976       end.
      977     end.
      978     else do:
      979       glog = v-qh:get-first( p-lock) no-error .
      980     end.
      981     v-recid = v-bh:recid no-error .
      982     delete object v-qh.
      983     delete object v-bh.
      984     return string(v-recid) .
      985   end.
      986   end procedure.
      987   procedure fltopend_fltfindq :
      988   define input parameter p-parent-handle as handle no-undo .
      989   define input parameter p-qh as handle no-undo .
      990   define input parameter p-next as logical no-undo .
      991   define input parameter p-lock as integer no-undo .
      992   define input parameter p-flt-open-open-query  as character no-undo .
      993   define input parameter p-where-cond as character no-undo .
      994   define input parameter p-use-indFIRST-query-tail as character no-undo .
      995   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      996   define input parameter p-indexed-reposition as character no-undo .
      997   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      998   define variable glog as logical no-undo .
      999   define variable v-qh as handle no-undo .
     1000   define variable v-bh as handle no-undo extent 18.
     1001   define variable v-rowid as rowid no-undo extent 18.
     1002   define variable v-ii as integer no-undo .
     1003   define variable v-prepare-string as character no-undo .
     1004   do
     1005   on error undo, return error
     1006   on stop undo, return error
     1007   :
     1008     create query v-qh.
     1009     do v-ii = 1 to p-qh:num-buffers:
     1010       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1011       assign
     1012       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1013       no-error.
     1014       v-qh:add-buffer(v-bh[v-ii]).
     1015     end.
     1016     assign
     1017     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1018                       p-where-cond + chr(32)  +
     1019                       p-use-indFIRST-query-tail + chr(32) +
     1020                       p-use-ind-sort-clmn-by + chr(32) +
     1021                       p-indexed-reposition
     1022     .
     1023     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1024     if not glog then do:
     1025       delete object v-qh.
     1026       do v-ii = 1 to p-qh:num-buffers:
     1027         delete object v-bh[v-ii].
     1028       end.
     1029       undo, return error .
     1030     end.
     1031     glog = v-qh:query-open no-error .
     1032     if not glog then do:
     1033       delete object v-qh.
     1034       do v-ii = 1 to p-qh:num-buffers:
     1035         delete object v-bh[v-ii].
     1036       end.
     1037       undo, return error .
     1038     end.
     1039     if p-next then do:
     1040       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1041       glog = v-qh:get-next( p-lock) no-error .
     1042       glog = v-qh:get-next( p-lock) no-error .
     1043       if not glog or v-qh:query-off-end = yes then do:
     1044         glog = v-qh:get-first( p-lock) no-error .
     1045       end.
     1046     end.
     1047     else do:
     1048       glog = v-qh:get-first( p-lock) no-error .
     1049     end.
     1050     do v-ii = 1 to p-qh:num-buffers:
     1051       assign
     1052       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1053       no-error.
     1054     end.
     1055     delete object v-qh.
     1056     do v-ii = 1 to p-qh:num-buffers:
     1057       delete object v-bh[v-ii].
     1058     end.
     1059   end.
     1060   end procedure.
     1061     define new global shared variable g#lib-rvs as handle no-undo.
     1062   define variable br-handle as handle no-undo.
     1063   define variable rvs-rec          as   recid            no-undo.
     1064   define variable varlog           as   logical          no-undo.
     1065   define variable filter-label as character no-undo init "История док-тов сверок" .
     1066   define variable filter-label0 as character no-undo init "История док-тов сверок" .
     1067   define variable filter-point0 as character no-undo init "rvscdocs" .
     1068   define variable filter-point as character no-undo init "rvscdocs" .
     1069   define variable sort-column-name as character no-undo .
     1070   define variable v-rid-list as character no-undo .
     1071   define variable vcli-name like ub.clients.obj-name no-undo.
     1072   define variable vhost-name like ub.clients.obj-name no-undo.
     1073   define variable print-option as character no-undo.
     1074   define variable v-r-b-abbr like ub.currency.curr-abbr no-undo .
     1075   define variable add-option as character no-undo.
     1076   define variable v-doc-rec as recid no-undo .
     1077   define buffer buf_cli for ub.clients.
     1078   define buffer buf_obj for ub.clients .
     1079   define buffer buf_rvs-doc for ub.rvs-doc.
     1080   DEFINE MENU MENU-B-print
     1081          MENU-ITEM m_one          LABEL "Документ"
     1082          MENU-ITEM m_list         LABEL "Список"        .
     1083   DEFINE BUTTON B-Help
     1084        LABEL "Помо&щь"
     1085        SIZE 3 BY 1
     1086        BGCOLOR 8 .
     1087   DEFINE BUTTON b-lkp
     1088        LABEL "&Просм"
     1089        SIZE 10 BY 1.
     1090   DEFINE BUTTON B-print
     1091        LABEL "Пе&чать"
     1092        SIZE 3 BY 1.
     1093   DEFINE BUTTON b-quit AUTO-GO
     1094        LABEL "&Выход"
     1095        SIZE 8 BY 1
     1096        BGCOLOR 8 .
     1097   DEFINE BUTTON B-sch
     1098        LABEL "&Фильтр"
     1099        SIZE 3 BY 1.
     1100   DEFINE VARIABLE ED-notes AS CHARACTER
     1101        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1102        SIZE 98 BY 2
     1103        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1104   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1105         VIEW-AS TEXT
     1106        SIZE 6 BY 1
     1107        FGCOLOR 4  NO-UNDO.
     1108   DEFINE VARIABLE sch-code AS CHARACTER FORMAT "X(14)":U
     1109        LABEL "номеру"
     1110        VIEW-AS FILL-IN
     1111        SIZE 12.5 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1112   DEFINE VARIABLE sch-date AS DATE FORMAT "99/99/9999":U
     1113        LABEL "дате"
     1114        VIEW-AS FILL-IN
     1115        SIZE 11.63 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1116   DEFINE VARIABLE sch-fact AS DATE FORMAT "99/99/9999":U
     1117        LABEL "дате факт"
     1118        VIEW-AS FILL-IN
     1119        SIZE 11.63 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1120   DEFINE VARIABLE sch-num AS INTEGER FORMAT ">>>>>>>>>>":U INITIAL 0
     1121        VIEW-AS FILL-IN
     1122        SIZE 12 BY 1
     1123        FGCOLOR 4  NO-UNDO.
     1124   DEFINE VARIABLE v_creid AS CHARACTER FORMAT "X(256)":U
     1125        LABEL "Опер"
     1126         VIEW-AS TEXT
     1127        SIZE 14 BY .71
     1128        FGCOLOR 4  NO-UNDO.
     1129   DEFINE VARIABLE v_deliver AS CHARACTER FORMAT "X(256)":U
     1130        LABEL "Передал"
     1131         VIEW-AS TEXT
     1132        SIZE 14 BY .71
     1133        FGCOLOR 4  NO-UNDO.
     1134   DEFINE VARIABLE v_operator AS CHARACTER FORMAT "X(256)":U
     1135        LABEL "Исп"
     1136         VIEW-AS TEXT
     1137        SIZE 14 BY .71
     1138        FGCOLOR 4  NO-UNDO.
     1139   DEFINE VARIABLE v_receiver AS CHARACTER FORMAT "X(256)":U
     1140        LABEL "Получил"
     1141         VIEW-AS TEXT
     1142        SIZE 14 BY .79
     1143        FGCOLOR 4  NO-UNDO.
     1144   DEFINE QUERY BR-docs FOR
     1145         X_c-rvs-doc SCROLLING.
     1146   DEFINE BROWSE BR-docs
     1147     QUERY BR-docs NO-LOCK DISPLAY
     1148         mark-string( recid(X_c-rvs-doc), v-rid-list ) COLUMN-LABEL "*" FORMAT "X(1)":U
     1149   X_c-rvs-doc.rvs-type COLUMN-LABEL "Т" FORMAT "X(1)":U
     1150   X_c-rvs-doc.status_ COLUMN-LABEL "Стат" FORMAT "X(4)":U
     1151   X_c-rvs-doc.rvs-code FORMAT "X(14)":U
     1152   X_c-rvs-doc.fact-date FORMAT "99/99/99":U
     1153   shift-name-no-err (buffer X_c-rvs-doc) COLUMN-LABEL "№" FORMAT "X(6)":U
     1154   (substring ((string (X_c-rvs-doc.doc-date)), 1, 5)) COLUMN-LABEL "Дата" FORMAT "X(5)":U
     1155   (trim (X_c-rvs-doc.obj-type) + " " + string (X_c-rvs-doc.obj-code, ">>>>9")) COLUMN-LABEL "Объект" FORMAT "X(9)":U
     1156   usrfulnf(X_c-rvs-doc.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1157   X_c-rvs-doc.corr-date COLUMN-LABEL "Дата измен" FORMAT "99/99/9999":U
     1158   string(X_c-rvs-doc.corr-time, "HH:mm:ss") COLUMN-LABEL "Время измен." FORMAT "X(8)":U
     1159       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 16.
     1160   DEFINE FRAME Dialog-Frame
     1161        b-quit AT ROW 1 COL 1.13
     1162        b-lkp AT ROW 1 COL 38
     1163        B-print AT ROW 1 COL 89
     1164        B-sch AT ROW 1 COL 92
     1165        B-Help AT ROW 1 COL 95
     1166        BR-docs AT ROW 2.5 COL 1.13
     1167        ED-notes AT ROW 19.92 COL 1 NO-LABEL
     1168        sch-code AT ROW 22.54 COL 17.63 COLON-ALIGNED
     1169        sch-date AT ROW 22.54 COL 40.75 COLON-ALIGNED
     1170        sch-fact AT ROW 22.58 COL 65.63 COLON-ALIGNED
     1171        sch-num AT ROW 22.58 COL 80.63 COLON-ALIGNED NO-LABEL
     1172        mark-num AT ROW 1 COL 10 COLON-ALIGNED NO-LABEL
     1173        v_operator AT ROW 18.88 COL 4 COLON-ALIGNED
     1174        v_deliver AT ROW 18.88 COL 29 COLON-ALIGNED
     1175        v_receiver AT ROW 18.88 COL 54 COLON-ALIGNED
     1176        v_creid AT ROW 18.92 COL 79 COLON-ALIGNED
     1177        "ПОИСК ПО" VIEW-AS TEXT
     1178             SIZE 9.25 BY 1 AT ROW 22.54 COL 1.5
     1179             FGCOLOR 4
     1180        SPACE(88.38) SKIP(0.06)
     1181       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1182            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1183            TITLE "История документов сверки"
     1184            DEFAULT-BUTTON b-lkp.
     1185   ASSIGN
     1186          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1187          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1188   ASSIGN
     1189          B-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-print:HANDLE.
     1190   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1191   DO:
     1192     APPLY "END-ERROR":U TO SELF.
     1193   END.
     1194   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1195   DO:
     1196         define variable next-prev as character no-undo .
     1197        IF NOT AVAIL x_c-rvs-doc THEN RETURN NO-apply.
     1198       br-handle = BR-docs:handle.
     1199       case x_c-rvs-doc.rvs-type
     1200           :
     1201           when 'перед_док':U
     1202           or
     1203           when 'после_док':U
     1204           then
     1205               do:
     1206   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1207   do:
     1208     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1209       (input  v-cntxt-db-num
     1210       ,input  v-cntxt-userid
     1211       ,input  0
     1212       ,input  'actn_rvs-on-doc_lookup':U
     1213       ,input  'object':U
     1214       ,input  x_c-rvs-doc.host-code
     1215       ,input  x_c-rvs-doc.obj-type
     1216       ,input  x_c-rvs-doc.obj-code
     1217       ,input  0
     1218       ,input  0
     1219       ,input  0
     1220       ,input  true
     1221       ,output varlog
     1222       )  .
     1223   end.
     1224               end.
     1225           when 'смена':U then
     1226               do:
     1227   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1228   do:
     1229     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1230       (input  v-cntxt-db-num
     1231       ,input  v-cntxt-userid
     1232       ,input  0
     1233       ,input  'actn_rvs-shift_lookup':U
     1234       ,input  'object':U
     1235       ,input  x_c-rvs-doc.host-code
     1236       ,input  x_c-rvs-doc.obj-type
     1237       ,input  x_c-rvs-doc.obj-code
     1238       ,input  0
     1239       ,input  0
     1240       ,input  0
     1241       ,input  true
     1242       ,output varlog
     1243       )  .
     1244   end.
     1245               end.
     1246           when 'контроль':U then
     1247               do:
     1248   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1249   do:
     1250     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1251       (input  v-cntxt-db-num
     1252       ,input  v-cntxt-userid
     1253       ,input  0
     1254       ,input  'actn_rvs-control_lookup':U
     1255       ,input  'object':U
     1256       ,input  x_c-rvs-doc.host-code
     1257       ,input  x_c-rvs-doc.obj-type
     1258       ,input  x_c-rvs-doc.obj-code
     1259       ,input  0
     1260       ,input  0
     1261       ,input  0
     1262       ,input  true
     1263       ,output varlog
     1264       )  .
     1265   end.
     1266               end.
     1267           otherwise
     1268           do:
     1269               message
     1270                   vss-workfile vss-revision vss-description skip
     1271                   "Неизвестный тип документа сверки" skip
     1272                   "Тип документа сверки" x_c-rvs-doc.rvs-type skip
     1273                   "Код документа сверки" x_c-rvs-doc.rvs-code skip
     1274                   view-as alert-box error .
     1275               undo, return no-apply .
     1276           end.
     1277       end case .
     1278           if varlog <> yes then
     1279           do:
     1280               return no-apply.
     1281           end.
     1282     ASSIGN
     1283     rvs-rec = RECID( x_c-rvs-doc )
     1284     next-prev = '':U
     1285     .
     1286       DO WHILE next-prev = '':U:
     1287            if NOT available x_c-rvs-doc then do:
     1288           message "Неправильно выбран документ сверки." view-as alert-box ERROR.
     1289           return no-apply.
     1290         end.
     1291               run str/rvs-c-doc.w
     1292                   ( input        parparentproc
     1293                   ,input        'ПРОСМОТР':U
     1294                   ,input        x_c-rvs-doc.rvs-type
     1295                   ,input        no
     1296                   ,input-output rvs-rec
     1297                   ,input-output next-prev
     1298                   ,input this-procedure:handle
     1299                   ) no-error.
     1300               if error-status :error then
     1301               do:
     1302                   return no-apply.
     1303               end.
     1304       end.
     1305       RUN OpenBr in this-procedure ( input  yes, input no, input '':U).
     1306       reposition BR-docs  to recid rvs-rec no-error.
     1307       apply "entry" to BR-docs in frame Dialog-Frame.
     1308       apply "value-changed" to BR-docs in frame Dialog-Frame.
     1309   END.
     1310   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1311   DO:
     1312     if not avail X_c-rvs-doc then return no-apply.
     1313     if print-option = '':U then do:
     1314           run gbl/pop-up.p ( input self:handle, input no) no-error.
     1315     end.
     1316     if print-option = '':U then return no-apply.
     1317     run proc-b-print in this-procedure ( input print-option) no-error.
     1318     if error-status:error then do:
     1319       print-option = '':U.
     1320       return no-apply.
     1321     end.
     1322     APPLY "ENTRY" to br-docs.
     1323   END.
     1324   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1325   DO:
     1326   run proc-b-sch in this-procedure no-error.
     1327   if error-status:error then return no-apply.
     1328   END.
     1329   ON ANY-PRINTABLE OF BR-docs IN FRAME Dialog-Frame
     1330   DO:
     1331      sch-code:screen-value = sch-code:screen-value + last-event:label.
     1332       apply "entry" to sch-code in frame Dialog-Frame.
     1333   apply "end" to sch-code in frame Dialog-Frame.
     1334   END.
     1335   ON RETURN OF BR-docs IN FRAME Dialog-Frame
     1336   or MOUSE-SELECT-DBLCLICK OF br-docs IN FRAME Dialog-Frame DO:
     1337     apply "choose" to b-lkp in frame Dialog-Frame.
     1338       return no-apply.
     1339   END.
     1340   ON CHOOSE OF MENU-ITEM m_list
     1341   DO:
     1342    assign
     1343     print-option = 'LIST':U.
     1344     APPLY "CHOOSE" to b-print in frame Dialog-Frame.
     1345   END.
     1346   ON CHOOSE OF MENU-ITEM m_one
     1347   DO:
     1348    assign
     1349     print-option = 'ONE':U.
     1350     APPLY "CHOOSE" to b-print  in frame Dialog-Frame.
     1351   END.
     1352   ON CTRL-J OF sch-code IN FRAME Dialog-Frame
     1353   DO:
     1354      run proc-find-code in this-procedure ( input yes, input frame Dialog-Frame sch-code) no-error.
     1355     if error-status:error then return no-apply.
     1356   END.
     1357   ON RETURN OF sch-code IN FRAME Dialog-Frame
     1358   DO:
     1359      run proc-find-code in this-procedure ( input no, input frame Dialog-Frame sch-code) no-error.
     1360     if error-status:error then return no-apply.
     1361   END.
     1362   ON CTRL-J OF sch-date IN FRAME Dialog-Frame
     1363   DO:
     1364      run proc-find-date in this-procedure ( input yes, input frame Dialog-Frame sch-date, "doc-date") no-error.
     1365     if error-status:error then return no-apply.
     1366   END.
     1367   ON RETURN OF sch-date IN FRAME Dialog-Frame
     1368   DO:
     1369       run proc-find-date in  this-procedure ( input no, input frame Dialog-Frame sch-date, "doc-date":U) no-error.
     1370     if error-status:error then return no-apply.
     1371   END.
     1372   ON CTRL-J OF sch-fact IN FRAME Dialog-Frame
     1373   DO:
     1374      run proc-find-date in this-procedure ( input yes, input frame Dialog-Frame sch-fact, "fact-date":U) no-error.
     1375     if error-status:error then return no-apply.
     1376   END.
     1377   ON RETURN OF sch-fact IN FRAME Dialog-Frame
     1378   DO:
     1379     run proc-find-date in this-procedure ( input no, input frame Dialog-Frame sch-fact, "fact-date":U) no-error.
     1380     if error-status:error then return no-apply.
     1381   END.
     1382   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1383   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1384   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1385   on help of frame Dialog-Frame
     1386   do:
     1387     run gbl/app_help.p
     1388       (input this-procedure :file-name
     1389       ,input ''
     1390       ,input ?
     1391       ) no-error.
     1392     if error-status :error then do:
     1393       message
     1394         "Ошибка при вызове помощи"
     1395         error-status :get-message(1)
     1396         view-as alert-box .
     1397     end.
     1398   end.
     1399   run minbtn-set in this-procedure .
     1400   on choose of b-help in frame Dialog-Frame
     1401   do:
     1402     apply "help":u to frame Dialog-Frame .
     1403   end.
     1404   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1405   procedure minbtn-set :
     1406       do
     1407           on error undo, return error return-value
     1408           :
     1409           define variable ii              as integer       no-undo .
     1410           define variable fh              as widget-handle no-undo .
     1411           define variable hh              as widget-handle no-undo .
     1412           define variable v-h             as handle        extent 4 no-undo .
     1413           define variable v-name-button   as character     no-undo .
     1414           define variable v-help-old-x    as decimal       no-undo .
     1415           define variable v-help-old-y    as decimal       no-undo .
     1416           define variable v-help-old-size as decimal       no-undo .
     1417           define variable v-frame-width   as decimal       no-undo .
     1418           define variable jj              as integer       no-undo .
     1419           do
     1420               on error undo, return error
     1421               :
     1422               assign
     1423                   v-frame-width = frame Dialog-Frame:width - 0.3
     1424                   fh            = frame Dialog-Frame:first-child
     1425                   hh            = fh:first-child
     1426                   ii            = 1
     1427                   .
     1428               do while valid-handle(hh):
     1429                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1430                   do:
     1431                       case lc(hh:name) :
     1432                           when "b-help" then
     1433                               do:
     1434                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1435                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1436                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1437                                   hh:TOOLTIP = "Помощь" .
     1438                                   v-help-old-x = hh:column .
     1439                                   v-help-old-y = hh:row    .
     1440                                   v-help-old-size = hh:width .
     1441                                   hh:width-chars = 2.5 .
     1442                               end.
     1443                           when "b-print" then
     1444                               do:
     1445                                   hh:load-image("cmp/b-print.bmp":u) .
     1446                                   hh:TOOLTIP = "Печать" .
     1447                                   v-h[ii] = hh:handle .
     1448                                   ii = ii + 1 .
     1449                                   hh:width-chars = 3 .
     1450                               end.
     1451                           when "b-history" or
     1452                           when "b-hist" then
     1453                               do:
     1454                                   hh:load-image("cmp/b-hist.bmp":u) .
     1455                                   hh:TOOLTIP = "История" .
     1456                                   v-h[ii] = hh:handle .
     1457                                   ii = ii + 1 .
     1458                                   hh:width-chars = 3 .
     1459                               end.
     1460                           when "b-sch" then
     1461                               do:
     1462                                   hh:load-image("cmp/b-sch.bmp":u) .
     1463                                   hh:TOOLTIP = "Установка Фильтра" .
     1464                                   v-h[ii] = hh:handle .
     1465                                   ii = ii + 1 .
     1466                                   hh:width-chars = 3 .
     1467                               end.
     1468                           when "b-hist-user" then
     1469                               do:
     1470                                   hh:load-image("cmp/b-hist.bmp":u) .
     1471                                   hh:TOOLTIP = "История пользователя" .
     1472                                   ii = ii + 1 .
     1473                               end.
     1474                       end case.
     1475                   end.
     1476                   hh = hh:next-sibling.
     1477               end.
     1478               b-help:column = v-frame-width - b-help:width-chars.
     1479               jj = 0.
     1480               repeat ii = 4 to 1 by -1 :
     1481                   if valid-handle (v-h[ii] ) then
     1482                   do:
     1483                       jj  = jj + 1 .
     1484                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1485                       v-h[ii]:row    = v-help-old-y .
     1486                   end.
     1487               end.
     1488           end.
     1489       end.
     1490   end procedure.
     1491   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1492   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1493   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1494   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1495   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1496   define variable v-diasize-current-frame-height as decimal   no-undo .
     1497   define variable v-diasize-change-size          as logical   no-undo .
     1498   define variable v-diasize-resize-button        as handle    no-undo .
     1499   define variable v-diasize-wndmax               as logical   no-undo .
     1500   define variable v-diasize-wndstore             as logical   no-undo .
     1501   define variable v-diasize-proc-name            as character no-undo .
     1502   define variable v-diasize-browse-handle        as handle    no-undo .
     1503   define variable v-diasize-browse-number        as integer   no-undo .
     1504   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1505   define temp-table temp-diasize-handle no-undo
     1506     field handle-value  as handle
     1507     field save-position as decimal
     1508     index xpk is primary unique handle-value
     1509     .
     1510   define temp-table temp-browse-handle no-undo
     1511     field browse-type   as character
     1512     field browse-number as integer
     1513     field browse-handle as handle
     1514     field original-size as decimal
     1515     index xpk is primary unique browse-type browse-number
     1516     index xie browse-type browse-handle
     1517   .
     1518   procedure diasize_change-height :
     1519     define input  parameter p-change-value  as decimal   no-undo .
     1520     define input  parameter p-move-resize   as logical   no-undo .
     1521     define variable v-field-group-handle    as handle    no-undo .
     1522     define variable v-object-handle         as handle    no-undo .
     1523     define variable v-frame-height          as decimal   no-undo .
     1524     define variable v-frame-virtual-height  as decimal   no-undo .
     1525     define variable v-browse-height         as decimal   no-undo .
     1526     define variable v-window-height         as decimal   no-undo .
     1527     define variable v-window-virtual-height as decimal   no-undo .
     1528     define variable v-change-sign           as integer   no-undo .
     1529     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1530     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1531     if p-change-value > 0
     1532     then do:
     1533       if frame Dialog-Frame :height + p-change-value
     1534           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1535       then do:
     1536         assign
     1537           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1538                           - (frame Dialog-Frame :height-chars)
     1539         .
     1540         if p-change-value <= 0
     1541         then do:
     1542           run diasize_position-resize-button in this-procedure .
     1543           return .
     1544         end.
     1545       end.
     1546     end.
     1547     if p-change-value < 0
     1548     then do:
     1549       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1550       then do:
     1551         assign
     1552           p-change-value = v-diasize-orig-frame-height
     1553                          - (frame Dialog-Frame :height-chars)
     1554         .
     1555         if p-change-value >= 0
     1556         then do:
     1557           run diasize_position-resize-button in this-procedure .
     1558           return .
     1559         end.
     1560       end.
     1561     end.
     1562     if p-change-value >= 0
     1563     then do:
     1564       assign
     1565         v-change-sign = 1
     1566       .
     1567     end.
     1568     else do:
     1569       assign
     1570         v-change-sign = -1
     1571       .
     1572     end.
     1573     assign
     1574       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1575     .
     1576     if p-change-value = 0
     1577     then do:
     1578       run diasize_position-resize-button in this-procedure .
     1579       return .
     1580     end.
     1581     move_block:
     1582     do
     1583     on error undo move_block, retry move_block
     1584     :
     1585       if retry
     1586       then do:
     1587         do
     1588         on error undo move_block, leave move_block
     1589         :
     1590           if p-change-value > 0
     1591           then do:
     1592             for each buf_temp-diasize-handle
     1593             on error undo, next
     1594             :
     1595               assign
     1596                 v-object-handle = buf_temp-diasize-handle.handle-value
     1597               .
     1598               if v-object-handle <> v-diasize-resize-button
     1599               then do:
     1600                 assign
     1601                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1602                 .
     1603               end.
     1604             end.
     1605             assign
     1606               v-diasize-browse-handle :height = v-browse-height
     1607             .
     1608             for each buf_temp-browse-handle
     1609               where buf_temp-browse-handle.browse-type = 'height':u
     1610             on error undo, next
     1611             :
     1612               assign
     1613                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1614               .
     1615             end.
     1616             assign
     1617               frame Dialog-Frame :height = v-frame-height
     1618             .
     1619             if frame Dialog-Frame :scrollable = true
     1620             then do:
     1621               assign
     1622                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1623               .
     1624             end.
     1625             run diasize_position-resize-button in this-procedure .
     1626           end.
     1627           else do:
     1628             if frame Dialog-Frame :scrollable = true
     1629             then do:
     1630               assign
     1631                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1632               .
     1633             end.
     1634             assign
     1635               frame Dialog-Frame :height = v-frame-height
     1636             .
     1637             assign
     1638               v-diasize-browse-handle :height = v-browse-height
     1639             .
     1640             for each buf_temp-browse-handle
     1641               where buf_temp-browse-handle.browse-type = 'height':u
     1642             on error undo, next
     1643             :
     1644               assign
     1645                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1646               .
     1647             end.
     1648             for each buf_temp-diasize-handle
     1649             on error undo, next
     1650             :
     1651               assign
     1652                 v-object-handle = buf_temp-diasize-handle.handle-value
     1653               .
     1654               if v-object-handle <> v-diasize-resize-button
     1655               then do:
     1656                 assign
     1657                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1658                 .
     1659               end.
     1660             end.
     1661             run diasize_position-resize-button in this-procedure .
     1662           end.
     1663           assign
     1664             v-diasize-change-size = false
     1665           .
     1666           leave move_block .
     1667         end.
     1668       end.
     1669       assign
     1670         v-diasize-need-full-display = true
     1671       .
     1672       if v-diasize-change-size = false
     1673       then do:
     1674         assign
     1675           v-diasize-change-size = true
     1676         .
     1677       end.
     1678       else do:
     1679         return .
     1680       end.
     1681       assign
     1682         v-frame-height = frame Dialog-Frame :height
     1683         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1684         v-browse-height = v-diasize-browse-handle :height
     1685       .
     1686       for each buf_temp-browse-handle
     1687         where buf_temp-browse-handle.browse-type = 'height':u
     1688       :
     1689         assign
     1690           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1691         .
     1692       end.
     1693       for each buf_temp-diasize-handle
     1694       :
     1695         delete buf_temp-diasize-handle .
     1696       end.
     1697       assign
     1698         v-field-group-handle = frame Dialog-Frame :first-child
     1699       .
     1700       do while valid-handle(v-field-group-handle)
     1701       :
     1702         assign
     1703           v-object-handle = v-field-group-handle :first-child
     1704         .
     1705         do while valid-handle(v-object-handle)
     1706         :
     1707           if  v-object-handle <> v-diasize-browse-handle :handle
     1708           and can-query(v-object-handle, "row")
     1709           and can-query(v-object-handle, "height")
     1710           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1711           then do:
     1712             find first buf_temp-browse-handle
     1713               where buf_temp-browse-handle.browse-type   = 'height':u
     1714                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1715               no-error .
     1716             if available buf_temp-browse-handle
     1717             then do:
     1718             end.
     1719             else do:
     1720               create buf_temp-diasize-handle .
     1721               assign
     1722                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1723                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1724               .
     1725             end.
     1726           end.
     1727           assign
     1728             v-object-handle = v-object-handle :next-sibling
     1729           .
     1730         end.
     1731         assign
     1732           v-field-group-handle = v-field-group-handle :next-sibling
     1733         .
     1734       end.
     1735       do with frame Dialog-Frame
     1736       :
     1737         hide v-diasize-resize-button .
     1738         assign
     1739           v-diasize-resize-button :row    = 1
     1740           v-diasize-resize-button :column = 1
     1741         .
     1742       end.
     1743       if p-change-value > 0
     1744       then do:
     1745         if frame Dialog-Frame :scrollable = true
     1746         then do:
     1747           assign
     1748             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1749             no-error .
     1750           if error-status :error
     1751           or error-status :get-message(1) <> ""
     1752           then do:
     1753             undo move_block, retry move_block .
     1754           end.
     1755         end.
     1756         assign
     1757           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1758           no-error .
     1759         if error-status :error
     1760         or error-status :get-message(1) <> ""
     1761         then do:
     1762           undo move_block, retry move_block .
     1763         end.
     1764         assign
     1765           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1766           no-error .
     1767         if error-status :error
     1768         or error-status :get-message(1) <> ""
     1769         then do:
     1770           undo move_block, retry move_block .
     1771         end.
     1772         for each buf_temp-browse-handle
     1773           where buf_temp-browse-handle.browse-type = 'height':u
     1774         on error undo move_block, retry move_block
     1775         :
     1776           assign
     1777             buf_temp-browse-handle.browse-handle :height
     1778               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1779             no-error .
     1780           if error-status :error
     1781           or error-status :get-message(1) <> ""
     1782           then do:
     1783             undo move_block, retry move_block .
     1784           end.
     1785         end.
     1786         for each buf_temp-diasize-handle
     1787         on error undo move_block, retry move_block
     1788         :
     1789           assign
     1790             v-object-handle = buf_temp-diasize-handle.handle-value
     1791           .
     1792           if v-object-handle <> v-diasize-resize-button
     1793           then do:
     1794             assign
     1795               v-object-handle :row = v-object-handle :row + p-change-value
     1796               no-error .
     1797             if error-status :error
     1798             or error-status :get-message(1) <> ""
     1799             then do:
     1800               undo move_block, retry move_block .
     1801             end.
     1802           end.
     1803         end.
     1804       end.
     1805       else do:
     1806         for each buf_temp-diasize-handle
     1807         on error undo move_block, retry move_block
     1808         :
     1809           assign
     1810             v-object-handle = buf_temp-diasize-handle.handle-value
     1811           .
     1812           if v-object-handle <> v-diasize-resize-button
     1813           then do:
     1814             assign
     1815               v-object-handle :row = v-object-handle :row + p-change-value
     1816               no-error .
     1817             if error-status :error
     1818             or error-status :get-message(1) <> ""
     1819             then do:
     1820               undo move_block, retry move_block .
     1821             end.
     1822           end.
     1823         end.
     1824         assign
     1825           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1826           no-error .
     1827         if error-status :error
     1828         or error-status :get-message(1) <> ""
     1829         then do:
     1830           undo move_block, retry move_block .
     1831         end.
     1832         for each buf_temp-browse-handle
     1833           where buf_temp-browse-handle.browse-type = 'height':u
     1834         on error undo move_block, retry move_block
     1835         :
     1836           assign
     1837             buf_temp-browse-handle.browse-handle :height
     1838               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1839             no-error .
     1840           if error-status :error
     1841           or error-status :get-message(1) <> ""
     1842           then do:
     1843             undo move_block, retry move_block .
     1844           end.
     1845         end.
     1846         assign
     1847           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1848           no-error .
     1849         if error-status :error
     1850         or error-status :get-message(1) <> ""
     1851         then do:
     1852           undo move_block, retry move_block .
     1853         end.
     1854         if frame Dialog-Frame :scrollable = true
     1855         then do:
     1856           assign
     1857             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1858             no-error .
     1859           if error-status :error
     1860           or error-status :get-message(1) <> ""
     1861           then do:
     1862             undo move_block, retry move_block .
     1863           end.
     1864         end.
     1865       end.
     1866       if p-move-resize = true
     1867       then do:
     1868         run diasize_position-resize-button in this-procedure .
     1869       end.
     1870       if v-diasize-wndstore = true
     1871       then do:
     1872         if connected("ub") = true
     1873         then do:
     1874           define variable v-cntxt-db-num        as integer   no-undo .
     1875           define variable v-cntxt-userid        as character no-undo .
     1876           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1877                                             , OUTPUT v-cntxt-userid
     1878                                             ) .
     1879           run gbl/wndsizew.p
     1880             (input  v-cntxt-db-num
     1881             ,input  v-cntxt-userid
     1882             ,input  v-diasize-proc-name
     1883             ,input  'height':u
     1884             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1885             ) .
     1886         end.
     1887       end.
     1888     end.
     1889     assign
     1890       v-diasize-change-size = false
     1891     .
     1892   end procedure.
     1893   procedure diasize_set-height :
     1894     define input  parameter p-new-height  as decimal   no-undo .
     1895     define input  parameter p-move-resize as logical   no-undo .
     1896     do
     1897     on error undo, return error return-value
     1898     :
     1899       run diasize_change-height in this-procedure
     1900         (input  (p-new-height - frame Dialog-Frame :height)
     1901         ,input  p-move-resize
     1902         ) .
     1903     end.
     1904   end procedure.
     1905   procedure diasize_change-width :
     1906     define input  parameter p-change-value as decimal   no-undo .
     1907     define input  parameter p-move-resize  as logical   no-undo .
     1908     define variable v-field-group-handle   as handle    no-undo .
     1909     define variable v-object-handle        as handle    no-undo .
     1910     define variable v-frame-width          as decimal   no-undo .
     1911     define variable v-frame-virtual-width  as decimal   no-undo .
     1912     define variable v-browse-width         as decimal   no-undo .
     1913     define variable v-window-width         as decimal   no-undo .
     1914     define variable v-window-virtual-width as decimal   no-undo .
     1915     define variable v-change-sign          as integer   no-undo .
     1916     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1917     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1918     if p-change-value > 0
     1919     then do:
     1920       if frame Dialog-Frame :width + p-change-value >
     1921           session :width-chars
     1922       then do:
     1923         assign
     1924           p-change-value = session :width-chars - frame Dialog-Frame :width
     1925         .
     1926         if p-change-value <= 0
     1927         then do:
     1928           run diasize_position-resize-button in this-procedure .
     1929           return .
     1930         end.
     1931       end.
     1932     end.
     1933     if p-change-value < 0
     1934     then do:
     1935       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1936       then do:
     1937         assign
     1938           p-change-value = v-diasize-orig-frame-width
     1939                          - frame Dialog-Frame :width
     1940         .
     1941         if p-change-value >= 0
     1942         then do:
     1943           run diasize_position-resize-button in this-procedure .
     1944           return .
     1945         end.
     1946       end.
     1947     end.
     1948     if p-change-value >= 0
     1949     then do:
     1950       assign
     1951         v-change-sign = 1
     1952       .
     1953     end.
     1954     else do:
     1955       assign
     1956         v-change-sign = -1
     1957       .
     1958     end.
     1959     assign
     1960       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1961     .
     1962     if p-change-value = 0
     1963     then do:
     1964       run diasize_position-resize-button in this-procedure .
     1965       return .
     1966     end.
     1967     move_block:
     1968     do
     1969     on error undo move_block, leave move_block
     1970     :
     1971       if retry
     1972       then do:
     1973         do
     1974         on error undo move_block, leave move_block
     1975         :
     1976           if p-change-value > 0
     1977           then do:
     1978             for each buf_temp-diasize-handle
     1979             on error undo, next
     1980             :
     1981               assign
     1982                 v-object-handle = buf_temp-diasize-handle.handle-value
     1983               .
     1984               if v-object-handle <> v-diasize-resize-button
     1985               then do:
     1986                 assign
     1987                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1988                 .
     1989               end.
     1990             end.
     1991             assign
     1992               v-diasize-browse-handle :width = v-browse-width
     1993             .
     1994             for each buf_temp-browse-handle
     1995               where buf_temp-browse-handle.browse-type = 'width':u
     1996             on error undo, next
     1997             :
     1998               assign
     1999                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2000               .
     2001             end.
     2002             assign
     2003               frame Dialog-Frame :width = v-frame-width
     2004             .
     2005             if frame Dialog-Frame :scrollable = true
     2006             then do:
     2007               assign
     2008                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2009               .
     2010             end.
     2011             run diasize_position-resize-button in this-procedure .
     2012           end.
     2013           else do:
     2014             if frame Dialog-Frame :scrollable = true
     2015             then do:
     2016               assign
     2017                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2018               .
     2019             end.
     2020             assign
     2021               frame Dialog-Frame :width = v-frame-width
     2022             .
     2023             for each buf_temp-browse-handle
     2024               where buf_temp-browse-handle.browse-type = 'width':u
     2025             on error undo, next
     2026             :
     2027               assign
     2028                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2029               .
     2030             end.
     2031             assign
     2032               v-diasize-browse-handle :width = v-browse-width
     2033             .
     2034             for each buf_temp-diasize-handle
     2035             on error undo, next
     2036             :
     2037               assign
     2038                 v-object-handle = buf_temp-diasize-handle.handle-value
     2039               .
     2040               if v-object-handle <> v-diasize-resize-button
     2041               then do:
     2042                 assign
     2043                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2044                 .
     2045               end.
     2046             end.
     2047             run diasize_position-resize-button in this-procedure .
     2048           end.
     2049           assign
     2050             v-diasize-change-size = false
     2051           .
     2052           leave move_block .
     2053         end.
     2054       end.
     2055       assign
     2056         v-diasize-need-full-display = true
     2057       .
     2058       if v-diasize-change-size = false
     2059       then do:
     2060         assign
     2061           v-diasize-change-size = true
     2062         .
     2063       end.
     2064       else do:
     2065         return .
     2066       end.
     2067       assign
     2068         v-frame-width = frame Dialog-Frame :width
     2069         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2070         v-browse-width = v-diasize-browse-handle :width
     2071       .
     2072       for each buf_temp-browse-handle
     2073         where buf_temp-browse-handle.browse-type = 'width':u
     2074       :
     2075         assign
     2076           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2077         .
     2078       end.
     2079       for each buf_temp-diasize-handle
     2080       :
     2081         delete buf_temp-diasize-handle .
     2082       end.
     2083       assign
     2084         v-field-group-handle = frame Dialog-Frame :first-child
     2085       .
