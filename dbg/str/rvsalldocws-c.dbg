     2087       :
     2088         assign
     2089           v-object-handle = v-field-group-handle :first-child
     2090         .
     2091         do while valid-handle(v-object-handle)
     2092         :
     2093           if  v-object-handle <> v-diasize-browse-handle :handle
     2094           and v-object-handle <> v-diasize-resize-button
     2095           and can-query(v-object-handle, "row")
     2096           and can-query(v-object-handle, "height")
     2097           and ( v-object-handle :col + v-object-handle :width
     2098                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2099               )
     2100           then do:
     2101             find first buf_temp-browse-handle
     2102               where buf_temp-browse-handle.browse-type   = 'width':u
     2103                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2104               no-error .
     2105             if available buf_temp-browse-handle
     2106             then do:
     2107             end.
     2108             else do:
     2109               create buf_temp-diasize-handle .
     2110               assign
     2111                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2112                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2113               .
     2114             end.
     2115           end.
     2116           assign
     2117             v-object-handle = v-object-handle :next-sibling
     2118           .
     2119         end.
     2120         assign
     2121           v-field-group-handle = v-field-group-handle :next-sibling
     2122         .
     2123       end.
     2124       do with frame Dialog-Frame
     2125       :
     2126         hide v-diasize-resize-button .
     2127         v-diasize-resize-button :row = 1.
     2128         v-diasize-resize-button :column = 1.
     2129       end.
     2130       if p-change-value > 0
     2131       then do:
     2132         if frame Dialog-Frame :scrollable = true
     2133         then do:
     2134           assign
     2135             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2136             no-error .
     2137           if error-status :error
     2138           or error-status :get-message(1) <> ""
     2139           then do:
     2140             undo move_block, retry move_block.
     2141           end.
     2142         end.
     2143         assign
     2144           frame Dialog-Frame :width = v-frame-width + p-change-value
     2145           no-error .
     2146         if error-status :error
     2147         or error-status :get-message(1) <> ""
     2148         then do:
     2149           undo move_block, retry move_block.
     2150         end.
     2151         assign
     2152           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2153         no-error .
     2154         if error-status :error
     2155         or error-status :get-message(1) <> ""
     2156         then do:
     2157           undo move_block, retry move_block.
     2158         end.
     2159         for each buf_temp-browse-handle
     2160           where buf_temp-browse-handle.browse-type = 'width':u
     2161         on error undo move_block, retry move_block
     2162         :
     2163           assign
     2164             buf_temp-browse-handle.browse-handle :width
     2165               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2166             no-error .
     2167           if error-status :error
     2168           or error-status :get-message(1) <> ""
     2169           then do:
     2170             undo move_block, retry move_block .
     2171           end.
     2172         end.
     2173         for each buf_temp-diasize-handle
     2174         on error undo move_block, retry move_block
     2175         :
     2176           assign
     2177             v-object-handle = buf_temp-diasize-handle.handle-value
     2178           .
     2179           if v-object-handle <> v-diasize-resize-button
     2180           then do:
     2181             assign
     2182               v-object-handle :col = v-object-handle :col + p-change-value
     2183               no-error .
     2184             if error-status :error
     2185             or error-status :get-message(1) <> ""
     2186             then do:
     2187               undo move_block, retry move_block .
     2188             end.
     2189           end.
     2190         end.
     2191       end.
     2192       else do:
     2193         for each buf_temp-diasize-handle
     2194         on error undo move_block, retry move_block
     2195         :
     2196           assign
     2197             v-object-handle = buf_temp-diasize-handle.handle-value
     2198           .
     2199           if v-object-handle <> v-diasize-resize-button
     2200           then do:
     2201             assign
     2202               v-object-handle :col = v-object-handle :col + p-change-value
     2203               no-error .
     2204             if error-status :error
     2205             or error-status :get-message(1) <> ""
     2206             then do:
     2207               undo move_block, retry move_block .
     2208             end.
     2209           end.
     2210         end.
     2211         for each buf_temp-browse-handle
     2212           where buf_temp-browse-handle.browse-type = 'width':u
     2213         on error undo move_block, retry move_block
     2214         :
     2215           assign
     2216             buf_temp-browse-handle.browse-handle :width
     2217               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2218             no-error .
     2219           if error-status :error
     2220           or error-status :get-message(1) <> ""
     2221           then do:
     2222             undo move_block, retry move_block .
     2223           end.
     2224         end.
     2225         assign
     2226           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2227           no-error .
     2228         if error-status :error
     2229         or error-status :get-message(1) <> ""
     2230         then do:
     2231           undo move_block, retry move_block.
     2232         end.
     2233         assign
     2234           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2235         no-error .
     2236         if error-status :error
     2237         or error-status :get-message(1) <> ""
     2238         then do:
     2239           undo move_block, retry move_block.
     2240         end.
     2241         if frame Dialog-Frame :scrollable = true
     2242         then do:
     2243           assign
     2244             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2245           no-error .
     2246           if error-status :error
     2247           or error-status :get-message(1) <> ""
     2248           then do:
     2249             undo move_block, retry move_block.
     2250           end.
     2251         end.
     2252       end.
     2253       if p-move-resize
     2254       then do:
     2255         run diasize_position-resize-button in this-procedure .
     2256       end.
     2257       if v-diasize-wndstore = true
     2258       then do:
     2259         if connected("ub") = true
     2260         then do:
     2261           define variable v-cntxt-db-num        as integer   no-undo .
     2262           define variable v-cntxt-userid        as character no-undo .
     2263           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2264                                             , OUTPUT v-cntxt-userid
     2265                                             ) .
     2266           run gbl/wndsizew.p
     2267             (input  v-cntxt-db-num
     2268             ,input  v-cntxt-userid
     2269             ,input  v-diasize-proc-name
     2270             ,input  'width':u
     2271             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2272             ) .
     2273         end.
     2274       end.
     2275     end.
     2276     assign
     2277       v-diasize-change-size = false
     2278     .
     2279   end procedure.
     2280   procedure diasize_set-width :
     2281     define input  parameter p-new-width  as decimal   no-undo .
     2282     define input  parameter p-move-resize as logical   no-undo .
     2283     do
     2284     on error undo, return error return-value
     2285     :
     2286       run diasize_change-width in this-procedure
     2287         (input  (p-new-width - frame Dialog-Frame :width)
     2288         ,input  p-move-resize
     2289         ) .
     2290     end.
     2291   end procedure.
     2292   procedure diasize_position-resize-button :
     2293     do with frame Dialog-Frame
     2294     :
     2295       hide v-diasize-resize-button .
     2296       assign
     2297         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2298                     - 1
     2299                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2300         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2301                     - 1
     2302                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2303       .
     2304       view v-diasize-resize-button .
     2305     end.
     2306   end procedure.
     2307   on alt-right anywhere
     2308   do:
     2309     run diasize_change-width in this-procedure
     2310       (input 1
     2311       ,input true
     2312       ) .
     2313     return no-apply .
     2314   end.
     2315   on alt-left anywhere
     2316   do:
     2317     run diasize_change-width in this-procedure
     2318       (input -1
     2319       ,input true
     2320       ) .
     2321     return no-apply .
     2322   end.
     2323   on alt-down anywhere
     2324   do:
     2325     run diasize_change-height in this-procedure
     2326       (input 1
     2327       ,input true
     2328       ) .
     2329     return no-apply .
     2330   end.
     2331   on alt-up anywhere
     2332   do:
     2333     run diasize_change-height in this-procedure
     2334       (input -1
     2335       ,input true
     2336       ) .
     2337     return no-apply .
     2338   end.
     2339   on alt-enter of frame Dialog-Frame
     2340   do:
     2341     run diasize_maximize in this-procedure
     2342       (input  ?
     2343       ).
     2344     return no-apply .
     2345   end.
     2346   procedure diasize_end-move :
     2347     do
     2348     on error undo, return error return-value
     2349     :
     2350       define variable v-row-delta as decimal   no-undo .
     2351       define variable v-col-delta as decimal   no-undo .
     2352       define variable v-new-row as decimal   no-undo .
     2353       define variable v-new-col as decimal   no-undo .
     2354       assign
     2355         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2356         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2357       .
     2358       assign
     2359         v-row-delta = v-new-row - frame Dialog-Frame :height
     2360         v-col-delta = v-new-col - frame Dialog-Frame :width
     2361       .
     2362       run diasize_change-height in this-procedure
     2363         (input v-row-delta
     2364         ,input true
     2365         ) .
     2366       run diasize_change-width in this-procedure
     2367         (input v-col-delta
     2368         ,input true
     2369         ) .
     2370     end.
     2371   end procedure.
     2372   procedure diasize_maximize :
     2373     define input  parameter p-action as logical   no-undo .
     2374     do
     2375     on error undo, return error return-value
     2376     :
     2377       if p-action = ?
     2378       then do:
     2379         if v-diasize-need-maximize = true
     2380         then do:
     2381           assign
     2382             p-action = true
     2383           .
     2384         end.
     2385         else do:
     2386           assign
     2387             p-action = false
     2388           .
     2389         end.
     2390       end.
     2391       if p-action = true
     2392       then do:
     2393         run diasize_change-height in this-procedure
     2394           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2395               - frame Dialog-Frame :height-chars
     2396           ,input true
     2397           ) .
     2398         run diasize_change-width in this-procedure
     2399           (input session :width-chars
     2400               - frame Dialog-Frame :width-chars
     2401           ,input true
     2402           ) .
     2403         assign
     2404           v-diasize-need-maximize = false
     2405         .
     2406       end.
     2407       else do:
     2408         run diasize_change-width in this-procedure
     2409           (input v-diasize-orig-frame-width
     2410               - frame Dialog-Frame :width-chars
     2411           ,input true
     2412           ) .
     2413         run diasize_change-height in this-procedure
     2414           (input v-diasize-orig-frame-height
     2415               - frame Dialog-Frame :height-chars
     2416           ,input true
     2417           ) .
     2418         assign
     2419           v-diasize-need-maximize = true
     2420         .
     2421       end.
     2422     end.
     2423   end procedure.
     2424   procedure diasize_restore-orig-size :
     2425     do
     2426     on error undo, return error return-value
     2427     :
     2428       assign
     2429         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2430         v-diasize-current-frame-height = frame Dialog-Frame :height
     2431       .
     2432       run diasize_set-height in this-procedure
     2433         (input  v-diasize-orig-frame-height
     2434         ,input  true
     2435         ) .
     2436       run diasize_set-width in this-procedure
     2437         (input  v-diasize-orig-frame-width
     2438         ,input  true
     2439         ) .
     2440     end.
     2441   end procedure.
     2442   procedure diasize_restore-current-size :
     2443     do
     2444     on error undo, return error return-value
     2445     :
     2446       run diasize_set-height in this-procedure
     2447         (input  v-diasize-current-frame-height
     2448         ,input  true
     2449         ) .
     2450       run diasize_set-width in this-procedure
     2451         (input  v-diasize-current-frame-width
     2452         ,input  true
     2453         ) .
     2454     end.
     2455   end procedure.
     2456   procedure diasize_set-browse-handle :
     2457     define input  parameter p-browse-handle as handle   no-undo .
     2458     define buffer buf_temp-browse-handle for temp-browse-handle .
     2459     do
     2460     on error undo, return error return-value
     2461     :
     2462       assign
     2463         v-diasize-browse-handle = p-browse-handle
     2464       .
     2465       for each buf_temp-browse-handle
     2466       on error undo, return error return-value
     2467       :
     2468         delete buf_temp-browse-handle .
     2469       end.
     2470     end.
     2471   end procedure.
     2472   procedure diasize_add_browse :
     2473     define input  parameter p-browse-type   as character no-undo .
     2474     define input  parameter p-browse-handle as handle    no-undo .
     2475     define buffer buf_temp-browse-handle for temp-browse-handle .
     2476     do
     2477     on error undo, return error return-value
     2478     :
     2479       assign
     2480         v-diasize-browse-number = v-diasize-browse-number + 1
     2481       .
     2482       create buf_temp-browse-handle .
     2483       assign
     2484         buf_temp-browse-handle.browse-type   = p-browse-type
     2485         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2486         buf_temp-browse-handle.browse-handle = p-browse-handle
     2487       .
     2488     end.
     2489   end procedure.
     2490   procedure diasize_init :
     2491     define variable v-default-value    as logical   no-undo .
     2492     define variable v-restore-saved    as logical   no-undo .
     2493     define variable v-resize-value-str as character no-undo .
     2494     do
     2495     on error undo, return error return-value
     2496     :
     2497       do with frame Dialog-Frame
     2498       :
     2499         assign
     2500           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2501           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2502           v-diasize-browse-handle     = browse BR-docs :handle
     2503         .
     2504         create button v-diasize-resize-button
     2505         assign
     2506           parent        = frame Dialog-Frame :first-child
     2507           label         = "s"
     2508           height-pixels = 16
     2509           width-pixels  = 16
     2510           visible       = true
     2511           sensitive     = true
     2512           movable       = true
     2513           triggers:
     2514             on end-move persistent run diasize_end-move in this-procedure .
     2515           end triggers.
     2516         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2517         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2518         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2519         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2520         assign
     2521           v-diasize-wndmax = false
     2522         .
     2523         if connected("ub") = true
     2524         then do:
     2525           define variable v-cntxt-db-num        as integer   no-undo .
     2526           define variable v-cntxt-userid        as character no-undo .
     2527           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2528                                             , OUTPUT v-cntxt-userid
     2529                                             ) .
     2530           run gbl/wndpar_r.p
     2531             (input  v-cntxt-db-num
     2532             ,input  v-cntxt-userid
     2533             ,input  'wndmax':U
     2534             ,output v-diasize-wndmax
     2535             ,output v-default-value
     2536             ) .
     2537         end.
     2538         assign
     2539           v-diasize-wndstore = false
     2540         .
     2541         if connected("ub") = true
     2542         then do:
     2543           run gbl/wndpar_r.p
     2544             (input  v-cntxt-db-num
     2545             ,input  v-cntxt-userid
     2546             ,input  'wndstore':U
     2547             ,output v-diasize-wndstore
     2548             ,output v-default-value
     2549             ) .
     2550         end.
     2551         assign
     2552           v-diasize-proc-name = entry(1, program-name(2), '.')
     2553         .
     2554         if v-diasize-wndstore = true
     2555         then do:
     2556           assign
     2557             v-restore-saved = false
     2558           .
     2559           if connected("ub") = true
     2560           then do:
     2561             run gbl/wndsizer.p
     2562               (input  v-cntxt-db-num
     2563               ,input  v-cntxt-userid
     2564               ,input  v-diasize-proc-name
     2565               ,input  'height':u
     2566               ,output v-resize-value-str
     2567               ) .
     2568             if v-resize-value-str <> '':U
     2569             then do:
     2570               run diasize_change-height in this-procedure
     2571                 (input  integer(v-resize-value-str)
     2572                 ,input  true
     2573                 ) .
     2574               assign
     2575                 v-restore-saved = true
     2576               .
     2577             end.
     2578           end.
     2579           if connected("ub") = true
     2580           then do:
     2581             run gbl/wndsizer.p
     2582               (input  v-cntxt-db-num
     2583               ,input  v-cntxt-userid
     2584               ,input  v-diasize-proc-name
     2585               ,input  'width':u
     2586               ,output v-resize-value-str
     2587               ) .
     2588             if v-resize-value-str <> '':U
     2589             then do:
     2590               run diasize_change-width in this-procedure
     2591                 (input  integer(v-resize-value-str)
     2592                 ,input  true
     2593                 ) .
     2594               assign
     2595                 v-restore-saved = true
     2596               .
     2597             end.
     2598           end.
     2599           if v-restore-saved <> true
     2600           then do:
     2601             if v-diasize-wndmax = true
     2602             then do:
     2603               run diasize_maximize in this-procedure
     2604                 (input  true
     2605                 ) .
     2606             end.
     2607           end.
     2608         end.
     2609         else do:
     2610           if v-diasize-wndmax = true
     2611           then do:
     2612             run diasize_maximize in this-procedure
     2613               (input  true
     2614               ) .
     2615           end.
     2616         end.
     2617       end.
     2618     end.
     2619   end procedure.
     2620   procedure diasize_need-full-display :
     2621     define output parameter p-need-full-display as logical   no-undo .
     2622     do
     2623     on error undo, return error return-value
     2624     :
     2625       assign
     2626         p-need-full-display = v-diasize-need-full-display
     2627       .
     2628       assign
     2629         v-diasize-need-full-display = false
     2630       .
     2631     end.
     2632   end procedure.
     2633   procedure get-context :
     2634      define output parameter p-db-num as integer          no-undo.
     2635      define output parameter p-user-id as character        no-undo.
     2636      define variable v-login               as character    no-undo.
     2637      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2638      define buffer buf_user-login  for ub.user-login .
     2639      do
     2640      on error undo, return error
     2641      :
     2642            FIND FIRST buf_sys-ctrl no-lock.
     2643            ASSIGN
     2644               v-login = USERID("ub")
     2645               p-db-num = buf_sys-ctrl.db-num
     2646            .
     2647            FIND FIRST buf_user-login
     2648                 WHERE buf_user-login.db-num = p-db-num
     2649                   AND buf_user-login.user-login = v-login
     2650                 no-lock
     2651                 no-error
     2652                 .
     2653            IF AVAILABLE buf_user-login
     2654            THEN DO:
     2655               assign
     2656                  p-user-id = buf_user-login.user-id
     2657               .
     2658            END.
     2659      end.
     2660   end procedure.
     2661       run diasize_init in this-procedure .
     2662   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2663   procedure set-filter-name :
     2664   define input parameter p-filter-name as character no-undo .
     2665     do with frame Dialog-Frame:
     2666       if p-filter-name > "" then do:
     2667         assign
     2668           frame Dialog-Frame:title
     2669             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2670         .
     2671         assign
     2672           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2673         .
     2674       end.
     2675       else do:
     2676         assign
     2677           b-sch :tooltip = ""
     2678         .
     2679       end.
     2680     end.
     2681   end procedure.
     2682   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2683   on F3 of frame Dialog-Frame anywhere do:
     2684     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
     2685     return no-apply.
     2686   end.
     2687   define variable vss-include-info24 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2688   on F2 of frame Dialog-Frame anywhere do:
     2689     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     2690     return no-apply.
     2691   end.
     2692   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2693   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     2694     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     2695     return no-apply.
     2696   end.
     2697   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2698   on f5 of frame Dialog-Frame anywhere
     2699   do:
     2700      v-doc-rec = recid(X_c-rvs-doc). run openbr in this-procedure ( input yes, input no, input '':U).                reposition br-docS to recid v-doc-rec no-error.                APPLY 'ENTRY' to br-docs. APPLY 'VALUE-CHANGED' to br-docS.
     2701       apply "VALUE-CHANGED" to BR-docs.
     2702   end.
     2703   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2704   do:
     2705     BR-docs :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2706   end.
     2707   MAIN-BLOCK:
     2708   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2709      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2710   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2711     run mainmenu_getcntxt in parparentproc
     2712       (output v-cntxt-db-num
     2713       ,output v-cntxt-userid
     2714       ,output v-cntxt-level
     2715       ,output v-cntxt-host-code-obj
     2716       ,output v-cntxt-obj-type
     2717       ,output v-cntxt-obj-code
     2718       ,output v-cntxt-db-num-obj
     2719       ,output v-cntxt-is-admin
     2720       ) .
     2721     FIND FIRST ub.sys-ctrl NO-LOCK.
     2722     if avail sys-ctrl then do:
     2723       FIND FIRST db no-LOCK where
     2724                 db.db-num = sys-ctrl.db-num NO-ERROR.
     2725       if not avail db then do:
     2726         message "Отсутствует запись о БД (db)"
     2727         view-as alert-box ERROR.
     2728         return error.
     2729       end.
     2730     END.
     2731     FIND FIRST buf_obj No-LOCK WHERE
     2732                     buf_obj.obj-type = v-cntxt-obj-type and
     2733                     buf_obj.obj-code = v-cntxt-obj-code No-ERROR.
     2734       if parlist-mode =  'объект':U then dO:
     2735           FIND FIRST buf_cli No-LOCK WHERE
     2736                           buf_cli.obj-type = v-cntxt-obj-type and
     2737                           buf_cli.obj-code = v-cntxt-obj-code No-ERROR.
     2738           if not avail buf_cli then do:
     2739               message vss-workfile vss-revision vss-description skip
     2740               view-as alert-box ERROR.
     2741               return.
     2742           end.
     2743       end.
     2744   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2745   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-abbr in g#library
     2746     (input  buf_obj.host-code
     2747     ,output v-r-b-abbr
     2748     )  .
     2749     v-rid-list = string(out-rec).
     2750     RUN MyEnable in this-procedure .
     2751     HIDE mark-num in frame Dialog-Frame .
     2752     WAIT-FOR GO OF FRAME Dialog-Frame.
     2753   END.
     2754   RUN disable_UI in this-procedure .
     2755   PROCEDURE disable_UI :
     2756     HIDE FRAME Dialog-Frame.
     2757   END PROCEDURE.
     2758   PROCEDURE enable_UI :
     2759     DISPLAY ED-notes sch-code sch-date sch-fact sch-num mark-num v_operator
     2760             v_deliver v_receiver v_creid
     2761         WITH FRAME Dialog-Frame.
     2762     ENABLE b-quit b-lkp B-print B-sch B-Help BR-docs ED-notes
     2763            sch-code sch-date sch-fact sch-num mark-num v_operator v_deliver
     2764            v_receiver v_creid
     2765         WITH FRAME Dialog-Frame.
     2766     VIEW FRAME Dialog-Frame.
     2767   END PROCEDURE.
     2768   PROCEDURE Myenable :
     2769     ASSIGN
     2770     br-docs:NUM-LOCKED-COLUMNS IN FRAME  Dialog-Frame  = 4
     2771     b-print:MENU-MOUSE = 1
     2772   .
     2773   DISPLAY
     2774   ED-notes
     2775   sch-code
     2776   sch-date
     2777   sch-fact
     2778   sch-num
     2779   mark-num
     2780   v_operator
     2781   v_deliver
     2782   v_receiver
     2783   v_creid
     2784   WITH FRAME Dialog-Frame .
     2785   ENABLE
     2786   b-quit
     2787   b-lkp
     2788   B-sch
     2789   B-print
     2790   B-Help
     2791   BR-docs
     2792   ED-notes
     2793   sch-code
     2794   sch-date
     2795   sch-fact
     2796   sch-num
     2797   mark-num
     2798   v_operator
     2799   v_deliver
     2800   v_receiver
     2801   v_creid
     2802   WITH FRAME Dialog-Frame .
     2803   VIEW FRAME Dialog-Frame .
     2804   RUn openbr in this-procedure ( input  yes, input no, input '':U).
     2805   END PROCEDURE.
     2806   PROCEDURE OpenBr :
     2807   define input  parameter p-open-query     as logical   no-undo .
     2808   define input  parameter p-find-next      as logical   no-undo .
     2809   define input  parameter p-find-condition as character no-undo .
     2810   define variable l-query-was-opened as logical no-undo .
     2811   define variable title0 as character no-undo.
     2812   title0 = "История документов сверки".
     2813   define variable sort-column-phrase as character no-undo .
     2814   case sort-column-name :
     2815   when "" then do:
     2816   assign
     2817     sort-column-phrase = ""
     2818   .
     2819   end.
     2820   otherwise do:
     2821   assign
     2822     sort-column-phrase = "by " + sort-column-name
     2823   .
     2824   end.
     2825   end case.
     2826   define variable l-open-query as logical   no-undo .
     2827   define variable vartest-asi like ub.rvs-doc.rvs-type no-undo .
     2828   assign vartest-asi = 'проверка':U .
     2829   CASE parlist-mode :
     2830   WHEN 'объект':U THEN DO:
     2831     if p-open-query then do:
     2832       ASSIGN
     2833       frame Dialog-Frame:TITLE = title0 + " Удаленные документы: Объект: " + v-cntxt-obj-type + string(v-cntxt-obj-code).
     2834     end.
     2835       filter-label = substitute("&1 Удаленные документы по одному объекту", filter-label0)
     2836       .
     2837   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2838   define variable  l-disable-where-31  as logical   no-undo .
     2839   define variable  l-filter-open-31    as logical   .
     2840   define variable  flt-rec-31       as recid     no-undo .
     2841   define variable  filter-name-31      as character no-undo .
     2842   define variable  where-phrase-31     as character no-undo .
     2843   define variable  sort-phrase-31      as character no-undo .
     2844   define variable  where-phrase-rus-31 as character no-undo .
     2845   define variable  sort-phrase-rus-31  as character no-undo .
     2846     run waitfram-show in this-procedure
     2847       (input "ЖДИТЕ ..."
     2848       ).
     2849   run gbl/flt-get.p
     2850     (input filter-point
     2851     ,output flt-rec-31
     2852     ,output filter-name-31
     2853     ,output where-phrase-31
     2854     ,output sort-phrase-31
     2855     ,output where-phrase-rus-31
     2856     ,output sort-phrase-rus-31
     2857     ).
     2858   if p-open-query then do:
     2859       run set-filter-name in this-procedure
     2860         (INPUT filter-name-31
     2861         ) no-error .
     2862     assign
     2863       l-filter-open-31 = false
     2864     .
     2865     if flt-rec-31 <> ?
     2866       or sort-column-phrase > ""
     2867     then do:
     2868       define variable  parameter-2-31 as character no-undo .
     2869       define variable  parameter-3-31 as character no-undo .
     2870       define variable  parameter-4-31 as character no-undo .
     2871       define variable  parameter-5-31 as character no-undo .
     2872       define variable  parameter-6-31 as character no-undo .
     2873       define variable  parameter-7-31 as character no-undo .
     2874         assign
     2875         parameter-3-31 =
     2876                                 "FOR EACH X_c-rvs-doc"
     2877         parameter-4-31 =
     2878           (
     2879             if ("       X_c-rvs-doc.host-code = v-cntxt-host-code-obj AND       X_c-rvs-doc.obj-type  = v-cntxt-obj-type  AND       X_c-rvs-doc.obj-code  = v-cntxt-obj-code  AND       X_c-rvs-doc.rvs-type <> vartest-asi       AND       X_c-rvs-doc.is-del = yes and      x_c-rvs-doc.action = integer('99':U)
     2880          " + " " + where-phrase-31) <> ""
     2881             then  substitute(' X_c-rvs-doc.host-code = &1 AND       X_c-rvs-doc.obj-type  = &2&3&2  AND       X_c-rvs-doc.obj-code  = &4  AND        X_c-rvs-doc.rvs-type <> &2&5&2
     2882         X_c-rvs-doc.is-del = yes ', v-cntxt-host-code-obj, chr(34), v-cntxt-obj-type, v-cntxt-obj-code, vartest-asi )   + " " + where-phrase-31
     2883             else "true"
     2884           )
     2885         parameter-5-31 = (" " + "" + " " + "")
     2886         parameter-6-31 = if sort-phrase-31 = ''
     2887                              then
     2888           (
     2889           " " + " USE-INDEX stat-fact " +
     2890             " " + sort-column-phrase +
     2891           " " + "  "
     2892           )
     2893                              else
     2894           (
     2895           " " + " USE-INDEX stat-fact " +
     2896             " " + sort-column-phrase +
     2897           " " + sort-phrase-31
     2898           )
     2899         parameter-7-31 =
     2900           " indexed-reposition  "
     2901       .
     2902       do
     2903       on stop undo, leave
     2904       on error undo, leave
     2905       :
     2906         assign
     2907           l-disable-where-31 =
     2908             ("       X_c-rvs-doc.host-code = v-cntxt-host-code-obj AND       X_c-rvs-doc.obj-type  = v-cntxt-obj-type  AND       X_c-rvs-doc.obj-code  = v-cntxt-obj-code  AND       X_c-rvs-doc.rvs-type <> vartest-asi       AND       X_c-rvs-doc.is-del = yes and      x_c-rvs-doc.action = integer('99':U)
     2909          " + " " + where-phrase-31 = "")
     2910         .
     2911         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2912                             ,input QUERY br-docs:handle
     2913                             ,input parameter-3-31
     2914                             ,input parameter-4-31
     2915                             ,input parameter-5-31
     2916                             ,input parameter-6-31
     2917                             ,input parameter-7-31
     2918                             )
     2919         .
     2920         assign
     2921           l-filter-open-31 = true
     2922         .
     2923       end.
     2924       if l-filter-open-31 = false then do:
     2925         message
     2926           "Ошибка при фильтрации / сортировке" skip
     2927           "Будут показаны записи без учета фильтра" skip
     2928           view-as alert-box .
     2929       end.
     2930       else do:
     2931           assign
     2932             l-query-was-opened = true
     2933           .
     2934       end.
     2935     end.
     2936     if l-filter-open-31 = false then do:
     2937       OPEN QUERY br-docs FOR EACH X_c-rvs-doc
     2938         where        X_c-rvs-doc.host-code = v-cntxt-host-code-obj AND       X_c-rvs-doc.obj-type  = v-cntxt-obj-type  AND       X_c-rvs-doc.obj-code  = v-cntxt-obj-code  AND       X_c-rvs-doc.rvs-type <> vartest-asi       AND       X_c-rvs-doc.is-del = yes and      x_c-rvs-doc.action = integer('99':U)
     2939          USE-INDEX stat-fact
     2940         indexed-reposition
     2941     .
     2942         assign
     2943           l-query-was-opened = true
     2944         .
     2945     end.
     2946   end.
     2947   else do:
     2948     assign
     2949       v-doc-rec = recid( X_c-rvs-doc )
     2950     .
     2951     do
     2952     on stop undo, leave
     2953     on error undo, leave
     2954     :
     2955       if QUERY br-docs:handle:get-buffer-handle(1) = (buffer X_c-rvs-doc:handle) then do:
     2956         assign
     2957         parameter-2-31 = (if p-find-next then "true":u else "false":u )
     2958         parameter-4-31 =
     2959           "where ":u +  substitute(' X_c-rvs-doc.host-code = &1 AND       X_c-rvs-doc.obj-type  = &2&3&2  AND       X_c-rvs-doc.obj-code  = &4  AND        X_c-rvs-doc.rvs-type <> &2&5&2
     2960         X_c-rvs-doc.is-del = yes ', v-cntxt-host-code-obj, chr(34), v-cntxt-obj-type, v-cntxt-obj-code, vartest-asi )   + " ":u + where-phrase-31 + " ":u + p-find-condition + " " + ""
     2961         parameter-5-31 = " USE-INDEX stat-fact "
     2962       .
     2963         run fltopend_fltfindd in this-procedure  (
     2964                             input this-procedure:handle
     2965                             ,input QUERY br-docs:handle
     2966                             ,input rowid(X_c-rvs-doc)
     2967                             ,input logical(parameter-2-31)
     2968                             ,input no-lock
     2969                             ,input (buffer X_c-rvs-doc:handle)
     2970                             ,input parameter-4-31
     2971                             ,input parameter-5-31
     2972                             ) no-error.
     2973         .
     2974         assign
     2975           v-doc-rec = integer(return-value)
     2976           v-fltopend-rowid[1] = ?
     2977         .
     2978       end.
     2979       else do:
     2980         assign
     2981         parameter-2-31 = (if p-find-next then "true":u else "false":u )
     2982         parameter-3-31 =  "FOR EACH X_c-rvs-doc"
     2983         parameter-4-31 =
     2984           (
     2985             if ("       X_c-rvs-doc.host-code = v-cntxt-host-code-obj AND       X_c-rvs-doc.obj-type  = v-cntxt-obj-type  AND       X_c-rvs-doc.obj-code  = v-cntxt-obj-code  AND       X_c-rvs-doc.rvs-type <> vartest-asi       AND       X_c-rvs-doc.is-del = yes and      x_c-rvs-doc.action = integer('99':U)
     2986          " + " " + where-phrase-31) <> ""
     2987             then  substitute(' X_c-rvs-doc.host-code = &1 AND       X_c-rvs-doc.obj-type  = &2&3&2  AND       X_c-rvs-doc.obj-code  = &4  AND        X_c-rvs-doc.rvs-type <> &2&5&2
     2988         X_c-rvs-doc.is-del = yes ', v-cntxt-host-code-obj, chr(34), v-cntxt-obj-type, v-cntxt-obj-code, vartest-asi )   + " " + where-phrase-31
     2989             else "true"
     2990           )
     2991         parameter-5-31 = (" " + "" + " " + "" + " " + p-find-condition)
     2992         parameter-6-31 = if sort-phrase-31 = ''
     2993                              then
     2994           (
     2995           " " + " USE-INDEX stat-fact " +
     2996             " " + sort-column-phrase +
     2997           " " + "  "
     2998           )
     2999                              else
     3000           (
     3001           " " + " USE-INDEX stat-fact " +
     3002             " " + sort-column-phrase +
     3003           " " + sort-phrase-31
     3004           )
     3005         parameter-7-31 =
     3006           " indexed-reposition  "
     3007       .
     3008         run fltopend_fltfindq in this-procedure  (
     3009                             input this-procedure:handle
     3010                             ,input QUERY br-docs:handle
     3011                             ,input logical(parameter-2-31)
     3012                             ,input no-lock
     3013                             ,input parameter-3-31
     3014                             ,input parameter-4-31
     3015                             ,input parameter-5-31
     3016                             ,input parameter-6-31
     3017                             ,input parameter-7-31
     3018                             ,output v-fltopend-rowid
     3019                             ) no-error.
     3020         .
     3021         v-doc-rec = ?.
     3022       end.
     3023       assign
     3024         l-query-was-opened = true
     3025       .
     3026     end.
     3027   end.
     3028     run waitfram-hide in this-procedure .
     3029   END.
     3030   END CASE.
     3031   if not p-open-query and v-doc-rec <> ? then
     3032   REPOSITION br-docs to recid v-doc-rec No-ERROR.
     3033   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3034   query br-docs:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3035   APPLY "VALUE-CHANGED" TO br-docs in frame Dialog-Frame.
     3036   APPLY "ENTRY" TO br-docs.
     3037   END PROCEDURE.
     3038   PROCEDURE proc-b-print :
     3039   DEFINE INPUT PARAMETER loc-option as character no-undo.
     3040   define variable glog as logical no-undo .
     3041   if loc-option = '':U then return error.
     3042   define variable vss-include-info32 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3043   do:
     3044     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3045       (input  v-cntxt-db-num
     3046       ,input  v-cntxt-userid
     3047       ,input  0
     3048       ,input  'actn_rvs-doc_print':U
     3049       ,input  'object':U
     3050       ,input  v-cntxt-host-code-obj
     3051       ,input  v-cntxt-obj-type
     3052       ,input  v-cntxt-obj-code
     3053       ,input  0
     3054       ,input  0
     3055       ,input  0
     3056       ,input  true
     3057       ,output glog
     3058       )  .
     3059   end.
     3060   IF glog <> YES
     3061   THEN DO:
     3062   RETURN ERROR.
     3063   END.
     3064   loc-option = ''.
     3065   END PROCEDURE.
     3066   PROCEDURE proc-find-code :
     3067   define input parameter par-next as logical no-undo.
     3068   define input parameter pardoc-code like ub.add-line.doc-code no-undo.
     3069   display
     3070   "  /  /":U @ sch-date
     3071   "  /  /":U @ sch-fact
     3072   with frame Dialog-Frame.
     3073   assign
     3074   pardoc-code = chr(34) + pardoc-code + chr(34).
     3075   run OpenBr in this-procedure
     3076     (input false
     3077     ,input par-next
     3078     ,input substitute("and X_c-rvs-doc.rvs-code   begins &1 "
     3079       , pardoc-code)
     3080     ).
     3081   apply "entry":u to sch-code in frame Dialog-Frame .
     3082   END PROCEDURE.
     3083   PROCEDURE proc-find-date :
     3084   define input parameter par-next as logical no-undo.
     3085   define input parameter par-date like ub.c-rvs-doc.doc-date no-undo.
     3086   define input parameter parwhat-date as character no-undo.
     3087   define variable var-datechr as character no-undo.
     3088   display
     3089   '':U @ sch-code
     3090   with frame Dialog-Frame.
     3091   assign
     3092   var-datechr = string(day(par-date)) + chr(47) +
     3093                 string(month(par-date)) + chr(47) +
     3094                 string(year(par-date)).
     3095   case parwhat-date:
     3096     when "doc-date":U then do:
     3097       display
     3098       "  /  /":U @ sch-fact
     3099       with frame Dialog-Frame.
     3100       run OpenBr in this-procedure
     3101       (input false
     3102       ,input true
     3103       ,input substitute("and X_c-rvs-doc.doc-date = &1 "
     3104         , var-datechr)
     3105       ).
     3106       apply "entry":u to sch-date in frame Dialog-Frame.
     3107     end.
     3108     when "fact-date":U then do:
     3109       display
     3110       "  /  /":U @ sch-date
     3111       with frame Dialog-Frame.
     3112       run OpenBr in this-procedure
     3113         (input false
     3114         ,input true
     3115         ,input substitute("and X_c-rvs-doc.fact-date = &1 "
     3116         , var-datechr)
     3117         ).
     3118       apply "entry":u to sch-fact in frame Dialog-Frame.
     3119     end.
     3120   END case.
     3121   END PROCEDURE.
     3122   PROCEDURE reposition-c-rvs-doc :
     3123   define input  parameter p-direction   as character no-undo .
     3124   define output parameter p-rvs-doc-recid as recid no-undo .
     3125     case p-direction :
     3126       when "first":U
     3127       then do:
     3128         get first br-docs.
     3129       end.
     3130       when "last":U
     3131       then do:
     3132         get last br-docs.
     3133       end.
     3134       when "prev":U
     3135       then do:
     3136         get prev br-docs.
     3137         if not available X_c-rvs-doc then do:
     3138           message
     3139           "Это первый документ списка"
     3140           view-as alert-box.
     3141         end.
     3142       end.
     3143       when "next":U
     3144       then do:
     3145         get next br-docs.
     3146         if not available X_c-rvs-doc then do:
     3147           message
     3148           "Это последний документ списка"
     3149           view-as alert-box.
     3150         end.
     3151       end.
     3152     end case .
     3153     assign
     3154     p-rvs-doc-recid = recid(X_c-rvs-doc)
     3155     .
     3156     run reposition-query in this-procedure
     3157       (input p-rvs-doc-recid
     3158       ).
     3159   END PROCEDURE.
     3160   PROCEDURE reposition-query :
     3161   define input parameter p-recid as recid no-undo .
     3162     if p-recid <> ?
     3163     then do:
     3164       reposition br-docs to recid p-recid no-error.
     3165     end.
     3166     do with frame Dialog-Frame:
     3167       apply "entry":u to browse BR-docs .
     3168       apply "VALUE-CHANGED":u to browse BR-docs .
     3169     end.
     3170   END PROCEDURE.
