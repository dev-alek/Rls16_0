      126   procedure cur-time :
      127      define output parameter p-today as date      no-undo .
      128      define output parameter p-time  as integer   no-undo .
      129     do
      130     on error undo, return error
      131     :
      132       define variable v-date1 as date      no-undo .
      133       define variable v-date2 as date      no-undo .
      134       define variable v-time  as integer   no-undo .
      135       assign
      136         v-date1 = today
      137         v-time  = time
      138         v-date2 = today
      139       .
      140       if v-date1 <> v-date2
      141       then do:
      142         assign
      143           v-date1 = today
      144           v-time  = v-time
      145         .
      146       end.
      147       assign
      148         p-today = v-date1
      149         p-time  = v-time
      150       .
      151     end.
      152   end.
      153   function cur-time-date returns character
      154   :
      155     return string(today, '99/99/9999':U) .
      156   end.
      157   function cur-time-mjd returns decimal
      158   :
      159     define variable v-date as date      no-undo .
      160     define variable v-time as integer   no-undo .
      161     run cur-time in this-procedure
      162       (output v-date
      163       ,output v-time
      164       ) .
      165     return integer(v-date) - 2400002 + (v-time / 86400) .
      166   end.
      167   function cur-time-get-ending-index returns integer
      168   (input p-number as integer
      169   )
      170   :
      171     if p-number < 0
      172     or p-number = ?
      173     then do:
      174       return 1 .
      175     end.
      176     define variable v-rest as integer   no-undo .
      177     assign
      178       p-number = p-number modulo 100
      179     .
      180     if p-number < 20
      181     then do:
      182       assign
      183         v-rest = p-number
      184       .
      185     end.
      186     else do:
      187       assign
      188         v-rest = p-number modulo 10
      189       .
      190     end.
      191     case v-rest :
      192       when 1
      193       then do:
      194         return 2 .
      195       end.
      196       when 2 or
      197       when 3 or
      198       when 4
      199       then do:
      200         return 3 .
      201       end.
      202       otherwise do:
      203         return 1 .
      204       end.
      205     end case .
      206   end.
      207   procedure cur-time-mjd-to-date :
      208      define input  parameter i-mjd-diff as decimal no-undo.
      209      define output parameter o-Date     as date    no-undo.
      210      define output parameter o-Time     as integer no-undo.
      211      define variable v-day-number as integer   no-undo .
      212      if    i-mjd-diff < 0
      213         or i-mjd-diff = ?
      214      then do:
      215         return "?" .
      216      end.
      217      assign
      218         v-day-number = truncate(i-mjd-diff,0).
      219         o-Date = date(v-day-number + 2400002).
      220         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      221     .
      222   end.
      223   function cur-time-mjd-to-string returns character
      224   (input p-mjd-diff as decimal
      225   )
      226   :
      227     define variable v-day-number as integer   no-undo .
      228     define variable v-seconds    as integer   no-undo .
      229     define variable v-hour       as integer   no-undo .
      230     define variable v-min        as integer   no-undo .
      231     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      232     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      233     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      234     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      235     if p-mjd-diff < 0
      236     or p-mjd-diff = ?
      237     then do:
      238       return "?" .
      239     end.
      240     assign
      241       v-day-number = integer(truncate(p-mjd-diff,0))
      242       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      243     .
      244     if v-seconds > 86400
      245     then do:
      246       assign
      247         v-seconds = 86400 - 1
      248       .
      249     end.
      250     if v-seconds < 0
      251     then do:
      252       assign
      253         v-seconds = 0
      254       .
      255     end.
      256     assign
      257       v-hour = truncate(v-seconds / 3600, 0)
      258     .
      259     assign
      260       v-seconds = v-seconds modulo 3600
      261     .
      262     assign
      263       v-min = truncate(v-seconds / 60, 0)
      264     .
      265     assign
      266       v-seconds = v-seconds modulo 60
      267     .
      268     return
      269         (if v-day-number <> 0
      270           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      271           else ""
      272         )
      273       + (if v-day-number <> 0 or v-hour <> 0
      274           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      275           else ""
      276         )
      277       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      278           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      279           else ""
      280         )
      281       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      282       .
      283   end.
      284   function cur-time-string returns character
      285   :
      286     define variable v-date as date      no-undo .
      287     define variable v-time as integer   no-undo .
      288     run cur-time in this-procedure
      289       (output v-date
      290       ,output v-time
      291       ) .
      292     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      293   end.
      294   function cur-time-string-sec returns character
      295   :
      296     define variable v-date as date      no-undo .
      297     define variable v-time as integer   no-undo .
      298     run cur-time in this-procedure
      299       (output v-date
      300       ,output v-time
      301       ) .
      302     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      303   end.
      304   function cur-time-custom  returns character
      305   (input p-prefix as character
      306   ,input p-date-format as character
      307   ,input p-delimiter as character
      308   ,input p-time-format as character
      309   ,input p-suffix as character
      310   )
      311   :
      312     define variable v-date as date      no-undo .
      313     define variable v-time as integer   no-undo .
      314     run cur-time in this-procedure
      315       (output v-date
      316       ,output v-time
      317       ) .
      318     return
      319       p-prefix
      320       + string(v-date, p-date-format)
      321       + p-delimiter
      322       + string(v-time, p-time-format)
      323       + p-suffix
      324       .
      325   end.
      326   function cur-time-print  returns character
      327   :
      328     define variable v-date as date      no-undo .
      329     define variable v-time as integer   no-undo .
      330     run cur-time in this-procedure
      331       (output v-date
      332       ,output v-time
      333       ) .
      334     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      335   end.
      336   function cur-time-datetime returns datetime
      337   :
      338     define variable v-char as character no-undo .
      339     define variable v-datetime as datetime no-undo .
      340     v-char = cur-time-string().
      341     v-datetime = datetime(v-char).
      342     return  v-datetime.
      343   end.
      344   function cur-time-string-msec returns character
      345   :
      346     define variable v-date as datetime  no-undo .
      347     v-date = now.
      348     return string(v-date) .
      349   end.
