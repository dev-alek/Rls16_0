      873   FUNCTION mark-string RETURNS CHARACTER
      874     ( input p-recid as recid, input mark-list as character  ) :
      875     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
