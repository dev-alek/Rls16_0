     4633     ) no-error .
     4634                             if gp-price-sale = ?
     4635                       and not (lookup (STRING(if buf_chk-gds.write-off-code <> ? then buf_chk-gds.write-off-code else 0),  '2,-2,3,-3,-4':U) > 0)
     4636                       then DO:
     4637         MESSAGE substitute("Чек &1 Строка &2&3Бар-код &4 Артикул &5 &6&3Нет продажной цены&3Чек не будет закачан в продажу"                                    , X_chk-doc.doc-code                                               , Buf_chk-gds.line-num                                             , chr(10)                                                    , ub.bar-code.b-code                                                  , ub.goods.artic                                                      , ub.goods.gds-name) view-as alert-box ERROR .
     4638                         undo _one-check, leave _one-check.
