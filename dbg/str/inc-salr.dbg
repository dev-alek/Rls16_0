        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-call-handle  as handle no-undo .
        4   define input-output parameter p-ii as integer no-undo .
        5   define input-output parameter p-ii-ok as integer no-undo .
        6   define input parameter p-filter-on as logical no-undo .
        7   define input parameter p-filter-rus as character no-undo .
        8   define input parameter p-rid-list as character no-undo .
        9   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
       10   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
       11   define input parameter v-curr-r-b  as character no-undo .
       12   define input parameter is-wth      as logical   no-undo .
       13   define input parameter cas-shft    as logical no-undo init no.
       14   define input parameter one-curs    as logical no-undo init no.
       15   define input parameter cas-curs    as logical no-undo init no.
       16   define input parameter cursh       like ub.curr-shop.exch-rate init 0.
       17   define input parameter cursh-scale like ub.curr-shop.exch-rate.
       18   define input parameter prcl-spl    as logical no-undo init no.
       19   define input parameter pay-gds-algo as character no-undo .
       20   define input parameter rdtaxcd     as INTEGER                  no-undo.
       21   define input parameter exctaxcd    as INTEGER                  no-undo.
       22   define input parameter factorrt    as decimal no-undo.
       23   define input parameter btltaxcd    as INTEGER                  no-undo.
       24   define input parameter gds-amount  as integer .
