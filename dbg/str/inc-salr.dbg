     4608                   MESSAGE substitute("&1 &2 &3&4Чек &5 строка &6, цена товара-услуги с бар-кодом &7=0&4Чек не будет закачан в продажу"                                      , vss-workfile                                                       , vss-revision                                                       , vss-description                                                    , chr(10)                                                      , X_chk-doc.doc-code                                                 , buf_chk-gds.line-num                                               , buf_chk-gds.b-code) view-as alert-box ERROR .
     4609                       undo _one-check, leave _one-check.
     4610                     end.
     4611                     FIND FIRST ub.units No-LOCK WHERE
     4612                               ub.units.unit-name = ub.goods.unit-base No-ERROR.
     4613                     if lookup('2ед':U, ub.units.type) > 0 then cashparts-chk = yes.
