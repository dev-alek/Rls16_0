     4555          and t-gds.b-code      = buf_chk-gds.b-code
     4556          and t-gds.drc         = recid(X_chk-doc)
     4557          AND t-gds.pump        = buf_chk-gds.pump
     4558          AND t-gds.nozzle-code = buf_chk-gds.nozzle-code NO-ERROR.
     4559                     else
     4560   find first t-gds
     4561        WHERE t-gds.doc-code    = buf_sale-doc.doc-code
     4562          and t-gds.b-code      = buf_chk-gds.b-code
     4563          and t-gds.drc         = recid(X_chk-doc)
     4564          AND t-gds.pump        = buf_chk-gds.pump NO-ERROR.
     4565                   end.
     4566                   else do:
     4567                     if buf_chk-gds.nozzle-code <> 0 then
     4568   find first t-gds
     4569        WHERE t-gds.doc-code    = buf_sale-doc.doc-code
     4570          and t-gds.b-code      = buf_chk-gds.b-code
     4571          and t-gds.drc         = recid(X_chk-doc)
     4572          AND t-gds.pump        = buf_chk-gds.pump
     4573          AND t-gds.nozzle-code = buf_chk-gds.nozzle-code
     4574          AND t-gds.pl-code     = buf_chk-gds.pl-code NO-ERROR.
