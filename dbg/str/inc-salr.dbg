     2408   procedure placelib_write-attr:
     2409   define input  parameter p-code     like ub.place-attr.attr-code .
     2410   define input  parameter p-obj-code like ub.place-attr.obj-code .
     2411   define input  parameter p-obj-type like ub.place-attr.obj-type .
     2412   define input  parameter p-pl-code  like ub.place-attr.pl-code .
     2413   define input  parameter p-value    like ub.place-attr.attr-value .
     2414   define output parameter p-ok       as logical.
     2415   define buffer buf_place-attr for ub.place-attr .
     2416     do on error undo, return error return-value :
     2417        p-ok = false.
     2418        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     2419                                                   and buf_place-attr.obj-code    = p-obj-code
     2420                                                   and buf_place-attr.obj-type    = p-obj-type
     2421                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     2422        if not available buf_place-attr then do :
     2423           create buf_place-attr.
     2424           assign
     2425             buf_place-attr.attr-code   = p-code
     2426             buf_place-attr.attr-value  = p-value
     2427             buf_place-attr.obj-code    = p-obj-code
     2428             buf_place-attr.obj-type    = p-obj-type
     2429             buf_place-attr.pl-code     = p-pl-code
     2430           .
     2431           p-ok = true.
     2432        end.
     2433        else do:
     2434           buf_place-attr.attr-value  = p-value .
     2435           p-ok = true.
     2436        end.
     2437     end.
     2438   end.
     2439   procedure placelib_get-attr:
     2440   define input  parameter  p-code     like ub.place-attr.attr-code .
     2441   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     2442   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     2443   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     2444   define output parameter  p-value    like ub.place-attr.attr-value .
     2445   define output parameter  p-ok       as logical.
     2446   define buffer buf_place-attr for ub.place-attr .
     2447     do on error undo, return error return-value :
     2448        p-ok = false.
     2449        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     2450                                                   and buf_place-attr.obj-code    = p-obj-code
     2451                                                   and buf_place-attr.obj-type    = p-obj-type
     2452                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     2453        if available buf_place-attr then do :
     2454          p-value = buf_place-attr.attr-value.
     2455          p-ok = true.
     2456        end.
     2457        else do :
     2458          p-ok = false.
     2459        end.
     2460     end.
     2461   end.
     2462   procedure placelib_del-attr:
     2463   define input parameter  p-code     like ub.place-attr.attr-code .
     2464   define input parameter  p-obj-code like ub.place-attr.obj-code .
     2465   define input parameter  p-obj-type like ub.place-attr.obj-type .
     2466   define input parameter  p-pl-code  like ub.place-attr.pl-code .
     2467   define input parameter  p-value    like ub.place-attr.attr-value .
     2468   define output parameter p-ok       as logical.
     2469   define buffer buf_place-attr for ub.place-attr .
     2470     do on error undo, return error return-value :
     2471        p-ok = false.
     2472        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     2473                                                   and buf_place-attr.obj-code    = p-obj-code
     2474                                                   and buf_place-attr.obj-type    = p-obj-type
     2475                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     2476        if available buf_place-attr then do :
     2477           delete buf_place-attr.
     2478           p-ok = true.
     2479        end.
     2480     end.
     2481   end.
     2482   define shared buffer X_chk-doc for ub.chk-doc.
     2483   DEFINE shared QUERY QUERY-chk-doc FOR X_chk-doc SCROLLING.
     2484   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile: inc-salr.i $ $Revision: 5b89e89c1f45, 2641, rls $".
     2485   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2486   FUNCTION get-inc-sal returns integer(input p-chk-type as character
     2487                                      , input p-netto as decimal
     2488                                      , input p-chk-doc as logical
     2489                                      , input p-office as character
     2490                                      , input p-write-off-code  as character
     2491                                      , output p-add as logical
     2492                                      , output p-office-to-reserv as character
     2493                                      , output p-kind-to-reserv as character
     2494                                      , output p-add-nf-amount as integer
     2495                                      ):
     2496   define variable v-docs-to-reserv as integer no-undo.
     2497   if lookup(p-chk-type , '14,15,16,36,8,101,106,108,11,12,13,40,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0
     2498   then do:
     2499       assign
     2500       v-docS-to-reserv = 0
     2501       p-kind-to-reserv = '':U
     2502       p-add-nf-amount = 1
     2503       .
     2504       return v-docs-to-reserv.
     2505   end.
     2506   p-add = no.
     2507   if p-chk-doc then do:
     2508     if p-chk-type = ? then do:
     2509       if p-netto >= 0 then do:
     2510         assign
     2511         p-chk-type = '1':U.
     2512       end.
     2513       if p-netto < 0 then do:
     2514         assign
     2515         p-chk-type = '6':U.
     2516       end.
     2517     end.
     2518     CASE p-chk-type:
     2519       when '1':U then do:
     2520         assign
     2521         p-kind-to-reserv = 'es':U
     2522         v-docs-to-reserv = 1
     2523         .
     2524       end.
     2525       when '6':U then do:
     2526         assign
     2527         p-kind-to-reserv = 'rs':U
     2528         v-docs-to-reserv = 1
     2529         .
     2530       end.
     2531       when '17':U then do:
     2532         assign
     2533         p-kind-to-reserv = 'trf':U
     2534         v-docs-to-reserv = 1
     2535         .
     2536       end.
     2537       when '96':U then do:
     2538         assign
     2539         p-kind-to-reserv = 'rs':U + chr(44) + 'rwo':U
     2540         v-docs-to-reserv = 2
     2541         .
     2542       end.
     2543       when '69':U then do:
     2544         assign
     2545         p-kind-to-reserv = 'swo':U
     2546         v-docs-to-reserv = 1
     2547         .
     2548       end.
     2549       otherwise do:
     2550         assign
     2551         p-kind-to-reserv = '':U
     2552         v-docs-to-reserv = 0
     2553         .
     2554       End.
     2555     END CASE.
     2556     ASSIGN
     2557     p-add-nf-amount = 0.
     2558     if p-office = 'т':U
     2559     or p-office = 'у':U then do:
     2560       p-office-to-reserv = (if v-docs-to-reserv = 0
     2561                             then '':U
     2562                             else trim(fill((p-office + chr(44)), v-docs-to-reserv), chr(44))).
     2563     end.
     2564     else do:
     2565       assign
     2566       p-office-to-reserv  = (if v-docs-to-reserv = 0
     2567                              then '':U
     2568                              else (trim(fill(entry(1, p-office) + chr(44), v-docs-to-reserv), chr(44)) +
     2569                                   chr(44) +
     2570                                    trim(fill(entry(2, p-office) + chr(44), v-docs-to-reserv), chr(44))))
     2571       v-docs-to-reserv = v-docs-to-reserv * 2
     2572       p-kind-to-reserv = (if p-kind-to-reserv = '':U
     2573                           then  '':U
     2574                           else (p-kind-to-reserv + chr(44) + p-kind-to-reserv)) .
     2575     end.
     2576     return v-docs-to-reserv.
     2577   end.
     2578   else do:
     2579     ASSIGN
     2580     P-kind-to-reserv = '':U
     2581     p-add-nf-amount = 0
     2582     p-add = yes
     2583     p-office-to-reserv = '':U
     2584     .
     2585     if p-write-off-code = '0':U
     2586     or p-write-off-code = ? then do:
     2587       return 0.
     2588     end.
     2589     CASE p-chk-type:
     2590       when '1':U
     2591       then do:
     2592          if p-write-off-code = '1':U
     2593          or p-write-off-code = '3':U
     2594          then do:
     2595             assign
     2596             p-kind-to-reserv = 'swo':U
     2597             v-docs-to-reserv = 1
     2598             p-add = no
     2599             p-office-to-reserv = p-office
     2600             .
     2601          end.
     2602       end.
     2603       when '6':U then do:
     2604          if p-write-off-code = '-6':U
     2605          or p-write-off-code = '-3':U
     2606          then do:
     2607             assign
     2608             p-kind-to-reserv = 'rwo':U
     2609             v-docs-to-reserv = 1
     2610             p-add = no
     2611             p-office-to-reserv = p-office
     2612             .
     2613          end.
     2614       end.
     2615     END CASE.
     2616     return v-docs-to-reserv.
     2617   end.
     2618   END FUNCTION.
     2619   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2620     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
     2621       define variable v-answ as logical no-undo .
     2622       if ( p-unit-base-cli-eq = true
     2623            and p-density = 1.0
     2624          )
     2625         or ( p-unit-base-cli-eq = false
     2626              and p-density <> ?
     2627              and p-density > 0.0
     2628              and p-density < 1.0
     2629            )
     2630       then do:
     2631         assign
     2632           v-answ = true
     2633         .
     2634       end.
     2635       else do:
     2636         assign
     2637           v-answ = false
     2638         .
     2639       end.
     2640       return v-answ.
     2641     end function.
     2642   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2643   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2644   define variable pychk_kk as integer no-undo .
     2645   define variable pychk_jj as integer no-undo .
     2646   define variable pychk_jjp as integer no-undo .
     2647   define variable pychk_jjo as integer no-undo .
     2648   define variable pychk_pay-sum as decimal no-undo .
     2649   DEFINE VARIABLE pychk_No-EXCH as logical no-undo.
     2650   DEFINE VARIABLE pychk_No-EXCH-rubl as logical no-undo.
     2651   DEFINE VARIABLE pychk_dop-sump as decimal No-UNDO.
     2652   DEFINE VARIABLE pychk_dop-sumg as decimal No-UNDO.
     2653   DEFINE VARIABLE pychk_dop-sumk as decimal No-UNDO.
     2654   DEFINE VARIABLE pychk_exch as decimal No-UNDO.
     2655   DEFINE VARIABLE pychk_exch-rubl as decimal No-UNDO.
     2656   define variable pychk_rec-type as integer no-undo .
     2657   define variable pychk_line-type as integer no-undo .
     2658   define variable pychk_create as logical no-undo .
     2659   define variable pychk_pays_count as integer no-undo .
     2660   define variable pychk_zero-gds as decimal no-undo .
     2661   define variable pychk_zero-pay as decimal no-undo .
     2662   define variable pychk_zero-n as decimal no-undo .
     2663   define variable pychk_value as character no-undo .
     2664   define variable pychk_type as character no-undo .
     2665   define variable pychk_line-type-chr as character no-undo .
     2666   define variable pychk_payline_rrn as character no-undo .
     2667   define variable vSum as decimal no-undo.
     2668   define variable vSumRound as decimal no-undo.
     2669   define variable pychk_sum-promo as decimal no-undo.
     2670   define variable vPromoLineNum as integer no-undo.
     2671   define temp-table temp-ptrl-goods no-undo
     2672   field b-code as integer
     2673   field gds-code as integer
     2674   field ptrl-good as logical
     2675   index pi as unique primary
     2676   b-code
     2677   .
     2678   define buffer buf_temp-chk-gds for temp-chk-gds.
     2679   define buffer buf_temp-chk-gds2 for temp-chk-gds.
     2680   define buffer buf_chk-gds-pay for ub.chk-gds-pay.
     2681   define buffer buf2_chk-doc for ub.chk-doc.
     2682   define buffer buf_bar-code for ub.bar-code.
     2683   define buffer buf_chk-pay-attr for ub.chk-pay-attr .
     2684   function ChkGdsPromo returns logical
     2685       (input iDocCode as character)
     2686       :
     2687       define buffer buf_chk-gds for ub.chk-gds.
     2688       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     2689       define variable vPromo as logical no-undo.
     2690       vPromo = no.
     2691       cspr:
     2692       for each buf_chk-gds no-lock where
     2693                    buf_chk-gds.doc-code = iDocCode,
     2694              first buf_chk-gds-attr no-lock where
     2695                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     2696                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     2697                and buf_chk-gds-attr.attr-code = "CSPromo"
     2698                and buf_chk-gds-attr.attr-value <> "0":
     2699          vPromo = yes.
     2700          leave cspr.
     2701       end.
     2702       return vPromo.
     2703   end.
     2704   function ChkPromoLine returns logical
     2705       (input iDocCode as character,
     2706       input iLineNum as integer)
     2707       :
     2708       define buffer buf_chk-gds for ub.chk-gds.
     2709       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     2710       define variable vPromo as logical no-undo.
     2711       vPromo = no.
     2712       find first buf_chk-gds-attr no-lock where
     2713                    buf_chk-gds-attr.doc-code = iDocCode
     2714                and buf_chk-gds-attr.line-num  = iLineNum
     2715                and buf_chk-gds-attr.attr-code = "CSPromo"
     2716                and buf_chk-gds-attr.attr-value <> "0"
     2717       no-error.
     2718       if avail buf_chk-gds-attr then vPromo = yes.
     2719       return vPromo.
     2720   end.
     2721   function ChkPromoSum returns decimal
     2722       (input iDocCode as character,
     2723        input iLineNum as integer)
     2724       :
     2725      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     2726      define variable vSumPromo as decimal no-undo.
     2727      find first buf_chk-gds-attr no-lock where
     2728                 buf_chk-gds-attr.doc-code = iDocCode
     2729             and buf_chk-gds-attr.line-num  = iLineNum
     2730             and buf_chk-gds-attr.attr-code = "CSPromoSum"
     2731         no-error.
     2732      if avail buf_chk-gds-attr then
     2733         vSumPromo = DEC(buf_chk-gds-attr.attr-value) no-error.
     2734      return vSumPromo.
     2735   end function.
     2736   function ChkPromoPrice returns logical
     2737       (input iDocCode as character,
     2738        input iLineNum as integer)
     2739       :
     2740      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     2741      define variable v-is-promo as logical no-undo.
     2742      v-is-promo = no.
     2743      find first buf_chk-gds-attr no-lock where
     2744                 buf_chk-gds-attr.doc-code = iDocCode
     2745             and buf_chk-gds-attr.line-num  = iLineNum
     2746             and buf_chk-gds-attr.attr-code = "CSPromo"
     2747         no-error.
     2748      if avail buf_chk-gds-attr
     2749        and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
     2750      then v-is-promo = yes.
     2751      return v-is-promo.
     2752   end function.
     2753   function ChkDopLitr returns logical
     2754       (input iDocCode as character,
     2755        input iLineNum as integer)
     2756       :
     2757      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     2758      define variable v-is-promo as logical no-undo.
     2759      v-is-promo = no.
     2760      find first buf_chk-gds-attr no-lock where
     2761                 buf_chk-gds-attr.doc-code = iDocCode
     2762             and buf_chk-gds-attr.line-num  = iLineNum
     2763             and buf_chk-gds-attr.attr-code = "CSPromo"
     2764         no-error.
     2765      if avail buf_chk-gds-attr and
     2766        buf_chk-gds-attr.attr-value = "3"
     2767      then v-is-promo = yes.
     2768      return v-is-promo.
     2769   end function.
     2770   function RoundUp return decimal
     2771       (input iQnty as decimal,
     2772        input iPrice as decimal):
     2773       def var vSum  as decimal no-undo.
     2774       def var vSumR as decimal no-undo.
     2775       vSum = ABSOLUTE(iQnty) * iPrice.
     2776       vSumR = Round(vSum,2).
     2777       if vSumR < vSum then vSumR = vSumR + 0.01.
     2778       if iQnty < 0 then vSumR = - vSumR.
     2779       return vSumR.
     2780   end function.
     2781   function GetPromoSum returns decimal
     2782       (input iDocCode as character)
     2783       :
     2784       define buffer buf_chk-doc for ub.chk-doc.
     2785       define buffer buf2_chk-doc for ub.chk-doc.
     2786       define buffer buf_chk-gds for ub.chk-gds.
     2787       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     2788       define buffer buf2_chk-gds for ub.chk-gds.
     2789       define buffer buf2_chk-gds-attr for ub.chk-gds-attr.
     2790       define variable v-price-base as decimal no-undo.
     2791       define variable v-doc-qnty as decimal no-undo.
     2792       define variable v-sum-base as decimal no-undo.
     2793       define variable v-sum-all as decimal no-undo.
     2794       define variable v-sum-promo as decimal no-undo.
     2795       define variable v-sum-chk as decimal no-undo.
     2796       assign
     2797          v-price-base = 0
     2798          v-doc-qnty = 0
     2799          v-sum-all = 0
     2800          v-sum-chk = 0
     2801          v-sum-promo = 0
     2802          .
     2803       for each buf_chk-gds no-lock where
     2804                buf_chk-gds.doc-code = iDocCode,
     2805          first buf_chk-gds-attr no-lock where
     2806                buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     2807            and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     2808            and buf_chk-gds-attr.attr-code = "CSPromoSum"
     2809          :
     2810          v-sum-promo = Dec(buf_chk-gds-attr.attr-value).
     2811       end.
     2812       if v-sum-promo = 0 then do:
     2813           for each buf_chk-gds no-lock where
     2814                    buf_chk-gds.doc-code = iDocCode,
     2815              first buf_chk-gds-attr no-lock where
     2816                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     2817                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     2818                and buf_chk-gds-attr.attr-code = "CSPromo"
     2819                and can-do("1,6", buf_chk-gds-attr.attr-value)
     2820              :
     2821              assign
     2822                v-price-base = buf_chk-gds.price-base
     2823                v-doc-qnty   = if buf_chk-gds.doc-qnty = ? then buf_chk-gds.src-qnty else buf_chk-gds.doc-qnty
     2824                v-sum-base = if buf_chk-gds.sum-base = ? then round(v-doc-qnty * v-price-base, 2) else buf_chk-gds.sum-base
     2825                .
     2826           end.
     2827           for each buf_chk-gds no-lock where
     2828                    buf_chk-gds.doc-code = iDocCode,
     2829              first buf_chk-gds-attr no-lock where
     2830                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     2831                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     2832                and buf_chk-gds-attr.attr-code = "CSPromo"
     2833                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
     2834              :
     2835              if v-price-base = 0 then do:
     2836                 find first buf_chk-doc no-lock where
     2837                            buf_chk-doc.doc-code = iDocCode
     2838                     no-error.
     2839                 if avail buf_chk-doc and
     2840                    buf_chk-doc.chk-type = int('6':U) and
     2841                    buf_chk-doc.doc-num2 > ""  and
     2842                    num-entries(buf_chk-doc.doc-num2,":") = 2
     2843                 then
     2844                 for first buf2_chk-doc no-lock where
     2845                           buf2_chk-doc.obj-code = buf_chk-doc.obj-code
     2846                       and buf2_chk-doc.obj-type = buf_chk-doc.obj-type
     2847                       and buf2_chk-doc.chk-type = int('1':U)
     2848                       and buf2_chk-doc.chk-num = int(entry(1,buf_chk-doc.doc-num2,":"))
     2849                       and buf2_chk-doc.z-number = int(entry(2, buf_chk-doc.doc-num2,":"))
     2850                       :
     2851                   for each buf2_chk-gds no-lock where
     2852                            buf2_chk-gds.doc-code = buf2_chk-doc.doc-code,
     2853                      first buf2_chk-gds-attr no-lock where
     2854                            buf2_chk-gds-attr.doc-code = buf2_chk-gds.doc-code
     2855                        and buf2_chk-gds-attr.line-num  = buf2_chk-gds.line-num
     2856                        and buf2_chk-gds-attr.attr-code = "CSPromo"
     2857                        and can-do("1,6", buf2_chk-gds-attr.attr-value)
     2858                      :
     2859                       v-price-base = buf2_chk-gds.price-base.
     2860                   end.
     2861                 end.
     2862              end.
     2863              if buf_chk-gds.sum-base = ? or buf_chk-gds.src-qnty = 0 then do:
     2864                  assign
     2865                     v-sum-all = (buf_chk-gds.src-qnty + v-doc-qnty) * v-price-base
     2866                     v-sum-chk = v-sum-base + RoundUp(buf_chk-gds.src-qnty, buf_chk-gds.src-price)
     2867                     .
     2868              end.
     2869              else do:
     2870                 assign
     2871                 v-sum-all = (buf_chk-gds.doc-qnty + v-doc-qnty ) * v-price-base
     2872                 v-sum-chk = v-sum-base + buf_chk-gds.sum-base
     2873                 .
     2874              end.
     2875           end.
     2876           v-sum-promo = Round(v-sum-all, 2) - Round(v-sum-chk, 2).
     2877       end.
     2878       return v-sum-promo.
     2879   end function.
     2880   function GetUnBaseSum returns decimal
     2881       (input iDocCode as character,
     2882        input iLineNum as integer,
     2883        input iQnty as decimal,
     2884        input iPrice as decimal):
     2885      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     2886      define variable vBaseSum as decimal no-undo.
     2887      define variable vDiscSum as decimal no-undo.
     2888      vDiscSum = 0.
     2889      find first buf_chk-gds-attr no-lock where
     2890                        buf_chk-gds-attr.doc-code = iDocCode
     2891                    and buf_chk-gds-attr.line-num  = iLineNum
     2892                    and buf_chk-gds-attr.attr-code = "CSPromoSum"
     2893             no-error.
     2894      if avail buf_chk-gds-attr then
     2895         vDiscSum = dec(buf_chk-gds-attr.attr-value) no-error.
     2896      vBaseSum = iQnty * iPrice + vDiscSum.
     2897      if vDiscSum = 0 and ChkPromoPrice(iDocCode, iLineNum) then
     2898         vBaseSum = RoundUp(iQnty, iPrice).
     2899      return vBaseSum.
     2900   end function.
     2901   function GetRoundSum returns decimal
     2902       (input iDocCode as character,
     2903        input iLineNum as integer,
     2904        input iQnty as decimal,
     2905        input iPrice as decimal):
     2906      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     2907      define variable vBaseSum as decimal no-undo.
     2908      if ChkPromoPrice(iDocCode, iLineNum) then
     2909         vBaseSum = RoundUp(iQnty, iPrice).
     2910      else vBaseSum = iQnty * iPrice.
     2911      return vBaseSum.
     2912   end function.
     2913   function GetRoundSumChkDel returns decimal
     2914       (input iDocCode as character,
     2915        input iLineNum as integer,
     2916        input iChipNum as integer,
     2917        input iQnty as decimal,
     2918        input iPrice as decimal):
     2919      define buffer  buf_c-chk-doc-attr for ub.c-chk-doc-attr.
     2920      define variable vBaseSum as decimal no-undo.
     2921      define variable vIsPromo as logical no-undo.
     2922      for each buf_c-chk-doc-attr no-lock where
     2923               buf_c-chk-doc-attr.doc-code = iDocCode
     2924           and buf_c-chk-doc-attr.chip-num = iChipNum
     2925          :
     2926          if num-entries(buf_c-chk-doc-attr.attr-code, chr(4)) > 1
     2927          then do :
     2928            if entry(1, buf_c-chk-doc-attr.attr-code, chr(4)) begins "gds="
     2929            and entry(2, buf_c-chk-doc-attr.attr-code, chr(4)) = "CSPromo"
     2930            and entry(2, entry(1, buf_c-chk-doc-attr.attr-code, chr(4)), "=") = String(iLineNum)
     2931            and can-do("2,4,5,7", buf_c-chk-doc-attr.attr-value)
     2932            then vIsPromo = yes.
     2933          end.
     2934      end.
     2935      if ChkPromoPrice(iDocCode, iLineNum) then
     2936         vBaseSum = RoundUp(iQnty, iPrice).
     2937      else vBaseSum = iQnty * iPrice.
     2938      return vBaseSum.
     2939   end function.
     2940   function GetSaleRetDisc returns decimal
     2941       (input iDocCode as character,
     2942        input iSaleCode as character):
     2943      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     2944      define buffer buf_chk-gds for ub.chk-gds.
     2945      define variable vQntyPromoRet as decimal no-undo.
     2946      define variable vQntyPromoSel as decimal no-undo.
     2947      define variable vDiscSumRet   as decimal no-undo.
     2948      define variable vDiscSumSale  as decimal no-undo.
     2949      vDiscSumRet = 0.
     2950      cspr:
     2951      for each  buf_chk-gds no-lock where
     2952                buf_chk-gds.doc-code = iDocCode,
     2953          first buf_chk-gds-attr no-lock where
     2954                buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     2955            and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     2956            and buf_chk-gds-attr.attr-code = "CSPromo"
     2957            and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
     2958          :
     2959          vQntyPromoRet = buf_chk-gds.src-qnty.
     2960          leave cspr.
     2961      end.
     2962      if vQntyPromoRet <> 0 then
     2963      for each  buf_chk-gds no-lock where
     2964                buf_chk-gds.doc-code = iSaleCode:
     2965          find first buf_chk-gds-attr no-lock where
     2966                     buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     2967                 and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     2968                 and buf_chk-gds-attr.attr-code = "CSPromo"
     2969          no-error.
     2970          if avail buf_chk-gds-attr
     2971               and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
     2972          then
     2973            vQntyPromoSel = buf_chk-gds.src-qnty.
     2974          find first buf_chk-gds-attr no-lock where
     2975                    buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     2976                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     2977                and buf_chk-gds-attr.attr-code = "CSPromoSum"
     2978          no-error.
     2979          if avail buf_chk-gds-attr then
     2980             vDiscSumSale = dec(buf_chk-gds-attr.attr-value) no-error.
     2981      end.
     2982      if vQntyPromoRet <> 0 and
     2983         vQntyPromoSel = -1 * vQntyPromoRet
     2984      then vDiscSumRet = -1 * vDiscSumSale.
     2985      return vDiscSumRet.
     2986   end function.
     2987   function SetPromoDisc return logical
     2988    (input iDocCode as character,
     2989        input iLineNum as integer
     2990        )
     2991       :
     2992      define buffer buf_chk-doc for ub.chk-doc.
     2993      define buffer buf2_chk-doc for ub.chk-doc.
     2994      define buffer buf_chk-gds for ub.chk-gds.
     2995      define buffer buf2_chk-gds for ub.chk-gds.
     2996      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     2997      define buffer buf2_chk-gds-attr for ub.chk-gds-attr.
     2998      define buffer buf_chk-discnt for ub.chk-discnt.
     2999      define buffer buf2_chk-discnt for ub.chk-discnt.
     3000      define buffer buf_chk-discnt-attr for ub.chk-discnt-attr.
     3001      define buffer buf2_chk-discnt-attr for ub.chk-discnt-attr.
     3002      define variable v-promo-sum as decimal no-undo.
     3003      define variable v-disc-promo-id as character no-undo.
     3004      define variable var-discnt-id as integer no-undo.
     3005      define variable v-chk-sale as character no-undo.
     3006      find first buf_chk-gds-attr no-lock where
     3007                 buf_chk-gds-attr.doc-code = iDocCode
     3008             and buf_chk-gds-attr.line-num  = iLineNum
     3009             and buf_chk-gds-attr.attr-code = "CSPromo"
     3010         no-error.
     3011      if avail buf_chk-gds-attr
     3012        then do:
     3013        find first buf_chk-discnt no-lock where
     3014                   buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     3015               and buf_chk-discnt.line-num = buf_chk-gds-attr.line-num
     3016               and buf_chk-discnt.record-type = 0
     3017               and buf_chk-discnt.promo-id > ""
     3018               no-error.
     3019        if not avail buf_chk-discnt then do:
     3020           find first buf_chk-doc no-lock where
     3021                      buf_chk-doc.doc-code = iDocCode
     3022              no-error.
     3023           find first buf_chk-gds no-lock where
     3024                      buf_chk-gds.doc-code = iDocCode
     3025                 and  buf_chk-gds.line-num = iLineNum
     3026              no-error.
     3027          for first buf2_chk-doc no-lock where
     3028                    buf2_chk-doc.obj-code = buf_chk-doc.obj-code
     3029                and buf2_chk-doc.obj-type = buf_chk-doc.obj-type
     3030                and buf2_chk-doc.pay-desk = buf_chk-doc.pay-desk
     3031                and buf2_chk-doc.chk-type = int('1':U)
     3032                and buf2_chk-doc.chk-num  = int(entry(1,buf_chk-doc.doc-num2,":"))
     3033                and buf2_chk-doc.z-number = int(entry(2, buf_chk-doc.doc-num2,":"))
     3034              :
     3035              find first buf2_chk-gds no-lock where
     3036                         buf2_chk-gds.doc-code = buf2_chk-doc.doc-code
     3037                    and  buf2_chk-gds.b-code   = buf_chk-gds.b-code
     3038              no-error.
     3039              if not avail buf2_chk-gds then return no.
     3040              v-chk-sale = buf2_chk-doc.doc-code.
     3041              find first buf_chk-discnt no-lock where
     3042                         buf_chk-discnt.doc-code =  buf2_chk-doc.doc-code and
     3043                         buf_chk-discnt.record-type = 1 and
     3044                         buf_chk-discnt.object-line-num = buf2_chk-gds.line-num and
     3045                         buf_chk-discnt.promo-id > ""
     3046              no-error .
     3047              if avail buf_chk-discnt
     3048              then do:
     3049                 v-disc-promo-id = buf_chk-discnt.promo-id.
     3050                 find first buf2_chk-discnt no-lock where
     3051                   buf2_chk-discnt.doc-code = iDocCode and
     3052                   buf2_chk-discnt.record-type = 5 and
     3053                   buf2_chk-discnt.line-num = 0 and
     3054                   buf2_chk-discnt.promo-id =  v-disc-promo-id
     3055                 no-error.
     3056                 find first buf2_chk-discnt-attr no-lock where
     3057                            buf2_chk-discnt-attr.doc-code = iDocCode and
     3058                            buf2_chk-discnt-attr.record-type = 5 and
     3059                            buf2_chk-discnt-attr.line-num = 0 and
     3060                            buf2_chk-discnt-attr.attr-code = "promo-id" and
     3061                            buf2_chk-discnt-attr.attr-value = v-disc-promo-id
     3062                       no-error .
     3063                 if not avail buf2_chk-discnt
     3064                 then do:
     3065                     for each buf_chk-discnt no-lock where
     3066                              buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     3067                          and buf_chk-discnt.record-type = 5:
     3068                          var-discnt-id  = var-discnt-id + 1.
     3069                     end.
     3070                     create buf2_chk-discnt.
     3071                     assign
     3072                       buf2_chk-discnt.doc-code = iDocCode
     3073                       buf2_chk-discnt.record-type = 5
     3074                       buf2_chk-discnt.line-num = 0
     3075                       buf2_chk-discnt.promo-id = v-disc-promo-id
     3076                       buf2_chk-discnt.object-sum = 0
     3077                       buf2_chk-discnt.discnt-id = if avail buf2_chk-discnt-attr
     3078                                                      then buf2_chk-discnt-attr.discnt-id
     3079                                                      else (var-discnt-id + 1)
     3080                       var-discnt-id = 0
     3081                       buf2_chk-discnt.object-line-num = 0
     3082                       buf2_chk-discnt.pay-desk = buf_chk-doc.pay-desk
     3083                       buf2_chk-discnt.obj-code = buf_chk-doc.obj-code
     3084                       buf2_chk-discnt.obj-type = buf_chk-doc.obj-type
     3085                       buf2_chk-discnt.chk-date = buf_chk-doc.chk-date
     3086                       buf2_chk-discnt.shift-date = buf_chk-doc.shift-date
     3087                       buf2_chk-discnt.shift-num = buf_chk-doc.shift-num
     3088                       buf2_chk-discnt.chk-time = buf_chk-doc.chk-time
     3089                       .
     3090                 end.
     3091                 if avail buf2_chk-discnt and
     3092                    not avail buf2_chk-discnt-attr
     3093                 then do:
     3094                    create buf2_chk-discnt-attr.
     3095                    assign
     3096                       buf2_chk-discnt-attr.doc-code = iDocCode
     3097                       buf2_chk-discnt-attr.discnt-id = buf2_chk-discnt.discnt-id
     3098                       buf2_chk-discnt-attr.record-type     = 5
     3099                       buf2_chk-discnt-attr.line-num        = 0
     3100                       buf2_chk-discnt-attr.object-line-num = 0
     3101                       buf2_chk-discnt-attr.attr-code       = "promo-id"
     3102                       buf2_chk-discnt-attr.attr-value      = v-disc-promo-id
     3103                       .
     3104                 end.
     3105              end.
     3106          end.
     3107           v-promo-sum = 0.
     3108           if can-do("1,6,7", buf_chk-gds-attr.attr-value)
     3109           then do:
     3110              if v-chk-sale <> ? and v-chk-sale <> "" then
     3111                 v-promo-sum = GetSaleRetDisc(iDocCode,v-chk-sale).
     3112              v-promo-sum = if v-promo-sum = 0 then GetPromoSum(iDocCode) else v-promo-sum.
     3113              if v-promo-sum <> 0 then do:
     3114                  find first buf2_chk-gds-attr no-lock where
     3115                             buf2_chk-gds-attr.doc-code = iDocCode
     3116                         and buf2_chk-gds-attr.line-num  = iLineNum
     3117                         and buf2_chk-gds-attr.attr-code = "CSPromoSum"
     3118                     no-error.
     3119                  if not avail buf2_chk-gds-attr then do:
     3120                      create buf2_chk-gds-attr.
     3121                      assign
     3122                         buf2_chk-gds-attr.doc-code = iDocCode
     3123                         buf2_chk-gds-attr.line-num  = iLineNum
     3124                         buf2_chk-gds-attr.attr-code = "CSPromoSum"
     3125                         buf2_chk-gds-attr.attr-value = string(Round(v-promo-sum,2))
     3126                         .
     3127                  end.
     3128              end.
     3129           end.
     3130           for each buf_chk-discnt no-lock where
     3131                   buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     3132               and buf_chk-discnt.record-type = 0:
     3133              var-discnt-id  = var-discnt-id + 1.
     3134           end.
     3135           create buf_chk-discnt.
     3136           assign
     3137               buf_chk-discnt.doc-code = iDocCode
     3138               buf_chk-discnt.line-num = iLineNum
     3139               buf_chk-discnt.record-type = 0
     3140               buf_chk-discnt.discnt-id = (var-discnt-id + 1)
     3141               buf_chk-discnt.time-oper = buf_chk-gds.time-oper
     3142               buf_chk-discnt.line-type = integer('1':U)
     3143               buf_chk-discnt.line-sign = no
     3144               buf_chk-discnt.pass-discnt = integer('0':U)
     3145               buf_chk-discnt.value-type = integer('2':U)
     3146               buf_chk-discnt.src-d-card = buf_chk-gds.src-d-card
     3147               buf_chk-discnt.d-card = buf_chk-gds.d-card
     3148               buf_chk-discnt.discnt-value-abs = 0
     3149               buf_chk-discnt.discnt-value-pcnt = 0
     3150               buf_chk-discnt.object-line-num = iLineNum
     3151               buf_chk-discnt.pay-desk = buf_chk-doc.pay-desk
     3152               buf_chk-discnt.obj-code = buf_chk-doc.obj-code
     3153               buf_chk-discnt.obj-type = buf_chk-doc.obj-type
     3154               buf_chk-discnt.chk-date = buf_chk-doc.chk-date
     3155               buf_chk-discnt.chk-time = buf_chk-doc.chk-time
     3156               buf_chk-discnt.shift-date = buf_chk-doc.shift-date
     3157               buf_chk-discnt.shift-num = buf_chk-doc.shift-num
     3158               buf_chk-discnt.object-qnty = buf_chk-gds.src-qnty
     3159               buf_chk-discnt.object-sum = buf_chk-gds.src-sum
     3160               var-discnt-id = var-discnt-id + 1
     3161               buf_chk-discnt.promo-id = v-disc-promo-id
     3162               buf_chk-discnt.discnt-type = integer('7':U)
     3163               .
     3164           find first buf_chk-discnt-attr no-lock where
     3165                      buf_chk-discnt-attr.attr-code = "promo-id"
     3166                  and buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
     3167                  and buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
     3168                  and buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
     3169                  no-error.
     3170           if not avail buf_chk-discnt-attr then
     3171           do:
     3172               create buf_chk-discnt-attr .
     3173               assign
     3174                   buf_chk-discnt-attr.attr-code = "promo-id"
     3175                   buf_chk-discnt-attr.attr-value = buf_chk-discnt.promo-id
     3176                   buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
     3177                   buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
     3178                   buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
     3179                   buf_chk-discnt-attr.object-line-num = buf_chk-discnt.object-line-num
     3180                   buf_chk-discnt-attr.record-type = buf_chk-discnt.record-type
     3181                   .
     3182            end.
     3183        end.
     3184      end.
     3185      return yes.
     3186   end function.
     3187   function GetPromoPriceSum returns decimal
     3188       (input iDocCode as character)
     3189       :
     3190       define buffer buf_chk-gds for ub.chk-gds.
     3191       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     3192       define variable vPromoSum as decimal no-undo.
     3193       vPromoSum = 0.
     3194       cspr:
     3195       for each buf_chk-gds no-lock where
     3196                    buf_chk-gds.doc-code = iDocCode,
     3197              first buf_chk-gds-attr no-lock where
     3198                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     3199                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     3200                and buf_chk-gds-attr.attr-code = "CSPromo"
     3201                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value):
     3202          vPromoSum = RoundUp(buf_chk-gds.src-qnty, buf_chk-gds.src-price).
     3203          leave cspr.
     3204       end.
     3205       return vPromoSum.
     3206   end.
     3207   function GetPromoPriceLine returns integer
     3208       (input iDocCode as character)
     3209       :
     3210       define buffer buf_chk-gds for ub.chk-gds.
     3211       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     3212       define variable vPromoLine as integer no-undo.
     3213       vPromoLine = 0.
     3214       cspr:
     3215       for each buf_chk-gds no-lock where
     3216                    buf_chk-gds.doc-code = iDocCode,
     3217              first buf_chk-gds-attr no-lock where
     3218                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     3219                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     3220                and buf_chk-gds-attr.attr-code = "CSPromo"
     3221                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value):
     3222          vPromoLine = buf_chk-gds-attr.line-num.
     3223          leave cspr.
     3224       end.
     3225       return vPromoLine.
     3226   end.
     3227   procedure r-pychk0:
     3228   define input parameter v-base-code as integer no-undo .
     3229   define input parameter p-doc-code as character no-undo .
     3230   _chk-doc:
     3231   for first ub.chk-doc no-lock where
     3232             ub.chk-doc.doc-code = p-doc-code,
     3233       each ub.chk-pay NO-LOCK WHERE
     3234           ub.chk-pay.doc-code = ub.chk-doc.doc-code
     3235   BREAK
     3236   BY CHK-pay.DOC-CODE
     3237   BY CHK-pay.LINE-NUM:
     3238   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3239   if first-of(ub.CHK-pay.DOC-CODE) THEN Do:
     3240     pychk_create = not can-find (first buf_chk-gds-pay
     3241                                  where buf_chk-gds-pay.doc-code = ub.chk-doc.doc-code
     3242                                    and buf_chk-gds-pay.algo-num = "1.8") .
     3243     if pychk_create then do:
     3244       for each temp-chk-pay:
     3245         delete temp-chk-pay.
     3246       end.
     3247       for each temp-chk-gds:
     3248         delete temp-chk-gds.
     3249       end.
     3250       for each temp-chk-dp:
     3251         delete temp-chk-dp.
     3252       end.
     3253       assign
     3254       pychk_kk = 0
     3255       pychk_jj = 1
     3256       pychk_jjp = 0
     3257       pychk_jjo = 0
     3258       pychk_pay-sum = ub.chk-doc.netto
     3259       pychk_dop-sumg = 0
     3260       pychk_pays_count = 0
     3261       .
     3262     end .
     3263   end.
     3264   if pychk_create   then do:
     3265   create-block:
     3266   do transaction
     3267   on stop   undo create-block, return error substitute( "&1. stop", vss-workfile )
     3268   on endkey undo create-block, return error substitute( "&1. endkey", vss-workfile )
     3269   on error  undo, throw:
     3270     find first buf2_chk-doc exclusive-lock where
     3271            recid(buf2_chk-doc) = recid(ub.chk-doc).
     3272     if first-of(ub.CHK-pay.DOC-CODE) THEN Do:
     3273       FOR EACH ub.chk-gds No-LOCK WHERE
     3274               ub.chk-gds.doc-code = ub.chk-pay.doc-code
     3275       BY ub.chk-gds.line-num:
     3276         if   ub.chk-gds.write-off-code > 0
     3277           or ub.chk-gds.doc-qnty  eq 0
     3278           or ub.chk-gds.doc-qnty  eq ?
     3279         then NEXT.
     3280         find first buf_bar-code no-lock where
     3281                   buf_bar-code.b-code = ub.chk-gds.b-code no-error.
     3282         if not available buf_bar-code then do:
     3283           undo create-block, return error substitute("Не найден товар для бар-кода &1: чек &2 &3&4 строка &5"
     3284                                                       , ub.chk-gds.b-code
     3285                                                       , ub.chk-gds.doc-code
     3286                                                       , ub.chk-doc.obj-type
     3287                                                       , ub.chk-doc.obj-code
     3288                                                       , ub.chk-gds.line-num).
     3289         end.
     3290         if ub.chk-gds.pump <> 0 then do:
     3291           pychk_rec-type = 1.
     3292           find first temp-ptrl-goods where
     3293                      temp-ptrl-goods.b-code = ub.chk-gds.b-code no-error.
     3294           if not available temp-ptrl-goods then do:
     3295             run gds-attr-value in this-procedure (
     3296                                                    input buf_bar-code.gds-code
     3297                                                   ,input 'ptrl-as-good':U
     3298                                                   ,output pychk_value
     3299                                                   ,output pychk_type) no-error.
     3300             create temp-ptrl-goods.
     3301             assign
     3302             temp-ptrl-goods.gds-code = buf_bar-code.gds-code
     3303             temp-ptrl-goods.b-code = buf_bar-code.b-code
     3304             temp-ptrl-goods.ptrl-good = (not logical(pychk_value))
     3305             no-error.
     3306           end.
     3307           pychk_line-type = if temp-ptrl-goods.ptrl-good then 1 else 0 .
     3308           release temp-ptrl-goods.
     3309         end.
     3310         else do:
     3311           assign
     3312           pychk_rec-type = 0
     3313           pychk_line-type = 0
     3314           .
     3315         end.
     3316         find first temp-chk-gds where
     3317                   temp-chk-gds.doc-code = ub.chk-gds.doc-code
     3318               AND temp-chk-gds.rec-type = pychk_rec-type
     3319               and temp-chk-gds.b-code = ub.chk-gds.b-code
     3320               and temp-chk-gds.line-num = 0
     3321               no-error.
     3322         if not available temp-chk-gds then do:
     3323           find first temp-chk-gds use-index ijj where
     3324                   temp-chk-gds.jj_ = pychk_jj
     3325               and temp-chk-gds.line-num = 0
     3326                   no-error.
     3327           if not available temp-chk-gds then do:
     3328             create temp-chk-gds.
     3329             assign
     3330             temp-chk-gds.jj_ = pychk_jj
     3331             temp-chk-gds.b-code = ub.chk-gds.b-code
     3332             temp-chk-gds.doc-code = ub.chk-gds.doc-code
     3333             temp-chk-gds.line-num = 0
     3334             temp-chk-gds.rec-type = pychk_rec-type
     3335             temp-chk-gds.gds-code = buf_bar-code.gds-code.
     3336             .
     3337           end.
     3338           else do:
     3339             assign
     3340             temp-chk-gds.b-code = ub.chk-gds.b-code
     3341             temp-chk-gds.doc-code = ub.chk-gds.doc-code
     3342             temp-chk-gds.line-num = 0
     3343             temp-chk-gds.rec-type = pychk_rec-type
     3344             temp-chk-gds.sum = 0
     3345             temp-chk-gds.jjp_ = 0
     3346             temp-chk-gds.jjo_ = 0
     3347             temp-chk-gds.line-type = '':U
     3348             temp-chk-gds.num-lines = 0
     3349             temp-chk-gds.doc-qnty = 0
     3350             temp-chk-gds.sum = 0
     3351             temp-chk-gds.flag  = no
     3352             .
     3353           end.
     3354           assign
     3355           temp-chk-gds.line-type = (if pychk_line-type = 1
     3356                                   then 'топ':U
     3357                                   else entry(1, ub.chk-gds.line-type, chr(4))
     3358                                   ) + chr(4) +
     3359                                   (if num-entries(ub.chk-gds.line-type, chr(4)) > 1
     3360                                   then entry(2, ub.chk-gds.line-type, chr(4))
     3361                                   else '')
     3362           temp-chk-gds.line-num = 0
     3363           temp-chk-gds.num-lines = 0
     3364           temp-chk-gds.density   = ub.chk-gds.density
     3365           pychk_jj = pychk_jj + 1
     3366           .
     3367           if pychk_rec-type = 1 then do:
     3368             assign
     3369             temp-chk-gds.jjp_ = pychk_jjp + 1
     3370             pychk_jjp = pychk_jjp + 1
     3371             .
     3372           end.
     3373           else do:
     3374             assign
     3375             temp-chk-gds.jjo_ = pychk_jjo + 1
     3376             pychk_jjo = pychk_jjo + 1
     3377             .
     3378           end.
     3379         end.
     3380         vSumRound = ub.chk-gds.doc-qnty * (ub.chk-gds.price-base - ub.chk-gds.discnt).
     3381         if ChkPromoPrice(ub.chk-gds.doc-code, ub.chk-gds.line-num) then vSumRound = ub.chk-gds.src-sum.
     3382         assign
     3383         temp-chk-gds.doc-qnty = temp-chk-gds.doc-qnty + ub.chk-gds.doc-qnty
     3384         temp-chk-gds.sum = temp-chk-gds.sum + vSumRound
     3385         temp-chk-gds.num-lines = temp-chk-gds.num-lines  + 1
     3386         .
     3387         find first temp-chk-gds use-index ijj where
     3388                 temp-chk-gds.jj_ = 0
     3389             and temp-chk-gds.line-num = ub.chk-gds.line-num
     3390                 no-error.
     3391         if not available temp-chk-gds then do:
     3392           create temp-chk-gds.
     3393           assign
     3394           temp-chk-gds.jj_ = 0
     3395           temp-chk-gds.line-num = ub.chk-gds.line-num
     3396           temp-chk-gds.doc-code = ub.chk-gds.doc-code
     3397           temp-chk-gds.b-code = ub.chk-gds.b-code
     3398           temp-chk-gds.gds-code = buf_bar-code.gds-code
     3399           temp-chk-gds.rec-type = pychk_rec-type
     3400           temp-chk-gds.line-num = ub.chk-gds.line-num
     3401           .
     3402         end.
     3403         else do:
     3404           assign
     3405           temp-chk-gds.doc-qnty = 0
     3406           temp-chk-gds.doc-code = ub.chk-gds.doc-code
     3407           temp-chk-gds.b-code = ub.chk-gds.b-code
     3408           temp-chk-gds.gds-code = buf_bar-code.gds-code
     3409           temp-chk-gds.rec-type = pychk_rec-type
     3410           temp-chk-gds.line-num = ub.chk-gds.line-num
     3411           temp-chk-gds.jjp_ = 0
     3412           temp-chk-gds.jjo_ = 0
     3413           temp-chk-gds.line-type = '':U
     3414                   .
     3415         end.
     3416         assign
     3417         temp-chk-gds.doc-code = ub.chk-gds.doc-code
     3418         temp-chk-gds.b-code = ub.chk-gds.b-code
     3419         temp-chk-gds.doc-qnty = ub.chk-gds.doc-qnty
     3420         temp-chk-gds.price-base = ub.chk-gds.price-base
     3421         temp-chk-gds.price-service = ub.chk-gds.price-service
     3422         temp-chk-gds.line-type = (if pychk_line-type = 1
     3423                                 then 'топ':U
     3424                                 else entry(1, ub.chk-gds.line-type, chr(4))
     3425                                 ) + chr(4) +
     3426                                 (if num-entries(ub.chk-gds.line-type, chr(4)) > 1
     3427                                 then entry(2, ub.chk-gds.line-type, chr(4))
     3428                                 else '')
     3429         temp-chk-gds.line-sign = ub.chk-gds.line-sign
     3430         temp-chk-gds.discnt = ub.chk-gds.discnt
     3431         temp-chk-gds.sum = vSumRound
     3432         temp-chk-gds.rec-type = pychk_rec-type
     3433         temp-chk-gds.line-num = ub.chk-gds.line-num
     3434         temp-chk-gds.num-lines = 1
     3435         temp-chk-gds.density   = ub.chk-gds.density
     3436         .
     3437       END.
     3438       for each chk-discnt no-lock
     3439          where chk-discnt.doc-code = ub.chk-doc.doc-code
     3440            and record-type = 10
     3441            and chk-discnt.discnt-value-abs <> 0,
     3442           first ub.chk-gds of ub.chk-doc where ub.chk-gds.line-num =  chk-discnt.object-line-num :
     3443               if ub.chk-doc.chk-type = 1 and chk-discnt.object-qnty < 0 then do:
     3444                   for first temp-chk-dp where temp-chk-dp.doc-code = ub.chk-doc.doc-code
     3445                   and temp-chk-dp.b-code = chk-gds.b-code:
     3446                       temp-chk-dp.sum = temp-chk-dp.sum - abs(chk-discnt.discnt-value-abs * chk-discnt.object-qnty).
     3447                   end.
     3448               end.
     3449               else do:
     3450                   create temp-chk-dp .
     3451                   assign
     3452                   temp-chk-dp.doc-code = ub.chk-doc.doc-code
     3453                   temp-chk-dp.sum = abs(chk-discnt.discnt-value-abs) * chk-discnt.object-qnty
     3454                   temp-chk-dp.line-num = chk-discnt.object-line-num
     3455                   temp-chk-dp.pay-code = chk-discnt.rank
     3456                   temp-chk-dp.b-code = chk-gds.b-code
     3457                   temp-chk-dp.qnty   = abs(chk-discnt.discnt-value-pcnt)
     3458                   temp-chk-dp.all-sum =  chk-discnt.discnt-value-abs * chk-discnt.discnt-value-pcnt
     3459                   .
     3460               end.
     3461       end.
     3462     end.
     3463     FIND FIRST ub.cash-pay No-LOCK WHERE
     3464               ub.cash-pay.cdpay-code = ub.chk-pay.pay-code AND
     3465               ub.cash-pay.curr-code = ub.chk-pay.curr-code No-ERROR.
     3466     if available ub.cash-pay then do:
     3467       pychk_payline_rrn = "" .
     3468       if not ub.cash-pay.is-cash then do :
     3469         for first buf_chk-pay-attr no-lock
     3470             where buf_chk-pay-attr.doc-code  = ub.CHK-pay.DOC-CODE
     3471               and buf_chk-pay-attr.attr-code = "cpdoc":U
     3472               and buf_chk-pay-attr.line-num  = ub.CHK-pay.line-num :
     3473           pychk_payline_rrn = buf_chk-pay-attr.attr-value .
     3474         end .
     3475       end .
     3476         find first temp-chk-pay where
     3477                 temp-chk-pay.doc-code = ub.chk-pay.doc-code
     3478             and temp-chk-pay.pay-code = ub.chk-pay.pay-code
     3479             and temp-chk-pay.pay-card = ub.chk-pay.pay-card
     3480             and temp-chk-pay.curr-code = ub.chk-pay.curr-code
     3481             and temp-chk-pay.rrn       = pychk_payline_rrn
     3482                    no-error.
     3483       if not available temp-chk-pay then do:
     3484           find first temp-chk-pay where
     3485                   temp-chk-pay.doc-code = ub.chk-pay.doc-code
     3486               and temp-chk-pay.pay-code = ub.chk-pay.pay-code
     3487               and temp-chk-pay.pay-card = ub.chk-pay.pay-card
     3488               and temp-chk-pay.curr-code = ub.chk-pay.curr-code
     3489               and abs(temp-chk-pay.tot-r-b) >= abs(ub.chk-pay.tot-sum)
     3490               and (temp-chk-pay.tot-r-b >=0) NE (ub.chk-pay.tot-sum >=0)
     3491               no-error.
     3492         if not  avail temp-chk-pay then do:
     3493           find first temp-chk-pay where
     3494                     temp-chk-pay.doc-code = ub.chk-pay.doc-code
     3495                 and temp-chk-pay.line-num = ub.chk-pay.line-num use-index pi no-error.
     3496           if not available temp-chk-pay then do:
     3497             create temp-chk-pay.
     3498             assign
     3499             temp-chk-pay.line-num = ub.chk-pay.line-num
     3500             temp-chk-pay.doc-code = ub.chk-doc.doc-code
     3501             temp-chk-pay.pay-code = ub.chk-pay.pay-code
     3502             temp-chk-pay.curr-code =  ub.chk-pay.curr-code
     3503             temp-chk-pay.rrn       = pychk_payline_rrn
     3504             pychk_pays_count = pychk_pays_count + 1
     3505             .
     3506           end.
     3507           assign
     3508           temp-chk-pay.doc-code = ub.chk-doc.doc-code
     3509           temp-chk-pay.pet-good = integer(cash-pay.atr64) * 2 + integer(cash-pay.is-cash) + 2 * int(can-find(first temp-chk-dp no-lock where temp-chk-dp.pay-code = temp-chk-pay.pay-code and temp-chk-dp.doc-code = temp-chk-pay.doc-code ))
     3510           temp-chk-pay.pay-code = ub.chk-pay.pay-code
     3511           temp-chk-pay.curr-code =  ub.chk-pay.curr-code
     3512           temp-chk-pay.is-cash  = ub.cash-pay.is-cash
     3513           temp-chk-pay.register = ub.cash-pay.register
     3514           temp-chk-pay.pay-card = ub.chk-pay.pay-card
     3515           temp-chk-pay.tot-rubl = 0
     3516           temp-chk-pay.tot-base = 0
     3517           temp-chk-pay.num-lines = 0
     3518           temp-chk-pay.flag  = no
     3519           .
     3520         end.
     3521       end.
     3522       assign
     3523       temp-chk-pay.tot-r-b = temp-chk-pay.tot-r-b + (if v-curr-r-b = 'rubl':U
     3524                                                      then ub.chk-pay.tot-rubl
     3525                                                      else ub.chk-pay.tot-base)
     3526       temp-chk-pay.tot-rubl = temp-chk-pay.tot-rubl + ub.chk-pay.tot-rubl
     3527       temp-chk-pay.tot-base = temp-chk-pay.tot-base + ub.chk-pay.tot-base
     3528       temp-chk-pay.num-lines = temp-chk-pay.num-lines  + 1
     3529       .
     3530     end.
     3531     if available temp-chk-pay then RELEASE TEMP-CHK-PAY.
     3532     if last-of(ub.chk-pay.doc-code) then do:
     3533       for each temp-chk-pay where
     3534               temp-chk-pay.doc-code = ub.chk-doc.doc-code:
     3535          if    (temp-chk-pay.tot-r-b  >= 0) NE (ub.chk-doc.netto >= 0)
     3536             and temp-chk-pay.tot-r-b <> 0
     3537             and abs(ub.chk-doc.netto) > 0.00000001
     3538          then do:
     3539             if not g#auto then do:
     3540                message
     3541                   substitute("Не могу обработать чек &1&2&3&4 смена &5 пор.&6 касса &7 № на кассе &8"
     3542                             ,ub.chk-doc.doc-code
     3543                             ,chr(10)
     3544                             ,ub.chk-doc.obj-type
     3545                             ,ub.chk-doc.obj-code
     3546                             ,ub.chk-doc.shift-date
     3547                             ,ub.chk-doc.shift-num
     3548                             ,ub.chk-doc.pay-desk
     3549                             ,ub.chk-doc.chk-num)
     3550                   view-as alert-box error .
     3551             end.
     3552             next _chk-doc.
     3553          end.
     3554       end.
     3555       for each temp-chk-pay where
     3556               temp-chk-pay.doc-code = ub.chk-doc.doc-code
     3557       break
     3558       by temp-chk-pay.pet-good descending
     3559       by temp-chk-pay.line-num:
     3560          dp:
     3561          for each temp-chk-dp no-lock
     3562             where temp-chk-dp.pay-code = temp-chk-pay.pay-code
     3563               and temp-chk-dp.doc-code = temp-chk-pay.doc-code
     3564               and temp-chk-dp.sum <> 0 :
     3565               find first buf_temp-chk-gds2 where
     3566                   buf_temp-chk-gds2.doc-code = ub.chk-doc.doc-code
     3567               and buf_temp-chk-gds2.line-num  =  temp-chk-dp.line-num no-error.
     3568               if available buf_temp-chk-gds2 then
     3569               for each buf_temp-chk-gds where
     3570                   buf_temp-chk-gds.b-code = buf_temp-chk-gds2.b-code
     3571                   and buf_temp-chk-gds.line-num ne 0
     3572               no-lock by buf_temp-chk-gds.line-num  ne  temp-chk-dp.line-num :
     3573                    if         temp-chk-dp.all-sum  eq ?
     3574                       or abs(temp-chk-dp.all-sum) <= 0.001
     3575                   then
     3576                      next dp.
     3577                   find first  temp-chk-gds where
     3578                       temp-chk-gds.doc-code = ub.chk-doc.doc-code
     3579                       and buf_temp-chk-gds.b-code = temp-chk-gds.b-code
     3580                     and temp-chk-gds.line-num = 0
     3581                   no-error .
     3582                   if not available temp-chk-gds then next dp.
     3583                   case num-entries(buf_temp-chk-gds.line-type, chr(4)):
     3584                       when 1 then do:
     3585                         pychk_line-type-chr = temp-chk-gds.line-type + chr(4) + chr(4) + string(temp-chk-pay.num-lines).
     3586                       end.
     3587                       when 2 then do:
     3588                         pychk_line-type-chr = temp-chk-gds.line-type +                chr(4) + string(temp-chk-pay.num-lines).
     3589                       end.
     3590                   end case.
     3591                   pychk_dop-sumk =  if temp-chk-dp.sum >= 0
     3592                   then min(temp-chk-dp.all-sum,temp-chk-dp.sum,buf_temp-chk-gds.sum,temp-chk-pay.tot-r-b)
     3593                   else max(temp-chk-dp.all-sum,temp-chk-dp.sum,buf_temp-chk-gds.sum).
     3594                   if abs(temp-chk-pay.tot-r-b - pychk_dop-sumk) <= 0.001
     3595                   then
     3596                      pychk_dop-sumk = temp-chk-pay.tot-r-b.
     3597                   temp-chk-dp.all-sum           = temp-chk-dp.all-sum - pychk_dop-sumk.
     3598                   if can-find (first buf_chk-gds-pay no-lock where
     3599                                      buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     3600                                  and buf_chk-gds-pay.algo-num = "1.8"
     3601                                  and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     3602                                  and buf_chk-gds-pay.cpline-num = int(temp-chk-pay.line-num)
     3603                                      )
     3604                   then undo create-block, return error substitute("Уже есть платеж: чек &1 &2&3 строка &4 строка &5"
     3605                                                       , temp-chk-pay.doc-code
     3606                                                       , ub.chk-doc.obj-type
     3607                                                       , ub.chk-doc.obj-code
     3608                                                       , buf_temp-chk-gds.line-num
     3609                                                       , temp-chk-pay.line-num).
     3610                   create buf_chk-gds-pay.
     3611                     assign
     3612                     buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     3613                     buf_chk-gds-pay.chk-type = ub.chk-doc.chk-type
     3614                     buf_chk-gds-pay.algo-num = "1.8"
     3615                     buf_chk-gds-pay.pay-code = temp-chk-pay.pay-code
     3616                     buf_chk-gds-pay.curr-code = temp-chk-pay.curr-code
     3617                     buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     3618                     buf_chk-gds-pay.cpline-num = int(temp-chk-pay.line-num)
     3619                     buf_chk-gds-pay.pay-card = temp-chk-pay.pay-card
     3620                     buf_chk-gds-pay.tot-r-b =  pychk_dop-sumk
     3621                     buf_chk-gds-pay.eff-base-rate = 1
     3622                     buf_chk-gds-pay.eff-doc-qnty = (if (temp-chk-gds.num-lines = 1
     3623                                                     and abs(pychk_dop-sumk) <= abs(temp-chk-gds.sum)
     3624                                                     and pychk_pays_count = 1)
     3625                                                     or (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt) = 0
     3626                                                     then temp-chk-gds.doc-qnty
     3627                                                     else (buf_chk-gds-pay.tot-r-b / (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt))
     3628                                                     )
     3629                     buf_chk-gds-pay.b-code = buf_temp-chk-gds.b-code
     3630                     buf_chk-gds-pay.discnt = buf_temp-chk-gds.discnt
     3631                     buf_chk-gds-pay.price-base = buf_temp-chk-gds.price-base
     3632                     buf_chk-gds-pay.price-service = buf_temp-chk-gds.price-service
     3633                     buf_chk-gds-pay.line-sign = buf_temp-chk-gds.line-sign
     3634                     buf_chk-gds-pay.gds-code = buf_temp-chk-gds.gds-code
     3635                     buf_chk-gds-pay.line-type = pychk_line-type-chr
     3636                     buf_chk-gds-pay.rec-type = buf_temp-chk-gds.rec-type
     3637                     buf_chk-gds-pay.density  = buf_temp-chk-gds.density
     3638                     buf_chk-gds-pay.chk-date = ub.chk-doc.chk-date
     3639                     buf_chk-gds-pay.chk-time = ub.chk-doc.chk-time
     3640                     buf_chk-gds-pay.obj-type = ub.chk-doc.obj-type
     3641                     buf_chk-gds-pay.obj-code = ub.chk-doc.obj-code
     3642                     buf_chk-gds-pay.out-code = ub.chk-doc.out-code
     3643                     buf_chk-gds-pay.shift-date = ub.chk-doc.shift-date
     3644                     buf_chk-gds-pay.shift-num = ub.chk-doc.shift-num
     3645                     buf_chk-gds-pay.shift-name= ub.chk-doc.shift-name
     3646                     .
     3647                   assign
     3648                   buf_temp-chk-gds.sum = buf_temp-chk-gds.sum - buf_chk-gds-pay.tot-r-b
     3649                   temp-chk-gds.sum =  temp-chk-gds.sum - buf_chk-gds-pay.tot-r-b
     3650                   buf_temp-chk-gds.doc-qnty = buf_temp-chk-gds.doc-qnty - buf_chk-gds-pay.eff-doc-qnty
     3651                   temp-chk-pay.tot-r-b = temp-chk-pay.tot-r-b - buf_chk-gds-pay.tot-r-b
     3652                   pychk_dop-sumk = pychk_dop-sumk - buf_chk-gds-pay.tot-r-b
     3653                   .
     3654                    if (ub.chk-doc.chk-type = 1 and temp-chk-pay.tot-r-b <= 0) or (ub.chk-doc.chk-type <> 1 and temp-chk-pay.tot-r-b >= 0) then leave dp.
     3655               end.
     3656           end.
     3657         assign
     3658         pychk_dop-sump = temp-chk-pay.tot-r-b
     3659         pychk_exch = if pychk_No-exch then 1
     3660                      else (if temp-chk-pay.tot-base = 0
     3661                            then 0
     3662                            else temp-chk-pay.tot-rubl / temp-chk-pay.tot-base)
     3663         pychk_exch-rubl = if pychk_No-exch-rubl
     3664                           then 1
     3665                           else (if temp-chk-pay.tot-base = 0
     3666                                 then 0
     3667                                 else temp-chk-pay.tot-rubl / temp-chk-pay.tot-base)
     3668         temp-chk-pay.flag = (if abs(temp-chk-pay.tot-rubl) < 0.001 then no else yes)
     3669         .
     3670         _repeat:
     3671         REPEAT WHILE  abs(pychk_dop-sump) > 0 :
     3672           if pychk_dop-sumg = 0 then do:
     3673             assign
     3674             pychk_kk = pychk_kk + 1
     3675             .
     3676             if pychk_kk >= pychk_jj then LEAVE _repeat.
     3677             if pychk_kk <= pychk_jjp then do:
     3678               find first temp-chk-gds where
     3679                       temp-chk-gds.doc-code = ub.chk-doc.doc-code
     3680                     and temp-chk-gds.jjp_ = pychk_kk
     3681                     and temp-chk-gds.line-num = 0
     3682                   no-error .
     3683             end.
     3684             else do:
     3685               find first temp-chk-gds where
     3686                       temp-chk-gds.doc-code = ub.chk-doc.doc-code
     3687                     and temp-chk-gds.jjo_ = pychk_kk - pychk_jjp
     3688                     and temp-chk-gds.line-num = 0
     3689                   no-error .
     3690             end.
     3691             if not available temp-chk-gds
     3692             or (temp-chk-gds.sum = 0
     3693                 or
     3694                 (temp-chk-gds.sum <= 0  and ub.chk-doc.netto > 0)
     3695                 )
     3696             then do:
     3697               NEXT _repeat.
     3698             end.
     3699             assign
     3700             pychk_dop-sumg = if available temp-chk-gds then temp-chk-gds.sum else 0
     3701             temp-chk-gds.flag = yes
     3702             .
     3703           end.
     3704           assign
     3705           pychk_dop-sumk = min(abs(pychk_dop-sumg), abs(pychk_dop-sump))  * (if pychk_dop-sump > 0 then 1 else -1 ) * (if pychk_dop-sumg < 0 AND ub.chk-doc.chk-type = 1 then -1 else 1 )
     3706           pychk_pay-sum = pychk_pay-sum - pychk_dop-sumk
     3707           pychk_dop-sump = pychk_dop-sump - pychk_dop-sumk
     3708           pychk_dop-sumg = pychk_dop-sumg - pychk_dop-sumk
     3709           pychk_sum-promo = GetPromoPriceSum(ub.chk-doc.doc-code)
     3710           .
     3711           if pychk_sum-promo <> 0 then
     3712              vPromoLineNum = GetPromoPriceLine(ub.chk-doc.doc-code).
     3713           else vPromoLineNum = 0.
     3714           for each buf_temp-chk-gds where
     3715                   buf_temp-chk-gds.doc-code = ub.chk-doc.doc-code
     3716               and buf_temp-chk-gds.b-code = temp-chk-gds.b-code
     3717               and buf_temp-chk-gds.line-num  > 0
     3718           by buf_temp-chk-gds.doc-code
     3719           by buf_temp-chk-gds.rec-type descending
     3720           by buf_temp-chk-gds.line-num
     3721            :
     3722             case num-entries(buf_temp-chk-gds.line-type, chr(4)):
     3723               when 1 then do:
     3724                 pychk_line-type-chr = buf_temp-chk-gds.line-type + chr(4) + chr(4) + string(temp-chk-pay.num-lines).
     3725               end.
     3726               when 2 then do:
     3727                 pychk_line-type-chr = buf_temp-chk-gds.line-type +                chr(4) + string(temp-chk-pay.num-lines).
     3728               end.
     3729             end case.
     3730             if  vPromoLineNum <> 0 and
     3731                 temp-chk-gds.num-lines > 1 and
     3732                 buf_temp-chk-gds.line-num = vPromoLineNum and
     3733                 can-find(first buf_chk-gds-pay no-lock where
     3734                                buf_chk-gds-pay.doc-code = buf_temp-chk-gds.doc-code
     3735                            and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num)
     3736             then .
     3737             else
     3738             if not (buf_temp-chk-gds.sum = 0 and can-find (first temp-chk-dp no-lock where temp-chk-dp.pay-code = temp-chk-pay.pay-code and temp-chk-dp.doc-code = temp-chk-pay.doc-code and buf_temp-chk-gds.line-num  =  temp-chk-dp.line-num)) then do:
     3739                 if vPromoLineNum <> 0 and
     3740                    buf_temp-chk-gds.line-num = vPromoLineNum
     3741                 then do:
     3742                    vSum = RoundUp(buf_temp-chk-gds.doc-qnty, buf_temp-chk-gds.price-base).
     3743                 end.
     3744                 else if vPromoLineNum <> 0 and
     3745                         temp-chk-gds.num-lines > 1 and
     3746                         pychk_sum-promo <> 0 and
     3747                         ChkPromoLine(buf_temp-chk-gds.doc-code, buf_temp-chk-gds.line-num)
     3748                 then do:
     3749                     if can-find(first buf_chk-gds-pay no-lock where
     3750                                       buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     3751                                   and buf_chk-gds-pay.line-num = vPromoLineNum
     3752                                   )
     3753                      then vSum = (pychk_dop-sumk * buf_temp-chk-gds.sum / (temp-chk-gds.sum - pychk_sum-promo)).
     3754                      else vSum = ((pychk_dop-sumk - pychk_sum-promo) * buf_temp-chk-gds.sum / (temp-chk-gds.sum - pychk_sum-promo)).
     3755                 end.
     3756                 else
     3757                 vSum                     = (if    temp-chk-gds.num-lines = 1
     3758                                               and abs(pychk_dop-sumk) <= abs(temp-chk-gds.sum)
     3759                                             then pychk_dop-sumk
     3760                                             else (pychk_dop-sumk * buf_temp-chk-gds.sum / temp-chk-gds.sum)
     3761                                            )
     3762                 .
     3763                 if can-find (first temp-chk-dp no-lock where temp-chk-dp.pay-code = temp-chk-pay.pay-code and temp-chk-dp.doc-code = temp-chk-pay.doc-code) then do:
     3764                     find first buf_chk-gds-pay where buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     3765                     and buf_chk-gds-pay.algo-num = "1.8"
     3766                     and buf_chk-gds-pay.pay-code = temp-chk-pay.pay-code
     3767                     and buf_chk-gds-pay.curr-code = temp-chk-pay.curr-code
     3768                     and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     3769                     and buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num
     3770                     and buf_chk-gds-pay.pay-card = temp-chk-pay.pay-card exclusive-lock no-error.
     3771                     if not available buf_chk-gds-pay then do:
     3772                        if can-find (first buf_chk-gds-pay no-lock where
     3773                                      buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     3774                                  and buf_chk-gds-pay.algo-num = "1.8"
     3775                                  and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     3776                                  and buf_chk-gds-pay.cpline-num = int(temp-chk-pay.line-num)
     3777                                      )
     3778                        then undo create-block, return error substitute("Уже есть платеж: чек &1 &2&3 строка &4 строка &5"
     3779                                                       , temp-chk-pay.doc-code
     3780                                                       , ub.chk-doc.obj-type
     3781                                                       , ub.chk-doc.obj-code
     3782                                                       , buf_temp-chk-gds.line-num
     3783                                                       , temp-chk-pay.line-num).
     3784                        create buf_chk-gds-pay.
     3785                     end.
     3786                 end.
     3787                 else do:
     3788                      if can-find (first buf_chk-gds-pay no-lock where
     3789                                      buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     3790                                  and buf_chk-gds-pay.algo-num = "1.8"
     3791                                  and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     3792                                  and buf_chk-gds-pay.cpline-num = int(temp-chk-pay.line-num)
     3793                                      )
     3794                      then undo create-block, return error substitute("Уже есть платеж: чек &1 &2&3 строка &4 строка &5"
     3795                                                       , temp-chk-pay.doc-code
     3796                                                       , ub.chk-doc.obj-type
     3797                                                       , ub.chk-doc.obj-code
     3798                                                       , buf_temp-chk-gds.line-num
     3799                                                       , temp-chk-pay.line-num).
     3800                      create buf_chk-gds-pay.
     3801                 end.
     3802                 assign
     3803                 buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     3804                 buf_chk-gds-pay.chk-type = ub.chk-doc.chk-type
     3805                 buf_chk-gds-pay.algo-num = "1.8"
     3806                 buf_chk-gds-pay.pay-code = temp-chk-pay.pay-code
     3807                 buf_chk-gds-pay.curr-code = temp-chk-pay.curr-code
     3808                 buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     3809                 buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num
     3810                 buf_chk-gds-pay.pay-card = temp-chk-pay.pay-card
     3811                 buf_chk-gds-pay.tot-r-b = buf_chk-gds-pay.tot-r-b  + vSum
     3812                 buf_chk-gds-pay.eff-base-rate = pychk_exch
     3813                 buf_chk-gds-pay.b-code = buf_temp-chk-gds.b-code
     3814                 buf_chk-gds-pay.gds-code = buf_temp-chk-gds.gds-code
     3815                 buf_chk-gds-pay.discnt = buf_temp-chk-gds.discnt
     3816                 buf_chk-gds-pay.price-base = buf_temp-chk-gds.price-base
     3817                 buf_chk-gds-pay.price-service = buf_temp-chk-gds.price-service
     3818                 buf_chk-gds-pay.line-sign = buf_temp-chk-gds.line-sign
     3819                 buf_chk-gds-pay.line-type = pychk_line-type-chr
     3820                 buf_chk-gds-pay.rec-type = buf_temp-chk-gds.rec-type
     3821                 buf_chk-gds-pay.density  = buf_temp-chk-gds.density
     3822                 buf_chk-gds-pay.chk-date = ub.chk-doc.chk-date
     3823                 buf_chk-gds-pay.chk-time = ub.chk-doc.chk-time
     3824                 buf_chk-gds-pay.obj-type = ub.chk-doc.obj-type
     3825                 buf_chk-gds-pay.obj-code = ub.chk-doc.obj-code
     3826                 buf_chk-gds-pay.out-code = ub.chk-doc.out-code
     3827                 buf_chk-gds-pay.shift-date = ub.chk-doc.shift-date
     3828                 buf_chk-gds-pay.shift-num = ub.chk-doc.shift-num
     3829                 buf_chk-gds-pay.shift-name= ub.chk-doc.shift-name
     3830                 buf_temp-chk-gds.flag = yes
     3831                 .
     3832                 if buf_temp-chk-gds.line-num = vPromoLineNum
     3833                 then do:
     3834                    buf_chk-gds-pay.eff-doc-qnty = buf_temp-chk-gds.doc-qnty.
     3835                 end.
     3836                 else
     3837                 buf_chk-gds-pay.eff-doc-qnty = (if buf_chk-gds-pay.eff-doc-qnty = ? then 0 else buf_chk-gds-pay.eff-doc-qnty) + (if (temp-chk-gds.num-lines = 1
     3838                                                 and abs(pychk_dop-sumk) <= abs(temp-chk-gds.sum)
     3839                                                 and pychk_pays_count = 1)
     3840                                                 or (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt) = 0
     3841                                                 then temp-chk-gds.doc-qnty
     3842                                                 else (vSum / (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt))
     3843                                                 )
     3844                 .
     3845               end.
     3846           end.
     3847         end.
     3848       end.
     3849       if available temp-chk-gds then release temp-chk-gds.
     3850       if available temp-chk-pay then release temp-chk-pay.
     3851       pychk_zero-gds = 0.
     3852       pychk_zero-pay = 0.
     3853       for each temp-chk-gds where
     3854               temp-chk-gds.doc-code = ub.chk-pay.doc-code
     3855           and temp-chk-gds.flag = no
     3856           and temp-chk-gds.line-num  > 0
     3857           :
     3858          pychk_zero-gds = pychk_zero-gds + 1.
     3859       end.
     3860       for each temp-chk-pay where
     3861               temp-chk-pay.doc-code = ub.chk-pay.doc-code
     3862           and temp-chk-pay.flag = no:
     3863          pychk_zero-pay = pychk_zero-pay + 1.
     3864       end.
     3865       find first temp-chk-pay where temp-chk-pay.doc-code = ub.chk-pay.doc-code
     3866                                 and temp-chk-pay.flag = no
     3867       no-lock no-error.
     3868       if not available temp-chk-pay
     3869       then do:
     3870          block-pay:
     3871          for each temp-chk-pay where temp-chk-pay.doc-code = ub.chk-pay.doc-code:
     3872             assign
     3873                pychk_zero-pay = pychk_zero-pay +  1
     3874                temp-chk-pay.flag = no
     3875             .
     3876             leave block-pay.
     3877          end.
     3878       end.
     3879       for each temp-chk-pay
     3880       where   temp-chk-pay.doc-code = ub.chk-pay.doc-code
     3881           and temp-chk-pay.flag = no:
     3882         pychk_zero-n = 0.
     3883         for each buf_temp-chk-gds
     3884         where   buf_temp-chk-gds.doc-code = ub.chk-pay.doc-code
     3885             and buf_temp-chk-gds.flag = no
     3886             and buf_temp-chk-gds.line-num  > 0 :
     3887           pychk_zero-n = pychk_zero-n + 1.
     3888           if  temp-chk-pay.tot-r-b = 0 and buf_temp-chk-gds.discnt = 0 and abs(buf_temp-chk-gds.sum) > 0 then next.
     3889           case num-entries(buf_temp-chk-gds.line-type, chr(4)):
     3890             when 1 then do:
     3891               pychk_line-type-chr = buf_temp-chk-gds.line-type + chr(4) + chr(4) + string(temp-chk-pay.num-lines).
     3892             end.
     3893             when 2 then do:
     3894               pychk_line-type-chr = buf_temp-chk-gds.line-type +                chr(4) + string(temp-chk-pay.num-lines).
     3895             end.
     3896           end case.
     3897           if can-find(first buf_chk-gds-pay no-lock where
     3898                             buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     3899                         and buf_chk-gds-pay.algo-num = "1.8"
     3900                         and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     3901                         and buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num)
     3902           then do:
     3903               buf_temp-chk-gds.flag = yes.
     3904           end.
     3905           else do:
     3906               create buf_chk-gds-pay.
     3907               assign
     3908               buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     3909               buf_chk-gds-pay.algo-num = "1.8"
     3910               buf_chk-gds-pay.pay-code = temp-chk-pay.pay-code
     3911               buf_chk-gds-pay.curr-code = temp-chk-pay.curr-code
     3912               buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     3913               buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num
     3914               buf_chk-gds-pay.pay-card = temp-chk-pay.pay-card
     3915               buf_chk-gds-pay.tot-r-b = 0
     3916               buf_chk-gds-pay.eff-base-rate = pychk_exch
     3917               buf_chk-gds-pay.eff-doc-qnty = buf_temp-chk-gds.doc-qnty
     3918               buf_chk-gds-pay.b-code = buf_temp-chk-gds.b-code
     3919               buf_chk-gds-pay.gds-code = buf_temp-chk-gds.gds-code
     3920               buf_chk-gds-pay.discnt = buf_temp-chk-gds.discnt
     3921               buf_chk-gds-pay.price-base = (if temp-chk-pay.tot-r-b = 0 and buf_temp-chk-gds.discnt = 0 then 0 else buf_temp-chk-gds.price-base)
     3922               buf_chk-gds-pay.price-service = buf_temp-chk-gds.price-service
     3923               buf_chk-gds-pay.line-sign = buf_temp-chk-gds.line-sign
     3924               buf_chk-gds-pay.line-type = pychk_line-type-chr
     3925               buf_chk-gds-pay.rec-type = buf_temp-chk-gds.rec-type
     3926               buf_chk-gds-pay.density  = buf_temp-chk-gds.density
     3927               buf_chk-gds-pay.chk-date = ub.chk-doc.chk-date
     3928               buf_chk-gds-pay.chk-time = ub.chk-doc.chk-time
     3929               buf_chk-gds-pay.obj-type = ub.chk-doc.obj-type
     3930               buf_chk-gds-pay.obj-code = ub.chk-doc.obj-code
     3931               buf_chk-gds-pay.out-code = ub.chk-doc.out-code
     3932               buf_chk-gds-pay.shift-date = ub.chk-doc.shift-date
     3933               buf_chk-gds-pay.shift-num = ub.chk-doc.shift-num
     3934               buf_chk-gds-pay.shift-name= ub.chk-doc.shift-name
     3935               buf_temp-chk-gds.flag = yes
     3936               .
     3937           end.
     3938           if pychk_zero-n > pychk_zero-gds / pychk_zero-pay then leave.
     3939         end.
     3940         temp-chk-pay.flag = yes.
     3941       end.
     3942     end.
     3943   end.
     3944   end.
     3945   end.
     3946   end.
     3947   procedure proc-main :
     3948   define input parameter p-status_ like ub.trn-doc.status_ no-undo .
     3949   define variable road as logical no-undo.
     3950   define variable for-price as decimal no-undo.
     3951   define variable for-excise as decimal no-undo.
     3952   define variable for-road as decimal no-undo.
     3953   define variable bottle as logical no-undo.
     3954   define variable accum-chk-doc-tot-doc as decimal no-undo.
     3955   define variable accum-chk-doc-discnt as decimal no-undo.
     3956   define variable accum-chk-doc-netto as decimal no-undo.
     3957   define variable accum-chk-doc-sub-discnt as decimal no-undo.
     3958   define variable accum-chk-pay-tot-sum-by as decimal no-undo.
     3959   define variable accum-chk-pay-tot-base-by as decimal no-undo.
     3960   define variable accum-chk-pay-tot-rubl-by as decimal no-undo.
     3961   define variable KIND-TO-RESERV as character no-undo .
     3962   define variable KIND-TO-RESERV-GDS as character no-undo .
     3963   define variable cli-type-to-reserv as character no-undo.
     3964   define variable cli-code-to-reserv as integer no-undo.
     3965   define variable v-real-doc-kind as character no-undo .
     3966   define variable office-TO-RESERV as character no-undo .
     3967   define variable office-TO-RESERV-GDS as character no-undo .
     3968   define variable docs-to-reserv as integer no-undo .
     3969   define variable docs-to-reserv-gds as integer no-undo .
     3970   define variable v-add as logical no-undo .
     3971   define variable dtrg as integer no-undo .
     3972   define variable dtrg-start as logical no-undo .
     3973   define variable cashparts as logical no-undo.
     3974   define variable cashparts-chk as logical no-undo.
     3975   define variable serparts as logical no-undo.
     3976   define variable plcode like ub.place.pl-code no-undo.
     3977   define variable cashfbrs as logical no-undo .
     3978   define variable v-is-dish as character no-undo .
     3979   define variable v-deleted as logical no-undo .
     3980   define variable varchip-code as integer no-undo .
     3981   define variable varchip-code2 as integer no-undo .
     3982   define variable v-mes as character no-undo .
     3983   define variable v-clcdoc-vat-pc                     like ub.doc-line.vat-pc           no-undo.
     3984   define variable v-clcdoc-slt-pc                     like ub.doc-line.slt-pc           no-undo.
     3985   define variable glog as logical no-undo .
     3986   define variable action as character no-undo .
     3987   define variable other-doc-code as character no-undo .
     3988   define variable v-is-tpsi-obj as logical no-undo .
     3989   define variable v-tpsi-mode as integer no-undo .
     3990   define variable v-main-tpsi as logical no-undo .
     3991   DEFINE VARIABLE var-doc-type like ub.inkas-pay-desk.doc-type no-undo .
     3992   define variable v-rc-ii as integer no-undo initial 1.
     3993   define variable v-rc-max as integer no-undo .
     3994   define variable v-first as logical no-undo init yes .
     3995   define variable v-created as logical no-undo .
     3996   define variable v-created-dtl as logical no-undo .
     3997   define variable add-nf-amount as integer   no-undo .
     3998   define variable add-NF-gds-amount as integer   no-undo .
     3999   define variable v-dop as character no-undo .
     4000   define variable v-rec-inv-line as recid no-undo .
     4001   define variable nff-chk-amount as integer no-undo .
     4002   define variable v-cash-pay-attr as character no-undo.
     4003   define variable par-alcohol as character no-undo .
     4004   define variable par-type    as character no-undo .
     4005   define variable mark-ii     as integer no-undo .
     4006   define variable v-doc-code_fbr as character no-undo .
     4007   define variable v-pl-code   like ub.place.pl-code no-undo .
     4008   define variable v-pl-list   as character no-undo .
     4009   define variable v-pl-ii     as integer   no-undo .
     4010   define variable v-value     as character no-undo .
     4011   define variable v-ok        as logical   no-undo .
     4012   define variable v-Reconc-tank-attr as character no-undo .
     4013   define buffer buf_trn-doc for ub.trn-doc.
     4014   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     4015   define buffer buf_c-chk-doc for ub.c-chk-doc.
     4016   define buffer buf_c-chk-gds for ub.c-chk-gds.
     4017   define buffer buf_c-chk-pay for ub.c-chk-pay.
     4018   define buffer buf_c-chk-discnt for ub.c-chk-discnt.
     4019   define buffer buf_c-chk-doc-attr for ub.c-chk-doc-attr.
     4020   define buffer buf_chk-gds-pay for ub.chk-gds-pay.
     4021   define buffer buf_chk-pay for ub.chk-pay.
     4022   define buffer buf_cash-pay-attr for ub.cash-pay-attr.
     4023   define buffer buf_chk-gds for ub.chk-gds.
     4024   define buffer buf_chk-discnt for ub.chk-discnt.
     4025   define buffer buf_inkas-pay for ub.inkas-pay.
     4026   define buffer buf_inkas-pay-desk for ub.inkas-pay-desk.
     4027   define buffer buf_inkas-pay-wth for ub.inkas-pay-wth.
     4028   define buffer buf_place       for ub.place.
     4029   define buffer com_place       for ub.place.
     4030   define buffer dop_trn-doc for ub.trn-doc.
     4031   define buffer buf_doc-line for ub.doc-line.
     4032   define buffer buf_gds-dtl for ub.gds-dtl.
     4033   define buffer BUF_sale-doc for ub.sale-doc.
     4034   define buffer tpsi_sale-doc for ub.sale-doc.
     4035   do
     4036   on error undo, return error return-value
     4037   :
     4038     if ink-doc.status_ = 'факт':U
     4039     then do:
     4040       MESSAGE substitute("Продажа &1 уже закрыта:&2Докачка чеков не может быть произведена"                                , ink-doc.inkas-code                                        , chr(10)                                                ) view-as alert-box ERROR .
     4041        UNDO, return error.
     4042     end.
     4043     find first ub.sysconf no-lock where
     4044               ub.sysconf.host-code = ink-doc.host-code .
     4045     if v-curr-r-b = 'base':U or
     4046     ub.sysconf.base-code = 0 then pychk_NO-exch = yes.
     4047     else pychk_No-exch = no.
     4048     if v-curr-r-b = 'rubl':U or
     4049     ub.sysconf.base-code = 0 then pychk_NO-exch-rubl = yes.
     4050     else pychk_No-exch-rubl = no.
     4051     assign
     4052     accum-chk-doc-tot-doc = 0
     4053     accum-chk-doc-discnt = 0
     4054     accum-chk-doc-netto = 0
     4055     accum-chk-doc-sub-discnt = 0
     4056     v-rc-max = (if p-rid-list <> '':U then num-entries(p-rid-list) else 1)
     4057     v-rc-ii = (if p-rid-list <> '':U
     4058                then (if available X_chk-doc
     4059                      then lookup(string(recid(X_chk-doc)), p-rid-list)
     4060                      else v-rc-ii)
     4061                else v-rc-ii)
     4062     .
     4063     run get-inkas-ps in this-procedure (
     4064                                         buffer ink-doc
     4065                                       , output chk-amount
     4066                                       , output gds-amount
     4067                                       , output line-out
     4068                                       , output dtl-out
     4069                                       , output line-ret
     4070                                       , output dtl-ret
     4071                                       , output nf-chk-amount
     4072                                       , output nf-gds-amount
     4073                                       , output p-filter-rus
     4074                                       ).
     4075     run get-tpsi-params in this-procedure (
     4076                                             input ink-doc.obj-type
     4077                                            ,input ink-doc.obj-code
     4078                                            ,output v-is-tpsi-obj
     4079                                            ,output v-tpsi-mode
     4080                                            ,output v-main-tpsi ) no-error.
     4081   end.
     4082   do
     4083   on error undo, return error return-value
     4084   :
     4085     for each buf_sale-doc where
     4086              buf_sale-doc.inkas-code = ink-doc.inkas-code
     4087          and buf_sale-doc.order > 0:
     4088       buf_sale-doc.chk-doc-code = '':U.
     4089     end.
     4090     c-d:
     4091     DO WHILE available X_chk-doc or (p-rid-list <> '':U and  v-rc-ii <= v-rc-max) or action = "next"
     4092     on error undo c-d, NEXT c-d
     4093     on stop undo c-d, NEXT c-d:
     4094       action = '':U.
     4095       if not v-first then do:
     4096         if p-rid-list = "":U then do:
     4097           ASSIGN
     4098           glog = QUERY query-chk-doc:GET-next(no-LOCK) NO-ERROR.
     4099           if available X_chk-doc then do:
     4100             ASSIGN
     4101             glog = QUERY query-chk-doc:GET-current(exclusive-LOCK, no-wait) NO-ERROR.
     4102             if locked(X_chk-doc)
     4103             or X_chk-doc.out-code <> ?
     4104             then do:
     4105               error-status:error = no.
     4106               action = "next".
     4107               next c-d.
     4108             end.
     4109           end.
     4110         end.
     4111         else do:
     4112           assign
     4113           v-rc-ii = v-rc-ii + 1.
     4114           _v-rc:
     4115           do while v-rc-ii <= v-rc-max:
     4116             find first X_chk-doc exclusive-lock where
     4117                       recid(X_chk-doc) = integer(entry(v-rc-ii, p-rid-list))  no-error  NO-WAIT.
     4118             if locked X_chk-doc or not available X_chk-doc
     4119             or X_chk-doc.out-code <> ?
     4120             then do:
     4121               assign
     4122               v-rc-ii = v-rc-ii + 1.
     4123               next _v-rc.
     4124             end.
     4125             else LEAVE _v-rc.
     4126           end.
     4127           if v-rc-ii > v-rc-max then release X_chk-doc.
     4128         end.
     4129         if (not available X_chk-doc and action = '':U)
     4130         or (p-rid-list <> "":U and v-rc-ii > v-rc-max) then LEAVE c-d.
     4131       end.
     4132       if v-first then v-first = no.
     4133       cr = 0.
     4134       if lookup(string(X_chk-doc.chk-type), '101,106,108,169,196,114,115,116,136,117,111,112,113':U) > 0
     4135       or lookup(string(X_chk-doc.chk-type), '11,111,201,206':U) > 0
     4136       or X_chk-doc.out-code <> ?
     4137       then do:
     4138         next c-d.
     4139       end.
     4140       if lookup(string(X_chk-doc.chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) = 0
     4141       then do:
     4142         next c-d.
     4143       end.
     4144       if lookup(string(X_chk-doc.chk-type), '2,3,4,5,7':U) > 0
     4145       and is-wth = yes then do:
     4146         NEXT c-d .
     4147       end.
     4148       if v-is-tpsi-obj then do:
     4149         if (p-status_ = 'запрос':U
     4150         and index(X_chk-doc.doc-code, '>':U)  > 0 )
     4151         or (p-status_ = 'касс':U
     4152             and v-tpsi-mode = 2
     4153             and index(X_chk-doc.doc-code, '>':U)  = 0
     4154             )
     4155         then next c-d.
     4156       end.
     4157       if cas-shft then do:
     4158         if ink-doc.doc-date <> X_chk-doc.shift-date OR ink-doc.shift-num <> X_chk-doc.shift-num then do:
     4159           NEXT c-d .
     4160         end.
     4161       end.
     4162       else do:
     4163         if p-day-only then do:
     4164           if ink-doc.doc-date <> X_chk-doc.shift-date then do:
     4165             NEXT c-d .
     4166           end.
     4167         end.
     4168         else do:
     4169           if X_chk-doc.shift-date > ink-doc.shift-date
     4170           and ((p-rid-list = "":U and p-filter-on = no)
     4171               or
     4172               p-filter-on = no)
     4173           then do:
     4174             NEXT c-d .
     4175           end.
     4176         end.
     4177       end.
     4178       if replace(replace(replace(X_chk-doc.office
     4179                                  , 'т':U
     4180                                  , '':U)
     4181                          , 'у':U
     4182                          , '':U)
     4183                  , chr(44)
     4184                  , '':U) <> '':U
