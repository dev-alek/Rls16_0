     4906               ub.doc-pl.cli-fact-qnty = ub.doc-pl.cli-fact-qnty + abs( t-gds.doc-qnty ) * t-gds.density
     4907               .
     4908               release doc-pl.
     4909               assign
     4910               v-qnty     = 0.0
     4911               v-cli-qnty = 0.0
     4912               .
     4913               for each ub.doc-pl no-lock where
     4914                       ub.doc-pl.out-code = t-gds.doc-code
     4915                   and ub.doc-pl.gds-code = t-gds.gds-code:
     4916                 assign
     4917                 v-qnty     = v-qnty + ub.doc-pl.fact-qnty
     4918                 v-cli-qnty = v-cli-qnty + ub.doc-pl.cli-fact-qnty
     4919                 .
     4920               end.
     4921               assign
     4922               buf_doc-line.fact-density = v-cli-qnty / v-qnty
     4923               buf_doc-line.doc-density = buf_doc-line.fact-density
     4924               .
     4925   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_corinvln in g#lib-trn3
     4926   ( input  buf_doc-line.doc-code
     4927    ,input  buf_doc-line.artic
     4928    ,input  buf_doc-line.prod-type
     4929    ,input  buf_doc-line.prod-code
     4930    ,input  ?
     4931    ,input  ?
     4932    ,input  ?
     4933    ,input  ?
     4934    ,input   buf_doc-line.fact-qnty * buf_doc-line.fact-density
     4935    ,input  buf_doc-line.fact-density
     4936    ,output v-rec-inv-line
     4937    ) .
     4938               FIND FIRST ub.doc-pl-pump WHERE ub.doc-pl-pump.out-code = t-gds.doc-code AND
     4939                                           ub.doc-pl-pump.gds-code = t-gds.gds-code AND
     4940                                           ub.doc-pl-pump.pl-code = t-gds.pl-code AND
     4941                                           ub.doc-pl-pump.obj-type = p-obj-type AND
     4942                                           ub.doc-pl-pump.obj-code = p-obj-code AND
     4943                                           ub.doc-pl-pump.pump-code = t-gds.pump
     4944                                           NO-ERROR.
     4945               IF not avail ub.doc-pl-pump THEN do:
     4946                 create ub.doc-pl-pump.
     4947                 assign
     4948                 ub.doc-pl-pump.obj-type = p-obj-type
     4949                 ub.doc-pl-pump.obj-code = p-obj-code
     4950                 ub.doc-pl-pump.out-code = t-gds.doc-code
     4951                 ub.doc-pl-pump.gds-code = t-gds.gds-code
     4952                 ub.doc-pl-pump.pl-code = t-gds.pl-code
     4953                 ub.doc-pl-pump.doc-qnty = 0
     4954                 ub.doc-pl-pump.fact-qnty = 0
     4955                 ub.doc-pl-pump.pump-code = t-gds.pump
     4956                 .
     4957               end.
     4958               assign
     4959               ub.doc-pl-pump.fact-qnty = ub.doc-pl-pump.fact-qnty + abs( t-gds.doc-qnty ).
     4960             end.
     4961             if not t-gds.pump > 0 then do:
     4962               if t-gds.cashparts then do:
     4963                 define variable v-nonunique as integer no-undo .
     4964                 if lookup('2ед':U, t-gds.type) > 0 then do:
     4965                   FIND FIRST ub.doc-prts WHERE
     4966                               ub.doc-prts.out-code = t-gds.doc-code
     4967                           AND ub.doc-prts.gds-code = t-gds.gds-code  NO-ERROR.
     4968                   v-nonunique = if available ub.doc-prts then (ub.doc-prts.b-code - 1) else -1 .
     4969                 end.
     4970                 else v-nonunique = t-gds.b-code .
     4971                 FIND FIRST ub.doc-prts
     4972                      WHERE ub.doc-prts.out-code = t-gds.doc-code
     4973                        AND ub.doc-prts.b-code   = v-nonunique
     4974                        AND ub.doc-prts.gds-code = t-gds.gds-code NO-ERROR.
     4975                   IF not avail ub.doc-prts THEN do:
     4976                     create ub.doc-prts.
     4977                     assign
     4978                     ub.doc-prts.out-code = t-gds.doc-code
     4979                     ub.doc-prts.gds-code = t-gds.gds-code
     4980                     ub.doc-prts.b-code =  (if lookup('2ед':U, t-gds.type) > 0
     4981                                         then v-nonunique
     4982                                         else t-gds.b-code)
     4983                     ub.doc-prts.doc-qnty = 0
     4984                     ub.doc-prts.fact-qnty = 0
     4985                     .
     4986                   end.
     4987                 assign
     4988                 ub.doc-prts.fact-qnty = ub.doc-prts.fact-qnty + abs( t-gds.doc-qnty ).
     4989               END.
     4990             end.
     4991             assign
     4992             v-created-dtl = no.
     4993             if not v-created then do:
     4994               FIND FIRST buf_gds-dtl WHERE buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     4995                                     and buf_gds-dtl.artic     = buf_doc-line.artic
     4996                                     and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     4997                                     and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     4998                                     and buf_gds-dtl.prt-code  = t-gds.node-code NO-ERROR .
     4999             end.
     5000             if v-created or NOT available buf_gds-dtl then do:
     5001   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     5002     ( input buf_doc-line.obj-code
     5003      ,input buf_doc-line.obj-type
     5004      ,input buf_doc-line.doc-code
     5005      ,input buf_doc-line.artic
     5006      ,input buf_doc-line.prod-code
     5007      ,input buf_doc-line.prod-type
     5008      ,input t-gds.node-code
     5009      ,input no
     5010     ) no-error .
     5011               if error-status:error then do:
     5012     MESSAGE substitute("Чек &1 Бар-код &2&3Ошибка при создании признака для товара с кодом &4:&3&5&6&3Чек не будет закачан в продажу"                                , X_chk-doc.doc-code                                           , t-gds.b-code                                                 , chr(10)                                                , t-gds.gds-code                                               , error-status:get-message(1)                                  , return-value                                                 ) view-as alert-box ERROR.
     5013                 UNDO _one-check, leave _one-check.
     5014               end.
     5015               assign
     5016               v-created-dtl = yes
     5017               .
     5018               FIND FIRST buf_gds-dtl WHERE buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     5019                                   and buf_gds-dtl.artic     = buf_doc-line.artic
     5020                                   and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     5021                                   and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     5022                                   and buf_gds-dtl.prt-code  = t-gds.node-code.
     5023               assign
     5024               buf_gds-dtl.discnt-type = no
     5025               buf_gds-dtl.discnt-base = 0
     5026               buf_gds-dtl.fact-qnty = 0
     5027               buf_gds-dtl.doc-qnty = 0
     5028               buf_gds-dtl.ov = yes.
     5029             end.
     5030             if Not (t-gds.fbr-obj-type = "":U and t-gds.fbr-obj-code = 0)
     5031             and Not (t-gds.fbr-obj-type = ? and t-gds.fbr-obj-code = ?)
     5032             then do:
     5033               if t-gds.doc-qnty < 0
     5034               then do :
     5035                 v-doc-code_fbr = replace(t-gds.doc-code, "=", "-") .
     5036               end.
     5037               else do :
     5038                 v-doc-code_fbr = t-gds.doc-code .
     5039               end.
     5040               FIND FIRST ub.doc-fbr-gds WHERE ub.doc-fbr-gds.out-code = v-doc-code_fbr AND
     5041                                       ub.doc-fbr-gds.gds-code = t-gds.gds-code AND
     5042                                       ub.doc-fbr-gds.fbr-obj-type = t-gds.fbr-obj-type AND
     5043                                       ub.doc-fbr-gds.fbr-obj-code = t-gds.fbr-obj-code AND
     5044                                       ub.doc-fbr-gds.obj-type = p-obj-type AND
     5045                                       ub.doc-fbr-gds.obj-code = p-obj-code
     5046                                       NO-ERROR.
     5047               IF not avail ub.doc-fbr-gds THEN do:
     5048                 create ub.doc-fbr-gds.
     5049                 assign
     5050                 ub.doc-fbr-gds.obj-type = p-obj-type
     5051                 ub.doc-fbr-gds.obj-code = p-obj-code
     5052                 ub.doc-fbr-gds.out-code = v-doc-code_fbr
     5053                 ub.doc-fbr-gds.gds-code = t-gds.gds-code
     5054                 ub.doc-fbr-gds.fbr-obj-type = t-gds.fbr-obj-type
     5055                 ub.doc-fbr-gds.fbr-obj-code = t-gds.fbr-obj-code
     5056                 ub.doc-fbr-gds.doc-qnty = 0
     5057                 ub.doc-fbr-gds.fact-qnty = 0
     5058                 .
     5059               end.
     5060               assign
     5061               ub.doc-fbr-gds.fact-qnty = ub.doc-fbr-gds.fact-qnty +  t-gds.doc-qnty .
     5062             end.
     5063         define variable v-discnt-r-b like ub.gds-dtl.discnt-rubl no-undo .
     5064     define variable v-price-r-b like ub.gds-dtl.price-rubl no-undo .
     5065             assign
     5066             v-discnt-r-b = (if (buf_gds-dtl.fact-qnty + abs(t-gds.doc-qnty)) = 0
     5067                             then 0
     5068                             else (if prcl-spl
     5069                                     then
     5070                                     (t-gds.new-price * (buf_gds-dtl.fact-qnty + abs(t-gds.doc-qnty))
     5071                                     - ((if v-curr-r-b = 'base':U then buf_gds-dtl.price-base else buf_gds-dtl.price-rubl) - (if v-curr-r-b = 'base':U then buf_gds-dtl.discnt-base else buf_gds-dtl.discnt-rubl)) * buf_gds-dtl.fact-qnty
     5072                                     - buf_sale-doc.msign * (t-gds.price-sum - t-gds.discnt-sum)
     5073                                     ) / (buf_gds-dtl.fact-qnty + abs(t-gds.doc-qnty))
     5074                                     else
     5075                                     (t-gds.price-base * (buf_gds-dtl.fact-qnty + abs(t-gds.doc-qnty))
     5076                                     - ((if v-curr-r-b = 'base':U then buf_gds-dtl.price-base else buf_gds-dtl.price-rubl) - (if v-curr-r-b = 'base':U then buf_gds-dtl.discnt-base else buf_gds-dtl.discnt-rubl)) * buf_gds-dtl.fact-qnty
     5077                                     - buf_sale-doc.msign * (t-gds.price-sum - t-gds.discnt-sum)
     5078                                     ) / (buf_gds-dtl.fact-qnty + abs(t-gds.doc-qnty))
     5079                                   )
     5080                             )
     5081             buf_gds-dtl.fact-qnty = buf_gds-dtl.fact-qnty + abs( t-gds.doc-qnty )
     5082             v-price-r-b =  (if prcl-spl then  t-gds.new-price  else t-gds.price-base )
     5083             buf_gds-dtl.price-base = (if v-curr-r-b = 'rubl':U
     5084                                   then  v-price-r-b / trn-doc.base-rate * trn-doc.base-scale
     5085                                   else v-price-r-b)
     5086             buf_gds-dtl.discnt-base = (if v-curr-r-b = 'rubl':U
     5087                                     then v-discnt-r-b / trn-doc.base-rate * trn-doc.base-scale
     5088                                     else v-discnt-r-b )
     5089             buf_gds-dtl.price-rubl = (if v-curr-r-b = 'base':U
     5090                                   then v-price-r-b * trn-doc.base-rate / trn-doc.base-scale
     5091                                   else v-price-r-b)
     5092             buf_gds-dtl.discnt-rubl = (if v-curr-r-b = 'base':U
     5093                                   then v-discnt-r-b  * trn-doc.base-rate / trn-doc.base-scale
     5094                                   else v-discnt-r-b )
     5095             buf_doc-line.road-tax = (if road
     5096                                 then
     5097                                 (buf_doc-line.road-tax * (buf_doc-line.fact-qnty - abs(t-gds.doc-qnty) ) +
     5098                                   buf_sale-doc.msign * t-gds.road-sum ) / (buf_doc-line.fact-qnty )
     5099                                 else 0)
     5100             buf_doc-line.excise = (if road
     5101                               then
     5102                               t-gds.excise
     5103                               else 0)
     5104             buf_gds-dtl.discnt-pc = (if t-gds.is-modificator then 0 else buf_gds-dtl.discnt-pc)
     5105             .
     5106             if X_chk-doc.doc-code <> buf_sale-doc.chk-doc-code
     5107             AND buf_sale-doc.main-receipt-type = X_chk-doc.chk-type
     5108             then do:
     5109               assign
     5110               buf_sale-doc.chk-doc-code = X_chk-doc.doc-code
     5111               buf_sale-doc.chk-amount = buf_sale-doc.chk-amount + 1
     5112               .
     5113             end.
     5114             assign
     5115             buf_sale-doc.tot-lines = buf_sale-doc.tot-lines + (if v-created then 1 else 0)
     5116             line-out = line-out + (if buf_sale-doc.doc-kind = 'es':U
     5117                                    and v-created
     5118                                    then 1
     5119                                    else 0)
     5120             line-ret = line-ret + (if buf_sale-doc.doc-kind = 'rs':U
     5121                                    and v-created
     5122                                    then 1
     5123                                    else 0)
     5124             buf_sale-doc.tot-dtl = buf_sale-doc.tot-dtl + (if v-created-dtl then 1 else 0)
     5125             dtl-out = dtl-out + (if buf_sale-doc.doc-kind = 'es':U
     5126                                  and v-created-dtl
     5127                                  then 1
     5128                                  else 0)
     5129             dtl-ret = dtl-ret + (if buf_sale-doc.doc-kind = 'rs':U
     5130                                  and v-created-dtl
     5131                                  then 1
     5132                                  else 0)
     5133             buf_sale-doc.gds-amount = buf_sale-doc.gds-amount + t-gds.num-lines
     5134             buf_sale-doc.fact-qnty = buf_sale-doc.fact-qnty  + t-gds.doc-qnty * buf_sale-doc.msign.
     5135           END .
     5136           var-doc-type = '':U.
     5137           if kind-to-reserv begins 'es':U then do:
     5138             var-doc-type =  'при':U.
     5139           end.
     5140           if kind-to-reserv begins 'rs':U or v-cash-pay-attr <> "" then do:
     5141             var-doc-type =  'рас':U .
     5142           end.
     5143           FOR  EACH buf_chk-pay WHERE buf_chk-pay.doc-code = X_chk-doc.doc-code
     5144           BREAK
     5145           BY buf_chk-pay.doc-code
     5146           BY buf_chk-pay.pay-code
     5147           BY buf_chk-pay.curr-code :
     5148             if var-doc-type <> '':U
     5149             or (X_chk-doc.chk-type <> integer('7':U)
     5150                 and
     5151                 lookup(string(X_chk-doc.chk-type), '2,3,4,5,7':U) > 0
     5152                 )
     5153             then do:
     5154               find first buf_inkas-pay-wth where
     5155                         buf_inkas-pay-wth.inkas-code = ink-doc.inkas-code
     5156                     and buf_inkas-pay-wth.pay-code = buf_chk-pay.pay-code
     5157                     and buf_inkas-pay-wth.curr-code = buf_chk-pay.curr-code
     5158                     and buf_inkas-pay-wth.wth-code = buf_chk-pay.wth-code
     5159                     and buf_inkas-pay-wth.par-code = buf_chk-pay.par-code
     5160                     and buf_inkas-pay-wth.pay-desk = X_chk-doc.pay-desk
     5161                     and buf_inkas-pay-wth.cashier = X_chk-doc.cashier
     5162                     and buf_inkas-pay-wth.chk-type = X_chk-doc.chk-type no-error.
     5163               if not available  buf_inkas-pay-wth then do:
     5164                 create buf_inkas-pay-wth.
     5165                 assign
     5166                 buf_inkas-pay-wth.inkas-code = ink-doc.inkas-code
     5167                 buf_inkas-pay-wth.pay-code = buf_chk-pay.pay-code
     5168                 buf_inkas-pay-wth.curr-code = buf_chk-pay.curr-code
     5169                 buf_inkas-pay-wth.wth-code = buf_chk-pay.wth-code
     5170                 buf_inkas-pay-wth.par-code = buf_chk-pay.par-code
     5171                 buf_inkas-pay-wth.pay-desk = X_chk-doc.pay-desk
     5172                 buf_inkas-pay-wth.cashier = X_chk-doc.cashier
     5173                 buf_inkas-pay-wth.chk-type = X_chk-doc.chk-type
     5174                 buf_inkas-pay-wth.par-val = buf_chk-pay.par-val
     5175                 .
     5176               end.
     5177               assign
     5178               buf_inkas-pay-wth.tot-sum = buf_inkas-pay-wth.tot-sum + buf_chk-pay.tot-sum
     5179               buf_inkas-pay-wth.tot-base = buf_inkas-pay-wth.tot-base + buf_chk-pay.tot-base
     5180               buf_inkas-pay-wth.tot-rubl = buf_inkas-pay-wth.tot-rubl + buf_chk-pay.tot-rubl
     5181               buf_inkas-pay-wth.doc-qnty = buf_inkas-pay-wth.doc-qnty + buf_chk-pay.doc-qnty
     5182               buf_inkas-pay-wth.tot-lines = buf_inkas-pay-wth.tot-lines + 1
     5183               .
     5184             end.
     5185             IF FIRST-OF(buf_chk-pay.curr-code) then do:
     5186               assign
     5187               accum-chk-pay-tot-sum-by = 0
     5188               accum-chk-pay-tot-base-by = 0
     5189               accum-chk-pay-tot-rubl-by = 0
     5190               .
     5191             end.
     5192             assign
     5193             accum-chk-pay-tot-sum-by = accum-chk-pay-tot-sum-by + buf_chk-pay.tot-sum
     5194             accum-chk-pay-tot-base-by = accum-chk-pay-tot-base-by + buf_chk-pay.tot-base
     5195             accum-chk-pay-tot-rubl-by = accum-chk-pay-tot-rubl-by + buf_chk-pay.tot-rubl
     5196             .
     5197             buf_chk-pay.out-code = ink-doc.inkas-code .
     5198             if last-of( buf_chk-pay.curr-code ) then  do:
     5199               FIND FIRST buf_inkas-pay WHERE
     5200                           buf_inkas-pay.inkas-code = ink-doc.inkas-code AND
     5201                           buf_inkas-pay.pay-code = buf_chk-pay.pay-code AND
     5202                           buf_inkas-pay.curr-code = buf_chk-pay.curr-code NO-ERROR.
     5203               if NOT available buf_inkas-pay then do:
     5204                 CREATE buf_inkas-pay.
     5205                 assign
     5206                 buf_inkas-pay.inkas-code = ink-doc.inkas-code
     5207                 buf_inkas-pay.pay-code = buf_chk-pay.pay-code
     5208                 buf_inkas-pay.curr-code = buf_chk-pay.curr-code
     5209                 buf_inkas-pay.tot-sum = 0
     5210                 buf_inkas-pay.tot-base = 0
     5211                 buf_inkas-pay.tot-rubl = 0
     5212                 .
     5213               end.
     5214               if var-doc-type <> '':U then do:
     5215                 FIND FIRST buf_inkas-pay-desk WHERE
     5216                             buf_inkas-pay-desk.inkas-code = ink-doc.inkas-code AND
     5217                             buf_inkas-pay-desk.pay-code = buf_chk-pay.pay-code AND
     5218                             buf_inkas-pay-desk.curr-code = buf_chk-pay.curr-code AND
     5219                             buf_inkas-pay-desk.pay-desk = X_chk-doc.pay-desk AND
     5220                             buf_inkas-pay-desk.doc-type = var-doc-type AND
     5221                             buf_inkas-pay-desk.cashier = X_chk-doc.cashier
     5222                             NO-ERROR.
     5223                 if NOT available buf_inkas-pay-desk then do:
     5224                   CREATE buf_inkas-pay-desk.
     5225                   assign
     5226                   buf_inkas-pay-desk.inkas-code = ink-doc.inkas-code
     5227                   buf_inkas-pay-desk.pay-code = buf_chk-pay.pay-code
     5228                   buf_inkas-pay-desk.curr-code = buf_chk-pay.curr-code
     5229                   buf_inkas-pay-desk.pay-desk = X_chk-doc.pay-desk
     5230                   buf_inkas-pay-desk.tot-sum = 0
     5231                   buf_inkas-pay-desk.tot-base = 0
     5232                   buf_inkas-pay-desk.tot-rubl = 0
     5233                   buf_inkas-pay-desk.doc-type = var-doc-type
     5234                   buf_inkas-pay-desk.cashier = X_chk-doc.cashier
     5235                   .
     5236                 end.
     5237                 assign
     5238                 buf_inkas-pay.tot-sum = buf_inkas-pay.tot-sum + accum-chk-pay-tot-sum-by
     5239                 buf_inkas-pay.tot-base = buf_inkas-pay.tot-base + accum-chk-pay-tot-base-by
     5240                 buf_inkas-pay.tot-rubl = buf_inkas-pay.tot-rubl + accum-chk-pay-tot-rubl-by
     5241                 buf_inkas-pay-desk.tot-sum = buf_inkas-pay-desk.tot-sum + accum-chk-pay-tot-sum-by
     5242                 buf_inkas-pay-desk.tot-base = buf_inkas-pay-desk.tot-base + accum-chk-pay-tot-base-by
     5243                 buf_inkas-pay-desk.tot-rubl = buf_inkas-pay-desk.tot-rubl + accum-chk-pay-tot-rubl-by
     5244                 .
     5245               end.
     5246             end.
     5247           END.
     5248           FOR EACH buf_chk-discnt where
     5249                     buf_chk-discnt.doc-code = X_chk-doc.doc-code
     5250           on error undo _one-check, leave _one-check:
     5251             assign
     5252             buf_chk-discnt.out-code = ink-doc.inkas-code
     5253             .
     5254           end.
     5255         end.
     5256        if X_chk-doc.chk-type = integer('12':U)
     5257        or X_chk-doc.chk-type = integer('43':U)
     5258        or X_chk-doc.chk-type = integer('44':U)
     5259        then do:
     5260           for each buf_chk-pay where
     5261                  buf_chk-pay.doc-code = X_chk-doc.doc-code
     5262            on error undo c-d, NEXT c-d:
     5263              buf_chk-pay.out-code = ink-doc.inkas-code .
     5264           end.
     5265         end.
     5266         for each buf_c-chk-doc where
     5267                 buf_c-chk-doc.doc-code = X_chk-doc.doc-code
     5268         on error undo c-d, NEXT c-d:
     5269           assign
     5270           buf_c-chk-doc.out-code = ink-doc.inkas-code
     5271           .
     5272         end.
     5273         for each buf_c-chk-gds where
     5274                 buf_c-chk-gds.doc-code = X_chk-doc.doc-code
     5275         on error undo c-d, NEXT c-d:
     5276           assign
     5277           buf_c-chk-gds.out-code = ink-doc.inkas-code
     5278           .
     5279         end.
     5280         for each buf_c-chk-discnt where
     5281                 buf_c-chk-discnt.doc-code = X_chk-doc.doc-code
     5282         on error undo c-d, NEXT c-d:
     5283           assign
     5284           buf_c-chk-discnt.out-code = ink-doc.inkas-code
     5285           .
     5286         end.
     5287         for each buf_c-chk-pay where
     5288                 buf_c-chk-pay.doc-code = X_chk-doc.doc-code
     5289         on error undo c-d, NEXT c-d:
     5290           assign
     5291           buf_c-chk-pay.out-code = ink-doc.inkas-code
     5292           .
     5293         end.
     5294         for each buf_c-chk-doc-attr where
     5295                 buf_c-chk-doc-attr.doc-code = X_chk-doc.doc-code
     5296         on error undo c-d, NEXT c-d:
     5297           assign
     5298           buf_c-chk-doc-attr.out-code = ink-doc.inkas-code
     5299           .
     5300         end.
     5301         for each buf_chk-gds-pay where
     5302                 buf_chk-gds-pay.doc-code = X_chk-doc.doc-code
     5303         on error undo c-d, NEXT c-d:
     5304           assign
     5305           buf_chk-gds-pay.out-code = ink-doc.inkas-code
     5306           .
     5307         end.
     5308         X_chk-doc.out-code = ink-doc.inkas-code.
     5309         if pay-gds-algo <> '' then do:
     5310           if lookup(string(X_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then do:
     5311           end.
     5312           else do:
     5313             run r-pychk0 in this-procedure ( input ub.sysconf.base-code
     5314                                             ,input X_chk-doc.doc-code) no-error.
     5315             if error-status:error then do:
     5316                 MESSAGE substitute("Чек &1 возникла ошибка при формировании распределения платежей. Чек не будет закачан в продажу&2&3"                                    , X_chk-doc.doc-code                                               , chr(10)                                                    , return-value                                                     ) view-as alert-box ERROR .
     5317                 undo _one-check, leave _one-check.
     5318             end.
     5319           end.
     5320         end.
     5321         assign
     5322         chk-amount = chk-amount + 1
     5323         nf-chk-amount = nf-chk-amount + add-nf-amount
     5324         nff-chk-amount = nff-chk-amount + (if lookup(string(X_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then 1 else 0)
     5325         .
     5326         if X_chk-doc.chk-type <> integer('43':U) and X_chk-doc.chk-type <> integer('44':U)
     5327         then
     5328         assign
     5329         accum-chk-doc-tot-doc = accum-chk-doc-tot-doc  + X_chk-doc.tot-doc
     5330         accum-chk-doc-discnt = accum-chk-doc-discnt + X_chk-doc.discnt
     5331         accum-chk-doc-netto = accum-chk-doc-netto + X_chk-doc.netto
     5332         accum-chk-doc-sub-discnt = accum-chk-doc-sub-discnt + X_chk-doc.sub-discnt
     5333         .
     5334         if p-ii < 10
     5335         or (p-ii < 1000 and chk-amount modulo 10 = 0)
     5336         or (p-ii < 10000 and chk-amount modulo 100 = 0)
     5337         then
     5338         run display-ink-doc in p-call-handle(
     5339                                               input gds-amount
     5340                                              ,input nf-gds-amount
     5341                                              ,input line-out
     5342                                              ,input line-ret
     5343                                              ,input dtl-out
     5344                                              ,input dtl-ret
     5345                                               ).
     5346         assign
     5347         p-ii-ok = p-ii-ok + 1
     5348         .
     5349       end.
     5350     END.
     5351     assign
     5352     ink-doc.tot-doc = ink-doc.tot-doc + accum-chk-doc-tot-doc
     5353     ink-doc.discnt = ink-doc.discnt + accum-chk-doc-discnt
     5354     ink-doc.netto = ink-doc.netto + accum-chk-doc-netto
     5355     ink-doc.sub-discnt = ink-doc.sub-discnt + accum-chk-doc-sub-discnt
     5356     ink-doc.num-chk = chk-amount
     5357     ink-doc.num-chk-nf = nf-chk-amount
     5358     ink-doc.num-chk-nff = nff-chk-amount
     5359     .
     5360     assign
     5361     ink-doc.qnty = 0
     5362     .
     5363     for each buf_sale-doc where
     5364              buf_sale-doc.inkas-code = ink-doc.inkas-code
     5365          and buf_sale-doc.order > 0,
     5366         first dop_trn-doc where dop_trn-doc.doc-code = buf_sale-doc.doc-code:
     5367       assign
     5368       dop_trn-doc.fact-qnty = buf_sale-doc.fact-qnty
     5369       dop_trn-doc.tot-lines = buf_sale-doc.tot-lines
     5370       buf_sale-doc.filled = buf_sale-doc.tot-lines <> 0 or buf_sale-doc.fact-qnty <> 0
     5371       .
     5372       dop_trn-doc.ps = set-sale-doc-ps(buffer buf_sale-doc)
     5373       .
     5374       if buf_sale-doc.in-inkas then
     5375       assign
     5376       ink-doc.qnty = ink-doc.qnty + buf_sale-doc.fact-qnty * (if lookup(buf_sale-doc.ext-doc-type, 'vt,vp,rs':U) > 0 then - 1 else 1)
     5377       .
     5378     END.
     5379     assign
     5380     ink-doc.PS = set-inkas-ps (
     5381                             input ink-doc.ps
     5382                           , input chk-amount
     5383                           , input gds-amount
     5384                           , input line-out
     5385                           , input dtl-out
     5386                           , input line-ret
     5387                           , input dtl-ret
     5388                           , input nf-chk-amount
     5389                           , input nf-gds-amount
     5390                           , input p-filter-rus
     5391                           ).
     5392       for each buf_sale-doc where
     5393               buf_sale-doc.inkas-code = ink-doc.inkas-code,
     5394         first dop_trn-doc where dop_trn-doc.doc-code = buf_sale-doc.doc-code:
     5395       if buf_sale-doc.ext-doc-type <> 'es':U
     5396       and not can-find(first buf_doc-line no-lock where
     5397                       buf_doc-line.doc-code = dop_trn-doc.doc-code) then do:
     5398         assign
     5399         dop_trn-doc.status_ = 'накл':U
     5400         dop_trn-doc.flag_ = no.
     5401         run str/del-doc.p (
     5402             input parparentproc,
     5403             input  buf_sale-doc.doc-code,
     5404             input  g#db-num,
     5405             input  "del-doc.err",
     5406             input  ?,
     5407             input  ?,
     5408             input  g#userid,
     5409             input  '0',
     5410             input  varchip-code,
     5411             output varchip-code2)
     5412             no-error.
     5413         if error-status:error then do:
     5414           assign
     5415           v-mes =  substitute("Ошибка при удалении ПУСТОГО документа &1 для продажи &2&3:&3&4&3&5"
     5416                                   , buf_sale-doc.doc-code
     5417                                   , ink-doc.inkas-code
     5418                                   , chr(10)
     5419                                   , error-status:get-message(1)
     5420                                   , return-value ).
     5421   MESSAGE v-mes view-as alert-box ERROR .
     5422           next .
     5423         end.
     5424         else do:
     5425           delete buf_sale-doc.
     5426         end.
     5427       end.
     5428     end.
     5429     if can-find(first buf_doc-line no-lock where
     5430                     buf_doc-line.doc-code = trn-doc.doc-code)
     5431     and
     5432     not (old-doc-date = new-doc-date
     5433           AND
     5434           old-shift-date = new-shift-date
     5435           AND
     5436           old-shift-num  = new-shift-num) then do:
     5437       _tpsi_sale-doc:
     5438       for each tpsi_sale-doc where
     5439               tpsi_sale-doc.inkas-code = ink-doc.inkas-code
     5440           and tpsi_sale-doc.tpsidoc = yes,
     5441         first buf_trn-doc EXCLUSIVE-LOCK where
     5442             buf_trn-doc.doc-code = tpsi_sale-doc.doc-code
     5443       on error undo, return error
     5444       :
     5445         assign
     5446         buf_trn-doc.status_ = 'накл':U
     5447         buf_trn-doc.flag_ = no.
     5448         run str/del-doc.p (
     5449             input parparentproc,
     5450             input  tpsi_sale-doc.doc-code,
     5451             input  g#db-num,
     5452             input  "del-doc.err",
     5453             input  ?,
     5454             input  ?,
     5455             input  g#userid,
     5456             input  '0',
     5457             input  varchip-code,
     5458             output varchip-code2)
     5459             no-error.
     5460         if error-status:error then do:
     5461           assign
     5462           v-mes =  substitute("Ошибка при удалении ПУСТОГО расходного документа ЧУЖИХ товаров &1 по объекту &2&3 для продажи &4 &5:&3&6 &7"
     5463                                   , tpsi_sale-doc.doc-code
     5464                                   , (tpsi_sale-doc.obj-type + string(tpsi_sale-doc.obj-code))
     5465                                   , chr(10)
     5466                                   , ink-doc.inkas-code
     5467                                   , (ink-doc.obj-type + string(ink-doc.obj-code))
     5468                                   , error-status:get-message(1)
     5469                                   , return-value ).
     5470   MESSAGE v-mes view-as alert-box ERROR .
     5471           UNDO , return error.
     5472         end.
     5473         else do:
     5474           delete tpsi_sale-doc.
     5475         end.
     5476       end.
     5477       for each tt0-gds-dtl:
     5478         delete tt0-gds-dtl.
     5479       end.
     5480       for each tt0-doc-line:
     5481         delete tt0-doc-line.
     5482       end.
     5483     end.
     5484     run display-chk in p-call-handle (chk-amount, nf-chk-amount).
     5485     run display-ink-doc in p-call-handle(
     5486                                            input gds-amount
     5487                                           ,input nf-gds-amount
     5488                                           ,input line-out
     5489                                           ,input line-ret
     5490                                           ,input dtl-out
     5491                                           ,input dtl-ret
     5492                                           ).
     5493   end.
     5494   end procedure.
     5495   PROCEDURE Get-tpsi-params :
     5496   define input  parameter p-obj-type like ub.clients.obj-type no-undo.
     5497   define input  parameter p-obj-code like ub.clients.obj-code no-undo.
     5498   define output parameter p-is-tpsi-obj as logical no-undo .
     5499   define output parameter p-tpsi-mode as integer no-undo .
     5500   define output parameter p-main-tpsi as logical no-undo .
     5501   define variable v-param-type as character no-undo .
     5502   define variable v-value-character as character no-undo .
     5503   define variable v-value-date as date no-undo .
     5504   define variable v-value-decimal as decimal no-undo .
     5505   define variable v-value-integer as INTEGER no-undo .
     5506   define variable v-value-logical AS LOGICAL no-undo .
     5507   define variable v-tth as handle no-undo .
     5508   assign
     5509   v-tth = buffer thbjattr_thbj-attr:table-handle .
     5510   run gbl/tpsi-obj.p (
     5511                   input p-obj-type
     5512                 , input p-obj-code
     5513                 , output p-is-tpsi-obj) no-error .
     5514   if p-is-tpsi-obj then do:
     5515     run adm/shattri.p (
     5516         input "get":U
     5517       ,input  p-obj-type
     5518       ,input  p-obj-code
     5519       ,input  'autosale':U
     5520       ,input  "":U
     5521       , output v-value-character
     5522       , output v-value-date
     5523       , output v-value-decimal
     5524       , output v-value-integer
     5525       , output v-value-logical
     5526       , output v-param-type
     5527       , INPUT-OUTPUT table-handle v-tth
     5528       ) no-error .
     5529     IF error-status:error then do:
     5530        message
     5531        substitute("Ошибка при получении опций продажи НА ОБЪЕКТЕ &1&2:&3&4 &5"
     5532                 , p-obj-type
     5533                 , p-obj-code
     5534                 , chr(10)
     5535                 , error-status:get-message(1)
     5536                 , return-value )
     5537        view-as alert-box error .
     5538        undo, return error .
     5539     end.
     5540     find first thbjattr_thbj-attr where
     5541               thbjattr_thbj-attr.obj-type = p-obj-type
     5542           and thbjattr_thbj-attr.obj-code = p-obj-code
     5543           and thbjattr_thbj-attr.upper-prop-code = 'autosale':U
     5544           and thbjattr_thbj-attr.prop-code = 'tpsi-mode':U no-error.
     5545     if available thbjattr_thbj-attr then do:
     5546       p-tpsi-mode = thbjattr_thbj-attr.property-value-integer.
     5547     end.
     5548     if p-tpsi-mode = 2 then do:
     5549       find first thbjattr_thbj-attr where
     5550                 thbjattr_thbj-attr.obj-type = p-obj-type
     5551             and thbjattr_thbj-attr.obj-code = p-obj-code
     5552             and thbjattr_thbj-attr.upper-prop-code = 'autosale':U
     5553             and thbjattr_thbj-attr.prop-code = 'main-tpsi':U no-error.
     5554       if available thbjattr_thbj-attr then do:
     5555         p-main-tpsi = thbjattr_thbj-attr.property-value-logical.
     5556       end.
     5557     end.
     5558   end.
     5559   END PROCEDURE.
     5560   run proc-main in this-procedure ( input trn-doc.status_ ) no-error .
     5561   if error-status:error then undo, return error return-value .
     5562   procedure proc-next-c-d :
     5563     do
     5564     on error undo, return error
     5565     :
     5566     end.
     5567   end procedure.
