     4189       and LOokup(string(X_chk-doc.chk-type), '14,15,16,36,8,101,106,108,11,12,13,40,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) = 0 then do:
     4190         if cas-curs then do:
     4191           find first buf_chk-pay where buf_chk-pay.doc-code = X_chk-doc.doc-code No-LOCK No-ERROR.
     4192           if abs(buf_chk-pay.tot-rubl / buf_chk-pay.tot-base - cursh / cursh-scale) > 0.00005 then NEXT c-d.
