       30   define input parameter nf-chk-amount as integer.
       31   define input parameter nf-gds-amount as integer.
       32   define input parameter p-day-only  as logical no-undo .
       33   define input parameter old-doc-date   like ub.inkas.doc-date no-undo .
       34   define input parameter old-shift-date like ub.inkas.shift-date no-undo .
       35   define input parameter old-shift-num  like ub.inkas.shift-num  no-undo .
       36   define input parameter new-doc-date   like ub.inkas.doc-date no-undo .
       37   define input parameter new-shift-date like ub.inkas.shift-date no-undo .
       38   define input parameter new-shift-num  like ub.inkas.shift-num  no-undo .
       39   define parameter buffer ink-doc for ub.inkas.
       40   define parameter buffer trn-doc for ub.trn-doc.
       41   define parameter buffer ret-doc for ub.trn-doc.
       42   define parameter buffer buf_sysconf for ub.sysconf.
       43   define variable vss-revision    as character no-undo init "$Revision$":U .
       44   define variable vss-author      as character no-undo init "$Author$":U .
       45   define variable vss-date        as character no-undo init "$Date$":U .
       46   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       47   define variable vss-archive     as character no-undo init "$Archive$":U .
       48   define variable vss-description as character no-undo init "Закачка чеков в продажу".
       49   procedure vss-get-info :
       50     define output parameter p-vss-revision    like vss-revision    no-undo .
       51     define output parameter p-vss-author      like vss-author      no-undo .
       52     define output parameter p-vss-date        like vss-date        no-undo .
       53     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       54     define output parameter p-vss-archive     like vss-archive     no-undo .
       55     define output parameter p-vss-description like vss-description no-undo .
       56     assign
       57       p-vss-revision    = vss-revision
       58       p-vss-author      = vss-author
       59       p-vss-date        = vss-date
       60       p-vss-workfile    = vss-workfile
       61       p-vss-archive     = vss-archive
       62       p-vss-description = vss-description
       63     .
       64   end procedure.
       65   procedure vss-get-parameters :
       66     define output parameter p-vss-parameters as character no-undo .
       67   end procedure.
       68   define new global shared variable g#vssrevis-logger as handle    no-undo .
       69   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       70   define variable v-vssrevis-logger                   as handle    no-undo .
       71   procedure vss-logevent :
       72     define input  parameter p-extra-paramters as character no-undo .
       73     define variable v-vssrevis-parameters as character no-undo .
       74     do
       75     on error undo, return error return-value
       76     :
       77       if  valid-handle(v-vssrevis-logger)
       78       and v-vssrevis-logger :get-signature("logevent") <> ""
       79       then do:
       80         run vss-get-parameters in this-procedure
       81           (output v-vssrevis-parameters
       82           ).
       83         run logevent in v-vssrevis-logger
       84           (input vss-workfile
       85           ,input vss-revision
       86           ,input v-vssrevis-parameters
       87           ,input p-extra-paramters
       88           ).
       89       end.
       90     end.
       91   end procedure.
       92   assign
       93     v-vssrevis-logger = g#vssrevis-logger
       94   .
       95   if  valid-handle(v-vssrevis-logger)
       96   and v-vssrevis-logger :get-signature("logevent") <> ""
       97   then do:
       98     assign
       99       v-vssrevis-logevent = true
      100     .
      101     run vss-logevent in this-procedure (input vss-description) .
      102   end.
      103   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      104   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
      105   define variable gp-price-sale like ub.price-list.price-sale no-undo.
      106   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
      107   define variable gp-excise     like ub.price-list.excise     no-undo.
      108   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
      109   define variable gp-fact-order as decimal   no-undo .
      110   define variable gp-price-sale-parts as decimal   no-undo .
      111   define new global shared variable g#language as character no-undo .
      112   if g#language <> '' and g#language <> 'rus':U then do:
      113     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      114   end.
      115   define new global shared variable g#library  as handle no-undo .
      116   define new global shared variable g#library2 as handle no-undo .
      117   define   shared variable g#auto as logical no-undo.
      118   define   shared variable g#news as logical no-undo.
      119   define   shared variable g#oxml as logical no-undo.
      120   define   shared variable g#esys as logical no-undo.
      121   define   shared variable g#news-source-db as integer no-undo.
      122   define   shared variable g#esys-source-esys as integer no-undo.
      123   define   shared variable g#db-num as integer   no-undo .
      124   define   shared variable g#userid as character no-undo .
      125   define   shared variable g#passwd as character no-undo .
      126   FUNCTION calc-excise RETURNS DECIMAL(input  parprice-sale as decimal,
      127                                        input  parroad-tax   as decimal,
      128                                        input  parvat-pc     as decimal,
      129                                        input  parfactorrd   as decimal,
      130                                        output parexcise     as decimal):
      131   ASSIGN parexcise = (parprice-sale - parroad-tax) * parvat-pc / (100 + parvat-pc) -
      132                      1 / parfactorrd * parroad-tax.
      133   RETURN parexcise.
      134   END FUNCTION.
      135   function diff-list returns character (
      136     input parfirst-list  as character,
      137     input parsecond-list as character,
      138     input pardelim       as character).
      139     if pardelim = ""
      140     or pardelim = ?
      141     then do:
      142       assign
      143         pardelim = ","
      144       .
      145     end.
      146     def var ind as integer no-undo .
      147     def var v-elem as character no-undo .
      148     def var v-result-list as character no-undo init "".
      149     def var v-num-parfirst-list as integer no-undo .
      150     assign
      151       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      152     .
      153     do ind = 1 to v-num-parfirst-list
      154     :
      155       assign
      156         v-elem = entry(ind, parfirst-list, pardelim)
      157       .
      158       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      159         assign
      160           v-result-list = v-result-list
      161                         + (if v-result-list > "" then pardelim else "")
      162                         + v-elem
      163         .
      164       end.
      165     end.
      166     return v-result-list .
      167   end function.
      168   function add-list returns character (
      169    input parfirst-list  as character,
      170    input parsecond-list as character,
      171    input pardelim       as character).
      172     if pardelim = ""
      173     or pardelim = ?
      174     then do:
      175       assign
      176         pardelim = ","
      177       .
      178     end.
      179     def var ind as integer no-undo .
      180     def var v-elem as character no-undo .
      181     def var v-result-list as character no-undo init "".
      182     def var v-num-parfirst-list as integer no-undo .
      183     assign
      184       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      185     .
      186     do ind = 1 to v-num-parfirst-list
      187     :
      188       assign
      189         v-elem = entry(ind, parfirst-list, pardelim)
      190       .
      191       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      192         assign
      193           v-result-list = v-result-list
      194                         + (if v-result-list > "" then pardelim else "")
      195                         + v-elem
      196         .
      197       end.
      198     end.
      199     def var v-num-parsecond-list as integer no-undo .
      200     assign
      201       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      202     .
      203     do ind = 1 to v-num-parsecond-list
      204     :
      205       assign
      206         v-elem = entry(ind, parsecond-list, pardelim)
      207       .
      208       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      209         assign
      210           v-result-list = v-result-list
      211                         + (if v-result-list > "" then pardelim else "")
      212                         + v-elem
      213         .
      214       end.
      215     end.
      216     return v-result-list .
      217   end function.
      218   function cross-list returns character (
      219    input parfirst-list  as character,
      220    input parsecond-list as character,
      221    input pardelim       as character).
      222     if pardelim = ""
      223     or pardelim = ?
      224     then do:
      225       assign
      226         pardelim = ","
      227       .
      228     end.
      229     def var ind as integer no-undo .
      230     def var v-elem as character no-undo .
      231     def var v-result-list as character no-undo init "".
      232     def var v-num-parfirst-list as integer no-undo .
      233     assign
      234       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      235     .
      236     do ind = 1 to v-num-parfirst-list
      237     :
      238       assign
      239         v-elem = entry(ind, parfirst-list, pardelim)
      240       .
      241       if lookup(v-elem, v-result-list, pardelim) = 0
      242       and lookup(v-elem, parsecond-list, pardelim) > 0
      243       then do:
      244         assign
      245           v-result-list = v-result-list
      246                         + (if v-result-list > "" then pardelim else "")
      247                         + v-elem
      248         .
      249       end.
      250     end.
      251     return v-result-list .
      252   end function.
      253   function radio-label returns character (
      254    input par-rs-value  as character,
      255    input par-rs-radio-buttons as character)
      256    .
      257    DEFINE variable v-result-label as character no-undo.
      258    assign
      259    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      260                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      261                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      262                             ), par-rs-radio-buttons
      263                           )
      264    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      265    .
      266   return v-result-label.
      267   end function.
      268   function m-radio-label returns character (
      269    input par-rs-value  as character,
      270    input par-rs-radio-buttons as character,
      271    input par-delim as character
      272    )
      273    .
      274    DEFINE variable v-result-label as character no-undo.
      275    assign
      276    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      277                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      278                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      279                             ), par-rs-radio-buttons, par-delim
      280                           )
      281    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      282    .
      283   return v-result-label.
      284   end function.
      285   FUNCTION mixlist returns character
      286   (
      287    input parfirst-list  as character
      288    ,input parsecond-list as character
      289    ,input pardelim       as character
      290    ,input pardelim-result as character ) :
      291     if pardelim = ""
      292     or pardelim = ?
      293     then do:
      294       assign
      295         pardelim = ","
      296       .
      297     end.
      298     def var ind as integer no-undo .
      299     def var v-elem1 as character no-undo .
      300     def var v-elem2 as character no-undo .
      301     def var v-result-list as character no-undo init "".
      302     do ind = 1 to num-entries(parfirst-list, pardelim)
      303     :
      304       assign
      305         v-elem1 = entry(ind, parfirst-list, pardelim)
      306         v-elem2 = entry(ind, parsecond-list, pardelim)
      307       .
      308         assign
      309           v-result-list = v-result-list
      310                         + (if v-result-list > "" then pardelim-result else "")
      311                         + v-elem1 + pardelim-result + v-elem2
      312         .
      313     end.
      314     return v-result-list .
      315   END FUNCTION.
      316   define new global shared variable g#lib-trn  as handle no-undo .
      317   define new global shared variable g#lib-trn2 as handle no-undo .
      318   define new global shared variable g#lib-trn3 as handle no-undo .
      319   define new global shared variable g#lib-trn4 as handle no-undo .
      320   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      321   define new global shared variable g#trdcalib as handle no-undo.
      322   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      323   FUNCTION set-sale-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
      324   define variable v-ps as character no-undo .
      325   if available buf_sale-doc then
      326   assign
      327   v-PS = substitute('&1&2 &1&3&1Кол-во_чеков &4&1строк_чеков &5&1товаров &6&1признаков &7&1'
      328                       , chr(4)
      329                       , (if buf_sale-doc.chr-office = 'у':U then "УСЛУГИ." else "ТОВАРЫ." )
      330                       , entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
      331                       , buf_sale-doc.chk-amount
      332                       , buf_sale-doc.gds-amount
      333                       , buf_sale-doc.tot-lines
      334                       , buf_sale-doc.tot-dtl
      335                       ).
      336   else  do:
      337   assign
      338   v-PS = substitute('&1&2 &1&3&1Кол-во_чеков &4&1строк_чеков &5&1товаров &6&1признаков &7&1'
      339                       , chr(4)
      340                       , '':U
      341                       , entry (lookup ('es':U, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
      342                       , 0
      343                       , 0
      344                       , 0
      345                       , 0
      346                       ).
      347   end.
      348   return v-ps.
      349   END FUNCTION.
      350   FUNCTION get-sale-doc-kind returns character (
      351                                                input p-doc-kind as character
      352                                              , input p-ext-doc-type as character
      353                                              , output p-order as integer
      354                                              , output p-msign as integer
      355                                              , output p-main as logical
      356                                              , output p-in-inkas as logical
      357                                              , output p-dir_ as integer
      358                                              ):
      359   define variable v-doc-kind as character no-undo.
      360   define variable v-type as character no-undo .
      361   define variable v-value as character no-undo .
      362   CASE p-doc-kind:
      363     when 'es':U then do:
      364       assign
      365       p-order = 100
      366       p-msign = 1
      367       p-main = yes
      368       p-in-inkas = yes
      369       p-dir_ = 1
      370       .
      371       return p-ext-doc-type.
      372     end.
      373     when  'rs':U then do:
      374       assign
      375       p-order = 200
      376       p-msign = - 1
      377       p-main = no
      378       p-in-inkas = yes
      379       p-dir_ = - 1
      380       .
      381       return p-ext-doc-type.
      382     end.
      383     when 'rwo':U then do:
      384       assign
      385       p-msign = - 1
      386       p-main = no
      387       p-in-inkas = no
      388       p-order = 300
      389       p-dir_ = 1
      390       .
      391       return 'rwo':U.
      392     end.
      393     when 'trf':U then do:
      394       assign
      395       p-msign = 1
      396       p-main = no
      397       p-in-inkas = no
      398       p-order = 400
      399       p-dir_ = 1
      400       .
      401       return 'trf':U.
      402     end.
      403     when 'swo':U then do:
      404      assign
      405      p-msign = 1
      406      p-main = no
      407      p-in-inkas = no
      408      p-order =  500
      409      p-dir_ = 1
      410      .
      411      return 'swo':U.
      412    end.
      413    when 'vir':U then do:
      414      assign
      415      p-msign = 1
      416      p-main = no
      417      p-in-inkas = no
      418      p-order = 600
      419      p-dir_ = 1
      420      .
      421      return 'vir':U.
      422    end.
      423    when 'itr':U then do:
      424      assign
      425      p-msign = 1
      426      p-main = no
      427      p-in-inkas = no
      428      p-order = -1
      429      p-dir_ = -1
      430      .
      431     return 'itr':U.
      432    end.
      433    when 'ngs':U then do:
      434      assign
      435      p-msign = 1
      436      p-main = no
      437      p-in-inkas = no
      438      p-order = 700
      439      p-dir_ = 1
      440      .
      441      return 'ngs':U.
      442    end.
      443    when 'rgs':U then do:
      444      assign
      445      p-msign = -1
      446      p-main = no
      447      p-in-inkas = no
      448      p-order = 701
      449      p-dir_ = -1
      450      .
      451      return 'rgs':U.
      452    end.
      453    otherwise do:
      454       assign
      455       p-msign = 1
      456       p-main = no
      457       p-in-inkas = no
      458       p-order = -1.
      459       return p-ext-doc-type.
      460     end.
      461   END CASE.
      462   END FUNCTION.
      463   procedure saledoc-create :
      464   define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
      465   define input parameter p-host-code like ub.sysconf.host-code no-undo .
      466   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
      467   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
      468   define input parameter p-doc-kind as character no-undo .
      469   define input parameter p-office as character no-undo .
      470   define input parameter p-tpsidoc as logical no-undo .
      471   define input parameter p-alias-type-price as character no-undo .
      472   define input parameter p-price-obj-type as character no-undo .
      473   define input parameter p-price-obj-code as integer no-undo .
      474   define parameter buffer buf_trn-doc for ub.trn-doc.
      475   define variable v-order as integer no-undo.
      476   define variable v-main as logical no-undo .
      477   define variable v-in-inkas as logical no-undo .
      478   define variable v-msign as integer no-undo .
      479   define variable v-dir_ as integer no-undo .
      480   define variable v-trn-doc-code as character no-undo .
      481   define buffer buf_sale-doc for ub.sale-doc.
      482   main-block:
      483   do
      484   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      485   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      486   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      487   :
      488      if available buf_trn-doc then do:
      489        v-trn-doc-code = buf_trn-doc.doc-code.
      490      end.
      491      find first buf_sale-doc where
      492               buf_sale-doc.inkas-code = p-inkas-code
      493           and buf_sale-doc.doc-kind = p-doc-kind
      494           and buf_sale-doc.chr-office = p-office
      495           and (v-trn-doc-code = '' or buf_sale-doc.doc-code = v-trn-doc-code)
      496           no-error .
      497      if not available buf_sale-doc  then do:
      498         create buf_sale-doc.
      499         assign
      500         buf_sale-doc.inkas-code = p-inkas-code
      501         buf_sale-doc.storage =  'trn-doc':U
      502         buf_sale-doc.host-code = p-host-code
      503         buf_sale-doc.obj-type = p-obj-type
      504         buf_sale-doc.obj-code = p-obj-code
      505         buf_sale-doc.doc-kind  = p-doc-kind
      506         buf_sale-doc.order = lookup(p-doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) * 100 + (if p-office = 'у':U then 5 else 0)
      507         buf_sale-doc.chr-office = p-office
      508         buf_sale-doc.doc-code = v-trn-doc-code
      509         .
      510      end.
      511      if available buf_trn-doc then
      512      buffer-copy buf_trn-doc
      513      to buf_sale-doc
      514      .
      515     assign
      516     buf_sale-doc.doc-kind = get-sale-doc-kind (
      517                                                input p-doc-kind
      518                                               ,input buf_sale-doc.ext-doc-type
      519                                               ,output v-order
      520                                               ,output v-msign
      521                                               ,output v-main
      522                                               ,output v-in-inkas
      523                                               ,output v-dir_).
      524     assign
      525     buf_sale-doc.order = v-order + (if p-office = 'у':U then 5 else 0)
      526     buf_sale-doc.main-doc = v-main
      527     buf_sale-doc.in-inkas = v-in-inkas
      528     buf_sale-doc.msign = v-msign
      529     buf_sale-doc.dir = v-dir_
      530     buf_sale-doc.fbrsale = lookup(buf_sale-doc.doc-kind, 'es,swo':U) > 0
      531     buf_sale-doc.main-receipt-type = integer(entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) + 1, '0,1,6,96,17,69,17,17':U))
      532     buf_sale-doc.poss-wro-codes = '':U
      533     buf_sale-doc.chr-office = p-office
      534     buf_sale-doc.tpsidoc = p-tpsidoc
      535     buf_sale-doc.alias-type-price = p-alias-type-price
      536     buf_sale-doc.price-obj-type = (if p-tpsidoc
      537                                    then p-price-obj-type
      538                                    else '':U)
      539     buf_sale-doc.price-obj-code = (if p-tpsidoc
      540                                    then p-price-obj-code
      541                                    else 0)
      542     .
      543     assign
      544     buf_sale-doc.poss-wro-codes = (if (v-order > 0 and buf_sale-doc.doc-kind <> 'vir':U) then entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) + 1, '0,2,-2,-6;-3;-9;-4,17,1;3':U) else '':U)
      545     no-error.
      546   end.
      547   END.
      548   procedure fbr-saledoc-create :
      549   define input parameter p-inkas-code as character no-undo .
      550   define variable v-pri-prvo-doc-qnty like ub.trn-doc.doc-qnty no-undo .
      551   define variable v-pri-prvo-fact-qnty like ub.trn-doc.doc-qnty no-undo .
      552   define variable v-pri-prvo-tot-lines like ub.trn-doc.tot-lines no-undo .
      553   define buffer buf_fbr-doc for ub.fbr-doc.
      554   define buffer buf_trn-doc for ub.trn-doc.
      555   define buffer buf_sale-doc for ub.sale-doc.
      556   define buffer buf2_sale-doc for ub.sale-doc.
      557   define buffer buf2_trn-doc for ub.trn-doc.
      558   define buffer buf_doc-line for ub.doc-line.
      559   define buffer buf_gds-dtl for ub.gds-dtl.
      560   define buffer buf_chk-gds for ub.chk-gds.
      561   define buffer buf_chk-doc for ub.chk-doc.
      562   do
      563   on error undo, return error
      564   :
      565     for each buf_fbr-doc no-lock where
      566           buf_fbr-doc.out-code = p-inkas-code:
      567       for each buf_trn-doc no-lock where
      568             buf_trn-doc.out-code = buf_fbr-doc.doc-code
      569       by buf_trn-doc.fact-order
      570       on error undo, return error:
      571         if buf_trn-doc.ext-doc-type = 'em':U
      572         or buf_trn-doc.ext-doc-type = 'im':U
      573         or buf_trn-doc.ext-doc-type = 'wm':U
      574         or buf_trn-doc.ext-doc-type = 'ev':U
      575         or buf_trn-doc.ext-doc-type = 'iv':U
      576         then do:
      577           find first buf_sale-doc where
      578                   buf_sale-doc.inkas-code = p-inkas-code
      579               and buf_sale-doc.doc-code = buf_trn-doc.doc-code
      580               AND buf_sale-doc.storage  = 'trn-doc':U
      581                   no-error .
      582           if not available buf_sale-doc then do:
      583           create buf_sale-doc.                                                                                             buffer-copy buf_trn-doc                                                                                             to buf_sale-doc.                                                                                                assign                                                                                                                  buf_sale-doc.storage  =  'trn-doc':U                                                                          buf_sale-doc.doc-kind = buf_trn-doc.ext-doc-type                                                                buf_sale-doc.order =  - 1                                                                                          buf_sale-doc.main-doc = no                                                                                             buf_sale-doc.in-inkas = no                                                                                         buf_sale-doc.fbrsale = yes                                                                                         buf_sale-doc.msign = 1                                                                                             buf_sale-doc.filled   = buf_sale-doc.fact-qnty <> 0 or buf_sale-doc.tot-lines <> 0                       buf_sale-doc.doc-qnty = (if buf_sale-doc.ext-doc-type = 'pc':U                                                           then ?                                                                                                                  else buf_sale-doc.doc-qnty)                                                          buf_sale-doc.fact-qnty = (if buf_sale-doc.ext-doc-type = 'pc':U                                                          then ?                                                                                                                  else buf_sale-doc.fact-qnty)                                                        buf_sale-doc.inkas-code = p-inkas-code.
      584           end.
      585           if buf_trn-doc.ext-doc-type = 'im':U then do:
      586             assign
      587             v-pri-prvo-doc-qnty = buf_trn-doc.doc-qnty
      588             v-pri-prvo-fact-qnty = buf_trn-doc.fact-qnty
      589             v-pri-prvo-tot-lines = buf_trn-doc.tot-lines
      590             .
      591           end.
      592           for each buf2_trn-doc no-lock where
      593                   buf2_trn-doc.out-code = buf_sale-doc.doc-code:
      594             find first buf2_sale-doc where
      595                     buf2_sale-doc.inkas-code = p-inkas-code
      596                 and buf2_sale-doc.doc-code = buf2_trn-doc.doc-code
      597                 AND buf2_sale-doc.storage = 'trn-doc':U no-error .
      598             if not available buf2_sale-doc then do:
      599               create buf2_sale-doc.                                                                                             buffer-copy buf2_trn-doc                                                                                             to buf2_sale-doc.                                                                                                assign                                                                                                                  buf2_sale-doc.storage  =  'trn-doc':U                                                                          buf2_sale-doc.doc-kind = buf2_trn-doc.ext-doc-type                                                                buf2_sale-doc.order =  - 1                                                                                          buf2_sale-doc.main-doc = no                                                                                             buf2_sale-doc.in-inkas = no                                                                                         buf2_sale-doc.fbrsale = yes                                                                                         buf2_sale-doc.msign = 1                                                                                             buf2_sale-doc.filled   = buf2_sale-doc.fact-qnty <> 0 or buf2_sale-doc.tot-lines <> 0                       buf2_sale-doc.doc-qnty = (if buf2_sale-doc.ext-doc-type = 'pc':U                                                           then ?                                                                                                                  else buf2_sale-doc.doc-qnty)                                                          buf2_sale-doc.fact-qnty = (if buf2_sale-doc.ext-doc-type = 'pc':U                                                          then ?                                                                                                                  else buf2_sale-doc.fact-qnty)                                                        buf2_sale-doc.inkas-code = p-inkas-code.
      600             end.
      601           end.
      602         end.
      603       end.
      604       find first buf_sale-doc where
      605                 buf_sale-doc.inkas-code = p-inkas-code
      606             AND buf_sale-doc.storage = 'fbr-doc':U
      607             AND buf_sale-doc.doc-code = buf_fbr-doc.doc-code no-error .
      608       if not available buf_sale-doc then do:
      609         create buf_sale-doc.
      610         assign
      611         buf_sale-doc.storage       =  'fbr-doc':U
      612         buf_sale-doc.doc-type      = 'производство':U
      613         buf_sale-doc.doc-code      = buf_fbr-doc.doc-code
      614         buf_sale-doc.ext-doc-type  = 'производство':U
      615         buf_sale-doc.doc-kind      = 'производство':U
      616         buf_sale-doc.obj-type      = buf_fbr-doc.obj-type
      617         buf_sale-doc.obj-code      = buf_fbr-doc.obj-code
      618         buf_sale-doc.cli-type      = buf_fbr-doc.obj-type
      619         buf_sale-doc.cli-code      = buf_fbr-doc.obj-code
      620         buf_sale-doc.doc-qnty      = v-pri-prvo-doc-qnty
      621         buf_sale-doc.fact-qnty     = v-pri-prvo-fact-qnty
      622         buf_sale-doc.tot-lines     = v-pri-prvo-tot-lines
      623         buf_sale-doc.tot-dtl       = v-pri-prvo-tot-lines
      624         buf_sale-doc.fbrsale       = yes
      625         buf_sale-doc.inkas-code    = p-inkas-code
      626         .
      627       end.
      628     end.
      629   end.
      630   end procedure.
      631   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      632   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
      633   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
      634     field cst-code                like ub.trn-doc.cst-code
      635     field part-code               like ub.parts.part-code
      636     .
      637   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
      638   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
      639   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
      640   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      641   FUNCTION set-inkas-PS returns character(    input p-ps as character,
      642                                               input p-chk-amount as integer,
      643                                               input p-gds-amount as integer,
      644                                               input p-line-out as integer,
      645                                               input p-dtl-out as integer,
      646                                               input p-line-ret as integer,
      647                                               input p-dtl-ret as integer,
      648                                               input p-nf-chk-amount as integer,
      649                                               input p-nf-gds-amount as integer,
      650                                               input p-ps-where-rus as character
      651                                               ):
      652   define variable v-ps as character no-undo .
      653   define variable v-other as character no-undo .
      654   v-other = p-ps.
      655   entry(1, v-other, "@") = ''.
      656   v-other = trim(v-other, "@").
      657   v-PS = substitute('Кол-во_чеков &2&1строк_чеков &3&1товаров_расход &4&1признаков_расход &5&1товаров_возврат &6&1признаков_возврат &7&1'
      658                       , chr(4)
      659                       , p-chk-amount
      660                       , p-gds-amount
      661                       , p-line-out
      662                       , p-dtl-out
      663                       , p-line-ret
      664                       , p-dtl-ret).
      665   v-ps = v-ps +  substitute("без_докум_чеков &1&2без_докум_строк_чеков &3&2&4@&5"
      666                               , p-nf-chk-amount
      667                               , chr(4)
      668                               , p-nf-gds-amount
      669                               , p-ps-where-rus
      670                               , v-other)
      671                       .
      672   return v-ps.
      673   END FUNCTION.
      674   FUNCTION set-inkas-PS-simple returns character(
      675                                               input p-chk-amount as integer,
      676                                               input p-gds-amount as integer,
      677                                               input p-line-out as integer,
      678                                               input p-dtl-out as integer,
      679                                               input p-line-ret as integer,
      680                                               input p-dtl-ret as integer,
      681                                               input p-nf-chk-amount as integer,
      682                                               input p-nf-gds-amount as integer
      683                                               ):
      684   define variable v-ps as character no-undo .
      685   define variable v-str1 as character no-undo .
      686   assign
      687     v-ps = fill( chr(32) +  chr(4), 9).
      688     v-str1 = ENTRY(1, v-PS, chr(4)).
      689     entry(2, v-str1, chr(32))  = string(p-chk-amount).
      690     ENTRY(1, v-PS, chr(4)) = v-str1.
      691     v-str1 = ENTRY(2, v-PS, chr(4)).
      692     entry(2, v-str1, chr(32))  = string(p-gds-amount).
      693     ENTRY(2, v-PS, chr(4)) = v-str1.
      694     v-str1 = ENTRY(3, v-PS, chr(4)).
      695     entry(2, v-str1, chr(32))  = string(p-line-out).
      696     ENTRY(3, v-PS, chr(4)) = v-str1.
      697     v-str1 = ENTRY(4, v-PS, chr(4)).
      698     entry(2, v-str1, chr(32))  = string(p-dtl-out).
      699     ENTRY(4, v-PS, chr(4)) = v-str1.
      700     v-str1 = ENTRY(5, v-PS, chr(4)).
      701     entry(2, v-str1, chr(32))  = string(p-line-ret).
      702     ENTRY(5, v-PS, chr(4)) = v-str1.
      703     v-str1 = ENTRY(6, v-PS, chr(4)).
      704     entry(2, v-str1, chr(32))  = string(p-dtl-ret).
      705     ENTRY(5, v-PS, chr(4)) = v-str1.
      706     v-str1 = ENTRY(7, v-PS, chr(4)).
      707     entry(2, v-str1, chr(32))  = string(p-nf-chk-amount).
      708     ENTRY(5, v-PS, chr(4)) = v-str1.
      709     v-str1 = ENTRY(8, v-PS, chr(4)).
      710     entry(2, v-str1, chr(32))  = string(p-nf-gds-amount).
      711     ENTRY(5, v-PS, chr(4)) = v-str1.
      712   return v-ps.
      713   END FUNCTION.
      714   FUNCTION get-inkas-nf-PS-simple returns logical (
      715                                                input p-ps as character
      716                                               ,output p-gds-amount as integer
      717                                               ,output p-nf-gds-amount as integer
      718                                               ):
      719   if num-entries(p-ps, chr(4)) >= 8 then do:
      720     assign
      721     p-gds-amount = integer(entry(2, ENTRY(2, p-PS, chr(4)), chr(32)))
      722     p-nf-gds-amount = integer(entry(2, ENTRY(8, p-PS, chr(4)), chr(32)))
      723     no-error .
      724   end.
      725   return not error-status:error .
      726   END FUNCTION.
      727   PROCEDURE get-inkas-PS:
      728   define parameter buffer buf_inkas for ub.inkas.
      729   define output parameter p-chk-amount as integer no-undo .
      730   define output parameter p-gds-amount as integer no-undo .
      731   define output parameter p-line-out as integer no-undo .
      732   define output parameter p-dtl-out as integer no-undo .
      733   define output parameter p-line-ret as integer no-undo .
      734   define output parameter p-dtl-ret as integer no-undo .
      735   define output parameter p-nf-chk-amount as integer no-undo .
      736   define output parameter p-nf-gds-amount as integer no-undo .
      737   define output parameter p-ps-where-rus as character no-undo .
      738   define variable v-gds-amount as integer no-undo .
      739   define variable v-nf-gds-amount as integer no-undo .
      740   define buffer buf_sale-doc for ub.sale-doc.
      741   for each buf_sale-doc no-lock where
      742           buf_sale-doc.inkas-code = buf_inkas.inkas-code
      743       and buf_sale-doc.order > 0:
      744     assign
      745     p-gds-amount = p-gds-amount + (if buf_sale-doc.in-inkas = yes
      746                                    or buf_sale-doc.doc-kind = 'trf':U
      747                                    then buf_sale-doc.gds-amount
      748                                    else 0)
      749     p-line-out = p-line-out  + (if buf_sale-doc.in-inkas = yes
      750                                 and buf_sale-doc.dir = 1
      751                                 then buf_sale-doc.tot-lines
      752                                 else 0)
      753     p-dtl-out = p-dtl-out + (if buf_sale-doc.in-inkas = yes
      754                             and buf_sale-doc.dir = 1
      755                             then buf_sale-doc.tot-dtl
      756                             else 0)
      757     p-line-ret = p-line-ret  + (if buf_sale-doc.in-inkas = yes
      758                                 and buf_sale-doc.dir = -1
      759                                 then buf_sale-doc.tot-lines
      760                                 else 0)
      761     p-dtl-ret = p-dtl-ret + (if buf_sale-doc.in-inkas = yes
      762                              and buf_sale-doc.dir = -1
      763                             then buf_sale-doc.tot-dtl
      764                             else 0)
      765     .
      766   end.
      767   if get-inkas-nf-PS-simple( input buf_inkas.ps
      768                             ,output v-gds-amount
      769                             ,output v-nf-gds-amount) then do:
      770     assign
      771     p-gds-amount = v-gds-amount
      772     p-nf-gds-amount = v-nf-gds-amount
      773     .
      774   end.
      775   assign
      776   p-ps-where-rus = buf_inkas.sale-filter-rus
      777   p-nf-chk-amount = buf_inkas.num-chk-nf
      778   p-chk-amount = buf_inkas.num-chk
      779   .
      780   END PROCEDURE.
      781   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      782   define SHARED temp-table tt0-info no-undo
      783   field doc-code   like ub.trn-doc.doc-code
      784   field artic      like ub.doc-line.artic
      785   field prod-type  like ub.doc-line.prod-type
      786   field prod-code  like ub.doc-line.prod-code
      787   field prt-code  like ub.gds-dtl.prt-code
      788   field obj-type   like ub.doc-line.obj-type
      789   field obj-code   like ub.doc-line.obj-code
      790   field error-message as character
      791   field a-to-res as decimal
      792   field was-res as decimal
      793   field to-res as decimal
      794   field is-res as decimal
      795   field o-was-res as decimal
      796   field o-to-res as decimal
      797   field o-is-res as decimal
      798   index pi is unique primary
      799   obj-type
      800   obj-code
      801   artic
      802   prod-type
      803   prod-code
      804   index iartic
      805   artic
      806   prod-type
      807   prod-code
      808   .
      809   define SHARED temp-table tt0-doc-line no-undo like lib-trn_ret-line.
      810   define SHARED temp-table tt0-gds-dtl  no-undo like ub.gds-dtl.
      811   define SHARED temp-table tt0-parts    no-undo like ub.parts.
      812   define SHARED temp-table temp-tpsi-clients  no-undo like ub.clients.
      813   FUNCTION set-tpsi-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
      814   define variable v-ps as character no-undo .
      815   assign
      816   v-PS = substitute('@&1 для закрытия продажи &2 на &3&4&5товаров &6&5признаков &7'
      817                     , entry (lookup (buf_sale-doc.ext-doc-type, 'ee,ev,ie,es,iv':U), 'Межфирм.расход по ТПСИ,Внутр.расход по ТПСИ,Межфирм.приход по ТПСИ,Внутр.приход по ТПСИ':U)
      818                     , buf_sale-doc.out-code
      819                     , buf_sale-doc.obj-type
      820                     , buf_sale-doc.obj-code
      821                     , chr(4)
      822                     , buf_sale-doc.tot-lines
      823                     , buf_sale-doc.tot-dtl
      824                     ).
      825   return v-Ps.
      826   END FUNCTION.
      827   procedure create-tt0-doc-line-gds-dtl :
      828   define input parameter p-proprietor-obj-type like ub.trn-doc.obj-type no-undo .
      829   define input parameter p-proprietor-obj-code like ub.trn-doc.obj-code no-undo .
      830   define input parameter p-ext-doc-type        as character no-undo .
      831   define input parameter p-doc-code            like ub.trn-doc.doc-code no-undo .
      832   define input parameter p-artic               like ub.gds-dtl.artic no-undo .
      833   define input parameter p-prod-type           like ub.gds-dtl.prod-type no-undo .
      834   define input parameter p-prod-code           like ub.gds-dtl.prod-code no-undo .
      835   define input parameter p-prt-code            like ub.gds-dtl.prt-code  no-undo .
      836   define input parameter p-fact-qnty           like ub.gds-dtl.fact-qnty no-undo .
      837   define output parameter p-was-gds-dtl-doc-qnty  like ub.gds-dtl.fact-qnty no-undo .
      838   define output parameter p-gds-dtl-fact-qnty  like ub.gds-dtl.fact-qnty no-undo .
      839   define parameter buffer b-doc-line           for ub.doc-line.
      840   define parameter buffer b-gds-dtl            for ub.gds-dtl.
      841   define parameter buffer buf_sale-doc for ub.sale-doc.
      842   define variable old-qnty like ub.doc-line.fact-qnty no-undo .
      843   define buffer other_doc-line for ub.doc-line.
      844   define buffer other_gds-dtl for ub.gds-dtl.
      845     do
      846     on error undo, return error return-value
      847     :
      848       find first tt0-doc-line where
      849                 tt0-doc-line.obj-type = p-proprietor-obj-type
      850             AND tt0-doc-line.obj-code = p-proprietor-obj-code
      851             AND tt0-doc-line.prod-type = p-prod-type
      852             AND tt0-doc-line.prod-code = p-prod-code
      853             AND tt0-doc-line.artic     = p-artic
      854             AND tt0-doc-line.ext-doc-type = p-ext-doc-type
      855             AND tt0-doc-line.status_      = 'нередакт':U no-error .
      856       if not available tt0-doc-line then do:
      857         create tt0-doc-line.
      858         buffer-copy b-doc-line
      859         except
      860         obj-type obj-code doc-code status_ ext-doc-type doc-qnty fact-qnty
      861         to tt0-doc-line
      862         assign
      863         tt0-doc-line.status_ = 'нередакт':U
      864         tt0-doc-line.ext-doc-type = p-ext-doc-type
      865         tt0-doc-line.obj-type = p-proprietor-obj-type
      866         tt0-doc-line.obj-code = p-proprietor-obj-code
      867         tt0-doc-line.doc-code = p-doc-code
      868         .
      869       end.
      870       if p-doc-code <> "":U then do:
      871         find first other_doc-line no-lock where
      872                 other_doc-line.doc-code = p-doc-code
      873             AND  other_doc-line.artic    = p-artic
      874             AND  other_doc-line.prod-type = p-prod-type
      875             AND  other_doc-line.prod-code = p-prod-code no-error .
      876         if available other_doc-line then do:
      877           find first buf_sale-doc where buf_sale-doc.doc-code = other_doc-line.doc-code.
      878           assign
      879           tt0-doc-line.doc-qnty = other_doc-line.doc-qnty
      880           .
      881         end.
      882         else do:
      883           assign
      884           tt0-doc-line.doc-code = '':U
      885           .
      886         end.
      887       end.
      888       find first tt0-gds-dtl where
      889               tt0-gds-dtl.obj-type = p-proprietor-obj-type
      890           AND tt0-gds-dtl.obj-code = p-proprietor-obj-code
      891           AND tt0-gds-dtl.prod-type = p-prod-type
      892           AND tt0-gds-dtl.prod-code = p-prod-code
      893           AND tt0-gds-dtl.artic     = p-artic
      894           AND tt0-gds-dtl.prt-code  = p-prt-code  no-error .
      895       if not available tt0-gds-dtl then do:
      896         create tt0-gds-dtl.
      897         buffer-copy b-gds-dtl
      898         except
      899         obj-type obj-code doc-code doc-qnty fact-qnty
      900         to tt0-gds-dtl
      901         assign
      902         tt0-gds-dtl.obj-type = p-proprietor-obj-type
      903         tt0-gds-dtl.obj-code = p-proprietor-obj-code
      904         tt0-gds-dtl.doc-code = p-doc-code
      905         .
      906       end.
      907       if p-doc-code <> "":U then do:
      908           find first other_gds-dtl no-lock where
      909                   other_gds-dtl.doc-code = p-doc-code
      910               AND  other_gds-dtl.artic    = p-artic
      911               AND  other_gds-dtl.prod-type    = p-prod-type
      912               AND  other_gds-dtl.prod-code    = p-prod-code
      913               AND  other_gds-dtl.prt-code    = p-prt-code no-error .
      914           if available other_gds-dtl then do:
      915             assign
      916             tt0-gds-dtl.doc-qnty = other_gds-dtl.doc-qnty
      917             .
      918           end.
      919           else do:
      920             assign
      921             tt0-gds-dtl.doc-code = '':U
      922             .
      923           end.
      924       end.
      925       assign
      926       old-qnty = tt0-gds-dtl.doc-qnty
      927       tt0-gds-dtl.fact-qnty = (if p-fact-qnty = ? then (- old-qnty) else (p-fact-qnty - tt0-gds-dtl.doc-qnty))
      928       tt0-doc-line.fact-qnty = tt0-doc-line.fact-qnty + (if p-fact-qnty = ? then (- old-qnty) else p-fact-qnty)
      929       p-gds-dtl-fact-qnty = tt0-gds-dtl.fact-qnty
      930       p-was-gds-dtl-doc-qnty = tt0-gds-dtl.doc-qnty
      931       .
      932     end.
      933   end procedure.
      934   procedure fill-tt-tpsi-table :
      935   define input parameter p-doc-code  like ub.trn-doc.doc-code  no-undo .
      936   define input parameter p-host-code like ub.trn-doc.host-code no-undo .
      937   define input parameter p-obj-type  like ub.trn-doc.obj-type  no-undo .
      938   define input parameter p-obj-code  like ub.trn-doc.obj-code  no-undo .
      939   define variable v-proprietor-host-code      like ub.clients.host-code no-undo .
      940   define variable v-proprietor-obj-type       like ub.clients.obj-type no-undo .
      941   define variable v-proprietor-obj-code       like ub.clients.obj-code no-undo .
      942   define variable v-ext-doc-type              like ub.trn-doc.ext-doc-type no-undo .
      943   define variable v-gds-dtl-fact-qnty         like ub.gds-dtl.fact-qnty no-undo .
      944   define variable v-was-gds-dtl-fact-qnty     like ub.gds-dtl.fact-qnty no-undo .
      945   define buffer buf_goods for ub.goods.
      946   define buffer buf_doc-line for ub.doc-line.
      947   define buffer buf_gds-dtl for ub.gds-dtl.
      948   define buffer buf_sale-doc for ub.sale-doc.
      949     do
      950     on error undo, return error
      951     :
      952       _doc-line:
      953       for each buf_Doc-line no-lock where
      954             buf_doc-line.doc-code = p-doc-code,
      955         first buf_goods no-lock where
      956             buf_goods.artic = buf_doc-line.artic
      957        AND  buf_goods.prod-type  = buf_doc-line.prod-type
      958        AND  buf_goods.prod-code  = buf_doc-line.prod-code,
      959           each buf_gds-dtl no-lock where
      960             buf_gds-dtl.doc-code = buf_doc-line.doc-code
      961         AND  buf_gds-dtl.artic    = buf_doc-line.artic
      962         AND  buf_gds-dtl.prod-type = buf_doc-line.prod-type
      963         AND  buf_gds-dtl.prod-code = buf_doc-line.prod-code:
      964         assign
      965         v-ext-doc-type = "":U.
      966         run tpsi-preselect-gds-proprietor in this-procedure (
      967                                                     input buf_goods.gds-code
      968                                                   ,input g#db-num
      969                                                   ,output v-proprietor-host-code
      970                                                   ,output v-proprietor-obj-type
      971                                                   ,output v-proprietor-obj-code ) no-error .
      972         if v-proprietor-host-code = p-host-code then do:
      973           assign
      974           v-ext-doc-type = 'ev':U .
      975         end.
      976         else do:
      977           assign
      978           v-ext-doc-type =  'ee':U .
      979         end.
      980         if  (v-proprietor-obj-type = p-obj-type
      981         AND v-proprietor-obj-code = p-obj-code)
      982         OR (v-proprietor-obj-type = "":U
      983         AND v-proprietor-obj-code = 0)
      984         OR v-proprietor-obj-code = ?
      985         then next _doc-line.
      986         find first buf_sale-doc no-lock where
      987                   buf_sale-doc.inkas-code = p-doc-code
      988              AND buf_sale-doc.obj-type = v-proprietor-obj-type
      989              AND buf_sale-doc.obj-code = v-proprietor-obj-code
      990              AND buf_sale-doc.ext-doc-type = v-ext-doc-type
      991              no-error .
      992         run create-tt0-doc-line-gds-dtl  in this-procedure (
      993                                                              input v-proprietor-obj-type
      994                                                             ,input v-proprietor-obj-code
      995                                                             ,input v-ext-doc-type
      996                                                             ,input (if available buf_sale-doc then buf_sale-doc.doc-code else "":U)
      997                                                             ,input buf_doc-line.artic
      998                                                             ,input buf_Doc-line.prod-type
      999                                                             ,input buf_doc-line.prod-code
     1000                                                             ,input buf_gds-dtl.prt-code
     1001                                                             ,input 0
     1002                                                             ,output v-was-gds-dtl-fact-qnty
     1003                                                             ,output v-gds-dtl-fact-qnty
     1004                                                             ,buffer buf_doc-line
     1005                                                             ,buffer buf_gds-dtl
     1006                                                             ,buffer buf_sale-doc
     1007                                                           ).
     1008       end.
     1009     end.
     1010   end procedure.
     1011   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1012   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1013   procedure get-alias-type-price-obj :
     1014   define input parameter p-host-code like ub.sysconf.host-code no-undo .
     1015   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
     1016   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
     1017   define input parameter p-prop-host-code like ub.sysconf.host-code no-undo .
     1018   define input parameter p-prop-obj-type  like ub.clients.obj-type no-undo .
     1019   define input parameter p-prop-obj-code  like ub.clients.obj-code no-undo .
     1020   define output parameter p-ext-doc-type like ub.trn-doc.ext-doc-type no-undo .
     1021   define output parameter p-alias-type-price as character no-undo .
     1022   define output parameter p-price-obj-type like ub.clients.obj-type no-undo .
     1023   define output parameter p-price-obj-code like ub.clients.obj-code no-undo .
     1024   define variable v-mediat-obj-type           like ub.trn-doc.obj-type no-undo .
     1025   define variable v-mediat-obj-code           like ub.trn-doc.obj-code no-undo .
     1026   define variable v-mediat-objf               as character no-undo .
     1027   define variable v-param-type as character no-undo .
     1028   define variable v-value-character as character no-undo .
     1029   define variable v-value-date as date no-undo .
     1030   define variable v-value-decimal as decimal no-undo .
     1031   define variable v-value-integer as INTEGER no-undo .
     1032   define variable v-value-logical AS LOGICAL no-undo .
     1033   define variable v-tth as handle no-undo .
     1034   assign
     1035   v-tth = buffer thbjattr_thbj-attr:table-handle .
     1036   define buffer buf_trn-doc for ub.trn-doc.
     1037     _main:
     1038     do
     1039     on error undo, return error return-value
     1040     :
     1041       run adm/shattri.p (
     1042         input "get":U
     1043         ,input  p-prop-obj-type
     1044         ,input  p-prop-obj-code
     1045         ,input  'alias-tpsi':U
     1046         ,input  '':U
     1047         ,output v-value-character
     1048         ,output v-value-date
     1049         ,output v-value-decimal
     1050         ,output v-value-integer
     1051         ,output v-value-logical
     1052         ,output v-param-type
     1053         ,INPUT-OUTPUT table-handle v-tth
     1054         ) no-error .
     1055       if error-status:error
     1056       then do:
     1057         undo _main, return error substitute("Не удалось определить настройки МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
     1058                                 , p-prop-obj-type
     1059                                 , p-prop-obj-code).
     1060       end.
     1061       find first thbjattr_thbj-attr where
     1062                 thbjattr_thbj-attr.obj-type = p-prop-obj-type
     1063             and thbjattr_thbj-attr.obj-code = p-prop-obj-code
     1064             and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
     1065             and thbjattr_thbj-attr.prop-code = 'alias-type-price':U no-error.
     1066       if not available thbjattr_thbj-attr
     1067       or thbjattr_thbj-attr.property-value-integer = 0 then do:
     1068         undo _main, return error substitute("Не задано значение атрибута ТИП ЦЕНЫ МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
     1069                                 , p-prop-obj-type
     1070                                 , p-prop-obj-code).
     1071       end.
     1072       assign
     1073       p-alias-type-price = string(thbjattr_thbj-attr.property-value-integer).
     1074       if p-prop-host-code = p-host-code
     1075       and (p-alias-type-price = '':U
     1076       or   p-alias-type-price <> '5':U)
     1077       then  do:
     1078         assign
     1079         p-ext-doc-type = 'ev':U
     1080         p-price-obj-type = p-obj-type
     1081         p-price-obj-code = p-obj-code
     1082         p-alias-type-price = '3':U
     1083         .
     1084       end.
     1085       else do:
     1086         if p-prop-host-code = p-host-code  then do:
     1087           assign
     1088           p-ext-doc-type = 'ev':U
     1089           p-price-obj-type = p-obj-type
     1090           p-price-obj-code = p-obj-code
     1091           .
     1092         end.
     1093         else do:
     1094           assign
     1095           p-ext-doc-type = 'ee':U.
     1096           assign
     1097           v-mediat-obj-type = "":U
     1098           v-mediat-obj-code = 0
     1099           v-mediat-objf = "":U
     1100           .
     1101           if p-alias-type-price = '4':U then do:
     1102             find first thbjattr_thbj-attr where
     1103                       thbjattr_thbj-attr.obj-type = p-prop-obj-type
     1104                   and thbjattr_thbj-attr.obj-code = p-prop-obj-code
     1105                   and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
     1106                   and thbjattr_thbj-attr.prop-code = 'alias-object-price':U no-error.
     1107             if not available thbjattr_thbj-attr
     1108             or thbjattr_thbj-attr.property-value-character = "":U then do:
     1109               undo _main, return error substitute("Не найден объект-посредник для межфирменного перемещения ЧУЖИХ товаров с &1&2"
     1110                                       , p-prop-obj-type
     1111                                       , p-prop-obj-code).
     1112             end.
     1113             assign
     1114             v-mediat-objf     = thbjattr_thbj-attr.property-value-character
     1115             v-mediat-obj-type = entry(1, v-mediat-objf)
     1116             v-mediat-obj-code = integer(entry(2, v-mediat-objf))
     1117             no-error
     1118             .
     1119             if error-status:error then do:
     1120               undo _main, return error substitute("Неверный формат атрибута ОБЪЕКТ-ПОСРЕДНИК для межфирменного перемещения ЧУЖИХ товаров для &1&2"
     1121                                       , p-prop-obj-type
     1122                                       , p-prop-obj-code).
     1123             end.
     1124           end.
     1125           CASE p-alias-type-price:
     1126             when '1':U then do:
     1127               assign
     1128               p-price-obj-type = p-prop-obj-type
     1129               p-price-obj-code = p-prop-obj-code
     1130               .
     1131             end.
     1132             when '2':U then do:
     1133               assign
     1134               p-price-obj-type = p-prop-obj-type
     1135               p-price-obj-code = p-prop-obj-code
     1136               .
     1137             end.
     1138             when '3':U
     1139             or
     1140             when '5':U
     1141             then do:
     1142               assign
     1143               p-price-obj-type = p-obj-type
     1144               p-price-obj-code = p-obj-code
     1145               .
     1146             end.
     1147             when '4':U then do:
     1148               assign
     1149               p-price-obj-type = v-mediat-obj-type
     1150               p-price-obj-code = v-mediat-obj-code
     1151               .
     1152             end.
     1153           END CASE.
     1154         end.
     1155       end.
     1156     end.
     1157   end procedure.
     1158   procedure write-tt0-info:
     1159   define input parameter p-artic as character no-undo .
     1160   define input parameter p-prod-type as character no-undo .
     1161   define input parameter p-prod-code as integer no-undo .
     1162   define input parameter p-prt-code as integer no-undo .
     1163   define input parameter p-obj-type as character no-undo .
     1164   define input parameter p-obj-code as integer no-undo .
     1165   define input parameter p-doc-code as character no-undo .
     1166   define input parameter p-from-tpsi as logical no-undo .
     1167   define input parameter p-all-qnty as decimal no-undo .
     1168   define input parameter p-was-res as decimal no-undo .
     1169   define input parameter p-to-res as decimal no-undo .
     1170   define input parameter p-is-res as decimal no-undo .
     1171   define input parameter p-o-was-res as decimal no-undo .
     1172   define input parameter p-o-to-res as decimal no-undo .
     1173   define input parameter p-o-is-res as decimal no-undo .
     1174   define input parameter p-mess   as character no-undo .
     1175   define buffer buf_tt0-info for tt0-info.
     1176     do
     1177     on error undo, return error return-value
     1178     :
     1179       find first buf_tt0-info where
     1180                buf_tt0-info.artic = p-artic
     1181            and buf_tt0-info.prod-type = p-prod-type
     1182            and buf_tt0-info.prod-code = p-prod-code
     1183            and buf_tt0-info.prt-code = p-prt-code
     1184            no-error .
     1185       if not available buf_tt0-info then do:
     1186         create buf_tt0-info.
     1187         assign
     1188         buf_tt0-info.artic = p-artic
     1189         buf_tt0-info.prod-type = p-prod-type
     1190         buf_tt0-info.prod-code = p-prod-code
     1191         buf_tt0-info.prt-code  = p-prt-code
     1192         buf_tt0-info.obj-type  = p-obj-type
     1193         buf_tt0-info.obj-code  = p-obj-code
     1194         buf_tt0-info.a-to-res  = ?
     1195         buf_tt0-info.to-res    = ?
     1196         buf_tt0-info.was-res   = ?
     1197         buf_tt0-info.o-was-res = ?
     1198         buf_tt0-info.o-to-res  = ?
     1199         buf_tt0-info.o-is-res  = ?
     1200         buf_tt0-info.is-res    = ?
     1201         .
     1202       end.
     1203       assign
     1204       buf_tt0-info.a-to-res  =
     1205                                 (if buf_tt0-info.a-to-res <> ?
     1206                                 and p-all-qnty = ?
     1207                                 then buf_tt0-info.a-to-res
     1208                                 else p-all-qnty)
     1209       buf_tt0-info.was-res   = (if buf_tt0-info.was-res <> ?
     1210                                 and p-was-res = ?
     1211                                 then buf_tt0-info.was-res
     1212                                 else p-was-res)
     1213       buf_tt0-info.to-res    = (if buf_tt0-info.to-res <> ?
     1214                                 and p-to-res = ?
     1215                                 then buf_tt0-info.to-res
     1216                                 else p-to-res)
     1217       buf_tt0-info.is-res    = (if buf_tt0-info.is-res <> ?
     1218                                 and p-is-res = ?
     1219                                 then buf_tt0-info.is-res
     1220                                 else p-is-res)
     1221       buf_tt0-info.o-was-res   = (if buf_tt0-info.o-was-res <> ?
     1222                                 and p-o-was-res = ?
     1223                                 then buf_tt0-info.o-was-res
     1224                                 else p-o-was-res)
     1225       buf_tt0-info.o-to-res    = (if buf_tt0-info.o-to-res <> ?
     1226                                 and p-o-to-res = ?
     1227                                 then buf_tt0-info.o-to-res
     1228                                 else p-o-to-res)
     1229       buf_tt0-info.o-is-res    = (if buf_tt0-info.o-is-res <> ?
     1230                                 and p-o-is-res = ?
     1231                                 then buf_tt0-info.o-is-res
     1232                                 else p-o-is-res)
     1233       .
     1234       assign
     1235       buf_tt0-info.doc-code  = p-doc-code
     1236       buf_tt0-info.error-message   = p-mess
     1237       .
     1238     end.
     1239   end procedure.
     1240   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1241   def var cr as integer no-undo.
     1242   DEFINE  TEMP-TABLE t-gds No-UNDO
     1243   FIELD b-code like ub.chk-gds.b-code
     1244   FIELD gds-code like ub.goods.gds-code
     1245   FIELD VAT-sum-rubl like ub.chk-gds.VAT-sum-rubl
     1246   FIELD pump like ub.chk-gds.pump
     1247   FIELD nozzle-code like ub.chk-gds.nozzle-code
     1248   FIELD loc1 like ub.chk-gds.loc1
     1249   field pl-code like ub.chk-gds.pl-code
     1250   field density as decimal
     1251   FIELD fbr-obj-type like ub.clients.obj-type
     1252   FIELD fbr-obj-code like ub.clients.obj-code
     1253   FIELD artic like ub.goods.artic
     1254   FIELD prod-type like ub.goods.prod-type
     1255   FIELD prod-code like ub.goods.prod-code
     1256   FIELD doc-qnty like ub.chk-gds.doc-qnty
     1257   FIELD price-base like ub.chk-gds.price-base
     1258   FIELD price-sum like ub.chk-gds.price-base
     1259   FIELD discnt like ub.chk-gds.discnt
     1260   FIELD discnt-sum like ub.chk-gds.discnt
     1261   FIELD price-service like ub.chk-gds.price-service
     1262   FIELD service-sum like ub.chk-gds.price-service
     1263   FIELD road-tax like ub.chk-gds.road-tax
     1264   FIELD road-sum like ub.chk-gds.road-tax
     1265   FIELD new-price like ub.chk-gds.price-base
     1266   FIELD cashparts as logical
     1267   FIELD rdoc-line as recid
     1268   FIELD rgds-dtl as recid
     1269   FIELD unit-base like ub.goods.unit-base
     1270   FIELD unit-cli like ub.goods.unit-cli
     1271   FIELD node-code like ub.bar-code.node-code
     1272   FIELD num-lines as integer
     1273   FIELD vat-pc like ub.doc-line.vat-pc
     1274   FIELD SLT-pc like ub.doc-line.slt-pc
     1275   FIELD crf as integer
     1276   FIELD drc as recid
     1277   FIELD grc as recid
     1278   FIELD prt-root like ub.goods.prt-root
     1279   FIELD excise as decimal
     1280   FIELD type like ub.units.type
     1281   FIELD is-modificator as logical
     1282   FIELD is-null-price as logical
     1283   FIELD doc-code like ub.trn-doc.doc-code
     1284   FIELD marks as character
     1285   index pi is PRIMARY doc-code b-code artic prod-type prod-code node-code pump nozzle-code pl-code
     1286   index ifbr b-code fbr-obj-type fbr-obj-code
     1287   index crfi crf.
     1288   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1289   procedure findtank:
     1290     define input  parameter p-obj-type     as character no-undo.
     1291     define input  parameter p-obj-code     as integer   no-undo.
     1292     define input  parameter p-pump-code    as integer   no-undo.
     1293     define input  parameter p-nozzle-code  as integer   no-undo .
     1294     define input  parameter p-from-pl-code as integer   no-undo .
     1295     define input  parameter p-gds-code     as integer   no-undo.
     1296     define output parameter p-pl-code      as integer   no-undo .
     1297     define variable v-pl-code            like ub.place.pl-code no-undo .
     1298     define variable v-dopstr             as character no-undo .
     1299     define buffer buf_place for ub.place.
     1300     define buffer buf_pl-gds-pump for ub.pl-gds-pump.
     1301     define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
     1302     define buffer buf_pl-gds for ub.pl-gds.
     1303     do
     1304     on error undo, return error return-value
     1305     :
     1306       assign
     1307         v-pl-code = 0
     1308         p-pl-code = ?
     1309       .
     1310       if p-from-pl-code <> ?
     1311         and p-from-pl-code <> 0
     1312       then do:
     1313         find first buf_pl-gds no-lock
     1314           where buf_pl-gds.obj-type  = p-obj-type
     1315             and buf_pl-gds.obj-code  = p-obj-code
     1316             and buf_pl-gds.pl-code   = p-from-pl-code
     1317             and buf_pl-gds.gds-code  = p-gds-code
     1318           no-error.
     1319         if available buf_pl-gds then do:
     1320           assign
     1321             v-pl-code = buf_pl-gds.pl-code
     1322           .
     1323         end.
     1324       end.
     1325       if v-pl-code <> 0
     1326         and p-nozzle-code <> ?
     1327         and p-nozzle-code <> 0
     1328       then do:
     1329         find first buf_pl-pump-nozzle no-lock
     1330           where buf_pl-pump-nozzle.obj-type    = p-obj-type
     1331             and buf_pl-pump-nozzle.obj-code    = p-obj-code
     1332             and buf_pl-pump-nozzle.pl-code     = v-pl-code
     1333             and buf_pl-pump-nozzle.pump-code   = p-pump-code
     1334             and buf_pl-pump-nozzle.nozzle-code = p-nozzle-code
     1335           no-error .
     1336         if not available buf_pl-pump-nozzle then do:
     1337           return.
     1338         end.
     1339       end.
     1340       if v-pl-code = 0 then do:
     1341         if p-nozzle-code = 0 then do:
     1342           find first buf_pl-gds-pump no-lock
     1343             where buf_pl-gds-pump.obj-type  = p-obj-type
     1344               and buf_pl-gds-pump.obj-code  = p-obj-code
     1345               and buf_pl-gds-pump.pump-code = p-pump-code
     1346               and buf_pl-gds-pump.gds-code  = p-gds-code
     1347               and buf_pl-gds-pump.status_   = 'тек':U
     1348             no-error.
     1349           if available buf_pl-gds-pump then do:
     1350             assign
     1351               v-pl-code = buf_pl-gds-pump.pl-code
     1352             .
     1353           end.
     1354         end.
     1355         else do:
     1356           _ppnz:
     1357           for each buf_pl-pump-nozzle no-lock
     1358             where buf_pl-pump-nozzle.obj-type = p-obj-type
     1359               and buf_pl-pump-nozzle.obj-code = p-obj-code
     1360               and buf_pl-pump-nozzle.pump-code = p-pump-code
     1361               and buf_pl-pump-nozzle.nozzle-code = p-nozzle-code
     1362             ,first buf_pl-gds-pump no-lock
     1363             where buf_pl-gds-pump.obj-type  = p-obj-type
     1364               and buf_pl-gds-pump.obj-code  = p-obj-code
     1365               and buf_pl-gds-pump.pump-code = p-pump-code
     1366               and buf_pl-gds-pump.gds-code  = p-gds-code
     1367               and buf_pl-gds-pump.status_   = 'тек':U
     1368               and buf_pl-gds-pump.pl-code   = buf_pl-pump-nozzle.pl-code
     1369           on error undo, return error return-value
     1370           :
     1371             assign
     1372               v-pl-code = buf_pl-pump-nozzle.pl-code
     1373             .
     1374             leave _ppnz.
     1375           end.
     1376         end.
     1377       end.
     1378       if v-pl-code <> 0 then do:
     1379         assign
     1380           p-pl-code = v-pl-code
     1381         .
     1382       end.
     1383     end.
     1384   end procedure.
     1385   procedure find-nzl:
     1386   define input  parameter p-obj-type   as character no-undo.
     1387   define input  parameter p-obj-code   as integer   no-undo.
     1388   define input  parameter p-pump-code  as integer   no-undo.
     1389   define input  parameter p-gds-code   as integer   no-undo.
     1390   define input  parameter p-pl-code    as integer no-undo .
     1391   define output parameter p-nozzle-code    as integer   no-undo.
     1392   define variable v-nozzle-code        like ub.nozzle.nozzle-code no-undo .
     1393   define variable v-pl-code            like ub.place.pl-code no-undo .
     1394   define variable v-pump-code          like ub.pump.pump-code no-undo .
     1395   define variable v-loc1-code          like ub.place.loc1 no-undo .
     1396   define variable v-dopstr             as character no-undo .
     1397   define buffer buf_place for ub.place.
     1398   define buffer buf_pl-gds-pump for ub.pl-gds-pump.
     1399   define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
     1400   define buffer buf_pl-gds for ub.pl-gds.
     1401   do on error undo, return error return-value :
     1402     v-pump-code = p-pump-code.
     1403     find first buf_pl-pump-nozzle no-lock where
     1404                   buf_pl-pump-nozzle.obj-type = p-obj-type
     1405               and buf_pl-pump-nozzle.obj-code = p-obj-code
     1406               and buf_pl-pump-nozzle.pump-code = p-pump-code
     1407               and buf_pl-pump-nozzle.pl-code = p-pl-code no-error.
     1408     if not available buf_pl-pump-nozzle then do:
     1409       assign
     1410       p-nozzle-code = ?.
     1411       return .
     1412     end.
     1413     assign
     1414     p-nozzle-code = buf_pl-pump-nozzle.nozzle-code.
     1415     return.
     1416     .
     1417   end.
     1418   end procedure.
     1419   procedure find-nzl-without-pl:
     1420   define input  parameter p-obj-type   as character no-undo.
     1421   define input  parameter p-obj-code   as integer   no-undo.
     1422   define input  parameter p-pump-code  as integer   no-undo.
     1423   define input  parameter p-gds-code   as integer   no-undo.
     1424   define output parameter p-nozzle-code    as integer   no-undo.
     1425   define buffer buf_pl-gds-pump for ub.pl-gds-pump.
     1426   define buffer buf_pl-gds for ub.pl-gds.
     1427   define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
     1428   do on error undo, return error return-value :
     1429     for each buf_pl-gds-pump no-lock where
     1430               buf_pl-gds-pump.obj-type  = p-obj-type
     1431           and buf_pl-gds-pump.obj-code  = p-obj-code
     1432           and buf_pl-gds-pump.pump-code = p-pump-code
     1433           and buf_pl-gds-pump.gds-code  = p-gds-code
     1434           and buf_pl-gds-pump.status_   = 'тек':U,
     1435         first buf_pl-gds no-lock where
     1436                   buf_pl-gds.obj-type = p-obj-type
     1437               AND buf_pl-gds.obj-code = p-obj-code
     1438               AND buf_pl-gds.pl-code = buf_pl-gds-pump.pl-code
     1439               AND buf_pl-gds.gds-code = p-gds-code
     1440               AND buf_pl-gds.status_ = 'тек':U,
     1441        first buf_pl-pump-nozzle no-lock where
     1442                 buf_pl-pump-nozzle.obj-type = p-obj-type
     1443             and buf_pl-pump-nozzle.obj-code = p-obj-code
     1444             and buf_pl-pump-nozzle.pl-code = buf_pl-gds.pl-code
     1445             and buf_pl-pump-nozzle.pump-code = p-pump-code:
     1446       assign
     1447       p-nozzle-code = buf_pl-pump-nozzle.nozzle-code.
     1448       return .
     1449     end.
     1450     assign
     1451     p-nozzle-code = ?.
     1452     return.
     1453     .
     1454   end.
     1455   end procedure.
