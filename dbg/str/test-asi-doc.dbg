     6010     _trpomi :
     6011       do on error undo, return :
     6012       if calc_r-line.density = ? or calc_r-line.density = 0 then do :
     6013         message
     6014           "Заполнены не все поля, необходимые" skip
     6015           "для работы библиотеки ПОкМИ"        skip
     6016           "Введите плотность измер.для ПОкМИ"
     6017         view-as alert-box error.
     6018         undo _trpomi, return "need-data" .
     6019       end.
     6020       if calc_r-line.level-total = ? or calc_r-line.level-total = 0 then do :
     6021         message
     6022           "Заполнены не все поля, необходимые" skip
     6023           "для работы библиотеки ПОкМИ"        skip
     6024           "Введите факт. общий уровень"
     6025         view-as alert-box error.
     6026         undo _trpomi, return "need-data" .
     6027       end.
     6028       if calc_r-line.temperature = ?
     6029       then do :
     6030         message
     6031           "Заполнены не все поля, необходимые" skip
     6032           "для работы библиотеки ПОкМИ"        skip
     6033           "Введите температуру"
     6034         view-as alert-box error.
     6035         undo _trpomi, return "need-data" .
     6036       end.
     6037       do ii = 1 to num-entries('place-type,place-SI,place-diameter,dead-balance,water-level,dens-prov,place-virtual,place-twice-code,place-sert-urov,place-local,place-error-mass,place-asi-sertif,place-rvd-dnsty,place-rvd-lvl,place-rvd-tmp,place-SI-dens,place-SI-level,place-SI-temp,place-passp-num,place-passp-type,place-dead-high,place-temp-coef,disable-water-alarm,disable-level-alarm,place-ponton,place-ponton-mass,place-ponton-height,place-com-vessel,place-com-tanks,place-is-main,place-gate-valve,place-gate-valve-tanks,place-auto-gate-valve':u,','):
     6038         v-code = entry(ii,'place-type,place-SI,place-diameter,dead-balance,water-level,dens-prov,place-virtual,place-twice-code,place-sert-urov,place-local,place-error-mass,place-asi-sertif,place-rvd-dnsty,place-rvd-lvl,place-rvd-tmp,place-SI-dens,place-SI-level,place-SI-temp,place-passp-num,place-passp-type,place-dead-high,place-temp-coef,disable-water-alarm,disable-level-alarm,place-ponton,place-ponton-mass,place-ponton-height,place-com-vessel,place-com-tanks,place-is-main,place-gate-valve,place-gate-valve-tanks,place-auto-gate-valve':u) .
     6039         run placelib_get-attr  ( input v-code
     6040                                 ,input calc_r-line.obj-code
     6041                                 ,input calc_r-line.obj-type
     6042                                 ,input calc_r-line.pl-code
     6043                                 ,output v-value
     6044                                 ,output v-ok      ) no-error.
     6045         case v-code :
     6046           when "place-type" then do :
     6047             if v-ok then place-type = integer(v-value) .
     6048           end.
     6049           when "place-SI" then do :
     6050             if v-ok then place-si = integer(v-value) .
     6051           end.
     6052           when "place-diameter" then do :
     6053             if v-ok then place-diameter = decimal(v-value) .
     6054           end.
     6055           when "dens-prov" then do :
     6056             if v-ok then dens-prov = decimal(v-value) .
     6057           end.
     6058           when "place-dead-high" then do :
     6059             if v-ok then DeadZone_Reservoir = decimal(v-value) .
     6060           end.
     6061           when "place-ponton" then do :
     6062             if v-ok then place-ponton = logical(v-value) .
     6063           end.
     6064           when "place-ponton-mass" then do :
     6065             if v-ok then place-ponton-mass = decimal(v-value) .
     6066           end.
     6067           when "place-ponton-height" then do :
     6068             if v-ok then place-ponton-height = decimal(v-value) .
     6069           end.
     6070         end case.
     6071       end.
     6072       if calc_r-line.level-water > 0
     6073       then do :
     6074         find last water1_pl-level no-lock where water1_pl-level.pl-code  = calc_r-line.pl-code
     6075                                             and water1_pl-level.obj-code = calc_r-line.obj-code
     6076                                             and water1_pl-level.obj-type = calc_r-line.obj-type
     6077                                             and water1_pl-level.pl-level <= calc_r-line.level-water
     6078                                             no-error .
     6079         if available water1_pl-level
     6080         then do :
     6081           WaterDeltaV1 = ? .
     6082           for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = water1_pl-level.pl-code
     6083                                                 and buf_pl-level-attr.obj-code = water1_pl-level.obj-code
     6084                                                 and buf_pl-level-attr.obj-type = water1_pl-level.obj-type
     6085                                                 and buf_pl-level-attr.pl-level = water1_pl-level.pl-level
     6086                                                 and buf_pl-level-attr.attr-code = "deltaV"
     6087                                                 :
     6088             WaterDeltaV1 = decimal(buf_pl-level-attr.attr-value) no-error .
     6089           end .
     6090         end .
     6091         if available water1_pl-level
     6092         and water1_pl-level.pl-level <> calc_r-line.level-water
     6093         then do :
     6094           find first water2_pl-level no-lock where water2_pl-level.pl-code  = calc_r-line.pl-code
     6095                                                and water2_pl-level.obj-code = calc_r-line.obj-code
     6096                                                and water2_pl-level.obj-type = calc_r-line.obj-type
     6097                                                and water2_pl-level.pl-level >= calc_r-line.level-water
     6098                                                no-error .
     6099           if available water2_pl-level
     6100           then do :
     6101             WaterDeltaV2 = ? .
     6102             for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = water2_pl-level.pl-code
     6103                                                   and buf_pl-level-attr.obj-code = water2_pl-level.obj-code
     6104                                                   and buf_pl-level-attr.obj-type = water2_pl-level.obj-type
     6105                                                   and buf_pl-level-attr.pl-level = water2_pl-level.pl-level
     6106                                                   and buf_pl-level-attr.attr-code = "deltaV"
     6107                                                   :
     6108               WaterDeltaV2 = decimal(buf_pl-level-attr.attr-value) no-error .
     6109             end .
     6110           end .
     6111         end .
     6112       end .
     6113       find last total1_pl-level no-lock where total1_pl-level.pl-code  = calc_r-line.pl-code
     6114                                           and total1_pl-level.obj-code = calc_r-line.obj-code
     6115                                           and total1_pl-level.obj-type = calc_r-line.obj-type
     6116                                           and total1_pl-level.pl-level <= calc_r-line.level-total
     6117                                           no-error .
     6118       if not available total1_pl-level
     6119       then do :
     6120         find first bf_goods no-lock where bf_goods.gds-code = calc_r-line.gds-code no-error .
     6121         find first bf_place no-lock where bf_place.pl-code = calc_r-line.pl-code no-error .
     6122         message
     6123           substitute( 'Для резервуара &1 (&2 &3) не заполнена градуировочная таблица. Запуск ПОкМИ невозможен.'
     6124                      ,(if available bf_place then bf_place.loc1 else "?")
     6125                      ,(if available bf_goods then string(bf_goods.gds-code) else "?")
     6126                      ,(if available bf_goods then bf_goods.gds-name else "?") )
     6127         view-as alert-box .
     6128         undo _trpomi, return "need-data" .
     6129       end .
     6130       DeltaOtn_K = ? .
     6131       for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = total1_pl-level.pl-code
     6132                                             and buf_pl-level-attr.obj-code = total1_pl-level.obj-code
     6133                                             and buf_pl-level-attr.obj-type = total1_pl-level.obj-type
     6134                                             and buf_pl-level-attr.pl-level = total1_pl-level.pl-level
     6135                                             and buf_pl-level-attr.attr-code = "tarir-delta"
     6136                                             :
     6137         DeltaOtn_K = decimal(buf_pl-level-attr.attr-value) .
     6138       end .
     6139       if DeltaOtn_K = ? then DeltaOtn_K = 0.25 .
     6140       DeltaV1 = ? .
     6141       for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = total1_pl-level.pl-code
     6142                                             and buf_pl-level-attr.obj-code = total1_pl-level.obj-code
     6143                                             and buf_pl-level-attr.obj-type = total1_pl-level.obj-type
     6144                                             and buf_pl-level-attr.pl-level = total1_pl-level.pl-level
     6145                                             and buf_pl-level-attr.attr-code = "deltaV"
     6146                                             :
     6147         DeltaV1 = decimal(buf_pl-level-attr.attr-value) no-error .
     6148       end .
     6149       find first total2_pl-level no-lock where total2_pl-level.pl-code  = calc_r-line.pl-code
     6150                                           and total2_pl-level.obj-code = calc_r-line.obj-code
     6151                                           and total2_pl-level.obj-type = calc_r-line.obj-type
     6152                                           and total2_pl-level.pl-level > calc_r-line.level-total
     6153                                           no-error .
     6154       if not available total2_pl-level
     6155       then do :
     6156         find first bf_goods no-lock where bf_goods.gds-code = calc_r-line.gds-code no-error .
     6157         find first bf_place no-lock where bf_place.pl-code = calc_r-line.pl-code no-error .
     6158         message
     6159           substitute( 'Для резервуара &1 (&2 &3) не заполнена градуировочная таблица. Запуск ПОкМИ невозможен.'
     6160                      ,(if available bf_place then bf_place.loc1 else "?")
     6161                      ,(if available bf_goods then string(bf_goods.gds-code) else "?")
     6162                      ,(if available bf_goods then bf_goods.gds-name else "?") )
     6163         view-as alert-box .
     6164         undo _trpomi, return "need-data" .
     6165       end .
     6166       DeltaV2 = ? .
     6167       for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = total2_pl-level.pl-code
     6168                                             and buf_pl-level-attr.obj-code = total2_pl-level.obj-code
     6169                                             and buf_pl-level-attr.obj-type = total2_pl-level.obj-type
     6170                                             and buf_pl-level-attr.pl-level = total2_pl-level.pl-level
     6171                                             and buf_pl-level-attr.attr-code = "deltaV"
     6172                                             :
     6173         DeltaV2 = decimal(buf_pl-level-attr.attr-value) no-error .
     6174       end .
     6175       if available water1_pl-level
     6176       then do :
     6177         CalibTable = Substitute("&1=&2", water1_pl-level.pl-level, (water1_pl-level.pl-qnty / 1000)) + (if WaterDeltaV1 > 0 then ("=" + trim(string(WaterDeltaV1, ">>9.9999"))) else "") + chr(10) .
     6178       end .
     6179       if available water2_pl-level
     6180       then do :
     6181         CalibTable = CalibTable + Substitute("&1=&2", water2_pl-level.pl-level, (water2_pl-level.pl-qnty / 1000)) + (if WaterDeltaV2 > 0 then ("=" + trim(string(WaterDeltaV2, ">>9.9999"))) else "") + chr(10) .
     6182       end .
     6183       CalibTable = CalibTable + Substitute("&1=&2", total1_pl-level.pl-level, (total1_pl-level.pl-qnty / 1000)) + (if DeltaV1 > 0 then ("=" + trim(string(DeltaV1, ">>9.9999"))) else "") + chr(10) .
     6184       CalibTable = CalibTable + Substitute("&1=&2", total2_pl-level.pl-level, (total2_pl-level.pl-qnty / 1000)) + (if DeltaV2 > 0 then ("=" + trim(string(DeltaV2, ">>9.9999"))) else "") .
     6185       CalibBelt = getCalibrationBelt(
     6186           calc_r-line.obj-type,
     6187           calc_r-line.obj-code,
     6188           calc_r-line.pl-code,
     6189           calc_r-line.state-level-total,
     6190           if calc_r-line.state-level-water <> ? then calc_r-line.state-level-water else 0
     6191       ).
     6192       if place-si = 0
     6193       or place-si = ?
     6194       then do :
     6195         message
     6196           substitute ("Для складского места &1 не заданно средство измерения",calc_r-line.pl-code)
     6197         view-as alert-box error.
     6198         undo _trpomi, return "need-data" .
     6199       end.
     6200       else do :
     6201         find first buf_sr-izmerenia no-lock where buf_sr-izmerenia.node-code = place-si no-error.
     6202         if not available buf_sr-izmerenia then do :
     6203           message
     6204           "Ошибка работы с библиотекой ПОкМИ"
     6205           substitute( 'Не найдено средство измерения с кодом &1', place-si ) skip
     6206           view-as alert-box error.
     6207           undo _trpomi, return "need-data" .
     6208         end.
     6209         else do :
     6210           assign
     6211             ToolType               = buf_sr-izmerenia.sr-type-id
     6212             A_LevelMeasurementTool = buf_sr-izmerenia.sr-temp-line
     6213             ToolAutomationLevel_H  = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     6214             ToolAutomationLevel_H_Water = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     6215             DeltaAbs_H             = buf_sr-izmerenia.sr-abs-err-neft-water
     6216             DeltaAbs_H_Water       = buf_sr-izmerenia.sr-abs-err-water
     6217             ToolAutomationLevel_R  = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     6218             DeltaAbs_R             = buf_sr-izmerenia.sr-abs-err-dens
     6219             ToolAutomationLevel_Tv = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     6220             DeltaAbs_Tv            = buf_sr-izmerenia.sr-abs-err-temp-vol
     6221             ToolAutomationLevel_Tr = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     6222             DeltaAbs_Tr            = buf_sr-izmerenia.sr-abs-err-temp-dens
     6223             DeltaOtn_N             = 0.05
     6224             DeltaOtn_H             = buf_sr-izmerenia.sr-relative-err-neft-water
     6225             DeltaOtn_H_Water       = buf_sr-izmerenia.sr-relative-err-water
     6226             DeltaOtn_R             = buf_sr-izmerenia.sr-relative-err-dens
     6227             DeltaAbs_H_CalcType    = buf_sr-izmerenia.sr-type-level-measuring + 1
     6228             DeltaAbs_H_Water_CalcType = buf_sr-izmerenia.sr-type-level-measuring + 1
     6229           .
     6230         end.
     6231       end.
     6232       assign
     6233         LevelToolType = buf_sr-izmerenia.sr-type-level-measuring
     6234         ToolAutomationLevel_H  = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     6235         ToolAutomationLevel_H_Water = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     6236         DeltaAbs_H_CalcType = buf_sr-izmerenia.sr-type-level-measuring + 1
     6237         DeltaAbs_H_Water_CalcType = buf_sr-izmerenia.sr-type-level-measuring + 1
     6238         ToolAutomationLevel_Tv = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     6239         ToolAutomationLevel_Tr = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     6240         ToolAutomationLevel_R = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     6241       .
     6242       if DeltaAbs_H       = ? then DeltaAbs_H = 0 .
     6243       if DeltaAbs_H_Water = ? then DeltaAbs_H_Water = 0 .
     6244       if DeltaAbs_R       = ? then DeltaAbs_R = 0 .
     6245       if DeltaAbs_Tv      = ? then DeltaAbs_Tv = 0 .
     6246       if DeltaAbs_Tr      = ? then DeltaAbs_Tr = 0 .
     6247       if DeltaOtn_N       = ? then DeltaOtn_N = 0 .
     6248       if DeltaOtn_H       = ? then DeltaOtn_H = 0 .
     6249       if DeltaOtn_H_Water = ? then DeltaOtn_H_Water = 0 .
     6250       if DeltaOtn_R       = ? then DeltaOtn_R = 0 .
     6251       if LevelToolType    = ? then LevelToolType = 0 .
     6252       if ToolType         = ? then ToolType = 0 .
     6253       if A_LevelMeasurementTool      = ? then A_LevelMeasurementTool = 0 .
     6254       if ToolAutomationLevel_Tr      = ? then ToolAutomationLevel_Tr =0.
     6255       if ToolAutomationLevel_H       = ? then ToolAutomationLevel_H = 0.
     6256       if ToolAutomationLevel_H_Water = ? then ToolAutomationLevel_H_Water = 0.
     6257       if ToolAutomationLevel_Tv      = ? then ToolAutomationLevel_Tv = 0.
     6258       if ToolAutomationLevel_R       = ? then ToolAutomationLevel_R = 0.
     6259       if DeltaAbs_H_CalcType         = ? then DeltaAbs_H_CalcType = 0.
     6260       if DeltaAbs_H_Water_CalcType   = ? then DeltaAbs_H_Water_CalcType = 0.
     6261       if calc_r-line.state-level-water = 0
     6262       then do :
     6263         ToolAutomationLevel_H_Water = 3 .
     6264         DeltaAbs_H_Water_CalcType = 1 .
     6265         DeltaAbs_H_Water = 0 .
     6266         DeltaOtn_H_Water = 0 .
     6267       end .
     6268       if LevelToolType > 0
     6269       then do :
     6270         MM57
     6271           (input calc_r-line.level-total * 10,
     6272            input LevelToolType,
     6273            output DeltaAbs_H,
     6274            output vErr,
     6275            output vWrn,
     6276            output vDllVersion)
     6277         .
     6278         OUTPUT stream outstream to value ("pomi.log") append.
     6279         PUT STREAM outstream unformatted
     6280                     "    " SKIP
     6281                     "    " SKIP
     6282                     cur-time-string()           FORMAT "x(16)"    SKIP
     6283                     'Процедура             "CMethodOfMetering57"'       SKIP
     6284                     'Версия dll: '            vDllVersion   skip
     6285                     'CODE_PL                = ' calc_r-line.pl-code                           SKIP
     6286                     'H                      = ' calc_r-line.level-total * 10                  SKIP
     6287                     'ToolType               = ' LevelToolType                                      SKIP
     6288                         SKIP SKIP
     6289         .
     6290         output stream outstream close.
     6291         if trim(vErr) > "" then do :
     6292           output stream outstream to value ("pomi.log")  append.
     6293           put stream outstream vErr format "X(1024)" skip.
     6294           output stream outstream close.
     6295           message substitute('Ошибка работы библиотеки ПОкМИ &1', vErr) view-as alert-box .
     6296           undo _trpomi, return "pomi-error" .
     6297         end.
     6298         else do :
     6299           OUTPUT stream outstream to value ("pomi.log")  append.
     6300           PUT STREAM outstream unformatted
     6301               "DeltaAbs_H = " DeltaAbs_H  SKIP
     6302           .
     6303           OUTPUT stream outstream close.
     6304         end .
     6305       end .
     6306   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6307   run get-ptrl-prop in this-procedure
     6308     ( input calc_r-line.obj-type
     6309     , input calc_r-line.obj-code
     6310     ) .
     6311       if not error-status :error then do:
     6312         if ptrlprop-temp-for-pomi = 1 then temp-for-pomi = 15 .
     6313                                       else temp-for-pomi = 20 .
     6314       end.
     6315       assign
     6316         Tr = calc_r-line.temperature
     6317         Tv = calc_r-line.temperature
     6318         R = ( calc_r-line.density * 1000 )
     6319       .
     6320       find first buf_place no-lock
     6321            where buf_place.obj-code = calc_r-line.obj-code
     6322              and buf_place.obj-type = calc_r-line.obj-type
     6323              and buf_place.pl-code  = calc_r-line.pl-code no-error.
     6324       if place-type = 1 then do :
     6325         v-proc = "CMethodOfMetering13" .
     6326         MM13
     6327           (input 0.0,
     6328            input 0.0,
     6329            input 0.0,
     6330            input 0.0,
     6331            input calc_r-line.level-total * 10,
     6332            input (if calc_r-line.level-water <> ? then calc_r-line.level-water * 10 else 0.0),
     6333            input CalibTable,
     6334            input CalibBelt,
     6335            input 0.0,
     6336            input 0.0,
     6337            input Tv,
     6338            input Tr,
     6339            input R,
     6340            input temp-for-pomi,
     6341            input ToolType,
     6342            input DeltaOtn_K,
     6343            input DeadZone_Reservoir,
     6344            input A_Reservoir,
     6345            input A_LevelMeasurementTool,
     6346            input ToolAutomationLevel_H,
     6347            input ToolAutomationLevel_H_Water,
     6348            input ToolAutomationLevel_R,
     6349            input ToolAutomationLevel_Tv,
     6350            input ToolAutomationLevel_Tr,
     6351            input DeltaAbs_H_CalcType,
     6352            input DeltaAbs_H_Water_CalcType,
     6353            input DeltaAbs_H,
     6354            input DeltaAbs_H_Water,
     6355            input DeltaAbs_R,
     6356            input DeltaAbs_Tv,
     6357            input DeltaAbs_Tr,
     6358            input DeltaOtn_N,
     6359            input 1,
     6360            input 2,
     6361            input 2,
     6362            output V_total,
     6363            output V_water,
     6364            output DeltaV,
     6365            output V_product,
     6366            output Vcy,
     6367            output Rcy,
     6368            output V,
     6369            output CTL_base_alt,
     6370            output CPL_base_alt,
     6371            output CTPL_base_alt,
     6372            output Fp_base_alt,
     6373            output CTL_obs_base,
     6374            output CPL_obs_base,
     6375            output CTPL_obs_base,
     6376            output Fp_obs_base,
     6377            output Rv,
     6378            output DeltaOtn_Vcy,
     6379            output DeltaOtn_Vm,
     6380            output M,
     6381            output DeltaOtn_M,
     6382            output VolumetricExpansion,
     6383            output vErr,
     6384            output vWrn,
     6385            output vDllVersion)
     6386         no-error .
     6387       end.
     6388       else do :
     6389         v-proc = "CMethodOfMetering6" .
     6390         MM6
     6391           (input calc_r-line.level-total * 10,
     6392            input (if calc_r-line.level-water <> ? then calc_r-line.level-water * 10 else 0.0),
     6393            input CalibTable,
     6394            input CalibBelt,
     6395            input 0.0,
     6396            input Tv,
     6397            input Tr,
     6398            input R,
     6399            input temp-for-pomi,
     6400            input ToolType,
     6401            input DeltaOtn_K,
     6402            input DeadZone_Reservoir,
     6403            input A_Reservoir,
     6404            input A_LevelMeasurementTool,
     6405            input ToolAutomationLevel_H,
     6406            input ToolAutomationLevel_H_Water,
     6407            input ToolAutomationLevel_R,
     6408            input ToolAutomationLevel_Tv,
     6409            input ToolAutomationLevel_Tr,
     6410            input DeltaAbs_H_CalcType,
     6411            input DeltaAbs_H_Water_CalcType,
     6412            input DeltaAbs_H,
     6413            input DeltaAbs_H_Water,
     6414            input DeltaAbs_R,
     6415            input DeltaAbs_Tv,
     6416            input DeltaAbs_Tr,
     6417            input DeltaOtn_N,
     6418            input 1,
     6419            input 2,
     6420            input 2,
     6421            output V_total,
     6422            output V_water,
     6423            output DeltaV,
     6424            output V_product,
     6425            output Vcy,
     6426            output Rcy,
     6427            output V,
     6428            output CTL_base_alt,
     6429            output CPL_base_alt,
     6430            output CTPL_base_alt,
     6431            output Fp_base_alt,
     6432            output CTL_obs_base,
     6433            output CPL_obs_base,
     6434            output CTPL_obs_base,
     6435            output Fp_obs_base,
     6436            output Rv,
     6437            output DeltaOtn_Vcy,
     6438            output DeltaOtn_Vm,
     6439            output M,
     6440            output DeltaOtn_M,
     6441            output VolumetricExpansion,
     6442            output vErr,
     6443            output vWrn,
     6444            output vDllVersion)
     6445         no-error .
     6446       end.
     6447       OUTPUT stream outstream to value ("pomi.log") append.
     6448       PUT STREAM outstream unformatted
     6449         "    " SKIP
     6450         "    " SKIP
     6451         cur-time-string()           FORMAT "x(16)"    SKIP
     6452         'Процедура   "'              v-proc       '"'               FORMAT "x(128)"   SKIP
     6453         'Версия dll: '              vDllVersion                           SKIP
     6454         'CODE_PL                     = ' calc_r-line.pl-code                      SKIP
     6455         'H                           = ' calc_r-line.level-total * 10 SKIP
     6456         'H_water                     = ' (if calc_r-line.level-water <> ? then calc_r-line.level-water * 10 else 0.0) SKIP
     6457         'CalibrationTable            = ' CalibTable                    SKIP
     6458         'CalibrationBelt             = ' CalibBelt                    SKIP
     6459         'ToolAutomationLevel_H       = ' ToolAutomationLevel_H     SKIP
     6460         'ToolAutomationLevel_H_Water = ' ToolAutomationLevel_H_Water    SKIP
     6461         'ToolAutomationLevel_R       = ' ToolAutomationLevel_R     SKIP
     6462         'ToolAutomationLevel_Tv      = ' ToolAutomationLevel_Tv    SKIP
     6463         'ToolAutomationLevel_Tr      = ' ToolAutomationLevel_Tr    SKIP
     6464         'DeltaAbs_H_CalcType         = ' DeltaAbs_H_CalcType       SKIP
     6465         'DeltaAbs_H_Water_CalcType   = ' DeltaAbs_H_Water_CalcType SKIP
     6466         'Tv                          = ' round(Tv, 2)              SKIP
     6467         'Tr                          = ' round(Tr, 2)              SKIP
     6468         'R                           = ' round(R, 2)               SKIP
     6469         'Tcy                         = ' temp-for-pomi                       SKIP
     6470         'ToolType                    = ' ToolType                            SKIP
     6471         'DeadZone_Reservoir          = ' DeadZone_Reservoir                  SKIP
     6472         'DeltaOtn_K                  = ' DeltaOtn_K                          SKIP
     6473         'A_Reservoir                 = ' A_Reservoir                         SKIP
     6474         'A_LevelMeasurementTool      = ' A_LevelMeasurementTool              skip
     6475         'DeltaAbs_H                  = ' DeltaAbs_H                          SKIP
     6476         'DeltaAbs_H_Water            = ' DeltaAbs_H_Water                    SKIP
     6477         'DeltaAbs_R                  = ' DeltaAbs_R                          SKIP
     6478         'DeltaAbs_Tv                 = ' DeltaAbs_Tv                         SKIP
     6479         'DeltaAbs_Tr                 = ' DeltaAbs_Tr                         SKIP
     6480         'DeltaOtn_N                  = ' DeltaOtn_N                          SKIP
     6481         'Round_M                     = ' 1                                   SKIP
     6482         'Round_T                     = ' 2                                   SKIP
     6483         'Round_R                     = ' 2                                   SKIP
     6484       .
     6485       if place-type = 1
     6486       and place-ponton
     6487       then do :
     6488         put stream outstream unformatted
     6489           "Rprov                  = " 0.0 skip
     6490           "Mpokr                  = " 0.0 skip
     6491           "Vdisp                  = " 0.0 skip
     6492           "CoverFloatingHeight    = " 0.0 skip
     6493         .
     6494       end.
     6495       output stream outstream close.
     6496       if trim(vErr) > "" then do :
     6497         error-string = substitute("~nРезервуар: &1.~n", if avail buf_place then buf_place.loc1 else "")
     6498                      + replace(vErr,";0x","~n0x") .
     6499         output stream outstream to value ("pomi.log")  append.
     6500         put stream outstream error-string format "X(1024)" skip.
     6501         output stream outstream close.
     6502         message
     6503         substitute('Ошибка работы библиотеки ПОкМИ. &1',error-string)
     6504         view-as alert-box error.
     6505         undo _trpomi, return "pomi-error" .
     6506       end.
     6507       else do :
     6508         find first rvs-line-attr exclusive-lock
     6509               where rvs-line-attr.obj-code  = calc_r-line.obj-code
     6510                 and rvs-line-attr.obj-type  = calc_r-line.obj-type
     6511                 and rvs-line-attr.gds-code  = calc_r-line.gds-code
     6512                 and rvs-line-attr.pl-code   = calc_r-line.pl-code
     6513                 and rvs-line-attr.rvs-code  = calc_r-line.rvs-code
     6514                 and rvs-line-attr.attr-code = "asi-pomi-density" no-error.
     6515         if available rvs-line-attr then do :
     6516           rvs-line-attr.attr-value = string(Rcy / 1000) .
     6517         end.
     6518         else do :
     6519           create rvs-line-attr.
     6520           assign
     6521             rvs-line-attr.obj-code  = calc_r-line.obj-code
     6522             rvs-line-attr.obj-type  = calc_r-line.obj-type
     6523             rvs-line-attr.gds-code  = calc_r-line.gds-code
     6524             rvs-line-attr.pl-code   = calc_r-line.pl-code
     6525             rvs-line-attr.rvs-code  = calc_r-line.rvs-code
     6526             rvs-line-attr.attr-code = "asi-pomi-density"
     6527             rvs-line-attr.attr-value = string(Rcy / 1000)
     6528           .
     6529         end.
     6530         assign
     6531           v-POkMI-result =
     6532             "V_total             = " + string(V_total)       + chr(10) +
     6533             "V_water             = " + string(V_water)       + chr(10) +
     6534             "DeltaV              = " + string(DeltaV)         + chr(10) +
     6535             "Vcy                 = " + string(Vcy)           + chr(10) +
     6536             "Rcy                 = " + string(Rcy)            + chr(10) +
     6537             "V_product           = " + string(V_product)      + chr(10) +
     6538             "V                   = " + string(V)              + chr(10) +
     6539             "Rv                  = " + string(Rv)               + chr(10) +
     6540             "M                   = " + string(M)                 + chr(10) +
     6541             "CTL_base_alt        = " + string(CTL_base_alt)  + chr(10) +
     6542             "CPL_base_alt        = " + string(CPL_base_alt)  + chr(10) +
     6543             "CTPL_base_alt       = " + string(CTPL_base_alt)  + chr(10) +
     6544             "Fp_base_alt         = " + string(Fp_base_alt)   + chr(10) +
     6545             "CTL_obs_base        = " + string(CTL_obs_base)  + chr(10) +
     6546             "CPL_obs_base        = " + string(CPL_obs_base)  + chr(10) +
     6547             "CTPL_obs_base       = " + string(CTPL_obs_base)  + chr(10) +
     6548             "Fp_obs_base         = " + string(Fp_obs_base)   + chr(10) +
     6549             "DeltaOtn_Vcy        = " + string(DeltaOtn_Vcy)  + chr(10) +
     6550             "DeltaOtn_Vm         = " + string(DeltaOtn_Vm)   + chr(10) +
     6551             "DeltaOtn_M          = " + string(DeltaOtn_M)       + chr(10) +
     6552             "VolumetricExpansion = " + string(VolumetricExpansion) + chr(10) +
     6553             "Warnings            = " + vWrn
     6554         .
     6555         OUTPUT stream outstream to value ("pomi.log")  append.
     6556         PUT STREAM outstream unformatted v-POkMI-result skip .
     6557         OUTPUT stream outstream close.
     6558       end.
     6559     end.
     6560   end procedure .
