     2690     hCall:SET-PARAMETER(25, "DOUBLE", "OUTPUT", C_full).
     2691     hCall:SET-PARAMETER(26, "DOUBLE", "OUTPUT", V_liquid).
     2692     hCall:SET-PARAMETER(27, "DOUBLE", "OUTPUT", V_gas).
     2693     hCall:SET-PARAMETER(28, "DOUBLE", "OUTPUT", M_liquid).
     2694     hCall:SET-PARAMETER(29, "DOUBLE", "OUTPUT", M_gas).
     2695     hCall:SET-PARAMETER(30, "DOUBLE", "OUTPUT", M).
     2696     hCall:SET-PARAMETER(31, "DOUBLE", "OUTPUT", Kf).
     2697     hCall:SET-PARAMETER(32, "DOUBLE", "OUTPUT", DeltaOtn_H).
     2698     hCall:SET-PARAMETER(33, "DOUBLE", "OUTPUT", DeltaOtn_R_liquid).
     2699     hCall:SET-PARAMETER(34, "DOUBLE", "OUTPUT", DeltaOtn_R_gas).
     2700     hCall:SET-PARAMETER(35, "DOUBLE", "OUTPUT", DeltaOtn_M_liquid).
     2701     hCall:SET-PARAMETER(36, "DOUBLE", "OUTPUT", DeltaOtn_M_gas).
     2702     hCall:SET-PARAMETER(37, "DOUBLE", "OUTPUT", DeltaOtn_M).
     2703     hCall:SET-PARAMETER(38, "DOUBLE", "OUTPUT", H_min_liquid).
     2704     hCall:SET-PARAMETER(39, "DOUBLE", "OUTPUT", H_min).
     2705     hCall:SET-PARAMETER(40, "DOUBLE", "OUTPUT", A).
     2706     hCall:SET-PARAMETER(41, "DOUBLE", "OUTPUT", B).
     2707     hCall:INVOKE( ).
     2708     Err = get-string(mErr, 1, 1024) .
     2709     Wrn = get-string(mWrn, 1, 1024) .
     2710     DllVersion = get-string(mDllVersion, 1, 20) .
     2711     delete object hCall.
     2712   end .
