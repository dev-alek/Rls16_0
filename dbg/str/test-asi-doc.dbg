     5895           end.
     5896           if par_test-asi-type = "test-asi_dens-pump"
     5897           then do :
     5898             for first calc_r-line no-lock where rowid(calc_r-line) = rowid(ub.rvs-line) :
     5899               run pomi-calc .
     5900             end .
     5901           end .
     5902           find first tt-meas exclusive-lock no-error.
     5903           delete tt-meas.
     5904         end.
     5905       end.
     5906       isMeasurement = no.
     5907     end.
     5908     else
     5909     do:
     5910       message "Нет ни одного измеряемого резервуара." view-as alert-box.
     5911     end.
     5912     run waitfram-hide in this-procedure.
     5913     run ui-on in this-procedure .
     5914     if VErrorFlag
     5915       then
     5916       return error.
     5917   end procedure.
     5918   procedure pomi-calc:
     5919   define variable v-proc as character no-undo.
