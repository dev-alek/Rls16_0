     5585     do:
     5586       message "Ошибка при редактировании строки проверки корректности работы АСИ в резервуаре." skip
     5587         return-value skip
     5588         error-status:get-message(1)
     5589         view-as alert-box error.
     5590       return error.
     5591     end.
