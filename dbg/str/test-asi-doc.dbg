     5477   procedure plgdsfnd :
     5478     define input  parameter p-chk-and-chs    as logical               no-undo .
     5479     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
     5480     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
     5481     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
     5482     define output parameter p-reserv-pl-code as   logical             no-undo .
     5483     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
     5484     define buffer buf_goods         for ub.goods .
     5485     define buffer buf_pl-gds        for ub.pl-gds .
     5486     define buffer buf_second_pl-gds for ub.pl-gds .
     5487     find first buf_goods no-lock where
     5488                buf_goods.gds-code = p-gds-code no-error .
     5489     if not available buf_goods
     5490     then do:
     5491       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
     5492     end.
     5493   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5494   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     5495     (input  p-obj-type
     5496     ,input  p-obj-code
     5497     ,input  buf_goods.artic
     5498     ,input  buf_goods.prod-type
     5499     ,input  buf_goods.prod-code
     5500     ,input  'place-rsrv=request'
     5501     ,output p-reserv-pl-code
     5502     ) no-error .
     5503     if error-status :error
     5504     then do:
     5505       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     5506     end.
     5507     if p-reserv-pl-code = no
     5508     then do:
     5509       return .
     5510     end.
     5511     if p-chk-and-chs <> yes
     5512     then do:
     5513       return .
     5514     end.
     5515     find first buf_pl-gds no-lock where
     5516                buf_pl-gds.obj-type = p-obj-type and
     5517                buf_pl-gds.obj-code = p-obj-code and
     5518                buf_pl-gds.gds-code = p-gds-code no-error .
     5519     if not available buf_pl-gds
     5520     then do:
     5521       return error "К товару не привязано ни одного места хранения" .
     5522     end.
     5523     find first buf_second_pl-gds no-lock where
     5524                buf_second_pl-gds.obj-type  = p-obj-type          and
     5525                buf_second_pl-gds.obj-code  = p-obj-code          and
     5526                buf_second_pl-gds.gds-code  = p-gds-code          and
     5527                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     5528     if not available buf_second_pl-gds
     5529     then do:
     5530       assign
     5531         p-pl-code = buf_pl-gds.pl-code
     5532       .
     5533     end.
     5534     else do:
     5535       run str/plgdssel.p
     5536         (
     5537            input parparentproc
     5538         ,  input p-obj-type
     5539         ,  input p-obj-code
     5540         ,  input p-gds-code
     5541         , output p-pl-code
     5542         ) no-error .
     5543       if error-status :error
     5544       then do:
     5545         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     5546                                , 'plgdssel.p':U
     5547                                , chr(10)
     5548                                , error-status :get-message( 1 )
     5549                                , return-value
     5550                                ) .
     5551       end.
     5552       if p-pl-code = ? or
     5553          p-pl-code = 0
     5554       then do:
     5555         return error "Не выбрано место хранения " + chr(10) .
     5556       end.
     5557     end.
     5558   end procedure.
     5559   procedure local-chg:
     5560     define buffer buf_goods for ub.goods.
     5561     define variable pl-rvd-dens      as logical   no-undo .
     5562     define variable pl-rvd-lvl       as logical   no-undo .
     5563     define variable pl-rvd-temp      as logical   no-undo .
     5564     define variable pl-level-sr-izm  as integer   no-undo .
     5565     define variable pl-temp-sr-izm   as integer   no-undo .
