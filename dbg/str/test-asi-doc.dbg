     4802     else display ? @ r-doc.boss ? @ boss-name with frame d-rvs.
     4803     open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code  and              ub.place.status_ <>      'удал':U.
     4804     if pardoc-mode = 'ПРОСМОТР':U then
     4805     do:
     4806       if rvs-line-rec      <> ? then reposition br-line      to recid rvs-line-rec      no-error.
     4807     end.
     4808     if pardoc-mode = 'ИЗМЕНЕНИЕ':U then
     4809     do:
     4810       if not can-find (first ub.rvs-line where ub.rvs-line.rvs-code = r-doc.rvs-code no-lock) then
     4811         apply "entry" to b-add in frame d-rvs.
     4812       else
     4813       do:
     4814         if rvs-line-rec      <> ? then reposition br-line      to recid rvs-line-rec      no-error.
     4815       end.
     4816     end.
     4817     if num-results( "br-line" ) > 0 then
     4818     do:
     4819       if br-line:refresh() then.
     4820     end.
     4821   end procedure.
     4822   PROCEDURE local-mark:
     4823     if not available ub.rvs-line then
     4824     do:
     4825       message "Неправильный выбор строки.".
     4826       return no-apply.
     4827     end.
     4828   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4829   define variable v-str-recid23 as character no-undo .
     4830   define variable v-num-entry23 as integer   no-undo .
     4831   assign
     4832     v-str-recid23 = trim( string( recid( ub.rvs-line ) , "->>>>>>>>>>>9":U ) )
     4833     v-num-entry23 = lookup( v-str-recid23 , del-list )
     4834   .
     4835   if v-num-entry23 > 0 then do:
     4836     assign
     4837       entry( v-num-entry23, del-list ) = "":U
     4838       del-list = trim( replace( del-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     4839     .
     4840   end.
     4841   else do:
     4842     assign
     4843       del-list = del-list + ( if del-list = "":U then "":U else chr(44) ) + v-str-recid23
     4844     .
     4845   end.
     4846     br-line:refresh() in frame d-rvs .
     4847   END PROCEDURE.
     4848   procedure del-rvs-line:
     4849     if del-list = "" then
     4850     do:
     4851       if not available ub.rvs-line then
     4852       do:
     4853         message "Неправильный выбор строки.".
     4854         return error.
     4855       end.
     4856       varlog = no.
     4857       message "Удалить строку документа проверки корректности работы АСИ в резервуаре ?   Вы уверены ?"
     4858         view-as alert-box question buttons ok-cancel update varlog.
     4859       if not varlog then return error.
     4860       rvs-line-rec = recid (ub.rvs-line).
     4861       del-list     = string (recid (ub.rvs-line)).
     4862       get next br-line.
     4863       if available ub.rvs-line then rep-rec = recid (ub.rvs-line).
     4864       else
     4865       do:
     4866         reposition br-line to recid rvs-line-rec no-error.
     4867         get prev br-line.
     4868         rep-rec = recid (ub.rvs-line).
     4869       end.
     4870     end.
     4871     else
     4872     do:
     4873       varlog = ?.
     4874       message "УДАЛЕНИЕ  ПО  ОТМЕТКАМ  строк документа ?" skip (2)
     4875         "yes - удалить все отмеченные строки" skip
     4876         "no - оставить только отмеченные строки и удалить все остальные" skip (2)
     4877         "cancel - ничего не удалять"
     4878         view-as alert-box question buttons yes-no-cancel update varlog.
     4879       if varlog = ? then return error.
     4880       rep-rec = ?.
     4881     end.
     4882     do transaction on error   undo, return error
     4883       on end-key undo, return error
     4884       on stop    undo, return error :
     4885       for each del-rvs-line where del-rvs-line.rvs-code = r-doc.rvs-code no-lock
     4886         :
     4887         if not varlog and     can-do (del-list, string (recid (del-rvs-line))) then next.
     4888         if     varlog and not can-do (del-list, string (recid (del-rvs-line))) then next.
     4889         assign
     4890           rvs-line-rec = recid(del-rvs-line).
     4891         find ub.rvs-line where recid (ub.rvs-line) = rvs-line-rec exclusive.
     4892         delete ub.rvs-line.
     4893       end.
     4894     end.
     4895   end procedure.
