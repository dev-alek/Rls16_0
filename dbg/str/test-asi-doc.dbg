     5779     .
     5780     for each tt-meas:
     5781       delete tt-meas.
     5782     end.
     5783     if can-find( first bf_r-line where bf_r-line.rvs-code = r-doc.rvs-code ) then
     5784     do:
     5785       isMeasurement = yes.
     5786       disable b-add b-chg b-del b-meas b-commission with frame d-rvs.
     5787       run waitfram-show in this-procedure ( input "Делаем сверку по всем резервуарам" ).
     5788       tr:
     5789       do transaction on error undo tr, retry tr :
     5790         if retry then
     5791         do:
     5792           VErrorFlag = yes.
     5793           leave tr.
     5794         end.
     5795         find first sys-ctrl no-lock.
     5796         run db-attr-value(sys-ctrl.db,"AsiIp",output v-asi-ip,output v-attr-type).
     5797         run db-attr-value(sys-ctrl.db,"AsiPort",output v-asi-port,output v-attr-type).
     5798         run db-attr-value(sys-ctrl.db,"AsiType",output v-asi-type,output v-attr-type).
     5799         if trim(v-asi-ip) <> ''
     5800           and trim(v-asi-port) <> ''
     5801           and trim(v-asi-type) <> ''
     5802           then
     5803         do :
     5804           case v-asi-type :
     5805             when "1"
     5806             then
     5807               do :
     5808                 varcur-rvs = 2 .
     5809               end.
     5810             when "2"
     5811             then
     5812               do :
     5813                 varcur-rvs = 3 .
     5814               end.
     5815           end case .
     5816         end.
     5817         else
     5818         do :
     5819           if ptoldfilvalue = "yes":u then
     5820           do:
     5821             run gbl/d-askw.w ( input "Выбор источника данных с информацией по резервуарам",
     5822               "Будем читать текущие данные с резервуаров или возьмем данные из файла?",
     5823               "|^",
     5824               "Текущие данные|Из файлов|Отмена",
     5825               "Запускается программа для обращения к датчикам резервуаров|Берутся уже сохраненные данные из файла|Ничего не делаем",
     5826               1,
     5827               3,
     5828               output varnum
     5829               ).
     5830             case varnum:
     5831               when 3 then
     5832                 do:
     5833                   undo tr, leave tr.
     5834                 end.
     5835               when 2 then
     5836                 do:
     5837                   assign
     5838                     varcur-rvs = 0.
     5839                 end.
     5840               when 1 then
     5841                 do:
     5842                   assign
     5843                     varcur-rvs = 1.
     5844                 end.
     5845             end case.
     5846           end.
     5847           else
     5848           do:
     5849             assign
     5850               varcur-rvs = 1.
     5851           end.
     5852         end.
     5853         for each bf_r-line no-lock where
     5854                  bf_r-line.rvs-code = r-doc.rvs-code,
     5855            first meas-place no-lock where
     5856                  meas-place.obj-type = bf_r-line.obj-type and
     5857                  meas-place.obj-code = bf_r-line.obj-code and
     5858                  meas-place.pl-code  = bf_r-line.pl-code
     5859           :
     5860           create tt-meas.
     5861           assign
     5862             tt-meas.obj-type = bf_r-line.obj-type
     5863             tt-meas.obj-code = bf_r-line.obj-code
     5864             tt-meas.pl-code  = bf_r-line.pl-code
     5865             tt-meas.loc1     = meas-place.loc1
     5866           .
     5867   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_rvsplace in g#lib-rvs ( input              r-doc.obj-type ,
     5868                         input              r-doc.obj-code ,
     5869                         input              yes ,
     5870                         input              varcur-rvs ,
     5871                         input              yes ,
     5872                         input              no ,
     5873                         input-output table tt-meas-file ,
     5874                         input-output table tt-meas ) no-error .
     5875           if error-status :error then
     5876           do:
