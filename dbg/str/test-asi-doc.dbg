     1442   procedure get-ptrl-prop :
     1443     define input  parameter p-obj-type as character no-undo .
     1444     define input  parameter p-obj-code as integer   no-undo .
     1445     do
     1446     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1447     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
     1448     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
     1449     :
     1450       define variable par-type          as character no-undo.
     1451       define variable v-value-character as character no-undo .
     1452       define variable v-value-date      as date      no-undo .
     1453       define variable v-value-decimal   as decimal   no-undo .
     1454       define variable v-value-integer   as integer   no-undo .
     1455       define variable v-value-logical   as logical   no-undo .
     1456       for each thbjattr_thbj-attr
     1457       :
     1458         delete thbjattr_thbj-attr .
     1459       end.
     1460       run adm/shattri.p
     1461         ( input "get":U
     1462         , input p-obj-type
     1463         , input p-obj-code
     1464         , input 'petrol':U
     1465         , input  ""
     1466         , output v-value-character
     1467         , output v-value-date
     1468         , output v-value-decimal
     1469         , output v-value-integer
     1470         , output v-value-logical
     1471         , output par-type
     1472         , input-output table thbjattr_thbj-attr
     1473         ) no-error .
     1474       for each thbjattr_thbj-attr
     1475       on error undo, return error return-value
     1476       :
     1477         case thbjattr_thbj-attr.prop-code :
     1478           when 'denstclc':U then do:
     1479             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
     1480               assign
     1481                 ptrlprop-denstclc = thbjattr_thbj-attr.property-value-character
     1482               .
     1483             end.
     1484           end.
     1485           when 'expptrl':U then do:
     1486             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
     1487               and thbjattr_thbj-attr.prop-value-type = 'character':U
     1488             then do:
     1489               assign
     1490                 ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
     1491               .
     1492             end.
     1493           end.
     1494           when 'inpptrl':U then do:
     1495             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
     1496               and thbjattr_thbj-attr.prop-value-type = 'character':U
     1497             then do:
     1498               assign
     1499                 ptrlprop-inpptrl = thbjattr_thbj-attr.property-value-character
     1500               .
     1501             end.
     1502           end.
     1503           when 'autopump':U then do:
     1504             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1505               assign
     1506                 ptrlprop-autopump = thbjattr_thbj-attr.property-value-logical
     1507               .
     1508             end.
     1509           end.
     1510           when 'rvsnmter':U then do:
     1511             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1512               assign
     1513                 ptrlprop-rvsnmter = thbjattr_thbj-attr.property-value-logical
     1514               .
     1515             end.
     1516           end.
     1517           when 'avtinvpm':U then do:
     1518             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1519               assign
     1520                 ptrlprop-avtinvpm = thbjattr_thbj-attr.property-value-logical
     1521               .
     1522             end.
     1523           end.
     1524           when 'invclipt':U then do:
     1525             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1526               assign
     1527                 ptrlprop-invclipt = thbjattr_thbj-attr.property-value-integer
     1528               .
     1529             end.
     1530           end.
     1531           when 'olddens':U then do:
     1532             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1533               assign
     1534                 ptrlprop-olddens = thbjattr_thbj-attr.property-value-logical
     1535               .
     1536             end.
     1537           end.
     1538           when 'algrvspt':U then do:
     1539             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1540               assign
     1541                 ptrlprop-algrvspt = thbjattr_thbj-attr.property-value-integer
     1542               .
     1543             end.
     1544           end.
     1545           when 'temp-for-pomi':U then do:
     1546             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1547               assign
     1548                 ptrlprop-temp-for-pomi = thbjattr_thbj-attr.property-value-integer
     1549               .
     1550             end.
     1551           end.
     1552           when 'algoincome':U then do:
     1553             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1554               assign
     1555                 ptrlprop-algoincome = thbjattr_thbj-attr.property-value-integer
     1556               .
     1557             end.
     1558           end.
     1559           when 'mand-choice-autocar':U then do:
     1560             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1561               assign
     1562                 ptrlprop-mand-choice-autocar = thbjattr_thbj-attr.property-value-logical
     1563               .
     1564             end.
     1565           end.
     1566           when 'block-nozzle':U then do:
     1567             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1568               assign
     1569                 ptrlprop-block-nozzle = thbjattr_thbj-attr.property-value-logical
     1570               .
     1571             end.
     1572           end.
     1573           when 'timeout-block-nozzle':U then do:
     1574             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1575               assign
     1576                 ptrlprop-timeout-block-nozzle = thbjattr_thbj-attr.property-value-integer
     1577               .
     1578             end.
     1579           end.
     1580           when 'Delta-mass-horiz':U then do:
     1581             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
     1582               assign
     1583                 ptrlprop-Delta-mass-horiz = thbjattr_thbj-attr.property-value-character
     1584               .
     1585             end.
     1586           end.
     1587           when 'Delta-mass-vert':U then do:
     1588             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
     1589               assign
     1590                 ptrlprop-Delta-mass-vert = thbjattr_thbj-attr.property-value-character
     1591               .
     1592             end.
     1593           end.
     1594           when 'calc-free-vol':U then do:
     1595             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1596               assign
     1597                 ptrlprop-calc-free-vol = thbjattr_thbj-attr.property-value-logical
     1598               .
     1599             end.
     1600           end.
     1601           when 'calc-free-vol-sug':U then do:
     1602             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1603               assign
     1604                 ptrlprop-calc-free-vol-sug = thbjattr_thbj-attr.property-value-logical
     1605               .
     1606             end.
     1607           end.
     1608           when 'trn-reas-sug':U then do:
     1609             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1610               assign
     1611                 ptrlprop-trn-reas-sug = thbjattr_thbj-attr.property-value-logical
     1612               .
     1613             end.
     1614           end.
     1615                 when 'rvd-own-nb':U then do:
     1616             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1617               assign
     1618                 ptrlprop-rvd-own-nb = thbjattr_thbj-attr.property-value-logical
     1619               .
     1620             end.
     1621           end.
     1622           when 'qr-scan-time':U then do:
     1623             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1624               assign
     1625                 ptrlprop-qr-scan-time = thbjattr_thbj-attr.property-value-integer
     1626               .
     1627             end.
     1628           end.
     1629           when 'autopump-skip-time':U then do:
     1630             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1631               assign
     1632                 ptrlprop-autopump-skip-time = thbjattr_thbj-attr.property-value-integer
     1633               .
     1634             end.
     1635           end.
     1636         end case.
     1637         delete thbjattr_thbj-attr .
     1638       end.
     1639     end.
     1640     return .
     1641   end procedure.
     1642   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1643   procedure cur-time :
     1644      define output parameter p-today as date      no-undo .
     1645      define output parameter p-time  as integer   no-undo .
     1646     do
     1647     on error undo, return error
     1648     :
     1649       define variable v-date1 as date      no-undo .
     1650       define variable v-date2 as date      no-undo .
     1651       define variable v-time  as integer   no-undo .
     1652       assign
     1653         v-date1 = today
     1654         v-time  = time
     1655         v-date2 = today
     1656       .
     1657       if v-date1 <> v-date2
     1658       then do:
     1659         assign
     1660           v-date1 = today
     1661           v-time  = v-time
     1662         .
     1663       end.
     1664       assign
     1665         p-today = v-date1
     1666         p-time  = v-time
     1667       .
     1668     end.
     1669   end.
     1670   function cur-time-date returns character
     1671   :
     1672     return string(today, '99/99/9999':U) .
     1673   end.
     1674   function cur-time-mjd returns decimal
     1675   :
     1676     define variable v-date as date      no-undo .
     1677     define variable v-time as integer   no-undo .
     1678     run cur-time in this-procedure
     1679       (output v-date
     1680       ,output v-time
     1681       ) .
     1682     return integer(v-date) - 2400002 + (v-time / 86400) .
     1683   end.
     1684   function cur-time-get-ending-index returns integer
     1685   (input p-number as integer
     1686   )
     1687   :
     1688     if p-number < 0
     1689     or p-number = ?
     1690     then do:
     1691       return 1 .
     1692     end.
     1693     define variable v-rest as integer   no-undo .
     1694     assign
     1695       p-number = p-number modulo 100
     1696     .
     1697     if p-number < 20
     1698     then do:
     1699       assign
     1700         v-rest = p-number
     1701       .
     1702     end.
     1703     else do:
     1704       assign
     1705         v-rest = p-number modulo 10
     1706       .
     1707     end.
     1708     case v-rest :
     1709       when 1
     1710       then do:
     1711         return 2 .
     1712       end.
     1713       when 2 or
     1714       when 3 or
     1715       when 4
     1716       then do:
     1717         return 3 .
     1718       end.
     1719       otherwise do:
     1720         return 1 .
     1721       end.
     1722     end case .
     1723   end.
     1724   procedure cur-time-mjd-to-date :
     1725      define input  parameter i-mjd-diff as decimal no-undo.
     1726      define output parameter o-Date     as date    no-undo.
     1727      define output parameter o-Time     as integer no-undo.
     1728      define variable v-day-number as integer   no-undo .
     1729      if    i-mjd-diff < 0
     1730         or i-mjd-diff = ?
     1731      then do:
     1732         return "?" .
     1733      end.
     1734      assign
     1735         v-day-number = truncate(i-mjd-diff,0).
     1736         o-Date = date(v-day-number + 2400002).
     1737         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1738     .
     1739   end.
     1740   function cur-time-mjd-to-string returns character
     1741   (input p-mjd-diff as decimal
     1742   )
     1743   :
     1744     define variable v-day-number as integer   no-undo .
     1745     define variable v-seconds    as integer   no-undo .
     1746     define variable v-hour       as integer   no-undo .
     1747     define variable v-min        as integer   no-undo .
     1748     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1749     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1750     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1751     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1752     if p-mjd-diff < 0
     1753     or p-mjd-diff = ?
     1754     then do:
     1755       return "?" .
     1756     end.
     1757     assign
     1758       v-day-number = integer(truncate(p-mjd-diff,0))
     1759       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1760     .
     1761     if v-seconds > 86400
     1762     then do:
     1763       assign
     1764         v-seconds = 86400 - 1
     1765       .
     1766     end.
     1767     if v-seconds < 0
     1768     then do:
     1769       assign
     1770         v-seconds = 0
     1771       .
     1772     end.
     1773     assign
     1774       v-hour = truncate(v-seconds / 3600, 0)
     1775     .
     1776     assign
     1777       v-seconds = v-seconds modulo 3600
     1778     .
     1779     assign
     1780       v-min = truncate(v-seconds / 60, 0)
     1781     .
     1782     assign
     1783       v-seconds = v-seconds modulo 60
     1784     .
     1785     return
     1786         (if v-day-number <> 0
     1787           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1788           else ""
     1789         )
     1790       + (if v-day-number <> 0 or v-hour <> 0
     1791           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1792           else ""
     1793         )
     1794       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1795           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1796           else ""
     1797         )
     1798       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1799       .
     1800   end.
     1801   function cur-time-string returns character
     1802   :
     1803     define variable v-date as date      no-undo .
     1804     define variable v-time as integer   no-undo .
     1805     run cur-time in this-procedure
     1806       (output v-date
     1807       ,output v-time
     1808       ) .
     1809     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1810   end.
     1811   function cur-time-string-sec returns character
     1812   :
     1813     define variable v-date as date      no-undo .
     1814     define variable v-time as integer   no-undo .
     1815     run cur-time in this-procedure
     1816       (output v-date
     1817       ,output v-time
     1818       ) .
     1819     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1820   end.
     1821   function cur-time-custom  returns character
     1822   (input p-prefix as character
     1823   ,input p-date-format as character
     1824   ,input p-delimiter as character
     1825   ,input p-time-format as character
     1826   ,input p-suffix as character
     1827   )
     1828   :
     1829     define variable v-date as date      no-undo .
     1830     define variable v-time as integer   no-undo .
     1831     run cur-time in this-procedure
     1832       (output v-date
     1833       ,output v-time
     1834       ) .
     1835     return
     1836       p-prefix
     1837       + string(v-date, p-date-format)
     1838       + p-delimiter
     1839       + string(v-time, p-time-format)
     1840       + p-suffix
     1841       .
     1842   end.
     1843   function cur-time-print  returns character
     1844   :
     1845     define variable v-date as date      no-undo .
     1846     define variable v-time as integer   no-undo .
     1847     run cur-time in this-procedure
     1848       (output v-date
     1849       ,output v-time
     1850       ) .
     1851     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1852   end.
     1853   function cur-time-datetime returns datetime
     1854   :
     1855     define variable v-char as character no-undo .
     1856     define variable v-datetime as datetime no-undo .
     1857     v-char = cur-time-string().
     1858     v-datetime = datetime(v-char).
     1859     return  v-datetime.
     1860   end.
     1861   function cur-time-string-msec returns character
     1862   :
     1863     define variable v-date as datetime  no-undo .
     1864     v-date = now.
     1865     return string(v-date) .
     1866   end.
