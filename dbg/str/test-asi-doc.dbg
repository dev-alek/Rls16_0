     2857   function getCalibrationBelt returns character
     2858     (
     2859     input iObjType as character,
     2860     input iObjCode as integer,
     2861     input iPlCode  as integer,
     2862     input iLevelNP as decimal,
     2863     input iLevelWater as decimal
     2864     )
     2865   :
     2866     define variable vCalibBelt      as  character         no-undo.
     2867     define buffer   buf_pl-level-mm for ub.pl-level-mm.
     2868     for each buf_pl-level-mm where
     2869              buf_pl-level-mm.obj-type = iObjType
     2870          and buf_pl-level-mm.obj-code = iObjCode
     2871          and buf_pl-level-mm.pl-code  = iPlCode
     2872          and ((buf_pl-level-mm.min-level <= iLevelNP and buf_pl-level-mm.max-level >= iLevelNP) or
     2873               (buf_pl-level-mm.min-level <= iLevelWater and buf_pl-level-mm.max-level >= iLevelWater))
     2874         no-lock
     2875         break by buf_pl-level-mm.zone by buf_pl-level-mm.level:
     2876       if first-of(buf_pl-level-mm.zone) then do:
     2877         vCalibBelt = substitute("&1&2;&3=",vCalibBelt, buf_pl-level-mm.min-level,buf_pl-level-mm.max-level).
     2878       end.
     2879       vCalibBelt = substitute("&1&2&3",vCalibBelt, if buf_pl-level-mm.level = 1 then "" else ";", trim(string(buf_pl-level-mm.capacity / 1000, ">>>>>9.999"))).
     2880       if last-of(buf_pl-level-mm.zone) and not last(buf_pl-level-mm.zone) then
     2881         vCalibBelt = substitute("&1&2",vCalibBelt, chr(10)).
     2882     end.
     2883     return vCalibBelt.
     2884   end.
     2885   define stream outstream.
     2886   define buffer r-doc             for ub.rvs-doc.
     2887   define buffer cur_shift-obj     for ub.shift-obj.
     2888   define buffer prev_shift-obj    for ub.shift-obj.
     2889   define buffer buf_rvs-line-attr for ub.rvs-line-attr.
     2890   define buffer buf_doc-attr      for ub.doc-attr.
     2891   define variable v-ref-rec         as recid     no-undo .
     2892   define variable ii                as integer   no-undo.
     2893   define variable bcol              as handle    extent 37 no-undo.
     2894   define variable isMeasurement     as logical   no-undo init no.
     2895   define variable rvs-line-rec      as recid     no-undo.
     2896   define variable varartic          like ub.doc-line.artic no-undo initial " ".
     2897   define variable ref-list          as character no-undo.
     2898   define variable l-g#stat          as character no-undo.
     2899   define variable l-g#type          as character no-undo.
     2900   define variable l-g#internal      as logical   no-undo.
     2901   define variable varres            as logical   no-undo initial ?.
     2902   define variable varrecid          as recid     no-undo.
     2903   define variable ptoldfilvalue     as character no-undo.
     2904   define variable ptoldfiltype      as character no-undo.
     2905   define variable varcur-data       as integer   no-undo.
     2906   define variable varnum            as integer   no-undo.
     2907   define variable varcur-rvs        as integer   no-undo.
     2908   define variable varcur-pump       as logical   no-undo.
     2909   define variable gds-rec           as recid     no-undo.
     2910   define variable notes             as character no-undo.
     2911   define variable rep-rec           as recid     no-undo.
     2912   define variable lns-cnt           as integer   no-undo.
     2913   define variable v-asi-ip          as character no-undo .
     2914   define variable v-asi-port        as character no-undo .
     2915   define variable v-asi-type        as character no-undo .
     2916   define variable v-attr-type       as character no-undo .
     2917   define variable vTimeAutoSkip     as integer  no-undo.
     2918   define buffer cli-buf      for ub.clients.
     2919   define buffer del-rvs-line for ub.rvs-line.
     2920   define buffer calc_r-line  for ub.rvs-line.
     2921   define button b-help
     2922     label "Помощь":U
     2923     size 10 by 1.
     2924   define button b-exit auto-go
     2925     label "Выход":U
     2926     size 10 by 1.
     2927   define button b-mark
     2928     label "&*":U
     2929     size 3 by 1.
     2930   define button b-add
     2931     label "Добавить":U
     2932     size 10 by 1.
     2933   define button b-lkp
     2934     label "Просмотр":U
     2935     size 10 by 1.
     2936   define button b-chg
     2937     label "Изменить":U
     2938     size 10 by 1.
     2939   define button b-del
     2940     label "Удалить":U
     2941     size 10 by 1.
     2942   define button b-history
     2943     label "История":U
     2944     size 10 by 1.
     2945   define button b-notes
     2946     label "Прим.":U
     2947     size 10 by 1.
     2948   define button b-meas
     2949     label "Измерение"
     2950     size 10 by 1.
     2951   define button b-commission
     2952     label "Состав комиссии":U
     2953     size 20 by 1.
     2954   define menu m-meas
     2955     menu-item m-meas-1 label "Всех резервуаров в документе" accelerator "alt-1"
     2956     menu-item m-meas-3 label "Текущего резервуара"          accelerator "alt-3".
     2957   define button r-acc
     2958     image-up          file "btn-down-arrow"
     2959     image-down        file "btn-down-arrow"
     2960     image-insensitive file "btn-down-arrow"
     2961     size 3 by .88.
     2962   define button r-agnt     like r-acc.
     2963   define button r-boss     like r-acc.
     2964   define button r-wrkr     like r-acc.
     2965   define variable agnt-name as character format "x(256)":u
     2966     view-as text
     2967     size 11.2 by 1 no-undo.
     2968   define variable boss-name as character format "x(256)":u
     2969     view-as text
     2970     size 11.2 by 1 no-undo.
     2971   define variable wrkr-name as character format "x(256)":u
     2972     view-as text
     2973     size 11.2 by 1 no-undo.
     2974   define variable del-list  as character no-undo.
     2975   function get-mark return character (buffer local-rvs-line for ub.rvs-line ).
     2976     if lookup (string (recid (local-rvs-line)), del-list) > 0 then return "*".
     2977     else return "".
     2978   end function.
     2979   function deviation-fact    return decimal (buffer local-rvs-line for ub.rvs-line ).
     2980     return (local-rvs-line.state-measure-qnty   + local-rvs-line.state-add-qnty - local-rvs-line.system-qnty).
     2981   end function.
     2982   function deviation-measure return decimal (buffer local-rvs-line for ub.rvs-line ).
     2983     return (local-rvs-line.measure-qnty + local-rvs-line.state-add-qnty - local-rvs-line.system-qnty).
     2984   end function.
     2985   define query br-line      for ub.rvs-line, ub.goods, ub.place scrolling.
     2986   define browse br-line query br-line no-lock display
     2987     get-mark (buffer ub.rvs-line)  column-label '*'  format "x(1)"
     2988     place.loc1  column-label 'Номер резервуара'
     2989     ub.goods.gds-name  column-label 'Название'  format "x(256)" width 29
     2990     ub.rvs-line.pl-code  column-label 'Скл.место'  FORMAT "9999999999":U width 12
     2991     ub.goods.gds-code  column-label 'Бар-код'  FORMAT "9999999999":U width 12
     2992   with size 75.25 by 9 separators.
     2993   define frame d-rvs
     2994     b-exit              at row 1  col 1
     2995     b-notes             at row 1  col 11
     2996     b-history           at row 1  col 39
     2997     b-help              at row 1  col 49
     2998     "Объект:"                         at row 2 col 10
     2999     r-doc.obj-code                    at row 2 col 16   colon-aligned no-label       view-as text size 7    by 1
     3000     r-doc.obj-type                    at row 2 col 23   colon-aligned no-label       view-as text size 7.13 by 1
     3001     ub.clients.obj-name               at row 2 col 33   colon-aligned no-label       view-as text size 40 by 1 fgcolor 4
     3002     r-doc.doc-date                    at row 3 col 40   colon-aligned view-as text
     3003     r-doc.wrkr                        at row 5 col 4.5  colon-aligned format "999999999"  view-as fill-in size 10 by 1
     3004     wrkr-name                         at row 5 col 15   colon-aligned no-label fgcolor 4
     3005     r-wrkr                            at row 5 col 28   no-label
     3006     r-doc.agnt                        at row 6 col 4.5 colon-aligned format "999999999"  view-as fill-in size 10 by 1
     3007     agnt-name                         at row 6 col 15  colon-aligned no-label fgcolor 4
     3008     r-agnt                            at row 6 col 28  no-label
     3009     r-doc.boss                    at row 7 col 4.5   colon-aligned format "999999999"       view-as fill-in size 10 by 1
     3010     boss-name                     at row 7 col 15    colon-aligned no-label                fgcolor 4
     3011     r-boss                        at row 7 col 28    no-label
     3012     b-mark              at row 8  col 1
     3013     b-add               at row 8  col 4
     3014     b-del               at row 8  col 14
     3015     b-meas              at row 8  col 24
     3016     b-lkp               at row 8  col 34
     3017     b-chg               at row 8  col 44
     3018     b-commission        at row 4  col 1
     3019     br-line      at row 9  col 1
     3020     space(0) skip(0)
     3021     with view-as dialog-box side-labels three-d scrollable keep-tab-order.
     3022   assign
     3023     frame d-rvs:scrollable                                = false
     3024     b-meas             :popup-menu in frame d-rvs         = menu m-meas:handle
     3025     b-meas             :menu-mouse                                = 1.
     3026   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3027   on F9 of frame d-rvs anywhere do:
     3028     if not available ub.goods then
     3029       return no-apply.
     3030     gds-rec = recid (ub.goods).
     3031     run ref/gds-form.w ( input parparentproc
     3032                         ,input 'ПРОСМОТР':U
     3033                         ,input ?
     3034                         ,input ?
     3035                         ,input ?
     3036                         ,input-output gds-rec).
     3037     apply "entry" to br-line in frame d-rvs.
     3038     return no-apply.
     3039   end.
     3040   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3041   on F3 of frame d-rvs anywhere do:
     3042     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame d-rvs. END.
     3043     return no-apply.
     3044   end.
     3045   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3046   on F4 of frame d-rvs anywhere do:
     3047     if b-chg :sensitive then DO: apply "CHOOSE":U to b-chg in frame d-rvs. END.
     3048     return no-apply.
     3049   end.
     3050   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3051   on F8 of frame d-rvs anywhere do:
     3052     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame d-rvs. END.
     3053     return no-apply.
     3054   end.
     3055   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3056   on INS of frame d-rvs anywhere do:
     3057     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame d-rvs. END.
     3058     return no-apply.
     3059   end.
     3060   on end-error, stop of frame d-rvs
     3061     do:
     3062       apply "choose" to b-exit in frame d-rvs.
     3063       return no-apply.
     3064     end.
     3065   on choose of b-notes in frame d-rvs
     3066     do:
     3067       assign
     3068         notes = r-doc.ps.
     3069       run gbl/notes.w ( input pardoc-mode, input-output notes ).
     3070       if r-doc.ps <> notes then
     3071       do:
     3072         do on stop undo, return no-apply :
     3073           find r-doc exclusive-lock where recid (r-doc) = par_test-asi-rec.
     3074           assign
     3075             r-doc.ps = notes.
     3076         end.
     3077       end.
     3078     end.
     3079   on choose of b-history in frame d-rvs
     3080     do:
     3081       define variable v-list as character no-undo.
     3082       if available r-doc then
     3083       do:
     3084         run str/rvscdocs.w ( input        parparentproc,
     3085           input        "":U,
     3086           input        "one":U,
     3087           input        r-doc.rvs-code,
     3088           input-output v-list                  ).
     3089       end.
     3090     end.
     3091   on choose of b-exit in frame d-rvs
     3092     do:
     3093       if pardoc-mode = 'ИЗМЕНЕНИЕ':U  or
     3094         pardoc-mode = 'ДОБАВЛЕНИЕ':U then
     3095       do:
     3096         if not can-find (first ub.rvs-line where ub.rvs-line.rvs-code = r-doc.rvs-code no-lock) then
     3097         do:
     3098           varlog = yes.
     3099           message "В документе нет строк, поэтому он удаляется." view-as alert-box
     3100             question buttons ok-cancel update varlog.
     3101           if varlog then
     3102           do:
     3103             delete r-doc.
     3104             par_test-asi-rec = ?.
     3105             return.
     3106           end.
     3107           else return no-apply.
     3108         end.
     3109         assign r-doc.wrkr r-doc.agnt r-doc.boss.
     3110       end.
     3111     end.
     3112   on mouse-select-dblclick, return of r-doc.agnt in frame d-rvs
     3113     do:
     3114       run local-psn-chk in this-procedure ( input "agnt", input "ret-mouse" ).
     3115       apply "entry" to r-doc.boss in frame d-rvs.
     3116       return no-apply.
     3117     end.
     3118   on mouse-select-dblclick, return of r-doc.boss in frame d-rvs
     3119     do:
     3120       run local-psn-chk in this-procedure ( input "boss", input "ret-mouse" ).
     3121       apply "entry" to b-exit in frame d-rvs.
     3122       return no-apply.
     3123     end.
     3124   on mouse-select-dblclick, return of r-doc.wrkr in frame d-rvs
     3125     do:
     3126       run local-psn-chk in this-procedure ( input "wrkr", input "ret-mouse" ).
     3127       apply "entry" to r-doc.agnt in frame d-rvs.
     3128       return no-apply.
     3129     end.
     3130   on choose of r-agnt in frame d-rvs
     3131     do:
     3132       run local-psn-chk in this-procedure ( input "agnt", input "button" ).
     3133       apply "entry" to r-doc.boss in frame d-rvs.
     3134       return no-apply.
     3135     end.
     3136   on choose of r-boss in frame d-rvs
     3137     do:
     3138       run local-psn-chk in this-procedure ( input "boss", input "button" ).
     3139       apply "entry" to b-exit in frame d-rvs.
     3140       return no-apply.
     3141     end.
     3142   on choose of r-wrkr in frame d-rvs
     3143     do:
     3144       run local-psn-chk in this-procedure ( input "wrkr", input "button" ).
     3145       apply "entry" to r-doc.agnt in frame d-rvs.
     3146       return no-apply.
     3147     end.
     3148   on leave of r-doc.agnt in frame d-rvs
     3149     do:
     3150       run local-psn-chk in this-procedure ( input "agnt", input "leave" ).
     3151     end.
     3152   on leave of r-doc.boss in frame d-rvs
     3153     do:
     3154       run local-psn-chk in this-procedure ( input "boss", input "leave" ).
     3155     end.
     3156   on leave of r-doc.wrkr in frame d-rvs
     3157     do:
     3158       run local-psn-chk in this-procedure ( input "wrkr", input "leave" ).
     3159     end.
     3160   on return, mouse-select-dblclick of br-line in frame d-rvs
     3161     do:
     3162       if b-chg:sensitive then apply "choose" to b-chg in frame d-rvs.
     3163       else apply "choose" to b-lkp in frame d-rvs.
     3164     end.
     3165   on choose of b-mark in frame d-rvs
     3166     do:
     3167       run local-mark in this-procedure.
     3168       varlog = br-line:select-next-row ().
     3169       apply "entry" to br-line in frame d-rvs.
     3170     end.
     3171   on choose of b-add in frame d-rvs
     3172   do :
     3173     define buffer buf_rvs-line for ub.rvs-line .
     3174     define buffer buf_place    for ub.place .
     3175     define buffer buf_pl-gds   for ub.pl-gds .
     3176     define variable place-list as character no-undo .
     3177     run ref/pl-list.w (
     3178      input parparentproc
     3179     ,input "b-sel,b-mark"
     3180     ,input r-doc.obj-type
     3181     ,input r-doc.obj-code
     3182     ,input 'объект':U + chr(4) + "only-np"
     3183     ,input-output place-list).
     3184     if place-list = "cancel"
     3185     then do :
     3186       return no-apply .
     3187     end .
     3188     do ii = 1 to num-entries(place-list) :
     3189       find first buf_place no-lock where recid(buf_place) = integer(entry(ii, place-list)) .
     3190       find first buf_pl-gds no-lock where
     3191         buf_pl-gds.obj-type = buf_place.obj-type and
     3192         buf_pl-gds.obj-code = buf_place.obj-code and
     3193         buf_pl-gds.pl-code  = buf_place.pl-code  no-error.
     3194       if not available buf_pl-gds then
     3195       do:
     3196         message substitute("Ошибка при выборке складского места &1. К нему не привязан товар.", buf_place.loc1)
     3197           view-as alert-box .
     3198         next.
     3199       end.
     3200       find first buf_rvs-line no-lock where
     3201         buf_rvs-line.rvs-code = r-doc.rvs-code and
     3202         buf_rvs-line.gds-code = buf_pl-gds.gds-code       and
     3203         buf_rvs-line.pl-code  = buf_pl-gds.pl-code       no-error.
     3204       if available buf_rvs-line then
     3205       do:
     3206         message "Складское место " buf_place.loc1
     3207           " уже имеется в данном документе проверки корректности работы АСИ в резервуаре." skip
     3208           view-as alert-box.
     3209         next.
     3210       end.
     3211       tr:
     3212       do transaction :
     3213   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_crrvslin in g#lib-rvs ( input r-doc.obj-type ,
     3214                         input r-doc.obj-code ,
     3215                         input r-doc.rvs-code ,
     3216                         input r-doc.rvs-type ,
     3217                         input buf_pl-gds.pl-code ,
     3218                         input buf_pl-gds.gds-code ,
     3219                         input ? ,
     3220                         input if available cur_shift-obj then cur_shift-obj.shift-date else ? ,
     3221                         input if available cur_shift-obj then cur_shift-obj.shift-num else ? ) no-error .
     3222         if error-status :error then
     3223         do:
     3224           message "Ошибка при создании линии. "
     3225             return-value
     3226             view-as alert-box error.
     3227           undo tr, return no-apply.
     3228         end.
     3229         if return-value begins "GAS!"
     3230         or return-value begins "NMS!"
     3231         or return-value begins "VIR!"
     3232         then do :
     3233           message substring(return-value, 5) view-as alert-box .
     3234           undo tr, next .
     3235         end .
     3236       end.
     3237     end .
     3238     run ui-on in this-procedure no-error.
     3239     if error-status :error then
     3240     do:
     3241       return no-apply.
     3242     end.
     3243     apply "entry" to b-add in frame d-rvs.
     3244     return no-apply.
     3245   end .
     3246   on choose of b-commission in frame d-rvs
     3247   do:
     3248     do on stop undo, return no-apply :
     3249       run str/test-asi-commission.w (input r-doc.rvs-code,
     3250                                      input pardoc-mode)
     3251                                      .
     3252     end.
     3253   end.
     3254   on choose of b-chg in frame d-rvs
     3255   do:
     3256     do on stop undo, return no-apply :
     3257       if not available ub.rvs-line then
     3258       do:
     3259         message "Неправильный выбор строки.".
     3260         return no-apply.
     3261       end.
     3262       run local-chg in this-procedure no-error.
     3263       if error-status :error then
     3264       do:
     3265         return no-apply.
     3266       end.
     3267       run ui-on in this-procedure .
     3268     end.
     3269   end.
     3270   on choose of b-del in frame d-rvs
     3271   do:
     3272     run del-rvs-line in this-procedure no-error.
     3273     if error-status :error then
     3274     do:
     3275       return no-apply.
     3276     end.
     3277     assign
     3278       rvs-line-rec = rep-rec.
     3279     run ui-on in this-procedure.
     3280   end.
     3281   on choose of b-lkp in frame d-rvs
     3282   do:
     3283     run proc-lkp in this-procedure no-error.
     3284     if error-status :error then
     3285     do:
     3286       return no-apply.
     3287     end.
     3288   end.
     3289   on choose of menu-item m-meas-1 in menu m-meas
     3290   do:
     3291     run proc_m-meas-1 in this-procedure no-error.
     3292     if error-status :error then
     3293     do:
     3294       return no-apply.
     3295     end.
     3296   end.
     3297   on choose of menu-item m-meas-3 in menu m-meas
     3298   do:
     3299     run proc_m-meas-3 in this-procedure no-error.
     3300     if error-status :error then
     3301     do:
     3302       return no-apply.
     3303     end.
     3304   end.
     3305   def var sort-labelbr-line   as character no-undo .
     3306   def var sort-clmnbr-line    as handle    no-undo .
     3307   def var cur-clmnbr-line     as handle    no-undo .
     3308   def var cur-clmn-locbr-line as integer   no-undo .
     3309   def var re-querybr-line     as logical   initial no no-undo .
     3310   on start-search, ctrl-o of br-line in frame d-rvs do:
     3311      run sort-brbr-line
     3312        (input (if available ub.rvs-line
     3313                then recid(ub.rvs-line)
     3314                else ?
     3315               )
     3316        ).
     3317   end.
     3318   PROCEDURE sort-brbr-line :
     3319     define input parameter p-recid as recid no-undo .
     3320     if re-querybr-line = no then do:
     3321       assign
     3322          cur-clmnbr-line = br-line:current-column in frame d-rvs
     3323       .
     3324       if sort-clmnbr-line <> ? then sort-clmnbr-line:column-fgcolor = 0.
     3325       if cur-clmnbr-line = sort-clmnbr-line then do:
     3326         assign
     3327            sort-labelbr-line = ""
     3328            sort-clmnbr-line = ?
     3329         .
     3330        end.
     3331        else do:
     3332          assign
     3333            sort-labelbr-line = cur-clmnbr-line:label
     3334            sort-clmnbr-line  = cur-clmnbr-line
     3335            sort-clmnbr-line:column-fgcolor = 4
     3336          .
     3337        end.
     3338      end.
     3339     assign
     3340       cur-clmn-locbr-line = 1
     3341     .
     3342     def var column-handle as handle no-undo .
     3343     column-handle = br-line:first-column.
     3344     do while valid-handle(column-handle) :
     3345       if column-handle = cur-clmnbr-line then do:
     3346         leave .
     3347       end.
     3348       column-handle = column-handle:NEXT-COLUMN.
     3349       assign
     3350         cur-clmn-locbr-line = cur-clmn-locbr-line + 1
     3351       .
     3352     end.
     3353     case sort-labelbr-line:
     3354           when '*'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by get-mark (buffer ub.rvs-line) .   . END.
     3355           when 'Номер резервуара'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by place.loc1 .   . END.
     3356           when 'Название'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.goods.gds-name .   . END.
     3357           when 'Скл.место'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.rvs-line.pl-code .   . END.
     3358           when 'Бар-код'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code  and              ub.place.status_ <>      'удал':U by ub.goods.gds-code .   . END.
     3359       otherwise do:
     3360         open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code  and              ub.place.status_ <>      'удал':U.
     3361           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-line') then do:
     3362             run mv-brw-defaultbr-line.
     3363           end.
     3364         if sort-labelbr-line <> "" then do:
     3365           assign
     3366             cur-clmnbr-line:column-fgcolor = 0
     3367           .
     3368         end.
     3369         assign
     3370           cur-clmn-locbr-line = ?
     3371         .
     3372       end.
     3373     end case.
     3374       if cur-clmn-locbr-line <> ? then do:
     3375         if can-do( this-procedure:internal-entries, 'ch-clmnbr-line') then do:
     3376           run ch-clmnbr-line in this-procedure (cur-clmn-locbr-line).
     3377         end.
     3378       end.
     3379     if p-recid <> ? then do:
     3380       reposition br-line to recid p-recid no-error.
     3381       apply "value-changed" to br-line in frame d-rvs.
     3382     end.
     3383     apply "entry" to br-line in frame d-rvs.
     3384   END PROCEDURE.
     3385   procedure re-open-query-srt-clmnbr-line:
     3386   if cur-clmnbr-line = ? then do:
     3387      open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code  and              ub.place.status_ <>      'удал':U.
     3388   end.
     3389   else do:
     3390      assign re-querybr-line = yes.
     3391      run sort-brbr-line
     3392        (input (if available ub.rvs-line
     3393                then recid(ub.rvs-line)
     3394                else ?
     3395               )
     3396        ).
     3397      assign re-querybr-line = no.
     3398   end.
     3399   end.
     3400   on value-changed of br-line in frame d-rvs
     3401   do:
     3402   end.
     3403   ON ROW-DISPLAY OF br-line IN FRAME d-rvs
     3404     DO:
     3405     END.
     3406   if valid-handle(active-window) and frame d-rvs:parent eq ?
     3407     then frame d-rvs:parent = active-window.
     3408   on window-close of frame d-rvs
     3409     apply "end-error":u to self.
     3410   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3411   on help of frame d-rvs
     3412   do:
     3413     run gbl/app_help.p
     3414       (input this-procedure :file-name
     3415       ,input ''
     3416       ,input ?
     3417       ) no-error.
     3418     if error-status :error then do:
     3419       message
     3420         "Ошибка при вызове помощи"
     3421         error-status :get-message(1)
     3422         view-as alert-box .
     3423     end.
     3424   end.
     3425   run minbtn-set in this-procedure .
     3426   on choose of b-help in frame d-rvs
     3427   do:
     3428     apply "help":u to frame d-rvs .
     3429   end.
     3430   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3431   procedure minbtn-set :
     3432       do
     3433           on error undo, return error return-value
     3434           :
     3435           define variable ii              as integer       no-undo .
     3436           define variable fh              as widget-handle no-undo .
     3437           define variable hh              as widget-handle no-undo .
     3438           define variable v-h             as handle        extent 4 no-undo .
     3439           define variable v-name-button   as character     no-undo .
     3440           define variable v-help-old-x    as decimal       no-undo .
     3441           define variable v-help-old-y    as decimal       no-undo .
     3442           define variable v-help-old-size as decimal       no-undo .
     3443           define variable v-frame-width   as decimal       no-undo .
     3444           define variable jj              as integer       no-undo .
     3445           do
     3446               on error undo, return error
     3447               :
     3448               assign
     3449                   v-frame-width = frame d-rvs:width - 0.3
     3450                   fh            = frame d-rvs:first-child
     3451                   hh            = fh:first-child
     3452                   ii            = 1
     3453                   .
     3454               do while valid-handle(hh):
     3455                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3456                   do:
     3457                       case lc(hh:name) :
     3458                           when "b-help" then
     3459                               do:
     3460                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3461                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3462                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3463                                   hh:TOOLTIP = "Помощь" .
     3464                                   v-help-old-x = hh:column .
     3465                                   v-help-old-y = hh:row    .
     3466                                   v-help-old-size = hh:width .
     3467                                   hh:width-chars = 2.5 .
     3468                               end.
     3469                           when "b-print" then
     3470                               do:
     3471                                   hh:load-image("cmp/b-print.bmp":u) .
     3472                                   hh:TOOLTIP = "Печать" .
     3473                                   v-h[ii] = hh:handle .
     3474                                   ii = ii + 1 .
     3475                                   hh:width-chars = 3 .
     3476                               end.
     3477                           when "b-history" or
     3478                           when "b-hist" then
     3479                               do:
     3480                                   hh:load-image("cmp/b-hist.bmp":u) .
     3481                                   hh:TOOLTIP = "История" .
     3482                                   v-h[ii] = hh:handle .
     3483                                   ii = ii + 1 .
     3484                                   hh:width-chars = 3 .
     3485                               end.
     3486                           when "b-sch" then
     3487                               do:
     3488                                   hh:load-image("cmp/b-sch.bmp":u) .
     3489                                   hh:TOOLTIP = "Установка Фильтра" .
     3490                                   v-h[ii] = hh:handle .
     3491                                   ii = ii + 1 .
     3492                                   hh:width-chars = 3 .
     3493                               end.
     3494                           when "b-hist-user" then
     3495                               do:
     3496                                   hh:load-image("cmp/b-hist.bmp":u) .
     3497                                   hh:TOOLTIP = "История пользователя" .
     3498                                   ii = ii + 1 .
     3499                               end.
     3500                       end case.
     3501                   end.
     3502                   hh = hh:next-sibling.
     3503               end.
     3504               b-help:column = v-frame-width - b-help:width-chars.
     3505               jj = 0.
     3506               repeat ii = 4 to 1 by -1 :
     3507                   if valid-handle (v-h[ii] ) then
     3508                   do:
     3509                       jj  = jj + 1 .
     3510                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3511                       v-h[ii]:row    = v-help-old-y .
     3512                   end.
     3513               end.
     3514           end.
     3515       end.
     3516   end procedure.
     3517   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3518   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3519   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3520   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3521   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3522   define variable v-diasize-current-frame-height as decimal   no-undo .
     3523   define variable v-diasize-change-size          as logical   no-undo .
     3524   define variable v-diasize-resize-button        as handle    no-undo .
     3525   define variable v-diasize-wndmax               as logical   no-undo .
     3526   define variable v-diasize-wndstore             as logical   no-undo .
     3527   define variable v-diasize-proc-name            as character no-undo .
     3528   define variable v-diasize-browse-handle        as handle    no-undo .
     3529   define variable v-diasize-browse-number        as integer   no-undo .
     3530   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3531   define temp-table temp-diasize-handle no-undo
     3532     field handle-value  as handle
     3533     field save-position as decimal
     3534     index xpk is primary unique handle-value
     3535     .
     3536   define temp-table temp-browse-handle no-undo
     3537     field browse-type   as character
     3538     field browse-number as integer
     3539     field browse-handle as handle
     3540     field original-size as decimal
     3541     index xpk is primary unique browse-type browse-number
     3542     index xie browse-type browse-handle
     3543   .
     3544   procedure diasize_change-height :
     3545     define input  parameter p-change-value  as decimal   no-undo .
     3546     define input  parameter p-move-resize   as logical   no-undo .
     3547     define variable v-field-group-handle    as handle    no-undo .
     3548     define variable v-object-handle         as handle    no-undo .
     3549     define variable v-frame-height          as decimal   no-undo .
     3550     define variable v-frame-virtual-height  as decimal   no-undo .
     3551     define variable v-browse-height         as decimal   no-undo .
     3552     define variable v-window-height         as decimal   no-undo .
     3553     define variable v-window-virtual-height as decimal   no-undo .
     3554     define variable v-change-sign           as integer   no-undo .
     3555     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3556     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3557     if p-change-value > 0
     3558     then do:
     3559       if frame d-rvs :height + p-change-value
     3560           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3561       then do:
     3562         assign
     3563           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3564                           - (frame d-rvs :height-chars)
     3565         .
     3566         if p-change-value <= 0
     3567         then do:
     3568           run diasize_position-resize-button in this-procedure .
     3569           return .
     3570         end.
     3571       end.
     3572     end.
     3573     if p-change-value < 0
     3574     then do:
     3575       if frame d-rvs :height + p-change-value < v-diasize-orig-frame-height
     3576       then do:
     3577         assign
     3578           p-change-value = v-diasize-orig-frame-height
     3579                          - (frame d-rvs :height-chars)
     3580         .
     3581         if p-change-value >= 0
     3582         then do:
     3583           run diasize_position-resize-button in this-procedure .
     3584           return .
     3585         end.
     3586       end.
     3587     end.
     3588     if p-change-value >= 0
     3589     then do:
     3590       assign
     3591         v-change-sign = 1
     3592       .
     3593     end.
     3594     else do:
     3595       assign
     3596         v-change-sign = -1
     3597       .
     3598     end.
     3599     assign
     3600       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3601     .
     3602     if p-change-value = 0
     3603     then do:
     3604       run diasize_position-resize-button in this-procedure .
     3605       return .
     3606     end.
     3607     move_block:
     3608     do
     3609     on error undo move_block, retry move_block
     3610     :
     3611       if retry
     3612       then do:
     3613         do
     3614         on error undo move_block, leave move_block
     3615         :
     3616           if p-change-value > 0
     3617           then do:
     3618             for each buf_temp-diasize-handle
     3619             on error undo, next
     3620             :
     3621               assign
     3622                 v-object-handle = buf_temp-diasize-handle.handle-value
     3623               .
     3624               if v-object-handle <> v-diasize-resize-button
     3625               then do:
     3626                 assign
     3627                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3628                 .
     3629               end.
     3630             end.
     3631             assign
     3632               v-diasize-browse-handle :height = v-browse-height
     3633             .
     3634             for each buf_temp-browse-handle
     3635               where buf_temp-browse-handle.browse-type = 'height':u
     3636             on error undo, next
     3637             :
     3638               assign
     3639                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3640               .
     3641             end.
     3642             assign
     3643               frame d-rvs :height = v-frame-height
     3644             .
     3645             if frame d-rvs :scrollable = true
     3646             then do:
     3647               assign
     3648                 frame d-rvs :virtual-height = v-frame-virtual-height
     3649               .
     3650             end.
     3651             run diasize_position-resize-button in this-procedure .
     3652           end.
     3653           else do:
     3654             if frame d-rvs :scrollable = true
     3655             then do:
     3656               assign
     3657                 frame d-rvs :virtual-height = v-frame-virtual-height
     3658               .
     3659             end.
     3660             assign
     3661               frame d-rvs :height = v-frame-height
     3662             .
     3663             assign
     3664               v-diasize-browse-handle :height = v-browse-height
     3665             .
     3666             for each buf_temp-browse-handle
     3667               where buf_temp-browse-handle.browse-type = 'height':u
     3668             on error undo, next
     3669             :
     3670               assign
     3671                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3672               .
     3673             end.
     3674             for each buf_temp-diasize-handle
     3675             on error undo, next
     3676             :
     3677               assign
     3678                 v-object-handle = buf_temp-diasize-handle.handle-value
     3679               .
     3680               if v-object-handle <> v-diasize-resize-button
     3681               then do:
     3682                 assign
     3683                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3684                 .
     3685               end.
     3686             end.
     3687             run diasize_position-resize-button in this-procedure .
     3688           end.
     3689           assign
     3690             v-diasize-change-size = false
     3691           .
     3692           leave move_block .
     3693         end.
     3694       end.
     3695       assign
     3696         v-diasize-need-full-display = true
     3697       .
     3698       if v-diasize-change-size = false
     3699       then do:
     3700         assign
     3701           v-diasize-change-size = true
     3702         .
     3703       end.
     3704       else do:
     3705         return .
     3706       end.
     3707       assign
     3708         v-frame-height = frame d-rvs :height
     3709         v-frame-virtual-height = frame d-rvs :virtual-height
     3710         v-browse-height = v-diasize-browse-handle :height
     3711       .
     3712       for each buf_temp-browse-handle
     3713         where buf_temp-browse-handle.browse-type = 'height':u
     3714       :
     3715         assign
     3716           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3717         .
     3718       end.
     3719       for each buf_temp-diasize-handle
     3720       :
     3721         delete buf_temp-diasize-handle .
     3722       end.
     3723       assign
     3724         v-field-group-handle = frame d-rvs :first-child
     3725       .
     3726       do while valid-handle(v-field-group-handle)
     3727       :
     3728         assign
     3729           v-object-handle = v-field-group-handle :first-child
     3730         .
     3731         do while valid-handle(v-object-handle)
     3732         :
     3733           if  v-object-handle <> v-diasize-browse-handle :handle
     3734           and can-query(v-object-handle, "row")
     3735           and can-query(v-object-handle, "height")
     3736           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3737           then do:
     3738             find first buf_temp-browse-handle
     3739               where buf_temp-browse-handle.browse-type   = 'height':u
     3740                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3741               no-error .
     3742             if available buf_temp-browse-handle
     3743             then do:
     3744             end.
     3745             else do:
     3746               create buf_temp-diasize-handle .
     3747               assign
     3748                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3749                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3750               .
     3751             end.
     3752           end.
     3753           assign
     3754             v-object-handle = v-object-handle :next-sibling
     3755           .
     3756         end.
     3757         assign
     3758           v-field-group-handle = v-field-group-handle :next-sibling
     3759         .
     3760       end.
     3761       do with frame d-rvs
     3762       :
     3763         hide v-diasize-resize-button .
     3764         assign
     3765           v-diasize-resize-button :row    = 1
     3766           v-diasize-resize-button :column = 1
     3767         .
     3768       end.
     3769       if p-change-value > 0
     3770       then do:
     3771         if frame d-rvs :scrollable = true
     3772         then do:
     3773           assign
     3774             frame d-rvs :virtual-height = frame d-rvs :virtual-height + p-change-value
     3775             no-error .
     3776           if error-status :error
     3777           or error-status :get-message(1) <> ""
     3778           then do:
     3779             undo move_block, retry move_block .
     3780           end.
     3781         end.
     3782         assign
     3783           frame d-rvs :height = frame d-rvs :height + p-change-value
     3784           no-error .
     3785         if error-status :error
     3786         or error-status :get-message(1) <> ""
     3787         then do:
     3788           undo move_block, retry move_block .
     3789         end.
     3790         assign
     3791           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3792           no-error .
     3793         if error-status :error
     3794         or error-status :get-message(1) <> ""
     3795         then do:
     3796           undo move_block, retry move_block .
     3797         end.
     3798         for each buf_temp-browse-handle
     3799           where buf_temp-browse-handle.browse-type = 'height':u
     3800         on error undo move_block, retry move_block
     3801         :
     3802           assign
     3803             buf_temp-browse-handle.browse-handle :height
     3804               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3805             no-error .
     3806           if error-status :error
     3807           or error-status :get-message(1) <> ""
     3808           then do:
     3809             undo move_block, retry move_block .
     3810           end.
     3811         end.
     3812         for each buf_temp-diasize-handle
     3813         on error undo move_block, retry move_block
     3814         :
     3815           assign
     3816             v-object-handle = buf_temp-diasize-handle.handle-value
     3817           .
     3818           if v-object-handle <> v-diasize-resize-button
     3819           then do:
     3820             assign
     3821               v-object-handle :row = v-object-handle :row + p-change-value
     3822               no-error .
     3823             if error-status :error
     3824             or error-status :get-message(1) <> ""
     3825             then do:
     3826               undo move_block, retry move_block .
     3827             end.
     3828           end.
     3829         end.
     3830       end.
     3831       else do:
     3832         for each buf_temp-diasize-handle
     3833         on error undo move_block, retry move_block
     3834         :
     3835           assign
     3836             v-object-handle = buf_temp-diasize-handle.handle-value
     3837           .
     3838           if v-object-handle <> v-diasize-resize-button
     3839           then do:
     3840             assign
     3841               v-object-handle :row = v-object-handle :row + p-change-value
     3842               no-error .
     3843             if error-status :error
     3844             or error-status :get-message(1) <> ""
     3845             then do:
     3846               undo move_block, retry move_block .
     3847             end.
     3848           end.
     3849         end.
     3850         assign
     3851           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3852           no-error .
     3853         if error-status :error
     3854         or error-status :get-message(1) <> ""
     3855         then do:
     3856           undo move_block, retry move_block .
     3857         end.
     3858         for each buf_temp-browse-handle
     3859           where buf_temp-browse-handle.browse-type = 'height':u
     3860         on error undo move_block, retry move_block
     3861         :
     3862           assign
     3863             buf_temp-browse-handle.browse-handle :height
     3864               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3865             no-error .
     3866           if error-status :error
     3867           or error-status :get-message(1) <> ""
     3868           then do:
     3869             undo move_block, retry move_block .
     3870           end.
     3871         end.
     3872         assign
     3873           frame d-rvs :height = frame d-rvs :height + p-change-value
     3874           no-error .
     3875         if error-status :error
     3876         or error-status :get-message(1) <> ""
     3877         then do:
     3878           undo move_block, retry move_block .
     3879         end.
     3880         if frame d-rvs :scrollable = true
     3881         then do:
     3882           assign
     3883             frame d-rvs :virtual-height = frame d-rvs :virtual-height + p-change-value
     3884             no-error .
     3885           if error-status :error
     3886           or error-status :get-message(1) <> ""
     3887           then do:
     3888             undo move_block, retry move_block .
     3889           end.
     3890         end.
     3891       end.
     3892       if p-move-resize = true
     3893       then do:
     3894         run diasize_position-resize-button in this-procedure .
     3895       end.
     3896       if v-diasize-wndstore = true
     3897       then do:
     3898         if connected("ub") = true
     3899         then do:
     3900           define variable v-cntxt-db-num        as integer   no-undo .
     3901           define variable v-cntxt-userid        as character no-undo .
     3902           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3903                                             , OUTPUT v-cntxt-userid
     3904                                             ) .
     3905           run gbl/wndsizew.p
     3906             (input  v-cntxt-db-num
     3907             ,input  v-cntxt-userid
     3908             ,input  v-diasize-proc-name
     3909             ,input  'height':u
     3910             ,input  string(frame d-rvs :height - v-diasize-orig-frame-height)
     3911             ) .
     3912         end.
     3913       end.
     3914     end.
     3915     assign
     3916       v-diasize-change-size = false
     3917     .
     3918   end procedure.
     3919   procedure diasize_set-height :
     3920     define input  parameter p-new-height  as decimal   no-undo .
     3921     define input  parameter p-move-resize as logical   no-undo .
     3922     do
     3923     on error undo, return error return-value
     3924     :
     3925       run diasize_change-height in this-procedure
     3926         (input  (p-new-height - frame d-rvs :height)
     3927         ,input  p-move-resize
     3928         ) .
     3929     end.
     3930   end procedure.
     3931   procedure diasize_change-width :
     3932     define input  parameter p-change-value as decimal   no-undo .
     3933     define input  parameter p-move-resize  as logical   no-undo .
     3934     define variable v-field-group-handle   as handle    no-undo .
     3935     define variable v-object-handle        as handle    no-undo .
     3936     define variable v-frame-width          as decimal   no-undo .
     3937     define variable v-frame-virtual-width  as decimal   no-undo .
     3938     define variable v-browse-width         as decimal   no-undo .
     3939     define variable v-window-width         as decimal   no-undo .
     3940     define variable v-window-virtual-width as decimal   no-undo .
     3941     define variable v-change-sign          as integer   no-undo .
     3942     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3943     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3944     if p-change-value > 0
     3945     then do:
     3946       if frame d-rvs :width + p-change-value >
     3947           session :width-chars
     3948       then do:
     3949         assign
     3950           p-change-value = session :width-chars - frame d-rvs :width
     3951         .
     3952         if p-change-value <= 0
     3953         then do:
     3954           run diasize_position-resize-button in this-procedure .
     3955           return .
     3956         end.
     3957       end.
     3958     end.
     3959     if p-change-value < 0
     3960     then do:
     3961       if frame d-rvs :width + p-change-value < v-diasize-orig-frame-width
     3962       then do:
     3963         assign
     3964           p-change-value = v-diasize-orig-frame-width
     3965                          - frame d-rvs :width
     3966         .
     3967         if p-change-value >= 0
     3968         then do:
     3969           run diasize_position-resize-button in this-procedure .
     3970           return .
     3971         end.
     3972       end.
     3973     end.
     3974     if p-change-value >= 0
     3975     then do:
     3976       assign
     3977         v-change-sign = 1
     3978       .
     3979     end.
     3980     else do:
     3981       assign
     3982         v-change-sign = -1
     3983       .
     3984     end.
     3985     assign
     3986       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3987     .
     3988     if p-change-value = 0
     3989     then do:
     3990       run diasize_position-resize-button in this-procedure .
     3991       return .
     3992     end.
     3993     move_block:
     3994     do
     3995     on error undo move_block, leave move_block
     3996     :
     3997       if retry
     3998       then do:
     3999         do
     4000         on error undo move_block, leave move_block
     4001         :
     4002           if p-change-value > 0
     4003           then do:
     4004             for each buf_temp-diasize-handle
     4005             on error undo, next
     4006             :
     4007               assign
     4008                 v-object-handle = buf_temp-diasize-handle.handle-value
     4009               .
     4010               if v-object-handle <> v-diasize-resize-button
     4011               then do:
     4012                 assign
     4013                   v-object-handle :col = buf_temp-diasize-handle.save-position
     4014                 .
     4015               end.
     4016             end.
     4017             assign
     4018               v-diasize-browse-handle :width = v-browse-width
     4019             .
     4020             for each buf_temp-browse-handle
     4021               where buf_temp-browse-handle.browse-type = 'width':u
     4022             on error undo, next
     4023             :
     4024               assign
     4025                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     4026               .
     4027             end.
     4028             assign
     4029               frame d-rvs :width = v-frame-width
     4030             .
     4031             if frame d-rvs :scrollable = true
     4032             then do:
     4033               assign
     4034                 frame d-rvs :virtual-width = v-frame-virtual-width
     4035               .
     4036             end.
     4037             run diasize_position-resize-button in this-procedure .
     4038           end.
     4039           else do:
     4040             if frame d-rvs :scrollable = true
     4041             then do:
     4042               assign
     4043                 frame d-rvs :virtual-width = v-frame-virtual-width
     4044               .
     4045             end.
     4046             assign
     4047               frame d-rvs :width = v-frame-width
     4048             .
     4049             for each buf_temp-browse-handle
     4050               where buf_temp-browse-handle.browse-type = 'width':u
     4051             on error undo, next
     4052             :
     4053               assign
     4054                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     4055               .
     4056             end.
     4057             assign
     4058               v-diasize-browse-handle :width = v-browse-width
     4059             .
     4060             for each buf_temp-diasize-handle
     4061             on error undo, next
     4062             :
     4063               assign
     4064                 v-object-handle = buf_temp-diasize-handle.handle-value
     4065               .
     4066               if v-object-handle <> v-diasize-resize-button
     4067               then do:
     4068                 assign
     4069                   v-object-handle :col = buf_temp-diasize-handle.save-position
     4070                 .
     4071               end.
     4072             end.
     4073             run diasize_position-resize-button in this-procedure .
     4074           end.
     4075           assign
     4076             v-diasize-change-size = false
     4077           .
     4078           leave move_block .
     4079         end.
     4080       end.
     4081       assign
     4082         v-diasize-need-full-display = true
     4083       .
     4084       if v-diasize-change-size = false
     4085       then do:
     4086         assign
     4087           v-diasize-change-size = true
     4088         .
     4089       end.
     4090       else do:
     4091         return .
     4092       end.
     4093       assign
     4094         v-frame-width = frame d-rvs :width
     4095         v-frame-virtual-width = frame d-rvs :virtual-width
     4096         v-browse-width = v-diasize-browse-handle :width
     4097       .
     4098       for each buf_temp-browse-handle
     4099         where buf_temp-browse-handle.browse-type = 'width':u
     4100       :
     4101         assign
     4102           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     4103         .
     4104       end.
     4105       for each buf_temp-diasize-handle
     4106       :
     4107         delete buf_temp-diasize-handle .
     4108       end.
     4109       assign
     4110         v-field-group-handle = frame d-rvs :first-child
     4111       .
     4112       do while valid-handle(v-field-group-handle)
     4113       :
     4114         assign
     4115           v-object-handle = v-field-group-handle :first-child
     4116         .
     4117         do while valid-handle(v-object-handle)
     4118         :
     4119           if  v-object-handle <> v-diasize-browse-handle :handle
     4120           and v-object-handle <> v-diasize-resize-button
     4121           and can-query(v-object-handle, "row")
     4122           and can-query(v-object-handle, "height")
     4123           and ( v-object-handle :col + v-object-handle :width
     4124                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     4125               )
     4126           then do:
     4127             find first buf_temp-browse-handle
     4128               where buf_temp-browse-handle.browse-type   = 'width':u
     4129                 and buf_temp-browse-handle.browse-handle = v-object-handle
     4130               no-error .
     4131             if available buf_temp-browse-handle
     4132             then do:
     4133             end.
     4134             else do:
     4135               create buf_temp-diasize-handle .
     4136               assign
     4137                 buf_temp-diasize-handle.handle-value  = v-object-handle
     4138                 buf_temp-diasize-handle.save-position = v-object-handle :col
     4139               .
     4140             end.
     4141           end.
     4142           assign
     4143             v-object-handle = v-object-handle :next-sibling
     4144           .
     4145         end.
     4146         assign
     4147           v-field-group-handle = v-field-group-handle :next-sibling
     4148         .
     4149       end.
     4150       do with frame d-rvs
     4151       :
     4152         hide v-diasize-resize-button .
     4153         v-diasize-resize-button :row = 1.
     4154         v-diasize-resize-button :column = 1.
     4155       end.
     4156       if p-change-value > 0
     4157       then do:
     4158         if frame d-rvs :scrollable = true
     4159         then do:
     4160           assign
     4161             frame d-rvs :virtual-width = frame d-rvs :virtual-width + p-change-value
     4162             no-error .
     4163           if error-status :error
     4164           or error-status :get-message(1) <> ""
     4165           then do:
     4166             undo move_block, retry move_block.
     4167           end.
     4168         end.
     4169         assign
     4170           frame d-rvs :width = v-frame-width + p-change-value
     4171           no-error .
     4172         if error-status :error
     4173         or error-status :get-message(1) <> ""
     4174         then do:
     4175           undo move_block, retry move_block.
     4176         end.
     4177         assign
     4178           v-diasize-browse-handle :width = v-browse-width + p-change-value
     4179         no-error .
     4180         if error-status :error
     4181         or error-status :get-message(1) <> ""
     4182         then do:
     4183           undo move_block, retry move_block.
     4184         end.
     4185         for each buf_temp-browse-handle
     4186           where buf_temp-browse-handle.browse-type = 'width':u
     4187         on error undo move_block, retry move_block
     4188         :
     4189           assign
     4190             buf_temp-browse-handle.browse-handle :width
     4191               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4192             no-error .
     4193           if error-status :error
     4194           or error-status :get-message(1) <> ""
     4195           then do:
     4196             undo move_block, retry move_block .
     4197           end.
     4198         end.
     4199         for each buf_temp-diasize-handle
     4200         on error undo move_block, retry move_block
     4201         :
     4202           assign
     4203             v-object-handle = buf_temp-diasize-handle.handle-value
     4204           .
     4205           if v-object-handle <> v-diasize-resize-button
     4206           then do:
     4207             assign
     4208               v-object-handle :col = v-object-handle :col + p-change-value
     4209               no-error .
     4210             if error-status :error
     4211             or error-status :get-message(1) <> ""
     4212             then do:
     4213               undo move_block, retry move_block .
     4214             end.
     4215           end.
     4216         end.
     4217       end.
     4218       else do:
     4219         for each buf_temp-diasize-handle
     4220         on error undo move_block, retry move_block
     4221         :
     4222           assign
     4223             v-object-handle = buf_temp-diasize-handle.handle-value
     4224           .
     4225           if v-object-handle <> v-diasize-resize-button
     4226           then do:
     4227             assign
     4228               v-object-handle :col = v-object-handle :col + p-change-value
     4229               no-error .
     4230             if error-status :error
     4231             or error-status :get-message(1) <> ""
     4232             then do:
     4233               undo move_block, retry move_block .
     4234             end.
     4235           end.
     4236         end.
     4237         for each buf_temp-browse-handle
     4238           where buf_temp-browse-handle.browse-type = 'width':u
     4239         on error undo move_block, retry move_block
     4240         :
     4241           assign
     4242             buf_temp-browse-handle.browse-handle :width
     4243               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4244             no-error .
     4245           if error-status :error
     4246           or error-status :get-message(1) <> ""
     4247           then do:
     4248             undo move_block, retry move_block .
     4249           end.
     4250         end.
     4251         assign
     4252           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     4253           no-error .
     4254         if error-status :error
     4255         or error-status :get-message(1) <> ""
     4256         then do:
     4257           undo move_block, retry move_block.
     4258         end.
     4259         assign
     4260           frame d-rvs :width = frame d-rvs :width + p-change-value
     4261         no-error .
     4262         if error-status :error
     4263         or error-status :get-message(1) <> ""
     4264         then do:
     4265           undo move_block, retry move_block.
     4266         end.
     4267         if frame d-rvs :scrollable = true
     4268         then do:
     4269           assign
     4270             frame d-rvs :virtual-width = frame d-rvs :virtual-width + p-change-value
     4271           no-error .
     4272           if error-status :error
     4273           or error-status :get-message(1) <> ""
     4274           then do:
     4275             undo move_block, retry move_block.
     4276           end.
     4277         end.
     4278       end.
     4279       if p-move-resize
     4280       then do:
     4281         run diasize_position-resize-button in this-procedure .
     4282       end.
     4283       if v-diasize-wndstore = true
     4284       then do:
     4285         if connected("ub") = true
     4286         then do:
     4287           define variable v-cntxt-db-num        as integer   no-undo .
     4288           define variable v-cntxt-userid        as character no-undo .
     4289           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4290                                             , OUTPUT v-cntxt-userid
     4291                                             ) .
     4292           run gbl/wndsizew.p
     4293             (input  v-cntxt-db-num
     4294             ,input  v-cntxt-userid
     4295             ,input  v-diasize-proc-name
     4296             ,input  'width':u
     4297             ,input  string(frame d-rvs :width - v-diasize-orig-frame-width)
     4298             ) .
     4299         end.
     4300       end.
     4301     end.
     4302     assign
     4303       v-diasize-change-size = false
     4304     .
     4305   end procedure.
     4306   procedure diasize_set-width :
     4307     define input  parameter p-new-width  as decimal   no-undo .
     4308     define input  parameter p-move-resize as logical   no-undo .
     4309     do
     4310     on error undo, return error return-value
     4311     :
     4312       run diasize_change-width in this-procedure
     4313         (input  (p-new-width - frame d-rvs :width)
     4314         ,input  p-move-resize
     4315         ) .
     4316     end.
     4317   end procedure.
     4318   procedure diasize_position-resize-button :
     4319     do with frame d-rvs
     4320     :
     4321       hide v-diasize-resize-button .
     4322       assign
     4323         v-diasize-resize-button :row = frame d-rvs :height - v-diasize-resize-button :height
     4324                     - 1
     4325                     - (frame d-rvs :border-bottom-pixels / session :pixels-per-row)
     4326         v-diasize-resize-button :col = frame d-rvs :width - v-diasize-resize-button :width
     4327                     - 1
     4328                     - (frame d-rvs :border-right-pixels / session :pixels-per-column)
     4329       .
     4330       view v-diasize-resize-button .
     4331     end.
     4332   end procedure.
     4333   on alt-right anywhere
     4334   do:
     4335     run diasize_change-width in this-procedure
     4336       (input 1
     4337       ,input true
     4338       ) .
     4339     return no-apply .
     4340   end.
     4341   on alt-left anywhere
     4342   do:
     4343     run diasize_change-width in this-procedure
     4344       (input -1
     4345       ,input true
     4346       ) .
     4347     return no-apply .
     4348   end.
     4349   on alt-down anywhere
     4350   do:
     4351     run diasize_change-height in this-procedure
     4352       (input 1
     4353       ,input true
     4354       ) .
     4355     return no-apply .
     4356   end.
     4357   on alt-up anywhere
     4358   do:
     4359     run diasize_change-height in this-procedure
     4360       (input -1
     4361       ,input true
     4362       ) .
     4363     return no-apply .
     4364   end.
     4365   on alt-enter of frame d-rvs
     4366   do:
     4367     run diasize_maximize in this-procedure
     4368       (input  ?
     4369       ).
     4370     return no-apply .
     4371   end.
     4372   procedure diasize_end-move :
     4373     do
     4374     on error undo, return error return-value
     4375     :
     4376       define variable v-row-delta as decimal   no-undo .
     4377       define variable v-col-delta as decimal   no-undo .
     4378       define variable v-new-row as decimal   no-undo .
     4379       define variable v-new-col as decimal   no-undo .
     4380       assign
     4381         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     4382         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     4383       .
     4384       assign
     4385         v-row-delta = v-new-row - frame d-rvs :height
     4386         v-col-delta = v-new-col - frame d-rvs :width
     4387       .
     4388       run diasize_change-height in this-procedure
     4389         (input v-row-delta
     4390         ,input true
     4391         ) .
     4392       run diasize_change-width in this-procedure
     4393         (input v-col-delta
     4394         ,input true
     4395         ) .
     4396     end.
     4397   end procedure.
     4398   procedure diasize_maximize :
     4399     define input  parameter p-action as logical   no-undo .
     4400     do
     4401     on error undo, return error return-value
     4402     :
     4403       if p-action = ?
     4404       then do:
     4405         if v-diasize-need-maximize = true
     4406         then do:
     4407           assign
     4408             p-action = true
     4409           .
     4410         end.
     4411         else do:
     4412           assign
     4413             p-action = false
     4414           .
     4415         end.
     4416       end.
     4417       if p-action = true
     4418       then do:
     4419         run diasize_change-height in this-procedure
     4420           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     4421               - frame d-rvs :height-chars
     4422           ,input true
     4423           ) .
     4424         run diasize_change-width in this-procedure
     4425           (input session :width-chars
     4426               - frame d-rvs :width-chars
     4427           ,input true
     4428           ) .
     4429         assign
     4430           v-diasize-need-maximize = false
     4431         .
     4432       end.
     4433       else do:
     4434         run diasize_change-width in this-procedure
     4435           (input v-diasize-orig-frame-width
     4436               - frame d-rvs :width-chars
     4437           ,input true
     4438           ) .
     4439         run diasize_change-height in this-procedure
     4440           (input v-diasize-orig-frame-height
     4441               - frame d-rvs :height-chars
     4442           ,input true
     4443           ) .
     4444         assign
     4445           v-diasize-need-maximize = true
     4446         .
     4447       end.
     4448     end.
     4449   end procedure.
     4450   procedure diasize_restore-orig-size :
     4451     do
     4452     on error undo, return error return-value
     4453     :
     4454       assign
     4455         v-diasize-current-frame-width  = frame d-rvs :width
     4456         v-diasize-current-frame-height = frame d-rvs :height
     4457       .
     4458       run diasize_set-height in this-procedure
     4459         (input  v-diasize-orig-frame-height
     4460         ,input  true
     4461         ) .
     4462       run diasize_set-width in this-procedure
     4463         (input  v-diasize-orig-frame-width
     4464         ,input  true
     4465         ) .
     4466     end.
     4467   end procedure.
     4468   procedure diasize_restore-current-size :
     4469     do
     4470     on error undo, return error return-value
     4471     :
     4472       run diasize_set-height in this-procedure
     4473         (input  v-diasize-current-frame-height
     4474         ,input  true
     4475         ) .
     4476       run diasize_set-width in this-procedure
     4477         (input  v-diasize-current-frame-width
     4478         ,input  true
     4479         ) .
     4480     end.
     4481   end procedure.
     4482   procedure diasize_set-browse-handle :
     4483     define input  parameter p-browse-handle as handle   no-undo .
     4484     define buffer buf_temp-browse-handle for temp-browse-handle .
     4485     do
     4486     on error undo, return error return-value
     4487     :
     4488       assign
     4489         v-diasize-browse-handle = p-browse-handle
     4490       .
     4491       for each buf_temp-browse-handle
     4492       on error undo, return error return-value
     4493       :
     4494         delete buf_temp-browse-handle .
     4495       end.
     4496     end.
     4497   end procedure.
     4498   procedure diasize_add_browse :
     4499     define input  parameter p-browse-type   as character no-undo .
     4500     define input  parameter p-browse-handle as handle    no-undo .
     4501     define buffer buf_temp-browse-handle for temp-browse-handle .
     4502     do
     4503     on error undo, return error return-value
     4504     :
     4505       assign
     4506         v-diasize-browse-number = v-diasize-browse-number + 1
     4507       .
     4508       create buf_temp-browse-handle .
     4509       assign
     4510         buf_temp-browse-handle.browse-type   = p-browse-type
     4511         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     4512         buf_temp-browse-handle.browse-handle = p-browse-handle
     4513       .
     4514     end.
     4515   end procedure.
     4516   procedure diasize_init :
     4517     define variable v-default-value    as logical   no-undo .
     4518     define variable v-restore-saved    as logical   no-undo .
     4519     define variable v-resize-value-str as character no-undo .
     4520     do
     4521     on error undo, return error return-value
     4522     :
     4523       do with frame d-rvs
     4524       :
     4525         assign
     4526           v-diasize-orig-frame-height = frame d-rvs :height
     4527           v-diasize-orig-frame-width  = frame d-rvs :width
     4528           v-diasize-browse-handle     = browse br-line :handle
     4529         .
     4530         create button v-diasize-resize-button
     4531         assign
     4532           parent        = frame d-rvs :first-child
     4533           label         = "s"
     4534           height-pixels = 16
     4535           width-pixels  = 16
     4536           visible       = true
     4537           sensitive     = true
     4538           movable       = true
     4539           triggers:
     4540             on end-move persistent run diasize_end-move in this-procedure .
     4541           end triggers.
     4542         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4543         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4544         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4545         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4546         assign
     4547           v-diasize-wndmax = false
     4548         .
     4549         if connected("ub") = true
     4550         then do:
     4551           define variable v-cntxt-db-num        as integer   no-undo .
     4552           define variable v-cntxt-userid        as character no-undo .
     4553           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4554                                             , OUTPUT v-cntxt-userid
     4555                                             ) .
     4556           run gbl/wndpar_r.p
     4557             (input  v-cntxt-db-num
     4558             ,input  v-cntxt-userid
     4559             ,input  'wndmax':U
     4560             ,output v-diasize-wndmax
     4561             ,output v-default-value
     4562             ) .
     4563         end.
     4564         assign
     4565           v-diasize-wndstore = false
     4566         .
     4567         if connected("ub") = true
     4568         then do:
     4569           run gbl/wndpar_r.p
     4570             (input  v-cntxt-db-num
     4571             ,input  v-cntxt-userid
     4572             ,input  'wndstore':U
     4573             ,output v-diasize-wndstore
     4574             ,output v-default-value
     4575             ) .
     4576         end.
     4577         assign
     4578           v-diasize-proc-name = entry(1, program-name(2), '.')
     4579         .
     4580         if v-diasize-wndstore = true
     4581         then do:
     4582           assign
     4583             v-restore-saved = false
     4584           .
     4585           if connected("ub") = true
     4586           then do:
     4587             run gbl/wndsizer.p
     4588               (input  v-cntxt-db-num
     4589               ,input  v-cntxt-userid
     4590               ,input  v-diasize-proc-name
     4591               ,input  'height':u
     4592               ,output v-resize-value-str
     4593               ) .
     4594             if v-resize-value-str <> '':U
     4595             then do:
     4596               run diasize_change-height in this-procedure
     4597                 (input  integer(v-resize-value-str)
     4598                 ,input  true
     4599                 ) .
     4600               assign
     4601                 v-restore-saved = true
     4602               .
     4603             end.
     4604           end.
     4605           if connected("ub") = true
     4606           then do:
     4607             run gbl/wndsizer.p
     4608               (input  v-cntxt-db-num
     4609               ,input  v-cntxt-userid
     4610               ,input  v-diasize-proc-name
     4611               ,input  'width':u
     4612               ,output v-resize-value-str
     4613               ) .
     4614             if v-resize-value-str <> '':U
     4615             then do:
     4616               run diasize_change-width in this-procedure
     4617                 (input  integer(v-resize-value-str)
     4618                 ,input  true
     4619                 ) .
     4620               assign
     4621                 v-restore-saved = true
     4622               .
     4623             end.
     4624           end.
     4625           if v-restore-saved <> true
     4626           then do:
     4627             if v-diasize-wndmax = true
     4628             then do:
     4629               run diasize_maximize in this-procedure
     4630                 (input  true
     4631                 ) .
     4632             end.
     4633           end.
     4634         end.
     4635         else do:
     4636           if v-diasize-wndmax = true
     4637           then do:
     4638             run diasize_maximize in this-procedure
     4639               (input  true
     4640               ) .
     4641           end.
     4642         end.
     4643       end.
     4644     end.
     4645   end procedure.
     4646   procedure diasize_need-full-display :
     4647     define output parameter p-need-full-display as logical   no-undo .
     4648     do
     4649     on error undo, return error return-value
     4650     :
     4651       assign
     4652         p-need-full-display = v-diasize-need-full-display
     4653       .
     4654       assign
     4655         v-diasize-need-full-display = false
     4656       .
     4657     end.
     4658   end procedure.
     4659   procedure get-context :
     4660      define output parameter p-db-num as integer          no-undo.
     4661      define output parameter p-user-id as character        no-undo.
     4662      define variable v-login               as character    no-undo.
     4663      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4664      define buffer buf_user-login  for ub.user-login .
     4665      do
     4666      on error undo, return error
     4667      :
     4668            FIND FIRST buf_sys-ctrl no-lock.
     4669            ASSIGN
     4670               v-login = USERID("ub")
     4671               p-db-num = buf_sys-ctrl.db-num
     4672            .
     4673            FIND FIRST buf_user-login
     4674                 WHERE buf_user-login.db-num = p-db-num
     4675                   AND buf_user-login.user-login = v-login
     4676                 no-lock
     4677                 no-error
     4678                 .
     4679            IF AVAILABLE buf_user-login
     4680            THEN DO:
     4681               assign
     4682                  p-user-id = buf_user-login.user-id
     4683               .
     4684            END.
     4685      end.
     4686   end procedure.
     4687       run diasize_init in this-procedure .
     4688   main-block:
     4689   do on error   undo main-block, leave main-block
     4690     on end-key undo main-block, leave main-block
     4691     on stop    undo main-block, leave main-block:
     4692     do ii = 1 to 5:
     4693       bcol[ii] = br-line:get-browse-column(ii).
     4694     end.
     4695     run mode-on in this-procedure
     4696       no-error.
     4697     if error-status :error then
     4698     do:
     4699       return error return-value .
     4700     end.
     4701     if pardoc-mode <> 'ПРОСМОТР':U then
     4702     do:
     4703       assign
     4704         rvs-line-rec = ?
     4705         .
     4706     end.
     4707     run ui-on in this-procedure.
     4708     wait-for go of frame d-rvs focus b-add.
     4709   end.
     4710   run disable_ui in this-procedure.
     4711   procedure disable_ui :
     4712     hide frame d-rvs.
     4713   end procedure.
     4714   procedure ui-on :
     4715     del-list = "".
     4716     find first ub.clients where ub.clients.obj-type = r-doc.obj-type and
     4717       ub.clients.obj-code = r-doc.obj-code no-lock.
     4718     assign
     4719       frame d-rvs:title = "(" + substring (ub.clients.obj-name, 1, 35) +
     4720          ") :   ДОКУМЕНТ проверки корректности работы АСИ в резервуаре - " + r-doc.status_ + " № " + r-doc.rvs-code + "      - " + pardoc-mode.
     4721     disable all with frame d-rvs.
     4722     enable b-exit b-help b-lkp br-line b-history b-notes b-commission with frame d-rvs.
     4723     if r-doc.status_ = 'новый':U and
     4724       (pardoc-mode = 'ДОБАВЛЕНИЕ':U or
     4725       pardoc-mode = 'ИЗМЕНЕНИЕ':U        ) then
     4726     do:
     4727       enable r-doc.wrkr
     4728         r-doc.agnt
     4729         r-doc.boss
     4730         r-wrkr r-agnt r-boss
     4731         b-mark
     4732       with frame d-rvs.
     4733       if not isMeasurement then
     4734           enable
     4735             b-add b-del b-chg  b-meas
     4736           with frame d-rvs.
     4737     end.
     4738     if available ub.clients then disp ub.clients.obj-name with frame d-rvs.
     4739     else disp ? @ ub.clients.obj-name with frame d-rvs.
     4740     disp r-doc.obj-code
     4741       r-doc.obj-type
     4742       r-doc.doc-date
     4743       with frame d-rvs.
     4744     for first ub.user-account-attr no-lock where ub.user-account-attr.user-id = v-cntxt-userid
     4745       and ub.user-account-attr.attr-code = "psn-code"
     4746       :
     4747       if ub.user-account-attr.attr-value <> ""
     4748         and ub.user-account-attr.attr-value <> ?
     4749         and ub.user-account-attr.attr-value <> "0"
     4750         and ub.user-account-attr.attr-value <> "?"
     4751         then
     4752       do:
     4753         if pardoc-mode = 'ДОБАВЛЕНИЕ':U
     4754           then
     4755         do :
     4756           r-doc.agnt:screen-value in frame d-rvs = trim (ub.user-account-attr.attr-value).
     4757           r-doc.wrkr:screen-value in frame d-rvs = trim (ub.user-account-attr.attr-value).
     4758           r-doc.boss:screen-value in frame d-rvs = trim (ub.user-account-attr.attr-value).
     4759         end.
     4760         if pardoc-mode = 'ИЗМЕНЕНИЕ':U
     4761           then
     4762         do :
     4763           r-doc.agnt:screen-value in frame d-rvs = trim (ub.user-account-attr.attr-value).
     4764         end.
     4765       end.
     4766     end .
     4767     define variable v-ref-rec19   as recid no-undo .
     4768     find cli-buf where cli-buf.obj-code = input frame d-rvs r-doc.wrkr
     4769                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     4770   if not available cli-buf then do:
     4771     display r-doc.wrkr with frame d-rvs.
     4772     find cli-buf no-lock where cli-buf.obj-code = input frame d-rvs r-doc.wrkr
     4773                            and cli-buf.obj-type = 'чел':U no-error.
     4774   end.
     4775   if available cli-buf then do:
     4776         display cli-buf.obj-code @ r-doc.wrkr cli-buf.obj-name @ wrkr-name with frame d-rvs.
     4777     end.
     4778     else display ? @ r-doc.wrkr ? @ wrkr-name with frame d-rvs.
     4779     define variable v-ref-rec20   as recid no-undo .
     4780     find cli-buf where cli-buf.obj-code = input frame d-rvs r-doc.agnt
     4781                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     4782   if not available cli-buf then do:
     4783     display r-doc.agnt with frame d-rvs.
     4784     find cli-buf no-lock where cli-buf.obj-code = input frame d-rvs r-doc.agnt
     4785                            and cli-buf.obj-type = 'чел':U no-error.
     4786   end.
     4787   if available cli-buf then do:
     4788         display cli-buf.obj-code @ r-doc.agnt cli-buf.obj-name @ agnt-name with frame d-rvs.
     4789     end.
     4790     else display ? @ r-doc.agnt ? @ agnt-name with frame d-rvs.
     4791     define variable v-ref-rec21   as recid no-undo .
     4792     find cli-buf where cli-buf.obj-code = input frame d-rvs r-doc.boss
     4793                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     4794   if not available cli-buf then do:
     4795     display r-doc.boss with frame d-rvs.
     4796     find cli-buf no-lock where cli-buf.obj-code = input frame d-rvs r-doc.boss
     4797                            and cli-buf.obj-type = 'чел':U no-error.
