      112   define new global shared variable g#libbcrcn as handle no-undo .
      113   define new global shared variable g#language as character no-undo .
      114   if g#language <> '' and g#language <> 'rus':U then do:
      115     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      116   end.
      117   define new global shared variable g#library  as handle no-undo .
      118   define new global shared variable g#library2 as handle no-undo .
      119   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      121   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      122   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      123   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      124   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      125   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      126   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      127   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      128   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      129   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      130   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
