     5129                 if error-status :error then
     5130                 do:
     5131                   message "Ошибка при заполнении данных с приборов на резервуарах." skip
     5132                     return-value
     5133                     view-as alert-box error.
     5134                   run waitfram-hide in this-procedure.
     5135                   undo tr, return error.
     5136                 end.
     5137                 if par_test-asi-type = "test-asi_dens-pump"
     5138                 then do :
     5139                   for each calc_r-line no-lock where calc_r-line.rvs-code = r-doc.rvs-code :
     5140                     run pomi-calc .
     5141                   end .
     5142                 end .
     5143               end.
     5144             end.
     5145             assign
     5146               par_test-asi-rec = recid (r-doc).
     5147           end.
     5148         end.
     5149       when 'ИЗМЕНЕНИЕ':U then
     5150         do:
     5151           tr:
     5152           do transaction
     5153             on error undo, return error return-value
     5154             on stop  undo, return error return-value
     5155             on quit  undo, return error return-value
     5156             :
     5157             find r-doc where recid (r-doc) = par_test-asi-rec no-error.
     5158             if available r-doc then
     5159             do:
     5160               if r-doc.status_ = 'факт':U then
     5161               do:
     5162                 find r-doc where recid (r-doc) = par_test-asi-rec no-lock.
     5163                 message "Документ уже закрыт. Изменение невозможно.".
     5164                 undo tr, return error.
     5165               end.
     5166               find first buf_doc-attr no-lock where buf_doc-attr.doc-code = r-doc.rvs-code
     5167                                                 and buf_doc-attr.attr-code = "test-asi-type"
     5168                                                 no-error .
     5169               if not available buf_doc-attr
     5170               or (available buf_doc-attr and not (buf_doc-attr.attr-value > ""))
     5171               then do :
     5172                 find r-doc where recid (r-doc) = par_test-asi-rec no-lock.
     5173                 message "Неизвестный тип проверки корректности работы АСИ. Изменение невозможно.".
     5174                 undo tr, return error.
     5175               end .
     5176               assign par_test-asi-type = buf_doc-attr.attr-value .
     5177               find r-doc where recid (r-doc) = par_test-asi-rec exclusive.
     5178             end.
     5179           end.
     5180         end.
     5181       when 'ПРОСМОТР':U then
     5182         do:
     5183           find r-doc no-lock where recid (r-doc) = par_test-asi-rec.
     5184         end.
     5185     end case.
     5186     if not available r-doc then
     5187     do:
     5188       message "Неправильно выбран документ.".
     5189       undo, return error.
     5190     end.
     5191   end procedure.
