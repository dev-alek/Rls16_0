     5615           view-as alert-box error.
     5616         return error.
     5617       end.
     5618       for each tt-meas:
     5619         delete tt-meas.
     5620       end.
     5621       create tt-meas.
     5622       assign
     5623         tt-meas.obj-type = ub.rvs-line.obj-type
     5624         tt-meas.obj-code = ub.rvs-line.obj-code
     5625         tt-meas.pl-code  = ub.rvs-line.pl-code
     5626         tt-meas.loc1     = meas-place.loc1
     5627       .
     5628       run waitfram-show in this-procedure ( input ("Делаем сверку по резервуару " + meas-place.loc1) ).
     5629       disable b-add b-chg b-del b-meas b-commission with frame d-rvs.
     5630       isMeasurement = yes.
     5631       tr:
     5632       do transaction on error undo tr, retry tr :
     5633         if retry then
     5634         do:
     5635           VErrorFlag = yes.
     5636           leave tr.
     5637         end.
     5638         find first sys-ctrl no-lock.
     5639         run db-attr-value(sys-ctrl.db,"AsiIp",output v-asi-ip,output v-attr-type).
     5640         run db-attr-value(sys-ctrl.db,"AsiPort",output v-asi-port,output v-attr-type).
     5641         run db-attr-value(sys-ctrl.db,"AsiType",output v-asi-type,output v-attr-type).
     5642         if trim(v-asi-ip) <> ''
     5643           and trim(v-asi-port) <> ''
     5644           and trim(v-asi-type) <> ''
     5645           then
     5646         do :
     5647           case v-asi-type :
     5648             when "1"
     5649             then
     5650               do :
     5651                 varcur-rvs = 2 .
     5652               end.
     5653             when "2"
     5654             then
     5655               do :
     5656                 varcur-rvs = 3 .
     5657               end.
     5658           end case .
     5659         end.
     5660         else
     5661         do :
     5662           if ptoldfilvalue = "yes":u then
     5663           do:
     5664             run gbl/d-askw.w ( input "Выбор источника данных с информацией по резервуарам",
     5665               "Будем читать текущие данные с резервуаров или возьмем данные из файла?",
     5666               "|^",
     5667               "Текущие данные|Из файлов|Отмена",
     5668               "Запускается программа для обращения к датчикам резервуаров|Берутся уже сохраненные данные из файла|Ничего не делаем",
     5669               1,
     5670               3,
     5671               output varnum
     5672               ).
     5673             case varnum:
     5674               when 3 then
     5675                 do:
     5676                   undo tr, leave tr.
     5677                 end.
     5678               when 2 then
     5679                 do:
     5680                   assign
     5681                     varcur-rvs = 0.
     5682                 end.
     5683               when 1 then
     5684                 do:
     5685                   assign
     5686                     varcur-rvs = 1.
     5687                 end.
     5688             end case.
     5689           end.
     5690           else
     5691           do:
     5692             assign
     5693               varcur-rvs = 1.
     5694           end.
     5695         end.
     5696   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_rvsplace in g#lib-rvs ( input              r-doc.obj-type ,
     5697                         input              r-doc.obj-code ,
     5698                         input              yes ,
     5699                         input              varcur-rvs ,
     5700                         input              yes ,
     5701                         input              no ,
     5702                         input-output table tt-meas-file ,
     5703                         input-output table tt-meas ) no-error .
     5704         if error-status :error then
     5705         do:
     5706           message "Ошибка при получении данных с приборов на резервуарах." skip
     5707             return-value
     5708             view-as alert-box error.
     5709           undo tr, retry tr.
     5710         end.
     5711         find current ub.rvs-line exclusive-lock.
     5712   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_fill1plc in g#lib-rvs ( input              ub.rvs-line.obj-type ,
     5713                         input              ub.rvs-line.obj-code ,
