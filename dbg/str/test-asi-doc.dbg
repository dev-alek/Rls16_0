     5594   procedure proc_m-meas-3 :
     5595     define buffer meas-place            for ub.place.
     5596     define buffer olddens_rvs-line-attr for ub.rvs-line-attr .
     5597     define variable VErrorFlag as logical no-undo.
     5598     if available ub.rvs-line then
     5599     do:
     5600       assign
     5601         rvs-line-rec      = recid(ub.rvs-line)
     5602       .
     5603       find meas-place where meas-place.obj-type = ub.rvs-line.obj-type and
     5604         meas-place.obj-code = ub.rvs-line.obj-code and
     5605         meas-place.pl-code  = ub.rvs-line.pl-code  no-lock.
     5606       if meas-place.is-meas <> yes then
     5607       do:
     5608         message "Резервуар " meas-place.pl-code " не измеряется приборами. "
     5609           view-as alert-box error.
     5610         return error.
     5611       end.
