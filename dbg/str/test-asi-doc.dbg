     5722             view-as alert-box error.
     5723           undo tr, retry tr.
     5724         end.
     5725         if par_test-asi-type = "test-asi_dens-pump"
     5726         then do :
     5727           for first calc_r-line no-lock where rowid(calc_r-line) = rowid(ub.rvs-line) :
     5728             run pomi-calc .
     5729           end .
     5730         end .
     5731       end.
     5732       run waitfram-hide in this-procedure.
     5733       isMeasurement = no.
     5734       run ui-on in this-procedure.
     5735       if VErrorFlag
