     1660     buf_cd-plu.logkey_one = no.
     1661     ii-ok = ii-ok + 1.
     1662     run show-counter in p-log-handle .
     1663     run write-counter in p-log-handle (substitute("Обработано &1 блюд, из них упешно &2"
     1664                                       , ii
     1665                                       , ii-ok
     1666                                       )) no-error.
     1667     run get-stop-state in p-log-handle(output v-stop-state).
     1668     if v-stop-state then do:
     1669       run write-log-and-file in p-log-handle (
     1670             input 1
     1671           , input log-file-name
     1672           , input 1
     1673           , input substitute( "!!!Процесс прерван пользователем"
     1674                             )).
     1675       assign
     1676       v-view-log = yes.
     1677       LEAVE _II.
     1678     end.
     1679   END.
     1680   run write-log-and-file in p-log-handle (
     1681         input 1
     1682       , input log-file-name
     1683       , input 1
     1684       , input substitute( "!!!Из &1 товаров успешно по названию синхронизировано &2"
     1685                           , ii0
     1686                           , ii-ok
     1687                         )).
     1688   end.
