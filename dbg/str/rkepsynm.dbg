      456       field processed     as logical
      457       field sort-name     as character
      458       field full-name     as character
      459       index pi is primary unique node-code
      460       index ps processed
      461   .
      462   procedure fbrglib-get-sort-name :
      463   do
      464   on error undo, return error
      465   :
      466   define input parameter p-obj-type   as character    no-undo.
      467   define input parameter p-obj-code   as integer      no-undo.
      468   define input parameter p-node-code  as integer      no-undo.
      469   define output parameter p-sort-name as character    no-undo.
      470       define variable v-upper-code    as integer           no-undo.
      471       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      472       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
      473       find first buf_fbr-gds-grp no-lock
      474            where buf_fbr-gds-grp.obj-type  = p-obj-type
      475              and buf_fbr-gds-grp.obj-code  = p-obj-code
      476              and buf_fbr-gds-grp.node-code = p-node-code
      477       no-error.
      478       if not available buf_fbr-gds-grp
      479       then do:
      480           undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      481       end.
      482       assign
      483           p-sort-name  = ""
      484           v-upper-code = 1
      485       .
      486       do while true
      487       on error undo, return error "fbrglib-get-sort-name: Ошибка составления полного имени группы"
      488       :
      489           assign
      490               p-sort-name  = buf_fbr-gds-grp.node-name
      491                            + (if p-sort-name <> "" then chr(2) else "")
      492                            + p-sort-name
      493               v-upper-code = buf_fbr-gds-grp.upper-code
      494           .
      495           if buf_fbr-gds-grp.upper-code = 1
      496           then do:
      497               leave.
      498           end.
      499           find first buf_fbr-gds-grp no-lock
      500                where buf_fbr-gds-grp.obj-type  = p-obj-type
      501                  and buf_fbr-gds-grp.obj-code  = p-obj-code
      502                  and buf_fbr-gds-grp.node-code = v-upper-code
      503           no-error.
      504           if not available buf_fbr-gds-grp
      505           then do:
      506               undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом "
      507                                   + string( v-upper-code )
      508                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      509           end.
      510       end.
      511   end.
      512   end procedure.
      513   procedure fbrglib-get-full-name :
      514   do
      515   on error undo, return error
      516   :
      517   define input parameter p-obj-type   as character    no-undo.
      518   define input parameter p-obj-code   as integer      no-undo.
      519   define input parameter p-node-code  as integer      no-undo.
      520   define output parameter p-full-name as character    no-undo.
      521       define variable v-upper-code    as integer           no-undo.
      522       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      523       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
      524       if p-node-code = 1
      525       then do:
      526           assign
      527               p-full-name = ""
      528           .
      529       end.
      530       else do:
      531           find first buf_fbr-gds-grp no-lock
      532                where buf_fbr-gds-grp.obj-type  = p-obj-type
      533                  and buf_fbr-gds-grp.obj-code  = p-obj-code
      534                  and buf_fbr-gds-grp.node-code = p-node-code
      535           no-error.
      536           if not available buf_fbr-gds-grp
      537           then do:
      538               undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      539           end.
      540           assign
      541               p-full-name  = ""
      542               v-upper-code = 1
      543           .
      544           do while true
      545           on error undo, return error "fbrglib-get-full-name: Ошибка составления полного имени группы"
      546           :
      547               assign
      548                   p-full-name  = buf_fbr-gds-grp.node-name
      549                               + (if p-full-name <> "" then chr(47) else "")
      550                               + p-full-name
      551                   v-upper-code = buf_fbr-gds-grp.upper-code
      552               .
      553               if buf_fbr-gds-grp.upper-code = 1
      554               then do:
      555                   leave.
      556               end.
      557               find first buf_fbr-gds-grp no-lock
      558                    where buf_fbr-gds-grp.obj-type  = p-obj-type
      559                      and buf_fbr-gds-grp.obj-code  = p-obj-code
      560                      and buf_fbr-gds-grp.node-code = v-upper-code
      561               no-error.
      562               if not available buf_fbr-gds-grp
      563               then do:
      564                   undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом "
      565                                       + string( v-upper-code )
      566                                       + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      567               end.
      568           end.
      569           assign
      570               p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      571           .
      572       end.
      573   end.
      574   end procedure.
      575   procedure fbrglib-get-root-code :
      576   do
      577   on error undo, return error
      578   :
      579   define output parameter p-root-code as integer      no-undo.
      580       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      581       find first buf_fbr-gds-grp no-lock
      582            where buf_fbr-gds-grp.upper-code = 0
      583       no-error .
      584       if not available buf_fbr-gds-grp
      585       then do:
      586           undo, return error .
      587       end.
      588       else do:
      589           assign
      590               p-root-code = buf_fbr-gds-grp.node-code
      591           .
      592       end.
      593   end.
      594   end procedure.
      595   procedure fbrglib-find-grp-by-full-name :
      596   do
      597   on error undo, return error
      598   :
      599   define input parameter p-obj-type     as character    no-undo.
      600   define input parameter p-obj-code     as integer      no-undo.
      601   define input parameter p-search-name  as character    no-undo.
      602   define input parameter p-fill-path    as logical      no-undo.
      603       define variable v-upper-code    as integer          no-undo.
      604       define variable v-not-found     as logical init yes no-undo.
      605       define variable v-counter       as integer           no-undo.
      606       define variable v-level         as integer           no-undo.
      607       define variable v-full-name     as character         no-undo.
      608       define variable v-sort-name     as character         no-undo.
      609       define variable v-node-name     as character      no-undo.
      610       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      611       assign
      612           p-search-name = replace( p-search-name, chr(47), chr(2) )
      613       .
      614       run fbrglib-get-root-code ( output v-upper-code ) no-error .
      615       if error-status :error
      616       then do:
      617           undo, return error "fbrglib-find-grp-by-full-name: Ошибка при поиске корневого узла".
      618       end.
      619       assign
      620           v-full-name  = ""
      621           v-level      = num-entries( p-search-name, chr(2) )
      622       .
      623       for each temp_fbrglib_found-grp
      624       :
      625           delete temp_fbrglib_found-grp.
      626       end.
      627       start-name-analyze:
      628       do v-counter = 1 to v-level
      629       :
      630           if v-counter < v-level
      631           then do:
      632               assign
      633                   v-node-name = entry( v-counter, p-search-name, chr(2) )
      634               .
      635               find first buf_fbr-gds-grp no-lock
      636                    where buf_fbr-gds-grp.obj-type   = p-obj-type
      637                      and buf_fbr-gds-grp.obj-code   = p-obj-code
      638                      and buf_fbr-gds-grp.upper-code = v-upper-code
      639                      and buf_fbr-gds-grp.node-name  = v-node-name
      640               no-error .
      641               if not available buf_fbr-gds-grp
      642               then do:
      643                   assign
      644                       v-full-name  = p-search-name
      645                       v-sort-name  = p-search-name
      646                   .
      647                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(47) ).
      648               end.
      649               else do:
      650                   assign
      651                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_fbr-gds-grp.node-name
      652                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_fbr-gds-grp.node-name
      653                       v-upper-code = buf_fbr-gds-grp.node-code
      654                   .
      655                   if p-fill-path = yes
      656                   then do:
      657                       create temp_fbrglib_found-grp.
      658                       assign
      659                           temp_fbrglib_found-grp.full-name = v-full-name + chr(47)
      660                           temp_fbrglib_found-grp.sort-name = v-sort-name
      661                           temp_fbrglib_found-grp.node-code = v-upper-code
      662                           temp_fbrglib_found-grp.level     = v-counter
      663                           temp_fbrglib_found-grp.obj-type  = p-obj-type
      664                           temp_fbrglib_found-grp.obj-code  = p-obj-code
      665                       .
      666                   end.
      667               end.
      668           end.
      669           else do:
      670               for each buf_fbr-gds-grp no-lock
      671                  where buf_fbr-gds-grp.obj-type   = p-obj-type
      672                    and buf_fbr-gds-grp.obj-code   = p-obj-code
      673                    and buf_fbr-gds-grp.upper-code = v-upper-code
      674                    and buf_fbr-gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      675               :
      676                   assign
      677                       v-not-found = no
      678                   .
      679                   create temp_fbrglib_found-grp.
      680                   assign
      681                       temp_fbrglib_found-grp.full-name = v-full-name
      682                                                           + (if v-full-name = "" then "" else chr(47) )
      683                                                           + buf_fbr-gds-grp.node-name + chr(47)
      684                       temp_fbrglib_found-grp.sort-name = v-sort-name
      685                                                           + ( if v-sort-name = "" then "" else chr(2) )
      686                                                           + buf_fbr-gds-grp.node-name
      687                       temp_fbrglib_found-grp.node-code = buf_fbr-gds-grp.node-code
      688                       temp_fbrglib_found-grp.level     = v-level
      689                       temp_fbrglib_found-grp.obj-type  = p-obj-type
      690                       temp_fbrglib_found-grp.obj-code  = p-obj-code
      691                   .
      692               end.
      693               if v-not-found = yes
      694               then do:
      695                   assign
      696                       v-full-name  = p-search-name
      697                       v-sort-name  = p-search-name
      698                   .
      699                   for each temp_fbrglib_found-grp
      700                   :
      701                       delete temp_fbrglib_found-grp.
      702                   end.
      703                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      704               end.
      705           end.
      706       end.
      707   end.
      708   end procedure.
      709   procedure fbrglib-find-all-subgroup :
      710   do
      711   on error undo, return error
      712   :
      713   define input parameter p-start-obj-type     as character    no-undo.
      714   define input parameter p-start-obj-code     as integer      no-undo.
      715   define input parameter p-start-node-code    as integer      no-undo.
      716   define input parameter p-terminal-only      as logical      no-undo.
      717       define variable v-start-full-name   as character     no-undo.
      718       define variable v-start-sort-name   as character     no-undo.
      719       define variable v-not-found         as logical       no-undo.
      720       define variable v-is-terminal       as logical       no-undo.
      721       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
      722       create temp_found-result-nodelist.
      723       assign
      724           temp_found-result-nodelist.node-code = p-start-node-code
      725           temp_found-result-nodelist.processed = no
      726       .
      727       run fbrglib-get-full-name in this-procedure (
      728             input p-start-obj-type
      729           , input p-start-obj-code
      730           , input p-start-node-code
      731           , output v-start-full-name
      732       ).
      733       run fbrglib-get-full-name in this-procedure (
      734             input p-start-obj-type
      735           , input p-start-obj-code
      736           , input p-start-node-code
      737           , output v-start-sort-name
      738       ).
      739       process-nodes:
      740       do while yes
      741       :
      742           find first temp_found-result-nodelist
      743                where temp_found-result-nodelist.node-code = p-start-node-code
      744           .
      745           assign
      746               temp_found-result-nodelist.processed = yes
      747           .
      748           for each buf_fbr-gds-grp no-lock
      749              where buf_fbr-gds-grp.obj-type   = p-start-obj-type
      750                and buf_fbr-gds-grp.obj-code   = p-start-obj-code
      751                and buf_fbr-gds-grp.upper-code = p-start-node-code
      752           on error undo, return error
      753           :
      754               run fbrglib-is-terminal in this-procedure (
      755                     input buf_fbr-gds-grp.obj-type
      756                   , input buf_fbr-gds-grp.obj-code
      757                   , input buf_fbr-gds-grp.node-code
      758                   , output v-is-terminal
      759               ).
      760               if v-is-terminal = yes
      761               then do:
      762                   create temp_fbrglib_found-grp.
      763                   assign
      764                       temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      765                                                           chr(47) + buf_fbr-gds-grp.node-name + chr(47)
      766                       temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      767                                                           chr(2) + buf_fbr-gds-grp.node-name + chr(2)
      768                       temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
      769                       temp_fbrglib_found-grp.is-terminal = yes
      770                       temp_fbrglib_found-grp.obj-type  = p-start-obj-type
      771                       temp_fbrglib_found-grp.obj-code  = p-start-obj-code
      772                   .
      773               end.
      774               else do:
      775                   create temp_found-result-nodelist.
      776                   assign
      777                       temp_found-result-nodelist.node-code = buf_fbr-gds-grp.node-code
      778                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      779                                                              chr(47) + buf_fbr-gds-grp.node-name + chr(47)
      780                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      781                                                              chr(2) + buf_fbr-gds-grp.node-name + chr(2)
      782                       temp_found-result-nodelist.processed = no
      783                   .
      784                   if p-terminal-only = no
      785                   then do:
      786                       create temp_fbrglib_found-grp.
      787                       assign
      788                           temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      789                                                               chr(47) + buf_fbr-gds-grp.node-name + chr(47)
      790                           temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      791                                                               chr(2) + buf_fbr-gds-grp.node-name + chr(2)
      792                           temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
      793                           temp_fbrglib_found-grp.is-terminal = no
      794                           temp_fbrglib_found-grp.obj-type  = p-start-obj-type
      795                           temp_fbrglib_found-grp.obj-code  = p-start-obj-code
      796                       .
      797                   end.
      798               end.
      799           end.
      800           find first temp_found-result-nodelist
      801                where temp_found-result-nodelist.processed = no
      802           no-error.
      803           if not available temp_found-result-nodelist
      804           then do:
      805               leave process-nodes.
      806           end.
      807           else do:
      808               assign
      809                   p-start-node-code = temp_found-result-nodelist.node-code
      810                   v-start-full-name = temp_found-result-nodelist.full-name
      811                   v-start-sort-name = temp_found-result-nodelist.sort-name
      812               .
      813           end.
      814       end.
      815   end.
      816   end procedure.
      817   procedure fbrglib-expand-name :
      818   do
      819   on error undo, return error
      820   :
      821   define input parameter p-obj-type   as character    no-undo.
      822   define input parameter p-obj-code   as integer      no-undo.
      823   define input parameter p-start-name as character    no-undo.
      824   define output parameter p-end-name  as character    no-undo.
      825       define variable v-is-terminal     as logical           no-undo.
      826       define buffer buf_temp_fbrglib_found-grp     for temp_fbrglib_found-grp.
      827       run fbrglib-find-grp-by-full-name in this-procedure (
      828             input p-obj-type
      829           , input p-obj-code
      830           , input p-start-name
      831           , input no
      832       ) no-error.
      833       run fbrglib-get-max-substring in this-procedure (
      834              input p-obj-type
      835           ,  input p-obj-code
      836           ,  input length( p-start-name )
      837           , output p-end-name
      838       ) no-error .
      839       if error-status :error
      840       then do:
      841           assign
      842               p-end-name = ""
      843           .
      844       end.
      845       else do:
      846           find first temp_fbrglib_found-grp
      847                where temp_fbrglib_found-grp.full-name = p-end-name
      848                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
      849                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      850                        no-error.
      851           if available temp_fbrglib_found-grp
      852           then do:
      853               find first buf_temp_fbrglib_found-grp
      854                    where buf_temp_fbrglib_found-grp.full-name begins p-end-name
      855                      and recid( buf_temp_fbrglib_found-grp ) <> recid( temp_fbrglib_found-grp )
      856                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
      857                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      858               no-error.
      859               if not available buf_temp_fbrglib_found-grp
      860               then do:
      861                   run fbrglib-is-terminal in this-procedure (
      862                         input p-obj-type
      863                       , input p-obj-code
      864                       , input temp_fbrglib_found-grp.node-code
      865                       , output v-is-terminal
      866                   ).
      867               end.
      868           end.
      869       end.
      870   end.
      871   end procedure.
      872   procedure fbrglib-get-max-substring :
      873   do
      874   on error undo, return error
      875   :
      876   define input parameter p-obj-type as character no-undo .
      877   define input parameter p-obj-code as integer no-undo .
      878   define input parameter p-min-substring-length   as integer      no-undo.
      879   define output parameter p-substring             as character    no-undo.
      880           define variable v-char-counter  as integer           no-undo.
      881           define variable v-current-char  as character         no-undo.
      882           define variable v-names-counter  as integer           no-undo.
      883           define variable v-base-string   as character         no-undo.
      884           assign
      885               v-char-counter  = p-min-substring-length
      886           .
      887           find first temp_fbrglib_found-grp  where
      888                      temp_fbrglib_found-grp.obj-type  = p-obj-type
      889                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      890           no-error.
      891           if not available temp_fbrglib_found-grp
      892           then do:
      893               undo, return error "fbrglib-get-max-substring: Нет строк для вычисления общей подстроки".
      894           end.
      895           else do:
      896               assign
      897                   v-base-string = temp_fbrglib_found-grp.full-name
      898               .
      899               counter-block:
      900               do while yes
      901               on error undo, return error "fbrglib-get-max-substring: Ошибка вычисления продолжения имени группы."
      902               :
      903                   assign
      904                       v-char-counter  = v-char-counter + 1
      905                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      906                       v-names-counter = 0
      907                   .
      908                   compare-block:
      909                   for each temp_fbrglib_found-grp
      910                   where temp_fbrglib_found-grp.obj-type  = p-obj-type
      911                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      912                   :
      913                       assign
      914                           v-names-counter = v-names-counter + 1
      915                       .
      916                       if v-names-counter = 1
      917                       then do:
      918                           next compare-block.
      919                       end.
      920                       if substring( temp_fbrglib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      921                       then do:
      922                           leave counter-block.
      923                       end.
      924                   end.
      925                   if v-names-counter = 1
      926                   then do:
      927                       assign
      928                           p-substring = v-base-string
      929                       .
      930                       return.
      931                   end.
      932               end.
      933               assign
      934                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      935               .
      936           end.
      937   end.
      938   end procedure.
      939   procedure fbrglib-is-terminal :
      940   do
      941   on error undo, return error "Ошибка процедуры fbrglib-is-terminal"
      942   :
      943   define input parameter p-obj-type       as character    no-undo.
      944   define input parameter p-obj-code       as integer      no-undo.
      945   define input parameter p-node-code      as integer      no-undo.
      946   define output parameter p-is-terminal   as logical      no-undo.
      947       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      948       find first buf_fbr-gds-grp no-lock
      949            where buf_fbr-gds-grp.obj-type   = p-obj-type
      950              and buf_fbr-gds-grp.obj-code   = p-obj-code
      951              and buf_fbr-gds-grp.upper-code = p-node-code
      952       no-error .
      953       if not available buf_fbr-gds-grp
      954       then do:
      955           assign
      956               p-is-terminal = yes
      957           .
      958       end.
      959       else do:
      960           assign
      961               p-is-terminal = no
      962           .
      963       end.
      964   end.
      965   end procedure.
      966   procedure fbrglib-have-goods :
      967   do
      968   on error undo, return error
      969   :
      970   define input parameter p-obj-type           as character    no-undo.
      971   define input parameter p-obj-code           as integer      no-undo.
      972   define input parameter p-node-code          as integer      no-undo.
      973   define output parameter p-have-fbr-gds-obj  as logical      no-undo.
      974       define buffer buf_fbr-gds-obj         for ub.fbr-gds-obj.
      975       find first buf_fbr-gds-obj no-lock
      976            where buf_fbr-gds-obj.obj-type     = p-obj-type
      977              and buf_fbr-gds-obj.obj-code     = p-obj-code
      978              and buf_fbr-gds-obj.fbr-grp-code = p-node-code
      979       no-error .
      980       if available buf_fbr-gds-obj
      981       then do:
      982           assign
      983               p-have-fbr-gds-obj = yes
      984           .
      985       end.
      986       else do:
      987           assign
      988               p-have-fbr-gds-obj = no
      989           .
      990       end.
      991   end.
      992   end procedure.
      993   procedure fbrglib-find-by-substring :
      994   do
      995   on error undo, return error
      996   :
      997   define input parameter p-start-obj-type     as character    no-undo.
      998   define input parameter p-start-obj-code     as integer      no-undo.
      999   define input parameter p-start-code         as integer      no-undo.
     1000   define input parameter p-full-search-string as character    no-undo.
     1001   define output parameter p-found-code        as integer      no-undo.
     1002   define output parameter p-full-name         as character    no-undo.
     1003       define variable v-start-code     as integer           no-undo.
     1004       define variable v-found          as logical  init no  no-undo.
     1005       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1006       search-grp:
     1007       for each buf_fbr-gds-grp no-lock
     1008           where buf_fbr-gds-grp.obj-type  = p-start-obj-type
     1009             and buf_fbr-gds-grp.obj-code  = p-start-obj-code
     1010             and buf_fbr-gds-grp.node-code > p-start-code
     1011       :
     1012           if index( buf_fbr-gds-grp.node-name, p-full-search-string ) <> 0
     1013           then do:
     1014               assign
     1015                   p-found-code = buf_fbr-gds-grp.node-code
     1016                   v-found      = yes
     1017               .
     1018               run fbrglib-get-full-name in this-procedure (
     1019                     input p-start-obj-type
     1020                   , input p-start-obj-code
     1021                   , input p-found-code
     1022                   , output p-full-name
     1023               ) no-error .
     1024               if error-status :error
     1025               then do:
     1026                   undo, return error "fbrglib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1027               end.
     1028               leave search-grp.
     1029           end.
     1030       end.
     1031       if v-found = yes
     1032       then do:
     1033       end.
     1034       else do:
     1035           assign
     1036               p-full-name  = ""
     1037               p-found-code = 0
     1038           .
     1039       end.
     1040   end.
     1041   end procedure.
     1042   procedure fbrglib-analyze-grp-name :
     1043   do
     1044   on error undo, return error
     1045   :
     1046   define input parameter p-grp-name       as character            no-undo.
     1047   define input parameter p-obj-type       as character            no-undo.
     1048   define input parameter p-obj-code       as integer              no-undo.
     1049   define input parameter p-upper-code     as integer              no-undo.
     1050   define output parameter p-error-message as character init ""    no-undo.
     1051       define variable v-char-list     as character    no-undo.
     1052       define variable v-char-counter  as integer      no-undo.
     1053       define variable v-full-name     as character    no-undo.
     1054       if p-grp-name = "" then do:
     1055           assign
     1056               p-error-message = "Название группы не может быть пустым.".
     1057           .
     1058       end.
     1059       else do:
     1060           assign
     1061               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1062           .
     1063           do v-char-counter = 1 to num-entries( v-char-list )
     1064           :
     1065               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1066               then do:
     1067                   assign
     1068                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1069                   .
     1070                   return.
     1071               end.
     1072           end.
     1073           run fbrglib-get-full-name in this-procedure (
     1074                 input p-obj-type
     1075               , input p-obj-code
     1076               , input p-upper-code
     1077               , output v-full-name
     1078           ) no-error .
     1079           if error-status :error
     1080           then do:
     1081               undo, return error "fbrglib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1082           end.
     1083           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
     1084           then do:
     1085               assign
     1086                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
     1087               .
     1088           end.
     1089       end.
     1090   end.
     1091   end procedure.
     1092   procedure fbrglib-delete-grp :
     1093   do
     1094   on error undo, return error
     1095   :
     1096   define input parameter p-obj-type   as character    no-undo.
     1097   define input parameter p-obj-code   as integer      no-undo.
     1098   define input parameter p-node-code  as integer      no-undo.
     1099   define output parameter p-deleted   as logical      no-undo.
     1100       define variable v-have-goods    as logical        no-undo.
     1101       define variable v-yesno         as logical        no-undo.
     1102       define variable v-upper-code    as integer        no-undo.
     1103       define variable v-root-code     as integer        no-undo.
     1104       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     1105       define buffer buf_fbr-gds-obj           for ub.fbr-gds-obj.
     1106       define buffer buf_second_fbr-gds-grp    for ub.fbr-gds-grp.
     1107       run fbrglib-get-root-code in this-procedure (
     1108           output v-root-code
     1109       ) no-error.
     1110       if error-status :error
     1111       then do:
     1112           undo, return error "Не найден корневой узел." + chr(10) + return-value.
     1113       end.
     1114       if p-node-code = v-root-code
     1115       then do:
     1116           message
     1117               "Корневую группу удалить невозможно."
     1118           view-as alert-box error.
     1119           assign
     1120               p-deleted = no
     1121           .
     1122           undo, return.
     1123       end.
     1124       find first buf_fbr-gds-grp no-lock
     1125            where buf_fbr-gds-grp.obj-type     = p-obj-type
     1126              and buf_fbr-gds-grp.obj-code     = p-obj-code
     1127              and buf_fbr-gds-grp.upper-code   = p-node-code
     1128       no-error.
     1129       if available buf_fbr-gds-grp
     1130       then do:
     1131           message
     1132               "Не терминальную группу удалить невозможно."
     1133           view-as alert-box error.
     1134           assign
     1135               p-deleted = no
     1136           .
     1137           undo, return.
     1138       end.
     1139       find first buf_fbr-gds-grp no-lock
     1140            where buf_fbr-gds-grp.obj-type     = p-obj-type
     1141              and buf_fbr-gds-grp.obj-code     = p-obj-code
     1142              and buf_fbr-gds-grp.node-code    = p-node-code
     1143       .
     1144       assign
     1145           v-upper-code = buf_fbr-gds-grp.upper-code
     1146       .
     1147       run fbrglib-have-goods in this-procedure (
     1148             input p-obj-type
     1149           , input p-obj-code
     1150           , input p-node-code
     1151           , output v-have-goods
     1152       ).
     1153       if v-have-goods = yes
     1154       then do:
     1155           find first buf_second_fbr-gds-grp no-lock
     1156                where buf_second_fbr-gds-grp.obj-type      = buf_fbr-gds-grp.obj-type
     1157                  and buf_second_fbr-gds-grp.obj-code      = buf_fbr-gds-grp.obj-code
     1158                  and buf_second_fbr-gds-grp.upper-code    = buf_fbr-gds-grp.upper-code
     1159                  and recid( buf_second_fbr-gds-grp )      <> recid( buf_fbr-gds-grp )
     1160           no-error.
     1161           if available buf_second_fbr-gds-grp
     1162           then do:
     1163               message
     1164                   "В группе есть товары,"
     1165                   skip "которые нельзя перенести в родительскую группу,"
     1166                   skip "потому что у родительской группы есть еще одна подгруппа."
     1167                   skip(1)
     1168                   skip "Перенесите товары в другую группу"
     1169                   skip "или удалите все остальные подгруппы родительской группы."
     1170               view-as alert-box error.
     1171               assign
     1172                   p-deleted = no
     1173               .
     1174               undo, return.
     1175           end.
     1176           message
     1177               "В группе есть товары."
     1178               skip "После удаления группы"
     1179               skip "все ее товары будут привязаны"
     1180               skip "к ее родительской группе."
     1181               skip(1)
     1182               skip "Удалить группу?"
     1183           view-as alert-box warning
     1184           buttons yes-no
     1185           title "Удаление группы"
     1186           update v-yesno
     1187           .
     1188           if v-yesno = yes
     1189           then do:
     1190               do transaction
     1191               on error undo, return error
     1192               :
     1193                   for each buf_fbr-gds-obj exclusive-lock
     1194                      where buf_fbr-gds-obj.obj-type     = p-obj-type
     1195                        and buf_fbr-gds-obj.obj-code     = p-obj-code
     1196                        and buf_fbr-gds-obj.fbr-grp-code = p-node-code
     1197                   on error undo, return error
     1198                   :
     1199                       assign
     1200                           buf_fbr-gds-obj.fbr-grp-code = v-upper-code
     1201                       .
     1202                   end.
     1203               end.
     1204               do transaction
     1205               on error undo, return error
     1206               :
     1207                   find current buf_fbr-gds-grp exclusive-lock .
     1208                   delete buf_fbr-gds-grp no-error .
     1209                   if error-status:error then do:
     1210                     undo, return error return-value .
     1211                   end.
     1212               end.
     1213           end.
     1214       end.
     1215       else do:
     1216           message
     1217               "Имя группы: " buf_fbr-gds-grp.node-name
     1218               "Код группы: " buf_fbr-gds-grp.node-code
     1219               skip(1)
     1220               skip "Удалить группу?"
     1221           view-as alert-box warning
     1222           buttons yes-no
     1223           title "Удаление группы"
     1224           update v-yesno
     1225           .
     1226           if v-yesno = yes
     1227           then do:
     1228               do transaction
     1229               on error undo, return error
     1230               :
     1231                   find current buf_fbr-gds-grp exclusive-lock .
     1232                   delete buf_fbr-gds-grp no-error.
     1233                   if error-status:error then do:
     1234                     undo, return error return-value .
     1235                   end.
     1236               end.
     1237           end.
     1238       end.
     1239   end.
     1240   end procedure.
     1241   procedure fbrglib-add-grp :
     1242   do
     1243   on error undo, return error
     1244   :
     1245   define input parameter p-obj-type       as character    no-undo.
     1246   define input parameter p-obj-code       as integer      no-undo.
     1247   define input parameter p-node-code      as integer      no-undo.
     1248   define input parameter p-interface      as logical      no-undo.
     1249   define input parameter p-node-name      as character    no-undo.
     1250   define input parameter p-out-code       as integer      no-undo.
     1251   define input parameter p-global-code    as integer      no-undo.
     1252   define output parameter p-new-node-code as integer      no-undo.
     1253   define output parameter p-cancel        as logical      no-undo.
     1254       define variable v-have-goods    as logical  no-undo.
     1255       define variable v-host-code     as integer        no-undo.
     1256       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1257       define buffer bf_fbr-gds-grp        for ub.fbr-gds-grp.
     1258       define buffer buf_fbr-gds-obj       for ub.fbr-gds-obj.
     1259       run fbrglib-have-goods in this-procedure (
     1260             input p-obj-type
     1261           , input p-obj-code
     1262           , input p-node-code
     1263           , output v-have-goods
     1264       ) no-error .
     1265       if error-status :error
     1266       then do:
     1267           message
     1268                    vss-workfile vss-revision vss-description
     1269               skip "Ошибка определения наличия товаров в группе."
     1270               skip return-value
     1271               skip trim(error-status :get-message(1))
     1272                    trim(error-status :get-message(2))
     1273                    trim(error-status :get-message(3))
     1274           view-as alert-box error.
     1275           undo, return error .
     1276       end.
     1277   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1278   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1279     (input  p-obj-type
     1280     ,input  p-obj-code
     1281     ,output v-host-code
     1282     )  .
     1283       find first buf_fbr-gds-grp no-lock where
     1284                 buf_fbr-gds-grp.upper-code = p-node-code
     1285             AND buf_fbr-gds-grp.obj-type   = p-obj-type
     1286             AND buf_fbr-gds-grp.obj-code   = p-obj-code
     1287             AND buf_fbr-gds-grp.node-name  = p-node-name no-error .
     1288       if available buf_fbr-gds-grp then do:
     1289           if p-node-code <> 1 then do:
     1290             find first buf_fbr-gds-grp no-lock where
     1291                       buf_fbr-gds-grp.node-code = p-node-code
     1292                   AND buf_fbr-gds-grp.obj-type   = p-obj-type
     1293                   AND buf_fbr-gds-grp.obj-code   = p-obj-code  .
     1294           end.
     1295                   message
     1296           "Для объекта" p-obj-type p-obj-code
     1297           "уже есть группа блюд" p-node-name "в подгруппе" (if p-node-code = 1 then "БЛЮДА" else buf_Fbr-gds-grp.node-name)
     1298           view-as alert-box error .
     1299           undo, return error .
     1300       end.
     1301       do transaction
     1302       on error undo, return error
     1303       :
     1304           create buf_fbr-gds-grp.
     1305           assign
     1306               buf_fbr-gds-grp.node-code   = next-value( s-gds-grp, ub )
     1307               p-new-node-code             = buf_fbr-gds-grp.node-code
     1308               buf_fbr-gds-grp.upper-code  = p-node-code
     1309               buf_fbr-gds-grp.host-code   = v-host-code
     1310               buf_fbr-gds-grp.obj-type    = p-obj-type
     1311               buf_fbr-gds-grp.obj-code    = p-obj-code
     1312               buf_fbr-gds-grp.node-name    = ""
     1313               buf_fbr-gds-grp.out-code    = 0
     1314           .
     1315           if p-interface then do:
     1316             run ref/fbrggrpd.w (
     1317                   input parparentproc
     1318                 , input 'ИЗМЕНЕНИЕ':U
     1319                 , input p-obj-type
     1320                 , input p-obj-code
     1321                 , input buf_fbr-gds-grp.node-code
     1322                 , input buf_fbr-gds-grp.upper-code
     1323                 , input buf_fbr-gds-grp.node-name
     1324                 , input buf_fbr-gds-grp.out-code
     1325                 , output buf_fbr-gds-grp.node-name
     1326                 , output buf_fbr-gds-grp.out-code
     1327                 , output p-cancel
     1328             ).
     1329             if p-cancel = yes
     1330             then do:
     1331                 delete buf_fbr-gds-grp.
     1332                 undo, return.
     1333             end.
     1334           end.
     1335           else do:
     1336             find first bf_fbr-gds-grp no-lock
     1337                 where bf_fbr-gds-grp.obj-type   = p-obj-type
     1338                   and bf_fbr-gds-grp.obj-code   = p-obj-code
     1339                   and bf_fbr-gds-grp.out-code   = p-out-code
     1340             no-error.
     1341             assign
     1342             buf_fbr-gds-grp.node-name    = p-node-name
     1343             buf_fbr-gds-grp.global-code  = p-global-code
     1344             buf_fbr-gds-grp.out-code     = (if available bf_fbr-gds-grp then 0 else p-out-code)
     1345             .
     1346           end.
     1347           if v-have-goods = yes
     1348           then do:
     1349               for each buf_fbr-gds-obj exclusive-lock
     1350                  where buf_fbr-gds-obj.obj-type      = p-obj-type
     1351                    and buf_fbr-gds-obj.obj-code      = p-obj-code
     1352                    and buf_fbr-gds-obj.fbr-grp-code  = p-node-code
     1353               on error undo, return error
     1354               :
     1355                   assign
     1356                       buf_fbr-gds-obj.fbr-grp-code = p-new-node-code
     1357                   .
     1358               end.
     1359           end.
     1360       end.
     1361   end.
     1362   end procedure.
     1363   do
     1364   on error undo, return error return-value
     1365   :
     1366   FOR EACH gds-list:
     1367     DELETE gds-list.
     1368   END.
     1369   assign
     1370   ii0 = num-entries(p-rid-list)
     1371   .
     1372   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1373     (input  'is-jwlr'
     1374     ,input  ''
     1375     ,input  ''
     1376     ,input  0
     1377     ,input  ''
     1378     ,input  ''
     1379     ,input  ''
     1380     ,input  no
     1381     ,output dops
     1382     ,output dopst
     1383     ) no-error .
     1384   assign
     1385   is-jwlr = (dops = "yes":U) no-error
     1386   .
     1387   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1388     (input  'is-bttl'
     1389     ,input  ''
     1390     ,input  ''
     1391     ,input  0
     1392     ,input  ''
     1393     ,input  ''
     1394     ,input  ''
     1395     ,input  no
     1396     ,output dops
     1397     ,output dopst
     1398     ) no-error .
     1399   assign
     1400   is-bttl = (dops = "yes":U) no-error
     1401   .
     1402   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1403     (input  'is-ptrl'
     1404     ,input  ''
     1405     ,input  ''
     1406     ,input  0
     1407     ,input  ''
     1408     ,input  ''
     1409     ,input  ''
     1410     ,input  no
     1411     ,output dops
     1412     ,output dopst
     1413     ) no-error .
     1414   assign
     1415   is-ptrl = (dops = "yes":U) no-error
     1416   .
     1417   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1418     (input  'is-custm'
     1419     ,input  ''
     1420     ,input  ''
     1421     ,input  0
     1422     ,input  ''
     1423     ,input  ''
     1424     ,input  ''
     1425     ,input  no
     1426     ,output custvalue
     1427     ,output custtype
     1428     ) no-error .
     1429   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1430   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1431     (input  p-curr-obj-type
     1432     ,input  p-curr-obj-code
     1433     ,output v-host-code
     1434     )  .
     1435   _ii:
     1436   DO ii = 1 TO ii0:
     1437   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1438      FIND FIRST buf_cd-plu Exclusive-lock WHERE
     1439               RECID(buf_cd-plu) = INTEGER(ENTRY(ii, p-rid-list)) NO-ERROR.
     1440      IF not AVAILABLE  buf_cd-plu  THEN do:
     1441         run write-log-and-file in p-log-handle (
     1442               input 1
     1443             , input log-file-name
     1444             , input 1
     1445             , input substitute("Не найдена или занята запись товара на кассе R-keeper c recid &1", INTEGER(ENTRY(ii, p-rid-list)))).
     1446         assign
     1447         v-view-log = yes.
     1448         next _ii.
     1449      end.
     1450      if buf_cd-plu.b-code = 0 then do:
     1451         run write-log-and-file in p-log-handle (
     1452               input 1
     1453             , input log-file-name
     1454             , input 1
     1455             , input substitute( "!!!Блюдо меню/модификатор на кассе R-KEEPER с id &1 код в меню &2 <&3>&4 - не сопоставлен товар в системе IBS TH"
     1456                                 , buf_cd-plu.plu-code
     1457                                 , buf_cd-plu.key#_one
     1458                                 , buf_cd-plu.charkey_one
     1459                                 , chr(10)
     1460                               )).
     1461         assign
     1462         v-view-log = yes.
     1463         next _ii.
     1464      end.
     1465      find first buf_bar-code no-lock where
     1466               buf_bar-code.b-code =  buf_cd-plu.b-code no-error.
     1467      if not available buf_bar-code then do:
     1468         run write-log-and-file in p-log-handle (
     1469               input 1
     1470             , input log-file-name
     1471             , input 1
     1472             , input substitute( "!!!Блюдо меню/модификатор на кассе R-KEEPER с id &1 код в меню &2 <&3>&4 - не найден товар с бар-кодом &5 в системе IBS TH"
     1473                                 , buf_cd-plu.plu-code
     1474                                 , buf_cd-plu.key#_one
     1475                                 , buf_cd-plu.charkey_one
     1476                                 , chr(10)
     1477                                 , buf_cd-plu.b-code
     1478                               )).
     1479         assign
     1480         v-view-log = yes.
     1481         next _ii.
     1482      end.
     1483      find first buf_goods exclusive-lock where
     1484               buf_goods.gds-code = buf_bar-code.gds-code  no-error no-wait.
     1485      if not available buf_goods and not locked buf_goods then do:
     1486         run write-log-and-file in p-log-handle (
     1487               input 1
     1488             , input log-file-name
     1489             , input 1
     1490             , input substitute( "!!!Блюдо меню/модификатор на кассе R-KEEPER с id &1 код в меню &2 <&3>&4 - не найден товар с кодом &5 для бар-кода &6 в системе IBS TH"
     1491                                 , buf_cd-plu.plu-code
     1492                                 , buf_cd-plu.key#_one
     1493                                 , buf_cd-plu.charkey_one
     1494                                 , chr(10)
     1495                                 , buf_cd-plu.b-code
     1496                                 , buf_bar-code.gds-code
     1497                               )).
     1498         assign
     1499         v-view-log = yes.
     1500         next _ii.
     1501      end.
     1502      if locked buf_goods then do:
     1503         run write-log-and-file in p-log-handle (
     1504               input 1
     1505             , input log-file-name
     1506             , input 1
     1507             , input substitute( "!!!Блюдо меню/модификатор на кассе R-KEEPER с id &1 код в меню &2 <&3>&4" +
     1508                                  " - товар с кодом &5 - запись ЗАНЯТА"
     1509                                 , buf_cd-plu.plu-code
     1510                                 , buf_cd-plu.key#_one
     1511                                 , buf_cd-plu.charkey_one
     1512                                 , chr(10)
     1513                                 , buf_cd-plu.b-code
     1514                               )).
     1515         assign
     1516         v-view-log = yes.
     1517         next _ii.
     1518      end.
     1519      if buf_goods.unit-base <> buf_bar-code.unit-cli then do:
     1520         run write-log-and-file in p-log-handle (
     1521               input 1
     1522             , input log-file-name
     1523             , input 1
     1524             , input substitute( "!!!Блюдо меню/модификатор на кассе R-KEEPER с id &1 код в меню &2 <&3>&4" +
     1525                                  " - товар с кодом &5 - привязан бар-код с НЕОСНОВНОЙ ЕДИНИЦЕЙ ИЗМЕРЕНИЯ - синхронизация по названию НЕВОЗМОЖНА"
     1526                                 , buf_cd-plu.plu-code
     1527                                 , buf_cd-plu.key#_one
     1528                                 , buf_cd-plu.charkey_one
     1529                                 , chr(10)
     1530                                 , buf_cd-plu.b-code
     1531                               )).
     1532         assign
     1533         v-view-log = yes.
     1534         next _ii.
     1535      end.
     1536      find first buf_gds-prt no-lock where
     1537               buf_gds-prt.upper-code = buf_goods.prt-root no-error.
     1538     if buf_gds-prt.node-name <> '_Пустая шкала':U then do:
     1539         run write-log-and-file in p-log-handle (
     1540               input 1
     1541             , input log-file-name
     1542             , input 1
     1543             , input substitute( "!!!Блюдо меню/модификатор на кассе R-KEEPER с id &1 код в меню &2 <&3>&4" +
     1544                                  " - товар с кодом &5 - НЕПУСТАЯ ШКАЛА - синхронизация по названию НЕВОЗМОЖНА"
     1545                                 , buf_cd-plu.plu-code
     1546                                 , buf_cd-plu.key#_one
     1547                                 , buf_cd-plu.charkey_one
     1548                                 , chr(10)
     1549                                 , buf_cd-plu.b-code
     1550                               )).
     1551         assign
     1552         v-view-log = yes.
     1553         next _ii.
     1554     end.
     1555     if buf_goods.gds-type = 'у':U then dO:
     1556         FIND FIRST buf_gds-obj no-lock where
     1557                   buf_gds-obj.gds-code = buf_goods.gds-code
     1558               AND buf_gds-obj.obj-type = p-curr-obj-type
     1559               AND buf_gds-obj.obj-code = p-curr-obj-code no-error .
     1560       end.
     1561     assign
     1562     v-gds-rec = recid(buf_goods).
     1563     if buf_goods.chk-name <> buf_cd-plu.charkey_one then do:
     1564         run ref/goods01.p (
     1565         input parparentproc
     1566       , input 'ИЗМЕНЕНИЕ':U
     1567       , input no
     1568       , input 0
     1569       , input no
     1570       , input yes
     1571       , input no
     1572       , input no
     1573       , input no
     1574       , input v-host-code
     1575       , input p-curr-obj-type
     1576       , input p-curr-obj-code
     1577       , input (buf_goods.gds-type = 'у':U)
     1578       , input ?
     1579       , input buf_goods.gds-code
     1580       , input buf_goods.artic
     1581       , input buf_goods.prod-type
     1582       , input buf_goods.prod-code
     1583       , input buf_gds-prt.node-code
     1584       , input buf_goods.grp-code
     1585       , input buf_goods.gds-name
     1586       , input "":U
     1587       , input buf_goods.engl-name
     1588       , input buf_goods.label-name
     1589       , input buf_cd-plu.charkey_one
     1590       , input buf_goods.alpha1
     1591       , input buf_goods.unit-base
     1592       , input buf_goods.unit-cli
     1593       , input buf_goods.max-rate
     1594       , input buf_goods.min-rate
     1595       , input buf_goods.cli-base-rate
     1596       , input buf_goods.qnty-cart
     1597       , input buf_goods.ms-cart
     1598       , input buf_goods.wt-cart
     1599       , input buf_goods.ms-cart
     1600       , input buf_goods.wt-cart
     1601       , input buf_goods.calc-method
     1602       , input buf_goods.increase-pc
     1603       , input buf_goods.negative-rest
     1604       , input (if buf_goods.gds-type = 'у':U and available buf_gds-obj
     1605               then buf_gds-obj.price-base
     1606               else 0)
     1607       , input (if buf_goods.gds-type = 'у':U and available buf_gds-obj
     1608               then  buf_gds-obj.price-rubl
     1609               else 0)
     1610       , input buf_goods.okdp
     1611       , input buf_goods.destin
     1612       , input buf_goods.attrib
     1613       , input buf_goods.user-rule
     1614       , input buf_goods.sert
     1615       , input buf_goods.struct
     1616       , input buf_goods.deadline
     1617       , input buf_goods.cond-keep-code
     1618       , input buf_goods.sort
     1619       , input buf_goods.proof
     1620       , input buf_goods.normal-wastage
     1621       , input buf_goods.normal-waste
     1622       , input buf_goods.tnved
     1623       , input buf_goods.nationality
     1624       , input buf_goods.unit-cst
     1625       , input buf_goods.cst-base-rate
     1626       , input buf_goods.fbr-grp-code
     1627       , input buf_goods.PS
     1628       , input no
     1629       , input is-jwlr
     1630       , input is-bttl
     1631       , input is-ptrl
     1632       , input custvalue
     1633       , input no
     1634       , input no
     1635       , input no
     1636       , input 0
