      181   function get-rkgTH-price returns decimal(input p-obj-type as character
      182                                          , input p-obj-code as integer
      183                                          , input p-b-code as integer
      184                                          , output p-doc-num as character):
      185   define variable v-price-sale as decimal   no-undo init ?.
      186   define variable v-road-tax   as decimal   no-undo .
      187   define variable v-excise     as decimal   no-undo .
      188   define variable v-vat-pc     as decimal   no-undo .
      189   define variable v-slt-pc     as decimal   no-undo .
      190   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      191   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcprcex in g#library
      192     (input  p-obj-type
      193     ,input  p-obj-code
      194     ,input  p-b-code
      195     ,input  0
      196     ,input  0
      197     ,output p-doc-num
      198     ,output v-price-sale
      199     ,output v-road-tax
      200     ,output v-excise
      201     ,output v-vat-pc
      202     ,output v-slt-pc
      203     ) no-error .
      204   if not error-status:error then return v-price-sale.
      205   END FUNCTION.
      206   function get-rkgTH-name returns character(input p-obj-type as character
      207                                             ,input p-obj-code as integer
      208                                             ,input p-b-code as integer
      209                                             , buffer buf_goods for ub.goods):
      210   define variable v-gds-name as character no-undo .
      211   define VARIABLE varresult   as character                no-undo.
      212   define VARIABLE vartype-bc  as character                no-undo.
      213   define VARIABLE varweight   as decimal                  no-undo.
      214   DEFINE VARIABLE v-unit-cli AS CHARACTER NO-UNDO.
      215   DEFINE VARIABLE v-f-name AS CHARACTER NO-UNDO.
      216   DEFINE BUFFER buf_bar-code FOR ub.bar-code.
      217   DEFINE BUFFER buf_prod-bc FOR ub.prod-bc.
      218   DEFINE BUFFER buf_place FOR ub.place.
      219   DEFINE BUFFER buf_gds-prt FOR ub.gds-prt.
      220   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
      221   (
      222    input  parparentproc
      223   ,input  STRING(p-b-code)
      224   ,input  0
      225   ,input  p-obj-type
      226   ,input  p-obj-code
      227   ,input  NO
      228   ,input  YES
      229   ,input  varscales-pref2
      230   ,input  varpgscales-pref2
      231   ,output varresult
      232   ,output vartype-bc
      233   ,output varweight
      234   ,buffer buf_bar-code
      235   ,buffer buf_prod-bc
      236   ,buffer buf_place
      237   ) no-error.
      238   if not available buf_bar-code then
      239   return "!!!НЕИЗВЕСТНЫЙ ТОВАР".
      240   FIND FIRST buf_goods NO-LOCK WHERE
      241             buf_goods.gds-code = buf_bar-code.gds-code NO-ERROR.
      242   IF NOT AVAILABLE buf_goods THEN DO:
      243     return "!!!НЕИЗВЕСТНЫЙ ТОВАР".
      244   END.
      245   else do:
      246     assign
      247     v-gds-name = buf_goods.chk-name
      248     .
      249   end.
      250   IF buf_bar-code.unit-cli <> buf_goods.unit-base THEN DO:
      251     ASSIGN
      252     v-unit-cli = "*" + string(buf_bar-code.cli-base-rate).
      253   END.
      254   FIND FIRST buf_gds-prt NO-LOCK WHERE
      255             buf_gds-prt.upper-code = buf_goods.prt-root NO-ERROR.
      256   if buf_gds-prt.node-name <>  '_Пустая шкала':U THEN DO:
      257       FIND FIRST buf_gds-prt NO-LOCK WHERE
      258                 buf_gds-prt.node-code = buf_bar-code.node-code NO-ERROR.
      259   END.
      260   ASSIGN
      261   v-f-name = (IF AVAILABLE buf_gds-prt THEN buf_gds-prt.f-name ELSE "":U).
      262   ASSIGN
      263   v-gds-name = v-gds-name + chr(32) + v-f-name + v-unit-cli.
      264   return v-gds-name.
      265   END FUNCTION.
      266   function get-rkgTH-group returns integer(input p-obj-type as character
      267                                           , input p-obj-code  as integer
      268                                           , input p-gds-code as integer
      269                                           , output p-grp-name as character
      270                                           ):
      271   DEFINE BUFFER buf_fbr-gds-obj FOR ub.fbr-gds-obj.
      272   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
      273   FIND FIRST buf_fbr-gds-obj NO-LOCK WHERE
      274           buf_fbr-gds-obj.obj-type = p-obj-type
      275       AND buf_fbr-gds-obj.obj-code = p-obj-code
      276       AND buf_fbr-gds-obj.gds-code = p-gds-code NO-ERROR.
      277   IF AVAILABLE buf_fbr-gds-obj THEN DO:
      278     RUN fbrglib-get-full-name IN THIS-PROCEDURE(
      279                                                 input p-obj-type
      280                                                 ,INPUT p-obj-code
      281                                                 ,INPUT buf_fbr-gds-obj.fbr-grp-code
      282                                                 ,OUTPUT p-grp-name) NO-ERROR.
      283     return buf_fbr-gds-obj.fbr-grp-code.
      284   END.
      285   return ?.
      286   END FUNCTION.
      287   function get-rkgTH-modificator returns logical(input p-obj-type as character
      288                                           , input p-obj-code  as integer
      289                                           , input p-gds-code as integer
      290                                           , output p-is-null-price as logical
      291                                           ):
      292   DEFINE BUFFER buf_fbr-gds-obj FOR ub.fbr-gds-obj.
      293   FIND FIRST buf_fbr-gds-obj NO-LOCK WHERE
      294           buf_fbr-gds-obj.obj-type = p-obj-type
      295       AND buf_fbr-gds-obj.obj-code = p-obj-code
      296       AND buf_fbr-gds-obj.gds-code = p-gds-code NO-ERROR.
      297   IF AVAILABLE buf_fbr-gds-obj THEN DO:
      298     assign
      299     p-is-null-price = buf_fbr-gds-obj.is-null-price
      300     .
      301     return buf_fbr-gds-obj.is-modificator.
      302   END.
      303   assign
      304   p-is-null-price = no.
      305   return no.
      306   END FUNCTION.
      307   function get-rkgTH-group-name returns character(input p-obj-type as character
      308                                                 , input p-obj-code  as integer
      309                                                 , input p-out-code as integer):
      310   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
      311   find first buf_fbr-gds-grp no-lock where
      312             buf_fbr-gds-grp.obj-type = p-obj-type
      313         AND buf_fbr-gds-grp.obj-code = p-obj-code
      314         and buf_fbr-gds-grp.out-code = p-out-code no-error .
      315   if not available buf_fbr-gds-grp then return ?.
      316   return buf_fbr-gds-grp.node-name.
      317   END FUNCTION.
      318   function get-rkgTH-parent returns integer(input p-obj-type as character
      319                                             , input p-obj-code  as integer
      320                                             , input p-out-code as integer):
      321   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
      322   DEFINE BUFFER upper_fbr-gds-grp FOR ub.fbr-gds-grp.
      323   find first buf_fbr-gds-grp no-lock where
      324             buf_fbr-gds-grp.obj-type = p-obj-type
      325         AND buf_fbr-gds-grp.obj-code = p-obj-code
      326         and buf_fbr-gds-grp.out-code = p-out-code no-error .
      327   if not available buf_fbr-gds-grp then return ?.
      328   find first upper_fbr-gds-grp no-lock where
      329             upper_fbr-gds-grp.obj-type = p-obj-type
      330         AND upper_fbr-gds-grp.obj-code = p-obj-code
      331         and upper_fbr-gds-grp.out-code = buf_fbr-gds-grp.upper-code no-error .
      332   if not available upper_fbr-gds-grp then return ?.
      333   return upper_fbr-gds-grp.out-code.
      334   END FUNCTION.
      335   procedure get-rkep-full-grp-name :
      336   define input parameter p-obj-code like ub.clients.obj-code no-undo .
      337   DEFINE INPUT PARAMETER p-grp-code LIKE ub.cd-grp.grp-code NO-UNDO.
      338   define output parameter p-full-name as character    no-undo.
      339   define variable v-upper-code    as integer  no-undo.
      340   define buffer buf_cd-grp       for ub.cd-grp.
      341   define buffer buf_upper_cd-grp for ub.cd-grp.
      342   do
      343   on error undo, return error
      344   :
      345       if P-grp-code = 0
      346       then do:
      347           assign
      348               p-full-name = ""
      349           .
      350       end.
      351       else do:
      352           find first buf_cd-grp no-lock where
      353                  buf_cd-grp.obj-type = 'маг':U
      354              and buf_cd-grp.obj-code = p-obj-code
      355              and buf_cd-grp.pos-type = 'r-keeper':U
      356              and buf_cd-grp.grp-type = '':U
      357              and buf_cd-grp.grp-code = p-grp-code
      358           no-error.
      359           if not available buf_cd-grp
      360           then do:
      361               undo, return error substitute("get-rkep-grp-name: Не найдена группа меню на кассе R-KEEPER с кодом &1", p-grp-code).
      362           end.
      363           assign
      364               p-full-name  = ""
      365               v-upper-code = 0
      366           .
      367           do while true
      368           on error undo, return error "get-rkep-grp-name: Ошибка составления полного имени группы"
      369           :
      370               assign
      371               p-full-name  = buf_cd-grp.grp-name
      372                           + (if p-full-name <> "" then chr(47) else "")
      373                           + p-full-name
      374               v-upper-code = buf_cd-grp.upper-grp-code
      375               .
      376               if buf_cd-grp.grp-code = 0
      377               then do:
      378                   leave.
      379               end.
      380               find first buf_cd-grp no-lock where
      381                         buf_cd-grp.obj-type = 'маг':U
      382                     and buf_cd-grp.obj-code = p-obj-code
      383                     and buf_cd-grp.pos-type = 'r-keeper':U
      384                     and buf_cd-grp.grp-type = '':U
      385                     and buf_cd-grp.grp-code = v-upper-code no-error.
      386               if not available buf_cd-grp
      387               then do:
      388                   undo, return error "get-rkep-grp-name: Не найдена группа товаров с кодом "
      389                                       + string( v-upper-code )
      390                                       + ". Ошибка ссылки в дереве товаров для узла p-id".
      391               end.
      392           end.
      393           assign
      394               p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      395           .
      396       end.
      397   end.
      398   end procedure.
      399   function get-price-id-from-int returns character ( input p-file-num as integer):
      400     return ('price-list':U + chr(32) +  string(p-file-num)).
      401   end function.
