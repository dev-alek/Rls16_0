     1640       if error-status:error then do:
     1641         run write-log-and-file in p-log-handle (
     1642               input 1
     1643             , input log-file-name
     1644             , input 1
     1645             , input substitute( "!!!Блюдо меню/модификатор на кассе R-KEEPER с id &1 код в меню &2 <&3>&4" +
     1646                               " - не удалось синхронизировать с товар с кодом &5 по названию:&4&6 &7"
     1647                                 , buf_cd-plu.plu-code
     1648                                 , buf_cd-plu.key#_one
     1649                                 , buf_cd-plu.charkey_one
