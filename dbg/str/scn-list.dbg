    10454   PROCEDURE trig-attr :
    10455   define input parameter p-attr-table as character no-undo .
    10456   define input parameter p-list       as character no-undo .
    10457   DEFINE VARIABLE ii as integer no-undo .
    10458   DEFINE VARIABLE vattr-codes          as character           no-undo.
    10459   DEFINE VARIABLE vattr-labels         as character           no-undo.
    10460   DEFINE VARIABLE vtooltip             as character           no-undo.
    10461   DEFINE VARIABLE vlabel               as character           no-undo .
    10462   DEFINE VARIABLE vtype                as character           no-undo .
    10463   DEFINE VARIABLE vformat              as character           no-undo .
    10464   DEFINE VARIABLE vuser-can-edit       as logical             no-undo .
    10465   DEFINE VARIABLE voutput-display      as logical             no-undo .
    10466   DEFINE VARIABLE vother               as character           no-undo .
    10467   DEFINE VARIABLE v-ref-list           as character           no-undo .
    10468   DEFINE VARIABLE jj                   as integer             no-undo .
    10469   DEFINE VARIABLE v-spr                as character           no-undo .
    10470   DEFINE VARIABLE v-spr-param          as character           no-undo .
    10471   DEFINE VARIABLE v-setted             as logical             no-undo .
    10472   define variable v-init               as character           no-undo .
    10473   define variable v-item               as character           no-undo .
    10474   define variable glog as logical no-undo .
    10475   define variable v-list               as character           no-undo .
    10476   assign
    10477   v-attr-code = ""
    10478   vattr-codes = ""
    10479   vattr-labels = ""
    10480   vvalue = ""
    10481   .
    10482   DO ii = 1 to num-entries ( p-list):
    10483       CASE p-attr-table:
    10484         when "gds-obj-attr" then do:
    10485           run gdsoattr-name  in this-procedure (
    10486                                                 input entry(ii, p-list)
    10487                                                 ,output vtype
    10488                                                 ,output vformat
    10489                                                 ,output vlabel
    10490                                                 ,output vuser-can-edit
    10491                                                 ,output voutput-display
    10492                                                 ,output vother) no-error.
    10493         end.
    10494         when "gds-host-attr" then do:
    10495           v-list = 'no-envd,':u.
    10496           run gdshattr-name in this-procedure (
    10497                                                 input entry(ii, p-list)
    10498                                               ,output vtype
    10499                                               ,output vformat
    10500                                               ,output vlabel
    10501                                               ,output vuser-can-edit
    10502                                               ,output voutput-display
    10503                                               ,output vother) no-error.
    10504         end.
    10505         WHEN "goods-attr" then do:
    10506           run gds-attr-name in this-procedure (
    10507                                                 input entry(ii, p-list)
    10508                                                 ,output vtype
    10509                                                 ,output vformat
    10510                                                 ,output vlabel
    10511                                                 ,output vuser-can-edit
    10512                                                 ,output voutput-display
    10513                                                 ,output vother) no-error.
    10514         end.
    10515       END CASE.
    10516       if NOT error-status:error anD VOUTPUT-DISPLAY = yes then do:
    10517           assign
    10518           vattr-codes = vattr-codes + chr(4) + entry(ii, p-list)
    10519           vattr-labels = vattr-labels + chr(4) + vlabel
    10520           .
    10521       end.
    10522   end.
    10523   run gbl/d-list.w ( input "b-sel":U
    10524                     ,input "Выберите атрибут"
    10525                     ,input vattr-codes
    10526                     ,input vattr-labels
    10527                     ,input chr(4)
    10528                     ,input "":U
    10529                     ,output v-attr-code).
    10530   if v-attr-code = "" then do:
    10531     return error.
    10532   end.
    10533   glog = yes.
    10534   CASE rs-list-method:
    10535     when "gds-obj-attr":U then do:
    10536       run gdsoattr-tooltip  in this-procedure( input v-attr-code,
    10537                            output vtooltip,
    10538                            output vlabel).
    10539       message
    10540       "Все товары с установленным атрибутом на объекте" vlabel skip
    10541       stat-line(rs-status)
