    11257       dsp-rs = substitute("ВСЕ топлива &1", v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    11258       v-item = '':U
    11259       .
    11260     end.
    11261     when "gds-office":U then do:
    11262       assign
    11263       dsp-rs = substitute("ВСЕ услуги &1", v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    11264       v-item = '':U
    11265       .
    11266     end.
