    10863   PROCEDURE trig-fbr :
    10864   define input parameter p-method as character no-undo .
    10865   DEFINE VARIABLE vattr-codes          as character           no-undo.
    10866   DEFINE VARIABLE vattr-labels         as character           no-undo.
    10867   DEFINE VARIABLE vlabel               as character           no-undo .
    10868   DEFINE VARIABLE v-ref-list           as character           no-undo .
    10869   DEFINE VARIABLE v-fbr-list           as character           no-undo .
    10870   define variable v-grp-recid          as recid               no-undo .
    10871   define variable v-grp-code like ub.fbr-gds-obj.fbr-grp-code no-undo.
    10872   define variable glog as logical no-undo .
    10873   define variable v-item               as character           no-undo .
    10874   define variable v-fbr-obj-type       like ub.fbr-gds-obj.obj-type no-undo .
    10875   define variable v-fbr-obj-code       like ub.fbr-gds-obj.obj-code no-undo .
    10876   define buffer buf_fbr-gds-grp for ub.fbr-gds-grp.
    10877   if p-method = "fbr-gds-obj-val" then do:
    10878     assign
    10879     v-attr-code = ""
    10880     vattr-codes = "is-cd,is-menu,is-null-price,is-modificator,is-season,is-semi-finished,fbr-grp-code,fbr-obj-code"
    10881     vattr-labels = "Отправлять на кассу РЕСТОРАНА,Является блюдом меню,Без цены,Модификатор блюда,Применять сезонный коэффициент," +
    10882                   "Является полуфабрикатом,Группа меню,Кухня"
    10883     vvalue = ""
    10884     .
    10885     run gbl/d-list.w ( input "b-sel":U
    10886                       ,input "Выберите атрибут"
    10887                       ,input vattr-codes
    10888                       ,input vattr-labels
    10889                       ,input chr(44)
    10890                       ,input "":U
    10891                       ,output v-attr-code).
    10892     if v-attr-code = "" then do:
    10893       return error.
    10894     end.
    10895     assign
    10896     vlabel =  entry(lookup(v-attr-code, vattr-codes) ,vattr-labels)
    10897     glog = yes.
    10898   end.
    10899   define variable vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10900   run userobjs_select-one in this-procedure
    10901     (input  parparentproc
    10902     ,input  v-cntxt-db-num
    10903     ,input  v-cntxt-userid
    10904     ,input  v-cntxt-host-code-obj
    10905     ,input  v-cntxt-obj-type
    10906     ,input  v-cntxt-obj-code
    10907     ,output v-user-select
    10908     ,output v-sel-obj-type
    10909     ,output v-sel-obj-code
    10910     )  .
    10911     if not v-user-select then do:
    10912       return error.
    10913     end.
    10914   if p-method = "fbr-gds-obj-val" then do:
    10915     CASE v-attr-code:
    10916       when "fbr-grp-code" then do:
    10917           run ref/fbrggrp.w (
    10918                   input ?
    10919                 ,input v-sel-obj-type
    10920                 ,input v-sel-obj-code
    10921                 ,input "b-sel"
    10922                 ,input-output v-grp-recid
    10923             ).
    10924         if v-grp-recid = ? then return error.
    10925         FIND FIRST buf_fbr-gds-grp no-lock where
    10926                 recid(buf_fbr-gds-grp) = v-grp-recid No-ERROR.
    10927         if not avail buf_fbr-gds-grp then return error.
    10928         assign
    10929         vvalue = string(buf_fbr-gds-grp.node-code)
    10930         vlabel = vlabel + " = ":U + buf_fbr-gds-grp.node-name
    10931         .
    10932       end.
    10933       when "fbr-obj-code" then do:
    10934         message
    10935         "Выберите объект-КУХНЮ для товара объекта" v-sel-obj-type v-sel-obj-code
    10936         view-as alert-box.
    10937   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10938   run userobjs_select-one in this-procedure
    10939     (input  parparentproc
    10940     ,input  v-cntxt-db-num
    10941     ,input  v-cntxt-userid
    10942     ,input  v-cntxt-host-code-obj
    10943     ,input  v-cntxt-obj-type
    10944     ,input  v-cntxt-obj-code
    10945     ,output v-user-select
    10946     ,output v-fbr-obj-type
    10947     ,output v-fbr-obj-code
    10948     )  .
    10949         assign
    10950         vvalue = string(v-fbr-obj-code)
    10951         .
    10952       end.
    10953       otherwise do:
    10954         assign
    10955         vvalue = "yes":U
    10956         .
    10957         run gbl/d-prompt.w (
    10958           'title=':u + "Значение атрибута товара на объекте" + '\':u
    10959         + 'text1=':u + vlabel + '\':u
    10960         + 'format=yes/no' + '\':u
    10961         + 'type=logical' + '\':u
    10962         + 'fillin_row=2\':u
    10963         + 'fillin_col=4\':u
    10964         + 'fillin_width=20\':u
    10965         + 'fillin_height=1\':u
    10966         + 'max-chars=70\':u
    10967         + 'readonly=no\':u
    10968         , input-output vvalue
    10969         ).
    10970         if return-value = 'false':U then do:
    10971           return error.
    10972         end.
    10973       end.
    10974     END CASE.
    10975     assign
    10976     dsp-rs = substitute("Товары объекта &1&2 с атрибутом РЕСТОРАН &3 =&4&5&5"
    10977                          ,  v-sel-obj-type, v-sel-obj-code, vlabel, vvalue
    10978                          , chr(10)
    10979                          , stat-line(rs-status)
    10980                          )
    10981     v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code) + chr(3) + v-attr-code + chr(3) + vvalue
    10982     .
    10983   end.
    10984   else do:
    10985     assign
    10986     dsp-rs = substitute("Товары объекта &1&2, имеющие атрибут РЕСТОРАН&3&4"
    10987                        ,  v-sel-obj-type
    10988                         , v-sel-obj-code
    10989                          , chr(10)
    10990                          , stat-line(rs-status)
    10991                        )
    10992      v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code) + chr(3)
    10993      .
    10994   end.
    10995     message
    10996     dsp-rs skip
    10997     view-as alert-box question buttons OK-Cancel update glog.
    10998   if not glog then do:
    10999     return error.
    11000   end.
    11001   run create-scn-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    11002                                       , input-output v-seq
    11003                                       , input 0
    11004                                       , input '':U
    11005                                       , input dsp-rs
    11006                                       , input tot-lns
    11007                                       , input rs-list-method
    11008                                       , input rs-status
    11009                                       , input v-item
    11010                                       , input '':U
    11011                                       , input ?
    11012                                       ).
    11013   END PROCEDURE.
    11014   PROCEDURE proc-scales-gds :
    11015   define input parameter rs-list-method as character no-undo .
    11016   define variable v-ref-list as character no-undo .
    11017   define variable v-rid-list as character no-undo .
    11018   define variable glog as logical no-undo .
    11019   define variable v-message as character no-undo .
    11020   define variable v-item as character no-undo .
    11021   define buffer buf_scales for ub.scales.
    11022   glog = yes.
    11023   CASE rs-list-method:
    11024     when "scales-gds":U then do:
    11025       assign
    11026       v-message = substitute("Все товары на весах на объекте&1&2", chr(10), stat-line(rs-status))
    11027       .
    11028     end.
    11029     when "scales-gds-num":U then do:
    11030       assign
    11031       v-message = substitute("Товары на одних весах на объекте &1&2", chr(10), stat-line(rs-status))
    11032       .
    11033     end.
    11034   END CASE.
    11035   message
    11036   v-message
    11037   view-as alert-box question buttons OK-Cancel update glog.
    11038   if not glog then do:
    11039     return error.
    11040   end.
    11041   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11042   run userobjs_select-one in this-procedure
    11043     (input  parparentproc
    11044     ,input  v-cntxt-db-num
    11045     ,input  v-cntxt-userid
    11046     ,input  v-cntxt-host-code-obj
    11047     ,input  v-cntxt-obj-type
    11048     ,input  v-cntxt-obj-code
    11049     ,output v-user-select
    11050     ,output v-sel-obj-type
    11051     ,output v-sel-obj-code
    11052     )  .
    11053   if not v-user-select then do:
    11054     return error.
    11055   end.
    11056   if rs-list-method = "scales-gds-num" then do:
    11057     run ref/scales.w ( input parparentproc
    11058                       ,input v-sel-obj-type
    11059                       ,input v-sel-obj-code
    11060                       ,input "b-sel"
    11061                       ,input 'db':U
    11062                       ,output v-rid-list).
    11063     if v-rid-list = '':U then do:
    11064       return error.
    11065     end.
    11066     find first buf_scales no-lock where
    11067               recid(buf_scales) = integer(v-rid-list).
    11068   end.
    11069   CASE rs-list-method:
    11070     when "scales-gds":U then do:
    11071       assign
    11072       dsp-rs = substitute("ВСЕ товары на весах на объекте &1&2 &3", v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    11073       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)
    11074       .
    11075     end.
    11076     when "scales-gds-num":U then do:
    11077       assign
    11078       dsp-rs = substitute("Товары на весах &1 на объекте &2&3 &4", buf_scales.scales-num, v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    11079       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)  + chr(3) + string(buf_scales.scales-num)
    11080       .
    11081     end.
    11082   END CASE.
    11083   v-no-hist = 0.
    11084   run create-scn-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    11085                                       , input-output v-seq
    11086                                       , input 0
    11087                                       , input '':U
    11088                                       , input dsp-rs
    11089                                       , input tot-lns
    11090                                       , input rs-list-method
    11091                                       , input rs-status
    11092                                       , input v-item
    11093                                       , input '':U
    11094                                       , input ?
    11095                                       ).
    11096   END PROCEDURE.
    11097   PROCEDURE proc-parts-last-date :
    11098   define input parameter rs-list-method as character no-undo .
    11099   define variable v-value-integer as integer   no-undo .
    11100   define variable glog as logical no-undo .
    11101   define variable v-message as character no-undo .
    11102   define variable v-item as character no-undo .
    11103   glog = yes.
    11104   CASE rs-list-method:
    11105     when "parts-last-date":U then do:
    11106       assign
    11107       v-message = substitute("Партии свободной зоны на &1&2 с истекающим сроком хранения", chr(10), stat-line(rs-status))
    11108       .
    11109     end.
    11110   END CASE.
    11111   message
    11112   v-message
    11113   view-as alert-box question buttons OK-Cancel update glog.
    11114   if not glog then do:
    11115     return error.
    11116   end.
    11117   define variable vss-include-info70 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11118   run userobjs_select-one in this-procedure
    11119     (input  parparentproc
    11120     ,input  v-cntxt-db-num
    11121     ,input  v-cntxt-userid
    11122     ,input  v-cntxt-host-code-obj
    11123     ,input  v-cntxt-obj-type
    11124     ,input  v-cntxt-obj-code
    11125     ,output v-user-select
    11126     ,output v-sel-obj-type
    11127     ,output v-sel-obj-code
    11128     )  .
    11129   if not v-user-select then do:
    11130     return error.
    11131   end.
    11132   run gbl/d-integer.w (
    11133           input ?
    11134         ,input (
    11135         'title=':u + substitute("Введите кол-во дней в течение которых истекает срок хранения") + '\':u
    11136       + 'text1=':u + "Кол-во дней" + '\':u
    11137       + 'format=' + ">>9" + '\':u
    11138       + 'fillin_row=3\':u
    11139       + 'fillin_col=4\':u
    11140       + 'fillin_width=20\':u
    11141       + 'fillin_height=1\':u
    11142       + 'max-chars=70\':u
    11143       + 'readonly=' +  'no':u + '\':u)
    11144       , input-output v-value-integer
    11145       , output v-ok
    11146           ).
    11147   if not v-ok then return error.
    11148   CASE rs-list-method:
    11149     when "parts-last-date":U then do:
    11150       assign
    11151       dsp-rs = substitute("Партии свободной зоны на &1&2 со сроком хранения, истекающим через &3 дн.  и ранее &4", v-sel-obj-type, v-sel-obj-code, v-value-integer, stat-line(rs-status))
    11152       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)  + chr(3) + string(v-value-integer)
    11153       .
    11154     end.
    11155   END CASE.
    11156   v-no-hist = 0.
    11157   run create-scn-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    11158                                       , input-output v-seq
    11159                                       , input 0
    11160                                       , input '':U
    11161                                       , input dsp-rs
    11162                                       , input tot-lns
    11163                                       , input rs-list-method
    11164                                       , input rs-status
    11165                                       , input v-item
    11166                                       , input '':U
    11167                                       , input ?
    11168                                       ).
    11169   END PROCEDURE.
    11170   PROCEDURE proc-parts-fib :
    11171   define input parameter rs-list-method as character no-undo .
    11172   define variable v-value-integer as integer   no-undo .
    11173   define variable glog as logical no-undo .
    11174   define variable v-message as character no-undo .
    11175   define variable v-item as character no-undo .
    11176   glog = yes.
    11177   CASE rs-list-method:
    11178     when "parts-last-date":U then do:
    11179       assign
    11180       v-message = substitute("ФиБ партии свободной зоны на &1&2", chr(10), stat-line(rs-status))
    11181       .
    11182     end.
    11183   END CASE.
    11184   message
    11185   v-message
    11186   view-as alert-box question buttons OK-Cancel update glog.
    11187   if not glog then do:
    11188     return error.
    11189   end.
    11190   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11191   run userobjs_select-one in this-procedure
    11192     (input  parparentproc
    11193     ,input  v-cntxt-db-num
    11194     ,input  v-cntxt-userid
    11195     ,input  v-cntxt-host-code-obj
    11196     ,input  v-cntxt-obj-type
    11197     ,input  v-cntxt-obj-code
    11198     ,output v-user-select
    11199     ,output v-sel-obj-type
    11200     ,output v-sel-obj-code
    11201     )  .
    11202   if not v-user-select then do:
    11203     return error.
    11204   end.
    11205   CASE rs-list-method:
    11206     when "parts-fib":U then do:
    11207       assign
    11208       dsp-rs = substitute("ФиБ партии свободной зоны на &1&2 &4", v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    11209       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)
    11210       .
    11211     end.
    11212   END CASE.
    11213   v-no-hist = 0.
    11214   run create-scn-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    11215                                       , input-output v-seq
    11216                                       , input 0
    11217                                       , input '':U
    11218                                       , input dsp-rs
    11219                                       , input tot-lns
    11220                                       , input rs-list-method
    11221                                       , input rs-status
    11222                                       , input v-item
    11223                                       , input '':U
    11224                                       , input ?
    11225                                       ).
    11226   END PROCEDURE.
    11227   PROCEDURE proc-simple :
    11228   define input parameter rs-list-method as character no-undo .
    11229   define variable v-ref-list as character no-undo .
    11230   define variable v-rid-list as character no-undo .
    11231   define variable glog as logical no-undo .
    11232   define variable v-message as character no-undo .
    11233   define variable v-item as character no-undo .
    11234   define buffer buf_scales for ub.scales.
