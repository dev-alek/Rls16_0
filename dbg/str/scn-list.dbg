      330   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      331   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      332   procedure gen-key-rec :
      333     define input  parameter p-tbl-name    as character no-undo.
      334     define input  parameter p-bh_tbl-name as handle    no-undo.
      335     define output parameter p-key-rec     as character no-undo.
      336     do
      337     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      338     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      339     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      340     :
      341       define variable fh               as handle    no-undo .
      342       define variable v-ok             as logical   no-undo .
      343       define variable v-inform         as character no-undo .
      344       define variable v-ind            as integer   no-undo .
      345       define variable v-idx-field-qnty as integer   no-undo .
      346       if p-tbl-name = ?
      347         or p-tbl-name = "":U
      348       then do:
      349         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
      350       end.
      351       if not p-bh_tbl-name:available then do:
      352         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
      353       end.
      354       assign
      355         p-key-rec = p-tbl-name
      356         v-inform  = p-bh_tbl-name:index-information(1)
      357         v-ind     = 2
      358       .
      359       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      360       on error undo, return error
      361       :
      362         assign
      363           v-inform = p-bh_tbl-name:index-information( v-ind )
      364           v-ind    = v-ind + 1
      365         .
      366       end.
      367       if v-inform = ?
      368         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      369         or entry( 3, v-inform, ",":U ) <> "1":U
      370       then do:
      371         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
      372       end.
      373       else do:
      374         assign
      375           v-idx-field-qnty = num-entries( v-inform ) - 4
      376         .
      377         if v-idx-field-qnty < 2 then do:
      378           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
      379         end.
      380         do v-ind = 1 to v-idx-field-qnty by 2
      381         on error undo, return error
      382         :
      383           assign
      384             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      385             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      386           .
      387         end.
      388       end.
      389       if p-key-rec = ? then do:
      390         assign
      391           p-key-rec = "":U
      392         .
      393         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
      394       end.
      395     end.
      396     return.
      397   end procedure.
      398   procedure gen-where-keyr-tab :
      399     define input  parameter i-tableSerach as character no-undo.
      400     define input  parameter i-tablekey   as character  no-undo.
      401     define input  parameter p-key-rec    as character  no-undo.
      402     define input  parameter p-key-handle as handle     no-undo .
      403     define input  parameter p-db-name    as character  no-undo .
      404     define input  parameter p-tt-handle  as handle     no-undo .
      405     define output parameter o-Where      as character  no-undo.
      406     do
      407     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      408     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      409     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      410     :
      411       define variable v-full-tbl-name  as character no-undo .
      412       define variable bh_tbl-name      as handle    no-undo .
      413       define variable fh_key           as handle    no-undo .
      414       define variable fh_search        as handle    no-undo .
      415       define variable v-field-num      as integer   no-undo .
      416       define variable v-count-fld      as integer   no-undo .
      417       define variable v-inform         as character no-undo .
      418       define variable v-ind            as integer   no-undo .
      419       define variable v-idx-field-qnty as integer   no-undo .
      420       define variable v-field-name     as character no-undo .
      421       define variable v-field-val      as character no-undo .
      422       define variable v-word-link      as character no-undo .
      423       define variable vTable           as character no-undo.
      424       define variable bh_tbl-key       as handle    no-undo .
      425       assign
      426         p-key-rec = trim( p-key-rec )
      427       .
      428       if p-key-handle <> ? then do:
      429         if not valid-handle(p-key-handle)
      430            or p-key-handle:type <> "buffer"
      431         then do:
      432           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
      433         end.
      434         if num-entries( p-key-rec, chr(3) ) > 1
      435           or p-key-rec = ?
      436           or p-key-rec = "":U
      437         then do:
      438           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
      439         end.
      440       end.
      441       else do:
      442         if p-key-rec = ?
      443           or p-key-rec = "":U
      444         then do:
      445           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      446         end.
      447       end.
      448       assign
      449         vTable = entry( 1 , p-key-rec, chr(3) )
      450       .
      451       if p-tt-handle <> ?
      452         and ( not valid-handle(p-tt-handle)
      453               or p-tt-handle:type <> "buffer"
      454             )
      455       then do:
      456         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
      457       end.
      458       if p-tt-handle = ? then do:
      459         assign
      460           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      461         .
      462         create buffer bh_tbl-name for table v-full-tbl-name .
      463       end.
      464       else do:
      465         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      466       end.
      467       assign
      468         v-inform = bh_tbl-name:index-information(1)
      469         v-ind    = 2
      470       .
      471       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      472       on error undo, return error
      473       :
      474         assign
      475           v-inform = bh_tbl-name:index-information( v-ind )
      476           v-ind    = v-ind + 1
      477         .
      478       end.
      479       if v-inform = ?
      480         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      481         or entry( 3, v-inform, ",":U ) <> "1":U
      482       then do:
      483         delete object bh_tbl-name no-error.
      484         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
      485       end.
      486       assign
      487         v-idx-field-qnty = num-entries( v-inform ) - 4
      488       .
      489       if v-idx-field-qnty < 2 then do:
      490         delete object bh_tbl-name no-error.
      491         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
      492       end.
      493       assign
      494         o-where     = "where":U
      495         v-word-link = "":U
      496         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      497         v-count-fld = 0
      498       .
      499       if i-tablekey ne "" and i-tablekey ne ?
      500       then do:
      501         assign
      502           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      503         .
      504         create buffer bh_tbl-key for table v-full-tbl-name .
      505       end.
      506       if i-tableSerach ne "" and i-tableSerach ne ?
      507       then do:
      508         delete object bh_tbl-name no-error.
      509         assign
      510           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      511         .
      512         create buffer bh_tbl-name for table v-full-tbl-name .
      513       end.
      514       block_where:
      515       do v-ind = 1 to v-idx-field-qnty by 2
      516       on error undo, return error
      517       :
      518         assign
      519           v-count-fld = v-count-fld + 1
      520         .
      521         if p-key-handle = ?
      522           and v-count-fld > v-field-num
      523         then do:
      524           leave block_where.
      525         end.
      526         define variable VfieldKeyTable as handle no-undo.
      527         assign
      528           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      529           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      530         .
      531         if     bh_tbl-key ne ?
      532         then do:
      533            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      534            if VfieldKeyTable eq ?
      535            then next block_where.
      536         end.
      537         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      538         then
      539            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      540         else
      541            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      542         if p-key-handle = ? then do:
      543           assign
      544             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      545           .
      546         end.
      547         else do:
      548           assign
      549             fh_key = p-key-handle:buffer-field( v-field-name )
      550           .
      551           if fh_key = ?
      552             or not valid-handle( fh_key )
      553           then do:
      554             delete object bh_tbl-name.
      555             if     bh_tbl-key ne ?
      556             then
      557                delete object bh_tbl-key.
      558             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
      559           end.
      560           assign
      561             v-field-val = fh_key:buffer-value
      562           .
      563         end.
      564         if fh_search:data-type ="character":U then do:
      565           assign
      566             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      567             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      568             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      569             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      570             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      571             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      572             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      573             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      574             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      575             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      576             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      577             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      578             v-field-val = substitute( '"&1"', v-field-val )
      579           .
      580         end.
      581         assign
      582           o-where = substitute( "&1 &2", o-where, v-field-val )
      583         .
      584         if v-word-link = "":U then do:
      585           assign
      586             v-word-link = "and":U
      587           .
      588         end.
      589       end.
      590       delete object bh_tbl-name.
      591       if     bh_tbl-key ne ?
      592       then
      593          delete object bh_tbl-key.
      594       if p-key-handle = ?
      595         and v-count-fld <> v-field-num
      596       then do:
      597         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
      598       end.
      599     end.
      600   end procedure.
      601   procedure gen-hn-keyr-tab :
      602     define input  parameter i-tableSerach as character no-undo.
      603     define input  parameter i-tablekey   as character no-undo.
      604     define input  parameter p-key-rec    as character no-undo.
      605     define input  parameter p-key-handle as handle    no-undo .
      606     define input  parameter p-db-name    as character no-undo .
      607     define input  parameter p-tt-handle  as handle    no-undo .
      608     define input  parameter p-stts-lock  as integer   no-undo .
      609     define output parameter o-hn         as handle    no-undo.
      610     define variable v-full-tbl-name as character no-undo.
      611     define variable v-where         as character no-undo.
      612     define variable bh_tbl-name     as handle    no-undo.
      613     define variable vTable          as character no-undo.
      614     do
      615     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      616     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      617     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      618         run gen-where-keyr-tab(i-tableSerach,
      619                                i-tablekey,
      620                                p-key-rec,
      621                                p-key-handle,
      622                                p-db-name,
      623                                p-tt-handle,
      624                                output v-where).
      625         if i-tableSerach ne "" and i-tableSerach ne ?
      626         then do:
      627            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      628            create buffer bh_tbl-name for table v-full-tbl-name .
      629         end.
      630         else do:
      631            if p-tt-handle = ? then do:
      632               assign
      633                  vTable = entry( 1 , p-key-rec, chr(3) )
      634               .
      635               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      636               create buffer bh_tbl-name for table v-full-tbl-name .
      637            end.
      638            else do:
      639               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      640            end.
      641         end.
      642         if p-tt-handle = ? then do:
      643            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      644         end.
      645         else do:
      646            bh_tbl-name:find-first( v-where ) no-error .
      647         end.
      648         o-hn = bh_tbl-name.
      649      end.
      650   end procedure.
      651   procedure gen-hn-keyr :
      652     define input  parameter p-key-rec    as character no-undo.
      653     define input  parameter p-key-handle as handle    no-undo .
      654     define input  parameter p-db-name    as character no-undo .
      655     define input  parameter p-tt-handle  as handle    no-undo .
      656     define input  parameter p-stts-lock  as integer   no-undo .
      657     define output parameter o-hn         as handle    no-undo.
      658     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      659   end.
      660   procedure gen-row-keyr :
      661     define input  parameter p-key-rec    as character no-undo.
      662     define input  parameter p-key-handle as handle    no-undo .
      663     define input  parameter p-db-name    as character no-undo .
      664     define input  parameter p-tt-handle  as handle    no-undo .
      665     define input  parameter p-stts-lock  as integer   no-undo .
      666     define output parameter p-tbl-row    as rowid     no-undo.
      667     define output parameter p-tbl-name   as character no-undo.
      668     define variable vHn as handle no-undo.
      669       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      670       p-tbl-row = if vHn:available then vHn:rowid else ?.
      671       p-tbl-name =  vHn:table.
      672       delete object vHn no-error.
      673     if p-tbl-row = ? then do:
      674       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
      675     end.
      676     else do:
      677       return.
      678     end.
      679   end procedure.
      680   procedure gen-key-fv :
      681     define input  parameter p-key-rec    as character no-undo .
      682     define output parameter p-field-list as character no-undo .
      683     define output parameter p-value-list as character no-undo.
      684     do
      685     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      686     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      687     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      688     :
      689       define variable v-full-tbl-name  as character no-undo .
      690       define variable bh_tbl-name      as handle    no-undo .
      691       define variable v-tbl-name       as character no-undo .
      692       define variable v-field-num      as integer   no-undo .
      693       define variable v-count-fld      as integer   no-undo .
      694       define variable v-inform         as character no-undo .
      695       define variable v-ind            as integer   no-undo .
      696       define variable v-idx-field-qnty as integer   no-undo .
      697       define variable v-delim-key      as character no-undo .
      698       if p-key-rec = ?
      699         or p-key-rec = "":U
      700       then do:
      701         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      702       end.
      703       assign
      704         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      705         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      706       .
      707       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      708       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
      709       assign
      710         v-inform = bh_tbl-name:index-information(1)
      711         v-ind    = 2
      712       .
      713       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      714       on error undo, return error
      715       :
      716         assign
      717           v-inform = bh_tbl-name:index-information( v-ind )
      718           v-ind    = v-ind + 1
      719         .
      720       end.
      721       if v-inform = ?
      722         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      723         or entry( 3, v-inform, ",":U ) <> "1":U
      724       then do:
      725         delete object bh_tbl-name no-error.
      726         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      727       end.
      728       assign
      729         v-idx-field-qnty = num-entries( v-inform ) - 4
      730       .
      731       if v-idx-field-qnty < 2 then do:
      732         delete object bh_tbl-name no-error.
      733         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      734       end.
      735       assign
      736         p-field-list = "":U
      737         p-value-list = "":U
      738         v-delim-key  = "":U
      739         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      740         v-count-fld  = 0
      741       .
      742       block_where:
      743       do v-ind = 1 to v-idx-field-qnty by 2
      744       on error undo, return error
      745       :
      746         assign
      747           v-count-fld = v-count-fld + 1
      748         .
      749         if v-count-fld > v-field-num then do:
      750           leave block_where.
      751         end.
      752         assign
      753           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      754           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      755         .
      756         if v-ind = 1 then do:
      757           assign
      758             v-delim-key = chr(3)
      759           .
      760         end.
      761       end.
      762       delete object bh_tbl-name.
      763       if v-count-fld <> v-field-num then do:
      764         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
      765       end.
      766     end.
      767   end procedure.
      768   procedure gen-key-field :
      769     define input  parameter p-table      as character no-undo .
      770     define output parameter p-field-list as character no-undo .
      771     do
      772     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      773     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      774     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      775     :
      776       define variable v-full-tbl-name  as character no-undo .
      777       define variable bh_tbl-name      as handle    no-undo .
      778       define variable v-tbl-name       as character no-undo .
      779       define variable v-field-num      as integer   no-undo .
      780       define variable v-count-fld      as integer   no-undo .
      781       define variable v-inform         as character no-undo .
      782       define variable v-ind            as integer   no-undo .
      783       define variable v-idx-field-qnty as integer   no-undo .
      784       define variable v-delim-key      as character no-undo .
      785       if p-table = ?
      786         or p-table = "":U
      787       then do:
      788         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
      789       end.
      790       assign
      791         v-tbl-name      = p-table
      792         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      793       .
      794       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      795       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
      796       assign
      797         v-inform = bh_tbl-name:index-information(1)
      798         v-ind    = 2
      799       .
      800       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      801       on error undo, return error
      802       :
      803         assign
      804           v-inform = bh_tbl-name:index-information( v-ind )
      805           v-ind    = v-ind + 1
      806         .
      807       end.
      808       if v-inform = ?
      809         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      810         or entry( 3, v-inform, ",":U ) <> "1":U
      811       then do:
      812         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      813       end.
      814       assign
      815         v-idx-field-qnty = num-entries( v-inform ) - 4
      816       .
      817       if v-idx-field-qnty < 2 then do:
      818         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      819       end.
      820       assign
      821         p-field-list = "":U
      822         v-delim-key  = "":U
      823         v-count-fld  = 0
      824       .
      825       block_where:
      826       do v-ind = 1 to v-idx-field-qnty by 2
      827       on error undo, return error
      828       :
      829         assign
      830           v-count-fld = v-count-fld + 1
      831         .
      832         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      833         if v-ind = 1 then do:
      834           assign
      835             v-delim-key = chr(3)
      836           .
      837         end.
      838       end.
      839       delete object bh_tbl-name.
      840     end.
      841   end procedure.
      842   procedure create-scn-list-hist :
      843   define input parameter p-mode as character no-undo .
      844   define input-output parameter p-seq as integer no-undo .
      845   define input parameter p-line as integer no-undo .
      846   define variable p-list-table as character no-undo .
      847   define input parameter p-hist-mode as character no-undo .
      848   define input parameter p-des as character no-undo .
      849   define input parameter p-num-recs as integer no-undo .
      850   define input parameter p-option as character no-undo .
      851   define input parameter p-status_ as character no-undo .
      852   define input parameter p-item as character no-undo .
      853   define input parameter p-tbl-name as character no-undo .
      854   define input parameter p-bh_tbl-name as handle no-undo .
      855   define variable v-num-add as integer no-undo .
      856   define variable v-num-ignored as integer no-undo .
      857   define buffer buf_scn-list-hist for scn-list-hist.
      858     do
      859     on error undo, return error
      860     :
      861       CASE p-mode:
      862         when 'title' then do:
      863           find first buf_scn-list-hist where
      864                      buf_scn-list-hist.id = 0   no-error.
      865           if not available buf_scn-list-hist then do:
      866             create buf_scn-list-hist.
      867             assign
      868             buf_scn-list-hist.id = 0
      869             buf_scn-list-hist.line = 0
      870             buf_scn-list-hist.list-table = '':U
      871             .
      872           end.
      873           assign
      874           buf_scn-list-hist.des =  p-des
      875           buf_scn-list-hist.num-recs = p-num-recs
      876           buf_scn-list-hist.option_  = p-option
      877           buf_scn-list-hist.item_ = p-item
      878           .
      879         end.
      880         when 'ДОБАВЛЕНИЕ':U then do:
      881           if p-option begins 'single' then do:
      882             CASE p-hist-mode:
      883               when '+':U then do:
      884                 assign
      885                 v-num-add = 1
      886                 v-num-ignored  = 0
      887                 .
      888               end.
      889               when '-':U then do:
      890                 assign
      891                 v-num-add = 1
      892                 v-num-ignored  = 0
      893                 .
      894               end.
      895               when '*':U then do:
      896                 assign
      897                 v-num-add = p-num-recs - 1
      898                 p-num-recs = 1
      899                 v-num-ignored  = 0
      900                 .
      901               end.
      902             END CASE.
      903           end.
      904           create buf_scn-list-hist.
      905           assign
      906           buf_scn-list-hist.id = p-seq
      907           buf_scn-list-hist.list-table = p-list-table
      908            p-seq = (if p-line = 0 then (p-seq + 1) else p-seq)
      909           buf_scn-list-hist.des =  p-des
      910           buf_scn-list-hist.line = p-line
      911           buf_scn-list-hist.num-recs = p-num-recs
      912           buf_scn-list-hist.option_  = p-option
      913           buf_scn-list-hist.item_ = p-item
      914           buf_scn-list-hist.hist-mode =  p-hist-mode
      915           buf_scn-list-hist.status_ =  p-status_
      916           buf_scn-list-hist.num-add = v-num-add
      917           buf_scn-list-hist.num-ignored = v-num-ignored
      918           .
      919         end.
      920         when 'ИЗМЕНЕНИЕ':U + chr(4) + 'des' then do:
      921           find first buf_scn-list-hist where
      922                     buf_scn-list-hist.id = p-seq
      923                 and buf_scn-list-hist.line = p-line no-error .
      924           if  available buf_scn-list-hist then do:
      925             assign
      926             buf_scn-list-hist.des =  p-des
      927             buf_scn-list-hist.num-recs = p-num-recs
      928             buf_scn-list-hist.option_  = p-option
      929             buf_scn-list-hist.item_ = p-item
      930             buf_scn-list-hist.list-table = (if p-list-table <> '':U and p-list-table <> ?
      931                                        then p-list-table
      932                                        else buf_scn-list-hist.list-table)
      933             .
      934           end.
      935         end.
      936         when 'ИЗМЕНЕНИЕ':U + chr(4) + 'mode' then do:
      937           find first buf_scn-list-hist where
      938                     buf_scn-list-hist.id = p-seq
      939                 and buf_scn-list-hist.line = p-line  no-error .
      940           if available buf_scn-list-hist then do:
      941             assign
      942             buf_scn-list-hist.hist-mode =  p-hist-mode
      943             buf_scn-list-hist.num-recs  = (if buf_scn-list-hist.line = 0 then p-num-recs else buf_scn-list-hist.num-recs)
      944             buf_scn-list-hist.list-table = (if p-list-table <> '':U and p-list-table <> ?
      945                                        then p-list-table
      946                                        else buf_scn-list-hist.list-table)
      947             .
      948           end.
      949         end.
      950       END CASE.
      951       if p-tbl-name <> "":U
      952       and valid-handle(p-bh_tbl-name)
      953       then do:
      954         run gen-key-rec  in this-procedure (
      955                                               input  p-tbl-name
      956                                              ,input  p-bh_tbl-name
      957                                              ,output p-item) no-error .
      958         if not error-status:error then do:
      959           assign
      960           buf_scn-list-hist.item_ = p-item
      961           .
      962         end.
      963         else do:
      964           assign
      965           buf_scn-list-hist.item_ = "!ERROR"
      966           .
      967         end.
      968       end.
      969     end.
      970   end procedure.
      971   FUNCTION get-line-mode returns character(input p-hist-mode as character):
      972   case p-hist-mode:
      973     when '+':U then
      974       return  'ДОБАВЛЕНИЕ':U.
      975     when '-':U then
      976       return  'удаление':U.
      977     when '*':U then
      978       return  'ОСТАВИТЬ':U.
      979   end CASE.
      980   END FUNCTION.
      981   FUNCTION get-hist-mode returns character(input p-line-mode as character):
      982   case p-line-mode:
      983     when 'ДОБАВЛЕНИЕ':U then
      984       return  "+".
      985     when 'удаление':U then
      986       return  "-".
      987     when 'ОСТАВИТЬ':U then
      988       return  "*".
      989   end CASE.
      990   END FUNCTION.
      991   procedure proc-write-filter-expression :
      992   define input parameter p-filter-expression as character no-undo .
      993   define variable v-ii as integer no-undo .
      994   output to value(string(g#report-num) + ".whr").
      995   put .
      996   if num-entries(p-filter-expression) > 0 then do:
      997      put unformatted 'and ('.
      998      do v-ii = 1 to num-entries(p-filter-expression):
      999        put unformatted entry(v-ii, p-filter-expression) skip.
     1000      end.
     1001      put unformatted ')'.
     1002   end.
     1003   output close.
     1004   end procedure.
     1005   procedure proc-write-filter-expression-var :
     1006   define input parameter p-filter-expression as character no-undo .
     1007   define output parameter p-string as character no-undo .
     1008   define variable v-ii as integer no-undo .
     1009   if num-entries(p-filter-expression) > 0 then do:
     1010      p-string = 'and ('.
     1011      do v-ii = 1 to num-entries(p-filter-expression):
     1012        p-string = p-string + entry(v-ii, p-filter-expression) + chr(10).
     1013      end.
     1014      p-string = p-string + ')'.
     1015   end.
     1016   end procedure.
     1017   define new global shared variable g#libbcrcn as handle no-undo .
     1018   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1019   define variable v-waitfram-action01         as character   no-undo .
     1020   define variable v-waitfram-action02         as character   no-undo .
     1021   define variable v-waitfram-action03         as character   no-undo .
     1022   define variable mWaitFramTextBeg            as character   no-undo.
     1023   define variable mWaitFramTextEnd            as character   no-undo.
     1024   define variable mWaitFramView               as logical     no-undo.
     1025   define variable mWaitProcEvent              as logical     no-undo init yes.
     1026   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1027   define variable mWaitFramStop               as logical     no-undo.
     1028   define variable mWaitFramStopUser           as logical     no-undo.
     1029   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1030   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1031   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1032   define button B-WaitFramStop auto-end-key
     1033        label "Стоп"
     1034        size 10 by 1 tooltip "Остоновить процесс".
     1035   define button B-viewProcInfo
     1036        label "Информация"
     1037        size 15 by 1 tooltip "Информация о процесс".
     1038   define frame waitfram
     1039     v-waitfram-action01 format "x(72)" no-label skip
     1040     v-waitfram-action02 format "x(72)" no-label skip
     1041     v-waitfram-action03 format "x(72)" no-label skip
     1042     B-viewProcInfo
     1043     B-WaitFramStop at row 4 col 30
     1044     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1045     .
     1046   define new global shared variable mBatchMode as logical no-undo init ?.
     1047   define variable mFramBachModHandle as handle no-undo.
     1048   mFramBachModHandle = frame waitfram:handle.
     1049   define variable mFameOldVis as logical no-undo.
     1050   define variable mVisCUrentVin as logical no-undo.
     1051   if session:batch-mode
     1052   then
     1053      mBatchMode = yes.
     1054   if mBatchMode = ? then do:
     1055     mVisCUrentVin = current-window:visible.
     1056     mFameOldVis = mFramBachModHandle:visible.
     1057     mFramBachModHandle:visible  = yes.
     1058     mBatchMode = mFramBachModHandle:visible ne yes.
     1059     mFramBachModHandle:visible = mFameOldVis.
     1060     current-window:visible = mVisCUrentVin.
     1061   end.
     1062    if  log-manager:logfile-name ne ?
     1063     then DO:
     1064         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1065         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1066         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1067     end.
     1068   on choose of B-WaitFramStop in frame waitfram
     1069   do:
     1070     mWaitFramStop = yes.
     1071     mWaitFramStopUser = yes.
     1072   end.
     1073   function waitfram-check-timeout returns logical():
     1074      define variable vtime as int64 no-undo.
     1075      if mWaitFramStopTimeOut
     1076      then
     1077         return yes.
     1078      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1079      if     mWaitFramTimeOut ne ?
     1080         and mWaitFramTimeOut ne 0
     1081         and mWaitFramTimeOut lt vtime
     1082      then do:
     1083         mWaitFramStopTimeOut = yes.
     1084      end.
     1085      return mWaitFramStopTimeOut.
     1086   end.
     1087   procedure waitfram-hide :
     1088     if not session:batch-mode
     1089     then do
     1090     on error undo, return error return-value
     1091     :
     1092       pause 0 before-hide .
     1093       if not mBatchMode then
     1094         hide frame waitfram .
     1095     if     not mWaitFramView
     1096        and mWaitProcEvent
     1097     then
     1098       process events .
     1099     end.
     1100   end procedure.
     1101   procedure waitfram-show :
     1102     define input  parameter p-message as character no-undo .
     1103     define variable v-left-margin as integer   no-undo .
     1104     if not session:batch-mode
     1105     then do
     1106     on error undo, return error return-value
     1107     :
     1108       if length(p-message) <= 70 then do:
     1109         assign
     1110           v-left-margin = integer((70 - length(p-message)) / 2)
     1111         .
     1112         assign
     1113           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1114         .
     1115         assign
     1116           v-waitfram-action01 = " "
     1117           v-waitfram-action02 = " "
     1118                                    + fill(" ", v-left-margin)
     1119                                    + p-message
     1120           v-waitfram-action03 = " "
     1121         .
     1122       end.
     1123       else do:
     1124         define variable vRindex1 as integer no-undo.
     1125         define variable vRindex2 as integer no-undo.
     1126         vRindex1 = r-index(p-message," ",70).
     1127         if vRindex1 = 0
     1128         then
     1129            vRindex1 = 70.
     1130         if length(p-message)  <= vRindex1 + 70 then do:
     1131           assign
     1132             v-waitfram-action01 = " "
     1133             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1134             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1135           .
     1136         end.
     1137         else do:
     1138           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1139           if vRindex2 <= vRindex1
     1140           then
     1141              vRindex2 = vRindex1 + 70.
     1142           assign
     1143             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1144             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1145             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1146           .
     1147         end.
     1148       end.
     1149       B-viewProcInfo:visible   in frame waitfram = no.
     1150       B-viewProcInfo:sensitive in frame waitfram = no.
     1151       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1152       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1153       if  (   mWaitFramView
     1154          or  mWaitProcEvent)
     1155          and not mBatchMode
     1156       then
     1157          display
     1158             v-waitfram-action01 skip
     1159             v-waitfram-action02 skip
     1160             v-waitfram-action03 skip
     1161          with frame waitfram .
     1162       if     mWaitFramView
     1163          then do:
     1164             if     mWaitFramInterval ne ?
     1165                and not mBatchMode
     1166             then
     1167                wait-for go of frame waitfram pause mWaitFramInterval.
     1168          end.
     1169          else
     1170             if     mWaitProcEvent
     1171                and not mBatchMode
     1172             then
     1173                process events .
     1174     end.
     1175   end procedure.
     1176      procedure waitfram-show-this:
     1177         define input  parameter iInterval as int64 no-undo.
     1178         define variable vtime as int64 no-undo.
     1179         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1180         mWaitFramInterval = iInterval.
     1181         run waitfram-show (substitute("&1&2 &3&4" ,
     1182                                       mWaitFramTextBeg ,
     1183                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1184                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1185                                       mWaitFramTextEnd
     1186                                      )
     1187                           ).
     1188      end.
     1189      procedure WaitFramRunPause:
     1190         define input  parameter iInterval as dec no-undo.
     1191         define variable vStart  as datetime-tz no-undo.
     1192         define variable vend    as datetime-tz no-undo.
     1193         define variable vint as int64 no-undo.
     1194         define variable vOk as logical no-undo.
     1195         vStart = now.
     1196         vend   = vStart.
     1197         publish "WaitFramPause" (iInterval,output vOk).
     1198         vend   =  now.
     1199         vint = vend - vStart.
     1200         vint = iInterval - vint / 1000.
     1201         if     not mWaitFramStop
     1202            and (   vint > 0
     1203                 or (    not vOk
     1204                     and iInterval eq ?
     1205                     )
     1206                 )
     1207         then
     1208            run waitfram-show-this (iInterval).
     1209         vend   =  now.
     1210         vint = vend - vStart.
     1211         vint = iInterval - vint / 1000.
     1212         if     not mWaitFramStop
     1213            and vint > 0
     1214         then do:
     1215            run gbl/pause.p (vint * 1000).
     1216         end.
     1217         if iInterval ne ?
     1218         then
     1219            publish "WaitFramStop".
     1220         waitfram-check-timeout().
     1221      end.
     1222      procedure WaitFramWaitFor:
     1223         define input  parameter iInterval as dec no-undo.
     1224         assign
     1225            mWaitFramStartProc   = now
     1226            mWaitFramStopUser    = no
     1227            mWaitFramStopTimeOut = no
     1228         .
     1229         block-wait:
     1230         do while not mWaitFramStop:
     1231            run WaitFramRunPause (iInterval).
     1232            if  waitfram-check-timeout()
     1233            then do:
     1234               leave block-wait.
     1235            end.
     1236         end.
     1237         run waitfram-hide.
     1238      end.
     1239   procedure waitfram-join :
     1240     define input  parameter p-line-1  as character no-undo .
     1241     define input  parameter p-line-2  as character no-undo .
     1242     define input  parameter p-line-3  as character no-undo .
     1243     define output parameter p-message as character no-undo .
     1244     do
     1245     on error undo, return error return-value
     1246     :
     1247       assign
     1248         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1249                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1250                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1251       .
     1252     end.
     1253   end procedure.
     1254   function waitfram-join-function returns character
     1255     (input p-line-1 as character
     1256     ,input p-line-2 as character
     1257     ,input p-line-3 as character
     1258     ).
     1259     define variable v-message as character no-undo .
     1260     run waitfram-join in this-procedure
     1261       (input  p-line-1
     1262       ,input  p-line-2
     1263       ,input  p-line-3
     1264       ,output v-message
     1265       ) .
     1266     return v-message .
     1267   end function .
     1268   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1269   procedure cur-time :
     1270      define output parameter p-today as date      no-undo .
     1271      define output parameter p-time  as integer   no-undo .
     1272     do
     1273     on error undo, return error
     1274     :
     1275       define variable v-date1 as date      no-undo .
     1276       define variable v-date2 as date      no-undo .
     1277       define variable v-time  as integer   no-undo .
     1278       assign
     1279         v-date1 = today
     1280         v-time  = time
     1281         v-date2 = today
     1282       .
     1283       if v-date1 <> v-date2
     1284       then do:
     1285         assign
     1286           v-date1 = today
     1287           v-time  = v-time
     1288         .
     1289       end.
     1290       assign
     1291         p-today = v-date1
     1292         p-time  = v-time
     1293       .
     1294     end.
     1295   end.
     1296   function cur-time-date returns character
     1297   :
     1298     return string(today, '99/99/9999':U) .
     1299   end.
     1300   function cur-time-mjd returns decimal
     1301   :
     1302     define variable v-date as date      no-undo .
     1303     define variable v-time as integer   no-undo .
     1304     run cur-time in this-procedure
     1305       (output v-date
     1306       ,output v-time
     1307       ) .
     1308     return integer(v-date) - 2400002 + (v-time / 86400) .
     1309   end.
     1310   function cur-time-get-ending-index returns integer
     1311   (input p-number as integer
     1312   )
     1313   :
     1314     if p-number < 0
     1315     or p-number = ?
     1316     then do:
     1317       return 1 .
     1318     end.
     1319     define variable v-rest as integer   no-undo .
     1320     assign
     1321       p-number = p-number modulo 100
     1322     .
     1323     if p-number < 20
     1324     then do:
     1325       assign
     1326         v-rest = p-number
     1327       .
     1328     end.
     1329     else do:
     1330       assign
     1331         v-rest = p-number modulo 10
     1332       .
     1333     end.
     1334     case v-rest :
     1335       when 1
     1336       then do:
     1337         return 2 .
     1338       end.
     1339       when 2 or
     1340       when 3 or
     1341       when 4
     1342       then do:
     1343         return 3 .
     1344       end.
     1345       otherwise do:
     1346         return 1 .
     1347       end.
     1348     end case .
     1349   end.
     1350   procedure cur-time-mjd-to-date :
     1351      define input  parameter i-mjd-diff as decimal no-undo.
     1352      define output parameter o-Date     as date    no-undo.
     1353      define output parameter o-Time     as integer no-undo.
     1354      define variable v-day-number as integer   no-undo .
     1355      if    i-mjd-diff < 0
     1356         or i-mjd-diff = ?
     1357      then do:
     1358         return "?" .
     1359      end.
     1360      assign
     1361         v-day-number = truncate(i-mjd-diff,0).
     1362         o-Date = date(v-day-number + 2400002).
     1363         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1364     .
     1365   end.
     1366   function cur-time-mjd-to-string returns character
     1367   (input p-mjd-diff as decimal
     1368   )
     1369   :
     1370     define variable v-day-number as integer   no-undo .
     1371     define variable v-seconds    as integer   no-undo .
     1372     define variable v-hour       as integer   no-undo .
     1373     define variable v-min        as integer   no-undo .
     1374     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1375     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1376     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1377     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1378     if p-mjd-diff < 0
     1379     or p-mjd-diff = ?
     1380     then do:
     1381       return "?" .
     1382     end.
     1383     assign
     1384       v-day-number = integer(truncate(p-mjd-diff,0))
     1385       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1386     .
     1387     if v-seconds > 86400
     1388     then do:
     1389       assign
     1390         v-seconds = 86400 - 1
     1391       .
     1392     end.
     1393     if v-seconds < 0
     1394     then do:
     1395       assign
     1396         v-seconds = 0
     1397       .
     1398     end.
     1399     assign
     1400       v-hour = truncate(v-seconds / 3600, 0)
     1401     .
     1402     assign
     1403       v-seconds = v-seconds modulo 3600
     1404     .
     1405     assign
     1406       v-min = truncate(v-seconds / 60, 0)
     1407     .
     1408     assign
     1409       v-seconds = v-seconds modulo 60
     1410     .
     1411     return
     1412         (if v-day-number <> 0
     1413           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1414           else ""
     1415         )
     1416       + (if v-day-number <> 0 or v-hour <> 0
     1417           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1418           else ""
     1419         )
     1420       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1421           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1422           else ""
     1423         )
     1424       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1425       .
     1426   end.
     1427   function cur-time-string returns character
     1428   :
     1429     define variable v-date as date      no-undo .
     1430     define variable v-time as integer   no-undo .
     1431     run cur-time in this-procedure
     1432       (output v-date
     1433       ,output v-time
     1434       ) .
     1435     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1436   end.
     1437   function cur-time-string-sec returns character
     1438   :
     1439     define variable v-date as date      no-undo .
     1440     define variable v-time as integer   no-undo .
     1441     run cur-time in this-procedure
     1442       (output v-date
     1443       ,output v-time
     1444       ) .
     1445     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1446   end.
     1447   function cur-time-custom  returns character
     1448   (input p-prefix as character
     1449   ,input p-date-format as character
     1450   ,input p-delimiter as character
     1451   ,input p-time-format as character
     1452   ,input p-suffix as character
     1453   )
     1454   :
     1455     define variable v-date as date      no-undo .
     1456     define variable v-time as integer   no-undo .
     1457     run cur-time in this-procedure
     1458       (output v-date
     1459       ,output v-time
     1460       ) .
     1461     return
     1462       p-prefix
     1463       + string(v-date, p-date-format)
     1464       + p-delimiter
     1465       + string(v-time, p-time-format)
     1466       + p-suffix
     1467       .
     1468   end.
     1469   function cur-time-print  returns character
     1470   :
     1471     define variable v-date as date      no-undo .
     1472     define variable v-time as integer   no-undo .
     1473     run cur-time in this-procedure
     1474       (output v-date
     1475       ,output v-time
     1476       ) .
     1477     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1478   end.
     1479   function cur-time-datetime returns datetime
     1480   :
     1481     define variable v-char as character no-undo .
     1482     define variable v-datetime as datetime no-undo .
     1483     v-char = cur-time-string().
     1484     v-datetime = datetime(v-char).
     1485     return  v-datetime.
     1486   end.
     1487   function cur-time-string-msec returns character
     1488   :
     1489     define variable v-date as datetime  no-undo .
     1490     v-date = now.
     1491     return string(v-date) .
     1492   end.
     1493   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1494     define variable v-cntxt-db-num        as integer   no-undo .
     1495     define variable v-cntxt-userid        as character no-undo .
     1496     define variable v-cntxt-level         as character no-undo .
     1497     define variable v-cntxt-host-code-obj as integer   no-undo .
     1498     define variable v-cntxt-obj-type      as character no-undo .
     1499     define variable v-cntxt-obj-code      as integer   no-undo .
     1500     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1501     define variable v-cntxt-is-admin      as logical   no-undo .
     1502   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1503   define  stream PrnLibStream.
     1504   procedure prn-lib-prn-file :
     1505     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1506     define input parameter p-DIsabledoptions as integer no-undo .
     1507     define variable v-report-name as character no-undo .
     1508     define variable v-user-action as character no-undo .
     1509     define variable v-printed     as logical   no-undo .
     1510     define variable v-exist       as logical   no-undo .
     1511     do
     1512       on error undo, return error
     1513       :
     1514       run prn-lib-get-report-name  in this-procedure (
     1515         input parParentProc
     1516         ,output v-report-name
     1517         ).
     1518   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1519   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1520     (input  v-report-name
     1521     ,input  2
     1522     ,output v-exist
     1523     )  .
     1524       if NOT v-exist then
     1525       DO:
     1526         Message
     1527           "Нет заданий на печать ! "
     1528           view-as alert-box .
     1529         Return  .
     1530       End.
     1531       run gbl/prnfilen.w
     1532         (input  ""
     1533         ,input  p-DisabledOptions
     1534         ,input  string(v-report-name )
     1535         ,input  7
     1536         ,output v-user-action
     1537         ,output v-printed
     1538         ) .
     1539       if v-printed then
     1540       do:
     1541         return "YES" .
     1542       end.
     1543       else
     1544       do:
     1545         return "NO" .
     1546       end.
     1547     end.
     1548   end procedure.
     1549   procedure prn-lib-open-stream :
     1550     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1551     define input parameter p-page-size    as integer no-undo .
     1552     define input parameter p-is-stream    as logical no-undo .
     1553     define input parameter p-append       as logical no-undo .
     1554     define variable v-report-name as character no-undo .
     1555     do
     1556       on error undo, return error
     1557       :
     1558       run prn-lib-get-report-name  in this-procedure (
     1559         input parParentProc
     1560         ,output v-report-name
     1561         ).
     1562       if p-is-stream then
     1563       do:
     1564         if p-append then
     1565         do:
     1566           output stream PrnLibStream to value( v-report-name )
     1567             page-size value(p-page-size) append .
     1568         end.
     1569         if not p-append then
     1570         do:
     1571           output stream PrnLibStream to value( v-report-name )
     1572             page-size value(p-page-size) .
     1573         end.
     1574       end.
     1575       if not p-is-stream then
     1576       do:
     1577         if p-append then
     1578         do:
     1579           output to value( v-report-name )
     1580             page-size value(p-page-size) append .
     1581         end.
     1582         if not p-append then
     1583         do:
     1584           output to value( v-report-name )
     1585             page-size value(p-page-size) .
     1586         end.
     1587       end.
     1588     end.
     1589   end procedure.
     1590   procedure prn-lib-open-exp :
     1591     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1592     define input parameter p-is-stream    as logical no-undo .
     1593     define input parameter p-is-append    as logical no-undo .
     1594     define output parameter p-ReportFileName as char init "report" no-undo.
     1595     define output parameter p-process as logical no-undo .
     1596     define variable glog as logical no-undo .
     1597     do
     1598       on error undo, return error
     1599       :
     1600       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1601         TITLE      "Укажите путь"
     1602         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1603         ASK-OVERWRITE
     1604         CREATE-TEST-FILE
     1605         SAVE-AS
     1606         USE-FILENAME
     1607         DEFAULT-EXTENSION "txt"
     1608         UPDATE glog
     1609         .
     1610       if not glog then  return.
     1611       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1612       if p-is-stream then
     1613       do:
     1614         if p-is-append then
     1615         do:
     1616           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1617         end.
     1618         else
     1619         do:
     1620           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1621         end.
     1622       end.
     1623       else
     1624       do:
     1625         if p-is-append then
     1626         do:
     1627           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1628         end.
     1629         else
     1630         do:
     1631           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1632         end.
     1633       end.
     1634       p-process = yes.
     1635     end.
     1636   end procedure.
     1637   procedure prn-lib-get-report-name :
     1638     define input parameter parParentProc  as widget-handle no-undo.
     1639     define output parameter p-report-name as character no-undo .
     1640     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1641   end procedure.
     1642   procedure prn-lib-reportviewer-report-name :
     1643     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1644     define input parameter p-report-name-html as character no-undo .
     1645     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
