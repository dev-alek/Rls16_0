     1693   procedure userobjs_clear :
     1694     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1695     do
     1696     on error undo, return error return-value
     1697     :
     1698       for each buf_userobjs_temp-user-obj
     1699       on error undo, return error return-value
     1700       :
     1701         delete buf_userobjs_temp-user-obj .
     1702       end.
     1703     end.
     1704   end .
     1705   procedure userobjs_object-count :
     1706     define output parameter p-total-count as integer   no-undo .
     1707     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1708     do
     1709     on error undo, return error return-value
     1710     :
     1711       assign
     1712         p-total-count = 0
     1713       .
     1714       for each buf_userobjs_temp-user-obj
     1715       on error undo, return error return-value
     1716       :
     1717         assign
     1718           p-total-count = p-total-count + 1
     1719         .
     1720       end.
     1721     end.
     1722   end.
     1723   procedure userobjs_append :
     1724      define input  parameter p-obj-type as character no-undo .
     1725      define input  parameter p-obj-code as integer   no-undo .
     1726     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1727     do
     1728     on error undo, return error return-value
     1729     :
     1730       find first buf_userobjs_temp-user-obj
     1731         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1732           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1733         no-error .
     1734       if not available buf_userobjs_temp-user-obj
     1735       then do:
     1736         create buf_userobjs_temp-user-obj .
     1737         assign
     1738           buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1739           buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1740         .
     1741       end.
     1742     end.
     1743   end.
     1744   procedure userobjs_object-exist :
     1745     define output parameter p-object-exist as logical   no-undo .
     1746     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1747     do
     1748     on error undo, return error return-value
     1749     :
     1750       find first buf_userobjs_temp-user-obj
     1751         no-error .
     1752       if not available buf_userobjs_temp-user-obj
     1753       then do:
     1754         assign
     1755           p-object-exist = false
     1756         .
     1757       end.
     1758       else do:
     1759         assign
     1760           p-object-exist = true
     1761         .
     1762       end.
     1763     end.
     1764   end.
     1765   procedure userobjs_transfer :
     1766     define input  parameter p-callback-handle as handle no-undo .
     1767     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     1768     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1769     do
     1770     on error undo, return error return-value
     1771     :
     1772       if valid-handle(p-callback-handle) <> true
     1773       then do:
     1774         message
     1775           vss-workfile vss-revision vss-description skip
     1776           "Ошибка задания входных параметров" skip
     1777           "Неизвестный указатель на процедуру" skip
     1778           view-as alert-box error .
     1779         undo, return error return-value .
     1780       end.
     1781       if p-callback-handle :get-signature("userobjs_append") = ""
     1782       then do:
     1783         message
     1784           vss-workfile vss-revision vss-description skip
     1785           "Ошибка задания входных параметров" skip
     1786           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     1787                     ,p-callback-handle :file-name
     1788                     ) skip
     1789           view-as alert-box error .
     1790         undo, return error return-value .
     1791       end.
     1792       for each buf_userobjs_temp-user-obj
     1793       on error undo, return error return-value
     1794       :
     1795         run userobjs_append in p-callback-handle
     1796           (input  buf_userobjs_temp-user-obj.obj-type
     1797           ,input  buf_userobjs_temp-user-obj.obj-code
     1798           ) .
     1799       end.
     1800     end.
     1801   end procedure.
