    10543       if not glog then do:
    10544         return error.
    10545       end.
    10546   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10547   run userobjs_select-one in this-procedure
    10548     (input  parparentproc
    10549     ,input  v-cntxt-db-num
    10550     ,input  v-cntxt-userid
    10551     ,input  v-cntxt-host-code-obj
    10552     ,input  v-cntxt-obj-type
    10553     ,input  v-cntxt-obj-code
    10554     ,output v-user-select
    10555     ,output v-sel-obj-type
    10556     ,output v-sel-obj-code
    10557     )  .
    10558       if not v-user-select then do:
    10559         return error.
    10560       end.
    10561       assign
    10562       dsp-rs = substitute("ВСЕ товары с установленным атрибутом на объекте &1 &2", vlabel, stat-line(rs-status))
    10563       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code) + chr(3) + v-attr-code
    10564       .
    10565     end.
    10566     when "gds-obj-attr-val":U then do:
    10567       run gdsoattr-name  in this-procedure (
    10568                            input v-attr-code,
    10569                            output vtype,
    10570                            output vformat,
    10571                            output vlabel,
    10572                            output vuser-can-edit,
    10573                            output voutput-display,
    10574                            output vother).
    10575       do jj = 1 to num-entries(vother, chr(47)):
    10576         if entry(1, entry(jj, vother, chr(47)), "=":U) = "init":U then do:
    10577           assign
    10578           v-init = string(entry(2, entry(jj, vother, chr(47)), "=":U))
    10579           .
    10580         end.
    10581       end.
    10582       do jj = 1 to num-entries(vother, chr(47)):
    10583         if entry(1, entry(jj, vother, chr(47)), "=":U) = "spr":U then do:
    10584           assign
    10585           v-spr = entry(2, entry(jj, vother, chr(47)), "=":U)
