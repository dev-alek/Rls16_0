    11268   v-no-hist = 0.
    11269   run create-scn-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    11270                                       , input-output v-seq
    11271                                       , input 0
    11272                                       , input '':U
    11273                                       , input dsp-rs
    11274                                       , input tot-lns
