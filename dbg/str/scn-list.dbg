     4910           return .
     4911         end.
     4912       end.
     4913     end.
     4914     if p-change-value >= 0
     4915     then do:
     4916       assign
     4917         v-change-sign = 1
     4918       .
     4919     end.
     4920     else do:
     4921       assign
     4922         v-change-sign = -1
     4923       .
     4924     end.
     4925     assign
     4926       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4927     .
     4928     if p-change-value = 0
     4929     then do:
