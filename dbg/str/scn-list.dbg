    10589           assign
    10590           v-spr-param = entry(2, entry(jj, vother, chr(47)), "=":U)
    10591           .
    10592         end.
    10593       end.
    10594   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10595   run userobjs_select-one in this-procedure
    10596     (input  parparentproc
    10597     ,input  v-cntxt-db-num
    10598     ,input  v-cntxt-userid
    10599     ,input  v-cntxt-host-code-obj
    10600     ,input  v-cntxt-obj-type
    10601     ,input  v-cntxt-obj-code
    10602     ,output v-user-select
    10603     ,output v-sel-obj-type
    10604     ,output v-sel-obj-code
    10605     )  .
    10606       if not v-user-select then do:
    10607         return error.
    10608       end.
    10609       if  v-init <> "":U then do:
    10610           run  value(v-init)
    10611                       in this-procedure (
    10612                                            input 0
    10613                                          , input v-sel-obj-type
    10614                                          , input v-sel-obj-code
    10615                                          , output vvalue) no-error .
    10616             if error-status:error then do:
    10617                 assign
    10618                 vvalue = "":U
    10619                 .
    10620             end.
    10621       end.
    10622       CASE vtype:
    10623         when 'L':U then do:
    10624           assign
    10625           vvalue = "yes":U
    10626           .
    10627         end.
    10628         when 'I':U or when 'D':U then do:
    10629           assign
    10630           vvalue = if v-init <> "":U
    10631                         then vvalue
    10632                         else string(0)
    10633           .
    10634         end.
    10635         when 'T':U then do:
    10636           assign
    10637           vvalue = ?
    10638           .
    10639         end.
    10640         when 'C':U then do:
    10641           assign
    10642           vvalue = if v-init <> "":U
    10643                         then vvalue
    10644                         else "":U
    10645           .
    10646         end.
    10647       END CASE.
    10648       if v-spr = "":U then do:
    10649         run gbl/d-prompt.w (
    10650           'title=':u + "Значение атрибута товара на объекте" + '\':u
    10651         + 'text1=':u + vlabel + '\':u
    10652         + 'format=' + (if vtype = 'L':U then "yes/no" else vformat) + '\':u
    10653         + 'type=' + vtype + '\':u
    10654         + 'fillin_row=2\':u
    10655         + 'fillin_col=4\':u
    10656         + 'fillin_width=20\':u
    10657         + 'fillin_height=1\':u
    10658         + 'max-chars=70\':u
    10659         + 'readonly=no\':u
    10660         , input-output vvalue
    10661         ).
    10662         if return-value = 'false':U then do:
    10663           return error.
    10664         end.
    10665       end.
    10666       else do:
    10667         if v-spr-param = "":U then do:
    10668           run  value(v-spr)
    10669                         in this-procedure (
    10670                                           input 0
    10671                                           ,input v-sel-obj-type
    10672                                           ,input v-sel-obj-code
    10673                                           ,input-output vvalue
    10674                                           ,output v-setted) no-error .
    10675         end.
    10676         else do:
    10677           run  value(v-spr)
    10678                         in this-procedure (
    10679                                           input 0
    10680                                           ,input v-sel-obj-type
    10681                                           ,input v-sel-obj-code
    10682                                           ,input v-spr-param
    10683                                           ,input-output vvalue
    10684                                           ,output v-setted) no-error .
    10685         end.
    10686         if not v-setted then do:
    10687           return error.
    10688         end.
    10689       end.
    10690       message
    10691       ("Все товары с атрибутом товара на объекте" + chr(32) + vlabel + " = ":U + vvalue) skip
    10692       stat-line(rs-status)
    10693       view-as alert-box question buttons OK-Cancel update glog.
    10694       if not glog then do:
    10695         return error.
