     3626   .
     3627   DEFINE QUERY br-list FOR scn-list SCROLLING.
     3628   DEFINE BROWSE br-list QUERY br-list NO-LOCK DISPLAY
     3629         scn-list.to-sel  format "+/" column-label "*"
     3630         scn-list.gds-code FORMAT "99999999999":U
     3631         scn-list.artic
     3632         scn-list.gds-name format "x(25)"
     3633         scn-list.qnty column-label "Количество" format "->>>,>>9.999"
     3634         scn-list.unit-base column-label "Изм" format "x(3)"
     3635         (if scn-list.stts = 0 then no else yes) column-label "-" format "-/ "
     3636         scn-list.grp-name
     3637         (scn-list.prod-type + " " + string (scn-list.prod-code, ">>>>>>>>>9") ) column-label "Производитель" format "x(9)"
     3638         enable scn-list.qnty
     3639         WITH SIZE 74 BY 16 separators.
     3640   DEFINE FRAME Dialog-Frame
     3641       dsp-rs  AT ROW 1 COL 1 NO-LABEL
     3642       b-help  AT ROW 1 COL 61
     3643       br-option AT ROW 2 COL 75
     3644       b-exit  AT ROW 2 COL 1
     3645       b-save  AT ROW 2 COL 11
     3646       b-print AT ROW 2 COL 21
     3647       b-arch  AT ROW 2 COL 31
     3648       b-hist  AT ROW 2 COL 41
     3649       b-lkp   AT ROW 2 COL 51
     3650       b-clr   AT ROW 2 COL 61
     3651       b-mark  AT ROW 3 COL 1
     3652       b-sel   AT ROW 3 COL 4
     3653       a-n-c   at row 3 col 2 no-label
     3654       b-add   AT ROW 3 COL 16
     3655       b-del   AT ROW 3 COL 31
     3656       b-rest  AT ROW 3 COL 46
     3657       b-ext   AT ROW 3 COL 61
     3658       v-obj-type at row 4 col 2 No-LABEL
     3659       v-obj-code at row 4 col 6 No-LABEL
     3660       b-obj at row 4 col 12
     3661       v-obj-name at row 4 col 15 No-LABEL
     3662       loc-art  AT ROW 4 COL 50 COLON-ALIGNED label "Начало артикула"
     3663       loc-name AT ROW 4 COL 50 COLON-ALIGNED label "Начало названия" format "x(40)"
     3664       loc-code AT ROW 4 COL 50 COLON-ALIGNED label "Бар-код (весь)" format "x(13)"
     3665       b-macro AT ROW 4 col 68
     3666       b-record AT ROW 4 col 71
     3667       b-stop   AT ROW 4 col 71
     3668       b-clear-macro AT ROW 4 col 71
     3669       RS-status at row 5 col 2 no-label
     3670       f-tot-lns AT ROW 5.25 col 65 no-label
     3671       br-list  AT ROW 6 COL 1
     3672       ub.clients.obj-name  at row 22 col 6 colon-aligned label "Пр-ль" fgcolor 4
     3673       ub.gds-prt.node-name at row 22 col 40 colon-aligned label "Шкала" fgcolor 4
     3674       ub.bar-code.b-code   at row 22 col 60 colon-aligned label "Код" format "9999999999" fgcolor 4
     3675       SPACE(0) SKIP(0)
     3676       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3677           SIDE-LABELS NO-UNDERLINE THREE-D SCROLLABLE
     3678           TITLE "СПИСОК  ТОВАРОВ":L
     3679           DEFAULT-BUTTON b-exit.
     3680   ASSIGN
     3681     b-save:POPUP-MENU IN FRAME Dialog-Frame = MENU m-save:HANDLE
     3682     b-macro:POPUP-MENU IN FRAME Dialog-Frame = MENU m-play:HANDLE
     3683     FRAME Dialog-Frame:SCROLLABLE = FALSE
     3684     b-save:MENU-MOUSE = 1
     3685     b-macro:menu-mouse = 1
     3686     .
