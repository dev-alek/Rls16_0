    11239       v-message = substitute("Все топлива&1&2", chr(10), stat-line(rs-status))
    11240       .
    11241     end.
    11242     when "gds-office":U then do:
    11243       assign
    11244       v-message = substitute("Все услуги&1&2", chr(10), stat-line(rs-status))
    11245       .
    11246     end.
