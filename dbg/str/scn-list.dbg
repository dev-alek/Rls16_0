     5983   END PROCEDURE.
     5984   procedure proc-b-macro :
     5985   define input parameter p-option as character no-undo .
     5986   define variable glog as logical no-undo .
     5987   define variable v-id as integer no-undo .
     5988   define variable v-result as character no-undo .
     5989   define variable v-des as character no-undo .
     5990   define variable v-hist-mode as character no-undo .
     5991   define variable v-file as logical no-undo .
     5992   define variable v-full-path        as character no-undo .
     5993   define variable v-path             as character no-undo .
     5994   define variable v-file-name        as character no-undo .
     5995   define variable v-file-name-no-ext as character no-undo .
     5996   define variable v-file-name-ext    as character no-undo .
     5997   define variable v-rid-list as character no-undo .
     5998   define variable v-ok as logical no-undo .
     5999   define buffer buf_scn-list-hist for scn-list-hist.
     6000   define buffer buf_clob-bind for ub.clob-bind.
     6001   define buffer buf_clob-data for ub.clob-data.
     6002   do
     6003   on error undo, return error
     6004   :
     6005     if v-macro-is-running then do:
     6006     end.
     6007     else do:
     6008       glog = yes.
     6009       if an-listp-start-macro-id >= 1 then do:
     6010         case p-option:
     6011           when "file" then do:
     6012         message
     6013         "Согласно командам формирования списка из записанного макроса"
     6014         view-as alert-box question buttons OK-Cancel update glog.
     6015           end.
     6016           when "lob" then do:
     6017             message
     6018             "Нелья!"
     6019             view-as alert-box question buttons OK-Cancel update glog.
     6020             run ui-on in this-procedure .
     6021             return error.
     6022           end.
     6023         end case.
     6024         if not glog then do:
     6025           run ui-on in this-procedure .
     6026           return error.
     6027         end.
     6028         if an-listp-end-macro-id = ? then do:
     6029           assign
     6030           an-listp-end-macro-id  = v-seq.
     6031           for each macro-list-hist:
     6032             delete macro-list-hist.
     6033           end.
     6034           for each buf_scn-list-hist where
     6035                   buf_scn-list-hist.id >=  an-listp-start-macro-id
     6036             and  buf_scn-list-hist.id <=  an-listp-end-macro-id:
     6037             create macro-list-hist.
     6038             buffer-copy buf_scn-list-hist
     6039             except id num-recs num-add num-ignored
     6040             to macro-list-hist
     6041             assign
     6042             macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6043             v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6044             macro-list-hist.done = no
     6045             .
     6046           end.
     6047         end.
     6048         else do:
     6049           find last macro-list-hist no-error.
     6050           if available macro-list-hist then do:
     6051             v-id = macro-list-hist.id.
     6052           end.
     6053         end.
     6054       end.
     6055       else do:
     6056         case p-option:
     6057           when "file" then do:
     6058         message
     6059         "Согласно командам формирования списка из ранее сохраненного в файле макроса"
     6060         view-as alert-box question buttons OK-Cancel update glog.
     6061         if not glog then do:
     6062           run ui-on in this-procedure .
     6063           return error.
     6064         end.
     6065         system-dialog get-file f-name
     6066           filters "Макрос формирования списка *.gdm" "*.gdm"
     6067           title "Выберите файл макроса"
     6068           INITIAL-DIR "."
     6069           return-to-start-dir
     6070           must-exist
     6071           update glog
     6072           default-extension "gdm".
     6073         if not glog then do:
     6074           run ui-on in this-procedure .
     6075           return error.
     6076         end.
     6077           end.
     6078           when "lob" then do:
     6079             message
     6080             "Согласно командам формирования списка из макроса, сохраненного в БД"
     6081             view-as alert-box question buttons OK-Cancel update glog.
     6082             if not glog then do:
     6083               run ui-on in this-procedure .
     6084               return error.
     6085             end.
     6086             run ref/clobbnds.w ( input parparentproc
     6087                                 ,input this-procedure:handle
     6088                                 ,input 'b-sel'
     6089                                 ,input "uniq-key-rec"
     6090                                 ,input ""
     6091                                 ,input 'list-macro':U
     6092                                 ,input 'gds-list'
     6093                                 ,input -1
     6094                                 ,input-output v-rid-list) no-error.
     6095             if v-rid-list = '' then do:
     6096               run ui-on in this-procedure.
     6097               return error.
     6098             end.
     6099             find first buf_clob-bind no-lock where
     6100                       recid(buf_clob-bind) = integer(v-rid-list) no-error.
     6101             if not available buf_clob-bind then do:
     6102               message
     6103               "Не найдена ссылка на макрос, сохраненный в БД!"
     6104               view-as alert-box error .
     6105               run ui-on in this-procedure .
     6106               return error.
     6107             end.
     6108             find first buf_clob-data no-lock where
     6109                       buf_clob-data.db-num = buf_clob-bind.db-num
     6110                   and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     6111             if not available buf_clob-data then do:
     6112               message
     6113               "Не найдена ссылка на макрос, сохраненный в БД!"
     6114               view-as alert-box error .
     6115               run ui-on in this-procedure .
     6116               return error.
     6117             end.
     6118             if buf_clob-data.db-num <> v-cntxt-db-num then do:
     6119               message
     6120               substitute("Возможно, не все действия пользователя БД &1 удастся воспроизвести!&2Продолжить?"
     6121                         , buf_clob-data.db-num
     6122                         , chr(10))
     6123              view-as alert-box question buttons yes-no update v-ok.
     6124              if not v-ok then do:
     6125                 run ui-on in this-procedure .
     6126                 return error.
     6127              end.
     6128             end.
     6129             run gbl/_tmpfile.p ( input ""
     6130                           ,input "tmp"
     6131                           ,output v-file-name) .
     6132             copy-lob from object buf_clob-data.cdata
     6133             to file f-name.
     6134             run gbl/filename.p
     6135               (input  v-file-name
     6136               ,output f-name
     6137               ,output v-path
     6138               ,output v-file-name
     6139               ,output v-file-name-no-ext
     6140               ,output v-file-name-ext
     6141               ) no-error .
     6142             if error-status:error then do:
     6143             end.
     6144           end.
     6145         end case.
     6146         for each macro-list-hist:
     6147           delete macro-list-hist.
     6148         end.
     6149         input stream sout from value (f-name).
     6150         _macro:
     6151         repeat:
     6152           create macro-list-hist.
     6153           import stream sout macro-list-hist no-error.
     6154           if error-status:error then do:
     6155               undo _macro, next _macro.
     6156           end.
     6157           assign
     6158           macro-list-hist.num-rec = 0
     6159           macro-list-hist.num-add = 0
     6160           macro-list-hist.num-ignored = 0
     6161           v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6162           macro-list-hist.done = no
     6163           .
     6164         end.
     6165         find first macro-list-hist where
     6166                 macro-list-hist.id = 0.
     6167         delete macro-list-hist.
     6168         input stream sout close.
     6169         If p-option = "lob" then do:
     6170          os-delete value(f-name).
     6171         end.
     6172         v-file = yes.
     6173       end.
     6174       an-listp-macros-label-id = v-seq.
     6175       run create-scn-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     6176                                           , input-output v-seq
     6177                                           , input 0
     6178                                           , input '>':U
     6179                                           , input (if v-file
     6180                                                   then substitute("Файл макроса : &1", f-name)
     6181                                                   else substitute("Записанный макрос")
     6182                                                   )
     6183                                           , input tot-lns
     6184                                           , input 'macro':U
     6185                                           , input '':U
     6186                                           , input (if v-file then f-name else '':U)
     6187                                           , input '':U
     6188                                           , input ?
     6189                                           ).
     6190     end.
     6191     disable
     6192     b-record
     6193     b-macro
     6194     with frame Dialog-Frame .
     6195     hide
     6196     b-record in frame Dialog-Frame .
     6197     enable
     6198     b-clear-macro with frame Dialog-Frame .
     6199     v-macro-is-running = yes.
     6200     run str/listmcro.w (input parparentproc
     6201                   ,input this-procedure:handle
     6202                   ,input "Макрос формирования списка товаров" + chr(4) + "gdm"
     6203                   ,input "b-play,b-step"
     6204                   ,input-output v-current-step
     6205                   ,input v-id
     6206                   ,output v-result) no-error .
     6207     if error-status:error
     6208     or v-result = "b-stop"
     6209     or v-result = 'end':U
     6210     then do:
     6211       for each macro-list-hist:
     6212         delete macro-list-hist.
     6213       end.
     6214       assign
     6215       an-listp-start-macro-id = ?
     6216       an-listp-end-macro-id = ?
     6217       an-listp-macros-label-id = 0
     6218       .
     6219       menu-item m-macro-file:label in menu m-play = "Сохраненный в файле макрос формирования списка товаров".
     6220       menu-item m-macro-lob:sensitive in menu m-play = yes.
     6221       if v-result = 'b-stop' then do:
     6222         assign
     6223         v-hist-mode = '[]':U
     6224         v-des = "Выполнение макроса прекращено пользователем"
     6225         .
     6226         hide
     6227         b-clear-macro
     6228         b-stop
     6229         in frame Dialog-Frame .
     6230         enable
     6231         b-record
     6232         with frame Dialog-Frame .
     6233       end.
     6234       if v-result = 'end' then do:
     6235         assign
     6236         v-hist-mode = '<':U
     6237         v-des = "Выполнение макроса завершено"
     6238         .
     6239         hide
     6240         b-clear-macro
     6241         b-stop
     6242         in frame Dialog-Frame .
     6243         enable
     6244         b-record
     6245         with frame Dialog-Frame .
     6246       end.
     6247       if error-status:error then do:
     6248         assign
     6249         v-hist-mode = 'E':U
     6250         v-des = "Выполнение макроса прекращено из-за ошибки"
     6251         .
     6252       end.
     6253       run create-scn-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     6254                                           , input-output v-seq
     6255                                           , input 0
     6256                                           , input v-hist-mode
     6257                                           , input v-des
     6258                                           , input tot-lns
     6259                                           , input 'macro':U
     6260                                           , input '':U
     6261                                           , input f-name
     6262                                           , input '':U
     6263                                           , input ?
     6264                                           ) no-error .
     6265       assign
     6266       v-macro-is-running = no
     6267       v-current-step = 0
     6268       .
     6269     end.
     6270     enable
     6271     b-macro
     6272     with frame Dialog-Frame .
     6273   end.
     6274   end procedure.
     6275   procedure proc-create-macro-list-hist :
     6276   define input parameter p-list-table as character no-undo .
     6277   define input parameter p-id as integer           no-undo .
     6278   define input parameter p-line as integer         no-undo .
     6279   define input parameter p-hist-mode as character  no-undo .
     6280   define input parameter p-des as character        no-undo .
     6281   define input parameter p-option_ as character    no-undo .
     6282   define input parameter p-item_ as character      no-undo .
     6283   define input parameter p-status_ as character    no-undo .
     6284   define buffer buf_macro-list-hist for macro-list-hist.
     6285   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     6286     do
     6287     on error undo, return error return-value
     6288     :
     6289       create buf_macro-list-hist.
     6290       assign
     6291       buf_macro-list-hist.list-table = p-list-table
     6292       buf_macro-list-hist.id         = p-id
     6293       buf_macro-list-hist.line       = p-line
     6294       buf_macro-list-hist.hist-mode  = p-hist-mode
     6295       buf_macro-list-hist.des        = p-des
     6296       buf_macro-list-hist.option_    = p-option_
     6297       buf_macro-list-hist.item_      = p-item_
     6298       buf_macro-list-hist.status_    = p-status_
     6299       .
     6300       if p-keep-query then do:
     6301         create buf_keep-macro-list-hist.
     6302         buffer-copy buf_macro-list-hist to buf_keep-macro-list-hist.
     6303       end.
     6304     end.
     6305   end procedure.
     6306   procedure proc-macro-play :
     6307   define input parameter p-id as integer no-undo .
     6308   define input parameter p-step as logical no-undo .
     6309   define input parameter p-max-id as integer no-undo .
     6310   define variable v-id as integer no-undo .
     6311   define variable v-rowid   as rowid no-undo .
     6312   define variable v-tbl-name as character no-undo .
     6313   define variable v-old-seq as integer no-undo .
     6314   define variable v-current-id as integer no-undo .
     6315   define variable v-temp-seq as integer no-undo .
     6316   define variable v-rs-do-error as logical no-undo .
     6317   define  buffer buf_macro-list-hist for macro-list-hist.
     6318   define  buffer buf_scn-list-hist for scn-list-hist.
     6319   do
     6320   on error undo, return error return-value
     6321   :
     6322     for each macro-list-hist where (p-id = 0 or macro-list-hist.id = p-id):
     6323       assign
     6324       v-current-id = v-current-id + 1
     6325       v-id = macro-list-hist.id.
     6326       CASE entry(1, macro-list-hist.option_, chr(4)):
     6327         when 'macro':U
     6328         or
     6329         when 'title':U
     6330         or
     6331         when 'start':U
     6332         then do:
     6333         end.
     6334         when 'clear':U then do:
     6335           for each scn-list:
     6336             delete scn-list.
     6337           end.
     6338           for each scn-list-hist where scn-list-hist.id > an-listp-macros-label-id:
     6339             delete scn-list-hist.
     6340           end.
     6341           tot-lns = 0.
     6342           v-seq = an-listp-macros-label-id + 1.
     6343           v-no-hist = 0.
     6344           create buf_scn-list-hist.
     6345           buffer-copy macro-list-hist
     6346           to buf_scn-list-hist
     6347           assign buf_scn-list-hist.id = v-seq
     6348           v-temp-seq = v-seq
     6349           v-seq = v-seq + 1
     6350           v-no-hist = v-no-hist + 1
     6351           .
     6352           run ui-on in this-procedure .
     6353         end.
     6354         when 'single' then do:
     6355            run gen-row-keyr  in this-procedure (  input  macro-list-hist.item_
     6356                                                 ,input ?
     6357                                                 ,input 'ub'
     6358                                                 ,input ?
     6359                                                 ,input no-lock
     6360                                                 ,output v-rowid
     6361                                                 ,output v-tbl-name) no-error .
     6362           if not error-status:error then do:
     6363             CASE macro-list-hist.hist-mode:
     6364               when '+':U then do:
     6365                 run proc-b-add in this-procedure(input yes
     6366                                                 ,input v-rowid
     6367                                                 ,input macro-list-hist.option_
     6368                                                 ,input macro-list-hist.status_) no-error .
     6369               end.
     6370               when '-':U then do:
     6371                 run proc-b-del in this-procedure(input yes
     6372                                                 ,input v-rowid
     6373                                                 ,input macro-list-hist.option_
     6374                                                 ,input macro-list-hist.status_) no-error .
     6375               end.
     6376               when '*':U then do:
     6377                 run proc-b-rest in this-procedure(input yes
     6378                                                  ,input v-rowid
     6379                                                  ,input macro-list-hist.option_
     6380                                                  ,input macro-list-hist.status_) no-error .
     6381               end.
     6382             END.
     6383             if error-status:error then do:
     6384                 return ("error" + chr(4) + return-value) .
     6385             end.
     6386             find first  buf_scn-list-hist where
     6387                     buf_scn-list-hist.id = v-seq - 1 no-error .
     6388             if available buf_scn-list-hist then
     6389             assign
     6390             macro-list-hist.num-recs = buf_scn-list-hist.num-recs
     6391             macro-list-hist.num-add = buf_scn-list-hist.num-add
     6392             macro-list-hist.num-ignored = buf_scn-list-hist.num-ignored
     6393             .
     6394           end.
     6395           else do:
     6396             return ("error" + chr(4) + return-value).
     6397           end.
     6398         end.
     6399         otherwise do:
     6400           if can-find(first temp-list where temp-list.fvalue = macro-list-hist.option_)
     6401           or lookup(macro-list-hist.option_, '':U) > 0
     6402           then do:
     6403             if macro-list-hist.line = 0 then do:
     6404               v-no-hist = 0.
     6405               for each buf_macro-list-hist where
     6406                       buf_macro-list-hist.id = v-id:
     6407                 create buf_scn-list-hist.
     6408                 buffer-copy buf_macro-list-hist
     6409                 except id  num-recs num-add num-ignored done
     6410                 to buf_scn-list-hist
     6411                 assign
     6412                 buf_scn-list-hist.id = (if buf_macro-list-hist.line =0 then v-seq else v-temp-seq)
     6413                 v-temp-seq = (if buf_macro-list-hist.line = 0 then v-seq else v-temp-seq )
     6414                 v-seq = (if buf_macro-list-hist.line = 0
     6415                         then (v-seq + 1)
     6416                         else v-seq)
     6417                 v-no-hist = v-no-hist + 1
     6418                 .
     6419               end.
     6420               if v-no-hist = 1 then v-no-hist = 0.
     6421               run rs-do in this-procedure (input yes
     6422                                         , input p-step
     6423                                         , input macro-list-hist.option_
     6424                                         , input macro-list-hist.status_
     6425                                         , input get-line-mode(macro-list-hist.hist-mode)
     6426                                         , input v-temp-seq
     6427                                         ) no-error .
     6428               if error-status:error then do:
     6429                 assign
     6430                 v-rs-do-error = yes.
     6431               end.
     6432               if get-line-mode(macro-list-hist.hist-mode) = 'ОСТАВИТЬ':U then do:
     6433                 run proc-b-rest-2 in this-procedure .
     6434                 run ui-on in this-procedure .
     6435               end.
     6436               for each buf_scn-list-hist where
     6437                       buf_scn-list-hist.id = v-temp-seq,
     6438                  first buf_macro-list-hist where
     6439                       buf_macro-list-hist.id = v-id
     6440                   AND buf_macro-list-hist.line = buf_scn-list-hist.line:
     6441                  assign
     6442                  buf_macro-list-hist.num-recs = buf_scn-list-hist.num-recs
     6443                  buf_macro-list-hist.num-add = buf_scn-list-hist.num-add
     6444                  buf_macro-list-hist.num-ignored = buf_scn-list-hist.num-ignored
     6445                  .
     6446               end.
     6447               if v-rs-do-error then do:
     6448                 run ui-on in this-procedure .
     6449                 return ("error" + chr(4) + return-value).
     6450               end.
     6451               v-id = macro-list-hist.id.
     6452             end.
     6453           end.
     6454         end.
     6455       END CASE.
     6456     end.
     6457   end.
     6458   end procedure.
     6459   procedure proc-b-rest-2 :
     6460     do
     6461     on error undo, return error
     6462     :
     6463       for each scn-list:
     6464         if scn-list.to-del = ? then do:
     6465           assign
     6466           scn-list.to-del = no
     6467           .
     6468         end.
     6469         else do:
     6470           delete scn-list.
     6471         end.
     6472       end.
     6473       tot-lns = lns-cnt.
     6474     end.
     6475   end procedure.
     6476   PROCEDURE proc-expand :
     6477   define input parameter p-shift as integer no-undo .
     6478   define input parameter p-from as integer no-undo .
     6479   define input parameter p-to as integer no-undo .
     6480   define input parameter p-forcer-name as character no-undo .
     6481   define variable fh as widget-handle no-undo .
     6482   define variable hh as widget-handle no-undo .
     6483   define variable lh as widget-handle no-undo .
     6484   define variable ii as INTEGER no-undo .
     6485   ASSIGN
     6486   fh = frame Dialog-Frame:first-child
     6487   hh = fh:first-child
     6488   .
     6489   CASE v-expand:
     6490     WHEN YES THEN DO:
     6491       ASSIGN
     6492       v-expand = NO.
     6493       DO ii = 1 TO NUM-ENTRIES(v-downed):
     6494         ASSIGN
     6495         hh              = WIDGET-HANDLE(ENTRY(ii, v-downed))
     6496         hh:ROW          = (hh:ROW - p-shift).
     6497         hh:height-chars = (if hh:type = "browse" then (hh:height-chars + p-shift) else hh:height-chars).
     6498       END.
     6499     END.
     6500     WHEN NO THEN DO:
     6501       v-expand = YES.
     6502       v-downed = ''.
     6503       _do:
     6504       do while valid-handle(hh):
     6505         IF lookup(hh:type, "radio-set,browse,button,fill-in,literal,text,rectangle") > 0
     6506          AND hh:ROW >= p-from
     6507          AND hh:ROW <= p-to
     6508          and lookup(hh:name, p-forcer-name) = 0
     6509          THEN DO:
     6510           hh:height-chars = (if hh:type = "browse" then (hh:height-chars - p-shift) else hh:height-chars).
     6511           hh:ROW          = (hh:ROW + p-shift).
     6512           ASSIGN
     6513           v-downed = v-downed + chr(44) + STRING(hh).
     6514           IF hh:TYPE = "fill-in"
     6515           AND valid-handle(hh:side-label-handle) THEN dO:
     6516             assign
     6517             lh = hh:SIDE-LABEL-HANDLE
     6518             lh:ROW = lh:ROW + p-shift
     6519             v-downed = v-downed + chr(44) + STRING(lh)
     6520             .
     6521            END.
     6522          END.
     6523          hh = hh:next-sibling.
     6524       END.
     6525       v-downed = trim(v-downed, chr(44)).
     6526     END.
     6527   END CASE.
     6528   END PROCEDURE.
     6529   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     6530   DO:
     6531   define variable glog as logical no-undo .
     6532   define buffer buf_scn-list for scn-list.
     6533   if available scn-list then   do:
     6534     find first buf_scn-list where
     6535              recid(buf_scn-list) = recid(scn-list).
     6536     assign
     6537     buf_scn-list.to-sel = not (buf_scn-list.to-sel).
     6538     glog = br-list:refresh().
     6539     if LOOKUP(last-event:function,  "MOUSE-SELECT-DBLCLICK,RETURN":U) = 0  then  do:
     6540        glog = br-list:select-next-row ().
     6541        APPLY "VALUE-CHANGED" to br-list.
     6542     end.
     6543   end.
     6544   APPLY "ENTRY" to br-list in frame Dialog-Frame .
     6545   END.
     6546   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     6547   DO:
     6548   define buffer buf_scn-list for scn-list.
     6549   if not available scn-list then return no-apply.
     6550   find first buf_scn-list where
     6551             recid(buf_scn-list) = recid(scn-list).
     6552   assign
     6553   buf_scn-list.to-sel = not (buf_scn-list.to-sel)
     6554   .
     6555   APPLY "CHOOSE" to b-exit.
     6556   END.
     6557   if lookup(bttns, "hide") = 0 then do:
     6558     run diasize_add_browse in this-procedure
     6559       (input  'height':u
     6560       ,input  browse BR-option :handle
     6561       ) .
     6562     run diasize_init in this-procedure .
     6563   end.
     6564   define variable v-ok as logical   no-undo .
     6565   assign
     6566     v-ok = br-list :set-repositioned-row(5, 'conditional':u)
     6567   .
     6568   ON WINDOW-CLOSE OF FRAME Dialog-Frame APPLY "END-ERROR":U TO SELF.
     6569   MAIN-BLOCK:
     6570   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     6571     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     6572   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6573   define variable varscales-pref-type42 as character no-undo.
     6574   varscales-pref  = ?.
     6575   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     6576     (input  'sclspref':u
     6577     ,input  '':u
     6578     ,input  '':u
     6579     ,input  0
     6580     ,input  '':u
     6581     ,input  '':u
     6582     ,input  '':u
     6583     ,input  no
     6584     ,output varscales-pref
     6585     ,output varscales-pref-type42
     6586     ) no-error .
     6587   if varscales-pref = ? then do:
     6588     assign
     6589     varscales-pref = '21,23,25':U.
     6590   end.
     6591   define variable varpgscales-pref-type42 as character no-undo.
     6592   varpgscales-pref  = ?.
