     3294   define variable vss-include-info21 as character format "X(65)" no-undo
     3295   initial "@(#)$Workfile$ $Revision$".
     3296   procedure grplib-get-full-name :
     3297      define input parameter p-node-code  as integer      no-undo.
     3298      define output parameter p-full-name as character    no-undo.
     3299      do
     3300   on error undo, return error
     3301   :
     3302       define variable v-upper-code    as integer           no-undo.
     3303       define buffer buf_gds-grp       for ub.gds-grp.
     3304       define buffer buf_upper_gds-grp for ub.gds-grp.
     3305       find first buf_gds-grp no-lock
     3306            where buf_gds-grp.node-code = p-node-code
     3307       no-error.
     3308       if not available buf_gds-grp
     3309       then do:
     3310           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     3311       end.
     3312       assign
     3313           p-full-name  = ""
     3314           v-upper-code = 1
     3315       .
     3316       do while buf_gds-grp.upper-code <> 0
     3317       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     3318       :
     3319           assign
     3320               p-full-name  = buf_gds-grp.node-name
     3321                            + (if p-full-name <> "" then chr(47) else "")
     3322                            + p-full-name
     3323               v-upper-code = buf_gds-grp.upper-code
     3324           .
     3325           find first buf_gds-grp no-lock
     3326                where buf_gds-grp.node-code = v-upper-code
     3327           no-error.
     3328           if not available buf_gds-grp
     3329           then do:
     3330               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     3331                                   + string( v-upper-code )
     3332                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     3333           end.
     3334       end.
     3335       assign
     3336       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     3337       .
     3338   end.
     3339   end .
     3340   procedure grplib-get-node-from-full-name :
     3341   define input parameter p-full-name as character no-undo .
     3342   define output parameter p-node-code as integer no-undo .
     3343   define variable v-ii as integer no-undo .
     3344   define variable v-upper-code as integer no-undo .
     3345   define variable v-root-code as integer no-undo .
     3346   define variable v-entry as character no-undo .
     3347   define buffer buf_gds-grp       for ub.gds-grp.
     3348   do
     3349   on error undo, return error
     3350   :
     3351     find first buf_gds-grp no-lock
     3352         where buf_gds-grp.upper-code = 0
     3353     no-error .
     3354     if not available buf_gds-grp
     3355     then do:
     3356         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     3357     end.
     3358     else do:
     3359       assign
     3360       v-root-code = buf_gds-grp.node-code
     3361       .
     3362     end.
     3363     v-upper-code = v-root-code.
     3364     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     3365       assign
     3366       v-entry = entry(v-ii, p-full-name, chr(47)).
     3367       if v-entry = '' then leave.
     3368       find first buf_gds-grp no-lock where
     3369                 buf_gds-grp.node-name = v-entry
     3370             and buf_gds-grp.upper-code = v-upper-code
     3371             no-error.
     3372       if not available buf_gds-grp then do:
     3373         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     3374       end.
     3375       else do:
     3376         p-node-code = buf_gds-grp.node-code.
     3377         v-upper-code = buf_gds-grp.node-code.
     3378       end.
     3379     end.
     3380   end.
     3381   end .
     3382   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3383   procedure cli-grplib-get-full-name :
     3384      define input parameter  p-node-code  as integer      no-undo.
     3385      define output parameter p-full-name as character    no-undo.
     3386   do
     3387   on error undo, return error
     3388   :
     3389       define variable v-upper-code    as integer           no-undo.
     3390       define buffer buf_cli-grp       for ub.cli-grp.
     3391       define buffer buf_upper_cli-grp for ub.cli-grp.
     3392       find first buf_cli-grp no-lock
     3393            where buf_cli-grp.node-code = p-node-code
     3394       no-error.
     3395       if not available buf_cli-grp
     3396       then do:
     3397           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
     3398       end.
     3399       assign
     3400           p-full-name  = ""
     3401           v-upper-code = 1
     3402       .
     3403       do while buf_cli-grp.upper-code <> 0
     3404       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     3405       :
     3406           assign
     3407               p-full-name  = buf_cli-grp.node-name
     3408                            + (if p-full-name <> "" then chr(47) else "")
     3409                            + p-full-name
     3410               v-upper-code = buf_cli-grp.upper-code
     3411           .
     3412           find first buf_cli-grp no-lock
     3413                where buf_cli-grp.node-code = v-upper-code
     3414           no-error.
     3415           if not available buf_cli-grp
     3416           then do:
     3417               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
     3418                                   + string( v-upper-code )
     3419                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     3420           end.
     3421       end.
     3422       assign
     3423       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     3424       .
     3425   end.
     3426   end .
     3427   procedure cgrplib-get-node-from-full-name :
     3428   define input parameter p-full-name as character no-undo .
     3429   define output parameter p-node-code as integer no-undo .
     3430   define variable v-ii as integer no-undo .
     3431   define variable v-upper-code as integer no-undo .
     3432   define variable v-root-code as integer no-undo .
     3433   define variable v-entry as character no-undo .
     3434   define buffer buf_cli-grp       for ub.cli-grp.
     3435   do
     3436   on error undo, return error
     3437   :
     3438     find first buf_cli-grp no-lock
     3439         where buf_cli-grp.upper-code = 0
     3440     no-error .
     3441     if not available buf_cli-grp
     3442     then do:
     3443         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
     3444     end.
     3445     else do:
     3446       assign
     3447       v-root-code = buf_cli-grp.node-code
     3448       .
     3449     end.
     3450     v-upper-code = v-root-code.
     3451     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     3452       assign
     3453       v-entry = entry(v-ii, p-full-name, chr(47)).
     3454       if v-entry = '' then leave.
     3455       find first buf_cli-grp no-lock where
     3456                 buf_cli-grp.node-name = v-entry
     3457             and buf_cli-grp.upper-code = v-upper-code
     3458             no-error.
     3459       if not available buf_cli-grp then do:
     3460         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     3461       end.
     3462       else do:
     3463         p-node-code = buf_cli-grp.node-code.
     3464         v-upper-code = buf_cli-grp.node-code.
     3465       end.
     3466     end.
     3467   end.
     3468   end .
