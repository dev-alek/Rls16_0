     3734   ON CHOOSE OF MENU-ITEM m-gds-save  DO:
     3735   define variable glog as logical no-undo .
     3736   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3737   if lookup(b-save :type in frame Dialog-Frame
     3738            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3739            ) = 0
     3740   then do:
     3741     message
     3742       "$Workfile$"
     3743       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3744       "Интерфейсный элемент" self :name in frame Dialog-Frame skip
     3745       "Тип" self :type in frame Dialog-Frame skip
