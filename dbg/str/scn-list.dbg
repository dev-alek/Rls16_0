     4369   end.
     4370   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4371   procedure minbtn-set :
     4372       do
     4373           on error undo, return error return-value
     4374           :
     4375           define variable ii              as integer       no-undo .
     4376           define variable fh              as widget-handle no-undo .
     4377           define variable hh              as widget-handle no-undo .
     4378           define variable v-h             as handle        extent 4 no-undo .
     4379           define variable v-name-button   as character     no-undo .
     4380           define variable v-help-old-x    as decimal       no-undo .
     4381           define variable v-help-old-y    as decimal       no-undo .
     4382           define variable v-help-old-size as decimal       no-undo .
     4383           define variable v-frame-width   as decimal       no-undo .
     4384           define variable jj              as integer       no-undo .
     4385           do
     4386               on error undo, return error
     4387               :
     4388               assign
     4389                   v-frame-width = frame Dialog-Frame:width - 0.3
     4390                   fh            = frame Dialog-Frame:first-child
     4391                   hh            = fh:first-child
     4392                   ii            = 1
     4393                   .
     4394               do while valid-handle(hh):
     4395                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     4396                   do:
     4397                       case lc(hh:name) :
     4398                           when "b-help" then
     4399                               do:
     4400                                   hh:load-image-up("cmp/b-help.bmp":u) .
     4401                                   hh:load-image-down("cmp/b-help.bmp":u) .
     4402                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     4403                                   hh:TOOLTIP = "Помощь" .
     4404                                   v-help-old-x = hh:column .
     4405                                   v-help-old-y = hh:row    .
     4406                                   v-help-old-size = hh:width .
     4407                                   hh:width-chars = 2.5 .
     4408                               end.
     4409                           when "b-print" then
     4410                               do:
     4411                                   hh:load-image("cmp/b-print.bmp":u) .
     4412                                   hh:TOOLTIP = "Печать" .
     4413                                   v-h[ii] = hh:handle .
     4414                                   ii = ii + 1 .
     4415                                   hh:width-chars = 3 .
     4416                               end.
     4417                           when "b-history" or
     4418                           when "b-hist" then
     4419                               do:
     4420                                   hh:load-image("cmp/b-hist.bmp":u) .
     4421                                   hh:TOOLTIP = "История" .
     4422                                   v-h[ii] = hh:handle .
     4423                                   ii = ii + 1 .
     4424                                   hh:width-chars = 3 .
     4425                               end.
     4426                           when "b-sch" then
     4427                               do:
     4428                                   hh:load-image("cmp/b-sch.bmp":u) .
     4429                                   hh:TOOLTIP = "Установка Фильтра" .
     4430                                   v-h[ii] = hh:handle .
     4431                                   ii = ii + 1 .
     4432                                   hh:width-chars = 3 .
     4433                               end.
     4434                           when "b-hist-user" then
     4435                               do:
     4436                                   hh:load-image("cmp/b-hist.bmp":u) .
     4437                                   hh:TOOLTIP = "История пользователя" .
     4438                                   ii = ii + 1 .
     4439                               end.
     4440                       end case.
     4441                   end.
     4442                   hh = hh:next-sibling.
     4443               end.
     4444               b-help:column = v-frame-width - b-help:width-chars.
     4445               jj = 0.
     4446               repeat ii = 4 to 1 by -1 :
     4447                   if valid-handle (v-h[ii] ) then
     4448                   do:
     4449                       jj  = jj + 1 .
     4450                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     4451                       v-h[ii]:row    = v-help-old-y .
     4452                   end.
     4453               end.
     4454           end.
     4455       end.
     4456   end procedure.
     4457   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     4458   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     4459   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     4460   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     4461   define variable v-diasize-current-frame-width  as decimal   no-undo .
     4462   define variable v-diasize-current-frame-height as decimal   no-undo .
     4463   define variable v-diasize-change-size          as logical   no-undo .
     4464   define variable v-diasize-resize-button        as handle    no-undo .
     4465   define variable v-diasize-wndmax               as logical   no-undo .
     4466   define variable v-diasize-wndstore             as logical   no-undo .
     4467   define variable v-diasize-proc-name            as character no-undo .
     4468   define variable v-diasize-browse-handle        as handle    no-undo .
     4469   define variable v-diasize-browse-number        as integer   no-undo .
     4470   define variable v-diasize-need-full-display    as logical   no-undo init false .
     4471   define temp-table temp-diasize-handle no-undo
     4472     field handle-value  as handle
     4473     field save-position as decimal
     4474     index xpk is primary unique handle-value
     4475     .
     4476   define temp-table temp-browse-handle no-undo
     4477     field browse-type   as character
     4478     field browse-number as integer
     4479     field browse-handle as handle
     4480     field original-size as decimal
     4481     index xpk is primary unique browse-type browse-number
     4482     index xie browse-type browse-handle
     4483   .
     4484   procedure diasize_change-height :
     4485     define input  parameter p-change-value  as decimal   no-undo .
     4486     define input  parameter p-move-resize   as logical   no-undo .
     4487     define variable v-field-group-handle    as handle    no-undo .
     4488     define variable v-object-handle         as handle    no-undo .
     4489     define variable v-frame-height          as decimal   no-undo .
     4490     define variable v-frame-virtual-height  as decimal   no-undo .
     4491     define variable v-browse-height         as decimal   no-undo .
     4492     define variable v-window-height         as decimal   no-undo .
     4493     define variable v-window-virtual-height as decimal   no-undo .
     4494     define variable v-change-sign           as integer   no-undo .
     4495     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     4496     define buffer buf_temp-browse-handle  for temp-browse-handle .
     4497     if p-change-value > 0
     4498     then do:
     4499       if frame Dialog-Frame :height + p-change-value
     4500           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     4501       then do:
     4502         assign
     4503           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     4504                           - (frame Dialog-Frame :height-chars)
     4505         .
     4506         if p-change-value <= 0
     4507         then do:
     4508           run diasize_position-resize-button in this-procedure .
     4509           return .
     4510         end.
     4511       end.
     4512     end.
     4513     if p-change-value < 0
     4514     then do:
     4515       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     4516       then do:
     4517         assign
     4518           p-change-value = v-diasize-orig-frame-height
     4519                          - (frame Dialog-Frame :height-chars)
     4520         .
     4521         if p-change-value >= 0
     4522         then do:
     4523           run diasize_position-resize-button in this-procedure .
     4524           return .
     4525         end.
     4526       end.
     4527     end.
     4528     if p-change-value >= 0
     4529     then do:
     4530       assign
     4531         v-change-sign = 1
     4532       .
     4533     end.
     4534     else do:
     4535       assign
     4536         v-change-sign = -1
     4537       .
     4538     end.
     4539     assign
     4540       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4541     .
     4542     if p-change-value = 0
     4543     then do:
     4544       run diasize_position-resize-button in this-procedure .
     4545       return .
     4546     end.
     4547     move_block:
     4548     do
     4549     on error undo move_block, retry move_block
     4550     :
     4551       if retry
     4552       then do:
     4553         do
     4554         on error undo move_block, leave move_block
     4555         :
     4556           if p-change-value > 0
     4557           then do:
     4558             for each buf_temp-diasize-handle
     4559             on error undo, next
     4560             :
     4561               assign
     4562                 v-object-handle = buf_temp-diasize-handle.handle-value
     4563               .
     4564               if v-object-handle <> v-diasize-resize-button
     4565               then do:
     4566                 assign
