     5180         :
     5181           assign
     5182             buf_temp-browse-handle.browse-handle :width
     5183               = buf_temp-browse-handle.browse-handle :width + p-change-value
     5184             no-error .
     5185           if error-status :error
     5186           or error-status :get-message(1) <> ""
     5187           then do:
     5188             undo move_block, retry move_block .
     5189           end.
     5190         end.
     5191         assign
     5192           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     5193           no-error .
     5194         if error-status :error
     5195         or error-status :get-message(1) <> ""
     5196         then do:
     5197           undo move_block, retry move_block.
     5198         end.
     5199         assign
     5200           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     5201         no-error .
     5202         if error-status :error
     5203         or error-status :get-message(1) <> ""
     5204         then do:
     5205           undo move_block, retry move_block.
     5206         end.
     5207         if frame Dialog-Frame :scrollable = true
     5208         then do:
     5209           assign
     5210             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     5211           no-error .
     5212           if error-status :error
     5213           or error-status :get-message(1) <> ""
     5214           then do:
     5215             undo move_block, retry move_block.
     5216           end.
     5217         end.
     5218       end.
     5219       if p-move-resize
     5220       then do:
     5221         run diasize_position-resize-button in this-procedure .
     5222       end.
     5223       if v-diasize-wndstore = true
     5224       then do:
     5225         if connected("ub") = true
     5226         then do:
     5227           define variable v-cntxt-db-num        as integer   no-undo .
     5228           define variable v-cntxt-userid        as character no-undo .
     5229           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5230                                             , OUTPUT v-cntxt-userid
     5231                                             ) .
     5232           run gbl/wndsizew.p
     5233             (input  v-cntxt-db-num
     5234             ,input  v-cntxt-userid
     5235             ,input  v-diasize-proc-name
     5236             ,input  'width':u
     5237             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     5238             ) .
     5239         end.
     5240       end.
     5241     end.
     5242     assign
     5243       v-diasize-change-size = false
     5244     .
     5245   end procedure.
     5246   procedure diasize_set-width :
     5247     define input  parameter p-new-width  as decimal   no-undo .
     5248     define input  parameter p-move-resize as logical   no-undo .
     5249     do
     5250     on error undo, return error return-value
     5251     :
     5252       run diasize_change-width in this-procedure
     5253         (input  (p-new-width - frame Dialog-Frame :width)
     5254         ,input  p-move-resize
     5255         ) .
     5256     end.
     5257   end procedure.
     5258   procedure diasize_position-resize-button :
     5259     do with frame Dialog-Frame
     5260     :
     5261       hide v-diasize-resize-button .
     5262       assign
     5263         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     5264                     - 1
     5265                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     5266         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     5267                     - 1
     5268                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     5269       .
     5270       view v-diasize-resize-button .
     5271     end.
     5272   end procedure.
     5273   on alt-right anywhere
     5274   do:
     5275     run diasize_change-width in this-procedure
     5276       (input 1
     5277       ,input true
     5278       ) .
     5279     return no-apply .
     5280   end.
     5281   on alt-left anywhere
     5282   do:
     5283     run diasize_change-width in this-procedure
     5284       (input -1
     5285       ,input true
     5286       ) .
     5287     return no-apply .
     5288   end.
     5289   on alt-down anywhere
     5290   do:
     5291     run diasize_change-height in this-procedure
     5292       (input 1
     5293       ,input true
     5294       ) .
     5295     return no-apply .
     5296   end.
     5297   on alt-up anywhere
     5298   do:
     5299     run diasize_change-height in this-procedure
     5300       (input -1
     5301       ,input true
     5302       ) .
     5303     return no-apply .
     5304   end.
     5305   on alt-enter of frame Dialog-Frame
     5306   do:
     5307     run diasize_maximize in this-procedure
     5308       (input  ?
     5309       ).
     5310     return no-apply .
     5311   end.
     5312   procedure diasize_end-move :
     5313     do
     5314     on error undo, return error return-value
     5315     :
     5316       define variable v-row-delta as decimal   no-undo .
     5317       define variable v-col-delta as decimal   no-undo .
     5318       define variable v-new-row as decimal   no-undo .
     5319       define variable v-new-col as decimal   no-undo .
     5320       assign
     5321         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     5322         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     5323       .
     5324       assign
     5325         v-row-delta = v-new-row - frame Dialog-Frame :height
     5326         v-col-delta = v-new-col - frame Dialog-Frame :width
     5327       .
     5328       run diasize_change-height in this-procedure
     5329         (input v-row-delta
     5330         ,input true
     5331         ) .
     5332       run diasize_change-width in this-procedure
     5333         (input v-col-delta
     5334         ,input true
     5335         ) .
     5336     end.
     5337   end procedure.
     5338   procedure diasize_maximize :
     5339     define input  parameter p-action as logical   no-undo .
     5340     do
     5341     on error undo, return error return-value
     5342     :
     5343       if p-action = ?
     5344       then do:
     5345         if v-diasize-need-maximize = true
     5346         then do:
     5347           assign
     5348             p-action = true
     5349           .
     5350         end.
     5351         else do:
     5352           assign
     5353             p-action = false
     5354           .
     5355         end.
     5356       end.
     5357       if p-action = true
     5358       then do:
     5359         run diasize_change-height in this-procedure
     5360           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     5361               - frame Dialog-Frame :height-chars
     5362           ,input true
     5363           ) .
     5364         run diasize_change-width in this-procedure
     5365           (input session :width-chars
     5366               - frame Dialog-Frame :width-chars
     5367           ,input true
     5368           ) .
     5369         assign
     5370           v-diasize-need-maximize = false
     5371         .
     5372       end.
     5373       else do:
     5374         run diasize_change-width in this-procedure
     5375           (input v-diasize-orig-frame-width
     5376               - frame Dialog-Frame :width-chars
     5377           ,input true
     5378           ) .
     5379         run diasize_change-height in this-procedure
     5380           (input v-diasize-orig-frame-height
     5381               - frame Dialog-Frame :height-chars
     5382           ,input true
     5383           ) .
     5384         assign
     5385           v-diasize-need-maximize = true
     5386         .
     5387       end.
     5388     end.
     5389   end procedure.
     5390   procedure diasize_restore-orig-size :
     5391     do
     5392     on error undo, return error return-value
     5393     :
     5394       assign
     5395         v-diasize-current-frame-width  = frame Dialog-Frame :width
     5396         v-diasize-current-frame-height = frame Dialog-Frame :height
     5397       .
     5398       run diasize_set-height in this-procedure
     5399         (input  v-diasize-orig-frame-height
     5400         ,input  true
     5401         ) .
     5402       run diasize_set-width in this-procedure
     5403         (input  v-diasize-orig-frame-width
     5404         ,input  true
     5405         ) .
     5406     end.
     5407   end procedure.
     5408   procedure diasize_restore-current-size :
     5409     do
     5410     on error undo, return error return-value
     5411     :
     5412       run diasize_set-height in this-procedure
     5413         (input  v-diasize-current-frame-height
     5414         ,input  true
     5415         ) .
     5416       run diasize_set-width in this-procedure
     5417         (input  v-diasize-current-frame-width
     5418         ,input  true
     5419         ) .
     5420     end.
     5421   end procedure.
     5422   procedure diasize_set-browse-handle :
     5423     define input  parameter p-browse-handle as handle   no-undo .
     5424     define buffer buf_temp-browse-handle for temp-browse-handle .
     5425     do
     5426     on error undo, return error return-value
     5427     :
     5428       assign
     5429         v-diasize-browse-handle = p-browse-handle
     5430       .
     5431       for each buf_temp-browse-handle
     5432       on error undo, return error return-value
     5433       :
     5434         delete buf_temp-browse-handle .
     5435       end.
     5436     end.
     5437   end procedure.
     5438   procedure diasize_add_browse :
     5439     define input  parameter p-browse-type   as character no-undo .
     5440     define input  parameter p-browse-handle as handle    no-undo .
     5441     define buffer buf_temp-browse-handle for temp-browse-handle .
     5442     do
     5443     on error undo, return error return-value
     5444     :
     5445       assign
     5446         v-diasize-browse-number = v-diasize-browse-number + 1
     5447       .
     5448       create buf_temp-browse-handle .
     5449       assign
     5450         buf_temp-browse-handle.browse-type   = p-browse-type
     5451         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     5452         buf_temp-browse-handle.browse-handle = p-browse-handle
     5453       .
     5454     end.
     5455   end procedure.
     5456   procedure diasize_init :
     5457     define variable v-default-value    as logical   no-undo .
     5458     define variable v-restore-saved    as logical   no-undo .
     5459     define variable v-resize-value-str as character no-undo .
     5460     do
     5461     on error undo, return error return-value
     5462     :
     5463       do with frame Dialog-Frame
     5464       :
     5465         assign
     5466           v-diasize-orig-frame-height = frame Dialog-Frame :height
     5467           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     5468           v-diasize-browse-handle     = browse br-list :handle
     5469         .
     5470         create button v-diasize-resize-button
     5471         assign
     5472           parent        = frame Dialog-Frame :first-child
     5473           label         = "s"
     5474           height-pixels = 16
     5475           width-pixels  = 16
     5476           visible       = true
     5477           sensitive     = true
     5478           movable       = true
     5479           triggers:
     5480             on end-move persistent run diasize_end-move in this-procedure .
     5481           end triggers.
     5482         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     5483         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     5484         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     5485         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     5486         assign
     5487           v-diasize-wndmax = false
     5488         .
     5489         if connected("ub") = true
     5490         then do:
     5491           define variable v-cntxt-db-num        as integer   no-undo .
     5492           define variable v-cntxt-userid        as character no-undo .
     5493           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5494                                             , OUTPUT v-cntxt-userid
     5495                                             ) .
     5496           run gbl/wndpar_r.p
     5497             (input  v-cntxt-db-num
     5498             ,input  v-cntxt-userid
     5499             ,input  'wndmax':U
     5500             ,output v-diasize-wndmax
     5501             ,output v-default-value
     5502             ) .
     5503         end.
     5504         assign
     5505           v-diasize-wndstore = false
     5506         .
     5507         if connected("ub") = true
     5508         then do:
     5509           run gbl/wndpar_r.p
     5510             (input  v-cntxt-db-num
     5511             ,input  v-cntxt-userid
     5512             ,input  'wndstore':U
     5513             ,output v-diasize-wndstore
     5514             ,output v-default-value
     5515             ) .
     5516         end.
     5517         assign
     5518           v-diasize-proc-name = entry(1, program-name(2), '.')
     5519         .
     5520         if v-diasize-wndstore = true
     5521         then do:
     5522           assign
     5523             v-restore-saved = false
     5524           .
     5525           if connected("ub") = true
     5526           then do:
     5527             run gbl/wndsizer.p
     5528               (input  v-cntxt-db-num
     5529               ,input  v-cntxt-userid
     5530               ,input  v-diasize-proc-name
     5531               ,input  'height':u
     5532               ,output v-resize-value-str
     5533               ) .
     5534             if v-resize-value-str <> '':U
     5535             then do:
     5536               run diasize_change-height in this-procedure
     5537                 (input  integer(v-resize-value-str)
     5538                 ,input  true
     5539                 ) .
     5540               assign
     5541                 v-restore-saved = true
     5542               .
     5543             end.
     5544           end.
     5545           if connected("ub") = true
     5546           then do:
     5547             run gbl/wndsizer.p
     5548               (input  v-cntxt-db-num
     5549               ,input  v-cntxt-userid
     5550               ,input  v-diasize-proc-name
     5551               ,input  'width':u
     5552               ,output v-resize-value-str
     5553               ) .
     5554             if v-resize-value-str <> '':U
     5555             then do:
     5556               run diasize_change-width in this-procedure
     5557                 (input  integer(v-resize-value-str)
     5558                 ,input  true
     5559                 ) .
     5560               assign
     5561                 v-restore-saved = true
     5562               .
     5563             end.
     5564           end.
     5565           if v-restore-saved <> true
     5566           then do:
     5567             if v-diasize-wndmax = true
     5568             then do:
     5569               run diasize_maximize in this-procedure
     5570                 (input  true
     5571                 ) .
     5572             end.
     5573           end.
     5574         end.
     5575         else do:
     5576           if v-diasize-wndmax = true
     5577           then do:
     5578             run diasize_maximize in this-procedure
     5579               (input  true
     5580               ) .
     5581           end.
     5582         end.
     5583       end.
     5584     end.
     5585   end procedure.
     5586   procedure diasize_need-full-display :
     5587     define output parameter p-need-full-display as logical   no-undo .
     5588     do
     5589     on error undo, return error return-value
     5590     :
     5591       assign
     5592         p-need-full-display = v-diasize-need-full-display
     5593       .
     5594       assign
     5595         v-diasize-need-full-display = false
     5596       .
     5597     end.
     5598   end procedure.
     5599   procedure get-context :
     5600      define output parameter p-db-num as integer          no-undo.
     5601      define output parameter p-user-id as character        no-undo.
     5602      define variable v-login               as character    no-undo.
     5603      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     5604      define buffer buf_user-login  for ub.user-login .
     5605      do
     5606      on error undo, return error
     5607      :
     5608            FIND FIRST buf_sys-ctrl no-lock.
     5609            ASSIGN
     5610               v-login = USERID("ub")
     5611               p-db-num = buf_sys-ctrl.db-num
     5612            .
     5613            FIND FIRST buf_user-login
     5614                 WHERE buf_user-login.db-num = p-db-num
     5615                   AND buf_user-login.user-login = v-login
     5616                 no-lock
     5617                 no-error
     5618                 .
     5619            IF AVAILABLE buf_user-login
     5620            THEN DO:
     5621               assign
     5622                  p-user-id = buf_user-login.user-id
     5623               .
     5624            END.
     5625      end.
     5626   end procedure.
     5627   def var vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5628   def var vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5629   define variable v-no-context as logical no-undo .
     5630   define variable v-user-obj-type as character no-undo .
     5631   define variable v-user-obj-code as integer no-undo .
     5632   FUNCTION prepare-rowid returns character ( input p-uniq-key-rec as character
     5633                                            , input p-no-context as logical ):
     5634   define variable v-uniq-key-rec as character no-undo .
     5635   if p-no-context and p-uniq-key-rec begins 'user-obj':U then do:
     5636     v-uniq-key-rec = 'clients':U + chr(3) +
     5637                     entry(4, p-uniq-key-rec, chr(3)) + chr(3) +
     5638                     entry(5, p-uniq-key-rec, chr(3)).
     5639   end.
     5640   else do:
     5641     v-uniq-key-rec = p-uniq-key-rec.
     5642     case entry(1, p-uniq-key-rec, chr(3)):
     5643        when 'user-obj':U then do:
     5644          entry(lookup("user-id", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = v-cntxt-userid.
     5645          entry(lookup("db-num", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = string(v-cntxt-db-num).
     5646        end.
     5647     end case.
     5648   end.
     5649   return v-uniq-key-rec.
     5650   end function.
     5651   procedure find-user-obj-rowid :
     5652   define input parameter p-rowid as rowid no-undo .
     5653   define input parameter p-no-context as logical no-undo .
     5654   define output parameter p-user-obj-type as character no-undo .
     5655   define output parameter p-user-obj-code as integer no-undo .
     5656   define buffer user-obj_clients for ub.clients.
     5657   define buffer user-obj_user-obj for ub.user-obj .
     5658   if p-no-context then do:
     5659     find first user-obj_clients no-lock where rowid(user-obj_clients) = p-rowid.
     5660     assign
     5661     p-user-obj-type = user-obj_clients.obj-type
     5662     p-user-obj-code = user-obj_clients.obj-code.
     5663   end.
     5664   else do:
     5665     find first user-obj_user-obj no-lock where rowid(user-obj_user-obj) = p-rowid no-error.
     5666     if not available user-obj_user-obj then do:
     5667       undo, return error substitute("Не удалось выполнить в данной БД записанные действия пользователя").
     5668     end.
     5669     assign
     5670     p-user-obj-type = user-obj_user-obj.obj-type
     5671     p-user-obj-code = user-obj_user-obj.obj-code.
     5672   end.
     5673   end procedure.
     5674   define variable an-listp-start-macro-id as integer no-undo init ?.
     5675   define variable an-listp-end-macro-id as integer no-undo  init ?.
     5676   define variable an-listp-macros-label-id as integer   no-undo .
     5677   define variable v-macro-is-running as logical no-undo .
     5678   define variable v-current-step as integer no-undo .
     5679   define variable v-expand as logical no-undo .
     5680   define variable v-downed as character no-undo .
     5681   define variable p-title as character no-undo .
     5682   define variable bttns as character no-undo .
     5683   define variable p-keep-query as logical no-undo .
     5684   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5685   define     temp-table keep-macro-list-hist no-undo
     5686   field list-table as character
     5687   field id as integer
     5688   field line as integer
     5689   field hist-mode as character
     5690   field des as character
     5691   field num-recs as integer
     5692   field option_ as character
     5693   field item_ as character
     5694   field status_ as character
     5695   field num-add as integer
     5696   field num-ignored as integer
     5697   field done as logical
     5698   field err_ as logical
     5699   field err-mes as character
     5700   index pi is primary
     5701   id
     5702   line
     5703   index isdone
     5704   done
     5705   .
     5706   procedure assign-nums :
     5707   define input-output parameter p-num-add as integer no-undo .
     5708   define input-output parameter p-num-rec as integer no-undo .
     5709   define input-output parameter p-num-ignored as integer no-undo .
     5710   define input parameter p-line-mode as character no-undo .
     5711   assign
     5712   p-num-add  = lns-cnt - v-num-add
     5713   p-num-rec = (if line-mode = 'ОСТАВИТЬ':U
     5714                             then (tot-lns + p-num-add)
     5715                             else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))
     5716   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)
     5717   p-num-ignored = lns-ignore  - v-num-ignored
     5718   v-num-add             = lns-cnt
     5719   v-num-ignored         = lns-ignore
     5720   .
     5721   END PROCEDURE.
     5722   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     5723   or INSERT-MODE of br-list
     5724   DO:
     5725   define variable glog as logical no-undo .
     5726   define buffer buf-scn-list-hist for scn-list-hist.
     5727   define buffer buf_macro-list-hist for macro-list-hist.
     5728   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     5729    if p-keep-query then do:
     5730       glog = no.
     5731       message "Реинициализация списка. Вы уверены ?"
     5732               view-as alert-box question buttons OK-Cancel update glog.
     5733       if not glog then return no-apply.
     5734       if session:set-wait-state( "COMPILER" )  then .
     5735       for each scn-list:
     5736         delete scn-list.
     5737       end.
     5738       if session:set-wait-state( "" )  then .
     5739       tot-lns = 0.
     5740       v-seq = 1.
     5741       for each buf-scn-list-hist:
     5742         delete buf-scn-list-hist.
     5743       end.
     5744      for each buf_keep-macro-list-hist:
     5745        create buf_macro-list-hist.
     5746      end.
     5747      run proc-macro-play in this-procedure ( input 0, input yes, input 0).
     5748      run create-scn-list-hist in this-procedure (
     5749                                             input 'ДОБАВЛЕНИЕ':U
     5750                                           , input-output v-seq
     5751                                           , input 0
     5752                                           , input '0':U
     5753                                           , input "# Реинициализация списка."
     5754                                           , input 0
     5755                                           , input "init"
     5756                                           , input '':U
     5757                                           , input '':U
     5758                                           , input '':U
     5759                                           , input ?
     5760                                           ).
     5761       display
     5762       tot-lns @ f-tot-lns
     5763       ? @ ub.clients.obj-name
     5764       ? @ ub.gds-prt.node-name
     5765       ? @ ub.bar-code.b-code
     5766       with frame Dialog-Frame.
     5767       run ui-on in this-procedure .
     5768    end.
     5769    else do:
     5770      assign rs-list-method = "single".
     5771      run proc-b-add in this-procedure(input no
     5772                                     ,input ?
     5773                                     ,input rs-list-method
     5774                                     ,input rs-status)  no-error .
     5775     if error-status:error then return no-apply.
     5776   end.
     5777   END.
     5778   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     5779   or DELETE-CHARACTER of br-list
     5780   DO:
     5781     if not available scn-list then return no-apply.
     5782     assign rs-list-method = "single".
     5783       run proc-b-del in this-procedure(
     5784                                                  input no
     5785                                                 ,input ?
     5786                                                 ,input rs-list-method
     5787                                                 ,input rs-status) no-error .
     5788     if error-status:error then return no-apply.
     5789   END.
     5790   ON CHOOSE OF B-rest IN FRAME Dialog-Frame
     5791   DO:
     5792   if not available scn-list then return no-apply.
     5793     assign rs-list-method = "single".
     5794    run proc-b-rest in this-procedure(
     5795                                                   input no
     5796                                                  ,input ?
     5797                                                  ,input rs-list-method
     5798                                                  ,input rs-status) no-error .
     5799     if error-status:error then return no-apply.
     5800   END.
     5801   on choose of MENU-ITEM m-macro-file in menu m-play DO:
     5802     assign
     5803     macro-play-option = 'file':U.
     5804     APPLY "CHOOSE" to b-macro in frame Dialog-Frame.
     5805   end.
     5806   on choose of MENU-ITEM m-macro-lob in menu m-play DO:
     5807     assign
     5808     macro-play-option = 'lob':U.
     5809     APPLY "CHOOSE" to b-macro in frame Dialog-Frame.
     5810   end.
     5811   ON CHOOSE OF B-macro IN FRAME Dialog-Frame
     5812   DO:
     5813   if macro-play-option = '':U then do:
     5814         run gbl/pop-up.p ( input self:handle, input no) no-error.
     5815   end.
     5816   if macro-play-option = '':U then return no-apply.
     5817   run proc-b-macro in this-procedure ( input macro-play-option) no-error .
     5818   if error-status:error then return no-apply.
     5819   END.
     5820   ON CHOOSE OF B-record IN FRAME Dialog-Frame
     5821   DO:
     5822   define variable glog as logical no-undo .
     5823   message
     5824   "Начать запись макроса формирования списка?"
     5825   view-as alert-box QUESTION buttons yes-no update glog.
     5826   if not glog then return no-apply.
     5827   assign
     5828   an-listp-start-macro-id = v-seq
     5829   an-listp-end-macro-id = ?
     5830   .
     5831     menu-item m-macro-file:label in menu m-play = "Ранее записанный макрос формирования списка товаров".
     5832     menu-item m-macro-lob:sensitive in menu m-play = no.
     5833   disable
     5834   b-record with frame Dialog-Frame .
     5835   hide
     5836   b-record
     5837   b-macro
     5838   in frame Dialog-Frame .
     5839   enable
     5840   b-stop with frame Dialog-Frame .
     5841   run create-scn-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     5842                                       , input-output v-seq
     5843                                       , input 0
     5844                                       , input 'o':U
     5845                                       , input "Начата запись макроса формирования списка"
     5846                                       , input tot-lns
     5847                                       , input 'macro':U
     5848                                       , input '':U
     5849                                       , input '':U
     5850                                       , input '':U
     5851                                       , input ?
     5852                                       ).
     5853   END.
     5854   ON CHOOSE OF B-stop IN FRAME Dialog-Frame
     5855   DO:
     5856   define variable glog as logical no-undo .
     5857   define variable v-id as integer no-undo .
     5858   define buffer buf_scn-list-hist for scn-list-hist.
     5859   message
     5860   "Закончить запись макроса формирования списка?"
     5861   view-as alert-box QUESTION buttons yes-no update glog.
     5862   if not glog then return no-apply.
     5863   assign
     5864   an-listp-end-macro-id = v-seq.
     5865   disable
     5866   b-stop with frame Dialog-Frame .
     5867   hide
     5868   b-stop in frame Dialog-Frame .
     5869   enable
     5870   b-record
     5871   b-macro
     5872   with frame Dialog-Frame .
     5873   run create-scn-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     5874                                       , input-output v-seq
     5875                                       , input 0
     5876                                       , input '[]':U
     5877                                       , input "Закончена запись макроса формирования списка"
     5878                                       , input tot-lns
     5879                                       , input 'macro':U
     5880                                       , input '':U
     5881                                       , input '':U
     5882                                       , input '':U
     5883                                       , input ?
     5884                                       ).
     5885   for each macro-list-hist:
     5886     delete macro-list-hist.
     5887   end.
     5888   for each buf_scn-list-hist where
     5889           buf_scn-list-hist.id >=  an-listp-start-macro-id
     5890     and  buf_scn-list-hist.id <=  an-listp-end-macro-id:
     5891     create macro-list-hist.
     5892     buffer-copy buf_scn-list-hist
     5893     except id num-recs num-add num-ignored
     5894     to macro-list-hist
     5895     assign
     5896     macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     5897     v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     5898     .
     5899   end.
     5900   END.
     5901   ON CHOOSE OF b-clear-macro IN FRAME Dialog-Frame
     5902   DO:
     5903   disable
     5904   b-clear-macro with frame Dialog-Frame .
     5905   assign
     5906   an-listp-start-macro-id = ?
     5907   an-listp-end-macro-id = ?
     5908   an-listp-macros-label-id = 0
     5909   .
     5910   menu-item m-macro-lob:sensitive in menu m-play = yes.
     5911   for each macro-list-hist:
     5912     delete macro-list-hist.
     5913   end.
     5914   hide
     5915   b-clear-macro in frame Dialog-Frame .
     5916   enable
     5917   b-record
     5918   b-macro
     5919   with frame Dialog-Frame .
     5920   END.
     5921   ON VALUE-CHANGED OF br-option IN FRAME Dialog-Frame
     5922   DO:
     5923     assign
     5924     Rs-list-method = temp-list.fvalue
     5925     .
     5926     run proc-vc-rs-list-method in this-procedure no-error .
     5927     if error-status:error then return no-apply.
     5928   END.
     5929   PROCEDURE get-operation :
     5930   define input parameter p-message as character no-undo .
     5931   define output parameter p-operation as integer no-undo .
     5932     do
     5933     on error undo, return error
     5934     :
     5935       run gbl/d-askw.w (
     5936                     input "Выбор операции над заданным списком"
     5937                    ,input (p-message + chr(10) +
     5938                            "Выберите операцию, которую Вы хотите применить к полученному списку" +  chr(10) )
     5939                    ,input "|"
     5940                   ,input  ("Добавить" + (if p-keep-query then "^disable" else '':U) + "|" +
     5941                            "Удалить" + "|" +
     5942                            "Оставить" + "|" +
     5943                            "Отказ")
     5944                    ,input ("Добавить полученный список к уже имеющемуся" + "|" +
     5945                           "Удалить полученный список из уже имеющегося" + "|" +
     5946                           "Оставить в уже имеющемся списке только элементы полученного списка" +  "|" +
     5947                           "Ничего не делать")
     5948                    ,input  (if p-keep-query then 2 else 1)
     5949                    ,input  4
     5950                    ,output p-operation).
     5951      if p-operation = 4 then do:
     5952         return error .
     5953      end.
     5954     end.
     5955   END PROCEDURE.
