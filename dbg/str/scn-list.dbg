     4188   ON CHOOSE OF b-hist IN FRAME Dialog-Frame DO:
     4189   define buffer buf_scn-list-hist for scn-list-hist.
     4190   run prn-lib-open-stream  in this-procedure (
     4191                                                input parParentProc
     4192                                               ,input 43
     4193                                               ,input yes
     4194                                               ,input no
     4195                                               ).
     4196   find first buf_scn-list-hist no-lock where buf_scn-list-hist.id = 0 no-error .
     4197   PUT  STREAM PrnLibStream unformatted
     4198   SPACE(25) "История создания списка товаров "
     4199   (if available buf_scn-list-hist
     4200   then buf_scn-list-hist.des
     4201   else "БЕЗЫМЯННЫЙ") skip(0)
     4202   space(25) cur-time-print() skip(1)
     4203   .
     4204   put stream PrnLibStream unformatted
     4205   string("№", "X(9)") chr(32)
     4206   string("Действие", "X(9)") chr(32)
     4207   string("записей", "X(9)") chr(32)
     4208   string(" = итого", "X(12)") chr(32)
     4209   string("Множество", "X(155)")
     4210   skip(0)
     4211   fill('-':U, 9) chr(32)
     4212   fill('-':U, 9) chr(32)
     4213   fill('-':U, 9) chr(32)
     4214   fill('-':U, 12) chr(32)
     4215   fill('-':U, 155)
     4216   skip(0)
     4217   .
     4218   for each buf_scn-list-hist where buf_scn-list-hist.id > 0
     4219   by buf_scn-list-hist.id
     4220   :
     4221     put stream PrnLibStream unformatted
     4222     (if buf_scn-list-hist.line = 0
     4223      then string(buf_scn-list-hist.id, ">>>>>>>>9")
     4224      else fill(chr(32) , 9)
     4225     )  chr(32)
     4226     (if buf_scn-list-hist.item_ <> '':U
     4227      then string(buf_scn-list-hist.hist-mode, "X(8)")
     4228      else fill( chr(32), 8)) chr(32)
     4229     string(buf_scn-list-hist.num-add, ">>>>>>>>9") chr(32) chr(32) chr(32) chr(32)
     4230     string(buf_scn-list-hist.num-recs, ">>>>>>>>9")  chr(32)
     4231     string(buf_scn-list-hist.des, "X(155)") skip.
     4232   end.
     4233   output stream prnlibstream close.
     4234     run prn-lib-prn-file in this-procedure (
     4235                                               input parParentProc
     4236                                               ,input 8
     4237                                               ).
