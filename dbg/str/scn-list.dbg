     3991   PROCEDURE proc-valchg-a-n-c:
     3992     case input frame Dialog-Frame a-n-c :
     3993       when "art" then do:
     3994         apply "entry" to br-list in frame Dialog-Frame.
     3995         hide loc-name loc-code
     3996         in frame Dialog-Frame.
     3997         loc-art = "".
     3998       end.
     3999       when "name" then do:
     4000         enable loc-name with frame Dialog-Frame.
     4001         disp loc-name with frame Dialog-Frame.
     4002         hide loc-art loc-code
     4003         in frame Dialog-Frame.
     4004         apply "entry" to loc-name in frame Dialog-Frame.
     4005       end.
     4006       when "code"
     4007    or when "DataMatrix" then
     4008       do:
     4009         enable loc-code with frame Dialog-Frame.
     4010         disp loc-code with frame Dialog-Frame.
     4011         hide loc-art loc-name
     4012         in frame Dialog-Frame.
     4013         apply "entry" to loc-code in frame Dialog-Frame.
     4014       end.
     4015     end CASE.
     4016   END PROCEDURE.
     4017   PROCEDURE proc-any-printable-br-list :
     4018     if input frame Dialog-Frame a-n-c = "art" then do:
     4019       if last-event:label = " " and
     4020          loc-art = "" then
     4021       return error.
     4022       find first l-scn-list where
     4023                   l-scn-list.artic begins (loc-art + last-event:label)
     4024                  no-lock no-error.
     4025       if available l-scn-list then do:
     4026         loc-art = loc-art + last-event:label.
     4027         disp loc-art with frame Dialog-Frame.
     4028         line-rec = recid (l-scn-list).
     4029         reposition br-list to recid line-rec no-error.
     4030         apply "value-changed" to br-list in frame Dialog-Frame.
     4031       end.
     4032     end.
     4033   END PROCEDURE.
     4034   PROCEDURE proc-backspace-br-list:
     4035     if input frame Dialog-Frame a-n-c = "art" then do:
     4036       if loc-art = "" then
     4037         return error.
     4038       loc-art = substr (loc-art, 1, length (loc-art) - 1).
     4039       find first l-scn-list where
     4040                   l-scn-list.artic begins loc-art
     4041                  no-lock.
     4042       disp loc-art with frame Dialog-Frame.
     4043       line-rec = recid (l-scn-list).
     4044       reposition br-list to recid line-rec no-error.
     4045       apply "value-changed" to br-list in frame Dialog-Frame.
     4046     end.
     4047   END PROCEDURE.
     4048   PROCEDURE proc-mouse-dbl-click-loc-code:
     4049   def var str-code as integer no-undo.
     4050   define variable varresult   as character         no-undo.
     4051   define variable vartype-bc  as character         no-undo.
     4052   define variable varweight   as decimal           no-undo.
     4053   define buffer l-goods for ub.goods.
     4054   define buffer l-bar-code for ub.bar-code.
     4055   define buffer buf_bar-code for ub.bar-code .
     4056   define buffer buf_prod-bc for ub.prod-bc.
     4057   define buffer buf_place for ub.place.
     4058     assign
     4059     frame Dialog-Frame
     4060     loc-code
     4061     a-n-c.
     4062     if a-n-c = "datamatrix"
     4063     then do:
     4064   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_dm-rcnz in g#libbcrcn
     4065   (
     4066    input  parparentproc
     4067   ,input  loc-code
     4068   ,input  ?
     4069   ,input  p-curr-obj-type
     4070   ,input  p-curr-obj-code
     4071   ,input  yes
     4072   ,input  no
     4073   ,input  varscales-pref30
     4074   ,input  varpgscales-pref30
     4075   ,output varresult
     4076   ,output vartype-bc
     4077   ,output varweight
     4078   ,buffer buf_bar-code
     4079   ,buffer buf_prod-bc
     4080   ,buffer buf_place
     4081   ) no-error.
     4082        if varresult eq "prod-bc"
     4083        then
     4084           loc-code:screen-value in frame Dialog-Frame = buf_prod-bc.b-str.
     4085     end.
     4086     else do:
     4087   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     4088   (
     4089    input  parparentproc
     4090   ,input  loc-code
     4091   ,input  ?
     4092   ,input  p-curr-obj-type
     4093   ,input  p-curr-obj-code
     4094   ,input  yes
     4095   ,input  no
     4096   ,input  varscales-pref30
     4097   ,input  varpgscales-pref30
     4098   ,output varresult
     4099   ,output vartype-bc
     4100   ,output varweight
     4101   ,buffer buf_bar-code
     4102   ,buffer buf_prod-bc
     4103   ,buffer buf_place
     4104   ) no-error.
     4105   end.
     4106     if available buf_bar-code then do:
     4107           find first l-goods where
     4108                     l-goods.gds-code =
     4109     buf_bar-code.gds-code No-LOCK.
     4110           find first l-scn-list where
     4111                     l-scn-list.artic = l-goods.artic AND
     4112                     l-scn-list.prod-type = l-goods.prod-type AND
     4113                     l-scn-list.prod-code = l-goods.prod-code no-lock no-error.
     4114       if available l-scn-list then do:
     4115         line-rec = recid (l-scn-list).
     4116         reposition br-list to recid line-rec no-error.
     4117         apply "value-changed" to br-list in frame Dialog-Frame.
     4118       end.
     4119       else do:
     4120         message "Строка не найдена."
     4121                 view-as alert-box error.
     4122       end.
     4123     end.
     4124     else
     4125       message "Бар-код не найден."
     4126               view-as alert-box error.
     4127     apply "entry" to loc-code in frame Dialog-Frame.
     4128   END PROCEDURE.
     4129   PROCEDURE  proc-mouse-dbl-click-loc-name:
     4130     assign
     4131     frame Dialog-Frame
     4132     loc-name.
     4133       if last-event:label = "Ctrl-J" then
     4134         find next l-scn-list where
     4135                   can-find (ub.goods where ub.goods.artic = l-scn-list.artic and
     4136                   ub.goods.prod-type = l-scn-list.prod-type and
     4137                   ub.goods.prod-code = l-scn-list.prod-code and
     4138                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     4139       else
     4140         find first l-scn-list where
     4141                   can-find (ub.goods where ub.goods.artic = l-scn-list.artic and
     4142                   ub.goods.prod-type = l-scn-list.prod-type and
     4143                   ub.goods.prod-code = l-scn-list.prod-code and
     4144                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     4145       if available l-scn-list then do:
     4146         line-rec = recid (l-scn-list).
     4147         reposition br-list to recid line-rec no-error.
     4148            apply "value-changed" to br-list in frame Dialog-Frame.
     4149       end.
     4150       else do:
     4151         message "Строка не найдена."
     4152                 view-as alert-box error.
     4153       end.
     4154     apply "entry" to loc-name in frame Dialog-Frame.
     4155   END PROCEDURE.
     4156   on value-changed of br-list in frame Dialog-Frame do:
     4157   if not available scn-list or recid (scn-list) <> line-rec then do:
     4158       hide loc-art in frame Dialog-Frame.
     4159       loc-art = "".
     4160   end.
     4161   if available scn-list then do:     find ub.clients where ub.clients.obj-type = scn-list.prod-type                    and ub.clients.obj-code = scn-list.prod-code no-lock.     find ub.gds-prt where ub.gds-prt.upper-code = scn-list.prt-root no-lock.     find ub.bar-code where ub.bar-code.gds-code  = scn-list.gds-code                     and ub.bar-code.node-code = ub.gds-prt.node-code                     and ub.bar-code.unit-cli  = scn-list.unit-base                     and ub.bar-code.in-code   = ""                     and ub.bar-code.part-code = "" no-lock.     disp ub.clients.obj-name ub.gds-prt.node-name ub.bar-code.b-code tot-lns @ f-tot-lns with frame Dialog-Frame.   end.   else display f-tot-lns with frame Dialog-Frame.
     4162   end.
