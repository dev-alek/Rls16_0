     8150                buf_scn-list-hist.id = p-id
     8151           and  buf_scn-list-hist.item_ <> '':U:
     8152         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_scn-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     8153         grp-path = "".
     8154         find first gds-grp no-lock where rowid(gds-grp) = v-rowid.
     8155         run grplib-get-full-name in this-procedure (gds-grp.node-code, output grp-path).
     8156         goods:
     8157         for each goods where goods.grp-name begins grp-path no-lock,
     8158             each recipe no-lock where recipe.artic = ub.goods.artic
     8159                           and recipe.prod-type = ub.goods.prod-type
     8160                           and recipe.prod-code = ub.goods.prod-code :
     8161             for each recipe-gds where recipe-gds.recipe-code = recipe.recipe-code no-lock:
     8162             if can-find(first gds-obj no-lock where gds-obj.obj-type = v-cntxt-obj-type
     8163                                     and gds-obj.obj-code = v-cntxt-obj-code
     8164                                     and gds-obj.gds-code = recipe-gds.gds-code
     8165                                     and gds-obj.fact-qnty > 0) then.
     8166             else do:
     8167                   run ex-gds  in this-procedure ( buffer goods, input rs-list-method, input rs-status, input line-mode).
     8168                   next goods.
     8169               end.
     8170             end.
     8171         end.
     8172         assign                                                           buf_scn-list-hist.num-add  = lns-cnt - v-num-add                       buf_scn-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_scn-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_scn-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8173        end.
     8174     end.
     8175     when "move-date":U then do:
     8176         find first buf_scn-list-hist where
     8177             buf_scn-list-hist.id = p-id
     8178         AND buf_scn-list-hist.item_ <> '':U .
     8179         for each gds-obj  no-lock where gds-obj.obj-type = v-cntxt-obj-type
     8180                                     and gds-obj.obj-code = v-cntxt-obj-code
     8181                                     and gds-obj.last-doc >= date(buf_scn-list-hist.item_):
     8182             for first goods no-lock where
     8183                   goods.artic = ub.gds-obj.artic
     8184               and goods.prod-type = ub.gds-obj.prod-type
     8185               and goods.prod-code = ub.gds-obj.prod-code:
     8186               run ex-gds in this-procedure ( buffer goods, input rs-list-method, input rs-status, input line-mode).
     8187               assign                                                           buf_scn-list-hist.num-add  = lns-cnt - v-num-add                       buf_scn-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_scn-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_scn-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8188             end.
     8189         end.
     8190     end.
     8191   end.
     8192   dsp-rs:fgcolor in frame Dialog-Frame = 4.
     8193   if session:set-wait-state( "" )  then .
     8194   case line-mode :
     8195     when 'ДОБАВЛЕНИЕ':U then do:
     8196       tot-lns = tot-lns + lns-cnt.
     8197       if not p-from-macro or p-step then
     8198       message
     8199       "Добавлено строк :" lns-cnt skip(0)
     8200       string(if lns-ignore <> 0
     8201       then ("Проигнорировано строк :" + string(lns-ignore))
     8202       else "":U)
     8203       .
     8204     end.
     8205     when 'удаление':U then do:
     8206       tot-lns = tot-lns - lns-cnt.
     8207       if not p-from-macro or p-step then
     8208       message
     8209       "Удалено строк :" lns-cnt skip(0)
     8210       string(if lns-ignore <> 0
     8211       then ("Проигнорировано строк :" + string(lns-ignore))
     8212       else "":U)
     8213       .
     8214     end.
     8215   end.
     8216   if line-mode <> 'ОСТАВИТЬ':U then  run UI-on in this-procedure.
     8217   end.
     8218   END PROCEDURE.
     8219   PROCEDURE write-hist :
     8220   define input parameter p-from-macro as logical no-undo .
     8221   define input parameter rs-list-method as character no-undo .
     8222   define input parameter rs-status as character no-undo .
     8223   define input parameter line-mode as character no-undo .
     8224   define variable v-ii as integer no-undo .
     8225   define variable v-temp-seq as integer no-undo .
     8226   if rs-list-method = "single" then do:
     8227     if v-no-hist < 0 then do:
     8228       run create-scn-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8229                                           , input-output v-seq
     8230                                           , input 0
     8231                                           , input get-hist-mode(line-mode)
     8232                                           , input substitute("ТОВАР код &1 &2 &3&4 &5", scn-list.gds-code, scn-list.artic, scn-list.prod-type, scn-list.prod-code, scn-list.gds-name)
     8233                                           , input tot-lns
     8234                                           , input rs-list-method
     8235                                           , input rs-status
     8236                                           , input ('goods':U + chr(3) + string(scn-list.gds-code))
     8237                                           , input '':U
     8238                                           , input ?
     8239                                           ).
     8240     end.
     8241     else do:
     8242       v-temp-seq = v-seq - 1.
     8243       do v-ii = 0 to v-no-hist:
     8244         run create-scn-list-hist in this-procedure(input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     8245                                             , input-output v-temp-seq
     8246                                             , input v-ii
     8247                                             , input get-hist-mode(line-mode)
     8248                                             , input substitute("ТОВАР код &1 &2 &3&4 &5", scn-list.gds-code, scn-list.artic, scn-list.prod-type, scn-list.prod-code, scn-list.gds-name)
     8249                                             , input tot-lns
     8250                                             , input '':U
     8251                                             , input '':U
     8252                                             , input ('goods':U + chr(3) + string(scn-list.gds-code))
     8253                                             , input '':U
     8254                                             , input ?
     8255                                             ).
     8256       end.
     8257     end.
     8258   end.
     8259   else do:
     8260     v-temp-seq = v-seq - 1.
     8261     do v-ii = 0 to v-no-hist:
     8262       run create-scn-list-hist in this-procedure(input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     8263                                           , input-output  v-temp-seq
     8264                                           , input v-ii
     8265                                           , input get-hist-mode(line-mode)
     8266                                           , input '':U
     8267                                           , input tot-lns
     8268                                           , input rs-list-method
     8269                                           , input '':U
     8270                                           , input '':U
     8271                                           , input '':U
     8272                                           , input ?
     8273                                           ).
     8274     end.
     8275   end.
     8276   END PROCEDURE.
     8277   procedure list_inf-local:
     8278   define variable glog as logical no-undo .
     8279   for each tt-goods:
     8280     delete tt-goods.
     8281   end.
     8282   for each tt-clients:
     8283     delete tt-clients.
     8284   end.
     8285   for each scn-list:
     8286   find ub.goods where ub.goods.artic     = scn-list.artic     and
     8287                   ub.goods.prod-type = scn-list.prod-type and
     8288                   ub.goods.prod-code = scn-list.prod-code no-lock.
     8289       create tt-goods.
     8290       buffer-copy ub.goods to tt-goods.
     8291   end.
     8292   create tt-clients.
     8293   assign tt-clients.obj-type = p-curr-obj-type
     8294         tt-clients.obj-code = p-curr-obj-code.
     8295   define variable vss-include-info57 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8296   do:
     8297     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8298       (input  v-cntxt-db-num
     8299       ,input  v-cntxt-userid
     8300       ,input  0
     8301       ,input  'actn_reference_archive':U
     8302       ,input  'global':U
     8303       ,input  0
     8304       ,input  '':U
     8305       ,input  0
     8306       ,input  0
     8307       ,input  0
     8308       ,input  0
     8309       ,input  true
     8310       ,output glog
     8311       )  .
     8312   end.
     8313   if glog then run arc/gds_inf.w
     8314   (input  parparentproc
     8315   ,input  v-cntxt-obj-type
     8316   ,input  v-cntxt-obj-code ).
     8317   end procedure.
     8318   FUNCTION stat-line RETURNS CHARACTER(input p-status-chr as character):
     8319   DEFINE VARIABLE var-stat-line as character no-undo .
     8320   CASE p-status-chr:
     8321     when 'все':U then do:
     8322       assign
     8323       var-stat-line = "(текущие и неактивные товары)"
     8324       .
     8325     end.
     8326     when 'текущие':U then do:
     8327       assign
     8328       var-stat-line = "(текущие товары)"
     8329       .
     8330     end.
     8331     when 'удаленные':U then do:
     8332       assign
     8333       var-stat-line = "(неактивные товары)"
     8334       .
     8335     end.
     8336   END CASE.
     8337   return var-stat-line .
     8338   END.
     8339   procedure proc-vc-rs-list-method :
     8340   define variable v-operation as integer no-undo .
     8341   define variable glog as logical no-undo .
     8342   define variable ii as integer no-undo .
     8343   define variable v-recs as integer no-undo .
     8344   define variable v-line as integer no-undo .
     8345   define variable v-item as character no-undo .
     8346   define variable v-tbl-name as character no-undo .
     8347   define variable v-bh as handle no-undo .
     8348   define variable v-tot-lns as integer no-undo .
     8349   define variable v-grp-rec as recid no-undo .
     8350   define variable v-ref-rec as recid no-undo .
     8351   define variable v-dopstr as character no-undo .
     8352   define variable v-input-output as character no-undo .
     8353   define variable v-doc-rec as recid no-undo .
     8354   define variable v-temp-seq as integer no-undo .
     8355   define variable v-message as character no-undo .
     8356   define variable grp-path as character no-undo .
     8357   define variable v-rid-list as character no-undo .
     8358   define variable v-uniq-key-rec as character no-undo .
     8359   define buffer buf_scn-list-hist for scn-list-hist.
     8360   define buffer buf_clob-bind for ub.clob-bind.
     8361   do
     8362   on error undo, return error
     8363   :
     8364     v-no-hist = - 1.
     8365     if temp-list.fvalue = "single" then
     8366     run UI-on in this-procedure.
     8367     else do:
     8368       v-no-hist = 0.
     8369       case rs-list-method:
     8370         when "all" then do:
     8371           glog = yes.
     8372           message "Все товары из справочника товаров"
     8373           skip stat-line(rs-status)
     8374           view-as alert-box question buttons OK-Cancel update glog.
     8375           if not glog then do:
     8376             run UI-on in this-procedure.
     8377             return error .
     8378           end.
     8379           v-no-hist = 1.
     8380           run create-scn-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8381                                               , input-output v-seq
     8382                                               , input 0
     8383                                               , input '':U
     8384                                               , input substitute('Все товары &1', stat-line(rs-status))
     8385                                               , input tot-lns
     8386                                               , input rs-list-method
     8387                                               , input rs-status
     8388                                               , input 'all':U
     8389                                               , input '':U
     8390                                               , input ?
     8391                                               ).
     8392         end.
     8393         when "gds-grp" or
     8394         when "goods" or
     8395         when "gds-obj":U or
     8396         when "gds-obj-fact":U or
     8397         when "gds-obj-free":U or
     8398         when "no-recipe-gds":U
     8399         then do:
     8400           if rs-list-method = "gds-grp" or rs-list-method = "no-recipe-gds" then do:
     8401             glog = yes.
     8402             message "1 или несколько групп товаров"
     8403             skip stat-line(rs-status)
     8404             view-as alert-box question buttons OK-Cancel update glog.
     8405             if not glog then do:
     8406               run UI-on in this-procedure.
     8407               return error.
     8408             end.
     8409             grp-list = "".
     8410             ref-list = "".
     8411             run ref/gds-grp.w (input parparentproc
     8412                           ,input "b-sel,b-mark"
     8413                           ,input p-curr-obj-type
     8414                           ,input p-curr-obj-code
     8415                           ,input-output grp-list).
     8416           end.
     8417           else do:
     8418             glog = yes.
     8419             message "1 или несколько произвольных товаров из справочника."
     8420             skip stat-line(rs-status)
     8421             view-as alert-box question buttons OK-Cancel update glog.
     8422             if not glog then do:
     8423               run UI-on in this-procedure.
     8424               return error.
     8425             end.
     8426             run ref/gds-ref.p ( parparentproc
     8427                             ,"b-sel,b-mark,b-add"
     8428                             ,?
     8429                             ,?
     8430                             ,(if rs-list-method = "goods"
     8431                               then 'все':U
     8432                               else (if rs-list-method = "gds-obj":U
     8433                                     then 'объект':U
     8434                                     else (if rs-list-method = "gds-obj-fact":U
     8435                                           then 'факт':U
     8436                                           else (if rs-list-method = "gds-obj-free":U
     8437                                                 then 'свободно':U
     8438                                                 else ?
     8439                                                 )
     8440                                           )
     8441                                     )
     8442                             )
     8443                             ,?
     8444                             ,?
     8445                             ,?
     8446                             ,?
     8447                             ,p-curr-obj-type
     8448                             ,p-curr-obj-code
     8449                             ,?
     8450                             , output ref-list).
     8451             grp-list = ?.
     8452           end.
     8453           if grp-list <> ? and
     8454           grp-list <> "" then do:
     8455             v-recs = num-entries (grp-list).
     8456             do num-rec = 0 to v-recs:
     8457               if v-recs = 1 then do:
     8458                 num-rec = 1 .
     8459               end.
     8460               if num-rec > 0 then do:
     8461                 v-grp-rec = integer (entry (num-rec, grp-list)).
     8462                 find ub.gds-grp where recid (ub.gds-grp) = v-grp-rec no-lock.
     8463                 run grplib-get-full-name in this-procedure (ub.gds-grp.node-code, output grp-path).
     8464               end.
     8465               if v-recs = 1 then do:
     8466                 assign
     8467                 v-temp-seq = v-seq
     8468                 v-line     = 0
     8469                 dsp-rs = substitute("Группа : &1 &3", grp-path, stat-line(rs-status))
     8470                 v-item     = '':U
     8471                 v-tbl-name = 'gds-grp':U
     8472                 v-bh       = buffer ub.gds-grp:handle
     8473                 v-tot-lns = tot-lns
     8474                 .
     8475               end.
     8476               else do:
     8477                 if num-rec = 0 then do:
     8478                   assign
     8479                   v-temp-seq = v-seq
     8480                   v-line     = 0
     8481                   dsp-rs = substitute("Группы : &1", stat-line(rs-status))
     8482                   v-item     = '':U
     8483                   v-tbl-name = '':U
     8484                   v-bh       = ?
     8485                   v-tot-lns = tot-lns
     8486                   .
     8487                 end.
     8488                 else do:
     8489                   assign
     8490                   v-temp-seq = v-seq - 1
     8491                   v-line     = num-rec
     8492                   dsp-rs = substitute("&1", grp-path)
     8493                   v-item     = '':U
     8494                   v-tbl-name = 'gds-grp':U
     8495                   v-bh       = buffer ub.gds-grp:handle
     8496                   v-tot-lns = tot-lns + num-rec
     8497                   .
     8498                 end.
     8499               end.
     8500               v-no-hist = (if num-rec = 1 then 0 else num-rec).
     8501               run create-scn-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8502                                                   , input-output v-temp-seq
     8503                                                   , input v-line
     8504                                                   , input '':U
     8505                                                   , input dsp-rs
     8506                                                   , input v-tot-lns
     8507                                                   , input rs-list-method
     8508                                                   , input rs-status
     8509                                                   , input v-item
     8510                                                   , input v-tbl-name
     8511                                                   , input v-bh
     8512                                                   ).
     8513               if num-rec = 0 or v-recs = 1 then v-seq  = v-temp-seq.
     8514             end.
     8515           end.
     8516           else if ref-list <> "" then do:
     8517             v-recs = num-entries (ref-list).
     8518             do num-rec = 0 to v-recs:
     8519               if v-recs = 1 then do:
     8520                 num-rec = 1 .
     8521               end.
     8522               if num-rec > 0 then do:
     8523                 v-ref-rec = integer (entry (num-rec, ref-list)).
     8524                 find ub.goods where recid (ub.goods) = v-ref-rec no-lock.
     8525               end.
     8526               if v-recs = 1 then do:
     8527                 assign
     8528                 v-temp-seq = v-seq
     8529                 v-line     = 0
     8530                 dsp-rs = substitute("Товар :&1 &2", ub.goods.gds-name, stat-line(rs-status))
     8531                 v-item     = '':U
     8532                 v-tbl-name = 'goods':U
     8533                 v-bh       = buffer goods:handle
     8534                 v-tot-lns = tot-lns
     8535                 .
     8536               end.
     8537               else do:
     8538                 if num-rec = 0 then do:
     8539                   assign
     8540                   v-temp-seq = v-seq
     8541                   v-line     = 0
     8542                   dsp-rs = substitute("Товары : &1", stat-line(rs-status))
     8543                   v-item     = '':U
     8544                   v-tbl-name = '':U
     8545                   v-bh       = ?
     8546                   v-tot-lns = tot-lns
     8547                   .
     8548                 end.
     8549                 else do:
     8550                   assign
     8551                   v-temp-seq = v-seq - 1
     8552                   v-line     = num-rec
     8553                   dsp-rs = substitute("код &1 &2 &3&4 &5", goods.gds-code, goods.artic, goods.prod-type, goods.prod-code, goods.gds-name)
     8554                   v-item     = '':U
     8555                   v-tbl-name = 'goods':U
     8556                   v-bh       = buffer ub.goods:handle
     8557                   v-tot-lns = tot-lns + num-rec
     8558                   .
     8559                 end.
     8560               end.
     8561               v-no-hist = (if num-rec = 1 then 0 else num-rec).
     8562               run create-scn-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8563                                                   , input-output v-temp-seq
     8564                                                   , input v-line
     8565                                                   , input '':U
     8566                                                   , input dsp-rs
     8567                                                   , input v-tot-lns
     8568                                                   , input rs-list-method
     8569                                                   , input rs-status
     8570                                                   , input v-item
     8571                                                   , input v-tbl-name
     8572                                                   , input v-bh
     8573                                                   ).
     8574               if num-rec = 0 or v-recs = 1 then v-seq  = v-temp-seq.
     8575             end.
     8576           end.
     8577           else do:
     8578             run UI-on in this-procedure.
     8579             return error.
     8580           end.
     8581         end.
     8582         when "grp-prod" or
     8583         when "producer" then do:
     8584           if rs-list-method = "grp-prod" then do:
     8585             glog = yes.
     8586             message "товары по производителям из 1 или нескольких групп."
     8587             skip stat-line(rs-status)
     8588             view-as alert-box question buttons OK-Cancel update glog.
     8589             if not glog then do:
     8590               run UI-on in this-procedure.
     8591               return error.
     8592             end.
     8593             grp-list = "".
     8594             ref-list = "".
     8595             run ref/cli-grps.w ( input parparentproc
     8596                                 ,input "b-sel,b-mark"
     8597                                 ,input-output grp-list).
     8598           end.
     8599           else do:
     8600             glog = yes.
     8601             message "товары по 1 или нескольким производителям из справочника."
     8602             skip stat-line(rs-status)
     8603             view-as alert-box question buttons OK-Cancel update glog.
     8604             if not glog then do:
     8605               run UI-on in this-procedure.
     8606               return error.
     8607             end.
     8608             grp-list = "".
     8609             run ref/cli-all.w ( parparentproc
     8610                           ,"b-sel,b-mark"
     8611                           , ?
     8612                           , ?
     8613                           , ?
     8614                           , ?
     8615                           , ?
     8616                           , ?
     8617                           , output ref-list) .
     8618           end.
     8619           if grp-list <> ? and
     8620           grp-list <> "" then do:
     8621             v-recs = num-entries (grp-list).
     8622             do num-rec = 0 to v-recs:
     8623               if v-recs = 1 then do:
     8624                 num-rec = 1 .
     8625               end.
     8626               if num-rec > 0 then do:
