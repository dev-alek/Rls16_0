     3753     end.
     3754   end.
     3755     assign
     3756       f-name = "default.gds"
     3757       glog = yes
     3758       .
     3759     system-dialog get-file f-name
     3760       filters "Списки товаров *.gds" "*.gds"
     3761       ask-overwrite
     3762       save-as
     3763       use-filename
     3764       update glog
     3765       default-extension "gds".
     3766     if not glog then do:
     3767       apply "entry" to br-list in frame Dialog-Frame.
     3768       return no-apply.
     3769     end.
     3770     output to value (f-name).
     3771     for each scn-list:
     3772       export scn-list.prod-type
     3773             scn-list.prod-code
     3774             scn-list.artic
     3775             scn-list.qnty
     3776             .
     3777     end.
     3778     output close.
     3779   END.
