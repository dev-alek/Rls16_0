    11282   PROCEDURE trig-dis-gds-rule :
    11283   define variable v-rid-list as character no-undo .
    11284   define variable v-pos-type as character no-undo .
    11285   define variable v-templ-rl-root as integer no-undo .
    11286   define variable v-time-templ-rl-root as integer no-undo .
    11287   define variable v-cfg-nonunique as character no-undo .
    11288   define variable v-nonunique as character no-undo .
    11289   define variable v-discnt-role as character no-undo .
    11290   define variable v-obj-type as character no-undo .
    11291   define variable v-obj-code as integer no-undo .
    11292   define variable r-b-code as integer no-undo .
    11293   define variable v-sts as integer no-undo .
    11294   define variable glog as logical no-undo .
    11295   define variable v-mode as character no-undo .
    11296   define variable v-item as character no-undo .
    11297   define variable v-rule-num as integer no-undo .
    11298   define variable dflt-cd as character no-undo .
    11299   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
    11300   define buffer buf_dis-rule for ub.dis-rule.
    11301   if v-cntxt-obj-type = 'скл':U then do:
    11302     dflt-cd = '-':U.
    11303   end.
    11304   else do:
    11305   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11306   define variable v-param-type72 as character no-undo .
    11307   define variable v-value-date72 as date no-undo .
    11308   define variable v-value-decimal72 as decimal no-undo .
    11309   define variable v-value-integer72 as INTEGER no-undo .
    11310   define variable v-value-logical72 AS LOGICAL no-undo .
    11311   define variable v-tth72 as handle no-undo .
    11312   run adm/shattri.p (
    11313       input "get":U
    11314       ,input  v-cntxt-obj-type
    11315       ,input  v-cntxt-obj-code
    11316       ,input  'cd-sending':U
    11317       ,input  'dflt-cd':U
    11318       ,output dflt-cd
    11319       ,output v-value-date72
    11320       ,output v-value-decimal72
    11321       ,output v-value-integer72
    11322       ,output v-value-logical72
    11323       ,output v-param-type72
    11324       ,INPUT-OUTPUT table-handle v-tth72
    11325       )  .
    11326   delete object v-tth72 no-error.
    11327     assign
    11328     v-pos-type = dflt-cd + chr(44) + '-':U + chr(44) + 'bo':U.
    11329   end.
    11330   run ref/dis-pos.w ( INPUT parparentproc
    11331                       ,INPUT "b-sel":U
    11332                       ,INPUT (if rs-list-method = "dis-gds-rule"
    11333                              then "cd-type-list-without-template-pos"
    11334                              else "cd-type-list")
    11335                       ,INPUT 1
    11336                       ,INPUT 1
    11337                       ,INPUT 1
    11338                       ,input 'dis-gds-rule':U
    11339                       ,input '':U
    11340                       ,input ?
    11341                       ,INPUT v-pos-type
    11342                       ,input '':U
    11343                       ,INPUT-OUTPUT v-rid-list) NO-ERROR.
    11344   IF ERROR-STATUS:ERROR
    11345   OR v-rid-list = '':U THEN DO:
    11346     RETURN.
    11347   END.
    11348   FIND FIRST buf_dis-cfg-rule NO-LOCK where
    11349             recid(buf_dis-cfg-rule) = INTEGER(v-rid-list).
    11350   assign
    11351   v-templ-rl-root = buf_dis-cfg-rule.templ-rl-root
    11352   v-time-templ-rl-root = buf_dis-cfg-rule.time-templ-rl-root
    11353   V-cfg-NONUNIQUE = buf_dis-cfg-rule.nonunique
    11354   v-discnt-role = buf_dis-cfg-rule.discnt-role
    11355   .
    11356   if rs-list-method = "dis-gds-rule" then do:
    11357     message
    11358     "Все товары со скидкой типа" entry (lookup (buf_dis-cfg-rule.discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u) skip
    11359     stat-line(rs-status)
    11360     view-as alert-box question buttons OK-Cancel update glog.
    11361   end.
    11362   else do:
    11363     message
    11364     "Все товары со скидкой типа" entry (lookup (buf_dis-cfg-rule.discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u) "и определенным номером правила скидки" skip
    11365     stat-line(rs-status)
    11366     view-as alert-box question buttons OK-Cancel update glog.
    11367   end.
    11368   if not glog then do:
    11369     return error.
    11370   end.
    11371   if (buf_dis-cfg-rule.has-global +
    11372       buf_dis-cfg-rule.has-host +
    11373       buf_dis-cfg-rule.has-obj) > 1 then do:
    11374     define variable v-sel-vals as character no-undo .
    11375     define variable v-sel-labels as character no-undo .
    11376     define variable var-region as character no-undo .
    11377     assign
    11378     v-sel-vals = v-sel-vals +
    11379                   (if buf_dis-cfg-rule.has-global = 1
    11380                   then (fill(chr(32), 3)  + string(0) + chr(4) )
    11381                   else "":U)
    11382     v-sel-labels = v-sel-labels +
    11383                   (if buf_dis-cfg-rule.has-global  = 1
    11384                   then ("Глобально" + chr(4) )
    11385                   else "":U)
    11386     .
    11387     assign
    11388     v-sel-vals = v-sel-vals +
    11389                   (if buf_dis-cfg-rule.has-host = 1
    11390                   then ('орг':U  + string(v-cntxt-host-code-obj)  + chr(4) )
    11391                   else "":U)
    11392     v-sel-labels = v-sel-labels +
    11393                   (if buf_dis-cfg-rule.has-host = 1
    11394                   then ("Фирма"  + string(v-cntxt-host-code-obj) + chr(4) )
    11395                   else "":U)
    11396     .
    11397     assign
    11398     v-sel-vals = v-sel-vals +
    11399                   (if buf_dis-cfg-rule.has-obj = 1
    11400                   then (v-cntxt-obj-type  + string(v-cntxt-obj-code)  + chr(4) )
    11401                   else "":U)
    11402     v-sel-labels = v-sel-labels +
    11403                   (if buf_dis-cfg-rule.has-obj = 1
    11404                   then (v-cntxt-obj-type  + string(v-cntxt-obj-code)  + chr(4) )
    11405                   else "":U)
    11406     .
    11407     run gbl/d-list.w (
    11408                         input "b-sel":U
    11409                         ,input "Выберите область действия"
    11410                         ,input v-sel-vals
    11411                         ,input v-sel-labels
    11412                         ,input chr(4)
    11413                         ,input "":U
    11414                         ,output var-region) no-error.
    11415     if error-status:error then do:
    11416       return error.
    11417     end.
    11418     assign
    11419     v-obj-type = substring(var-region, 1, 3)
    11420     v-obj-code = integer(substring(var-region, 4))
    11421     v-sel-obj-type = v-obj-type
    11422     v-sel-obj-code = v-obj-code
    11423     .
    11424   end.
    11425   else do:
    11426     if buf_dis-cfg-rule.has-obj = 1 then do:
    11427   define variable vss-include-info73 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11428   run userobjs_select-one in this-procedure
    11429     (input  parparentproc
    11430     ,input  v-cntxt-db-num
    11431     ,input  v-cntxt-userid
    11432     ,input  v-cntxt-host-code-obj
    11433     ,input  v-cntxt-obj-type
    11434     ,input  v-cntxt-obj-code
    11435     ,output v-user-select
    11436     ,output v-sel-obj-type
    11437     ,output v-sel-obj-code
    11438     )  .
    11439       if not v-user-select then do:
    11440         return error.
    11441       end.
    11442       assign
    11443       v-obj-type = v-sel-obj-type
    11444       v-obj-code = v-sel-obj-code
    11445       .
    11446     end.
    11447     if buf_dis-cfg-rule.has-host = 1 then do:
    11448       define variable v-host-code as integer no-undo .
    11449       assign
    11450       v-obj-type = 'орг':U
    11451       v-obj-code = v-cntxt-host-code-obj
    11452       .
    11453     end.
    11454     if buf_dis-cfg-rule.has-glob = 1 then do:
    11455       assign
    11456       v-obj-type = '':U
    11457       v-obj-code = 0
    11458       .
    11459     end.
    11460   end.
    11461   if rs-list-method = "dis-gds-rule" then do:
    11462     assign
    11463     dsp-rs = substitute("ВСЕ товары с установленным типом скидки &1 &2"
    11464                       , get-objregion(v-obj-type, v-obj-code), stat-line(rs-status))
    11465     v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code) + chr(3) + v-discnt-role   .
    11466   end.
    11467   else do:
    11468     v-mode = (if v-obj-type = 'маг':U
    11469               or v-obj-type = 'скл':U
    11470               then "upper-rule-num-object":u
    11471               else ('dis-gds-rule':U + "=" + v-discnt-role)).
    11472     run ref/dis-ruls.w (
    11473                  input parparentproc
    11474                 ,input 0
    11475                 ,input v-obj-type
    11476                 ,input v-obj-code
    11477                 ,input "b-add,b-sel":U
    11478                 ,input v-mode
    11479                 ,input v-templ-rl-root
    11480                 ,input v-time-templ-rl-root
    11481                 ,input r-b-code
    11482                 ,input-output v-sts
    11483                 ,input-output v-rid-list ) no-error .
    11484     if v-rid-list = '':u then do:
    11485       return error.
    11486     end.
    11487     find first buf_dis-rule no-lock where
    11488              recid(buf_dis-rule) = integer(v-rid-list) no-error.
    11489     if available buf_dis-rule then do:
    11490     assign
    11491     dsp-rs = substitute("ВСЕ товары с установленным типом скидки: &1, № правила &2 &3"
    11492                         ,get-objregion(v-obj-type, v-obj-code)
    11493                         ,v-rule-num
    11494                         ,stat-line(rs-status))
    11495     v-item = v-sel-obj-type + chr(3) +
    11496               string(v-sel-obj-code) + chr(3) +
    11497                 v-discnt-role + chr(3) + string(buf_dis-rule.rule-num)
    11498     .
    11499   end.
    11500     else do:
    11501       message
    11502       substitute("Не найдено провило скидки с recid &1", v-rid-list)
    11503       view-as alert-box error .
    11504       return error.
    11505     end.
    11506   end.
    11507   v-no-hist = 0.
    11508   run create-scn-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    11509                                       , input-output v-seq
    11510                                       , input 0
    11511                                       , input '':U
    11512                                       , input dsp-rs
    11513                                       , input tot-lns
    11514                                       , input rs-list-method
    11515                                       , input rs-status
    11516                                       , input v-item
    11517                                       , input '':U
    11518                                       , input ?
    11519                                       ).
    11520   END PROCEDURE.
    11521   procedure proc-scn-tsd :
    11522   define variable glog as logical no-undo .
    11523   define buffer buf_scn-list-hist for scn-list-hist.
    11524     do
    11525     on error undo, return error
    11526     :
    11527     assign
    11528       f-name = "default.inv"
    11529       glog = yes
    11530       .
    11531     system-dialog get-file f-name
    11532       filters "Инвентаризация касса *.inv" "*.inv"
    11533       ask-overwrite
    11534       save-as
    11535       use-filename
    11536       update glog
    11537       default-extension "inv".
    11538     if not glog then do:
    11539       apply "entry" to br-list in frame Dialog-Frame.
    11540       return no-apply.
    11541     end.
    11542     run waitfram-show in this-procedure ("Сохранение в формате мобильного сканера.    ЖДИТЕ...").
    11543     output stream PrnLibStream to value (f-name).
    11544     for each scn-list,
    11545         each ub.gds-prt where ub.gds-prt.upper-code = scn-list.prt-root no-lock,
    11546         each ub.bar-code where ub.bar-code.gds-code = scn-list.gds-code
    11547                         and ub.bar-code.unit-cli = scn-list.unit-base
    11548                         and ub.bar-code.node-code = ub.gds-prt.node-code
    11549                         and ub.bar-code.in-code = ""
    11550                         and ub.bar-code.part-code = "" no-lock:
    11551       if scn-list.qnty <> 0 then
    11552         put stream PrnLibStream unformatted string (ub.bar-code.b-code) + "," + string (scn-list.qnty) skip.
    11553     end.
    11554     output stream PrnLibStream close.
    11555     run waitfram-hide in this-procedure .
    11556     end.
    11557   end procedure.
    11558   procedure proc-macros :
    11559   define variable glog as logical no-undo .
    11560   define variable v-option as integer no-undo .
    11561   define buffer buf_scn-list-hist for scn-list-hist.
    11562   define buffer buf_macro-list-hist for macro-list-hist.
    11563   if can-find(first macro-list-hist) then do:
    11564     run gbl/d-askw.w ( input "Сохранение макроса"
    11565                   ,input "Выберите какие действия по формированию списка Вы хотите сохранить"
    11566                   ,input "|"
    11567                   ,input "Посл.ЗАПИСЬ|Все|Отказ"
    11568                   ,input "Действия при нажатой кнопке ЗАПИСЬ|ВСЯ последовательность действий|Отказ"
    11569                   ,input 1
    11570                   ,input 3
    11571                   ,output v-option).
    11572     if v-option = 3 then return no-apply.
    11573     v-option = 1.
    11574   end.
    11575   else do:
    11576     message
    11577     "Будет сохранена в файл ВСЯ последовательность действий по формированию списка" skip
    11578     view-as alert-box question buttons yes-no update glog.
    11579     v-option = 2.
    11580     if not glog then do:
    11581       return no-apply.
    11582     end.
    11583   end.
    11584     do
    11585     on error undo, return error
    11586     :
    11587     assign
    11588       f-name = "default.gdm"
    11589       glog = yes
    11590       .
    11591     system-dialog get-file f-name
    11592       filters "Макрос создания списка товара *.gdm" "*.gdm"
    11593       ask-overwrite
    11594       save-as
    11595       use-filename
    11596       update glog
    11597       default-extension "gdm".
    11598     if not glog then do:
    11599       apply "entry" to br-list in frame Dialog-Frame.
    11600       return no-apply.
    11601     end.
    11602     run waitfram-show in this-procedure ("Сохранение макроса формирования списка товара.    ЖДИТЕ...").
    11603     output stream PrnLibStream to value (f-name).
    11604     case v-option:
    11605       when 1 then do:
    11606         for each buf_macro-list-hist:
    11607           export stream PrnLibStream
    11608           buf_macro-list-hist.
    11609         end.
    11610       end.
    11611       when 2 then do:
    11612     for each buf_scn-list-hist:
    11613         export stream PrnLibStream
    11614         buf_scn-list-hist.
    11615     end.
    11616       end.
    11617     end case.
    11618     output stream PrnLibStream close.
    11619     run waitfram-hide in this-procedure .
    11620     end.
    11621   end procedure.
    11622   PROCEDURE trig-tax-rate-value :
    11623   define input parameter p-rs-list-method as character no-undo .
    11624   define output parameter p-date as date no-undo .
    11625   DEFINE VARIABLE v-codes          as character           no-undo.
    11626   DEFINE VARIABLE v-labels         as character           no-undo.
    11627   DEFINE VARIABLE v-type           as character           no-undo.
    11628   DEFINE VARIABLE v-format         as character           no-undo.
    11629   DEFINE VARIABLE v-values         as character           no-undo.
    11630   DEFINE VARIABLE v-code-output    as character           no-undo.
    11631   DEFINE VARIABLE v-value-output   as character           no-undo.
    11632   define variable vlabel           as character           no-undo .
    11633   define variable v-date-chr       as character           no-undo .
    11634   DEFINE VARIABLE v-time           as integer             no-undo .
    11635   DEFINE VARIABLE v-ref-list           as character           no-undo .
    11636   DEFINE VARIABLE jj                   as integer             no-undo .
    11637   define variable glog as logical no-undo .
    11638   assign
    11639   v-attr-code = ""
    11640   vvalue = ""
    11641   v-codes = '1':U + chr(4) + '2':U
    11642   v-labels = "НДС" + chr(4) +  "НП"
    11643   v-values = "0" + chr(4) + "0"
    11644   v-format = ">9.99":U + chr(4) + ">9.99":U
    11645   v-type = 'D':U + chr(4) + 'D':U
    11646   .
    11647   run gbl/d-listv.w (
    11648                  "b-mark,b-sel":U
    11649                 ,"Выберите налоги"
    11650                 , v-codes
    11651                 , v-labels
    11652                 , v-values
    11653                 , v-format
    11654                 , v-type
    11655                 , chr(4)
    11656                 , "":U
    11657                 , output v-attr-code
    11658                 , output vvalue
    11659                 ).
    11660   if v-attr-code = "" then do:
    11661     return error.
    11662   end.
    11663   do jj = 1 to num-entries(v-attr-code, chr(4)):
    11664     assign
    11665     vlabel = vlabel + entry(LOOKUP(entry(jj, v-attr-code, chr(4)), v-codes, chr(4)), v-labels, chr(4)) + "=":U + entry(jj, vvalue, chr(4)) + chr(10)
    11666     .
    11667   end.
    11668   run cur-time in this-procedure(output p-date, output v-time).
    11669   assign
    11670   v-date-chr = string(p-date, "99/99/9999":U)
    11671   .
    11672   run gbl/d-prompt.w (
    11673     'title=':u + "Введите дату значения налогов" + '\':u
    11674   + 'text1=':u + "Дата" + '\':u
    11675   + 'format=' + "99/99/9999" + '\':u
    11676   + 'type=' + 'T':U + '\':u
    11677   + 'fillin_row=2\':u
    11678   + 'fillin_col=4\':u
    11679   + 'fillin_width=20\':u
    11680   + 'fillin_height=1\':u
    11681   + 'max-chars=70\':u
    11682   + 'readonly=no' + '\':u
    11683   , input-output v-date-chr
    11684   ).
    11685   if return-value = 'false':u then return error.
    11686   assign
    11687   p-date = date( integer(substr(v-date-chr, 4, 2))
    11688                 ,integer(substr(v-date-chr, 1, 2))
    11689                 ,integer(substr(v-date-chr, 7, 4))
    11690                )
    11691   no-error .
    11692   if error-status:error then return error.
    11693   define variable vss-include-info74 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11694   run userobjs_select-one in this-procedure
    11695     (input  parparentproc
    11696     ,input  v-cntxt-db-num
    11697     ,input  v-cntxt-userid
    11698     ,input  v-cntxt-host-code-obj
    11699     ,input  v-cntxt-obj-type
    11700     ,input  v-cntxt-obj-code
    11701     ,output v-user-select
    11702     ,output v-sel-obj-type
    11703     ,output v-sel-obj-code
    11704     )  .
    11705   if not v-user-select then do:
    11706     return error.
    11707   end.
    11708   glog = yes.
    11709   if p-rs-list-method = "tax-rate-value":U then do:
    11710     message
    11711     "Все товары с заданными значениями налогов на объекте на дату" v-date-chr skip
    11712     vlabel skip
    11713     stat-line(rs-status)
    11714     view-as alert-box question buttons OK-Cancel update glog.
    11715   end.
    11716   if p-rs-list-method = "tax-rate-value-obj":U then do:
    11717     message
    11718     "Товары объекта с заданными значениями налогов на объекте на дату" v-date-chr skip
    11719     vlabel skip
    11720     stat-line(rs-status)
    11721     view-as alert-box question buttons OK-Cancel update glog.
    11722   end.
    11723   if not glog then do:
    11724     return error.
    11725   end.
    11726   if p-rs-list-method = "tax-rate-value":U then do:
    11727     dsp-rs = substitute("ВСЕ товары с заданными значениями налогов на объекте &1 на дату &2 &3", vlabel, p-date, stat-line(rs-status)).
    11728   end.
    11729   if p-rs-list-method = "tax-rate-value-obj":U then do:
    11730     dsp-rs = substitute("Товары объекта &1 с заданными значениями налогов на объекте &2 на дату &3 &4", vlabel, vlabel, p-date, stat-line(rs-status)).
    11731   end.
    11732   run create-scn-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    11733                                       , input-output v-seq
    11734                                       , input 0
    11735                                       , input '':U
    11736                                       , input dsp-rs
    11737                                       , input tot-lns
    11738                                       , input rs-list-method
    11739                                       , input rs-status
    11740                                       , input v-sel-obj-type + chr(3) + string(v-sel-obj-code) + chr(3) +
    11741                                               string(p-date, "99/99/9999") + chr(3) + v-attr-code + chr(3) + vvalue
    11742                                       , input '':U
    11743                                       , input ?
    11744                                       ).
    11745   END PROCEDURE.
    11746   procedure proc-b-add :
    11747   define input parameter p-from-macro as logical no-undo .
    11748   define input parameter p-rowid as rowid no-undo .
    11749   define input parameter rs-list-method as character no-undo .
    11750   define input parameter rs-status as character no-undo .
    11751     do
    11752     on error undo, return error
    11753     :
    11754     line-mode = 'ДОБАВЛЕНИЕ':U.
    11755     if rs-list-method = "single" then do:
    11756        v-no-hist = - 1.
    11757       if p-from-macro then do:
    11758         find ub.goods where rowid(ub.goods) = p-rowid no-lock no-error .
    11759       end.
    11760       else do:
    11761         run ref/gds-ref.p ( parparentproc
    11762                         ,"b-sel,b-add"
    11763                         ,?
    11764                         ,?
    11765                         ,?
    11766                         ,?
    11767                         ,?
    11768                         ,?
    11769                         ,?
    11770                         ,p-curr-obj-type
    11771                         ,p-curr-obj-code
    11772                         ,?
    11773                         , output ref-list).
    11774         apply "entry" to br-list in frame Dialog-Frame.
    11775         if ref-list = "" then
    11776           return no-apply.
    11777         find ub.goods where recid (ub.goods) = integer (ref-list) no-lock.
    11778       end.
    11779       if available goods then do:
    11780         run ex-gds  in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    11781         tot-lns = tot-lns + 1.
    11782         run write-hist in this-procedure ( p-from-macro, rs-list-method, rs-status, line-mode).
    11783       end.
    11784       else do:
    11785         return error "Нет в БД такого товара".
    11786       end.
    11787       run UI-on  in this-procedure.
    11788     end.
    11789     else
    11790       run rs-do  in this-procedure( no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
    11791     end.
    11792   end procedure.
    11793   procedure proc-b-del :
    11794   define input parameter p-from-macro as logical no-undo .
    11795   define input parameter p-rowid as rowid no-undo .
    11796   define input parameter rs-list-method as character no-undo .
    11797   define input parameter rs-status as character no-undo .
    11798   define variable v-rep-rec as recid no-undo .
    11799   define variable glog as logical no-undo .
    11800     do
    11801     on error undo, return error
    11802     :
    11803       line-mode = 'удаление':U.
    11804       if rs-list-method = "single" then do:
    11805         v-no-hist = - 1.
    11806         if p-from-macro then do:
    11807           find first ub.goods where rowid(ub.goods) = p-rowid no-error.
    11808           if not available ub.goods then return error "Нет в БД такого товара".
    11809           find first scn-list where scn-list.gds-code = ub.goods.gds-code no-error.
    11810         end.
    11811         if available scn-list then do:
    11812           line-rec = recid (scn-list).
    11813           get next br-list.
    11814           if available scn-list then v-rep-rec = recid (scn-list).
    11815           else do:
    11816             reposition br-list to recid line-rec no-error.
    11817             get prev br-list.
    11818             if available scn-list then v-rep-rec = recid (scn-list).
    11819           end.
    11820           reposition br-list to recid line-rec no-error.
    11821           tot-lns = tot-lns - 1.
    11822           run write-hist in this-procedure ( p-from-macro, rs-list-method, rs-status, line-mode).
    11823           delete scn-list.
    11824           line-rec = v-rep-rec.
    11825           run UI-on in this-procedure.
    11826         end.
    11827         else do:
    11828           return error "Нет в списке товаров такого товара".
    11829         end.
    11830       end.
    11831       else do:
    11832         glog = no.
    11833         message "Удалить товары ПО заданному УСЛОВИЮ ?   Вы уверены ?"
    11834         view-as alert-box question buttons OK-Cancel update glog.
    11835         if not glog then
    11836           return no-apply.
    11837         run rs-do  in this-procedure( no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
    11838       end.
    11839     end.
    11840   end procedure.
    11841   procedure proc-b-rest :
    11842   define input parameter p-from-macro as logical no-undo .
    11843   define input parameter p-rowid as rowid no-undo .
    11844   define input parameter rs-list-method as character no-undo .
    11845   define input parameter rs-status as character no-undo .
    11846   define buffer buf_scn-list-hist for scn-list-hist.
    11847   define variable glog as logical no-undo .
    11848     do
    11849     on error undo, return error
    11850     :
    11851       line-mode = 'ОСТАВИТЬ':U.
    11852       if rs-list-method = "single" then do:
    11853         v-no-hist = - 1.
    11854         if p-from-macro then do:
    11855           find first ub.goods where rowid(ub.goods) = p-rowid no-error.
    11856           if not available ub.goods then return error substitute("Нет в БД такого товара").
    11857           find first scn-list where scn-list.gds-code = ub.goods.gds-code no-error.
    11858         end.
    11859         if available scn-list then do:
    11860           if p-from-macro then do:
    11861             glog = yes.
    11862           end.
    11863           else do:
    11864             glog = no.
    11865             message "Оставить отмеченную строку и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
    11866             view-as alert-box question buttons OK-Cancel update glog.
    11867             if not glog then return error.
    11868           end.
    11869           line-rec = recid (scn-list).
    11870           v-seq = 1.
    11871           for each buf_scn-list-hist:
    11872             delete buf_scn-list-hist.
    11873           end.
    11874           run write-hist  in this-procedure ( p-from-macro, rs-list-method, rs-status, line-mode).
    11875           for each scn-list:
    11876             if line-rec <> recid (scn-list) then delete scn-list.
    11877           end.
    11878           assign
    11879           tot-lns = 1
    11880           .
    11881           run UI-on  in this-procedure.
    11882         end.
    11883         else do:
    11884           return error substitute("Нет в списке такого товара").
    11885         end.
    11886       end.
    11887       else do:
    11888         glog = no.
    11889         if not p-from-macro then do:
    11890           message "Оставить товары ПО заданному УСЛОВИЮ и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
    11891           view-as alert-box question buttons OK-Cancel update glog.
    11892           if not glog then
    11893             return no-apply.
    11894         end.
    11895         assign
    11896         lns-cnt = 0
    11897         lns-ignore = 0
    11898         .
    11899         run rs-do  in this-procedure ( no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
    11900         for each scn-list:
    11901           if scn-list.to-del = ? then do:
    11902             assign
    11903             scn-list.to-del = no
    11904             .
    11905           end.
    11906           else do:
    11907             delete scn-list.
    11908           end.
    11909         end.
    11910         tot-lns = lns-cnt.
    11911         run UI-on  in this-procedure.
    11912         message
    11913         "Оставлено строк :" lns-cnt skip(0)
    11914         string(if lns-ignore <> 0
    11915         then ("Проигнорировано строк :" + string(lns-ignore))
    11916         else "":U)
    11917         .
    11918       end.
    11919     end.
    11920   end procedure.
    11921   procedure proc-b-obj :
    11922     define input parameter p-mode as character no-undo .
    11923     define buffer buf_clients  for ub.clients.
    11924     do
    11925     on error undo, return error
    11926     :
    11927       if p-mode = "change":U then do:
    11928   define variable vss-include-info75 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11929   run userobjs_select-one in this-procedure
    11930     (input  parparentproc
    11931     ,input  v-cntxt-db-num
    11932     ,input  v-cntxt-userid
    11933     ,input  v-cntxt-host-code-obj
    11934     ,input  v-cntxt-obj-type
    11935     ,input  v-cntxt-obj-code
    11936     ,output v-user-select
    11937     ,output v-sel-obj-type
    11938     ,output v-sel-obj-code
    11939     )  .
    11940       end.
    11941       if v-user-select then do:
    11942         find first buf_clients no-lock where
    11943                    buf_clients.obj-type = v-sel-obj-type
    11944                and buf_clients.obj-code = v-sel-obj-code no-error.
    11945         if not available buf_clients then do: return error. end.
    11946         assign
    11947           p-curr-obj-type = buf_clients.obj-type
    11948           p-curr-obj-code = buf_clients.obj-code
    11949           p-curr-host-code = buf_clients.host-code
    11950           v-obj-type = buf_clients.obj-type
    11951           v-obj-code = buf_clients.obj-code
    11952           v-obj-name = buf_clients.obj-name
    11953         .
    11954         if lookup(bttns, "hide") = 0 then do:
    11955           display
    11956           v-obj-name
    11957           v-obj-type
    11958           v-obj-code
    11959           with frame Dialog-Frame.
    11960         end.
    11961       end.
    11962     end.
    11963   end procedure.
    11964   procedure proc-file-list-methods :
    11965   define input parameter p-from-macro as logical no-undo .
    11966   define input parameter rs-list-method as character no-undo .
    11967   define input parameter rs-status as character no-undo .
    11968   define input parameter line-mode as character no-undo .
    11969   define input parameter p-id      as integer no-undo .
    11970   define variable ss as character no-undo .
    11971   define variable b-c as integer no-undo.
    11972   define variable imp-type like ub.goods.prod-type no-undo.
    11973   define variable imp-code like ub.goods.prod-code no-undo.
    11974   define variable imp-art like ub.goods.artic no-undo.
    11975   define variable imp-doc-code like ub.trn-doc.doc-code no-undo.
    11976   define variable imp-doc-type as character no-undo.
    11977   define variable scan-qnty as dec no-undo.
    11978   define variable bc-qnty as dec no-undo.
    11979   define variable varresult   as character         no-undo.
    11980   define variable vartype-bc  as character         no-undo.
    11981   define variable varweight   as decimal           no-undo.
    11982   define variable v-full-path        as character no-undo .
    11983   define variable v-path             as character no-undo .
    11984   define variable v-file-name        as character no-undo .
    11985   define variable v-file-name-no-ext as character no-undo .
    11986   define variable v-file-name-ext    as character no-undo .
    11987   define variable v-num-add          as integer no-undo .
    11988   define variable v-num-ignored      as integer no-undo .
    11989   define variable v-tbl-row          as rowid no-undo .
    11990   define variable v-tbl-name         as character no-undo .
    11991   define buffer buf_scn-list-hist for scn-list-hist.
    11992   define buffer buf_clob-data for ub.clob-data.
    11993   define buffer buf_clob-bind for ub.clob-bind.
    11994   do
    11995   on error undo, return error
    11996   :
    11997   find first buf_scn-list-hist where
    11998             buf_scn-list-hist.id = p-id
    11999         AND buf_scn-list-hist.item_ <> '':U .
    12000   if rs-list-method = "clob-data" then do:
    12001     run gen-row-keyr in this-procedure (
    12002      input  buf_scn-list-hist.item_
    12003     ,input  ?
    12004     ,input  "ub"
    12005     ,input  ?
    12006     ,input NO-LOCK
    12007     ,output v-tbl-row
    12008     ,output v-tbl-name  ) no-error.
    12009     if error-status :error then do:
    12010       message
    12011       "Ошибка при поиске хранимого файла"
    12012       view-as alert-box error.
    12013       return error.
    12014     end.
    12015     find first buf_clob-bind no-lock where
    12016               rowid(buf_clob-bind) = v-tbl-row .
    12017     find first buf_clob-data no-lock where
    12018               buf_clob-data.db-num = buf_clob-bind.db-num
    12019           and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
    12020     if error-status :error then do:
    12021       message
    12022       "Ошибка при пополучении хранимого файла"
    12023       view-as alert-box error.
    12024       return error.
    12025     end.
    12026     run gbl/_tmpfile.p ( input ""
    12027                   ,input "tmp"
    12028                   ,output v-file-name) .
    12029     copy-lob from object buf_clob-data.cdata
    12030     to file v-file-name.
    12031   end.
    12032   run gbl/filename.p
    12033       (input  (if rs-list-method = "clob-data" then v-file-name else buf_scn-list-hist.item_  )
    12034     ,output v-full-path
    12035     ,output v-path
    12036     ,output v-file-name
    12037     ,output v-file-name-no-ext
    12038     ,output v-file-name-ext
    12039     ) no-error .
    12040     if error-status:error then do: end. else do:
    12041     input stream sout from value (v-full-path).
    12042     CASE rs-list-method:
    12043       when "doc-list" then do:
    12044         message "При чтении количеств из строк документов они в списке будут переписаны.".
    12045         repeat:
    12046           import stream sout imp-doc-code imp-doc-type no-error.
    12047           if imp-doc-type = 'переоценка':U then do:
    12048             find first ub.price-doc No-LOCK WHERE
    12049                       ub.price-doc.doc-num = imp-doc-code No-ERROR.
    12050             if avail(ub.price-doc) then do:
    12051               FOR EACH ub.price-list No-LOCK WHERE
    12052                       ub.price-list.doc-num = ub.price-doc.doc-num,
    12053                   FIRST ub.goods No-LOCK WHERE
    12054                         ub.goods.artic = ub.price-list.artic AND
    12055                         ub.goods.prod-type = ub.price-list.prod-type AND
    12056                         ub.goods.prod-code = ub.price-list.prod-code:
    12057                 run ex-gds  in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12058                 if available scn-list and
    12059                   scn-list.artic = ub.goods.artic and
    12060                   scn-list.prod-type = ub.goods.prod-type and
    12061                   scn-list.prod-code = ub.goods.prod-code then
    12062                   scn-list.qnty = scan-qnty.
    12063               END.
    12064             end.
    12065           end.
    12066           else do:
    12067             find first ub.trn-doc NO-LOCK where
    12068                       ub.trn-doc.doc-code = imp-doc-code No-ERROR.
    12069             if avail(ub.trn-doc) then do:
    12070               FOR EACH ub.doc-line NO-LOCK where
    12071                       ub.doc-line.doc-code = ub.trn-doc.doc-code,
    12072                   FIRST ub.goods where ub.goods.artic = ub.doc-line.artic
    12073                               and ub.goods.prod-type = ub.doc-line.prod-type
    12074                               and ub.goods.prod-code = ub.doc-line.prod-code NO-LOCK:
    12075                 run ex-gds  in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12076                 if available scn-list and
    12077                   scn-list.artic = ub.goods.artic and
    12078                   scn-list.prod-type = ub.goods.prod-type and
    12079                   scn-list.prod-code = ub.goods.prod-code then
    12080                   scn-list.qnty = scan-qnty.
    12081               end.
    12082             end.
    12083           end.
    12084         end.
    12085       end.
    12086       when "prod-list" then do:
    12087         repeat:
    12088           import stream sout imp-type imp-code no-error.
    12089           for each ub.goods where ub.goods.prod-type = imp-type
    12090                       and ub.goods.prod-code = imp-code no-lock:
    12091             run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12092           end.
    12093         end.
    12094       end.
    12095       when "supp-list" then do:
    12096         repeat:
    12097           import stream sout imp-type imp-code no-error.
    12098           for each ub.cli-gds where ub.cli-gds.cli-type = imp-type
    12099                               and ub.cli-gds.cli-code = imp-code
    12100                               and ub.cli-gds.host-code = p-curr-host-code no-lock,
    12101                 first ub.goods where ub.goods.artic = ub.cli-gds.artic
    12102                             and ub.goods.prod-type = ub.cli-gds.prod-type
    12103                             and ub.goods.prod-code = ub.cli-gds.prod-code no-lock:
    12104             run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12105           end.
    12106         end.
    12107       end.
    12108       when "cli-list" then do:
    12109         input stream sout from value (f-cli-name).
    12110         repeat:
    12111           import stream sout imp-type imp-code no-error.
    12112           for each ub.trn-doc where ub.trn-doc.cli-type = imp-type
    12113                             and ub.trn-doc.cli-code = imp-code no-lock:
    12114             for each ub.doc-line where ub.doc-line.doc-code = ub.trn-doc.doc-code no-lock,
    12115                 first ub.goods where ub.goods.artic = ub.doc-line.artic
    12116                               and ub.goods.prod-type = ub.doc-line.prod-type
    12117                               and ub.goods.prod-code = ub.doc-line.prod-code no-lock:
    12118               run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12119             end.
    12120           end.
    12121         end.
    12122       end.
    12123       when "file"
    12124       or when "clob-data"
    12125       then do:
    12126         message "При чтении из файла количеств они в списке будут переписаны.".
    12127         repeat:
    12128           import stream sout imp-type imp-code imp-art scan-qnty no-error.
    12129           find ub.goods where ub.goods.prod-type = imp-type
    12130                       and ub.goods.prod-code = imp-code
    12131                       and ub.goods.artic     = imp-art no-lock no-error.
    12132           if available ub.goods then run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12133           if available ub.goods and  available scn-list and
    12134             scn-list.artic = ub.goods.artic and
    12135             scn-list.prod-type = ub.goods.prod-type and
    12136             scn-list.prod-code = ub.goods.prod-code then
    12137             scn-list.qnty = scan-qnty.
    12138         end.
    12139         if rs-list-method = "clob-data" then do:
    12140           os-delete value(v-full-path) .
    12141         end.
    12142       end.
    12143       when "scaner" then do:
    12144         message "При чтении из файла количеств они будут прибавлены к количествам в списке.".
    12145         repeat:
    12146           import stream sout unformatted ss.
    12147           ss = trim (ss).
    12148           if ss = "" then next.
    12149           if substr (ss, 1, 1) < "0" or substr (ss, 1, 1) > "9" then
    12150             if substr (ss, 1, 4) = "data" then ss = entry (2, ss, ":").
    12151             else next.
    12152           assign
    12153             scan-qnty = dec (entry (2, ss))
    12154             ss = trim (entry (1, ss)).
    12155   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
    12156   (
    12157    input  parparentproc
    12158   ,input  ss
    12159   ,input  ?
    12160   ,input  p-curr-obj-type
    12161   ,input  p-curr-obj-code
    12162   ,input  yes
    12163   ,input  no
    12164   ,input  varscales-pref
    12165   ,input  varpgscales-pref
    12166   ,output varresult
    12167   ,output vartype-bc
    12168   ,output varweight
    12169   ,buffer ub.bar-code
    12170   ,buffer ub.prod-bc
    12171   ,buffer ub.place
    12172   ) no-error.
    12173           if not available ub.bar-code then next.
    12174           bc-qnty = ub.bar-code.cli-base-rate.
    12175           find ub.goods where ub.goods.gds-code = ub.bar-code.gds-code NO-LOCK.
    12176           run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12177           if available scn-list and
    12178             scn-list.artic = ub.goods.artic and
    12179             scn-list.prod-type = ub.goods.prod-type and
    12180             scn-list.prod-code = ub.goods.prod-code then
    12181             scn-list.qnty = scn-list.qnty + scan-qnty * bc-qnty.
    12182         end.
    12183       end.
    12184     END CASE.
    12185     input stream sout close.
    12186     assign                                                           buf_scn-list-hist.num-add  = lns-cnt - v-num-add                       buf_scn-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_scn-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_scn-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
    12187     end.
    12188   end.
    12189   end procedure.
    12190   procedure analysis:
    12191   define input  parameter p-method as character no-undo .
    12192   define variable glog as logical   no-undo .
    12193   define variable v-run as character no-undo .
    12194   define variable an-option as character no-undo .
    12195   define variable v-tbl-name as character no-undo .
    12196   define variable v-bh as handle no-undo .
    12197   define variable v-recs as integer   no-undo .
    12198   define variable v-temp-seq as integer   no-undo .
    12199   define variable v-line as integer   no-undo .
    12200   define variable v-item as character no-undo .
    12201   define variable v-tot-lns as integer   no-undo .
    12202   do
    12203   on error undo, return error return-value
    12204   :
    12205     glog = yes.
    12206     CASE p-method:
    12207       when "abcxyz":U then do:
    12208         assign
    12209         dsp-rs = substitute("Товары ABC/XYZ анализа.&1&2",  stat-line(rs-status))
    12210         v-run = 'ref/abcxyzv.w':U
    12211         an-option = "abcxyz"
    12212         v-tbl-name = 'abcxyz-analysis':U
    12213         v-bh       = buffer ub.abcxyz-analysis:handle
    12214         .
    12215       end.
    12216       when "abc-analysis":U then do:
    12217         assign
    12218         dsp-rs = substitute("Товары ABC анализа.&1&2",  stat-line(rs-status))
    12219         v-run = 'ref/abcanal.w':U
    12220         an-option = "abc"
    12221         v-tbl-name = 'abc-analysis':U
    12222         v-bh       = buffer ub.abc-analysis:Handle
    12223         .
    12224       end.
    12225       when "xyz-analysis":U then do:
    12226         assign
    12227         dsp-rs = substitute("Товары XYZ анализа.&1&2",  stat-line(rs-status))
    12228         v-run = 'ref/xyzanal.w':U
    12229         an-option = "xyz"
    12230         v-tbl-name = 'xyz-analysis':U
    12231         v-bh       = buffer ub.xyz-analysis:Handle
    12232         .
    12233       end.
    12234     END CASE.
    12235     message
    12236     dsp-rs
    12237     view-as alert-box question buttons OK-Cancel update glog.
    12238     if not glog then do:
    12239       run UI-on  in this-procedure.
    12240       return error.
    12241     end.
    12242     run value(v-run)(parparentproc,"b-sel":U, output ref-list).
    12243     if ref-list <> "" then run ref/togabc.w (input an-option, output list-abcxyz).
    12244     if ref-list = "" or list-abcxyz = "" then do:
    12245       run UI-on in this-procedure.
    12246       return error.
    12247     end.
    12248     if num-entries(ref-list) = 1 then do:
    12249       CASE rs-list-method:
    12250         when "abcxyz":U then do:
    12251           find abcxyz-analysis where recid (abcxyz-analysis) = integer(entry(1, ref-list)) no-lock.
    12252           dsp-rs = substitute("ABCXYZ Анализ : &1&2&3"
    12253                               ,abcxyz-analysis.abcx-name
    12254                               , chr(10)
    12255                               , stat-line(rs-status)
    12256                               ).
    12257         end.
    12258         when "abc-analysis":U then do:
    12259           find abc-analysis where recid (abc-analysis) = integer(entry(1, ref-list)) no-lock.
    12260           dsp-rs = substitute("ABC Анализ : &1&2&3"
    12261                               ,abc-analysis.abc-name
    12262                               , chr(10)
    12263                               , stat-line(rs-status)
    12264                               ).
    12265         end.
    12266         when "xyz-analysis":U then do:
    12267           find xyz-analysis where recid (xyz-analysis) = integer(entry(1, ref-list)) no-lock.
    12268           dsp-rs = substitute("XYZ Анализ : &1&2&3"
    12269                               ,xyz-analysis.xyz-name
    12270                               ,chr(10)
    12271                               ,stat-line(rs-status)
    12272                               ).
    12273         end.
    12274       end CASE.
    12275       v-recs = num-entries(list-abcxyz).
    12276       do num-rec = 0 to v-recs:
    12277         if num-rec = 0 then do:
    12278           assign
    12279           v-temp-seq = v-seq
    12280           v-line     = 0
    12281           v-item     = '':U
    12282           v-tot-lns = tot-lns
    12283           .
    12284         end.
    12285         else do:
    12286           assign
    12287           v-temp-seq = v-seq - 1
    12288           v-line     = num-rec
    12289           dsp-rs = substitute("Группа &1", entry(num-rec, list-abcxyz))
    12290           v-item     = entry(num-rec, list-abcxyz)
    12291           v-tbl-name = '':U
    12292           v-bh       = ?
    12293           v-tot-lns = tot-lns + num-rec
    12294           .
    12295         end.
    12296         v-no-hist = (if num-rec = 1 then 0 else num-rec).
    12297         run create-scn-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    12298                                             , input-output v-temp-seq
    12299                                             , input v-line
    12300                                             , input '':U
    12301                                             , input dsp-rs
    12302                                             , input v-tot-lns
    12303                                             , input rs-list-method
    12304                                             , input rs-status
    12305                                             , input v-item
    12306                                             , input v-tbl-name
    12307                                             , input v-bh
    12308                                             ).
    12309         if num-rec = 0 then v-seq  = v-temp-seq.
    12310       end.
    12311     end.
    12312   end.
    12313   end procedure.
    12314   procedure collection :
    12315   define input  parameter p-method as character no-undo .
    12316   define variable glog as logical   no-undo .
    12317   define variable v-run as character no-undo .
    12318   define variable an-option as character no-undo .
    12319   define variable v-tbl-name as character no-undo .
    12320   define variable v-bh as handle no-undo .
    12321   define variable v-recs as integer   no-undo .
    12322   define variable v-temp-seq as integer   no-undo .
    12323   define variable v-line as integer   no-undo .
    12324   define variable v-item as character no-undo .
    12325   define variable v-tot-lns as integer   no-undo .
    12326   do
    12327   on error undo, return error return-value
    12328   :
    12329     glog = yes.
    12330     CASE p-method:
    12331       when "collection":U then do:
    12332         assign
    12333         dsp-rs = substitute("Товары по коллекции.&1&2",  stat-line(rs-status))
    12334         v-run = 'ref/collec.w':U
    12335         an-option = "sea"
    12336         v-tbl-name = 'season'
    12337         v-bh       = buffer ub.season:Handle
    12338         .
    12339       end.
    12340     END CASE.
    12341     message
    12342     dsp-rs
    12343     view-as alert-box question buttons OK-Cancel update glog.
    12344     if not glog then do:
    12345       run UI-on.
    12346       return error.
    12347     end.
    12348     run value(v-run) (parParentProc, "b-sel":U, output ref-list).
    12349     if ref-list = "" then do:
    12350       run UI-on.
    12351       return error.
    12352     end.
    12353     if num-entries(ref-list) = 1 then do:
    12354       CASE rs-list-method:
    12355         when "collection":U then do:
    12356           find ub.season where recid (ub.season) = integer(entry(1, ref-list)) no-lock.
    12357           dsp-rs = substitute("Коллекция : &1&2&3"
    12358                               ,ub.season.sea-name
    12359                               , chr(10)
    12360                               , stat-line(rs-status)
    12361                               ).
    12362         end.
    12363       end CASE.
    12364       v-recs = num-entries(ref-list).
    12365       do num-rec = 0 to v-recs:
    12366         if num-rec = 0 then do:
    12367           assign
    12368           v-temp-seq = v-seq
    12369           v-line     = 0
    12370           v-item     = '':U
    12371           v-tot-lns = tot-lns
    12372           .
    12373         end.
    12374         else do:
    12375           assign
    12376           v-temp-seq = v-seq - 1
    12377           v-line     = num-rec
    12378           v-item     = entry(num-rec, ref-list)
    12379           v-tbl-name = '':U
    12380           v-bh       = ?
    12381           v-tot-lns = tot-lns + num-rec
    12382           .
    12383         end.
    12384         v-no-hist = (if num-rec = 1 then 0 else num-rec).
    12385         run create-scn-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    12386                                             , input-output v-temp-seq
    12387                                             , input v-line
    12388                                             , input '':U
    12389                                             , input dsp-rs
    12390                                             , input v-tot-lns
    12391                                             , input rs-list-method
    12392                                             , input rs-status
    12393                                             , input v-item
    12394                                             , input v-tbl-name
    12395                                             , input v-bh
    12396                                             ).
    12397         if num-rec = 0 then v-seq  = v-temp-seq.
    12398       end.
    12399     end.
    12400   end.
    12401   end procedure.
    12402   procedure object-options :
    12403   define input  parameter p-method as character no-undo .
    12404   define variable glog as logical   no-undo .
    12405   define variable v-message as character no-undo .
    12406   define buffer buf_scn-list-hist for scn-list-hist.
    12407   define buffer buf_user-obj for ub.user-obj.
    12408   do
    12409   on error undo, return error return-value
    12410   :
    12411     glog = yes.
    12412     case p-method:
    12413       when "object" then do:
    12414         assign
    12415         v-message = substitute("Все товары из справочника товаров по объекту.&1&2"
    12416                                 , chr(10)
    12417                                 , stat-line(rs-status))
    12418         dsp-rs    = "Все товары по объекту : &1 &2"
    12419         .
    12420       end.
    12421       when "available"  then do:
    12422           assign
    12423           v-message = substitute("Все товары, остаток которых на объекте > 0.&1&2"
    12424                                 , chr(10)
    12425                                 , stat-line(rs-status))
    12426           dsp-rs =   "ВСЕ товары, имеющиеся в наличии на/в &1 &2"
    12427           .
    12428       end.
    12429       when "neg-rest" then do:
    12430           assign
    12431           v-message = substitute("Все товары с отрицательными остатками на объекте.&1&2"
    12432                                 , chr(10)
    12433                                 , stat-line(rs-status))
    12434           dsp-rs     = "ВСЕ товары с отрицательными остатками на/в &1 &2"
    12435           .
    12436       end.
    12437       when "neg-part" then do:
    12438           assign
    12439           v-message = substitute("Все товары, имеющие отрицательные партии на объекте (остаток при этом может быть любым).&1&2"
    12440                                 , chr(10)
    12441                                 , stat-line(rs-status))
    12442           dsp-rs    = "ВСЕ товары с отрицательными партиями на/в &1 &2"
    12443           .
    12444       end.
    12445       when "neg-part-free" then do:
    12446           assign
    12447           v-message = substitute("Все товары, имеющие отрицательные партии в свободной зоне на объекте (остаток при этом может быть любым).&1&2"
    12448                                 , chr(10)
    12449                                 , stat-line(rs-status))
    12450           dsp-rs    = "ВСЕ товары с отрицательными партиями в свободной зоне на/в &1 &2"
    12451           .
    12452       end.
    12453       when "neg-prt" then do:
    12454           assign
    12455           v-message = substitute("Все товары с признаками с отрицательными остатками по признакам на объекте.&1&2"
    12456                                 , chr(10)
    12457                                 , stat-line(rs-status))
    12458           dsp-rs    =  "ВСЕ товары с признаками с отриц. ост. по признаку на/в &1 &2"
    12459           .
    12460       end.
    12461       when "nul-rest" then do:
    12462           assign
    12463           v-message = substitute("Все товары с нулевыми остатками на объекте.&1&2"
    12464                                 , chr(10)
    12465                                 , stat-line(rs-status))
    12466           dsp-rs     = "ВСЕ товары с нулевыми остатками на/в &1 &2"
    12467           .
    12468       end.
    12469       when  "input" then do:
    12470         assign
    12471         v-message = substitute("Все товары, когда либо бывшие (или имеющиеся сейчас) на объекте.&1&2"
    12472                                 , chr(10)
    12473                                 , stat-line(rs-status))
    12474         dsp-rs = "ВСЕ товары, проходившие когда-либо по &1 &2"
    12475         .
    12476       end.
    12477       when "with-price" then do:
    12478         assign
    12479         v-message = substitute("Все товары на объекте, имеющие продажную цену > 0 .&1&2"
    12480                                 , chr(10)
    12481                                 , stat-line(rs-status))
    12482         dsp-rs     = "ВСЕ товары, имеющие цену > 0 по &1 &2"
    12483         .
    12484       end.
    12485       when "ov-req" then do:
    12486         assign
    12487         v-message = substitute("Товары, которые нельзя расходовать с объекта без переоценки&1" +
    12488                               "(попадающие под действие настройки, требующей переоценки после&1" +
    12489                               "любого прихода на объект).&1&2"
    12490                                 , chr(10)
    12491                                 , stat-line(rs-status))
    12492         dsp-rs = "Товары, по которым требуется переоценка после ПРИХОДА на/в &1 &2 "
    12493         .
    12494       end.
    12495       WHEN "inv-req" then do:
    12496         assign
    12497         v-message = substitute("Товары, количество по которым изменялось со времени последней&1" +
    12498                                 "инвентаризации на объекте (своей для каждого товара).&1&2"
    12499                                 , chr(10)
    12500                                 , stat-line(rs-status))
    12501         dsp-rs = "Товары, по которым были ОБОРОТЫ после ИНВЕНТАРИЗАЦИИ на/в &1 &2"
    12502         .
    12503       end.
    12504       when "etalon" then do:
    12505         ASSIGN
    12506         v-message = substitute("Все товары из справочника товаров по ТЕКУЩЕМУ объекту, цены по которым&1" +
    12507                                 "НЕ совпадают с ценами на выбранном ЭТАЛОННОМ объекте&1" +
    12508                                 "(только при условии, что цена есть на том и другом объектах).&1&2"
    12509                                 , chr(10)
    12510                                 , stat-line(rs-status))
    12511         dsp-rs = "Цены на/в &1 &2, не совпадающие с ценами на &3 &4"
    12512         .
    12513       end.
    12514     END CASE.
    12515     message v-message
    12516     view-as alert-box question buttons OK-Cancel update glog.
    12517     if not glog then do:
    12518       run UI-on  in this-procedure.
    12519       return error.
    12520     end.
    12521       ref-list = "":U.
    12522   define variable vss-include-info76 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12523   run userobjs_select-one in this-procedure
    12524     (input  parparentproc
    12525     ,input  v-cntxt-db-num
    12526     ,input  v-cntxt-userid
    12527     ,input  v-cntxt-host-code-obj
    12528     ,input  v-cntxt-obj-type
    12529     ,input  v-cntxt-obj-code
    12530     ,output v-user-select
    12531     ,output v-sel-obj-type
    12532     ,output v-sel-obj-code
    12533     )  .
    12534                            if not v-user-select then do:     run UI-on in this-procedure .     return no-apply.   end.
    12535       find first buf_user-obj no-lock where
    12536                 buf_user-obj.obj-type = v-sel-obj-type
    12537             and buf_user-obj.obj-code = v-sel-obj-code
    12538             AND buf_user-obj.db-num = v-cntxt-db-num
    12539             AND buf_user-obj.user-id = v-cntxt-userid  no-error .
    12540       if not available buf_user-obj then do:
    12541         run ui-on in this-procedure .
    12542         return error.
    12543       end.
    12544       if p-method = "etalon"
    12545       and p-curr-obj-type = v-sel-obj-type
    12546       and p-curr-obj-code = v-sel-obj-code then do:
    12547         message "Бессмысленно сравнивать цены для одного и того же объекта.".
    12548         run UI-on  in this-procedure.
    12549         return error.
    12550       end.
    12551       if p-method = "etalon":U then do:
    12552         assign
    12553         dsp-rs = replace(dsp-rs, "&1", p-curr-obj-type)
    12554         dsp-rs = replace(dsp-rs, "&2", string(p-curr-obj-code))
    12555         dsp-rs = replace(dsp-rs, "&3", v-sel-obj-type)
    12556         dsp-rs = replace(dsp-rs, "&4", string(v-sel-obj-code))
    12557         dsp-rs = substitute("&1 &2", dsp-rs, stat-line(rs-status))
    12558         .
    12559       end.
    12560       else do:
    12561         assign
    12562         dsp-rs = replace(dsp-rs, "&1", v-sel-obj-type)
    12563         dsp-rs = replace(dsp-rs, "&2", string(v-sel-obj-code))
    12564         dsp-rs = substitute("&1 &2", dsp-rs, stat-line(rs-status))
    12565         .
    12566       end.
    12567       run create-scn-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    12568                                           , input-output v-seq
    12569                                           , input 0
    12570                                           , input '':U
    12571                                           , input dsp-rs
    12572                                           , input tot-lns
    12573                                           , input p-method
    12574                                           , input rs-status
    12575                                           , input '':U
    12576                                           , input 'user-obj':U
    12577                                           , input buffer buf_user-obj:handle
    12578                                           ).
    12579   end.
    12580   end procedure.
    12581   PROCEDURE reposition-goods :
    12582   define input  parameter p-direction   as character no-undo .
    12583   define output parameter p-recid as recid no-undo .
    12584   define buffer buf_goods for ub.goods.
    12585   case p-direction :
    12586     when "first":U
    12587     then do:
    12588       get first br-list.
    12589     end.
    12590     when "last":U
    12591     then do:
    12592       get last br-list.
    12593     end.
    12594     when "prev":U
    12595     then do:
    12596       get prev br-list.
    12597       if not available scn-list then do:
    12598         message
    12599         "Это первый товар списка"
    12600         view-as alert-box.
    12601       end.
    12602     end.
    12603     when "next":U
    12604     then do:
    12605       get next br-list.
    12606       if not available scn-list then do:
    12607         message
    12608         "Это последний товар списка"
    12609         view-as alert-box.
    12610       end.
    12611     end.
    12612   end case .
    12613   find first buf_goods no-lock where
    12614           buf_goods.gds-code = scn-list.gds-code no-error.
    12615   if available scn-list then do:
    12616     assign
    12617     p-recid = recid(buf_goods)
    12618     .
    12619   end.
    12620   run reposition-query in this-procedure
    12621     (input recid(scn-list)
    12622     ).
    12623   END PROCEDURE.
    12624   PROCEDURE reposition-query :
    12625   define input parameter p-recid as recid no-undo .
    12626   if p-recid <> ?
    12627   then do:
    12628     reposition br-list to recid p-recid no-error.
    12629   end.
    12630   do with frame Dialog-Frame:
    12631     apply "entry":u to browse br-list .
    12632     apply "VALUE-CHANGED":u to browse br-list .
    12633   end.
    12634   END PROCEDURE.
    12635   procedure cb_fill-lob-res-list :
    12636   define input  parameter p-full-path as character no-undo .
    12637   output to value (p-full-path).
    12638   for each scn-list:
    12639     export scn-list.prod-type
    12640           scn-list.prod-code
    12641           scn-list.artic
    12642           scn-list.qnty
    12643           .
    12644   end.
    12645   output close.
    12646   end procedure.
    12647   procedure cb_fill-lob-res-list-macro :
    12648   define input  parameter p-full-path as character no-undo .
    12649   define buffer buf_scn-list-hist for scn-list-hist.
    12650   output to value (p-full-path).
    12651   for each buf_scn-list-hist:
    12652       export
    12653       buf_scn-list-hist.
    12654   end.
    12655   output close.
    12656   end procedure.
    12657   procedure cb_get-next-gds-by-gds-code :
    12658   define input parameter p-gds-code as integer no-undo .
    12659   define input parameter p-bh as handle no-undo .
    12660   define buffer buf_gds-list for scn-list.
    12661   find first buf_gds-list no-lock where
    12662             buf_gds-list.gds-code > p-gds-code no-error.
    12663   if available buf_gds-list then do:
    12664     p-bh:buffer-create().
    12665     p-bh:buffer-copy(buffer buf_gds-list:handle).
    12666   end.
    12667   else do:
    12668   end.
    12669   end procedure.
    12670   procedure m-gds-save-db-proc :
    12671   define variable v-rid-list as character no-undo .
    12672   run ref/clobbnds.w ( input parparentproc
    12673                       ,input this-procedure:handle
    12674                       ,input 'b-add'
    12675                       ,input "uniq-key-rec"
    12676                       ,input 'ИЗМЕНЕНИЕ':U
    12677                       ,input 'list':U
    12678                       ,input 'gds-list'
    12679                       ,input -1
    12680                       ,input-output v-rid-list) no-error.
    12681   end procedure.
    12682   procedure m-macros-save-db-proc :
    12683   define variable v-rid-list as character no-undo .
    12684   run ref/clobbnds.w ( input parparentproc
    12685                       ,input this-procedure:handle
    12686                       ,input 'b-add'
    12687                       ,input "uniq-key-rec"
    12688                       ,input 'ИЗМЕНЕНИЕ':U
    12689                       ,input 'list-macro':U
    12690                       ,input 'gds-list'
    12691                       ,input -1
    12692                       ,input-output v-rid-list) no-error.
    12693   end procedure.
    12694   procedure grplib-get-full-name-alc-type :
    12695   do
    12696   on error undo, return error
    12697   :
    12698   define input parameter p-node-code  as integer      no-undo.
    12699   define output parameter p-full-name as character    no-undo.
    12700       define buffer buf_alc-type       for ub.alc-type.
    12701       find first buf_alc-type no-lock
    12702            where buf_alc-type.alc-type-inner-code = p-node-code
    12703       no-error.
    12704       if not available buf_alc-type
    12705       then do:
    12706           undo, return error "grplib-get-full-name-alc-type: Не найден вид алкогольной продукции с кодом " + string( p-node-code ).
    12707       end.
    12708       assign
    12709       p-full-name = buf_alc-type.alc-type-name
    12710       .
    12711   end.
    12712   end procedure.
