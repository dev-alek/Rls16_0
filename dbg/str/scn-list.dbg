     6769   HIDE FRAME Dialog-Frame.
     6770   PROCEDURE UI-on:
     6771   define variable v-recid0 as recid no-undo.
     6772   define variable v-start as logical no-undo .
     6773   define buffer buf_temp-list for temp-list.
     6774   define buffer buf_scn-list-hist for scn-list-hist.
     6775     find first buf_scn-list-hist where buf_scn-list-hist.id = 0 no-error.
     6776     if available buf_scn-list-hist then
     6777     assign
     6778     frame Dialog-Frame:title = substitute("СПИСОК  ТОВАРОВ &1",  string(buf_scn-list-hist.des, "X(60)"))
     6779     .
     6780     if tot-lns = ? then do:
     6781       v-start = yes.
     6782       for each l-scn-list :
     6783         accumulate l-scn-list.artic (count).
     6784       end.
     6785       tot-lns = (accum count l-scn-list.artic).
     6786       if tot-lns > 0 then do:
     6787         find last  buf_scn-list-hist no-error .
     6788         v-seq = (if available buf_scn-list-hist then buf_scn-list-hist.id else 0)  + 1.
     6789         run create-scn-list-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     6790                                              , input-output v-seq
     6791                                              , input 0
     6792                                              , input 'S':U
     6793                                              , input substitute("# Исходный список: &1 строк", tot-lns)
     6794                                              , input tot-lns
     6795                                              , input "start":U
     6796                                              , input '':U
     6797                                              , input '':U
     6798                                              , input '':U
     6799                                              , input ?
     6800                                              ).
     6801       end.
     6802       else do:
     6803         line-mode = 'ДОБАВЛЕНИЕ':U.
     6804         for each buf_scn-list-hist:
     6805           delete buf_scn-list-hist.
     6806         end.
     6807         v-seq = 1.
     6808         run create-scn-list-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     6809                                              , input-output v-seq
     6810                                              , input 0
     6811                                              , input '':U
     6812                                              , input "# Исходный список товаров пуст."
     6813                                              , input tot-lns
     6814                                              , input 'start':U
     6815                                              , input '':U
     6816                                              , input '':U
     6817                                              , input '':U
     6818                                              , input ?
     6819                                              ).
     6820       end.
     6821     end.
     6822     hide loc-art in frame Dialog-Frame loc-name loc-code in frame Dialog-Frame.
     6823     assign
     6824     loc-art = ""
     6825     RS-list-method = "single"
     6826     .
     6827     find first buf_temp-list no-lock where
     6828                buf_temp-list.fvalue = rs-list-method.
     6829     assign
     6830     v-recid0 = recid(buf_temp-list).
     6831     open query br-option for each temp-list no-lock .
     6832     if v-seq > 1 then
     6833     find last buf_scn-list-hist no-lock where
     6834               buf_scn-list-hist.id = (v-seq - 1)
     6835          and  buf_scn-list-hist.line = 0 no-error .
     6836     DISPLAY br-option
     6837     (if available buf_scn-list-hist
     6838     then buf_scn-list-hist.des
     6839     else '') @ dsp-rs
     6840     RS-Status WITH FRAME Dialog-Frame.
     6841     ENABLE
     6842     b-macro  when v-start
     6843     b-record when v-start
     6844     b-exit b-add b-hist b-help br-option br-list RS-Status WITH FRAME Dialog-Frame.
     6845     if v-start then do:
     6846       hide
     6847       b-sel
     6848       b-mark
     6849       b-stop
     6850       b-clear-macro
     6851       in frame Dialog-Frame.
     6852       if lookup("b-sel", bttns) > 0
     6853       or lookup("b-mark", bttns) > 0
     6854       then do:
     6855         scn-list.to-sel:visible in browse br-list = yes.
     6856       end.
     6857       else do:
     6858         scn-list.to-sel:visible in browse br-list = no.
     6859       end.
     6860       if bttns <> '':U then do:
     6861         run proc-expand in this-procedure ( input 1, input b-sel:row, input br-list:row, input "b-sel,b-mark").
     6862       end.
     6863     end.
     6864     v-start = no.
     6865     reposition br-option to recid v-recid0.
     6866     if tot-lns > 0 then do:
     6867       Enable b-print b-arch b-rest b-save b-del b-lkp b-clr a-n-c
     6868       b-mark when lookup("b-mark", bttns) > 0
     6869       b-sel  when lookup("b-sel", bttns) > 0
     6870       WITH FRAME Dialog-Frame.
     6871     end.
     6872     else do:
     6873       DISABLE b-print b-arch b-rest b-save b-del b-lkp b-clr a-n-c
     6874       b-mark b-sel
     6875       WITH FRAME Dialog-Frame.
     6876     end.
     6877     open query br-list for each scn-list no-lock indexed-reposition.
     6878     if line-rec <> ? then
     6879       reposition br-list to recid line-rec no-error.
     6880     if available scn-list then do:     find ub.clients where ub.clients.obj-type = scn-list.prod-type                    and ub.clients.obj-code = scn-list.prod-code no-lock.     find ub.gds-prt where ub.gds-prt.upper-code = scn-list.prt-root no-lock.     find ub.bar-code where ub.bar-code.gds-code  = scn-list.gds-code                     and ub.bar-code.node-code = ub.gds-prt.node-code                     and ub.bar-code.unit-cli  = scn-list.unit-base                     and ub.bar-code.in-code   = ""                     and ub.bar-code.part-code = "" no-lock.     disp ub.clients.obj-name ub.gds-prt.node-name ub.bar-code.b-code tot-lns @ f-tot-lns with frame Dialog-Frame.   end.   else display f-tot-lns with frame Dialog-Frame.
     6881   END PROCEDURE.
     6882   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6883   PROCEDURE ex-gds :
     6884       define parameter buffer buf_goods for ub.goods.
     6885       define input parameter rs-list-method as character no-undo .
     6886       define input parameter rs-status as character no-undo .
     6887       define input parameter line-mode as character no-undo .
     6888       if rs-list-method = "single":U or
     6889           (buf_goods.stts = 0  and rs-status <> 'удаленные':U) or
     6890           (buf_goods.stts <> 0 and rs-status <> 'текущие':U) then
     6891       do:
     6892           if line-mode = 'удаление':U or line-mode = 'ОСТАВИТЬ':U then
     6893           do:
     6894               if rs-list-method = "tsd":U then
     6895               do:
     6896                   for first ub.Code no-lock where ub.Code.parent = "TiketPrint" and
     6897                       ub.code.status_ = 0 and ub.Code.code = string(buf_goods.gds-code):
     6898                       find first scn-list where scn-list.artic = buf_goods.artic
     6899                           and scn-list.prod-type = buf_goods.prod-type
     6900                           and scn-list.prod-code = buf_goods.prod-code no-error.
     6901                       if available scn-list then
     6902                       do:
     6903                           if line-mode = 'удаление':U then
     6904                           do:
     6905                               lns-cnt = lns-cnt + 1.
     6906                               delete scn-list.
     6907                           end.
     6908                           else
     6909                           do:
     6910                               if scn-list.to-del = ? then.
     6911                               else
     6912                               do:
     6913                                   lns-cnt = lns-cnt + 1.
     6914                                   scn-list.to-del = ?.
     6915                               end.
     6916                           end.
     6917                       end.
     6918                   end.
     6919               end.
     6920               else
     6921               do:
     6922                   find first scn-list where scn-list.artic = buf_goods.artic
     6923                       and scn-list.prod-type = buf_goods.prod-type
     6924                       and scn-list.prod-code = buf_goods.prod-code no-error.
     6925                   if available scn-list then
     6926                   do:
     6927                       if line-mode = 'удаление':U then
     6928                       do:
     6929                           lns-cnt = lns-cnt + 1.
     6930                           delete scn-list.
     6931                       end.
     6932                       else
     6933                       do:
     6934                           if scn-list.to-del = ? then.
     6935                           else
     6936                           do:
     6937                               lns-cnt = lns-cnt + 1.
     6938                               scn-list.to-del = ?.
     6939                           end.
     6940                       end.
     6941                   end.
     6942               end.
     6943           end.
     6944           else
     6945               if line-mode = 'ДОБАВЛЕНИЕ':U then
     6946               do:
     6947   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6948   find scn-list
     6949     where scn-list.prod-type = buf_goods.prod-type
     6950       and scn-list.prod-code = buf_goods.prod-code
     6951       and scn-list.artic     = buf_goods.artic
     6952     no-error .
     6953   if available scn-list then do:
     6954     assign
     6955       scn-list.to-del = no
     6956     .
     6957   end.
     6958   else do:
     6959     define variable v-last48 as integer no-undo .
     6960     find last scn-list use-index oi no-error.
     6961     if available scn-list then do:
     6962       v-last48 = scn-list.order-num .
     6963     end.
     6964     else do:
     6965       v-last48 = 0 .
     6966     end.
     6967     create scn-list .
     6968     buffer-copy buf_goods to scn-list
     6969     assign
     6970       scn-list.to-del = no
     6971       scn-list.order-num = v-last48 + 1
     6972     .
     6973     assign
     6974       lns-cnt = lns-cnt + 1
     6975       line-rec = recid (scn-list)
     6976     .
     6977   end.
     6978                   if rs-list-method = "tsd":U  then
     6979                   do:
     6980                       for first ub.Code no-lock where ub.Code.parent = "TiketPrint" and
     6981                           ub.code.status_ = 0 and ub.Code.code = string(buf_goods.gds-code):
     6982                           find first scn-list where scn-list.gds-code = buf_goods.gds-code no-error.
     6983                           if available scn-list then
     6984                           do:
     6985                               scn-list.qnty = decimal(ub.Code.CodeValue) .
     6986                           end.
     6987                       end.
     6988                   end.
     6989               end.
     6990           if lns-cnt modulo 25 = 0 then
     6991               disp "ЖДИТЕ...    Обработано товаров :" + string (lns-cnt) @ dsp-rs with frame Dialog-Frame.
     6992       end.
     6993       else
     6994           assign
     6995               lns-ignore = lns-ignore + 1
     6996               .
     6997   end.
     6998   PROCEDURE rs-do:
     6999   define input parameter p-from-macro as logical no-undo .
     7000   define input parameter p-step as logical no-undo .
     7001   define input parameter rs-list-method as character no-undo .
     7002   define input parameter rs-status as character no-undo .
     7003   define input parameter line-mode as character no-undo .
     7004   define input parameter p-id      as integer no-undo .
     7005   define variable grp-path like ub.goods.grp-name no-undo.
     7006   define variable another-price like ub.price-list.price-sale no-undo.
     7007   define variable var-root-code like ub.gds-prt.node-code no-undo .
     7008   define variable v-rowid   as rowid no-undo .
     7009   define variable v-tbl-name as character no-undo .
     7010   define variable v-discnt-role as character no-undo .
     7011   define variable v-nonunique as character no-undo .
     7012   define variable vvalue-int as integer no-undo .
     7013   define variable glog as logical no-undo .
     7014   define variable v-date-chr as character no-undo .
     7015   define variable v-date as date no-undo .
     7016   define buffer buf_scn-list-hist for scn-list-hist.
     7017   define buffer buf_user-obj for ub.user-obj.
     7018   define buffer buf_units for ub.units.
     7019   define buffer buf_parts for ub.parts.
     7020   do
     7021   on error undo, return error return-value
     7022   :
     7023   assign
     7024   lns-cnt = 0
     7025   lns-ignore = 0
     7026   v-num-add     = 0
     7027   v-num-ignored = 0
     7028   tot-lns = (if line-mode = 'ОСТАВИТЬ':U then 0 else tot-lns)
     7029   .
     7030   run write-hist in this-procedure ( input p-from-macro
     7031                                     ,input rs-list-method
     7032                                     ,input rs-status
     7033                                     ,input line-mode).
     7034   if session:set-wait-state( "COMPILER" )  then .
     7035   dsp-rs:fgcolor in frame Dialog-Frame = 12.
     7036   case rs-list-method:
     7037     when "all" then do:
     7038       find first buf_scn-list-hist where
     7039                  buf_scn-list-hist.id = p-id .
     7040       for each ub.goods no-lock:
     7041         run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
     7042       end.
     7043       assign                                                           buf_scn-list-hist.num-add  = lns-cnt - v-num-add                       buf_scn-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_scn-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_scn-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7044     end.
     7045     when "gds-grp" then do:
     7046       for each buf_scn-list-hist where
     7047                buf_scn-list-hist.id = p-id
     7048           and  buf_scn-list-hist.item_ <> '':U:
     7049         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_scn-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     7050         grp-path = "".
     7051         find first ub.gds-grp no-lock where rowid(ub.gds-grp) = v-rowid.
