      359   procedure userhsts_transfer :
      360     define input  parameter p-callback-handle as handle no-undo .
      361     define variable vss-description as character no-undo init "userhsts_transfer: Передача списка объектов".
      362     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      363     do
      364     on error undo, return error return-value
      365     :
      366       if valid-handle(p-callback-handle) <> true
      367       then do:
      368         message
      369           vss-workfile vss-revision vss-description skip
      370           "Ошибка задания входных параметров" skip
      371           "Неизвестный указатель на процедуру" skip
      372           view-as alert-box error .
      373         undo, return error return-value .
      374       end.
      375       if p-callback-handle :get-signature("userhsts_append") = ""
      376       then do:
      377         message
      378           vss-workfile vss-revision vss-description skip
      379           "Ошибка задания входных параметров" skip
      380           substitute("В процедуре &1 не найдена внутренняя процедура userhsts_append"
      381                     ,p-callback-handle :file-name
      382                     ) skip
      383           view-as alert-box error .
      384         undo, return error return-value .
      385       end.
      386       for each buf_userhsts_temp-user-host
      387       on error undo, return error return-value
      388       :
      389         run userhsts_append in p-callback-handle
      390           (input  buf_userhsts_temp-user-host.host-code
      391           ) .
      392       end.
      393     end.
      394   end procedure.
