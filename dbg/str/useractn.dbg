      201   procedure proc-alt-shift-f2:
      202     if not ibs.th.gbl.gbl-var:rcode
      203   then
      204     run gbl\inidebug.p .
      205   end.
      206   procedure proc-alt-shift-f3:
      207     run gbl/prvssinf.p
      208       ( input this-procedure
      209       ) .
      210   end.
      211   define variable v-inform-launched as logical no-undo initial false .
      212   procedure proc-alt-shift-f4:
      213     define variable v-action as character no-undo .
      214     if v-inform-launched = false then do:
      215       assign
      216         v-inform-launched = true
      217       .
      218       run gbl/d-inform.w
      219         (  input self
      220         ,  input this-procedure
      221         , output v-action
      222         ) no-error .
      223       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      224       assign
      225         v-inform-launched = false
      226       .
      227     end.
      228   end.
      229   procedure proc-alt-f1:
      230     run gbl/corrhelp.p
      231       (input this-procedure
      232       ) .
      233   end .
      234   on alt-shift-f2 anywhere do:
      235     run proc-alt-shift-f2.
      236   end.
      237   on alt-shift-f3 anywhere do:
      238     run proc-alt-shift-f3 in this-procedure .
      239   end.
      240   on alt-shift-f4 anywhere do:
      241     run proc-alt-shift-f4 in this-procedure.
      242   end.
      243   on alt-f1 anywhere do:
      244     run proc-alt-f1 in this-procedure .
      245   end.
      246   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      247   function usrnickf returns character ( input p-user-id as character):
      248      define variable v-nick      as character    no-undo.
      249      if p-user-id = ?
      250      OR p-user-id = "":U
      251      then do:
      252         return '':U .
      253      end.
      254   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      255   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrnick in g#library
      256     (input  p-user-id
      257     ,output v-nick
      258     ) no-error .
      259      if error-status :error
      260      then do:
      261         return p-user-id.
      262      end.
      263      else do:
      264         return v-nick.
      265      end.
      266   end function.
