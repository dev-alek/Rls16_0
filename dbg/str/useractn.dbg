        1   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        2   DEFINE INPUT PARAMETER p-user-id     AS CHARACTER     NO-UNDO.
        3   DEFINE INPUT PARAMETER p-db-num      AS integer       NO-UNDO.
        4   DEFINE TEMP-TABLE tt-work-place NO-UNDO
        5       FIELD wp-code AS INTEGER   column-label "Код"           FORMAT ">>>>>>>>>9"
        6       FIELD wp-type AS CHARACTER column-label "Тип"           FORMAT "x(3)"
        7       FIELD wp-host AS INTEGER   column-label "фирма"         FORMAT ">>>>>>>>>9"
        8       FIELD wp-name AS CHARACTER column-label "наименование"  FORMAT "x(40)"
        9       FIELD context AS CHARACTER column-label "привязка"
       10       FIELD db-num  AS INTEGER   column-label "БД"            FORMAT ">>>>>>>>>9"
       11       field marked  as logical
       12       field deleted  as logical
       13   INDEX i-code-type IS PRIMARY UNIQUE
       14         wp-code
       15         wp-type
       16   INDEX i-host
       17         wp-host
       18   index i-context
       19         context
       20   .
       21   DEFINE TEMP-TABLE tt-user-login-action-role NO-UNDO like ub.user-login-action-role
       22       FIELD role-name AS CHARACTER column-label "название"  FORMAT "x(40)"
       23       FIELD description AS CHARACTER column-label "описание"  FORMAT "x(40)"
       24       field deleted  as logical
       25       field marked  as logical
       26   index i-name
       27         role-name
       28   .
       29   define temp-table  tt-gds-grp no-undo
       30       field node-code as integer column-label "Вн.код группы" format ">>>>>>>>9"
       31       field full-name as character COLUMN-LABEL "Название группы" format "X(255)"
       32   index i-code
       33         node-code
       34   .
       35   define buffer br_tt-gds-grp                  for tt-gds-grp.
       36   define buffer br_tt-work-place               for tt-work-place.
       37   define buffer br_tt-user-login-action-role   for tt-user-login-action-role.
       38   define variable vss-revision    as character no-undo init "$Revision$":U .
       39   define variable vss-author      as character no-undo init "$Author$":U .
       40   define variable vss-date        as character no-undo init "$Date$":U .
       41   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       42   define variable vss-archive     as character no-undo init "$Archive$":U .
       43   define variable vss-description as character no-undo init "Редактирование привязки группы прав к пользователю".
       44   procedure vss-get-info :
       45     define output parameter p-vss-revision    like vss-revision    no-undo .
       46     define output parameter p-vss-author      like vss-author      no-undo .
       47     define output parameter p-vss-date        like vss-date        no-undo .
       48     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       49     define output parameter p-vss-archive     like vss-archive     no-undo .
       50     define output parameter p-vss-description like vss-description no-undo .
       51     assign
       52       p-vss-revision    = vss-revision
       53       p-vss-author      = vss-author
       54       p-vss-date        = vss-date
       55       p-vss-workfile    = vss-workfile
       56       p-vss-archive     = vss-archive
       57       p-vss-description = vss-description
       58     .
       59   end procedure.
       60   procedure vss-get-parameters :
       61     define output parameter p-vss-parameters as character no-undo .
       62   end procedure.
       63   define new global shared variable g#vssrevis-logger as handle    no-undo .
       64   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       65   define variable v-vssrevis-logger                   as handle    no-undo .
       66   procedure vss-logevent :
       67     define input  parameter p-extra-paramters as character no-undo .
       68     define variable v-vssrevis-parameters as character no-undo .
       69     do
       70     on error undo, return error return-value
       71     :
       72       if  valid-handle(v-vssrevis-logger)
       73       and v-vssrevis-logger :get-signature("logevent") <> ""
       74       then do:
       75         run vss-get-parameters in this-procedure
       76           (output v-vssrevis-parameters
       77           ).
       78         run logevent in v-vssrevis-logger
       79           (input vss-workfile
       80           ,input vss-revision
       81           ,input v-vssrevis-parameters
       82           ,input p-extra-paramters
       83           ).
       84       end.
       85     end.
       86   end procedure.
       87   assign
       88     v-vssrevis-logger = g#vssrevis-logger
       89   .
       90   if  valid-handle(v-vssrevis-logger)
       91   and v-vssrevis-logger :get-signature("logevent") <> ""
       92   then do:
       93     assign
       94       v-vssrevis-logevent = true
       95     .
       96     run vss-logevent in this-procedure (input vss-description) .
       97   end.
       98   define new global shared variable g#language as character no-undo .
       99   if g#language <> '' and g#language <> 'rus':U then do:
      100     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      101   end.
      102   define variable vss-include-info0 as character format "X(65)" no-undo
      103   initial "@(#)$Workfile$ $Revision$".
      104   procedure grplib-get-full-name :
      105      define input parameter p-node-code  as integer      no-undo.
      106      define output parameter p-full-name as character    no-undo.
      107      do
      108   on error undo, return error
      109   :
      110       define variable v-upper-code    as integer           no-undo.
      111       define buffer buf_gds-grp       for ub.gds-grp.
      112       define buffer buf_upper_gds-grp for ub.gds-grp.
      113       find first buf_gds-grp no-lock
      114            where buf_gds-grp.node-code = p-node-code
      115       no-error.
      116       if not available buf_gds-grp
      117       then do:
      118           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      119       end.
      120       assign
      121           p-full-name  = ""
      122           v-upper-code = 1
      123       .
      124       do while buf_gds-grp.upper-code <> 0
      125       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      126       :
      127           assign
      128               p-full-name  = buf_gds-grp.node-name
      129                            + (if p-full-name <> "" then chr(47) else "")
      130                            + p-full-name
      131               v-upper-code = buf_gds-grp.upper-code
      132           .
      133           find first buf_gds-grp no-lock
      134                where buf_gds-grp.node-code = v-upper-code
      135           no-error.
      136           if not available buf_gds-grp
      137           then do:
      138               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      139                                   + string( v-upper-code )
      140                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      141           end.
      142       end.
      143       assign
      144       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      145       .
      146   end.
      147   end .
      148   procedure grplib-get-node-from-full-name :
      149   define input parameter p-full-name as character no-undo .
      150   define output parameter p-node-code as integer no-undo .
      151   define variable v-ii as integer no-undo .
      152   define variable v-upper-code as integer no-undo .
      153   define variable v-root-code as integer no-undo .
      154   define variable v-entry as character no-undo .
      155   define buffer buf_gds-grp       for ub.gds-grp.
      156   do
      157   on error undo, return error
      158   :
      159     find first buf_gds-grp no-lock
      160         where buf_gds-grp.upper-code = 0
      161     no-error .
      162     if not available buf_gds-grp
      163     then do:
      164         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      165     end.
      166     else do:
      167       assign
      168       v-root-code = buf_gds-grp.node-code
      169       .
      170     end.
      171     v-upper-code = v-root-code.
      172     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      173       assign
      174       v-entry = entry(v-ii, p-full-name, chr(47)).
      175       if v-entry = '' then leave.
      176       find first buf_gds-grp no-lock where
      177                 buf_gds-grp.node-name = v-entry
      178             and buf_gds-grp.upper-code = v-upper-code
      179             no-error.
      180       if not available buf_gds-grp then do:
      181         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      182       end.
      183       else do:
      184         p-node-code = buf_gds-grp.node-code.
      185         v-upper-code = buf_gds-grp.node-code.
      186       end.
      187     end.
      188   end.
      189   end .
