      623   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      624   procedure cur-time :
      625      define output parameter p-today as date      no-undo .
      626      define output parameter p-time  as integer   no-undo .
      627     do
      628     on error undo, return error
      629     :
      630       define variable v-date1 as date      no-undo .
      631       define variable v-date2 as date      no-undo .
      632       define variable v-time  as integer   no-undo .
      633       assign
      634         v-date1 = today
      635         v-time  = time
      636         v-date2 = today
      637       .
      638       if v-date1 <> v-date2
      639       then do:
      640         assign
      641           v-date1 = today
      642           v-time  = v-time
      643         .
      644       end.
      645       assign
      646         p-today = v-date1
      647         p-time  = v-time
      648       .
      649     end.
      650   end.
      651   function cur-time-date returns character
      652   :
      653     return string(today, '99/99/9999':U) .
      654   end.
      655   function cur-time-mjd returns decimal
      656   :
      657     define variable v-date as date      no-undo .
      658     define variable v-time as integer   no-undo .
      659     run cur-time in this-procedure
      660       (output v-date
      661       ,output v-time
      662       ) .
      663     return integer(v-date) - 2400002 + (v-time / 86400) .
      664   end.
      665   function cur-time-get-ending-index returns integer
      666   (input p-number as integer
      667   )
      668   :
      669     if p-number < 0
      670     or p-number = ?
      671     then do:
      672       return 1 .
      673     end.
      674     define variable v-rest as integer   no-undo .
      675     assign
      676       p-number = p-number modulo 100
      677     .
      678     if p-number < 20
      679     then do:
      680       assign
      681         v-rest = p-number
      682       .
      683     end.
      684     else do:
      685       assign
      686         v-rest = p-number modulo 10
      687       .
      688     end.
      689     case v-rest :
      690       when 1
      691       then do:
      692         return 2 .
      693       end.
      694       when 2 or
      695       when 3 or
      696       when 4
      697       then do:
      698         return 3 .
      699       end.
      700       otherwise do:
      701         return 1 .
      702       end.
      703     end case .
      704   end.
      705   procedure cur-time-mjd-to-date :
      706      define input  parameter i-mjd-diff as decimal no-undo.
      707      define output parameter o-Date     as date    no-undo.
      708      define output parameter o-Time     as integer no-undo.
      709      define variable v-day-number as integer   no-undo .
      710      if    i-mjd-diff < 0
      711         or i-mjd-diff = ?
      712      then do:
      713         return "?" .
      714      end.
      715      assign
      716         v-day-number = truncate(i-mjd-diff,0).
      717         o-Date = date(v-day-number + 2400002).
      718         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      719     .
      720   end.
      721   function cur-time-mjd-to-string returns character
      722   (input p-mjd-diff as decimal
      723   )
      724   :
      725     define variable v-day-number as integer   no-undo .
      726     define variable v-seconds    as integer   no-undo .
      727     define variable v-hour       as integer   no-undo .
      728     define variable v-min        as integer   no-undo .
      729     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      730     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      731     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      732     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      733     if p-mjd-diff < 0
      734     or p-mjd-diff = ?
      735     then do:
      736       return "?" .
      737     end.
      738     assign
      739       v-day-number = integer(truncate(p-mjd-diff,0))
      740       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      741     .
      742     if v-seconds > 86400
      743     then do:
      744       assign
      745         v-seconds = 86400 - 1
      746       .
      747     end.
      748     if v-seconds < 0
      749     then do:
      750       assign
      751         v-seconds = 0
      752       .
      753     end.
      754     assign
      755       v-hour = truncate(v-seconds / 3600, 0)
      756     .
      757     assign
      758       v-seconds = v-seconds modulo 3600
      759     .
      760     assign
      761       v-min = truncate(v-seconds / 60, 0)
      762     .
      763     assign
      764       v-seconds = v-seconds modulo 60
      765     .
      766     return
      767         (if v-day-number <> 0
      768           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      769           else ""
      770         )
      771       + (if v-day-number <> 0 or v-hour <> 0
      772           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      773           else ""
      774         )
      775       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      776           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      777           else ""
      778         )
      779       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      780       .
      781   end.
      782   function cur-time-string returns character
      783   :
      784     define variable v-date as date      no-undo .
      785     define variable v-time as integer   no-undo .
      786     run cur-time in this-procedure
      787       (output v-date
      788       ,output v-time
      789       ) .
      790     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      791   end.
      792   function cur-time-string-sec returns character
      793   :
      794     define variable v-date as date      no-undo .
      795     define variable v-time as integer   no-undo .
      796     run cur-time in this-procedure
      797       (output v-date
      798       ,output v-time
      799       ) .
      800     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      801   end.
      802   function cur-time-custom  returns character
      803   (input p-prefix as character
      804   ,input p-date-format as character
      805   ,input p-delimiter as character
      806   ,input p-time-format as character
      807   ,input p-suffix as character
      808   )
      809   :
      810     define variable v-date as date      no-undo .
      811     define variable v-time as integer   no-undo .
      812     run cur-time in this-procedure
      813       (output v-date
      814       ,output v-time
      815       ) .
      816     return
      817       p-prefix
      818       + string(v-date, p-date-format)
      819       + p-delimiter
      820       + string(v-time, p-time-format)
      821       + p-suffix
      822       .
      823   end.
      824   function cur-time-print  returns character
      825   :
      826     define variable v-date as date      no-undo .
      827     define variable v-time as integer   no-undo .
      828     run cur-time in this-procedure
      829       (output v-date
      830       ,output v-time
      831       ) .
      832     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      833   end.
      834   function cur-time-datetime returns datetime
      835   :
      836     define variable v-char as character no-undo .
      837     define variable v-datetime as datetime no-undo .
      838     v-char = cur-time-string().
      839     v-datetime = datetime(v-char).
      840     return  v-datetime.
      841   end.
      842   function cur-time-string-msec returns character
      843   :
      844     define variable v-date as datetime  no-undo .
      845     v-date = now.
      846     return string(v-date) .
      847   end.
      848   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      849   def
      850   NEW shared
      851   temp-table  obj-list no-undo
      852     field obj-type like ub.clients.obj-type
      853     field obj-code like ub.clients.obj-code
      854     field obj-name like ub.clients.obj-name
      855     field obj-id   as integer
      856     field db-num   as integer
      857     index pi is primary unique obj-id
      858     index ie1 obj-type obj-code
      859     index ie2 obj-name
      860   .
      861   procedure create_obj-list :
      862      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      863      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      864      do
      865      on error undo, return error return-value
      866      :
      867         define buffer cli-obj for ub.clients .
      868         define variable p-var as integer no-undo .
      869         define buffer buf_obj-list for obj-list .
      870         find last buf_obj-list  use-index pi no-error .
      871         if available buf_obj-list
      872         then
      873            p-var = buf_obj-list.obj-id + 1.
      874         else
      875            p-var = 1.
      876         find first cli-obj where
      877                   cli-obj.obj-type = p-obj-type
      878               and cli-obj.obj-code = p-obj-code
      879         no-lock no-error.
      880         if available cli-obj
      881         then do:
      882            create buf_obj-list.
      883            assign
      884               buf_obj-list.obj-id   = p-var
      885               buf_obj-list.obj-code = cli-obj.obj-code
      886               buf_obj-list.obj-type = cli-obj.obj-type
      887               buf_obj-list.obj-name = cli-obj.obj-name
      888               buf_obj-list.db-num   = cli-obj.db-num
      889            .
      890         end.
      891      end.
      892   end.
      893   define variable v-character as character no-undo .
      894   define variable v-character-new as character no-undo .
      895   define variable v-date as date no-undo .
      896   define variable v-decimal as decimal no-undo .
      897   define variable v-integer as date no-undo .
      898   define variable v-logical as logical no-undo .
      899   define variable v-attr-type as character no-undo .
      900   define variable v-first-time as logical no-undo .
      901   DEFINE VARIABLE v-today as date no-undo .
      902   DEFINE VARIABLE v-time as integer no-undo .
      903   define variable log-file-name as character no-undo init "send-cd.txt".
      904   define buffer buf_c-gds-grp-hist for ub.c-gds-grp-hist.
      905   define buffer buf_c-gds-prt for ub.c-gds-prt.
      906   define buffer buf_cash-desk for ub.cash-desk.
      907   assign
      908   p-obj-code = abs(integer(entry(1, p-parameter, chr(4))))
      909   p-necessary = (if num-entries(p-parameter, chr(4)) > 1
      910                  then logical(entry(2, p-parameter, chr(4)))
      911                  else no)
      912   no-error
      913   .
      914   if error-status:error then do:
      915     run write-log-and-file in p-log-handle (
      916           input 1
      917         , input log-file-name
      918         , input 1
      919         , input substitute("Ошибка входных параметров &1:&2&3"
      920                            , p-parameter
      921                            , chr(10)
      922                            , error-status:get-message(1)
      923                            )).
      924     undo, return error .
      925   end .
      926   find first buf_cash-desk no-lock where
      927             buf_cash-desk.db-num = g#db-num
      928         AND buf_cash-desk.obj-code = p-obj-code
      929         AND buf_cash-desk.pos-type = 'InfoKiosk':U no-error .
      930   if not available buf_cash-desk then return error substitute("Нет кассы &1 на маг&2"
      931                                                               , 'InfoKiosk':U
      932                                                               , p-obj-code ).
      933   find last buf_c-gds-grp-hist where
      934         buf_c-gds-grp-hist.node-code = 0
      935     AND buf_c-gds-grp-hist.corr-user-db-num = 0
      936     AND buf_c-gds-grp-hist.host-code = 0
      937     AND buf_c-gds-grp-hist.obj-type = '':U
      938     AND buf_c-gds-grp-hist.obj-code = 0
      939     AND buf_c-gds-grp-hist.subject = 'gds-grp':U no-error.
      940   run cd-attr-value in this-procedure (
      941                                               input g#db-num
      942                                             ,input p-obj-code
      943                                             ,input buf_cash-desk.pos-type
      944                                             ,input buf_cash-desk.cash-num
      945                                             ,input 'INFOKIOSK_operative':U
      946                                             ,input 'last-grp-change':U
      947                                             ,output v-character
      948                                             ,output v-date
      949                                             ,output v-decimal
      950                                             ,output v-integer
      951                                             ,output v-logical
      952                                             ,output v-attr-type     ) no-error.
      953   if error-status:error
      954   or v-character = '':U
      955   or not available buf_c-gds-grp-hist
      956   or integer(entry(3, v-character, chr(32) )) < buf_c-gds-grp-hist.chip-num then do:
      957     if not available buf_c-gds-grp-hist
      958     or v-character = '':U
      959     then do:
      960       run cur-time in this-procedure(output v-today, output v-time).
      961       v-first-time = yes.
      962     end.
      963     assign
      964     v-character-new =  (if available buf_c-gds-grp-hist
      965                           then
      966                           (string(buf_c-gds-grp-hist.corr-date, "99/99/9999") + chr(32) +
      967                           string(buf_c-gds-grp-hist.corr-time, "hh:mm:ss") + chr(32) +
      968                           string(buf_c-gds-grp-hist.chip-num)
      969                           )
      970                           else
      971                           (string(v-today, "99/99/9999") + chr(32) +
      972                           string(v-time, "hh:mm:ss") + chr(32) +
      973                           string(current-value (s-gds-grp-chip, ub))
      974                           )
      975                           )
      976     .
      977     if v-character <> v-character-new then do:
      978       run cd-attr-write  in this-procedure (
      979                                               input g#db-num
      980                                               ,input p-obj-code
      981                                               ,input buf_cash-desk.pos-type
      982                                               ,input buf_cash-desk.cash-num
      983                                               ,input 'INFOKIOSK_operative':U
      984                                               ,input 'last-grp-change':U
      985                                               ,input v-character-new
      986                                               ,input ?
      987                                               ,input 0.0
      988                                               ,input 0
      989                                               ,input no
      990                                             ) no-error.
      991     end.
      992   end.
      993   if v-character-new = '':U then do:
      994     assign
      995     v-character-new = v-character.
      996   end.
      997   if p-necessary = yes
      998   or (available buf_c-gds-grp-hist
      999   and integer(entry(3, v-character-new, chr(32) )) < buf_c-gds-grp-hist.chip-num)
     1000   or v-first-time
     1001   or (not available buf_c-gds-grp-hist
     1002       and
     1003       (date(entry(1, v-character-new, chr(32) )) < v-today
     1004       or
     1005       (date(entry(1, v-character-new, chr(32) )) = v-today
     1006       and
     1007       integer(entry(2, v-character-new, chr(32) )) < v-time
     1008       )
     1009       )
     1010     )
     1011   then do:
     1012     run write-log-and-file in p-log-handle (
     1013           input 1
     1014         , input log-file-name
     1015         , input 1
     1016         , input substitute( "Пересылка групп товаров")) .
     1017     run str/sendgrup.p (
     1018                     input parparentproc
     1019                     ,input p-parent-handle
     1020                     ,input p-log-handle
     1021                     ,input (string(p-obj-code) + chr(4) + 'A':U + chr(4) + 'group-BO')
     1022                     ) no-error .
     1023   end.
     1024   assign
     1025   v-character = '':U
     1026   v-character-new = '':U
     1027   v-first-time = no
     1028   .
     1029   find last buf_c-gds-prt where
     1030         buf_c-gds-prt.node-code = 0
     1031     AND buf_c-gds-prt.corr-user-db-num = 0   no-error.
     1032   run cd-attr-value in this-procedure (
     1033                                               input g#db-num
     1034                                             ,input p-obj-code
     1035                                             ,input buf_cash-desk.pos-type
     1036                                             ,input buf_cash-desk.cash-num
     1037                                             ,input 'INFOKIOSK_operative':U
     1038                                             ,input 'last-prt-change':U
     1039                                             ,output v-character
     1040                                             ,output v-date
     1041                                             ,output v-decimal
     1042                                             ,output v-integer
     1043                                             ,output v-logical
     1044                                             ,output v-attr-type     ) no-error.
     1045   if error-status:error
     1046   or v-character = '':U
     1047   or not available buf_c-gds-prt
     1048   or integer(entry(3, v-character, chr(32) )) < buf_c-gds-prt.chip-num
     1049   then do:
     1050     if not available buf_c-gds-prt
     1051     or v-character = '':U
     1052     then do:
     1053       run cur-time in this-procedure(output v-today, output v-time).
     1054       v-first-time = yes.
     1055     end.
     1056     assign
     1057     v-character-new =  (if available buf_c-gds-prt
     1058                           then
     1059                           (string(buf_c-gds-prt.corr-date, "99/99/9999") + chr(32) +
     1060                           string(buf_c-gds-prt.corr-time, "hh:mm:ss") + chr(32) +
     1061                           string(buf_c-gds-prt.chip-num)
     1062                           )
     1063                           else
     1064                           (string(v-today, "99/99/9999") + chr(32) +
     1065                           string(v-time, "hh:mm:ss") + chr(32) +
     1066                           string(current-value (s-gds-grp-chip, ub))
     1067                           )
     1068                         )
     1069     .
     1070     if v-character <> v-character-new then do:
     1071       run cd-attr-write  in this-procedure (
     1072                                               input g#db-num
     1073                                               ,input p-obj-code
     1074                                               ,input buf_cash-desk.pos-type
     1075                                               ,input buf_cash-desk.cash-num
     1076                                               ,input 'INFOKIOSK_operative':U
     1077                                               ,input 'last-prt-change':U
     1078                                               ,input v-character-new
     1079                                               ,input ?
     1080                                               ,input 0.0
     1081                                               ,input 0
     1082                                               ,input no
     1083                                             ) no-error.
     1084     end.
     1085   end.
     1086   if v-character-new = '':U then do:
     1087     assign
     1088     v-character-new = v-character.
     1089   end.
     1090   if p-necessary = yes
     1091   or (available buf_c-gds-prt
     1092   and integer(entry(3, v-character-new, chr(32) )) < buf_c-gds-prt.chip-num)
     1093   or v-first-time
     1094   or (not available buf_c-gds-prt
     1095       and
     1096       (date(entry(1, v-character-new, chr(32) )) < v-today
     1097       or
     1098       (date(entry(1, v-character-new, chr(32) )) = v-today
     1099       and
     1100       integer(entry(2, v-character-new, chr(32) )) < v-time
     1101       )
     1102       )
     1103     )
     1104   then do:
     1105     run write-log-and-file in p-log-handle (
     1106           input 1
     1107         , input log-file-name
     1108         , input 1
     1109         , input substitute( "Пересылка шкал")) .
     1110     run str/sendgrup.p (
     1111                     input parparentproc
     1112                     ,input p-parent-handle
     1113                     ,input p-log-handle
     1114                     ,input (string(p-obj-code) + chr(4) + 'A':U + chr(4) + 'gds-prt')
     1115                     ) no-error .
     1116   end.
     1117   finally :
     1118       run write-log-and-file in p-log-handle (
     1119           input 1
     1120         , input log-file-name
     1121         , input 1
     1122         , input substitute("&1", chr(10))
     1123       ).
     1124     define variable v-save-file-name as character no-undo .
     1125     v-save-file-name = substitute("&1send-cd.log", ibs.th.gbl.gbl-inipar:logDir) .
     1126     OS-APPEND value(log-file-name) value(v-save-file-name).
     1127     OS-DELETE value(log-file-name).
     1128   end finally .
