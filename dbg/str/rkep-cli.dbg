     2324   X_cd-clu.charkey_one COLUMN-LABEL "Имя на кассе R-KEEPER" FORMAT "X(30)":U
     2325   get-crole-diff(BUFFER X_staff) @ v-role COLUMN-LABEL "Д" FORMAT "+/-"
     2326   get-cname-diff(BUFFER X_clients) @ v-name COLUMN-LABEL "Н" FORMAT "+/-"
     2327   X_cd-clu.cli-code COLUMN-LABEL "Код в IBS TH" FORMAT ">>>>>>>>9":U
     2328   X_clients.obj-name COLUMN-LABEL "Имя в IBS TH" FORMAT "X(30)":U
     2329   X_staff.staff-code COLUMN-LABEL "Код персонала!в IBS TH" FORMAT ">>>>9"
     2330   ENABLE X_cd-clu.charkey_one
     2331       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 17.75 FIT-LAST-COLUMN.
