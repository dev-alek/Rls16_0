     2321         mark-string( recid(X_cd-clu), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     2322   X_cd-clu.clu-code  COLUMN-LABEL "Идентиф-р"  FORMAT "9999":U
