     2459   loc-doc-rec = recid(X_cd-clu).
     2460   IF X_cd-clu.clu-type = "B":U
     2461   OR X_cd-clu.clu-type = "M":U THEN DO:
     2462     run gbl/d-askw.w ( input "Выбор должности для связывания записи",
     2463                         input ( "Вы хотите связать данную запись с должностью"
     2464                                   ),
     2465                         input "|",
     2466                         input "Кассира|Официанта(продавца)|Отказ от связывания",
     2467                         input "||",
     2468                         input 1,
     2469                         input 3,
     2470                         output choice).
     2471     if choice = 4 then return.
     2472   END.
     2473   ELSE DO:
     2474     IF X_cd-clu.clu-type = "W" THEN choice = 2.
     2475     IF X_cd-clu.clu-type = "K" THEN choice = 1.
     2476   END.
     2477   run ref/staffs.w (
     2478                     input parparentproc
     2479                   , input "b-sel,b-mark"
     2480                   , input (if choice = 2 then 'S':U else 'C':U)
     2481                   , input v-db-num
     2482                   , input 0
     2483                   , output varrid-list ) .
     2484   if varrid-list = "" then undo, return no-apply.
     2485   run proc-b-link in this-procedure ( INPUT recid(X_cd-clu), input integer(varrid-list)) no-error.
     2486   if error-status:error then return no-apply.
     2487   RUn OpenBR in this-procedure (input  yes, input no, input '':U).
     2488   reposition br-rkep-cli to recid loc-doc-rec no-error.
     2489   if error-status:error then do:                           find first pos_cd-clu no-lock where                                   recid(pos_cd-clu) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи ПЕРСОНАЛА" skip                            string(if avail pos_cd-clu                                     then  substitute("Идентификатор: &1, название &2"                                                     , pos_cd-clu.clu-code                                                      , pos_cd-clu.charkey_one)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     2490   apply "entry" to br-rkep-cli in frame Dialog-Frame.
     2491   apply "value-changed" to br-rkep-cli in frame Dialog-Frame.
     2492   END.
     2493   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     2494   DO:
     2495   define variable loc#log as logical no-undo .
     2496     if available X_cd-clu then do:
     2497   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2498   define variable v-str-recid19 as character no-undo .
     2499   define variable v-num-entry19 as integer   no-undo .
     2500   assign
     2501     v-str-recid19 = trim( string( recid( X_cd-clu ) , "->>>>>>>>>>>9":U ) )
     2502     v-num-entry19 = lookup( v-str-recid19 , v-rid-list )
     2503   .
     2504   if v-num-entry19 > 0 then do:
     2505     assign
     2506       entry( v-num-entry19, v-rid-list ) = "":U
     2507       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2508     .
     2509   end.
     2510   else do:
     2511     assign
     2512       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid19
     2513     .
     2514   end.
     2515       loc#log = br-rkep-cli:refresh() .
     2516       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     2517           loc#log = br-rkep-cli:select-next-row ().
     2518           apply "VALUE-CHANGED" to br-rkep-cli in frame Dialog-Frame.
     2519       end.
     2520       if num-entries( v-rid-list ) = 0
     2521       then
     2522           hide mark-num in frame Dialog-Frame.
     2523       else
     2524           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     2525     end.
     2526     apply "entry" to br-rkep-cli in frame Dialog-Frame.
     2527   END.
     2528   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     2529   DO:
     2530     if not avail X_cd-clu then return no-apply.
     2531     run proc-b-print in this-procedure  no-error.
     2532     if error-status:error then do:
     2533        return no-apply.
     2534     end.
     2535     APPLY "ENTRY" to br-rkep-cli.
     2536   END.
     2537   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     2538   DO:
     2539     run proc-b-sch in this-procedure no-error.
     2540     if error-status:error then return no-apply.
     2541   END.
     2542   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     2543   DO:
     2544     if ( available X_cd-clu ) then do:
     2545       if ( v-rid-list = "" ) or b-mark:sensitive = no then
     2546       v-rid-list = string( recid( X_cd-clu ) ) .
     2547     end.
     2548   END.
     2549   ON VALUE-CHANGED OF rs-mode IN FRAME Dialog-Frame
     2550   DO:
     2551     ASSIGN
     2552     rs-mode
     2553     v-mode = rs-mode
     2554     .
     2555     CASE rs-mode:
     2556         WHEN "+":U THEN DO:
     2557             ENABLE
     2558             b-chg
     2559             T-role
     2560             T-name
     2561             T-batch
     2562             WITH FRAME Dialog-Frame.
     2563         END.
     2564         OTHERWISE do:
     2565             ASSIGN
     2566             t-role = NO
     2567             t-name = NO
     2568             t-batch = NO    .
     2569             DISPLAY
     2570             t-role
     2571             t-name
     2572             t-batch
     2573             WITH FRAME Dialog-Frame.
     2574             DISABLE
     2575             T-role
     2576             T-name
     2577             t-batch
     2578             b-chg
     2579             WITH FRAME Dialog-Frame.
     2580       END.
     2581     END CASE.
     2582     run openbr IN THIS-PROCEDURE (input  YES, input  NO, input  '':U) NO-ERROR.
     2583     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     2584   END.
     2585   ON VALUE-CHANGED OF RS-sch IN FRAME Dialog-Frame
     2586   DO:
     2587     run proc-rs-sch IN THIS-PROCEDURE NO-ERROR.
     2588     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     2589   END.
     2590   ON CTRL-J OF sch-id IN FRAME Dialog-Frame
     2591   DO:
     2592     run proc-find-id in this-procedure (input yes, input frame Dialog-Frame sch-id) no-error.
     2593     if error-status:error then return no-apply.
     2594   END.
     2595   ON RETURN OF sch-id IN FRAME Dialog-Frame
     2596   DO:
     2597     run proc-find-id in this-procedure (input no, input frame Dialog-Frame sch-id) no-error.
     2598     if error-status:error then return no-apply.
     2599   END.
     2600   ON CTRL-J OF sch-name IN FRAME Dialog-Frame
     2601   DO:
     2602     run proc-find-name in this-procedure (input  yes, input frame Dialog-Frame sch-name) no-error.
     2603     if error-status:error then return no-apply.
     2604   END.
     2605   ON RETURN OF sch-name IN FRAME Dialog-Frame
     2606   DO:
     2607     run proc-find-name in this-procedure (input no, input frame Dialog-Frame sch-name) no-error.
     2608     if error-status:error then return no-apply.
     2609   END.
     2610   ON VALUE-CHANGED OF T-batch IN FRAME Dialog-Frame
     2611   DO:
     2612   define variable GLOG as logical no-undo .
     2613     assign
     2614     t-batch.
     2615     run proc-buttons in this-procedure (input t-batch).
     2616     if t-batch = no
     2617     and b-mark:sensitive = no then do:
     2618       assign
     2619       v-rid-list = "":U.
     2620       if avail X_cd-clu then
     2621       GLOG = BR-rkep-cli:refresh().
     2622     end.
     2623   END.
     2624   ON VALUE-CHANGED OF T-name IN FRAME Dialog-Frame
     2625   DO:
     2626     ASSIGN
     2627     t-name
     2628     .
     2629     run openbr IN THIS-PROCEDURE ( input YES, input  NO, input '':U) NO-ERROR.
     2630     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     2631   END.
     2632   ON VALUE-CHANGED OF T-role IN FRAME Dialog-Frame
     2633   DO:
     2634     ASSIGN
     2635     t-role
     2636     .
     2637     case t-role :
     2638         WHEN YES THEN DISABLE b-chg WITH FRAME Dialog-Frame.
     2639         WHEN no THEN enable b-chg WITH FRAME Dialog-Frame.
     2640     END CASE.
     2641     RUN openbr IN THIS-PROCEDURE ( input  YES, input NO, input '':U) NO-ERROR.
     2642     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     2643   END.
     2644   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2645   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2646   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2647   on help of frame Dialog-Frame
     2648   do:
     2649     run gbl/app_help.p
     2650       (input this-procedure :file-name
     2651       ,input ''
     2652       ,input ?
     2653       ) no-error.
     2654     if error-status :error then do:
     2655       message
     2656         "Ошибка при вызове помощи"
     2657         error-status :get-message(1)
     2658         view-as alert-box .
     2659     end.
     2660   end.
     2661   run minbtn-set in this-procedure .
     2662   on choose of b-help in frame Dialog-Frame
     2663   do:
     2664     apply "help":u to frame Dialog-Frame .
     2665   end.
     2666   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2667   procedure minbtn-set :
     2668       do
     2669           on error undo, return error return-value
     2670           :
     2671           define variable ii              as integer       no-undo .
     2672           define variable fh              as widget-handle no-undo .
     2673           define variable hh              as widget-handle no-undo .
     2674           define variable v-h             as handle        extent 4 no-undo .
     2675           define variable v-name-button   as character     no-undo .
     2676           define variable v-help-old-x    as decimal       no-undo .
     2677           define variable v-help-old-y    as decimal       no-undo .
     2678           define variable v-help-old-size as decimal       no-undo .
     2679           define variable v-frame-width   as decimal       no-undo .
     2680           define variable jj              as integer       no-undo .
     2681           do
     2682               on error undo, return error
     2683               :
     2684               assign
     2685                   v-frame-width = frame Dialog-Frame:width - 0.3
     2686                   fh            = frame Dialog-Frame:first-child
     2687                   hh            = fh:first-child
     2688                   ii            = 1
     2689                   .
     2690               do while valid-handle(hh):
     2691                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2692                   do:
     2693                       case lc(hh:name) :
     2694                           when "b-help" then
     2695                               do:
     2696                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2697                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2698                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2699                                   hh:TOOLTIP = "Помощь" .
     2700                                   v-help-old-x = hh:column .
     2701                                   v-help-old-y = hh:row    .
     2702                                   v-help-old-size = hh:width .
     2703                                   hh:width-chars = 2.5 .
     2704                               end.
     2705                           when "b-print" then
     2706                               do:
     2707                                   hh:load-image("cmp/b-print.bmp":u) .
     2708                                   hh:TOOLTIP = "Печать" .
     2709                                   v-h[ii] = hh:handle .
     2710                                   ii = ii + 1 .
     2711                                   hh:width-chars = 3 .
     2712                               end.
     2713                           when "b-history" or
     2714                           when "b-hist" then
     2715                               do:
     2716                                   hh:load-image("cmp/b-hist.bmp":u) .
     2717                                   hh:TOOLTIP = "История" .
     2718                                   v-h[ii] = hh:handle .
     2719                                   ii = ii + 1 .
     2720                                   hh:width-chars = 3 .
     2721                               end.
     2722                           when "b-sch" then
     2723                               do:
     2724                                   hh:load-image("cmp/b-sch.bmp":u) .
     2725                                   hh:TOOLTIP = "Установка Фильтра" .
     2726                                   v-h[ii] = hh:handle .
     2727                                   ii = ii + 1 .
     2728                                   hh:width-chars = 3 .
     2729                               end.
     2730                           when "b-hist-user" then
     2731                               do:
     2732                                   hh:load-image("cmp/b-hist.bmp":u) .
     2733                                   hh:TOOLTIP = "История пользователя" .
     2734                                   ii = ii + 1 .
     2735                               end.
     2736                       end case.
     2737                   end.
     2738                   hh = hh:next-sibling.
     2739               end.
     2740               b-help:column = v-frame-width - b-help:width-chars.
     2741               jj = 0.
     2742               repeat ii = 4 to 1 by -1 :
     2743                   if valid-handle (v-h[ii] ) then
     2744                   do:
     2745                       jj  = jj + 1 .
     2746                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2747                       v-h[ii]:row    = v-help-old-y .
     2748                   end.
     2749               end.
     2750           end.
     2751       end.
     2752   end procedure.
     2753   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2754   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2755   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2756   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2757   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2758   define variable v-diasize-current-frame-height as decimal   no-undo .
     2759   define variable v-diasize-change-size          as logical   no-undo .
     2760   define variable v-diasize-resize-button        as handle    no-undo .
     2761   define variable v-diasize-wndmax               as logical   no-undo .
     2762   define variable v-diasize-wndstore             as logical   no-undo .
     2763   define variable v-diasize-proc-name            as character no-undo .
     2764   define variable v-diasize-browse-handle        as handle    no-undo .
     2765   define variable v-diasize-browse-number        as integer   no-undo .
     2766   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2767   define temp-table temp-diasize-handle no-undo
     2768     field handle-value  as handle
     2769     field save-position as decimal
     2770     index xpk is primary unique handle-value
     2771     .
     2772   define temp-table temp-browse-handle no-undo
     2773     field browse-type   as character
     2774     field browse-number as integer
     2775     field browse-handle as handle
     2776     field original-size as decimal
     2777     index xpk is primary unique browse-type browse-number
     2778     index xie browse-type browse-handle
     2779   .
     2780   procedure diasize_change-height :
     2781     define input  parameter p-change-value  as decimal   no-undo .
     2782     define input  parameter p-move-resize   as logical   no-undo .
     2783     define variable v-field-group-handle    as handle    no-undo .
     2784     define variable v-object-handle         as handle    no-undo .
     2785     define variable v-frame-height          as decimal   no-undo .
     2786     define variable v-frame-virtual-height  as decimal   no-undo .
     2787     define variable v-browse-height         as decimal   no-undo .
     2788     define variable v-window-height         as decimal   no-undo .
     2789     define variable v-window-virtual-height as decimal   no-undo .
     2790     define variable v-change-sign           as integer   no-undo .
     2791     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2792     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2793     if p-change-value > 0
     2794     then do:
     2795       if frame Dialog-Frame :height + p-change-value
     2796           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2797       then do:
     2798         assign
     2799           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2800                           - (frame Dialog-Frame :height-chars)
     2801         .
     2802         if p-change-value <= 0
     2803         then do:
     2804           run diasize_position-resize-button in this-procedure .
     2805           return .
     2806         end.
     2807       end.
     2808     end.
     2809     if p-change-value < 0
     2810     then do:
     2811       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2812       then do:
     2813         assign
     2814           p-change-value = v-diasize-orig-frame-height
     2815                          - (frame Dialog-Frame :height-chars)
     2816         .
     2817         if p-change-value >= 0
     2818         then do:
     2819           run diasize_position-resize-button in this-procedure .
     2820           return .
     2821         end.
     2822       end.
     2823     end.
     2824     if p-change-value >= 0
     2825     then do:
     2826       assign
     2827         v-change-sign = 1
     2828       .
     2829     end.
     2830     else do:
     2831       assign
     2832         v-change-sign = -1
     2833       .
     2834     end.
     2835     assign
     2836       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2837     .
     2838     if p-change-value = 0
     2839     then do:
     2840       run diasize_position-resize-button in this-procedure .
     2841       return .
     2842     end.
     2843     move_block:
     2844     do
     2845     on error undo move_block, retry move_block
     2846     :
     2847       if retry
     2848       then do:
     2849         do
     2850         on error undo move_block, leave move_block
     2851         :
     2852           if p-change-value > 0
     2853           then do:
     2854             for each buf_temp-diasize-handle
     2855             on error undo, next
     2856             :
     2857               assign
     2858                 v-object-handle = buf_temp-diasize-handle.handle-value
     2859               .
     2860               if v-object-handle <> v-diasize-resize-button
     2861               then do:
     2862                 assign
     2863                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2864                 .
     2865               end.
     2866             end.
     2867             assign
     2868               v-diasize-browse-handle :height = v-browse-height
     2869             .
     2870             for each buf_temp-browse-handle
     2871               where buf_temp-browse-handle.browse-type = 'height':u
     2872             on error undo, next
     2873             :
     2874               assign
     2875                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2876               .
     2877             end.
     2878             assign
     2879               frame Dialog-Frame :height = v-frame-height
     2880             .
     2881             if frame Dialog-Frame :scrollable = true
     2882             then do:
     2883               assign
     2884                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2885               .
     2886             end.
     2887             run diasize_position-resize-button in this-procedure .
     2888           end.
     2889           else do:
     2890             if frame Dialog-Frame :scrollable = true
     2891             then do:
     2892               assign
     2893                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2894               .
     2895             end.
     2896             assign
     2897               frame Dialog-Frame :height = v-frame-height
     2898             .
     2899             assign
     2900               v-diasize-browse-handle :height = v-browse-height
     2901             .
     2902             for each buf_temp-browse-handle
     2903               where buf_temp-browse-handle.browse-type = 'height':u
     2904             on error undo, next
     2905             :
     2906               assign
     2907                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2908               .
     2909             end.
     2910             for each buf_temp-diasize-handle
     2911             on error undo, next
     2912             :
     2913               assign
     2914                 v-object-handle = buf_temp-diasize-handle.handle-value
     2915               .
     2916               if v-object-handle <> v-diasize-resize-button
     2917               then do:
     2918                 assign
     2919                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2920                 .
     2921               end.
     2922             end.
     2923             run diasize_position-resize-button in this-procedure .
     2924           end.
     2925           assign
     2926             v-diasize-change-size = false
     2927           .
     2928           leave move_block .
     2929         end.
     2930       end.
     2931       assign
     2932         v-diasize-need-full-display = true
     2933       .
     2934       if v-diasize-change-size = false
     2935       then do:
     2936         assign
     2937           v-diasize-change-size = true
     2938         .
     2939       end.
     2940       else do:
     2941         return .
     2942       end.
     2943       assign
     2944         v-frame-height = frame Dialog-Frame :height
     2945         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2946         v-browse-height = v-diasize-browse-handle :height
     2947       .
     2948       for each buf_temp-browse-handle
     2949         where buf_temp-browse-handle.browse-type = 'height':u
     2950       :
     2951         assign
     2952           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2953         .
     2954       end.
     2955       for each buf_temp-diasize-handle
     2956       :
     2957         delete buf_temp-diasize-handle .
     2958       end.
     2959       assign
     2960         v-field-group-handle = frame Dialog-Frame :first-child
     2961       .
     2962       do while valid-handle(v-field-group-handle)
     2963       :
     2964         assign
     2965           v-object-handle = v-field-group-handle :first-child
     2966         .
     2967         do while valid-handle(v-object-handle)
     2968         :
     2969           if  v-object-handle <> v-diasize-browse-handle :handle
     2970           and can-query(v-object-handle, "row")
     2971           and can-query(v-object-handle, "height")
     2972           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2973           then do:
     2974             find first buf_temp-browse-handle
     2975               where buf_temp-browse-handle.browse-type   = 'height':u
     2976                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2977               no-error .
     2978             if available buf_temp-browse-handle
     2979             then do:
     2980             end.
     2981             else do:
     2982               create buf_temp-diasize-handle .
     2983               assign
     2984                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2985                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2986               .
     2987             end.
     2988           end.
     2989           assign
     2990             v-object-handle = v-object-handle :next-sibling
     2991           .
     2992         end.
     2993         assign
     2994           v-field-group-handle = v-field-group-handle :next-sibling
     2995         .
     2996       end.
     2997       do with frame Dialog-Frame
     2998       :
     2999         hide v-diasize-resize-button .
     3000         assign
     3001           v-diasize-resize-button :row    = 1
     3002           v-diasize-resize-button :column = 1
     3003         .
     3004       end.
     3005       if p-change-value > 0
     3006       then do:
     3007         if frame Dialog-Frame :scrollable = true
     3008         then do:
     3009           assign
     3010             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3011             no-error .
     3012           if error-status :error
     3013           or error-status :get-message(1) <> ""
     3014           then do:
     3015             undo move_block, retry move_block .
     3016           end.
     3017         end.
     3018         assign
     3019           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3020           no-error .
     3021         if error-status :error
     3022         or error-status :get-message(1) <> ""
     3023         then do:
     3024           undo move_block, retry move_block .
     3025         end.
     3026         assign
     3027           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3028           no-error .
     3029         if error-status :error
     3030         or error-status :get-message(1) <> ""
     3031         then do:
     3032           undo move_block, retry move_block .
     3033         end.
     3034         for each buf_temp-browse-handle
     3035           where buf_temp-browse-handle.browse-type = 'height':u
     3036         on error undo move_block, retry move_block
     3037         :
     3038           assign
     3039             buf_temp-browse-handle.browse-handle :height
     3040               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3041             no-error .
     3042           if error-status :error
     3043           or error-status :get-message(1) <> ""
     3044           then do:
     3045             undo move_block, retry move_block .
     3046           end.
     3047         end.
     3048         for each buf_temp-diasize-handle
     3049         on error undo move_block, retry move_block
     3050         :
     3051           assign
     3052             v-object-handle = buf_temp-diasize-handle.handle-value
     3053           .
     3054           if v-object-handle <> v-diasize-resize-button
     3055           then do:
     3056             assign
     3057               v-object-handle :row = v-object-handle :row + p-change-value
     3058               no-error .
     3059             if error-status :error
     3060             or error-status :get-message(1) <> ""
     3061             then do:
     3062               undo move_block, retry move_block .
     3063             end.
     3064           end.
     3065         end.
     3066       end.
     3067       else do:
     3068         for each buf_temp-diasize-handle
     3069         on error undo move_block, retry move_block
     3070         :
     3071           assign
     3072             v-object-handle = buf_temp-diasize-handle.handle-value
     3073           .
     3074           if v-object-handle <> v-diasize-resize-button
     3075           then do:
     3076             assign
     3077               v-object-handle :row = v-object-handle :row + p-change-value
     3078               no-error .
     3079             if error-status :error
     3080             or error-status :get-message(1) <> ""
     3081             then do:
     3082               undo move_block, retry move_block .
     3083             end.
     3084           end.
     3085         end.
     3086         assign
     3087           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3088           no-error .
     3089         if error-status :error
     3090         or error-status :get-message(1) <> ""
     3091         then do:
     3092           undo move_block, retry move_block .
     3093         end.
     3094         for each buf_temp-browse-handle
     3095           where buf_temp-browse-handle.browse-type = 'height':u
     3096         on error undo move_block, retry move_block
     3097         :
     3098           assign
     3099             buf_temp-browse-handle.browse-handle :height
     3100               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3101             no-error .
     3102           if error-status :error
     3103           or error-status :get-message(1) <> ""
     3104           then do:
     3105             undo move_block, retry move_block .
     3106           end.
     3107         end.
     3108         assign
     3109           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3110           no-error .
     3111         if error-status :error
     3112         or error-status :get-message(1) <> ""
     3113         then do:
     3114           undo move_block, retry move_block .
     3115         end.
     3116         if frame Dialog-Frame :scrollable = true
     3117         then do:
     3118           assign
     3119             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3120             no-error .
     3121           if error-status :error
     3122           or error-status :get-message(1) <> ""
     3123           then do:
     3124             undo move_block, retry move_block .
     3125           end.
     3126         end.
     3127       end.
     3128       if p-move-resize = true
     3129       then do:
     3130         run diasize_position-resize-button in this-procedure .
     3131       end.
     3132       if v-diasize-wndstore = true
     3133       then do:
     3134         if connected("ub") = true
     3135         then do:
     3136           define variable v-cntxt-db-num        as integer   no-undo .
     3137           define variable v-cntxt-userid        as character no-undo .
     3138           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3139                                             , OUTPUT v-cntxt-userid
     3140                                             ) .
     3141           run gbl/wndsizew.p
     3142             (input  v-cntxt-db-num
     3143             ,input  v-cntxt-userid
     3144             ,input  v-diasize-proc-name
     3145             ,input  'height':u
     3146             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3147             ) .
     3148         end.
     3149       end.
     3150     end.
     3151     assign
     3152       v-diasize-change-size = false
     3153     .
     3154   end procedure.
     3155   procedure diasize_set-height :
     3156     define input  parameter p-new-height  as decimal   no-undo .
     3157     define input  parameter p-move-resize as logical   no-undo .
     3158     do
     3159     on error undo, return error return-value
     3160     :
     3161       run diasize_change-height in this-procedure
     3162         (input  (p-new-height - frame Dialog-Frame :height)
     3163         ,input  p-move-resize
     3164         ) .
     3165     end.
     3166   end procedure.
     3167   procedure diasize_change-width :
     3168     define input  parameter p-change-value as decimal   no-undo .
     3169     define input  parameter p-move-resize  as logical   no-undo .
     3170     define variable v-field-group-handle   as handle    no-undo .
     3171     define variable v-object-handle        as handle    no-undo .
     3172     define variable v-frame-width          as decimal   no-undo .
     3173     define variable v-frame-virtual-width  as decimal   no-undo .
     3174     define variable v-browse-width         as decimal   no-undo .
     3175     define variable v-window-width         as decimal   no-undo .
     3176     define variable v-window-virtual-width as decimal   no-undo .
     3177     define variable v-change-sign          as integer   no-undo .
     3178     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3179     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3180     if p-change-value > 0
     3181     then do:
     3182       if frame Dialog-Frame :width + p-change-value >
     3183           session :width-chars
     3184       then do:
     3185         assign
     3186           p-change-value = session :width-chars - frame Dialog-Frame :width
     3187         .
     3188         if p-change-value <= 0
     3189         then do:
     3190           run diasize_position-resize-button in this-procedure .
     3191           return .
     3192         end.
     3193       end.
     3194     end.
     3195     if p-change-value < 0
     3196     then do:
     3197       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3198       then do:
     3199         assign
     3200           p-change-value = v-diasize-orig-frame-width
     3201                          - frame Dialog-Frame :width
     3202         .
     3203         if p-change-value >= 0
     3204         then do:
     3205           run diasize_position-resize-button in this-procedure .
     3206           return .
     3207         end.
     3208       end.
     3209     end.
     3210     if p-change-value >= 0
     3211     then do:
     3212       assign
     3213         v-change-sign = 1
     3214       .
     3215     end.
     3216     else do:
     3217       assign
     3218         v-change-sign = -1
     3219       .
     3220     end.
     3221     assign
     3222       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3223     .
     3224     if p-change-value = 0
     3225     then do:
     3226       run diasize_position-resize-button in this-procedure .
     3227       return .
     3228     end.
     3229     move_block:
     3230     do
     3231     on error undo move_block, leave move_block
     3232     :
     3233       if retry
     3234       then do:
     3235         do
     3236         on error undo move_block, leave move_block
     3237         :
     3238           if p-change-value > 0
     3239           then do:
     3240             for each buf_temp-diasize-handle
     3241             on error undo, next
     3242             :
     3243               assign
     3244                 v-object-handle = buf_temp-diasize-handle.handle-value
     3245               .
     3246               if v-object-handle <> v-diasize-resize-button
     3247               then do:
     3248                 assign
     3249                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3250                 .
     3251               end.
     3252             end.
     3253             assign
     3254               v-diasize-browse-handle :width = v-browse-width
     3255             .
     3256             for each buf_temp-browse-handle
     3257               where buf_temp-browse-handle.browse-type = 'width':u
     3258             on error undo, next
     3259             :
     3260               assign
     3261                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3262               .
     3263             end.
     3264             assign
     3265               frame Dialog-Frame :width = v-frame-width
     3266             .
     3267             if frame Dialog-Frame :scrollable = true
     3268             then do:
     3269               assign
     3270                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3271               .
     3272             end.
     3273             run diasize_position-resize-button in this-procedure .
     3274           end.
     3275           else do:
     3276             if frame Dialog-Frame :scrollable = true
     3277             then do:
     3278               assign
     3279                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3280               .
     3281             end.
     3282             assign
     3283               frame Dialog-Frame :width = v-frame-width
     3284             .
     3285             for each buf_temp-browse-handle
     3286               where buf_temp-browse-handle.browse-type = 'width':u
     3287             on error undo, next
     3288             :
     3289               assign
     3290                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3291               .
     3292             end.
     3293             assign
     3294               v-diasize-browse-handle :width = v-browse-width
     3295             .
     3296             for each buf_temp-diasize-handle
     3297             on error undo, next
     3298             :
     3299               assign
     3300                 v-object-handle = buf_temp-diasize-handle.handle-value
     3301               .
     3302               if v-object-handle <> v-diasize-resize-button
     3303               then do:
     3304                 assign
     3305                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3306                 .
     3307               end.
     3308             end.
     3309             run diasize_position-resize-button in this-procedure .
     3310           end.
     3311           assign
     3312             v-diasize-change-size = false
     3313           .
     3314           leave move_block .
     3315         end.
     3316       end.
     3317       assign
     3318         v-diasize-need-full-display = true
     3319       .
     3320       if v-diasize-change-size = false
     3321       then do:
     3322         assign
     3323           v-diasize-change-size = true
     3324         .
     3325       end.
     3326       else do:
     3327         return .
     3328       end.
     3329       assign
     3330         v-frame-width = frame Dialog-Frame :width
     3331         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3332         v-browse-width = v-diasize-browse-handle :width
     3333       .
     3334       for each buf_temp-browse-handle
     3335         where buf_temp-browse-handle.browse-type = 'width':u
     3336       :
     3337         assign
     3338           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3339         .
     3340       end.
     3341       for each buf_temp-diasize-handle
     3342       :
     3343         delete buf_temp-diasize-handle .
     3344       end.
     3345       assign
     3346         v-field-group-handle = frame Dialog-Frame :first-child
     3347       .
     3348       do while valid-handle(v-field-group-handle)
     3349       :
     3350         assign
     3351           v-object-handle = v-field-group-handle :first-child
     3352         .
     3353         do while valid-handle(v-object-handle)
     3354         :
     3355           if  v-object-handle <> v-diasize-browse-handle :handle
     3356           and v-object-handle <> v-diasize-resize-button
     3357           and can-query(v-object-handle, "row")
     3358           and can-query(v-object-handle, "height")
     3359           and ( v-object-handle :col + v-object-handle :width
     3360                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3361               )
     3362           then do:
     3363             find first buf_temp-browse-handle
     3364               where buf_temp-browse-handle.browse-type   = 'width':u
     3365                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3366               no-error .
     3367             if available buf_temp-browse-handle
     3368             then do:
     3369             end.
     3370             else do:
     3371               create buf_temp-diasize-handle .
     3372               assign
     3373                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3374                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3375               .
     3376             end.
     3377           end.
     3378           assign
     3379             v-object-handle = v-object-handle :next-sibling
     3380           .
     3381         end.
     3382         assign
     3383           v-field-group-handle = v-field-group-handle :next-sibling
     3384         .
     3385       end.
     3386       do with frame Dialog-Frame
     3387       :
     3388         hide v-diasize-resize-button .
     3389         v-diasize-resize-button :row = 1.
     3390         v-diasize-resize-button :column = 1.
     3391       end.
     3392       if p-change-value > 0
     3393       then do:
     3394         if frame Dialog-Frame :scrollable = true
     3395         then do:
     3396           assign
     3397             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3398             no-error .
     3399           if error-status :error
     3400           or error-status :get-message(1) <> ""
     3401           then do:
     3402             undo move_block, retry move_block.
     3403           end.
     3404         end.
     3405         assign
     3406           frame Dialog-Frame :width = v-frame-width + p-change-value
     3407           no-error .
     3408         if error-status :error
     3409         or error-status :get-message(1) <> ""
     3410         then do:
     3411           undo move_block, retry move_block.
     3412         end.
     3413         assign
     3414           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3415         no-error .
     3416         if error-status :error
     3417         or error-status :get-message(1) <> ""
     3418         then do:
     3419           undo move_block, retry move_block.
     3420         end.
     3421         for each buf_temp-browse-handle
     3422           where buf_temp-browse-handle.browse-type = 'width':u
     3423         on error undo move_block, retry move_block
     3424         :
     3425           assign
     3426             buf_temp-browse-handle.browse-handle :width
     3427               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3428             no-error .
     3429           if error-status :error
     3430           or error-status :get-message(1) <> ""
     3431           then do:
     3432             undo move_block, retry move_block .
     3433           end.
     3434         end.
     3435         for each buf_temp-diasize-handle
     3436         on error undo move_block, retry move_block
     3437         :
     3438           assign
     3439             v-object-handle = buf_temp-diasize-handle.handle-value
     3440           .
     3441           if v-object-handle <> v-diasize-resize-button
     3442           then do:
     3443             assign
     3444               v-object-handle :col = v-object-handle :col + p-change-value
     3445               no-error .
     3446             if error-status :error
     3447             or error-status :get-message(1) <> ""
     3448             then do:
     3449               undo move_block, retry move_block .
     3450             end.
     3451           end.
     3452         end.
     3453       end.
     3454       else do:
     3455         for each buf_temp-diasize-handle
     3456         on error undo move_block, retry move_block
     3457         :
     3458           assign
     3459             v-object-handle = buf_temp-diasize-handle.handle-value
     3460           .
     3461           if v-object-handle <> v-diasize-resize-button
     3462           then do:
     3463             assign
     3464               v-object-handle :col = v-object-handle :col + p-change-value
     3465               no-error .
     3466             if error-status :error
     3467             or error-status :get-message(1) <> ""
     3468             then do:
     3469               undo move_block, retry move_block .
     3470             end.
     3471           end.
     3472         end.
     3473         for each buf_temp-browse-handle
     3474           where buf_temp-browse-handle.browse-type = 'width':u
     3475         on error undo move_block, retry move_block
     3476         :
     3477           assign
     3478             buf_temp-browse-handle.browse-handle :width
     3479               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3480             no-error .
     3481           if error-status :error
     3482           or error-status :get-message(1) <> ""
     3483           then do:
     3484             undo move_block, retry move_block .
     3485           end.
     3486         end.
     3487         assign
     3488           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3489           no-error .
     3490         if error-status :error
     3491         or error-status :get-message(1) <> ""
     3492         then do:
     3493           undo move_block, retry move_block.
     3494         end.
     3495         assign
     3496           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3497         no-error .
     3498         if error-status :error
     3499         or error-status :get-message(1) <> ""
     3500         then do:
     3501           undo move_block, retry move_block.
     3502         end.
     3503         if frame Dialog-Frame :scrollable = true
     3504         then do:
     3505           assign
     3506             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3507           no-error .
     3508           if error-status :error
     3509           or error-status :get-message(1) <> ""
     3510           then do:
     3511             undo move_block, retry move_block.
     3512           end.
     3513         end.
     3514       end.
     3515       if p-move-resize
     3516       then do:
     3517         run diasize_position-resize-button in this-procedure .
     3518       end.
     3519       if v-diasize-wndstore = true
     3520       then do:
     3521         if connected("ub") = true
     3522         then do:
     3523           define variable v-cntxt-db-num        as integer   no-undo .
     3524           define variable v-cntxt-userid        as character no-undo .
     3525           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3526                                             , OUTPUT v-cntxt-userid
     3527                                             ) .
     3528           run gbl/wndsizew.p
     3529             (input  v-cntxt-db-num
     3530             ,input  v-cntxt-userid
     3531             ,input  v-diasize-proc-name
     3532             ,input  'width':u
     3533             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3534             ) .
     3535         end.
     3536       end.
     3537     end.
     3538     assign
     3539       v-diasize-change-size = false
     3540     .
     3541   end procedure.
     3542   procedure diasize_set-width :
     3543     define input  parameter p-new-width  as decimal   no-undo .
     3544     define input  parameter p-move-resize as logical   no-undo .
     3545     do
     3546     on error undo, return error return-value
     3547     :
     3548       run diasize_change-width in this-procedure
     3549         (input  (p-new-width - frame Dialog-Frame :width)
     3550         ,input  p-move-resize
     3551         ) .
     3552     end.
     3553   end procedure.
     3554   procedure diasize_position-resize-button :
     3555     do with frame Dialog-Frame
     3556     :
     3557       hide v-diasize-resize-button .
     3558       assign
     3559         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3560                     - 1
     3561                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3562         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3563                     - 1
     3564                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3565       .
     3566       view v-diasize-resize-button .
     3567     end.
     3568   end procedure.
     3569   on alt-right anywhere
     3570   do:
     3571     run diasize_change-width in this-procedure
     3572       (input 1
     3573       ,input true
     3574       ) .
     3575     return no-apply .
     3576   end.
     3577   on alt-left anywhere
     3578   do:
     3579     run diasize_change-width in this-procedure
     3580       (input -1
     3581       ,input true
     3582       ) .
     3583     return no-apply .
     3584   end.
     3585   on alt-down anywhere
     3586   do:
     3587     run diasize_change-height in this-procedure
     3588       (input 1
     3589       ,input true
     3590       ) .
     3591     return no-apply .
     3592   end.
     3593   on alt-up anywhere
     3594   do:
     3595     run diasize_change-height in this-procedure
     3596       (input -1
     3597       ,input true
     3598       ) .
     3599     return no-apply .
     3600   end.
     3601   on alt-enter of frame Dialog-Frame
     3602   do:
     3603     run diasize_maximize in this-procedure
     3604       (input  ?
     3605       ).
     3606     return no-apply .
     3607   end.
     3608   procedure diasize_end-move :
     3609     do
     3610     on error undo, return error return-value
     3611     :
     3612       define variable v-row-delta as decimal   no-undo .
     3613       define variable v-col-delta as decimal   no-undo .
     3614       define variable v-new-row as decimal   no-undo .
     3615       define variable v-new-col as decimal   no-undo .
     3616       assign
     3617         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3618         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3619       .
     3620       assign
     3621         v-row-delta = v-new-row - frame Dialog-Frame :height
     3622         v-col-delta = v-new-col - frame Dialog-Frame :width
     3623       .
     3624       run diasize_change-height in this-procedure
     3625         (input v-row-delta
     3626         ,input true
     3627         ) .
     3628       run diasize_change-width in this-procedure
     3629         (input v-col-delta
     3630         ,input true
     3631         ) .
     3632     end.
     3633   end procedure.
     3634   procedure diasize_maximize :
     3635     define input  parameter p-action as logical   no-undo .
     3636     do
     3637     on error undo, return error return-value
     3638     :
     3639       if p-action = ?
     3640       then do:
     3641         if v-diasize-need-maximize = true
     3642         then do:
     3643           assign
     3644             p-action = true
     3645           .
     3646         end.
     3647         else do:
     3648           assign
     3649             p-action = false
     3650           .
     3651         end.
     3652       end.
     3653       if p-action = true
     3654       then do:
     3655         run diasize_change-height in this-procedure
     3656           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3657               - frame Dialog-Frame :height-chars
     3658           ,input true
     3659           ) .
     3660         run diasize_change-width in this-procedure
     3661           (input session :width-chars
     3662               - frame Dialog-Frame :width-chars
     3663           ,input true
     3664           ) .
     3665         assign
     3666           v-diasize-need-maximize = false
     3667         .
     3668       end.
     3669       else do:
     3670         run diasize_change-width in this-procedure
     3671           (input v-diasize-orig-frame-width
     3672               - frame Dialog-Frame :width-chars
     3673           ,input true
     3674           ) .
     3675         run diasize_change-height in this-procedure
     3676           (input v-diasize-orig-frame-height
     3677               - frame Dialog-Frame :height-chars
     3678           ,input true
     3679           ) .
     3680         assign
     3681           v-diasize-need-maximize = true
     3682         .
     3683       end.
     3684     end.
     3685   end procedure.
     3686   procedure diasize_restore-orig-size :
     3687     do
     3688     on error undo, return error return-value
     3689     :
     3690       assign
     3691         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3692         v-diasize-current-frame-height = frame Dialog-Frame :height
     3693       .
     3694       run diasize_set-height in this-procedure
     3695         (input  v-diasize-orig-frame-height
     3696         ,input  true
     3697         ) .
     3698       run diasize_set-width in this-procedure
     3699         (input  v-diasize-orig-frame-width
     3700         ,input  true
     3701         ) .
     3702     end.
     3703   end procedure.
     3704   procedure diasize_restore-current-size :
     3705     do
     3706     on error undo, return error return-value
     3707     :
     3708       run diasize_set-height in this-procedure
     3709         (input  v-diasize-current-frame-height
     3710         ,input  true
     3711         ) .
     3712       run diasize_set-width in this-procedure
     3713         (input  v-diasize-current-frame-width
     3714         ,input  true
     3715         ) .
     3716     end.
     3717   end procedure.
     3718   procedure diasize_set-browse-handle :
     3719     define input  parameter p-browse-handle as handle   no-undo .
     3720     define buffer buf_temp-browse-handle for temp-browse-handle .
     3721     do
     3722     on error undo, return error return-value
     3723     :
     3724       assign
     3725         v-diasize-browse-handle = p-browse-handle
     3726       .
     3727       for each buf_temp-browse-handle
     3728       on error undo, return error return-value
     3729       :
     3730         delete buf_temp-browse-handle .
     3731       end.
     3732     end.
     3733   end procedure.
     3734   procedure diasize_add_browse :
     3735     define input  parameter p-browse-type   as character no-undo .
     3736     define input  parameter p-browse-handle as handle    no-undo .
     3737     define buffer buf_temp-browse-handle for temp-browse-handle .
     3738     do
     3739     on error undo, return error return-value
     3740     :
     3741       assign
     3742         v-diasize-browse-number = v-diasize-browse-number + 1
     3743       .
     3744       create buf_temp-browse-handle .
     3745       assign
     3746         buf_temp-browse-handle.browse-type   = p-browse-type
     3747         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3748         buf_temp-browse-handle.browse-handle = p-browse-handle
     3749       .
     3750     end.
     3751   end procedure.
     3752   procedure diasize_init :
     3753     define variable v-default-value    as logical   no-undo .
     3754     define variable v-restore-saved    as logical   no-undo .
     3755     define variable v-resize-value-str as character no-undo .
     3756     do
     3757     on error undo, return error return-value
     3758     :
     3759       do with frame Dialog-Frame
     3760       :
     3761         assign
     3762           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3763           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3764           v-diasize-browse-handle     = browse BR-rkep-cli :handle
     3765         .
     3766         create button v-diasize-resize-button
     3767         assign
     3768           parent        = frame Dialog-Frame :first-child
     3769           label         = "s"
     3770           height-pixels = 16
     3771           width-pixels  = 16
     3772           visible       = true
     3773           sensitive     = true
     3774           movable       = true
     3775           triggers:
     3776             on end-move persistent run diasize_end-move in this-procedure .
     3777           end triggers.
     3778         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3779         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3780         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3781         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3782         assign
     3783           v-diasize-wndmax = false
     3784         .
     3785         if connected("ub") = true
     3786         then do:
     3787           define variable v-cntxt-db-num        as integer   no-undo .
     3788           define variable v-cntxt-userid        as character no-undo .
     3789           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3790                                             , OUTPUT v-cntxt-userid
     3791                                             ) .
     3792           run gbl/wndpar_r.p
     3793             (input  v-cntxt-db-num
     3794             ,input  v-cntxt-userid
     3795             ,input  'wndmax':U
     3796             ,output v-diasize-wndmax
     3797             ,output v-default-value
     3798             ) .
     3799         end.
     3800         assign
     3801           v-diasize-wndstore = false
     3802         .
     3803         if connected("ub") = true
     3804         then do:
     3805           run gbl/wndpar_r.p
     3806             (input  v-cntxt-db-num
     3807             ,input  v-cntxt-userid
     3808             ,input  'wndstore':U
     3809             ,output v-diasize-wndstore
     3810             ,output v-default-value
     3811             ) .
     3812         end.
     3813         assign
     3814           v-diasize-proc-name = entry(1, program-name(2), '.')
     3815         .
     3816         if v-diasize-wndstore = true
     3817         then do:
     3818           assign
     3819             v-restore-saved = false
     3820           .
     3821           if connected("ub") = true
     3822           then do:
     3823             run gbl/wndsizer.p
     3824               (input  v-cntxt-db-num
     3825               ,input  v-cntxt-userid
     3826               ,input  v-diasize-proc-name
     3827               ,input  'height':u
     3828               ,output v-resize-value-str
     3829               ) .
     3830             if v-resize-value-str <> '':U
     3831             then do:
     3832               run diasize_change-height in this-procedure
     3833                 (input  integer(v-resize-value-str)
     3834                 ,input  true
     3835                 ) .
     3836               assign
     3837                 v-restore-saved = true
     3838               .
     3839             end.
     3840           end.
     3841           if connected("ub") = true
     3842           then do:
     3843             run gbl/wndsizer.p
     3844               (input  v-cntxt-db-num
     3845               ,input  v-cntxt-userid
     3846               ,input  v-diasize-proc-name
     3847               ,input  'width':u
     3848               ,output v-resize-value-str
     3849               ) .
     3850             if v-resize-value-str <> '':U
     3851             then do:
     3852               run diasize_change-width in this-procedure
     3853                 (input  integer(v-resize-value-str)
     3854                 ,input  true
     3855                 ) .
     3856               assign
     3857                 v-restore-saved = true
     3858               .
     3859             end.
     3860           end.
     3861           if v-restore-saved <> true
     3862           then do:
     3863             if v-diasize-wndmax = true
     3864             then do:
     3865               run diasize_maximize in this-procedure
     3866                 (input  true
     3867                 ) .
     3868             end.
     3869           end.
     3870         end.
     3871         else do:
     3872           if v-diasize-wndmax = true
     3873           then do:
     3874             run diasize_maximize in this-procedure
     3875               (input  true
     3876               ) .
     3877           end.
     3878         end.
     3879       end.
     3880     end.
     3881   end procedure.
     3882   procedure diasize_need-full-display :
     3883     define output parameter p-need-full-display as logical   no-undo .
     3884     do
     3885     on error undo, return error return-value
     3886     :
     3887       assign
     3888         p-need-full-display = v-diasize-need-full-display
     3889       .
     3890       assign
     3891         v-diasize-need-full-display = false
     3892       .
     3893     end.
     3894   end procedure.
     3895   procedure get-context :
     3896      define output parameter p-db-num as integer          no-undo.
     3897      define output parameter p-user-id as character        no-undo.
     3898      define variable v-login               as character    no-undo.
     3899      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3900      define buffer buf_user-login  for ub.user-login .
     3901      do
     3902      on error undo, return error
     3903      :
     3904            FIND FIRST buf_sys-ctrl no-lock.
     3905            ASSIGN
     3906               v-login = USERID("ub")
     3907               p-db-num = buf_sys-ctrl.db-num
     3908            .
     3909            FIND FIRST buf_user-login
     3910                 WHERE buf_user-login.db-num = p-db-num
     3911                   AND buf_user-login.user-login = v-login
     3912                 no-lock
     3913                 no-error
     3914                 .
     3915            IF AVAILABLE buf_user-login
     3916            THEN DO:
     3917               assign
     3918                  p-user-id = buf_user-login.user-id
     3919               .
     3920            END.
     3921      end.
     3922   end procedure.
     3923       run diasize_init in this-procedure .
     3924   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3925   procedure set-filter-name :
     3926   define input parameter p-filter-name as character no-undo .
     3927     do with frame Dialog-Frame:
     3928       if p-filter-name > "" then do:
     3929         assign
     3930           frame Dialog-Frame:title
     3931             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     3932         .
     3933         assign
     3934           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3935         .
     3936       end.
     3937       else do:
     3938         assign
     3939           b-sch :tooltip = ""
     3940         .
     3941       end.
     3942     end.
     3943   end procedure.
     3944   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3945   ON TAB ANYWHERE
     3946   DO:
     3947   define variable ii as integer no-undo .
     3948   define variable fh as widget-handle no-undo .
     3949   define variable hh as widget-handle no-undo .
     3950   define variable v-next-widget-name as character no-undo .
     3951   if v-tab-order <> '' then do:
     3952     if self:type = "TOGGLE-BOX" then
     3953     self:BGCOLOR = ?.
     3954     assign
     3955     ii = lookup(self:name, v-tab-order).
     3956     assign
     3957     ii = ii + 1
     3958     v-next-widget-name = entry(ii, v-tab-order)
     3959     no-error .
     3960     if error-status:error then do:
     3961       assign
     3962       ii = 1
     3963       v-next-widget-name = entry( ii, v-tab-order)
     3964       .
     3965     end.
     3966     assign
     3967     fh = frame Dialog-Frame:first-child
     3968     hh = fh:first-child
     3969     .
     3970     do while valid-handle(hh):
     3971       if hh:name = v-next-widget-name then do:
     3972         if hh:sensitive  = yes
     3973         AND hh:visible = yes then do:
     3974           if hh:type = "TOGGLE-BOX":U then do:
     3975             assign
     3976             hh:BGcolor = 1
     3977             .
     3978           end.
     3979           APPLY "ENTRY" to hh.
     3980           return no-apply.
     3981         end.
     3982         else do:
     3983           APPLY "TAB" to hh.
     3984           return no-apply.
     3985         end.
     3986       end.
     3987       hh = hh:next-sibling.
     3988     end.
     3989   end.
     3990   END.
     3991   ON BACK-TAB ANYWHERE
     3992   DO:
     3993   define variable ii as integer no-undo .
     3994   define variable fh as widget-handle no-undo .
     3995   define variable hh as widget-handle no-undo .
     3996   define variable v-next-widget-name as character no-undo .
     3997   if v-tab-order <> '' then do:
     3998     assign
     3999     ii = lookup(self:name, v-tab-order).
     4000     .
     4001     assign
     4002     ii = (if ii = 1
     4003           then  num-entries(v-tab-order)
     4004           else ii - 1
     4005           )
     4006     v-next-widget-name = entry(ii, v-tab-order)
     4007     .
     4008     assign
     4009     fh = frame Dialog-Frame:first-child
     4010     hh = fh:first-child
     4011     .
     4012     do while valid-handle(hh):
     4013       if hh:name = v-next-widget-name then do:
     4014         if hh:sensitive  = yes
     4015         AND hh:visible = yes then do:
     4016           if hh:type = "TOGGLE-BOX":U then do:
     4017             assign
     4018             hh:BGcolor = 1
     4019             .
     4020           end.
     4021           APPLY "ENTRY" to hh.
     4022           return no-apply.
     4023         end.
     4024         else do:
     4025         APPLY "BACK-TAB" to hh.
     4026         return no-apply.
     4027         end.
     4028       end.
     4029       hh = hh:next-sibling.
     4030     end.
     4031     end.
     4032   END.
     4033   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4034   ON RETURN ANYWHERE
     4035   DO:
     4036   define variable ii as integer no-undo .
     4037   define variable fh as widget-handle no-undo .
     4038   define variable hh as widget-handle no-undo .
     4039   define variable v-next-widget-name as character no-undo .
     4040     if v-tab-order <> '' then do:
     4041       assign
     4042       ii = lookup(self:name, v-tab-order).
     4043       if ii = num-entries(v-tab-order) then do:
     4044           APPLY 'CHOOSE' TO b-quit in frame Dialog-Frame.
     4045           return no-apply.
     4046       end.
     4047       if self:type <> "BUTTON" and
     4048         self:type <> "EDITOR"  then do:
     4049         run proc-move-forward in this-procedure .
     4050         return no-apply.
     4051       end.
     4052       if self:type = "BUTTON" then do:
     4053         APPLY "CHOOSE" to self.
     4054       end.
     4055       if self:type = "TOGGLE-BOX" then
     4056       self:BGCOLOR = ?.
     4057       assign
     4058       ii = ii + 1
     4059       v-next-widget-name = entry(ii, v-tab-order)
     4060       no-error .
     4061       if error-status:error then do:
     4062         assign
     4063         ii = 1
     4064         v-next-widget-name = entry( ii, v-tab-order)
     4065         .
     4066       end.
     4067       assign
     4068       fh = frame Dialog-Frame:first-child
     4069       hh = fh:first-child
     4070       .
     4071       do while valid-handle(hh):
     4072         if hh:name = v-next-widget-name then do:
     4073           if hh:sensitive  = yes
     4074           AND hh:visible = yes then do:
     4075             if hh:type = "TOGGLE-BOX":U then do:
     4076               assign
     4077               hh:BGcolor = 1
     4078               .
     4079             end.
     4080             APPLY "ENTRY" to hh.
     4081             return no-apply.
     4082           end.
     4083           else do:
     4084             APPLY "TAB" to hh.
     4085             return no-apply.
     4086           end.
     4087         end.
     4088         hh = hh:next-sibling.
     4089       end.
     4090     end.
     4091   END.
     4092   procedure proc-move-forward :
     4093   define variable ii as integer no-undo .
     4094   define variable fh as widget-handle no-undo .
     4095   define variable hh as widget-handle no-undo .
     4096   define variable v-next-widget-name as character no-undo .
     4097   do
     4098   on error undo, return error
     4099   :
     4100     if v-tab-order <> '' then do:
     4101       if self:type = "TOGGLE-BOX" then
     4102       self:BGCOLOR = ?.
     4103       assign
     4104       ii = lookup(self:name, v-tab-order).
     4105       assign
     4106       ii = ii + 1
     4107       v-next-widget-name = entry(ii, v-tab-order)
     4108       no-error .
     4109       if error-status:error then do:
     4110         assign
     4111         ii = 1
     4112         v-next-widget-name = entry( ii, v-tab-order)
     4113         .
     4114       end.
     4115       assign
     4116       fh = frame Dialog-Frame:first-child
     4117       hh = fh:first-child
     4118       .
     4119       do while valid-handle(hh):
     4120         if hh:name = v-next-widget-name then do:
     4121           if hh:sensitive  = yes
     4122           AND hh:visible = yes then do:
     4123             if hh:type = "TOGGLE-BOX":U then do:
     4124               assign
     4125               hh:BGcolor = 1
     4126               .
     4127             end.
     4128             APPLY "ENTRY" to hh.
     4129             return.
     4130           end.
     4131           else do:
     4132             assign
     4133             ii = ii + 1
     4134             v-next-widget-name = entry(ii, v-tab-order)
     4135             no-error .
     4136             if error-status:error then do:
     4137               assign
     4138               ii = 1
     4139               v-next-widget-name = entry( ii, v-tab-order)
     4140               .
     4141             end.
     4142           end.
     4143         end.
     4144         hh = hh:next-sibling.
     4145       end.
     4146     end.
     4147   end.
     4148   end procedure.
     4149   def var sort-labelBR-rkep-cli   as character no-undo .
     4150   def var sort-clmnBR-rkep-cli    as handle    no-undo .
     4151   def var cur-clmnBR-rkep-cli     as handle    no-undo .
     4152   def var cur-clmn-locBR-rkep-cli as integer   no-undo .
     4153   def var re-queryBR-rkep-cli     as logical   initial no no-undo .
     4154   on start-search, ctrl-o of BR-rkep-cli in frame Dialog-Frame do:
     4155      run sort-brBR-rkep-cli
     4156        (input (if available X_cd-clu
     4157                then recid(X_cd-clu)
     4158                else ?
     4159               )
     4160        ).
     4161   end.
     4162   PROCEDURE sort-brBR-rkep-cli :
     4163     define input parameter p-recid as recid no-undo .
     4164     if re-queryBR-rkep-cli = no then do:
     4165       assign
     4166          cur-clmnBR-rkep-cli = BR-rkep-cli:current-column in frame Dialog-Frame
     4167       .
     4168       if sort-clmnBR-rkep-cli <> ? then sort-clmnBR-rkep-cli:column-fgcolor = 0.
     4169       if cur-clmnBR-rkep-cli = sort-clmnBR-rkep-cli then do:
     4170         assign
     4171            sort-labelBR-rkep-cli = ""
     4172            sort-clmnBR-rkep-cli = ?
     4173         .
     4174        end.
     4175        else do:
     4176          assign
     4177            sort-labelBR-rkep-cli = cur-clmnBR-rkep-cli:label
     4178            sort-clmnBR-rkep-cli  = cur-clmnBR-rkep-cli
     4179            sort-clmnBR-rkep-cli:column-fgcolor = 4
     4180          .
     4181        end.
     4182      end.
     4183     assign
     4184       cur-clmn-locBR-rkep-cli = 1
     4185     .
     4186     def var column-handle as handle no-undo .
     4187     column-handle = BR-rkep-cli:first-column.
     4188     do while valid-handle(column-handle) :
     4189       if column-handle = cur-clmnBR-rkep-cli then do:
     4190         leave .
     4191       end.
     4192       column-handle = column-handle:NEXT-COLUMN.
     4193       assign
     4194         cur-clmn-locBR-rkep-cli = cur-clmn-locBR-rkep-cli + 1
     4195       .
     4196     end.
     4197     case sort-labelBR-rkep-cli:
     4198           when v-id  then DO:    assign       sort-column-name = "X_cd-clu.clu-code"     .     run OpenBr in this-procedure (input  yes, input no, input '':U).   . END.
     4199           when X_cd-clu.charkey_one:label in browse BR-rkep-cli then DO:    assign       sort-column-name = "X_cd-clu.charkey_one"     .     run OpenBr in this-procedure (input  yes, input no, input '':U).   . END.
     4200       otherwise do:
     4201         assign
     4202           sort-column-name = ""
     4203         .
     4204         run OpenBr in this-procedure ( input yes, input no, input '':U).
     4205           if can-do( this-procedure:internal-entries, 'mv-brw-defaultBR-rkep-cli') then do:
     4206             run mv-brw-defaultBR-rkep-cli.
     4207           end.
     4208         if sort-labelBR-rkep-cli <> "" then do:
     4209           assign
     4210             cur-clmnBR-rkep-cli:column-fgcolor = 0
     4211           .
     4212         end.
     4213         assign
     4214           cur-clmn-locBR-rkep-cli = ?
     4215         .
     4216       end.
     4217     end case.
     4218       if cur-clmn-locBR-rkep-cli <> ? then do:
     4219         if can-do( this-procedure:internal-entries, 'ch-clmnBR-rkep-cli') then do:
     4220           run ch-clmnBR-rkep-cli in this-procedure (cur-clmn-locBR-rkep-cli).
     4221         end.
     4222       end.
     4223     if p-recid <> ? then do:
     4224       reposition BR-rkep-cli to recid p-recid no-error.
