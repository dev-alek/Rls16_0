     2393                  ) + chr(4) +
     2394                 ((if t-name then "name":U else "":U) + chr(44) +
     2395                 (if t-role then "role":U else "":U)
     2396                 )
     2397               , input no
     2398               , input 'Прервать'
     2399               , input 'Синхронизация данных по персоналу на кассе R-KEEPER и соответствующих данных в IBS TH')
     2400                .
     2401     RUn OpenBR ( input yes, input no, input '':U).
