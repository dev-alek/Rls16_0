     2255        SIZE 10 BY 1.
     2256   DEFINE BUTTON B-Help
     2257        LABEL "Помо&щь"
     2258        SIZE 3 BY 1
     2259        BGCOLOR 8 .
     2260   DEFINE BUTTON B-link
