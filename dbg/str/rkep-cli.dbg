     4304             view-as alert-box ERROR.
     4305           return.
     4306       end.
     4307     if v-rid-list <> "" then do:
     4308         FIND FIRST find_cd-clu No-LOCK where
     4309                    recid(find_cd-clu) = integer(entry(1, v-rid-list)) No-ERROR.
     4310         if not avail find_cd-clu then do:
     4311           message
     4312           vss-workfile vss-revision vss-description skip
     4313           "Неверное значение параметра вызова v-rid-list" v-rid-list
     4314           view-as alert-box error .
     4315           return error.
     4316         end.
     4317         v-doc-rec = integer(entry(1, v-rid-list)).
     4318       end.
     4319   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4320   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     4321     (output v-db-num
     4322     )  .
     4323     if v-db-num <> X_cli-obj.db-num then do:
     4324       message
     4325       "Нельзя работать с персоналом объекта удаленной БД"
     4326       view-as alert-box error .
     4327       undo, return error .
     4328     end.
     4329     do transaction
     4330     on error undo main-block, return error
     4331     :
     4332       FIND FIRST LOCKED_cash-desk EXCLUSIVE-LOCK WHERE
     4333                 LOCKED_cash-desk.obj-code = p-curr-obj-code
     4334             AND LOCKED_cash-desk.db-num = v-db-num
     4335             AND LOCKED_cash-desk.pos-type = 'r-keeper':U
     4336             NO-WAIT NO-ERROR.
     4337       IF NOT AVAILABLE locked_cash-desk AND NOT LOCKED locked_cash-desk THEN DO:
     4338           MESSAGE
     4339           SUBSTITUTE("На &1&2 не определена касса типа &3&4" +
     4340                     "Нельзя работать с персоналом "
     4341                     , p-curr-obj-type
     4342                     , p-curr-obj-code
     4343                     , 'r-keeper':U
     4344                     , chr(10)
     4345                     )
     4346         VIEW-AS ALERT-BOX ERROR.
     4347         UNDO main-block, RETURN ERROR.
     4348       END.
     4349       IF LOCKED locked_cash-desk THEN DO:
     4350           MESSAGE
     4351           SUBSTITUTE("На &1&2 в настоящее время занята запись кассы типа &3&4" +
     4352                     "Нельзя работать с товарами на кассе"
     4353                     , p-curr-obj-type
     4354                     , p-curr-obj-code
     4355                     , 'r-keeper':U
     4356                     , chr(10))
     4357         VIEW-AS ALERT-BOX ERROR.
     4358         UNDO main-block, RETURN ERROR.
     4359       END.
     4360     end.
     4361     RUN MyEnable in this-procedure .
