      885   function get-rkgTH-price returns decimal(input p-obj-type as character
      886                                          , input p-obj-code as integer
      887                                          , input p-b-code as integer
      888                                          , output p-doc-num as character):
      889   define variable v-price-sale as decimal   no-undo init ?.
      890   define variable v-road-tax   as decimal   no-undo .
      891   define variable v-excise     as decimal   no-undo .
      892   define variable v-vat-pc     as decimal   no-undo .
      893   define variable v-slt-pc     as decimal   no-undo .
      894   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      895   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcprcex in g#library
      896     (input  p-obj-type
      897     ,input  p-obj-code
      898     ,input  p-b-code
      899     ,input  0
      900     ,input  0
      901     ,output p-doc-num
      902     ,output v-price-sale
      903     ,output v-road-tax
      904     ,output v-excise
      905     ,output v-vat-pc
      906     ,output v-slt-pc
