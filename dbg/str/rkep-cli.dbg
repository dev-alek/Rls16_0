      382     run proc-alt-f1 in this-procedure .
      383   end.
      384   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      385   define variable c-point  as character no-undo .
      386   define variable tbl      as character no-undo .
      387   define variable join-tbl as character no-undo .
      388   define variable fld      as character no-undo .
      389   define variable lab      as character no-undo .
      390   define variable spr      as character no-undo .
      391   define variable dim      as character no-undo .
      392   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      393   procedure cur-time :
      394      define output parameter p-today as date      no-undo .
      395      define output parameter p-time  as integer   no-undo .
      396     do
      397     on error undo, return error
      398     :
      399       define variable v-date1 as date      no-undo .
      400       define variable v-date2 as date      no-undo .
      401       define variable v-time  as integer   no-undo .
      402       assign
      403         v-date1 = today
      404         v-time  = time
      405         v-date2 = today
      406       .
      407       if v-date1 <> v-date2
      408       then do:
      409         assign
      410           v-date1 = today
      411           v-time  = v-time
      412         .
      413       end.
      414       assign
      415         p-today = v-date1
      416         p-time  = v-time
      417       .
      418     end.
      419   end.
      420   function cur-time-date returns character
      421   :
      422     return string(today, '99/99/9999':U) .
      423   end.
      424   function cur-time-mjd returns decimal
      425   :
      426     define variable v-date as date      no-undo .
      427     define variable v-time as integer   no-undo .
      428     run cur-time in this-procedure
      429       (output v-date
      430       ,output v-time
      431       ) .
      432     return integer(v-date) - 2400002 + (v-time / 86400) .
      433   end.
      434   function cur-time-get-ending-index returns integer
      435   (input p-number as integer
      436   )
      437   :
      438     if p-number < 0
      439     or p-number = ?
      440     then do:
      441       return 1 .
      442     end.
      443     define variable v-rest as integer   no-undo .
      444     assign
      445       p-number = p-number modulo 100
      446     .
      447     if p-number < 20
      448     then do:
      449       assign
      450         v-rest = p-number
      451       .
      452     end.
      453     else do:
      454       assign
      455         v-rest = p-number modulo 10
      456       .
      457     end.
      458     case v-rest :
      459       when 1
      460       then do:
      461         return 2 .
      462       end.
      463       when 2 or
      464       when 3 or
      465       when 4
      466       then do:
      467         return 3 .
      468       end.
      469       otherwise do:
      470         return 1 .
      471       end.
      472     end case .
      473   end.
      474   procedure cur-time-mjd-to-date :
      475      define input  parameter i-mjd-diff as decimal no-undo.
      476      define output parameter o-Date     as date    no-undo.
      477      define output parameter o-Time     as integer no-undo.
      478      define variable v-day-number as integer   no-undo .
      479      if    i-mjd-diff < 0
      480         or i-mjd-diff = ?
      481      then do:
      482         return "?" .
      483      end.
      484      assign
      485         v-day-number = truncate(i-mjd-diff,0).
      486         o-Date = date(v-day-number + 2400002).
      487         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      488     .
      489   end.
      490   function cur-time-mjd-to-string returns character
      491   (input p-mjd-diff as decimal
      492   )
      493   :
      494     define variable v-day-number as integer   no-undo .
      495     define variable v-seconds    as integer   no-undo .
      496     define variable v-hour       as integer   no-undo .
      497     define variable v-min        as integer   no-undo .
      498     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      499     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      500     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      501     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      502     if p-mjd-diff < 0
      503     or p-mjd-diff = ?
      504     then do:
      505       return "?" .
      506     end.
      507     assign
      508       v-day-number = integer(truncate(p-mjd-diff,0))
      509       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      510     .
      511     if v-seconds > 86400
      512     then do:
      513       assign
      514         v-seconds = 86400 - 1
      515       .
      516     end.
      517     if v-seconds < 0
      518     then do:
      519       assign
      520         v-seconds = 0
      521       .
      522     end.
      523     assign
      524       v-hour = truncate(v-seconds / 3600, 0)
      525     .
      526     assign
      527       v-seconds = v-seconds modulo 3600
      528     .
      529     assign
      530       v-min = truncate(v-seconds / 60, 0)
      531     .
      532     assign
      533       v-seconds = v-seconds modulo 60
      534     .
      535     return
      536         (if v-day-number <> 0
      537           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      538           else ""
      539         )
      540       + (if v-day-number <> 0 or v-hour <> 0
      541           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      542           else ""
      543         )
      544       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      545           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      546           else ""
      547         )
      548       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      549       .
      550   end.
      551   function cur-time-string returns character
      552   :
      553     define variable v-date as date      no-undo .
      554     define variable v-time as integer   no-undo .
      555     run cur-time in this-procedure
      556       (output v-date
      557       ,output v-time
      558       ) .
      559     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      560   end.
      561   function cur-time-string-sec returns character
      562   :
      563     define variable v-date as date      no-undo .
      564     define variable v-time as integer   no-undo .
      565     run cur-time in this-procedure
      566       (output v-date
      567       ,output v-time
      568       ) .
      569     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      570   end.
      571   function cur-time-custom  returns character
      572   (input p-prefix as character
      573   ,input p-date-format as character
      574   ,input p-delimiter as character
      575   ,input p-time-format as character
      576   ,input p-suffix as character
      577   )
      578   :
      579     define variable v-date as date      no-undo .
      580     define variable v-time as integer   no-undo .
      581     run cur-time in this-procedure
      582       (output v-date
      583       ,output v-time
      584       ) .
      585     return
      586       p-prefix
      587       + string(v-date, p-date-format)
      588       + p-delimiter
      589       + string(v-time, p-time-format)
      590       + p-suffix
      591       .
      592   end.
      593   function cur-time-print  returns character
      594   :
      595     define variable v-date as date      no-undo .
      596     define variable v-time as integer   no-undo .
      597     run cur-time in this-procedure
      598       (output v-date
      599       ,output v-time
      600       ) .
      601     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      602   end.
      603   function cur-time-datetime returns datetime
      604   :
      605     define variable v-char as character no-undo .
      606     define variable v-datetime as datetime no-undo .
      607     v-char = cur-time-string().
      608     v-datetime = datetime(v-char).
      609     return  v-datetime.
      610   end.
      611   function cur-time-string-msec returns character
      612   :
      613     define variable v-date as datetime  no-undo .
      614     v-date = now.
      615     return string(v-date) .
      616   end.
      617   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      618   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
