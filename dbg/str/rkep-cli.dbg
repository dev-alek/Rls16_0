     2404     REPOSITION br-rkep-cli to recid integer(entry(1, v-rid-list)) No-ERROR.
     2405     APPLY "VALUE-CHANGED" to br-rkep-cli.
     2406   END.
     2407   ON CHOOSE OF B-link IN FRAME Dialog-Frame
     2408   DO:
     2409   define variable loc#log as logical no-undo.
     2410   define variable loc-doc-rec as recid no-undo .
     2411   define variable varrid-list as character no-undo .
     2412   define variable choice AS integer no-undo .
     2413   if not available X_cd-clu then return no-apply.
     2414   define variable v-host-code as integer   no-undo .
     2415   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2416   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2417     (input  p-curr-obj-type
     2418     ,input  p-curr-obj-code
     2419     ,output v-host-code
     2420     )  .
     2421   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2422   do:
     2423     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2424       (input  v-cntxt-db-num
     2425       ,input  v-cntxt-userid
     2426       ,input  0
     2427       ,input  'actn_cashdesk-cashiers_update':U
     2428       ,input  'object':U
     2429       ,input  v-host-code
     2430       ,input  p-curr-obj-type
     2431       ,input  p-curr-obj-code
     2432       ,input  0
     2433       ,input  0
     2434       ,input  0
     2435       ,input  true
     2436       ,output loc#log
     2437       )  .
     2438   end.
     2439   if not loc#log then return no-apply.
     2440   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2441   do:
     2442     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2443       (input  v-cntxt-db-num
     2444       ,input  v-cntxt-userid
     2445       ,input  0
     2446       ,input  'actn_cashdesk-sellers_update':U
     2447       ,input  'object':U
