      622   procedure fltfield-clear :
      623     define output parameter loc-fld as character no-undo.
      624     define output parameter loc-lab as character no-undo .
      625     define output parameter loc-spr as character no-undo .
      626     define output parameter loc-dim as character no-undo .
      627     assign
      628       loc-fld = ""
      629       loc-lab = ""
      630       loc-spr = ""
      631       loc-dim = "0"
      632     .
      633   end procedure .
      634   procedure fltfield-add :
      635     define input        parameter par-fld as character no-undo.
      636     define input        parameter par-lab as character no-undo .
      637     define input        parameter par-spr as character no-undo .
      638     define input-output parameter loc-fld as character no-undo.
      639     define input-output parameter loc-lab as character no-undo .
      640     define input-output parameter loc-spr as character no-undo .
      641     define input-output parameter loc-dim as character no-undo .
      642     do
      643     on error undo, return error
      644     :
      645       assign
      646       loc-fld = if loc-dim = '0'
      647                 then par-fld
      648                 else (loc-fld + chr(44) + par-fld)
      649       loc-lab = if loc-dim = '0'
      650                 then par-lab
      651                 else (loc-lab + chr(44) + par-lab)
      652       loc-spr = if loc-dim = '0'
      653                 then par-spr
      654                 else (loc-spr + chr(44) + par-spr)
      655       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      656                 string(integer(if num-entries(loc-dim) > 1
      657                               then entry(2, loc-dim)
      658                               else entry(1, loc-dim)
      659                               ) + 1)
      660       no-error
      661       .
      662     end.
      663   end procedure.
      664   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      665   define  stream PrnLibStream.
      666   procedure prn-lib-prn-file :
      667     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      668     define input parameter p-DIsabledoptions as integer no-undo .
      669     define variable v-report-name as character no-undo .
      670     define variable v-user-action as character no-undo .
      671     define variable v-printed     as logical   no-undo .
      672     define variable v-exist       as logical   no-undo .
      673     do
      674       on error undo, return error
      675       :
      676       run prn-lib-get-report-name  in this-procedure (
      677         input parParentProc
      678         ,output v-report-name
      679         ).
      680   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      681   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      682     (input  v-report-name
      683     ,input  2
      684     ,output v-exist
      685     )  .
      686       if NOT v-exist then
      687       DO:
      688         Message
      689           "Нет заданий на печать ! "
      690           view-as alert-box .
      691         Return  .
      692       End.
      693       run gbl/prnfilen.w
      694         (input  ""
      695         ,input  p-DisabledOptions
      696         ,input  string(v-report-name )
      697         ,input  7
      698         ,output v-user-action
      699         ,output v-printed
      700         ) .
      701       if v-printed then
      702       do:
      703         return "YES" .
      704       end.
      705       else
      706       do:
      707         return "NO" .
      708       end.
      709     end.
      710   end procedure.
      711   procedure prn-lib-open-stream :
      712     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      713     define input parameter p-page-size    as integer no-undo .
      714     define input parameter p-is-stream    as logical no-undo .
      715     define input parameter p-append       as logical no-undo .
      716     define variable v-report-name as character no-undo .
      717     do
      718       on error undo, return error
      719       :
      720       run prn-lib-get-report-name  in this-procedure (
      721         input parParentProc
      722         ,output v-report-name
      723         ).
      724       if p-is-stream then
      725       do:
      726         if p-append then
      727         do:
      728           output stream PrnLibStream to value( v-report-name )
      729             page-size value(p-page-size) append .
      730         end.
      731         if not p-append then
      732         do:
      733           output stream PrnLibStream to value( v-report-name )
      734             page-size value(p-page-size) .
      735         end.
      736       end.
      737       if not p-is-stream then
      738       do:
      739         if p-append then
      740         do:
      741           output to value( v-report-name )
      742             page-size value(p-page-size) append .
      743         end.
      744         if not p-append then
      745         do:
      746           output to value( v-report-name )
      747             page-size value(p-page-size) .
      748         end.
      749       end.
      750     end.
      751   end procedure.
      752   procedure prn-lib-open-exp :
      753     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      754     define input parameter p-is-stream    as logical no-undo .
      755     define input parameter p-is-append    as logical no-undo .
      756     define output parameter p-ReportFileName as char init "report" no-undo.
      757     define output parameter p-process as logical no-undo .
      758     define variable glog as logical no-undo .
      759     do
      760       on error undo, return error
      761       :
      762       SYSTEM-DIALOG GET-FILE p-ReportFileName
      763         TITLE      "Укажите путь"
      764         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      765         ASK-OVERWRITE
      766         CREATE-TEST-FILE
      767         SAVE-AS
      768         USE-FILENAME
      769         DEFAULT-EXTENSION "txt"
      770         UPDATE glog
      771         .
      772       if not glog then  return.
      773       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      774       if p-is-stream then
      775       do:
      776         if p-is-append then
      777         do:
      778           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      779         end.
      780         else
      781         do:
      782           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      783         end.
      784       end.
      785       else
      786       do:
      787         if p-is-append then
      788         do:
      789           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      790         end.
      791         else
      792         do:
      793           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      794         end.
      795       end.
      796       p-process = yes.
      797     end.
      798   end procedure.
      799   procedure prn-lib-get-report-name :
      800     define input parameter parParentProc  as widget-handle no-undo.
      801     define output parameter p-report-name as character no-undo .
      802     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      803   end procedure.
      804   procedure prn-lib-reportviewer-report-name :
