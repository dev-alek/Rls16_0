     5071           (
     5072             if (" X_cd-clu.obj-type = p-curr-obj-type and X_cd-clu.obj-code = p-curr-obj-code and X_cd-clu.pos-type = 'r-keeper':U " + " " + where-phrase-40) <> ""
     5073             then  substitute('X_cd-clu.obj-type = &1&2&1 and X_cd-clu.obj-code = &3 and X_cd-clu.pos-type = &1&4&1 '                              , chr(34), p-curr-obj-type, p-curr-obj-code, 'r-keeper':U) + " " + where-phrase-40
     5074             else "true"
     5075           )
     5076         parameter-5-40 = (" " + "" + " " +  substitute(' , FIRST X_staff outer-join NO-LOCK WHERE X_staff.psn-code = X_cd-clu.cli-code                                               /*and X_staff.role = entry(lookup(X_cd-clu.charkey_one, &1&2&1), &1&3&1)*/                                               and X_staff.db-num = &4                                               and X_staff.date-end = &5,                                         first X_clients outer-join no-lock where X_clients.obj-type = &1&6&1 AND                                               X_clients.obj-code  = X_staff.psn-code ', chr(34), v-rkep-cli-role-list, v-th-role-list, v-db-num, 12/31/9999, 'чел':U) + " " + p-find-condition)
     5077         parameter-6-40 = if sort-phrase-40 = ''
     5078                              then
     5079           (
     5080           " " + "  " +
     5081             " " + sort-column-phrase +
     5082           " " + "  "
     5083           )
     5084                              else
     5085           (
     5086           " " + "  " +
     5087             " " + sort-column-phrase +
     5088           " " + sort-phrase-40
     5089           )
     5090         parameter-7-40 =
     5091           " indexed-reposition  "
     5092       .
     5093         run fltopend_fltfindq in this-procedure  (
     5094                             input this-procedure:handle
     5095                             ,input QUERY br-rkep-cli:handle
     5096                             ,input logical(parameter-2-40)
     5097                             ,input no-lock
     5098                             ,input parameter-3-40
     5099                             ,input parameter-4-40
     5100                             ,input parameter-5-40
     5101                             ,input parameter-6-40
     5102                             ,input parameter-7-40
     5103                             ,output v-fltopend-rowid
     5104                             ) no-error.
     5105         .
     5106         v-doc-rec = ?.
     5107       end.
     5108       assign
     5109         l-query-was-opened = true
     5110       .
     5111     end.
     5112   end.
     5113     run waitfram-hide in this-procedure .
     5114      END.
     5115   END CASE.
     5116   if not p-open-query and v-doc-rec <> ? then
     5117   REPOSITION br-rkep-cli to recid v-doc-rec No-ERROR.
     5118   if not p-open-query and v-fltopend-rowid[1] <> ? then
     5119   query br-rkep-cli:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     5120   run waitfram-hide in this-procedure .
     5121   APPLY "VALUE-CHANGED" TO br-rkep-CLI in frame Dialog-Frame.
     5122   APPLY "ENTRY" TO br-rkep-CLI.
     5123   END PROCEDURE.
     5124   PROCEDURE proc-b-link :
     5125   DEFINE INPUT PARAMETER p-recid  AS RECID no-undo.
     5126   DEFINE INPUT PARAMETER p-clients-recid as recid no-undo.
     5127   DEFINE VARIABLE loclog AS LOGICAL NO-UNDO.
     5128   define variable v-doc-num as character no-undo .
     5129   DEFINE BUFFER buf_cd-clu FOR ub.cd-clu.
     5130   DEFINE BUFFER buf_staff FOR ub.staff.
     5131   do
     5132   on error undo, return error
     5133   :
     5134     FIND FIRST buf_cd-clu EXCLUSIVE-LOCK WHERE
     5135               RECID(buf_cd-clu) = p-recid.
     5136     IF buf_cd-clu.obj-code <> 0
     5137     and buf_cd-clu.obj-code <> ?  THEN DO:
     5138       MESSAGE
     5139       SUBSTITUTE("Запись персонала с идентификатором &1 уже привязан к записи персонала в IBS TH c кодом &2&3" +
     5140                   "заменить привязку?"
     5141                   , buf_cd-clu.clu-code
     5142                   , buf_cd-clu.cli-code
     5143                   , chr(10)
     5144                   )
     5145         VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE loclog.
     5146         IF NOT loclog THEN RETURN ERROR.
     5147     END.
     5148     find first buf_staff no-lock where
     5149             recid(buf_staff) = p-clients-recid  .
     5150     ASSIGN
     5151     buf_cd-clu.cli-code = buf_staff.psn-code
     5152     .
     5153   END.
     5154   END PROCEDURE.
     5155   PROCEDURE proc-b-print :
     5156   define variable v-doc-rec as recid no-undo .
     5157   define variable accum-count as integer.
     5158   define variable date_string     as      CHARACTER    no-undo.
     5159   define variable Line            as      CHARACTER    no-undo.
     5160   DEFINE variable v-loc-id               as CHARACTER    no-undo.
     5161   DEFINE VARIABLE v-loc-name AS LOGICAL NO-UNDO.
     5162   DEFINE VARIABLE v-loc-role AS LOGICAL NO-UNDO.
     5163   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
     5164   DEFINE FRAME cd-clu-list
     5165   X_cd-clu.clu-code COLUMN-LABEL "Идентиф-р" FORMAT "9999":U
     5166   X_cd-clu.charkey_one COLUMN-LABEL "Имя на кассе R-KEEPER/!       в IBS TH" FORMAT "X(27)":U
     5167   v-loc-role COLUMN-LABEL "Д" FORMAT "+/-"
     5168   v-loc-name COLUMN-LABEL "Н" FORMAT "+/-"
     5169   X_staff.staff-code COLUMN-LABEL "Код персонала!в IBS TH" FORMAT ">>>>9"
     5170   HEADER  date_string AT 5 format "X(35)"
     5171    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     5172   Line format "X(195)" AT 1
     5173   with width 232 down stream-io use-text    .
     5174   Line = fill("-", 195).
     5175   date_string = cur-time-print() .
     5176   run prn-lib-open-stream  in this-procedure (
     5177                                                input parparentProc
     5178                                               ,input 43
     5179                                               ,input yes
     5180                                               ,input no
     5181                                               ).
     5182   PUT  STREAM PrnLibStream
     5183   SPACE(25) ( frame Dialog-Frame:title )
     5184   format "x(90)" SKIP(1) .
     5185   FORM HEADER
     5186   Line format "X(195)" AT 1 SKIP
     5187   "Продолжение - на следующей странице" AT 30 SKIP
     5188   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5189   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5190   FORM with FRAME cd-clu-list  .
     5191   run waitfram-show in this-procedure ( input "Ждите...").
     5192   v-doc-rec = recid(X_cd-clu).
     5193   DO WHILE available X_cd-clu :
     5194     GET prev br-rkep-cli.
     5195   END.
     5196   GET next br-rkep-cli.
     5197   DO WHILE available X_cd-clu :
     5198     Display STREAM PrnLibStream
     5199     X_cd-clu.clu-code
     5200     X_cd-clu.charkey_one
     5201     get-cname-diff(buffer X_clients) @ v-loc-name
     5202     get-crole-diff(buffer X_staff) @ v-loc-role
     5203     with FRAME cd-clu-list .
     5204     DOWN STREAM PrnLibStream 1
     5205     with FRAME cd-clu-list  .
     5206     IF AVAILABLE X_staff  THEN do:
     5207       Display STREAM PrnLibStream
     5208       X_staff.staff-code
     5209       with FRAME cd-clu-list .
     5210       Display STREAM PrnLibStream
     5211       X_clients.obj-name @ X_cd-clu.charkey_one
     5212       with FRAME cd-clu-list .
     5213       DOWN STREAM PrnLibStream 1
     5214       with FRAME cd-clu-list  .
     5215     END.
     5216     ELSE DO:
     5217       DOWN STREAM PrnLibStream 1
     5218       with FRAME cd-clu-list .
     5219     END.
     5220     assign
     5221     accum-count = accum-count + 1
     5222     .
     5223     GET next br-rkep-cli.
     5224   END.
     5225   UNDERLINE  STREAM PrnLibStream
     5226   X_cd-clu.clu-code
     5227   X_cd-clu.charkey_one
     5228   X_staff.staff-code
     5229   with FRAME cd-clu-list .
     5230   DISPLAY STREAM PrnLibStream
     5231   "ИТОГО" @ v-loc-id
     5232   accum-count @ X_cd-clu.charkey_one
     5233   with frame cd-clu-list.
     5234   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5235   HIDE  STREAM PrnLibStream FRAME cd-clu-List.
     5236   output  STREAM PrnLibStream CLOSE.
     5237   REPOSITION br-rkep-cli to recid v-doc-rec no-error.
     5238   APPLY "entry" to br-rkep-cli.
     5239   run waitfram-hide in this-procedure .
     5240   run prn-lib-prn-file in this-procedure (
     5241                                             input parparentproc
     5242                                             ,input 8
     5243                                             ).
     5244   END PROCEDURE.
     5245   PROCEDURE proc-b-sch :
     5246   assign
     5247     tbl = 'cd-clu'
     5248     join-tbl = 'X_cd-clu'
     5249     fld = ""
     5250     lab = ""
     5251     spr = ""
     5252     dim = '0'
     5253     .
     5254   run fltfield-add in this-procedure('charkey_one', 'Имя', '',
     5255   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5256   run fltfield-add in this-procedure('clu-type', 'Должность', '',
     5257   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5258   run fltfield-add in this-procedure('to-send', 'Статус', '',
     5259   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5260   Filter-Block:
     5261   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     5262       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     5263       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     5264     run gbl/filter.w ( INPUT parparentproc
     5265                  , INPUT (filter-point +  chr(4) +
     5266                           filter-label + chr(4) +
     5267                           string(yes))
     5268                  , INPUT tbl
     5269                  , INPUT join-tbl
     5270                  , INPUT fld
     5271                  , INPUT lab
     5272                  , INPUT spr
     5273                  , INPUT dim ).
     5274     RUN OpenBr ( input yes, input no, input '':U).
     5275   END.
     5276   END PROCEDURE.
     5277   PROCEDURE proc-buttons :
     5278   define input parameter p-is-batch as logical no-undo.
     5279   CASE p-is-batch:
     5280       when yes then do:
     5281           ENABLE
     5282           B-mark
     5283           with frame Dialog-Frame.
     5284           disable
     5285           b-link
     5286           with frame Dialog-Frame.
     5287       end.
     5288       when no then do:
     5289           ENABLE
     5290           B-mark when lookup("b-mark":U, bttns) > 0
     5291           B-link
     5292           with frame Dialog-Frame.
     5293           DISABLE
     5294           b-mark when lookup("b-mark":U, bttns) = 0
     5295           with frame Dialog-Frame.
     5296       end.
     5297   END CASE.
     5298   END PROCEDURE.
     5299   PROCEDURE proc-find-id :
     5300   define input parameter p-next as logical no-undo.
     5301   define input parameter p-id AS integer no-undo.
     5302   run OpenBr in this-procedure (
     5303        input false
     5304       ,input p-next
     5305       ,input substitute("and X_cd-clu.clu-code = &1 "
     5306         , p-id)
     5307       ).
     5308   apply "entry":u to sch-id in frame Dialog-Frame .
     5309   END PROCEDURE.
     5310   PROCEDURE proc-find-name :
     5311   define input parameter p-next as logical no-undo.
     5312   define input parameter p-name like ub.cd-clu.charkey_one no-undo.
     5313   assign
     5314   p-name = replace(p-name, chr(34), "":U)
     5315   p-name = replace(p-name, chr(39), chr(39) + chr(39))
     5316   p-name = chr(34) + p-name + chr(34).
     5317   run OpenBr in this-procedure (
     5318        input false
     5319       ,input p-next
     5320       ,input substitute("and X_cd-clu.charkey_one begins &1 "
     5321         , p-name)
     5322       ).
     5323   apply "entry":u to sch-name in frame Dialog-Frame .
     5324   END PROCEDURE.
     5325   PROCEDURE proc-rs-sch :
     5326   case input frame Dialog-Frame rs-sch :
     5327       when "id" then do:
     5328         enable
     5329         sch-id
     5330         with frame Dialog-Frame.
     5331         display
     5332         sch-id
     5333         with frame Dialog-Frame.
     5334         hide
     5335         sch-name
     5336         in frame Dialog-Frame.
     5337         apply "entry" to sch-id in frame Dialog-Frame.
     5338       end.
     5339       when "name" then do:
     5340         enable
     5341         sch-name
     5342         with frame Dialog-Frame.
     5343         display
     5344         sch-name
     5345         with frame Dialog-Frame.
     5346         hide
     5347         sch-id
     5348         in frame Dialog-Frame.
     5349         apply "entry" to sch-name in frame Dialog-Frame.
     5350       end.
     5351     end.
     5352   END PROCEDURE.
     5353   FUNCTION get-cname-diff RETURNS LOGICAL
     5354     ( BUFFER loc-clients FOR ub.clients ) :
     5355    IF AVAILABLE loc-clients THEN
     5356    RETURN (loc-clients.obj-name <> X_cd-clu.charkey_one).
     5357    RETURN NO.
     5358   END FUNCTION.
     5359   FUNCTION get-crole-diff RETURNS LOGICAL
     5360     ( BUFFER loc-staff FOR ub.staff ) :
     5361   IF NOT AVAILABLE loc-staff THEN RETURN YES.
     5362   RETURN NO.
     5363   END FUNCTION.
