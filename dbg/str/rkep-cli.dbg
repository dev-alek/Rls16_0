     2287   DEFINE VARIABLE sch-name AS CHARACTER FORMAT "X(35)":U
     2288        VIEW-AS FILL-IN
     2289        SIZE 41.38 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     2290   DEFINE VARIABLE rs-mode AS CHARACTER
