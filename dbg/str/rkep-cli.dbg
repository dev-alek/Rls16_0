      910   function get-rkgTH-name returns character(input p-obj-type as character
      911                                             ,input p-obj-code as integer
      912                                             ,input p-b-code as integer
      913                                             , buffer buf_goods for ub.goods):
      914   define variable v-gds-name as character no-undo .
      915   define VARIABLE varresult   as character                no-undo.
      916   define VARIABLE vartype-bc  as character                no-undo.
      917   define VARIABLE varweight   as decimal                  no-undo.
      918   DEFINE VARIABLE v-unit-cli AS CHARACTER NO-UNDO.
      919   DEFINE VARIABLE v-f-name AS CHARACTER NO-UNDO.
      920   DEFINE BUFFER buf_bar-code FOR ub.bar-code.
      921   DEFINE BUFFER buf_prod-bc FOR ub.prod-bc.
      922   DEFINE BUFFER buf_place FOR ub.place.
      923   DEFINE BUFFER buf_gds-prt FOR ub.gds-prt.
      924   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
      925   (
      926    input  parparentproc
      927   ,input  STRING(p-b-code)
      928   ,input  0
      929   ,input  p-obj-type
      930   ,input  p-obj-code
      931   ,input  NO
      932   ,input  YES
      933   ,input  varscales-pref7
      934   ,input  varpgscales-pref7
      935   ,output varresult
      936   ,output vartype-bc
      937   ,output varweight
      938   ,buffer buf_bar-code
      939   ,buffer buf_prod-bc
      940   ,buffer buf_place
      941   ) no-error.
      942   if not available buf_bar-code then
      943   return "!!!НЕИЗВЕСТНЫЙ ТОВАР".
      944   FIND FIRST buf_goods NO-LOCK WHERE
      945             buf_goods.gds-code = buf_bar-code.gds-code NO-ERROR.
      946   IF NOT AVAILABLE buf_goods THEN DO:
      947     return "!!!НЕИЗВЕСТНЫЙ ТОВАР".
      948   END.
      949   else do:
      950     assign
      951     v-gds-name = buf_goods.chk-name
      952     .
      953   end.
      954   IF buf_bar-code.unit-cli <> buf_goods.unit-base THEN DO:
      955     ASSIGN
      956     v-unit-cli = "*" + string(buf_bar-code.cli-base-rate).
      957   END.
      958   FIND FIRST buf_gds-prt NO-LOCK WHERE
      959             buf_gds-prt.upper-code = buf_goods.prt-root NO-ERROR.
      960   if buf_gds-prt.node-name <>  '_Пустая шкала':U THEN DO:
      961       FIND FIRST buf_gds-prt NO-LOCK WHERE
      962                 buf_gds-prt.node-code = buf_bar-code.node-code NO-ERROR.
      963   END.
      964   ASSIGN
      965   v-f-name = (IF AVAILABLE buf_gds-prt THEN buf_gds-prt.f-name ELSE "":U).
      966   ASSIGN
      967   v-gds-name = v-gds-name + chr(32) + v-f-name + v-unit-cli.
      968   return v-gds-name.
      969   END FUNCTION.
      970   function get-rkgTH-group returns integer(input p-obj-type as character
      971                                           , input p-obj-code  as integer
      972                                           , input p-gds-code as integer
      973                                           , output p-grp-name as character
      974                                           ):
      975   DEFINE BUFFER buf_fbr-gds-obj FOR ub.fbr-gds-obj.
      976   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
      977   FIND FIRST buf_fbr-gds-obj NO-LOCK WHERE
      978           buf_fbr-gds-obj.obj-type = p-obj-type
      979       AND buf_fbr-gds-obj.obj-code = p-obj-code
      980       AND buf_fbr-gds-obj.gds-code = p-gds-code NO-ERROR.
      981   IF AVAILABLE buf_fbr-gds-obj THEN DO:
      982     RUN fbrglib-get-full-name IN THIS-PROCEDURE(
      983                                                 input p-obj-type
      984                                                 ,INPUT p-obj-code
      985                                                 ,INPUT buf_fbr-gds-obj.fbr-grp-code
      986                                                 ,OUTPUT p-grp-name) NO-ERROR.
      987     return buf_fbr-gds-obj.fbr-grp-code.
      988   END.
      989   return ?.
      990   END FUNCTION.
      991   function get-rkgTH-modificator returns logical(input p-obj-type as character
      992                                           , input p-obj-code  as integer
      993                                           , input p-gds-code as integer
      994                                           , output p-is-null-price as logical
      995                                           ):
      996   DEFINE BUFFER buf_fbr-gds-obj FOR ub.fbr-gds-obj.
      997   FIND FIRST buf_fbr-gds-obj NO-LOCK WHERE
      998           buf_fbr-gds-obj.obj-type = p-obj-type
      999       AND buf_fbr-gds-obj.obj-code = p-obj-code
     1000       AND buf_fbr-gds-obj.gds-code = p-gds-code NO-ERROR.
     1001   IF AVAILABLE buf_fbr-gds-obj THEN DO:
     1002     assign
     1003     p-is-null-price = buf_fbr-gds-obj.is-null-price
     1004     .
     1005     return buf_fbr-gds-obj.is-modificator.
     1006   END.
     1007   assign
     1008   p-is-null-price = no.
     1009   return no.
     1010   END FUNCTION.
     1011   function get-rkgTH-group-name returns character(input p-obj-type as character
     1012                                                 , input p-obj-code  as integer
     1013                                                 , input p-out-code as integer):
     1014   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
     1015   find first buf_fbr-gds-grp no-lock where
     1016             buf_fbr-gds-grp.obj-type = p-obj-type
     1017         AND buf_fbr-gds-grp.obj-code = p-obj-code
     1018         and buf_fbr-gds-grp.out-code = p-out-code no-error .
     1019   if not available buf_fbr-gds-grp then return ?.
     1020   return buf_fbr-gds-grp.node-name.
     1021   END FUNCTION.
     1022   function get-rkgTH-parent returns integer(input p-obj-type as character
     1023                                             , input p-obj-code  as integer
     1024                                             , input p-out-code as integer):
     1025   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
     1026   DEFINE BUFFER upper_fbr-gds-grp FOR ub.fbr-gds-grp.
     1027   find first buf_fbr-gds-grp no-lock where
     1028             buf_fbr-gds-grp.obj-type = p-obj-type
     1029         AND buf_fbr-gds-grp.obj-code = p-obj-code
     1030         and buf_fbr-gds-grp.out-code = p-out-code no-error .
     1031   if not available buf_fbr-gds-grp then return ?.
     1032   find first upper_fbr-gds-grp no-lock where
     1033             upper_fbr-gds-grp.obj-type = p-obj-type
     1034         AND upper_fbr-gds-grp.obj-code = p-obj-code
     1035         and upper_fbr-gds-grp.out-code = buf_fbr-gds-grp.upper-code no-error .
     1036   if not available upper_fbr-gds-grp then return ?.
     1037   return upper_fbr-gds-grp.out-code.
     1038   END FUNCTION.
     1039   procedure get-rkep-full-grp-name :
     1040   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1041   DEFINE INPUT PARAMETER p-grp-code LIKE ub.cd-grp.grp-code NO-UNDO.
     1042   define output parameter p-full-name as character    no-undo.
     1043   define variable v-upper-code    as integer  no-undo.
     1044   define buffer buf_cd-grp       for ub.cd-grp.
     1045   define buffer buf_upper_cd-grp for ub.cd-grp.
     1046   do
     1047   on error undo, return error
     1048   :
     1049       if P-grp-code = 0
     1050       then do:
     1051           assign
     1052               p-full-name = ""
     1053           .
     1054       end.
     1055       else do:
     1056           find first buf_cd-grp no-lock where
     1057                  buf_cd-grp.obj-type = 'маг':U
     1058              and buf_cd-grp.obj-code = p-obj-code
     1059              and buf_cd-grp.pos-type = 'r-keeper':U
     1060              and buf_cd-grp.grp-type = '':U
     1061              and buf_cd-grp.grp-code = p-grp-code
     1062           no-error.
     1063           if not available buf_cd-grp
     1064           then do:
     1065               undo, return error substitute("get-rkep-grp-name: Не найдена группа меню на кассе R-KEEPER с кодом &1", p-grp-code).
     1066           end.
     1067           assign
     1068               p-full-name  = ""
     1069               v-upper-code = 0
     1070           .
     1071           do while true
     1072           on error undo, return error "get-rkep-grp-name: Ошибка составления полного имени группы"
     1073           :
     1074               assign
     1075               p-full-name  = buf_cd-grp.grp-name
     1076                           + (if p-full-name <> "" then chr(47) else "")
     1077                           + p-full-name
     1078               v-upper-code = buf_cd-grp.upper-grp-code
     1079               .
     1080               if buf_cd-grp.grp-code = 0
     1081               then do:
     1082                   leave.
     1083               end.
     1084               find first buf_cd-grp no-lock where
     1085                         buf_cd-grp.obj-type = 'маг':U
     1086                     and buf_cd-grp.obj-code = p-obj-code
     1087                     and buf_cd-grp.pos-type = 'r-keeper':U
     1088                     and buf_cd-grp.grp-type = '':U
     1089                     and buf_cd-grp.grp-code = v-upper-code no-error.
     1090               if not available buf_cd-grp
     1091               then do:
     1092                   undo, return error "get-rkep-grp-name: Не найдена группа товаров с кодом "
     1093                                       + string( v-upper-code )
     1094                                       + ". Ошибка ссылки в дереве товаров для узла p-id".
     1095               end.
     1096           end.
     1097           assign
     1098               p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1099           .
     1100       end.
     1101   end.
     1102   end procedure.
     1103   function get-price-id-from-int returns character ( input p-file-num as integer):
     1104     return ('price-list':U + chr(32) +  string(p-file-num)).
     1105   end function.
     1106   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1107     define variable v-cntxt-db-num        as integer   no-undo .
     1108     define variable v-cntxt-userid        as character no-undo .
     1109     define variable v-cntxt-level         as character no-undo .
     1110     define variable v-cntxt-host-code-obj as integer   no-undo .
     1111     define variable v-cntxt-obj-type      as character no-undo .
     1112     define variable v-cntxt-obj-code      as integer   no-undo .
     1113     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1114     define variable v-cntxt-is-admin      as logical   no-undo .
     1115   define variable vss-include-info10 as character format "X(65)" no-undo
     1116   initial "@(#)$Workfile$ $Revision$".
     1117   define temp-table temp_fbrglib_grp no-undo
     1118       field sel           as character
     1119       field full-name     as character
     1120       field out-code      as integer
     1121       field sort-name     as character
     1122       field node-code     as integer
     1123       field upper-code    as integer
     1124       field name          as character
     1125       field level         as integer
     1126       field mark          as character
     1127       field obj-type      as character
     1128       field obj-code      as integer
     1129       field global-code   as integer
     1130       index pi is primary unique obj-type obj-code sort-name
     1131       index fn obj-type obj-code full-name
     1132       index nc is unique obj-type obj-code node-code
     1133       index sl obj-type obj-code sel
     1134       index uc obj-type obj-code upper-code
     1135   .
     1136   define temp-table temp_fbrglib_found-grp no-undo
     1137       field full-name   as character
     1138       field sort-name   as character
     1139       field node-code   as integer
     1140       field level       as integer
     1141       field is-terminal as logical
     1142       field obj-type      as character
     1143       field obj-code      as integer
     1144       index pi is primary unique obj-type obj-code sort-name
     1145       index fn obj-type obj-code full-name
     1146       index lv obj-type obj-code level
     1147       index it obj-type obj-code is-terminal
     1148   .
     1149   define temp-table temp_found-result-nodelist no-undo
     1150       field node-code     as integer
     1151       field processed     as logical
     1152       field sort-name     as character
     1153       field full-name     as character
     1154       index pi is primary unique node-code
     1155       index ps processed
     1156   .
     1157   procedure fbrglib-get-sort-name :
     1158   do
     1159   on error undo, return error
     1160   :
     1161   define input parameter p-obj-type   as character    no-undo.
     1162   define input parameter p-obj-code   as integer      no-undo.
     1163   define input parameter p-node-code  as integer      no-undo.
     1164   define output parameter p-sort-name as character    no-undo.
     1165       define variable v-upper-code    as integer           no-undo.
     1166       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1167       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
     1168       find first buf_fbr-gds-grp no-lock
     1169            where buf_fbr-gds-grp.obj-type  = p-obj-type
     1170              and buf_fbr-gds-grp.obj-code  = p-obj-code
     1171              and buf_fbr-gds-grp.node-code = p-node-code
     1172       no-error.
     1173       if not available buf_fbr-gds-grp
     1174       then do:
     1175           undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1176       end.
     1177       assign
     1178           p-sort-name  = ""
     1179           v-upper-code = 1
     1180       .
     1181       do while true
     1182       on error undo, return error "fbrglib-get-sort-name: Ошибка составления полного имени группы"
     1183       :
     1184           assign
     1185               p-sort-name  = buf_fbr-gds-grp.node-name
     1186                            + (if p-sort-name <> "" then chr(2) else "")
     1187                            + p-sort-name
     1188               v-upper-code = buf_fbr-gds-grp.upper-code
     1189           .
     1190           if buf_fbr-gds-grp.upper-code = 1
     1191           then do:
     1192               leave.
     1193           end.
     1194           find first buf_fbr-gds-grp no-lock
     1195                where buf_fbr-gds-grp.obj-type  = p-obj-type
     1196                  and buf_fbr-gds-grp.obj-code  = p-obj-code
     1197                  and buf_fbr-gds-grp.node-code = v-upper-code
     1198           no-error.
     1199           if not available buf_fbr-gds-grp
     1200           then do:
     1201               undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом "
     1202                                   + string( v-upper-code )
     1203                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1204           end.
     1205       end.
     1206   end.
     1207   end procedure.
     1208   procedure fbrglib-get-full-name :
     1209   do
     1210   on error undo, return error
     1211   :
     1212   define input parameter p-obj-type   as character    no-undo.
     1213   define input parameter p-obj-code   as integer      no-undo.
     1214   define input parameter p-node-code  as integer      no-undo.
     1215   define output parameter p-full-name as character    no-undo.
     1216       define variable v-upper-code    as integer           no-undo.
     1217       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1218       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
     1219       if p-node-code = 1
     1220       then do:
     1221           assign
     1222               p-full-name = ""
     1223           .
     1224       end.
     1225       else do:
     1226           find first buf_fbr-gds-grp no-lock
     1227                where buf_fbr-gds-grp.obj-type  = p-obj-type
     1228                  and buf_fbr-gds-grp.obj-code  = p-obj-code
     1229                  and buf_fbr-gds-grp.node-code = p-node-code
     1230           no-error.
     1231           if not available buf_fbr-gds-grp
     1232           then do:
     1233               undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1234           end.
     1235           assign
     1236               p-full-name  = ""
     1237               v-upper-code = 1
     1238           .
     1239           do while true
     1240           on error undo, return error "fbrglib-get-full-name: Ошибка составления полного имени группы"
     1241           :
     1242               assign
     1243                   p-full-name  = buf_fbr-gds-grp.node-name
     1244                               + (if p-full-name <> "" then chr(47) else "")
     1245                               + p-full-name
     1246                   v-upper-code = buf_fbr-gds-grp.upper-code
     1247               .
     1248               if buf_fbr-gds-grp.upper-code = 1
     1249               then do:
     1250                   leave.
     1251               end.
     1252               find first buf_fbr-gds-grp no-lock
     1253                    where buf_fbr-gds-grp.obj-type  = p-obj-type
     1254                      and buf_fbr-gds-grp.obj-code  = p-obj-code
     1255                      and buf_fbr-gds-grp.node-code = v-upper-code
     1256               no-error.
     1257               if not available buf_fbr-gds-grp
     1258               then do:
     1259                   undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом "
     1260                                       + string( v-upper-code )
     1261                                       + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1262               end.
     1263           end.
     1264           assign
     1265               p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1266           .
     1267       end.
     1268   end.
     1269   end procedure.
     1270   procedure fbrglib-get-root-code :
     1271   do
     1272   on error undo, return error
     1273   :
     1274   define output parameter p-root-code as integer      no-undo.
     1275       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1276       find first buf_fbr-gds-grp no-lock
     1277            where buf_fbr-gds-grp.upper-code = 0
     1278       no-error .
     1279       if not available buf_fbr-gds-grp
     1280       then do:
     1281           undo, return error .
     1282       end.
     1283       else do:
     1284           assign
     1285               p-root-code = buf_fbr-gds-grp.node-code
     1286           .
     1287       end.
     1288   end.
     1289   end procedure.
     1290   procedure fbrglib-find-grp-by-full-name :
     1291   do
     1292   on error undo, return error
     1293   :
     1294   define input parameter p-obj-type     as character    no-undo.
     1295   define input parameter p-obj-code     as integer      no-undo.
     1296   define input parameter p-search-name  as character    no-undo.
     1297   define input parameter p-fill-path    as logical      no-undo.
     1298       define variable v-upper-code    as integer          no-undo.
     1299       define variable v-not-found     as logical init yes no-undo.
     1300       define variable v-counter       as integer           no-undo.
     1301       define variable v-level         as integer           no-undo.
     1302       define variable v-full-name     as character         no-undo.
     1303       define variable v-sort-name     as character         no-undo.
     1304       define variable v-node-name     as character      no-undo.
     1305       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1306       assign
     1307           p-search-name = replace( p-search-name, chr(47), chr(2) )
     1308       .
     1309       run fbrglib-get-root-code ( output v-upper-code ) no-error .
     1310       if error-status :error
     1311       then do:
     1312           undo, return error "fbrglib-find-grp-by-full-name: Ошибка при поиске корневого узла".
     1313       end.
     1314       assign
     1315           v-full-name  = ""
     1316           v-level      = num-entries( p-search-name, chr(2) )
     1317       .
     1318       for each temp_fbrglib_found-grp
     1319       :
     1320           delete temp_fbrglib_found-grp.
     1321       end.
     1322       start-name-analyze:
     1323       do v-counter = 1 to v-level
     1324       :
     1325           if v-counter < v-level
     1326           then do:
     1327               assign
     1328                   v-node-name = entry( v-counter, p-search-name, chr(2) )
     1329               .
     1330               find first buf_fbr-gds-grp no-lock
     1331                    where buf_fbr-gds-grp.obj-type   = p-obj-type
     1332                      and buf_fbr-gds-grp.obj-code   = p-obj-code
     1333                      and buf_fbr-gds-grp.upper-code = v-upper-code
     1334                      and buf_fbr-gds-grp.node-name  = v-node-name
     1335               no-error .
     1336               if not available buf_fbr-gds-grp
     1337               then do:
     1338                   assign
     1339                       v-full-name  = p-search-name
     1340                       v-sort-name  = p-search-name
     1341                   .
     1342                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(47) ).
     1343               end.
     1344               else do:
     1345                   assign
     1346                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_fbr-gds-grp.node-name
     1347                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_fbr-gds-grp.node-name
     1348                       v-upper-code = buf_fbr-gds-grp.node-code
     1349                   .
     1350                   if p-fill-path = yes
     1351                   then do:
     1352                       create temp_fbrglib_found-grp.
     1353                       assign
     1354                           temp_fbrglib_found-grp.full-name = v-full-name + chr(47)
     1355                           temp_fbrglib_found-grp.sort-name = v-sort-name
     1356                           temp_fbrglib_found-grp.node-code = v-upper-code
     1357                           temp_fbrglib_found-grp.level     = v-counter
     1358                           temp_fbrglib_found-grp.obj-type  = p-obj-type
     1359                           temp_fbrglib_found-grp.obj-code  = p-obj-code
     1360                       .
     1361                   end.
     1362               end.
     1363           end.
     1364           else do:
     1365               for each buf_fbr-gds-grp no-lock
     1366                  where buf_fbr-gds-grp.obj-type   = p-obj-type
     1367                    and buf_fbr-gds-grp.obj-code   = p-obj-code
     1368                    and buf_fbr-gds-grp.upper-code = v-upper-code
     1369                    and buf_fbr-gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     1370               :
     1371                   assign
     1372                       v-not-found = no
     1373                   .
     1374                   create temp_fbrglib_found-grp.
     1375                   assign
     1376                       temp_fbrglib_found-grp.full-name = v-full-name
     1377                                                           + (if v-full-name = "" then "" else chr(47) )
     1378                                                           + buf_fbr-gds-grp.node-name + chr(47)
     1379                       temp_fbrglib_found-grp.sort-name = v-sort-name
     1380                                                           + ( if v-sort-name = "" then "" else chr(2) )
     1381                                                           + buf_fbr-gds-grp.node-name
     1382                       temp_fbrglib_found-grp.node-code = buf_fbr-gds-grp.node-code
     1383                       temp_fbrglib_found-grp.level     = v-level
     1384                       temp_fbrglib_found-grp.obj-type  = p-obj-type
     1385                       temp_fbrglib_found-grp.obj-code  = p-obj-code
     1386                   .
     1387               end.
     1388               if v-not-found = yes
     1389               then do:
     1390                   assign
     1391                       v-full-name  = p-search-name
     1392                       v-sort-name  = p-search-name
     1393                   .
     1394                   for each temp_fbrglib_found-grp
     1395                   :
     1396                       delete temp_fbrglib_found-grp.
     1397                   end.
     1398                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1399               end.
     1400           end.
     1401       end.
     1402   end.
     1403   end procedure.
     1404   procedure fbrglib-find-all-subgroup :
     1405   do
     1406   on error undo, return error
     1407   :
     1408   define input parameter p-start-obj-type     as character    no-undo.
     1409   define input parameter p-start-obj-code     as integer      no-undo.
     1410   define input parameter p-start-node-code    as integer      no-undo.
     1411   define input parameter p-terminal-only      as logical      no-undo.
     1412       define variable v-start-full-name   as character     no-undo.
     1413       define variable v-start-sort-name   as character     no-undo.
     1414       define variable v-not-found         as logical       no-undo.
     1415       define variable v-is-terminal       as logical       no-undo.
     1416       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     1417       create temp_found-result-nodelist.
     1418       assign
     1419           temp_found-result-nodelist.node-code = p-start-node-code
     1420           temp_found-result-nodelist.processed = no
     1421       .
     1422       run fbrglib-get-full-name in this-procedure (
     1423             input p-start-obj-type
     1424           , input p-start-obj-code
     1425           , input p-start-node-code
     1426           , output v-start-full-name
     1427       ).
     1428       run fbrglib-get-full-name in this-procedure (
     1429             input p-start-obj-type
     1430           , input p-start-obj-code
     1431           , input p-start-node-code
     1432           , output v-start-sort-name
     1433       ).
     1434       process-nodes:
     1435       do while yes
     1436       :
     1437           find first temp_found-result-nodelist
     1438                where temp_found-result-nodelist.node-code = p-start-node-code
     1439           .
     1440           assign
     1441               temp_found-result-nodelist.processed = yes
     1442           .
     1443           for each buf_fbr-gds-grp no-lock
     1444              where buf_fbr-gds-grp.obj-type   = p-start-obj-type
     1445                and buf_fbr-gds-grp.obj-code   = p-start-obj-code
     1446                and buf_fbr-gds-grp.upper-code = p-start-node-code
     1447           on error undo, return error
     1448           :
     1449               run fbrglib-is-terminal in this-procedure (
     1450                     input buf_fbr-gds-grp.obj-type
     1451                   , input buf_fbr-gds-grp.obj-code
     1452                   , input buf_fbr-gds-grp.node-code
     1453                   , output v-is-terminal
     1454               ).
     1455               if v-is-terminal = yes
     1456               then do:
     1457                   create temp_fbrglib_found-grp.
     1458                   assign
     1459                       temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1460                                                           chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     1461                       temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1462                                                           chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     1463                       temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
     1464                       temp_fbrglib_found-grp.is-terminal = yes
     1465                       temp_fbrglib_found-grp.obj-type  = p-start-obj-type
     1466                       temp_fbrglib_found-grp.obj-code  = p-start-obj-code
     1467                   .
     1468               end.
     1469               else do:
     1470                   create temp_found-result-nodelist.
     1471                   assign
     1472                       temp_found-result-nodelist.node-code = buf_fbr-gds-grp.node-code
     1473                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     1474                                                              chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     1475                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     1476                                                              chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     1477                       temp_found-result-nodelist.processed = no
     1478                   .
     1479                   if p-terminal-only = no
     1480                   then do:
     1481                       create temp_fbrglib_found-grp.
     1482                       assign
     1483                           temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1484                                                               chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     1485                           temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1486                                                               chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     1487                           temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
     1488                           temp_fbrglib_found-grp.is-terminal = no
     1489                           temp_fbrglib_found-grp.obj-type  = p-start-obj-type
     1490                           temp_fbrglib_found-grp.obj-code  = p-start-obj-code
     1491                       .
     1492                   end.
     1493               end.
     1494           end.
     1495           find first temp_found-result-nodelist
     1496                where temp_found-result-nodelist.processed = no
     1497           no-error.
     1498           if not available temp_found-result-nodelist
     1499           then do:
     1500               leave process-nodes.
     1501           end.
     1502           else do:
     1503               assign
     1504                   p-start-node-code = temp_found-result-nodelist.node-code
     1505                   v-start-full-name = temp_found-result-nodelist.full-name
     1506                   v-start-sort-name = temp_found-result-nodelist.sort-name
     1507               .
     1508           end.
     1509       end.
     1510   end.
     1511   end procedure.
     1512   procedure fbrglib-expand-name :
     1513   do
     1514   on error undo, return error
     1515   :
     1516   define input parameter p-obj-type   as character    no-undo.
     1517   define input parameter p-obj-code   as integer      no-undo.
     1518   define input parameter p-start-name as character    no-undo.
     1519   define output parameter p-end-name  as character    no-undo.
     1520       define variable v-is-terminal     as logical           no-undo.
     1521       define buffer buf_temp_fbrglib_found-grp     for temp_fbrglib_found-grp.
     1522       run fbrglib-find-grp-by-full-name in this-procedure (
     1523             input p-obj-type
     1524           , input p-obj-code
     1525           , input p-start-name
     1526           , input no
     1527       ) no-error.
     1528       run fbrglib-get-max-substring in this-procedure (
     1529              input p-obj-type
     1530           ,  input p-obj-code
     1531           ,  input length( p-start-name )
     1532           , output p-end-name
     1533       ) no-error .
     1534       if error-status :error
     1535       then do:
     1536           assign
     1537               p-end-name = ""
     1538           .
     1539       end.
     1540       else do:
     1541           find first temp_fbrglib_found-grp
     1542                where temp_fbrglib_found-grp.full-name = p-end-name
     1543                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
     1544                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     1545                        no-error.
     1546           if available temp_fbrglib_found-grp
     1547           then do:
     1548               find first buf_temp_fbrglib_found-grp
     1549                    where buf_temp_fbrglib_found-grp.full-name begins p-end-name
     1550                      and recid( buf_temp_fbrglib_found-grp ) <> recid( temp_fbrglib_found-grp )
     1551                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
     1552                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     1553               no-error.
     1554               if not available buf_temp_fbrglib_found-grp
     1555               then do:
     1556                   run fbrglib-is-terminal in this-procedure (
     1557                         input p-obj-type
     1558                       , input p-obj-code
     1559                       , input temp_fbrglib_found-grp.node-code
     1560                       , output v-is-terminal
     1561                   ).
     1562               end.
     1563           end.
     1564       end.
     1565   end.
     1566   end procedure.
     1567   procedure fbrglib-get-max-substring :
     1568   do
     1569   on error undo, return error
     1570   :
     1571   define input parameter p-obj-type as character no-undo .
     1572   define input parameter p-obj-code as integer no-undo .
     1573   define input parameter p-min-substring-length   as integer      no-undo.
     1574   define output parameter p-substring             as character    no-undo.
     1575           define variable v-char-counter  as integer           no-undo.
     1576           define variable v-current-char  as character         no-undo.
     1577           define variable v-names-counter  as integer           no-undo.
     1578           define variable v-base-string   as character         no-undo.
     1579           assign
     1580               v-char-counter  = p-min-substring-length
     1581           .
     1582           find first temp_fbrglib_found-grp  where
     1583                      temp_fbrglib_found-grp.obj-type  = p-obj-type
     1584                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     1585           no-error.
     1586           if not available temp_fbrglib_found-grp
     1587           then do:
     1588               undo, return error "fbrglib-get-max-substring: Нет строк для вычисления общей подстроки".
     1589           end.
     1590           else do:
     1591               assign
     1592                   v-base-string = temp_fbrglib_found-grp.full-name
     1593               .
     1594               counter-block:
     1595               do while yes
     1596               on error undo, return error "fbrglib-get-max-substring: Ошибка вычисления продолжения имени группы."
     1597               :
     1598                   assign
     1599                       v-char-counter  = v-char-counter + 1
     1600                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     1601                       v-names-counter = 0
     1602                   .
     1603                   compare-block:
     1604                   for each temp_fbrglib_found-grp
     1605                   where temp_fbrglib_found-grp.obj-type  = p-obj-type
     1606                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     1607                   :
     1608                       assign
     1609                           v-names-counter = v-names-counter + 1
     1610                       .
     1611                       if v-names-counter = 1
     1612                       then do:
     1613                           next compare-block.
     1614                       end.
     1615                       if substring( temp_fbrglib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     1616                       then do:
     1617                           leave counter-block.
     1618                       end.
     1619                   end.
     1620                   if v-names-counter = 1
     1621                   then do:
     1622                       assign
     1623                           p-substring = v-base-string
     1624                       .
     1625                       return.
     1626                   end.
     1627               end.
     1628               assign
     1629                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     1630               .
     1631           end.
     1632   end.
     1633   end procedure.
     1634   procedure fbrglib-is-terminal :
     1635   do
     1636   on error undo, return error "Ошибка процедуры fbrglib-is-terminal"
     1637   :
     1638   define input parameter p-obj-type       as character    no-undo.
     1639   define input parameter p-obj-code       as integer      no-undo.
     1640   define input parameter p-node-code      as integer      no-undo.
     1641   define output parameter p-is-terminal   as logical      no-undo.
     1642       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1643       find first buf_fbr-gds-grp no-lock
     1644            where buf_fbr-gds-grp.obj-type   = p-obj-type
     1645              and buf_fbr-gds-grp.obj-code   = p-obj-code
     1646              and buf_fbr-gds-grp.upper-code = p-node-code
     1647       no-error .
     1648       if not available buf_fbr-gds-grp
     1649       then do:
     1650           assign
     1651               p-is-terminal = yes
     1652           .
     1653       end.
     1654       else do:
     1655           assign
     1656               p-is-terminal = no
     1657           .
     1658       end.
     1659   end.
     1660   end procedure.
     1661   procedure fbrglib-have-goods :
     1662   do
     1663   on error undo, return error
     1664   :
     1665   define input parameter p-obj-type           as character    no-undo.
     1666   define input parameter p-obj-code           as integer      no-undo.
     1667   define input parameter p-node-code          as integer      no-undo.
     1668   define output parameter p-have-fbr-gds-obj  as logical      no-undo.
     1669       define buffer buf_fbr-gds-obj         for ub.fbr-gds-obj.
     1670       find first buf_fbr-gds-obj no-lock
     1671            where buf_fbr-gds-obj.obj-type     = p-obj-type
     1672              and buf_fbr-gds-obj.obj-code     = p-obj-code
     1673              and buf_fbr-gds-obj.fbr-grp-code = p-node-code
     1674       no-error .
     1675       if available buf_fbr-gds-obj
     1676       then do:
     1677           assign
     1678               p-have-fbr-gds-obj = yes
     1679           .
     1680       end.
     1681       else do:
     1682           assign
     1683               p-have-fbr-gds-obj = no
     1684           .
     1685       end.
     1686   end.
     1687   end procedure.
     1688   procedure fbrglib-find-by-substring :
     1689   do
     1690   on error undo, return error
     1691   :
     1692   define input parameter p-start-obj-type     as character    no-undo.
     1693   define input parameter p-start-obj-code     as integer      no-undo.
     1694   define input parameter p-start-code         as integer      no-undo.
     1695   define input parameter p-full-search-string as character    no-undo.
     1696   define output parameter p-found-code        as integer      no-undo.
     1697   define output parameter p-full-name         as character    no-undo.
     1698       define variable v-start-code     as integer           no-undo.
     1699       define variable v-found          as logical  init no  no-undo.
     1700       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1701       search-grp:
     1702       for each buf_fbr-gds-grp no-lock
     1703           where buf_fbr-gds-grp.obj-type  = p-start-obj-type
     1704             and buf_fbr-gds-grp.obj-code  = p-start-obj-code
     1705             and buf_fbr-gds-grp.node-code > p-start-code
     1706       :
     1707           if index( buf_fbr-gds-grp.node-name, p-full-search-string ) <> 0
     1708           then do:
     1709               assign
     1710                   p-found-code = buf_fbr-gds-grp.node-code
     1711                   v-found      = yes
     1712               .
     1713               run fbrglib-get-full-name in this-procedure (
     1714                     input p-start-obj-type
     1715                   , input p-start-obj-code
     1716                   , input p-found-code
     1717                   , output p-full-name
     1718               ) no-error .
     1719               if error-status :error
     1720               then do:
     1721                   undo, return error "fbrglib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1722               end.
     1723               leave search-grp.
     1724           end.
     1725       end.
     1726       if v-found = yes
     1727       then do:
     1728       end.
     1729       else do:
     1730           assign
     1731               p-full-name  = ""
     1732               p-found-code = 0
     1733           .
     1734       end.
     1735   end.
     1736   end procedure.
     1737   procedure fbrglib-analyze-grp-name :
     1738   do
     1739   on error undo, return error
     1740   :
     1741   define input parameter p-grp-name       as character            no-undo.
     1742   define input parameter p-obj-type       as character            no-undo.
     1743   define input parameter p-obj-code       as integer              no-undo.
     1744   define input parameter p-upper-code     as integer              no-undo.
     1745   define output parameter p-error-message as character init ""    no-undo.
     1746       define variable v-char-list     as character    no-undo.
     1747       define variable v-char-counter  as integer      no-undo.
     1748       define variable v-full-name     as character    no-undo.
     1749       if p-grp-name = "" then do:
     1750           assign
     1751               p-error-message = "Название группы не может быть пустым.".
     1752           .
     1753       end.
     1754       else do:
     1755           assign
     1756               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1757           .
     1758           do v-char-counter = 1 to num-entries( v-char-list )
     1759           :
     1760               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1761               then do:
     1762                   assign
     1763                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1764                   .
     1765                   return.
     1766               end.
     1767           end.
     1768           run fbrglib-get-full-name in this-procedure (
     1769                 input p-obj-type
     1770               , input p-obj-code
     1771               , input p-upper-code
     1772               , output v-full-name
     1773           ) no-error .
     1774           if error-status :error
     1775           then do:
     1776               undo, return error "fbrglib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1777           end.
     1778           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
     1779           then do:
     1780               assign
     1781                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
     1782               .
     1783           end.
     1784       end.
     1785   end.
     1786   end procedure.
     1787   procedure fbrglib-delete-grp :
     1788   do
     1789   on error undo, return error
     1790   :
     1791   define input parameter p-obj-type   as character    no-undo.
     1792   define input parameter p-obj-code   as integer      no-undo.
     1793   define input parameter p-node-code  as integer      no-undo.
     1794   define output parameter p-deleted   as logical      no-undo.
     1795       define variable v-have-goods    as logical        no-undo.
     1796       define variable v-yesno         as logical        no-undo.
     1797       define variable v-upper-code    as integer        no-undo.
     1798       define variable v-root-code     as integer        no-undo.
     1799       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     1800       define buffer buf_fbr-gds-obj           for ub.fbr-gds-obj.
     1801       define buffer buf_second_fbr-gds-grp    for ub.fbr-gds-grp.
     1802       run fbrglib-get-root-code in this-procedure (
     1803           output v-root-code
     1804       ) no-error.
     1805       if error-status :error
     1806       then do:
     1807           undo, return error "Не найден корневой узел." + chr(10) + return-value.
     1808       end.
     1809       if p-node-code = v-root-code
     1810       then do:
     1811           message
     1812               "Корневую группу удалить невозможно."
     1813           view-as alert-box error.
     1814           assign
     1815               p-deleted = no
     1816           .
     1817           undo, return.
     1818       end.
     1819       find first buf_fbr-gds-grp no-lock
     1820            where buf_fbr-gds-grp.obj-type     = p-obj-type
     1821              and buf_fbr-gds-grp.obj-code     = p-obj-code
     1822              and buf_fbr-gds-grp.upper-code   = p-node-code
     1823       no-error.
     1824       if available buf_fbr-gds-grp
     1825       then do:
     1826           message
     1827               "Не терминальную группу удалить невозможно."
     1828           view-as alert-box error.
     1829           assign
     1830               p-deleted = no
     1831           .
     1832           undo, return.
     1833       end.
     1834       find first buf_fbr-gds-grp no-lock
     1835            where buf_fbr-gds-grp.obj-type     = p-obj-type
     1836              and buf_fbr-gds-grp.obj-code     = p-obj-code
     1837              and buf_fbr-gds-grp.node-code    = p-node-code
     1838       .
     1839       assign
     1840           v-upper-code = buf_fbr-gds-grp.upper-code
     1841       .
     1842       run fbrglib-have-goods in this-procedure (
     1843             input p-obj-type
     1844           , input p-obj-code
     1845           , input p-node-code
     1846           , output v-have-goods
     1847       ).
     1848       if v-have-goods = yes
     1849       then do:
     1850           find first buf_second_fbr-gds-grp no-lock
     1851                where buf_second_fbr-gds-grp.obj-type      = buf_fbr-gds-grp.obj-type
     1852                  and buf_second_fbr-gds-grp.obj-code      = buf_fbr-gds-grp.obj-code
     1853                  and buf_second_fbr-gds-grp.upper-code    = buf_fbr-gds-grp.upper-code
     1854                  and recid( buf_second_fbr-gds-grp )      <> recid( buf_fbr-gds-grp )
     1855           no-error.
     1856           if available buf_second_fbr-gds-grp
     1857           then do:
     1858               message
     1859                   "В группе есть товары,"
     1860                   skip "которые нельзя перенести в родительскую группу,"
     1861                   skip "потому что у родительской группы есть еще одна подгруппа."
     1862                   skip(1)
     1863                   skip "Перенесите товары в другую группу"
     1864                   skip "или удалите все остальные подгруппы родительской группы."
     1865               view-as alert-box error.
     1866               assign
     1867                   p-deleted = no
     1868               .
     1869               undo, return.
     1870           end.
     1871           message
     1872               "В группе есть товары."
     1873               skip "После удаления группы"
     1874               skip "все ее товары будут привязаны"
     1875               skip "к ее родительской группе."
     1876               skip(1)
     1877               skip "Удалить группу?"
     1878           view-as alert-box warning
     1879           buttons yes-no
     1880           title "Удаление группы"
     1881           update v-yesno
     1882           .
     1883           if v-yesno = yes
     1884           then do:
     1885               do transaction
     1886               on error undo, return error
     1887               :
     1888                   for each buf_fbr-gds-obj exclusive-lock
     1889                      where buf_fbr-gds-obj.obj-type     = p-obj-type
     1890                        and buf_fbr-gds-obj.obj-code     = p-obj-code
     1891                        and buf_fbr-gds-obj.fbr-grp-code = p-node-code
     1892                   on error undo, return error
     1893                   :
     1894                       assign
     1895                           buf_fbr-gds-obj.fbr-grp-code = v-upper-code
     1896                       .
     1897                   end.
     1898               end.
     1899               do transaction
     1900               on error undo, return error
     1901               :
     1902                   find current buf_fbr-gds-grp exclusive-lock .
     1903                   delete buf_fbr-gds-grp no-error .
     1904                   if error-status:error then do:
     1905                     undo, return error return-value .
     1906                   end.
     1907               end.
     1908           end.
     1909       end.
     1910       else do:
     1911           message
     1912               "Имя группы: " buf_fbr-gds-grp.node-name
     1913               "Код группы: " buf_fbr-gds-grp.node-code
     1914               skip(1)
     1915               skip "Удалить группу?"
     1916           view-as alert-box warning
     1917           buttons yes-no
     1918           title "Удаление группы"
     1919           update v-yesno
     1920           .
     1921           if v-yesno = yes
     1922           then do:
     1923               do transaction
     1924               on error undo, return error
     1925               :
     1926                   find current buf_fbr-gds-grp exclusive-lock .
     1927                   delete buf_fbr-gds-grp no-error.
     1928                   if error-status:error then do:
     1929                     undo, return error return-value .
     1930                   end.
     1931               end.
     1932           end.
     1933       end.
     1934   end.
     1935   end procedure.
     1936   procedure fbrglib-add-grp :
     1937   do
     1938   on error undo, return error
     1939   :
     1940   define input parameter p-obj-type       as character    no-undo.
     1941   define input parameter p-obj-code       as integer      no-undo.
     1942   define input parameter p-node-code      as integer      no-undo.
     1943   define input parameter p-interface      as logical      no-undo.
     1944   define input parameter p-node-name      as character    no-undo.
     1945   define input parameter p-out-code       as integer      no-undo.
     1946   define input parameter p-global-code    as integer      no-undo.
     1947   define output parameter p-new-node-code as integer      no-undo.
     1948   define output parameter p-cancel        as logical      no-undo.
     1949       define variable v-have-goods    as logical  no-undo.
     1950       define variable v-host-code     as integer        no-undo.
     1951       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1952       define buffer bf_fbr-gds-grp        for ub.fbr-gds-grp.
     1953       define buffer buf_fbr-gds-obj       for ub.fbr-gds-obj.
     1954       run fbrglib-have-goods in this-procedure (
     1955             input p-obj-type
     1956           , input p-obj-code
     1957           , input p-node-code
     1958           , output v-have-goods
     1959       ) no-error .
     1960       if error-status :error
     1961       then do:
     1962           message
     1963                    vss-workfile vss-revision vss-description
     1964               skip "Ошибка определения наличия товаров в группе."
     1965               skip return-value
     1966               skip trim(error-status :get-message(1))
     1967                    trim(error-status :get-message(2))
     1968                    trim(error-status :get-message(3))
     1969           view-as alert-box error.
     1970           undo, return error .
     1971       end.
     1972   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1973   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1974     (input  p-obj-type
     1975     ,input  p-obj-code
     1976     ,output v-host-code
     1977     )  .
     1978       find first buf_fbr-gds-grp no-lock where
     1979                 buf_fbr-gds-grp.upper-code = p-node-code
     1980             AND buf_fbr-gds-grp.obj-type   = p-obj-type
     1981             AND buf_fbr-gds-grp.obj-code   = p-obj-code
     1982             AND buf_fbr-gds-grp.node-name  = p-node-name no-error .
     1983       if available buf_fbr-gds-grp then do:
     1984           if p-node-code <> 1 then do:
     1985             find first buf_fbr-gds-grp no-lock where
     1986                       buf_fbr-gds-grp.node-code = p-node-code
     1987                   AND buf_fbr-gds-grp.obj-type   = p-obj-type
     1988                   AND buf_fbr-gds-grp.obj-code   = p-obj-code  .
     1989           end.
     1990                   message
     1991           "Для объекта" p-obj-type p-obj-code
     1992           "уже есть группа блюд" p-node-name "в подгруппе" (if p-node-code = 1 then "БЛЮДА" else buf_Fbr-gds-grp.node-name)
     1993           view-as alert-box error .
     1994           undo, return error .
     1995       end.
     1996       do transaction
     1997       on error undo, return error
     1998       :
     1999           create buf_fbr-gds-grp.
     2000           assign
     2001               buf_fbr-gds-grp.node-code   = next-value( s-gds-grp, ub )
     2002               p-new-node-code             = buf_fbr-gds-grp.node-code
     2003               buf_fbr-gds-grp.upper-code  = p-node-code
     2004               buf_fbr-gds-grp.host-code   = v-host-code
     2005               buf_fbr-gds-grp.obj-type    = p-obj-type
     2006               buf_fbr-gds-grp.obj-code    = p-obj-code
     2007               buf_fbr-gds-grp.node-name    = ""
     2008               buf_fbr-gds-grp.out-code    = 0
     2009           .
     2010           if p-interface then do:
     2011             run ref/fbrggrpd.w (
     2012                   input parparentproc
     2013                 , input 'ИЗМЕНЕНИЕ':U
     2014                 , input p-obj-type
     2015                 , input p-obj-code
     2016                 , input buf_fbr-gds-grp.node-code
     2017                 , input buf_fbr-gds-grp.upper-code
     2018                 , input buf_fbr-gds-grp.node-name
     2019                 , input buf_fbr-gds-grp.out-code
     2020                 , output buf_fbr-gds-grp.node-name
     2021                 , output buf_fbr-gds-grp.out-code
     2022                 , output p-cancel
     2023             ).
     2024             if p-cancel = yes
     2025             then do:
     2026                 delete buf_fbr-gds-grp.
     2027                 undo, return.
     2028             end.
     2029           end.
     2030           else do:
     2031             find first bf_fbr-gds-grp no-lock
     2032                 where bf_fbr-gds-grp.obj-type   = p-obj-type
     2033                   and bf_fbr-gds-grp.obj-code   = p-obj-code
     2034                   and bf_fbr-gds-grp.out-code   = p-out-code
     2035             no-error.
     2036             assign
     2037             buf_fbr-gds-grp.node-name    = p-node-name
     2038             buf_fbr-gds-grp.global-code  = p-global-code
     2039             buf_fbr-gds-grp.out-code     = (if available bf_fbr-gds-grp then 0 else p-out-code)
     2040             .
     2041           end.
     2042           if v-have-goods = yes
     2043           then do:
     2044               for each buf_fbr-gds-obj exclusive-lock
     2045                  where buf_fbr-gds-obj.obj-type      = p-obj-type
     2046                    and buf_fbr-gds-obj.obj-code      = p-obj-code
     2047                    and buf_fbr-gds-obj.fbr-grp-code  = p-node-code
     2048               on error undo, return error
     2049               :
     2050                   assign
     2051                       buf_fbr-gds-obj.fbr-grp-code = p-new-node-code
     2052                   .
     2053               end.
     2054           end.
     2055       end.
     2056   end.
     2057   end procedure.
     2058   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2059   FUNCTION mark-string RETURNS CHARACTER
     2060     ( input p-recid as recid, input mark-list as character  ) :
     2061     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     2062   END FUNCTION.
     2063   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2064   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     2065   procedure fltopend_fltopend :
     2066   define input parameter p-parent-handle as handle no-undo .
     2067   define input parameter p-qh as handle no-undo .
     2068   define input parameter p-flt-open-open-query  as character no-undo .
     2069   define input parameter p-where-cond as character no-undo .
     2070   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2071   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2072   define input parameter p-indexed-reposition as character no-undo .
     2073     do
     2074     on error undo, return error
     2075     :
     2076   define variable v-prepare-string as character no-undo .
     2077   define variable glog as logical no-undo .
     2078   assign
     2079   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2080                      p-where-cond + chr(32)  +
     2081                      p-use-indFIRST-query-tail + chr(32) +
     2082                      p-use-ind-sort-clmn-by + chr(32) +
     2083                      p-indexed-reposition
     2084   .
     2085   assign
     2086   glog = p-qh:query-prepare(v-prepare-string) no-error .
     2087   if not glog
     2088   or error-status:error then do:
     2089     message error-status:get-message(1) view-as alert-box .
     2090     undo, return error .
     2091   end.
     2092   assign
     2093   glog = p-qh:query-open no-error .
     2094   if not glog
     2095   or error-status:error then do:
     2096     message error-status:get-message(1) view-as alert-box .
     2097     undo, return error .
     2098   end.
     2099     end.
     2100   end procedure.
     2101   procedure fltopend_fltfindd :
     2102   define input parameter p-parent-handle as handle no-undo .
     2103   define input parameter p-qh as handle no-undo .
     2104   define input parameter p-rowid as rowid no-undo .
     2105   define input parameter p-next as logical no-undo .
     2106   define input parameter p-lock as integer no-undo .
     2107   define input parameter p-bh as handle no-undo .
     2108   define input parameter p-where-cond as character no-undo .
     2109   define input parameter p-use-index-phrase as character no-undo .
     2110   define variable glog as logical no-undo .
     2111   define variable v-qh as handle no-undo .
     2112   define variable v-bh as handle no-undo .
     2113   define variable v-recid as recid no-undo .
     2114   define variable v-prepare-string as character no-undo .
     2115   do
     2116   on error undo, return error
     2117   on stop undo, return error
     2118   :
     2119     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     2120     create buffer v-bh for table p-bh buffer-name p-bh:name.
     2121     create query v-qh.
     2122     v-qh:set-buffers(v-bh).
     2123     v-prepare-string = substitute("for each &1 &2 &3"
     2124                                     ,v-bh:name
     2125                                     ,p-where-cond
     2126                                     ,p-use-index-phrase).
     2127     glog = v-qh:query-prepare(v-prepare-string) no-error.
     2128     if not glog then do:
     2129       delete object v-qh.
     2130       delete object v-bh.
     2131       undo, return error .
     2132     end.
     2133     glog = v-qh:query-open no-error .
     2134     if not glog then do:
     2135       delete object v-qh.
     2136       delete object v-bh.
     2137       undo, return error .
     2138     end.
     2139     if p-next then do:
     2140       v-qh:reposition-to-rowid(p-rowid) no-error .
     2141       glog = v-qh:get-next( p-lock) no-error .
     2142       glog = v-qh:get-next( p-lock) no-error .
     2143       if not glog or v-qh:query-off-end = yes then do:
     2144         glog = v-qh:get-first( p-lock) no-error .
     2145       end.
     2146     end.
     2147     else do:
     2148       glog = v-qh:get-first( p-lock) no-error .
     2149     end.
     2150     v-recid = v-bh:recid no-error .
     2151     delete object v-qh.
     2152     delete object v-bh.
     2153     return string(v-recid) .
     2154   end.
     2155   end procedure.
     2156   procedure fltopend_fltfindq :
     2157   define input parameter p-parent-handle as handle no-undo .
     2158   define input parameter p-qh as handle no-undo .
     2159   define input parameter p-next as logical no-undo .
     2160   define input parameter p-lock as integer no-undo .
     2161   define input parameter p-flt-open-open-query  as character no-undo .
     2162   define input parameter p-where-cond as character no-undo .
     2163   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2164   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2165   define input parameter p-indexed-reposition as character no-undo .
     2166   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     2167   define variable glog as logical no-undo .
     2168   define variable v-qh as handle no-undo .
     2169   define variable v-bh as handle no-undo extent 18.
     2170   define variable v-rowid as rowid no-undo extent 18.
     2171   define variable v-ii as integer no-undo .
     2172   define variable v-prepare-string as character no-undo .
     2173   do
     2174   on error undo, return error
     2175   on stop undo, return error
     2176   :
     2177     create query v-qh.
     2178     do v-ii = 1 to p-qh:num-buffers:
     2179       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     2180       assign
     2181       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     2182       no-error.
     2183       v-qh:add-buffer(v-bh[v-ii]).
     2184     end.
     2185     assign
     2186     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2187                       p-where-cond + chr(32)  +
     2188                       p-use-indFIRST-query-tail + chr(32) +
     2189                       p-use-ind-sort-clmn-by + chr(32) +
     2190                       p-indexed-reposition
     2191     .
     2192     glog = v-qh:query-prepare( v-prepare-string) no-error .
     2193     if not glog then do:
     2194       delete object v-qh.
     2195       do v-ii = 1 to p-qh:num-buffers:
     2196         delete object v-bh[v-ii].
     2197       end.
     2198       undo, return error .
     2199     end.
     2200     glog = v-qh:query-open no-error .
     2201     if not glog then do:
     2202       delete object v-qh.
     2203       do v-ii = 1 to p-qh:num-buffers:
     2204         delete object v-bh[v-ii].
     2205       end.
     2206       undo, return error .
     2207     end.
     2208     if p-next then do:
     2209       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     2210       glog = v-qh:get-next( p-lock) no-error .
     2211       glog = v-qh:get-next( p-lock) no-error .
     2212       if not glog or v-qh:query-off-end = yes then do:
     2213         glog = v-qh:get-first( p-lock) no-error .
     2214       end.
     2215     end.
     2216     else do:
     2217       glog = v-qh:get-first( p-lock) no-error .
     2218     end.
     2219     do v-ii = 1 to p-qh:num-buffers:
     2220       assign
     2221       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     2222       no-error.
     2223     end.
     2224     delete object v-qh.
     2225     do v-ii = 1 to p-qh:num-buffers:
     2226       delete object v-bh[v-ii].
     2227     end.
     2228   end.
     2229   end procedure.
     2230   define variable filter-label as character no-undo init "Справочник персонала на кассе R-KEEPER" .
