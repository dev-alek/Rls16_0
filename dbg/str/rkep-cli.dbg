     2355            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2356            TITLE "Персонал на кассе R-KEEPER"
     2357            DEFAULT-BUTTON b-quit.
     2358   ASSIGN
     2359          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2360          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2361   ON GO OF FRAME Dialog-Frame
     2362   DO:
     2363     p-rid-list = v-rid-list.
     2364   END.
     2365   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2366   DO:
     2367     APPLY "END-ERROR":U TO SELF.
     2368   END.
     2369   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     2370   DO:
     2371     assign
     2372     t-name
     2373     t-role
     2374     .
     2375     if not t-name
     2376     and not t-role
     2377     then do:
     2378       message
     2379       "Не выбрана ни одна опция для синхронизации" skip
     2380       "(название, должность)"
     2381       view-as alert-box error .
     2382       return no-apply.
     2383     end.
     2384   run str/diallog.w (
