      808   end procedure.
      809   procedure prn-lib-reportviewer :
      810     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      811     define input parameter p-report-name-html as character no-undo .
      812     define input parameter p-param        as character no-undo .
      813     define variable v-excel           as character no-undo init 'TRUE' .
      814     define variable v-value-character as character no-undo .
      815     define variable v-value-integer   as character no-undo .
      816     define variable v-value-date      as date      no-undo .
      817     define variable v-value-decimal   as decimal   no-undo .
      818     define variable rep-excel         as logical   no-undo .
      819     define variable excel-string      as character no-undo .
      820     define variable v-param-type      as character no-undo .
      821     define variable v-tth             as handle    no-undo .
      822     run adm/shattri.p (
      823       input "get":U
      824       ,input  ""
      825       ,input  0
      826       ,input  'report-glob':U
      827       ,input  'rep-excel':U
      828       ,output v-value-character
      829       ,output v-value-date
      830       ,output v-value-decimal
      831       ,output v-value-integer
      832       ,output rep-excel
      833       ,output v-param-type
      834       ,INPUT-OUTPUT table-handle v-tth
      835       )  .
      836     if rep-excel then v-excel = "TRUE" .
      837     else v-excel = "FALSE" .
      838     if p-param eq ""
      839     then
      840        p-param = "EXCEL:" + v-excel.
      841     else
      842        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      843     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      844   end procedure.
