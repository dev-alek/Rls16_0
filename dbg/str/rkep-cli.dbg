     4364     if v-rid-list <> "":U then
     4365     REPOSITION br-rkep-cli to recid integer(entry(1, v-rid-list)) No-ERROR.
     4366   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4367   DEF VAR cur-clmn-numbr-rkep-cli as INT EXTENT 9 no-undo.
     4368   DEF VAR varmvibr-rkep-cli       as INT no-undo.
     4369   DEF VAR varmvjbr-rkep-cli       as INT no-undo.
     4370   DEF VAR varmvkbr-rkep-cli       as INT no-undo.
     4371   DEF VAR varmvlbr-rkep-cli       as INT no-undo.
     4372   DEF VAR move-elementbr-rkep-cli as INT no-undo.
     4373   def var jjbr-rkep-cli           as int no-undo.
     4374   do varmvibr-rkep-cli = 1 to EXTENT(cur-clmn-numbr-rkep-cli):
     4375     ASSIGN cur-clmn-numbr-rkep-cli[varmvibr-rkep-cli] = varmvibr-rkep-cli.
     4376   END.
     4377   RUN start-mv-clmnbr-rkep-cli.
     4378   PROCEDURE start-mv-clmnbr-rkep-cli:
     4379   def var old-session as logical no-undo.
     4380      old-session = SESSION:IMMEDIATE-DISPLAY.
     4381      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4382          IF  true  THEN DO:
     4383      DO jjbr-rkep-cli = NUM-ENTRIES('1,2,3,4,5,6,7,8,9') TO 1 BY -1:
     4384        RUN re-move-clmnbr-rkep-cli ( cur-clmn-numbr-rkep-cli[INTEGER(ENTRY (jjbr-rkep-cli, '1,2,3,4,5,6,7,8,9'))] , 2).
     4385      END.
     4386          END.
     4387      SESSION:IMMEDIATE-DISPLAY = old-session.
     4388   END.
     4389   ON ctrl-cursor-right OF BROWSE br-rkep-cli do:
     4390     RUN re-move-clmnbr-rkep-cli ( 2, 9).
     4391   END.
     4392   ON ctrl-cursor-left OF BROWSE br-rkep-cli do:
     4393     RUN re-move-clmnbr-rkep-cli (9, 2).
     4394   END.
     4395   PROCEDURE re-move-clmnbr-rkep-cli:
     4396     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     4397     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     4398     DO varmvibr-rkep-cli = 1 TO EXTENT(cur-clmn-numbr-rkep-cli):
     4399       if cur-clmn-numbr-rkep-cli[varmvibr-rkep-cli] = source-column THEN cur-clmn-numbr-rkep-cli[varmvibr-rkep-cli] = -1.
     4400     END.
     4401     if br-rkep-cli:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     4402     if source-column > target-column THEN
     4403     DO varmvjbr-rkep-cli = source-column - 1 to target-column BY -1:
     4404       DO varmvibr-rkep-cli = 1 TO EXTENT(cur-clmn-numbr-rkep-cli):
     4405           if cur-clmn-numbr-rkep-cli[varmvibr-rkep-cli] = varmvjbr-rkep-cli THEN DO:
     4406             cur-clmn-numbr-rkep-cli[varmvibr-rkep-cli] = cur-clmn-numbr-rkep-cli[varmvibr-rkep-cli] + 1.
     4407           END.
     4408       END.
     4409     END.
     4410     ELSE
     4411     DO varmvjbr-rkep-cli = source-column + 1 to target-column:
     4412       DO varmvibr-rkep-cli = 1 TO EXTENT(cur-clmn-numbr-rkep-cli):
     4413         if cur-clmn-numbr-rkep-cli[varmvibr-rkep-cli] = varmvjbr-rkep-cli THEN DO:
     4414           cur-clmn-numbr-rkep-cli[varmvibr-rkep-cli] = cur-clmn-numbr-rkep-cli[varmvibr-rkep-cli] - 1.
     4415         END.
     4416       END.
     4417     END.
     4418     DO varmvibr-rkep-cli = 1 TO EXTENT(cur-clmn-numbr-rkep-cli):
     4419       if cur-clmn-numbr-rkep-cli[varmvibr-rkep-cli] = -1 THEN cur-clmn-numbr-rkep-cli[varmvibr-rkep-cli] = target-column.
     4420     END.
     4421   END PROCEDURE.
     4422   PROCEDURE ch-clmnbr-rkep-cli:
     4423     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     4424     if cur-clmn-loc <= 2 then do:
     4425       return .
     4426     end.
     4427     DO varmvibr-rkep-cli = 1 TO EXTENT(cur-clmn-numbr-rkep-cli):
     4428       if cur-clmn-numbr-rkep-cli[varmvibr-rkep-cli] = cur-clmn-loc THEN move-elementbr-rkep-cli = varmvibr-rkep-cli.
     4429     END.
     4430     RUN re-move-clmnbr-rkep-cli (cur-clmn-loc, 2).
     4431   END PROCEDURE.
     4432   PROCEDURE mv-brw-defaultbr-rkep-cli:
     4433   def var old-session as logical no-undo.
     4434     old-session = SESSION:IMMEDIATE-DISPLAY.
     4435     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4436     do varmvlbr-rkep-cli = 2 to EXTENT(cur-clmn-numbr-rkep-cli):
     4437       RUN re-move-clmnbr-rkep-cli (cur-clmn-numbr-rkep-cli[varmvlbr-rkep-cli], varmvlbr-rkep-cli).
     4438     END.
     4439     RUN start-mv-clmnbr-rkep-cli.
     4440     SESSION:IMMEDIATE-DISPLAY = old-session.
     4441   END PROCEDURE.
     4442   .
     4443     WAIT-FOR GO OF FRAME Dialog-Frame.
     4444   END.
     4445   RUN disable_UI in this-procedure .
     4446   PROCEDURE disable_UI :
     4447     HIDE FRAME Dialog-Frame.
     4448   END PROCEDURE.
     4449   PROCEDURE enable_UI :
     4450     DISPLAY T-batch rs-mode T-role T-name RS-sch sch-name sch-id mark-num
     4451         WITH FRAME Dialog-Frame.
     4452     ENABLE b-quit B-mark b-sel B-link b-chg B-print B-sch B-Help T-batch rs-mode
     4453            T-role T-name RS-sch sch-name sch-id BR-rkep-cli mark-num
     4454         WITH FRAME Dialog-Frame.
     4455     VIEW FRAME Dialog-Frame.
     4456     OPEN QUERY BR-rkep-cli FOR EACH X_cd-clu NO-LOCK,             FIRST X_staff OUTER-JOIN NO-LOCK where X_staff.psn-code = X_cd-clu.cli-code         AND  X_staff.role = entry(lookup(X_cd-clu.clu-type,        v-rkep-cli-role-list),        v-th-role-list)         and X_staff.db-num = v-db-num         and X_staff.date-end = 12/31/9999,            FIRST X_clients OUTER-JOIN NO-LOCK WHERE X_clients.obj-type = 'чел':U         AND X_clients.obj-code = X_staff.psn-code      INDEXED-REPOSITION.
     4457   END PROCEDURE.
     4458   PROCEDURE MyEnable :
     4459   assign
     4460   v-tab-order = "b-quit,b-mark,b-sel,b-link,b-chg,b-sch,b-print,b-help," +
     4461                 "t-batch,rs-mode,t-role,t-name," +
     4462                  "rs-sch,sch-id,sch-full_name,br-rkep-cli"
     4463   br-rkep-cli:num-locked-columns in frame Dialog-Frame = 1
     4464   X_cd-clu.charkey_one:read-only in browse br-rkep-cli = yes
     4465   rs-mode:RADIO-BUTTONS IN FRAME Dialog-Frame
     4466                          = "С привязкой&+" + chr(44) +  "+":U + chr(44) +
     4467                          "Все&!" + chr(44) + 'все':U + chr(44) +
     4468                           "Без привязки&-" + chr(44) + "-":U
     4469   rs-mode = p-mode
     4470   t-name = logical(entry(1, p-status, chr(4)))
     4471   t-role = logical(entry(2, p-status, chr(4)))
     4472   .
     4473   rs-sch = "id":U.
     4474   DISPLAY
     4475   rs-mode
     4476   sch-id
     4477   mark-num
     4478   WITH FRAME Dialog-Frame.
     4479   run proc-buttons in this-procedure ( input no).
     4480   ENABLE
     4481   b-quit
     4482   b-sel WHEN lookup("b-sel", bttns) > 0
     4483   b-chg
     4484   B-sch
     4485   B-print
     4486   B-Help
     4487   rs-mode
     4488   rs-sch
     4489   BR-rkep-cli
     4490   WITH FRAME Dialog-Frame.
     4491   VIEW FRAME Dialog-Frame.
     4492   RUN proc-rs-sch IN THIS-PROCEDURE.
     4493   APPLY "VALUE-CHANGED" TO rs-mode.
     4494   APPLY "ENTRY" TO BR-rkep-cli.
     4495   IF t-role THEN APPLY "VALUE-CHANGED" TO t-role.
     4496   IF t-name THEN APPLY "VALUE-CHANGED" TO t-name.
     4497   END PROCEDURE.
     4498   PROCEDURE OpenBr :
     4499   define input  parameter p-open-query     as logical   no-undo .
     4500   define input  parameter p-find-next      as logical   no-undo .
     4501   define input  parameter p-find-condition as character no-undo .
     4502   define variable l-query-was-opened as logical no-undo .
     4503   define variable title0 as character no-undo.
     4504   title0 = "Справочник персонала на кассе R-KEEPER" + chr(32).
     4505   run waitfram-show in this-procedure ( input "Ждите...").
     4506   define variable sort-column-phrase as character no-undo .
     4507   case sort-column-name :
     4508     when "" then do:
     4509       assign
     4510         sort-column-phrase = ""
     4511       .
     4512     end.
     4513     otherwise do:
     4514       assign
     4515         sort-column-phrase = "by " + sort-column-name
     4516       .
     4517     end.
     4518   end case.
     4519   define variable l-open-query as logical   no-undo .
     4520     CASE v-mode :
     4521       WHEN 'все':U        THEN DO:
     4522        assign
     4523        filter-point = filter-point0 + v-mode
     4524        filter-label = substitute("&1 Один объект", filter-label0)
     4525        .
     4526         if p-open-query then do:
     4527           frame Dialog-Frame:TITLE = title0.
     4528         end.
     4529   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4530   define variable  l-disable-where-36  as logical   no-undo .
     4531   define variable  l-filter-open-36    as logical   .
     4532   define variable  flt-rec-36       as recid     no-undo .
     4533   define variable  filter-name-36      as character no-undo .
     4534   define variable  where-phrase-36     as character no-undo .
     4535   define variable  sort-phrase-36      as character no-undo .
     4536   define variable  where-phrase-rus-36 as character no-undo .
     4537   define variable  sort-phrase-rus-36  as character no-undo .
     4538     run waitfram-show in this-procedure
     4539       (input "ЖДИТЕ ..."
     4540       ).
     4541   run gbl/flt-get.p
     4542     (input filter-point
     4543     ,output flt-rec-36
     4544     ,output filter-name-36
     4545     ,output where-phrase-36
     4546     ,output sort-phrase-36
     4547     ,output where-phrase-rus-36
     4548     ,output sort-phrase-rus-36
     4549     ).
     4550   if p-open-query then do:
     4551       run set-filter-name in this-procedure
     4552         (INPUT filter-name-36
     4553         ) no-error .
     4554     assign
     4555       l-filter-open-36 = false
     4556     .
     4557     if flt-rec-36 <> ?
     4558       or sort-column-phrase > ""
     4559     then do:
     4560       define variable  parameter-2-36 as character no-undo .
     4561       define variable  parameter-3-36 as character no-undo .
     4562       define variable  parameter-4-36 as character no-undo .
     4563       define variable  parameter-5-36 as character no-undo .
     4564       define variable  parameter-6-36 as character no-undo .
     4565       define variable  parameter-7-36 as character no-undo .
     4566         assign
     4567         parameter-3-36 =
     4568                                 "FOR EACH X_cd-clu"
     4569         parameter-4-36 =
     4570           (
     4571             if (" X_cd-clu.obj-type = p-curr-obj-type and X_cd-clu.obj-code = p-curr-obj-code and X_cd-clu.pos-type = 'r-keeper':U " + " " + where-phrase-36) <> ""
     4572             then  substitute('X_cd-clu.obj-type = &1&2&1 and X_cd-clu.obj-code = &3 and X_cd-clu.pos-type = &1&4&1 '                              , chr(34), p-curr-obj-type, p-curr-obj-code, 'r-keeper':U) + " " + where-phrase-36
     4573             else "true"
     4574           )
     4575         parameter-5-36 = (" " + "" + " " +  substitute(', FIRST X_staff outer-join NO-LOCK WHERE X_staff.psn-code = X_cd-clu.cli-code                                         /*and X_staff.role = entry(lookup(X_cd-clu.clu-type, &1&2&1), &1&3&1)*/                                         and X_staff.db-num = &4                                         and X_staff.date-end = &5,                                   first X_clients outer-join no-lock where X_clients.obj-type = &1&6&1 AND                                        X_clients.obj-code  = X_staff.psn-code ', chr(34), v-rkep-cli-role-list, v-th-role-list, v-db-num, 12/31/9999, 'чел':U))
     4576         parameter-6-36 = if sort-phrase-36 = ''
     4577                              then
     4578           (
     4579           " " + "  " +
     4580             " " + sort-column-phrase +
     4581           " " + "  "
     4582           )
     4583                              else
     4584           (
     4585           " " + "  " +
     4586             " " + sort-column-phrase +
     4587           " " + sort-phrase-36
     4588           )
     4589         parameter-7-36 =
     4590           " indexed-reposition  "
     4591       .
     4592       do
     4593       on stop undo, leave
     4594       on error undo, leave
     4595       :
     4596         assign
     4597           l-disable-where-36 =
     4598             (" X_cd-clu.obj-type = p-curr-obj-type and X_cd-clu.obj-code = p-curr-obj-code and X_cd-clu.pos-type = 'r-keeper':U " + " " + where-phrase-36 = "")
     4599         .
     4600         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4601                             ,input QUERY br-rkep-cli:handle
     4602                             ,input parameter-3-36
     4603                             ,input parameter-4-36
     4604                             ,input parameter-5-36
     4605                             ,input parameter-6-36
     4606                             ,input parameter-7-36
     4607                             )
     4608         .
     4609         assign
     4610           l-filter-open-36 = true
     4611         .
     4612       end.
     4613       if l-filter-open-36 = false then do:
     4614         message
     4615           "Ошибка при фильтрации / сортировке" skip
     4616           "Будут показаны записи без учета фильтра" skip
     4617           view-as alert-box .
     4618       end.
     4619       else do:
     4620           assign
     4621             l-query-was-opened = true
     4622           .
     4623       end.
     4624     end.
     4625     if l-filter-open-36 = false then do:
