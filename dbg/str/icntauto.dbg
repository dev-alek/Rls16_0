        1   block-level on error undo, throw.
        2   define input parameter parparentproc   as widget-handle no-undo.
        3   define input parameter p-rvs-doc-rowid as rowid         no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: icntauto.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: str/icntauto.p $":U .
        9   define variable vss-description as character no-undo init "Автоматическое создание инвентаризации счетчиков ТРК по документу сверки".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70     define new global shared variable g#lib-rvs as handle no-undo.
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72     define variable v-cntxt-db-num        as integer   no-undo .
       73     define variable v-cntxt-userid        as character no-undo .
       74     define variable v-cntxt-level         as character no-undo .
       75     define variable v-cntxt-host-code-obj as integer   no-undo .
       76     define variable v-cntxt-obj-type      as character no-undo .
       77     define variable v-cntxt-obj-code      as integer   no-undo .
       78     define variable v-cntxt-db-num-obj    as integer   no-undo .
       79     define variable v-cntxt-is-admin      as logical   no-undo .
       80   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   define variable v-waitfram-action01         as character   no-undo .
       82   define variable v-waitfram-action02         as character   no-undo .
       83   define variable v-waitfram-action03         as character   no-undo .
       84   define variable mWaitFramTextBeg            as character   no-undo.
       85   define variable mWaitFramTextEnd            as character   no-undo.
       86   define variable mWaitFramView               as logical     no-undo.
       87   define variable mWaitProcEvent              as logical     no-undo init yes.
       88   define variable mWaitFramInterval           as integer     no-undo init 1 .
       89   define variable mWaitFramStop               as logical     no-undo.
       90   define variable mWaitFramStopUser           as logical     no-undo.
       91   define variable mWaitFramStopTimeOut        as logical     no-undo.
       92   define variable mWaitFramStartProc          as datetime-tz no-undo.
       93   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       94   define button B-WaitFramStop auto-end-key
       95        label "Стоп"
       96        size 10 by 1 tooltip "Остоновить процесс".
       97   define button B-viewProcInfo
       98        label "Информация"
       99        size 15 by 1 tooltip "Информация о процесс".
      100   define frame waitfram
      101     v-waitfram-action01 format "x(72)" no-label skip
      102     v-waitfram-action02 format "x(72)" no-label skip
      103     v-waitfram-action03 format "x(72)" no-label skip
      104     B-viewProcInfo
      105     B-WaitFramStop at row 4 col 30
      106     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      107     .
      108   define new global shared variable mBatchMode as logical no-undo init ?.
      109   define variable mFramBachModHandle as handle no-undo.
      110   mFramBachModHandle = frame waitfram:handle.
      111   define variable mFameOldVis as logical no-undo.
      112   define variable mVisCUrentVin as logical no-undo.
      113   if session:batch-mode
      114   then
      115      mBatchMode = yes.
      116   if mBatchMode = ? then do:
      117     mVisCUrentVin = current-window:visible.
      118     mFameOldVis = mFramBachModHandle:visible.
      119     mFramBachModHandle:visible  = yes.
      120     mBatchMode = mFramBachModHandle:visible ne yes.
      121     mFramBachModHandle:visible = mFameOldVis.
      122     current-window:visible = mVisCUrentVin.
      123   end.
      124    if  log-manager:logfile-name ne ?
      125     then DO:
      126         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      127         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      128         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      129     end.
      130   on choose of B-WaitFramStop in frame waitfram
      131   do:
      132     mWaitFramStop = yes.
      133     mWaitFramStopUser = yes.
      134   end.
      135   function waitfram-check-timeout returns logical():
      136      define variable vtime as int64 no-undo.
      137      if mWaitFramStopTimeOut
      138      then
      139         return yes.
      140      vtime = ( now - mWaitFramStartProc ) / 1000 .
      141      if     mWaitFramTimeOut ne ?
      142         and mWaitFramTimeOut ne 0
      143         and mWaitFramTimeOut lt vtime
      144      then do:
      145         mWaitFramStopTimeOut = yes.
      146      end.
      147      return mWaitFramStopTimeOut.
      148   end.
      149   procedure waitfram-hide :
      150     if not session:batch-mode
      151     then do
      152     on error undo, return error return-value
      153     :
      154       pause 0 before-hide .
      155       if not mBatchMode then
      156         hide frame waitfram .
      157     if     not mWaitFramView
      158        and mWaitProcEvent
      159     then
      160       process events .
      161     end.
      162   end procedure.
      163   procedure waitfram-show :
      164     define input  parameter p-message as character no-undo .
      165     define variable v-left-margin as integer   no-undo .
      166     if not session:batch-mode
      167     then do
      168     on error undo, return error return-value
      169     :
      170       if length(p-message) <= 70 then do:
      171         assign
      172           v-left-margin = integer((70 - length(p-message)) / 2)
      173         .
      174         assign
      175           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      176         .
      177         assign
      178           v-waitfram-action01 = " "
      179           v-waitfram-action02 = " "
      180                                    + fill(" ", v-left-margin)
      181                                    + p-message
      182           v-waitfram-action03 = " "
      183         .
      184       end.
      185       else do:
      186         define variable vRindex1 as integer no-undo.
      187         define variable vRindex2 as integer no-undo.
      188         vRindex1 = r-index(p-message," ",70).
      189         if vRindex1 = 0
      190         then
      191            vRindex1 = 70.
      192         if length(p-message)  <= vRindex1 + 70 then do:
      193           assign
      194             v-waitfram-action01 = " "
      195             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      196             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      197           .
      198         end.
      199         else do:
      200           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      201           if vRindex2 <= vRindex1
      202           then
      203              vRindex2 = vRindex1 + 70.
      204           assign
      205             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      206             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      207             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      208           .
      209         end.
      210       end.
      211       B-viewProcInfo:visible   in frame waitfram = no.
      212       B-viewProcInfo:sensitive in frame waitfram = no.
      213       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      214       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      215       if  (   mWaitFramView
      216          or  mWaitProcEvent)
      217          and not mBatchMode
      218       then
      219          display
      220             v-waitfram-action01 skip
      221             v-waitfram-action02 skip
      222             v-waitfram-action03 skip
      223          with frame waitfram .
      224       if     mWaitFramView
      225          then do:
      226             if     mWaitFramInterval ne ?
      227                and not mBatchMode
      228             then
      229                wait-for go of frame waitfram pause mWaitFramInterval.
      230          end.
      231          else
      232             if     mWaitProcEvent
      233                and not mBatchMode
      234             then
      235                process events .
      236     end.
      237   end procedure.
      238      procedure waitfram-show-this:
      239         define input  parameter iInterval as int64 no-undo.
      240         define variable vtime as int64 no-undo.
      241         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      242         mWaitFramInterval = iInterval.
      243         run waitfram-show (substitute("&1&2 &3&4" ,
      244                                       mWaitFramTextBeg ,
      245                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      246                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      247                                       mWaitFramTextEnd
      248                                      )
      249                           ).
      250      end.
      251      procedure WaitFramRunPause:
      252         define input  parameter iInterval as dec no-undo.
      253         define variable vStart  as datetime-tz no-undo.
      254         define variable vend    as datetime-tz no-undo.
      255         define variable vint as int64 no-undo.
      256         define variable vOk as logical no-undo.
      257         vStart = now.
      258         vend   = vStart.
      259         publish "WaitFramPause" (iInterval,output vOk).
      260         vend   =  now.
      261         vint = vend - vStart.
      262         vint = iInterval - vint / 1000.
      263         if     not mWaitFramStop
      264            and (   vint > 0
      265                 or (    not vOk
      266                     and iInterval eq ?
      267                     )
      268                 )
      269         then
      270            run waitfram-show-this (iInterval).
      271         vend   =  now.
      272         vint = vend - vStart.
      273         vint = iInterval - vint / 1000.
      274         if     not mWaitFramStop
      275            and vint > 0
      276         then do:
      277            run gbl/pause.p (vint * 1000).
      278         end.
      279         if iInterval ne ?
      280         then
      281            publish "WaitFramStop".
      282         waitfram-check-timeout().
      283      end.
      284      procedure WaitFramWaitFor:
      285         define input  parameter iInterval as dec no-undo.
      286         assign
      287            mWaitFramStartProc   = now
      288            mWaitFramStopUser    = no
      289            mWaitFramStopTimeOut = no
      290         .
      291         block-wait:
      292         do while not mWaitFramStop:
      293            run WaitFramRunPause (iInterval).
      294            if  waitfram-check-timeout()
      295            then do:
      296               leave block-wait.
      297            end.
      298         end.
      299         run waitfram-hide.
      300      end.
      301   procedure waitfram-join :
      302     define input  parameter p-line-1  as character no-undo .
      303     define input  parameter p-line-2  as character no-undo .
      304     define input  parameter p-line-3  as character no-undo .
      305     define output parameter p-message as character no-undo .
      306     do
      307     on error undo, return error return-value
      308     :
      309       assign
      310         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      311                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      312                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      313       .
      314     end.
      315   end procedure.
      316   function waitfram-join-function returns character
      317     (input p-line-1 as character
      318     ,input p-line-2 as character
      319     ,input p-line-3 as character
      320     ).
      321     define variable v-message as character no-undo .
      322     run waitfram-join in this-procedure
      323       (input  p-line-1
      324       ,input  p-line-2
      325       ,input  p-line-3
      326       ,output v-message
      327       ) .
      328     return v-message .
      329   end function .
      330   define temp-table tt-icnt-doc   no-undo like ub.icnt-doc.
      331   define temp-table tt-icnt-line  no-undo like ub.icnt-line.
      332   define buffer cur_rvs-doc         for ub.rvs-doc.
      333   define buffer prev_rvs-doc        for ub.rvs-doc.
      334   define buffer cur_shift-obj       for ub.shift-obj.
      335   define buffer prev_shift-obj      for ub.shift-obj.
      336   define buffer cur_rvs-line-pump   for ub.rvs-line-pump.
      337   define buffer prev_rvs-line-pump  for ub.rvs-line-pump.
      338   define buffer prev_icnt-line      for ub.icnt-line.
      339   define buffer buf_icnt-doc        for ub.icnt-doc.
      340   define buffer buf_rvs-line        for ub.rvs-line.
      341   define buffer bf_pl-gds-pump      for ub.pl-gds-pump.
      342   define variable v-log           as logical    no-undo .
      343   define variable v-today         as date       no-undo .
      344   define variable v-recid         as recid      no-undo .
      345   define variable v-meas-el-cnt   as decimal    no-undo .
      346   define variable v-state-el-cnt  as decimal    no-undo .
      347   define variable v-state-mh-cnt  as decimal    no-undo .
      348   function get-overflow return decimal ( input p-val as decimal ) forward.
      349   _main-block:
      350   do
      351   on error  undo _main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      352   on stop   undo _main-block, return error substitute( "&1. stop", vss-workfile )
      353   on endkey undo _main-block, return error substitute( "&1. endkey", vss-workfile )
      354   :
      355     find first cur_rvs-doc no-lock
      356       where rowid(cur_rvs-doc) = p-rvs-doc-rowid
      357     no-error .
      358     if not available cur_rvs-doc then do:
      359       undo _main-block , return error "Не найден документ сверки":U.
      360     end.
      361     find first cur_shift-obj no-lock
      362       where cur_shift-obj.obj-type = cur_rvs-doc.obj-type
      363         and cur_shift-obj.obj-code = cur_rvs-doc.obj-code
      364         and cur_shift-obj.status_  = 'тек':U
      365     no-error.
      366     if not available cur_shift-obj then do:
      367       undo _main-block , return error substitute( 'Нет открытой смены на объекте &1 &2'
      368                                                 , cur_rvs-doc.obj-type
      369                                                 , cur_rvs-doc.obj-code
      370                                                 ).
      371     end.
      372     find last prev_shift-obj no-lock
      373       where prev_shift-obj.obj-type   = cur_shift-obj.obj-type
      374         and prev_shift-obj.obj-code   = cur_shift-obj.obj-code
      375         and prev_shift-obj.status_    = 'зкр':U
      376         and ( prev_shift-obj.shift-date < cur_shift-obj.shift-date
      377             or
      378               prev_shift-obj.shift-date = cur_shift-obj.shift-date
      379             and
      380               prev_shift-obj.shift-num  < cur_shift-obj.shift-num
      381             )
      382       use-index stts no-error.
      383     if available prev_shift-obj then do:
      384       find last prev_rvs-doc no-lock
      385         where prev_rvs-doc.obj-type   = prev_shift-obj.obj-type
      386           and prev_rvs-doc.obj-code   = prev_shift-obj.obj-code
      387           and prev_rvs-doc.shift-date = prev_shift-obj.shift-date
      388           and prev_rvs-doc.shift-num  = prev_shift-obj.shift-num
      389           and prev_rvs-doc.status_    = 'факт':U
      390           and prev_rvs-doc.rvs-type   = 'смена':U
      391         no-error.
      392     end.
      393   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      394     run mainmenu_getcntxt in parparentproc
      395       (output v-cntxt-db-num
      396       ,output v-cntxt-userid
      397       ,output v-cntxt-level
      398       ,output v-cntxt-host-code-obj
      399       ,output v-cntxt-obj-type
      400       ,output v-cntxt-obj-code
      401       ,output v-cntxt-db-num-obj
      402       ,output v-cntxt-is-admin
      403       ) .
      404   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      405   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      406     (input  cur_rvs-doc.obj-type
      407     ,input  cur_rvs-doc.obj-code
      408     ,output v-today
      409     )  .
      410     run clear-temp in this-procedure .
      411     create tt-icnt-doc.
      412     assign
      413       tt-icnt-doc.doc-code      = "":U
      414       tt-icnt-doc.obj-type      = cur_rvs-doc.obj-type
      415       tt-icnt-doc.obj-code      = cur_rvs-doc.obj-code
      416       tt-icnt-doc.host-code     = cur_rvs-doc.host-code
      417       tt-icnt-doc.wrkr          = cur_rvs-doc.wrkr
      418       tt-icnt-doc.agnt          = cur_rvs-doc.agnt
      419       tt-icnt-doc.boss          = cur_rvs-doc.boss
      420       tt-icnt-doc.doc-date      = v-today
      421       tt-icnt-doc.meas-el-cnt   = 0
      422       tt-icnt-doc.state-el-cnt  = 0
      423       tt-icnt-doc.state-mh-cnt  = 0
      424       tt-icnt-doc.PS            = cur_rvs-doc.rvs-code
      425       tt-icnt-doc.creid         = v-cntxt-userid
      426     .
      427     for each cur_rvs-line-pump exclusive-lock
      428       where cur_rvs-line-pump.rvs-code = cur_rvs-doc.rvs-code
      429     on error  undo _main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      430     on stop   undo _main-block, return error substitute( "&1. stop", vss-workfile )
      431     on endkey undo _main-block, return error substitute( "&1. endkey", vss-workfile )
      432     :
      433       find first prev_rvs-line-pump no-lock
      434         where prev_rvs-line-pump.rvs-code     = prev_rvs-doc.rvs-code
      435           and prev_rvs-line-pump.obj-type     = prev_rvs-doc.obj-type
      436           and prev_rvs-line-pump.obj-code     = prev_rvs-doc.obj-code
      437           and prev_rvs-line-pump.pl-code      = cur_rvs-line-pump.pl-code
      438           and prev_rvs-line-pump.gds-code     = cur_rvs-line-pump.gds-code
      439           and prev_rvs-line-pump.pump-code    = cur_rvs-line-pump.pump-code
      440           and prev_rvs-line-pump.nozzle-code  = cur_rvs-line-pump.nozzle-code
      441       no-error .
      442       find first tt-icnt-line no-lock
      443         where tt-icnt-line.doc-code    = tt-icnt-doc.doc-code
      444           and tt-icnt-line.obj-code    = tt-icnt-doc.obj-code
      445           and tt-icnt-line.obj-type    = tt-icnt-doc.obj-type
      446           and tt-icnt-line.pump-code   = cur_rvs-line-pump.pump-code
      447           and tt-icnt-line.nozzle-code = cur_rvs-line-pump.nozzle-code
      448         no-error .
      449       if not available tt-icnt-line then do:
      450         create tt-icnt-line.
      451         assign
      452           tt-icnt-line.doc-code     = tt-icnt-doc.doc-code
      453           tt-icnt-line.obj-code     = cur_rvs-line-pump.obj-code
      454           tt-icnt-line.obj-type     = cur_rvs-line-pump.obj-type
      455           tt-icnt-line.pl-code      = cur_rvs-line-pump.pl-code
      456           tt-icnt-line.gds-code     = cur_rvs-line-pump.gds-code
      457           tt-icnt-line.pump-code    = cur_rvs-line-pump.pump-code
      458           tt-icnt-line.nozzle-code  = cur_rvs-line-pump.nozzle-code
      459           tt-icnt-line.state-el-cnt = cur_rvs-line-pump.state-el-cnt
      460           tt-icnt-line.meas-el-cnt  = cur_rvs-line-pump.meas-el-cnt
      461           tt-icnt-line.state-mh-cnt = cur_rvs-line-pump.state-mh-cnt
      462         .
      463       end.
      464       if available prev_rvs-line-pump
      465       and cur_rvs-line-pump.state-el-cnt < prev_rvs-line-pump.state-el-cnt
      466       then do:
      467         find first bf_pl-gds-pump no-lock where bf_pl-gds-pump.obj-type = cur_rvs-line-pump.obj-type
      468                                             and bf_pl-gds-pump.obj-code = cur_rvs-line-pump.obj-code
      469                                             and bf_pl-gds-pump.gds-code = cur_rvs-line-pump.gds-code
      470                                             and bf_pl-gds-pump.pl-code  = cur_rvs-line-pump.pl-code
      471                                             and bf_pl-gds-pump.pump-code = cur_rvs-line-pump.pump-code
      472                                             no-error.
      473         if available bf_pl-gds-pump
      474         and bf_pl-gds-pump.status_ = 'блок':U
      475         then do : end .
      476         else
      477         assign
      478           tt-icnt-line.state-mh-cnt = tt-icnt-line.state-mh-cnt + get-overflow( prev_rvs-line-pump.state-el-cnt )
      479         .
      480         assign
      481           cur_rvs-line-pump.state-mh-cnt  = tt-icnt-line.state-mh-cnt
      482           cur_rvs-line-pump.state-mh-qnty = cur_rvs-line-pump.state-mh-cnt - prev_rvs-line-pump.state-mh-cnt
      483           cur_rvs-line-pump.meas-mh-cnt   = cur_rvs-line-pump.state-mh-cnt
      484           cur_rvs-line-pump.meas-mh-qnty  = cur_rvs-line-pump.state-mh-qnty
      485         .
      486         end.
      487       end.
      488     for each tt-icnt-line
      489       where tt-icnt-line.doc-code = tt-icnt-doc.doc-code
      490         and tt-icnt-line.obj-code = tt-icnt-doc.obj-code
      491         and tt-icnt-line.obj-type = tt-icnt-doc.obj-type
      492     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      493     :
      494       assign
      495         v-meas-el-cnt  = v-meas-el-cnt  + tt-icnt-line.meas-el-cnt
      496         v-state-el-cnt = v-state-el-cnt + tt-icnt-line.state-el-cnt
      497         v-state-mh-cnt = v-state-mh-cnt + tt-icnt-line.state-mh-cnt
      498       .
      499     end.
      500     for each buf_rvs-line no-lock
      501     on error  undo _main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      502     on stop   undo _main-block, return error substitute( "&1. stop", vss-workfile )
      503     on endkey undo _main-block, return error substitute( "&1. endkey", vss-workfile )
      504     :
      505   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_rvsclcln in g#lib-rvs ( input recid(buf_rvs-line) ) no-error .
      506       if error-status :error then do:
      507         undo _main-block , return error substitute( "Ошибка пересчета количества по резервуарам.&1&2&1&3":U, chr(10), return-value, error-status :get-message(1) ).
      508       end.
      509     end.
      510     assign
      511       tt-icnt-doc.meas-el-cnt  = v-meas-el-cnt
      512       tt-icnt-doc.state-el-cnt = v-state-el-cnt
      513       tt-icnt-doc.state-mh-cnt = v-state-mh-cnt
      514     .
      515     run waitfram-show in this-procedure ( "Создание документа инвентаризации счетчиков ТРК":U ) .
      516     run str/icntdoc1.p
      517       ( input 'ДОБАВЛЕНИЕ':U
      518        ,input no
      519        ,input-output v-recid
      520        ,INPUT tt-icnt-doc.doc-code
      521        ,input tt-icnt-doc.obj-type
      522        ,input tt-icnt-doc.obj-code
      523        ,input tt-icnt-doc.host-code
      524        ,input 'инв-сч-трк':U
      525        ,input 'ip':U
      526        ,input tt-icnt-doc.wrkr
      527        ,input tt-icnt-doc.agnt
      528        ,input tt-icnt-doc.boss
      529        ,input tt-icnt-doc.doc-date
      530        ,input tt-icnt-doc.meas-el-cnt
      531        ,input tt-icnt-doc.state-el-cnt
      532        ,input tt-icnt-doc.state-mh-cnt
      533        ,input tt-icnt-doc.PS
      534        ,input tt-icnt-doc.creid
      535        ,input '':U
      536        ,input table tt-icnt-line
      537       ) no-error.
      538     if error-status:error then do:
      539       undo _main-block , return error return-value .
      540     end.
      541     find first buf_icnt-doc exclusive-lock
      542       where recid(buf_icnt-doc) = v-recid
      543     no-error .
      544     if not available buf_icnt-doc then do:
      545       undo _main-block , return error "Не найден документ автоматической инвентаризации":U.
      546     end.
      547     assign
      548       buf_icnt-doc.PS = "@":U
      549     .
      550     release buf_icnt-doc .
      551     run waitfram-show in this-procedure ( "Закрытие документа инвентаризации счетчиков ТРК":U ) .
      552     run str/icntdoc2.p
      553       ( input v-recid
      554        ,input no
      555       ) no-error.
      556     if error-status:error then do:
      557       undo _main-block , return error return-value .
      558     end.
      559     run clear-temp in this-procedure .
      560     run waitfram-hide in this-procedure .
      561   end.
      562   procedure clear-temp :
      563   do
      564   on error undo, return error return-value
      565   :
      566     for each tt-icnt-doc
      567     on error undo, return error return-value
      568     :
      569       delete tt-icnt-doc .
      570     end.
      571     for each tt-icnt-line
      572     on error undo, return error return-value
      573     :
      574       delete tt-icnt-line .
      575     end.
      576   end.
      577   end procedure.
      578   function get-overflow return decimal ( input p-val as decimal ).
      579     define variable v-val       as decimal   no-undo .
      580     define variable v-overflow  as decimal   no-undo .
      581     assign
      582       v-val       = p-val
      583       v-overflow  = 1
      584     .
      585     do while v-val > 1 :
      586       assign
      587         v-val       = v-val / 10
      588         v-overflow  = v-overflow * 10
      589       .
      590     end.
      591     return v-overflow.
      592   end function.
