     3399       define  variable discnt-rubl-sale            like ub.gds-dtl.discnt-rubl no-undo.
     3400       define buffer out-vatp_gds-dtl     for ub.gds-dtl.
     3401       define buffer buf_out-vatp_gds-dtl for ub.gds-dtl.
     3402       define buffer out-vatp_parts       for ub.parts.
