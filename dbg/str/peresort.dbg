     1867     (input  bf_trn-doc.obj-type
     1868     ,input  bf_trn-doc.obj-code
     1869     ,input  varb-code
     1870     ,input  0
     1871     ,input  bf_trn-doc.fact-order
     1872     ,output vardoc-num
     1873     ,output varprice-sale
     1874     ,output varroad-tax
     1875     ,output varexcise
     1876     )  .
     1877             if varprice-sale = ?
     1878             then do:
     1879               assign
     1880                 varprice-sale = 0
     1881                 varroad-tax   = 0
     1882                 varexcise     = 0
     1883               .
     1884             end.
     1885             assign
     1886               varlastcur-base     = varprice-sale
     1887               varlastcur-road-tax = varroad-tax
     1888               varlastcur-excise   = varexcise
     1889               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     1890               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     1891               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     1892               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     1893             .
     1894         end.
     1895       end.
     1896       if varcur-fact-qnty = 0 then do:
     1897         assign
     1898           varcur-base      = varlastcur-base
     1899           varcur-road-tax  = varlastcur-road-tax
     1900           varcur-excise    = varlastcur-excise
     1901         .
     1902       end.
     1903       else do:
     1904         assign
     1905           varcur-base      = varcur-base      / varcur-fact-qnty
     1906           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     1907           varcur-excise    = varcur-excise    / varcur-fact-qnty
     1908         .
     1909       end.
     1910       if varcur-vat-pc = ?
     1911       then do:
     1912         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     1913       end.
