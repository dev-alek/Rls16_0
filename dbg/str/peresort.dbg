     6631   PROCEDURE add-doc :
     6632   define output parameter parrecid as recid no-undo.
     6633   define variable vardoc-code   like ub.trn-doc.doc-code    no-undo.
     6634   define variable v-today       as date                     no-undo.
     6635   define variable varbase-rate  as decimal no-undo.
     6636   define variable varbase-scale as decimal no-undo.
     6637   define variable varsupp-code  as integer   no-undo.
     6638   define variable varsupp-type  as character no-undo.
     6639   define variable varsupp-name  as character no-undo.
     6640   define buffer bf_pay-type     for ub.pay-type.
     6641   define buffer bf-supp_clients for ub.clients.
     6642   define buffer bf_sys-ctrl     for ub.sys-ctrl.
     6643   define buffer bf_store for ub.store.
     6644   define buffer bf_shop  for ub.shop.
     6645   do on error undo, return error RETURN-VALUE :
     6646     if not parold-supp-cntr then do:
     6647       FIND FIRST bf-supp_clients WHERE bf-supp_clients.obj-type = parcli-type AND
     6648                                        bf-supp_clients.obj-code = parcli-code NO-LOCK.
     6649       ASSIGN
     6650         varcli-type = bf-supp_clients.obj-type
     6651         varcli-code = bf-supp_clients.obj-code
     6652         varcli-name = bf-supp_clients.obj-name.
     6653     end.
     6654     if bf-obj_clients.obj-type = 'маг':U then do:
     6655       find first bf_shop where bf_shop.obj-code = bf-obj_clients.obj-code no-lock.
     6656       FIND FIRST bf_pay-type where bf_pay-type.obj-code = bf_shop.inv-pay NO-LOCK NO-ERROR.
     6657     end.
     6658     else do:
     6659       find first bf_store where bf_store.obj-code = bf-obj_clients.obj-code no-lock.
     6660       FIND FIRST bf_pay-type where bf_pay-type.obj-code = bf_store.inv-pay NO-LOCK NO-ERROR.
     6661     end.
     6662     if not AVAILABLE bf_pay-type then do:
     6663       message "Не задан код оплаты для инвентаризации в настройках по текущему объекту." VIEW-AS ALERT-BOX.
     6664       return error.
     6665     end.
     6666     find first bf_sys-ctrl no-lock.
     6667     run doc-code in this-procedure
     6668     (input  "main",
     6669      input  parobj-type,
     6670      input  parobj-code,
     6671      input  ?,
     6672      output vardoc-code ) no-error.
