     5496       assign
     5497         varshift-name   = ""
     5498         bf_trn-doc.shift-num = 0.
     5499       display varshift-name bf_trn-doc.shift-num @ varshift-num with frame Dialog-Frame.
     5500       apply "entry" to varshift-name in frame Dialog-Frame.
     5501       return no-apply.
     5502     end.
     5503   end.
     5504   ON return OF varshift-date IN FRAME Dialog-Frame
