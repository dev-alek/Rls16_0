     4834   ASSIGN
     4835          varcontract-prn-code:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     4836   ASSIGN
     4837          varinformation:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     4838   ON end-error OF FRAME Dialog-Frame
     4839   DO:
     4840     apply "choose" to b-exit in frame Dialog-Frame.
     4841     return no-apply.
     4842   END.
     4843   ON GO OF FRAME Dialog-Frame
     4844   DO:
     4845     run proc-exit in this-procedure no-error.
     4846     if error-status :error then do:
     4847       return no-apply.
     4848     end.
     4849   END.
     4850   ON stop OF FRAME Dialog-Frame
     4851   DO:
     4852     apply "choose" to b-exit in frame Dialog-Frame.
     4853     return no-apply.
     4854   END.
     4855   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     4856   DO:
     4857     APPLY "END-ERROR":U TO SELF.
     4858   END.
     4859   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     4860   DO:
     4861   define variable vss-include-info32 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4862   if lookup(self :type
     4863            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     4864            ) = 0
     4865   then do:
     4866     message
     4867       "$Workfile$"
     4868       "Указанному интерфейсному элементу фокус не может быть передан" skip
     4869       "Интерфейсный элемент" self :name  skip
     4870       "Тип" self :type  skip
     4871       "Процедура" this-procedure :file-name skip
     4872       view-as alert-box .
     4873   end.
     4874   else do:
     4875     apply "entry":u to self  .
     4876     if focus :handle <> self :handle  then do:
     4877       return no-apply .
     4878     end.
     4879   end.
     4880     run local-add in this-procedure no-error.
     4881     if error-status:error then do:
     4882       message "Ошибка при добавлении строк пересортицы." skip
     4883       return-value
     4884       view-as alert-box error.
     4885       return no-apply.
     4886     end.
     4887     run ui-on in this-procedure ("":u) .
     4888   END.
