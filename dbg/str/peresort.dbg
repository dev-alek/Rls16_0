     5430     define buffer bf-chk_doc-line for ub.doc-line.
     5431     find first bf-chk_doc-line where bf-chk_doc-line.doc-code = bf_trn-doc.doc-code no-error.
     5432     if available bf-chk_doc-line then do:
     5433       message "В документе уже есть строки. Не допускается изменение фактической даты." view-as alert-box.
     5434       return no-apply.
     5435     end.
     5436     run proc-shift-num in this-procedure no-error.
     5437     if error-status:error then do:
     5438       return no-apply.
     5439     end.
     5440     run proc-sht in this-procedure no-error.
     5441   END.
