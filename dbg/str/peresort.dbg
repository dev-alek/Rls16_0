     4998     if varis-petrol-plus and
     4999        not varis-pieces-plus then do:
     5000       message "По топливу " bf-plus_goods.artic " " bf-plus_goods.prod-type " " bf-plus_goods.prod-code " " bf-plus_goods.gds-name " -топливо." skip
     5001               "Редактирование возможно через удаление и добавление."
     5002       view-as alert-box.
     5003       return no-apply.
     5004     end.
     5005     find first bf_gds-prt where bf_gds-prt.upper-code = bf_goods.prt-root no-lock.
     5006     if bf_gds-prt.node-name <> '_Пустая шкала':U then do:
     5007       find first bf-trb_parts where bf-trb_parts.out-code  = bf_trn-doc.doc-code and
     5008                                     bf-trb_parts.obj-type  = bf_trn-doc.obj-type and
     5009                                     bf-trb_parts.obj-code  = bf_trn-doc.obj-code and
     5010                                     bf-trb_parts.artic     = bf_goods.artic      and
     5011                                     bf-trb_parts.prod-type = bf_goods.prod-type  and
     5012                                     bf-trb_parts.prod-code = bf_goods.prod-code  and
     5013                                     bf-trb_parts.fact-qnty > 0                   no-error.
     5014       if available bf-trb_parts then do:
     5015         message "По товару с признаками " bf_goods.artic " " bf_goods.prod-type " " bf_goods.prod-code " " bf_goods.gds-name " есть оприходования." skip
     5016                 "Редактирование возможно через удаление и добавление."
     5017         view-as alert-box.
     5018         return no-apply.
     5019       end.
     5020       assign
     5021         varhave-another-goods =no.
     5022       for each bf-trb_parts-root where bf-trb_parts-root.doc-code      = bf_trn-doc.doc-code    and
     5023                                        bf-trb_parts-root.orig-gds-code = bf_goods.gds-code      and
     5024                                        bf-trb_parts-root.gds-code     <> bf-plus_goods.gds-code on error undo, return no-apply return-value :
     5025         assign
     5026           varhave-another-goods = yes.
     5027       end.
     5028       if varhave-another-goods then do:
     5029         message "По товару с признаками " bf_goods.artic " " bf_goods.prod-type " " bf_goods.prod-code " " bf_goods.gds-name " есть списания в связке с другим товарам." skip
     5030                 "Редактирование возможно через удаление и добавление."
     5031         view-as alert-box.
     5032         return no-apply.
     5033       end.
     5034     end.
     5035     find first bf-plus_gds-prt where bf-plus_gds-prt.upper-code = bf-plus_goods.prt-root no-lock.
     5036     if bf_gds-prt.node-name <> '_Пустая шкала':U then do:
     5037       find first bf-trb_parts where bf-trb_parts.out-code  = bf_trn-doc.doc-code      and
     5038                                     bf-trb_parts.obj-type  = bf_trn-doc.obj-type      and
     5039                                     bf-trb_parts.obj-code  = bf_trn-doc.obj-code      and
     5040                                     bf-trb_parts.artic     = bf-plus_goods.artic      and
     5041                                     bf-trb_parts.prod-type = bf-plus_goods.prod-type  and
     5042                                     bf-trb_parts.prod-code = bf-plus_goods.prod-code  and
     5043                                     bf-trb_parts.fact-qnty < 0                        no-error.
     5044       if available bf-trb_parts then do:
     5045         message "По товару с признаками " bf-plus_goods.artic " " bf-plus_goods.prod-type " " bf-plus_goods.prod-code " " bf-plus_goods.gds-name " есть списания." skip
     5046                 "Редактирование возможно через удаление и добавление."
     5047         view-as alert-box.
     5048         return no-apply.
     5049       end.
     5050       assign
     5051         varhave-another-goods =no.
     5052       for each bf-trb_parts-root where bf-trb_parts-root.doc-code       = bf_trn-doc.doc-code    and
     5053                                        bf-trb_parts-root.gds-code       = bf-plus_goods.gds-code and
     5054                                        bf-trb_parts-root.orig-gds-code <> bf_goods.gds-code      on error undo, return no-apply return-value :
     5055         assign
     5056           varhave-another-goods = yes.
     5057       end.
     5058       if varhave-another-goods then do:
     5059         message "По товару с признаками " bf-plus_goods.artic " " bf-plus_goods.prod-type " " bf-plus_goods.prod-code " " bf-plus_goods.gds-name " есть оприходования в связке другим товарам." skip
     5060                 "Редактирование возможно через удаление и добавление."
     5061         view-as alert-box.
     5062         return no-apply.
     5063       end.
     5064     end.
     5065     run local-chg in this-procedure no-error.
     5066     if error-status:error then do:
     5067       message "Ошибка при изменении строк пересортицы." skip
     5068       return-value
     5069       view-as alert-box error.
     5070       return no-apply.
     5071     end.
     5072     run proc-get-write-off in this-procedure (buffer bf_doc-line).
     5073     run ui-on in this-procedure ("":u) .
     5074   END.
     5075   ON CHOOSE OF b-cnt IN FRAME Dialog-Frame
     5076   DO:
     5077   define variable vss-include-info36 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5078   if lookup(self :type
     5079            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     5080            ) = 0
     5081   then do:
