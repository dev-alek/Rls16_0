     5356       ,  input bf_trn-doc.obj-code
     5357       ,  input bf_goods.gds-code
     5358       ,  input bf_doc-line.doc-code
     5359       ,  input 'ПРОСМОТР':U
     5360       ,  input 'документ':U
     5361       ,  input 'текущий':U
     5362       , input 'документ':U
     5363       , output varprt-rec
     5364       ) .
