     2152   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2153   define variable v-waitfram-action01         as character   no-undo .
     2154   define variable v-waitfram-action02         as character   no-undo .
     2155   define variable v-waitfram-action03         as character   no-undo .
     2156   define variable mWaitFramTextBeg            as character   no-undo.
     2157   define variable mWaitFramTextEnd            as character   no-undo.
     2158   define variable mWaitFramView               as logical     no-undo.
     2159   define variable mWaitProcEvent              as logical     no-undo init yes.
     2160   define variable mWaitFramInterval           as integer     no-undo init 1 .
     2161   define variable mWaitFramStop               as logical     no-undo.
     2162   define variable mWaitFramStopUser           as logical     no-undo.
     2163   define variable mWaitFramStopTimeOut        as logical     no-undo.
     2164   define variable mWaitFramStartProc          as datetime-tz no-undo.
     2165   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     2166   define button B-WaitFramStop auto-end-key
     2167        label "Стоп"
     2168        size 10 by 1 tooltip "Остоновить процесс".
     2169   define button B-viewProcInfo
     2170        label "Информация"
     2171        size 15 by 1 tooltip "Информация о процесс".
     2172   define frame waitfram
     2173     v-waitfram-action01 format "x(72)" no-label skip
     2174     v-waitfram-action02 format "x(72)" no-label skip
     2175     v-waitfram-action03 format "x(72)" no-label skip
     2176     B-viewProcInfo
     2177     B-WaitFramStop at row 4 col 30
     2178     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     2179     .
     2180   define new global shared variable mBatchMode as logical no-undo init ?.
     2181   define variable mFramBachModHandle as handle no-undo.
     2182   mFramBachModHandle = frame waitfram:handle.
     2183   define variable mFameOldVis as logical no-undo.
     2184   define variable mVisCUrentVin as logical no-undo.
     2185   if session:batch-mode
     2186   then
     2187      mBatchMode = yes.
     2188   if mBatchMode = ? then do:
     2189     mVisCUrentVin = current-window:visible.
     2190     mFameOldVis = mFramBachModHandle:visible.
     2191     mFramBachModHandle:visible  = yes.
     2192     mBatchMode = mFramBachModHandle:visible ne yes.
     2193     mFramBachModHandle:visible = mFameOldVis.
     2194     current-window:visible = mVisCUrentVin.
     2195   end.
     2196    if  log-manager:logfile-name ne ?
     2197     then DO:
     2198         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2199         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2200         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     2201     end.
     2202   on choose of B-WaitFramStop in frame waitfram
     2203   do:
     2204     mWaitFramStop = yes.
     2205     mWaitFramStopUser = yes.
     2206   end.
     2207   function waitfram-check-timeout returns logical():
     2208      define variable vtime as int64 no-undo.
     2209      if mWaitFramStopTimeOut
     2210      then
     2211         return yes.
     2212      vtime = ( now - mWaitFramStartProc ) / 1000 .
     2213      if     mWaitFramTimeOut ne ?
     2214         and mWaitFramTimeOut ne 0
     2215         and mWaitFramTimeOut lt vtime
     2216      then do:
     2217         mWaitFramStopTimeOut = yes.
     2218      end.
     2219      return mWaitFramStopTimeOut.
     2220   end.
     2221   procedure waitfram-hide :
     2222     if not session:batch-mode
     2223     then do
     2224     on error undo, return error return-value
     2225     :
     2226       pause 0 before-hide .
     2227       if not mBatchMode then
     2228         hide frame waitfram .
     2229     end.
     2230   end procedure.
     2231   procedure waitfram-show :
     2232     define input  parameter p-message as character no-undo .
     2233     define variable v-left-margin as integer   no-undo .
     2234     if not session:batch-mode
     2235     then do
     2236     on error undo, return error return-value
     2237     :
     2238       if length(p-message) <= 70 then do:
     2239         assign
     2240           v-left-margin = integer((70 - length(p-message)) / 2)
     2241         .
     2242         assign
     2243           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     2244         .
     2245         assign
     2246           v-waitfram-action01 = " "
     2247           v-waitfram-action02 = " "
     2248                                    + fill(" ", v-left-margin)
     2249                                    + p-message
     2250           v-waitfram-action03 = " "
     2251         .
     2252       end.
     2253       else do:
     2254         define variable vRindex1 as integer no-undo.
     2255         define variable vRindex2 as integer no-undo.
     2256         vRindex1 = r-index(p-message," ",70).
     2257         if vRindex1 = 0
     2258         then
     2259            vRindex1 = 70.
     2260         if length(p-message)  <= vRindex1 + 70 then do:
     2261           assign
     2262             v-waitfram-action01 = " "
     2263             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     2264             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     2265           .
     2266         end.
     2267         else do:
     2268           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     2269           if vRindex2 <= vRindex1
     2270           then
     2271              vRindex2 = vRindex1 + 70.
     2272           assign
     2273             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     2274             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     2275             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     2276           .
     2277         end.
     2278       end.
     2279       B-viewProcInfo:visible   in frame waitfram = no.
     2280       B-viewProcInfo:sensitive in frame waitfram = no.
     2281       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2282       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2283       if  (   mWaitFramView
     2284          or  mWaitProcEvent)
     2285          and not mBatchMode
     2286       then
     2287          display
     2288             v-waitfram-action01 skip
     2289             v-waitfram-action02 skip
     2290             v-waitfram-action03 skip
     2291          with frame waitfram .
     2292     end.
     2293   end procedure.
     2294      procedure waitfram-show-this:
     2295         define input  parameter iInterval as int64 no-undo.
     2296         define variable vtime as int64 no-undo.
     2297         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     2298         mWaitFramInterval = iInterval.
     2299         run waitfram-show (substitute("&1&2 &3&4" ,
     2300                                       mWaitFramTextBeg ,
     2301                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     2302                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     2303                                       mWaitFramTextEnd
     2304                                      )
     2305                           ).
     2306      end.
     2307      procedure WaitFramRunPause:
     2308         define input  parameter iInterval as dec no-undo.
     2309         define variable vStart  as datetime-tz no-undo.
     2310         define variable vend    as datetime-tz no-undo.
     2311         define variable vint as int64 no-undo.
     2312         define variable vOk as logical no-undo.
     2313         vStart = now.
     2314         vend   = vStart.
     2315         publish "WaitFramPause" (iInterval,output vOk).
     2316         vend   =  now.
     2317         vint = vend - vStart.
     2318         vint = iInterval - vint / 1000.
     2319         if     not mWaitFramStop
     2320            and (   vint > 0
     2321                 or (    not vOk
     2322                     and iInterval eq ?
     2323                     )
     2324                 )
     2325         then
     2326            run waitfram-show-this (iInterval).
     2327         vend   =  now.
     2328         vint = vend - vStart.
     2329         vint = iInterval - vint / 1000.
     2330         if     not mWaitFramStop
     2331            and vint > 0
     2332         then do:
     2333            run gbl/pause.p (vint * 1000).
     2334         end.
     2335         if iInterval ne ?
     2336         then
     2337            publish "WaitFramStop".
     2338         waitfram-check-timeout().
     2339      end.
     2340      procedure WaitFramWaitFor:
     2341         define input  parameter iInterval as dec no-undo.
     2342         assign
     2343            mWaitFramStartProc   = now
     2344            mWaitFramStopUser    = no
     2345            mWaitFramStopTimeOut = no
     2346         .
     2347         block-wait:
     2348         do while not mWaitFramStop:
     2349            run WaitFramRunPause (iInterval).
     2350            if  waitfram-check-timeout()
     2351            then do:
     2352               leave block-wait.
     2353            end.
     2354         end.
     2355         run waitfram-hide.
     2356      end.
     2357   procedure waitfram-join :
     2358     define input  parameter p-line-1  as character no-undo .
     2359     define input  parameter p-line-2  as character no-undo .
     2360     define input  parameter p-line-3  as character no-undo .
     2361     define output parameter p-message as character no-undo .
     2362     do
     2363     on error undo, return error return-value
     2364     :
     2365       assign
     2366         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2367                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2368                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2369       .
     2370     end.
     2371   end procedure.
     2372   function waitfram-join-function returns character
     2373     (input p-line-1 as character
     2374     ,input p-line-2 as character
     2375     ,input p-line-3 as character
     2376     ).
     2377     define variable v-message as character no-undo .
     2378     run waitfram-join in this-procedure
     2379       (input  p-line-1
     2380       ,input  p-line-2
     2381       ,input  p-line-3
     2382       ,output v-message
     2383       ) .
     2384     return v-message .
     2385   end function .
     2386   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2387     define variable v-cntxt-db-num        as integer   no-undo .
     2388     define variable v-cntxt-userid        as character no-undo .
     2389     define variable v-cntxt-level         as character no-undo .
     2390     define variable v-cntxt-host-code-obj as integer   no-undo .
     2391     define variable v-cntxt-obj-type      as character no-undo .
     2392     define variable v-cntxt-obj-code      as integer   no-undo .
     2393     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2394     define variable v-cntxt-is-admin      as logical   no-undo .
     2395   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2396   procedure doc-code:
     2397   define input  parameter parmode          as   character           no-undo.
     2398   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
     2399   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
     2400   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
     2401   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
     2402   define buffer buf_sys-ctrl for ub.sys-ctrl  .
     2403   define variable vardb-remote     as   logical             no-undo.
     2404   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
     2405   define variable v-delimiter as character no-undo .
     2406   do
     2407   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2408   :
     2409   find first buf_sys-ctrl no-lock .
     2410   vardb-remote = buf_sys-ctrl.db-num <> 0 .
     2411     CASE parmode:
     2412       when "main":u then do:
     2413         if vardb-remote then do:
     2414           assign
     2415             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
     2416         end.
     2417         else do:
     2418           assign
     2419             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
     2420         end.
     2421       end.
     2422       when "trio" then do:
     2423         assign
     2424           pardoc-code = replace (parroot-doc-code, "=", "*").
     2425       end.
     2426       otherwise do:
     2427         assign
     2428         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
     2429         no-error
     2430         .
     2431         if error-status:error  then do:
     2432           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     2433                                         ,chr(10)
     2434                                         ,parmode
     2435                                         ).
     2436         end.
     2437         if num-entries(parmode) = 1
     2438         and parmode <> "chip":U
     2439         and parmode <> "chip_s":U
     2440         then do:
     2441           assign
     2442           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     2443         end.
     2444         else if (lookup("chip":U, parmode) > 0
     2445                  or
     2446                  lookup("chip_s":U, parmode) > 0) then do:
     2447           assign
     2448             vartemp-doc-code = parroot-doc-code.
     2449           do while true:
     2450             if index (vartemp-doc-code , ".") = 0 then
     2451               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     2452             else
     2453               vartemp-doc-code  =
     2454               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     2455               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     2456               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     2457             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     2458           end.
     2459           assign
     2460             pardoc-code = vartemp-doc-code.
     2461         end.
     2462       end.
     2463     end CASE.
     2464     if pardoc-code = '':U
     2465     or (parroot-doc-code <> '':U
     2466     and pardoc-code = parroot-doc-code) then do:
     2467       undo, return error substitute("Ошибка при генерации номера документа&1"
     2468                                     ,chr(10)).
     2469     end.
     2470   end.
     2471   end. // procedure/method
     2472   function get-doc-code-int64 returns int64
     2473     ( input p-doc-code as character ) :
     2474     define variable v-ind              as integer   no-undo .
     2475     define variable v-num-entries      as integer   no-undo .
     2476     define variable v-doc-code-int64   as int64     no-undo .
     2477     define variable v-canonic-doc-code as character no-undo .
     2478     assign
     2479       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     2480       v-canonic-doc-code = p-doc-code
     2481     .
     2482     do v-ind = 1 to v-num-entries
     2483     :
     2484       assign
     2485         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     2486       .
     2487     end.
     2488     assign
     2489       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     2490     .
     2491     return v-doc-code-int64 .
     2492   end. // function/method
     2493   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2494   procedure holdprts-create-parts-supp :
     2495     define input  parameter p-orig-in-code   like ub.parts-supp.orig-in-code   no-undo .
     2496     define input  parameter p-orig-part-code like ub.parts-supp.orig-part-code no-undo .
     2497     define input  parameter p-in-code        like ub.parts-supp.in-code        no-undo .
     2498     define input  parameter p-artic          like ub.parts-supp.artic          no-undo .
     2499     define input  parameter p-prod-type      like ub.parts-supp.prod-type      no-undo .
     2500     define input  parameter p-prod-code      like ub.parts-supp.prod-code      no-undo .
     2501     define input  parameter p-part-code      like ub.parts-supp.part-code      no-undo .
     2502     define variable vss-description as character no-undo init "holdprts-create-parts-supp-01: скопировать атрибут партии".
     2503     define buffer buf_parent_trn-doc  for ub.trn-doc .
     2504     define buffer buf_child_trn-doc   for ub.trn-doc .
     2505     define buffer buf_parts           for ub.parts .
     2506     define buffer buf_parts-supp      for ub.parts-supp .
     2507     define buffer buf_orig_parts-supp for ub.parts-supp .
     2508     define buffer buf_income_trn-doc  for ub.trn-doc .
     2509     define buffer buf_income_doc-line for ub.doc-line .
     2510     define buffer buf_goods           for ub.goods .
     2511       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     2512       define buffer   in-vatp-parts    for ub.parts   .
     2513       define buffer   in-vatp-doc      for ub.trn-doc .
     2514       define buffer   in-vatp-goods    for ub.goods   .
     2515       define buffer   in-vatp-sysconf  for ub.sysconf .
     2516       define buffer   in-vatp_doc-attr for ub.doc-attr.
     2517       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     2518       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     2519       define variable varinvprb                  as   character              no-undo.
     2520       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     2521       define variable cli-base-rate              as   decimal                no-undo.
     2522       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     2523       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     2524       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     2525       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     2526       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     2527       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     2528       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     2529       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     2530       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     2531       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     2532       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     2533       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     2534       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     2535       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     2536       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     2537       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     2538       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     2539       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     2540       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     2541       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     2542       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     2543       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     2544       define variable varinvatp-envd             as   character              no-undo.
     2545       define variable varinvatp-type             as   character              no-undo.
     2546     do
     2547     on error undo, return error return-value
     2548     :
     2549       find first buf_child_trn-doc no-lock
     2550         where buf_child_trn-doc.doc-code = p-in-code
     2551         no-error .
     2552       if not available buf_child_trn-doc
     2553       then do:
     2554         return substitute("Не найден исходный документ &1", p-in-code) .
     2555       end.
     2556       find first buf_parent_trn-doc no-lock
     2557         where buf_parent_trn-doc.doc-code = buf_child_trn-doc.hold-doc-code-parent
     2558         no-error .
     2559       if not available buf_parent_trn-doc
     2560       then do:
     2561         return substitute("Не найден приходный документ &1", buf_child_trn-doc.hold-doc-code-parent) .
     2562       end.
     2563       find first buf_parts-supp exclusive-lock
     2564         where buf_parts-supp.in-code   = p-in-code
     2565           and buf_parts-supp.artic     = p-artic
     2566           and buf_parts-supp.prod-type = p-prod-type
     2567           and buf_parts-supp.prod-code = p-prod-code
     2568           and buf_parts-supp.part-code = p-part-code
     2569         no-error .
     2570       if available buf_parts-supp
     2571       then do:
     2572         message
     2573           vss-workfile vss-revision vss-description skip
     2574           vss-include-info18 skip
     2575           "Попытка повторного создания партии атрибутов" skip
     2576           "Документ прихода" p-in-code skip
     2577           "Артикул" p-artic p-prod-type p-prod-code skip
     2578           "Код партии" p-part-code skip
     2579           "Исходный код партии" p-orig-in-code skip
     2580           "Исходный код документа" p-orig-part-code skip
     2581           view-as alert-box error .
     2582         undo, return error .
     2583       end.
     2584       create buf_parts-supp .
     2585       assign
     2586         buf_parts-supp.in-code   = p-in-code
     2587         buf_parts-supp.artic     = p-artic
     2588         buf_parts-supp.prod-type = p-prod-type
     2589         buf_parts-supp.prod-code = p-prod-code
     2590         buf_parts-supp.part-code = p-part-code
     2591       .
     2592       assign
     2593         buf_parts-supp.orig-in-code   = p-orig-in-code
     2594         buf_parts-supp.orig-part-code = p-orig-part-code
     2595       .
     2596       find first buf_orig_parts-supp share-lock
     2597         where buf_orig_parts-supp.in-code   = p-orig-in-code
     2598           and buf_orig_parts-supp.artic     = p-artic
     2599           and buf_orig_parts-supp.prod-type = p-prod-type
     2600           and buf_orig_parts-supp.prod-code = p-prod-code
     2601           and buf_orig_parts-supp.part-code = p-orig-part-code
     2602         no-error .
     2603       if available buf_orig_parts-supp
     2604       then do:
     2605         buffer-copy buf_orig_parts-supp
     2606         except
     2607           buf_orig_parts-supp.in-code
     2608           buf_orig_parts-supp.artic
     2609           buf_orig_parts-supp.prod-type
     2610           buf_orig_parts-supp.prod-code
     2611           buf_orig_parts-supp.part-code
     2612           buf_orig_parts-supp.orig-in-code
     2613           buf_orig_parts-supp.orig-part-code
     2614         to buf_parts-supp.
     2615       end.
     2616       else do:
     2617         find first buf_parts share-lock
     2618           where buf_parts.obj-type  = buf_parent_trn-doc.obj-type
     2619             and buf_parts.obj-code  = buf_parent_trn-doc.obj-code
     2620             and buf_parts.artic     = p-artic
     2621             and buf_parts.prod-type = p-prod-type
     2622             and buf_parts.prod-code = p-prod-code
     2623             and buf_parts.in-code   = p-orig-in-code
     2624             and buf_parts.out-code  = buf_parent_trn-doc.doc-code
     2625             and buf_parts.part-code = p-orig-part-code
     2626           no-error .
     2627         if not available buf_parts
     2628         then do:
     2629           message
     2630             vss-workfile vss-revision vss-description skip
     2631             vss-include-info18 skip
     2632             "Ошибка задания входных параметров" skip
     2633             "Не найдена исходная партия" skip
     2634             "Исходный документ" p-orig-in-code skip
     2635             "Артикул" p-artic p-prod-type p-prod-code skip
     2636             "Код партии" p-orig-part-code skip
     2637             view-as alert-box error .
     2638           undo, return error .
     2639         end.
     2640         define variable v-base-rate         as decimal   no-undo .
     2641         define variable v-base-scale        as integer   no-undo .
     2642         define variable v-exch-rate         as decimal   no-undo .
     2643         define variable v-exch-scale        as integer   no-undo .
     2644         define variable v-extended-doc-type as character no-undo .
     2645         define variable v-unit-cli          as character no-undo .
     2646         find first buf_income_trn-doc no-lock
     2647           where buf_income_trn-doc.doc-code = p-orig-in-code
     2648           no-error .
     2649         if available buf_income_trn-doc
     2650         then do:
     2651           find first buf_income_doc-line no-lock
     2652             where buf_income_doc-line.doc-code  = p-orig-in-code
     2653               and buf_income_doc-line.artic     = p-artic
     2654               and buf_income_doc-line.prod-type = p-prod-type
     2655               and buf_income_doc-line.prod-code = p-prod-code
     2656             no-error .
     2657           if not available buf_income_doc-line
     2658           then do:
     2659             message
     2660               vss-workfile vss-revision vss-description skip
     2661               vss-include-info18 skip
     2662               "Не найдена исходная строка документа прихода" skip
     2663               "Исходный документ" p-orig-in-code skip
     2664               "Артикул" p-artic p-prod-type p-prod-code skip
     2665               "Код партии" p-orig-part-code skip
     2666               view-as alert-box error .
     2667             undo, return error .
     2668           end.
     2669           assign
     2670             v-base-rate         = buf_income_trn-doc.base-rate
     2671             v-base-scale        = buf_income_trn-doc.base-scale
     2672             v-exch-rate         = buf_income_trn-doc.exch-rate
     2673             v-exch-scale        = buf_income_trn-doc.exch-scale
     2674             v-extended-doc-type = buf_income_trn-doc.ext-doc-type
     2675             v-unit-cli          = buf_income_doc-line.unit-cli
     2676           .
     2677         end.
     2678         else do:
     2679           find first buf_goods no-lock
     2680             where buf_goods.artic     = buf_parts.artic
     2681               and buf_goods.prod-type = buf_parts.prod-type
     2682               and buf_goods.prod-code = buf_parts.prod-code
     2683             .
     2684           assign
     2685             v-base-rate         = buf_parts.price-rubl / buf_parts.price-base
     2686             v-base-scale        = 1
     2687             v-exch-rate         = buf_parts.price-rubl / (buf_parts.price-cli * buf_parts.cli-base-rate)
     2688             v-exch-scale        = 1
     2689             v-extended-doc-type = 'ie':U
     2690             v-unit-cli          = buf_goods.unit-cli
     2691           .
     2692         end.
     2693          if v-base-rate = ? then v-base-rate = 1.
     2694          if v-exch-rate = ? then v-exch-rate = 1.
     2695   assign
     2696     price-rubl-with-tax-loc = buf_parts.price-rubl
     2697     price-base-with-tax-loc = buf_parts.price-base
     2698   .
     2699   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2700   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2701     (output varinvprb
     2702     )  .
     2703     if buf_parts.out-code = 'free-zone':U     or
     2704        buf_parts.out-code = 'out-zone':U   or
     2705        buf_parts.doc-type = 'акт':U then do:
     2706       assign
     2707         in-vatp-have-vat-slt = yes.
     2708     end.
     2709     else do:
     2710       find first in-vatp_doc-attr no-lock
     2711         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     2712           and in-vatp_doc-attr.attr-code = 'envd':U
     2713         no-error .
     2714       if not available in-vatp_doc-attr then do:
     2715         assign
     2716           in-vatp-have-vat-slt = yes.
     2717       end.
     2718       else do:
     2719            in-vatp-have-vat-slt = no.
     2720       end.
     2721     end.
     2722     assign
     2723      price-cli-with-tax-loc = buf_parts.price-cli
     2724      cli-base-rate          = buf_parts.cli-base-rate.
     2725     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     2726              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     2727     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     2728             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     2729             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     2730             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     2731             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     2732             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     2733             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2734       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2735     assign
     2736       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     2737     assign
     2738       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     2739       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     2740       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     2741       transport-cli-loc  = 0
     2742       other-cli-loc      = 0
     2743     .
     2744   ASSIGN
     2745             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2746       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2747   .
     2748         assign
     2749           buf_parts-supp.PS                = buf_parts.PS
     2750           buf_parts-supp.SLT-type          = buf_parts.SLT-type
     2751           buf_parts-supp.VAT-type          = buf_parts.VAT-type
     2752           buf_parts-supp.base-rate         = v-base-rate
     2753           buf_parts-supp.base-scale        = v-base-scale
     2754           buf_parts-supp.cli-qnty          = buf_parts.cli-qnty
     2755           buf_parts-supp.cst-code          = buf_parts.cst-code
     2756           buf_parts-supp.doc-qnty          = buf_parts.qnty
     2757           buf_parts-supp.exch-code         = buf_parts.exch-code
     2758           buf_parts-supp.exch-rate         = v-exch-rate
     2759           buf_parts-supp.exch-scale        = v-exch-scale
     2760           buf_parts-supp.extended-doc-type = v-extended-doc-type
     2761           buf_parts-supp.fact-date         = buf_parts.fact-date
     2762           buf_parts-supp.fact-qnty         = buf_parts.fact-qnty
     2763           buf_parts-supp.last-date         = buf_parts.last-date
     2764           buf_parts-supp.pay-code          = buf_parts.pay-code
     2765           buf_parts-supp.price-cli         = buf_parts.price-cli
     2766           buf_parts-supp.purch-code        = buf_parts.purch-code
     2767           buf_parts-supp.supp-code         = buf_parts.supp-code
     2768           buf_parts-supp.supp-type         = buf_parts.supp-type
     2769           buf_parts-supp.unit-cli          = v-unit-cli
     2770         .
     2771         assign
     2772           buf_parts-supp.vat-pc         = vat-pc-loc
     2773           buf_parts-supp.slt-pc         = slt-pc-loc
     2774           buf_parts-supp.price-base     = price-base-with-tax-loc
     2775           buf_parts-supp.price-rubl     = price-rubl-with-tax-loc
     2776           buf_parts-supp.vat-base       = vat-base-loc
     2777           buf_parts-supp.vat-rubl       = vat-rubl-loc
     2778           buf_parts-supp.slt-base       = slt-base-loc
     2779           buf_parts-supp.slt-rubl       = slt-rubl-loc
     2780           buf_parts-supp.road-tax-base  = road-tax-base-loc
     2781           buf_parts-supp.road-tax-rubl  = road-tax-rubl-loc
     2782           buf_parts-supp.transport-base = transport-base-loc
     2783           buf_parts-supp.transport-rubl = transport-rubl-loc
     2784           buf_parts-supp.other-base     = other-base-loc
     2785           buf_parts-supp.other-rubl     = other-rubl-loc
     2786         .
     2787       end.
     2788     end.
     2789   end procedure.
     2790   procedure holdprts-get-part-code :
     2791     define input  parameter p-doc-code       as character no-undo .
     2792     define output parameter p-hold-part-code as integer   no-undo .
     2793     define variable vss-description as character no-undo init "holdprts-get-part-code-01: создать уникальный код партии внутри документа".
     2794     define variable v-attr-value as character no-undo .
     2795     define variable v-attr-type  as character no-undo .
     2796     define buffer buf_trn-doc for ub.trn-doc .
     2797     do
     2798     on error undo, return error return-value
     2799     :
     2800       find first buf_trn-doc exclusive-lock
     2801         where buf_trn-doc.doc-code = p-doc-code
     2802         no-error .
     2803       if not available buf_trn-doc
     2804       then do:
     2805         message
     2806           vss-workfile vss-revision vss-description skip
     2807           vss-include-info18 skip
     2808           "Ошибка задания входных параметров" skip
     2809           "Не найден документ" p-doc-code skip
     2810           view-as alert-box error .
     2811         undo, return error .
     2812       end.
     2813   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
     2814                           input 'hold-part-code':U ,
     2815                          output v-attr-value ,
     2816                          output v-attr-type )  .
     2817       assign
     2818         p-hold-part-code = integer(v-attr-value) + 1
     2819       .
     2820   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input p-doc-code ,
     2821                          input 'hold-part-code':U ,
     2822                          input string(p-hold-part-code) )  .
     2823     end.
     2824   end procedure.
     2825   procedure holdprts-validate-document :
     2826     define input  parameter p-doc-code as character no-undo .
     2827     define variable vss-description as character no-undo init "holdprts-validate-document-01: проверить правильность документа".
     2828     define buffer buf_trn-doc    for ub.trn-doc .
     2829     define buffer parent_trn-doc for ub.trn-doc .
     2830     define buffer buf_parts      for ub.parts .
     2831     define buffer buf_parts-supp for ub.parts-supp .
     2832     do
     2833     on error undo, return error return-value
     2834     :
     2835       find first buf_trn-doc exclusive-lock
     2836         where buf_trn-doc.doc-code = p-doc-code
     2837         no-error .
     2838       if not available buf_trn-doc
     2839       then do:
     2840         message
     2841           vss-workfile vss-revision vss-description skip
     2842           vss-include-info18 skip
     2843           "Ошибка задания входных параметров" skip
     2844           "Не найден документ" p-doc-code skip
     2845           view-as alert-box error .
     2846         undo, return error .
     2847       end.
     2848       find first parent_trn-doc exclusive-lock
     2849         where parent_trn-doc.doc-code = buf_trn-doc.hold-doc-code-parent
     2850         no-error .
     2851       if not available parent_trn-doc
     2852       then do:
     2853         message
     2854           vss-workfile vss-revision vss-description skip
     2855           vss-include-info18 skip
     2856           "Не найден родительский документ" skip
     2857           "Документ" buf_trn-doc.doc-code skip
     2858           "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
     2859           view-as alert-box error .
     2860         undo, return error .
     2861       end.
     2862       if buf_trn-doc.ext-doc-type <> 'ie':U
     2863       then do:
     2864         return .
     2865       end.
     2866       for each buf_parts share-lock
     2867         where buf_parts.out-code = buf_trn-doc.doc-code
     2868       on error undo, return error
     2869       :
     2870         find first buf_parts-supp share-lock
     2871           where buf_parts-supp.in-code   = buf_parts.in-code
     2872             and buf_parts-supp.artic     = buf_parts.artic
     2873             and buf_parts-supp.prod-type = buf_parts.prod-type
     2874             and buf_parts-supp.prod-code = buf_parts.prod-code
     2875             and buf_parts-supp.part-code = buf_parts.part-code
     2876           no-error .
     2877         if not available buf_parts-supp
     2878         then do:
     2879           message
     2880             vss-workfile vss-revision vss-description skip
     2881             vss-include-info18 skip
     2882             "Не найдена информация о поставщике" skip
     2883             "Документ" buf_trn-doc.doc-code skip
     2884             "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
     2885             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     2886             "Номер партии" buf_parts.part-code skip
     2887             view-as alert-box error .
     2888           undo, return error .
     2889         end.
     2890       end.
     2891       for each buf_parts-supp share-lock
     2892         where buf_parts-supp.in-code = buf_trn-doc.doc-code
     2893       on error undo, return error
     2894       :
     2895         find first buf_parts share-lock
     2896           where buf_parts.out-code  = buf_parts-supp.in-code
     2897             and buf_parts.obj-type  = buf_trn-doc.obj-type
     2898             and buf_parts.obj-code  = buf_trn-doc.obj-code
     2899             and buf_parts.artic     = buf_parts-supp.artic
     2900             and buf_parts.prod-type = buf_parts-supp.prod-type
     2901             and buf_parts.prod-code = buf_parts-supp.prod-code
     2902             and buf_parts.part-code = buf_parts-supp.part-code
     2903           no-error .
     2904         if not available buf_parts
     2905         then do:
     2906           message
     2907             vss-workfile vss-revision vss-description skip
     2908             vss-include-info18 skip
     2909             "Задана информация о поставщике для неизвестной партии" skip
     2910             "Документ" buf_trn-doc.doc-code skip
     2911             "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
     2912             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     2913             "Номер партии" buf_parts.part-code skip
     2914             view-as alert-box error .
     2915           undo, return error .
     2916         end.
     2917       end.
     2918       for each buf_parts share-lock
     2919         where buf_parts.out-code = buf_trn-doc.hold-doc-code-parent
     2920       on error undo, return error
     2921       :
     2922         if  buf_trn-doc.doc-type = 'при':U
     2923         and buf_parts.qnty = buf_parts.fact-qnty
     2924         then do:
     2925           next.
     2926         end.
     2927         find first buf_parts-supp share-lock
     2928           where buf_parts-supp.orig-in-code   = buf_parts.in-code
     2929             and buf_parts-supp.artic          = buf_parts.artic
     2930             and buf_parts-supp.prod-type      = buf_parts.prod-type
     2931             and buf_parts-supp.prod-code      = buf_parts.prod-code
     2932             and buf_parts-supp.orig-part-code = buf_parts.part-code
     2933           no-error .
     2934         if not available buf_parts-supp
     2935         then do:
     2936           message
     2937             vss-workfile vss-revision vss-description skip
     2938             vss-include-info18 skip
     2939             "Не найдена информация о поставщике для исходной накладной" skip
     2940             "Документ" buf_trn-doc.doc-code skip
     2941             "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
     2942             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     2943             "Номер партии" buf_parts.part-code skip
     2944             view-as alert-box error .
     2945           undo, return error .
     2946         end.
     2947       end.
     2948     end.
     2949   end procedure.
     2950   procedure holdprts-doc-type :
     2951     define input  parameter p-cat-code as integer   no-undo .
     2952     define input  parameter p-doc-code as character no-undo .
     2953     define output parameter p-is-sale  as logical   no-undo .
     2954     define output parameter p-is-purch as logical   no-undo .
     2955     define variable vss-description as character no-undo init "holdprts-doc-type-01: определение типа документа для межфирменного архива".
     2956     define buffer buf_trn-doc for ub.trn-doc .
     2957     do
     2958     on error undo, return error return-value
     2959     :
     2960       find first buf_trn-doc no-lock
     2961         where buf_trn-doc.doc-code = p-doc-code
     2962         no-error .
     2963       if not available buf_trn-doc
     2964       then do:
     2965         message
     2966           vss-workfile vss-revision vss-description skip
     2967           vss-include-info18 skip
     2968           "Ошибка задания входных параметров" skip
     2969           "Не найден документ" skip
     2970           "Документ" p-doc-code skip
     2971           "Тип архива" p-cat-code skip
     2972           view-as alert-box error .
     2973         undo, return error .
     2974       end.
     2975       case p-cat-code :
     2976         when 1
     2977         then do:
     2978           define variable v-is-hold as logical   no-undo .
     2979   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2980   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     2981     (input  buf_trn-doc.doc-code
     2982     ,output v-is-hold
     2983     )  .
     2984           if v-is-hold = true
     2985           then do:
     2986             assign
     2987               p-is-sale  = false
     2988               p-is-purch = false
     2989             .
     2990           end.
     2991           else do:
     2992             case buf_trn-doc.ext-doc-type :
     2993               when 'ie':U or
     2994               when 'ep':U
     2995               then do:
     2996                 assign
     2997                   p-is-sale  = false
     2998                   p-is-purch = true
     2999                 .
     3000               end.
     3001               when 'ee':U or
     3002               when 'es':U or
     3003               when 're':U or
     3004               when 'rs':U
     3005               then do:
     3006                 assign
     3007                   p-is-sale  = true
     3008                   p-is-purch = false
     3009                 .
     3010               end.
     3011               when 'we':U or
     3012               when 'vt':U or
     3013               when 'vp':U or
     3014               when 'ap':U or
     3015               when 'mp':U or
     3016               when 'pc':U or
     3017               when 'iv':U or
     3018               when 'ev':U or
     3019               when 'io':U or
     3020               when 'eo':U or
     3021               when 'rv':U or
     3022               when 'em':U or
     3023               when 'wm':U or
     3024               when 'im':U
     3025               then do:
     3026                 assign
     3027                   p-is-sale  = false
     3028                   p-is-purch = false
     3029                 .
     3030               end.
     3031               otherwise do:
     3032                 message
     3033                   vss-workfile vss-revision vss-description skip
     3034                   vss-include-info18 skip
     3035                   "Неизвестный тип документа" skip
     3036                   "Документ" buf_trn-doc.doc-code skip
     3037                   "Тип документа" buf_trn-doc.ext-doc-type skip
     3038                   "Тип архива" p-cat-code skip
     3039                   view-as alert-box error .
     3040                 undo, return error .
     3041               end.
     3042             end.
     3043           end.
     3044         end.
     3045         when 2
     3046         then do:
     3047           case buf_trn-doc.ext-doc-type :
     3048             when 'vt':U or
     3049             when 'vp':U
     3050             then do:
     3051               assign
     3052                 p-is-sale  = false
     3053                 p-is-purch = true
     3054               .
     3055             end.
     3056             otherwise do:
     3057               assign
     3058                 p-is-sale  = false
     3059                 p-is-purch = false
     3060               .
     3061             end.
     3062           end.
     3063         end.
     3064         when 3
     3065         then do:
     3066           case buf_trn-doc.ext-doc-type :
     3067             when 'we':U
     3068             then do:
     3069               assign
     3070                 p-is-sale  = false
     3071                 p-is-purch = true
     3072               .
     3073             end.
     3074             otherwise do:
     3075               assign
     3076                 p-is-sale  = false
     3077                 p-is-purch = false
     3078               .
     3079             end.
     3080           end.
     3081         end.
     3082         otherwise do:
     3083           message
     3084             vss-workfile vss-revision vss-description skip
     3085             "Неизвестный тип архивов" skip
     3086             "Документ" buf_trn-doc.doc-code skip
     3087             "Тип документа" buf_trn-doc.ext-doc-type skip
     3088             "Тип архива" p-cat-code skip
     3089             view-as alert-box error .
     3090           undo, return error return-value .
     3091         end.
     3092       end.
     3093     end.
     3094   end procedure.
     3095   procedure holdprts-purch-values :
     3096     define input  parameter p-doc-code             like ub.doc-line.doc-code  no-undo .
     3097     define input  parameter p-artic                like ub.doc-line.artic     no-undo .
     3098     define input  parameter p-prod-type            like ub.doc-line.prod-type no-undo .
     3099     define input  parameter p-prod-code            like ub.doc-line.prod-code no-undo .
     3100     define output parameter p-fact-qnty            as decimal   no-undo .
     3101     define output parameter p-purch-sum-base       as decimal   no-undo .
     3102     define output parameter p-purch-sum-rubl       as decimal   no-undo .
     3103     define output parameter p-purch-VAT-base       as decimal   no-undo .
     3104     define output parameter p-purch-VAT-rubl       as decimal   no-undo .
     3105     define output parameter p-purch-SLT-base       as decimal   no-undo .
     3106     define output parameter p-purch-SLT-rubl       as decimal   no-undo .
     3107     define output parameter p-purch-road-tax-base  as decimal   no-undo .
     3108     define output parameter p-purch-road-tax-rubl  as decimal   no-undo .
     3109     define output parameter p-purch-excise-base    as decimal   no-undo .
     3110     define output parameter p-purch-excise-rubl    as decimal   no-undo .
     3111     define output parameter p-purch-transport-base as decimal   no-undo .
     3112     define output parameter p-purch-transport-rubl as decimal   no-undo .
     3113     define output parameter p-purch-other-base     as decimal   no-undo .
     3114     define output parameter p-purch-other-rubl     as decimal   no-undo .
     3115     define output parameter p-purch-discnt-base    as decimal   no-undo .
     3116     define output parameter p-purch-discnt-rubl    as decimal   no-undo .
     3117     define variable vss-description as character no-undo init "holdprts-purch-values-01: параметры закупки товара".
     3118     define variable v-price-base     as decimal   no-undo .
     3119     define variable v-price-rubl     as decimal   no-undo .
     3120     define variable v-VAT-base       as decimal   no-undo .
     3121     define variable v-VAT-rubl       as decimal   no-undo .
     3122     define variable v-SLT-base       as decimal   no-undo .
     3123     define variable v-SLT-rubl       as decimal   no-undo .
     3124     define variable v-road-tax-base  as decimal   no-undo .
     3125     define variable v-road-tax-rubl  as decimal   no-undo .
     3126     define variable v-transport-base as decimal   no-undo .
     3127     define variable v-transport-rubl as decimal   no-undo .
     3128     define variable v-other-base     as decimal   no-undo .
     3129     define variable v-other-rubl     as decimal   no-undo .
     3130     define buffer buf_trn-doc        for ub.trn-doc .
     3131     define buffer buf_parts          for ub.parts .
     3132     define buffer buf_parts-supp     for ub.parts-supp .
     3133     define buffer buf_doc-line       for ub.doc-line .
     3134     define buffer buf_income_trn-doc for ub.trn-doc .
     3135     do
     3136     on error undo, return error return-value
     3137     :
     3138       find first buf_trn-doc no-lock
     3139         where buf_trn-doc.doc-code = p-doc-code
     3140         no-error .
     3141       if not available buf_trn-doc
     3142       then do:
     3143         message
     3144           vss-workfile vss-revision vss-description skip
     3145           vss-include-info18 skip
     3146           "Ошибка задания входных параметров" skip
     3147           "Не найден документ" skip
     3148           "Документ" p-doc-code skip
     3149           view-as alert-box error .
     3150         undo, return error .
     3151       end.
     3152       find first buf_doc-line no-lock
     3153         where buf_doc-line.doc-code  = p-doc-code
     3154           and buf_doc-line.artic     = p-artic
     3155           and buf_doc-line.prod-type = p-prod-type
     3156           and buf_doc-line.prod-code = p-prod-code
     3157         no-error .
     3158       if not available buf_doc-line
     3159       then do:
     3160         message
     3161           vss-workfile vss-revision vss-description skip
     3162           vss-include-info18 skip
     3163           "Ошибка задания входных параметров" skip
     3164           "Не найдена строка документа" skip
     3165           "Документ" p-doc-code skip
     3166           "Артикул" p-artic p-prod-type p-prod-code skip
     3167           view-as alert-box error .
     3168         undo, return error .
     3169       end.
     3170       assign
     3171         p-fact-qnty            = 0
     3172         p-purch-sum-base       = 0
     3173         p-purch-sum-rubl       = 0
     3174         p-purch-VAT-base       = 0
     3175         p-purch-VAT-rubl       = 0
     3176         p-purch-SLT-base       = 0
     3177         p-purch-SLT-rubl       = 0
     3178         p-purch-road-tax-base  = 0
     3179         p-purch-road-tax-rubl  = 0
     3180         p-purch-excise-base    = 0
     3181         p-purch-excise-rubl    = 0
     3182         p-purch-transport-base = 0
     3183         p-purch-transport-rubl = 0
     3184         p-purch-other-base     = 0
     3185         p-purch-other-rubl     = 0
     3186         p-purch-discnt-base    = 0
     3187         p-purch-discnt-rubl    = 0
     3188       .
     3189       for each buf_parts no-lock
     3190         where buf_parts.out-code  = buf_doc-line.doc-code
     3191           and buf_parts.obj-type  = buf_doc-line.obj-type
     3192           and buf_parts.obj-code  = buf_doc-line.obj-code
     3193           and buf_parts.artic     = buf_doc-line.artic
     3194           and buf_parts.prod-type = buf_doc-line.prod-type
     3195           and buf_parts.prod-code = buf_doc-line.prod-code
     3196       on error undo, return error
     3197       :
     3198         define variable v-parts-qnty as decimal   no-undo .
     3199         assign
     3200           v-parts-qnty = buf_parts.fact-qnty
     3201                        * ( if lookup(buf_trn-doc.doc-type, 'рас,спи':U ) > 0
     3202                            then -1
     3203                            else 1
     3204                          )
     3205         .
     3206         find first buf_parts-supp no-lock
     3207           where buf_parts-supp.in-code   = buf_parts.in-code
     3208             and buf_parts-supp.artic     = buf_parts.artic
     3209             and buf_parts-supp.prod-type = buf_parts.prod-type
     3210             and buf_parts-supp.prod-code = buf_parts.prod-code
     3211             and buf_parts-supp.part-code = buf_parts.part-code
     3212           no-error .
     3213         if available buf_parts-supp
     3214         then do:
     3215           assign
     3216             v-price-base     = buf_parts-supp.price-base
     3217             v-price-rubl     = buf_parts-supp.price-rubl
     3218             v-VAT-base       = buf_parts-supp.VAT-base
     3219             v-VAT-rubl       = buf_parts-supp.VAT-rubl
     3220             v-SLT-base       = buf_parts-supp.SLT-base
     3221             v-SLT-rubl       = buf_parts-supp.SLT-rubl
     3222             v-road-tax-base  = buf_parts-supp.road-tax-base
     3223             v-road-tax-rubl  = buf_parts-supp.road-tax-rubl
     3224             v-transport-base = buf_parts-supp.transport-base
     3225             v-transport-rubl = buf_parts-supp.transport-rubl
     3226             v-other-base     = buf_parts-supp.other-base
     3227             v-other-rubl     = buf_parts-supp.other-rubl
     3228           .
     3229         end.
     3230         else do:
     3231       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     3232       define buffer   in-vatp-parts    for ub.parts   .
     3233       define buffer   in-vatp-doc      for ub.trn-doc .
     3234       define buffer   in-vatp-goods    for ub.goods   .
     3235       define buffer   in-vatp-sysconf  for ub.sysconf .
     3236       define buffer   in-vatp_doc-attr for ub.doc-attr.
     3237       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     3238       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     3239       define variable varinvprb                  as   character              no-undo.
     3240       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     3241       define variable cli-base-rate              as   decimal                no-undo.
     3242       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     3243       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     3244       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     3245       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     3246       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     3247       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     3248       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     3249       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     3250       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     3251       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     3252       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     3253       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     3254       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     3255       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     3256       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     3257       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     3258       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     3259       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     3260       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     3261       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     3262       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     3263       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     3264       define variable varinvatp-envd             as   character              no-undo.
     3265       define variable varinvatp-type             as   character              no-undo.
     3266   assign
     3267     price-rubl-with-tax-loc = buf_parts.price-rubl
     3268     price-base-with-tax-loc = buf_parts.price-base
     3269   .
     3270   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3271   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3272     (output varinvprb
     3273     )  .
     3274     if buf_parts.out-code = 'free-zone':U     or
     3275        buf_parts.out-code = 'out-zone':U   or
     3276        buf_parts.doc-type = 'акт':U then do:
     3277       assign
     3278         in-vatp-have-vat-slt = yes.
     3279     end.
     3280     else do:
     3281       find first in-vatp_doc-attr no-lock
     3282         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     3283           and in-vatp_doc-attr.attr-code = 'envd':U
     3284         no-error .
     3285       if not available in-vatp_doc-attr then do:
     3286         assign
     3287           in-vatp-have-vat-slt = yes.
     3288       end.
     3289       else do:
     3290            in-vatp-have-vat-slt = no.
     3291       end.
     3292     end.
     3293     assign
     3294      price-cli-with-tax-loc = buf_parts.price-cli
     3295      cli-base-rate          = buf_parts.cli-base-rate.
     3296     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     3297              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     3298     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     3299             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     3300             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     3301             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     3302             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     3303             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     3304             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3305       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3306     assign
     3307       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     3308     assign
     3309       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     3310       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     3311       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     3312       transport-cli-loc  = 0
     3313       other-cli-loc      = 0
     3314     .
     3315   ASSIGN
     3316             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     3317       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     3318   .
     3319           assign
     3320             v-price-base     = price-base-with-tax-loc
     3321             v-price-rubl     = price-rubl-with-tax-loc
     3322             v-VAT-base       = vat-base-loc
     3323             v-VAT-rubl       = vat-rubl-loc
     3324             v-SLT-base       = slt-base-loc
     3325             v-SLT-rubl       = slt-rubl-loc
     3326             v-road-tax-base  = road-tax-base-loc
     3327             v-road-tax-rubl  = road-tax-rubl-loc
     3328             v-transport-base = transport-base-loc
     3329             v-transport-rubl = transport-rubl-loc
     3330             v-other-base     = other-base-loc
     3331             v-other-rubl     = other-rubl-loc
     3332           .
     3333         end.
     3334         assign
     3335           p-fact-qnty            = p-fact-qnty            + v-parts-qnty
     3336           p-purch-sum-base       = p-purch-sum-base       + v-price-base     * v-parts-qnty
     3337           p-purch-sum-rubl       = p-purch-sum-rubl       + v-price-rubl     * v-parts-qnty
     3338           p-purch-VAT-base       = p-purch-VAT-base       + v-VAT-base       * v-parts-qnty
     3339           p-purch-VAT-rubl       = p-purch-VAT-rubl       + v-VAT-rubl       * v-parts-qnty
     3340           p-purch-SLT-base       = p-purch-SLT-base       + v-SLT-base       * v-parts-qnty
     3341           p-purch-SLT-rubl       = p-purch-SLT-rubl       + v-SLT-rubl       * v-parts-qnty
     3342           p-purch-road-tax-base  = p-purch-road-tax-base  + v-road-tax-base  * v-parts-qnty
     3343           p-purch-road-tax-rubl  = p-purch-road-tax-rubl  + v-road-tax-rubl  * v-parts-qnty
     3344           p-purch-excise-base    = p-purch-excise-base    + 0
     3345           p-purch-excise-rubl    = p-purch-excise-rubl    + 0
     3346           p-purch-transport-base = p-purch-transport-base + v-transport-base * v-parts-qnty
     3347           p-purch-transport-rubl = p-purch-transport-rubl + v-transport-rubl * v-parts-qnty
     3348           p-purch-other-base     = p-purch-other-base     + v-other-base     * v-parts-qnty
     3349           p-purch-other-rubl     = p-purch-other-rubl     + v-other-rubl     * v-parts-qnty
     3350           p-purch-discnt-base    = p-purch-discnt-base    + 0
     3351           p-purch-discnt-rubl    = p-purch-discnt-rubl    + 0
     3352         .
     3353       end.
     3354     end.
     3355   end procedure.
     3356   procedure holdprts-sale-values :
     3357     define input  parameter p-doc-code            like ub.doc-line.doc-code  no-undo .
