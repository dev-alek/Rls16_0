     5095   end.
     5096     define variable varlog as logical no-undo.
     5097   define variable vss-include-info37 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5098   do:
     5099     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5100       (input  v-cntxt-db-num
     5101       ,input  v-cntxt-userid
     5102       ,input  0
     5103       ,input  'actn_archive_cost':U
     5104       ,input  'object':U
