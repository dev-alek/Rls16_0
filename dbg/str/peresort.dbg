     6373       apply "ctrl-b":U to varshift-date in frame Dialog-Frame .
     6374     END.
     6375     ON CHOOSE OF MENU-ITEM m-ed-date52-2 in menu m-ed-date52 DO:
     6376       apply "ctrl-d":U to varshift-date in frame Dialog-Frame .
     6377     END.
     6378     ON CHOOSE OF MENU-ITEM m-ed-date52-3 in menu m-ed-date52 DO:
     6379       apply "ctrl-e":U to varshift-date in frame Dialog-Frame .
     6380     END.
     6381     ON CHOOSE OF MENU-ITEM m-ed-date52-4 in menu m-ed-date52 DO:
     6382       apply "ctrl-f":U to varshift-date in frame Dialog-Frame .
     6383     END.
     6384   ON CHOOSE OF b-next IN FRAME Dialog-Frame
     6385   DO:
     6386     RUN step-next in this-procedure .
     6387   END.
     6388   procedure step-next:
     6389   define variable cur-form as char no-undo.
     6390   define variable new-form as char no-undo.
     6391   define buffer new_trn-doc for ub.trn-doc  .
     6392   case bf_trn-doc.doc-type:
     6393     when 'при':U then
     6394       cur-form = if bf_trn-doc.internal then 'рас':U else 'при':U.
     6395     when 'рас':U or when 'возврат':U or when 'спи':U then
     6396       cur-form = 'рас':U.
     6397     when 'инв':U then cur-form = 'инв':U.
     6398   end case.
     6399   if bf-handle = ? then return .
     6400   if valid-handle (br-handle) then do:
     6401     varlog = br-handle:select-next-row().
     6402     find first new_trn-doc no-lock where  recid( new_trn-doc ) = bf-handle:recid no-error .
     6403     if not varlog then message "Это последний документ списка.".
     6404   end.
     6405   case new_trn-doc.doc-type:
     6406     when 'при':U then
     6407       new-form = if new_trn-doc.internal then 'рас':U else 'при':U.
     6408     when 'рас':U or when 'возврат':U or when 'спи':U then
     6409       new-form = 'рас':U.
     6410     when 'инв':U then new-form = 'инв':U.
     6411   end case.
     6412   assign
     6413       pardoc-rec   = bf-handle:recid
     6414       parnext-prev = ( cur-form = new-form ) .
     6415   end procedure.
     6416   ON CHOOSE OF b-prev IN FRAME Dialog-Frame
     6417   DO:
     6418     run step-prev in this-procedure .
     6419   END.
     6420   procedure step-prev:
     6421   define variable cur-form as char no-undo.
     6422   define variable new-form as char no-undo.
     6423   define buffer new_trn-doc for ub.trn-doc  .
     6424   case bf_trn-doc.doc-type:
     6425     when 'при':U then if bf_trn-doc.internal then cur-form = 'рас':U. else cur-form = 'при':U.
     6426     when 'рас':U or when 'возврат':U or when 'спи':U then cur-form = 'рас':U.
     6427     when 'инв':U then cur-form = 'инв':U.
     6428   end case.
     6429   if bf-handle = ? then return .
     6430   if valid-handle (br-handle) then do:
     6431     varlog = br-handle:select-prev-row().
     6432     find first new_trn-doc no-lock where  recid( new_trn-doc ) = bf-handle:recid no-error .
     6433     if not varlog then message "Это первый документ списка.".
     6434   end.
     6435   case new_trn-doc.doc-type :
     6436     when 'при':U then if new_trn-doc.internal then new-form = 'рас':U. else new-form = 'при':U.
     6437     when 'рас':U or when 'возврат':U or when 'спи':U then  new-form = 'рас':U.
     6438     when 'инв':U then new-form = 'инв':U.
     6439   end case.
     6440   assign
     6441     pardoc-rec   = bf-handle:recid
     6442     parnext-prev = (cur-form = new-form)
     6443   .
     6444   end procedure.
     6445   assign
     6446     b-goods-:allow-column-searching in frame  Dialog-Frame  = yes
     6447     b-goods:allow-column-searching  in frame  Dialog-Frame  = yes
