     7729         bf-expp_doc-line-sum.obj-code     = bf_trn-doc.obj-code
     7730         bf-expp_doc-line-sum.gds-code     = bf-rc_goods.gds-code
     7731         bf-expp_doc-line-sum.sum-type     = 'exp':U
     7732       .
     7733     end.
     7734     find first bf-incp_doc-line-sum where bf-incp_doc-line-sum.doc-code = bf-rc_doc-line.doc-code
     7735                                       and bf-incp_doc-line-sum.gds-code = bf-rc_goods.gds-code
     7736                                       and bf-incp_doc-line-sum.sum-type = 'inp':U exclusive-lock no-error.
