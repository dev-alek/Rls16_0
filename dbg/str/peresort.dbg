     5458       run local-psn-chk in this-procedure ("agnt", "ret-mouse").
     5459       apply "entry" to varboss in frame Dialog-Frame.
     5460       return no-apply.
     5461   END.
     5462   ON return OF varagnt IN FRAME Dialog-Frame
     5463   DO:
     5464     run local-psn-chk in this-procedure ("agnt", "ret-mouse").
     5465     apply "entry" to varboss in frame Dialog-Frame.
     5466     return no-apply.
     5467   END.
     5468   ON LEAVE OF varboss IN FRAME Dialog-Frame
     5469   DO:
     5470     if input frame Dialog-Frame varboss <> varboss then do:
     5471       run local-psn-chk in this-procedure ("boss", "leave").
     5472       apply "entry" to b-exit in frame Dialog-Frame.
     5473       return no-apply.
     5474     end.
     5475   END.
     5476   ON MOUSE-SELECT-DBLCLICK OF varboss IN FRAME Dialog-Frame
     5477   DO:
     5478     RUN local-psn-chk in this-procedure ("boss", "ret-mouse").
     5479     apply "entry" to b-exit in frame Dialog-Frame.
     5480     return no-apply.
     5481   END.
     5482   ON RETURN OF varboss IN FRAME Dialog-Frame
