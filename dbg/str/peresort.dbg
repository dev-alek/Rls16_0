     7640     find FIRST cli-buf where cli-buf.obj-code = input frame Dialog-Frame varagnt                                                       and cli-buf.obj-type = 'чел':U no-lock no-error.                                  assign ref-rec = ( if available cli-buf then recid( cli-buf ) else ? ).                                                 release cli-buf.
     7641     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:     if input frame Dialog-Frame varagnt <> ""                                      and input frame Dialog-Frame varagnt <> ? THEN DO:                           message "Из справочника клиентов Вы должны выбрать человека.".              END.                                                                                run ref/cli-all.w (  input parparentproc                                                                  ,  input "b-sel"                                                                        ,  input 'чел':U                                                                         ,  input ?                                                                              ,  input ?                                                                              ,  input ref-rec                                                                        ,  input ?                                                                              ,  input ?                                                                              , output ref-list ) .                                                 assign ref-rec = integer (ref-list).                                                find cli-buf where recid (cli-buf) = ref-rec no-lock no-error.                      if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:            find cli-buf where cli-buf.obj-code = input frame Dialog-Frame varagnt                                  and cli-buf.obj-type = 'чел':U no-lock no-error.                     end.                                                                                       end.
     7642     if available cli-buf and can-do('чел':U, cli-buf.obj-type) then do:                                                                                                 disp cli-buf.obj-code @ varagnt cli-buf.obj-name @ varagnt-name with frame Dialog-Frame.                                      assign frame Dialog-Frame varagnt.                                         DO TRANSACTION ON ERROR UNDO, RETURN ERROR RETURN-VALUE :                                        ASSIGN                                         bf_trn-doc.agnt = varagnt.                                      END.                                   end.                                                                                                                       else do:                                                                                                                     disp ? @ varagnt ? @ varagnt-name with frame Dialog-Frame.                                            END.
     7643   end.
     7644   if parman = "agnt" and paraction = "leave" then do:
     7645     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame varagnt                                                 and cli-buf.obj-type = 'чел':U no-lock no-error.
     7646     if available cli-buf and can-do('чел':U, cli-buf.obj-type) then do:                                                                                                 disp cli-buf.obj-code @ varagnt cli-buf.obj-name @ varagnt-name with frame Dialog-Frame.                                      assign frame Dialog-Frame varagnt.                                         DO TRANSACTION ON ERROR UNDO, RETURN ERROR RETURN-VALUE :                                        ASSIGN                                         bf_trn-doc.agnt = varagnt.                                      END.                                   end.                                                                                                                       else do:                                                                                                                     disp ? @ varagnt ? @ varagnt-name with frame Dialog-Frame.                                            END.
     7647   end.
     7648   if parman = "boss" and paraction = "ret-mouse" then do:
     7649     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame varboss                                                 and cli-buf.obj-type = 'чел':U no-lock no-error.
     7650     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:     if input frame Dialog-Frame varboss <> ""                                      and input frame Dialog-Frame varboss <> ? THEN DO:                           message "Из справочника клиентов Вы должны выбрать человека.".              END.                                                                                run ref/cli-all.w (  input parparentproc                                                                  ,  input "b-sel"                                                                        ,  input 'чел':U                                                                         ,  input ?                                                                              ,  input ?                                                                              ,  input ref-rec                                                                        ,  input ?                                                                              ,  input ?                                                                              , output ref-list ) .                                                 assign ref-rec = integer (ref-list).                                                find cli-buf where recid (cli-buf) = ref-rec no-lock no-error.                      if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:            find cli-buf where cli-buf.obj-code = input frame Dialog-Frame varboss                                  and cli-buf.obj-type = 'чел':U no-lock no-error.                     end.                                                                                       end.
     7651     if available cli-buf and can-do('чел':U, cli-buf.obj-type) then do:                                                                                                 disp cli-buf.obj-code @ varboss cli-buf.obj-name @ varboss-name with frame Dialog-Frame.                                      assign frame Dialog-Frame varboss.                                         DO TRANSACTION ON ERROR UNDO, RETURN ERROR RETURN-VALUE :                                        ASSIGN                                         bf_trn-doc.boss = varboss.                                      END.                                   end.                                                                                                                       else do:                                                                                                                     disp ? @ varboss ? @ varboss-name with frame Dialog-Frame.                                            END.
     7652   end.
     7653   if parman = "boss" and paraction = "button" then do:
     7654     find FIRST cli-buf where cli-buf.obj-code = input frame Dialog-Frame varboss                                                       and cli-buf.obj-type = 'чел':U no-lock no-error.                                  assign ref-rec = ( if available cli-buf then recid( cli-buf ) else ? ).                                                 release cli-buf.
     7655     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:     if input frame Dialog-Frame varboss <> ""                                      and input frame Dialog-Frame varboss <> ? THEN DO:                           message "Из справочника клиентов Вы должны выбрать человека.".              END.                                                                                run ref/cli-all.w (  input parparentproc                                                                  ,  input "b-sel"                                                                        ,  input 'чел':U                                                                         ,  input ?                                                                              ,  input ?                                                                              ,  input ref-rec                                                                        ,  input ?                                                                              ,  input ?                                                                              , output ref-list ) .                                                 assign ref-rec = integer (ref-list).                                                find cli-buf where recid (cli-buf) = ref-rec no-lock no-error.                      if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:            find cli-buf where cli-buf.obj-code = input frame Dialog-Frame varboss                                  and cli-buf.obj-type = 'чел':U no-lock no-error.                     end.                                                                                       end.
     7656     if available cli-buf and can-do('чел':U, cli-buf.obj-type) then do:                                                                                                 disp cli-buf.obj-code @ varboss cli-buf.obj-name @ varboss-name with frame Dialog-Frame.                                      assign frame Dialog-Frame varboss.                                         DO TRANSACTION ON ERROR UNDO, RETURN ERROR RETURN-VALUE :                                        ASSIGN                                         bf_trn-doc.boss = varboss.                                      END.                                   end.                                                                                                                       else do:                                                                                                                     disp ? @ varboss ? @ varboss-name with frame Dialog-Frame.                                            END.
     7657   end.
     7658   if parman = "boss" and paraction = "leave" then do:
     7659     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame varboss                                                 and cli-buf.obj-type = 'чел':U no-lock no-error.
     7660     if available cli-buf and can-do('чел':U, cli-buf.obj-type) then do:                                                                                                 disp cli-buf.obj-code @ varboss cli-buf.obj-name @ varboss-name with frame Dialog-Frame.                                      assign frame Dialog-Frame varboss.                                         DO TRANSACTION ON ERROR UNDO, RETURN ERROR RETURN-VALUE :                                        ASSIGN                                         bf_trn-doc.boss = varboss.                                      END.                                   end.                                                                                                                       else do:                                                                                                                     disp ? @ varboss ? @ varboss-name with frame Dialog-Frame.                                            END.
     7661   end.
     7662   if parman = "wrkr" and paraction = "ret-mouse" then do:
     7663     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame varwrkr                                                 and cli-buf.obj-type = 'чел':U no-lock no-error.
     7664     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:     if input frame Dialog-Frame varwrkr <> ""                                      and input frame Dialog-Frame varwrkr <> ? THEN DO:                           message "Из справочника клиентов Вы должны выбрать человека.".              END.                                                                                run ref/cli-all.w (  input parparentproc                                                                  ,  input "b-sel"                                                                        ,  input 'чел':U                                                                         ,  input ?                                                                              ,  input ?                                                                              ,  input ref-rec                                                                        ,  input ?                                                                              ,  input ?                                                                              , output ref-list ) .                                                 assign ref-rec = integer (ref-list).                                                find cli-buf where recid (cli-buf) = ref-rec no-lock no-error.                      if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:            find cli-buf where cli-buf.obj-code = input frame Dialog-Frame varwrkr                                  and cli-buf.obj-type = 'чел':U no-lock no-error.                     end.                                                                                       end.
     7665     if available cli-buf and can-do('чел':U, cli-buf.obj-type) then do:                                                                                                 disp cli-buf.obj-code @ varwrkr cli-buf.obj-name @ varwrkr-name with frame Dialog-Frame.                                      assign frame Dialog-Frame varwrkr.                                         DO TRANSACTION ON ERROR UNDO, RETURN ERROR RETURN-VALUE :                                        ASSIGN                                         bf_trn-doc.wrkr = varwrkr.                                      END.                                   end.                                                                                                                       else do:                                                                                                                     disp ? @ varwrkr ? @ varwrkr-name with frame Dialog-Frame.                                            END.
     7666   end.
     7667   if parman = "wrkr" and paraction = "button" then do:
     7668     find FIRST cli-buf where cli-buf.obj-code = input frame Dialog-Frame varwrkr                                                       and cli-buf.obj-type = 'чел':U no-lock no-error.                                  assign ref-rec = ( if available cli-buf then recid( cli-buf ) else ? ).                                                 release cli-buf.
     7669     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:     if input frame Dialog-Frame varwrkr <> ""                                      and input frame Dialog-Frame varwrkr <> ? THEN DO:                           message "Из справочника клиентов Вы должны выбрать человека.".              END.                                                                                run ref/cli-all.w (  input parparentproc                                                                  ,  input "b-sel"                                                                        ,  input 'чел':U                                                                         ,  input ?                                                                              ,  input ?                                                                              ,  input ref-rec                                                                        ,  input ?                                                                              ,  input ?                                                                              , output ref-list ) .                                                 assign ref-rec = integer (ref-list).                                                find cli-buf where recid (cli-buf) = ref-rec no-lock no-error.                      if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:            find cli-buf where cli-buf.obj-code = input frame Dialog-Frame varwrkr                                  and cli-buf.obj-type = 'чел':U no-lock no-error.                     end.                                                                                       end.
     7670     if available cli-buf and can-do('чел':U, cli-buf.obj-type) then do:                                                                                                 disp cli-buf.obj-code @ varwrkr cli-buf.obj-name @ varwrkr-name with frame Dialog-Frame.                                      assign frame Dialog-Frame varwrkr.                                         DO TRANSACTION ON ERROR UNDO, RETURN ERROR RETURN-VALUE :                                        ASSIGN                                         bf_trn-doc.wrkr = varwrkr.                                      END.                                   end.                                                                                                                       else do:                                                                                                                     disp ? @ varwrkr ? @ varwrkr-name with frame Dialog-Frame.                                            END.
     7671   end.
     7672   if parman = "wrkr" and paraction = "leave" then do:
     7673     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame varwrkr                                                 and cli-buf.obj-type = 'чел':U no-lock no-error.
     7674     if available cli-buf and can-do('чел':U, cli-buf.obj-type) then do:                                                                                                 disp cli-buf.obj-code @ varwrkr cli-buf.obj-name @ varwrkr-name with frame Dialog-Frame.                                      assign frame Dialog-Frame varwrkr.                                         DO TRANSACTION ON ERROR UNDO, RETURN ERROR RETURN-VALUE :                                        ASSIGN                                         bf_trn-doc.wrkr = varwrkr.                                      END.                                   end.                                                                                                                       else do:                                                                                                                     disp ? @ varwrkr ? @ varwrkr-name with frame Dialog-Frame.                                            END.
     7675   end.
     7676   END PROCEDURE.
     7677   PROCEDURE local-recalc :
     7678   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7679   define input parameter parmode     as character          no-undo.
     7680   define input parameter parrec-line as recid              no-undo.
     7681   define input parameter parhave-exp as logical initial no no-undo.
     7682   define variable varvalue                        as   character                             no-undo.
     7683   define variable vartype                         as   character                             no-undo.
     7684   define buffer bf-rc_doc-line       for ub.doc-line.
     7685   define buffer bf-rc_goods          for ub.goods.
     7686   define buffer bf-rc_parts          for ub.parts.
     7687   define buffer bf-rc-exp_parts      for ub.parts.
     7688   define buffer bf-rc-inc_parts      for ub.parts.
     7689   define buffer bf-expp_trn-doc-sum  for ub.trn-doc-sum.
     7690   define buffer bf-incp_trn-doc-sum  for ub.trn-doc-sum.
     7691   define buffer bf-expp_doc-line-sum for ub.doc-line-sum.
     7692   define buffer bf-incp_doc-line-sum for ub.doc-line-sum.
     7693   do on error undo, return error return-value :
     7694   find first bf-rc_doc-line where recid(bf-rc_doc-line) = parrec-line.
     7695   find first bf-rc_goods    where bf-rc_goods.artic     = bf-rc_doc-line.artic     and
     7696                                   bf-rc_goods.prod-type = bf-rc_doc-line.prod-type and
     7697                                   bf-rc_goods.prod-code = bf-rc_doc-line.prod-code no-lock.
     7698   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn2) <> true) then do:   run str/lib-trn2.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn2) <> true) then do:     message       "Error starting lib-trn2.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn2_reclcinv in g#lib-trn2
     7699   (
     7700   input        parmode,
     7701   input        parrec-line,
     7702   input        bf_trn-doc.doc-code,
     7703   input-output vartot-docold,
     7704   input-output vartot-rublold,
