     9111                                                  tt-doc-line-cashe-plus.wf-prod-code = local-doc-line.prod-code      and
     9112                                                  tt-doc-line-cashe-plus.artic        = local-doc-line-plus.artic     AND
     9113                                                  tt-doc-line-cashe-plus.prod-type    = local-doc-line-plus.prod-type AND
     9114                                                  tt-doc-line-cashe-plus.prod-code    = local-doc-line-plus.prod-code .
     9115        END.
     9116        RETURN tt-doc-line-cashe-plus.vat-rubl.
     9117   END FUNCTION.
     9118   FUNCTION get-mark RETURNS CHARACTER
     9119     (buffer local-doc-line for ub.doc-line) :
     9120   find first tt-del-list where tt-del-list.rec-id = recid (local-doc-line) no-error.
     9121   if available tt-del-list then do:
     9122     return "*".
     9123   end.
     9124   else do:
     9125     return "".
     9126   end.
     9127   END FUNCTION.
     9128   FUNCTION get-price RETURNS DECIMAL
     9129   (BUFFER local-goods FOR ub.goods):
     9130   DEFINE BUFFER bf-fnc_gds-dtl      FOR ub.gds-dtl.
     9131   DEFINE BUFFER bf-fnc-spec_gds-dtl FOR ub.gds-dtl.
     9132   DEFINE BUFFER bf-fnc_gds-prt      FOR ub.gds-prt.
     9133   DEFINE VARIABLE varqnty AS DECIMAL NO-UNDO.
     9134   DEFINE VARIABLE varsum  AS DECIMAL NO-UNDO.
     9135   FIND FIRST bf-fnc_gds-dtl WHERE bf-fnc_gds-dtl.doc-code   = bf_trn-doc.doc-code   AND
     9136                                   bf-fnc_gds-dtl.artic      = local-goods.artic     AND
     9137                                   bf-fnc_gds-dtl.prod-type  = local-goods.prod-type AND
     9138                                   bf-fnc_gds-dtl.prod-code  = local-goods.prod-code NO-LOCK.
     9139   find first bf-fnc_gds-prt where bf-fnc_gds-prt.upper-code = local-goods.prt-root no-lock.
     9140   if bf-fnc_gds-prt.node-name = '_Пустая шкала':U then do:
     9141     IF varr-b = "rubl" THEN DO:
     9142       RETURN bf-fnc_gds-dtl.price-rubl.
     9143     END.
     9144     ELSE DO:
     9145       RETURN bf-fnc_gds-dtl.price-base.
     9146     END.
     9147   END.
     9148   ELSE DO:
     9149     FIND FIRST bf-fnc-spec_gds-dtl WHERE bf-fnc-spec_gds-dtl.doc-code    = bf_trn-doc.doc-code   AND
     9150                                          bf-fnc-spec_gds-dtl.artic       = local-goods.artic     AND
     9151                                          bf-fnc-spec_gds-dtl.prod-type   = local-goods.prod-type AND
     9152                                          bf-fnc-spec_gds-dtl.prod-code   = local-goods.prod-code AND
     9153                                          bf-fnc-spec_gds-dtl.price-rubl <> bf-fnc_gds-dtl.price-rubl NO-LOCK NO-ERROR.
     9154     IF NOT AVAILABLE bf-fnc-spec_gds-dtl THEN DO:
     9155       IF varr-b = "rubl" THEN DO:
     9156         RETURN bf-fnc_gds-dtl.price-rubl.
     9157       END.
     9158       ELSE DO:
     9159         RETURN bf-fnc_gds-dtl.price-base.
     9160       END.
     9161     END.
     9162     ELSE DO:
     9163       ASSIGN
     9164         varqnty = 0.00
     9165         varsum  = 0.00.
     9166       FOR EACH bf-fnc_gds-dtl WHERE bf-fnc_gds-dtl.doc-code   = bf_trn-doc.doc-code   AND
     9167                                     bf-fnc_gds-dtl.artic      = local-goods.artic     AND
     9168                                     bf-fnc_gds-dtl.prod-type  = local-goods.prod-type AND
     9169                                     bf-fnc_gds-dtl.prod-code  = local-goods.prod-code NO-LOCK :
     9170         ASSIGN
     9171           varqnty = VARqnty + bf-fnc_gds-dtl.fact-qnty
     9172           varsum  = varsum + (IF varr-b = "rubl" THEN bf-fnc_gds-dtl.price-rubl ELSE bf-fnc_gds-dtl.price-base) * bf-fnc_gds-dtl.fact-qnty.
     9173       END.
     9174       RETURN ABS (varsum / varqnty).
     9175     END.
     9176   END.
     9177   END FUNCTION.
     9178   FUNCTION get-write-off-for-income-qnty RETURNS DECIMAL
     9179       ( BUFFER local-doc-line FOR ub.doc-line, BUFFER local-doc-line-plus FOR ub.doc-line ) :
     9180       FIND FIRST tt-doc-line-cashe-plus WHERE tt-doc-line-cashe-plus.doc-code     = local-doc-line.doc-code       AND
     9181                                               tt-doc-line-cashe-plus.wf-artic     = local-doc-line.artic          AND
     9182                                               tt-doc-line-cashe-plus.wf-prod-type = local-doc-line.prod-type      AND
     9183                                               tt-doc-line-cashe-plus.wf-prod-code = local-doc-line.prod-code      and
     9184                                               tt-doc-line-cashe-plus.artic        = local-doc-line-plus.artic     AND
     9185                                               tt-doc-line-cashe-plus.prod-type    = local-doc-line-plus.prod-type AND
     9186                                               tt-doc-line-cashe-plus.prod-code    = local-doc-line-plus.prod-code NO-ERROR.
     9187       IF NOT AVAILABLE tt-doc-line-cashe-plus THEN DO:
     9188         RUN proc-get-write-off in this-procedure (BUFFER local-doc-line).
     9189         FIND FIRST tt-doc-line-cashe-plus WHERE tt-doc-line-cashe-plus.doc-code     = local-doc-line.doc-code       AND
     9190                                                 tt-doc-line-cashe-plus.wf-artic     = local-doc-line.artic          AND
     9191                                                 tt-doc-line-cashe-plus.wf-prod-type = local-doc-line.prod-type      AND
     9192                                                 tt-doc-line-cashe-plus.wf-prod-code = local-doc-line.prod-code      and
     9193                                                 tt-doc-line-cashe-plus.artic        = local-doc-line-plus.artic     AND
     9194                                                 tt-doc-line-cashe-plus.prod-type    = local-doc-line-plus.prod-type AND
     9195                                                 tt-doc-line-cashe-plus.prod-code    = local-doc-line-plus.prod-code .
     9196       END.
     9197       RETURN tt-doc-line-cashe-plus.write-off-qnty.
     9198   END FUNCTION.
     9199   FUNCTION get-write-off-qnty RETURNS DECIMAL
