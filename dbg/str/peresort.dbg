     1994           return-value skip
     1995           trim(error-status :get-message(1))
     1996           trim(error-status :get-message(2))
     1997           trim(error-status :get-message(3))
     1998           trim(error-status :get-message(4))
     1999           trim(error-status :get-message(5)) skip
     2000           view-as alert-box error.
