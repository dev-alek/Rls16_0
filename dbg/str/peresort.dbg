     4217   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4218   function octal-to-char return character
     4219   ( p-string as character ) :
     4220     def var v-asc     as integer no-undo .
     4221     def var v-new-asc as integer no-undo .
     4222     def var ind       as integer no-undo .
     4223     if length(p-string) <> 3 then do:
     4224       return ? .
     4225     end.
     4226     assign
     4227       v-asc = 0
     4228     .
     4229     do ind = 1 to length(p-string)
     4230     :
     4231       assign
     4232         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
     4233       .
     4234       if v-new-asc < 0 or v-new-asc >= 8 then do:
     4235         return ? .
     4236       end.
     4237       assign
     4238         v-asc = v-asc * 8 + v-new-asc
     4239       .
     4240     end.
     4241     return chr(v-asc) .
     4242   end function .
     4243   function char-to-octal return character
     4244   ( p-chr as character ) :
     4245     def var v-asc    as integer   no-undo .
     4246     def var ind      as integer   no-undo .
     4247     def var v-string as character no-undo .
     4248     if length(p-chr) <> 1 then do:
     4249       return ? .
     4250     end.
     4251     assign
     4252       v-asc    = asc(p-chr)
     4253       v-string = ""
     4254     .
     4255     do ind = 1 to 3
     4256     :
     4257       assign
     4258         v-string = chr( v-asc mod 8 + asc('0')) + v-string
     4259       .
     4260       assign
     4261         v-asc = truncate(v-asc / 8, 0)
     4262       .
     4263     end.
     4264     return v-string .
     4265   end.
     4266   function str-encode return character
     4267   (   p-init-string       as character
     4268     , p-encode-char       as character
     4269     , p-special-char-list as character
     4270   ) :
     4271     def var p-encode-string as character no-undo .
     4272     def var ind                as integer no-undo .
     4273     def var v-num-special-char as integer no-undo .
     4274     def var v-special-char     as character no-undo .
     4275     if p-encode-char = ?
     4276     or p-encode-char = "" then do:
     4277       assign
     4278         p-encode-char = "~~"
     4279       .
     4280     end.
     4281     if p-init-string = ? then do:
     4282       return "?" .
     4283     end.
     4284     if p-init-string = "?" then do:
     4285       return p-encode-char + char-to-octal("?") .
     4286     end.
     4287     assign
     4288       v-num-special-char = length(p-special-char-list)
     4289       p-encode-string    = replace(p-init-string
     4290                                   ,p-encode-char
     4291                                   ,p-encode-char + char-to-octal(p-encode-char)
     4292                                   )
     4293     .
     4294     do ind = 1 to v-num-special-char
     4295     :
     4296       assign
     4297         v-special-char = substring(p-special-char-list, ind, 1)
     4298       .
     4299       if v-special-char <> p-encode-char then do:
     4300         assign
     4301           p-encode-string = replace (p-encode-string
     4302                                     ,v-special-char
     4303                                     ,p-encode-char + char-to-octal(v-special-char)
     4304                                     )
     4305         .
     4306       end.
     4307     end.
     4308     return p-encode-string .
     4309   end.
     4310   function str-decode returns character
     4311     (p-init-string   as character
     4312     ,p-encode-char   as character
     4313     ) :
     4314     def var p-decode-string as character no-undo .
     4315     def var ind                       as integer no-undo .
     4316     def var v-num-entries-init-string as integer no-undo .
     4317     def var v-sub-phrase              as character no-undo .
     4318     def var v-special-char            as character no-undo .
     4319     if p-encode-char = ?
     4320     or p-encode-char = "" then do:
     4321       assign
     4322         p-encode-char = "~~"
     4323       .
     4324     end.
     4325     if p-init-string = "?" then do:
     4326       return ? .
     4327     end.
     4328     assign
     4329       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
     4330     .
     4331     if v-num-entries-init-string > 1 then do:
     4332       assign
     4333         p-decode-string = entry(1, p-init-string, p-encode-char)
     4334       .
     4335       do ind = 2 to v-num-entries-init-string
     4336       :
     4337         assign
     4338           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
     4339         .
     4340         assign
     4341           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
     4342         .
     4343         if v-special-char <> ? then do:
     4344           assign
     4345             p-decode-string = p-decode-string
     4346                             + v-special-char
     4347                             + substring(v-sub-phrase, 4)
     4348           .
     4349         end.
     4350         else do:
     4351           assign
     4352             p-decode-string = p-decode-string
     4353                             + p-encode-char
     4354                             + v-sub-phrase
     4355           .
     4356         end.
     4357       end.
     4358     end.
     4359     else do:
     4360       assign
     4361         p-decode-string = p-init-string
     4362       .
     4363     end.
     4364     return p-decode-string .
     4365   end.
