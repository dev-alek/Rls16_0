     6482   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6483   procedure minbtn-set :
     6484       do
     6485           on error undo, return error return-value
     6486           :
     6487           define variable ii              as integer       no-undo .
     6488           define variable fh              as widget-handle no-undo .
     6489           define variable hh              as widget-handle no-undo .
     6490           define variable v-h             as handle        extent 4 no-undo .
     6491           define variable v-name-button   as character     no-undo .
     6492           define variable v-help-old-x    as decimal       no-undo .
     6493           define variable v-help-old-y    as decimal       no-undo .
     6494           define variable v-help-old-size as decimal       no-undo .
     6495           define variable v-frame-width   as decimal       no-undo .
     6496           define variable jj              as integer       no-undo .
     6497           do
     6498               on error undo, return error
     6499               :
     6500               assign
     6501                   v-frame-width = frame Dialog-Frame:width - 0.3
     6502                   fh            = frame Dialog-Frame:first-child
     6503                   hh            = fh:first-child
     6504                   ii            = 1
     6505                   .
     6506               do while valid-handle(hh):
     6507                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     6508                   do:
     6509                       case lc(hh:name) :
     6510                           when "b-help" then
     6511                               do:
     6512                                   hh:load-image-up("cmp/b-help.bmp":u) .
     6513                                   hh:load-image-down("cmp/b-help.bmp":u) .
     6514                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     6515                                   hh:TOOLTIP = "Помощь" .
     6516                                   v-help-old-x = hh:column .
     6517                                   v-help-old-y = hh:row    .
     6518                                   v-help-old-size = hh:width .
     6519                                   hh:width-chars = 2.5 .
     6520                               end.
     6521                           when "b-print" then
     6522                               do:
     6523                                   hh:load-image("cmp/b-print.bmp":u) .
     6524                                   hh:TOOLTIP = "Печать" .
     6525                                   v-h[ii] = hh:handle .
     6526                                   ii = ii + 1 .
     6527                                   hh:width-chars = 3 .
     6528                               end.
     6529                           when "b-history" or
     6530                           when "b-hist" then
     6531                               do:
     6532                                   hh:load-image("cmp/b-hist.bmp":u) .
     6533                                   hh:TOOLTIP = "История" .
     6534                                   v-h[ii] = hh:handle .
     6535                                   ii = ii + 1 .
     6536                                   hh:width-chars = 3 .
     6537                               end.
     6538                           when "b-sch" then
     6539                               do:
     6540                                   hh:load-image("cmp/b-sch.bmp":u) .
     6541                                   hh:TOOLTIP = "Установка Фильтра" .
     6542                                   v-h[ii] = hh:handle .
     6543                                   ii = ii + 1 .
     6544                                   hh:width-chars = 3 .
     6545                               end.
     6546                           when "b-hist-user" then
     6547                               do:
     6548                                   hh:load-image("cmp/b-hist.bmp":u) .
     6549                                   hh:TOOLTIP = "История пользователя" .
     6550                                   ii = ii + 1 .
     6551                               end.
     6552                       end case.
     6553                   end.
     6554                   hh = hh:next-sibling.
     6555               end.
     6556               b-help:column = v-frame-width - b-help:width-chars.
     6557               jj = 0.
     6558               repeat ii = 4 to 1 by -1 :
     6559                   if valid-handle (v-h[ii] ) then
     6560                   do:
     6561                       jj  = jj + 1 .
     6562                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     6563                       v-h[ii]:row    = v-help-old-y .
     6564                   end.
     6565               end.
     6566           end.
     6567       end.
     6568   end procedure.
     6569   assign parnext-prev = yes.
     6570   n-p:
