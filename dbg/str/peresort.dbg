     5410     END.
     5411   END.
     5412   ON CHOOSE OF r-agnt IN FRAME Dialog-Frame
     5413   DO:
     5414     RUN local-psn-chk in this-procedure ("agnt", "button").
     5415     apply "entry" to varboss in frame Dialog-Frame.
     5416     return no-apply.
     5417   END.
     5418   ON CHOOSE OF r-boss IN FRAME Dialog-Frame
     5419   DO:
     5420     RUN local-psn-chk in this-procedure ("boss", "button").
     5421     apply "entry" to b-exit in frame Dialog-Frame.
     5422     return no-apply.
     5423   END.
     5424   ON CHOOSE OF r-reas IN FRAME Dialog-Frame
