     5564   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5565   DEF VAR cur-clmn-numb-goods- as INT EXTENT 11 no-undo.
     5566   DEF VAR varmvib-goods-       as INT no-undo.
     5567   DEF VAR varmvjb-goods-       as INT no-undo.
     5568   DEF VAR varmvkb-goods-       as INT no-undo.
     5569   DEF VAR varmvlb-goods-       as INT no-undo.
     5570   DEF VAR move-elementb-goods- as INT no-undo.
     5571   def var jjb-goods-           as int no-undo.
     5572   do varmvib-goods- = 1 to EXTENT(cur-clmn-numb-goods-):
     5573     ASSIGN cur-clmn-numb-goods-[varmvib-goods-] = varmvib-goods-.
     5574   END.
     5575   RUN start-mv-clmnb-goods-.
     5576   PROCEDURE start-mv-clmnb-goods-:
     5577   def var old-session as logical no-undo.
     5578      old-session = SESSION:IMMEDIATE-DISPLAY.
     5579      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     5580      SESSION:IMMEDIATE-DISPLAY = old-session.
     5581   END.
     5582   ON ctrl-cursor-right OF BROWSE b-goods- do:
     5583     RUN re-move-clmnb-goods- ( 3, 11).
     5584   END.
     5585   ON ctrl-cursor-left OF BROWSE b-goods- do:
     5586     RUN re-move-clmnb-goods- (11, 3).
     5587   END.
     5588   PROCEDURE re-move-clmnb-goods-:
     5589     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     5590     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     5591     DO varmvib-goods- = 1 TO EXTENT(cur-clmn-numb-goods-):
     5592       if cur-clmn-numb-goods-[varmvib-goods-] = source-column THEN cur-clmn-numb-goods-[varmvib-goods-] = -1.
     5593     END.
     5594     if b-goods-:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     5595     if source-column > target-column THEN
     5596     DO varmvjb-goods- = source-column - 1 to target-column BY -1:
     5597       DO varmvib-goods- = 1 TO EXTENT(cur-clmn-numb-goods-):
     5598           if cur-clmn-numb-goods-[varmvib-goods-] = varmvjb-goods- THEN DO:
     5599             cur-clmn-numb-goods-[varmvib-goods-] = cur-clmn-numb-goods-[varmvib-goods-] + 1.
     5600           END.
     5601       END.
     5602     END.
     5603     ELSE
     5604     DO varmvjb-goods- = source-column + 1 to target-column:
     5605       DO varmvib-goods- = 1 TO EXTENT(cur-clmn-numb-goods-):
     5606         if cur-clmn-numb-goods-[varmvib-goods-] = varmvjb-goods- THEN DO:
     5607           cur-clmn-numb-goods-[varmvib-goods-] = cur-clmn-numb-goods-[varmvib-goods-] - 1.
     5608         END.
     5609       END.
     5610     END.
     5611     DO varmvib-goods- = 1 TO EXTENT(cur-clmn-numb-goods-):
     5612       if cur-clmn-numb-goods-[varmvib-goods-] = -1 THEN cur-clmn-numb-goods-[varmvib-goods-] = target-column.
     5613     END.
     5614   END PROCEDURE.
     5615   PROCEDURE ch-clmnb-goods-:
     5616     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     5617     if cur-clmn-loc <= 3 then do:
     5618       return .
     5619     end.
     5620     DO varmvib-goods- = 1 TO EXTENT(cur-clmn-numb-goods-):
     5621       if cur-clmn-numb-goods-[varmvib-goods-] = cur-clmn-loc THEN move-elementb-goods- = varmvib-goods-.
     5622     END.
     5623     RUN re-move-clmnb-goods- (cur-clmn-loc, 3).
     5624   END PROCEDURE.
     5625   PROCEDURE mv-brw-defaultb-goods-:
     5626   def var old-session as logical no-undo.
     5627     old-session = SESSION:IMMEDIATE-DISPLAY.
     5628     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     5629     do varmvlb-goods- = 3 to EXTENT(cur-clmn-numb-goods-):
     5630       RUN re-move-clmnb-goods- (cur-clmn-numb-goods-[varmvlb-goods-], varmvlb-goods-).
     5631     END.
     5632     RUN start-mv-clmnb-goods-.
     5633     SESSION:IMMEDIATE-DISPLAY = old-session.
     5634   END PROCEDURE.
     5635   .
     5636   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5637   DEF VAR cur-clmn-numb-goods as INT EXTENT 14 no-undo.
     5638   DEF VAR varmvib-goods       as INT no-undo.
     5639   DEF VAR varmvjb-goods       as INT no-undo.
     5640   DEF VAR varmvkb-goods       as INT no-undo.
     5641   DEF VAR varmvlb-goods       as INT no-undo.
     5642   DEF VAR move-elementb-goods as INT no-undo.
     5643   def var jjb-goods           as int no-undo.
     5644   do varmvib-goods = 1 to EXTENT(cur-clmn-numb-goods):
     5645     ASSIGN cur-clmn-numb-goods[varmvib-goods] = varmvib-goods.
     5646   END.
     5647   RUN start-mv-clmnb-goods.
     5648   PROCEDURE start-mv-clmnb-goods:
     5649   def var old-session as logical no-undo.
     5650      old-session = SESSION:IMMEDIATE-DISPLAY.
     5651      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     5652      SESSION:IMMEDIATE-DISPLAY = old-session.
     5653   END.
     5654   ON ctrl-cursor-right OF BROWSE b-goods do:
     5655     RUN re-move-clmnb-goods ( 2, 14).
     5656   END.
     5657   ON ctrl-cursor-left OF BROWSE b-goods do:
     5658     RUN re-move-clmnb-goods (14, 2).
     5659   END.
     5660   PROCEDURE re-move-clmnb-goods:
     5661     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     5662     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     5663     DO varmvib-goods = 1 TO EXTENT(cur-clmn-numb-goods):
     5664       if cur-clmn-numb-goods[varmvib-goods] = source-column THEN cur-clmn-numb-goods[varmvib-goods] = -1.
     5665     END.
     5666     if b-goods:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     5667     if source-column > target-column THEN
     5668     DO varmvjb-goods = source-column - 1 to target-column BY -1:
     5669       DO varmvib-goods = 1 TO EXTENT(cur-clmn-numb-goods):
     5670           if cur-clmn-numb-goods[varmvib-goods] = varmvjb-goods THEN DO:
     5671             cur-clmn-numb-goods[varmvib-goods] = cur-clmn-numb-goods[varmvib-goods] + 1.
     5672           END.
     5673       END.
     5674     END.
     5675     ELSE
     5676     DO varmvjb-goods = source-column + 1 to target-column:
     5677       DO varmvib-goods = 1 TO EXTENT(cur-clmn-numb-goods):
     5678         if cur-clmn-numb-goods[varmvib-goods] = varmvjb-goods THEN DO:
     5679           cur-clmn-numb-goods[varmvib-goods] = cur-clmn-numb-goods[varmvib-goods] - 1.
     5680         END.
     5681       END.
     5682     END.
     5683     DO varmvib-goods = 1 TO EXTENT(cur-clmn-numb-goods):
     5684       if cur-clmn-numb-goods[varmvib-goods] = -1 THEN cur-clmn-numb-goods[varmvib-goods] = target-column.
     5685     END.
     5686   END PROCEDURE.
     5687   PROCEDURE ch-clmnb-goods:
     5688     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     5689     if cur-clmn-loc <= 2 then do:
     5690       return .
     5691     end.
     5692     DO varmvib-goods = 1 TO EXTENT(cur-clmn-numb-goods):
     5693       if cur-clmn-numb-goods[varmvib-goods] = cur-clmn-loc THEN move-elementb-goods = varmvib-goods.
     5694     END.
     5695     RUN re-move-clmnb-goods (cur-clmn-loc, 2).
     5696   END PROCEDURE.
     5697   PROCEDURE mv-brw-defaultb-goods:
     5698   def var old-session as logical no-undo.
     5699     old-session = SESSION:IMMEDIATE-DISPLAY.
     5700     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     5701     do varmvlb-goods = 2 to EXTENT(cur-clmn-numb-goods):
     5702       RUN re-move-clmnb-goods (cur-clmn-numb-goods[varmvlb-goods], varmvlb-goods).
     5703     END.
     5704     RUN start-mv-clmnb-goods.
     5705     SESSION:IMMEDIATE-DISPLAY = old-session.
     5706   END PROCEDURE.
     5707   .
     5708   def var sort-labelb-goods-   as character no-undo .
     5709   def var sort-clmnb-goods-    as handle    no-undo .
     5710   def var cur-clmnb-goods-     as handle    no-undo .
     5711   def var cur-clmn-locb-goods- as integer   no-undo .
     5712   def var re-queryb-goods-     as logical   initial no no-undo .
     5713   on start-search, ctrl-o of b-goods- in frame Dialog-Frame do:
     5714      run sort-brb-goods-
     5715        (input (if available bf_doc-line
     5716                then recid(bf_doc-line)
     5717                else ?
     5718               )
     5719        ).
     5720   end.
     5721   PROCEDURE sort-brb-goods- :
     5722     define input parameter p-recid as recid no-undo .
     5723     if re-queryb-goods- = no then do:
     5724       assign
     5725          cur-clmnb-goods- = b-goods-:current-column in frame Dialog-Frame
     5726       .
     5727       if sort-clmnb-goods- <> ? then sort-clmnb-goods-:column-fgcolor = 0.
     5728       if cur-clmnb-goods- = sort-clmnb-goods- then do:
     5729         assign
     5730            sort-labelb-goods- = ""
     5731            sort-clmnb-goods- = ?
     5732         .
     5733        end.
     5734        else do:
     5735          assign
     5736            sort-labelb-goods- = cur-clmnb-goods-:label
     5737            sort-clmnb-goods-  = cur-clmnb-goods-
     5738            sort-clmnb-goods-:column-fgcolor = 4
     5739          .
     5740        end.
     5741      end.
     5742     assign
     5743       cur-clmn-locb-goods- = 1
     5744     .
     5745     def var column-handle as handle no-undo .
     5746     column-handle = b-goods-:first-column.
     5747     do while valid-handle(column-handle) :
     5748       if column-handle = cur-clmnb-goods- then do:
     5749         leave .
     5750       end.
     5751       column-handle = column-handle:NEXT-COLUMN.
     5752       assign
     5753         cur-clmn-locb-goods- = cur-clmn-locb-goods- + 1
     5754       .
     5755     end.
     5756     case sort-labelb-goods-:
     5757           when '*'  then DO:   open query b-goods- FOR EACH bf_doc-line WHERE bf_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,           FIRST bf_goods WHERE bf_goods.artic     = bf_doc-line.artic     AND                          bf_goods.prod-type = bf_doc-line.prod-type AND                          bf_goods.prod-code = bf_doc-line.prod-code NO-LOCK,           FIRST bf_parts WHERE bf_parts.out-code  = bf_doc-line.doc-code  AND                          bf_parts.obj-type  = bf_doc-line.obj-type  AND                          bf_parts.obj-code  = bf_doc-line.obj-code  AND                          bf_parts.artic     = bf_doc-line.artic     AND                          bf_parts.prod-type = bf_doc-line.prod-type AND                          bf_parts.prod-code = bf_doc-line.prod-code AND                          bf_parts.fact-qnty < 0 NO-LOCK by get-mark (buffer bf_doc-line) .   . END.
     5758           when 'Артикул'  then DO:   open query b-goods- FOR EACH bf_doc-line WHERE bf_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,           FIRST bf_goods WHERE bf_goods.artic     = bf_doc-line.artic     AND                          bf_goods.prod-type = bf_doc-line.prod-type AND                          bf_goods.prod-code = bf_doc-line.prod-code NO-LOCK,           FIRST bf_parts WHERE bf_parts.out-code  = bf_doc-line.doc-code  AND                          bf_parts.obj-type  = bf_doc-line.obj-type  AND                          bf_parts.obj-code  = bf_doc-line.obj-code  AND                          bf_parts.artic     = bf_doc-line.artic     AND                          bf_parts.prod-type = bf_doc-line.prod-type AND                          bf_parts.prod-code = bf_doc-line.prod-code AND                          bf_parts.fact-qnty < 0 NO-LOCK by bf_doc-line.artic .   . END.
     5759           when 'Название товара'  then DO:   open query b-goods- FOR EACH bf_doc-line WHERE bf_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,           FIRST bf_goods WHERE bf_goods.artic     = bf_doc-line.artic     AND                          bf_goods.prod-type = bf_doc-line.prod-type AND                          bf_goods.prod-code = bf_doc-line.prod-code NO-LOCK,           FIRST bf_parts WHERE bf_parts.out-code  = bf_doc-line.doc-code  AND                          bf_parts.obj-type  = bf_doc-line.obj-type  AND                          bf_parts.obj-code  = bf_doc-line.obj-code  AND                          bf_parts.artic     = bf_doc-line.artic     AND                          bf_parts.prod-type = bf_doc-line.prod-type AND                          bf_parts.prod-code = bf_doc-line.prod-code AND                          bf_parts.fact-qnty < 0 NO-LOCK by bf_goods.gds-name .   . END.
     5760           when 'Тип'  then DO:   open query b-goods- FOR EACH bf_doc-line WHERE bf_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,           FIRST bf_goods WHERE bf_goods.artic     = bf_doc-line.artic     AND                          bf_goods.prod-type = bf_doc-line.prod-type AND                          bf_goods.prod-code = bf_doc-line.prod-code NO-LOCK,           FIRST bf_parts WHERE bf_parts.out-code  = bf_doc-line.doc-code  AND                          bf_parts.obj-type  = bf_doc-line.obj-type  AND                          bf_parts.obj-code  = bf_doc-line.obj-code  AND                          bf_parts.artic     = bf_doc-line.artic     AND                          bf_parts.prod-type = bf_doc-line.prod-type AND                          bf_parts.prod-code = bf_doc-line.prod-code AND                          bf_parts.fact-qnty < 0 NO-LOCK by bf_doc-line.prod-type .   . END.
     5761           when 'Код произ'  then DO:   open query b-goods- FOR EACH bf_doc-line WHERE bf_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,           FIRST bf_goods WHERE bf_goods.artic     = bf_doc-line.artic     AND                          bf_goods.prod-type = bf_doc-line.prod-type AND                          bf_goods.prod-code = bf_doc-line.prod-code NO-LOCK,           FIRST bf_parts WHERE bf_parts.out-code  = bf_doc-line.doc-code  AND                          bf_parts.obj-type  = bf_doc-line.obj-type  AND                          bf_parts.obj-code  = bf_doc-line.obj-code  AND                          bf_parts.artic     = bf_doc-line.artic     AND                          bf_parts.prod-type = bf_doc-line.prod-type AND                          bf_parts.prod-code = bf_doc-line.prod-code AND                          bf_parts.fact-qnty < 0 NO-LOCK by bf_doc-line.prod-code .   . END.
     5762           when 'Цена'  then DO:   open query b-goods- FOR EACH bf_doc-line WHERE bf_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,           FIRST bf_goods WHERE bf_goods.artic     = bf_doc-line.artic     AND                          bf_goods.prod-type = bf_doc-line.prod-type AND                          bf_goods.prod-code = bf_doc-line.prod-code NO-LOCK,           FIRST bf_parts WHERE bf_parts.out-code  = bf_doc-line.doc-code  AND                          bf_parts.obj-type  = bf_doc-line.obj-type  AND                          bf_parts.obj-code  = bf_doc-line.obj-code  AND                          bf_parts.artic     = bf_doc-line.artic     AND                          bf_parts.prod-type = bf_doc-line.prod-type AND                          bf_parts.prod-code = bf_doc-line.prod-code AND                          bf_parts.fact-qnty < 0 NO-LOCK by get-price (buffer bf_goods) .   . END.
     5763           when 'Спис. кол-во'  then DO:   open query b-goods- FOR EACH bf_doc-line WHERE bf_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,           FIRST bf_goods WHERE bf_goods.artic     = bf_doc-line.artic     AND                          bf_goods.prod-type = bf_doc-line.prod-type AND                          bf_goods.prod-code = bf_doc-line.prod-code NO-LOCK,           FIRST bf_parts WHERE bf_parts.out-code  = bf_doc-line.doc-code  AND                          bf_parts.obj-type  = bf_doc-line.obj-type  AND                          bf_parts.obj-code  = bf_doc-line.obj-code  AND                          bf_parts.artic     = bf_doc-line.artic     AND                          bf_parts.prod-type = bf_doc-line.prod-type AND                          bf_parts.prod-code = bf_doc-line.prod-code AND                          bf_parts.fact-qnty < 0 NO-LOCK by get-write-off-qnty (BUFFER bf_doc-line) .   . END.
     5764           when 'Спис. сумма (руб)'  then DO:   open query b-goods- FOR EACH bf_doc-line WHERE bf_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,           FIRST bf_goods WHERE bf_goods.artic     = bf_doc-line.artic     AND                          bf_goods.prod-type = bf_doc-line.prod-type AND                          bf_goods.prod-code = bf_doc-line.prod-code NO-LOCK,           FIRST bf_parts WHERE bf_parts.out-code  = bf_doc-line.doc-code  AND                          bf_parts.obj-type  = bf_doc-line.obj-type  AND                          bf_parts.obj-code  = bf_doc-line.obj-code  AND                          bf_parts.artic     = bf_doc-line.artic     AND                          bf_parts.prod-type = bf_doc-line.prod-type AND                          bf_parts.prod-code = bf_doc-line.prod-code AND                          bf_parts.fact-qnty < 0 NO-LOCK by get-write-off-sum-rubl (BUFFER bf_doc-line) .   . END.
     5765           when 'Спис. сумма (вал)'  then DO:   open query b-goods- FOR EACH bf_doc-line WHERE bf_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,           FIRST bf_goods WHERE bf_goods.artic     = bf_doc-line.artic     AND                          bf_goods.prod-type = bf_doc-line.prod-type AND                          bf_goods.prod-code = bf_doc-line.prod-code NO-LOCK,           FIRST bf_parts WHERE bf_parts.out-code  = bf_doc-line.doc-code  AND                          bf_parts.obj-type  = bf_doc-line.obj-type  AND                          bf_parts.obj-code  = bf_doc-line.obj-code  AND                          bf_parts.artic     = bf_doc-line.artic     AND                          bf_parts.prod-type = bf_doc-line.prod-type AND                          bf_parts.prod-code = bf_doc-line.prod-code AND                          bf_parts.fact-qnty < 0 NO-LOCK by get-write-off-sum-base (BUFFER bf_doc-line) .   . END.
     5766           when 'Спис. НДС (руб)'  then DO:   open query b-goods- FOR EACH bf_doc-line WHERE bf_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,           FIRST bf_goods WHERE bf_goods.artic     = bf_doc-line.artic     AND                          bf_goods.prod-type = bf_doc-line.prod-type AND                          bf_goods.prod-code = bf_doc-line.prod-code NO-LOCK,           FIRST bf_parts WHERE bf_parts.out-code  = bf_doc-line.doc-code  AND                          bf_parts.obj-type  = bf_doc-line.obj-type  AND                          bf_parts.obj-code  = bf_doc-line.obj-code  AND                          bf_parts.artic     = bf_doc-line.artic     AND                          bf_parts.prod-type = bf_doc-line.prod-type AND                          bf_parts.prod-code = bf_doc-line.prod-code AND                          bf_parts.fact-qnty < 0 NO-LOCK by get-write-off-vat-rubl (BUFFER bf_doc-line) .   . END.
     5767           when 'Спис. НДС (вал)'  then DO:   open query b-goods- FOR EACH bf_doc-line WHERE bf_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,           FIRST bf_goods WHERE bf_goods.artic     = bf_doc-line.artic     AND                          bf_goods.prod-type = bf_doc-line.prod-type AND                          bf_goods.prod-code = bf_doc-line.prod-code NO-LOCK,           FIRST bf_parts WHERE bf_parts.out-code  = bf_doc-line.doc-code  AND                          bf_parts.obj-type  = bf_doc-line.obj-type  AND                          bf_parts.obj-code  = bf_doc-line.obj-code  AND                          bf_parts.artic     = bf_doc-line.artic     AND                          bf_parts.prod-type = bf_doc-line.prod-type AND                          bf_parts.prod-code = bf_doc-line.prod-code AND                          bf_parts.fact-qnty < 0 NO-LOCK by get-write-off-vat-base (BUFFER bf_doc-line) .   . END.
     5768       otherwise do:
     5769         OPEN QUERY b-goods- FOR EACH bf_doc-line WHERE bf_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,           FIRST bf_goods WHERE bf_goods.artic     = bf_doc-line.artic     AND                          bf_goods.prod-type = bf_doc-line.prod-type AND                          bf_goods.prod-code = bf_doc-line.prod-code NO-LOCK,           FIRST bf_parts WHERE bf_parts.out-code  = bf_doc-line.doc-code  AND                          bf_parts.obj-type  = bf_doc-line.obj-type  AND                          bf_parts.obj-code  = bf_doc-line.obj-code  AND                          bf_parts.artic     = bf_doc-line.artic     AND                          bf_parts.prod-type = bf_doc-line.prod-type AND                          bf_parts.prod-code = bf_doc-line.prod-code AND                          bf_parts.fact-qnty < 0 NO-LOCK.
     5770           if can-do( this-procedure:internal-entries, 'mv-brw-defaultb-goods-') then do:
     5771             run mv-brw-defaultb-goods-.
     5772           end.
     5773         if sort-labelb-goods- <> "" then do:
     5774           assign
     5775             cur-clmnb-goods-:column-fgcolor = 0
     5776           .
     5777         end.
     5778         assign
     5779           cur-clmn-locb-goods- = ?
     5780         .
     5781       end.
     5782     end case.
     5783       if cur-clmn-locb-goods- <> ? then do:
     5784         if can-do( this-procedure:internal-entries, 'ch-clmnb-goods-') then do:
     5785           run ch-clmnb-goods- in this-procedure (cur-clmn-locb-goods-).
     5786         end.
     5787       end.
     5788     if p-recid <> ? then do:
     5789       reposition b-goods- to recid p-recid no-error.
     5790       apply "value-changed" to b-goods- in frame Dialog-Frame.
     5791     end.
     5792     apply "entry" to b-goods- in frame Dialog-Frame.
     5793   END PROCEDURE.
     5794   procedure re-open-query-srt-clmnb-goods-:
     5795   if cur-clmnb-goods- = ? then do:
     5796      OPEN QUERY b-goods- FOR EACH bf_doc-line WHERE bf_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,           FIRST bf_goods WHERE bf_goods.artic     = bf_doc-line.artic     AND                          bf_goods.prod-type = bf_doc-line.prod-type AND                          bf_goods.prod-code = bf_doc-line.prod-code NO-LOCK,           FIRST bf_parts WHERE bf_parts.out-code  = bf_doc-line.doc-code  AND                          bf_parts.obj-type  = bf_doc-line.obj-type  AND                          bf_parts.obj-code  = bf_doc-line.obj-code  AND                          bf_parts.artic     = bf_doc-line.artic     AND                          bf_parts.prod-type = bf_doc-line.prod-type AND                          bf_parts.prod-code = bf_doc-line.prod-code AND                          bf_parts.fact-qnty < 0 NO-LOCK.
     5797   end.
     5798   else do:
     5799      assign re-queryb-goods- = yes.
     5800      run sort-brb-goods-
     5801        (input (if available bf_doc-line
     5802                then recid(bf_doc-line)
     5803                else ?
     5804               )
     5805        ).
     5806      assign re-queryb-goods- = no.
     5807   end.
     5808   end.
     5809   def var sort-labelb-goods   as character no-undo .
     5810   def var sort-clmnb-goods    as handle    no-undo .
     5811   def var cur-clmnb-goods     as handle    no-undo .
     5812   def var cur-clmn-locb-goods as integer   no-undo .
     5813   def var re-queryb-goods     as logical   initial no no-undo .
     5814   on start-search, ctrl-o of b-goods in frame Dialog-Frame do:
     5815      run sort-brb-goods
     5816        (input (if available bf-plus_doc-line
     5817                then recid(bf-plus_doc-line)
     5818                else ?
     5819               )
     5820        ).
     5821   end.
     5822   PROCEDURE sort-brb-goods :
     5823     define input parameter p-recid as recid no-undo .
     5824     if re-queryb-goods = no then do:
     5825       assign
     5826          cur-clmnb-goods = b-goods:current-column in frame Dialog-Frame
     5827       .
     5828       if sort-clmnb-goods <> ? then sort-clmnb-goods:column-fgcolor = 0.
     5829       if cur-clmnb-goods = sort-clmnb-goods then do:
     5830         assign
     5831            sort-labelb-goods = ""
     5832            sort-clmnb-goods = ?
     5833         .
     5834        end.
     5835        else do:
     5836          assign
     5837            sort-labelb-goods = cur-clmnb-goods:label
     5838            sort-clmnb-goods  = cur-clmnb-goods
     5839            sort-clmnb-goods:column-fgcolor = 4
     5840          .
     5841        end.
     5842      end.
     5843     assign
     5844       cur-clmn-locb-goods = 1
     5845     .
     5846     def var column-handle as handle no-undo .
     5847     column-handle = b-goods:first-column.
     5848     do while valid-handle(column-handle) :
     5849       if column-handle = cur-clmnb-goods then do:
     5850         leave .
     5851       end.
     5852       column-handle = column-handle:NEXT-COLUMN.
     5853       assign
     5854         cur-clmn-locb-goods = cur-clmn-locb-goods + 1
     5855       .
     5856     end.
     5857     case sort-labelb-goods:
     5858           when 'Артикул'  then DO:   open query b-goods FOR EACH bf-plus_doc-line WHERE bf-plus_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,            FIRST bf-plus_goods WHERE bf-plus_goods.artic     = bf-plus_doc-line.artic     AND                               bf-plus_goods.prod-type = bf-plus_doc-line.prod-type AND                               bf-plus_goods.prod-code = bf-plus_doc-line.prod-code NO-LOCK,            FIRST bf_parts-root WHERE bf_parts-root.doc-code      = bf-plus_doc-line.doc-code AND                               bf_parts-root.gds-code      = bf-plus_goods.gds-code    AND                               bf_parts-root.orig-gds-code = bf_goods.gds-code   NO-LOCK by bf-plus_doc-line.artic .   . END.
     5859           when 'Название товара'  then DO:   open query b-goods FOR EACH bf-plus_doc-line WHERE bf-plus_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,            FIRST bf-plus_goods WHERE bf-plus_goods.artic     = bf-plus_doc-line.artic     AND                               bf-plus_goods.prod-type = bf-plus_doc-line.prod-type AND                               bf-plus_goods.prod-code = bf-plus_doc-line.prod-code NO-LOCK,            FIRST bf_parts-root WHERE bf_parts-root.doc-code      = bf-plus_doc-line.doc-code AND                               bf_parts-root.gds-code      = bf-plus_goods.gds-code    AND                               bf_parts-root.orig-gds-code = bf_goods.gds-code   NO-LOCK by bf-plus_goods.gds-name .   . END.
     5860           when 'Тип'  then DO:   open query b-goods FOR EACH bf-plus_doc-line WHERE bf-plus_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,            FIRST bf-plus_goods WHERE bf-plus_goods.artic     = bf-plus_doc-line.artic     AND                               bf-plus_goods.prod-type = bf-plus_doc-line.prod-type AND                               bf-plus_goods.prod-code = bf-plus_doc-line.prod-code NO-LOCK,            FIRST bf_parts-root WHERE bf_parts-root.doc-code      = bf-plus_doc-line.doc-code AND                               bf_parts-root.gds-code      = bf-plus_goods.gds-code    AND                               bf_parts-root.orig-gds-code = bf_goods.gds-code   NO-LOCK by bf-plus_doc-line.prod-type .   . END.
     5861           when 'Код произ'  then DO:   open query b-goods FOR EACH bf-plus_doc-line WHERE bf-plus_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,            FIRST bf-plus_goods WHERE bf-plus_goods.artic     = bf-plus_doc-line.artic     AND                               bf-plus_goods.prod-type = bf-plus_doc-line.prod-type AND                               bf-plus_goods.prod-code = bf-plus_doc-line.prod-code NO-LOCK,            FIRST bf_parts-root WHERE bf_parts-root.doc-code      = bf-plus_doc-line.doc-code AND                               bf_parts-root.gds-code      = bf-plus_goods.gds-code    AND                               bf_parts-root.orig-gds-code = bf_goods.gds-code   NO-LOCK by bf-plus_doc-line.prod-code .   . END.
     5862           when 'Цена'  then DO:   open query b-goods FOR EACH bf-plus_doc-line WHERE bf-plus_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,            FIRST bf-plus_goods WHERE bf-plus_goods.artic     = bf-plus_doc-line.artic     AND                               bf-plus_goods.prod-type = bf-plus_doc-line.prod-type AND                               bf-plus_goods.prod-code = bf-plus_doc-line.prod-code NO-LOCK,            FIRST bf_parts-root WHERE bf_parts-root.doc-code      = bf-plus_doc-line.doc-code AND                               bf_parts-root.gds-code      = bf-plus_goods.gds-code    AND                               bf_parts-root.orig-gds-code = bf_goods.gds-code   NO-LOCK by get-price (buffer bf-plus_goods) .   . END.
     5863           when 'Оприх.кол-во'  then DO:   open query b-goods FOR EACH bf-plus_doc-line WHERE bf-plus_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,            FIRST bf-plus_goods WHERE bf-plus_goods.artic     = bf-plus_doc-line.artic     AND                               bf-plus_goods.prod-type = bf-plus_doc-line.prod-type AND                               bf-plus_goods.prod-code = bf-plus_doc-line.prod-code NO-LOCK,            FIRST bf_parts-root WHERE bf_parts-root.doc-code      = bf-plus_doc-line.doc-code AND                               bf_parts-root.gds-code      = bf-plus_goods.gds-code    AND                               bf_parts-root.orig-gds-code = bf_goods.gds-code   NO-LOCK by get-income-qnty (BUFFER bf_doc-line, BUFFER bf-plus_doc-line) .   . END.
     5864           when 'Оприх. сумма (руб)'  then DO:   open query b-goods FOR EACH bf-plus_doc-line WHERE bf-plus_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,            FIRST bf-plus_goods WHERE bf-plus_goods.artic     = bf-plus_doc-line.artic     AND                               bf-plus_goods.prod-type = bf-plus_doc-line.prod-type AND                               bf-plus_goods.prod-code = bf-plus_doc-line.prod-code NO-LOCK,            FIRST bf_parts-root WHERE bf_parts-root.doc-code      = bf-plus_doc-line.doc-code AND                               bf_parts-root.gds-code      = bf-plus_goods.gds-code    AND                               bf_parts-root.orig-gds-code = bf_goods.gds-code   NO-LOCK by get-income-sum-rubl (BUFFER bf_doc-line, BUFFER bf-plus_doc-line) .   . END.
     5865           when 'Оприх. сумма (вал)'  then DO:   open query b-goods FOR EACH bf-plus_doc-line WHERE bf-plus_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,            FIRST bf-plus_goods WHERE bf-plus_goods.artic     = bf-plus_doc-line.artic     AND                               bf-plus_goods.prod-type = bf-plus_doc-line.prod-type AND                               bf-plus_goods.prod-code = bf-plus_doc-line.prod-code NO-LOCK,            FIRST bf_parts-root WHERE bf_parts-root.doc-code      = bf-plus_doc-line.doc-code AND                               bf_parts-root.gds-code      = bf-plus_goods.gds-code    AND                               bf_parts-root.orig-gds-code = bf_goods.gds-code   NO-LOCK by get-income-sum-base (BUFFER bf_doc-line, BUFFER bf-plus_doc-line) .   . END.
     5866           when 'Оприх. НДС (руб)'  then DO:   open query b-goods FOR EACH bf-plus_doc-line WHERE bf-plus_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,            FIRST bf-plus_goods WHERE bf-plus_goods.artic     = bf-plus_doc-line.artic     AND                               bf-plus_goods.prod-type = bf-plus_doc-line.prod-type AND                               bf-plus_goods.prod-code = bf-plus_doc-line.prod-code NO-LOCK,            FIRST bf_parts-root WHERE bf_parts-root.doc-code      = bf-plus_doc-line.doc-code AND                               bf_parts-root.gds-code      = bf-plus_goods.gds-code    AND                               bf_parts-root.orig-gds-code = bf_goods.gds-code   NO-LOCK by get-income-vat-rubl (BUFFER bf_doc-line, BUFFER bf-plus_doc-line) .   . END.
     5867           when 'Оприх. НДС (вал)'  then DO:   open query b-goods FOR EACH bf-plus_doc-line WHERE bf-plus_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,            FIRST bf-plus_goods WHERE bf-plus_goods.artic     = bf-plus_doc-line.artic     AND                               bf-plus_goods.prod-type = bf-plus_doc-line.prod-type AND                               bf-plus_goods.prod-code = bf-plus_doc-line.prod-code NO-LOCK,            FIRST bf_parts-root WHERE bf_parts-root.doc-code      = bf-plus_doc-line.doc-code AND                               bf_parts-root.gds-code      = bf-plus_goods.gds-code    AND                               bf_parts-root.orig-gds-code = bf_goods.gds-code   NO-LOCK by get-income-vat-base (BUFFER bf_doc-line, BUFFER bf-plus_doc-line) .   . END.
     5868           when 'Отклонение %'  then DO:   open query b-goods FOR EACH bf-plus_doc-line WHERE bf-plus_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,            FIRST bf-plus_goods WHERE bf-plus_goods.artic     = bf-plus_doc-line.artic     AND                               bf-plus_goods.prod-type = bf-plus_doc-line.prod-type AND                               bf-plus_goods.prod-code = bf-plus_doc-line.prod-code NO-LOCK,            FIRST bf_parts-root WHERE bf_parts-root.doc-code      = bf-plus_doc-line.doc-code AND                               bf_parts-root.gds-code      = bf-plus_goods.gds-code    AND                               bf_parts-root.orig-gds-code = bf_goods.gds-code   NO-LOCK by get-deviation-percent (BUFFER bf_doc-line, BUFFER bf-plus_doc-line) .   . END.
     5869           when 'Отклонение (руб)'  then DO:   open query b-goods FOR EACH bf-plus_doc-line WHERE bf-plus_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,            FIRST bf-plus_goods WHERE bf-plus_goods.artic     = bf-plus_doc-line.artic     AND                               bf-plus_goods.prod-type = bf-plus_doc-line.prod-type AND                               bf-plus_goods.prod-code = bf-plus_doc-line.prod-code NO-LOCK,            FIRST bf_parts-root WHERE bf_parts-root.doc-code      = bf-plus_doc-line.doc-code AND                               bf_parts-root.gds-code      = bf-plus_goods.gds-code    AND                               bf_parts-root.orig-gds-code = bf_goods.gds-code   NO-LOCK by get-deviation-abs-rubl (BUFFER bf_doc-line, BUFFER bf-plus_doc-line) .   . END.
     5870           when 'Отклонение (вал)'  then DO:   open query b-goods FOR EACH bf-plus_doc-line WHERE bf-plus_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,            FIRST bf-plus_goods WHERE bf-plus_goods.artic     = bf-plus_doc-line.artic     AND                               bf-plus_goods.prod-type = bf-plus_doc-line.prod-type AND                               bf-plus_goods.prod-code = bf-plus_doc-line.prod-code NO-LOCK,            FIRST bf_parts-root WHERE bf_parts-root.doc-code      = bf-plus_doc-line.doc-code AND                               bf_parts-root.gds-code      = bf-plus_goods.gds-code    AND                               bf_parts-root.orig-gds-code = bf_goods.gds-code   NO-LOCK by get-deviation-abs-base (BUFFER bf_doc-line, BUFFER bf-plus_doc-line) .   . END.
     5871           when 'Спис. кол-во для оприх.кол-ва'  then DO:   open query b-goods FOR EACH bf-plus_doc-line WHERE bf-plus_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,            FIRST bf-plus_goods WHERE bf-plus_goods.artic     = bf-plus_doc-line.artic     AND                               bf-plus_goods.prod-type = bf-plus_doc-line.prod-type AND                               bf-plus_goods.prod-code = bf-plus_doc-line.prod-code NO-LOCK,            FIRST bf_parts-root WHERE bf_parts-root.doc-code      = bf-plus_doc-line.doc-code AND                               bf_parts-root.gds-code      = bf-plus_goods.gds-code    AND                               bf_parts-root.orig-gds-code = bf_goods.gds-code   NO-LOCK by get-write-off-for-income-qnty (BUFFER bf_doc-line, BUFFER bf-plus_doc-line) .   . END.
     5872       otherwise do:
     5873         OPEN QUERY b-goods FOR EACH bf-plus_doc-line WHERE bf-plus_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,            FIRST bf-plus_goods WHERE bf-plus_goods.artic     = bf-plus_doc-line.artic     AND                               bf-plus_goods.prod-type = bf-plus_doc-line.prod-type AND                               bf-plus_goods.prod-code = bf-plus_doc-line.prod-code NO-LOCK,            FIRST bf_parts-root WHERE bf_parts-root.doc-code      = bf-plus_doc-line.doc-code AND                               bf_parts-root.gds-code      = bf-plus_goods.gds-code    AND                               bf_parts-root.orig-gds-code = bf_goods.gds-code   NO-LOCK.
     5874           if can-do( this-procedure:internal-entries, 'mv-brw-defaultb-goods') then do:
     5875             run mv-brw-defaultb-goods.
     5876           end.
     5877         if sort-labelb-goods <> "" then do:
     5878           assign
     5879             cur-clmnb-goods:column-fgcolor = 0
     5880           .
     5881         end.
     5882         assign
     5883           cur-clmn-locb-goods = ?
     5884         .
     5885       end.
     5886     end case.
     5887       if cur-clmn-locb-goods <> ? then do:
     5888         if can-do( this-procedure:internal-entries, 'ch-clmnb-goods') then do:
     5889           run ch-clmnb-goods in this-procedure (cur-clmn-locb-goods).
     5890         end.
     5891       end.
     5892     if p-recid <> ? then do:
     5893       reposition b-goods to recid p-recid no-error.
     5894       apply "value-changed" to b-goods in frame Dialog-Frame.
     5895     end.
     5896     apply "entry" to b-goods in frame Dialog-Frame.
     5897   END PROCEDURE.
     5898   procedure re-open-query-srt-clmnb-goods:
     5899   if cur-clmnb-goods = ? then do:
     5900      OPEN QUERY b-goods FOR EACH bf-plus_doc-line WHERE bf-plus_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,            FIRST bf-plus_goods WHERE bf-plus_goods.artic     = bf-plus_doc-line.artic     AND                               bf-plus_goods.prod-type = bf-plus_doc-line.prod-type AND                               bf-plus_goods.prod-code = bf-plus_doc-line.prod-code NO-LOCK,            FIRST bf_parts-root WHERE bf_parts-root.doc-code      = bf-plus_doc-line.doc-code AND                               bf_parts-root.gds-code      = bf-plus_goods.gds-code    AND                               bf_parts-root.orig-gds-code = bf_goods.gds-code   NO-LOCK.
     5901   end.
     5902   else do:
     5903      assign re-queryb-goods = yes.
     5904      run sort-brb-goods
     5905        (input (if available bf-plus_doc-line
     5906                then recid(bf-plus_doc-line)
     5907                else ?
     5908               )
     5909        ).
     5910      assign re-queryb-goods = no.
     5911   end.
     5912   end.
