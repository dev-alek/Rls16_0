     5106       ,input  bf_trn-doc.obj-type
     5107       ,input  bf_trn-doc.obj-code
     5108       ,input  0
     5109       ,input  0
     5110       ,input  0
     5111       ,input  true
     5112       ,output varlog
     5113       )  .
     5114   end.
     5115     if not varlog then do:
     5116       return no-apply.
     5117     end.
     5118     run str/scntdoc.w ( input bf_trn-doc.doc-code, input ( v-cntxt-db-num = bf_sysconf.firm-db-num ) ).
     5119   END.
