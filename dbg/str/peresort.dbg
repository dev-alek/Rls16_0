     8071         varoldsale-slt-base-exp        = 0
     8072         varoldsale-slt-rubl-exp        = 0
     8073         varoldsale-road-tax-base-exp   = 0
     8074         varoldsale-road-tax-rubl-exp   = 0
     8075         varoldsale-excise-base-exp     = 0
     8076         varoldsale-excise-rubl-exp     = 0
     8077         varoldsale-transport-base-exp  = 0
     8078         varoldsale-transport-rubl-exp  = 0
     8079         varoldsale-other-base-exp      = 0
     8080         varoldsale-other-rubl-exp      = 0
     8081        .
     8082      end.
     8083      if not parhave-exp then do:
     8084        assign
     8085          varoldfact-qnty-inp            =   bf-incp_doc-line-sum.fact-qnty
     8086          varoldcost-sum-base-inp        =   bf-incp_doc-line-sum.cost-sum-base
     8087          varoldcost-sum-rubl-inp        =   bf-incp_doc-line-sum.cost-sum-rubl
     8088          varoldcost-vat-base-inp        =   bf-incp_doc-line-sum.cost-vat-base
     8089          varoldcost-vat-rubl-inp        =   bf-incp_doc-line-sum.cost-vat-rubl
     8090          varoldcost-slt-base-inp        =   bf-incp_doc-line-sum.cost-slt-base
     8091          varoldcost-slt-rubl-inp        =   bf-incp_doc-line-sum.cost-slt-rubl
     8092          varoldcost-road-tax-base-inp   =   bf-incp_doc-line-sum.cost-road-tax-base
     8093          varoldcost-road-tax-rubl-inp   =   bf-incp_doc-line-sum.cost-road-tax-rubl
     8094          varoldcost-excise-base-inp     =   bf-incp_doc-line-sum.cost-excise-base
     8095          varoldcost-excise-rubl-inp     =   bf-incp_doc-line-sum.cost-excise-rubl
     8096          varoldcost-transport-base-inp  =   bf-incp_doc-line-sum.cost-transport-base
     8097          varoldcost-transport-rubl-inp  =   bf-incp_doc-line-sum.cost-transport-rubl
     8098          varoldcost-other-base-inp      =   bf-incp_doc-line-sum.cost-other-base
     8099          varoldcost-other-rubl-inp      =   bf-incp_doc-line-sum.cost-other-rubl
     8100          varoldsale-sum-base-inp        =   bf-incp_doc-line-sum.sale-sum-base
     8101          varoldsale-sum-rubl-inp        =   bf-incp_doc-line-sum.sale-sum-rubl
     8102          varoldsale-vat-base-inp        =   bf-incp_doc-line-sum.sale-vat-base
     8103          varoldsale-vat-rubl-inp        =   bf-incp_doc-line-sum.sale-vat-rubl
     8104          varoldsale-slt-base-inp        =   bf-incp_doc-line-sum.sale-slt-base
     8105          varoldsale-slt-rubl-inp        =   bf-incp_doc-line-sum.sale-slt-rubl
     8106          varoldsale-road-tax-base-inp   =   bf-incp_doc-line-sum.sale-road-tax-base
     8107          varoldsale-road-tax-rubl-inp   =   bf-incp_doc-line-sum.sale-road-tax-rubl
     8108          varoldsale-excise-base-inp     =   bf-incp_doc-line-sum.sale-excise-base
     8109          varoldsale-excise-rubl-inp     =   bf-incp_doc-line-sum.sale-excise-rubl
     8110          varoldsale-transport-base-inp  =   bf-incp_doc-line-sum.sale-transport-base
     8111          varoldsale-transport-rubl-inp  =   bf-incp_doc-line-sum.sale-transport-rubl
     8112          varoldsale-other-base-inp      =   bf-incp_doc-line-sum.sale-other-base
     8113          varoldsale-other-rubl-inp      =   bf-incp_doc-line-sum.sale-other-rubl
     8114        .
     8115     end.
     8116     else do:
     8117        assign
     8118          varoldfact-qnty-inp            = 0
     8119          varoldcost-sum-base-inp        = 0
     8120          varoldcost-sum-rubl-inp        = 0
     8121          varoldcost-vat-base-inp        = 0
     8122          varoldcost-vat-rubl-inp        = 0
     8123          varoldcost-slt-base-inp        = 0
     8124          varoldcost-slt-rubl-inp        = 0
     8125          varoldcost-road-tax-base-inp   = 0
     8126          varoldcost-road-tax-rubl-inp   = 0
     8127          varoldcost-excise-base-inp     = 0
     8128          varoldcost-excise-rubl-inp     = 0
     8129          varoldcost-transport-base-inp  = 0
     8130          varoldcost-transport-rubl-inp  = 0
     8131          varoldcost-other-base-inp      = 0
     8132          varoldcost-other-rubl-inp      = 0
     8133          varoldsale-sum-base-inp        = 0
     8134          varoldsale-sum-rubl-inp        = 0
     8135          varoldsale-vat-base-inp        = 0
     8136          varoldsale-vat-rubl-inp        = 0
     8137          varoldsale-slt-base-inp        = 0
     8138          varoldsale-slt-rubl-inp        = 0
     8139          varoldsale-road-tax-base-inp   = 0
     8140          varoldsale-road-tax-rubl-inp   = 0
     8141          varoldsale-excise-base-inp     = 0
     8142          varoldsale-excise-rubl-inp     = 0
     8143          varoldsale-transport-base-inp  = 0
     8144          varoldsale-transport-rubl-inp  = 0
     8145          varoldsale-other-base-inp      = 0
     8146          varoldsale-other-rubl-inp      = 0
     8147        .
     8148     end.
     8149   end.
     8150   end.
     8151   END PROCEDURE.
     8152   PROCEDURE mark-list :
     8153   DEFINE VARIABLE varlog AS LOGICAL NO-UNDO.
     8154   do on error undo, return error return-value :
     8155   if not available bf_doc-line then do:
     8156     message "Неправильный выбор строки.".
     8157     return ERROR.
     8158   end.
     8159   find first tt-del-list where tt-del-list.rec-id = recid( bf_doc-line ) no-error.
     8160   if available tt-del-list then do:
     8161     delete tt-del-list.
     8162   end.
     8163   else do:
     8164     create tt-del-list.
     8165     assign
     8166       tt-del-list.rec-id = recid( bf_doc-line ).
     8167   end.
     8168   b-goods-:refresh() in frame Dialog-Frame.
     8169   varlog = b-goods-:select-next-row () in frame Dialog-Frame.
     8170   apply "entry" to b-goods- in frame Dialog-Frame.
     8171   end.
     8172   END PROCEDURE.
     8173   PROCEDURE mode-on :
     8174   define variable varrecid as recid no-undo.
     8175   do on error undo, return error :
     8176   if pardoc-mode = 'ДОБАВЛЕНИЕ':U then do:
     8177      RUN add-doc in this-procedure ( output varrecid ) no-error.
     8178      if error-status :error then do:
     8179        message
     8180          vss-workfile vss-revision vss-description skip
     8181          "Ошибка при добавлении документа." skip
     8182          return-value skip
     8183          trim(error-status :get-message(1))
     8184          view-as alert-box error.
     8185        undo, return error .
     8186      end.
     8187   end.
     8188   else do:
     8189     find first bf_trn-doc where recid(bf_trn-doc) = pardoc-rec no-lock.
     8190     if available bf_trn-doc then do:
     8191       if pardoc-mode = 'ИЗМЕНЕНИЕ':U then do:
     8192         if bf_trn-doc.status_ <> 'накл':U then do:
     8193           message "Документ закрыт." skip (1)
     8194                   "Редактирование невозможно."
     8195                   view-as alert-box error.
     8196           return error.
     8197         end.
     8198         else do:
     8199           if v-cntxt-db-num <> bf-obj_clients.db-num then do:
     8200             message
     8201               vss-workfile vss-revision vss-description skip
     8202               "Редактирование документа возможно только на активной стороне." skip
     8203               return-value skip
     8204               trim(error-status :get-message(1))
     8205               view-as alert-box error.
     8206             undo, return error .
     8207           end.
     8208         end.
     8209       end.
     8210     end.
     8211     else do:
     8212       message "Неправильный выбор документа.".
     8213       return error.
     8214     end.
     8215   end.
     8216   end.
     8217   END PROCEDURE.
     8218   PROCEDURE notes-tr :
     8219   define variable varnotes as character no-undo.
     8220   assign
     8221     varnotes = bf_trn-doc.PS.
     8222   run gbl/d-prompt.w (
     8223       'title=Примечание\'
     8224     + 'type=editor\'
     8225     + 'fillin_width=96\'
     8226     + 'fillin_height=15\'
     8227     + (if pardoc-mode = 'ПРОСМОТР':U then 'readonly=yes\' else '':U)
     8228     , input-output varnotes).
     8229   if pardoc-mode <> 'ПРОСМОТР':U then do:
     8230     if return-value = 'false':u
     8231     then do:
     8232       return .
     8233     end.
     8234     if bf_trn-doc.PS <> varnotes then do:
     8235       do transaction on error undo, return error return-value :
     8236         find CURRENT bf_trn-doc exclusive-lock.
     8237         assign
     8238           bf_trn-doc.PS = varnotes.
     8239       end.
     8240     end.
     8241   end.
     8242   END PROCEDURE.
     8243   PROCEDURE proc-exit :
     8244   DEFINE BUFFER bf-f_doc-line FOR ub.doc-line.
     8245   DEFINE VARIABLE varlog AS LOGICAL NO-UNDO.
     8246   if pardoc-mode = 'ИЗМЕНЕНИЕ':U or pardoc-mode = 'ДОБАВЛЕНИЕ':U then do:
     8247     parnext-prev = ?.
     8248     if not can-find (first bf-f_doc-line where bf-f_doc-line.doc-code = bf_trn-doc.doc-code no-lock) then do:
     8249       varlog = yes.
     8250       message "В документе нет строк, поэтому он удаляется." view-as alert-box
     8251         question buttons OK-Cancel update varlog.
     8252       if varlog then do:
     8253         delete bf_trn-doc.
     8254         assign pardoc-rec = ?.
     8255         return.
     8256       end.
     8257       else do:
     8258         return error.
     8259       end.
     8260     end.
     8261     else do:
     8262       assign
     8263         bf_trn-doc.reason-code = varreason-code
     8264         bf_trn-doc.wrkr = varwrkr
     8265         bf_trn-doc.agnt = varagnt
     8266         bf_trn-doc.boss = varboss.
     8267      end.
     8268   end.
     8269   END PROCEDURE.
     8270   PROCEDURE proc-get-write-off :
     8271   DEFINE PARAMETER BUFFER bf-loc_doc-line FOR ub.doc-line.
     8272   DEFINE BUFFER bf-loc-plus_doc-line FOR ub.doc-line.
     8273   DEFINE BUFFER bf-loc_parts         FOR ub.parts.
     8274   DEFINE BUFFER bf-loc_parts-root    FOR ub.parts-root.
     8275   DEFINE BUFFER bf-loc-plus_parts    FOR ub.parts.
     8276   DEFINE BUFFER bf-loc_goods         FOR ub.goods.
     8277   DEFINE BUFFER bf-loc-plus_goods    FOR ub.goods.
     8278   DEFINE VARIABLE varprice-rubl-parts AS DECIMAL NO-UNDO.
     8279   DEFINE VARIABLE varprice-base-parts AS DECIMAL NO-UNDO.
     8280   FIND FIRST bf-loc_goods WHERE bf-loc_goods.artic     = bf-loc_doc-line.artic     AND
     8281                                 bf-loc_goods.prod-type = bf-loc_doc-line.prod-type AND
     8282                                 bf-loc_goods.prod-code = bf-loc_doc-line.prod-code NO-LOCK.
     8283   FIND FIRST tt-doc-line-cashe WHERE tt-doc-line-cashe.doc-code  = bf-loc_doc-line.doc-code  AND
     8284                                      tt-doc-line-cashe.artic     = bf-loc_doc-line.artic     AND
     8285                                      tt-doc-line-cashe.prod-type = bf-loc_doc-line.prod-type AND
     8286                                      tt-doc-line-cashe.prod-code = bf-loc_doc-line.prod-code NO-ERROR.
     8287   IF NOT AVAILABLE tt-doc-line-cashe THEN DO:
     8288     CREATE tt-doc-line-cashe.
     8289     ASSIGN
     8290       tt-doc-line-cashe.doc-code  = bf-loc_doc-line.doc-code
     8291       tt-doc-line-cashe.artic     = bf-loc_doc-line.artic
     8292       tt-doc-line-cashe.prod-type = bf-loc_doc-line.prod-type
     8293       tt-doc-line-cashe.prod-code = bf-loc_doc-line.prod-code .
     8294   END.
     8295   ELSE DO:
     8296     ASSIGN
     8297       tt-doc-line-cashe.qnty     = 0.00
     8298       tt-doc-line-cashe.sum-rubl = 0.00
     8299       tt-doc-line-cashe.sum-base = 0.00
     8300       tt-doc-line-cashe.vat-rubl = 0.00
     8301       tt-doc-line-cashe.vat-base = 0.00.
     8302     FOR EACH tt-doc-line-cashe-plus WHERE tt-doc-line-cashe-plus.doc-code     = tt-doc-line-cashe.doc-code  AND
     8303                                           tt-doc-line-cashe-plus.wf-artic     = tt-doc-line-cashe.artic     AND
     8304                                           tt-doc-line-cashe-plus.wf-prod-type = tt-doc-line-cashe.prod-type AND
     8305                                           tt-doc-line-cashe-plus.wf-prod-code = tt-doc-line-cashe.prod-code :
     8306       DELETE tt-doc-line-cashe-plus.
     8307     END.
     8308   END.
     8309   FOR EACH bf-loc_parts WHERE bf-loc_parts.out-code  = bf-loc_doc-line.doc-code  AND
     8310                               bf-loc_parts.obj-type  = bf-loc_doc-line.obj-type  AND
     8311                               bf-loc_parts.obj-code  = bf-loc_doc-line.obj-code  AND
     8312                               bf-loc_parts.artic     = bf-loc_doc-line.artic     AND
     8313                               bf-loc_parts.prod-type = bf-loc_doc-line.prod-type AND
     8314                               bf-loc_parts.prod-code = bf-loc_doc-line.prod-code AND
     8315                               bf-loc_parts.fact-qnty < 0 NO-LOCK :
     8316     FOR EACH tt-clcparts :
     8317       DELETE tt-clcparts.
     8318     END.
     8319     CREATE tt-clcparts.
     8320     BUFFER-COPY bf-loc_parts TO tt-clcparts.
     8321     run clcprtsl_calc-parts in this-procedure (
     8322                                     input recid( tt-clcparts )
     8323                                   , input yes
     8324                                   , input no
     8325                                   , input bf-loc_doc-line.road-tax
     8326                                   , input bf-loc_doc-line.excise
     8327                                   , input bf-loc_doc-line.VAT-pc
     8328                                   , input bf-loc_doc-line.cons-vat-pc
     8329                                   , input bf-loc_doc-line.SLT-pc
     8330                                   , input bf_trn-doc.base-rate
     8331                                   , input bf_trn-doc.base-scale
     8332                                   , input "":U
     8333                                   , input 0.0
     8334                                   , input 0.0
     8335                                   , input 0.0
     8336                                   , input 0.0
     8337                                   , input 0.0
     8338                                   , input 0.0
     8339                               ).
     8340     FIND FIRST tt-allsum WHERE tt-allsum.sum-type = 'основная_сумма':U NO-ERROR.
     8341     if available tt-allsum then do:
     8342       ASSIGN
     8343         tt-doc-line-cashe.qnty     = tt-doc-line-cashe.qnty     - tt-allsum.fact-qnty
     8344         tt-doc-line-cashe.sum-rubl = tt-doc-line-cashe.sum-rubl - tt-allsum.sum-dsc-rubl-doc
     8345         tt-doc-line-cashe.sum-base = tt-doc-line-cashe.sum-base - tt-allsum.sum-dsc-base-doc
     8346         tt-doc-line-cashe.vat-rubl = tt-doc-line-cashe.vat-rubl - tt-allsum.vat-rubl-doc
     8347         tt-doc-line-cashe.vat-base = tt-doc-line-cashe.vat-base - tt-allsum.vat-base-doc.
     8348       ASSIGN
     8349         varprice-rubl-parts = tt-allsum.sum-dsc-rubl-doc / tt-allsum.fact-qnty
     8350         varprice-base-parts = tt-allsum.sum-dsc-base-doc / tt-allsum.fact-qnty.
     8351       FOR EACH bf-loc_parts-root WHERE bf-loc_parts-root.doc-code       = bf-loc_parts.out-code   AND
     8352                                        bf-loc_parts-root.orig-in-code   = bf-loc_parts.in-code    AND
     8353                                        bf-loc_parts-root.orig-gds-code  = bf-loc_goods.gds-code   AND
     8354                                        bf-loc_parts-root.orig-part-code = bf-loc_parts.part-code  NO-LOCK :
     8355         FIND FIRST bf-loc-plus_goods WHERE bf-loc-plus_goods.gds-code  = bf-loc_parts-root.gds-code NO-LOCK.
     8356         FIND FIRST bf-loc-plus_parts WHERE bf-loc-plus_parts.obj-type  = bf-loc_doc-line.obj-type    AND
     8357                                            bf-loc-plus_parts.obj-code  = bf-loc_doc-line.obj-code    AND
     8358                                            bf-loc-plus_parts.artic     = bf-loc-plus_goods.artic     AND
     8359                                            bf-loc-plus_parts.prod-type = bf-loc-plus_goods.prod-type AND
     8360                                            bf-loc-plus_parts.prod-code = bf-loc-plus_goods.prod-code AND
     8361                                            bf-loc-plus_parts.in-code   = bf-loc_parts-root.in-code   AND
     8362                                            bf-loc-plus_parts.out-code  = bf-loc_doc-line.doc-code    AND
     8363                                            bf-loc-plus_parts.part-code = bf-loc_parts-root.part-code NO-LOCK.
     8364         FIND FIRST bf-loc-plus_doc-line WHERE bf-loc-plus_doc-line.doc-code  = bf-loc-plus_parts.out-code  AND
     8365                                               bf-loc-plus_doc-line.artic     = bf-loc-plus_parts.artic     AND
     8366                                               bf-loc-plus_doc-line.prod-type = bf-loc-plus_parts.prod-type AND
     8367                                               bf-loc-plus_doc-line.prod-code = bf-loc-plus_parts.prod-code .
     8368         FIND FIRST tt-doc-line-cashe-plus WHERE tt-doc-line-cashe-plus.doc-code     = tt-doc-line-cashe.doc-code  AND
     8369                                                 tt-doc-line-cashe-plus.wf-artic     = tt-doc-line-cashe.artic     AND
     8370                                                 tt-doc-line-cashe-plus.wf-prod-type = tt-doc-line-cashe.prod-type AND
     8371                                                 tt-doc-line-cashe-plus.wf-prod-code = tt-doc-line-cashe.prod-code AND
     8372                                                 tt-doc-line-cashe-plus.artic        = bf-loc-plus_goods.artic      AND
     8373                                                 tt-doc-line-cashe-plus.prod-type    = bf-loc-plus_goods.prod-type  AND
     8374                                                 tt-doc-line-cashe-plus.prod-code    = bf-loc-plus_goods.prod-code  NO-ERROR.
     8375         IF NOT AVAILABLE tt-doc-line-cashe-plus THEN DO:
     8376           create tt-doc-line-cashe-plus.
     8377           ASSIGN
     8378             tt-doc-line-cashe-plus.doc-code     = tt-doc-line-cashe.doc-code
     8379             tt-doc-line-cashe-plus.wf-artic     = tt-doc-line-cashe.artic
     8380             tt-doc-line-cashe-plus.wf-prod-type = tt-doc-line-cashe.prod-type
     8381             tt-doc-line-cashe-plus.wf-prod-code = tt-doc-line-cashe.prod-code
     8382             tt-doc-line-cashe-plus.artic        = bf-loc-plus_goods.artic
     8383             tt-doc-line-cashe-plus.prod-type    = bf-loc-plus_goods.prod-type
     8384             tt-doc-line-cashe-plus.prod-code    = bf-loc-plus_goods.prod-code .
     8385         END.
     8386         FOR EACH tt-clcparts :
     8387           DELETE tt-clcparts.
     8388         END.
     8389         CREATE tt-clcparts.
     8390         BUFFER-COPY bf-loc-plus_parts TO tt-clcparts.
     8391         run clcprtsl_calc-parts in this-procedure (
     8392                                         input recid( tt-clcparts )
     8393                                       , input yes
     8394                                       , input no
     8395                                       , input bf-loc-plus_doc-line.road-tax
     8396                                       , input bf-loc-plus_doc-line.excise
     8397                                       , input bf-loc-plus_doc-line.VAT-pc
     8398                                       , input bf-loc-plus_doc-line.cons-vat-pc
     8399                                       , input bf-loc-plus_doc-line.SLT-pc
     8400                                       , input bf_trn-doc.base-rate
     8401                                       , input bf_trn-doc.base-scale
     8402                                       , input "":U
     8403                                       , input 0.0
     8404                                       , input 0.0
     8405                                       , input 0.0
     8406                                       , input 0.0
     8407                                       , input 0.0
     8408                                       , input 0.0
     8409                                   ).
     8410         FIND FIRST tt-allsum WHERE tt-allsum.sum-type = 'основная_сумма':U NO-ERROR.
     8411         if available tt-allsum then do:
     8412           ASSIGN
     8413             tt-doc-line-cashe-plus.qnty               = tt-doc-line-cashe-plus.qnty               + tt-allsum.fact-qnty
     8414             tt-doc-line-cashe-plus.sum-rubl           = tt-doc-line-cashe-plus.sum-rubl           + tt-allsum.sum-dsc-rubl-doc
     8415             tt-doc-line-cashe-plus.sum-base           = tt-doc-line-cashe-plus.sum-base           + tt-allsum.sum-dsc-base-doc
     8416             tt-doc-line-cashe-plus.vat-rubl           = tt-doc-line-cashe-plus.vat-rubl           + tt-allsum.vat-rubl-doc
     8417             tt-doc-line-cashe-plus.vat-base           = tt-doc-line-cashe-plus.vat-base           + tt-allsum.vat-base-doc
     8418             tt-doc-line-cashe-plus.write-off-qnty     = tt-doc-line-cashe-plus.write-off-qnty     + tt-clcparts.real-qnty
     8419             tt-doc-line-cashe-plus.write-off-sum-rubl = tt-doc-line-cashe-plus.write-off-sum-rubl + varprice-rubl-parts * tt-clcparts.real-qnty
     8420             tt-doc-line-cashe-plus.write-off-sum-base = tt-doc-line-cashe-plus.write-off-sum-base + varprice-base-parts * tt-clcparts.real-qnty
     8421           .
     8422         END.
     8423       END.
     8424     END.
     8425   END.
     8426   END PROCEDURE.
     8427   PROCEDURE proc-history :
     8428   define variable loc-ref-list as character no-undo.
     8429     do on error undo, return error return-value :
     8430       if not available doc-line then do:
     8431         return error.
     8432       end.
     8433       run str/docclins.w ( input        parparentproc,
     8434                        input        "":U,
     8435                        input        "doc",
     8436                        input        doc-line.obj-type,
     8437                        input        doc-line.obj-code,
     8438                        input        doc-line.doc-code,
     8439                        input        doc-line.artic,
     8440                        input        doc-line.prod-type,
     8441                        input        doc-line.prod-code,
     8442                        input-output loc-ref-list             ).
     8443       apply "ENTRY":U to b-goods in frame Dialog-Frame.
     8444     end.
     8445     END PROCEDURE.
     8446   PROCEDURE proc-shift-name :
     8447   define buffer bf_shift-obj   for ub.shift-obj.
     8448     define buffer bf_shift-staff for ub.shift-staff.
     8449     define variable varfind-shift as integer initial 0.
     8450     define variable varshift-date-mem like ub.shift-obj.shift-date no-undo.
     8451     define variable varshift-num-mem  like ub.shift-obj.shift-num  no-undo.
     8452     if input frame Dialog-Frame varshift-date <> ? then do:
     8453       for each  bf_shift-obj where bf_shift-obj.obj-type   = bf_trn-doc.obj-type                             and
     8454                                    bf_shift-obj.obj-code   = bf_trn-doc.obj-code                             and
     8455                                    bf_shift-obj.shift-date = input frame Dialog-Frame varshift-date no-lock on error undo, return error return-value :
     8456         assign
     8457           varfind-shift = varfind-shift + 1
     8458           varshift-date-mem = bf_shift-obj.shift-date
     8459           varshift-num-mem  = bf_shift-obj.shift-num.
     8460       end.
     8461       if varfind-shift = 0 or varfind-shift > 1 then do:
     8462         if varfind-shift = 0 then do:
     8463           message "Не найдена смена: " bf_trn-doc.obj-type " " bf_trn-doc.obj-code
     8464                   " Дата " input frame Dialog-Frame varshift-date
     8465                    " Номер смены " input frame Dialog-Frame varshift-name " ."
     8466           view-as alert-box error.
     8467         end.
     8468         else do:
     8469           message "Найдено более одной смены с одним номером в сменном дне. Объект: " bf_trn-doc.obj-type " " bf_trn-doc.obj-code
     8470                   " Дата " input frame Dialog-Frame varshift-date " Номер смены " input frame Dialog-Frame varshift-name " ."
     8471           view-as alert-box error.
     8472         end.
     8473         display varshift-name with frame Dialog-Frame.
     8474         run proc-sht no-error.
     8475         if error-status:error then do: return error. end.
     8476       end.
     8477       else do:
     8478         assign frame Dialog-Frame
     8479           varshift-name.
     8480         assign
     8481           bf_trn-doc.shift-date = varshift-date-mem
     8482           bf_trn-doc.shift-num  = varshift-num-mem
     8483           varshift-date = varshift-date-mem
     8484           varshift-num = varshift-num-mem.
     8485         display bf_trn-doc.shift-date @ varshift-date
     8486                 bf_trn-doc.shift-num  @ varshift-num
     8487                 varshift-name with frame Dialog-Frame.
     8488         if bf_trn-doc.fact-date = ? then do:
     8489           assign bf_trn-doc.fact-date = bf_trn-doc.shift-date
     8490                  bf_trn-doc.fact-time = (24 * 60 * 60).
     8491           display bf_trn-doc.fact-date @ varfact-date with frame Dialog-Frame.
     8492          end.
     8493       end.
     8494     end.
     8495   END PROCEDURE.
     8496   PROCEDURE proc-shift-num :
     8497   define buffer bf_shift-obj   for ub.shift-obj.
     8498     define buffer bf_shift-staff for ub.shift-staff.
     8499     if input frame Dialog-Frame varshift-date <> ? then do:
     8500       find first bf_shift-obj where bf_shift-obj.obj-type   = bf_trn-doc.obj-type                     and
     8501                                     bf_shift-obj.obj-code   = bf_trn-doc.obj-code                     and
     8502                                     bf_shift-obj.shift-date = input frame Dialog-Frame varshift-date AND
     8503                                     bf_shift-obj.shift-num  = input frame Dialog-Frame varshift-num  no-lock no-error.
     8504       if not available bf_shift-obj then do:
     8505         message "Не найдена смена на объекте: " bf_trn-doc.obj-type " " bf_trn-doc.obj-code
     8506                 " Дата " input frame Dialog-Frame varshift-date " Порядок смены " varshift-num " ."
     8507         view-as alert-box error.
     8508         display varshift-num with frame Dialog-Frame.
     8509         run proc-sht in this-procedure no-error.
     8510         if error-status:error then do:
     8511           return error.
     8512         end.
     8513       end.
     8514       else do:
     8515         assign
     8516           bf_trn-doc.shift-date = bf_shift-obj.shift-date
     8517           bf_trn-doc.shift-num  = bf_shift-obj.shift-num
     8518           varshift-name    = bf_shift-obj.shift-name
     8519           varshift-date = bf_shift-obj.shift-date.
     8520         display bf_trn-doc.shift-date @ varshift-date
     8521                 bf_trn-doc.shift-num  @ varshift-num
     8522                 varshift-name with frame Dialog-Frame.
     8523         if bf_trn-doc.fact-date = ? then do:
     8524           assign
     8525             bf_trn-doc.fact-date = bf_trn-doc.shift-date
     8526             bf_trn-doc.fact-time = (24 * 60 * 60).
     8527           display bf_trn-doc.fact-date @ varfact-date with frame Dialog-Frame.
     8528         end.
     8529       end.
     8530     end.
     8531   END PROCEDURE.
     8532   PROCEDURE proc-sht :
     8533   define buffer bf_shift-obj   for ub.shift-obj.
     8534     define buffer bf_shift-staff for ub.shift-staff.
     8535     define variable varrid-list as character no-undo.
     8536     define variable varrecid    as recid     no-undo.
     8537     assign
     8538       varrid-list = "".
     8539     run str/sht-all.w (INPUT parparentproc,
     8540                    INPUT bf_trn-doc.obj-type,
     8541                    INPUT bf_trn-doc.obj-code,
     8542                    INPUT 'b-sel',
     8543                    INPUT 'obj',
     8544                    INPUT bf_trn-doc.obj-type,
     8545                    INPUT bf_trn-doc.obj-code,
     8546                    INPUT '':u,
     8547                    input-output varrid-list)
     8548     no-error.
     8549     if error-status:error or varrid-list = "":u then do:
     8550       return error.
     8551     end.
     8552     else do:
     8553       assign
     8554         varrecid = integer (entry(1, varrid-list)).
     8555       find first bf_shift-obj where recid(bf_shift-obj) = varrecid no-lock no-error.
     8556       if available bf_shift-obj then do:
     8557         assign
     8558           bf_trn-doc.shift-date = bf_shift-obj.shift-date
     8559           bf_trn-doc.shift-num  = bf_shift-obj.shift-num
     8560           varshift-name    = bf_shift-obj.shift-name
     8561           varshift-date = bf_shift-obj.shift-date
     8562           varshift-num = bf_shift-obj.shift-num.
     8563         display bf_trn-doc.shift-date @ varshift-date
     8564                 bf_trn-doc.shift-num  @ varshift-num
     8565                 varshift-name with frame Dialog-Frame.
     8566           assign
     8567             bf_trn-doc.fact-date = bf_trn-doc.shift-date
     8568             bf_trn-doc.fact-time = (24 * 60 * 60).
     8569           display bf_trn-doc.fact-date @ varfact-date with frame Dialog-Frame.
     8570       end.
     8571     end.
     8572   END PROCEDURE.
     8573   PROCEDURE recalc-line :
     8574   DEFINE BUFFER bf-recalc_doc-line FOR ub.doc-line.
     8575   DEFINE BUFFER bf-recalc_parts    FOR ub.parts.
     8576   DEFINE VARIABLE varsum-base  LIKE ub.parts.price-base.
     8577   DEFINE VARIABLE varsum-rubl  LIKE ub.parts.price-rubl.
     8578   DEFINE VARIABLE varfact-qnty LIKE ub.parts.fact-qnty.
     8579   DO ON ERROR UNDO, RETURN ERROR RETURN-VALUE :
     8580   FOR EACH tt-recalc-line ON ERROR UNDO, RETURN ERROR RETURN-VALUE :
     8581     FIND FIRST bf-recalc_doc-line WHERE bf-recalc_doc-line.doc-code  = tt-recalc-line.doc-code  AND
     8582                                         bf-recalc_doc-line.artic     = tt-recalc-line.artic     AND
     8583                                         bf-recalc_doc-line.prod-type = tt-recalc-line.prod-type AND
     8584                                         bf-recalc_doc-line.prod-code = tt-recalc-line.prod-code EXCLUSIVE-LOCK.
     8585     assign
     8586       varsum-base  = 0.00
     8587       varsum-rubl  = 0.00
     8588       varfact-qnty = 0.00
     8589     .
     8590     FOR EACH bf-recalc_parts WHERE bf-recalc_parts.out-code  = bf-recalc_doc-line.doc-code  AND
     8591                                    bf-recalc_parts.obj-type  = bf-recalc_doc-line.obj-type  AND
     8592                                    bf-recalc_parts.obj-code  = bf-recalc_doc-line.obj-code  AND
     8593                                    bf-recalc_parts.artic     = bf-recalc_doc-line.artic     AND
     8594                                    bf-recalc_parts.prod-type = bf-recalc_doc-line.prod-type AND
     8595                                    bf-recalc_parts.prod-code = bf-recalc_doc-line.prod-code ON ERROR UNDO, RETURN ERROR RETURN-VALUE :
     8596       ASSIGN
     8597         varsum-base  = varsum-base  + bf-recalc_parts.price-base * bf-recalc_parts.fact-qnty
     8598         varsum-rubl  = varsum-rubl  + bf-recalc_parts.price-rubl * bf-recalc_parts.fact-qnty
     8599         varfact-qnty = varfact-qnty + bf-recalc_parts.fact-qnty.
     8600     END.
     8601     ASSIGN
     8602       bf-recalc_doc-line.price-base = varsum-base / varfact-qnty
     8603       bf-recalc_doc-line.price-rubl = varsum-rubl / varfact-qnty.
     8604   END.
     8605   END.
     8606   END PROCEDURE.
     8607   PROCEDURE rsrv-gds-dtl :
     8608   DEFINE INPUT PARAMETER pardoc-code  LIKE ub.doc-line.doc-code  NO-UNDO.
     8609   DEFINE INPUT PARAMETER parartic     LIKE ub.doc-line.artic     NO-UNDO.
     8610   DEFINE INPUT PARAMETER parprod-type LIKE ub.doc-line.prod-type NO-UNDO.
     8611   DEFINE INPUT PARAMETER parprod-code LIKE ub.doc-line.prod-code NO-UNDO.
     8612   DEFINE INPUT PARAMETER paravaiparts AS   LOGICAL               NO-UNDO.
     8613   DEFINE INPUT PARAMETER parrsrv-qnty AS   DECIMAL               NO-UNDO.
     8614   DEFINE BUFFER bf-del_doc-line     FOR ub.doc-line.
     8615   DEFINE BUFFER bf-del_goods        FOR ub.goods.
     8616   DEFINE BUFFER bf-del_gds-dtl      FOR ub.gds-dtl.
     8617   define buffer bf-del-next_gds-dtl for ub.gds-dtl.
     8618   define variable varrsrv-qnty-gds-dtl as decimal no-undo.
     8619   define variable vargds-dtl-doc-qnty  as decimal no-undo.
     8620   do on error undo, return error return-value :
     8621   FIND FIRST bf-del_doc-line WHERE bf-del_doc-line.doc-code  = pardoc-code  AND
     8622                                    bf-del_doc-line.artic     = parartic     AND
     8623                                    bf-del_doc-line.prod-type = parprod-type AND
     8624                                    bf-del_doc-line.prod-code = parprod-code EXCLUSIVE-LOCK.
     8625   FIND FIRST bf-del_goods WHERE bf-del_goods.artic     = bf-del_doc-line.artic     AND
     8626                                 bf-del_goods.prod-type = bf-del_doc-line.prod-type AND
     8627                                 bf-del_goods.prod-code = bf-del_doc-line.prod-code NO-LOCK.
     8628     if bf-del_doc-line.fact-qnty = 0    and
     8629        not paravaiparts then do:
     8630     end.
     8631     else do:
     8632       assign
     8633         varrsrv-qnty-gds-dtl = 0.00.
     8634       cycle-gds-dtl:
     8635       for each bf-del_gds-dtl where bf-del_gds-dtl.doc-code  = bf_trn-doc.doc-code    and
     8636                                     bf-del_gds-dtl.artic     = bf-del_goods.artic     and
     8637                                     bf-del_gds-dtl.prod-type = bf-del_goods.prod-type and
     8638                                     bf-del_gds-dtl.prod-code = bf-del_goods.prod-code
     8639                                     exclusive-lock
     8640                                     break by bf-del_gds-dtl.doc-qnty descending
     8641                                     on error undo, return error return-value :
     8642         if bf-del_gds-dtl.doc-qnty < 0 then do:
     8643           if - bf-del_gds-dtl.doc-qnty >= (parrsrv-qnty - varrsrv-qnty-gds-dtl) then do:
     8644             assign
     8645               bf-del_gds-dtl.doc-qnty  = bf-del_gds-dtl.doc-qnty + (parrsrv-qnty - varrsrv-qnty-gds-dtl)
     8646             .
     8647             leave cycle-gds-dtl.
     8648           end.
     8649           else do:
     8650             assign
     8651               varrsrv-qnty-gds-dtl = varrsrv-qnty-gds-dtl + (- bf-del_gds-dtl.doc-qnty)
     8652               bf-del_gds-dtl.doc-qnty  = 0
     8653               .
     8654           end.
     8655         end.
     8656         else do:
     8657           assign
     8658             bf-del_gds-dtl.doc-qnty  = bf-del_gds-dtl.doc-qnty + (parrsrv-qnty - varrsrv-qnty-gds-dtl)
     8659           .
     8660           leave cycle-gds-dtl.
     8661         end.
     8662       end.
     8663       assign
     8664         vargds-dtl-doc-qnty  = 0.00.
     8665       for each bf-del_gds-dtl where bf-del_gds-dtl.doc-code  = bf_trn-doc.doc-code    and
     8666                                     bf-del_gds-dtl.artic     = bf-del_goods.artic     and
     8667                                     bf-del_gds-dtl.prod-type = bf-del_goods.prod-type and
     8668                                     bf-del_gds-dtl.prod-code = bf-del_goods.prod-code on error undo, return error return-value :
     8669         assign
     8670           vargds-dtl-doc-qnty  = vargds-dtl-doc-qnty  + bf-del_gds-dtl.doc-qnty.
     8671       end.
     8672       if bf-del_doc-line.fact-qnty <> vargds-dtl-doc-qnty then do:
     8673          undo, return error substitute ("Ошибочно произведено разрезервирование по признакам для товара списания. Товар &1 &2 &3 &4. Количество по строке &5. Количество по признакам &6.",
     8674                                         bf-del_goods.artic,
     8675                                         bf-del_goods.prod-type,
     8676                                         bf-del_goods.prod-code,
     8677                                         bf-del_goods.gds-name,
     8678                                         bf-del_doc-line.fact-qnty,
     8679                                         vargds-dtl-doc-qnty).
     8680       end.
     8681       FIND FIRST bf-del_gds-dtl WHERE bf-del_gds-dtl.doc-code  = bf-del_doc-line.doc-code  AND
     8682                                       bf-del_gds-dtl.artic     = bf-del_doc-line.artic     AND
     8683                                       bf-del_gds-dtl.prod-type = bf-del_doc-line.prod-type AND
     8684                                       bf-del_gds-dtl.prod-code = bf-del_doc-line.prod-code AND
     8685                                       bf-del_gds-dtl.doc-qnty  <> 0                        NO-ERROR.
     8686       IF AVAILABLE bf-del_gds-dtl THEN DO:
     8687         FOR EACH bf-del_gds-dtl WHERE bf-del_gds-dtl.doc-code  = bf-del_doc-line.doc-code  AND
     8688                                       bf-del_gds-dtl.artic     = bf-del_doc-line.artic     AND
     8689                                       bf-del_gds-dtl.prod-type = bf-del_doc-line.prod-type AND
     8690                                       bf-del_gds-dtl.prod-code = bf-del_doc-line.prod-code AND
     8691                                       bf-del_gds-dtl.doc-qnty = 0                         ON ERROR UNDO, RETURN ERROR RETURN-VALUE :
     8692           DELETE bf-del_gds-dtl.
     8693         END.
     8694       END.
     8695     end.
     8696   end.
     8697   END PROCEDURE.
     8698   PROCEDURE rsrv-gds-dtl-plus :
     8699   define input parameter pardoc-code  like ub.doc-line.doc-code  no-undo.
     8700   define input parameter parartic     like ub.doc-line.artic     no-undo.
     8701   define input parameter parprod-type like ub.doc-line.prod-type no-undo.
     8702   define input parameter parprod-code like ub.doc-line.prod-code no-undo.
     8703   define input parameter paravaiparts as   logical               no-undo.
     8704   define input parameter parrsrv-qnty as   decimal               no-undo.
     8705   define variable varrsrv-qnty-gds-dtl-plus as decimal            no-undo.
     8706   define buffer bf-del-plus_doc-line for ub.doc-line.
     8707   define buffer bf-del-plus_gds-dtl      for ub.gds-dtl.
     8708   define buffer bf-del-next-plus_gds-dtl for ub.gds-dtl.
     8709   do on error undo, return error return-value :
     8710   find first bf-del-plus_doc-line where bf-del-plus_doc-line.doc-code  = pardoc-code  and
     8711                                         bf-del-plus_doc-line.artic     = parartic     and
     8712                                         bf-del-plus_doc-line.prod-type = parprod-type and
     8713                                         bf-del-plus_doc-line.prod-code = parprod-code exclusive-lock.
     8714   assign
     8715     varrsrv-qnty-gds-dtl-plus = 0.00.
     8716   cycle-gds-dtl-plus:
     8717   for each bf-del-plus_gds-dtl where bf-del-plus_gds-dtl.doc-code  = pardoc-code         and
     8718                                      bf-del-plus_gds-dtl.artic     = parartic     and
     8719                                      bf-del-plus_gds-dtl.prod-type = parprod-type and
     8720                                      bf-del-plus_gds-dtl.prod-code = parprod-code
     8721                                      exclusive-lock
     8722                                      break by bf-del-plus_gds-dtl.doc-qnty descending
     8723                                      on error undo, return error return-value :
     8724     if bf-del-plus_gds-dtl.doc-qnty > 0 then do:
     8725       if bf-del-plus_gds-dtl.doc-qnty >= (parrsrv-qnty - varrsrv-qnty-gds-dtl-plus) then do:
     8726         assign
     8727           bf-del-plus_gds-dtl.doc-qnty = bf-del-plus_gds-dtl.doc-qnty - (parrsrv-qnty - varrsrv-qnty-gds-dtl-plus).
     8728         leave cycle-gds-dtl-plus.
     8729       end.
     8730       else do:
     8731         assign
     8732           varrsrv-qnty-gds-dtl-plus = varrsrv-qnty-gds-dtl-plus + bf-del-plus_gds-dtl.doc-qnty.
     8733         assign
     8734           bf-del-plus_gds-dtl.doc-qnty  = 0.00
     8735         .
     8736       end.
     8737     end.
     8738     else do:
     8739       assign
     8740         bf-del-plus_gds-dtl.doc-qnty = bf-del-plus_gds-dtl.doc-qnty - (parrsrv-qnty - varrsrv-qnty-gds-dtl-plus).
     8741       leave cycle-gds-dtl-plus.
     8742     end.
     8743   end.
     8744   if bf-del-plus_doc-line.fact-qnty = 0    and
     8745      not paravaiparts then do:
     8746     run local-recalc in this-procedure (input "delete":u,
     8747                                         input recid(bf-del-plus_doc-line),
     8748                                         input no) no-error.
     8749     if error-status:error then do:
     8750       undo, return error substitute ("Ошибка при пересчете строки документа: &1", return-value).
     8751     end.
     8752     run local-line-delete in this-procedure (input recid(bf-del-plus_doc-line)) no-error.
     8753     if error-status:error then do:
     8754       undo, return error substitute ("Ошибка при удалении строки документа. Оприходованный товар: &1 &2 &3.", bf-del-plus_doc-line.artic, bf-del-plus_doc-line.prod-type, bf-del-plus_doc-line.prod-code).
     8755     end.
     8756   end.
     8757   else do:
     8758     run local-recalc in this-procedure (input "update":u,
     8759                                         input recid(bf-del-plus_doc-line),
     8760                                         input no) no-error.
     8761     if error-status:error then do:
     8762       undo, return error substitute ("Ошибка при пересчете строки документа по оприходованным товарам: &1", return-value).
     8763     end.
     8764     find first bf-del-plus_gds-dtl where bf-del-plus_gds-dtl.doc-code  = bf-del-plus_doc-line.doc-code  and
     8765                                          bf-del-plus_gds-dtl.artic     = bf-del-plus_doc-line.artic     and
     8766                                          bf-del-plus_gds-dtl.prod-type = bf-del-plus_doc-line.prod-type and
     8767                                          bf-del-plus_gds-dtl.prod-code = bf-del-plus_doc-line.prod-code and
     8768                                          bf-del-plus_gds-dtl.doc-qnty <> 0                              no-error.
     8769     if available bf-del-plus_gds-dtl then do:
     8770       for each bf-del-plus_gds-dtl where bf-del-plus_gds-dtl.doc-code  = bf-del-plus_doc-line.doc-code  and
     8771                                          bf-del-plus_gds-dtl.artic     = bf-del-plus_doc-line.artic     and
     8772                                          bf-del-plus_gds-dtl.prod-type = bf-del-plus_doc-line.prod-type and
     8773                                          bf-del-plus_gds-dtl.prod-code = bf-del-plus_doc-line.prod-code and
     8774                                          bf-del-plus_gds-dtl.doc-qnty  = 0                              on error undo, return error return-value :
     8775         delete bf-del-plus_gds-dtl.
     8776       end.
     8777     end.
     8778   end.
     8779   end.
     8780   end procedure.
     8781   PROCEDURE select-reason :
     8782     define variable j-rsn-code like ub.trn-reason.reason-code no-undo.
     8783     define buffer bf_trn-reason for ub.trn-reason.
     8784     do on error undo, return error return-value :
     8785       assign
     8786         j-rsn-code = ( input frame Dialog-Frame varreason-code )
     8787       .
     8788       run str/trn-reas.w ( input ParParentProc, input 'выбор':U, input-output j-rsn-code ).
     8789       find first bf_trn-reason no-lock where
     8790                  bf_trn-reason.reason-code = j-rsn-code no-error.
     8791       if available bf_trn-reason then do:
     8792         assign
     8793           varreason-name    = bf_trn-reason.reason-name
     8794           bf_trn-doc.reason-code = bf_trn-reason.reason-code
     8795           varreason-code    = bf_trn-reason.reason-code
     8796         .
     8797         display varreason-code
     8798                 varreason-name
     8799         with frame Dialog-Frame.
     8800       end.
     8801     end.
     8802   END PROCEDURE.
     8803   PROCEDURE ui-on :
     8804   define input parameter fnc as character no-undo.
     8805   define buffer bf_contract for ub.contract.
     8806   define buffer bf_clients  for ub.clients.
     8807   define variable varhave-shift     as logical   no-undo.
     8808   define variable varadd-back-date  as logical   no-undo.
     8809   do on error undo, return error return-value :
     8810     for each tt-del-list on error undo, return error return-value :
     8811       delete tt-del-list.
     8812     end.
     8813     case pardoc-mode :
     8814       when 'ПРОСМОТР':U then do:
     8815           if parext-doc-mode = "reason-code" then do:
     8816             enable r-reas with frame Dialog-Frame.
     8817           end.
     8818       end.
     8819       otherwise do:
     8820         enable b-mark b-add b-chg b-del
     8821                varwrkr varagnt varboss
     8822                r-wrkr r-agnt r-boss
     8823                r-reas
     8824         with frame Dialog-Frame.
     8825   define variable vss-include-info63 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8826   do:
     8827     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8828       (input  v-cntxt-db-num
     8829       ,input  v-cntxt-userid
     8830       ,input  0
     8831       ,input  'actn_tdedt-peresort_add-back-date':u
     8832       ,input  'object':U
     8833       ,input  bf_trn-doc.host-code
     8834       ,input  bf_trn-doc.obj-type
     8835       ,input  bf_trn-doc.obj-code
     8836       ,input  0
     8837       ,input  0
     8838       ,input  0
     8839       ,input  false
     8840       ,output varadd-back-date
     8841       )  .
     8842   end.
     8843         if varadd-back-date then do:
     8844           enable varfact-date with frame Dialog-Frame.
     8845         end.
     8846   define variable vss-include-info64 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8847   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     8848     (input  bf_trn-doc.obj-type
     8849     ,input  bf_trn-doc.obj-code
     8850     ,input  'shift-on=request'
     8851     ,output varhave-shift
     8852     ) no-error .
     8853         if error-status :error then do:
     8854           message
     8855           vss-workfile vss-revision vss-description skip
     8856           "Ошибка при запуске процедуры objat" skip
     8857           return-value skip
     8858           view-as alert-box error .
     8859           return error.
     8860         end.
     8861         if not varhave-shift then do:
     8862          hide varshift-date varshift-num varshift-name r-sht in frame Dialog-Frame.
     8863         end.
     8864         ELSE DO:
     8865           if varadd-back-date then do:
     8866             ENABLE varshift-date varshift-num varshift-name r-sht WITH frame Dialog-Frame.
     8867           end.
     8868         END.
     8869       end.
     8870     end case.
     8871     if not parold-supp-cntr then do:
     8872       if bf_trn-doc.contract-code <> 0 then do:
     8873         find first bf_contract where bf_contract.host-code     = bf_trn-doc.host-code     and
     8874                                      bf_contract.contract-code = bf_trn-doc.contract-code no-lock.
     8875         assign
     8876           varcontract-prn-code = bf_contract.contract-prn-code
     8877           varcontract-name     = bf_contract.contract-name
     8878          .
     8879       end.
     8880       assign
     8881         vardoc-date  = bf_trn-doc.doc-date
     8882         varfact-date = bf_trn-doc.fact-date
     8883         varcli-type  = bf_trn-doc.cli-type
     8884         varcli-code  = bf_trn-doc.cli-code
     8885         varcli-name  = bf_trn-doc.cli-name .
     8886       display vardoc-date
     8887               varfact-date
     8888               varcli-type
     8889               varcli-code
     8890               varcli-name
     8891               varcontract-prn-code
     8892               varcontract-name
     8893       with frame Dialog-Frame.
     8894     end.
     8895     else do:
     8896       display varinformation with frame Dialog-Frame.
     8897     end.
     8898     IF varhave-shift THEN DO:
     8899       if bf_trn-doc.shift-date <> ? then do:
     8900         assign
     8901           varshift-date = bf_trn-doc.shift-date
     8902           varshift-num  = bf_trn-doc.shift-num
     8903           varshift-name = bf_trn-doc.shift-name
     8904         .
     8905         display varshift-date varshift-num  varshift-name  with frame Dialog-Frame.
     8906       end.
     8907     end.
     8908     assign
     8909       varfact-date = bf_trn-doc.fact-date.
     8910     display varfact-date with frame Dialog-Frame.
     8911     assign
     8912       frame Dialog-Frame :title = bf_trn-doc.obj-type + " " + string( bf_trn-doc.obj-code, ">>>>9":U ) + "  : ПЕРЕСОРТИЦА " +
     8913       bf_trn-doc.status_ + " " + string( bf_trn-doc.flag_, "+/-":U ) + " № " + bf_trn-doc.doc-code + "   - " + pardoc-mode.
     8914     ASSIGN
     8915       varwrkr = bf_trn-doc.wrkr
     8916       varagnt = bf_trn-doc.agnt
     8917       varboss = bf_trn-doc.boss
     8918      .
     8919     display varwrkr varagnt varboss with frame Dialog-Frame.
     8920     find first bf_clients where bf_clients.obj-type = 'чел':U  and
     8921                                 bf_clients.obj-code = varwrkr no-lock no-error.
     8922     if available bf_clients then do:
     8923       display bf_clients.obj-name @ varwrkr-name with frame Dialog-Frame.
     8924     end.
     8925     find first bf_clients where bf_clients.obj-type = 'чел':U  and
     8926                                 bf_clients.obj-code = varagnt no-lock no-error.
     8927     if available bf_clients then do:
     8928       display bf_clients.obj-name @ varagnt-name with frame Dialog-Frame.
     8929     end.
     8930     find first bf_clients where bf_clients.obj-type = 'чел':U  and
     8931                                 bf_clients.obj-code = varboss no-lock no-error.
     8932     if available bf_clients then do:
     8933       display bf_clients.obj-name @ varboss-name with frame Dialog-Frame.
     8934     end.
     8935     define buffer bf_trn-reason for ub.trn-reason  .
     8936     find bf_trn-reason no-lock where
     8937          bf_trn-reason.reason-code = bf_trn-doc.reason-code no-error.
     8938     assign
     8939       varreason-name = ( if available bf_trn-reason then bf_trn-reason.reason-name else "":U )
     8940       varreason-code  = bf_trn-doc.reason-code
     8941     .
     8942     display
     8943     varreason-name
     8944     varreason-code
     8945     with frame Dialog-Frame .
     8946     OPEN QUERY b-goods- FOR EACH bf_doc-line WHERE bf_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,           FIRST bf_goods WHERE bf_goods.artic     = bf_doc-line.artic     AND                          bf_goods.prod-type = bf_doc-line.prod-type AND                          bf_goods.prod-code = bf_doc-line.prod-code NO-LOCK,           FIRST bf_parts WHERE bf_parts.out-code  = bf_doc-line.doc-code  AND                          bf_parts.obj-type  = bf_doc-line.obj-type  AND                          bf_parts.obj-code  = bf_doc-line.obj-code  AND                          bf_parts.artic     = bf_doc-line.artic     AND                          bf_parts.prod-type = bf_doc-line.prod-type AND                          bf_parts.prod-code = bf_doc-line.prod-code AND                          bf_parts.fact-qnty < 0 NO-LOCK.
     8947     OPEN QUERY b-goods FOR EACH bf-plus_doc-line WHERE bf-plus_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,            FIRST bf-plus_goods WHERE bf-plus_goods.artic     = bf-plus_doc-line.artic     AND                               bf-plus_goods.prod-type = bf-plus_doc-line.prod-type AND                               bf-plus_goods.prod-code = bf-plus_doc-line.prod-code NO-LOCK,            FIRST bf_parts-root WHERE bf_parts-root.doc-code      = bf-plus_doc-line.doc-code AND                               bf_parts-root.gds-code      = bf-plus_goods.gds-code    AND                               bf_parts-root.orig-gds-code = bf_goods.gds-code   NO-LOCK.
     8948   end.
     8949   END PROCEDURE.
