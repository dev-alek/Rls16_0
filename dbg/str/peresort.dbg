     3415       define variable varsum-base-factovp      like ub.gds-dtl.price-base               no-undo.
     3416       define variable varslt-base-factovp      like ub.gds-dtl.price-base               no-undo.
     3417       define variable varvat-base-factovp      like ub.gds-dtl.price-base               no-undo.
     3418       define variable varvatcons-base-factovp  like ub.gds-dtl.price-base               no-undo.
     3419       define variable vardsc-base-factovp      like ub.gds-dtl.price-base               no-undo.
     3420       define variable varsum-base-docovp       like ub.gds-dtl.price-base               no-undo.
     3421       define variable varslt-base-docovp       like ub.gds-dtl.price-base               no-undo.
     3422       define variable varvat-base-docovp       like ub.gds-dtl.price-base               no-undo.
     3423       define variable varvatcons-base-docovp   like ub.gds-dtl.price-base               no-undo.
     3424       define variable vardsc-base-docovp       like ub.gds-dtl.price-base               no-undo.
     3425       define variable varsum-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     3426       define variable varslt-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     3427       define variable varvat-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     3428       define variable varvatcons-rubl-factovp  like ub.gds-dtl.price-base               no-undo.
     3429       define variable vardsc-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     3430       define variable varsum-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     3431       define variable varslt-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     3432       define variable varvat-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     3433       define variable varvatcons-rubl-docovp   like ub.gds-dtl.price-base               no-undo.
     3434       define variable vardsc-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     3435       define variable varfact-qnty             like ub.parts.fact-qnty                  no-undo.
     3436       define variable varcons-qnty             like ub.parts.fact-qnty                  no-undo.
     3437       define variable varis-one-gds-dtl        as   logical                             no-undo.
     3438       define variable varcurprice-base         like ub.gds-dtl.cur-base                 no-undo.
     3439       define variable varcurprice-rubl         like ub.gds-dtl.price-base               no-undo.
     3440       define variable varcurdiscnt-base        like ub.gds-dtl.cur-base                 no-undo.
     3441       define variable varcurdiscnt-rubl        like ub.gds-dtl.price-base               no-undo.
     3442       define variable varoutvprb               as   character                           no-undo.
     3443       define variable out-vatp-have-vat-slt    as   logical initial yes                 no-undo.
     3444       define buffer   in-vatp-trn-doco  for ub.trn-doc .
     3445       define buffer   in-vatp-partso    for ub.parts   .
     3446       define buffer   in-vatp-doco      for ub.trn-doc .
     3447       define buffer   in-vatp-goodso    for ub.goods   .
     3448       define buffer   in-vatp-sysconfo  for ub.sysconf .
     3449       define buffer   in-vatp_doc-attro for ub.doc-attr.
     3450       define variable in-vatp-have-vat-slto       as   logical initial yes    no-undo.
     3451       define variable vat-pc-loco                 like ub.doc-line.vat-pc     no-undo.
     3452       define variable varinvprbo                  as   character              no-undo.
     3453       define variable slt-pc-loco                 like ub.doc-line.slt-pc     no-undo.
     3454       define variable cli-base-rateo              as   decimal                no-undo.
     3455       define variable price-rubl-with-tax-loco    like ub.doc-line.price-rubl no-undo.
     3456       define variable price-base-with-tax-loco    like ub.doc-line.price-base no-undo.
     3457       define variable price-cli-with-tax-loco     like ub.doc-line.price-cli  no-undo.
     3458       define variable price-rubl-without-tax-loco like ub.doc-line.price-rubl no-undo.
     3459       define variable price-base-without-tax-loco like ub.doc-line.price-base no-undo.
     3460       define variable price-cli-without-tax-loco  like ub.doc-line.price-base no-undo.
     3461       define variable vat-base-loco               like ub.doc-line.price-base no-undo.
     3462       define variable vat-rubl-loco               like ub.doc-line.price-rubl no-undo.
     3463       define variable vat-cli-loco                like ub.doc-line.price-rubl no-undo.
     3464       define variable slt-base-loco               like ub.doc-line.price-base no-undo.
     3465       define variable slt-rubl-loco               like ub.doc-line.price-rubl no-undo.
     3466       define variable slt-cli-loco                like ub.doc-line.price-rubl no-undo.
     3467       define variable road-tax-base-loco          like ub.doc-line.road-tax   no-undo.
     3468       define variable road-tax-rubl-loco          like ub.doc-line.road-tax   no-undo.
     3469       define variable road-tax-cli-loco           like ub.doc-line.road-tax   no-undo.
     3470       define variable transport-base-loco         like ub.doc-line.price-base no-undo.
     3471       define variable transport-rubl-loco         like ub.doc-line.price-rubl no-undo.
     3472       define variable transport-cli-loco          like ub.doc-line.price-rubl no-undo.
     3473       define variable other-base-loco             like ub.doc-line.price-base no-undo.
     3474       define variable other-rubl-loco             like ub.doc-line.price-rubl no-undo.
     3475       define variable other-cli-loco              like ub.doc-line.price-rubl no-undo.
     3476       define variable exch-rate-cli-loco          like ub.trn-doc.exch-rate   no-undo.
     3477       define variable varinvatp-envdo             as   character              no-undo.
     3478       define variable varinvatp-typeo             as   character              no-undo.
     3479     do
     3480     on error undo, return error return-value
     3481     :
     3482       find first buf_trn-doc no-lock
     3483         where buf_trn-doc.doc-code = p-doc-code
     3484       no-error .
     3485       if not available buf_trn-doc
     3486       then do:
     3487         message
     3488           vss-workfile vss-revision vss-description skip
     3489           vss-include-info18 skip
     3490           "Ошибка задания входных параметров" skip
     3491           "Не найден документ" skip
     3492           "Документ" p-doc-code skip
     3493           "Артикул" p-artic p-prod-type p-prod-code skip
     3494           view-as alert-box error .
     3495         undo, return error .
     3496       end.
     3497       find first buf_doc-line no-lock
     3498         where buf_doc-line.doc-code  = p-doc-code
     3499           and buf_doc-line.artic     = p-artic
     3500           and buf_doc-line.prod-type = p-prod-type
     3501           and buf_doc-line.prod-code = p-prod-code
     3502         no-error .
     3503       if not available buf_doc-line
     3504       then do:
     3505         message
     3506           vss-workfile vss-revision vss-description skip
     3507           vss-include-info18 skip
     3508           "Ошибка задания входных параметров" skip
     3509           "Не найдена строка документа" skip
     3510           "Документ" p-doc-code skip
     3511           "Артикул" p-artic p-prod-type p-prod-code skip
     3512           view-as alert-box error .
     3513         undo, return error .
     3514       end.
