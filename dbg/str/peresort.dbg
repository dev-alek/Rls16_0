      538   do on error undo, return error return-value :
      539   find first cl_tt-clcparts where recid(cl_tt-clcparts) = parrec-parts no-lock.
      540   for each bf_tt-allsum on error undo, return error return-value :
      541     delete bf_tt-allsum.
      542   end.
      543   assign
      544     price-rubl-with-tax-loccl = cl_tt-clcparts.price-rubl
      545     price-base-with-tax-loccl = cl_tt-clcparts.price-base
      546   .
      547   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      548   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      549     (output varinvprbcl
      550     )  .
      551     if cl_tt-clcparts.out-code = 'free-zone':U     or
      552        cl_tt-clcparts.out-code = 'out-zone':U   or
      553        cl_tt-clcparts.doc-type = 'акт':U then do:
      554       assign
      555         in-vatp-have-vat-sltcl = yes.
      556     end.
      557     else do:
      558       find first in-vatp_doc-attrcl no-lock
      559         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
      560           and in-vatp_doc-attrcl.attr-code = 'envd':U
      561         no-error .
      562       if not available in-vatp_doc-attrcl then do:
      563         assign
      564           in-vatp-have-vat-sltcl = yes.
      565       end.
      566       else do:
      567            in-vatp-have-vat-sltcl = no.
      568       end.
      569     end.
      570     assign
      571      price-cli-with-tax-loccl = cl_tt-clcparts.price-cli
      572      cli-base-ratecl          = cl_tt-clcparts.cli-base-rate.
      573     ASSIGN   road-tax-base-loccl  = (if cl_tt-clcparts.road-tax-base  = ? then 0 else cl_tt-clcparts.road-tax-base)
      574              road-tax-rubl-loccl  = (if cl_tt-clcparts.road-tax-rubl  = ? then 0 else cl_tt-clcparts.road-tax-rubl).
      575     ASSIGN  transport-base-loccl = (if cl_tt-clcparts.transport-base = ? then 0 else cl_tt-clcparts.transport-base)
      576             transport-rubl-loccl = (if cl_tt-clcparts.transport-rubl = ? then 0 else cl_tt-clcparts.transport-rubl)
      577             other-base-loccl     = (if cl_tt-clcparts.other-base     = ? then 0 else cl_tt-clcparts.other-base)
      578             other-rubl-loccl     = (if cl_tt-clcparts.other-rubl     = ? then 0 else cl_tt-clcparts.other-rubl)
      579             vat-pc-loccl         = (if cl_tt-clcparts.vat-pc         = ? then 0 else cl_tt-clcparts.vat-pc)
      580             slt-pc-loccl         = (if cl_tt-clcparts.slt-pc         = ? then 0 else cl_tt-clcparts.slt-pc).
      581             ASSIGN   slt-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
      582       ASSIGN   slt-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
      583     assign
      584       exch-rate-cli-loccl = (cl_tt-clcparts.price-rubl - transport-rubl-loccl - other-rubl-loccl - road-tax-rubl-loccl - (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-rubl-loccl else 0) - (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-rubl-loccl else 0)) / cl_tt-clcparts.price-cli .
      585     assign
      586       slt-cli-loccl        = slt-rubl-loccl       / exch-rate-cli-loccl
      587       vat-cli-loccl        = vat-rubl-loccl       / exch-rate-cli-loccl
      588       road-tax-cli-loccl   = road-tax-rubl-loccl  / exch-rate-cli-loccl
      589       transport-cli-loccl  = 0
      590       other-cli-loccl      = 0
      591     .
      592   ASSIGN
      593             price-base-without-tax-loccl = price-base-with-tax-loccl - vat-base-loccl - slt-base-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))
      594       price-rubl-without-tax-loccl = price-rubl-with-tax-loccl - vat-rubl-loccl - slt-rubl-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))
      595   .
      596   if paris-doc then do:
      597     assign
      598       parartic     = cl_tt-clcparts.artic
      599       parprod-type = cl_tt-clcparts.prod-type
      600       parprod-code = cl_tt-clcparts.prod-code
      601       pardoc-type  = cl_tt-clcparts.doc-type
      602       pardoc-code  = cl_tt-clcparts.out-code
      603       parobj-type  = cl_tt-clcparts.obj-type
      604       parobj-code  = cl_tt-clcparts.obj-code.
      605   if parext-doc-type = 'ot':U or
      606      parext-doc-type = ?                 then do:
      607     assign
      608      out-vatp-have-vat-sltcl = yes.
      609   end.
      610   else do:
      611     find first out-vatp_doc-attrcl no-lock
      612       where out-vatp_doc-attrcl.doc-code  = pardoc-code
      613         and out-vatp_doc-attrcl.attr-code = 'envd':U
      614         no-error .
      615     if not available out-vatp_doc-attrcl then do:
      616       assign
      617         out-vatp-have-vat-sltcl = yes.
      618     end.
      619     else do:
      620        out-vatp-have-vat-sltcl = no.
      621     end.
      622   end.
      623   find first out-vatp_goodscl where out-vatp_goodscl.artic     = parartic     and
      624                                      out-vatp_goodscl.prod-type = parprod-type and
      625                                      out-vatp_goodscl.prod-code = parprod-code no-lock.
      626   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      627   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
      628     (input  parartic
      629     ,input  parprod-type
      630     ,input  parprod-code
      631     ,output varroot-nodecl
      632     ) no-error .
      633   if error-status :error then do:
      634     message
      635       vss-workfile vss-revision vss-description skip
      636       "Ошибка при определении корневого признака товара" skip
      637       "Артикул" parartic parprod-type parprod-code skip
      638       error-status :get-message(1) skip
      639       return-value skip
      640       view-as alert-box error .
      641     undo, return error .
      642   end.
      643   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
      644     (input  varroot-nodecl
      645     ,input  'empty-scale=request'
      646     ,output varempty-scalecl
      647     ) no-error .
      648   if error-status :error then do:
      649     message
      650       vss-workfile vss-revision vss-description skip
      651       "Ошибка при определении атрибута признака" skip
      652       "Артикул" parartic parprod-type parprod-code skip
      653       "Признак" varroot-nodecl skip
      654       "Запрашивался атрибут" "empty-scale=request" skip
      655       error-status :get-message(1) skip
      656       return-value skip
      657       view-as alert-box error .
