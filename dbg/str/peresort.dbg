     1494       bfacc_tt-allsum.slt-rubl-acc        = bf_tt-allsum.slt-rubl-acc
     1495       bfacc_tt-allsum.slt-cli-acc         = bf_tt-allsum.slt-cli-acc
     1496       bfacc_tt-allsum.excise-base-acc     = bf_tt-allsum.excise-base-acc
     1497       bfacc_tt-allsum.excise-rubl-acc     = bf_tt-allsum.excise-rubl-acc
     1498       bfacc_tt-allsum.excise-cli-acc      = bf_tt-allsum.excise-cli-acc
     1499       bfacc_tt-allsum.road-tax-base-acc   = bf_tt-allsum.road-tax-base-acc
     1500       bfacc_tt-allsum.road-tax-rubl-acc   = bf_tt-allsum.road-tax-rubl-acc
     1501       bfacc_tt-allsum.road-tax-cli-acc    = bf_tt-allsum.road-tax-cli-acc
     1502       bfacc_tt-allsum.transport-base-acc  = bf_tt-allsum.transport-base-acc
     1503       bfacc_tt-allsum.transport-rubl-acc  = bf_tt-allsum.transport-rubl-acc
     1504       bfacc_tt-allsum.transport-cli-acc   = bf_tt-allsum.transport-cli-acc
     1505       bfacc_tt-allsum.other-base-acc      = bf_tt-allsum.other-base-acc
     1506       bfacc_tt-allsum.other-rubl-acc      = bf_tt-allsum.other-rubl-acc
     1507       bfacc_tt-allsum.other-cli-acc       = bf_tt-allsum.other-cli-acc
     1508       .
     1509     assign
     1510       bfsacc_tt-allsum.fact-qnty           = bfs_tt-allsum.fact-qnty
     1511       bfsacc_tt-allsum.cli-qnty            = bfs_tt-allsum.cli-qnty
     1512       bfsacc_tt-allsum.sum-dsc-base-doc    = bfs_tt-allsum.sum-dsc-base-acc
     1513       bfsacc_tt-allsum.sum-dsc-rubl-doc    = bfs_tt-allsum.sum-dsc-rubl-acc
     1514       bfsacc_tt-allsum.dsc-base-doc        = bfs_tt-allsum.dsc-base-acc
     1515       bfsacc_tt-allsum.dsc-rubl-doc        = bfs_tt-allsum.dsc-rubl-acc
     1516       bfsacc_tt-allsum.vat-base-doc        = 0
     1517       bfsacc_tt-allsum.vat-rubl-doc        = 0
     1518       bfsacc_tt-allsum.vat-base-buyer-doc  = bfs_tt-allsum.vat-base-acc
     1519       bfsacc_tt-allsum.vat-rubl-buyer-doc  = bfs_tt-allsum.vat-rubl-acc
     1520       bfsacc_tt-allsum.slt-base-doc        = bfs_tt-allsum.slt-base-acc
     1521       bfsacc_tt-allsum.slt-rubl-doc        = bfs_tt-allsum.slt-rubl-acc
     1522       bfsacc_tt-allsum.road-tax-base-doc   = bfs_tt-allsum.road-tax-base-acc
     1523       bfsacc_tt-allsum.road-tax-rubl-doc   = bfs_tt-allsum.road-tax-rubl-acc
     1524       bfsacc_tt-allsum.excise-base-doc     = bfs_tt-allsum.excise-base-acc
     1525       bfsacc_tt-allsum.excise-rubl-doc     = bfs_tt-allsum.excise-rubl-acc
     1526       bfsacc_tt-allsum.sum-dsc-base-cur    = bfs_tt-allsum.sum-dsc-base-acc
     1527       bfsacc_tt-allsum.sum-dsc-rubl-cur    = bfs_tt-allsum.sum-dsc-rubl-acc
     1528       bfsacc_tt-allsum.dsc-base-cur        = bfs_tt-allsum.dsc-base-acc
     1529       bfsacc_tt-allsum.dsc-rubl-cur        = bfs_tt-allsum.dsc-rubl-acc
     1530       bfsacc_tt-allsum.vat-base-cur        = 0
     1531       bfsacc_tt-allsum.vat-rubl-cur        = 0
     1532       bfsacc_tt-allsum.vat-base-buyer-cur  = bfs_tt-allsum.vat-base-acc
     1533       bfsacc_tt-allsum.vat-rubl-buyer-cur  = bfs_tt-allsum.vat-rubl-acc
     1534       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     1535       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     1536       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     1537       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     1538       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     1539       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     1540       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     1541       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     1542       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     1543       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     1544       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     1545       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     1546       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     1547       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     1548       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     1549       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     1550       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     1551       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     1552       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     1553       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     1554       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     1555       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     1556       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     1557       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     1558       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     1559       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     1560       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     1561       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     1562       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     1563       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     1564       .
     1565   end.
     1566   otherwise do:
     1567     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     1568                              cl_tt-clcparts.purch-code,
     1569                              cl_tt-clcparts.part-code,
     1570                              cl_tt-clcparts.out-code,
     1571                              cl_tt-clcparts.in-code,
     1572                              cl_tt-clcparts.artic,
     1573                              cl_tt-clcparts.prod-type,
     1574                              cl_tt-clcparts.prod-code).
     1575   end.
     1576   end case.
     1577   end.
     1578   end procedure.
     1579   procedure clcprtsl_calc-line :
     1580   define input  parameter parrec-line as recid no-undo.
     1581   define variable v-tax-date         as   date                     no-undo.
     1582   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     1583   define variable varr-b             as   character                no-undo.
     1584   define variable varr-btype         as   character                no-undo.
     1585   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     1586   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     1587   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     1588   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     1589   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     1590   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     1591   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     1592   define variable varb-code          like ub.bar-code.b-code       no-undo.
     1593   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     1594   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     1595   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     1596   define variable varexcise          like ub.price-list.excise     no-undo.
     1597   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     1598   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     1599   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     1600   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     1601   define variable v-varsum           as decimal                  no-undo.
     1602   define variable varprice-salef as decimal   no-undo .
     1603   define buffer bf_trn-doc             for ub.trn-doc.
     1604   define buffer bf_doc-line            for ub.doc-line.
     1605   define buffer bf_gds-dtl             for ub.gds-dtl.
     1606   define buffer bf_goods               for ub.goods.
     1607   define buffer bf_parts               for ub.parts.
     1608   define buffer bf_sysconf             for ub.sysconf.
     1609   define buffer bf_tt-allsum-line      for tt-allsum-line.
     1610   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     1611   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     1612   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     1613   define buffer buf_parts        for ub.parts.
     1614   v-calcbypart = no.
     1615   do on error undo, return error return-value :
     1616   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1617   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1618     (output varr-b
     1619     )  .
     1620     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     1621     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     1622     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     1623                               bf_goods.prod-type = bf_doc-line.prod-type and
     1624                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     1625     if bf_trn-doc.fact-date <> ?        then do:
     1626       assign v-tax-date = bf_trn-doc.fact-date.
     1627     end.
     1628     else do:
     1629       assign v-tax-date = ?.
     1630     end.
     1631   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1632   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1633     (input  bf_goods.gds-code
     1634     ,input  '1':U
     1635     ,input  v-tax-date
     1636     ,input  bf_trn-doc.host-code
     1637     ,input  bf_trn-doc.obj-type
     1638     ,input  bf_trn-doc.obj-code
     1639     ,output v-vat-pc
     1640     ) no-error .
     1641     if error-status :error
     1642     or v-vat-pc = ? then do:
     1643        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     1644     end.
     1645     if bf_goods.gds-type = 'у':U or
     1646        bf_trn-doc.status_ = 'запрос':U then do:
     1647       for each bf_tt-allsum-line
     1648       on error undo, return error return-value
     1649        :
     1650         delete bf_tt-allsum-line.
     1651       end.
     1652       create bf_tt-allsum-line.
     1653       assign
     1654        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     1655       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     1656                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     1657                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     1658                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     1659         assign
     1660           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     1661           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     1662           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     1663           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     1664           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     1665           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1666           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1667           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     1668           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     1669           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     1670           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1671           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1672           bf_tt-allsum-line.vat-cli-acc          =  ?
     1673           .
     1674       end.
     1675       assign
     1676         bf_tt-allsum-line.cli-qnty             =  ?
     1677         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1678         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1679         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1680         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1681         bf_tt-allsum-line.road-tax-base-doc    =  0
     1682         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     1683         bf_tt-allsum-line.excise-base-doc      =  0
     1684         bf_tt-allsum-line.excise-rubl-doc      =  0
     1685         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     1686         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     1687         bf_tt-allsum-line.dsc-base-cur         =  0
     1688         bf_tt-allsum-line.dsc-rubl-cur         =  0
     1689         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1690         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1691         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1692         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1693         bf_tt-allsum-line.road-tax-base-cur    =  0
     1694         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     1695         bf_tt-allsum-line.excise-base-cur      =  0
     1696         bf_tt-allsum-line.excise-rubl-cur      =  0
     1697         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     1698         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     1699         bf_tt-allsum-line.dsc-base-acc         =  0
     1700         bf_tt-allsum-line.dsc-rubl-acc         =  0
     1701         bf_tt-allsum-line.dsc-cli-acc          =  0
     1702         bf_tt-allsum-line.slt-base-acc         =  0
     1703         bf_tt-allsum-line.slt-rubl-acc         =  0
     1704         bf_tt-allsum-line.slt-cli-acc          =  0
     1705         bf_tt-allsum-line.road-tax-base-acc    =  0
     1706         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     1707         bf_tt-allsum-line.road-tax-cli-acc     =  0
     1708         bf_tt-allsum-line.excise-base-acc      =  0
