     2005   end.
     2006   procedure clcprtsl_calc-ttable :
     2007   define input parameter paris-doc           as   logical                 no-undo.
     2008   define input parameter paris-cur           as   logical                 no-undo.
     2009   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     2010   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     2011   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     2012   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     2013   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     2014   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     2015   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     2016   define input parameter parr-b              as   character               no-undo.
     2017   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     2018   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     2019   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     2020   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     2021   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     2022   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     2023   define buffer bf_tt-allsum      for tt-allsum.
     2024   define buffer bf_tt-clcparts    for tt-clcparts.
     2025   define buffer bf_tt-allsum-line for tt-allsum-line.
     2026   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2027   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2028   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2029   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2030   define variable varexcise          like ub.price-list.excise     no-undo.
     2031   do on error undo, return error return-value :
     2032   for each bf_tt-allsum-line
     2033   on error undo, return error return-value
     2034    :
     2035     delete bf_tt-allsum-line.
     2036   end.
     2037   for each bf_tt-allsum
     2038   on error undo, return error return-value
     2039   :
     2040     delete bf_tt-allsum.
     2041   end.
     2042   for each bf_tt-clcparts
     2043   on error undo, return error return-value
     2044   :
     2045   if v-calcbypart then do:
     2046             assign
