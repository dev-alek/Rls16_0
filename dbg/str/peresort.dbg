     7738        not parhave-exp                        then do:
     7739       create bf-incp_doc-line-sum.
     7740       assign
     7741         bf-incp_doc-line-sum.doc-code     = bf_trn-doc.doc-code
     7742         bf-incp_doc-line-sum.ext-doc-type = bf_trn-doc.ext-doc-type
