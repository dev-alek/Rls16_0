     1932           and bf_parts.obj-type  = bf_doc-line.obj-type
     1933           and bf_parts.obj-code  = bf_doc-line.obj-code
     1934           and bf_parts.artic     = bf_doc-line.artic
     1935           and bf_parts.prod-type = bf_doc-line.prod-type
     1936           and bf_parts.prod-code = bf_doc-line.prod-code
     1937       on error undo, return error return-value
