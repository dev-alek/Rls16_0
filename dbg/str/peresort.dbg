     5180   ON F9 OF b-goods IN FRAME Dialog-Frame
     5181   DO:
     5182     define buffer bfl_goods for ub.goods.
     5183     if not available bf-plus_doc-line THEN do:
     5184       return no-apply.
     5185     END.
     5186     find first bfl_goods where bfl_goods.artic     = bf-plus_doc-line.artic     and
     5187                                bfl_goods.prod-type = bf-plus_doc-line.prod-type and
     5188                                bfl_goods.prod-code = bf-plus_doc-line.prod-code no-lock.
     5189     run str/showgds.p
     5190       (input parparentproc
     5191       ,input ?
     5192       ,input bfl_goods.gds-code
     5193       ,input 'ПРОСМОТР':U
     5194       ).
     5195     apply "entry" to b-goods- in frame Dialog-Frame.
     5196     return no-apply.
     5197   END.
     5198   ON F9 OF b-goods- IN FRAME Dialog-Frame
     5199   DO:
     5200     define buffer bfl_goods for ub.goods.
     5201     if not available bf_doc-line THEN do:
     5202       return no-apply.
     5203     END.
     5204     find first bfl_goods where bfl_goods.artic     = bf_doc-line.artic     and
     5205                                bfl_goods.prod-type = bf_doc-line.prod-type and
     5206                                bfl_goods.prod-code = bf_doc-line.prod-code no-lock.
     5207     run str/showgds.p
     5208       (input parparentproc
     5209       ,input ?
     5210       ,input bfl_goods.gds-code
     5211       ,input 'ПРОСМОТР':U
     5212       ).
     5213     apply "entry" to b-goods- in frame Dialog-Frame.
     5214     return no-apply.
     5215   END.
     5216   ON VALUE-CHANGED OF b-goods- IN FRAME Dialog-Frame
     5217   DO:
     5218     OPEN QUERY b-goods FOR EACH bf-plus_doc-line WHERE bf-plus_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,            FIRST bf-plus_goods WHERE bf-plus_goods.artic     = bf-plus_doc-line.artic     AND                               bf-plus_goods.prod-type = bf-plus_doc-line.prod-type AND                               bf-plus_goods.prod-code = bf-plus_doc-line.prod-code NO-LOCK,            FIRST bf_parts-root WHERE bf_parts-root.doc-code      = bf-plus_doc-line.doc-code AND                               bf_parts-root.gds-code      = bf-plus_goods.gds-code    AND                               bf_parts-root.orig-gds-code = bf_goods.gds-code   NO-LOCK.
     5219   END.
     5220   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     5221   DO:
     5222   define variable varoutgds-code      like ub.goods.gds-code no-undo.
     5223   define variable varoutgds-code-plus like ub.goods.gds-code no-undo.
     5224   define variable varqnty             as   decimal           no-undo.
     5225   define variable varqnty-kg          as   decimal           no-undo.
     5226   define variable varqnty-plus        as   decimal           no-undo.
     5227   define variable varqnty-kg-plus     as   decimal           no-undo.
     5228   define variable varoutqnty          as   decimal           no-undo.
     5229   define variable varoutqnty-plus     as   decimal           no-undo.
     5230   define variable varoutqnty-kg       as   decimal           no-undo.
     5231   define variable varoutqnty-kg-plus  as   decimal           no-undo.
     5232   define variable varset              as   logical           no-undo.
     5233   DEFINE BUFFER bf_parts-root FOR ub.parts-root.
     5234   DEFINE BUFFER bf_parts FOR ub.parts.
     5235   IF NOT AVAILABLE bf_goods THEN DO:
     5236     MESSAGE "Не выбрана линия списываемого товара." VIEW-AS ALERT-BOX.
     5237     RETURN NO-APPLY.
     5238   END.
     5239   IF NOT AVAILABLE bf-plus_goods THEN DO:
     5240     MESSAGE "Не выбрана линия оприходуемого товара." VIEW-AS ALERT-BOX.
     5241     RETURN NO-APPLY.
     5242   END.
     5243   ASSIGN
     5244     varqnty      = 0.00
     5245     varqnty-plus = 0.00.
     5246   FOR EACH bf_parts-root WHERE bf_parts-root.doc-code      = bf_trn-doc.doc-code AND
     5247                                bf_parts-root.orig-gds-code = bf_goods.gds-code   AND
     5248                                bf_parts-root.gds-code      = bf-plus_goods.gds-code
     5249                                USE-INDEX pi ON ERROR UNDO, RETURN NO-APPLY RETURN-VALUE :
     5250     FIND FIRST bf_parts WHERE bf_parts.obj-type  = bf_trn-doc.obj-type      AND
     5251                               bf_parts.obj-code  = bf_trn-doc.obj-code      AND
     5252                               bf_parts.artic     = bf-plus_goods.artic      AND
     5253                               bf_parts.prod-type = bf-plus_goods.prod-type  AND
     5254                               bf_parts.prod-code = bf-plus_goods.prod-code  AND
     5255                               bf_parts.in-code   = bf_parts-root.in-code    AND
     5256                               bf_parts.out-code  = bf_parts-root.doc-code   AND
     5257                               bf_parts.part-code = bf_parts-root.part-code  .
     5258     ASSIGN
     5259       varqnty      = varqnty      + bf_parts.real-qnty
     5260       varqnty-plus = varqnty-plus + bf_parts.fact-qnty.
     5261   END.
     5262   run str/prst-gds.w (input  parparentproc,
     5263                   input  bf_trn-doc.doc-code,
     5264                   input  'ПРОСМОТР':U,
     5265                   input  bf_trn-doc.obj-type,
     5266                   input  bf_trn-doc.obj-code,
     5267                   input  bf_goods.gds-code,
     5268                   input  bf-plus_goods.gds-code,
     5269                   input  varqnty,
     5270                   input  ?,
     5271                   input  varqnty-plus,
     5272                   input  ?,
     5273                   input  varpstunqtn-log,
     5274                   input  varpstunit,
     5275                   input  varmxpcicp-dec,
     5276                   input  varmxpcdcp-dec,
     5277                   input  varmxsmicp-dec,
     5278                   input  varmxsmdcp-dec,
     5279                   output varoutgds-code,
     5280                   output varoutgds-code-plus,
     5281                   output table tt-gds-dtl,
     5282                   output table tt-pl-qty,
     5283                   output varoutqnty,
     5284                   output varoutqnty-plus,
     5285                   output varoutqnty-kg,
     5286                   output varoutqnty-kg-plus,
     5287                   output table tt-gds-dtl-plus,
     5288                   output table tt-pl-qty-plus,
     5289                   output varset).
     5290   END.
