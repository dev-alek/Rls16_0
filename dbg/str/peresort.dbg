     3758               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-rubl-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     3759        .
     3760     end.
     3761   end.
     3762   assign
     3763   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     3764   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     3765           assign
     3766             p-fact-qnty           = p-fact-qnty          + v-gds-dtl-fact-qnty
     3767             p-sale-sum-base       = p-sale-sum-base      + price-base-with-tax-sale  * v-gds-dtl-fact-qnty
     3768             p-sale-sum-rubl       = p-sale-sum-rubl      + price-rubl-with-tax-sale  * v-gds-dtl-fact-qnty
     3769             p-sale-vat-base       = p-sale-vat-base      + vat-base-sale             * v-gds-dtl-fact-qnty
     3770             p-sale-vat-rubl       = p-sale-vat-rubl      + vat-rubl-sale             * v-gds-dtl-fact-qnty
     3771             p-sale-slt-base       = p-sale-slt-base      + slt-base-sale             * v-gds-dtl-fact-qnty
     3772             p-sale-slt-rubl       = p-sale-slt-rubl      + slt-rubl-sale             * v-gds-dtl-fact-qnty
     3773             p-sale-road-tax-base  = p-sale-road-tax-base + road-tax-base-sale        * v-gds-dtl-fact-qnty
     3774             p-sale-road-tax-rubl  = p-sale-road-tax-rubl + road-tax-rubl-sale        * v-gds-dtl-fact-qnty
     3775             p-sale-excise-base    = p-sale-excise-base   + excise-base-sale          * v-gds-dtl-fact-qnty
     3776             p-sale-excise-rubl    = p-sale-excise-rubl   + excise-rubl-sale          * v-gds-dtl-fact-qnty
     3777             p-sale-discnt-base    = p-sale-discnt-base   + discnt-base-sale          * v-gds-dtl-fact-qnty
     3778             p-sale-discnt-rubl    = p-sale-discnt-rubl   + discnt-rubl-sale          * v-gds-dtl-fact-qnty
     3779           .
     3780         end.
     3781       end.
     3782       assign
     3783         p-sale-transport-base = 0
     3784         p-sale-transport-rubl = 0
     3785         p-sale-other-base     = 0
     3786         p-sale-other-rubl     = 0
     3787       .
     3788     end.
     3789   end procedure.
     3790   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3791   procedure factord :
     3792     define input  parameter p-fact-date            as date    no-undo .
     3793     define input  parameter p-fact-time            as integer no-undo .
     3794     define input  parameter p-fact-num             as integer no-undo .
     3795     define input  parameter p-shift-date           as date    no-undo .
     3796     define input  parameter p-shift-num            as integer no-undo .
     3797     define input  parameter p-shift-on             as logical no-undo .
     3798     define output parameter p-fact-order           as decimal no-undo .
     3799     define output parameter p-shift-end-fact-order as decimal no-undo .
     3800     define output parameter p-day-end-fact-order   as decimal no-undo .
     3801     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     3802     if p-fact-date = ?
     3803     then do:
     3804       return error "Не указана фактическая дата" .
     3805     end.
     3806     define variable v-fact-date-num as integer no-undo .
     3807     assign
     3808       v-fact-date-num = integer(p-fact-date)
     3809     .
     3810     if p-fact-num = ?
     3811     or p-fact-num = 0
     3812     then do:
     3813       return error "Не задан p-fact-num " + string(p-fact-num) .
     3814     end.
     3815     if p-fact-num < 0
     3816     then do:
     3817       return error "Отрицательный fact-num " + string(p-fact-num) .
     3818     end.
     3819     if p-fact-num >= 100000000
     3820     then do:
     3821       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     3822     end.
     3823     if p-shift-on = true
     3824     then do:
     3825       if p-shift-date = ?
     3826       then do:
     3827         return error "Не задана дата смены" .
     3828       end.
     3829       if p-shift-num = ?
     3830       or p-shift-num = 0
     3831       then do:
     3832         return error "Не задан номер смены" .
     3833       end.
     3834     end.
     3835     else do:
     3836       assign
     3837         p-shift-date = p-fact-date
     3838         p-shift-num  = 24
     3839       .
     3840     end.
     3841     define variable v-shift-offset as integer no-undo .
     3842     if p-shift-date = p-fact-date
     3843     then do:
     3844       assign
     3845         v-shift-offset = 1
     3846       .
     3847     end.
     3848     if p-shift-date < p-fact-date
     3849     then do:
     3850       assign
     3851         v-shift-offset = 0
     3852       .
     3853     end.
     3854     if p-shift-date > p-fact-date
     3855     then do:
     3856       message
     3857         vss-workfile vss-revision vss-description skip
     3858         "Неправильная дата закрытия смены" skip
     3859         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     3860         view-as alert-box error .
     3861       undo, return error
     3862         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     3863           ,string(p-fact-date, '99/99/9999':U)
     3864           ,string(p-shift-date, '99/99/9999':U)
     3865           )
     3866       .
     3867     end.
     3868     if p-shift-num < 1
     3869     or p-shift-num > 24
     3870     then do:
     3871       message
     3872         vss-workfile vss-revision vss-description skip
     3873         "Неправильный номер смены" skip
     3874         "p-shift-num" p-shift-num skip
     3875         view-as alert-box error .
     3876       undo, return error return-value .
     3877     end.
     3878     assign
     3879       p-fact-order           = v-fact-date-num
     3880                              + v-shift-offset * 0.5
     3881                              + p-shift-num    * 0.02 - 0.01
     3882                              + p-fact-num     * 0.0000000001
     3883       p-shift-end-fact-order = v-fact-date-num
     3884                              + v-shift-offset * 0.5
     3885                              + p-shift-num    * 0.02
     3886       p-day-end-fact-order   = v-fact-date-num
     3887                              + 0.99
     3888     .
     3889     if p-fact-order           <= v-fact-date-num
     3890     or p-shift-end-fact-order <= v-fact-date-num
     3891     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     3892     or p-shift-end-fact-order >= p-day-end-fact-order
     3893     then do:
     3894       message
     3895         vss-workfile vss-revision vss-description skip
     3896         "Внутренняя ошибка при генерации фактического номера" skip
     3897         "p-fact-date"            p-fact-date            skip
     3898         "p-fact-time"            p-fact-time            skip
     3899         "p-fact-num"             p-fact-num             skip
     3900         "p-shift-date"           p-shift-date           skip
     3901         "p-shift-num"            p-shift-num            skip
     3902         "p-shift-on"             p-shift-on             skip
     3903         "p-shift-end-fact-order" p-shift-end-fact-order skip
     3904         "p-day-end-fact-order"   p-day-end-fact-order   skip
     3905         "v-fact-date-num"        v-fact-date-num        skip
     3906         view-as alert-box error .
     3907       undo, return error return-value .
     3908     end.
     3909   end procedure.
     3910   procedure day-begin-fact-order :
     3911     define input  parameter p-fact-date            as date    no-undo .
     3912     define output parameter p-day-begin-fact-order as decimal no-undo .
     3913     do
     3914     on error undo, return error return-value
     3915     :
     3916       if p-fact-date = ?
     3917       then do:
     3918         assign
     3919           p-day-begin-fact-order = 0
     3920         .
     3921       end.
     3922       else do:
     3923         assign
     3924           p-day-begin-fact-order = integer(p-fact-date)
     3925         .
     3926       end.
     3927     end.
     3928   end procedure.
     3929   procedure factord-max-fact-order :
     3930     define output parameter p-max-fact-order as decimal   no-undo .
     3931     do
     3932     on error undo, return error return-value
     3933     :
     3934       run day-begin-fact-order in this-procedure
     3935         (input  date(1, 1, 5000)
     3936         ,output p-max-fact-order
     3937         ) .
     3938     end.
     3939   end procedure.
     3940   procedure factord-cut-archive :
     3941     define input  parameter p-obj-type             as character no-undo .
     3942     define input  parameter p-obj-code             as integer   no-undo .
     3943     define input  parameter p-fact-date            as date      no-undo .
     3944     define output parameter p-shift-on             as logical   no-undo .
     3945     define output parameter p-shift-date           as date      no-undo .
     3946     define output parameter p-shift-num            as integer   no-undo .
     3947     define output parameter p-day-end-fact-order   as decimal   no-undo .
     3948     define output parameter p-shift-end-fact-order as decimal   no-undo .
     3949     define variable v-fact-order as decimal   no-undo .
     3950     define buffer buf_shift-obj for ub.shift-obj .
     3951     do
     3952     on error undo, return error return-value
     3953     :
     3954   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3955   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3956     (input  p-obj-type
     3957     ,input  p-obj-code
     3958     ,input  'shift-on=request'
     3959     ,output p-shift-on
     3960     ) no-error .
     3961       if error-status :error
     3962       then do:
     3963         message
     3964           vss-workfile vss-revision vss-description skip
     3965           "Ошибка при определении атрибута объекта" skip
     3966           "Объект" p-obj-type p-obj-code skip
     3967           error-status :get-message(1) skip
     3968           return-value skip
     3969           view-as alert-box error .
     3970         undo, return error return-value .
     3971       end.
     3972       if p-shift-on = false
     3973       then do:
     3974         assign
     3975           p-shift-date               = ?
     3976           p-shift-num                = 0
     3977         .
     3978       end.
     3979       else do:
     3980         find first buf_shift-obj share-lock
     3981           where buf_shift-obj.obj-type   = p-obj-type
     3982             and buf_shift-obj.obj-code   = p-obj-code
     3983             and buf_shift-obj.shift-date > p-fact-date
     3984           use-index pi
     3985           no-error .
     3986         if not available buf_shift-obj
     3987         or buf_shift-obj.status_ <> 'зкр':U
     3988         then do:
     3989           message
     3990             vss-workfile vss-revision vss-description skip
     3991             "Невозможно вычислить последнюю смену" skip
     3992             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     3993             "Объект" p-obj-type p-obj-code skip
     3994             "Дата" p-fact-date skip
     3995             view-as alert-box error .
     3996           undo, return error return-value .
     3997         end.
     3998         find last buf_shift-obj share-lock
     3999           where buf_shift-obj.obj-type = p-obj-type
     4000             and buf_shift-obj.obj-code = p-obj-code
     4001             and buf_shift-obj.shift-date <= p-fact-date
     4002           use-index pi
     4003           no-error .
     4004         if available buf_shift-obj
     4005         then do:
     4006           if  buf_shift-obj.status_ = 'зкр':U
     4007           then do:
     4008             assign
     4009               p-shift-date = buf_shift-obj.shift-date
     4010               p-shift-num  = buf_shift-obj.shift-num
     4011             .
     4012           end.
     4013           else do:
     4014             message
     4015               vss-workfile vss-revision vss-description skip
     4016               "Невозможно вычислить последнюю смену" skip
     4017               "Статус смены отличен от статуса" 'зкр':U skip
     4018               "Объект" p-obj-type p-obj-code skip
     4019               "Дата" p-fact-date skip
     4020               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     4021               view-as alert-box error .
     4022             undo, return error return-value .
     4023           end.
     4024         end.
     4025         else do:
     4026           assign
     4027             p-shift-date = p-fact-date - 1
     4028             p-shift-num  = 1
     4029           .
     4030         end.
     4031       end.
     4032       run factord in this-procedure
     4033         (input  p-fact-date
     4034         ,input  1
     4035         ,input  1
     4036         ,input  p-shift-date
     4037         ,input  p-shift-num
     4038         ,input  p-shift-on
     4039         ,output v-fact-order
     4040         ,output p-shift-end-fact-order
     4041         ,output p-day-end-fact-order
     4042         ) no-error .
     4043       if error-status :error
     4044       then do:
     4045         message
     4046           vss-workfile vss-revision vss-description skip
     4047           "Ошибка при вызове процедуры factord"
     4048           error-status :get-message(1) skip
     4049           return-value skip
     4050           view-as alert-box error .
     4051         undo, return error return-value .
     4052       end.
     4053     end.
     4054   end procedure.
     4055   procedure factord-lock-shift :
     4056     define input  parameter p-obj-type  as character no-undo .
     4057     define input  parameter p-obj-code  as integer   no-undo .
     4058     define input  parameter p-fact-date as date      no-undo .
     4059     define parameter buffer buf_shift-obj for ub.shift-obj .
     4060     define variable v-shift-on      as logical   no-undo .
     4061     define variable v-extra-message as character no-undo .
     4062     define variable v-error as character no-undo .
     4063     do
     4064     on error undo, return error return-value
     4065     :
     4066   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4067   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     4068     (input  p-obj-type
     4069     ,input  p-obj-code
     4070     ,input  'shift-on=request'
     4071     ,output v-shift-on
     4072     ) no-error .
     4073       if error-status :error
     4074       then do:
     4075         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     4076         undo, return error v-error .
     4077       end.
     4078       if v-shift-on = true
     4079       then do:
     4080         find first buf_shift-obj share-lock
     4081           where buf_shift-obj.obj-type   = p-obj-type
     4082             and buf_shift-obj.obj-code   = p-obj-code
     4083             and buf_shift-obj.shift-date > p-fact-date
     4084           use-index pi
     4085           no-error .
     4086         if not available buf_shift-obj
     4087         or buf_shift-obj.status_ <> 'зкр':U
     4088         then do:
     4089           find last buf_shift-obj
     4090             where buf_shift-obj.obj-type = p-obj-type
     4091               and buf_shift-obj.obj-code = p-obj-code
     4092               and buf_shift-obj.status_  = 'зкр':U
     4093             use-index stts
     4094             no-error .
     4095           if available buf_shift-obj
     4096           then do:
     4097             assign
     4098               v-extra-message =
     4099                     substitute("Дата начала последеней закрытой смены на объекте &1"
     4100                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     4101                               )
     4102             .
     4103           end.
     4104           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     4105           undo, return error v-error .
     4106         end.
     4107       end.
     4108     end.
     4109   end procedure.
     4110   procedure factord-end-day :
     4111     define input  parameter p-fact-date            as date    no-undo .
     4112     define output parameter p-day-end-fact-order   as decimal no-undo .
     4113     do
     4114     on error undo, return error return-value
     4115     :
     4116       if p-fact-date = ?
     4117       then do:
     4118         return error "Не указана фактическая дата" .
     4119       end.
     4120       assign
     4121         p-day-end-fact-order = integer(p-fact-date) + 0.99
     4122       .
     4123     end.
     4124   end procedure.
     4125   procedure factord-to-date :
     4126     define input  parameter p-fact-order as decimal no-undo .
     4127     define output parameter p-fact-date  as date    no-undo .
     4128     define variable v-ref-date  as date      no-undo .
     4129     define variable v-ref-delta as integer   no-undo .
     4130     do
     4131     on error undo, return error return-value
     4132     :
     4133       if p-fact-order = ?
     4134       or p-fact-order = 0
     4135       then do:
     4136         return error "Не указан fact-order" .
     4137       end.
     4138       assign
     4139         v-ref-date  = date(1, 1, 2000)
     4140       .
     4141       assign
     4142         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     4143       .
     4144       assign
     4145         p-fact-date = v-ref-date + v-ref-delta
     4146       .
     4147     end.
     4148   end procedure.
     4149   procedure factord-to-fact-num :
     4150     define input  parameter p-fact-order as decimal no-undo .
     4151     define output parameter p-fact-num   as integer no-undo .
     4152     define variable v-fact-order-trunc as decimal no-undo .
     4153     do
     4154     on error undo, return error return-value
     4155     :
     4156       if p-fact-order = ?
     4157       or p-fact-order = 0
     4158       then do:
     4159         return error "Не указан fact-order" .
     4160       end.
     4161       assign
     4162        v-fact-order-trunc = truncate(p-fact-order, 2)
     4163       .
     4164       assign
     4165         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     4166       .
     4167     end.
     4168   end procedure.
     4169   procedure factord-to-shift-num :
     4170     define input  parameter p-fact-order as decimal no-undo .
     4171     define output parameter p-shift-num   as integer no-undo .
     4172     define variable  p-shift-numd  as decimal   no-undo .
     4173     define variable v-fact-order-trunc as decimal no-undo .
     4174     do
     4175     on error undo, return error return-value
     4176     :
     4177       if p-fact-order = ?
     4178       or p-fact-order = 0
     4179       then do:
     4180         return error "Не указан fact-order" .
     4181       end.
     4182       assign
     4183        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     4184       .
     4185       if v-fact-order-trunc < 0.5 then do:
     4186         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     4187       end.
     4188       assign
     4189         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     4190         .
     4191        assign
     4192         p-shift-num = truncate (p-shift-numd , 0)
     4193       .
     4194     end.
     4195   end procedure.
