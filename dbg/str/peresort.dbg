     7465                        ,
     7466                        buffer bf-del_gds-dtl,
     7467                        input-output varchg-qnty,
     7468                        input-output bf-del_doc-line.price-base,
     7469                        input-output bf-del_doc-line.price-rubl,
     7470                        -1, "") no-error.
     7471        if error-status:error then do:
     7472          undo, return error substitute ("Ошибка при снятии резервировов по списанному товару &1 &2 &3 &4: &5.", bf-del_goods.artic, bf-del_goods.prod-type, bf-del_goods.prod-code, bf-del_goods.gds-name, return-value).
     7473        end.
     7474        if varmem-qnty <> varchg-qnty then do:
     7475          undo, return error substitute("Не все резервы были сняты по списанному товару: &1 &2 &3 &4. Количество для снятия резерва: &5. Снято резервов: &6.", bf-del_goods.artic, bf-del_goods.prod-type, bf-del_goods.prod-code, bf-del_goods.gds-name, varmem-qnty, varchg-qnty).
     7476        end.
     7477        assign
     7478          bf-del_doc-line.fact-qnty  = bf-del_doc-line.fact-qnty + varchg-qnty
     7479        .
     7480        if varis-petrol     and
     7481          not varis-pieces then do:
     7482          assign
     7483            bf-del_doc-pl.doc-qnty      = bf-del_doc-pl.doc-qnty + varchg-qnty
     7484            bf-del_doc-pl.fact-qnty     = bf-del_doc-pl.doc-qnty
     7485            bf-del_doc-pl.cli-qnty      = bf-del_doc-pl.doc-qnty * vardensity-doc-pl
     7486            bf-del_doc-pl.cli-doc-qnty  = bf-del_doc-pl.cli-qnty
     7487            bf-del_doc-pl.cli-fact-qnty = bf-del_doc-pl.cli-doc-qnty
     7488          .
     7489          assign
     7490            bf-del_doc-line.cli-qnty = bf-del_doc-line.cli-qnty + varchg-qnty * vardensity-doc-pl.
     7491        end.
     7492        find first bf-del-check_parts where bf-del-check_parts.out-code  = bf-del_doc-line.doc-code  and
     7493                                            bf-del-check_parts.obj-type  = bf-del_doc-line.obj-type  and
     7494                                            bf-del-check_parts.obj-code  = bf-del_doc-line.obj-code  and
     7495                                            bf-del-check_parts.artic     = bf-del_doc-line.artic     and
     7496                                            bf-del-check_parts.prod-type = bf-del_doc-line.prod-type and
     7497                                            bf-del-check_parts.prod-code = bf-del_doc-line.prod-code no-error.
     7498        run rsrv-gds-dtl in this-procedure (input bf-del_doc-line.doc-code,
     7499                                            input bf-del_doc-line.artic,
     7500                                            input bf-del_doc-line.prod-type,
     7501                                            input bf-del_doc-line.prod-code,
     7502                                            input available bf-del-check_parts,
     7503                                            input varchg-qnty) no-error.
     7504        if error-status:error then do:
     7505          return error return-value.
     7506        end.
     7507        if bf-del_doc-line.fact-qnty = 0    and
     7508           not available bf-del-check_parts then do:
     7509          run local-recalc in this-procedure (input "delete":u,
     7510                                              input recid(bf-del_doc-line),
     7511                                              input yes) no-error.
     7512          if error-status:error then do:
     7513            undo, return error substitute ("Ошибка при пересчете строки документа. Списываемый товар: &1 &2 &3.", bf-del_doc-line.artic, bf-del_doc-line.prod-type, bf-del_doc-line.prod-code).
     7514          end.
     7515          run local-line-delete in this-procedure (input recid(bf-del_doc-line)) no-error.
     7516          if error-status:error then do:
     7517            undo, return error substitute ("Ошибка при удалении строки документа. Списываемый товар: &1 &2 &3.", bf-del_doc-line.artic, bf-del_doc-line.prod-type, bf-del_doc-line.prod-code).
     7518          end.
     7519        end.
     7520        else do:
     7521          run local-recalc in this-procedure (input "update":u,
     7522                                              input recid(bf-del_doc-line),
     7523                                              input yes) no-error.
     7524          if error-status:error then do:
     7525            undo, return error substitute ("Ошибка при пересчете строки документа по списанным товарам: &1", return-value).
     7526          end.
     7527          run proc-get-write-off (buffer bf-del_doc-line).
     7528         find first bf-del_gds-dtl where bf-del_gds-dtl.doc-code  = bf-del_doc-line.doc-code  and
     7529                                         bf-del_gds-dtl.artic     = bf-del_doc-line.artic     and
     7530                                         bf-del_gds-dtl.prod-type = bf-del_doc-line.prod-type and
     7531                                         bf-del_gds-dtl.prod-code = bf-del_doc-line.prod-code and
     7532                                         bf-del_gds-dtl.doc-qnty <> 0                              no-error.
     7533         if available bf-del_gds-dtl then do:
     7534           for each bf-del_gds-dtl where bf-del_gds-dtl.doc-code  = bf-del-plus_doc-line.doc-code  and
     7535                                         bf-del_gds-dtl.artic     = bf-del-plus_doc-line.artic     and
     7536                                         bf-del_gds-dtl.prod-type = bf-del-plus_doc-line.prod-type and
     7537                                         bf-del_gds-dtl.prod-code = bf-del-plus_doc-line.prod-code and
     7538                                         bf-del_gds-dtl.doc-qnty  = 0                              on error undo, return error return-value :
     7539             delete bf-del_gds-dtl.
     7540           end.
     7541         end.
     7542       end.
     7543       if varis-petrol-plus and
     7544         not varis-pieces  then do:
     7545         find first bf-del-plus_doc-pl where bf-del-plus_doc-pl.obj-type  = bf-del-plus_doc-line.obj-type and
     7546                                             bf-del-plus_doc-pl.obj-code  = bf-del-plus_doc-line.obj-code and
     7547                                             bf-del-plus_doc-pl.pl-code   = bf-del-plus_parts.pl-code     and
     7548                                             bf-del-plus_doc-pl.out-code  = bf-del-plus_doc-line.doc-code and
     7549                                             bf-del-plus_doc-pl.gds-code  = bf-del-plus_goods.gds-code    exclusive-lock.
     7550         assign
     7551           vardensity-doc-pl = bf-del-plus_doc-pl.cli-fact-qnty / bf-del-plus_doc-pl.fact-qnty.
     7552         assign
     7553           bf-del-plus_doc-pl.doc-qnty      = bf-del-plus_doc-pl.doc-qnty - bf-del-plus_parts.fact-qnty
     7554           bf-del-plus_doc-pl.fact-qnty     = bf-del-plus_doc-pl.doc-qnty
     7555           bf-del-plus_doc-pl.cli-qnty      = bf-del-plus_doc-pl.doc-qnty * vardensity-doc-pl
     7556           bf-del-plus_doc-pl.cli-doc-qnty  = bf-del-plus_doc-pl.cli-qnty
     7557           bf-del-plus_doc-pl.cli-fact-qnty = bf-del-plus_doc-pl.cli-qnty
     7558           bf-del-plus_doc-line.cli-qnty    = bf-del-plus_doc-line.cli-qnty - bf-del-plus_parts.fact-qnty * vardensity-doc-pl.
     7559       end.
     7560       assign
     7561         bf-del-plus_doc-line.fact-qnty  = bf-del-plus_doc-line.fact-qnty - bf-del-plus_parts.fact-qnty
     7562       .
     7563       assign
     7564         varrsrv-plus-qnty = bf-del-plus_parts.fact-qnty.
     7565       delete bf-del-plus_parts.
     7566       delete bf-del_parts-root.
     7567       find first bf-del-check-plus_parts where bf-del-check-plus_parts.out-code  = bf-del-plus_doc-line.doc-code  and
     7568                                                bf-del-check-plus_parts.obj-type  = bf-del-plus_doc-line.obj-type  and
     7569                                                bf-del-check-plus_parts.obj-code  = bf-del-plus_doc-line.obj-code  and
     7570                                                bf-del-check-plus_parts.artic     = bf-del-plus_doc-line.artic     and
     7571                                                bf-del-check-plus_parts.prod-type = bf-del-plus_doc-line.prod-type and
     7572                                                bf-del-check-plus_parts.prod-code = bf-del-plus_doc-line.prod-code no-error.
     7573       run rsrv-gds-dtl-plus in this-procedure (input bf-del-plus_doc-line.doc-code,
     7574                                                input bf-del-plus_doc-line.artic,
     7575                                                input bf-del-plus_doc-line.prod-type,
     7576                                                input bf-del-plus_doc-line.prod-code,
     7577                                                input available bf-del-check-plus_parts,
     7578                                                input varrsrv-plus-qnty) no-error.
     7579       if error-status:error then do:
     7580         return error return-value.
     7581       end.
     7582     end.
     7583   end.
     7584   run recalc-line in this-procedure no-error.
     7585   if error-status:error then do:
     7586     undo, return error substitute ("Ошибка при пересчете строк документа: ", return-value).
     7587   end.
     7588   end.
     7589   end.
     7590   END PROCEDURE.
     7591   PROCEDURE local-line-delete :
     7592   define input parameter parrec-line as recid no-undo.
     7593   define buffer bf_doc-line for ub.doc-line.
     7594   DEFINE BUFFER bf_gds-dtl  FOR ub.gds-dtl.
     7595   define variable l-inv-on as logical no-undo.
     7596   do on error undo, return error return-value :
     7597   find first bf_doc-line where recid(bf_doc-line) = parrec-line.
     7598   FOR EACH bf_gds-dtl WHERE bf_gds-dtl.doc-code  = bf_doc-line.doc-code  AND
     7599                             bf_gds-dtl.artic     = bf_doc-line.artic     AND
     7600                             bf_gds-dtl.prod-type = bf_doc-line.prod-type AND
     7601                             bf_gds-dtl.prod-code = bf_doc-line.prod-code EXCLUSIVE-LOCK ON ERROR UNDO, RETURN ERROR RETURN-VALUE :
     7602     DELETE bf_gds-dtl.
     7603   END.
     7604   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7605   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     7606     (input  bf_doc-line.obj-type
     7607     ,input  bf_doc-line.obj-code
     7608     ,input  bf_doc-line.artic
     7609     ,input  bf_doc-line.prod-type
     7610     ,input  bf_doc-line.prod-code
     7611     ,input  'inv-on=false'
     7612     ,output l-inv-on
     7613     ) no-error .
     7614   if error-status :error then do:
     7615     undo, return error SUBSTITUTE ("Ошибка установки атрибута товара на объекте. Документ &1. Объект &2 &3. Артикул &4 &5 &6. Признак товара в инвентаризации &7.",
     7616                                    bf_doc-line.doc-code, bf_doc-line.obj-type, bf_doc-line.obj-code, bf_doc-line.artic, bf_doc-line.prod-type, bf_doc-line.prod-code, l-inv-on).
     7617   end.
     7618   find first tt-recalc-line where tt-recalc-line.doc-code  = bf_doc-line.doc-code  and
     7619                                   tt-recalc-line.artic     = bf_doc-line.artic     and
     7620                                   tt-recalc-line.prod-type = bf_doc-line.prod-type and
     7621                                   tt-recalc-line.prod-code = bf_doc-line.prod-code no-error.
     7622   if available tt-recalc-line then do:
     7623     delete tt-recalc-line.
     7624   end.
     7625   delete bf_doc-line.
     7626   end.
     7627   END PROCEDURE.
     7628   PROCEDURE local-psn-chk :
     7629   define input parameter parman    as character no-undo.
     7630   define input parameter paraction as character no-undo.
     7631   DEFINE BUFFER cli-buf FOR ub.clients.
     7632   DEFINE VARIABLE ref-list AS CHARACTER NO-UNDO.
     7633   DEFINE VARIABLE ref-rec  AS RECID     NO-UNDO.
     7634   if parman = "agnt" and paraction = "ret-mouse" then do:
     7635     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame varagnt                                                 and cli-buf.obj-type = 'чел':U no-lock no-error.
     7636     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:     if input frame Dialog-Frame varagnt <> ""                                      and input frame Dialog-Frame varagnt <> ? THEN DO:                           message "Из справочника клиентов Вы должны выбрать человека.".              END.                                                                                run ref/cli-all.w (  input parparentproc                                                                  ,  input "b-sel"                                                                        ,  input 'чел':U                                                                         ,  input ?                                                                              ,  input ?                                                                              ,  input ref-rec                                                                        ,  input ?                                                                              ,  input ?                                                                              , output ref-list ) .                                                 assign ref-rec = integer (ref-list).                                                find cli-buf where recid (cli-buf) = ref-rec no-lock no-error.                      if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:            find cli-buf where cli-buf.obj-code = input frame Dialog-Frame varagnt                                  and cli-buf.obj-type = 'чел':U no-lock no-error.                     end.                                                                                       end.
     7637     if available cli-buf and can-do('чел':U, cli-buf.obj-type) then do:                                                                                                 disp cli-buf.obj-code @ varagnt cli-buf.obj-name @ varagnt-name with frame Dialog-Frame.                                      assign frame Dialog-Frame varagnt.                                         DO TRANSACTION ON ERROR UNDO, RETURN ERROR RETURN-VALUE :                                        ASSIGN                                         bf_trn-doc.agnt = varagnt.                                      END.                                   end.                                                                                                                       else do:                                                                                                                     disp ? @ varagnt ? @ varagnt-name with frame Dialog-Frame.                                            END.
     7638   end.
