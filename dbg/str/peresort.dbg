     5379       ,  input bf_trn-doc.obj-type
     5380       ,  input bf_trn-doc.obj-code
     5381       ,  input bf-plus_goods.gds-code
     5382       ,  input bf-plus_doc-line.doc-code
     5383       ,  input 'ПРОСМОТР':U
     5384       ,  input 'документ':U
     5385       ,  input 'текущий':U
     5386       ,  input 'документ':U
     5387       , output varprt-rec
     5388       ) .
