     6772   PROCEDURE chk-upd-date :
     6773   define variable vartoday as date      no-undo.
     6774   define variable vartime  as integer   no-undo.
     6775   DEFINE VARIABLE varlog   AS LOGICAL   NO-UNDO.
     6776   if input frame Dialog-Frame varfact-date  <> varfact-date then do:
     6777   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6778   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     6779     (input  bf_trn-doc.obj-type
     6780     ,input  bf_trn-doc.obj-code
     6781     ,output vartoday
     6782     )  .
     6783     if input frame Dialog-Frame varfact-date > vartoday then do:
     6784        message "Дата больше сегодняшней даты на объекте." view-as alert-box error.
     6785        display varfact-date with frame Dialog-Frame.
     6786        return error.
     6787     end.
     6788     if input frame Dialog-Frame varfact-date < vartoday - 7 then do:
     6789        ASSIGN
     6790          varlog = yes.
     6791        message "Заведенная факт дата отличается более чем на 7 дней от сегодняшней даты на объекте."
     6792                "Отказаться от заведения даты?" view-as alert-box question
     6793                buttons yes-no update varlog.
     6794        if varlog then do:
     6795           display varfact-date with frame Dialog-Frame.
     6796           return error.
     6797        end.
     6798     end.
     6799   define variable v-value-character as character no-undo .
     6800   define variable v-value-date      as date no-undo .
     6801   define variable v-value-decimal   as decimal no-undo .
     6802   define variable v-value-integer   as integer no-undo .
     6803   define variable v-value-logical   as logical no-undo .
     6804   define variable v-tth             as handle no-undo .
     6805   define variable v-back-date as logical   no-undo .
     6806   define variable v-back-date-type as character no-undo .
     6807         delete object v-tth no-error.
     6808         run adm/shattri.p (
     6809              input "get":U
     6810             ,input v-cntxt-obj-type
     6811             ,input v-cntxt-obj-code
     6812             ,input 'nakl_par':U
     6813             ,input  "back-date"
     6814             ,output v-value-character
     6815             ,output v-value-date
     6816             ,output v-value-decimal
     6817             ,output v-value-integer
     6818             ,output v-back-date
     6819             ,output v-back-date-type
     6820             ,INPUT-OUTPUT table-handle v-tth
     6821             ) no-error .
     6822             if error-status :error  then v-back-date = false .
     6823             delete object v-tth no-error.
     6824       if v-back-date <> true then do:
     6825         message "Запрещено работать задним числом !" view-as alert-box information .
     6826         display varfact-date with frame Dialog-Frame.
     6827         return error.
     6828       end.
     6829     assign
     6830       varlog = no
     6831     .
     6832   define variable vss-include-info60 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6833   do:
     6834     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6835       (input  v-cntxt-db-num
     6836       ,input  v-cntxt-userid
     6837       ,input  0
     6838       ,input  'actn_tdedt-peresort_add-back-date':u
     6839       ,input  'object':U
     6840       ,input  bf_trn-doc.host-code
     6841       ,input  bf_trn-doc.obj-type
     6842       ,input  bf_trn-doc.obj-code
     6843       ,input  0
     6844       ,input  0
     6845       ,input  0
     6846       ,input  true
     6847       ,output varlog
     6848       )  .
     6849   end.
     6850     if varlog <> YES then do:
     6851        display varfact-date with frame Dialog-Frame.
     6852        return error.
     6853     end.
     6854     ASSIGN
     6855       varlog = no.
     6856     message "Вы хотите изменить фактическую дату?" skip
     6857             "Если дату задать как '?' она при закрытии на факт проставится днем закрытия."
     6858     view-as alert-box question buttons yes-no update varlog.
     6859     if not varlog then do:
     6860       display varfact-date with frame Dialog-Frame.
     6861       return error.
     6862     end.
     6863     assign frame Dialog-Frame
     6864       varfact-date.
     6865     assign
     6866       bf_trn-doc.fact-date = varfact-date
     6867       bf_trn-doc.fact-time = (24 * 60 * 60).
     6868   end.
     6869   END PROCEDURE.
     6870   PROCEDURE disable_UI :
     6871     HIDE FRAME Dialog-Frame.
     6872   END PROCEDURE.
     6873   PROCEDURE enable_UI :
     6874     DISPLAY varwrkr varwrkr-name vardoc-date varagnt varagnt-name varfact-date
     6875             varboss varboss-name varshift-date varshift-name varshift-num
     6876         WITH FRAME Dialog-Frame.
     6877     ENABLE b-exit b-prev b-next b-sum-doc b-arch b-notes b-cnt b-history b-help
     6878            b-lkp b-parts b-parts-plus b-sum-goods b-sum-goods-plus b-goods-
     6879            b-goods
     6880         WITH FRAME Dialog-Frame.
     6881     OPEN QUERY b-goods FOR EACH bf-plus_doc-line WHERE bf-plus_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,            FIRST bf-plus_goods WHERE bf-plus_goods.artic     = bf-plus_doc-line.artic     AND                               bf-plus_goods.prod-type = bf-plus_doc-line.prod-type AND                               bf-plus_goods.prod-code = bf-plus_doc-line.prod-code NO-LOCK,            FIRST bf_parts-root WHERE bf_parts-root.doc-code      = bf-plus_doc-line.doc-code AND                               bf_parts-root.gds-code      = bf-plus_goods.gds-code    AND                               bf_parts-root.orig-gds-code = bf_goods.gds-code   NO-LOCK.    OPEN QUERY b-goods- FOR EACH bf_doc-line WHERE bf_doc-line.doc-code = bf_trn-doc.doc-code NO-LOCK,           FIRST bf_goods WHERE bf_goods.artic     = bf_doc-line.artic     AND                          bf_goods.prod-type = bf_doc-line.prod-type AND                          bf_goods.prod-code = bf_doc-line.prod-code NO-LOCK,           FIRST bf_parts WHERE bf_parts.out-code  = bf_doc-line.doc-code  AND                          bf_parts.obj-type  = bf_doc-line.obj-type  AND                          bf_parts.obj-code  = bf_doc-line.obj-code  AND                          bf_parts.artic     = bf_doc-line.artic     AND                          bf_parts.prod-type = bf_doc-line.prod-type AND                          bf_parts.prod-code = bf_doc-line.prod-code AND                          bf_parts.fact-qnty < 0 NO-LOCK.
     6882   END PROCEDURE.
     6883   PROCEDURE local-add :
     6884   define variable varrec-minus-line as recid no-undo.
     6885   define variable varrec-plus-line  as recid no-undo.
     6886   define variable varadd as logical no-undo.
     6887   define buffer bf-add_doc-line      for ub.doc-line.
     6888   define buffer bf-add-plus_doc-line for ub.doc-line.
     6889   run str/pstlnadd.p
     6890     (input  parparentproc,
     6891      input  this-procedure,
     6892      input  bf_trn-doc.doc-code,
     6893      input  parold-supp-cntr,
     6894      input  varpstunqtn-log,
     6895      input  varmxpcicp-dec,
     6896      input  varmxpcdcp-dec,
     6897      input  varmxsmicp-dec,
     6898      input  varmxsmdcp-dec,
     6899      input  vargrp-is-eq,
     6900      input  varpstunit,
     6901      output varrec-minus-line,
     6902      output varrec-plus-line,
     6903      output varadd)         no-error.
     6904   if error-status:error then do:
     6905     return error return-value.
     6906   end.
     6907   if varadd = yes then do:
     6908     for each tt-recalc-line on error undo, return error return-value :
     6909       delete tt-recalc-line.
     6910     end.
     6911     find first bf-add_doc-line      where recid(bf-add_doc-line)      = varrec-minus-line.
     6912     run proc-get-write-off in this-procedure (buffer bf-add_doc-line).
     6913     create tt-recalc-line.
     6914     buffer-copy bf-add_doc-line to tt-recalc-line.
     6915     find first bf-add-plus_doc-line where recid(bf-add-plus_doc-line) = varrec-plus-line.
     6916     run proc-get-write-off in this-procedure (buffer bf-add-plus_doc-line).
     6917     create tt-recalc-line.
     6918     buffer-copy bf-add-plus_doc-line to tt-recalc-line.
     6919     run recalc-line in this-procedure no-error.
     6920     if error-status:error then do:
     6921       return error substitute ("Ошибка при пересчете строк документа: ", return-value).
     6922     end.
     6923     run ui-on in this-procedure ("":u) .
     6924     reposition b-goods- to recid varrec-minus-line.
     6925     APPLY "value-changed" TO b-goods- IN FRAME Dialog-Frame.
     6926   end.
     6927   END PROCEDURE.
     6928   PROCEDURE local-chg :
     6929   define variable varchg as logical no-undo.
     6930   do on error undo, return error return-value :
     6931   run str/pstlnupd.p
     6932     (input  parparentproc,
     6933      input  this-procedure,
     6934      input  bf_trn-doc.doc-code,
     6935      input  parold-supp-cntr,
     6936      input  varpstunqtn-log,
     6937      input  varpstunit,
     6938      input  varmxpcicp-dec,
     6939      input  varmxpcdcp-dec,
     6940      input  varmxsmicp-dec,
     6941      input  varmxsmdcp-dec,
     6942      input  recid(bf_doc-line),
     6943      input  recid(bf-plus_doc-line),
     6944      output varchg) no-error.
     6945   if error-status:error then do:
     6946     return error return-value.
     6947   end.
     6948   if varchg = yes then do:
     6949     for each tt-recalc-line on error undo, return error return-value :
     6950       delete tt-recalc-line.
     6951     end.
     6952     create tt-recalc-line.
     6953     buffer-copy bf_doc-line to tt-recalc-line.
     6954     create tt-recalc-line.
     6955     buffer-copy bf-plus_doc-line to tt-recalc-line.
     6956     run recalc-line in this-procedure no-error.
     6957     if error-status:error then do:
     6958       return error substitute ("Ошибка при пересчете строк документа: ", return-value).
     6959     end.
     6960   end.
     6961   end.
     6962   END PROCEDURE.
     6963   PROCEDURE local-del :
     6964   do on error undo, return error return-value :
     6965   define output parameter parrep-rec as recid no-undo.
     6966   define variable vartemp-rec as recid no-undo.
     6967   define buffer bf-del_parts             for ub.parts.
     6968   define buffer bf-del_doc-line          for ub.doc-line.
     6969   define buffer bf-del_goods             for ub.goods.
     6970   define buffer bf-del_gds-prt           for ub.gds-prt.
     6971   define buffer bf-del_gds-dtl           for ub.gds-dtl.
     6972   define buffer bf-del_parts-root        for ub.parts-root.
     6973   define buffer bf-del-plus_parts        for ub.parts.
     6974   define buffer bf-del-plus_doc-line     for ub.doc-line.
     6975   define buffer bf-del-plus_goods        for ub.goods.
     6976   define buffer bf-del-plus_gds-prt      for ub.gds-prt.
     6977   define buffer bf-del-check_parts       for ub.parts.
     6978   define buffer bf-del-check-plus_parts  for ub.parts.
     6979   define buffer bf-del_doc-pl            for ub.doc-pl.
     6980   define buffer bf-del-plus_doc-pl       for ub.doc-pl.
     6981   define variable vardel-one-sheaf          as logical initial no no-undo.
     6982   define variable varrecdoc-line            as recid              no-undo.
     6983   define variable varrecdoc-line-plus       as recid              no-undo.
     6984   define variable vargoods-num              as integer            no-undo.
     6985   define variable varrsrv-qnty              as decimal            no-undo.
     6986   define variable varmem-qnty               as decimal            no-undo.
     6987   define variable varchg-qnty               as decimal            no-undo.
     6988   define variable vargoods-plus             as integer            no-undo.
     6989   define variable varnum                    as integer            no-undo.
     6990   define variable varlog                    as logical            no-undo.
     6991   define variable varrsrv-plus-parts-real   as decimal            no-undo.
     6992   define variable varrsrv-plus-parts        as decimal            no-undo.
     6993   define variable varrsrv-plus-qnty         as decimal            no-undo.
     6994   define variable varis-petrol              as logical            no-undo.
     6995   define variable varis-pieces              as logical            no-undo.
     6996   define variable varis-petrol-plus         as logical            no-undo.
     6997   define variable varis-pieces-plus         as logical            no-undo.
     6998   define variable vardensity-doc-pl         as decimal            no-undo.
     6999   define variable varone-line               as logical            no-undo.
     7000   do on error undo, return error return-value :
     7001   for each tt-recalc-line on error undo, return error return-value :
     7002     delete tt-recalc-line.
     7003   end.
     7004   find first tt-del-list no-error.
     7005   if not available tt-del-list then do:
     7006     if not available bf_doc-line then do:
     7007       return error "Неправильный выбор строки списанного товара.".
     7008     end.
     7009     find first bf-del_doc-line where recid(bf-del_doc-line) = recid(bf_doc-line) exclusive-lock.
     7010     find first bf-del_goods where bf-del_goods.artic     = bf-del_doc-line.artic     and
     7011                                   bf-del_goods.prod-type = bf-del_doc-line.prod-type and
     7012                                   bf-del_goods.prod-code = bf-del_doc-line.prod-code no-lock.
     7013     assign
     7014       vargoods-plus = 0.
     7015     for each bf-del_parts-root where bf-del_parts-root.doc-code       = bf_trn-doc.doc-code   and
     7016                                      bf-del_parts-root.orig-gds-code  = bf-del_goods.gds-code
     7017                                      use-index pi break by bf-del_parts-root.gds-code on error undo, return error return-value :
     7018       if first-of(bf-del_parts-root.gds-code) then do:
     7019         assign
     7020           vargoods-plus = vargoods-plus + 1.
     7021       end.
     7022     end.
     7023     if vargoods-plus > 1 then do:
     7024       if not available bf-plus_doc-line then do:
     7025         return error "Неправильный выбор строки оприходованного товара.".
     7026       end.
     7027       find first bf-del-plus_doc-line where recid(bf-del-plus_doc-line) = recid(bf-plus_doc-line) exclusive-lock.
     7028       find first bf-del-plus_goods where bf-del-plus_goods.artic     = bf-del-plus_doc-line.artic     and
     7029                                          bf-del-plus_goods.prod-type = bf-del-plus_doc-line.prod-type and
     7030                                          bf-del-plus_goods.prod-code = bf-del-plus_doc-line.prod-code no-lock.
     7031       assign
     7032         varone-line = yes.
     7033   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     7034     (
     7035        input bf-del_goods.artic
     7036     ,  input bf-del_goods.prod-type
     7037     ,  input bf-del_goods.prod-code
     7038     , output varis-petrol
     7039     , output varis-pieces
     7040     ) .
     7041   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     7042     (
     7043        input bf-del-plus_goods.artic
     7044     ,  input bf-del-plus_goods.prod-type
     7045     ,  input bf-del-plus_goods.prod-code
     7046     , output varis-petrol-plus
     7047     , output varis-pieces-plus
     7048     ) .
     7049       if varis-petrol     and
     7050          not varis-pieces then do:
     7051         assign
     7052           varone-line = no.
     7053       end.
     7054       if varis-petrol-plus and
     7055          not varis-pieces-plus then do:
     7056         assign
     7057           varone-line = no.
     7058       end.
     7059       find first bf-del_gds-prt where bf-del_gds-prt.upper-code = bf-del_goods.prt-root no-lock.
     7060       if bf-del_gds-prt.node-name <> '_Пустая шкала':U then do:
     7061         assign
     7062           varone-line = no.
     7063       end.
     7064       find first bf-del-plus_gds-prt where bf-del-plus_gds-prt.upper-code = bf-del-plus_goods.prt-root no-lock.
     7065       if bf-del-plus_gds-prt.node-name <> '_Пустая шкала':U then do:
     7066         assign
     7067           varone-line = no.
     7068       end.
     7069       if varone-line = yes then do:
     7070         run gbl/d-askw.w
     7071           (input "Удаление в документе пересортицы"
     7072           ,input "Товар для списания "                         +
     7073                  bf-del_goods.artic                            + " " +
     7074                  bf-del_goods.prod-type                        + " " +
     7075                  string(bf-del_goods.prod-code)                + " " +
     7076                  substring(bf-del_goods.gds-name, 1, 30)       +
     7077                  "Спозиционированный товар для оприходования " +
     7078                  bf-del-plus_goods.artic                       + " " +
     7079                  bf-del-plus_goods.prod-type                   + " " +
     7080                  string(bf-del-plus_goods.prod-code)           + " " +
     7081                  substring(bf-del-plus_goods.gds-name, 1, 30)
     7082           ,input "|^"
     7083           ,input "Все|Только спозиц.|Отменить"
     7084           ,input "Всем товарам для оприходования|"
     7085                + "Только спозиционированному товару|"
     7086                + "Отменить удаление"
     7087           ,input 1
     7088           ,input 3
     7089           ,output varnum
     7090           ).
     7091         case varnum:
     7092           when 1 then do:
     7093             assign
     7094               vartemp-rec =  recid (bf-del_doc-line).
     7095             create tt-del-list.
     7096             assign
     7097               tt-del-list.rec-id = recid (bf-del_doc-line).
     7098           end.
     7099           when 2 then do:
     7100             assign
     7101               vardel-one-sheaf    = yes
     7102               varrecdoc-line      = recid (bf-del_doc-line)
     7103               varrecdoc-line-plus = recid (bf-del-plus_doc-line)
     7104             .
     7105           end.
     7106           when 3 then do:
     7107             return error.
     7108           end.
     7109         end case.
     7110       end.
     7111       else do:
     7112         assign
     7113           varlog = no.
     7114         message "Удалить строку из документа? Вы уверены?"
     7115                 view-as alert-box question buttons ok-cancel update varlog.
     7116         if not varlog then return error.
     7117         assign
     7118           vartemp-rec =  recid (bf-del_doc-line).
     7119         create tt-del-list.
     7120         assign
     7121           tt-del-list.rec-id = recid (bf-del_doc-line).
     7122       end.
     7123     end.
     7124     else do:
     7125       assign
     7126         varlog = no.
     7127       message "Удалить строку из документа? Вы уверены?"
     7128               view-as alert-box question buttons ok-cancel update varlog.
     7129       if not varlog then return error.
     7130       assign
     7131         vartemp-rec =  recid (bf-del_doc-line).
     7132       create tt-del-list.
     7133       assign
     7134         tt-del-list.rec-id = recid (bf-del_doc-line).
     7135     end.
     7136     get next b-goods-.
     7137     if available bf_doc-line then do:
     7138       assign
     7139         parrep-rec = recid (bf_doc-line).
     7140     end.
     7141     else do:
     7142       reposition b-goods- to recid vartemp-rec no-error.
     7143       get prev b-goods-.
     7144       assign
     7145         parrep-rec = recid (bf_doc-line).
     7146     end.
     7147   end.
     7148   else do:
     7149     assign
     7150       varlog = no.
     7151     message "УДАЛИТЬ ВСЕ ОТМЕЧЕННЫЕ строки документа? Вы уверены ?"
     7152     view-as alert-box question buttons ok-cancel update varlog.
     7153     if not varlog then do:
     7154       return error.
     7155     end.
     7156     assign
     7157       parrep-rec = ?.
     7158   end.
     7159   if vardel-one-sheaf <> yes then do:
     7160     for each tt-del-list on error undo, return error return-value :
     7161       find first bf-del_doc-line where recid (bf-del_doc-line) = tt-del-list.rec-id exclusive-lock no-error.
     7162       if not available bf-del_doc-line then do:
     7163         undo, return error "Ошибка при удалении линии. Не найдена линия для удаления.".
     7164       end.
     7165       find first bf-del_goods where bf-del_goods.artic     = bf-del_doc-line.artic     and
     7166                                     bf-del_goods.prod-type = bf-del_doc-line.prod-type and
     7167                                     bf-del_goods.prod-code = bf-del_doc-line.prod-code no-lock.
     7168       run local-recalc in this-procedure (input "old":u,
     7169                                           input recid(bf-del_doc-line),
     7170                                           input yes) no-error.
     7171       if error-status:error then do:
     7172         undo, return error substitute ("Ошибка при пересчете строки документа: &1.", return-value).
     7173       end.
     7174       assign
     7175         varrsrv-qnty = 0.00.
     7176       for each bf-del_parts where bf-del_parts.out-code  = bf_trn-doc.doc-code       and
     7177                                   bf-del_parts.obj-type  = bf_trn-doc.obj-type       and
     7178                                   bf-del_parts.obj-code  = bf_trn-doc.obj-code       and
     7179                                   bf-del_parts.artic     = bf-del_doc-line.artic     and
     7180                                   bf-del_parts.prod-type = bf-del_doc-line.prod-type and
     7181                                   bf-del_parts.prod-code = bf-del_doc-line.prod-code and
     7182                                   bf-del_parts.fact-qnty < 0                         exclusive-lock on error undo, return error return-value :
     7183         if varis-petrol     and
     7184            not varis-pieces then do:
