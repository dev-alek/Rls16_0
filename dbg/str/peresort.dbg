     4958     define variable varis-petrol      as logical no-undo.
     4959     define variable varis-pieces      as logical no-undo.
     4960     define variable varis-petrol-plus as logical no-undo.
     4961     define variable varis-pieces-plus as logical no-undo.
     4962     define buffer bf-trb_parts      for ub.parts.
     4963     define buffer bf-trb_parts-root for ub.parts-root.
     4964     define buffer bf_gds-prt      for ub.gds-prt.
     4965     define buffer bf-plus_gds-prt for ub.gds-prt.
     4966     define variable varhave-another-goods as logical no-undo.
