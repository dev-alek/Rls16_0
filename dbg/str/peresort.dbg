     7712   input-output vartotal-parts_fact-rublold,
     7713   input-output vartotal-parts_fact-qntyold
     7714   ) no-error.
     7715   if error-status:error then do:
     7716     undo, return error substitute("Ошибка при обсчете линии по товару ", bf-rc_doc-line.artic, bf-rc_doc-line.prod-type, bf-rc_doc-line.prod-code) .
     7717   end.
     7718   if parmode <> "delete" then do:
     7719     find first bf-expp_doc-line-sum where bf-expp_doc-line-sum.doc-code = bf-rc_doc-line.doc-code
     7720                                       and bf-expp_doc-line-sum.gds-code = bf-rc_goods.gds-code
     7721                                       and bf-expp_doc-line-sum.sum-type = 'exp':U exclusive-lock no-error.
