        1   block-level on error undo, throw.
        2   define input parameter p-obj-type like ub.place-imp.obj-type no-undo .
        3   define input parameter p-obj-code like ub.place-imp.obj-code no-undo .
        4   define input parameter p-pl-code like ub.place-imp.pl-code no-undo .
        5   define input parameter p-table-version like ub.place-imp.table-version no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision:$":U .
        7   define variable vss-author      as character no-undo init "$Author:$":U .
        8   define variable vss-date        as character no-undo init "$Date:$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
       10   define variable vss-archive     as character no-undo init "$Archive:$":U .
       11   define variable vss-description as character no-undo init "".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define buffer buf_place-imp for ub.place-imp .
       67   define buffer buf_pl-level-imp for ub.pl-level-imp .
       68   define buffer buf_pl-level-mm-imp for ub.pl-level-mm-imp .
       69   define buffer buf_place for ub.place .
       70   define buffer buf_place-attr for ub.place-attr .
       71   define buffer buf_pl-level for ub.pl-level .
       72   define buffer buf_pl-level-attr for ub.pl-level-attr .
       73   define buffer buf_pl-level-mm for ub.pl-level-mm .
       74   define variable v-ok as logical no-undo .
       75   define variable v-today as date no-undo .
       76   define variable v-time as integer no-undo .
       77   procedure placelib_write-attr:
       78   define input  parameter p-code     like ub.place-attr.attr-code .
       79   define input  parameter p-obj-code like ub.place-attr.obj-code .
       80   define input  parameter p-obj-type like ub.place-attr.obj-type .
       81   define input  parameter p-pl-code  like ub.place-attr.pl-code .
       82   define input  parameter p-value    like ub.place-attr.attr-value .
       83   define output parameter p-ok       as logical.
       84   define buffer buf_place-attr for ub.place-attr .
       85     do on error undo, return error return-value :
       86        p-ok = false.
       87        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
       88                                                   and buf_place-attr.obj-code    = p-obj-code
       89                                                   and buf_place-attr.obj-type    = p-obj-type
       90                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
       91        if not available buf_place-attr then do :
       92           create buf_place-attr.
       93           assign
       94             buf_place-attr.attr-code   = p-code
       95             buf_place-attr.attr-value  = p-value
       96             buf_place-attr.obj-code    = p-obj-code
       97             buf_place-attr.obj-type    = p-obj-type
       98             buf_place-attr.pl-code     = p-pl-code
       99           .
      100           p-ok = true.
      101        end.
      102        else do:
      103           buf_place-attr.attr-value  = p-value .
      104           p-ok = true.
      105        end.
      106     end.
      107   end.
      108   procedure placelib_get-attr:
      109   define input  parameter  p-code     like ub.place-attr.attr-code .
      110   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      111   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      112   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      113   define output parameter  p-value    like ub.place-attr.attr-value .
      114   define output parameter  p-ok       as logical.
      115   define buffer buf_place-attr for ub.place-attr .
      116     do on error undo, return error return-value :
      117        p-ok = false.
      118        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      119                                                   and buf_place-attr.obj-code    = p-obj-code
      120                                                   and buf_place-attr.obj-type    = p-obj-type
      121                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      122        if available buf_place-attr then do :
      123          p-value = buf_place-attr.attr-value.
      124          p-ok = true.
      125        end.
      126        else do :
      127          p-ok = false.
      128        end.
      129     end.
      130   end.
      131   procedure placelib_del-attr:
      132   define input parameter  p-code     like ub.place-attr.attr-code .
      133   define input parameter  p-obj-code like ub.place-attr.obj-code .
      134   define input parameter  p-obj-type like ub.place-attr.obj-type .
      135   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      136   define input parameter  p-value    like ub.place-attr.attr-value .
      137   define output parameter p-ok       as logical.
      138   define buffer buf_place-attr for ub.place-attr .
      139     do on error undo, return error return-value :
      140        p-ok = false.
      141        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      142                                                   and buf_place-attr.obj-code    = p-obj-code
      143                                                   and buf_place-attr.obj-type    = p-obj-type
      144                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      145        if available buf_place-attr then do :
      146           delete buf_place-attr.
      147           p-ok = true.
      148        end.
      149     end.
      150   end.
      151   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      152   define new global shared variable g#language as character no-undo .
      153   if g#language <> '' and g#language <> 'rus':U then do:
      154     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      155   end.
      156   procedure cur-time :
      157      define output parameter p-today as date      no-undo .
      158      define output parameter p-time  as integer   no-undo .
      159     do
      160     on error undo, return error
      161     :
      162       define variable v-date1 as date      no-undo .
      163       define variable v-date2 as date      no-undo .
      164       define variable v-time  as integer   no-undo .
      165       assign
      166         v-date1 = today
      167         v-time  = time
      168         v-date2 = today
      169       .
      170       if v-date1 <> v-date2
      171       then do:
      172         assign
      173           v-date1 = today
      174           v-time  = v-time
      175         .
      176       end.
      177       assign
      178         p-today = v-date1
      179         p-time  = v-time
      180       .
      181     end.
      182   end.
      183   function cur-time-date returns character
      184   :
      185     return string(today, '99/99/9999':U) .
      186   end.
      187   function cur-time-mjd returns decimal
      188   :
      189     define variable v-date as date      no-undo .
      190     define variable v-time as integer   no-undo .
      191     run cur-time in this-procedure
      192       (output v-date
      193       ,output v-time
      194       ) .
      195     return integer(v-date) - 2400002 + (v-time / 86400) .
      196   end.
      197   function cur-time-get-ending-index returns integer
      198   (input p-number as integer
      199   )
      200   :
      201     if p-number < 0
      202     or p-number = ?
      203     then do:
      204       return 1 .
      205     end.
      206     define variable v-rest as integer   no-undo .
      207     assign
      208       p-number = p-number modulo 100
      209     .
      210     if p-number < 20
      211     then do:
      212       assign
      213         v-rest = p-number
      214       .
      215     end.
      216     else do:
      217       assign
      218         v-rest = p-number modulo 10
      219       .
      220     end.
      221     case v-rest :
      222       when 1
      223       then do:
      224         return 2 .
      225       end.
      226       when 2 or
      227       when 3 or
      228       when 4
      229       then do:
      230         return 3 .
      231       end.
      232       otherwise do:
      233         return 1 .
      234       end.
      235     end case .
      236   end.
      237   procedure cur-time-mjd-to-date :
      238      define input  parameter i-mjd-diff as decimal no-undo.
      239      define output parameter o-Date     as date    no-undo.
      240      define output parameter o-Time     as integer no-undo.
      241      define variable v-day-number as integer   no-undo .
      242      if    i-mjd-diff < 0
      243         or i-mjd-diff = ?
      244      then do:
      245         return "?" .
      246      end.
      247      assign
      248         v-day-number = truncate(i-mjd-diff,0).
      249         o-Date = date(v-day-number + 2400002).
      250         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      251     .
      252   end.
      253   function cur-time-mjd-to-string returns character
      254   (input p-mjd-diff as decimal
      255   )
      256   :
      257     define variable v-day-number as integer   no-undo .
      258     define variable v-seconds    as integer   no-undo .
      259     define variable v-hour       as integer   no-undo .
      260     define variable v-min        as integer   no-undo .
      261     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      262     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      263     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      264     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      265     if p-mjd-diff < 0
      266     or p-mjd-diff = ?
      267     then do:
      268       return "?" .
      269     end.
      270     assign
      271       v-day-number = integer(truncate(p-mjd-diff,0))
      272       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      273     .
      274     if v-seconds > 86400
      275     then do:
      276       assign
      277         v-seconds = 86400 - 1
      278       .
      279     end.
      280     if v-seconds < 0
      281     then do:
      282       assign
      283         v-seconds = 0
      284       .
      285     end.
      286     assign
      287       v-hour = truncate(v-seconds / 3600, 0)
      288     .
      289     assign
      290       v-seconds = v-seconds modulo 3600
      291     .
      292     assign
      293       v-min = truncate(v-seconds / 60, 0)
      294     .
      295     assign
      296       v-seconds = v-seconds modulo 60
      297     .
      298     return
      299         (if v-day-number <> 0
      300           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      301           else ""
      302         )
      303       + (if v-day-number <> 0 or v-hour <> 0
      304           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      305           else ""
      306         )
      307       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      308           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      309           else ""
      310         )
      311       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      312       .
      313   end.
      314   function cur-time-string returns character
      315   :
      316     define variable v-date as date      no-undo .
      317     define variable v-time as integer   no-undo .
      318     run cur-time in this-procedure
      319       (output v-date
      320       ,output v-time
      321       ) .
      322     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      323   end.
      324   function cur-time-string-sec returns character
      325   :
      326     define variable v-date as date      no-undo .
      327     define variable v-time as integer   no-undo .
      328     run cur-time in this-procedure
      329       (output v-date
      330       ,output v-time
      331       ) .
      332     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      333   end.
      334   function cur-time-custom  returns character
      335   (input p-prefix as character
      336   ,input p-date-format as character
      337   ,input p-delimiter as character
      338   ,input p-time-format as character
      339   ,input p-suffix as character
      340   )
      341   :
      342     define variable v-date as date      no-undo .
      343     define variable v-time as integer   no-undo .
      344     run cur-time in this-procedure
      345       (output v-date
      346       ,output v-time
      347       ) .
      348     return
      349       p-prefix
      350       + string(v-date, p-date-format)
      351       + p-delimiter
      352       + string(v-time, p-time-format)
      353       + p-suffix
      354       .
      355   end.
      356   function cur-time-print  returns character
      357   :
      358     define variable v-date as date      no-undo .
      359     define variable v-time as integer   no-undo .
      360     run cur-time in this-procedure
      361       (output v-date
      362       ,output v-time
      363       ) .
      364     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      365   end.
      366   function cur-time-datetime returns datetime
      367   :
      368     define variable v-char as character no-undo .
      369     define variable v-datetime as datetime no-undo .
      370     v-char = cur-time-string().
      371     v-datetime = datetime(v-char).
      372     return  v-datetime.
      373   end.
      374   function cur-time-string-msec returns character
      375   :
      376     define variable v-date as datetime  no-undo .
      377     v-date = now.
      378     return string(v-date) .
      379   end.
      380   do on error undo, return error return-value :
      381     find first buf_place-imp no-lock where buf_place-imp.obj-type = p-obj-type
      382                                        and buf_place-imp.obj-code = p-obj-code
      383                                        and buf_place-imp.pl-code  = p-pl-code
      384                                        and buf_place-imp.table-version = p-table-version
      385                                        no-error .
      386     if not available buf_place-imp
      387     then do :
      388       return .
      389     end .
      390     find first buf_place exclusive-lock where buf_place.obj-type = buf_place-imp.obj-type
      391                                           and buf_place.obj-code = buf_place-imp.obj-code
      392                                           and buf_place.pl-code  = buf_place-imp.pl-code
      393                                           no-error .
      394     if not available buf_place
      395     then do :
      396       return error error-status:get-message(1).
      397     end .
      398     if buf_place-imp.max-qnty <> ? then assign buf_place.max-qnty = buf_place-imp.max-qnty .
      399     if buf_place-imp.d-qnty <> ?
      400     then do :
      401       run placelib_write-attr  (input "dead-balance"
      402           ,input buf_place.obj-code
      403           ,input buf_place.obj-type
      404           ,input buf_place.pl-code
      405           ,input string(buf_place-imp.d-qnty)
      406           ,output v-ok      )
      407       no-error.
      408     end .
      409     if buf_place-imp.tank-d <> ?
      410     then do :
      411       run placelib_write-attr  (input "place-diameter"
      412           ,input buf_place.obj-code
      413           ,input buf_place.obj-type
      414           ,input buf_place.pl-code
      415           ,input string(buf_place-imp.tank-d)
      416           ,output v-ok      )
      417       no-error.
      418     end .
      419     if buf_place-imp.dc-height <> ?
      420     then do :
      421       run placelib_write-attr  (input "place-dead-high"
      422           ,input buf_place.obj-code
      423           ,input buf_place.obj-type
      424           ,input buf_place.pl-code
      425           ,input string(buf_place-imp.dc-height)
      426           ,output v-ok      )
      427       no-error.
      428     end .
      429     if buf_place-imp.dnsty <> ?
      430     then do :
      431       run placelib_write-attr  (input "dens-prov"
      432           ,input buf_place.obj-code
      433           ,input buf_place.obj-type
      434           ,input buf_place.pl-code
      435           ,input string(buf_place-imp.dnsty)
      436           ,output v-ok      )
      437       no-error.
      438     end .
      439     if buf_place-imp.main-mi-code <> ?
      440     then do :
      441       run placelib_write-attr  (input "place-SI"
      442           ,input buf_place.obj-code
      443           ,input buf_place.obj-type
      444           ,input buf_place.pl-code
      445           ,input string(buf_place-imp.main-mi-code)
      446           ,output v-ok      )
      447       no-error.
      448     end .
      449     if buf_place-imp.position <> ?
      450     then do :
      451       run placelib_write-attr  (input "place-local"
      452           ,input buf_place.obj-code
      453           ,input buf_place.obj-type
      454           ,input buf_place.pl-code
      455           ,input string(buf_place-imp.position)
      456           ,output v-ok      )
      457       no-error.
      458     end .
      459     if buf_place-imp.tank-tk <> ?
      460     then do :
      461       run placelib_write-attr  (input "place-temp-coef"
      462           ,input buf_place.obj-code
      463           ,input buf_place.obj-type
      464           ,input buf_place.pl-code
      465           ,input string(buf_place-imp.tank-tk)
      466           ,output v-ok      )
      467       no-error.
      468     end .
      469     if buf_place-imp.pontoon <> ?
      470     then do :
      471       run placelib_write-attr  (input "place-ponton"
      472           ,input buf_place.obj-code
      473           ,input buf_place.obj-type
      474           ,input buf_place.pl-code
      475           ,input (if buf_place-imp.pontoon = 1 then string(yes) else string(no))
      476           ,output v-ok      )
      477       no-error.
      478     end .
      479     if buf_place-imp.wght-pntn <> ?
      480     then do :
      481       run placelib_write-attr  (input "place-ponton-mass"
      482           ,input buf_place.obj-code
      483           ,input buf_place.obj-type
      484           ,input buf_place.pl-code
      485           ,input string(buf_place-imp.wght-pntn)
      486           ,output v-ok      )
      487       no-error.
      488     end .
      489     if buf_place-imp.srfcng-pntn <> ?
      490     then do :
      491       run placelib_write-attr  (input "place-ponton-height"
      492           ,input buf_place.obj-code
      493           ,input buf_place.obj-type
      494           ,input buf_place.pl-code
      495           ,input string(buf_place-imp.srfcng-pntn)
      496           ,output v-ok      )
      497       no-error.
      498     end .
      499     find first buf_pl-level-imp no-lock where buf_pl-level-imp.obj-type = buf_place-imp.obj-type
      500                                           and buf_pl-level-imp.obj-code = buf_place-imp.obj-code
      501                                           and buf_pl-level-imp.pl-code  = buf_place-imp.pl-code
      502                                           and buf_pl-level-imp.table-version = buf_place-imp.table-version
      503                                           no-error .
      504     if available buf_pl-level-imp
      505     then do :
      506       for each buf_pl-level exclusive-lock where buf_pl-level.obj-type = buf_place.obj-type
      507                                              and buf_pl-level.obj-code = buf_place.obj-code
      508                                              and buf_pl-level.pl-code  = buf_place.pl-code
      509       :
      510         for each buf_pl-level-attr exclusive-lock where buf_pl-level-attr.obj-type  = buf_place.obj-type
      511                                                     and buf_pl-level-attr.obj-code  = buf_place.obj-code
      512                                                     and buf_pl-level-attr.pl-code   = buf_place.pl-code
      513                                                     and buf_pl-level-attr.pl-level  = buf_pl-level.pl-level
      514         :
      515           delete buf_pl-level-attr.
      516         end.
      517         delete buf_pl-level .
      518       end .
      519       for each buf_pl-level-imp no-lock where buf_pl-level-imp.obj-type = buf_place-imp.obj-type
      520                                           and buf_pl-level-imp.obj-code = buf_place-imp.obj-code
      521                                           and buf_pl-level-imp.pl-code  = buf_place-imp.pl-code
      522                                           and buf_pl-level-imp.table-version = buf_place-imp.table-version
      523       :
      524         create buf_pl-level .
      525         buffer-copy buf_pl-level-imp to buf_pl-level .
      526         if buf_pl-level-imp.tarir-delta <> ?
      527         then do :
      528           find first buf_pl-level-attr exclusive-lock where buf_pl-level-attr.obj-type  = buf_place-imp.obj-type
      529                                                         and buf_pl-level-attr.obj-code  = buf_place-imp.obj-code
      530                                                         and buf_pl-level-attr.pl-code   = buf_place-imp.pl-code
      531                                                         and buf_pl-level-attr.pl-level  = buf_pl-level.pl-level
      532                                                         and buf_pl-level-attr.attr-code = "tarir-delta"
      533                                                         no-error .
      534           if not available buf_pl-level-attr
      535           then do :
      536             create buf_pl-level-attr .
      537             assign
      538               buf_pl-level-attr.obj-type  = buf_place-imp.obj-type
      539               buf_pl-level-attr.obj-code  = buf_place-imp.obj-code
      540               buf_pl-level-attr.pl-code   = buf_place-imp.pl-code
      541               buf_pl-level-attr.pl-level  = buf_pl-level.pl-level
      542               buf_pl-level-attr.attr-code = "tarir-delta"
      543             .
      544           end.
      545           assign buf_pl-level-attr.attr-value = string(buf_pl-level-imp.tarir-delta).
      546         end .
      547         if buf_pl-level-imp.deltaV > 0
      548         then do :
      549           find first buf_pl-level-attr exclusive-lock where buf_pl-level-attr.obj-type  = buf_place-imp.obj-type
      550                                                         and buf_pl-level-attr.obj-code  = buf_place-imp.obj-code
      551                                                         and buf_pl-level-attr.pl-code   = buf_place-imp.pl-code
      552                                                         and buf_pl-level-attr.pl-level  = buf_pl-level.pl-level
      553                                                         and buf_pl-level-attr.attr-code = "deltaV"
      554                                                         no-error .
      555           if not available buf_pl-level-attr
      556           then do :
      557             create buf_pl-level-attr .
      558             assign
      559               buf_pl-level-attr.obj-type  = buf_place-imp.obj-type
      560               buf_pl-level-attr.obj-code  = buf_place-imp.obj-code
      561               buf_pl-level-attr.pl-code   = buf_place-imp.pl-code
      562               buf_pl-level-attr.pl-level  = buf_pl-level.pl-level
      563               buf_pl-level-attr.attr-code = "deltaV"
      564             .
      565           end.
      566           assign buf_pl-level-attr.attr-value = string(buf_pl-level-imp.deltaV).
      567         end .
      568       end .
      569     end .
      570     find first buf_pl-level-mm-imp no-lock where buf_pl-level-mm-imp.obj-type = buf_place-imp.obj-type
      571                                              and buf_pl-level-mm-imp.obj-code = buf_place-imp.obj-code
      572                                              and buf_pl-level-mm-imp.pl-code  = buf_place-imp.pl-code
      573                                              and buf_pl-level-mm-imp.table-version = buf_place-imp.table-version
      574                                              no-error .
      575     if available buf_pl-level-mm-imp
      576     then do :
      577       for each buf_pl-level-mm exclusive-lock where buf_pl-level-mm.obj-type = buf_place.obj-type
      578                                                 and buf_pl-level-mm.obj-code = buf_place.obj-code
      579                                                 and buf_pl-level-mm.pl-code  = buf_place.pl-code
      580       :
      581         delete buf_pl-level-mm .
      582       end .
      583       for each buf_pl-level-mm-imp no-lock where buf_pl-level-mm-imp.obj-type = buf_place-imp.obj-type
      584                                              and buf_pl-level-mm-imp.obj-code = buf_place-imp.obj-code
      585                                              and buf_pl-level-mm-imp.pl-code  = buf_place-imp.pl-code
      586                                              and buf_pl-level-mm-imp.table-version = buf_place-imp.table-version
      587       :
      588         create buf_pl-level-mm .
      589         buffer-copy buf_pl-level-mm-imp to buf_pl-level-mm .
      590       end .
      591     end .
      592     run placelib_write-attr  (input "current-table-version"
      593         ,input buf_place.obj-code
      594         ,input buf_place.obj-type
      595         ,input buf_place.pl-code
      596         ,input string(buf_place-imp.table-version)
      597         ,output v-ok      )
      598     no-error.
      599     run placelib_write-attr  (input "message-table-version"
      600         ,input buf_place.obj-code
      601         ,input buf_place.obj-type
      602         ,input buf_place.pl-code
      603         ,input "applied"
      604         ,output v-ok      )
      605     no-error.
      606     run cur-time in this-procedure (
      607           output v-today
      608         , output v-time
      609     ).
      610     find current buf_place-imp exclusive-lock .
      611     assign
      612       buf_place-imp.status_ = 1
      613       buf_place-imp.corr-date = v-today
      614       buf_place-imp.corr-time = v-time
      615     .
      616     validate buf_place-imp .
      617     run str/prep1C-status-cal-tbl.p (input buf_place-imp.table-version,
      618                                      input buf_place-imp.pl-code,
      619                                      input buf_place-imp.corr-date,
      620                                      input buf_place-imp.corr-time,
      621                                      input buf_place-imp.status_)
      622                                      no-error .
      623   end .
