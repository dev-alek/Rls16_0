        1   define input        parameter p-parent-proc as widget-handle no-undo.
        2   define input        parameter p-mode        as character     no-undo.
        3   define input-output parameter p-rec-id      as recid         no-undo.
        4   define variable vss-revision    as character no-undo initial "$Revision$":U.
        5   define variable vss-author      as character no-undo initial "$Author$":U.
        6   define variable vss-date        as character no-undo initial "$Date$":U.
        7   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
        8   define variable vss-archive     as character no-undo initial "$Archive$":U.
        9   define variable vss-description as character no-undo initial "Карточка основания (причины) создания документа (добавление, изменение, просмотр)":U.
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define shared buffer buf_refer for ub.trn-reason.
      114   define button   Btn_Exit    label "Вы&ход"   size-chars 10.00 by 1.00 default auto-end-key.
      115   define button   Btn_OK      label "&Ввод "   size-chars 10.00 by 1.00 default auto-go.
      116   define button   Btn_History label "Истори&я" size-chars 10.00 by 1.00 default.
      117   define button b-help   label "Помо&щь"  size-chars 10.00 by 1.00 default.
      118   define rectangle r-rect-0 edge-pixels 3 graphic-edge no-fill size-chars 98.25 by 1.50.
      119   define frame fr-D-pump-8
      120     ub.trn-rsn-attr.attr-code  at row  1.25 col 20.50 colon-aligned view-as fill-in size-chars 25.50 by 1.00 label "&Код"      format "x(24)":U
      121     ub.trn-rsn-attr.attr-value at row  2.50 col 20.50 colon-aligned view-as fill-in size-chars 67.25 by 1.00 label "&Значение" format "x(80)":U
      122     r-rect-0            at row  3.75 col  1.50
      123       Btn_Exit          at row  4.00 col  2.50
      124       Btn_History       at row  4.00 col 67.75
      125     b-help         at row  4.00 col 78.00
      126       Btn_OK            at row  4.00 col 88.75
      127   with view-as dialog-box side-labels no-underline three-d scrollable
      128        title "":U default-button Btn_Exit cancel-button Btn_Exit.
      129   assign frame fr-D-pump-8 :scrollable = no.
      130   on choose of Btn_OK in frame fr-D-pump-8 do:
      131   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      132   if lookup(self :type
      133            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      134            ) = 0
      135   then do:
      136     message
      137       "$Workfile$"
      138       "Указанному интерфейсному элементу фокус не может быть передан" skip
      139       "Интерфейсный элемент" self :name  skip
      140       "Тип" self :type  skip
      141       "Процедура" this-procedure :file-name skip
      142       view-as alert-box .
      143   end.
      144   else do:
      145     apply "entry":u to self  .
      146     if focus :handle <> self :handle  then do:
      147       return no-apply .
      148     end.
      149   end.
      150     if p-mode = 'ПРОСМОТР':U then do: return. end.
      151     if ub.trn-rsn-attr.attr-code  :sensitive in frame fr-D-pump-8 then do: assign ub.trn-rsn-attr.attr-code.  end.
      152     if ub.trn-rsn-attr.attr-value :sensitive in frame fr-D-pump-8 then do: assign ub.trn-rsn-attr.attr-value. end.
      153     apply "GO":U to frame fr-D-pump-8.
      154   end.
      155   on choose of Btn_Exit in frame fr-D-pump-8 do:
      156   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      157   if lookup(self :type
      158            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      159            ) = 0
      160   then do:
      161     message
      162       "$Workfile$"
      163       "Указанному интерфейсному элементу фокус не может быть передан" skip
      164       "Интерфейсный элемент" self :name  skip
      165       "Тип" self :type  skip
      166       "Процедура" this-procedure :file-name skip
      167       view-as alert-box .
      168   end.
      169   else do:
      170     apply "entry":u to self  .
      171     if focus :handle <> self :handle  then do:
      172       return no-apply .
      173     end.
      174   end.
      175   end.
      176   on choose of Btn_History in frame fr-D-pump-8 do:
      177     define variable v-list as character no-undo.
      178   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      179   if lookup(self :type
      180            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      181            ) = 0
      182   then do:
      183     message
      184       "$Workfile$"
      185       "Указанному интерфейсному элементу фокус не может быть передан" skip
      186       "Интерфейсный элемент" self :name  skip
      187       "Тип" self :type  skip
      188       "Процедура" this-procedure :file-name skip
      189       view-as alert-box .
      190   end.
      191   else do:
      192     apply "entry":u to self  .
      193     if focus :handle <> self :handle  then do:
      194       return no-apply .
      195     end.
      196   end.
      197     run str/trscatrs.w (
      198       input        p-parent-proc,
      199       input        "":U,
      200       input        "code",
      201       input        ub.trn-rsn-attr.reason-code,
      202       input        "":U,
      203       input         ?  ,
      204       input-output v-list                ).
      205   end.
      206   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      207   on F1 of frame fr-D-pump-8 anywhere do:
      208     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame fr-D-pump-8. END.
      209     return no-apply.
      210   end.
      211   if valid-handle( active-window ) and frame fr-D-pump-8 :parent = ? then frame fr-D-pump-8 :parent = active-window.
      212   if current-window :window-state = window-minimized then do: current-window :window-state = window-normal. end.
      213   on window-close of frame fr-D-pump-8 do: apply "END-ERROR":U to self. end.
      214   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      215   on help of frame fr-D-pump-8
      216   do:
      217     run gbl/app_help.p
      218       (input this-procedure :file-name
      219       ,input ''
      220       ,input ?
      221       ) no-error.
      222     if error-status :error then do:
      223       message
      224         "Ошибка при вызове помощи"
      225         error-status :get-message(1)
      226         view-as alert-box .
      227     end.
      228   end.
      229   run minbtn-set in this-procedure .
      230   on choose of b-help in frame fr-D-pump-8
      231   do:
      232     apply "help":u to frame fr-D-pump-8 .
      233   end.
      234   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      235   procedure minbtn-set :
      236       do
      237           on error undo, return error return-value
      238           :
      239           define variable ii              as integer       no-undo .
      240           define variable fh              as widget-handle no-undo .
      241           define variable hh              as widget-handle no-undo .
      242           define variable v-h             as handle        extent 4 no-undo .
      243           define variable v-name-button   as character     no-undo .
      244           define variable v-help-old-x    as decimal       no-undo .
      245           define variable v-help-old-y    as decimal       no-undo .
      246           define variable v-help-old-size as decimal       no-undo .
      247           define variable v-frame-width   as decimal       no-undo .
      248           define variable jj              as integer       no-undo .
      249           do
      250               on error undo, return error
      251               :
      252               assign
      253                   v-frame-width = frame fr-D-pump-8:width - 0.3
      254                   fh            = frame fr-D-pump-8:first-child
      255                   hh            = fh:first-child
      256                   ii            = 1
      257                   .
      258               do while valid-handle(hh):
      259                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      260                   do:
      261                       case lc(hh:name) :
      262                           when "b-help" then
      263                               do:
      264                                   hh:load-image-up("cmp/b-help.bmp":u) .
      265                                   hh:load-image-down("cmp/b-help.bmp":u) .
      266                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      267                                   hh:TOOLTIP = "Помощь" .
      268                                   v-help-old-x = hh:column .
      269                                   v-help-old-y = hh:row    .
      270                                   v-help-old-size = hh:width .
      271                                   hh:width-chars = 2.5 .
      272                               end.
      273                           when "b-print" then
      274                               do:
      275                                   hh:load-image("cmp/b-print.bmp":u) .
      276                                   hh:TOOLTIP = "Печать" .
      277                                   v-h[ii] = hh:handle .
      278                                   ii = ii + 1 .
      279                                   hh:width-chars = 3 .
      280                               end.
      281                           when "b-history" or
      282                           when "b-hist" then
      283                               do:
      284                                   hh:load-image("cmp/b-hist.bmp":u) .
      285                                   hh:TOOLTIP = "История" .
      286                                   v-h[ii] = hh:handle .
      287                                   ii = ii + 1 .
      288                                   hh:width-chars = 3 .
      289                               end.
      290                           when "b-sch" then
      291                               do:
      292                                   hh:load-image("cmp/b-sch.bmp":u) .
      293                                   hh:TOOLTIP = "Установка Фильтра" .
      294                                   v-h[ii] = hh:handle .
      295                                   ii = ii + 1 .
      296                                   hh:width-chars = 3 .
      297                               end.
      298                           when "b-hist-user" then
      299                               do:
      300                                   hh:load-image("cmp/b-hist.bmp":u) .
      301                                   hh:TOOLTIP = "История пользователя" .
      302                                   ii = ii + 1 .
      303                               end.
      304                       end case.
      305                   end.
      306                   hh = hh:next-sibling.
      307               end.
      308               b-help:column = v-frame-width - b-help:width-chars.
      309               jj = 0.
      310               repeat ii = 4 to 1 by -1 :
      311                   if valid-handle (v-h[ii] ) then
      312                   do:
      313                       jj  = jj + 1 .
      314                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      315                       v-h[ii]:row    = v-help-old-y .
      316                   end.
      317               end.
      318           end.
      319       end.
      320   end procedure.
      321   Main-Block:
      322   do on error   undo Main-Block, leave Main-Block
      323      on end-key undo Main-Block, leave Main-Block :
      324     if not available buf_refer then do:
      325       message "Карточка основания (причины) создания документа не найдена!" view-as alert-box error.
      326       undo Main-Block, leave Main-Block.
      327     end.
      328     if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
      329       find ub.trn-rsn-attr no-lock where recid( ub.trn-rsn-attr ) = p-rec-id no-error.
      330       if not available ub.trn-rsn-attr then do:
      331         message "Карточка атрибута основания (причины) создания документа не найдена!" view-as alert-box error.
      332         undo Main-Block, leave Main-Block.
      333       end.
      334     end.
      335     enable Btn_Exit Btn_History b-help with frame fr-D-pump-8.
      336     if           p-mode = 'ДОБАВЛЕНИЕ':U then do:
      337       assign frame fr-D-pump-8 :title = "Карточка атрибута основания (причины) создания документа  -- " + p-mode.
      338       create ub.trn-rsn-attr.
      339       assign ub.trn-rsn-attr.reason-code = buf_refer.reason-code.
      340       assign ub.trn-rsn-attr.attr-code :fgcolor = 0.
      341       enable ub.trn-rsn-attr.attr-code Btn_OK with frame fr-D-pump-8.
      342       assign p-rec-id = recid( ub.trn-rsn-attr ).
      343     end. else if p-mode = 'ИЗМЕНЕНИЕ':U  then do:
      344       find ub.trn-rsn-attr exclusive-lock where recid( ub.trn-rsn-attr ) = p-rec-id.
      345       assign frame fr-D-pump-8 :title =
      346         substitute( 'Карточка атрибута "&1" основания (причины) создания документа  -- &2', ub.trn-rsn-attr.attr-code, p-mode ).
      347       assign ub.trn-rsn-attr.attr-code :fgcolor = 4.
      348       enable Btn_OK with frame fr-D-pump-8.
      349     end. else if p-mode = 'ПРОСМОТР':U  then do:
      350       assign frame fr-D-pump-8 :title =
      351         substitute( 'Карточка атрибута "&1" основания (причины) создания документа  -- &2', ub.trn-rsn-attr.attr-code, p-mode ).
      352       assign ub.trn-rsn-attr.attr-code  :fgcolor = 4
      353              ub.trn-rsn-attr.attr-value :fgcolor = 4.
      354     end.
      355     display ub.trn-rsn-attr.attr-code
      356             ub.trn-rsn-attr.attr-value
      357     with frame fr-D-pump-8.
      358     if p-mode <> 'ПРОСМОТР':U then do: enable ub.trn-rsn-attr.attr-value with frame fr-D-pump-8. end.
      359     wait-for go of frame fr-D-pump-8.
      360   end.
      361   hide frame fr-D-pump-8 no-pause.
