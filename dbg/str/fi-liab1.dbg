        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: fi-liab1.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: str/fi-liab1.p $":U .
        7   define variable vss-description as character no-undo init "финансовые обязательства".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   define input parameter parParentProc  as widget-handle no-undo.
      112   define input parameter number-menu as integer no-undo .
      113   define input parameter par-host-code like ub.clients.obj-code no-undo.
      114   define variable  bttns      as character no-undo.
      115   define variable  par-mode   as character no-undo.
      116   define variable  pardoc-rec as recid     no-undo.
      117   define variable  rid-list   as character no-undo.
      118   define variable  p-doc-type as character no-undo.
      119   define variable  p-status_  as character no-undo.
      120   define variable  p-char     as character no-undo init "".
      121   bttns    = "b-del,b-add,b-chg,b-lkp,b-exec-fo"   .
      122   case number-menu :
      123     when 0 then do:
      124        par-mode = 'фирма':U       .
      125        p-doc-type = ? .
      126        p-status_  = ? .
      127     end.
      128     when 1 then do:
      129        bttns    =  bttns   + ",no-B-PFO" .
      130        par-mode   = "doc-type":U .
      131        p-doc-type = 'при':U .
      132        p-status_  = ? .
      133     end.
      134     when 11 then do:
      135        bttns    =  bttns   + ",no-B-PFO" .
      136        par-mode   = "status":U .
      137        p-doc-type = 'при':U .
      138        p-status_  = 'новый':U .
      139     end.
      140     when 12 then do:
      141        bttns    = "b-lkp,b-exec-fo,no-B-PFO"   .
      142        par-mode   = "status":U .
      143        p-doc-type = 'при':U .
      144        p-status_  = 'факт':U .
      145     end.
      146     when 13 then do:
      147        bttns    = "b-del,b-chg,b-exec-fo,no-B-PFO"   .
      148        par-mode   = "status":U .
      149        p-doc-type = 'при':U .
      150        p-status_  = 'авто':U .
      151     end.
      152     when 14 then do:
      153        bttns    =  bttns   + ",no-B-PFO" .
      154        par-mode   = "doc-type":U .
      155        p-doc-type = 'при':U .
      156        p-status_  = ? .
      157        p-char = string(today).
      158     end.
      159     when 2 then do:
      160     par-mode   = "doc-type":U .
      161        p-doc-type = 'рас':U .
      162        p-status_  = ? .
      163     end.
      164     when 21 then do:
      165        par-mode   = "status":U .
      166        p-doc-type = 'рас':U .
      167        p-status_  = 'новый':U .
      168     end.
      169     when 210 then do:
      170        bttns    = "b-del,b-chg,b-exec-fo"   .
      171        par-mode   = "status":U .
      172        p-doc-type = 'рас':U .
      173        p-status_  = 'авто':U .
      174     end.
      175     when 22 then do:
      176     bttns    = "b-lkp,b-exec-fo"   .
      177        par-mode   = "status":U .
      178        p-doc-type = 'рас':U .
      179        p-status_  = 'факт':U .
      180     end.
      181     when 3 then do:
      182     par-mode   = "doc-type":U .
      183        p-doc-type = 'рас':U .
      184        p-status_  = ? .
      185   run str/fin-pob.w
      186   (   input parParentProc ,
      187       input bttns        ,
      188       input par-mode     ,
      189       input pardoc-rec   ,
      190       input par-host-code,
      191       input p-doc-type   ,
      192       input p-status_    ,
      193       input ""           ,
      194       output rid-list    ) no-error  .
      195   if error-status :error then do:
      196   message vss-workfile vss-revision vss-description skip
      197           "Ошибка при вызове fin-liab" skip
      198           error-status :get-message(1)
      199           view-as alert-box error .
      200           return error .
      201           end.
      202           return .
      203     end.
      204   end case.
      205   run str/fin-liab.w
      206   (   input parParentProc ,
      207       input bttns        ,
      208       input par-mode     ,
      209       input pardoc-rec   ,
      210       input par-host-code,
      211       input p-doc-type   ,
      212       input p-status_    ,
      213       input p-char       ,
      214       output rid-list    ) no-error  .
      215   if error-status :error then do:
      216   message vss-workfile vss-revision vss-description skip
      217           "Ошибка при вызове fin-liab" skip
      218           error-status :get-message(1)
      219           view-as alert-box error .
      220   return error .
      221   end.
