        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as handle    no-undo .
        3   define input  parameter p-doc-code    as character no-undo .
        4   define input  parameter p-artic       as character no-undo .
        5   define input  parameter p-prod-type   as character no-undo .
        6   define input  parameter p-prod-code   as integer   no-undo .
        7   define input  parameter p-doc-type    as logical   no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: showdoc.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: str/showdoc.p $":U .
       13   define variable vss-description as character no-undo init "Показать складской документ или документ переоценки".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75     define variable v-cntxt-db-num        as integer   no-undo .
       76     define variable v-cntxt-userid        as character no-undo .
       77     define variable v-cntxt-level         as character no-undo .
       78     define variable v-cntxt-host-code-obj as integer   no-undo .
       79     define variable v-cntxt-obj-type      as character no-undo .
       80     define variable v-cntxt-obj-code      as integer   no-undo .
       81     define variable v-cntxt-db-num-obj    as integer   no-undo .
       82     define variable v-cntxt-is-admin      as logical   no-undo .
       83   define variable v-line-rec as integer   no-undo .
       84   do
       85   on error undo, return error return-value
       86   :
       87   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88     run mainmenu_getcntxt in parparentproc
       89       (output v-cntxt-db-num
       90       ,output v-cntxt-userid
       91       ,output v-cntxt-level
       92       ,output v-cntxt-host-code-obj
       93       ,output v-cntxt-obj-type
       94       ,output v-cntxt-obj-code
       95       ,output v-cntxt-db-num-obj
       96       ,output v-cntxt-is-admin
       97       ) .
       98     define variable old-type     as character no-undo .
       99     define variable old-stat     as character no-undo .
      100     define variable old-flag     as logical   no-undo .
      101     define variable old-internal as logical   no-undo .
      102     define variable l-document-exist as logical no-undo .
      103     assign
      104       l-document-exist = false
      105     .
      106     case p-doc-type :
      107       when ?
      108       then do:
      109         run show-trn-doc
      110           (output l-document-exist
      111           ).
      112         if l-document-exist = false
      113         then do:
      114           run show-price-doc
      115             (output l-document-exist
      116             ).
      117         end.
      118         if not l-document-exist
      119         then do:
      120           message
      121             "Документ" p-doc-code "не найден"
      122             view-as alert-box .
      123         end.
      124       end.
      125       when true
      126       then do:
      127         run show-trn-doc in this-procedure
      128           (output l-document-exist
      129           ).
      130         if not l-document-exist
      131         then do:
      132           message
      133             "Складской документ" p-doc-code "не найден"
      134             view-as alert-box .
      135         end.
      136       end.
      137       when false
      138       then do:
      139         run show-price-doc in this-procedure
      140           (output l-document-exist
      141           ).
      142         if not l-document-exist
      143         then do:
      144           message
      145             "Акт переоценки" p-doc-code "не найден"
      146             view-as alert-box .
      147         end.
      148       end.
      149     end.
      150   end.
      151   procedure show-trn-doc :
      152     define output parameter p-document-exist as logical no-undo .
      153     define buffer buf_trn-doc for ub.trn-doc .
      154     define buffer buf_doc-line for ub.doc-line .
      155     do
      156     on error undo, return error return-value
      157     :
      158       assign
      159         p-document-exist = false
      160       .
      161       find buf_trn-doc no-lock
      162         where buf_trn-doc.doc-code = p-doc-code
      163         no-error.
      164       if available buf_trn-doc
      165       then do:
      166         assign
      167           p-document-exist = true
      168         .
      169         define variable v-ok as logical   no-undo .
      170         case buf_trn-doc.doc-type
      171         :
      172           when 'при':U
      173           then do:
      174   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      175   do:
      176     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      177       (input  v-cntxt-db-num
      178       ,input  v-cntxt-userid
      179       ,input  0
      180       ,input  'actn_income_lookup':U
      181       ,input  'object':U
      182       ,input  buf_trn-doc.host-code
      183       ,input  buf_trn-doc.obj-type
      184       ,input  buf_trn-doc.obj-code
      185       ,input  0
      186       ,input  0
      187       ,input  0
      188       ,input  true
      189       ,output v-ok
      190       )  .
      191   end.
      192           end.
      193           when 'рас':U
      194           then do:
      195   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      196   do:
      197     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      198       (input  v-cntxt-db-num
      199       ,input  v-cntxt-userid
      200       ,input  0
      201       ,input  'actn_expense_lookup':U
      202       ,input  'object':U
      203       ,input  buf_trn-doc.host-code
      204       ,input  buf_trn-doc.obj-type
      205       ,input  buf_trn-doc.obj-code
      206       ,input  0
      207       ,input  0
      208       ,input  0
      209       ,input  true
      210       ,output v-ok
      211       )  .
      212   end.
      213           end.
      214           when 'спи':U
      215           then do:
      216   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      217   do:
      218     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      219       (input  v-cntxt-db-num
      220       ,input  v-cntxt-userid
      221       ,input  0
      222       ,input  'actn_write-off_lookup':U
      223       ,input  'object':U
      224       ,input  buf_trn-doc.host-code
      225       ,input  buf_trn-doc.obj-type
      226       ,input  buf_trn-doc.obj-code
      227       ,input  0
      228       ,input  0
      229       ,input  0
      230       ,input  true
      231       ,output v-ok
      232       )  .
      233   end.
      234           end.
      235           when 'инв':U
      236           then do:
      237   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      238   do:
      239     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      240       (input  v-cntxt-db-num
      241       ,input  v-cntxt-userid
      242       ,input  0
      243       ,input  'actn_inventory_lookup':U
      244       ,input  'object':U
      245       ,input  buf_trn-doc.host-code
      246       ,input  buf_trn-doc.obj-type
      247       ,input  buf_trn-doc.obj-code
      248       ,input  0
      249       ,input  0
      250       ,input  0
      251       ,input  true
      252       ,output v-ok
      253       )  .
      254   end.
      255           end.
      256           when 'возврат':U
      257           then do:
      258   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      259   do:
      260     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      261       (input  v-cntxt-db-num
      262       ,input  v-cntxt-userid
      263       ,input  0
      264       ,input  'actn_return_lookup':U
      265       ,input  'object':U
      266       ,input  buf_trn-doc.host-code
      267       ,input  buf_trn-doc.obj-type
      268       ,input  buf_trn-doc.obj-code
      269       ,input  0
      270       ,input  0
      271       ,input  0
      272       ,input  true
      273       ,output v-ok
      274       )  .
      275   end.
      276           end.
      277           otherwise do:
      278             message
      279               vss-workfile vss-revision vss-description skip
      280               "Неизвестный тип документа" skip
      281               "Тип документа" trn-doc.doc-type skip
      282               "Код документа" trn-doc.doc-code skip
      283               view-as alert-box error .
      284             undo, return error return-value .
      285           end.
      286         end case .
      287         if v-ok <> true
      288         then do:
      289           return .
      290         end.
      291         if buf_trn-doc.ext-doc-type = 'es':U
      292         or buf_trn-doc.ext-doc-type = 'rs':U
      293         then do:
      294   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      295   do:
      296     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      297       (input  v-cntxt-db-num
      298       ,input  v-cntxt-userid
      299       ,input  0
      300       ,input  'actn_sale_lookup':U
      301       ,input  'object':U
      302       ,input  buf_trn-doc.host-code
      303       ,input  buf_trn-doc.obj-type
      304       ,input  buf_trn-doc.obj-code
      305       ,input  0
      306       ,input  0
      307       ,input  0
      308       ,input  true
      309       ,output v-ok
      310       )  .
      311   end.
      312           if v-ok <> true
      313           then do:
      314             return .
      315           end.
      316         end.
      317         assign
      318           v-line-rec = ?
      319         .
      320         if p-artic > ''
      321         then do:
      322           find buf_doc-line no-lock
      323             where buf_doc-line.doc-code  = buf_trn-doc.doc-code
      324               and buf_doc-line.artic     = p-artic
      325               and buf_doc-line.prod-type = p-prod-type
      326               and buf_doc-line.prod-code = p-prod-code
      327             no-error .
      328           if available buf_doc-line
      329           then do:
      330             assign
      331               v-line-rec = recid (buf_doc-line)
      332             .
      333           end.
      334           else do:
      335             message
      336               "В документе" p-doc-code skip
      337               "не найден товар" p-artic p-prod-type p-prod-code skip
      338               view-as alert-box .
      339           end.
      340         end.
      341         run str/trn-lkp.p
      342           (input parparentproc
      343           ,input recid(buf_trn-doc)
      344           ,input recid(buf_doc-line)
      345           ).
      346       end.
      347     end.
      348   end procedure.
      349   procedure show-price-doc :
      350     define output parameter p-document-exist as logical no-undo .
      351     define buffer buf_price-doc for ub.price-doc .
      352     define buffer buf_price-list for ub.price-list .
      353     do
      354     on error undo, return error return-value
      355     :
      356       assign
      357         p-document-exist = false
      358       .
      359       find buf_price-doc
      360         where buf_price-doc.doc-num = p-doc-code
      361         no-error.
      362       if available buf_price-doc
      363       then do:
      364         assign
      365           p-document-exist = true
      366         .
      367         define variable v-ok as logical   no-undo .
      368   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      369   do:
      370     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      371       (input  v-cntxt-db-num
      372       ,input  v-cntxt-userid
      373       ,input  0
      374       ,input  'actn_overvalue_lookup':U
      375       ,input  'object':U
      376       ,input  buf_price-doc.host-code
      377       ,input  buf_price-doc.obj-type
      378       ,input  buf_price-doc.obj-code
      379       ,input  0
      380       ,input  0
      381       ,input  0
      382       ,input  true
      383       ,output v-ok
      384       )  .
      385   end.
      386         if v-ok <> true
      387         then do:
      388           return .
      389         end.
      390         assign
      391           v-line-rec = ?
      392         .
      393         if p-artic > ''
      394         then do:
      395           find first buf_price-list no-lock
      396             where buf_price-list.doc-num   = buf_price-doc.doc-num
      397               and buf_price-list.artic     = p-artic
      398               and buf_price-list.prod-type = p-prod-type
      399               and buf_price-list.prod-code = p-prod-code
      400             no-error .
      401           if available buf_price-list
      402           then do:
      403             assign
      404               v-line-rec = recid(buf_price-list)
      405             .
      406           end.
      407           else do:
      408             message
      409               "В акте переоценки" p-doc-code skip
      410               "не найден товар" p-artic p-prod-type p-prod-code skip
      411               view-as alert-box .
      412           end.
      413         end.
      414         run str/pr-lkp.p
      415           (input parparentproc
      416           ,input recid(buf_price-doc)
      417           ).
      418       end.
      419     end.
      420   end procedure.
