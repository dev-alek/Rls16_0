      185   def
      186   new shared
      187   temp-table  obj-list no-undo
      188     field obj-type like ub.clients.obj-type
      189     field obj-code like ub.clients.obj-code
      190     field obj-name like ub.clients.obj-name
      191     field obj-id   as integer
