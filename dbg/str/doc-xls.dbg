     1246         undo, return error return-value .
     1247       end.
     1248       find first buf_doc-line-attr no-lock
     1249         where buf_doc-line-attr.doc-code  = p-doc-code
     1250           and buf_doc-line-attr.gds-code = p-gds-code
     1251           and buf_doc-line-attr.attr-code = p-code
     1252         no-error .
