      632   define new global shared variable g#library  as handle no-undo .
      633   define new global shared variable g#library2 as handle no-undo .
      634   define variable var-report-r-b as character no-undo .
      635   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      636   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      637     (output var-report-r-b
      638     )  .
      639   define variable g#report-num as integer no-undo .
      640   procedure OpenForExcel :
      641      define variable v-ch#ExcelApplication as com-handle no-undo .
      642      define variable v-ch#Workbook         as com-handle no-undo .
      643      define variable v-ch#Worksheet        as com-handle no-undo .
      644      os-delete value( string( session:temp-directory ) +
      645                                 "rpt" + string( g#report-num ) + ".txt":U ) .
      646      os-delete value( string( session:temp-directory ) +
      647                                 "rpt" + string( g#report-num ) + ".frm":U ) .
      648      os-delete value( string( session:temp-directory ) +
      649                                 "rpt" + string( g#report-num ) + ".txl":U ) .
      650      if Make-Excel
      651      then do:
      652         output stream ForExcel to value( string( session:temp-directory +
      653                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
      654         assign
      655            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
      656            number-list = 1
      657         .
      658         if make-excel-com
      659         then do:
      660   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      661   if valid-handle(ch#WorkSheet) then
      662   RELEASE OBJECT ch#WorkSheet no-error.
      663   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      664   if valid-handle(ch#Workbook) then
      665   RELEASE OBJECT ch#Workbook no-error.
      666   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      667   if valid-handle(ch#ExcelApplication) then
      668   RELEASE OBJECT ch#ExcelApplication no-error.
      669            create "Excel.Application" ch#excelApplication connect no-error.
      670            if error-status:error
      671            then do :
      672           create "Excel.Application" ch#excelApplication no-error.
      673       if error-status :error then do:
      674           message
      675           "Ошибка при запуске Excel" skip
      676           error-status :get-message(1) skip
      677           view-as alert-box error .
      678           undo, return error .
      679       end.
      680            end.
      681            assign
      682               num#str#  = 0.
      683               v-ch#excelApplication  = ch#excelApplication.
      684               v-ch#excelApplication:Interactive = false.
      685               v-ch#excelApplication:ScreenUpdating = false.
      686               v-ch#excelApplication:Visible = false.
      687               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
      688               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
      689               v-ch#Worksheet = ch#WorkSheet.
      690               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
      691               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
      692               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
      693               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
      694            no-error .
      695            if error-status:error
      696            then do:
      697               Make-Excel-com = false .
      698               Make-Excel = false .
      699               output Stream  ForExcel close.
      700               os-delete value( string( session:temp-directory ) +
      701                              "rpt" + string( g#report-num ) + ".txt":U ) .
      702               os-delete value( string( session:temp-directory ) +
      703                              "rpt" + string( g#report-num ) + ".frm":U ) .
      704               return.
      705            end.
      706         end.
      707      end.
      708   end.
      709   procedure CloseForExcel :
      710      define variable ii as integer no-undo .
      711      define variable vsheet-num as integer no-undo.
      712      if Make-Excel
      713      then  do:
      714         output Stream  ForExcel close.
      715         os-delete value( string( session:temp-directory ) +
      716                                "rpt" + string( g#report-num ) + ".txt":U ) .
      717         os-delete value( string( session:temp-directory ) +
      718                                "rpt" + string( g#report-num ) + ".frm":U ) .
      719         define buffer buf_sheetf for sheetf.
      720         find last buf_sheetf no-error .
      721         if available buf_sheetf
      722         then
      723            vsheet-num = buf_sheetf.sheet-num.
      724         if vsheet-num > 1
      725         then do:
      726            do ii = 2 to vsheet-num:
      727               os-delete value( string( session:temp-directory ) +
      728                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
      729            end.
      730         end.
      731   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      732   if valid-handle(ch#WorkSheet) then
      733   RELEASE OBJECT ch#WorkSheet no-error.
      734   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      735   if valid-handle(ch#Workbook) then
      736   RELEASE OBJECT ch#Workbook no-error.
      737   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      738   if valid-handle(ch#ExcelApplication) then
      739   RELEASE OBJECT ch#ExcelApplication no-error.
      740      end.
      741   end.
      742   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile: prtmpldf.i $ $Revision: 06dcfe20b136, 752, rls $".
      743   define variable c-point  as character no-undo .
      744   define variable tbl      as character no-undo .
      745   define variable join-tbl as character no-undo .
      746   define variable fld      as character no-undo .
      747   define variable lab      as character no-undo .
      748   define variable spr      as character no-undo .
      749   define variable v-size   as character no-undo .
      750   define variable v-format as character no-undo .
      751   define variable dim      as character no-undo .
      752   procedure prnfield-clear :
      753     define output parameter loc-fld as character no-undo.
      754     define output parameter loc-lab as character no-undo .
      755     define output parameter loc-spr as character no-undo .
      756     define output parameter loc-dim as character no-undo .
      757     define output parameter loc-size as character no-undo .
      758     define output parameter loc-format as character no-undo .
      759     define output parameter loc-type as character no-undo .
      760     assign
      761       loc-fld = ""
      762       loc-lab = ""
      763       loc-spr = ""
      764       loc-dim = "0"
      765       loc-size = "":U
      766       loc-format = "":U
      767       loc-type = "":U
      768     .
      769   end procedure .
      770   procedure prnfield-add :
      771     define input        parameter par-fld as character no-undo.
      772     define input        parameter par-lab as character no-undo .
      773     define input        parameter par-spr as character no-undo .
      774     define input        parameter par-size as integer no-undo .
      775     define input        parameter par-format as character no-undo .
      776     define input-output parameter loc-fld as character no-undo.
      777     define input-output parameter loc-lab as character no-undo .
      778     define input-output parameter loc-spr as character no-undo .
      779     define input-output parameter loc-size as character no-undo .
      780     define input-output parameter loc-format as character no-undo .
      781     define input-output parameter loc-dim as character no-undo .
      782     do
      783     on error undo, return error
      784     :
      785       assign
      786       loc-fld = if loc-dim = '0'
      787                 then par-fld
      788                 else (loc-fld + chr(44) + par-fld)
      789       loc-lab = if loc-dim = '0'
      790                 then par-lab
      791                 else (loc-lab + chr(44) + par-lab)
      792       loc-spr = if loc-dim = '0'
      793                 then par-spr
      794                 else (loc-spr + chr(44) + par-spr)
      795       loc-size = if loc-dim = '0'
      796                 then string(par-size)
      797                 else (loc-size + chr(44) + string(par-size))
      798       loc-format = if loc-dim = '0'
      799                 then par-format
      800                 else (loc-format + chr(4) + string(par-format))
      801       no-error
      802       .
      803       assign
      804       entry(num-entries(loc-dim), loc-dim) = string(integer(entry(num-entries(loc-dim), loc-dim)) + 1)
      805       no-error
      806       .
      807     end.
      808   end procedure.
      809   FUNCTION prnfield_get-fsize returns integer(
      810   input p-type as character,
      811   input p-format as character,
      812   input p-label as character
      813   ):
      814   define variable ii as integer no-undo .
      815   define variable v-max as integer no-undo .
      816     do
      817     on error undo, return error
      818     :
      819       do ii = 1 to num-entries(p-label, chr(32)):
      820         assign
      821         v-max = maximum(v-max, length(entry(ii, p-label, chr(32))))
      822         .
      823       end.
      824       if p-format = "99:99" then return MAXIMUM(v-max,8).
      825       CASE p-type:
      826          when 'C':U or when 'character':U then do:
      827           if p-format = "99:99" or p-format = "99:99-99:99" then return maximum(v-max, 8).
      828           else
      829           return maximum(v-max, integer(left-trim(right-trim(left-trim(left-trim(p-format, "X":U), "(":U), ")":U),">") )).
      830         end.
      831         when 'I':U or when 'D':U or when 'T':U or
      832         when 'integer':U or when 'decimal':U or when 'date':U
      833         then do:
      834           return maximum(v-max,length(p-format)).
      835         end.
      836         when 'L':U or when 'logical':U then do:
      837           return MAXIMUM(v-max, length(entry(1, p-format, chr(47))), length(entry(2, p-format, chr(47)))).
      838         end.
      839       END CASE.
      840     end.
      841   end FUNCTION.
      842   function prnfield_get-fformat returns character ( input p-data-type as character
      843                                           ,input p-format as character ):
      844   define variable v-excel-format as character no-undo .
      845   case p-data-type:
      846     when 'character':U then do:
      847       v-excel-format = "@".
      848     end.
      849     when 'integer':U then do:
      850       v-excel-format = "0".
      851     end.
      852     when 'decimal':U then do:
      853       v-excel-format = substitute("0.&1", fill("0", length(entry(2, p-format, ".")))) no-error.
      854     end.
      855     when 'date':U then do:
      856       v-excel-format = "d/m/yyyy".
      857     end.
      858     otherwise do:
      859       v-excel-format = "@".
      860     end.
      861   end.
      862   if v-excel-format = '' then
      863   v-excel-format = "@".
      864   return v-excel-format .
      865   end function.
      866   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      867   define variable v-waitfram-action01         as character   no-undo .
      868   define variable v-waitfram-action02         as character   no-undo .
      869   define variable v-waitfram-action03         as character   no-undo .
      870   define variable mWaitFramTextBeg            as character   no-undo.
      871   define variable mWaitFramTextEnd            as character   no-undo.
      872   define variable mWaitFramView               as logical     no-undo.
      873   define variable mWaitProcEvent              as logical     no-undo init yes.
      874   define variable mWaitFramInterval           as integer     no-undo init 1 .
      875   define variable mWaitFramStop               as logical     no-undo.
      876   define variable mWaitFramStopUser           as logical     no-undo.
      877   define variable mWaitFramStopTimeOut        as logical     no-undo.
      878   define variable mWaitFramStartProc          as datetime-tz no-undo.
      879   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      880   define button B-WaitFramStop auto-end-key
      881        label "Стоп"
      882        size 10 by 1 tooltip "Остоновить процесс".
      883   define button B-viewProcInfo
      884        label "Информация"
      885        size 15 by 1 tooltip "Информация о процесс".
      886   define frame waitfram
      887     v-waitfram-action01 format "x(72)" no-label skip
      888     v-waitfram-action02 format "x(72)" no-label skip
      889     v-waitfram-action03 format "x(72)" no-label skip
      890     B-viewProcInfo
      891     B-WaitFramStop at row 4 col 30
      892     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      893     .
      894   define new global shared variable mBatchMode as logical no-undo init ?.
      895   define variable mFramBachModHandle as handle no-undo.
      896   mFramBachModHandle = frame waitfram:handle.
      897   define variable mFameOldVis as logical no-undo.
      898   define variable mVisCUrentVin as logical no-undo.
      899   if session:batch-mode
      900   then
      901      mBatchMode = yes.
      902   if mBatchMode = ? then do:
      903     mVisCUrentVin = current-window:visible.
      904     mFameOldVis = mFramBachModHandle:visible.
      905     mFramBachModHandle:visible  = yes.
      906     mBatchMode = mFramBachModHandle:visible ne yes.
      907     mFramBachModHandle:visible = mFameOldVis.
      908     current-window:visible = mVisCUrentVin.
      909   end.
      910    if  log-manager:logfile-name ne ?
      911     then DO:
      912         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      913         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      914         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      915     end.
      916   on choose of B-WaitFramStop in frame waitfram
      917   do:
      918     mWaitFramStop = yes.
      919     mWaitFramStopUser = yes.
      920   end.
      921   function waitfram-check-timeout returns logical():
      922      define variable vtime as int64 no-undo.
      923      if mWaitFramStopTimeOut
      924      then
      925         return yes.
      926      vtime = ( now - mWaitFramStartProc ) / 1000 .
      927      if     mWaitFramTimeOut ne ?
      928         and mWaitFramTimeOut ne 0
      929         and mWaitFramTimeOut lt vtime
      930      then do:
      931         mWaitFramStopTimeOut = yes.
      932      end.
      933      return mWaitFramStopTimeOut.
      934   end.
      935   procedure waitfram-hide :
      936     if not session:batch-mode
      937     then do
      938     on error undo, return error return-value
      939     :
      940       pause 0 before-hide .
      941       if not mBatchMode then
      942         hide frame waitfram .
      943     if     not mWaitFramView
      944        and mWaitProcEvent
      945     then
      946       process events .
      947     end.
      948   end procedure.
      949   procedure waitfram-show :
      950     define input  parameter p-message as character no-undo .
      951     define variable v-left-margin as integer   no-undo .
      952     if not session:batch-mode
      953     then do
      954     on error undo, return error return-value
      955     :
      956       if length(p-message) <= 70 then do:
      957         assign
      958           v-left-margin = integer((70 - length(p-message)) / 2)
      959         .
      960         assign
      961           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      962         .
      963         assign
      964           v-waitfram-action01 = " "
      965           v-waitfram-action02 = " "
      966                                    + fill(" ", v-left-margin)
      967                                    + p-message
      968           v-waitfram-action03 = " "
      969         .
      970       end.
      971       else do:
      972         define variable vRindex1 as integer no-undo.
      973         define variable vRindex2 as integer no-undo.
      974         vRindex1 = r-index(p-message," ",70).
      975         if vRindex1 = 0
      976         then
      977            vRindex1 = 70.
      978         if length(p-message)  <= vRindex1 + 70 then do:
      979           assign
      980             v-waitfram-action01 = " "
      981             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      982             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      983           .
      984         end.
      985         else do:
      986           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      987           if vRindex2 <= vRindex1
      988           then
      989              vRindex2 = vRindex1 + 70.
      990           assign
      991             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      992             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      993             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      994           .
      995         end.
      996       end.
      997       B-viewProcInfo:visible   in frame waitfram = no.
      998       B-viewProcInfo:sensitive in frame waitfram = no.
      999       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1000       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1001       if  (   mWaitFramView
     1002          or  mWaitProcEvent)
     1003          and not mBatchMode
     1004       then
     1005          display
     1006             v-waitfram-action01 skip
     1007             v-waitfram-action02 skip
     1008             v-waitfram-action03 skip
     1009          with frame waitfram .
     1010       if     mWaitFramView
     1011          then do:
     1012             if     mWaitFramInterval ne ?
     1013                and not mBatchMode
     1014             then
     1015                wait-for go of frame waitfram pause mWaitFramInterval.
     1016          end.
     1017          else
     1018             if     mWaitProcEvent
     1019                and not mBatchMode
     1020             then
     1021                process events .
     1022     end.
     1023   end procedure.
     1024      procedure waitfram-show-this:
     1025         define input  parameter iInterval as int64 no-undo.
     1026         define variable vtime as int64 no-undo.
     1027         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1028         mWaitFramInterval = iInterval.
     1029         run waitfram-show (substitute("&1&2 &3&4" ,
     1030                                       mWaitFramTextBeg ,
     1031                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1032                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1033                                       mWaitFramTextEnd
     1034                                      )
     1035                           ).
     1036      end.
     1037      procedure WaitFramRunPause:
     1038         define input  parameter iInterval as dec no-undo.
     1039         define variable vStart  as datetime-tz no-undo.
     1040         define variable vend    as datetime-tz no-undo.
     1041         define variable vint as int64 no-undo.
     1042         define variable vOk as logical no-undo.
     1043         vStart = now.
     1044         vend   = vStart.
     1045         publish "WaitFramPause" (iInterval,output vOk).
     1046         vend   =  now.
     1047         vint = vend - vStart.
     1048         vint = iInterval - vint / 1000.
     1049         if     not mWaitFramStop
     1050            and (   vint > 0
     1051                 or (    not vOk
     1052                     and iInterval eq ?
     1053                     )
     1054                 )
     1055         then
     1056            run waitfram-show-this (iInterval).
     1057         vend   =  now.
     1058         vint = vend - vStart.
     1059         vint = iInterval - vint / 1000.
     1060         if     not mWaitFramStop
     1061            and vint > 0
     1062         then do:
     1063            run gbl/pause.p (vint * 1000).
     1064         end.
     1065         if iInterval ne ?
     1066         then
     1067            publish "WaitFramStop".
     1068         waitfram-check-timeout().
     1069      end.
     1070      procedure WaitFramWaitFor:
     1071         define input  parameter iInterval as dec no-undo.
     1072         assign
     1073            mWaitFramStartProc   = now
     1074            mWaitFramStopUser    = no
     1075            mWaitFramStopTimeOut = no
     1076         .
     1077         block-wait:
     1078         do while not mWaitFramStop:
     1079            run WaitFramRunPause (iInterval).
     1080            if  waitfram-check-timeout()
     1081            then do:
     1082               leave block-wait.
     1083            end.
     1084         end.
     1085         run waitfram-hide.
     1086      end.
     1087   procedure waitfram-join :
     1088     define input  parameter p-line-1  as character no-undo .
     1089     define input  parameter p-line-2  as character no-undo .
     1090     define input  parameter p-line-3  as character no-undo .
     1091     define output parameter p-message as character no-undo .
     1092     do
     1093     on error undo, return error return-value
     1094     :
     1095       assign
     1096         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1097                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1098                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1099       .
     1100     end.
     1101   end procedure.
     1102   function waitfram-join-function returns character
     1103     (input p-line-1 as character
     1104     ,input p-line-2 as character
     1105     ,input p-line-3 as character
     1106     ).
     1107     define variable v-message as character no-undo .
     1108     run waitfram-join in this-procedure
     1109       (input  p-line-1
     1110       ,input  p-line-2
     1111       ,input  p-line-3
     1112       ,output v-message
     1113       ) .
     1114     return v-message .
     1115   end function .
     1116   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1117   define new global shared variable g#trdcalib as handle no-undo.
     1118   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1119   procedure lineattr-value :
     1120     do
     1121     on error undo, return error return-value
     1122     :
     1123       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     1124       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1125       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     1126       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
     1127       define output parameter p-type     as character no-undo .
     1128       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1129       def var v-format         as character no-undo .
     1130       def var v-fillin_width   as integer   no-undo .
     1131       def var v-fillin_height  as integer   no-undo .
     1132       def var v-label          as character no-undo .
     1133       def var v-user-can-edit  as logical   no-undo .
     1134       def var v-output-display as logical   no-undo .
     1135       def var v-other          as character no-undo .
     1136       run lineattr-code in this-procedure
     1137         (input  p-code
     1138         ,output p-type
     1139         ,output v-format
     1140         ,output v-fillin_width
     1141         ,output v-fillin_height
     1142         ,output v-label
     1143         ,output v-user-can-edit
     1144         ,output v-output-display
     1145         ,output v-other
     1146         ) no-error .
     1147       if error-status :error then do:
     1148         undo, return error return-value .
     1149       end.
     1150       find first buf_doc-line-attr no-lock
     1151         where buf_doc-line-attr.doc-code  = p-doc-code
     1152           and buf_doc-line-attr.gds-code  = p-gds-code
     1153           and buf_doc-line-attr.attr-code = p-code
     1154         no-error .
     1155       if avail buf_doc-line-attr then do:
     1156         assign
     1157           p-value =  buf_doc-line-attr.attr-value
     1158         .
     1159       end.
     1160       else do:
     1161         assign
     1162           p-value = if p-type = 'L':U then "no":U else ""
     1163         .
     1164       end.
     1165     end.
     1166   end procedure.
     1167   procedure lineattr-write :
     1168     do
     1169     on error undo, return error return-value
     1170     :
     1171       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     1172       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1173       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     1174       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
     1175       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1176       def var v-type           as character no-undo .
     1177       def var v-format         as character no-undo .
     1178       def var v-fillin_width   as integer   no-undo .
     1179       def var v-fillin_height  as integer   no-undo .
     1180       def var v-label          as character no-undo .
     1181       def var v-user-can-edit  as logical   no-undo .
     1182       def var v-output-display as logical   no-undo .
     1183       def var v-other          as character no-undo .
     1184       run lineattr-code in this-procedure
     1185         (input  p-code
     1186         ,output v-type
     1187         ,output v-format
     1188         ,output v-fillin_width
     1189         ,output v-fillin_height
     1190         ,output v-label
     1191         ,output v-user-can-edit
     1192         ,output v-output-display
     1193         ,output v-other
     1194         ) no-error .
     1195       if error-status :error then do:
     1196         undo, return error return-value .
     1197       end.
     1198       find first buf_doc-line-attr exclusive-lock
     1199         where buf_doc-line-attr.doc-code  = p-doc-code
     1200           and buf_doc-line-attr.gds-code  = p-gds-code
     1201           and buf_doc-line-attr.attr-code = p-code
     1202         no-error .
     1203       if not available buf_doc-line-attr then do:
     1204         create buf_doc-line-attr .
     1205         assign
     1206           buf_doc-line-attr.doc-code  = p-doc-code
     1207           buf_doc-line-attr.gds-code = p-gds-code
     1208           buf_doc-line-attr.attr-code = p-code
     1209         .
     1210       end.
     1211       assign
     1212         buf_doc-line-attr.attr-value = p-value
     1213       .
     1214        release buf_doc-line-attr.
     1215     end.
     1216   end procedure.
     1217   procedure lineattr-exist :
