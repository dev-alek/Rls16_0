     1256     end.
     1257   end procedure.
     1258   procedure lineattr-delete :
     1259     do
     1260     on error undo, return error return-value
     1261     :
     1262       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     1263       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1264       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     1265       define output parameter p-deleted  as logical no-undo.
     1266       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1267       def var v-type           as character no-undo .
     1268       def var v-format         as character no-undo .
     1269       def var v-fillin_width   as integer   no-undo .
     1270       def var v-fillin_height  as integer   no-undo .
     1271       def var v-label          as character no-undo .
     1272       def var v-user-can-edit  as logical   no-undo .
     1273       def var v-output-display as logical   no-undo .
     1274       def var v-other          as character no-undo .
     1275       run lineattr-code in this-procedure
     1276         (input  p-code
     1277         ,output v-type
     1278         ,output v-format
     1279         ,output v-fillin_width
     1280         ,output v-fillin_height
     1281         ,output v-label
     1282         ,output v-user-can-edit
     1283         ,output v-output-display
     1284         ,output v-other
     1285         ) no-error .
     1286       if error-status :error then do:
     1287         undo, return error return-value .
     1288       end.
     1289       find first buf_doc-line-attr exclusive-lock
     1290         where buf_doc-line-attr.doc-code  = p-doc-code
     1291           and buf_doc-line-attr.gds-code  = p-gds-code
     1292           and buf_doc-line-attr.attr-code = p-code
     1293         no-error NO-WAIT.
     1294       if not available buf_doc-line-attr then do:
     1295         p-deleted = no.
     1296       end.
     1297       else do:
     1298         delete buf_doc-line-attr.
     1299         p-deleted = yes.
     1300       end.
     1301     end.
     1302   end procedure.
     1303   procedure lineattr-code :
     1304     do on error undo, return error return-value
     1305     :
     1306       define input  parameter p-code           as character no-undo .
     1307       define output parameter p-type           as character no-undo .
     1308       define output parameter p-format         as character no-undo .
     1309       define output parameter p-fillin_width   as integer   no-undo .
     1310       define output parameter p-fillin_height  as integer   no-undo .
     1311       define output parameter p-label          as character no-undo .
     1312       define output parameter p-user-can-edit  as logical   no-undo .
     1313       define output parameter p-output-display as logical   no-undo .
     1314       define output parameter p-other          as character no-undo .
     1315       case p-code :
     1316               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1317               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1318               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1319               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1320               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     1321               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1322               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1323               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1324               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     1325               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     1326               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     1327         otherwise do:
     1328           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
     1329         end.
     1330       end.
     1331     end.
     1332   end procedure.
     1333   procedure lineattr-value-flora-gds :
     1334     do
     1335     on error undo, return error return-value
     1336     :
     1337       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     1338       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     1339       define input  parameter p-prt-code    as integer   no-undo .
     1340       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
     1341       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
     1342       define output parameter p-value       as    decimal   no-undo .
     1343       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1344       find first buf_doc-line-attr no-lock
     1345         where buf_doc-line-attr.doc-code  = p-doc-code
     1346           and buf_doc-line-attr.gds-code  = p-gds-code
     1347           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     1348         no-error .
     1349       if avail buf_doc-line-attr then do:
     1350         assign
     1351           p-value = decimal( buf_doc-line-attr.attr-value)
     1352         .
     1353       end.
     1354       else do:
     1355         assign
     1356           p-value = 0
     1357         .
     1358       end.
     1359     end.
     1360   end procedure.
     1361   procedure lineattr-write-flora-gds :
     1362     do
     1363     on error undo, return error return-value
     1364     :
     1365       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     1366       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1367       define input parameter p-prt-code    as integer   no-undo .
     1368       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1369       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     1370       define input parameter p-value    as decimal   no-undo .
     1371       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1372       find first buf_doc-line-attr exclusive-lock
     1373         where buf_doc-line-attr.doc-code  = p-doc-code
     1374           and buf_doc-line-attr.gds-code  = p-gds-code
     1375           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     1376         no-error .
     1377       if not available buf_doc-line-attr then do:
     1378         create buf_doc-line-attr .
     1379         assign
     1380           buf_doc-line-attr.doc-code  = p-doc-code
     1381           buf_doc-line-attr.gds-code  = p-gds-code
     1382           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     1383         .
     1384       end.
     1385       assign
     1386         buf_doc-line-attr.attr-value = string( p-value )
     1387       .
     1388     end.
     1389   end procedure.
     1390   procedure lineattr-delete-flora-gds :
     1391     do
     1392     on error undo, return error return-value
     1393     :
     1394       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     1395       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1396       define input  parameter p-prt-code    as integer   no-undo .
     1397       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1398       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     1399       define output parameter p-deleted  as logical no-undo.
     1400       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1401       find first buf_doc-line-attr exclusive-lock
     1402         where buf_doc-line-attr.doc-code  = p-doc-code
     1403           and buf_doc-line-attr.gds-code  = p-gds-code
     1404           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     1405         no-error NO-WAIT.
     1406       if not available buf_doc-line-attr then do:
     1407         p-deleted = no.
     1408       end.
     1409       else do:
     1410         delete buf_doc-line-attr.
     1411         p-deleted = yes.
     1412       end.
     1413     end.
     1414   end procedure.
     1415   procedure lineattr-delete-flora-all :
     1416     do
     1417     on error undo, return error return-value
     1418     :
     1419       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     1420       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1421       define input  parameter p-prt-code    as integer   no-undo .
     1422       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1423       for each buf_doc-line-attr exclusive-lock
     1424         where buf_doc-line-attr.doc-code  = p-doc-code
     1425           and buf_doc-line-attr.gds-code  = p-gds-code
     1426           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
     1427        :
     1428         delete buf_doc-line-attr.
     1429       end.
     1430    end.
     1431   end procedure.
     1432   procedure lineattr-exist-flora-gds :
     1433     do
     1434     on error undo, return error return-value
     1435     :
     1436       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     1437       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     1438       define input  parameter p-prt-code    as integer   no-undo .
     1439       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
     1440       define output parameter p-exist as logical   no-undo .
     1441       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1442       p-exist = false .
     1443       find first buf_doc-line-attr no-lock
     1444         where buf_doc-line-attr.doc-code  = p-doc-code
     1445           and buf_doc-line-attr.gds-code  = p-gds-code
     1446           and buf_doc-line-attr.attr-code = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     1447         no-error .
     1448       if avail buf_doc-line-attr then do:
     1449         assign
     1450          p-exist = true
     1451         .
     1452       end.
     1453     end.
     1454   end procedure.
     1455   procedure lineattr-write-add-line-cli :
     1456   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     1457   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     1458   define input  parameter p-cli-type      as character no-undo .
     1459   define input  parameter p-cli-code      as integer   no-undo .
     1460   define input  parameter p-contract-code as integer   no-undo .
     1461   define input  parameter p-host-code     as integer   no-undo .
     1462   define input  parameter p-exch-code     as integer   no-undo .
     1463   define input  parameter p-exch-rate     as decimal   no-undo .
     1464   define input  parameter p-exch-scale    as integer   no-undo .
     1465   define input  parameter p-sum-cli       as decimal   no-undo .
     1466   define input  parameter p-sum-vat       as decimal   no-undo .
     1467   define buffer buf_doc-line-attr for ub.doc-line-attr .
     1468     do
     1469     on error undo, return error return-value
     1470     :
     1471       find first buf_doc-line-attr exclusive-lock
     1472         where buf_doc-line-attr.doc-code  = p-doc-code
     1473           and buf_doc-line-attr.gds-code  = p-gds-code
     1474           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     1475                                             chr(4) + p-cli-type +
     1476                                             chr(4) + string(p-cli-code) +
     1477                                             chr(4) + string(p-contract-code) +
     1478                                             chr(4) + string(p-host-code)
     1479         no-error .
     1480       if not available buf_doc-line-attr then do:
     1481         create buf_doc-line-attr .
     1482         assign
     1483           buf_doc-line-attr.doc-code  = p-doc-code
     1484           buf_doc-line-attr.gds-code  = p-gds-code
     1485           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
     1486                                         chr(4) + p-cli-type +
     1487                                         chr(4) + string(p-cli-code) +
     1488                                         chr(4) + string(p-contract-code) +
     1489                                         chr(4) + string(p-host-code)
     1490         .
     1491       end.
     1492       assign
     1493         buf_doc-line-attr.attr-value =
     1494         string(p-exch-code)  + chr(4) +
     1495         string(p-exch-rate)  + chr(4) +
     1496         string(p-exch-scale) + chr(4) +
     1497         string(p-sum-cli)    + chr(4) +
     1498         string(p-sum-vat)
     1499         .
     1500     end.
     1501   end procedure.
     1502   procedure lineattr-value-add-line-cli :
     1503   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     1504   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     1505   define input   parameter p-cli-type      as character no-undo .
     1506   define input   parameter p-cli-code      as integer   no-undo .
     1507   define input   parameter p-contract-code as integer   no-undo .
     1508   define input   parameter p-host-code     as integer   no-undo .
     1509   define output  parameter p-exch-code     as integer   no-undo .
     1510   define output  parameter p-exch-rate     as decimal   no-undo .
     1511   define output  parameter p-exch-scale    as integer   no-undo .
     1512   define output  parameter p-sum-cli       as decimal   no-undo .
     1513   define output  parameter p-sum-vat       as decimal   no-undo .
     1514   define buffer buf_doc-line-attr for ub.doc-line-attr .
     1515     do
     1516     on error undo, return error return-value
     1517     :
     1518       find first buf_doc-line-attr exclusive-lock
     1519         where buf_doc-line-attr.doc-code  = p-doc-code
     1520           and buf_doc-line-attr.gds-code  = p-gds-code
     1521           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     1522                                             chr(4) + p-cli-type +
     1523                                             chr(4) + string(p-cli-code) +
     1524                                             chr(4) + string(p-contract-code) +
     1525                                             chr(4) + string(p-host-code)
     1526         no-error .
     1527       if available buf_doc-line-attr then do:
     1528        assign
     1529           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
     1530           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
     1531           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
     1532           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
     1533           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
     1534          .
     1535        end.
     1536     end.
     1537   end procedure.
     1538   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
     1539     define variable v-code as character no-undo .
     1540     define variable v-type as character no-undo .
     1541     define variable v-gds-code as integer   no-undo .
     1542   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1543   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1544     (input  local-doc-line.artic
     1545     ,input  local-doc-line.prod-type
     1546     ,input  local-doc-line.prod-code
     1547     ,output v-gds-code
     1548     )  .
     1549     run lineattr-value (
     1550         input   local-doc-line.doc-code ,
     1551         input   v-gds-code              ,
     1552         input   'reason-code':U ,
     1553         output  v-code                  ,
     1554         output  v-type ) .
     1555     find first ub.trn-reason no-lock where
     1556                ub.trn-reason.reason-code = integer ( v-code ) no-error.
     1557     if not available ub.trn-reason then do:
     1558        return "" .
     1559     end.
     1560     else do:
     1561        return ub.trn-reason.reason-name .
     1562     end.
     1563   end function.
     1564   procedure lineattr-value-parts :
     1565     do
     1566     on error undo, return error return-value
     1567     :
     1568       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     1569       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     1570       define input  parameter p-part-code   as character no-undo .
     1571       define input  parameter p_in-code     as character no-undo .
     1572       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
     1573       define output parameter p-value       as    decimal   no-undo .
     1574       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1575       find first buf_doc-line-attr no-lock
     1576         where buf_doc-line-attr.doc-code  = p-doc-code
     1577           and buf_doc-line-attr.gds-code  = p-gds-code
     1578           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
     1579         no-error .
     1580       if avail buf_doc-line-attr then do:
     1581         assign
     1582           p-value = decimal( buf_doc-line-attr.attr-value)
     1583         .
     1584       end.
     1585       else do:
     1586         assign
     1587           p-value = 0
     1588         .
     1589       end.
     1590     end.
     1591   end procedure.
     1592   procedure lineattr-write-parts :
     1593     do
     1594     on error undo, return error return-value
     1595     :
     1596       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     1597       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1598       define input parameter p-part-code  as character no-undo .
     1599       define input parameter p_in-code    as character no-undo .
     1600       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
     1601       define input parameter p-value      as decimal   no-undo .
     1602       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1603       find first buf_doc-line-attr exclusive-lock
     1604         where buf_doc-line-attr.doc-code  = p-doc-code
     1605           and buf_doc-line-attr.gds-code  = p-gds-code
     1606           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
     1607         no-error .
     1608       if not available buf_doc-line-attr then do:
     1609         create buf_doc-line-attr .
     1610         assign
     1611           buf_doc-line-attr.doc-code  = p-doc-code
     1612           buf_doc-line-attr.gds-code  = p-gds-code
     1613           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
     1614         .
     1615       end.
     1616       assign
     1617         buf_doc-line-attr.attr-value = string( p-value )
     1618       .
     1619     end.
     1620   end procedure.
     1621   define variable icolumn   as integer no-undo.
     1622   define variable ii as integer no-undo.
     1623   define variable vat-value like ub.doc-line.vat-pc no-undo .
     1624   define variable slt-value like ub.doc-line.slt-pc no-undo .
     1625   define variable v-rec as recid no-undo .
     1626   define variable jj as integer no-undo .
     1627   define variable jj-1 as integer no-undo .
     1628   define variable j-n as integer no-undo .
     1629   define variable f-value as character no-undo .
     1630   define variable f-value-1 as character no-undo .
     1631   define variable f-name as character no-undo .
     1632   define variable f-name-1 as character no-undo .
     1633   define variable f-n as character no-undo .
     1634   define variable v-length as integer no-undo .
     1635   define variable v-num-clmn as integer no-undo .
     1636   define variable v-bc-ne as integer no-undo .
     1637   define variable v-pbc-ne as integer no-undo .
     1638   define variable v-host-code like ub.sysconf.host-code no-undo .
     1639   define variable v-f-name like ub.gds-prt.f-name no-undo .
     1640   define variable v-osn-frm as character no-undo .
     1641   define variable v-eng-frm as character no-undo .
     1642   define variable bar-code-field-handle as handle no-undo .
     1643   define variable prod-bc-field-handle as handle no-undo .
     1644   define variable v-recid_file as recid no-undo extent 3.
     1645   define buffer buf_filter for ubflt.filter.
     1646   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1647   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1648     (input  p-curr-obj-type
     1649     ,input  p-curr-obj-code
     1650     ,output v-host-code
     1651     )  .
     1652   FUNCTION get-function returns character(
     1653   input p-f-name as character,
     1654   input p-format as character) :
     1655     do
     1656     on error undo, return error
     1657     :
     1658       CASE p-f-name:
     1659         when "iColumn":U then do:
     1660           return string(iColumn, p-format).
     1661         end.
     1662         when "qnty":U then do:
     1663           return string(doc-list.fact-num,  p-format).
     1664         end.
     1665       END CASE.
     1666     end.
     1667   end FUNCTION.
     1668   run init-prn-template in this-procedure .
     1669   run gbl/prntput.p (c-point, output v-rec).
     1670   run gbl/prntmpl.w (
     1671                   input parparentproc
     1672                 , input "":U
     1673                 , input c-point
     1674                 , input Tbl
     1675                 , input join-tbl
     1676                 , input Fld
     1677                 , input Lab
     1678                 , input Spr
     1679                 , input v-size
     1680                 , input v-format
     1681                 , input Dim
     1682                 , input-output v-rec
     1683                 , OUTPUT V-LENGTH
     1684                 , OUTPUT V-NUM-CLMN
     1685               ).
     1686   if v-rec = ? then return.
     1687   find first ubflt.filter no-lock where
     1688              recid(ubflt.filter) = v-rec no-error .
     1689   if not avail ubflt.filter then return.
     1690   do ii = 1 to 3:
     1691     find first _file no-lock where
     1692               _file._file-name = entry(ii, 'trn-doc,price-doc,inkas').
     1693     assign
     1694     v-recid_file[ii] = recid(_file).
     1695   end.
     1696   do jj = 1 to num-entries(ubflt.filter.Fields-sort):
     1697     assign
     1698     f-name-1 = "":U
     1699     .
     1700     do jj-1 = 1 to num-entries(entry(jj, ubflt.filter.Fields-sort), "*":U):
     1701       case entry(1, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), "."):
     1702         when "trn-doc":U  then do:
     1703           f-n = entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U)    .
     1704         end.
     1705         when "doc-attr":U then do:
     1706           assign
     1707           f-n = entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U)
     1708           .
     1709         end.
     1710         when "function":U then do:
     1711           assign
     1712           f-n = entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U)
     1713           .
     1714         end.
     1715       END CASE.
     1716       assign
     1717       f-name-1 = f-name-1 + (if f-name-1 = "":U then "":U else "*":U) + f-n
     1718       .
     1719     end.
     1720     assign
     1721     f-name = f-name + (if f-name = "":U then "":U else chr(44)) + f-name-1
     1722     .
     1723   end.
     1724   assign
     1725   j-n = num-entries(f-name)
     1726   .
     1727   Make-excel = yes.
     1728   run get-report-num  in parParentProc(output g#report-num).
     1729   if Make-Excel then
     1730   RUN OpenForExcel in this-procedure .
     1731   FOR EACH sheetf where sheetf.sheet-num > 1:
     1732     delete sheetf.
     1733   end.
     1734   FIND FIRST sheetf where
     1735              sheetf.sheet-num = 1 No-ERROR.
     1736   assign
     1737   ReportName = "Список документов"
     1738   sheetf.Excel-Column-Lable = ubflt.filter.Fields-sort-rus
     1739   sheetf.sizes = ubflt.filter.Where-ysl
     1740   .
     1741   run waitfram-show in this-procedure ("Экспорт в EXCEL. Ждите ...").
     1742   run rep/extitle.p (1).
     1743   iColumn = 0.
     1744   define variable v-name-field as character no-undo .
     1745   define variable v-type as character no-undo .
     1746   FOR EACH doc-list no-lock :
     1747     if (iColumn modulo 10) = 0 then  run waitfram-show in this-procedure ("Экспортировано в EXCEL строк : " + string (iColumn)).
     1748     assign
     1749       iColumn = iColumn + 1
     1750     .
     1751     do jj = 1 to j-n:
     1752       assign
     1753       f-value = "":U
     1754       .
     1755       CASE entry(1, entry(jj, f-name), ".") :
     1756         when "doc-attr":U then do:
     1757   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input doc-list.doc-code ,
     1758                           input entry( 2, ( entry( jj, ubflt.filter.Fields-sort ) ), '.' ) ,
     1759                          output f-value ,
     1760                          output v-type )  .
     1761         end.
     1762         when "function":U then do:
     1763                 f-value = get-function(substr(entry(jj, f-name) , 10 ), entry(jj, ubflt.filter.Where-ysl-rus, chr(4))) .
     1764         end.
     1765         otherwise do:
     1766           if index(entry(jj, f-name), "*":U) > 0 then do:
     1767             do jj-1 = 1 to num-entries(entry(jj, f-name), "*":U):
     1768               assign
     1769               f-value-1 = "":U.
     1770               assign
     1771               f-value = f-value + (if f-value = "":U then "":U else chr(32)) + f-value-1
     1772               .
     1773             end.
     1774           end.
     1775           else do:
     1776              v-name-field = entry(jj, ubflt.filter.Fields-sort) .
     1777               run ret-value (
     1778                    input   doc-list.doc-type
     1779                  , input   entry( 1 , v-name-field , "." )
     1780                  , input   doc-list.doc-code
     1781                  , input   entry(2 , v-name-field  , "." )
     1782                  , output  f-value   ).
     1783           end.
     1784           .
     1785         end.
     1786       END CASE.
     1787        if (entry( jj , ubflt.filter.lst-cend) = 'T':U or
     1788            entry( jj , ubflt.filter.lst-cend) = "date":U )
     1789            or
     1790            entry( jj , ubflt.filter.Where-ysl-rus, chr(4) ) = "99:99"
     1791           then
     1792               assign
     1793                 f-value =  SUBSTITUTE ('="&1"', f-value) .
     1794                 .
     1795           if Make-Excel then  put   stream ForExcel unformatted
     1796             string(f-value, substitute("X(&1)", entry( jj , ubflt.filter.Where-ysl)))
     1797             (if jj < j-n
     1798             then CHR(9)
     1799             else chr(10))
     1800             .
     1801     end.
     1802   END.
     1803   sheetf.colformat = v-osn-frm + chr(4) + v-eng-frm.
     1804   if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     1805   FInd first Sheetf where
     1806              Sheetf.sheet-num = 2 No-ERROR.
     1807   if not avail sheetf then
     1808   create sheetf.
     1809   assign
     1810   Sheetf.Sheet-num = 2
     1811   sheetf.Excel-Column-Lable =  "№ п/п,Действие,Записей,итого,Множество"
     1812   sheetf.sizes = "9,9,9,12,155"
     1813   .
     1814   run rep/extitle.p (2).
     1815   run waitfram-show in this-procedure ("Экспорт в EXCEL истории").
     1816   for each doc-list-hist:
     1817     if Make-Excel then  put   stream ForExcel unformatted
     1818     (if doc-list-hist.line = 0
     1819      then string(doc-list-hist.id, ">>>>>>>>9")
     1820      else '':U)
     1821     CHR(9)
     1822     (if doc-list-hist.item_ <> '':U
     1823      then doc-list-hist.hist-mode
     1824      else '':U)  CHR(9)
     1825      (if doc-list-hist.item_ <> '':U
     1826      then string(doc-list-hist.num-add, "->>>>>>>>9")
     1827      else '':U)  CHR(9)
     1828     (if doc-list-hist.item_ <> '':U
     1829     then string(doc-list-hist.num-recs, ">>>>>>>>9")
     1830     else '':U)  CHR(9)
     1831     doc-list-hist.des
     1832     skip.
     1833   end.
     1834   run waitfram-hide in this-procedure .
     1835   if Make-Excel then output stream ForExcel close.
     1836   run waitfram-hide in this-procedure .
     1837   if Make-Excel then do:
     1838      run rep/runexcel.p (
     1839                      string( session:temp-directory +
     1840                            "rpt" +
     1841                            string( g#report-num ) + ".txt":U )
     1842                    ) .
     1843   end.
     1844   if Make-Excel then
     1845   RUN CLoseForExcel in this-procedure .
     1846   procedure init-prn-template :
     1847   define variable na                   as integer            no-undo .
     1848   DEFINE VARIABLE vtooltip             as character           no-undo.
     1849   DEFINE VARIABLE vlabel               as character           no-undo .
     1850   DEFINE VARIABLE vtype                as character           no-undo .
     1851   DEFINE VARIABLE vformat              as character           no-undo .
