     2000         end.
     2001       end.
     2002       assign
     2003       fld = fld
     2004       lab = lab
     2005       dim = dim + chr(44)
     2006       .
     2007       run prnfield-add in this-procedure('iColumn', '№', 'function.integer', 7, ">>>>>>9":U,
     2008       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-format, input-output dim)  no-error.
     2009     end.
     2010   end procedure.
     2011   procedure ret-value :
     2012     do
     2013     on error undo, return error return-value
     2014     :
     2015   define input  parameter p-doc-type as character no-undo .
     2016   define input  parameter p-table as character no-undo .
     2017   define input  parameter p-doc-code as character no-undo .
     2018   define input  parameter p-pole as character no-undo .
     2019   define output parameter p-ret as character no-undo .
     2020   DEFINE VARIABLE ii AS INTEGER no-undo .
     2021   DEFINE VARIABLE qh AS WIDGET-HANDLE no-undo .
     2022   define variable usl as character no-undo .
     2023   define variable v-trn-doc as character no-undo .
     2024   define variable v-doc-num-field as character no-undo .
     2025   DEFINE VARIABLE buf_din_trn-doc AS WIDGET-HANDLE.
     2026   define buffer BUF_field for ub._field.
     2027     CASE p-doc-type:
     2028       when 'касс':U then do:
     2029         assign
     2030         ii = LOOKUP('INKAS', 'trn-doc,price-doc,inkas')
     2031         v-trn-doc = "inkas"
     2032         v-doc-num-field = "inkas-code"
     2033         .
     2034       end.
     2035       when 'переоценка':U then do:
     2036         assign
     2037         ii = LOOKUP('PRICE-DOC', 'trn-doc,price-doc,inkas')
     2038         v-trn-doc = "price-doc"
     2039         v-doc-num-field = "doc-num"
     2040         .
     2041       end.
     2042       OTHERWISE do:
     2043         assign
     2044         ii = LOOKUP('TRN-DOC', 'trn-doc,price-doc,inkas')
     2045         v-trn-doc = "trn-doc"
     2046         v-doc-num-field = "doc-code"
     2047         .
     2048       end.
     2049     END CASE.
     2050     if lookup(p-table + '.' + p-pole, 'trn-doc.doc-code,inkas.inkas-code,price-doc.doc-num') > 0 then do:
     2051       assign
     2052       p-ret = p-doc-code
     2053       .
     2054       return.
     2055     end.
     2056     else do:
     2057       find first buf_field no-lock where
     2058                 buf_field._file-recid = v-recid_FILE[II]
     2059             AND buf_field._field-name = p-pole no-error .
     2060       if not available buf_field then do:
     2061         if v-trn-doc = "inkas" then do:
     2062           find first buf_field no-lock where
     2063                     buf_field._file-recid = v-recid_FILE[LOOKUP('TRN-DOC', 'trn-doc,price-doc,inkas')]
     2064                 AND buf_field._field-name = p-pole no-error .
     2065           if available buf_field then do:
     2066             assign
     2067             v-doc-num-field = 'doc-code'
     2068             v-trn-doc = 'trn-doc'.
     2069           end.
     2070           else do:
     2071             assign
     2072             p-ret = '[Не определено]'.
     2073             return.
     2074           end.
     2075         end.
     2076         else do:
     2077           assign
     2078           p-ret = '[Не определено]'.
     2079           return.
     2080         end.
     2081       end.
     2082     end.
     2083     CREATE BUFFER buf_din_trn-doc FOR TABLE v-trn-doc.
     2084     CREATE QUERY qh.
     2085     usl = SUBSTITUTE ( "for each &2 no-lock  where  &2.&3 = '&1' " , p-doc-code, v-trn-doc, v-doc-num-field )    .
     2086     qh:SET-BUFFERS  ( buf_din_trn-doc ).
     2087     qh:QUERY-PREPARE ( usl ).
     2088     qh:QUERY-OPEN.
     2089     qh:GET-FIRST.
     2090     p-ret = buf_din_trn-doc:BUFFER-FIELD(p-pole):BUFFER-VALUE   .
     2091     DELETE WIDGET qh.
     2092     DELETE WIDGET buf_din_trn-doc.
     2093   end.
     2094   end procedure.
