     4723         end.
     4724   end.
     4725   define temp-table temp_goods-qnty no-undo
     4726       field gds-code      as integer
     4727       field artic         as character
     4728       field prod-type     as character
     4729       field prod-code     as integer
     4730       field recipe-type   as character
     4731       field recipe-code   as character
     4732       field trn-type      as character
     4733       field need-qnty     as decimal
     4734       field calculated    as logical
     4735       index pi is primary unique gds-code recipe-code
     4736       index cl calculated
     4737   .
     4738   PROCEDURE create-initial-temp-goods :
     4739   do
     4740   on error undo, return error
     4741   :
     4742   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     4743   define input parameter p-artic              as character    no-undo.
     4744   define input parameter p-prod-type          as character    no-undo.
     4745   define input parameter p-prod-code          as integer      no-undo.
     4746   define input parameter p-trn-type           as character    no-undo.
     4747   define input parameter p-recipe-type        as character    no-undo.
     4748   define input parameter p-recipe-code        as character    no-undo.
     4749   define input parameter p-need-qnty          as decimal      no-undo.
     4750   define output parameter p-same-good             as logical      no-undo.
     4751   define output parameter p-same-good-old-qnty    as decimal      no-undo.
     4752       define variable v-gds-code    as integer      no-undo.
     4753       define buffer buf_fbr-doc               for ub.fbr-doc.
     4754       define buffer buf_fbr-line              for ub.fbr-line.
     4755       define buffer buf_recipe                for ub.fbr-recipe.
     4756       define buffer buf_obj_recipe            for ub.recipe.
     4757       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     4758       run clear-temp-tables in this-procedure.
     4759   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4760   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     4761     (input  p-artic
     4762     ,input  p-prod-type
     4763     ,input  p-prod-code
     4764     ,output v-gds-code
     4765     )  .
     4766       create buf_temp_goods-qnty.
     4767       assign
     4768           buf_temp_goods-qnty.gds-code    = v-gds-code
     4769           buf_temp_goods-qnty.artic       = p-artic
     4770           buf_temp_goods-qnty.prod-type   = p-prod-type
     4771           buf_temp_goods-qnty.prod-code   = p-prod-code
     4772           buf_temp_goods-qnty.trn-type    = p-trn-type
     4773           buf_temp_goods-qnty.recipe-type = p-recipe-type
     4774           buf_temp_goods-qnty.recipe-code = p-recipe-code
     4775           buf_temp_goods-qnty.need-qnty   = p-need-qnty
     4776           buf_temp_goods-qnty.calculated  = no
     4777       .
     4778       assign
     4779           p-same-good                 = no
     4780           p-same-good-old-qnty        = 0
     4781       .
     4782       find first buf_fbr-doc where buf_fbr-doc.doc-code = p-fbr-doc-doc-code exclusive-lock.
     4783       for each buf_fbr-line no-lock
     4784          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     4785            and buf_fbr-line.is-comp  = yes
     4786       on error undo, return error
     4787       :
     4788           find first buf_temp_goods-qnty
     4789                where buf_temp_goods-qnty.artic        = buf_fbr-line.artic
     4790                  and buf_temp_goods-qnty.prod-type    = buf_fbr-line.prod-type
     4791                  and buf_temp_goods-qnty.prod-code    = buf_fbr-line.prod-code
     4792           no-error.
     4793           if available buf_temp_goods-qnty
     4794           then do:
     4795               assign
     4796                   p-same-good                 = yes
     4797                   p-same-good-old-qnty        = buf_fbr-line.fact-qnty
     4798                   buf_temp_goods-qnty.calculated  = no
     4799               .
     4800           end.
     4801           else do:
     4802               define variable v-recipe-type   as character     no-undo.
     4803               run copy-recipe-in-doc in this-procedure (
     4804                     input p-fbr-doc-doc-code
     4805                   , input buf_fbr-line.recipe-code
     4806                   , input buf_fbr-doc.doc-date
     4807                   , input buf_fbr-doc.obj-type
     4808                   , input buf_fbr-doc.obj-code
     4809               ).
     4810               find first buf_recipe no-lock
     4811                    where buf_recipe.doc-code      = p-fbr-doc-doc-code
     4812                      and buf_recipe.recipe-code   = buf_fbr-line.recipe-code
     4813               no-error.
     4814               if available buf_recipe
     4815               then do:
     4816                   assign
     4817                       v-recipe-type = buf_recipe.recipe-type
     4818                   .
     4819                   if v-recipe-type = 'разделка':U
     4820                   or ( v-recipe-type = 'комплектация':U
     4821                       and buf_fbr-line.trn-type = 'спи':U )
     4822                   then do:
     4823                       run fill-temp-dressing-ingr in this-procedure (
     4824                             input buf_fbr-line.doc-code
     4825                           , input buf_recipe.recipe-code
     4826                       ).
     4827                   end.
     4828               end.
     4829               else do:
     4830                   assign
     4831                       v-recipe-type = ?
     4832                   .
     4833               end.
     4834   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4835   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     4836     (input  buf_fbr-line.artic
     4837     ,input  buf_fbr-line.prod-type
     4838     ,input  buf_fbr-line.prod-code
     4839     ,output v-gds-code
     4840     )  .
     4841               create buf_temp_goods-qnty.
     4842               assign
     4843                   buf_temp_goods-qnty.gds-code    = v-gds-code
     4844                   buf_temp_goods-qnty.artic       = buf_fbr-line.artic
     4845                   buf_temp_goods-qnty.prod-type   = buf_fbr-line.prod-type
     4846                   buf_temp_goods-qnty.prod-code   = buf_fbr-line.prod-code
     4847                   buf_temp_goods-qnty.trn-type    = buf_fbr-line.trn-type
     4848                   buf_temp_goods-qnty.need-qnty   = buf_fbr-line.fact-qnty
     4849                   buf_temp_goods-qnty.recipe-type = v-recipe-type
     4850                   buf_temp_goods-qnty.recipe-code = buf_fbr-line.recipe-code
     4851                   buf_temp_goods-qnty.calculated  = yes
     4852               .
     4853           end.
     4854       end.
     4855   end.
     4856   END PROCEDURE.
     4857   PROCEDURE calc-not-calculated-goods :
     4858   do
     4859   on error undo, return error
     4860   :
     4861   define input parameter p-mainmenu-handle        as handle           no-undo.
     4862   define input parameter p-fbrhist-handle         as widget-handle    no-undo.
     4863   define input parameter p-fbr-doc-doc-code       as character        no-undo.
     4864   define input parameter p-same-good              as logical          no-undo.
     4865   define input parameter p-same-good-old-qnty     as decimal          no-undo.
     4866   define input parameter p-always-select-recipe   as logical          no-undo.
     4867   define input parameter p-add-childs             as logical          no-undo.
     4868   define input parameter p-price-sale-obj-type    as character        no-undo.
     4869   define input parameter p-price-sale-obj-code    as integer          no-undo.
     4870   define input parameter p-autofbr                as logical          no-undo.
     4871   define input parameter p-have-store             as logical          no-undo.
     4872       define variable v-counter               as integer       no-undo.
     4873       define variable v-recipe-type           as character     no-undo.
     4874       define variable v-recipe-code           as character     no-undo.
     4875       define variable v-recipe-found          as logical       no-undo.
     4876       define variable v-gds-code              as integer       no-undo.
     4877       define variable v-yesno                 as logical       no-undo.
     4878       define variable v-fbr-line-recid        as recid         no-undo.
     4879       define variable v-recipe-recid-list     as character     no-undo.
     4880       define variable v-need-goods            as logical       no-undo.
     4881       define variable v-need-goods-list       as character     no-undo.
     4882       define variable v-need-goods-qnty-list  as character     no-undo.
     4883       define variable v-have-rights           as logical       no-undo.
     4884       define variable v-trn-type              as character     no-undo.
     4885       define variable v-is-comp               as logical       no-undo.
     4886       define variable v-host-code             as integer       no-undo.
     4887       define variable v-is-manual-input       as logical       no-undo.
     4888       define variable v-add-good              as logical       no-undo.
     4889       define variable v-cancel                as logical       no-undo.
     4890       define variable v-value          as character no-undo .
     4891       define variable v-type           as character no-undo .
     4892       define variable v-attr-value     as character no-undo .
     4893       define variable v-attr-value-rec as character no-undo .
     4894       define variable v-attr-type      as character no-undo .
     4895       define variable v-mark-qnty      as decimal no-undo init ? .
     4896       define buffer buf_obj_recipe            for recipe.
     4897       define buffer buf_obj_recipe-gds        for recipe-gds.
     4898       define buffer buf_fbr-recipe            for fbr-recipe.
     4899       define buffer buf_fbr-recipe-gds        for fbr-recipe-gds.
     4900       define buffer buf_goods                 for goods.
     4901       define buffer buf_fbr-doc               for fbr-doc.
     4902       define buffer buf_fbr-line              for fbr-line.
     4903       define buffer buf_comp_fbr-line         for fbr-line.
     4904       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     4905       define buffer buf_new_temp_goods-qnty   for temp_goods-qnty.
     4906       define buffer buf_start_temp_goods-qnty for temp_goods-qnty.
     4907       define buffer buf_del_temp_goods-qnty   for temp_goods-qnty.
     4908       define buffer buf_marking-lines         for ub.marking-lines .
     4909       define buffer buf_marking               for ub.marking .
     4910      define variable v-ban-recipes as logical no-undo .
     4911      define variable v-ban-altr    as logical no-undo .
     4912      if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsBanRecipes then v-ban-recipes = true .
     4913      if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsBanAltr then v-ban-altr = true .
     4914       find first buf_fbr-doc no-lock
     4915            where buf_fbr-doc.doc-code = p-fbr-doc-doc-code
     4916       .
     4917       run test-temp-tables in this-procedure ( "Заполнена временная таблица по товарам документа." ).
     4918       find first buf_start_temp_goods-qnty
     4919            where buf_start_temp_goods-qnty.calculated = no
     4920       no-error.
     4921       calc-not-calculated-goods:
     4922       do while available buf_start_temp_goods-qnty
     4923       :
     4924           run writelog in this-procedure ( log-file-name, 2, substitute( "Расчет товара с артикулом &1", buf_start_temp_goods-qnty.artic ) ).
     4925           find first buf_goods no-lock
     4926                where buf_goods.gds-code = buf_start_temp_goods-qnty.gds-code
     4927           .
     4928           if buf_start_temp_goods-qnty.recipe-code = ?
     4929           then do:
     4930               assign
     4931                   v-is-manual-input = yes
     4932               .
     4933           end.
     4934           else do:
     4935               assign
     4936                   v-is-manual-input = no
     4937               .
     4938           end.
     4939           if buf_start_temp_goods-qnty.recipe-code = ?
     4940           or p-always-select-recipe = yes
     4941           then do:
     4942               assign
     4943                   v-yesno     = ?
     4944                   v-add-good  = no
     4945               .
     4946               do while v-yesno = ?
     4947               and v-add-good = no
     4948               :
     4949                   run ref/rcp-all.w (
     4950                         input p-mainmenu-handle
     4951                       , input "b-add,b-sel"
     4952                       , input 'все':U
     4953                       , input recid( buf_goods )
     4954                       , input buf_fbr-doc.obj-type
     4955                       , input buf_fbr-doc.obj-code
     4956                       , output v-recipe-recid-list
     4957                   ) no-error.
     4958                   if error-status :error
     4959                   or v-recipe-recid-list = ""
     4960                   then do:
     4961                       message
     4962                           "Отменить добавление товара?"
     4963                           skip(1)
     4964                           skip "Товар:" buf_goods.artic buf_goods.gds-name
     4965                           skip(1)
     4966                           skip "Yes - отменить добавление текущего товара"
     4967                           skip "No  - отменить добавление всех товаров списка"
     4968                           skip "Cancel - вернуться к выбору рецепта"
     4969                       view-as alert-box question
     4970                       buttons yes-no-cancel
     4971                       title "Отмена"
     4972                       update v-yesno
     4973                       .
     4974                   end.
     4975                   else do:
     4976         if v-ban-altr or v-ban-recipes then
     4977         do:
     4978            for each buf_obj_recipe no-lock where recid (buf_obj_recipe) = integer(v-recipe-recid-list):
     4979               if buf_obj_recipe.recipe-type = 'производство':U and v-ban-recipes then
     4980               do:
     4981                  for each ub.recipe-gds no-lock where ub.recipe-gds.recipe-code = buf_obj_recipe.recipe-code:
     4982                     run gds-attr-value in this-procedure  ( input  ub.recipe-gds.gds-code
     4983                        , input  'mark-type':U
     4984                        , output v-attr-value
     4985                        , output v-attr-type
     4986                        ) no-error .
     4987                     if v-attr-value <> "" and v-attr-value <> "not-type" then
     4988                     do:
     4989                        message "Рецепт производства " + buf_obj_recipe.recipe-code + " " + buf_obj_recipe.recipe-name + " содержит маркированный товар."
     4990                           view-as alert-box.
     4991                        return .
     4992                     end.
     4993                  end.
     4994               end.
     4995               if buf_obj_recipe.recipe-type = 'альтернатива':U and v-ban-altr then
     4996               do:
     4997                  if not check-ban-sales-via-cd(buf_goods.gds-code) then
     4998                  do:
     4999                     message "Рецепт альтернатива " + buf_obj_recipe.recipe-code + " " + buf_obj_recipe.recipe-name + chr(10) + "входит в группу, у которой не установлен атрибут: " + chr(10) + "Запрет передачи на кассу."
     5000                        view-as alert-box.
     5001                     return .
     5002                  end.
     5003               end.
     5004               if buf_obj_recipe.recipe-type = 'комплектация':U and v-ban-recipes then
     5005               do:
     5006                  for each ub.recipe-gds no-lock where ub.recipe-gds.recipe-code = buf_obj_recipe.recipe-code:
     5007                     run gds-attr-value in this-procedure  ( input  ub.recipe-gds.gds-code
     5008                        , input  'mark-type':U
     5009                        , output v-attr-value
     5010                        , output v-attr-type
     5011                        ) no-error .
     5012                     if v-attr-value <> "" and v-attr-value <> "not-type" then
     5013                     do:
     5014                        run gds-attr-value in this-procedure  ( input  buf_obj_recipe.gds-code
     5015                           , input  'mark-type':U
     5016                           , output v-attr-value-rec
     5017                           , output v-attr-type
     5018                           ) no-error .
     5019                        if v-attr-value-rec = "" or v-attr-value-rec = "not-type" then
     5020                        do:
     5021                           message "Рецепт комплектации " + buf_obj_recipe.recipe-code + " " + buf_obj_recipe.recipe-name + " должен быть маркированным"
     5022                              view-as alert-box.
     5023                           return .
     5024                        end.
     5025                        else leave.
     5026                     end.
     5027                  end.
     5028               end.
     5029            end.
     5030         end.
     5031                       assign
     5032                           v-add-good = yes
     5033                       .
     5034                   end.
     5035               end.
     5036               if v-add-good = no
     5037               then do:
     5038                   if v-yesno = yes
     5039                   then do:
     5040                       for each tt-marking-lines where tt-marking-lines.gds-code = buf_start_temp_goods-qnty.gds-code
     5041                       :
     5042                         for first buf_marking exclusive-lock where buf_marking.mark begins tt-marking-lines.mark :
     5043                           assign
     5044                             buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB
     5045                           .
     5046                         end .
     5047                         delete tt-marking-lines .
     5048                       end .
     5049                       delete buf_start_temp_goods-qnty.
     5050                       find first buf_start_temp_goods-qnty
     5051                               where buf_start_temp_goods-qnty.calculated = no
     5052                       no-error.
     5053                       next calc-not-calculated-goods.
     5054                   end.
     5055                   else do:
     5056                       undo, return error .
     5057                   end.
     5058               end.
     5059               find first buf_obj_recipe no-lock
     5060                    where recid( buf_obj_recipe ) = integer( v-recipe-recid-list )
     5061               no-error.
     5062               if not available buf_obj_recipe
     5063               then do:
     5064                   if p-always-select-recipe = yes
     5065                   then do:
     5066                       assign
     5067                           buf_start_temp_goods-qnty.calculated = yes
     5068                       .
     5069                       find first buf_start_temp_goods-qnty
     5070                            where buf_start_temp_goods-qnty.calculated = no
     5071                       no-error.
     5072                       next calc-not-calculated-goods.
     5073                   end.
     5074                   else do:
     5075                       message
     5076                           "Неверно выбран рецепт для товара."
     5077                       view-as alert-box information.
     5078                       undo, return error .
     5079                   end.
     5080               end.
     5081               else do:
     5082                   run copy-recipe-in-doc in this-procedure (
     5083                         input buf_fbr-doc.doc-code
     5084                       , input buf_obj_recipe.recipe-code
     5085                       , input buf_fbr-doc.doc-date
     5086                       , input buf_fbr-doc.obj-type
     5087                       , input buf_fbr-doc.obj-code
     5088                   ).
     5089                   find first buf_fbr-recipe no-lock
     5090                        where buf_fbr-recipe.doc-code    = p-fbr-doc-doc-code
     5091                          and buf_fbr-recipe.recipe-code = buf_obj_recipe.recipe-code
     5092                   .
     5093                   assign
     5094                       buf_start_temp_goods-qnty.recipe-code = buf_fbr-recipe.recipe-code
     5095                       buf_start_temp_goods-qnty.recipe-type = buf_fbr-recipe.recipe-type
     5096                   .
     5097               end.
     5098               run writelog in this-procedure ( log-file-name, 3, substitute( "В диалоге выбран рецепт номер &1", buf_start_temp_goods-qnty.recipe-code ) ).
     5099           end.
     5100           else do:
     5101               run copy-recipe-in-doc in this-procedure (
     5102                     input p-fbr-doc-doc-code
     5103                   , input buf_start_temp_goods-qnty.recipe-code
     5104                   , input buf_fbr-doc.doc-date
     5105                   , input buf_fbr-doc.obj-type
     5106                   , input buf_fbr-doc.obj-code
     5107               ).
     5108               find first buf_fbr-recipe no-lock
     5109                    where buf_fbr-recipe.doc-code    = p-fbr-doc-doc-code
     5110                      and buf_fbr-recipe.recipe-code = buf_start_temp_goods-qnty.recipe-code
     5111               .
     5112               run writelog in this-procedure ( log-file-name, 3, substitute( "Выбран рецепт номер &1", buf_start_temp_goods-qnty.recipe-code ) ).
     5113           end.
