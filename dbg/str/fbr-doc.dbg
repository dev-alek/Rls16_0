     3595   on error undo, return error
     3596   :
     3597   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3598     define variable v-cntxt-db-num        as integer   no-undo .
     3599     define variable v-cntxt-userid        as character no-undo .
     3600     define variable v-cntxt-level         as character no-undo .
     3601     define variable v-cntxt-host-code-obj as integer   no-undo .
     3602     define variable v-cntxt-obj-type      as character no-undo .
     3603     define variable v-cntxt-obj-code      as integer   no-undo .
     3604     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3605     define variable v-cntxt-is-admin      as logical   no-undo .
     3606   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3607     run mainmenu_getcntxt in parparentproc
     3608       (output v-cntxt-db-num
     3609       ,output v-cntxt-userid
     3610       ,output v-cntxt-level
     3611       ,output v-cntxt-host-code-obj
     3612       ,output v-cntxt-obj-type
     3613       ,output v-cntxt-obj-code
     3614       ,output v-cntxt-db-num-obj
     3615       ,output v-cntxt-is-admin
     3616       ) .
