    13028   ON CHOOSE OF MENU-ITEM m-ord
    13029      DO:
    13030         define variable i            as integer   no-undo .
    13031         define variable loc-ref-list as character no-undo.
    13032         run ref/all-zakz.w
    13033            ( input   parParentProc
    13034            ,input   ?
    13035            ,input   ?
    13036            ,input   "firmord"
    13037            ,input   ""
    13038            ,input   "b-sel,b-mark"
    13039            ,input   ""
    13040            ,output  loc-ref-list ) no-error .
    13041         if loc-ref-list = ""  then
    13042         do:
    13043            message "Ни чего не отметили в списке заказов !"
    13044               view-as alert-box information .
    13045            display
    13046               ? @ out-code
    13047               with frame D-FBR-DOC.
    13048            apply "entry" to b-add in frame D-FBR-DOC.
    13049            return no-apply.
    13050         end.
    13051         if num-entries( loc-ref-list ) = 0
    13052            or loc-ref-list                = ""
    13053            or error-status :error
    13054            then
    13055         do:
    13056            display
    13057               ? @ out-code
    13058               with frame D-FBR-DOC.
    13059            apply "entry" to b-add in frame D-FBR-DOC.
    13060            return no-apply.
    13061         end.
    13062         else
    13063         do:
    13064   if session :set-wait-state( "compiler" ) then.
    13065            repeat i = 1 to  num-entries( loc-ref-list ) :
    13066               find first ub.ord-doc no-lock
    13067                  where recid( ub.ord-doc ) = integer( entry( i , loc-ref-list ) )  no-error.
    13068               display
    13069                  ub.ord-doc.doc-code @ out-code
    13070                  with frame D-FBR-DOC.
    13071               run cus/ord-copy.p (
    13072                  input parparentproc
    13073                  , input f-doc.doc-code
    13074                  , input ub.ord-doc.doc-code
    13075                  , input f-doc.obj-type
    13076                  , input f-doc.obj-code
    13077                  , input v-price-sale-obj-type
    13078                  , input v-price-sale-obj-code
    13079                  , input p-fbrhist-handle
    13080                  ) no-error.
    13081               if error-status :error
    13082                  then
    13083               do:
    13084                  message
    13085                     vss-workfile vss-revision vss-description
    13086                     skip(1)
    13087                     skip
    13088                     "Ошибка копирования заказа в документ производства."
    13089                     skip return-value
    13090                     skip trim( error-status :get-message( 1 ) )
    13091                     trim( error-status :get-message( 2 ) )
    13092                     trim( error-status :get-message( 3 ) )
    13093                     view-as alert-box error.
    13094                  undo, return no-apply.
    13095               end.
    13096            end.
    13097         end.
    13098         assign
    13099            f-doc.is-free = no
    13100            .
    13101         run hide-not-avail-menu-items in this-procedure ( input no ).
    13102         run UI-on in this-procedure ( input "line" ).
    13103   if session :set-wait-state( "" ) then.
    13104         return no-apply.
    13105      END.
