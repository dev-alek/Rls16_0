     1316     .
     1317   define variable vss-include-info12 as character format "X(65)" no-undo
     1318   initial "@(#)$Workfile$ $Revision$".
     1319   define temp-table temp_fbrcode-doc-code no-undo
     1320       field rec-type      as character
     1321       field doc-code      as character
     1322       field obj-type      as character
     1323       field obj-code      as integer
     1324       field cli-type      as character
     1325       field cli-code      as integer
     1326       field ext-doc-type  as character
     1327       field doc-type      as character
     1328       field order         as integer
     1329       index pi is primary unique rec-type doc-code
     1330       index od order
     1331   .
     1332   procedure fbrcode-gen-recipe-code :
     1333   do
     1334   on error undo, return error
     1335   :
     1336   define input parameter p-obj-type           as character    no-undo.
     1337   define input parameter p-obj-code           as integer      no-undo.
     1338   define output parameter p-recipe-code       as character    no-undo.
     1339       assign
     1340           p-recipe-code   = string( next-value( s-recipe, ub ) )
     1341                               + "-"
     1342                               + trim( string( p-obj-code, ">>>>9" ) )
     1343                               + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
     1344       .
     1345   end.
     1346   end procedure.
     1347   procedure fbrcode-is-from-object :
     1348   do
     1349   on error undo, return error
     1350   :
     1351   define input parameter p-doc-code           as character    no-undo.
     1352   define input parameter p-obj-type           as character    no-undo.
     1353   define input parameter p-obj-code           as integer      no-undo.
     1354   define output parameter p-is-from-object    as logical      no-undo.
     1355       if num-entries( p-doc-code, "-" ) < 2
     1356       or entry( 2, p-doc-code, "-" ) <> trim (string (p-obj-code, ">>>>9"))
     1357                                       + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
     1358       then do:
     1359           assign
     1360               p-is-from-object = no
     1361           .
     1362       end.
     1363       else do:
     1364           assign
     1365               p-is-from-object = yes
     1366           .
     1367       end.
     1368   end.
     1369   end procedure.
     1370   procedure fbrcode-trn-doc :
     1371   do
     1372   on error undo, return error
     1373   :
     1374       define input parameter p-out-doc-type       as character    no-undo.
     1375       define input parameter p-out-code           as character    no-undo.
     1376       define input parameter p-trn-doc-out-type   as character    no-undo.
     1377       define output parameter p-trn-doc-doc-code  as character   no-undo.
     1378       case p-out-doc-type:
     1379           when 'производство':U
     1380           then do:
     1381               case p-trn-doc-out-type :
     1382                   when 'рас':U
     1383                   then do:
     1384                       assign
     1385                           p-trn-doc-doc-code = p-out-code
     1386                       .
     1387                   end.
     1388                   when 'при':U
     1389                   then do:
     1390                       assign
     1391                           p-trn-doc-doc-code = replace ( p-out-code, "-", "=" )
     1392                       .
     1393                   end.
     1394                   when 'спи':U
     1395                   then do:
     1396                       assign
     1397                           p-trn-doc-doc-code = replace ( p-out-code, "-", "*" )
     1398                       .
     1399                   end.
     1400                   otherwise do:
     1401                       assign
     1402                           p-trn-doc-doc-code = ""
     1403                       .
     1404                       undo, return error "Не может быть обработан тип складского документа '"
     1405                                           + p-trn-doc-out-type + "' во входных параметрах".
     1406                   end.
     1407               end case.
     1408           end.
     1409           otherwise do:
     1410               assign
     1411                   p-trn-doc-doc-code = ""
     1412               .
     1413               undo, return error "Не может быть обработан тип внешнего документа '"
     1414                                   + p-out-doc-type + "' во входных параметрах".
     1415           end.
     1416       end case.
     1417   end.
     1418   end procedure.
     1419   procedure fbrcode-fill-fbr-by-sale-or-pln :
     1420   define input parameter p-main-doc-code      as character        no-undo.
     1421       define variable v-order    as integer      no-undo.
     1422       define buffer buf_fbr-doc               for ub.fbr-doc.
     1423       define buffer buf_trn-doc               for ub.trn-doc.
     1424       define buffer buf_temp_fbrcode-doc-code for temp_fbrcode-doc-code.
     1425   do
     1426   for buf_fbr-doc
     1427     , buf_trn-doc
     1428     , buf_temp_fbrcode-doc-code
     1429   on error undo, return error
     1430   :
     1431       for each buf_temp_fbrcode-doc-code
     1432       on error undo, return error
     1433       :
     1434           delete buf_temp_fbrcode-doc-code.
     1435       end.
     1436       assign
     1437           v-order = 0
     1438       .
     1439       for each buf_fbr-doc no-lock
     1440          where buf_fbr-doc.out-code = p-main-doc-code
     1441       on error undo, return error
     1442       :
     1443           create buf_temp_fbrcode-doc-code.
     1444           assign
     1445               buf_temp_fbrcode-doc-code.rec-type      = 'производство':U
     1446               buf_temp_fbrcode-doc-code.doc-code      = buf_fbr-doc.doc-code
     1447               buf_temp_fbrcode-doc-code.ext-doc-type  = "":U
     1448               buf_temp_fbrcode-doc-code.obj-type      = buf_fbr-doc.obj-type
     1449               buf_temp_fbrcode-doc-code.obj-code      = buf_fbr-doc.obj-code
     1450               buf_temp_fbrcode-doc-code.cli-type      = buf_fbr-doc.obj-type
     1451               buf_temp_fbrcode-doc-code.cli-code      = buf_fbr-doc.obj-code
     1452               buf_temp_fbrcode-doc-code.doc-type      = buf_fbr-doc.doc-type
     1453           .
     1454           for each buf_trn-doc no-lock
     1455              where buf_trn-doc.out-code = buf_fbr-doc.doc-code
     1456           by buf_trn-doc.fact-order
     1457           on error undo, return error
     1458           :
     1459               if buf_trn-doc.ext-doc-type = 'em':U
     1460               or buf_trn-doc.ext-doc-type = 'im':U
     1461               or buf_trn-doc.ext-doc-type = 'wm':U
     1462               or buf_trn-doc.ext-doc-type = 'ev':U
     1463               then do:
     1464                   assign
     1465                       v-order = v-order + 1
     1466                   .
     1467                   create buf_temp_fbrcode-doc-code.
     1468                   assign
     1469                       buf_temp_fbrcode-doc-code.doc-code      = buf_trn-doc.doc-code
     1470                       buf_temp_fbrcode-doc-code.rec-type      = 'скл':U
     1471                       buf_temp_fbrcode-doc-code.ext-doc-type  = buf_trn-doc.ext-doc-type
     1472                       buf_temp_fbrcode-doc-code.obj-type      = buf_trn-doc.obj-type
     1473                       buf_temp_fbrcode-doc-code.obj-code      = buf_trn-doc.obj-code
     1474                       buf_temp_fbrcode-doc-code.cli-type      = buf_trn-doc.cli-type
     1475                       buf_temp_fbrcode-doc-code.cli-code      = buf_trn-doc.cli-code
     1476                       buf_temp_fbrcode-doc-code.doc-type      = buf_trn-doc.doc-type
     1477                       buf_temp_fbrcode-doc-code.order         = v-order
     1478                   .
     1479               end.
     1480           end.
     1481           assign
     1482               v-order  = v-order + 1
     1483           .
     1484           find first buf_temp_fbrcode-doc-code
     1485                where buf_temp_fbrcode-doc-code.rec-type = 'производство':U
     1486                  and buf_temp_fbrcode-doc-code.doc-code = buf_fbr-doc.doc-code
     1487           .
     1488           assign
     1489               buf_temp_fbrcode-doc-code.order = v-order
     1490           .
     1491       end.
     1492       for each buf_trn-doc no-lock
     1493          where buf_trn-doc.out-code = p-main-doc-code
     1494       by buf_trn-doc.fact-order
     1495       on error undo, return error
     1496       :
     1497           assign
     1498               v-order = v-order + 1
     1499           .
     1500           create buf_temp_fbrcode-doc-code.
     1501           assign
     1502               buf_temp_fbrcode-doc-code.doc-code      = buf_trn-doc.doc-code
     1503               buf_temp_fbrcode-doc-code.rec-type      = 'маг':U
     1504               buf_temp_fbrcode-doc-code.ext-doc-type  = buf_trn-doc.ext-doc-type
     1505               buf_temp_fbrcode-doc-code.obj-type      = buf_trn-doc.obj-type
     1506               buf_temp_fbrcode-doc-code.obj-code      = buf_trn-doc.obj-code
     1507               buf_temp_fbrcode-doc-code.cli-type      = buf_trn-doc.cli-type
     1508               buf_temp_fbrcode-doc-code.cli-code      = buf_trn-doc.cli-code
     1509               buf_temp_fbrcode-doc-code.doc-type      = buf_trn-doc.doc-type
     1510               buf_temp_fbrcode-doc-code.order         = v-order
     1511           .
     1512       end.
     1513   end.
     1514   end procedure.
     1515   procedure fbrcode-get-final-doc :
     1516   define input parameter p-main-doc-code      as character        no-undo.
     1517   define output parameter p-income-doc-code   as character        no-undo.
     1518       define variable v-main-obj-type    as character    no-undo.
     1519       define variable v-main-obj-code    as integer      no-undo.
     1520       define buffer buf_trn-doc               for ub.trn-doc.
     1521       define buffer buf_temp_fbrcode-doc-code for temp_fbrcode-doc-code.
     1522   do
     1523   for buf_trn-doc
     1524   on error undo, return error
     1525   :
     1526       run fbrcode-fill-fbr-by-sale-or-pln in this-procedure (
     1527           input p-main-doc-code
     1528       ).
     1529       find first buf_trn-doc no-lock
     1530            where buf_trn-doc.doc-code = p-main-doc-code
     1531       .
     1532       assign
     1533           v-main-obj-type = buf_trn-doc.obj-type
     1534           v-main-obj-code = buf_trn-doc.obj-code
     1535       .
     1536       find first buf_temp_fbrcode-doc-code
     1537            where buf_temp_fbrcode-doc-code.ext-doc-type = 'ev':U
     1538              and buf_temp_fbrcode-doc-code.cli-type     = v-main-obj-type
     1539              and buf_temp_fbrcode-doc-code.cli-code     = v-main-obj-code
     1540       no-error.
     1541       if available buf_temp_fbrcode-doc-code
     1542       then do:
     1543           find first buf_trn-doc no-lock
     1544                where buf_trn-doc.out-code     = buf_temp_fbrcode-doc-code.doc-code
     1545                  and buf_trn-doc.ext-doc-type = 'iv':U
     1546           .
     1547           assign
     1548               p-income-doc-code = buf_trn-doc.doc-code
     1549           .
     1550       end.
     1551       else do:
     1552           find first buf_temp_fbrcode-doc-code
     1553                where buf_temp_fbrcode-doc-code.ext-doc-type = 'im':U
     1554                  and buf_temp_fbrcode-doc-code.obj-type     = v-main-obj-type
     1555                  and buf_temp_fbrcode-doc-code.obj-code     = v-main-obj-code
     1556           no-error.
     1557           if available buf_temp_fbrcode-doc-code
     1558           then do:
     1559               assign
     1560                   p-income-doc-code = buf_temp_fbrcode-doc-code.doc-code
     1561               .
     1562           end.
     1563           else do:
     1564               assign
     1565                   p-income-doc-code = "":U
     1566               .
     1567           end.
     1568       end.
     1569   end.
     1570   end procedure.
