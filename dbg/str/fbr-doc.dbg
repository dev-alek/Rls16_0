     3583       define variable v-ext-doc-type      as character        no-undo.
     3584       define variable v-trn-doc-recid     as recid            no-undo.
     3585       define variable varchip-code        as integer          no-undo.
     3586       define variable varchip-code2       as integer          no-undo.
     3587       define variable v-chip-counter      as integer          no-undo.
     3588       define buffer buf_trn-doc       for ub.trn-doc.
