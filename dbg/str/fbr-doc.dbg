    10823      define variable oError as character no-undo.
    10824            run gen-key-rec (input "utd-lines",
    10825                             input  iObj,
    10826                             output vRecKey-line).
    10827         define variable vdb-num as integer no-undo.
    10828         define variable vdoc-id as integer no-undo.
    10829         define variable vlinenum as integer no-undo.
    10830         vdb-num = iObj::db-num.
    10831         vdoc-id = iObj::doc-id.
    10832         vlinenum = iObj::linenum.
    10833         block-err:
    10834         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
    10835                                  and buf_utd-err.db-num = vdb-num
    10836                                  and buf_utd-err.reckey = vRecKey-line
    10837                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
    10838         no-lock:
    10839            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
    10840            if     vErrorOne ne ?
    10841               and vErrorOne ne ""
    10842            then do:
    10843               oError = oError + vErrorOne + " ".
    10844            end.
    10845         end.
    10846      return oError.
    10847   end.
    10848   function CheckErrForLineType returns logical
    10849   (iObj            as handle,
    10850    iType           as character  ):
