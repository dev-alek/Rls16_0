    14335                  fi-pay-code = f-doc.pay-code
    14336                  .
    14337            end.
    14338         end.
    14339         run mode-on no-error.
    14340         if error-status:error
    14341            then
    14342         do:
    14343            undo, return error.
    14344         end.
    14345         if p-doc-mode = 'ИЗМЕНЕНИЕ':U
    14346            then
    14347         do:
    14348            run hide-not-avail-menu-items in this-procedure (
    14349               input f-doc.is-free
    14350               ).
    14351         end.
    14352         if p-doc-mode = 'ДОБАВЛЕНИЕ':U
    14353            then
    14354         do:
    14355            assign
    14356               p-doc-mode = 'ИЗМЕНЕНИЕ':U
    14357               .
    14358         end.
    14359         assign
    14360            rs-one-all            = "recipe":U
    14361            v-fbr-doc-rep-rec     = ?
    14362            v-price-sale-obj-type = v-cntxt-obj-type
    14363            v-price-sale-obj-code = v-cntxt-obj-code
    14364            .
    14365         display f-doc.fact-date @ fact-date with frame D-FBR-DOC.
    14366         shift = subst("&1 &2 &3", f-doc.shift-date, f-doc.shift-num, f-doc.shift-name).
    14367         if f-doc.shift-date <> ? then
    14368            display shift with frame D-FBR-DOC.
    14369         run get-pay-type-name in this-procedure (
    14370            input fi-pay-code
    14371            , output fi-pay-type-name
    14372            ).
    14373         run UI-on in this-procedure (
    14374            input "enable":U
    14375            ).
    14376         if v-fbr-doc-line-rec <> ?
    14377            and p-doc-mode = 'ПРОСМОТР':U
    14378            then
    14379         do:
    14380            reposition br-comp to recid v-fbr-doc-line-rec no-error.
    14381         end.
    14382         WAIT-FOR GO OF FRAME D-FBR-DOC focus br-comp.
    14383      END.
    14384   end.
    14385   RUN disable_UI.
    14386   PROCEDURE add-free-fbr-line :
    14387      do
    14388         on error undo, return error
    14389         :
    14390         define input parameter p-browse         as character                no-undo.
    14391         define input parameter p-price-obj-type like ub.clients.obj-type       no-undo.
    14392         define input parameter p-price-obj-code like ub.clients.obj-code       no-undo.
    14393         define variable vss-description            as character no-undo init "Добавление строк без рецепта.".
    14394         define variable v-trn-type                 as character no-undo.
    14395         define variable v-fbr-v-fbr-doc-line-recid as recid     no-undo.
    14396         define variable v-cancel                   as logical   no-undo.
    14397         define buffer buf_goods    for ub.goods.
    14398         define buffer buf_gds-prt  for ub.gds-prt.
    14399         define buffer buf_fbr-line for ub.fbr-line.
    14400         if p-browse = "up"
    14401            then
    14402         do:
    14403            assign
    14404               v-trn-type = 'при':U
    14405               .
    14406         end.
    14407         else
    14408         do:
    14409            assign
    14410               v-trn-type = 'спи':U
    14411               .
    14412         end.
    14413         find first buf_goods no-lock
    14414            where recid( buf_goods ) = gds-rec
    14415            .
    14416         find first buf_gds-prt no-lock
    14417            where buf_gds-prt.upper-code = buf_goods.prt-root
    14418            .
    14419         if buf_goods.gds-type = 'у':U
    14420            and v-trn-type = 'при':U
    14421            then
    14422         do:
    14423            message
    14424               "Невозможно добавить услугу в приход."
    14425               skip(1) "Услуга:" buf_goods.artic buf_goods.gds-name
    14426               view-as alert-box error
    14427               title "Ошибка добавления товара".
    14428            undo, return error.
    14429         end.
    14430         if buf_goods.stts <> 0
    14431            then
    14432         do:
    14433            message
    14434               "Невозможно добавить в документ удаленный товар."
    14435               skip(1) "Товар:" buf_goods.artic buf_goods.gds-name
    14436               view-as alert-box error
    14437               title "Ошибка добавления товара".
    14438            undo, return error.
    14439         END.
    14440         find first buf_fbr-line no-lock
    14441            where buf_fbr-line.doc-code    = f-doc.doc-code
    14442            and buf_fbr-line.trn-type    <> v-trn-type
    14443            and buf_fbr-line.recipe-code = ""
    14444            and buf_fbr-line.artic       = buf_goods.artic
    14445            and buf_fbr-line.prod-type   = buf_goods.prod-type
    14446            and buf_fbr-line.prod-code   = buf_goods.prod-code
    14447            no-error.
    14448         if available buf_fbr-line
    14449            then
    14450         do:
    14451            assign
    14452               v-fbr-doc-g-log = no
    14453               .
    14454            message
    14455               "Выбранный для добавления товар уже есть в этом документе."
    14456               skip
    14457               "Ингредиенты не могут совпадать с получаемыми товарами !"
    14458               skip(1) "Товар:" buf_goods.artic buf_goods.gds-name
    14459               view-as alert-box error
    14460               title "Ошибка добавления товара".
    14461            undo, return error.
    14462         end.
    14463         run str/fbr-crln.p (
    14464            input parparentproc
    14465            , input p-fbr-doc-recid
    14466            , input gds-rec
    14467            , input ""
    14468            , input v-trn-type
    14469            , input ( p-browse = "up" )
    14470            , input no
    14471            , input p-price-obj-type
    14472            , input p-price-obj-code
    14473            , output v-fbr-v-fbr-doc-line-recid
    14474            ).
    14475         if p-browse = "up"
    14476            then
    14477         do:
    14478            find first buf_fbr-line no-lock
    14479               where recid (buf_fbr-line) = v-fbr-v-fbr-doc-line-recid
    14480               .
    14481            assign
    14482               v-fbr-doc-line-rec = recid( buf_fbr-line )
    14483               .
    14484            run str/fbr-line.w (
    14485               input p-fbrhist-handle
    14486               , input 'ИЗМЕНЕНИЕ':U
    14487               , input buf_fbr-line.doc-code
    14488               , input v-fbr-doc-line-rec
    14489               , input ?
    14490               , output v-cancel
    14491               ).
    14492         end.
    14493         else
    14494         do:
    14495            do transaction
    14496               on error undo, return error
    14497               :
    14498               find first buf_fbr-line exclusive-lock
    14499                  where recid (buf_fbr-line) = v-fbr-v-fbr-doc-line-recid
    14500                  .
    14501               assign
    14502                  v-fbr-doc-rep-rec      = recid( buf_fbr-line )
    14503                  buf_fbr-line.fact-qnty = 0
    14504                  .
    14505            end.
    14506         end.
    14507      end.
    14508   END PROCEDURE.
    14509   PROCEDURE add-proc :
    14510      do transaction
    14511         on error undo, return error
    14512         :
    14513         define input parameter p-mode                   as character    no-undo.
    14514         define input parameter p-price-sale-obj-type    as character    no-undo.
    14515         define input parameter p-price-sale-obj-code    as integer      no-undo.
    14516         define variable v-goods-recid-list as character no-undo.
    14517         define variable vss-description    as character no-undo init "add-proc: ".
    14518         define variable v-value            as character no-undo .
    14519         define variable v-type             as character no-undo .
    14520         define variable v-attr-value as character no-undo .
    14521         define variable v-attr-value-rec as character no-undo .
    14522         define variable v-attr-type as character no-undo .
    14523         define buffer buf_goods    for ub.goods.
    14524         define buffer buf_fbr-line for ub.fbr-line.
    14525         run str/chs-gds.w (
    14526            input parparentproc
    14527            , input f-doc.obj-type
    14528            , input f-doc.obj-code
    14529            , input '':U
    14530            , input '':U
    14531            , input "Строка документа № " + f-doc.doc-code
    14532            , input 'объект':U
    14533            , input ?
    14534            , input ?
    14535            , input ?
    14536            , input ?
    14537            , input-output v-artic
    14538            , output v-goods-recid-list
    14539            ) .
    14540         if v-goods-recid-list <> ''
    14541            then
    14542         do:
    14543            define variable v-line-counter as integer no-undo.
    14544            assign
    14545               v-fbr-doc-line-rec = ?
    14546               v-line-counter     = 1
    14547               .
    14548            do while v-line-counter <= num-entries ( v-goods-recid-list )
    14549               :
    14550               assign
    14551                  gds-rec        = integer( entry ( v-line-counter, v-goods-recid-list ) )
    14552                  v-line-counter = v-line-counter + 1
    14553                  .
    14554               find first buf_goods no-lock
    14555                  where recid( buf_goods ) = gds-rec
    14556                  .
    14557               case p-mode
    14558                  :
    14559                  when "rcp"
    14560                  then
    14561                     do:
    14562                        run writelog in this-procedure (log-file-name, 1, substitute( "Добавление товара с артикулом &1 по рецепту.", buf_goods.artic ) ).
    14563                        RUN gds-attr-value (
    14564                             INPUT buf_goods.gds-code,
    14565                             INPUT 'mark-type':U,
    14566                             OUTPUT v-attr-value,
    14567                             OUTPUT v-attr-type
    14568                             ).
    14569                        v-isweighed = WghProdVariable(v-cntxt-obj-type, v-cntxt-obj-code, buf_goods.gds-code) .
    14570                        if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):GetIsEDOForType(v-attr-value)
    14571                        or v-isweighed
    14572                        then do :
    14573                          empty temp-table tt-marking-lines .
    14574                          run str/fbr-doc-dish-marks-add.w (input parparentproc,
    14575                                                            input gds-rec,
    14576                                                            output table tt-marking-lines) .
    14577                        end .
    14578                        run add-recipe in this-procedure (
    14579                           input f-doc.doc-code
    14580                           , input buf_goods.artic
    14581                           , input buf_goods.prod-type
    14582                           , input buf_goods.prod-code
    14583                           , input no
    14584                           ) no-error.
    14585                        if error-status :error
    14586                        then do:
    14587                          undo, return error.
    14588                        end.
    14589                     end.
    14590                  when "rcp-all"
    14591                  then
    14592                     do:
    14593                        run writelog in this-procedure (log-file-name, 1, substitute( "Добавление товара с артикулом &1 по рецепту. Раскрутка.", buf_goods.artic ) ).
    14594                        run add-recipe in this-procedure (
    14595                           input f-doc.doc-code
    14596                           , input buf_goods.artic
    14597                           , input buf_goods.prod-type
    14598                           , input buf_goods.prod-code
    14599                           , input yes
    14600                           ) .
    14601                     end.
    14602                  when "up"
    14603                  then
    14604                     do:
    14605                        run writelog in this-procedure (log-file-name, 1, substitute( "Добавление товара с артикулом &1 без рецепта в верхний список.", buf_goods.artic ) ).
    14606                        run add-free-fbr-line in this-procedure (
    14607                           input p-mode
    14608                           , input p-price-sale-obj-type
    14609                           , input p-price-sale-obj-code
    14610                           ) .
    14611                     end.
    14612                  when "down"
    14613                  then
    14614                     do:
    14615                        if v-ban-recipes then
    14616                        do:
    14617                           run gds-attr-value in this-procedure  ( input  buf_goods.gds-code
    14618                              , input  'mark-type':U
    14619                              , output v-attr-value
    14620                              , output v-attr-type
    14621                              ) no-error .
    14622                           if v-attr-value <> "" and v-attr-value <> "not-type" then
    14623                           do:
    14624                              message "Добавление маркированного товара в ингридиенты, запрещено"
    14625                                 view-as alert-box.
    14626                              return .
    14627                           end.
    14628                        end.
    14629                        run writelog in this-procedure (log-file-name, 1, substitute( "Добавление товара с артикулом &1 без рецепта в нижний список.", buf_goods.artic ) ).
    14630                        run add-free-fbr-line in this-procedure (
    14631                           input p-mode
    14632                           , input p-price-sale-obj-type
    14633                           , input p-price-sale-obj-code
    14634                           ) .
    14635                        if rs-one-all = "recipe"
    14636                           then
    14637                        do:
    14638                           find first buf_comp_fbr-line no-lock
    14639                              where buf_comp_fbr-line.is-comp = yes
    14640                              and buf_comp_fbr-line.doc-code = f-doc.doc-code
    14641                              and buf_comp_fbr-line.recipe-code = ""
    14642                              no-error.
    14643                           if available buf_comp_fbr-line
    14644                              then
    14645                           do:
    14646                              assign
    14647                                 v-fbr-doc-line-rec = recid (buf_comp_fbr-line)
    14648                                 .
    14649                           end.
    14650                           else
    14651                           do:
    14652                              assign
    14653                                 v-fbr-doc-line-rec = ?
    14654                                 .
    14655                           end.
    14656                        end.
    14657                     end.
    14658               end.
    14659            end.
    14660            run UI-on ("line").
    14661         end.
    14662      end.
    14663   END PROCEDURE.
    14664   PROCEDURE add-recipe :
    14665      do
    14666         on error undo, return error
    14667         :
    14668         define input parameter p-fbr-doc-doc-code   as character    no-undo.
    14669         define input parameter p-artic              as character    no-undo.
    14670         define input parameter p-prod-type          as character    no-undo.
    14671         define input parameter p-prod-code          as integer      no-undo.
    14672         define input parameter p-add-childs         as logical      no-undo.
    14673         define variable v-same-good          as logical no-undo.
    14674         define variable v-same-good-old-qnty as decimal no-undo.
    14675         run create-initial-temp-goods in this-procedure (
    14676            input p-fbr-doc-doc-code
    14677            , input p-artic
    14678            , input p-prod-type
    14679            , input p-prod-code
    14680            , input  ?
    14681            , input ?
    14682            , input ?
    14683            , input ?
    14684            , output v-same-good
    14685            , output v-same-good-old-qnty
    14686            ).
    14687         run calc-not-calculated-goods in this-procedure (
    14688            input parparentproc
    14689            , input p-fbrhist-handle
    14690            , input p-fbr-doc-doc-code
    14691            , input v-same-good
    14692            , input v-same-good-old-qnty
    14693            , input no
    14694            , input p-add-childs
    14695            , input v-price-sale-obj-type
    14696            , input v-price-sale-obj-code
    14697            , input no
    14698            , input no
    14699            ) no-error.
    14700         if error-status :error
    14701         then do:
    14702           undo, return error.
    14703         end.
    14704         run writelog in this-procedure ( log-file-name, 2, "Добавление товаров завершено." ).
    14705      end.
    14706   END PROCEDURE.
    14707   PROCEDURE adjust-changed-ingr-line :
    14708      define input parameter p-doc-code               as character        no-undo.
    14709      define input parameter p-recipe-code            as character        no-undo.
    14710      define input parameter p-artic                  as character        no-undo.
    14711      define input parameter p-prod-type              as character        no-undo.
    14712      define input parameter p-prod-code              as integer          no-undo.
    14713      define input parameter p-old-fact-qnty          as decimal          no-undo.
    14714      define input parameter p-old-price-sale         as decimal          no-undo.
    14715      define input parameter p-old-cost-base          as decimal          no-undo.
    14716      define input parameter p-old-cost-rubl          as decimal          no-undo.
    14717      define input parameter p-old-cost-sum-vat-base  as decimal          no-undo.
    14718      define input parameter p-old-cost-sum-vat-rubl  as decimal          no-undo.
    14719      define input parameter p-old-vat-coeff          as decimal          no-undo.
    14720      define variable v-price-sale as decimal no-undo.
    14721      define variable v-base-rate  as decimal no-undo.
    14722      define variable v-base-scale as decimal no-undo.
    14723      define variable v-today      as date    no-undo.
    14724      define variable v-time       as integer no-undo.
    14725      define buffer buf_fbr-line       for ub.fbr-line.
    14726      define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
    14727      do
    14728         for buf_fbr-line
    14729         with frame D-FBR-DOC
    14730         on error undo, return error
    14731         :
    14732         find first buf_fbr-line exclusive-lock
    14733            where buf_fbr-line.doc-code    = p-doc-code
    14734            and buf_fbr-line.is-comp     = no
    14735            and buf_fbr-line.recipe-code = p-recipe-code
    14736            and buf_fbr-line.artic       = p-artic
    14737            and buf_fbr-line.prod-type   = p-prod-type
    14738            and buf_fbr-line.prod-code   = p-prod-code
    14739            .
    14740         if p-old-fact-qnty <> buf_fbr-line.fact-qnty
    14741            then
    14742         do:
    14743            assign
    14744               buf_fbr-line.calc-method = 1
    14745               .
    14746            display
    14747               get-netto-qnty(recid(buf_fbr-line)) @ ingr-netto
    14748               with browse br-ingr .
    14749         end.
    14750         case f-doc.status_
    14751            :
    14752            when 'новый':U
    14753            then
    14754               do:
    14755                  if buf_fbr-line.price-sale <> p-old-price-sale
    14756                     then
    14757                  do:
    14758                     assign
    14759                        buf_fbr-line.is-calc = yes
    14760                        .
    14761                  end.
    14762                  run fbrlib-calc-prices in this-procedure (
    14763                     input recid( buf_fbr-line )
    14764                     , input v-price-sale-obj-type
    14765                     , input v-price-sale-obj-code
    14766                     , output v-price-sale
    14767                     ) no-error.
    14768                  if error-status:error then
    14769                  do:
    14770                     message substitute("Ошибка при расчете цен по док-ту&1&2&1&3"
    14771                        , chr(10)
    14772                        , error-status:get-message(1)
    14773                        , return-value )
    14774                        view-as alert-box error .
    14775                     undo, return error .
    14776                  end.
    14777                  assign
    14778                     buf_fbr-line.price-sale = v-price-sale
    14779                     .
    14780                  if v-price-sale-obj-type <> v-cntxt-obj-type
    14781                     or v-price-sale-obj-code <> v-cntxt-obj-code
    14782                     then
    14783                  do:
    14784                     assign
    14785                        buf_fbr-line.is-calc = yes
    14786                        .
    14787                  end.
    14788               end.
    14789            when 'разрешен':U
    14790            then
    14791               do:
    14792                  find first ub.fbr-recipe no-lock
    14793                     where ub.fbr-recipe.recipe-code = buf_fbr-line.recipe-code
    14794                     no-error.
    14795                  if buf_fbr-line.trn-type = 'спи':U
    14796                     or buf_fbr-line.is-comp
    14797                     or buf_fbr-line.rsrv-qnty = ?
    14798                     then
    14799                  do:
    14800                     assign
    14801                        buf_fbr-line.fix-cost = no
    14802                        .
    14803                  end.
    14804                  else
    14805                  do:
    14806                     if ( v-base = yes and ( buf_fbr-line.price-base <> p-old-cost-base or buf_fbr-line.price-sum-vat-base <> p-old-cost-sum-vat-base ) )
    14807                        or ( v-base = no  and ( buf_fbr-line.price-rubl <> p-old-cost-rubl or buf_fbr-line.price-sum-vat-rubl <> p-old-cost-sum-vat-rubl ) )
    14808                        then
    14809                     do:
    14810                        assign
    14811                           buf_fbr-line.fix-cost       = yes
    14812                           buf_fbr-line.price-sum-rubl = buf_fbr-line.price-rubl * buf_fbr-line.fact-qnty
    14813                           buf_fbr-line.price-sum-base = buf_fbr-line.price-base * buf_fbr-line.fact-qnty
    14814                           .
    14815                        if ( v-base = yes and buf_fbr-line.price-base <> p-old-cost-base )
    14816                           or ( v-base = no  and buf_fbr-line.price-rubl <> p-old-cost-rubl )
    14817                           then
    14818                        do:
    14819                           assign
    14820                              buf_fbr-line.price-sum-vat-rubl = p-old-vat-coeff * buf_fbr-line.price-sum-rubl
    14821                              buf_fbr-line.price-sum-vat-base = p-old-vat-coeff * buf_fbr-line.price-sum-base
    14822                              .
    14823                        end.
    14824                     end.
    14825                     run cur-time in this-procedure ( output v-today
    14826                        , output v-time
    14827                        ).
    14828   define variable vss-include-info99 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14829   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
    14830     (input  f-doc.host-code
    14831     ,input  v-today
    14832     ,output v-base-rate
    14833     ,output v-base-scale
    14834     ) no-error .
    14835                     if error-status :error
    14836                        then
    14837                     do:
    14838                        message
    14839                           vss-workfile vss-revision vss-description
    14840                           skip
    14841                           "Ошибка вычисления курса базовой валюты."
    14842                           skip return-value
    14843                           skip trim(error-status :get-message(1))
    14844                           trim(error-status :get-message(2))
    14845                           trim(error-status :get-message(3))
    14846                           view-as alert-box error.
    14847                        undo, return error .
    14848                     end.
    14849                     if v-base = yes
    14850                        then
    14851                     do:
    14852                        assign
    14853                           buf_fbr-line.price-rubl         = buf_fbr-line.price-base
    14854                                                                   * ( if v-base-rate = 0 then 1 else v-base-rate )
    14855                                                                   / ( if v-base-scale = 0 then 1 else v-base-scale )
    14856                           buf_fbr-line.price-sum-rubl     = buf_fbr-line.price-rubl * buf_fbr-line.fact-qnty
    14857                           buf_fbr-line.price-sum-vat-rubl = buf_fbr-line.price-sum-vat-base
    14858                                                                   * ( if v-base-rate = 0 then 1 else v-base-rate )
    14859                                                                   / ( if v-base-scale = 0 then 1 else v-base-scale )
    14860                           .
    14861                     end.
    14862                     else
    14863                     do:
    14864                        assign
    14865                           buf_fbr-line.price-base         = buf_fbr-line.price-rubl
    14866                                                                   / ( if v-base-rate = 0 then 1 else v-base-rate )
    14867                                                                   * ( if v-base-scale = 0 then 1 else v-base-scale )
    14868                           buf_fbr-line.price-sum-base     = buf_fbr-line.price-base * buf_fbr-line.fact-qnty
    14869                           buf_fbr-line.price-sum-vat-base = buf_fbr-line.price-sum-vat-rubl
    14870                                                                   / ( if v-base-rate = 0 then 1 else v-base-rate )
    14871                                                                   * ( if v-base-scale = 0 then 1 else v-base-scale )
    14872                           .
    14873                     end.
    14874                     if buf_fbr-line.price-base <> p-old-cost-base
    14875                        or buf_fbr-line.price-rubl <> p-old-cost-rubl
    14876                        then
    14877                     do:
    14878                        run str/fbrclcin.p (
    14879                           input buf_fbr-line.doc-code
    14880                           , input buf_fbr-line.recipe-code
    14881                           , input v-base
    14882                           , input v-base-rate
    14883                           , input v-base-scale
    14884                           ).
    14885                     end.
    14886                  end.
    14887               end.
    14888         end case.
    14889      end.
    14890   END PROCEDURE.
    14891   PROCEDURE assign-current-goods :
    14892      do
    14893         on error undo, return error
    14894         :
    14895         define buffer buf_goods for ub.goods.
    14896         if current-browse = br-ingr :handle in frame D-FBR-DOC
    14897            or not available( buf_comp_fbr-line )
    14898            then
    14899         do:
    14900            find first buf_goods no-lock
    14901               where buf_goods.artic     = buf_ingr_fbr-line.artic
    14902               and buf_goods.prod-type = buf_ingr_fbr-line.prod-type
    14903               and buf_goods.prod-code = buf_ingr_fbr-line.prod-code
    14904               no-error.
    14905         end.
    14906         else
    14907         do:
    14908            find first buf_goods no-lock
    14909               where buf_goods.artic     = buf_comp_fbr-line.artic
    14910               and buf_goods.prod-type = buf_comp_fbr-line.prod-type
    14911               and buf_goods.prod-code = buf_comp_fbr-line.prod-code
    14912               no-error.
    14913         end.
    14914         if available buf_goods
    14915            then
    14916         do:
    14917            assign
    14918               gds-rec = recid( buf_goods )
    14919               .
    14920         end.
    14921      end.
    14922   END PROCEDURE.
    14923   PROCEDURE assign-ingr-line :
    14924      define input parameter p-ingr-fbr-line-rowid    as rowid            no-undo.
    14925      define input parameter p-fact-qnty              as decimal          no-undo.
    14926      define input parameter p-is-calc                as logical          no-undo.
    14927      define input parameter p-price-sale             as decimal          no-undo.
    14928      define input parameter p-fix-cost               as logical          no-undo.
    14929      define input parameter p-price-rubl             as decimal          no-undo.
    14930      define input parameter p-price-base             as decimal          no-undo.
    14931      define input parameter p-price-sum-vat-rubl     as decimal          no-undo.
    14932      define input parameter p-price-sum-vat-base     as decimal          no-undo.
    14933      define variable old-fact-qnty         as decimal no-undo .
    14934      define variable old-price-sale        like ub.fbr-line.price-sale no-undo .
    14935      define variable old-cost-base         like ub.fbr-line.price-base no-undo .
    14936      define variable old-cost-rubl         like ub.fbr-line.price-rubl no-undo .
    14937      define variable old-cost-sum-vat-base like ub.fbr-line.price-base no-undo .
    14938      define variable old-cost-sum-vat-rubl like ub.fbr-line.price-rubl no-undo .
    14939      define variable old-vat-coeff         as decimal no-undo.
    14940      define buffer buf_loc_ingr_fbr-line for ub.fbr-line.
    14941      do
    14942         for buf_loc_ingr_fbr-line
    14943         on error undo, return error
    14944         :
    14945         find first buf_loc_ingr_fbr-line exclusive-lock
    14946            where rowid( buf_loc_ingr_fbr-line ) = p-ingr-fbr-line-rowid
    14947            .
    14948         assign
    14949            old-fact-qnty         = buf_loc_ingr_fbr-line.fact-qnty
    14950            old-price-sale        = buf_loc_ingr_fbr-line.price-sale
    14951            old-cost-rubl         = buf_loc_ingr_fbr-line.price-rubl
    14952            old-cost-base         = buf_loc_ingr_fbr-line.price-base
    14953            old-cost-sum-vat-rubl = buf_loc_ingr_fbr-line.price-sum-vat-rubl
    14954            old-cost-sum-vat-base = buf_loc_ingr_fbr-line.price-sum-vat-base
    14955            .
    14956         if v-base = yes
    14957            then
    14958         do:
    14959            assign
    14960               old-vat-coeff = ( if old-cost-base = 0
    14961                                   or old-cost-base = ?
    14962                                   then 0
    14963                                   else old-cost-sum-vat-base / ( old-cost-base * buf_loc_ingr_fbr-line.fact-qnty ) )
    14964               .
    14965         end.
    14966         else
    14967         do:
    14968            assign
    14969               old-vat-coeff = ( if old-cost-rubl = 0
    14970                                   or old-cost-rubl = ?
    14971                                   then 0
    14972                                   else old-cost-sum-vat-rubl / ( old-cost-rubl * buf_loc_ingr_fbr-line.fact-qnty ) )
    14973               .
    14974         end.
    14975         assign
    14976            buf_loc_ingr_fbr-line.fact-qnty          = p-fact-qnty
    14977            buf_loc_ingr_fbr-line.is-calc            = p-is-calc
    14978            buf_loc_ingr_fbr-line.price-sale         = p-price-sale
    14979            buf_loc_ingr_fbr-line.fix-cost           = p-fix-cost
    14980            buf_loc_ingr_fbr-line.price-rubl         = p-price-rubl
    14981            buf_loc_ingr_fbr-line.price-base         = p-price-base
    14982            buf_loc_ingr_fbr-line.price-sum-vat-rubl = p-price-sum-vat-rubl
    14983            buf_loc_ingr_fbr-line.price-sum-vat-base = p-price-sum-vat-base
    14984            .
    14985         run adjust-changed-ingr-line in this-procedure (
    14986            input buf_loc_ingr_fbr-line.doc-code
    14987            , input buf_loc_ingr_fbr-line.recipe-code
    14988            , input buf_loc_ingr_fbr-line.artic
    14989            , input buf_loc_ingr_fbr-line.prod-type
    14990            , input buf_loc_ingr_fbr-line.prod-code
    14991            , input old-fact-qnty
    14992            , input old-price-sale
    14993            , input old-cost-base
    14994            , input old-cost-rubl
    14995            , input old-cost-sum-vat-base
    14996            , input old-cost-sum-vat-rubl
    14997            , input old-vat-coeff
    14998            ) no-error.
    14999         if error-status :error
    15000            then
    15001         do:
    15002            message
    15003               vss-workfile vss-revision vss-description
    15004               skip(1)
    15005               skip
    15006               "Ошибка пересчета измененной строки"
    15007               skip
    15008               "документа производства"
    15009               skip return-value
    15010               skip trim(error-status :get-message(1))
    15011               trim(error-status :get-message(2))
    15012               trim(error-status :get-message(3))
    15013               view-as alert-box error.
    15014            undo, return error .
    15015         end.
    15016      end.
    15017   END PROCEDURE.
    15018   PROCEDURE assign-obj-fbroperator :
    15019      define buffer buf_clients for ub.clients.
    15020      do
    15021         for buf_clients
    15022         on error undo, return error
    15023         :
    15024         if v-fbr-doc-fbroperator-code = 0
    15025            then
    15026         do:
    15027            assign
    15028               obj-fbroperator = "":U
    15029               .
    15030         end.
    15031         else
    15032         do:
    15033            find first buf_clients no-lock
    15034               where buf_clients.obj-type = 'чел':U
    15035               and buf_clients.obj-code = v-fbr-doc-fbroperator-code
    15036               no-error.
    15037            if available buf_clients
    15038               then
    15039            do:
    15040               assign
    15041                  obj-fbroperator = buf_clients.obj-name
    15042                  .
    15043            end.
    15044            else
    15045            do:
    15046               assign
    15047                  obj-fbroperator = "":U
    15048                  .
    15049            end.
    15050         end.
    15051      end.
    15052   END PROCEDURE.
    15053   PROCEDURE change-current-comp-line :
    15054      do
    15055         on error undo, return error
    15056         :
    15057         define input parameter p-comp-fbr-v-fbr-doc-line-recid    as recid        no-undo.
    15058         define input parameter p-fbr-doc-status         as character    no-undo.
    15059         define input parameter p-host-code              as integer      no-undo.
    15060         define variable old-cost-base         like ub.fbr-line.price-base no-undo .
    15061         define variable old-cost-rubl         like ub.fbr-line.price-rubl no-undo .
    15062         define variable old-cost-sum-vat-base like ub.fbr-line.price-sum-vat-base no-undo .
    15063         define variable old-cost-sum-vat-rubl like ub.fbr-line.price-sum-vat-rubl no-undo .
    15064         define variable v-price-sale          as decimal no-undo.
    15065         define variable v-today               as date    no-undo.
    15066         define variable v-time                as integer no-undo.
    15067         define variable v-base-rate           as decimal no-undo.
    15068         define variable v-base-scale          as decimal no-undo.
    15069         define buffer buf_fbr-doc  for ub.fbr-doc.
    15070         define buffer buf_fbr-line for ub.fbr-line.
    15071         define buffer buf_recipe   for ub.fbr-recipe.
    15072         find first buf_fbr-line exclusive-lock
    15073            where recid( buf_fbr-line ) = p-comp-fbr-v-fbr-doc-line-recid
    15074            .
    15075         if p-fbr-doc-status = 'новый':U
    15076            then
    15077         do:
    15078            assign
    15079               browse br-comp
    15080               buf_comp_fbr-line.is-calc
    15081               .
    15082            run fbrlib-calc-prices in this-procedure (
    15083               input p-comp-fbr-v-fbr-doc-line-recid
    15084               , input v-price-sale-obj-type
    15085               , input v-price-sale-obj-code
    15086               , output v-price-sale
    15087               ) no-error.
    15088            if error-status:error then
    15089            do:
    15090               message substitute("Ошибка при расчете цен по док-ту&1&2&1&3"
    15091                  , chr(10)
    15092                  , error-status:get-message(1)
    15093                  , return-value )
    15094                  view-as alert-box error .
    15095               undo, return error .
    15096            end.
    15097            if v-price-sale <> ?
    15098               then
    15099            do:
    15100               assign
    15101                  buf_fbr-line.price-sale = v-price-sale
    15102                  .
    15103               if v-price-sale-obj-type <> v-cntxt-obj-type
    15104                  or v-price-sale-obj-code <> v-cntxt-obj-code
    15105                  then
    15106               do:
    15107                  assign
    15108                     buf_fbr-line.is-calc = yes
    15109                     .
    15110               end.
    15111            end.
    15112         end.
    15113         if p-fbr-doc-status = 'разрешен':U
    15114            then
    15115         do:
    15116            find first buf_recipe no-lock
    15117               where buf_recipe.doc-code      = f-doc.doc-code
    15118               and buf_recipe.recipe-code   = buf_fbr-line.recipe-code
    15119               no-error.
    15120            if buf_fbr-line.trn-type = 'спи':U
    15121               or available buf_recipe
    15122               or buf_fbr-line.rsrv-qnty = ?
    15123               then
    15124            do:
    15125               assign
    15126                  buf_fbr-line.fix-cost = no
    15127                  .
    15128            end.
    15129            else
    15130            do:
    15131               assign
    15132                  old-cost-base         = buf_fbr-line.price-base
    15133                  old-cost-rubl         = buf_fbr-line.price-rubl
    15134                  old-cost-sum-vat-base = buf_fbr-line.price-sum-vat-base
    15135                  old-cost-sum-vat-rubl = buf_fbr-line.price-sum-vat-rubl
    15136                  browse br-comp
    15137                  buf_comp_fbr-line.fix-cost
    15138                  buf_comp_fbr-line.price-rubl
    15139                  buf_comp_fbr-line.price-base
    15140                  buf_comp_fbr-line.price-sum-vat-rubl
    15141                  buf_comp_fbr-line.price-sum-vat-base
    15142                  .
    15143               if ( v-base = yes
    15144                  and ( buf_fbr-line.price-base <> old-cost-base
    15145                  or buf_fbr-line.price-sum-vat-base <> old-cost-sum-vat-base ) )
    15146                  or ( v-base = no
    15147                  and ( buf_fbr-line.price-rubl <> old-cost-rubl
    15148                  or buf_fbr-line.price-sum-vat-rubl <> old-cost-sum-vat-rubl ) )
    15149                  then
    15150               do:
    15151                  assign
    15152                     buf_fbr-line.fix-cost = yes
    15153                     .
    15154                  run cur-time in this-procedure ( output v-today
    15155                     , output v-time
    15156                     ).
    15157   define variable vss-include-info100 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    15158   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
    15159     (input  p-host-code
    15160     ,input  v-today
    15161     ,output v-base-rate
    15162     ,output v-base-scale
    15163     ) no-error .
    15164                  if error-status :error
    15165                     then
    15166                  do:
    15167                     message
    15168                        vss-workfile vss-revision vss-description
    15169                        skip
    15170                        "Ошибка вычисления курса базовой валюты."
    15171                        skip return-value
    15172                        skip trim(error-status :get-message(1))
    15173                        trim(error-status :get-message(2))
    15174                        trim(error-status :get-message(3))
    15175                        view-as alert-box error.
    15176                     undo, return no-apply .
    15177                  end.
    15178                  if v-base = yes
    15179                     then
    15180                  do:
    15181                     if buf_fbr-line.price-sum-vat-base <> old-cost-sum-vat-base
    15182                        then
    15183                     do:
    15184                        assign
    15185                           buf_fbr-line.price-sum-vat-rubl = buf_fbr-line.price-sum-vat-base
    15186                                                               * ( if v-base-rate = 0 then 1 else v-base-rate )
    15187                                                               / ( if v-base-scale = 0 then 1 else v-base-scale )
    15188                           .
    15189                     end.
    15190                     if buf_fbr-line.price-base <> old-cost-base
    15191                        then
    15192                     do:
    15193                        assign
    15194                           buf_fbr-line.price-rubl = buf_fbr-line.price-base
    15195                                                               * ( if v-base-rate = 0 then 1 else v-base-rate )
    15196                                                               / ( if v-base-scale = 0 then 1 else v-base-scale )
    15197                           .
    15198                     end.
    15199                  end.
    15200                  else
    15201                  do:
    15202                     if buf_fbr-line.price-sum-vat-rubl <> old-cost-sum-vat-rubl
    15203                        then
    15204                     do:
    15205                        assign
    15206                           buf_fbr-line.price-sum-vat-base = buf_fbr-line.price-sum-vat-rubl
    15207                                                               / ( if v-base-rate = 0 then 1 else v-base-rate )
    15208                                                               * ( if v-base-scale = 0 then 1 else v-base-scale )
    15209                           .
    15210                     end.
    15211                     if buf_fbr-line.price-rubl <> old-cost-rubl
    15212                        then
    15213                     do:
    15214                        assign
    15215                           buf_fbr-line.price-base = buf_fbr-line.price-rubl
    15216                                                               / ( if v-base-rate = 0 then 1 else v-base-rate )
    15217                                                               * ( if v-base-scale = 0 then 1 else v-base-scale )
    15218                           .
    15219                     end.
    15220                  end.
    15221                  assign
    15222                     buf_fbr-line.price-sum-rubl = buf_fbr-line.price-rubl * buf_fbr-line.fact-qnty
    15223                     buf_fbr-line.price-sum-base = buf_fbr-line.price-base * buf_fbr-line.fact-qnty
    15224                     buf_fbr-line.rsrv-qnty      = buf_fbr-line.fact-qnty
    15225                     .
    15226               end.
    15227               if buf_comp_fbr-line.price-sum-vat-rubl >= buf_comp_fbr-line.price-sum-rubl
    15228                  or buf_comp_fbr-line.price-sum-vat-base >= buf_comp_fbr-line.price-sum-base
    15229                  then
    15230               do:
    15231                  assign
    15232                     buf_comp_fbr-line.price-sum-vat-rubl = old-cost-sum-vat-rubl
    15233                     buf_comp_fbr-line.price-sum-vat-base = old-cost-sum-vat-base
    15234                     buf_comp_fbr-line.price-sum-rubl     = old-cost-rubl
    15235                     buf_comp_fbr-line.price-sum-base     = old-cost-base
    15236                     .
    15237                  message
    15238                     skip
    15239                     "Сумма НДС учетных цен не может быть"
    15240                     skip
    15241                     "больше или равна сумме учетных цен"
    15242                     skip(1)
    15243                     skip
    15244                     "Введите верные данные."
    15245                     view-as alert-box error.
    15246                  undo, return error .
    15247               end.
    15248            end.
    15249         end.
    15250      end.
    15251   END PROCEDURE.
    15252   PROCEDURE check-and-correct-fbr-recipe :
    15253      define input parameter p-fbr-doc-code       as character        no-undo.
    15254      define input parameter p-fbr-recipe-code    as character        no-undo.
    15255      define output parameter p-can-continue      as logical          no-undo.
    15256      define variable v-is-correct as logical no-undo.
    15257      define variable v-yesno      as logical no-undo.
    15258      do
    15259         on error undo, return error
    15260         :
    15261         assign
    15262            p-can-continue = yes
    15263            .
    15264         run fbrlib-check-fbr-recipe in this-procedure (
    15265            input p-fbr-doc-code
    15266            , input p-fbr-recipe-code
    15267            , output v-is-correct
    15268            ).
    15269         if v-is-correct = no
    15270            then
    15271         do:
    15272            assign
    15273               v-yesno = no
    15274               .
    15275            message
    15276               "Рецепт документа не соответствует строкам документа."
    15277               skip(1)
    15278               "Номер рецепта:" p-fbr-recipe-code
    15279               skip(1)
    15280               skip
    15281               "Вы можете:"
    15282               skip
    15283               "    Изменить рецепт документа в соответствии"
    15284               skip
    15285               "        с введенными значениями количеств ингредиентов."
    15286               skip
    15287               "    или вернуться к редактированию документа,"
    15288               skip
    15289               "        чтобы привести строки в соответствие рецепту"
    15290               skip
    15291               "        кнопками Составной и Ингредиенты"
    15292               skip(1)
    15293               skip
    15294               "Изменить рецепт документа?"
    15295               view-as alert-box question
    15296               buttons ok-cancel
    15297               title "Изменение рецепта документа"
    15298               update v-yesno.
    15299            if v-yesno = yes
    15300               then
    15301            do:
    15302               run fbrlib_adjust-recipe in this-procedure (
    15303                  input parparentproc
    15304                  , input p-fbrhist-handle
    15305                  , input p-fbr-doc-code
    15306                  , input p-fbr-recipe-code
    15307                  , input v-price-sale-obj-type
    15308                  , input v-price-sale-obj-code
    15309                  ).
    15310            end.
    15311            else
    15312            do:
    15313               assign
    15314                  p-can-continue = no
    15315                  .
    15316               undo, return.
    15317            end.
    15318         end.
    15319      end.
    15320   END PROCEDURE.
    15321   PROCEDURE del-proc :
    15322      do
    15323         on error undo, return error
    15324         :
    15325         define input parameter p-mode as character no-undo.
    15326         define output parameter p-deleted as logical      no-undo.
    15327         define variable v-rcp-list as character no-undo.
    15328         define variable v-count    as integer   no-undo.
    15329         define buffer buf_fbr-line           for ub.fbr-line.
    15330         define buffer buf_del_fbr-line       for ub.fbr-line.
    15331         define buffer buf_del_fbr-recipe     for ub.fbr-recipe.
    15332         define buffer buf_del_fbr-recipe-gds for ub.fbr-recipe-gds.
    15333         define buffer buf_goods              for ub.goods .
    15334         define buffer buf_marking            for ub.marking .
    15335         define buffer buf_marking-lines      for ub.marking-lines .
    15336         assign
    15337            p-deleted = no
    15338            .
    15339         case p-mode:
    15340            when "down"
    15341            then
    15342               do:
    15343                  if not available buf_ingr_fbr-line
    15344                     then
    15345                  do:
    15346                     message "Неправильно выбрана строка нижнего списка.".
    15347                  end.
    15348                  else
    15349                  do:
    15350                     if buf_ingr_fbr-line.recipe-code <> ""
    15351                        then
    15352                     do:
    15353                        message "Строка нижнего списка может быть удалена только по рецепту.".
    15354                     end.
    15355                     else
    15356                     do:
    15357                        assign
    15358                           v-fbr-doc-g-log = no
    15359                           .
    15360                        message
    15361                           "Удалить строку нижнего списка?"
    15362                           view-as alert-box question
    15363                           buttons yes-no
    15364                           title "Удаление строки"
    15365                           update v-fbr-doc-g-log.
    15366                        if v-fbr-doc-g-log = yes
    15367                           then
    15368                        do:
    15369                           assign
    15370                              v-fbr-doc-line-rec = recid( buf_ingr_fbr-line )
    15371                              .
    15372                           get next br-ingr.
    15373                           if available buf_ingr_fbr-line
    15374                              then
    15375                           do:
    15376                              assign
    15377                                 v-fbr-doc-rep-rec = recid( buf_ingr_fbr-line )
    15378                                 .
    15379                           end.
    15380                           else
    15381                           do:
    15382                              reposition br-ingr to recid v-fbr-doc-line-rec no-error.
    15383                              get prev br-ingr.
    15384                              assign
    15385                                 v-fbr-doc-rep-rec = recid( buf_ingr_fbr-line )
    15386                                 .
    15387                           end.
    15388                           del-ingr:
    15389                           do transaction
    15390                              on stop  undo del-ingr, return no-apply
    15391                              on error undo del-ingr, return no-apply
    15392                              :
    15393                              find first buf_ingr_fbr-line exclusive-lock
    15394                                 where recid( buf_ingr_fbr-line ) = v-fbr-doc-line-rec
    15395                                 .
    15396                              for first buf_goods no-lock where buf_goods.artic      = buf_ingr_fbr-line.artic
    15397                                                            and buf_goods.prod-type  = buf_ingr_fbr-line.prod-type
    15398                                                            and buf_goods.prod-code  = buf_ingr_fbr-line.prod-code,
    15399                              each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
    15400                                                                      and buf_marking-lines.obj-type = f-doc.obj-type
    15401                                                                      and buf_marking-lines.obj-code = f-doc.obj-code
    15402                                                                      and buf_marking-lines.in-code  = "manufacturing"
    15403                                                                      and buf_marking-lines.out-code = buf_ingr_fbr-line.doc-code
    15404                                                                      and buf_marking-lines.part-code = buf_ingr_fbr-line.recipe-code
    15405                                                                      and buf_marking-lines.prt-code = 0
    15406                              :
    15407                                for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
    15408                                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
    15409                                end .
    15410                                delete buf_marking-lines.
    15411                              end .
    15412                              delete buf_ingr_fbr-line.
    15413                           end.
    15414                           assign
    15415                              v-fbr-doc-line-rec = recid( buf_comp_fbr-line )
    15416                              p-deleted          = yes
    15417                              .
    15418                        end.
    15419                     end.
    15420                  end.
    15421               end.
    15422            when "up"
    15423            then
    15424               do:
    15425                  if not available buf_comp_fbr-line
    15426                     then
    15427                  do:
    15428                     message
    15429                        "Неправильно выбрана строка верхнего списка."
    15430                        view-as alert-box.
    15431                  end.
    15432                  else
    15433                  do:
    15434                     if buf_comp_fbr-line.recipe-code <> ""
    15435                        then
    15436                     do:
    15437                        message
    15438                           "Строка верхнего списка может быть удалена только по рецепту."
    15439                           view-as alert-box information
    15440                           title "Удаление строки".
    15441                     end.
    15442                     else
    15443                     do:
    15444                        assign
    15445                           v-fbr-doc-g-log = no
    15446                           .
    15447                        message
    15448                           "Удалить строку верхнего списка?"
    15449                           view-as alert-box question
    15450                           buttons yes-no
    15451                           title "Удаление строки"
    15452                           update v-fbr-doc-g-log.
    15453                        if v-fbr-doc-g-log = yes
    15454                           then
    15455                        do:
    15456                           assign
    15457                              v-fbr-doc-line-rec = recid (buf_comp_fbr-line)
    15458                              .
    15459                           get next br-comp.
    15460                           if available buf_comp_fbr-line
    15461                              then
    15462                           do:
    15463                              assign
    15464                                 v-fbr-doc-rep-rec = recid (buf_comp_fbr-line)
    15465                                 .
    15466                           end.
    15467                           else
    15468                           do:
    15469                              reposition br-comp to recid v-fbr-doc-line-rec no-error.
    15470                              get prev br-comp.
    15471                              assign
    15472                                 v-fbr-doc-rep-rec = recid (buf_comp_fbr-line)
    15473                                 .
    15474                           end.
    15475                           del-comp:
    15476                           do transaction
    15477                              on stop undo del-comp, return no-apply
    15478                              on error undo del-comp, return no-apply
    15479                              :
    15480                              find first buf_comp_fbr-line exclusive-lock
    15481                                 where recid (buf_comp_fbr-line) = v-fbr-doc-line-rec
    15482                                 .
    15483                              for first buf_goods no-lock where buf_goods.artic      = buf_comp_fbr-line.artic
    15484                                                            and buf_goods.prod-type  = buf_comp_fbr-line.prod-type
    15485                                                            and buf_goods.prod-code  = buf_comp_fbr-line.prod-code,
    15486                              each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
    15487                                                                      and buf_marking-lines.obj-type = f-doc.obj-type
    15488                                                                      and buf_marking-lines.obj-code = f-doc.obj-code
    15489                                                                      and buf_marking-lines.in-code  = "manufacturing"
    15490                                                                      and buf_marking-lines.out-code = buf_comp_fbr-line.doc-code
    15491                                                                      and buf_marking-lines.part-code = buf_comp_fbr-line.recipe-code
    15492                                                                      and buf_marking-lines.prt-code = 0
    15493                              :
    15494                                for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
    15495                                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB .
    15496                                end .
    15497                                delete buf_marking-lines.
    15498                              end .
    15499                              delete buf_comp_fbr-line.
    15500                           end.
    15501                           assign
    15502                              v-fbr-doc-line-rec = v-fbr-doc-rep-rec
    15503                              p-deleted          = yes
    15504                              .
    15505                        end.
    15506                     end.
    15507                  end.
    15508               end.
    15509            when "all-doc"
    15510            then
    15511               do:
    15512                  assign
    15513                     v-fbr-doc-g-log = no
    15514                     .
    15515                  message
    15516                     "Удалить все строки документа?"
    15517                     view-as alert-box question
    15518                     buttons yes-no
    15519                     update v-fbr-doc-g-log.
    15520                  if v-fbr-doc-g-log = yes
    15521                     then
    15522                  do:
    15523                     for each buf_fbr-line no-lock
    15524                        where buf_fbr-line.doc-code      = f-doc.doc-code
    15525                        on error undo, return error
    15526                        :
    15527                        do transaction
    15528                           on error undo, return error
    15529                           :
    15530                           if buf_fbr-line.is-comp = yes
    15531                              then
    15532                           do:
    15533                              find first buf_del_fbr-recipe exclusive-lock
    15534                                 where buf_del_fbr-recipe.doc-code    = f-doc.doc-code
    15535                                 and buf_del_fbr-recipe.recipe-code = buf_fbr-line.recipe-code
    15536                                 no-error.
    15537                              if available buf_del_fbr-recipe
    15538                                 then
    15539                              do:
    15540                                 delete buf_del_fbr-recipe.
    15541                              end.
    15542                           end.
    15543                           else
    15544                           do:
    15545                              find first buf_del_fbr-recipe-gds exclusive-lock
    15546                                 where buf_del_fbr-recipe-gds.doc-code    = f-doc.doc-code
    15547                                 and buf_del_fbr-recipe-gds.recipe-code = buf_fbr-line.recipe-code
    15548                                 and buf_del_fbr-recipe-gds.prod-type   = buf_fbr-line.prod-type
    15549                                 and buf_del_fbr-recipe-gds.prod-code   = buf_fbr-line.prod-code
    15550                                 and buf_del_fbr-recipe-gds.artic       = buf_fbr-line.artic
    15551                                 no-error.
    15552                              if available buf_del_fbr-recipe-gds
    15553                                 then
    15554                              do:
    15555                                 delete buf_del_fbr-recipe-gds.
    15556                              end.
    15557                           end.
    15558                           find first buf_del_fbr-line exclusive-lock
    15559                              where recid( buf_del_fbr-line ) = recid( buf_fbr-line )
    15560                              .
    15561                           for first buf_goods no-lock where buf_goods.artic      = buf_del_fbr-line.artic
    15562                                                         and buf_goods.prod-type  = buf_del_fbr-line.prod-type
    15563                                                         and buf_goods.prod-code  = buf_del_fbr-line.prod-code,
    15564                           each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
    15565                                                                   and buf_marking-lines.obj-type = f-doc.obj-type
    15566                                                                   and buf_marking-lines.obj-code = f-doc.obj-code
    15567                                                                   and buf_marking-lines.in-code  = "manufacturing"
    15568                                                                   and buf_marking-lines.out-code = buf_del_fbr-line.doc-code
    15569                                                                   and buf_marking-lines.part-code = buf_del_fbr-line.recipe-code
    15570                                                                   and buf_marking-lines.prt-code = 0
    15571                           :
    15572                             for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
    15573                                assign
    15574                                  buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB when not buf_del_fbr-line.is-comp
    15575                                  buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_del_fbr-line.is-comp
    15576                                .
    15577                             end .
    15578                             delete buf_marking-lines.
    15579                           end .
    15580                           delete buf_del_fbr-line.
    15581                        end.
    15582                     end.
    15583                     assign
    15584                        p-deleted = yes
    15585                        .
    15586                  end.
    15587               end.
    15588            when "rcp"
    15589            or
    15590            when "all"
    15591            then
    15592               do:
    15593                  if not available buf_comp_fbr-line
    15594                     then
    15595                  do:
    15596                     message "Неправильно выбрана строка документа (из верхнего списка).".
    15597                  end.
    15598                  else
    15599                  do:
    15600                     assign
    15601                        v-fbr-doc-g-log = no
    15602                        .
    15603                     if p-mode = "rcp"
    15604                        then
    15605                     do:
    15606                        message
    15607                           "Удалить все строки документа, соответствующие текущему рецепту?"
    15608                           view-as alert-box question
    15609                           buttons yes-no
    15610                           update v-fbr-doc-g-log.
    15611                     end.
    15612                     else
    15613                     do:
    15614                        message
    15615                           "Удалить строки документа, соответствующие текущему рецепту, а также рецептам для ингредиентов?"
    15616                           view-as alert-box question
    15617                           buttons yes-no
    15618                           update v-fbr-doc-g-log.
    15619                     end.
    15620                     if v-fbr-doc-g-log = yes
    15621                        then
    15622                     do:
    15623                        assign
    15624                           v-rcp-list         = buf_comp_fbr-line.recipe-code
    15625                           v-fbr-doc-line-rec = recid (buf_comp_fbr-line)
    15626                           v-fbr-doc-rep-rec  = ?
    15627                           .
    15628                        get next br-comp .
    15629                        if available buf_comp_fbr-line then
    15630                        do :
    15631                           v-fbr-doc-line-rec = recid (buf_comp_fbr-line) .
    15632                           get prev br-comp .
    15633                        end.
    15634                        if p-mode = "all"
    15635                           then
    15636                        do:
    15637                           run fill-del-list in this-procedure (
    15638                              input buf_comp_fbr-line.recipe-code
    15639                              , output v-rcp-list
    15640                              ).
    15641                        end.
    15642                        do v-count = 1 to num-entries( v-rcp-list )
    15643                           :
    15644                           for each buf_fbr-line no-lock
    15645                              where buf_fbr-line.doc-code      = f-doc.doc-code
    15646                              and buf_fbr-line.recipe-code   = entry( v-count, v-rcp-list )
    15647                              on error undo, return error
    15648                              :
    15649                              do transaction
    15650                                 on error undo, return error
    15651                                 :
    15652                                 if buf_fbr-line.is-comp = yes
    15653                                    then
    15654                                 do:
    15655                                    find first buf_del_fbr-recipe exclusive-lock
    15656                                       where buf_del_fbr-recipe.doc-code    = f-doc.doc-code
    15657                                       and buf_del_fbr-recipe.recipe-code = buf_fbr-line.recipe-code
    15658                                       no-error.
    15659                                    if available buf_del_fbr-recipe
    15660                                       then
    15661                                    do:
    15662                                       delete buf_del_fbr-recipe.
    15663                                    end.
    15664                                 end.
    15665                                 else
    15666                                 do:
    15667                                    find first buf_del_fbr-recipe-gds exclusive-lock
    15668                                       where buf_del_fbr-recipe-gds.doc-code    = f-doc.doc-code
    15669                                       and buf_del_fbr-recipe-gds.recipe-code = buf_fbr-line.recipe-code
    15670                                       and buf_del_fbr-recipe-gds.prod-type   = buf_fbr-line.prod-type
    15671                                       and buf_del_fbr-recipe-gds.prod-code   = buf_fbr-line.prod-code
    15672                                       and buf_del_fbr-recipe-gds.artic       = buf_fbr-line.artic
    15673                                       no-error.
    15674                                    if available buf_del_fbr-recipe-gds
    15675                                       then
    15676                                    do:
    15677                                       delete buf_del_fbr-recipe-gds.
    15678                                    end.
    15679                                 end.
    15680                                 find first buf_del_fbr-line exclusive-lock
    15681                                    where recid( buf_del_fbr-line ) = recid( buf_fbr-line )
    15682                                    .
    15683                                 for first buf_goods no-lock where buf_goods.artic      = buf_del_fbr-line.artic
    15684                                                               and buf_goods.prod-type  = buf_del_fbr-line.prod-type
    15685                                                               and buf_goods.prod-code  = buf_del_fbr-line.prod-code,
    15686                                 each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
    15687                                                                         and buf_marking-lines.obj-type = f-doc.obj-type
    15688                                                                         and buf_marking-lines.obj-code = f-doc.obj-code
    15689                                                                         and buf_marking-lines.in-code  = "manufacturing"
    15690                                                                         and buf_marking-lines.out-code = buf_del_fbr-line.doc-code
    15691                                                                         and buf_marking-lines.part-code = buf_del_fbr-line.recipe-code
    15692                                                                         and buf_marking-lines.prt-code = 0
    15693                                 :
    15694                                   for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
    15695                                      assign
    15696                                        buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB when not buf_del_fbr-line.is-comp
    15697                                        buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_del_fbr-line.is-comp
    15698                                      .
    15699                                   end .
    15700                                   delete buf_marking-lines.
    15701                                 end .
    15702                                 delete buf_del_fbr-line.
    15703                              end.
    15704                           end.
    15705                        end.
    15706                        assign
    15707                           p-deleted = yes
    15708                           .
    15709                     end.
    15710                  end.
    15711               end.
    15712         end case.
    15713      end.
    15714   END PROCEDURE.
    15715   PROCEDURE disable_UI :
    15716      HIDE FRAME D-FBR-DOC.
    15717   END PROCEDURE.
    15718   PROCEDURE fill-del-list :
    15719      define input parameter r-code       like ub.fbr-recipe.recipe-code no-undo.
    15720      define output parameter p-rcp-list  as character    no-undo.
    15721      define buffer buf_ingr_fbr-line for ub.fbr-line.
    15722      define buffer buf_comp_fbr-line for ub.fbr-line.
    15723      assign
    15724         p-rcp-list = string( r-code )
    15725         .
    15726      for each buf_ingr_fbr-line no-lock
    15727         where buf_ingr_fbr-line.doc-code = f-doc.doc-code
    15728         and buf_ingr_fbr-line.is-comp = no
    15729         and buf_ingr_fbr-line.recipe-code = r-code
    15730         :
    15731         for each buf_comp_fbr-line no-lock
    15732            where buf_comp_fbr-line.doc-code = buf_ingr_fbr-line.doc-code
    15733            and buf_comp_fbr-line.is-comp = yes
    15734            and buf_comp_fbr-line.artic = buf_ingr_fbr-line.artic
    15735            and buf_comp_fbr-line.prod-type = buf_ingr_fbr-line.prod-type
    15736            and buf_comp_fbr-line.prod-code = buf_ingr_fbr-line.prod-code
    15737            :
    15738            assign
    15739               p-rcp-list = p-rcp-list + "," + buf_comp_fbr-line.recipe-code
    15740               .
    15741         end.
    15742      end.
    15743   END PROCEDURE.
    15744   PROCEDURE fill-recipe-fields :
    15745      do
    15746         on error undo, return error
    15747         :
    15748         define input parameter p-recipe-code as character    no-undo.
    15749         define buffer buf_recipe for ub.fbr-recipe.
    15750         find first buf_recipe no-lock
    15751            where buf_recipe.doc-code = f-doc.doc-code
    15752            and buf_recipe.recipe-code = p-recipe-code
    15753            no-error.
    15754         if available buf_recipe
    15755            then
    15756         do:
    15757            display
    15758               buf_recipe.recipe-code  @ ub.fbr-recipe.recipe-code
    15759               buf_recipe.recipe-name  @ ub.fbr-recipe.recipe-name
    15760               buf_recipe.recipe-type  @ ub.fbr-recipe.recipe-type
    15761               buf_recipe.qnty         @ ub.fbr-recipe.qnty
    15762               with frame D-FBR-DOC.
    15763         end.
    15764         else
    15765         do:
    15766            display
    15767               "" @ ub.fbr-recipe.recipe-code
    15768               "" @ ub.fbr-recipe.recipe-name
    15769               "" @ ub.fbr-recipe.recipe-type
    15770               "" @ ub.fbr-recipe.qnty
    15771               with frame D-FBR-DOC.
    15772         end.
    15773      end.
    15774   END PROCEDURE.
    15775   PROCEDURE get-current-goods-recid :
    15776      define output parameter p-gds-rec as recid            no-undo.
    15777      do
    15778         on error undo, return error
    15779         :
    15780         define buffer buf_goods for ub.goods.
    15781         if current-browse = br-ingr :handle in frame D-FBR-DOC
    15782            or not available( buf_comp_fbr-line )
    15783            then
    15784         do:
    15785            find first buf_goods no-lock
    15786               where buf_goods.artic     = buf_ingr_fbr-line.artic
    15787               and buf_goods.prod-type = buf_ingr_fbr-line.prod-type
    15788               and buf_goods.prod-code = buf_ingr_fbr-line.prod-code
    15789               no-error.
    15790         end.
    15791         else
    15792         do:
    15793            find first buf_goods no-lock
    15794               where buf_goods.artic     = buf_comp_fbr-line.artic
    15795               and buf_goods.prod-type = buf_comp_fbr-line.prod-type
    15796               and buf_goods.prod-code = buf_comp_fbr-line.prod-code
    15797               no-error.
    15798         end.
    15799         if available buf_goods
    15800            then
    15801         do:
    15802            assign
    15803               p-gds-rec = recid( buf_goods )
    15804               .
    15805         end.
    15806         else
    15807         do:
    15808            assign
    15809               p-gds-rec = ?
    15810               .
    15811         end.
    15812      end.
    15813   END PROCEDURE.
    15814   PROCEDURE get-effect :
    15815      do
    15816         on error undo, return error
    15817         :
    15818         define input parameter p-recipe-code    as character    no-undo.
    15819         define input parameter p-doc-code       as character    no-undo.
    15820         define output parameter p-effect        as decimal      no-undo.
    15821         define variable v-sum-cost-rubl as decimal no-undo.
    15822         define variable v-sum-cost-base as decimal no-undo.
    15823         define variable v-sum-sale      as decimal no-undo.
    15824         define buffer buf_fbr-line for ub.fbr-line.
    15825         assign
    15826            v-sum-cost-rubl = 0
    15827            v-sum-cost-base = 0
    15828            v-sum-sale      = 0
    15829            .
    15830         for each buf_fbr-line no-lock
    15831            where buf_fbr-line.recipe-code   = p-recipe-code
    15832            and buf_fbr-line.doc-code      = p-doc-code
    15833            and buf_fbr-line.rsrv-qnty     <> ?
    15834            :
    15835            if buf_fbr-line.trn-type = 'спи':U
    15836               then
    15837            do:
    15838               assign
    15839                  v-sum-cost-rubl = v-sum-cost-rubl + buf_fbr-line.price-sum-rubl + buf_fbr-line.price-sum-vat-rubl
    15840                  v-sum-cost-base = v-sum-cost-base + buf_fbr-line.price-sum-base + buf_fbr-line.price-sum-vat-base
    15841                  .
    15842            end.
    15843            else
    15844            do:
    15845               assign
    15846                  v-sum-sale = v-sum-sale      + ( buf_fbr-line.fact-qnty * buf_fbr-line.price-sale )
    15847                  .
    15848            end.
    15849         end.
    15850         if v-base = yes
    15851            then
    15852         do:
    15853            assign
    15854               p-effect = ( v-sum-sale - v-sum-cost-base ) / v-sum-cost-base * 100.
    15855            .
    15856         end.
    15857         else
    15858         do:
    15859            assign
    15860               p-effect = ( v-sum-sale - v-sum-cost-rubl ) / v-sum-cost-rubl * 100.
    15861            .
    15862         end.
    15863      end.
    15864   END PROCEDURE.
    15865   PROCEDURE get-goods-name-proc :
    15866      define input parameter p-fbr-line-recid     as recid            no-undo.
    15867      define output parameter p-gds-name          as character        no-undo.
    15868      define buffer buf_fbr-line for ub.fbr-line.
    15869      do
    15870         for buf_fbr-line
    15871         on error undo, return error
    15872         :
    15873         find first buf_fbr-line no-lock
    15874            where recid( buf_fbr-line ) = p-fbr-line-recid
    15875            no-error.
    15876         if available buf_fbr-line
    15877            then
    15878         do:
    15879   define variable vss-include-info101 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    15880   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
    15881     (input  buf_fbr-line.artic
    15882     ,input  buf_fbr-line.prod-type
    15883     ,input  buf_fbr-line.prod-code
    15884     ,output p-gds-name
    15885     ) no-error .
    15886            if error-status :error
    15887               then
    15888            do:
    15889               assign
    15890                  p-gds-name = "":U
    15891                  .
    15892            end.
    15893         end.
    15894         else
    15895         do:
    15896            assign
    15897               p-gds-name = "":U
    15898               .
    15899         end.
    15900      end.
    15901   END PROCEDURE.
    15902   PROCEDURE get-goods-recid :
    15903      define buffer buf_goods for ub.goods.
    15904      do
    15905         for buf_goods
    15906         with frame D-FBR-DOC
    15907         on error undo, return error
    15908         :
    15909         case current-browse
    15910            :
    15911            when br-comp :handle
    15912            then
    15913               do:
    15914                  if available buf_comp_fbr-line
    15915                     then
    15916                  do:
    15917                     find first buf_goods no-lock
    15918                        where buf_goods.artic     = buf_comp_fbr-line.artic
    15919                        and buf_goods.prod-type = buf_comp_fbr-line.prod-type
    15920                        and buf_goods.prod-code = buf_comp_fbr-line.prod-code
    15921                        no-error.
    15922                     if available buf_goods
    15923                        then
    15924                     do:
    15925                        assign
    15926                           gds-rec = recid( buf_goods )
    15927                           .
    15928                     end.
    15929                  end.
    15930               end.
    15931            when br-ingr :handle
    15932            then
    15933               do:
    15934                  if available buf_ingr_fbr-line
    15935                     then
    15936                  do:
    15937                     find first buf_goods no-lock
    15938                        where buf_goods.artic     = buf_ingr_fbr-line.artic
    15939                        and buf_goods.prod-type = buf_ingr_fbr-line.prod-type
    15940                        and buf_goods.prod-code = buf_ingr_fbr-line.prod-code
    15941                        no-error.
    15942                     if available buf_goods
    15943                        then
    15944                     do:
    15945                        assign
    15946                           gds-rec = recid( buf_goods )
    15947                           .
    15948                     end.
    15949                  end.
    15950               end.
    15951         end case.
    15952      end.
    15953   END PROCEDURE.
    15954   PROCEDURE get-ingr-line-parameters :
    15955      define input parameter p-recipe-code            as character        no-undo.
    15956      define input parameter p-artic                  as character        no-undo.
    15957      define input parameter p-prod-type              as character        no-undo.
    15958      define input parameter p-prod-code              as integer          no-undo.
    15959      define output parameter p-gds-name              as character        no-undo.
    15960      define output parameter p-gds-type              as character        no-undo.
    15961      define output parameter p-recipe-type           as character        no-undo.
    15962      define output parameter p-recipe-qnty           as decimal          no-undo.
    15963      define output parameter p-recipe-brutto-qnty    as decimal          no-undo.
    15964      define output parameter p-recipe-coeff-value    as decimal          no-undo.
    15965      define output parameter p-recipe-coeff-waste    as decimal          no-undo.
    15966      define output parameter p-recipe-waste          as logical          no-undo.
    15967      define buffer buf_goods      for ub.goods.
    15968      define buffer buf_recipe     for ub.recipe.
    15969      define buffer buf_recipe-gds for ub.fbr-recipe-gds.
    15970      do
    15971         for buf_goods
    15972         , buf_recipe
    15973         , buf_recipe-gds
    15974         on error undo, return error
    15975         :
    15976         find first buf_goods no-lock
    15977            where buf_goods.artic      = p-artic
    15978            and buf_goods.prod-type  = p-prod-type
    15979            and buf_goods.prod-code  = p-prod-code
    15980            no-error.
    15981         assign
    15982            p-gds-name = ( if available buf_goods then buf_goods.gds-name else "":U )
    15983            p-gds-type = ( if available buf_goods
    15984                        then ( if buf_goods.gds-type = 'т':U then "" else 'у':U )
    15985                        else "":U
    15986                        )
    15987            .
    15988         find first buf_recipe-gds no-lock
    15989            where buf_recipe-gds.doc-code     = f-doc.doc-code
    15990            and buf_recipe-gds.recipe-code  = p-recipe-code
    15991            and buf_recipe-gds.artic        = p-artic
    15992            and buf_recipe-gds.prod-type    = p-prod-type
    15993            and buf_recipe-gds.prod-code    = p-prod-code
    15994            no-error.
    15995         if available buf_recipe-gds
    15996            then
    15997         do:
    15998            assign
    15999               p-recipe-qnty        = buf_recipe-gds.qnty
    16000               p-recipe-brutto-qnty = buf_recipe-gds.brutto-qnty
    16001               p-recipe-coeff-value = buf_recipe-gds.coeff-value
    16002               p-recipe-coeff-waste = buf_recipe-gds.coeff-waste
    16003               p-recipe-waste       = buf_recipe-gds.is-waste
    16004               .
    16005         end.
    16006         else
    16007         do:
    16008            assign
    16009               p-recipe-qnty        = ?
    16010               p-recipe-brutto-qnty = ?
    16011               p-recipe-coeff-value = ?
    16012               p-recipe-coeff-waste = ?
    16013               p-recipe-waste       = no
    16014               .
    16015         end.
    16016         find first buf_recipe no-lock
    16017            where buf_recipe.recipe-code = p-recipe-code
    16018            no-error.
    16019         if available buf_recipe
    16020            then
    16021         do:
    16022            assign
    16023               p-recipe-type = buf_recipe.recipe-type
    16024               .
    16025         end.
    16026      end.
    16027   END PROCEDURE.
    16028   PROCEDURE get-line-OK-proc :
    16029      define input parameter p-fbr-line-recid     as recid            no-undo.
    16030      define output parameter p-line-ok           as logical          no-undo.
    16031      define buffer buf_fbr-line for ub.fbr-line.
    16032      do
    16033         for buf_fbr-line
    16034         on error undo, return error
    16035         :
    16036         find first buf_fbr-line no-lock
    16037            where recid( buf_fbr-line ) = p-fbr-line-recid
    16038            no-error.
    16039         if available buf_fbr-line
    16040            then
    16041         do:
    16042            assign
    16043               p-line-ok = ( buf_fbr-line.fact-qnty = buf_fbr-line.rsrv-qnty
    16044                          or buf_fbr-line.rsrv-qnty = ? )
    16045               .
    16046         end.
    16047         else
    16048         do:
    16049            assign
    16050               p-line-ok = no
    16051               .
    16052         end.
    16053      end.
    16054   END PROCEDURE.
    16055   PROCEDURE get-netto-qnty-proc :
    16056      define input parameter p-fbr-line-recid     as recid            no-undo.
    16057      define output parameter p-netto-qnty        as decimal          no-undo.
    16058      define variable v-void-decimal as decimal   no-undo.
    16059      define variable v-void-integer as integer   no-undo.
    16060      define variable v-recipe-type  as character no-undo.
    16061      define buffer buf_fbr-line for ub.fbr-line.
    16062      do
    16063         for buf_fbr-line
    16064         on error undo, return error
    16065         :
    16066         find first buf_fbr-line no-lock
    16067            where recid( buf_fbr-line ) = p-fbr-line-recid
    16068            no-error.
    16069         if available buf_fbr-line
    16070            then
    16071         do:
    16072            run fbrlib-get-recipe-type in this-procedure (
    16073               input buf_fbr-line.doc-code
    16074               , input buf_fbr-line.recipe-code
    16075               , output v-recipe-type
    16076               ).
    16077            run fbrlib-calc-brutto in this-procedure (
    16078               input v-recipe-type
    16079               , input 0
    16080               , input buf_fbr-line.coeff-value
    16081               , input buf_fbr-line.coeff-waste
    16082               , input buf_fbr-line.fact-qnty
    16083               , input 1
    16084               , output p-netto-qnty
    16085               , output v-void-decimal
    16086               , output v-void-decimal
    16087               , output v-void-integer
    16088               ) NO-ERROR.
    16089            if error-status :error
    16090               then
    16091            do:
    16092               assign
    16093                  p-netto-qnty = 0.0
    16094                  .
    16095            end.
    16096         end.
    16097         else
    16098         do:
    16099            assign
    16100               p-netto-qnty = 0.0
    16101               .
    16102         end.
    16103      end.
    16104   END PROCEDURE.
    16105   PROCEDURE get-pay-name :
