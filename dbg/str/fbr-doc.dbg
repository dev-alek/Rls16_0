     1742   procedure fbrlib_get-default-pay-code :
     1743   define input parameter p-obj-type   as character        no-undo.
     1744   define input parameter p-obj-code   as integer          no-undo.
     1745   define output parameter p-pay-code  as integer          no-undo.
     1746   define variable v-host-code as integer no-undo .
     1747   define buffer buf_shop          for ub.shop.
     1748   define buffer buf_store         for ub.store.
     1749   define buffer buf_sysconf       for ub.sysconf.
     1750   do
     1751   for buf_shop
     1752     , buf_store
     1753     , buf_sysconf
     1754   on error undo, return error
     1755   :
     1756     case p-obj-type  :
     1757       when 'маг':U then do:
     1758           find first buf_shop no-lock
     1759                 where buf_shop.obj-code = p-obj-code
     1760           no-error.
     1761           if available buf_shop
     1762           then do:
     1763               assign
     1764                   p-pay-code = buf_shop.fbr-pay
     1765               .
     1766           end.
     1767       end.
     1768       when 'скл':U then do:
     1769           find first buf_store no-lock
     1770                 where buf_store.obj-code = p-obj-code
     1771           no-error.
     1772           if available buf_store
     1773           then do:
     1774               assign
     1775                   p-pay-code = buf_store.fbr-pay
     1776               .
     1777           end.
     1778       end.
     1779     end case.
     1780     if p-pay-code = ?
     1781     or p-pay-code = 0
     1782     then do:
     1783   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1784   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1785     (input  p-obj-type
     1786     ,input  p-obj-code
     1787     ,output v-host-code
     1788     )  .
     1789         find first buf_sysconf no-lock
     1790               where buf_sysconf.host-code = v-host-code
     1791         no-error.
     1792         if available buf_sysconf
     1793         then do:
     1794             assign
     1795                 p-pay-code = buf_sysconf.fbr-pay
     1796             .
     1797         end.
     1798     end.
     1799     if p-pay-code = ?
     1800     or p-pay-code = 0
     1801     then do:
     1802   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1803   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdnpay in g#library
     1804     (input  p-obj-type
     1805     ,input  p-obj-code
     1806     ,output p-pay-code
     1807     )  .
     1808     end.
     1809   end.
     1810   end procedure.
     1811   procedure fbrlib-fill-and-check-temp_fbrlib_recipe :
     1812   do
     1813   on error undo, return error
     1814   :
     1815   define input parameter p-fbr-doc-code as character    no-undo.
     1816       define variable vss-description as character    no-undo init "fbrlib-fill-and-check-temp_fbrlib_recipe: ".
     1817       define variable v-gds-name      as character    no-undo.
     1818       define buffer buf_fbr-doc               for ub.fbr-doc.
     1819       define buffer buf_fbr-line              for ub.fbr-line.
     1820       define buffer buf_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1821       define buffer buf_out_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1822       find first buf_fbr-doc no-lock
     1823            where buf_fbr-doc.doc-code = p-fbr-doc-code
     1824       .
     1825       for each buf_temp_fbrlib_recipe
     1826       :
     1827           delete buf_temp_fbrlib_recipe.
     1828       end.
     1829       for each buf_fbr-line no-lock
     1830          where buf_fbr-line.doc-code = p-fbr-doc-code
     1831       :
     1832           find first buf_temp_fbrlib_recipe
     1833                where buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1834           no-error.
     1835           if not available buf_temp_fbrlib_recipe
     1836           then do:
     1837               create buf_temp_fbrlib_recipe.
     1838               assign
     1839                   buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1840                   buf_temp_fbrlib_recipe.fbr-doc-code = buf_fbr-line.doc-code
     1841               .
     1842           end.
     1843       end.
     1844       for each buf_temp_fbrlib_recipe
     1845       :
     1846           assign
     1847               buf_temp_fbrlib_recipe.count-income                = 0
     1848               buf_temp_fbrlib_recipe.qnty-income                 = 0
     1849               buf_temp_fbrlib_recipe.sum-income-sale             = 0
     1850               buf_temp_fbrlib_recipe.sum-income-cost-base        = 0
     1851               buf_temp_fbrlib_recipe.sum-income-cost-rubl        = 0
     1852               buf_temp_fbrlib_recipe.sum-income-vat-cost-base    = 0
     1853               buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl    = 0
     1854               buf_temp_fbrlib_recipe.count-write-off             = 0
     1855               buf_temp_fbrlib_recipe.qnty-write-off              = 0
     1856               buf_temp_fbrlib_recipe.sum-write-off-sale          = 0
     1857               buf_temp_fbrlib_recipe.sum-write-off-cost-base     = 0
     1858               buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = 0
     1859               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = 0
     1860               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = 0
     1861           .
     1862           for each buf_fbr-line no-lock
     1863              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1864                and buf_fbr-line.trn-type     = 'при':U
     1865                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1866           :
     1867               if ( buf_fbr-line.price-base   = ?
     1868                   or buf_fbr-line.price-rubl = ?
     1869                   or buf_fbr-line.price-base <= 0
     1870                   or buf_fbr-line.price-rubl <= 0 )
     1871               and buf_fbr-line.fact-qnty <> 0
     1872               and buf_fbr-line.rsrv-qnty <> ?
     1873               and buf_fbr-doc.is-free    = no
     1874               then do:
     1875   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1876   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1877     (input  buf_fbr-line.artic
     1878     ,input  buf_fbr-line.prod-type
     1879     ,input  buf_fbr-line.prod-code
     1880     ,output v-gds-name
     1881     ) no-error .
     1882                   if error-status :error
     1883                   then do:
     1884                       assign
     1885                           v-gds-name = ""
     1886                       .
     1887                   end.
     1888                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1889                                                 ,vss-description
     1890                                                 ,buf_fbr-doc.doc-code
     1891                                                 ,chr(10)
     1892                                                 ,buf_fbr-line.recipe-code
     1893                                                 ,buf_fbr-line.artic
     1894                                                 ,v-gds-name).
     1895               end.
     1896               assign
     1897                   buf_temp_fbrlib_recipe.count-income             = buf_temp_fbrlib_recipe.count-income + 1
     1898                   buf_temp_fbrlib_recipe.qnty-income              = buf_temp_fbrlib_recipe.qnty-income
     1899                                                                   + buf_fbr-line.fact-qnty
     1900                   buf_temp_fbrlib_recipe.sum-income-sale          = buf_temp_fbrlib_recipe.sum-income-sale
     1901                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1902               .
     1903               if buf_fbr-line.is-waste = no
     1904               then do:
     1905                   assign
     1906                       buf_temp_fbrlib_recipe.sum-income-cost-base     = buf_temp_fbrlib_recipe.sum-income-cost-base
     1907                                                                       + buf_fbr-line.price-sum-base
     1908                       buf_temp_fbrlib_recipe.sum-income-cost-rubl     = buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1909                                                                       + buf_fbr-line.price-sum-rubl
     1910                       buf_temp_fbrlib_recipe.sum-income-vat-cost-base = buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1911                                                                       + buf_fbr-line.price-sum-vat-base
     1912                       buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1913                                                                       + buf_fbr-line.price-sum-vat-rubl
     1914                   .
     1915               end.
     1916           end.
     1917           for each buf_fbr-line no-lock
     1918              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1919                and buf_fbr-line.trn-type     = 'спи':U
     1920                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1921           :
     1922               if ( buf_fbr-line.price-base   = ?
     1923                   or buf_fbr-line.price-rubl = ?
     1924                   or buf_fbr-line.price-base <= 0
     1925                   or buf_fbr-line.price-rubl <= 0 )
     1926               and buf_fbr-line.fact-qnty <> 0
     1927               and buf_fbr-line.rsrv-qnty <> ?
     1928               and buf_fbr-doc.is-free    = no
     1929               and buf_fbr-doc.status_    = 'разрешен':U
     1930               then do:
     1931   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1932   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1933     (input  buf_fbr-line.artic
     1934     ,input  buf_fbr-line.prod-type
     1935     ,input  buf_fbr-line.prod-code
     1936     ,output v-gds-name
     1937     ) no-error .
     1938                   if error-status :error
     1939                   then do:
     1940                       assign
     1941                           v-gds-name = ""
     1942                       .
     1943                   end.
     1944                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1945                                                 ,vss-description
     1946                                                 ,buf_fbr-doc.doc-code
     1947                                                 ,chr(10)
     1948                                                 ,buf_fbr-line.recipe-code
     1949                                                 ,buf_fbr-line.artic
     1950                                                 ,v-gds-name).
     1951               end.
     1952               assign
     1953                   buf_temp_fbrlib_recipe.count-write-off             = buf_temp_fbrlib_recipe.count-write-off + 1
     1954                   buf_temp_fbrlib_recipe.qnty-write-off              = buf_temp_fbrlib_recipe.qnty-write-off
     1955                                                                   + buf_fbr-line.fact-qnty
     1956                   buf_temp_fbrlib_recipe.sum-write-off-sale          = buf_temp_fbrlib_recipe.sum-write-off-sale
     1957                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1958               .
     1959               if buf_fbr-line.is-waste = no
     1960               then do:
     1961                   assign
     1962                       buf_temp_fbrlib_recipe.sum-write-off-cost-base     = buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1963                                                                       + buf_fbr-line.price-sum-base
     1964                       buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1965                                                                       + buf_fbr-line.price-sum-rubl
     1966                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1967                                                                       + buf_fbr-line.price-sum-vat-base
     1968                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1969                                                                       + buf_fbr-line.price-sum-vat-rubl
     1970                   .
     1971               end.
     1972           end.
     1973           if buf_fbr-doc.status_    = 'разрешен':U
     1974           and ( abs( buf_temp_fbrlib_recipe.sum-write-off-cost-base     - buf_temp_fbrlib_recipe.sum-income-cost-base     ) > 0.01
     1975           or abs( buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     - buf_temp_fbrlib_recipe.sum-income-cost-rubl     ) > 0.01
     1976           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base - buf_temp_fbrlib_recipe.sum-income-vat-cost-base ) > 0.01
     1977           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl - buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl ) > 0.01
     1978               )
     1979           then do:
     1980            undo, return error
     1981               substitute("В документе пр-ва &1 Не совпадают суммы учетных цен для списанного и оприходованного по рецепту товара.&2" +
     1982                           "Рецепт: &3&2&4&4по списанному товару&4по оприходованному товару&2"  +
     1983                           "Сумма в баз.вал.&4&5&4&4&6&2" +
     1984                           "Сумма в &9.&4&7&4&4&8&2"
     1985                          , buf_fbr-doc.doc-code
     1986                          , chr(10)
     1987                          , buf_temp_fbrlib_recipe.recipe-code
     1988                          , chr(9)
     1989                          , buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1990                          , buf_temp_fbrlib_recipe.sum-income-cost-base
     1991                          , buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1992                          , buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1993                          , "руб"
     1994                          )
     1995              +
     1996              substitute("НДС в баз.вал.&1&2&1&1&3&4" +
     1997                         "НДС в &7.&1&5&1&1&6&4"
     1998                        ,  chr(9)
     1999                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     2000                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     2001                        ,chr(10)
     2002                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     2003                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     2004                        ,"руб"
     2005                        )       .
     2006           end.
     2007       end.
     2008   end.
     2009   end procedure.
     2010   procedure fbrlib-fill-sum-fbr-doc :
     2011   do
     2012   on error undo, return error
     2013   :
     2014   define input parameter p-fbr-doc-recid  as recid        no-undo.
     2015   define input parameter p-mode           as character    no-undo.
     2016       define variable vss-description as character init "fbrlib-fill-sum-fbr-doc: "  no-undo.
     2017       define buffer buf_fbr-doc           for ub.fbr-doc.
     2018       define buffer buf_fbr-line          for ub.fbr-line.
     2019       define buffer buf_temp_fbrlib_recipe   for temp_fbrlib_recipe.
     2020       define variable v-in-count          as integer       no-undo.
     2021       define variable v-out-count         as integer       no-undo.
     2022       find first buf_fbr-doc exclusive-lock
     2023            where recid ( buf_fbr-doc ) = p-fbr-doc-recid
     2024       .
     2025       find first buf_temp_fbrlib_recipe no-error.
     2026       if not available buf_temp_fbrlib_recipe
     2027       then do:
     2028           run fbrlib-fill-and-check-temp_fbrlib_recipe in this-procedure (
     2029               input buf_fbr-doc.doc-code
     2030           ) no-error.
     2031           if error-status :error
     2032           then do:
     2033               undo, return error substitute("&1 Ошибка расчета сумм при заполнении шапки документа производства.&2&3&2&4"
     2034                                              , vss-description
     2035                                              , chr(10)
     2036                                              , error-status:get-message(1)
     2037                                              , return-value ).
     2038           end.
     2039       end.
     2040       assign
     2041           v-in-count                  = 0
     2042           buf_fbr-doc.in-qnty         = 0
     2043           buf_fbr-doc.in-sale         = 0
     2044           buf_fbr-doc.in-base         = 0
     2045           buf_fbr-doc.in-rubl         = 0
     2046           buf_fbr-doc.in-vat-base     = 0
     2047           buf_fbr-doc.in-vat-rubl     = 0
     2048           v-out-count                 = 0
     2049           buf_fbr-doc.out-qnty        = 0
     2050           buf_fbr-doc.out-sale        = 0
     2051           buf_fbr-doc.out-base        = 0
     2052           buf_fbr-doc.out-rubl        = 0
     2053           buf_fbr-doc.out-vat-base    = 0
     2054           buf_fbr-doc.out-vat-rubl    = 0
     2055       .
     2056       for each buf_temp_fbrlib_recipe
     2057       :
     2058           assign
     2059               v-in-count                  = v-in-count                + buf_temp_fbrlib_recipe.count-income
     2060               buf_fbr-doc.in-qnty         = buf_fbr-doc.in-qnty       + buf_temp_fbrlib_recipe.qnty-income
     2061               buf_fbr-doc.in-sale         = buf_fbr-doc.in-sale       + buf_temp_fbrlib_recipe.sum-income-sale
     2062               buf_fbr-doc.in-base         = buf_fbr-doc.in-base       + buf_temp_fbrlib_recipe.sum-income-cost-base
     2063               buf_fbr-doc.in-rubl         = buf_fbr-doc.in-rubl       + buf_temp_fbrlib_recipe.sum-income-cost-rubl
     2064               buf_fbr-doc.in-vat-base     = buf_fbr-doc.in-vat-base   + buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     2065               buf_fbr-doc.in-vat-rubl     = buf_fbr-doc.in-vat-rubl   + buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     2066               v-out-count                 = v-out-count               + buf_temp_fbrlib_recipe.count-write-off
     2067               buf_fbr-doc.out-qnty        = buf_fbr-doc.out-qnty      + buf_temp_fbrlib_recipe.qnty-write-off
     2068               buf_fbr-doc.out-sale        = buf_fbr-doc.out-sale      + buf_temp_fbrlib_recipe.sum-write-off-sale
     2069               buf_fbr-doc.out-base        = buf_fbr-doc.out-base      + buf_temp_fbrlib_recipe.sum-write-off-cost-base
     2070               buf_fbr-doc.out-rubl        = buf_fbr-doc.out-rubl      + buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     2071               buf_fbr-doc.out-vat-base    = buf_fbr-doc.out-vat-base  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     2072               buf_fbr-doc.out-vat-rubl    = buf_fbr-doc.out-vat-rubl  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     2073           .
     2074       end.
     2075       if ( abs (buf_fbr-doc.in-rubl - buf_fbr-doc.out-rubl) <= 0.01
     2076       and   abs (buf_fbr-doc.in-base - buf_fbr-doc.out-base) <= 0.01 )
     2077       or p-mode <> 'факт':U
     2078       then do:
     2079           if substring( buf_fbr-doc.PS, 1, 1 ) = "@"
     2080           then do:
     2081               assign
     2082                   buf_fbr-doc.PS = "@ Строк полученных товаров : "
     2083                                   + string( v-out-count, ">>>,>>9" )
     2084                                   + chr(10) + "Строк исходных товаров : "
     2085                                   + string( v-in-count, ">>>,>>9" )
     2086               .
     2087           end.
     2088       end.
     2089       else do:
     2090         undo, return error substitute("В док-те пр-ва &1 не совпадают суммы списанных и оприходованных товаров.&2" +
     2091                                       "Сумма списанных товаров в &3 - &4&2" +
     2092                                       "Сумма оприходованных товаров в &3 - &5&2" +
     2093                                       "Сумма оприходованных товаров в &3 - &6&2" +
     2094                                       "Сумма списанных товаров в баз.вал. - &7&2" +
     2095                                       "Сумма оприходованных товаров в баз.вал. - &8&2"
     2096                                       , buf_fbr-doc.doc-code
     2097                                       , chr(10)
     2098                                       , "рублях"
     2099                                       , round( buf_fbr-doc.out-rubl, 2 )
     2100                                       , round( buf_fbr-doc.in-rubl,  2 )
     2101                                       , round( buf_fbr-doc.in-rubl,  2 )
     2102                                       , round( buf_fbr-doc.out-base, 2 )
     2103                                       , round( buf_fbr-doc.in-base,  2 )).
     2104       end.
     2105   end.
     2106   end procedure.
     2107   procedure fbrlib-calc-prices :
     2108   do
     2109   on error undo, return error
     2110   :
     2111   define input parameter p-fbr-line-recid as recid        no-undo.
     2112   define input parameter p-price-obj-type as character    no-undo.
     2113   define input parameter p-price-obj-code as integer      no-undo.
     2114   define output parameter p-current-price as decimal      no-undo.
     2115       define variable v-void          as decimal       no-undo.
     2116       define variable v-void-char     as character     no-undo.
     2117       define variable v-gds-code      as integer       no-undo.
     2118       define variable v-b-code        as integer       no-undo.
     2119       define buffer buf_fbr-doc   for ub.fbr-doc.
     2120       define buffer buf_fbr-line  for ub.fbr-line.
     2121       define buffer buf_gds-prt   for ub.gds-prt.
     2122       define buffer buf_bar-code  for ub.bar-code.
     2123       find first buf_fbr-line no-lock
     2124           where recid( buf_fbr-line ) = p-fbr-line-recid
     2125       .
     2126   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2127   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     2128     (input  buf_fbr-line.artic
     2129     ,input  buf_fbr-line.prod-type
     2130     ,input  buf_fbr-line.prod-code
     2131     ,output v-gds-code
     2132     ) no-error .
     2133       if error-status :error
     2134       then do:
     2135         undo, return error substitute("&1 &2 &3&4Ошибка определения кода товара (артикул &7).&4&5&4&6"
     2136                                         ,vss-workfile
     2137                                         ,vss-revision
     2138                                         ,vss-description
     2139                                         ,chr(10)
     2140                                         , error-status:get-message(1)
     2141                                         , return-value
     2142                                         , buf_fbr-line.artic
     2143                                         ).
     2144       end.
     2145   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2146     (input  v-gds-code
     2147     ,input  ?
     2148     ,output v-b-code
     2149     ) no-error .
     2150       if error-status :error
     2151       then do:
     2152         undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара (код товара) &7.&4&5&4&6"
     2153                                         ,vss-workfile
     2154                                         ,vss-revision
     2155                                         ,vss-description
     2156                                         ,chr(10)
     2157                                         , error-status:get-message(1)
     2158                                         , return-value
     2159                                         , v-gds-code
     2160                                         ).
     2161       end.
     2162       if buf_fbr-line.is-calc = no
     2163       then do:
     2164   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2165   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2166     (input  p-price-obj-type
     2167     ,input  p-price-obj-code
     2168     ,input  v-b-code
     2169     ,input  0
     2170     ,input  0
     2171     ,output v-void-char
     2172     ,output p-current-price
     2173     ,output v-void
     2174     ,output v-void
     2175     ) no-error .
     2176           if error-status :error
     2177           then do:
     2178             undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара (код товара) &7.&4&5&4&6"
     2179                                             ,vss-workfile
     2180                                             ,vss-revision
     2181                                             ,vss-description
     2182                                             ,chr(10)
     2183                                             , error-status:get-message(1)
     2184                                             , return-value
     2185                                             , v-gds-code
     2186                                             ).
     2187           end.
     2188       end.
     2189       else do:
     2190           assign
     2191               p-current-price = buf_fbr-line.price-sale
     2192           .
     2193       end.
     2194   end.
     2195   end procedure.
     2196   procedure fbrlib-put-in-order-recipe :
     2197   do
     2198   on error undo, return error
     2199   :
     2200   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     2201       define variable v-recipe-counter    as integer          no-undo.
     2202       define variable v-recipe-amount     as integer init 0   no-undo.
     2203       define variable v-child-counter     as integer          no-undo.
     2204       define variable v-is-call-cycle     as logical          no-undo.
     2205       define variable v-str as character     no-undo.
     2206       define buffer buf_in_fbr-line       for ub.fbr-line.
     2207       define buffer buf_dress_fbr-line    for ub.fbr-line.
     2208       define buffer buf_fbr-line          for ub.fbr-line.
     2209       define buffer buf_recipe-gds        for ub.recipe-gds.
     2210       define buffer buf_recipe            for ub.recipe.
     2211       for each temp_recipe-childs-qnty
     2212       :
     2213           delete temp_recipe-childs-qnty.
     2214       end.
     2215       for each temp_recipe-childs
     2216       :
     2217           delete temp_recipe-childs.
     2218       end.
     2219       for each temp_recipe-order
     2220       :
     2221           delete temp_recipe-order.
     2222       end.
     2223       for each buf_fbr-line no-lock
     2224          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     2225       on error undo, return error
     2226       :
     2227           find first temp_recipe-childs-qnty
     2228                where temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     2229           no-error.
     2230           if not available temp_recipe-childs-qnty
     2231           then do:
     2232               create temp_recipe-childs-qnty.
     2233               assign
     2234                   v-recipe-amount                     = v-recipe-amount + 1
     2235                   temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     2236                   temp_recipe-childs-qnty.order       = v-recipe-amount
     2237                   temp_recipe-childs-qnty.childs-qnty = 0
     2238                   v-child-counter                     = 0
     2239               .
     2240           end.
     2241       end.
     2242       for each buf_in_fbr-line no-lock
     2243          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     2244            and buf_in_fbr-line.trn-type = 'спи':U
     2245       on error undo, return error
     2246       :
     2247           for each buf_dress_fbr-line no-lock
     2248              where buf_dress_fbr-line.doc-code    = p-fbr-doc-doc-code
     2249                and buf_dress_fbr-line.trn-type    = 'при':U
     2250                and buf_dress_fbr-line.artic       = buf_in_fbr-line.artic
     2251                and buf_dress_fbr-line.prod-type   = buf_in_fbr-line.prod-type
     2252                and buf_dress_fbr-line.prod-code   = buf_in_fbr-line.prod-code
     2253           on error undo, return error
     2254           :
     2255               find first buf_recipe no-lock
     2256                    where buf_recipe.recipe-code = buf_dress_fbr-line.recipe-code
     2257               .
     2258               if buf_in_fbr-line.is-comp = yes
     2259               then do:
     2260                   find last temp_recipe-childs-qnty
     2261                       where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2262                   .
     2263                   assign
     2264                       temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2265                   .
     2266                   create temp_recipe-childs.
     2267                   assign
     2268                       temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2269                       temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2270                       temp_recipe-childs.child-recipe-code    = buf_dress_fbr-line.recipe-code
     2271                   .
     2272               end.
     2273               else do:
     2274               end.
     2275           end.
     2276       end.
     2277       for each buf_in_fbr-line no-lock
     2278          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     2279            and buf_in_fbr-line.trn-type = 'при':U
     2280       on error undo, return error
     2281       :
     2282           find first buf_recipe no-lock
     2283                where buf_recipe.recipe-code = buf_in_fbr-line.recipe-code
     2284           no-error.
     2285           if buf_in_fbr-line.is-comp = no
     2286           then do:
     2287           end.
     2288           else do:
     2289               for each buf_recipe-gds no-lock
     2290               where buf_recipe-gds.recipe-code = buf_in_fbr-line.recipe-code
     2291               :
     2292                   for each buf_fbr-line no-lock
     2293                   where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     2294                       and buf_fbr-line.trn-type    = 'при':U
     2295                       and buf_fbr-line.artic       = buf_recipe-gds.artic
     2296                       and buf_fbr-line.prod-type   = buf_recipe-gds.prod-type
     2297                       and buf_fbr-line.prod-code   = buf_recipe-gds.prod-code
     2298                   on error undo, return error
     2299                   :
     2300                       find first buf_recipe no-lock
     2301                            where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     2302                       .
     2303                       if buf_recipe.recipe-type = 'разделка':U
     2304                       then do:
     2305                       end.
     2306                       else do:
     2307                           find last temp_recipe-childs-qnty
     2308                               where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2309                           .
     2310                           assign
     2311                               temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2312                           .
     2313                           create temp_recipe-childs.
     2314                           assign
     2315                               temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2316                               temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2317                               temp_recipe-childs.child-recipe-code    = buf_fbr-line.recipe-code
     2318                           .
     2319                       end.
     2320                   end.
     2321               end.
     2322           end.
     2323       end.
     2324       for each temp_recipe-order
     2325       on error undo, return error
     2326       :
     2327           delete temp_recipe-order.
     2328       end.
     2329       assign
     2330           v-fbrlib-recipe-order = 0
     2331       .
     2332       do v-recipe-counter = 1 to v-recipe-amount
     2333       on error undo, return error
     2334       :
     2335           run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2336                 input v-recipe-counter
     2337               , input 0
     2338               , output v-is-call-cycle
     2339           ).
     2340           if v-is-call-cycle = yes
     2341           then do:
     2342               message
     2343                       "Достигнут максимальный уровень вложенности рецептов."
     2344                   skip(1)
     2345                   skip "Невозможно упорядочить рецепты."
     2346                   skip(1)
     2347                   skip "Необходимо изменить структуру рецептов,"
     2348                   skip "используемых при формировании"
     2349                   skip "данного документа производства."
     2350               view-as alert-box error
     2351               title "Невозможно рассчитать документ производства".
     2352               for each temp_recipe-childs-qnty
     2353               :
     2354                   delete temp_recipe-childs-qnty.
     2355               end.
     2356               for each temp_recipe-childs
     2357               :
     2358                   delete temp_recipe-childs.
     2359               end.
     2360               for each temp_recipe-order
     2361               :
     2362                   delete temp_recipe-order.
     2363               end.
     2364               for each temp_recipe-order
     2365               on error undo, return error
     2366               :
     2367                   delete temp_recipe-order.
     2368               end.
     2369               for each temp_fbrlib_recipe
     2370               on error undo, return error
     2371               :
     2372                   delete temp_recipe-order.
     2373               end.
     2374               undo, return error.
     2375           end.
     2376       end.
     2377   end.
     2378   end procedure.
     2379   procedure fbrlib-add-recipe-in-tmp-order :
     2380   do
     2381   on error undo, return error
     2382   :
     2383   define input parameter p-order              as integer      no-undo.
     2384   define input parameter p-call-counter       as integer      no-undo.
     2385   define output parameter p-is-call-cycle     as logical      no-undo.
     2386       define variable v-nodes-counter     as integer       no-undo.
     2387       define buffer buf_c_temp_recipe-childs-qnty for temp_recipe-childs-qnty.
     2388       define buffer buf_temp_recipe-childs-qnty   for temp_recipe-childs-qnty.
     2389       define buffer buf_temp_recipe-childs        for temp_recipe-childs     .
     2390       define buffer buf_temp_recipe-order         for temp_recipe-order.
     2391       assign
     2392           p-call-counter = p-call-counter + 1
     2393       .
     2394       if p-call-counter > 50
     2395       then do:
     2396           assign
     2397               p-is-call-cycle = yes
     2398           .
     2399       end.
     2400       else do:
     2401           find first buf_temp_recipe-childs-qnty
     2402                where buf_temp_recipe-childs-qnty.order = p-order
     2403           .
     2404           find first buf_temp_recipe-order
     2405                where buf_temp_recipe-order.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2406           no-error.
     2407           if not available buf_temp_recipe-order
     2408           then do:
     2409               do v-nodes-counter = 1 to buf_temp_recipe-childs-qnty.childs-qnty
     2410               :
     2411                   find first buf_temp_recipe-childs
     2412                        where buf_temp_recipe-childs.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2413                          and buf_temp_recipe-childs.child-code  = v-nodes-counter
     2414                   .
     2415                   find first buf_c_temp_recipe-childs-qnty
     2416                        where buf_c_temp_recipe-childs-qnty.recipe-code = buf_temp_recipe-childs.child-recipe-code
     2417                   .
     2418                   run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2419                         input buf_c_temp_recipe-childs-qnty.order
     2420                       , input p-call-counter
     2421                       , output p-is-call-cycle
     2422                   ).
     2423                   if p-is-call-cycle = yes
     2424                   then do:
     2425                       return.
     2426                   end.
     2427               end.
     2428               assign
     2429                   v-fbrlib-recipe-order = v-fbrlib-recipe-order + 1
     2430               .
     2431               create buf_temp_recipe-order.
     2432               assign
     2433                   buf_temp_recipe-order.recipe-code   = buf_temp_recipe-childs-qnty.recipe-code
     2434                   buf_temp_recipe-order.order         = v-fbrlib-recipe-order
     2435               .
     2436           end.
     2437       end.
     2438   end.
     2439   end procedure.
     2440   procedure fbrlib-get-trn-type :
     2441   define input parameter p-recipe-code    as character    no-undo.
     2442   define input parameter p-goods-recid    as recid        no-undo.
     2443   define input parameter p-is-integration as logical      no-undo.
     2444   define output parameter p-is-comp       as logical      no-undo.
     2445   define output parameter p-trn-type      as character    no-undo.
     2446   define buffer buf_recipe    for ub.recipe.
     2447   define buffer buf_goods     for ub.goods.
     2448   do
     2449   for buf_recipe
     2450     , buf_goods
     2451   on error undo, return error
     2452   :
     2453       find first buf_goods no-lock
     2454            where recid( buf_goods ) = p-goods-recid
     2455       .
     2456       find first buf_recipe no-lock
     2457            where buf_recipe.recipe-code = p-recipe-code
     2458       no-error.
     2459       if not available buf_recipe
     2460       then do:
     2461           assign
     2462               p-is-comp = no
     2463               p-trn-type = "":U
     2464           .
     2465           undo, return.
     2466       end.
     2467       if  buf_recipe.artic        = buf_goods.artic
     2468       and buf_recipe.prod-type    = buf_goods.prod-type
     2469       and buf_recipe.prod-code    = buf_goods.prod-code
     2470       then do:
     2471           assign
     2472               p-is-comp = yes
     2473           .
     2474       end.
     2475       else do:
     2476           assign
     2477               p-is-comp = no
     2478           .
     2479       end.
     2480       case buf_recipe.recipe-type
     2481       :
     2482           when 'производство':U
     2483           then do:
     2484               if p-is-comp = yes
     2485               then do:
     2486                   assign
     2487                       p-trn-type = 'при':U
     2488                   .
     2489               end.
     2490               else do:
     2491                   assign
     2492                       p-trn-type = 'спи':U
     2493                   .
     2494               end.
     2495           end.
     2496           when 'альтернатива':U
     2497           then do:
     2498               if p-is-comp = yes
     2499               then do:
     2500                   assign
     2501                       p-trn-type = 'при':U
     2502                   .
     2503               end.
     2504               else do:
     2505                   assign
     2506                       p-trn-type = 'спи':U
     2507                   .
     2508               end.
     2509           end.
     2510           when 'разделка':U
     2511           then do:
     2512               if p-is-comp = no
     2513               then do:
     2514                   assign
     2515                       p-trn-type = 'при':U
     2516                   .
     2517               end.
     2518               else do:
     2519                   assign
     2520                       p-trn-type = 'спи':U
     2521                   .
     2522               end.
     2523           end.
     2524           when 'комплектация':U
     2525           then do:
     2526               if p-is-integration = ?
     2527               then do:
     2528                   message
     2529                       "Выберите тип операции по рецепту комплектации:"
     2530                       skip (2) "YES - комплектация"
     2531                       skip     "NO - разукомплектация"
     2532                   view-as alert-box question
     2533                   buttons YES-NO
     2534                   update p-is-integration.
     2535               end.
     2536               if p-is-integration = yes
     2537               then do:
     2538                   if p-is-comp = yes
     2539                   then do:
     2540                       assign
     2541                           p-trn-type = 'при':U
     2542                       .
     2543                   end.
     2544                   else do:
     2545                       assign
     2546                           p-trn-type = 'спи':U
     2547                       .
     2548                   end.
     2549               end.
     2550               else do:
     2551                   if p-is-comp = yes
     2552                   then do:
     2553                       assign
     2554                           p-trn-type = 'спи':U
     2555                       .
     2556                   end.
     2557                   else do:
     2558                       assign
     2559                           p-trn-type = 'при':U
     2560                       .
     2561                   end.
     2562               end.
     2563           end.
     2564       end case.
     2565   end.
     2566   end procedure.
     2567   procedure fbrlib-get-mark :
     2568   define input parameter p-recipe-code    as character    no-undo.
     2569   define output parameter p-mark          as logical    no-undo.
     2570   define buffer buf_goods-attr     for ub.goods-attr.
     2571   define buffer buf_recipe-gds for ub.recipe-gds .
     2572       for each buf_recipe-gds no-lock where buf_recipe-gds.recipe-code = p-recipe-code,
     2573            first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_recipe-gds.gds-code and
     2574                                               buf_goods-attr.attr-code = 'mark-type':U:
     2575            if buf_goods-attr.attr-value <> "" and buf_goods-attr.attr-value <> "not-type" then do:
     2576               p-mark = true .
     2577               return .
     2578            end.
     2579       end.
     2580   end procedure.
     2581   procedure fbrlib-check-temp-tables :
     2582   do
     2583   on error undo, return error
     2584   :
     2585   define input parameter p-title  as character    no-undo.
     2586       define variable v-str               as character        no-undo.
     2587       assign
     2588           v-str = v-str + chr(10) + "temp_recipe-childs-qnty:" + chr(10)
     2589       .
     2590       for each temp_recipe-childs-qnty
     2591       on error undo, return error
     2592       :
     2593           assign
     2594               v-str   = v-str + string( temp_recipe-childs-qnty.recipe-code )
     2595                       + "   " + string( temp_recipe-childs-qnty.childs-qnty )
     2596                       + "   " + string( temp_recipe-childs-qnty.order )
     2597                       + chr(10)
     2598           .
     2599       end.
     2600       assign
     2601           v-str = v-str + "temp_recipe-childs:" + chr(10)
     2602       .
     2603       for each temp_recipe-childs
     2604       on error undo, return error
     2605       :
     2606           assign
     2607               v-str   = v-str + string( temp_recipe-childs.recipe-code )
     2608                       + "   " + string( temp_recipe-childs.child-code )
     2609                       + "   " + string( temp_recipe-childs.child-recipe-code )
     2610                       + chr(10)
     2611           .
     2612       end.
     2613       assign
     2614           v-str = v-str + chr(10) + "temp_recipe-order:" + chr(10)
     2615       .
     2616       for each temp_recipe-order
     2617       on error undo, return error
     2618       :
     2619           assign
     2620               v-str   = v-str + string( temp_recipe-order.recipe-code )
     2621                       + "   " + string( temp_recipe-order.order )
     2622                       + chr(10)
     2623           .
     2624       end.
     2625       assign
     2626           v-str = v-str + chr(10) + "temp_fbrlib_recipe:" + chr(10)
     2627       .
     2628       run writelog in this-procedure ( input "fbr.log", input 0, input p-title ).
     2629       run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2630       for each temp_fbrlib_recipe
     2631       on error undo, return error
     2632       :
     2633           assign
     2634               v-str   = "recipe-code: "                   + string( temp_fbrlib_recipe.recipe-code                 )
     2635                       + "   " + "count-income: "                  + string( temp_fbrlib_recipe.count-income                )
     2636                       + "   " + "qnty-income: "                   + string( temp_fbrlib_recipe.qnty-income                 )
     2637                       + "   " + "sum-income-sale: "               + string( temp_fbrlib_recipe.sum-income-sale             )
     2638                       + "   " + "sum-income-cost-base: "          + string( temp_fbrlib_recipe.sum-income-cost-base        )
     2639                       + "   " + "sum-income-cost-rubl: "          + string( temp_fbrlib_recipe.sum-income-cost-rubl        )
     2640                       + "   " + "sum-income-vat-cost-base: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-base    )
     2641                       + "   " + "sum-income-vat-cost-rubl: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-rubl    )
     2642                       + "   " + "count-write-off: "               + string( temp_fbrlib_recipe.count-write-off             )
     2643                       + "   " + "qnty-write-off: "                + string( temp_fbrlib_recipe.qnty-write-off              )
     2644                       + "   " + "sum-write-off-sale: "            + string( temp_fbrlib_recipe.sum-write-off-sale          )
     2645                       + "   " + "sum-write-off-cost-base: "       + string( temp_fbrlib_recipe.sum-write-off-cost-base     )
     2646                       + "   " + "sum-write-off-cost-rubl: "       + string( temp_fbrlib_recipe.sum-write-off-cost-rubl     )
     2647                       + "   " + "sum-write-off-vat-cost-base: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-base )
     2648                       + "   " + "sum-write-off-vat-cost-rubl: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-rubl )
     2649                       + chr(10)
     2650           .
     2651           run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2652       end.
     2653   end.
     2654   end procedure.
     2655   procedure fbrlib-s-coeff-value :
     2656   define input  parameter p-gds-code    as integer        no-undo.
     2657   define input  parameter p-date        as date           no-undo.
     2658   define input  parameter p-obj-type    as character      no-undo.
     2659   define input  parameter p-obj-code    as integer        no-undo.
     2660   define output parameter p-coeff-value as decimal        no-undo.
     2661   define variable vss-description as character init "fbrlib-s-coeff-value-01: определяет значение сезонного коэффициента" no-undo.
     2662       define variable v-date          as date         no-undo.
     2663       define variable v-host-code     as integer      no-undo.
     2664       define buffer buf_goods       for ub.goods.
     2665       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     2666       define buffer buf_clients     for ub.clients.
     2667       define buffer buf_s-coeff     for ub.s-coeff.
     2668   do
     2669   for buf_goods
     2670     , buf_fbr-gds-obj
     2671     , buf_clients
     2672     , buf_s-coeff
     2673   on error undo, return error return-value
     2674   :
     2675       find first buf_goods no-lock
     2676            where buf_goods.gds-code = p-gds-code
     2677       no-error .
     2678       if not available buf_goods
     2679       then do:
     2680          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден товар с кодом &1", p-gds-code).
     2681       end.
     2682       find first buf_clients no-lock
     2683            where buf_clients.obj-type = p-obj-type
     2684              and buf_clients.obj-code = p-obj-code
     2685       no-error.
     2686       if not available buf_clients
     2687       then do:
     2688          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден объект &1&2", p-obj-type, p-obj-code).
     2689       end.
     2690       assign
     2691           v-date = date(month(p-date), day(p-date), Year(01/01/1996))
     2692       .
     2693       find first buf_fbr-gds-obj no-lock
     2694            where buf_fbr-gds-obj.gds-code = p-gds-code
     2695              and buf_fbr-gds-obj.obj-type = p-obj-type
     2696              and buf_fbr-gds-obj.obj-code = p-obj-code
     2697       no-error.
     2698       if not available buf_fbr-gds-obj
     2699       or buf_fbr-gds-obj.is-season = no
     2700       then do:
     2701           assign
     2702               p-coeff-value = 0
     2703           .
     2704           return.
     2705       end.
     2706   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2707   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2708     (input  p-obj-type
     2709     ,input  p-obj-code
     2710     ,output v-host-code
     2711     )  .
     2712       find last buf_s-coeff no-lock
     2713           where buf_s-coeff.gds-code = p-gds-code
     2714             and buf_s-coeff.host-code = v-host-code
     2715             and buf_s-coeff.obj-type = p-obj-type
     2716             and buf_s-coeff.obj-code = p-obj-code
     2717             and buf_s-coeff.s-date <= v-date
     2718       no-error.
     2719       if available buf_s-coeff
     2720       then do:
     2721           assign
     2722               p-coeff-value = buf_s-coeff.coeff-value
     2723           .
     2724           return.
     2725       end.
     2726       find last buf_s-coeff no-lock
     2727           where buf_s-coeff.gds-code = p-gds-code
     2728             and buf_s-coeff.host-code = v-host-code
     2729             and buf_s-coeff.obj-type = "":U
     2730             and buf_s-coeff.obj-code = 0
     2731             and buf_s-coeff.s-date <= v-date
     2732       no-error.
     2733       if available buf_s-coeff
     2734       then do:
     2735           assign
     2736               p-coeff-value = buf_s-coeff.coeff-value
     2737           .
     2738           return.
     2739       end.
     2740       find last buf_s-coeff no-lock
     2741           where buf_s-coeff.gds-code = p-gds-code
     2742             and buf_s-coeff.host-code = 0
     2743             and buf_s-coeff.obj-type = "":U
     2744             and buf_s-coeff.obj-code = 0
     2745             and buf_s-coeff.s-date <= v-date
     2746       no-error.
     2747       if available buf_s-coeff
     2748       then do:
     2749           assign
     2750               p-coeff-value = buf_s-coeff.coeff-value
     2751           .
     2752       end.
     2753       else do:
     2754           assign
     2755               p-coeff-value = 0
     2756           .
     2757       end.
     2758   end.
     2759   end procedure.
     2760   procedure fbrlib_create-fbr-recipe-gds :
     2761   define input parameter p-doc-code         as character      no-undo.
     2762   define input parameter p-recipe-code      as character      no-undo.
     2763   define input parameter p-prod-type        as character      no-undo.
     2764   define input parameter p-prod-code        as integer        no-undo.
     2765   define input parameter p-artic            as character      no-undo.
     2766   define input parameter p-gds-code         as integer        no-undo.
     2767   define input parameter p-is-waste         as logical        no-undo.
     2768   define input parameter p-proc-number      as integer        no-undo.
     2769   define input parameter p-obj-date         as date           no-undo.
     2770   define input parameter p-obj-type         as character      no-undo.
     2771   define input parameter p-obj-code         as integer        no-undo.
     2772   define input parameter p-calc-method      as decimal        no-undo.
     2773   define input parameter p-coeff-waste      as decimal        no-undo.
     2774   define input parameter p-orig-qnty        as decimal        no-undo.
     2775   define input parameter p-orig-brutto-qnty as decimal        no-undo.
     2776       define variable v-coeff-season  as decimal      no-undo.
     2777       define variable v-void-decimal  as decimal      no-undo.
     2778       define variable v-void-integer  as integer      no-undo.
     2779       define variable v-recipe-type   as character    no-undo.
     2780       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     2781       define buffer buf_goods             for ub.goods.
     2782       define buffer buf_recipe            for ub.recipe.
     2783   do
     2784   for buf_fbr-recipe-gds
     2785     , buf_recipe
     2786     , buf_goods
     2787   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2788   :
     2789       find first buf_fbr-recipe-gds exclusive-lock
     2790            where buf_fbr-recipe-gds.doc-code    = p-doc-code
     2791              and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     2792              and buf_fbr-recipe-gds.prod-type   = p-prod-type
     2793              and buf_fbr-recipe-gds.prod-code   = p-prod-code
     2794              and buf_fbr-recipe-gds.artic       = p-artic
     2795       no-error.
     2796       if not available buf_fbr-recipe-gds
     2797       then do:
     2798           create buf_fbr-recipe-gds.
     2799           assign
     2800               buf_fbr-recipe-gds.doc-code           = p-doc-code
     2801               buf_fbr-recipe-gds.recipe-code        = p-recipe-code
     2802               buf_fbr-recipe-gds.prod-type          = p-prod-type
     2803               buf_fbr-recipe-gds.prod-code          = p-prod-code
     2804               buf_fbr-recipe-gds.artic              = p-artic
     2805               buf_fbr-recipe-gds.gds-code           = p-gds-code
     2806               buf_fbr-recipe-gds.is-waste           = p-is-waste
     2807               buf_fbr-recipe-gds.proc-number        = p-proc-number
     2808               buf_fbr-recipe-gds.recipe-qnty        = p-orig-qnty
     2809               buf_fbr-recipe-gds.recipe-brutto-qnty = p-orig-brutto-qnty
     2810           .
     2811           find first buf_goods no-lock
     2812                where buf_goods.prod-type = buf_fbr-recipe-gds.prod-type
     2813                  and buf_goods.prod-code = buf_fbr-recipe-gds.prod-code
     2814                  and buf_goods.artic     = buf_fbr-recipe-gds.artic
     2815           .
     2816           run fbrlib-s-coeff-value in this-procedure (
     2817                 input buf_goods.gds-code
     2818               , input p-obj-date
     2819               , input p-obj-type
     2820               , input p-obj-code
     2821               , output v-coeff-season
     2822           ) no-error.
     2823           if error-status:error
     2824           then do:
     2825               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     2826           end.
     2827           assign
     2828               buf_fbr-recipe-gds.qnty         = p-orig-qnty
     2829               buf_fbr-recipe-gds.coeff-value  = v-coeff-season
     2830               buf_fbr-recipe-gds.coeff-waste  = p-coeff-waste
     2831           .
     2832           run fbrlib-get-recipe-type in this-procedure (
     2833                 input buf_fbr-recipe-gds.doc-code
     2834               , input buf_fbr-recipe-gds.recipe-code
     2835               , output v-recipe-type
     2836           ).
     2837           if v-recipe-type <> 'производство':U
     2838           then do:
     2839               assign
     2840                   buf_fbr-recipe-gds.coeff-value  = 0
     2841                   buf_fbr-recipe-gds.coeff-waste  = 0
     2842                   buf_fbr-recipe-gds.calc-method  = 1
     2843                   buf_fbr-recipe-gds.brutto-qnty  = buf_fbr-recipe-gds.qnty
     2844               .
     2845           end.
     2846           else do:
     2847               run fbrlib-calc-brutto in this-procedure (
     2848                     input v-recipe-type
     2849                   , input buf_fbr-recipe-gds.qnty
     2850                   , input buf_fbr-recipe-gds.coeff-value
     2851                   , input buf_fbr-recipe-gds.coeff-waste
     2852                   , input 0
     2853                   , input 3
     2854                   , output v-void-decimal
     2855                   , output v-void-decimal
     2856                   , output buf_fbr-recipe-gds.brutto-qnty
     2857                   , output v-void-integer
     2858               ).
     2859               assign
     2860                   buf_fbr-recipe-gds.calc-method  = p-calc-method
     2861               .
     2862               run fbrlib-calc-brutto in this-procedure (
     2863                     input v-recipe-type
     2864                   , input buf_fbr-recipe-gds.qnty
     2865                   , input buf_fbr-recipe-gds.coeff-value
     2866                   , input buf_fbr-recipe-gds.coeff-waste
     2867                   , input buf_fbr-recipe-gds.brutto-qnty
     2868                   , input buf_fbr-recipe-gds.calc-method
     2869                   , output buf_fbr-recipe-gds.qnty
     2870                   , output v-void-decimal
     2871                   , output v-void-decimal
     2872                   , output v-void-integer
     2873               ).
     2874           end.
     2875       end.
     2876   end.
     2877   end procedure.
     2878   procedure fbrlib-set-default-recipe :
     2879   define input parameter p-obj-type   as character    no-undo.
     2880   define input parameter p-obj-code   as integer      no-undo.
     2881   define input parameter p-gds-code   as integer      no-undo.
     2882       define variable v-artic             as character    no-undo.
     2883       define variable v-prod-type         as character    no-undo.
     2884       define variable v-prod-code         as character    no-undo.
     2885       define variable v-recipe-code       as character    no-undo.
     2886       define variable v-fbr-gds-obj-recid as recid        no-undo.
     2887       define variable v-recipe-found      as logical      no-undo.
     2888       define buffer buf_recipe        for ub.recipe.
     2889       define buffer buf_other_recipe  for ub.recipe.
     2890       define buffer buf_goods         for ub.goods.
     2891       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2892   do
     2893   for buf_recipe
     2894     , buf_goods
     2895     , buf_fbr-gds-obj
     2896   on error undo, return error
     2897   :
     2898       find first buf_goods no-lock
     2899            where buf_goods.gds-code = p-gds-code
     2900       .
     2901       run fbrlib-get-obj-recipe in this-procedure (
     2902             input p-obj-type
     2903           , input p-obj-code
     2904           , input p-gds-code
     2905           , output v-recipe-code
     2906       ).
     2907       if v-recipe-code <> ""
     2908       then do:
     2909           find first buf_recipe no-lock
     2910               where buf_recipe.recipe-code = v-recipe-code
     2911           no-error.
     2912           if not available buf_recipe
     2913           then do:
     2914               assign
     2915                   v-recipe-code = ""
     2916               .
     2917           end.
     2918       end.
     2919       if v-recipe-code = ""
     2920       then do:
     2921           find first buf_fbr-gds-obj exclusive-lock
     2922                where buf_fbr-gds-obj.obj-type = p-obj-type
     2923                  and buf_fbr-gds-obj.obj-code = p-obj-code
     2924                  and buf_fbr-gds-obj.gds-code = p-gds-code
     2925           no-error.
     2926           if not available buf_fbr-gds-obj
     2927           then do:
     2928               run ref/fgdsobj1.p (
     2929                     input-output v-fbr-gds-obj-recid
     2930                   , input 'ДОБАВЛЕНИЕ':U
     2931                   , input no
     2932                   , input p-gds-code
     2933                   , input p-obj-type
     2934                   , input p-obj-code
     2935                   , input 0
     2936                   , input ""
     2937                   , input 0
     2938                   , input no
     2939                   , input no
     2940                   , input no
     2941                   , input no
     2942                   , input no
     2943                   , input no
     2944               ) no-error.
     2945               if error-status:error
     2946               then do:
     2947                   message
     2948                           vss-workfile vss-revision vss-description
     2949                       skip "Ошибка изменения атрибутов товара на объекте"
     2950                       skip return-value
     2951                       skip trim(error-status :get-message(1))
     2952                               trim(error-status :get-message(2))
     2953                               trim(error-status :get-message(3))
     2954                   view-as alert-box error.
     2955                   undo, return error .
     2956               end.
     2957               find first buf_fbr-gds-obj exclusive-lock
     2958                    where recid( buf_fbr-gds-obj ) = v-fbr-gds-obj-recid
     2959               .
     2960           end.
     2961           assign
     2962               v-recipe-found = no
     2963           .
     2964           for first buf_recipe no-lock
     2965               where buf_recipe.obj-type    = p-obj-type
     2966                 and buf_recipe.obj-code    = p-obj-code
     2967                 and buf_recipe.artic       = buf_goods.artic
     2968                 and buf_recipe.prod-type   = buf_goods.prod-type
     2969                 and buf_recipe.prod-code   = buf_goods.prod-code
     2970                 and buf_recipe.recipe-type = 'производство':U
     2971                 or (
     2972                     buf_recipe.obj-type    = ""
     2973                 and buf_recipe.obj-code    = 0
     2974                 and buf_recipe.artic       = buf_goods.artic
     2975                 and buf_recipe.prod-type   = buf_goods.prod-type
     2976                 and buf_recipe.prod-code   = buf_goods.prod-code
     2977                 and buf_recipe.recipe-type = 'производство':U
     2978                     )
     2979           :
     2980               assign
     2981                   v-recipe-found = yes
     2982                   buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2983               .
     2984           end.
     2985           if v-recipe-found = no
     2986           then do:
     2987               for first buf_recipe no-lock
     2988                   where buf_recipe.obj-type    = p-obj-type
     2989                     and buf_recipe.obj-code    = p-obj-code
     2990                     and buf_recipe.artic       = buf_goods.artic
     2991                     and buf_recipe.prod-type   = buf_goods.prod-type
     2992                     and buf_recipe.prod-code   = buf_goods.prod-code
     2993                     and buf_recipe.recipe-type <> 'альтернатива':U
     2994                     or (
     2995                         buf_recipe.obj-type    = ""
     2996                     and buf_recipe.obj-code    = 0
     2997                     and buf_recipe.artic       = buf_goods.artic
     2998                     and buf_recipe.prod-type   = buf_goods.prod-type
     2999                     and buf_recipe.prod-code   = buf_goods.prod-code
     3000                     and buf_recipe.recipe-type <> 'альтернатива':U
     3001                         )
     3002               :
     3003                   assign
     3004                       v-recipe-found = yes
     3005                       buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     3006                   .
     3007               end.
     3008               if v-recipe-found = no
     3009               then do:
     3010                   for first buf_recipe no-lock
     3011                       where buf_recipe.obj-type    = p-obj-type
     3012                         and buf_recipe.obj-code    = p-obj-code
     3013                         and buf_recipe.artic       = buf_goods.artic
     3014                         and buf_recipe.prod-type   = buf_goods.prod-type
     3015                         and buf_recipe.prod-code   = buf_goods.prod-code
     3016                         or (
     3017                             buf_recipe.obj-type    = ""
     3018                         and buf_recipe.obj-code    = 0
     3019                         and buf_recipe.artic       = buf_goods.artic
     3020                         and buf_recipe.prod-type   = buf_goods.prod-type
     3021                         and buf_recipe.prod-code   = buf_goods.prod-code
     3022                             )
     3023                   :
     3024                       assign
     3025                           v-recipe-found = yes
     3026                           buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     3027                       .
     3028                   end.
     3029                   if v-recipe-found = no
     3030                   then do:
     3031                       assign
     3032                           buf_fbr-gds-obj.default-recipe-code = ""
     3033                       .
     3034                   end.
     3035               end.
     3036           end.
     3037       end.
     3038   end.
     3039   end procedure.
     3040   procedure fbrlib-get-obj-recipe :
     3041   define input parameter p-obj-type       as character    no-undo.
     3042   define input parameter p-obj-code       as integer      no-undo.
     3043   define input parameter p-gds-code       as integer      no-undo.
     3044   define output parameter p-recipe-code   as character    no-undo.
     3045       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     3046   do
     3047   for buf_fbr-gds-obj
     3048   on error undo, return error
     3049   :
     3050       find first buf_fbr-gds-obj no-lock
     3051            where buf_fbr-gds-obj.obj-type = p-obj-type
     3052              and buf_fbr-gds-obj.obj-code = p-obj-code
     3053              and buf_fbr-gds-obj.gds-code = p-gds-code
     3054       no-error.
     3055       if available buf_fbr-gds-obj
     3056       then do:
     3057           assign
     3058               p-recipe-code = buf_fbr-gds-obj.default-recipe-code
     3059           .
     3060       end.
     3061       else do:
     3062           assign
     3063               p-recipe-code = ""
     3064           .
     3065       end.
     3066   end.
     3067   end procedure.
     3068   procedure fbrlib-create-or-update-recipe-gds :
     3069   define input parameter p-recipe-code    as character        no-undo.
     3070   define input parameter p-gds-code       as integer          no-undo.
     3071   define input parameter p-is-waste       as logical          no-undo.
     3072   define input parameter p-qnty           as decimal          no-undo.
     3073   define input parameter p-proc-number    as integer          no-undo.
     3074   define input parameter p-nws-self       as logical          no-undo.
     3075       define variable v-max-proc-num  as integer      no-undo.
     3076       define variable v-recipe-type   as character    no-undo.
     3077       define buffer buf_goods             for ub.goods.
     3078       define buffer buf_recipe-gds        for ub.recipe-gds.
     3079       define buffer buf_recipe            for ub.recipe.
     3080       define buffer buf_proc_recipe-gds   for ub.recipe-gds.
     3081   do
     3082   for buf_goods
     3083     , buf_recipe-gds
     3084     , buf_recipe
     3085     , buf_proc_recipe-gds
     3086   on error undo, return error
     3087   :
     3088       find first buf_recipe no-lock
     3089            where buf_recipe.recipe-code = p-recipe-code
     3090       .
     3091       find first buf_goods no-lock
     3092            where buf_goods.gds-code = p-gds-code
     3093       .
     3094       find first buf_recipe-gds
     3095            where buf_recipe-gds.recipe-code = p-recipe-code
     3096              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     3097              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     3098              and buf_recipe-gds.artic       = buf_goods.artic
     3099       no-error.
     3100       if not available buf_recipe-gds
     3101       then do:
     3102           create buf_recipe-gds.
     3103           assign
     3104               buf_recipe-gds.recipe-code = p-recipe-code
     3105               buf_recipe-gds.gds-code    = p-gds-code
     3106               buf_recipe-gds.prod-type   = buf_goods.prod-type
     3107               buf_recipe-gds.prod-code   = buf_goods.prod-code
     3108               buf_recipe-gds.artic       = buf_goods.artic
     3109           .
     3110           assign
     3111               buf_recipe-gds.is-waste    = no
     3112               buf_recipe-gds.qnty        = 0
     3113               buf_recipe-gds.coeff-waste = 0
     3114               buf_recipe-gds.brutto-qnty = 0
     3115               buf_recipe-gds.proc-number = 0
     3116               buf_recipe-gds.nws-self    = no
     3117           .
     3118       end.
     3119       assign
     3120           buf_recipe-gds.is-waste    = p-is-waste
     3121       .
     3122       run fbrlib-get-recipe-type in this-procedure (
     3123             input "":U
     3124           , input buf_recipe-gds.recipe-code
     3125           , output v-recipe-type
     3126       ).
     3127       if v-recipe-type <> 'производство':U
     3128       then do:
     3129           assign
     3130               buf_recipe-gds.calc-method = 1
     3131               buf_recipe-gds.qnty        = p-qnty
     3132               buf_recipe-gds.brutto-qnty = p-qnty
     3133               buf_recipe-gds.coeff-waste = 0
     3134           .
     3135       end.
     3136       else do:
     3137           assign
     3138               buf_recipe-gds.calc-method = 1
     3139               buf_recipe-gds.brutto-qnty = p-qnty
     3140           .
     3141           run fbrlib-calc-brutto in this-procedure (
     3142                 input v-recipe-type
     3143               , input 0
     3144               , input 0
     3145               , input buf_recipe-gds.coeff-waste
     3146               , input buf_recipe-gds.brutto-qnty
     3147               , input 1
     3148               , output buf_recipe-gds.qnty
     3149               , output buf_recipe-gds.coeff-waste
     3150               , output buf_recipe-gds.brutto-qnty
     3151               , output buf_recipe-gds.calc-method
     3152           ).
     3153       end.
     3154       assign
     3155           buf_recipe-gds.nws-self    = p-nws-self
     3156       .
     3157       if buf_recipe.recipe-type = 'альтернатива':U
     3158       and buf_recipe-gds.proc-number <> 0
     3159       then do:
     3160       end.
     3161       else do:
     3162           if p-proc-number <> 0
     3163           then do:
     3164               assign
     3165                   buf_recipe-gds.proc-number = p-proc-number
     3166               .
     3167           end.
     3168           else do:
     3169               assign
     3170                   v-max-proc-num = 0
     3171               .
     3172               for each buf_proc_recipe-gds no-lock
     3173                  where buf_proc_recipe-gds.recipe-code = p-recipe-code
     3174               :
     3175                   if recid( buf_proc_recipe-gds ) <> recid( buf_recipe-gds )
     3176                   then do:
     3177                       assign
     3178                           v-max-proc-num = ( if v-max-proc-num < buf_proc_recipe-gds.proc-number then buf_proc_recipe-gds.proc-number else v-max-proc-num )
     3179                       .
     3180                   end.
     3181               end.
     3182               assign
     3183                   buf_recipe-gds.proc-number = v-max-proc-num + 1
     3184               .
     3185           end.
     3186       end.
     3187   end.
     3188   end procedure.
     3189   PROCEDURE fbrlib-create-or-update-recipe :
     3190   define input parameter p-mode               as character    no-undo.
     3191   define input parameter p-obj-type           as character    no-undo.
     3192   define input parameter p-obj-code           as integer      no-undo.
     3193   define input parameter p-recipe-code        as character    no-undo.
     3194   define input parameter p-recipe-type        as character    no-undo.
     3195   define input parameter p-gds-code           as integer      no-undo.
     3196   define input parameter p-name               as character    no-undo.
     3197   define input parameter p-design             as character    no-undo.
     3198   define input parameter p-order              as integer      no-undo.
     3199   define input parameter p-quality            as character    no-undo.
     3200   define input parameter p-ref-num            as character    no-undo.
     3201   define input parameter p-technique          as character    no-undo.
     3202   define input parameter p-template           as character    no-undo.
     3203   define input parameter p-qnty               as decimal      no-undo.
     3204   define input parameter p-portion-qnty       as integer      no-undo.
     3205   define input parameter p-portion-weight     as decimal      no-undo.
     3206   define output parameter p-new-recipe-code   as character    no-undo.
     3207       define variable v-host-code         as integer      no-undo.
     3208       define variable v-fbr-gds-obj-recid as recid        no-undo.
     3209       define buffer buf_recipe    for ub.recipe.
     3210       define buffer buf_goods     for ub.goods.
     3211   do
     3212   for buf_recipe
     3213     , buf_goods
     3214   on error undo, return error
     3215   :
     3216       if p-mode <> 'ДОБАВЛЕНИЕ':U
     3217       and p-mode <> 'ИЗМЕНЕНИЕ':U
     3218       then do:
     3219           message
     3220               skip "Ошибка задания типа операции для создания или измения рецепта."
     3221               skip (1)
     3222               skip "Задан тип операции:" p-mode
     3223           view-as alert-box error.
     3224           undo, return error .
     3225       end.
     3226       if p-recipe-code = ""
     3227       then do:
     3228   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3229   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3230     (input  p-obj-type
     3231     ,input  p-obj-code
     3232     ,output v-host-code
     3233     )  .
     3234           find first buf_goods no-lock
     3235                where buf_goods.gds-code = p-gds-code
     3236           .
     3237           create buf_recipe .
     3238           run fbrcode-gen-recipe-code in this-procedure (
     3239                 input p-obj-type
     3240               , input p-obj-code
     3241               , output buf_recipe.recipe-code
     3242           ).
     3243           assign
     3244               buf_recipe.artic               = buf_goods.artic
     3245               buf_recipe.prod-type           = buf_goods.prod-type
     3246               buf_recipe.prod-code           = buf_goods.prod-code
     3247               buf_recipe.recipe-type         = p-recipe-type
     3248               buf_recipe.recipe-name         = ( if p-name = "" then buf_goods.gds-name else p-name )
     3249               buf_recipe.gds-code            = p-gds-code
     3250               buf_recipe.host-code           = v-host-code
     3251               buf_recipe.obj-type            = p-obj-type
     3252               buf_recipe.obj-code            = p-obj-code
     3253               buf_recipe.recipe-design       = ""
     3254               buf_recipe.recipe-order        = 0
     3255               buf_recipe.recipe-quality      = ""
     3256               buf_recipe.recipe-ref-num      = ""
     3257               buf_recipe.recipe-technique    = ""
     3258               buf_recipe.recipe-template     = ""
     3259               buf_recipe.qnty                = 1.0
     3260               buf_recipe.portion-qnty        = 1
     3261               buf_recipe.portion-weight      = 0
     3262           .
     3263       end.
     3264       if p-name <> ""
     3265       then do:
     3266           assign
     3267               buf_recipe.recipe-name = p-name
     3268           .
     3269       end.
     3270       assign
     3271           buf_recipe.recipe-design       = p-design
     3272           buf_recipe.recipe-order        = p-order
     3273           buf_recipe.recipe-quality      = p-quality
     3274           buf_recipe.recipe-ref-num      = p-ref-num
     3275           buf_recipe.recipe-technique    = p-technique
     3276           buf_recipe.recipe-template     = p-template
     3277           buf_recipe.qnty                = p-qnty
     3278           buf_recipe.portion-qnty        = p-portion-qnty
     3279           buf_recipe.portion-weight      = p-portion-weight
     3280       .
     3281       assign
     3282           p-new-recipe-code = buf_recipe.recipe-code
     3283       .
     3284       run fbrlib-set-default-recipe in this-procedure (
     3285             input p-obj-type
     3286           , input p-obj-code
     3287           , input buf_goods.gds-code
     3288       ).
     3289   end.
     3290   END PROCEDURE.
     3291   PROCEDURE fbrlib-delete-fact-fbr-doc :
     3292   define input parameter parparentproc-handle as widget-handle no-undo .
     3293   define input parameter p-doc-code   as character no-undo.
     3294   define input parameter p-chip-num   like ub.c-trn-doc.chip-num no-undo .
     3295       define variable v-shift-on      as logical      no-undo.
     3296       define variable v-shift-date    as date         no-undo.
     3297       define variable v-shift-num     as integer      no-undo.
     3298       define variable v-shift-name    as character    no-undo.
     3299       define variable v-obj-date      as date         no-undo.
     3300       define variable v-chip-num      as integer      no-undo.
     3301       define buffer buf_fbr-doc       for ub.fbr-doc.
     3302       define buffer buf_fbr-line      for ub.fbr-line.
     3303       define buffer buf_c-fbr-doc     for ub.c-fbr-doc.
     3304       define buffer buf_fbr-recipe     for ub.fbr-recipe.
     3305       define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     3306       define buffer buf_marking-lines for ub.marking-lines .
     3307       define buffer buf_marking       for ub.marking .
     3308       define buffer buf_goods         for ub.goods .
     3309   do
     3310   for buf_fbr-doc
     3311     , buf_fbr-line
     3312     , buf_c-fbr-doc
     3313     , buf_fbr-recipe
     3314     , buf_fbr-recipe-gds
     3315     , buf_goods
     3316     , buf_marking
     3317     , buf_marking-lines
     3318   on error undo, return error
     3319   :
     3320   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3321     define variable v-cntxt-db-num        as integer   no-undo .
     3322     define variable v-cntxt-userid        as character no-undo .
     3323     define variable v-cntxt-level         as character no-undo .
     3324     define variable v-cntxt-host-code-obj as integer   no-undo .
     3325     define variable v-cntxt-obj-type      as character no-undo .
     3326     define variable v-cntxt-obj-code      as integer   no-undo .
     3327     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3328     define variable v-cntxt-is-admin      as logical   no-undo .
     3329   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3330     run mainmenu_getcntxt in parparentproc-handle
     3331       (output v-cntxt-db-num
     3332       ,output v-cntxt-userid
     3333       ,output v-cntxt-level
     3334       ,output v-cntxt-host-code-obj
     3335       ,output v-cntxt-obj-type
     3336       ,output v-cntxt-obj-code
     3337       ,output v-cntxt-db-num-obj
     3338       ,output v-cntxt-is-admin
     3339       ) .
     3340       if search ("delfbr.err") <> ?
     3341       then do:
     3342           os-delete "delfbr.err".
     3343       end.
     3344     _del-block:
     3345       do transaction
     3346     on error undo _del-block, return error return-value
     3347     on endkey undo _del-block , return error return-value
     3348     on stop undo _del-block , return error return-value
     3349       :
     3350           find first buf_fbr-doc exclusive-lock
     3351                where buf_fbr-doc.doc-code = p-doc-code
     3352           no-error.
     3353           if not available buf_fbr-doc
     3354           then do:
     3355         undo _del-block, return error substitute("&1 &2 &3&4Не найден документ производства &5 для удаления."
     3356                                           ,vss-workfile
     3357                                           ,vss-revision
     3358                                           ,vss-description
     3359                                           ,chr(10)
     3360                                           , p-doc-code).
     3361           end.
     3362           run fbrlib-delete-fact-trn-doc in this-procedure (
     3363               input parparentproc-handle
     3364              ,input p-doc-code
     3365              ,input 'при':U
     3366              ,input p-chip-num
     3367              ,output v-chip-num
     3368           ) no-error.
     3369           if error-status :error
     3370           then do:
     3371               run fbrlib-print-del-error-message in this-procedure .
     3372         undo _del-block, return error.
     3373           end.
     3374           assign
     3375           p-chip-num = (if p-chip-num = ?
     3376                         then v-chip-num
     3377                         else p-chip-num).
     3378           run fbrlib-delete-fact-trn-doc in this-procedure (
     3379               input parparentproc-handle
     3380              ,input p-doc-code
     3381              ,input 'рас':U
     3382              ,input p-chip-num
     3383              ,output v-chip-num
     3384           ) no-error.
     3385           if error-status :error
     3386           then do:
     3387               run fbrlib-print-del-error-message in this-procedure .
     3388         undo _del-block, return error.
     3389           end.
     3390           run fbrlib-delete-fact-trn-doc in this-procedure (
     3391               input parparentproc-handle
     3392              ,input p-doc-code
     3393              ,input 'спи':U
     3394              ,input p-chip-num
     3395              ,output v-chip-num
     3396           ) no-error.
     3397           if error-status :error
     3398           then do:
     3399               run fbrlib-print-del-error-message in this-procedure .
     3400         undo _del-block, return error.
     3401           end.
     3402           create buf_c-fbr-doc.
     3403           buffer-copy buf_fbr-doc to buf_c-fbr-doc.
     3404   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3405   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     3406     (input  buf_fbr-doc.obj-type
     3407     ,input  buf_fbr-doc.obj-code
     3408     ,output v-obj-date
     3409     ) no-error .
     3410           if error-status :error
     3411           or v-obj-date = ?
     3412           then do:
     3413         undo _del-block, return error "Нет текущей даты на объекте документа.".
     3414           end.
     3415   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3416   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3417     (input  buf_fbr-doc.obj-type
     3418     ,input  buf_fbr-doc.obj-code
     3419     ,input  'shift-on=request'
     3420     ,output v-shift-on
     3421     )  .
     3422           if v-shift-on
     3423           then do:
     3424   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3425   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     3426     (input  buf_fbr-doc.obj-type
     3427     ,input  buf_fbr-doc.obj-code
     3428     ,output v-shift-date
     3429     ,output v-shift-num
     3430     ,output v-shift-name
     3431     ) no-error .
     3432               if error-status :error
     3433               then do:
     3434           undo _del-block, return error "Ошибка при поиске текущей смены на объекте".
     3435               end.
     3436           end.
     3437           else do:
     3438               assign
     3439                   v-shift-date = ?
     3440                   v-shift-num  = ?
     3441                   v-shift-name = ?
     3442               .
     3443           end.
     3444           define variable v-today       as date         no-undo.
     3445           define variable v-time        as integer      no-undo.
     3446           run cur-time in this-procedure (
     3447                 output v-today
     3448               , output v-time
     3449           ).
     3450           assign
     3451               buf_c-fbr-doc.chip-num         = (if p-chip-num <> ? then p-chip-num else next-value( s-corr-chip, ub  ))
     3452               buf_c-fbr-doc.corr-user-name   = v-cntxt-userid
     3453               buf_c-fbr-doc.corr-user-db-num = v-cntxt-db-num
     3454               buf_c-fbr-doc.corr-date        = v-today
     3455               buf_c-fbr-doc.corr-time        = v-time
     3456               buf_c-fbr-doc.corr-shift-date  = v-shift-date
     3457               buf_c-fbr-doc.corr-shift-num   = v-shift-num
     3458               buf_c-fbr-doc.corr-shift-name  = v-shift-name
     3459               buf_c-fbr-doc.is-del           = yes
     3460           .
     3461           assign
     3462               buf_fbr-doc.is-del = yes
     3463           .
     3464           for each buf_fbr-line exclusive-lock
     3465              where buf_fbr-line.doc-code = p-doc-code
     3466       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3467       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3468       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3469           :
     3470               for first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     3471                                             and buf_goods.prod-type  = buf_fbr-line.prod-type
     3472                                             and buf_goods.prod-code  = buf_fbr-line.prod-code,
     3473               each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     3474                                                       and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     3475                                                       and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     3476                                                       and buf_marking-lines.in-code  = "manufacturing"
     3477                                                       and buf_marking-lines.out-code = buf_fbr-line.doc-code
     3478                                                       and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     3479                                                       and buf_marking-lines.prt-code = 0
     3480               :
     3481                 for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
     3482                   assign
     3483                     buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_fbr-line.is-comp
     3484                   .
     3485                 end .
     3486                 delete buf_marking-lines.
     3487               end .
     3488               delete buf_fbr-line.
     3489           end.
     3490           for each buf_fbr-recipe exclusive-lock
     3491              where buf_fbr-recipe.doc-code = p-doc-code
     3492       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3493       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3494       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3495           :
     3496               delete buf_fbr-recipe.
     3497           end.
     3498           for each buf_fbr-recipe-gds exclusive-lock
     3499              where buf_fbr-recipe-gds.doc-code = p-doc-code
     3500       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3501       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3502       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3503           :
     3504               delete buf_fbr-recipe-gds.
     3505           end.
     3506           delete buf_fbr-doc.
     3507       end.
     3508   end.
     3509   END PROCEDURE.
     3510   PROCEDURE fbrlib-del-trn-doc :
     3511   do
     3512   on error undo, return error
     3513   :
     3514   define input parameter parparentproc        as widget-handle no-undo .
     3515   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     3516   define input parameter p-trn-doc-type       as character    no-undo.
     3517   define input parameter p-phchip-num         like ub.c-trn-doc.chip-num no-undo .
     3518   define output parameter p-chip-num           like ub.c-trn-doc.chip-num no-undo .
     3519       define variable v-trn-doc-doc-code  as character     no-undo.
     3520       define buffer buf_trn-doc       for ub.trn-doc.
     3521   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3522     define variable v-cntxt-db-num        as integer   no-undo .
     3523     define variable v-cntxt-userid        as character no-undo .
     3524     define variable v-cntxt-level         as character no-undo .
     3525     define variable v-cntxt-host-code-obj as integer   no-undo .
     3526     define variable v-cntxt-obj-type      as character no-undo .
     3527     define variable v-cntxt-obj-code      as integer   no-undo .
     3528     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3529     define variable v-cntxt-is-admin      as logical   no-undo .
     3530   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3531     run mainmenu_getcntxt in parparentproc
     3532       (output v-cntxt-db-num
     3533       ,output v-cntxt-userid
     3534       ,output v-cntxt-level
     3535       ,output v-cntxt-host-code-obj
     3536       ,output v-cntxt-obj-type
     3537       ,output v-cntxt-obj-code
     3538       ,output v-cntxt-db-num-obj
     3539       ,output v-cntxt-is-admin
     3540       ) .
     3541       run fbrcode-trn-doc in this-procedure (
     3542             input 'производство':U
     3543           , input p-fbr-doc-doc-code
     3544           , input p-trn-doc-type
     3545           , output v-trn-doc-doc-code
     3546       ).
     3547       find first buf_trn-doc no-lock
     3548            where buf_trn-doc.doc-code = v-trn-doc-doc-code
     3549       no-error.
     3550       if available buf_trn-doc
     3551       then do:
     3552           run str/del-doc.p (
     3553                 input parparentproc
     3554               , input buf_trn-doc.doc-code
     3555               , input v-cntxt-db-num
     3556               , input "del-doc.err"
     3557               , input ?
     3558               , input p-fbr-doc-doc-code
     3559               , input v-cntxt-userid
     3560               , input 0
     3561               , input p-phchip-num
     3562               , output p-chip-num
     3563           ) no-error.
     3564           if error-status :error
     3565           then do:
     3566             undo, return error substitute("Не удалось удалить складской документ &1, созданный по документу производства &2.&3&4&3&5"
     3567                                           ,v-trn-doc-doc-code
     3568                                           ,p-fbr-doc-doc-code
     3569                                           , chr(10)
     3570                                           , error-status:get-message(1)
     3571                                           , return-value ).
     3572           end.
     3573       end.
     3574   end.
     3575   END PROCEDURE.
     3576   PROCEDURE fbrlib-delete-fact-trn-doc :
     3577   define input parameter parparentproc    as widget-handle    no-undo.
