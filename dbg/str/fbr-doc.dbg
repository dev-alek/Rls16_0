    12791   ON CHOOSE OF MENU-ITEM m-doc
    12792      DO:
    12793         define variable loc-ref-list as character no-undo.
    12794         define variable i            as integer   no-undo .
    12795         run str/all-docs.w (
    12796            input parparentproc,
    12797            input v-cntxt-host-code-obj ,
    12798            input v-cntxt-obj-type ,
    12799            input v-cntxt-obj-code ,
    12800            input 'выбор':U,
    12801            input ?,
    12802            input ?,
    12803            input ?,
    12804            input ?,
    12805            input "b-sel,b-mark":U,
    12806            input ?,
    12807            input ?,
    12808            input ?,
    12809            output loc-ref-list ) NO-ERROR.
    12810         if loc-ref-list = ""  then
    12811         do:
    12812            message
    12813               "Ничего не отметили в списке заказов !"
    12814               view-as alert-box information .
    12815            display
    12816               ? @ out-code
    12817               with frame D-FBR-DOC.
    12818            apply "entry" to b-add in frame D-FBR-DOC.
    12819            return no-apply.
    12820         end.
    12821         if num-entries( loc-ref-list ) = 0
    12822            or loc-ref-list = ""
    12823            or error-status:error
    12824            then
    12825         do:
    12826            display
    12827               ? @ out-code
    12828               with frame D-FBR-DOC.
    12829            apply "entry" to b-add in frame D-FBR-DOC.
    12830            return no-apply.
    12831         end.
    12832         else
    12833         do:
    12834   if session :set-wait-state( "compiler" ) then.
    12835            repeat i = 1 to  num-entries( loc-ref-list ) :
    12836               find first ub.trn-doc no-lock
    12837                  where recid( ub.trn-doc ) = integer( entry( i , loc-ref-list ) )  no-error.
    12838               display
    12839                  ub.trn-doc.doc-code @ out-code
    12840                  with frame D-FBR-DOC.
    12841               run str/fbr-copy.p (
    12842                  input parparentproc
    12843                  , input f-doc.doc-code
    12844                  , input trn-doc.doc-code
    12845                  , input f-doc.obj-type
    12846                  , input f-doc.obj-code
    12847                  , input v-price-sale-obj-type
    12848                  , input v-price-sale-obj-code
    12849                  , input p-fbrhist-handle
    12850                  ) no-error.
    12851               if error-status :error
    12852                  then
    12853               do:
    12854                  message
    12855                     vss-workfile vss-revision vss-description
    12856                     skip(1)
    12857                     skip
    12858                     "Ошибка копирования накладной в документ производства."
    12859                     skip return-value
    12860                     skip trim( error-status :get-message( 1 ) )
    12861                     trim( error-status :get-message( 2 ) )
    12862                     trim( error-status :get-message( 3 ) )
    12863                     view-as alert-box error.
    12864                  undo, return no-apply.
    12865               end.
    12866            end.
    12867         end.
    12868         assign
    12869            f-doc.is-free = no
    12870            .
    12871         run hide-not-avail-menu-items in this-procedure ( input no ).
    12872         run UI-on in this-procedure ( input "line" ).
    12873   if session :set-wait-state( "" ) then.
    12874         return no-apply.
    12875      END.
