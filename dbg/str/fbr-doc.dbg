    13641   PROCEDURE proc-sht :
    13642      define buffer bf_shift-obj for ub.shift-obj.
    13643      define variable varrid-list as character no-undo.
    13644      define variable varrecid    as recid     no-undo.
    13645      assign
    13646         varrid-list = "".
    13647      run str/sht-all.w (parparentproc, f-doc.obj-type, f-doc.obj-code, 'b-sel', 'obj',f-doc.obj-type, f-doc.obj-code, '':u, input-output varrid-list) no-error.
    13648      if error-status:error or varrid-list = "":u then
    13649      do:
    13650         return.
    13651      end.
    13652      else
    13653      do:
    13654         assign
    13655            varrecid = integer (entry(1, varrid-list)).
    13656         find first bf_shift-obj where recid(bf_shift-obj) = varrecid no-lock no-error.
    13657         if available bf_shift-obj then
    13658         do:
    13659            assign
    13660               f-doc.shift-date = bf_shift-obj.shift-date
    13661               f-doc.shift-num  = bf_shift-obj.shift-num
    13662               f-doc.shift-name = bf_shift-obj.shift-name.
    13663            shift = subst("&1 &2 &3", f-doc.shift-date, f-doc.shift-num, f-doc.shift-name ).
    13664            display shift f-doc.shift-date f-doc.shift-num f-doc.shift-name with frame D-FBR-DOC.
    13665            assign
    13666               f-doc.fact-date = f-doc.shift-date
    13667               fact-date       = f-doc.shift-date.
    13668            display fact-date with frame D-FBR-DOC.
    13669         end.
    13670      end.
    13671   END PROCEDURE.
    13672   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME D-FBR-DOC:PARENT eq ?
    13673      THEN FRAME D-FBR-DOC:PARENT = ACTIVE-WINDOW.
    13674   assign
    13675      p-new-fbr-doc-recid = p-fbr-doc-recid
    13676      .
    13677   define variable vss-include-info91 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
