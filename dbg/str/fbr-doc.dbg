    17024     (input filter-point
    17025     ,output flt-rec-117
    17026     ,output filter-name-117
    17027     ,output where-phrase-117
    17028     ,output sort-phrase-117
    17029     ,output where-phrase-rus-117
    17030     ,output sort-phrase-rus-117
    17031     ).
    17032     assign
    17033       l-filter-open-117 = false
    17034     .
    17035     if flt-rec-117 <> ?
    17036       or ingr-sort-column-phrase > ""
    17037     then do:
    17038       define variable  parameter-2-117 as character no-undo .
    17039       define variable  parameter-3-117 as character no-undo .
    17040       define variable  parameter-4-117 as character no-undo .
    17041       define variable  parameter-5-117 as character no-undo .
    17042       define variable  parameter-6-117 as character no-undo .
    17043       define variable  parameter-7-117 as character no-undo .
    17044         assign
    17045         parameter-3-117 =
    17046                                 "for each buf_ingr_fbr-line no-lock"
    17047         parameter-4-117 =
    17048           (
    17049             if ("buf_ingr_fbr-line.doc-code = f-doc.doc-code and                         buf_ingr_fbr-line.is-comp = no and                         buf_ingr_fbr-line.recipe-code = '' " + " " + where-phrase-117) <> ""
    17050             then  substitute('buf_ingr_fbr-line.doc-code = &1&2&1 and                         buf_ingr_fbr-line.is-comp = no and                         buf_ingr_fbr-line.recipe-code = &1&3&1'                        , chr(34), f-doc.doc-code, '':U) + " " + where-phrase-117
    17051             else "true"
    17052           )
    17053         parameter-5-117 = (" " + "" + " " + "")
    17054         parameter-6-117 = if sort-phrase-117 = ''
    17055                              then
    17056           (
    17057           " " + " " +
    17058             " " + ingr-sort-column-phrase +
    17059           " " + " "
    17060           )
    17061                              else
    17062           (
    17063           " " + " " +
    17064             " " + ingr-sort-column-phrase +
    17065           " " + sort-phrase-117
    17066           )
    17067         parameter-7-117 =
    17068           " indexed-reposition  "
    17069       .
    17070       do
    17071       on stop undo, leave
    17072       on error undo, leave
    17073       :
    17074         assign
    17075           l-disable-where-117 =
    17076             ("buf_ingr_fbr-line.doc-code = f-doc.doc-code and                         buf_ingr_fbr-line.is-comp = no and                         buf_ingr_fbr-line.recipe-code = '' " + " " + where-phrase-117 = "")
    17077         .
    17078         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
    17079                             ,input query br-ingr:handle
    17080                             ,input parameter-3-117
    17081                             ,input parameter-4-117
    17082                             ,input parameter-5-117
    17083                             ,input parameter-6-117
    17084                             ,input parameter-7-117
    17085                             )
    17086         .
    17087         assign
    17088           l-filter-open-117 = true
    17089         .
    17090       end.
    17091       if l-filter-open-117 = false then do:
    17092         message
    17093           "Ошибка при фильтрации / сортировке" skip
    17094           "Будут показаны записи без учета фильтра" skip
    17095           view-as alert-box .
    17096       end.
    17097       else do:
    17098       end.
    17099     end.
    17100     if l-filter-open-117 = false then do:
    17101       open query br-ingr for each buf_ingr_fbr-line no-lock
    17102         where buf_ingr_fbr-line.doc-code = f-doc.doc-code and                         buf_ingr_fbr-line.is-comp = no and                         buf_ingr_fbr-line.recipe-code = ''
    17103         indexed-reposition
    17104     .
    17105     end.
    17106               end.
    17107            end.
    17108         when "all"
    17109         then
    17110            do:
    17111   define variable vss-include-info118 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    17112   define variable  l-disable-where-119  as logical   no-undo .
    17113   define variable  l-filter-open-119    as logical   .
    17114   define variable  flt-rec-119       as recid     no-undo .
    17115   define variable  filter-name-119      as character no-undo .
    17116   define variable  where-phrase-119     as character no-undo .
    17117   define variable  sort-phrase-119      as character no-undo .
    17118   define variable  where-phrase-rus-119 as character no-undo .
    17119   define variable  sort-phrase-rus-119  as character no-undo .
    17120   run gbl/flt-get.p
    17121     (input filter-point
    17122     ,output flt-rec-119
    17123     ,output filter-name-119
    17124     ,output where-phrase-119
    17125     ,output sort-phrase-119
    17126     ,output where-phrase-rus-119
    17127     ,output sort-phrase-rus-119
    17128     ).
    17129     assign
    17130       l-filter-open-119 = false
    17131     .
    17132     if flt-rec-119 <> ?
    17133       or ingr-sort-column-phrase > ""
    17134     then do:
    17135       define variable  parameter-2-119 as character no-undo .
    17136       define variable  parameter-3-119 as character no-undo .
    17137       define variable  parameter-4-119 as character no-undo .
    17138       define variable  parameter-5-119 as character no-undo .
    17139       define variable  parameter-6-119 as character no-undo .
    17140       define variable  parameter-7-119 as character no-undo .
    17141         assign
    17142         parameter-3-119 =
    17143                                 "for each buf_ingr_fbr-line no-lock"
    17144         parameter-4-119 =
    17145           (
    17146             if ("buf_ingr_fbr-line.doc-code = f-doc.doc-code and                             buf_ingr_fbr-line.is-comp = no " + " " + where-phrase-119) <> ""
    17147             then  substitute('buf_ingr_fbr-line.doc-code = &1&2&1 and                             buf_ingr_fbr-line.is-comp = no'                             , chr(34), f-doc.doc-code ) + " " + where-phrase-119
    17148             else "true"
    17149           )
    17150         parameter-5-119 = (" " + "" + " " + "")
    17151         parameter-6-119 = if sort-phrase-119 = ''
    17152                              then
    17153           (
    17154           " " + " " +
    17155             " " + ingr-sort-column-phrase +
    17156           " " + " "
    17157           )
    17158                              else
    17159           (
    17160           " " + " " +
    17161             " " + ingr-sort-column-phrase +
    17162           " " + sort-phrase-119
    17163           )
    17164         parameter-7-119 =
    17165           " indexed-reposition  "
    17166       .
    17167       do
    17168       on stop undo, leave
    17169       on error undo, leave
    17170       :
    17171         assign
    17172           l-disable-where-119 =
    17173             ("buf_ingr_fbr-line.doc-code = f-doc.doc-code and                             buf_ingr_fbr-line.is-comp = no " + " " + where-phrase-119 = "")
    17174         .
    17175         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
    17176                             ,input query br-ingr:handle
    17177                             ,input parameter-3-119
    17178                             ,input parameter-4-119
    17179                             ,input parameter-5-119
    17180                             ,input parameter-6-119
    17181                             ,input parameter-7-119
    17182                             )
    17183         .
    17184         assign
    17185           l-filter-open-119 = true
    17186         .
    17187       end.
    17188       if l-filter-open-119 = false then do:
    17189         message
    17190           "Ошибка при фильтрации / сортировке" skip
    17191           "Будут показаны записи без учета фильтра" skip
    17192           view-as alert-box .
    17193       end.
    17194       else do:
    17195       end.
    17196     end.
    17197     if l-filter-open-119 = false then do:
    17198       open query br-ingr for each buf_ingr_fbr-line no-lock
    17199         where buf_ingr_fbr-line.doc-code = f-doc.doc-code and                             buf_ingr_fbr-line.is-comp = no
    17200         indexed-reposition
    17201     .
    17202     end.
    17203            end.
    17204         otherwise
    17205         do:
    17206            message
    17207               "Неизвестный режим:" rs-one-all
    17208               view-as alert-box error.
    17209         end.
    17210      end case.
    17211      apply "value-changed" to br-ingr in frame D-FBR-DOC.
    17212   END PROCEDURE.
    17213   PROCEDURE process-parts :
    17214      do
    17215         on error undo, return error
    17216         :
    17217         define input parameter p-doc-code       as character    no-undo.
    17218         define input parameter p-trn-type       as character    no-undo.
    17219         define input parameter p-recipe-code    as character    no-undo.
    17220         define input parameter p-artic          as character    no-undo.
    17221         define input parameter p-prod-type      as character    no-undo.
    17222         define input parameter p-prod-code      as integer      no-undo.
    17223         define variable v-gds-code    as integer   no-undo .
    17224         define variable v-parts-recid as recid     no-undo.
    17225         define variable v-status      as character no-undo.
    17226         define variable v-doc-qnty    as decimal   no-undo.
    17227         define variable v-void        as decimal   no-undo.
    17228         define variable v-sum-base    as decimal   no-undo.
    17229         define variable v-sum-rubl    as decimal   no-undo.
    17230         define variable v-vat-base    as decimal   no-undo.
    17231         define variable v-vat-rubl    as decimal   no-undo.
    17232         define buffer buf_doc-line for ub.doc-line.
    17233         define buffer buf_trn-doc  for ub.trn-doc.
    17234         define buffer buf_fbr-line for ub.fbr-line.
    17235         define buffer buf_fbr-doc  for ub.fbr-doc.
    17236   if session :set-wait-state( "compiler" ) then.
    17237   define variable vss-include-info120 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    17238   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
    17239     (input  p-artic
    17240     ,input  p-prod-type
    17241     ,input  p-prod-code
    17242     ,output v-gds-code
    17243     )  .
    17244         do transaction
    17245            on error undo, return error
    17246            :
    17247            find first buf_fbr-doc no-lock
    17248               where buf_fbr-doc.doc-code = p-doc-code
    17249               .
    17250            find first buf_trn-doc exclusive-lock
    17251               where buf_trn-doc.doc-code = p-doc-code
    17252               .
    17253            find first buf_doc-line exclusive-lock
    17254               where buf_doc-line.doc-code    = buf_trn-doc.doc-code
    17255               and buf_doc-line.artic       = p-artic
    17256               and buf_doc-line.prod-type   = p-prod-type
    17257               and buf_doc-line.prod-code   = p-prod-code
    17258               no-error.
    17259            if not available buf_doc-line
    17260               then
    17261            do:
    17262               message
    17263                  "При списании товара по выбранной строке документа производства"
    17264                  skip
    17265                  "не была создана соответствующая строка в складском документе списания."
    17266                  skip(1)
    17267                  skip
    17268                  "Просмотр партий невозможен."
    17269                  view-as alert-box warning.
    17270               undo, return error.
    17271            end.
    17272            assign
    17273               v-doc-qnty          = buf_doc-line.doc-qnty
    17274               v-status            = buf_trn-doc.status_
    17275               buf_trn-doc.status_ = 'накл':U
    17276               .
    17277            run str/parts-l.w (
    17278               input parparentproc
    17279               , input f-doc.obj-type
    17280               , input f-doc.obj-code
    17281               , input v-gds-code
    17282               , input p-doc-code
    17283               , input ( if p-doc-mode = 'ПРОСМОТР':U
    17284               then 'ПРОСМОТР':U
    17285               else 'ИЗМЕНЕНИЕ':U
    17286               )
    17287               , input 'документ':U
    17288               , input 'текущий':U
    17289               , input 'документ':U
    17290               , output v-parts-recid
    17291               ) no-error.
    17292            if error-status :error
    17293               then
    17294            do:
    17295               if error-status :get-message(1) <> ""
    17296                  then
    17297               do:
    17298                  message
    17299                     vss-workfile vss-revision vss-description
    17300                     skip
    17301                     "Ошибка при вызове интерфейса работы с партиями товара."
    17302                     skip return-value
    17303                     skip trim(error-status :get-message(1))
    17304                     trim(error-status :get-message(2))
    17305                     trim(error-status :get-message(3))
    17306                     view-as alert-box error.
    17307                  undo, return error .
    17308               end.
    17309            end.
    17310   if session :set-wait-state( "compiler" ) then.
    17311            find current buf_doc-line exclusive-lock.
    17312            if buf_doc-line.doc-qnty <> v-doc-qnty
    17313               then
    17314            do:
    17315               message
    17316                  "При изменении количества по партиям списанного товара"
    17317                  skip
    17318                  "было изменено общее количество товара в документе."
    17319                  skip(1)
    17320                  skip
    17321                  "Произвести такое изменение количеств по партиям невозможно."
    17322                  skip
    17323                  "Операция будет отменена."
    17324                  view-as alert-box error.
    17325               undo, return error.
    17326            end.
    17327            assign
    17328               buf_trn-doc.status_ = v-status
    17329               .
    17330            run str/fbrclcln.p (
    17331               input buf_doc-line.doc-code
    17332               , input p-doc-code
    17333               , input p-trn-type
    17334               , input p-recipe-code
    17335               , input p-artic
    17336               , input p-prod-type
    17337               , input p-prod-code
    17338               , input buf_fbr-doc.is-free
    17339               ) no-error .
    17340            if error-status:error then
    17341            do:
    17342               undo, return error substitute("Ошибка при расчете строки (&5 &6&7) для документа производства &1&2&3&2&4"
    17343                  , buf_doc-line.doc-code
    17344                  , chr(10)
    17345                  , error-status:get-message(1)
    17346                  , return-value
    17347                  , p-artic
    17348                  , p-prod-type
    17349                  , p-prod-code
    17350                  ).
    17351            end.
    17352         end.
    17353         apply "entry" to br-ingr in frame D-FBR-DOC.
    17354   if session :set-wait-state( "" ) then.
    17355      end.
    17356   END PROCEDURE.
    17357   PROCEDURE select-fbroperator :
    17358      define output parameter p-obj-fbroperator   as character        no-undo.
    17359      define variable v-fbroperator       as integer no-undo.
    17360      define variable v-clients-recid-int as integer no-undo.
    17361      define variable v-clients-recid     as recid   no-undo.
    17362      define buffer buf_clients for ub.clients.
    17363      do
    17364         for buf_clients
    17365         on error undo, return error
    17366         :
    17367         if v-fbr-doc-fbroperator-code <> 0
    17368            then
    17369         do:
    17370            find first buf_clients no-lock
    17371               where buf_clients.obj-type = 'чел':U
    17372               and buf_clients.obj-code = v-fbr-doc-fbroperator-code
    17373               no-error.
    17374            if available buf_clients
    17375               then
    17376            do:
    17377               assign
    17378                  v-clients-recid = recid( buf_clients )
    17379                  .
    17380            end.
    17381         end.
    17382         run ref/cli-all.w (
    17383            input parparentproc
    17384            , input "b-sel":U
    17385            , input 'чел':U
    17386            , input 'все':U
    17387            , input 'текущие':U
    17388            , input v-clients-recid
    17389            , input ",,,,,,NO,,":U
    17390            , input "":U
    17391            , output ref-list
    17392            ).
    17393         assign
    17394            v-clients-recid-int = integer( ref-list )
    17395       no-error.
    17396         if error-status :error
    17397            then
    17398         do:
    17399            assign
    17400               v-fbr-doc-fbroperator-code = 0
    17401               p-obj-fbroperator          = "":U
    17402               .
    17403         end.
    17404         else
    17405         do:
    17406            find first buf_clients no-lock
    17407               where recid( buf_clients ) = v-clients-recid-int
    17408               no-error.
    17409            if not available buf_clients
    17410               then
    17411            do:
    17412               assign
    17413                  v-fbr-doc-fbroperator-code = 0
    17414                  p-obj-fbroperator          = "":U
    17415                  .
    17416            end.
    17417            else
    17418            do:
    17419               assign
    17420                  v-fbr-doc-fbroperator-code = buf_clients.obj-code
    17421                  p-obj-fbroperator          = buf_clients.obj-name
    17422                  .
    17423            end.
    17424         end.
    17425         run str/fbrattrw.p (
    17426            input f-doc.doc-code
    17427            , input 'fbroperator':U
    17428            , input string( v-fbr-doc-fbroperator-code )
    17429            ) no-error.
    17430         if error-status :error
    17431            then
    17432         do:
    17433            message
    17434               vss-workfile vss-revision vss-description
    17435               skip(1)
    17436               skip
    17437               "Не удалось записать оператора производства."
    17438               skip(1)
    17439               skip return-value
    17440               skip trim(error-status :get-message(1))
    17441               trim(error-status :get-message(2))
    17442               trim(error-status :get-message(3))
    17443               view-as alert-box warning.
    17444         end.
    17445      end.
    17446   END PROCEDURE.
    17447   FUNCTION need-marks RETURNS logical
    17448   (buffer local-fbr-line for ub.fbr-line ):
    17449     define buffer bf_gds for ub.goods.
    17450     define buffer buf_marking-lines      for ub.marking-lines .
    17451     define buffer buf_marking      for ub.marking .
    17452     define variable varvalue as character no-undo .
    17453     define variable vartype as character no-undo .
    17454     define variable v-marks-qnty as decimal no-undo init 0.0 .
    17455     define variable v-GTIN as character no-undo .
    17456     define variable v-GTIN-qnty as decimal no-undo .
    17457     find first bf_gds where bf_gds.artic      = local-fbr-line.artic
    17458                         and bf_gds.prod-type  = local-fbr-line.prod-type
    17459                         and bf_gds.prod-code  = local-fbr-line.prod-code
    17460                         .
    17461     v-isweighed = WghProdVariable(v-cntxt-obj-type, v-cntxt-obj-code, bf_gds.gds-code) .
    17462     RUN gds-attr-value (
    17463         INPUT bf_gds.gds-code,
    17464         INPUT 'mark-type':U,
    17465         OUTPUT varvalue,
    17466         OUTPUT vartype
    17467         ).
    17468     if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):GetIsEDOForType(varvalue)
    17469     or v-isweighed
    17470     then do :
    17471       for each buf_marking-lines no-lock where buf_marking-lines.gds-code = bf_gds.gds-code
    17472                                            and buf_marking-lines.obj-type = f-doc.obj-type
    17473                                            and buf_marking-lines.obj-code = f-doc.obj-code
    17474                                            and buf_marking-lines.in-code  = "manufacturing"
    17475                                            and buf_marking-lines.out-code = local-fbr-line.doc-code
    17476                                            and buf_marking-lines.part-code = local-fbr-line.recipe-code
    17477                                            and buf_marking-lines.prt-code = 0
    17478       :
    17479         if v-isweighed
    17480         then do :
    17481           for first buf_marking no-lock where buf_marking.mark begins buf_marking-lines.mark :
    17482             v-mark-weight = MarkWeight(buf_marking.mark) .
    17483             assign v-marks-qnty = v-marks-qnty + v-mark-weight .
    17484           end .
    17485         end .
    17486         else do :
    17487           v-GTIN = getGtinByDM(buf_marking-lines.mark) .
    17488           v-GTIN-qnty = getQntyCodeByGtin(v-GTIN) .
    17489           if v-GTIN-qnty = 1
    17490           then do :
    17491             v-marks-qnty = v-marks-qnty + v-GTIN-qnty .
    17492           end .
    17493         end .
    17494       end .
    17495       if v-marks-qnty <> local-fbr-line.fact-qnty
    17496       then return yes .
    17497       else return no .
    17498     end .
    17499     else return no .
    17500   end function.
    17501   procedure rowdisp :
    17502     if need-marks(buffer buf_ingr_fbr-line)
    17503     then do ii = 1 to extent (bcol):
    17504       if valid-handle (bcol[ii])
    17505       then do:
    17506         assign
    17507           bcol[ii]:bgcolor = RED_COLOR.
    17508       end.
    17509     end.
    17510   end procedure.
    17511   PROCEDURE select-fbrpaycode :
    17512      define input parameter p-fbrpaycode         as integer          no-undo.
    17513      define output parameter p-new-fbrpaycode    as integer          no-undo.
    17514      define variable v-pay-type-recid as character no-undo .
    17515      define buffer buf_pay-type for ub.pay-type.
    17516      do
    17517         for buf_pay-type
    17518         on error undo, return error
    17519         :
    17520         run ref/paytype.w (
    17521            input parparentproc
    17522            , "b-sel":U
    17523            , output v-pay-type-recid
    17524            ).
    17525         if v-pay-type-recid = ""
    17526            then
    17527         do:
    17528            assign
    17529               p-new-fbrpaycode = p-fbrpaycode
    17530               .
    17531         end.
    17532         else
    17533         do:
    17534            find first buf_pay-type no-lock
    17535               where recid( buf_pay-type ) = integer(v-pay-type-recid)
    17536               .
    17537            assign
    17538               p-new-fbrpaycode = buf_pay-type.obj-code
    17539               .
    17540         end.
    17541      end.
    17542   END PROCEDURE.
    17543   PROCEDURE set-comp-qnty :
    17544      do
    17545         on error undo, return error
    17546         :
    17547         define input parameter p-comp-v-fbr-doc-line-recid    as recid        no-undo.
    17548         define input parameter p-comp-qnty          as decimal      no-undo.
    17549         define variable v-doc-code    as character no-undo.
    17550         define variable v-recipe-code as character no-undo.
    17551         define variable v-is-fixed    as logical   init no no-undo.
    17552         define buffer buf_fbr-doc         for ub.fbr-doc.
    17553         define buffer buf_fbr-line        for ub.fbr-line.
    17554         define buffer buf_recipe_fbr-line for ub.fbr-line.
    17555         find first buf_recipe_fbr-line exclusive-lock
    17556            where recid( buf_recipe_fbr-line ) = p-comp-v-fbr-doc-line-recid
    17557            .
    17558         assign
    17559            buf_recipe_fbr-line.fact-qnty = p-comp-qnty
    17560            v-doc-code                    = buf_recipe_fbr-line.doc-code
    17561            v-recipe-code                 = buf_recipe_fbr-line.recipe-code
    17562            .
    17563         find first buf_fbr-doc no-lock
    17564            where buf_fbr-doc.doc-code = v-doc-code
    17565            .
    17566         if buf_fbr-doc.obj-type <> v-price-sale-obj-type
    17567            or buf_fbr-doc.obj-code <> v-price-sale-obj-code
    17568            then
    17569         do:
    17570            assign
    17571               v-is-fixed = yes
    17572               .
    17573         end.
    17574         for each buf_fbr-line no-lock
    17575            where buf_fbr-line.doc-code      = v-doc-code
    17576            and buf_fbr-line.recipe-code   = v-recipe-code
    17577            on error undo, return error
    17578            :
    17579            find first buf_recipe_fbr-line exclusive-lock
    17580               where recid( buf_recipe_fbr-line ) = recid( buf_fbr-line )
    17581               .
    17582            if buf_recipe_fbr-line.is-calc = no
    17583               then
    17584            do:
    17585               run fbrlib-calc-prices in this-procedure (
    17586                  input recid( buf_recipe_fbr-line )
    17587                  , input v-price-sale-obj-type
    17588                  , input v-price-sale-obj-code
    17589                  , output buf_recipe_fbr-line.price-sale
    17590                  ) no-error.
    17591               if error-status:error then
    17592               do:
    17593                  message substitute("Ошибка при расчете цен по док-ту&1&2&1&3"
    17594                     , chr(10)
    17595                     , error-status:get-message(1)
    17596                     , return-value )
    17597                     view-as alert-box error .
    17598                  undo, return error .
    17599               end.
    17600               assign
    17601                  buf_recipe_fbr-line.is-calc = v-is-fixed
    17602                  .
    17603            end.
    17604         end.
    17605      end.
    17606   END PROCEDURE.
    17607   PROCEDURE show-line-and-recipe :
    17608      define input parameter p-comp-v-fbr-doc-line-recid    as recid            no-undo.
    17609      define variable v-out-string as character no-undo.
    17610      define buffer buf_fbr-line       for ub.fbr-line.
    17611      define buffer buf_i_fbr-line     for ub.fbr-line.
    17612      define buffer buf_fbr-recipe     for ub.fbr-recipe.
    17613      define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
    17614      do
    17615         for buf_fbr-line
    17616         , buf_i_fbr-line
    17617         , buf_fbr-recipe
    17618         on error undo, return error
    17619         :
    17620         find first buf_fbr-line no-lock
    17621            where recid( buf_fbr-line ) = p-comp-v-fbr-doc-line-recid
    17622            no-error.
    17623         if available buf_fbr-line
    17624            then
    17625         do:
    17626            find first buf_fbr-recipe no-lock
    17627               where buf_fbr-recipe.doc-code    = buf_fbr-line.doc-code
    17628               and buf_fbr-recipe.recipe-code = buf_fbr-line.recipe-code
    17629               .
    17630            assign
    17631               v-out-string = substitute(  "Составной товар: &2&1    &4  &5 &6 &7"
    17632                                           , chr(10)
    17633                                           , buf_fbr-line.artic
    17634                                           , buf_fbr-line.fact-qnty
    17635                                           , buf_fbr-line.price-sum-rubl
    17636                                           , buf_fbr-line.price-sum-base
    17637                                           , buf_fbr-line.price-sum-vat-rubl
    17638                                           , buf_fbr-line.price-sum-vat-base
    17639                                        )
    17640               v-out-string = v-out-string
    17641                               + substitute(  "&1Рецепт: &2&1    &3 &4&1&1Ингредиенты:"
    17642                                           , chr(10)
    17643                                           , buf_fbr-recipe.recipe-code
    17644                                           , buf_fbr-recipe.qnty
    17645                                           , buf_fbr-recipe.recipe-qnty
    17646                                        )
    17647               .
    17648            for each buf_i_fbr-line no-lock
    17649               where buf_i_fbr-line.doc-code    = buf_fbr-line.doc-code
    17650               and buf_i_fbr-line.is-comp     = no
    17651               and buf_i_fbr-line.recipe-code = buf_fbr-line.recipe-code
    17652               on error undo, return error
    17653               :
    17654               assign
    17655                  v-out-string = v-out-string
    17656                                   + substitute(  "&1&2:  &3 &4 &5 &6 &7 &8 &9"
    17657                                               , chr(10)
    17658                                               , buf_i_fbr-line.artic
    17659                                               , buf_i_fbr-line.fact-qnty
    17660                                               , buf_i_fbr-line.coeff-value
    17661                                               , buf_i_fbr-line.coeff-waste
    17662                                               , buf_i_fbr-line.price-sum-rubl
    17663                                               , buf_i_fbr-line.price-sum-base
    17664                                               , buf_i_fbr-line.price-sum-vat-rubl
    17665                                               , buf_i_fbr-line.price-sum-vat-base
    17666                                           )
    17667                  .
    17668               find first buf_fbr-recipe-gds no-lock
    17669                  where buf_fbr-recipe-gds.doc-code      = buf_i_fbr-line.doc-code
    17670                  and buf_fbr-recipe-gds.recipe-code   = buf_i_fbr-line.recipe-code
    17671                  and buf_fbr-recipe-gds.prod-type     = buf_i_fbr-line.prod-type
    17672                  and buf_fbr-recipe-gds.prod-code     = buf_i_fbr-line.prod-code
    17673                  and buf_fbr-recipe-gds.artic         = buf_i_fbr-line.artic
    17674                  .
    17675               assign
    17676                  v-out-string = v-out-string
    17677                                   + substitute(  "&1 &2 &3 &4 &5 &6 &7 &8"
    17678                                               , chr(10)
    17679                                               , buf_fbr-recipe-gds.qnty
    17680                                               , buf_fbr-recipe-gds.calc-method
    17681                                               , buf_fbr-recipe-gds.coeff-value
    17682                                               , buf_fbr-recipe-gds.coeff-waste
    17683                                               , buf_fbr-recipe-gds.brutto-qnty
    17684                                               , buf_fbr-recipe-gds.recipe-qnty
    17685                                               , buf_fbr-recipe-gds.recipe-brutto-qnty
    17686                                             )
    17687                  .
    17688            end.
    17689         end.
    17690         message
    17691            v-out-string
    17692            view-as alert-box information
    17693            title "Строки документа производства."
    17694            .
    17695      end.
    17696   END PROCEDURE.
    17697   PROCEDURE UI-on :
    17698      def input param fnc as character no-undo.
    17699      define variable v-have-rights as logical no-undo.
    17700      do
    17701         on error undo, return error
    17702         :
    17703         run assign-obj-fbroperator in this-procedure no-error.
    17704         if error-status :error
    17705            then
    17706         do:
    17707            message
    17708               vss-workfile vss-revision vss-description
    17709               skip(1)
    17710               skip
    17711               "Невозможно отобразить имя оператора производства."
    17712               skip return-value
    17713               skip trim(error-status :get-message(1))
    17714               trim(error-status :get-message(2))
    17715               trim(error-status :get-message(3))
    17716               view-as alert-box warning.
    17717         end.
    17718         display
    17719            obj-fbroperator
    17720            with frame D-FBR-DOC.
    17721         find first flt-gds no-lock
    17722            where recid (flt-gds) = gds-rec
    17723            no-error.
    17724         if fnc = "enable"
    17725            then
    17726         do:
    17727            VIEW FRAME D-FBR-DOC.
    17728            enable
    17729               b-exit
    17730               b-lkp
    17731               b-help
    17732               b-recipe
    17733               b-gds
    17734               br-comp
    17735               br-ingr
    17736               rs-one-all
    17737               with frame D-FBR-DOC.
    17738            assign
    17739               b-add:MENU-MOUSE          = 1
    17740               b-del:MENU-MOUSE          = 1
    17741               b-rsrv:MENU-MOUSE         = 1
    17742               r-outs:MENU-MOUSE         = 1
    17743               frame D-FBR-DOC:title = substitute( "&1 &2 : &3   № &4  - &5"
    17744                                               , f-doc.obj-type
    17745                                               , string (f-doc.obj-code, ">>>>9")
    17746                                               , f-doc.status_
    17747                                               , f-doc.doc-code
    17748                                               , p-doc-mode
    17749                                           )
    17750               .
    17751            case rs-one-all :
    17752               when "goods"
    17753               then
    17754                  do:
    17755                     if available flt-gds
    17756                        then
    17757                     do:
    17758                     end.
    17759                     else
    17760                     do:
    17761                        message
    17762                           "Нет текущего товара для фильтрации ни в верхнем, ни в нижнем списке."
    17763                           view-as alert-box.
    17764                        assign
    17765                           rs-one-all = "all"
    17766                           .
    17767                        run UI-on ("enable").
    17768                     end.
    17769                  end.
    17770            end case.
    17771            assign
    17772               v-have-rights = yes
    17773               .
    17774            if f-doc.is-free = yes
    17775               then
    17776            do:
    17777   define variable vss-include-info121 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    17778   do:
    17779     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    17780       (input  v-cntxt-db-num
    17781       ,input  v-cntxt-userid
    17782       ,input  0
    17783       ,input  'actn_manufacturing_free-update':U
    17784       ,input  'object':U
    17785       ,input  f-doc.host-code
    17786       ,input  f-doc.obj-type
    17787       ,input  f-doc.obj-code
    17788       ,input  0
    17789       ,input  0
    17790       ,input  0
    17791       ,input  false
    17792       ,output v-have-rights
    17793       )  .
    17794   end.
    17795            end.
    17796            if f-doc.is-free = no
    17797               or f-doc.status_ = 'факт':U
    17798               or v-have-rights = no
    17799               or p-doc-mode      = 'ПРОСМОТР':U
    17800               then
    17801            do:
    17802               assign
    17803                  buf_comp_fbr-line.price-rubl :read-only         in browse br-comp = yes
    17804                  buf_comp_fbr-line.price-sum-vat-rubl :read-only in browse br-comp = yes
    17805                  .
    17806            end.
    17807            case p-doc-mode :
    17808               when 'ПРОСМОТР':U
    17809               then
    17810                  do:
    17811                     enable
    17812                        b-prev
    17813                        b-next
    17814                        with frame D-FBR-DOC.
    17815                  end.
    17816               when 'ИЗМЕНЕНИЕ':U
    17817               then
    17818                  do:
    17819                     if f-doc.status_ = 'новый':U
    17820                        then
    17821                     do:
    17822                        enable
    17823                           b-add
    17824                           b-chg
    17825                           b-del
    17826                           out-code
    17827                           r-outs
    17828                           b-calc-comp
    17829                           b-calc-ingr
    17830                           r-price
    17831                           r-fbroperator
    17832                           fi-pay-code
    17833                           r-pay
    17834                           b-add-marks
    17835                           with frame D-FBR-DOC.
    17836                        hide
    17837                           b-parts
    17838                           in frame D-FBR-DOC.
    17839                     end.
    17840                     if f-doc.status_ = 'разрешен':U
    17841                        then
    17842                     do:
    17843                        enable
    17844                           b-rsrv
    17845                           b-parts
    17846                           with frame D-FBR-DOC.
    17847                     end.
    17848                     if f-doc.status_ <> 'факт':U AND v-back-date then
    17849                     do:
    17850                        enable
    17851                           fact-date
    17852                           shift-sel
    17853                           when is-shift-on
    17854                           with frame D-FBR-DOC.
    17855                     end.
    17856                  end.
    17857            end case.
    17858            if rs-one-all = "type"
    17859               then
    17860            do:
    17861               disable
    17862                  b-add
    17863                  b-chg
    17864                  b-del
    17865                  out-code
    17866                  r-outs
    17867                  b-calc-comp
    17868                  b-calc-ingr
    17869                  b-rsrv
    17870                  r-fbroperator
    17871                  fi-pay-code
    17872                  fi-pay-type-name
    17873                  r-pay
    17874                  with frame D-FBR-DOC.
    17875               assign
    17876                  buf_ingr_fbr-line.fact-qnty:read-only           in browse br-ingr = yes
    17877                  buf_ingr_fbr-line.price-base:read-only          in browse br-ingr = yes
    17878                  buf_ingr_fbr-line.price-rubl:read-only          in browse br-ingr = yes
    17879                  buf_ingr_fbr-line.price-sum-vat-base:read-only  in browse br-ingr = yes
    17880                  buf_ingr_fbr-line.price-sum-vat-rubl:read-only  in browse br-ingr = yes
    17881                  buf_ingr_fbr-line.price-sale:read-only          in browse br-ingr = yes
    17882                  buf_ingr_fbr-line.is-calc:read-only             in browse br-ingr = yes
    17883                  buf_ingr_fbr-line.fix-cost:read-only            in browse br-ingr = yes
    17884                  buf_comp_fbr-line.is-calc:read-only             in browse br-comp = yes
    17885                  buf_comp_fbr-line.fix-cost:read-only            in browse br-comp = yes
    17886                  .
    17887            end.
    17888            else
    17889            do:
    17890               assign
    17891                  buf_ingr_fbr-line.fact-qnty:read-only in browse br-ingr          = (p-doc-mode = 'ПРОСМОТР':U or f-doc.status_ <> 'новый':U)
    17892                  buf_ingr_fbr-line.price-base:read-only in browse br-ingr         = yes
    17893                  buf_ingr_fbr-line.price-rubl:read-only in browse br-ingr         = yes
    17894                  buf_ingr_fbr-line.price-sum-vat-base:read-only in browse br-ingr = yes
    17895                  buf_ingr_fbr-line.price-sum-vat-rubl:read-only in browse br-ingr = yes
    17896                  buf_ingr_fbr-line.fix-cost:read-only in browse br-ingr           = (p-doc-mode = 'ПРОСМОТР':U or f-doc.status_ <> 'разрешен':U)
    17897                  buf_ingr_fbr-line.price-sale:read-only in browse br-ingr         = (p-doc-mode = 'ПРОСМОТР':U or f-doc.status_ <> 'новый':U)
    17898                  buf_ingr_fbr-line.is-calc:read-only in browse br-ingr            = buf_ingr_fbr-line.price-sale:read-only in browse br-ingr
    17899                  buf_comp_fbr-line.is-calc:read-only in browse br-comp            = buf_ingr_fbr-line.price-sale:read-only in browse br-ingr
    17900                  buf_comp_fbr-line.fix-cost:read-only in browse br-comp           = buf_ingr_fbr-line.fix-cost:read-only in browse br-ingr
    17901                  .
    17902            end.
    17903            if rs-one-all = "goods"
    17904               then
    17905            do:
    17906               disable
    17907                  b-add
    17908                  b-del
    17909                  with frame D-FBR-DOC.
    17910            end.
    17911   define variable vss-include-info122 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    17912   do:
    17913     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    17914       (input  v-cntxt-db-num
    17915       ,input  v-cntxt-userid
    17916       ,input  0
    17917       ,input  'actn_manufacturing_price-sale-ingr':U
    17918       ,input  'object':U
    17919       ,input  f-doc.host-code
    17920       ,input  f-doc.obj-type
    17921       ,input  f-doc.obj-code
    17922       ,input  0
    17923       ,input  0
    17924       ,input  0
    17925       ,input  false
    17926       ,output v-have-rights
    17927       )  .
    17928   end.
    17929            if v-have-rights = no
    17930               then
    17931            do:
    17932               assign
    17933                  buf_ingr_fbr-line.price-sale :read-only         in browse br-ingr = yes
    17934                  .
    17935            end.
    17936         end.
    17937         if f-doc.status_ = 'разрешен':U
    17938            then
    17939         do:
    17940            enable
    17941               b-parts
    17942               with frame D-FBR-DOC.
    17943         end.
    17944         display
    17945            rs-one-all
    17946            fi-pay-code
    17947            fi-pay-type-name
    17948            with frame D-FBR-DOC.
    17949         if r-outs:sensitive
    17950            then
    17951         do:
    17952            display
    17953               "" @ out-code
    17954               with frame D-FBR-DOC.
    17955         end.
    17956         else
    17957         do:
    17958            hide
    17959               out-code
    17960               r-outs
    17961               in frame D-FBR-DOC.
    17962         end.
    17963         if r-price:sensitive
    17964            then
    17965         do:
    17966            display
    17967               v-price-sale-obj-type + " " + string( v-price-sale-obj-code ) @ obj-price
    17968               with frame D-FBR-DOC.
    17969         end.
    17970         else
    17971         do:
    17972            hide
    17973               obj-price
    17974               r-price
    17975               in frame D-FBR-DOC.
    17976         end.
    17977         run open-comp in this-procedure.
    17978         run open-ingr in this-procedure ( input ( if avail buf_comp_fbr-line then buf_comp_fbr-line.recipe-code else ? ) ).
    17979         if v-fbr-doc-line-rec = ?
    17980            then
    17981         do:
    17982            if v-fbr-doc-rep-rec <> ?
    17983               and rs-one-all <> "all"
    17984               then
    17985            do:
    17986               assign
    17987                  rs-one-all = "all"
    17988                  .
    17989               run UI-on ("enable").
    17990            end.
    17991         end.
    17992         else
    17993         do:
    17994            reposition br-comp to recid (v-fbr-doc-line-rec) no-error.
    17995         end.
    17996         apply "value-changed" to br-comp in frame D-FBR-DOC.
    17997         apply "value-changed" to br-ingr in frame D-FBR-DOC.
    17998         apply "entry" to br-comp in frame D-FBR-DOC.
    17999         if available buf_comp_fbr-line then
    18000         do:
    18001            current-browse = br-comp :handle.
    18002         end.
    18003         else
    18004         do:
    18005            apply "entry" to br-ingr.
    18006            if available buf_ingr_fbr-line then
    18007            do:
    18008               current-browse = br-ingr :handle.
    18009            end.
    18010         end.
    18011         if v-fbr-doc-rep-rec <> ?
    18012            then
    18013         do:
    18014            reposition br-ingr to recid( v-fbr-doc-rep-rec ) no-error.
    18015         end.
    18016      end.
    18017   END PROCEDURE.
    18018   FUNCTION get-goods-name RETURNS CHARACTER
    18019      ( p-fbr-line-recid AS RECID ) :
    18020      define variable v-gds-name as character no-undo.
    18021      RUN get-goods-name-proc in this-procedure (
    18022         input p-fbr-line-recid
    18023         , output v-gds-name
    18024         ).
    18025      return ( v-gds-name ).
    18026   END FUNCTION.
    18027   FUNCTION get-line-OK RETURNS logical
    18028      ( p-fbr-line-recid AS RECID ) :
    18029      define variable v-line-ok as logical no-undo.
    18030      run get-line-OK-proc in this-procedure (
    18031         input p-fbr-line-recid
    18032         , output v-line-ok
    18033         ).
    18034      return v-line-ok.
    18035   END FUNCTION.
    18036   FUNCTION get-netto-qnty RETURNS DECIMAL
    18037      ( p-fbr-line-recid AS RECID ) :
    18038      define variable v-netto-qnty as decimal no-undo.
    18039      run get-netto-qnty-proc in this-procedure (
    18040         input p-fbr-line-recid
    18041         , output v-netto-qnty
    18042         ).
    18043      return v-netto-qnty.
    18044   END FUNCTION.
    18045   FUNCTION get-prod-ref RETURNS CHARACTER
    18046      ( p-fbr-line-recid AS RECID  ) :
    18047      define variable v-prog-string as character no-undo.
    18048      run get-prod-ref-proc in this-procedure (
    18049         input p-fbr-line-recid
    18050         , output v-prog-string
    18051         ).
    18052      return v-prog-string.
    18053   END FUNCTION.
    18054   FUNCTION get-unit-base RETURNS CHARACTER
    18055      (  p-fbr-line-recid AS RECID  ) :
    18056      define variable v-unit-base as character no-undo.
    18057      run get-unit-base-proc in this-procedure (
    18058         input p-fbr-line-recid
    18059         , output v-unit-base
    18060         ).
    18061      return v-unit-base.
    18062   END FUNCTION.
