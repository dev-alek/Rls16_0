    12293               comp-OK                                 :bgcolor in browse br-comp = gray_color
    12294               buf_comp_fbr-line.fact-qnty             :bgcolor in browse br-comp = gray_color
    12295               comp-unit                               :bgcolor in browse br-comp = gray_color
    12296               comp-prod                               :bgcolor in browse br-comp = gray_color
    12297               buf_comp_fbr-line.is-calc               :bgcolor in browse br-comp = gray_color
    12298               buf_comp_fbr-line.price-sale            :bgcolor in browse br-comp = gray_color
    12299               buf_comp_fbr-line.fix-cost              :bgcolor in browse br-comp = gray_color
    12300               buf_comp_fbr-line.price-rubl            :bgcolor in browse br-comp = gray_color
    12301               buf_comp_fbr-line.price-base            :bgcolor in browse br-comp = gray_color
    12302               buf_comp_fbr-line.price-sum-rubl        :bgcolor in browse br-comp = gray_color
