    13904                then recid(buf_ingr_fbr-line)
    13905                else ?
    13906               )
    13907        ).
    13908   end.
    13909   PROCEDURE sort-brbr-ingr :
    13910     define input parameter p-recid as recid no-undo .
    13911     if re-querybr-ingr = no then do:
    13912       assign
    13913          cur-clmnbr-ingr = br-ingr:current-column in frame D-FBR-DOC
    13914       .
    13915       if sort-clmnbr-ingr <> ? then sort-clmnbr-ingr:column-fgcolor = 0.
    13916       if cur-clmnbr-ingr = sort-clmnbr-ingr then do:
    13917         assign
    13918            sort-labelbr-ingr = ""
    13919            sort-clmnbr-ingr = ?
    13920         .
    13921        end.
    13922        else do:
    13923          assign
    13924            sort-labelbr-ingr = cur-clmnbr-ingr:label
    13925            sort-clmnbr-ingr  = cur-clmnbr-ingr
    13926            sort-clmnbr-ingr:column-fgcolor = 4
    13927          .
    13928        end.
    13929      end.
    13930     assign
    13931       cur-clmn-locbr-ingr = 1
    13932     .
    13933     def var column-handle as handle no-undo .
    13934     column-handle = br-ingr:first-column.
    13935     do while valid-handle(column-handle) :
    13936       if column-handle = cur-clmnbr-ingr then do:
    13937         leave .
    13938       end.
    13939       column-handle = column-handle:NEXT-COLUMN.
    13940       assign
    13941         cur-clmn-locbr-ingr = cur-clmn-locbr-ingr + 1
    13942       .
    13943     end.
    13944     case sort-labelbr-ingr:
    13945           when ingr-name:label in browse br-ingr then DO:   assign       ingr-sort-column-name = substitute('dynamic-function(&1get-goods-name&1,recid(buf_ingr_fbr-line))',chr(34))     .     run open-ingr (if avail buf_comp_fbr-line then buf_comp_fbr-line.recipe-code else ?).   . END.
    13946           when buf_ingr_fbr-line.trn-type:label in browse br-ingr then DO:    assign       ingr-sort-column-name = "buf_ingr_fbr-line.trn-type"     .     run open-ingr (if avail buf_comp_fbr-line then buf_comp_fbr-line.recipe-code else ?).   . END.
    13947           when ingr-OK:label in browse br-ingr then DO:   assign       ingr-sort-column-name = substitute('dynamic-function(&1get-line-OK&1,recid(buf_ingr_fbr-line))',chr(34))     .     run open-ingr (if avail buf_comp_fbr-line then buf_comp_fbr-line.recipe-code else ?).   . END.
    13948           when buf_ingr_fbr-line.fact-qnty:label in browse br-ingr then DO:    assign       ingr-sort-column-name = "buf_ingr_fbr-line.fact-qnty"     .     run open-ingr (if avail buf_comp_fbr-line then buf_comp_fbr-line.recipe-code else ?).   . END.
    13949           when ingr-unit:label in browse br-ingr then DO:   assign       ingr-sort-column-name = substitute('dynamic-function(&1get-unit-base&1,recid(buf_ingr_fbr-line))',chr(34))     .     run open-ingr (if avail buf_comp_fbr-line then buf_comp_fbr-line.recipe-code else ?).   . END.
    13950           when buf_ingr_fbr-line.is-calc:label in browse br-ingr then DO:    assign       ingr-sort-column-name = "buf_ingr_fbr-line.is-calc"     .     run open-ingr (if avail buf_comp_fbr-line then buf_comp_fbr-line.recipe-code else ?).   . END.
    13951           when buf_ingr_fbr-line.price-sale:label in browse br-ingr then DO:    assign       ingr-sort-column-name = "buf_ingr_fbr-line.price-sale"     .     run open-ingr (if avail buf_comp_fbr-line then buf_comp_fbr-line.recipe-code else ?).   . END.
    13952           when buf_ingr_fbr-line.fix-cost:label in browse br-ingr then DO:    assign       ingr-sort-column-name = "buf_ingr_fbr-line.fix-cost"     .     run open-ingr (if avail buf_comp_fbr-line then buf_comp_fbr-line.recipe-code else ?).   . END.
    13953           when buf_ingr_fbr-line.price-base:label in browse br-ingr then DO:    assign       ingr-sort-column-name = "buf_ingr_fbr-line.price-base"     .     run open-ingr (if avail buf_comp_fbr-line then buf_comp_fbr-line.recipe-code else ?).   . END.
    13954           when buf_ingr_fbr-line.price-rubl:label in browse br-ingr then DO:    assign       ingr-sort-column-name = "buf_ingr_fbr-line.price-rubl"     .     run open-ingr (if avail buf_comp_fbr-line then buf_comp_fbr-line.recipe-code else ?).   . END.
    13955           when buf_ingr_fbr-line.rsrv-qnty:label in browse br-ingr then DO:    assign       ingr-sort-column-name = "buf_ingr_fbr-line.rsrv-qnty"     .     run open-ingr (if avail buf_comp_fbr-line then buf_comp_fbr-line.recipe-code else ?).   . END.
    13956           when ingr-prod:label in browse br-ingr then DO:   assign       ingr-sort-column-name = substitute('dynamic-function(&1get-prod-ref&1,recid(buf_ingr_fbr-line))',chr(34))     .     run open-ingr (if avail buf_comp_fbr-line then buf_comp_fbr-line.recipe-code else ?).   . END.
    13957       otherwise do:
    13958         assign
    13959           ingr-sort-column-name = ""
    13960         .
    13961         run open-ingr (if avail buf_comp_fbr-line then buf_comp_fbr-line.recipe-code else ?).
    13962         if sort-labelbr-ingr <> "" then do:
    13963           assign
    13964             cur-clmnbr-ingr:column-fgcolor = 0
    13965           .
    13966         end.
    13967         assign
    13968           cur-clmn-locbr-ingr = ?
    13969         .
    13970       end.
    13971     end case.
    13972     if p-recid <> ? then do:
    13973       reposition br-ingr to recid p-recid no-error.
    13974       apply "value-changed" to br-ingr in frame D-FBR-DOC.
    13975     end.
    13976     apply "entry" to br-ingr in frame D-FBR-DOC.
    13977   END PROCEDURE.
    13978   procedure re-open-query-srt-clmnbr-ingr:
    13979   if cur-clmnbr-ingr = ? then do:
    13980      run open-ingr (if avail buf_comp_fbr-line then buf_comp_fbr-line.recipe-code else ?).
