     5212       ,input  buf_fbr-doc.obj-code
     5213       ,input  0
     5214       ,input  0
     5215       ,input  0
     5216       ,input  false
     5217       ,output v-have-rights
     5218       )  .
     5219   end.
     5220             end.
     5221             otherwise do:
     5222               message
     5223                 vss-workfile vss-revision vss-description skip
     5224                 "Неизвестный тип рецепта производства" skip
     5225                 "Тип рецепта" buf_fbr-recipe.recipe-type skip
     5226                 "Документ производства" buf_fbr-recipe.doc-code skip
     5227                 "Код рецепта" buf_fbr-recipe.recipe-code skip
     5228                 view-as alert-box error .
     5229               undo, return error return-value .
     5230             end.
     5231           end case .
     5232           if v-have-rights = no
     5233           then do:
     5234               message
     5235                   "Недостаточно прав для производства."
     5236                   skip(1) "Обратитесь к администратору."
     5237                   skip(1) return-value
     5238               view-as alert-box information.
     5239               run clear-temp-tables in this-procedure .
     5240               undo, return error.
     5241           end.
     5242           find first buf_fbr-line no-lock
     5243                where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     5244                  and buf_fbr-line.is-comp     = yes
     5245                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     5246           no-error.
     5247           if available buf_fbr-line
     5248           then do:
     5249               define buffer buf_change_fbr-line      for ub.fbr-line.
     5250               run writelog in this-procedure ( log-file-name, 3, "В документе уже есть выбранный рецепт." ).
     5251               if buf_start_temp_goods-qnty.need-qnty = ?
     5252               and v-is-manual-input = yes
     5253               then do:
     5254                   define variable v-old-fact-qnty  as decimal       no-undo.
     5255                   define variable v-old-price-sale as decimal       no-undo.
     5256                   assign
     5257                       v-old-fact-qnty  = buf_fbr-line.fact-qnty
     5258                       v-old-price-sale = buf_fbr-line.price-sale
     5259                   .
     5260                   run str/fbr-line.w (
     5261                         input p-fbrhist-handle
     5262                       , input buf_fbr-doc.status_
     5263                       , input p-fbr-doc-doc-code
     5264                       , input recid( buf_fbr-line )
     5265                       , input ?
     5266                       , output v-cancel
     5267                   ).
     5268                   if error-status :error
     5269                   or v-cancel = yes
     5270                   then do:
     5271                       find first buf_change_fbr-line exclusive-lock
     5272                            where buf_change_fbr-line.doc-code    = p-fbr-doc-doc-code
     5273                              and buf_change_fbr-line.is-comp     = yes
     5274                              and buf_change_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     5275                       .
     5276                       message
     5277                                vss-workfile vss-revision vss-description
     5278                           skip "Ошибка изменения строки."
     5279                           skip return-value
     5280                           skip trim(error-status :get-message(1))
     5281                                trim(error-status :get-message(2))
     5282                                trim(error-status :get-message(3))
     5283                           skip buf_change_fbr-line.fact-qnty
     5284                       view-as alert-box error.
     5285                       assign
     5286                           buf_change_fbr-line.fact-qnty  = v-old-fact-qnty
     5287                           buf_change_fbr-line.price-sale = v-old-price-sale
     5288                       .
     5289                       run clear-temp-tables in this-procedure.
     5290                       return.
     5291                   end.
     5292                   if buf_fbr-line.fact-qnty <= v-old-fact-qnty
     5293                   then do:
     5294                       define variable v-gds-name    as character    no-undo.
     5295   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5296   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     5297     (input  buf_fbr-line.artic
     5298     ,input  buf_fbr-line.prod-type
     5299     ,input  buf_fbr-line.prod-code
     5300     ,output v-gds-name
     5301     )  .
     5302                       message
     5303                                "Для производства товаров документа необходимо"
     5304                           skip "большее количество товара, чем было добавлено."
     5305                           skip "Количество товара в документе будет восстановлено."
     5306                           skip(1)
     5307                           skip "Товар: " buf_fbr-line.artic v-gds-name
     5308                           skip "Количество в строке документа производства:" v-old-fact-qnty
     5309                           skip "Новое количество:" buf_fbr-line.fact-qnty
     5310                       view-as alert-box information
     5311                       title "Изменение строки документа производства".
     5312                       find first buf_change_fbr-line exclusive-lock
     5313                            where buf_change_fbr-line.doc-code    = p-fbr-doc-doc-code
     5314                              and buf_change_fbr-line.is-comp     = yes
     5315                              and buf_change_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     5316                       .
     5317                       assign
     5318                           buf_change_fbr-line.fact-qnty  = v-old-fact-qnty
     5319                           buf_change_fbr-line.price-sale = v-old-price-sale
     5320                       .
     5321                       delete buf_start_temp_goods-qnty.
     5322                   end.
     5323                   else do:
     5324                       find first buf_change_fbr-line exclusive-lock
     5325                            where buf_change_fbr-line.doc-code    = p-fbr-doc-doc-code
     5326                              and buf_change_fbr-line.is-comp     = yes
     5327                              and buf_change_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     5328                       .
     5329                       assign
     5330                           buf_start_temp_goods-qnty.need-qnty  = buf_fbr-line.fact-qnty
     5331                           buf_start_temp_goods-qnty.calculated = no
     5332                           buf_change_fbr-line.fact-qnty     = 0
     5333                       .
     5334                   end.
     5335                   run test-temp-tables in this-procedure ( "Товар добавлять не надо - параметр fbr-frcp=yes, но введенное в диалоге количество меньше необходимого." ).
     5336                   find first buf_start_temp_goods-qnty
     5337                        where buf_start_temp_goods-qnty.calculated = no
     5338                   no-error.
     5339                   next calc-not-calculated-goods.
     5340               end.
     5341               else do:
     5342                   find first buf_change_fbr-line exclusive-lock
     5343                        where buf_change_fbr-line.doc-code    = p-fbr-doc-doc-code
     5344                          and buf_change_fbr-line.is-comp     = yes
     5345                          and buf_change_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     5346                   .
     5347                   assign
     5348                       buf_start_temp_goods-qnty.need-qnty  = buf_start_temp_goods-qnty.need-qnty + buf_fbr-line.fact-qnty
     5349                       buf_change_fbr-line.fact-qnty        = buf_start_temp_goods-qnty.need-qnty
     5350                   .
     5351                   if buf_start_temp_goods-qnty.recipe-code <> "":U
     5352                   then do:
     5353                       assign
     5354                           buf_start_temp_goods-qnty.calculated = no
     5355                       .
     5356                   end.
     5357               end.
     5358               run writelog in this-procedure ( log-file-name, 3, substitute( "Изменена рассчитанная строка документа. Новое количество &1", buf_fbr-line.fact-qnty ) ).
     5359           end.
     5360           run fbrlib-get-trn-type in this-procedure (
     5361                 input buf_fbr-recipe.recipe-code
     5362               , input recid( buf_goods )
     5363               , input ( if buf_start_temp_goods-qnty.trn-type = ?
     5364                         then ?
     5365                         else ( if buf_start_temp_goods-qnty.trn-type = 'при':U
     5366                                then yes
     5367                                else no ) )
     5368               , output v-is-comp
     5369               , output v-trn-type
     5370           ).
     5371           assign
     5372               buf_start_temp_goods-qnty.trn-type = v-trn-type
     5373           .
     5374           run str/fbr-crln.p (
     5375                 input p-mainmenu-handle
     5376               , input recid( buf_fbr-doc )
     5377               , input recid( buf_goods )
     5378               , input buf_fbr-recipe.recipe-code
     5379               , input v-trn-type
     5380               , input v-is-comp
     5381               , input yes
     5382               , input buf_fbr-doc.obj-type
     5383               , input buf_fbr-doc.obj-code
     5384               , output v-fbr-line-recid
     5385           ).
     5386           if buf_start_temp_goods-qnty.need-qnty = ?
     5387           then do:
     5388               find first tt-marking-lines no-error .
     5389               if available tt-marking-lines
     5390               then do :
     5391                 assign v-mark-qnty = 0 .
     5392                 for first buf_fbr-line no-lock where recid(buf_fbr-line) = v-fbr-line-recid,
     5393                 first buf_goods no-lock where buf_goods.artic     = buf_fbr-line.artic
     5394                                           and buf_goods.prod-type = buf_fbr-line.prod-type
     5395                                           and buf_goods.prod-code = buf_fbr-line.prod-code,
     5396                 each tt-marking-lines where tt-marking-lines.gds-code = buf_goods.gds-code
     5397                 :
     5398                   assign v-mark-qnty = v-mark-qnty + tt-marking-lines.box-qnty .
     5399                 end .
     5400               end .
     5401               run str/fbr-line.w (
     5402                     input p-fbrhist-handle
     5403                   , input buf_fbr-doc.status_
     5404                   , input p-fbr-doc-doc-code
     5405                   , input v-fbr-line-recid
     5406                   , input v-mark-qnty
     5407                   , output v-cancel
     5408               ) no-error.
     5409               if error-status :error
     5410               or v-cancel = yes
     5411               then do:
     5412                   find first buf_fbr-line exclusive-lock
     5413                        where recid( buf_fbr-line ) = v-fbr-line-recid
     5414                   .
     5415                   for first buf_goods no-lock where buf_goods.artic     = buf_fbr-line.artic
     5416                                             and buf_goods.prod-type = buf_fbr-line.prod-type
     5417                                             and buf_goods.prod-code = buf_fbr-line.prod-code,
     5418                   each tt-marking-lines where tt-marking-lines.gds-code = buf_goods.gds-code
     5419                   :
     5420                     for first buf_marking exclusive-lock where buf_marking.mark begins tt-marking-lines.mark :
     5421                       assign
     5422                         buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB
     5423                       .
     5424                     end .
     5425                   end .
     5426                   delete buf_fbr-line.
     5427                   run clear-temp-tables in this-procedure.
     5428                   return.
     5429               end.
     5430               for first buf_fbr-line no-lock where recid(buf_fbr-line) = v-fbr-line-recid,
     5431               first buf_goods no-lock where buf_goods.artic     = buf_fbr-line.artic
     5432                                         and buf_goods.prod-type = buf_fbr-line.prod-type
     5433                                         and buf_goods.prod-code = buf_fbr-line.prod-code,
     5434               each tt-marking-lines where tt-marking-lines.gds-code = buf_goods.gds-code
     5435               :
     5436                 create buf_marking-lines .
     5437                 assign
     5438                   buf_marking-lines.mark      = tt-marking-lines.mark
     5439                   buf_marking-lines.obj-type  = buf_fbr-doc.obj-type
     5440                   buf_marking-lines.obj-code  = buf_fbr-doc.obj-code
     5441                   buf_marking-lines.gds-code  = buf_goods.gds-code
     5442                   buf_marking-lines.in-code   = "manufacturing"
     5443                   buf_marking-lines.out-code  = buf_fbr-line.doc-code
     5444                   buf_marking-lines.part-code = buf_fbr-line.recipe-code
     5445                   buf_marking-lines.prt-code  = 0
     5446                   buf_marking-lines.doc-level = 1
     5447                 .
     5448               end .
     5449               find first buf_fbr-line exclusive-lock
     5450                    where recid( buf_fbr-line ) = v-fbr-line-recid
     5451               .
     5452               if p-same-good = yes
     5453               then do:
     5454                   if p-autofbr = yes
     5455                   then do:
     5456                       assign
     5457                           v-yesno = yes
     5458                       .
     5459                   end.
     5460                   else do:
     5461                       message
     5462                                "Товар уже есть в документе."
     5463                           skip "Вы можете добавить введенное количество в строку документа,"
     5464                           skip "изменить количество в документе на введенное"
     5465                           skip "или отменить добавление товара, оставив рецепт без изменений"
     5466                           skip(1)
     5467                           skip "Артикул товара:        " buf_start_temp_goods-qnty.artic
     5468                           skip "Количество в документе:" p-same-good-old-qnty
     5469                           skip(1)
     5470                           skip "Добавить в строку?"
     5471                       view-as alert-box question
     5472                       buttons yes-no-cancel
     5473                       title "Добавление товара"
     5474                       update v-yesno.
     5475                       if v-yesno = ?
     5476                       then do:
     5477                           assign
     5478                               buf_start_temp_goods-qnty.need-qnty   = p-same-good-old-qnty
     5479                               buf_start_temp_goods-qnty.calculated  = yes
     5480                           .
     5481                           run writelog in this-procedure ( log-file-name, 3, substitute( "Товар уже есть в документе. Расчитанная строка документа оставлена без изменений. Количество &1", buf_start_temp_goods-qnty.need-qnty ) ).
     5482                           run test-temp-tables in this-procedure ( "Добавили товар." ).
     5483                           find first buf_start_temp_goods-qnty
     5484                                where buf_start_temp_goods-qnty.calculated = no
     5485                           no-error.
     5486                           next calc-not-calculated-goods.
     5487                       end.
     5488                   end.
     5489                   assign
     5490                       buf_start_temp_goods-qnty.calculated  = no
     5491                   .
     5492                   if v-yesno = yes
     5493                   then do:
     5494                       assign
     5495                           buf_fbr-line.fact-qnty = buf_fbr-line.fact-qnty + p-same-good-old-qnty
     5496                       .
     5497                   end.
     5498                   run writelog in this-procedure ( log-file-name, 3, substitute( "Товар уже есть в документе. Количество в рассчитанной строке документа изменено на &1", buf_fbr-line.fact-qnty ) ).
     5499               end.
     5500               assign
     5501                   buf_start_temp_goods-qnty.recipe-code = buf_fbr-line.recipe-code
     5502                   buf_start_temp_goods-qnty.need-qnty   = buf_fbr-line.fact-qnty
     5503                   buf_start_temp_goods-qnty.trn-type    = buf_fbr-line.trn-type
     5504               .
     5505           end.
     5506           run writelog in this-procedure ( log-file-name, 2, "Идем по ингредиентам товара." ).
     5507           for each buf_fbr-recipe-gds no-lock
     5508              where buf_fbr-recipe-gds.doc-code    = buf_fbr-recipe.doc-code
     5509                and buf_fbr-recipe-gds.recipe-code = buf_fbr-recipe.recipe-code
     5510           on error undo, return error
     5511           :
     5512               find first buf_goods no-lock
     5513                    where buf_goods.artic      = buf_fbr-recipe-gds.artic
     5514                      and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     5515                      and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     5516               .
     5517               assign
     5518                   v-is-comp = no
     5519                   v-trn-type = ( if buf_start_temp_goods-qnty.trn-type = 'при':U then 'спи':U else 'при':U )
     5520               .
     5521               run str/fbr-crln.p (
     5522                     input p-mainmenu-handle
     5523                   , input recid( buf_fbr-doc )
     5524                   , input recid( buf_goods )
     5525                   , input buf_fbr-recipe.recipe-code
     5526                   , input v-trn-type
     5527                   , input v-is-comp
     5528                   , input yes
     5529                   , input buf_fbr-doc.obj-type
     5530                   , input buf_fbr-doc.obj-code
     5531                   , output v-fbr-line-recid
     5532               ).
     5533               find first buf_fbr-line no-lock
     5534                    where recid( buf_fbr-line ) = v-fbr-line-recid
     5535               .
     5536               run writelog in this-procedure ( log-file-name, 3, substitute( "Создана строка ингредиента с артикулом '&1'", buf_fbr-line.artic ) ).
     5537           end.
     5538           run writelog in this-procedure ( log-file-name, 2, substitute( "Упорядочивание рецептов. Идем по рецептам с последнего." ) ).
     5539           run fbrlib-put-in-order-recipe in this-procedure (
     5540               input buf_fbr-doc.doc-code
     5541           ) no-error.
     5542           if error-status :error
     5543           then do:
     5544               for each buf_del_temp_goods-qnty
     5545               :
     5546                   delete buf_del_temp_goods-qnty.
     5547               end.
     5548               undo, return error.
     5549           end.
     5550           find last temp_recipe-order.
     5551           calc-all-recipes:
     5552           do while available temp_recipe-order
     5553           :
     5554               run writelog in this-procedure ( log-file-name, 3, substitute( "Обработка рецепта номер: &1", temp_recipe-order.recipe-code ) ).
     5555               find first buf_comp_fbr-line exclusive-lock
     5556                    where buf_comp_fbr-line.doc-code    = p-fbr-doc-doc-code
     5557                      and buf_comp_fbr-line.is-comp     = yes
     5558                      and buf_comp_fbr-line.recipe-code = temp_recipe-order.recipe-code
     5559               .
     5560               find first buf_temp_goods-qnty
     5561                    where buf_temp_goods-qnty.artic        = buf_comp_fbr-line.artic
     5562                      and buf_temp_goods-qnty.prod-type    = buf_comp_fbr-line.prod-type
     5563                      and buf_temp_goods-qnty.prod-code    = buf_comp_fbr-line.prod-code
     5564                      and buf_temp_goods-qnty.recipe-code  = buf_comp_fbr-line.recipe-code
     5565               no-error.
     5566               if not available buf_temp_goods-qnty
     5567               or buf_temp_goods-qnty.calculated = no
     5568               then do:
     5569                   run writelog in this-procedure ( log-file-name, 4, "Товар рецепта не рассчитан. Рассчитываем." ).
     5570                   if available buf_temp_goods-qnty
     5571                   and buf_temp_goods-qnty.need-qnty <> buf_comp_fbr-line.fact-qnty
     5572                   then do:
     5573                       assign
     5574                           buf_comp_fbr-line.fact-qnty = buf_temp_goods-qnty.need-qnty
     5575                       .
     5576                       run writelog in this-procedure ( log-file-name, 5, substitute( "Прописываем количество в строку составного товара: &1", buf_comp_fbr-line.fact-qnty  ) ).
     5577                   end.
     5578                   run str/fbr-qnty.p (
     5579                         input p-mainmenu-handle
     5580                       , input p-fbrhist-handle
     5581                       , input recid( buf_fbr-doc )
     5582                       , input recid( buf_comp_fbr-line )
     5583                       , input no
     5584                       , input "ingr"
     5585                       , input no
     5586                       , input p-price-sale-obj-type
     5587                       , input p-price-sale-obj-code
     5588                       , input yes
     5589                       , input p-autofbr
     5590                       , input p-have-store
     5591                       , output v-need-goods
     5592                       , output v-need-goods-list
     5593                       , output v-need-goods-qnty-list
     5594                   ).
     5595                   if p-add-childs  = yes
     5596                   and v-need-goods = yes
     5597                   then do:
     5598                       do v-counter = 1 to num-entries( v-need-goods-list ) / 2
     5599                       :
     5600                           run add-new-recipe in this-procedure (
     5601                                 input p-mainmenu-handle
     5602                               , input buf_fbr-doc.doc-code
     5603                               , input entry( 2 * v-counter, v-need-goods-list )
     5604                               , input integer( entry( 2 * v-counter - 1 , v-need-goods-list ) )
     5605                               , input decimal( entry( v-counter, v-need-goods-qnty-list ) )
     5606                               , input p-autofbr
     5607                               , input p-have-store
     5608                           ).
     5609                       end.
     5610                       leave calc-all-recipes.
     5611                   end.
     5612               end.
     5613               find prev temp_recipe-order no-error.
     5614           end.
     5615           assign
     5616               buf_start_temp_goods-qnty.calculated = yes
     5617           .
     5618           if buf_start_temp_goods-qnty.recipe-type = 'разделка':U
     5619           or ( buf_start_temp_goods-qnty.recipe-type = 'комплектация':U
     5620                and buf_start_temp_goods-qnty.trn-type = 'спи':U )
     5621           then do:
     5622               run fill-temp-dressing-ingr in this-procedure (
     5623                     input buf_fbr-doc.doc-code
     5624                   , input buf_start_temp_goods-qnty.recipe-code
     5625               ).
     5626           end.
     5627           run test-temp-tables in this-procedure ( "Добавили товар." ).
     5628           find first buf_start_temp_goods-qnty
     5629                where buf_start_temp_goods-qnty.calculated = no
     5630           no-error.
     5631       end.
     5632   end.
     5633   END PROCEDURE.
     5634   PROCEDURE clear-temp-tables :
     5635   do
     5636   on error undo, return error
     5637   :
     5638       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     5639       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     5640       for each buf_temp_goods-qnty
     5641       on error undo, return error
     5642       :
     5643           delete buf_temp_goods-qnty.
     5644       end.
     5645       for each buf_temp_dressing-ingr
     5646       on error undo, return error
     5647       :
     5648           delete buf_temp_dressing-ingr.
     5649       end.
     5650   end.
     5651   END PROCEDURE.
     5652   PROCEDURE copy-recipe-in-doc :
     5653   define input parameter p-doc-code       as character             no-undo.
     5654   define input parameter p-recipe-code    as character             no-undo.
     5655   define input parameter p-obj-date       as date                  no-undo.
     5656   define input parameter p-obj-type       like ub.clients.obj-type no-undo.
     5657   define input parameter p-obj-code       like ub.clients.obj-code no-undo.
     5658       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     5659       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     5660       define buffer buf_recipe            for ub.recipe.
     5661       define buffer buf_recipe-gds        for ub.recipe-gds.
     5662   do
     5663   for buf_fbr-recipe
     5664     , buf_fbr-recipe-gds
     5665     , buf_recipe
     5666     , buf_recipe-gds
     5667   on error undo, return error return-value
     5668   :
     5669   find first buf_recipe no-lock
     5670        where buf_recipe.recipe-code = p-recipe-code
     5671   .
     5672   find first buf_fbr-recipe exclusive-lock
     5673        where buf_fbr-recipe.doc-code      = p-doc-code
     5674          and buf_fbr-recipe.recipe-code   = p-recipe-code
     5675   no-error.
     5676   if not available buf_fbr-recipe
     5677   then do:
     5678     create buf_fbr-recipe.
     5679     assign
     5680       buf_fbr-recipe.doc-code     = p-doc-code
     5681       buf_fbr-recipe.recipe-code  = p-recipe-code
     5682       buf_fbr-recipe.recipe-type  = buf_recipe.recipe-type
     5683     .
     5684     for each buf_recipe-gds exclusive-lock
     5685        where buf_recipe-gds.recipe-code = p-recipe-code
     5686     on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
     5687           run fbrlib_create-fbr-recipe-gds in this-procedure (
     5688                 input p-doc-code
     5689               , input buf_recipe-gds.recipe-code
     5690               , input buf_recipe-gds.prod-type
     5691               , input buf_recipe-gds.prod-code
     5692               , input buf_recipe-gds.artic
     5693               , input buf_recipe-gds.gds-code
     5694               , input buf_recipe-gds.is-waste
     5695               , input buf_recipe-gds.proc-number
     5696               , input p-obj-date
     5697               , input p-obj-type
     5698               , input p-obj-code
     5699               , input buf_recipe-gds.calc-method
     5700               , input buf_recipe-gds.coeff-waste
     5701               , input buf_recipe-gds.qnty
     5702               , input buf_recipe-gds.brutto-qnty
     5703         ) no-error.
     5704         if error-status:error
     5705         then do:
     5706               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     5707         end.
     5708     end.
     5709     buffer-copy buf_recipe to buf_fbr-recipe.
     5710   end.
     5711   end.
     5712   END PROCEDURE.
     5713   PROCEDURE fill-temp-dressing-ingr :
     5714   do
     5715   on error undo, return error
     5716   :
     5717   define input parameter p-doc-code       as character    no-undo.
     5718   define input parameter p-recipe-code    as character    no-undo.
     5719       define variable v-free-qnty     as decimal       no-undo.
     5720       define buffer buf_fbr-doc               for ub.fbr-doc.
     5721       define buffer buf_c_fbr-line            for ub.fbr-line.
     5722       define buffer buf_i_fbr-line            for ub.fbr-line.
     5723       define buffer buf_i_other_fbr-line      for ub.fbr-line.
     5724       define buffer buf_goods                 for ub.goods.
     5725       define buffer buf_recipe                for ub.fbr-recipe.
     5726       define buffer buf_recipe-gds            for ub.fbr-recipe-gds.
     5727       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     5728       find first buf_fbr-doc no-lock
     5729            where buf_fbr-doc.doc-code = p-doc-code
     5730       .
     5731       find first buf_recipe no-lock
     5732            where buf_recipe.doc-code    = p-doc-code
     5733              and buf_recipe.recipe-code = p-recipe-code
     5734       .
     5735       find first buf_c_fbr-line no-lock
     5736            where buf_c_fbr-line.doc-code    = p-doc-code
     5737              and buf_c_fbr-line.is-comp     = yes
     5738              and buf_c_fbr-line.recipe-code = p-recipe-code
     5739       .
     5740       if buf_recipe.recipe-type <> 'разделка':U
     5741       and ( buf_recipe.recipe-type <> 'комплектация':U
     5742            or buf_c_fbr-line.trn-type <> 'спи':U )
     5743       then do:
     5744           message
     5745                    vss-workfile vss-revision vss-description
     5746               skip "Процедура fill-temp-dressing-ingr применима только к рецептам разделки и разукомплектации."
     5747               skip return-value
     5748           view-as alert-box error.
     5749           undo, return error .
     5750       end.
     5751       for each buf_temp_dressing-ingr
     5752       :
     5753           delete buf_temp_dressing-ingr.
     5754       end.
     5755       for each buf_i_fbr-line no-lock
     5756          where buf_i_fbr-line.doc-code    = p-doc-code
     5757            and buf_i_fbr-line.is-comp     = no
     5758            and buf_i_fbr-line.recipe-code = p-recipe-code
     5759       on error undo, return error
     5760       :
     5761           find first buf_goods no-lock
     5762                where buf_goods.artic      = buf_i_fbr-line.artic
     5763                  and buf_goods.prod-type  = buf_i_fbr-line.prod-type
     5764                  and buf_goods.prod-code  = buf_i_fbr-line.prod-code
     5765           .
     5766           find first buf_temp_dressing-ingr
     5767                where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     5768                  and buf_temp_dressing-ingr.gds-code    = buf_goods.gds-code
     5769           no-error.
     5770           if not available buf_temp_dressing-ingr
     5771           then do:
     5772               create buf_temp_dressing-ingr.
     5773               assign
     5774                   buf_temp_dressing-ingr.recipe-code  = p-recipe-code
     5775                   buf_temp_dressing-ingr.gds-code     = buf_goods.gds-code
     5776                   buf_temp_dressing-ingr.used-qnty    = 0
     5777                   buf_temp_dressing-ingr.line-qnty    = 0
     5778                   buf_temp_dressing-ingr.recipe-qnty  = 0
     5779               .
     5780           end.
     5781           run fbrrest-get-free-qnty in this-procedure (
     5782                 input buf_fbr-doc.obj-type
     5783               , input buf_fbr-doc.obj-code
     5784               , input buf_goods.gds-code
     5785               , input no
     5786               , output v-free-qnty
     5787           ).
     5788           find first buf_recipe-gds no-lock
     5789                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     5790                  and buf_recipe-gds.recipe-code = p-recipe-code
     5791                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     5792                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     5793                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     5794           .
     5795           for each buf_i_other_fbr-line no-lock
     5796              where buf_i_other_fbr-line.doc-code    = p-doc-code
     5797                and buf_i_other_fbr-line.is-comp     = no
     5798                and buf_i_other_fbr-line.recipe-code <> p-recipe-code
     5799                and buf_i_other_fbr-line.artic       = buf_i_fbr-line.artic
     5800                and buf_i_other_fbr-line.prod-type   = buf_i_fbr-line.prod-type
     5801                and buf_i_other_fbr-line.prod-code   = buf_i_fbr-line.prod-code
     5802           :
     5803               assign
     5804                   buf_temp_dressing-ingr.line-qnty    = buf_temp_dressing-ingr.line-qnty
     5805                                                           + buf_i_other_fbr-line.fact-qnty
     5806               .
     5807           end.
     5808           if available buf_temp_dressing-ingr
     5809           then do:
     5810               assign
     5811                   buf_temp_dressing-ingr.used-qnty = buf_temp_dressing-ingr.line-qnty - v-free-qnty
     5812               .
     5813           end.
     5814       end.
     5815       for each buf_temp_dressing-ingr
     5816          where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     5817       :
     5818           find first buf_goods no-lock
     5819                where buf_goods.gds-code = buf_temp_dressing-ingr.gds-code
     5820           .
     5821           for each buf_i_other_fbr-line no-lock
     5822              where buf_i_other_fbr-line.doc-code    = p-doc-code
     5823                and buf_i_other_fbr-line.is-comp     = no
     5824                and buf_i_other_fbr-line.recipe-code = buf_temp_dressing-ingr.recipe-code
     5825                and buf_i_other_fbr-line.artic       = buf_goods.artic
     5826                and buf_i_other_fbr-line.prod-type   = buf_goods.prod-type
     5827                and buf_i_other_fbr-line.prod-code   = buf_goods.prod-code
     5828           on error undo, return error
     5829           :
     5830               assign
     5831                   buf_temp_dressing-ingr.recipe-qnty = buf_temp_dressing-ingr.recipe-qnty
     5832                                                       + buf_i_other_fbr-line.fact-qnty
     5833               .
     5834           end.
     5835       end.
     5836   end.
     5837   END PROCEDURE.
     5838   PROCEDURE test-temp-tables :
     5839       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     5840       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     5841   do
     5842   on error undo, return error
     5843   :
     5844   define input parameter p-title  as character    no-undo.
     5845   define variable v-str               as character        no-undo.
     5846       assign
     5847           v-str = p-title + " temp_goods-qnty:"
     5848       .
     5849       run writelog in this-procedure (  log-file-name, 0, v-str ).
     5850       for each buf_temp_goods-qnty
     5851       on error undo, return error
     5852       :
     5853           assign
     5854               v-str   = string( buf_temp_goods-qnty.gds-code )
     5855                       + "   " + ( if buf_temp_goods-qnty.recipe-type = ? then "?" else string( buf_temp_goods-qnty.recipe-type ) )
     5856                       + "   " + ( if buf_temp_goods-qnty.recipe-code = ? then "?" else string( buf_temp_goods-qnty.recipe-code ) )
     5857                       + "   " + ( if buf_temp_goods-qnty.trn-type = ?    then "?" else string( buf_temp_goods-qnty.trn-type ) )
     5858                       + "   " + ( if buf_temp_goods-qnty.need-qnty = ?   then "?" else string( buf_temp_goods-qnty.need-qnty ) )
     5859                       + "   " + string( buf_temp_goods-qnty.calculated )
     5860           .
     5861           run writelog in this-procedure (  log-file-name, 1, v-str ).
     5862       end.
     5863       assign
     5864           v-str = "        temp_dressing-ingr:"
     5865       .
     5866       run writelog in this-procedure (  log-file-name, 0, v-str ).
     5867       for each buf_temp_dressing-ingr
     5868       on error undo, return error
     5869       :
     5870           assign
     5871               v-str   = string( buf_temp_dressing-ingr.recipe-code  )
     5872                       + "   " + string( buf_temp_dressing-ingr.gds-code )
     5873                       + "   " + ( if buf_temp_dressing-ingr.line-qnty = ?   then "?" else string( buf_temp_dressing-ingr.line-qnty ) )
     5874                       + "   " + ( if buf_temp_dressing-ingr.used-qnty = ?   then "?" else string( buf_temp_dressing-ingr.used-qnty ) )
     5875                       + "   " + ( if buf_temp_dressing-ingr.recipe-qnty = ? then "?" else string( buf_temp_dressing-ingr.recipe-qnty ) )
     5876           .
     5877           run writelog in this-procedure (  log-file-name, 1, v-str ).
     5878       end.
     5879   end.
     5880   END PROCEDURE.
     5881   PROCEDURE add-new-recipe :
     5882   do
     5883   on error undo, return error
     5884   :
     5885   define input parameter p-mainmenu-handle    as handle           no-undo.
     5886   define input parameter p-doc-code           as character        no-undo.
     5887   define input parameter p-trn-type           as character        no-undo.
     5888   define input parameter p-gds-code           as integer          no-undo.
     5889   define input parameter p-need-qnty          as decimal          no-undo.
     5890   define input parameter p-autofbr            as logical          no-undo.
     5891   define input parameter p-have-store         as logical          no-undo.
     5892       define variable v-comp-gds-code         as integer          no-undo.
     5893       define variable v-comp-trn-type         as character        no-undo.
     5894       define variable v-comp-need-qnty        as decimal          no-undo.
     5895       define variable v-comp-recipe-type      as character        no-undo.
     5896       define variable v-comp-recipe-code      as character        no-undo.
     5897       define variable v-comp-recipe-found     as logical          no-undo.
     5898       define variable v-ext-comp-recipe-type  as character        no-undo.
     5899       define variable v-no-add-good           as logical          no-undo.
     5900       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     5901       define buffer buf_new_temp_goods-qnty   for temp_goods-qnty.
     5902       define buffer buf_goods                 for ub.goods.
     5903       define buffer buf_fbr-line              for ub.fbr-line.
     5904       define buffer buf_fbr-doc               for ub.fbr-doc.
     5905       define variable v-value          as character no-undo .
     5906       define variable v-type           as character no-undo .
     5907       define variable v-attr-value     as character no-undo .
     5908       define variable v-attr-value-rec as character no-undo .
     5909       define variable v-attr-type      as character no-undo .
     5910       define variable v-ban-recipes as logical no-undo .
     5911       define variable v-ban-altr    as logical no-undo .
     5912       if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsBanRecipes then v-ban-recipes = true .
     5913       if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsBanAltr then v-ban-altr = true .
     5914       find first buf_fbr-doc no-lock
     5915            where buf_fbr-doc.doc-code = p-doc-code
     5916       .
     5917       run extend-noweight-gds-qnty in this-procedure (
     5918             input p-gds-code
     5919           , input p-need-qnty
     5920           , output p-need-qnty
     5921       ).
     5922       run select-recipe in this-procedure (
     5923             input p-mainmenu-handle
     5924           , input buf_fbr-doc.obj-type
     5925           , input buf_fbr-doc.obj-code
     5926           , input p-gds-code
     5927           , input p-trn-type
     5928           , input p-need-qnty
     5929           , input p-autofbr
     5930           , input p-have-store
     5931           , output v-comp-gds-code
     5932           , output v-comp-trn-type
     5933           , output v-comp-need-qnty
     5934           , output v-comp-recipe-type
     5935           , output v-comp-recipe-code
     5936           , output v-comp-recipe-found
     5937           , output v-no-add-good
     5938       ) no-error.
     5939       if not error-status :error
     5940       and v-comp-recipe-found = yes
     5941       and v-no-add-good       = no
     5942       then do:
     5943           find first buf_goods no-lock
     5944                where buf_goods.gds-code = v-comp-gds-code
     5945           .
     5946           assign
     5947               v-ext-comp-recipe-type = v-comp-recipe-type
     5948           .
     5949           if v-comp-recipe-type = 'комплектация':U
     5950           and v-comp-trn-type   = 'спи':U
     5951           then do:
     5952               assign
     5953                   v-ext-comp-recipe-type = 'разделка':U
     5954               .
     5955           end.
     5956           case v-ext-comp-recipe-type
     5957           :
     5958               when 'разделка':U
     5959               then do:
     5960                   find first buf_temp_goods-qnty
     5961                        where buf_temp_goods-qnty.gds-code    = v-comp-gds-code
     5962                          and buf_temp_goods-qnty.recipe-code = v-comp-recipe-code
     5963                   no-error.
     5964                   if not available buf_temp_goods-qnty
     5965                   then do:
     5966                       create buf_temp_goods-qnty.
     5967                       assign
     5968                           buf_temp_goods-qnty.gds-code    = v-comp-gds-code
     5969                           buf_temp_goods-qnty.recipe-type = v-comp-recipe-type
     5970                           buf_temp_goods-qnty.recipe-code = v-comp-recipe-code
     5971                           buf_temp_goods-qnty.artic       = buf_goods.artic
     5972                           buf_temp_goods-qnty.prod-type   = buf_goods.prod-type
     5973                           buf_temp_goods-qnty.prod-code   = buf_goods.prod-code
     5974                           buf_temp_goods-qnty.trn-type    = v-comp-trn-type
     5975                           buf_temp_goods-qnty.need-qnty   = v-comp-need-qnty
     5976                           buf_temp_goods-qnty.calculated  = no
     5977                       .
     5978                   end.
     5979                   else do:
     5980                       find first buf_goods no-lock
     5981                            where buf_goods.gds-code = p-gds-code
     5982                       .
     5983                       find first buf_fbr-line no-lock
     5984                            where buf_fbr-line.doc-code    = p-doc-code
     5985                              and buf_fbr-line.trn-type    = p-trn-type
     5986                              and buf_fbr-line.recipe-code = v-comp-recipe-code
     5987                              and buf_fbr-line.artic       = buf_goods.artic
     5988                              and buf_fbr-line.prod-type   = buf_goods.prod-type
     5989                              and buf_fbr-line.prod-code   = buf_goods.prod-code
     5990                       no-error.
     5991                       if available buf_fbr-line
     5992                       then do:
     5993                           define variable v-line-qnty             as decimal   no-undo.
     5994                           define variable v-used-qnty             as decimal   no-undo.
     5995                           define variable v-free-qnty             as decimal   no-undo.
     5996                           define variable v-recipe-qnty           as decimal   no-undo.
     5997                           define variable v-comp-fbr-line-recid   as recid     no-undo.
     5998                           run get-temp_dressing-ingr-used-qnty in this-procedure (
     5999                                 input v-comp-recipe-code
     6000                               , input p-gds-code
     6001                               , output v-line-qnty
     6002                               , output v-used-qnty
     6003                               , output v-recipe-qnty
     6004                           ).
     6005                           run fbrrest-get-free-qnty in this-procedure (
     6006                                 input buf_fbr-doc.obj-type
     6007                               , input buf_fbr-doc.obj-code
     6008                               , input p-gds-code
     6009                               , input p-autofbr
     6010                               , output v-free-qnty
     6011                           ).
     6012                           assign
     6013                               p-need-qnty = p-need-qnty + v-recipe-qnty
     6014                           .
     6015                           run calc-comp-from-ingr in this-procedure (
     6016                                 input recid( buf_fbr-line )
     6017                               , input p-need-qnty
     6018                               , output v-comp-fbr-line-recid
     6019                               , output v-comp-need-qnty
     6020                           ) .
     6021                       end.
     6022                       assign
     6023                           buf_temp_goods-qnty.need-qnty   = maximum( buf_temp_goods-qnty.need-qnty, v-comp-need-qnty )
     6024                           buf_temp_goods-qnty.calculated  = no
     6025                       .
     6026                   end.
     6027               end.
     6028               otherwise do:
     6029         if v-ban-altr or v-ban-recipes then
     6030         do:
     6031             if v-ext-comp-recipe-type = 'производство':U and v-ban-recipes then
     6032             do:
     6033                for each ub.recipe-gds no-lock where ub.recipe-gds.recipe-code = v-comp-recipe-code:
     6034                   run gds-attr-value in this-procedure  ( input  ub.recipe-gds.gds-code
     6035                      , input  'mark-type':U
     6036                      , output v-attr-value
     6037                      , output v-attr-type
     6038                      ) no-error .
     6039                   if v-attr-value <> "" and v-attr-value <> "not-type" then
     6040                   do:
     6041                      message "Рецепт производства " + v-comp-recipe-code + " содержит маркированный товар."
     6042                         view-as alert-box.
     6043                      return .
     6044                   end.
     6045                end.
     6046             end.
     6047             if v-ext-comp-recipe-type = 'альтернатива':U and v-ban-altr then
     6048             do:
     6049                if not check-ban-sales-via-cd(buf_goods.gds-code) then
     6050                do:
     6051                  message "Рецепт альтернатива " + v-comp-recipe-code + " входит в группу, у которой не установлен атрибут: " + chr(10) + "Запрет передачи на кассу."
     6052                    view-as alert-box.
     6053                  return .
     6054                end.
     6055             end.
     6056             if v-ext-comp-recipe-type = 'комплектация':U and v-ban-recipes then
     6057             do:
     6058                for each ub.recipe-gds no-lock where ub.recipe-gds.recipe-code = v-comp-recipe-code:
     6059                   run gds-attr-value in this-procedure  ( input  ub.recipe-gds.gds-code
     6060                      , input  'mark-type':U
     6061                      , output v-attr-value
     6062                      , output v-attr-type
     6063                      ) no-error .
     6064                   if v-attr-value <> "" and v-attr-value <> "not-type" then
     6065                   do:
     6066                      run gds-attr-value in this-procedure  ( input  p-gds-code
     6067                         , input  'mark-type':U
     6068                         , output v-attr-value-rec
     6069                         , output v-attr-type
     6070                         ) no-error .
     6071                      if v-attr-value-rec = "" or v-attr-value-rec = "not-type" then
     6072                      do:
     6073                         message "Рецепт комплектации " + v-comp-recipe-code + " должен быть маркированным"
     6074                            view-as alert-box.
     6075                         return .
     6076                      end.
     6077                      else leave.
     6078                   end.
     6079                end.
     6080             end.
     6081         end.
     6082                   find first buf_temp_goods-qnty
     6083                        where buf_temp_goods-qnty.gds-code = p-gds-code
     6084                          and buf_temp_goods-qnty.trn-type = p-trn-type
     6085                   no-error.
     6086                   if available buf_temp_goods-qnty
     6087                   then do:
     6088                       assign
     6089                           buf_temp_goods-qnty.need-qnty  = buf_temp_goods-qnty.need-qnty + p-need-qnty
     6090                       .
     6091                       if buf_temp_goods-qnty.recipe-code <> ""
     6092                       then do:
     6093                           assign
     6094                               buf_temp_goods-qnty.calculated = no
     6095                           .
     6096                       end.
     6097                       run writelog in this-procedure ( log-file-name, 5, substitute( "Раскрутка ингредиетнов: добавляем товар '&1' к уже рассчитанному: &2", buf_temp_goods-qnty.artic, buf_temp_goods-qnty.need-qnty  ) ).
     6098                   end.
     6099                   else do:
     6100                       find first buf_temp_goods-qnty
     6101                            where buf_temp_goods-qnty.gds-code = v-comp-gds-code
     6102                              and buf_temp_goods-qnty.trn-type = v-comp-trn-type
     6103                       no-error.
     6104                       if not available buf_temp_goods-qnty
     6105                       then do:
     6106                           create buf_temp_goods-qnty.
     6107                           find first buf_goods no-lock
     6108                                where buf_goods.gds-code = v-comp-gds-code
     6109                           .
     6110                           assign
     6111                               buf_temp_goods-qnty.gds-code    = v-comp-gds-code
     6112                               buf_temp_goods-qnty.artic       = buf_goods.artic
     6113                               buf_temp_goods-qnty.prod-type   = buf_goods.prod-type
     6114                               buf_temp_goods-qnty.prod-code   = buf_goods.prod-code
     6115                               buf_temp_goods-qnty.trn-type    = v-comp-trn-type
     6116                               buf_temp_goods-qnty.need-qnty   = v-comp-need-qnty
     6117                               buf_temp_goods-qnty.recipe-type = v-comp-recipe-type
     6118                               buf_temp_goods-qnty.recipe-code = v-comp-recipe-code
     6119                               buf_temp_goods-qnty.calculated  = no
     6120                           .
     6121                           run writelog in this-procedure ( log-file-name, 5, "Раскрутка ингредиентов: добавляем товар как не рассчитанный." ).
     6122                       end.
     6123                   end.
     6124               end.
     6125           end case.
     6126           if available buf_temp_goods-qnty
     6127           then do:
     6128               run extend-noweight-gds-qnty in this-procedure (
     6129                     input buf_temp_goods-qnty.gds-code
     6130                   , input buf_temp_goods-qnty.need-qnty
     6131                   , output buf_temp_goods-qnty.need-qnty
     6132               ).
     6133           end.
     6134           find first buf_goods no-lock
     6135                where buf_goods.gds-code = v-comp-gds-code
     6136           .
     6137           if v-ext-comp-recipe-type = 'разделка':U
     6138           then do:
     6139               find first buf_fbr-line exclusive-lock
     6140                   where buf_fbr-line.doc-code    = p-doc-code
     6141                   and buf_fbr-line.trn-type    = v-comp-trn-type
     6142                   and buf_fbr-line.recipe-code = v-comp-recipe-code
     6143                   and buf_fbr-line.artic       = buf_goods.artic
     6144                   and buf_fbr-line.prod-type   = buf_goods.prod-type
     6145                   and buf_fbr-line.prod-code   = buf_goods.prod-code
     6146               no-error.
     6147               if available buf_fbr-line
     6148               then do:
     6149                   assign
     6150                       buf_fbr-line.fact-qnty = 0
     6151                   .
     6152               end.
     6153           end.
     6154           else do:
     6155               for each buf_fbr-line exclusive-lock
     6156               where buf_fbr-line.doc-code    = p-doc-code
     6157                   and buf_fbr-line.recipe-code = v-comp-recipe-code
     6158               on error undo, return error
     6159               :
     6160                   delete buf_fbr-line.
     6161               end.
     6162           end.
     6163       end.
     6164   end.
     6165   END PROCEDURE.
     6166   PROCEDURE extend-noweight-gds-qnty :
     6167   do
     6168   on error undo, return error
     6169   :
     6170   define input parameter p-gds-code   as integer      no-undo.
     6171   define input parameter p-in-qnty    as decimal      no-undo.
     6172   define output parameter p-out-qnty  as decimal      no-undo.
     6173       define buffer buf_goods                 for ub.goods.
     6174       define buffer buf_units                 for ub.units.
     6175       find first buf_goods no-lock
     6176            where buf_goods.gds-code = p-gds-code
     6177       .
     6178       find first buf_units no-lock
     6179            where buf_units.unit-name = buf_goods.unit-base
     6180       .
     6181       assign
     6182           p-out-qnty = p-in-qnty
     6183       .
     6184       if not ( lookup( 'вес':U, buf_units.type ) > 0
     6185                or lookup ('дро':U, buf_units.type) > 0 )
     6186       then do:
     6187           if p-out-qnty <> truncate( p-out-qnty, 0 )
     6188           then do:
     6189               assign
     6190                   p-out-qnty = truncate( p-out-qnty, 0 ) + 1
     6191               .
     6192           end.
     6193       end.
     6194   end.
     6195   END PROCEDURE.
     6196   PROCEDURE select-recipe :
     6197   do
     6198   on error undo, return error
     6199   :
     6200   define input parameter p-mainmenu-handle    as handle           no-undo.
     6201   define input parameter p-obj-type           as character        no-undo.
     6202   define input parameter p-obj-code           as integer          no-undo.
     6203   define input parameter p-gds-code           as integer          no-undo.
     6204   define input parameter p-trn-type           as character        no-undo.
     6205   define input parameter p-gds-qnty           as decimal          no-undo.
     6206   define input parameter p-autofbr            as logical          no-undo.
     6207   define input parameter p-have-store         as logical          no-undo.
     6208   define output parameter p-out-gds-code      as integer          no-undo.
     6209   define output parameter p-out-trn-type      as character        no-undo.
     6210   define output parameter p-out-gds-qnty      as decimal          no-undo.
     6211   define output parameter p-out-recipe-type   as character        no-undo.
     6212   define output parameter p-out-recipe-code   as character        no-undo.
     6213   define output parameter p-recipe-found      as logical          no-undo.
     6214   define output parameter p-no-need-good      as logical          no-undo.
     6215   define variable v-host-code             as integer      no-undo.
     6216   define variable v-value-character as character  no-undo .
     6217   define variable v-value-date      as date       no-undo .
     6218   define variable v-value-decimal   as decimal    no-undo .
     6219   define variable v-value-integer   as integer    no-undo .
     6220   define variable v-value-logical   as logical    no-undo .
     6221   define variable v-tth             as handle     no-undo .
     6222   define variable v-param-type            as character no-undo .
     6223   define variable v-type                  as character    no-undo.
     6224   define variable v-recipe-type           as character    no-undo.
     6225   define variable v-recipe-list           as character    no-undo.
     6226   define variable v-is-comp               as logical      no-undo.
     6227   define variable v-is-integration        as logical      no-undo.
     6228   define variable v-cancel                as logical      no-undo.
     6229   define variable v-yesno                 as logical      no-undo.
     6230   define variable v-default-recipe-code   as character    no-undo.
     6231       define buffer buf_recipe            for ub.recipe.
     6232       define buffer buf_goods             for ub.goods.
     6233       define buffer buf_selected_recipe   for ub.recipe.
     6234       define buffer buf_recipe-gds        for ub.recipe-gds.
     6235       define buffer buf_ingr_goods        for ub.goods.
     6236       run writelog in this-procedure (
     6237           input log-file-name
     6238           , input 0
     6239           , input "******** select-recipe ***************************************"
     6240       ).
     6241       find first buf_goods no-lock
     6242            where buf_goods.gds-code = p-gds-code
     6243       .
     6244       if p-trn-type = ?
     6245       then do:
     6246           run writelog in this-procedure ( log-file-name, 0, "Не определен тип строки. Добавление невозможно" ).
     6247           undo, return error.
     6248       end.
     6249   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6250   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6251     (input  p-obj-type
     6252     ,input  p-obj-code
     6253     ,output v-host-code
     6254     )  .
     6255       run adm/shattri.p ( input "get":U
     6256                         , input  '':u
     6257                         , input  0
     6258                         , input  'fbrattr':U
     6259                         , input  'fbr-frcp':U
     6260                         , output v-value-character
     6261                         , output v-value-date
     6262                         , output v-value-decimal
     6263                         , output v-value-integer
     6264                         , output v-value-logical
     6265                         , output v-param-type
     6266                         , input-output table-handle v-tth
     6267                         ) no-error .
     6268       if error-status :error then do:
     6269          assign
     6270             v-value-logical = FALSE
     6271          .
     6272       end.
     6273       run writelog in this-procedure (
     6274             input log-file-name
     6275           , input 1
     6276           , input substitute( "fbr-frcp = '&1'", v-value-logical )
     6277       ).
     6278       assign
     6279           p-out-recipe-type = ?
     6280           p-out-recipe-code = ?
     6281           v-recipe-type = ?
     6282       .
     6283       run fbrlib-get-obj-recipe in this-procedure (
     6284             input p-obj-type
     6285           , input p-obj-code
     6286           , input p-gds-code
     6287           , output v-default-recipe-code
     6288       ).
     6289       comp-recipe:
     6290       for each buf_recipe no-lock
     6291          where ( buf_recipe.obj-type = p-obj-type
     6292              and buf_recipe.obj-code = p-obj-code
     6293              and buf_recipe.artic     = buf_goods.artic
     6294              and buf_recipe.prod-type = buf_goods.prod-type
     6295              and buf_recipe.prod-code = buf_goods.prod-code
     6296              and buf_recipe.stts      <> 2
     6297             )
     6298             or ( buf_recipe.obj-type = ""
     6299              and buf_recipe.obj-code = 0
     6300              and buf_recipe.artic     = buf_goods.artic
     6301              and buf_recipe.prod-type = buf_goods.prod-type
     6302              and buf_recipe.prod-code = buf_goods.prod-code
     6303              and buf_recipe.stts      <> 2
     6304             )
     6305       :
     6306           if  ( p-autofbr = yes or v-value-logical = yes ) and buf_recipe.recipe-code <> v-default-recipe-code
     6307           then do:
     6308               undo comp-recipe, next comp-recipe.
     6309           end.
     6310           run writelog in this-procedure (
     6311                 input log-file-name
     6312               , input 3
     6313               , input substitute( "Рецепт: &1. Тип: &2 " , buf_recipe.recipe-code, buf_recipe.recipe-type )
     6314           ).
     6315           if p-autofbr = yes
     6316           and buf_recipe.recipe-type <> 'производство':U
     6317           and buf_recipe.recipe-type <> 'альтернатива':U
     6318           and buf_recipe.recipe-type <> 'комплектация':U
     6319           and buf_recipe.recipe-type <> 'комплектация':U
     6320           then do:
     6321               next comp-recipe.
     6322           end.
     6323           if p-trn-type = 'при':U
     6324           and buf_recipe.recipe-type = 'разделка':U
     6325           then do:
     6326               run writelog in this-procedure (
     6327                     input log-file-name
     6328                   , input 4
     6329                   , input "Разделка для составного не может дать прихода. Ищем следующий рецепт"
     6330               ).
     6331               next comp-recipe.
     6332           end.
     6333           if p-trn-type = 'спи':U
     6334           and buf_recipe.recipe-type <> 'разделка':U
     6335           and buf_recipe.recipe-type <> 'комплектация':U
     6336           then do:
     6337               run writelog in this-procedure (
     6338                     input log-file-name
     6339                   , input 4
     6340                   , input "Только разделка или разукомплектация для составного может дать списание. Ищем следующий рецепт"
     6341               ).
     6342               next comp-recipe.
     6343           end.
     6344           if v-recipe-type = ?
     6345           then do:
     6346               assign
     6347                   p-out-recipe-type = buf_recipe.recipe-type
     6348                   p-out-recipe-code = buf_recipe.recipe-code
     6349                   v-recipe-type = "recipe"
     6350                   v-is-integration = yes
     6351               .
     6352               run writelog in this-procedure (
     6353                     input log-file-name
     6354                   , input 4
     6355                   , input "Найден первый подходящий рецепт для составного"
     6356               ).
     6357               if v-value-logical
     6358               then do:
     6359                   run writelog in this-procedure (
     6360                       input log-file-name
     6361                       , input 4
     6362                       , input "Включен параметр fbr-frcp. Больше рецепт не ищем"
     6363                   ).
     6364                   leave comp-recipe.
     6365               end.
     6366               if p-autofbr = yes
     6367               then do:
     6368                   run writelog in this-procedure (
     6369                         input log-file-name
     6370                       , input 4
     6371                       , input "Раскрутка для ресторана. Больше рецепт не ищем"
     6372                   ).
     6373                   leave comp-recipe.
     6374               end.
     6375           end.
     6376           else do:
     6377               run writelog in this-procedure (
     6378                     input log-file-name
     6379                   , input 4
     6380                   , input "Найден еще один подходящий рецепт"
     6381               ).
     6382               assign
     6383                   v-yesno = ?
     6384                   p-no-need-good = yes
     6385               .
     6386               do while v-yesno = ?
     6387               and p-no-need-good = yes
     6388               :
     6389                   run ref/rcp-all.w (
     6390                         input p-mainmenu-handle
     6391                       , input "b-sel"
     6392                       , input 'все':U
     6393                       , input recid( buf_goods )
     6394                       , input p-obj-type
     6395                       , input p-obj-code
     6396                       , output v-recipe-list
     6397                   ) no-error.
     6398                   if error-status :error
     6399                   or v-recipe-list = ""
     6400                   then do:
     6401                       message
     6402                           "Отменить добавление товара?"
     6403                           skip(1)
     6404                           skip "Товар:" buf_goods.artic buf_goods.gds-name
     6405                           skip(1)
     6406                           skip "Yes - отменить добавление текущего товара"
     6407                           skip "No  - отменить добавление товаров"
     6408                           skip "Cancel - вернуться к выбору рецептов"
     6409                       view-as alert-box question
     6410                       buttons yes-no-cancel
     6411                       title "Отмена"
     6412                       update v-yesno
     6413                       .
     6414                   end.
     6415                   else do:
     6416                       assign
     6417                           p-no-need-good = no
     6418                       .
     6419                   end.
     6420               end.
     6421               if p-no-need-good = yes
     6422               then do:
     6423                   if v-yesno = no
     6424                   then do:
     6425                       undo, return error .
     6426                   end.
     6427                   else do:
     6428                       return.
     6429                   end.
     6430               end.
     6431               find first buf_selected_recipe no-lock
     6432                    where recid( buf_selected_recipe ) = integer( entry( 1, v-recipe-list ) )
     6433               no-error.
     6434               if not available buf_selected_recipe
     6435               then do:
     6436                   assign
     6437                       p-out-recipe-type = ?
     6438                       p-out-recipe-code = ?
     6439                       v-is-integration  = ?
     6440                   .
     6441               end.
     6442               else do:
     6443                   assign
     6444                       p-out-recipe-type   = buf_selected_recipe.recipe-type
     6445                       p-out-recipe-code   = buf_selected_recipe.recipe-code
     6446                       v-recipe-type       = "recipe"
     6447                       v-is-integration    = yes
     6448                   .
     6449                   leave comp-recipe.
     6450               end.
     6451           end.
     6452       end.
     6453       if v-recipe-type = ?
     6454       and p-autofbr = no
     6455       then do:
     6456           run writelog in this-procedure (
     6457                 input log-file-name
     6458               , input 3
     6459               , input "Поиск товара среди ингредиентов рецептов."
     6460           ).
     6461           search-recipe-gds:
     6462           for each buf_recipe-gds
     6463              where buf_recipe-gds.artic       = buf_goods.artic
     6464                and buf_recipe-gds.prod-type   = buf_goods.prod-type
     6465                and buf_recipe-gds.prod-code   = buf_goods.prod-code
     6466           :
     6467               find first buf_recipe no-lock
     6468                    where buf_recipe.recipe-code = buf_recipe-gds.recipe-code
     6469                      and buf_recipe.obj-type    = p-obj-type
     6470                      and buf_recipe.obj-code    = p-obj-code
     6471                    no-error
     6472               .
     6473               if not available buf_recipe then next search-recipe-gds.
     6474               find buf_ingr_goods no-lock
     6475                   where buf_ingr_goods.gds-code = buf_recipe.gds-code
     6476               .
     6477               if buf_ingr_goods.stts <> 0 then do:
     6478                   run writelog in this-procedure (
     6479                         input log-file-name
     6480                       , input 3
     6481                       , input subst("Рецепт &1 на товар &2 не подходит т.к. товар удален", buf_recipe.recipe-code, buf_ingr_goods.gds-code)
     6482                   ).
     6483                   next search-recipe-gds.
     6484               end.
     6485               run writelog in this-procedure (
     6486                     input log-file-name
     6487                   , input 3
     6488                   , input substitute( "Рецепт: &1. Тип: &2 " , buf_recipe.recipe-code, buf_recipe.recipe-type )
     6489               ).
     6490               if p-trn-type = 'при':U
     6491               and buf_recipe.recipe-type <> 'разделка':U
     6492               and buf_recipe.recipe-type <> 'комплектация':U
     6493               then do:
     6494                   run writelog in this-procedure (
     6495                         input log-file-name
     6496                       , input 3
     6497                       , input "Тип не подходит. Только разделка или разукомплектация для ингредиента может дать приход"
     6498                   ).
     6499                   next search-recipe-gds.
     6500               end.
     6501               if p-trn-type = 'спи':U
     6502               and buf_recipe.recipe-type = 'разделка':U
     6503               then do:
     6504                   run writelog in this-procedure (
     6505                         input log-file-name
     6506                       , input 3
     6507                       , input "Тип не подходит. Разделка для ингредиента не может дать списания"
     6508                   ).
     6509                   next search-recipe-gds.
     6510               end.
     6511               if v-recipe-type = ?
     6512               then do:
     6513                   assign
     6514                       p-out-recipe-type   = buf_recipe.recipe-type
     6515                       p-out-recipe-code   = buf_recipe.recipe-code
     6516                       v-recipe-type       = "recipe-gds"
     6517                       v-is-integration    = no
     6518                   .
     6519                   if v-value-logical
     6520                   then do:
     6521                       leave search-recipe-gds.
     6522                   end.
     6523               end.
     6524               else do:
     6525                   assign
     6526                       p-out-recipe-type = ?
     6527                       p-out-recipe-code = p-out-recipe-code + chr(44) + buf_recipe.recipe-code
     6528                       v-is-integration  = ?
     6529                   .
     6530               end.
     6531           end.
     6532       end.
     6533       if p-out-recipe-type = ?
     6534       and p-out-recipe-code = ?
     6535       then do:
     6536           assign
     6537               p-recipe-found = no
     6538           .
     6539       end.
     6540       else do:
     6541           if p-out-recipe-type = ?
     6542           then do:
     6543               define variable v-recipe-recid-list as character     no-undo.
     6544               run str/rcp-sel.w (
     6545                     input p-mainmenu-handle
     6546                   , input buf_goods.gds-code
     6547                   , input 'при':U
     6548                   , output p-out-recipe-code
     6549                   , output v-is-integration
     6550                   , output v-cancel
     6551               ) .
     6552               if v-cancel = yes
     6553               then do:
     6554                   assign
     6555                       p-recipe-found = no
     6556                       p-no-need-good = yes
     6557                   .
     6558                   return.
     6559               end.
     6560           end.
     6561           assign
     6562               p-recipe-found = yes
     6563           .
     6564           find first buf_recipe no-lock
     6565                where buf_recipe.recipe-code = p-out-recipe-code
     6566           .
     6567           find first buf_goods no-lock
     6568                where buf_goods.artic      = buf_recipe.artic
     6569                  and buf_goods.prod-type  = buf_recipe.prod-type
     6570                  and buf_goods.prod-code  = buf_recipe.prod-code
     6571           .
     6572           assign
     6573               p-out-recipe-type   = buf_recipe.recipe-type
     6574               p-out-gds-code      = buf_goods.gds-code
     6575           .
     6576           run fbrlib-get-trn-type in this-procedure (
     6577                 input buf_recipe.recipe-code
     6578               , input recid( buf_goods )
     6579               , input v-is-integration
     6580               , output v-is-comp
     6581               , output p-out-trn-type
     6582           ).
     6583           run writelog in this-procedure (
     6584                 input log-file-name
     6585               , input 1
     6586               , input substitute( "Найден рецепт '&1' с is-comp = &2, товаром '&3 &4', типом &5"
     6587                                   , p-out-recipe-code
     6588                                   , v-is-comp
     6589                                   , buf_goods.artic
     6590                                   , buf_goods.gds-name
     6591                                   , p-out-trn-type )
     6592           ).
     6593           if p-out-gds-code <> p-gds-code
     6594           then do:
     6595               run writelog in this-procedure (
     6596                     input log-file-name
     6597                   , input 1
     6598                   , input "Необходимый товар является ингредиентом"
     6599               ).
     6600               find first buf_goods no-lock
     6601                    where buf_goods.gds-code = p-gds-code
     6602               .
     6603               find first buf_recipe-gds no-lock
     6604                    where buf_recipe-gds.recipe-code = buf_recipe.recipe-code
     6605                      and buf_recipe-gds.artic       = buf_goods.artic
     6606                      and buf_recipe-gds.prod-type   = buf_goods.prod-type
     6607                      and buf_recipe-gds.prod-code   = buf_goods.prod-code
     6608               .
     6609               if buf_recipe-gds.brutto-qnty = ?
     6610               or buf_recipe-gds.brutto-qnty = 0
     6611               then do:
     6612                   message
     6613                       "При раскрутке рецепта обнаружен ингредиент с количеством " buf_recipe-gds.brutto-qnty
     6614                       skip "Продолжение расчета документа невозможно."
     6615                       skip(1) "Код рецепта:      " buf_recipe.recipe-code
     6616                       skip    "Товар ингредиента:" buf_recipe-gds.artic buf_goods.gds-name
     6617                   view-as alert-box error.
     6618                   undo, return error .
     6619               end.
     6620               assign
     6621                   p-out-gds-qnty = p-gds-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     6622                   p-out-trn-type = ( if p-trn-type = 'спи':U then 'при':U else 'спи':U )
     6623               .
     6624               run writelog in this-procedure (
     6625                   input log-file-name
     6626                   , input 1
     6627                   , input substitute( "Количество товара: &1. Для его производства необходимо: &2 по рецепту: &3. Тип строки составного: &4."
     6628                                       , p-gds-qnty
     6629                                       , p-out-gds-qnty
     6630                                       , p-out-recipe-code
     6631                                       , p-out-trn-type )
     6632               ).
     6633           end.
     6634           else do:
     6635               assign
     6636                   p-out-gds-qnty = p-gds-qnty
     6637                   p-out-trn-type = p-trn-type
     6638               .
     6639               run writelog in this-procedure (
     6640                     input log-file-name
     6641                   , input 1
     6642                   , input substitute( "Для производства товара необходимо: &1 по рецепту: &2. Тип строки: &3."
     6643                                       , p-out-gds-qnty
     6644                                       , p-out-recipe-code
     6645                                       , p-out-trn-type )
     6646               ).
     6647           end.
     6648       end.
     6649   end.
     6650   END PROCEDURE.
     6651   procedure proc-alt-shift-f2:
     6652     if not ibs.th.gbl.gbl-var:rcode
     6653   then
     6654     run gbl\inidebug.p .
     6655   end.
     6656   procedure proc-alt-shift-f3:
     6657     run gbl/prvssinf.p
     6658       ( input this-procedure
     6659       ) .
     6660   end.
     6661   define variable v-inform-launched as logical no-undo initial false .
     6662   procedure proc-alt-shift-f4:
     6663     define variable v-action as character no-undo .
     6664     if v-inform-launched = false then do:
     6665       assign
     6666         v-inform-launched = true
     6667       .
     6668       run gbl/d-inform.w
     6669         (  input self
     6670         ,  input this-procedure
     6671         , output v-action
     6672         ) no-error .
     6673       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     6674       assign
     6675         v-inform-launched = false
     6676       .
     6677     end.
     6678   end.
     6679   procedure proc-alt-f1:
     6680     run gbl/corrhelp.p
     6681       (input this-procedure
     6682       ) .
     6683   end .
     6684   on alt-shift-f2 anywhere do:
     6685     run proc-alt-shift-f2.
     6686   end.
     6687   on alt-shift-f3 anywhere do:
     6688     run proc-alt-shift-f3 in this-procedure .
     6689   end.
     6690   on alt-shift-f4 anywhere do:
     6691     run proc-alt-shift-f4 in this-procedure.
     6692   end.
     6693   on alt-f1 anywhere do:
     6694     run proc-alt-f1 in this-procedure .
     6695   end.
     6696   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6697   define temp-table userobjs_temp-user-obj no-undo
     6698     field obj-type as character
     6699     field obj-code as integer
     6700     index xpk is primary unique obj-type obj-code
     6701     .
     6702   procedure userobjs_clear :
     6703     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     6704     do
     6705     on error undo, return error return-value
     6706     :
     6707       for each buf_userobjs_temp-user-obj
     6708       on error undo, return error return-value
     6709       :
     6710         delete buf_userobjs_temp-user-obj .
     6711       end.
     6712     end.
     6713   end .
     6714   procedure userobjs_object-count :
     6715     define output parameter p-total-count as integer   no-undo .
     6716     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     6717     do
     6718     on error undo, return error return-value
     6719     :
     6720       assign
     6721         p-total-count = 0
     6722       .
     6723       for each buf_userobjs_temp-user-obj
     6724       on error undo, return error return-value
     6725       :
     6726         assign
     6727           p-total-count = p-total-count + 1
     6728         .
     6729       end.
     6730     end.
     6731   end.
     6732   procedure userobjs_append :
     6733      define input  parameter p-obj-type as character no-undo .
     6734      define input  parameter p-obj-code as integer   no-undo .
     6735     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     6736     do
     6737     on error undo, return error return-value
     6738     :
     6739       find first buf_userobjs_temp-user-obj
     6740         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
     6741           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
     6742         no-error .
     6743       if not available buf_userobjs_temp-user-obj
     6744       then do:
     6745         create buf_userobjs_temp-user-obj .
     6746         assign
     6747           buf_userobjs_temp-user-obj.obj-type = p-obj-type
     6748           buf_userobjs_temp-user-obj.obj-code = p-obj-code
     6749         .
     6750       end.
     6751     end.
     6752   end.
     6753   procedure userobjs_object-exist :
     6754     define output parameter p-object-exist as logical   no-undo .
     6755     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     6756     do
     6757     on error undo, return error return-value
     6758     :
     6759       find first buf_userobjs_temp-user-obj
     6760         no-error .
     6761       if not available buf_userobjs_temp-user-obj
     6762       then do:
     6763         assign
     6764           p-object-exist = false
     6765         .
     6766       end.
     6767       else do:
     6768         assign
     6769           p-object-exist = true
     6770         .
     6771       end.
     6772     end.
     6773   end.
     6774   procedure userobjs_transfer :
     6775     define input  parameter p-callback-handle as handle no-undo .
     6776     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     6777     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     6778     do
     6779     on error undo, return error return-value
     6780     :
     6781       if valid-handle(p-callback-handle) <> true
     6782       then do:
     6783         message
     6784           vss-workfile vss-revision vss-description skip
     6785           "Ошибка задания входных параметров" skip
     6786           "Неизвестный указатель на процедуру" skip
     6787           view-as alert-box error .
     6788         undo, return error return-value .
     6789       end.
     6790       if p-callback-handle :get-signature("userobjs_append") = ""
     6791       then do:
     6792         message
     6793           vss-workfile vss-revision vss-description skip
     6794           "Ошибка задания входных параметров" skip
     6795           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     6796                     ,p-callback-handle :file-name
     6797                     ) skip
     6798           view-as alert-box error .
     6799         undo, return error return-value .
     6800       end.
     6801       for each buf_userobjs_temp-user-obj
     6802       on error undo, return error return-value
     6803       :
     6804         run userobjs_append in p-callback-handle
     6805           (input  buf_userobjs_temp-user-obj.obj-type
     6806           ,input  buf_userobjs_temp-user-obj.obj-code
     6807           ) .
     6808       end.
     6809     end.
     6810   end procedure.
     6811   procedure userobjs_select-one :
     6812      define input  parameter parparentproc     as widget-handle no-undo .
     6813      define input  parameter p-db-num          as integer   no-undo .
     6814      define input  parameter p-user-id         as character no-undo .
     6815      define input  parameter p-host-code-obj   as integer   no-undo .
     6816      define input  parameter p-obj-type        as character no-undo .
     6817      define input  parameter p-obj-code        as integer   no-undo .
     6818      define output parameter p-user-select     as logical   no-undo .
     6819      define output parameter p-select-obj-type as character no-undo .
     6820      define output parameter p-select-obj-code as character no-undo .
     6821     do
     6822     on error undo, return error return-value
     6823     :
     6824       run gbl/userobjs.w
     6825         (input  parparentproc
     6826         ,input  this-procedure :handle
     6827         ,input  p-db-num
     6828         ,input  p-user-id
     6829         ,input  p-host-code-obj
     6830         ,input  p-obj-type
     6831         ,input  p-obj-code
     6832         ,INPUT  "b-sel"
     6833         ,output p-user-select
     6834         ,output p-select-obj-type
     6835         ,output p-select-obj-code
     6836         ) .
     6837     end.
     6838   end.
     6839   procedure userobjs_select-many :
     6840     define input  parameter parparentproc   as widget-handle no-undo .
     6841     define input  parameter p-db-num        as integer   no-undo .
     6842     define input  parameter p-user-id       as character no-undo .
     6843     define input  parameter p-host-code-obj as integer   no-undo .
     6844     define input  parameter p-obj-type      as character no-undo .
     6845     define input  parameter p-obj-code      as integer   no-undo .
     6846     define output parameter p-user-select   as logical   no-undo .
     6847     define variable v-select-obj-type as character no-undo .
     6848     define variable v-select-obj-code as integer   no-undo .
     6849     do
     6850     on error undo, return error return-value
     6851     :
     6852       run gbl/userobjs.w
     6853         (input  parparentproc
     6854         ,input  this-procedure :handle
     6855         ,input  p-db-num
     6856         ,input  p-user-id
     6857         ,input  p-host-code-obj
     6858         ,input  p-obj-type
     6859         ,input  p-obj-code
     6860         ,INPUT  "b-sel,b-mark"
     6861         ,output p-user-select
     6862         ,output v-select-obj-type
     6863         ,output v-select-obj-code
     6864         ) .
     6865     end.
     6866   end.
     6867   procedure thobjs :
     6868      define input        parameter parparentproc     as widget-handle no-undo .
     6869      define input        parameter i-bttns           as character     no-undo .
     6870      define input        parameter i-list-mode       as character     no-undo.
     6871      define input        parameter i-obj-type        as character     no-undo.
     6872      define input        parameter i-db-num          as integer       no-undo.
     6873      define input        parameter i-host-code       as integer       no-undo.
     6874      define input-output parameter p-rid-list        as character     no-undo .
     6875   run ref/thobjs.p
     6876           ( input parparentproc
     6877            ,input  this-procedure :handle
     6878           , input i-bttns
     6879           , input i-list-mode
     6880           , input i-obj-type
     6881           , input i-db-num
     6882           , input i-host-code
     6883           , input-output p-rid-list ) no-error .
     6884   end.
     6885   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6886   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     6887   procedure fltopend_fltopend :
     6888   define input parameter p-parent-handle as handle no-undo .
     6889   define input parameter p-qh as handle no-undo .
     6890   define input parameter p-flt-open-open-query  as character no-undo .
     6891   define input parameter p-where-cond as character no-undo .
     6892   define input parameter p-use-indFIRST-query-tail as character no-undo .
     6893   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     6894   define input parameter p-indexed-reposition as character no-undo .
     6895     do
     6896     on error undo, return error
     6897     :
     6898   define variable v-prepare-string as character no-undo .
     6899   define variable glog as logical no-undo .
     6900   assign
     6901   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     6902                      p-where-cond + chr(32)  +
     6903                      p-use-indFIRST-query-tail + chr(32) +
     6904                      p-use-ind-sort-clmn-by + chr(32) +
     6905                      p-indexed-reposition
     6906   .
     6907   assign
     6908   glog = p-qh:query-prepare(v-prepare-string) no-error .
     6909   if not glog
     6910   or error-status:error then do:
     6911     message error-status:get-message(1) view-as alert-box .
     6912     undo, return error .
     6913   end.
     6914   assign
     6915   glog = p-qh:query-open no-error .
     6916   if not glog
     6917   or error-status:error then do:
     6918     message error-status:get-message(1) view-as alert-box .
     6919     undo, return error .
     6920   end.
     6921     end.
     6922   end procedure.
     6923   procedure fltopend_fltfindd :
     6924   define input parameter p-parent-handle as handle no-undo .
     6925   define input parameter p-qh as handle no-undo .
     6926   define input parameter p-rowid as rowid no-undo .
     6927   define input parameter p-next as logical no-undo .
     6928   define input parameter p-lock as integer no-undo .
     6929   define input parameter p-bh as handle no-undo .
     6930   define input parameter p-where-cond as character no-undo .
     6931   define input parameter p-use-index-phrase as character no-undo .
     6932   define variable glog as logical no-undo .
     6933   define variable v-qh as handle no-undo .
     6934   define variable v-bh as handle no-undo .
     6935   define variable v-recid as recid no-undo .
     6936   define variable v-prepare-string as character no-undo .
     6937   do
     6938   on error undo, return error
     6939   on stop undo, return error
     6940   :
     6941     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     6942     create buffer v-bh for table p-bh buffer-name p-bh:name.
     6943     create query v-qh.
     6944     v-qh:set-buffers(v-bh).
     6945     v-prepare-string = substitute("for each &1 &2 &3"
     6946                                     ,v-bh:name
     6947                                     ,p-where-cond
     6948                                     ,p-use-index-phrase).
     6949     glog = v-qh:query-prepare(v-prepare-string) no-error.
     6950     if not glog then do:
     6951       delete object v-qh.
     6952       delete object v-bh.
     6953       undo, return error .
     6954     end.
     6955     glog = v-qh:query-open no-error .
     6956     if not glog then do:
     6957       delete object v-qh.
     6958       delete object v-bh.
     6959       undo, return error .
     6960     end.
     6961     if p-next then do:
     6962       v-qh:reposition-to-rowid(p-rowid) no-error .
     6963       glog = v-qh:get-next( p-lock) no-error .
     6964       glog = v-qh:get-next( p-lock) no-error .
     6965       if not glog or v-qh:query-off-end = yes then do:
     6966         glog = v-qh:get-first( p-lock) no-error .
     6967       end.
     6968     end.
     6969     else do:
     6970       glog = v-qh:get-first( p-lock) no-error .
     6971     end.
     6972     v-recid = v-bh:recid no-error .
     6973     delete object v-qh.
     6974     delete object v-bh.
     6975     return string(v-recid) .
     6976   end.
     6977   end procedure.
     6978   procedure fltopend_fltfindq :
     6979   define input parameter p-parent-handle as handle no-undo .
     6980   define input parameter p-qh as handle no-undo .
     6981   define input parameter p-next as logical no-undo .
     6982   define input parameter p-lock as integer no-undo .
     6983   define input parameter p-flt-open-open-query  as character no-undo .
     6984   define input parameter p-where-cond as character no-undo .
     6985   define input parameter p-use-indFIRST-query-tail as character no-undo .
     6986   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     6987   define input parameter p-indexed-reposition as character no-undo .
     6988   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     6989   define variable glog as logical no-undo .
     6990   define variable v-qh as handle no-undo .
     6991   define variable v-bh as handle no-undo extent 18.
     6992   define variable v-rowid as rowid no-undo extent 18.
     6993   define variable v-ii as integer no-undo .
     6994   define variable v-prepare-string as character no-undo .
     6995   do
     6996   on error undo, return error
     6997   on stop undo, return error
     6998   :
     6999     create query v-qh.
     7000     do v-ii = 1 to p-qh:num-buffers:
     7001       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     7002       assign
     7003       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     7004       no-error.
     7005       v-qh:add-buffer(v-bh[v-ii]).
     7006     end.
     7007     assign
     7008     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     7009                       p-where-cond + chr(32)  +
     7010                       p-use-indFIRST-query-tail + chr(32) +
     7011                       p-use-ind-sort-clmn-by + chr(32) +
     7012                       p-indexed-reposition
     7013     .
     7014     glog = v-qh:query-prepare( v-prepare-string) no-error .
     7015     if not glog then do:
     7016       delete object v-qh.
     7017       do v-ii = 1 to p-qh:num-buffers:
     7018         delete object v-bh[v-ii].
     7019       end.
     7020       undo, return error .
     7021     end.
     7022     glog = v-qh:query-open no-error .
     7023     if not glog then do:
     7024       delete object v-qh.
     7025       do v-ii = 1 to p-qh:num-buffers:
     7026         delete object v-bh[v-ii].
     7027       end.
     7028       undo, return error .
     7029     end.
     7030     if p-next then do:
     7031       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     7032       glog = v-qh:get-next( p-lock) no-error .
     7033       glog = v-qh:get-next( p-lock) no-error .
     7034       if not glog or v-qh:query-off-end = yes then do:
     7035         glog = v-qh:get-first( p-lock) no-error .
     7036       end.
     7037     end.
     7038     else do:
     7039       glog = v-qh:get-first( p-lock) no-error .
     7040     end.
     7041     do v-ii = 1 to p-qh:num-buffers:
     7042       assign
     7043       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     7044       no-error.
     7045     end.
     7046     delete object v-qh.
     7047     do v-ii = 1 to p-qh:num-buffers:
     7048       delete object v-bh[v-ii].
     7049     end.
     7050   end.
     7051   end procedure.
