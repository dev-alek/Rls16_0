    12165            undo, return no-apply.
    12166         end.
    12167         if buf_comp_fbr-line.recipe-code = ""
    12168            then
    12169         do:
    12170            message
    12171               "Данная строка не имеет рецепта."
    12172               view-as alert-box error.
    12173            undo, return no-apply.
    12174         end.
    12175   define variable vss-include-info68 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12176   do:
    12177     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    12178       (input  v-cntxt-db-num
    12179       ,input  v-cntxt-userid
    12180       ,input  0
    12181       ,input  'actn_recipe-reference_input-deletion-updating':U
    12182       ,input  'object':U
    12183       ,input  f-doc.host-code
    12184       ,input  f-doc.obj-type
    12185       ,input  f-doc.obj-code
    12186       ,input  0
    12187       ,input  0
    12188       ,input  0
    12189       ,input  true
    12190       ,output v-fbr-doc-g-log
    12191       )  .
    12192   end.
    12193         if not v-fbr-doc-g-log
    12194            then
    12195         do:
    12196            undo, return no-apply .
    12197         end.
    12198         find first buf_recipe no-lock
    12199            where buf_recipe.doc-code      = f-doc.doc-code
    12200            and buf_recipe.recipe-code   = buf_comp_fbr-line.recipe-code
    12201            .
    12202         find first buf_goods no-lock
    12203            where buf_goods.artic      = buf_recipe.artic
    12204            and buf_goods.prod-type  = buf_recipe.prod-type
    12205            and buf_goods.prod-code  = buf_recipe.prod-code
    12206            no-error.
    12207         if not available buf_goods
    12208            then
    12209         do:
    12210            message
    12211               skip
    12212               "Не найден товар рецепта."
    12213               view-as alert-box error.
    12214            undo, return no-apply .
    12215         end.
    12216         assign
    12217            ri = recid( buf_recipe )
    12218            .
    12219         if p-doc-mode <> 'ПРОСМОТР':U
    12220            then
