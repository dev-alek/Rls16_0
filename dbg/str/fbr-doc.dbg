     4679       define buffer lc_goods for ub.goods.
     4680       v-upper-code = p-grp-code.
     4681       do while v-upper-code > 0 :
     4682           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     4683           run ggoattr-value(
     4684             input lc_gds-grp.node-code,
     4685             input 0,
     4686             input "",
     4687             input 0,
     4688             input 'ban-sales-via-cd':U,
     4689             output v-value,
     4690             output v-type
     4691           ).
     4692          if v-value = "yes" then
     4693             return true.
     4694          else
     4695          do:
     4696             run ggoattr-value(
     4697                input lc_gds-grp.node-code,
     4698                input v-cntxt-host-code-obj,
     4699                input "",
     4700                input 0,
     4701                input 'ban-sales-via-cd':U,
     4702                output v-value,
     4703                output v-type
     4704                ).
     4705             if v-value = "yes" then
     4706                return true.
     4707             else
     4708             do:
     4709                run ggoattr-value(
     4710                   input lc_gds-grp.node-code,
     4711                   input v-cntxt-host-code-obj,
     4712                   input v-cntxt-obj-type,
     4713                   input v-cntxt-obj-code,
     4714                   input 'ban-sales-via-cd':U,
     4715                   output v-value,
     4716                   output v-type
     4717                   ).
     4718                if v-value = "yes" then
     4719                   return true.
     4720                else v-upper-code = lc_gds-grp.upper-code.
     4721             end .
