    11663      END.
    11664   ON CHOOSE OF b-calc-ingr IN FRAME D-FBR-DOC
    11665      DO:
    11666   define variable vss-include-info62 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11667   if lookup(self :type
    11668            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
    11669            ) = 0
    11670   then do:
    11671     message
    11672       "$Workfile$"
