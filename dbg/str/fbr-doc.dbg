     8162   procedure grp-obj-notcorr-value :
     8163   do
     8164   on error undo, return error
     8165   :
     8166   define input parameter p-node-code             as integer      no-undo.
     8167   define input parameter p-obj-type              as character    no-undo.
     8168   define input parameter p-obj-code              as integer      no-undo.
     8169   define output parameter p-notcorr              as character    no-undo init ?.
     8170   define output parameter p-range-notcorr     as integer      no-undo.
     8171   define output parameter p-exists-notcorr    as logical      no-undo.
     8172   define variable v-host-code as integer      no-undo.
     8173   DEFINE VARIABLE v-found as logical no-undo .
     8174   DEFINE VARIABLE v-exists as logical no-undo .
     8175   DEFINE VARIABLE v-range as integer no-undo .
     8176   DEFINE VARIABLE jj as integer no-undo .
     8177   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     8178   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     8179   define buffer buf_gds-grp for ub.gds-grp.
     8180   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     8181   find first buf_gds-grp no-lock where
     8182              buf_gds-grp.node-code = p-node-code no-error .
     8183   if not avail buf_gds-grp and p-node-code <> 0 then do:
     8184     message
     8185       vss-workfile vss-revision vss-description
     8186       skip "Не удалось найти группу товаров с кодом" p-node-code
     8187       view-as alert-box error .
     8188     undo, return error .
     8189   end.
     8190   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8191   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     8192     (input  p-obj-type
     8193     ,input  p-obj-code
     8194     ,output v-host-code
     8195     ) no-error .
     8196   if error-status :error
     8197   then do:
     8198       message
     8199         vss-workfile vss-revision vss-description
     8200         skip "Не удалось найти фирму объекта"
     8201         skip p-obj-type p-obj-code
     8202         skip return-value
     8203         skip trim(error-status :get-message(1))
     8204       view-as alert-box error.
     8205       undo, return error .
     8206   end.
     8207   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     8208   do while v-found = no and jj < 2:
     8209     if v-range <> 3 then do:
     8210       find first buf_gds-grp-obj no-lock
     8211           where buf_gds-grp-obj.node-code = p-node-code
     8212             and buf_gds-grp-obj.host-code = v-host-code
     8213             and buf_gds-grp-obj.obj-type  = p-obj-type
     8214             and buf_gds-grp-obj.obj-code  = p-obj-code
     8215       no-error .
     8216     end.
     8217     if v-range = 3 or not available buf_gds-grp-obj
     8218     then do:
     8219        if v-range <> 2 then do:
     8220           find first buf_gds-grp-obj no-lock
     8221               where buf_gds-grp-obj.node-code = p-node-code
     8222                 and buf_gds-grp-obj.host-code = v-host-code
     8223                 and buf_gds-grp-obj.obj-type  = ""
     8224                 and buf_gds-grp-obj.obj-code  = 0
     8225           no-error .
     8226         end.
     8227         if v-range = 2 or not available buf_gds-grp-obj
     8228         then do:
     8229             if v-range <> 1 then do:
     8230               find first buf_gds-grp-obj no-lock
     8231                   where buf_gds-grp-obj.node-code = p-node-code
     8232                   and buf_gds-grp-obj.host-code = 0
     8233                   and buf_gds-grp-obj.obj-type  = ""
     8234                   and buf_gds-grp-obj.obj-code  = 0
     8235               no-error .
     8236             end.
     8237             if v-range = 1 or not available buf_gds-grp-obj
     8238             then do:
     8239                 assign
     8240                     v-exists = no
     8241                 .
     8242             end.
     8243             else do:
     8244                 assign
     8245                     v-exists = yes
     8246                     v-range = 1
     8247                 .
     8248             end.
     8249         end.
     8250         else do:
     8251             assign
     8252                 v-exists = yes
     8253                 v-range  = 2
     8254             .
     8255         end.
     8256     end.
     8257     else do:
     8258         assign
     8259             v-exists = yes
     8260             v-range  = 3
     8261         .
     8262     end.
     8263     if available buf_gds-grp-obj
     8264     then do:
     8265       find first buf_gds-grp-obj-attr no-lock
     8266         where buf_gds-grp-obj-attr.node-code   = p-node-code
     8267           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     8268           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     8269           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     8270           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     8271         no-error .
     8272       if available buf_gds-grp-obj-attr then do:
     8273         assign
     8274           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     8275         .
     8276       end.
     8277       else do:
     8278         assign
     8279           v-notcorr-value = ?
     8280         .
     8281       end.
     8282       assign
     8283       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     8284                           then yes
     8285                           else p-exists-notcorr)
     8286       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     8287                         then v-range
     8288                         else p-range-notcorr
     8289       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     8290                         then v-notcorr-value
     8291                         else p-notcorr
     8292       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     8293       jj = jj + 1
     8294       .
     8295     end.
     8296     else do:
     8297       assign
     8298       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     8299       jj = jj + 1
     8300       .
     8301     end.
     8302   end.
     8303   end.
     8304   end procedure.
     8305   def var vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8306   define variable vss-include-info56 as character format "X(65)" no-undo
     8307   initial "@(#)$Workfile$ $Revision$".
     8308   procedure xmlchar-test :
     8309   define input parameter p-in-string          as character        no-undo.
     8310   define output parameter p-out-string-enc    as character        no-undo.
     8311   define output parameter p-out-string-dec    as character        no-undo.
     8312   do
     8313   on error undo, return error
     8314   :
     8315          run xmlchar-encode in this-procedure
     8316       (
     8317             input p-in-string
     8318           , output p-out-string-enc
     8319       ).
     8320          run xmlchar-decode in this-procedure
     8321       (
     8322             input p-out-string-enc
     8323           , output p-out-string-dec
     8324       ).
     8325   end.
     8326   end .
     8327   procedure xmlchar-encode :
     8328   define input parameter p-in-string      as character        no-undo.
     8329   define output parameter p-out-string    as character        no-undo.
     8330       define variable v-position      as integer      no-undo.
     8331       define variable v-current-char  as character    no-undo.
     8332   do
     8333   on error undo, return error
     8334   :
     8335       assign
     8336           p-out-string = "":U
     8337       .
     8338       case p-in-string
     8339       :
     8340           when ?
     8341           then do:
     8342               assign
     8343                   p-out-string = "?":U
     8344               .
     8345           end.
     8346           when "?":U
     8347           then do:
     8348               assign
     8349                   p-out-string = "&#63;":U
     8350               .
     8351           end.
     8352           otherwise do:
     8353               do v-position = 1 to length( p-in-string )
     8354               :
     8355                   assign
     8356                       v-current-char = substring( p-in-string, v-position, 1 )
     8357                   .
     8358                   case v-current-char
     8359                   :
     8360                       when "&":U
     8361                       then do:
     8362                           assign
     8363                               p-out-string = p-out-string + "&amp;":U
     8364                           .
     8365                       end.
     8366                       when ">":U
     8367                       then do:
     8368                           assign
     8369                               p-out-string = p-out-string + "&gt;":U
     8370                           .
     8371                       end.
     8372                       when "<":U
     8373                       then do:
     8374                           assign
     8375                               p-out-string = p-out-string + "&lt;":U
     8376                           .
     8377                       end.
     8378                       when "'":U
     8379                       then do:
     8380                           assign
     8381                               p-out-string = p-out-string + "&apos;":U
     8382                           .
     8383                       end.
     8384                       when '"':U
     8385                       then do:
     8386                           assign
     8387                               p-out-string = p-out-string + "&quot;":U
     8388                           .
     8389                       end.
     8390                       when chr(1)
     8391                       then do:
     8392                           assign
     8393                               p-out-string = p-out-string + "":U
     8394                           .
     8395                       end.
     8396                       when chr(2)
     8397                       then do:
     8398                           assign
     8399                               p-out-string = p-out-string + "":U
     8400                           .
     8401                       end.
     8402                       when chr(3)
     8403                       then do:
     8404                           assign
     8405                               p-out-string = p-out-string + "":U
     8406                           .
     8407                       end.
     8408                       when chr(4)
     8409                       then do:
     8410                           assign
     8411                               p-out-string = p-out-string + "":U
     8412                           .
     8413                       end.
     8414                       when chr(5)
     8415                       then do:
     8416                           assign
     8417                               p-out-string = p-out-string + "":U
     8418                           .
     8419                       end.
     8420                       when chr(6)
     8421                       then do:
     8422                           assign
     8423                               p-out-string = p-out-string + "":U
     8424                           .
     8425                       end.
     8426                       when chr(7)
     8427                       then do:
     8428                           assign
     8429                               p-out-string = p-out-string + "":U
     8430                           .
     8431                       end.
     8432                       when chr(8)
     8433                       then do:
     8434                           assign
     8435                               p-out-string = p-out-string + "":U
     8436                           .
     8437                       end.
     8438                       when chr(9)
     8439                       then do:
     8440                           assign
     8441                               p-out-string = p-out-string + "":U
     8442                           .
     8443                       end.
     8444                       when chr(29)
     8445                       then do:
     8446                           assign
     8447                               p-out-string = p-out-string + "":U
     8448                           .
     8449                       end.
     8450                       when chr(10)
     8451                       then do:
     8452                           assign
     8453                               p-out-string = p-out-string + "&#10;":U
     8454                           .
     8455                       end.
     8456                       when chr(13)
     8457                       then do:
     8458                           assign
     8459                               p-out-string = p-out-string + "&#13;":U
     8460                           .
     8461                       end.
     8462                       otherwise do:
     8463                           assign
     8464                               p-out-string = p-out-string + v-current-char
     8465                           .
     8466                       end.
     8467                   end case.
     8468               end.
     8469           end.
     8470       end case.
     8471   end.
     8472   end .
     8473   procedure xmlchar-encode-1c :
     8474   define input parameter p-in-string      as character        no-undo.
     8475   define output parameter p-out-string    as character        no-undo.
     8476       define variable v-position      as integer      no-undo.
     8477       define variable v-current-char  as character    no-undo.
     8478   do
     8479   on error undo, return error
     8480   :
     8481       assign
     8482           p-out-string = "":U
     8483       .
     8484       case p-in-string
     8485       :
     8486           when ?
     8487           then do:
     8488               assign
     8489                   p-out-string = "?":U
     8490               .
     8491           end.
     8492           otherwise do:
     8493               do v-position = 1 to length( p-in-string )
     8494               :
     8495                   assign
     8496                       v-current-char = substring( p-in-string, v-position, 1 )
     8497                   .
     8498                   case v-current-char
     8499                   :
     8500                       when chr(1)
     8501                       then do:
     8502                           assign
     8503                               p-out-string = p-out-string + " ":U
     8504                           .
     8505                       end.
     8506                       when chr(2)
     8507                       then do:
     8508                           assign
     8509                               p-out-string = p-out-string + " ":U
     8510                           .
     8511                       end.
     8512                       when chr(3)
     8513                       then do:
     8514                           assign
     8515                               p-out-string = p-out-string + " ":U
     8516                           .
     8517                       end.
     8518                       when chr(4)
     8519                       then do:
     8520                           assign
     8521                               p-out-string = p-out-string + " ":U
     8522                           .
     8523                       end.
     8524                       when chr(5)
     8525                       then do:
     8526                           assign
     8527                               p-out-string = p-out-string + " ":U
     8528                           .
     8529                       end.
     8530                       when chr(6)
     8531                       then do:
     8532                           assign
     8533                               p-out-string = p-out-string + " ":U
     8534                           .
     8535                       end.
     8536                       when chr(7)
     8537                       then do:
     8538                           assign
     8539                               p-out-string = p-out-string + " ":U
     8540                           .
     8541                       end.
     8542                       when chr(8)
     8543                       then do:
     8544                           assign
     8545                               p-out-string = p-out-string + " ":U
     8546                           .
     8547                       end.
     8548                       when chr(9)
     8549                       then do:
     8550                           assign
     8551                               p-out-string = p-out-string + " ":U
     8552                           .
     8553                       end.
     8554                       when chr(29)
     8555                       then do:
     8556                           assign
     8557                               p-out-string = p-out-string + " ":U
     8558                           .
     8559                       end.
     8560                       when chr(10)
     8561                       then do:
     8562                           assign
     8563                               p-out-string = p-out-string + " ":U
     8564                           .
     8565                       end.
     8566                       when chr(13)
     8567                       then do:
     8568                           assign
     8569                               p-out-string = p-out-string + " ":U
     8570                           .
     8571                       end.
     8572                       otherwise do:
     8573                           assign
     8574                               p-out-string = p-out-string + v-current-char
     8575                           .
     8576                       end.
     8577                   end case.
     8578               end.
     8579           end.
     8580       end case.
     8581   end.
     8582   end .
     8583   procedure xmlchar-decode :
     8584   define input parameter p-in-string      as character        no-undo.
     8585   define output parameter p-out-string    as character        no-undo.
     8586       define variable v-position      as integer      no-undo.
     8587       define variable v-last-position as integer      no-undo.
     8588       define variable v-temp-integer  as integer      no-undo.
     8589       define variable v-current-char  as character    no-undo.
     8590       define variable v-next-char     as character    no-undo.
     8591       define variable v-success       as logical      no-undo.
     8592   do
     8593   on error undo, return error
     8594   :
     8595       assign
     8596           p-out-string = "":U
     8597           v-position   = 0
     8598       .
     8599       replace-cycle:
     8600       do while yes
     8601       on error undo, return error
     8602       :
     8603           assign
     8604               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     8605           .
     8606           if v-last-position <= v-position
     8607           then do:
     8608               if v-position = 0
     8609               then do:
     8610                   assign
     8611                       p-out-string = p-in-string
     8612                   .
     8613               end.
     8614               else do:
     8615                   assign
     8616                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     8617                   .
     8618               end.
     8619               leave replace-cycle.
     8620           end.
     8621           else do:
     8622               assign
     8623                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     8624                   v-position      = v-last-position
     8625                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     8626               .
     8627               if v-current-char = "#":U
     8628               then do:
     8629                   assign
     8630                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     8631                   .
     8632                   if v-last-position > 0
     8633                   then do:
     8634                       run xmlchar-read-integer in this-procedure
     8635                        (
     8636                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     8637                           , output v-temp-integer
     8638                           , output v-success
     8639                       ).
     8640                       if v-success = yes
     8641                       and v-temp-integer >= 1
     8642                       and v-temp-integer <= 255
     8643                       then do:
     8644                           assign
     8645                               p-out-string = p-out-string + chr( v-temp-integer )
     8646                               v-position   = v-last-position + 1
     8647                           .
     8648                       end.
     8649                       else do:
     8650                           assign
     8651                               p-out-string = p-out-string + "&":U
     8652                               v-position   = v-position   + 1
     8653                           .
     8654                       end.
     8655                   end.
     8656                   else do:
     8657                       assign
     8658                           p-out-string = p-out-string + "&":U
     8659                           v-position   = v-position   + 1
     8660                       .
     8661                   end.
     8662               end.
     8663               else do:
     8664                   case substring( p-in-string, v-position + 1, 3 )
     8665                   :
     8666                       when "lt;":U
     8667                       then do:
     8668                           assign
     8669                               p-out-string = p-out-string + "<":U
     8670                               v-position   = v-position   + 3
     8671                           .
     8672                       end.
     8673                       when "gt;":U
     8674                       then do:
     8675                           assign
     8676                               p-out-string = p-out-string + ">":U
     8677                               v-position   = v-position   + 3
     8678                           .
     8679                       end.
     8680                       otherwise do:
     8681                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     8682                           then do:
     8683                               assign
     8684                                   p-out-string = p-out-string + "&":U
     8685                                   v-position   = v-position   + 4
     8686                               .
     8687                           end.
     8688                           else do:
     8689                               case substring( p-in-string, v-position + 1, 5 )
     8690                               :
     8691                                   when "quot;":U
     8692                                   then do:
     8693                                       assign
     8694                                           p-out-string = p-out-string + '"':U
     8695                                           v-position   = v-position   + 5
     8696                                       .
     8697                                   end.
     8698                                   when "apos;":U
     8699                                   then do:
     8700                                       assign
     8701                                           p-out-string = p-out-string + "'":U
     8702                                           v-position   = v-position   + 5
     8703                                       .
     8704                                   end.
     8705                                   otherwise do:
     8706                                       assign
     8707                                           p-out-string = p-out-string + "&":U
     8708                                       .
     8709                                   end.
     8710                               end case.
     8711                           end.
     8712                       end.
     8713                   end case.
     8714               end.
     8715           end.
     8716       end.
     8717   end.
     8718   end .
     8719   procedure xmlchar-read-integer :
     8720   define input parameter p-input-string      as character        no-undo.
     8721   define output parameter p-output-integer   as integer          no-undo.
     8722   define output parameter p-success       as logical          no-undo.
     8723   do
     8724   on error undo, return error
     8725   :
     8726       assign
     8727           p-output-integer = integer( p-input-string )
     8728       no-error.
     8729       if error-status :error
     8730       then do:
     8731           assign
     8732               p-success           = no
     8733               p-output-integer    = 0
     8734           .
     8735       end.
     8736       else do:
     8737           assign
     8738               p-success           = yes
     8739           .
     8740       end.
     8741   end.
     8742   end.
     8743   define variable mMRCCode  as logical    no-undo.
     8744   define variable mTypeMark as character  no-undo.
     8745   function IS-NeedMark returns logical
     8746   ( input ib-code as integer  ,
     8747     input ib-str as character ):
     8748      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     8749      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     8750                                    and buf_prod-bc-attr.b-str  eq ib-str
     8751                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     8752        no-lock no-error.
     8753      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     8754   end.
     8755   function repTegforDm return char
     8756   (iDM as char ):
     8757       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     8758       define variable vteg as character no-undo.
     8759       define variable oDM as character no-undo.
     8760       define variable vi as integer no-undo.
     8761       oDM = iDm.
     8762       do vi = 1 to num-entries(vTeglist):
     8763          vTeg = entry(vi,vTeglist).
     8764          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     8765       end.
     8766       return oDM.
     8767   end.
     8768   function repSpecSimbforDm return char
     8769   (iDM as char ):
     8770       define variable oDM as character no-undo.
     8771     run
     8772       xmlchar-decode(iDM, output oDM).
     8773     return repTegforDm (oDM).
     8774   end.
     8775   function CheckGtin return logical
     8776   (iGtin as char):
     8777      define variable bar_code as character no-undo.
     8778      define variable vGtin as logical no-undo init "yes".
     8779      if length(iGtin) eq 14
     8780      then do:
     8781         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     8782         run str/chk-sum.p
     8783          (input-output bar_code ) no-error .
     8784         if iGtin ne  bar_code
     8785         then
     8786            vGtin = no.
     8787      end.
     8788      else
     8789         vGtin = no.
     8790      return vgtin.
     8791   end.
     8792   function repSpecSimbforXlm return char
     8793   (iDM as char ):
     8794       iDM = replace(iDM,chr(29),"").
     8795       return iDM.
     8796   end.
     8797   function getGtinByDM return char
     8798   (IDM as char):
     8799      define variable VTXT as char no-undo.
     8800      define variable vGtin as char no-undo.
     8801      vTXt = IdM.
     8802      vGtin = IDM.
     8803      if    length(vtxt) > 14
     8804      then do:
     8805         if   vtxt begins "(01)"
     8806                or vtxt begins "(02)"
     8807         then
     8808            vGtin = substring(vtxt,5,14).
     8809         else if   (vtxt begins "01"
     8810                or vtxt begins "02" )
     8811                and (   (    substring(iDm,17,2) eq "21"
     8812                         and length(vtxt) >= 21)
     8813                     or substring(iDm,17,2) eq "37"
     8814                     or substring(iDm,17,4) eq "(37)" )
     8815         then do:
     8816            vGtin = substring(vtxt,3,14).
     8817            if not checkGtin(vGtin)
     8818            then
     8819               vGtin = substring(vtxt,1,14).
     8820         end.
     8821         else if     length(vtxt) eq 14 + 7 + 4 + 4
     8822             or length(vtxt) eq 14 + 7 + 4
     8823             or length(vtxt) eq 14 + 7
     8824         then
     8825            vGtin = substring(vtxt,1,14).
     8826      end.
     8827      if not checkGtin(vGtin)
     8828      then
     8829         vGtin = "".
     8830      return vgtin.
     8831   end.
     8832   function getGdsCodeByGtin return int
     8833   (iGtin as char):
     8834      define buffer prod-bc  for ub.prod-bc.
     8835      define buffer bar-code for ub.bar-code.
     8836      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     8837      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     8838      return if avail bar-code then bar-code.gds-code else ?.
     8839   end.
     8840   function getQntyCodeByGtin return decimal
     8841   (iGtin as char):
     8842      define buffer prod-bc  for ub.prod-bc.
     8843      define buffer bar-code for ub.bar-code.
     8844      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     8845      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     8846      return if avail bar-code then bar-code.cli-base-rate else ?.
     8847   end.
     8848   function getGdsCodeByDM return int
     8849   (iDm as char):
     8850      define variable vGtin as char no-undo.
     8851      define buffer prod-bc for ub.prod-bc.
     8852      vGtin  = getGtinByDM (IDM ).
     8853      return getGdsCodeByGtin (vGtin).
     8854   end.
     8855   function ChekTypeMarkByGds return logical
     8856   (iGds-code as integer ):
     8857      define buffer goods-attr for ub.goods-attr.
     8858      find first goods-attr where goods-attr.gds-code   = iGds-code
     8859                              and goods-attr.attr-code  = 'mark-type':U
     8860      no-lock no-error.
     8861      if available goods-attr
     8862      then do:
     8863         mTypeMark = goods-attr.attr-value.
     8864         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     8865           .
     8866      end.
     8867      else
     8868         return no.
     8869   end.
     8870   function ChekTypeMarkByDm return logical
     8871   (iDM as char ):
     8872      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     8873   end.
     8874   function ChekTypeMarkByGtin return logical
     8875   (iGtin as char ):
     8876      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     8877   end.
     8878   function GetNextElement return character
     8879     (input iAllTeg        as logical
     8880     ,output oteg          as character
     8881     ,output otegval       as character
     8882     ,input-output pstr    as character
     8883      ):
     8884        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     8885        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     8886        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     8887        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     8888        define variable vTeg as character no-undo.
     8889        define variable vLength as integer no-undo.
     8890        define variable vi as integer no-undo.
     8891        define variable vj as integer no-undo.
     8892        define buffer code for ub.code.
     8893        find first code where Code.parent eq "MarkType"
     8894                          and Code.CodeValue   eq mTypeMark
     8895                          no-lock no-error.
     8896        if     available code
     8897           and Code.misc1 ne ""
     8898           and Code.misc1 ne ?
     8899        then do:
     8900           integer (Code.misc1) no-error.
     8901           if not error-status:error
     8902           then
     8903             entry (4,vlistleng) = Code.misc1.
     8904        end.
     8905        if iAllTeg
     8906        then
     8907           assign
     8908              vlistElem     = vlistElem    + vlistElemDop
     8909              vlistleng     = vlistleng    + vlistlengDop
     8910           .
     8911        else if mMRCCode
     8912        then
     8913           assign
     8914              vlistElem     = vlistElem    + ",(8005),8005"
     8915              vlistleng     = vlistleng    + ",000006,0006"
     8916           .
     8917       block-elem:
     8918       do vi = 1 to num-entries(vlistElem):
     8919          vTeg = entry(vi,vlistElem).
     8920          if pstr begins vTeg
     8921          then do:
     8922             if    vTeg eq "21"
     8923             then
     8924                vLength = index(pstr,chr(29)) - 2 no-error.
     8925             if vLength  <= 0
     8926             then
     8927                vLength = int(entry(vi,vlistleng)).
     8928             otegval = substring (pstr,length(vteg) + 1, vLength).
     8929             oteg = replace(replace(vteg,")",""),"(","").
     8930             vTeg = vteg + otegval.
     8931             otegval = replace(otegval,chr(29),"").
     8932             oteg = replace(replace(oteg,")",""),"(","").
     8933             pstr = substring (pstr,length(vTeg)+ 1).
     8934             vTeg = replace(vTeg,chr(29),"").
     8935             leave block-elem.
     8936          end.
     8937          else
     8938             vTeg = "".
     8939       end.
     8940       return vteg.
     8941   end.
     8942   function GetCodeIdent return character
     8943   (iDm as char):
     8944      define variable Velement   as character no-undo init "first".
     8945      define variable oCodeIdent as character no-undo.
     8946      define variable vteg as character no-undo.
     8947      define variable vtegval as character no-undo.
     8948      define variable vGtin as character no-undo.
     8949      define buffer marking for ub.marking.
     8950      for first marking no-lock where
     8951                marking.mark eq iDm
     8952            and marking.unit-ext = "LEVEL2"
     8953      :
     8954        return iDm.
     8955      end.
     8956      vGtin  = getGtinByDM (iDm ).
     8957      ChekTypeMarkByDm(idm).
     8958      if iDm begins 'tech_':U
     8959      then
     8960         oCodeIdent = iDm.
     8961      else if length(iDm) < 21
     8962      then do:
     8963         find first marking where marking.mark eq idm
     8964         no-lock no-error.
     8965         oCodeIdent = if available marking then marking.mark else  ?.
     8966      end.
     8967      else if     length(iDm) eq 29
     8968         and not iDm begins "01"
     8969         and not iDm begins "02"
     8970      then
     8971         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     8972      else  if     length(iDm) >= 24
     8973               and (  iDm begins "01"
     8974                   or iDm begins "02")
     8975               and  substring(iDm,17,2) ne "21"
     8976      then do:
     8977         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     8978                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     8979         then
     8980            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     8981         else
     8982            oCodeIdent = iDM.
     8983      end.
     8984      else  if     (   length(iDm) eq 25
     8985                    or length(iDm) eq 21)
     8986               and (not iDm begins "01"
     8987               and  not iDm begins "02")
     8988      then
     8989         oCodeIdent = substring(iDm,1,21).
     8990      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     8991      then
     8992         oCodeIdent = substring(iDm,1,21).
     8993      else do while Velement ne "" and idm ne "":
     8994         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     8995         oCodeIdent = oCodeIdent + Velement.
     8996      end.
     8997      return oCodeIdent.
     8998   end.
     8999   function GetTegCod return character
     9000   (icodeIdent as char, iTeg as char):
     9001      define variable Velement   as character no-undo init "first".
     9002      define variable oTeg as character no-undo init ?.
     9003      define variable vteg as character no-undo.
     9004      define variable vtegval as character no-undo.
     9005      if     ((length(icodeIdent) eq 21
     9006         and not icodeIdent begins "01"
     9007         and not icodeIdent begins "02")
     9008         or
     9009             ( length(icodeIdent) eq 25
     9010               and not icodeIdent begins "01"
     9011               and not icodeIdent begins "02"))
     9012      then do:
     9013         if iTeg eq "01" or iTeg eq "02"
     9014         then
     9015            oTeg = substring(icodeIdent,1,21).
     9016         else  if  iTeg eq "21"
     9017         then
     9018            oTeg = substring(icodeIdent,15,7).
     9019      end.
     9020      else do:
     9021         ChekTypeMarkByDm(icodeIdent).
     9022         block-teg:
     9023            do while Velement ne "" and icodeIdent ne "":
     9024            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     9025            if    Velement begins iTeg
     9026               or Velement begins "(" + iTeg + ")"
     9027            then do:
     9028               oTeg = vtegval.
     9029               leave block-teg.
     9030            end.
     9031         end.
     9032      end.
     9033      return oTeg.
     9034   end.
     9035   function isOAD return logical
     9036   (icodeIdent as character):
     9037      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     9038   end.
     9039   function isMark return logical
     9040   (icodeIdent as character):
     9041      define buffer buf_marking for ub.marking.
     9042      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     9043             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     9044   end.
     9045   function addBracketForCode return character
     9046   (icodeIdent as char):
     9047      define variable Velement   as character no-undo init "first".
     9048      define variable oTeg as character no-undo.
     9049      define variable vteg as character no-undo.
     9050      define variable vtegval as character no-undo.
     9051      define buffer marking for ub.marking.
     9052      find first marking no-lock where
     9053                 marking.mark begins icodeIdent no-error.
     9054      if    not ChekTypeMarkByDm(icodeIdent)
     9055         or length(icodeIdent) le 24
     9056         or (avail marking and marking.unit-ext = "LEVEL2")
     9057      then
     9058         oTeg = icodeIdent.
     9059      else do:
     9060         if (  icodeIdent begins "01"
     9061            or icodeIdent begins "02"
     9062            ) and CheckGtin(substring (icodeIdent,3,14))
     9063            and substring (icodeIdent,17,2) eq "21"
     9064         then do:
     9065            mMRCCode = yes.
     9066            ChekTypeMarkByDm(icodeIdent).
     9067            block-teg:
     9068            do while Velement ne "" and icodeIdent ne "":
     9069               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     9070               if vteg ne ""
     9071               then
     9072                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     9073            end.
     9074            mMRCCode = no.
     9075         end.
     9076         else do:
     9077            oTeg = icodeIdent.
     9078         end.
     9079      end.
     9080      return oTeg.
     9081   end.
     9082   function getlevelByCodId return int
     9083   (iCode as char):
     9084      define variable vLength as int no-undo.
     9085      define variable vLevel  as int no-undo.
     9086      if not ChekTypeMarkByDM (icode) then return ?.
     9087      vLength = length(iCode).
     9088      if    vLength eq 18
     9089         or vLength eq 20
     9090      then
     9091         Vlevel = 4.
     9092      else if vLength eq 21
     9093      then
     9094         Vlevel = 1.
     9095      else if vLength eq 25
     9096      then do:
     9097         if  iCode begins "01"
     9098         then
     9099            Vlevel = 3.
     9100         else
     9101            Vlevel = 1.
     9102      end.
     9103      else if     vLength >= 26
     9104              and vLength <= 46
     9105      then do:
     9106         if    substring(iCode,17,2) eq "11"
     9107            or substring(iCode,17,2) eq "13"
     9108            or (    substring(iCode,17,2) eq "21"
     9109                and vLength >= 33
     9110                and substring(iCode,26,4) ne "8005")
     9111         then
     9112            Vlevel = 4.
     9113         else if    vLength eq 31
     9114                 or vLength eq 38
     9115                 or vLength eq 39
     9116                 or vLength eq 45
     9117         then
     9118            Vlevel = 1.
     9119         else if    vLength eq 35
     9120                 or vLength eq 43
     9121         then
     9122            Vlevel = 3.
     9123         else
     9124            Vlevel = ?.
     9125      end.
     9126      else
     9127         Vlevel = ?.
     9128      return Vlevel.
     9129   end.
     9130   function getLevelMotpBycodid return character
     9131   (iDm as char):
     9132      define variable vLevel as integer no-undo.
     9133      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     9134      vLevel = getlevelByCodId(iDm).
     9135      if    vLevel eq ?
     9136         or vLevel < 1
     9137         or vLevel > 6
     9138      then
     9139         return ?.
     9140      else
     9141         return entry(vlevel,vList).
     9142   end.
     9143   function getLevelUTDByLevelMotp return character
     9144   (iUnit as char):
     9145      define variable vLevel as integer no-undo.
     9146      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     9147      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     9148      vLevel = lookup(iUnit,vListMOTP).
     9149      if    vLevel eq ?
     9150         or vLevel < 1
     9151         or vLevel > 4
     9152      then
     9153         return ?.
     9154      else
     9155         return entry(vlevel,vListutd).
     9156   end.
     9157   function getLevelMotpByDM return character
     9158   (iDm as char):
     9159      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     9160   end.
     9161   function getLevelUTDByCodId return character
     9162   (iDm as char):
     9163      define variable vLevel as integer no-undo.
     9164      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     9165      vLevel = getlevelByCodId(iDm).
     9166      if    vLevel eq ?
     9167         or vLevel < 1
     9168         or vLevel > 4
     9169      then
     9170         return ?.
     9171      else
     9172         return entry(vlevel,vList).
     9173   end.
     9174   function getLevelUTDByDM return character
     9175   (iDm as char):
     9176      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     9177   end.
     9178   define variable mNotMarkQnty as logical no-undo.
     9179   function getQntyUTDByCodId return decimal
     9180   (iDM as char):
     9181      define variable vLevel as integer no-undo.
     9182      define variable vList as character no-undo init "1,5,10,500".
     9183      define variable vGtin as character no-undo.
     9184      define variable vqnty as decimal no-undo init ?.
     9185      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     9186      if vqnty eq ?
     9187      then do:
     9188         if not mNotMarkQnty
     9189         then do:
     9190            define buffer marking for ub.marking.
     9191            define variable vCodident as character no-undo.
     9192            vCodident = GetCodeIdent(idm).
     9193            find first marking where marking.mark begins vCodident no-lock no-error.
     9194            if     available marking
     9195               and marking.box-qnty ne ?
     9196            then
     9197               return marking.box-qnty.
     9198         end.
     9199         vGtin = getGtinByDm(iDM).
     9200         if ChekTypeMarkByGtin (vGtin)
     9201         then do:
     9202            vLevel = getlevelByCodId(iDM).
     9203            if     vLevel >= 1
     9204               and vLevel <= 4
     9205            then
     9206               vqnty = int(entry(vlevel,vList)).
     9207         end.
     9208         else
     9209            vqnty = getQntyCodeByGtin(vgtin).
     9210      end.
     9211      return vqnty.
     9212   end.
     9213   function getQntyUTDByDM return decimal
     9214   (iDm as char):
     9215      define variable vDM as character no-undo.
     9216      if     length (iDm) ne 25
     9217         and length (iDm) ne 29
     9218         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     9219      then
     9220         vDM = substring (iDm,1,length (iDm) - 6 ).
     9221      else
     9222         vDM = substring (iDm,1,length (iDm) - 4 ).
     9223      return getQntyUTDByCodId(vDM).
     9224   end.
     9225   function getMRC4 return decimal
     9226   (iMRC as char):
     9227      define variable oMrc     as decimal no-undo init ?.
     9228      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     9229      define variable vi       as integer no-undo.
     9230      define variable vfound   as integer no-undo.
     9231      define variable vposStart   as integer no-undo.
     9232      do:
     9233      OMRc = 0.
     9234      do vi = 1 to 4:
     9235         define variable vsimb as character no-undo.
     9236         vsimb = substring(iMRC,vi,1).
     9237         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     9238         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     9239         if vfound > 0
     9240         then
     9241            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     9242         end.
     9243         OMRc = OMRc / 100.
     9244      end.
     9245      return OMRc.
     9246   end.
     9247   function getMRCByDM return decimal
     9248   (iDm as char):
     9249      define variable vMRC     as character no-undo.
     9250      define variable oMrc     as decimal no-undo init ?.
     9251      define variable Velement as character no-undo init "empty".
     9252      define variable vteg as character no-undo.
     9253      define variable vtegval as character no-undo.
     9254      if    length(idm) eq 14 + 7 + 4 + 4
     9255         or length(idm) eq 14 + 7 + 4
     9256      then do:
     9257         vMRC = substring(idm,22,4).
     9258         omrc = getMRC4(vMRC).
     9259      end.
     9260      else do:
     9261          ChekTypeMarkByDm(iDm).
     9262          block-mrc:
     9263          do while Velement ne "" and idm ne "":
     9264             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     9265             if Velement begins "8005"
     9266             then do:
     9267                vMRC = substring(Velement,5,6).
     9268                leave block-mrc.
     9269             end.
     9270             else if Velement begins "(8005)"
     9271             then do:
     9272                vMRC = substring(Velement,7,6).
     9273                leave block-mrc.
     9274             end.
     9275          end.
     9276          if vMRC ne ""
     9277          then
     9278             OMRc = dec(vmrc) / 100 no-error.
     9279      end.
     9280      return OMRc.
     9281   end.
     9282   function MoveDate return Date
     9283   (idate as date,
     9284    iMonth as int64):
     9285      define variable vMonth   as int64 no-undo.
     9286      define variable vYear    as int64 no-undo.
     9287      define variable vDateNew as date  no-undo.
     9288       define variable vDay     as int64 no-undo.
     9289       vMonth = month(iDate) + iMonth.
     9290       vYear =  year(iDate).
     9291       if vMonth <= 0
     9292       then assign
     9293          vMonth = vMonth + 12
     9294           vYear  = vYear - 1
     9295       .
     9296       else if vMonth > 12
     9297       then assign
     9298          vMonth = vMonth - 12
     9299           vYear  = vYear + 1
     9300       .
     9301       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     9302       do while error-status:error eq yes:
     9303          VDay = vDay + 1.
     9304          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     9305       end.
     9306       if VDay > 0
     9307       then
     9308          vDateNew + 1.
     9309       return vDateNew.
     9310   end.
     9311   procedure checkEMRC:
     9312   define input  parameter iDm as character no-undo.
     9313   define output parameter vok as logical   no-undo init yes.
     9314      define variable v-value-emrc as character no-undo.
     9315      define variable v-type-emrc  as character no-undo.
     9316      define variable vDateIso     as character no-undo.
     9317      define variable vMRC         as decimal no-undo.
     9318      define variable vqnty        as decimal no-undo.
     9319      define variable vPrice       as decimal no-undo.
     9320      define variable vparent      as character no-undo.
     9321      define variable vgds-code    as integer no-undo.
     9322      define buffer code for ub.code.
     9323      vMRC = getMRCByDM(iDm).
     9324      if vMRC > 0
     9325      then do:
     9326         vgds-code = getGdsCodeByDM(iDm).
     9327         vqnty     = getQntyUTDByDM(iDm).
     9328               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     9329            (
     9330             input   vgds-code
     9331            ,input   'emrc-type':U
     9332            ,output   v-value-emrc
     9333            ,output   v-type-emrc
     9334          ) no-error.
     9335          if     v-value-emrc ne ""
     9336             and v-value-emrc ne ?
     9337          then do:
     9338             vDateIso = iso-date(today).
     9339             vPrice = vMRC / vqnty.
     9340             vparent ="emc" + chr(4) + v-value-emrc.
     9341             find last code where Code.parent      eq vparent
     9342                              and Code.code        le vDateIso
     9343                              and code.status_  eq 0
     9344             no-lock no-error.
     9345             if not available code or ( vPrice  >= dec(Code.CodeValue))
     9346             then
     9347                vOk = true .
     9348             else do:
     9349                 define variable vText      as character no-undo.
     9350                 define variable vDate      as date no-undo.
     9351                 define variable vDateLast  as character no-undo.
     9352                 define variable vDateFirst as character no-undo.
     9353                 define variable vDate3     as date no-undo.
     9354                 vdate = date(code.misc1).
     9355                 vDateLast = code.misc1.
     9356                 vDate3 = MoveDate(today, - 3 ).
     9357                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     9358                                      string(vDate3  , "99/99/9999"),
     9359                                      string(vDate   , "99/99/9999")
     9360                                      ).
     9361                 vdateIso = iso-date(vdate3).
     9362                 find last code  where Code.parent      eq vparent
     9363                                   and Code.code        le vDateIso
     9364                                   and code.status_  eq 0 no-lock no-error.
     9365                 if available code
     9366                 then
     9367                    vDateIso = code.code.
     9368                 vDateFirst = vDateIso.
     9369                 vDateLast = iso-date(vdate).
     9370                 define variable vGood as logical no-undo.
     9371                 define variable vDateSale as date no-undo.
     9372                 define buffer bcode for code.
     9373                 for last code where Code.parent   eq vparent
     9374                                 and code.status_  eq 0
     9375                                 and code.code     < vDateLast
     9376                                 and code.code     >= vDateFirst
     9377                 no-lock:
     9378                    find first bcode where bCode.parent   eq vparent
     9379                                       and bcode.status_  eq 0
     9380                                       and bcode.code     > code.code no-lock no-error.
     9381                    if available bcode
     9382                    then do:
     9383                       if vPrice < dec(Code.CodeValue)
     9384                       then
     9385                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     9386                                                     chr(10),
     9387                                                     string(    date( code.misc1)       ,"99/99/9999"),
     9388                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     9389                                                     ).
     9390                       else do:
     9391                          vGood = yes.
     9392                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     9393                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     9394                                                     chr(10),
     9395                                                     string(    date( code.misc1)         ,"99/99/9999"),
     9396                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     9397                                                     string(         vDateSale            ,"99/99/9999"),
     9398                                                     string(vDateSale - today)
     9399                                                     ).
     9400                       end.
     9401                    end.
     9402                 end.
     9403                 if vgood
     9404                 then do:
     9405                    define variable choice as integer no-undo .
     9406                    run gbl/d-askw.w (input "Уточнение"
     9407                           ,input  vText
     9408                           ,input "|"
     9409                           ,input "Принять|Вернуть"
     9410                           ,input "Принять данный товар|Вернуть товар постащику"
     9411                           ,input 1
     9412                           ,input 2
     9413                           ,output choice) no-error.
     9414                    vok = choice eq 1.
     9415                 end.
     9416                 else
     9417                    vok =false.
     9418             end.
     9419          end.
     9420      end.
     9421   end.
     9422   function addGs2Mark return character
     9423   (iMark as char):
     9424      define variable vDM   as character no-undo.
     9425      define variable vIdx  as integer   no-undo.
     9426      if index(iMark,chr(29),1) > 0
     9427      then return iMark.
     9428      if substring(iMark,26,4) = "8005" then
     9429      do:
     9430        vIdx = index(iMark,"93",26 + 4 + 5).
     9431        if vIdx > 1 then do:
     9432          vDM = substitute("&1&4&2&4&3",
     9433                           substring(iMark,1,25),
     9434                           substring(iMark,26,vIdx - 25 - 1),
     9435                           substring(iMark,vIdx),
     9436                           chr(29)) no-error.
     9437          vIdx = index(vDm,"240",vIdx + 4).
     9438          if vIdx > 0 then
     9439          do:
     9440            vDM = substitute("&1&3&2",
     9441                             substring(vDm,1,vIdx - 1),
     9442                             substring(vDm,vIdx),
     9443                             chr(29)) no-error.
     9444          end.
     9445        end.
     9446        else
     9447          vDM = substitute("&1&3&2",
     9448                           substring(iMark,1,25),
     9449                           substring(iMark,26),
     9450                           chr(29)) no-error.
     9451      end.
     9452      else if substring(iMark,32,2) = "91" then
     9453      do:
     9454        vIdx = index(iMark,"92",32).
     9455        if vIdx > 1 then
     9456          vDM = substitute("&1&4&2&4&3",
     9457                           substring(iMark,1,31),
     9458                           substring(iMark,32,vIdx - 31 - 1),
     9459                           substring(iMark,vIdx),
     9460                           chr(29)) no-error.
     9461        else
     9462          vDM = substitute("&1&3&2",
     9463                           substring(iMark,1,31),
     9464                           substring(iMark,32),
     9465                           chr(29)) no-error.
     9466      end.
     9467      else if substring(iMark,39,2) = "91" then
     9468      do:
     9469        vIdx = index(iMark,"92",38).
     9470        if vIdx > 1 then
     9471          vDM = substitute("&1&4&2&4&3",
     9472                           substring(iMark,1,38),
     9473                           substring(iMark,39,vIdx - 38 - 1),
     9474                           substring(iMark,vIdx),
     9475                           chr(29)) no-error.
     9476        else
     9477          vDM = substitute("&1&3&2",
     9478                           substring(iMark,1,38),
     9479                           substring(iMark,39),
     9480                           chr(29)) no-error.
     9481      end.
     9482      else if substring(iMark,25,2) = "93" then
     9483      do:
     9484        vIdx = index(iMark,"92",25).
     9485        if vIdx > 1 then
     9486          vDM = substitute("&1&4&2&4&3",
     9487                           substring(iMark,1,24),
     9488                           substring(iMark,25,vIdx - 24 - 1),
     9489                           substring(iMark,vIdx),
     9490                           chr(29)) no-error.
     9491        else
     9492          vIdx = index(iMark,"3103",25).
     9493          if vIdx > 0 then
     9494          vDM = substitute("&1&4&2&4&3",
     9495                           substring(iMark,1,24),
     9496                           substring(iMark,25,vIdx - 24 - 1),
     9497                           substring(iMark,vIdx),
     9498                           chr(29)) no-error.
     9499          else
     9500            vDM = substitute("&1&3&2",
     9501                             substring(iMark,1,24),
     9502                             substring(iMark,25),
     9503                             chr(29)) no-error.
     9504      end.
     9505      else if substring(iMark,32,2) = "93" then
     9506      do:
     9507        vDM = substitute("&1&3&2",
     9508              substring(iMark,1,31),
     9509              substring(iMark,32),
     9510              chr(29)) no-error.
     9511      end.
     9512      return if vDM <> "" then vDm else iMark.
     9513   end.
     9514   def var vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9515   function getattrUtdex returns char
     9516   (idb-num   as integer,
     9517    idoc-id   as integer,
     9518    iattrcode as character,
     9519    iExValue  as character  ):
     9520      define buffer utd-attr for utd-attr.
     9521      find first utd-attr where utd-attr.db-num eq idb-num
     9522                            and utd-attr.doc-id eq idoc-id
     9523                            and utd-attr.attr-code eq iattrcode
     9524      no-lock no-error.
     9525      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     9526   end.
     9527   function getattrUtd returns char
     9528   (idb-num   as integer,
     9529    idoc-id   as integer,
     9530    iattrcode as character ):
     9531     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     9532   end.
     9533   function setattrUtd returns logical
     9534   (idb-num   as integer,
     9535    idoc-id   as integer,
     9536    iattrcode as character,
     9537    iattrval  as character ):
     9538      define buffer utd-attr for utd-attr.
     9539      find first utd-attr where utd-attr.db-num eq idb-num
     9540                            and utd-attr.doc-id eq idoc-id
     9541                            and utd-attr.attr-code eq iattrcode
     9542      no-lock no-error.
     9543      if not available utd-attr
     9544      then do:
     9545         create utd-attr.
     9546         assign
     9547            utd-attr.db-num    = idb-num
     9548            utd-attr.doc-id    = idoc-id
     9549            utd-attr.attr-code = iattrcode
     9550            utd-attr.attr-value = iattrval
     9551         .
     9552      end.
     9553      else do:
     9554         if utd-attr.attr-value ne iattrval
     9555         then do:
     9556            find current utd-attr exclusive-lock no-error.
     9557            if available utd-attr
     9558            then
     9559               utd-attr.attr-value = iattrval.
     9560         end.
     9561      end.
     9562      release utd-attr.
     9563   end.
     9564   function GetAttrUtdlinesEx returns char
     9565   (idb-num   as integer,
     9566    idoc-id   as integer,
     9567    ilinenum  as integer,
     9568    iattrcode as character,
     9569    iExValue  as character  ):
     9570      define buffer utd-lines-attr for utd-lines-attr.
     9571      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     9572                                  and utd-lines-attr.doc-id    eq idoc-id
     9573                                  and utd-lines-attr.lineNum   eq ilineNum
     9574                                  and utd-lines-attr.attr-code eq iattrcode
     9575      no-lock no-error.
     9576      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
     9577   end.
     9578   function GetAttrUtdlines returns char
     9579   (idb-num   as integer,
     9580    idoc-id   as integer,
     9581    ilinenum  as integer,
     9582    iattrcode as character ):
     9583      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
     9584   end.
     9585   function setattrUtdlines returns logical
     9586   (idb-num   as integer,
     9587    idoc-id   as integer,
     9588    ilinenum  as integer,
     9589    iattrcode as character,
     9590    iattrval  as character ):
     9591      define buffer utd-lines-attr for utd-lines-attr.
     9592      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     9593                                  and utd-lines-attr.doc-id    eq idoc-id
     9594                                  and utd-lines-attr.lineNum   eq ilineNum
     9595                                  and utd-lines-attr.attr-code eq iattrcode
     9596      no-lock no-error.
     9597      if not available utd-lines-attr
     9598      then do:
     9599         if iattrval ne ?
     9600            and iattrval ne ""
     9601         then do:
     9602            create utd-lines-attr.
     9603            assign
     9604               utd-lines-attr.db-num    = idb-num
     9605               utd-lines-attr.doc-id    = idoc-id
     9606               utd-lines-attr.lineNum   = ilineNum
     9607               utd-lines-attr.attr-code = iattrcode
     9608               utd-lines-attr.attr-value = iattrval
     9609            .
     9610         end.
     9611      end.
     9612      else do:
     9613         if utd-lines-attr.attr-value ne iattrval
     9614         then do:
     9615            find current utd-lines-attr exclusive-lock no-error.
     9616            if available utd-lines-attr
     9617            then do:
     9618               if    iattrval eq ?
     9619                  or iattrval eq ""
     9620               then do:
     9621                  delete utd-lines-attr.
     9622               end.
     9623               else do:
     9624                  utd-lines-attr.attr-value = iattrval.
     9625               end.
     9626            end.
     9627         end.
     9628      end.
     9629      release utd-lines-attr.
     9630   end.
     9631   function GetAttrUtdMarkingLinesEx returns char
     9632   (idb-num   as integer,
     9633    idoc-id   as integer,
     9634    ilinenum  as integer,
     9635    imark     as character,
     9636    iattrcode as character,
     9637    iExValue  as character  ):
     9638      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
     9639      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
     9640                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     9641                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     9642                                          and utd-marking-lines-attr.mark      eq imark
     9643                                          and utd-marking-lines-attr.attr-code eq iattrcode
     9644      no-lock no-error.
     9645      return if not available utd-marking-lines-attr  then iExValue    else  utd-marking-lines-attr.attr-value.
     9646   end.
     9647   function GetAttrUtdMarkingLines returns char
     9648   (idb-num   as integer,
     9649    idoc-id   as integer,
     9650    ilinenum  as integer,
     9651    imark     as character,
     9652    iattrcode as character ):
     9653      return GetAttrUtdMarkingLinesEx (idb-num,idoc-id,ilinenum,imark,iattrcode,?).
     9654   end.
     9655   function setattrUtdMarkingLines returns logical
     9656   (idb-num   as integer,
     9657    idoc-id   as integer,
     9658    ilinenum  as integer,
     9659    imark     as character,
     9660    iattrcode as character,
     9661    iattrval  as character ):
     9662      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
     9663      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
     9664                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     9665                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     9666                                          and utd-marking-lines-attr.mark      eq imark
     9667                                          and utd-marking-lines-attr.attr-code eq iattrcode
     9668      no-lock no-error.
     9669      if not available utd-marking-lines-attr
     9670      then do:
     9671         if iattrval ne ?
     9672            and iattrval ne ""
     9673         then do:
     9674            create utd-marking-lines-attr.
     9675            assign
     9676               utd-marking-lines-attr.db-num     = idb-num
     9677               utd-marking-lines-attr.doc-id     = idoc-id
     9678               utd-marking-lines-attr.lineNum    = ilineNum
     9679               utd-marking-lines-attr.mark       = imark
     9680               utd-marking-lines-attr.attr-code  = iattrcode
     9681               utd-marking-lines-attr.attr-value = iattrval
     9682            .
     9683         end.
     9684      end.
     9685      else do:
     9686         if utd-marking-lines-attr.attr-value ne iattrval
     9687         then do:
     9688            find current utd-marking-lines-attr exclusive-lock no-error.
     9689            if available utd-marking-lines-attr
     9690            then do:
     9691               if    iattrval eq ?
     9692                  or iattrval eq ""
     9693               then do:
     9694                  delete utd-marking-lines-attr.
     9695               end.
     9696               else do:
     9697                  utd-marking-lines-attr.attr-value = iattrval.
     9698               end.
     9699            end.
     9700         end.
     9701      end.
     9702      release utd-marking-lines-attr.
     9703   end.
     9704   def var vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9705   def var vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9706   def var vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9707   procedure gen-key-rec :
     9708     define input  parameter p-tbl-name    as character no-undo.
     9709     define input  parameter p-bh_tbl-name as handle    no-undo.
     9710     define output parameter p-key-rec     as character no-undo.
     9711     do
     9712     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     9713     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     9714     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     9715     :
     9716       define variable fh               as handle    no-undo .
     9717       define variable v-ok             as logical   no-undo .
     9718       define variable v-inform         as character no-undo .
     9719       define variable v-ind            as integer   no-undo .
     9720       define variable v-idx-field-qnty as integer   no-undo .
     9721       if p-tbl-name = ?
     9722         or p-tbl-name = "":U
     9723       then do:
     9724         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info60 ).
     9725       end.
     9726       if not p-bh_tbl-name:available then do:
     9727         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info60, p-tbl-name ).
     9728       end.
     9729       assign
     9730         p-key-rec = p-tbl-name
     9731         v-inform  = p-bh_tbl-name:index-information(1)
     9732         v-ind     = 2
     9733       .
     9734       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     9735       on error undo, return error
     9736       :
     9737         assign
     9738           v-inform = p-bh_tbl-name:index-information( v-ind )
     9739           v-ind    = v-ind + 1
     9740         .
     9741       end.
     9742       if v-inform = ?
     9743         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     9744         or entry( 3, v-inform, ",":U ) <> "1":U
     9745       then do:
     9746         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info60, p-tbl-name ).
     9747       end.
     9748       else do:
     9749         assign
     9750           v-idx-field-qnty = num-entries( v-inform ) - 4
     9751         .
     9752         if v-idx-field-qnty < 2 then do:
     9753           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info60, v-inform, p-tbl-name ).
     9754         end.
     9755         do v-ind = 1 to v-idx-field-qnty by 2
     9756         on error undo, return error
     9757         :
     9758           assign
     9759             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     9760             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     9761           .
     9762         end.
     9763       end.
     9764       if p-key-rec = ? then do:
     9765         assign
     9766           p-key-rec = "":U
     9767         .
     9768         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info60, p-tbl-name ).
     9769       end.
     9770     end.
     9771     return.
     9772   end procedure.
     9773   procedure gen-where-keyr-tab :
     9774     define input  parameter i-tableSerach as character no-undo.
     9775     define input  parameter i-tablekey   as character  no-undo.
     9776     define input  parameter p-key-rec    as character  no-undo.
     9777     define input  parameter p-key-handle as handle     no-undo .
     9778     define input  parameter p-db-name    as character  no-undo .
     9779     define input  parameter p-tt-handle  as handle     no-undo .
     9780     define output parameter o-Where      as character  no-undo.
     9781     do
     9782     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     9783     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     9784     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     9785     :
     9786       define variable v-full-tbl-name  as character no-undo .
     9787       define variable bh_tbl-name      as handle    no-undo .
     9788       define variable fh_key           as handle    no-undo .
     9789       define variable fh_search        as handle    no-undo .
     9790       define variable v-field-num      as integer   no-undo .
     9791       define variable v-count-fld      as integer   no-undo .
     9792       define variable v-inform         as character no-undo .
     9793       define variable v-ind            as integer   no-undo .
     9794       define variable v-idx-field-qnty as integer   no-undo .
     9795       define variable v-field-name     as character no-undo .
     9796       define variable v-field-val      as character no-undo .
     9797       define variable v-word-link      as character no-undo .
     9798       define variable vTable           as character no-undo.
     9799       define variable bh_tbl-key       as handle    no-undo .
     9800       assign
     9801         p-key-rec = trim( p-key-rec )
     9802       .
     9803       if p-key-handle <> ? then do:
     9804         if not valid-handle(p-key-handle)
     9805            or p-key-handle:type <> "buffer"
     9806         then do:
     9807           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info60 ).
     9808         end.
     9809         if num-entries( p-key-rec, chr(3) ) > 1
     9810           or p-key-rec = ?
     9811           or p-key-rec = "":U
     9812         then do:
     9813           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info60, p-key-rec ).
     9814         end.
     9815       end.
     9816       else do:
     9817         if p-key-rec = ?
     9818           or p-key-rec = "":U
     9819         then do:
     9820           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info60 ).
     9821         end.
     9822       end.
     9823       assign
     9824         vTable = entry( 1 , p-key-rec, chr(3) )
     9825       .
     9826       if p-tt-handle <> ?
     9827         and ( not valid-handle(p-tt-handle)
     9828               or p-tt-handle:type <> "buffer"
     9829             )
     9830       then do:
     9831         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info60, vTable, chr(10) ).
     9832       end.
     9833       if p-tt-handle = ? then do:
     9834         assign
     9835           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     9836         .
     9837         create buffer bh_tbl-name for table v-full-tbl-name .
     9838       end.
     9839       else do:
     9840         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     9841       end.
     9842       assign
     9843         v-inform = bh_tbl-name:index-information(1)
     9844         v-ind    = 2
     9845       .
     9846       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     9847       on error undo, return error
     9848       :
     9849         assign
     9850           v-inform = bh_tbl-name:index-information( v-ind )
     9851           v-ind    = v-ind + 1
     9852         .
     9853       end.
     9854       if v-inform = ?
     9855         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     9856         or entry( 3, v-inform, ",":U ) <> "1":U
     9857       then do:
     9858         delete object bh_tbl-name no-error.
     9859         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info60, vTable ).
     9860       end.
     9861       assign
     9862         v-idx-field-qnty = num-entries( v-inform ) - 4
     9863       .
     9864       if v-idx-field-qnty < 2 then do:
     9865         delete object bh_tbl-name no-error.
     9866         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info60, v-inform, vTable ).
     9867       end.
     9868       assign
     9869         o-where     = "where":U
     9870         v-word-link = "":U
     9871         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     9872         v-count-fld = 0
     9873       .
     9874       if i-tablekey ne "" and i-tablekey ne ?
     9875       then do:
     9876         assign
     9877           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     9878         .
     9879         create buffer bh_tbl-key for table v-full-tbl-name .
     9880       end.
     9881       if i-tableSerach ne "" and i-tableSerach ne ?
     9882       then do:
     9883         delete object bh_tbl-name no-error.
     9884         assign
     9885           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     9886         .
     9887         create buffer bh_tbl-name for table v-full-tbl-name .
     9888       end.
     9889       block_where:
     9890       do v-ind = 1 to v-idx-field-qnty by 2
     9891       on error undo, return error
     9892       :
     9893         assign
     9894           v-count-fld = v-count-fld + 1
     9895         .
     9896         if p-key-handle = ?
     9897           and v-count-fld > v-field-num
     9898         then do:
     9899           leave block_where.
     9900         end.
     9901         define variable VfieldKeyTable as handle no-undo.
     9902         assign
     9903           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     9904           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     9905         .
     9906         if     bh_tbl-key ne ?
     9907         then do:
     9908            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     9909            if VfieldKeyTable eq ?
     9910            then next block_where.
     9911         end.
     9912         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     9913         then
     9914            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     9915         else
     9916            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     9917         if p-key-handle = ? then do:
     9918           assign
     9919             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     9920           .
     9921         end.
     9922         else do:
     9923           assign
     9924             fh_key = p-key-handle:buffer-field( v-field-name )
     9925           .
     9926           if fh_key = ?
     9927             or not valid-handle( fh_key )
     9928           then do:
     9929             delete object bh_tbl-name.
     9930             if     bh_tbl-key ne ?
     9931             then
     9932                delete object bh_tbl-key.
     9933             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info60, p-key-handle:name, v-field-name ).
     9934           end.
     9935           assign
     9936             v-field-val = fh_key:buffer-value
     9937           .
     9938         end.
     9939         if fh_search:data-type ="character":U then do:
     9940           assign
     9941             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     9942             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     9943             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     9944             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     9945             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     9946             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     9947             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     9948             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     9949             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     9950             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     9951             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     9952             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     9953             v-field-val = substitute( '"&1"', v-field-val )
     9954           .
     9955         end.
     9956         assign
     9957           o-where = substitute( "&1 &2", o-where, v-field-val )
     9958         .
     9959         if v-word-link = "":U then do:
     9960           assign
     9961             v-word-link = "and":U
     9962           .
     9963         end.
     9964       end.
     9965       delete object bh_tbl-name.
     9966       if     bh_tbl-key ne ?
     9967       then
     9968          delete object bh_tbl-key.
     9969       if p-key-handle = ?
     9970         and v-count-fld <> v-field-num
     9971       then do:
     9972         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info60, vTable ).
     9973       end.
     9974     end.
     9975   end procedure.
     9976   procedure gen-hn-keyr-tab :
     9977     define input  parameter i-tableSerach as character no-undo.
     9978     define input  parameter i-tablekey   as character no-undo.
     9979     define input  parameter p-key-rec    as character no-undo.
     9980     define input  parameter p-key-handle as handle    no-undo .
     9981     define input  parameter p-db-name    as character no-undo .
     9982     define input  parameter p-tt-handle  as handle    no-undo .
     9983     define input  parameter p-stts-lock  as integer   no-undo .
     9984     define output parameter o-hn         as handle    no-undo.
     9985     define variable v-full-tbl-name as character no-undo.
     9986     define variable v-where         as character no-undo.
     9987     define variable bh_tbl-name     as handle    no-undo.
     9988     define variable vTable          as character no-undo.
     9989     do
     9990     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     9991     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     9992     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     9993         run gen-where-keyr-tab(i-tableSerach,
     9994                                i-tablekey,
     9995                                p-key-rec,
     9996                                p-key-handle,
     9997                                p-db-name,
     9998                                p-tt-handle,
     9999                                output v-where).
    10000         if i-tableSerach ne "" and i-tableSerach ne ?
    10001         then do:
    10002            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
    10003            create buffer bh_tbl-name for table v-full-tbl-name .
    10004         end.
    10005         else do:
    10006            if p-tt-handle = ? then do:
    10007               assign
    10008                  vTable = entry( 1 , p-key-rec, chr(3) )
    10009               .
    10010               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
    10011               create buffer bh_tbl-name for table v-full-tbl-name .
    10012            end.
    10013            else do:
    10014               create buffer bh_tbl-name for table p-tt-handle:table-handle .
    10015            end.
    10016         end.
    10017         if p-tt-handle = ? then do:
    10018            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
    10019         end.
    10020         else do:
    10021            bh_tbl-name:find-first( v-where ) no-error .
    10022         end.
    10023         o-hn = bh_tbl-name.
    10024      end.
    10025   end procedure.
    10026   procedure gen-hn-keyr :
    10027     define input  parameter p-key-rec    as character no-undo.
    10028     define input  parameter p-key-handle as handle    no-undo .
    10029     define input  parameter p-db-name    as character no-undo .
    10030     define input  parameter p-tt-handle  as handle    no-undo .
    10031     define input  parameter p-stts-lock  as integer   no-undo .
    10032     define output parameter o-hn         as handle    no-undo.
    10033     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
    10034   end.
    10035   procedure gen-row-keyr :
    10036     define input  parameter p-key-rec    as character no-undo.
    10037     define input  parameter p-key-handle as handle    no-undo .
    10038     define input  parameter p-db-name    as character no-undo .
    10039     define input  parameter p-tt-handle  as handle    no-undo .
    10040     define input  parameter p-stts-lock  as integer   no-undo .
    10041     define output parameter p-tbl-row    as rowid     no-undo.
    10042     define output parameter p-tbl-name   as character no-undo.
    10043     define variable vHn as handle no-undo.
    10044       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
    10045       p-tbl-row = if vHn:available then vHn:rowid else ?.
    10046       p-tbl-name =  vHn:table.
    10047       delete object vHn no-error.
    10048     if p-tbl-row = ? then do:
    10049       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info60, p-tbl-name, p-key-rec ).
    10050     end.
    10051     else do:
    10052       return.
    10053     end.
    10054   end procedure.
    10055   procedure gen-key-fv :
    10056     define input  parameter p-key-rec    as character no-undo .
    10057     define output parameter p-field-list as character no-undo .
    10058     define output parameter p-value-list as character no-undo.
    10059     do
    10060     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    10061     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
    10062     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
    10063     :
    10064       define variable v-full-tbl-name  as character no-undo .
    10065       define variable bh_tbl-name      as handle    no-undo .
    10066       define variable v-tbl-name       as character no-undo .
    10067       define variable v-field-num      as integer   no-undo .
    10068       define variable v-count-fld      as integer   no-undo .
    10069       define variable v-inform         as character no-undo .
    10070       define variable v-ind            as integer   no-undo .
    10071       define variable v-idx-field-qnty as integer   no-undo .
    10072       define variable v-delim-key      as character no-undo .
    10073       if p-key-rec = ?
    10074         or p-key-rec = "":U
    10075       then do:
    10076         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info60 ).
    10077       end.
    10078       assign
    10079         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
    10080         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
    10081       .
    10082       create buffer bh_tbl-name for table v-full-tbl-name no-error .
    10083       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info60 ).
    10084       assign
    10085         v-inform = bh_tbl-name:index-information(1)
    10086         v-ind    = 2
    10087       .
    10088       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
    10089       on error undo, return error
    10090       :
    10091         assign
    10092           v-inform = bh_tbl-name:index-information( v-ind )
    10093           v-ind    = v-ind + 1
    10094         .
    10095       end.
    10096       if v-inform = ?
    10097         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
    10098         or entry( 3, v-inform, ",":U ) <> "1":U
    10099       then do:
    10100         delete object bh_tbl-name no-error.
    10101         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info60, v-tbl-name ).
    10102       end.
    10103       assign
    10104         v-idx-field-qnty = num-entries( v-inform ) - 4
    10105       .
    10106       if v-idx-field-qnty < 2 then do:
    10107         delete object bh_tbl-name no-error.
    10108         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info60, v-inform, v-tbl-name ).
    10109       end.
    10110       assign
    10111         p-field-list = "":U
    10112         p-value-list = "":U
    10113         v-delim-key  = "":U
    10114         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
    10115         v-count-fld  = 0
    10116       .
    10117       block_where:
    10118       do v-ind = 1 to v-idx-field-qnty by 2
    10119       on error undo, return error
    10120       :
    10121         assign
    10122           v-count-fld = v-count-fld + 1
    10123         .
    10124         if v-count-fld > v-field-num then do:
    10125           leave block_where.
    10126         end.
    10127         assign
    10128           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
    10129           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
    10130         .
    10131         if v-ind = 1 then do:
    10132           assign
    10133             v-delim-key = chr(3)
    10134           .
    10135         end.
    10136       end.
    10137       delete object bh_tbl-name.
    10138       if v-count-fld <> v-field-num then do:
    10139         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info60, v-tbl-name ).
    10140       end.
    10141     end.
    10142   end procedure.
    10143   procedure gen-key-field :
    10144     define input  parameter p-table      as character no-undo .
    10145     define output parameter p-field-list as character no-undo .
    10146     do
    10147     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    10148     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
    10149     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
    10150     :
    10151       define variable v-full-tbl-name  as character no-undo .
    10152       define variable bh_tbl-name      as handle    no-undo .
    10153       define variable v-tbl-name       as character no-undo .
    10154       define variable v-field-num      as integer   no-undo .
    10155       define variable v-count-fld      as integer   no-undo .
    10156       define variable v-inform         as character no-undo .
    10157       define variable v-ind            as integer   no-undo .
    10158       define variable v-idx-field-qnty as integer   no-undo .
    10159       define variable v-delim-key      as character no-undo .
    10160       if p-table = ?
    10161         or p-table = "":U
    10162       then do:
    10163         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info60 ).
    10164       end.
    10165       assign
    10166         v-tbl-name      = p-table
    10167         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
    10168       .
    10169       create buffer bh_tbl-name for table v-full-tbl-name no-error .
    10170       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info60 ).
    10171       assign
    10172         v-inform = bh_tbl-name:index-information(1)
    10173         v-ind    = 2
    10174       .
    10175       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
    10176       on error undo, return error
    10177       :
    10178         assign
    10179           v-inform = bh_tbl-name:index-information( v-ind )
    10180           v-ind    = v-ind + 1
    10181         .
    10182       end.
    10183       if v-inform = ?
    10184         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
    10185         or entry( 3, v-inform, ",":U ) <> "1":U
    10186       then do:
    10187         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info60, v-tbl-name ).
    10188       end.
    10189       assign
    10190         v-idx-field-qnty = num-entries( v-inform ) - 4
    10191       .
    10192       if v-idx-field-qnty < 2 then do:
    10193         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info60, v-inform, v-tbl-name ).
    10194       end.
    10195       assign
    10196         p-field-list = "":U
    10197         v-delim-key  = "":U
    10198         v-count-fld  = 0
    10199       .
    10200       block_where:
    10201       do v-ind = 1 to v-idx-field-qnty by 2
    10202       on error undo, return error
    10203       :
    10204         assign
    10205           v-count-fld = v-count-fld + 1
    10206         .
    10207         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
    10208         if v-ind = 1 then do:
    10209           assign
    10210             v-delim-key = chr(3)
    10211           .
    10212         end.
    10213       end.
    10214       delete object bh_tbl-name.
    10215     end.
    10216   end procedure.
    10217   function AddUtdErrForTab returns logical
    10218   (idb-num         as integer ,
    10219    idoc-id         as integer ,
    10220    iTab            as character,
    10221    iObj            as handle ,
    10222    iCheckType      as character,
    10223    iCodeErr        as character,
    10224    iCheckObj       as character ):
    10225      define buffer utd-err for utd-err.
    10226      define buffer utd for utd.
    10227      find first utd where utd.db-num     eq idb-num
    10228                       and utd.doc-id     eq idoc-id
    10229                       and utd.Direction  eq 'Outbound'
    10230      no-lock no-error.
    10231      if available utd
    10232      then
    10233         return no.
    10234      define variable vRecKey as character no-undo.
    10235            run gen-key-rec (input iTab,
    10236                             input  iObj,
    10237                             output vRecKey).
    10238      find first utd-err where utd-err.db-num     eq idb-num
    10239                           and utd-err.doc-id     eq idoc-id
    10240                           and utd-err.CheckType  eq iCheckType
    10241                           and utd-err.CodeErr    eq iCodeErr
    10242                           and utd-err.CheckObj   eq iCheckObj
    10243      exclusive-lock no-error.
    10244      if not available utd-err
    10245      then do:
    10246         create utd-err.
    10247         assign
    10248            utd-err.db-num         = idb-num
    10249            utd-err.doc-id         = idoc-id
    10250            utd-err.CheckType      = iCheckType
    10251            utd-err.CodeErr        = iCodeErr
    10252            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
    10253            utd-err.reckey         = vRecKey
    10254            utd-err.qnty           = 1
    10255         .
    10256      end.
    10257      else
    10258         utd-err.qnty = utd-err.qnty + 1.
    10259      return utd-err.qnty eq 1.
    10260   end.
    10261   function AddUtdErr returns logical
    10262   (idb-num         as integer ,
    10263    idoc-id         as integer ,
    10264    iObj            as handle ,
    10265    iCheckType      as character,
    10266    iCodeErr        as character,
    10267    iCheckObj       as character ):
    10268      AddUtdErrForTab
    10269         (idb-num,
    10270          idoc-id,
    10271          iObj:table,
    10272          iObj,
    10273          iCheckType,
    10274          iCodeErr,
    10275          iCheckObj).
    10276   end.
    10277   function ClearUtdErrTypeCode returns logical
    10278   (idb-num         as integer,
    10279    idoc-id         as integer ,
    10280    iCheckType      as character,
    10281    iCodeErr        as character
    10282    ):
    10283      define buffer utd-err for utd-err.
    10284      if    iCheckType eq "*"
    10285         or iCheckType eq ?
    10286      then do:
    10287         if     iCodeErr ne ?
    10288            and iCodeErr ne "*"
    10289         then
    10290            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
    10291            view-as alert-box.
    10292         else
    10293         for each utd-err where utd-err.db-num  eq idb-num
    10294                            and utd-err.doc-id  eq idoc-id
    10295         exclusive-lock:
    10296            delete utd-err.
    10297         end.
    10298      end.
    10299      else do:
    10300         if    iCodeErr eq ?
    10301            or iCodeErr eq "*"
    10302         then do:
    10303            for each utd-err where utd-err.db-num     eq idb-num
    10304                               and utd-err.doc-id     eq idoc-id
    10305                               and utd-err.CheckType  eq iCheckType
    10306            exclusive-lock:
    10307               delete utd-err.
    10308            end.
    10309         end.
    10310         else do:
    10311            for each utd-err where utd-err.db-num     eq idb-num
    10312                               and utd-err.doc-id     eq idoc-id
    10313                               and utd-err.CheckType  eq iCheckType
    10314                               and ub.utd-err.CodeErr eq iCodeErr
    10315            exclusive-lock:
    10316               delete utd-err.
    10317            end.
    10318         end.
    10319      end.
    10320   end.
    10321   function ClearUtdErr returns logical
    10322   (idb-num         as integer,
    10323    idoc-id         as integer ,
    10324    iCheckType      as character
    10325    ):
    10326      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
    10327   end.
    10328   function GetMesError returns character
    10329   (itxt as character,
    10330    iobj as character ):
    10331    define variable vi as integer no-undo.
    10332    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
    10333       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
    10334    end.
    10335    return itxt.
    10336   end.
    10337   function GetTextErrorType returns character
    10338   (iCheckType as character,
    10339    iCodeErr   as character,
    10340    iChechObj  as character,
    10341    iType      as character  ):
    10342      define buffer code    for code.
    10343      define variable vError as character no-undo.
    10344      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
    10345                        and code.code   eq iCodeErr
    10346      no-lock no-error.
    10347      if available code
    10348      then do:
    10349         define variable vType as integer no-undo.
    10350         if code.misc3 eq "error"
    10351         then
    10352            vType = 0.
    10353         else if code.misc3 eq "warning"
    10354         then
    10355            vType = 1.
    10356         else if code.misc3 eq "Hiden"
    10357         then
    10358            vType = 2.
    10359         else
    10360            vtype = int(code.misc3) no-error.
    10361         case itype:
    10362            when "error"
    10363            then do:
    10364               if vtype eq 0
    10365               then
    10366                  vError = GetMesError(Code.CodeValue,iChechObj).
    10367            end.
    10368            when "warning"
    10369            then do:
    10370               if vtype <= 1
    10371               then
    10372                  vError = GetMesError(Code.CodeValue,iChechObj).
    10373            end.
    10374            otherwise do:
    10375               vError = GetMesError(Code.CodeValue,iChechObj).
    10376            end.
    10377         end.
    10378      end.
    10379      else
    10380         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
    10381      return vError.
    10382   end.
    10383   function GetTypeError returns integer
    10384   (iCheckType as character,
    10385    iCodeErr   as character):
    10386      define buffer code    for code.
    10387      define variable vType as integer no-undo.
    10388      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
    10389                        and code.code   eq iCodeErr
    10390      no-lock no-error.
    10391      if     not available code
    10392         and code.misc3 eq "error"
    10393      then
    10394         vType = 0.
    10395      else if code.misc3 eq "warning"
    10396      then
    10397         vType = 1.
    10398      else if code.misc3 eq "Hiden"
    10399      then
    10400         vType = 2.
    10401      else
    10402         vtype = int(code.misc3) no-error.
    10403      return vtype.
    10404   end.
    10405   function GetTextError returns character
    10406   (iCheckType as character,
    10407    iCodeErr   as character,
    10408    iChechObj  as character ):
    10409      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
    10410   end.
    10411   function GetErrForUtdStr returns character
    10412   (idb-num     as integer ,
    10413    idoc-id     as integer ,
    10414    iCheckType  as character
    10415    ):
    10416      define buffer utd-err for utd-err.
    10417      define buffer code    for code.
    10418      define variable vHQry as handle no-undo.
    10419      define variable vError as longchar no-undo.
    10420      define variable vErrorOne as longchar  no-undo.
    10421      define variable oError as character no-undo.
    10422      create query vHQry.
    10423      vHQry:set-buffers(buffer utd-err:handle).
    10424      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
    10425                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
    10426                               + if    iCheckType eq "*"
    10427                                    or iCheckType eq ?
    10428                                 then       ""
    10429                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
    10430      vHQry:query-open().
    10431      vHQry:get-first().
    10432      QRY-BLOCK:
    10433      repeat while not vHQry:query-off-end:
    10434         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
    10435         if     vErrorOne ne ""
    10436            and vErrorOne ne ?
    10437         then
    10438            vError = vError + ", " + vErrorOne.
    10439         vHQry:get-next().
    10440      end.
    10441      oError = substring(vError,3,4002).
    10442      return oError.
    10443   end.
    10444   function GetErrJsonForUtd returns character
    10445   (idb-num         as integer ,
    10446    idoc-id         as integer ,
    10447    iCheckType      as character
    10448    ):
    10449      define buffer utd-err for utd-err.
    10450      define variable vHQry as handle no-undo.
    10451      define variable vError as longchar no-undo.
    10452      define variable oError as character no-undo.
    10453      create query vHQry.
    10454      define variable vi as integer no-undo.
    10455      vHQry:set-buffers(buffer utd-err:handle).
    10456      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
    10457                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
    10458                               + if    iCheckType eq "*"
    10459                                    or iCheckType eq ?
    10460                                 then       ""
    10461                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
    10462      vHQry:query-open().
    10463      vHQry:get-first().
    10464      QRY-BLOCK:
    10465      repeat while not vHQry:query-off-end:
    10466         define variable vErrorOne as character no-undo.
    10467         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
    10468         if     vErrorOne ne ?
    10469            and vErrorOne ne ""
    10470         then do:
    10471            vi = vi + 1.
    10472            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
    10473                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
    10474                            + '","ТекстОш":"' + vErrorOne + '"}'.
    10475         end.
    10476         vHQry:get-next().
    10477      end.
    10478      for first utd where utd.db-num eq idb-num
    10479                      and utd.doc-id eq idoc-id
    10480                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
    10481      no-lock,
    10482         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
    10483                                  and utd-marking-lines.doc-id eq idoc-id
    10484                                  and utd-marking-lines.doc-level eq 1
    10485      no-lock,
    10486         first marking where marking.mark eq utd-marking-lines.mark
    10487                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
    10488      no-lock:
    10489         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
    10490         if     vErrorOne ne ?
    10491            and vErrorOne ne ""
    10492         then do:
    10493            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
    10494                            + '","ОбъектОш":"' + marking.mark
    10495                            + '","ТекстОш":"' + vErrorOne + '"}'.
    10496         end.
    10497      end.
    10498      if vError ne ""
    10499      then
    10500         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
    10501      return oError.
    10502   end.
    10503   function GetErrJsonForUtdReturn returns character
    10504   (idb-num         as integer ,
    10505    idoc-id         as integer ,
    10506    iCheckType      as character
    10507    ):
    10508      define buffer utd-err for utd-err.
    10509      define variable vHQry as handle no-undo.
    10510      define variable vError as longchar no-undo.
    10511      define variable oError as character no-undo.
    10512      define variable vi as integer no-undo.
    10513      create query vHQry.
    10514      vHQry:set-buffers(buffer utd-err:handle).
    10515      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
    10516                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
    10517                               + if    iCheckType eq "*"
    10518                                    or iCheckType eq ?
    10519                                 then       ""
    10520                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
    10521      vHQry:query-open().
    10522      vHQry:get-first().
    10523      QRY-BLOCK:
    10524      repeat while not vHQry:query-off-end:
    10525         define variable vErrorOne as character no-undo.
    10526         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
    10527         if     vErrorOne ne ?
    10528            and vErrorOne ne ""
    10529         then do:
    10530            vi = vi + 1.
    10531            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
    10532                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
    10533                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
    10534         end.
    10535         vHQry:get-next().
    10536      end.
    10537      if vError ne ""
    10538      then
    10539         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
    10540      return oError.
    10541   end.
    10542   function GetCodeTextError returns character
    10543   (iCheckType as character,
    10544    iCodeErr   as character,
    10545    iChechObj  as character,
    10546    output oCode as character,
    10547    output ovalue as character ):
    10548      define buffer code    for code.
    10549      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
    10550                        and code.code   eq iCodeErr
    10551      no-lock no-error.
    10552      if     available code
    10553      then do:
    10554         define variable vi as integer no-undo init ?.
    10555         vi = int(Code.misc3) no-error.
    10556         if    code.misc3 ne "error"
    10557            and vi ne 0
    10558         then
    10559            oCode = ?.
    10560         else if     Code.misc1 ne ?
    10561                 and Code.misc1 ne ""
    10562         then
    10563            assign
    10564               oCode  = GetMesError(Code.misc1,iChechObj)
    10565               ovalue = GetMesError(Code.misc2,iChechObj)
    10566            .
    10567      end.
    10568      return if oCode eq ""
    10569             then ""
    10570             else (oCode + "_" + ovalue).
    10571   end.
    10572   define temp-table TT-err no-undo
    10573     field code_ as character
    10574     field text_ as character
    10575   index code_ code_.
    10576   function GetErrTxtForUtd returns character
    10577   (idb-num         as integer ,
    10578    idoc-id         as integer ,
    10579    iCheckType      as character
    10580    ):
    10581      define buffer utd-err for utd-err.
    10582      define variable vHQry as handle no-undo.
    10583      define variable oError as character no-undo.
    10584      create query vHQry.
    10585      define variable vi as integer no-undo.
    10586      for each tt-err :
    10587         delete tt-err.
    10588      end.
    10589      vHQry:set-buffers(buffer utd-err:handle).
    10590      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
    10591                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
    10592                               + if    iCheckType eq "*"
    10593                                    or iCheckType eq ?
    10594                                 then       ""
    10595                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
    10596      vHQry:query-open().
    10597      vHQry:get-first().
    10598      define variable vcode as character no-undo.
    10599      define variable vvalue as character no-undo.
    10600      QRY-BLOCK:
    10601      repeat while not vHQry:query-off-end:
    10602         vi = vi + 1.
    10603         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
    10604         if vcode ne ?
    10605         then do:
    10606            find first tt-err where tt-err.code eq vcode
    10607            no-error.
    10608            if not available tt-err
    10609            then do:
    10610               create tt-err.
    10611               assign
    10612                  tt-err.code_ = vcode
    10613                  tt-err.text_ = vvalue
    10614               .
    10615            end.
    10616            else
    10617               tt-err.text_ = tt-err.text_ + "||" + vvalue.
    10618         end.
    10619         vHQry:get-next().
    10620      end.
    10621     find first utd where utd.db-num eq idb-num
    10622                         and utd.doc-id eq idoc-id
    10623         no-lock.
    10624      define buffer cancel_utd-lines for utd-lines.
    10625      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
    10626                                  and cancel_utd-lines.doc-id eq idoc-id
    10627      no-lock:
    10628         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
    10629         then do:
    10630            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
    10631                                        and utd-marking-lines.doc-id eq idoc-id
    10632                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
    10633            no-lock,
    10634               first marking where marking.mark eq utd-marking-lines.mark
    10635                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
    10636            no-lock:
    10637               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
    10638               find first tt-err where tt-err.code eq vcode
    10639               no-error.
    10640               if not available tt-err
    10641               then do:
    10642                  create tt-err.
    10643                  assign
    10644                     tt-err.code_ = vcode
    10645                     tt-err.text_ = vvalue
    10646                  .
    10647               end.
    10648               else
    10649                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
    10650            end.
    10651         end.
    10652         else do:
    10653            define variable vqnty as decimal no-undo.
    10654            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
    10655            if vqnty eq ? then vqnty = 0.
    10656            if vqnty ne cancel_utd-lines.Quantity
    10657            then do:
    10658               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
    10659               find first tt-err where tt-err.code eq vcode
    10660               no-error.
    10661               if not available tt-err
    10662               then do:
    10663                  create tt-err.
    10664                  assign
    10665                     tt-err.code_ = vcode
    10666                     tt-err.text_ = vvalue
    10667                  .
    10668               end.
    10669               else
    10670                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
    10671            end.
    10672         end.
    10673      end.
    10674      for each tt-err:
    10675         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
    10676      end.
    10677      return oError.
    10678   end.
    10679   define variable mFormatErr as character no-undo init "text".
    10680   function GetErrForUtd returns character
    10681   (idb-num         as integer ,
    10682    idoc-id         as integer ,
    10683    iType           as character
    10684    ):
    10685      if mFormatErr eq "text"
    10686      then
    10687         return GetErrTxtForUtd(idb-num,idoc-id,iType).
    10688      else do:
    10689         if itype eq "return"
    10690         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
    10691         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
    10692      end.
    10693   end.
    10694   function GetErrComText returns longchar
    10695   (icomment as character,
    10696    itext    as longchar ):
    10697       define variable vText as longchar no-undo.
    10698      if mFormatErr eq "text"
    10699      then do:
    10700         if icomment ne ""
    10701         then
    10702            icomment = substitute("comment:|&1|",icomment).
    10703         vText = icomment + itext.
    10704      end.
    10705      else do:
    10706         icomment = if icomment begins  '"'
    10707                    then icomment
    10708                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
    10709         vText = icomment + "," + itext.
    10710         vText = "~{" + trim(vText,",") + "~}".
    10711      end.
    10712      return vText.
    10713   end.
    10714   function CheckTypeForMarkLineType returns logical
    10715   (iObj            as handle,
    10716    iCheckType      as character,
    10717    iCodeErr        as character ,
    10718    iTypeErr        as character ):
    10719      define variable vRecKey-markLine as character no-undo.
    10720      define variable vGoodMark        as logical no-undo.
    10721      define variable vdb-num          as integer no-undo.
    10722      define variable vdoc-id          as integer no-undo.
    10723      define variable vlinenum         as integer no-undo.
    10724      define variable vErrorOne as character no-undo.
    10725      define buffer buf_utd-err for utd-err.
    10726      run gen-key-rec (input "utd-marking-lines",
    10727                       input  iObj,
    10728                       output vRecKey-markLine).
    10729      vGoodMark = yes.
    10730      vdb-num = iObj::db-num.
    10731      vdoc-id = iObj::doc-id.
    10732      vlinenum = iObj::linenum.
    10733      block-mark-err:
    10734      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
    10735                               and buf_utd-err.db-num = vdb-num
    10736                               and buf_utd-err.reckey = vRecKey-markLine
    10737                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
    10738                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
    10739      no-lock:
    10740         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
    10741         if     vErrorOne ne ?
    10742            and vErrorOne ne ""
    10743         then do:
    10744            vGoodMark = no.
    10745            leave block-mark-err.
    10746         end.
    10747      end.
    10748      return not vGoodMark.
    10749   end.
    10750   function CheckErrForMarkLineType returns logical
    10751   (iObj            as handle,
    10752    iType           as character  ):
    10753      return CheckTypeForMarkLineType (iObj,iType,"*","error").
    10754   end.
    10755   function CheckErrForMarkLine returns logical
    10756   (iObj            as handle):
    10757      return CheckErrForMarkLineType(iObj,"*").
    10758   end.
    10759   function CheckErrForLineTypeCode returns logical
    10760   (iObj                 as handle,
    10761    iCheckType           as character,
    10762    iCodeErr             as character,
    10763    iTypeErr             as character,
    10764    iOneErr              as logical):
    10765      define variable vRecKey-line     as character no-undo.
    10766      define buffer buf_utd-err for utd-err.
    10767      define variable vUtdlineError as logical no-undo.
    10768      define variable vErrorOne as character no-undo.
    10769            run gen-key-rec (input "utd-lines",
    10770                             input  iObj,
    10771                             output vRecKey-line).
    10772         define variable vdb-num as integer no-undo.
    10773         define variable vdoc-id as integer no-undo.
    10774         define variable vlinenum as integer no-undo.
    10775         vdb-num = iObj::db-num.
    10776         vdoc-id = iObj::doc-id.
    10777         vlinenum = iObj::linenum.
    10778         block-err:
    10779         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
    10780                                  and buf_utd-err.db-num = vdb-num
    10781                                  and buf_utd-err.reckey = vRecKey-line
    10782                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
    10783                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
    10784         no-lock:
    10785            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
    10786            if     vErrorOne ne ?
    10787               and vErrorOne ne ""
    10788            then do:
    10789               vUtdlineError = yes.
    10790               leave block-err.
    10791            end.
    10792         end.
    10793         if  not vUtdlineError
    10794         then do:
    10795            define variable vGoodMark as logical no-undo.
    10796            vGoodMark = yes.
    10797            block-line-err:
    10798            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
    10799                                         and utd-marking-lines.doc-id  eq vdoc-id
    10800                                         and utd-marking-lines.LineNum eq vLineNum
    10801            no-lock:
    10802               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
    10803               if     vGoodMark
    10804                  and iOneErr eq no
    10805               then
    10806                  leave block-line-err.
    10807               if     iOneErr = yes
    10808                  and not vGoodMark
    10809               then
    10810                  leave block-line-err.
    10811            end.
    10812            vUtdlineError = not vGoodMark.
    10813         end.
    10814      return vUtdlineError.
    10815   end.
    10816   function getErrForLineType returns character
    10817   (iObj            as handle,
    10818    iType           as character  ):
    10819      define variable vRecKey-line     as character no-undo.
    10820      define buffer buf_utd-err for utd-err.
    10821      define variable vUtdlineError as logical no-undo.
