    11968               skip return-value
    11969               skip trim( error-status :get-message( 1 ) )
    11970               trim( error-status :get-message( 2 ) )
    11971               trim( error-status :get-message( 3 ) )
    11972               view-as alert-box error.
    11973            undo, return no-apply.
