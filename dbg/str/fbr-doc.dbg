    16662      case ingr-sort-column-name :
    16663         when ""
    16664         then
    16665            do:
    16666               assign
    16667                  ingr-sort-column-phrase = ""
    16668                  .
    16669            end.
    16670         when "ingr-unit"
    16671         then
    16672            do:
    16673               assign
    16674                  ingr-sort-column-phrase = "by (recid(buf_ingr_fbr-line))"
    16675                  .
    16676            end.
    16677         when "ingr-name"
    16678         then
    16679            do:
    16680               assign
    16681                  ingr-sort-column-phrase = "by get-goods-name(recid(buf_ingr_fbr-line))"
    16682                  .
    16683            end.
    16684         when "ingr-OK"
    16685         then
    16686            do:
    16687               assign
    16688                  ingr-sort-column-phrase = "by get-line-OK(recid(buf_ingr_fbr-line))"
    16689                  .
    16690            end.
    16691         when "ingr-prod"
    16692         then
    16693            do:
    16694               assign
    16695                  ingr-sort-column-phrase = "by get-prod-ref(recid(buf_ingr_fbr-line))"
    16696                  .
    16697            end.
    16698         otherwise
    16699         do:
    16700            assign
    16701               ingr-sort-column-phrase = "by " + ingr-sort-column-name
    16702               .
    16703         end.
    16704      end case.
