    13712   define variable vss-include-info94 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13713   procedure minbtn-set :
    13714       do
    13715           on error undo, return error return-value
    13716           :
    13717           define variable ii              as integer       no-undo .
    13718           define variable fh              as widget-handle no-undo .
    13719           define variable hh              as widget-handle no-undo .
    13720           define variable v-h             as handle        extent 4 no-undo .
    13721           define variable v-name-button   as character     no-undo .
    13722           define variable v-help-old-x    as decimal       no-undo .
    13723           define variable v-help-old-y    as decimal       no-undo .
    13724           define variable v-help-old-size as decimal       no-undo .
    13725           define variable v-frame-width   as decimal       no-undo .
    13726           define variable jj              as integer       no-undo .
    13727           do
    13728               on error undo, return error
    13729               :
    13730               assign
    13731                   v-frame-width = frame D-FBR-DOC:width - 0.3
    13732                   fh            = frame D-FBR-DOC:first-child
    13733                   hh            = fh:first-child
    13734                   ii            = 1
    13735                   .
    13736               do while valid-handle(hh):
    13737                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
    13738                   do:
    13739                       case lc(hh:name) :
    13740                           when "b-help" then
    13741                               do:
    13742                                   hh:load-image-up("cmp/b-help.bmp":u) .
    13743                                   hh:load-image-down("cmp/b-help.bmp":u) .
    13744                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
    13745                                   hh:TOOLTIP = "Помощь" .
    13746                                   v-help-old-x = hh:column .
    13747                                   v-help-old-y = hh:row    .
    13748                                   v-help-old-size = hh:width .
    13749                                   hh:width-chars = 2.5 .
    13750                               end.
    13751                           when "b-print" then
    13752                               do:
    13753                                   hh:load-image("cmp/b-print.bmp":u) .
    13754                                   hh:TOOLTIP = "Печать" .
    13755                                   v-h[ii] = hh:handle .
    13756                                   ii = ii + 1 .
    13757                                   hh:width-chars = 3 .
    13758                               end.
    13759                           when "b-history" or
    13760                           when "b-hist" then
    13761                               do:
    13762                                   hh:load-image("cmp/b-hist.bmp":u) .
    13763                                   hh:TOOLTIP = "История" .
    13764                                   v-h[ii] = hh:handle .
    13765                                   ii = ii + 1 .
    13766                                   hh:width-chars = 3 .
    13767                               end.
    13768                           when "b-sch" then
    13769                               do:
    13770                                   hh:load-image("cmp/b-sch.bmp":u) .
    13771                                   hh:TOOLTIP = "Установка Фильтра" .
    13772                                   v-h[ii] = hh:handle .
    13773                                   ii = ii + 1 .
    13774                                   hh:width-chars = 3 .
    13775                               end.
    13776                           when "b-hist-user" then
    13777                               do:
    13778                                   hh:load-image("cmp/b-hist.bmp":u) .
    13779                                   hh:TOOLTIP = "История пользователя" .
    13780                                   ii = ii + 1 .
    13781                               end.
    13782                       end case.
    13783                   end.
    13784                   hh = hh:next-sibling.
    13785               end.
    13786               b-help:column = v-frame-width - b-help:width-chars.
    13787               jj = 0.
    13788               repeat ii = 4 to 1 by -1 :
    13789                   if valid-handle (v-h[ii] ) then
    13790                   do:
    13791                       jj  = jj + 1 .
    13792                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
    13793                       v-h[ii]:row    = v-help-old-y .
    13794                   end.
    13795               end.
    13796           end.
    13797       end.
    13798   end procedure.
    13799   def var sort-labelbr-comp   as character no-undo .
    13800   def var sort-clmnbr-comp    as handle    no-undo .
    13801   def var cur-clmnbr-comp     as handle    no-undo .
    13802   def var cur-clmn-locbr-comp as integer   no-undo .
    13803   def var re-querybr-comp     as logical   initial no no-undo .
    13804   on start-search, ctrl-o of br-comp in frame D-FBR-DOC do:
    13805      run sort-brbr-comp
    13806        (input (if available buf_comp_fbr-line
    13807                then recid(buf_comp_fbr-line)
    13808                else ?
    13809               )
    13810        ).
    13811   end.
    13812   PROCEDURE sort-brbr-comp :
    13813     define input parameter p-recid as recid no-undo .
    13814     if re-querybr-comp = no then do:
    13815       assign
    13816          cur-clmnbr-comp = br-comp:current-column in frame D-FBR-DOC
    13817       .
    13818       if sort-clmnbr-comp <> ? then sort-clmnbr-comp:column-fgcolor = 0.
    13819       if cur-clmnbr-comp = sort-clmnbr-comp then do:
    13820         assign
    13821            sort-labelbr-comp = ""
    13822            sort-clmnbr-comp = ?
    13823         .
    13824        end.
    13825        else do:
    13826          assign
    13827            sort-labelbr-comp = cur-clmnbr-comp:label
    13828            sort-clmnbr-comp  = cur-clmnbr-comp
    13829            sort-clmnbr-comp:column-fgcolor = 4
    13830          .
    13831        end.
    13832      end.
    13833     assign
    13834       cur-clmn-locbr-comp = 1
    13835     .
    13836     def var column-handle as handle no-undo .
    13837     column-handle = br-comp:first-column.
    13838     do while valid-handle(column-handle) :
    13839       if column-handle = cur-clmnbr-comp then do:
    13840         leave .
    13841       end.
    13842       column-handle = column-handle:NEXT-COLUMN.
    13843       assign
    13844         cur-clmn-locbr-comp = cur-clmn-locbr-comp + 1
    13845       .
    13846     end.
    13847     case sort-labelbr-comp:
    13848           when comp-name:label in browse br-comp then DO:   assign       comp-sort-column-name = substitute('dynamic-function(&1get-goods-name&1,recid(buf_comp_fbr-line))',chr(34))     .     run open-comp.   . END.
    13849           when buf_comp_fbr-line.trn-type:label in browse br-comp then DO:    assign       comp-sort-column-name = "buf_comp_fbr-line.trn-type"     .     run open-comp.   . END.
    13850           when comp-OK:label in browse br-comp then DO:   assign       comp-sort-column-name = substitute('dynamic-function(&1get-line-OK&1,recid(buf_comp_fbr-line))',chr(34))     .     run open-comp.   . END.
    13851           when buf_comp_fbr-line.fact-qnty:label in browse br-comp then DO:    assign       comp-sort-column-name = "buf_comp_fbr-line.fact-qnty"     .     run open-comp.   . END.
    13852           when comp-unit:label in browse br-comp then DO:   assign       comp-sort-column-name = substitute('dynamic-function(&1get-unit-base&1,recid(buf_comp_fbr-line))',chr(34))     .     run open-comp.   . END.
    13853           when buf_comp_fbr-line.is-calc:label in browse br-comp then DO:    assign       comp-sort-column-name = "buf_comp_fbr-line.is-calc"     .     run open-comp.   . END.
    13854           when buf_comp_fbr-line.price-sale:label in browse br-comp then DO:    assign       comp-sort-column-name = "buf_comp_fbr-line.price-sale"     .     run open-comp.   . END.
    13855           when buf_comp_fbr-line.fix-cost:label in browse br-comp then DO:    assign       comp-sort-column-name = "buf_comp_fbr-line.fix-cost"     .     run open-comp.   . END.
    13856           when buf_comp_fbr-line.price-base:label in browse br-comp then DO:    assign       comp-sort-column-name = "buf_comp_fbr-line.price-base"     .     run open-comp.   . END.
    13857           when buf_comp_fbr-line.price-rubl:label in browse br-comp then DO:    assign       comp-sort-column-name = "buf_comp_fbr-line.price-rubl"     .     run open-comp.   . END.
    13858           when buf_comp_fbr-line.rsrv-qnty:label in browse br-comp then DO:    assign       comp-sort-column-name = "buf_comp_fbr-line.rsrv-qnty"     .     run open-comp.   . END.
    13859           when comp-prod:label in browse br-comp then DO:   assign       comp-sort-column-name = substitute('dynamic-function(&1get-prod-ref&1,recid(buf_comp_fbr-line))',chr(34))     .     run open-comp.   . END.
    13860       otherwise do:
    13861         assign
    13862           comp-sort-column-name = ""
    13863         .
    13864         run open-comp.
    13865         if sort-labelbr-comp <> "" then do:
    13866           assign
    13867             cur-clmnbr-comp:column-fgcolor = 0
    13868           .
    13869         end.
    13870         assign
    13871           cur-clmn-locbr-comp = ?
    13872         .
    13873       end.
    13874     end case.
    13875     if p-recid <> ? then do:
    13876       reposition br-comp to recid p-recid no-error.
    13877       apply "value-changed" to br-comp in frame D-FBR-DOC.
    13878     end.
    13879     apply "entry" to br-comp in frame D-FBR-DOC.
    13880   END PROCEDURE.
    13881   procedure re-open-query-srt-clmnbr-comp:
    13882   if cur-clmnbr-comp = ? then do:
    13883      run open-comp.
    13884   end.
    13885   else do:
    13886      assign re-querybr-comp = yes.
    13887      run sort-brbr-comp
    13888        (input (if available buf_comp_fbr-line
    13889                then recid(buf_comp_fbr-line)
    13890                else ?
    13891               )
    13892        ).
    13893      assign re-querybr-comp = no.
    13894   end.
    13895   end.
    13896   def var sort-labelbr-ingr   as character no-undo .
    13897   def var sort-clmnbr-ingr    as handle    no-undo .
    13898   def var cur-clmnbr-ingr     as handle    no-undo .
    13899   def var cur-clmn-locbr-ingr as integer   no-undo .
    13900   def var re-querybr-ingr     as logical   initial no no-undo .
    13901   on start-search, ctrl-o of br-ingr in frame D-FBR-DOC do:
