    14241   hbrowse = browse br-ingr:handle.
    14242   extent (bcol) = hbrowse:num-columns.
    14243   bcol[1] = hbrowse:first-column.
    14244   do ii = 1 to extent (bcol).
    14245     bcol[ii] = hbrowse:get-browse-column (ii).
    14246   end.
    14247   hbrowse_comp = browse br-comp:handle.
    14248   extent (bcol_comp) = hbrowse_comp:num-columns.
    14249   bcol_comp[1] = hbrowse_comp:first-column.
    14250   do ii = 1 to extent (bcol_comp).
    14251     bcol_comp[ii] = hbrowse_comp:get-browse-column (ii).
    14252   end.
    14253   assign
    14254      p-fbr-doc-next-prev = yes
    14255      .
    14256   n-p:
    14257   do while p-fbr-doc-next-prev
    14258      :
    14259      MAIN-BLOCK:
    14260      DO
    14261         ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
    14262         ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
    14263         :
    14264         run writelog in this-procedure (log-file-name, 0, "&DLine").
    14265         run writelog in this-procedure (log-file-name, 1, "Запуск блока Производства").
    14266         if p-doc-mode <> 'ДОБАВЛЕНИЕ':U
    14267            then
    14268         do:
    14269            define variable v-fbroperator-string as character no-undo.
    14270            define variable v-fbrpaycode-string  as character no-undo.
    14271            run str/fbrattrv.p (
    14272               input f-doc.doc-code
    14273               , input 'fbroperator':U
    14274               , output v-fbroperator-string
    14275               ) no-error.
    14276            if error-status :error
    14277               then
    14278            do:
    14279               message
    14280                  vss-workfile vss-revision vss-description
    14281                  skip(1)
    14282                  skip
    14283                  "Ошибка определения оператора производства."
    14284                  skip(1)
    14285                  skip
    14286                  "Выберите ответственного за операции производства."
    14287                  skip return-value
    14288                  skip trim(error-status :get-message(1))
    14289                  trim(error-status :get-message(2))
    14290                  trim(error-status :get-message(3))
    14291                  view-as alert-box warning.
    14292               assign
    14293                  v-fbr-doc-fbroperator-code = 0
    14294                  .
    14295            end.
    14296            assign
    14297               v-fbr-doc-fbroperator-code = integer( v-fbroperator-string )
    14298               no-error.
    14299            if error-status :error
    14300               then
    14301            do:
    14302               assign
    14303                  v-fbr-doc-fbroperator-code = 0
    14304                  .
    14305            end.
    14306            else
    14307            do:
    14308               define buffer buf_clients for ub.clients.
    14309               find first buf_clients no-lock
    14310                  where buf_clients.obj-type = 'чел':U
    14311                  and buf_clients.obj-code = v-fbr-doc-fbroperator-code
    14312                  no-error.
    14313               if not available buf_clients
    14314                  then
    14315               do:
    14316                  assign
    14317                     v-fbr-doc-fbroperator-code = 0
    14318                     .
    14319               end.
    14320            end.
    14321            if f-doc.pay-code = ?
    14322               or f-doc.pay-code = 0
    14323               then
    14324            do:
    14325   define variable vss-include-info98 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14326   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdnpay in g#library
    14327     (input  f-doc.obj-type
    14328     ,input  f-doc.obj-code
    14329     ,output fi-pay-code
    14330     )  .
    14331            end.
    14332            else
