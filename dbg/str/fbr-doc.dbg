    11893   else do:
    11894     apply "entry":u to self  .
    11895     if focus :handle <> self :handle  then do:
    11896       return no-apply .
    11897     end.
    11898   end.
    11899         define variable v-can-continue as logical no-undo.
    11900         define buffer buf_fbr-line for ub.fbr-line.
    11901         if f-doc.is-free = no
    11902            and p-doc-mode <> 'ПРОСМОТР':U
    11903            then
    11904         do:
    11905            for each buf_fbr-line no-lock
    11906               where buf_fbr-line.doc-code = f-doc.doc-code
    11907               and buf_fbr-line.is-comp  = yes
    11908               :
    11909               run check-and-correct-fbr-recipe in this-procedure (
    11910                  input f-doc.doc-code
    11911                  , input buf_fbr-line.recipe-code
    11912                  , output v-can-continue
    11913                  ) no-error.
    11914               if error-status :error
    11915                  then
    11916               do:
    11917                  message
    11918                     vss-workfile vss-revision vss-description
    11919                     skip
    11920                     "Ошибка проверки соответствия"
    11921                     skip
    11922                     "строк рецепта документа и строк документа."
    11923                     skip(1)
    11924                     skip
    11925                     "Рецепт:" buf_fbr-line.recipe-code
    11926                     skip return-value
    11927                     skip trim(error-status :get-message(1))
    11928                     trim(error-status :get-message(2))
    11929                     trim(error-status :get-message(3))
    11930                     view-as alert-box error.
    11931                  undo, return no-apply.
    11932               end.
    11933               if v-can-continue = no
    11934                  then
    11935               do:
    11936                  undo, return no-apply.
    11937               end.
    11938            end.
    11939            assign
    11940               fi-pay-code
    11941               .
    11942            assign
    11943               f-doc.pay-code = fi-pay-code
    11944               .
    11945         end.
    11946         assign
    11947            p-fbr-doc-next-prev = ?
    11948            v-close-enabled     = yes
    11949            .
    11950         apply "GO" to frame D-FBR-DOC.
    11951      END.
    11952   ON CHOOSE OF b-gds IN FRAME D-FBR-DOC
    11953      DO:
    11954         run assign-current-goods .
    11955         run str/fbr-igds.w (
    11956            input parparentproc
    11957            , input recid( f-doc )
    11958            , input-output gds-rec
    11959            ) no-error.
    11960         if error-status :error
    11961            then
    11962         do:
