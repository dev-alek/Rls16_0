     4616   define variable vss-include-info37 as character format "X(65)" no-undo
     4617   initial "@(#)$Workfile$ $Revision$".
     4618   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4619   FUNCTION check-ban-sales-via-cd return logical ( input p-gds-code as integer ) :
     4620       define variable v-upper-code as int no-undo.
     4621       define variable v-value as character no-undo.
     4622       define variable v-type as character no-undo.
     4623       define buffer lc_gds-grp for ub.gds-grp.
     4624       define buffer lc_goods for ub.goods.
     4625      if p-gds-code <> 0 then do:
     4626       find first lc_goods where lc_goods.gds-code = p-gds-code.
     4627       v-upper-code = lc_goods.grp-code.
     4628       do while v-upper-code > 0 :
     4629           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     4630           run ggoattr-value(
     4631             input lc_gds-grp.node-code,
     4632             input 0,
     4633             input "",
     4634             input 0,
     4635             input 'ban-sales-via-cd':U,
     4636             output v-value,
     4637             output v-type
     4638           ).
     4639          if v-value = "yes" then
     4640             return true.
     4641          else
     4642          do:
     4643             run ggoattr-value(
     4644                input lc_gds-grp.node-code,
     4645                input v-cntxt-host-code-obj,
     4646                input "",
     4647                input 0,
     4648                input 'ban-sales-via-cd':U,
     4649                output v-value,
     4650                output v-type
     4651                ).
     4652             if v-value = "yes" then
     4653                return true.
     4654             else
     4655             do:
     4656                run ggoattr-value(
     4657                   input lc_gds-grp.node-code,
     4658                   input v-cntxt-host-code-obj,
     4659                   input v-cntxt-obj-type,
     4660                   input v-cntxt-obj-code,
     4661                   input 'ban-sales-via-cd':U,
     4662                   output v-value,
     4663                   output v-type
     4664                   ).
     4665                if v-value = "yes" then
     4666                   return true.
     4667                else v-upper-code = lc_gds-grp.upper-code.
     4668             end .
     4669          end.
     4670         end.
     4671       end.
     4672       if v-value = "" or logical(v-value) = false then return false .
     4673   end.
     4674   FUNCTION check-ban-sales-via-cd-grp return logical ( input p-grp-code as integer ) :
     4675       define variable v-upper-code as int no-undo.
     4676       define variable v-value as character no-undo.
     4677       define variable v-type as character no-undo.
