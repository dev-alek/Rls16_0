    12025   ON CHOOSE OF b-parts IN FRAME D-FBR-DOC
    12026      DO:
    12027   define variable vss-include-info66 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12028   if lookup(self :type
    12029            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
    12030            ) = 0
