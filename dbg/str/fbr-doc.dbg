    10856   end.
    10857   function CheckErrForUtd returns logical
    10858   (idb-num         as integer ,
    10859    idoc-id         as integer ):
    10860      for each utd-lines where utd-lines.db-num eq idb-num
    10861                           and utd-lines.doc-id eq idoc-id
    10862      no-lock :
    10863         if not CheckErrForLine (buffer ub.utd-lines:handle)
    10864         then
    10865            return no.
    10866      end.
    10867      return yes.
    10868   end.
    10869   function CheckMarkUtd-28rel return logical
    10870    (input idb-num as integer,
    10871    input idoc-id as integer):
    10872    define buffer utd                   for utd.
    10873    define buffer utd-lines             for utd-lines.
    10874    define buffer utd-marking-lines     for utd-marking-lines.
    10875    define variable v-par-type as character no-undo.
    10876    define variable vgdsNoMark as logical no-undo.
    10877    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
    10878      define variable v-par-val  as character no-undo.
    10879      find first utd where utd.db-num eq idb-num
    10880                       and utd.doc-id eq idoc-id
    10881      no-lock no-error.
    10882      if available utd
    10883      then do:
    10884         if     utd.obj-code ne ?
    10885            and utd.obj-type ne ?
    10886         then do:
    10887            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
    10888            Block-utd-lines:
    10889            for each utd-lines where utd-lines.db-num eq idb-num
    10890                                 and utd-lines.doc-id eq idoc-id
    10891            no-lock:
    10892               if     utd-lines.gds-code ne ?
    10893                  and utd-lines.gds-code ne 0
    10894               then do:
    10895                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
    10896                       ( utd-lines.gds-code,
    10897                         'mark-type':U,
    10898                          output v-par-val,
    10899                          output v-par-type
    10900                       ).
    10901                  if     EDOParSec:IsEdo
    10902                     and EDOParSec:GetIsEDOForType(v-par-val)
    10903                  then do:
    10904                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
    10905                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
    10906                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
    10907                                                    and length(utd-marking-lines.mark) > 13
    10908                     no-lock no-error.
    10909                     if     avail utd-marking-lines
    10910                        and not CheckErrForLine(buffer utd-lines:handle)
    10911                     then
    10912                        leave Block-utd-lines.
    10913                  end.
    10914                  else
    10915                     vgdsNoMark = yes.
    10916               end.
    10917            end.
    10918            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
    10919            if vgdsNoMark then return available utd-lines . else return yes .
    10920         end.
    10921      end.
    10922      return yes.
    10923   end.
    10924   function CheckMarkUtd return logical
    10925    (input idb-num  as integer,
    10926     input idoc-id  as integer):
    10927     define buffer utd-lines             for ub.utd-lines.
    10928     block-line:
    10929     for each utd-lines where utd-lines.db-num eq idb-num
    10930                          and utd-lines.doc-id eq idoc-id
    10931     no-lock:
    10932        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
    10933        then
    10934           leave block-line.
    10935     end.
    10936     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
    10937     return available utd-lines.
    10938   end.
    10939   function CheckNotMarkUtd return logical
    10940    (input idb-num  as integer,
    10941     input idoc-id  as integer):
    10942     define buffer utd-lines             for ub.utd-lines.
    10943     for each utd-lines where utd-lines.db-num eq idb-num
    10944                          and utd-lines.doc-id eq idoc-id
    10945     no-lock:
    10946        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
    10947        then
    10948           return yes.
    10949     end.
    10950     return no.
    10951   end.
    10952   function CheckMarkUtdLine return logical
    10953    (input idb-num  as integer,
    10954     input idoc-id  as integer,
    10955     input iLineNum as integer):
    10956    define buffer utd                   for utd.
    10957    define buffer utd-lines             for utd-lines.
    10958    define buffer utd-marking-lines     for utd-marking-lines.
    10959    define variable v-par-type as character no-undo.
    10960    define variable vMarking        as logical no-undo.
    10961    define variable vArtic          as logical no-undo.
    10962    define variable vTransitional   as logical no-undo.
    10963    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
    10964      define variable v-par-val  as character no-undo.
    10965      find first utd where utd.db-num eq idb-num
    10966                       and utd.doc-id eq idoc-id
    10967      no-lock no-error.
    10968      if available utd
    10969      then do:
    10970         if     utd.obj-code ne ?
    10971            and utd.obj-type ne ?
    10972         then do:
    10973            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
    10974            Block-utd-lines:
    10975            for each utd-lines where utd-lines.db-num   eq idb-num
    10976                                 and utd-lines.doc-id   eq idoc-id
    10977                                 and utd-lines.LineNum  eq iLineNum
    10978            no-lock:
    10979               if     utd-lines.gds-code ne ?
    10980                  and utd-lines.gds-code ne 0
    10981               then do:
    10982                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
    10983                       ( utd-lines.gds-code,
    10984                         'mark-type':U,
    10985                          output v-par-val,
    10986                          output v-par-type
    10987                       ).
    10988                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
    10989                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
    10990                  if vMarking
    10991                  then do:
    10992                     block-marking:
    10993                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
    10994                                                    and utd-marking-lines.doc-id   eq idoc-id
    10995                                                    and utd-marking-lines.LineNum  eq iLineNum
    10996                                                    and length(utd-marking-lines.mark) > 13
    10997                     no-lock:
    10998                        if isOAD(utd-marking-lines.mark)
    10999                        then do:
    11000                           assign
    11001                              vArtic   = yes
    11002                              vMarking = no
    11003                           .
    11004                           leave block-marking.
    11005                        end.
    11006                     end.
    11007                  end.
    11008                  if vArtic
    11009                  then do:
    11010                     block-artic:
    11011                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
    11012                                                    and utd-marking-lines.doc-id   eq idoc-id
    11013                                                    and utd-marking-lines.LineNum  eq iLineNum
    11014                                                    and length(utd-marking-lines.mark) > 13
    11015                     no-lock:
    11016                        if isMark(utd-marking-lines.mark)
    11017                        then do:
    11018                           assign
    11019                              vArtic   = no
    11020                              vMarking = yes
    11021                           .
    11022                           leave block-artic.
    11023                        end.
    11024                     end.
    11025                  end.
    11026                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
    11027                  if vTransitional
    11028                  then do:
    11029                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
    11030                                                    and utd-marking-lines.doc-id   eq idoc-id
    11031                                                    and utd-marking-lines.LineNum  eq iLineNum
    11032                                                    and length(utd-marking-lines.mark) > 13
    11033                     no-lock no-error.
    11034                     if not available utd-marking-lines
    11035                     then assign
    11036                        vMarking = no
    11037                        vArtic   = no
    11038                     .
    11039                  end.
    11040               end.
    11041               else
    11042                  assign
    11043                     vMarking      = yes
    11044                     vArtic        = no
    11045                     vTransitional = no
    11046                  .
    11047               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
    11048               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
    11049               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
    11050            end.
    11051         end.
    11052      end.
    11053      return vMarking or vArtic.
    11054   end.
    11055   function getMarkUtdLine return logical
    11056    (input  idb-num  as integer,
    11057     input  idoc-id  as integer,
    11058     input  iLineNum as integer,
    11059     output oMarking        as logical,
    11060     output oArtic          as logical,
    11061     output oTransitional   as logical):
    11062     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
    11063     oArtic        = not oMarking
    11064            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
    11065     oTransitional = (oMarking or oArtic)
    11066            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
    11067   end.
    11068   function CheckMarking return logical
    11069    (input idb-num as integer,
    11070    input idoc-id as integer,
    11071    input iTypeErr as character ):
    11072     define variable vMarkutd as logical no-undo.
    11073     define variable vCrErr   as logical no-undo.
    11074     define buffer utd-lines         for utd-lines.
    11075     define buffer utd-marking-lines for utd-marking-lines.
    11076     define buffer marking           for marking.
    11077     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
    11078      block-line:
    11079      for each utd-lines where utd-lines.db-num eq idb-num
    11080                           and utd-lines.doc-id eq idoc-id
    11081      no-lock:
    11082         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
    11083         then do:
    11084            for each utd-marking-lines
    11085                     where utd-marking-lines.db-num  = utd-lines.db-num
    11086                       and utd-marking-lines.doc-id  = utd-lines.doc-id
    11087                       and utd-marking-lines.LineNum = utd-lines.LineNum
    11088            no-lock:
    11089               if isMark(utd-marking-lines.mark)
    11090               then do:
    11091                  find first marking where marking.mark eq utd-marking-lines.mark
    11092                  no-lock no-error.
    11093                  if not available marking
    11094                  then do:
    11095                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
    11096                     vCrErr = yes.
    11097                     next block-line.
    11098                  end.
    11099               end.
    11100            end.
    11101         end.
    11102      end.
    11103      return vCrErr.
    11104   end.
    11105   function CheckMarkForType return logical
    11106    (input idb-num   as integer,
    11107     input idoc-id   as integer):
    11108      define variable vMarking        as logical no-undo.
    11109      define variable vArtic          as logical no-undo.
    11110      define variable vTransitional   as logical no-undo.
    11111      define buffer utd-lines         for utd-lines.
    11112      define buffer utd-marking-lines for utd-marking-lines.
    11113      block-line:
    11114      for each utd-lines where utd-lines.db-num eq idb-num
    11115                           and utd-lines.doc-id eq idoc-id
    11116      no-lock:
    11117         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
    11118                          output vMarking         , output vArtic          , output vTransitional).
    11119         for each utd-marking-lines
    11120                     where utd-marking-lines.db-num  = utd-lines.db-num
    11121                       and utd-marking-lines.doc-id  = utd-lines.doc-id
    11122                       and utd-marking-lines.LineNum = utd-lines.LineNum
    11123         no-lock:
    11124            if length(utd-marking-lines.mark) < 14
    11125            then do:
    11126               if (vMarking or vArtic) and not vTransitional
    11127               then
    11128                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
    11129            end.
    11130            else if not isMark(utd-marking-lines.mark)
    11131            then do:
    11132               if vMarking
    11133               then
    11134                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
    11135            end.
    11136            else do:
    11137            end.
    11138         end.
    11139      end.
    11140   end.
    11141   function WeighedProd return logical
    11142      ( input p-gds-code as integer) :
    11143      define variable v-par-val  as character no-undo.
    11144      define variable v-par-type as character no-undo.
    11145              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
    11146               ( p-gds-code,
    11147                 'weighed-gds':U,
    11148                  output v-par-val,
    11149                  output v-par-type
    11150               ).
    11151      return logical(v-par-val).
    11152   end.
    11153   function WghProdVariable return logical
    11154       (input p-obj-type as char,
    11155        input p-obj-code as integer,
    11156        input p-gds-code as integer) :
    11157      define variable v-wgh-val  as character no-undo.
    11158      define variable v-par-val  as character no-undo.
    11159      define variable v-par-type as character no-undo.
    11160      define variable vMarking        as logical no-undo.
    11161      define variable vArtic          as logical no-undo.
    11162      define variable vTransitional   as logical no-undo.
    11163      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
    11164         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
    11165           ( p-gds-code,
    11166             'weighed-gds':U,
    11167              output v-wgh-val,
    11168              output v-par-type
    11169           ).
    11170       if logical(v-wgh-val) = yes then do:
    11171           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
    11172               ( p-gds-code,
    11173                 'mark-type':U,
    11174                  output v-par-val,
    11175                  output v-par-type
    11176               ).
    11177           if v-par-val <> "" then do:
    11178               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
    11179               assign
    11180                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
    11181                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
    11182                  .
    11183           end.
    11184      end.
    11185      if v-wgh-val > "" and (vMarking or vArtic)
    11186      then return yes.
    11187      else return no.
    11188   end.
    11189   function MarkWeight return decimal
    11190      ( input p-mark as character) :
    11191      define buffer  buf_marking-attr for  ub.marking-attr.
    11192      define variable vMarkWeight as decimal no-undo.
    11193      vMarkWeight = 0.
    11194      if p-mark <> "" and p-mark <> ?
    11195      then do:
    11196          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
    11197                                        and buf_marking-attr.attr-code eq "weight"
    11198             no-lock no-error.
    11199          if not available buf_marking-attr
    11200          then do :
    11201            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
    11202                                          and buf_marking-attr.attr-code eq "weight"
    11203               no-lock no-error.
    11204          end .
    11205          if avail buf_marking-attr
    11206          then vMarkWeight = dec(buf_marking-attr.attr-value).
    11207      end.
    11208      return vMarkWeight.
    11209   end.
