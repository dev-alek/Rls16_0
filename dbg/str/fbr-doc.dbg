    11981   ON CHOOSE OF b-lkp IN FRAME D-FBR-DOC
    11982      DO:
    11983   define variable vss-include-info65 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11984   if lookup(self :type
    11985            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
    11986            ) = 0
