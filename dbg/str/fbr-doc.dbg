    16242   PROCEDURE hide-not-avail-menu-items :
    16243      do
    16244         on error undo, return error
    16245         :
    16246         define input parameter p-fbr-doc-is-free as logical      no-undo.
    16247         case p-fbr-doc-is-free
    16248            :
    16249            when yes
    16250            then
    16251               do:
    16252                  assign
    16253                     menu-item m-rcp-add :sensitive in menu m-add = no
    16254                     menu-item m-all-add :sensitive in menu m-add = no
    16255                     menu-item m-rcp-del :sensitive in menu m-del = no
    16256                     menu-item m-all-del :sensitive in menu m-del = no
    16257                     .
    16258               end.
    16259            when no
    16260            then
    16261               do:
    16262                  assign
    16263                     menu-item m-comp-add :sensitive in menu m-add = no
    16264                     menu-item m-ingr-add :sensitive in menu m-add = no
    16265                     menu-item m-comp-del :sensitive in menu m-del = no
    16266                     menu-item m-ingr-del :sensitive in menu m-del = no
    16267                     .
    16268               end.
    16269         end case.
    16270      end.
    16271   END PROCEDURE.
    16272   PROCEDURE mode-on :
    16273      do
    16274         on error undo, return error
    16275         :
    16276         case p-doc-mode :
    16277            when 'ДОБАВЛЕНИЕ':U then
    16278               do:
    16279                  define variable v-doc-code as character no-undo.
    16280                  run fbrlib_create-fbr-doc ( input v-cntxt-obj-type
    16281                     , input  v-cntxt-obj-code
    16282                     ,input v-cntxt-userid
    16283                     , output v-doc-code
    16284                     ,output p-fbr-doc-recid) no-error.
    16285                  if error-status:error then
    16286                  do:
    16287                     undo, return error substitute("Ошибка при создании нового документа производства:&1&2&1&3"
    16288                        , chr(10)
    16289                        , error-status:get-message(1)
    16290                        , return-value ).
    16291                  end.
    16292                  assign
    16293                     p-new-fbr-doc-recid = p-fbr-doc-recid
    16294                     .
    16295                  find first f-doc exclusive-lock where
    16296                     recid(f-doc) = p-fbr-doc-recid no-error.
    16297                  fi-pay-code = f-doc.pay-code.
    16298               end.
    16299            when 'ИЗМЕНЕНИЕ':U then
    16300               do:
    16301                  find first f-doc
    16302                     where recid (f-doc) = p-fbr-doc-recid
    16303                     no-error.
    16304                  if available f-doc
    16305                     then
    16306                  do:
    16307                     find first f-doc exclusive-lock
    16308                        where recid (f-doc) = p-fbr-doc-recid no-error
    16309                        .
    16310                  end.
    16311               end.
    16312         end case.
    16313         if not available f-doc
    16314            then
    16315         do:
    16316            message
    16317               "Неправильно выбран документ."
    16318               view-as alert-box error.
    16319            undo, return error.
    16320         end.
    16321      end.
    16322   END PROCEDURE.
    16323   PROCEDURE open-comp :
    16324      define variable comp-sort-column-phrase as character no-undo .
    16325      define variable filter-point            as character no-undo init "buf_comp_fbr-line" .
    16326      case comp-sort-column-name :
    16327         when ""
    16328         then
    16329            do:
    16330               assign
    16331                  comp-sort-column-phrase = ""
    16332                  .
    16333            end.
    16334         when "comp-unit"
    16335         then
    16336            do:
    16337               assign
    16338                  comp-sort-column-phrase = "by (recid(buf_comp_fbr-line))"
    16339                  .
    16340            end.
    16341         when "comp-name"
    16342         then
    16343            do:
    16344               assign
    16345                  comp-sort-column-phrase = "by get-goods-name(recid(buf_comp_fbr-line))"
    16346                  .
    16347            end.
    16348         when "comp-OK"
    16349         then
    16350            do:
    16351               assign
    16352                  comp-sort-column-phrase = "by get-line-OK(recid(buf_comp_fbr-line))"
    16353                  .
    16354            end.
    16355         when "comp-prod"
    16356         then
    16357            do:
    16358               assign
    16359                  comp-sort-column-phrase = "by get-prod-ref(recid(buf_comp_fbr-line))"
    16360                  .
    16361            end.
    16362         otherwise
    16363         do:
    16364            assign
    16365               comp-sort-column-phrase = "by " + comp-sort-column-name
    16366               .
    16367         end.
    16368      end case.
    16369      case rs-one-all :
    16370         when "type"
    16371         then
    16372            do:
    16373   define variable vss-include-info104 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    16374   define variable  l-disable-where-105  as logical   no-undo .
    16375   define variable  l-filter-open-105    as logical   .
    16376   define variable  flt-rec-105       as recid     no-undo .
    16377   define variable  filter-name-105      as character no-undo .
    16378   define variable  where-phrase-105     as character no-undo .
    16379   define variable  sort-phrase-105      as character no-undo .
    16380   define variable  where-phrase-rus-105 as character no-undo .
    16381   define variable  sort-phrase-rus-105  as character no-undo .
    16382   run gbl/flt-get.p
    16383     (input filter-point
    16384     ,output flt-rec-105
    16385     ,output filter-name-105
    16386     ,output where-phrase-105
    16387     ,output sort-phrase-105
    16388     ,output where-phrase-rus-105
    16389     ,output sort-phrase-rus-105
    16390     ).
    16391     assign
    16392       l-filter-open-105 = false
    16393     .
    16394     if flt-rec-105 <> ?
    16395       or comp-sort-column-phrase > ""
    16396     then do:
    16397       define variable  parameter-2-105 as character no-undo .
    16398       define variable  parameter-3-105 as character no-undo .
    16399       define variable  parameter-4-105 as character no-undo .
    16400       define variable  parameter-5-105 as character no-undo .
    16401       define variable  parameter-6-105 as character no-undo .
    16402       define variable  parameter-7-105 as character no-undo .
    16403         assign
    16404         parameter-3-105 =
    16405                                 "for each buf_comp_fbr-line"
    16406         parameter-4-105 =
    16407           (
    16408             if ("buf_comp_fbr-line.doc-code = f-doc.doc-code and                             buf_comp_fbr-line.trn-type = 'при':U " + " " + where-phrase-105) <> ""
    16409             then  substitute('buf_comp_fbr-line.doc-code = &1&2&1 and buf_comp_fbr-line.trn-type = &1&3&1', chr(34), f-doc.doc-code, 'при':U )  + " " + where-phrase-105
    16410             else "true"
    16411           )
    16412         parameter-5-105 = (" " + "" + " " + "")
    16413         parameter-6-105 = if sort-phrase-105 = ''
    16414                              then
    16415           (
    16416           " " + " " +
    16417             " " + comp-sort-column-phrase +
    16418           " " + " "
    16419           )
    16420                              else
    16421           (
    16422           " " + " " +
    16423             " " + comp-sort-column-phrase +
    16424           " " + sort-phrase-105
    16425           )
    16426         parameter-7-105 =
    16427           " indexed-reposition  "
    16428       .
    16429       do
    16430       on stop undo, leave
    16431       on error undo, leave
    16432       :
    16433         assign
    16434           l-disable-where-105 =
    16435             ("buf_comp_fbr-line.doc-code = f-doc.doc-code and                             buf_comp_fbr-line.trn-type = 'при':U " + " " + where-phrase-105 = "")
    16436         .
    16437         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
    16438                             ,input query br-comp:handle
    16439                             ,input parameter-3-105
    16440                             ,input parameter-4-105
    16441                             ,input parameter-5-105
    16442                             ,input parameter-6-105
    16443                             ,input parameter-7-105
    16444                             )
    16445         .
    16446         assign
    16447           l-filter-open-105 = true
    16448         .
    16449       end.
    16450       if l-filter-open-105 = false then do:
    16451         message
    16452           "Ошибка при фильтрации / сортировке" skip
    16453           "Будут показаны записи без учета фильтра" skip
    16454           view-as alert-box .
    16455       end.
    16456       else do:
    16457       end.
    16458     end.
    16459     if l-filter-open-105 = false then do:
    16460       open query br-comp for each buf_comp_fbr-line no-lock
    16461         where buf_comp_fbr-line.doc-code = f-doc.doc-code and                             buf_comp_fbr-line.trn-type = 'при':U
    16462         indexed-reposition
    16463     .
    16464     end.
    16465            end.
    16466         when "goods" then
    16467            do:
    16468   define variable vss-include-info106 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    16469   define variable  l-disable-where-107  as logical   no-undo .
    16470   define variable  l-filter-open-107    as logical   .
    16471   define variable  flt-rec-107       as recid     no-undo .
    16472   define variable  filter-name-107      as character no-undo .
    16473   define variable  where-phrase-107     as character no-undo .
    16474   define variable  sort-phrase-107      as character no-undo .
    16475   define variable  where-phrase-rus-107 as character no-undo .
    16476   define variable  sort-phrase-rus-107  as character no-undo .
    16477   run gbl/flt-get.p
    16478     (input filter-point
    16479     ,output flt-rec-107
    16480     ,output filter-name-107
    16481     ,output where-phrase-107
    16482     ,output sort-phrase-107
    16483     ,output where-phrase-rus-107
    16484     ,output sort-phrase-rus-107
    16485     ).
    16486     assign
    16487       l-filter-open-107 = false
    16488     .
    16489     if flt-rec-107 <> ?
    16490       or comp-sort-column-phrase > ""
    16491     then do:
    16492       define variable  parameter-2-107 as character no-undo .
    16493       define variable  parameter-3-107 as character no-undo .
    16494       define variable  parameter-4-107 as character no-undo .
    16495       define variable  parameter-5-107 as character no-undo .
    16496       define variable  parameter-6-107 as character no-undo .
    16497       define variable  parameter-7-107 as character no-undo .
    16498         assign
    16499         parameter-3-107 =
    16500                                 "for each buf_comp_fbr-line"
    16501         parameter-4-107 =
    16502           (
    16503             if ("buf_comp_fbr-line.doc-code = f-doc.doc-code and                             buf_comp_fbr-line.is-comp = yes and                             buf_comp_fbr-line.artic = flt-gds.artic and                             buf_comp_fbr-line.prod-type = flt-gds.prod-type and                             buf_comp_fbr-line.prod-code = flt-gds.prod-code " + " " + where-phrase-107) <> ""
    16504             then  substitute('buf_comp_fbr-line.doc-code = &1&2&1 and                             buf_comp_fbr-line.is-comp = yes and                             buf_comp_fbr-line.artic = &1&3&1 and                             buf_comp_fbr-line.prod-type = &1&4&1 and                             buf_comp_fbr-line.prod-code = &5'                             , chr(34), f-doc.doc-code, flt-gds.artic, flt-gds.prod-type, flt-gds.prod-code) + " " + where-phrase-107
    16505             else "true"
    16506           )
    16507         parameter-5-107 = (" " + "" + " " + "")
    16508         parameter-6-107 = if sort-phrase-107 = ''
    16509                              then
    16510           (
    16511           " " + " " +
    16512             " " + comp-sort-column-phrase +
    16513           " " + " "
    16514           )
    16515                              else
    16516           (
    16517           " " + " " +
    16518             " " + comp-sort-column-phrase +
    16519           " " + sort-phrase-107
    16520           )
    16521         parameter-7-107 =
    16522           " indexed-reposition  "
    16523       .
    16524       do
    16525       on stop undo, leave
    16526       on error undo, leave
    16527       :
