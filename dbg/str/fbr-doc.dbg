     8091     define input  parameter p-node-code   like ub.gds-grp-obj-attr.node-code     no-undo .
     8092     define input  parameter p-host-code    like ub.gds-grp-obj-attr.host-code     no-undo .
     8093     define input  parameter p-obj-type     like ub.gds-grp-obj-attr.obj-type     no-undo .
     8094     define input  parameter p-obj-code     like ub.gds-grp-obj-attr.obj-code     no-undo .
     8095     define input  parameter p-code     like ub.gds-grp-obj-attr.attr-code  no-undo .
     8096     define output parameter p-deleted  as logical no-undo.
     8097     do
     8098     on error undo, return error
     8099     :
     8100           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ggoattr-delete in g#attr-lib
     8101         (input  p-node-code
     8102         ,input  p-host-code
     8103         ,input  p-obj-type
     8104         ,input  p-obj-code
     8105         ,input  p-code
     8106         ,output p-deleted
     8107         ) no-error .
     8108       if error-status :error
     8109       then do:
     8110         undo, return error return-value .
     8111       end.
     8112     end.
     8113   end procedure.
