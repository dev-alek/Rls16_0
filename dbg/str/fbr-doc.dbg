    12283   ON ROW-DISPLAY OF br-comp IN FRAME D-FBR-DOC
    12284      DO:
    12285         define buffer local_ingr_fbr-line for ub.fbr-line .
    12286         if buf_comp_fbr-line.is-waste = yes
    12287            then
    12288         do:
    12289            assign
    12290               buf_comp_fbr-line.artic                 :bgcolor in browse br-comp = gray_color
    12291               comp-name                               :bgcolor in browse br-comp = gray_color
