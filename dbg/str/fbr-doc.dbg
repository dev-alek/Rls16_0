    12463            display
    12464               buf_ingr_fbr-line.is-calc
    12465               buf_ingr_fbr-line.price-sale
    12466               buf_ingr_fbr-line.price-base
    12467               buf_ingr_fbr-line.price-rubl
    12468               buf_ingr_fbr-line.price-sum-base
    12469               buf_ingr_fbr-line.price-sum-rubl
    12470               buf_ingr_fbr-line.price-sum-vat-base
    12471               buf_ingr_fbr-line.price-sum-vat-rubl
    12472               buf_ingr_fbr-line.fix-cost
    12473               with browse br-ingr.
    12474            browse br-ingr :refresh().
    12475         end.
    12476      END.
    12477   ON VALUE-CHANGED OF br-ingr IN FRAME D-FBR-DOC
    12478      DO:
    12479         define variable v-gds-name           as character no-undo.
    12480         define variable v-gds-type           as character no-undo.
    12481         define variable v-recipe-type        as character no-undo.
    12482         define variable v-recipe-qnty        as decimal   no-undo.
    12483         define variable v-recipe-brutto-qnty as decimal   no-undo.
    12484         define variable v-recipe-coeff-value as decimal   no-undo.
    12485         define variable v-recipe-coeff-waste as decimal   no-undo.
    12486         define variable v-recipe-waste       as logical   no-undo.
    12487         display
    12488            ?   @ ingr-long
    12489            ?   @ ub.fbr-recipe-gds.qnty
    12490            no  @ ub.fbr-recipe-gds.is-waste
    12491            ""  @ ingr-goods-type
    12492            with frame D-FBR-DOC.
    12493         if available buf_ingr_fbr-line
    12494            then
    12495         do:
    12496            run get-ingr-line-parameters in this-procedure (
    12497               input buf_ingr_fbr-line.recipe-code
    12498               , input buf_ingr_fbr-line.artic
    12499               , input buf_ingr_fbr-line.prod-type
    12500               , input buf_ingr_fbr-line.prod-code
    12501               , output v-gds-name
    12502               , output v-gds-type
    12503               , output v-recipe-type
    12504               , output v-recipe-qnty
    12505               , output v-recipe-brutto-qnty
    12506               , output v-recipe-coeff-value
    12507               , output v-recipe-coeff-waste
    12508               , output v-recipe-waste
    12509               ) .
    12510            if v-recipe-type = 'разделка':U
    12511               and v-recipe-waste = no
    12512               then
    12513            do:
    12514               if v-base = yes
    12515                  then
    12516               do:
    12517                  assign
    12518                     buf_ingr_fbr-line.price-base:read-only          in browse br-ingr = no
    12519                     .
    12520               end.
    12521               else
    12522               do:
    12523                  assign
    12524                     buf_ingr_fbr-line.price-rubl:read-only          in browse br-ingr = no
    12525                     .
    12526               end.
    12527            end.
    12528            else
    12529            do:
    12530               assign
    12531                  buf_ingr_fbr-line.price-rubl:read-only          in browse br-ingr = yes
    12532                  buf_ingr_fbr-line.price-base:read-only          in browse br-ingr = yes
    12533                  .
    12534            end.
    12535            if not( v-cntxt-db-num-obj = v-cntxt-db-num )
    12536               and ( v-cntxt-db-num-obj <> 0 )
    12537               then
    12538            do:
    12539               assign
    12540                  buf_ingr_fbr-line.price-rubl:read-only          in browse br-ingr = yes
    12541                  .
    12542            end.
    12543            run fill-recipe-fields in this-procedure (
    12544               input buf_ingr_fbr-line.recipe-code
    12545               ).
    12546            display
    12547               v-gds-name              @ ingr-long
    12548               v-gds-type              @ ingr-goods-type
    12549               v-recipe-brutto-qnty    @ fbr-recipe-gds.qnty
    12550               v-recipe-waste          @ fbr-recipe-gds.is-waste
    12551               with frame D-FBR-DOC.
    12552         end.
    12553      END.
    12554   ON LEAVE OF fi-pay-code IN FRAME D-FBR-DOC
