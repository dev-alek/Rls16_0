    12046         case current-browse
    12047            :
    12048            when br-comp :handle
    12049            then
    12050               do:
    12051                  if buf_comp_fbr-line.trn-type = 'спи':U
    12052                     then
    12053                  do:
    12054                     run process-parts in this-procedure (
    12055                        input buf_comp_fbr-line.doc-code
    12056                        , input buf_comp_fbr-line.trn-type
    12057                        , input buf_comp_fbr-line.recipe-code
    12058                        , input buf_comp_fbr-line.artic
    12059                        , input buf_comp_fbr-line.prod-type
    12060                        , input buf_comp_fbr-line.prod-code
    12061                        ) no-error.
    12062                     if error-status :error
    12063                        then
    12064                     do:
    12065                        message
    12066                           vss-workfile vss-revision vss-description
    12067                           skip
    12068                           "Ошибка обработки партий."
    12069                           skip return-value
    12070                           skip trim(error-status :get-message(1))
    12071                           trim(error-status :get-message(2))
    12072                           trim(error-status :get-message(3))
    12073                           view-as alert-box error.
    12074                        undo, return no-apply .
    12075                     end.
    12076                     apply "entry" to br-comp in frame D-FBR-DOC .
    12077                  end.
    12078                  else
    12079                  do:
    12080                     message
    12081                        "Выберите строку списания."
    12082                        view-as alert-box information.
    12083                  end.
    12084               end.
    12085            when br-ingr :handle
    12086            then
    12087               do:
    12088                  if buf_ingr_fbr-line.trn-type = 'спи':U
    12089                     then
    12090                  do:
    12091                     run process-parts in this-procedure (
    12092                        input buf_ingr_fbr-line.doc-code
    12093                        , input buf_ingr_fbr-line.trn-type
    12094                        , input buf_ingr_fbr-line.recipe-code
    12095                        , input buf_ingr_fbr-line.artic
    12096                        , input buf_ingr_fbr-line.prod-type
    12097                        , input buf_ingr_fbr-line.prod-code
    12098                        ) no-error.
    12099                     if error-status :error
    12100                        then
    12101                     do:
    12102                        message
    12103                           vss-workfile vss-revision vss-description
    12104                           skip
    12105                           "Ошибка обработки партий."
    12106                           skip return-value
    12107                           skip trim(error-status :get-message(1))
    12108                           trim(error-status :get-message(2))
    12109                           trim(error-status :get-message(3))
    12110                           view-as alert-box error.
    12111                        undo, return no-apply .
    12112                     end.
    12113                     apply "entry" to br-ingr in frame D-FBR-DOC .
    12114                  end.
    12115                  else
    12116                  do:
    12117                     message
    12118                        "Выберите строку списания."
    12119                        view-as alert-box information.
    12120                  end.
    12121               end.
    12122         end case.
    12123         run UI-on in this-procedure ( input "line" ).
    12124      END.
    12125   ON CHOOSE OF b-prev IN FRAME D-FBR-DOC
    12126      DO:
    12127         assign
    12128            v-close-enabled = yes
    12129            v-need-refresh  = yes
    12130            .
    12131      END.
    12132   ON CHOOSE OF b-recipe IN FRAME D-FBR-DOC
    12133      DO:
    12134         define variable ri             as recid   no-undo.
    12135         define variable v-cancel       as logical no-undo.
    12136         define variable v-can-continue as logical no-undo.
    12137         define variable v-goods-recid  as recid   no-undo.
    12138   define variable vss-include-info67 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12139   if lookup(self :type
    12140            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
    12141            ) = 0
    12142   then do:
    12143     message
    12144       "$Workfile$"
