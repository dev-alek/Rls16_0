    11679   else do:
    11680     apply "entry":u to self  .
    11681     if focus :handle <> self :handle  then do:
    11682       return no-apply .
    11683     end.
    11684   end.
    11685         define variable v-need-goods           as logical   no-undo.
    11686         define variable v-need-goods-list      as character no-undo.
    11687         define variable v-need-goods-qnty-list as character no-undo.
    11688         if not available buf_comp_fbr-line
    11689            then
    11690         do:
    11691            message "Неправильно выбрана строка.".
    11692            return no-apply.
    11693         end.
    11694         run str/fbr-qnty.p (
    11695            input parparentproc
    11696            , input p-fbrhist-handle
    11697            , input recid( f-doc )
    11698            , input recid( buf_comp_fbr-line )
    11699            , input yes
    11700            , input "ingr"
    11701            , input no
    11702            , input v-price-sale-obj-type
    11703            , input v-price-sale-obj-code
    11704            , input no
    11705            , input no
    11706            , input no
    11707            , output v-need-goods
    11708            , output v-need-goods-list
    11709            , output v-need-goods-qnty-list
    11710            ) no-error.
    11711         if error-status:error then
    11712         do:
    11713            message
    11714               substitute("Ошибка при расчете ингридиентов&1&2&1&3"
    11715               , chr(10)
    11716               , error-status:get-message(1)
    11717               , return-value )
    11718               view-as alert-box error .
    11719         end.
    11720         run UI-on in this-procedure ( input "line" ).
    11721      END.
    11722   ON CHOOSE OF b-chg IN FRAME D-FBR-DOC
    11723      DO:
    11724   define variable vss-include-info63 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11725   if lookup(self :type
    11726            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
    11727            ) = 0
    11728   then do:
    11729     message
    11730       "$Workfile$"
    11731       "Указанному интерфейсному элементу фокус не может быть передан" skip
    11732       "Интерфейсный элемент" self :name  skip
    11733       "Тип" self :type  skip
    11734       "Процедура" this-procedure :file-name skip
    11735       view-as alert-box .
    11736   end.
    11737   else do:
    11738     apply "entry":u to self  .
    11739     if focus :handle <> self :handle  then do:
    11740       return no-apply .
    11741     end.
    11742   end.
    11743         define variable v-cancel   as logical no-undo.
    11744         define variable v-old-qnty as decimal no-undo.
    11745         define variable v-mark-qnty as decimal no-undo init ? .
    11746         define variable v-attr-value as character no-undo .
    11747         define variable v-attr-type as character no-undo .
    11748         define buffer buf_goods for ub.goods .
    11749         define buffer buf_fbr-recipe for ub.fbr-recipe.
    11750         define buffer buf_fbr-line   for ub.fbr-line.
    11751         define buffer buf_marking-lines for ub.marking-lines .
    11752         define buffer buf_marking for ub.marking .
    11753         if not available buf_comp_fbr-line then
    11754         do:
    11755            message "Неправильно выбрана строка.".
    11756            return no-apply.
    11757         end.
    11758         do
    11759            on stop undo, return no-apply
    11760            on error undo, return no-apply
    11761            :
    11762            assign
    11763              v-old-qnty = buf_comp_fbr-line.fact-qnty
    11764            .
    11765            for first buf_goods no-lock where buf_goods.artic     = buf_comp_fbr-line.artic
    11766                                          and buf_goods.prod-type = buf_comp_fbr-line.prod-type
    11767                                          and buf_goods.prod-code = buf_comp_fbr-line.prod-code
    11768            :
    11769              v-isweighed = WghProdVariable(v-cntxt-obj-type, v-cntxt-obj-code, buf_goods.gds-code) .
    11770              for each buf_marking-lines where buf_marking-lines.gds-code = buf_goods.gds-code
    11771                                       and buf_marking-lines.obj-type = f-doc.obj-type
    11772                                       and buf_marking-lines.obj-code = f-doc.obj-code
    11773                                       and buf_marking-lines.in-code  = "manufacturing"
    11774                                       and buf_marking-lines.out-code = buf_comp_fbr-line.doc-code
    11775                                       and buf_marking-lines.part-code = buf_comp_fbr-line.recipe-code
    11776                                       and buf_marking-lines.prt-code = 0
    11777              :
    11778                if v-mark-qnty = ? then assign v-mark-qnty = 0 .
    11779                if v-isweighed
    11780                then do :
    11781                  for first buf_marking no-lock where buf_marking.mark begins buf_marking-lines.mark :
    11782                    v-mark-weight = MarkWeight(buf_marking.mark) .
    11783                    assign v-mark-qnty = v-mark-qnty + v-mark-weight .
    11784                  end .
    11785                end .
    11786                else do :
    11787                  assign v-mark-qnty = v-mark-qnty + 1 .
    11788                end .
    11789              end .
    11790            end .
    11791            run str/fbr-line.w (
    11792               input p-fbrhist-handle
    11793               , input 'ИЗМЕНЕНИЕ':U
    11794               , input buf_comp_fbr-line.doc-code
    11795               , input recid (buf_comp_fbr-line)
    11796               , input v-mark-qnty
    11797               , output v-cancel
    11798               ) no-error.
    11799            if error-status :error
    11800               then
    11801            do:
    11802               message
    11803                  vss-workfile vss-revision vss-description
    11804                  skip
    11805                  "Ошибка изменения количества составного товара."
    11806                  skip return-value
    11807                  skip trim(error-status :get-message(1))
    11808                  trim(error-status :get-message(2))
    11809                  trim(error-status :get-message(3))
    11810                  view-as alert-box error.
    11811               undo, return no-apply .
    11812            end.
    11813            if buf_comp_fbr-line.recipe-code <> ""
    11814               then
    11815            do:
    11816               define variable v-need-goods           as logical   no-undo.
    11817               define variable v-need-goods-list      as character no-undo.
    11818               define variable v-need-goods-qnty-list as character no-undo.
    11819               if v-old-qnty > buf_comp_fbr-line.fact-qnty
    11820                  then
    11821               do:
    11822                  find first buf_fbr-recipe no-lock
    11823                     where buf_fbr-recipe.doc-code    = buf_comp_fbr-line.doc-code
    11824                     and buf_fbr-recipe.recipe-code = buf_comp_fbr-line.recipe-code
    11825                     .
    11826                  if buf_fbr-recipe.recipe-type = 'альтернатива':U
    11827                     then
    11828                  do:
    11829                     do transaction
    11830                        :
    11831                        for each buf_fbr-line exclusive-lock
    11832                           where buf_fbr-line.doc-code    = buf_comp_fbr-line.doc-code
    11833                           and buf_fbr-line.is-comp     = no
    11834                           and buf_fbr-line.recipe-code = buf_comp_fbr-line.recipe-code
    11835                           :
    11836                           delete buf_fbr-line.
    11837                        end.
    11838                     end.
    11839                  end.
    11840               end.
    11841               run str/fbr-qnty.p (
    11842                  input parparentproc
    11843                  , input p-fbrhist-handle
    11844                  , input recid( f-doc )
    11845                  , input recid( buf_comp_fbr-line )
    11846                  , no
    11847                  , "ingr"
    11848                  , no
    11849                  , v-price-sale-obj-type
    11850                  , v-price-sale-obj-code
    11851                  , input no
    11852                  , input no
    11853                  , input no
    11854                  , output v-need-goods
    11855                  , output v-need-goods-list
    11856                  , output v-need-goods-qnty-list
    11857                  ) no-error.
    11858               if error-status :error
    11859                  then
    11860               do:
    11861                  message
    11862                     vss-workfile vss-revision vss-description
    11863                     skip
    11864                     "Ошибка расчета количества ингредиентов"
    11865                     skip
    11866                     "при изменении количества составного товара"
    11867                     skip return-value
    11868                     skip trim(error-status :get-message(1))
    11869                     trim(error-status :get-message(2))
    11870                     trim(error-status :get-message(3))
    11871                     view-as alert-box error.
    11872                  undo, return no-apply .
    11873               end.
    11874            end.
    11875         end.
    11876         run UI-on ("line").
    11877      END.
    11878   ON CHOOSE OF b-exit IN FRAME D-FBR-DOC
    11879      DO:
    11880   define variable vss-include-info64 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11881   if lookup(self :type
    11882            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
    11883            ) = 0
    11884   then do:
    11885     message
    11886       "$Workfile$"
