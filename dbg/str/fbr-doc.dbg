    11515      VIEW-AS FILL-IN
    11516      SIZE 12.63 BY 1.08 TOOLTIP "Номер рецепта текущей строки"
    11517      FGCOLOR 4
    11518      fbr-recipe.recipe-type AT ROW 3.75 COL 10.63 COLON-ALIGNED NO-LABEL FORMAT "X(1)"
    11519      VIEW-AS FILL-IN
    11520      SIZE 2.5 BY 1.08 TOOLTIP "Тип рецепта: к - комплектация, а - альтернатива, п - производство, р - разделка"
    11521      FGCOLOR 4
    11522      fbr-recipe-gds.qnty AT ROW 13.96 COL 87.63 COLON-ALIGNED
    11523      LABEL "Коэф"
    11524      VIEW-AS FILL-IN
    11525      SIZE 6.5 BY 1 TOOLTIP "Количество текущего ингредиента по рецепту"
    11526      FGCOLOR 4
    11527      fbr-recipe-gds.is-waste AT ROW 13.96 COL 78.75 COLON-ALIGNED NO-LABEL FORMAT "*/."
    11528      VIEW-AS FILL-IN
    11529      SIZE 2.5 BY 1 TOOLTIP "Звездочка зажигается, если это ОТХОДЫ"
    11530      FGCOLOR 4
    11531      fbr-recipe.recipe-name AT ROW 3.75 COL 24.5 COLON-ALIGNED NO-LABEL
    11532      VIEW-AS FILL-IN
    11533      SIZE 43.75 BY 1.08 TOOLTIP "Название рецепта текущей строки"
    11534      FGCOLOR 4
    11535      ingr-goods-type AT ROW 13.96 COL 76.5 COLON-ALIGNED NO-LABEL
    11536      fbr-recipe.qnty AT ROW 3.79 COL 88.25 COLON-ALIGNED
    11537      LABEL "Коэф"
    11538      VIEW-AS FILL-IN
    11539      SIZE 6.5 BY 1 TOOLTIP "Количество составного товара по рецепту"
    11540      FGCOLOR 4
    11541      effect AT ROW 3.79 COL 73.63 COLON-ALIGNED
