     1288   define temp-table tt-marking like ub.marking
     1289     .
     1290   define temp-table tt-utd-marking-lines like ub.utd-marking-lines
     1291     .
     1292   define temp-table tt-inv-marking no-undo
     1293     field gds-code      as integer
