    12305               buf_comp_fbr-line.price-sum-vat-base    :bgcolor in browse br-comp = gray_color
    12306               buf_comp_fbr-line.rsrv-qnty             :bgcolor in browse br-comp = gray_color
    12307               .
    12308         end.
    12309         for first local_ingr_fbr-line no-lock where local_ingr_fbr-line.doc-code = f-doc.doc-code
    12310                                                 and local_ingr_fbr-line.is-comp = no
    12311                                                 and local_ingr_fbr-line.recipe-code = buf_comp_fbr-line.recipe-code
    12312         :
    12313           if need-marks(buffer local_ingr_fbr-line)
    12314           then do ii = 1 to extent (bcol_comp):
    12315             if valid-handle (bcol_comp[ii])
    12316             then do:
    12317               assign
    12318                 bcol_comp[ii]:bgcolor = RED_COLOR.
    12319             end.
    12320           end.
    12321         end .
    12322      END.
    12323   ON ROW-LEAVE OF br-comp IN FRAME D-FBR-DOC
