    11549      shift-sel AT ROW 2.5 COL 69 WIDGET-ID 6
    11550      SPACE(29.37) SKIP(20.36)
    11551      WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
    11552      SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
    11553      TITLE "".
    11554   ASSIGN
    11555      FRAME D-FBR-DOC:SCROLLABLE = FALSE
    11556      FRAME D-FBR-DOC:HIDDEN     = TRUE.
    11557   ASSIGN
    11558      b-add:POPUP-MENU IN FRAME D-FBR-DOC = MENU m-add:HANDLE.
    11559   ASSIGN
    11560      b-del:POPUP-MENU IN FRAME D-FBR-DOC = MENU m-del:HANDLE.
    11561   ASSIGN
    11562      b-rsrv:POPUP-MENU IN FRAME D-FBR-DOC = MENU POPUP-MENU-b-rsrv:HANDLE.
    11563   ASSIGN
    11564      effect:HIDDEN IN FRAME D-FBR-DOC = TRUE.
    11565   ASSIGN
    11566      r-outs:POPUP-MENU IN FRAME D-FBR-DOC = MENU m-outs:HANDLE.
    11567   ASSIGN
    11568      shift:READ-ONLY IN FRAME D-FBR-DOC = TRUE.
    11569   ASSIGN
    11570      tot-qnty:HIDDEN IN FRAME D-FBR-DOC = TRUE.
    11571   ON END-ERROR OF FRAME D-FBR-DOC
    11572      OR ENDKEY OF FRAME D-FBR-DOC ANYWHERE
    11573      DO:
    11574         APPLY "CHOOSE":U TO b-exit.
    11575      END.
    11576   ON GO OF FRAME D-FBR-DOC
    11577      DO:
    11578         define variable v-today as date    no-undo.
    11579         define variable v-time  as integer no-undo.
    11580         find first ub.fbr-line no-lock
    11581            where ub.fbr-line.doc-code = f-doc.doc-code
    11582            no-error.
    11583         if not available ub.fbr-line
    11584            and p-doc-mode <> 'ПРОСМОТР':U
    11585            then
    11586         do:
    11587            message
    11588               "В документе нет ни одной строки. Документ удаляется."
    11589               view-as alert-box information.
    11590            delete f-doc.
    11591            assign
    11592               p-fbr-doc-recid     = ?
    11593               p-new-fbr-doc-recid = ?
    11594               .
    11595         end.
    11596         else
    11597         do:
    11598            if p-doc-mode <> 'ПРОСМОТР':U
    11599               then
    11600            do:
    11601               run cur-time in this-procedure (
    11602                  output v-today
    11603                  , output v-time
    11604                  ).
    11605               assign
    11606                  f-doc.sys-date     = v-today
    11607                  f-doc.sys-time     = string( v-time, "HH:MM:SS":U )
    11608                  f-doc.sys-time-int = v-time
    11609                  .
    11610            end.
    11611         end.
    11612      END.
    11613   ON WINDOW-CLOSE OF FRAME D-FBR-DOC
    11614      DO:
    11615         if v-close-enabled = no
    11616            then
    11617         do:
    11618            undo, return no-apply.
    11619         end.
    11620         APPLY "END-ERROR":U TO SELF.
    11621      END.
    11622   ON CHOOSE OF b-calc-comp IN FRAME D-FBR-DOC
    11623      DO:
    11624   define variable vss-include-info61 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11625   if lookup(self :type
    11626            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
    11627            ) = 0
    11628   then do:
    11629     message
