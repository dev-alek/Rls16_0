    12430      DO:
    12431         if available buf_ingr_fbr-line
    12432            and browse br-ingr:current-row-modified
    12433            then
    12434         do:
    12435            run assign-ingr-line in this-procedure (
    12436               rowid( buf_ingr_fbr-line )
    12437               , input browse br-ingr buf_ingr_fbr-line.fact-qnty
    12438               , input browse br-ingr buf_ingr_fbr-line.is-calc
    12439               , input browse br-ingr buf_ingr_fbr-line.price-sale
    12440               , input browse br-ingr buf_ingr_fbr-line.fix-cost
    12441               , input browse br-ingr buf_ingr_fbr-line.price-rubl
    12442               , input browse br-ingr buf_ingr_fbr-line.price-base
    12443               , input browse br-ingr buf_ingr_fbr-line.price-sum-vat-rubl
    12444               , input browse br-ingr buf_ingr_fbr-line.price-sum-vat-base
    12445               ) no-error.
    12446            if error-status :error
    12447               then
    12448            do:
    12449               message
    12450                  vss-workfile vss-revision vss-description
    12451                  skip(1)
    12452                  skip
    12453                  "Ошибка записи строки ингредиента"
    12454                  skip
    12455                  "документа производства"
    12456                  skip return-value
    12457                  skip trim(error-status :get-message(1))
    12458                  trim(error-status :get-message(2))
    12459                  trim(error-status :get-message(3))
    12460                  view-as alert-box error.
    12461               undo, return no-apply .
