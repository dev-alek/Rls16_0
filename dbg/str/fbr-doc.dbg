    12418               ingr-netto                              :bgcolor in browse br-ingr = gray_color
    12419               buf_ingr_fbr-line.price-rubl            :bgcolor in browse br-ingr = gray_color
    12420               buf_ingr_fbr-line.price-base            :bgcolor in browse br-ingr = gray_color
