    11991       "Интерфейсный элемент" self :name  skip
    11992       "Тип" self :type  skip
    11993       "Процедура" this-procedure :file-name skip
    11994       view-as alert-box .
    11995   end.
    11996   else do:
    11997     apply "entry":u to self  .
    11998     if focus :handle <> self :handle  then do:
    11999       return no-apply .
    12000     end.
