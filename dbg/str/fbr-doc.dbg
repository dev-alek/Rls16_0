     3618             input 'производство':U
     3619           , input p-fbr-doc-code
     3620           , input p-doc-type
     3621           , output v-doc-code
     3622       ).
     3623       find first buf_trn-doc no-lock
     3624            where buf_trn-doc.doc-code = v-doc-code
     3625       no-error.
     3626       if not available buf_trn-doc
     3627       then do:
     3628           if p-doc-type <> 'спи':U
     3629           then do:
     3630               message
     3631                   "Не найден документ '" p-doc-type "'"
     3632                   "по документу производства " p-fbr-doc-code
     3633               view-as alert-box.
     3634               undo, return error.
     3635           end.
     3636           else do:
     3637           end.
     3638       end.
     3639       else do:
     3640           assign
     3641               v-trn-doc-recid = recid( buf_trn-doc )
     3642               v-ext-doc-type  = buf_trn-doc.ext-doc-type
     3643           .
     3644           if v-ext-doc-type = 'ev':U
     3645           then do:
     3646               find first buf_pri_trn-doc no-lock
     3647                    where buf_pri_trn-doc.out-code     = v-doc-code
     3648                      and buf_pri_trn-doc.ext-doc-type = 'iv':U
     3649               no-error.
     3650               if available buf_pri_trn-doc
     3651               then do:
     3652                   run str/del-doc.p (
     3653                         input parparentproc
     3654                       , input buf_pri_trn-doc.doc-code
     3655                       , input v-cntxt-db-num
     3656                       , input "delfbr.err"
     3657                       , input ?
     3658                       , input p-fbr-doc-code
     3659                       , input v-cntxt-userid
     3660                       , input 0
     3661                       , input (if p-ph-chip-num <> ?
     3662                               then p-ph-chip-num
     3663                               else (if varchip-code <> 0
     3664                                   then varchip-code
     3665                                   else ?)
     3666                               )
     3667                       , output varchip-code2
     3668                   ) no-error.
     3669                   if error-status :error
     3670                   then do:
     3671                     undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3672                                                   ,buf_pri_trn-doc.doc-code
     3673                                                   ,p-fbr-doc-code
     3674                                                   , chr(10)
     3675                                                   , error-status:get-message(1)
     3676                                                   , return-value ).
     3677                   end.
     3678               end.
     3679           end.
     3680           define buffer buf_out_trn-doc       for ub.trn-doc.
     3681           if p-doc-type = 'при':U
     3682           then do:
     3683               assign
     3684                   v-chip-counter = 0
     3685               .
     3686               for each buf_out_trn-doc exclusive-lock
     3687                  where buf_out_trn-doc.out-code = buf_trn-doc.doc-code
     3688               on error undo, return error
     3689               :
     3690                   assign
     3691                       v-chip-counter = v-chip-counter + 1
     3692                   .
     3693                   if v-chip-counter > 1
     3694                   then do:
     3695                       assign
     3696                           varchip-code = varchip-code2
     3697                       .
     3698                   end.
     3699                   run str/del-doc.p (
     3700                         input parparentproc
     3701                       , input buf_out_trn-doc.doc-code
     3702                       , input v-cntxt-db-num
     3703                       , input "delfbr.err"
     3704                       , input ?
     3705                       , input p-fbr-doc-code
     3706                       , input v-cntxt-userid
     3707                       , input 0
     3708                       , input (if p-ph-chip-num <> ?
     3709                               then p-ph-chip-num
     3710                               else (if varchip-code <> 0
     3711                                   then varchip-code
     3712                                   else ?)
     3713                               )
     3714                       , output varchip-code2
     3715                   ) no-error.
     3716                   if error-status :error
     3717                   then do:
     3718                     undo, return error substitute("Ошибка при удалении складского документа &1, связанного со складским документов прихода &2, созданный по документу производства &3.&4&5&4&6"
     3719                                                   ,buf_out_trn-doc.doc-code
     3720                                                   ,buf_trn-doc.doc-code
     3721                                                   ,p-fbr-doc-code
     3722                                                   , chr(10)
     3723                                                   , error-status:get-message(1)
     3724                                                   , return-value ).
     3725                   end.
     3726               end.
     3727           end.
     3728           run str/del-doc.p (
     3729                 input parparentproc
     3730               , input buf_trn-doc.doc-code
     3731               , input v-cntxt-db-num
     3732               , input "delfbr.err"
     3733               , input ?
     3734               , input p-fbr-doc-code
     3735               , input v-cntxt-userid
     3736               , input 0
     3737               , input (if p-ph-chip-num <> ?
     3738                        then p-ph-chip-num
     3739                        else (if varchip-code <> 0
     3740                              then varchip-code
     3741                              else ?)
     3742                        )
     3743               , output varchip-code2
     3744           ) no-error.
     3745           if error-status :error
     3746           then do:
     3747               undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3748                                             ,buf_trn-doc.doc-code
     3749                                             ,p-fbr-doc-code
     3750                                             , chr(10)
     3751                                             , error-status:get-message(1)
     3752                                             , return-value ).
     3753           end.
     3754           if p-doc-type = 'рас':U
     3755           or p-doc-type = 'спи':U
     3756           then do:
     3757               assign
     3758                   v-chip-counter = 0
     3759               .
     3760               for each buf_cons_trn-doc no-lock
     3761                  where buf_cons_trn-doc.out-code      = v-doc-code
     3762                    and buf_cons_trn-doc.ext-doc-type  = 'pc':U
     3763               :
     3764                   assign
     3765                       v-trn-doc-recid = recid( buf_cons_trn-doc )
     3766                       v-chip-counter = v-chip-counter + 1
     3767                   .
     3768                   assign
     3769                   varchip-code = if v-chip-counter = 2
     3770                                  then varchip-code2
     3771                                  else varchip-code.
     3772                   run str/del-doc.p (
     3773                         input parparentproc
     3774                       , input buf_cons_trn-doc.doc-code
     3775                       , input v-cntxt-db-num
     3776                       , input "delfbr.err"
     3777                       , input ?
     3778                       , input ?
     3779                       , input v-cntxt-userid
     3780                       , input 0
     3781                       , input (if p-ph-chip-num <> ?
     3782                                then p-ph-chip-num
     3783                                else ( if v-chip-counter = 1
     3784                                       then ?
     3785                                       else varchip-code )
     3786                                )
     3787                       , output varchip-code2
     3788                   ) no-error.
     3789                   if error-status :error
     3790                   then do:
     3791                       undo, return error substitute("Ошибка при удалении складского документа смены типа приобретения &1, созданный по документу производства &2.&3&4&3&5"
     3792                                                     ,buf_cons_trn-doc.doc-code
     3793                                                     ,p-fbr-doc-code
     3794                                                     , chr(10)
     3795                                                     , error-status:get-message(1)
     3796                                                     , return-value ).
     3797                   end.
     3798                   assign
     3799                       p-chip-num = varchip-code2
     3800                   .
     3801               end.
     3802           end.
     3803           assign
     3804               p-chip-num = varchip-code2
     3805           .
     3806       end.
     3807   end.
     3808   END PROCEDURE.
     3809   PROCEDURE fbrlib-print-del-error-message :
     3810   do
     3811   on error undo, return error
     3812   :
     3813       define variable v-user-action   as character    no-undo.
     3814       define variable v-printed       as logical      no-undo.
     3815       message
     3816           vss-workfile vss-revision vss-description
     3817           skip "Ошибка при удалении документа."
     3818           skip return-value
     3819           skip trim(error-status :get-message(1))
     3820           skip trim(error-status :get-message(2))
     3821           skip trim(error-status :get-message(3))
     3822       view-as alert-box error.
     3823       if search ("delfbr.err") <> ?
     3824       then do:
     3825         run gbl/prnfilen.w
     3826           (input  "Ошибки при удалении документа производства"
     3827           ,input  0
     3828           ,input  "delfbr.err"
     3829           ,input  7
     3830           ,output v-user-action
     3831           ,output v-printed
     3832           ).
     3833       end.
     3834   end.
     3835   END PROCEDURE.
     3836   procedure fbrlib-calc-brutto :
     3837   define input parameter p-recipe-type        as character        no-undo.
     3838   define input parameter p-netto              as decimal          no-undo.
     3839   define input parameter p-coeff-value        as decimal          no-undo.
     3840   define input parameter p-coeff-waste        as decimal          no-undo.
     3841   define input parameter p-brutto             as decimal          no-undo.
     3842   define input parameter p-calc-method        as integer          no-undo.
     3843   define output parameter p-new-netto         as decimal          no-undo.
     3844   define output parameter p-new-coeff-waste   as decimal          no-undo.
     3845   define output parameter p-new-brutto        as decimal          no-undo.
     3846   define output parameter p-new-calc-method   as integer          no-undo.
     3847   do
     3848   on error undo, return error
     3849   :
     3850       if p-recipe-type <> 'производство':U
     3851       then do:
     3852           assign
     3853               p-new-coeff-waste = 0
     3854               p-new-calc-method = 1
     3855               p-new-netto       = ( if p-calc-method = 1 then p-brutto else p-netto )
     3856               p-new-brutto      = ( if p-calc-method = 1 then p-brutto else p-netto )
     3857           .
     3858       end.
     3859       else do:
     3860           assign
     3861               p-new-calc-method = p-calc-method
     3862           .
     3863           if p-coeff-waste = 0
     3864           then do:
     3865               assign
     3866                   p-coeff-value = 0
     3867               .
     3868           end.
     3869           case p-calc-method
     3870           :
     3871               when 1
     3872               then do:
     3873                   assign
     3874                       p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3875                       p-new-coeff-waste   = p-coeff-waste
     3876                       p-new-brutto        = p-brutto
     3877                   .
     3878               end.
     3879               when 2
     3880               then do:
     3881                   assign
     3882                       p-new-netto         = p-netto
     3883                       p-new-coeff-waste   = 100 - p-coeff-value - ( 100 * p-netto / p-brutto )
     3884                       p-new-brutto        = p-brutto
     3885                   .
     3886               end.
     3887               when 3
     3888               then do:
     3889                   assign
     3890                       p-new-netto         = p-netto
     3891                       p-new-coeff-waste   = p-coeff-waste
     3892                       p-new-brutto        = 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste )
     3893                   .
     3894               end.
     3895               otherwise do:
     3896                   define variable v-yesno    as logical      no-undo.
     3897                   assign
     3898                       v-yesno = yes
     3899                   .
     3900                   message
     3901                       "Неверный метод для расчета брутто, нетто и процента потерь."
     3902                       skip "Значение метода должно быть 1, 2 или 3."
     3903                       skip(1)
     3904                       skip "Заданное значение:" p-calc-method
     3905                       skip(1)
     3906                       skip "Установить значение метода расчета 1"
     3907                       skip "(расчет нетто по брутто и проценту потерь)?"
     3908                   view-as alert-box warning
     3909                   buttons yes-no
     3910                   title "Неверное значение метода пересчета в строках документа-производства"
     3911                   update v-yesno
     3912                   .
     3913                   if v-yesno = yes
     3914                   then do:
     3915                       assign
     3916                           p-new-calc-method   = 1
     3917                           p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3918                           p-new-coeff-waste   = p-coeff-waste
     3919                           p-new-brutto        = p-brutto
     3920                       .
     3921                   end.
     3922                   else do:
     3923                       message
     3924                               vss-workfile vss-revision vss-description
     3925                           skip(1)
     3926                           skip "Ошибка расчета брутто, нетто и процента потерь."
     3927                           skip return-value
     3928                           skip trim(error-status :get-message(1))
     3929                               trim(error-status :get-message(2))
     3930                               trim(error-status :get-message(3))
     3931                       view-as alert-box error
     3932                       title "Неверное значение метода расчета"
     3933                       .
     3934                       undo, return error .
     3935                   end.
     3936               end.
     3937           end case.
     3938       end.
     3939   end.
     3940   end procedure.
     3941   procedure fbrlib-check-brutto :
     3942   define input parameter p-recipe-type        as character        no-undo.
     3943   define input parameter p-netto              as decimal          no-undo.
     3944   define input parameter p-coeff-value        as decimal          no-undo.
     3945   define input parameter p-coeff-waste        as decimal          no-undo.
     3946   define input parameter p-brutto             as decimal          no-undo.
     3947   define input parameter p-calc-method        as integer          no-undo.
     3948   define output parameter p-error-message     as character        no-undo.
     3949   define output parameter p-not-good          as logical          no-undo.
     3950   do
     3951   on error undo, return error
     3952   :
     3953       if p-recipe-type <> 'производство':U
     3954       then do:
     3955           if p-netto <> p-brutto
     3956           or p-coeff-waste <> 0
     3957           then do:
     3958               assign
     3959                   p-not-good      = yes
     3960                   p-error-message = substitute( "Во всех рецептах кроме рецепта производства должно выполняться:&1брутто = нетто и процент потерь = 0.&1&1Тип рецепта: &2&1Брутто: &3&1Нетто: &4&1Процент потерь: &5"
     3961                                           , chr(10), p-recipe-type, p-brutto, p-netto, p-coeff-waste )
     3962               .
     3963           end.
     3964       end.
     3965       else do:
     3966           if p-coeff-waste = 0
     3967           then do:
     3968               assign
     3969                   p-coeff-value = 0
     3970               .
     3971           end.
     3972           case p-calc-method
     3973           :
     3974               when 1
     3975               then do:
     3976                   if round( p-netto, 9 ) <> round( p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100, 9 )
     3977                   then do:
     3978                       assign
     3979                           p-not-good      = yes
     3980                           p-error-message = substitute( "Ошибка расчета нетто ( &2 ) &1 по брутто ( &3 ) &1 и процентам потерь ( &4, &5 )."
     3981                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     3982                       .
     3983                   end.
     3984               end.
     3985               when 2
     3986               then do:
     3987                   if round( p-coeff-waste, 9 ) <> round( 100 - p-coeff-value - ( 100 * p-netto / p-brutto ), 9 )
     3988                   then do:
     3989                       assign
     3990                           p-not-good      = yes
     3991                           p-error-message =  substitute( "Ошибка расчета процента потерь ( &2 ) &1 по нетто ( &3 ) &1 брутто ( &4 ) &1 и cезонному проценту ( &5 )."
     3992                                                   , chr(10), p-coeff-waste, p-netto, p-brutto, p-coeff-value )
     3993                       .
     3994                   end.
     3995               end.
     3996               when 3
     3997               then do:
     3998                   if round( p-brutto, 9 ) <> round( 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste ), 9 )
     3999                   then do:
     4000                       assign
     4001                           p-not-good      = yes
     4002                           p-error-message = substitute( "Ошибка расчета брутто ( &3 ) &1 по нетто ( &2 ) &1 и процентам потерь ( &4, &5 )."
     4003                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     4004                       .
     4005                   end.
     4006               end.
     4007               otherwise do:
     4008                   assign
     4009                       p-not-good      = yes
     4010                       p-error-message = substitute( "Ошибка ввода метода расчета ( &1 ).", p-calc-method )
     4011                   .
     4012               end.
     4013           end case.
     4014       end.
     4015   end.
     4016   end procedure.
     4017   procedure fbrlib-check-fbr-recipe :
     4018   define input parameter p-doc-code       as character        no-undo.
     4019   define input parameter p-recipe-code    as character        no-undo.
     4020   define output parameter p-is-correct    as logical          no-undo.
     4021       define variable v-comp-factor    as decimal      no-undo.
     4022       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4023       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4024       define buffer buf_fbr-line          for ub.fbr-line.
     4025   do
     4026   for buf_fbr-recipe
     4027     , buf_fbr-recipe-gds
     4028     , buf_fbr-line
     4029   on error undo, return error
     4030   :
     4031       assign
     4032           p-is-correct = yes
     4033       .
     4034       find first buf_fbr-recipe no-lock
     4035            where buf_fbr-recipe.doc-code    = p-doc-code
     4036              and buf_fbr-recipe.recipe-code = p-recipe-code no-error
     4037       .
     4038       if not available buf_fbr-recipe then do:
     4039         undo, return error substitute("Не найден рецепт (fbr-recipe) с кодом &1 для  документа пр-ва &2", p-recipe-code, p-doc-code).
     4040       end.
     4041       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     4042       then do:
     4043       end.
     4044       else do:
     4045           find first buf_fbr-line no-lock
     4046                where buf_fbr-line.doc-code    = buf_fbr-recipe.doc-code
     4047                  and buf_fbr-line.is-comp     = yes
     4048                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     4049                  and buf_fbr-line.artic       = buf_fbr-recipe.artic
     4050                  and buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
     4051                  and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
     4052           .
     4053           assign
     4054               v-comp-factor = buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty
     4055           .
     4056           recipe-line-cycle:
     4057           for each buf_fbr-recipe-gds no-lock
     4058              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4059                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4060           on error undo, return error
     4061           :
     4062               find first buf_fbr-line no-lock
     4063                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4064                      and buf_fbr-line.is-comp     = no
     4065                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4066                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4067                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4068                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4069               .
     4070               if absolute( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty - v-comp-factor ) > 0.000000001
     4071               then do:
     4072                   assign
     4073                       p-is-correct = no
     4074                   .
     4075                   leave recipe-line-cycle.
     4076               end.
     4077           end.
     4078       end.
     4079   end.
     4080   end procedure.
     4081   procedure fbrlib-get-recipe-type :
     4082   define input parameter p-fbr-doc-code   as character        no-undo.
     4083   define input parameter p-recipe-code    as character        no-undo.
     4084   define output parameter p-recipe-type   as character        no-undo.
     4085       define buffer buf_recipe        for ub.recipe.
     4086       define buffer buf_fbr-recipe    for ub.fbr-recipe.
     4087   do
     4088   for buf_recipe
     4089     , buf_fbr-recipe
     4090   on error undo, return error
     4091   :
     4092       if p-fbr-doc-code = ""
     4093       then do:
     4094           find first buf_recipe no-lock
     4095                where buf_recipe.recipe-code = p-recipe-code
     4096           no-error.
     4097           if available buf_recipe
     4098           then do:
     4099               assign
     4100                   p-recipe-type = buf_recipe.recipe-type
     4101               .
     4102           end.
     4103           else do:
     4104               assign
     4105                   p-recipe-type = "":U
     4106               .
     4107           end.
     4108       end.
     4109       else do:
     4110           find first buf_fbr-recipe no-lock
     4111                where buf_fbr-recipe.doc-code      = p-fbr-doc-code
     4112                  and buf_fbr-recipe.recipe-code   = p-recipe-code
     4113           no-error.
     4114           if available buf_fbr-recipe
     4115           then do:
     4116               assign
     4117                   p-recipe-type = buf_fbr-recipe.recipe-type
     4118               .
     4119           end.
     4120           else do:
     4121               assign
     4122                   p-recipe-type = "":U
     4123               .
     4124           end.
     4125       end.
     4126   end.
     4127   end procedure.
     4128   PROCEDURE calc-comp-from-ingr :
     4129   define input parameter p-fbr-v-fbr-doc-line-recid           as recid        no-undo.
     4130   define input parameter p-fact-qnty                          as decimal      no-undo.
     4131   define output parameter p-comp-fbr-v-fbr-doc-line-recid     as recid        no-undo.
     4132   define output parameter p-comp-qnty                         as decimal      no-undo.
     4133       define variable v-ingr-qnty     as decimal       no-undo.
     4134       define buffer buf_i_fbr-line    for ub.fbr-line.
     4135       define buffer buf_fbr-line      for ub.fbr-line.
     4136       define buffer buf_recipe        for ub.fbr-recipe.
     4137       define buffer buf_recipe-gds    for ub.fbr-recipe-gds.
     4138   do
     4139   for buf_i_fbr-line
     4140     , buf_fbr-line
     4141     , buf_recipe
     4142     , buf_recipe-gds
     4143   on error undo, return error
     4144   :
     4145       find first buf_i_fbr-line no-lock
     4146            where recid( buf_i_fbr-line ) = p-fbr-v-fbr-doc-line-recid
     4147       .
     4148       find first buf_recipe no-lock
     4149            where buf_recipe.doc-code      = buf_i_fbr-line.doc-code
     4150              and buf_recipe.recipe-code   = buf_i_fbr-line.recipe-code
     4151       no-error.
     4152       if not available buf_recipe
     4153       then do:
     4154           message
     4155                   vss-workfile vss-revision vss-description
     4156               skip "В строке производства не указан рецепт."
     4157               skip "Невозможно рассчитать количество составного товара."
     4158               skip return-value
     4159               skip trim(error-status :get-message(1))
     4160                   trim(error-status :get-message(2))
     4161                   trim(error-status :get-message(3))
     4162           view-as alert-box error.
     4163           undo, return error .
     4164       end.
     4165       if buf_recipe.recipe-type = 'альтернатива':U
     4166       then do:
     4167           for each buf_fbr-line no-lock
     4168              where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     4169                and buf_fbr-line.trn-type    = buf_i_fbr-line.trn-type
     4170                and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     4171           on error undo, return error
     4172           :
     4173               find first buf_recipe-gds no-lock
     4174                    where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     4175                      and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     4176                      and buf_recipe-gds.artic       = buf_fbr-line.artic
     4177                      and buf_recipe-gds.prod-type   = buf_fbr-line.prod-type
     4178                      and buf_recipe-gds.prod-code   = buf_fbr-line.prod-code
     4179               .
     4180               assign
     4181                   p-comp-qnty         = p-comp-qnty       + ( buf_fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty )
     4182               .
     4183           end.
     4184           assign
     4185               p-comp-qnty         = p-comp-qnty       / buf_recipe.qnty
     4186           .
     4187       end.
     4188       else do:
     4189           find first buf_recipe-gds no-lock
     4190                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     4191                  and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     4192                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     4193                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     4194                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     4195           .
     4196           assign
     4197               p-comp-qnty = p-fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     4198           .
     4199       end.
     4200       find first buf_fbr-line no-lock
     4201            where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     4202              and buf_fbr-line.is-comp     = yes
     4203              and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     4204       .
     4205       assign
     4206           p-comp-fbr-v-fbr-doc-line-recid = recid( buf_fbr-line )
     4207       .
     4208   end.
     4209   END PROCEDURE.
     4210   PROCEDURE get-temp_dressing-ingr-used-qnty :
     4211   define input parameter p-recipe-code    as character    no-undo.
     4212   define input parameter p-gds-code       as integer      no-undo.
     4213   define output parameter p-line-qnty     as decimal      no-undo.
     4214   define output parameter p-used-qnty     as decimal      no-undo.
     4215   define output parameter p-recipe-qnty   as decimal      no-undo.
     4216       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     4217   do
     4218   for buf_temp_dressing-ingr
     4219   on error undo, return error
     4220   :
     4221       find first buf_temp_dressing-ingr no-lock
     4222            where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     4223              and buf_temp_dressing-ingr.gds-code    = p-gds-code
     4224       no-error.
     4225       if available buf_temp_dressing-ingr
     4226       then do:
     4227           assign
     4228               p-line-qnty     = buf_temp_dressing-ingr.line-qnty
     4229               p-used-qnty     = buf_temp_dressing-ingr.used-qnty
     4230               p-recipe-qnty   = buf_temp_dressing-ingr.recipe-qnty
     4231           .
     4232       end.
     4233       else do:
     4234           assign
     4235               p-line-qnty     = 0
     4236               p-used-qnty     = 0
     4237               p-recipe-qnty   = 0
     4238           .
     4239       end.
     4240   end.
     4241   END PROCEDURE.
     4242   PROCEDURE fbrlib_adjust-recipe :
     4243   do
     4244   on error undo, return error
     4245   :
     4246   define input parameter parparentproc as widget-handle no-undo .
     4247   define input parameter p-fbrhist-handle as handle no-undo .
     4248   define input parameter p-doc-code       as character    no-undo.
     4249   define input parameter p-recipe-code    as character    no-undo.
     4250   define input parameter p-price-sale-obj-type as character no-undo .
     4251   define input parameter p-price-sale-obj-code as integer no-undo .
     4252       define variable v-recipe-qnty       as decimal      no-undo.
     4253       define variable v-comp-qnty         as decimal      no-undo.
     4254       define variable v-recipe-gds-qnty   as decimal      no-undo.
     4255       define variable v-ingr-qnty         as decimal      no-undo.
     4256       define variable v-qnty              as decimal      no-undo.
     4257       define variable v-coeff-waste       as decimal      no-undo.
     4258       define variable v-brutto-qnty       as decimal      no-undo.
     4259       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4260       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4261       define buffer buf_fbr-line          for ub.fbr-line.
     4262       define buffer buf_el_fbr-recipe-gds for ub.fbr-recipe-gds.
     4263       find first buf_fbr-recipe no-lock
     4264            where buf_fbr-recipe.doc-code      = p-doc-code
     4265              and buf_fbr-recipe.recipe-code   = p-recipe-code
     4266       .
     4267       assign
     4268           v-recipe-qnty = buf_fbr-recipe.qnty
     4269       .
     4270       find first buf_fbr-line no-lock
     4271            where buf_fbr-line.doc-code    = p-doc-code
     4272              and buf_fbr-line.is-comp     = yes
     4273              and buf_fbr-line.recipe-code = p-recipe-code
     4274       .
     4275       assign
     4276           v-comp-qnty = buf_fbr-line.fact-qnty
     4277       .
     4278       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     4279       then do:
     4280       end.
     4281       else do:
     4282           for each buf_fbr-recipe-gds no-lock
     4283              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4284                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4285           on error undo, return error
     4286           :
     4287               find first buf_fbr-line no-lock
     4288                    where buf_fbr-line.doc-code    = p-doc-code
     4289                      and buf_fbr-line.is-comp     = no
     4290                      and buf_fbr-line.recipe-code = p-recipe-code
     4291                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4292                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4293                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4294               .
     4295               if buf_fbr-line.fact-qnty / v-comp-qnty <> buf_fbr-recipe-gds.brutto-qnty / v-recipe-qnty
     4296               then do:
     4297                   do transaction
     4298                   on error undo, return error
     4299                   :
     4300                       find first buf_el_fbr-recipe-gds exclusive-lock
     4301                            where recid( buf_el_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
     4302                       .
     4303                       assign
     4304                           buf_el_fbr-recipe-gds.calc-method   = 1
     4305                           buf_el_fbr-recipe-gds.brutto-qnty   = buf_fbr-line.fact-qnty * v-recipe-qnty / v-comp-qnty
     4306                       .
     4307                       run fbrlib-calc-brutto in this-procedure (
     4308                             input buf_fbr-recipe.recipe-type
     4309                           , input 0
     4310                           , input buf_el_fbr-recipe-gds.coeff-value
     4311                           , input buf_el_fbr-recipe-gds.coeff-waste
     4312                           , input buf_el_fbr-recipe-gds.brutto-qnty
     4313                           , input 1
     4314                           , output buf_el_fbr-recipe-gds.qnty
     4315                           , output buf_el_fbr-recipe-gds.coeff-waste
     4316                           , output buf_el_fbr-recipe-gds.brutto-qnty
     4317                           , output buf_el_fbr-recipe-gds.calc-method
     4318                       ).
     4319                   end.
     4320               end.
     4321           end.
     4322           run fbrlib_adjust-doc-lines in this-procedure (
     4323                 input parparentproc
     4324               , input p-fbrhist-handle
     4325               , input p-doc-code
     4326               , input p-recipe-code
     4327               , input p-price-sale-obj-type
     4328               , input p-price-sale-obj-code
     4329           ).
     4330       end.
     4331   end.
     4332   END PROCEDURE.
     4333   PROCEDURE fbrlib_adjust-doc-lines :
     4334   define input parameter parparentproc as widget-handle no-undo .
     4335   define input parameter p-fbrhist-handle as handle no-undo .
     4336   define input parameter p-doc-code       as character    no-undo.
     4337   define input parameter p-recipe-code    as character    no-undo.
     4338   define input parameter p-price-sale-obj-type as character no-undo .
     4339   define input parameter p-price-sale-obj-code as integer no-undo .
     4340   define variable v-comp-qnty         as decimal      no-undo.
     4341   define variable v-trn-type          as character    no-undo.
     4342   define variable v-ingr-qnty         as decimal      no-undo.
     4343   define variable v-recipe-qnty       as decimal      no-undo.
     4344   define variable v-fbr-v-fbr-doc-line-recid    as recid        no-undo.
     4345   define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4346   define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4347   define buffer buf_fbr-line          for ub.fbr-line.
     4348   define buffer buf_coeff_fbr-line    for ub.fbr-line.
     4349   define buffer buf_goods             for ub.goods.
     4350   define buffer buf_fbr-doc           for ub.fbr-doc.
     4351   do
     4352   for buf_fbr-recipe
     4353     , buf_fbr-recipe-gds
     4354     , buf_fbr-line
     4355     , buf_coeff_fbr-line
     4356     , buf_goods
     4357     , buf_fbr-doc
     4358   on error undo, return error
     4359   :
     4360       find first buf_fbr-line no-lock
     4361            where buf_fbr-line.doc-code      = p-doc-code
     4362              and buf_fbr-line.is-comp       = yes
     4363              and buf_fbr-line.recipe-code   = p-recipe-code
     4364       .
     4365       find first buf_fbr-doc no-lock
     4366            where buf_fbr-doc.doc-code      = p-doc-code
     4367       .
     4368       assign
     4369           v-comp-qnty = buf_fbr-line.fact-qnty
     4370           v-trn-type  = buf_fbr-line.trn-type
     4371       .
     4372       find first buf_fbr-recipe no-lock
     4373            where buf_fbr-recipe.doc-code    = p-doc-code
     4374              and buf_fbr-recipe.recipe-code = p-recipe-code
     4375       .
     4376       assign
     4377       v-recipe-qnty = buf_fbr-recipe.qnty
     4378       .
     4379       do transaction
     4380       on error undo, return error
     4381       :
     4382           for each buf_fbr-recipe-gds no-lock
     4383              where buf_fbr-recipe-gds.doc-code      = p-doc-code
     4384                and buf_fbr-recipe-gds.recipe-code   = p-recipe-code
     4385           on error undo, return error
     4386           :
     4387               find first buf_fbr-line no-lock
     4388                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4389                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4390                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4391                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4392                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4393               no-error.
     4394               if not available buf_fbr-line
     4395               then do:
     4396                   find first buf_goods no-lock
     4397                        where buf_goods.artic      = buf_fbr-recipe-gds.artic
     4398                          and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     4399                          and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     4400                   .
     4401                   run str/fbr-crln.p (
     4402                         input parparentproc
     4403                       , input recid( buf_fbr-doc )
     4404                       , input recid( buf_goods )
     4405                       , input buf_fbr-recipe-gds.recipe-code
     4406                       , input v-trn-type
     4407                       , input no
     4408                       , input no
     4409                       , input buf_fbr-doc.obj-type
     4410                       , input buf_fbr-doc.obj-code
     4411                       , output v-fbr-v-fbr-doc-line-recid
     4412                   ).
     4413                   find first buf_fbr-line no-lock
     4414                        where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4415                          and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4416                          and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4417                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4418                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4419                   no-error.
     4420                   if not available buf_fbr-line
     4421                   then do:
     4422                       undo, return error substitute("Не удалось создать строку документа производства &1 &2&3&4"
     4423                                                      , p-doc-code
     4424                                                      , buf_fbr-recipe-gds.artic
     4425                                                      , buf_fbr-recipe-gds.prod-type
     4426                                                      , buf_fbr-recipe-gds.prod-code).
     4427                   end.
     4428               end.
     4429               find first buf_coeff_fbr-line exclusive-lock
     4430                    where recid( buf_coeff_fbr-line ) = recid( buf_fbr-line )
     4431               .
     4432               if buf_coeff_fbr-line.calc-method <> buf_fbr-recipe-gds.calc-method
     4433               or buf_coeff_fbr-line.coeff-value <> buf_fbr-recipe-gds.coeff-value
     4434               or buf_coeff_fbr-line.coeff-waste <> buf_fbr-recipe-gds.coeff-waste
     4435               then do:
     4436                   assign
     4437                       buf_coeff_fbr-line.calc-method = buf_fbr-recipe-gds.calc-method
     4438                       buf_coeff_fbr-line.coeff-value = buf_fbr-recipe-gds.coeff-value
     4439                       buf_coeff_fbr-line.coeff-waste = buf_fbr-recipe-gds.coeff-waste
     4440                   .
     4441               end.
     4442           end.
     4443       end.
     4444       define variable v-need-goods    as logical       no-undo.
     4445       define variable v-need-goods-list       as character     no-undo.
     4446       define variable v-need-goods-qnty-list  as character     no-undo.
     4447       find first buf_fbr-line no-lock
     4448            where buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     4449              and buf_fbr-line.is-comp     = yes
     4450              and buf_fbr-line.recipe-code = p-recipe-code
     4451       .
     4452       run str/fbr-qnty.p (
     4453             input parparentproc
     4454           , input p-fbrhist-handle
     4455           , input recid( buf_fbr-doc )
     4456           , input recid( buf_fbr-line )
     4457           , input no
     4458           , input "ingr"
     4459           , input no
     4460           , input p-price-sale-obj-type
     4461           , input p-price-sale-obj-code
     4462           , input no
     4463           , input no
     4464           , input no
     4465           , output v-need-goods
     4466           , output v-need-goods-list
     4467           , output v-need-goods-qnty-list
     4468       ).
     4469   end.
     4470   END PROCEDURE.
     4471   procedure fbrlib_check-before-close :
     4472   define input parameter p-doc-code as character no-undo .
     4473   define variable same-sale as decimal no-undo .
     4474   define variable is-waste as logical no-undo .
     4475   define variable fix-price as logical no-undo .
     4476   define buffer buf_fbr-doc for ub.fbr-doc.
     4477   define buffer buf_fbr-line for ub.fbr-line.
     4478   define buffer buf_goods for ub.goods.
     4479   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     4480   do
     4481   on error undo, return error
     4482   :
     4483     for each buf_fbr-line no-lock
     4484         where buf_fbr-line.doc-code = p-doc-code
     4485       , each buf_goods no-lock
     4486         where buf_goods.artic     = buf_fbr-line.artic
     4487           and buf_goods.prod-type = buf_fbr-line.prod-type
     4488           and buf_goods.prod-code = buf_fbr-line.prod-code
     4489     break by buf_fbr-line.prod-type
     4490           by buf_fbr-line.prod-code
     4491           by buf_fbr-line.artic
     4492     :
     4493       if first-of (buf_fbr-line.artic)
     4494       then do:
     4495         assign
     4496         same-sale = buf_fbr-line.price-sale
     4497         is-waste = (buf_fbr-line.rsrv-qnty = ?)
     4498         fix-price = buf_fbr-line.is-calc
     4499         .
     4500       end.
     4501       if same-sale <> buf_fbr-line.price-sale
     4502       then do:
     4503           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром должна быть указана одна и та же цена продажи."
     4504                                         ,p-doc-code
     4505                                         ,buf_goods.artic
     4506                                         ,buf_goods.gds-name
     4507                                         ,chr(10)).
     4508       end.
     4509       if fix-price <> buf_fbr-line.is-calc then do:
     4510           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром цена должна быть фиксирована или нет."
     4511                                         ,p-doc-code
     4512                                         ,buf_goods.artic
     4513                                         ,buf_goods.gds-name
     4514                                         ,chr(10)).
     4515       end.
     4516       if is-waste <> (buf_fbr-line.rsrv-qnty = ?)
     4517       then do:
     4518         undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа этот товар должен быть отходом либо не отходом."
     4519                                         ,p-doc-code
     4520                                         ,buf_goods.artic
     4521                                         ,buf_goods.gds-name
     4522                                         ,chr(10)).
     4523       end.
     4524       if buf_fbr-line.rsrv-qnty <> ?
     4525       and buf_goods.gds-type <> 'у':U
     4526       and ( buf_fbr-line.price-sale <= 0 or buf_fbr-line.price-sale = ?  )
     4527       and buf_fbr-line.fact-qnty <> 0
     4528       then do:
     4529         if buf_fbr-line.trn-type     = 'при':U  then for first buf_fbr-doc where buf_fbr-doc.doc-code =  p-doc-code no-lock:
     4530           if  can-find(first buf_fbr-gds-obj no-lock where
     4531                   buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     4532               AND buf_fbr-gds-obj.obj-type = buf_fbr-doc.obj-type
     4533               AND buf_fbr-gds-obj.obj-code = buf_fbr-doc.obj-code
     4534               and buf_fbr-gds-obj.is-null-price  )  then .
     4535                     else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4536                                         ,p-doc-code
     4537                                         ,buf_goods.artic
     4538                                         ,buf_goods.gds-name
     4539                                         ,chr(10)
     4540                                         ,buf_fbr-line.recipe-code
     4541                                         ).
     4542         end.
     4543         else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4544                                         ,p-doc-code
     4545                                         ,buf_goods.artic
     4546                                         ,buf_goods.gds-name
     4547                                         ,chr(10)
     4548                                         ,buf_fbr-line.recipe-code
     4549                                         ).
     4550       end.
     4551     end.
     4552   end.
     4553   end procedure.
     4554   procedure fbrrest-get-free-qnty :
     4555   do
     4556   on error undo, return error
     4557   :
     4558   define input parameter p-obj-type       as character            no-undo.
     4559   define input parameter p-obj-code       as integer              no-undo.
     4560   define input parameter p-gds-code       as integer              no-undo.
     4561   define input parameter p-autofbr        as logical              no-undo.
     4562   define output parameter p-avail-qnty    as decimal              no-undo.
     4563       define variable v-req-qnty  like ub.fbr-line.fact-qnty no-undo.
     4564       define variable v-free-qnty as decimal       no-undo.
     4565       define buffer buf_goods         for ub.goods.
     4566       define buffer buf_gds-obj       for ub.gds-obj.
     4567       define buffer buf_temp-parts    for temp-parts.
     4568       find first buf_goods no-lock
     4569            where buf_goods.gds-code = p-gds-code
     4570       .
     4571       assign
     4572           p-avail-qnty = 0
     4573       .
     4574       run partslib-init-temp-parts in this-procedure (
     4575             input p-obj-type
     4576           , input p-obj-code
     4577           , input buf_goods.artic
     4578           , input buf_goods.prod-type
     4579           , input buf_goods.prod-code
     4580       ).
     4581       assign
     4582           v-free-qnty = 0
     4583       .
     4584       for each buf_temp-parts
     4585       on error undo, return error
     4586       :
     4587           if buf_temp-parts.qnty > 0
     4588           then do:
     4589               assign
     4590                   v-free-qnty = v-free-qnty + buf_temp-parts.free-qnty
     4591               .
     4592           end.
     4593       end.
     4594       assign
     4595           p-avail-qnty = ( if v-free-qnty > 0 then v-free-qnty else 0 )
     4596       .
     4597   end.
     4598   end procedure.
     4599   procedure fbrrest-get-catering-object :
     4600   do
     4601   on error undo, return error
     4602   :
     4603   define input parameter p-obj-code            as integer      no-undo.
