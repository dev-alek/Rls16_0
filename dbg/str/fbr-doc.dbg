    11632       "Интерфейсный элемент" self :name  skip
    11633       "Тип" self :type  skip
    11634       "Процедура" this-procedure :file-name skip
    11635       view-as alert-box .
    11636   end.
    11637   else do:
    11638     apply "entry":u to self  .
    11639     if focus :handle <> self :handle  then do:
    11640       return no-apply .
    11641     end.
    11642   end.
    11643         define variable v-comp-fbr-v-fbr-doc-line-recid as recid   no-undo.
    11644         define variable v-comp-qnty                     as decimal no-undo.
    11645         define variable v-comp-price-sale               as decimal no-undo.
    11646         if not available buf_ingr_fbr-line
    11647            then
    11648         do:
    11649            message "Неправильно выбрана строка.".
