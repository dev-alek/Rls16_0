       83   define   shared variable g#passwd as character no-undo .
       84   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   procedure cur-time :
       86      define output parameter p-today as date      no-undo .
       87      define output parameter p-time  as integer   no-undo .
       88     do
       89     on error undo, return error
       90     :
       91       define variable v-date1 as date      no-undo .
       92       define variable v-date2 as date      no-undo .
       93       define variable v-time  as integer   no-undo .
       94       assign
       95         v-date1 = today
       96         v-time  = time
       97         v-date2 = today
       98       .
       99       if v-date1 <> v-date2
      100       then do:
      101         assign
      102           v-date1 = today
      103           v-time  = v-time
      104         .
      105       end.
      106       assign
      107         p-today = v-date1
      108         p-time  = v-time
      109       .
      110     end.
      111   end.
      112   function cur-time-date returns character
      113   :
      114     return string(today, '99/99/9999':U) .
      115   end.
      116   function cur-time-mjd returns decimal
      117   :
      118     define variable v-date as date      no-undo .
      119     define variable v-time as integer   no-undo .
      120     run cur-time in this-procedure
      121       (output v-date
      122       ,output v-time
      123       ) .
      124     return integer(v-date) - 2400002 + (v-time / 86400) .
      125   end.
      126   function cur-time-get-ending-index returns integer
      127   (input p-number as integer
      128   )
      129   :
      130     if p-number < 0
      131     or p-number = ?
      132     then do:
      133       return 1 .
      134     end.
      135     define variable v-rest as integer   no-undo .
      136     assign
      137       p-number = p-number modulo 100
      138     .
      139     if p-number < 20
      140     then do:
      141       assign
      142         v-rest = p-number
      143       .
      144     end.
      145     else do:
      146       assign
      147         v-rest = p-number modulo 10
      148       .
      149     end.
      150     case v-rest :
      151       when 1
      152       then do:
      153         return 2 .
      154       end.
      155       when 2 or
      156       when 3 or
      157       when 4
      158       then do:
      159         return 3 .
      160       end.
      161       otherwise do:
      162         return 1 .
      163       end.
      164     end case .
      165   end.
      166   procedure cur-time-mjd-to-date :
      167      define input  parameter i-mjd-diff as decimal no-undo.
      168      define output parameter o-Date     as date    no-undo.
      169      define output parameter o-Time     as integer no-undo.
      170      define variable v-day-number as integer   no-undo .
      171      if    i-mjd-diff < 0
      172         or i-mjd-diff = ?
      173      then do:
      174         return "?" .
      175      end.
      176      assign
      177         v-day-number = truncate(i-mjd-diff,0).
      178         o-Date = date(v-day-number + 2400002).
      179         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      180     .
      181   end.
      182   function cur-time-mjd-to-string returns character
      183   (input p-mjd-diff as decimal
      184   )
      185   :
      186     define variable v-day-number as integer   no-undo .
      187     define variable v-seconds    as integer   no-undo .
      188     define variable v-hour       as integer   no-undo .
      189     define variable v-min        as integer   no-undo .
      190     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      191     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      192     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      193     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      194     if p-mjd-diff < 0
      195     or p-mjd-diff = ?
      196     then do:
      197       return "?" .
      198     end.
      199     assign
      200       v-day-number = integer(truncate(p-mjd-diff,0))
      201       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      202     .
      203     if v-seconds > 86400
      204     then do:
      205       assign
      206         v-seconds = 86400 - 1
      207       .
      208     end.
      209     if v-seconds < 0
      210     then do:
      211       assign
      212         v-seconds = 0
      213       .
      214     end.
      215     assign
      216       v-hour = truncate(v-seconds / 3600, 0)
      217     .
      218     assign
      219       v-seconds = v-seconds modulo 3600
      220     .
      221     assign
      222       v-min = truncate(v-seconds / 60, 0)
      223     .
      224     assign
      225       v-seconds = v-seconds modulo 60
      226     .
      227     return
      228         (if v-day-number <> 0
      229           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      230           else ""
      231         )
      232       + (if v-day-number <> 0 or v-hour <> 0
      233           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      234           else ""
      235         )
      236       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      237           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      238           else ""
      239         )
      240       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      241       .
      242   end.
      243   function cur-time-string returns character
      244   :
      245     define variable v-date as date      no-undo .
      246     define variable v-time as integer   no-undo .
      247     run cur-time in this-procedure
      248       (output v-date
      249       ,output v-time
      250       ) .
      251     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      252   end.
      253   function cur-time-string-sec returns character
      254   :
      255     define variable v-date as date      no-undo .
      256     define variable v-time as integer   no-undo .
      257     run cur-time in this-procedure
      258       (output v-date
      259       ,output v-time
      260       ) .
      261     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      262   end.
      263   function cur-time-custom  returns character
      264   (input p-prefix as character
      265   ,input p-date-format as character
      266   ,input p-delimiter as character
      267   ,input p-time-format as character
      268   ,input p-suffix as character
      269   )
      270   :
      271     define variable v-date as date      no-undo .
      272     define variable v-time as integer   no-undo .
      273     run cur-time in this-procedure
      274       (output v-date
      275       ,output v-time
      276       ) .
      277     return
      278       p-prefix
      279       + string(v-date, p-date-format)
      280       + p-delimiter
      281       + string(v-time, p-time-format)
      282       + p-suffix
      283       .
      284   end.
      285   function cur-time-print  returns character
      286   :
      287     define variable v-date as date      no-undo .
      288     define variable v-time as integer   no-undo .
      289     run cur-time in this-procedure
      290       (output v-date
      291       ,output v-time
      292       ) .
      293     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      294   end.
      295   function cur-time-datetime returns datetime
      296   :
      297     define variable v-char as character no-undo .
      298     define variable v-datetime as datetime no-undo .
      299     v-char = cur-time-string().
      300     v-datetime = datetime(v-char).
      301     return  v-datetime.
      302   end.
      303   function cur-time-string-msec returns character
      304   :
      305     define variable v-date as datetime  no-undo .
      306     v-date = now.
      307     return string(v-date) .
      308   end.
      309   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      310     define variable v-cntxt-db-num        as integer   no-undo .
      311     define variable v-cntxt-userid        as character no-undo .
      312     define variable v-cntxt-level         as character no-undo .
      313     define variable v-cntxt-host-code-obj as integer   no-undo .
      314     define variable v-cntxt-obj-type      as character no-undo .
      315     define variable v-cntxt-obj-code      as integer   no-undo .
      316     define variable v-cntxt-db-num-obj    as integer   no-undo .
      317     define variable v-cntxt-is-admin      as logical   no-undo .
      318   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      319   procedure doc-code:
      320   define input  parameter parmode          as   character           no-undo.
      321   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      322   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      323   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      324   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      325   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      326   define variable vardb-remote     as   logical             no-undo.
      327   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      328   define variable v-delimiter as character no-undo .
      329   do
      330   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      331   :
      332   find first buf_sys-ctrl no-lock .
      333   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      334     CASE parmode:
      335       when "main":u then do:
      336         if vardb-remote then do:
      337           assign
      338             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      339         end.
      340         else do:
      341           assign
      342             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      343         end.
      344       end.
      345       when "trio" then do:
      346         assign
      347           pardoc-code = replace (parroot-doc-code, "=", "*").
      348       end.
      349       otherwise do:
      350         assign
      351         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      352         no-error
      353         .
      354         if error-status:error  then do:
      355           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      356                                         ,chr(10)
      357                                         ,parmode
      358                                         ).
      359         end.
      360         if num-entries(parmode) = 1
      361         and parmode <> "chip":U
      362         and parmode <> "chip_s":U
      363         then do:
      364           assign
      365           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      366         end.
      367         else if (lookup("chip":U, parmode) > 0
      368                  or
      369                  lookup("chip_s":U, parmode) > 0) then do:
      370           assign
      371             vartemp-doc-code = parroot-doc-code.
      372           do while true:
      373             if index (vartemp-doc-code , ".") = 0 then
      374               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      375             else
      376               vartemp-doc-code  =
      377               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      378               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      379               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      380             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      381           end.
      382           assign
      383             pardoc-code = vartemp-doc-code.
      384         end.
      385       end.
      386     end CASE.
      387     if pardoc-code = '':U
      388     or (parroot-doc-code <> '':U
      389     and pardoc-code = parroot-doc-code) then do:
      390       undo, return error substitute("Ошибка при генерации номера документа&1"
      391                                     ,chr(10)).
      392     end.
      393   end.
      394   end. // procedure/method
      395   function get-doc-code-int64 returns int64
      396     ( input p-doc-code as character ) :
      397     define variable v-ind              as integer   no-undo .
      398     define variable v-num-entries      as integer   no-undo .
      399     define variable v-doc-code-int64   as int64     no-undo .
      400     define variable v-canonic-doc-code as character no-undo .
      401     assign
      402       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      403       v-canonic-doc-code = p-doc-code
      404     .
      405     do v-ind = 1 to v-num-entries
      406     :
      407       assign
      408         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      409       .
      410     end.
      411     assign
      412       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      413     .
      414     return v-doc-code-int64 .
      415   end. // function/method
      416   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      417   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      418   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      419   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      420   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      421   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      422   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      423   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      424   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      425   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      426   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      427   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      428   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      429   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      430   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      431   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      432   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      433   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      434   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      435       def var log-file-name as char no-undo.
      436       if search('fbr.log') = ?
      437       then do:
      438           assign
      439               log-file-name = ""
      440           .
      441       end.
      442       else do:
      443           assign
      444               log-file-name = 'fbr.log'
      445           .
      446       end.
      447       DEF STREAM stm-log.
      448       PROCEDURE writelog:
      449       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
      450       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
      451       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
      452       if p-file-name <> ""
      453       then do:
      454       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
      455           PUT STREAM stm-log UNFORMATTED chr(10).
      456           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
      457                                           OR p-log-string = "&Line") THEN "" ELSE
      458                                           cur-time-string-sec() + " ").
      459           PUT STREAM stm-log UNFORMATTED
      460                   (IF p-log-string = "&Line" THEN FILL("-", 80)
      461                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
      462                   ELSE fill(" ", p-log-level * 2) + p-log-string).
      463       OUTPUT STREAM stm-log CLOSE.
      464       end.
      465       END PROCEDURE.
      466   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      467   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      468   procedure partslib-clear-temp-parts :
      469     define buffer buf_temp-parts for temp-parts .
      470     do
      471     on error undo, return error
      472     :
      473       for each buf_temp-parts
      474       on error undo, return error
      475       :
      476         delete buf_temp-parts .
      477       end.
      478     end.
      479   end procedure.
      480   procedure partslib-create-temp-parts :
      481     define parameter buffer buf_parts       for ub.parts .
      482     define parameter buffer buf_temp-parts  for temp-parts .
      483     define input  parameter p-goods-twounit as logical   no-undo .
      484     define variable v-base-part-code as character no-undo .
      485     do
      486     on error undo, return error
      487     :
      488       if p-goods-twounit = true
      489       then do:
      490         assign
      491           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      492         .
      493       end.
      494       else do:
      495         assign
      496           v-base-part-code = buf_parts.part-code
      497         .
      498       end.
      499       find first buf_temp-parts exclusive-lock
      500         where buf_temp-parts.obj-type  = buf_parts.obj-type
      501           and buf_temp-parts.obj-code  = buf_parts.obj-code
      502           and buf_temp-parts.artic     = buf_parts.artic
      503           and buf_temp-parts.prod-type = buf_parts.prod-type
      504           and buf_temp-parts.prod-code = buf_parts.prod-code
      505           and buf_temp-parts.in-code   = buf_parts.in-code
      506           and buf_temp-parts.out-code  = 'free-zone':U
      507           and buf_temp-parts.part-code = v-base-part-code
      508         no-error.
      509       if not available buf_temp-parts
      510       then do:
      511         create buf_temp-parts .
      512         buffer-copy buf_parts to buf_temp-parts
      513         assign
      514           buf_temp-parts.out-code  = 'free-zone':U
      515           buf_temp-parts.part-code = v-base-part-code
      516           buf_temp-parts.rsrv-free = yes
      517           buf_temp-parts.status_   = no
      518           buf_temp-parts.qnty      = 0
      519           buf_temp-parts.fact-qnty = 0
      520           buf_temp-parts.real-qnty = 0
      521           buf_temp-parts.cli-qnty  = 0
      522         .
      523       end.
      524     end.
      525   end procedure.
      526   procedure partslib-init-temp-parts :
      527     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      528     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      529     define input parameter p-artic           like ub.parts.artic     no-undo .
      530     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      531     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      532     define buffer buf_parts      for ub.parts .
      533     define buffer buf_temp-parts for temp-parts .
      534     define variable v-goods-twounit    as logical   no-undo .
      535     do
      536     on error undo, return error
      537     :
      538   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      539   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      540     (input  p-artic
      541     ,input  p-prod-type
      542     ,input  p-prod-code
      543     ,input  'twounit=request':u
      544     ,output v-goods-twounit
      545     ) no-error .
      546       if error-status :error
      547       then do:
      548         message
      549           vss-workfile vss-revision vss-description skip
      550           vss-include-info5 skip
      551           "Ошибка при определении атрибута товара" skip
      552           "Артикул" p-artic p-prod-type p-prod-code skip
      553           "twounit=request" skip
      554           error-status :get-message(1) skip
      555           return-value skip
      556           view-as alert-box error .
      557         undo, return error return-value .
      558       end.
      559       run partslib-clear-temp-parts in this-procedure .
      560       for each buf_parts
      561         where buf_parts.obj-type  = p-obj-type
      562           and buf_parts.obj-code  = p-obj-code
      563           and buf_parts.artic     = p-artic
      564           and buf_parts.prod-type = p-prod-type
      565           and buf_parts.prod-code = p-prod-code
      566           and buf_parts.rsrv-free = yes
      567           and buf_parts.status_   = no
      568           and buf_parts.in-code   <> buf_parts.out-code
      569       on error undo, return error
      570       :
      571         run partslib-create-temp-parts in this-procedure
      572           (buffer buf_parts
      573           ,buffer buf_temp-parts
      574           ,input  v-goods-twounit
      575           ) .
      576         define variable v-parts-qnty          as decimal   no-undo .
      577         define variable v-parts-cli-qnty      as decimal   no-undo .
      578         define variable v-parts-free-qnty     as decimal   no-undo .
      579         define variable v-parts-free-cli-qnty as decimal   no-undo .
      580         if buf_parts.out-code = 'free-zone':U
      581         then do:
      582           assign
      583             v-parts-qnty          = buf_parts.qnty
      584             v-parts-cli-qnty      = buf_parts.cli-qnty
      585             v-parts-free-qnty     = buf_parts.qnty
      586             v-parts-free-cli-qnty = buf_parts.cli-qnty
      587           .
      588         end.
      589         else do:
      590           assign
      591             v-parts-qnty          = abs(buf_parts.qnty)
      592             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      593             v-parts-free-qnty     = 0
      594             v-parts-free-cli-qnty = 0
      595           .
      596         end.
      597         assign
      598           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      599           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      600           buf_temp-parts.real-qnty     = 0
      601           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      602           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      603           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      604         .
      605       end.
      606     end.
      607   end procedure.
      608   procedure partslib-init-temp-parts-by-factord :
      609     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      610     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      611     define input parameter p-artic              like ub.parts.artic     no-undo .
      612     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      613     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      614     define input parameter p-fact-order         as decimal   no-undo .
      615     define input parameter p-include-fact-order as logical   no-undo .
      616     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      617     define buffer buf_gds-obj  for ub.gds-obj .
      618     do
      619     on error undo, return error
      620     :
      621       do transaction
      622       on error undo, return error
      623       :
      624   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      625   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      626     (input  p-obj-type
      627     ,input  p-obj-code
      628     ,input  p-artic
      629     ,input  p-prod-type
      630     ,input  p-prod-code
      631     ,buffer buf_gds-obj
      632     ) no-error .
      633         if error-status :error
      634         then do:
      635           message
      636             vss-workfile vss-revision vss-description skip
      637             vss-include-info5 skip
      638             "Невозможно найти товар на объекте" skip
      639             "Объект" p-obj-type p-obj-code skip
      640             "Артикул" p-artic p-prod-type p-prod-code skip
      641             error-status :get-message(1) skip
      642             return-value skip
      643             view-as alert-box error .
      644           undo, return error .
      645         end.
      646         find current buf_gds-obj exclusive-lock .
      647       end.
      648       run partslib-init-temp-parts in this-procedure
      649         (input p-obj-type
      650         ,input p-obj-code
      651         ,input p-artic
      652         ,input p-prod-type
      653         ,input p-prod-code
      654         ) no-error .
      655       if error-status :error
      656       then do:
      657         message
      658           vss-workfile vss-revision vss-description skip
      659           vss-include-info5 skip
      660           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      661           "Объект" p-obj-type p-obj-code skip
      662           "Артикул" p-artic p-prod-type p-prod-code skip
      663           "p-fact-order" p-fact-order skip
      664           view-as alert-box error .
      665         undo, return error .
      666       end.
      667       if p-include-fact-order = true
      668       then do:
      669         assign
      670           p-fact-order = p-fact-order - 0.0000000001
      671         .
      672       end.
      673       define variable v-max-fact-order as character no-undo .
      674       run factord-max-fact-order in this-procedure
      675         (output v-max-fact-order
      676         ) no-error .
      677       if error-status :error
      678       then do:
      679         message
      680           vss-workfile vss-revision vss-description skip
      681           vss-include-info5 skip
      682           "Ошибка при вызове процедуры factord-max-fact-order" skip
      683           "Объект" p-obj-type p-obj-code skip
      684           "Артикул" p-artic p-prod-type p-prod-code skip
      685           "p-fact-order" p-fact-order skip
      686           view-as alert-box error .
      687         undo, return error .
      688       end.
      689       run partslib-update-by-factord in this-procedure
      690         (input p-obj-type
      691         ,input p-obj-code
      692         ,input p-artic
      693         ,input p-prod-type
      694         ,input p-prod-code
      695         ,input p-fact-order
      696         ,input v-max-fact-order
      697         ,input false
      698         ) no-error .
      699       if error-status :error
      700       then do:
      701         message
      702           vss-workfile vss-revision vss-description skip
      703           vss-include-info5 skip
      704           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      705           "Объект" p-obj-type p-obj-code skip
      706           "Артикул" p-artic p-prod-type p-prod-code skip
      707           "p-fact-order" p-fact-order skip
      708           "v-max-fact-order" v-max-fact-order skip
      709           view-as alert-box error .
      710         undo, return error .
      711       end.
      712     end.
      713   end procedure.
      714   procedure partslib-update-by-factord :
      715     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      716     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      717     define input parameter p-artic              like ub.parts.artic     no-undo .
      718     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      719     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      720     define input parameter p-start-fact-order   as decimal   no-undo .
      721     define input parameter p-end-fact-order     as decimal   no-undo .
      722     define input parameter p-lock-gds-obj       as logical   no-undo .
      723     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      724     define buffer buf_gds-obj  for ub.gds-obj .
      725     define buffer buf_doc-line for ub.doc-line .
      726     define variable v-total-parts-qnty as decimal   no-undo .
      727     define variable v-goods-gds-goods  as logical   no-undo .
      728     define variable v-goods-twounit    as logical   no-undo .
      729     do
      730     on error undo, return error
      731     :
      732       if p-start-fact-order > p-end-fact-order
      733       then do:
      734         message
      735           vss-workfile vss-revision vss-description skip
      736           vss-include-info5 skip
      737           "Ошибка задания входных параметров" skip
      738           "Начало интервала превышает конец интервала" skip
      739           "Объект" p-obj-type p-obj-code skip
      740           "Артикул" p-artic p-prod-type p-prod-code skip
      741           "p-start-fact-order" p-start-fact-order skip
      742           "p-end-fact-order"   p-end-fact-order skip
      743           view-as alert-box error .
      744         undo, return error .
      745       end.
      746       if p-lock-gds-obj = true
      747       then do:
      748         do transaction
      749         on error undo, return error
      750         :
      751   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      752   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      753     (input  p-obj-type
      754     ,input  p-obj-code
      755     ,input  p-artic
      756     ,input  p-prod-type
      757     ,input  p-prod-code
      758     ,buffer buf_gds-obj
      759     ) no-error .
      760           if error-status :error
      761           then do:
      762             message
      763               vss-workfile vss-revision vss-description skip
      764               vss-include-info5 skip
      765               "Невозможно найти gds-obj" skip
      766               error-status :get-message(1) skip
      767               return-value skip
      768               view-as alert-box error .
      769             undo, return error .
      770           end.
      771           find current buf_gds-obj exclusive-lock .
      772         end.
      773       end.
      774   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      775   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      776     (input  p-artic
      777     ,input  p-prod-type
      778     ,input  p-prod-code
      779     ,input  'gds-goods=request':u
      780     ,output v-goods-gds-goods
      781     ) no-error .
      782       if error-status :error
      783       then do:
      784         message
      785           vss-workfile vss-revision vss-description skip
      786           vss-include-info5 skip
      787           "Ошибка при определении атрибута товара" skip
      788           "Артикул" p-artic p-prod-type p-prod-code skip
      789           "gds-goods=request" skip
      790           error-status :get-message(1) skip
      791           return-value skip
      792           view-as alert-box error .
      793         undo, return error return-value .
      794       end.
      795   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      796   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      797     (input  p-artic
      798     ,input  p-prod-type
      799     ,input  p-prod-code
      800     ,input  'twounit=request':u
      801     ,output v-goods-twounit
      802     ) no-error .
      803       if error-status :error
      804       then do:
      805         message
      806           vss-workfile vss-revision vss-description skip
      807           vss-include-info5 skip
      808           "Ошибка при определении атрибута товара" skip
      809           "Артикул" p-artic p-prod-type p-prod-code skip
      810           "twounit=request" skip
      811           error-status :get-message(1) skip
      812           return-value skip
      813           view-as alert-box error .
      814         undo, return error return-value .
      815       end.
      816       for each buf_doc-line no-lock
      817         where buf_doc-line.obj-type   = p-obj-type
      818           and buf_doc-line.obj-code   = p-obj-code
      819           and buf_doc-line.artic      = p-artic
      820           and buf_doc-line.prod-type  = p-prod-type
      821           and buf_doc-line.prod-code  = p-prod-code
      822           and buf_doc-line.status_    = 'факт':U
      823           and buf_doc-line.fact-order > p-start-fact-order
      824           and buf_doc-line.fact-order <= p-end-fact-order
      825       on error undo, return error
      826       :
      827         run partslib-process-document in this-procedure
      828           (input  buf_doc-line.doc-code
      829           ,input  p-obj-type
      830           ,input  p-obj-code
      831           ,input  p-artic
      832           ,input  p-prod-type
      833           ,input  p-prod-code
      834           ,input  v-goods-gds-goods
      835           ,input  v-goods-twounit
      836           ,output v-total-parts-qnty
      837           ) no-error .
      838         if error-status :error
      839         then do:
      840           message
      841             vss-workfile vss-revision vss-description skip
      842             vss-include-info5 skip
      843             "Ошибка при вызове процедуры partslib-process-document" skip
      844             "Документ" buf_doc-line.doc-code skip
      845             "Объект" p-obj-type p-obj-code skip
      846             "Артикул" p-artic p-prod-type p-prod-code skip
      847             "p-start-fact-order" p-start-fact-order skip
      848             "p-end-fact-order" p-end-fact-order skip
      849             error-status :get-message(1) skip
      850             return-value skip
      851             view-as alert-box error .
      852           undo, return error return-value .
      853         end.
      854       end.
      855     end.
      856   end procedure.
      857   procedure partslib-process-document :
      858     define input  parameter p-doc-code         as character no-undo .
      859     define input  parameter p-obj-type         as character no-undo .
      860     define input  parameter p-obj-code         as integer   no-undo .
      861     define input  parameter p-artic            as character no-undo .
      862     define input  parameter p-prod-type        as character no-undo .
      863     define input  parameter p-prod-code        as integer   no-undo .
      864     define input  parameter p-goods-gds-goods  as logical   no-undo .
      865     define input  parameter p-goods-twounit    as logical   no-undo .
      866     define output parameter p-total-parts-qnty as decimal   no-undo .
      867     define variable v-parts-sign as integer   no-undo .
      868     define buffer buf_trn-doc    for ub.trn-doc .
      869     define buffer buf_doc-line   for ub.doc-line .
      870     define buffer buf_parts      for ub.parts .
      871     define buffer buf_temp-parts for temp-parts .
      872     do
      873     on error undo, return error return-value
      874     :
      875       find first buf_trn-doc no-lock
      876         where buf_trn-doc.doc-code = p-doc-code
      877         no-error .
      878       if not available buf_trn-doc
      879       then do:
      880         undo, return error substitute("Ошибка при поиске документа. Документ &1"
      881                                      ,p-doc-code
      882                                      ) .
      883       end.
      884       case buf_trn-doc.doc-type
      885       :
      886         when 'при':U or
      887         when 'возврат':U or
      888         when 'инв':U
      889         then do:
      890           assign
      891             v-parts-sign = -1
      892           .
      893         end.
      894         when 'рас':U or
      895         when 'спи':U
      896         then do:
      897           assign
      898             v-parts-sign = 1
      899           .
      900         end.
      901         otherwise do:
      902           undo, return error substitute("Неизвестный тип документа &1"
      903                                       ,buf_trn-doc.doc-type
      904                                       ) .
      905         end.
      906       end.
      907       find first buf_doc-line no-lock
      908         where buf_doc-line.doc-code  = p-doc-code
      909           and buf_doc-line.artic     = p-artic
      910           and buf_doc-line.prod-type = p-prod-type
      911           and buf_doc-line.prod-code = p-prod-code
      912         no-error .
      913       if not available buf_doc-line
      914       then do:
      915         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
      916                                      ,p-doc-code
      917                                      ,artic
      918                                      ,prod-type
      919                                      ,prod-code
      920                                      ) .
      921       end.
      922       assign
      923         p-total-parts-qnty = 0
      924       .
      925       if p-goods-gds-goods = true
      926       then do:
      927         for each buf_parts no-lock
      928           where buf_parts.out-code  = p-doc-code
      929             and buf_parts.obj-type  = p-obj-type
      930             and buf_parts.obj-code  = p-obj-code
      931             and buf_parts.artic     = p-artic
      932             and buf_parts.prod-type = p-prod-type
      933             and buf_parts.prod-code = p-prod-code
      934         on error undo, return error
      935         :
      936           run partslib-create-temp-parts in this-procedure
      937             (buffer buf_parts
      938             ,buffer buf_temp-parts
      939             ,input  p-goods-twounit
      940             ) .
      941           assign
      942             p-total-parts-qnty        = p-total-parts-qnty
      943                                       + v-parts-sign * buf_parts.fact-qnty
      944             buf_temp-parts.qnty       = buf_temp-parts.qnty
      945                                       + v-parts-sign * buf_parts.fact-qnty
      946             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
      947                                       + v-parts-sign * buf_parts.fact-qnty
      948             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
      949                                       + v-parts-sign * buf_parts.cli-qnty
      950           .
      951           if buf_temp-parts.qnty = 0
      952           then do:
      953             delete buf_temp-parts .
      954           end.
      955         end.
      956       end.
      957       else do:
      958         assign
      959           p-total-parts-qnty = p-total-parts-qnty
      960                              + v-parts-sign * buf_doc-line.fact-qnty
      961         .
      962       end.
      963     end.
      964   end procedure.
      965   procedure partslib-init-temp-parts-by-date :
      966     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      967     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      968     define input parameter p-artic           like ub.parts.artic     no-undo .
      969     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      970     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      971     define input parameter p-fact-date       as date      no-undo .
      972     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
      973     do
      974     on error undo, return error
      975     :
      976       define variable v-fact-order                as decimal   no-undo .
      977       define variable v-shift-end-fact-order      as decimal   no-undo .
      978       define variable v-day-end-fact-order        as decimal   no-undo .
      979       run factord in this-procedure
      980         (input  p-fact-date
      981         ,input  1
      982         ,input  1
      983         ,input  ?
      984         ,input  0
      985         ,input  false
      986         ,output v-fact-order
      987         ,output v-shift-end-fact-order
      988         ,output v-day-end-fact-order
      989         ) no-error .
      990       if error-status :error
      991       then do:
      992         message
      993           vss-workfile vss-revision vss-description skip
      994           vss-include-info5 skip
      995           "Ошибка при определении момента времени, на который требуется остаток" skip
      996           "Объект" p-obj-type p-obj-code skip
      997           "Артикул" p-artic p-prod-type p-prod-code skip
      998           "Дата" p-fact-date skip
      999           view-as alert-box error .
     1000         undo, return error .
     1001       end.
     1002       run partslib-init-temp-parts-by-factord in this-procedure
     1003         (input p-obj-type
     1004         ,input p-obj-code
     1005         ,input p-artic
     1006         ,input p-prod-type
     1007         ,input p-prod-code
     1008         ,input v-day-end-fact-order
     1009         ,input false
     1010         ) no-error .
     1011       if error-status :error
     1012       then do:
     1013         message
     1014           vss-workfile vss-revision vss-description skip
     1015           vss-include-info5 skip
     1016           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1017           "Объект" p-obj-type p-obj-code skip
     1018           "Артикул" p-artic p-prod-type p-prod-code skip
     1019           "Дата" p-fact-date skip
     1020           view-as alert-box error .
     1021         undo, return error .
     1022       end.
     1023     end.
     1024   end procedure.
     1025   procedure partslib-calc-cost :
     1026     define output parameter p-fact-qnty      as decimal   no-undo .
     1027     define output parameter p-vat-pc         as decimal   no-undo .
     1028     define output parameter p-slt-pc         as decimal   no-undo .
     1029     define output parameter p-sum-base       as decimal   no-undo .
     1030     define output parameter p-sum-rubl       as decimal   no-undo .
     1031     define output parameter p-vat-base       as decimal   no-undo .
     1032     define output parameter p-vat-rubl       as decimal   no-undo .
     1033     define output parameter p-slt-base       as decimal   no-undo .
     1034     define output parameter p-slt-rubl       as decimal   no-undo .
     1035     define output parameter p-road-tax-base  as decimal   no-undo .
     1036     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1037     define output parameter p-transport-base as decimal   no-undo .
     1038     define output parameter p-transport-rubl as decimal   no-undo .
     1039     define output parameter p-other-base     as decimal   no-undo .
     1040     define output parameter p-other-rubl     as decimal   no-undo .
     1041     define output parameter p-excise-base    as decimal   no-undo .
     1042     define output parameter p-excise-rubl    as decimal   no-undo .
     1043     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1044     do
     1045     on error undo, return error return-value
     1046     :
     1047       define buffer buf_temp-parts for temp-parts .
     1048       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1049       define buffer   in-vatp-parts    for ub.parts   .
     1050       define buffer   in-vatp-doc      for ub.trn-doc .
     1051       define buffer   in-vatp-goods    for ub.goods   .
     1052       define buffer   in-vatp-sysconf  for ub.sysconf .
     1053       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1054       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1055       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1056       define variable varinvprb                  as   character              no-undo.
     1057       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1058       define variable cli-base-rate              as   decimal                no-undo.
     1059       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1060       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1061       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1062       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1063       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1064       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1065       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1066       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1067       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1068       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1069       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1070       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1071       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1072       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1073       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1074       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1075       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1076       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1077       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1078       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1079       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1080       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1081       define variable varinvatp-envd             as   character              no-undo.
     1082       define variable varinvatp-type             as   character              no-undo.
     1083       for each buf_temp-parts
     1084       on error undo, return error
     1085       :
     1086   assign
     1087     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1088     price-base-with-tax-loc = buf_temp-parts.price-base
     1089   .
     1090   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1091   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1092     (output varinvprb
     1093     )  .
     1094     if buf_temp-parts.out-code = 'free-zone':U     or
     1095        buf_temp-parts.out-code = 'out-zone':U   or
     1096        buf_temp-parts.doc-type = 'акт':U then do:
     1097       assign
     1098         in-vatp-have-vat-slt = yes.
     1099     end.
     1100     else do:
     1101       find first in-vatp_doc-attr no-lock
     1102         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1103           and in-vatp_doc-attr.attr-code = 'envd':U
     1104         no-error .
     1105       if not available in-vatp_doc-attr then do:
     1106         assign
     1107           in-vatp-have-vat-slt = yes.
     1108       end.
     1109       else do:
     1110            in-vatp-have-vat-slt = no.
     1111       end.
     1112     end.
     1113     assign
     1114      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1115      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1116     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1117              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1118     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1119             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1120             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1121             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1122             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1123             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1124             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1125       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1126     assign
     1127       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1128     assign
     1129       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1130       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1131       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1132       transport-cli-loc  = 0
     1133       other-cli-loc      = 0
     1134     .
     1135   ASSIGN
     1136             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1137       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1138   .
     1139         assign
     1140           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1141           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1142           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1143           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1144           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1145           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1146           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1147           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1148           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1149           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1150           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1151           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1152           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1153           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1154           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1155           p-excise-base    = p-excise-base    + 0
     1156           p-excise-rubl    = p-excise-rubl    + 0
     1157         .
     1158       end.
     1159       if p-fact-qnty      = ?
     1160       or p-sum-base       = ?
     1161       or p-sum-rubl       = ?
     1162       or p-vat-base       = ?
     1163       or p-vat-rubl       = ?
     1164       or p-slt-base       = ?
     1165       or p-slt-rubl       = ?
     1166       or p-road-tax-base  = ?
     1167       or p-road-tax-rubl  = ?
     1168       or p-transport-base = ?
     1169       or p-transport-rubl = ?
     1170       or p-other-base     = ?
     1171       or p-other-rubl     = ?
     1172       or p-excise-base    = ?
     1173       or p-excise-rubl    = ?
     1174       then do:
     1175         message
     1176           vss-workfile vss-revision vss-description skip
     1177           vss-include-info5 skip
     1178           "Программа in-vatp.i вернула неопределенные значения" skip
     1179           "p-fact-qnty"      p-fact-qnty      skip
     1180           "p-sum-base"       p-sum-base       skip
     1181           "p-sum-rubl"       p-sum-rubl       skip
     1182           "p-vat-base"       p-vat-base       skip
     1183           "p-vat-rubl"       p-vat-rubl       skip
     1184           "p-slt-base"       p-slt-base       skip
     1185           "p-slt-rubl"       p-slt-rubl       skip
     1186           "p-road-tax-base"  p-road-tax-base  skip
     1187           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1188           "p-transport-base" p-transport-base skip
     1189           "p-transport-rubl" p-transport-rubl skip
     1190           "p-other-base"     p-other-base     skip
     1191           "p-other-rubl"     p-other-rubl     skip
     1192           "p-excise-base"    p-excise-base    skip
     1193           "p-excise-rubl"    p-excise-rubl    skip
     1194           view-as alert-box error .
     1195         undo, return error .
     1196       end.
     1197     end.
     1198   end procedure.
     1199   define temp-table tt-utd like ub.utd
     1200     field stts        as character
     1201     field stts-edi    as character
