    12360            ? @ ub.fbr-recipe.recipe-code
    12361            ? @ ub.fbr-recipe.recipe-type
    12362            ? @ ub.fbr-recipe.recipe-name
    12363            ? @ ub.fbr-recipe.qnty
    12364            ? @ effect
    12365            with frame D-FBR-DOC.
