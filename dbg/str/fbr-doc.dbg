    12230               undo, return no-apply.
    12231            end.
    12232         end.
    12233         run ref/recips.w (
    12234            input parparentproc
    12235            , input ( if f-doc.status_ = 'новый':U then p-doc-mode else 'ПРОСМОТР':U )
    12236            , input buf_comp_fbr-line.doc-code
    12237            , input recid( buf_goods )
    12238            , input buf_recipe.recipe-type
    12239            , input buf_recipe.recipe-code
    12240            , output v-cancel
    12241            ).
    12242         if v-cancel = no
    12243            and p-doc-mode <> 'ПРОСМОТР':U
    12244            then
    12245         do:
    12246            run fbrlib_adjust-doc-lines in this-procedure (
    12247               input parparentproc
    12248               , input p-fbrhist-handle
    12249               , input buf_comp_fbr-line.doc-code
    12250               , input buf_recipe.recipe-code
    12251               , input v-price-sale-obj-type
    12252               , input v-price-sale-obj-code
    12253               ).
    12254         end.
    12255         apply "value-changed" to br-comp in frame D-FBR-DOC.
    12256         apply "value-changed" to br-ingr in frame D-FBR-DOC.
    12257      END.
    12258   ON ENTRY OF br-comp IN FRAME D-FBR-DOC
