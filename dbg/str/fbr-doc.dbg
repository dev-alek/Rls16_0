     1205     field orig-code   as character
     1206     field GrayZone    as logical
     1207     field obj-name    as character
     1208     field is-initial  as character
     1209     field scan-qnty   as decimal
     1210     field free-qnty   as decimal
     1211     .
     1212   define temp-table tt-sert-utd
     1213     field doc-id like ub.utd.doc-id
     1214     field db-num like ub.utd.db-num
     1215     field DocumentDate like ub.utd.DocumentDate
     1216     field DocumentNumber like ub.utd.DocumentNumber
     1217     field cli-code as integer
