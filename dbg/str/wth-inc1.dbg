        1   block-level on error undo, throw.
        2   define input parameter p-silent                       as logical no-undo .
        3   define input-output parameter par-rid as recid no-undo .
        4   define input parameter par-mode     as character no-undo .
        5   define input parameter pardoc-code  like ub.wth-doc.doc-code no-undo .
        6   define input parameter parhost-code like ub.wth-doc.host-code no-undo .
        7   define input parameter parobj-type  like ub.wth-doc.obj-type no-undo .
        8   define input parameter parobj-code  like ub.wth-doc.obj-code no-undo .
        9   define input parameter parcli-type  like ub.wth-doc.cli-type no-undo .
       10   define input parameter parcli-code  like ub.wth-doc.cli-code no-undo .
       11   define input parameter pardoc-date  like ub.wth-doc.doc-date no-undo .
       12   define input parameter parfact-date like ub.wth-doc.fact-date no-undo .
       13   define input parameter parshift-date like ub.wth-doc.shift-date no-undo .
       14   define input parameter parshift-num like ub.wth-doc.shift-num no-undo .
       15   define input parameter parshift-name like ub.wth-doc.shift-name no-undo .
       16   define input parameter par-operator like ub.wth-doc.operator no-undo .
       17   define input parameter par-deliver  like ub.wth-doc.deliver no-undo .
       18   define input parameter par-receiver like ub.wth-doc.receiver no-undo .
       19   define input parameter pardoc-type  like ub.wth-doc.doc-type no-undo .
       20   define input parameter parauto-fill like ub.wth-doc.auto-fill no-undo .
       21   define input parameter par-exter_   like ub.wth-doc.exter_ no-undo .
       22   define input parameter par-inter_   like ub.wth-doc.inter_ no-undo .
       23   define input parameter parsource-ref like ub.wth-doc.source-ref no-undo .
       24   define input parameter parsource-type like ub.wth-doc.source-type no-undo .
       25   define input parameter par-borned   like ub.wth-doc.borned no-undo .
       26   define input parameter pardoc-sum   like ub.wth-doc.doc-sum no-undo .
       27   define input parameter parfact-sum  like ub.wth-doc.fact-sum no-undo .
       28   define input parameter par-PS       like ub.wth-doc.PS no-undo .
       29   define input parameter par-status_  like ub.wth-doc.status_ no-undo .
       30   define input parameter parlines-exist as logical no-undo .
       31   define input parameter parext-type like ub.wth-doc.ext-doc-type no-undo .
       32   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       33   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       34   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       35   define variable vss-workfile    as character no-undo init "$Workfile: wth-inc1.p $":U .
       36   define variable vss-archive     as character no-undo init "$Archive: str/wth-inc1.p $":U .
       37   define variable vss-description as character no-undo init "Сохранение изменений в документе МЦ".
       38   procedure vss-get-info :
       39     define output parameter p-vss-revision    like vss-revision    no-undo .
       40     define output parameter p-vss-author      like vss-author      no-undo .
       41     define output parameter p-vss-date        like vss-date        no-undo .
       42     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       43     define output parameter p-vss-archive     like vss-archive     no-undo .
       44     define output parameter p-vss-description like vss-description no-undo .
       45     assign
       46       p-vss-revision    = vss-revision
       47       p-vss-author      = vss-author
       48       p-vss-date        = vss-date
       49       p-vss-workfile    = vss-workfile
       50       p-vss-archive     = vss-archive
       51       p-vss-description = vss-description
       52     .
       53   end procedure.
       54   procedure vss-get-parameters :
       55     define output parameter p-vss-parameters as character no-undo .
       56   end procedure.
       57   define new global shared variable g#vssrevis-logger as handle    no-undo .
       58   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       59   define variable v-vssrevis-logger                   as handle    no-undo .
       60   procedure vss-logevent :
       61     define input  parameter p-extra-paramters as character no-undo .
       62     define variable v-vssrevis-parameters as character no-undo .
       63     do
       64     on error undo, return error return-value
       65     :
       66       if  valid-handle(v-vssrevis-logger)
       67       and v-vssrevis-logger :get-signature("logevent") <> ""
       68       then do:
       69         run vss-get-parameters in this-procedure
       70           (output v-vssrevis-parameters
       71           ).
       72         run logevent in v-vssrevis-logger
       73           (input vss-workfile
       74           ,input vss-revision
       75           ,input v-vssrevis-parameters
       76           ,input p-extra-paramters
       77           ).
       78       end.
       79     end.
       80   end procedure.
       81   assign
       82     v-vssrevis-logger = g#vssrevis-logger
       83   .
       84   if  valid-handle(v-vssrevis-logger)
       85   and v-vssrevis-logger :get-signature("logevent") <> ""
       86   then do:
       87     assign
       88       v-vssrevis-logevent = true
       89     .
       90     run vss-logevent in this-procedure (input vss-description) .
       91   end.
       92   define new global shared variable g#language as character no-undo .
       93   if g#language <> '' and g#language <> 'rus':U then do:
       94     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       95   end.
       96   define new global shared variable g#library  as handle no-undo .
       97   define new global shared variable g#library2 as handle no-undo .
       98   define   shared variable g#auto as logical no-undo.
       99   define   shared variable g#news as logical no-undo.
      100   define   shared variable g#oxml as logical no-undo.
      101   define   shared variable g#esys as logical no-undo.
      102   define   shared variable g#news-source-db as integer no-undo.
      103   define   shared variable g#esys-source-esys as integer no-undo.
      104   define   shared variable g#db-num as integer   no-undo .
      105   define   shared variable g#userid as character no-undo .
      106   define   shared variable g#passwd as character no-undo .
      107   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      108   procedure cur-time :
      109      define output parameter p-today as date      no-undo .
      110      define output parameter p-time  as integer   no-undo .
      111     do
      112     on error undo, return error
      113     :
      114       define variable v-date1 as date      no-undo .
      115       define variable v-date2 as date      no-undo .
      116       define variable v-time  as integer   no-undo .
      117       assign
      118         v-date1 = today
      119         v-time  = time
      120         v-date2 = today
      121       .
      122       if v-date1 <> v-date2
      123       then do:
      124         assign
      125           v-date1 = today
      126           v-time  = v-time
      127         .
      128       end.
      129       assign
      130         p-today = v-date1
      131         p-time  = v-time
      132       .
      133     end.
      134   end.
      135   function cur-time-date returns character
      136   :
      137     return string(today, '99/99/9999':U) .
      138   end.
      139   function cur-time-mjd returns decimal
      140   :
      141     define variable v-date as date      no-undo .
      142     define variable v-time as integer   no-undo .
      143     run cur-time in this-procedure
      144       (output v-date
      145       ,output v-time
      146       ) .
      147     return integer(v-date) - 2400002 + (v-time / 86400) .
      148   end.
      149   function cur-time-get-ending-index returns integer
      150   (input p-number as integer
      151   )
      152   :
      153     if p-number < 0
      154     or p-number = ?
      155     then do:
      156       return 1 .
      157     end.
      158     define variable v-rest as integer   no-undo .
      159     assign
      160       p-number = p-number modulo 100
      161     .
      162     if p-number < 20
      163     then do:
      164       assign
      165         v-rest = p-number
      166       .
      167     end.
      168     else do:
      169       assign
      170         v-rest = p-number modulo 10
      171       .
      172     end.
      173     case v-rest :
      174       when 1
      175       then do:
      176         return 2 .
      177       end.
      178       when 2 or
      179       when 3 or
      180       when 4
      181       then do:
      182         return 3 .
      183       end.
      184       otherwise do:
      185         return 1 .
      186       end.
      187     end case .
      188   end.
      189   procedure cur-time-mjd-to-date :
      190      define input  parameter i-mjd-diff as decimal no-undo.
      191      define output parameter o-Date     as date    no-undo.
      192      define output parameter o-Time     as integer no-undo.
      193      define variable v-day-number as integer   no-undo .
      194      if    i-mjd-diff < 0
      195         or i-mjd-diff = ?
      196      then do:
      197         return "?" .
      198      end.
      199      assign
      200         v-day-number = truncate(i-mjd-diff,0).
      201         o-Date = date(v-day-number + 2400002).
      202         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      203     .
      204   end.
      205   function cur-time-mjd-to-string returns character
      206   (input p-mjd-diff as decimal
      207   )
      208   :
      209     define variable v-day-number as integer   no-undo .
      210     define variable v-seconds    as integer   no-undo .
      211     define variable v-hour       as integer   no-undo .
      212     define variable v-min        as integer   no-undo .
      213     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      214     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      215     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      216     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      217     if p-mjd-diff < 0
      218     or p-mjd-diff = ?
      219     then do:
      220       return "?" .
      221     end.
      222     assign
      223       v-day-number = integer(truncate(p-mjd-diff,0))
      224       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      225     .
      226     if v-seconds > 86400
      227     then do:
      228       assign
      229         v-seconds = 86400 - 1
      230       .
      231     end.
      232     if v-seconds < 0
      233     then do:
      234       assign
      235         v-seconds = 0
      236       .
      237     end.
      238     assign
      239       v-hour = truncate(v-seconds / 3600, 0)
      240     .
      241     assign
      242       v-seconds = v-seconds modulo 3600
      243     .
      244     assign
      245       v-min = truncate(v-seconds / 60, 0)
      246     .
      247     assign
      248       v-seconds = v-seconds modulo 60
      249     .
      250     return
      251         (if v-day-number <> 0
      252           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      253           else ""
      254         )
      255       + (if v-day-number <> 0 or v-hour <> 0
      256           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      257           else ""
      258         )
      259       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      260           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      261           else ""
      262         )
      263       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      264       .
      265   end.
      266   function cur-time-string returns character
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      275   end.
      276   function cur-time-string-sec returns character
      277   :
      278     define variable v-date as date      no-undo .
      279     define variable v-time as integer   no-undo .
      280     run cur-time in this-procedure
      281       (output v-date
      282       ,output v-time
      283       ) .
      284     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      285   end.
      286   function cur-time-custom  returns character
      287   (input p-prefix as character
      288   ,input p-date-format as character
      289   ,input p-delimiter as character
      290   ,input p-time-format as character
      291   ,input p-suffix as character
      292   )
      293   :
      294     define variable v-date as date      no-undo .
      295     define variable v-time as integer   no-undo .
      296     run cur-time in this-procedure
      297       (output v-date
      298       ,output v-time
      299       ) .
      300     return
      301       p-prefix
      302       + string(v-date, p-date-format)
      303       + p-delimiter
      304       + string(v-time, p-time-format)
      305       + p-suffix
      306       .
      307   end.
      308   function cur-time-print  returns character
      309   :
      310     define variable v-date as date      no-undo .
      311     define variable v-time as integer   no-undo .
      312     run cur-time in this-procedure
      313       (output v-date
      314       ,output v-time
      315       ) .
      316     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      317   end.
      318   function cur-time-datetime returns datetime
      319   :
      320     define variable v-char as character no-undo .
      321     define variable v-datetime as datetime no-undo .
      322     v-char = cur-time-string().
      323     v-datetime = datetime(v-char).
      324     return  v-datetime.
      325   end.
      326   function cur-time-string-msec returns character
      327   :
      328     define variable v-date as datetime  no-undo .
      329     v-date = now.
      330     return string(v-date) .
      331   end.
      332   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      333   define temp-table tt-wth-doc no-undo like ub.wth-doc.
      334   procedure wth-doch_write-wth-doc-history :
      335   define parameter buffer buf_wth-doc for tt-wth-doc.
      336   define input parameter p-doc-code  like ub.wth-doc.doc-code no-undo .
      337   define input parameter p-host-code like ub.wth-doc.host-code no-undo .
      338   define input parameter p-obj-type  like ub.wth-doc.obj-type no-undo .
      339   define input parameter p-obj-code  like ub.wth-doc.obj-code no-undo .
      340   define variable v-date as date no-undo .
      341   define variable v-time as integer no-undo .
      342   define variable v-message as character no-undo .
      343   define variable varobj-date as date no-undo .
      344   define variable varshift-date as date no-undo .
      345   define variable varshift-num as integer no-undo .
      346   define variable varshift-name as character no-undo.
      347   define variable l-shift-on as logical no-undo .
      348   define variable v-create-hist as logical no-undo .
      349   define variable v-result as character no-undo .
      350   define buffer buf_c-wth-doc for ub.c-wth-doc.
      351   define buffer buf_c-wth-line for ub.c-wth-line.
      352   define buffer buf_c-wth-dtl for ub.c-wth-dtl.
      353   define buffer prev_c-wth-line for ub.c-wth-line.
      354   define buffer prev_c-wth-dtl for ub.c-wth-dtl.
      355   do
      356   on error undo, return error return-value
      357   :
      358     run cur-time in this-procedure(output v-date, output v-time).
      359   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      360   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      361     (input  p-obj-type
      362     ,input  p-obj-code
      363     ,output varobj-date
      364     ) no-error .
      365     if error-status :error
      366     or varobj-date = ?
      367     then do:
      368      v-message = substitute("Нет текущей даты на объекте документа МЦ &1 &2&3&4&5 &6"
      369                   , buf_wth-doc.doc-code
      370                   , p-obj-type
      371                   , p-obj-code
      372                   , chr(10)
      373                   , error-status:get-message(1)
      374                   , return-value
      375                   ).
      376       undo, return error v-message.
      377     end.
      378   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      379   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      380     (input  p-obj-type
      381     ,input  p-obj-code
      382     ,input  'shift-on=request'
      383     ,output l-shift-on
      384     )  .
      385     if l-shift-on then do:
      386   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      387   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
      388     (input  p-obj-type
      389     ,input  p-obj-code
      390     ,output varshift-date
      391     ,output varshift-num
      392     ,output varshift-name
      393     ) no-error .
      394     end.
      395     else do:
      396       assign
      397         varshift-date = ?
      398         varshift-num  = ?
      399         varshift-name = ?
      400       .
      401     end.
      402     create buf_c-wth-doc.
      403     buffer-copy buf_wth-doc to buf_c-wth-doc
      404     assign
      405     buf_c-wth-doc.doc-code           = p-doc-code
      406     buf_c-wth-doc.obj-type           = p-obj-type
      407     buf_c-wth-doc.obj-code           = p-obj-code
      408     buf_c-wth-doc.host-code          = p-host-code
      409     buf_c-wth-doc.chip-num           = next-value (s-corr-chip, ub)
      410     buf_c-wth-doc.corr-time          = v-time
      411     buf_c-wth-doc.corr-user-db-num   = g#db-num
      412     buf_c-wth-doc.corr-user-name     = g#userid
      413     buf_c-wth-doc.corr-date          = varobj-date
      414     buf_c-wth-doc.corr-inkas-code    = "":U
      415     buf_c-wth-doc.corr-shift-date    = varshift-date
      416     buf_c-wth-doc.corr-shift-num     = varshift-num
      417     buf_c-wth-doc.corr-shift-name    = varshift-name
      418     buf_c-wth-doc.real-corr-date     = v-date
      419     .
      420     for each ub.wth-line where
      421             ub.wth-line.doc-code = buf_wth-doc.doc-code:
      422       create buf_c-wth-line.
      423       buffer-copy ub.wth-line to buf_c-wth-line
      424       assign
      425       buf_c-wth-line.chip-num           = buf_c-wth-doc.chip-num
      426       buf_c-wth-line.corr-user-db-num   = buf_c-wth-doc.corr-user-db-num
      427       .
      428     end.
      429     for each ub.wth-dtl where
      430             ub.wth-dtl.doc-code = buf_wth-doc.doc-code:
      431       create buf_c-wth-dtl.
      432       buffer-copy ub.wth-dtl to buf_c-wth-dtl
      433       assign
      434       buf_c-wth-dtl.chip-num           = buf_c-wth-doc.chip-num
      435       buf_c-wth-dtl.corr-user-db-num   = buf_c-wth-doc.corr-user-db-num
      436       .
      437     end.
      438       release buf_c-wth-doc.
      439   end.
      440   end procedure.
      441   DEFINE VARIABLE loc#log as logical no-undo .
      442   define variable v-mes     as character no-undo .
      443   define variable v-file    as logical no-undo .
      444   DEFINE VARIABLE var-entry as character no-undo .
      445   DEFINE VARIABLE l-shift-on as logical no-undo .
      446   DEFINE VARIABLE f-date     AS DATE NO-UNDO.
      447   DEFINE VARIABLE f-time     AS INT  NO-UNDO.
      448   DEFINE VARIABLE s-date     AS DATE NO-UNDO.
      449   DEFINE VARIABLE s-num      AS INT  NO-UNDO.
      450   DEFINE VARIABLE s-name     AS CHAR NO-UNDO.
      451   DEFINE VARIABLE varcli-name like ub.clients.obj-name no-undo .
      452   define buffer buf_c-wth-doc for ub.c-wth-doc.
      453   _main:
      454   do
      455   on error undo, return error
      456   :
      457   if NOT (par-mode = 'ДОБАВЛЕНИЕ':U OR par-mode = 'ИЗМЕНЕНИЕ':U) then do:
      458     message
      459     vss-workfile vss-revision vss-description skip
      460     "Неверный параметр вызова par-mode" par-mode
      461     view-as alert-box ERROR.
      462     return error '':U.
      463   end.
      464   if par-status_ = 'факт':U then do:
      465     message
      466     vss-workfile vss-revision vss-description skip
      467     "Неверный параметр вызова par-status_" par-status_
      468     view-as alert-box ERROR.
      469     return error '':U.
      470   end.
      471   if can-find(FIRST ub.wth-doc where
      472                     ub.wth-doc.doc-code = pardoc-code and
      473                    recid(wth-doc) <> par-rid) then do:
      474     message
      475     vss-workfile vss-revision vss-description skip
      476     "Неверный параметр вызова par-rid" par-rid skip
      477     " и/или pardoc-code " pardoc-code
      478     view-as alert-box ERROR.
      479     return error '':U.
      480   end.
      481   if LOOKUP( parext-type,'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u) = 0 then do:
      482     message
      483     vss-workfile vss-revision vss-description skip
      484     "Неверный параметр вызова parext-type" parext-type
      485     view-as alert-box ERROR.
      486     return error '':U.
      487   end.
      488   if par-mode = 'ДОБАВЛЕНИЕ':U then do:
      489     if parsource-type <> 'касса':U then do:
      490       run gbl/factdate.p (
      491                        INPUT        parobj-type
      492                       ,INPUT        parobj-code
      493                       ,INPUT-OUTPUT f-date
      494                       ,INPUT-OUTPUT f-time
      495                       ,INPUT-OUTPUT s-date
      496                       ,INPUT-OUTPUT s-num
      497                       ,INPUT-OUTPUT s-name
      498                       ,INPUT        (not p-silent)
      499                         ) NO-ERROR.
      500       IF ERROR-STATUS:ERROR THEN DO:
      501         undo _main, return error return-value .
      502       END.
      503     end.
      504   end.
      505   run trg/wth-inc2.p (
      506                    input p-silent
      507                   ,input pardoc-code
      508                   ,input parhost-code
      509                   ,input parobj-type
      510                   ,input parobj-code
      511                   ,input parcli-type
      512                   ,input parcli-code
      513                   ,input par-operator
      514                   ,input par-deliver
      515                   ,input par-receiver
      516                   ,input pardoc-type
      517                   ,input parauto-fill
      518                   ,input par-exter_
      519                   ,input par-inter_
      520                   ,input parsource-ref
      521                   ,input parsource-type
      522                   ,input par-borned
      523                   ,input parlines-exist
      524                   ,input parext-type
      525                   ,output varcli-name) no-error.
      526   if error-status:error then do:
      527     undo _main, return error return-value.
      528   end.
      529   if par-mode = 'ДОБАВЛЕНИЕ':U then do:
      530     if pardoc-code = "":U then do:
      531   define variable l-in-ov5 as logical no-undo .
      532   define variable v-date5 as date no-undo .
      533   define variable v-time5 as integer no-undo .
      534   run cur-time in this-procedure(output v-date5, output v-time5).
      535   CREATE ub.wth-doc.
      536   ASSIGN
      537     ub.wth-doc.host-code = parhost-code
      538     ub.wth-doc.doc-code  = TRIM( STRING( NEXT-VALUE( s-wth-doc, ub), ">>>>>>>>>9":U ) ) + "-" + TRIM( STRING( parobj-code, ">>>>>>>>9":U ) ) +                   SUBSTR( parobj-type, ( IF g#language = "RUS" THEN 1 ELSE 2 ), 1 )
      539      ub.wth-doc.doc-type  = pardoc-type
      540     ub.wth-doc.ext-doc-type  = parext-type
      541     ub.wth-doc.inter_    = if  lookup(ub.wth-doc.ext-doc-type,'ij,pj,fj,jj,oj,ej':U) > 0 then yes else no
      542     ub.wth-doc.exter_    = if  lookup(ub.wth-doc.ext-doc-type,'ie,ee,we,pc,ps,iy,pz,df,dp,dc,xc':U) > 0 then yes else no
      543     ub.wth-doc.status_   = 'накл':U
      544     ub.wth-doc.obj-type  = parobj-type
      545     ub.wth-doc.obj-code  = parobj-code
      546     ub.wth-doc.creid     = g#userid
      547     ub.wth-doc.credate   = v-date5
      548   .
      549   if ub.wth-doc.doc-type = 'инв':U or lookup(ub.wth-doc.ext-doc-type, 'we,dc,dp,df':U) > 0
      550      or ub.wth-doc.doc-type = 'декл':U then do:
      551     assign
      552       ub.wth-doc.cli-type  = 'орг':U
      553       ub.wth-doc.cli-code  = parhost-code
      554       .
      555   end.
      556   else if ub.wth-doc.ext-doc-type = 'ps':U then do:
      557     assign
      558     ub.wth-doc.cli-type  = parobj-type
      559     ub.wth-doc.cli-code  = parobj-code
      560     .
      561   end.
      562   else if ub.wth-doc.inter_  = yes
      563   then do:
      564     assign
      565     ub.wth-doc.cli-type  = parobj-type
      566     ub.wth-doc.cli-code  = parobj-code
      567     .
      568   end.
      569   else if ub.wth-doc.exter_  = yes
      570   then do:
      571     assign
      572     ub.wth-doc.cli-type  =  (if parcli-type <> "" then parcli-type else 'орг':U)
      573     ub.wth-doc.cli-code  =  (if parcli-code <> 0 then parcli-code else 0)
      574     .
      575   end.
      576   else assign
      577       ub.wth-doc.cli-type  = parobj-type
      578       ub.wth-doc.cli-code  = 0
      579   .
      580     end.
      581     else do:
      582   define variable l-in-ov6 as logical no-undo .
      583   define variable v-date6 as date no-undo .
      584   define variable v-time6 as integer no-undo .
      585   run cur-time in this-procedure(output v-date6, output v-time6).
      586   CREATE ub.wth-doc.
      587   ASSIGN
      588     ub.wth-doc.host-code = parhost-code
      589     ub.wth-doc.doc-code  = pardoc-code
      590      ub.wth-doc.doc-type  = pardoc-type
      591     ub.wth-doc.ext-doc-type  = parext-type
      592     ub.wth-doc.inter_    = if  lookup(ub.wth-doc.ext-doc-type,'ij,pj,fj,jj,oj,ej':U) > 0 then yes else no
      593     ub.wth-doc.exter_    = if  lookup(ub.wth-doc.ext-doc-type,'ie,ee,we,pc,ps,iy,pz,df,dp,dc,xc':U) > 0 then yes else no
      594     ub.wth-doc.status_   = 'накл':U
      595     ub.wth-doc.obj-type  = parobj-type
      596     ub.wth-doc.obj-code  = parobj-code
      597     ub.wth-doc.creid     = g#userid
      598     ub.wth-doc.credate   = v-date6
      599   .
      600   if ub.wth-doc.doc-type = 'инв':U or lookup(ub.wth-doc.ext-doc-type, 'we,dc,dp,df':U) > 0
      601      or ub.wth-doc.doc-type = 'декл':U then do:
      602     assign
      603       ub.wth-doc.cli-type  = 'орг':U
      604       ub.wth-doc.cli-code  = parhost-code
      605       .
      606   end.
      607   else if ub.wth-doc.ext-doc-type = 'ps':U then do:
      608     assign
      609     ub.wth-doc.cli-type  = parobj-type
      610     ub.wth-doc.cli-code  = parobj-code
      611     .
      612   end.
      613   else if ub.wth-doc.inter_  = yes
      614   then do:
      615     assign
      616     ub.wth-doc.cli-type  = parobj-type
      617     ub.wth-doc.cli-code  = parobj-code
      618     .
      619   end.
      620   else if ub.wth-doc.exter_  = yes
      621   then do:
      622     assign
      623     ub.wth-doc.cli-type  =  (if parcli-type <> "" then parcli-type else 'орг':U)
      624     ub.wth-doc.cli-code  =  (if parcli-code <> 0 then parcli-code else 0)
      625     .
      626   end.
      627   else assign
      628       ub.wth-doc.cli-type  = parobj-type
      629       ub.wth-doc.cli-code  = 0
      630   .
      631     end.
      632     assign par-rid = recid(ub.wth-doc).
      633   end.
      634   else do:
      635     FIND FIRST ub.wth-doc EXCLUSIVE-LOCK WHERE
      636               recid(ub.wth-doc) = par-rid NO-WAIT No-ERROR.
      637     if locked ub.wth-doc then do:
      638       v-mes = substitute( "Документ занят"
      639                           ).
      640       run err-mess(input-output v-mes).
      641       var-entry = "":U.
      642       undo _main, return error (if p-silent then v-mes else var-entry).
      643     end.
      644     if not avail ub.wth-doc then do:
      645       v-mes = substitute( "Не найден документ МЦ"
      646                           ).
      647       run err-mess(input-output v-mes).
      648       var-entry = "":U.
      649       undo _main, return error (if p-silent then v-mes else var-entry).
      650     end.
      651     if ub.wth-doc.status_ <> par-status_ then do:
      652       v-mes = substitute( "Неверный вызов - с изменением статуса документа МЦ с &1 на &2"
      653                           ,ub.wth-doc.status_
      654                           , par-status_
      655                           ).
      656       run err-mess(input-output v-mes).
      657       var-entry = "":U.
      658       undo _main, return error (if p-silent then v-mes else var-entry).
      659     end.
      660     if ub.wth-doc.auto-fill <> parauto-fill then do:
      661       v-mes = substitute( "Неверный вызов - с изменением типа заполнения документа МЦ"
      662                           ).
      663       run err-mess(input-output v-mes).
      664       var-entry = "":U.
      665       undo _main, return error (if p-silent then v-mes else var-entry).
      666     end.
      667     if ub.wth-doc.ext-doc-type <> parext-type then do:
      668       v-mes = substitute( "Неверный вызов - с изменением расширенного типа документа МЦ"
      669                           ).
      670       run err-mess(input-output v-mes).
      671       var-entry = "":U.
      672       undo _main, return error (if p-silent then v-mes else var-entry).
      673     end.
      674     if ub.wth-doc.status_ <> 'накл':U then dO:
      675       if ub.wth-doc.doc-code <> pardoc-code OR
      676          ub.wth-doc.host-code <> parhost-code OR
      677          ub.wth-doc.obj-type <> parobj-type OR
      678          ub.wth-doc.obj-code <> parobj-code OR
      679          ub.wth-doc.cli-type <> parcli-type OR
      680          ub.wth-doc.cli-code <> parcli-code OR
      681          ub.wth-doc.doc-date <> pardoc-date OR
      682          ub.wth-doc.shift-date <> parshift-date OR
      683          ub.wth-doc.shift-num <> parshift-num OR
      684          ub.wth-doc.shift-name <> parshift-name OR
      685          ub.wth-doc.operator <> par-operator OR
      686          ub.wth-doc.deliver <> par-deliver OR
      687          ub.wth-doc.receiver <> par-receiver OR
      688          ub.wth-doc.doc-type <> pardoc-type OR
      689          ub.wth-doc.exter_ <> par-exter_ OR
      690          ub.wth-doc.inter_ <> par-inter_ OR
      691          ub.wth-doc.ext-doc-type <> parext-type  OR
      692          ub.wth-doc.doc-sum <> pardoc-sum then do:
      693         v-mes = substitute( "Документ МЦ имеет статус &1 возможно изменить только сумму факт и примечание"
      694                           , ub.wth-doc.status_
      695                             ).
      696         run err-mess(input-output v-mes).
      697         var-entry = "":U.
      698         undo _main, return error (if p-silent then v-mes else var-entry).
      699       end.
      700     end.
      701     create tt-wth-doc.
      702     buffer-copy ub.wth-doc to tt-wth-doc.
      703   end.
      704   assign
      705   ub.wth-doc.cli-name =  varcli-name
      706   ub.wth-doc.doc-code = (if par-mode = 'ДОБАВЛЕНИЕ':U then ub.wth-doc.doc-code else pardoc-code)
      707   ub.wth-doc.host-code = parhost-code
      708   ub.wth-doc.obj-type = parobj-type
      709   ub.wth-doc.obj-code = parobj-code
      710   ub.wth-doc.cli-type = parcli-type
      711   ub.wth-doc.cli-code = parcli-code
      712   ub.wth-doc.doc-date = pardoc-date
      713   ub.wth-doc.fact-date = parfact-date
      714   ub.wth-doc.shift-date = parshift-date
      715   ub.wth-doc.shift-num = parshift-num
      716   ub.wth-doc.shift-name = parshift-name
      717   ub.wth-doc.operator = par-operator
      718   ub.wth-doc.deliver = par-deliver
      719   ub.wth-doc.receiver = par-receiver
      720   ub.wth-doc.doc-type = pardoc-type
      721   ub.wth-doc.auto-fill = parauto-fill
      722   ub.wth-doc.exter_ = par-exter_
      723   ub.wth-doc.inter_ = par-inter_
      724   ub.wth-doc.doc-sum = pardoc-sum
      725   ub.wth-doc.fact-sum = parfact-sum
      726   ub.wth-doc.PS = par-PS
      727   ub.wth-doc.status_ = par-status_
      728   ub.wth-doc.source-ref = parsource-ref
      729   ub.wth-doc.source-type = parsource-type
      730   ub.wth-doc.borned = par-borned
      731   ub.wth-doc.ext-doc-type = parext-type
      732   .
      733   release ub.wth-doc no-error .
      734   if error-status:error then do:
      735       v-mes = substitute("Ошибка при сохранении документа&1&2 &3", chr(10), error-status:get-message(1), return-value ).
      736       run err-mess(input-output v-mes).
      737       var-entry = "":U.
      738       undo _main, return error (if p-silent then v-mes else var-entry).
      739   end.
      740   find last buf_c-wth-doc no-lock where
      741             buf_c-wth-doc.doc-code = pardoc-code
      742         AND  buf_c-wth-doc.corr-user-db-num = g#db-num no-error.
      743   if (not par-mode = 'ДОБАВЛЕНИЕ':U and tt-wth-doc.creid <> g#userid
      744   and not available buf_c-wth-doc)
      745   or (available buf_c-wth-doc
      746   and buf_c-wth-doc.corr-user-name <> g#userid)
      747   then do:
      748     run wth-doch_write-wth-doc-history in this-procedure (
      749                                                             buffer tt-wth-doc
      750                                                             ,input pardoc-code
      751                                                             ,input parhost-code
      752                                                             ,input parobj-type
      753                                                             ,input parobj-code) no-error .
      754     if error-status:error then do:
      755         v-mes = error-status:get-message(1) .
      756         run err-mess(input-output v-mes).
      757         undo _main, return error v-mes.
      758     end.
      759   end.
      760   return '':U.
      761   end.
      762   PROCEDURE err-mess:
      763     DEFINE INPUT-output PARAMETER p-mes as character No-UNDO.
      764     p-mes = substitute("Документ МЦ №&1: &2&3&4&5", pardoc-code, parobj-type, parobj-code, chr(10), p-mes).
      765     if not p-silent then
      766     message
      767     p-mes
      768     view-as alert-box error .
      769   END PROCEDURE.
