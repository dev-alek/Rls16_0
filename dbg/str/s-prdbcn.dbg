     8988           view-as alert-box error.
     8989           return error.
     8990       END.
     8991     END CASE.
     8992     if varcont70 = yes then do:
     8993       if integer( substring( tmp-str70, 1, length( ncrsc-pfx ) ) ) <> 0
     8994       then do:
     8995         message
     8996           "Невозможно сформировать бар-код" SKIP
     8997           "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U)
     8998           view-as alert-box error title "подрезание кода".
     8999         return error.
     9000       end.
     9001       else do:
     9002         assign
     9003           IBm-good-code = ncrsc-pfx + substring( tmp-str70, length( ncrsc-pfx ) + 1, length( tmp-str70 ) - length( ncrsc-pfx ) )
     9004           len-code70    = length( IBm-good-code )
     9005         .
     9006         define variable v-sum-char70 as character no-undo .
     9007         assign
     9008           sum70 = 0
     9009         .
     9010         do i70 = 1 to len-code70 by 2
     9011         :
     9012           assign
     9013             v-sum-char70 = substr(IBm-good-code, len-code70 - i70 + 1, 1)
     9014           .
     9015           if v-sum-char70 < "0"
     9016           or v-sum-char70 > "9"
     9017           then do:
     9018             message
     9019               "Невозможно сформировать бар-код" skip
     9020               "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
     9021               view-as alert-box error title "подсчет контрольной суммы".
     9022             return error.
     9023           end.
     9024           assign
     9025             sum70 = sum70 + integer(v-sum-char70)
     9026           .
     9027         end.
     9028         if varcont70 = yes then do:
     9029           assign
     9030             sum70 = sum70 * 3
     9031           .
     9032           do i70 = 2 to len-code70 by 2
     9033           :
     9034             assign
     9035               v-sum-char70 = substr(IBm-good-code, len-code70 - i70 + 1, 1)
     9036             .
     9037             if v-sum-char70 < "0"
     9038             or v-sum-char70 > "9"
     9039             then do:
