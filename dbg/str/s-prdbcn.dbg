    12885                                     , input out
    12886                                     , input fname
    12887                                     , input yes
    12888                                     , input v-fields-shift106
    12889                                     , input yes
    12890                                     , input 24
    12891                                     , input 1
    12892                                     , input string(1)
    12893                                     , input v-record
    12894                                       ).
    12895      end.
    12896   find first temp-tekka-tsk no-error.
    12897   if available temp-tekka-tsk then do:
    12898      v-found106 = yes.
    12899   end.
    12900   if v-found106 = yes then do:
    12901   output stream IBmSTREAM to VALUE(out + fname + '.tsk').
    12902   v-is-script106 = no.
    12903   for each temp-tekka-tsk:
    12904     if (temp-tekka-tsk.num-rec > 0
    12905     or temp-tekka-tsk.send-get = 'task')
    12906     and temp-tekka-tsk.task-num = fname then do:
    12907       export stream IBmSTREAM temp-tekka-tsk.
    12908       v-found106 = yes.
    12909     end.
    12910     if temp-tekka-tsk.is-script then do:
    12911       v-is-script106 = yes.
    12912     end.
    12913     delete temp-tekka-tsk.
    12914   end.
    12915   output stream IBMStream
    12916   close.
    12917   run write-log-and-file in p-log-handle (
    12918         input 1
    12919       , input log-file-name
