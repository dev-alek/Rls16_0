    12847                                               then 20
    12848                                               else 21)
    12849                                       , input (if integer(v-plu) <= v-20-part1
    12850                                               then 2621
    12851                                               else 2379)
    12852                                       , input v-plu
    12853                                       , input (if v-marketer-action = 'U':U
    12854                                                 then string(convert-maria-tax-code(cash-gds.vat-code, 0  , cdtaxlst), "X(8)")
    12855                                                 else '00000000':U) + chr(4) + chk_name).
    12856         run maria-put in this-procedure (
