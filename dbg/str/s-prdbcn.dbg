    11108                                           string( ( cash-gds.price-sale * 100 ) ,'99999999').
    11109                     put unformatted '0000000000000000000000000000000'
    11110                     string(action, "X(1)") '0000000000000'.
    11111                     put skip.
    11112                 end.
    11113                 if ((ub.shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
