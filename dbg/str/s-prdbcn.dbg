    12945         , input 1
    12946         , input substitute( "!!!Прерван обмен информацией с кассой &1,&2&3&2на кассе осталась устаревшая информация"
    12947                              ,for-cash-desk.cash-num
    12948                              ,chr(10)
    12949                              ,return-value
    12950                           )
    12951                                           ).
    12952     assign
    12953     v-view-log = yes
    12954     .
    12955       for each temp-cd-plu:
    12956         delete temp-cd-plu.
    12957       end.
    12958     return "error":U.
    12959   end.
    12960   else do:
    12961     for each temp-cd-plu,
    12962         first buf_cd-plu where
    12963                     buf_cd-plu.obj-type = temp-cd-plu.obj-type
    12964                 and buf_cd-plu.obj-code = temp-cd-plu.obj-code
    12965                 and buf_cd-plu.pos-type = temp-cd-plu.pos-type
    12966                 and buf_cd-plu.plu-type = temp-cd-plu.plu-type
    12967                 and buf_cd-plu.plu-code = temp-cd-plu.plu-code:
    12968       if temp-cd-plu.to-del = yes
    12969       and v-del-mrkt-gds
    12970       then do:
    12971         if lookup(string(for-cash-desk.cash-num), buf_cd-plu.charkey_one) > 0 then do:
    12972           entry(lookup(string(for-cash-desk.cash-num), buf_cd-plu.charkey_one)  ,  buf_cd-plu.charkey_one) = '':U.
    12973           assign
    12974           buf_cd-plu.charkey_one = replace(buf_cd-plu.charkey_one, chr(44) + chr(44), chr(44))
    12975           buf_cd-plu.to-del = (buf_cd-plu.charkey_one <> '':U)
    12976           .
    12977         end.
    12978         if buf_cd-plu.charkey_one = '':U then do:
    12979           delete buf_cd-plu.
    12980           NEXT.
    12981         end.
    12982       end.
    12983       if temp-cd-plu.charkey_two = "":U
    12984       then
    12985       assign
    12986       buf_cd-plu.charkey_two = "":U
    12987       buf_cd-plu.to-send = no
    12988       .
    12989       delete temp-cd-plu.
    12990     end.
    12991   end.
    12992   end.
