    13202   define variable vss-include-info113 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13203   run adm/shattri.p (
    13204           input "get":U
    13205           ,input  'маг':U
    13206           ,input  ub.cash-desk.obj-code
    13207           ,input  'cd-type-ipc-servispl':U
    13208           ,input  'ipcsdobc':U
    13209           ,output v-value-character
    13210           ,output v-value-date
    13211           ,output v-value-decimal
    13212           ,output v-value-integer
    13213           ,output v-value-logical
    13214           ,output v-param-type
    13215           ,INPUT-OUTPUT table-handle v-tth
    13216           ) no-error .
    13217     IF not error-status:error
    13218     then dob-curr = v-value-character.
    13219     else do:
    13220       return error substitute("Ошибки при проверке параметра КОДЫ ДОПОЛН ВАЛЮТ ДЛЯ КАССЫ &1 для &2&3"
    13221                                 , 'IPC-Servis+':U
    13222                                 , 'маг':U
    13223                                 , abs(i-obj-code)).
    13224     end.
    13225     if index(dob-curr, ";":U) > 0  and can-do(entry(2,dob-curr,";"),string(i-obj-code)) then do:
    13226       FIND LAST ub.curr-shop WHERE ub.curr-shop.obj-code = i-obj-code
    13227                               and ub.curr-shop.obj-type = 'маг':U
    13228                               and ub.curr-shop.curr-code = int(entry(1,dob-curr,";"))
    13229                               use-index pi NO-ERROR.
    13230       if available ub.curr-shop then curr_cass = ub.curr-shop.exch-rate / curr-shop.exch-scale.
    13231       else do:
    13232         if not g#news then do:
    13233           return error
    13234           substitute("Не найден курс дополнительной валюты &1 в &2&3", entry(1,dob-curr,";"), 'маг':U, i-obj-code).
    13235         end.
    13236       end.
    13237     end.
    13238     end.
    13239     when  'pricecheck-Servis+':U then do:
