     6297   define buffer buf_turnover-buyer-main    for ub.turnover-buyer-main  .
     6298   define buffer buf1_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     6299   define buffer buf2_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     6300   define buffer buf_price-all              for ub.price-all  .
     6301   define buffer buf_goods                  for ub.goods      .
     6302   define buffer buf_global-state           for ub.global-state  .
     6303   define buffer buf_buyer-group            for ub.buyer-group  .
     6304   define buffer buf_turnover-group         for ub.turnover-group  .
     6305   define buffer buf_main-code              for ub.bar-code  .
     6306   define buffer buf_bar-code               for ub.bar-code  .
     6307   define buffer buf_pay-type               for ub.pay-type  .
     6308   define buffer buf_cash-pay               for ub.cash-pay  .
     6309   define variable to-day          as date      no-undo .
     6310   define variable v-base-rate0    as decimal   no-undo .
     6311   define variable v-base-scale0   as decimal   no-undo .
     6312   define variable v-exch-rate0    as decimal   no-undo .
     6313   define variable v-exch-scale0   as decimal   no-undo .
     6314   define variable v-base-rate     as decimal   no-undo .
     6315   define variable v-base-scale    as decimal   no-undo .
     6316   define variable v-exch-rate     as decimal   no-undo .
     6317   define variable v-exch-scale    as decimal   no-undo .
     6318   define variable v-host-code     as integer   no-undo .
     6319   define variable v-curr-abbr     as character no-undo .
     6320   define variable v-grp-name      as character no-undo .
     6321   define variable v-date-1        as date      no-undo .
     6322   define variable v-date-2        as date      no-undo .
     6323   define variable v-interv        as character no-undo .
     6324   define variable v-pay-name      as character no-undo .
     6325   define variable v-cli-oborot    as decimal   no-undo .
     6326   define variable v-trn-pay-code  as integer   no-undo .
     6327   define variable v-cash-pay-curr as integer   no-undo .
     6328   define variable v-cash-pay-code as integer   no-undo .
     6329   do
     6330   on error undo, return error return-value
     6331   :
     6332   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     6333   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     6334   if p-fact-order = ? then do:
     6335     run fact-order-mpl (
     6336         input   today       ,
     6337         input   p-obj-type  ,
     6338         input   p-obj-code  ,
     6339         output  p-fact-order ).
     6340   end.
     6341   if p-vid-pay <> "" then do:
     6342      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     6343      if available buf_pay-type
     6344         then v-trn-pay-code = buf_pay-type.obj-code.
     6345         else v-trn-pay-code =  0.
     6346   end.
     6347   else v-trn-pay-code = 0 .
     6348   if p-cash-pay-type <> "" then do:
     6349      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     6350      if available buf_pay-type
     6351         then
     6352           assign
     6353             v-cash-pay-curr = buf_cash-pay.curr-code
     6354             v-cash-pay-code = buf_cash-pay.cdpay-code
     6355           .
     6356         else
     6357           assign
     6358             v-cash-pay-curr = 0
     6359             v-cash-pay-code = 0
     6360             .
     6361   end.
     6362   else
     6363     assign
     6364       v-cash-pay-curr = 0
     6365       v-cash-pay-code = 0
     6366       .
     6367   for each tt_price-all  : delete tt_price-all . end.
     6368   assign
     6369     p-plt-id             = ?
     6370     p-plt-db-num         = ?
     6371     p-pdf-id             = ?
     6372     p-pdf-db-num         = ?
     6373     p-sale-price-base    = ?
     6374     p-sale-price-rubl    = ?
     6375     v-cli-oborot         = 0
     6376   .
     6377   find first buf_global-state no-lock no-error .
     6378   if not available buf_global-state then do:
     6379      message
     6380        "Не заданы параметры ценообразования!"
     6381        view-as alert-box error
     6382      .
     6383      return error return-value .
     6384   end.
     6385   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6386   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     6387     (input  p-obj-type
     6388     ,input  p-obj-code
     6389     ,output to-day
     6390     )  .
     6391   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6392   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6393     (input  p-obj-type
     6394     ,input  p-obj-code
     6395     ,output v-host-code
     6396     )  .
     6397   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6398   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     6399     (input  v-host-code
     6400     ,input  to-day
     6401     ,output v-base-rate0
     6402     ,output v-base-scale0
     6403     )  .
     6404     v-cli-oborot-ALL  = 0 .
     6405     for each buf_turnover-buyer-main no-lock  where
     6406              buf_turnover-buyer-main.cli-type = p-cli-type  and
     6407              buf_turnover-buyer-main.cli-code = p-cli-code
     6408              :
     6409              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     6410     end.
     6411   for each buf_price-all no-lock where
     6412            buf_price-all.obj-type = p-obj-type and
     6413            buf_price-all.obj-code = p-obj-code and
     6414            buf_price-all.gds-code = buf_goods.gds-code and
     6415            buf_price-all.status_  = 'акт':U  and
     6416          ( p-only-b-code = false   or
     6417          ( buf_price-all.b-code = p-main-b-code or
     6418            buf_price-all.b-code = p-b-code))    and
     6419           ( p-only-b-code = true  or
     6420             buf_price-all.b-code = p-b-code)
     6421             and
     6422             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6423           ( buf_price-all.fact-order-sys-to = ? or
     6424             buf_price-all.fact-order-sys-to    >= p-fact-order)
     6425           :
     6426            v-interv   = "" .
     6427            v-grp-name = "" .
     6428            v-pay-name = "" .
     6429            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     6430            if buf_price-all.bgr-id > 0 then do:
     6431               find first buf_buyer-group no-lock where
     6432                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     6433                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     6434               if available buf_buyer-group then do:
     6435                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6436                  find first buf_buyer-in-buyer-group no-lock where
     6437                             buf_buyer-in-buyer-group.stts         = 0 and
     6438                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     6439                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     6440                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     6441                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     6442                             no-error .
     6443                             if not available buf_buyer-in-buyer-group then do:
     6444                                v-grp-name = "".
     6445                                next.
     6446                             end.
     6447                             v-grp-name = buf_buyer-group.name .
     6448                  end.
     6449               end.
     6450               else do:
     6451                    v-grp-name = "".
     6452                    next.
     6453               end.
     6454            end.
     6455            if buf_price-all.tog-id > 0 then do:
     6456               find first buf_turnover-group no-lock where
     6457                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     6458                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     6459               if available buf_turnover-group then do:
     6460                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6461                     v-cli-oborot = v-cli-oborot-all  .
     6462                     find first buf1_tnv-in-turnover-group no-lock where
     6463                                buf1_tnv-in-turnover-group.stts       =  0     and
     6464                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6465                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6466                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     6467                     find first buf2_tnv-in-turnover-group no-lock where
     6468                                buf2_tnv-in-turnover-group.stts       =  0     and
     6469                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6470                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6471                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     6472                     if not (available buf1_tnv-in-turnover-group and
     6473                             available buf2_tnv-in-turnover-group ) then do:
     6474                             v-grp-name = "".
     6475                             next .
     6476                     end.
     6477                     v-grp-name = buf_turnover-group.name.
     6478                  end.
     6479               end.
     6480               else do:
     6481                    v-grp-name = "".
     6482                    next.
     6483               end.
     6484            end.
     6485            if buf_price-all.plt-fix-cource-crc-base = true then
     6486               assign
     6487                 v-base-rate  = buf_price-all.pdf-base-rate
     6488                 v-base-scale = buf_price-all.pdf-base-scale
     6489               .
     6490               else
     6491               assign
     6492                 v-base-rate  = v-base-rate0
     6493                 v-base-scale = v-base-scale0
     6494               .
     6495            if buf_price-all.plt-fix-cource-crc-doc = true then
     6496               assign
     6497                 v-exch-rate  = buf_price-all.pdf-exch-rate
     6498                 v-exch-scale = buf_price-all.pdf-exch-scale
     6499               .
     6500               else do:
     6501   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6502   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     6503     (input  buf_price-all.curr-code
     6504     ,input  to-day
     6505     ,output v-exch-rate0
     6506     ,output v-exch-scale0
     6507     ,output v-curr-abbr
     6508     )  .
     6509               assign
     6510                 v-exch-rate  = v-exch-rate0
     6511                 v-exch-scale = v-exch-scale0
     6512                 .
     6513              end.
     6514              v-date-1 = date ( "" )  .
     6515              if buf_price-all.fact-order-sys-from > 0 then do:
     6516                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     6517                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     6518                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     6519              end.
     6520              v-date-2 =  date ( "" )  .
     6521              if buf_price-all.fact-order-sys-to > 0 then do:
     6522                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     6523                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     6524                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     6525              end.
     6526              if buf_price-all.qnty-from <> ? then do :
     6527                 if not (
     6528                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     6529                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     6530                 ) then do:
     6531                        v-interv = "".
     6532                        next.
     6533                 end.
     6534                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     6535              end.
     6536              if buf_price-all.sum-from <> ? then do :
     6537                 if not (
     6538                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     6539                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     6540                 ) then do:
     6541                    v-interv = "".
     6542                    next.
     6543                 end.
     6544                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     6545              end.
     6546              if buf_price-all.turnover-from <> ? then do :
     6547                 if not (
     6548                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     6549                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     6550                 ) then do:
     6551                    v-interv = "".
     6552                    next.
     6553                 end.
     6554                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     6555              end.
     6556              if buf_price-all.use-pay-type = 1 then do :
     6557                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     6558                    v-pay-name = "" .
     6559                    next.
     6560                  end.
     6561                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     6562              end.
     6563              if buf_price-all.use-cash-pay = 1 then do :
     6564                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     6565                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     6566                   v-pay-name = "" .
     6567                   next.
     6568                 end.
     6569                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     6570              end.
     6571             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     6572             create tt_price-all .
     6573             buffer-copy buf_price-all to tt_price-all
     6574             assign
     6575               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     6576               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     6577               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     6578               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     6579               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     6580               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     6581               tt_price-all.price-sale     = buf_price-all.price-sale
     6582               tt_price-all.road-tax       = buf_price-all.road-tax
     6583               tt_price-all.excise         = buf_price-all.excise
     6584               tt_price-all.pdf-exch-rate   = v-exch-rate
     6585               tt_price-all.pdf-exch-scale  = v-exch-scale
     6586               tt_price-all.pdf-base-rate   = v-base-rate
     6587               tt_price-all.pdf-base-scale  = v-base-scale
     6588               tt_price-all.grp-name        = v-grp-name
     6589               tt_price-all.date-1          = v-date-1
     6590               tt_price-all.shift-1         = buf_price-all.start-shift-num
     6591               tt_price-all.time-1          = buf_price-all.start-sys-time
     6592               tt_price-all.date-2          = v-date-2
     6593               tt_price-all.shift-2         = buf_price-all.end-shift-num
     6594               tt_price-all.time-2          = buf_price-all.end-sys-time
     6595               tt_price-all.interv-name     = v-interv
     6596               tt_price-all.pay-name        = v-pay-name
     6597               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     6598             .
     6599   end.
     6600   define variable vt-plt-id as integer   no-undo .
     6601   define variable vt-plt-db as integer   no-undo .
     6602   define variable vt-pdf-id as integer   no-undo .
     6603   define variable vt-pdf-db as integer   no-undo .
     6604   define buffer neos_price-all for tt_price-all  .
     6605   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     6606       if available tt_price-all then do:
     6607        assign
     6608          vt-plt-id = tt_price-all.plt-id
     6609          vt-plt-db = tt_price-all.plt-db-num
     6610          vt-pdf-id = tt_price-all.pdf-id
     6611          vt-pdf-db = tt_price-all.pdf-db
     6612        .
     6613        if tt_price-all.b-code = p-b-code then do:
     6614             assign
     6615               p-plt-id           = tt_price-all.plt-id
     6616               p-plt-db-num       = tt_price-all.plt-db-num
     6617               p-pdf-id           = tt_price-all.pdf-id
     6618               p-pdf-db-num       = tt_price-all.pdf-db
     6619               p-sale-price-base  = tt_price-all.price-sale-base
     6620               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6621               p-road-tax-base    = tt_price-all.road-tax-base
     6622               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6623               p-excise-base      = tt_price-all.excise-base
     6624               p-excise-rubl      = tt_price-all.excise-rubl
     6625               .
     6626        end.
     6627        else do:
     6628          find first neos_price-all where
     6629                     neos_price-all.b-code     = p-b-code  and
     6630                     neos_price-all.plt-id     = vt-plt-id and
     6631                     neos_price-all.plt-db-num = vt-plt-db and
     6632                     neos_price-all.pdf-id     = vt-pdf-id and
     6633                     neos_price-all.pdf-db     = vt-pdf-db
     6634                     use-index pi no-error .
     6635            if available neos_price-all then do:
     6636             assign
     6637               p-plt-id           = tt_price-all.plt-id
     6638               p-plt-db-num       = tt_price-all.plt-db-num
     6639               p-pdf-id           = tt_price-all.pdf-id
     6640               p-pdf-db-num       = tt_price-all.pdf-db
     6641               p-sale-price-base  = neos_price-all.price-sale-base
     6642               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     6643               p-road-tax-base    = neos_price-all.road-tax-base
     6644               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     6645               p-excise-base      = neos_price-all.excise-base
     6646               p-excise-rubl      = neos_price-all.excise-rubl
     6647               .
     6648            end.
     6649            else do:
     6650                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6651                 if error-status :error    then do:
     6652                   message "Не найден бар-код" p-b-code view-as alert-box error .
     6653                   return error return-value .
     6654                 end.
     6655             assign
     6656               p-plt-id           = tt_price-all.plt-id
     6657               p-plt-db-num       = tt_price-all.plt-db-num
     6658               p-pdf-id           = tt_price-all.pdf-id
     6659               p-pdf-db-num       = tt_price-all.pdf-db
     6660               p-sale-price-base  = tt_price-all.price-sale-base
     6661               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6662               p-road-tax-base    = tt_price-all.road-tax-base
     6663               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6664               p-excise-base      = tt_price-all.excise-base
     6665               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     6666               .
     6667            end.
     6668        end.
     6669     end.
     6670   end.
     6671   end procedure.
     6672   procedure mpl-tpl-auto :
     6673   define input  parameter p-b-code     as integer   no-undo .
     6674   define input  parameter p-obj-type   as character no-undo .
     6675   define input  parameter p-obj-code   as integer   no-undo .
     6676   define input  parameter p-plt-id     as integer   no-undo .
     6677   define input  parameter p-plt-db-num as integer   no-undo .
     6678   define input  parameter p-fact-order as decimal   no-undo .
     6679   define output parameter p-sale-price as decimal   no-undo .
     6680   define output parameter p-pdf-id     as integer   no-undo .
     6681   define output parameter p-pdf-db-num as integer   no-undo .
     6682     do
     6683     on error undo, return error return-value
     6684     :
     6685   if p-fact-order = ? then do:
     6686     run fact-order-mpl (
     6687         input   today       ,
     6688         input   p-obj-type  ,
     6689         input   p-obj-code  ,
     6690         output  p-fact-order ) .
     6691   end.
     6692   assign
     6693     p-pdf-id      = ?
     6694     p-pdf-db-num  = ?
     6695     p-sale-price  = ?
     6696   .
     6697   define buffer buf_bar-code for ub.bar-code  .
     6698   define buffer buf_goods for ub.goods  .
     6699   find first buf_bar-code no-lock where
     6700              buf_bar-code.b-code = p-b-code
     6701              no-error .
     6702   if error-status :error then return error return-value .
     6703   find first buf_goods no-lock where
     6704              buf_goods.gds-code = buf_bar-code.gds-code
     6705              no-error .
     6706   if error-status :error then return error return-value .
     6707   define variable v-main-b-code as integer   no-undo .
     6708   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6709     (input  buf_goods.gds-code
     6710     ,input  ?
     6711     ,output v-main-b-code
     6712     )  .
     6713   define buffer buf_price-all for ub.price-all  .
     6714   for each tt_price-all : delete tt_price-all. end.
     6715       for each buf_price-all no-lock where
     6716               buf_price-all.plt-id     = p-plt-id                 and
     6717               buf_price-all.plt-db-num = p-plt-db-num             and
     6718               buf_price-all.obj-type   = p-obj-type               and
     6719               buf_price-all.obj-code   = p-obj-code               and
     6720               buf_price-all.gds-code   = buf_goods.gds-code       and
     6721             ( buf_price-all.b-code = v-main-b-code or
     6722               buf_price-all.b-code = p-b-code)    and
     6723               buf_price-all.status_    = 'акт':U         and
     6724               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6725             ( buf_price-all.fact-order-sys-to = ? or
     6726               buf_price-all.fact-order-sys-to >=  p-fact-order)
     6727               :
     6728                 create tt_price-all .
     6729                 buffer-copy buf_price-all to tt_price-all
     6730                 assign
     6731                   tt_price-all.price-sale  = buf_price-all.price-sale
     6732                 .
     6733       end.
     6734   define variable vt-plt-id as integer   no-undo .
     6735   define variable vt-plt-db as integer   no-undo .
     6736   define variable vt-pdf-id as integer   no-undo .
     6737   define variable vt-pdf-db as integer   no-undo .
     6738   define buffer neos_price-all for tt_price-all  .
     6739   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     6740       if available tt_price-all then do:
     6741        assign
     6742          vt-plt-id = tt_price-all.plt-id
     6743          vt-plt-db = tt_price-all.plt-db-num
     6744          vt-pdf-id = tt_price-all.pdf-id
     6745          vt-pdf-db = tt_price-all.pdf-db
     6746        .
     6747        if tt_price-all.b-code = p-b-code then do:
     6748             assign
     6749               p-plt-id           = tt_price-all.plt-id
     6750               p-plt-db-num       = tt_price-all.plt-db-num
     6751               p-pdf-id           = tt_price-all.pdf-id
     6752               p-pdf-db-num       = tt_price-all.pdf-db
     6753               p-sale-price       = tt_price-all.price-sale
     6754               .
     6755        end.
     6756        else do:
     6757          find first neos_price-all where
     6758                     neos_price-all.b-code     = p-b-code  and
     6759                     neos_price-all.plt-id     = vt-plt-id and
     6760                     neos_price-all.plt-db-num = vt-plt-db and
     6761                     neos_price-all.pdf-id     = vt-pdf-id and
     6762                     neos_price-all.pdf-db     = vt-pdf-db
     6763                     use-index pi no-error .
     6764            if available neos_price-all then do:
     6765             assign
     6766               p-plt-id           = tt_price-all.plt-id
     6767               p-plt-db-num       = tt_price-all.plt-db-num
     6768               p-pdf-id           = tt_price-all.pdf-id
     6769               p-pdf-db-num       = tt_price-all.pdf-db
     6770               p-sale-price       = neos_price-all.price-sale
     6771               .
     6772            end.
     6773            else do:
     6774           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6775           if error-status :error    then do:
     6776              message "Не найден бар-код" p-b-code view-as alert-box error .
     6777              return error return-value .
     6778           end.
     6779             assign
     6780               p-plt-id           = tt_price-all.plt-id
     6781               p-plt-db-num       = tt_price-all.plt-db-num
     6782               p-pdf-id           = tt_price-all.pdf-id
     6783               p-pdf-db-num       = tt_price-all.pdf-db
     6784               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     6785               .
     6786            end.
     6787        end.
     6788     end.
     6789     end.
     6790   end procedure.
