     4746   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4747   PROCEDURE cd-mrkt_plu-marketer :
     4748   define input parameter p-silence as logical no-undo .
     4749   define parameter buffer buf_cash-desk for ub.cash-desk.
     4750   define input parameter p-id as character no-undo .
     4751   define input parameter p-b-code like ub.bar-code.b-code no-undo .
     4752   define input parameter p-b-str like ub.prod-bc.b-str no-undo .
     4753   define input parameter p-loc-ean as logical no-undo .
     4754   define input parameter p-is-petrolium as logical no-undo .
     4755   define input parameter p-extra as character no-undo .
     4756   define variable v-tot-gds as integer no-undo .
     4757   define variable v-max-gds as integer no-undo .
     4758   define variable v-petrol-start as integer no-undo .
     4759   define variable v-petrol-range as integer no-undo .
     4760   DEFINE VARIABLE v-today as date no-undo .
     4761   DEFINE VARIABLE v-time as integer no-undo .
     4762   define variable v-plu-type as character no-undo .
     4763   define variable v-int as integer no-undo .
     4764   define buffer  buf_cd-plu for ub.cd-plu.
     4765   define buffer  loc_cd-plu for ub.cd-plu.
     4766   define variable  ii as integer no-undo.
     4767   define variable v-mes as character no-undo .
     4768   _main:
     4769   DO ON ERROR undo, leave on stop undo, leave:
     4770     if buf_cash-desk.pos-type <> 'MARIA':U
     4771     or buf_cash-desk.cash-num <> 0 then do:
     4772       assign
     4773       v-mes =
     4774       substitute("Товары на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     4775                 , buf_cash-desk.pos-type).
     4776       if not p-silence then
     4777       message
     4778       v-mes
     4779       view-as alert-box error .
     4780       return error v-mes.
     4781     end.
     4782     v-tot-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     4783                                     ,input 'MARIA_operative':U
     4784                                     ,input (if buf_cash-desk.pos-type = 'MARIA':U
     4785                                           and p-is-petrolium
     4786                                           then 'tot-petrol':U
     4787                                           else 'tot-gds':U)
     4788                                     , output v-mes).
     4789     if v-tot-gds = ? then undo _main, return error v-mes.
     4790     v-max-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     4791                                     ,input 'MARIA_general':U
     4792                                     ,input 'max-gds':U
     4793                                     ,output v-mes).
     4794     if v-max-gds = ? then undo _main, return error v-mes.
     4795     v-petrol-range = cd-attr_get-attr-int(buffer buf_cash-desk
     4796                                          ,input 'petrolium-range':U
     4797                                          ,input 'petrolium-range':U
     4798                                          ,output v-mes).
     4799     if v-petrol-range = ? then undo _main, return error v-mes.
     4800     if buf_cash-desk.pos-type = 'MARIA':U then do:
     4801       assign
     4802       v-petrol-start = 1
     4803       v-max-gds = (if p-is-petrolium
     4804                    then v-petrol-range
     4805                    else v-max-gds)
     4806       v-plu-type = (if p-is-petrolium
     4807                  then 'топ':U
     4808                  else '':U)
     4809       .
     4810       if p-is-petrolium then do:
     4811         if p-id = '':U then do:
     4812           v-mes = substitute( "Топливо с кодом &1 не привязано к складскому месту&2" +
     4813                               "Невозможно привязать к кассе типа &3"
     4814                               , p-b-str
     4815                               , chr(10)
     4816                               , 'MARIA':U).
     4817           if not p-silence then
     4818           message
     4819           v-mes
     4820           view-as alert-box error .
     4821           return error v-mes.
     4822         end.
     4823         assign
     4824         v-int = integer(p-id)
     4825         no-error
     4826         .
     4827         if error-status:error
     4828         or v-int > v-petrol-range then do:
     4829           v-mes = substitute( "№ резервуара &1 для топлива с кодом &1 не укладывается&3" +
     4830                               "в диапазоны номеров резервуаров для кассы типа &4"
     4831                               , p-id
     4832                               , p-b-str
     4833                               , chr(10)
     4834                               , 'MARIA':U).
     4835           if not p-silence then
     4836           message
     4837           v-mes
     4838           view-as alert-box error .
     4839           return error v-mes.
     4840         end.
     4841       end.
     4842     end.
     4843     if buf_cash-desk.pos-type = 'MARIA':U
     4844     and p-is-petrolium then do:
     4845       find first loc_cd-plu where
     4846                loc_cd-plu.obj-type = 'маг':U
     4847            and loc_cd-plu.obj-code = buf_cash-desk.obj-code
     4848            and loc_cd-plu.pos-type = buf_cash-desk.pos-type
     4849            and loc_cd-plu.plu-type = 'топ':U
     4850      no-error .
     4851      if available loc_cd-plu then do:
     4852        if loc_cd-plu.b-code = p-b-code
     4853        and loc_cd-plu.b-str = p-b-str then do:
     4854           v-mes = substitute( "№ резервуара &1 на кассе УЖЕ привязан к топливу с кодом &1,&3"
     4855                               , p-id
     4856                               , p-b-str
     4857                               , chr(10)
     4858                               ).
     4859           if not p-silence then
     4860           message
     4861           v-mes
     4862           view-as alert-box WARNING .
     4863           return v-mes.
     4864        end.
     4865        else do:
     4866           v-mes = substitute( "№ резервуара &1 на кассе привязан к топливу с кодом &1,&3" +
     4867                               "нельзя его привязать к топливу &2&3"
     4868                               , p-id
     4869                               , loc_cd-plu.b-str
     4870                               , chr(10)
     4871                               , p-b-str).
     4872           if not p-silence then
     4873           message
     4874           v-mes
     4875           view-as alert-box error .
     4876           return error v-mes.
     4877        end.
     4878      end.
     4879      ii = v-int.
     4880     end.
     4881     else do:
     4882       DO ii = (if p-is-petrolium
     4883               then v-petrol-start
     4884               else (if buf_cash-desk.pos-type = 'MARIA':U
     4885                    then 1
     4886                    else (if v-petrol-start = 1
     4887                           then (v-petrol-range + 1)
     4888                           else 1)
     4889                   )
     4890               )
     4891         to v-max-gds :
     4892         if not can-find (loc_cd-plu where
     4893                         loc_cd-plu.obj-type = 'маг':U
     4894                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     4895                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     4896                      and loc_cd-plu.plu-type = v-plu-type
     4897                      and loc_cd-plu.plu-code = ii
     4898                       )
     4899         then LEAVE .
     4900       END .
     4901     end.
     4902     if ii > v-max-gds then do:
     4903         if not p-silence then
     4904         message
     4905         substitute("Превышено максимально допустимое количество &5 &1" +
     4906                   "для касс &2 &3&4"
     4907                   , chr(10)
     4908                   , v-max-gds
     4909                   , 'маг':U
     4910                   , buf_cash-desk.obj-code
     4911                   , (if p-is-petrolium then "топлив" else "товаров")
     4912                   )
     4913         view-as alert-box ERROR .
     4914         undo, return error "max-gds":U.
     4915     end.
     4916     DO ii = (if p-is-petrolium
     4917              then v-petrol-start
     4918              else (if v-petrol-start = 1
     4919                    then (v-petrol-range + 1)
     4920                    else 1)
     4921              )
     4922        to v-max-gds :
     4923       if not can-find (loc_cd-plu where
     4924                         loc_cd-plu.obj-type = 'маг':U
     4925                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     4926                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     4927                      and loc_cd-plu.plu-type = v-plu-type
     4928                      and loc_cd-plu.plu-code = ii
     4929                      )
     4930       then LEAVE .
     4931     END .
     4932     if ii > v-max-gds then do:
     4933         if not p-silence then
     4934         message
     4935         substitute("Превышено максимально допустимое количество &5 &1" +
     4936                   "для касс &2 &3&4"
     4937                   , chr(10)
     4938                   , v-max-gds
     4939                   , 'маг':U
     4940                   , buf_cash-desk.obj-code
     4941                   , (if p-is-petrolium then "топлив" else "товаров")
     4942                   )
     4943         view-as alert-box ERROR .
     4944         undo, return error "max-gds":U.
     4945     end.
     4946     run cur-time in this-procedure ( output v-today, output v-time).
     4947     create buf_cd-plu.
     4948     assign
     4949     buf_cd-plu.b-code = p-b-code
     4950     buf_cd-plu.b-str = p-b-str
     4951     buf_cd-plu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     4952                                         then buf_cash-desk.addr-path
     4953                                         else "U":U)
     4954     buf_cd-plu.to-send = yes
     4955     buf_cd-plu.charkey_one = "":U
     4956     buf_cd-plu.to-del = no
     4957     buf_cd-plu.plu-code = ii
     4958     buf_cd-plu.obj-type = 'маг':U
     4959     buf_cd-plu.obj-code = buf_cash-desk.obj-code
     4960     buf_cd-plu.pos-type = buf_cash-desk.pos-type
     4961     buf_cd-plu.plu-type = v-plu-type
     4962     buf_cd-plu.logkey_one = p-loc-ean
     4963     buf_cd-plu.key#_one = integer(p-extra)
     4964     .
     4965     run cd-attr-write  in this-procedure (
     4966                                           input   buf_cash-desk.db-num
     4967                                           ,input  buf_cash-desk.obj-code
     4968                                           ,input  buf_cash-desk.pos-type
     4969                                           ,input  buf_cash-desk.cash-num
     4970                                           ,input  substitute("&1_operative", buf_cash-desk.pos-type)
     4971                                           ,input (if buf_cash-desk.pos-type = 'MARIA':U
     4972                                                 and p-is-petrolium
     4973                                                 then 'tot-petrol':U
     4974                                                 else 'tot-gds':U)
     4975                                           ,input ''
     4976                                           ,input ?
     4977                                           ,input 0.0
     4978                                           ,input  (v-tot-gds + 1)
     4979                                           ,input no
     4980                                          ) no-error .
     4981     if error-status:error then do:
     4982       v-mes = substitute("Ошибка при записи <текущее количество товаров на кассе> для кассы &1 &2&3:&4&5 &6"
     4983                          ,buf_cash-desk.cash-num
     4984                          , 'маг':U
     4985                          ,buf_cash-desk.obj-code
     4986                          , chr(10)
     4987                          , error-status:get-message(1)
     4988                          , return-value
     4989                          ).
     4990       if not p-silence then
     4991       message
     4992       v-mes
     4993       view-as alert-box error .
     4994       undo _main, return error v-mes.
     4995     end.
     4996     run cd-attr-write  in this-procedure (
     4997                                           input   buf_cash-desk.db-num
     4998                                           ,input  buf_cash-desk.obj-code
     4999                                           ,input  buf_cash-desk.pos-type
     5000                                           ,input  buf_cash-desk.cash-num
     5001                                           ,input  'MARIA_operative':U
     5002                                           ,input  'to-send':U
     5003                                           ,input ''
     5004                                           ,input ?
     5005                                           ,input 0.0
     5006                                           ,input 0
     5007                                           ,input yes
     5008                                          ) no-error .
     5009     if error-status:error then do:
     5010       v-mes = substitute("Ошибка при записи <Есть коды товаров, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     5011                          ,buf_cash-desk.cash-num
     5012                          , 'маг':U
     5013                          ,buf_cash-desk.obj-code
     5014                          , chr(10)
     5015                          , error-status:get-message(1)
     5016                          , return-value
     5017                          ).
     5018       if not p-silence then
     5019       message
     5020       v-mes
     5021       view-as alert-box error .
     5022       undo _main, return error v-mes.
     5023     end.
     5024     return "":U.
     5025   end.
     5026   END PROCEDURE.
     5027   procedure cd-mrkt_update-marketer :
     5028   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5029   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5030   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5031   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5032   define input parameter p-is-petrolium as logical no-undo .
     5033   define variable v-to-send as logical no-undo .
     5034   define variable v-tot-gds as integer no-undo .
     5035   define variable v-max-plu as integer no-undo .
     5036   define buffer buf_cd-plu for ub.cd-plu.
     5037   define variable v-plu-type as character no-undo .
     5038     do
     5039     on error undo, return error
     5040     :
     5041       v-to-send = no.
     5042       v-tot-gds = 0.
     5043       assign
     5044       v-plu-type = (if p-is-petrolium
     5045                     then  'топ':U
     5046                     else '':U
     5047                 )
     5048       .
     5049       FOR EACH buf_cd-plu WHERE
     5050              buf_cd-plu.obj-type = 'маг':U
     5051         and  buf_cd-plu.obj-code = p-obj-code
     5052         and  buf_cd-plu.pos-type = p-pos-type
     5053         and  buf_cd-plu.plu-type = v-plu-type
     5054             :
     5055         if  buf_cd-plu.to-del
     5056         or  buf_cd-plu.to-send then do:
     5057           assign
     5058           v-to-send = yes.
     5059         end.
     5060         assign
     5061         v-tot-gds = v-tot-gds + 1.
     5062       end.
     5063       run cd-attr-write  in this-procedure (
     5064                                               input   p-db-num
     5065                                               ,input  p-obj-code
     5066                                               ,input  p-pos-type
     5067                                               ,input  p-cash-num
     5068                                               ,input  'MARIA_operative':U
     5069                                               ,input  (if p-pos-type = 'MARIA':U
     5070                                                        and p-is-petrolium
     5071                                                        then  'tot-petrol':U
     5072                                                        else 'tot-gds':U)
     5073                                               ,input ''
     5074                                               ,input ?
     5075                                               ,input 0.0
     5076                                               ,input v-tot-gds
     5077                                               ,input no
     5078                                                                                           ) no-error .
     5079       if error-status:error then do:
     5080           UNDO, RETURN ERROR RETURN-VALUE.
     5081       END.
     5082       run cd-attr-write  in this-procedure (
     5083                                               input   p-db-num
     5084                                               ,input  p-obj-code
     5085                                               ,input  p-pos-type
     5086                                               ,input  p-cash-num
     5087                                               ,input  'MARIA_operative':U
     5088                                               ,input  (if p-pos-type = 'MARIA':U
     5089                                                        and p-is-petrolium
     5090                                                        then  'petrol-to-send':U
     5091                                                        else 'to-send':U)
     5092                                               ,input ''
     5093                                               ,input ?
     5094                                               ,input 0.0
     5095                                               ,input 0
     5096                                               ,input v-to-send
     5097                                               ) no-error .
     5098       if error-status:error then do:
     5099           UNDO, RETURN ERROR RETURN-VALUE.
     5100       END.
     5101       FIND LAST buf_cd-plu NO-LOCK  WHERE
     5102                buf_cd-plu.obj-type = 'маг':U
     5103            and buf_cd-plu.obj-code = p-obj-code
     5104            and buf_cd-plu.pos-type = p-pos-type
     5105            and buf_cd-plu.plu-type = v-plu-type  use-index pi no-error .
     5106       if available buf_cd-plu then do:
     5107         if v-max-plu < buf_cd-plu.plu-code
     5108         then
     5109         v-max-plu = buf_cd-plu.plu-code .
     5110       end.
     5111       else do:
     5112         v-max-plu = 0.
     5113       end.
     5114       run cd-attr-write  in this-procedure (
     5115                                             input   p-db-num
     5116                                             ,input  p-obj-code
     5117                                             ,input  p-pos-type
     5118                                             ,input  p-cash-num
     5119                                             ,input  'MARIA_operative':U
     5120                                             ,input  (if p-pos-type = 'MARIA':U
     5121                                                     and p-is-petrolium
     5122                                                     then 'max-petrol-plu':U
     5123                                                     else 'max-plu':U)
     5124                                               ,input ''
     5125                                               ,input ?
     5126                                               ,input 0.0
     5127                                               ,input v-max-plu
     5128                                               ,input no
     5129                                             ) no-error .
     5130       if error-status:error then do:
     5131           UNDO, RETURN ERROR RETURN-VALUE.
     5132       END.
     5133     end.
     5134   end procedure.
     5135   PROCEDURE cd-mrkt_clu-marketer :
     5136   define input parameter p-silence as logical no-undo .
     5137   define parameter buffer buf_cash-desk for ub.cash-desk.
     5138   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     5139   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     5140   define variable v-tot-cli as integer no-undo .
     5141   define variable v-max-cli as integer no-undo .
     5142   DEFINE VARIABLE v-today as date no-undo .
     5143   DEFINE VARIABLE v-time as integer no-undo .
     5144   define buffer  buf_cd-clu for ub.cd-clu.
     5145   define buffer  loc_cd-clu for ub.cd-clu.
     5146   define variable  ii as integer no-undo.
     5147   define variable v-mes as character no-undo .
     5148   _main:
     5149   DO ON ERROR undo, leave on stop undo, leave:
     5150     if buf_cash-desk.pos-type <> 'MARIA':U
     5151     or buf_cash-desk.cash-num <> 0 then do:
     5152       assign
     5153       v-mes =
     5154       substitute("Клиенты на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     5155                 , buf_cash-desk.pos-type).
     5156       if not p-silence then
     5157       message
     5158       v-mes
     5159       view-as alert-box error .
     5160       return error v-mes.
     5161     end.
     5162     v-tot-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5163                                     ,input 'MARIA_operative':U
     5164                                     ,input 'tot-cli':U
     5165                                     ,output v-mes).
     5166     if v-tot-cli = ? then undo _main, return error v-mes.
     5167     v-max-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5168                                     ,input 'MARIA_general':U
     5169                                     ,input 'max-cli':U
     5170                                     , output v-mes).
     5171     if v-max-cli = ? then undo _main, return error v-mes.
     5172     DO ii = 1
     5173        to v-max-cli :
     5174       if not can-find (loc_cd-clu where
     5175                       loc_cd-clu.obj-type = 'маг':U
     5176                   and loc_cd-clu.obj-code = buf_cash-desk.obj-code
     5177                   and loc_cd-clu.pos-type = buf_cash-desk.pos-type
     5178                   and loc_cd-clu.clu-type = '':U
     5179                   and loc_cd-clu.clu-code = ii
     5180                      )
     5181       then LEAVE .
     5182     END .
     5183     if ii > v-max-cli then do:
     5184         if not p-silence then
     5185         message
     5186         substitute("Превышено максимально допустимое количество клиентов &1" +
     5187                   "для касс &2 &3&4"
     5188                   , chr(10)
     5189                   , v-max-cli
     5190                   , 'маг':U
     5191                   , buf_cash-desk.obj-code
     5192                   )
     5193         view-as alert-box ERROR .
     5194         undo, return error "max-cli":U.
     5195     end.
     5196     run cur-time in this-procedure ( output v-today, output v-time).
     5197     create buf_cd-clu.
     5198     assign
     5199     buf_cd-clu.cli-code = p-obj-code
     5200     buf_cd-clu.cli-type = p-obj-type
     5201     buf_cd-clu.obj-type = 'маг':U
     5202     buf_cd-clu.obj-code = buf_Cash-desk.obj-code
     5203     buf_cd-clu.pos-type = buf_cash-desk.pos-type
     5204     buf_cd-clu.clu-type = '':U
     5205     buf_cd-clu.to-send = yes
     5206     buf_cd-clu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     5207                               then buf_cash-desk.addr-path
     5208                               else "U":U)
     5209     buf_cd-clu.clu-code = ii
     5210     .
     5211     run cd-attr-write  in this-procedure (
     5212                                           input   buf_cash-desk.db-num
     5213                                           ,input  buf_cash-desk.obj-code
     5214                                           ,input  buf_cash-desk.pos-type
     5215                                           ,input  buf_cash-desk.cash-num
     5216                                           ,input  'MARIA_operative':U
     5217                                           ,input  'tot-cli':U
     5218                                           ,input ''
     5219                                           ,input ?
     5220                                           ,input 0.0
     5221                                           ,input  (v-tot-cli + 1)
     5222                                           ,input no
     5223                                          ) no-error .
     5224     if error-status:error then do:
     5225       v-mes = substitute("Ошибка при записи <текущее количество клиентов на кассе> для кассы &1 &2&3:&4&5 &6"
     5226                          ,buf_cash-desk.cash-num
     5227                          , 'маг':U
     5228                          ,buf_cash-desk.obj-code
     5229                          , chr(10)
     5230                          , error-status:get-message(1)
     5231                          , return-value
     5232                          ).
     5233       if not p-silence then
     5234       message
     5235       v-mes
     5236       view-as alert-box error .
     5237       undo _main, return error v-mes.
     5238     end.
     5239     run cd-attr-write  in this-procedure (
     5240                                           input   buf_cash-desk.db-num
     5241                                           ,input  buf_cash-desk.obj-code
     5242                                           ,input  buf_cash-desk.pos-type
     5243                                           ,input  buf_cash-desk.cash-num
     5244                                           ,input  'MARIA_operative':U
     5245                                           ,input  'cli-to-send':U
     5246                                           ,input ''
     5247                                           ,input ?
     5248                                           ,input 0.0
     5249                                           ,input 0
     5250                                           ,input yes
     5251                                          ) no-error .
     5252     if error-status:error then do:
     5253       v-mes = substitute("Ошибка при записи <Есть коды клиентов, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     5254                          ,buf_cash-desk.cash-num
     5255                          , 'маг':U
     5256                          ,buf_cash-desk.obj-code
     5257                          , chr(10)
     5258                          , error-status:get-message(1)
     5259                          , return-value
     5260                          ).
     5261       if not p-silence then
     5262       message
     5263       v-mes
     5264       view-as alert-box error .
     5265       undo _main, return error v-mes.
     5266     end.
     5267     return "":U.
     5268   end.
     5269   END PROCEDURE.
     5270   procedure cd-mrkt_update-marketer-cli :
     5271   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5272   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5273   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5274   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5275   define variable v-cli-to-send as logical no-undo .
     5276   define variable v-tot-cli as integer no-undo .
     5277   define variable v-max-clu as integer no-undo .
     5278   define buffer buf_cd-clu for ub.cd-clu.
     5279   do
     5280   on error undo, return error return-value
     5281   :
     5282     v-cli-to-send = no.
     5283     v-tot-cli = 0.
     5284     FOR EACH buf_cd-clu WHERE
     5285           buf_cd-clu.obj-type = 'маг':U
     5286       and buf_cd-clu.obj-code =  p-obj-code
     5287       and buf_cd-clu.pos-type =  p-pos-type
     5288       and buf_cd-clu.clu-type =  '':U
     5289       :
     5290       if buf_cd-clu.to-del = yes then do:
     5291         assign
     5292         v-cli-to-send = yes.
     5293       end.
     5294       assign
     5295       v-tot-cli = v-tot-cli + 1.
     5296     end.
     5297     run cd-attr-write  in this-procedure (
     5298                                             input   p-db-num
     5299                                             ,input  p-obj-code
     5300                                             ,input  p-pos-type
     5301                                             ,input  p-cash-num
     5302                                             ,input  'MARIA_operative':U
     5303                                             ,input  'tot-cli':U
     5304                                             ,input ''
     5305                                             ,input ?
     5306                                             ,input 0.0
     5307                                             ,input v-tot-cli
     5308                                             ,input no
     5309                                             ) no-error .
     5310     if error-status:error then do:
     5311         UNDO, RETURN ERROR RETURN-VALUE.
     5312     END.
     5313     run cd-attr-write  in this-procedure (
     5314                                             input   p-db-num
     5315                                             ,input  p-obj-code
     5316                                             ,input  p-pos-type
     5317                                             ,input  p-cash-num
     5318                                             ,input  'MARIA_operative':U
     5319                                             ,input  'cli-to-send':U
     5320                                             ,input ''
     5321                                             ,input ?
     5322                                             ,input 0.0
     5323                                             ,input 0
     5324                                             ,input v-cli-to-send
     5325                                             ) no-error .
     5326     if error-status:error then do:
     5327         UNDO, RETURN ERROR RETURN-VALUE.
     5328     END.
     5329     FIND LAST buf_cd-clu WHERE
     5330             buf_cd-clu.obj-type = 'маг':U
     5331         and buf_cd-clu.obj-code = p-obj-code
     5332         and buf_cd-clu.pos-type = p-pos-type
     5333         and buf_cd-clu.clu-type = '':U
     5334         NO-LOCK use-index pi no-error .
     5335     if available buf_cd-clu then do:
     5336       if v-max-clu < buf_cd-clu.clu-code
     5337       then
     5338       v-max-clu = buf_cd-clu.clu-code.
     5339     end.
     5340     else do:
     5341       v-max-clu = 0.
     5342     end.
     5343     run cd-attr-write  in this-procedure (
     5344                                           input   p-db-num
     5345                                           ,input  p-obj-code
     5346                                           ,input  p-pos-type
     5347                                           ,input  p-cash-num
     5348                                           ,input  'MARIA_operative':U
     5349                                           ,input  'max-clu':U
     5350                                           ,input ''
     5351                                           ,input ?
     5352                                           ,input 0.0
     5353                                           ,input v-max-clu
     5354                                           ,input no
     5355                                           ) no-error .
     5356     if error-status:error then do:
     5357         UNDO, RETURN ERROR RETURN-VALUE.
     5358     END.
     5359   end.
     5360   end procedure.
