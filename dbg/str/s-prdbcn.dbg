    13770                                 , 'IPC-Servis+':U
    13771                                 , 'маг':U
    13772                                 , abs(i-obj-code)).
    13773     end.
    13774     if index(dob-curr, ";":U) > 0  and can-do(entry(2,dob-curr,";"),string(i-obj-code)) then do:
    13775       FIND LAST ub.curr-shop WHERE ub.curr-shop.obj-code = i-obj-code
    13776                               and ub.curr-shop.obj-type = 'маг':U
    13777                               and ub.curr-shop.curr-code = int(entry(1,dob-curr,";"))
    13778                               use-index pi NO-ERROR.
    13779       if available ub.curr-shop then curr_cass = ub.curr-shop.exch-rate / curr-shop.exch-scale.
    13780       else do:
    13781         if not g#news then do:
    13782           return error
    13783           substitute("Не найден курс дополнительной валюты &1 в &2&3", entry(1,dob-curr,";"), 'маг':U, i-obj-code).
    13784         end.
    13785       end.
    13786     end.
