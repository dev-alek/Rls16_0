    11312         if ncr-disc-string <> '':U then
    11313         PUT stream IBMstream unformatted
    11314         chr(32)
    11315         "X":U
    11316         chr(32)
    11317         IBm-good-code
    11318         chr(32)
    11319         chr(32)
    11320         ncr-disc-string
    11321         chr(10)
    11322         .
    11323       end.
    11324     end.
    11325     if pos-type = 'NCR-AS@R':U
    11326     and cash-gds.kat-discnt-rule <> 0
    11327     then do:
    11328       case how-pcnt-kat :
    11329         when 'pcnt-kat-pdf':U then do:
