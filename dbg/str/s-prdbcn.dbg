     8458   FOR EACH cash-gds:
     8459       delete cash-gds.
     8460   END.
     8461   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8462   PROCEDURE term-prt.
