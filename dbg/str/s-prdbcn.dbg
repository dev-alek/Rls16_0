     8849   define variable vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8850   procedure ibm-gdsc :
     8851   define input  parameter p-zeros         as logical no-undo .
     8852   define output parameter IBM-good-code as character no-undo .
     8853   define output parameter IBM-good-code-2 as character no-undo .
     8854   define output parameter IBM2-short      as character no-undo .
     8855   define variable v-delim as character no-undo .
     8856   define variable v-format-str-16 as character no-undo .
     8857     do
     8858     on error undo, return error
     8859     :
     8860       if p-zeros then do:
     8861         assign
     8862         v-delim = '0'
     8863         v-format-str-16 =  "9999999999999999"
     8864         .
     8865       end.
     8866       else do:
     8867         assign
     8868         v-delim = chr(32)
     8869         v-format-str-16 =  ">>>>>>>>>>>>>>>9"
     8870         .
     8871       end.
     8872       if cash-gds.b-str = "" then do:
     8873         assign
     8874         b_code = string( cash-gds.b-code, v-format-str-16 ) .
     8875         if  LOOKUP( 'вес':U, cash-gds.unit-type ) = 0
     8876         or cash-gds.unit-base <> cash-gds.unit-cli
     8877         or (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0  and not ub.shop.cd-sc-base)
     8878         then
     8879         do:
     8880           if ((ub.shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
     8881               (ub.shop.cd-bc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
     8882             RUN gen-bc( input cash-gds.b-code, output bar_code ).
     8883             iBM2-short = bar_code.
     8884             IBM-good-code  = string( fill( v-delim, 16 - length( trim( bar_code ) ) ) + trim( bar_code ), "9999999999999999" ) .
     8885           END.
     8886           if ((ub.shop.cd-loc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
     8887               (ub.shop.cd-loc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
     8888             IBM-good-code-2 = b_code.
     8889           end.
     8890         end.
     8891       end.
     8892       else do:
     8893         IBm-good-code =
     8894         ( if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
     8895           (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
     8896            or
     8897            cash-gds.bc-on-type = 'pglc':U)
     8898         then string( decimal( cash-gds.b-str ), v-format-str-16)
     8899         else string( fill( v-delim, 16 - length( trim( cash-gds.b-str ) ) ) + trim( cash-gds.b-str ), "9999999999999999" ) ).
     8900       end.
     8901     end.
     8902   end procedure.
     8903   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8904   procedure ncr-gdsc :
     8905   define output parameter IBM-good-code as character no-undo .
     8906   define output parameter IBM-good-code-2 as character no-undo .
