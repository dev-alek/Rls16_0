      383   FUNCTION round-m RETURNS DECIMAL(input  mysum as decimal,
      384                                                                     input  orders as integer):
      385   define variable  round-m-sum as decimal no-undo.
      386   if orders >= 0 then
      387   round-m-sum = round(mysum,orders).
      388   else
      389   round-m-sum = round(mysum / exp(10, abs(orders)), 0) * EXP(10, abs(orders)).
      390   return round-m-sum.
      391   END FUNCTION.
      392   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      393   procedure factord :
      394     define input  parameter p-fact-date            as date    no-undo .
      395     define input  parameter p-fact-time            as integer no-undo .
      396     define input  parameter p-fact-num             as integer no-undo .
      397     define input  parameter p-shift-date           as date    no-undo .
      398     define input  parameter p-shift-num            as integer no-undo .
      399     define input  parameter p-shift-on             as logical no-undo .
      400     define output parameter p-fact-order           as decimal no-undo .
      401     define output parameter p-shift-end-fact-order as decimal no-undo .
      402     define output parameter p-day-end-fact-order   as decimal no-undo .
      403     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      404     if p-fact-date = ?
      405     then do:
      406       return error "Не указана фактическая дата" .
      407     end.
      408     define variable v-fact-date-num as integer no-undo .
      409     assign
      410       v-fact-date-num = integer(p-fact-date)
      411     .
      412     if p-fact-num = ?
      413     or p-fact-num = 0
      414     then do:
      415       return error "Не задан p-fact-num " + string(p-fact-num) .
      416     end.
      417     if p-fact-num < 0
      418     then do:
      419       return error "Отрицательный fact-num " + string(p-fact-num) .
      420     end.
      421     if p-fact-num >= 100000000
      422     then do:
      423       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      424     end.
      425     if p-shift-on = true
      426     then do:
      427       if p-shift-date = ?
      428       then do:
      429         return error "Не задана дата смены" .
      430       end.
      431       if p-shift-num = ?
      432       or p-shift-num = 0
      433       then do:
      434         return error "Не задан номер смены" .
      435       end.
      436     end.
      437     else do:
      438       assign
      439         p-shift-date = p-fact-date
      440         p-shift-num  = 24
      441       .
      442     end.
      443     define variable v-shift-offset as integer no-undo .
      444     if p-shift-date = p-fact-date
      445     then do:
      446       assign
      447         v-shift-offset = 1
      448       .
      449     end.
      450     if p-shift-date < p-fact-date
      451     then do:
      452       assign
      453         v-shift-offset = 0
      454       .
      455     end.
      456     if p-shift-date > p-fact-date
      457     then do:
      458       message
      459         vss-workfile vss-revision vss-description skip
      460         "Неправильная дата закрытия смены" skip
      461         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      462         view-as alert-box error .
      463       undo, return error
      464         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      465           ,string(p-fact-date, '99/99/9999':U)
      466           ,string(p-shift-date, '99/99/9999':U)
      467           )
      468       .
      469     end.
      470     if p-shift-num < 1
      471     or p-shift-num > 24
      472     then do:
      473       message
      474         vss-workfile vss-revision vss-description skip
      475         "Неправильный номер смены" skip
      476         "p-shift-num" p-shift-num skip
      477         view-as alert-box error .
      478       undo, return error return-value .
      479     end.
      480     assign
      481       p-fact-order           = v-fact-date-num
      482                              + v-shift-offset * 0.5
      483                              + p-shift-num    * 0.02 - 0.01
      484                              + p-fact-num     * 0.0000000001
      485       p-shift-end-fact-order = v-fact-date-num
      486                              + v-shift-offset * 0.5
      487                              + p-shift-num    * 0.02
      488       p-day-end-fact-order   = v-fact-date-num
      489                              + 0.99
      490     .
      491     if p-fact-order           <= v-fact-date-num
      492     or p-shift-end-fact-order <= v-fact-date-num
      493     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      494     or p-shift-end-fact-order >= p-day-end-fact-order
      495     then do:
      496       message
      497         vss-workfile vss-revision vss-description skip
      498         "Внутренняя ошибка при генерации фактического номера" skip
      499         "p-fact-date"            p-fact-date            skip
      500         "p-fact-time"            p-fact-time            skip
      501         "p-fact-num"             p-fact-num             skip
      502         "p-shift-date"           p-shift-date           skip
      503         "p-shift-num"            p-shift-num            skip
      504         "p-shift-on"             p-shift-on             skip
      505         "p-shift-end-fact-order" p-shift-end-fact-order skip
      506         "p-day-end-fact-order"   p-day-end-fact-order   skip
      507         "v-fact-date-num"        v-fact-date-num        skip
      508         view-as alert-box error .
      509       undo, return error return-value .
      510     end.
      511   end procedure.
      512   procedure day-begin-fact-order :
      513     define input  parameter p-fact-date            as date    no-undo .
      514     define output parameter p-day-begin-fact-order as decimal no-undo .
      515     do
      516     on error undo, return error return-value
      517     :
      518       if p-fact-date = ?
      519       then do:
      520         assign
      521           p-day-begin-fact-order = 0
      522         .
      523       end.
      524       else do:
      525         assign
      526           p-day-begin-fact-order = integer(p-fact-date)
      527         .
      528       end.
      529     end.
      530   end procedure.
      531   procedure factord-max-fact-order :
      532     define output parameter p-max-fact-order as decimal   no-undo .
      533     do
      534     on error undo, return error return-value
      535     :
      536       run day-begin-fact-order in this-procedure
      537         (input  date(1, 1, 5000)
      538         ,output p-max-fact-order
      539         ) .
      540     end.
      541   end procedure.
      542   procedure factord-cut-archive :
      543     define input  parameter p-obj-type             as character no-undo .
      544     define input  parameter p-obj-code             as integer   no-undo .
      545     define input  parameter p-fact-date            as date      no-undo .
      546     define output parameter p-shift-on             as logical   no-undo .
      547     define output parameter p-shift-date           as date      no-undo .
      548     define output parameter p-shift-num            as integer   no-undo .
      549     define output parameter p-day-end-fact-order   as decimal   no-undo .
      550     define output parameter p-shift-end-fact-order as decimal   no-undo .
      551     define variable v-fact-order as decimal   no-undo .
      552     define buffer buf_shift-obj for ub.shift-obj .
      553     do
      554     on error undo, return error return-value
      555     :
      556   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      557   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      558     (input  p-obj-type
      559     ,input  p-obj-code
      560     ,input  'shift-on=request'
      561     ,output p-shift-on
      562     ) no-error .
      563       if error-status :error
      564       then do:
      565         message
      566           vss-workfile vss-revision vss-description skip
      567           "Ошибка при определении атрибута объекта" skip
      568           "Объект" p-obj-type p-obj-code skip
      569           error-status :get-message(1) skip
      570           return-value skip
      571           view-as alert-box error .
      572         undo, return error return-value .
      573       end.
      574       if p-shift-on = false
      575       then do:
      576         assign
      577           p-shift-date               = ?
      578           p-shift-num                = 0
      579         .
      580       end.
      581       else do:
      582         find first buf_shift-obj share-lock
      583           where buf_shift-obj.obj-type   = p-obj-type
      584             and buf_shift-obj.obj-code   = p-obj-code
      585             and buf_shift-obj.shift-date > p-fact-date
      586           use-index pi
      587           no-error .
      588         if not available buf_shift-obj
      589         or buf_shift-obj.status_ <> 'зкр':U
      590         then do:
      591           message
      592             vss-workfile vss-revision vss-description skip
      593             "Невозможно вычислить последнюю смену" skip
      594             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      595             "Объект" p-obj-type p-obj-code skip
      596             "Дата" p-fact-date skip
      597             view-as alert-box error .
      598           undo, return error return-value .
      599         end.
      600         find last buf_shift-obj share-lock
      601           where buf_shift-obj.obj-type = p-obj-type
      602             and buf_shift-obj.obj-code = p-obj-code
      603             and buf_shift-obj.shift-date <= p-fact-date
      604           use-index pi
      605           no-error .
      606         if available buf_shift-obj
      607         then do:
      608           if  buf_shift-obj.status_ = 'зкр':U
      609           then do:
      610             assign
      611               p-shift-date = buf_shift-obj.shift-date
      612               p-shift-num  = buf_shift-obj.shift-num
      613             .
      614           end.
      615           else do:
      616             message
      617               vss-workfile vss-revision vss-description skip
      618               "Невозможно вычислить последнюю смену" skip
      619               "Статус смены отличен от статуса" 'зкр':U skip
      620               "Объект" p-obj-type p-obj-code skip
      621               "Дата" p-fact-date skip
      622               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      623               view-as alert-box error .
      624             undo, return error return-value .
      625           end.
      626         end.
      627         else do:
      628           assign
      629             p-shift-date = p-fact-date - 1
      630             p-shift-num  = 1
      631           .
      632         end.
      633       end.
      634       run factord in this-procedure
      635         (input  p-fact-date
      636         ,input  1
      637         ,input  1
      638         ,input  p-shift-date
      639         ,input  p-shift-num
      640         ,input  p-shift-on
      641         ,output v-fact-order
      642         ,output p-shift-end-fact-order
      643         ,output p-day-end-fact-order
      644         ) no-error .
      645       if error-status :error
      646       then do:
      647         message
      648           vss-workfile vss-revision vss-description skip
      649           "Ошибка при вызове процедуры factord"
      650           error-status :get-message(1) skip
      651           return-value skip
      652           view-as alert-box error .
      653         undo, return error return-value .
      654       end.
      655     end.
      656   end procedure.
      657   procedure factord-lock-shift :
      658     define input  parameter p-obj-type  as character no-undo .
      659     define input  parameter p-obj-code  as integer   no-undo .
      660     define input  parameter p-fact-date as date      no-undo .
      661     define parameter buffer buf_shift-obj for ub.shift-obj .
      662     define variable v-shift-on      as logical   no-undo .
      663     define variable v-extra-message as character no-undo .
      664     define variable v-error as character no-undo .
      665     do
      666     on error undo, return error return-value
      667     :
      668   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      669   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      670     (input  p-obj-type
      671     ,input  p-obj-code
      672     ,input  'shift-on=request'
      673     ,output v-shift-on
      674     ) no-error .
      675       if error-status :error
      676       then do:
      677         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      678         undo, return error v-error .
      679       end.
      680       if v-shift-on = true
      681       then do:
      682         find first buf_shift-obj share-lock
      683           where buf_shift-obj.obj-type   = p-obj-type
      684             and buf_shift-obj.obj-code   = p-obj-code
      685             and buf_shift-obj.shift-date > p-fact-date
      686           use-index pi
      687           no-error .
      688         if not available buf_shift-obj
      689         or buf_shift-obj.status_ <> 'зкр':U
      690         then do:
      691           find last buf_shift-obj
      692             where buf_shift-obj.obj-type = p-obj-type
      693               and buf_shift-obj.obj-code = p-obj-code
      694               and buf_shift-obj.status_  = 'зкр':U
      695             use-index stts
      696             no-error .
      697           if available buf_shift-obj
      698           then do:
      699             assign
      700               v-extra-message =
      701                     substitute("Дата начала последеней закрытой смены на объекте &1"
      702                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      703                               )
      704             .
      705           end.
      706           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      707           undo, return error v-error .
      708         end.
      709       end.
      710     end.
      711   end procedure.
      712   procedure factord-end-day :
      713     define input  parameter p-fact-date            as date    no-undo .
      714     define output parameter p-day-end-fact-order   as decimal no-undo .
      715     do
      716     on error undo, return error return-value
      717     :
      718       if p-fact-date = ?
      719       then do:
      720         return error "Не указана фактическая дата" .
      721       end.
      722       assign
      723         p-day-end-fact-order = integer(p-fact-date) + 0.99
      724       .
      725     end.
      726   end procedure.
      727   procedure factord-to-date :
      728     define input  parameter p-fact-order as decimal no-undo .
      729     define output parameter p-fact-date  as date    no-undo .
      730     define variable v-ref-date  as date      no-undo .
      731     define variable v-ref-delta as integer   no-undo .
      732     do
      733     on error undo, return error return-value
      734     :
      735       if p-fact-order = ?
      736       or p-fact-order = 0
      737       then do:
      738         return error "Не указан fact-order" .
      739       end.
      740       assign
      741         v-ref-date  = date(1, 1, 2000)
      742       .
      743       assign
      744         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      745       .
      746       assign
      747         p-fact-date = v-ref-date + v-ref-delta
      748       .
      749     end.
      750   end procedure.
      751   procedure factord-to-fact-num :
      752     define input  parameter p-fact-order as decimal no-undo .
      753     define output parameter p-fact-num   as integer no-undo .
      754     define variable v-fact-order-trunc as decimal no-undo .
      755     do
      756     on error undo, return error return-value
      757     :
      758       if p-fact-order = ?
      759       or p-fact-order = 0
      760       then do:
      761         return error "Не указан fact-order" .
      762       end.
      763       assign
      764        v-fact-order-trunc = truncate(p-fact-order, 2)
      765       .
      766       assign
      767         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      768       .
      769     end.
      770   end procedure.
      771   procedure factord-to-shift-num :
      772     define input  parameter p-fact-order as decimal no-undo .
      773     define output parameter p-shift-num   as integer no-undo .
      774     define variable  p-shift-numd  as decimal   no-undo .
      775     define variable v-fact-order-trunc as decimal no-undo .
      776     do
      777     on error undo, return error return-value
      778     :
      779       if p-fact-order = ?
      780       or p-fact-order = 0
      781       then do:
      782         return error "Не указан fact-order" .
      783       end.
      784       assign
      785        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      786       .
      787       if v-fact-order-trunc < 0.5 then do:
      788         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      789       end.
      790       assign
      791         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      792         .
      793        assign
      794         p-shift-num = truncate (p-shift-numd , 0)
      795       .
      796     end.
      797   end procedure.
      798   define new global shared variable g#lib-trn  as handle no-undo .
      799   define new global shared variable g#lib-trn2 as handle no-undo .
      800   define new global shared variable g#lib-trn3 as handle no-undo .
      801   define new global shared variable g#lib-trn4 as handle no-undo .
      802   define temp-table  tt-tax no-undo
      803     field tax-code    like ub.tax.tax-code
      804     field individual  like ub.tax.individual
      805     field tax-name    like ub.tax.tax-name format "x(12)" column-label "Налог"
      806     field rate-code   like ub.tax-rate.rate-code
      807     field rate-name   like ub.tax-rate.rate-name format "x(12)"
      808     field tax-type    like ub.tax.tax-type
      809     field rate-value  like ub.tax-rate-value.rate-value
      810     field tax-rate-gds-rc  as recid
      811     field to-cashdesk like ub.tax.to-cashdesk
      812     index tax-code is unique primary tax-code
      813     .
      814   procedure tax-val :
      815     define input  parameter       parartic      like ub.doc-line.artic     no-undo.
      816     define input  parameter       parprod-type  like ub.doc-line.prod-type no-undo.
      817     define input  parameter       parprod-code  like ub.doc-line.prod-code no-undo.
      818     define input  parameter       parunit-base  like ub.goods.unit-base    no-undo.
      819     define input  parameter       parnode-code  like ub.gds-prt.node-code  no-undo.
      820     define input  parameter       parunits-type like ub.units.type         no-undo.
      821     define input  parameter       parrec-id     as recid                   no-undo.
      822     define input  parameter       paris-log     as logical                 no-undo.
      823     define input  parameter       rdtaxcdvalue  as integer                 no-undo.
      824     define input  parameter       vattaxcdvalue as integer                 no-undo.
      825     define input  parameter       exctaxcdvalue as integer                 no-undo.
      826     define input  parameter       only-check    as logical                 no-undo.
      827     define input  parameter       parhost-code  like ub.sysconf.host-code  no-undo.
      828     define input  parameter       parobj-type   like ub.clients.obj-type   no-undo.
      829     define input  parameter       parobj-code   like ub.clients.obj-code   no-undo.
      830     define input  parameter       parroad-tax   like ub.doc-line.road-tax  no-undo.
      831     define input  parameter       parexcise     like ub.doc-line.excise    no-undo.
      832     define output parameter       parerr-mes    as character               no-undo.
      833     define input-output parameter parprice-sale like ub.price-list.price-sale no-undo.
      834     do
      835     on error undo, return error return-value
      836     :
      837   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      838   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
      839   define variable gp-price-sale like ub.price-list.price-sale no-undo.
      840   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
      841   define variable gp-excise     like ub.price-list.excise     no-undo.
      842   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
      843   define variable gp-fact-order as decimal   no-undo .
      844   define variable gp-price-sale-parts as decimal   no-undo .
      845       define buffer buf_tax          for ub.tax .
      846       define buffer buf_tax-rate     for ub.tax-rate .
      847       define buffer buf_tax-units    for ub.tax-units .
      848       define buffer buf_tax-rate-gds for ub.tax-rate-gds .
      849       define buffer buf_goods        for ub.goods .
      850       define buffer buf_bar-code     for ub.bar-code .
      851       define buffer buf_prod-bc      for ub.prod-bc .
      852       define buffer buf_units        for ub.units .
      853       define buffer buf_shop         for ub.shop .
      854       define buffer buf_store        for ub.store .
      855       define buffer buf_gds-prt      for ub.gds-prt .
      856       define buffer buf_tt-tax       for tt-tax .
      857       define variable varrate-value    as decimal   initial ? no-undo.
      858       define variable pr-list-recid    as recid     initial ? no-undo.
      859       define variable varmes           as character no-undo.
      860       define variable varfactorrtvalue as char      initial ? no-undo.
      861       define variable varfactorrttype  as char      initial ? no-undo.
      862       define variable is-petrolium     as logical no-undo.
      863       define variable is-pieces        as logical no-undo.
      864       define variable vargds-code      like ub.goods.gds-code no-undo.
      865       define variable pargds-code      like ub.goods.gds-code no-undo.
      866       define variable var-fact-order   as decimal no-undo .
      867       define variable currate-code     like buf_tax-rate.rate-code no-undo .
      868       define variable currate-name     like buf_tax-rate.rate-name no-undo .
      869       define variable currate-gds-rc   as recid no-undo .
      870       define variable v-today          as date no-undo .
      871       define variable v-time           as integer no-undo .
      872       for each buf_tt-tax:
      873         delete buf_tt-tax.
      874       end.
      875       run cur-time in this-procedure(output v-today, output v-time).
      876       run factord-end-day in this-procedure (input v-today, output var-fact-order).
      877       if parartic     = ?
      878       or parprod-type = ?
      879       or parprod-code = ?
      880       or parunit-base = ?
      881       then do:
      882         find first buf_goods no-lock
      883           where recid(buf_goods) = parrec-id
      884           no-error .
      885       end.
      886       else do:
      887         find first buf_goods no-lock
      888           where buf_goods.artic = parartic
      889             and buf_goods.prod-type = parprod-type
      890             and buf_goods.prod-code = parprod-code
      891           no-error .
      892       end.
      893       if not available buf_goods then do:
      894         assign varmes = "Ошибка при поиске товара. Программа tax-val.i" + chr(10) .
      895         if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      896       end.
      897       assign
      898         parartic     = buf_goods.artic
      899         parprod-type = buf_goods.prod-type
      900         parprod-code = buf_goods.prod-code
      901         parunit-base = buf_goods.unit-base
      902         pargds-code  = buf_goods.gds-code
      903       .
      904       if parunits-type = ?
      905       then do:
      906         find buf_units no-lock
      907           where buf_units.unit-name = parunit-base
      908           no-error .
      909         if not available buf_units then do:
      910           assign
      911             varmes =  varmes + "Ошибка при поиске единицы измерения. Программа tax-val.i" + chr(10)
      912           .
      913           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      914         end.
      915         assign
      916           parunits-type = buf_units.type
      917         .
      918       end.
      919       if parhost-code = ?
      920       or parhost-code = 0
      921       then do:
      922   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      923   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      924     (input  parobj-type
      925     ,input  abs(parobj-code)
      926     ,output parhost-code
      927     ) no-error .
      928         if error-status :error then do:
      929           assign
      930             varmes =  varmes + substitute("Ошибка при определении фирмы для объекта &1 &2. Программа tax-val.i"
      931               ,string(parobj-type)
      932               ,string(parobj-code)
      933               ) + chr(10)
      934           .
      935           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      936         end.
      937       end.
      938       assign
      939         vargds-code = buf_goods.gds-code
      940       .
      941       for each buf_tax-units no-lock
      942         where LOOKUP(buf_tax-units.type, parunits-type) > 0
      943       ,first buf_tax no-lock
      944         where buf_tax.tax-code = buf_tax-units.tax-code
      945       :
      946         find first buf_tt-tax where
      947                    buf_tt-tax.tax-code = buf_tax.tax-code no-error .
      948         if not available buf_tt-tax then do:
      949           create buf_tt-tax .
      950         end.
      951         assign
      952           buf_tt-tax.tax-code = buf_tax.tax-code
      953         .
      954         if buf_tax.individual = false then do:
      955           assign
      956             currate-gds-rc = ?
      957           .
      958           _tax-rate-gds:
      959           for each buf_tax-rate-gds no-lock where
      960                   buf_tax-rate-gds.gds-code = pargds-code and
      961                   buf_tax-rate-gds.tax-code = buf_tax.tax-code,
      962           first buf_tax-rate where
      963                 buf_tax-rate.tax-code  = buf_tax-rate-gds.tax-code and
      964                 buf_tax-rate.rate-code = buf_tax-rate-gds.rate-code no-lock
      965           by buf_tax-rate-gds.host-code
      966           by buf_tax-rate-gds.obj-type
      967           by buf_tax-rate-gds.obj-code
      968           by buf_tax-rate-gds.fact-order
      969           :
      970             if buf_tax-rate-gds.fact-order > var-fact-order then do:
      971               next _tax-rate-gds.
      972             end.
      973             if buf_tax-rate-gds.host-code = 0 or
      974               ((buf_tax-rate-gds.host-code = parhost-code) or
      975               (buf_tax-rate-gds.obj-type = parobj-type AND
      976               buf_tax-rate-gds.obj-code = parobj-code))
      977             then do:
      978               assign
      979               currate-code = buf_tax-rate.rate-code
      980               currate-name = buf_tax-rate.rate-name
      981               currate-gds-rc = recid(buf_tax-rate)
      982               .
      983             end.
      984             else do:
      985               next _tax-rate-gds.
      986             end.
      987           end.
      988           if currate-gds-rc = ? then do:
      989             assign varmes = "Не найдена ставка налога: "  + string(buf_tt-tax.tax-code) + " " + buf_tt-tax.tax-name +
      990                             " к товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
      991                             chr(10).
      992             if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      993           end.
      994         end.
      995         assign
      996           buf_tt-tax.rate-code   = currate-code
