    12813                                       , input 0
    12814                                       , input no
    12815                                       , input 10
    12816                                       , input 5000
    12817                                       , input v-plu
    12818                                       , input (if v-marketer-action = "U"
    12819                                                 then (
    12820                                                     string(cash-gds.gds-stat MODULO 2) +
    12821                                                     string(if cash-gds.fp then 1 else 0) +
    12822                                                     string(cash-gds.office) )
    12823                                                 else '000')
    12824                                             ).
    12825         run maria-put in this-procedure (
    12826                                         buffer for-cash-desk
