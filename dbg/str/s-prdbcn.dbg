    10063       if available buf_goods-attr then
    10064       do:
    10065         run bgelib-tag-put in this-procedure ( input 4, input "ItemCommodityCode" , input string( buf_goods-attr.attr-value), input 1 ).
    10066       end.
    10067   find first buf_goods-attr where buf_goods-attr.gds-code = cash-gds.gds-code
    10068                 and buf_goods-attr.attr-code  = 'oper-serv-idd':U no-error.
    10069     if available buf_goods-attr then do:
