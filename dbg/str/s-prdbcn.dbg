     1851   define stream stmXMLLog.
     1852   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1853   procedure cur-time :
     1854      define output parameter p-today as date      no-undo .
     1855      define output parameter p-time  as integer   no-undo .
     1856     do
     1857     on error undo, return error
     1858     :
     1859       define variable v-date1 as date      no-undo .
     1860       define variable v-date2 as date      no-undo .
     1861       define variable v-time  as integer   no-undo .
     1862       assign
     1863         v-date1 = today
     1864         v-time  = time
     1865         v-date2 = today
     1866       .
     1867       if v-date1 <> v-date2
     1868       then do:
     1869         assign
     1870           v-date1 = today
     1871           v-time  = v-time
     1872         .
     1873       end.
     1874       assign
     1875         p-today = v-date1
     1876         p-time  = v-time
     1877       .
     1878     end.
     1879   end.
     1880   function cur-time-date returns character
     1881   :
     1882     return string(today, '99/99/9999':U) .
     1883   end.
     1884   function cur-time-mjd returns decimal
     1885   :
     1886     define variable v-date as date      no-undo .
     1887     define variable v-time as integer   no-undo .
     1888     run cur-time in this-procedure
     1889       (output v-date
     1890       ,output v-time
     1891       ) .
     1892     return integer(v-date) - 2400002 + (v-time / 86400) .
     1893   end.
     1894   function cur-time-get-ending-index returns integer
     1895   (input p-number as integer
     1896   )
     1897   :
     1898     if p-number < 0
     1899     or p-number = ?
     1900     then do:
     1901       return 1 .
     1902     end.
     1903     define variable v-rest as integer   no-undo .
     1904     assign
     1905       p-number = p-number modulo 100
     1906     .
     1907     if p-number < 20
     1908     then do:
     1909       assign
     1910         v-rest = p-number
     1911       .
     1912     end.
     1913     else do:
     1914       assign
     1915         v-rest = p-number modulo 10
     1916       .
     1917     end.
     1918     case v-rest :
     1919       when 1
     1920       then do:
     1921         return 2 .
     1922       end.
     1923       when 2 or
     1924       when 3 or
     1925       when 4
     1926       then do:
     1927         return 3 .
     1928       end.
     1929       otherwise do:
     1930         return 1 .
     1931       end.
     1932     end case .
     1933   end.
     1934   procedure cur-time-mjd-to-date :
     1935      define input  parameter i-mjd-diff as decimal no-undo.
     1936      define output parameter o-Date     as date    no-undo.
     1937      define output parameter o-Time     as integer no-undo.
     1938      define variable v-day-number as integer   no-undo .
     1939      if    i-mjd-diff < 0
     1940         or i-mjd-diff = ?
     1941      then do:
     1942         return "?" .
     1943      end.
     1944      assign
     1945         v-day-number = truncate(i-mjd-diff,0).
     1946         o-Date = date(v-day-number + 2400002).
     1947         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1948     .
     1949   end.
     1950   function cur-time-mjd-to-string returns character
     1951   (input p-mjd-diff as decimal
     1952   )
     1953   :
     1954     define variable v-day-number as integer   no-undo .
     1955     define variable v-seconds    as integer   no-undo .
     1956     define variable v-hour       as integer   no-undo .
     1957     define variable v-min        as integer   no-undo .
     1958     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1959     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1960     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1961     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1962     if p-mjd-diff < 0
     1963     or p-mjd-diff = ?
     1964     then do:
     1965       return "?" .
     1966     end.
     1967     assign
     1968       v-day-number = integer(truncate(p-mjd-diff,0))
     1969       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1970     .
     1971     if v-seconds > 86400
     1972     then do:
     1973       assign
     1974         v-seconds = 86400 - 1
     1975       .
     1976     end.
     1977     if v-seconds < 0
     1978     then do:
     1979       assign
     1980         v-seconds = 0
     1981       .
     1982     end.
     1983     assign
     1984       v-hour = truncate(v-seconds / 3600, 0)
     1985     .
     1986     assign
     1987       v-seconds = v-seconds modulo 3600
     1988     .
     1989     assign
     1990       v-min = truncate(v-seconds / 60, 0)
     1991     .
     1992     assign
     1993       v-seconds = v-seconds modulo 60
     1994     .
     1995     return
     1996         (if v-day-number <> 0
     1997           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1998           else ""
     1999         )
     2000       + (if v-day-number <> 0 or v-hour <> 0
     2001           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     2002           else ""
     2003         )
     2004       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     2005           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     2006           else ""
     2007         )
     2008       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     2009       .
     2010   end.
     2011   function cur-time-string returns character
     2012   :
     2013     define variable v-date as date      no-undo .
     2014     define variable v-time as integer   no-undo .
     2015     run cur-time in this-procedure
     2016       (output v-date
     2017       ,output v-time
     2018       ) .
     2019     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2020   end.
     2021   function cur-time-string-sec returns character
     2022   :
     2023     define variable v-date as date      no-undo .
     2024     define variable v-time as integer   no-undo .
     2025     run cur-time in this-procedure
     2026       (output v-date
     2027       ,output v-time
     2028       ) .
     2029     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2030   end.
     2031   function cur-time-custom  returns character
     2032   (input p-prefix as character
     2033   ,input p-date-format as character
     2034   ,input p-delimiter as character
     2035   ,input p-time-format as character
     2036   ,input p-suffix as character
     2037   )
     2038   :
     2039     define variable v-date as date      no-undo .
     2040     define variable v-time as integer   no-undo .
     2041     run cur-time in this-procedure
     2042       (output v-date
     2043       ,output v-time
     2044       ) .
     2045     return
     2046       p-prefix
     2047       + string(v-date, p-date-format)
     2048       + p-delimiter
     2049       + string(v-time, p-time-format)
     2050       + p-suffix
     2051       .
     2052   end.
     2053   function cur-time-print  returns character
     2054   :
     2055     define variable v-date as date      no-undo .
     2056     define variable v-time as integer   no-undo .
     2057     run cur-time in this-procedure
     2058       (output v-date
     2059       ,output v-time
     2060       ) .
     2061     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2062   end.
     2063   function cur-time-datetime returns datetime
     2064   :
     2065     define variable v-char as character no-undo .
     2066     define variable v-datetime as datetime no-undo .
     2067     v-char = cur-time-string().
     2068     v-datetime = datetime(v-char).
     2069     return  v-datetime.
     2070   end.
     2071   function cur-time-string-msec returns character
     2072   :
     2073     define variable v-date as datetime  no-undo .
     2074     v-date = now.
     2075     return string(v-date) .
     2076   end.
     2077   define variable vss-include-info26 as character format "X(65)" no-undo
     2078   initial "@(#)$Workfile$ $Revision$".
     2079   procedure xmlchar-test :
     2080   define input parameter p-in-string          as character        no-undo.
     2081   define output parameter p-out-string-enc    as character        no-undo.
     2082   define output parameter p-out-string-dec    as character        no-undo.
     2083   do
     2084   on error undo, return error
     2085   :
     2086          run xmlchar-encode in this-procedure
     2087       (
     2088             input p-in-string
     2089           , output p-out-string-enc
     2090       ).
     2091          run xmlchar-decode in this-procedure
