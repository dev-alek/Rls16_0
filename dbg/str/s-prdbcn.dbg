    13265     if index(dob-curr, ";":U) > 0  and can-do(entry(2,dob-curr,";"),string(i-obj-code)) then do:
    13266       FIND LAST ub.curr-shop WHERE ub.curr-shop.obj-code = i-obj-code
    13267                               and ub.curr-shop.obj-type = 'маг':U
    13268                               and ub.curr-shop.curr-code = int(entry(1,dob-curr,";"))
    13269                               use-index pi NO-ERROR.
    13270       if available ub.curr-shop then curr_cass = ub.curr-shop.exch-rate / curr-shop.exch-scale.
    13271       else do:
    13272         if not g#news then do:
    13273           return error
