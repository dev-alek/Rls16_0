     6233         or v-fact-order = 0 then do:
     6234           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6235         end.
     6236         p-fact-order = v-fact-order .
     6237   end.
     6238     end.
     6239   end procedure.
