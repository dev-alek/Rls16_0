    11155   assign
    11156   ncrdsc = "0":U
    11157   conf-par = "":U
    11158   par-type ="":U
    11159   .
    11160   if std-disc-dec <> 0
    11161   or pos-type = 'NCR-AS@R':U
    11162   then do:
    11163     do ff = 1 to num-entries(ncrgmdsc, ";":U):
    11164       assign
    11165       par-type = entry(ff, ncrgmdsc , ";":U)
    11166       conf-par = entry(2, par-type, "=":U)
    11167       no-error
    11168       .
    11169       if error-status:error then do:
    11170         LEAVE.
    11171       end.
    11172       if conf-par  = string( - std-disc-dec) then do:
    11173         ncrdsc =  entry(1, par-type, "=").
    11174         LEAVE.
    11175       end.
    11176     end.
    11177   end.
    11178   assign
    11179   IBM-good-code = "":U
