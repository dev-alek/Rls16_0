    12828                                       , input fname
    12829                                       , input yes
    12830                                       , input 0
    12831                                       , input no
    12832                                       , input 12
    12833                                       , input 5000
    12834                                       , input v-plu
    12835                                       , input (if v-marketer-action = "U"
    12836                                                 then  string(cash-gds.b-code, "999999999")
    12837                                                 else "000000000")
    12838                                             ).
    12839         run maria-put in this-procedure (
