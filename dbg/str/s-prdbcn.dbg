     1492   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1493   def var vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1494   define temp-table temp-drt-prop no-undo like ub.drt-prop.
     1495   procedure disrules-fill-properties:
     1496   define input  parameter p-templ-rl-root as integer   no-undo .
     1497   define buffer buf_drt-prop for ub.drt-prop.
     1498   define buffer buf_temp-drt-prop for temp-drt-prop.
     1499   do
     1500   on error undo, return error return-value
     1501   :
     1502     for each buf_temp-drt-prop:
     1503       delete buf_temp-drt-prop.
     1504     end.
     1505     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
     1506       create buf_temp-drt-prop.
     1507       buffer-copy buf_drt-prop to buf_temp-drt-prop.
     1508     end.
     1509   end.
     1510   end procedure.
     1511   ~
     1512   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1513   procedure discfgru-check :
     1514   define input parameter p-table-name as character no-undo .
     1515   define input parameter p-templ-rl-root as integer no-undo .
     1516   define input parameter p-time-templ-rl-root as integer no-undo .
     1517   define input parameter p-pos-type as character no-undo .
     1518   define output parameter p-disnct-role as character no-undo .
     1519   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1520     do
     1521     on error undo, return error return-value
     1522     :
     1523       find first buf_dis-cfg-rule no-lock where
     1524               buf_dis-cfg-rule.table-name = p-table-name
     1525           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
     1526           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
     1527           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
     1528       if not available buf_dis-cfg-rule
     1529       or p-pos-type = "":U
     1530       then do:
     1531          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
     1532                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
     1533                                  , p-templ-rl-root
     1534                                  , (if p-time-templ-rl-root = ?
     1535                                     then '':U
     1536                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
     1537                                     )
     1538                                  ).
     1539       end.
     1540       assign
     1541       p-disnct-role = buf_dis-cfg-rule.discnt-role
     1542       .
     1543     end.
     1544   end procedure.
     1545   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1546   FUNCTION get-region RETURNS CHARACTER
     1547     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1548     define variable par-region as character no-undo.
     1549     if parhost-code = 0 and
     1550          parobj-type = "":U and
     1551          parobj-code = 0 then do:
     1552          par-region = "Глобально".
     1553          return par-region.
     1554       end.
     1555       if parobj-type = 'орг':U then do:
     1556          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1557          return par-region.
     1558       end.
     1559       if parobj-type = 'регион':U
     1560       then do:
     1561          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1562          return par-region.
     1563       end.
     1564       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1565       return par-region.
     1566   END FUNCTION.
     1567   FUNCTION get-objregion RETURNS CHARACTER
     1568     (  input parobj-type as character, input parobj-code as integer ) :
     1569     define variable par-region as character no-undo.
     1570     if  parobj-type = "":U and
     1571         parobj-code = 0
     1572     then do:
     1573        par-region = "Глобально".
     1574     end.
     1575     else if parobj-type = 'орг':U
     1576     then do:
     1577        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1578     end.
     1579     else if parobj-type = 'регион':U
     1580     then do:
     1581        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1582     end.
     1583     else
     1584        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1585     return par-region.
     1586   END FUNCTION.
     1587   procedure disgdsru-name :
     1588   define buffer buf_dis-rule for ub.dis-rule.
     1589   do
     1590     on error undo, return error
     1591     :
     1592     define input  parameter p-templ-rl-root  as integer no-undo .
     1593     define output parameter p-label          as character no-undo .
     1594     find first buf_dis-rule no-lock where
     1595               buf_dis-rule.rule-num = p-templ-rl-root no-error.
     1596     if available buf_dis-rule
     1597     then do:
     1598       if buf_dis-rule.rule-num > 0 then
     1599       p-label = buf_dis-rule.des.
     1600     end.
     1601     else do:
     1602       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
     1603     end.
     1604   end.
     1605   end procedure.
     1606   function disgdsru-get-disc-label returns character ( input p-templ-rl-root as integer):
     1607   define variable v-rule-label as character no-undo .
     1608   run disgdsru-name in this-procedure ( input p-templ-rl-root
     1609                                        ,output v-rule-label) no-error.
     1610   return v-rule-label.
     1611   end function.
     1612   function disgdsru-get-disc-role-label returns character ( input p-discnt-role as character):
     1613   define variable v-rule-label as character no-undo .
     1614   return entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
     1615   end function.
     1616   procedure disgdsru-write :
     1617     do
     1618     on error undo, return error
     1619     :
     1620       define input parameter p-obj-type       like ub.dis-gds-rule.obj-type   no-undo .
     1621       define input parameter p-obj-code       like ub.dis-gds-rule.obj-code   no-undo .
     1622       define input parameter p-gds-code       like ub.dis-gds-rule.gds-code   no-undo .
     1623       define input parameter p-pos-type       like ub.dis-gds-rule.pos-type   no-undo .
     1624       define input parameter p-discnt-role    like ub.dis-gds-rule.discnt-role no-undo .
     1625       define input parameter p-templ-rl-root  like ub.dis-gds-rule.templ-rl-root  no-undo .
     1626       define input parameter p-time-templ-rl-root  like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1627       define input parameter p-rule-num       like ub.dis-gds-rule.rule-num    no-undo .
     1628       define input parameter p-nonunique      like ub.dis-gds-rule.nonunique   no-undo .
     1629       define buffer buf_dis-gds-rule for ub.dis-gds-rule .
     1630       define buffer buf_dis-rule for ub.dis-rule.
     1631       define buffer lock_dis-gds-rule for ub.dis-gds-rule .
     1632       define variable v-label          as character no-undo .
     1633       define variable v-discnt-role as character no-undo .
     1634       run discfgru-check in this-procedure (
     1635                                             input 'dis-gds-rule':U
     1636                                            ,input p-templ-rl-root
     1637                                            ,input p-time-templ-rl-root
     1638                                            ,input p-pos-type
     1639                                            ,output v-discnt-role
     1640                                             ) no-error .
     1641       if error-status :error then do:
     1642         undo, return error return-value .
     1643       end.
     1644       if p-discnt-role = ? then do:
     1645         p-discnt-role = v-discnt-role.
     1646       end.
     1647       if p-discnt-role <> v-discnt-role then do:
     1648         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не может быть по шаблону &7 и расписанию &8"
     1649                                 ,p-gds-code
     1650                                 ,p-obj-type
     1651                                 ,p-obj-code
     1652                                 ,p-pos-type
     1653                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1654                                 ,chr(10)
     1655                                 ,p-templ-rl-root
     1656                                 ,p-rule-num).
     1657       end.
     1658       if p-pos-type = ? then do:
     1659   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1660   define variable v-param-type23 as character no-undo .
     1661   define variable v-value-date23 as date no-undo .
     1662   define variable v-value-decimal23 as decimal no-undo .
     1663   define variable v-value-integer23 as INTEGER no-undo .
     1664   define variable v-value-logical23 AS LOGICAL no-undo .
     1665   define variable v-tth23 as handle no-undo .
     1666   run adm/shattri.p (
     1667       input "get":U
     1668       ,input  p-obj-type
     1669       ,input  p-obj-code
     1670       ,input  'cd-sending':U
     1671       ,input  'dflt-cd':U
     1672       ,output p-pos-type
     1673       ,output v-value-date23
     1674       ,output v-value-decimal23
     1675       ,output v-value-integer23
     1676       ,output v-value-logical23
     1677       ,output v-param-type23
     1678       ,INPUT-OUTPUT table-handle v-tth23
     1679       )  .
     1680   delete object v-tth23 no-error.
     1681       end.
     1682       find first buf_dis-rule no-lock where
     1683                 buf_dis-rule.rule-num = p-rule-num no-error.
     1684       if not available buf_Dis-rule then do:
     1685         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не найдено правило скидки &7"
     1686                                 ,p-gds-code
     1687                                 ,p-obj-type
     1688                                 ,p-obj-code
     1689                                 ,p-pos-type
     1690                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1691                                 ,chr(10)
     1692                                 ,p-rule-num).
     1693       end.
     1694       if buf_dis-rule.root <> yes then do:
     1695         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6правило скидки &7 - некорневое"
     1696                                 ,p-gds-code
     1697                                 ,p-obj-type
     1698                                 ,p-obj-code
     1699                                 ,p-pos-type
     1700                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1701                                 ,chr(10)
     1702                                 ,p-rule-num).
     1703       end.
     1704       if not (p-obj-type = buf_dis-rule.obj-type
     1705           and p-obj-code = buf_dis-rule.obj-code)
     1706       and not ( (p-obj-type = 'маг':U or p-obj-type = 'скл':U )
     1707                and
     1708                (buf_dis-rule.obj-type = 'орг':U or buf_dis-rule.obj-type = ""))
     1709        then do:
     1710         undo, return error (substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6"
     1711                                 ,p-gds-code
     1712                                 ,p-obj-type
     1713                                 ,p-obj-code
     1714                                 ,p-pos-type
     1715                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1716                                 ,chr(10)
     1717                                 ) +
     1718                             substitute("Правило скидки &1 определено для &2&3" +
     1719                                        "а привязка к товару для &4"
     1720                                        ,buf_dis-rule.rule-num
     1721                                        ,get-objregion( buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
     1722                                        ,chr(10)
     1723                                        ,get-objregion( p-obj-type, p-obj-code)
     1724                                        ))
     1725                                 .
     1726       end.
     1727       find first buf_dis-gds-rule exclusive-lock where
     1728                  buf_dis-gds-rule.gds-code  = p-gds-code
     1729              AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1730              AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1731              AND buf_dis-gds-rule.pos-type  = p-pos-type
     1732              AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1733              and buf_dis-gds-rule.nonunique = p-nonunique
     1734              no-error .
     1735       if not available buf_dis-gds-rule then do:
     1736         find first buf_dis-gds-rule exclusive-lock where
     1737                   buf_dis-gds-rule.gds-code  = p-gds-code
     1738               AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1739               AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1740               AND buf_dis-gds-rule.pos-type  = p-pos-type
     1741               AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1742               no-error .
     1743         if available buf_Dis-gds-rule then do:
     1744           if p-nonunique = ''
     1745           and available buf_dis-gds-rule
     1746           then do:
     1747             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует (детализ. &3)"
     1748                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1749                                      , p-gds-code
     1750                                      , buf_Dis-rule.obj-type
     1751                                      , buf_Dis-rule.obj-code
     1752                                      , p-nonunique
     1753                                     ).
     1754           end.
     1755           if available buf_dis-gds-rule
     1756           and buf_dis-gds-rule.nonunique = ''
     1757           and p-nonunique <> ''then do:
     1758             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует"
     1759                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1760                                      , p-gds-code
     1761                                      , buf_Dis-rule.obj-type
     1762                                      , buf_Dis-rule.obj-code
     1763                                     ).
     1764           end.
     1765         end.
     1766         create buf_dis-gds-rule .
     1767         assign
     1768         buf_dis-gds-rule.gds-code  = p-gds-code
     1769         buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1770         buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1771         buf_dis-gds-rule.pos-type = p-pos-type
     1772         buf_dis-gds-rule.discnt-role = v-discnt-role
     1773         buf_dis-gds-rule.rule-num = p-rule-num
     1774         buf_dis-gds-rule.nonunique = p-nonunique
     1775         no-error
     1776         .
     1777       end.
     1778       ASSIGN
     1779       buf_dis-gds-rule.rule-num = p-rule-num
     1780       buf_dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1781       buf_dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1782       buf_dis-gds-rule.templ-rl-root = p-templ-rl-root
     1783       buf_dis-gds-rule.nonunique = p-nonunique
     1784       no-error.
     1785     end.
     1786   end procedure.
     1787   PROCEDURE cmp-disgdsru-write :
     1788   do
     1789   on error undo, return error
     1790   :
     1791     define input parameter p-gds-code like ub.dis-gds-rule.gds-code   no-undo .
     1792     define input parameter p-obj-type like ub.dis-gds-rule.obj-type   no-undo .
     1793     define input parameter p-obj-code like ub.dis-gds-rule.obj-code   no-undo .
     1794     define input parameter p-pos-type like ub.dis-gds-rule.pos-type   no-undo .
     1795     define input parameter p-templ-rl-root     like ub.dis-gds-rule.templ-rl-root  no-undo .
     1796     define input parameter p-time-templ-rl-root     like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1797     define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
     1798     define input parameter p-rule-num    like ub.dis-gds-rule.rule-num no-undo .
     1799     define input parameter p-nonunique like ub.dis-gds-rule.nonunique no-undo .
     1800     define variable v-rule-label          as character no-undo .
     1801     define buffer buf_tt0-dis-gds-rule for ub.dis-gds-rule .
     1802     define buffer buf_dis-rule     for ub.dis-rule.
     1803     run disgdsru-name in this-procedure (
     1804                                         input  p-templ-rl-root
     1805                                         ,output v-rule-label
     1806                                         ) no-error .
     1807     if error-status :error then do:
     1808       undo, return error return-value .
     1809     end.
     1810     find first buf_tt0-dis-gds-rule exclusive-lock where
     1811                 buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1812             AND buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1813             AND buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1814             AND buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1815             AND buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1816             AND buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1817             no-error .
     1818     if not available buf_tt0-dis-gds-rule then do:
     1819       create buf_tt0-dis-gds-rule .
     1820       assign
     1821       buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1822       buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1823       buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1824       buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1825       buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1826       buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1827       no-error
     1828       .
     1829     end.
     1830     find first buf_dis-rule no-lock where
     1831               buf_dis-rule.rule-num = p-rule-num.
     1832     ASSIGN
     1833     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1834     buf_tt0-dis-gds-rule.rule-num = p-rule-num
     1835     buf_tt0-dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1836     buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1837     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1838     buf_tt0-dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1839     no-error.
     1840     release buf_tt0-dis-gds-rule no-error .
     1841     if error-status:error then do:
     1842       undo, return error return-value .
     1843     end.
     1844   end.
     1845   END PROCEDURE.
     1846   define variable vss-include-info24 as character format "X(65)" no-undo
     1847   initial "@(#)$Workfile$ $Revision$".
     1848   define variable v-bgelib-bgefmt        as character         no-undo.
