     3027   procedure xml-cd-write-header:
     3028   do
     3029   on error undo, return error
     3030   :
     3031   define input parameter p-xml-file-name       as character    no-undo.
     3032   define input parameter p-xml-file-name-path  as character    no-undo.
     3033   define input parameter p-doc-name            as character    no-undo.
     3034   define input parameter p-version             as character    no-undo.
     3035   define input parameter p-obj-list            as character    no-undo.
     3036   define input parameter p-correspondent       as character    no-undo .
     3037   define input parameter p-write-header        as logical      no-undo .
     3038   define variable OS-time as character no-undo .
     3039   define variable id as character no-undo .
     3040   define buffer buf_db for ub.db.
     3041   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     3042   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     3043   assign
     3044   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     3045   .
     3046   run bgelib-tag-open in this-procedure (
     3047                                        1
     3048                                       ,p-doc-name
     3049                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     3050                                         ).
     3051   if p-write-header then do:
     3052     run bgelib-tag-open(2, "Header","").
     3053     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     3054     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     3055     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     3056     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     3057     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     3058     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     3059     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     3060     find first buf_db where buf_db.db-num = g#db-num no-lock.
     3061     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     3062     run bgelib-tag-close( 2, "Header" ).
     3063   end.
     3064   output stream stmXMLOut close.
     3065   end.
     3066   end procedure.
     3067   procedure xml-cd-write-footer:
     3068   do
     3069   on error undo, return error
     3070   :
     3071   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     3072   define input parameter p-xml-file-name as character    no-undo.
     3073   define input parameter p-doc-name      as character    no-undo .
     3074   define variable v-error-num     as integer           no-undo.
     3075   define variable v-md5-signature as character no-undo .
     3076   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     3077   run bgelib-tag-close( 0, p-doc-name ).
     3078   put stream stmXMLOut unformatted skip.
     3079   output stream stmXMLOut close.
     3080   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     3081   if v-error-num > 0
     3082   then do:
     3083      return error.
     3084   end.
     3085   if opsys = "unix"
     3086   then do:
     3087       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     3088   end.
     3089   end.
     3090   end procedure.
     3091   procedure xml-cd-filename :
     3092   do
     3093   on error undo, return error
     3094   :
     3095   define input parameter  p-out               as character no-undo .
     3096   define output parameter p-xml-file-name     as character    no-undo.
     3097   define output parameter p-xml-file-name-path   as character    no-undo.
     3098   define output parameter p-log-file-name     as character    no-undo.
     3099   define output parameter p-locked            as logical      no-undo.
     3100   define variable v-out as character     no-undo.
     3101   define variable loc#log as logical no-undo .
     3102   define variable BadFlag as logical no-undo .
     3103   define variable fq as integer no-undo .
     3104   define variable v-remote as character no-undo .
     3105   assign
     3106   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     3107   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     3108   p-log-file-name = p-out + "actions.log"
     3109   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     3110   .
     3111   end.
     3112   end procedure.
     3113   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     3114   define variable v-date-str as character no-undo .
     3115   assign
     3116   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     3117                string(Month(p-date), "99":U) + "-":U +
     3118                string(DAY(p-date), "99":U).
     3119   return v-date-str.
     3120   END FUNCTION.
     3121   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     3122   define variable v-date-str as character no-undo .
     3123   assign
     3124   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     3125                string(Month(p-date), "99":U) + "-":U +
     3126                string(DAY(p-date), "99":U) + chr(32) +
     3127                string(p-time, "HH:MM:SS").
     3128   return v-date-str.
     3129   END FUNCTION.
     3130   function string-to-date returns date ( input p-string  as character):
     3131     define variable v-date as date no-undo .
     3132     assign
     3133     v-date = date(integer(substring(p-string, 4, 2))
     3134                   ,integer(substring(p-string, 1, 2))
     3135                   ,integer(substring(p-string, 7, 4))
     3136                  ) no-error .
     3137     if error-status:error then return ?.
     3138     return v-date.
     3139   END FUNCTION.
     3140   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     3141   define variable v-time as integer no-undo init ?.
     3142   define variable v-dop1 as character no-undo .
     3143   define variable v-dop2 as character no-undo .
     3144   assign
     3145   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     3146   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     3147   no-error .
     3148   if error-status:error then return ?.
     3149   assign
     3150   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     3151             integer(entry(2, v-dop2, ";":U)) * 60 +
     3152             integer(entry(3, v-dop2, ";":U)) no-error .
     3153   return v-time.
     3154   END FUNCTION.
     3155   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3156   procedure gdcstcod_cst-code :
     3157     define input  parameter p-obj-type  as character no-undo .
     3158     define input  parameter p-obj-code  as integer   no-undo .
     3159     define input  parameter p-gds-code  as integer   no-undo .
     3160     define input  parameter p-in-code   as character no-undo .
     3161     define input  parameter p-part-code as character no-undo .
     3162     define output parameter p-cst-code  as character no-undo .
     3163     define buffer buf_goods for ub.goods .
     3164     define buffer buf_parts for ub.parts .
     3165     do
     3166     on error undo, return error return-value
     3167     :
     3168       assign
     3169         p-cst-code = ''
     3170       .
     3171       find first buf_goods no-lock
     3172         where buf_goods.gds-code = p-gds-code
     3173         no-error .
     3174       if not available buf_goods
     3175       then do:
     3176         undo, return error substitute("Ошибка задания входных параметров. Не найден товар &1", p-gds-code) .
     3177       end.
     3178       if p-in-code = ?
     3179       then do:
     3180         undo, return error substitute("Ошибка задания входных параметров. Неизвестное значение номера накладной &1", p-in-code) .
     3181       end.
     3182       if p-part-code = ?
     3183       then do:
     3184         undo, return error substitute("Ошибка задания входных параметров. Неизвестное значение номера номера партии &1", p-part-code) .
     3185       end.
     3186       if p-in-code = '':u
     3187       then do:
     3188         find first buf_parts no-lock
     3189           where buf_parts.obj-type  = p-obj-type
     3190             and buf_parts.obj-code  = p-obj-code
     3191             and buf_parts.artic     = buf_goods.artic
     3192             and buf_parts.prod-type = buf_goods.prod-type
     3193             and buf_parts.prod-code = buf_goods.prod-code
     3194             and buf_parts.out-code  = 'free-zone':U
     3195             and buf_parts.status_   = false
     3196           no-error .
     3197         if available buf_parts
     3198         then do:
     3199           assign
     3200             p-cst-code = buf_parts.cst-code
     3201           .
     3202         end.
     3203       end.
     3204       else do:
     3205         find first buf_parts no-lock
     3206           where buf_parts.obj-type  = p-obj-type
     3207             and buf_parts.obj-code  = p-obj-code
     3208             and buf_parts.artic     = buf_goods.artic
     3209             and buf_parts.prod-type = buf_goods.prod-type
     3210             and buf_parts.prod-code = buf_goods.prod-code
     3211             and buf_parts.out-code  = 'free-zone':U
     3212             and buf_parts.in-code   = p-in-code
     3213             and buf_parts.part-code = p-part-code
     3214           no-error .
     3215         if available buf_parts
     3216         then do:
     3217           assign
     3218             p-cst-code = buf_parts.cst-code
     3219           .
     3220         end.
     3221       end.
     3222     end.
     3223   end procedure.
