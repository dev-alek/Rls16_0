     6982   procedure grp-obj-notcorr-value :
     6983   do
     6984   on error undo, return error
     6985   :
     6986   define input parameter p-node-code             as integer      no-undo.
     6987   define input parameter p-obj-type              as character    no-undo.
     6988   define input parameter p-obj-code              as integer      no-undo.
     6989   define output parameter p-notcorr              as character    no-undo init ?.
     6990   define output parameter p-range-notcorr     as integer      no-undo.
     6991   define output parameter p-exists-notcorr    as logical      no-undo.
     6992   define variable v-host-code as integer      no-undo.
     6993   DEFINE VARIABLE v-found as logical no-undo .
     6994   DEFINE VARIABLE v-exists as logical no-undo .
     6995   DEFINE VARIABLE v-range as integer no-undo .
     6996   DEFINE VARIABLE jj as integer no-undo .
     6997   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     6998   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     6999   define buffer buf_gds-grp for ub.gds-grp.
     7000   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     7001   find first buf_gds-grp no-lock where
     7002              buf_gds-grp.node-code = p-node-code no-error .
     7003   if not avail buf_gds-grp and p-node-code <> 0 then do:
     7004     message
     7005       vss-workfile vss-revision vss-description
     7006       skip "Не удалось найти группу товаров с кодом" p-node-code
     7007       view-as alert-box error .
     7008     undo, return error .
     7009   end.
     7010   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7011   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7012     (input  p-obj-type
     7013     ,input  p-obj-code
     7014     ,output v-host-code
     7015     ) no-error .
     7016   if error-status :error
     7017   then do:
     7018       message
     7019         vss-workfile vss-revision vss-description
     7020         skip "Не удалось найти фирму объекта"
     7021         skip p-obj-type p-obj-code
     7022         skip return-value
     7023         skip trim(error-status :get-message(1))
     7024       view-as alert-box error.
     7025       undo, return error .
     7026   end.
     7027   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     7028   do while v-found = no and jj < 2:
     7029     if v-range <> 3 then do:
     7030       find first buf_gds-grp-obj no-lock
     7031           where buf_gds-grp-obj.node-code = p-node-code
     7032             and buf_gds-grp-obj.host-code = v-host-code
     7033             and buf_gds-grp-obj.obj-type  = p-obj-type
     7034             and buf_gds-grp-obj.obj-code  = p-obj-code
     7035       no-error .
     7036     end.
     7037     if v-range = 3 or not available buf_gds-grp-obj
     7038     then do:
     7039        if v-range <> 2 then do:
     7040           find first buf_gds-grp-obj no-lock
     7041               where buf_gds-grp-obj.node-code = p-node-code
     7042                 and buf_gds-grp-obj.host-code = v-host-code
     7043                 and buf_gds-grp-obj.obj-type  = ""
     7044                 and buf_gds-grp-obj.obj-code  = 0
     7045           no-error .
     7046         end.
     7047         if v-range = 2 or not available buf_gds-grp-obj
     7048         then do:
     7049             if v-range <> 1 then do:
     7050               find first buf_gds-grp-obj no-lock
     7051                   where buf_gds-grp-obj.node-code = p-node-code
     7052                   and buf_gds-grp-obj.host-code = 0
     7053                   and buf_gds-grp-obj.obj-type  = ""
     7054                   and buf_gds-grp-obj.obj-code  = 0
     7055               no-error .
     7056             end.
     7057             if v-range = 1 or not available buf_gds-grp-obj
     7058             then do:
     7059                 assign
     7060                     v-exists = no
     7061                 .
     7062             end.
     7063             else do:
     7064                 assign
     7065                     v-exists = yes
     7066                     v-range = 1
     7067                 .
     7068             end.
     7069         end.
     7070         else do:
     7071             assign
     7072                 v-exists = yes
     7073                 v-range  = 2
     7074             .
     7075         end.
     7076     end.
     7077     else do:
     7078         assign
     7079             v-exists = yes
     7080             v-range  = 3
     7081         .
     7082     end.
     7083     if available buf_gds-grp-obj
     7084     then do:
     7085       find first buf_gds-grp-obj-attr no-lock
     7086         where buf_gds-grp-obj-attr.node-code   = p-node-code
     7087           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     7088           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     7089           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     7090           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     7091         no-error .
     7092       if available buf_gds-grp-obj-attr then do:
     7093         assign
     7094           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     7095         .
     7096       end.
     7097       else do:
     7098         assign
     7099           v-notcorr-value = ?
     7100         .
     7101       end.
     7102       assign
     7103       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     7104                           then yes
     7105                           else p-exists-notcorr)
     7106       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     7107                         then v-range
     7108                         else p-range-notcorr
     7109       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     7110                         then v-notcorr-value
     7111                         else p-notcorr
     7112       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     7113       jj = jj + 1
     7114       .
     7115     end.
     7116     else do:
     7117       assign
     7118       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     7119       jj = jj + 1
     7120       .
     7121     end.
     7122   end.
     7123   end.
     7124   end procedure.
