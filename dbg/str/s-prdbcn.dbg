    11082             end.
    11083             else do:
    11084               put unformatted
    11085               ( fill(" " , 16 -  length(cash-gds.b-str)) + cash-gds.b-str )
    11086               '00101'
    11087               caps( string( chk_name, 'x(20)' ) )
    11088               string( ( cash-gds.price-sale * 100 ) ,'999999999999')
    11089               .
    11090               put unformatted
    11091               '000000000000000000000000000'
    11092               string(action, "X(1)")
    11093               fill('0':U , 12)
    11094               string(v-r-b-curr-magia, "9")
    11095               fill('0':U , 104)
    11096               .
    11097               put skip.
    11098             end.
    11099           end.
    11100           else do:
    11101             if cash-gds.b-str = "" then do:
    11102                 assign
    11103                 b_code = string(cash-gds.b-code,'>>>>>>>>>>>>>>>9').
    11104                 run gen-bc(input cash-gds.b-code, output bar_code) no-error.
    11105                 if ((ub.shop.cd-loc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
