     9059                .
     9060              end.
     9061           end.
     9062         end.
     9063       end.
     9064     end.
     9065             end.
     9066             if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
     9067                cash-gds.bc-on-type = 'pglc':U
     9068                then do:
     9069   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
