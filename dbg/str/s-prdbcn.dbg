    12878      if can-find(temp-tekka-tsk where temp-tekka-tsk.task-num = fname and temp-tekka-tsk.obj-num = 6 )
    12879      or can-find(temp-tekka-tsk where temp-tekka-tsk.task-num = fname and temp-tekka-tsk.obj-num = 13 )
    12880      then do:
    12881        v-fields-shift106 = - 1.
    12882   if v-record <> '':U then
    12883       run maria-put in this-procedure (
