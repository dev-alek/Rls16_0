     9865       if available cash-dis-rule then do:
     9866         for each buf_cash-dis-rule no-lock where
     9867                 (cash-dis-rule.is-term = yes
     9868                 and buf_cash-dis-rule.rule-num = cash-gds.temp-discnt-rule)
     9869               or
     9870               buf_cash-dis-rule.upper-rule-num = cash-gds.temp-discnt-rule,
     9871           first cash-dis-time-rule no-lock where
     9872                     cash-dis-time-rule.time-rule-num = buf_cash-dis-rule.time-rule-num:
     9873           if buf_cash-dis-rule.is-term
     9874           and buf_cash-dis-rule.root then do:
     9875           end.
     9876           else do:
     9877             case buf_cash-dis-rule.value-type:
     9878               when integer('1':U) then do:
     9879                 assign
     9880                 temp-disc-dec = - buf_cash-dis-rule.discnt-value
     9881                 .
     9882               end.
     9883               when integer('11':U) then do:
     9884                 find first cash-gds-discnt where
     9885                           cash-gds-discnt.b-code = cash-gds.b-code
     9886                       and  cash-gds-discnt.rule-num = buf_cash-dis-rule.rule-num
     9887                       and cash-gds-discnt.obj-type = 'маг':U
     9888                       and cash-gds-discnt.obj-code = i-obj-code
     9889                       no-error.
     9890                 if available cash-gds-discnt then do:
     9891                   assign
     9892                   temp-disc-dec = - (cash-gds.price-sale - cash-gds-discnt.discnt-value) /  cash-gds.price-sale * 100
     9893                   .
     9894                 end.
     9895                 else do:
     9896                   assign
     9897                   temp-disc-dec = 0.
     9898                 end.
     9899               end.
     9900               otherwise do:
     9901                 temp-disc-dec = 0.
     9902               end.
     9903             end case.
     9904           end.
     9905           assign
     9906           temp-disc-reason = 0
     9907           temp-disc-weekday = 0
     9908           no-error
     9909           .
     9910           assign
     9911           temp-disc-start = cash-dis-time-rule.date-from
     9912           temp-disc-end   = cash-dis-time-rule.date-to
     9913           temp-disc-time-start = (if cash-dis-time-rule.time-from >= 0 then cash-dis-time-rule.time-from else 0)
     9914           temp-disc-time-end = (if cash-dis-time-rule.time-to >= 0 then cash-dis-time-rule.time-to else 0)
     9915           temp-disc-weekday = (if cash-dis-time-rule.week-day-1 then 1 else 0) +
     9916                               (if cash-dis-time-rule.week-day-2 then 2 else 0) +
     9917                               (if cash-dis-time-rule.week-day-3 then 3 else 0) +
     9918                               (if cash-dis-time-rule.week-day-4 then 4 else 0) +
     9919                               (if cash-dis-time-rule.week-day-5 then 5 else 0) +
     9920                               (if cash-dis-time-rule.week-day-6 then 6 else 0) +
     9921                               (if cash-dis-time-rule.week-day-7 then 7 else 0)
     9922           .
     9923           if temp-disc-end <> 12/31/1989 and temp-disc-end < today then
     9924           assign
     9925           temp-disc-dec = 0
     9926           temp-disc-reason = 0
     9927           temp-disc-weekday = 0
     9928           temp-disc-time-start = 0
     9929           temp-disc-time-end = 0
     9930           temp-disc-start = 12/31/1989
     9931           temp-disc-end = 12/31/9999
     9932           .
