     7237   def var vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7238   define temp-table cash-dis-rule no-undo like ub.dis-rule.
     7239   define temp-table cash-dis-time-rule no-undo like ub.dis-time-rule.
     7240   procedure create-dis-rule :
     7241   define input parameter p-rule-num like ub.dis-rule.rule-num no-undo .
     7242   define input parameter p-tree as logical no-undo .
     7243   define buffer buf_dis-rule for ub.dis-rule.
     7244   define buffer buf_dis-time-rule for ub.dis-time-rule.
     7245   define buffer term_dis-rule for ub.dis-rule.
     7246   define buffer term_dis-time-rule for ub.dis-time-rule.
     7247   define buffer root_cash-dis-rule for cash-dis-rule.
     7248   define buffer root_cash-dis-time-rule for cash-dis-time-rule.
     7249   define buffer term_cash-dis-rule for cash-dis-rule.
     7250   define buffer term_cash-dis-time-rule for cash-dis-time-rule.
     7251     do
     7252     on error undo, return error
     7253     :
     7254       find first root_cash-dis-rule no-lock where                                                         ~
     7255                 root_cash-dis-rule.rule-num = p-rule-num no-error.
     7256       if not available root_cash-dis-rule then do:
     7257         find first buf_dis-rule no-lock where
     7258                   buf_dis-rule.rule-num = p-rule-num no-error.
     7259         if available buf_dis-rule then do:
     7260           if buf_dis-rule.time-rule-num <> 0 then do:
     7261             find first buf_dis-time-rule no-lock where
     7262                       buf_dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     7263           end.
     7264           create root_cash-dis-rule.
     7265           buffer-copy buf_dis-rule to root_cash-dis-rule.
     7266           if available buf_dis-time-rule then do:
     7267             find first root_cash-dis-time-rule no-lock where
     7268                       root_cash-dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     7269             if not available root_cash-dis-time-rule then do:
     7270               create root_cash-dis-time-rule.
     7271               buffer-copy buf_dis-time-rule to root_cash-dis-time-rule.
     7272             end.
     7273           end.
     7274           else do:
     7275             assign
     7276             root_cash-dis-rule.time-rule-num = 0.
     7277           end.
     7278           if buf_dis-rule.uniq-field <> "":U then do:
     7279             for each term_dis-rule no-lock where
     7280                     term_dis-rule.upper-rule-num =  buf_dis-rule.rule-num:
     7281               if term_dis-rule.time-rule-num <> 0 then do:
     7282                 find first term_dis-time-rule no-lock where
     7283                           term_dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     7284               end.
     7285               create term_cash-dis-rule.
     7286               buffer-copy term_dis-rule to term_cash-dis-rule.
     7287               if term_dis-rule.time-rule-num = 0
     7288               or available term_dis-time-rule
     7289               or root_cash-dis-rule.time-rule-num = 0
     7290               then do:
     7291                 if available term_dis-time-rule then do:
     7292                   find first term_cash-dis-time-rule no-lock where
     7293                             term_cash-dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     7294                   if not available term_cash-dis-time-rule then do:
     7295                     create term_cash-dis-time-rule.
     7296                     buffer-copy term_dis-time-rule to term_cash-dis-time-rule.
     7297                   end.
     7298                 end.
     7299               end.
     7300             end.
     7301           end.
     7302         end.
     7303       end.
     7304     end.
     7305   end procedure.
     7306   define temp-table temp-cd-plu no-undo like ub.cd-plu .
     7307   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7308   function ncr-amnt-disc returns character (
     7309     input p-pcnt-discnt-rule as integer, input p-price-sale as decimal).
     7310   define variable v-result as character no-undo .
     7311   define variable ii as integer no-undo .
     7312   define variable v-entry as character no-undo extent 3.
     7313   for each cash-dis-rule  no-lock where
     7314         cash-dis-rule.upper-rule-num = p-pcnt-discnt-rule:
     7315     assign
     7316     ii = ii + 1
     7317     v-entry[ii] = "000000":U + string(round(cash-dis-rule.doc-qnty / cash-gds.cli-base-rate, 0), "999999":U) +
     7318                   replace(string(p-price-sale * (1 - cash-dis-rule.discnt-value / 100), "999999.99"), ".":U, "":U)
     7319     .
     7320   end.
     7321   if v-entry[2] = "":U then
     7322   assign
     7323   v-entry[2] = v-entry[1]
     7324   .
     7325   if v-entry[3] = "":U then
     7326   assign
     7327   v-entry[3] = v-entry[2]
     7328   .
     7329   assign
     7330   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7331   .
     7332   return v-result.
     7333   END FUNCTION.
     7334   function ncr-date-disc returns character (
     7335     input p-date-discnt-rule  as integer, input p-price-sale as decimal).
     7336   define variable v-result as character no-undo .
     7337   define variable ii as integer no-undo .
     7338   define variable v-entry as character no-undo extent 3.
     7339   for each cash-dis-rule  no-lock where
     7340         cash-dis-rule.upper-rule-num = p-date-discnt-rule,
     7341       first cash-dis-time-rule no-lock where cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num :
     7342     assign
     7343     ii = ii + 1
     7344     v-entry[ii] =
     7345                   substring(string(year(cash-dis-time-rule.date-from), "9999":U), 3, 2)   +
     7346                   string(month(cash-dis-time-rule.date-from), "99":U) +
     7347                   string(day(cash-dis-time-rule.date-from), "99":U)  +
     7348                   substring(string(year(cash-dis-time-rule.date-to), "9999":U), 3, 2)   +
     7349                   string(month(cash-dis-time-rule.date-to), "99":U) +
     7350                   string(day(cash-dis-time-rule.date-to), "99":U) +
     7351                   replace(string(cash-gds.price-sale * (1 - cash-dis-rule.discnt-value / 100), "999999.99"), ".":U, "":U).
     7352   end.
     7353   if v-entry[2] = "":U then
     7354   assign
     7355   v-entry[2] = v-entry[1]
     7356   .
     7357   if v-entry[3] = "":U then
     7358   assign
     7359   v-entry[3] = v-entry[2]
     7360   .
     7361   assign
     7362   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7363   .
     7364   return v-result.
     7365   END FUNCTION.
     7366   function ncr-temp-disc returns character (
     7367     input p-temp-discnt-rule  as integer, input p-price-sale as decimal, p-temp-disc-dec as decimal).
     7368   define variable v-result as character no-undo .
     7369   define variable ii as integer no-undo .
     7370   define variable v-entry as character no-undo extent 3.
     7371   define variable v-dec as decimal no-undo .
     7372   define variable v-disc-price-sale as decimal no-undo .
     7373   define variable v-pdf-id as integer no-undo .
     7374   define variable v-pdf-db-num as integer no-undo .
     7375   define buffer buf_cash-dis-rule for cash-dis-rule.
     7376   find first buf_cash-dis-rule where
     7377            buf_cash-dis-rule.rule-num = p-temp-discnt-rule no-error .
     7378   if not available buf_cash-dis-rule then return "":U.
     7379   if buf_cash-dis-rule.templ-rl-root <> 29
     7380   and buf_cash-dis-rule.templ-rl-root <> 86
     7381   then do:
     7382     assign
     7383     v-entry[1] =
     7384     "000"                                                   +
     7385     "0"                                                     +
     7386     "0000"                                                  +
     7387     "2359"                                                     +
     7388      replace(string(cash-gds.price-sale * (1 + p-temp-disc-dec / 100), "999999.99"), ".":U, "":U)
     7389      .
     7390   end.
     7391   else do:
     7392     for each cash-dis-rule  no-lock where
     7393           cash-dis-rule.upper-rule-num = p-temp-discnt-rule ,
     7394         first cash-dis-time-rule no-lock where cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num :
     7395       case cash-dis-rule.value-type:
     7396         when integer('1':U) then do:
     7397           v-dec = cash-gds.price-sale * (1 - cash-dis-rule.discnt-value / 100).
     7398         end.
     7399         when integer('12':U) then do:
     7400           find first cash-gds-discnt where
     7401                     cash-gds-discnt.b-code = cash-gds.b-code
     7402                 and cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     7403                 and cash-gds-discnt.obj-type = 'маг':U
     7404                 and cash-gds-discnt.obj-code = i-obj-code
     7405                 no-error.
     7406           if not available cash-gds-discnt then do:
     7407             v-dec = cash-gds.price-sale.
     7408           end.
     7409           else do:
     7410             assign
     7411             v-dec = cash-gds-discnt.discnt-value
     7412             .
     7413           end.
     7414         end.
     7415         otherwise do:
     7416           v-dec = cash-gds.price-sale.
     7417         end.
     7418       end case.
     7419       assign
     7420       ii = ii + 1
     7421       v-entry[ii] =
     7422                     "000"                                                   +
     7423                     (if cash-dis-time-rule.week-day-0 then "0" else "":U)   +
     7424                     (if cash-dis-time-rule.week-day-7 then "1" else "":U)   +
     7425                     (if cash-dis-time-rule.week-day-1 then "2" else "":U)   +
     7426                     (if cash-dis-time-rule.week-day-2 then "3" else "":U)   +
     7427                     (if cash-dis-time-rule.week-day-3 then "4" else "":U)   +
     7428                     (if cash-dis-time-rule.week-day-4 then "5" else "":U)   +
     7429                     (if cash-dis-time-rule.week-day-5 then "6" else "":U)   +
     7430                     (if cash-dis-time-rule.week-day-6 then "7" else "":U)   +
     7431                     replace(string(cash-dis-time-rule.time-from, "HH:MM"), ":":U, "":U) +
     7432                     replace(string(cash-dis-time-rule.time-to, "HH:MM"), ":":U, "":U) +
     7433                     replace(string(v-dec, "999999.99"), ".":U, "":U)
     7434       .
     7435   if ii = 3 then leave.
     7436     end.
     7437   end.
     7438   if v-entry[2] = "":U then
     7439   assign
     7440   v-entry[2] = v-entry[1]
     7441   .
     7442   if v-entry[3] = "":U then
     7443   assign
     7444   v-entry[3] = v-entry[2]
     7445   .
     7446   assign
     7447   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7448   .
     7449   return v-result.
     7450   END FUNCTION.
     7451   function ncr-d-rank returns character (
     7452     input p-d-rank as character, input p-pcnt-discnt-rule  as integer, input p-temp-discnt-rule as integer, input p-date-discnt-rule as integer).
     7453   define variable v-result as character no-undo .
     7454   define variable ii as integer no-undo .
     7455   do ii = 1 to length(p-d-rank):
     7456     CASE substr(p-d-rank, ii, 1):
     7457       when "X":U then do:
     7458         if p-pcnt-discnt-rule <> 0 then v-result = "X":U.
     7459       end.
     7460       when "T":U then do:
     7461         if p-temp-discnt-rule <> 0 then v-result = "T":U.
     7462       end.
     7463       when "D":U then do:
     7464         if p-date-discnt-rule <> 0 then v-result = "D":U.
     7465       end.
     7466     END CASE.
     7467     if v-result <> "":U then LEAVE.
     7468   end.
     7469   if v-result = "":U then v-result = chr(32).
     7470   return v-result.
     7471   END FUNCTION.
     7472   FUNCTION check-ban-sales-via-cd return logical ( input p-gds-code as integer ) :
     7473       define variable v-upper-code as int no-undo.
     7474       define variable v-value as character no-undo.
     7475       define variable v-type as character no-undo.
     7476       define buffer lc_gds-grp for ub.gds-grp.
     7477       define buffer lc_goods for ub.goods.
     7478      if p-gds-code <> 0 then do:
     7479       find first lc_goods where lc_goods.gds-code = p-gds-code.
     7480       v-upper-code = lc_goods.grp-code.
     7481       do while v-upper-code > 0 :
     7482           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     7483           run ggoattr-value(
     7484             input lc_gds-grp.node-code,
     7485             input 0,
     7486             input "",
     7487             input 0,
     7488             input 'ban-sales-via-cd':U,
     7489             output v-value,
     7490             output v-type
     7491           ).
     7492          if v-value = "yes" then
     7493             return true.
     7494          else
     7495          do:
     7496             run ggoattr-value(
     7497                input lc_gds-grp.node-code,
     7498                input shop.host-code,
     7499                input "",
     7500                input 0,
     7501                input 'ban-sales-via-cd':U,
     7502                output v-value,
     7503                output v-type
     7504                ).
     7505             if v-value = "yes" then
     7506                return true.
     7507             else
     7508             do:
     7509                run ggoattr-value(
     7510                   input lc_gds-grp.node-code,
     7511                   input shop.host-code,
     7512                   input 'маг':U,
     7513                   input i-obj-code,
     7514                   input 'ban-sales-via-cd':U,
     7515                   output v-value,
     7516                   output v-type
     7517                   ).
     7518                if v-value = "yes" then
     7519                   return true.
     7520                else v-upper-code = lc_gds-grp.upper-code.
     7521             end .
     7522          end.
     7523         end.
     7524       end.
     7525   end.
     7526   FUNCTION convert-tax-code returns integer
     7527                                             ( input p-rate-code as integer
     7528                                              ,input p-cdtaxlst  as character
     7529                                             ) :
     7530   define variable jj as integer no-undo .
     7531     do jj = 1 to num-entries(p-cdtaxlst, ";"):
     7532       if entry(jj, p-cdtaxlst, ";") begins (string(p-rate-code) + "-") then do:
     7533         return integer(entry(2, entry(jj, p-cdtaxlst, ";"), "-":U)).
     7534       end.
     7535     end.
     7536   END FUNCTION.
     7537   FUNCTION convert-maria-tax-code returns character
     7538                                             ( input p-vat-rate-code as integer
     7539                                              ,input p-slt-rate-code as integer
     7540                                              ,input p-cdtaxlst  as character
     7541                                             ) :
     7542   define variable jj as integer no-undo .
     7543   define variable aa as character no-undo extent 8.
     7544   define variable v-return-value as character no-undo .
     7545     do jj = 1 to 8:
     7546       if jj <= num-entries(p-cdtaxlst, ";") then do:
     7547         if entry(jj, p-cdtaxlst, ";") begins (string(p-vat-rate-code) + "-") then do:
     7548           aa[jj] = '1'.
     7549         end.
     7550         if entry(jj, p-cdtaxlst, ";") begins (string(p-slt-rate-code) + "-") then do:
     7551           aa[jj] = '1'.
     7552         end.
     7553       end.
     7554       if aa[jj] = '':U then aa[jj] = '0'.
     7555       v-return-value = aa[jj] + v-return-value.
     7556     end.
     7557   return v-return-value.
     7558   END FUNCTION.
     7559   FUNCTION convert-maria-tax-code-2 returns integer
     7560                                             ( input p-rate-code as integer
     7561                                              ,input p-cdtaxlst  as character
     7562                                             ) :
     7563   define variable jj as integer no-undo .
     7564   define variable v-return-value as integer no-undo .
     7565     do jj = 1 to num-entries(p-cdtaxlst, ";"):
     7566       if entry(jj, p-cdtaxlst, ";") begins (string(p-rate-code) + "-") then do:
     7567         return jj.
     7568       end.
     7569     end.
     7570   return 0.
     7571   END FUNCTION.
