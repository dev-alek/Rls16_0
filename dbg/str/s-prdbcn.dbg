     8912   define variable iii as integer no-undo .
     8913     do
     8914     on error undo, return error
     8915     :
     8916       if cash-gds.b-str = "" then do:
     8917         assign
     8918         b_code = string(cash-gds.b-code,'>>>>>>>>>>>>9').
     8919         if  LOOKUP( 'вес':U, cash-gds.unit-type ) = 0 or cash-gds.unit-base <> cash-gds.unit-cli then do:
     8920           if ((ub.shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
     8921               (ub.shop.cd-bc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
     8922             RUN gen-bc( input cash-gds.b-code, output bar_code ).
     8923             IBM-good-code  = fill( " ", 13 - length( trim( bar_code ) ) ) + trim( bar_code ).
     8924           end.
     8925           if ((ub.shop.cd-loc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
     8926               (ub.shop.cd-loc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
     8927             IBM-good-code-2 = b_code.
     8928           end.
     8929         end.
     8930       end.
     8931       else do:
     8932         if cash-gds.b-str begins "*" then cash-gds.b-str = left-trim(cash-gds.b-str, "*").
     8933         IBm-good-code = ( if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
     8934                             (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
     8935                              or
     8936                              cash-gds.bc-on-type = 'pglc':U)
     8937                           then string( integer( cash-gds.b-str ), ">>>>>>>>>>>>9" )
     8938                           else string( fill( " ", 13 - length( trim( cash-gds.b-str ) ) ) +
     8939                                       trim( cash-gds.b-str ), "9999999999999" ) ).
     8940          if action <> "D":U then do:
     8941           is-sc = no.
     8942           find first request_prod-bc no-lock where
     8943                     request_prod-bc.b-str = cash-gds.b-str no-error .
     8944           if not avail request_prod-bc then do :
     8945             if mask_s-c <> "" then do :
     8946               iii_ :
     8947               do iii = 1 to num-entries(mask_s-c) :
     8948                 if length(cash-gds.b-str) = (num-entries(entry(iii, mask_s-c), '*') - 1) then do :
     8949                   v-bc-buf = trim(entry(1, entry(iii, mask_s-c), '*') + cash-gds.b-str).
     8950                   find first request_prod-bc no-lock where request_prod-bc.b-str = v-bc-buf no-error .
     8951                   if available request_prod-bc then leave iii_ .
     8952                 end.
     8953               end.
     8954             end.
     8955           end.
     8956           if avail request_prod-bc then do :
     8957             if LOOKUP( 'вес':U, cash-gds.unit-type ) > 0 then do:
     8958   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8959   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     8960     (buffer request_prod-bc
