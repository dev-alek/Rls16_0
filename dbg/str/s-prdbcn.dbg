    11341                                                   ,input (if how-pcnt-kat = 'pcnt-kat-pdf':U then 89 else 33)
    11342                                                   ,input 'time-rule-num':U
    11343                                                   ,input v-kat-discnt
    11344                                                   ) no-error .
    11345       if error-status:error then do:
    11346       end.
    11347     end.
    11348     if IBM-good-code = IBM-good-code-2 then leave do2.
    11349     assign
