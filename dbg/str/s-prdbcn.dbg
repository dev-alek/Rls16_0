     9315         assign
     9316         std-disc-lim = cash-dis-time-rule.date-to
     9317         .
     9318         if std-disc-lim <> 12/31/1989 and std-disc-lim < today then
     9319         assign
     9320         std-disc-dec = 0
     9321         std-disc-reason = 0
     9322         .
     9323         if cash-dis-time-rule.date-to <> 12/31/1989 and cash-dis-time-rule.date-from > today then
     9324         assign
