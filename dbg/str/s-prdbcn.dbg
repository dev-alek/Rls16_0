     9820       run bgelib-tag-put in this-procedure ( input 4, input "ISNoDiscount" ,
     9821                                               input string(if cash-gds.wgd > 0 then wgd-option else 0), input 1 ).
     9822       run bgelib-tag-put in this-procedure ( input 4, input "ISGaz" ,
     9823                                               input string(if cash-gds.is-gas then 1 else 0), input 1 ).
     9824       run bgelib-tag-put in this-procedure ( input 4, input "ISFuelAsUnit" ,
     9825                                               input string(if cash-gds.ptrl-as-good then 1 else 0), input 1 ).
     9826     find first buf_goods-attr where buf_goods-attr.gds-code = cash-gds.gds-code
     9827            and buf_goods-attr.attr-code = "IS18Plus"
