     7611   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7612   PROCEDURE asc-gds.
     7613   DEFINE parameter buffer loc-goods for ub.goods.
     7614   DEFINE parameter buffer loc-bar-code for ub.bar-code.
     7615   DEFINE parameter buffer loc-gds-prt-root for ub.gds-prt.
     7616   DEFINE parameter buffer loc-gds-obj for ub.gds-obj.
     7617   DEFINE parameter buffer loc-price-list for ub.price-list.
     7618   DEFINE parameter buffer loc-units for ub.units.
     7619   DEFINE parameter buffer loc-gds-prt-term for ub.gds-prt.
     7620   DEFINE input parameter loc-prod-bc like ub.prod-bc.b-str.
     7621   DEFINE input parameter loc-bc-on-type like ub.prod-bc.bc-on-type.
     7622   DEFINE input parameter loc-bc-units-cli-type like ub.units.type.
     7623   DEFINE input parameter loc-bc-units-okei like ub.units.okei.
     7624   define input parameter parhost-code like ub.sysconf.host-code no-undo .
     7625   define input parameter parobj-type like ub.clients.obj-type no-undo .
     7626   define input parameter parobj-code like ub.clients.obj-code no-undo .
     7627   define variable v-doc-num like ub.price-list.doc-num no-undo .
     7628   DEFINE VARIABLE vat-value like ub.doc-line.vat-pc no-undo .
     7629   DEFINE VARIABLE slt-value like ub.doc-line.slt-pc no-undo .
     7630   define variable v-disc-price-sale as decimal no-undo .
     7631   define variable v-pdf-id as integer no-undo .
     7632   define variable v-pdf-db-num as integer no-undo .
     7633   define variable v-oss as character no-undo.
     7634   define variable v-gtd as character no-undo .
     7635   define variable v-is-gas as character no-undo .
     7636   define variable v-ban-bonus as character no-undo .
     7637   define variable v-ptrl-as-good as character no-undo .
     7638   define variable v-type as character no-undo .
     7639   define variable disc-b-code as integer no-undo .
     7640   define variable v-main-prt-b-code as integer no-undo .
     7641   define variable IBM-good-code as character no-undo .
     7642   define variable IBM-good-code-2 as character no-undo .
     7643   define variable IBM2-short      as character no-undo .
     7644   define variable v-gds-null-price as character no-undo .
     7645   define variable iii as integer no-undo .
     7646   define variable v-mask-full as character no-undo .
     7647   define variable v-mask-short as character no-undo .
     7648   define variable vKKT as integer no-undo.
     7649   define variable attrValue as character no-undo.
     7650   define variable attrType  as character no-undo.
     7651   DEFine BUFFER BUF_BAR-CODE FOR UB.BAR-CODE.
     7652   define buffer buf_price-list for ub.price-list.
     7653   define buffer buf_price-doc-forming-gds FOR UB.PRICE-doc-forming-gds.
     7654   define buffer buf_temp-dis-gds-rule for temp-dis-gds-rule.
     7655   define buffer main-prt-bar-code  for ub.bar-code.
     7656   define buffer buf_goods-attr for goods-attr.
     7657   define buffer b-code for code.
     7658   if action = "U" then do:
     7659     if loc-bar-code.stts = Integer('79':U) then return.
     7660       for-price = ?.
     7661   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7662   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     7663     (input  'маг':U
     7664     ,input  ub.shop.obj-code
     7665     ,input  loc-bar-code.b-code
     7666     ,input  main-b-code
     7667     ,input  0
     7668     ,output v-doc-num
     7669     ,output for-price
     7670     ,output for-road
     7671     ,output for-excise
     7672     ) no-error .
     7673       if error-status:error then do:
     7674           if g#news
     7675           or g#auto
     7676           or g#esys
     7677           then return error.
     7678           else do:
     7679               error-status:error = no.
     7680               message "Ошибка при определении цены на товар "
     7681                       loc-goods.artic loc-goods.prod-type loc-goods.prod-code
     7682               view-as alert-box ERROR.
     7683               return.
     7684           end.
     7685       end.
     7686       if return-value = "error" then do:
     7687           if for-price = ? then do:
     7688             return.
     7689           end.
     7690           if not g#news
     7691           and not g#auto
     7692           and not g#esys
     7693           then
     7694           message prichina view-as alert-box ERROR.
     7695           return error.
     7696       end.
     7697       else if (for-price = ? or for-price = 0) then do:
     7698         if v-is-restaurant and v-is-null-price  then do:
     7699           assign
     7700           for-price = 0.
     7701         end.
     7702         else do:
     7703           run gds-attr-value in this-procedure  ( input loc-goods.gds-code
     7704                                                  ,input 'null-price':U
     7705                                                  ,output v-gds-null-price
     7706                                                  ,output v-type) no-error.
     7707           if (not logical(v-gds-null-price) and for-price = 0) or for-price = ? then
     7708           return "NEXT".
     7709         end.
     7710       end.
     7711     end.
     7712     else do:
     7713           for-price = 0.
     7714     end.
     7715   for-price = round-m( for-price , rnd-znak ).
     7716   FIND FIRST cash-gds where cash-gds.crf = (cr + 1) No-ERROR.
     7717   start-paket = no.
     7718   if not avail cash-gds then do:
     7719   create cash-gds.
     7720   error-status:error = false.
     7721   end.
     7722   cash-gds.crf = cr + 1.
     7723   cr = cr + 1.
     7724   if loc-bar-code.in-code <> ''
     7725   or loc-bar-code.part-code <> ''
     7726   then do:
     7727     find first main-prt-bar-code no-lock where
     7728               main-prt-bar-code.gds-code = loc-goods.gds-code
     7729           and main-prt-bar-code.node-code = loc-bar-code.node-code
     7730           and main-prt-bar-code.unit-cli = loc-bar-code.unit-cli
     7731           and main-prt-bar-code.part-code = ''
     7732           and main-prt-bar-code.in-code = '' no-error.
     7733     if available main-prt-bar-code then do:
     7734       v-main-prt-b-code = main-prt-bar-code.b-code.
     7735     end.
     7736   end.
     7737   else do:
     7738     v-main-prt-b-code = loc-bar-code.b-code.
     7739   end.
     7740   find first tt-tax no-lock where
     7741              tt-tax.tax-code = vattaxcd no-error .
     7742   do iii = 1 to num-entries(mask_s-c) :
     7743     assign
     7744       v-mask-full  = trim(entry(iii, mask_s-c))
     7745       v-mask-short = entry(1, v-mask-full, "*")
     7746       loc-prod-bc  = trim(loc-prod-bc)
     7747     .
     7748     if length(v-mask-full) = length(loc-prod-bc) and  substring(loc-prod-bc, 1, length(v-mask-short)) = v-mask-short then
     7749       loc-prod-bc = "*" + substring(loc-prod-bc, length(v-mask-short) + 1).
     7750   end.
     7751   define variable vBc-on as logical no-undo.
     7752   if loc-prod-bc ne ?
     7753   then do:
     7754       find first prod-bc where prod-bc.b-code eq loc-bar-code.b-code
     7755                            and prod-bc.b-str  eq loc-prod-bc
     7756                            no-lock no-error.
     7757       if available prod-bc
     7758       then
     7759          vBc-on = prod-bc.bc-on.
     7760       else
     7761          vBc-on = yes.
     7762   end.
     7763   else
     7764      vBc-on = yes.
     7765   run gdsoattr-value in this-procedure (
     7766     'dt-seasons':U,
     7767     loc-goods.gds-code,
     7768     parobj-type,
     7769     parobj-code,
     7770     output attrValue,
     7771     output attrType
     7772   ) no-error.
     7773   if attrValue <> "" then do:
     7774     find first b-code where
     7775                b-code.parent = "DTSeasons"
     7776            and b-code.code   = attrValue
     7777          no-lock no-error.
     7778     v-main-prt-b-code = integer(b-code.code).
     7779   end.
     7780   else release b-code.
     7781   assign
     7782   cash-gds.gds-code = loc-goods.gds-code
     7783   cash-gds.artic = loc-goods.artic
     7784   cash-gds.b-code = loc-bar-code.b-code
     7785   cash-gds.main-prt-b-code = v-main-prt-b-code
     7786   cash-gds.b-str = if loc-prod-bc = ? then "" else loc-prod-bc
     7787   cash-gds.bc-on-type = loc-bc-on-type
     7788   cash-gds.bc-on = vBc-on
     7789   cash-gds.unit-cli = loc-bar-code.unit-cli
     7790   cash-gds.cli-base-rate = loc-bar-code.cli-base-rate
     7791   cash-gds.std-discnt-rule = std-discnt-rule_
     7792   cash-gds.gds-namelong = loc-goods.gds-name
     7793   cash-gds.gds-name = IF nam-2str
     7794                       then if available b-code then b-code.codename else loc-goods.gds-name
     7795                       else (
     7796                             IF nam-artc
     7797                             then loc-goods.artic
     7798                             else if available b-code
     7799                                  then b-code.codename
     7800                                  else (if loc-goods.chk-name <> ""
     7801                                        then loc-goods.chk-name
     7802                                        else loc-goods.gds-name)
     7803                            )
     7804   cash-gds.f-name = if NOT l-empty-scale then loc-gds-prt-term.f-name else ""
     7805   cash-gds.unit-base = loc-goods.unit-base
     7806   cash-gds.grp-code = for-grp-code
     7807   cash-gds.fp = for-fp
     7808   cash-gds.ingredient = loc-goods.struct
     7809   cash-gds.producer = for-producer
     7810   cash-gds.producer-int = for-producer-int
     7811   cash-gds.alpha1     = loc-goods.alpha1.
     7812     run gds-attr-value in this-procedure  ( input cash-gds.gds-code
     7813                                            ,input 'office-type':U
     7814                                            ,output v-oss
     7815                                            ,output v-type) no-error.
     7816   cash-gds.office-type = v-oss.
     7817     run gds-attr-value in this-procedure  ( input cash-gds.gds-code
     7818                                            ,input 'type-method-calc':U
     7819                                            ,output v-oss
     7820                                            ,output v-type) no-error.
     7821   if v-oss <> "" then
     7822     assign
     7823       cash-gds.CalculationMethod = int(entry(1,v-oss,","))
     7824       cash-gds.CalculationMethodRestr = if num-entries(v-oss,",") > 1 then int(entry(2,v-oss,",")) else 0
     7825     .
     7826   else
     7827     assign
     7828       cash-gds.CalculationMethod = 0
     7829       cash-gds.CalculationMethodRestr = 0
     7830     .
     7831   assign
     7832   cash-gds.fact-qnty = for-fact-qnty
     7833   cash-gds.okei = loc-bc-units-okei
     7834   cash-gds.kat-discnt-method = kat-discnt-method_
     7835   cash-gds.temp-discnt-method = temp-discnt-method_
     7836   cash-gds.kat-discnt-rule = (if how-pcnt-kat = 'pcnt-kat-pdf':U
     7837                                then  kat-discnt-rule_pdf
     7838                                else  kat-discnt-rule_)
     7839   cash-gds.date-discnt-rule = date-discnt-rule_
     7840   cash-gds.abs-discnt-rule = abs-discnt-rule_
     7841   cash-gds.tot-discnt-rule = tot-discnt-rule_
     7842   cash-gds.wgd-rule = for-wgd
     7843   cash-gds.gds-stat = ( if lookup( 'вес':U, loc-bc-units-cli-type ) > 0 OR lookup('дро':U, loc-bc-units-cli-type) > 0
     7844                           then 1
     7845                           else 0)
     7846   cash-gds.gds-stat = (if (lookup('топ':U, loc-units.type) > 0 AND lookup('дро':U, loc-units.type) > 0)
     7847                        or for-petrol-purse
     7848                        then (cash-gds.gds-stat + 8)
     7849                        else cash-gds.gds-stat)
     7850   cash-gds.gds-stat = if (loc-goods.gds-type = 'у':U and (cash-gds.gds-stat < 8 or for-petrol-purse))
     7851                       then (cash-gds.gds-stat + 16)
     7852                       else cash-gds.gds-stat
     7853   cash-gds.gds-stat = if cash-gds.fp
     7854                       then (cash-gds.gds-stat + 2)
     7855                       else cash-gds.gds-stat
     7856   cash-gds.gds-stat = if cash-gds.wgd-rule > 0
     7857                       then (cash-gds.gds-stat + 128)
     7858                       else cash-gds.gds-stat
     7859   cash-gds.office = if loc-goods.gds-type = 'у':U then 1 else 0
     7860   cash-gds.temp-discnt-rule = (if how-temp-disc = 'temp-disc-pdf':U
     7861                                then temp-discnt-rule_pdf
     7862                                else temp-discnt-rule_)
     7863   cash-gds.wd-rule = for-wd
     7864   cash-gds.pp = (if for-petrol-purse then 1 else 0)
     7865   cash-gds.need-auth = (if need-auth then 1 else 0)
     7866   cash-gds.price-sale =  for-price
     7867   cash-gds.unit-type = loc-units.type
     7868   cash-gds.unit-cli-type = loc-bc-units-cli-type
     7869   cash-gds.tax-string = tax-string
     7870   cash-gds.new-good = new-good
     7871   cash-gds.rc = recid(loc-goods)
     7872   cash-gds.qnty-discnt-rule = qnty-discnt-rule_
     7873   cash-gds.vat-pc = (if avail tt-tax
     7874                      then tt-tax.rate-value
     7875                      else 0)
     7876   cash-gds.vat-code = (if avail tt-tax
     7877                        then tt-tax.rate-code
     7878                        else ?)
     7879   cash-gds.is-menu  = (if v-is-menu then 1 else 0)
     7880   cash-gds.is-semi-finished = (if v-is-semi-finished then 1 else 0)
     7881   cash-gds.is-modificator = (if v-is-modificator then 1 else 0)
     7882   cash-gds.fbr-grp-code = v-fbr-grp-code
     7883   cash-gds.fbr-grp-code-0 = loc-goods.fbr-grp-code
     7884   cash-gds.DepartID = v-fbr-obj-code
     7885   cash-gds.zp = (if v-is-null-price then 1 else 0)
     7886   cash-gds.node-code = loc-bar-code.node-code
     7887   cash-gds.taracode = for-taracode
     7888   cash-gds.is-main-code = (if cash-gds.b-str = ""
     7889                            and loc-bar-code.in-code = ""
     7890                            and loc-bar-code.part-code = ""
     7891                            and cash-gds.unit-base = cash-gds.unit-cli
     7892                            then yes
     7893                            else no)
     7894   cash-gds.obj-type = parobj-type
     7895   cash-gds.obj-code = parobj-code
     7896   .
     7897   assign
     7898   cash-gds.gds-name1 =   name-2cdf(
     7899                         input name-2cd
     7900                       , input yes
     7901                       , input cod-pcod
     7902                       , input cash-gds.b-code
     7903                       , input loc-goods.gds-code
     7904                       , input loc-goods.artic
     7905                       , input loc-goods.engl-name
     7906                       , input loc-bar-code.in-code
     7907                       , input loc-bar-code.part-code
     7908                       , input parobj-type
     7909                       , input parobj-code
     7910                       , input loc-goods.alpha1
     7911                       , output v-gtd
     7912                       )
     7913   cash-gds.gtd   = v-gtd
     7914   .
     7915   vKKT = 255.
     7916   find first b-code where
     7917              b-code.parent  = "okei-kkt"
     7918          and b-code.code    = string(cash-gds.okei)
     7919          and b-code.status_ = 0
     7920   no-lock no-error.
     7921   if avail b-code then
     7922      vKKT = integer(b-code.CodeName) no-error.
     7923   if error-status:error then vKKT = 255.
     7924   cash-gds.kkt = vKKT.
     7925   if (lookup('топ':U, loc-units.type) > 0 AND lookup('дро':U, loc-units.type) > 0) then do:
     7926      run gds-attr-value in this-procedure  (
     7927                                             input cash-gds.gds-code
     7928                                            ,input 'fuel-type':U
     7929                                            ,output v-is-gas
     7930                                            ,output v-type) no-error.
     7931      run gds-attr-value in this-procedure  (
     7932                                             input cash-gds.gds-code
     7933                                            ,input 'ptrl-as-good':U
     7934                                            ,output v-ptrl-as-good
     7935                                            ,output v-type) no-error.
     7936      assign
     7937      cash-gds.ptrl-as-good = logical(v-ptrl-as-good)
     7938      no-error .
     7939      assign
     7940      cash-gds.is-gas = (v-is-gas = 'metan':U)
     7941      no-error .
     7942      if cash-gds.is-gas then do:
     7943        cash-gds.gds-stat = cash-gds.gds-stat + 64.
     7944      end.
     7945   end.
     7946      run gds-attr-value in this-procedure  (
     7947                                             input cash-gds.gds-code
     7948                                            ,input 'ban-bonus':U
     7949                                            ,output v-ban-bonus
     7950                                            ,output v-type) no-error.
     7951     assign
     7952      cash-gds.wd = int(logical(v-ban-bonus))
     7953      no-error .
     7954   if how-temp-disc = 'temp-disc':U then do:
     7955     case temp-discnt-method_:
     7956       when "" then do:
     7957       end.
     7958       when "bar-code.b-code" then do:
     7959         if loc-bar-code.in-code <> ''
     7960         or loc-bar-code.part-code <> ''
     7961         then do:
     7962           disc-b-code = cash-gds.main-prt-b-code.
     7963         end.
     7964         else do:
     7965           disc-b-code = cash-gds.b-code.
     7966         end.
     7967         find first buf_temp-dis-gds-rule where
     7968                 buf_temp-dis-gds-rule.gds-code = cash-gds.gds-code
     7969             and buf_temp-dis-gds-rule.nonunique = string( disc-b-code) no-error.
     7970         if available buf_temp-dis-gds-rule then do:
     7971             cash-gds.temp-discnt-rule = buf_temp-dis-gds-rule.rule-num.
     7972         end.
     7973       end.
     7974       otherwise do:
     7975         cash-gds.temp-discnt-rule = 0.
     7976       end.
     7977     end.
     7978   end.
     7979   assign
     7980   cash-gds.gds-name1 =   name-2cdf(
     7981                         input name-2cd
     7982                       , input yes
     7983                       , input cod-pcod
     7984                       , input cash-gds.b-code
     7985                       , input loc-goods.gds-code
     7986                       , input loc-goods.artic
     7987                       , input loc-goods.engl-name
     7988                       , input loc-bar-code.in-code
     7989                       , input loc-bar-code.part-code
     7990                       , input parobj-type
     7991                       , input parobj-code
     7992                       , input loc-goods.alpha1
     7993                       , output v-gtd
     7994                       )
     7995   cash-gds.gtd   = v-gtd
     7996   .
     7997   assign
     7998   cash-gds.ean-lz = ''
     7999   cash-gds.ean-rz = ''
     8000   cash-gds.code-short = ''
     8001   .
     8002   run ibm-gdsc in this-procedure (input no
     8003                                 , output cash-gds.ean-lz
     8004                                 , output cash-gds.ean-rz
     8005                                 , output cash-gds.code-short
     8006                                 ) no-error .
     8007   if new-good then new-good = not new-good.
     8008   if action = "U" then do:
     8009     if cash-gds.kat-discnt-rule <> 0
     8010     and how-pcnt-kat = 'pcnt-kat-pdf':U
     8011     then do:
     8012       for each cash-dis-rule no-lock where
     8013             cash-dis-rule.upper-rule-num = cash-gds.kat-discnt-rule
     8014       :
     8015         run mpl-tpl-auto in this-procedure ( input cash-gds.b-code
     8016                                             ,input 'маг':U
     8017                                             ,input i-obj-code
     8018                                             ,input integer(entry(1, cash-dis-rule.charkey_one,"-"))
     8019                                             ,input integer(entry(2, cash-dis-rule.charkey_one,"-"))
     8020                                             ,input ?
     8021                                             ,output v-disc-price-sale
     8022                                             ,output v-pdf-id
     8023                                             ,output v-pdf-db-num ) no-error.
     8024         if error-status:error
     8025         or v-disc-price-sale = 0
     8026         or v-disc-price-sale = ?
     8027         then do:
     8028         end.
     8029         else do:
     8030           find first  cash-gds-discnt where
     8031                     cash-gds-discnt.b-code = cash-gds.b-code
     8032                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8033                   and cash-gds-discnt.obj-type = parobj-type
     8034                   and cash-gds-discnt.obj-code = parobj-code No-ERROR.
     8035           if not available cash-gds-discnt then do:
     8036             find first  cash-gds-discnt where
     8037                       cash-gds-discnt.crf = (crgd + 1) No-ERROR.
     8038             if not available cash-gds-discnt then do:
     8039               create cash-gds-discnt.
     8040               assign
     8041               cash-gds-discnt.crf = crgd + 1.
     8042             end.
     8043             crgd = crgd + 1.
     8044             assign
     8045             cash-gds-discnt.b-code = cash-gds.b-code
     8046             cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8047             cash-gds-discnt.obj-type = parobj-type
     8048             cash-gds-discnt.obj-code = parobj-code
     8049             cash-gds-discnt.discnt-value = v-disc-price-sale
     8050             .
     8051             release cash-gds-discnt.
     8052           end.
     8053         end.
     8054       end.
     8055     end.
     8056     if cash-gds.temp-discnt-rule <> 0
     8057     and how-temp-disc = 'temp-disc-pdf':U
     8058     then do:
     8059       for each cash-dis-rule no-lock where
     8060             (cash-dis-rule.upper-rule-num = cash-gds.temp-discnt-rule
     8061         or cash-dis-rule.rule-num = cash-gds.temp-discnt-rule)
     8062         and cash-dis-rule.is-term = yes
     8063       :
     8064         run mpl-tpl-auto in this-procedure ( input cash-gds.b-code
     8065                                             ,input 'маг':U
     8066                                             ,input i-obj-code
     8067                                             ,input integer(entry(1, cash-dis-rule.charkey_one,"-"))
     8068                                             ,input integer(entry(2, cash-dis-rule.charkey_one,"-"))
     8069                                             ,input ?
     8070                                             ,output v-disc-price-sale
     8071                                             ,output v-pdf-id
     8072                                             ,output v-pdf-db-num ) no-error.
     8073         if error-status:error
     8074         or v-disc-price-sale = 0
     8075         or v-disc-price-sale = ?
     8076         then do:
     8077         end.
     8078         else do:
     8079           find first  cash-gds-discnt where
     8080                     cash-gds-discnt.b-code = cash-gds.b-code
     8081                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8082                   and cash-gds-discnt.obj-type = parobj-type
     8083                   and cash-gds-discnt.obj-code = parobj-code No-ERROR.
     8084           if not available cash-gds-discnt then do:
     8085             find first  cash-gds-discnt where
     8086                       cash-gds-discnt.crf = (crgd + 1) No-ERROR.
     8087             if not available cash-gds-discnt then do:
     8088               create cash-gds-discnt.
     8089               assign
     8090               cash-gds-discnt.crf = crgd + 1.
     8091             end.
     8092             crgd = crgd + 1.
     8093             assign
     8094             cash-gds-discnt.b-code = cash-gds.b-code
     8095             cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8096             cash-gds-discnt.obj-type = parobj-type
     8097             cash-gds-discnt.obj-code = parobj-code
     8098             cash-gds-discnt.discnt-value = v-disc-price-sale.
     8099             release cash-gds-discnt.
     8100           end.
     8101         end.
     8102       end.
     8103     end.
     8104   end.
     8105   END PROCEDURE.
