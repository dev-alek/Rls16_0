    11300         chr(32)
    11301         "D":U
    11302         chr(32)
    11303         IBM-good-code
    11304         chr(32)
    11305         chr(32)
    11306         ncr-disc-string
    11307         chr(10)
    11308         .
    11309       end.
    11310       if conf-par = "X":U then do:
