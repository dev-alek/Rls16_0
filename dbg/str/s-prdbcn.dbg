     2098   procedure xmlchar-encode :
     2099   define input parameter p-in-string      as character        no-undo.
     2100   define output parameter p-out-string    as character        no-undo.
     2101       define variable v-position      as integer      no-undo.
     2102       define variable v-current-char  as character    no-undo.
     2103   do
     2104   on error undo, return error
     2105   :
     2106       assign
     2107           p-out-string = "":U
     2108       .
     2109       case p-in-string
     2110       :
     2111           when ?
     2112           then do:
     2113               assign
     2114                   p-out-string = "?":U
     2115               .
     2116           end.
     2117           when "?":U
     2118           then do:
     2119               assign
     2120                   p-out-string = "&#63;":U
     2121               .
     2122           end.
     2123           otherwise do:
     2124               do v-position = 1 to length( p-in-string )
     2125               :
     2126                   assign
     2127                       v-current-char = substring( p-in-string, v-position, 1 )
     2128                   .
     2129                   case v-current-char
     2130                   :
     2131                       when "&":U
     2132                       then do:
     2133                           assign
     2134                               p-out-string = p-out-string + "&amp;":U
     2135                           .
     2136                       end.
     2137                       when ">":U
     2138                       then do:
     2139                           assign
     2140                               p-out-string = p-out-string + "&gt;":U
     2141                           .
     2142                       end.
     2143                       when "<":U
     2144                       then do:
     2145                           assign
     2146                               p-out-string = p-out-string + "&lt;":U
     2147                           .
     2148                       end.
     2149                       when "'":U
     2150                       then do:
     2151                           assign
     2152                               p-out-string = p-out-string + "&apos;":U
     2153                           .
     2154                       end.
     2155                       when '"':U
     2156                       then do:
     2157                           assign
     2158                               p-out-string = p-out-string + "&quot;":U
     2159                           .
     2160                       end.
     2161                       when chr(1)
     2162                       then do:
     2163                           assign
     2164                               p-out-string = p-out-string + "":U
     2165                           .
     2166                       end.
     2167                       when chr(2)
     2168                       then do:
     2169                           assign
     2170                               p-out-string = p-out-string + "":U
     2171                           .
     2172                       end.
     2173                       when chr(3)
     2174                       then do:
     2175                           assign
     2176                               p-out-string = p-out-string + "":U
     2177                           .
     2178                       end.
     2179                       when chr(4)
     2180                       then do:
     2181                           assign
     2182                               p-out-string = p-out-string + "":U
     2183                           .
     2184                       end.
     2185                       when chr(5)
     2186                       then do:
     2187                           assign
     2188                               p-out-string = p-out-string + "":U
     2189                           .
     2190                       end.
     2191                       when chr(6)
     2192                       then do:
     2193                           assign
     2194                               p-out-string = p-out-string + "":U
     2195                           .
     2196                       end.
     2197                       when chr(7)
     2198                       then do:
     2199                           assign
     2200                               p-out-string = p-out-string + "":U
     2201                           .
     2202                       end.
     2203                       when chr(8)
     2204                       then do:
     2205                           assign
     2206                               p-out-string = p-out-string + "":U
     2207                           .
     2208                       end.
     2209                       when chr(9)
     2210                       then do:
     2211                           assign
     2212                               p-out-string = p-out-string + "":U
     2213                           .
     2214                       end.
     2215                       when chr(29)
     2216                       then do:
     2217                           assign
     2218                               p-out-string = p-out-string + "":U
     2219                           .
     2220                       end.
     2221                       when chr(10)
     2222                       then do:
     2223                           assign
     2224                               p-out-string = p-out-string + "&#10;":U
     2225                           .
     2226                       end.
     2227                       when chr(13)
     2228                       then do:
     2229                           assign
     2230                               p-out-string = p-out-string + "&#13;":U
     2231                           .
     2232                       end.
     2233                       otherwise do:
     2234                           assign
     2235                               p-out-string = p-out-string + v-current-char
     2236                           .
     2237                       end.
     2238                   end case.
     2239               end.
     2240           end.
     2241       end case.
     2242   end.
     2243   end .
     2244   procedure xmlchar-encode-1c :
     2245   define input parameter p-in-string      as character        no-undo.
     2246   define output parameter p-out-string    as character        no-undo.
     2247       define variable v-position      as integer      no-undo.
     2248       define variable v-current-char  as character    no-undo.
     2249   do
     2250   on error undo, return error
     2251   :
     2252       assign
     2253           p-out-string = "":U
     2254       .
     2255       case p-in-string
     2256       :
     2257           when ?
     2258           then do:
     2259               assign
     2260                   p-out-string = "?":U
     2261               .
     2262           end.
     2263           otherwise do:
     2264               do v-position = 1 to length( p-in-string )
     2265               :
     2266                   assign
     2267                       v-current-char = substring( p-in-string, v-position, 1 )
     2268                   .
     2269                   case v-current-char
     2270                   :
     2271                       when chr(1)
     2272                       then do:
     2273                           assign
     2274                               p-out-string = p-out-string + " ":U
     2275                           .
     2276                       end.
     2277                       when chr(2)
     2278                       then do:
     2279                           assign
     2280                               p-out-string = p-out-string + " ":U
     2281                           .
     2282                       end.
     2283                       when chr(3)
     2284                       then do:
     2285                           assign
     2286                               p-out-string = p-out-string + " ":U
     2287                           .
     2288                       end.
     2289                       when chr(4)
     2290                       then do:
     2291                           assign
     2292                               p-out-string = p-out-string + " ":U
     2293                           .
     2294                       end.
     2295                       when chr(5)
     2296                       then do:
     2297                           assign
     2298                               p-out-string = p-out-string + " ":U
     2299                           .
     2300                       end.
     2301                       when chr(6)
     2302                       then do:
     2303                           assign
     2304                               p-out-string = p-out-string + " ":U
     2305                           .
     2306                       end.
     2307                       when chr(7)
     2308                       then do:
     2309                           assign
     2310                               p-out-string = p-out-string + " ":U
     2311                           .
     2312                       end.
     2313                       when chr(8)
     2314                       then do:
     2315                           assign
     2316                               p-out-string = p-out-string + " ":U
     2317                           .
     2318                       end.
     2319                       when chr(9)
     2320                       then do:
     2321                           assign
     2322                               p-out-string = p-out-string + " ":U
     2323                           .
     2324                       end.
     2325                       when chr(29)
     2326                       then do:
     2327                           assign
     2328                               p-out-string = p-out-string + " ":U
     2329                           .
     2330                       end.
     2331                       when chr(10)
     2332                       then do:
     2333                           assign
     2334                               p-out-string = p-out-string + " ":U
     2335                           .
     2336                       end.
     2337                       when chr(13)
     2338                       then do:
     2339                           assign
     2340                               p-out-string = p-out-string + " ":U
     2341                           .
     2342                       end.
     2343                       otherwise do:
     2344                           assign
     2345                               p-out-string = p-out-string + v-current-char
     2346                           .
     2347                       end.
     2348                   end case.
     2349               end.
     2350           end.
     2351       end case.
     2352   end.
     2353   end .
     2354   procedure xmlchar-decode :
     2355   define input parameter p-in-string      as character        no-undo.
     2356   define output parameter p-out-string    as character        no-undo.
     2357       define variable v-position      as integer      no-undo.
     2358       define variable v-last-position as integer      no-undo.
     2359       define variable v-temp-integer  as integer      no-undo.
     2360       define variable v-current-char  as character    no-undo.
     2361       define variable v-next-char     as character    no-undo.
     2362       define variable v-success       as logical      no-undo.
     2363   do
     2364   on error undo, return error
     2365   :
     2366       assign
     2367           p-out-string = "":U
     2368           v-position   = 0
     2369       .
     2370       replace-cycle:
     2371       do while yes
     2372       on error undo, return error
     2373       :
     2374           assign
     2375               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     2376           .
     2377           if v-last-position <= v-position
     2378           then do:
     2379               if v-position = 0
     2380               then do:
     2381                   assign
     2382                       p-out-string = p-in-string
     2383                   .
     2384               end.
     2385               else do:
     2386                   assign
     2387                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     2388                   .
     2389               end.
     2390               leave replace-cycle.
     2391           end.
     2392           else do:
     2393               assign
     2394                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     2395                   v-position      = v-last-position
     2396                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     2397               .
     2398               if v-current-char = "#":U
     2399               then do:
     2400                   assign
     2401                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     2402                   .
     2403                   if v-last-position > 0
     2404                   then do:
     2405                       run xmlchar-read-integer in this-procedure
     2406                        (
     2407                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     2408                           , output v-temp-integer
     2409                           , output v-success
     2410                       ).
     2411                       if v-success = yes
     2412                       and v-temp-integer >= 1
     2413                       and v-temp-integer <= 255
     2414                       then do:
     2415                           assign
     2416                               p-out-string = p-out-string + chr( v-temp-integer )
     2417                               v-position   = v-last-position + 1
     2418                           .
     2419                       end.
     2420                       else do:
     2421                           assign
     2422                               p-out-string = p-out-string + "&":U
     2423                               v-position   = v-position   + 1
     2424                           .
     2425                       end.
     2426                   end.
     2427                   else do:
     2428                       assign
     2429                           p-out-string = p-out-string + "&":U
     2430                           v-position   = v-position   + 1
     2431                       .
     2432                   end.
     2433               end.
     2434               else do:
     2435                   case substring( p-in-string, v-position + 1, 3 )
     2436                   :
     2437                       when "lt;":U
     2438                       then do:
     2439                           assign
     2440                               p-out-string = p-out-string + "<":U
     2441                               v-position   = v-position   + 3
     2442                           .
     2443                       end.
     2444                       when "gt;":U
     2445                       then do:
     2446                           assign
     2447                               p-out-string = p-out-string + ">":U
     2448                               v-position   = v-position   + 3
     2449                           .
     2450                       end.
     2451                       otherwise do:
     2452                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     2453                           then do:
     2454                               assign
     2455                                   p-out-string = p-out-string + "&":U
     2456                                   v-position   = v-position   + 4
     2457                               .
     2458                           end.
     2459                           else do:
     2460                               case substring( p-in-string, v-position + 1, 5 )
     2461                               :
     2462                                   when "quot;":U
     2463                                   then do:
     2464                                       assign
     2465                                           p-out-string = p-out-string + '"':U
     2466                                           v-position   = v-position   + 5
     2467                                       .
     2468                                   end.
     2469                                   when "apos;":U
     2470                                   then do:
     2471                                       assign
     2472                                           p-out-string = p-out-string + "'":U
     2473                                           v-position   = v-position   + 5
     2474                                       .
     2475                                   end.
     2476                                   otherwise do:
     2477                                       assign
     2478                                           p-out-string = p-out-string + "&":U
     2479                                       .
     2480                                   end.
     2481                               end case.
     2482                           end.
     2483                       end.
     2484                   end case.
     2485               end.
     2486           end.
     2487       end.
     2488   end.
     2489   end .
     2490   procedure xmlchar-read-integer :
     2491   define input parameter p-input-string      as character        no-undo.
     2492   define output parameter p-output-integer   as integer          no-undo.
     2493   define output parameter p-success       as logical          no-undo.
     2494   do
     2495   on error undo, return error
     2496   :
     2497       assign
     2498           p-output-integer = integer( p-input-string )
     2499       no-error.
     2500       if error-status :error
     2501       then do:
     2502           assign
     2503               p-success           = no
     2504               p-output-integer    = 0
     2505           .
     2506       end.
     2507       else do:
     2508           assign
     2509               p-success           = yes
     2510           .
     2511       end.
     2512   end.
     2513   end.
     2514   define variable v-bgelib-bgeclall           as logical      no-undo.
     2515   define variable v-bgelib-bgedict            as logical      no-undo.
     2516   define temp-table temp_ext-doc-type no-undo
     2517       field edt-key               as integer
     2518       field ext-doc-type          as character
     2519       field ext-doc-type-label    as character
     2520       index pi is primary unique
     2521           edt-key
     2522   .
     2523   define temp-table temp_bgelib_goods no-undo
     2524       field gds-code as integer
     2525       index pi is primary unique
     2526           gds-code
     2527   .
     2528   define temp-table temp_bgelib_clients no-undo
     2529       field obj-type as character
     2530       field obj-code as integer
     2531       index pi is primary unique
     2532           obj-type
     2533           obj-code
     2534   .
     2535   define temp-table temp_bgelib_dis-card no-undo
     2536       field d-card as character
     2537       index pi is primary unique
     2538           d-card
     2539   .
     2540   define temp-table temp_bgelib_trn-doc no-undo
     2541       field doc-code as integer
     2542   .
     2543   procedure bgelib-tag-open:
     2544   do
     2545   on error undo, return error
     2546   :
     2547   define input parameter v-tag-level  as integer      no-undo.
     2548   define input parameter v-tag-name   as character    no-undo.
     2549   define input parameter v-tag-value  as character    no-undo.
     2550       put stream stmXMLOut unformatted
     2551           chr(10)
     2552           + fill(" ", 4 * v-tag-level)
     2553           + "<" + v-tag-name
     2554           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
     2555           + v-tag-value + ">"
     2556       .
     2557   end.
     2558   end procedure.
     2559   procedure bgelib-tag-put:
     2560   do
     2561   on error undo, return error
     2562   :
     2563   define input parameter v-tag-level      as integer      no-undo.
     2564   define input parameter v-tag-name       as character    no-undo.
     2565   define input parameter v-tag-value      as character    no-undo.
     2566   define input parameter v-empty-mode     as integer      no-undo.
     2567       v-tag-name = trim(v-tag-name).
     2568       if  v-empty-mode = 1
     2569       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
     2570       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
     2571       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
     2572       then do:
     2573           run xmlchar-encode in this-procedure (
     2574                 input v-tag-value
     2575               , output v-tag-value
     2576           ).
     2577           put stream stmXMLOut unformatted
     2578               chr(10) + fill(" ", 4 * v-tag-level)
     2579                           + '<' + v-tag-name + '>'
     2580                           + v-tag-value
     2581                           + '</' + v-tag-name + '>'
     2582           .
     2583       end.
     2584   end.
     2585   end procedure.
     2586   procedure bgelib-tag-close:
     2587   do
     2588   on error undo, return error
     2589   :
     2590   define input parameter v-tag-level as integer      no-undo.
     2591   define input parameter v-tag-name  as character    no-undo.
     2592       put stream stmXMLOut unformatted
     2593           chr(10)
     2594           + fill( " ", 4 * v-tag-level)
     2595           + '</' + v-tag-name + '>'
     2596       .
     2597   end.
     2598   end procedure.
     2599   procedure bgelib-write-log:
     2600   do
     2601   on error undo, return error
     2602   :
     2603   define input parameter v-filename   as character    no-undo.
     2604   define input parameter v-log-level  as integer      no-undo.
     2605   define input parameter v-out-string as character    no-undo.
     2606       output stream stmXMLLog to value( v-filename ) append.
     2607       put stream stmXMLLog unformatted
     2608           chr(10)
     2609       .
     2610       put stream stmXMLLog unformatted
     2611           ( if v-log-level = 0
     2612             or v-out-string = "&DLine"
     2613             or v-out-string = "&Line"
     2614             then ""
     2615             else cur-time-string-sec() + " " )
     2616       .
     2617       put stream stmXMLLog unformatted
     2618           ( if v-out-string = "&Line"
     2619             then fill( "-", 80 )
     2620             else if v-out-string = "&DLine"
     2621                  then fill( "=", 80 )
     2622                  else v-out-string )
     2623       .
     2624       output stream stmXMLLog close.
     2625   end.
     2626   end procedure.
     2627   procedure bgelib-write-edt:
     2628   do
     2629   on error undo, return error
     2630   :
     2631   define input parameter v-editor-handle    as handle       no-undo.
     2632   define input parameter v-log-level        as integer      no-undo.
     2633   define input parameter v-out-string       as character    no-undo.
     2634       if valid-handle ( v-editor-handle )
     2635       then do:
     2636           v-editor-handle :move-to-eof().
     2637           v-editor-handle :insert-string( ( if v-log-level = 0
     2638                                             or v-out-string = "&DLine"
     2639                                             or v-out-string = "&Line"
     2640                                             then ""
     2641                                             else cur-time-string-sec() + " "
     2642                                         ) ).
     2643           v-editor-handle :insert-string( ( if v-out-string = "&Line"
     2644                                             then fill( "-", 80 )
     2645                                             else if v-out-string = "&DLine" then fill("=", 80)
     2646                                             else fill( " ", v-log-level) + v-out-string
     2647                                         ) ).
     2648           v-editor-handle :insert-string( chr(10) ).
     2649       end.
     2650       process events.
     2651       output to 'bgescn.txt' append.
     2652           put unformatted
     2653               chr(10)
     2654               string( ( if v-log-level = 0
     2655                         or v-out-string = "&DLine"
     2656                         or v-out-string = "&Line"
     2657                         then ""
     2658                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
     2659                     ) )
     2660               string( ( if v-out-string = "&Line"
     2661                         then fill( "-", 80 )
     2662                         else if v-out-string = "&DLine"
     2663                              then fill( "=", 80 )
     2664                              else fill( " ", v-log-level ) + v-out-string
     2665                     ) )
     2666           .
     2667       output close.
     2668   end.
     2669   end procedure.
     2670   procedure bgelib-show-cnt:
     2671   do
     2672   on error undo, return error
     2673   :
     2674   define input parameter v-fillin-handle     as handle   no-undo.
     2675       if valid-handle( v-fillin-handle )
     2676       then do:
     2677           assign
     2678               v-fillin-handle :visible = true
     2679           .
     2680       end.
     2681   end.
     2682   end procedure.
     2683   procedure bgelib-hide-cnt:
     2684   do
     2685   on error undo, return error
     2686   :
     2687   define input parameter v-fillin-handle     as handle   no-undo.
     2688       if valid-handle( v-fillin-handle )
     2689       then do:
     2690           assign v-fillin-handle :visible = false.
     2691       end.
     2692   end.
     2693   end procedure.
     2694   procedure bgelib-write-cnt:
     2695   do
     2696   on error undo, return error
     2697   :
     2698   define input parameter v-fillin-handle    as handle       no-undo.
     2699   define input parameter v-fillin-string    as character    no-undo.
     2700       if valid-handle( v-fillin-handle )
     2701       then do:
     2702           assign
     2703               v-fillin-handle :SCREEN-value = v-fillin-string
     2704           .
     2705       end.
     2706   end.
     2707   end procedure.
     2708   procedure bgelib-write-header:
     2709   do
     2710   on error undo, return error
     2711   :
     2712   define input parameter p-first-file     as logical      no-undo.
     2713   define input parameter p-xml-file-name  as character    no-undo.
     2714   define input parameter p-list-file-name as character    no-undo.
     2715   define input parameter p-file-number    as integer      no-undo.
     2716   define input parameter p-have-prev      as logical      no-undo.
     2717   define input parameter p-prev-filename  as character    no-undo.
     2718   define input parameter p-obj-list       as character    no-undo.
     2719   define input parameter p-doc-type-list  as character    no-undo.
     2720   define input parameter p-parameter-list as character    no-undo.
     2721       define variable v-counter    as integer        no-undo.
     2722       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2723       put stream stmXMLOut unformatted
     2724           "<?xml version='1.0' encoding='windows-1251'?>"
     2725       .
     2726       run bgelib-tag-open( input 0, input "root"  , input "" ).
     2727       run bgelib-tag-open( input 0, input "header", input "" ).
     2728       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2729       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     2730       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     2731       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     2732       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     2733       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     2734       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2735       :
     2736           run bgelib-tag-put(
     2737                 input 1
     2738               , input entry( 2 * v-counter, p-parameter-list )
     2739               , input entry( 2 * v-counter + 1, p-parameter-list )
     2740               , input 0
     2741           ).
     2742       end.
     2743       run bgelib-tag-close( input 0, input "header" ).
     2744       output stream stmXMLOut close.
     2745       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2746       if p-first-file = yes
     2747       then do:
     2748           put stream stmXMLOut unformatted
     2749               "<?xml version='1.0' encoding='windows-1251'?>"
     2750           .
     2751           run bgelib-tag-open( input 0, input "export", input "" ).
     2752       end.
     2753       run bgelib-tag-open( input 1, input "file", input "" ).
     2754       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2755       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     2756       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     2757       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     2758       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     2759       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     2760       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2761       :
     2762           run bgelib-tag-put(
     2763                 input 2
     2764               , input trim(entry( 2 * v-counter, p-parameter-list ))
     2765               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     2766               , input 0
     2767           ).
     2768       end.
     2769       run bgelib-tag-close( input 1, input "file" ).
     2770       output stream stmXMLOut close.
     2771   end.
     2772   end procedure.
     2773   procedure bgelib-write-footer:
     2774   do
     2775   on error undo, return error
     2776   :
     2777   define input parameter p-last-file      as logical      no-undo.
     2778   define input parameter p-xml-file-name  as character    no-undo.
     2779   define input parameter p-list-file-name as character    no-undo.
     2780   define input parameter p-have-next      as logical      no-undo.
     2781   define input parameter p-next-file-name as character    no-undo.
     2782       define variable v-error-num     as integer           no-undo.
     2783       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2784       if p-have-next = yes
     2785       then do:
     2786           run bgelib-tag-open( input 0, input "footer", "" ).
     2787           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     2788           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     2789           run bgelib-tag-close( input 0, input "footer" ).
     2790       end.
     2791       run bgelib-tag-close( input 0, input "root" ).
     2792       output stream stmXMLOut close.
     2793       run bge/os_copy.p (
     2794             input "M"
     2795           , input p-xml-file-name + "tmp"
     2796           , input p-xml-file-name + "xml"
     2797           , output v-error-num
     2798       ).
     2799       if p-last-file = yes
     2800       then do:
     2801           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2802               run bgelib-tag-close( input 0, input "export" ).
     2803           output stream stmXMLOut close.
     2804           run bge/os_copy.p (
     2805                 input "M"
     2806               , input p-list-file-name + "tmp"
     2807               , input p-list-file-name + "xml"
     2808               , output v-error-num
     2809           ).
     2810       end.
     2811   end.
     2812   end procedure.
     2813   procedure bgelib-filename :
     2814   do
     2815   on error undo, return error
     2816   :
     2817   define input parameter p-prefix             as character    no-undo.
     2818   define output parameter p-xml-file-name     as character    no-undo.
     2819   define output parameter p-log-file-name     as character    no-undo.
     2820   define output parameter p-list-file-name    as character    no-undo.
     2821       define variable v-home-dir  as character    no-undo.
     2822       define variable v-error-num as integer      no-undo.
     2823       get-key-value section "BGE" key "outdir" value v-home-dir.
     2824       if v-home-dir = ?
     2825       then do:
     2826           message
     2827             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2828             skip(1)
     2829             skip "Обратитесь к администратору."
     2830           view-as alert-box error.
     2831           undo, return error .
     2832       end.
     2833       run gbl/dir-cre.p (
     2834           input v-home-dir
     2835       ) no-error.
     2836       if error-status :error
     2837       then do:
     2838           message
     2839             skip "Неверно задан каталог экспорта."
     2840             skip(1)
     2841             skip "Обратитесь к администратору."
     2842           view-as alert-box error.
     2843           undo, return error .
     2844       end.
     2845       run bge/genfname.p (
     2846             input v-home-dir
     2847           , input p-prefix
     2848           , input ""
     2849           , input "xml"
     2850           , input "tmp"
     2851           , output p-xml-file-name
     2852       ).
     2853       assign
     2854           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2855           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     2856           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     2857       .
     2858   end.
     2859   end procedure.
     2860   procedure bgelib-read-config :
     2861   do
     2862   on error undo, return error
     2863   :
     2864   define variable v-par-type as character     no-undo.
     2865     define variable v-param-type      as character  no-undo .
     2866     define variable v-value-character as character  no-undo .
     2867     define variable v-value-date      as date       no-undo .
     2868     define variable v-value-decimal   as decimal    no-undo .
     2869     define variable v-value-integer   as integer    no-undo .
     2870     define variable v-value-logical   as logical    no-undo .
     2871     define variable v-tth             as handle     no-undo .
     2872       assign
     2873           v-bgelib-bgeclall = no
     2874           v-bgelib-bgedict  = no
     2875       .
     2876       run adm/shattri.p ( input "get":U
     2877                         , input  '':u
     2878                         , input  0
     2879                         , input  'bge-export':U
     2880                         , input  'bgeclall':U
     2881                         , output v-value-character
     2882                         , output v-value-date
     2883                         , output v-value-decimal
     2884                         , output v-value-integer
     2885                         , output v-value-logical
     2886                         , output v-param-type
     2887                         , input-output table-handle v-tth
     2888                         ) no-error .
     2889       if error-status :error
     2890       then do:
     2891         assign
     2892           v-bgelib-bgeclall = no
     2893         .
     2894       end.
     2895       else do:
     2896         assign
     2897           v-bgelib-bgeclall = v-value-logical
     2898         .
     2899       end.
     2900       delete object v-tth.
     2901       run adm/shattri.p ( input "get":U
     2902                         , input  '':u
     2903                         , input  0
     2904                         , input  'bge-export':U
     2905                         , input  'bgedict':U
     2906                         , output v-value-character
     2907                         , output v-value-date
     2908                         , output v-value-decimal
     2909                         , output v-value-integer
     2910                         , output v-value-logical
     2911                         , output v-param-type
     2912                         , input-output table-handle v-tth
     2913                         ) no-error .
     2914       if error-status :error
     2915       then do:
     2916         assign
     2917           v-bgelib-bgedict = no
     2918         .
     2919       end.
     2920       else do:
     2921         assign
     2922           v-bgelib-bgedict = v-value-logical
     2923         .
     2924       end.
     2925       delete object v-tth.
     2926       run adm/shattri.p ( input "get":U
     2927                         , input  '':u
     2928                         , input  0
     2929                         , input  'bge-export':U
     2930                         , input  'bgefmt':U
     2931                         , output v-value-character
     2932                         , output v-value-date
     2933                         , output v-value-decimal
     2934                         , output v-value-integer
     2935                         , output v-value-logical
     2936                         , output v-param-type
     2937                         , input-output table-handle v-tth
     2938                         ) no-error .
     2939       if error-status :error
     2940       then do:
     2941         assign
     2942           v-bgelib-bgefmt  = "xml":U
     2943         .
     2944       end.
     2945       else do:
     2946         assign
     2947           v-bgelib-bgefmt  = v-value-character
     2948         .
     2949       end.
     2950       delete object v-tth.
     2951       run adm/shattri.p ( input "get":U
     2952                         , input  '':u
     2953                         , input  0
     2954                         , input  'bge-export':U
     2955                         , input  'bgeflold':U
     2956                         , output v-value-character
     2957                         , output v-value-date
     2958                         , output v-value-decimal
     2959                         , output v-value-integer
     2960                         , output v-value-logical
     2961                         , output v-param-type
     2962                         , input-output table-handle v-tth
     2963                         ) no-error .
     2964       if error-status :error
     2965       then do:
     2966         assign
     2967           v-bgelib-bgeflold  = "old":U
     2968         .
     2969       end.
     2970       else do:
     2971         assign
     2972           v-bgelib-bgeflold  = v-value-character
     2973         .
     2974       end.
     2975       delete object v-tth.
     2976   end.
     2977   end procedure.
     2978   procedure bgelib-check-file-size :
     2979   do
     2980   on error undo, return error
     2981   :
     2982   define input parameter p-out-filename   as character    no-undo.
     2983   define output parameter p-is-big        as logical      no-undo.
     2984       define variable v-current-position    as integer        no-undo.
     2985       assign
     2986           v-current-position = seek( stmXMLOut )
     2987       .
     2988       if v-current-position / 1024 / 1024  >= 100
     2989       then do:
     2990           assign
     2991               p-is-big = yes
     2992           .
     2993       end.
     2994   end.
     2995   end procedure.
     2996   procedure bgelib-init-ext-doc-type :
     2997       define variable v-counter    as integer      no-undo.
     2998       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2999   do
     3000   for buf_temp_ext-doc-type
     3001   on error undo, return error
     3002   :
     3003       empty temp-table buf_temp_ext-doc-type.
     3004       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     3005       :
     3006           create buf_temp_ext-doc-type.
     3007           assign
     3008               buf_temp_ext-doc-type.edt-key               = v-counter
     3009               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     3010               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     3011           .
     3012       end.
     3013   end.
     3014   end procedure.
     3015   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3016   define variable v-xml-file-name     as character            no-undo.
     3017   define variable v-xml-file-name-path as character            no-undo.
     3018   define variable v-log-file-name     as character            no-undo.
     3019   define variable v-locked            as logical              no-undo.
     3020   define variable v-log-string        as character            no-undo.
     3021   define variable v-oper-num          as integer              no-undo.
     3022   define variable v-obj-list          as character            no-undo.
     3023   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
     3024   DEF VAR intRep      AS INT NO-UNDO.
