    13737   define variable vss-include-info117 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13738   case ub.cash-desk.pos-type:
    13739     when 'IPC-Servis+':U then do:
    13740   define variable vss-include-info118 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13741     os-delete
    13742     value( string( session:temp-directory + "plu" +
    13743     string( var-report-num ) ) + '.plu' ) .
    13744     os-delete
    13745     value( string( session:temp-directory + "bar" +
    13746     string( var-report-num ) ) + '.bar' ) .
