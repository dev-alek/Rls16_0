     6114   procedure fact-order-mpl :
     6115     do
     6116     on error undo, return error return-value
     6117     :
     6118   define input  parameter p-doc-date as date     no-undo .
     6119   define input  parameter p-obj-type as character no-undo .
     6120   define input  parameter p-obj-code as integer   no-undo .
     6121   define output parameter p-fact-order as decimal   no-undo .
     6122   define variable v-fact-date            as date    no-undo .
     6123   define variable v-fact-time            as integer no-undo .
     6124   define variable v-fact-order           as decimal no-undo .
     6125   define variable v-shift-end-fact-order as decimal no-undo .
     6126   define variable v-day-end-fact-order   as decimal no-undo .
     6127   define variable l-shift-on as logical no-undo .
     6128   define variable l-date as date      no-undo .
     6129   define variable l-time as integer   no-undo .
     6130   define variable shift-date as date      no-undo .
     6131   define variable shift-num  as integer   no-undo .
     6132   define variable shift-name as character no-undo .
     6133   define variable max-fact-order as decimal   no-undo .
     6134   define buffer buf_global-state for ub.global-state  .
     6135   find first buf_global-state no-lock no-error .
     6136   if not available buf_global-state then do:
     6137      message
     6138        "Не заданы параметры ценообразования!"
     6139        view-as alert-box error
     6140      .
     6141      return error return-value .
     6142   end.
     6143     run cur-time in this-procedure
     6144     ( output v-fact-date ,
     6145       output v-fact-time  ).
     6146   if p-doc-date = ? then do:
     6147   if buf_global-state.pl-use-sys-date-time  = true then do:
     6148         run factord in this-procedure
     6149           (input  v-fact-date
     6150           ,input  v-fact-time
     6151           ,input  v-fact-time
     6152           ,input  ?
     6153           ,input  ?
     6154           ,input  false
     6155           ,output v-fact-order
     6156           ,output v-shift-end-fact-order
     6157           ,output v-day-end-fact-order
     6158           ) no-error .
     6159         if error-status :error
     6160         or v-fact-order = ?
     6161         or v-fact-order = 0 then do:
     6162           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6163         end.
     6164         p-fact-order = v-fact-order .
     6165   end.
     6166   else do:
     6167   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6168   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     6169     (input  p-obj-type
     6170     ,input  p-obj-code
     6171     ,input  'shift-on=request'
     6172     ,output l-shift-on
     6173     ) no-error .
     6174         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     6175         if p-doc-date <> ? then do:
     6176         end.
     6177          run gbl/factdate.p
     6178          ( input        p-obj-type  ,
     6179            input        p-obj-code  ,
     6180            input-output v-fact-date ,
     6181            input-output v-fact-time ,
     6182            input-output shift-date      ,
     6183            input-output shift-num       ,
     6184            input-output shift-name      ,
     6185            input        yes
     6186            ) no-error .
     6187         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     6188         run factord in this-procedure
     6189           (input  v-fact-date
     6190           ,input  v-fact-time
     6191           ,input  v-fact-time
     6192           ,input  shift-date
     6193           ,input  shift-num
     6194           ,input  l-shift-on
     6195           ,output v-fact-order
     6196           ,output v-shift-end-fact-order
     6197           ,output v-day-end-fact-order
     6198           ) no-error .
     6199         if error-status :error
     6200         or v-fact-order = ?
     6201         or v-fact-order = 0 then do:
     6202           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6203         end.
     6204         p-fact-order = v-fact-order .
     6205   end.
     6206   end.
     6207   else do:
     6208          run gbl/factdate.p
     6209          ( input        p-obj-type  ,
     6210            input        p-obj-code  ,
     6211            input-output v-fact-date ,
     6212            input-output v-fact-time ,
     6213            input-output shift-date      ,
     6214            input-output shift-num       ,
     6215            input-output shift-name      ,
     6216            input        yes
     6217            ) no-error .
     6218         if error-status :error then return error "Ошибка factdate.p " + return-value .
     6219         v-fact-date = p-doc-date .
     6220         run factord in this-procedure
     6221           (input  v-fact-date
     6222           ,input  v-fact-time
     6223           ,input  v-fact-time
     6224           ,input  shift-date
     6225           ,input  shift-num
     6226           ,input  l-shift-on
     6227           ,output v-fact-order
     6228           ,output v-shift-end-fact-order
