    11135       then do:
    11136   define variable vss-include-info82 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11137   define variable ncr-disc-string as character no-undo .
    11138   if nam-artc then
    11139   chk_name = string( cash-gds.artic ) + " " + cash-gds.f-name.
    11140   else  do:
    11141     chk_name = "" .
    11142     DO ff = 1 TO num-entries( cash-gds.gds-name, '"' ) :
    11143       chk_name = chk_name + entry( ff, cash-gds.gds-name, '"' ) .
    11144     END .
