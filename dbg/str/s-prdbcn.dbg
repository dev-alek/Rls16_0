    11214       end.
    11215       if ncr-disc-string = '':U then
    11216       conf-par = chr(32) .
    11217       put stream IBMStream unformatted
    11218       fill(chr(32), 3)
    11219       IBM-good-code
    11220       string(if cash-gds.grp-code = 0 then 1 else cash-gds.grp-code , "9999":U)
    11221       (if LOOKUP( 'вес':U, cash-gds.unit-cli-type ) > 0
    11222       or (is-sc
    11223       AND LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    11224       AND LOOKUP('дро':U, cash-gds.unit-cli-type) > 0)
    11225       then "2":U
    11226       else "0":U)
    11227       (if LOOKUP('дро':U, cash-gds.unit-cli-type) > 0
    11228        or LOOKUP('вес':U, cash-gds.unit-cli-type) > 0
    11229        or is-sc
    11230        then "1":U
    11231        else "0":U)
    11232         (if pos-type = 'NCR-GM':U or
    11233         wd-option = 0
    11234         then   ncrdsc
    11235         else '0':U)
    11236        (if cash-gds.vat-code = ? or
    11237        cash-gds.vat-code > 7 then
    11238        "0"
    11239        else string(cash-gds.vat-code, "9"))
    11240       (if (LOOKUP( 'вес':U, cash-gds.unit-cli-type ) > 0
    11241       or (is-sc
    11242       AND LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    11243       AND LOOKUP('дро':U, cash-gds.unit-cli-type) > 0))
    11244       and  (cash-gds.taracode  <> '':u
    11245            or taracode-bc <> '')
    11246       then (if taracode-bc <> ''
    11247             then taracode-bc
    11248             else cash-gds.taracode)
    11249       else '00'
    11250       )
    11251       (if cash-gds.unit-cli begins "№"
    11252        then substring(cash-gds.unit-cli, 2, 2)
    11253        else substring(cash-gds.unit-cli, 1, 2))  format "X(2)"
    11254       "0010":U
    11255       "0000":U
    11256       chk_name
    11257       fill(chr(32), 4)
    11258       (if pos-type = 'NCR-GM':U and wd-option > 0 then "1":U else chr(32))
    11259       fill(chr(32), 8)
    11260       conf-par
    11261       replace(string( cash-gds.price-sale, "999999.99")
    11262              , ".":U, "":U
    11263              )
    11264       chr(10)
    11265       .
    11266       if pos-type = 'NCR-AS@R':U
    11267       and ncrdsc <> '0':U
    11268       and wd-option > 0
    11269       and cash-gds.std-discnt-rule > 0
    11270       then do:
