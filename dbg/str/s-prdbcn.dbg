     9326         std-disc-reason = 0
     9327         .
     9328       end.
     9329     end.
     9330   end.
     9331   if cash-gds.wd > 1 then do:
     9332     find first cash-dis-rule no-lock where
     9333               cash-dis-rule.rule-num =  cash-gds.wd-rule no-error .
     9334     if available cash-dis-rule then  do:
     9335       assign
     9336       wd-option = integer(cash-dis-rule.discnt-value).
     9337     end.
     9338   end.
     9339   if cash-gds.wd = 1 then do:
     9340      wd-option = 1.
     9341   end.
     9342   if cash-gds.wgd > 0 then do:
     9343     find first cash-dis-rule no-lock where
     9344               cash-dis-rule.rule-num =  cash-gds.wgd-rule no-error .
     9345     if available cash-dis-rule then  do:
     9346       assign
     9347       wgd-option = integer(cash-dis-rule.discnt-value).
     9348     end.
     9349   end.
     9350   if cash-gds.temp-discnt-rule <> 0 then do:
     9351     assign
     9352     temp-disc-dec = 0
     9353     .
     9354     find first cash-dis-rule no-lock where
     9355               cash-dis-rule.rule-num = cash-gds.temp-discnt-rule no-error .
     9356     if available cash-dis-rule
     9357              and cash-dis-rule.is-term = yes then do:
     9358       if cash-dis-rule.time-rule-num > 0 then do:
     9359         find first cash-dis-time-rule no-lock where
     9360                     cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num no-error .
     9361         if available cash-dis-time-rule
     9362         and cash-dis-time-rule.templ-rl-root = 50001
     9363             or
     9364             (
     9365              (
     9366               (cash-dis-time-rule.date-from < today)
     9367               or
     9368               (cash-dis-time-rule.date-from = 12/31/1989)
     9369              )
     9370             and
     9371             (
     9372              (cash-dis-time-rule.date-to >= today)
     9373              or
     9374              (cash-dis-time-rule.date-to = 12/31/1989)
     9375             )
     9376            ) then do:
     9377            temp-disc-dec = ?.
     9378         end.
     9379         else do:
     9380           assign
     9381           temp-disc-dec = 0
     9382           .
     9383         end.
     9384       end.
     9385       else do:
     9386         temp-disc-dec = ?.
     9387       end.
     9388       if temp-disc-dec = ? then do:
     9389         case cash-dis-rule.value-type:
     9390           when integer('1':U) then do:
     9391         assign
     9392         temp-disc-dec = - cash-dis-rule.discnt-value
     9393         .
     9394       end.
     9395           when integer('11':U) then do:
     9396             find first cash-gds-discnt where
     9397                       cash-gds-discnt.b-code = cash-gds.b-code
     9398                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     9399                   and cash-gds-discnt.obj-type = 'маг':U
     9400                   and cash-gds-discnt.obj-code = i-obj-code
     9401                   no-error.
     9402             if available cash-gds-discnt then do:
     9403               assign
     9404               temp-disc-dec = - (cash-gds.price-sale - cash-gds-discnt.discnt-value) / cash-gds.price-sale * 100
     9405               .
     9406             end.
     9407             else do:
     9408              assign
     9409               temp-disc-dec = 0.
     9410             end.
     9411           end.
     9412           otherwise do:
     9413             temp-disc-dec = 0.
     9414           end.
     9415         end case.
     9416       end.
     9417     end.
     9418   end.
