     8973     define variable len-code70 as integer   no-undo.
     8974     define variable varcont70  as logical   initial yes no-undo.
     8975     CASE ncrsc-frmt :
     8976       WHEN "EAN13" THEN do:
     8977         assign
     8978           tmp-str70 = string( decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U), "999999999999" )
     8979         .
     8980       end.
     8981       WHEN "EAN8" THEN do:
