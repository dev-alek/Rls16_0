      122   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   def new shared var bc-frmt as character no-undo .
      124   def new shared var bc-pfx  as character no-undo .
      125   def var bc-par-type as character no-undo .
      126       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
      127       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
      128           do:
      129               message "Не задан или не верно задан ТИП собственного бар-кода!"
      130                   view-as alert-box ERROR TITLE "".
      131               return error.
      132           end.
      133       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
      134       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
      135           do:
      136               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      137                   view-as alert-box ERROR TITLE "".
      138               return error.
      139           end.
      140   PROCEDURE gen-bc:
      141     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      142     def output parameter full-b-code     as character init ""    no-undo .
      143   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      144     define variable tmp-str4  as character no-undo.
      145     define variable tmp-num4  as character no-undo.
      146     define variable i4        as integer   no-undo.
      147     define variable sum4      as integer   no-undo.
      148     define variable len-code4 as integer   no-undo.
      149     define variable varcont4  as logical   initial yes no-undo.
      150     CASE bc-frmt :
      151       WHEN "EAN13" THEN do:
      152         assign
      153           tmp-str4 = string( internal-b-code, "999999999999" )
      154         .
      155       end.
      156       WHEN "EAN8" THEN do:
      157         assign
      158           tmp-str4 = string( internal-b-code, "9999999" )
      159         .
      160       end.
      161       OTHERWISE DO:
      162           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      163           view-as alert-box error.
      164           return error.
      165       END.
      166     END CASE.
      167     if varcont4 = yes then do:
      168       if integer( substring( tmp-str4, 1, length( bc-pfx ) ) ) <> 0
      169       then do:
      170         message
      171           "Невозможно сформировать бар-код" SKIP
      172           "для товара с кодом: " internal-b-code
      173           view-as alert-box error title "подрезание кода".
      174         return error.
      175       end.
      176       else do:
      177         assign
      178           full-b-code = bc-pfx + substring( tmp-str4, length( bc-pfx ) + 1, length( tmp-str4 ) - length( bc-pfx ) )
      179           len-code4    = length( full-b-code )
      180         .
      181         define variable v-sum-char4 as character no-undo .
      182         assign
      183           sum4 = 0
      184         .
      185         do i4 = 1 to len-code4 by 2
      186         :
      187           assign
      188             v-sum-char4 = substr(full-b-code, len-code4 - i4 + 1, 1)
      189           .
      190           if v-sum-char4 < "0"
      191           or v-sum-char4 > "9"
      192           then do:
      193             message
      194               "Невозможно сформировать бар-код" skip
      195               "для товара с кодом: " internal-b-code skip
      196               view-as alert-box error title "подсчет контрольной суммы".
      197             return error.
      198           end.
      199           assign
      200             sum4 = sum4 + integer(v-sum-char4)
      201           .
      202         end.
      203         if varcont4 = yes then do:
      204           assign
      205             sum4 = sum4 * 3
      206           .
      207           do i4 = 2 to len-code4 by 2
      208           :
      209             assign
      210               v-sum-char4 = substr(full-b-code, len-code4 - i4 + 1, 1)
      211             .
      212             if v-sum-char4 < "0"
      213             or v-sum-char4 > "9"
      214             then do:
      215               message
      216                 "Невозможно сформировать бар-код" skip
      217                 "для товара с кодом: " internal-b-code skip
      218                 view-as alert-box error title "подсчет контрольной суммы".
      219               return error.
      220             end.
      221             assign
      222               sum4 = sum4 + integer(v-sum-char4)
      223             .
      224           end.
      225           if varcont4 = yes then do:
      226              if sum4 mod 10 = 0 then do:
      227                assign
      228                  full-b-code = full-b-code + '0'
      229                .
      230              end.
      231              else do:
      232                assign
      233                  full-b-code = full-b-code + string(10 - sum4 mod 10)
      234                .
      235              end.
      236           end.
      237         end.
      238       end.
      239     end.
      240   END PROCEDURE.
