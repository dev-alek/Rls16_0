     3261   procedure alienini-getkey :
     3262   define input parameter i-filename as char.
     3263   define input parameter i-section as char.
     3264   define input parameter i-key as char.
     3265   define output parameter o-value as char.
     3266   define variable EntryPointer as integer no-undo.
     3267   define variable mem1 as memptr no-undo.
     3268   define variable mem2 as memptr no-undo.
     3269   define variable mem1size as integer no-undo.
     3270   define variable mem2size as integer no-undo.
     3271   define variable ii       as integer    no-undo.
     3272   define variable cbReturnSize  as integer    no-undo.
     3273   assign
     3274   set-size(mem1)  = 4000
     3275   mem1size = 4000.
     3276   if i-key = "" then EntryPointer = 0.
     3277   else do:
     3278     assign
     3279     set-size(mem2) = 128
     3280     mem2size = 128
     3281     EntryPointer = get-pointer-value(mem2)
     3282     put-string(mem2, 1) = i-key.
     3283   end.
     3284   run getprivateprofilestringA
     3285                                 (i-section,
     3286                                  EntryPointer,
     3287                                  "",
     3288                                  get-pointer-value(mem1),
     3289                                  input mem1size,
     3290                                  i-filename,
     3291                                  output cbReturnSize).
     3292   do ii = 1 to cbReturnSize:
     3293     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     3294                  then o-value + ","
     3295                  else o-value + chr(get-byte(mem1, ii)).
     3296   end.
     3297     set-size(mem1) = 0.
     3298     set-size(mem2) = 0.
     3299   end procedure.
     3300   procedure alienini-putkey :
     3301   define input parameter i-filename as char.
     3302   define input parameter i-section as char.
     3303   define input parameter i-key as char.
     3304   define input parameter i-value as char.
     3305   define variable cbReturnSize as integer.
     3306   run writeprivateprofilestringA
     3307                                  (i-section,
     3308                                   i-key,
     3309                                   i-value,
     3310                                   i-filename,
     3311                                   output cbReturnSize ).
     3312   end procedure.
     3313   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     3314     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     3315     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     3316     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     3317     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     3318     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     3319     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     3320     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     3321   END PROCEDURE.
     3322   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     3323     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     3324     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     3325     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     3326     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     3327     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     3328   END PROCEDURE.
     3329   define   temp-table temp-tekka-tsk no-undo
     3330   field filename      as character
     3331   field obj-num       as integer
     3332   field obj-name      as character
     3333   field num-records   as integer
     3334   field max-records   as integer
     3335   field min-plu       as integer
     3336   field max-plu       as integer
     3337   field num-fields    as integer
     3338   field task-num      as character
     3339   field by-record     as logical
     3340   field send-get      as character
     3341   field cash-num      as integer
     3342   field cash-num-char as character
     3343   field port-num      as character
     3344   field way           as character
     3345   field is-script     as logical
     3346   field pswd          as character
     3347   field waiting-sek   as integer
     3348   field other-info    as character
     3349   field order-num     as integer
     3350   field secondary     as integer
     3351   field shift-fields  as integer
     3352   field binary        as logical
     3353   field range         as integer
     3354   index pi is unique primary
     3355   filename
     3356   range
     3357   index lpi
     3358   filename
     3359   min-plu
     3360   index gpi
     3361   filename
     3362   max-plu
     3363   index iorder
     3364   order-num
     3365   .
     3366   define   temp-table temp-tekka-schema no-undo
     3367   field obj-num as integer
     3368   field obj-name as character
     3369   field field-num as integer
     3370   field field-name as character
     3371   field num-records as integer
     3372   field size_ as integer
     3373   field host as character
     3374   field progress-type as character
     3375   field custom-type as character
     3376   field start-pos as integer
     3377   field end-pos as integer
     3378   field bin-group as character
     3379   index pi is unique primary
     3380   host obj-num field-num
     3381   .
     3382   define temp-table temp-tekka-record no-undo
     3383   field obj-num as integer
     3384   field plu as integer
     3385   field body as character
     3386   field shift as integer
     3387   index pi is unique primary obj-num plu.
     3388   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     3389   define variable v-is-closed-shift-journal as integer no-undo .
     3390   assign
     3391   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     3392                               +
     3393                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     3394                               +
     3395                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     3396   .
     3397   return v-is-closed-shift-journal.
     3398   END FUNCTION.
     3399   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     3400   define variable v-is-first-journal as logical no-undo .
     3401   assign
     3402   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     3403                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     3404                     or (p-journal-num =  integer(entry(1, '17':U)))
     3405                     or (p-journal-num = integer(entry(1, '16':U)))
     3406   .
     3407   return v-is-first-journal.
     3408   END FUNCTION.
     3409   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     3410   define variable v-is-petrol-journal as logical no-undo .
     3411   assign
     3412   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     3413   return v-is-petrol-journal.
     3414   END FUNCTION.
     3415   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     3416   define variable v-max-record-num as integer no-undo .
     3417   assign
     3418   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3419                       then 1489
     3420                       else 2340).
     3421   return v-max-record-num.
     3422   END FUNCTION.
     3423   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     3424   define variable v-max-record-num as integer no-undo .
     3425   assign
     3426   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3427                       then 1489 * num-entries('30,31,32,33':U)
     3428                       else 2340 * num-entries('17':U)).
     3429   return v-max-record-num.
     3430   END FUNCTION.
     3431   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     3432                                           ,input p-rec-no as integer):
     3433   define variable v-num-recs as integer no-undo .
     3434   if tekka-is-petrol-journal (p-journal-num) then do:
     3435     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     3436       assign
     3437       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     3438       .
     3439     end.
     3440     else do:
     3441       assign
     3442       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     3443       .
     3444     end.
     3445   end.
     3446   else do:
     3447     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     3448       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3449         assign
     3450         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     3451         .
     3452       end.
     3453       else do:
     3454         assign
     3455         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     3456         .
     3457       end.
     3458     end.
     3459     else do:
     3460       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3461         assign
     3462         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     3463         .
     3464       end.
     3465       else do:
     3466         assign
     3467         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     3468         .
     3469       end.
     3470     end.
     3471   end.
     3472   return v-num-recs.
     3473   END FUNCTION.
     3474   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     3475                                              ,input p-is-petrol as logical
     3476                                              ,input p-is-current as logical
     3477                                              ,output p-rec-no as decimal
     3478                                              ):
     3479   define variable v-obj-num0 as integer no-undo .
     3480   define variable v-obj-num as integer no-undo .
     3481   define variable v-obj-num2 as integer no-undo .
     3482   define variable p-num-recs2 as integer no-undo .
     3483   define variable p-rec-no2 as integer no-undo .
     3484   if p-is-petrol then do:
     3485     assign
     3486     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     3487     .
     3488     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     3489     then
     3490     assign
     3491     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     3492     p-rec-no = p-num-recs modulo 1489
     3493     .
     3494     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     3495     then
     3496     assign
     3497     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     3498     p-rec-no = p-num-recs modulo 1489
     3499     .
     3500   end.
     3501   else do:
     3502     assign
     3503     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     3504     p-num-recs = trunc(p-num-recs, 0)
     3505     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     3506     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     3507     .
     3508     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     3509     then
     3510     assign
     3511     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     3512     p-rec-no = p-num-recs modulo 2340
     3513     .
     3514     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     3515     then
     3516     assign
     3517     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     3518     p-rec-no = p-num-recs modulo 2340
     3519     .
     3520     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     3521     then
     3522     assign
     3523     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     3524     p-rec-no2 = p-num-recs2 modulo 2978
     3525     .
     3526     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     3527     then
     3528     assign
     3529     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     3530     p-rec-no2 = p-num-recs2 modulo 2978
     3531     .
     3532     assign
     3533     p-rec-no = p-rec-no + p-rec-no2 / 10000
     3534     .
     3535   end.
     3536   if v-obj-num = 0 then v-obj-num = 100.
     3537   return v-obj-num.
     3538   END FUNCTION.
     3539   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     3540   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     3541   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3542      if p-is-ptrl then
     3543      return integer(entry(1, '26,27,28,29':U)).
     3544      if not p-is-ptrl then
     3545      return integer(entry(1, '16':U)).
     3546   end.
     3547   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3548   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3549   return 0.
     3550   END FUNCTION.
     3551   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     3552   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     3553   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3554     if p-is-ptrl then
     3555     return integer(entry(1, '26,27,28,29':U)).
     3556     if not p-is-ptrl then
     3557     return integer(entry(1, '16':U)).
     3558   end.
     3559   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3560   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3561   return 0.
     3562   END FUNCTION.
     3563   PROCEDURE maria-put:
     3564   define parameter buffer buf_cash-desk for ub.cash-desk.
     3565   define input parameter p-out    as character no-undo .
     3566   define input parameter p-fname as character no-undo .
     3567   define input parameter p-by-record as logical no-undo .
     3568   define input parameter p-shift-fields as integer no-undo .
     3569   define input parameter p-binary as logical no-undo .
     3570   define input parameter p-obj-num as integer no-undo .
     3571   define input parameter p-max-records as integer no-undo .
     3572   define input parameter p-plu as integer no-undo .
     3573   define input parameter p-value as character no-undo .
     3574   define variable v-file-name as character no-undo .
     3575   define variable v-create as logical no-undo .
     3576   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3577   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     3578   output stream IBMSTREAM
     3579   to value(v-file-name) append .
     3580   Put  stream IBMSTREAM unformatted
     3581   p-plu
     3582   chr(3)
     3583   p-value
     3584   skip.
     3585   output stream IBMSTREAM
     3586   close.
     3587   if not p-by-record then do:
     3588     find first buf_temp-tekka-tsk where
     3589               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3590     if not available buf_temp-tekka-tsk then do:
     3591       v-create = yes.
     3592     end.
     3593   end.
     3594   else do:
     3595     find first buf_temp-tekka-tsk where
     3596               buf_temp-tekka-tsk.filename  = v-file-name
     3597           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     3598     if not available buf_temp-tekka-tsk
     3599     then do:
     3600       find first buf_temp-tekka-tsk where
     3601                 buf_temp-tekka-tsk.filename  = v-file-name
     3602             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     3603       if not available buf_temp-tekka-tsk
     3604       then do:
     3605         v-create = yes.
     3606       end.
     3607     end.
     3608   end.
     3609   if v-create then do:
     3610     create buf_temp-tekka-tsk.
     3611     assign
     3612     buf_temp-tekka-tsk.filename = v-file-name
     3613     buf_temp-tekka-tsk.range    = p-plu
     3614     buf_temp-tekka-tsk.obj-num = p-obj-num
     3615     buf_temp-tekka-tsk.obj-name = '':U
     3616     buf_temp-tekka-tsk.num-records = 0
     3617     buf_temp-tekka-tsk.max-records = p-max-records
     3618     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     3619     buf_temp-tekka-tsk.task-num = p-fname
     3620     buf_temp-tekka-tsk.by-record = p-by-record
     3621     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     3622     buf_temp-tekka-tsk.binary = p-binary
     3623     buf_temp-tekka-tsk.send-get = 'send'
     3624     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3625     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3626     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3627     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3628                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3629                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3630                                 then 'local'
     3631                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3632     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3633     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3634     buf_temp-tekka-tsk.waiting-sek = 30
     3635     buf_temp-tekka-tsk.min-plu     = p-plu
     3636     buf_temp-tekka-tsk.max-plu     = p-plu
     3637     .
     3638   end.
     3639   assign
     3640   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     3641   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     3642   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     3643   .
     3644   END PROCEDURE.
     3645   PROCEDURE maria-get:
     3646   define parameter buffer buf_cash-desk for ub.cash-desk.
     3647   define input parameter p-out    as character no-undo .
     3648   define input parameter p-fname as character no-undo .
     3649   define input parameter p-by-record as logical no-undo .
     3650   define input parameter p-obj-num as integer no-undo .
     3651   define input parameter p-num-fields as integer no-undo .
     3652   define input parameter p-max-records as integer no-undo .
     3653   define input parameter p-min-plu as integer no-undo .
     3654   define input parameter p-max-plu as integer no-undo .
     3655   define input parameter p-other as character no-undo .
     3656   define input parameter p-order-num as integer no-undo .
     3657   define variable v-file-name as character no-undo .
     3658   define variable v-secondary-obj-num as character no-undo .
     3659   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3660   if p-by-record then do:
     3661     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     3662   end.
     3663   else do:
     3664     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     3665   end.
     3666   find first buf_temp-tekka-tsk where
     3667             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3668   if not available buf_temp-tekka-tsk then do:
     3669     create buf_temp-tekka-tsk.
     3670     assign
     3671     buf_temp-tekka-tsk.filename = v-file-name
     3672     buf_temp-tekka-tsk.obj-num = p-obj-num
     3673     buf_temp-tekka-tsk.obj-name = '':U
     3674     buf_temp-tekka-tsk.max-records = p-max-records
     3675     buf_temp-tekka-tsk.num-fields = p-num-fields
     3676     buf_temp-tekka-tsk.task-num = p-fname
     3677     buf_temp-tekka-tsk.by-record = p-by-record
     3678     buf_temp-tekka-tsk.send-get = 'get'
     3679     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3680     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3681     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3682     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3683                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3684                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3685                                   then 'local'
     3686                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3687     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3688     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3689     buf_temp-tekka-tsk.waiting-sek = 30
     3690     buf_temp-tekka-tsk.min-plu     = p-min-plu
     3691     buf_temp-tekka-tsk.max-plu     = p-max-plu
     3692     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     3693                                       and p-max-plu <> ?
     3694                                       then p-max-plu - p-min-plu + 1
     3695                                       else 0)
     3696     buf_temp-tekka-tsk.other-info = p-other
     3697     buf_temp-tekka-tsk.order-num = p-order-num
     3698     .
     3699     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     3700       assign
     3701       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     3702       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     3703       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     3704       no-error
     3705       .
     3706       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     3707     end.
     3708   end.
     3709   END PROCEDURE.
     3710   PROCEDURE maria-task:
     3711   define parameter buffer buf_cash-desk for ub.cash-desk.
     3712   define input parameter p-fname as character no-undo .
     3713   define input parameter p-obj-num-list as character no-undo .
     3714   define input parameter p-parameters as character no-undo .
     3715   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3716   find first buf_temp-tekka-tsk where
     3717             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     3718   if not available buf_temp-tekka-tsk then do:
     3719     create buf_temp-tekka-tsk.
     3720     assign
     3721     buf_temp-tekka-tsk.filename = ''
     3722     buf_temp-tekka-tsk.range = 1
     3723     buf_temp-tekka-tsk.obj-num = 0
     3724     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     3725     buf_temp-tekka-tsk.task-num = p-fname
     3726     buf_temp-tekka-tsk.by-record = no
     3727     buf_temp-tekka-tsk.send-get = 'task'
     3728     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3729     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3730     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3731     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3732                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3733                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3734                                   then 'local'
     3735                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3736     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3737     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3738     buf_temp-tekka-tsk.waiting-sek = 30
     3739     buf_temp-tekka-tsk.other-info = p-parameters
     3740     buf_temp-tekka-tsk.order-num = 0
     3741     .
     3742   end.
     3743   END PROCEDURE.
     3744   procedure tekkatsk-verify-schema :
     3745   define input parameter p-obj-list as character no-undo .
     3746   define input parameter p-dir-path as character no-undo .
     3747   define variable v-obj-num as integer no-undo .
     3748   define variable v-obj-name as character no-undo .
     3749   define variable v-num-records as integer no-undo .
     3750   define variable v-size_ as integer no-undo .
     3751   define variable v-value as character no-undo .
     3752   define variable ii as integer no-undo .
     3753   define variable jj as integer no-undo .
     3754   define variable ii-ibs as integer no-undo .
     3755   define variable ii-tekka as integer no-undo .
     3756   define variable v-result as character no-undo .
     3757   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     3758   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     3759     do
     3760     on error undo, return error
     3761     :
     3762        for each buf_temp-tekka-schema:
     3763          delete buf_temp-tekka-schema.
     3764        end.
     3765        input from value('tekkasch.d').
     3766        repeat :
     3767          create buf_temp-tekka-schema.
     3768          import buf_temp-tekka-schema.
     3769          assign
     3770          buf_temp-tekka-schema.host = 'IBS'
     3771          ii = ii + 1.
     3772          .
     3773        end.
     3774        input close.
     3775        ii-ibs = ii.
     3776         _ii:
     3777         do ii = 1 to 256:
     3778           if p-obj-list = "ALL"
     3779           or lookup(string(ii), p-obj-list) > 0 then do:
     3780             assign
     3781             v-obj-num = 0
     3782             v-obj-name = ''
     3783             v-num-records = 0
     3784             v-size_ = 0
     3785             .
     3786             run alienini-getkey in this-procedure (
     3787                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3788                                                     ,input ('obj' + string(ii, '999'))
     3789                                                     ,input 'oname'
     3790                                                     ,output v-value) no-error .
     3791             if v-value = ? then next _ii.
     3792             assign
     3793             v-obj-num = ii
     3794             v-obj-name = v-value
     3795             .
     3796             run alienini-getkey in this-procedure (
     3797                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3798                                                     ,input ('obj' + string(ii, '999'))
     3799                                                     ,input 'size'
     3800                                                     ,output v-value) no-error .
     3801             assign
     3802             v-num-records = integer(v-value) no-error  .
     3803             if error-status:error
     3804             or v-num-records = 0 then next _ii.
     3805             run alienini-getkey in this-procedure (
     3806                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3807                                                     ,input 'obj' + string(ii, '999')
     3808                                                     ,input 'f000'
     3809                                                     ,output v-value) no-error .
     3810             assign
     3811             v-size_ = integer(v-value) no-error  .
     3812             if error-status:error
     3813             or v-size_ = 0 then next _ii.
     3814             _jj:
     3815             do jj = 1 to 256:
     3816               run alienini-getkey in this-procedure (
     3817                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3818                                                       ,input 'obj' + string(ii, '999')
     3819                                                       ,input 'f' + string(jj, '999')
     3820                                                       ,output v-value) no-error .
     3821               if v-value = ? then next _ii.
     3822               create buf_temp-tekka-schema.
     3823               assign
     3824               buf_temp-tekka-schema.host = 'tekka'
     3825               buf_temp-tekka-schema.obj-num = v-obj-num
     3826               buf_temp-tekka-schema.obj-name = v-obj-name
     3827               buf_temp-tekka-schema.num-records = v-num-records
     3828               buf_temp-tekka-schema.size_ = v-size_
     3829               buf_temp-tekka-schema.field-num = jj
     3830               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     3831               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     3832                                                  then entry(2, entry(2, v-value, '#'), ':')
     3833                                                  else '':U)
     3834               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     3835               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     3836               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     3837                                                           , 'C,I,I,I,D,D,D,D,D':U)
     3838               no-error
     3839               .
     3840               if error-status:error then do:
     3841                 delete buf_temp-tekka-schema.
     3842                 next _jj.
     3843               end.
     3844               run alienini-getkey in this-procedure (
     3845                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3846                                                       ,input 'obj' + string(ii, '999') + 'name'
     3847                                                       ,input 'n' + string(jj, '999')
     3848                                                       ,output v-value) no-error .
     3849               if v-value <> ? then
     3850               buf_temp-tekka-schema.field-name = v-value.
     3851             end.
     3852           end.
     3853         end.
     3854         ii-tekka = ii - 1.
     3855        if p-obj-list <> 'ALL' then do:
     3856         if ii-tekka <> ii-ibs then do:
     3857           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     3858                                   , ii-ibs
     3859                                   , ii-tekka).
     3860         end.
     3861        end.
     3862        for each buf_temp-tekka-schema where
     3863               buf_temp-tekka-schema.host = 'tekka':
     3864          find first buf2_temp-tekka-schema where
     3865                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     3866                AND buf2_temp-tekka-schema.host = 'ibs'
     3867                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     3868          if not available buf2_temp-tekka-schema then do:
     3869           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     3870                                   , buf_temp-tekka-schema.field-num
     3871                                   , buf_temp-tekka-schema.obj-num).
     3872          end.
     3873          buffer-compare buf_temp-tekka-schema
     3874          to buf2_temp-tekka-schema
     3875          save result in v-result.
     3876          if v-result <> '':U then do:
     3877           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     3878                                   , buf_temp-tekka-schema.field-num
     3879                                   , buf_temp-tekka-schema.obj-num).
     3880          end.
     3881        end.
     3882     end.
     3883   end procedure.
     3884   FUNCTION set-Sx returns character (input p-string as character):
     3885   return p-string.
     3886   END FUNCTION.
     3887   FUNCTION get-Sx returns character (input p-string  as character):
     3888   return p-string.
     3889   END FUNCTION.
     3890   FUNCTION set-B returns character (input p-string  as character):
     3891   return chr(integer(p-string)).
     3892   END FUNCTION.
     3893   FUNCTION get-B returns character (input p-string  as character):
     3894   return string(asc(p-string)).
     3895   END FUNCTION.
     3896   FUNCTION set-BF returns character (input p-string  as character):
     3897   define variable v-dopi as integer no-undo .
     3898   define variable ii as integer no-undo .
     3899   do ii = 1 to 8:
     3900     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     3901   end.
     3902   return chr(v-dopi).
     3903   END FUNCTION.
     3904   FUNCTION get-BF returns character (input p-string  as character):
     3905   define variable v-dopi as integer no-undo .
     3906   define variable v-dops as character no-undo .
     3907   define variable ii as integer no-undo .
     3908   v-dopi = asc(p-string).
     3909   do ii = 8 to 1 BY -1:
     3910     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     3911   end.
     3912   return v-dops.
     3913   END FUNCTION.
     3914   FUNCTION set-BN returns character (input p-string  as character
     3915                                     ,input p-bin-group as character):
     3916   define variable v-dopi as integer no-undo .
     3917   define variable ii as integer no-undo .
     3918   define variable jj as integer no-undo .
     3919   define variable v-grp-nums as integer no-undo .
     3920   define variable v-dopi2 as integer no-undo .
     3921   v-grp-nums = num-entries(p-bin-group).
     3922   do jj = 0 to v-grp-nums - 1:
     3923     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     3924     do ii = 1 to 8:
     3925       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     3926     end.
     3927   end.
     3928   return chr(v-dopi).
     3929   END FUNCTION.
     3930   FUNCTION get-BN returns character (input p-string  as character
     3931                                     ,input p-bin-group as character):
     3932   define variable v-dopi as integer no-undo .
     3933   define variable v-dops as character no-undo .
     3934   define variable v-grp-nums as integer no-undo .
     3935   define variable ii as integer no-undo .
     3936   define variable jj as integer no-undo .
     3937   v-dopi = asc(p-string).
     3938   v-grp-nums = num-entries(p-bin-group).
     3939   do jj = 1 to v-grp-nums:
     3940   do ii = 8 to 1 BY -1:
     3941     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     3942   end.
     3943   end.
     3944   return v-dops.
     3945   END FUNCTION.
     3946   procedure fill-temp-cd :
     3947   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     3948   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     3949   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     3950   define input parameter p-clear-table as logical no-undo .
     3951   define buffer buf_temp-cd for temp-cd.
     3952   define buffer buf_cash-desk for ub.cash-desk.
     3953     do
     3954     on error undo, return error
     3955     :
     3956        if p-clear-table  then do:
     3957          for each buf_temp-cd:
     3958            delete buf_temp-cd.
     3959          end.
     3960        end.
     3961        for each buf_cash-desk no-lock where
     3962               buf_cash-desk.db-num = p-db-num
     3963           AND buf_cash-desk.obj-code = p-obj-code
     3964           and buf_cash-desk.cash-on  = yes
     3965        BREAK by buf_cash-desk.pos-type:
     3966          if first-of(buf_cash-desk.pos-type) then do:
     3967            create buf_temp-cd.
     3968            buffer-copy buf_cash-desk to buf_temp-cd.
     3969          end.
     3970        end.
     3971     end.
     3972   end procedure.
     3973   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3974   FUNCTION name-2cdf returns character
     3975                      (  input p-name-2cd as character
     3976                       , input p-mode as logical
     3977                       , input p-cod-pcod as logical
     3978                       , input p-b-code  as integer
     3979                       , input p-gds-code as integer
     3980                       , input p-artic   as character
     3981                       , input p-engl-name  as character
     3982                       , input p-in-code as character
     3983                       , input p-part-code as character
     3984                       , input p-obj-type as character
     3985                       , input p-obj-code as integer
     3986                       , input p-alpha1 as character
     3987                       , output p-gtd as character
     3988                       ) :
     3989   define variable v-name-2cd as character no-undo .
     3990   define variable v-dop-alt-name as character no-undo.
     3991   define variable v-type as character no-undo.
     3992   define buffer buf_parts for ub.parts.
     3993   define buffer buf_code for ub.code.
     3994   if not p-mode and p-name-2cd = "PLU":U then do:
     3995     return "PLU кассы":U.
     3996   end.
     3997   if not p-mode then do:
     3998     if p-name-2cd <> "GTD":U
     3999     and  p-name-2cd <> "alpha1|gtd":U
     4000     then do:
     4001     assign
     4002     p-name-2cd = p-name-2cd + "-":U + "GTD":U.
     4003   end.
     4004   end.
     4005   if p-part-code = "":U or p-cod-pcod = no then do:
     4006     run gdsoattr-value in this-procedure (
     4007       'dt-seasons':U,
     4008       p-gds-code,
     4009       p-obj-type,
     4010       p-obj-code,
     4011       output v-dop-alt-name,
     4012       output v-type
     4013     ) no-error.
     4014     if v-dop-alt-name <> "" then do:
     4015       find first buf_code where
     4016                  buf_code.parent = "DTSeasons"
     4017              and buf_code.code   = v-dop-alt-name
     4018            no-lock no-error.
     4019       if available buf_code then
     4020         assign
     4021           p-engl-name = ""
     4022           v-dop-alt-name =  buf_code.misc1
     4023         .
     4024     end.
     4025     else do:
     4026       run gdsoattr-value in this-procedure
     4027                           ( input  'dop-alt-name-o':U
     4028                            ,input  p-gds-code
     4029                            ,input  p-obj-type
     4030                            ,input  p-obj-code
     4031                            ,output v-dop-alt-name
     4032                            ,output v-type
     4033                           ) no-error .
     4034     end.
     4035     CASE p-name-2cd:
     4036       when "name" then do:
     4037         if p-mode then return p-engl-name + v-dop-alt-name.
     4038         return "Англ. название".
     4039       end.
     4040       when "code":U then do:
     4041         if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4042         return "Лок. код товара"  .
     4043       end.
     4044       when "GTD":U
     4045       or
     4046       when "name-GTD":U
     4047       or
     4048       when "code-GTD":U
     4049       or
     4050       when "alpha1|gtd":U
     4051       or
     4052       when "name-alpha1|gtd":U
     4053       or
     4054       when "code-alpha1|gtd":U
     4055       then do:
     4056         if p-mode then do:
     4057           run gdcstcod_cst-code  in this-procedure (
     4058                                                       input  p-obj-type
     4059                                                       ,input  p-obj-code
     4060                                                       ,input  p-gds-code
     4061                                                       ,input  p-in-code
     4062                                                       ,input  p-part-code
     4063                                                       ,output p-gtd
     4064                                                       ) no-error .
     4065         end.
     4066         if p-name-2cd = "name-gtd":U then do:
     4067           if p-mode then return p-engl-name  + v-dop-alt-name.
     4068           return "Англ. название".
     4069         end.
     4070         if p-name-2cd = "name-alpha1|gtd":U then do:
     4071           if p-mode then return p-engl-name  + v-dop-alt-name.
     4072           return "Англ. название".
     4073         end.
     4074         if p-name-2cd = "code-GTD":U then do:
     4075           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4076           return "Лок. код товара"  .
     4077         end.
     4078         if p-name-2cd = "code-alpha1|gtd":U then do:
     4079           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4080           return "Лок. код товара"  .
     4081         end.
     4082         if p-mode then do:
     4083           if p-name-2cd = "GTD" then  return p-gtd.
     4084           if p-name-2cd = "alpha1|gtd" then  return (p-alpha1 + "|" + p-gtd).
     4085         end.
     4086         if p-name-2cd = "GTD" then  return "Код ГТД".
     4087         if p-name-2cd = "alpha1|gtd" then  return "Страна|Код ГТД".
     4088       end.
     4089     END CASE.
     4090   end.
     4091   else do:
     4092     if p-name-2cd = "name-gtd":U
     4093     or p-name-2cd = "code-GTD":U
     4094     or p-name-2cd = "name-alpha1|GTD":U
     4095     or p-name-2cd = "code-alpha1|GTD":U
     4096     or p-name-2cd = "alpha1|GTD":U
     4097     then do:
     4098       if p-mode then do:
     4099         run gdcstcod_cst-code  in this-procedure (
     4100                                                      input  p-obj-type
     4101                                                     ,input  p-obj-code
     4102                                                     ,input  p-gds-code
     4103                                                     ,input  p-in-code
     4104                                                     ,input  p-part-code
     4105                                                     ,output p-gtd
     4106                                                     ) no-error .
     4107       end.
     4108       else do:
     4109         if p-name-2cd = "gtd":U then
     4110         p-gtd = "Код ГТД".
     4111         if p-name-2cd = "alpha1|Gtd":U then
     4112         p-gtd = "Страна|Код ГТД".
     4113       end.
     4114     end.
     4115     if p-mode then  return p-part-code.
     4116     return "Код партии".
     4117   end.
     4118   END FUNCTION.
     4119   function chk-name_ibm_maria_ibm-xml_infokiosk_ibs-th returns character ( input p-pos-type as character
     4120                                            ,input p-nam-2str as logical
     4121                                            ,input p-nam-artc as logical
     4122                                            ,input p-unit-cli-type as character
     4123                                            ,input p-unit-base as character
     4124                                            ,input p-unit-cli as character
     4125                                            ,input p-cli-base-rate as decimal
     4126                                            ,input p-artic as character
     4127                                            ,input p-f-name as character
     4128                                            ,input p-gds-name as character
     4129                                            ,input p-gds-name1 as character
     4130                                            ,output p-second-name as character):
     4131   define variable v-length as integer no-undo .
     4132   define variable nam-2str-shift as integer no-undo .
     4133   define variable chk_name as character no-undo .
     4134   assign
     4135   v-length = (if p-pos-type = 'IBM':U then 25 else 40 )
     4136   v-length = (if p-pos-type = 'MARIA':U then 24 else v-length)
     4137   v-length = (if p-pos-type = 'MARIA':U and lookup('топ':U, p-unit-cli-type) > 0
     4138               then 5
     4139               else v-length)
     4140   v-length = (if p-pos-type = 'IBM-XML':U then 128 else v-length )
     4141   nam-2str-shift = (if p-nam-2str then v-length else 0)
     4142   .
     4143   if p-nam-artc then do:
     4144     assign
     4145     chk_name = substitute("&1 &2", p-artic, p-f-name)
     4146       .
     4147   end.
     4148   else  do:
     4149     assign
     4150     chk_name = replace(p-gds-name, chr(34), "":U) + p-f-name
     4151     .
     4152   end.
     4153   if p-unit-base <> p-unit-cli then do:
     4154     if length (chk_name) > 109 then chk_name = substring (chk_name,1,109) .
     4155     assign
     4156     chk_name = string(substr(chk_name
     4157                               ,1
     4158                               ,max(14, v-length + nam-2str-shift - 1 - length(trim(string(p-cli-base-rate), chr(32)))) +  nam-2str-shift ) +
     4159                       "*":U +
     4160                       trim(string(p-cli-base-rate), chr(32)), "x(":U + string(v-length + nam-2str-shift) + ")":U ).
     4161   end.
     4162   else do:
     4163     chk_name = string(chk_name, "X(":U + string(v-length + nam-2str-shift) + ")":U).
     4164   end.
     4165   if p-nam-2str then do:
     4166     assign
     4167     p-second-name = chr(34) + trim(substr(chk_name, v-length)," ") + chr(34)
     4168     chk_name = substr(chk_name, 1, v-length)
     4169     .
     4170   end.
     4171   else do:
     4172     assign
     4173     p-second-name = replace(p-gds-name1, chr(39), "":U)
     4174     p-second-name =   (chr(34) +
     4175                       TRIM(string( replace(p-second-name, chr(34), "":U), "X(":U + string(v-length) + ")":U ))
     4176                       + chr(34) )
     4177     .
     4178   end.
     4179   return chk_name.
     4180   end function.
     4181   def var vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4182   procedure disrules-get-interface-form :
     4183   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
     4184   define output parameter p-form-name as character no-undo .
     4185   define buffer buf_temp-drt-prop for temp-drt-prop.
     4186   define buffer buf_drt-prop for ub.drt-prop.
     4187   find first buf_temp-drt-prop where
     4188             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
     4189         and buf_temp-drt-prop.upper-prop-code = "InputForm"
     4190         and buf_temp-drt-prop.prop-code = "FormName" no-error.
     4191   if not available buf_temp-drt-prop then do:
     4192     find first buf_drt-prop where
     4193               buf_drt-prop.templ-rl-root = p-templ-rl-root
     4194           and buf_drt-prop.upper-prop-code = "InputForm"
     4195           and buf_drt-prop.prop-code = "FormName" no-error.
     4196     if available buf_drt-prop then do:
     4197       p-form-name = buf_drt-prop.property-value.
     4198     end.
     4199     else do:
     4200       p-form-name = "ref/dis-ruli.w".
     4201     end.
     4202   end.
     4203   else do:
     4204     p-form-name = buf_temp-drt-prop.property-value.
     4205   end.
     4206   end procedure.
