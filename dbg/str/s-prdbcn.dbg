    10046   vGdsTabak = if vaction = "D" then yes else no.
    10047   find first buf_goods-attr where buf_goods-attr.gds-code = cash-gds.gds-code
    10048                 and buf_goods-attr.attr-code  = 'mark-type':U and buf_goods-attr.attr-value <> "not-type" no-error .
