    11021                   put unformatted (fill(" " , 16 -  length(bar_code)) + bar_code) '00101'
    11022                                                 caps(string(chk_name,'x(20)'))
    11023                                                 string(( cash-gds.price-sale * 100 ) ,'99999999') .
    11024                   put unformatted '0000000000000000000000000000000'
    11025                   string(action, "X(1)") '0000000000000'.
    11026                   put skip.
    11027               end.
    11028           end.
    11029           else do:
    11030             put unformatted ( fill(" " , 16 -  length(cash-gds.b-str)) + cash-gds.b-str )
    11031                                       '00101' caps( string( chk_name, 'x(20)' ) )
    11032                                     string( ( cash-gds.price-sale * 100 ) ,'99999999') .
    11033             put unformatted '0000000000000000000000000000000'
    11034             string(action, "X(1)") '0000000000000'.
