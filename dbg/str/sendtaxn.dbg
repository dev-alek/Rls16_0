     2493                                             , input string(if cash-txr.rate-value = ?
     2494                                                            then 0
     2495                                                            else cash-txr.rate-value), input 1 ).
     2496       end.
     2497       run bgelib-tag-put in this-procedure ( input 4, input "TCInclude"
     2498                                             , input string(1), input 1 ).
     2499       run bgelib-tag-close in this-procedure ( input 3, input "TaxCodes").
     2500     end.
     2501     when 'MAGIA-XML':U then do:
