      111   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      112   procedure cur-time :
      113      define output parameter p-today as date      no-undo .
      114      define output parameter p-time  as integer   no-undo .
      115     do
      116     on error undo, return error
      117     :
      118       define variable v-date1 as date      no-undo .
      119       define variable v-date2 as date      no-undo .
      120       define variable v-time  as integer   no-undo .
      121       assign
      122         v-date1 = today
      123         v-time  = time
      124         v-date2 = today
      125       .
      126       if v-date1 <> v-date2
      127       then do:
      128         assign
      129           v-date1 = today
      130           v-time  = v-time
      131         .
      132       end.
      133       assign
      134         p-today = v-date1
      135         p-time  = v-time
      136       .
      137     end.
      138   end.
      139   function cur-time-date returns character
      140   :
      141     return string(today, '99/99/9999':U) .
      142   end.
      143   function cur-time-mjd returns decimal
      144   :
      145     define variable v-date as date      no-undo .
      146     define variable v-time as integer   no-undo .
      147     run cur-time in this-procedure
      148       (output v-date
      149       ,output v-time
      150       ) .
      151     return integer(v-date) - 2400002 + (v-time / 86400) .
      152   end.
      153   function cur-time-get-ending-index returns integer
      154   (input p-number as integer
      155   )
      156   :
      157     if p-number < 0
      158     or p-number = ?
      159     then do:
      160       return 1 .
      161     end.
      162     define variable v-rest as integer   no-undo .
      163     assign
      164       p-number = p-number modulo 100
      165     .
      166     if p-number < 20
      167     then do:
      168       assign
      169         v-rest = p-number
      170       .
      171     end.
      172     else do:
      173       assign
      174         v-rest = p-number modulo 10
      175       .
      176     end.
      177     case v-rest :
      178       when 1
      179       then do:
      180         return 2 .
      181       end.
      182       when 2 or
      183       when 3 or
      184       when 4
      185       then do:
      186         return 3 .
      187       end.
      188       otherwise do:
      189         return 1 .
      190       end.
      191     end case .
      192   end.
      193   procedure cur-time-mjd-to-date :
      194      define input  parameter i-mjd-diff as decimal no-undo.
      195      define output parameter o-Date     as date    no-undo.
      196      define output parameter o-Time     as integer no-undo.
      197      define variable v-day-number as integer   no-undo .
      198      if    i-mjd-diff < 0
      199         or i-mjd-diff = ?
      200      then do:
      201         return "?" .
      202      end.
      203      assign
      204         v-day-number = truncate(i-mjd-diff,0).
      205         o-Date = date(v-day-number + 2400002).
      206         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      207     .
      208   end.
      209   function cur-time-mjd-to-string returns character
      210   (input p-mjd-diff as decimal
      211   )
      212   :
      213     define variable v-day-number as integer   no-undo .
      214     define variable v-seconds    as integer   no-undo .
      215     define variable v-hour       as integer   no-undo .
      216     define variable v-min        as integer   no-undo .
      217     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      218     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      219     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      220     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      221     if p-mjd-diff < 0
      222     or p-mjd-diff = ?
      223     then do:
      224       return "?" .
      225     end.
      226     assign
      227       v-day-number = integer(truncate(p-mjd-diff,0))
      228       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      229     .
      230     if v-seconds > 86400
      231     then do:
      232       assign
      233         v-seconds = 86400 - 1
      234       .
      235     end.
      236     if v-seconds < 0
      237     then do:
      238       assign
      239         v-seconds = 0
      240       .
      241     end.
      242     assign
      243       v-hour = truncate(v-seconds / 3600, 0)
      244     .
      245     assign
      246       v-seconds = v-seconds modulo 3600
      247     .
      248     assign
      249       v-min = truncate(v-seconds / 60, 0)
      250     .
      251     assign
      252       v-seconds = v-seconds modulo 60
      253     .
      254     return
      255         (if v-day-number <> 0
      256           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      257           else ""
      258         )
      259       + (if v-day-number <> 0 or v-hour <> 0
      260           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      261           else ""
      262         )
      263       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      264           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      265           else ""
      266         )
      267       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      268       .
      269   end.
      270   function cur-time-string returns character
      271   :
      272     define variable v-date as date      no-undo .
      273     define variable v-time as integer   no-undo .
      274     run cur-time in this-procedure
      275       (output v-date
      276       ,output v-time
      277       ) .
      278     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      279   end.
      280   function cur-time-string-sec returns character
      281   :
      282     define variable v-date as date      no-undo .
      283     define variable v-time as integer   no-undo .
      284     run cur-time in this-procedure
      285       (output v-date
      286       ,output v-time
      287       ) .
      288     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      289   end.
      290   function cur-time-custom  returns character
      291   (input p-prefix as character
      292   ,input p-date-format as character
      293   ,input p-delimiter as character
      294   ,input p-time-format as character
      295   ,input p-suffix as character
      296   )
      297   :
      298     define variable v-date as date      no-undo .
      299     define variable v-time as integer   no-undo .
      300     run cur-time in this-procedure
      301       (output v-date
      302       ,output v-time
      303       ) .
      304     return
      305       p-prefix
      306       + string(v-date, p-date-format)
      307       + p-delimiter
      308       + string(v-time, p-time-format)
      309       + p-suffix
      310       .
      311   end.
      312   function cur-time-print  returns character
      313   :
      314     define variable v-date as date      no-undo .
      315     define variable v-time as integer   no-undo .
      316     run cur-time in this-procedure
      317       (output v-date
      318       ,output v-time
      319       ) .
      320     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      321   end.
      322   function cur-time-datetime returns datetime
      323   :
      324     define variable v-char as character no-undo .
      325     define variable v-datetime as datetime no-undo .
      326     v-char = cur-time-string().
      327     v-datetime = datetime(v-char).
      328     return  v-datetime.
      329   end.
      330   function cur-time-string-msec returns character
      331   :
      332     define variable v-date as datetime  no-undo .
      333     v-date = now.
      334     return string(v-date) .
      335   end.
      336   define variable vss-include-info4 as character format "X(65)" no-undo
      337   initial "@(#)$Workfile$ $Revision$".
      338   procedure xmlchar-test :
      339   define input parameter p-in-string          as character        no-undo.
      340   define output parameter p-out-string-enc    as character        no-undo.
      341   define output parameter p-out-string-dec    as character        no-undo.
      342   do
      343   on error undo, return error
      344   :
      345          run xmlchar-encode in this-procedure
      346       (
      347             input p-in-string
      348           , output p-out-string-enc
      349       ).
      350          run xmlchar-decode in this-procedure
      351       (
      352             input p-out-string-enc
      353           , output p-out-string-dec
      354       ).
      355   end.
      356   end .
      357   procedure xmlchar-encode :
      358   define input parameter p-in-string      as character        no-undo.
      359   define output parameter p-out-string    as character        no-undo.
      360       define variable v-position      as integer      no-undo.
      361       define variable v-current-char  as character    no-undo.
      362   do
      363   on error undo, return error
      364   :
      365       assign
      366           p-out-string = "":U
      367       .
      368       case p-in-string
      369       :
      370           when ?
      371           then do:
      372               assign
      373                   p-out-string = "?":U
      374               .
      375           end.
      376           when "?":U
      377           then do:
      378               assign
      379                   p-out-string = "&#63;":U
      380               .
      381           end.
      382           otherwise do:
      383               do v-position = 1 to length( p-in-string )
      384               :
      385                   assign
      386                       v-current-char = substring( p-in-string, v-position, 1 )
      387                   .
      388                   case v-current-char
      389                   :
      390                       when "&":U
      391                       then do:
      392                           assign
      393                               p-out-string = p-out-string + "&amp;":U
      394                           .
      395                       end.
      396                       when ">":U
      397                       then do:
      398                           assign
      399                               p-out-string = p-out-string + "&gt;":U
      400                           .
      401                       end.
      402                       when "<":U
      403                       then do:
      404                           assign
      405                               p-out-string = p-out-string + "&lt;":U
      406                           .
      407                       end.
      408                       when "'":U
      409                       then do:
      410                           assign
      411                               p-out-string = p-out-string + "&apos;":U
      412                           .
      413                       end.
      414                       when '"':U
      415                       then do:
      416                           assign
      417                               p-out-string = p-out-string + "&quot;":U
      418                           .
      419                       end.
      420                       when chr(1)
      421                       then do:
      422                           assign
      423                               p-out-string = p-out-string + "":U
      424                           .
      425                       end.
      426                       when chr(2)
      427                       then do:
      428                           assign
      429                               p-out-string = p-out-string + "":U
      430                           .
      431                       end.
      432                       when chr(3)
      433                       then do:
      434                           assign
      435                               p-out-string = p-out-string + "":U
      436                           .
      437                       end.
      438                       when chr(4)
      439                       then do:
      440                           assign
      441                               p-out-string = p-out-string + "":U
      442                           .
      443                       end.
      444                       when chr(5)
      445                       then do:
      446                           assign
      447                               p-out-string = p-out-string + "":U
      448                           .
      449                       end.
      450                       when chr(6)
      451                       then do:
      452                           assign
      453                               p-out-string = p-out-string + "":U
      454                           .
      455                       end.
      456                       when chr(7)
      457                       then do:
      458                           assign
      459                               p-out-string = p-out-string + "":U
      460                           .
      461                       end.
      462                       when chr(8)
      463                       then do:
      464                           assign
      465                               p-out-string = p-out-string + "":U
      466                           .
      467                       end.
      468                       when chr(9)
      469                       then do:
      470                           assign
      471                               p-out-string = p-out-string + "":U
      472                           .
      473                       end.
      474                       when chr(29)
      475                       then do:
      476                           assign
      477                               p-out-string = p-out-string + "":U
      478                           .
      479                       end.
      480                       when chr(10)
      481                       then do:
      482                           assign
      483                               p-out-string = p-out-string + "&#10;":U
      484                           .
      485                       end.
      486                       when chr(13)
      487                       then do:
      488                           assign
      489                               p-out-string = p-out-string + "&#13;":U
      490                           .
      491                       end.
      492                       otherwise do:
      493                           assign
      494                               p-out-string = p-out-string + v-current-char
      495                           .
      496                       end.
      497                   end case.
      498               end.
      499           end.
      500       end case.
      501   end.
      502   end .
      503   procedure xmlchar-encode-1c :
