     1286   procedure xml-cd-write-header:
     1287   do
     1288   on error undo, return error
     1289   :
     1290   define input parameter p-xml-file-name       as character    no-undo.
     1291   define input parameter p-xml-file-name-path  as character    no-undo.
     1292   define input parameter p-doc-name            as character    no-undo.
     1293   define input parameter p-version             as character    no-undo.
     1294   define input parameter p-obj-list            as character    no-undo.
     1295   define input parameter p-correspondent       as character    no-undo .
     1296   define input parameter p-write-header        as logical      no-undo .
     1297   define variable OS-time as character no-undo .
     1298   define variable id as character no-undo .
     1299   define buffer buf_db for ub.db.
     1300   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     1301   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     1302   assign
     1303   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     1304   .
     1305   run bgelib-tag-open in this-procedure (
     1306                                        1
     1307                                       ,p-doc-name
     1308                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     1309                                         ).
     1310   if p-write-header then do:
     1311     run bgelib-tag-open(2, "Header","").
     1312     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     1313     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     1314     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     1315     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     1316     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     1317     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     1318     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     1319     find first buf_db where buf_db.db-num = g#db-num no-lock.
     1320     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     1321     run bgelib-tag-close( 2, "Header" ).
     1322   end.
     1323   output stream stmXMLOut close.
     1324   end.
     1325   end procedure.
     1326   procedure xml-cd-write-footer:
     1327   do
     1328   on error undo, return error
     1329   :
     1330   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     1331   define input parameter p-xml-file-name as character    no-undo.
     1332   define input parameter p-doc-name      as character    no-undo .
     1333   define variable v-error-num     as integer           no-undo.
     1334   define variable v-md5-signature as character no-undo .
     1335   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1336   run bgelib-tag-close( 0, p-doc-name ).
     1337   put stream stmXMLOut unformatted skip.
     1338   output stream stmXMLOut close.
     1339   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1340   if v-error-num > 0
     1341   then do:
     1342      return error.
     1343   end.
     1344   if opsys = "unix"
     1345   then do:
     1346       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1347   end.
     1348   end.
     1349   end procedure.
     1350   procedure xml-cd-filename :
     1351   do
     1352   on error undo, return error
     1353   :
     1354   define input parameter  p-out               as character no-undo .
     1355   define output parameter p-xml-file-name     as character    no-undo.
     1356   define output parameter p-xml-file-name-path   as character    no-undo.
     1357   define output parameter p-log-file-name     as character    no-undo.
     1358   define output parameter p-locked            as logical      no-undo.
     1359   define variable v-out as character     no-undo.
     1360   define variable loc#log as logical no-undo .
     1361   define variable BadFlag as logical no-undo .
     1362   define variable fq as integer no-undo .
     1363   define variable v-remote as character no-undo .
     1364   assign
     1365   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     1366   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     1367   p-log-file-name = p-out + "actions.log"
     1368   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     1369   .
     1370   end.
     1371   end procedure.
     1372   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     1373   define variable v-date-str as character no-undo .
     1374   assign
     1375   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1376                string(Month(p-date), "99":U) + "-":U +
     1377                string(DAY(p-date), "99":U).
     1378   return v-date-str.
     1379   END FUNCTION.
     1380   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     1381   define variable v-date-str as character no-undo .
     1382   assign
     1383   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1384                string(Month(p-date), "99":U) + "-":U +
     1385                string(DAY(p-date), "99":U) + chr(32) +
     1386                string(p-time, "HH:MM:SS").
     1387   return v-date-str.
     1388   END FUNCTION.
     1389   function string-to-date returns date ( input p-string  as character):
     1390     define variable v-date as date no-undo .
     1391     assign
     1392     v-date = date(integer(substring(p-string, 4, 2))
     1393                   ,integer(substring(p-string, 1, 2))
     1394                   ,integer(substring(p-string, 7, 4))
     1395                  ) no-error .
     1396     if error-status:error then return ?.
     1397     return v-date.
     1398   END FUNCTION.
     1399   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     1400   define variable v-time as integer no-undo init ?.
     1401   define variable v-dop1 as character no-undo .
     1402   define variable v-dop2 as character no-undo .
     1403   assign
     1404   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     1405   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     1406   no-error .
     1407   if error-status:error then return ?.
     1408   assign
     1409   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     1410             integer(entry(2, v-dop2, ";":U)) * 60 +
     1411             integer(entry(3, v-dop2, ";":U)) no-error .
     1412   return v-time.
     1413   END FUNCTION.
