     1578   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     1579   define variable v-is-closed-shift-journal as integer no-undo .
     1580   assign
     1581   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     1582                               +
     1583                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     1584                               +
     1585                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     1586   .
     1587   return v-is-closed-shift-journal.
     1588   END FUNCTION.
     1589   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     1590   define variable v-is-first-journal as logical no-undo .
     1591   assign
     1592   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     1593                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     1594                     or (p-journal-num =  integer(entry(1, '17':U)))
     1595                     or (p-journal-num = integer(entry(1, '16':U)))
     1596   .
     1597   return v-is-first-journal.
     1598   END FUNCTION.
     1599   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     1600   define variable v-is-petrol-journal as logical no-undo .
     1601   assign
     1602   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     1603   return v-is-petrol-journal.
     1604   END FUNCTION.
     1605   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     1606   define variable v-max-record-num as integer no-undo .
     1607   assign
     1608   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     1609                       then 1489
     1610                       else 2340).
     1611   return v-max-record-num.
     1612   END FUNCTION.
     1613   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     1614   define variable v-max-record-num as integer no-undo .
     1615   assign
     1616   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     1617                       then 1489 * num-entries('30,31,32,33':U)
     1618                       else 2340 * num-entries('17':U)).
     1619   return v-max-record-num.
     1620   END FUNCTION.
     1621   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     1622                                           ,input p-rec-no as integer):
     1623   define variable v-num-recs as integer no-undo .
     1624   if tekka-is-petrol-journal (p-journal-num) then do:
     1625     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     1626       assign
     1627       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     1628       .
     1629     end.
     1630     else do:
     1631       assign
     1632       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     1633       .
     1634     end.
     1635   end.
     1636   else do:
     1637     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     1638       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     1639         assign
     1640         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     1641         .
     1642       end.
     1643       else do:
     1644         assign
     1645         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     1646         .
     1647       end.
     1648     end.
     1649     else do:
     1650       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     1651         assign
     1652         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     1653         .
     1654       end.
     1655       else do:
     1656         assign
     1657         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     1658         .
     1659       end.
     1660     end.
     1661   end.
     1662   return v-num-recs.
     1663   END FUNCTION.
     1664   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     1665                                              ,input p-is-petrol as logical
     1666                                              ,input p-is-current as logical
     1667                                              ,output p-rec-no as decimal
     1668                                              ):
     1669   define variable v-obj-num0 as integer no-undo .
     1670   define variable v-obj-num as integer no-undo .
     1671   define variable v-obj-num2 as integer no-undo .
     1672   define variable p-num-recs2 as integer no-undo .
     1673   define variable p-rec-no2 as integer no-undo .
     1674   if p-is-petrol then do:
     1675     assign
     1676     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     1677     .
     1678     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     1679     then
     1680     assign
     1681     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     1682     p-rec-no = p-num-recs modulo 1489
     1683     .
     1684     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     1685     then
     1686     assign
     1687     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     1688     p-rec-no = p-num-recs modulo 1489
     1689     .
     1690   end.
     1691   else do:
     1692     assign
     1693     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     1694     p-num-recs = trunc(p-num-recs, 0)
     1695     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     1696     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     1697     .
     1698     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     1699     then
     1700     assign
     1701     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     1702     p-rec-no = p-num-recs modulo 2340
     1703     .
     1704     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     1705     then
     1706     assign
     1707     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     1708     p-rec-no = p-num-recs modulo 2340
     1709     .
     1710     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     1711     then
     1712     assign
     1713     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     1714     p-rec-no2 = p-num-recs2 modulo 2978
     1715     .
     1716     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     1717     then
     1718     assign
     1719     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     1720     p-rec-no2 = p-num-recs2 modulo 2978
     1721     .
     1722     assign
     1723     p-rec-no = p-rec-no + p-rec-no2 / 10000
     1724     .
     1725   end.
     1726   if v-obj-num = 0 then v-obj-num = 100.
     1727   return v-obj-num.
     1728   END FUNCTION.
     1729   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     1730   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     1731   if lookup (string(p-obj-num), '17':U) > 0 then do:
     1732      if p-is-ptrl then
     1733      return integer(entry(1, '26,27,28,29':U)).
     1734      if not p-is-ptrl then
     1735      return integer(entry(1, '16':U)).
     1736   end.
     1737   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     1738   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     1739   return 0.
     1740   END FUNCTION.
     1741   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     1742   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     1743   if lookup (string(p-obj-num), '17':U) > 0 then do:
     1744     if p-is-ptrl then
     1745     return integer(entry(1, '26,27,28,29':U)).
     1746     if not p-is-ptrl then
     1747     return integer(entry(1, '16':U)).
     1748   end.
     1749   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     1750   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     1751   return 0.
     1752   END FUNCTION.
     1753   PROCEDURE maria-put:
     1754   define parameter buffer buf_cash-desk for ub.cash-desk.
     1755   define input parameter p-out    as character no-undo .
     1756   define input parameter p-fname as character no-undo .
     1757   define input parameter p-by-record as logical no-undo .
     1758   define input parameter p-shift-fields as integer no-undo .
     1759   define input parameter p-binary as logical no-undo .
     1760   define input parameter p-obj-num as integer no-undo .
     1761   define input parameter p-max-records as integer no-undo .
     1762   define input parameter p-plu as integer no-undo .
     1763   define input parameter p-value as character no-undo .
     1764   define variable v-file-name as character no-undo .
     1765   define variable v-create as logical no-undo .
     1766   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1767   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     1768   output stream IBMSTREAM
     1769   to value(v-file-name) append .
     1770   Put  stream IBMSTREAM unformatted
     1771   p-plu
     1772   chr(3)
     1773   p-value
     1774   skip.
     1775   output stream IBMSTREAM
     1776   close.
     1777   if not p-by-record then do:
     1778     find first buf_temp-tekka-tsk where
     1779               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     1780     if not available buf_temp-tekka-tsk then do:
     1781       v-create = yes.
     1782     end.
     1783   end.
     1784   else do:
     1785     find first buf_temp-tekka-tsk where
     1786               buf_temp-tekka-tsk.filename  = v-file-name
     1787           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     1788     if not available buf_temp-tekka-tsk
     1789     then do:
     1790       find first buf_temp-tekka-tsk where
     1791                 buf_temp-tekka-tsk.filename  = v-file-name
     1792             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     1793       if not available buf_temp-tekka-tsk
     1794       then do:
     1795         v-create = yes.
     1796       end.
     1797     end.
     1798   end.
     1799   if v-create then do:
     1800     create buf_temp-tekka-tsk.
     1801     assign
     1802     buf_temp-tekka-tsk.filename = v-file-name
     1803     buf_temp-tekka-tsk.range    = p-plu
     1804     buf_temp-tekka-tsk.obj-num = p-obj-num
     1805     buf_temp-tekka-tsk.obj-name = '':U
     1806     buf_temp-tekka-tsk.num-records = 0
     1807     buf_temp-tekka-tsk.max-records = p-max-records
     1808     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     1809     buf_temp-tekka-tsk.task-num = p-fname
     1810     buf_temp-tekka-tsk.by-record = p-by-record
     1811     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     1812     buf_temp-tekka-tsk.binary = p-binary
     1813     buf_temp-tekka-tsk.send-get = 'send'
     1814     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1815     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1816     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1817     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1818                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1819                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1820                                 then 'local'
     1821                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1822     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1823     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1824     buf_temp-tekka-tsk.waiting-sek = 30
     1825     buf_temp-tekka-tsk.min-plu     = p-plu
     1826     buf_temp-tekka-tsk.max-plu     = p-plu
     1827     .
     1828   end.
     1829   assign
     1830   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     1831   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     1832   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     1833   .
     1834   END PROCEDURE.
     1835   PROCEDURE maria-get:
     1836   define parameter buffer buf_cash-desk for ub.cash-desk.
     1837   define input parameter p-out    as character no-undo .
     1838   define input parameter p-fname as character no-undo .
     1839   define input parameter p-by-record as logical no-undo .
     1840   define input parameter p-obj-num as integer no-undo .
     1841   define input parameter p-num-fields as integer no-undo .
     1842   define input parameter p-max-records as integer no-undo .
     1843   define input parameter p-min-plu as integer no-undo .
     1844   define input parameter p-max-plu as integer no-undo .
     1845   define input parameter p-other as character no-undo .
     1846   define input parameter p-order-num as integer no-undo .
     1847   define variable v-file-name as character no-undo .
     1848   define variable v-secondary-obj-num as character no-undo .
     1849   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1850   if p-by-record then do:
     1851     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     1852   end.
     1853   else do:
     1854     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     1855   end.
     1856   find first buf_temp-tekka-tsk where
     1857             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     1858   if not available buf_temp-tekka-tsk then do:
     1859     create buf_temp-tekka-tsk.
     1860     assign
     1861     buf_temp-tekka-tsk.filename = v-file-name
     1862     buf_temp-tekka-tsk.obj-num = p-obj-num
     1863     buf_temp-tekka-tsk.obj-name = '':U
     1864     buf_temp-tekka-tsk.max-records = p-max-records
     1865     buf_temp-tekka-tsk.num-fields = p-num-fields
     1866     buf_temp-tekka-tsk.task-num = p-fname
     1867     buf_temp-tekka-tsk.by-record = p-by-record
     1868     buf_temp-tekka-tsk.send-get = 'get'
     1869     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1870     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1871     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1872     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1873                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1874                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1875                                   then 'local'
     1876                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1877     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1878     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1879     buf_temp-tekka-tsk.waiting-sek = 30
     1880     buf_temp-tekka-tsk.min-plu     = p-min-plu
     1881     buf_temp-tekka-tsk.max-plu     = p-max-plu
     1882     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     1883                                       and p-max-plu <> ?
     1884                                       then p-max-plu - p-min-plu + 1
     1885                                       else 0)
     1886     buf_temp-tekka-tsk.other-info = p-other
     1887     buf_temp-tekka-tsk.order-num = p-order-num
     1888     .
     1889     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     1890       assign
     1891       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     1892       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     1893       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     1894       no-error
     1895       .
     1896       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     1897     end.
     1898   end.
     1899   END PROCEDURE.
     1900   PROCEDURE maria-task:
     1901   define parameter buffer buf_cash-desk for ub.cash-desk.
     1902   define input parameter p-fname as character no-undo .
     1903   define input parameter p-obj-num-list as character no-undo .
     1904   define input parameter p-parameters as character no-undo .
     1905   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1906   find first buf_temp-tekka-tsk where
     1907             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     1908   if not available buf_temp-tekka-tsk then do:
     1909     create buf_temp-tekka-tsk.
     1910     assign
     1911     buf_temp-tekka-tsk.filename = ''
     1912     buf_temp-tekka-tsk.range = 1
     1913     buf_temp-tekka-tsk.obj-num = 0
     1914     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     1915     buf_temp-tekka-tsk.task-num = p-fname
     1916     buf_temp-tekka-tsk.by-record = no
     1917     buf_temp-tekka-tsk.send-get = 'task'
     1918     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1919     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1920     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1921     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1922                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1923                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1924                                   then 'local'
     1925                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1926     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1927     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1928     buf_temp-tekka-tsk.waiting-sek = 30
     1929     buf_temp-tekka-tsk.other-info = p-parameters
     1930     buf_temp-tekka-tsk.order-num = 0
     1931     .
     1932   end.
     1933   END PROCEDURE.
     1934   procedure tekkatsk-verify-schema :
     1935   define input parameter p-obj-list as character no-undo .
     1936   define input parameter p-dir-path as character no-undo .
     1937   define variable v-obj-num as integer no-undo .
     1938   define variable v-obj-name as character no-undo .
     1939   define variable v-num-records as integer no-undo .
     1940   define variable v-size_ as integer no-undo .
     1941   define variable v-value as character no-undo .
     1942   define variable ii as integer no-undo .
     1943   define variable jj as integer no-undo .
     1944   define variable ii-ibs as integer no-undo .
     1945   define variable ii-tekka as integer no-undo .
     1946   define variable v-result as character no-undo .
     1947   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     1948   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     1949     do
     1950     on error undo, return error
     1951     :
     1952        for each buf_temp-tekka-schema:
     1953          delete buf_temp-tekka-schema.
     1954        end.
     1955        input from value('tekkasch.d').
     1956        repeat :
     1957          create buf_temp-tekka-schema.
     1958          import buf_temp-tekka-schema.
     1959          assign
     1960          buf_temp-tekka-schema.host = 'IBS'
     1961          ii = ii + 1.
     1962          .
     1963        end.
     1964        input close.
     1965        ii-ibs = ii.
     1966         _ii:
     1967         do ii = 1 to 256:
     1968           if p-obj-list = "ALL"
     1969           or lookup(string(ii), p-obj-list) > 0 then do:
     1970             assign
     1971             v-obj-num = 0
     1972             v-obj-name = ''
     1973             v-num-records = 0
     1974             v-size_ = 0
     1975             .
     1976             run alienini-getkey in this-procedure (
     1977                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1978                                                     ,input ('obj' + string(ii, '999'))
     1979                                                     ,input 'oname'
     1980                                                     ,output v-value) no-error .
     1981             if v-value = ? then next _ii.
     1982             assign
     1983             v-obj-num = ii
     1984             v-obj-name = v-value
     1985             .
     1986             run alienini-getkey in this-procedure (
     1987                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1988                                                     ,input ('obj' + string(ii, '999'))
     1989                                                     ,input 'size'
     1990                                                     ,output v-value) no-error .
     1991             assign
     1992             v-num-records = integer(v-value) no-error  .
     1993             if error-status:error
     1994             or v-num-records = 0 then next _ii.
     1995             run alienini-getkey in this-procedure (
     1996                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1997                                                     ,input 'obj' + string(ii, '999')
     1998                                                     ,input 'f000'
     1999                                                     ,output v-value) no-error .
     2000             assign
     2001             v-size_ = integer(v-value) no-error  .
     2002             if error-status:error
     2003             or v-size_ = 0 then next _ii.
     2004             _jj:
     2005             do jj = 1 to 256:
     2006               run alienini-getkey in this-procedure (
     2007                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2008                                                       ,input 'obj' + string(ii, '999')
     2009                                                       ,input 'f' + string(jj, '999')
     2010                                                       ,output v-value) no-error .
     2011               if v-value = ? then next _ii.
     2012               create buf_temp-tekka-schema.
     2013               assign
     2014               buf_temp-tekka-schema.host = 'tekka'
     2015               buf_temp-tekka-schema.obj-num = v-obj-num
     2016               buf_temp-tekka-schema.obj-name = v-obj-name
     2017               buf_temp-tekka-schema.num-records = v-num-records
     2018               buf_temp-tekka-schema.size_ = v-size_
     2019               buf_temp-tekka-schema.field-num = jj
     2020               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     2021               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     2022                                                  then entry(2, entry(2, v-value, '#'), ':')
     2023                                                  else '':U)
     2024               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     2025               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     2026               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     2027                                                           , 'C,I,I,I,D,D,D,D,D':U)
     2028               no-error
     2029               .
     2030               if error-status:error then do:
     2031                 delete buf_temp-tekka-schema.
     2032                 next _jj.
     2033               end.
     2034               run alienini-getkey in this-procedure (
     2035                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2036                                                       ,input 'obj' + string(ii, '999') + 'name'
     2037                                                       ,input 'n' + string(jj, '999')
     2038                                                       ,output v-value) no-error .
     2039               if v-value <> ? then
     2040               buf_temp-tekka-schema.field-name = v-value.
     2041             end.
     2042           end.
     2043         end.
     2044         ii-tekka = ii - 1.
     2045        if p-obj-list <> 'ALL' then do:
     2046         if ii-tekka <> ii-ibs then do:
     2047           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     2048                                   , ii-ibs
     2049                                   , ii-tekka).
     2050         end.
     2051        end.
     2052        for each buf_temp-tekka-schema where
     2053               buf_temp-tekka-schema.host = 'tekka':
     2054          find first buf2_temp-tekka-schema where
     2055                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     2056                AND buf2_temp-tekka-schema.host = 'ibs'
     2057                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     2058          if not available buf2_temp-tekka-schema then do:
     2059           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     2060                                   , buf_temp-tekka-schema.field-num
     2061                                   , buf_temp-tekka-schema.obj-num).
     2062          end.
     2063          buffer-compare buf_temp-tekka-schema
     2064          to buf2_temp-tekka-schema
     2065          save result in v-result.
     2066          if v-result <> '':U then do:
     2067           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     2068                                   , buf_temp-tekka-schema.field-num
     2069                                   , buf_temp-tekka-schema.obj-num).
     2070          end.
     2071        end.
     2072     end.
     2073   end procedure.
     2074   FUNCTION set-Sx returns character (input p-string as character):
     2075   return p-string.
     2076   END FUNCTION.
     2077   FUNCTION get-Sx returns character (input p-string  as character):
     2078   return p-string.
     2079   END FUNCTION.
     2080   FUNCTION set-B returns character (input p-string  as character):
     2081   return chr(integer(p-string)).
     2082   END FUNCTION.
     2083   FUNCTION get-B returns character (input p-string  as character):
     2084   return string(asc(p-string)).
     2085   END FUNCTION.
     2086   FUNCTION set-BF returns character (input p-string  as character):
     2087   define variable v-dopi as integer no-undo .
     2088   define variable ii as integer no-undo .
     2089   do ii = 1 to 8:
     2090     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     2091   end.
     2092   return chr(v-dopi).
     2093   END FUNCTION.
     2094   FUNCTION get-BF returns character (input p-string  as character):
     2095   define variable v-dopi as integer no-undo .
     2096   define variable v-dops as character no-undo .
     2097   define variable ii as integer no-undo .
     2098   v-dopi = asc(p-string).
     2099   do ii = 8 to 1 BY -1:
     2100     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     2101   end.
     2102   return v-dops.
     2103   END FUNCTION.
     2104   FUNCTION set-BN returns character (input p-string  as character
     2105                                     ,input p-bin-group as character):
     2106   define variable v-dopi as integer no-undo .
     2107   define variable ii as integer no-undo .
     2108   define variable jj as integer no-undo .
     2109   define variable v-grp-nums as integer no-undo .
     2110   define variable v-dopi2 as integer no-undo .
     2111   v-grp-nums = num-entries(p-bin-group).
     2112   do jj = 0 to v-grp-nums - 1:
     2113     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     2114     do ii = 1 to 8:
     2115       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     2116     end.
     2117   end.
     2118   return chr(v-dopi).
     2119   END FUNCTION.
     2120   FUNCTION get-BN returns character (input p-string  as character
     2121                                     ,input p-bin-group as character):
     2122   define variable v-dopi as integer no-undo .
     2123   define variable v-dops as character no-undo .
     2124   define variable v-grp-nums as integer no-undo .
     2125   define variable ii as integer no-undo .
     2126   define variable jj as integer no-undo .
     2127   v-dopi = asc(p-string).
     2128   v-grp-nums = num-entries(p-bin-group).
     2129   do jj = 1 to v-grp-nums:
     2130   do ii = 8 to 1 BY -1:
     2131     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     2132   end.
     2133   end.
     2134   return v-dops.
     2135   END FUNCTION.
     2136   procedure fill-temp-cd :
     2137   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     2138   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     2139   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     2140   define input parameter p-clear-table as logical no-undo .
     2141   define buffer buf_temp-cd for temp-cd.
     2142   define buffer buf_cash-desk for ub.cash-desk.
     2143     do
     2144     on error undo, return error
     2145     :
     2146        if p-clear-table  then do:
     2147          for each buf_temp-cd:
     2148            delete buf_temp-cd.
     2149          end.
     2150        end.
     2151        for each buf_cash-desk no-lock where
     2152               buf_cash-desk.db-num = p-db-num
     2153           AND buf_cash-desk.obj-code = p-obj-code
     2154           and buf_cash-desk.cash-on  = yes
     2155        BREAK by buf_cash-desk.pos-type:
     2156          if first-of(buf_cash-desk.pos-type) then do:
     2157            create buf_temp-cd.
     2158            buffer-copy buf_cash-desk to buf_temp-cd.
     2159          end.
     2160        end.
     2161     end.
     2162   end procedure.
     2163   define variable tax-cass as logical no-undo init no.
