     2550   PROCEDURE   for-cash-cycle:
     2551   DEFINE VARIABLE v-dir-remote as character no-undo .
     2552   DEFINE VARIABLE v-dir-remote-tmp as character no-undo .
     2553   define buffer for-cash-desk for ub.cash-desk.
     2554   FOR EACH for-cash-desk NO-LOCK WHERE
     2555           for-cash-desk.db-num = g#db-num AND
     2556           for-cash-desk.pos-type = ub.cash-desk.pos-type AND
     2557           for-cash-desk.obj-code = i-obj-code AND
     2558           for-cash-desk.cash-on  = yes:
     2559     run write-log-and-file in p-log-handle (
     2560           input 1
     2561         , input log-file-name
     2562         , input 1
     2563         , input substitute( "Пересылка - касса &1", for-cash-desk.cash-num
     2564                           )
     2565                                           ).
     2566       IF (LOOKUP(ub.cash-desk.pos-type,
     2567                 ('NCR-GM':U + chr(44) +
     2568                  'IBM-XML':U + chr(44) +
     2569                  'MAGIA-XML':U + chr(44) +
     2570                  'NCR-AS@R':U
     2571                    )) > 0
     2572        and for-cash-desk.autonomy = integer('1':U)) then NEXT.
     2573     if LOOKUP(ub.cash-desk.pos-type,
     2574               'MARIA':U
     2575                  ) > 0
     2576     and for-cash-desk.autonomy = integer('2':U) then do:
     2577       assign
     2578       v-cd-list-update = for-cash-desk.addr-path
     2579       v-cd-list-delete = for-cash-desk.addr-path
     2580       .
     2581       NEXT.
     2582     end.
     2583   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2584   case for-cash-desk.pos-type:
     2585       when 'IBM-XML':U or when 'Autotank':U
     2586     then do:
     2587   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2588   run xml-cd-filename in this-procedure (
     2589         input out
     2590       , output v-xml-file-name
     2591       , output v-xml-file-name-path
     2592       , output v-log-file-name
     2593       , output v-locked
     2594   ).
     2595   run write-log-and-file in p-log-handle (
     2596         input 1
     2597       , input log-file-name
     2598       , input 1
     2599       , input substitute( ("''" + " &1")
     2600                               , replace( v-xml-file-name-path, "/", "\" ) + "xm1"
     2601                         )
     2602                                         ).
     2603   run write-log-and-file in p-log-handle (
     2604         input 1
     2605       , input log-file-name
     2606       , input 1
     2607       , input substitute( "................с параметрами: ... магазин: &1", i-obj-code )
     2608                                         ).
     2609   assign
     2610   v-obj-list = 'маг':U + string(i-obj-code)
     2611   .
     2612   run xml-cd-write-header in this-procedure (
     2613         input v-xml-file-name
     2614       , input v-xml-file-name-path
     2615       , input 'data'
     2616       , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
     2617       , input v-obj-list
     2618       , input (
     2619                 (IF for-cash-desk.pos-type = 'IBM-XML':U
     2620                   then (if for-cash-desk.autonomy = integer('0':U)
     2621                         then  ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
     2622                         else ("КМ"   )
     2623                         )
     2624                   else ("маг" + string(for-cash-desk.obj-code) +  "_касса" + string(for-cash-desk.cash-num))
     2625                   )
     2626               )
     2627       , input (if for-cash-desk.autonomy = integer('0':U) then no else yes)
     2628   ).
     2629   output stream stmxmlout to value( v-xml-file-name-path + "xm1" ) convert target "1251" append.
     2630   OS2-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9").
     2631     end.
     2632     when 'MAGIA-XML':U then do:
     2633   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2634   run xml-cd-filename in this-procedure (
     2635         input out
     2636       , output v-xml-file-name
     2637       , output v-xml-file-name-path
     2638       , output v-log-file-name
     2639       , output v-locked
     2640   ).
     2641   run write-log-and-file in p-log-handle (
     2642         input 1
     2643       , input log-file-name
     2644       , input 1
     2645       , input substitute( ("''" + " &1")
     2646                               , replace( v-xml-file-name-path, "/", "\" ) + "xm1"
     2647                         )
     2648                                         ).
     2649   run write-log-and-file in p-log-handle (
     2650         input 1
     2651       , input log-file-name
     2652       , input 1
     2653       , input substitute( "................с параметрами: ... магазин: &1", i-obj-code )
     2654                                         ).
     2655   assign
     2656   v-obj-list = 'маг':U + string(i-obj-code)
     2657   .
     2658   run xml-cd-write-header in this-procedure (
     2659         input v-xml-file-name
     2660       , input v-xml-file-name-path
     2661       , input 'data'
     2662       , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
     2663       , input v-obj-list
     2664       , input (
     2665                 (IF for-cash-desk.pos-type = 'IBM-XML':U
     2666                   then (if for-cash-desk.autonomy = integer('0':U)
     2667                         then  ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
     2668                         else ("КМ"   )
     2669                         )
     2670                   else ("маг" + string(for-cash-desk.obj-code) +  "_касса" + string(for-cash-desk.cash-num))
     2671                   )
     2672               )
     2673       , input (if for-cash-desk.autonomy = integer('0':U) then no else yes)
     2674   ).
     2675   output stream stmxmlout to value( v-xml-file-name-path + "xm1" ) convert target "1251" append.
     2676   OS2-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9").
     2677     end.
     2678     when 'IBM':U
     2679     then do:
     2680   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2681   if for-cash-desk.cash-os = ""
     2682   AND for-cash-desk.pos-type <> 'Emulator-NKT-IBM':U
     2683   then NEXT.
     2684   assign
     2685   Cash-OS2 = (for-cash-desk.cash-os = "OS/2":U) OR (for-cash-desk.cash-os = "LINUX":U)
     2686               AND for-cash-desk.pos-type <> 'Emulator-NKT-IBM':U
     2687   Cash-DOS = NOT CASH-OS2
     2688   fname = substring( string( next-value( s-spool, ub ), '99999999999999999999'), 13, 8 )
     2689   v-dir-remote-tmp = v-remote + "tmp":U
     2690   v-dir-remote = v-remote + "out":U + string(for-cash-desk.obj-code, "99999") + "-" + string(for-cash-desk.cash-num, "999")
     2691   .
     2692   if for-cash-desk.remote = 1 then do:
     2693     run gbl/dir-cre.p ( input v-dir-remote-tmp) no-error .
     2694       if error-status:error then do:
     2695         run write-log-and-file in p-log-handle (
     2696               input 1
     2697             , input log-file-name
     2698             , input 1
     2699             , input substitute("!!!Каталог &1  для отсылки запроса на удаленную кассу &2 не найден&3" +
     2700                               "и/или попытка его создания не удалась"
     2701                               ,v-dir-remote-tmp
     2702                               ,for-cash-desk.cash-num
     2703                               ,chr(10)
     2704                               )
     2705                                               ).
     2706         NEXT.
     2707     end.
     2708     run gbl/dir-cre.p ( input v-dir-remote ) no-error .
     2709       if error-status:error then do:
     2710         run write-log-and-file in p-log-handle (
     2711               input 1
     2712             , input log-file-name
     2713             , input 1
     2714             , input substitute("!!!Каталог &1  для отсылки запроса на удаленную кассу &2 не найден&3" +
     2715                               "и/или попытка его создания не удалась"
     2716                               ,v-dir-remote
     2717                               ,for-cash-desk.cash-num
     2718                               ,chr(10)
     2719                               )
     2720                                               ).
     2721         NEXT.
     2722       end.
     2723   end.
     2724   output stream IBMStream
     2725   to value( (if for-cash-desk.remote = 1
     2726               then (v-dir-remote-tmp + chr(47) + "fl":U)
     2727               else out) + fname + '.dat' ) convert target "ibm866".
     2728   OS2-time =       ( if Cash-OS2 then
     2729                                       string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     2730                         else "" )
     2731   .
     2732     end.
     2733     when 'MARIA':U then do:
     2734   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2735   fname = substring( string( next-value( s-spool, ub ), '99999999999999999999'), 13, 8 ).
     2736     end.
     2737   END CASE.
     2738     FOR EACH cash-txn NO-LOCK:
     2739         RUN putc-12 in this-procedure ( buffer for-cash-desk
     2740                     ,input for-cash-desk.pos-type
     2741                     ,input for-cash-desk.cash-os ).
     2742     end.
     2743     run putc-15 in this-procedure (
     2744                                     input for-cash-desk.pos-type
     2745                                    ,input for-cash-desk.cash-os).
     2746   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2747   case for-cash-desk.pos-type:
     2748       when 'IBM-XML':U or when 'Autotank':U
     2749     then do:
     2750   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2751   output stream stmxmlout close.
     2752   run xml-cd-write-footer in this-procedure ( input for-cash-desk.pos-type, input v-xml-file-name-path
     2753       , input 'data'
     2754   ).
     2755   run write-log-and-file in p-log-handle (
     2756         input 1
     2757       , input log-file-name
     2758       , input 1
     2759       , input substitute( "Данные выгружены в файл &1"
     2760                               , replace( v-xml-file-name-path, "/", "\" ) + "xml"
     2761                         )
     2762                                          ).
     2763   if (
     2764   not (g#news or g#auto or g#esys )
     2765   or
     2766   (
     2767   for-cash-desk.pos-type = 'MAGIA-XML':U
     2768   or
     2769     (for-cash-desk.pos-type = 'IBM-XML':U
     2770   or (for-cash-desk.pos-type = 'Autotank':U
     2771     and
     2772     for-cash-desk.autonomy = integer('2':U))
     2773     )))
     2774   then do:
     2775     if for-cash-desk.pos-type = 'MAGIA-XML':U then do:
     2776       run str/waitpxml.w ( replace( v-xml-file-name-path, "/", "\" ) + "xml",
     2777                   (replace(in_ + spl + "/" + v-xml-file-name, "/", "\" ) + ".xml"),
     2778                   ( if action = 'U'
     2779                     then ('Ждите - ' + 'добавление категорий и ставок налогов')
     2780                     else ('Ждите - ' + 'удаление категорий и ставок налогов') ) +
     2781                     substitute("Маг&1 касса&2", for-cash-desk.obj-code, for-cash-desk.cash-num),
     2782                     ' Подождите 15 сек ',
     2783                     'Касса не ответила. Если Вы уверены, что с ней нет связи нажмите кнопку!',
     2784                     'Подождите: касса обрабатывает запрос',
     2785                     15 ) no-error.
     2786       if error-status:error then do:
     2787         os-delete value( replace( v-xml-file-name-path, "/", "\" ) + "xml" ) .
     2788         run write-log-and-file in p-log-handle (
     2789               input 1
     2790             , input log-file-name
     2791             , input 1
     2792             , input substitute( "!!!Прерван обмен информацией с кассой &1, на кассе осталась устаревшая информация",
     2793                                   for-cash-desk.cash-num
     2794                               )
     2795                                               ).
     2796         assign
     2797         v-view-log = yes
     2798         .
     2799         return "error":U.
     2800       end.
     2801     end.
     2802     if (for-cash-desk.pos-type = 'IBM-XML':U
     2803     and for-cash-desk.autonomy = integer('0':U))
     2804     or (for-cash-desk.pos-type = 'Autotank':U
     2805     and for-cash-desk.autonomy = integer('2':U))
     2806     then do:
     2807       run str/post-xml.p
     2808         (
     2809          input parparentproc
     2810         ,input p-parent-handle
     2811         ,input p-log-handle
     2812         ,input g#news or g#esys
     2813         ,input g#auto
     2814         ,input 'send'
     2815         ,input log-file-name
     2816         ,input (entry(1, for-cash-desk.addr-path, chr(4)) + '://' + entry(2, for-cash-desk.addr-path, chr(4)))
     2817         ,input (replace( v-xml-file-name-path, "/", "\" ) + "xml")
     2818         ,input (replace(in_ + spl + "/" + v-xml-file-name, "/", "\" ) + ".xml")
     2819         ,input 30
     2820         ,input   ( if action = 'U'
     2821                     then ('Ждите - ' + 'добавление категорий и ставок налогов')
     2822                     else ('Ждите - ' + 'удаление категорий и ставок налогов') ) +
     2823                     substitute("Маг&1 касса&2", for-cash-desk.obj-code, for-cash-desk.cash-num)
     2824         ) no-error .
     2825       if error-status:error
     2826       or return-value = "error" then do:
     2827         run write-log-and-file in p-log-handle (
     2828               input 1
     2829             , input log-file-name
     2830             , input 1
     2831             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных:&3&4 &5"
     2832                                   ,for-cash-desk.obj-code
     2833                                   ,for-cash-desk.cash-num
     2834                                   , chr(10)
     2835                                   , error-status:get-message(1)
     2836                                   , return-value
     2837                               )
     2838                                               ).
     2839         assign
     2840         v-view-log = yes
     2841         .
     2842       end.
     2843     end.
     2844     if not available ub.shop then do:
     2845       find first ub.shop no-lock where
     2846                 ub.shop.obj-code = for-cash-desk.obj-code.
     2847     end.
     2848     if
     2849     not (g#news or g#esys)
     2850     then do:
     2851       run str/getxibmf.p (
     2852                       input parparentproc
     2853                     ,input p-log-handle
     2854                     ,input 'маг':U
     2855                     ,input for-cash-desk.obj-code
     2856                     ,input ub.shop.host-code
     2857                     ,input in_
     2858                     ,input spl
     2859                     ,input (in_ + sav)
     2860                     ,input for-cash-desk.pos-type
     2861                     ,input (if (for-cash-desk.pos-type = 'IBM-XML':U
     2862                             and for-cash-desk.autonomy = integer('0':U))
     2863                             or (for-cash-desk.pos-type = 'Autotank':U
     2864                             and for-cash-desk.autonomy = integer('2':U))
     2865                             then "utf-8":U
     2866                             else "windows-1251")
     2867                     ,input log-file-name
     2868                     ,input "data":U
     2869                     ,input v-xml-file-name
     2870                     ,input-output v-view-log
     2871                     ) no-error .
