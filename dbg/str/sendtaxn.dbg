     3368     return error.
     3369   end.
     3370   run adm/shattri.p (
     3371       input "get":U
     3372       ,input  'маг':U
     3373       ,input  ub.cash-desk.obj-code
     3374       ,input  'cd-type-ibm':U
     3375       ,input  'cdtaxlst':U
     3376       ,output v-value-character
     3377       ,output v-value-date
     3378       ,output v-value-decimal
     3379       ,output v-value-integer
     3380       ,output v-value-logical
     3381       ,output v-param-type
     3382       ,INPUT-OUTPUT table-handle v-tth
     3383       ) no-error .
     3384   IF not error-status:error
     3385   then cdtaxlst = v-value-character.
     3386   run adm/shattri.p (
     3387       input "get":U
     3388       ,input  'маг':U
     3389       ,input  ub.cash-desk.obj-code
     3390       ,input  'cd-type-ibm':U
     3391       ,input  'cd-vat':U
     3392       ,output v-value-character
     3393       ,output v-value-date
     3394       ,output v-value-decimal
     3395       ,output v-value-integer
     3396       ,output v-value-logical
     3397       ,output v-param-type
     3398       ,INPUT-OUTPUT table-handle v-tth
     3399       ) no-error .
     3400   IF not error-status:error
     3401   then cd-vat = v-value-integer.
     3402     end.
     3403     when 'MARIA':U then do:
     3404   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3405   run str/get-inis.p (
     3406                   input 'маг':U
     3407                 , input ub.cash-desk.obj-code
     3408                 , input ub.cash-desk.pos-type
     3409                 , input cash-desk.remote
     3410                 , input "send":U
     3411                 , output out
     3412                 , output out2
     3413                 , output in_
     3414                 , output spl
     3415                 , output sav
     3416                 , output v-remote
     3417                 )  no-error .
     3418   if error-status:error then do:
     3419     run write-log-and-file in p-log-handle (
     3420           input 1
     3421         , input log-file-name
     3422         , input 1
     3423         , input substitute("!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     3424                             , ub.cash-desk.pos-type
     3425                             , ub.cash-desk.obj-code
     3426                             , chr(10)
     3427                             , error-status:get-message(1)
     3428                             , return-value )).
     3429     assign
     3430     v-view-log = yes.
     3431     return error.
     3432   end.
     3433   run adm/shattri.p (
     3434           input "get":U
     3435           ,input  'маг':U
     3436           ,input  ub.cash-desk.obj-code
     3437           ,input  'cd-type-maria':U
     3438           ,input  'cdtaxlst':U
     3439           ,output v-value-character
     3440           ,output v-value-date
     3441           ,output v-value-decimal
     3442           ,output v-value-integer
     3443           ,output v-value-logical
     3444           ,output v-param-type
     3445           ,INPUT-OUTPUT table-handle v-tth
     3446           ) no-error .
     3447   IF not error-status:error then do:
     3448    cdtaxlst = v-value-character.
     3449    delete object v-tth.
     3450   end.
     3451   else do:
     3452     delete object v-tth.
     3453     return error return-value .
     3454   end.
     3455     end.
     3456   END CASE.
     3457       RUN for-cash-cycle no-error.
     3458     END.
     3459     IF LAST-OF(ub.cash-desk.pos-type) then do:
     3460   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3461   case ub.cash-desk.pos-type:
     3462   END CASE.
     3463     END.
     3464   END.
     3465   END PROCEDURE.
     3466   assign
     3467   i-obj-code = integer(entry(1, p-parameter, chr(4)))
     3468   action = entry(2, p-parameter, chr(4))
     3469   no-error
     3470   .
     3471   if error-status:error then do:
     3472     run write-log-and-file in p-log-handle (
     3473           input 1
     3474         , input log-file-name
     3475         , input 1
     3476         , input substitute("Ошибка входных параметров &1:&2&3"
     3477                            , p-parameter
     3478                            , chr(10)
     3479                            , error-status:get-message(1)
     3480                            )).
     3481     v-view-log = yes.
     3482     undo, return error .
     3483   end .
     3484   find first ub.shop no-lock where
     3485              ub.shop.obj-code = i-obj-code no-error .
     3486   run adm/shattri.p (
     3487       input "get":U
     3488       ,input  'маг':U
     3489       ,input  i-obj-code
     3490       ,input  'cd-inf-send':U
     3491       ,input  'tax-cass':U
     3492       ,output v-value-character
     3493       ,output v-value-date
     3494       ,output v-value-decimal
     3495       ,output v-value-integer
     3496       ,output v-value-logical
     3497       ,output v-param-type
     3498       ,INPUT-OUTPUT table-handle v-tth
     3499       ) no-error .
     3500   IF not error-status:error then
     3501   assign
     3502   tax-cass = v-value-logical
     3503   .
     3504   delete object v-tth.
     3505   if error-status:error or NOT tax-cass  then do:
     3506   run write-log-and-file in p-log-handle (
     3507         input 1
     3508       , input log-file-name
     3509       , input 1
     3510       , input substitute("В магазине &1 передача налогов на кассы не используется", i-obj-code)
     3511                                          ).
     3512   end.
     3513   else do:
     3514     FIND FIRST shop-buffer No-LOCK WHERE
     3515               shop-buffer.obj-code = i-obj-code No-ERROR.
     3516     if not avail shop-buffer then do:
     3517         IF NOT g#news then
     3518         message "Нет магазина " i-obj-code
     3519         view-as alert-box ERROR.
     3520         return error.
     3521     end.
     3522     RUN SENDING no-error.
     3523     if error-status:error then do:
     3524       run write-log-and-file in p-log-handle (
     3525             input 1
     3526           , input log-file-name
     3527           , input 1
     3528           , input substitute( "!!!Ошибки при отсылке информации по налогам на кассы  маг&1"
     3529                             , i-obj-code
     3530                             )
     3531                                             ).
     3532       assign
     3533       v-view-log = yes
     3534       .
     3535       if not g#news then return error .
     3536     end.
     3537   end.
     3538     finally :
     3539   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3540   if v-view-log
     3541   and not g#news
     3542   and not g#auto
     3543   then do:
     3544     message
     3545     '!!!При отсылке информации на кассы произошли ошибки!!!'  skip
     3546     "!!!Внимательно прочитайте Log-file!!"
     3547     view-as alert-box error .
     3548        define variable v-user-action35   as character no-undo .
     3549     define variable v-printed35       as logical   no-undo .
     3550     run gbl/prnfilen.w
     3551       (input  ('!!!При отсылке информации на кассы произошли ошибки!!!')
     3552       ,input  0
     3553       ,input  (string("./":U) + log-file-name)
     3554       ,input  7
     3555       ,output v-user-action35
     3556       ,output v-printed35
     3557       ) .
     3558   end.
     3559   if v-view-log = true
     3560   and (g#news
     3561   or g#auto)
     3562   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     3563   then do:
     3564      run cb_set-view-log in p-parent-handle ( input yes).
     3565   end.
     3566       run write-log-and-file in p-log-handle (
     3567           input 1
     3568         , input log-file-name
     3569         , input 1
     3570         , input substitute("&1", chr(10))
     3571       ).
     3572       define variable v-save-file-name as character no-undo .
     3573       v-save-file-name = substitute("&1send-cd.log", ibs.th.gbl.gbl-inipar:logDir) .
     3574       OS-APPEND value(log-file-name) value(v-save-file-name).
     3575       OS-DELETE value(log-file-name).
     3576     end finally .
