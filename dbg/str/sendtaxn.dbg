     3017                     ) no-error .
     3018       if error-status:error then do:
     3019         run write-log-and-file in p-log-handle (
     3020               input 1
     3021             , input log-file-name
     3022             , input 1
     3023             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных"
     3024                                   ,for-cash-desk.obj-code
     3025                                   ,for-cash-desk.cash-num
     3026                               )
     3027                                               ).
     3028         assign
     3029         v-view-log = yes
     3030         .
     3031       end.
     3032     end.
     3033   end.
     3034   if g#news
     3035   or g#auto
     3036   or g#esys
     3037   and for-cash-desk.pos-type = 'MAGIA-XML':U
     3038   then do:
     3039   end.
     3040     end.
     3041     when 'IBM':U
     3042     then do:
     3043   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3044   output stream IBMStream close.
     3045   output stream IBMStream
     3046   to value( (if for-cash-desk.remote = 1
     3047               then (v-dir-remote-tmp + chr(47) + "fl":U)
     3048               else out) + fname + '.ad0' ) convert target "ibm866".
     3049   put stream IBMStream ' ' skip(1).
     3050    put stream IBMStream unformatted '  ' for-cash-desk.addr-path ' plu' skip.
     3051   output stream IBMStream close.
     3052   OS-RENAME
     3053   VALUE((if for-cash-desk.remote = 1
     3054           then (v-dir-remote-tmp + chr(47) + "fl":U)
     3055           else out) + fname + '.ad0')
     3056   VALUE((if for-cash-desk.remote = 1
     3057           then (v-dir-remote + chr(47) + "fl":U)
     3058           else out) + fname + '.adr').
     3059   os-er = OS-ERROR.
     3060   run write-log-and-file in p-log-handle (
     3061         input 1
