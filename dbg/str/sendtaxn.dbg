     2405   end.
     2406   CASE pos-type:
     2407     when 'IBM':U then do:
     2408      if cd-vat = 0 or p-cash-os = "LINUX":U then do:
     2409         PUT stream IBMstream unformatted
     2410         '13 "'
     2411         if cash-txr.news-action OR cash-txr.status_ <> 'тек':U
     2412         then "D"
     2413         else string( action, "x(1)" )
     2414         '" '
     2415         cash-txr.tax-code format "9"
     2416         ' '
     2417         cash-txr.rate-code
     2418         ' '
     2419         (if cash-txr.tax-type = '%':U then 2 else 1) format "9"
     2420         (if cash-txr.rate-value = ?
     2421           then 0
     2422           else cash-txr.rate-value) format ">>>>>>>>>9.99"
     2423         chr(10).
     2424       end.
     2425       else do:
     2426         _do:
     2427         do ii = 1 to num-entries(cdtaxlst, ";":U):
     2428           assign
     2429           v-rate-code = integer(entry(1, entry(ii, cdtaxlst, ";":U), "-":U))
     2430           no-error .
