     2388   define variable v-plu as integer no-undo .
     2389   define buffer buf_tax-rate for ub.tax-rate.
     2390   define buffer buf_tax-rate-attr for ub.tax-rate-attr.
     2391   if cash-txr.rate-value = ?
     2392   and not (cash-txr.news-action OR cash-txr.status_ <> 'тек':U)
     2393   then do:
     2394       run write-log-and-file in p-log-handle (
     2395             input 1
     2396           , input log-file-name
     2397           , input 1
