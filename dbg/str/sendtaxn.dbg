     1275   define variable v-xml-file-name     as character            no-undo.
     1276   define variable v-xml-file-name-path as character            no-undo.
     1277   define variable v-log-file-name     as character            no-undo.
     1278   define variable v-locked            as logical              no-undo.
     1279   define variable v-log-string        as character            no-undo.
     1280   define variable v-oper-num          as integer              no-undo.
     1281   define variable v-obj-list          as character            no-undo.
