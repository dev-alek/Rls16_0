     2441                   input 1
     2442                 , input log-file-name
     2443                 , input 1
     2444                 , input substitute( "!!!Для маг &1 ставка налога &2 не входит в число действующих на кассе &2"
     2445                                     ,buf_cash-desk.obj-code
     2446                                     ,v-rate-code
     2447                                     ,buf_Cash-desk.pos-type
     2448                                   )
     2449                                                   ).
     2450             v-view-log = yes.
     2451             return error .
     2452           end.
     2453           if buf_tax-rate.rate-code = cash-txr.rate-code then do:
     2454             PUT stream IBMstream unformatted
     2455             '13 "'
     2456             if cash-txr.news-action OR cash-txr.status_ <> 'тек':U
     2457             then "D"
     2458             else string( action, "x(1)" )
     2459             '" '
     2460             convert-tax-code(buf_tax-rate.rate-code, cdtaxlst)  format "9"
     2461             ' '
     2462             cash-txr.rate-code
     2463             ' '
     2464             (if cash-txr.tax-type = '%':U then 2 else 1) format "9"
     2465             (if cash-txr.rate-value = ?
