     3065                           , ((if for-cash-desk.remote = 1
     3066                               then (v-dir-remote + chr(47) + "fl":U)
     3067                               else out) + fname + '.dat')
     3068                           , ((if for-cash-desk.remote = 1
     3069                               then (v-dir-remote + chr(47) + "fl":U)
     3070                               else out) + fname + '.adr')
     3071                           )
     3072                                          ).
     3073   if os-er <> 0 then do:
     3074     run write-log-and-file in p-log-handle (
     3075           input 1
     3076         , input log-file-name
     3077         , input 1
     3078         , input substitute( "!!!Ошибки в работе локальной сети или нарушение прав доступа при обмене информацией с кассой &1",
     3079                               for-cash-desk.cash-num
     3080                           )
     3081                                           ).
     3082         assign
     3083         v-view-log = yes
     3084         .
     3085         return "error":U.
     3086   end.
     3087   if for-cash-desk.remote = 1 then do:
     3088     OS-RENAME
     3089     VALUE(v-dir-remote-tmp + chr(47) + "fl":U + fname + '.dat')
     3090     VALUE(v-dir-remote  + chr(47) + "fl":U + fname + '.dat').
     3091     os-er = OS-ERROR.
     3092     if os-er <> 0 then do:
     3093         run write-log-and-file in p-log-handle (
     3094               input 1
     3095             , input log-file-name
     3096             , input 1
     3097             , input substitute( "!!!Ошибки в работе локальной сети или нарушение прав доступа при обмене информацией с кассой &1",
     3098                                   for-cash-desk.cash-num
     3099                               )
     3100                                               ).
     3101         assign
     3102         v-view-log = yes
     3103         .
     3104         return "error":U.
     3105     end.
     3106     run write-log-and-file in p-log-handle (
     3107           input 1
     3108         , input log-file-name
     3109         , input 1
     3110         , input substitute( "Данные выгружены в файл &1",
     3111                               (v-dir-remote  + chr(47) + "fl":U + fname + '.dat')
     3112                           )
     3113                                           ).
     3114   end.
     3115   else do:
     3116     if not g#news
     3117     and not g#auto
     3118     and not g#esys
     3119     then do:
     3120         run str/waitp.w ( out + fname + '.dat',
     3121                     ( if action = 'U'
     3122                       then ('Ждите - ' + 'добавление категорий и ставок налогов')
     3123                       else ('Ждите - ' + 'удаление категорий и ставок налогов') ) +
     3124                       for-cash-desk.addr-path,
     3125                       ' Подождите 15 сек ',
     3126                       'Касса не ответила. Если Вы уверены, что с ней нет связи нажмите кнопку!',
     3127                       15 ) no-error.
     3128       if error-status:error then do:
     3129         os-delete value( out + fname + '.adr' ) .
     3130         os-delete value( out + fname + '.ad0' ) .
     3131         os-delete value( out + fname + '.dat' ) .
     3132         run write-log-and-file in p-log-handle (
     3133               input 1
     3134             , input log-file-name
     3135             , input 1
     3136             , input substitute( "!!!Прерван обмен информацией с кассой &1, на кассе осталась устаревшая информация",
     3137                                   for-cash-desk.cash-num
     3138                               )
     3139                                               ).
     3140         assign
     3141         v-view-log = yes
     3142         .
     3143         return "error":U.
     3144       end.
     3145     end.
     3146   end.
     3147     end.
     3148     when 'MARIA':U then do:
     3149   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3150   define variable v-found26 as logical no-undo .
     3151   define variable v-is-script26 as logical no-undo.
     3152   define variable v-fields-shift26 as integer no-undo .
     3153   find first temp-tekka-tsk no-error.
     3154   if available temp-tekka-tsk then do:
     3155      v-found26 = yes.
     3156   end.
     3157   if v-found26 = yes then do:
     3158   output stream IBmSTREAM to VALUE(out + fname + '.tsk').
     3159   v-is-script26 = no.
     3160   for each temp-tekka-tsk:
     3161     if (temp-tekka-tsk.num-rec > 0
     3162     or temp-tekka-tsk.send-get = 'task')
     3163     and temp-tekka-tsk.task-num = fname then do:
     3164       export stream IBmSTREAM temp-tekka-tsk.
     3165       v-found26 = yes.
     3166     end.
     3167     if temp-tekka-tsk.is-script then do:
     3168       v-is-script26 = yes.
     3169     end.
     3170     delete temp-tekka-tsk.
     3171   end.
     3172   output stream IBMStream
     3173   close.
     3174   run write-log-and-file in p-log-handle (
     3175         input 1
     3176       , input log-file-name
     3177       , input 1
     3178       , input substitute( "Данные выгружены в файлы &1(..),&2файл задания &3"
     3179                           , (out + fname)
     3180                           , chr(10)
     3181                           , (out + fname + '.tsk')
     3182                           )
     3183                                          ).
     3184   run str/runtekka.p (
     3185                        input parparentproc
     3186                       ,input p-parent-handle
     3187                       ,input p-log-handle
     3188                       ,input out
     3189                       ,input out
     3190                       ,input fname
     3191                       ,input v-remote
     3192                       ,input v-is-script26
     3193                       ) no-error .
     3194   if error-status:error then do:
     3195     for each temp-tekka-tsk:
     3196       os-delete value( temp-tekka-tsk.filename) .
     3197       delete temp-tekka-tsk.
     3198     end.
     3199     run write-log-and-file in p-log-handle (
     3200           input 1
     3201         , input log-file-name
     3202         , input 1
     3203         , input substitute( "!!!Прерван обмен информацией с кассой &1,&2&3&2на кассе осталась устаревшая информация"
     3204                              ,for-cash-desk.cash-num
     3205                              ,chr(10)
     3206                              ,return-value
     3207                           )
     3208                                           ).
     3209     assign
     3210     v-view-log = yes
     3211     .
     3212     return "error":U.
     3213   end.
     3214   else do:
     3215   end.
     3216   end.
     3217     end.
     3218   END CASE.
     3219   END .
     3220   END PROCEDURE.
     3221   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3222   PROCEDURE SENDING:
     3223   DEFINE VARIABLE fq as integer no-undo .
     3224   define variable glog as logical no-undo .
     3225   FOR EACH
     3226       ub.cash-desk NO-LOCK WHERE
     3227       ub.cash-desk.obj-code = i-obj-code AND
     3228       ub.cash-desk.db-num = g#db-num AND
     3229       ub.cash-desk.cash-on
     3230   BREAK
     3231   By ub.cash-desk.pos-type :
     3232     IF FIRST-OF(ub.cash-desk.pos-type) then do:
     3233   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3234   define variable dflt-cd28 as character no-undo .
