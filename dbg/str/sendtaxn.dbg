     1451   procedure alienini-getkey :
     1452   define input parameter i-filename as char.
     1453   define input parameter i-section as char.
     1454   define input parameter i-key as char.
     1455   define output parameter o-value as char.
     1456   define variable EntryPointer as integer no-undo.
     1457   define variable mem1 as memptr no-undo.
     1458   define variable mem2 as memptr no-undo.
     1459   define variable mem1size as integer no-undo.
     1460   define variable mem2size as integer no-undo.
     1461   define variable ii       as integer    no-undo.
     1462   define variable cbReturnSize  as integer    no-undo.
     1463   assign
     1464   set-size(mem1)  = 4000
     1465   mem1size = 4000.
     1466   if i-key = "" then EntryPointer = 0.
     1467   else do:
     1468     assign
     1469     set-size(mem2) = 128
     1470     mem2size = 128
     1471     EntryPointer = get-pointer-value(mem2)
     1472     put-string(mem2, 1) = i-key.
     1473   end.
     1474   run getprivateprofilestringA
     1475                                 (i-section,
     1476                                  EntryPointer,
     1477                                  "",
     1478                                  get-pointer-value(mem1),
     1479                                  input mem1size,
     1480                                  i-filename,
     1481                                  output cbReturnSize).
     1482   do ii = 1 to cbReturnSize:
     1483     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     1484                  then o-value + ","
     1485                  else o-value + chr(get-byte(mem1, ii)).
     1486   end.
     1487     set-size(mem1) = 0.
     1488     set-size(mem2) = 0.
     1489   end procedure.
     1490   procedure alienini-putkey :
     1491   define input parameter i-filename as char.
     1492   define input parameter i-section as char.
     1493   define input parameter i-key as char.
     1494   define input parameter i-value as char.
     1495   define variable cbReturnSize as integer.
     1496   run writeprivateprofilestringA
     1497                                  (i-section,
     1498                                   i-key,
     1499                                   i-value,
     1500                                   i-filename,
     1501                                   output cbReturnSize ).
     1502   end procedure.
     1503   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     1504     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     1505     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     1506     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     1507     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     1508     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     1509     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     1510     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     1511   END PROCEDURE.
     1512   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     1513     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     1514     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     1515     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     1516     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     1517     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     1518   END PROCEDURE.
