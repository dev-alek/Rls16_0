     3250       ,output v-value-decimal29
     3251       ,output v-value-integer29
     3252       ,output v-value-logical29
     3253       ,output v-param-type29
     3254       ,INPUT-OUTPUT table-handle v-tth29
     3255       ) no-error .
     3256   delete object v-tth29 no-error.
     3257   case ub.cash-desk.pos-type:
     3258       when 'IBM-XML':U or when 'Autotank':U
     3259     then do:
     3260   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3261   run str/get-inis.p (
     3262                   input 'маг':U
     3263                 , input ub.cash-desk.obj-code
