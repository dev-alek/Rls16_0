     3265                 , input cash-desk.remote
     3266                 , input "send":U
     3267                 , output out
     3268                 , output out2
     3269                 , output in_
     3270                 , output spl
     3271                 , output sav
     3272                 , output v-remote
     3273                 )  no-error .
     3274   if error-status:error then do:
     3275     run write-log-and-file in p-log-handle (
     3276           input 1
     3277         , input log-file-name
     3278         , input 1
     3279         , input substitute("!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     3280                             , ub.cash-desk.pos-type
     3281                             , ub.cash-desk.obj-code
     3282                             , chr(10)
     3283                             , error-status:get-message(1)
     3284                             , return-value )).
     3285     assign
     3286     v-view-log = yes.
     3287     return error.
     3288   end.
     3289   if ub.cash-desk.pos-type = 'IBM-XML':U
     3290   or ub.cash-desk.pos-type = 'Autotank':U
     3291   then do:
     3292     file-info:file-name = (out  + "undelivered").
     3293     if file-info:FULL-PATHNAME <> ? then do:
     3294       run str/rsndxibm.p ( input parparentproc
     3295                           ,input p-parent-handle
     3296                           ,input p-log-handle
     3297                           ,input out  + "undelivered" ) no-error.
     3298     end.
     3299   end.
     3300      if ub.cash-desk.pos-type = 'IBM-XML':U then do:
     3301       run adm/shattri.p (
     3302           input "get":U
     3303           ,input  'маг':U
     3304           ,input  ub.cash-desk.obj-code
     3305           ,input  'cd-type-IBM-XML':U
     3306           ,input  'cdtaxlst':U
     3307           ,output v-value-character
     3308           ,output v-value-date
     3309           ,output v-value-decimal
     3310           ,output v-value-integer
     3311           ,output v-value-logical
     3312           ,output v-param-type
     3313           ,INPUT-OUTPUT table-handle v-tth
     3314           ) no-error .
     3315       IF not error-status:error then do:
     3316         cdtaxlst = v-value-character.
     3317       end.
     3318       delete object v-tth.
     3319       run adm/shattri.p (
     3320           input "get":U
     3321           ,input  'маг':U
     3322           ,input  ub.cash-desk.obj-code
     3323           ,input  'cd-type-IBM-XML':U
     3324           ,input  'cd-vat':U
     3325           ,output v-value-character
     3326           ,output v-value-date
     3327           ,output v-value-decimal
     3328           ,output v-value-integer
     3329           ,output v-value-logical
     3330           ,output v-param-type
     3331           ,INPUT-OUTPUT table-handle v-tth
     3332           ) no-error .
     3333       IF not error-status:error then do:
     3334        cd-vat = v-value-integer.
     3335       end.
     3336       delete object v-tth.
     3337     end.
     3338     end.
     3339     when 'IBM':U
     3340     then do:
     3341   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3342   run str/get-inis.p (
     3343                   input 'маг':U
     3344                 , input ub.cash-desk.obj-code
     3345                 , input ub.cash-desk.pos-type
     3346                 , input cash-desk.remote
     3347                 , input "send":U
     3348                 , output out
     3349                 , output out2
     3350                 , output in_
     3351                 , output spl
     3352                 , output sav
     3353                 , output v-remote
     3354                 )  no-error .
     3355   if error-status:error then do:
     3356     run write-log-and-file in p-log-handle (
     3357           input 1
