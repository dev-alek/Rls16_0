     3238   define variable v-value-decimal29 as decimal no-undo .
     3239   define variable v-value-integer29 as INTEGER no-undo .
     3240   define variable v-value-logical29 AS LOGICAL no-undo .
     3241   define variable v-tth29 as handle no-undo .
     3242   run adm/shattri.p (
     3243       input "get":U
     3244       ,input  'маг':U
