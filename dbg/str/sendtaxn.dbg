      613   procedure xmlchar-decode :
      614   define input parameter p-in-string      as character        no-undo.
      615   define output parameter p-out-string    as character        no-undo.
      616       define variable v-position      as integer      no-undo.
      617       define variable v-last-position as integer      no-undo.
      618       define variable v-temp-integer  as integer      no-undo.
      619       define variable v-current-char  as character    no-undo.
      620       define variable v-next-char     as character    no-undo.
      621       define variable v-success       as logical      no-undo.
      622   do
      623   on error undo, return error
      624   :
      625       assign
      626           p-out-string = "":U
      627           v-position   = 0
      628       .
      629       replace-cycle:
      630       do while yes
      631       on error undo, return error
      632       :
      633           assign
      634               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      635           .
      636           if v-last-position <= v-position
      637           then do:
      638               if v-position = 0
      639               then do:
      640                   assign
      641                       p-out-string = p-in-string
      642                   .
      643               end.
      644               else do:
      645                   assign
      646                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      647                   .
      648               end.
      649               leave replace-cycle.
      650           end.
      651           else do:
      652               assign
      653                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      654                   v-position      = v-last-position
      655                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      656               .
      657               if v-current-char = "#":U
      658               then do:
      659                   assign
      660                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      661                   .
      662                   if v-last-position > 0
      663                   then do:
      664                       run xmlchar-read-integer in this-procedure
      665                        (
      666                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      667                           , output v-temp-integer
      668                           , output v-success
      669                       ).
      670                       if v-success = yes
      671                       and v-temp-integer >= 1
      672                       and v-temp-integer <= 255
      673                       then do:
      674                           assign
      675                               p-out-string = p-out-string + chr( v-temp-integer )
      676                               v-position   = v-last-position + 1
      677                           .
      678                       end.
      679                       else do:
      680                           assign
      681                               p-out-string = p-out-string + "&":U
      682                               v-position   = v-position   + 1
      683                           .
      684                       end.
      685                   end.
      686                   else do:
      687                       assign
      688                           p-out-string = p-out-string + "&":U
      689                           v-position   = v-position   + 1
      690                       .
      691                   end.
      692               end.
      693               else do:
      694                   case substring( p-in-string, v-position + 1, 3 )
      695                   :
      696                       when "lt;":U
      697                       then do:
      698                           assign
      699                               p-out-string = p-out-string + "<":U
      700                               v-position   = v-position   + 3
      701                           .
      702                       end.
      703                       when "gt;":U
      704                       then do:
      705                           assign
      706                               p-out-string = p-out-string + ">":U
      707                               v-position   = v-position   + 3
      708                           .
      709                       end.
      710                       otherwise do:
      711                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      712                           then do:
      713                               assign
      714                                   p-out-string = p-out-string + "&":U
      715                                   v-position   = v-position   + 4
      716                               .
      717                           end.
      718                           else do:
      719                               case substring( p-in-string, v-position + 1, 5 )
      720                               :
      721                                   when "quot;":U
      722                                   then do:
      723                                       assign
      724                                           p-out-string = p-out-string + '"':U
      725                                           v-position   = v-position   + 5
      726                                       .
      727                                   end.
      728                                   when "apos;":U
      729                                   then do:
      730                                       assign
      731                                           p-out-string = p-out-string + "'":U
      732                                           v-position   = v-position   + 5
      733                                       .
      734                                   end.
      735                                   otherwise do:
      736                                       assign
      737                                           p-out-string = p-out-string + "&":U
      738                                       .
      739                                   end.
      740                               end case.
      741                           end.
      742                       end.
      743                   end case.
      744               end.
      745           end.
      746       end.
      747   end.
      748   end .
      749   procedure xmlchar-read-integer :
      750   define input parameter p-input-string      as character        no-undo.
      751   define output parameter p-output-integer   as integer          no-undo.
      752   define output parameter p-success       as logical          no-undo.
      753   do
      754   on error undo, return error
      755   :
      756       assign
      757           p-output-integer = integer( p-input-string )
      758       no-error.
      759       if error-status :error
      760       then do:
      761           assign
      762               p-success           = no
      763               p-output-integer    = 0
      764           .
      765       end.
      766       else do:
      767           assign
      768               p-success           = yes
      769           .
      770       end.
      771   end.
      772   end.
      773   define variable v-bgelib-bgeclall           as logical      no-undo.
      774   define variable v-bgelib-bgedict            as logical      no-undo.
      775   define temp-table temp_ext-doc-type no-undo
      776       field edt-key               as integer
      777       field ext-doc-type          as character
      778       field ext-doc-type-label    as character
      779       index pi is primary unique
      780           edt-key
      781   .
      782   define temp-table temp_bgelib_goods no-undo
      783       field gds-code as integer
      784       index pi is primary unique
      785           gds-code
      786   .
      787   define temp-table temp_bgelib_clients no-undo
      788       field obj-type as character
      789       field obj-code as integer
      790       index pi is primary unique
      791           obj-type
      792           obj-code
      793   .
      794   define temp-table temp_bgelib_dis-card no-undo
      795       field d-card as character
      796       index pi is primary unique
      797           d-card
      798   .
      799   define temp-table temp_bgelib_trn-doc no-undo
      800       field doc-code as integer
      801   .
      802   procedure bgelib-tag-open:
      803   do
      804   on error undo, return error
      805   :
      806   define input parameter v-tag-level  as integer      no-undo.
      807   define input parameter v-tag-name   as character    no-undo.
      808   define input parameter v-tag-value  as character    no-undo.
      809       put stream stmXMLOut unformatted
      810           chr(10)
      811           + fill(" ", 4 * v-tag-level)
      812           + "<" + v-tag-name
      813           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      814           + v-tag-value + ">"
      815       .
      816   end.
      817   end procedure.
      818   procedure bgelib-tag-put:
      819   do
      820   on error undo, return error
      821   :
      822   define input parameter v-tag-level      as integer      no-undo.
      823   define input parameter v-tag-name       as character    no-undo.
      824   define input parameter v-tag-value      as character    no-undo.
      825   define input parameter v-empty-mode     as integer      no-undo.
      826       v-tag-name = trim(v-tag-name).
      827       if  v-empty-mode = 1
      828       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      829       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      830       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      831       then do:
      832           run xmlchar-encode in this-procedure (
      833                 input v-tag-value
      834               , output v-tag-value
      835           ).
      836           put stream stmXMLOut unformatted
      837               chr(10) + fill(" ", 4 * v-tag-level)
      838                           + '<' + v-tag-name + '>'
      839                           + v-tag-value
      840                           + '</' + v-tag-name + '>'
      841           .
      842       end.
      843   end.
      844   end procedure.
      845   procedure bgelib-tag-close:
      846   do
      847   on error undo, return error
      848   :
      849   define input parameter v-tag-level as integer      no-undo.
      850   define input parameter v-tag-name  as character    no-undo.
      851       put stream stmXMLOut unformatted
      852           chr(10)
      853           + fill( " ", 4 * v-tag-level)
      854           + '</' + v-tag-name + '>'
      855       .
      856   end.
      857   end procedure.
      858   procedure bgelib-write-log:
      859   do
      860   on error undo, return error
      861   :
      862   define input parameter v-filename   as character    no-undo.
      863   define input parameter v-log-level  as integer      no-undo.
      864   define input parameter v-out-string as character    no-undo.
      865       output stream stmXMLLog to value( v-filename ) append.
      866       put stream stmXMLLog unformatted
      867           chr(10)
      868       .
      869       put stream stmXMLLog unformatted
      870           ( if v-log-level = 0
      871             or v-out-string = "&DLine"
      872             or v-out-string = "&Line"
      873             then ""
      874             else cur-time-string-sec() + " " )
      875       .
      876       put stream stmXMLLog unformatted
      877           ( if v-out-string = "&Line"
      878             then fill( "-", 80 )
      879             else if v-out-string = "&DLine"
      880                  then fill( "=", 80 )
      881                  else v-out-string )
      882       .
      883       output stream stmXMLLog close.
      884   end.
      885   end procedure.
      886   procedure bgelib-write-edt:
      887   do
      888   on error undo, return error
      889   :
      890   define input parameter v-editor-handle    as handle       no-undo.
      891   define input parameter v-log-level        as integer      no-undo.
      892   define input parameter v-out-string       as character    no-undo.
      893       if valid-handle ( v-editor-handle )
      894       then do:
      895           v-editor-handle :move-to-eof().
      896           v-editor-handle :insert-string( ( if v-log-level = 0
      897                                             or v-out-string = "&DLine"
      898                                             or v-out-string = "&Line"
      899                                             then ""
      900                                             else cur-time-string-sec() + " "
      901                                         ) ).
      902           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      903                                             then fill( "-", 80 )
      904                                             else if v-out-string = "&DLine" then fill("=", 80)
      905                                             else fill( " ", v-log-level) + v-out-string
      906                                         ) ).
      907           v-editor-handle :insert-string( chr(10) ).
      908       end.
      909       process events.
      910       output to 'bgescn.txt' append.
      911           put unformatted
      912               chr(10)
      913               string( ( if v-log-level = 0
      914                         or v-out-string = "&DLine"
      915                         or v-out-string = "&Line"
      916                         then ""
      917                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      918                     ) )
      919               string( ( if v-out-string = "&Line"
      920                         then fill( "-", 80 )
      921                         else if v-out-string = "&DLine"
      922                              then fill( "=", 80 )
      923                              else fill( " ", v-log-level ) + v-out-string
      924                     ) )
      925           .
      926       output close.
      927   end.
      928   end procedure.
      929   procedure bgelib-show-cnt:
      930   do
      931   on error undo, return error
      932   :
      933   define input parameter v-fillin-handle     as handle   no-undo.
      934       if valid-handle( v-fillin-handle )
      935       then do:
      936           assign
      937               v-fillin-handle :visible = true
      938           .
      939       end.
      940   end.
      941   end procedure.
      942   procedure bgelib-hide-cnt:
      943   do
      944   on error undo, return error
      945   :
      946   define input parameter v-fillin-handle     as handle   no-undo.
      947       if valid-handle( v-fillin-handle )
      948       then do:
      949           assign v-fillin-handle :visible = false.
      950       end.
      951   end.
      952   end procedure.
      953   procedure bgelib-write-cnt:
      954   do
      955   on error undo, return error
      956   :
      957   define input parameter v-fillin-handle    as handle       no-undo.
      958   define input parameter v-fillin-string    as character    no-undo.
      959       if valid-handle( v-fillin-handle )
      960       then do:
      961           assign
      962               v-fillin-handle :SCREEN-value = v-fillin-string
      963           .
      964       end.
      965   end.
      966   end procedure.
      967   procedure bgelib-write-header:
      968   do
      969   on error undo, return error
      970   :
      971   define input parameter p-first-file     as logical      no-undo.
      972   define input parameter p-xml-file-name  as character    no-undo.
      973   define input parameter p-list-file-name as character    no-undo.
      974   define input parameter p-file-number    as integer      no-undo.
      975   define input parameter p-have-prev      as logical      no-undo.
      976   define input parameter p-prev-filename  as character    no-undo.
      977   define input parameter p-obj-list       as character    no-undo.
      978   define input parameter p-doc-type-list  as character    no-undo.
      979   define input parameter p-parameter-list as character    no-undo.
      980       define variable v-counter    as integer        no-undo.
      981       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
      982       put stream stmXMLOut unformatted
      983           "<?xml version='1.0' encoding='windows-1251'?>"
      984       .
      985       run bgelib-tag-open( input 0, input "root"  , input "" ).
      986       run bgelib-tag-open( input 0, input "header", input "" ).
      987       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      988       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      989       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      990       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
      991       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
      992       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      993       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      994       :
      995           run bgelib-tag-put(
      996                 input 1
      997               , input entry( 2 * v-counter, p-parameter-list )
      998               , input entry( 2 * v-counter + 1, p-parameter-list )
      999               , input 0
     1000           ).
     1001       end.
     1002       run bgelib-tag-close( input 0, input "header" ).
     1003       output stream stmXMLOut close.
     1004       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1005       if p-first-file = yes
     1006       then do:
     1007           put stream stmXMLOut unformatted
     1008               "<?xml version='1.0' encoding='windows-1251'?>"
     1009           .
     1010           run bgelib-tag-open( input 0, input "export", input "" ).
     1011       end.
     1012       run bgelib-tag-open( input 1, input "file", input "" ).
     1013       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1014       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1015       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1016       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1017       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1018       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1019       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1020       :
     1021           run bgelib-tag-put(
     1022                 input 2
     1023               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1024               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1025               , input 0
     1026           ).
     1027       end.
     1028       run bgelib-tag-close( input 1, input "file" ).
     1029       output stream stmXMLOut close.
     1030   end.
     1031   end procedure.
     1032   procedure bgelib-write-footer:
     1033   do
     1034   on error undo, return error
     1035   :
     1036   define input parameter p-last-file      as logical      no-undo.
     1037   define input parameter p-xml-file-name  as character    no-undo.
     1038   define input parameter p-list-file-name as character    no-undo.
     1039   define input parameter p-have-next      as logical      no-undo.
     1040   define input parameter p-next-file-name as character    no-undo.
     1041       define variable v-error-num     as integer           no-undo.
     1042       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1043       if p-have-next = yes
     1044       then do:
     1045           run bgelib-tag-open( input 0, input "footer", "" ).
     1046           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1047           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1048           run bgelib-tag-close( input 0, input "footer" ).
     1049       end.
     1050       run bgelib-tag-close( input 0, input "root" ).
     1051       output stream stmXMLOut close.
     1052       run bge/os_copy.p (
     1053             input "M"
     1054           , input p-xml-file-name + "tmp"
     1055           , input p-xml-file-name + "xml"
     1056           , output v-error-num
     1057       ).
     1058       if p-last-file = yes
     1059       then do:
     1060           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1061               run bgelib-tag-close( input 0, input "export" ).
     1062           output stream stmXMLOut close.
     1063           run bge/os_copy.p (
     1064                 input "M"
     1065               , input p-list-file-name + "tmp"
     1066               , input p-list-file-name + "xml"
     1067               , output v-error-num
     1068           ).
     1069       end.
     1070   end.
     1071   end procedure.
     1072   procedure bgelib-filename :
     1073   do
     1074   on error undo, return error
     1075   :
     1076   define input parameter p-prefix             as character    no-undo.
     1077   define output parameter p-xml-file-name     as character    no-undo.
     1078   define output parameter p-log-file-name     as character    no-undo.
     1079   define output parameter p-list-file-name    as character    no-undo.
     1080       define variable v-home-dir  as character    no-undo.
     1081       define variable v-error-num as integer      no-undo.
     1082       get-key-value section "BGE" key "outdir" value v-home-dir.
     1083       if v-home-dir = ?
     1084       then do:
     1085           message
     1086             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1087             skip(1)
     1088             skip "Обратитесь к администратору."
     1089           view-as alert-box error.
     1090           undo, return error .
     1091       end.
     1092       run gbl/dir-cre.p (
     1093           input v-home-dir
     1094       ) no-error.
     1095       if error-status :error
     1096       then do:
     1097           message
     1098             skip "Неверно задан каталог экспорта."
     1099             skip(1)
     1100             skip "Обратитесь к администратору."
     1101           view-as alert-box error.
     1102           undo, return error .
     1103       end.
     1104       run bge/genfname.p (
     1105             input v-home-dir
     1106           , input p-prefix
     1107           , input ""
     1108           , input "xml"
     1109           , input "tmp"
     1110           , output p-xml-file-name
     1111       ).
     1112       assign
     1113           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1114           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1115           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1116       .
     1117   end.
     1118   end procedure.
     1119   procedure bgelib-read-config :
     1120   do
     1121   on error undo, return error
     1122   :
     1123   define variable v-par-type as character     no-undo.
     1124     define variable v-param-type      as character  no-undo .
     1125     define variable v-value-character as character  no-undo .
     1126     define variable v-value-date      as date       no-undo .
     1127     define variable v-value-decimal   as decimal    no-undo .
     1128     define variable v-value-integer   as integer    no-undo .
     1129     define variable v-value-logical   as logical    no-undo .
     1130     define variable v-tth             as handle     no-undo .
     1131       assign
     1132           v-bgelib-bgeclall = no
     1133           v-bgelib-bgedict  = no
     1134       .
     1135       run adm/shattri.p ( input "get":U
     1136                         , input  '':u
     1137                         , input  0
     1138                         , input  'bge-export':U
     1139                         , input  'bgeclall':U
     1140                         , output v-value-character
     1141                         , output v-value-date
     1142                         , output v-value-decimal
     1143                         , output v-value-integer
     1144                         , output v-value-logical
     1145                         , output v-param-type
     1146                         , input-output table-handle v-tth
     1147                         ) no-error .
     1148       if error-status :error
     1149       then do:
     1150         assign
     1151           v-bgelib-bgeclall = no
     1152         .
     1153       end.
     1154       else do:
     1155         assign
     1156           v-bgelib-bgeclall = v-value-logical
     1157         .
     1158       end.
     1159       delete object v-tth.
     1160       run adm/shattri.p ( input "get":U
     1161                         , input  '':u
     1162                         , input  0
     1163                         , input  'bge-export':U
     1164                         , input  'bgedict':U
     1165                         , output v-value-character
     1166                         , output v-value-date
     1167                         , output v-value-decimal
     1168                         , output v-value-integer
     1169                         , output v-value-logical
     1170                         , output v-param-type
     1171                         , input-output table-handle v-tth
     1172                         ) no-error .
     1173       if error-status :error
     1174       then do:
     1175         assign
     1176           v-bgelib-bgedict = no
     1177         .
     1178       end.
     1179       else do:
     1180         assign
     1181           v-bgelib-bgedict = v-value-logical
     1182         .
     1183       end.
     1184       delete object v-tth.
     1185       run adm/shattri.p ( input "get":U
     1186                         , input  '':u
     1187                         , input  0
     1188                         , input  'bge-export':U
     1189                         , input  'bgefmt':U
     1190                         , output v-value-character
     1191                         , output v-value-date
     1192                         , output v-value-decimal
     1193                         , output v-value-integer
     1194                         , output v-value-logical
     1195                         , output v-param-type
     1196                         , input-output table-handle v-tth
     1197                         ) no-error .
     1198       if error-status :error
     1199       then do:
     1200         assign
     1201           v-bgelib-bgefmt  = "xml":U
     1202         .
     1203       end.
     1204       else do:
     1205         assign
     1206           v-bgelib-bgefmt  = v-value-character
     1207         .
     1208       end.
     1209       delete object v-tth.
     1210       run adm/shattri.p ( input "get":U
     1211                         , input  '':u
     1212                         , input  0
     1213                         , input  'bge-export':U
     1214                         , input  'bgeflold':U
     1215                         , output v-value-character
     1216                         , output v-value-date
     1217                         , output v-value-decimal
     1218                         , output v-value-integer
     1219                         , output v-value-logical
     1220                         , output v-param-type
     1221                         , input-output table-handle v-tth
     1222                         ) no-error .
     1223       if error-status :error
     1224       then do:
     1225         assign
     1226           v-bgelib-bgeflold  = "old":U
     1227         .
     1228       end.
     1229       else do:
     1230         assign
     1231           v-bgelib-bgeflold  = v-value-character
     1232         .
     1233       end.
     1234       delete object v-tth.
     1235   end.
     1236   end procedure.
     1237   procedure bgelib-check-file-size :
     1238   do
     1239   on error undo, return error
     1240   :
     1241   define input parameter p-out-filename   as character    no-undo.
     1242   define output parameter p-is-big        as logical      no-undo.
     1243       define variable v-current-position    as integer        no-undo.
     1244       assign
     1245           v-current-position = seek( stmXMLOut )
     1246       .
     1247       if v-current-position / 1024 / 1024  >= 100
     1248       then do:
     1249           assign
     1250               p-is-big = yes
     1251           .
     1252       end.
     1253   end.
     1254   end procedure.
     1255   procedure bgelib-init-ext-doc-type :
     1256       define variable v-counter    as integer      no-undo.
     1257       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1258   do
     1259   for buf_temp_ext-doc-type
     1260   on error undo, return error
     1261   :
     1262       empty temp-table buf_temp_ext-doc-type.
     1263       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1264       :
     1265           create buf_temp_ext-doc-type.
     1266           assign
     1267               buf_temp_ext-doc-type.edt-key               = v-counter
     1268               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1269               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1270           .
     1271       end.
     1272   end.
     1273   end procedure.
