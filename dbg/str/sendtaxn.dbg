     2170   define variable cd-vat                       as integer           no-undo .
     2171   define variable cdtaxlst                     as character         no-undo .
     2172   def buffer shop-buffer for ub.shop.
     2173   FUNCTION convert-tax-code returns integer
     2174                                             ( input p-rate-code as integer
     2175                                              ,input p-cdtaxlst  as character
     2176                                             ) :
     2177   define variable jj as integer no-undo .
     2178     do jj = 1 to num-entries(p-cdtaxlst, ";"):
     2179       if entry(jj, p-cdtaxlst, ";") begins (string(p-rate-code) + "-") then do:
     2180         return integer(entry(2, entry(jj, p-cdtaxlst, ";"), "-":U)).
     2181       end.
     2182     end.
     2183   END FUNCTION.
     2184   FUNCTION convert-maria-tax-code-2 returns integer
     2185                                             ( input p-rate-code as integer
     2186                                              ,input p-cdtaxlst  as character
     2187                                             ) :
     2188   define variable jj as integer no-undo .
     2189   define variable v-return-value as integer no-undo .
     2190     do jj = 1 to num-entries(p-cdtaxlst, ";"):
     2191       if entry(jj, p-cdtaxlst, ";") begins (string(p-rate-code) + "-") then do:
     2192         return jj.
     2193       end.
     2194     end.
     2195   return 0.
     2196   END FUNCTION.
