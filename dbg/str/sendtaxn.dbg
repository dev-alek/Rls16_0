     2467             else cash-txr.rate-value) format ">>>>>>>>>9.99"
     2468             chr(10).
     2469           end.
     2470         end.
     2471       end.
     2472     end.
     2473     when 'IBM-XML':U then do:
     2474         find first buf_tax-rate-attr where buf_tax-rate-attr.rate-code = cash-txr.rate-code
     2475                                        and buf_tax-rate-attr.tax-code = cash-txr.tax-code
     2476                                        and buf_tax-rate-attr.attr-code = "envd" no-error .
