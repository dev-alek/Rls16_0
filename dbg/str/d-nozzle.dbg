        1   define input  parameter parobj-type like ub.clients.obj-type no-undo.
        2   define input  parameter parobj-code like ub.clients.obj-code no-undo.
        3   define output parameter parrec-id   as recid initial ?    no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Диалог на добавление пистолета ТРК".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable varmes-log as logical no-undo.
      114   define variable parparentproc as widget-handle no-undo .
      115   define variable varobj-type like ub.clients.obj-type no-undo.
      116   define variable varobj-code like ub.clients.obj-code no-undo.
      117   define variable varbuttons  as   character        no-undo.
      118   define variable varps-upd   as   logical          no-undo.
      119   procedure nozzleav:
      120   define input parameter parobj-type    like ub.clients.obj-type   no-undo.
      121   define input parameter parobj-code    like ub.clients.obj-code   no-undo.
      122   define input parameter parnozzle-code like ub.nozzle.nozzle-code no-undo.
      123   define buffer bf_clients for ub.clients.
      124   define buffer bf_nozzle  for ub.nozzle.
      125   find first bf_clients where bf_clients.obj-type = parobj-type and
      126                               bf_clients.obj-code = parobj-code no-lock no-error.
      127   if not available bf_clients then
      128      return error SUBSTITUTE("Нет такого объекта &1 &2 .", parobj-type, parobj-code).
      129   find first bf_nozzle where bf_nozzle.obj-type    = parobj-type    and
      130                              bf_nozzle.obj-code    = parobj-code    and
      131                              bf_nozzle.nozzle-code = parnozzle-code no-lock no-error.
      132   if available bf_nozzle then
      133                return error SUBSTITUTE("Уже есть пистолет с номером &1", parnozzle-code) + SUBSTITUTE(" на объекте &1 &2 .", parobj-type, parobj-code).
      134   create bf_nozzle.
      135   assign bf_nozzle.obj-type    = parobj-type
      136          bf_nozzle.obj-code    = parobj-code
      137          bf_nozzle.nozzle-code = parnozzle-code.
      138   end. // procedure/method
      139   DEFINE BUTTON b-cancel AUTO-END-KEY
      140        LABEL "&Отмена"
      141        SIZE 10 BY 1
      142        BGCOLOR 8 .
      143   DEFINE BUTTON b-help
      144        LABEL "&Помощь"
      145        SIZE 10 BY 1
      146        BGCOLOR 8 .
      147   DEFINE BUTTON b-save AUTO-GO
      148        LABEL "&Ввод"
      149        SIZE 10 BY 1
      150        BGCOLOR 8 .
      151   DEFINE VARIABLE varnozzle-code AS INTEGER FORMAT ">9":U INITIAL 0
      152        LABEL "Номер пистолета ТРК"
      153        VIEW-AS FILL-IN
      154        SIZE 3 BY 1 NO-UNDO.
      155   DEFINE FRAME Dialog-Frame
      156        b-save AT ROW 1 COL 1
      157        b-cancel AT ROW 1 COL 11
      158        b-help AT ROW 1 COL 21
      159        varnozzle-code AT ROW 2.54 COL 1.25
      160        SPACE(7.99) SKIP(0.33)
      161       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      162            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      163            TITLE "Добавление пистолета ТРК"
      164            DEFAULT-BUTTON b-save CANCEL-BUTTON b-cancel.
      165   ASSIGN
      166          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      167          FRAME Dialog-Frame:HIDDEN           = TRUE.
      168   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      169   DO:
      170     APPLY "END-ERROR":U TO SELF.
      171   END.
      172   ON CHOOSE OF b-save IN FRAME Dialog-Frame
      173   DO:
      174   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      175   if lookup(self :type
      176            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      177            ) = 0
      178   then do:
      179     message
      180       "$Workfile$"
      181       "Указанному интерфейсному элементу фокус не может быть передан" skip
      182       "Интерфейсный элемент" self :name  skip
      183       "Тип" self :type  skip
      184       "Процедура" this-procedure :file-name skip
      185       view-as alert-box .
      186   end.
      187   else do:
      188     apply "entry":u to self  .
      189     if focus :handle <> self :handle  then do:
      190       return no-apply .
      191     end.
      192   end.
      193     assign frame Dialog-Frame varnozzle-code.
      194     run nozzleav (input parobj-type,
      195                         parobj-code,
      196                         varnozzle-code) no-error.
      197     if error-status:error then do:
      198   message
      199     vss-workfile vss-revision vss-description skip
      200     "Ошибка при создании пистолета ТРК" skip
      201     "-----------Cистемная ошибка------------" skip
      202     return-value skip
      203     "------Ошибка исполнения программы------" skip
      204     trim(error-status :get-message(1)) +
      205     trim(error-status :get-message(2)) +
      206     trim(error-status :get-message(3)) +
      207     trim(error-status :get-message(4)) +
      208     trim(error-status :get-message(5)) skip
      209     view-as alert-box error .
      210        return no-apply.
      211     end.
      212     find first ub.nozzle where ub.nozzle.obj-type    = parobj-type    and
      213                             ub.nozzle.obj-code    = parobj-code    and
      214                             ub.nozzle.nozzle-code = varnozzle-code no-lock.
      215     assign parrec-id = recid(ub.nozzle).
      216   END.
      217   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      218   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      219   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      220   on help of frame Dialog-Frame
      221   do:
      222     run gbl/app_help.p
      223       (input this-procedure :file-name
      224       ,input ''
      225       ,input ?
      226       ) no-error.
      227     if error-status :error then do:
      228       message
      229         "Ошибка при вызове помощи"
      230         error-status :get-message(1)
      231         view-as alert-box .
      232     end.
      233   end.
      234   run minbtn-set in this-procedure .
      235   on choose of b-help in frame Dialog-Frame
      236   do:
      237     apply "help":u to frame Dialog-Frame .
      238   end.
      239   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      240   procedure minbtn-set :
      241       do
      242           on error undo, return error return-value
      243           :
      244           define variable ii              as integer       no-undo .
      245           define variable fh              as widget-handle no-undo .
      246           define variable hh              as widget-handle no-undo .
      247           define variable v-h             as handle        extent 4 no-undo .
      248           define variable v-name-button   as character     no-undo .
      249           define variable v-help-old-x    as decimal       no-undo .
      250           define variable v-help-old-y    as decimal       no-undo .
      251           define variable v-help-old-size as decimal       no-undo .
      252           define variable v-frame-width   as decimal       no-undo .
      253           define variable jj              as integer       no-undo .
      254           do
      255               on error undo, return error
      256               :
      257               assign
      258                   v-frame-width = frame Dialog-Frame:width - 0.3
      259                   fh            = frame Dialog-Frame:first-child
      260                   hh            = fh:first-child
      261                   ii            = 1
      262                   .
      263               do while valid-handle(hh):
      264                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      265                   do:
      266                       case lc(hh:name) :
      267                           when "b-help" then
      268                               do:
      269                                   hh:load-image-up("cmp/b-help.bmp":u) .
      270                                   hh:load-image-down("cmp/b-help.bmp":u) .
      271                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      272                                   hh:TOOLTIP = "Помощь" .
      273                                   v-help-old-x = hh:column .
      274                                   v-help-old-y = hh:row    .
      275                                   v-help-old-size = hh:width .
      276                                   hh:width-chars = 2.5 .
      277                               end.
      278                           when "b-print" then
      279                               do:
      280                                   hh:load-image("cmp/b-print.bmp":u) .
      281                                   hh:TOOLTIP = "Печать" .
      282                                   v-h[ii] = hh:handle .
      283                                   ii = ii + 1 .
      284                                   hh:width-chars = 3 .
      285                               end.
      286                           when "b-history" or
      287                           when "b-hist" then
      288                               do:
      289                                   hh:load-image("cmp/b-hist.bmp":u) .
      290                                   hh:TOOLTIP = "История" .
      291                                   v-h[ii] = hh:handle .
      292                                   ii = ii + 1 .
      293                                   hh:width-chars = 3 .
      294                               end.
      295                           when "b-sch" then
      296                               do:
      297                                   hh:load-image("cmp/b-sch.bmp":u) .
      298                                   hh:TOOLTIP = "Установка Фильтра" .
      299                                   v-h[ii] = hh:handle .
      300                                   ii = ii + 1 .
      301                                   hh:width-chars = 3 .
      302                               end.
      303                           when "b-hist-user" then
      304                               do:
      305                                   hh:load-image("cmp/b-hist.bmp":u) .
      306                                   hh:TOOLTIP = "История пользователя" .
      307                                   ii = ii + 1 .
      308                               end.
      309                       end case.
      310                   end.
      311                   hh = hh:next-sibling.
      312               end.
      313               b-help:column = v-frame-width - b-help:width-chars.
      314               jj = 0.
      315               repeat ii = 4 to 1 by -1 :
      316                   if valid-handle (v-h[ii] ) then
      317                   do:
      318                       jj  = jj + 1 .
      319                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      320                       v-h[ii]:row    = v-help-old-y .
      321                   end.
      322               end.
      323           end.
      324       end.
      325   end procedure.
      326   MAIN-BLOCK:
      327   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      328      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      329     RUN enable_UI.
      330     WAIT-FOR GO OF FRAME Dialog-Frame.
      331   END.
      332   RUN disable_UI.
      333   PROCEDURE disable_UI :
      334     HIDE FRAME Dialog-Frame.
      335   END PROCEDURE.
      336   PROCEDURE enable_UI :
      337     DISPLAY varnozzle-code
      338         WITH FRAME Dialog-Frame.
      339     ENABLE b-save b-cancel b-help varnozzle-code
      340         WITH FRAME Dialog-Frame.
      341     VIEW FRAME Dialog-Frame.
      342   END PROCEDURE.
