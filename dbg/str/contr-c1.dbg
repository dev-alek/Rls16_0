      375   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376   procedure minbtn-set :
      377       do
      378           on error undo, return error return-value
      379           :
      380           define variable ii              as integer       no-undo .
      381           define variable fh              as widget-handle no-undo .
      382           define variable hh              as widget-handle no-undo .
      383           define variable v-h             as handle        extent 4 no-undo .
      384           define variable v-name-button   as character     no-undo .
      385           define variable v-help-old-x    as decimal       no-undo .
      386           define variable v-help-old-y    as decimal       no-undo .
      387           define variable v-help-old-size as decimal       no-undo .
      388           define variable v-frame-width   as decimal       no-undo .
      389           define variable jj              as integer       no-undo .
      390           do
      391               on error undo, return error
      392               :
      393               assign
      394                   v-frame-width = frame Dialog-Frame:width - 0.3
      395                   fh            = frame Dialog-Frame:first-child
      396                   hh            = fh:first-child
      397                   ii            = 1
      398                   .
      399               do while valid-handle(hh):
      400                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      401                   do:
      402                       case lc(hh:name) :
      403                           when "b-help" then
      404                               do:
      405                                   hh:load-image-up("cmp/b-help.bmp":u) .
      406                                   hh:load-image-down("cmp/b-help.bmp":u) .
      407                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      408                                   hh:TOOLTIP = "Помощь" .
      409                                   v-help-old-x = hh:column .
      410                                   v-help-old-y = hh:row    .
      411                                   v-help-old-size = hh:width .
      412                                   hh:width-chars = 2.5 .
      413                               end.
      414                           when "b-print" then
      415                               do:
      416                                   hh:load-image("cmp/b-print.bmp":u) .
      417                                   hh:TOOLTIP = "Печать" .
      418                                   v-h[ii] = hh:handle .
      419                                   ii = ii + 1 .
      420                                   hh:width-chars = 3 .
      421                               end.
      422                           when "b-history" or
      423                           when "b-hist" then
      424                               do:
      425                                   hh:load-image("cmp/b-hist.bmp":u) .
      426                                   hh:TOOLTIP = "История" .
      427                                   v-h[ii] = hh:handle .
      428                                   ii = ii + 1 .
      429                                   hh:width-chars = 3 .
      430                               end.
      431                           when "b-sch" then
      432                               do:
      433                                   hh:load-image("cmp/b-sch.bmp":u) .
      434                                   hh:TOOLTIP = "Установка Фильтра" .
      435                                   v-h[ii] = hh:handle .
      436                                   ii = ii + 1 .
      437                                   hh:width-chars = 3 .
      438                               end.
      439                           when "b-hist-user" then
      440                               do:
      441                                   hh:load-image("cmp/b-hist.bmp":u) .
      442                                   hh:TOOLTIP = "История пользователя" .
      443                                   ii = ii + 1 .
      444                               end.
      445                       end case.
      446                   end.
      447                   hh = hh:next-sibling.
      448               end.
      449               b-help:column = v-frame-width - b-help:width-chars.
      450               jj = 0.
      451               repeat ii = 4 to 1 by -1 :
      452                   if valid-handle (v-h[ii] ) then
      453                   do:
      454                       jj  = jj + 1 .
      455                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      456                       v-h[ii]:row    = v-help-old-y .
      457                   end.
      458               end.
      459           end.
      460       end.
      461   end procedure.
      462     find first ub.c-contract WHERE recid (ub.c-contract) = p-ri NO-LOCK.
      463     assign
      464     ub.c-contract.cli-inn:label in frame Dialog-Frame = ''
      465     .
      466     RUN enable_UI.
      467     WAIT-FOR GO OF FRAME Dialog-Frame.
      468   END.
      469   RUN disable_UI.
      470   PROCEDURE disable_UI :
      471     HIDE FRAME Dialog-Frame.
      472   END PROCEDURE.
      473   PROCEDURE enable_UI :
      474     IF AVAILABLE ub.c-contract THEN
      475       DISPLAY ub.c-contract.contract-prn-code ub.c-contract.contract-date
      476             ub.c-contract.doc-type ub.c-contract.curr-code ub.c-contract.status_
      477             ub.c-contract.srok-opl ub.c-contract.contract-type ub.c-contract.usl-opl
      478             ub.c-contract.contract-date-beg ub.c-contract.contract-date-end
      479             ub.c-contract.contract-city ub.c-contract.user-name ub.c-contract.contract-name
      480             ub.c-contract.user-db-num ub.c-contract.mngr-code ub.c-contract.cor-acc-in
      481             ub.c-contract.cel-nazn-code-in ub.c-contract.an-uchet-code-in ub.c-contract.own-name
      482             ub.c-contract.own-inn ub.c-contract.own-kpp ub.c-contract.own-addres
      483             ub.c-contract.own-bank-name ub.c-contract.own-bik ub.c-contract.own-r-schet
      484             ub.c-contract.own-c-schet ub.c-contract.own-sign ub.c-contract.own-sign-post
      485             ub.c-contract.cli-type ub.c-contract.cli-name ub.c-contract.cli-inn
      486             ub.c-contract.cli-code ub.c-contract.cli-addres ub.c-contract.cli-kpp
      487             ub.c-contract.cli-bik ub.c-contract.cli-r-schet ub.c-contract.cli-bank-name
      488             ub.c-contract.cli-c-schet ub.c-contract.cli-sign ub.c-contract.cli-sign-post
      489             ub.c-contract.posr-code ub.c-contract.posr-name ub.c-contract.posr-inn
      490             ub.c-contract.posr-type ub.c-contract.posr-kpp ub.c-contract.posr-addres
      491             ub.c-contract.posr-bank-name ub.c-contract.posr-bik ub.c-contract.posr-r-schet
      492             ub.c-contract.posr-c-schet ub.c-contract.posr-sign ub.c-contract.posr-sign-post
