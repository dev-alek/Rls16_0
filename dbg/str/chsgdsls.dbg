      179                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      180               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      181         otherwise do:
      182           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
      183         end.
      184       end CASE.
      185     end.
      186   end procedure.
      187   procedure uf-get :
      188     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      189     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      190     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      191     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      192     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      193     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      194     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      195     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      196     do
      197     on error undo, return error
      198     :
      199       define buffer buf_usr-flt for ubflt.usr-flt .
      200       define variable v-use-List_     as logical   no-undo .
      201       define variable v-type-List_     as character no-undo .
      202       define variable v-format-List_   as character no-undo .
      203       define variable v-use-Naim      as logical   no-undo .
      204       define variable v-type-Naim      as character no-undo .
      205       define variable v-format-Naim    as character no-undo .
      206       define variable v-use-print-graft as logical   no-undo .
      207       define variable v-use-sort-gr     as logical   no-undo .
      208       define variable v-use-type-price  as logical   no-undo .
      209       define variable v-use-type-val    as logical   no-undo .
      210       define variable v-label          as character no-undo .
      211       define variable v-tooltip        as character no-undo .
      212       define variable v-user-can-edit  as logical   no-undo .
      213       define variable v-output-display as logical   no-undo .
      214       define variable v-other          as character no-undo .
      215       run uf-name in this-procedure
      216          (input  entry(1, p-code, chr(4))
      217         ,output v-use-List_
      218         ,output v-type-List_
      219         ,output v-format-List_
      220         ,output v-use-Naim
      221         ,output v-type-Naim
      222         ,output v-format-Naim
      223         ,output v-use-print-graft
      224         ,output v-use-sort-gr
      225         ,output v-use-type-price
      226         ,output v-use-type-val
      227         ,output v-label
      228         ,output v-tooltip
      229         ,output v-user-can-edit
      230         ,output v-output-display
      231         ,output v-other
      232         ) no-error .
      233       if error-status :error then do:
      234         undo, return error return-value .
      235       end.
      236       find first buf_usr-flt no-lock where
      237                  buf_usr-flt.Call-point     = p-code AND
      238                  buf_usr-flt.user-name       = p-user-name
      239         no-error .
      240       if avail buf_usr-flt then do:
      241         assign
      242         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      243         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      244         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      245         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      246         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      247         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      248         .
      249       end.
      250       else do:
      251         assign
      252         p-List_        = (if v-use-List_       then "":U                    else ?)
      253         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      254         p-print-graft  = (if v-use-print-graft then no                      else ?)
      255         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      256         p-type-price   = (if v-use-type-price  then no                      else ?)
      257         p-type-val     = (if v-use-List_       then no                      else ?)
      258         .
      259       end.
      260     end.
      261   end procedure.
      262   procedure uf-set :
      263     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      264     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      265     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      266     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      267     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      268     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      269     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      270     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      271     do
      272     on error undo, return error
      273     :
      274       define buffer buf_usr-flt for ubflt.usr-flt .
      275       define variable v-use-List_     as logical   no-undo .
      276       define variable v-type-List_     as character no-undo .
      277       define variable v-format-List_   as character no-undo .
      278       define variable v-use-Naim      as logical   no-undo .
      279       define variable v-type-Naim      as character no-undo .
      280       define variable v-format-Naim    as character no-undo .
      281       define variable v-use-print-graft as logical   no-undo .
      282       define variable v-use-sort-gr   as logical   no-undo .
      283       define variable v-use-type-price as logical   no-undo .
      284       define variable v-use-type-val  as logical   no-undo .
      285       define variable v-tooltip        as character no-undo .
      286       define variable v-label          as character no-undo .
      287       define variable v-user-can-edit  as logical   no-undo .
      288       define variable v-output-display as logical   no-undo .
      289       define variable v-other          as character no-undo .
      290       run uf-name in this-procedure
      291         (input  entry(1, p-code, chr(4))
      292         ,output v-use-List_
      293         ,output v-type-List_
      294         ,output v-format-List_
      295         ,output v-use-Naim
      296         ,output v-type-Naim
      297         ,output v-format-Naim
      298         ,output v-use-print-graft
      299         ,output v-use-sort-gr
      300         ,output v-use-type-price
      301         ,output v-use-type-val
      302         ,output v-label
      303         ,output v-tooltip
      304         ,output v-user-can-edit
      305         ,output v-output-display
      306         ,output v-other
      307         ) no-error .
      308       if error-status :error then do:
      309         undo, return error return-value .
      310       end.
      311       find first buf_usr-flt where
      312                  buf_usr-flt.Call-point     = p-code AND
      313                  buf_usr-flt.user-name       = p-user-name
      314         no-error .
      315       if not avail buf_usr-flt then do:
      316           create buf_usr-flt .
      317           assign
      318           buf_usr-flt.call-point = p-code
      319           buf_usr-flt.user-name  = p-user-name
      320           .
      321       end.
      322       if avail buf_usr-flt then do:
      323        assign
      324        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      325        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      326        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      327        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      328        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      329        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      330       .
      331       release buf_usr-flt.
      332       end.
      333       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      334     end.
      335   end procedure.
      336   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      337   procedure grp-attr-name :
      338   do
      339     on error undo, return error
      340     :
      341     define input  parameter p-code           as character no-undo .
      342     define output parameter p-type           as character no-undo .
      343     define output parameter p-format         as character no-undo .
      344     define output parameter p-label          as character no-undo .
      345     define output parameter p-user-can-edit  as logical   no-undo .
      346     define output parameter p-output-display as logical   no-undo .
      347     define output parameter p-other          as character no-undo .
      348       case p-code :
      349               when 'gds-grp-nabor':U then do:     assign     p-label = "Набор"     p-type = 'L':U      p-format = "yes/no"     p-label = "Набор"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      350         otherwise do:
      351           undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
      352         end.
      353       end.
      354     end.
      355   end procedure.
      356   procedure grp-attr-tooltip :
      357   do
      358     on error undo, return error
      359     :
      360       define input  parameter p-code    as character no-undo .
      361       define output parameter p-tooltip as character no-undo .
      362       define output parameter p-label   as character no-undo .
      363       case p-code :
      364               when 'gds-grp-nabor':U then do:     assign     p-tooltip = "Набор - не товарные позиции"     p-label = "Набор" .   end.
      365         otherwise do:
      366               undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
      367         end.
      368       end.
      369     end.
      370   end procedure.
      371   procedure grp-attr-value :
      372   do
      373   on error undo, return error
      374   :
      375   define input  parameter p-node-code   as integer    no-undo.
      376   define input  parameter p-code        as character  no-undo.
      377   define input  parameter p-host-code   as integer    no-undo.
      378   define input  parameter p-obj-type    as character  no-undo.
      379   define input  parameter p-obj-code    as integer    no-undo.
      380   define output parameter p-value       as character  no-undo.
      381   define output parameter p-type        as character  no-undo.
      382       define variable v-format         as character no-undo .
      383       define variable v-label          as character no-undo .
      384       define variable v-user-can-edit  as logical   no-undo .
      385       define variable v-output-display as logical   no-undo .
      386       define variable v-other          as character no-undo .
      387       define buffer buf_gds-grp-attr for ub.gds-grp-attr.
      388       run grp-attr-name in this-procedure (
      389             input  p-code
      390           , output p-type
      391           , output v-format
      392           , output v-label
      393           , output v-user-can-edit
      394           , output v-output-display
      395           , output v-other
      396       ) no-error .
      397       if error-status :error
      398       then do:
      399           undo, return error return-value .
      400       end.
      401       find first buf_gds-grp-attr no-lock
      402            where buf_gds-grp-attr.node-code = p-node-code
      403              and buf_gds-grp-attr.attr-code = p-code
      404              and buf_gds-grp-attr.host-code = p-host-code
      405              and buf_gds-grp-attr.obj-type  = p-obj-type
      406              and buf_gds-grp-attr.obj-code  = p-obj-code
      407       no-error .
      408       if available buf_gds-grp-attr
      409       then do:
      410           assign
      411               p-value = buf_gds-grp-attr.attr-value
      412           .
      413       end.
      414       else do:
      415           assign
      416               p-value = if p-type = 'L':U then "no":U else ""
      417           .
      418       end.
      419   end.
      420   end procedure.
      421   procedure grp-attr-write :
      422   do
      423   on error undo, return error
      424   :
      425   define input parameter p-node-code  like ub.gds-grp-attr.node-code      no-undo.
      426   define input parameter p-code       like ub.gds-grp-attr.attr-code      no-undo.
      427   define input parameter p-host-code  as integer                          no-undo.
      428   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
      429   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
      430   define input parameter p-value      like ub.gds-grp-attr.attr-value     no-undo.
      431       define variable v-type              as character                no-undo.
      432       define variable v-format            as character                no-undo.
      433       define variable v-label             as character                no-undo.
      434       define variable v-user-can-edit     as logical                  no-undo.
      435       define variable v-output-display    as logical                  no-undo.
      436       define variable v-other             as character                no-undo.
      437       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
      438       run grp-attr-name in this-procedure (
      439                         input  p-code
      440                       , output v-type
      441                       , output v-format
      442                       , output v-label
      443                       , output v-user-can-edit
      444                       , output v-output-display
      445                       , output v-other
      446       ) no-error.
      447       if error-status :error
      448       then do:
      449           undo, return error return-value.
      450       end.
      451       find first buf_gds-grp-attr exclusive-lock
      452            where buf_gds-grp-attr.node-code  = p-node-code
      453              and buf_gds-grp-attr.attr-code  = p-code
      454              and buf_gds-grp-attr.host-code  = p-host-code
      455              and buf_gds-grp-attr.obj-type   = p-obj-type
      456              and buf_gds-grp-attr.obj-code   = p-obj-code
      457       no-error.
      458       if not available buf_gds-grp-attr
      459       then do:
      460           create buf_gds-grp-attr.
      461           assign
      462                   buf_gds-grp-attr.node-code  = p-node-code
      463                   buf_gds-grp-attr.attr-code  = p-code
      464                   buf_gds-grp-attr.host-code  = p-host-code
      465                   buf_gds-grp-attr.obj-type   = p-obj-type
      466                   buf_gds-grp-attr.obj-code   = p-obj-code
      467                   buf_gds-grp-attr.attr-value = p-value
      468           .
      469       end.
      470       else do:
      471           assign
      472               buf_gds-grp-attr.attr-value = p-value
      473           .
      474       end.
      475   end.
      476   end procedure.
      477   procedure grp-attr-delete :
      478   do
      479   on error undo, return error
      480   :
      481   define input parameter p-node-code  like ub.gds-grp-attr.node-code  no-undo.
      482   define input parameter p-code       like ub.gds-grp-attr.attr-code  no-undo.
      483   define input parameter p-host-code  as integer                      no-undo.
      484   define input parameter p-obj-type   like ub.clients.obj-type        no-undo.
      485   define input parameter p-obj-code   like ub.clients.obj-code        no-undo.
      486   define output parameter p-deleted   as logical                      no-undo.
      487       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
      488       define variable v-type              as character                no-undo.
      489       define variable v-format            as character                no-undo.
      490       define variable v-label             as character                no-undo.
      491       define variable v-user-can-edit     as logical                  no-undo.
      492       define variable v-output-display    as logical                  no-undo.
      493       define variable v-other             as character                no-undo.
      494       run grp-attr-name in this-procedure
      495       ( input  p-code
      496       , output v-type
      497       , output v-format
      498       , output v-label
      499       , output v-user-can-edit
      500       , output v-output-display
      501       , output v-other
      502       ) no-error .
      503       if error-status :error then do:
      504           undo, return error return-value .
      505       end.
      506       find first buf_gds-grp-attr exclusive-lock
      507            where buf_gds-grp-attr.node-code  = p-node-code
      508              and buf_gds-grp-attr.attr-code  = p-code
      509              and buf_gds-grp-attr.host-code  = p-host-code
      510              and buf_gds-grp-attr.obj-type   = p-obj-type
      511              and buf_gds-grp-attr.obj-code   = p-obj-code
      512       no-error.
      513       if not available buf_gds-grp-attr
      514       then do:
      515           assign
      516               p-deleted = no
      517           .
      518       end.
      519       else do:
      520          delete buf_gds-grp-attr.
      521          assign
      522               p-deleted = yes
      523           .
      524       end.
      525   end.
      526   end procedure.
      527   procedure grp-attr-news :
      528   do
      529   on error undo, return error
      530   :
      531       define input  parameter p-code           as character no-undo .
      532       define output parameter p-news           as logical   no-undo .
      533       case p-code :
      534               when 'gds-grp-nabor':U then do:     assign     p-news = true.   end.
      535         otherwise do:
      536           undo, return error "неизвестный атрибут товара на фирме" + " " + p-code .
      537         end.
      538       end.
      539   end.
      540   end procedure.
      541   procedure grp-attr-obj-value :
      542   do
      543   on error undo, return error
      544   :
      545   define input parameter p-node-code as integer      no-undo.
      546   define input parameter p-obj-type  as character    no-undo.
      547   define input parameter p-obj-code  as integer      no-undo.
      548   define input parameter p-attr-code as character    no-undo .
      549   define output parameter p-attr-value     as character   no-undo.
      550   define output parameter p-range     as integer      no-undo.
      551   define output parameter p-exists    as logical      no-undo.
      552   define variable v-host-code as integer      no-undo.
      553   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      554   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      555     (input  p-obj-type
      556     ,input  p-obj-code
      557     ,output v-host-code
      558     ) no-error .
      559   if error-status :error
      560   then do:
      561       message
      562         vss-workfile vss-revision vss-description
      563         skip "Не удалось найти фирму объекта"
      564         skip p-obj-type p-obj-code
      565         skip return-value
      566         skip trim(error-status :get-message(1))
      567              trim(error-status :get-message(2))
      568              trim(error-status :get-message(3))
      569              trim(error-status :get-message(4))
      570              trim(error-status :get-message(5))
      571       view-as alert-box error.
      572       undo, return error .
      573   end.
      574   define buffer buf_gds-grp-attr      for ub.gds-grp-attr.
      575   find first buf_gds-grp-attr no-lock
      576        where buf_gds-grp-attr.node-code = p-node-code
      577          and buf_gds-grp-attr.attr-code = p-attr-code
      578          and buf_gds-grp-attr.host-code = v-host-code
      579          and buf_gds-grp-attr.obj-type  = p-obj-type
      580          and buf_gds-grp-attr.obj-code  = p-obj-code
      581   no-error .
      582   if not available buf_gds-grp-attr
      583   then do:
      584       find first buf_gds-grp-attr no-lock
      585            where buf_gds-grp-attr.node-code = p-node-code
      586              and buf_gds-grp-attr.attr-code = p-attr-code
      587              and buf_gds-grp-attr.host-code = v-host-code
      588              and buf_gds-grp-attr.obj-type  = ""
      589              and buf_gds-grp-attr.obj-code  = 0
      590       no-error .
      591       if not available buf_gds-grp-attr
      592       then do:
      593           find first buf_gds-grp-attr no-lock
      594               where buf_gds-grp-attr.node-code = p-node-code
      595               and buf_gds-grp-attr.attr-code = p-attr-code
      596               and buf_gds-grp-attr.host-code = 0
      597               and buf_gds-grp-attr.obj-type  = ""
      598               and buf_gds-grp-attr.obj-code  = 0
      599           no-error .
      600           if not available buf_gds-grp-attr
      601           then do:
      602               assign
      603                   p-exists = no
      604               .
      605           end.
      606           else do:
      607               assign
      608                   p-exists = yes
      609                   p-range  = 1
      610               .
      611           end.
      612       end.
      613       else do:
      614           assign
      615               p-exists = yes
      616               p-range  = 2
      617           .
      618       end.
      619   end.
      620   else do:
      621       assign
      622           p-exists = yes
      623           p-range  = 3
      624       .
      625   end.
      626   if available buf_gds-grp-attr
      627   then do:
      628     assign
      629     p-attr-value = buf_gds-grp-attr.attr-value
      630     .
      631   end.
      632   end.
      633   end procedure.
      634   procedure ver-gds-grp-nabor :
      635   do
      636   on error undo, return error return-value
      637   :
      638   define input  parameter p-gds-code as integer   no-undo .
      639   define output parameter p-nabor as logical   no-undo .
      640   define buffer buf_goods for ub.goods.
      641   p-nabor = false .
      642   find first  buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
      643   if error-status :error then return error .
      644   define variable v-value       as character  no-undo.
      645   define variable v-type        as character  no-undo.
      646     run grp-attr-value (
      647        input   buf_goods.grp-code
      648       ,input   'gds-grp-nabor':U
      649       ,input   0
      650       ,input   ""
      651       ,input   0
      652       ,output  v-value
      653       ,output  v-type       ) no-error .
      654       if error-status :error then return error .
      655     if v-value = "yes" then p-nabor = true  .
      656   end.
      657   end procedure.
