      802   define variable v-mess-err as character no-undo .
      803   define buffer g-producer for ub.clients.
      804   DEFINE BUTTON b-exit
      805        LABEL "&Ввод ":L
      806        SIZE 10 BY 1.
      807   DEFINE BUTTON b-help
      808        LABEL "Помо&щь":L
      809        SIZE 10 BY 1.
      810   DEFINE BUTTON b-quit AUTO-END-KEY
      811        LABEL "&Отмена":L
      812        SIZE 10 BY 1.
      813   DEFINE BUTTON r-goods
      814        LABEL "Справочник"
      815        SIZE 13 BY 1 TOOLTIP "Справочник товаров".
      816   DEFINE BUTTON r-list
      817        LABEL "Список"
      818        SIZE 13 BY 1 TOOLTIP "Список товаров".
      819   DEFINE QUERY d-chs-gds FOR
      820         ub.ext-artic SCROLLING.
      821   DEFINE FRAME d-chs-gds
      822        b-exit AT ROW 1 COL 1
      823        b-quit AT ROW 1 COL 11
      824        b-help AT ROW 1 COL 43
      825        ub.goods.artic AT ROW 3 COL 19.5 COLON-ALIGNED
      826             VIEW-AS FILL-IN
      827             SIZE 11.63 BY 1
      828        r-goods AT ROW 3 COL 38.75
      829        ub.goods.prod-code AT ROW 4.17 COL 19.5 COLON-ALIGNED
      830             VIEW-AS FILL-IN
      831             SIZE 11.13 BY 1
      832        ub.goods.prod-type AT ROW 4.17 COL 30.75 COLON-ALIGNED NO-LABEL
      833             VIEW-AS FILL-IN
      834             SIZE 4 BY 1
      835        r-list AT ROW 4.17 COL 38.75
      836        ub.ext-artic.ext-artic AT ROW 5.38 COL 19.5 COLON-ALIGNED
      837             LABEL "Внешний артикул"
      838             VIEW-AS FILL-IN
      839             SIZE 17 BY 1
      840        SPACE(14.50) SKIP(0.74)
      841       WITH VIEW-AS DIALOG-BOX
      842            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      843            TITLE "Строка":L.
      844   ASSIGN
      845          FRAME d-chs-gds:SCROLLABLE       = FALSE.
      846   ON CHOOSE OF b-exit IN FRAME d-chs-gds
      847   DO:
      848   run check-goods no-error.
      849   if error-status:error then run run-ref in this-procedure .
      850   if ref-list = '' then do:   apply "entry" to ub.goods.artic in frame d-chs-gds.   return no-apply. end. find ub.goods where recid (ub.goods) = integer (entry (1, ref-list)) no-lock. assign  parartic     = ub.goods.artic. disp ub.goods.prod-type ub.goods.prod-code ub.goods.artic with frame d-chs-gds. apply "go" to frame d-chs-gds.
      851   END.
      852   ON CHOOSE OF b-quit IN FRAME d-chs-gds
      853   DO:
      854     ref-list = "".
      855   END.
      856   on end-error, stop of frame d-chs-gds do:
      857   apply "choose" to b-quit in frame d-chs-gds.
      858   return no-apply.
      859   end.
      860   ON return, MOUSE-SELECT-DBLCLICK OF ub.goods.artic, ub.goods.prod-type, ub.goods.prod-code, ub.ext-artic.ext-artic IN FRAME d-chs-gds DO:
      861   apply "choose" to b-exit in frame d-chs-gds.
      862   return no-apply.
      863   END.
      864   ON ctrl-cursor-down OF ub.goods.artic, ub.goods.prod-type, ub.goods.prod-code IN FRAME d-chs-gds DO:
      865      run run-ref in this-procedure .
      866      if ref-list = '' then do:   apply "entry" to ub.goods.artic in frame d-chs-gds.   return no-apply. end. find ub.goods where recid (ub.goods) = integer (entry (1, ref-list)) no-lock. assign  parartic     = ub.goods.artic. disp ub.goods.prod-type ub.goods.prod-code ub.goods.artic with frame d-chs-gds. apply "go" to frame d-chs-gds.
      867   end.
      868   on alt-cursor-down of ub.goods.artic, ub.goods.prod-type, ub.goods.prod-code in frame d-chs-gds do:
      869      run run-list in this-procedure .
      870      if ref-list = '' then do:   apply "entry" to ub.goods.artic in frame d-chs-gds.   return no-apply. end. find ub.goods where recid (ub.goods) = integer (entry (1, ref-list)) no-lock. assign  parartic     = ub.goods.artic. disp ub.goods.prod-type ub.goods.prod-code ub.goods.artic with frame d-chs-gds. apply "go" to frame d-chs-gds.
      871   END.
      872   ON CHOOSE OF r-goods IN FRAME d-chs-gds
      873   DO:
      874     run run-ref in this-procedure .
      875   if ref-list = '' then do:   apply "entry" to ub.goods.artic in frame d-chs-gds.   return no-apply. end. find ub.goods where recid (ub.goods) = integer (entry (1, ref-list)) no-lock. assign  parartic     = ub.goods.artic. disp ub.goods.prod-type ub.goods.prod-code ub.goods.artic with frame d-chs-gds. apply "go" to frame d-chs-gds.
      876   END.
      877   ON CHOOSE OF r-list IN FRAME d-chs-gds
      878   DO:
      879     run run-list in this-procedure .
      880     if ref-list = '' then do:   apply "entry" to ub.goods.artic in frame d-chs-gds.   return no-apply. end. find ub.goods where recid (ub.goods) = integer (entry (1, ref-list)) no-lock. assign  parartic     = ub.goods.artic. disp ub.goods.prod-type ub.goods.prod-code ub.goods.artic with frame d-chs-gds. apply "go" to frame d-chs-gds.
      881   END.
      882   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-chs-gds:PARENT eq ?
      883   THEN FRAME d-chs-gds:PARENT = ACTIVE-WINDOW.
      884   ON WINDOW-CLOSE OF FRAME d-chs-gds APPLY "END-ERROR":U TO SELF.
      885   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      886   on help of frame d-chs-gds
      887   do:
      888     run gbl/app_help.p
      889       (input this-procedure :file-name
      890       ,input ''
      891       ,input ?
      892       ) no-error.
      893     if error-status :error then do:
      894       message
      895         "Ошибка при вызове помощи"
      896         error-status :get-message(1)
      897         view-as alert-box .
      898     end.
      899   end.
      900   run minbtn-set in this-procedure .
      901   on choose of b-help in frame d-chs-gds
      902   do:
      903     apply "help":u to frame d-chs-gds .
      904   end.
      905   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      906   procedure minbtn-set :
      907       do
      908           on error undo, return error return-value
      909           :
      910           define variable ii              as integer       no-undo .
      911           define variable fh              as widget-handle no-undo .
      912           define variable hh              as widget-handle no-undo .
      913           define variable v-h             as handle        extent 4 no-undo .
      914           define variable v-name-button   as character     no-undo .
      915           define variable v-help-old-x    as decimal       no-undo .
      916           define variable v-help-old-y    as decimal       no-undo .
      917           define variable v-help-old-size as decimal       no-undo .
      918           define variable v-frame-width   as decimal       no-undo .
      919           define variable jj              as integer       no-undo .
      920           do
      921               on error undo, return error
      922               :
      923               assign
      924                   v-frame-width = frame d-chs-gds:width - 0.3
      925                   fh            = frame d-chs-gds:first-child
      926                   hh            = fh:first-child
      927                   ii            = 1
      928                   .
      929               do while valid-handle(hh):
      930                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      931                   do:
      932                       case lc(hh:name) :
      933                           when "b-help" then
      934                               do:
      935                                   hh:load-image-up("cmp/b-help.bmp":u) .
      936                                   hh:load-image-down("cmp/b-help.bmp":u) .
      937                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      938                                   hh:TOOLTIP = "Помощь" .
      939                                   v-help-old-x = hh:column .
      940                                   v-help-old-y = hh:row    .
      941                                   v-help-old-size = hh:width .
      942                                   hh:width-chars = 2.5 .
      943                               end.
      944                           when "b-print" then
      945                               do:
      946                                   hh:load-image("cmp/b-print.bmp":u) .
      947                                   hh:TOOLTIP = "Печать" .
      948                                   v-h[ii] = hh:handle .
      949                                   ii = ii + 1 .
      950                                   hh:width-chars = 3 .
      951                               end.
      952                           when "b-history" or
      953                           when "b-hist" then
      954                               do:
      955                                   hh:load-image("cmp/b-hist.bmp":u) .
      956                                   hh:TOOLTIP = "История" .
      957                                   v-h[ii] = hh:handle .
      958                                   ii = ii + 1 .
      959                                   hh:width-chars = 3 .
      960                               end.
      961                           when "b-sch" then
      962                               do:
      963                                   hh:load-image("cmp/b-sch.bmp":u) .
      964                                   hh:TOOLTIP = "Установка Фильтра" .
      965                                   v-h[ii] = hh:handle .
      966                                   ii = ii + 1 .
      967                                   hh:width-chars = 3 .
      968                               end.
      969                           when "b-hist-user" then
      970                               do:
      971                                   hh:load-image("cmp/b-hist.bmp":u) .
      972                                   hh:TOOLTIP = "История пользователя" .
      973                                   ii = ii + 1 .
      974                               end.
      975                       end case.
      976                   end.
      977                   hh = hh:next-sibling.
      978               end.
      979               b-help:column = v-frame-width - b-help:width-chars.
      980               jj = 0.
      981               repeat ii = 4 to 1 by -1 :
      982                   if valid-handle (v-h[ii] ) then
      983                   do:
      984                       jj  = jj + 1 .
      985                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      986                       v-h[ii]:row    = v-help-old-y .
      987                   end.
      988               end.
      989           end.
      990       end.
      991   end procedure.
      992   MAIN-BLOCK:
      993   DO ON ERROR   UNDO MAIN-BLOCK, return
      994      ON END-KEY UNDO MAIN-BLOCK, return:
      995   frame d-chs-gds:title = f-title + " -  " + 'ДОБАВЛЕНИЕ':U.
      996   ENABLE ub.goods.artic ub.goods.prod-code ub.goods.prod-type r-goods r-list b-exit b-quit b-help WITH FRAME d-chs-gds.
      997   find first ub.clients where ub.clients.obj-type = parcli-type and
      998                            ub.clients.obj-code = parcli-code no-lock no-error.
      999   if available ub.clients then enable ub.ext-artic.ext-artic with frame d-chs-gds.
     1000                        else ub.ext-artic.ext-artic:visible in frame d-chs-gds = no.
     1001   disp parartic     @ ub.goods.artic
     1002   with frame d-chs-gds.
     1003   if input frame d-chs-gds ub.goods.prod-type = "" or
     1004      input frame d-chs-gds ub.goods.prod-type = ?  or
     1005      input frame d-chs-gds ub.goods.prod-type = "?"
     1006      then
     1007      disp 'орг':U @ ub.goods.prod-type with frame d-chs-gds.
     1008   WAIT-FOR GO OF FRAME d-chs-gds focus ub.goods.artic.
     1009   END.
     1010   run disable_ui.
     1011   PROCEDURE pr :
     1012   END PROCEDURE.
     1013   PROCEDURE disable_UI :
     1014     HIDE FRAME d-chs-gds.
     1015   END PROCEDURE.
     1016   PROCEDURE run-ref:
     1017   define variable v-stat as character no-undo init ?.
     1018   define variable v-list as character no-undo init ?.
     1019   define variable v-cond as character no-undo init ?.
     1020   define variable v-prod-type like ub.clients.obj-type no-undo .
     1021   define variable v-prod-code like ub.clients.obj-code no-undo .
     1022   if can-find (ub.clients where ub.clients.obj-type = input frame d-chs-gds ub.goods.prod-type
     1023                          and ub.clients.obj-code = input frame d-chs-gds ub.goods.prod-code no-lock) then do:
     1024     find g-producer where g-producer.obj-type = input frame d-chs-gds ub.goods.prod-type
     1025                                  and g-producer.obj-code = input frame d-chs-gds ub.goods.prod-code no-lock.
     1026     v-list = 'Производитель':U.
     1027   end.
     1028   else
     1029   v-list = 'все':U.
     1030   v-stat = 'текущие':U.
     1031   run ref/gds-ref.p
     1032       ( parParentProc
     1033       ,"b-sel,b-mark,b-add"
     1034       ,v-stat
     1035       ,v-list
     1036       ,v-cond
     1037       ,?
     1038       ,?
     1039       ,(if available g-producer then g-producer.obj-type else ?)
     1040       ,(if available g-producer then g-producer.obj-code else ?)
     1041       ,v-cntxt-obj-type
     1042       ,v-cntxt-obj-code
     1043       ,?
     1044       , output ref-list).
     1045   define variable new-ref-list as character no-undo init "" .
     1046   define variable i as integer   no-undo .
     1047   repeat i = 1 to num-entries (ref-list) :
     1048     find first ub.goods where recid (ub.goods) = integer (entry (i, ref-list)) no-lock  .
     1049       run ver-gds in this-procedure  (ub.goods.gds-code, output v-erase ,output v-mess-err) no-error  .
     1050       if v-erase = false then do:
     1051          new-ref-list = new-ref-list + min (",", new-ref-list) + string (recid (ub.goods)).
     1052       end.
     1053   end.
     1054   if num-entries (ref-list) <> num-entries (new-ref-list) then
     1055   run view-exept-gds ( substitute("Не все отмеченные позиции вошли в список !&1Просмотреть товары не вошедшие в список ?", chr(10))) .
     1056   ref-list = new-ref-list .
     1057   run uf-get in this-procedure(
     1058        input  'gds-ref-p':U
     1059       ,input  v-cntxt-userid
     1060       ,output v-uf-List_
     1061       ,output v-uf-Naim
     1062       ,output v-uf-print-graft
     1063       ,output v-uf-sort-gr
     1064       ,output v-uf-type-price
     1065       ,output v-uf-type-val
     1066   )  no-error.
     1067   if not error-status:error
     1068   and num-entries(v-uf-List_, chr(4)) = 8
     1069   then do:
     1070     assign
     1071     v-list       = entry(2, v-uf-List_, chr(4))
     1072     v-prod-type  = entry(6, v-uf-List_, chr(4))
     1073     v-prod-code  = integer(entry(7, v-uf-List_, chr(4)))
     1074     no-error
     1075     .
     1076     if not error-status:error and v-list = 'Производитель':U then do:
     1077       find first g-producer no-lock where
     1078                 g-producer.obj-type = v-prod-type
     1079             AND g-producer.obj-code = v-prod-code no-error .
     1080     end.
     1081   end.
     1082   define variable iii as integer no-undo .
     1083     repeat iii = 1 to num-entries(ref-list) :
     1084         FIND FIRST ub.goods WHERE recid(ub.goods) = int(entry(iii, ref-list))  no-lock .
     1085         if avail ub.goods then do:
     1086           if not can-find(first tt-gds-list where tt-gds-list.gds-code = ub.goods.gds-code no-lock ) Then do:
     1087               create tt-gds-list.
     1088               BUFFER-COPY ub.goods to tt-gds-list .
     1089               assign  tt-gds-list.nn = iii.
     1090           end.
     1091         end.
     1092     end.
     1093   END PROCEDURE.
     1094   PROCEDURE run-list:
     1095   define variable v-f as logical   no-undo init false .
     1096   run str/gds-list.w ( input parParentProc, input v-cntxt-host-code-obj, input v-cntxt-obj-type, input v-cntxt-obj-code).
     1097   ref-list = ''.
     1098   FOR EACH gds-list NO-LOCK by gds-list.order-num :
     1099       run ver-gds in this-procedure ( gds-list.gds-code, output v-erase , output v-mess-err ) no-error .
     1100       if v-erase = false  then do:
     1101           find first ub.goods where ub.goods.artic     = gds-list.artic     and
     1102                                  ub.goods.prod-code = gds-list.prod-code and
     1103                                  ub.goods.prod-type = gds-list.prod-type no-lock.
     1104               ref-list = string (recid(ub.goods)) .
     1105               nn = nn + 1.
     1106             if not can-find(first tt-gds-list where tt-gds-list.gds-code = gds-list.gds-code no-lock ) Then do:
     1107                 create tt-gds-list.
     1108                 BUFFER-COPY gds-list to tt-gds-list .
     1109                 assign tt-gds-list.nn = nn .
     1110             end.
     1111       end.
     1112       else v-f = true .
     1113   END.
     1114   if v-f = true then run view-exept-gds ( substitute("Не все отмеченные позиции вошли в список !&1Просмотреть товары не вошедшие в список ?", chr(10))) .
     1115   END PROCEDURE.
     1116   PROCEDURE check-goods :
     1117   def buffer gds-b for ub.goods.
     1118   def buffer buf_ext-artic for ub.ext-artic.
     1119   ref-list = ''.
     1120   if ub.ext-artic.ext-artic:sensitive in frame d-chs-gds = yes and
     1121      input frame d-chs-gds ub.ext-artic.ext-artic <> ""        and
     1122      input frame d-chs-gds ub.ext-artic.ext-artic <> "?"       and
     1123      input frame d-chs-gds ub.ext-artic.ext-artic <> ?         then do:
     1124      find first ub.ext-artic where ub.ext-artic.cli-type    = parcli-type
     1125                             and ub.ext-artic.cli-code    = parcli-code
     1126                             and ub.ext-artic.ext-artic   = input frame d-chs-gds ub.ext-artic.ext-artic
     1127                             and ub.ext-artic.status_    <> 'удаленные':U
     1128                             no-lock no-error.
     1129      if available ub.ext-artic then do:
     1130         find first buf_ext-artic where buf_ext-artic.cli-type  =  parcli-type
     1131                                    and buf_ext-artic.cli-code  =  parcli-code
     1132                                    and buf_ext-artic.ext-artic =  ub.ext-artic.ext-artic
     1133                                    and buf_ext-artic.status_   <> 'удаленные':U
     1134                                    and buf_ext-artic.gds-code  <> ub.ext-artic.gds-code
     1135         no-lock no-error .
     1136         if available ( buf_ext-artic ) then do:
     1137           message "С внешним артикулом :" input frame d-chs-gds ub.ext-artic.ext-artic
     1138                           "связано несколько товаров." skip (2)
     1139                           "Укажите Производителя или выберите товар из справочника.".
     1140           apply "entry" to ub.goods.prod-code in frame d-chs-gds.
     1141           return.
     1142         end.
     1143         find first gds-b where gds-b.gds-code = ub.ext-artic.gds-code no-lock no-error .
     1144         if not available gds-b then do:
     1145           message "Не могу найти товар связанный с внешним артикулом " ub.ext-artic.ext-artic view-as alert-box information .
     1146           apply "entry" to ub.goods.prod-code in frame d-chs-gds.
     1147           return.
     1148         end.
     1149         display gds-b.artic     @ ub.goods.artic
     1150                 gds-b.prod-type @ ub.goods.prod-type
     1151                 gds-b.prod-code @ ub.goods.prod-code
     1152                 with frame d-chs-gds.
     1153      end.
     1154      else do:
     1155         message "Неправильный внешний артикул!" view-as alert-box information.
     1156         display "" @ ub.ext-artic.ext-artic with frame d-chs-gds.
     1157         apply "entry" to ub.goods.prod-code in frame d-chs-gds.
     1158         return .
     1159      end.
     1160   end.
     1161   if input frame d-chs-gds ub.goods.artic = '' then return error.
     1162   find first ub.goods where ub.goods.artic  = input frame d-chs-gds ub.goods.artic no-lock no-error.
     1163   if not available ub.goods then do:
     1164     message "Неправильный Артикул - такого товара нет.".
     1165     apply "entry" to ub.goods.artic in frame d-chs-gds.
     1166     return.
     1167   end.
     1168   find first gds-b where gds-b.artic  = input frame d-chs-gds ub.goods.artic
     1169                      and recid (gds-b) <> recid (ub.goods)
     1170                      and gds-b.stts = 0 no-lock no-error.
     1171   if input frame d-chs-gds ub.goods.prod-code <> 0 then do:
     1172     find first ub.goods where ub.goods.prod-code   = input frame d-chs-gds ub.goods.prod-code
     1173                        and  ub.goods.artic      = input frame d-chs-gds ub.goods.artic no-lock no-error.
     1174     if not available ub.goods then do:
     1175       message "Неправильный Код производителя - такого товара нет.".
     1176       apply "entry" to ub.goods.prod-code in frame d-chs-gds.
     1177       return.
     1178     end.
     1179     find first gds-b where gds-b.artic     = input frame d-chs-gds ub.goods.artic
     1180                        and gds-b.prod-code = input frame d-chs-gds ub.goods.prod-code
     1181                        and recid (gds-b) <> recid (ub.goods)
     1182                        and gds-b.stts = 0 no-lock no-error.
     1183   end.
     1184   else do:
     1185     if available gds-b then do:
     1186       if available g-producer then
     1187         find ub.goods where ub.goods.prod-type = g-producer.obj-type
     1188                              and  ub.goods.prod-code = g-producer.obj-code
     1189                              and  ub.goods.artic          = input frame d-chs-gds ub.goods.artic no-lock no-error.
     1190       if not available g-producer or (available g-producer and not available ub.goods) then do:
     1191         message "С артикулом :" input frame d-chs-gds ub.goods.artic
     1192                         "несколько товаров." skip (2)
     1193                         "Укажите Производителя или выберите товар из справочника.".
     1194         apply "entry" to ub.goods.prod-code in frame d-chs-gds.
     1195         return.
     1196       end.
     1197     end.
     1198   end.
     1199   if input frame d-chs-gds ub.goods.prod-code <> 0  and
     1200      input frame d-chs-gds ub.goods.prod-type <> "" then do:
     1201      find ub.goods where ub.goods.prod-type = input frame d-chs-gds ub.goods.prod-type and
     1202                      ub.goods.prod-code = input frame d-chs-gds ub.goods.prod-code and
     1203                      ub.goods.artic     = input frame d-chs-gds ub.goods.artic no-lock no-error.
     1204      if not available ub.goods then do:
     1205       message "Неправильный Тип производителя - такого товара нет.".
     1206       apply "entry" to ub.goods.prod-type in frame d-chs-gds.
     1207       return.
     1208      end.
     1209   end.
     1210   else do:
     1211     if available gds-b then do:
     1212       if available g-producer then
     1213         find ub.goods where ub.goods.prod-type = g-producer.obj-type and
     1214                          ub.goods.prod-code = g-producer.obj-code and
     1215                          ub.goods.artic     = input frame d-chs-gds ub.goods.artic no-lock no-error.
     1216       if not available g-producer or (available g-producer and not available ub.goods) then do:
     1217         message "С артикулом :" input frame d-chs-gds ub.goods.artic
     1218                         "несколько товаров." skip (2)
     1219                         "Укажите Производителя или выберите товар из справочника.".
     1220         apply "entry" to ub.goods.prod-type in frame d-chs-gds.
     1221         return.
     1222       end.
     1223     end.
     1224   end.
     1225   run ver-gds in this-procedure (ub.goods.gds-code, output v-erase, output v-mess-err) no-error .
     1226   if v-erase = true then do:
     1227         run view-exept-gds ( substitute("Не все отмеченные позиции вошли в список !&1Просмотреть товары не вошедшие в список ?", chr(10))) .
     1228         apply "entry" to ub.goods.artic in frame d-chs-gds.
     1229         return.
     1230   end.
     1231   ref-list = string (recid (ub.goods)).
     1232   create tt-gds-list.
     1233   BUFFER-COPY ub.goods to tt-gds-list.
     1234          assign tt-gds-list.nn = 1.
     1235   END PROCEDURE.
     1236   procedure ver-gds :
     1237    do
     1238    on error undo, return error return-value
     1239    :
     1240   define input  parameter  p-gds-code as integer   no-undo .
     1241   define output parameter  v-nabor    as logical   no-undo .
     1242   define output parameter  p-mess-err as character no-undo .
     1243   define variable  v-err as logical   no-undo .
     1244   v-nabor = false .
     1245   p-mess-err = "" .
     1246   if
     1247     not ver-flor
     1248     then do:
     1249       run ver-gds-grp-nabor in this-procedure ( input p-gds-code, output v-nabor) .
     1250       p-mess-err = "Нетоварная позиция код: " + string(p-gds-code) .
     1251       run creat-tt (p-gds-code , (if v-nabor = true then p-mess-err else "") ) .
     1252     end.
     1253     run ver-assort-polit in this-procedure  (p-gds-code, output v-err ) no-error .
     1254     if v-err = true then do:
     1255        v-nabor = true .
     1256        run creat-tt (p-gds-code , (if v-nabor = true then return-value  else "") ) .
     1257     end.
     1258   end.
     1259   end procedure.
     1260   procedure ver-assort-polit :
     1261     do
     1262     on error undo, return error return-value
     1263     :
     1264   define input  parameter p-gds-code as integer   no-undo .
     1265   define output parameter  v-del   as logical   no-undo .
     1266   v-del = false .
     1267   if p-type-doc = "gds-matr"
     1268      or p-type-doc = "inv"
     1269      or p-type-doc = "price-list"
     1270      or p-type-doc = "accor"
     1271      or p-type-doc = "alc-type"
     1272      or p-type-doc = "season"
     1273      or p-type-doc = "order" + 'ФП':U
     1274      or p-type-doc = "temp"
     1275      then return .
     1276   define variable var-ok-assort-pol as logical   no-undo .
     1277   define variable var-mess-assort-pol as character no-undo .
     1278   define variable v-event-code as character no-undo .
     1279    assign
     1280     var-ok-assort-pol = true
     1281     v-event-code = substring(p-type-doc,6,2)
     1282    .
     1283   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1284   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run goassizt in g#library2
     1285     (input  v-event-code
     1286     ,input  p-gds-code
     1287     ,input  v-cntxt-obj-type
     1288     ,input  v-cntxt-obj-code
     1289     ,input  true
     1290     ,output var-ok-assort-pol
     1291     ,output var-mess-assort-pol
     1292     ) .
     1293         if var-ok-assort-pol = false then do:
     1294             v-del = true .
     1295             return var-mess-assort-pol .
     1296         end.
     1297     end.
     1298   end procedure.
