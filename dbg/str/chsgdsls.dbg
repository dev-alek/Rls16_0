      764   procedure view-exept-gds :
      765   define input  parameter p-str as character no-undo .
      766   define variable loc-ok as logical   no-undo .
      767     do
      768     on error undo, return error return-value
      769     :
      770     message p-str
      771              view-as alert-box question
      772              buttons yes-no
      773              update loc-ok
      774               .
      775   if loc-ok then
      776       run gbl/tt-view.w
      777       ( input table  temp-err ).
      778     end.
      779   end procedure.
      780   procedure creat-tt :
      781     do
      782     on error undo, return error return-value
      783     :
      784       define input  parameter p-gds-code as integer   no-undo .
      785       define input  parameter p-str as character no-undo .
      786       find first temp-err where
      787                  temp-err.gds-code = p-gds-code no-error .
      788                  if available temp-err then return .
      789       if p-str  <> "" then do:
      790          create temp-err.
      791          assign
      792            temp-err.gds-code = p-gds-code
      793            temp-err.str = p-str
      794        .
      795       end.
      796     end.
      797   end procedure.
      798   define variable conf-par   as character no-undo .
      799   define variable par-type   as character no-undo .
      800   define variable nn as integer no-undo .
