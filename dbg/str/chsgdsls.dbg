        1   define temp-table tt-gds-list no-undo like ub.goods
        2   field nn as integer
        3   index by-nn nn
        4   index by_gds-code gds-code
        5   .
        6   define input        parameter parParentProc  as widget-handle no-undo.
        7   define input        parameter p-type-doc     as character no-undo .
        8   define input        parameter f-title        as character no-undo.
        9   define input        parameter parcli-type  like ub.trn-doc.cli-type   no-undo.
       10   define input        parameter parcli-code  like ub.trn-doc.cli-code   no-undo.
       11   define input        parameter parhost-code like ub.trn-doc.host-code  no-undo.
       12   define input-output parameter parartic     like ub.doc-line.artic     no-undo.
       13   define output       parameter ref-list       as character no-undo.
       14   define output       parameter table for  tt-gds-list .
       15   define input        parameter ver-flor       as logical   no-undo .
       16   define variable vss-revision    as character no-undo init "$Revision$":u .
       17   define variable vss-author      as character no-undo init "$Author$":u .
       18   define variable vss-date        as character no-undo init "$Date$":u .
       19   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       20   define variable vss-archive     as character no-undo init "$Archive$":u .
       21   define variable vss-description as character no-undo init "Выбор списка товаров" .
       22   procedure vss-get-info :
       23     define output parameter p-vss-revision    like vss-revision    no-undo .
       24     define output parameter p-vss-author      like vss-author      no-undo .
       25     define output parameter p-vss-date        like vss-date        no-undo .
       26     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       27     define output parameter p-vss-archive     like vss-archive     no-undo .
       28     define output parameter p-vss-description like vss-description no-undo .
       29     assign
       30       p-vss-revision    = vss-revision
       31       p-vss-author      = vss-author
       32       p-vss-date        = vss-date
       33       p-vss-workfile    = vss-workfile
       34       p-vss-archive     = vss-archive
       35       p-vss-description = vss-description
       36     .
       37   end procedure.
       38   procedure vss-get-parameters :
       39     define output parameter p-vss-parameters as character no-undo .
       40   end procedure.
       41   define new global shared variable g#vssrevis-logger as handle    no-undo .
       42   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       43   define variable v-vssrevis-logger                   as handle    no-undo .
       44   procedure vss-logevent :
       45     define input  parameter p-extra-paramters as character no-undo .
       46     define variable v-vssrevis-parameters as character no-undo .
       47     do
       48     on error undo, return error return-value
       49     :
       50       if  valid-handle(v-vssrevis-logger)
       51       and v-vssrevis-logger :get-signature("logevent") <> ""
       52       then do:
       53         run vss-get-parameters in this-procedure
       54           (output v-vssrevis-parameters
       55           ).
       56         run logevent in v-vssrevis-logger
       57           (input vss-workfile
       58           ,input vss-revision
       59           ,input v-vssrevis-parameters
       60           ,input p-extra-paramters
       61           ).
       62       end.
       63     end.
       64   end procedure.
       65   assign
       66     v-vssrevis-logger = g#vssrevis-logger
       67   .
       68   if  valid-handle(v-vssrevis-logger)
       69   and v-vssrevis-logger :get-signature("logevent") <> ""
       70   then do:
       71     assign
       72       v-vssrevis-logevent = true
       73     .
       74     run vss-logevent in this-procedure (input vss-description) .
       75   end.
       76   define new global shared variable g#language as character no-undo .
       77   if g#language <> '' and g#language <> 'rus':U then do:
       78     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       79   end.
       80   define new global shared variable g#library  as handle no-undo .
       81   define new global shared variable g#library2 as handle no-undo .
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
       84   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
       85   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
       86   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
       87   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
       88   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
       89   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
       90   procedure uf-name :
       91     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
       92     define output parameter p-use-List_     as logical   no-undo .
       93     define output parameter p-type-List_     as character no-undo .
       94     define output parameter p-format-List_   as character no-undo .
       95     define output parameter p-use-Naim      as logical   no-undo .
       96     define output parameter p-type-Naim      as character no-undo .
       97     define output parameter p-format-Naim    as character no-undo .
       98     define output parameter p-use-print-graft as logical   no-undo .
       99     define output parameter p-use-sort-gr   as logical   no-undo .
      100     define output parameter p-use-type-price as logical   no-undo .
      101     define output parameter p-use-type-val  as logical   no-undo .
      102     define output parameter p-label          as character no-undo .
      103     define output parameter p-tooltip        as character no-undo .
      104     define output parameter p-user-can-edit  as logical   no-undo .
      105     define output parameter p-output-display as logical   no-undo .
      106     define output parameter p-other          as character no-undo .
      107     do
      108     on error undo, return error
      109     :
      110       case p-code :
      111               when 'cli-all-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
