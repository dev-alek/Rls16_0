        1   block-level on error undo, throw.
        2   define output parameter par-rid as recid no-undo .
        3   define input parameter par-mode    as character no-undo .
        4   define input parameter pardoc-code like ub.wth-dtl.doc-code no-undo .
        5   define input parameter parwth-code like ub.wth-dtl.wth-code no-undo .
        6   define input parameter parw-p-code like ub.wth-dtl.w-p-code no-undo .
        7   define input parameter parpar-code like ub.wth-dtl.par-code no-undo .
        8   define input parameter pardoc-sum  like ub.wth-dtl.doc-sum no-undo .
        9   define input parameter parfact-sum  like ub.wth-dtl.fact-sum no-undo .
       10   define input parameter parsum-gds-rubl like  ub.wth-dtl.sum-gds-rubl no-undo .
       11   define input parameter parsum-gds-base like  ub.wth-dtl.sum-gds-base no-undo .
       12   define input parameter parline-exist as logical no-undo .
       13   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       14   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       15   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile: wth-dtl1.p $":U .
       17   define variable vss-archive     as character no-undo init "$Archive: str/wth-dtl1.p $":U .
       18   define variable vss-description as character no-undo init "Сохранение изменений в строке детализации документа МЦ".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define   shared variable g#auto as logical no-undo.
       80   define   shared variable g#news as logical no-undo.
       81   define   shared variable g#oxml as logical no-undo.
       82   define   shared variable g#esys as logical no-undo.
       83   define   shared variable g#news-source-db as integer no-undo.
       84   define   shared variable g#esys-source-esys as integer no-undo.
       85   define   shared variable g#db-num as integer   no-undo .
       86   define   shared variable g#userid as character no-undo .
       87   define   shared variable g#passwd as character no-undo .
       88   DEFINE VARIABLE var-entry as character no-undo .
       89   DEFINE VARIABLE loc#log as logical no-undo .
       90   define buffer buf_wth-line for ub.wth-line.
       91   define buffer buf_wth-doc for ub.wth-doc.
       92   define buffer buf_wth-parts for ub.wth-parts.
       93   if NOT (par-mode = 'ДОБАВЛЕНИЕ':U OR par-mode = 'ИЗМЕНЕНИЕ':U) then do:
       94     message
       95     vss-workfile vss-revision vss-description skip
       96     "Неверный параметр вызова par-mode" par-mode
       97     view-as alert-box ERROR.
       98     return error '':U.
       99   end.
      100   FIND FIRST buf_wth-doc EXCLUSIVE-LOCK WHERE
      101              buf_wth-doc.doc-code = pardoc-code No-ERROR No-WAIT.
      102   IF LOCKED buf_wth-doc then do:
      103     message vss-workfile vss-revision vss-description skip
      104             "Запись документа МЦ" pardoc-code "занята"
      105             "добавление/изменение строки невозможно"
      106     view-as alert-box error .
      107   end.
      108   IF NOT available buf_wth-doc then do:
      109     message vss-workfile vss-revision vss-description skip
      110             "Не найден документа МЦ" pardoc-code
      111     view-as alert-box error .
      112   end.
      113   FIND FIRST buf_wth-line EXCLUSIVE-LOCK WHERE
      114              buf_wth-line.doc-code = buf_wth-doc.doc-code AND
      115              buf_wth-line.wth-code = parwth-code AND
      116              buf_wth-line.w-p-code = parw-p-code No-ERROR No-WAIT.
      117   IF LOCKED buf_wth-line then do:
      118     message vss-workfile vss-revision vss-description skip
      119             "Запись строки документа МЦ" pardoc-code "занята"
      120             "добавление/изменение строки невозможно"
      121     view-as alert-box error .
      122   end.
      123   IF NOT available buf_wth-line then do:
      124     message vss-workfile vss-revision vss-description skip
      125             "Не найдена строка документа МЦ" pardoc-code parwth-code parw-p-code
      126     view-as alert-box error .
      127   end.
      128   IF NOT CAN-FIND( ub.wealth NO-LOCK WHERE ub.wealth.wth-code = parwth-code ) THEN DO:
      129     MESSAGE "Материальная ценность" parwth-code "не найдена в справочнике!"
      130     VIEW-AS ALERT-BOX ERROR.
      131     var-entry = "wth-code":U.
      132     RETURN ERROR var-entry.
      133   END.
      134   FIND FIRST ub.wth-dtl NO-LOCK WHERE
      135             ub.wth-dtl.doc-code = pardoc-code   AND
      136             ub.wth-dtl.wth-code = parwth-code   AND
      137             ub.wth-dtl.w-p-code = parw-p-code   AND
      138             ub.wth-dtl.par-code = parpar-code NO-ERROR.
      139   if buf_wth-doc.status_ = 'разрешен':U then do:
      140     if (
      141         (not available ub.wth-dtl and pardoc-sum <> 0) OR
      142         (avail ub.wth-dtl AND
      143           (ub.wth-dtl.doc-code <> pardoc-code OR
      144           ub.wth-dtl.wth-code <> parwth-code OR
      145           ub.wth-dtl.w-p-code <> parw-p-code OR
      146           (buf_wth-doc.doc-type <> 'инв':U and ub.wth-dtl.doc-sum <> pardoc-sum )
      147         )
      148         )
      149       ) then dO:
      150       message
      151       vss-workfile vss-revision vss-description skip
      152       "Документ МЦ имеет статус" buf_wth-doc.status_
      153       "возможно изменить только сумму факт"
      154       view-as alert-box ERROR.
      155       return error '':U.
      156     end.
      157   end.
      158   DO ON ERROR UNDO, return error '':U
      159      ON STOP UNDO, return error '':U:
      160   IF AVAIL ub.wth-dtl THEN DO:
      161     ASSIGN
      162     par-rid = RECID( ub.wth-dtl ).
      163     FIND FIRST ub.wth-dtl EXCLUSIVE-LOCK WHERE
      164                RECID( ub.wth-dtl ) = par-rid.
      165   END.
      166   ELSE DO:
      167   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      168   CREATE ub.wth-dtl.
      169   ASSIGN
      170     ub.wth-dtl.doc-code = buf_wth-line.doc-code
      171     ub.wth-dtl.wth-code = buf_wth-line.wth-code
      172     ub.wth-dtl.w-p-code = buf_wth-line.w-p-code
      173     ub.wth-dtl.par-code = parpar-code
      174     ub.wth-dtl.creid    = g#userid
      175     ub.wth-dtl.credate  = TODAY
      176   .
      177     ASSIGN par-rid = RECID( ub.wth-dtl ).
      178   END.
      179   IF buf_wth-doc.doc-type = 'инв':U THEN DO:
      180     ASSIGN
      181     ub.wth-dtl.bef-sum  = (if parline-exist then (ub.wth-dtl.bef-sum + pardoc-sum) else pardoc-sum )
      182     ub.wth-dtl.aft-sum  = (if parline-exist then (ub.wth-dtl.aft-sum + parfact-sum) else parfact-sum )
      183     .
      184   END.
      185   ELSE DO:
      186     ASSIGN
      187     ub.wth-dtl.doc-sum  =  (if parline-exist then (ub.wth-dtl.doc-sum + pardoc-sum) else pardoc-sum )
      188     ub.wth-dtl.fact-sum = (if parline-exist then (ub.wth-dtl.fact-sum + parfact-sum) else parfact-sum )
      189     ub.wth-dtl.sum-gds-rubl = (if parline-exist then (ub.wth-dtl.sum-gds-rubl + parsum-gds-rubl) else parsum-gds-rubl )
      190     ub.wth-dtl.sum-gds-base = (if parline-exist then (ub.wth-dtl.sum-gds-base + parsum-gds-base) else parsum-gds-base )
      191     .
      192   END.
      193   if ub.wth-dtl.doc-sum = 0 AND
      194       ub.wth-dtl.fact-sum = 0 and
      195       ub.wth-dtl.bef-sum = 0 and
      196       ub.wth-dtl.aft-sum = 0
      197       and not can-find(first buf_wth-parts where
      198                              buf_wth-parts.w-p-code = ub.wth-dtl.w-p-code
      199                              and buf_wth-parts.wth-code = ub.wth-dtl.wth-code
      200                              and buf_wth-parts.par-code = ub.wth-dtl.par-code
      201                              and buf_wth-parts.out-code = ub.wth-dtl.doc-code ) then do:
      202     delete ub.wth-dtl.
      203   end.
      204   else do:
      205        find first buf_wth-parts no-lock where
      206                              buf_wth-parts.w-p-code = ub.wth-dtl.w-p-code
      207                              and buf_wth-parts.wth-code = ub.wth-dtl.wth-code
      208                              and buf_wth-parts.par-code = ub.wth-dtl.par-code
      209                              and buf_wth-parts.out-code = ub.wth-dtl.doc-code no-error.
      210        if available buf_wth-parts then ub.wth-dtl.gds-code = buf_wth-parts.gds-code.
      211   end.
      212   END.
