     2244   .
     2245   FIND ub.shop WHERE ub.shop.obj-code = i-obj-code NO-LOCK .
     2246   FIND ub.sysconf WHERE ub.sysconf.host-code = ub.shop.host-code NO-LOCK .
     2247   run write-log-and-file in p-log-handle (
     2248             input 1
     2249           , input log-file-name
     2250           , input 1
     2251           , input substitute("Пересылка на кассы &1&2 стоплистов", 'маг':U, i-obj-code)
     2252                                                 ).
     2253   RUN SENDING in this-procedure ( input p-stop-list-code ) no-error.
     2254   if error-status:error then do:                                                                            run write-log-and-file in p-log-handle (                                                                      input 1                                                                                               , input log-file-name                                                                                   , input 1                                                                                               , input substitute("&1 &2", error-status:get-message(1), return-value)                                                                      ).                                                              assign                                                                                                  v-view-log = yes                                                                                        .                                                                                                     end.
     2255   .
     2256   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2257   PROCEDURE putc-sl.
     2258   define input parameter pos-type   as character no-undo.
     2259   define input parameter p-version  as character no-undo .
     2260   define input parameter p-full-stop-list-code as character no-undo .
     2261   define variable v-version-dec as decimal no-undo .
     2262   define variable v-ii as integer no-undo .
     2263   define buffer buf_stop-list-line for ub.stop-list-line.
     2264   CASE pos-type:
     2265     when 'IBM-XML':U  then do:
     2266       assign
     2267       v-version-dec = decimal(p-version) no-error .
     2268       if v-version-dec >= 1.07 then do:
     2269         run bgelib-tag-open in this-procedure ( input 2, input "StopList"
     2270                                               , input substitute("ctrl='&1' tms='&2' code='&3'"
     2271                                                                 ,'ADD':U
     2272                                                                 , OS2-time
     2273                                                                 , p-stop-list-code
     2274                                                                 )).
     2275       for each buf_stop-list-line no-lock where
     2276               buf_stop-list-line.classif-type =  'dis-card':U
     2277           and buf_stop-list-line.stop-list-code =  p-full-stop-list-code
     2278               :
     2279           if buf_stop-list-line.key#_one = integer('4':U) then next.
     2280           run bgelib-tag-open in this-procedure ( input 3
     2281                                                 , input "StopNum"
     2282                                                 , input '':U      ).
     2283           run bgelib-tag-put in this-procedure ( input 4, input "SNN"             , input buf_stop-list-line.charkey_one, input 0 ).
     2284           run bgelib-tag-put in this-procedure ( input 4, input "SNMes"             , input buf_stop-list-line.line-message, input 0 ).
     2285           run bgelib-tag-close in this-procedure ( input 3, input "StopNum").
     2286       end.
     2287       run bgelib-tag-close in this-procedure ( input 2, input "StopList").
     2288       if integer(p-stop-list-code) > 1 then do:
     2289         do v-ii = max((integer(p-stop-list-code) - 100), 1) to (integer(p-stop-list-code) - 1):
     2290           run bgelib-tag-open in this-procedure ( input 2, input "StopList"
     2291                                                   , input substitute("ctrl='&1' tms='&2' code='&3'"
     2292                                                                     ,'DEL':U
     2293                                                                     , OS2-time
     2294                                                                     , v-ii
     2295                                                                     )).
     2296           run bgelib-tag-close in this-procedure ( input 2, input "StopList").
     2297         end.
     2298       end.
     2299      end.
     2300     end.
     2301   END CASE .
     2302   END PROCEDURE .
     2303   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2304   PROCEDURE   for-cash-cycle:
