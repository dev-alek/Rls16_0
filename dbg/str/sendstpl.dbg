     2534           ub.cash-desk.cash-on
     2535   BREAK
     2536   By ub.cash-desk.pos-type :
     2537     IF FIRST-OF(ub.cash-desk.pos-type) then do:
     2538   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2539   define variable dflt-cd19 as character no-undo .
     2540   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2541   define variable v-param-type20 as character no-undo .
     2542   define variable v-value-date20 as date no-undo .
     2543   define variable v-value-decimal20 as decimal no-undo .
     2544   define variable v-value-integer20 as INTEGER no-undo .
     2545   define variable v-value-logical20 AS LOGICAL no-undo .
     2546   define variable v-tth20 as handle no-undo .
     2547   run adm/shattri.p (
     2548       input "get":U
     2549       ,input  'маг':U
     2550       ,input  ub.cash-desk.obj-code
     2551       ,input  'cd-sending':U
     2552       ,input  'dflt-cd':U
     2553       ,output dflt-cd19
     2554       ,output v-value-date20
     2555       ,output v-value-decimal20
     2556       ,output v-value-integer20
     2557       ,output v-value-logical20
     2558       ,output v-param-type20
     2559       ,INPUT-OUTPUT table-handle v-tth20
     2560       ) no-error .
     2561   delete object v-tth20 no-error.
     2562   case ub.cash-desk.pos-type:
     2563       when 'IBM-XML':U or when 'Autotank':U
     2564     then do:
     2565   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2566   run str/get-inis.p (
     2567                   input 'маг':U
     2568                 , input ub.cash-desk.obj-code
     2569                 , input ub.cash-desk.pos-type
     2570                 , input cash-desk.remote
     2571                 , input "send":U
     2572                 , output out
     2573                 , output out2
     2574                 , output in_
     2575                 , output spl
     2576                 , output sav
     2577                 , output v-remote
     2578                 )  no-error .
     2579   if error-status:error then do:
     2580     run write-log-and-file in p-log-handle (
     2581           input 1
     2582         , input log-file-name
     2583         , input 1
     2584         , input substitute("!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     2585                             , ub.cash-desk.pos-type
     2586                             , ub.cash-desk.obj-code
     2587                             , chr(10)
     2588                             , error-status:get-message(1)
     2589                             , return-value )).
     2590     assign
     2591     v-view-log = yes.
     2592     return error.
     2593   end.
     2594   if ub.cash-desk.pos-type = 'IBM-XML':U
     2595   or ub.cash-desk.pos-type = 'Autotank':U
     2596   then do:
     2597     file-info:file-name = (out  + "undelivered").
     2598     if file-info:FULL-PATHNAME <> ? then do:
     2599       run str/rsndxibm.p ( input parparentproc
     2600                           ,input p-parent-handle
     2601                           ,input p-log-handle
     2602                           ,input out  + "undelivered" ) no-error.
     2603     end.
     2604   end.
     2605     end.
     2606   END CASE.
     2607       RUN for-cash-cycle in this-procedure ( input p-full-stop-list-code) no-error.
     2608     END.
     2609     IF LAST-OF(ub.cash-desk.pos-type) then do:
     2610   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2611   case ub.cash-desk.pos-type:
     2612   END CASE.
     2613     END.
     2614   END.
     2615   END PROCEDURE.
