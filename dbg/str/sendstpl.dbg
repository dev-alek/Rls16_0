     2363   .
     2364   run xml-cd-write-header in this-procedure (
     2365         input v-xml-file-name
     2366       , input v-xml-file-name-path
     2367       , input 'data'
     2368       , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
     2369       , input v-obj-list
     2370       , input (
     2371                 (IF for-cash-desk.pos-type = 'IBM-XML':U
     2372                   then (if for-cash-desk.autonomy = integer('0':U)
     2373                         then  ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
     2374                         else ("КМ"   )
     2375                         )
     2376                   else ("маг" + string(for-cash-desk.obj-code) +  "_касса" + string(for-cash-desk.cash-num))
     2377                   )
     2378               )
     2379       , input (if for-cash-desk.autonomy = integer('0':U) then no else yes)
     2380   ).
     2381   output stream stmxmlout to value( v-xml-file-name-path + "xm1" ) convert target "1251" append.
     2382   OS2-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9").
     2383     end.
     2384   END CASE.
     2385     RUN putc-sl  in this-procedure ( input for-cash-desk.pos-type
     2386                                     , input for-cash-desk.version
