     2502               input 1
     2503             , input log-file-name
     2504             , input 1
     2505             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных"
     2506                                   ,for-cash-desk.obj-code
     2507                                   ,for-cash-desk.cash-num
     2508                               )
     2509                                               ).
     2510         assign
     2511         v-view-log = yes
     2512         .
     2513       end.
     2514     end.
     2515   end.
     2516   if g#news
     2517   or g#auto
     2518   or g#esys
     2519   and for-cash-desk.pos-type = 'MAGIA-XML':U
     2520   then do:
     2521   end.
     2522     end.
     2523   END CASE.
     2524   END .
     2525   END PROCEDURE.
     2526   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2527   PROCEDURE SENDING:
     2528   define input parameter p-full-stop-list-code as character no-undo .
     2529   DEFINE VARIABLE fq as integer no-undo .
     2530   define variable glog as logical no-undo .
