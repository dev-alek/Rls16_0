     2445         ,input (replace( v-xml-file-name-path, "/", "\" ) + "xml")
     2446         ,input (replace(in_ + spl + "/" + v-xml-file-name, "/", "\" ) + ".xml")
     2447         ,input 30
     2448         ,input   ( if action = 'U'
     2449                     then ('Ждите - ' + 'добавление стоплиста')
     2450                     else ('Ждите - ' + 'удаление стоплиста') ) +
     2451                     substitute("Маг&1 касса&2", for-cash-desk.obj-code, for-cash-desk.cash-num)
     2452         ) no-error .
     2453       if error-status:error
     2454       or return-value = "error" then do:
     2455         run write-log-and-file in p-log-handle (
     2456               input 1
     2457             , input log-file-name
     2458             , input 1
     2459             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных:&3&4 &5"
     2460                                   ,for-cash-desk.obj-code
     2461                                   ,for-cash-desk.cash-num
     2462                                   , chr(10)
     2463                                   , error-status:get-message(1)
     2464                                   , return-value
     2465                               )
     2466                                               ).
     2467         assign
     2468         v-view-log = yes
     2469         .
     2470       end.
     2471     end.
     2472     if not available ub.shop then do:
     2473       find first ub.shop no-lock where
     2474                 ub.shop.obj-code = for-cash-desk.obj-code.
     2475     end.
     2476     if
     2477     not (g#news or g#esys)
     2478     then do:
     2479       run str/getxibmf.p (
     2480                       input parparentproc
     2481                     ,input p-log-handle
     2482                     ,input 'маг':U
     2483                     ,input for-cash-desk.obj-code
     2484                     ,input ub.shop.host-code
     2485                     ,input in_
     2486                     ,input spl
     2487                     ,input (in_ + sav)
     2488                     ,input for-cash-desk.pos-type
     2489                     ,input (if (for-cash-desk.pos-type = 'IBM-XML':U
     2490                             and for-cash-desk.autonomy = integer('0':U))
     2491                             or (for-cash-desk.pos-type = 'Autotank':U
     2492                             and for-cash-desk.autonomy = integer('2':U))
     2493                             then "utf-8":U
     2494                             else "windows-1251")
     2495                     ,input log-file-name
     2496                     ,input "data":U
     2497                     ,input v-xml-file-name
     2498                     ,input-output v-view-log
     2499                     ) no-error .
     2500       if error-status:error then do:
