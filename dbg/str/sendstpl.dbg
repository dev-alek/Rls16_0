     2343       , output v-xml-file-name-path
     2344       , output v-log-file-name
     2345       , output v-locked
     2346   ).
     2347   run write-log-and-file in p-log-handle (
     2348         input 1
     2349       , input log-file-name
     2350       , input 1
     2351       , input substitute( ("''" + " &1")
     2352                               , replace( v-xml-file-name-path, "/", "\" ) + "xm1"
     2353                         )
     2354                                         ).
     2355   run write-log-and-file in p-log-handle (
     2356         input 1
     2357       , input log-file-name
     2358       , input 1
     2359       , input substitute( "................с параметрами: ... магазин: &1", i-obj-code )
     2360                                         ).
     2361   assign
