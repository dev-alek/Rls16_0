      565        EDGE-PIXELS 0
      566        SIZE .63 BY 4.33
      567        BGCOLOR 7 .
      568   DEFINE RECTANGLE Rect-Top
      569        EDGE-PIXELS 0
      570        SIZE 33.63 BY .17
      571        BGCOLOR 15 .
      572   DEFINE FRAME Dialog-Frame
      573        Btn_OK AT ROW 1.17 COL 1.75
      574        Btn_Cancel AT ROW 1.17 COL 17.75
      575        Btn_Serv AT ROW 1.17 COL 33.63 WIDGET-ID 36
      576        UUID_VSD AT ROW 4.13 COL 22.25 COLON-ALIGNED WIDGET-ID 2
      577        StatusChar AT ROW 5.25 COL 22.25 COLON-ALIGNED WIDGET-ID 6
      578        NumberVSD AT ROW 5.25 COL 56.63 COLON-ALIGNED WIDGET-ID 4
      579        DateCr AT ROW 6.38 COL 22.25 COLON-ALIGNED WIDGET-ID 8
      580        Company AT ROW 7.5 COL 22.25 COLON-ALIGNED WIDGET-ID 10
      581        TypeProd AT ROW 8.63 COL 22.25 COLON-ALIGNED WIDGET-ID 12
      582        SubGrp AT ROW 8.63 COL 56.63 COLON-ALIGNED WIDGET-ID 34
      583        FILL-IN-1 AT ROW 9.75 COL 22.25 COLON-ALIGNED NO-LABEL WIDGET-ID 70
      584        FILL-IN-3 AT ROW 9.75 COL 28.13 COLON-ALIGNED NO-LABEL WIDGET-ID 72
      585        FILL-IN-4 AT ROW 9.75 COL 31 COLON-ALIGNED NO-LABEL WIDGET-ID 74
      586        FILL-IN-9 AT ROW 9.75 COL 33.88 COLON-ALIGNED NO-LABEL WIDGET-ID 84
      587        FILL-IN-7 AT ROW 9.75 COL 40.38 COLON-ALIGNED NO-LABEL WIDGET-ID 76
      588        FILL-IN-5 AT ROW 9.75 COL 46.25 COLON-ALIGNED NO-LABEL WIDGET-ID 78
      589        FILL-IN-6 AT ROW 9.75 COL 49.13 COLON-ALIGNED NO-LABEL WIDGET-ID 80
      590        FILL-IN-10 AT ROW 9.75 COL 52 COLON-ALIGNED NO-LABEL WIDGET-ID 86
      591        DateOut AT ROW 10.83 COL 22.25 COLON-ALIGNED WIDGET-ID 14
      592        DateOut-2 AT ROW 10.83 COL 28.13 COLON-ALIGNED NO-LABEL WIDGET-ID 40
      593        DateOut-3 AT ROW 10.83 COL 31 COLON-ALIGNED NO-LABEL WIDGET-ID 42
      594        DateOut-4 AT ROW 10.83 COL 33.88 COLON-ALIGNED NO-LABEL WIDGET-ID 44
      595        ExpiryOutDate AT ROW 10.83 COL 40.38 COLON-ALIGNED WIDGET-ID 28
      596        ExpiryOutDate-2 AT ROW 10.83 COL 46.25 COLON-ALIGNED NO-LABEL WIDGET-ID 52
      597        ExpiryOutDate-3 AT ROW 10.83 COL 49.13 COLON-ALIGNED NO-LABEL WIDGET-ID 54
      598        ExpiryOutDate-4 AT ROW 10.83 COL 52 COLON-ALIGNED NO-LABEL WIDGET-ID 56
      599        ExpiryDate AT ROW 11.96 COL 22.25 COLON-ALIGNED WIDGET-ID 16
      600        ExpiryDate-2 AT ROW 11.96 COL 28.13 COLON-ALIGNED NO-LABEL WIDGET-ID 46
      601        ExpiryDate-3 AT ROW 11.96 COL 31 COLON-ALIGNED NO-LABEL WIDGET-ID 48
      602        ExpiryDate-4 AT ROW 11.96 COL 33.88 COLON-ALIGNED NO-LABEL WIDGET-ID 50
      603        ExpiryDate-2-1 AT ROW 11.96 COL 40.38 COLON-ALIGNED WIDGET-ID 58
      604        ExpiryDate-2-2 AT ROW 11.96 COL 46.25 COLON-ALIGNED NO-LABEL WIDGET-ID 30
      605        ExpiryDate-2-3 AT ROW 11.96 COL 49.13 COLON-ALIGNED NO-LABEL WIDGET-ID 60
      606        ExpiryDate-2-4 AT ROW 11.96 COL 52 COLON-ALIGNED NO-LABEL WIDGET-ID 62
      607        Qnty AT ROW 13.08 COL 22.25 COLON-ALIGNED WIDGET-ID 18
      608        NumPart AT ROW 14.21 COL 22.25 COLON-ALIGNED WIDGET-ID 20
      609        Note AT ROW 15.33 COL 22.25 COLON-ALIGNED WIDGET-ID 22
      610        EDITOR-1 AT ROW 16.75 COL 2.13 NO-LABEL WIDGET-ID 32
      611        Rect-Main AT ROW 6.79 COL 6
      612        Rect-Bottom AT ROW 8.08 COL 3.5
      613        Rect-Left AT ROW 1.75 COL 1.25
      614        Rect-Right AT ROW 1.88 COL 34.25
      615        Rect-Top AT ROW 1.71 COL 1.25
      616        SPACE(51.49) SKIP(19.78)
      617       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      618            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      619            TITLE "ВСД" WIDGET-ID 100.
      620   ASSIGN
      621          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      622          FRAME Dialog-Frame:HIDDEN           = TRUE.
      623   ASSIGN
      624          EDITOR-1:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      625   ASSIGN
      626          NumberVSD:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      627   ON window-close OF FRAME Dialog-Frame
      628   do:
      629     apply "END-ERROR":U to self.
      630   end.
      631   ON any-printable OF Btn_Cancel IN FRAME Dialog-Frame
      632   do:
      633     run proc-any-key.
      634   end.
      635   ON choose OF Btn_Cancel IN FRAME Dialog-Frame
      636   do:
      637     if not v-scan-str = ""
      638       then return no-apply.
      639     delete object vsdSts no-error.
      640     delete object vsdstrObj no-error.
      641     apply "go" to frame Dialog-Frame.
      642   end.
      643   ON return OF Btn_Cancel IN FRAME Dialog-Frame
      644   do:
      645     def var str as character no-undo.
      646     run str/qr2uuid.p (input v-scan-str, output str).
      647     run setscruuid (input str).
      648   end.
      649   ON any-printable OF Btn_OK IN FRAME Dialog-Frame
      650   do:
      651     run proc-any-key.
      652   end.
      653   ON choose OF Btn_OK IN FRAME Dialog-Frame
      654   do:
      655     if not v-scan-str = ""
      656       then return no-apply.
      657     if vsdsubCurr:StatusErr
      658       then return no-apply.
      659     p-isSave = true.
      660     delete object vsdSts no-error.
      661     delete object vsdstrObj no-error.
      662     apply "go" to frame Dialog-Frame.
      663   end.
      664   ON return OF Btn_OK IN FRAME Dialog-Frame
      665   do:
      666     def var str as character no-undo.
      667     run str/qr2uuid.p (input v-scan-str, output str).
      668     run setscruuid (input str).
      669   end.
      670   ON choose OF Btn_Serv IN FRAME Dialog-Frame
      671   do:
      672     if not v-scan-str = ""
      673       then return no-apply.
      674     run str/vsdserv.w (input vsdsubCurr).
      675   end.
      676   ON return OF Btn_Serv IN FRAME Dialog-Frame
      677   do:
      678     def var str as character no-undo.
      679     run str/qr2uuid.p (input v-scan-str, output str).
      680     run setscruuid (input str).
      681   end.
      682   ON any-printable OF Btn_Serv IN FRAME Dialog-Frame
      683   do:
      684     run proc-any-key.
      685   end.
      686   ON value-changed OF StatusChar IN FRAME Dialog-Frame
      687   do:
      688     assign StatusChar.
      689     vsdsubCurr:Status_ = vsdSts:StatusInt(StatusChar).
      690   end.
      691   ON any-printable OF UUID_VSD IN FRAME Dialog-Frame
      692   do:
      693     run proc-any-key.
      694   end.
      695   ON endkey OF UUID_VSD IN FRAME Dialog-Frame
      696   do:
      697     assign UUID_VSD.
      698     vsdsubCurr:Changed = true.
      699     vsdsubCurr:UUID = UUID_VSD:screen-value.
      700   end.
      701   ON ENTRY OF UUID_VSD IN FRAME Dialog-Frame
      702   DO:
      703     run LoadKeyboardLayoutA (input v-scan-str, input 0, output iLang).
      704         run adm/shattri.p (
      705                  input "get":U
      706                  ,input  v-cntxt-obj-type
      707                  ,input  v-cntxt-obj-code
      708                  ,input  'marking':U
      709                  ,input  'rus-key':U
      710                  ,output p-value-character
      711                  ,output p-value-date
      712                  ,output p-value-decimal
      713                  ,output p-value-integer
      714                  ,output p-value-logical
      715                  ,output p-param-type
      716                  ,input-output table-handle v-tth
      717                  ) no-error .
      718         IF p-value-logical = yes THEN  iLang = 68748313.
      719     run ActivateKeyboardLayout (input iLang, input 0).
      720   END.
      721   ON leave OF UUID_VSD IN FRAME Dialog-Frame
      722   do:
      723     assign UUID_VSD.
      724     run setscruuid(input UUID_VSD:screen-value).
      725     vsdsubCurr:Changed = true.
      726   end.
      727   ON return OF UUID_VSD IN FRAME Dialog-Frame
      728   do:
      729     def var str as character no-undo.
      730     run str/qr2uuid.p (input v-scan-str, output str).
      731     run setscruuid (input str).
      732   end.
      733   if valid-handle(active-window) and frame Dialog-Frame:PARENT eq ?
      734   then frame Dialog-Frame:PARENT = active-window.
      735   MAIN-BLOCK:
      736   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
      737      on end-key undo MAIN-BLOCK, leave MAIN-BLOCK:
      738     def var ii as int no-undo.
      739     define variable v-host-code as integer   no-undo .
      740     vsdstrObj = new vsdtostorage ().
      741     vsdSts = new vsdstatustype ().
      742     v-page-current = 1.
      743     StatusChar:list-items = vsdSts:StatusList.
      744     run set-size(input frame Dialog-Frame:height-pixels - 73, input frame Dialog-Frame:width-pixels - 20).
      745     do ii = 1 to vsdsubsObj:GetItem(ii):
      746       vsdsubCurr = vsdsubsObj:VsdObjCurr.
      747       v-section-names = v-section-names + "|" + vsdsubCurr:VSDTypeLbl.
      748     end.
      749     v-section-names = trim (v-section-names, "|").
      750     if v-section-names = ""
      751       then do:
      752         vsdsubCurr = new vsdsub ().
      753         vsdsubCurr:VSDType = vsdSts:VSDIn.
      754         vsdsubsObj:AddItem(vsdsubCurr).
      755         v-section-names = vsdsubCurr:VSDTypeLbl.
      756         lok = yes.
      757       end.
      758       else do:
      759         if p-mode = 'ИЗМЕНЕНИЕ':U
      760         then do:
      761   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      762   do:
      763     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      764       (input  v-cntxt-db-num
      765       ,input  v-cntxt-userid
      766       ,input  0
      767       ,input  'actn_mercury-chg-vsd':U
      768       ,input  'object':U
      769       ,input  v-cntxt-host-code-obj
      770       ,input  vsdsubCurr:ObjType
      771       ,input  vsdsubCurr:ObjCode
      772       ,input  0
      773       ,input  0
      774       ,input  0
      775       ,input  false
      776       ,output lok
      777       )  .
      778   end.
      779         end.
      780       end.
      781   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      782   empty temp-table thbjattr_thbj-attr.
      783   run adm/shattri.p (
      784      input "get":U
      785     ,input v-cntxt-obj-type
      786     ,input v-cntxt-obj-code
      787     ,input 'mercur':U
      788     ,input  ""
      789     ,output v-value-character
      790     ,output v-value-date
      791     ,output v-value-decimal
      792     ,output v-value-integer
      793     ,output v-value-logical
      794     ,output par-type
      795     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      796     ) no-error .
      797     for each thbjattr_thbj-attr :
      798       case thbjattr_thbj-attr.prop-code :
      799         when "manual-vcd" then
      800           v-isManualVcd = thbjattr_thbj-attr.property-value-logical .
      801         end case.
      802     end.
      803     run initialize-folder (v-section-names).
      804     run initialize-section.
      805     run show-current-page(input 1).
      806     run LoadKeyboardLayoutA (input v-scan-str, input 0, output iLang).
      807         run adm/shattri.p (
      808                  input "get":U
      809                  ,input  v-cntxt-obj-type
      810                  ,input  v-cntxt-obj-code
      811                  ,input  'marking':U
      812                  ,input  'rus-key':U
      813                  ,output p-value-character
      814                  ,output p-value-date
      815                  ,output p-value-decimal
      816                  ,output p-value-integer
      817                  ,output p-value-logical
      818                  ,output p-param-type
      819                  ,input-output table-handle v-tth
      820                  ) no-error .
      821         IF p-value-logical = yes THEN  iLang = 68748313.
      822     run ActivateKeyboardLayout (input iLang, input 0).
      823     run enable_UI.
      824     run hide-disp-page.
      825     wait-for go of frame Dialog-Frame.
      826   end.
      827   run disable_UI.
      828   PROCEDURE check-page :
      829   end procedure.
      830   PROCEDURE disable_UI :
      831     HIDE FRAME Dialog-Frame.
      832   END PROCEDURE.
      833   PROCEDURE enable_UI :
      834     DISPLAY UUID_VSD StatusChar NumberVSD DateCr Company TypeProd SubGrp FILL-IN-1
      835             FILL-IN-3 FILL-IN-4 FILL-IN-9 FILL-IN-7 FILL-IN-5 FILL-IN-6 FILL-IN-10
      836             DateOut DateOut-2 DateOut-3 DateOut-4 ExpiryOutDate ExpiryOutDate-2
      837             ExpiryOutDate-3 ExpiryOutDate-4 ExpiryDate ExpiryDate-2 ExpiryDate-3
      838             ExpiryDate-4 ExpiryDate-2-1 ExpiryDate-2-2 ExpiryDate-2-3
      839             ExpiryDate-2-4 Qnty NumPart Note EDITOR-1
      840         WITH FRAME Dialog-Frame.
      841     ENABLE Rect-Main Rect-Bottom Rect-Left Rect-Right Rect-Top Btn_OK Btn_Cancel
      842            Btn_Serv UUID_VSD StatusChar DateCr Company TypeProd SubGrp DateOut
      843            DateOut-2 DateOut-3 DateOut-4 ExpiryOutDate ExpiryOutDate-2
      844            ExpiryOutDate-3 ExpiryOutDate-4 ExpiryDate ExpiryDate-2 ExpiryDate-3
      845            ExpiryDate-4 ExpiryDate-2-1 ExpiryDate-2-2 ExpiryDate-2-3
      846            ExpiryDate-2-4 Qnty NumPart Note EDITOR-1
      847         WITH FRAME Dialog-Frame.
      848     VIEW FRAME Dialog-Frame.
      849   END PROCEDURE.
      850   PROCEDURE hide-disp-page :
      851     if v-isManualVcd = true and p-mode = 'ИЗМЕНЕНИЕ':U
      852       and vsdsubCurr:Status_ = vsdSts:IsNeedCheck
      853       and
      854       (entry (v-page-current, v-section-names, "|") = vsdSts:VSDInLbl or entry (v-page-current, v-section-names, "|") = vsdSts:VSDTransLbl)
      855     then do:
      856       enable UUID_VSD with frame Dialog-Frame.
      857     end.
      858     else do:
      859       disable UUID_VSD with frame Dialog-Frame.
      860     end.
      861     if vsdsubCurr:Status_ = vsdSts:isNeedCheck
      862     then do:
      863       hide
      864         NumberVSD DateCr Company TypeProd ExpiryOutDate ExpiryOutDate-2 ExpiryOutDate-3 ExpiryOutDate-4 DateOut DateOut-3 DateOut-4 DateOut-2
      865               Qnty NumPart ExpiryDate ExpiryDate-2 ExpiryDate-2-1 ExpiryDate-2-2 ExpiryDate-2-3 ExpiryDate-2-4 ExpiryDate-3 ExpiryDate-4 Note
      866               EDITOR-1 FILL-IN-1  FILL-IN-3 FILL-IN-4 FILL-IN-5 FILL-IN-6 FILL-IN-7 FILL-IN-9 FILL-IN-10
      867         in frame Dialog-Frame.
      868     end.
      869     else do:
      870       display
      871         NumberVSD DateCr Company TypeProd ExpiryOutDate ExpiryOutDate-2 ExpiryOutDate-3 ExpiryOutDate-4 DateOut DateOut-3 DateOut-4 DateOut-2
      872               Qnty NumPart ExpiryDate ExpiryDate-2 ExpiryDate-2-1 ExpiryDate-2-2 ExpiryDate-2-3 ExpiryDate-2-4 ExpiryDate-3 ExpiryDate-4 Note
      873         with frame Dialog-Frame.
      874     end.
      875     if vsdsubCurr:ExpiryOutDate = ""
      876       then hide ExpiryOutDate ExpiryOutDate-2 ExpiryOutDate-3 ExpiryOutDate-4 in frame Dialog-Frame.
      877     if vsdsubCurr:ExpiryOutDate = ""
      878       then hide ExpiryDate-2-1 ExpiryDate-2-2 ExpiryDate-2-3 ExpiryDate-2-4 in frame Dialog-Frame.
      879     if vsdsubCurr:ExpiryOutDate = "" and vsdsubCurr:ExpiryOutDate = ""
      880     then do:
      881       hide FILL-IN-5 FILL-IN-6 FILL-IN-7 FILL-IN-10.
      882     end.
      883     hide
      884       SubGrp
      885       NumberVSD
      886       in frame Dialog-Frame.
      887     disable
      888         NumberVSD DateCr Company TypeProd ExpiryOutDate ExpiryOutDate-2 ExpiryOutDate-3 ExpiryOutDate-4 DateOut DateOut-3 DateOut-4 DateOut-2
      889               Qnty NumPart ExpiryDate ExpiryDate-2 ExpiryDate-2-1 ExpiryDate-2-2 ExpiryDate-2-3 ExpiryDate-2-4 ExpiryDate-3 ExpiryDate-4 Note StatusChar
      890       with frame Dialog-Frame.
      891     if entry (v-page-current, v-section-names, "|") = vsdSts:VSDInLbl or entry (v-page-current, v-section-names, "|") = vsdSts:VSDTransLbl
      892     then do:
      893       if (vsdsubCurr:Status_ = vsdSts:IsErrCheck or vsdsubCurr:Status_ = vsdSts:IsErrUtilized) and lok and p-mode = 'ИЗМЕНЕНИЕ':U
      894         then enable StatusChar UUID_VSD with frame Dialog-Frame.
      895     end.
      896     if UUID_VSD:edit-can-paste
      897     then do:
      898       apply "entry" to UUID_VSD in frame Dialog-Frame.
      899     end.
      900   end procedure.
      901   PROCEDURE initialize-section :
      902   if vsdsubsObj:GetItem(v-page-current) = 0
      903       then return.
      904     vsdsubCurr = vsdsubsObj:VsdObjCurr.
      905     do with frame Dialog-Frame:
      906       UUID_VSD:screen-value =  vsdsubCurr:UUIDUsr.
      907       ExpiryOutDate :screen-value = entry(1, vsdsubCurr:ExpiryOutDate , ":") no-error.
      908       ExpiryOutDate-2 :screen-value = entry(2, vsdsubCurr:ExpiryOutDate , ":") no-error.
      909       ExpiryOutDate-3 :screen-value = entry(3, vsdsubCurr:ExpiryOutDate , ":") no-error.
      910       ExpiryOutDate-4 :screen-value = entry(4, vsdsubCurr:ExpiryOutDate , ":") no-error.
      911       DateOut :screen-value = entry(1, vsdsubCurr:DateOut , ":") no-error.
      912       DateOut-2 :screen-value = entry(2, vsdsubCurr:DateOut , ":") no-error.
      913       DateOut-3 :screen-value = entry(3, vsdsubCurr:DateOut , ":") no-error.
      914       DateOut-4 :screen-value = entry(4, vsdsubCurr:DateOut , ":") no-error.
      915       ExpiryDate  :screen-value = entry(1, vsdsubCurr:ExpiryDate , ":") no-error.
      916       ExpiryDate-2  :screen-value = entry(2, vsdsubCurr:ExpiryDate , ":") no-error.
      917       ExpiryDate-3  :screen-value = entry(3, vsdsubCurr:ExpiryDate , ":") no-error.
      918       ExpiryDate-4  :screen-value = entry(4, vsdsubCurr:ExpiryDate , ":") no-error.
      919       ExpiryDate-2-1  :screen-value = entry(1, vsdsubCurr:ExpiryDate2 , ":") no-error.
      920       ExpiryDate-2-2  :screen-value = entry(2, vsdsubCurr:ExpiryDate2 , ":") no-error.
      921       ExpiryDate-2-3  :screen-value = entry(3, vsdsubCurr:ExpiryDate2 , ":") no-error.
      922       ExpiryDate-2-4  :screen-value = entry(4, vsdsubCurr:ExpiryDate2 , ":") no-error.
      923       assign
      924         DateCr:screen-value = string (vsdsubCurr:DateCr)
      925         Company:screen-value = vsdsubCurr:EconomicSub
      926         TypeProd:screen-value = vsdsubCurr:TypeProd
      927         Note:screen-value = vsdsubCurr:Note
      928         NumberVSD:screen-value = vsdsubCurr:VsdNum
      929         Qnty:screen-value = string (vsdsubCurr:Qnty).
      930         NumPart:screen-value = string (vsdsubCurr:NumPart).
      931         SubGrp:screen-value = string (vsdsubCurr:SubProductGuid).
      932         StatusChar:screen-value = string (vsdsubCurr:StatusLbl).
      933       EDITOR-1 = vsdsubCurr:MsgErr.
      934       assign UUID_VSD NumberVSD DateCr Company TypeProd ExpiryOutDate ExpiryOutDate-2 ExpiryOutDate-3 ExpiryOutDate-4 DateOut DateOut-3 DateOut-4 DateOut-2
      935               Qnty NumPart ExpiryDate ExpiryDate-2 ExpiryDate-2-1 ExpiryDate-2-2 ExpiryDate-2-3 ExpiryDate-2-4 ExpiryDate-3 ExpiryDate-4 Note .
      936     end.
      937     run hide-disp-page.
      938   end.
      939   PROCEDURE proc-any-key :
      940     v-scan-str = v-scan-str + last-event:label.
      941   end.
      942   PROCEDURE trg-folder :
      943   v-page-current = v-page.
      944     run initialize-section.
      945   end.
      946   PROCEDURE initialize-folder :
      947     define input parameter folder-labels as character no-undo.
      948     define variable i             as integer   no-undo.
      949     define variable temp-hdl      as handle    no-undo.
      950     define variable del-hdl       as handle    no-undo.
      951     define variable rebuild       as logical   no-undo init no.
      952     define variable sts           as logical   no-undo.
      953     assign
      954       tab-type = 1 .
      955     assign
      956       number-of-pages = num-entries(folder-labels,'|':U).
      957     if valid-handle(up-image) then
      958     do:
      959       temp-hdl = frame Dialog-Frame:HANDLE.
      960       temp-hdl = temp-hdl:first-child.
      961       temp-hdl = temp-hdl:first-child.
      962       do while valid-handle(temp-hdl):
      963         del-hdl = temp-hdl.
      964         temp-hdl = temp-hdl:next-sibling.
      965         if del-hdl:private-data = "Tab-Folder":U then delete widget del-hdl.
      966       end.
      967     end.
      968     create image up-image
      969       assign
      970       frame             = frame Dialog-Frame:HANDLE
      971       x                 = 0 + pos-x
      972       y                 = 0 + pos-y
      973       width-pixel       = width-tab-values[tab-type]
      974       height-pixel      = 25 + 4
      975       private-data      = "Tab-Folder":U
      976       hidden            = no.
      977     assign
      978       sts = up-image:load-image("adeicon/ts-up":U +
      979            STRING(width-tab-values[tab-type])).
      980     do i = 1 to number-of-pages:
      981       if entry(i,folder-labels,'|':U) ne "":U then
      982         run create-folder-label (i, entry(i, folder-labels,'|':U)).
      983     end.
      984     view frame Dialog-Frame.
      985     run change-folder-page.
      986     return.
      987   end procedure.
      988   PROCEDURE change-folder-page :
      989     define variable sts   as logical no-undo.
      990     define variable page# as integer no-undo.
      991     if page# > 0 and page# <= 20 and
      992       VALID-HANDLE (page-label[page#]) then
      993     do:
      994       assign
      995         up-image:x      = page-label[page#]:x -  9
      996         up-image:y      = page-label[page#]:y -  4
      997         up-image:hidden = no
      998         sts             = up-image:move-to-top().
      999     end.
     1000     return.
     1001   end procedure.
     1002   PROCEDURE create-folder-label :
     1003     define input parameter p-page#        as integer   no-undo.
     1004     define input parameter p-page-label   as character no-undo.
     1005     define variable sts as log no-undo.
     1006     create image image-hdl[p-page#]
     1007       assign
     1008       frame             = frame Dialog-Frame:HANDLE
     1009       x                 = (p-page# - 1) * width-tab-values[tab-type] + pos-x
     1010       y                 = 2 + pos-y
     1011       width-pixel       = width-tab-values[tab-type]
     1012       height-pixel      = 25
     1013       private-data      = "Tab-Folder":U
     1014       sensitive         = yes
     1015       triggers:
     1016         on mouse-select-click
     1017           persistent run label-trigger in THIS-PROCEDURE (p-page#).
     1018       end triggers.
     1019     create text page-label[p-page#]
     1020       assign
     1021       frame             = frame Dialog-Frame:HANDLE
     1022       y                 = image-hdl[p-page#]:y + 2
     1023       x                 = image-hdl[p-page#]:x + 9
     1024       width-pixel       = image-hdl[p-page#]:WIDTH-PIXEL - 18
     1025       height-pixel      = image-hdl[p-page#]:HEIGHT-PIXEL - 4
     1026       format            = "X(13)":U
     1027       sensitive         = yes
     1028       font              = if tab-type = 1 then ? else 4
     1029       bgcolor           = 8
     1030       screen-value      = p-page-label
     1031       private-data      = "Tab-Folder":U
     1032       triggers:
     1033         on mouse-select-click
     1034           persistent run label-trigger in THIS-PROCEDURE (p-page#).
     1035       end triggers.
     1036     assign
     1037       sts = image-hdl[p-page#]:load-image("adeicon/ts-dn":U +
     1038                   STRING(width-tab-values[tab-type])).
     1039     sts = image-hdl[p-page#]:move-to-top().
     1040     sts = page-label[p-page#]:move-to-top().
     1041     assign
     1042       page-enabled[p-page#]      = yes
     1043       image-hdl[p-page#]:hidden  = no
     1044       page-label[p-page#]:hidden = no.
     1045     return.
     1046   end procedure.
     1047   PROCEDURE create-folder-page :
     1048     define input parameter p-page#      as integer   no-undo.
     1049     define input parameter p-new-label  as character no-undo.
     1050     define variable i          as integer   no-undo.
     1051     define variable num-labels as integer   no-undo.
     1052     define variable labels     as character no-undo.
     1053     define variable new-labels as character no-undo init "".
     1054     run get-attribute ('FOLDER-LABELS':U).
     1055     assign
     1056       labels = return-value.
     1057     if labels = ? then labels = "".
     1058     num-labels = num-entries(labels,'|':U).
     1059     if p-page# <= num-labels then
     1060     do i = 1 to num-labels:
     1061       new-labels = new-labels +
     1062         if i = p-page# then p-new-label
     1063         else entry(i, labels, '|':U).
     1064       if i < num-labels then new-labels = new-labels + '|':U.
     1065     end.
     1066     else
     1067     do:
     1068       new-labels = labels.
     1069       do i = 1 to p-page# - num-labels - if num-labels = 0 then 1 else 0:
     1070         new-labels = new-labels + '|':U.
     1071       end.
     1072       new-labels = new-labels + p-new-label.
     1073     end.
     1074     run set-attribute-list in THIS-PROCEDURE
     1075       ('FOLDER-LABELS = ':U + new-labels).
     1076     run initialize-folder.
     1077     return.
     1078   end procedure.
     1079   PROCEDURE delete-folder-page :
     1080     define input parameter p-page#  as integer no-undo.
     1081     define variable i      as integer   no-undo.
     1082     define variable pos1   as integer   no-undo init 0.
     1083     define variable pos2   as integer   no-undo.
     1084     define variable labels as character no-undo.
     1085     run get-attribute ('FOLDER-LABELS':U).
     1086     assign
     1087       labels = return-value.
     1088     if valid-handle (page-label[p-page#]) then
     1089       delete widget page-label[p-page#].
     1090     if valid-handle (image-hdl[p-page#]) then
     1091       delete widget image-hdl[p-page#].
     1092     do i = 1 to p-page# - 1:
     1093       pos1 = index(labels,'|':U, pos1 + 1).
     1094     end.
     1095     pos2 = index(labels,'|':U, pos1 + 1).
     1096     labels = if pos2 ne 0 then SUBSTR(labels, 1, pos1, "CHARACTER":U) +
     1097       SUBSTR(labels, pos2, -1, "CHARACTER":U)
     1098       else SUBSTR(labels, 1, pos1 - 1, "CHARACTER":U).
     1099     run set-attribute-list in THIS-PROCEDURE
     1100       ('FOLDER-LABELS = ':U + labels).
     1101     return.
     1102   end procedure.
     1103   PROCEDURE disable-folder-page :
     1104     define input parameter p-page#  as integer no-undo.
     1105     assign
     1106       page-enabled[p-page#]       = no
     1107       page-label[p-page#]:fgcolor = 7.
     1108     return.
     1109   end procedure.
     1110   PROCEDURE enable-folder-page :
     1111     define input parameter p-page#  as integer no-undo.
     1112     assign
     1113       page-enabled[p-page#]       = yes
     1114       page-label[p-page#]:fgcolor = ?.
     1115     return.
     1116   end procedure.
     1117   PROCEDURE label-trigger :
     1118     define input parameter p-page# as integer no-undo.
     1119     v-page = p-page#.
     1120     run trg-folder in this-procedure no-error.
     1121     if error-status:error
     1122       then return.
     1123     run show-current-page(input p-page#).
     1124     return.
     1125   end procedure.
     1126   PROCEDURE local-initialize :
     1127     run initialize-folder.
     1128     run dispatch in THIS-PROCEDURE ('initialize':U).
     1129     return.
     1130   end procedure.
     1131   PROCEDURE set-size :
     1132     define input parameter p-height as decimal no-undo.
     1133     define input parameter p-width  as decimal no-undo.
     1134     define variable sts as logical.
     1135     if p-height < 1.35 then p-height = 1.35.
     1136     do with frame Dialog-Frame:
     1137       assign
     1138         Rect-Main:X               = 0 + pos-x
     1139         Rect-Main:Y               = 25 + pos-y
     1140         Rect-Main:WIDTH-PIXELS    = p-width
     1141         Rect-Main:HEIGHT-PIXELS   = p-height
     1142                                        - 25
     1143         Rect-Top:X                = 1 + pos-x
     1144         Rect-Top:Y                = 25 + 1 + pos-y
     1145         Rect-Top:WIDTH-PIXELS     = p-width
     1146                                        - 3
     1147         Rect-Top:HEIGHT-PIXELS    = 3
     1148         Rect-Bottom:X             = 1 + pos-x
     1149         Rect-Bottom:Y             = p-height - 4 + pos-y
     1150         Rect-Bottom:HEIGHT-PIXELS = 3
     1151         Rect-Bottom:WIDTH-PIXELS  = p-width
     1152                                        - 2
     1153         Rect-Left:X               = 1 + pos-x
     1154         Rect-Left:Y               = 25 + 1 + pos-y
     1155         Rect-Left:WIDTH-PIXELS    = 3
     1156         Rect-Left:HEIGHT-PIXELS   = p-height
     1157                                        - 25 - 2
     1158         Rect-Right:X              = p-width + pos-x
     1159                                        - 4
     1160         Rect-Right:Y              = 25 + 4 + pos-y
     1161         Rect-Right:WIDTH-PIXELS   = 3
     1162         Rect-Right:HEIGHT-PIXELS  = p-height
     1163                                        - 25 - 5
     1164         Rect-Main:HIDDEN          = no
     1165         Rect-Top:HIDDEN           = no
     1166         Rect-Bottom:HIDDEN        = no
     1167         Rect-Left:HIDDEN          = no
     1168         Rect-Right:HIDDEN         = no.
     1169     end.
     1170     return.
     1171   end procedure.
     1172   PROCEDURE show-current-page :
     1173     define input parameter page# as integer no-undo.
     1174     define variable sts as logical no-undo.
     1175     if page# > 0 and page# <= 20 and
     1176       VALID-HANDLE (page-label[page#])
     1177       then assign
     1178         up-image:x      = page-label[page#]:x -  9
     1179         up-image:y      = page-label[page#]:y -  4
     1180         up-image:hidden = no
     1181         sts             = up-image:move-to-top().
     1182     else if number-of-pages > 0 then
     1183         assign up-image:hidden = yes.
     1184   end procedure.
     1185   PROCEDURE state-changed :
     1186     define input parameter p-issuer-hdl as handle no-undo.
     1187     define input parameter p-state as character no-undo.
     1188   end procedure.
     1189   procedure LoadKeyboardLayoutA external "user32" :
     1190     define input  parameter P1 as char.
     1191     define input  parameter P2 as LONG.
     1192     define return parameter pret as LONG.
     1193   end procedure.
     1194   procedure ActivateKeyboardLayout external "user32" :
     1195       define input parameter P1 as LONG.
     1196       define input parameter P2 as LONG.
     1197   end procedure.
     1198   procedure setscruuid :
     1199     def input parameter str as character no-undo.
     1200     def var uuid-back as character no-undo.
     1201     do with frame Dialog-Frame:
     1202       v-scan-str = "".
     1203       uuid-back = vsdsubCurr:UUID.
     1204       vsdsubCurr:UUID = str.
     1205       if vsdstrObj:exsistuuidwithtrn(vsdsubCurr)
     1206       then do:
     1207         vsdsubCurr:UUID = uuid-back.
     1208         message vsdstrObj:Msg view-as alert-box.
     1209       end.
     1210       UUID_VSD = vsdsubCurr:UUIDUsr.
     1211       UUID_VSD:screen-value = UUID_VSD.
     1212     end.
     1213   end procedure.
