      142   define output parameter p-shop           as logical no-undo .
      143   define output parameter p-store          as logical no-undo .
      144   define output parameter p-db             as logical no-undo .
      145   define output parameter p-region         as logical no-undo .
      146   do
      147   on error undo, return error return-value
      148   :
      149       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      150       (input  p-upper-code
