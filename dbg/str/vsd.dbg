      130   procedure thbjattr_code_reg :
      131   define input  parameter p-upper-code     as character no-undo .
      132   define input  parameter p-code           as character no-undo .
      133   define output parameter p-label          as character no-undo .
      134   define output parameter p-user-can-edit  as logical   no-undo .
      135   define output parameter p-output-display as logical   no-undo .
      136   define output parameter p-other          as character no-undo .
