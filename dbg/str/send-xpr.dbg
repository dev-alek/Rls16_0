     2315   procedure alienini-getkey :
     2316   define input parameter i-filename as char.
     2317   define input parameter i-section as char.
     2318   define input parameter i-key as char.
     2319   define output parameter o-value as char.
     2320   define variable EntryPointer as integer no-undo.
     2321   define variable mem1 as memptr no-undo.
     2322   define variable mem2 as memptr no-undo.
     2323   define variable mem1size as integer no-undo.
     2324   define variable mem2size as integer no-undo.
     2325   define variable ii       as integer    no-undo.
     2326   define variable cbReturnSize  as integer    no-undo.
     2327   assign
     2328   set-size(mem1)  = 4000
     2329   mem1size = 4000.
     2330   if i-key = "" then EntryPointer = 0.
     2331   else do:
     2332     assign
     2333     set-size(mem2) = 128
     2334     mem2size = 128
     2335     EntryPointer = get-pointer-value(mem2)
     2336     put-string(mem2, 1) = i-key.
     2337   end.
     2338   run getprivateprofilestringA
     2339                                 (i-section,
     2340                                  EntryPointer,
     2341                                  "",
     2342                                  get-pointer-value(mem1),
     2343                                  input mem1size,
     2344                                  i-filename,
     2345                                  output cbReturnSize).
     2346   do ii = 1 to cbReturnSize:
     2347     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     2348                  then o-value + ","
     2349                  else o-value + chr(get-byte(mem1, ii)).
     2350   end.
     2351     set-size(mem1) = 0.
     2352     set-size(mem2) = 0.
     2353   end procedure.
     2354   procedure alienini-putkey :
     2355   define input parameter i-filename as char.
     2356   define input parameter i-section as char.
     2357   define input parameter i-key as char.
     2358   define input parameter i-value as char.
     2359   define variable cbReturnSize as integer.
     2360   run writeprivateprofilestringA
     2361                                  (i-section,
     2362                                   i-key,
     2363                                   i-value,
     2364                                   i-filename,
     2365                                   output cbReturnSize ).
     2366   end procedure.
     2367   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     2368     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     2369     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     2370     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     2371     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     2372     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     2373     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     2374     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     2375   END PROCEDURE.
     2376   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     2377     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     2378     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     2379     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     2380     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     2381     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     2382   END PROCEDURE.
