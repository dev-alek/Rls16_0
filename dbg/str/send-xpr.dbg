     3445   and (g#news
     3446   or g#auto)
     3447   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     3448   then do:
     3449      run cb_set-view-log in p-parent-handle ( input yes).
     3450   end.
     3451   for each tt-db:
     3452     delete tt-db.
     3453   end.
     3454   for each tt-ext-file:
     3455     delete tt-ext-file.
     3456   end.
     3457   for each tt-ext-file-par:
     3458     delete tt-ext-file-par.
     3459   end.
     3460   run bintrn_create-file-record in this-procedure ( input log-file-name
     3461                                                    ,input p-cash-desk-uniq-key-rec
     3462                                                    ,input 'маг':U
     3463                                                    ,input p-obj-code
     3464                                                    ,output v-unc-log-file-name
     3465                                                    ) no-error.
     3466   if error-status:error then do:
     3467     end.
     3468   find first buf_db no-lock where
     3469           buf_db.db-num = (if g#news
     3470                            and g#db-num > 0
     3471                            then 0
     3472                            else g#db-num).
     3473   create buf_tt-db.
     3474   buffer-copy buf_db to buf_tt-db.
     3475   run ext-file-par-write-temp in this-procedure (
     3476                                                 input  ?
     3477                                                 ,input  -1
     3478                                                 ,input  1
     3479                                                 ,input  1
     3480                                                 ,input  'uniq-key-rec':U
     3481                                                 ,input  p-cash-desk-uniq-key-rec
     3482                                                 ,input  p-ext-file-uniq-key-rec
     3483                                                 ,input  ?
     3484                                                 ,input  0
     3485                                                 ,input  0.0
     3486                                                 ,input  no  ) no-error.
     3487   release buf_tt-db.
     3488   run nws/sndfnwr.p ( input parparentproc
     3489                     ,input this-procedure:handle
     3490                     ,input p-log-handle
     3491                     ,input ((if g#db-num > 0
     3492                              and g#news
     3493                              then 'save-db':U
     3494                              else 'save-this-db':U) + chr(4) +
     3495                             string(0) + chr(4) +
     3496                             log-file-name + chr(4) +
     3497                             ''   )) no-error.
     3498   for each tt-ext-file:
     3499     delete tt-ext-file.
     3500   end.
     3501   for each tt-ext-file-par:
     3502     delete tt-ext-file-par.
     3503   end.
     3504   run bintrn_create-file-record in this-procedure ( input v-reply-file-name
     3505                                                    ,input p-cash-desk-uniq-key-rec
     3506                                                    ,input 'маг':U
     3507                                                    ,input p-obj-code
     3508                                                    ,output v-unc-reply-file-name
     3509                                                   ) no-error.
     3510   if error-status:error then do:
     3511     end.
     3512   run ext-file-par-write-temp in this-procedure (
     3513                                                  input  ?
     3514                                                 ,input  -1
     3515                                                 ,input  1
     3516                                                 ,input  1
     3517                                                 ,input  'uniq-key-rec':U
     3518                                                 ,input  p-cash-desk-uniq-key-rec
     3519                                                 ,input  p-ext-file-uniq-key-rec
     3520                                                 ,input  ?
     3521                                                 ,input  0
     3522                                                 ,input  0.0
     3523                                                 ,input  no  ) no-error.
     3524   run nws/sndfnwr.p ( input parparentproc
     3525                     ,input this-procedure:handle
     3526                     ,input p-log-handle
     3527                     ,input ((if g#db-num > 0
     3528                              and g#news
     3529                              then 'save-db':U
     3530                              else 'save-this-db':U) + chr(4) +
     3531                             string(0) + chr(4) +
     3532                             v-reply-file-name + chr(4) +
     3533                             ''   )) no-error.
     3534   for each buf_rtt-ext-file :
     3535     if buf_rtt-ext-file.file-name = v-unc-log-file-name then do:
     3536       run gen-key-rec in this-procedure ( input 'ext-file':U
     3537                                          ,input (buffer buf_rtt-ext-file:handle)
     3538                                          ,output v-log-file-uniq-key-rec) no-error.
     3539     end.
     3540     if buf_rtt-ext-file.file-name = v-unc-reply-file-name then do:
     3541       run gen-key-rec in this-procedure ( input 'ext-file':U
     3542                                          ,input (buffer buf_rtt-ext-file:handle)
     3543                                          ,output v-reply-file-uniq-key-rec) no-error.
     3544     end.
     3545   end.
     3546   find last buf_ext-file-par no-lock where
     3547           buf_ext-file-par.db-num = buf_ext-file.db-num
     3548       and buf_ext-file-par.from-db-num = buf_ext-file.from-db-num
     3549       and buf_ext-file-par.file-num = buf_ext-file.file-num no-error.
     3550   v-param-num = (if available buf_ext-file-par
     3551                   then buf_ext-file-par.param-num + 1
     3552                   else 1).
     3553   run ext-file-par-write-and-send in this-procedure (
     3554                                                     input  buf_ext-file.db-num
     3555                                                     ,input  buf_ext-file.from-db-num
     3556                                                     ,input  buf_ext-file.file-num
     3557                                                     ,input  v-param-num
     3558                                                     ,input  'uniq-key-rec':U
     3559                                                     ,input  p-cash-desk-uniq-key-rec
     3560                                                     ,input  v-log-file-uniq-key-rec
     3561                                                     ,input  ?
     3562                                                     ,input  0
     3563                                                     ,input  0.0
     3564                                                     ,input  (if v-view-log then no else yes)
     3565                                                     ,input  (if g#db-num > 0
     3566                                                             and g#news
     3567                                                             then yes
     3568                                                             else no)
     3569                                                     ,input  g#news-source-db ) no-error.
     3570   run ext-file-par-write-and-send in this-procedure (
     3571                                                     input  buf_ext-file.db-num
     3572                                                     ,input  buf_ext-file.from-db-num
     3573                                                     ,input  buf_ext-file.file-num
     3574                                                     ,input  (- v-param-num)
     3575                                                     ,input  'uniq-key-rec':U
     3576                                                     ,input  p-cash-desk-uniq-key-rec
     3577                                                     ,input  v-reply-file-uniq-key-rec
     3578                                                     ,input  ?
     3579                                                     ,input  0
     3580                                                     ,input  0.0
     3581                                                     ,input  (if v-view-log then no else yes)
     3582                                                     ,input  (if g#db-num > 0
     3583                                                             and g#news
     3584                                                             then yes
     3585                                                             else no)
     3586                                                     ,input  g#news-source-db ) no-error.
     3587   procedure cb_set-ext-file_file-num :
     3588   define input parameter p-db-num as integer no-undo .
     3589   define input parameter p-from-db-num as integer no-undo .
     3590   define input parameter p-file-num as integer no-undo .
     3591   define buffer buf_tt-ext-file for tt-ext-file.
     3592   define buffer buf_rtt-ext-file for rtt-ext-file.
     3593   do
     3594   on error undo, return error
     3595   :
     3596     find first buf_tt-ext-file.
     3597     find first buf_rtt-ext-file where
     3598               buf_rtt-ext-file.db-num = p-db-num
     3599           and buf_rtt-ext-file.from-db-num = p-from-db-num
     3600           and buf_rtt-ext-file.file-num = p-file-num no-error.
     3601     if not available buf_rtt-ext-file then do:
     3602       create buf_rtt-ext-file.
     3603       buffer-copy buf_tt-ext-file
     3604       except db-num from-db-num file-num
     3605       to buf_rtt-ext-file
     3606       assign
     3607       buf_rtt-ext-file.db-num = p-db-num
     3608       buf_rtt-ext-file.from-db-num = p-from-db-num
     3609       buf_rtt-ext-file.file-num = p-file-num
     3610       buf_rtt-ext-file.file-type = p-cash-desk-uniq-key-rec
     3611       buf_rtt-ext-file.obj-type = 'маг':U
     3612       buf_rtt-ext-file.obj-code = p-obj-code
     3613       .
     3614       release buf_rtt-ext-file.
     3615     end.
     3616   end.
     3617   end procedure.
