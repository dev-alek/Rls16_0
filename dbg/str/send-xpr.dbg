     2442   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     2443   define variable v-is-closed-shift-journal as integer no-undo .
     2444   assign
     2445   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     2446                               +
     2447                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     2448                               +
     2449                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     2450   .
     2451   return v-is-closed-shift-journal.
     2452   END FUNCTION.
     2453   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     2454   define variable v-is-first-journal as logical no-undo .
     2455   assign
     2456   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     2457                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     2458                     or (p-journal-num =  integer(entry(1, '17':U)))
     2459                     or (p-journal-num = integer(entry(1, '16':U)))
     2460   .
     2461   return v-is-first-journal.
     2462   END FUNCTION.
     2463   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     2464   define variable v-is-petrol-journal as logical no-undo .
     2465   assign
     2466   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     2467   return v-is-petrol-journal.
     2468   END FUNCTION.
     2469   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     2470   define variable v-max-record-num as integer no-undo .
     2471   assign
     2472   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     2473                       then 1489
     2474                       else 2340).
     2475   return v-max-record-num.
     2476   END FUNCTION.
     2477   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     2478   define variable v-max-record-num as integer no-undo .
     2479   assign
     2480   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     2481                       then 1489 * num-entries('30,31,32,33':U)
     2482                       else 2340 * num-entries('17':U)).
     2483   return v-max-record-num.
     2484   END FUNCTION.
     2485   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     2486                                           ,input p-rec-no as integer):
     2487   define variable v-num-recs as integer no-undo .
     2488   if tekka-is-petrol-journal (p-journal-num) then do:
     2489     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     2490       assign
     2491       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     2492       .
     2493     end.
     2494     else do:
     2495       assign
     2496       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     2497       .
     2498     end.
     2499   end.
     2500   else do:
     2501     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     2502       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     2503         assign
     2504         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     2505         .
     2506       end.
     2507       else do:
     2508         assign
     2509         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     2510         .
     2511       end.
     2512     end.
     2513     else do:
     2514       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     2515         assign
     2516         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     2517         .
     2518       end.
     2519       else do:
     2520         assign
     2521         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     2522         .
     2523       end.
     2524     end.
     2525   end.
     2526   return v-num-recs.
     2527   END FUNCTION.
     2528   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     2529                                              ,input p-is-petrol as logical
     2530                                              ,input p-is-current as logical
     2531                                              ,output p-rec-no as decimal
     2532                                              ):
     2533   define variable v-obj-num0 as integer no-undo .
     2534   define variable v-obj-num as integer no-undo .
     2535   define variable v-obj-num2 as integer no-undo .
     2536   define variable p-num-recs2 as integer no-undo .
     2537   define variable p-rec-no2 as integer no-undo .
     2538   if p-is-petrol then do:
     2539     assign
     2540     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     2541     .
     2542     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     2543     then
     2544     assign
     2545     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     2546     p-rec-no = p-num-recs modulo 1489
     2547     .
     2548     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     2549     then
     2550     assign
     2551     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     2552     p-rec-no = p-num-recs modulo 1489
     2553     .
     2554   end.
     2555   else do:
     2556     assign
     2557     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     2558     p-num-recs = trunc(p-num-recs, 0)
     2559     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     2560     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     2561     .
     2562     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     2563     then
     2564     assign
     2565     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     2566     p-rec-no = p-num-recs modulo 2340
     2567     .
     2568     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     2569     then
     2570     assign
     2571     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     2572     p-rec-no = p-num-recs modulo 2340
     2573     .
     2574     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     2575     then
     2576     assign
     2577     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     2578     p-rec-no2 = p-num-recs2 modulo 2978
     2579     .
     2580     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     2581     then
     2582     assign
     2583     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     2584     p-rec-no2 = p-num-recs2 modulo 2978
     2585     .
     2586     assign
     2587     p-rec-no = p-rec-no + p-rec-no2 / 10000
     2588     .
     2589   end.
     2590   if v-obj-num = 0 then v-obj-num = 100.
     2591   return v-obj-num.
     2592   END FUNCTION.
     2593   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     2594   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     2595   if lookup (string(p-obj-num), '17':U) > 0 then do:
     2596      if p-is-ptrl then
     2597      return integer(entry(1, '26,27,28,29':U)).
     2598      if not p-is-ptrl then
     2599      return integer(entry(1, '16':U)).
     2600   end.
     2601   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     2602   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     2603   return 0.
     2604   END FUNCTION.
     2605   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     2606   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     2607   if lookup (string(p-obj-num), '17':U) > 0 then do:
     2608     if p-is-ptrl then
     2609     return integer(entry(1, '26,27,28,29':U)).
     2610     if not p-is-ptrl then
     2611     return integer(entry(1, '16':U)).
     2612   end.
     2613   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     2614   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     2615   return 0.
     2616   END FUNCTION.
     2617   PROCEDURE maria-put:
     2618   define parameter buffer buf_cash-desk for ub.cash-desk.
     2619   define input parameter p-out    as character no-undo .
     2620   define input parameter p-fname as character no-undo .
     2621   define input parameter p-by-record as logical no-undo .
     2622   define input parameter p-shift-fields as integer no-undo .
     2623   define input parameter p-binary as logical no-undo .
     2624   define input parameter p-obj-num as integer no-undo .
     2625   define input parameter p-max-records as integer no-undo .
     2626   define input parameter p-plu as integer no-undo .
     2627   define input parameter p-value as character no-undo .
     2628   define variable v-file-name as character no-undo .
     2629   define variable v-create as logical no-undo .
     2630   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     2631   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     2632   output stream IBMSTREAM
     2633   to value(v-file-name) append .
     2634   Put  stream IBMSTREAM unformatted
     2635   p-plu
     2636   chr(3)
     2637   p-value
     2638   skip.
     2639   output stream IBMSTREAM
     2640   close.
     2641   if not p-by-record then do:
     2642     find first buf_temp-tekka-tsk where
     2643               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     2644     if not available buf_temp-tekka-tsk then do:
     2645       v-create = yes.
     2646     end.
     2647   end.
     2648   else do:
     2649     find first buf_temp-tekka-tsk where
     2650               buf_temp-tekka-tsk.filename  = v-file-name
     2651           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     2652     if not available buf_temp-tekka-tsk
     2653     then do:
     2654       find first buf_temp-tekka-tsk where
     2655                 buf_temp-tekka-tsk.filename  = v-file-name
     2656             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     2657       if not available buf_temp-tekka-tsk
     2658       then do:
     2659         v-create = yes.
     2660       end.
     2661     end.
     2662   end.
     2663   if v-create then do:
     2664     create buf_temp-tekka-tsk.
     2665     assign
     2666     buf_temp-tekka-tsk.filename = v-file-name
     2667     buf_temp-tekka-tsk.range    = p-plu
     2668     buf_temp-tekka-tsk.obj-num = p-obj-num
     2669     buf_temp-tekka-tsk.obj-name = '':U
     2670     buf_temp-tekka-tsk.num-records = 0
     2671     buf_temp-tekka-tsk.max-records = p-max-records
     2672     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     2673     buf_temp-tekka-tsk.task-num = p-fname
     2674     buf_temp-tekka-tsk.by-record = p-by-record
     2675     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     2676     buf_temp-tekka-tsk.binary = p-binary
     2677     buf_temp-tekka-tsk.send-get = 'send'
     2678     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     2679     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     2680     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     2681     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     2682                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     2683                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     2684                                 then 'local'
     2685                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     2686     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     2687     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     2688     buf_temp-tekka-tsk.waiting-sek = 30
     2689     buf_temp-tekka-tsk.min-plu     = p-plu
     2690     buf_temp-tekka-tsk.max-plu     = p-plu
     2691     .
     2692   end.
     2693   assign
     2694   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     2695   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     2696   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     2697   .
     2698   END PROCEDURE.
     2699   PROCEDURE maria-get:
     2700   define parameter buffer buf_cash-desk for ub.cash-desk.
     2701   define input parameter p-out    as character no-undo .
     2702   define input parameter p-fname as character no-undo .
     2703   define input parameter p-by-record as logical no-undo .
     2704   define input parameter p-obj-num as integer no-undo .
     2705   define input parameter p-num-fields as integer no-undo .
     2706   define input parameter p-max-records as integer no-undo .
     2707   define input parameter p-min-plu as integer no-undo .
     2708   define input parameter p-max-plu as integer no-undo .
     2709   define input parameter p-other as character no-undo .
     2710   define input parameter p-order-num as integer no-undo .
     2711   define variable v-file-name as character no-undo .
     2712   define variable v-secondary-obj-num as character no-undo .
     2713   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     2714   if p-by-record then do:
     2715     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     2716   end.
     2717   else do:
     2718     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     2719   end.
     2720   find first buf_temp-tekka-tsk where
     2721             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     2722   if not available buf_temp-tekka-tsk then do:
     2723     create buf_temp-tekka-tsk.
     2724     assign
     2725     buf_temp-tekka-tsk.filename = v-file-name
     2726     buf_temp-tekka-tsk.obj-num = p-obj-num
     2727     buf_temp-tekka-tsk.obj-name = '':U
     2728     buf_temp-tekka-tsk.max-records = p-max-records
     2729     buf_temp-tekka-tsk.num-fields = p-num-fields
     2730     buf_temp-tekka-tsk.task-num = p-fname
     2731     buf_temp-tekka-tsk.by-record = p-by-record
     2732     buf_temp-tekka-tsk.send-get = 'get'
     2733     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     2734     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     2735     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     2736     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     2737                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     2738                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     2739                                   then 'local'
     2740                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     2741     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     2742     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     2743     buf_temp-tekka-tsk.waiting-sek = 30
     2744     buf_temp-tekka-tsk.min-plu     = p-min-plu
     2745     buf_temp-tekka-tsk.max-plu     = p-max-plu
     2746     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     2747                                       and p-max-plu <> ?
     2748                                       then p-max-plu - p-min-plu + 1
     2749                                       else 0)
     2750     buf_temp-tekka-tsk.other-info = p-other
     2751     buf_temp-tekka-tsk.order-num = p-order-num
     2752     .
     2753     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     2754       assign
     2755       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     2756       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     2757       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     2758       no-error
     2759       .
     2760       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     2761     end.
     2762   end.
     2763   END PROCEDURE.
     2764   PROCEDURE maria-task:
     2765   define parameter buffer buf_cash-desk for ub.cash-desk.
     2766   define input parameter p-fname as character no-undo .
     2767   define input parameter p-obj-num-list as character no-undo .
     2768   define input parameter p-parameters as character no-undo .
     2769   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     2770   find first buf_temp-tekka-tsk where
     2771             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     2772   if not available buf_temp-tekka-tsk then do:
     2773     create buf_temp-tekka-tsk.
     2774     assign
     2775     buf_temp-tekka-tsk.filename = ''
     2776     buf_temp-tekka-tsk.range = 1
     2777     buf_temp-tekka-tsk.obj-num = 0
     2778     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     2779     buf_temp-tekka-tsk.task-num = p-fname
     2780     buf_temp-tekka-tsk.by-record = no
     2781     buf_temp-tekka-tsk.send-get = 'task'
     2782     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     2783     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     2784     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     2785     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     2786                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     2787                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     2788                                   then 'local'
     2789                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     2790     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     2791     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     2792     buf_temp-tekka-tsk.waiting-sek = 30
     2793     buf_temp-tekka-tsk.other-info = p-parameters
     2794     buf_temp-tekka-tsk.order-num = 0
     2795     .
     2796   end.
     2797   END PROCEDURE.
     2798   procedure tekkatsk-verify-schema :
     2799   define input parameter p-obj-list as character no-undo .
     2800   define input parameter p-dir-path as character no-undo .
     2801   define variable v-obj-num as integer no-undo .
     2802   define variable v-obj-name as character no-undo .
     2803   define variable v-num-records as integer no-undo .
     2804   define variable v-size_ as integer no-undo .
     2805   define variable v-value as character no-undo .
     2806   define variable ii as integer no-undo .
     2807   define variable jj as integer no-undo .
     2808   define variable ii-ibs as integer no-undo .
     2809   define variable ii-tekka as integer no-undo .
     2810   define variable v-result as character no-undo .
     2811   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     2812   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     2813     do
     2814     on error undo, return error
     2815     :
     2816        for each buf_temp-tekka-schema:
     2817          delete buf_temp-tekka-schema.
     2818        end.
     2819        input from value('tekkasch.d').
     2820        repeat :
     2821          create buf_temp-tekka-schema.
     2822          import buf_temp-tekka-schema.
     2823          assign
     2824          buf_temp-tekka-schema.host = 'IBS'
     2825          ii = ii + 1.
     2826          .
     2827        end.
     2828        input close.
     2829        ii-ibs = ii.
     2830         _ii:
     2831         do ii = 1 to 256:
     2832           if p-obj-list = "ALL"
     2833           or lookup(string(ii), p-obj-list) > 0 then do:
     2834             assign
     2835             v-obj-num = 0
     2836             v-obj-name = ''
     2837             v-num-records = 0
     2838             v-size_ = 0
     2839             .
     2840             run alienini-getkey in this-procedure (
     2841                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2842                                                     ,input ('obj' + string(ii, '999'))
     2843                                                     ,input 'oname'
     2844                                                     ,output v-value) no-error .
     2845             if v-value = ? then next _ii.
     2846             assign
     2847             v-obj-num = ii
     2848             v-obj-name = v-value
     2849             .
     2850             run alienini-getkey in this-procedure (
     2851                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2852                                                     ,input ('obj' + string(ii, '999'))
     2853                                                     ,input 'size'
     2854                                                     ,output v-value) no-error .
     2855             assign
     2856             v-num-records = integer(v-value) no-error  .
     2857             if error-status:error
     2858             or v-num-records = 0 then next _ii.
     2859             run alienini-getkey in this-procedure (
     2860                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2861                                                     ,input 'obj' + string(ii, '999')
     2862                                                     ,input 'f000'
     2863                                                     ,output v-value) no-error .
     2864             assign
     2865             v-size_ = integer(v-value) no-error  .
     2866             if error-status:error
     2867             or v-size_ = 0 then next _ii.
     2868             _jj:
     2869             do jj = 1 to 256:
     2870               run alienini-getkey in this-procedure (
     2871                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2872                                                       ,input 'obj' + string(ii, '999')
     2873                                                       ,input 'f' + string(jj, '999')
     2874                                                       ,output v-value) no-error .
     2875               if v-value = ? then next _ii.
     2876               create buf_temp-tekka-schema.
     2877               assign
     2878               buf_temp-tekka-schema.host = 'tekka'
     2879               buf_temp-tekka-schema.obj-num = v-obj-num
     2880               buf_temp-tekka-schema.obj-name = v-obj-name
     2881               buf_temp-tekka-schema.num-records = v-num-records
     2882               buf_temp-tekka-schema.size_ = v-size_
     2883               buf_temp-tekka-schema.field-num = jj
     2884               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     2885               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     2886                                                  then entry(2, entry(2, v-value, '#'), ':')
     2887                                                  else '':U)
     2888               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     2889               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     2890               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     2891                                                           , 'C,I,I,I,D,D,D,D,D':U)
     2892               no-error
     2893               .
     2894               if error-status:error then do:
     2895                 delete buf_temp-tekka-schema.
     2896                 next _jj.
     2897               end.
     2898               run alienini-getkey in this-procedure (
     2899                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2900                                                       ,input 'obj' + string(ii, '999') + 'name'
     2901                                                       ,input 'n' + string(jj, '999')
     2902                                                       ,output v-value) no-error .
     2903               if v-value <> ? then
     2904               buf_temp-tekka-schema.field-name = v-value.
     2905             end.
     2906           end.
     2907         end.
     2908         ii-tekka = ii - 1.
     2909        if p-obj-list <> 'ALL' then do:
     2910         if ii-tekka <> ii-ibs then do:
     2911           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     2912                                   , ii-ibs
     2913                                   , ii-tekka).
     2914         end.
     2915        end.
     2916        for each buf_temp-tekka-schema where
     2917               buf_temp-tekka-schema.host = 'tekka':
     2918          find first buf2_temp-tekka-schema where
     2919                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     2920                AND buf2_temp-tekka-schema.host = 'ibs'
     2921                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     2922          if not available buf2_temp-tekka-schema then do:
     2923           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     2924                                   , buf_temp-tekka-schema.field-num
     2925                                   , buf_temp-tekka-schema.obj-num).
     2926          end.
     2927          buffer-compare buf_temp-tekka-schema
     2928          to buf2_temp-tekka-schema
     2929          save result in v-result.
     2930          if v-result <> '':U then do:
     2931           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     2932                                   , buf_temp-tekka-schema.field-num
     2933                                   , buf_temp-tekka-schema.obj-num).
     2934          end.
     2935        end.
     2936     end.
     2937   end procedure.
     2938   FUNCTION set-Sx returns character (input p-string as character):
     2939   return p-string.
     2940   END FUNCTION.
     2941   FUNCTION get-Sx returns character (input p-string  as character):
     2942   return p-string.
     2943   END FUNCTION.
     2944   FUNCTION set-B returns character (input p-string  as character):
     2945   return chr(integer(p-string)).
     2946   END FUNCTION.
     2947   FUNCTION get-B returns character (input p-string  as character):
     2948   return string(asc(p-string)).
     2949   END FUNCTION.
     2950   FUNCTION set-BF returns character (input p-string  as character):
     2951   define variable v-dopi as integer no-undo .
     2952   define variable ii as integer no-undo .
     2953   do ii = 1 to 8:
     2954     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     2955   end.
     2956   return chr(v-dopi).
     2957   END FUNCTION.
     2958   FUNCTION get-BF returns character (input p-string  as character):
     2959   define variable v-dopi as integer no-undo .
     2960   define variable v-dops as character no-undo .
     2961   define variable ii as integer no-undo .
     2962   v-dopi = asc(p-string).
     2963   do ii = 8 to 1 BY -1:
     2964     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     2965   end.
     2966   return v-dops.
     2967   END FUNCTION.
     2968   FUNCTION set-BN returns character (input p-string  as character
     2969                                     ,input p-bin-group as character):
     2970   define variable v-dopi as integer no-undo .
     2971   define variable ii as integer no-undo .
     2972   define variable jj as integer no-undo .
     2973   define variable v-grp-nums as integer no-undo .
     2974   define variable v-dopi2 as integer no-undo .
     2975   v-grp-nums = num-entries(p-bin-group).
     2976   do jj = 0 to v-grp-nums - 1:
     2977     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     2978     do ii = 1 to 8:
     2979       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     2980     end.
     2981   end.
     2982   return chr(v-dopi).
     2983   END FUNCTION.
     2984   FUNCTION get-BN returns character (input p-string  as character
     2985                                     ,input p-bin-group as character):
     2986   define variable v-dopi as integer no-undo .
     2987   define variable v-dops as character no-undo .
     2988   define variable v-grp-nums as integer no-undo .
     2989   define variable ii as integer no-undo .
     2990   define variable jj as integer no-undo .
     2991   v-dopi = asc(p-string).
     2992   v-grp-nums = num-entries(p-bin-group).
     2993   do jj = 1 to v-grp-nums:
     2994   do ii = 8 to 1 BY -1:
     2995     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     2996   end.
     2997   end.
     2998   return v-dops.
     2999   END FUNCTION.
     3000   procedure fill-temp-cd :
