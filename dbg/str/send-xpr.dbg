      144   define new SHARED temp-table chk_doc no-undo
      145   field doc-code as char
      146   field chk-date as date
      147   field chk-time as int
      148   field chk-num as int
      149   field g-lines as int
      150   field p-lines as int
      151   .
      152   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      153   procedure gen-key-rec :
      154     define input  parameter p-tbl-name    as character no-undo.
      155     define input  parameter p-bh_tbl-name as handle    no-undo.
      156     define output parameter p-key-rec     as character no-undo.
      157     do
      158     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      159     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      160     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      161     :
      162       define variable fh               as handle    no-undo .
      163       define variable v-ok             as logical   no-undo .
      164       define variable v-inform         as character no-undo .
      165       define variable v-ind            as integer   no-undo .
      166       define variable v-idx-field-qnty as integer   no-undo .
      167       if p-tbl-name = ?
      168         or p-tbl-name = "":U
      169       then do:
      170         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      171       end.
      172       if not p-bh_tbl-name:available then do:
      173         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      174       end.
      175       assign
      176         p-key-rec = p-tbl-name
      177         v-inform  = p-bh_tbl-name:index-information(1)
      178         v-ind     = 2
      179       .
      180       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      181       on error undo, return error
      182       :
      183         assign
      184           v-inform = p-bh_tbl-name:index-information( v-ind )
      185           v-ind    = v-ind + 1
      186         .
      187       end.
      188       if v-inform = ?
      189         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      190         or entry( 3, v-inform, ",":U ) <> "1":U
      191       then do:
      192         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      193       end.
      194       else do:
      195         assign
      196           v-idx-field-qnty = num-entries( v-inform ) - 4
      197         .
      198         if v-idx-field-qnty < 2 then do:
      199           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      200         end.
      201         do v-ind = 1 to v-idx-field-qnty by 2
      202         on error undo, return error
      203         :
      204           assign
      205             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      206             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      207           .
      208         end.
      209       end.
      210       if p-key-rec = ? then do:
      211         assign
      212           p-key-rec = "":U
      213         .
      214         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      215       end.
      216     end.
      217     return.
      218   end procedure.
      219   procedure gen-where-keyr-tab :
      220     define input  parameter i-tableSerach as character no-undo.
      221     define input  parameter i-tablekey   as character  no-undo.
      222     define input  parameter p-key-rec    as character  no-undo.
      223     define input  parameter p-key-handle as handle     no-undo .
      224     define input  parameter p-db-name    as character  no-undo .
      225     define input  parameter p-tt-handle  as handle     no-undo .
      226     define output parameter o-Where      as character  no-undo.
      227     do
      228     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      229     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      230     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      231     :
      232       define variable v-full-tbl-name  as character no-undo .
      233       define variable bh_tbl-name      as handle    no-undo .
      234       define variable fh_key           as handle    no-undo .
      235       define variable fh_search        as handle    no-undo .
      236       define variable v-field-num      as integer   no-undo .
      237       define variable v-count-fld      as integer   no-undo .
      238       define variable v-inform         as character no-undo .
      239       define variable v-ind            as integer   no-undo .
      240       define variable v-idx-field-qnty as integer   no-undo .
      241       define variable v-field-name     as character no-undo .
      242       define variable v-field-val      as character no-undo .
      243       define variable v-word-link      as character no-undo .
      244       define variable vTable           as character no-undo.
      245       define variable bh_tbl-key       as handle    no-undo .
      246       assign
      247         p-key-rec = trim( p-key-rec )
      248       .
      249       if p-key-handle <> ? then do:
      250         if not valid-handle(p-key-handle)
      251            or p-key-handle:type <> "buffer"
      252         then do:
      253           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      254         end.
      255         if num-entries( p-key-rec, chr(3) ) > 1
      256           or p-key-rec = ?
      257           or p-key-rec = "":U
      258         then do:
      259           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      260         end.
      261       end.
      262       else do:
      263         if p-key-rec = ?
      264           or p-key-rec = "":U
      265         then do:
      266           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      267         end.
      268       end.
      269       assign
      270         vTable = entry( 1 , p-key-rec, chr(3) )
      271       .
      272       if p-tt-handle <> ?
      273         and ( not valid-handle(p-tt-handle)
      274               or p-tt-handle:type <> "buffer"
      275             )
      276       then do:
      277         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      278       end.
      279       if p-tt-handle = ? then do:
      280         assign
      281           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      282         .
      283         create buffer bh_tbl-name for table v-full-tbl-name .
      284       end.
      285       else do:
      286         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      287       end.
      288       assign
      289         v-inform = bh_tbl-name:index-information(1)
      290         v-ind    = 2
      291       .
      292       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      293       on error undo, return error
      294       :
      295         assign
      296           v-inform = bh_tbl-name:index-information( v-ind )
      297           v-ind    = v-ind + 1
      298         .
      299       end.
      300       if v-inform = ?
      301         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      302         or entry( 3, v-inform, ",":U ) <> "1":U
      303       then do:
      304         delete object bh_tbl-name no-error.
      305         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      306       end.
      307       assign
      308         v-idx-field-qnty = num-entries( v-inform ) - 4
      309       .
      310       if v-idx-field-qnty < 2 then do:
      311         delete object bh_tbl-name no-error.
      312         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      313       end.
      314       assign
      315         o-where     = "where":U
      316         v-word-link = "":U
      317         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      318         v-count-fld = 0
      319       .
      320       if i-tablekey ne "" and i-tablekey ne ?
      321       then do:
      322         assign
      323           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      324         .
      325         create buffer bh_tbl-key for table v-full-tbl-name .
      326       end.
      327       if i-tableSerach ne "" and i-tableSerach ne ?
      328       then do:
      329         delete object bh_tbl-name no-error.
      330         assign
      331           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      332         .
      333         create buffer bh_tbl-name for table v-full-tbl-name .
      334       end.
      335       block_where:
      336       do v-ind = 1 to v-idx-field-qnty by 2
      337       on error undo, return error
      338       :
      339         assign
      340           v-count-fld = v-count-fld + 1
      341         .
      342         if p-key-handle = ?
      343           and v-count-fld > v-field-num
      344         then do:
      345           leave block_where.
      346         end.
      347         define variable VfieldKeyTable as handle no-undo.
      348         assign
      349           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      350           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      351         .
      352         if     bh_tbl-key ne ?
      353         then do:
      354            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      355            if VfieldKeyTable eq ?
      356            then next block_where.
      357         end.
      358         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      359         then
      360            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      361         else
      362            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      363         if p-key-handle = ? then do:
      364           assign
      365             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      366           .
      367         end.
      368         else do:
      369           assign
      370             fh_key = p-key-handle:buffer-field( v-field-name )
      371           .
      372           if fh_key = ?
      373             or not valid-handle( fh_key )
      374           then do:
      375             delete object bh_tbl-name.
      376             if     bh_tbl-key ne ?
      377             then
      378                delete object bh_tbl-key.
      379             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      380           end.
      381           assign
      382             v-field-val = fh_key:buffer-value
      383           .
      384         end.
      385         if fh_search:data-type ="character":U then do:
      386           assign
      387             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      388             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      389             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      390             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      391             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      392             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      393             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      394             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      395             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      396             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      397             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      398             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      399             v-field-val = substitute( '"&1"', v-field-val )
      400           .
      401         end.
      402         assign
      403           o-where = substitute( "&1 &2", o-where, v-field-val )
      404         .
      405         if v-word-link = "":U then do:
      406           assign
      407             v-word-link = "and":U
      408           .
      409         end.
      410       end.
      411       delete object bh_tbl-name.
      412       if     bh_tbl-key ne ?
      413       then
      414          delete object bh_tbl-key.
      415       if p-key-handle = ?
      416         and v-count-fld <> v-field-num
      417       then do:
      418         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      419       end.
      420     end.
      421   end procedure.
      422   procedure gen-hn-keyr-tab :
      423     define input  parameter i-tableSerach as character no-undo.
      424     define input  parameter i-tablekey   as character no-undo.
      425     define input  parameter p-key-rec    as character no-undo.
      426     define input  parameter p-key-handle as handle    no-undo .
      427     define input  parameter p-db-name    as character no-undo .
      428     define input  parameter p-tt-handle  as handle    no-undo .
      429     define input  parameter p-stts-lock  as integer   no-undo .
      430     define output parameter o-hn         as handle    no-undo.
      431     define variable v-full-tbl-name as character no-undo.
      432     define variable v-where         as character no-undo.
      433     define variable bh_tbl-name     as handle    no-undo.
      434     define variable vTable          as character no-undo.
      435     do
      436     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      437     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      438     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      439         run gen-where-keyr-tab(i-tableSerach,
      440                                i-tablekey,
      441                                p-key-rec,
      442                                p-key-handle,
      443                                p-db-name,
      444                                p-tt-handle,
      445                                output v-where).
      446         if i-tableSerach ne "" and i-tableSerach ne ?
      447         then do:
      448            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      449            create buffer bh_tbl-name for table v-full-tbl-name .
      450         end.
      451         else do:
      452            if p-tt-handle = ? then do:
      453               assign
      454                  vTable = entry( 1 , p-key-rec, chr(3) )
      455               .
      456               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      457               create buffer bh_tbl-name for table v-full-tbl-name .
      458            end.
      459            else do:
      460               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      461            end.
      462         end.
      463         if p-tt-handle = ? then do:
      464            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      465         end.
      466         else do:
      467            bh_tbl-name:find-first( v-where ) no-error .
      468         end.
      469         o-hn = bh_tbl-name.
      470      end.
      471   end procedure.
      472   procedure gen-hn-keyr :
      473     define input  parameter p-key-rec    as character no-undo.
      474     define input  parameter p-key-handle as handle    no-undo .
      475     define input  parameter p-db-name    as character no-undo .
      476     define input  parameter p-tt-handle  as handle    no-undo .
      477     define input  parameter p-stts-lock  as integer   no-undo .
      478     define output parameter o-hn         as handle    no-undo.
      479     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      480   end.
      481   procedure gen-row-keyr :
      482     define input  parameter p-key-rec    as character no-undo.
      483     define input  parameter p-key-handle as handle    no-undo .
      484     define input  parameter p-db-name    as character no-undo .
      485     define input  parameter p-tt-handle  as handle    no-undo .
      486     define input  parameter p-stts-lock  as integer   no-undo .
      487     define output parameter p-tbl-row    as rowid     no-undo.
      488     define output parameter p-tbl-name   as character no-undo.
      489     define variable vHn as handle no-undo.
      490       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      491       p-tbl-row = if vHn:available then vHn:rowid else ?.
      492       p-tbl-name =  vHn:table.
      493       delete object vHn no-error.
      494     if p-tbl-row = ? then do:
      495       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      496     end.
      497     else do:
      498       return.
      499     end.
      500   end procedure.
      501   procedure gen-key-fv :
      502     define input  parameter p-key-rec    as character no-undo .
      503     define output parameter p-field-list as character no-undo .
      504     define output parameter p-value-list as character no-undo.
      505     do
      506     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      507     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      508     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      509     :
      510       define variable v-full-tbl-name  as character no-undo .
      511       define variable bh_tbl-name      as handle    no-undo .
      512       define variable v-tbl-name       as character no-undo .
      513       define variable v-field-num      as integer   no-undo .
      514       define variable v-count-fld      as integer   no-undo .
      515       define variable v-inform         as character no-undo .
      516       define variable v-ind            as integer   no-undo .
      517       define variable v-idx-field-qnty as integer   no-undo .
      518       define variable v-delim-key      as character no-undo .
      519       if p-key-rec = ?
      520         or p-key-rec = "":U
      521       then do:
      522         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      523       end.
      524       assign
      525         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      526         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      527       .
      528       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      529       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      530       assign
      531         v-inform = bh_tbl-name:index-information(1)
      532         v-ind    = 2
      533       .
      534       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      535       on error undo, return error
      536       :
      537         assign
      538           v-inform = bh_tbl-name:index-information( v-ind )
      539           v-ind    = v-ind + 1
      540         .
      541       end.
      542       if v-inform = ?
      543         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      544         or entry( 3, v-inform, ",":U ) <> "1":U
      545       then do:
      546         delete object bh_tbl-name no-error.
      547         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      548       end.
      549       assign
      550         v-idx-field-qnty = num-entries( v-inform ) - 4
      551       .
      552       if v-idx-field-qnty < 2 then do:
      553         delete object bh_tbl-name no-error.
      554         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      555       end.
      556       assign
      557         p-field-list = "":U
      558         p-value-list = "":U
      559         v-delim-key  = "":U
      560         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      561         v-count-fld  = 0
      562       .
      563       block_where:
      564       do v-ind = 1 to v-idx-field-qnty by 2
      565       on error undo, return error
      566       :
      567         assign
      568           v-count-fld = v-count-fld + 1
      569         .
      570         if v-count-fld > v-field-num then do:
      571           leave block_where.
      572         end.
      573         assign
      574           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      575           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      576         .
      577         if v-ind = 1 then do:
      578           assign
      579             v-delim-key = chr(3)
      580           .
      581         end.
      582       end.
      583       delete object bh_tbl-name.
      584       if v-count-fld <> v-field-num then do:
      585         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      586       end.
      587     end.
      588   end procedure.
      589   procedure gen-key-field :
      590     define input  parameter p-table      as character no-undo .
      591     define output parameter p-field-list as character no-undo .
      592     do
      593     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      594     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      595     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      596     :
      597       define variable v-full-tbl-name  as character no-undo .
      598       define variable bh_tbl-name      as handle    no-undo .
      599       define variable v-tbl-name       as character no-undo .
      600       define variable v-field-num      as integer   no-undo .
      601       define variable v-count-fld      as integer   no-undo .
      602       define variable v-inform         as character no-undo .
      603       define variable v-ind            as integer   no-undo .
      604       define variable v-idx-field-qnty as integer   no-undo .
      605       define variable v-delim-key      as character no-undo .
      606       if p-table = ?
      607         or p-table = "":U
      608       then do:
      609         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      610       end.
      611       assign
      612         v-tbl-name      = p-table
      613         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      614       .
      615       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      616       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      617       assign
      618         v-inform = bh_tbl-name:index-information(1)
      619         v-ind    = 2
      620       .
      621       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      622       on error undo, return error
      623       :
      624         assign
      625           v-inform = bh_tbl-name:index-information( v-ind )
      626           v-ind    = v-ind + 1
      627         .
      628       end.
      629       if v-inform = ?
      630         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      631         or entry( 3, v-inform, ",":U ) <> "1":U
      632       then do:
      633         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      634       end.
      635       assign
      636         v-idx-field-qnty = num-entries( v-inform ) - 4
      637       .
      638       if v-idx-field-qnty < 2 then do:
      639         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      640       end.
      641       assign
      642         p-field-list = "":U
      643         v-delim-key  = "":U
      644         v-count-fld  = 0
      645       .
      646       block_where:
      647       do v-ind = 1 to v-idx-field-qnty by 2
      648       on error undo, return error
      649       :
      650         assign
      651           v-count-fld = v-count-fld + 1
      652         .
      653         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      654         if v-ind = 1 then do:
      655           assign
      656             v-delim-key = chr(3)
      657           .
      658         end.
      659       end.
      660       delete object bh_tbl-name.
      661     end.
      662   end procedure.
      663   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      664   define new shared temp-table tt-ext-file-par no-undo like ub.ext-file-par.
      665   procedure ext-file-par-clear-temp :
      666     define buffer buf_tt-ext-file-par for tt-ext-file-par .
      667     do
      668     on error undo, return error return-value
      669     :
      670       for each buf_tt-ext-file-par
      671       on error undo, return error
      672       :
      673         delete buf_tt-ext-file-par .
      674       end.
      675     end.
      676   end procedure.
      677   procedure ext-file-par-write-temp :
      678     define input  parameter p-db-num      as integer no-undo .
      679     define input  parameter p-from-db-num      as integer no-undo .
      680     define input  parameter p-file-num      as integer no-undo .
      681     define input  parameter p-param-num      as integer no-undo .
      682     define input  parameter p-value-type as character no-undo .
      683     define input  parameter p-value-name as character no-undo .
      684     define input  parameter p-value-char as character no-undo .
      685     define input  parameter p-value-date as date      no-undo .
      686     define input  parameter p-value-integer as integer      no-undo .
      687     define input  parameter p-value-decimal as decimal      no-undo .
      688     define input  parameter p-value-logical as logical      no-undo .
      689     define buffer buf_tt-ext-file-par for tt-ext-file-par .
      690     do
      691     on error undo, return error return-value
      692     :
      693       find first buf_tt-ext-file-par
      694         where buf_tt-ext-file-par.db-num        = p-db-num
      695           and buf_tt-ext-file-par.file-num      = p-file-num
      696           and buf_tt-ext-file-par.from-db-num   = p-from-db-num
      697           and buf_tt-ext-file-par.param-type    = p-value-type
      698           and buf_tt-ext-file-par.param-name    = p-value-name
      699         no-error .
      700       if not available buf_tt-ext-file-par then do:
      701         create buf_tt-ext-file-par .
      702         assign
      703           buf_tt-ext-file-par.db-num         = p-db-num
      704           buf_tt-ext-file-par.from-db-num    = p-from-db-num
      705           buf_tt-ext-file-par.file-num       = p-file-num
      706           buf_tt-ext-file-par.param-num      = p-param-num
      707           buf_tt-ext-file-par.param-type     = p-value-type
      708           buf_tt-ext-file-par.user-db-num    = p-db-num
      709                 .
      710       end.
      711       CASE p-value-type:
      712         when 'C':U
      713         or when 'uniq-key-rec':U
      714         then do:
      715           assign
      716           buf_tt-ext-file-par.param-name = p-value-name
      717           buf_tt-ext-file-par.param-value = p-value-char
      718           .
      719         end.
      720         when 'T':U then do:
      721           assign
      722           buf_tt-ext-file-par.param-date-name = p-value-name
      723           buf_tt-ext-file-par.param-date-value = p-value-date
      724           .
      725         end.
      726         when 'I':U then do:
      727           assign
      728           buf_tt-ext-file-par.param-int-name = p-value-name
      729           buf_tt-ext-file-par.param-int-value = p-value-integer
      730           .
      731         end.
      732         when 'L':U then do:
      733           assign
      734           buf_tt-ext-file-par.param-log-name = p-value-name
      735           buf_tt-ext-file-par.param-log-value = p-value-logical
      736           .
      737         end.
      738         when 'D':U then do:
      739           assign
      740           buf_tt-ext-file-par.param-decimal-name = p-value-name
      741           buf_tt-ext-file-par.param-decimal-value = p-value-decimal
      742           .
      743         end.
      744       END CASE.
      745     end.
      746   end procedure.
      747   procedure ext-file-par-write-and-send :
      748     define input  parameter p-db-num      as integer no-undo .
      749     define input  parameter p-from-db-num      as integer no-undo .
      750     define input  parameter p-file-num      as integer no-undo .
      751     define input  parameter p-param-num      as integer no-undo .
      752     define input  parameter p-value-type as character no-undo .
      753     define input  parameter p-value-name as character no-undo .
      754     define input  parameter p-value-char as character no-undo .
      755     define input  parameter p-value-date as date      no-undo .
      756     define input  parameter p-value-integer as integer      no-undo .
      757     define input  parameter p-value-decimal as decimal      no-undo .
      758     define input  parameter p-value-logical as logical      no-undo .
      759     define input  parameter p-send        as logical no-undo .
      760     define input  parameter p-list-db-num as character no-undo .
      761     define buffer buf_ext-file-par for ub.ext-file-par .
      762     do
      763     on error undo, return error return-value
      764     :
      765       find first buf_ext-file-par
      766         where buf_ext-file-par.db-num         = p-db-num
      767           and buf_ext-file-par.from-db-num    = p-from-db-num
      768           and buf_ext-file-par.file-num       = p-file-num
      769           and buf_ext-file-par.param-num      = p-param-num
      770         no-error .
      771       if not available buf_ext-file-par then do:
      772         create buf_ext-file-par .
      773         assign
      774           buf_ext-file-par.db-num    = p-db-num
      775           buf_ext-file-par.from-db-num    = p-from-db-num
      776           buf_ext-file-par.file-num    = p-file-num
      777           buf_ext-file-par.param-num    = p-param-num
      778           buf_ext-file-par.param-type   = p-value-type
      779           buf_ext-file-par.user-db-num    = p-db-num
      780         .
      781       end.
      782       CASE p-value-type:
      783         when 'C':U
      784         or when ''
      785         or when 'uniq-key-rec':U
      786         then do:
      787           assign
      788           buf_ext-file-par.param-name = p-value-name
      789           buf_ext-file-par.param-value = p-value-char
      790           .
      791           if p-value-type = ''
      792           and p-param-num = 0 then do:
      793             buf_ext-file-par.param-log-value = p-value-logical.
      794           end.
      795         end.
      796         when 'T':U then do:
      797           assign
      798           buf_ext-file-par.param-date-name = p-value-name
      799           buf_ext-file-par.param-date-value = p-value-date
      800           .
      801         end.
      802         when 'I':U then do:
      803           assign
      804           buf_ext-file-par.param-int-name = p-value-name
      805           buf_ext-file-par.param-int-value = p-value-integer
      806           .
      807         end.
      808         when 'D':U then do:
      809           assign
      810           buf_ext-file-par.param-decimal-name = p-value-name
      811           buf_ext-file-par.param-decimal-value = p-value-decimal
      812           .
      813         end.
      814         when 'L':U then do:
      815           assign
      816           buf_ext-file-par.param-log-name = p-value-name
      817           buf_ext-file-par.param-log-value = p-value-logical
      818           .
      819         end.
      820       END CASE.
      821       if p-send then do:
      822         run nws/cr-route.p (
      823                         input 'send-tbl':U
      824                       , input 'ext-file-par':U
      825                       , input buffer buf_ext-file-par:handle
      826                       , input p-list-db-num) no-error.
      827       end.
      828     end.
      829   end procedure.
      830   define variable p-cash-desk-uniq-key-rec as character no-undo .
      831   define variable action     as character no-undo .
      832   define variable p-ext-file-uniq-key-rec as character no-undo .
      833   define variable i-obj-code as integer no-undo .
      834   define variable v-host-code as integer no-undo .
      835   define variable p-db-num   like ub.cash-desk.db-num no-undo .
      836   define variable p-obj-code like ub.cash-desk.obj-code no-undo .
      837   define variable p-pos-type like ub.cash-desk.pos-type no-undo .
      838   define variable p-cash-num like ub.cash-desk.cash-num no-undo .
      839   define variable v-tbl-row as rowid no-undo .
      840   define variable v-tbl-name as character no-undo .
      841   define variable v-error-num as integer no-undo .
      842   define variable v-reply-file-name as character no-undo .
      843   define variable v-param-num as integer no-undo .
      844   define variable v-log-file-uniq-key-rec as character no-undo .
      845   define variable v-reply-file-uniq-key-rec as character no-undo .
      846   define variable v-unc-reply-file-name as character no-undo .
      847   define variable v-unc-log-file-name as character no-undo .
      848   define buffer target_cash-desk for ub.cash-desk.
      849   define buffer buf_ext-file for ub.ext-file.
      850   define buffer buf2_ext-file for ub.ext-file.
      851   define new shared temp-table tt-ext-file no-undo like ub.ext-file.
      852   define new shared temp-table tt-db       no-undo like ub.db.
      853   define temp-table rtt-ext-file no-undo like ub.ext-file.
      854   define buffer buf_tt-db for tt-db.
      855   define buffer buf_tt-ext-file for tt-ext-file.
      856   define buffer buf_rtt-ext-file for rtt-ext-file.
      857   define buffer buf_db for ub.db.
      858   define buffer buf_ext-file-par for ub.ext-file-par.
      859   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      860   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      861   function prepare-path returns character ( input p-nonprepared-path as character ):
      862   define variable v-prepared-path as character no-undo .
      863   assign
      864   v-prepared-path = replace(p-nonprepared-path, chr(92), chr(47))
      865   v-prepared-path = right-trim(v-prepared-path, chr(47))
      866   .
      867   return v-prepared-path.
      868   END FUNCTION.
      869   function prepare-path2 returns character ( input p-nonprepared-path as character ):
      870   define variable v-prepared-path as character no-undo .
      871   assign
      872   v-prepared-path = replace(p-nonprepared-path, chr(47), chr(92))
      873   v-prepared-path = right-trim(v-prepared-path, chr(92))
      874   .
      875   return v-prepared-path.
      876   END FUNCTION.
      877   function quote-spaces returns character ( input p-full-path as character):
      878   define variable v-ii as integer no-undo .
      879   define variable v-result as character no-undo .
      880   do v-ii = 1 to num-entries(p-full-path, chr(92)):
      881     v-result = v-result + (if v-ii = 1 then '' else chr(92)) +
      882                (if index(entry(v-ii, p-full-path, chr(92)), chr(32)) > 0
      883                then  substitute("&1&2&1", chr(34), entry(v-ii, p-full-path, chr(92)))
      884                else entry(v-ii, p-full-path, chr(92))
      885                )
      886     .
      887   end.
      888   return v-result.
      889   end function.
      890   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      891   procedure cur-time :
      892      define output parameter p-today as date      no-undo .
      893      define output parameter p-time  as integer   no-undo .
      894     do
      895     on error undo, return error
      896     :
      897       define variable v-date1 as date      no-undo .
      898       define variable v-date2 as date      no-undo .
      899       define variable v-time  as integer   no-undo .
      900       assign
      901         v-date1 = today
      902         v-time  = time
      903         v-date2 = today
      904       .
      905       if v-date1 <> v-date2
      906       then do:
      907         assign
      908           v-date1 = today
      909           v-time  = v-time
      910         .
      911       end.
      912       assign
      913         p-today = v-date1
      914         p-time  = v-time
      915       .
      916     end.
      917   end.
      918   function cur-time-date returns character
      919   :
      920     return string(today, '99/99/9999':U) .
      921   end.
      922   function cur-time-mjd returns decimal
      923   :
      924     define variable v-date as date      no-undo .
      925     define variable v-time as integer   no-undo .
      926     run cur-time in this-procedure
      927       (output v-date
      928       ,output v-time
      929       ) .
      930     return integer(v-date) - 2400002 + (v-time / 86400) .
      931   end.
      932   function cur-time-get-ending-index returns integer
      933   (input p-number as integer
      934   )
      935   :
      936     if p-number < 0
      937     or p-number = ?
      938     then do:
      939       return 1 .
      940     end.
      941     define variable v-rest as integer   no-undo .
      942     assign
      943       p-number = p-number modulo 100
      944     .
      945     if p-number < 20
      946     then do:
      947       assign
      948         v-rest = p-number
      949       .
      950     end.
      951     else do:
      952       assign
      953         v-rest = p-number modulo 10
      954       .
      955     end.
      956     case v-rest :
      957       when 1
      958       then do:
      959         return 2 .
      960       end.
      961       when 2 or
      962       when 3 or
      963       when 4
      964       then do:
      965         return 3 .
      966       end.
      967       otherwise do:
      968         return 1 .
      969       end.
      970     end case .
      971   end.
      972   procedure cur-time-mjd-to-date :
      973      define input  parameter i-mjd-diff as decimal no-undo.
      974      define output parameter o-Date     as date    no-undo.
      975      define output parameter o-Time     as integer no-undo.
      976      define variable v-day-number as integer   no-undo .
      977      if    i-mjd-diff < 0
      978         or i-mjd-diff = ?
      979      then do:
      980         return "?" .
      981      end.
      982      assign
      983         v-day-number = truncate(i-mjd-diff,0).
      984         o-Date = date(v-day-number + 2400002).
      985         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      986     .
      987   end.
      988   function cur-time-mjd-to-string returns character
      989   (input p-mjd-diff as decimal
      990   )
      991   :
      992     define variable v-day-number as integer   no-undo .
      993     define variable v-seconds    as integer   no-undo .
      994     define variable v-hour       as integer   no-undo .
      995     define variable v-min        as integer   no-undo .
      996     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      997     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      998     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      999     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1000     if p-mjd-diff < 0
     1001     or p-mjd-diff = ?
     1002     then do:
     1003       return "?" .
     1004     end.
     1005     assign
     1006       v-day-number = integer(truncate(p-mjd-diff,0))
     1007       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1008     .
     1009     if v-seconds > 86400
     1010     then do:
     1011       assign
     1012         v-seconds = 86400 - 1
     1013       .
     1014     end.
     1015     if v-seconds < 0
     1016     then do:
     1017       assign
     1018         v-seconds = 0
     1019       .
     1020     end.
     1021     assign
     1022       v-hour = truncate(v-seconds / 3600, 0)
     1023     .
     1024     assign
     1025       v-seconds = v-seconds modulo 3600
     1026     .
     1027     assign
     1028       v-min = truncate(v-seconds / 60, 0)
     1029     .
     1030     assign
     1031       v-seconds = v-seconds modulo 60
     1032     .
     1033     return
     1034         (if v-day-number <> 0
     1035           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1036           else ""
     1037         )
     1038       + (if v-day-number <> 0 or v-hour <> 0
     1039           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1040           else ""
     1041         )
     1042       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1043           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1044           else ""
     1045         )
     1046       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1047       .
     1048   end.
     1049   function cur-time-string returns character
     1050   :
     1051     define variable v-date as date      no-undo .
     1052     define variable v-time as integer   no-undo .
     1053     run cur-time in this-procedure
     1054       (output v-date
     1055       ,output v-time
     1056       ) .
     1057     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1058   end.
     1059   function cur-time-string-sec returns character
     1060   :
     1061     define variable v-date as date      no-undo .
     1062     define variable v-time as integer   no-undo .
     1063     run cur-time in this-procedure
     1064       (output v-date
     1065       ,output v-time
     1066       ) .
     1067     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1068   end.
     1069   function cur-time-custom  returns character
     1070   (input p-prefix as character
     1071   ,input p-date-format as character
     1072   ,input p-delimiter as character
     1073   ,input p-time-format as character
     1074   ,input p-suffix as character
     1075   )
     1076   :
     1077     define variable v-date as date      no-undo .
     1078     define variable v-time as integer   no-undo .
     1079     run cur-time in this-procedure
     1080       (output v-date
     1081       ,output v-time
     1082       ) .
     1083     return
     1084       p-prefix
     1085       + string(v-date, p-date-format)
     1086       + p-delimiter
     1087       + string(v-time, p-time-format)
     1088       + p-suffix
     1089       .
     1090   end.
     1091   function cur-time-print  returns character
     1092   :
     1093     define variable v-date as date      no-undo .
     1094     define variable v-time as integer   no-undo .
     1095     run cur-time in this-procedure
     1096       (output v-date
     1097       ,output v-time
     1098       ) .
     1099     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1100   end.
     1101   function cur-time-datetime returns datetime
     1102   :
     1103     define variable v-char as character no-undo .
     1104     define variable v-datetime as datetime no-undo .
     1105     v-char = cur-time-string().
     1106     v-datetime = datetime(v-char).
     1107     return  v-datetime.
     1108   end.
     1109   function cur-time-string-msec returns character
     1110   :
     1111     define variable v-date as datetime  no-undo .
     1112     v-date = now.
     1113     return string(v-date) .
     1114   end.
     1115   procedure bintrn_create-file-record :
     1116   define input parameter p-path as character no-undo .
     1117   define input parameter p-file-type as character no-undo .
     1118   define input parameter p-obj-type as character no-undo .
     1119   define input parameter p-obj-code as integer no-undo .
     1120   define output parameter p-full-name as character no-undo .
     1121   define variable v-full-path        as character no-undo .
     1122   define variable v-path             as character no-undo .
     1123   define variable v-file-name        as character no-undo .
     1124   define variable v-file-name-no-ext as character no-undo .
     1125   define variable v-file-name-ext    as character no-undo .
     1126   DEFINE VARIABLE v-md5-signature AS CHARACTER NO-undo.
     1127   DEFINE VARIABLE v-today as date no-undo .
     1128   DEFINE VARIABLE v-time as integer no-undo .
     1129   define variable v-full-path2        as character no-undo .
     1130   define buffer buf_tt-ext-file for tt-ext-file.
     1131   do
     1132   on error undo, return error
     1133   :
     1134     run gbl/filename.p (
     1135                     input  p-path
     1136                   ,output v-full-path
     1137                   ,output v-path
     1138                   ,output v-file-name
     1139                   ,output v-file-name-no-ext
     1140                   ,output v-file-name-ext
     1141                   ) no-error .
     1142     if error-status:error  = yes then do:
     1143       undo, return  substitute("Ошибка при поиске файла &1:&2&3&2&4"
     1144                                 , p-path
     1145                                 , chr(10)
     1146                                 , error-status:get-message(1)
     1147                                 , return-value ).
     1148     end.
     1149     assign
     1150     v-full-path = prepare-path(v-full-path).
     1151     v-full-path2 = prepare-path2(v-full-path).
     1152     define variable v-unc as character no-undo .
     1153     run gbl/get-unc.p ( input v-full-path2, output v-unc) no-error.
     1154     if not error-status :error then do:
     1155       assign
     1156       v-full-path2 = v-unc.
     1157     end.
     1158     file-info:FILE-NAME = v-full-path.
     1159     run gbl/md5.p (
     1160         input  v-full-path
     1161       ,output v-md5-signature
     1162       ) no-error.
     1163     if error-status:error then do:
     1164       undo, return substitute("Ошибка при выполнении подсчета КС файла &1&2" +
     1165                   "&3&2&4"
     1166                   , v-full-path
     1167                   , chr(10)
     1168                   , error-status:get-message(1)
     1169                   , return-value ).
     1170     end.
     1171     run cur-time in this-procedure ( output v-today, output v-time).
     1172     create buf_tt-ext-file.
     1173     ASSIGN
     1174     buf_tt-ext-file.FILE-NAME = v-full-path
     1175     buf_tt-ext-file.FILE-NAME-exec = v-full-path2
     1176     buf_tt-ext-file.file-num = 1
     1177     buf_tt-ext-file.create-sys-date      = file-info:FILE-mod-DATE
     1178     buf_tt-ext-file.create-sys-time      = STRING(file-info:FILE-mod-TIME, "HH:MM:SS")
     1179     buf_tt-ext-file.create-sys-time-INT  = file-info:FILE-mod-TIME
     1180     buf_tt-ext-file.update-sys-date      = v-today
     1181     buf_tt-ext-file.update-sys-time      = STRING(v-time, "HH:MM:SS")
     1182     buf_tt-ext-file.update-sys-time-INT  = v-time
     1183     buf_tt-ext-file.file-size            = FILE-INFO:FILE-SIZE
     1184     buf_tt-ext-file.crc-field            = v-md5-signature
     1185     buf_tt-ext-file.file-type            = p-file-type
     1186     .
     1187     release buf_tt-ext-file.
     1188     p-full-name = v-full-path.
     1189   end.
     1190   end procedure.
     1191   define stream bar.
     1192   define stream plucash.
     1193   define variable vss-include-info6 as character format "X(65)" no-undo
     1194   initial "@(#)$Workfile$ $Revision$".
     1195   define variable v-bgelib-bgefmt        as character         no-undo.
     1196   define variable v-bgelib-bgeflold      as character         no-undo.
     1197   define stream stmXMLOut.
     1198   define stream stmXMLLog.
     1199   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1200   define variable vss-include-info8 as character format "X(65)" no-undo
     1201   initial "@(#)$Workfile$ $Revision$".
     1202   procedure xmlchar-test :
     1203   define input parameter p-in-string          as character        no-undo.
     1204   define output parameter p-out-string-enc    as character        no-undo.
     1205   define output parameter p-out-string-dec    as character        no-undo.
     1206   do
     1207   on error undo, return error
     1208   :
     1209          run xmlchar-encode in this-procedure
     1210       (
     1211             input p-in-string
     1212           , output p-out-string-enc
     1213       ).
     1214          run xmlchar-decode in this-procedure
     1215       (
     1216             input p-out-string-enc
     1217           , output p-out-string-dec
     1218       ).
     1219   end.
     1220   end .
     1221   procedure xmlchar-encode :
     1222   define input parameter p-in-string      as character        no-undo.
     1223   define output parameter p-out-string    as character        no-undo.
     1224       define variable v-position      as integer      no-undo.
     1225       define variable v-current-char  as character    no-undo.
     1226   do
     1227   on error undo, return error
     1228   :
     1229       assign
     1230           p-out-string = "":U
     1231       .
     1232       case p-in-string
     1233       :
     1234           when ?
     1235           then do:
     1236               assign
     1237                   p-out-string = "?":U
     1238               .
     1239           end.
     1240           when "?":U
     1241           then do:
     1242               assign
     1243                   p-out-string = "&#63;":U
     1244               .
     1245           end.
     1246           otherwise do:
     1247               do v-position = 1 to length( p-in-string )
     1248               :
     1249                   assign
     1250                       v-current-char = substring( p-in-string, v-position, 1 )
     1251                   .
     1252                   case v-current-char
     1253                   :
     1254                       when "&":U
     1255                       then do:
     1256                           assign
     1257                               p-out-string = p-out-string + "&amp;":U
     1258                           .
     1259                       end.
     1260                       when ">":U
     1261                       then do:
     1262                           assign
     1263                               p-out-string = p-out-string + "&gt;":U
     1264                           .
     1265                       end.
     1266                       when "<":U
     1267                       then do:
     1268                           assign
     1269                               p-out-string = p-out-string + "&lt;":U
     1270                           .
     1271                       end.
     1272                       when "'":U
     1273                       then do:
     1274                           assign
     1275                               p-out-string = p-out-string + "&apos;":U
     1276                           .
     1277                       end.
     1278                       when '"':U
     1279                       then do:
     1280                           assign
     1281                               p-out-string = p-out-string + "&quot;":U
     1282                           .
     1283                       end.
     1284                       when chr(1)
     1285                       then do:
     1286                           assign
     1287                               p-out-string = p-out-string + "":U
     1288                           .
     1289                       end.
     1290                       when chr(2)
     1291                       then do:
     1292                           assign
     1293                               p-out-string = p-out-string + "":U
     1294                           .
     1295                       end.
     1296                       when chr(3)
     1297                       then do:
     1298                           assign
     1299                               p-out-string = p-out-string + "":U
     1300                           .
     1301                       end.
     1302                       when chr(4)
     1303                       then do:
     1304                           assign
     1305                               p-out-string = p-out-string + "":U
     1306                           .
     1307                       end.
     1308                       when chr(5)
     1309                       then do:
     1310                           assign
     1311                               p-out-string = p-out-string + "":U
     1312                           .
     1313                       end.
     1314                       when chr(6)
     1315                       then do:
     1316                           assign
     1317                               p-out-string = p-out-string + "":U
     1318                           .
     1319                       end.
     1320                       when chr(7)
     1321                       then do:
     1322                           assign
     1323                               p-out-string = p-out-string + "":U
     1324                           .
     1325                       end.
     1326                       when chr(8)
     1327                       then do:
     1328                           assign
     1329                               p-out-string = p-out-string + "":U
     1330                           .
     1331                       end.
     1332                       when chr(9)
     1333                       then do:
     1334                           assign
     1335                               p-out-string = p-out-string + "":U
     1336                           .
     1337                       end.
     1338                       when chr(29)
     1339                       then do:
     1340                           assign
     1341                               p-out-string = p-out-string + "":U
     1342                           .
     1343                       end.
     1344                       when chr(10)
     1345                       then do:
     1346                           assign
     1347                               p-out-string = p-out-string + "&#10;":U
     1348                           .
     1349                       end.
     1350                       when chr(13)
     1351                       then do:
     1352                           assign
     1353                               p-out-string = p-out-string + "&#13;":U
     1354                           .
     1355                       end.
     1356                       otherwise do:
     1357                           assign
     1358                               p-out-string = p-out-string + v-current-char
     1359                           .
     1360                       end.
     1361                   end case.
     1362               end.
     1363           end.
     1364       end case.
     1365   end.
     1366   end .
     1367   procedure xmlchar-encode-1c :
     1368   define input parameter p-in-string      as character        no-undo.
     1369   define output parameter p-out-string    as character        no-undo.
     1370       define variable v-position      as integer      no-undo.
     1371       define variable v-current-char  as character    no-undo.
     1372   do
     1373   on error undo, return error
     1374   :
     1375       assign
     1376           p-out-string = "":U
     1377       .
     1378       case p-in-string
     1379       :
     1380           when ?
     1381           then do:
     1382               assign
     1383                   p-out-string = "?":U
     1384               .
     1385           end.
     1386           otherwise do:
     1387               do v-position = 1 to length( p-in-string )
     1388               :
     1389                   assign
     1390                       v-current-char = substring( p-in-string, v-position, 1 )
     1391                   .
     1392                   case v-current-char
     1393                   :
     1394                       when chr(1)
     1395                       then do:
     1396                           assign
     1397                               p-out-string = p-out-string + " ":U
     1398                           .
     1399                       end.
     1400                       when chr(2)
     1401                       then do:
     1402                           assign
     1403                               p-out-string = p-out-string + " ":U
     1404                           .
     1405                       end.
     1406                       when chr(3)
     1407                       then do:
     1408                           assign
     1409                               p-out-string = p-out-string + " ":U
     1410                           .
     1411                       end.
     1412                       when chr(4)
     1413                       then do:
     1414                           assign
     1415                               p-out-string = p-out-string + " ":U
     1416                           .
     1417                       end.
     1418                       when chr(5)
     1419                       then do:
     1420                           assign
     1421                               p-out-string = p-out-string + " ":U
     1422                           .
     1423                       end.
     1424                       when chr(6)
     1425                       then do:
     1426                           assign
     1427                               p-out-string = p-out-string + " ":U
     1428                           .
     1429                       end.
     1430                       when chr(7)
     1431                       then do:
     1432                           assign
     1433                               p-out-string = p-out-string + " ":U
     1434                           .
     1435                       end.
     1436                       when chr(8)
     1437                       then do:
     1438                           assign
     1439                               p-out-string = p-out-string + " ":U
     1440                           .
     1441                       end.
     1442                       when chr(9)
     1443                       then do:
     1444                           assign
     1445                               p-out-string = p-out-string + " ":U
     1446                           .
     1447                       end.
     1448                       when chr(29)
     1449                       then do:
     1450                           assign
     1451                               p-out-string = p-out-string + " ":U
     1452                           .
     1453                       end.
     1454                       when chr(10)
     1455                       then do:
     1456                           assign
     1457                               p-out-string = p-out-string + " ":U
     1458                           .
     1459                       end.
     1460                       when chr(13)
     1461                       then do:
     1462                           assign
     1463                               p-out-string = p-out-string + " ":U
     1464                           .
     1465                       end.
     1466                       otherwise do:
     1467                           assign
     1468                               p-out-string = p-out-string + v-current-char
     1469                           .
     1470                       end.
     1471                   end case.
     1472               end.
     1473           end.
     1474       end case.
     1475   end.
     1476   end .
     1477   procedure xmlchar-decode :
     1478   define input parameter p-in-string      as character        no-undo.
     1479   define output parameter p-out-string    as character        no-undo.
     1480       define variable v-position      as integer      no-undo.
     1481       define variable v-last-position as integer      no-undo.
     1482       define variable v-temp-integer  as integer      no-undo.
     1483       define variable v-current-char  as character    no-undo.
     1484       define variable v-next-char     as character    no-undo.
     1485       define variable v-success       as logical      no-undo.
     1486   do
     1487   on error undo, return error
     1488   :
     1489       assign
     1490           p-out-string = "":U
     1491           v-position   = 0
     1492       .
     1493       replace-cycle:
     1494       do while yes
     1495       on error undo, return error
     1496       :
     1497           assign
     1498               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1499           .
     1500           if v-last-position <= v-position
     1501           then do:
     1502               if v-position = 0
     1503               then do:
     1504                   assign
     1505                       p-out-string = p-in-string
     1506                   .
     1507               end.
     1508               else do:
     1509                   assign
     1510                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1511                   .
     1512               end.
     1513               leave replace-cycle.
     1514           end.
     1515           else do:
     1516               assign
     1517                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1518                   v-position      = v-last-position
     1519                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1520               .
     1521               if v-current-char = "#":U
     1522               then do:
     1523                   assign
     1524                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1525                   .
     1526                   if v-last-position > 0
     1527                   then do:
     1528                       run xmlchar-read-integer in this-procedure
     1529                        (
     1530                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1531                           , output v-temp-integer
     1532                           , output v-success
     1533                       ).
     1534                       if v-success = yes
     1535                       and v-temp-integer >= 1
     1536                       and v-temp-integer <= 255
     1537                       then do:
     1538                           assign
     1539                               p-out-string = p-out-string + chr( v-temp-integer )
     1540                               v-position   = v-last-position + 1
     1541                           .
     1542                       end.
     1543                       else do:
     1544                           assign
     1545                               p-out-string = p-out-string + "&":U
     1546                               v-position   = v-position   + 1
     1547                           .
     1548                       end.
     1549                   end.
     1550                   else do:
     1551                       assign
     1552                           p-out-string = p-out-string + "&":U
     1553                           v-position   = v-position   + 1
     1554                       .
     1555                   end.
     1556               end.
     1557               else do:
     1558                   case substring( p-in-string, v-position + 1, 3 )
     1559                   :
     1560                       when "lt;":U
     1561                       then do:
     1562                           assign
     1563                               p-out-string = p-out-string + "<":U
     1564                               v-position   = v-position   + 3
     1565                           .
     1566                       end.
     1567                       when "gt;":U
     1568                       then do:
     1569                           assign
     1570                               p-out-string = p-out-string + ">":U
     1571                               v-position   = v-position   + 3
     1572                           .
     1573                       end.
     1574                       otherwise do:
     1575                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1576                           then do:
     1577                               assign
     1578                                   p-out-string = p-out-string + "&":U
     1579                                   v-position   = v-position   + 4
     1580                               .
     1581                           end.
     1582                           else do:
     1583                               case substring( p-in-string, v-position + 1, 5 )
     1584                               :
     1585                                   when "quot;":U
     1586                                   then do:
     1587                                       assign
     1588                                           p-out-string = p-out-string + '"':U
     1589                                           v-position   = v-position   + 5
     1590                                       .
     1591                                   end.
     1592                                   when "apos;":U
     1593                                   then do:
     1594                                       assign
     1595                                           p-out-string = p-out-string + "'":U
     1596                                           v-position   = v-position   + 5
     1597                                       .
     1598                                   end.
     1599                                   otherwise do:
     1600                                       assign
     1601                                           p-out-string = p-out-string + "&":U
     1602                                       .
     1603                                   end.
     1604                               end case.
     1605                           end.
     1606                       end.
     1607                   end case.
     1608               end.
     1609           end.
     1610       end.
     1611   end.
     1612   end .
     1613   procedure xmlchar-read-integer :
     1614   define input parameter p-input-string      as character        no-undo.
     1615   define output parameter p-output-integer   as integer          no-undo.
     1616   define output parameter p-success       as logical          no-undo.
     1617   do
     1618   on error undo, return error
     1619   :
     1620       assign
     1621           p-output-integer = integer( p-input-string )
     1622       no-error.
     1623       if error-status :error
     1624       then do:
     1625           assign
     1626               p-success           = no
     1627               p-output-integer    = 0
     1628           .
     1629       end.
     1630       else do:
     1631           assign
     1632               p-success           = yes
     1633           .
     1634       end.
     1635   end.
     1636   end.
     1637   define variable v-bgelib-bgeclall           as logical      no-undo.
     1638   define variable v-bgelib-bgedict            as logical      no-undo.
     1639   define temp-table temp_ext-doc-type no-undo
     1640       field edt-key               as integer
     1641       field ext-doc-type          as character
     1642       field ext-doc-type-label    as character
     1643       index pi is primary unique
     1644           edt-key
     1645   .
     1646   define temp-table temp_bgelib_goods no-undo
     1647       field gds-code as integer
     1648       index pi is primary unique
     1649           gds-code
     1650   .
     1651   define temp-table temp_bgelib_clients no-undo
     1652       field obj-type as character
     1653       field obj-code as integer
     1654       index pi is primary unique
     1655           obj-type
     1656           obj-code
     1657   .
     1658   define temp-table temp_bgelib_dis-card no-undo
     1659       field d-card as character
     1660       index pi is primary unique
     1661           d-card
     1662   .
     1663   define temp-table temp_bgelib_trn-doc no-undo
     1664       field doc-code as integer
     1665   .
     1666   procedure bgelib-tag-open:
     1667   do
     1668   on error undo, return error
     1669   :
     1670   define input parameter v-tag-level  as integer      no-undo.
     1671   define input parameter v-tag-name   as character    no-undo.
     1672   define input parameter v-tag-value  as character    no-undo.
     1673       put stream stmXMLOut unformatted
     1674           chr(10)
     1675           + fill(" ", 4 * v-tag-level)
     1676           + "<" + v-tag-name
     1677           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
     1678           + v-tag-value + ">"
     1679       .
     1680   end.
     1681   end procedure.
     1682   procedure bgelib-tag-put:
     1683   do
     1684   on error undo, return error
     1685   :
     1686   define input parameter v-tag-level      as integer      no-undo.
     1687   define input parameter v-tag-name       as character    no-undo.
     1688   define input parameter v-tag-value      as character    no-undo.
     1689   define input parameter v-empty-mode     as integer      no-undo.
     1690       v-tag-name = trim(v-tag-name).
     1691       if  v-empty-mode = 1
     1692       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
     1693       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
     1694       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
     1695       then do:
     1696           run xmlchar-encode in this-procedure (
     1697                 input v-tag-value
     1698               , output v-tag-value
     1699           ).
     1700           put stream stmXMLOut unformatted
     1701               chr(10) + fill(" ", 4 * v-tag-level)
     1702                           + '<' + v-tag-name + '>'
     1703                           + v-tag-value
     1704                           + '</' + v-tag-name + '>'
     1705           .
     1706       end.
     1707   end.
     1708   end procedure.
     1709   procedure bgelib-tag-close:
     1710   do
     1711   on error undo, return error
     1712   :
     1713   define input parameter v-tag-level as integer      no-undo.
     1714   define input parameter v-tag-name  as character    no-undo.
     1715       put stream stmXMLOut unformatted
     1716           chr(10)
     1717           + fill( " ", 4 * v-tag-level)
     1718           + '</' + v-tag-name + '>'
     1719       .
     1720   end.
     1721   end procedure.
     1722   procedure bgelib-write-log:
     1723   do
     1724   on error undo, return error
     1725   :
     1726   define input parameter v-filename   as character    no-undo.
     1727   define input parameter v-log-level  as integer      no-undo.
     1728   define input parameter v-out-string as character    no-undo.
     1729       output stream stmXMLLog to value( v-filename ) append.
     1730       put stream stmXMLLog unformatted
     1731           chr(10)
     1732       .
     1733       put stream stmXMLLog unformatted
     1734           ( if v-log-level = 0
     1735             or v-out-string = "&DLine"
     1736             or v-out-string = "&Line"
     1737             then ""
     1738             else cur-time-string-sec() + " " )
     1739       .
     1740       put stream stmXMLLog unformatted
     1741           ( if v-out-string = "&Line"
     1742             then fill( "-", 80 )
     1743             else if v-out-string = "&DLine"
     1744                  then fill( "=", 80 )
     1745                  else v-out-string )
     1746       .
     1747       output stream stmXMLLog close.
     1748   end.
     1749   end procedure.
     1750   procedure bgelib-write-edt:
     1751   do
     1752   on error undo, return error
     1753   :
     1754   define input parameter v-editor-handle    as handle       no-undo.
     1755   define input parameter v-log-level        as integer      no-undo.
     1756   define input parameter v-out-string       as character    no-undo.
     1757       if valid-handle ( v-editor-handle )
     1758       then do:
     1759           v-editor-handle :move-to-eof().
     1760           v-editor-handle :insert-string( ( if v-log-level = 0
     1761                                             or v-out-string = "&DLine"
     1762                                             or v-out-string = "&Line"
     1763                                             then ""
     1764                                             else cur-time-string-sec() + " "
     1765                                         ) ).
     1766           v-editor-handle :insert-string( ( if v-out-string = "&Line"
     1767                                             then fill( "-", 80 )
     1768                                             else if v-out-string = "&DLine" then fill("=", 80)
     1769                                             else fill( " ", v-log-level) + v-out-string
     1770                                         ) ).
     1771           v-editor-handle :insert-string( chr(10) ).
     1772       end.
     1773       process events.
     1774       output to 'bgescn.txt' append.
     1775           put unformatted
     1776               chr(10)
     1777               string( ( if v-log-level = 0
     1778                         or v-out-string = "&DLine"
     1779                         or v-out-string = "&Line"
     1780                         then ""
     1781                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
     1782                     ) )
     1783               string( ( if v-out-string = "&Line"
     1784                         then fill( "-", 80 )
     1785                         else if v-out-string = "&DLine"
     1786                              then fill( "=", 80 )
     1787                              else fill( " ", v-log-level ) + v-out-string
     1788                     ) )
     1789           .
     1790       output close.
     1791   end.
     1792   end procedure.
     1793   procedure bgelib-show-cnt:
     1794   do
     1795   on error undo, return error
     1796   :
     1797   define input parameter v-fillin-handle     as handle   no-undo.
     1798       if valid-handle( v-fillin-handle )
     1799       then do:
     1800           assign
     1801               v-fillin-handle :visible = true
     1802           .
     1803       end.
     1804   end.
     1805   end procedure.
     1806   procedure bgelib-hide-cnt:
     1807   do
     1808   on error undo, return error
     1809   :
     1810   define input parameter v-fillin-handle     as handle   no-undo.
     1811       if valid-handle( v-fillin-handle )
     1812       then do:
     1813           assign v-fillin-handle :visible = false.
     1814       end.
     1815   end.
     1816   end procedure.
     1817   procedure bgelib-write-cnt:
     1818   do
     1819   on error undo, return error
     1820   :
     1821   define input parameter v-fillin-handle    as handle       no-undo.
     1822   define input parameter v-fillin-string    as character    no-undo.
     1823       if valid-handle( v-fillin-handle )
     1824       then do:
     1825           assign
     1826               v-fillin-handle :SCREEN-value = v-fillin-string
     1827           .
     1828       end.
     1829   end.
     1830   end procedure.
     1831   procedure bgelib-write-header:
     1832   do
     1833   on error undo, return error
     1834   :
     1835   define input parameter p-first-file     as logical      no-undo.
     1836   define input parameter p-xml-file-name  as character    no-undo.
     1837   define input parameter p-list-file-name as character    no-undo.
     1838   define input parameter p-file-number    as integer      no-undo.
     1839   define input parameter p-have-prev      as logical      no-undo.
     1840   define input parameter p-prev-filename  as character    no-undo.
     1841   define input parameter p-obj-list       as character    no-undo.
     1842   define input parameter p-doc-type-list  as character    no-undo.
     1843   define input parameter p-parameter-list as character    no-undo.
     1844       define variable v-counter    as integer        no-undo.
     1845       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1846       put stream stmXMLOut unformatted
     1847           "<?xml version='1.0' encoding='windows-1251'?>"
     1848       .
     1849       run bgelib-tag-open( input 0, input "root"  , input "" ).
     1850       run bgelib-tag-open( input 0, input "header", input "" ).
     1851       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1852       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1853       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1854       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1855       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     1856       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1857       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1858       :
     1859           run bgelib-tag-put(
     1860                 input 1
     1861               , input entry( 2 * v-counter, p-parameter-list )
     1862               , input entry( 2 * v-counter + 1, p-parameter-list )
     1863               , input 0
     1864           ).
     1865       end.
     1866       run bgelib-tag-close( input 0, input "header" ).
     1867       output stream stmXMLOut close.
     1868       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1869       if p-first-file = yes
     1870       then do:
     1871           put stream stmXMLOut unformatted
     1872               "<?xml version='1.0' encoding='windows-1251'?>"
     1873           .
     1874           run bgelib-tag-open( input 0, input "export", input "" ).
     1875       end.
     1876       run bgelib-tag-open( input 1, input "file", input "" ).
     1877       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1878       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1879       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1880       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1881       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1882       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1883       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1884       :
     1885           run bgelib-tag-put(
     1886                 input 2
     1887               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1888               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1889               , input 0
     1890           ).
     1891       end.
     1892       run bgelib-tag-close( input 1, input "file" ).
     1893       output stream stmXMLOut close.
     1894   end.
     1895   end procedure.
     1896   procedure bgelib-write-footer:
     1897   do
     1898   on error undo, return error
     1899   :
     1900   define input parameter p-last-file      as logical      no-undo.
     1901   define input parameter p-xml-file-name  as character    no-undo.
     1902   define input parameter p-list-file-name as character    no-undo.
     1903   define input parameter p-have-next      as logical      no-undo.
     1904   define input parameter p-next-file-name as character    no-undo.
     1905       define variable v-error-num     as integer           no-undo.
     1906       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1907       if p-have-next = yes
     1908       then do:
     1909           run bgelib-tag-open( input 0, input "footer", "" ).
     1910           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1911           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1912           run bgelib-tag-close( input 0, input "footer" ).
     1913       end.
     1914       run bgelib-tag-close( input 0, input "root" ).
     1915       output stream stmXMLOut close.
     1916       run bge/os_copy.p (
     1917             input "M"
     1918           , input p-xml-file-name + "tmp"
     1919           , input p-xml-file-name + "xml"
     1920           , output v-error-num
     1921       ).
     1922       if p-last-file = yes
     1923       then do:
     1924           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1925               run bgelib-tag-close( input 0, input "export" ).
     1926           output stream stmXMLOut close.
     1927           run bge/os_copy.p (
     1928                 input "M"
     1929               , input p-list-file-name + "tmp"
     1930               , input p-list-file-name + "xml"
     1931               , output v-error-num
     1932           ).
     1933       end.
     1934   end.
     1935   end procedure.
     1936   procedure bgelib-filename :
     1937   do
     1938   on error undo, return error
     1939   :
     1940   define input parameter p-prefix             as character    no-undo.
     1941   define output parameter p-xml-file-name     as character    no-undo.
     1942   define output parameter p-log-file-name     as character    no-undo.
     1943   define output parameter p-list-file-name    as character    no-undo.
     1944       define variable v-home-dir  as character    no-undo.
     1945       define variable v-error-num as integer      no-undo.
     1946       get-key-value section "BGE" key "outdir" value v-home-dir.
     1947       if v-home-dir = ?
     1948       then do:
     1949           message
     1950             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1951             skip(1)
     1952             skip "Обратитесь к администратору."
     1953           view-as alert-box error.
     1954           undo, return error .
     1955       end.
     1956       run gbl/dir-cre.p (
     1957           input v-home-dir
     1958       ) no-error.
     1959       if error-status :error
     1960       then do:
     1961           message
     1962             skip "Неверно задан каталог экспорта."
     1963             skip(1)
     1964             skip "Обратитесь к администратору."
     1965           view-as alert-box error.
     1966           undo, return error .
     1967       end.
     1968       run bge/genfname.p (
     1969             input v-home-dir
     1970           , input p-prefix
     1971           , input ""
     1972           , input "xml"
     1973           , input "tmp"
     1974           , output p-xml-file-name
     1975       ).
     1976       assign
     1977           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1978           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1979           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1980       .
     1981   end.
     1982   end procedure.
     1983   procedure bgelib-read-config :
     1984   do
     1985   on error undo, return error
     1986   :
     1987   define variable v-par-type as character     no-undo.
     1988     define variable v-param-type      as character  no-undo .
     1989     define variable v-value-character as character  no-undo .
     1990     define variable v-value-date      as date       no-undo .
     1991     define variable v-value-decimal   as decimal    no-undo .
     1992     define variable v-value-integer   as integer    no-undo .
     1993     define variable v-value-logical   as logical    no-undo .
     1994     define variable v-tth             as handle     no-undo .
     1995       assign
     1996           v-bgelib-bgeclall = no
     1997           v-bgelib-bgedict  = no
     1998       .
     1999       run adm/shattri.p ( input "get":U
     2000                         , input  '':u
     2001                         , input  0
     2002                         , input  'bge-export':U
     2003                         , input  'bgeclall':U
     2004                         , output v-value-character
     2005                         , output v-value-date
     2006                         , output v-value-decimal
     2007                         , output v-value-integer
     2008                         , output v-value-logical
     2009                         , output v-param-type
     2010                         , input-output table-handle v-tth
     2011                         ) no-error .
     2012       if error-status :error
     2013       then do:
     2014         assign
     2015           v-bgelib-bgeclall = no
     2016         .
     2017       end.
     2018       else do:
     2019         assign
     2020           v-bgelib-bgeclall = v-value-logical
     2021         .
     2022       end.
     2023       delete object v-tth.
     2024       run adm/shattri.p ( input "get":U
     2025                         , input  '':u
     2026                         , input  0
     2027                         , input  'bge-export':U
     2028                         , input  'bgedict':U
     2029                         , output v-value-character
     2030                         , output v-value-date
     2031                         , output v-value-decimal
     2032                         , output v-value-integer
     2033                         , output v-value-logical
     2034                         , output v-param-type
     2035                         , input-output table-handle v-tth
     2036                         ) no-error .
     2037       if error-status :error
     2038       then do:
     2039         assign
     2040           v-bgelib-bgedict = no
     2041         .
     2042       end.
     2043       else do:
     2044         assign
     2045           v-bgelib-bgedict = v-value-logical
     2046         .
     2047       end.
     2048       delete object v-tth.
     2049       run adm/shattri.p ( input "get":U
     2050                         , input  '':u
     2051                         , input  0
     2052                         , input  'bge-export':U
     2053                         , input  'bgefmt':U
     2054                         , output v-value-character
     2055                         , output v-value-date
     2056                         , output v-value-decimal
     2057                         , output v-value-integer
     2058                         , output v-value-logical
     2059                         , output v-param-type
     2060                         , input-output table-handle v-tth
     2061                         ) no-error .
     2062       if error-status :error
     2063       then do:
     2064         assign
     2065           v-bgelib-bgefmt  = "xml":U
     2066         .
     2067       end.
     2068       else do:
     2069         assign
     2070           v-bgelib-bgefmt  = v-value-character
     2071         .
     2072       end.
     2073       delete object v-tth.
     2074       run adm/shattri.p ( input "get":U
     2075                         , input  '':u
     2076                         , input  0
     2077                         , input  'bge-export':U
     2078                         , input  'bgeflold':U
     2079                         , output v-value-character
     2080                         , output v-value-date
     2081                         , output v-value-decimal
     2082                         , output v-value-integer
     2083                         , output v-value-logical
     2084                         , output v-param-type
     2085                         , input-output table-handle v-tth
     2086                         ) no-error .
     2087       if error-status :error
     2088       then do:
     2089         assign
     2090           v-bgelib-bgeflold  = "old":U
     2091         .
     2092       end.
     2093       else do:
     2094         assign
     2095           v-bgelib-bgeflold  = v-value-character
     2096         .
     2097       end.
     2098       delete object v-tth.
     2099   end.
     2100   end procedure.
     2101   procedure bgelib-check-file-size :
     2102   do
     2103   on error undo, return error
     2104   :
     2105   define input parameter p-out-filename   as character    no-undo.
     2106   define output parameter p-is-big        as logical      no-undo.
     2107       define variable v-current-position    as integer        no-undo.
     2108       assign
     2109           v-current-position = seek( stmXMLOut )
     2110       .
     2111       if v-current-position / 1024 / 1024  >= 100
     2112       then do:
     2113           assign
     2114               p-is-big = yes
     2115           .
     2116       end.
     2117   end.
     2118   end procedure.
     2119   procedure bgelib-init-ext-doc-type :
     2120       define variable v-counter    as integer      no-undo.
     2121       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2122   do
     2123   for buf_temp_ext-doc-type
     2124   on error undo, return error
     2125   :
     2126       empty temp-table buf_temp_ext-doc-type.
     2127       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2128       :
     2129           create buf_temp_ext-doc-type.
     2130           assign
     2131               buf_temp_ext-doc-type.edt-key               = v-counter
     2132               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2133               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2134           .
     2135       end.
     2136   end.
     2137   end procedure.
     2138   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2139   define variable v-xml-file-name     as character            no-undo.
     2140   define variable v-xml-file-name-path as character            no-undo.
     2141   define variable v-log-file-name     as character            no-undo.
