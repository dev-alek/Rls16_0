     2150   procedure xml-cd-write-header:
     2151   do
     2152   on error undo, return error
     2153   :
     2154   define input parameter p-xml-file-name       as character    no-undo.
     2155   define input parameter p-xml-file-name-path  as character    no-undo.
     2156   define input parameter p-doc-name            as character    no-undo.
     2157   define input parameter p-version             as character    no-undo.
     2158   define input parameter p-obj-list            as character    no-undo.
     2159   define input parameter p-correspondent       as character    no-undo .
     2160   define input parameter p-write-header        as logical      no-undo .
     2161   define variable OS-time as character no-undo .
     2162   define variable id as character no-undo .
     2163   define buffer buf_db for ub.db.
     2164   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     2165   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     2166   assign
     2167   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     2168   .
     2169   run bgelib-tag-open in this-procedure (
     2170                                        1
     2171                                       ,p-doc-name
     2172                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     2173                                         ).
     2174   if p-write-header then do:
     2175     run bgelib-tag-open(2, "Header","").
     2176     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     2177     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     2178     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     2179     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     2180     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     2181     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     2182     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     2183     find first buf_db where buf_db.db-num = g#db-num no-lock.
     2184     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     2185     run bgelib-tag-close( 2, "Header" ).
     2186   end.
     2187   output stream stmXMLOut close.
     2188   end.
     2189   end procedure.
     2190   procedure xml-cd-write-footer:
     2191   do
     2192   on error undo, return error
     2193   :
     2194   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     2195   define input parameter p-xml-file-name as character    no-undo.
     2196   define input parameter p-doc-name      as character    no-undo .
     2197   define variable v-error-num     as integer           no-undo.
     2198   define variable v-md5-signature as character no-undo .
     2199   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     2200   run bgelib-tag-close( 0, p-doc-name ).
     2201   put stream stmXMLOut unformatted skip.
     2202   output stream stmXMLOut close.
     2203   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     2204   if v-error-num > 0
     2205   then do:
     2206      return error.
     2207   end.
     2208   if opsys = "unix"
     2209   then do:
     2210       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     2211   end.
     2212   end.
     2213   end procedure.
     2214   procedure xml-cd-filename :
     2215   do
     2216   on error undo, return error
     2217   :
     2218   define input parameter  p-out               as character no-undo .
     2219   define output parameter p-xml-file-name     as character    no-undo.
     2220   define output parameter p-xml-file-name-path   as character    no-undo.
     2221   define output parameter p-log-file-name     as character    no-undo.
     2222   define output parameter p-locked            as logical      no-undo.
     2223   define variable v-out as character     no-undo.
     2224   define variable loc#log as logical no-undo .
     2225   define variable BadFlag as logical no-undo .
     2226   define variable fq as integer no-undo .
     2227   define variable v-remote as character no-undo .
     2228   assign
     2229   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     2230   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     2231   p-log-file-name = p-out + "actions.log"
     2232   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     2233   .
     2234   end.
     2235   end procedure.
     2236   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     2237   define variable v-date-str as character no-undo .
     2238   assign
     2239   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     2240                string(Month(p-date), "99":U) + "-":U +
     2241                string(DAY(p-date), "99":U).
     2242   return v-date-str.
     2243   END FUNCTION.
     2244   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     2245   define variable v-date-str as character no-undo .
     2246   assign
     2247   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     2248                string(Month(p-date), "99":U) + "-":U +
     2249                string(DAY(p-date), "99":U) + chr(32) +
     2250                string(p-time, "HH:MM:SS").
     2251   return v-date-str.
     2252   END FUNCTION.
     2253   function string-to-date returns date ( input p-string  as character):
     2254     define variable v-date as date no-undo .
     2255     assign
     2256     v-date = date(integer(substring(p-string, 4, 2))
     2257                   ,integer(substring(p-string, 1, 2))
     2258                   ,integer(substring(p-string, 7, 4))
     2259                  ) no-error .
     2260     if error-status:error then return ?.
     2261     return v-date.
     2262   END FUNCTION.
     2263   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     2264   define variable v-time as integer no-undo init ?.
     2265   define variable v-dop1 as character no-undo .
     2266   define variable v-dop2 as character no-undo .
     2267   assign
     2268   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     2269   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     2270   no-error .
     2271   if error-status:error then return ?.
     2272   assign
     2273   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     2274             integer(entry(2, v-dop2, ";":U)) * 60 +
     2275             integer(entry(3, v-dop2, ";":U)) no-error .
     2276   return v-time.
     2277   END FUNCTION.
