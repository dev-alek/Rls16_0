        1   define input  parameter parParentProc  as widget-handle no-undo.
        2   define input  parameter p-user-id      as character no-undo .
        3   define input  parameter p-mode         as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      115   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      116   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      117   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      118   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      119   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      120   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      121   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      122   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      123   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      124   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      125   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      126   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      127   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      128   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      129   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      130   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      131   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      132     define variable v-cntxt-db-num        as integer   no-undo .
      133     define variable v-cntxt-userid        as character no-undo .
      134     define variable v-cntxt-level         as character no-undo .
      135     define variable v-cntxt-host-code-obj as integer   no-undo .
      136     define variable v-cntxt-obj-type      as character no-undo .
      137     define variable v-cntxt-obj-code      as integer   no-undo .
      138     define variable v-cntxt-db-num-obj    as integer   no-undo .
      139     define variable v-cntxt-is-admin      as logical   no-undo .
      140   define variable v-user-id as character no-undo .
      141   DEFINE BUTTON b-exit AUTO-GO
      142        LABEL "&Ввод"
      143        SIZE 10 BY 1
      144        BGCOLOR 8 .
      145   DEFINE BUTTON b-help
      146        LABEL "Помо&щь"
      147        SIZE 10 BY 1
      148        BGCOLOR 8 .
      149   DEFINE BUTTON b-quit AUTO-END-KEY
      150        LABEL "&Отмена"
      151        SIZE 10 BY 1
      152        BGCOLOR 8 .
      153   DEFINE VARIABLE fi-company LIKE ub.user-account.company
      154        VIEW-AS FILL-IN
      155        SIZE 33 BY 1 NO-UNDO.
      156   DEFINE VARIABLE fi-department LIKE ub.user-account.department
      157        VIEW-AS FILL-IN
      158        SIZE 33 BY 1 NO-UNDO.
      159   DEFINE VARIABLE fi-e-mail LIKE ub.user-account.e-mail
      160        VIEW-AS FILL-IN
      161        SIZE 33 BY 1 NO-UNDO.
      162   DEFINE VARIABLE fi-first-name LIKE ub.user-account.first-name
      163        VIEW-AS FILL-IN
      164        SIZE 33 BY 1 NO-UNDO.
      165   DEFINE VARIABLE fi-internal-phone-number LIKE ub.user-account.internal-phone-number
      166        VIEW-AS FILL-IN
      167        SIZE 33 BY 1 NO-UNDO.
      168   DEFINE VARIABLE fi-last-name LIKE ub.user-account.last-name
      169        VIEW-AS FILL-IN
      170        SIZE 33 BY 1 NO-UNDO.
      171   DEFINE VARIABLE fi-mobile-phone-number LIKE ub.user-account.mobile-phone-number
      172        VIEW-AS FILL-IN
      173        SIZE 33 BY 1 NO-UNDO.
      174   DEFINE VARIABLE fi-phone-number LIKE ub.user-account.phone-number
      175        VIEW-AS FILL-IN
      176        SIZE 33 BY 1 NO-UNDO.
      177   DEFINE VARIABLE fi-position LIKE ub.user-account.position
      178        VIEW-AS FILL-IN
      179        SIZE 33 BY 1 NO-UNDO.
      180   DEFINE VARIABLE fi-room LIKE ub.user-account.room
      181        VIEW-AS FILL-IN
      182        SIZE 33 BY 1 NO-UNDO.
      183   DEFINE VARIABLE fi-second-name LIKE ub.user-account.second-name
      184        VIEW-AS FILL-IN
      185        SIZE 33 BY 1 NO-UNDO.
      186   DEFINE VARIABLE fi-user-id AS CHARACTER FORMAT "X(15)":U
      187        LABEL "Пользователь"
      188         VIEW-AS TEXT
      189        SIZE 16.5 BY .67
      190        FGCOLOR 4  NO-UNDO.
      191   DEFINE FRAME Dialog-Frame
      192        b-exit AT ROW 1 COL 1
      193        b-quit AT ROW 1 COL 11
      194        b-help AT ROW 1 COL 81
      195        fi-last-name AT ROW 4 COL 22 COLON-ALIGNED HELP
      196             "" WIDGET-ID 4
      197        fi-first-name AT ROW 5.27 COL 22 COLON-ALIGNED HELP
      198             "" WIDGET-ID 10
      199        fi-second-name AT ROW 6.77 COL 22 COLON-ALIGNED HELP
      200             "" WIDGET-ID 8
      201        fi-position AT ROW 8.27 COL 22 COLON-ALIGNED HELP
      202             "" WIDGET-ID 12
      203        fi-room AT ROW 9.77 COL 22 COLON-ALIGNED HELP
      204             "" WIDGET-ID 14
      205        fi-company AT ROW 11 COL 22 COLON-ALIGNED HELP
      206             "" WIDGET-ID 16
      207        fi-department AT ROW 12.27 COL 22 COLON-ALIGNED HELP
      208             "" WIDGET-ID 18
      209        fi-e-mail AT ROW 13.5 COL 22 COLON-ALIGNED HELP
      210             "" WIDGET-ID 20
      211        fi-phone-number AT ROW 14.77 COL 22 COLON-ALIGNED HELP
      212             "" WIDGET-ID 22
      213        fi-internal-phone-number AT ROW 16 COL 22 COLON-ALIGNED HELP
      214             "" WIDGET-ID 24
      215        fi-mobile-phone-number AT ROW 17.5 COL 22 COLON-ALIGNED HELP
      216             "" WIDGET-ID 26
      217        fi-user-id AT ROW 2.77 COL 22 COLON-ALIGNED WIDGET-ID 2
      218        SPACE(59.37) SKIP(16.38)
      219       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      220            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      221            TITLE "Редактирование пользователя"
      222            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit WIDGET-ID 100.
      223   ASSIGN
      224          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      225          FRAME Dialog-Frame:HIDDEN           = TRUE.
      226   ON GO OF FRAME Dialog-Frame
      227   DO:
      228     IF v-user-id = "":U THEN DO
      229     ON ERROR UNDO, RETURN NO-APPLY
      230     :
      231        if error-status :error
      232        then do:
      233          message
      234            vss-workfile vss-revision vss-description skip
      235            "Ошибка при вызове процедуры" 'str/usracccr.p':U skip
      236            error-status :get-message(1) skip
      237            return-value skip
      238            view-as alert-box error .
      239          undo, return no-apply .
      240        end.
      241     END.
      242     run update-info in this-procedure
      243       no-error .
      244     if error-status :error
      245     then do:
      246       undo, return no-apply .
      247     end.
      248   END.
      249   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      250   DO:
      251     APPLY "END-ERROR":U TO SELF.
      252   END.
      253   ON LEAVE OF fi-last-name IN FRAME Dialog-Frame
      254   DO:
      255     IF fi-last-name :SCREEN-VALUE = "":U
      256     OR fi-last-name :SCREEN-VALUE = ?
      257     THEN DO:
      258        MESSAGE "Введите фамилию"
      259        VIEW-AS ALERT-BOX.
      260        RETURN NO-APPLY.
      261     END.
      262   END.
      263   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      264   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      265   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      266   on help of frame Dialog-Frame
      267   do:
      268     run gbl/app_help.p
      269       (input this-procedure :file-name
      270       ,input ''
      271       ,input ?
      272       ) no-error.
      273     if error-status :error then do:
      274       message
      275         "Ошибка при вызове помощи"
      276         error-status :get-message(1)
      277         view-as alert-box .
      278     end.
      279   end.
      280   run minbtn-set in this-procedure .
      281   on choose of b-help in frame Dialog-Frame
      282   do:
      283     apply "help":u to frame Dialog-Frame .
      284   end.
      285   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      286   procedure minbtn-set :
      287       do
      288           on error undo, return error return-value
      289           :
      290           define variable ii              as integer       no-undo .
      291           define variable fh              as widget-handle no-undo .
      292           define variable hh              as widget-handle no-undo .
      293           define variable v-h             as handle        extent 4 no-undo .
      294           define variable v-name-button   as character     no-undo .
      295           define variable v-help-old-x    as decimal       no-undo .
      296           define variable v-help-old-y    as decimal       no-undo .
      297           define variable v-help-old-size as decimal       no-undo .
      298           define variable v-frame-width   as decimal       no-undo .
      299           define variable jj              as integer       no-undo .
      300           do
      301               on error undo, return error
      302               :
      303               assign
      304                   v-frame-width = frame Dialog-Frame:width - 0.3
      305                   fh            = frame Dialog-Frame:first-child
      306                   hh            = fh:first-child
      307                   ii            = 1
      308                   .
      309               do while valid-handle(hh):
      310                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      311                   do:
      312                       case lc(hh:name) :
      313                           when "b-help" then
      314                               do:
      315                                   hh:load-image-up("cmp/b-help.bmp":u) .
      316                                   hh:load-image-down("cmp/b-help.bmp":u) .
      317                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      318                                   hh:TOOLTIP = "Помощь" .
      319                                   v-help-old-x = hh:column .
      320                                   v-help-old-y = hh:row    .
      321                                   v-help-old-size = hh:width .
      322                                   hh:width-chars = 2.5 .
      323                               end.
      324                           when "b-print" then
      325                               do:
      326                                   hh:load-image("cmp/b-print.bmp":u) .
      327                                   hh:TOOLTIP = "Печать" .
      328                                   v-h[ii] = hh:handle .
      329                                   ii = ii + 1 .
      330                                   hh:width-chars = 3 .
      331                               end.
      332                           when "b-history" or
      333                           when "b-hist" then
      334                               do:
      335                                   hh:load-image("cmp/b-hist.bmp":u) .
      336                                   hh:TOOLTIP = "История" .
      337                                   v-h[ii] = hh:handle .
      338                                   ii = ii + 1 .
      339                                   hh:width-chars = 3 .
      340                               end.
      341                           when "b-sch" then
      342                               do:
      343                                   hh:load-image("cmp/b-sch.bmp":u) .
      344                                   hh:TOOLTIP = "Установка Фильтра" .
      345                                   v-h[ii] = hh:handle .
      346                                   ii = ii + 1 .
      347                                   hh:width-chars = 3 .
      348                               end.
      349                           when "b-hist-user" then
      350                               do:
      351                                   hh:load-image("cmp/b-hist.bmp":u) .
      352                                   hh:TOOLTIP = "История пользователя" .
      353                                   ii = ii + 1 .
      354                               end.
      355                       end case.
      356                   end.
      357                   hh = hh:next-sibling.
      358               end.
      359               b-help:column = v-frame-width - b-help:width-chars.
      360               jj = 0.
      361               repeat ii = 4 to 1 by -1 :
      362                   if valid-handle (v-h[ii] ) then
      363                   do:
      364                       jj  = jj + 1 .
      365                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      366                       v-h[ii]:row    = v-help-old-y .
      367                   end.
      368               end.
      369           end.
      370       end.
      371   end procedure.
      372   MAIN-BLOCK:
      373   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      374      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      375   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376     run mainmenu_getcntxt in parparentproc
      377       (output v-cntxt-db-num
      378       ,output v-cntxt-userid
      379       ,output v-cntxt-level
      380       ,output v-cntxt-host-code-obj
      381       ,output v-cntxt-obj-type
      382       ,output v-cntxt-obj-code
      383       ,output v-cntxt-db-num-obj
      384       ,output v-cntxt-is-admin
      385       ) .
      386     ASSIGN
      387        v-user-id = p-user-id
      388     .
      389     define buffer buf_lock_user-account for ub.user-account .
      390     case p-mode :
      391       when 'ИЗМЕНЕНИЕ':U
      392       then do:
      393         do transaction
      394         on error undo, return error return-value
      395         :
      396            IF v-user-id <> "":U THEN DO:
      397               find first buf_lock_user-account exclusive-lock
      398               where buf_lock_user-account.user-id = v-user-id
      399               no-error
      400               no-wait
      401               .
      402               if not available buf_lock_user-account
      403               then do:
      404               if locked(buf_lock_user-account)
      405               then do:
      406                  message
      407                     "Редактирование пользователя" skip
      408                     "" skip
      409                     "Запись захвачена другим пользователем или процессом" skip
      410                     "Невозможно редактировать запись" skip
      411                     "Идентификатор пользователя" v-user-id skip
      412                     view-as alert-box error .
      413                  undo, return error return-value .
      414               end.
      415               else do:
      416                  message
      417                     vss-workfile vss-revision vss-description skip
      418                     "Ошибка задания входных параметров" skip
      419                     "Не найдена запись пользователя" skip
      420                     "Идентификатор пользователя" v-user-id skip
      421                     view-as alert-box error .
      422                  undo, return error return-value .
      423               end.
      424               end.
      425            end.
      426         end.
      427       end.
      428       when 'ПРОСМОТР':U
      429       then do:
      430         find first buf_lock_user-account no-lock
      431           where buf_lock_user-account.user-id = v-user-id
      432           no-error .
      433         if not available buf_lock_user-account
      434         then do:
      435           message
      436             vss-workfile vss-revision vss-description skip
      437             "Ошибка задания входных параметров" skip
      438             "Не найдена запись пользователя" skip
      439             "Идентификатор пользователя" v-user-id skip
      440             view-as alert-box error .
      441           undo, return error return-value .
      442         end.
      443       end.
      444       otherwise do:
      445         message
      446           vss-workfile vss-revision vss-description skip
      447           "Неизвестное значение переменной" 'p-mode':U skip
      448           'p-mode':U p-mode skip
      449           view-as alert-box error .
      450         undo, return error return-value .
      451       end.
      452     end case .
      453     RUN enable_UI.
      454     IF AVAILABLE buf_lock_user-account THEN DO:
      455        run display-info in this-procedure
      456           (buffer buf_lock_user-account
      457           ) .
      458     END.
      459     run configure-view in this-procedure .
      460     WAIT-FOR GO OF FRAME Dialog-Frame.
      461   END.
      462   RUN disable_UI.
      463   PROCEDURE configure-view :
      464     do
      465     on error undo, return error return-value
      466     :
      467       do with frame Dialog-Frame
      468       :
      469         case p-mode
      470         :
      471           when 'ИЗМЕНЕНИЕ':U
      472           then do:
      473             assign
      474               fi-last-name             :sensitive = true
      475               fi-last-name             :fgcolor   = black_color
      476               fi-first-name            :sensitive = true
      477               fi-first-name            :fgcolor   = black_color
      478               fi-second-name           :sensitive = true
      479               fi-second-name           :fgcolor   = black_color
      480               fi-position              :sensitive = true
      481               fi-position              :fgcolor   = black_color
      482               fi-room                  :sensitive = true
      483               fi-room                  :fgcolor   = black_color
      484               fi-company               :sensitive = true
      485               fi-company               :fgcolor   = black_color
      486               fi-department            :sensitive = true
      487               fi-department            :fgcolor   = black_color
      488               fi-e-mail                :sensitive = true
      489               fi-e-mail                :fgcolor   = black_color
      490               fi-phone-number          :sensitive = true
      491               fi-phone-number          :fgcolor   = black_color
      492               fi-internal-phone-number :sensitive = true
      493               fi-internal-phone-number :fgcolor   = black_color
      494               fi-mobile-phone-number   :sensitive = true
      495               fi-mobile-phone-number   :fgcolor   = black_color
      496             .
      497             apply 'entry':u to fi-last-name .
      498           end.
      499           when 'ПРОСМОТР':U
      500           then do:
      501             assign
      502               fi-last-name             :sensitive = false
      503               fi-last-name             :fgcolor   = brown_color
      504               fi-first-name            :sensitive = false
      505               fi-first-name            :fgcolor   = brown_color
      506               fi-second-name           :sensitive = false
      507               fi-second-name           :fgcolor   = brown_color
      508               fi-position              :sensitive = false
      509               fi-position              :fgcolor   = brown_color
      510               fi-room                  :sensitive = false
      511               fi-room                  :fgcolor   = brown_color
      512               fi-company               :sensitive = false
      513               fi-company               :fgcolor   = brown_color
      514               fi-department            :sensitive = false
      515               fi-department            :fgcolor   = brown_color
      516               fi-e-mail                :sensitive = false
      517               fi-e-mail                :fgcolor   = brown_color
      518               fi-phone-number          :sensitive = false
      519               fi-phone-number          :fgcolor   = brown_color
      520               fi-internal-phone-number :sensitive = false
      521               fi-internal-phone-number :fgcolor   = brown_color
      522               fi-mobile-phone-number   :sensitive = false
      523               fi-mobile-phone-number   :fgcolor   = brown_color
      524             .
      525           end.
      526           otherwise do:
      527             message
      528               vss-workfile vss-revision vss-description skip
      529               "Неизвестное значение переменной" 'p-mode':U skip
      530               'p-mode':U p-mode skip
      531               view-as alert-box error .
      532             undo, return error return-value .
      533           end.
      534         end case .
      535       end.
      536     end.
      537   END PROCEDURE.
      538   PROCEDURE disable_UI :
      539     HIDE FRAME Dialog-Frame.
      540   END PROCEDURE.
      541   PROCEDURE display-info :
      542     define parameter buffer buf_user-account for ub.user-account .
      543     do
      544     on error undo, return error return-value
      545     :
      546       do with frame Dialog-Frame
      547       :
      548         assign
      549           fi-user-id :screen-value = v-user-id
      550         .
      551         assign
      552           fi-user-id :modified = false
      553         .
      554         assign
      555           fi-last-name :screen-value = string(buf_user-account.last-name
      556                                              ,fi-last-name :format
      557                                              )
      558           fi-last-name :modified     = false
      559         .
      560         assign
      561           fi-first-name :screen-value = string(buf_user-account.first-name
      562                                              ,fi-first-name :format
      563                                              )
      564           fi-first-name :modified     = false
      565         .
      566         assign
      567           fi-second-name :screen-value = string(buf_user-account.second-name
      568                                              ,fi-second-name :format
      569                                              )
      570           fi-second-name :modified     = false
      571         .
      572         assign
      573           fi-position :screen-value = string(buf_user-account.position
      574                                              ,fi-position :format
      575                                              )
      576           fi-position :modified     = false
      577         .
      578         assign
      579           fi-room :screen-value = string(buf_user-account.room
      580                                              ,fi-room :format
      581                                              )
      582           fi-room :modified     = false
      583         .
      584         assign
      585           fi-company :screen-value = string(buf_user-account.company
      586                                              ,fi-company :format
      587                                              )
      588           fi-company :modified     = false
      589         .
      590         assign
      591           fi-department :screen-value = string(buf_user-account.department
      592                                              ,fi-department :format
      593                                              )
      594           fi-department :modified     = false
      595         .
      596         assign
      597           fi-e-mail :screen-value = string(buf_user-account.e-mail
      598                                              ,fi-e-mail :format
      599                                              )
      600           fi-e-mail :modified     = false
      601         .
      602         assign
      603           fi-phone-number :screen-value = string(buf_user-account.phone-number
      604                                              ,fi-phone-number :format
      605                                              )
      606           fi-phone-number :modified     = false
      607         .
      608         assign
      609           fi-internal-phone-number :screen-value = string(buf_user-account.internal-phone-number
      610                                              ,fi-internal-phone-number :format
      611                                              )
      612           fi-internal-phone-number :modified     = false
      613         .
      614         assign
      615           fi-mobile-phone-number :screen-value = string(buf_user-account.mobile-phone-number
      616                                              ,fi-mobile-phone-number :format
      617                                              )
      618           fi-mobile-phone-number :modified     = false
      619         .
      620       end.
      621     end.
      622   END PROCEDURE.
      623   PROCEDURE enable_UI :
      624     DISPLAY fi-user-id
      625         WITH FRAME Dialog-Frame.
      626     ENABLE b-exit b-quit b-help fi-user-id
      627         WITH FRAME Dialog-Frame.
      628     VIEW FRAME Dialog-Frame.
      629   END PROCEDURE.
      630   PROCEDURE update-info :
      631     define buffer buf_user-account for ub.user-account .
      632     do
      633     on error undo, return error return-value
      634     :
      635       if p-mode = 'ИЗМЕНЕНИЕ':U
      636       then do:
      637         do transaction
      638         on error undo, return error return-value
      639         :
      640           find first buf_user-account exclusive-lock
      641             where buf_user-account.user-id = v-user-id
      642             no-error .
      643           if not available buf_user-account
      644           then do:
      645             message
      646               vss-workfile vss-revision vss-description skip
      647               "Не найдена запись пользователь (user-account)" skip
      648               "Идентификатор пользователя" v-user-id skip
      649               view-as alert-box error .
      650             undo, return error return-value .
      651           end.
      652           do with frame Dialog-Frame
      653           :
      654             if fi-last-name :modified = true
      655             then do:
      656               assign
      657                 buf_user-account.last-name  = fi-last-name :screen-value
      658               .
      659             end.
      660             if fi-first-name :modified = true
      661             then do:
      662               assign
      663                 buf_user-account.first-name  = fi-first-name :screen-value
      664               .
      665             end.
      666             if fi-second-name :modified = true
      667             then do:
      668               assign
      669                 buf_user-account.second-name  = fi-second-name :screen-value
      670               .
      671             end.
      672             if fi-position :modified = true
      673             then do:
      674               assign
      675                 buf_user-account.position = fi-position :screen-value
      676               .
      677             end.
      678             if fi-room :modified = true
      679             then do:
      680               assign
      681                 buf_user-account.room = fi-room :screen-value
      682               .
      683             end.
      684             if fi-company :modified = true
      685             then do:
      686               assign
      687                 buf_user-account.company = fi-company :screen-value
      688               .
      689             end.
      690             if fi-department :modified = true
      691             then do:
      692               assign
      693                 buf_user-account.department = fi-department :screen-value
      694               .
      695             end.
      696             if fi-e-mail :modified = true
      697             then do:
      698               assign
      699                 buf_user-account.e-mail = fi-e-mail :screen-value
      700               .
      701             end.
      702             if fi-phone-number :modified = true
      703             then do:
      704               assign
      705                 buf_user-account.phone-number = fi-phone-number :screen-value
      706               .
      707             end.
      708             if fi-internal-phone-number :modified = true
      709             then do:
      710               assign
      711                 buf_user-account.internal-phone-number = fi-internal-phone-number :screen-value
      712               .
      713             end.
      714             if fi-mobile-phone-number :modified = true
      715             then do:
      716               assign
      717                 buf_user-account.mobile-phone-number = fi-mobile-phone-number :screen-value
      718               .
      719             end.
      720           end.
      721         end.
      722       end.
      723     end.
      724   END PROCEDURE.
