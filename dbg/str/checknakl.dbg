      966   procedure prn-lib-open-stream :
      967     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      968     define input parameter p-page-size    as integer no-undo .
      969     define input parameter p-is-stream    as logical no-undo .
      970     define input parameter p-append       as logical no-undo .
      971     define variable v-report-name as character no-undo .
      972     do
      973       on error undo, return error
      974       :
      975       run prn-lib-get-report-name  in this-procedure (
      976         input parParentProc
      977         ,output v-report-name
      978         ).
      979       if p-is-stream then
      980       do:
      981         if p-append then
      982         do:
      983           output stream PrnLibStream to value( v-report-name )
      984             page-size value(p-page-size) append .
      985         end.
      986         if not p-append then
      987         do:
      988           output stream PrnLibStream to value( v-report-name )
      989             page-size value(p-page-size) .
      990         end.
      991       end.
      992       if not p-is-stream then
      993       do:
      994         if p-append then
      995         do:
      996           output to value( v-report-name )
      997             page-size value(p-page-size) append .
      998         end.
      999         if not p-append then
     1000         do:
     1001           output to value( v-report-name )
     1002             page-size value(p-page-size) .
     1003         end.
     1004       end.
     1005     end.
     1006   end procedure.
     1007   procedure prn-lib-open-exp :
     1008     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1009     define input parameter p-is-stream    as logical no-undo .
     1010     define input parameter p-is-append    as logical no-undo .
     1011     define output parameter p-ReportFileName as char init "report" no-undo.
     1012     define output parameter p-process as logical no-undo .
     1013     define variable glog as logical no-undo .
     1014     do
     1015       on error undo, return error
     1016       :
     1017       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1018         TITLE      "Укажите путь"
     1019         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1020         ASK-OVERWRITE
     1021         CREATE-TEST-FILE
     1022         SAVE-AS
     1023         USE-FILENAME
     1024         DEFAULT-EXTENSION "txt"
     1025         UPDATE glog
     1026         .
     1027       if not glog then  return.
     1028       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1029       if p-is-stream then
     1030       do:
     1031         if p-is-append then
     1032         do:
     1033           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1034         end.
     1035         else
     1036         do:
     1037           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1038         end.
     1039       end.
     1040       else
     1041       do:
     1042         if p-is-append then
     1043         do:
     1044           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1045         end.
     1046         else
     1047         do:
     1048           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1049         end.
     1050       end.
     1051       p-process = yes.
     1052     end.
     1053   end procedure.
