     1167     do on error undo, return error return-value :
     1168        p-ok = false.
     1169        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     1170                                                   and buf_place-attr.obj-code    = p-obj-code
     1171                                                   and buf_place-attr.obj-type    = p-obj-type
     1172                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1173        if available buf_place-attr then do :
     1174          p-value = buf_place-attr.attr-value.
     1175          p-ok = true.
     1176        end.
     1177        else do :
     1178          p-ok = false.
