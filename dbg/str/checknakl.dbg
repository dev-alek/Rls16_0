     1128   procedure placelib_write-attr:
     1129   define input  parameter p-code     like ub.place-attr.attr-code .
     1130   define input  parameter p-obj-code like ub.place-attr.obj-code .
     1131   define input  parameter p-obj-type like ub.place-attr.obj-type .
     1132   define input  parameter p-pl-code  like ub.place-attr.pl-code .
     1133   define input  parameter p-value    like ub.place-attr.attr-value .
     1134   define output parameter p-ok       as logical.
     1135   define buffer buf_place-attr for ub.place-attr .
     1136     do on error undo, return error return-value :
     1137        p-ok = false.
     1138        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1139                                                   and buf_place-attr.obj-code    = p-obj-code
     1140                                                   and buf_place-attr.obj-type    = p-obj-type
     1141                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1142        if not available buf_place-attr then do :
     1143           create buf_place-attr.
     1144           assign
     1145             buf_place-attr.attr-code   = p-code
     1146             buf_place-attr.attr-value  = p-value
     1147             buf_place-attr.obj-code    = p-obj-code
     1148             buf_place-attr.obj-type    = p-obj-type
     1149             buf_place-attr.pl-code     = p-pl-code
     1150           .
     1151           p-ok = true.
     1152        end.
     1153        else do:
     1154           buf_place-attr.attr-value  = p-value .
     1155           p-ok = true.
     1156        end.
     1157     end.
     1158   end.
     1159   procedure placelib_get-attr:
     1160   define input  parameter  p-code     like ub.place-attr.attr-code .
