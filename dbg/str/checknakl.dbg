     1064   procedure prn-lib-reportviewer :
     1065     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1066     define input parameter p-report-name-html as character no-undo .
     1067     define input parameter p-param        as character no-undo .
     1068     define variable v-excel           as character no-undo init 'TRUE' .
     1069     define variable v-value-character as character no-undo .
     1070     define variable v-value-integer   as character no-undo .
     1071     define variable v-value-date      as date      no-undo .
     1072     define variable v-value-decimal   as decimal   no-undo .
     1073     define variable rep-excel         as logical   no-undo .
     1074     define variable excel-string      as character no-undo .
     1075     define variable v-param-type      as character no-undo .
     1076     define variable v-tth             as handle    no-undo .
     1077     run adm/shattri.p (
     1078       input "get":U
     1079       ,input  ""
     1080       ,input  0
     1081       ,input  'report-glob':U
     1082       ,input  'rep-excel':U
     1083       ,output v-value-character
     1084       ,output v-value-date
     1085       ,output v-value-decimal
     1086       ,output v-value-integer
     1087       ,output rep-excel
     1088       ,output v-param-type
     1089       ,INPUT-OUTPUT table-handle v-tth
     1090       )  .
     1091     if rep-excel then v-excel = "TRUE" .
     1092     else v-excel = "FALSE" .
     1093     if p-param eq ""
     1094     then
     1095        p-param = "EXCEL:" + v-excel.
     1096     else
     1097        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1098     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1099   end procedure.
     1100   function fnc-convert-dot-to-colon returns character
     1101       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     1102   function fnc-convert-dot-to-colon returns character
     1103   (input p-data as decimal, input p-accur as character, input p-num as integer):
     1104       define variable result as character no-undo.
     1105       define variable v-str-result as character no-undo.
     1106       if p-data = ? then p-data = 0 .
     1107       p-data = round(p-data, p-num).
     1108       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1109       return v-str-result.
     1110   END FUNCTION.
