     1299   define stream OutStr-html.
     1300   define VARIABLE p-report-id          as character no-undo .
     1301   define variable v-file-name-rep-htm  as character no-undo .
     1302   define variable v-value-character    as character no-undo .
     1303   define variable v-value-date         as date      no-undo .
     1304   define variable v-value-integer      as integer   no-undo .
     1305   define variable v-value-logical      as logical   no-undo .
     1306   define variable v-param-type         as character no-undo .
     1307   define variable v-tth                as handle    no-undo .
     1308   define variable jj                   as integer   no-undo .
     1309   define variable v-date-end           as date      no-undo .
     1310   define variable v-mes                as character no-undo .
     1311   define variable v-DocumenNumber      as character no-undo .
     1312   define variable v-DocumenNumber-fact as character no-undo .
     1313   define variable v-file-name          as character no-undo .
     1314   define variable v-doc-code           as character no-undo .
     1315   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1316   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1317   v-date-end = p-shift-date - 35 .
     1318   define buffer buf_trn-doc  for ub.trn-doc  .
     1319   define buffer buf_utd      for ub.utd .
     1320   define buffer buf_doc-attr for ub.doc-attr .
     1321   define buffer bf_doc-attr  for ub.doc-attr .
     1322   for each buf_utd exclusive-lock where buf_utd.obj-code = p-obj-code
     1323      and buf_utd.obj-type = p-obj-type
     1324      and buf_utd.EDocType = objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     1325      and buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:Confirmed:KeyIntDB
     1326      and buf_utd.DocumentDate <= p-shift-date
     1327      and buf_utd.DocumentDate >= v-date-end:
     1328      if buf_utd.doc-code = "" then
     1329      do:
     1330         run schet-factur(input buf_utd.DocumentNumber,
     1331                          input buf_utd.DocumentDate,
     1332                          output v-doc-code) no-error .
     1333         if v-doc-code <> "" then buf_utd.doc-code = v-doc-code .
     1334         else
     1335         do:
     1336            if v-DocumenNumber = "" then v-DocumenNumber = buf_utd.DocumentNumber .
     1337            else v-DocumenNumber = v-DocumenNumber + "; " + buf_utd.DocumentNumber .
     1338         end.
     1339      end.
     1340      else
     1341      do:
     1342         find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_utd.doc-code no-error .
     1343         if not available (buf_trn-doc) then
     1344         do:
     1345            run schet-factur(input buf_utd.DocumentNumber,
     1346                             input buf_utd.DocumentDate,
     1347                             output v-doc-code) no-error.
     1348            if v-doc-code <> "" then buf_utd.doc-code = v-doc-code .
     1349            else
     1350            do:
     1351               if v-DocumenNumber = "" then v-DocumenNumber = buf_utd.DocumentNumber .
     1352               else v-DocumenNumber = v-DocumenNumber + "; " + buf_utd.DocumentNumber .
     1353            end.
     1354         end.
     1355         else
     1356         do:
     1357            find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_utd.doc-code
     1358               and buf_trn-doc.status_ = 'факт':U no-error .
     1359            if not available (buf_trn-doc) then
     1360            do:
     1361                  if v-DocumenNumber-fact = "" then v-DocumenNumber-fact = buf_utd.DocumentNumber .
     1362                  else v-DocumenNumber-fact = v-DocumenNumber-fact + "; " + buf_utd.DocumentNumber .
     1363            end.
     1364         end.
     1365      end.
     1366   end.
     1367   if v-DocumenNumber <> "" or v-DocumenNumber-fact <> "" then
     1368   do:
     1369      if v-DocumenNumber <> "" and v-DocumenNumber-fact <> "" then
     1370      do:
     1371         message "Через ЭДО получен(ы) закрытый(е) УПД " skip
     1372            "" skip
     1373            v-DocumenNumber + "," skip
     1374            "Необходимо создать по УПД накладную(ые) и закрыть до статуса Факт." skip
     1375            "" skip
     1376            v-DocumenNumber-fact + "," skip
     1377            "Накладную(ые) нужно закрыть до статуса Факт." skip
     1378            "" skip
     1379            "Продолжить закрытие смены?" skip
     1380            view-as alert-box question buttons yes-no update p-cancel.
     1381         v-mes = "Через ЭДО получен(ы) закрытый(е) УПД " + chr(10) + chr(10) +
     1382            v-DocumenNumber + ", необходимо создать по УПД накладную(ые) и закрыть до статуса Факт." + chr(10) + chr(10) +
     1383            v-DocumenNumber-fact + ", накладную(ые) нужно закрыть до статуса Факт." .
     1384      end.
     1385      else
     1386      do:
     1387         if v-DocumenNumber <> "" then
     1388         do:
     1389            message "Через ЭДО получен(ы) закрытый(е) УПД " skip
     1390               "" skip
     1391               v-DocumenNumber + "," skip
     1392               "" skip
     1393               "Необходимо создать по УПД накладную(ые) и закрыть до статуса Факт." skip
     1394               "" skip
     1395               "Продолжить закрытие смены?" skip
     1396               view-as alert-box question buttons yes-no update p-cancel.
     1397            v-mes = "Через ЭДО получен(ы) закрытый(е) УПД " + chr(10) + chr(10) +
     1398               v-DocumenNumber + ", необходимо создать по УПД накладную(ые) и закрыть до статуса Факт." .
     1399         end.
     1400         else
     1401         do:
     1402            message "Через ЭДО получен(ы) закрытый(е) УПД " skip
     1403               "" skip
     1404               v-DocumenNumber-fact + "," skip
     1405               "" skip
     1406               "Необходимо накладную(ые) закрыть до статуса Факт." skip
     1407               "" skip
     1408               "Продолжить закрытие смены?" skip
     1409               view-as alert-box question buttons yes-no update p-cancel.
     1410            v-mes = "Через ЭДО получен(ы) закрытый(е) УПД " + chr(10) + chr(10) +
     1411               v-DocumenNumber-fact + ", накладную(ые) нужно закрыть до статуса Факт." .
     1412         end.
     1413       end.
     1414       v-file-name = "UTD-doc_" + string(p-shift-num) + ".txt".
     1415       output to value(v-file-name) .
     1416       export v-mes .
     1417       output close .
     1418   end.
     1419   procedure schet-factur:
     1420      define input parameter p-DocumentNumber as character no-undo .
     1421      define input parameter p-DocumentDate as date no-undo .
     1422      define output parameter p-doc-code as character no-undo .
     1423      find first buf_doc-attr no-lock where buf_doc-attr.attr-code = 'nsf':U and
     1424         buf_doc-attr.attr-value = p-DocumentNumber no-error .
     1425      if available (buf_doc-attr) then
     1426      do:
     1427         find first bf_doc-attr no-lock where bf_doc-attr.attr-code = 'dsf':U and
     1428            bf_doc-attr.attr-value = string(p-DocumentDate,"99/99/9999") and
     1429            bf_doc-attr.doc-code = buf_doc-attr.doc-code no-error .
     1430         if available (bf_doc-attr) then
     1431         do:
     1432            p-doc-code = bf_doc-attr.doc-code .
     1433         end.
     1434      end.
     1435   end procedure .
