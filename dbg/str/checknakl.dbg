     1188   define output parameter p-ok       as logical.
     1189   define buffer buf_place-attr for ub.place-attr .
     1190     do on error undo, return error return-value :
     1191        p-ok = false.
     1192        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1193                                                   and buf_place-attr.obj-code    = p-obj-code
     1194                                                   and buf_place-attr.obj-type    = p-obj-type
     1195                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1196        if available buf_place-attr then do :
