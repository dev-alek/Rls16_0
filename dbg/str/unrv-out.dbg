        1   block-level on error undo, throw.
        2   define input parameter parparentproc as   handle no-undo.
        3   define input parameter trn-code      like trn-doc.doc-code no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: 5baf537283c9, 2487, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
        6   define variable vss-date        as character no-undo init "$Date: Пт июн 26 16:47:04 2020 +0300 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: unrv-out.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: str/unrv-out.p $":U .
        9   define variable vss-description as character no-undo init "Cнятие резервов по РН, ВН, НС - внешним, РН - внутренней".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71     define variable v-cntxt-db-num        as integer   no-undo .
       72     define variable v-cntxt-userid        as character no-undo .
       73     define variable v-cntxt-level         as character no-undo .
       74     define variable v-cntxt-host-code-obj as integer   no-undo .
       75     define variable v-cntxt-obj-type      as character no-undo .
       76     define variable v-cntxt-obj-code      as integer   no-undo .
       77     define variable v-cntxt-db-num-obj    as integer   no-undo .
       78     define variable v-cntxt-is-admin      as logical   no-undo .
       79   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80     run mainmenu_getcntxt in parparentproc
       81       (output v-cntxt-db-num
       82       ,output v-cntxt-userid
       83       ,output v-cntxt-level
       84       ,output v-cntxt-host-code-obj
       85       ,output v-cntxt-obj-type
       86       ,output v-cntxt-obj-code
       87       ,output v-cntxt-db-num-obj
       88       ,output v-cntxt-is-admin
       89       ) .
       90   define variable  old-flag like trn-doc.flag_ no-undo.
       91   define variable  chg-qnty like gds-dtl.doc-qnty no-undo.
       92   define variable  varwas-ov as logical no-undo.
       93   define variable  varlog as logical no-undo.
       94   define variable  is-hold as logical   no-undo .
       95   if v-cntxt-db-num <> v-cntxt-db-num-obj and ( v-cntxt-db-num-obj <> 0 ) then do:
       96     message "На пассивной стороне снять резервы невозможно.".
       97     return error.
       98   end.
       99   find trn-doc where trn-doc.doc-code = trn-code.
      100   if not (can-do ('рас,спи,возврат':U, trn-doc.doc-type) and not trn-doc.internal or trn-doc.doc-type = 'рас':U) then do:
      101     message "Документ №" trn-doc.doc-code skip
      102             "По документу данного типа снять резервы невозможно.".
      103     return error.
      104   end.
      105   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      106   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
      107     (input  trn-doc.doc-code
      108     ,output is-hold
      109     )  .
      110   if is-hold and not trn-doc.internal then do:
      111     message "Документ №" trn-doc.doc-code skip
      112             "По межфирменному перемещению снять резервы невозможно.".
      113     return error.
      114   end.
      115   if trn-doc.status_ <> 'накл':U then do:
      116     message "Документ №" trn-doc.doc-code skip
      117             "По документу с данным статусом снять резервы невозможно.".
      118     return error.
      119   end.
      120   unrv:
      121   do on stop undo unrv, return error on error undo unrv, return error:
      122     assign
      123       old-flag = trn-doc.flag_
      124       trn-doc.flag_ = no.
      125       if trn-doc.ext-doc-type = 'ep':U and
      126        can-find(first gds-dtl where gds-dtl.doc-code = trn-doc.doc-code and
      127                                     gds-dtl.ov       = yes                  )
      128        then assign varwas-ov = yes.
      129        else assign varwas-ov = no.
      130     for each gds-dtl where gds-dtl.doc-code = trn-doc.doc-code,
      131          each doc-line of gds-dtl
      132          on stop undo unrv, return error on error undo unrv, return error:
      133       chg-qnty = - gds-dtl.doc-qnty.
      134       run trg/rsrv-dtl.p ( parparentproc,
      135                        'reserv':U, buffer gds-dtl, input-output chg-qnty,
      136                              input-output doc-line.price-base, input-output doc-line.price-rubl, -1, "").
      137       if chg-qnty <> - gds-dtl.doc-qnty then undo unrv, return error.
      138       if old-flag then gds-dtl.ov = yes.
      139     end.
      140     if trn-doc.ext-doc-type = 'ep':U and
      141     varwas-ov = yes then do:
      142       assign varlog = no.
      143       message "Будем разфиксировать цены?" view-as alert-box question buttons yes-no update varlog .
      144       if varlog then do:
      145          for each gds-dtl where gds-dtl.doc-code = trn-doc.doc-code
      146          on stop undo unrv, return error on error undo unrv, return error:
      147            assign gds-dtl.ov = no.
      148          end.
      149       end.
      150     end.
      151     assign
      152       trn-doc.status_ = 'запрос':U
      153       trn-doc.flag_   = yes.
      154   end.
