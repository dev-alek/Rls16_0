     1241   FUNCTION convert-discount returns integer
     1242                                             ( input p-disc-reason as integer
     1243                                             , input p-disc-type  as integer
     1244                                             , input p-line-type as integer) :
     1245   define variable v-disc-type as integer no-undo .
     1246   if p-line-type = integer('1':U)
     1247   or p-line-type = integer('0':U)
     1248   then do:
     1249     if p-disc-type = 0
     1250     or p-disc-type = 1
     1251     or p-disc-type = 2
     1252     then do:
     1253       if p-disc-reason <> 0 then
     1254       p-disc-type = p-disc-reason
     1255       .
     1256     end.
     1257   end.
     1258   if p-line-type = integer('3':U)
     1259   or p-line-type = integer('2':U) then do:
     1260     if p-disc-type = 101
     1261     or p-disc-type = 102
     1262     then do:
     1263       if p-disc-reason <> 0 then
     1264       p-disc-type = p-disc-reason
     1265       .
     1266     end.
     1267   end.
     1268   if p-disc-reason <> 0 then do:
     1269     CASE p-disc-reason:
     1270       when 0 then do:
     1271         return integer('0':U).
     1272       end.
     1273       when 1 then do:
     1274         return integer('11':U).
     1275       end.
     1276       when 2 then do:
     1277         return integer('1':U).
     1278       end.
     1279       when 3 or when 15 then do:
     1280         return integer('7':U).
     1281       end.
     1282       when 4 then do:
     1283         return integer('4':U).
     1284       end.
     1285       when 5 then do:
     1286         return integer('12':U).
     1287       end.
     1288       when 6 then do:
     1289         return integer('3':U).
     1290       end.
     1291       when 7 then do:
     1292         return integer('13':U).
     1293       end.
     1294       when 8
     1295       or
     1296       when 9
     1297       or
     1298       when 10
     1299       then do:
     1300         return integer('20':U).
     1301       end.
     1302       when 11
     1303       then do:
     1304         return integer('21':U).
     1305       end.
     1306       when 13
     1307       then do:
     1308         return integer('22':U).
     1309       end.
     1310       when 16 then do:
     1311         return integer('23':U).
     1312       end.
     1313     END CASE.
     1314   end.
     1315   CASE p-disc-type:
     1316     when 0 then do:
     1317       return integer('0':U).
     1318     end.
     1319     when 1 then do:
     1320       return integer('13':U).
     1321     end.
     1322     when 2 then do:
     1323       return integer('2':U).
     1324     end.
     1325     when 3 then do:
     1326       return integer('4':U).
     1327     end.
     1328     when 4 then do:
     1329       return integer('12':U).
     1330     end.
     1331     when 5 then do:
     1332       return integer('1':U).
     1333     end.
     1334     when 6 then do:
     1335       return integer('3':U).
     1336     end.
     1337     when 7 then do:
     1338       return integer('14':U).
     1339     end.
     1340     when 8 then do:
     1341       return integer('15':U).
     1342     end.
     1343     when 9 then do:
     1344       return integer('16':U).
     1345     end.
     1346     when 101 then do:
     1347       return integer('13':U).
     1348     end.
     1349     when 102 then do:
     1350       return integer('5':U).
     1351     end.
     1352     when 103 then do:
     1353       return integer('1':U).
     1354     end.
     1355     when 104 then do:
     1356       return integer('5':U).
     1357     end.
     1358     when 105 then do:
     1359       return integer('1':U).
     1360     end.
     1361     when 106 then do:
     1362       return integer('1':U).
     1363     end.
     1364   END CASE.
     1365   END FUNCTION.
     1366   run get-general-parameters in this-procedure .
     1367   procedure get-general-parameters :
     1368   define buffer buf_get-chkc_context for get-chkc_context.
     1369   do
     1370   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1371   :
     1372     for each buf_get-chkc_context:
     1373       delete buf_get-chkc_context.
     1374     end.
     1375     create buf_get-chkc_context.
     1376   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1377   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libchkvl_create-context in g#libchkvl
     1378     (input  p-obj-type
     1379     ,input  p-obj-code
     1380     ,input  buffer buf_get-chkc_context:handle
     1381     ) no-error .
     1382     if error-status:error then do:
     1383       undo, return error substitute("Ошибка при создании контекста&1&2&1&3"
     1384                                      , chr(10)
     1385                                      , error-status:get-message(1)
     1386                                      , return-value ).
     1387     end.
     1388     find first buf_get-chkc_context.
     1389     assign
     1390     buf_get-chkc_context.parparentproc = parparentproc
     1391     buf_get-chkc_context.p-log-handle = p-log-handle
     1392     buf_get-chkc_context.tt-wd-bh     = buffer tt-wd:handle
     1393     .
     1394     release buf_get-chkc_context.
     1395     find first get-chkc_context.
     1396   end.
     1397   end procedure.
     1398   define variable p-pos-type as character no-undo .
     1399   assign
     1400   dflt-cd = 'IPC-Servis+':U
     1401   p-pos-type = dflt-cd
     1402   get-chkc_context.pos-type = p-pos-type
     1403   .
     1404   run get-comments in this-procedure no-error .
     1405   run get-cards in this-procedure no-error .
     1406   input stream ChkStream from value(filename).
     1407   M-R:
     1408   REPEAT :
     1409     import stream ChkStream unformatted ss.
     1410     assign
     1411     var-file-line-num = var-file-line-num + 1
     1412     .
     1413     if ss = "" then do:
     1414       run proc-end in this-procedure no-error .
     1415       NEXT M-R.
     1416     end.
     1417     run proc-str in this-procedure (ss) no-error .
     1418   END .
     1419   DO TRANSACTION:
     1420     if file_ = "cashsail.dat" or ENTRY(2, file_, ".") = "ret" then do:
     1421       run proc-end in this-procedure no-error .
     1422     end.
     1423   END.
     1424   input stream ChkStream close.
     1425   FIND FIRST ipcs-file where
     1426              ipcs-file.z-val = z-val AND
     1427              ipcs-file.cass-num = cass-num  NO-ERROR.
     1428   IF NOT AVAIL ipcs-file then do:
     1429       create ipcs-file.
     1430       assign
     1431       ipcs-file.cass-num = cass-num
     1432       ipcs-file.z-val = z-val
     1433       ipcs-file.seq-val = next-value(s-file-num, ub)
     1434       .
     1435   END.
     1436   if entry(2, file_, ".") = "dat" then do:
     1437     os-copy value(filename) value(p-path + chr(47) + entry(1,file_,'.') + '.' + string(ipcs-file.seq-val)).
     1438   end.
     1439   if file_ = "cashsail.dat" then do:
     1440     if search(p-path + chr(47) + "cashcmnt.dat":U) <> ? then do:
     1441       os-copy value(p-path + chr(47) + "cashcmnt.dat":U) value(p-path + chr(47) + "cashcmnt":U + '.' + string(ipcs-file.seq-val)).
     1442     end.
     1443     if search(p-path + chr(47) + "cashdcrd.dat":U) <> ? then do:
     1444       os-copy value(p-path + chr(47) + "cashdcrd.dat":U) value(p-path + chr(47) + "cashdcrd":U + '.' + string(ipcs-file.seq-val)).
     1445     end.
     1446   end.
     1447   if can-do("dat,ret,del":U, entry(2,filename,'.')) then
     1448   os-delete value(filename).
     1449   error-status:error = false.
     1450   procedure get-comments :
     1451     do
     1452     on error undo, return error
     1453     :
     1454       if search(p-path + chr(47) + "cashcmnt.dat":U) <> ? then do:
     1455         assign
     1456         var-file-line-num = 0
     1457         .
     1458         input stream ChkStream from value(p-path + chr(47) + "cashcmnt.dat":U).
     1459         _cashcmnt:
     1460         REPEAT:
     1461           import stream ChkStream unformatted ss.
     1462           assign
     1463           var-file-line-num = var-file-line-num + 1
     1464           .
     1465           if ss = "":U then NEXT _cashcmnt.
     1466           run proc-comments in this-procedure (input ss) no-error .
     1467         END.
     1468       end.
     1469       output stream ChkStream close.
     1470     end.
     1471   end procedure.
     1472   procedure proc-comments :
     1473   define input parameter p-ss as character no-undo .
     1474   DEFINE VARIABLE PS_ as character no-undo .
     1475     do
     1476     on error undo, return error
     1477     :
     1478       assign
     1479       z-val = integer(entry(3,p-ss))
     1480       cass-num = integer(entry(2, p-ss))
     1481       id_ = entry(3,p-ss) + chr(47) + entry(1,p-ss) + chr(47) + entry(2,p-ss) + chr(47) + entry(4,p-ss)
     1482       ps_ = entry(5,p-ss)
     1483       no-error
     1484       .
     1485       if error-status:error then do:
     1486         if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     1487       end.
     1488       find first tt-str where
     1489                   tt-str.id = id_ no-error .
     1490       if not avail tt-str then do:
     1491         create tt-str.
     1492         assign
     1493         tt-str.id = id_
     1494         tt-str.PS = "@" + PS_ + "@"
     1495         .
     1496       end.
     1497     end.
     1498   end procedure.
     1499   procedure get-cards :
     1500     do
     1501     on error undo, return error
     1502     :
     1503       assign
     1504       var-file-line-num = 0
     1505       .
     1506       if search(p-path + chr(47) + "cashdcrd.dat":U) <> ? then do:
     1507         input stream ChkStream from value(p-path + chr(47) + "cashdcrd.dat":U).
     1508         _cashdcrd:
     1509         REPEAT:
     1510           import stream ChkStream unformatted ss.
     1511           assign
     1512           var-file-line-num = var-file-line-num + 1
     1513           .
     1514           if ss = "":U then NEXT _cashdcrd.
     1515           run proc-cards in this-procedure (input ss ) no-error .
     1516         END.
     1517       end.
     1518       output stream ChkStream close.
     1519     end.
     1520   end procedure.
     1521   procedure proc-cards :
     1522   define input parameter p-ss as character no-undo .
     1523   DEFINE VARIABLE var-dc-discnt as decimal no-undo .
     1524   DEFINE VARIABLE dopd-card as character no-undo .
     1525   DEFINE VARIABLE idopd-card as decimal no-undo .
     1526   DEFINE VARIABLE hh as integer no-undo .
     1527     do
     1528     on error undo, return error
     1529     :
     1530       assign
     1531       z-val = integer(entry(3,p-ss))
     1532       cass-num = integer(entry(2, p-ss))
     1533       id_ = entry(3,p-ss) + chr(47) + entry(1,p-ss) + chr(47) + entry(2,p-ss) + chr(47) + entry(4,p-ss)
     1534       dopd-card = trim(entry(6,p-ss), chr(34))
     1535       var-dc-discnt = decimal(trim(entry(7,p-ss), chr(34)))
     1536       no-error
     1537       .
     1538       do hh = 1 to length(dopd-card):
     1539         assign
     1540         idopd-card = decimal(substr(dopd-card, hh))
     1541         no-error
     1542         .
     1543         if error-status:error = no then do:
     1544           assign
     1545           dopd-card = substr(dopd-card, hh)
     1546           .
     1547           LEAVE.
     1548         end.
     1549       end.
     1550       find first tt-str where
     1551                   tt-str.id = id_ no-error .
     1552       if not avail tt-str then do:
     1553         create tt-str.
     1554         assign
     1555         tt-str.id = id_
     1556         tt-str.d-card = dopd-card
     1557         tt-str.discnt-value-abs = var-dc-discnt
     1558         .
     1559       end.
     1560     end.
     1561   end procedure.
     1562   procedure proc-end :
     1563     do
     1564     on error undo, return error
     1565     :
     1566        get-chkc_context.ll = lll.
     1567   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1568   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libchkvl_getcheck in g#libchkvl
     1569     (input  buffer get-chkc_context:handle
     1570     ,input  'ДОБАВЛЕНИЕ':U
     1571     ,input  ''
     1572     ,input  yes
     1573     ,input  yes
     1574     ,input  ?
     1575     ,input  lng-sub-d
     1576     ,input  sub-d
     1577     ,input  var-discnt-id
     1578     ,input-output prev-code
     1579       ) no-error .
     1580        assign
     1581        prev-code = "":U
     1582        lll = get-chkc_context.ll
     1583        p-view-log = (p-view-log or get-chkc_context.view-log)
     1584        .
     1585     end.
     1586   end procedure.
     1587   procedure proc-str :
     1588   define input parameter p-ss as character no-undo .
     1589   DEFINE VARIABLE pre-pay-type as character no-undo .
     1590   DEFINE VARIABLE cur-pay-type as character no-undo .
     1591   DEFINE VARIABLE TotSum-Value as decimal no-undo .
     1592     do
     1593     on error undo, return error
     1594     :
     1595       assign
     1596       z-val = integer(entry(3,p-ss))
     1597       cass-num = integer(entry(2, p-ss))
     1598       id_ = entry(3,p-ss) + chr(47) + entry(1,p-ss) + chr(47) + entry(2,p-ss) + chr(47) + entry(4,p-ss)
     1599       no-error
     1600       .
     1601       if error-status:error then do:
     1602       end.
     1603       if entry( 2, file_, '.' ) = "del" then do:
     1604         FIND ub.chk-doc WHERE
     1605               ub.chk-doc.doc-code = string(p-obj-code) + chr(47) + id_ NO-ERROR .
     1606         if available ub.chk-doc then  do:
     1607           if FALSE  then do:
     1608             DELETE ub.chk-doc.
     1609             return .
     1610           end.
     1611           else do:
     1612             FOR EACH ub.chk-pay WHERE
     1613                     ub.chk-pay.doc-code = chk-doc.doc-code :
     1614               BUFFER-COPY ub.chk-pay TO b-pay
     1615               assign
     1616               b-pay.tot-sum = - ub.chk-pay.tot-sum
     1617               b-pay.tot-rubl = - ub.chk-pay.tot-rubl
     1618               b-pay.tot-base = - ub.chk-pay.tot-base
     1619               b-pay.doc-code = ub.chk-pay.doc-code + "в"
     1620               .
     1621             END.
     1622             FOR EACH ub.chk-gds WHERE
     1623                     ub.chk-gds.doc-code = ub.chk-doc.doc-code :
     1624               BUFFER-COPY chk-gds TO b-gds
     1625               assign
     1626               b-gds.src-qnty = - ub.chk-gds.src-qnty
     1627               b-gds.src-sum  = - chk-gds.src-sum
     1628               b-gds.doc-code = chk-gds.doc-code + "в"
     1629               .
     1630             END.
     1631             FOR EACH ub.chk-discnt WHERE
     1632                     ub.chk-discnt.doc-code = chk-doc.doc-code :
     1633               BUFFER-COPY ub.chk-discnt TO b-discnt
     1634               assign
     1635               b-discnt.discnt-value-abs = - ub.chk-discnt.discnt-value-abs
     1636               b-discnt.discnt-value-pcnt = - ub.chk-discnt.discnt-value-pcnt
     1637               b-discnt.object-qnty = - ub.chk-discnt.object-qnty
     1638               b-discnt.object-sum = - ub.chk-discnt.object-sum
     1639               b-discnt.doc-code = ub.chk-gds.doc-code + "в"
     1640               .
     1641             END.
     1642             CREATE b-doc .
     1643             assign
     1644             lll = lll + 1
     1645             b-doc.chk-date = ub.chk-doc.chk-date
     1646             b-doc.chk-time = ub.chk-doc.chk-time + chk-doc.chk-num
     1647             b-doc.chk-num = - ub.chk-doc.chk-num
     1648             b-doc.sales-man = ub.chk-doc.sales-man
     1649             b-doc.pay-desk = ub.chk-doc.pay-desk
     1650             b-doc.cashier = ub.chk-doc.cashier
     1651             b-doc.office = ub.chk-doc.office
     1652             b-doc.obj-type = ub.chk-doc.obj-type
     1653             b-doc.obj-code = ub.chk-doc.obj-code
     1654             b-doc.tot-doc = - ub.chk-doc.tot-doc
     1655             b-doc.discnt = - ub.chk-doc.discnt
     1656             b-doc.doc-code = ub.chk-doc.doc-code + "в"
     1657             b-doc.netto = - ub.chk-doc.netto
     1658             b-doc.shift-date = ub.chk-doc.shift-date
     1659             b-doc.shift-num = ub.chk-doc.shift-num
     1660             b-doc.shift-name = ub.chk-doc.shift-name
     1661             b-doc.src-d-card = ub.chk-doc.src-d-card
     1662             b-doc.src-shift-date = ub.chk-doc.src-shift-date
     1663             b-doc.cash-rate = ub.chk-doc.cash-rate
     1664             b-doc.cash-scale = ub.chk-doc.cash-scale
     1665             b-doc.z-number = ub.chk-doc.z-number
     1666             b-doc.correct = ub.chk-doc.correct
     1667             b-doc.chk-type = (if ub.chk-doc.chk-type = integer('1':U)
     1668                               then integer('6':U)
     1669                               else integer('1':U)
     1670                               )
     1671             b-doc.d-pcnt = ub.chk-doc.d-pcnt
     1672             b-doc.src-d-pcnt = ub.chk-doc.src-d-pcnt
     1673             .
     1674           end.
     1675         end.
     1676       end.
     1677       else do:
     1678         assign
     1679         pay-desk_ = int( entry( 2, p-ss ) )
     1680         chk-num_ = int( entry( 4, p-ss ) )
     1681         sales-man_ = int(entry(15,p-ss))
     1682         chk-date_ =  date( int( substr( entry( 6, p-ss ), 4, 2 ) ),
     1683                            int( substr( entry( 6, p-ss ), 1, 2 ) ),
     1684                            int( substr( entry( 6, p-ss ), 7, 4 ) ) )
     1685         chk-time_ =  truncate ( int(entry(7, p-ss)) / 100, 0 ) * 3600 +
     1686                      (int(entry(7, p-ss)) - truncate ( int(entry(7, p-ss)) / 100, 0 ) * 100) * 60
     1687         z-num_ = int(entry (3 , p-ss))
     1688         cashier_ = int( entry( 16, p-ss ) )
     1689         chk-type_ =  if int(entry(18, p-ss)) > 0
     1690                       then integer('1':U)
     1691                       else integer('6':U)
     1692         bc-buf =  if length(entry(8, p-ss)) < 25
     1693                   then trim( substr( entry( 8, p-ss ), 17, length( entry( 8, p-ss ) ) - 17 ) )
     1694                   else trim( substr( entry( 8, p-ss ), 18, length( entry( 8, p-ss ) ) - 18 ) )
     1695         price-from-check =  dec( entry( 11, p-ss ) )
     1696         curr-string-qnty = (if chk-type_ = integer('1':U)
     1697                            then dec( entry( 10, p-ss ) )
     1698                            else (- dec( entry( 10, p-ss ) ))
     1699                           )
     1700         TotSum-Value = if chk-type_ = integer('1':U)
     1701                        then dec( entry( 13, p-ss ) )
     1702                        else (- dec( entry( 13, p-ss ) ))
     1703         tot_sum = if chk-type_ = integer('1':U)
     1704                   THEN ( if get-chkc_context.base-code <> 0 then dec( entry( 14, p-ss ) ) else dec( entry( 13, p-ss ) ) )
     1705                   ELSE ( if get-chkc_context.base-code <> 0 then ( - dec( entry( 14, p-ss ) ) ) else ( - dec( entry( 13, p-ss ) ) ) )
     1706         cur-pay-type = entry( 20, p-ss )
     1707         curr_code =  if can-do( "0,1", entry( 19, p-ss ) )
     1708                      then base-cass
     1709                      else int( entry( int( lookup( cur-pay-type, cass-card ) ), curr-card ) )
     1710         pay_code = if can-do( "0,1", entry( 19, p-ss ) )
     1711                    then pay-nal
     1712                    else int( entry( int( lookup( cur-pay-type, cass-card ) ), trade-card ) )
     1713         no-error .
     1714         if error-status:error then do:
     1715           if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     1716         end.
     1717         FIND chk-doc WHERE
     1718             chk-doc.doc-code = string( p-obj-code ) + chr(47) + id_  NO-WAIT NO-ERROR.
     1719         IF (NOT AVAIl chk-doc AND NOT LOCKED CHK-doc  AND NOT AMBIGUOUS chk-doc ) OR
     1720             can-find(FIRST chk_doc where chk_doc.doc-code = id_) then do:
     1721           FIND FIRST chk_Doc where chk_doc.doc-code = id_ NO-ERROR.
     1722           IF not avail chk_doc then do:
     1723             run proc-end in this-procedure .
     1724             CREATE chk_doc.
     1725             assign
     1726             chk_doc.doc-code = id_.
     1727             find first tt-str where
     1728             tt-str.id = id_ no-error .
     1729             CREATE chk-doc.
     1730             assign
     1731             lll = lll + 1
     1732             lng = 0
     1733             lnp = 0
     1734             cr = 0
     1735             chk-doc.pay-desk = pay-desk_
     1736             chk-doc.chk-num = chk-num_
     1737             chk-doc.obj-type = p-obj-type
     1738             chk-doc.obj-code = p-obj-code
     1739             chk-doc.doc-code = string(p-obj-code) + chr(47) + id_
     1740             chk-doc.office = ?
     1741             for-chk-type = ""
     1742             prev-code = chk-doc.doc-code
     1743             chk-doc.sales-man = sales-man_
     1744             chk-doc.chk-date = chk-date_
     1745             chk-doc.chk-time = chk-time_
     1746             chk-doc.shift-date = chk-doc.chk-date
     1747             chk-doc.src-shift-date = chk-doc.shift-date
     1748             chk-doc.cash-rate = 1
     1749             chk-doc.cash-scale = 1
     1750             chk-doc.z-number = z-num_
     1751             chk-doc.correct = yes
     1752             chk-doc.d-pcnt = 0
     1753             chk-doc.src-d-pcnt = 0
     1754             chk-doc.shift-num = 0
     1755             chk-doc.shift-name = '':U
     1756             chk-doc.cashier = cashier_
     1757             chk-doc.chk-type = chk-type_
     1758             chk-doc.correct = yes
     1759             chk-doc.src-d-card = (if avail tt-str
     1760                               then tt-str.d-card
     1761                               else "":U)
     1762             chk-doc.PS = (if avail tt-str
     1763                               then tt-str.PS
     1764                               else "":U)
     1765             .
     1766           end.
     1767           IF not AVAILABLE CHK-GDS
     1768             or NOT (chk-gds.doc-code = chk-doc.doc-code
     1769                     AND chk-gds.src-code = bc-buf)
     1770             or (chk-gds.doc-code = chk-doc.doc-code
     1771                 AND chk-gds.src-code = bc-buf
     1772                 AND pre-pay-type = cur-pay-type) then do:
     1773             CREATE chk-gds.
     1774             assign
     1775             lng = lng + 1
     1776             chk-gds.doc-code = chk-doc.doc-code
     1777             chk-gds.line-num = lng
     1778             chk-gds.chk-date = chk-doc.chk-date
     1779             pre-pay-type = cur-pay-type
     1780             chk-gds.b-code =  0
     1781             chk-gds.grp-code = 0
     1782             chk-gds.src-code = bc-buf
     1783             chk-gds.is-error = no
     1784             chk-gds.discnt = 0
     1785             chk-gds.time-oper = chk-doc.chk-time
     1786             chk-gds.src-qnty = 0
     1787             chk-gds.doc-qnty = 0
     1788             chk-gds.src-price = price-from-check
     1789             chk-gds.src-discnt = 0
     1790             chk-gds.src-sum = 0
     1791             chk-gds.src-qnty = chk-gds.src-qnty + curr-string-qnty
     1792             chk-gds.pass-gds = 0
     1793             chk-gds.line-sign = (if chk-doc.chk-type = integer('1':U)
     1794                                 then (chk-gds.src-qnty >= 0)
     1795                                 else (chk-gds.src-qnty <= 0)
     1796                                 )
     1797             chk-gds.line-type =  "":U
     1798             .
     1799           end.
     1800           else do:
     1801             define variable v-prev-qnty as decimal no-undo .
     1802             assign
     1803             v-prev-qnty = chk-gds.src-qnty
     1804             chk-gds.src-qnty = chk-gds.src-qnty + curr-string-qnty
     1805             .
     1806           end.
     1807           assign
     1808           chk-gds.src-sum = chk-gds.src-sum - (chk-gds.src-discnt * v-prev-qnty) + tot_sum
     1809           chk-gds.src-discnt = (chk-gds.src-price * abs(chk-gds.src-qnty)  -
     1810                         (IF chk-type_ = integer('1':U) then 1 else - 1) * chk-gds.src-sum) / abs(chk-gds.src-qnty)
     1811           .
     1812           if chk-gds.src-discnt <> 0 then do:
     1813             find first chk-discnt where
     1814                       chk-discnt.doc-code = chk-doc.doc-code
     1815                   and chk-discnt.line-num = chk-gds.line-num
     1816                   and chk-discnt.record-type = 0 no-error.
     1817             if not available chk-discnt then do:
     1818                create chk-discnt.
     1819                assign
     1820                chk-discnt.discnt-id = (var-discnt-id + 1)
     1821                var-discnt-id = var-discnt-id + 1
     1822                .
     1823             end.
     1824             assign
     1825             chk-discnt.doc-code = chk-doc.doc-code
     1826             chk-discnt.record-type = 0
     1827             chk-discnt.line-num = chk-gds.line-num
     1828             chk-discnt.time-oper = chk-doc.chk-time
     1829             chk-discnt.line-type = integer('1':U)
     1830             chk-discnt.line-sign =  (chk-gds.src-qnty >= 0 ) NE (chk-gds.src-discnt > 0 )
     1831             chk-discnt.pass-discnt = integer('0':U)
     1832             chk-discnt.value-type = integer('0':U)
     1833             chk-discnt.discnt-type = integer('0':U)
     1834             chk-discnt.src-d-card = chk-doc.src-d-card
     1835             chk-discnt.discnt-value-abs = chk-gds.src-discnt
     1836             chk-discnt.object-qnty = chk-gds.src-qnty
     1837             chk-discnt.object-sum = chk-gds.src-sum
     1838             chk-gds.src-sum = chk-gds.src-price * chk-gds.src-qnty
     1839             chk-discnt.discnt-value-pcnt = if chk-gds.src-sum <> 0 then
     1840                                             chk-gds.src-discnt * chk-gds.src-qnty / chk-gds.src-sum * 100
     1841                                             else 0
     1842             chk-discnt.object-line-num = chk-gds.line-num
     1843             chk-discnt.pay-desk = chk-doc.pay-desk
     1844             chk-discnt.obj-code = chk-doc.obj-code
     1845             chk-discnt.obj-type = chk-doc.obj-type
     1846             chk-discnt.chk-date = chk-doc.chk-date
     1847             chk-discnt.chk-time = chk-doc.chk-time
     1848             .
     1849           end.
     1850           FIND chk-pay where
     1851                 chk-pay.doc-code = chk-doc.doc-code AND
     1852                 chk-pay.curr-code = curr_code AND
     1853                 chk-pay.pay-code = pay_code      NO-ERROR.
     1854           if NOT available chk-pay then do:
     1855             CREATE chk-pay.
     1856             assign
     1857             lnp = lnp + 1
     1858             chk-pay.doc-code = chk-doc.doc-code
     1859             chk-pay.line-num = lnp
     1860             chk-pay.chk-date = chk-doc.chk-date
     1861             chk-pay.obj-code = p-obj-code
     1862             chk-pay.obj-type = p-obj-type
     1863             chk-pay.pay-code = pay_code
     1864             chk-pay.curr-code = curr_code
     1865             chk-pay.tot-sum = chk-pay.tot-sum + TotSum-Value
     1866             chk-pay.time-oper = chk-doc.chk-time
     1867             chk-pay.line-type = "":U
     1868             chk-pay.line-sign =  (if chk-doc.chk-type = integer('1':U)
     1869                                   then (chk-pay.tot-sum >= 0)
     1870                                   else (chk-pay.tot-sum <= 0)
     1871                                   )
     1872             chk-pay.pay-card = "":U
     1873             chk-pay.cash-rate = if curr_code <> 0
     1874                                 then TotSum-Value / tot_sum
     1875                                 else 1
     1876             chk-pay.bank-rate = 1
     1877             chk-pay.bank-scale = 1
     1878             chk-pay.pass-pay  = 0
     1879             chk-pay.is-error = no
     1880             .
     1881           end.
     1882           else do:
     1883             assign
     1884             chk-pay.tot-sum = chk-pay.tot-sum + TotSum-Value
     1885             .
     1886           end.
     1887         end.
     1888       end.
     1889     end.
     1890   end procedure.
