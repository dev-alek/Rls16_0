        1   define input        parameter p-mode   as character no-undo.
        2   define input-output parameter p-rec-id as recid     no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo initial "Просмотр карточки истории изменения ТРК":U.
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   define buffer buf_cli for ub.clients.
      113   define button   Btn_Exit  label "Вы&ход"  size-chars 10.00 by 1.00 default auto-end-key.
      114   define button   Btn_OK    label "&Ввод "  size-chars 10.00 by 1.00 default auto-go.
      115   define button b-help label "Помо&щь" size-chars 10.00 by 1.00 default.
      116   define rectangle r-rect-0 edge-pixels 3 graphic-edge no-fill size-chars 98.25 by 1.50.
      117   define frame fr-D-pump-8
      118     ub.c-pump.pump-code at row  1.25 col 11.00 colon-aligned view-as fill-in size-chars  3.50 by 1.00                   fgcolor  4
      119     ub.c-pump.obj-type  at row  2.50 col 11.00 colon-aligned view-as fill-in size-chars  4.50 by 1.00    label "Объект"
      120     ub.c-pump.obj-code  at row  2.50 col 18.00          view-as fill-in size-chars 10.50 by 1.00 no-label
      121     buf_cli.obj-name   at row  2.50 col 29.00          view-as fill-in size-chars 70.00 by 1.00 no-label          fgcolor  4
      122     ub.c-pump.status_   at row  3.75 col 11.00 colon-aligned view-as fill-in size-chars  9.50 by 1.00
      123     ub.c-pump.PS        at row  5.25 col  1.50          view-as editor no-word-wrap scrollbar-horizontal scrollbar-vertical size-chars  98.25 by 3.50 no-label          bgcolor 15
      124     r-rect-0           at row  9.25 col  1.50
      125       Btn_Exit         at row  9.50 col  2.50
      126       Btn_OK           at row  9.50 col 78.00
      127     b-help        at row  9.50 col 88.75
      128   with view-as dialog-box side-labels no-underline three-d scrollable
      129        title "":U default-button Btn_Exit cancel-button Btn_Exit.
      130   assign frame fr-D-pump-8 :scrollable = no.
      131   on choose of Btn_OK in frame fr-D-pump-8 do:
      132   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   if lookup(self :type
      134            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      135            ) = 0
      136   then do:
      137     message
      138       "$Workfile$"
      139       "Указанному интерфейсному элементу фокус не может быть передан" skip
      140       "Интерфейсный элемент" self :name  skip
      141       "Тип" self :type  skip
      142       "Процедура" this-procedure :file-name skip
      143       view-as alert-box .
      144   end.
      145   else do:
      146     apply "entry":u to self  .
      147     if focus :handle <> self :handle  then do:
      148       return no-apply .
      149     end.
      150   end.
      151     apply "GO":U to frame fr-D-pump-8.
      152   end.
      153   on choose of Btn_Exit in frame fr-D-pump-8 do:
      154   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      155   if lookup(self :type
      156            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      157            ) = 0
      158   then do:
      159     message
      160       "$Workfile$"
      161       "Указанному интерфейсному элементу фокус не может быть передан" skip
      162       "Интерфейсный элемент" self :name  skip
      163       "Тип" self :type  skip
      164       "Процедура" this-procedure :file-name skip
      165       view-as alert-box .
      166   end.
      167   else do:
      168     apply "entry":u to self  .
      169     if focus :handle <> self :handle  then do:
      170       return no-apply .
      171     end.
      172   end.
      173   end.
      174   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      175   on F1 of frame fr-D-pump-8 anywhere do:
      176     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame fr-D-pump-8. END.
      177     return no-apply.
      178   end.
      179   if valid-handle( active-window ) and frame fr-D-pump-8 :parent = ? then frame fr-D-pump-8 :parent = active-window.
      180   if current-window :window-state = window-minimized then do: current-window :window-state = window-normal. end.
      181   on window-close of frame fr-D-pump-8 do: apply "END-ERROR":U to self. end.
      182   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      183   on help of frame fr-D-pump-8
      184   do:
      185     run gbl/app_help.p
      186       (input this-procedure :file-name
      187       ,input ''
      188       ,input ?
      189       ) no-error.
      190     if error-status :error then do:
      191       message
      192         "Ошибка при вызове помощи"
      193         error-status :get-message(1)
      194         view-as alert-box .
      195     end.
      196   end.
      197   run minbtn-set in this-procedure .
      198   on choose of b-help in frame fr-D-pump-8
      199   do:
      200     apply "help":u to frame fr-D-pump-8 .
      201   end.
      202   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      203   procedure minbtn-set :
      204       do
      205           on error undo, return error return-value
      206           :
      207           define variable ii              as integer       no-undo .
      208           define variable fh              as widget-handle no-undo .
      209           define variable hh              as widget-handle no-undo .
      210           define variable v-h             as handle        extent 4 no-undo .
      211           define variable v-name-button   as character     no-undo .
      212           define variable v-help-old-x    as decimal       no-undo .
      213           define variable v-help-old-y    as decimal       no-undo .
      214           define variable v-help-old-size as decimal       no-undo .
      215           define variable v-frame-width   as decimal       no-undo .
      216           define variable jj              as integer       no-undo .
      217           do
      218               on error undo, return error
      219               :
      220               assign
      221                   v-frame-width = frame fr-D-pump-8:width - 0.3
      222                   fh            = frame fr-D-pump-8:first-child
      223                   hh            = fh:first-child
      224                   ii            = 1
      225                   .
      226               do while valid-handle(hh):
      227                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      228                   do:
      229                       case lc(hh:name) :
      230                           when "b-help" then
      231                               do:
      232                                   hh:load-image-up("cmp/b-help.bmp":u) .
      233                                   hh:load-image-down("cmp/b-help.bmp":u) .
      234                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      235                                   hh:TOOLTIP = "Помощь" .
      236                                   v-help-old-x = hh:column .
      237                                   v-help-old-y = hh:row    .
      238                                   v-help-old-size = hh:width .
      239                                   hh:width-chars = 2.5 .
      240                               end.
      241                           when "b-print" then
      242                               do:
      243                                   hh:load-image("cmp/b-print.bmp":u) .
      244                                   hh:TOOLTIP = "Печать" .
      245                                   v-h[ii] = hh:handle .
      246                                   ii = ii + 1 .
      247                                   hh:width-chars = 3 .
      248                               end.
      249                           when "b-history" or
      250                           when "b-hist" then
      251                               do:
      252                                   hh:load-image("cmp/b-hist.bmp":u) .
      253                                   hh:TOOLTIP = "История" .
      254                                   v-h[ii] = hh:handle .
      255                                   ii = ii + 1 .
      256                                   hh:width-chars = 3 .
      257                               end.
      258                           when "b-sch" then
      259                               do:
      260                                   hh:load-image("cmp/b-sch.bmp":u) .
      261                                   hh:TOOLTIP = "Установка Фильтра" .
      262                                   v-h[ii] = hh:handle .
      263                                   ii = ii + 1 .
      264                                   hh:width-chars = 3 .
      265                               end.
      266                           when "b-hist-user" then
      267                               do:
      268                                   hh:load-image("cmp/b-hist.bmp":u) .
      269                                   hh:TOOLTIP = "История пользователя" .
      270                                   ii = ii + 1 .
      271                               end.
      272                       end case.
      273                   end.
      274                   hh = hh:next-sibling.
      275               end.
      276               b-help:column = v-frame-width - b-help:width-chars.
      277               jj = 0.
      278               repeat ii = 4 to 1 by -1 :
      279                   if valid-handle (v-h[ii] ) then
      280                   do:
      281                       jj  = jj + 1 .
      282                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      283                       v-h[ii]:row    = v-help-old-y .
      284                   end.
      285               end.
      286           end.
      287       end.
      288   end procedure.
      289   Main-Block:
      290   do on error   undo Main-Block, leave Main-Block
      291      on end-key undo Main-Block, leave Main-Block :
      292     if p-mode <> 'ПРОСМОТР':U then do:
      293       message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
      294               "Неверное значение параметра вызова p-mode:" p-mode
      295       view-as alert-box error.
      296       undo Main-Block, return error.
      297     end.
      298     find ub.c-pump no-lock where recid( ub.c-pump ) = p-rec-id no-error.
      299     if not available ub.c-pump then do:
      300       message "Карточка истории ТРК не найдена!" view-as alert-box error.
      301       undo Main-Block, leave Main-Block.
      302     end.
      303     find buf_cli no-lock where
      304          buf_cli.obj-type = ub.c-pump.obj-type and
      305          buf_cli.obj-code = ub.c-pump.obj-code no-error.
      306     assign frame fr-D-pump-8 :title = "Карточка изменения ТРК " +
      307       substitute( '"&1" (объект &2 &3 "&4") -- &5',
      308                   ub.c-pump.pump-code, ub.c-pump.obj-type, ub.c-pump.obj-code, buf_cli.obj-name, p-mode ).
      309     display ub.c-pump.pump-code
      310             ub.c-pump.obj-type
      311             ub.c-pump.obj-code
      312             buf_cli.obj-name
      313             ub.c-pump.status_
      314             ub.c-pump.PS
      315     with frame fr-D-pump-8.
      316     enable ub.c-pump.PS Btn_Exit b-help with frame fr-D-pump-8.
      317     assign ub.c-pump.PS :read-only in frame fr-D-pump-8 = yes.
      318     if p-mode = 'ПРОСМОТР':U then do: hide Btn_OK in frame fr-D-pump-8. end.
      319     wait-for go of frame fr-D-pump-8.
      320   end.
      321   hide frame fr-D-pump-8 no-pause.
