      406           end.
      407           find first buf_trn-doc exclusive-lock
      408                where buf_trn-doc.doc-code = v-main-trn-doc-code
      409           .
      410           assign
      411               buf_trn-doc.out-code    = buf_fbr-doc.doc-code
      412               buf_trn-doc.print-rubl  = ( if v-rb-is-base = yes then no else yes )
      413               buf_trn-doc.exch-rate   = 1
      414               buf_trn-doc.exch-scale  = 1
      415               buf_trn-doc.exch-code   = 0
      416           .
      417           run get-fbroperator in this-procedure (
      418                 input p-fbr-doc-doc-code
      419               , output buf_trn-doc.agnt
      420               , output buf_trn-doc.boss
      421               , output buf_trn-doc.wrkr
      422           ).
      423           if available buf_out_trn-doc
      424           then do:
      425               assign
      426                   buf_trn-doc.exch-date  = buf_out_trn-doc.exch-date
      427               .
      428           end.
      429           else do:
      430               assign
      431                   buf_trn-doc.exch-date  = v-today
      432               .
      433           end.
      434       end.
      435       assign
      436           p-trn-doc-doc-code = buf_trn-doc.doc-code
      437       .
      438   end.
      439   procedure get-fbroperator :
      440   define input parameter p-fbr-doc-code   as character        no-undo.
      441   define output parameter p-agnt          as integer          no-undo.
      442   define output parameter p-boss          as integer          no-undo.
      443   define output parameter p-wrkr          as integer          no-undo.
      444       define variable v-agntbosswrkr      as character    no-undo.
      445       define variable v-operator-code     as integer      no-undo.
      446       define variable v-operator-string   as integer      no-undo.
      447       define buffer buf_clients       for clients.
      448   do
      449   for buf_clients
      450   on error undo, return error
      451   :
      452       assign
      453           v-operator-code = 0
      454       .
      455       run fbrattr-value in this-procedure (
      456           input 'fbr-doc':U
      457           , input p-fbr-doc-code
      458           , input 'fbroperator':U
      459           , output v-operator-string
      460       ) no-error.
      461       if not error-status :error
      462       then do:
      463           assign
      464               v-operator-code = integer( v-operator-string )
      465           no-error.
      466           if error-status :error
      467           then do:
      468               assign
      469                   v-operator-code = 0
      470               .
      471           end.
      472           else do:
      473               find first buf_clients no-lock
      474                   where buf_clients.obj-type = 'чел':U
      475                   and buf_clients.obj-code = v-operator-code
      476               no-error.
      477               if not available buf_clients
      478               then do:
      479                   assign
      480                       v-operator-code = 0
      481                   .
      482               end.
      483           end.
      484       end.
      485       if v-operator-code > 0
      486       then do:
      487           assign
      488               p-agnt = v-operator-code
      489               p-boss = v-operator-code
      490               p-wrkr = v-operator-code
      491           .
      492       end.
      493   end.
      494   end procedure.
