        1   define input parameter parparentproc as widget-handle no-undo.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Просмотр истории по таблицам".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      112   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      113   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      114   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      115   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      116   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      117   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      118   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      119   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      120   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      121   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      122   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      123   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      124   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      125   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      126   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      127   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      128   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      129   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130     define variable v-cntxt-db-num        as integer   no-undo .
      131     define variable v-cntxt-userid        as character no-undo .
      132     define variable v-cntxt-level         as character no-undo .
      133     define variable v-cntxt-host-code-obj as integer   no-undo .
      134     define variable v-cntxt-obj-type      as character no-undo .
      135     define variable v-cntxt-obj-code      as integer   no-undo .
      136     define variable v-cntxt-db-num-obj    as integer   no-undo .
      137     define variable v-cntxt-is-admin      as logical   no-undo .
      138   define temp-table ttHistory no-undo
      139     field fTable as character label "Таблица" format "X(15)"
      140     field fName  as character label "Наименование объекта" format "X(30)"
      141     field fProc  as character label "Процедура просмотра"
      142     field fLabel as character
      143     field fField as character
      144     field fType  as character
      145   .
      146   define stream inStr.
      147   define variable mMode as character no-undo.
      148   define variable mIdList as character no-undo.
      149   DEFINE MENU POPUP-MENU-b-view
      150          MENU-ITEM m_one          LABEL "По одному объекту"
      151          MENU-ITEM m_all          LABEL "По всем объектам".
      152   DEFINE BUTTON b-exit
      153        LABEL "Выход"
      154        SIZE 15 BY 1.14.
      155   DEFINE BUTTON b-view
      156        LABEL "Просмотр"
      157        SIZE 15 BY 1.14.
      158   DEFINE QUERY BROWSE-tables FOR
      159         ttHistory SCROLLING.
      160   DEFINE BROWSE BROWSE-tables
      161     QUERY BROWSE-tables DISPLAY
      162         ttHistory.fTable
      163         ttHistory.fName
      164       WITH NO-ROW-MARKERS SEPARATORS SIZE 84 BY 15.24 ROW-HEIGHT-CHARS .76 FIT-LAST-COLUMN.
      165   DEFINE FRAME Dialog-Frame
      166        b-exit AT ROW 1.48 COL 3 WIDGET-ID 2
      167        b-view AT ROW 1.48 COL 20 WIDGET-ID 4
      168        BROWSE-tables AT ROW 3.14 COL 3 WIDGET-ID 200
      169        SPACE(1.59) SKIP(0.94)
      170       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      171            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      172            TITLE "История изменений"
      173            CANCEL-BUTTON b-exit WIDGET-ID 100.
      174   ASSIGN
      175          FRAME Dialog-Frame:SCROLLABLE       = FALSE.
      176   ASSIGN
      177          b-view:POPUP-MENU IN FRAME Dialog-Frame       = MENU POPUP-MENU-b-view:HANDLE.
      178   ASSIGN
      179      b-view:MENU-MOUSE = 1.
      180   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      181   DO:
      182     APPLY "END-ERROR":U TO SELF.
      183   END.
      184   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      185   DO:
      186     APPLY "END-ERROR":U TO SELF.
      187   END.
      188   ON RETURN OF BROWSE-tables IN FRAME Dialog-Frame
      189   DO:
      190     apply "choose":U to b-view in frame Dialog-Frame.
      191   END.
      192   ON CHOOSE OF MENU-ITEM m_all
      193   DO:
      194     if not avail ttHistory then
      195       return no-apply.
      196     if ttHistory.fProc = "" then
      197     do:
      198       message "В настройках просмотра истории не задана процедура просмотра истории." skip
      199               "Обратитесь к разработчикам." view-as alert-box.
      200       return no-apply.
      201     end.
      202     if ttHistory.fField = "" then
      203       run getIdent in this-procedure (ttHistory.fTable).
      204     mMode = 'все':U.
      205     run runHistoryProc in this-procedure("", ttHistory.fProc ).
      206   END.
      207   ON CHOOSE OF MENU-ITEM m_one
      208   DO:
      209     define variable vIdent  as character no-undo.
      210     if not avail ttHistory then
      211       return no-apply.
      212     if ttHistory.fProc = "" then
      213     do:
      214       message "В настройках просмотра истории не задана процедура просмотра истории по одному объекту." skip
      215               "Обратитесь к разработчикам." view-as alert-box.
      216       return no-apply.
      217     end.
      218     if ttHistory.fField = "" then
      219       run getIdent in this-procedure (ttHistory.fTable).
      220     run str/histparam.w (ttHistory.fLabel, ttHistory.fType, output vIdent).
      221     if vIdent = "" then
      222       return no-apply.
      223     mMode = "one".
      224     run runHistoryProc in this-procedure(vIdent, ttHistory.fProc).
      225   END.
      226   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      227   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      228   MAIN-BLOCK:
      229   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      230      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      231     run getTables in this-procedure no-error.
      232     if error-status:error then return.
      233     find first sys-ctrl no-lock.
      234   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      235     run mainmenu_getcntxt in parparentproc
      236       (output v-cntxt-db-num
      237       ,output v-cntxt-userid
      238       ,output v-cntxt-level
      239       ,output v-cntxt-host-code-obj
      240       ,output v-cntxt-obj-type
      241       ,output v-cntxt-obj-code
      242       ,output v-cntxt-db-num-obj
      243       ,output v-cntxt-is-admin
      244       ) .
      245     RUN enable_UI.
      246     WAIT-FOR GO OF FRAME Dialog-Frame.
      247   END.
      248   RUN disable_UI.
      249   PROCEDURE disable_UI :
      250     HIDE FRAME Dialog-Frame.
      251   END PROCEDURE.
      252   PROCEDURE enable_UI :
      253     ENABLE b-exit b-view BROWSE-tables
      254         WITH FRAME Dialog-Frame.
      255     OPEN QUERY BROWSE-tables FOR EACH ttHistory by ttHistory.fTable.
      256   END PROCEDURE.
      257   PROCEDURE getIdent :
      258     define input parameter iTable as character no-undo.
      259     define buffer buf_ttHistory for ttHistory.
      260     define buffer buf_file  for ub._File.
      261     define buffer buf_field for ub._Field.
      262     define buffer buf_index for ub._Index.
      263     define buffer buf_index-field for ub._Index-Field.
      264     define variable vComma as character no-undo.
      265     find first buf_ttHistory where buf_ttHistory.fTable = iTable.
      266     for first buf_file no-lock where
      267             buf_file._file-name = iTable
      268        ,first buf_index no-lock where
      269               recid(buf_index) = buf_file._prime-index
      270        ,each  buf_index-field no-lock where
      271               buf_index-field._Index-recid = recid(buf_index)
      272        ,first buf_field no-lock where
      273               recid(buf_field) = buf_index-field._Field-recid
      274     :
      275       assign
      276         vComma = if buf_ttHistory.fField = "" then "" else ","
      277         buf_ttHistory.fField = substitute("&1&2&3", buf_ttHistory.fField, vComma, buf_field._Field-name)
      278         buf_ttHistory.fType  = substitute("&1&2&3", buf_ttHistory.fType, vComma, buf_field._Data-type)
      279         buf_ttHistory.fLabel  = substitute(
      280           "&1&2&3", buf_ttHistory.fLabel,
      281           vComma,
      282           if buf_field._Label <> "" and buf_field._Label <> ? then buf_field._Label else buf_field._Field-name
      283         )
      284       .
      285     end.
      286   END PROCEDURE.
      287   PROCEDURE getTables :
      288   define variable vTable as character no-undo.
      289   define variable vName  as character no-undo.
      290   define variable vProc  as character no-undo.
      291   if search("cmp\history.txt") = ? then
      292   do:
      293     message substitute("Не найден файл настроек &1.","cmp\history.txt") view-as alert-box.
      294     return error.
      295   end.
      296   input stream inStr from value(search("cmp\history.txt")).
      297   READ_FILE:
      298   repeat:
      299     import stream inStr vTable vName vProc.
      300     if vTable begins "//" then next READ_FILE.
      301     create ttHistory.
      302     assign
      303       ttHistory.fTable    = vTable
      304       ttHistory.fName     = vName
      305       ttHistory.fProc     = vProc
      306     .
      307   end.
      308   input stream inStr close.
      309   END PROCEDURE.
      310   PROCEDURE runHistoryProc :
      311     define input parameter pIdent as character no-undo.
      312     define input parameter pProc  as character no-undo.
      313     case ttHistory.fType:
      314       when "character" then do:
      315         run value(pProc) (
      316           if pIdent <> "" then pIdent else ?,
      317           parparentproc,v-cntxt-host-code-obj,v-cntxt-obj-type,v-cntxt-obj-code,'',mMode,?,'','',sys-ctrl.db-num,?,input-output mIdList
      318         ).
      319       end.
      320       when "character,character" then do:
      321         run value(pProc) (
      322           if pIdent <> "" then entry(1,pIdent) else ?,
      323           if pIdent <> "" then entry(2,pIdent) else ?,
      324           parparentproc,v-cntxt-host-code-obj,v-cntxt-obj-type,v-cntxt-obj-code,'',mMode,?,'','',sys-ctrl.db-num,?,input-output mIdList
      325         ).
      326       end.
      327       when "integer,integer" then do:
      328         run value(pProc) (
      329           if pIdent <> "" then int(entry(1,pIdent)) else ?,
      330           if pIdent <> "" then int(entry(2,pIdent)) else ?,
      331           parparentproc,v-cntxt-host-code-obj,v-cntxt-obj-type,v-cntxt-obj-code,'',mMode,?,'','',sys-ctrl.db-num,?,input-output mIdList
      332         ).
      333       end.
      334       when "int64" then do:
      335         run value(pProc) (
      336           if pIdent <> "" then int64(pIdent) else ?,
      337           parparentproc,v-cntxt-host-code-obj,v-cntxt-obj-type,v-cntxt-obj-code,'',mMode,?,'','',sys-ctrl.db-num,?,input-output mIdList
      338         ).
      339       end.
      340       when "integer" then do:
      341         run value(pProc) (
      342           if pIdent <> "" then int(pIdent) else ?,
      343           parparentproc,v-cntxt-host-code-obj,v-cntxt-obj-type,v-cntxt-obj-code,'',mMode,?,'','',sys-ctrl.db-num,?,input-output mIdList
      344         ).
      345       end.
      346       otherwise do:
      347         message
      348           substitute("Для входных параметров типа &1 необходимо доработать вызов просмотра истории.", ttHistory.fType)
      349           view-as alert-box.
      350       end.
      351     end case.
      352   END PROCEDURE.
