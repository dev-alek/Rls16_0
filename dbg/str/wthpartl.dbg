     3711       if v-curr-sv-date <> ?
     3712       then do:
     3713         assign
     3714           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     3715         .
     3716         assign
     3717           self :screen-value = string(v-new-sv-date) .
     3718         .
     3719       end.
     3720     end.
