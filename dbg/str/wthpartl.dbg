      237   procedure thbjattr_code_reg :
      238   define input  parameter p-upper-code     as character no-undo .
      239   define input  parameter p-code           as character no-undo .
      240   define output parameter p-label          as character no-undo .
      241   define output parameter p-user-can-edit  as logical   no-undo .
      242   define output parameter p-output-display as logical   no-undo .
      243   define output parameter p-other          as character no-undo .
      244   define output parameter p-prop-list      as character no-undo .
      245   define output parameter p-prop-type-list as character no-undo .
      246   define output parameter p-prop-label-list as character no-undo .
      247   define output parameter p-global          as logical no-undo .
      248   define output parameter p-host           as logical no-undo .
      249   define output parameter p-shop           as logical no-undo .
      250   define output parameter p-store          as logical no-undo .
      251   define output parameter p-db             as logical no-undo .
      252   define output parameter p-region         as logical no-undo .
      253   do
      254   on error undo, return error return-value
      255   :
      256       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      257       (input  p-upper-code
      258       ,input  p-code
      259       ,output p-label
      260       ,output p-user-can-edit
      261       ,output p-output-display
      262       ,output p-other
      263       ,output p-prop-list
      264       ,output p-prop-type-list
      265       ,output p-prop-label-list
      266       ,output p-global
      267       ,output p-host
      268       ,output p-shop
      269       ,output p-store
      270       ,output p-db
      271       ,output p-region
      272       ) no-error .
      273     if error-status :error
      274     then do:
      275       undo, return error substitute( "&1. &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message (1)).
      276     end.
      277   end.
      278   end procedure.
