     3858   MAIN-BLOCK:
     3859   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3860      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3861      ON stop UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3862     IF lookup(par-mode, 'ДОБАВЛЕНИЕ':U + chr(44) +
     3863                         'ИЗМЕНЕНИЕ':U + chr(44) +
     3864                         'ПРОСМОТР':U) = 0 THEN DO:
     3865       MESSAGE
     3866       "Неверное значение параметра par-mode" par-mode
     3867       VIEW-AS ALERT-BOX ERROR.
     3868       UNDO main-block, RETURN ERROR.
     3869     END.
     3870     if lookup(pout-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) = 0 and (par-mode = 'ДОБАВЛЕНИЕ':U or par-mode = 'ИЗМЕНЕНИЕ':U ) then do:
     3871       find first buf_wth-doc exclusive-lock where
     3872               buf_wth-doc.doc-code = pout-code no-error .
     3873       if NOT available buf_wth-doc then do:
     3874         message substitute('Не найден документ МЦ с номером &1',pout-code) view-as alert-box error.
     3875         return.
     3876       END.
     3877     end.
     3878     IF par-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
     3879          IF par-mode = 'ПРОСМОТР':U THEN DO:
     3880          FIND FIRST LOCKED_wth-parts NO-LOCK WHERE
     3881             recid(LOCKED_wth-parts) = p-rec
     3882             NO-ERROR.
     3883        END.
     3884        ELSE DO:
     3885            FIND FIRST LOCKED_wth-parts exclusive-LOCK WHERE
     3886             recid(LOCKED_wth-parts) = p-rec
     3887               NO-ERROR.
     3888        END.
     3889        IF NOT AVAILABLE LOCKED_wth-parts THEN DO:
     3890           MESSAGE pin-code SKIP pout-code SKIP pfact-rangefrom SKIP pfact-rangeto SKIP
     3891           SUBSTITUTE("Не найдена партия с кодом &1 для МЦ с  кодом &2", ppar-code, pwth-code)
     3892           VIEW-AS ALERT-BOX ERROR.
     3893           UNDO main-block, RETURN ERROR.
     3894        END.
     3895     end.
     3896     FIND FIRST LOCKED_wealth No-LOCK WHERE
     3897               LOCKED_wealth.wth-code = if par-mode = 'ДОБАВЛЕНИЕ':U then pwth-code else LOCKED_wth-parts.wth-code  NO-ERROR.
     3898     IF NOT AVAILABLE LOCKED_wealth THEN DO:
     3899         message vss-workfile vss-revision vss-description skip
     3900         "Не найдена материальная ценность с кодом " pwth-code
     3901         view-as alert-box error.
     3902         return error.
     3903     END.
     3904     FIND FIRST LOCKED_wth-par NO-LOCK WHERE
     3905               LOCKED_wth-par.wth-code = (if par-mode = 'ДОБАВЛЕНИЕ':U then pwth-code  else LOCKED_wth-parts.wth-code)
     3906          AND  LOCKED_wth-par.par-code = (if par-mode = 'ДОБАВЛЕНИЕ':U then ppar-code else LOCKED_wth-parts.par-code)
     3907    NO-ERROR.
     3908     IF NOT AVAILABLE LOCKED_wth-par THEN DO:
     3909         message vss-workfile vss-revision vss-description skip
     3910         "Не найдена материальная ценность с кодом " ppar-code
     3911         view-as alert-box error.
     3912         return error.
     3913     END.
     3914     IF par-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
     3915       if buf_wth-doc.doc-type = 'при':U and not buf_wth-doc.exter_ then do:
     3916         message substitute('Режим добавления для документов внутреннего прихода запрещен!')
     3917         view-as alert-box error.
     3918         return error.
     3919       end.
     3920       CREATE tt-wth-parts.
     3921         IF pwth-code <> 0  THEN do:
     3922           tt-wth-parts.wth-code = LOCKED_wealth.wth-code.
     3923             IF ppar-code <> 0  THEN do:
     3924               tt-wth-parts.par-code = LOCKED_wth-par.par-code.
     3925             END.
     3926         END.
     3927     END.
     3928     ELSE DO:
     3929       FIND FIRST LOCKED_wth-ser NO-LOCK WHERE
     3930                   LOCKED_wth-ser.ser-code = LOCKED_wth-parts.ser-code
     3931              AND  LOCKED_wth-ser.db-num = LOCKED_wth-parts.db-num          NO-ERROR.
     3932       IF NOT AVAILABLE LOCKED_wth-ser THEN DO:
     3933           MESSAGE
     3934           SUBSTITUTE("Не найдена серия с кодом &1-&2", LOCKED_wth-parts.ser-code,  LOCKED_wth-parts.db-num)
     3935           VIEW-AS ALERT-BOX ERROR.
     3936           UNDO main-block, RETURN ERROR.
     3937       END.
     3938       CREATE tt-wth-parts.
     3939       BUFFER-COPY LOCKED_wth-parts TO tt-wth-parts.
     3940     END.
     3941   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3942     run mainmenu_getcntxt in parparentproc
     3943       (output v-cntxt-db-num
     3944       ,output v-cntxt-userid
     3945       ,output v-cntxt-level
     3946       ,output v-cntxt-host-code-obj
     3947       ,output v-cntxt-obj-type
     3948       ,output v-cntxt-obj-code
     3949       ,output v-cntxt-db-num-obj
     3950       ,output v-cntxt-is-admin
     3951       ) .
     3952     RUN Myenable IN THIS-PROCEDURE NO-ERROR.
     3953     RUN disp-fl.
     3954     WAIT-FOR GO OF FRAME Dialog-Frame.
     3955   END.
     3956   RUN disable_UI.
     3957   PROCEDURE disable_UI :
     3958     HIDE FRAME Dialog-Frame.
     3959   END PROCEDURE.
     3960   PROCEDURE disp-fl :
     3961   define variable v-vat-pc as decimal no-undo.
     3962   define variable v-beg-dt as date    no-undo.
     3963   define variable v-end-dt as date    no-undo.
     3964   define variable v-mpl-date as date    no-undo.
     3965   define variable v-price-rubl       LIKE ub.wth-parts.price-rubl no-undo .
     3966   define variable v-price-base       LIKE ub.wth-parts.price-base no-undo .
     3967   DEF BUFFER b-cash-pay FOR ub.cash-pay.
     3968   DEF BUFFER b-clients  FOR ub.clients.
     3969       fill-in-6:SCREEN-VALUE IN FRAME Dialog-Frame = "            Серия".
     3970       fill-in-2:SCREEN-VALUE IN FRAME Dialog-Frame = "         Диапазон (факт)".
     3971       fill-in-3:SCREEN-VALUE IN FRAME Dialog-Frame = "        Диапазон (док)".
     3972       fill-in-4:SCREEN-VALUE IN FRAME Dialog-Frame = "        Срок годности".
     3973       fill-in-5:SCREEN-VALUE IN FRAME Dialog-Frame = "           Цена".
     3974     IF AVAILABLE locked_wth-parts THEN DO WITH FRAME Dialog-Frame:
     3975         DISP
     3976         locked_wealth.wth-name @ fl-wth-name
     3977         LOCKED_wth-par.par-val @ fl-par-val
     3978         LOCKED_wth-par.par-rate @ fl-par-rate
     3979         LOCKED_wth-ser.maska @ fl-maska.
     3980         FIND FIRST b-goods WHERE b-goods.gds-code = locked_wth-parts.gds-code NO-LOCK NO-ERROR.
     3981         IF AVAILABLE b-goods THEN do:
     3982                                   DISP b-goods.artic     @ fl-artic
     3983                                        b-goods.prod-type @ fl-prodType
     3984                                        b-goods.prod-code @ fl-prodCode
     3985                                        b-goods.gds-name  @ fl-gds.
     3986           FIND FIRST b-clients WHERE b-clients.obj-type = b-goods.prod-type AND
     3987                b-clients.obj-code = b-goods.prod-code NO-LOCK NO-ERROR.
     3988           IF AVAILABLE b-clients THEN DISP b-clients.obj-name @ fl-obj-name.
     3989         END.
     3990         ELSE   ASSIGN fl-artic:SCREEN-VALUE = '?':U
     3991                fl-prodType:SCREEN-VALUE = '?':U
     3992                fl-prodCode:SCREEN-VALUE = '?':U
     3993                fl-gds:SCREEN-VALUE = '?':U.
     3994         if available buf_wth-doc
     3995         and (buf_wth-doc.ext-doc-type = 'ee':U or  (buf_wth-doc.doc-type = 'обмен':U and ptype = 'рас':U))
     3996         and par-mode = 'ИЗМЕНЕНИЕ':U and
     3997         tt-wth-parts.beg-dt = ? AND tt-wth-parts.end-dt = ? THEN DO:
     3998               RUN init_prtdate ( INPUT buf_wth-doc.obj-type
     3999                                 ,INPUT buf_wth-doc.obj-code
     4000                                 ,INPUT locked_wth-ser.ser-code
     4001                                 ,INPUT locked_wth-ser.db-num
     4002                                 ,INPUT buf_wth-doc.doc-date
     4003                                 ,OUTPUT v-beg-dt
     4004                                 ,OUTPUT v-end-dt ) NO-ERROR.
     4005               if error-status:error then do:
     4006                message return-value skip
     4007                 error-status:get-message(1)
     4008                view-as alert-box error .
     4009               end.
     4010               else do:
     4011                 disp  v-beg-dt @ tt-wth-parts.beg-dt
     4012                       v-end-dt @ tt-wth-parts.end-dt
     4013                 with frame Dialog-Frame.
     4014               end.
     4015         END.
     4016         if available buf_wth-doc
     4017         and (buf_wth-doc.ext-doc-type = 'ee':U or  (buf_wth-doc.doc-type = 'обмен':U and ptype = 'рас':U))
     4018         and par-mode = 'ИЗМЕНЕНИЕ':U and
     4019         (tt-wth-parts.price-rubl = 0 or tt-wth-parts.price-rubl = ? ) then do:
     4020                 v-beg-dt = date(tt-wth-parts.beg-dt:screen-value) no-error.
     4021                 run set-wthmpl-date ( buf_wth-doc.doc-code
     4022                               ,buf_wth-doc.doc-date
     4023                               , v-beg-dt
     4024                               , output v-mpl-date) no-error.
     4025                     RUN INIT_prtprice (
     4026                             buf_wth-doc.host-code
     4027                           , buf_wth-doc.obj-type
     4028                           , buf_wth-doc.obj-code
     4029                           , buf_wth-doc.cli-type
     4030                           , buf_wth-doc.cli-code
     4031                           , locked_wth-parts.wth-code
     4032                           , locked_wth-parts.gds-code
     4033                           , locked_wth-parts.par-code
     4034                           , v-mpl-date
     4035                           , OUTPUT  v-vat-pc
     4036                           , OUTPUT  v-price-rubl
     4037                           , OUTPUT  v-price-base
     4038                   ) NO-ERROR.
     4039             if error-status:error then undo, return error return-value + error-status:get-message(1) .
     4040            tt-wth-parts.vat-pc:screen-value = string(v-vat-pc).
     4041            tt-wth-parts.price-rubl:screen-value = string(v-price-rubl).
     4042            apply 'leave':U to tt-wth-parts.price-rubl.
     4043          end.
     4044     END.
     4045     ELSE DO:
     4046         FIND FIRST b-wealth WHERE b-wealth.wth-code = pwth-code NO-LOCK NO-ERROR.
     4047         IF AVAILABLE b-wealth THEN fl-wth-name:SCREEN-VALUE = b-wealth.wth-name.
     4048         ELSE fl-wth-name:SCREEN-VALUE = '?':U.
     4049         FIND FIRST b-wth-par WHERE b-wth-par.wth-code =  pwth-code AND b-wth-par.par-code = ppar-code NO-LOCK NO-ERROR.
     4050         IF AVAILABLE b-wth-par THEN do: fl-par-val:SCREEN-VALUE = string(b-wth-par.par-val).
     4051                                         fl-par-rate:SCREEN-VALUE = string(b-wth-par.par-rate).
     4052         END.
     4053         ELSE do:
     4054             fl-par-val:SCREEN-VALUE = '?':U.
     4055             fl-par-rate:SCREEN-VALUE = '0':U.
     4056         END.
     4057         find first buf_wth-gds no-lock where
     4058                 buf_wth-gds.wth-code = pwth-code   no-error .
     4059         if available buf_wth-gds then do:
     4060             FIND FIRST b-goods WHERE b-goods.gds-code = buf_wth-gds.gds-code NO-LOCK NO-ERROR.
     4061             IF AVAILABLE b-goods THEN DO:  fl-artic:SCREEN-VALUE = b-goods.artic .
     4062                                            fl-prodType:SCREEN-VALUE = string(b-goods.prod-type).
     4063                                            fl-prodCode:SCREEN-VALUE = string(b-goods.prod-code).
     4064                                            fl-gds:SCREEN-VALUE = b-goods.gds-name .
     4065                FIND FIRST b-clients WHERE b-clients.obj-type = b-goods.prod-type AND
     4066                     b-clients.obj-code = b-goods.prod-code NO-LOCK NO-ERROR.
     4067                IF AVAILABLE b-clients THEN fl-obj-name:SCREEN-VALUE = b-clients.obj-name.
     4068             END.
     4069             ELSE   ASSIGN fl-artic:SCREEN-VALUE = '?':U
     4070                    fl-prodType:SCREEN-VALUE = '?':U
     4071                    fl-prodCode:SCREEN-VALUE = '?':U
     4072                    fl-gds:SCREEN-VALUE = '?':U.
     4073         end.
     4074         if par-mode = 'ДОБАВЛЕНИЕ':U and not available LOCKED_wth-ser then do:
     4075           find buf_wth-ser where buf_wth-ser.wth-code = pwth-code
     4076                              and buf_wth-ser.wth-code = ppar-code
     4077                              and  buf_wth-ser.stts = 0 no-lock no-error.
     4078           if available buf_wth-ser then do:
     4079             find first locked_wth-ser no-LOCK WHERE
     4080                 recid(locked_wth-ser) = recid(buf_wth-ser) NO-ERROR.
     4081             if available locked_wth-ser then do:
     4082               ASSIGN tt-wth-parts.ser-code:SCREEN-VALUE = STRING(LOCKED_wth-ser.ser-code)
     4083                    tt-wth-parts.db-num:SCREEN-VALUE = string(LOCKED_wth-ser.db-num)
     4084                    fl-maska:SCREEN-VALUE = LOCKED_wth-ser.maska
     4085                    .
     4086             end.
     4087           end.
     4088         end.
     4089     END.
     4090   END PROCEDURE.
     4091   PROCEDURE enable_UI :
     4092     OPEN QUERY Dialog-Frame FOR EACH tt-wth-parts SHARE-LOCK.
     4093     GET FIRST Dialog-Frame.
     4094     DISPLAY fl-artic fl-gds fl-prodType fl-maska fl-ProdCode fl-obj-name
     4095             fl-wth-name fl-par-val fl-par-rate FILL-IN-2 FILL-IN-3 FILL-IN-4
     4096             FILL-IN-5 FILL-IN-6
     4097         WITH FRAME Dialog-Frame.
     4098     IF AVAILABLE tt-wth-parts THEN
     4099       DISPLAY tt-wth-parts.VAT-pc tt-wth-parts.wth-code tt-wth-parts.par-code
     4100             tt-wth-parts.ser-code tt-wth-parts.db-num tt-wth-parts.fact-rangeFrom
     4101             tt-wth-parts.fact-rangeTo tt-wth-parts.doc-rangeFrom
     4102             tt-wth-parts.doc-rangeTo tt-wth-parts.fact-qnty tt-wth-parts.qnty-doc
     4103             tt-wth-parts.beg-dt tt-wth-parts.end-dt tt-wth-parts.price-rubl
     4104             tt-wth-parts.price-base
     4105         WITH FRAME Dialog-Frame.
     4106     ENABLE B-exit b-quit B-Help fl-artic fl-gds fl-prodType fl-maska fl-ProdCode
     4107            fl-obj-name tt-wth-parts.wth-code fl-wth-name tt-wth-parts.par-code
     4108            fl-par-val fl-par-rate tt-wth-parts.ser-code B-wth-ser
     4109            tt-wth-parts.db-num tt-wth-parts.fact-rangeFrom
     4110            tt-wth-parts.fact-rangeTo tt-wth-parts.doc-rangeFrom
     4111            tt-wth-parts.doc-rangeTo tt-wth-parts.fact-qnty tt-wth-parts.qnty-doc
     4112            tt-wth-parts.beg-dt b-choose-last-date tt-wth-parts.end-dt
     4113            b-choose-last-date-po tt-wth-parts.price-rubl tt-wth-parts.price-base
     4114            RECT-1 RECT-2 RECT-3 RECT-4 RECT-5
     4115         WITH FRAME Dialog-Frame.
     4116     VIEW FRAME Dialog-Frame.
     4117   END PROCEDURE.
     4118   PROCEDURE MyEnable :
     4119   ENABLE
     4120   B-exit WHEN par-mode <> 'ПРОСМОТР':U
     4121   b-quit
     4122   B-Help
     4123   WITH FRAME Dialog-Frame.
     4124   IF par-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
     4125       ENABLE
     4126       b-wth-ser
     4127       tt-wth-parts.doc-rangeFrom
     4128       tt-wth-parts.doc-rangeTo
     4129       WITH FRAME Dialog-Frame.
     4130   END.
     4131   DISPLAY
     4132      tt-wth-parts.VAT-pc tt-wth-parts.wth-code tt-wth-parts.par-code tt-wth-parts.ser-code tt-wth-parts.db-num tt-wth-parts.fact-rangeFrom tt-wth-parts.fact-rangeTo tt-wth-parts.doc-rangeFrom tt-wth-parts.doc-rangeTo tt-wth-parts.fact-qnty tt-wth-parts.qnty-doc tt-wth-parts.beg-dt tt-wth-parts.end-dt tt-wth-parts.price-rubl tt-wth-parts.price-base
     4133   WITH FRAME Dialog-Frame  .
     4134   IF par-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     4135       ENABLE
     4136           tt-wth-parts.fact-rangeFrom WHEN (buf_wth-doc.doc-type = 'при':U and not buf_wth-doc.exter_)
     4137           tt-wth-parts.fact-rangeTo   WHEN (buf_wth-doc.doc-type = 'при':U and not buf_wth-doc.exter_)
     4138           tt-wth-parts.doc-rangeFrom  WHEN not (buf_wth-doc.doc-type = 'при':U and not buf_wth-doc.exter_)
     4139           tt-wth-parts.doc-rangeTo    WHEN not (buf_wth-doc.doc-type = 'при':U and not buf_wth-doc.exter_)
     4140    WITH FRAME Dialog-Frame.
     4141   END.
     4142   if (par-mode = 'ИЗМЕНЕНИЕ':U or par-mode = 'ДОБАВЛЕНИЕ':U) and
     4143      (buf_wth-doc.ext-doc-type = 'ee':U or
     4144       (buf_wth-doc.ext-doc-type = 'xc':U    and ptype = 'рас':U))
     4145       then do:
     4146         enable
     4147           tt-wth-parts.price-rubl
     4148         WITH FRAME Dialog-Frame.
     4149        if locked_wth-ser.chk-bdt <> 0 then do:
     4150           disable
     4151             tt-wth-parts.beg-dt
     4152             b-choose-last-date
     4153             WITH FRAME Dialog-Frame.
     4154         end.
     4155         else do:
     4156           enable
     4157             tt-wth-parts.beg-dt
     4158             b-choose-last-date
     4159             WITH FRAME Dialog-Frame.
     4160         end.
     4161         if locked_wth-ser.chk-edt <> 0 then do:
     4162           disable
     4163             tt-wth-parts.end-dt
     4164             b-choose-last-date-po
     4165             WITH FRAME Dialog-Frame.
     4166         end.
     4167         else do:
     4168           enable
     4169             tt-wth-parts.end-dt
     4170             b-choose-last-date-po
     4171             WITH FRAME Dialog-Frame.
     4172         end.
     4173   end.
     4174   if tt-wth-parts.stts = 1 and par-mode = 'ПРОСМОТР':U then do:
     4175     tt-wth-parts.fact-rangeFrom:screen-value = '?'.
     4176     tt-wth-parts.fact-rangeTo:screen-value = '?'.
     4177     tt-wth-parts.fact-qnty:screen-value = '0'.
     4178   end.
     4179   IF par-mode = 'ПРОСМОТР':U THEN DO:
     4180     HIDE
     4181     b-exit IN FRAME Dialog-Frame
     4182     .
     4183     ASSIGN
     4184     b-quit:COLUMN = 1
     4185     b-quit:LABEL = "&Выход".
     4186   END.
     4187   VIEW FRAME Dialog-Frame.
     4188   frame Dialog-Frame:title = substitute("&1 &2"
     4189                                        ,frame Dialog-Frame:title
     4190                                        ,par-mode
     4191                                        ).
     4192   APPLY 'entry':U TO b-wth-ser.
     4193   END PROCEDURE.
     4194   PROCEDURE proc-save :
     4195   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     4196   DEFINE VARIABLE v-EndDate AS date NO-UNDO.
     4197   DEFINE VARIABLE v-BegDate AS date NO-UNDO.
     4198   IF par-mode = 'ПРОСМОТР':U THEN UNDO, RETURN.
     4199   assign
     4200   FRAME Dialog-Frame tt-wth-parts.VAT-pc tt-wth-parts.wth-code tt-wth-parts.par-code tt-wth-parts.ser-code tt-wth-parts.db-num tt-wth-parts.fact-rangeFrom tt-wth-parts.fact-rangeTo tt-wth-parts.doc-rangeFrom tt-wth-parts.doc-rangeTo tt-wth-parts.fact-qnty tt-wth-parts.qnty-doc tt-wth-parts.beg-dt tt-wth-parts.end-dt tt-wth-parts.price-rubl tt-wth-parts.price-base.
     4201   if  par-mode = 'ИЗМЕНЕНИЕ':U then v-rec = recid(locked_wth-parts).
     4202   do transaction on error undo, return error
     4203                  on stop  undo, return error
     4204                  on quit  undo, return error :
     4205     if buf_wth-doc.ext-doc-type = 'ee':U or
     4206       (buf_wth-doc.ext-doc-type = 'xc':U    and ptype = 'рас':U)
     4207       and available locked_wth-ser
     4208      then do:
     4209       if locked_wth-ser.chk-bdt = 2 and locked_wth-ser.beg-dt <> ? then v-BegDate = locked_wth-ser.beg-dt.
     4210       else  v-BegDate = tt-wth-parts.beg-dt.
     4211       if locked_wth-ser.chk-edt = 2 and locked_wth-ser.end-dt <> ? then v-EndDate = locked_wth-ser.end-dt.
     4212       else  v-EndDate = tt-wth-parts.end-dt.
     4213       if (v-BegDate = ? and not locked_wth-ser.chk-bdt = 1)  or (v-EndDate = ? and not locked_wth-ser.chk-edt = 1)  then do:
     4214           message 'Не указан срок действия партии' view-as alert-box error.
     4215           apply 'entry':U to tt-wth-parts.beg-dt.
     4216           return error.
     4217       end.
     4218       if not (v-BegDate = ? or v-EndDate = ?) and v-BegDate > v-EndDate  then do:
     4219           message 'Неверно указан срок действия партии' view-as alert-box error.
     4220           apply 'entry':U to tt-wth-parts.beg-dt.
     4221           return error.
     4222       end.
     4223       if tt-wth-parts.price-rubl = 0 OR  tt-wth-parts.price-rubl = ? then do:
     4224           message 'Не указана цена!.' view-as alert-box error.
     4225           apply 'entry':U to tt-wth-parts.price-rubl.
     4226           return error.
     4227       end.
     4228     end.
     4229     if buf_wth-doc.doc-type = 'при':U and buf_wth-doc.exter_ = no then do:
     4230       run wth-parts-inter-edit in this-procedure ( INPUT tt-wth-parts.fact-rangeFrom ,
     4231                                                    INPUT tt-wth-parts.fact-rangeTo  ,
     4232                                                    INPUT-OUTPUT v-rec
     4233                                                   )  no-error.
     4234       if error-status:error then do:
     4235           MESSAGE RETURN-VALUE VIEW-AS ALERT-BOX ERROR.
     4236           apply 'entry':U to tt-wth-parts.fact-rangeFrom.
     4237           undo, return error.
     4238       end.
     4239     end.
     4240     else if lookup(buf_wth-doc.ext-doc-type,'ie,ip,rp,fj,pj,ff,rf':U) > 0   then do:
     4241             run str/wthpartp.p    ( INPUT    par-mode,
     4242                       INPUT     buf_wth-doc.obj-type,
     4243                       INPUT     buf_wth-doc.obj-code,
     4244                       INPUT     pw-p-code,
     4245                       INPUT     tt-wth-parts.wth-code,
     4246                       INPUT     tt-wth-parts.par-code,
     4247                       INPUT     tt-wth-parts.in-code ,
     4248                       INPUT     buf_wth-doc.doc-code,
     4249                       INPUT     tt-wth-parts.ser-code,
     4250                       INPUT     tt-wth-parts.db-num  ,
     4251                       INPUT     tt-wth-parts.fact-rangeFrom ,
     4252                       INPUT     tt-wth-parts.fact-rangeTo  ,
     4253                       INPUT     tt-wth-parts.doc-rangeFrom ,
     4254                       INPUT     tt-wth-parts.doc-rangeTo,
     4255                       INPUT     buf_wth-doc.host-code     ,
     4256                       INPUT     buf_wth-doc.contract-code  ,
     4257                       INPUT     tt-wth-parts.price-rubl    ,
     4258                       INPUT     tt-wth-parts.price-base    ,
     4259                       INPUT     tt-wth-parts.supp-type,
     4260                       INPUT     tt-wth-parts.supp-code,
     4261                       INPUT     tt-wth-parts.in-obj-type ,
     4262                       INPUT     tt-wth-parts.in-obj-code ,
     4263                       INPUT     buf_wth-doc.ext-doc-type,
     4264                       INPUT     b-goods.gds-code,
     4265                       INPUT     tt-wth-parts.stts  ,
     4266                       INPUT     tt-wth-parts.beg-dt  ,
     4267                       INPUT     tt-wth-parts.end-dt  ,
     4268                       INPUT     tt-wth-parts.vat-pc  ,
     4269                       INPUT     tt-wth-parts.cli-code,
     4270                       INPUT     tt-wth-parts.cli-type,
     4271                       INPUT     tt-wth-parts.out-obj-code,
     4272                       INPUT     tt-wth-parts.out-obj-type,
     4273                       INPUT     tt-wth-parts.sale-obj-code,
     4274                       INPUT     tt-wth-parts.sale-obj-type,
     4275                       INPUT     buf_wth-doc.doc-code,
     4276                       INPUT     no,
     4277                       INPUT     ptype,
     4278                       INPUT-OUTPUT v-rec
     4279                       ) no-error.
     4280         if error-status:error then DO:
     4281   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4282   define variable fh as widget-handle no-undo .
     4283   define variable hh as widget-handle no-undo .
     4284   define variable rv as character no-undo .
     4285   assign
     4286   rv = entry(1, return-value , chr(4)).
     4287   if rv <> "":U then do:
     4288     assign
     4289     fh = frame Dialog-Frame:first-child
     4290     hh = fh:first-child
     4291     .
     4292     do while valid-handle(hh):
     4293       if hh:name = rv then do:
     4294         APPLY "ENTRY" to hh.
     4295         undo ,
     4296         return error.
     4297       end.
     4298       hh = hh:next-sibling.
     4299     end.
     4300   end.
     4301           undo , return error.
     4302         end.
     4303     end.
     4304     else do:
     4305       if LOCKED_wth-parts.out-code = pout-code then do:
     4306         run  wth-doc-razrez ( input RECID(LOCKED_wth-parts),
     4307                               input no) no-error.
     4308         if error-status:error then DO:
     4309           MESSAGE RETURN-VALUE + chr(10) + error-status:get-message(1) VIEW-AS ALERT-BOX ERROR.
     4310           undo, return error.
     4311         end.
     4312         v-rec = ?.
     4313       end.
     4314       RUN wth-parts-rezerv ( yes
     4315                            ,tt-wth-parts.fact-rangeFrom
     4316                           , tt-wth-parts.fact-RangeTo
     4317                           , tt-wth-parts.beg-dt
     4318                           , tt-wth-parts.end-dt
     4319                           , tt-wth-parts.ser-code
     4320                           , tt-wth-parts.db-num
     4321                           , tt-wth-parts.price-rubl
     4322                           , tt-wth-parts.price-base
     4323                           , tt-wth-parts.vat-pc
     4324                           , p-curr-host-code
     4325                           , pobj-type
     4326                           , pobj-code
     4327                           , pw-p-code
     4328                           , pwth-code
     4329                           , ppar-code
     4330                           , pin-code
     4331                           , pout-code
     4332                           , tt-wth-parts.cli-type
     4333                           , tt-wth-parts.cli-code
     4334                           , buf_wth-doc.ext-doc-type
     4335                           , b-goods.gds-code
     4336                           , ptype
     4337                           , INPUT-OUTPUT v-rec
     4338                           ) no-error .
     4339       if error-status:error then do:
     4340           MESSAGE RETURN-VALUE VIEW-AS ALERT-BOX ERROR.
     4341           undo, return error.
     4342       end.
     4343     end.
     4344   end.
     4345   p-rec = v-rec.
     4346   END PROCEDURE.
