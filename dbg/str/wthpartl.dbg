      460       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_delete-section in g#attr-lib
      461       (input  p-obj-type
      462       ,input  p-obj-code
      463       ,input  p-upper-code
      464       ) no-error .
      465     if error-status :error
      466     then do:
      467       undo, return error return-value .
      468     end.
      469   end.
      470   end procedure.
      471   procedure thbjattr_manual-edit :
