      207      define output parameter p-user-can-edit  as logical   no-undo .
      208      define output parameter p-output-display as logical   no-undo .
      209      define output parameter p-other          as character no-undo .
      210      define output parameter p-prop-list      as character no-undo .
      211      define output parameter p-prop-type-list as character no-undo .
      212      define output parameter p-prop-label-list as character no-undo .
      213      define output parameter p-global          as logical no-undo .
      214      define output parameter p-host           as logical no-undo .
      215      define output parameter p-shop           as logical no-undo .
      216      define output parameter p-store          as logical no-undo .
      217      define output parameter p-db             as logical no-undo .
