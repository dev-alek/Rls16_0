        1   DEFINE TEMP-TABLE tt-wth-parts NO-UNDO LIKE ub.wth-parts.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo .
        4   define input parameter pobj-type  like ub.clients.obj-type no-undo .
        5   define input parameter pobj-code  like ub.clients.obj-code no-undo .
        6   define input parameter par-mode as CHARACTER no-undo.
        7   define input parameter pw-p-code as integer no-undo.
        8   define input parameter pwth-code   as integer no-undo.
        9   define input parameter ppar-code as integer no-undo.
       10   define input parameter pin-code as CHARACTER no-undo.
       11   define input parameter pout-code as CHARACTER no-undo.
       12   define input parameter pser-code as integer no-undo.
       13   define input parameter pdb-num as integer no-undo.
       14   define input parameter pfact-rangefrom as integer no-undo.
       15   define input parameter pfact-rangeto as INTEGER no-undo.
       16   define input parameter ptype as CHARACTER no-undo.
       17   define input-output PARAMETER p-rec as recid no-undo.
       18   define variable vss-revision    as character no-undo init "$Revision$":U .
       19   define variable vss-author      as character no-undo init "$Author$":U .
       20   define variable vss-date        as character no-undo init "$Date$":U .
       21   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       22   define variable vss-archive     as character no-undo init "$Archive$":U .
       23   define variable vss-description as character no-undo init "Диалог добавлени\изменения партии серийных МЦ".
       24   procedure vss-get-info :
       25     define output parameter p-vss-revision    like vss-revision    no-undo .
       26     define output parameter p-vss-author      like vss-author      no-undo .
       27     define output parameter p-vss-date        like vss-date        no-undo .
       28     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       29     define output parameter p-vss-archive     like vss-archive     no-undo .
       30     define output parameter p-vss-description like vss-description no-undo .
       31     assign
       32       p-vss-revision    = vss-revision
       33       p-vss-author      = vss-author
       34       p-vss-date        = vss-date
       35       p-vss-workfile    = vss-workfile
       36       p-vss-archive     = vss-archive
       37       p-vss-description = vss-description
       38     .
       39   end procedure.
       40   procedure vss-get-parameters :
       41     define output parameter p-vss-parameters as character no-undo .
       42   end procedure.
       43   define new global shared variable g#vssrevis-logger as handle    no-undo .
       44   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       45   define variable v-vssrevis-logger                   as handle    no-undo .
       46   procedure vss-logevent :
       47     define input  parameter p-extra-paramters as character no-undo .
       48     define variable v-vssrevis-parameters as character no-undo .
       49     do
       50     on error undo, return error return-value
       51     :
       52       if  valid-handle(v-vssrevis-logger)
       53       and v-vssrevis-logger :get-signature("logevent") <> ""
       54       then do:
       55         run vss-get-parameters in this-procedure
       56           (output v-vssrevis-parameters
       57           ).
       58         run logevent in v-vssrevis-logger
       59           (input vss-workfile
       60           ,input vss-revision
       61           ,input v-vssrevis-parameters
       62           ,input p-extra-paramters
       63           ).
       64       end.
       65     end.
       66   end procedure.
       67   assign
       68     v-vssrevis-logger = g#vssrevis-logger
       69   .
       70   if  valid-handle(v-vssrevis-logger)
       71   and v-vssrevis-logger :get-signature("logevent") <> ""
       72   then do:
       73     assign
       74       v-vssrevis-logevent = true
       75     .
       76     run vss-logevent in this-procedure (input vss-description) .
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   define new global shared variable g#language as character no-undo .
       81   if g#language <> '' and g#language <> 'rus':U then do:
       82     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       83   end.
       84   define   shared variable g#auto as logical no-undo.
       85   define   shared variable g#news as logical no-undo.
       86   define   shared variable g#oxml as logical no-undo.
       87   define   shared variable g#esys as logical no-undo.
       88   define   shared variable g#news-source-db as integer no-undo.
       89   define   shared variable g#esys-source-esys as integer no-undo.
       90   define   shared variable g#db-num as integer   no-undo .
       91   define   shared variable g#userid as character no-undo .
       92   define   shared variable g#passwd as character no-undo .
       93   procedure proc-alt-shift-f2:
       94     if not ibs.th.gbl.gbl-var:rcode
       95   then
       96     run gbl\inidebug.p .
       97   end.
       98   procedure proc-alt-shift-f3:
       99     run gbl/prvssinf.p
      100       ( input this-procedure
      101       ) .
      102   end.
      103   define variable v-inform-launched as logical no-undo initial false .
      104   procedure proc-alt-shift-f4:
      105     define variable v-action as character no-undo .
      106     if v-inform-launched = false then do:
      107       assign
      108         v-inform-launched = true
      109       .
      110       run gbl/d-inform.w
      111         (  input self
      112         ,  input this-procedure
      113         , output v-action
      114         ) no-error .
      115       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      116       assign
      117         v-inform-launched = false
      118       .
      119     end.
      120   end.
      121   procedure proc-alt-f1:
      122     run gbl/corrhelp.p
      123       (input this-procedure
      124       ) .
      125   end .
      126   on alt-shift-f2 anywhere do:
      127     run proc-alt-shift-f2.
      128   end.
      129   on alt-shift-f3 anywhere do:
      130     run proc-alt-shift-f3 in this-procedure .
      131   end.
      132   on alt-shift-f4 anywhere do:
      133     run proc-alt-shift-f4 in this-procedure.
      134   end.
      135   on alt-f1 anywhere do:
      136     run proc-alt-f1 in this-procedure .
      137   end.
      138   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      139     define variable v-cntxt-db-num        as integer   no-undo .
      140     define variable v-cntxt-userid        as character no-undo .
      141     define variable v-cntxt-level         as character no-undo .
      142     define variable v-cntxt-host-code-obj as integer   no-undo .
      143     define variable v-cntxt-obj-type      as character no-undo .
      144     define variable v-cntxt-obj-code      as integer   no-undo .
      145     define variable v-cntxt-db-num-obj    as integer   no-undo .
      146     define variable v-cntxt-is-admin      as logical   no-undo .
      147   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      148   procedure sel-date :
      149     define input  parameter p-date-handle as handle    no-undo .
      150     define input  parameter p-description as character no-undo .
      151     do
      152     on error undo, return error return-value
      153     :
      154       if (can-query (p-date-handle, "sensitive")
      155         and
      156         p-date-handle :sensitive = true
      157         )
      158       or (can-query (p-date-handle, "read-only")
      159         and
      160         p-date-handle :read-only = false
      161         )
      162       then do:
      163         if p-date-handle :handle <> focus :handle
      164         then do:
      165           apply "entry":u to p-date-handle .
      166         end.
      167         define variable v-ok            as logical no-undo .
      168         define variable v-curr-sv-date as date no-undo .
      169         assign
      170           v-curr-sv-date = date(p-date-handle :screen-value) no-error
      171         .
      172         if v-curr-sv-date = ?
      173         then do:
      174           run gbl/getcurdt.p
      175             (output v-curr-sv-date
      176             ) .
      177         end.
      178         if v-curr-sv-date <> ?
      179         then do:
      180           run gbl/d-inpday.w
      181             (input ?
      182             ,input "Выбор даты"
      183             ,input p-description
      184             ,input ""
      185             ,input-output v-curr-sv-date
      186             ,output v-ok
      187             ).
      188           if v-ok = true
      189           then do:
      190             assign
      191               p-date-handle :screen-value = string(v-curr-sv-date) .
      192             .
      193           end.
      194         end.
      195       end.
      196     end.
      197   end procedure.
      198   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      199   define new global shared variable g#attr-lib  as handle no-undo .
