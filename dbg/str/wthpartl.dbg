      489   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      490   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      491   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      492   procedure cur-time :
      493      define output parameter p-today as date      no-undo .
      494      define output parameter p-time  as integer   no-undo .
      495     do
      496     on error undo, return error
      497     :
      498       define variable v-date1 as date      no-undo .
      499       define variable v-date2 as date      no-undo .
      500       define variable v-time  as integer   no-undo .
      501       assign
      502         v-date1 = today
      503         v-time  = time
      504         v-date2 = today
      505       .
      506       if v-date1 <> v-date2
      507       then do:
      508         assign
      509           v-date1 = today
      510           v-time  = v-time
      511         .
      512       end.
      513       assign
      514         p-today = v-date1
      515         p-time  = v-time
      516       .
      517     end.
      518   end.
      519   function cur-time-date returns character
      520   :
      521     return string(today, '99/99/9999':U) .
      522   end.
      523   function cur-time-mjd returns decimal
      524   :
      525     define variable v-date as date      no-undo .
      526     define variable v-time as integer   no-undo .
      527     run cur-time in this-procedure
      528       (output v-date
      529       ,output v-time
      530       ) .
      531     return integer(v-date) - 2400002 + (v-time / 86400) .
      532   end.
      533   function cur-time-get-ending-index returns integer
      534   (input p-number as integer
      535   )
      536   :
      537     if p-number < 0
      538     or p-number = ?
      539     then do:
      540       return 1 .
      541     end.
      542     define variable v-rest as integer   no-undo .
      543     assign
      544       p-number = p-number modulo 100
      545     .
      546     if p-number < 20
      547     then do:
      548       assign
      549         v-rest = p-number
      550       .
      551     end.
      552     else do:
      553       assign
      554         v-rest = p-number modulo 10
      555       .
      556     end.
      557     case v-rest :
      558       when 1
      559       then do:
      560         return 2 .
      561       end.
      562       when 2 or
      563       when 3 or
      564       when 4
      565       then do:
      566         return 3 .
      567       end.
      568       otherwise do:
      569         return 1 .
      570       end.
      571     end case .
      572   end.
      573   procedure cur-time-mjd-to-date :
      574      define input  parameter i-mjd-diff as decimal no-undo.
      575      define output parameter o-Date     as date    no-undo.
      576      define output parameter o-Time     as integer no-undo.
      577      define variable v-day-number as integer   no-undo .
      578      if    i-mjd-diff < 0
      579         or i-mjd-diff = ?
      580      then do:
      581         return "?" .
      582      end.
      583      assign
      584         v-day-number = truncate(i-mjd-diff,0).
      585         o-Date = date(v-day-number + 2400002).
      586         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      587     .
      588   end.
      589   function cur-time-mjd-to-string returns character
      590   (input p-mjd-diff as decimal
      591   )
      592   :
      593     define variable v-day-number as integer   no-undo .
      594     define variable v-seconds    as integer   no-undo .
      595     define variable v-hour       as integer   no-undo .
      596     define variable v-min        as integer   no-undo .
      597     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      598     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      599     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      600     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      601     if p-mjd-diff < 0
      602     or p-mjd-diff = ?
      603     then do:
      604       return "?" .
      605     end.
      606     assign
      607       v-day-number = integer(truncate(p-mjd-diff,0))
      608       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      609     .
      610     if v-seconds > 86400
      611     then do:
      612       assign
      613         v-seconds = 86400 - 1
      614       .
      615     end.
      616     if v-seconds < 0
      617     then do:
      618       assign
      619         v-seconds = 0
      620       .
      621     end.
      622     assign
      623       v-hour = truncate(v-seconds / 3600, 0)
      624     .
      625     assign
      626       v-seconds = v-seconds modulo 3600
      627     .
      628     assign
      629       v-min = truncate(v-seconds / 60, 0)
      630     .
      631     assign
      632       v-seconds = v-seconds modulo 60
      633     .
      634     return
      635         (if v-day-number <> 0
      636           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      637           else ""
      638         )
      639       + (if v-day-number <> 0 or v-hour <> 0
      640           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      641           else ""
      642         )
      643       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      644           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      645           else ""
      646         )
      647       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      648       .
      649   end.
      650   function cur-time-string returns character
      651   :
      652     define variable v-date as date      no-undo .
      653     define variable v-time as integer   no-undo .
      654     run cur-time in this-procedure
      655       (output v-date
      656       ,output v-time
      657       ) .
      658     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      659   end.
      660   function cur-time-string-sec returns character
      661   :
      662     define variable v-date as date      no-undo .
      663     define variable v-time as integer   no-undo .
      664     run cur-time in this-procedure
      665       (output v-date
      666       ,output v-time
      667       ) .
      668     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      669   end.
      670   function cur-time-custom  returns character
      671   (input p-prefix as character
      672   ,input p-date-format as character
      673   ,input p-delimiter as character
      674   ,input p-time-format as character
      675   ,input p-suffix as character
      676   )
      677   :
      678     define variable v-date as date      no-undo .
      679     define variable v-time as integer   no-undo .
      680     run cur-time in this-procedure
      681       (output v-date
      682       ,output v-time
      683       ) .
      684     return
      685       p-prefix
      686       + string(v-date, p-date-format)
      687       + p-delimiter
      688       + string(v-time, p-time-format)
      689       + p-suffix
      690       .
      691   end.
      692   function cur-time-print  returns character
      693   :
      694     define variable v-date as date      no-undo .
      695     define variable v-time as integer   no-undo .
      696     run cur-time in this-procedure
      697       (output v-date
      698       ,output v-time
      699       ) .
      700     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      701   end.
      702   function cur-time-datetime returns datetime
      703   :
      704     define variable v-char as character no-undo .
      705     define variable v-datetime as datetime no-undo .
      706     v-char = cur-time-string().
      707     v-datetime = datetime(v-char).
      708     return  v-datetime.
      709   end.
      710   function cur-time-string-msec returns character
      711   :
      712     define variable v-date as datetime  no-undo .
      713     v-date = now.
      714     return string(v-date) .
      715   end.
      716   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      717   procedure factord :
      718     define input  parameter p-fact-date            as date    no-undo .
      719     define input  parameter p-fact-time            as integer no-undo .
      720     define input  parameter p-fact-num             as integer no-undo .
      721     define input  parameter p-shift-date           as date    no-undo .
      722     define input  parameter p-shift-num            as integer no-undo .
      723     define input  parameter p-shift-on             as logical no-undo .
      724     define output parameter p-fact-order           as decimal no-undo .
      725     define output parameter p-shift-end-fact-order as decimal no-undo .
      726     define output parameter p-day-end-fact-order   as decimal no-undo .
      727     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      728     if p-fact-date = ?
      729     then do:
      730       return error "Не указана фактическая дата" .
      731     end.
      732     define variable v-fact-date-num as integer no-undo .
      733     assign
      734       v-fact-date-num = integer(p-fact-date)
      735     .
      736     if p-fact-num = ?
      737     or p-fact-num = 0
      738     then do:
      739       return error "Не задан p-fact-num " + string(p-fact-num) .
      740     end.
      741     if p-fact-num < 0
      742     then do:
      743       return error "Отрицательный fact-num " + string(p-fact-num) .
      744     end.
      745     if p-fact-num >= 100000000
      746     then do:
      747       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      748     end.
      749     if p-shift-on = true
      750     then do:
      751       if p-shift-date = ?
      752       then do:
      753         return error "Не задана дата смены" .
      754       end.
      755       if p-shift-num = ?
      756       or p-shift-num = 0
      757       then do:
      758         return error "Не задан номер смены" .
      759       end.
      760     end.
      761     else do:
      762       assign
      763         p-shift-date = p-fact-date
      764         p-shift-num  = 24
      765       .
      766     end.
      767     define variable v-shift-offset as integer no-undo .
      768     if p-shift-date = p-fact-date
      769     then do:
      770       assign
      771         v-shift-offset = 1
      772       .
      773     end.
      774     if p-shift-date < p-fact-date
      775     then do:
      776       assign
      777         v-shift-offset = 0
      778       .
      779     end.
      780     if p-shift-date > p-fact-date
      781     then do:
      782       message
      783         vss-workfile vss-revision vss-description skip
      784         "Неправильная дата закрытия смены" skip
      785         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      786         view-as alert-box error .
      787       undo, return error
      788         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      789           ,string(p-fact-date, '99/99/9999':U)
      790           ,string(p-shift-date, '99/99/9999':U)
      791           )
      792       .
      793     end.
      794     if p-shift-num < 1
      795     or p-shift-num > 24
      796     then do:
      797       message
      798         vss-workfile vss-revision vss-description skip
      799         "Неправильный номер смены" skip
      800         "p-shift-num" p-shift-num skip
      801         view-as alert-box error .
      802       undo, return error return-value .
      803     end.
      804     assign
      805       p-fact-order           = v-fact-date-num
      806                              + v-shift-offset * 0.5
      807                              + p-shift-num    * 0.02 - 0.01
      808                              + p-fact-num     * 0.0000000001
      809       p-shift-end-fact-order = v-fact-date-num
      810                              + v-shift-offset * 0.5
      811                              + p-shift-num    * 0.02
      812       p-day-end-fact-order   = v-fact-date-num
      813                              + 0.99
      814     .
      815     if p-fact-order           <= v-fact-date-num
      816     or p-shift-end-fact-order <= v-fact-date-num
      817     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      818     or p-shift-end-fact-order >= p-day-end-fact-order
      819     then do:
      820       message
      821         vss-workfile vss-revision vss-description skip
      822         "Внутренняя ошибка при генерации фактического номера" skip
      823         "p-fact-date"            p-fact-date            skip
      824         "p-fact-time"            p-fact-time            skip
      825         "p-fact-num"             p-fact-num             skip
      826         "p-shift-date"           p-shift-date           skip
      827         "p-shift-num"            p-shift-num            skip
      828         "p-shift-on"             p-shift-on             skip
      829         "p-shift-end-fact-order" p-shift-end-fact-order skip
      830         "p-day-end-fact-order"   p-day-end-fact-order   skip
      831         "v-fact-date-num"        v-fact-date-num        skip
      832         view-as alert-box error .
      833       undo, return error return-value .
      834     end.
      835   end procedure.
      836   procedure day-begin-fact-order :
      837     define input  parameter p-fact-date            as date    no-undo .
      838     define output parameter p-day-begin-fact-order as decimal no-undo .
      839     do
      840     on error undo, return error return-value
      841     :
      842       if p-fact-date = ?
      843       then do:
      844         assign
      845           p-day-begin-fact-order = 0
      846         .
      847       end.
      848       else do:
      849         assign
      850           p-day-begin-fact-order = integer(p-fact-date)
      851         .
      852       end.
      853     end.
      854   end procedure.
      855   procedure factord-max-fact-order :
      856     define output parameter p-max-fact-order as decimal   no-undo .
      857     do
      858     on error undo, return error return-value
      859     :
      860       run day-begin-fact-order in this-procedure
      861         (input  date(1, 1, 5000)
      862         ,output p-max-fact-order
      863         ) .
      864     end.
      865   end procedure.
      866   procedure factord-cut-archive :
      867     define input  parameter p-obj-type             as character no-undo .
      868     define input  parameter p-obj-code             as integer   no-undo .
      869     define input  parameter p-fact-date            as date      no-undo .
      870     define output parameter p-shift-on             as logical   no-undo .
      871     define output parameter p-shift-date           as date      no-undo .
      872     define output parameter p-shift-num            as integer   no-undo .
      873     define output parameter p-day-end-fact-order   as decimal   no-undo .
      874     define output parameter p-shift-end-fact-order as decimal   no-undo .
      875     define variable v-fact-order as decimal   no-undo .
      876     define buffer buf_shift-obj for ub.shift-obj .
      877     do
      878     on error undo, return error return-value
      879     :
      880   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      881   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      882     (input  p-obj-type
      883     ,input  p-obj-code
      884     ,input  'shift-on=request'
      885     ,output p-shift-on
      886     ) no-error .
      887       if error-status :error
      888       then do:
      889         message
      890           vss-workfile vss-revision vss-description skip
      891           "Ошибка при определении атрибута объекта" skip
      892           "Объект" p-obj-type p-obj-code skip
      893           error-status :get-message(1) skip
      894           return-value skip
      895           view-as alert-box error .
      896         undo, return error return-value .
      897       end.
      898       if p-shift-on = false
      899       then do:
      900         assign
      901           p-shift-date               = ?
      902           p-shift-num                = 0
      903         .
      904       end.
      905       else do:
      906         find first buf_shift-obj share-lock
      907           where buf_shift-obj.obj-type   = p-obj-type
      908             and buf_shift-obj.obj-code   = p-obj-code
      909             and buf_shift-obj.shift-date > p-fact-date
      910           use-index pi
      911           no-error .
      912         if not available buf_shift-obj
      913         or buf_shift-obj.status_ <> 'зкр':U
      914         then do:
      915           message
      916             vss-workfile vss-revision vss-description skip
      917             "Невозможно вычислить последнюю смену" skip
      918             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      919             "Объект" p-obj-type p-obj-code skip
      920             "Дата" p-fact-date skip
      921             view-as alert-box error .
      922           undo, return error return-value .
      923         end.
      924         find last buf_shift-obj share-lock
      925           where buf_shift-obj.obj-type = p-obj-type
      926             and buf_shift-obj.obj-code = p-obj-code
      927             and buf_shift-obj.shift-date <= p-fact-date
      928           use-index pi
      929           no-error .
      930         if available buf_shift-obj
      931         then do:
      932           if  buf_shift-obj.status_ = 'зкр':U
      933           then do:
      934             assign
      935               p-shift-date = buf_shift-obj.shift-date
      936               p-shift-num  = buf_shift-obj.shift-num
      937             .
      938           end.
      939           else do:
      940             message
      941               vss-workfile vss-revision vss-description skip
      942               "Невозможно вычислить последнюю смену" skip
      943               "Статус смены отличен от статуса" 'зкр':U skip
      944               "Объект" p-obj-type p-obj-code skip
      945               "Дата" p-fact-date skip
      946               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      947               view-as alert-box error .
      948             undo, return error return-value .
      949           end.
      950         end.
      951         else do:
      952           assign
      953             p-shift-date = p-fact-date - 1
      954             p-shift-num  = 1
      955           .
      956         end.
      957       end.
      958       run factord in this-procedure
      959         (input  p-fact-date
      960         ,input  1
      961         ,input  1
      962         ,input  p-shift-date
      963         ,input  p-shift-num
      964         ,input  p-shift-on
      965         ,output v-fact-order
      966         ,output p-shift-end-fact-order
      967         ,output p-day-end-fact-order
      968         ) no-error .
      969       if error-status :error
      970       then do:
      971         message
      972           vss-workfile vss-revision vss-description skip
      973           "Ошибка при вызове процедуры factord"
      974           error-status :get-message(1) skip
      975           return-value skip
      976           view-as alert-box error .
      977         undo, return error return-value .
      978       end.
      979     end.
      980   end procedure.
      981   procedure factord-lock-shift :
      982     define input  parameter p-obj-type  as character no-undo .
      983     define input  parameter p-obj-code  as integer   no-undo .
      984     define input  parameter p-fact-date as date      no-undo .
      985     define parameter buffer buf_shift-obj for ub.shift-obj .
      986     define variable v-shift-on      as logical   no-undo .
      987     define variable v-extra-message as character no-undo .
      988     define variable v-error as character no-undo .
      989     do
      990     on error undo, return error return-value
      991     :
      992   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      993   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      994     (input  p-obj-type
      995     ,input  p-obj-code
      996     ,input  'shift-on=request'
      997     ,output v-shift-on
      998     ) no-error .
      999       if error-status :error
     1000       then do:
     1001         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1002         undo, return error v-error .
     1003       end.
     1004       if v-shift-on = true
     1005       then do:
     1006         find first buf_shift-obj share-lock
     1007           where buf_shift-obj.obj-type   = p-obj-type
     1008             and buf_shift-obj.obj-code   = p-obj-code
     1009             and buf_shift-obj.shift-date > p-fact-date
     1010           use-index pi
     1011           no-error .
     1012         if not available buf_shift-obj
     1013         or buf_shift-obj.status_ <> 'зкр':U
     1014         then do:
     1015           find last buf_shift-obj
     1016             where buf_shift-obj.obj-type = p-obj-type
     1017               and buf_shift-obj.obj-code = p-obj-code
     1018               and buf_shift-obj.status_  = 'зкр':U
     1019             use-index stts
     1020             no-error .
     1021           if available buf_shift-obj
     1022           then do:
     1023             assign
     1024               v-extra-message =
     1025                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1026                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1027                               )
     1028             .
     1029           end.
     1030           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1031           undo, return error v-error .
     1032         end.
     1033       end.
     1034     end.
     1035   end procedure.
     1036   procedure factord-end-day :
     1037     define input  parameter p-fact-date            as date    no-undo .
     1038     define output parameter p-day-end-fact-order   as decimal no-undo .
     1039     do
     1040     on error undo, return error return-value
     1041     :
     1042       if p-fact-date = ?
     1043       then do:
     1044         return error "Не указана фактическая дата" .
     1045       end.
     1046       assign
     1047         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1048       .
     1049     end.
     1050   end procedure.
     1051   procedure factord-to-date :
     1052     define input  parameter p-fact-order as decimal no-undo .
     1053     define output parameter p-fact-date  as date    no-undo .
     1054     define variable v-ref-date  as date      no-undo .
     1055     define variable v-ref-delta as integer   no-undo .
     1056     do
     1057     on error undo, return error return-value
     1058     :
     1059       if p-fact-order = ?
     1060       or p-fact-order = 0
     1061       then do:
     1062         return error "Не указан fact-order" .
     1063       end.
     1064       assign
     1065         v-ref-date  = date(1, 1, 2000)
     1066       .
     1067       assign
     1068         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1069       .
     1070       assign
     1071         p-fact-date = v-ref-date + v-ref-delta
     1072       .
     1073     end.
     1074   end procedure.
     1075   procedure factord-to-fact-num :
     1076     define input  parameter p-fact-order as decimal no-undo .
     1077     define output parameter p-fact-num   as integer no-undo .
     1078     define variable v-fact-order-trunc as decimal no-undo .
     1079     do
     1080     on error undo, return error return-value
     1081     :
     1082       if p-fact-order = ?
     1083       or p-fact-order = 0
     1084       then do:
     1085         return error "Не указан fact-order" .
     1086       end.
     1087       assign
     1088        v-fact-order-trunc = truncate(p-fact-order, 2)
     1089       .
     1090       assign
     1091         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1092       .
     1093     end.
     1094   end procedure.
     1095   procedure factord-to-shift-num :
     1096     define input  parameter p-fact-order as decimal no-undo .
     1097     define output parameter p-shift-num   as integer no-undo .
     1098     define variable  p-shift-numd  as decimal   no-undo .
     1099     define variable v-fact-order-trunc as decimal no-undo .
     1100     do
     1101     on error undo, return error return-value
     1102     :
     1103       if p-fact-order = ?
     1104       or p-fact-order = 0
     1105       then do:
     1106         return error "Не указан fact-order" .
     1107       end.
     1108       assign
     1109        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1110       .
     1111       if v-fact-order-trunc < 0.5 then do:
     1112         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1113       end.
     1114       assign
     1115         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1116         .
     1117        assign
     1118         p-shift-num = truncate (p-shift-numd , 0)
     1119       .
     1120     end.
     1121   end procedure.
     1122   procedure fact-order-mpl :
     1123     do
     1124     on error undo, return error return-value
     1125     :
     1126   define input  parameter p-doc-date as date     no-undo .
     1127   define input  parameter p-obj-type as character no-undo .
     1128   define input  parameter p-obj-code as integer   no-undo .
     1129   define output parameter p-fact-order as decimal   no-undo .
     1130   define variable v-fact-date            as date    no-undo .
     1131   define variable v-fact-time            as integer no-undo .
     1132   define variable v-fact-order           as decimal no-undo .
     1133   define variable v-shift-end-fact-order as decimal no-undo .
     1134   define variable v-day-end-fact-order   as decimal no-undo .
     1135   define variable l-shift-on as logical no-undo .
     1136   define variable l-date as date      no-undo .
     1137   define variable l-time as integer   no-undo .
     1138   define variable shift-date as date      no-undo .
     1139   define variable shift-num  as integer   no-undo .
     1140   define variable shift-name as character no-undo .
     1141   define variable max-fact-order as decimal   no-undo .
     1142   define buffer buf_global-state for ub.global-state  .
     1143   find first buf_global-state no-lock no-error .
     1144   if not available buf_global-state then do:
     1145      message
     1146        "Не заданы параметры ценообразования!"
     1147        view-as alert-box error
     1148      .
     1149      return error return-value .
     1150   end.
     1151     run cur-time in this-procedure
     1152     ( output v-fact-date ,
     1153       output v-fact-time  ).
     1154   if p-doc-date = ? then do:
     1155   if buf_global-state.pl-use-sys-date-time  = true then do:
     1156         run factord in this-procedure
     1157           (input  v-fact-date
     1158           ,input  v-fact-time
     1159           ,input  v-fact-time
     1160           ,input  ?
     1161           ,input  ?
     1162           ,input  false
     1163           ,output v-fact-order
     1164           ,output v-shift-end-fact-order
     1165           ,output v-day-end-fact-order
     1166           ) no-error .
     1167         if error-status :error
     1168         or v-fact-order = ?
     1169         or v-fact-order = 0 then do:
     1170           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1171         end.
     1172         p-fact-order = v-fact-order .
     1173   end.
     1174   else do:
     1175   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1176   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1177     (input  p-obj-type
     1178     ,input  p-obj-code
     1179     ,input  'shift-on=request'
     1180     ,output l-shift-on
     1181     ) no-error .
     1182         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     1183         if p-doc-date <> ? then do:
     1184         end.
     1185          run gbl/factdate.p
     1186          ( input        p-obj-type  ,
     1187            input        p-obj-code  ,
     1188            input-output v-fact-date ,
     1189            input-output v-fact-time ,
     1190            input-output shift-date      ,
     1191            input-output shift-num       ,
     1192            input-output shift-name      ,
     1193            input        yes
     1194            ) no-error .
     1195         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     1196         run factord in this-procedure
     1197           (input  v-fact-date
     1198           ,input  v-fact-time
     1199           ,input  v-fact-time
     1200           ,input  shift-date
     1201           ,input  shift-num
     1202           ,input  l-shift-on
     1203           ,output v-fact-order
     1204           ,output v-shift-end-fact-order
     1205           ,output v-day-end-fact-order
     1206           ) no-error .
     1207         if error-status :error
     1208         or v-fact-order = ?
     1209         or v-fact-order = 0 then do:
     1210           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1211         end.
     1212         p-fact-order = v-fact-order .
     1213   end.
     1214   end.
     1215   else do:
     1216          run gbl/factdate.p
     1217          ( input        p-obj-type  ,
     1218            input        p-obj-code  ,
     1219            input-output v-fact-date ,
     1220            input-output v-fact-time ,
     1221            input-output shift-date      ,
     1222            input-output shift-num       ,
     1223            input-output shift-name      ,
     1224            input        yes
     1225            ) no-error .
     1226         if error-status :error then return error "Ошибка factdate.p " + return-value .
     1227         v-fact-date = p-doc-date .
     1228         run factord in this-procedure
     1229           (input  v-fact-date
     1230           ,input  v-fact-time
     1231           ,input  v-fact-time
     1232           ,input  shift-date
     1233           ,input  shift-num
     1234           ,input  l-shift-on
     1235           ,output v-fact-order
     1236           ,output v-shift-end-fact-order
     1237           ,output v-day-end-fact-order
     1238           ) no-error .
     1239         if error-status :error
     1240         or v-fact-order = ?
     1241         or v-fact-order = 0 then do:
     1242           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1243         end.
     1244         p-fact-order = v-fact-order .
     1245   end.
     1246     end.
     1247   end procedure.
     1248   DEFINE TEMP-TABLE tt_price-all NO-UNDO LIKE ub.price-all
     1249   field sale-qnty as decimal
     1250   field sale-sum  as decimal
     1251   field sale-tnv  as decimal
     1252   field price-sale-base as decimal
     1253   field price-sale-rubl as decimal
     1254   field road-tax-base   as decimal
     1255   field road-tax-rubl   as decimal
     1256   field excise-base as decimal
     1257   field excise-rubl as decimal
     1258   field date-1 as date
     1259   field date-2 as date
     1260   field shift-1 as int
     1261   field shift-2 as int
     1262   field time-1 as int
     1263   field time-2 as int
     1264   field grp-name as char
     1265   field interv-name as char
     1266   field pay-name as char
     1267   field unit-cli as char
     1268   index pi
     1269   plt-priority DESCENDING
     1270   fact-order DESCENDING
     1271   qnty-from asc
     1272   sum-from asc
     1273   turnover-from asc
     1274   date-1 DESCENDING
     1275   time-1 DESCENDING
     1276   date-2 DESCENDING
     1277   time-2 DESCENDING
     1278   type-price DESCENDING
     1279   .
     1280   procedure mpl-autoprice :
     1281   define input  parameter p-only-b-code as logical   no-undo .
     1282   define input  parameter p-cli-type    as character no-undo .
     1283   define input  parameter p-cli-code    as integer   no-undo .
     1284   define input  parameter p-main-b-code as integer   no-undo .
     1285   define input  parameter p-b-code      as integer   no-undo .
     1286   define input  parameter p-obj-type    as character no-undo .
     1287   define input  parameter p-obj-code    as integer   no-undo .
     1288   define input  parameter p-qnty-doc    as decimal   no-undo .
     1289   define input  parameter p-sum-doc     as decimal   no-undo .
     1290   define input  parameter p-vid-pay        as character no-undo .
     1291   define input  parameter p-cash-pay-type  as character no-undo .
     1292   define input  parameter p-fact-order  as decimal   no-undo .
     1293   define output parameter p-plt-id          as integer   no-undo .
     1294   define output parameter p-plt-db-num      as integer   no-undo .
     1295   define output parameter p-pdf-id          as integer   no-undo .
     1296   define output parameter p-pdf-db-num      as integer   no-undo .
     1297   define output parameter p-sale-price-base as decimal   no-undo .
     1298   define output parameter p-sale-price-rubl as decimal   no-undo .
     1299   define output parameter p-road-tax-base as decimal   no-undo .
     1300   define output parameter p-road-tax-rubl as decimal   no-undo .
     1301   define output parameter p-excise-base   as decimal   no-undo .
     1302   define output parameter p-excise-rubl   as decimal   no-undo .
     1303   define variable v-cli-oborot-ALL as decimal   no-undo .
     1304   define buffer buf_buyer-in-buyer-group   for ub.buyer-in-buyer-group  .
     1305   define buffer buf_turnover-buyer-main    for ub.turnover-buyer-main  .
     1306   define buffer buf1_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     1307   define buffer buf2_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     1308   define buffer buf_price-all              for ub.price-all  .
     1309   define buffer buf_goods                  for ub.goods      .
     1310   define buffer buf_global-state           for ub.global-state  .
     1311   define buffer buf_buyer-group            for ub.buyer-group  .
     1312   define buffer buf_turnover-group         for ub.turnover-group  .
     1313   define buffer buf_main-code              for ub.bar-code  .
     1314   define buffer buf_bar-code               for ub.bar-code  .
     1315   define buffer buf_pay-type               for ub.pay-type  .
     1316   define buffer buf_cash-pay               for ub.cash-pay  .
     1317   define variable to-day          as date      no-undo .
     1318   define variable v-base-rate0    as decimal   no-undo .
     1319   define variable v-base-scale0   as decimal   no-undo .
     1320   define variable v-exch-rate0    as decimal   no-undo .
     1321   define variable v-exch-scale0   as decimal   no-undo .
     1322   define variable v-base-rate     as decimal   no-undo .
     1323   define variable v-base-scale    as decimal   no-undo .
     1324   define variable v-exch-rate     as decimal   no-undo .
     1325   define variable v-exch-scale    as decimal   no-undo .
     1326   define variable v-host-code     as integer   no-undo .
     1327   define variable v-curr-abbr     as character no-undo .
     1328   define variable v-grp-name      as character no-undo .
     1329   define variable v-date-1        as date      no-undo .
     1330   define variable v-date-2        as date      no-undo .
     1331   define variable v-interv        as character no-undo .
     1332   define variable v-pay-name      as character no-undo .
     1333   define variable v-cli-oborot    as decimal   no-undo .
     1334   define variable v-trn-pay-code  as integer   no-undo .
     1335   define variable v-cash-pay-curr as integer   no-undo .
     1336   define variable v-cash-pay-code as integer   no-undo .
     1337   do
     1338   on error undo, return error return-value
     1339   :
     1340   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     1341   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     1342   if p-fact-order = ? then do:
     1343     run fact-order-mpl (
     1344         input   today       ,
     1345         input   p-obj-type  ,
     1346         input   p-obj-code  ,
     1347         output  p-fact-order ).
     1348   end.
     1349   if p-vid-pay <> "" then do:
     1350      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     1351      if available buf_pay-type
     1352         then v-trn-pay-code = buf_pay-type.obj-code.
     1353         else v-trn-pay-code =  0.
     1354   end.
     1355   else v-trn-pay-code = 0 .
     1356   if p-cash-pay-type <> "" then do:
     1357      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     1358      if available buf_pay-type
     1359         then
     1360           assign
     1361             v-cash-pay-curr = buf_cash-pay.curr-code
     1362             v-cash-pay-code = buf_cash-pay.cdpay-code
     1363           .
     1364         else
     1365           assign
     1366             v-cash-pay-curr = 0
     1367             v-cash-pay-code = 0
     1368             .
     1369   end.
     1370   else
     1371     assign
     1372       v-cash-pay-curr = 0
     1373       v-cash-pay-code = 0
     1374       .
     1375   for each tt_price-all  : delete tt_price-all . end.
     1376   assign
     1377     p-plt-id             = ?
     1378     p-plt-db-num         = ?
     1379     p-pdf-id             = ?
     1380     p-pdf-db-num         = ?
     1381     p-sale-price-base    = ?
     1382     p-sale-price-rubl    = ?
     1383     v-cli-oborot         = 0
     1384   .
     1385   find first buf_global-state no-lock no-error .
     1386   if not available buf_global-state then do:
     1387      message
     1388        "Не заданы параметры ценообразования!"
     1389        view-as alert-box error
     1390      .
     1391      return error return-value .
     1392   end.
     1393   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1394   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1395     (input  p-obj-type
     1396     ,input  p-obj-code
     1397     ,output to-day
     1398     )  .
     1399   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1400   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1401     (input  p-obj-type
     1402     ,input  p-obj-code
     1403     ,output v-host-code
     1404     )  .
     1405   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1406   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     1407     (input  v-host-code
     1408     ,input  to-day
     1409     ,output v-base-rate0
     1410     ,output v-base-scale0
     1411     )  .
     1412     v-cli-oborot-ALL  = 0 .
     1413     for each buf_turnover-buyer-main no-lock  where
     1414              buf_turnover-buyer-main.cli-type = p-cli-type  and
     1415              buf_turnover-buyer-main.cli-code = p-cli-code
     1416              :
     1417              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     1418     end.
     1419   for each buf_price-all no-lock where
     1420            buf_price-all.obj-type = p-obj-type and
     1421            buf_price-all.obj-code = p-obj-code and
     1422            buf_price-all.gds-code = buf_goods.gds-code and
     1423            buf_price-all.status_  = 'акт':U  and
     1424          ( p-only-b-code = false   or
     1425          ( buf_price-all.b-code = p-main-b-code or
     1426            buf_price-all.b-code = p-b-code))    and
     1427           ( p-only-b-code = true  or
     1428             buf_price-all.b-code = p-b-code)
     1429             and
     1430             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     1431           ( buf_price-all.fact-order-sys-to = ? or
     1432             buf_price-all.fact-order-sys-to    >= p-fact-order)
     1433           :
     1434            v-interv   = "" .
     1435            v-grp-name = "" .
     1436            v-pay-name = "" .
     1437            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     1438            if buf_price-all.bgr-id > 0 then do:
     1439               find first buf_buyer-group no-lock where
     1440                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     1441                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     1442               if available buf_buyer-group then do:
     1443                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1444                  find first buf_buyer-in-buyer-group no-lock where
     1445                             buf_buyer-in-buyer-group.stts         = 0 and
     1446                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     1447                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     1448                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     1449                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     1450                             no-error .
     1451                             if not available buf_buyer-in-buyer-group then do:
     1452                                v-grp-name = "".
     1453                                next.
     1454                             end.
     1455                             v-grp-name = buf_buyer-group.name .
     1456                  end.
     1457               end.
     1458               else do:
     1459                    v-grp-name = "".
     1460                    next.
     1461               end.
     1462            end.
     1463            if buf_price-all.tog-id > 0 then do:
     1464               find first buf_turnover-group no-lock where
     1465                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     1466                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     1467               if available buf_turnover-group then do:
     1468                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1469                     v-cli-oborot = v-cli-oborot-all  .
     1470                     find first buf1_tnv-in-turnover-group no-lock where
     1471                                buf1_tnv-in-turnover-group.stts       =  0     and
     1472                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     1473                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     1474                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     1475                     find first buf2_tnv-in-turnover-group no-lock where
     1476                                buf2_tnv-in-turnover-group.stts       =  0     and
     1477                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     1478                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     1479                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     1480                     if not (available buf1_tnv-in-turnover-group and
     1481                             available buf2_tnv-in-turnover-group ) then do:
     1482                             v-grp-name = "".
     1483                             next .
     1484                     end.
     1485                     v-grp-name = buf_turnover-group.name.
     1486                  end.
     1487               end.
     1488               else do:
     1489                    v-grp-name = "".
     1490                    next.
     1491               end.
     1492            end.
     1493            if buf_price-all.plt-fix-cource-crc-base = true then
     1494               assign
     1495                 v-base-rate  = buf_price-all.pdf-base-rate
     1496                 v-base-scale = buf_price-all.pdf-base-scale
     1497               .
     1498               else
     1499               assign
     1500                 v-base-rate  = v-base-rate0
     1501                 v-base-scale = v-base-scale0
     1502               .
     1503            if buf_price-all.plt-fix-cource-crc-doc = true then
     1504               assign
     1505                 v-exch-rate  = buf_price-all.pdf-exch-rate
     1506                 v-exch-scale = buf_price-all.pdf-exch-scale
     1507               .
     1508               else do:
     1509   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1510   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1511     (input  buf_price-all.curr-code
     1512     ,input  to-day
     1513     ,output v-exch-rate0
     1514     ,output v-exch-scale0
     1515     ,output v-curr-abbr
     1516     )  .
     1517               assign
     1518                 v-exch-rate  = v-exch-rate0
     1519                 v-exch-scale = v-exch-scale0
     1520                 .
     1521              end.
     1522              v-date-1 = date ( "" )  .
     1523              if buf_price-all.fact-order-sys-from > 0 then do:
     1524                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     1525                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     1526                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     1527              end.
     1528              v-date-2 =  date ( "" )  .
     1529              if buf_price-all.fact-order-sys-to > 0 then do:
     1530                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     1531                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     1532                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     1533              end.
     1534              if buf_price-all.qnty-from <> ? then do :
     1535                 if not (
     1536                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     1537                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     1538                 ) then do:
     1539                        v-interv = "".
     1540                        next.
     1541                 end.
     1542                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     1543              end.
     1544              if buf_price-all.sum-from <> ? then do :
     1545                 if not (
     1546                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     1547                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     1548                 ) then do:
     1549                    v-interv = "".
     1550                    next.
     1551                 end.
     1552                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     1553              end.
     1554              if buf_price-all.turnover-from <> ? then do :
     1555                 if not (
     1556                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     1557                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     1558                 ) then do:
     1559                    v-interv = "".
     1560                    next.
     1561                 end.
     1562                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     1563              end.
     1564              if buf_price-all.use-pay-type = 1 then do :
     1565                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     1566                    v-pay-name = "" .
     1567                    next.
     1568                  end.
     1569                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     1570              end.
     1571              if buf_price-all.use-cash-pay = 1 then do :
     1572                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     1573                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     1574                   v-pay-name = "" .
     1575                   next.
     1576                 end.
     1577                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     1578              end.
     1579             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     1580             create tt_price-all .
     1581             buffer-copy buf_price-all to tt_price-all
     1582             assign
     1583               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     1584               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     1585               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     1586               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     1587               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     1588               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     1589               tt_price-all.price-sale     = buf_price-all.price-sale
     1590               tt_price-all.road-tax       = buf_price-all.road-tax
     1591               tt_price-all.excise         = buf_price-all.excise
     1592               tt_price-all.pdf-exch-rate   = v-exch-rate
     1593               tt_price-all.pdf-exch-scale  = v-exch-scale
     1594               tt_price-all.pdf-base-rate   = v-base-rate
     1595               tt_price-all.pdf-base-scale  = v-base-scale
     1596               tt_price-all.grp-name        = v-grp-name
     1597               tt_price-all.date-1          = v-date-1
     1598               tt_price-all.shift-1         = buf_price-all.start-shift-num
     1599               tt_price-all.time-1          = buf_price-all.start-sys-time
     1600               tt_price-all.date-2          = v-date-2
     1601               tt_price-all.shift-2         = buf_price-all.end-shift-num
     1602               tt_price-all.time-2          = buf_price-all.end-sys-time
     1603               tt_price-all.interv-name     = v-interv
     1604               tt_price-all.pay-name        = v-pay-name
     1605               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     1606             .
     1607   end.
     1608   define variable vt-plt-id as integer   no-undo .
     1609   define variable vt-plt-db as integer   no-undo .
     1610   define variable vt-pdf-id as integer   no-undo .
     1611   define variable vt-pdf-db as integer   no-undo .
     1612   define buffer neos_price-all for tt_price-all  .
     1613   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     1614       if available tt_price-all then do:
     1615        assign
     1616          vt-plt-id = tt_price-all.plt-id
     1617          vt-plt-db = tt_price-all.plt-db-num
     1618          vt-pdf-id = tt_price-all.pdf-id
     1619          vt-pdf-db = tt_price-all.pdf-db
     1620        .
     1621        if tt_price-all.b-code = p-b-code then do:
     1622             assign
     1623               p-plt-id           = tt_price-all.plt-id
     1624               p-plt-db-num       = tt_price-all.plt-db-num
     1625               p-pdf-id           = tt_price-all.pdf-id
     1626               p-pdf-db-num       = tt_price-all.pdf-db
     1627               p-sale-price-base  = tt_price-all.price-sale-base
     1628               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     1629               p-road-tax-base    = tt_price-all.road-tax-base
     1630               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     1631               p-excise-base      = tt_price-all.excise-base
     1632               p-excise-rubl      = tt_price-all.excise-rubl
     1633               .
     1634        end.
     1635        else do:
     1636          find first neos_price-all where
     1637                     neos_price-all.b-code     = p-b-code  and
     1638                     neos_price-all.plt-id     = vt-plt-id and
     1639                     neos_price-all.plt-db-num = vt-plt-db and
     1640                     neos_price-all.pdf-id     = vt-pdf-id and
     1641                     neos_price-all.pdf-db     = vt-pdf-db
     1642                     use-index pi no-error .
     1643            if available neos_price-all then do:
     1644             assign
     1645               p-plt-id           = tt_price-all.plt-id
     1646               p-plt-db-num       = tt_price-all.plt-db-num
     1647               p-pdf-id           = tt_price-all.pdf-id
     1648               p-pdf-db-num       = tt_price-all.pdf-db
     1649               p-sale-price-base  = neos_price-all.price-sale-base
     1650               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     1651               p-road-tax-base    = neos_price-all.road-tax-base
     1652               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     1653               p-excise-base      = neos_price-all.excise-base
     1654               p-excise-rubl      = neos_price-all.excise-rubl
     1655               .
     1656            end.
     1657            else do:
     1658                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     1659                 if error-status :error    then do:
     1660                   message "Не найден бар-код" p-b-code view-as alert-box error .
     1661                   return error return-value .
     1662                 end.
     1663             assign
     1664               p-plt-id           = tt_price-all.plt-id
     1665               p-plt-db-num       = tt_price-all.plt-db-num
     1666               p-pdf-id           = tt_price-all.pdf-id
     1667               p-pdf-db-num       = tt_price-all.pdf-db
     1668               p-sale-price-base  = tt_price-all.price-sale-base
     1669               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     1670               p-road-tax-base    = tt_price-all.road-tax-base
     1671               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     1672               p-excise-base      = tt_price-all.excise-base
     1673               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     1674               .
     1675            end.
     1676        end.
     1677     end.
     1678   end.
     1679   end procedure.
     1680   procedure mpl-tpl-auto :
     1681   define input  parameter p-b-code     as integer   no-undo .
     1682   define input  parameter p-obj-type   as character no-undo .
     1683   define input  parameter p-obj-code   as integer   no-undo .
     1684   define input  parameter p-plt-id     as integer   no-undo .
     1685   define input  parameter p-plt-db-num as integer   no-undo .
     1686   define input  parameter p-fact-order as decimal   no-undo .
     1687   define output parameter p-sale-price as decimal   no-undo .
     1688   define output parameter p-pdf-id     as integer   no-undo .
     1689   define output parameter p-pdf-db-num as integer   no-undo .
     1690     do
     1691     on error undo, return error return-value
     1692     :
     1693   if p-fact-order = ? then do:
     1694     run fact-order-mpl (
     1695         input   today       ,
     1696         input   p-obj-type  ,
     1697         input   p-obj-code  ,
     1698         output  p-fact-order ) .
     1699   end.
     1700   assign
     1701     p-pdf-id      = ?
     1702     p-pdf-db-num  = ?
     1703     p-sale-price  = ?
     1704   .
     1705   define buffer buf_bar-code for ub.bar-code  .
     1706   define buffer buf_goods for ub.goods  .
     1707   find first buf_bar-code no-lock where
     1708              buf_bar-code.b-code = p-b-code
     1709              no-error .
     1710   if error-status :error then return error return-value .
     1711   find first buf_goods no-lock where
     1712              buf_goods.gds-code = buf_bar-code.gds-code
     1713              no-error .
     1714   if error-status :error then return error return-value .
     1715   define variable v-main-b-code as integer   no-undo .
     1716   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1717     (input  buf_goods.gds-code
     1718     ,input  ?
     1719     ,output v-main-b-code
     1720     )  .
     1721   define buffer buf_price-all for ub.price-all  .
     1722   for each tt_price-all : delete tt_price-all. end.
     1723       for each buf_price-all no-lock where
     1724               buf_price-all.plt-id     = p-plt-id                 and
     1725               buf_price-all.plt-db-num = p-plt-db-num             and
     1726               buf_price-all.obj-type   = p-obj-type               and
     1727               buf_price-all.obj-code   = p-obj-code               and
     1728               buf_price-all.gds-code   = buf_goods.gds-code       and
     1729             ( buf_price-all.b-code = v-main-b-code or
     1730               buf_price-all.b-code = p-b-code)    and
     1731               buf_price-all.status_    = 'акт':U         and
     1732               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     1733             ( buf_price-all.fact-order-sys-to = ? or
     1734               buf_price-all.fact-order-sys-to >=  p-fact-order)
     1735               :
     1736                 create tt_price-all .
     1737                 buffer-copy buf_price-all to tt_price-all
     1738                 assign
     1739                   tt_price-all.price-sale  = buf_price-all.price-sale
     1740                 .
     1741       end.
     1742   define variable vt-plt-id as integer   no-undo .
     1743   define variable vt-plt-db as integer   no-undo .
     1744   define variable vt-pdf-id as integer   no-undo .
     1745   define variable vt-pdf-db as integer   no-undo .
     1746   define buffer neos_price-all for tt_price-all  .
     1747   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     1748       if available tt_price-all then do:
     1749        assign
     1750          vt-plt-id = tt_price-all.plt-id
     1751          vt-plt-db = tt_price-all.plt-db-num
     1752          vt-pdf-id = tt_price-all.pdf-id
     1753          vt-pdf-db = tt_price-all.pdf-db
     1754        .
     1755        if tt_price-all.b-code = p-b-code then do:
     1756             assign
     1757               p-plt-id           = tt_price-all.plt-id
     1758               p-plt-db-num       = tt_price-all.plt-db-num
     1759               p-pdf-id           = tt_price-all.pdf-id
     1760               p-pdf-db-num       = tt_price-all.pdf-db
     1761               p-sale-price       = tt_price-all.price-sale
     1762               .
     1763        end.
     1764        else do:
     1765          find first neos_price-all where
     1766                     neos_price-all.b-code     = p-b-code  and
     1767                     neos_price-all.plt-id     = vt-plt-id and
     1768                     neos_price-all.plt-db-num = vt-plt-db and
     1769                     neos_price-all.pdf-id     = vt-pdf-id and
     1770                     neos_price-all.pdf-db     = vt-pdf-db
     1771                     use-index pi no-error .
     1772            if available neos_price-all then do:
     1773             assign
     1774               p-plt-id           = tt_price-all.plt-id
     1775               p-plt-db-num       = tt_price-all.plt-db-num
     1776               p-pdf-id           = tt_price-all.pdf-id
     1777               p-pdf-db-num       = tt_price-all.pdf-db
     1778               p-sale-price       = neos_price-all.price-sale
     1779               .
     1780            end.
     1781            else do:
     1782           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     1783           if error-status :error    then do:
     1784              message "Не найден бар-код" p-b-code view-as alert-box error .
     1785              return error return-value .
     1786           end.
     1787             assign
     1788               p-plt-id           = tt_price-all.plt-id
     1789               p-plt-db-num       = tt_price-all.plt-db-num
     1790               p-pdf-id           = tt_price-all.pdf-id
     1791               p-pdf-db-num       = tt_price-all.pdf-db
     1792               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     1793               .
     1794            end.
     1795        end.
     1796     end.
     1797     end.
     1798   end procedure.
     1799   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1800   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1801   procedure wthcattr-sprcli :
     1802   define input parameter parparentproc  as widget-handle no-undo.
     1803   define input parameter p-mode  as character no-undo.
     1804   define input-output parameter p-value as character no-undo .
     1805   define output parameter p-setted as logical no-undo .
     1806     DEFINE VARIABLE v-value as character no-undo .
     1807     define variable v-cli-type as character no-undo .
     1808     define variable v-cli-code as integer no-undo .
     1809     define buffer buf_clients   for ub.clients.
     1810     define variable v_rid as character no-undo.
     1811     define variable ref-rec as recid no-undo .
     1812     do
     1813     on error undo, return error
     1814     :
     1815         v-value = p-value.
     1816      if p-value <> '':U then do:
     1817       assign
     1818       v-cli-type = substring(p-value, 1, 3)
     1819       v-cli-code = integer(substring(p-value, 4))
     1820       no-error.
     1821       if error-status:error then do:
     1822         assign
     1823         v-cli-type = '':U
     1824         v-cli-code = 0
     1825         .
     1826       end.
     1827      end.
     1828      FIND FIRST buf_clients NO-LOCK WHERE
     1829               buf_clients.obj-type = v-cli-type AND
     1830               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1831      IF available(buf_clients) then do:
     1832       run ref/cli-all.w (
     1833                   input parparentproc
     1834                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1835                  ,input v-cli-type
     1836                  ,input 'все':U
     1837                  ,input 'все':U
     1838                  ,input RECID( buf_clients )
     1839                  ,input ",,,,,,NO"
     1840                  ,input ?
     1841                  ,OUTPUT v_rid ).
     1842     END.
     1843     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1844       run ref/cli-all.w (
     1845                    input parparentproc
     1846                   ,INPUT "b-sel":U
     1847                  ,input  v-cli-type
     1848                  ,input 'все':U
     1849                  ,input 'текущие':U
     1850                  ,input ?
     1851                  ,input ",,,,,,NO"
     1852                  ,input ?
     1853                  ,OUTPUT v_rid ).
     1854     END.
     1855     else do:
     1856       message
     1857       if p-value = "":U then 'Атрибут не задан!'
     1858       else substitute('Не найден клиент &1',p-value)
     1859       view-as alert-box warning.
     1860     end.
     1861     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1862       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1863       IF ERROR-STATUS:ERROR THEN DO:
     1864           RETURN NO-APPLY.
     1865       END.
     1866       FIND FIRST buf_clients NO-LOCK WHERE
     1867                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1868       IF AVAIL buf_clients THEN DO:
     1869         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1870       end.
     1871     end.
     1872     if v-value <> p-value then do:
     1873       p-value = v-value.
     1874       p-setted = yes.
     1875     end.
     1876     end.
     1877   end procedure.
     1878     define new global shared variable g#wthcalib as handle no-undo.
     1879   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
     1880   define variable v-tth as handle no-undo .
     1881   assign
     1882   v-tth = buffer thbjattr_thbj-attr:table-handle .
     1883   def temp-table tt-wthlib-parts no-undo like ub.wth-parts.
     1884   Procedure wth-doc-close:
     1885       define input parameter p-rec        as recid     no-undo .
     1886       DEFINE BUFFER cur-wth-parts FOR ub.wth-parts.
     1887     do
     1888     on error undo, return error return-value
     1889     :
     1890       find first cur-wth-parts where recid(cur-wth-parts) = p-rec exclusive-lock no-wait no-error.
     1891       if not available cur-wth-parts then return error substitute("Не найдена партия").
     1892       CASE cur-wth-parts.ext-doc-type:
     1893           WHEN 'ie':U or when 'rf':U or when 'ff':U
     1894           OR WHEN 'fj':U
     1895           THEN DO:
     1896              RUN wth-parts-close(BUFFER cur-wth-parts, 'free-zone':U ).
     1897           END.
     1898           WHEN 'ee':U THEN DO:
     1899               RUN wth-parts-close(BUFFER cur-wth-parts, 'cli-zone':U ).
     1900           END.
     1901           WHEN 'ps':U OR WHEN 'pz':U OR WHEN 'rp':U
     1902             OR WHEN 'ip':U OR WHEN 'pc':U
     1903             OR WHEN 'pj':U
     1904              THEN DO:
     1905               RUN wth-parts-close(BUFFER cur-wth-parts, 'put-zone':U ).
     1906           END.
     1907           WHEN 'df':U OR WHEN 'dp':U OR WHEN 'dc':U THEN DO:
     1908             RUN wth-parts-close(BUFFER cur-wth-parts, 'out-zone':U ).
     1909           end.
     1910           when 'ep':U or when 'ef':U
     1911           OR WHEN 'oj':U or when 'jj':U
     1912           then .
     1913           when 'xc':U then do:
     1914             if cur-wth-parts.type = 'при':U then
     1915                  RUN wth-parts-close(BUFFER cur-wth-parts, 'put-zone':U ).
     1916             else RUN wth-parts-close(BUFFER cur-wth-parts, 'cli-zone':U ).
     1917           end.
     1918           OTHERWISE DO:
     1919               RETURN ERROR substitute("Неверный вызов процедуры закрытия: расш. тип = &1"
     1920                                    , cur-wth-parts.ext-doc-type
     1921                                       ).
     1922           END.
     1923       END CASE.
     1924       RELEASE cur-wth-parts.
     1925       END.
     1926   END.
     1927   PROCEDURE wth-parts-close:
     1928       DEFINE PARAMETER BUFFER bfrom_wth-parts FOR ub.wth-parts.
     1929       DEFINE INPUT PARAMETER p-zone AS CHAR NO-UNDO.
     1930       define variable v-rec as recid.
     1931       if bfrom_wth-parts.stts  = 1 then return.
     1932          run str/wthpartp.p  ( INPUT     'ДОБАВЛЕНИЕ':U,
     1933                     INPUT     bfrom_wth-parts.obj-type,
     1934                     INPUT     bfrom_wth-parts.obj-code,
     1935                     INPUT     bfrom_wth-parts.w-p-code,
     1936                     INPUT     bfrom_wth-parts.wth-code,
     1937                     INPUT     bfrom_wth-parts.par-code,
     1938                     INPUT     bfrom_wth-parts.in-code ,
     1939                     INPUT     p-zone,
     1940                     INPUT     bfrom_wth-parts.ser-code,
     1941                     INPUT     bfrom_wth-parts.db-num  ,
     1942                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     1943                     INPUT     bfrom_wth-parts.fact-rangeTo  ,
     1944                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     1945                     INPUT     bfrom_wth-parts.fact-rangeTo ,
     1946                     INPUT     bfrom_wth-parts.host-code     ,
     1947                     INPUT     bfrom_wth-parts.contract-code               ,
     1948                     INPUT     bfrom_wth-parts.price-rubl    ,
     1949                     INPUT     bfrom_wth-parts.price-base    ,
     1950                     INPUT     bfrom_wth-parts.supp-type,
     1951                     INPUT     bfrom_wth-parts.supp-code,
     1952                     INPUT     bfrom_wth-parts.in-obj-type      ,
     1953                     INPUT     bfrom_wth-parts.in-obj-code      ,
     1954                     INPUT     bfrom_wth-parts.ext-doc-type,
     1955                     INPUT     bfrom_wth-parts.gds-code,
     1956                     INPUT     bfrom_wth-parts.stts               ,
     1957                     INPUT     bfrom_wth-parts.beg-dt        ,
     1958                     INPUT     bfrom_wth-parts.end-dt        ,
     1959                     INPUT     bfrom_wth-parts.vat-pc        ,
     1960                     INPUT     bfrom_wth-parts.cli-code,
     1961                     INPUT     bfrom_wth-parts.cli-type,
     1962                     INPUT     bfrom_wth-parts.out-obj-code,
     1963                     INPUT     bfrom_wth-parts.out-obj-type,
     1964                     INPUT     bfrom_wth-parts.sale-obj-code,
     1965                     INPUT     bfrom_wth-parts.sale-obj-type,
     1966                     INPUT     bfrom_wth-parts.out-code ,
     1967                     INPUT  yes,
     1968                     INPUT     '':U ,
     1969                     INPUT-OUTPUT v-rec
     1970                     ) no-error.
     1971       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     1972   END.
     1973   Procedure wth-doc-razrez:
     1974       define input parameter p-rec as recid NO-UNDO.
     1975       define input parameter p-doc-del AS log NO-UNDO.
     1976       define variable v-mess AS CHAR NO-UNDO.
     1977       define variable p-silent AS LOG INIT NO NO-UNDO.
     1978       DEFINE BUFFER b-wth-parts FOR ub.wth-parts.
     1979       DEFINE BUFFER buf_wth-parts FOR ub.wth-parts.
     1980       DEFINE BUFFER cur-wth-parts FOR ub.wth-parts.
     1981     do
     1982     on error undo, return error return-value
     1983     :
     1984       FIND FIRST cur-wth-parts WHERE recid(cur-wth-parts) = p-rec
     1985                                 EXCLUSIVE-LOCK .
     1986       IF AVAILABLE cur-wth-parts THEN DO:
     1987           CASE cur-wth-parts.ext-doc-type:
     1988               WHEN 'ie':U or when 'ip':U or when 'rp':U
     1989               or when 'ff':U or when 'rf':U
     1990               or when 'fj':U or when 'pj':U
     1991               THEN DO:
     1992                   RUN wth-parts-raz(BUFFER cur-wth-parts, "":U,p-doc-del) .
     1993               END.
     1994               WHEN 'ee':U or when 'ef':U or when 'jj':U
     1995               THEN DO:
     1996                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'free-zone':U,p-doc-del) .
     1997               END.
     1998               WHEN 'ep':U or when 'oj':U THEN DO:
     1999                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'put-zone':U,p-doc-del) .
     2000               END.
     2001               WHEN 'pc':U THEN DO:
     2002                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del)  .
     2003               END.
     2004               WHEN 'dp':U THEN DO:
     2005                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'put-zone':U,p-doc-del)  .
     2006               END.
     2007               WHEN 'df':U THEN DO:
     2008                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'free-zone':U,p-doc-del)  .
     2009               END.
     2010               WHEN 'dc':U THEN DO:
     2011                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del)  .
     2012               END.
     2013               WHEN 'ps':U OR WHEN 'pz':U THEN DO:
     2014                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del).
     2015               END.
     2016               when 'xc':U then do:
     2017                 if cur-wth-parts.type = 'при':U then
     2018                      RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del ).
     2019                 else RUN wth-parts-raz(BUFFER cur-wth-parts,  'free-zone':U ,p-doc-del).
     2020               end.
     2021               OTHERWISE DO:
     2022                   RETURN ERROR substitute("Неверный вызов процедуры разрезервирования: расш. тип =  :&1&2&3"
     2023                                        , cur-wth-parts.ext-doc-type
     2024                                        , error-status:get-message(1)
     2025                                        , return-value
     2026                                        ).
     2027               END.
     2028           END CASE.
     2029       END.
     2030     END.
     2031   END.
     2032   PROCEDURE wth-parts-raz:
     2033       DEFINE PARAMETER BUFFER bfrom_wth-parts FOR ub.wth-parts.
     2034       DEFINE INPUT PARAMETER p-zone AS CHAR NO-UNDO.
     2035       DEFINE INPUT PARAMETER p-doc-del AS log NO-UNDO.
     2036       define variable v-mes as char no-undo.
     2037       define variable v-rec as recid no-undo.
     2038       DEFINE BUFFER buf_wth-parts FOR ub.wth-parts.
     2039     do
     2040     on error undo, return error return-value
     2041     :
     2042       v-mes = substitute('Код серии: &1-&2 Диапазон &3-&4'
     2043                                      ,bfrom_wth-parts.ser-code
     2044                                      ,bfrom_wth-parts.db-num
     2045                                      ,bfrom_wth-parts.doc-rangeFrom
     2046                                      ,bfrom_wth-parts.doc-rangeTo).
     2047       IF lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) > 0 THEN DO:
     2048           RETURN ERROR substitute("Нельзя удалять партии МЦ из зоны :&1&2&3&4&5"
     2049                                , error-status:get-message(1)
     2050                                , bfrom_wth-parts.out-code
     2051                                , return-value
     2052                                ,chr(10)
     2053                                ,v-mes
     2054                                ).
     2055       END.
     2056       v-rec = recid(bfrom_wth-parts).
     2057       CASE bfrom_wth-parts.ext-doc-type:
     2058           WHEN 'ie':U  or when 'fj':U or when  'pj':U THEN DO:
     2059               delete bfrom_wth-parts NO-ERROR.
     2060               if error-status:error then do:
     2061                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     2062                                      , error-status:get-message(1)
     2063                                      , chr(10)
     2064                                      , return-value
     2065                                      ,v-mes
     2066                                      ).
     2067               END.
     2068           END.
     2069           when 'rp':U or when 'rf':U then do:
     2070             if p-doc-del then do:
     2071               delete bfrom_wth-parts NO-ERROR.
     2072               if error-status:error then do:
     2073                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     2074                                      , error-status:get-message(1)
     2075                                      , chr(10)
     2076                                      , return-value
     2077                                      ,v-mes
     2078                                      ).
     2079               END.
     2080             end.
     2081             else   RETURN ERROR 'Нельзя удалять партии документа внутреннего возврата.'  .
     2082           end.
     2083           when 'ip':U or when 'ff':U then do:
     2084             if p-doc-del then do:
     2085               delete bfrom_wth-parts NO-ERROR.
     2086               if error-status:error then do:
     2087                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     2088                                      , error-status:get-message(1)
     2089                                      , chr(10)
     2090                                      , return-value
     2091                                      ,v-mes
     2092                                      ).
     2093               END.
     2094             end.
     2095             else do:
     2096               run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2097                     INPUT     bfrom_wth-parts.obj-type,
     2098                     INPUT     bfrom_wth-parts.obj-code,
     2099                     INPUT     bfrom_wth-parts.w-p-code,
     2100                     INPUT     bfrom_wth-parts.wth-code,
     2101                     INPUT     bfrom_wth-parts.par-code,
     2102                     INPUT     bfrom_wth-parts.in-code ,
     2103                     INPUT     bfrom_wth-parts.out-code,
     2104                     INPUT     bfrom_wth-parts.ser-code,
     2105                     INPUT     bfrom_wth-parts.db-num  ,
     2106                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2107                     INPUT     bfrom_wth-parts.fact-rangeTo   ,
     2108                     INPUT     bfrom_wth-parts.doc-RangeFrom ,
     2109                     INPUT     bfrom_wth-parts.doc-rangeTo  ,
     2110                     INPUT     bfrom_wth-parts.host-code     ,
     2111                     INPUT     bfrom_wth-parts.contract-code ,
     2112                     INPUT     bfrom_wth-parts.price-rubl    ,
     2113                     INPUT     bfrom_wth-parts.price-base    ,
     2114                     INPUT     bfrom_wth-parts.supp-type,
     2115                     INPUT     bfrom_wth-parts.supp-code,
     2116                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2117                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2118                     INPUT     bfrom_wth-parts.ext-doc-type,
     2119                     INPUT     bfrom_wth-parts.gds-code,
     2120                     INPUT     1            ,
     2121                     INPUT     bfrom_wth-parts.beg-dt        ,
     2122                     INPUT     bfrom_wth-parts.end-dt        ,
     2123                     INPUT     bfrom_wth-parts.vat-pc        ,
     2124                     INPUT     bfrom_wth-parts.cli-code,
     2125                     INPUT     bfrom_wth-parts.cli-type,
     2126                     INPUT     bfrom_wth-parts.out-obj-code,
     2127                     INPUT     bfrom_wth-parts.out-obj-type,
     2128                     INPUT     bfrom_wth-parts.sale-obj-code,
     2129                     INPUT     bfrom_wth-parts.sale-obj-type,
     2130                     INPUT     bfrom_wth-parts.doc-code ,
     2131                     INPUT  yes,
     2132                     INPUT     bfrom_wth-parts.type ,
     2133                     INPUT-OUTPUT v-rec
     2134                     ) no-error.
     2135                if error-status:error then undo, return error return-value + chr(10) + error-status:get-message(1) .
     2136             end.
     2137           end.
     2138           OTHERWISE DO:
     2139            run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2140                     INPUT     bfrom_wth-parts.obj-type,
     2141                     INPUT     bfrom_wth-parts.obj-code,
     2142                     INPUT     bfrom_wth-parts.w-p-code,
     2143                     INPUT     bfrom_wth-parts.wth-code,
     2144                     INPUT     bfrom_wth-parts.par-code,
     2145                     INPUT     bfrom_wth-parts.in-code ,
     2146                     INPUT     p-zone,
     2147                     INPUT     bfrom_wth-parts.ser-code,
     2148                     INPUT     bfrom_wth-parts.db-num  ,
     2149                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2150                     INPUT     bfrom_wth-parts.fact-rangeTo   ,
     2151                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2152                     INPUT     bfrom_wth-parts.fact-rangeTo  ,
     2153                     INPUT     bfrom_wth-parts.host-code     ,
     2154                     INPUT     bfrom_wth-parts.contract-code ,
     2155                     INPUT     bfrom_wth-parts.price-rubl    ,
     2156                     INPUT     bfrom_wth-parts.price-base    ,
     2157                     INPUT     bfrom_wth-parts.supp-type,
     2158                     INPUT     bfrom_wth-parts.supp-code,
     2159                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2160                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2161                     INPUT     bfrom_wth-parts.ext-doc-type,
     2162                     INPUT     bfrom_wth-parts.gds-code,
     2163                     INPUT     bfrom_wth-parts.stts             ,
     2164                     INPUT     bfrom_wth-parts.beg-dt        ,
     2165                     INPUT     bfrom_wth-parts.end-dt        ,
     2166                     INPUT     bfrom_wth-parts.vat-pc        ,
     2167                     INPUT     bfrom_wth-parts.cli-code,
     2168                     INPUT     bfrom_wth-parts.cli-type,
     2169                     INPUT     bfrom_wth-parts.out-obj-code,
     2170                     INPUT     bfrom_wth-parts.out-obj-type,
     2171                     INPUT     bfrom_wth-parts.sale-obj-code,
     2172                     INPUT     bfrom_wth-parts.sale-obj-type,
     2173                     INPUT     bfrom_wth-parts.doc-code ,
     2174                     INPUT  yes,
     2175                     INPUT      "":U ,
     2176                     INPUT-OUTPUT v-rec
     2177                     ) no-error.
     2178       if error-status:error then undo, return error return-value + chr(10) + error-status:get-message(1) .
     2179           END.
     2180       END CASE.
     2181     END.
     2182   END.
     2183   procedure wth-parts-rezerv:
     2184       define input parameter        p-param            as logical no-undo.
     2185       define input parameter        p-fact-rangeFrom   LIKE ub.wth-parts.Fact-RangeFrom no-undo .
     2186       define input parameter        p-fact-RangeTo     LIKE ub.wth-parts.Fact-RangeTo no-undo   .
     2187       define input parameter        p-beg-dt           LIKE ub.wth-parts.beg-dt no-undo .
     2188       define input parameter        p-end-dt           LIKE ub.wth-parts.end-dt no-undo .
     2189       define input parameter        p-ser-code         LIKE ub.wth-parts.ser-code no-undo.
     2190       define input parameter        p-db-num           LIKE ub.wth-parts.db-num no-undo .
     2191       define input parameter        p-price-rubl       LIKE ub.wth-parts.price-rubl no-undo .
     2192       define input parameter        p-price-base       LIKE ub.wth-parts.price-base no-undo .
     2193       define input parameter        p-vat-pc           LIKE ub.wth-parts.vat-pc no-undo .
     2194       define input parameter        p-host-code        LIKE ub.wth-parts.host-code no-undo .
     2195       define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     2196       define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     2197       define input parameter        p-w-p-code         LIKE ub.wth-parts.w-p-code no-undo .
     2198       define input parameter        p-wth-code         LIKE ub.wth-parts.wth-code no-undo .
     2199       define input parameter        p-par-code         LIKE ub.wth-parts.par-code no-undo .
     2200       define input parameter        p-in-code          LIKE ub.wth-parts.in-code no-undo .
     2201       define input parameter        p-doc-code         LIKE ub.wth-parts.out-code no-undo .
     2202       define input parameter        p-cli-type         LIKE ub.wth-parts.cli-type no-undo .
     2203       define input parameter        p-cli-code         LIKE ub.wth-parts.cli-code no-undo .
     2204       define input parameter        p-ext-doc-type     LIKE ub.wth-parts.ext-doc-type no-undo .
     2205       define input parameter        p-gds-code         LIKE ub.wth-parts.gds-code no-undo .
     2206       define input parameter        p-type             LIKE ub.wth-parts.type no-undo .
     2207       define input-output parameter p-rec        as recid     no-undo .
     2208     define buffer bfrom_wth-parts   for ub.wth-parts.
     2209     define buffer bufr_wth-doc      for ub.wth-doc.
     2210     define variable v-rec    as recid        no-undo.
     2211     define variable v-recDop as recid        no-undo.
     2212     define variable v-zone   as character    no-undo.
     2213     DEFINE variable v-beg-dt           LIKE ub.wth-parts.beg-dt no-undo .
     2214     define VARIABLE v-end-dt           LIKE ub.wth-parts.end-dt no-undo .
     2215     define variable v-price-rubl       LIKE ub.wth-parts.price-rubl no-undo .
     2216     define variable v-price-base       LIKE ub.wth-parts.price-base no-undo .
     2217     define variable v-vat-pc           LIKE ub.wth-parts.vat-pc no-undo .
     2218     define variable v-mpl-date         as date      no-undo.
     2219     empty temp-table tt-wthlib-parts.
     2220   main-block:
     2221   do  transaction
     2222   on error  undo main-block, return error return-value + chr(32) + error-status:get-message(1)
     2223   on stop   undo main-block, return error
     2224   on endkey undo main-block, return error
     2225   :
     2226   FIND FIRST bufr_wth-doc WHERE bufr_wth-doc.doc-code = p-doc-code NO-LOCK NO-ERROR.
     2227   IF NOT AVAILABLE bufr_wth-doc THEN RETURN ERROR SUBSTITUTE('Не найден документ МЦ с номером &1',p-doc-code).
     2228     if lookup(p-ext-doc-type,'ie,ip,rp,fj,pj,ff,rf':U) > 0
     2229           then do:
     2230        run str/wthpartp.p  ( INPUT 'ДОБАВЛЕНИЕ':U,
     2231                     INPUT  p-obj-type,
     2232                     INPUT  p-obj-code,
     2233                     INPUT  p-w-p-code,
     2234                     INPUT  p-wth-code,
     2235                     INPUT  p-par-code,
     2236                     INPUT  p-in-code,
     2237                     INPUT  p-doc-code,
     2238                     INPUT  p-ser-code,
     2239                     INPUT  p-db-num  ,
     2240                     INPUT  p-Fact-RangeFrom ,
     2241                     INPUT  p-fact-rangeTo  ,
     2242                     INPUT  p-Fact-RangeFrom ,
     2243                     INPUT  p-fact-rangeTo ,
     2244                     INPUT  p-host-code     ,
     2245                     INPUT  0   ,
     2246                     INPUT  p-price-rubl    ,
     2247                     INPUT  p-price-base    ,
     2248                     INPUT  '':U,
     2249                     INPUT  0,
     2250                     INPUT  p-obj-type      ,
     2251                     INPUT  p-obj-code      ,
     2252                     INPUT  p-ext-doc-type,
     2253                     INPUT  p-gds-code,
     2254                     INPUT  0           ,
     2255                     INPUT  p-beg-dt        ,
     2256                     INPUT  p-end-dt        ,
     2257                     INPUT  p-vat-pc      ,
     2258                     INPUT  0,
     2259                     INPUT  '':U,
     2260                     INPUT  0,
     2261                     INPUT  '':U,
     2262                     INPUT  0,
     2263                     INPUT  '':U,
     2264                     INPUT  p-doc-code,
     2265                     INPUT  yes,
     2266                     INPUT p-type,
     2267                     INPUT-OUTPUT p-rec
     2268                     ) no-error.
     2269                   if error-status:error then undo main-block, return error return-value + error-status:get-message(1) .
     2270     end.
     2271     else do:
     2272       if p-rec <> ? then do:
     2273         find first bfrom_wth-parts exclusive-lock where
     2274                   recid(bfrom_wth-parts) = p-rec no-error.
     2275         if  available bfrom_wth-parts
     2276           and bfrom_wth-parts.wth-code = p-wth-code
     2277           and bfrom_wth-parts.par-code = p-par-code
     2278           and bfrom_wth-parts.ser-code = p-ser-code
     2279           and lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) > 0
     2280         then.
     2281         else if  available bfrom_wth-parts and lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) = 0
     2282         then return error substitute('Резервирование из партии (Код серии: &1-&2 Диапазон &3-&4) невозможно, т.к. партия уже входит в состав документа'
     2283                                      ,bfrom_wth-parts.ser-code
     2284                                      ,bfrom_wth-parts.db-num
     2285                                      ,bfrom_wth-parts.doc-rangeFrom
     2286                                      ,bfrom_wth-parts.doc-rangeTo).
     2287         else if  available bfrom_wth-parts then undo, return error 'Партия указанная для резервирования не соответсвует указанным параметрам!'.
     2288         if available bfrom_wth-parts
     2289            and bfrom_wth-parts.doc-rangeFrom > p-fact-rangeFrom
     2290            or bfrom_wth-parts.doc-rangeTo   < p-fact-rangeTo
     2291         then undo, return error substitute('Нельзя увеличивать границы диапазона.&1Диапазон партии &2-&3.&1Диапазон резервирования &4-&5'
     2292                                            ,chr(10)
     2293                                            ,bfrom_wth-parts.doc-rangeFrom
     2294                                            ,bfrom_wth-parts.doc-rangeTo
     2295                                            ,p-fact-rangeFrom
     2296                                            ,p-fact-rangeTo).
     2297       end.
     2298       else do:
     2299         if p-ext-doc-type = 'pz':U or (p-ext-doc-type = 'xc':U and p-type = 'при':U )then do:
     2300           for first bfrom_wth-parts no-lock where
     2301                                     bfrom_wth-parts.wth-code = p-wth-code
     2302                                 and bfrom_wth-parts.par-code = p-par-code
     2303                                 and bfrom_wth-parts.ser-code = p-ser-code
     2304                                 and bfrom_wth-parts.db-num = p-db-num
     2305                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2306                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2307                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2308                                 and bfrom_wth-parts.stts = 0
     2309                                 and bfrom_wth-parts.cli-code = p-cli-code
     2310                                 and bfrom_wth-parts.cli-type = p-cli-type
     2311                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2312                                 use-index  wth-idnt:
     2313                                 p-rec = recid(bfrom_wth-parts).
     2314            end.
     2315           If p-rec = ? and p-in-code > '' then do:
     2316              for first bfrom_wth-parts no-lock where
     2317                                     bfrom_wth-parts.wth-code = p-wth-code
     2318                                 and bfrom_wth-parts.par-code = p-par-code
     2319                                 and bfrom_wth-parts.ser-code = p-ser-code
     2320                                 and bfrom_wth-parts.db-num = p-db-num
     2321                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2322                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2323                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2324                                 and bfrom_wth-parts.stts = 0
     2325                                 and bfrom_wth-parts.cli-code = p-cli-code
     2326                                 and bfrom_wth-parts.cli-type = p-cli-type
     2327                                 use-index  wth-idnt:
     2328                                 p-rec = recid(bfrom_wth-parts).
     2329                 end.
     2330           end.
     2331                 if p-rec <> ? then  find first bfrom_wth-parts no-lock where
     2332                   recid(bfrom_wth-parts) = p-rec no-error.
     2333         end.
     2334         else if p-ext-doc-type = 'pc':U or p-ext-doc-type = 'ps':U or p-ext-doc-type = 'dc':U then do:
     2335           for first bfrom_wth-parts no-lock where bfrom_wth-parts.wth-code = p-wth-code
     2336                                 and bfrom_wth-parts.par-code = p-par-code
     2337                                 and bfrom_wth-parts.ser-code = p-ser-code
     2338                                 and bfrom_wth-parts.db-num = p-db-num
     2339                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2340                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2341                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2342                                 and bfrom_wth-parts.stts = 0
     2343                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2344                                 use-index wth-idnt:
     2345                                 p-rec = recid(bfrom_wth-parts).
     2346            end.
     2347           If p-rec = ? and p-in-code > '' then do:
     2348            for first bfrom_wth-parts no-lock where bfrom_wth-parts.wth-code = p-wth-code
     2349                                 and bfrom_wth-parts.par-code = p-par-code
     2350                                 and bfrom_wth-parts.ser-code = p-ser-code
     2351                                 and bfrom_wth-parts.db-num = p-db-num
     2352                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2353                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2354                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2355                                 and bfrom_wth-parts.stts = 0
     2356                                 :
     2357                                 p-rec = recid(bfrom_wth-parts).
     2358            end.
     2359           end.
     2360           if p-rec <> ? then  find first bfrom_wth-parts no-lock where
     2361                   recid(bfrom_wth-parts) = p-rec no-error.
     2362         end.
     2363         else do:
     2364           CASE p-ext-doc-type:
     2365                   WHEN 'ee':U or when 'xc':U or WHEN 'ef':U
     2366                   or when 'jj':U THEN DO:
     2367                       v-zone = 'free-zone':U.
     2368                   END.
     2369                   WHEN 'ep':U or when 'oj':U THEN DO:
     2370                       v-zone = 'put-zone':U.
     2371                   END.
     2372                   WHEN 'df':U THEN DO:
     2373                       v-zone = 'free-zone':U.
     2374                   END.
     2375                   WHEN 'dp':U  THEN DO:
     2376                       v-zone = 'put-zone':U.
     2377                   END.
     2378                   WHEN 'pc':U OR WHEN 'ps':U OR WHEN 'pz':U OR WHEN 'dc':U THEN DO:
     2379                       v-zone = 'cli-zone':U.
     2380                   END.
     2381                   OTHERWISE DO:
     2382                       RETURN ERROR substitute("Неверный вызов процедуры резервирования: расш. тип = &1"
     2383                                            , p-ext-doc-type
     2384                                               ).
     2385                   END.
     2386           END CASE.
     2387           find first bfrom_wth-parts no-lock where
     2388                                     bfrom_wth-parts.wth-code = p-wth-code
     2389                                 and bfrom_wth-parts.obj-code = p-obj-code
     2390                                 and bfrom_wth-parts.obj-type = p-obj-type
     2391                                 and bfrom_wth-parts.w-p-code = p-w-p-code
     2392                                 and bfrom_wth-parts.par-code = p-par-code
     2393                                 and bfrom_wth-parts.ser-code = p-ser-code
     2394                                 and bfrom_wth-parts.db-num = p-db-num
     2395                                 and bfrom_wth-parts.out-code = v-zone
     2396                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2397                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2398                                 and bfrom_wth-parts.stts = 0
     2399                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2400                                 no-error.
     2401          If not available bfrom_wth-parts and p-in-code > '' then do:
     2402                  find first bfrom_wth-parts no-lock where
     2403                                     bfrom_wth-parts.wth-code = p-wth-code
     2404                                 and bfrom_wth-parts.obj-code = p-obj-code
     2405                                 and bfrom_wth-parts.obj-type = p-obj-type
     2406                                 and bfrom_wth-parts.w-p-code = p-w-p-code
     2407                                 and bfrom_wth-parts.par-code = p-par-code
     2408                                 and bfrom_wth-parts.ser-code = p-ser-code
     2409                                 and bfrom_wth-parts.db-num = p-db-num
     2410                                 and bfrom_wth-parts.out-code = v-zone
     2411                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2412                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2413                                 and bfrom_wth-parts.stts = 0
     2414                                 no-error.
     2415          end.
     2416         end.
     2417       end.
     2418       if not available bfrom_wth-parts then do:
     2419            if g#news then do:
     2420             return error 'forged':U.
     2421            end.
     2422            else
     2423             undo, return error substitute("Не найдена партия МЦ для резервирования &1Код МЦ &2&1Код номинала &3&1Код серии &4&1Диапазон с &5 по &6&1
     2424                                           ",chr(10),p-wth-code,p-par-code,p-ser-code,p-fact-rangeFrom,
     2425                                           p-fact-rangeTo).
     2426       end.
     2427       p-rec = recid(bfrom_wth-parts).
     2428       find current bfrom_wth-parts exclusive-lock.
     2429       create tt-wthlib-parts.
     2430       buffer-copy bfrom_wth-parts to tt-wthlib-parts.
     2431           ASSIGN v-beg-dt = if p-param then p-beg-dt else bfrom_wth-parts.beg-dt
     2432                  v-end-dt = if p-param then p-end-dt else bfrom_wth-parts.end-dt
     2433                  v-vat-pc = if p-param then p-vat-pc else bfrom_wth-parts.vat-pc
     2434                  v-price-rubl = if p-param then p-price-rubl else bfrom_wth-parts.price-rubl
     2435                  v-price-base = if p-param then p-price-base else bfrom_wth-parts.price-base  .
     2436       IF  not g#news and (p-ext-doc-type = 'ee':U or p-ext-doc-type = 'xc':U)  THEN DO:
     2437           IF v-beg-dt = ? AND v-end-dt = ? THEN DO:
     2438               RUN init_prtdate ( INPUT p-obj-type
     2439                                                 ,INPUT p-obj-code
     2440                                                 ,INPUT p-ser-code
     2441                                                 ,INPUT p-db-num
     2442                                                 ,INPUT bufr_wth-doc.doc-date
     2443                                                 ,OUTPUT v-beg-dt
     2444                                                 ,OUTPUT v-end-dt ) NO-ERROR.
     2445               if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2446           END.
     2447           IF v-price-rubl = 0 AND v-price-base = 0 THEN DO:
     2448             run set-wthmpl-date ( bufr_wth-doc.doc-code
     2449                                ,bufr_wth-doc.doc-date
     2450                                , v-beg-dt
     2451                                , output v-mpl-date) no-error.
     2452               RUN INIT_prtprice (
     2453                             p-host-code
     2454                           , p-obj-type
     2455                           , p-obj-code
     2456                           , p-cli-type
     2457                           , p-cli-code
     2458                           , p-wth-code
     2459                           , p-gds-code
     2460                           , p-par-code
     2461                           , v-mpl-date
     2462                           , OUTPUT  v-vat-pc
     2463                           , OUTPUT  v-price-rubl
     2464                           , OUTPUT  v-price-base
     2465                   ) NO-ERROR.
     2466             if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2467           END.
     2468       END.
     2469         run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2470                     INPUT     p-obj-type,
     2471                     INPUT     p-obj-code,
     2472                     INPUT     p-w-p-code,
     2473                     INPUT     bfrom_wth-parts.wth-code,
     2474                     INPUT     bfrom_wth-parts.par-code,
     2475                     INPUT     bfrom_wth-parts.in-code ,
     2476                     INPUT     p-doc-code,
     2477                     INPUT     bfrom_wth-parts.ser-code,
     2478                     INPUT     bfrom_wth-parts.db-num  ,
     2479                     INPUT     p-Fact-RangeFrom ,
     2480                     INPUT     p-fact-rangeTo  ,
     2481                     INPUT     p-Fact-RangeFrom ,
     2482                     INPUT     p-fact-rangeTo ,
     2483                     INPUT     bfrom_wth-parts.host-code     ,
     2484                     INPUT     bfrom_wth-parts.contract-code               ,
     2485                     INPUT     v-price-rubl ,
     2486                     INPUT     v-price-base  ,
     2487                     INPUT     bfrom_wth-parts.supp-type,
     2488                     INPUT     bfrom_wth-parts.supp-code,
     2489                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2490                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2491                     INPUT     p-ext-doc-type,
     2492                     INPUT     bfrom_wth-parts.gds-code,
     2493                     INPUT     0              ,
     2494                     INPUT     v-beg-dt    ,
     2495                     INPUT     v-end-dt   ,
     2496                     INPUT     v-vat-pc    ,
     2497                     INPUT     bfrom_wth-parts.cli-code,
     2498                     INPUT     bfrom_wth-parts.cli-type,
     2499                     INPUT     bfrom_wth-parts.out-obj-code,
     2500                     INPUT     bfrom_wth-parts.out-obj-type,
     2501                     INPUT     bfrom_wth-parts.sale-obj-code,
     2502                     INPUT     bfrom_wth-parts.sale-obj-type,
     2503                     INPUT     bfrom_wth-parts.doc-code,
     2504                     INPUT     yes,
     2505                     INPUT     p-type,
     2506                     INPUT-OUTPUT p-rec
     2507                     ) no-error.
     2508       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2509       if tt-wthlib-parts.fact-rangeFrom <> p-fact-rangeFrom then do:
     2510       run str/wthpartp.p ( INPUT     'ДОБАВЛЕНИЕ':U,
     2511                     INPUT     tt-wthlib-parts.obj-type,
     2512                     INPUT     tt-wthlib-parts.obj-code,
     2513                     INPUT     tt-wthlib-parts.w-p-code,
     2514                     INPUT     tt-wthlib-parts.wth-code,
     2515                     INPUT     tt-wthlib-parts.par-code,
     2516                     INPUT     tt-wthlib-parts.in-code ,
     2517                     INPUT     tt-wthlib-parts.out-code,
     2518                     INPUT     tt-wthlib-parts.ser-code,
     2519                     INPUT     tt-wthlib-parts.db-num  ,
     2520                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2521                     INPUT     p-fact-rangeFrom - 1  ,
     2522                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2523                     INPUT     p-fact-rangeFrom - 1,
     2524                     INPUT     tt-wthlib-parts.host-code     ,
     2525                     INPUT     tt-wthlib-parts.contract-code               ,
     2526                     INPUT     tt-wthlib-parts.price-rubl    ,
     2527                     INPUT     tt-wthlib-parts.price-base    ,
     2528                     INPUT     tt-wthlib-parts.supp-type,
     2529                     INPUT     tt-wthlib-parts.supp-code,
     2530                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2531                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2532                     INPUT     tt-wthlib-parts.ext-doc-type,
     2533                     INPUT     tt-wthlib-parts.gds-code,
     2534                     INPUT     tt-wthlib-parts.stts               ,
     2535                     INPUT     tt-wthlib-parts.beg-dt        ,
     2536                     INPUT     tt-wthlib-parts.end-dt        ,
     2537                     INPUT     tt-wthlib-parts.vat-pc        ,
     2538                     INPUT     tt-wthlib-parts.cli-code,
     2539                     INPUT     tt-wthlib-parts.cli-type,
     2540                     INPUT     tt-wthlib-parts.out-obj-code,
     2541                     INPUT     tt-wthlib-parts.out-obj-type,
     2542                     INPUT     tt-wthlib-parts.sale-obj-code,
     2543                     INPUT     tt-wthlib-parts.sale-obj-type,
     2544                     INPUT     tt-wthlib-parts.doc-code,
     2545                     INPUT  yes,
     2546                     INPUT    tt-wthlib-parts.type,
     2547                     INPUT-OUTPUT v-recDop
     2548                     ) no-error.
     2549       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2550       end.
     2551       if tt-wthlib-parts.fact-rangeTo <> p-fact-rangeTo then do:
     2552               run str/wthpartp.p    ( INPUT 'ДОБАВЛЕНИЕ':U,
     2553                     INPUT     tt-wthlib-parts.obj-type,
     2554                     INPUT     tt-wthlib-parts.obj-code,
     2555                     INPUT     tt-wthlib-parts.w-p-code,
     2556                     INPUT     tt-wthlib-parts.wth-code,
     2557                     INPUT     tt-wthlib-parts.par-code,
     2558                     INPUT     tt-wthlib-parts.in-code ,
     2559                     INPUT     tt-wthlib-parts.out-code,
     2560                     INPUT     tt-wthlib-parts.ser-code,
     2561                     INPUT     tt-wthlib-parts.db-num  ,
     2562                     INPUT     p-fact-rangeTo + 1 ,
     2563                     INPUT     tt-wthlib-parts.fact-rangeTo  ,
     2564                     INPUT     p-fact-rangeTo + 1 ,
     2565                     INPUT     tt-wthlib-parts.fact-rangeTo,
     2566                     INPUT     tt-wthlib-parts.host-code     ,
     2567                     INPUT     tt-wthlib-parts.contract-code               ,
     2568                     INPUT     tt-wthlib-parts.price-rubl    ,
     2569                     INPUT     tt-wthlib-parts.price-base    ,
     2570                     INPUT     tt-wthlib-parts.supp-type,
     2571                     INPUT     tt-wthlib-parts.supp-code,
     2572                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2573                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2574                     INPUT     tt-wthlib-parts.ext-doc-type,
     2575                     INPUT     tt-wthlib-parts.gds-code,
     2576                     INPUT     tt-wthlib-parts.stts               ,
     2577                     INPUT     tt-wthlib-parts.beg-dt        ,
     2578                     INPUT     tt-wthlib-parts.end-dt        ,
     2579                     INPUT     tt-wthlib-parts.vat-pc        ,
     2580                     INPUT     tt-wthlib-parts.cli-code,
     2581                     INPUT     tt-wthlib-parts.cli-type,
     2582                     INPUT     tt-wthlib-parts.out-obj-code,
     2583                     INPUT     tt-wthlib-parts.out-obj-type,
     2584                     INPUT     tt-wthlib-parts.sale-obj-code,
     2585                     INPUT     tt-wthlib-parts.sale-obj-type,
     2586                     INPUT     tt-wthlib-parts.doc-code,
     2587                     INPUT     yes,
     2588                     INPUT     tt-wthlib-parts.type,
     2589                     INPUT-OUTPUT v-recDop
     2590                     ) no-error.
     2591         if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2592       end.
     2593     end.
     2594   end.
     2595   end procedure.
     2596   procedure wth-parts-inter-edit:
     2597     define input parameter        p-fact-rangeFrom   LIKE ub.wth-parts.Fact-RangeFrom no-undo .
     2598     define input parameter        p-fact-RangeTo     LIKE ub.wth-parts.Fact-RangeTo no-undo   .
     2599     define input-output parameter p-rec        as recid     no-undo .
     2600     define buffer bfrom_wth-parts   for ub.wth-parts.
     2601     define variable v-recDop as recid        no-undo.
     2602     do on error undo, return error:
     2603         find first bfrom_wth-parts exclusive-lock where
     2604                   recid(bfrom_wth-parts) = p-rec no-error.
     2605         if not available bfrom_wth-parts then return error
     2606           substitute('Не найдена партия (recid &1)', p-rec).
     2607         if p-fact-rangeFrom < bfrom_wth-parts.doc-rangeFrom or
     2608            p-fact-rangeTo > bfrom_wth-parts.doc-rangeTo then do:
     2609            return error 'Нельзя увеличивать границы диапазона.'.
     2610         end.
     2611         empty temp-table tt-wthlib-parts.
     2612         create tt-wthlib-parts.
     2613         buffer-copy bfrom_wth-parts to tt-wthlib-parts.
     2614         run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2615                     INPUT     bfrom_wth-parts.obj-type,
     2616                     INPUT     bfrom_wth-parts.obj-code,
     2617                     INPUT     bfrom_wth-parts.w-p-code,
     2618                     INPUT     bfrom_wth-parts.wth-code,
     2619                     INPUT     bfrom_wth-parts.par-code,
     2620                     INPUT     bfrom_wth-parts.in-code ,
     2621                     INPUT     bfrom_wth-parts.doc-code,
     2622                     INPUT     bfrom_wth-parts.ser-code,
     2623                     INPUT     bfrom_wth-parts.db-num  ,
     2624                     INPUT     p-Fact-RangeFrom ,
     2625                     INPUT     p-fact-rangeTo  ,
     2626                     INPUT     p-Fact-RangeFrom ,
     2627                     INPUT     p-fact-rangeTo ,
     2628                     INPUT     bfrom_wth-parts.host-code     ,
     2629                     INPUT     bfrom_wth-parts.contract-code               ,
     2630                     INPUT     bfrom_wth-parts.price-rubl  ,
     2631                     INPUT     bfrom_wth-parts.price-base    ,
     2632                     INPUT     bfrom_wth-parts.supp-type,
     2633                     INPUT     bfrom_wth-parts.supp-code,
     2634                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2635                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2636                     INPUT     bfrom_wth-parts.ext-doc-type,
     2637                     INPUT     bfrom_wth-parts.gds-code,
     2638                     INPUT     0              ,
     2639                     INPUT     bfrom_wth-parts.beg-dt      ,
     2640                     INPUT     bfrom_wth-parts.end-dt      ,
     2641                     INPUT     bfrom_wth-parts.vat-pc      ,
     2642                     INPUT     bfrom_wth-parts.cli-code,
     2643                     INPUT     bfrom_wth-parts.cli-type,
     2644                     INPUT     bfrom_wth-parts.out-obj-code,
     2645                     INPUT     bfrom_wth-parts.out-obj-type,
     2646                     INPUT     bfrom_wth-parts.sale-obj-code,
     2647                     INPUT     bfrom_wth-parts.sale-obj-type,
     2648                     INPUT     bfrom_wth-parts.doc-code,
     2649                     INPUT     yes,
     2650                     INPUT     bfrom_wth-parts.type,
     2651                     INPUT-OUTPUT p-rec
     2652                     ) no-error.
     2653       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2654       if tt-wthlib-parts.fact-rangeFrom <> p-fact-rangeFrom then do:
     2655       run str/wthpartp.p ( INPUT     'ДОБАВЛЕНИЕ':U,
     2656                     INPUT     tt-wthlib-parts.obj-type,
     2657                     INPUT     tt-wthlib-parts.obj-code,
     2658                     INPUT     tt-wthlib-parts.w-p-code,
     2659                     INPUT     tt-wthlib-parts.wth-code,
     2660                     INPUT     tt-wthlib-parts.par-code,
     2661                     INPUT     tt-wthlib-parts.in-code ,
     2662                     INPUT     tt-wthlib-parts.out-code,
     2663                     INPUT     tt-wthlib-parts.ser-code,
     2664                     INPUT     tt-wthlib-parts.db-num  ,
     2665                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2666                     INPUT     p-fact-rangeFrom - 1  ,
     2667                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2668                     INPUT     p-fact-rangeFrom - 1,
     2669                     INPUT     tt-wthlib-parts.host-code     ,
     2670                     INPUT     tt-wthlib-parts.contract-code               ,
     2671                     INPUT     tt-wthlib-parts.price-rubl    ,
     2672                     INPUT     tt-wthlib-parts.price-base    ,
     2673                     INPUT     tt-wthlib-parts.supp-type,
     2674                     INPUT     tt-wthlib-parts.supp-code,
     2675                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2676                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2677                     INPUT     tt-wthlib-parts.ext-doc-type,
     2678                     INPUT     tt-wthlib-parts.gds-code,
     2679                     INPUT     1             ,
     2680                     INPUT     tt-wthlib-parts.beg-dt        ,
     2681                     INPUT     tt-wthlib-parts.end-dt        ,
     2682                     INPUT     tt-wthlib-parts.vat-pc        ,
     2683                     INPUT     tt-wthlib-parts.cli-code,
     2684                     INPUT     tt-wthlib-parts.cli-type,
     2685                     INPUT     tt-wthlib-parts.out-obj-code,
     2686                     INPUT     tt-wthlib-parts.out-obj-type,
     2687                     INPUT     tt-wthlib-parts.sale-obj-code,
     2688                     INPUT     tt-wthlib-parts.sale-obj-type,
     2689                     INPUT     tt-wthlib-parts.doc-code,
     2690                     INPUT  yes,
     2691                     INPUT    tt-wthlib-parts.type,
     2692                     INPUT-OUTPUT v-recDop
     2693                     ) no-error.
     2694       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2695       end.
     2696       if tt-wthlib-parts.fact-rangeTo <> p-fact-rangeTo then do:
     2697               run str/wthpartp.p    ( INPUT 'ДОБАВЛЕНИЕ':U,
     2698                     INPUT     tt-wthlib-parts.obj-type,
     2699                     INPUT     tt-wthlib-parts.obj-code,
     2700                     INPUT     tt-wthlib-parts.w-p-code,
     2701                     INPUT     tt-wthlib-parts.wth-code,
     2702                     INPUT     tt-wthlib-parts.par-code,
     2703                     INPUT     tt-wthlib-parts.in-code ,
     2704                     INPUT     tt-wthlib-parts.out-code,
     2705                     INPUT     tt-wthlib-parts.ser-code,
     2706                     INPUT     tt-wthlib-parts.db-num  ,
     2707                     INPUT     p-fact-rangeTo + 1 ,
     2708                     INPUT     tt-wthlib-parts.fact-rangeTo  ,
     2709                     INPUT     p-fact-rangeTo + 1 ,
     2710                     INPUT     tt-wthlib-parts.fact-rangeTo,
     2711                     INPUT     tt-wthlib-parts.host-code     ,
     2712                     INPUT     tt-wthlib-parts.contract-code               ,
     2713                     INPUT     tt-wthlib-parts.price-rubl    ,
     2714                     INPUT     tt-wthlib-parts.price-base    ,
     2715                     INPUT     tt-wthlib-parts.supp-type,
     2716                     INPUT     tt-wthlib-parts.supp-code,
     2717                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2718                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2719                     INPUT     tt-wthlib-parts.ext-doc-type,
     2720                     INPUT     tt-wthlib-parts.gds-code,
     2721                     INPUT     1             ,
     2722                     INPUT     tt-wthlib-parts.beg-dt        ,
     2723                     INPUT     tt-wthlib-parts.end-dt        ,
     2724                     INPUT     tt-wthlib-parts.vat-pc        ,
     2725                     INPUT     tt-wthlib-parts.cli-code,
     2726                     INPUT     tt-wthlib-parts.cli-type,
     2727                     INPUT     tt-wthlib-parts.out-obj-code,
     2728                     INPUT     tt-wthlib-parts.out-obj-type,
     2729                     INPUT     tt-wthlib-parts.sale-obj-code,
     2730                     INPUT     tt-wthlib-parts.sale-obj-type,
     2731                     INPUT     tt-wthlib-parts.doc-code,
     2732                     INPUT     yes,
     2733                     INPUT     tt-wthlib-parts.type,
     2734                     INPUT-OUTPUT v-recDop
     2735                     ) no-error.
     2736         if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2737         end.
     2738     end.
     2739   end procedure.
     2740   PROCEDURE INIT_prtdate:
     2741       define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     2742       define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     2743       define input parameter        p-ser-code         LIKE ub.wth-parts.ser-code no-undo.
     2744       define input parameter        p-db-num           LIKE ub.wth-parts.db-num no-undo .
     2745       define input parameter        p-date                AS DATE no-undo .
     2746       DEFINE OUTPUT PARAMETER p-beg-dt AS DATE NO-UNDO.
     2747       DEFINE OUTPUT PARAMETER p-end-dt AS DATE NO-UNDO.
     2748       DEFINE BUFFER buf_wth-ser FOR ub.wth-ser.
     2749       DEFINE VARIABLE v-rangeRule AS INT NO-UNDO.
     2750       define variable v-value-character as character no-undo .
     2751       define variable v-value-date as date no-undo .
     2752       define variable v-value-decimal as decimal no-undo .
     2753       define variable v-value-integer as INTEGER no-undo .
     2754       define variable v-value-logical AS LOGICAL no-undo .
     2755       define variable v-param-type as character no-undo .
     2756       FIND FIRST buf_wth-ser NO-LOCK
     2757           WHERE buf_wth-ser.ser-code = p-ser-code
     2758           AND buf_wth-ser.db-num = p-db-num.
     2759       IF buf_wth-ser.chk-bdt = 2 THEN DO:
     2760           p-beg-dt = buf_wth-ser.beg-dt.
     2761       END.
     2762       IF buf_wth-ser.chk-edt = 2 THEN DO:
     2763           p-end-dt = buf_wth-ser.end-dt.
     2764       END.
     2765       IF buf_wth-ser.chk-bdt = 0 AND buf_wth-ser.chk-edt = 0 THEN DO:
     2766           run adm/shattri.p (
     2767               input "get":U
     2768               ,input  p-obj-type
     2769               ,input  p-obj-code
     2770               ,input  'wthdoc_obj':U
     2771               ,input  'rangerule':U
     2772               ,output v-value-character
     2773               ,output v-value-date
     2774               ,output v-value-decimal
     2775               ,output v-value-integer
     2776               ,output v-value-logical
     2777               ,output v-param-type
     2778               ,INPUT-OUTPUT table-handle v-tth
     2779               ) no-error .
     2780           IF not error-status:error  then do:
     2781               v-rangeRule =  v-value-integer.
     2782           END.
     2783           CASE v-rangeRule:
     2784           WHEN 1 THEN DO:
     2785               IF MONTH(p-date) < 11 THEN ASSIGN p-beg-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 1,YEAR(p-date)))
     2786                                                 p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 2,YEAR(p-date))) - 1.
     2787               ELSE IF MONTH(p-date) = 11 THEN ASSIGN p-beg-dt = DATE(substitute('01/12/&1',YEAR(p-date)))
     2788                                                 p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date) + 1)).
     2789               ELSE IF MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('01/01/&1',YEAR(p-date) + 1))
     2790                                                 p-end-dt = DATE(substitute('31/01/&1',YEAR(p-date) + 1)).
     2791           END.
     2792           when 2 then do:
     2793             IF MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('&1/12/&2',day(p-date),YEAR(p-date)))
     2794                                               p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date))).
     2795             else ASSIGN p-beg-dt = DATE(substitute('&3/&1/&2',MONTH(p-date),YEAR(p-date),day(p-date)))
     2796                         p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 1,YEAR(p-date))) - 1
     2797                        .
     2798           end.
     2799           WHEN 3 THEN DO:
     2800               IF MONTH(p-date) < 10 THEN ASSIGN p-beg-dt = DATE(substitute('&1/&2/&3',day(p-date),MONTH(p-date),YEAR(p-date)))
     2801                                                 p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 3,YEAR(p-date))) - 1.
     2802               else if MONTH(p-date) = 10 THEN ASSIGN p-beg-dt = DATE(substitute('&1/10/&2',day(p-date),YEAR(p-date)))
     2803                                               p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date))).
     2804               else if MONTH(p-date) = 11 THEN ASSIGN p-beg-dt = DATE(substitute('&1/11/&2',day(p-date),YEAR(p-date)))
     2805                                               p-end-dt = DATE(substitute('31/01/&1',YEAR(p-date) + 1)).
     2806               else if MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('&1/12/&2',day(p-date),YEAR(p-date)))
     2807                                               p-end-dt = DATE(substitute('01/03/&1',YEAR(p-date) + 1)) - 1.
     2808           END.
     2809           when 4 then do:
     2810                p-beg-dt = p-date.
     2811                p-end-dt = date(substitute('31/12/&1',YEAR(p-date))).
     2812           end.
     2813           END CASE.
     2814       END.
     2815   END.
     2816   PROCEDURE INIT_prtprice:
     2817   define input parameter        p-host-code        LIKE ub.wth-parts.obj-type no-undo .
     2818   define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     2819   define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     2820   define input parameter        p-cli-type         LIKE ub.wth-parts.cli-type no-undo .
     2821   define input parameter        p-cli-code         LIKE ub.wth-parts.cli-code no-undo .
     2822   define input parameter        p-wth-code         LIKE ub.wth-parts.ser-code no-undo.
     2823   define input parameter        p-gds-code         LIKE ub.wth-parts.gds-code no-undo .
     2824   define input parameter        p-par-code         LIKE ub.wth-parts.par-code no-undo .
     2825   define input parameter        p-date                AS DATE no-undo .
     2826   DEFINE OUTPUT PARAMETER p-vat-pc LIKE ub.wth-parts.vat-pc NO-UNDO.
     2827   DEFINE OUTPUT PARAMETER p-price-rubl LIKE ub.wth-parts.price-rubl NO-UNDO.
     2828   DEFINE OUTPUT PARAMETER p-price-base LIKE ub.wth-parts.price-base NO-UNDO.
     2829   DEFINE BUFFER b-cash-pay FOR ub.cash-pay.
     2830   DEFINE BUFFER b-wth-par FOR ub.wth-par.
     2831   DEF VAR v-cash-type-pay AS CHAR no-undo.
     2832   define variable p-plt-id AS INT no-undo.
     2833   define variable  p-plt-db-num   AS INT no-undo.
     2834   define variable  p-pdf-id  AS INT no-undo.
     2835   define variable  p-pdf-db-num AS INT no-undo.
     2836   define variable  p-sale-price-base AS DEC no-undo.
     2837   define variable  p-sale-price-rubl AS DEC no-undo.
     2838   define variable  p-road-tax-base AS DEC no-undo.
     2839   define variable  p-road-tax-rubl AS DEC no-undo.
     2840   define variable  p-excise-base AS DEC no-undo.
     2841   define variable  p-excise-rubl AS DEC no-undo.
     2842   define variable  p-fact-order  AS DEC no-undo.
     2843   do on error undo, return error return-value :
     2844     FIND FIRST b-wth-par NO-LOCK WHERE b-wth-par.par-code = p-par-code
     2845                                     AND b-wth-par.wth-code = p-wth-code NO-ERROR.
     2846     IF NOT AVAILABLE b-wth-par THEN RETURN ERROR SUBSTITUTE("Не наден номинал с кодом &1",p-par-code).
     2847     FIND FIRST b-cash-pay WHERE b-cash-pay.wth-code = p-wth-code NO-LOCK NO-ERROR.
     2848     IF AVAILABLE b-cash-pay THEN v-cash-type-pay = STRING(recid(b-cash-pay)).
     2849     ELSE v-cash-type-pay = ?.
     2850     run fact-order-mpl (
     2851         INPUT p-date ,
     2852         INPUT p-obj-type ,
     2853         INPUT p-obj-code ,
     2854         OUTPUT p-fact-order
     2855         ) no-error .
     2856     if error-status:error then do:
     2857       message   return-value skip error-status:get-message(1)
     2858       skip  'Получение цены из множественного прайс-листа отклонено.'
     2859       view-as alert-box.
     2860       return.
     2861     end.
     2862   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2863   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2864     (input  p-gds-code
     2865     ,input  '1':U
     2866     ,input  ?
     2867     ,input  p-host-code
     2868     ,input  p-obj-type
     2869     ,input  p-obj-code
     2870     ,output p-vat-pc
     2871     ) no-error .
     2872     run mpl-autoprice in this-procedure
     2873       ( input    false
     2874         ,input   p-cli-type
     2875         ,input   p-cli-code
     2876         ,input   p-gds-code
     2877         ,input   p-gds-code
     2878         ,input   p-obj-type
     2879         ,input   p-obj-code
     2880         ,input   0
     2881         ,input   0
     2882         ,input   ""
     2883         ,input   v-cash-type-pay
     2884         ,input   p-fact-order
     2885         ,output  p-plt-id
     2886         ,output  p-plt-db-num
     2887         ,output  p-pdf-id
     2888         ,output  p-pdf-db-num
     2889         ,output  p-sale-price-base
     2890         ,output  p-sale-price-rubl
     2891         ,output  p-road-tax-base
     2892         ,output  p-road-tax-rubl
     2893         ,output  p-excise-base
     2894         ,output  p-excise-rubl
     2895         ) no-error .
     2896     if error-status:error then do:
     2897       message   return-value skip error-status:get-message(1) view-as alert-box.
     2898       return.
     2899     end.
     2900     p-price-rubl = p-sale-price-rubl * b-wth-par.par-val.
     2901     p-price-base = p-sale-price-base * b-wth-par.par-val.
     2902   end.
     2903   END.
     2904   procedure  set-wthmpl-date:
     2905   define input parameter p-doc-code like ub.wth-doc.doc-code no-undo.
     2906   define input parameter p-doc-date like ub.wth-doc.doc-date no-undo.
     2907   define input parameter p-beg-dt   like ub.wth-parts.beg-dt no-undo.
     2908   define output parameter p-date    like ub.wth-doc.doc-date no-undo.
     2909   define variable v-atrValue      as character no-undo .
     2910   define variable v-atrDsf      as CHARACTER no-undo .
     2911   define variable v-atrType     as character no-undo .
     2912   do on error undo, return error return-value :
     2913   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input p-doc-code ,
     2914                           input 'wthdsf':U ,
     2915                          output v-atrValue ,
     2916                          output v-atrType )  .
     2917     p-date = date(v-atrValue) no-error.
     2918     if p-date = ? then p-date = p-beg-dt no-error.
     2919     if p-date = ? then p-date = p-doc-date.
     2920   end.
     2921   end procedure.
