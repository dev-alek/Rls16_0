     3300   run minbtn-set in this-procedure .
     3301   on choose of b-help in frame Dialog-Frame
     3302   do:
     3303     apply "help":u to frame Dialog-Frame .
     3304   end.
     3305   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3306   procedure minbtn-set :
     3307       do
     3308           on error undo, return error return-value
     3309           :
     3310           define variable ii              as integer       no-undo .
     3311           define variable fh              as widget-handle no-undo .
     3312           define variable hh              as widget-handle no-undo .
     3313           define variable v-h             as handle        extent 4 no-undo .
     3314           define variable v-name-button   as character     no-undo .
     3315           define variable v-help-old-x    as decimal       no-undo .
     3316           define variable v-help-old-y    as decimal       no-undo .
     3317           define variable v-help-old-size as decimal       no-undo .
     3318           define variable v-frame-width   as decimal       no-undo .
     3319           define variable jj              as integer       no-undo .
     3320           do
     3321               on error undo, return error
     3322               :
     3323               assign
     3324                   v-frame-width = frame Dialog-Frame:width - 0.3
     3325                   fh            = frame Dialog-Frame:first-child
     3326                   hh            = fh:first-child
     3327                   ii            = 1
     3328                   .
     3329               do while valid-handle(hh):
     3330                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3331                   do:
     3332                       case lc(hh:name) :
     3333                           when "b-help" then
     3334                               do:
     3335                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3336                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3337                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3338                                   hh:TOOLTIP = "Помощь" .
     3339                                   v-help-old-x = hh:column .
     3340                                   v-help-old-y = hh:row    .
     3341                                   v-help-old-size = hh:width .
     3342                                   hh:width-chars = 2.5 .
     3343                               end.
     3344                           when "b-print" then
     3345                               do:
     3346                                   hh:load-image("cmp/b-print.bmp":u) .
     3347                                   hh:TOOLTIP = "Печать" .
     3348                                   v-h[ii] = hh:handle .
     3349                                   ii = ii + 1 .
     3350                                   hh:width-chars = 3 .
     3351                               end.
     3352                           when "b-history" or
     3353                           when "b-hist" then
     3354                               do:
     3355                                   hh:load-image("cmp/b-hist.bmp":u) .
     3356                                   hh:TOOLTIP = "История" .
     3357                                   v-h[ii] = hh:handle .
     3358                                   ii = ii + 1 .
     3359                                   hh:width-chars = 3 .
     3360                               end.
     3361                           when "b-sch" then
     3362                               do:
     3363                                   hh:load-image("cmp/b-sch.bmp":u) .
     3364                                   hh:TOOLTIP = "Установка Фильтра" .
     3365                                   v-h[ii] = hh:handle .
     3366                                   ii = ii + 1 .
     3367                                   hh:width-chars = 3 .
     3368                               end.
     3369                           when "b-hist-user" then
     3370                               do:
     3371                                   hh:load-image("cmp/b-hist.bmp":u) .
     3372                                   hh:TOOLTIP = "История пользователя" .
     3373                                   ii = ii + 1 .
     3374                               end.
     3375                       end case.
     3376                   end.
     3377                   hh = hh:next-sibling.
     3378               end.
     3379               b-help:column = v-frame-width - b-help:width-chars.
     3380               jj = 0.
     3381               repeat ii = 4 to 1 by -1 :
     3382                   if valid-handle (v-h[ii] ) then
     3383                   do:
     3384                       jj  = jj + 1 .
     3385                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3386                       v-h[ii]:row    = v-help-old-y .
     3387                   end.
     3388               end.
     3389           end.
     3390       end.
     3391   end procedure.
     3392   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
