     2685     if error-status:error then return no-apply.
     2686   END.
     2687   ON CTRL-J OF sch-full_name IN FRAME Dialog-Frame
     2688   DO:
     2689     run proc-find-full_name in this-procedure(yes, input frame Dialog-Frame sch-full_name) no-error.
     2690     if error-status:error then return no-apply.
     2691   END.
     2692   ON RETURN OF sch-full_name IN FRAME Dialog-Frame
     2693   DO:
     2694     run proc-find-full_name in this-procedure(no, input frame Dialog-Frame sch-full_name) no-error.
     2695     if error-status:error then return no-apply.
     2696   END.
     2697   ON CTRL-J OF sch-gds-code IN FRAME Dialog-Frame
     2698   DO:
     2699     run proc-find-gds-code in this-procedure(yes, input frame Dialog-Frame sch-gds-code) no-error.
     2700     if error-status:error then return no-apply.
     2701   END.
     2702   ON RETURN OF sch-gds-code IN FRAME Dialog-Frame
     2703   DO:
     2704     run proc-find-gds-code in this-procedure(no, input frame Dialog-Frame sch-gds-code) no-error.
     2705     if error-status:error then return no-apply.
     2706   END.
     2707   ON CTRL-J OF sch-id IN FRAME Dialog-Frame
     2708   DO:
     2709     run proc-find-id in this-procedure(yes, input frame Dialog-Frame sch-id) no-error.
     2710     if error-status:error then return no-apply.
     2711   END.
     2712   ON RETURN OF sch-id IN FRAME Dialog-Frame
     2713   DO:
     2714     run proc-find-id in this-procedure(no, input frame Dialog-Frame sch-id) no-error.
     2715     if error-status:error then return no-apply.
     2716   END.
     2717   ON VALUE-CHANGED OF T-batch IN FRAME Dialog-Frame
     2718   DO:
     2719   define variable GLOG as logical no-undo .
     2720     assign
     2721     t-batch.
     2722     run proc-buttons in this-procedure(t-batch).
     2723     if t-batch = no
