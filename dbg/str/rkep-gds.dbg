        1   DEFINE BUFFER find_cd-plu FOR ub.cd-plu.
        2   DEFINE BUFFER locked_cash-desk FOR ub.cash-desk.
        3   DEFINE BUFFER X_cd-doc-line FOR ub.cd-doc-line.
        4   DEFINE BUFFER X_cd-plu FOR ub.cd-plu.
        5   DEFINE BUFFER X_clients FOR ub.clients.
        6   DEFINE BUFFER X_goods FOR ub.goods.
        7   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        8   define input parameter bttns  as char   no-undo .
        9   DEFINE INPUT PARAMETER p-mode  AS CHARACTER NO-UNDO.
       10   DEFINE INPUT PARAMETER p-status  AS CHARACTER NO-UNDO.
       11   DEFINE INPUT PARAMETER p-curr-obj-type LIKE ub.clients.obj-type NO-UNDO.
       12   DEFINE INPUT PARAMETER p-curr-obj-code LIKE ub.clients.obj-code NO-UNDO.
       13   define input-output param p-rid-list    as  char no-undo .
       14   define variable vss-revision    as character no-undo init "$Revision$":U .
       15   define variable vss-author      as character no-undo init "$Author$":U .
       16   define variable vss-date        as character no-undo init "$Date$":U .
       17   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       18   define variable vss-archive     as character no-undo init "$Archive$":U .
       19   define variable vss-description as character no-undo init "Справочник блюд на кассе R-KEEPER".
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
