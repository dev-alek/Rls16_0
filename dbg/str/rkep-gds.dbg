      857   .
      858   define temp-table temp_fbrglib_found-grp no-undo
      859       field full-name   as character
      860       field sort-name   as character
      861       field node-code   as integer
      862       field level       as integer
      863       field is-terminal as logical
      864       field obj-type      as character
      865       field obj-code      as integer
      866       index pi is primary unique obj-type obj-code sort-name
      867       index fn obj-type obj-code full-name
      868       index lv obj-type obj-code level
      869       index it obj-type obj-code is-terminal
      870   .
      871   define temp-table temp_found-result-nodelist no-undo
      872       field node-code     as integer
      873       field processed     as logical
      874       field sort-name     as character
      875       field full-name     as character
      876       index pi is primary unique node-code
      877       index ps processed
      878   .
      879   procedure fbrglib-get-sort-name :
      880   do
      881   on error undo, return error
      882   :
      883   define input parameter p-obj-type   as character    no-undo.
      884   define input parameter p-obj-code   as integer      no-undo.
      885   define input parameter p-node-code  as integer      no-undo.
      886   define output parameter p-sort-name as character    no-undo.
      887       define variable v-upper-code    as integer           no-undo.
      888       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      889       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
      890       find first buf_fbr-gds-grp no-lock
      891            where buf_fbr-gds-grp.obj-type  = p-obj-type
      892              and buf_fbr-gds-grp.obj-code  = p-obj-code
      893              and buf_fbr-gds-grp.node-code = p-node-code
      894       no-error.
      895       if not available buf_fbr-gds-grp
      896       then do:
      897           undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      898       end.
      899       assign
      900           p-sort-name  = ""
      901           v-upper-code = 1
      902       .
      903       do while true
      904       on error undo, return error "fbrglib-get-sort-name: Ошибка составления полного имени группы"
      905       :
      906           assign
      907               p-sort-name  = buf_fbr-gds-grp.node-name
      908                            + (if p-sort-name <> "" then chr(2) else "")
      909                            + p-sort-name
      910               v-upper-code = buf_fbr-gds-grp.upper-code
      911           .
      912           if buf_fbr-gds-grp.upper-code = 1
      913           then do:
      914               leave.
      915           end.
      916           find first buf_fbr-gds-grp no-lock
      917                where buf_fbr-gds-grp.obj-type  = p-obj-type
      918                  and buf_fbr-gds-grp.obj-code  = p-obj-code
      919                  and buf_fbr-gds-grp.node-code = v-upper-code
      920           no-error.
      921           if not available buf_fbr-gds-grp
      922           then do:
      923               undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом "
      924                                   + string( v-upper-code )
      925                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      926           end.
      927       end.
      928   end.
      929   end procedure.
      930   procedure fbrglib-get-full-name :
      931   do
      932   on error undo, return error
      933   :
      934   define input parameter p-obj-type   as character    no-undo.
      935   define input parameter p-obj-code   as integer      no-undo.
      936   define input parameter p-node-code  as integer      no-undo.
      937   define output parameter p-full-name as character    no-undo.
      938       define variable v-upper-code    as integer           no-undo.
      939       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      940       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
      941       if p-node-code = 1
      942       then do:
      943           assign
      944               p-full-name = ""
      945           .
      946       end.
      947       else do:
      948           find first buf_fbr-gds-grp no-lock
      949                where buf_fbr-gds-grp.obj-type  = p-obj-type
      950                  and buf_fbr-gds-grp.obj-code  = p-obj-code
      951                  and buf_fbr-gds-grp.node-code = p-node-code
      952           no-error.
      953           if not available buf_fbr-gds-grp
      954           then do:
      955               undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      956           end.
      957           assign
      958               p-full-name  = ""
      959               v-upper-code = 1
      960           .
      961           do while true
      962           on error undo, return error "fbrglib-get-full-name: Ошибка составления полного имени группы"
      963           :
      964               assign
      965                   p-full-name  = buf_fbr-gds-grp.node-name
      966                               + (if p-full-name <> "" then chr(47) else "")
      967                               + p-full-name
      968                   v-upper-code = buf_fbr-gds-grp.upper-code
      969               .
      970               if buf_fbr-gds-grp.upper-code = 1
      971               then do:
      972                   leave.
      973               end.
      974               find first buf_fbr-gds-grp no-lock
      975                    where buf_fbr-gds-grp.obj-type  = p-obj-type
      976                      and buf_fbr-gds-grp.obj-code  = p-obj-code
      977                      and buf_fbr-gds-grp.node-code = v-upper-code
      978               no-error.
      979               if not available buf_fbr-gds-grp
      980               then do:
      981                   undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом "
      982                                       + string( v-upper-code )
      983                                       + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      984               end.
      985           end.
      986           assign
      987               p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      988           .
      989       end.
      990   end.
      991   end procedure.
      992   procedure fbrglib-get-root-code :
      993   do
      994   on error undo, return error
      995   :
      996   define output parameter p-root-code as integer      no-undo.
      997       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      998       find first buf_fbr-gds-grp no-lock
      999            where buf_fbr-gds-grp.upper-code = 0
     1000       no-error .
     1001       if not available buf_fbr-gds-grp
     1002       then do:
     1003           undo, return error .
     1004       end.
     1005       else do:
     1006           assign
     1007               p-root-code = buf_fbr-gds-grp.node-code
     1008           .
     1009       end.
     1010   end.
     1011   end procedure.
     1012   procedure fbrglib-find-grp-by-full-name :
     1013   do
     1014   on error undo, return error
     1015   :
     1016   define input parameter p-obj-type     as character    no-undo.
     1017   define input parameter p-obj-code     as integer      no-undo.
     1018   define input parameter p-search-name  as character    no-undo.
     1019   define input parameter p-fill-path    as logical      no-undo.
     1020       define variable v-upper-code    as integer          no-undo.
     1021       define variable v-not-found     as logical init yes no-undo.
     1022       define variable v-counter       as integer           no-undo.
     1023       define variable v-level         as integer           no-undo.
     1024       define variable v-full-name     as character         no-undo.
     1025       define variable v-sort-name     as character         no-undo.
     1026       define variable v-node-name     as character      no-undo.
     1027       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1028       assign
     1029           p-search-name = replace( p-search-name, chr(47), chr(2) )
     1030       .
     1031       run fbrglib-get-root-code ( output v-upper-code ) no-error .
     1032       if error-status :error
     1033       then do:
     1034           undo, return error "fbrglib-find-grp-by-full-name: Ошибка при поиске корневого узла".
     1035       end.
     1036       assign
     1037           v-full-name  = ""
     1038           v-level      = num-entries( p-search-name, chr(2) )
     1039       .
     1040       for each temp_fbrglib_found-grp
     1041       :
     1042           delete temp_fbrglib_found-grp.
     1043       end.
     1044       start-name-analyze:
     1045       do v-counter = 1 to v-level
     1046       :
     1047           if v-counter < v-level
     1048           then do:
     1049               assign
     1050                   v-node-name = entry( v-counter, p-search-name, chr(2) )
     1051               .
     1052               find first buf_fbr-gds-grp no-lock
     1053                    where buf_fbr-gds-grp.obj-type   = p-obj-type
     1054                      and buf_fbr-gds-grp.obj-code   = p-obj-code
     1055                      and buf_fbr-gds-grp.upper-code = v-upper-code
     1056                      and buf_fbr-gds-grp.node-name  = v-node-name
     1057               no-error .
     1058               if not available buf_fbr-gds-grp
     1059               then do:
     1060                   assign
     1061                       v-full-name  = p-search-name
     1062                       v-sort-name  = p-search-name
     1063                   .
     1064                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(47) ).
     1065               end.
     1066               else do:
     1067                   assign
     1068                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_fbr-gds-grp.node-name
     1069                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_fbr-gds-grp.node-name
     1070                       v-upper-code = buf_fbr-gds-grp.node-code
     1071                   .
     1072                   if p-fill-path = yes
     1073                   then do:
     1074                       create temp_fbrglib_found-grp.
     1075                       assign
     1076                           temp_fbrglib_found-grp.full-name = v-full-name + chr(47)
     1077                           temp_fbrglib_found-grp.sort-name = v-sort-name
     1078                           temp_fbrglib_found-grp.node-code = v-upper-code
     1079                           temp_fbrglib_found-grp.level     = v-counter
     1080                           temp_fbrglib_found-grp.obj-type  = p-obj-type
     1081                           temp_fbrglib_found-grp.obj-code  = p-obj-code
     1082                       .
     1083                   end.
     1084               end.
     1085           end.
     1086           else do:
     1087               for each buf_fbr-gds-grp no-lock
     1088                  where buf_fbr-gds-grp.obj-type   = p-obj-type
     1089                    and buf_fbr-gds-grp.obj-code   = p-obj-code
     1090                    and buf_fbr-gds-grp.upper-code = v-upper-code
     1091                    and buf_fbr-gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     1092               :
     1093                   assign
     1094                       v-not-found = no
     1095                   .
     1096                   create temp_fbrglib_found-grp.
     1097                   assign
     1098                       temp_fbrglib_found-grp.full-name = v-full-name
     1099                                                           + (if v-full-name = "" then "" else chr(47) )
     1100                                                           + buf_fbr-gds-grp.node-name + chr(47)
     1101                       temp_fbrglib_found-grp.sort-name = v-sort-name
     1102                                                           + ( if v-sort-name = "" then "" else chr(2) )
     1103                                                           + buf_fbr-gds-grp.node-name
     1104                       temp_fbrglib_found-grp.node-code = buf_fbr-gds-grp.node-code
     1105                       temp_fbrglib_found-grp.level     = v-level
     1106                       temp_fbrglib_found-grp.obj-type  = p-obj-type
     1107                       temp_fbrglib_found-grp.obj-code  = p-obj-code
     1108                   .
     1109               end.
     1110               if v-not-found = yes
     1111               then do:
     1112                   assign
     1113                       v-full-name  = p-search-name
     1114                       v-sort-name  = p-search-name
     1115                   .
     1116                   for each temp_fbrglib_found-grp
     1117                   :
     1118                       delete temp_fbrglib_found-grp.
     1119                   end.
     1120                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1121               end.
     1122           end.
     1123       end.
     1124   end.
     1125   end procedure.
     1126   procedure fbrglib-find-all-subgroup :
     1127   do
     1128   on error undo, return error
     1129   :
     1130   define input parameter p-start-obj-type     as character    no-undo.
     1131   define input parameter p-start-obj-code     as integer      no-undo.
     1132   define input parameter p-start-node-code    as integer      no-undo.
     1133   define input parameter p-terminal-only      as logical      no-undo.
     1134       define variable v-start-full-name   as character     no-undo.
     1135       define variable v-start-sort-name   as character     no-undo.
     1136       define variable v-not-found         as logical       no-undo.
     1137       define variable v-is-terminal       as logical       no-undo.
     1138       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     1139       create temp_found-result-nodelist.
     1140       assign
     1141           temp_found-result-nodelist.node-code = p-start-node-code
     1142           temp_found-result-nodelist.processed = no
     1143       .
     1144       run fbrglib-get-full-name in this-procedure (
     1145             input p-start-obj-type
     1146           , input p-start-obj-code
     1147           , input p-start-node-code
     1148           , output v-start-full-name
     1149       ).
     1150       run fbrglib-get-full-name in this-procedure (
     1151             input p-start-obj-type
     1152           , input p-start-obj-code
     1153           , input p-start-node-code
     1154           , output v-start-sort-name
     1155       ).
     1156       process-nodes:
     1157       do while yes
     1158       :
     1159           find first temp_found-result-nodelist
     1160                where temp_found-result-nodelist.node-code = p-start-node-code
     1161           .
     1162           assign
     1163               temp_found-result-nodelist.processed = yes
     1164           .
     1165           for each buf_fbr-gds-grp no-lock
     1166              where buf_fbr-gds-grp.obj-type   = p-start-obj-type
     1167                and buf_fbr-gds-grp.obj-code   = p-start-obj-code
     1168                and buf_fbr-gds-grp.upper-code = p-start-node-code
     1169           on error undo, return error
     1170           :
     1171               run fbrglib-is-terminal in this-procedure (
     1172                     input buf_fbr-gds-grp.obj-type
     1173                   , input buf_fbr-gds-grp.obj-code
     1174                   , input buf_fbr-gds-grp.node-code
     1175                   , output v-is-terminal
     1176               ).
     1177               if v-is-terminal = yes
     1178               then do:
     1179                   create temp_fbrglib_found-grp.
     1180                   assign
     1181                       temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1182                                                           chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     1183                       temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1184                                                           chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     1185                       temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
     1186                       temp_fbrglib_found-grp.is-terminal = yes
     1187                       temp_fbrglib_found-grp.obj-type  = p-start-obj-type
     1188                       temp_fbrglib_found-grp.obj-code  = p-start-obj-code
     1189                   .
     1190               end.
     1191               else do:
     1192                   create temp_found-result-nodelist.
     1193                   assign
     1194                       temp_found-result-nodelist.node-code = buf_fbr-gds-grp.node-code
     1195                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     1196                                                              chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     1197                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     1198                                                              chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     1199                       temp_found-result-nodelist.processed = no
     1200                   .
     1201                   if p-terminal-only = no
     1202                   then do:
     1203                       create temp_fbrglib_found-grp.
     1204                       assign
     1205                           temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1206                                                               chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     1207                           temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1208                                                               chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     1209                           temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
     1210                           temp_fbrglib_found-grp.is-terminal = no
     1211                           temp_fbrglib_found-grp.obj-type  = p-start-obj-type
     1212                           temp_fbrglib_found-grp.obj-code  = p-start-obj-code
     1213                       .
     1214                   end.
     1215               end.
     1216           end.
     1217           find first temp_found-result-nodelist
     1218                where temp_found-result-nodelist.processed = no
     1219           no-error.
     1220           if not available temp_found-result-nodelist
     1221           then do:
     1222               leave process-nodes.
     1223           end.
     1224           else do:
     1225               assign
     1226                   p-start-node-code = temp_found-result-nodelist.node-code
     1227                   v-start-full-name = temp_found-result-nodelist.full-name
     1228                   v-start-sort-name = temp_found-result-nodelist.sort-name
     1229               .
     1230           end.
     1231       end.
     1232   end.
     1233   end procedure.
     1234   procedure fbrglib-expand-name :
     1235   do
     1236   on error undo, return error
     1237   :
     1238   define input parameter p-obj-type   as character    no-undo.
     1239   define input parameter p-obj-code   as integer      no-undo.
     1240   define input parameter p-start-name as character    no-undo.
     1241   define output parameter p-end-name  as character    no-undo.
     1242       define variable v-is-terminal     as logical           no-undo.
     1243       define buffer buf_temp_fbrglib_found-grp     for temp_fbrglib_found-grp.
     1244       run fbrglib-find-grp-by-full-name in this-procedure (
     1245             input p-obj-type
     1246           , input p-obj-code
     1247           , input p-start-name
     1248           , input no
     1249       ) no-error.
     1250       run fbrglib-get-max-substring in this-procedure (
     1251              input p-obj-type
     1252           ,  input p-obj-code
     1253           ,  input length( p-start-name )
     1254           , output p-end-name
     1255       ) no-error .
     1256       if error-status :error
     1257       then do:
     1258           assign
     1259               p-end-name = ""
     1260           .
     1261       end.
     1262       else do:
     1263           find first temp_fbrglib_found-grp
     1264                where temp_fbrglib_found-grp.full-name = p-end-name
     1265                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
     1266                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     1267                        no-error.
     1268           if available temp_fbrglib_found-grp
     1269           then do:
     1270               find first buf_temp_fbrglib_found-grp
     1271                    where buf_temp_fbrglib_found-grp.full-name begins p-end-name
     1272                      and recid( buf_temp_fbrglib_found-grp ) <> recid( temp_fbrglib_found-grp )
     1273                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
     1274                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     1275               no-error.
     1276               if not available buf_temp_fbrglib_found-grp
     1277               then do:
     1278                   run fbrglib-is-terminal in this-procedure (
     1279                         input p-obj-type
     1280                       , input p-obj-code
     1281                       , input temp_fbrglib_found-grp.node-code
     1282                       , output v-is-terminal
     1283                   ).
     1284               end.
     1285           end.
     1286       end.
     1287   end.
     1288   end procedure.
     1289   procedure fbrglib-get-max-substring :
     1290   do
     1291   on error undo, return error
     1292   :
     1293   define input parameter p-obj-type as character no-undo .
     1294   define input parameter p-obj-code as integer no-undo .
     1295   define input parameter p-min-substring-length   as integer      no-undo.
     1296   define output parameter p-substring             as character    no-undo.
     1297           define variable v-char-counter  as integer           no-undo.
     1298           define variable v-current-char  as character         no-undo.
     1299           define variable v-names-counter  as integer           no-undo.
     1300           define variable v-base-string   as character         no-undo.
     1301           assign
     1302               v-char-counter  = p-min-substring-length
     1303           .
     1304           find first temp_fbrglib_found-grp  where
     1305                      temp_fbrglib_found-grp.obj-type  = p-obj-type
     1306                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     1307           no-error.
     1308           if not available temp_fbrglib_found-grp
     1309           then do:
     1310               undo, return error "fbrglib-get-max-substring: Нет строк для вычисления общей подстроки".
     1311           end.
     1312           else do:
     1313               assign
     1314                   v-base-string = temp_fbrglib_found-grp.full-name
     1315               .
     1316               counter-block:
     1317               do while yes
     1318               on error undo, return error "fbrglib-get-max-substring: Ошибка вычисления продолжения имени группы."
     1319               :
     1320                   assign
     1321                       v-char-counter  = v-char-counter + 1
     1322                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     1323                       v-names-counter = 0
     1324                   .
     1325                   compare-block:
     1326                   for each temp_fbrglib_found-grp
     1327                   where temp_fbrglib_found-grp.obj-type  = p-obj-type
     1328                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     1329                   :
     1330                       assign
     1331                           v-names-counter = v-names-counter + 1
     1332                       .
     1333                       if v-names-counter = 1
     1334                       then do:
     1335                           next compare-block.
     1336                       end.
     1337                       if substring( temp_fbrglib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     1338                       then do:
     1339                           leave counter-block.
     1340                       end.
     1341                   end.
     1342                   if v-names-counter = 1
     1343                   then do:
     1344                       assign
     1345                           p-substring = v-base-string
     1346                       .
     1347                       return.
     1348                   end.
     1349               end.
     1350               assign
     1351                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     1352               .
     1353           end.
     1354   end.
     1355   end procedure.
     1356   procedure fbrglib-is-terminal :
     1357   do
     1358   on error undo, return error "Ошибка процедуры fbrglib-is-terminal"
     1359   :
     1360   define input parameter p-obj-type       as character    no-undo.
     1361   define input parameter p-obj-code       as integer      no-undo.
     1362   define input parameter p-node-code      as integer      no-undo.
     1363   define output parameter p-is-terminal   as logical      no-undo.
     1364       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1365       find first buf_fbr-gds-grp no-lock
     1366            where buf_fbr-gds-grp.obj-type   = p-obj-type
     1367              and buf_fbr-gds-grp.obj-code   = p-obj-code
     1368              and buf_fbr-gds-grp.upper-code = p-node-code
     1369       no-error .
     1370       if not available buf_fbr-gds-grp
     1371       then do:
     1372           assign
     1373               p-is-terminal = yes
     1374           .
     1375       end.
     1376       else do:
     1377           assign
     1378               p-is-terminal = no
     1379           .
     1380       end.
     1381   end.
     1382   end procedure.
     1383   procedure fbrglib-have-goods :
     1384   do
     1385   on error undo, return error
     1386   :
     1387   define input parameter p-obj-type           as character    no-undo.
     1388   define input parameter p-obj-code           as integer      no-undo.
     1389   define input parameter p-node-code          as integer      no-undo.
     1390   define output parameter p-have-fbr-gds-obj  as logical      no-undo.
     1391       define buffer buf_fbr-gds-obj         for ub.fbr-gds-obj.
     1392       find first buf_fbr-gds-obj no-lock
     1393            where buf_fbr-gds-obj.obj-type     = p-obj-type
     1394              and buf_fbr-gds-obj.obj-code     = p-obj-code
     1395              and buf_fbr-gds-obj.fbr-grp-code = p-node-code
     1396       no-error .
     1397       if available buf_fbr-gds-obj
     1398       then do:
     1399           assign
     1400               p-have-fbr-gds-obj = yes
     1401           .
     1402       end.
     1403       else do:
     1404           assign
     1405               p-have-fbr-gds-obj = no
     1406           .
     1407       end.
     1408   end.
     1409   end procedure.
     1410   procedure fbrglib-find-by-substring :
     1411   do
     1412   on error undo, return error
     1413   :
     1414   define input parameter p-start-obj-type     as character    no-undo.
     1415   define input parameter p-start-obj-code     as integer      no-undo.
     1416   define input parameter p-start-code         as integer      no-undo.
     1417   define input parameter p-full-search-string as character    no-undo.
     1418   define output parameter p-found-code        as integer      no-undo.
     1419   define output parameter p-full-name         as character    no-undo.
     1420       define variable v-start-code     as integer           no-undo.
     1421       define variable v-found          as logical  init no  no-undo.
     1422       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1423       search-grp:
     1424       for each buf_fbr-gds-grp no-lock
     1425           where buf_fbr-gds-grp.obj-type  = p-start-obj-type
     1426             and buf_fbr-gds-grp.obj-code  = p-start-obj-code
     1427             and buf_fbr-gds-grp.node-code > p-start-code
     1428       :
     1429           if index( buf_fbr-gds-grp.node-name, p-full-search-string ) <> 0
     1430           then do:
     1431               assign
     1432                   p-found-code = buf_fbr-gds-grp.node-code
     1433                   v-found      = yes
     1434               .
     1435               run fbrglib-get-full-name in this-procedure (
     1436                     input p-start-obj-type
     1437                   , input p-start-obj-code
     1438                   , input p-found-code
     1439                   , output p-full-name
     1440               ) no-error .
     1441               if error-status :error
     1442               then do:
     1443                   undo, return error "fbrglib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1444               end.
     1445               leave search-grp.
     1446           end.
     1447       end.
     1448       if v-found = yes
     1449       then do:
     1450       end.
     1451       else do:
     1452           assign
     1453               p-full-name  = ""
     1454               p-found-code = 0
     1455           .
     1456       end.
     1457   end.
     1458   end procedure.
     1459   procedure fbrglib-analyze-grp-name :
     1460   do
     1461   on error undo, return error
     1462   :
     1463   define input parameter p-grp-name       as character            no-undo.
     1464   define input parameter p-obj-type       as character            no-undo.
     1465   define input parameter p-obj-code       as integer              no-undo.
     1466   define input parameter p-upper-code     as integer              no-undo.
     1467   define output parameter p-error-message as character init ""    no-undo.
     1468       define variable v-char-list     as character    no-undo.
     1469       define variable v-char-counter  as integer      no-undo.
     1470       define variable v-full-name     as character    no-undo.
     1471       if p-grp-name = "" then do:
     1472           assign
     1473               p-error-message = "Название группы не может быть пустым.".
     1474           .
     1475       end.
     1476       else do:
     1477           assign
     1478               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1479           .
     1480           do v-char-counter = 1 to num-entries( v-char-list )
     1481           :
     1482               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1483               then do:
     1484                   assign
     1485                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1486                   .
     1487                   return.
     1488               end.
     1489           end.
     1490           run fbrglib-get-full-name in this-procedure (
     1491                 input p-obj-type
     1492               , input p-obj-code
     1493               , input p-upper-code
     1494               , output v-full-name
     1495           ) no-error .
     1496           if error-status :error
     1497           then do:
     1498               undo, return error "fbrglib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1499           end.
     1500           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
     1501           then do:
     1502               assign
     1503                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
     1504               .
     1505           end.
     1506       end.
     1507   end.
     1508   end procedure.
     1509   procedure fbrglib-delete-grp :
     1510   do
     1511   on error undo, return error
     1512   :
     1513   define input parameter p-obj-type   as character    no-undo.
     1514   define input parameter p-obj-code   as integer      no-undo.
     1515   define input parameter p-node-code  as integer      no-undo.
     1516   define output parameter p-deleted   as logical      no-undo.
     1517       define variable v-have-goods    as logical        no-undo.
     1518       define variable v-yesno         as logical        no-undo.
     1519       define variable v-upper-code    as integer        no-undo.
     1520       define variable v-root-code     as integer        no-undo.
     1521       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     1522       define buffer buf_fbr-gds-obj           for ub.fbr-gds-obj.
     1523       define buffer buf_second_fbr-gds-grp    for ub.fbr-gds-grp.
     1524       run fbrglib-get-root-code in this-procedure (
     1525           output v-root-code
     1526       ) no-error.
     1527       if error-status :error
     1528       then do:
     1529           undo, return error "Не найден корневой узел." + chr(10) + return-value.
     1530       end.
     1531       if p-node-code = v-root-code
     1532       then do:
     1533           message
     1534               "Корневую группу удалить невозможно."
     1535           view-as alert-box error.
     1536           assign
     1537               p-deleted = no
     1538           .
     1539           undo, return.
     1540       end.
     1541       find first buf_fbr-gds-grp no-lock
     1542            where buf_fbr-gds-grp.obj-type     = p-obj-type
     1543              and buf_fbr-gds-grp.obj-code     = p-obj-code
     1544              and buf_fbr-gds-grp.upper-code   = p-node-code
     1545       no-error.
     1546       if available buf_fbr-gds-grp
     1547       then do:
     1548           message
     1549               "Не терминальную группу удалить невозможно."
     1550           view-as alert-box error.
     1551           assign
     1552               p-deleted = no
     1553           .
     1554           undo, return.
     1555       end.
     1556       find first buf_fbr-gds-grp no-lock
     1557            where buf_fbr-gds-grp.obj-type     = p-obj-type
     1558              and buf_fbr-gds-grp.obj-code     = p-obj-code
     1559              and buf_fbr-gds-grp.node-code    = p-node-code
     1560       .
     1561       assign
     1562           v-upper-code = buf_fbr-gds-grp.upper-code
     1563       .
     1564       run fbrglib-have-goods in this-procedure (
     1565             input p-obj-type
     1566           , input p-obj-code
     1567           , input p-node-code
     1568           , output v-have-goods
     1569       ).
     1570       if v-have-goods = yes
     1571       then do:
     1572           find first buf_second_fbr-gds-grp no-lock
     1573                where buf_second_fbr-gds-grp.obj-type      = buf_fbr-gds-grp.obj-type
     1574                  and buf_second_fbr-gds-grp.obj-code      = buf_fbr-gds-grp.obj-code
     1575                  and buf_second_fbr-gds-grp.upper-code    = buf_fbr-gds-grp.upper-code
     1576                  and recid( buf_second_fbr-gds-grp )      <> recid( buf_fbr-gds-grp )
     1577           no-error.
     1578           if available buf_second_fbr-gds-grp
     1579           then do:
     1580               message
     1581                   "В группе есть товары,"
     1582                   skip "которые нельзя перенести в родительскую группу,"
     1583                   skip "потому что у родительской группы есть еще одна подгруппа."
     1584                   skip(1)
     1585                   skip "Перенесите товары в другую группу"
     1586                   skip "или удалите все остальные подгруппы родительской группы."
     1587               view-as alert-box error.
     1588               assign
     1589                   p-deleted = no
     1590               .
     1591               undo, return.
     1592           end.
     1593           message
     1594               "В группе есть товары."
     1595               skip "После удаления группы"
     1596               skip "все ее товары будут привязаны"
     1597               skip "к ее родительской группе."
     1598               skip(1)
     1599               skip "Удалить группу?"
     1600           view-as alert-box warning
     1601           buttons yes-no
     1602           title "Удаление группы"
     1603           update v-yesno
     1604           .
     1605           if v-yesno = yes
     1606           then do:
     1607               do transaction
     1608               on error undo, return error
     1609               :
     1610                   for each buf_fbr-gds-obj exclusive-lock
     1611                      where buf_fbr-gds-obj.obj-type     = p-obj-type
     1612                        and buf_fbr-gds-obj.obj-code     = p-obj-code
     1613                        and buf_fbr-gds-obj.fbr-grp-code = p-node-code
     1614                   on error undo, return error
     1615                   :
     1616                       assign
     1617                           buf_fbr-gds-obj.fbr-grp-code = v-upper-code
     1618                       .
     1619                   end.
     1620               end.
     1621               do transaction
     1622               on error undo, return error
     1623               :
     1624                   find current buf_fbr-gds-grp exclusive-lock .
     1625                   delete buf_fbr-gds-grp no-error .
     1626                   if error-status:error then do:
     1627                     undo, return error return-value .
     1628                   end.
     1629               end.
     1630           end.
     1631       end.
     1632       else do:
     1633           message
     1634               "Имя группы: " buf_fbr-gds-grp.node-name
     1635               "Код группы: " buf_fbr-gds-grp.node-code
     1636               skip(1)
     1637               skip "Удалить группу?"
     1638           view-as alert-box warning
     1639           buttons yes-no
     1640           title "Удаление группы"
     1641           update v-yesno
     1642           .
     1643           if v-yesno = yes
     1644           then do:
     1645               do transaction
     1646               on error undo, return error
     1647               :
     1648                   find current buf_fbr-gds-grp exclusive-lock .
     1649                   delete buf_fbr-gds-grp no-error.
     1650                   if error-status:error then do:
     1651                     undo, return error return-value .
     1652                   end.
     1653               end.
     1654           end.
     1655       end.
     1656   end.
     1657   end procedure.
     1658   procedure fbrglib-add-grp :
     1659   do
     1660   on error undo, return error
     1661   :
     1662   define input parameter p-obj-type       as character    no-undo.
     1663   define input parameter p-obj-code       as integer      no-undo.
     1664   define input parameter p-node-code      as integer      no-undo.
     1665   define input parameter p-interface      as logical      no-undo.
     1666   define input parameter p-node-name      as character    no-undo.
     1667   define input parameter p-out-code       as integer      no-undo.
     1668   define input parameter p-global-code    as integer      no-undo.
     1669   define output parameter p-new-node-code as integer      no-undo.
     1670   define output parameter p-cancel        as logical      no-undo.
     1671       define variable v-have-goods    as logical  no-undo.
     1672       define variable v-host-code     as integer        no-undo.
     1673       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1674       define buffer bf_fbr-gds-grp        for ub.fbr-gds-grp.
     1675       define buffer buf_fbr-gds-obj       for ub.fbr-gds-obj.
     1676       run fbrglib-have-goods in this-procedure (
     1677             input p-obj-type
     1678           , input p-obj-code
     1679           , input p-node-code
     1680           , output v-have-goods
     1681       ) no-error .
     1682       if error-status :error
     1683       then do:
     1684           message
     1685                    vss-workfile vss-revision vss-description
     1686               skip "Ошибка определения наличия товаров в группе."
     1687               skip return-value
     1688               skip trim(error-status :get-message(1))
     1689                    trim(error-status :get-message(2))
     1690                    trim(error-status :get-message(3))
     1691           view-as alert-box error.
     1692           undo, return error .
     1693       end.
     1694   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1695   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1696     (input  p-obj-type
     1697     ,input  p-obj-code
     1698     ,output v-host-code
     1699     )  .
     1700       find first buf_fbr-gds-grp no-lock where
     1701                 buf_fbr-gds-grp.upper-code = p-node-code
     1702             AND buf_fbr-gds-grp.obj-type   = p-obj-type
     1703             AND buf_fbr-gds-grp.obj-code   = p-obj-code
     1704             AND buf_fbr-gds-grp.node-name  = p-node-name no-error .
     1705       if available buf_fbr-gds-grp then do:
     1706           if p-node-code <> 1 then do:
     1707             find first buf_fbr-gds-grp no-lock where
     1708                       buf_fbr-gds-grp.node-code = p-node-code
     1709                   AND buf_fbr-gds-grp.obj-type   = p-obj-type
     1710                   AND buf_fbr-gds-grp.obj-code   = p-obj-code  .
     1711           end.
     1712                   message
     1713           "Для объекта" p-obj-type p-obj-code
     1714           "уже есть группа блюд" p-node-name "в подгруппе" (if p-node-code = 1 then "БЛЮДА" else buf_Fbr-gds-grp.node-name)
     1715           view-as alert-box error .
     1716           undo, return error .
     1717       end.
     1718       do transaction
     1719       on error undo, return error
     1720       :
     1721           create buf_fbr-gds-grp.
     1722           assign
     1723               buf_fbr-gds-grp.node-code   = next-value( s-gds-grp, ub )
     1724               p-new-node-code             = buf_fbr-gds-grp.node-code
     1725               buf_fbr-gds-grp.upper-code  = p-node-code
     1726               buf_fbr-gds-grp.host-code   = v-host-code
     1727               buf_fbr-gds-grp.obj-type    = p-obj-type
     1728               buf_fbr-gds-grp.obj-code    = p-obj-code
     1729               buf_fbr-gds-grp.node-name    = ""
     1730               buf_fbr-gds-grp.out-code    = 0
     1731           .
     1732           if p-interface then do:
     1733             run ref/fbrggrpd.w (
     1734                   input parparentproc
     1735                 , input 'ИЗМЕНЕНИЕ':U
     1736                 , input p-obj-type
     1737                 , input p-obj-code
     1738                 , input buf_fbr-gds-grp.node-code
     1739                 , input buf_fbr-gds-grp.upper-code
     1740                 , input buf_fbr-gds-grp.node-name
     1741                 , input buf_fbr-gds-grp.out-code
     1742                 , output buf_fbr-gds-grp.node-name
     1743                 , output buf_fbr-gds-grp.out-code
     1744                 , output p-cancel
     1745             ).
     1746             if p-cancel = yes
     1747             then do:
     1748                 delete buf_fbr-gds-grp.
     1749                 undo, return.
     1750             end.
     1751           end.
     1752           else do:
     1753             find first bf_fbr-gds-grp no-lock
     1754                 where bf_fbr-gds-grp.obj-type   = p-obj-type
     1755                   and bf_fbr-gds-grp.obj-code   = p-obj-code
     1756                   and bf_fbr-gds-grp.out-code   = p-out-code
     1757             no-error.
     1758             assign
     1759             buf_fbr-gds-grp.node-name    = p-node-name
     1760             buf_fbr-gds-grp.global-code  = p-global-code
     1761             buf_fbr-gds-grp.out-code     = (if available bf_fbr-gds-grp then 0 else p-out-code)
     1762             .
     1763           end.
     1764           if v-have-goods = yes
     1765           then do:
     1766               for each buf_fbr-gds-obj exclusive-lock
     1767                  where buf_fbr-gds-obj.obj-type      = p-obj-type
     1768                    and buf_fbr-gds-obj.obj-code      = p-obj-code
     1769                    and buf_fbr-gds-obj.fbr-grp-code  = p-node-code
     1770               on error undo, return error
     1771               :
     1772                   assign
     1773                       buf_fbr-gds-obj.fbr-grp-code = p-new-node-code
     1774                   .
     1775               end.
     1776           end.
     1777       end.
     1778   end.
     1779   end procedure.
     1780   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1781   define variable varscales-pref9 as character no-undo .
     1782   define variable varpgscales-pref9 as character no-undo .
     1783   define variable varscales-pref-type9 as character no-undo.
     1784   define variable varpgscales-pref-type9 as character no-undo.
     1785   varscales-pref9  = ?.
     1786   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1787     (input  'sclspref':u
     1788     ,input  '':u
     1789     ,input  '':u
     1790     ,input  0
     1791     ,input  '':u
     1792     ,input  '':u
     1793     ,input  '':u
     1794     ,input  no
     1795     ,output varscales-pref9
     1796     ,output varscales-pref-type9
     1797     ) no-error .
     1798     if varscales-pref9 = ? then do:
     1799       assign
     1800         varscales-pref9 = '21,23,25':U.
     1801     end.
     1802   varpgscales-pref9  = ?.
     1803   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1804     (input  'scpgpref':u
     1805     ,input  '':u
     1806     ,input  '':u
     1807     ,input  0
     1808     ,input  '':u
     1809     ,input  '':u
     1810     ,input  '':u
     1811     ,input  no
     1812     ,output varpgscales-pref9
     1813     ,output varpgscales-pref-type9
     1814     ) no-error .
     1815     if varpgscales-pref9 = ? then do:
     1816       assign
     1817         varpgscales-pref9 = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
     1818     end.
     1819   function get-rkgTH-price returns decimal(input p-obj-type as character
     1820                                          , input p-obj-code as integer
     1821                                          , input p-b-code as integer
     1822                                          , output p-doc-num as character):
     1823   define variable v-price-sale as decimal   no-undo init ?.
     1824   define variable v-road-tax   as decimal   no-undo .
     1825   define variable v-excise     as decimal   no-undo .
     1826   define variable v-vat-pc     as decimal   no-undo .
     1827   define variable v-slt-pc     as decimal   no-undo .
     1828   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1829   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcprcex in g#library
     1830     (input  p-obj-type
     1831     ,input  p-obj-code
     1832     ,input  p-b-code
     1833     ,input  0
     1834     ,input  0
     1835     ,output p-doc-num
     1836     ,output v-price-sale
     1837     ,output v-road-tax
     1838     ,output v-excise
     1839     ,output v-vat-pc
     1840     ,output v-slt-pc
     1841     ) no-error .
     1842   if not error-status:error then return v-price-sale.
     1843   END FUNCTION.
     1844   function get-rkgTH-name returns character(input p-obj-type as character
     1845                                             ,input p-obj-code as integer
     1846                                             ,input p-b-code as integer
     1847                                             , buffer buf_goods for ub.goods):
     1848   define variable v-gds-name as character no-undo .
     1849   define VARIABLE varresult   as character                no-undo.
     1850   define VARIABLE vartype-bc  as character                no-undo.
     1851   define VARIABLE varweight   as decimal                  no-undo.
     1852   DEFINE VARIABLE v-unit-cli AS CHARACTER NO-UNDO.
     1853   DEFINE VARIABLE v-f-name AS CHARACTER NO-UNDO.
     1854   DEFINE BUFFER buf_bar-code FOR ub.bar-code.
     1855   DEFINE BUFFER buf_prod-bc FOR ub.prod-bc.
     1856   DEFINE BUFFER buf_place FOR ub.place.
     1857   DEFINE BUFFER buf_gds-prt FOR ub.gds-prt.
     1858   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     1859   (
     1860    input  parparentproc
     1861   ,input  STRING(p-b-code)
     1862   ,input  0
     1863   ,input  p-obj-type
     1864   ,input  p-obj-code
     1865   ,input  NO
     1866   ,input  YES
     1867   ,input  varscales-pref9
     1868   ,input  varpgscales-pref9
     1869   ,output varresult
     1870   ,output vartype-bc
     1871   ,output varweight
     1872   ,buffer buf_bar-code
     1873   ,buffer buf_prod-bc
     1874   ,buffer buf_place
     1875   ) no-error.
     1876   if not available buf_bar-code then
     1877   return "!!!НЕИЗВЕСТНЫЙ ТОВАР".
     1878   FIND FIRST buf_goods NO-LOCK WHERE
     1879             buf_goods.gds-code = buf_bar-code.gds-code NO-ERROR.
     1880   IF NOT AVAILABLE buf_goods THEN DO:
     1881     return "!!!НЕИЗВЕСТНЫЙ ТОВАР".
     1882   END.
     1883   else do:
     1884     assign
     1885     v-gds-name = buf_goods.chk-name
     1886     .
     1887   end.
     1888   IF buf_bar-code.unit-cli <> buf_goods.unit-base THEN DO:
     1889     ASSIGN
     1890     v-unit-cli = "*" + string(buf_bar-code.cli-base-rate).
     1891   END.
     1892   FIND FIRST buf_gds-prt NO-LOCK WHERE
     1893             buf_gds-prt.upper-code = buf_goods.prt-root NO-ERROR.
     1894   if buf_gds-prt.node-name <>  '_Пустая шкала':U THEN DO:
     1895       FIND FIRST buf_gds-prt NO-LOCK WHERE
     1896                 buf_gds-prt.node-code = buf_bar-code.node-code NO-ERROR.
     1897   END.
     1898   ASSIGN
     1899   v-f-name = (IF AVAILABLE buf_gds-prt THEN buf_gds-prt.f-name ELSE "":U).
     1900   ASSIGN
     1901   v-gds-name = v-gds-name + chr(32) + v-f-name + v-unit-cli.
     1902   return v-gds-name.
     1903   END FUNCTION.
     1904   function get-rkgTH-group returns integer(input p-obj-type as character
     1905                                           , input p-obj-code  as integer
     1906                                           , input p-gds-code as integer
     1907                                           , output p-grp-name as character
     1908                                           ):
     1909   DEFINE BUFFER buf_fbr-gds-obj FOR ub.fbr-gds-obj.
     1910   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
     1911   FIND FIRST buf_fbr-gds-obj NO-LOCK WHERE
     1912           buf_fbr-gds-obj.obj-type = p-obj-type
     1913       AND buf_fbr-gds-obj.obj-code = p-obj-code
     1914       AND buf_fbr-gds-obj.gds-code = p-gds-code NO-ERROR.
     1915   IF AVAILABLE buf_fbr-gds-obj THEN DO:
     1916     RUN fbrglib-get-full-name IN THIS-PROCEDURE(
     1917                                                 input p-obj-type
     1918                                                 ,INPUT p-obj-code
     1919                                                 ,INPUT buf_fbr-gds-obj.fbr-grp-code
     1920                                                 ,OUTPUT p-grp-name) NO-ERROR.
     1921     return buf_fbr-gds-obj.fbr-grp-code.
     1922   END.
     1923   return ?.
     1924   END FUNCTION.
     1925   function get-rkgTH-modificator returns logical(input p-obj-type as character
     1926                                           , input p-obj-code  as integer
     1927                                           , input p-gds-code as integer
     1928                                           , output p-is-null-price as logical
     1929                                           ):
     1930   DEFINE BUFFER buf_fbr-gds-obj FOR ub.fbr-gds-obj.
     1931   FIND FIRST buf_fbr-gds-obj NO-LOCK WHERE
     1932           buf_fbr-gds-obj.obj-type = p-obj-type
     1933       AND buf_fbr-gds-obj.obj-code = p-obj-code
     1934       AND buf_fbr-gds-obj.gds-code = p-gds-code NO-ERROR.
     1935   IF AVAILABLE buf_fbr-gds-obj THEN DO:
     1936     assign
     1937     p-is-null-price = buf_fbr-gds-obj.is-null-price
     1938     .
     1939     return buf_fbr-gds-obj.is-modificator.
     1940   END.
     1941   assign
     1942   p-is-null-price = no.
     1943   return no.
     1944   END FUNCTION.
     1945   function get-rkgTH-group-name returns character(input p-obj-type as character
     1946                                                 , input p-obj-code  as integer
     1947                                                 , input p-out-code as integer):
     1948   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
     1949   find first buf_fbr-gds-grp no-lock where
     1950             buf_fbr-gds-grp.obj-type = p-obj-type
     1951         AND buf_fbr-gds-grp.obj-code = p-obj-code
     1952         and buf_fbr-gds-grp.out-code = p-out-code no-error .
     1953   if not available buf_fbr-gds-grp then return ?.
     1954   return buf_fbr-gds-grp.node-name.
     1955   END FUNCTION.
     1956   function get-rkgTH-parent returns integer(input p-obj-type as character
     1957                                             , input p-obj-code  as integer
     1958                                             , input p-out-code as integer):
     1959   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
     1960   DEFINE BUFFER upper_fbr-gds-grp FOR ub.fbr-gds-grp.
     1961   find first buf_fbr-gds-grp no-lock where
     1962             buf_fbr-gds-grp.obj-type = p-obj-type
     1963         AND buf_fbr-gds-grp.obj-code = p-obj-code
     1964         and buf_fbr-gds-grp.out-code = p-out-code no-error .
     1965   if not available buf_fbr-gds-grp then return ?.
     1966   find first upper_fbr-gds-grp no-lock where
     1967             upper_fbr-gds-grp.obj-type = p-obj-type
     1968         AND upper_fbr-gds-grp.obj-code = p-obj-code
     1969         and upper_fbr-gds-grp.out-code = buf_fbr-gds-grp.upper-code no-error .
     1970   if not available upper_fbr-gds-grp then return ?.
     1971   return upper_fbr-gds-grp.out-code.
     1972   END FUNCTION.
     1973   procedure get-rkep-full-grp-name :
     1974   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1975   DEFINE INPUT PARAMETER p-grp-code LIKE ub.cd-grp.grp-code NO-UNDO.
     1976   define output parameter p-full-name as character    no-undo.
     1977   define variable v-upper-code    as integer  no-undo.
     1978   define buffer buf_cd-grp       for ub.cd-grp.
     1979   define buffer buf_upper_cd-grp for ub.cd-grp.
     1980   do
     1981   on error undo, return error
     1982   :
     1983       if P-grp-code = 0
     1984       then do:
     1985           assign
     1986               p-full-name = ""
     1987           .
     1988       end.
     1989       else do:
     1990           find first buf_cd-grp no-lock where
     1991                  buf_cd-grp.obj-type = 'маг':U
     1992              and buf_cd-grp.obj-code = p-obj-code
     1993              and buf_cd-grp.pos-type = 'r-keeper':U
     1994              and buf_cd-grp.grp-type = '':U
     1995              and buf_cd-grp.grp-code = p-grp-code
     1996           no-error.
     1997           if not available buf_cd-grp
     1998           then do:
     1999               undo, return error substitute("get-rkep-grp-name: Не найдена группа меню на кассе R-KEEPER с кодом &1", p-grp-code).
     2000           end.
     2001           assign
     2002               p-full-name  = ""
     2003               v-upper-code = 0
     2004           .
     2005           do while true
     2006           on error undo, return error "get-rkep-grp-name: Ошибка составления полного имени группы"
     2007           :
     2008               assign
     2009               p-full-name  = buf_cd-grp.grp-name
     2010                           + (if p-full-name <> "" then chr(47) else "")
     2011                           + p-full-name
     2012               v-upper-code = buf_cd-grp.upper-grp-code
     2013               .
     2014               if buf_cd-grp.grp-code = 0
     2015               then do:
     2016                   leave.
     2017               end.
     2018               find first buf_cd-grp no-lock where
     2019                         buf_cd-grp.obj-type = 'маг':U
     2020                     and buf_cd-grp.obj-code = p-obj-code
     2021                     and buf_cd-grp.pos-type = 'r-keeper':U
     2022                     and buf_cd-grp.grp-type = '':U
     2023                     and buf_cd-grp.grp-code = v-upper-code no-error.
     2024               if not available buf_cd-grp
     2025               then do:
     2026                   undo, return error "get-rkep-grp-name: Не найдена группа товаров с кодом "
     2027                                       + string( v-upper-code )
     2028                                       + ". Ошибка ссылки в дереве товаров для узла p-id".
     2029               end.
     2030           end.
     2031           assign
     2032               p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2033           .
     2034       end.
     2035   end.
     2036   end procedure.
     2037   function get-price-id-from-int returns character ( input p-file-num as integer):
     2038     return ('price-list':U + chr(32) +  string(p-file-num)).
     2039   end function.
     2040   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2041     define variable v-cntxt-db-num        as integer   no-undo .
     2042     define variable v-cntxt-userid        as character no-undo .
     2043     define variable v-cntxt-level         as character no-undo .
     2044     define variable v-cntxt-host-code-obj as integer   no-undo .
     2045     define variable v-cntxt-obj-type      as character no-undo .
     2046     define variable v-cntxt-obj-code      as integer   no-undo .
     2047     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2048     define variable v-cntxt-is-admin      as logical   no-undo .
     2049   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2050   FUNCTION mark-string RETURNS CHARACTER
     2051     ( input p-recid as recid, input mark-list as character  ) :
     2052     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     2053   END FUNCTION.
     2054   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2055   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     2056   procedure fltopend_fltopend :
     2057   define input parameter p-parent-handle as handle no-undo .
     2058   define input parameter p-qh as handle no-undo .
     2059   define input parameter p-flt-open-open-query  as character no-undo .
     2060   define input parameter p-where-cond as character no-undo .
     2061   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2062   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2063   define input parameter p-indexed-reposition as character no-undo .
     2064     do
     2065     on error undo, return error
     2066     :
     2067   define variable v-prepare-string as character no-undo .
     2068   define variable glog as logical no-undo .
     2069   assign
     2070   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2071                      p-where-cond + chr(32)  +
     2072                      p-use-indFIRST-query-tail + chr(32) +
     2073                      p-use-ind-sort-clmn-by + chr(32) +
     2074                      p-indexed-reposition
     2075   .
     2076   assign
     2077   glog = p-qh:query-prepare(v-prepare-string) no-error .
     2078   if not glog
     2079   or error-status:error then do:
     2080     message error-status:get-message(1) view-as alert-box .
     2081     undo, return error .
     2082   end.
     2083   assign
     2084   glog = p-qh:query-open no-error .
     2085   if not glog
     2086   or error-status:error then do:
     2087     message error-status:get-message(1) view-as alert-box .
     2088     undo, return error .
     2089   end.
     2090     end.
     2091   end procedure.
     2092   procedure fltopend_fltfindd :
     2093   define input parameter p-parent-handle as handle no-undo .
     2094   define input parameter p-qh as handle no-undo .
     2095   define input parameter p-rowid as rowid no-undo .
     2096   define input parameter p-next as logical no-undo .
     2097   define input parameter p-lock as integer no-undo .
     2098   define input parameter p-bh as handle no-undo .
     2099   define input parameter p-where-cond as character no-undo .
     2100   define input parameter p-use-index-phrase as character no-undo .
     2101   define variable glog as logical no-undo .
     2102   define variable v-qh as handle no-undo .
     2103   define variable v-bh as handle no-undo .
     2104   define variable v-recid as recid no-undo .
     2105   define variable v-prepare-string as character no-undo .
     2106   do
     2107   on error undo, return error
     2108   on stop undo, return error
     2109   :
     2110     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     2111     create buffer v-bh for table p-bh buffer-name p-bh:name.
     2112     create query v-qh.
     2113     v-qh:set-buffers(v-bh).
     2114     v-prepare-string = substitute("for each &1 &2 &3"
     2115                                     ,v-bh:name
     2116                                     ,p-where-cond
     2117                                     ,p-use-index-phrase).
     2118     glog = v-qh:query-prepare(v-prepare-string) no-error.
     2119     if not glog then do:
     2120       delete object v-qh.
     2121       delete object v-bh.
     2122       undo, return error .
     2123     end.
     2124     glog = v-qh:query-open no-error .
     2125     if not glog then do:
     2126       delete object v-qh.
     2127       delete object v-bh.
     2128       undo, return error .
     2129     end.
     2130     if p-next then do:
     2131       v-qh:reposition-to-rowid(p-rowid) no-error .
     2132       glog = v-qh:get-next( p-lock) no-error .
     2133       glog = v-qh:get-next( p-lock) no-error .
     2134       if not glog or v-qh:query-off-end = yes then do:
     2135         glog = v-qh:get-first( p-lock) no-error .
     2136       end.
     2137     end.
     2138     else do:
     2139       glog = v-qh:get-first( p-lock) no-error .
     2140     end.
     2141     v-recid = v-bh:recid no-error .
     2142     delete object v-qh.
     2143     delete object v-bh.
     2144     return string(v-recid) .
     2145   end.
     2146   end procedure.
     2147   procedure fltopend_fltfindq :
     2148   define input parameter p-parent-handle as handle no-undo .
     2149   define input parameter p-qh as handle no-undo .
     2150   define input parameter p-next as logical no-undo .
     2151   define input parameter p-lock as integer no-undo .
     2152   define input parameter p-flt-open-open-query  as character no-undo .
     2153   define input parameter p-where-cond as character no-undo .
     2154   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2155   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2156   define input parameter p-indexed-reposition as character no-undo .
     2157   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     2158   define variable glog as logical no-undo .
     2159   define variable v-qh as handle no-undo .
     2160   define variable v-bh as handle no-undo extent 18.
     2161   define variable v-rowid as rowid no-undo extent 18.
     2162   define variable v-ii as integer no-undo .
     2163   define variable v-prepare-string as character no-undo .
     2164   do
     2165   on error undo, return error
     2166   on stop undo, return error
     2167   :
     2168     create query v-qh.
     2169     do v-ii = 1 to p-qh:num-buffers:
     2170       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     2171       assign
     2172       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     2173       no-error.
     2174       v-qh:add-buffer(v-bh[v-ii]).
     2175     end.
     2176     assign
     2177     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2178                       p-where-cond + chr(32)  +
     2179                       p-use-indFIRST-query-tail + chr(32) +
     2180                       p-use-ind-sort-clmn-by + chr(32) +
     2181                       p-indexed-reposition
     2182     .
     2183     glog = v-qh:query-prepare( v-prepare-string) no-error .
     2184     if not glog then do:
     2185       delete object v-qh.
     2186       do v-ii = 1 to p-qh:num-buffers:
     2187         delete object v-bh[v-ii].
     2188       end.
     2189       undo, return error .
     2190     end.
     2191     glog = v-qh:query-open no-error .
     2192     if not glog then do:
     2193       delete object v-qh.
     2194       do v-ii = 1 to p-qh:num-buffers:
     2195         delete object v-bh[v-ii].
     2196       end.
     2197       undo, return error .
     2198     end.
     2199     if p-next then do:
     2200       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     2201       glog = v-qh:get-next( p-lock) no-error .
     2202       glog = v-qh:get-next( p-lock) no-error .
     2203       if not glog or v-qh:query-off-end = yes then do:
     2204         glog = v-qh:get-first( p-lock) no-error .
     2205       end.
     2206     end.
     2207     else do:
     2208       glog = v-qh:get-first( p-lock) no-error .
     2209     end.
     2210     do v-ii = 1 to p-qh:num-buffers:
     2211       assign
     2212       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     2213       no-error.
     2214     end.
     2215     delete object v-qh.
     2216     do v-ii = 1 to p-qh:num-buffers:
     2217       delete object v-bh[v-ii].
     2218     end.
     2219   end.
     2220   end procedure.
