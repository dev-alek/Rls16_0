      800   procedure prn-lib-reportviewer :
      801     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      802     define input parameter p-report-name-html as character no-undo .
      803     define input parameter p-param        as character no-undo .
      804     define variable v-excel           as character no-undo init 'TRUE' .
      805     define variable v-value-character as character no-undo .
      806     define variable v-value-integer   as character no-undo .
      807     define variable v-value-date      as date      no-undo .
      808     define variable v-value-decimal   as decimal   no-undo .
      809     define variable rep-excel         as logical   no-undo .
      810     define variable excel-string      as character no-undo .
      811     define variable v-param-type      as character no-undo .
      812     define variable v-tth             as handle    no-undo .
      813     run adm/shattri.p (
      814       input "get":U
      815       ,input  ""
      816       ,input  0
      817       ,input  'report-glob':U
      818       ,input  'rep-excel':U
      819       ,output v-value-character
      820       ,output v-value-date
      821       ,output v-value-decimal
      822       ,output v-value-integer
      823       ,output rep-excel
      824       ,output v-param-type
      825       ,INPUT-OUTPUT table-handle v-tth
      826       )  .
      827     if rep-excel then v-excel = "TRUE" .
      828     else v-excel = "FALSE" .
      829     if p-param eq ""
      830     then
      831        p-param = "EXCEL:" + v-excel.
      832     else
      833        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      834     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      835   end procedure.
      836   define new global shared variable g#libbcrcn as handle no-undo .
      837   define variable vss-include-info7 as character format "X(65)" no-undo
      838   initial "@(#)$Workfile$ $Revision$".
      839   define temp-table temp_fbrglib_grp no-undo
      840       field sel           as character
      841       field full-name     as character
      842       field out-code      as integer
      843       field sort-name     as character
      844       field node-code     as integer
      845       field upper-code    as integer
      846       field name          as character
      847       field level         as integer
      848       field mark          as character
      849       field obj-type      as character
      850       field obj-code      as integer
      851       field global-code   as integer
