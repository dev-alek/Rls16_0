     2762   END.
     2763   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2764   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2765   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2766   on help of frame Dialog-Frame
     2767   do:
     2768     run gbl/app_help.p
     2769       (input this-procedure :file-name
     2770       ,input ''
     2771       ,input ?
     2772       ) no-error.
     2773     if error-status :error then do:
     2774       message
     2775         "Ошибка при вызове помощи"
     2776         error-status :get-message(1)
     2777         view-as alert-box .
     2778     end.
     2779   end.
     2780   run minbtn-set in this-procedure .
     2781   on choose of b-help in frame Dialog-Frame
     2782   do:
     2783     apply "help":u to frame Dialog-Frame .
     2784   end.
     2785   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2786   procedure minbtn-set :
     2787       do
     2788           on error undo, return error return-value
     2789           :
     2790           define variable ii              as integer       no-undo .
     2791           define variable fh              as widget-handle no-undo .
     2792           define variable hh              as widget-handle no-undo .
     2793           define variable v-h             as handle        extent 4 no-undo .
     2794           define variable v-name-button   as character     no-undo .
     2795           define variable v-help-old-x    as decimal       no-undo .
     2796           define variable v-help-old-y    as decimal       no-undo .
     2797           define variable v-help-old-size as decimal       no-undo .
     2798           define variable v-frame-width   as decimal       no-undo .
     2799           define variable jj              as integer       no-undo .
     2800           do
     2801               on error undo, return error
     2802               :
     2803               assign
     2804                   v-frame-width = frame Dialog-Frame:width - 0.3
     2805                   fh            = frame Dialog-Frame:first-child
     2806                   hh            = fh:first-child
     2807                   ii            = 1
     2808                   .
     2809               do while valid-handle(hh):
     2810                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2811                   do:
     2812                       case lc(hh:name) :
     2813                           when "b-help" then
     2814                               do:
     2815                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2816                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2817                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2818                                   hh:TOOLTIP = "Помощь" .
     2819                                   v-help-old-x = hh:column .
     2820                                   v-help-old-y = hh:row    .
     2821                                   v-help-old-size = hh:width .
     2822                                   hh:width-chars = 2.5 .
     2823                               end.
     2824                           when "b-print" then
     2825                               do:
     2826                                   hh:load-image("cmp/b-print.bmp":u) .
     2827                                   hh:TOOLTIP = "Печать" .
     2828                                   v-h[ii] = hh:handle .
     2829                                   ii = ii + 1 .
     2830                                   hh:width-chars = 3 .
     2831                               end.
     2832                           when "b-history" or
     2833                           when "b-hist" then
     2834                               do:
     2835                                   hh:load-image("cmp/b-hist.bmp":u) .
     2836                                   hh:TOOLTIP = "История" .
     2837                                   v-h[ii] = hh:handle .
     2838                                   ii = ii + 1 .
     2839                                   hh:width-chars = 3 .
     2840                               end.
     2841                           when "b-sch" then
     2842                               do:
     2843                                   hh:load-image("cmp/b-sch.bmp":u) .
     2844                                   hh:TOOLTIP = "Установка Фильтра" .
     2845                                   v-h[ii] = hh:handle .
     2846                                   ii = ii + 1 .
     2847                                   hh:width-chars = 3 .
     2848                               end.
     2849                           when "b-hist-user" then
     2850                               do:
     2851                                   hh:load-image("cmp/b-hist.bmp":u) .
     2852                                   hh:TOOLTIP = "История пользователя" .
     2853                                   ii = ii + 1 .
     2854                               end.
     2855                       end case.
     2856                   end.
     2857                   hh = hh:next-sibling.
     2858               end.
     2859               b-help:column = v-frame-width - b-help:width-chars.
     2860               jj = 0.
     2861               repeat ii = 4 to 1 by -1 :
     2862                   if valid-handle (v-h[ii] ) then
     2863                   do:
     2864                       jj  = jj + 1 .
     2865                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2866                       v-h[ii]:row    = v-help-old-y .
     2867                   end.
     2868               end.
     2869           end.
     2870       end.
     2871   end procedure.
     2872   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2873   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2874   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2875   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2876   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2877   define variable v-diasize-current-frame-height as decimal   no-undo .
     2878   define variable v-diasize-change-size          as logical   no-undo .
     2879   define variable v-diasize-resize-button        as handle    no-undo .
     2880   define variable v-diasize-wndmax               as logical   no-undo .
     2881   define variable v-diasize-wndstore             as logical   no-undo .
     2882   define variable v-diasize-proc-name            as character no-undo .
     2883   define variable v-diasize-browse-handle        as handle    no-undo .
     2884   define variable v-diasize-browse-number        as integer   no-undo .
     2885   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2886   define temp-table temp-diasize-handle no-undo
     2887     field handle-value  as handle
     2888     field save-position as decimal
     2889     index xpk is primary unique handle-value
     2890     .
     2891   define temp-table temp-browse-handle no-undo
     2892     field browse-type   as character
     2893     field browse-number as integer
     2894     field browse-handle as handle
     2895     field original-size as decimal
     2896     index xpk is primary unique browse-type browse-number
     2897     index xie browse-type browse-handle
     2898   .
     2899   procedure diasize_change-height :
     2900     define input  parameter p-change-value  as decimal   no-undo .
     2901     define input  parameter p-move-resize   as logical   no-undo .
     2902     define variable v-field-group-handle    as handle    no-undo .
     2903     define variable v-object-handle         as handle    no-undo .
     2904     define variable v-frame-height          as decimal   no-undo .
     2905     define variable v-frame-virtual-height  as decimal   no-undo .
     2906     define variable v-browse-height         as decimal   no-undo .
     2907     define variable v-window-height         as decimal   no-undo .
     2908     define variable v-window-virtual-height as decimal   no-undo .
     2909     define variable v-change-sign           as integer   no-undo .
     2910     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2911     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2912     if p-change-value > 0
     2913     then do:
     2914       if frame Dialog-Frame :height + p-change-value
     2915           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2916       then do:
     2917         assign
     2918           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2919                           - (frame Dialog-Frame :height-chars)
     2920         .
     2921         if p-change-value <= 0
     2922         then do:
     2923           run diasize_position-resize-button in this-procedure .
     2924           return .
     2925         end.
     2926       end.
     2927     end.
     2928     if p-change-value < 0
     2929     then do:
     2930       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2931       then do:
     2932         assign
     2933           p-change-value = v-diasize-orig-frame-height
     2934                          - (frame Dialog-Frame :height-chars)
     2935         .
     2936         if p-change-value >= 0
     2937         then do:
     2938           run diasize_position-resize-button in this-procedure .
     2939           return .
     2940         end.
     2941       end.
     2942     end.
     2943     if p-change-value >= 0
     2944     then do:
     2945       assign
     2946         v-change-sign = 1
     2947       .
     2948     end.
     2949     else do:
     2950       assign
     2951         v-change-sign = -1
     2952       .
     2953     end.
     2954     assign
     2955       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2956     .
     2957     if p-change-value = 0
     2958     then do:
     2959       run diasize_position-resize-button in this-procedure .
     2960       return .
     2961     end.
     2962     move_block:
     2963     do
     2964     on error undo move_block, retry move_block
     2965     :
     2966       if retry
     2967       then do:
     2968         do
     2969         on error undo move_block, leave move_block
     2970         :
     2971           if p-change-value > 0
     2972           then do:
