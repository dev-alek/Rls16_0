      613   procedure fltfield-clear :
      614     define output parameter loc-fld as character no-undo.
      615     define output parameter loc-lab as character no-undo .
      616     define output parameter loc-spr as character no-undo .
      617     define output parameter loc-dim as character no-undo .
      618     assign
      619       loc-fld = ""
      620       loc-lab = ""
      621       loc-spr = ""
      622       loc-dim = "0"
      623     .
      624   end procedure .
      625   procedure fltfield-add :
      626     define input        parameter par-fld as character no-undo.
      627     define input        parameter par-lab as character no-undo .
      628     define input        parameter par-spr as character no-undo .
      629     define input-output parameter loc-fld as character no-undo.
      630     define input-output parameter loc-lab as character no-undo .
      631     define input-output parameter loc-spr as character no-undo .
      632     define input-output parameter loc-dim as character no-undo .
      633     do
      634     on error undo, return error
      635     :
      636       assign
      637       loc-fld = if loc-dim = '0'
      638                 then par-fld
      639                 else (loc-fld + chr(44) + par-fld)
      640       loc-lab = if loc-dim = '0'
      641                 then par-lab
      642                 else (loc-lab + chr(44) + par-lab)
      643       loc-spr = if loc-dim = '0'
      644                 then par-spr
      645                 else (loc-spr + chr(44) + par-spr)
      646       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      647                 string(integer(if num-entries(loc-dim) > 1
      648                               then entry(2, loc-dim)
      649                               else entry(1, loc-dim)
      650                               ) + 1)
      651       no-error
      652       .
      653     end.
      654   end procedure.
      655   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      656   define  stream PrnLibStream.
      657   procedure prn-lib-prn-file :
      658     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      659     define input parameter p-DIsabledoptions as integer no-undo .
      660     define variable v-report-name as character no-undo .
      661     define variable v-user-action as character no-undo .
      662     define variable v-printed     as logical   no-undo .
      663     define variable v-exist       as logical   no-undo .
      664     do
      665       on error undo, return error
      666       :
      667       run prn-lib-get-report-name  in this-procedure (
      668         input parParentProc
      669         ,output v-report-name
      670         ).
      671   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      672   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      673     (input  v-report-name
      674     ,input  2
      675     ,output v-exist
      676     )  .
      677       if NOT v-exist then
      678       DO:
      679         Message
      680           "Нет заданий на печать ! "
      681           view-as alert-box .
      682         Return  .
      683       End.
      684       run gbl/prnfilen.w
      685         (input  ""
      686         ,input  p-DisabledOptions
      687         ,input  string(v-report-name )
      688         ,input  7
      689         ,output v-user-action
      690         ,output v-printed
      691         ) .
      692       if v-printed then
      693       do:
      694         return "YES" .
      695       end.
      696       else
      697       do:
      698         return "NO" .
      699       end.
      700     end.
      701   end procedure.
      702   procedure prn-lib-open-stream :
      703     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      704     define input parameter p-page-size    as integer no-undo .
      705     define input parameter p-is-stream    as logical no-undo .
      706     define input parameter p-append       as logical no-undo .
      707     define variable v-report-name as character no-undo .
      708     do
      709       on error undo, return error
      710       :
      711       run prn-lib-get-report-name  in this-procedure (
      712         input parParentProc
      713         ,output v-report-name
      714         ).
      715       if p-is-stream then
      716       do:
      717         if p-append then
      718         do:
      719           output stream PrnLibStream to value( v-report-name )
      720             page-size value(p-page-size) append .
      721         end.
      722         if not p-append then
      723         do:
      724           output stream PrnLibStream to value( v-report-name )
      725             page-size value(p-page-size) .
      726         end.
      727       end.
      728       if not p-is-stream then
      729       do:
      730         if p-append then
      731         do:
      732           output to value( v-report-name )
      733             page-size value(p-page-size) append .
      734         end.
      735         if not p-append then
      736         do:
      737           output to value( v-report-name )
      738             page-size value(p-page-size) .
      739         end.
      740       end.
      741     end.
      742   end procedure.
      743   procedure prn-lib-open-exp :
      744     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      745     define input parameter p-is-stream    as logical no-undo .
      746     define input parameter p-is-append    as logical no-undo .
      747     define output parameter p-ReportFileName as char init "report" no-undo.
      748     define output parameter p-process as logical no-undo .
      749     define variable glog as logical no-undo .
      750     do
      751       on error undo, return error
      752       :
      753       SYSTEM-DIALOG GET-FILE p-ReportFileName
      754         TITLE      "Укажите путь"
      755         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      756         ASK-OVERWRITE
      757         CREATE-TEST-FILE
      758         SAVE-AS
      759         USE-FILENAME
      760         DEFAULT-EXTENSION "txt"
      761         UPDATE glog
      762         .
      763       if not glog then  return.
      764       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      765       if p-is-stream then
      766       do:
      767         if p-is-append then
      768         do:
      769           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      770         end.
      771         else
      772         do:
      773           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      774         end.
      775       end.
      776       else
      777       do:
      778         if p-is-append then
      779         do:
      780           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      781         end.
      782         else
      783         do:
      784           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      785         end.
      786       end.
      787       p-process = yes.
      788     end.
      789   end procedure.
      790   procedure prn-lib-get-report-name :
      791     define input parameter parParentProc  as widget-handle no-undo.
      792     define output parameter p-report-name as character no-undo .
      793     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      794   end procedure.
      795   procedure prn-lib-reportviewer-report-name :
      796     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      797     define input parameter p-report-name-html as character no-undo .
      798     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
