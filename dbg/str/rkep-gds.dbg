     5231     run waitfram-hide in this-procedure .
     5232       END.
     5233   END CASE.
     5234   if not p-open-query and v-doc-rec <> ? then
     5235   REPOSITION br-rkep-gds to recid v-doc-rec No-ERROR.
     5236   if not p-open-query and v-fltopend-rowid[1] <> ? then
     5237   query br-rkep-gds:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     5238   run waitfram-hide in this-procedure .
     5239   APPLY "VALUE-CHANGED" TO br-rkep-gds in frame Dialog-Frame.
     5240   APPLY "ENTRY" TO br-rkep-gds.
     5241   END PROCEDURE.
     5242   PROCEDURE proc-b-link :
     5243   DEFINE INPUT PARAMETER p-recid  AS RECID no-undo.
     5244   DEFINE INPUT PARAMETER p-b-code-recid as recid no-undo.
     5245   DEFINE VARIABLE loclog AS LOGICAL NO-UNDO.
     5246   define variable v-doc-num as character no-undo .
     5247   define variable v-grp-name as character no-undo .
     5248   define variable v-grp-code as integer no-undo .
     5249   define variable v-gds-name as character no-undo .
     5250   define variable v-price-sale as decimal no-undo .
     5251   define variable v-is-modificator as logical no-undo .
     5252   define variable v-is-null-price as logical no-undo .
     5253   define buffer buf_bar-code for ub.bar-code.
     5254   define buffer buf_goods for ub.goods.
     5255   DEFINE BUFFER buf_cd-plu FOR ub.cd-plu.
     5256   do
     5257   on error undo, return error
     5258   :
     5259     FIND FIRST buf_cd-plu EXCLUSIVE-LOCK WHERE
     5260               RECID(buf_cd-plu) = p-recid.
     5261     find first buf_bar-code no-lock where
     5262               recid(buf_bar-code) = p-b-code-recid  .
     5263     IF buf_cd-plu.b-code <> 0 THEN DO:
     5264         MESSAGE
     5265       SUBSTITUTE("Блюдо с кодом меню &1 и идентификатором &2 уже привязано к товару в IBS TH c бар-кодом &3&4" +
     5266                   "заменить привязку?"
     5267                   , buf_cd-plu.key#_one
     5268                   , buf_cd-plu.plu-code
     5269                   , buf_cd-plu.b-code
     5270                   , chr(10))
     5271         VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE loclog.
     5272         IF NOT loclog THEN RETURN ERROR.
     5273     END.
     5274     ASSIGN
     5275     buf_cd-plu.b-code = buf_bar-code.b-code
     5276     buf_cd-plu.gds-code = buf_bar-code.gds-code
     5277     buf_cd-plu.logkey_one = (v-gds-name <> buf_cd-plu.charkey_one)
     5278     buf_cd-plu.logkey_two = (v-price-sale <> X_cd-doc-line.deckey_one)
     5279     buf_cd-plu.logkey_three = ( v-grp-code <> buf_cd-plu.key#_two)
     5280     .
     5281     assign
     5282     v-price-sale = get-rkgTH-price(p-curr-obj-type, p-curr-obj-code, buf_cd-plu.gds-code, output v-doc-num)
     5283     v-gds-name   = get-rkgTH-name(p-curr-obj-type, p-curr-obj-code, buf_cd-plu.gds-code, buffer buf_goods)
     5284     v-grp-code   = get-rkgTH-group(p-curr-obj-type, p-curr-obj-code, buf_cd-plu.gds-code, output v-grp-name)
     5285     v-is-modificator = get-rkgTH-modificator(p-curr-obj-type, p-curr-obj-code, buf_cd-plu.gds-code, output v-is-null-price)
     5286     .
     5287   end.
     5288   END PROCEDURE.
     5289   PROCEDURE proc-b-print :
     5290   define variable v-doc-rec as recid no-undo .
     5291   define variable accum-count as integer.
     5292   define variable date_string     as      CHARACTER    no-undo.
     5293   define variable Line            as      CHARACTER    no-undo.
     5294   define variable for-time        as      CHARACTER    no-undo.
     5295   define variable for-time-price  as      CHARACTER    no-undo.
     5296   define variable v-group-name    as      CHARACTER    no-undo.
     5297   DEFINE variable v-loc-gds-name  as      CHARACTER    no-undo.
     5298   DEFINE variable v-loc-grp-name  as      CHARACTER    no-undo.
     5299   DEFINE variable v-loc-rkep-grp-name  as      CHARACTER    no-undo.
     5300   define variable v-loc-is-modificator as logical no-undo .
     5301   define variable v-loc-is-null-price   as logical no-undo .
     5302   DEFINE variable v-loc-price-sale-chr  as      CHARACTER    no-undo.
     5303   DEFINE variable v-loc-price-date  as    DATE         no-undo.
     5304   DEFINE variable v-loc-price-time-chr as CHARACTER    no-undo.
     5305   DEFINE variable v-loc-id               as CHARACTER    no-undo.
     5306   DEFINE FRAME cd-plu-list
     5307   X_cd-plu.key#_one COLUMN-LABEL "Код меню" FORMAT "9999":U
     5308   X_cd-plu.charkey_two COLUMN-LABEL "М" FORMAT "X(1)":U
     5309   X_cd-plu.plu-code COLUMN-LABEL "Идентиф-р" FORMAT "9999":U
     5310   X_cd-plu.charkey_one COLUMN-LABEL "Название блюда!на кассе R-KEEPER" FORMAT "X(30)":U
     5311   X_cd-doc-line.deckey_one FORMAT ">,>>>,>>9.999":U
     5312   v-group-name FORMAT "X(50)":U
     5313   X_cd-plu.b-code COLUMN-LABEL "Бар-код!в IBS TH" FORMAT "999999999":U
     5314   X_cd-plu.logkey_one COLUMN-LABEL "Н" FORMAT "+/"
     5315   X_cd-plu.logkey_two COLUMN-LABEL "Ц" FORMAT "+/"
     5316   X_cd-plu.logkey_three COLUMN-LABEL "Г" FORMAT "+/"
     5317   X_cd-plu.logkey_four COLUMN-LABEL "М" FORMAT "+/"
     5318   HEADER  date_string AT 5 format "X(35)"
     5319    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     5320   Line format "X(195)" AT 1
     5321   with width 232 down stream-io use-text    .
     5322   Line = fill("-", 195).
     5323   date_string = cur-time-print() .
     5324   run prn-lib-open-stream  in this-procedure (
     5325                                                input parParentProc
     5326                                               ,input 43
     5327                                               ,input yes
     5328                                               ,input no
     5329                                               ).
     5330   PUT  STREAM PrnLibStream
     5331   SPACE(25) ( frame Dialog-Frame:title )
     5332   format "x(90)" SKIP(1) .
     5333   FORM HEADER
     5334   Line format "X(195)" AT 1 SKIP
     5335   "Продолжение - на следующей странице" AT 30 SKIP
     5336   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5337   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5338   FORM with FRAME cd-plu-list  .
     5339   run waitfram-show in this-procedure ("Ждите...").
     5340   v-doc-rec = recid(X_cd-plu).
     5341   DO WHILE available X_cd-plu :
     5342     GET prev br-rkep-gds.
     5343   END.
     5344   GET next br-rkep-gds.
     5345   DO WHILE available X_cd-plu :
     5346   ASSIGN
     5347   v-loc-gds-name = "":U
     5348   v-loc-price-sale-chr = "":U
     5349   v-loc-grp-name = "":U
     5350   v-loc-price-date = ?
     5351   v-loc-price-time-chr = "":U
     5352   v-loc-rkep-grp-name = "":U
     5353   .
     5354   run get-rkep-full-grp-name(
     5355                               input p-curr-obj-code
     5356                              ,INPUT X_cd-plu.key#_two
     5357                              ,OUTPUT v-loc-rkep-grp-name) NO-ERROR.
     5358     Display STREAM PrnLibStream
     5359     X_cd-plu.key#_one
     5360     X_cd-plu.charkey_two
     5361     X_cd-plu.plu-code
     5362     X_cd-plu.charkey_one
     5363     X_cd-doc-line.deckey_one
     5364     v-loc-rkep-grp-name @ v-group-name
     5365     X_cd-plu.b-code
     5366     X_cd-plu.logkey_one
     5367     X_cd-plu.logkey_two
     5368     X_cd-plu.logkey_three
     5369     X_cd-plu.logkey_four
     5370     with FRAME cd-plu-list .
     5371     DOWN STREAM PrnLibStream 1
     5372     with FRAME cd-plu-list  .
     5373     IF X_cd-plu.gds-code <> 0 THEN DO:
     5374         RUN proc-value-changed IN THIS-PROCEDURE(
     5375                                          OUTPUT v-loc-gds-name
     5376                                        , OUTPUT v-loc-price-sale-chr
     5377                                        , OUTPUT v-loc-grp-name
     5378                                        , output v-loc-rkep-grp-name
     5379                                        , output v-loc-is-modificator
     5380                                        , output v-loc-is-null-price
     5381                                        , OUTPUT v-loc-price-date
     5382                                        , OUTPUT v-loc-price-time-chr) NO-ERROR.
     5383       Display STREAM PrnLibStream
     5384       v-loc-gds-name @ X_cd-plu.charkey_one
     5385       v-loc-price-sale-chr @ X_cd-doc-line.deckey_one
     5386       v-loc-grp-name @ v-group-name
     5387       with FRAME cd-plu-list .
     5388       DOWN STREAM PrnLibStream 1
     5389       with FRAME cd-plu-list  .
     5390     END.
     5391     ELSE DO:
     5392       DOWN STREAM PrnLibStream 1
     5393       with FRAME cd-plu-list .
     5394     END.
     5395     assign
     5396     accum-count = accum-count + 1
     5397     .
     5398     GET next br-rkep-gds.
     5399   END.
     5400   UNDERLINE  STREAM PrnLibStream
     5401   X_cd-plu.key#_one
     5402   X_cd-plu.charkey_two
     5403   X_cd-plu.plu-code
     5404   X_cd-plu.charkey_one
     5405   X_cd-doc-line.deckey_one
     5406   v-group-name
     5407   X_cd-plu.b-code
     5408   X_cd-plu.logkey_one
     5409   X_cd-plu.logkey_two
     5410   X_cd-plu.logkey_three
     5411   X_cd-plu.logkey_four
     5412   with FRAME cd-plu-list .
     5413   DISPLAY STREAM PrnLibStream
     5414   "ИТОГО" @ X_cd-plu.key#_one
     5415   accum-count @ X_cd-plu.plu-code
     5416   with frame cd-plu-list.
     5417   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5418   HIDE  STREAM PrnLibStream FRAME cd-plu-List.
     5419   output  STREAM PrnLibStream CLOSE.
     5420   REPOSITION br-rkep-gds to recid v-doc-rec no-error.
     5421   APPLY "entry" to br-rkep-gds.
     5422   run waitfram-hide in this-procedure .
     5423   run prn-lib-prn-file in this-procedure (
     5424                                             input parParentProc
     5425                                             ,input 8
     5426                                             ).
     5427   END PROCEDURE.
     5428   PROCEDURE proc-b-sch :
     5429   assign
     5430     tbl = 'cd-plu'
     5431     join-tbl = 'X_cd-plu'
     5432     fld = ""
     5433     lab = ""
     5434     spr = ""
     5435     dim = '0'
     5436     .
     5437   run fltfield-add in this-procedure('key#_one', 'Код меню', '',
     5438   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5439   run fltfield-add in this-procedure('charkey_one', 'Название блюда', '',
     5440   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5441   run fltfield-add in this-procedure('gds-code', 'Бар-код IBS TH', '',
     5442   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5443   run fltfield-add in this-procedure('charkey_two', 'Тип блюда', '',
     5444   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5445   run fltfield-add in this-procedure('key#_two', 'Код группы меню', '',
     5446   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5447   run fltfield-add in this-procedure('logkey_one', 'Изменилось название', '',
     5448   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5449   run fltfield-add in this-procedure('logkey_two', 'Изменилась цена', '',
     5450   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5451   run fltfield-add in this-procedure('logkey_three', 'Изменилась группа', '',
     5452   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5453   Filter-Block:
     5454   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     5455       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     5456       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     5457     run gbl/filter.w ( INPUT parparentproc
     5458                  , INPUT (filter-point + chr(4) +
     5459                           filter-label  + chr(4) +
     5460                           string(yes))
     5461                  , INPUT tbl
     5462                  , INPUT join-tbl
     5463                  , INPUT fld
     5464                  , INPUT lab
     5465                  , INPUT spr
     5466                  , INPUT dim ).
     5467     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     5468   END.
     5469   END PROCEDURE.
     5470   PROCEDURE proc-buttons :
     5471   define input parameter p-is-batch as logical no-undo.
     5472   CASE p-is-batch:
     5473       when yes then do:
     5474           ENABLE
     5475           B-mark
     5476           with frame Dialog-Frame.
     5477           disable
     5478           b-link
     5479           with frame Dialog-Frame.
     5480       end.
     5481       when no then do:
     5482           ENABLE
     5483           B-mark when lookup("b-mark":U, bttns) > 0
     5484           B-link
     5485           with frame Dialog-Frame.
     5486           DISABLE
     5487           b-mark when lookup("b-mark":U, bttns) = 0
     5488           with frame Dialog-Frame.
     5489       end.
     5490   END CASE.
     5491   END PROCEDURE.
     5492   PROCEDURE proc-find-code-chr :
     5493   define input parameter p-next as logical no-undo.
     5494   define input parameter p-code-chr as integer no-undo.
     5495   run OpenBr in this-procedure
     5496       (input false
     5497       ,input p-next
     5498       ,input substitute("and X_cd-plu.key#_one = &1 "
     5499         , p-code-chr)
     5500       ).
     5501   apply "entry":u to sch-code-chr in frame Dialog-Frame .
     5502   END PROCEDURE.
     5503   PROCEDURE proc-find-full_name :
     5504   define input parameter p-next as logical no-undo.
     5505   define input parameter p-full_name as character no-undo.
     5506   assign
     5507   p-full_name = replace(p-full_name, chr(34), "":U)
     5508   p-full_name = replace(p-full_name, chr(39), chr(39) + chr(39))
     5509   p-full_name = chr(34) + p-full_name + chr(34).
     5510   run OpenBr in this-procedure
     5511       (input false
     5512       ,input p-next
     5513       ,input substitute("and X_cd-plu.charkey_one begins &1 "
     5514         , p-full_name)
     5515       ).
     5516   apply "entry":u to sch-full_name in frame Dialog-Frame .
     5517   END PROCEDURE.
     5518   PROCEDURE proc-find-gds-code :
     5519   define input parameter p-next as logical no-undo.
     5520   define input parameter p-b-code like ub.cd-plu.b-code no-undo.
     5521   run OpenBr in this-procedure
     5522       (input false
     5523       ,input p-next
     5524       ,input substitute("and X_cd-plu.b-code = &1 "
     5525         , p-b-code)
     5526       ).
     5527   apply "entry":u to sch-gds-code in frame Dialog-Frame .
     5528   END PROCEDURE.
     5529   PROCEDURE proc-find-id :
     5530   define input parameter p-next as logical no-undo.
     5531   define input parameter p-id AS INTEGER no-undo.
     5532   run OpenBr in this-procedure
     5533       (input false
     5534       ,input p-next
     5535       ,input substitute("and X_cd-plu.plu-code = &1 "
     5536         , p-id)
     5537       ).
     5538   apply "entry":u to sch-id in frame Dialog-Frame .
     5539   END PROCEDURE.
     5540   PROCEDURE proc-rs-sch :
     5541   case input frame Dialog-Frame rs-sch :
     5542       when "code-chr" then do:
     5543         enable
     5544         sch-code-chr
     5545         with frame Dialog-Frame.
     5546         display
     5547         sch-code-chr
     5548         with frame Dialog-Frame.
     5549         hide
     5550         sch-gds-code
     5551         sch-id
     5552         sch-full_name
     5553         in frame Dialog-Frame.
     5554         apply "entry" to sch-code-chr in frame Dialog-Frame.
     5555       end.
     5556       when "id" then do:
     5557         enable
     5558         sch-id
     5559         with frame Dialog-Frame.
     5560         display
     5561         sch-id
     5562         with frame Dialog-Frame.
     5563         hide
     5564         sch-gds-code
     5565         sch-code-chr
     5566         sch-full_name
     5567         in frame Dialog-Frame.
     5568         apply "entry" to sch-id in frame Dialog-Frame.
     5569       end.
     5570       when "gds-code" then do:
     5571         enable
     5572         sch-gds-code
     5573         with frame Dialog-Frame.
     5574         display
     5575         sch-gds-code
     5576         with frame Dialog-Frame.
     5577         hide
     5578         sch-id
     5579         sch-code-chr
     5580         sch-full_name
     5581         in frame Dialog-Frame.
     5582         apply "entry" to sch-gds-code in frame Dialog-Frame.
     5583       end.
     5584       when "full_name" then do:
     5585         enable
     5586         sch-full_name
     5587         with frame Dialog-Frame.
     5588         display
     5589         sch-full_name
     5590         with frame Dialog-Frame.
     5591         hide
     5592         sch-id
     5593         sch-code-chr
     5594         sch-gds-code
     5595         in frame Dialog-Frame.
     5596         apply "entry" to sch-full_name in frame Dialog-Frame.
     5597       end.
     5598     end.
     5599   END PROCEDURE.
     5600   PROCEDURE proc-value-changed :
     5601   DEFINE OUTPUT PARAMETER p-gds-name AS CHARACTER NO-UNDO.
     5602   DEFINE OUTPUT PARAMETER p-price-sale-chr AS CHARACTER NO-UNDO.
     5603   DEFINE OUTPUT PARAMETER p-grp-name AS CHARACTER NO-UNDO.
     5604   DEFINE OUTPUT PARAMETER p-rkep-grp-name AS CHARACTER NO-UNDO.
     5605   DEFINE OUTPUT PARAMETER p-is-modificator AS logical NO-UNDO.
     5606   DEFINE OUTPUT PARAMETER p-is-null-price AS logical NO-UNDO.
     5607   DEFINE OUTPUT PARAMETER p-price-date AS date NO-UNDO.
     5608   DEFINE OUTPUT PARAMETER p-price-time-chr AS CHARACTER NO-UNDO.
     5609   define variable v-price-sale as decimal   no-undo .
     5610   define variable v-grp-code as integer no-undo .
     5611   define variable v-doc-num as character no-undo .
     5612   DEFINE BUFFER buf_price-doc FOR ub.price-doc.
     5613   IF NOT AVAILABLE X_cd-plu THEN DO:
     5614     ASSIGN
     5615     p-gds-name = "":U
     5616     p-price-sale-chr = "":U
     5617     p-is-modificator = NO
     5618     p-is-null-price = NO
     5619     p-rkep-grp-name = "":u
     5620     p-price-time-chr = "":U
     5621     .
     5622     RELEASE X_goods.
     5623     RETURN.
     5624   END.
     5625   run get-rkep-full-grp-name(
     5626                               input p-curr-obj-code
     5627                              ,INPUT X_cd-plu.key#_two
     5628                              ,OUTPUT p-rkep-grp-name) NO-ERROR.
     5629   IF X_cd-plu.b-code <> 0 THEN DO:
     5630      assign
     5631      p-gds-name = get-rkgTH-name(p-curr-obj-type, p-curr-obj-code, X_cd-plu.b-code, buffer X_goods).
     5632      assign
     5633      v-price-sale = get-rkgTH-price(p-curr-obj-type, p-curr-obj-code, X_cd-plu.b-code, output v-doc-num)
     5634      .
     5635      ASSIGN
     5636      p-price-sale-chr = if v-price-sale <> ? then STRING(v-price-sale, ">>>,>>>,>>9.99") else chr(63).
     5637      FIND FIRST buf_price-doc NO-LOCK WHERE
     5638                buf_price-doc.doc-num = v-doc-num NO-ERROR.
     5639      IF AVAILABLE buf_price-doc THEN DO:
     5640          ASSIGN
     5641          p-price-date = buf_price-doc.fact-date
     5642          p-price-time-chr = string(buf_price-doc.fact-time, "HH:MM":U)
     5643          .
     5644      END.
     5645      assign
     5646      v-grp-code = get-rkgTH-group(p-curr-obj-type, p-curr-obj-code, X_cd-plu.b-code, output p-grp-name).
     5647      p-is-modificator = get-rkgTH-modificator(p-curr-obj-type, p-curr-obj-code, X_cd-plu.b-code, output p-is-null-price).
     5648   END.
     5649   END PROCEDURE.
     5650   FUNCTION get-group-name RETURNS CHARACTER
     5651     ( BUFFER loc-cd-plu FOR ub.cd-plu ) :
     5652   define buffer buf_cd-grp for ub.cd-grp.
     5653   IF loc-cd-plu.charkey_two = "M" THEN RETURN "":U.
     5654   find first buf_cd-grp exclusive-lock where
     5655             buf_cd-grp.obj-type = loc-cd-plu.obj-type
     5656         and buf_cd-grp.obj-code = loc-cd-plu.obj-code
     5657         and buf_cd-grp.pos-type = loc-cd-plu.pos-type
     5658         and buf_cd-grp.grp-type = '':U
     5659         and buf_cd-grp.grp-code = loc-cd-plu.key#_two no-error.
     5660   RETURN (IF available buf_cd-grp
     5661                THEN buf_cd-grp.grp-name
     5662                ELSE "!!!Неизвестная группа меню").
     5663   END FUNCTION.
