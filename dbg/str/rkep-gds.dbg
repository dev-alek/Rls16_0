     5140       end.
     5141     end.
     5142     if l-filter-open-35 = false then do:
     5143       OPEN QUERY br-rkep-gds FOR EACH X_cd-plu
     5144         where  X_cd-plu.obj-type = p-curr-obj-type and X_cd-plu.obj-code = p-curr-obj-code and X_cd-plu.pos-type = 'r-keeper':U and X_cd-plu.plu-type = '':U                         and X_cd-plu.gds-code  <> 0        and (not t-name or X_cd-plu.logkey_one = yes)        and (not t-price or X_cd-plu.logkey_two = yes)        and (not t-group or X_cd-plu.logkey_three = yes)        and (not t-modificator or X_cd-plu.logkey_four = yes)
     5145       ,  LAST X_cd-doc-line OUTER-JOIN NO-LOCK WHERE X_cd-doc-line.obj-type = X_cd-plu.obj-type and X_cd-doc-line.obj-code = X_cd-plu.obj-code and X_cd-doc-line.pos-type = X_cd-plu.pos-type and X_cd-doc-line.doc-type = 'переоценка':U and X_cd-doc-line.plu-type = X_cd-plu.plu-type and X_cd-doc-line.plu-code = X_cd-plu.plu-code
     5146         indexed-reposition
     5147     .
     5148         assign
     5149           l-query-was-opened = true
     5150         .
     5151     end.
     5152   end.
     5153   else do:
     5154     assign
     5155       v-doc-rec = recid( X_cd-plu )
     5156     .
     5157     do
     5158     on stop undo, leave
     5159     on error undo, leave
     5160     :
     5161       if QUERY br-rkep-gds:handle:get-buffer-handle(1) = (buffer X_cd-plu:handle) then do:
     5162         assign
     5163         parameter-2-35 = (if p-find-next then "true":u else "false":u )
     5164         parameter-4-35 =
     5165           "where ":u +  substitute('X_cd-plu.obj-type = &1&2&1 and X_cd-plu.obj-code = &3 and X_cd-plu.pos-type = &1&4&1 and X_cd-plu.plu-type = &1&1                         and X_cd-plu.gds-code  <> 0        and (not &5 or X_cd-plu.logkey_one = yes)        and (not &6 or X_cd-plu.logkey_two = yes)        and (not &7 or X_cd-plu.logkey_three = yes)        and (not &8 or X_cd-plu.logkey_four = yes) ', chr(34), p-curr-obj-type, p-curr-obj-code, 'r-keeper':U, t-name, t-price, t-group, t-modificator)  + " ":u + where-phrase-35 + " ":u + p-find-condition + " " + ""
     5166         parameter-5-35 = "  "
     5167       .
     5168         run fltopend_fltfindd in this-procedure  (
     5169                             input this-procedure:handle
     5170                             ,input QUERY br-rkep-gds:handle
     5171                             ,input rowid(X_cd-plu)
     5172                             ,input logical(parameter-2-35)
     5173                             ,input no-lock
     5174                             ,input (buffer X_cd-plu:handle)
     5175                             ,input parameter-4-35
     5176                             ,input parameter-5-35
     5177                             ) no-error.
     5178         .
     5179         assign
     5180           v-doc-rec = integer(return-value)
     5181           v-fltopend-rowid[1] = ?
     5182         .
     5183       end.
     5184       else do:
     5185         assign
     5186         parameter-2-35 = (if p-find-next then "true":u else "false":u )
     5187         parameter-3-35 =  "FOR EACH X_cd-plu"
     5188         parameter-4-35 =
     5189           (
     5190             if (" X_cd-plu.obj-type = p-curr-obj-type and X_cd-plu.obj-code = p-curr-obj-code and X_cd-plu.pos-type = 'r-keeper':U and X_cd-plu.plu-type = '':U                         and X_cd-plu.gds-code  <> 0        and (not t-name or X_cd-plu.logkey_one = yes)        and (not t-price or X_cd-plu.logkey_two = yes)        and (not t-group or X_cd-plu.logkey_three = yes)        and (not t-modificator or X_cd-plu.logkey_four = yes)               " + " " + where-phrase-35) <> ""
     5191             then  substitute('X_cd-plu.obj-type = &1&2&1 and X_cd-plu.obj-code = &3 and X_cd-plu.pos-type = &1&4&1 and X_cd-plu.plu-type = &1&1                         and X_cd-plu.gds-code  <> 0        and (not &5 or X_cd-plu.logkey_one = yes)        and (not &6 or X_cd-plu.logkey_two = yes)        and (not &7 or X_cd-plu.logkey_three = yes)        and (not &8 or X_cd-plu.logkey_four = yes) ', chr(34), p-curr-obj-type, p-curr-obj-code, 'r-keeper':U, t-name, t-price, t-group, t-modificator)  + " " + where-phrase-35
     5192             else "true"
     5193           )
     5194         parameter-5-35 = (" " + "" + " " + substitute(',  LAST X_cd-doc-line OUTER-JOIN NO-LOCK WHERE X_cd-doc-line.obj-type = X_cd-plu.obj-type and X_cd-doc-line.obj-code = X_cd-plu.obj-code and X_cd-doc-line.pos-type = X_cd-plu.pos-type and X_cd-doc-line.doc-type = &1&2&1 and X_cd-doc-line.plu-type = X_cd-plu.plu-type and X_cd-doc-line.plu-code = X_cd-plu.plu-code', chr(34), 'переоценка':U) + " " + p-find-condition)
     5195         parameter-6-35 = if sort-phrase-35 = ''
     5196                              then
