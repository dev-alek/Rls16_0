     5069         (INPUT filter-name-35
     5070         ) no-error .
     5071     assign
     5072       l-filter-open-35 = false
     5073     .
     5074     if flt-rec-35 <> ?
     5075       or sort-column-phrase > ""
     5076     then do:
     5077       define variable  parameter-2-35 as character no-undo .
     5078       define variable  parameter-3-35 as character no-undo .
     5079       define variable  parameter-4-35 as character no-undo .
     5080       define variable  parameter-5-35 as character no-undo .
     5081       define variable  parameter-6-35 as character no-undo .
     5082       define variable  parameter-7-35 as character no-undo .
     5083         assign
     5084         parameter-3-35 =
     5085                                 "FOR EACH X_cd-plu"
     5086         parameter-4-35 =
     5087           (
     5088             if (" X_cd-plu.obj-type = p-curr-obj-type and X_cd-plu.obj-code = p-curr-obj-code and X_cd-plu.pos-type = 'r-keeper':U and X_cd-plu.plu-type = '':U                         and X_cd-plu.gds-code  <> 0        and (not t-name or X_cd-plu.logkey_one = yes)        and (not t-price or X_cd-plu.logkey_two = yes)        and (not t-group or X_cd-plu.logkey_three = yes)        and (not t-modificator or X_cd-plu.logkey_four = yes)               " + " " + where-phrase-35) <> ""
     5089             then  substitute('X_cd-plu.obj-type = &1&2&1 and X_cd-plu.obj-code = &3 and X_cd-plu.pos-type = &1&4&1 and X_cd-plu.plu-type = &1&1                         and X_cd-plu.gds-code  <> 0        and (not &5 or X_cd-plu.logkey_one = yes)        and (not &6 or X_cd-plu.logkey_two = yes)        and (not &7 or X_cd-plu.logkey_three = yes)        and (not &8 or X_cd-plu.logkey_four = yes) ', chr(34), p-curr-obj-type, p-curr-obj-code, 'r-keeper':U, t-name, t-price, t-group, t-modificator)  + " " + where-phrase-35
     5090             else "true"
     5091           )
     5092         parameter-5-35 = (" " + "" + " " + substitute(',  LAST X_cd-doc-line OUTER-JOIN NO-LOCK WHERE X_cd-doc-line.obj-type = X_cd-plu.obj-type and X_cd-doc-line.obj-code = X_cd-plu.obj-code and X_cd-doc-line.pos-type = X_cd-plu.pos-type and X_cd-doc-line.doc-type = &1&2&1 and X_cd-doc-line.plu-type = X_cd-plu.plu-type and X_cd-doc-line.plu-code = X_cd-plu.plu-code', chr(34), 'переоценка':U))
     5093         parameter-6-35 = if sort-phrase-35 = ''
