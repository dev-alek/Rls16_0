      369   on alt-shift-f4 anywhere do:
      370     run proc-alt-shift-f4 in this-procedure.
      371   end.
      372   on alt-f1 anywhere do:
      373     run proc-alt-f1 in this-procedure .
      374   end.
      375   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376   define variable c-point  as character no-undo .
      377   define variable tbl      as character no-undo .
      378   define variable join-tbl as character no-undo .
      379   define variable fld      as character no-undo .
      380   define variable lab      as character no-undo .
      381   define variable spr      as character no-undo .
      382   define variable dim      as character no-undo .
      383   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      384   procedure cur-time :
      385      define output parameter p-today as date      no-undo .
      386      define output parameter p-time  as integer   no-undo .
      387     do
      388     on error undo, return error
      389     :
      390       define variable v-date1 as date      no-undo .
      391       define variable v-date2 as date      no-undo .
      392       define variable v-time  as integer   no-undo .
      393       assign
      394         v-date1 = today
      395         v-time  = time
      396         v-date2 = today
      397       .
      398       if v-date1 <> v-date2
      399       then do:
      400         assign
      401           v-date1 = today
      402           v-time  = v-time
      403         .
      404       end.
      405       assign
      406         p-today = v-date1
      407         p-time  = v-time
      408       .
      409     end.
      410   end.
      411   function cur-time-date returns character
      412   :
      413     return string(today, '99/99/9999':U) .
      414   end.
      415   function cur-time-mjd returns decimal
      416   :
      417     define variable v-date as date      no-undo .
      418     define variable v-time as integer   no-undo .
      419     run cur-time in this-procedure
      420       (output v-date
      421       ,output v-time
      422       ) .
      423     return integer(v-date) - 2400002 + (v-time / 86400) .
      424   end.
      425   function cur-time-get-ending-index returns integer
      426   (input p-number as integer
      427   )
      428   :
      429     if p-number < 0
      430     or p-number = ?
      431     then do:
      432       return 1 .
      433     end.
      434     define variable v-rest as integer   no-undo .
      435     assign
      436       p-number = p-number modulo 100
      437     .
      438     if p-number < 20
      439     then do:
      440       assign
      441         v-rest = p-number
      442       .
      443     end.
      444     else do:
      445       assign
      446         v-rest = p-number modulo 10
      447       .
      448     end.
      449     case v-rest :
      450       when 1
      451       then do:
      452         return 2 .
      453       end.
      454       when 2 or
      455       when 3 or
      456       when 4
      457       then do:
      458         return 3 .
      459       end.
      460       otherwise do:
      461         return 1 .
      462       end.
      463     end case .
      464   end.
      465   procedure cur-time-mjd-to-date :
      466      define input  parameter i-mjd-diff as decimal no-undo.
      467      define output parameter o-Date     as date    no-undo.
      468      define output parameter o-Time     as integer no-undo.
      469      define variable v-day-number as integer   no-undo .
      470      if    i-mjd-diff < 0
      471         or i-mjd-diff = ?
      472      then do:
      473         return "?" .
      474      end.
      475      assign
      476         v-day-number = truncate(i-mjd-diff,0).
      477         o-Date = date(v-day-number + 2400002).
      478         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      479     .
      480   end.
      481   function cur-time-mjd-to-string returns character
      482   (input p-mjd-diff as decimal
      483   )
      484   :
      485     define variable v-day-number as integer   no-undo .
      486     define variable v-seconds    as integer   no-undo .
      487     define variable v-hour       as integer   no-undo .
      488     define variable v-min        as integer   no-undo .
      489     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      490     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      491     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      492     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      493     if p-mjd-diff < 0
      494     or p-mjd-diff = ?
      495     then do:
      496       return "?" .
      497     end.
      498     assign
      499       v-day-number = integer(truncate(p-mjd-diff,0))
      500       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      501     .
      502     if v-seconds > 86400
      503     then do:
      504       assign
      505         v-seconds = 86400 - 1
      506       .
      507     end.
      508     if v-seconds < 0
      509     then do:
      510       assign
      511         v-seconds = 0
      512       .
      513     end.
      514     assign
      515       v-hour = truncate(v-seconds / 3600, 0)
      516     .
      517     assign
      518       v-seconds = v-seconds modulo 3600
      519     .
      520     assign
      521       v-min = truncate(v-seconds / 60, 0)
      522     .
      523     assign
      524       v-seconds = v-seconds modulo 60
      525     .
      526     return
      527         (if v-day-number <> 0
      528           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      529           else ""
      530         )
      531       + (if v-day-number <> 0 or v-hour <> 0
      532           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      533           else ""
      534         )
      535       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      536           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      537           else ""
      538         )
      539       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      540       .
      541   end.
      542   function cur-time-string returns character
      543   :
      544     define variable v-date as date      no-undo .
      545     define variable v-time as integer   no-undo .
      546     run cur-time in this-procedure
      547       (output v-date
      548       ,output v-time
      549       ) .
      550     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      551   end.
      552   function cur-time-string-sec returns character
      553   :
      554     define variable v-date as date      no-undo .
      555     define variable v-time as integer   no-undo .
      556     run cur-time in this-procedure
      557       (output v-date
      558       ,output v-time
      559       ) .
      560     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      561   end.
      562   function cur-time-custom  returns character
      563   (input p-prefix as character
      564   ,input p-date-format as character
      565   ,input p-delimiter as character
      566   ,input p-time-format as character
      567   ,input p-suffix as character
      568   )
      569   :
      570     define variable v-date as date      no-undo .
      571     define variable v-time as integer   no-undo .
      572     run cur-time in this-procedure
      573       (output v-date
      574       ,output v-time
      575       ) .
      576     return
      577       p-prefix
      578       + string(v-date, p-date-format)
      579       + p-delimiter
      580       + string(v-time, p-time-format)
      581       + p-suffix
      582       .
      583   end.
      584   function cur-time-print  returns character
      585   :
      586     define variable v-date as date      no-undo .
      587     define variable v-time as integer   no-undo .
      588     run cur-time in this-procedure
      589       (output v-date
      590       ,output v-time
      591       ) .
      592     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      593   end.
      594   function cur-time-datetime returns datetime
      595   :
      596     define variable v-char as character no-undo .
      597     define variable v-datetime as datetime no-undo .
      598     v-char = cur-time-string().
      599     v-datetime = datetime(v-char).
      600     return  v-datetime.
      601   end.
      602   function cur-time-string-msec returns character
      603   :
      604     define variable v-date as datetime  no-undo .
      605     v-date = now.
      606     return string(v-date) .
      607   end.
