     5210       .
     5211         run fltopend_fltfindq in this-procedure  (
     5212                             input this-procedure:handle
     5213                             ,input QUERY br-rkep-gds:handle
     5214                             ,input logical(parameter-2-35)
     5215                             ,input no-lock
