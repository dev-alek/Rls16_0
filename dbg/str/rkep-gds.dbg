     2470                 ,?
     2471                 ,?
     2472                 ,?
     2473                 ,?
     2474                 ,?
     2475                 ,?
     2476                 ,p-curr-obj-type
     2477                 ,p-curr-obj-code
     2478                 ,?
     2479                , output varrid-list ).
     2480   if varrid-list = "" then undo, return no-apply.
     2481   find first buf_goods no-lock where
     2482             recid(buf_goods) = integer(varrid-list) no-error.
     2483   if error-status:error then do:
     2484     return no-apply.
     2485   end.
     2486   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2487     (input  buf_goods.gds-code
     2488     ,input  ?
     2489     ,output main-code
     2490     ) no-error .
     2491   if error-status:error then return no-apply.
     2492   run ref/alt-cds.w (input parparentproc
     2493                 ,input p-curr-obj-type
     2494                 ,input p-curr-obj-code
     2495                 ,input "all-no-part"
     2496                 ,buf_goods.gds-code
     2497                 ,main-code
     2498                 ,output varrid-list).
     2499   if varrid-list = "" then undo, return no-apply.
     2500   run proc-b-link in this-procedure (INPUT recid(X_cd-plu), input varrid-list) no-error.
     2501   if error-status:error then return no-apply.
     2502   RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     2503   reposition br-rkep-gds to recid loc-doc-rec no-error.
     2504   if error-status:error then do:                           find first pos_cd-plu no-lock where                                   recid(pos_cd-plu) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи БЛЮДА" skip                            string(if avail pos_cd-plu                                     then  substitute("Идентификатор: &1, код меню &2"                                                     , pos_cd-plu.plu-code                                                      , pos_cd-plu.key#_one)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     2505   apply "entry" to br-rkep-gds in frame Dialog-Frame.
     2506   apply "value-changed" to br-rkep-gds in frame Dialog-Frame.
     2507   END.
     2508   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     2509   DO:
     2510   define variable loc#log as logical no-undo .
     2511     if available X_cd-plu then do:
     2512   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2513   define variable v-str-recid18 as character no-undo .
     2514   define variable v-num-entry18 as integer   no-undo .
     2515   assign
     2516     v-str-recid18 = trim( string( recid( X_cd-plu ) , "->>>>>>>>>>>9":U ) )
     2517     v-num-entry18 = lookup( v-str-recid18 , v-rid-list )
     2518   .
     2519   if v-num-entry18 > 0 then do:
     2520     assign
     2521       entry( v-num-entry18, v-rid-list ) = "":U
     2522       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2523     .
     2524   end.
     2525   else do:
     2526     assign
     2527       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid18
     2528     .
     2529   end.
     2530       loc#log = br-rkep-gds:refresh() .
     2531       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     2532           loc#log = br-rkep-gds:select-next-row ().
     2533           apply "VALUE-CHANGED" to br-rkep-gds in frame Dialog-Frame.
     2534       end.
     2535       if num-entries( v-rid-list ) = 0
     2536       then
     2537           hide mark-num in frame Dialog-Frame.
     2538       else
     2539           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     2540     end.
     2541     apply "entry" to br-rkep-gds in frame Dialog-Frame.
     2542   END.
     2543   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     2544   DO:
     2545     if not avail X_cd-plu then return no-apply.
