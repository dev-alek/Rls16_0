     2563   END.
     2564   ON CHOOSE OF B-update IN FRAME Dialog-Frame
     2565   DO:
     2566     assign
     2567     t-name
     2568     t-price
     2569     t-group
     2570     t-modificator
     2571     .
     2572     if not t-name
     2573     and not t-price
     2574     and not t-group
     2575     and not t-modificator
     2576     then do:
     2577       message
     2578       "Не выбрана ни одна опция для синхронизации" skip
     2579       "(название, цена, группа на кассе, модификатор и 0-цена)"
     2580       view-as alert-box error .
     2581       return no-apply.
     2582     end.
     2583   run str/diallog.w (
     2584                 input parparentproc
     2585               , input THIS-PROCEDURE
     2586               , input 'str/rkepsyn1.p':U
     2587               , input (p-curr-obj-type + chr(4) +
     2588                 string(p-curr-obj-code) + chr(4) +
     2589                 (if t-batch
     2590                 then v-rid-list
     2591                 else string(recid(X_cd-plu)))
     2592                  ) + chr(4) +
     2593                 ((if t-name then "name":U else "":U) + chr(44) +
     2594                 (if t-price then "price":U else "":U) + chr(44) +
     2595                 (if t-group then "group":U else "":U) + chr(44) +
     2596                 (if t-modificator then "modificator":U else "":U))
     2597               , input no
     2598               , input 'Прервать'
     2599               , input 'Синхронизация данных по блюдам/товарам на кассе R-KEEPER и соответствующим товаров IBS TH')
     2600                .
     2601     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     2602     HIDE mark-num in frame Dialog-Frame .
     2603     if v-rid-list <> "":U then
     2604     REPOSITION br-rkep-gds to recid integer(entry(1, v-rid-list)) No-ERROR.
     2605     APPLY "VALUE-CHANGED" to br-rkep-gds.
     2606   END.
     2607   ON VALUE-CHANGED OF BR-rkep-gds IN FRAME Dialog-Frame
     2608   DO:
     2609     RUN proc-value-changed IN THIS-PROCEDURE (OUTPUT v-gds-name
     2610                                             , OUTPUT v-price-sale-chr
     2611                                             , OUTPUT v-grp-name
     2612                                             , output v-rkep-grp-name
     2613                                             , output v-is-modificator
     2614                                             , output v-is-null-price
     2615                                             , OUTPUT v-price-date
     2616                                             , OUTPUT v-price-time-chr
     2617                                             ).
     2618    DISPLAY
     2619    v-gds-name
     2620    v-price-sale-chr
     2621    v-is-modificator
     2622    v-is-null-price
     2623    v-grp-name
     2624    v-rkep-grp-name
     2625    v-price-date
     2626    v-price-time-chr
     2627    WITH FRAME Dialog-Frame.
     2628   END.
     2629   ON VALUE-CHANGED OF rs-mode IN FRAME Dialog-Frame
     2630   DO:
     2631     ASSIGN
     2632     rs-mode
     2633     v-mode = rs-mode
     2634     .
     2635     CASE rs-mode:
     2636         WHEN "+":U THEN DO:
     2637             ENABLE
     2638             b-update
     2639             T-group
     2640             T-name
     2641             T-price
     2642             t-modificator
     2643             T-batch
     2644             WITH FRAME Dialog-Frame.
     2645         END.
     2646         OTHERWISE do:
     2647             ASSIGN
     2648             t-group = NO
     2649             t-name = NO
     2650             t-price = NO
     2651             t-batch = NO    .
     2652             DISPLAY
     2653             t-group
     2654             t-modificator
     2655             t-name
     2656             t-price
     2657             t-batch
     2658             WITH FRAME Dialog-Frame.
     2659             DISABLE
     2660             T-group
     2661             t-modificator
     2662             T-name
     2663             T-price
     2664             t-batch
     2665             b-update
     2666             WITH FRAME Dialog-Frame.
     2667       END.
     2668     END CASE.
     2669     RUN openbr IN THIS-PROCEDURE ( input YES, input NO, input '':U) NO-ERROR.
     2670     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     2671   END.
     2672   ON VALUE-CHANGED OF RS-sch IN FRAME Dialog-Frame
     2673   DO:
     2674     RUN proc-rs-sch IN THIS-PROCEDURE NO-ERROR.
     2675     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     2676   END.
