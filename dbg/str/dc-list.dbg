     3985         MENU-ITEM m-macro-file    LABEL "Сохраненный в файле макрос формирования списка карт"
     3986         MENU-ITEM m-macro-lob     LABEL "Сохраненный в БД макрос формирования списка карт"
     3987         .
     3988   DEFINE BUTTON B-add
     3989        LABEL "&+Доб. строку"
     3990        SIZE 20 BY 1 TOOLTIP "Добавление в список карт 1 строку".
     3991   DEFINE BUTTON B-clear-macro
     3992        IMAGE-UP FILE "cmp/fstop.bmp":U
     3993        IMAGE-DOWN FILE "cmp/fstopi.bmp":U
     3994        IMAGE-INSENSITIVE FILE "cmp/fstopi.bmp":U
     3995        LABEL "&[ ]"
     3996        SIZE 4 BY 1.25 TOOLTIP "Удаление макроса формирования истории из памяти".
     3997   DEFINE BUTTON B-clr
     3998        LABEL "Очи&стить"
     3999        SIZE 10 BY 1 TOOLTIP "Удалить из списка все карты (строки)".
     4000   DEFINE BUTTON B-del
     4001        LABEL "&-Удал. строку"
     4002        SIZE 20 BY 1 TOOLTIP "Удаление из списка карт текущую строку".
     4003   DEFINE BUTTON B-exit AUTO-GO
     4004        LABEL "&Выход"
     4005        SIZE 10 BY 1 TOOLTIP "Выход из списка карт (передача списка другой программе)"
     4006        BGCOLOR 8 .
     4007   DEFINE BUTTON B-Help
     4008        LABEL "Помо&щь"
     4009        SIZE 10 BY 1
     4010        BGCOLOR 8 .
     4011   DEFINE BUTTON B-hist
     4012        LABEL "Ис&тория"
     4013        SIZE 10 BY 1 TOOLTIP "Последовательность шагов, приведшая к заполнению данного списка".
     4014   DEFINE BUTTON B-lkp
     4015        LABEL "&Просмотр"
     4016        SIZE 10 BY 1 TOOLTIP "Просмотр описания текущей карты".
     4017   DEFINE BUTTON B-macro
     4018        IMAGE-UP FILE "cmp/run.bmp":U
     4019        IMAGE-DOWN FILE "cmp/runi.bmp":U
     4020        IMAGE-INSENSITIVE FILE "cmp/runi.bmp":U
     4021        LABEL "&>"
     4022        SIZE 4 BY 1.25 TOOLTIP "Выполнение макроса формирования истории".
     4023   DEFINE BUTTON B-print
     4024        LABEL "Пе&чать"
     4025        SIZE 10 BY 1.
     4026   DEFINE BUTTON B-record
