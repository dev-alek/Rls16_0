     2074   FUNCTION get-d-pcnt RETURNS CHARACTER
     2075     ( buffer loc-dis-card for dc-list,
     2076       input parhost-code as integer,
     2077       input parobj-type as character,
     2078       input parobj-code as integer,
     2079       input p-discnt-role as character,
     2080       output loc-d-v as decimal) :
     2081   define variable v-node-code as integer no-undo .
     2082   define buffer buf_dis-card-type for ub.dis-card-type.
     2083   define buffer buf_dis-card-property for ub.dis-card-property.
     2084   find first buf_dis-card-type no-lock where
     2085             buf_dis-card-type.type = loc-dis-card.type
     2086         and buf_dis-card-type.emitent-host-code = loc-dis-card.emitent-host-code
     2087         and buf_dis-card-type.host-code = 0
     2088         and buf_dis-card-type.obj-type = '':U
     2089         and buf_dis-card-type.obj-code = 0 no-error.
     2090   if available buf_dis-card-type then do:
     2091     case p-discnt-role:
     2092       when 'def-pcnt':U  then do:
     2093         assign
     2094         v-node-code = 1.
     2095       end.
     2096       when 'def-cash-pcnt':U then do:
     2097         assign
     2098         v-node-code = 2.
     2099       end.
     2100       when 'def-categ':U then do:
     2101         assign
     2102         v-node-code = 3.
     2103       end.
     2104     end.
     2105     if buf_dis-card-type.d-pcnt-byshop then do:
     2106      find first buf_dis-card-property no-lock where
     2107                buf_dis-card-property.d-card = loc-dis-card.d-card
     2108            and buf_dis-card-property.dtm-code = 26
     2109            and buf_dis-card-property.host-code = parhost-code
     2110            and buf_dis-card-property.obj-type = parobj-type
     2111            and buf_dis-card-property.obj-code = parobj-code
     2112            and buf_dis-card-property.node-code = v-node-code no-error.
     2113      if available buf_dis-card-property then do:
     2114        if p-discnt-role = 'def-categ':U then do:
     2115          assign
     2116          loc-d-v = buf_dis-card-property.property-value-integer.
     2117        end.
     2118        else do:
     2119          assign
     2120          loc-d-v = buf_dis-card-property.property-value-decimal.
     2121        end.
     2122      end.
     2123       if loc-d-v = ? then do:
     2124   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2125   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     2126     (
     2127      input  loc-dis-card.type
     2128     ,input  loC-dis-card.emitent-host-code
     2129     ,input  parhost-code
     2130     ,input  parobj-type
     2131     ,input  parobj-code
     2132     ,input  p-discnt-role
     2133     ,output loc-d-v
     2134     ) no-error .
     2135       end.
     2136       if loc-d-v = ? then do:
     2137         find first buf_dis-card-property no-lock where
     2138                   buf_dis-card-property.d-card = loc-dis-card.d-card
     2139               and buf_dis-card-property.dtm-code = 26
     2140               and buf_dis-card-property.host-code = parhost-code
     2141               and buf_dis-card-property.obj-type = ''
     2142               and buf_dis-card-property.obj-code = 0
     2143               and buf_dis-card-property.node-code = v-node-code no-error.
     2144         if available buf_dis-card-property then do:
     2145           if p-discnt-role = 'def-categ':U then do:
     2146             assign
     2147             loc-d-v = buf_dis-card-property.property-value-integer.
     2148           end.
     2149           else do:
     2150             assign
     2151             loc-d-v = buf_dis-card-property.property-value-decimal.
     2152           end.
     2153         end.
     2154       end.
     2155       if loc-d-v = ? then do:
     2156   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2157   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     2158     (
     2159      input  loc-dis-card.type
     2160     ,input  loC-dis-card.emitent-host-code
     2161     ,input  parhost-code
     2162     ,input  ''
     2163     ,input  0
     2164     ,input  p-discnt-role
     2165     ,output loc-d-v
     2166     ) no-error .
     2167       end.
     2168       if loc-d-v = ? then do:
     2169         case p-discnt-role:
     2170           when 'def-categ':U then do:
     2171             loc-d-v = loc-dis-card.category.
     2172           end.
     2173           when 'def-pcnt':U then do:
     2174             loc-d-v = loc-dis-card.d-pcnt.
     2175           end.
     2176           when 'def-cash-pcnt':U then do:
     2177             loc-d-v = loc-dis-card.cash-d-pcnt.
     2178           end.
     2179         end case.
     2180       end.
     2181       if p-discnt-role = 'def-categ':U then do:
     2182         return substitute("(i) &1", string(loc-d-v, ">>>9")).
     2183       end.
     2184       else do:
     2185         return substitute("(i) &1", string(loc-d-v, "->9.99%")).
     2186       end.
     2187     end.
     2188   end.
     2189   else do:
     2190    return "ОШИБКА-НЕТ ТИПА".
     2191   end.
     2192   case p-discnt-role:
     2193     when 'def-categ':U then do:
     2194        loc-d-v = loc-dis-card.category.
     2195        return string(loc-d-v, ">>>9").
     2196     end.
     2197     when 'def-pcnt':U then do:
     2198       loc-d-v = loc-dis-card.d-pcnt.
     2199       return string(loc-d-v, "->9.99%").
     2200     end.
     2201     when 'def-cash-pcnt':U then do:
     2202       loc-d-v = loc-dis-card.cash-d-pcnt.
     2203       return string(loc-d-v, "->9.99%").
     2204     end.
     2205   end case.
     2206   END FUNCTION.
     2207   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2208   procedure cli-grplib-get-full-name :
     2209      define input parameter  p-node-code  as integer      no-undo.
     2210      define output parameter p-full-name as character    no-undo.
     2211   do
     2212   on error undo, return error
     2213   :
     2214       define variable v-upper-code    as integer           no-undo.
     2215       define buffer buf_cli-grp       for ub.cli-grp.
     2216       define buffer buf_upper_cli-grp for ub.cli-grp.
     2217       find first buf_cli-grp no-lock
     2218            where buf_cli-grp.node-code = p-node-code
     2219       no-error.
     2220       if not available buf_cli-grp
     2221       then do:
     2222           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
     2223       end.
     2224       assign
     2225           p-full-name  = ""
     2226           v-upper-code = 1
     2227       .
     2228       do while buf_cli-grp.upper-code <> 0
     2229       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     2230       :
     2231           assign
     2232               p-full-name  = buf_cli-grp.node-name
     2233                            + (if p-full-name <> "" then chr(47) else "")
     2234                            + p-full-name
     2235               v-upper-code = buf_cli-grp.upper-code
     2236           .
     2237           find first buf_cli-grp no-lock
     2238                where buf_cli-grp.node-code = v-upper-code
     2239           no-error.
     2240           if not available buf_cli-grp
     2241           then do:
     2242               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
     2243                                   + string( v-upper-code )
     2244                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2245           end.
     2246       end.
     2247       assign
     2248       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2249       .
     2250   end.
     2251   end .
     2252   procedure cgrplib-get-node-from-full-name :
     2253   define input parameter p-full-name as character no-undo .
     2254   define output parameter p-node-code as integer no-undo .
     2255   define variable v-ii as integer no-undo .
     2256   define variable v-upper-code as integer no-undo .
     2257   define variable v-root-code as integer no-undo .
     2258   define variable v-entry as character no-undo .
     2259   define buffer buf_cli-grp       for ub.cli-grp.
     2260   do
     2261   on error undo, return error
     2262   :
     2263     find first buf_cli-grp no-lock
     2264         where buf_cli-grp.upper-code = 0
     2265     no-error .
     2266     if not available buf_cli-grp
     2267     then do:
     2268         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
     2269     end.
     2270     else do:
     2271       assign
     2272       v-root-code = buf_cli-grp.node-code
     2273       .
     2274     end.
     2275     v-upper-code = v-root-code.
     2276     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     2277       assign
     2278       v-entry = entry(v-ii, p-full-name, chr(47)).
     2279       if v-entry = '' then leave.
     2280       find first buf_cli-grp no-lock where
     2281                 buf_cli-grp.node-name = v-entry
     2282             and buf_cli-grp.upper-code = v-upper-code
     2283             no-error.
     2284       if not available buf_cli-grp then do:
     2285         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     2286       end.
     2287       else do:
     2288         p-node-code = buf_cli-grp.node-code.
     2289         v-upper-code = buf_cli-grp.node-code.
     2290       end.
     2291     end.
     2292   end.
     2293   end .
     2294   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2295   procedure cur-time :
     2296      define output parameter p-today as date      no-undo .
     2297      define output parameter p-time  as integer   no-undo .
     2298     do
     2299     on error undo, return error
     2300     :
     2301       define variable v-date1 as date      no-undo .
     2302       define variable v-date2 as date      no-undo .
     2303       define variable v-time  as integer   no-undo .
     2304       assign
     2305         v-date1 = today
     2306         v-time  = time
     2307         v-date2 = today
     2308       .
     2309       if v-date1 <> v-date2
     2310       then do:
     2311         assign
     2312           v-date1 = today
     2313           v-time  = v-time
     2314         .
     2315       end.
     2316       assign
     2317         p-today = v-date1
     2318         p-time  = v-time
     2319       .
     2320     end.
     2321   end.
     2322   function cur-time-date returns character
     2323   :
     2324     return string(today, '99/99/9999':U) .
     2325   end.
     2326   function cur-time-mjd returns decimal
     2327   :
     2328     define variable v-date as date      no-undo .
     2329     define variable v-time as integer   no-undo .
     2330     run cur-time in this-procedure
     2331       (output v-date
     2332       ,output v-time
     2333       ) .
     2334     return integer(v-date) - 2400002 + (v-time / 86400) .
     2335   end.
     2336   function cur-time-get-ending-index returns integer
     2337   (input p-number as integer
     2338   )
     2339   :
     2340     if p-number < 0
     2341     or p-number = ?
     2342     then do:
     2343       return 1 .
     2344     end.
     2345     define variable v-rest as integer   no-undo .
     2346     assign
     2347       p-number = p-number modulo 100
     2348     .
     2349     if p-number < 20
     2350     then do:
     2351       assign
     2352         v-rest = p-number
     2353       .
     2354     end.
     2355     else do:
     2356       assign
     2357         v-rest = p-number modulo 10
     2358       .
     2359     end.
     2360     case v-rest :
     2361       when 1
     2362       then do:
     2363         return 2 .
     2364       end.
     2365       when 2 or
     2366       when 3 or
     2367       when 4
     2368       then do:
     2369         return 3 .
     2370       end.
     2371       otherwise do:
     2372         return 1 .
     2373       end.
     2374     end case .
     2375   end.
     2376   procedure cur-time-mjd-to-date :
     2377      define input  parameter i-mjd-diff as decimal no-undo.
     2378      define output parameter o-Date     as date    no-undo.
     2379      define output parameter o-Time     as integer no-undo.
     2380      define variable v-day-number as integer   no-undo .
     2381      if    i-mjd-diff < 0
     2382         or i-mjd-diff = ?
     2383      then do:
     2384         return "?" .
     2385      end.
     2386      assign
     2387         v-day-number = truncate(i-mjd-diff,0).
     2388         o-Date = date(v-day-number + 2400002).
     2389         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     2390     .
     2391   end.
     2392   function cur-time-mjd-to-string returns character
     2393   (input p-mjd-diff as decimal
     2394   )
     2395   :
     2396     define variable v-day-number as integer   no-undo .
     2397     define variable v-seconds    as integer   no-undo .
     2398     define variable v-hour       as integer   no-undo .
     2399     define variable v-min        as integer   no-undo .
     2400     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     2401     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     2402     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     2403     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     2404     if p-mjd-diff < 0
     2405     or p-mjd-diff = ?
     2406     then do:
     2407       return "?" .
     2408     end.
     2409     assign
     2410       v-day-number = integer(truncate(p-mjd-diff,0))
     2411       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     2412     .
     2413     if v-seconds > 86400
     2414     then do:
     2415       assign
     2416         v-seconds = 86400 - 1
     2417       .
     2418     end.
     2419     if v-seconds < 0
     2420     then do:
     2421       assign
     2422         v-seconds = 0
     2423       .
     2424     end.
     2425     assign
     2426       v-hour = truncate(v-seconds / 3600, 0)
     2427     .
     2428     assign
     2429       v-seconds = v-seconds modulo 3600
     2430     .
     2431     assign
     2432       v-min = truncate(v-seconds / 60, 0)
     2433     .
     2434     assign
     2435       v-seconds = v-seconds modulo 60
     2436     .
     2437     return
     2438         (if v-day-number <> 0
     2439           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     2440           else ""
     2441         )
     2442       + (if v-day-number <> 0 or v-hour <> 0
     2443           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     2444           else ""
     2445         )
     2446       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     2447           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     2448           else ""
     2449         )
     2450       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     2451       .
     2452   end.
     2453   function cur-time-string returns character
     2454   :
     2455     define variable v-date as date      no-undo .
     2456     define variable v-time as integer   no-undo .
     2457     run cur-time in this-procedure
     2458       (output v-date
     2459       ,output v-time
     2460       ) .
     2461     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2462   end.
     2463   function cur-time-string-sec returns character
     2464   :
     2465     define variable v-date as date      no-undo .
     2466     define variable v-time as integer   no-undo .
     2467     run cur-time in this-procedure
     2468       (output v-date
     2469       ,output v-time
     2470       ) .
     2471     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2472   end.
     2473   function cur-time-custom  returns character
     2474   (input p-prefix as character
     2475   ,input p-date-format as character
     2476   ,input p-delimiter as character
     2477   ,input p-time-format as character
     2478   ,input p-suffix as character
     2479   )
     2480   :
     2481     define variable v-date as date      no-undo .
     2482     define variable v-time as integer   no-undo .
     2483     run cur-time in this-procedure
     2484       (output v-date
     2485       ,output v-time
     2486       ) .
     2487     return
     2488       p-prefix
     2489       + string(v-date, p-date-format)
     2490       + p-delimiter
     2491       + string(v-time, p-time-format)
     2492       + p-suffix
     2493       .
     2494   end.
     2495   function cur-time-print  returns character
     2496   :
     2497     define variable v-date as date      no-undo .
     2498     define variable v-time as integer   no-undo .
     2499     run cur-time in this-procedure
     2500       (output v-date
     2501       ,output v-time
     2502       ) .
     2503     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2504   end.
     2505   function cur-time-datetime returns datetime
     2506   :
     2507     define variable v-char as character no-undo .
     2508     define variable v-datetime as datetime no-undo .
     2509     v-char = cur-time-string().
     2510     v-datetime = datetime(v-char).
     2511     return  v-datetime.
     2512   end.
     2513   function cur-time-string-msec returns character
     2514   :
     2515     define variable v-date as datetime  no-undo .
     2516     v-date = now.
     2517     return string(v-date) .
     2518   end.
     2519   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2520   define temp-table userobjs_temp-user-obj no-undo
     2521     field obj-type as character
     2522     field obj-code as integer
     2523     index xpk is primary unique obj-type obj-code
     2524     .
     2525   procedure userobjs_clear :
     2526     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     2527     do
     2528     on error undo, return error return-value
     2529     :
     2530       for each buf_userobjs_temp-user-obj
     2531       on error undo, return error return-value
     2532       :
     2533         delete buf_userobjs_temp-user-obj .
     2534       end.
     2535     end.
     2536   end .
     2537   procedure userobjs_object-count :
     2538     define output parameter p-total-count as integer   no-undo .
     2539     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     2540     do
     2541     on error undo, return error return-value
     2542     :
     2543       assign
     2544         p-total-count = 0
     2545       .
     2546       for each buf_userobjs_temp-user-obj
     2547       on error undo, return error return-value
     2548       :
     2549         assign
     2550           p-total-count = p-total-count + 1
     2551         .
     2552       end.
     2553     end.
     2554   end.
     2555   procedure userobjs_append :
     2556      define input  parameter p-obj-type as character no-undo .
     2557      define input  parameter p-obj-code as integer   no-undo .
     2558     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     2559     do
     2560     on error undo, return error return-value
     2561     :
     2562       find first buf_userobjs_temp-user-obj
     2563         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
     2564           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
     2565         no-error .
     2566       if not available buf_userobjs_temp-user-obj
     2567       then do:
     2568         create buf_userobjs_temp-user-obj .
     2569         assign
     2570           buf_userobjs_temp-user-obj.obj-type = p-obj-type
     2571           buf_userobjs_temp-user-obj.obj-code = p-obj-code
     2572         .
     2573       end.
     2574     end.
     2575   end.
     2576   procedure userobjs_object-exist :
     2577     define output parameter p-object-exist as logical   no-undo .
     2578     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     2579     do
     2580     on error undo, return error return-value
     2581     :
     2582       find first buf_userobjs_temp-user-obj
     2583         no-error .
     2584       if not available buf_userobjs_temp-user-obj
     2585       then do:
     2586         assign
     2587           p-object-exist = false
     2588         .
     2589       end.
     2590       else do:
     2591         assign
     2592           p-object-exist = true
     2593         .
     2594       end.
     2595     end.
     2596   end.
     2597   procedure userobjs_transfer :
     2598     define input  parameter p-callback-handle as handle no-undo .
     2599     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     2600     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     2601     do
     2602     on error undo, return error return-value
     2603     :
     2604       if valid-handle(p-callback-handle) <> true
     2605       then do:
     2606         message
     2607           vss-workfile vss-revision vss-description skip
     2608           "Ошибка задания входных параметров" skip
     2609           "Неизвестный указатель на процедуру" skip
     2610           view-as alert-box error .
     2611         undo, return error return-value .
     2612       end.
     2613       if p-callback-handle :get-signature("userobjs_append") = ""
     2614       then do:
     2615         message
     2616           vss-workfile vss-revision vss-description skip
     2617           "Ошибка задания входных параметров" skip
     2618           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     2619                     ,p-callback-handle :file-name
     2620                     ) skip
     2621           view-as alert-box error .
     2622         undo, return error return-value .
     2623       end.
     2624       for each buf_userobjs_temp-user-obj
     2625       on error undo, return error return-value
     2626       :
     2627         run userobjs_append in p-callback-handle
     2628           (input  buf_userobjs_temp-user-obj.obj-type
     2629           ,input  buf_userobjs_temp-user-obj.obj-code
     2630           ) .
     2631       end.
     2632     end.
     2633   end procedure.
     2634   procedure userobjs_select-one :
     2635      define input  parameter parparentproc     as widget-handle no-undo .
