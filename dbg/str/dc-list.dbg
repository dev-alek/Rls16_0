     3977          MENU-ITEM m_xls-save     LABEL "Таблица EXCEL"
     3978          MENU-ITEM m_to-make      LABEL "Файл для изготовления"
     3979          MENU-ITEM m-title-save   LABEL "Имя списка"
     3980          MENU-ITEM m-macros-save  LABEL "Макрос формирования списка"
     3981          MENU-ITEM m_dc-save-db   LABEL "Хранимый в БД список дисконтных карт"
     3982          MENU-ITEM m-macros-save-db   LABEL "Хранимый в БД макрос формирования списка"
     3983          .
