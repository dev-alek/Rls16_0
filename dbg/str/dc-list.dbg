     4485   run minbtn-set in this-procedure .
     4486   on choose of b-help in frame Dialog-Frame
     4487   do:
     4488     apply "help":u to frame Dialog-Frame .
     4489   end.
     4490   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4491   procedure minbtn-set :
     4492       do
     4493           on error undo, return error return-value
     4494           :
     4495           define variable ii              as integer       no-undo .
     4496           define variable fh              as widget-handle no-undo .
     4497           define variable hh              as widget-handle no-undo .
     4498           define variable v-h             as handle        extent 4 no-undo .
     4499           define variable v-name-button   as character     no-undo .
     4500           define variable v-help-old-x    as decimal       no-undo .
     4501           define variable v-help-old-y    as decimal       no-undo .
     4502           define variable v-help-old-size as decimal       no-undo .
     4503           define variable v-frame-width   as decimal       no-undo .
     4504           define variable jj              as integer       no-undo .
     4505           do
     4506               on error undo, return error
     4507               :
     4508               assign
     4509                   v-frame-width = frame Dialog-Frame:width - 0.3
     4510                   fh            = frame Dialog-Frame:first-child
     4511                   hh            = fh:first-child
     4512                   ii            = 1
     4513                   .
     4514               do while valid-handle(hh):
     4515                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     4516                   do:
     4517                       case lc(hh:name) :
     4518                           when "b-help" then
     4519                               do:
     4520                                   hh:load-image-up("cmp/b-help.bmp":u) .
     4521                                   hh:load-image-down("cmp/b-help.bmp":u) .
     4522                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     4523                                   hh:TOOLTIP = "Помощь" .
     4524                                   v-help-old-x = hh:column .
     4525                                   v-help-old-y = hh:row    .
     4526                                   v-help-old-size = hh:width .
     4527                                   hh:width-chars = 2.5 .
     4528                               end.
     4529                           when "b-print" then
     4530                               do:
     4531                                   hh:load-image("cmp/b-print.bmp":u) .
     4532                                   hh:TOOLTIP = "Печать" .
     4533                                   v-h[ii] = hh:handle .
     4534                                   ii = ii + 1 .
     4535                                   hh:width-chars = 3 .
     4536                               end.
     4537                           when "b-history" or
     4538                           when "b-hist" then
     4539                               do:
     4540                                   hh:load-image("cmp/b-hist.bmp":u) .
     4541                                   hh:TOOLTIP = "История" .
     4542                                   v-h[ii] = hh:handle .
     4543                                   ii = ii + 1 .
     4544                                   hh:width-chars = 3 .
     4545                               end.
     4546                           when "b-sch" then
     4547                               do:
     4548                                   hh:load-image("cmp/b-sch.bmp":u) .
     4549                                   hh:TOOLTIP = "Установка Фильтра" .
     4550                                   v-h[ii] = hh:handle .
     4551                                   ii = ii + 1 .
     4552                                   hh:width-chars = 3 .
     4553                               end.
     4554                           when "b-hist-user" then
     4555                               do:
     4556                                   hh:load-image("cmp/b-hist.bmp":u) .
     4557                                   hh:TOOLTIP = "История пользователя" .
     4558                                   ii = ii + 1 .
     4559                               end.
     4560                       end case.
     4561                   end.
     4562                   hh = hh:next-sibling.
     4563               end.
     4564               b-help:column = v-frame-width - b-help:width-chars.
     4565               jj = 0.
     4566               repeat ii = 4 to 1 by -1 :
     4567                   if valid-handle (v-h[ii] ) then
     4568                   do:
     4569                       jj  = jj + 1 .
     4570                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     4571                       v-h[ii]:row    = v-help-old-y .
     4572                   end.
     4573               end.
     4574           end.
     4575       end.
     4576   end procedure.
     4577   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     4578   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     4579   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     4580   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     4581   define variable v-diasize-current-frame-width  as decimal   no-undo .
     4582   define variable v-diasize-current-frame-height as decimal   no-undo .
     4583   define variable v-diasize-change-size          as logical   no-undo .
     4584   define variable v-diasize-resize-button        as handle    no-undo .
     4585   define variable v-diasize-wndmax               as logical   no-undo .
     4586   define variable v-diasize-wndstore             as logical   no-undo .
     4587   define variable v-diasize-proc-name            as character no-undo .
     4588   define variable v-diasize-browse-handle        as handle    no-undo .
     4589   define variable v-diasize-browse-number        as integer   no-undo .
     4590   define variable v-diasize-need-full-display    as logical   no-undo init false .
     4591   define temp-table temp-diasize-handle no-undo
     4592     field handle-value  as handle
     4593     field save-position as decimal
     4594     index xpk is primary unique handle-value
     4595     .
     4596   define temp-table temp-browse-handle no-undo
     4597     field browse-type   as character
     4598     field browse-number as integer
     4599     field browse-handle as handle
     4600     field original-size as decimal
     4601     index xpk is primary unique browse-type browse-number
     4602     index xie browse-type browse-handle
     4603   .
     4604   procedure diasize_change-height :
     4605     define input  parameter p-change-value  as decimal   no-undo .
     4606     define input  parameter p-move-resize   as logical   no-undo .
     4607     define variable v-field-group-handle    as handle    no-undo .
     4608     define variable v-object-handle         as handle    no-undo .
     4609     define variable v-frame-height          as decimal   no-undo .
     4610     define variable v-frame-virtual-height  as decimal   no-undo .
     4611     define variable v-browse-height         as decimal   no-undo .
     4612     define variable v-window-height         as decimal   no-undo .
     4613     define variable v-window-virtual-height as decimal   no-undo .
     4614     define variable v-change-sign           as integer   no-undo .
     4615     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     4616     define buffer buf_temp-browse-handle  for temp-browse-handle .
     4617     if p-change-value > 0
     4618     then do:
     4619       if frame Dialog-Frame :height + p-change-value
     4620           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     4621       then do:
     4622         assign
     4623           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     4624                           - (frame Dialog-Frame :height-chars)
     4625         .
     4626         if p-change-value <= 0
     4627         then do:
     4628           run diasize_position-resize-button in this-procedure .
     4629           return .
     4630         end.
     4631       end.
     4632     end.
     4633     if p-change-value < 0
     4634     then do:
     4635       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     4636       then do:
     4637         assign
     4638           p-change-value = v-diasize-orig-frame-height
     4639                          - (frame Dialog-Frame :height-chars)
     4640         .
     4641         if p-change-value >= 0
     4642         then do:
     4643           run diasize_position-resize-button in this-procedure .
     4644           return .
     4645         end.
     4646       end.
     4647     end.
     4648     if p-change-value >= 0
     4649     then do:
     4650       assign
     4651         v-change-sign = 1
     4652       .
     4653     end.
     4654     else do:
     4655       assign
     4656         v-change-sign = -1
     4657       .
     4658     end.
     4659     assign
     4660       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4661     .
     4662     if p-change-value = 0
     4663     then do:
     4664       run diasize_position-resize-button in this-procedure .
     4665       return .
     4666     end.
     4667     move_block:
     4668     do
     4669     on error undo move_block, retry move_block
     4670     :
     4671       if retry
     4672       then do:
     4673         do
     4674         on error undo move_block, leave move_block
     4675         :
     4676           if p-change-value > 0
     4677           then do:
     4678             for each buf_temp-diasize-handle
     4679             on error undo, next
     4680             :
     4681               assign
     4682                 v-object-handle = buf_temp-diasize-handle.handle-value
     4683               .
     4684               if v-object-handle <> v-diasize-resize-button
     4685               then do:
     4686                 assign
     4687                   v-object-handle :row = buf_temp-diasize-handle.save-position
     4688                 .
     4689               end.
     4690             end.
     4691             assign
     4692               v-diasize-browse-handle :height = v-browse-height
     4693             .
     4694             for each buf_temp-browse-handle
     4695               where buf_temp-browse-handle.browse-type = 'height':u
     4696             on error undo, next
     4697             :
     4698               assign
     4699                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     4700               .
     4701             end.
     4702             assign
     4703               frame Dialog-Frame :height = v-frame-height
     4704             .
     4705             if frame Dialog-Frame :scrollable = true
     4706             then do:
     4707               assign
     4708                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     4709               .
     4710             end.
     4711             run diasize_position-resize-button in this-procedure .
     4712           end.
     4713           else do:
     4714             if frame Dialog-Frame :scrollable = true
     4715             then do:
     4716               assign
     4717                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     4718               .
     4719             end.
     4720             assign
     4721               frame Dialog-Frame :height = v-frame-height
     4722             .
     4723             assign
     4724               v-diasize-browse-handle :height = v-browse-height
     4725             .
     4726             for each buf_temp-browse-handle
     4727               where buf_temp-browse-handle.browse-type = 'height':u
     4728             on error undo, next
     4729             :
     4730               assign
     4731                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     4732               .
     4733             end.
     4734             for each buf_temp-diasize-handle
     4735             on error undo, next
     4736             :
     4737               assign
     4738                 v-object-handle = buf_temp-diasize-handle.handle-value
     4739               .
     4740               if v-object-handle <> v-diasize-resize-button
     4741               then do:
     4742                 assign
     4743                   v-object-handle :row = buf_temp-diasize-handle.save-position
     4744                 .
     4745               end.
     4746             end.
     4747             run diasize_position-resize-button in this-procedure .
     4748           end.
     4749           assign
     4750             v-diasize-change-size = false
     4751           .
     4752           leave move_block .
     4753         end.
     4754       end.
     4755       assign
     4756         v-diasize-need-full-display = true
     4757       .
