     1425     define input parameter p-append       as logical no-undo .
     1426     define variable v-report-name as character no-undo .
     1427     do
     1428       on error undo, return error
     1429       :
     1430       run prn-lib-get-report-name  in this-procedure (
     1431         input parParentProc
     1432         ,output v-report-name
     1433         ).
     1434       if p-is-stream then
     1435       do:
     1436         if p-append then
     1437         do:
     1438           output stream PrnLibStream to value( v-report-name )
     1439             page-size value(p-page-size) append .
     1440         end.
     1441         if not p-append then
     1442         do:
     1443           output stream PrnLibStream to value( v-report-name )
     1444             page-size value(p-page-size) .
     1445         end.
     1446       end.
     1447       if not p-is-stream then
     1448       do:
     1449         if p-append then
     1450         do:
     1451           output to value( v-report-name )
     1452             page-size value(p-page-size) append .
     1453         end.
     1454         if not p-append then
     1455         do:
     1456           output to value( v-report-name )
     1457             page-size value(p-page-size) .
     1458         end.
     1459       end.
     1460     end.
     1461   end procedure.
     1462   procedure prn-lib-open-exp :
     1463     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1464     define input parameter p-is-stream    as logical no-undo .
     1465     define input parameter p-is-append    as logical no-undo .
     1466     define output parameter p-ReportFileName as char init "report" no-undo.
     1467     define output parameter p-process as logical no-undo .
     1468     define variable glog as logical no-undo .
     1469     do
     1470       on error undo, return error
     1471       :
     1472       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1473         TITLE      "Укажите путь"
     1474         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1475         ASK-OVERWRITE
     1476         CREATE-TEST-FILE
     1477         SAVE-AS
     1478         USE-FILENAME
     1479         DEFAULT-EXTENSION "txt"
     1480         UPDATE glog
     1481         .
     1482       if not glog then  return.
     1483       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1484       if p-is-stream then
     1485       do:
     1486         if p-is-append then
     1487         do:
     1488           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1489         end.
     1490         else
     1491         do:
     1492           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1493         end.
     1494       end.
     1495       else
     1496       do:
     1497         if p-is-append then
     1498         do:
     1499           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1500         end.
     1501         else
     1502         do:
     1503           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1504         end.
     1505       end.
     1506       p-process = yes.
     1507     end.
     1508   end procedure.
     1509   procedure prn-lib-get-report-name :
     1510     define input parameter parParentProc  as widget-handle no-undo.
     1511     define output parameter p-report-name as character no-undo .
     1512     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1513   end procedure.
     1514   procedure prn-lib-reportviewer-report-name :
     1515     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1516     define input parameter p-report-name-html as character no-undo .
     1517     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1518   end procedure.
     1519   procedure prn-lib-reportviewer :
     1520     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1521     define input parameter p-report-name-html as character no-undo .
     1522     define input parameter p-param        as character no-undo .
     1523     define variable v-excel           as character no-undo init 'TRUE' .
     1524     define variable v-value-character as character no-undo .
     1525     define variable v-value-integer   as character no-undo .
     1526     define variable v-value-date      as date      no-undo .
     1527     define variable v-value-decimal   as decimal   no-undo .
     1528     define variable rep-excel         as logical   no-undo .
     1529     define variable excel-string      as character no-undo .
     1530     define variable v-param-type      as character no-undo .
     1531     define variable v-tth             as handle    no-undo .
     1532     run adm/shattri.p (
     1533       input "get":U
     1534       ,input  ""
     1535       ,input  0
     1536       ,input  'report-glob':U
     1537       ,input  'rep-excel':U
     1538       ,output v-value-character
     1539       ,output v-value-date
     1540       ,output v-value-decimal
     1541       ,output v-value-integer
     1542       ,output rep-excel
     1543       ,output v-param-type
     1544       ,INPUT-OUTPUT table-handle v-tth
     1545       )  .
     1546     if rep-excel then v-excel = "TRUE" .
     1547     else v-excel = "FALSE" .
     1548     if p-param eq ""
     1549     then
     1550        p-param = "EXCEL:" + v-excel.
     1551     else
     1552        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1553     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1554   end procedure.
