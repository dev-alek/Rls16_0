     5363       v-diasize-change-size = false
     5364     .
     5365   end procedure.
     5366   procedure diasize_set-width :
     5367     define input  parameter p-new-width  as decimal   no-undo .
     5368     define input  parameter p-move-resize as logical   no-undo .
     5369     do
     5370     on error undo, return error return-value
     5371     :
     5372       run diasize_change-width in this-procedure
     5373         (input  (p-new-width - frame Dialog-Frame :width)
     5374         ,input  p-move-resize
     5375         ) .
     5376     end.
     5377   end procedure.
     5378   procedure diasize_position-resize-button :
     5379     do with frame Dialog-Frame
     5380     :
     5381       hide v-diasize-resize-button .
     5382       assign
     5383         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     5384                     - 1
     5385                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     5386         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     5387                     - 1
     5388                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     5389       .
     5390       view v-diasize-resize-button .
     5391     end.
     5392   end procedure.
     5393   on alt-right anywhere
     5394   do:
     5395     run diasize_change-width in this-procedure
     5396       (input 1
     5397       ,input true
     5398       ) .
     5399     return no-apply .
     5400   end.
     5401   on alt-left anywhere
     5402   do:
     5403     run diasize_change-width in this-procedure
     5404       (input -1
     5405       ,input true
     5406       ) .
     5407     return no-apply .
     5408   end.
     5409   on alt-down anywhere
     5410   do:
     5411     run diasize_change-height in this-procedure
     5412       (input 1
     5413       ,input true
     5414       ) .
     5415     return no-apply .
     5416   end.
     5417   on alt-up anywhere
     5418   do:
     5419     run diasize_change-height in this-procedure
     5420       (input -1
     5421       ,input true
     5422       ) .
     5423     return no-apply .
     5424   end.
     5425   on alt-enter of frame Dialog-Frame
     5426   do:
     5427     run diasize_maximize in this-procedure
     5428       (input  ?
     5429       ).
     5430     return no-apply .
     5431   end.
     5432   procedure diasize_end-move :
     5433     do
     5434     on error undo, return error return-value
     5435     :
     5436       define variable v-row-delta as decimal   no-undo .
     5437       define variable v-col-delta as decimal   no-undo .
     5438       define variable v-new-row as decimal   no-undo .
     5439       define variable v-new-col as decimal   no-undo .
     5440       assign
     5441         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     5442         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     5443       .
     5444       assign
     5445         v-row-delta = v-new-row - frame Dialog-Frame :height
     5446         v-col-delta = v-new-col - frame Dialog-Frame :width
     5447       .
     5448       run diasize_change-height in this-procedure
     5449         (input v-row-delta
     5450         ,input true
     5451         ) .
     5452       run diasize_change-width in this-procedure
     5453         (input v-col-delta
     5454         ,input true
     5455         ) .
     5456     end.
     5457   end procedure.
     5458   procedure diasize_maximize :
     5459     define input  parameter p-action as logical   no-undo .
     5460     do
     5461     on error undo, return error return-value
     5462     :
     5463       if p-action = ?
     5464       then do:
     5465         if v-diasize-need-maximize = true
     5466         then do:
     5467           assign
     5468             p-action = true
     5469           .
     5470         end.
     5471         else do:
     5472           assign
     5473             p-action = false
     5474           .
     5475         end.
     5476       end.
     5477       if p-action = true
     5478       then do:
     5479         run diasize_change-height in this-procedure
     5480           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     5481               - frame Dialog-Frame :height-chars
     5482           ,input true
     5483           ) .
     5484         run diasize_change-width in this-procedure
     5485           (input session :width-chars
     5486               - frame Dialog-Frame :width-chars
     5487           ,input true
     5488           ) .
     5489         assign
     5490           v-diasize-need-maximize = false
     5491         .
     5492       end.
     5493       else do:
     5494         run diasize_change-width in this-procedure
     5495           (input v-diasize-orig-frame-width
     5496               - frame Dialog-Frame :width-chars
     5497           ,input true
     5498           ) .
     5499         run diasize_change-height in this-procedure
     5500           (input v-diasize-orig-frame-height
     5501               - frame Dialog-Frame :height-chars
     5502           ,input true
     5503           ) .
     5504         assign
     5505           v-diasize-need-maximize = true
     5506         .
     5507       end.
     5508     end.
     5509   end procedure.
     5510   procedure diasize_restore-orig-size :
     5511     do
     5512     on error undo, return error return-value
     5513     :
     5514       assign
     5515         v-diasize-current-frame-width  = frame Dialog-Frame :width
     5516         v-diasize-current-frame-height = frame Dialog-Frame :height
     5517       .
     5518       run diasize_set-height in this-procedure
     5519         (input  v-diasize-orig-frame-height
     5520         ,input  true
     5521         ) .
     5522       run diasize_set-width in this-procedure
     5523         (input  v-diasize-orig-frame-width
     5524         ,input  true
     5525         ) .
     5526     end.
     5527   end procedure.
     5528   procedure diasize_restore-current-size :
     5529     do
     5530     on error undo, return error return-value
     5531     :
     5532       run diasize_set-height in this-procedure
     5533         (input  v-diasize-current-frame-height
     5534         ,input  true
     5535         ) .
     5536       run diasize_set-width in this-procedure
     5537         (input  v-diasize-current-frame-width
     5538         ,input  true
     5539         ) .
     5540     end.
     5541   end procedure.
     5542   procedure diasize_set-browse-handle :
     5543     define input  parameter p-browse-handle as handle   no-undo .
     5544     define buffer buf_temp-browse-handle for temp-browse-handle .
     5545     do
     5546     on error undo, return error return-value
     5547     :
     5548       assign
     5549         v-diasize-browse-handle = p-browse-handle
     5550       .
     5551       for each buf_temp-browse-handle
     5552       on error undo, return error return-value
