     9188                    ub.clients.obj-type = ub.dis-obj.obj-type
     9189                and ub.clients.obj-code = ub.dis-obj.obj-code:
     9190             find last ub.c-dis-obj no-lock where
     9191                       ub.c-dis-obj.d-card = ub.dis-obj.d-card
     9192                   and ub.c-dis-obj.dt-code = ub.dis-obj.dt-code
     9193                   and ub.c-dis-obj.obj-type = ub.dis-obj.obj-type
     9194                   and ub.c-dis-obj.obj-code = ub.dis-obj.obj-code
     9195                   and ub.c-dis-obj.corr-user-db-num = ub.clients.db-num no-error.
     9196             if not available ub.c-dis-obj then next _do.
     9197             if (v-cond = '=' and ub.c-dis-obj.corr-date = v-last-change-date)
     9198             or (v-cond = '>=' and ub.c-dis-obj.corr-date >= v-last-change-date)
     9199             or (v-cond = '<=' and ub.c-dis-obj.corr-date <= v-last-change-date)
     9200             or (v-cond = '>' and ub.c-dis-obj.corr-date > v-last-change-date)
     9201             or (v-cond = '<' and ub.c-dis-obj.corr-date < v-last-change-date)  then do:
     9202               find first ub.dis-card no-lock where ub.dis-card.d-card = ub.dis-obj.d-card.
     9203                run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     9204             end.
     9205           end.
     9206         end.
     9207         assign                                                           buf_dc-list-hist.num-add  = lns-cnt - v-num-add                       buf_dc-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_dc-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_dc-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     9208       end.
     9209     end.
     9210     when "cli-list"
     9211     or
     9212     when "doc-list"
     9213     or
     9214     when "chk-list"
     9215     or
     9216     when "file"
     9217     or
     9218     when "clob-data"
     9219     then do:
     9220       run proc-file-list-methods in this-procedure(input p-from-macro, input rs-list-method, input rs-status, input line-mode, input p-id). .
     9221     end.
     9222     when "deleted" then do:
     9223       find first buf_dc-list-hist where
     9224                  buf_dc-list-hist.id = p-id .
     9225       for each ub.dis-card where ub.dis-card.status_ = 'удал':U no-lock:
     9226         run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     9227       end.
     9228     end.
     9229     when "filter" then do:
     9230       define variable v-filter-var as character no-undo .
     9231       find first buf_dc-list-hist where
     9232                buf_dc-list-hist.id = p-id
     9233            AND buf_dc-list-hist.item_ <> '':U .
     9234       run proc-write-filter-expression-var in this-procedure ( input buf_dc-list-hist.item_ , output v-filter-var ).
     9235       run gbl/dc-fill.p (
     9236                        input "Формирование списка по фильтру (без учета сортировки)"
     9237                      , input rs-list-method
     9238                      , input rs-status
     9239                      , input line-mode
     9240                      , input v-filter-var
     9241                      , output lns-cnt
     9242                      , output line-rec
     9243                      )  .
     9244        assign                                                           buf_dc-list-hist.num-add  = lns-cnt - v-num-add                       buf_dc-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_dc-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_dc-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     9245     end.
     9246     when "all" then do:
     9247       find first buf_dc-list-hist where
     9248                  buf_dc-list-hist.id = p-id .
     9249       for each ub.dis-card no-lock:
     9250         run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     9251       end.
     9252       assign                                                           buf_dc-list-hist.num-add  = lns-cnt - v-num-add                       buf_dc-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_dc-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_dc-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     9253     end.
     9254   END CASE.
     9255   dsp-rs:fgcolor in frame Dialog-Frame = 4.
     9256   if session:set-wait-state( "" )  then .
     9257   case line-mode :
     9258     when 'ДОБАВЛЕНИЕ':U then do:
     9259       tot-lns = tot-lns + lns-cnt.
     9260       if not p-from-macro or p-step then
     9261       message
     9262       "Добавлено строк :" lns-cnt skip(0)
     9263       string(if lns-ignore <> 0
     9264       then ("Проигнорировано строк :" + string(lns-ignore))
     9265       else "":U)
     9266       .
     9267     end.
     9268     when 'удаление':U then do:
     9269       tot-lns = tot-lns - lns-cnt.
     9270       if not p-from-macro or p-step then
     9271       message
     9272       "Удалено строк :" lns-cnt skip(0)
     9273       string(if lns-ignore <> 0
     9274       then ("Проигнорировано строк :" + string(lns-ignore))
     9275       else "":U)
     9276       .
     9277     end.
     9278   end.
     9279   if line-mode <> 'ОСТАВИТЬ':U then
     9280     run Myenable in this-procedure .
     9281   end.
     9282   END PROCEDURE.
     9283   PROCEDURE trig-attr :
     9284   define input parameter rs-list-method as character no-undo .
     9285   DEFINE VARIABLE vattr-codes          as character           no-undo.
     9286   DEFINE VARIABLE vattr-labels         as character           no-undo.
     9287   DEFINE VARIABLE vtooltip             as character           no-undo.
     9288   DEFINE VARIABLE vlabel               as character           no-undo .
     9289   DEFINE VARIABLE vtype                as character           no-undo .
     9290   DEFINE VARIABLE vformat              as character           no-undo .
     9291   DEFINE VARIABLE vuser-can-edit       as logical             no-undo .
     9292   DEFINE VARIABLE voutput-display      as logical             no-undo .
     9293   define variable v-range              as integer             no-undo .
     9294   DEFINE VARIABLE vother               as character           no-undo .
     9295   DEFINE VARIABLE v-ref-list           as character           no-undo .
     9296   DEFINE VARIABLE jj                   as integer             no-undo .
     9297   DEFINE VARIABLE v-spr                as character           no-undo .
     9298   DEFINE VARIABLE v-spr-param          as character           no-undo .
     9299   DEFINE VARIABLE v-setted             as logical             no-undo .
     9300   define variable v-init               as character           no-undo .
     9301   define variable ii as integer no-undo.
     9302   define variable v-item               as character           no-undo .
     9303   define variable glog                 as logical no-undo .
     9304   DEFINE VARIABLE v-attr-code          as character           no-undo .
     9305   assign
     9306   vattr-codes = ""
     9307   vattr-labels = "".
     9308   _ii:
     9309   DO ii = 1 to num-entries('db,is-superviser':u):
     9310       if rs-list-method = "attr" or rs-list-method  = "attr-val" then do:
     9311          run clntattr-code in this-procedure (input entry(ii, 'db,is-superviser':u),
     9312                          output vtype,
     9313                           output vformat,
     9314                           output vlabel,
     9315                           output vuser-can-edit,
     9316                           output voutput-display,
     9317                           output vother) no-error.
     9318       end.
     9319       if NOT error-status:error anD VOUTPUT-DISPLAY = yes then do:
     9320         if rs-list-method = "attr-val"
     9321         and (lookup('compl=yes', vother, chr(47)) > 0
     9322              or
     9323              lookup('compl=true', vother, chr(47)) > 0) then next _ii.
     9324         assign
     9325         vattr-codes = vattr-codes + chr(44) + entry(ii, 'db,is-superviser':u)
     9326         vattr-labels = vattr-labels + chr(44) + vlabel
     9327         .
     9328       end.
     9329   end.
     9330   run gbl/d-list.w ("b-sel":U,
     9331               "Выберите атрибут",
     9332                vattr-codes,
     9333                vattr-labels,
     9334                chr(44),
     9335                "":U,
     9336                output v-attr-code).
     9337   if v-attr-code = "" then do:
     9338     return error.
     9339   end.
     9340   glog = yes.
     9341   if rs-list-method = "attr" then do:
     9342       run clntattr-tooltip in this-procedure (input v-attr-code,
     9343                            output vtooltip,
     9344                            output vlabel).
     9345       message
     9346       "Карты клиентов с установленным атрибутом " + vlabel
     9347        view-as alert-box question buttons OK-Cancel update glog.
     9348       if not glog then do:
     9349         return error.
     9350       end.
     9351       assign
     9352       dsp-rs = substitute("Карты c установленным атрибутом &1: &2", vlabel, stat-line(rs-status))
     9353       v-item = '':U + chr(3) + '':U + chr(3) + v-attr-code
     9354       .
     9355   end.
     9356   if rs-list-method = "attr-val" then do:
     9357       run clntattr-code in this-procedure (input v-attr-code,
     9358                            output vtype,
     9359                            output vformat,
     9360                            output vlabel,
     9361                            output vuser-can-edit,
     9362                            output voutput-display,
     9363                            output vother).
     9364       run gbl/d-prompt.w (
     9365         'title=':u + "Значение атрибута клиента" + '\':u
     9366       + 'text1=':u + vlabel + '\':u
     9367       + 'format=' + (if vtype = 'L':U then "yes/no" else vformat) + '\':u
     9368       + 'type=' + vtype + '\':u
     9369       + 'fillin_row=2\':u
     9370       + 'fillin_col=4\':u
     9371       + 'fillin_width=20\':u
     9372       + 'fillin_height=1\':u
     9373       + 'max-chars=70\':u
     9374       + 'readonly=no\':u
     9375       , input-output vvalue
     9376       ).
     9377       if return-value = 'false':U then do:
     9378         return error.
     9379       end.
     9380       message ("Карты клиентов с атрибутом " + vlabel + " = ":U + vvalue)
     9381       view-as alert-box question buttons OK-Cancel update glog.
     9382       if not glog then do:
     9383         return error.
     9384       end.
     9385       assign
     9386       dsp-rs = substitute("Карты клиентов с атрибутом &1 =&2 &3", vlabel, vvalue, stat-line(rs-status))
     9387       v-item = '':U + chr(3) + '':U + chr(3) + v-attr-code + chr(3) + vvalue
     9388       .
     9389   end.
     9390   v-no-hist = 0.
     9391   run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     9392                                       , input-output v-seq
     9393                                       , input 0
     9394                                       , input '':U
     9395                                       , input dsp-rs
     9396                                       , input tot-lns
     9397                                       , input rs-list-method
     9398                                       , input rs-status
     9399                                       , input v-item
     9400                                       , input '':U
     9401                                       , input ?
     9402                                       ).
     9403   END PROCEDURE.
     9404   PROCEDURE trig-dcp :
     9405   define input parameter rs-list-method as character no-undo .
     9406   define variable v-dtm-code as integer no-undo init ?.
     9407   define variable v-dt-code as integer no-undo init ?.
     9408   define variable v-node-code as integer no-undo init ?.
     9409   define variable v-host-code as integer no-undo init 0.
     9410   define variable v-obj-type as integer no-undo init '':U.
     9411   define variable v-obj-code as integer no-undo init 0.
     9412   define variable v-cond as character no-undo .
     9413   define variable glog as logical no-undo .
     9414   define variable v-tool-tip as character no-undo .
     9415   define variable v-value as character no-undo .
     9416   define variable v-label as character no-undo .
     9417   define variable v-sum-id as character no-undo .
     9418   define variable v-item as character no-undo .
     9419   define variable v-value-character-low as character no-undo .
     9420   define variable v-value-date-low as date no-undo .
     9421   define variable v-value-decimal-low as decimal no-undo .
     9422   define variable v-value-integer-low as integer no-undo .
     9423   define variable v-value-logical-low as logical no-undo .
     9424   define variable v-value-character-high as character no-undo .
     9425   define variable v-value-date-high as date no-undo .
     9426   define variable v-value-decimal-high as decimal no-undo .
     9427   define variable v-value-integer-high as integer no-undo .
     9428   define variable v-value-logical-high as logical no-undo .
     9429   define variable v-ok as logical no-undo .
     9430   run ref/dcprpsel.w (
     9431                        input parparentproc
     9432                       ,input p-curr-host-code
     9433                       ,input p-curr-obj-type
     9434                       ,input p-curr-obj-code
     9435                       ,input-output v-dtm-code
     9436                       ,input-output v-dt-code
     9437                       ,input-output v-node-code
     9438                       ,input-output v-host-code
     9439                       ,input-output v-obj-type
     9440                       ,input-output v-obj-code
     9441                       ,input-output v-cond
     9442                       ,output v-value-character-low
     9443                       ,output v-value-character-high
     9444                       ,output v-value-date-low
     9445                       ,output v-value-date-high
     9446                       ,output v-value-decimal-low
     9447                       ,output v-value-decimal-high
     9448                       ,output v-value-integer-low
     9449                       ,output v-value-integer-high
     9450                       ,output v-value-logical-low
     9451                       ,output v-value-logical-high
     9452                       ,output v-ok
     9453                       ) no-error.
     9454   if error-status:error
     9455   or v-dtm-code = ?
     9456   or not v-ok
     9457   then undo, return error .
     9458   run discprop-node-name in this-procedure ( input (string(v-dtm-code) + chr(4) + (if v-node-code <> ? then string(v-node-code) else ''))
     9459                                             ,output v-tool-tip
     9460                                             ,output v-label).
     9461   if rs-list-method = "dcp" then do:
     9462     message
     9463     substitute("Карты, имеющие &1 &2"
     9464                ,v-label
     9465                ,(if v-dt-code <> ?
     9466                  then substitute(" Срез &1", v-sum-id)
     9467                  else '':U)
     9468               )
     9469     view-as alert-box question buttons OK-Cancel update glog.
     9470     if not glog then do:
     9471       return error.
     9472     end.
     9473     assign
     9474     dsp-rs = substitute("Карты, имеющие &1 &2: &3"
     9475                         , v-label
     9476                         ,(if v-dt-code <> ?
     9477                           then substitute(" Срез &1", v-sum-id)
     9478                           else '':U)
     9479                         , stat-line(rs-status))
     9480     v-item = substitute("&2&1&3&1&4"
     9481                         , chr(3)
     9482                         , v-dtm-code
     9483                         , v-dt-code
     9484                         , v-node-code)
     9485     .
     9486   end.
     9487   if rs-list-method = "dcp-val" then do:
     9488     message
     9489     substitute("Карты, имеющие &1 &2 = &3"
     9490                ,v-label
     9491                ,(if v-dt-code <> ?
     9492                  then substitute(" Срез &1", v-sum-id)
     9493                  else '':U)
     9494               , v-value
     9495               )
     9496     view-as alert-box question buttons OK-Cancel update glog.
     9497     if not glog then do:
     9498       return error.
     9499     end.
     9500     assign
     9501     dsp-rs = substitute("Карты, имеющие &1 &2 = &3: &4"
     9502                         , v-label
     9503                         ,(if v-dt-code <> ?
     9504                           then substitute(" Срез &1", v-sum-id)
     9505                           else '':U)
     9506                         , v-value
     9507                         , stat-line(rs-status))
     9508     v-item = substitute("&2&1&3&1&4&1&5"
     9509                         , chr(3)
     9510                         , v-dtm-code
     9511                         , v-dt-code
     9512                         , v-node-code)
     9513     .
     9514   end.
     9515   v-no-hist = 0.
     9516   run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     9517                                       , input-output v-seq
     9518                                       , input 0
     9519                                       , input '':U
     9520                                       , input dsp-rs
     9521                                       , input tot-lns
     9522                                       , input rs-list-method
     9523                                       , input rs-status
     9524                                       , input v-item
     9525                                       , input '':U
     9526                                       , input ?
     9527                                       ).
     9528   END PROCEDURE.
     9529   PROCEDURE proc-sum-id :
     9530   define input parameter rs-list-method as character no-undo .
     9531   define variable v-host-code like ub.sysconf.host-code no-undo .
     9532   define variable v-obj-type  like ub.clients.obj-type no-undo .
     9533   define variable v-obj-code  like ub.clients.obj-code no-undo .
     9534   define variable v-dt-code    as integer no-undo .
     9535   define variable v-get-r-b as character no-undo .
     9536   define variable v-field as character no-undo .
     9537   define variable v-field-des as character no-undo .
     9538   define variable v-low as decimal no-undo .
     9539   define variable v-high as decimal no-undo .
     9540   define variable v-ok as logical no-undo .
     9541   define variable v-sum-id-type as character no-undo .
     9542   define variable v-item as character no-undo .
     9543   define variable v-cond as character no-undo init '>':U.
     9544   define variable v-last-change-date as date no-undo .
     9545   DEFINE VARIABLE v-today as date no-undo .
     9546   DEFINE VARIABLE v-time as integer no-undo .
     9547   v-sum-id-type = replace(rs-list-method, 'last-change-', '':U).
     9548   run cur-time in this-procedure ( output v-today, output v-time).
     9549   v-last-change-date = v-today - 2.
     9550   run ref/dcsumid.w (
     9551                      input parparentproc
     9552                     ,input this-procedure:handle
     9553                     ,input (if rs-list-method begins "last-change" then 'last-change' else 'current-values')
     9554                     ,input-output v-sum-id-type
     9555                     ,input-output v-dt-code
     9556                     ,input-output v-host-code
     9557                     ,input-output v-obj-type
     9558                     ,input-output v-obj-code
     9559                     ,input-output v-get-r-b
     9560                     ,input-output v-field
     9561                     ,input-output v-cond
     9562                     ,input-output v-last-change-date
     9563                     ,output v-field-des
     9564                     ,output v-low
     9565                     ,output v-high
     9566                     ,output v-ok
     9567                     ).
     9568   if not v-ok then return error.
     9569   if rs-list-method begins 'last' then do:
     9570     assign
     9571     dsp-rs = substitute("&1 &2 &3 &4 &5 &6 &7 "
     9572                         ,(if v-sum-id-type = 'general-sum-id':U
     9573                           then 'Общие итоги по карте'
     9574                           else 'Частные итоги по карте')
     9575                         , (if v-sum-id-type = 'general-sum-id':U
     9576                             then '':U
     9577                             else dct-algo-get-description-sum-id(v-dt-code) )
     9578                         , (if v-host-code = 0
     9579                             then 'Глобальные'
     9580                             else substitute('Фирма &1', v-host-code))
     9581                           , (if v-obj-code = 0 then '':u else substitute("&1&2", v-obj-type, v-obj-code))
     9582                           , v-field-des
     9583                           , v-cond
     9584                           , v-last-change-date)
     9585     v-item = string(v-dt-code) + chr(3) +
     9586             string(v-host-code) + chr(3) +
     9587             v-obj-type + chr(3) +
     9588             string(v-obj-code) + chr(3) +
     9589             v-cond + chr(3) +
     9590             string(v-last-change-date, "99/99/9999")
     9591             .
     9592   end.
     9593   else do:
     9594     assign
     9595     dsp-rs = substitute("&1 &2 &3 &4 &5 = &6 - &7 "
     9596                         ,(if v-sum-id-type = 'general-sum-id':U
     9597                           then 'Общие итоги по карте'
     9598                           else 'Частные итоги по карте')
     9599                         , (if v-sum-id-type = 'general-sum-id':U
     9600                             then '':U
     9601                             else dct-algo-get-description-sum-id(v-dt-code) )
     9602                         , (if v-host-code = 0
     9603                             then 'Глобальные'
     9604                             else substitute('Фирма &1', v-host-code))
     9605                           , (if v-obj-code = 0 then '':u else substitute("&1&2", v-obj-type, v-obj-code))
     9606                           , v-field-des
     9607                           , v-low
     9608                           , v-high)
     9609     v-item = string(v-dt-code) + chr(3) +
     9610             string(v-host-code) + chr(3) +
     9611             v-obj-type + chr(3) +
     9612             string(v-obj-code) + chr(3) +
     9613             v-get-r-b + chr(3) +
     9614             v-field + chr(3) +
     9615             string(v-low) + chr(3) +
     9616             string(v-high).
     9617   end.
     9618   v-no-hist = 0.
     9619   run create-dc-list-hist in this-procedure (
     9620                                         input 'ДОБАВЛЕНИЕ':U
     9621                                       , input-output v-seq
     9622                                       , input 0
     9623                                       , input '':U
     9624                                       , input dsp-rs
     9625                                       , input tot-lns
     9626                                       , input rs-list-method
     9627                                       , input rs-status
     9628                                       , input v-item
     9629                                       , input '':U
     9630                                       , input ?
     9631                                       ).
     9632   END PROCEDURE.
     9633   PROCEDURE trig-filter :
     9634   define variable glog as logical no-undo .
     9635   define variable v-flt-rec as recid no-undo .
     9636   define variable v-filter-name as character no-undo .
     9637   define variable where-phrase as character no-undo .
     9638   define variable sort-phrase as character no-undo .
     9639   define variable where-phrase-rus as character no-undo .
     9640   define variable sort-phrase-rus as character no-undo .
     9641   glog = yes.
     9642   message
     9643   "Все карты выбранные в соответствии с заданным фильтром (без учета сортировки)."
     9644   view-as alert-box question buttons OK-Cancel update glog.
     9645   if not glog then do:
     9646     return error.
     9647   end.
     9648   assign
     9649   c-point = "dc-list":U + chr(4) + "Список дисконтных карт" + chr(4) + "no"
     9650   .
     9651   assign
     9652   tbl = 'dis-card'
     9653   join-tbl = ''
     9654   fld = ""
     9655   lab = ""
     9656   spr = ""
     9657   dim = '0'
     9658   .
     9659   run fltfield-add in this-procedure('cli-type*cli-code', 'Клиент(один)', 'cli',
     9660   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9661   run fltfield-add in this-procedure('cli-type', 'Тип клиента', '',
     9662   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9663   run fltfield-add in this-procedure('cli-code', 'Код клиента', '',
     9664   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9665   run fltfield-add in this-procedure('d-card', '', '',
     9666   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9667   run fltfield-add in this-procedure('d-pcnt', '', '',
     9668   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9669   run fltfield-add in this-procedure('category', 'Категория', '',
     9670   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9671   run fltfield-add in this-procedure('emitent-host-code', '', '',
     9672   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9673   run fltfield-add in this-procedure('issue-code', '', '',
     9674   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9675   run fltfield-add in this-procedure('issue-date', '', '',
     9676   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9677   run fltfield-add in this-procedure('valid-date', 'Действ.до', '',
     9678   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9679   run fltfield-add in this-procedure('status_', 'Статус', '',
     9680   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9681   run fltfield-add in this-procedure('type', 'Тип карты', '',
     9682   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9683   run fltfield-add in this-procedure('credit-card', 'Кредитная', '',
     9684   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9685   run fltfield-add in this-procedure('sourced-card', 'К карте', '',
     9686   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9687   run fltfield-add in this-procedure('saldo-rubl', 'Сальдо рубли', '',
     9688   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9689   run fltfield-add in this-procedure('saldo-base', 'Сальдо баз_вал', '',
     9690   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9691   run fltfield-add in this-procedure('main-card', 'Основная', '',
     9692   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9693   run fltfield-add in this-procedure('is-subsid', 'Дополнительная', '',
     9694   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9695   run fltfield-add in this-procedure('first-card', 'Первичная', '',
     9696   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9697   run fltfield-add in this-procedure('first-main-card', 'Первичная основная', '',
     9698   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9699   run fltfield-add in this-procedure('sourced-card', 'Перевыпущена к', '',
     9700   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9701   run fltfield-add in this-procedure('overissue-num', 'Порядок в цепочке перевыпуска', '',
     9702   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9703   run gbl/filter.w ( input parparentproc
     9704                     ,input c-point
     9705                     ,input tbl
     9706                     ,input join-tbl
     9707                     ,input fld
     9708                     ,input lab
     9709                     ,input spr
     9710                     ,input dim).
     9711   run gbl/flt-get.p (
     9712                   input  c-point
     9713                   ,output v-flt-rec
     9714                   ,output v-filter-name
     9715                   ,output where-phrase
     9716                   ,output sort-phrase
     9717                   ,output where-phrase-rus
     9718                   ,output sort-phrase-rus  ).
     9719   if v-flt-rec = ? then do:
     9720     run MyENable in this-procedure .
     9721     return error.
     9722   end.
     9723   else do:
     9724     find ubflt.filter where recid (ubflt.filter) = v-flt-rec no-lock.
     9725     run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     9726                                         , input-output v-seq
     9727                                         , input 0
     9728                                         , input '':U
     9729                                         , input substitute("Фильтр : &1 &2 &3", ubflt.filter.naim, ubflt.filter.where-ysl-rus, stat-line(rs-status))
     9730                                         , input tot-lns
     9731                                         , input rs-list-method
     9732                                         , input rs-status
     9733                                         , input ubflt.filter.where-ysl
     9734                                         , input '':U
     9735                                         , input ?
     9736                                         ).
     9737   end.
     9738   END PROCEDURE.
     9739   PROCEDURE write-hist :
     9740   define input parameter p-from-macro as logical no-undo .
     9741   define input parameter rs-list-method as character no-undo .
     9742   define input parameter rs-status as character no-undo .
     9743   define input parameter line-mode as character no-undo .
     9744   define variable v-ii as integer no-undo .
     9745   define variable v-temp-seq as integer no-undo .
     9746   if rs-list-method = "single" then do:
     9747     if v-no-hist < 0 then do:
     9748       run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     9749                                           , input-output v-seq
     9750                                           , input 0
     9751                                           , input get-hist-mode(line-mode)
     9752                                           , input substitute("КАРТА &1 &2&3", dc-list.d-card, dc-list.cli-type, dc-list.cli-code)
     9753                                           , input tot-lns
     9754                                           , input rs-list-method
     9755                                           , input rs-status
     9756                                           , input ('dis-card':U + chr(3) + string(dc-list.d-card))
     9757                                           , input '':U
     9758                                           , input ?
     9759                                           ).
     9760     end.
     9761     else do:
     9762       v-temp-seq = v-seq - 1.
     9763       do v-ii = 0 to v-no-hist:
     9764         run create-dc-list-hist in this-procedure(input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     9765                                             , input-output v-temp-seq
     9766                                             , input v-ii
     9767                                             , input get-hist-mode(line-mode)
     9768                                             , input substitute("КАРТА &1 &2&3", dc-list.d-card, dc-list.cli-type, dc-list.cli-code)
     9769                                             , input tot-lns
     9770                                             , input '':U
     9771                                             , input '':U
     9772                                             , input ('dis-card':U + chr(3) + string(dc-list.d-card))
     9773                                             , input '':U
     9774                                             , input ?
     9775                                             ).
     9776       end.
     9777     end.
     9778   end.
     9779   else do:
     9780     v-temp-seq = v-seq - 1.
     9781     do v-ii = 0 to v-no-hist:
     9782       run create-dc-list-hist in this-procedure(input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     9783                                           , input-output  v-temp-seq
     9784                                           , input v-ii
     9785                                           , input get-hist-mode(line-mode)
     9786                                           , input '':U
     9787                                           , input tot-lns
     9788                                           , input rs-list-method
     9789                                           , input '':U
     9790                                           , input '':U
     9791                                           , input '':U
     9792                                           , input ?
     9793                                           ).
     9794     end.
     9795   end.
     9796   END PROCEDURE.
     9797   FUNCTION get-num-chk RETURNS CHARACTER
     9798     ( buffer loc-dis-card for dc-list ) :
     9799   DEFINE VARIABLE var-cli-name as character no-undo .
     9800   define buffer loc-clients for ub.clients.
     9801   FIND loc-clients WHERE
     9802        loc-clients.obj-type = loc-dis-card.cli-type AND
     9803        loc-clients.obj-code = loc-dis-card.cli-code NO-LOCK .
     9804   if avail loc-clients then
     9805   var-cli-name = loc-clients.obj-name .
     9806   RETURN var-cli-name.
     9807   END FUNCTION.
     9808   FUNCTION stat-line RETURNS CHARACTER
     9809     ( input p-status-chr as character ) :
     9810   DEFINE VARIABLE var-stat-line as character no-undo .
     9811   CASE p-status-chr:
     9812     when 'все':U then do:
     9813       assign
     9814       var-stat-line = "(текущие, удаленные и блокированные карты)"
     9815       .
     9816     end.
     9817     when 'тек':U then do:
     9818       assign
     9819       var-stat-line = "(текущие карты)"
     9820       .
     9821     end.
     9822     when 'удал':U then do:
     9823       assign
     9824       var-stat-line = "(удаленные карты)"
     9825       .
     9826     end.
     9827     when 'блок':U then do:
     9828       assign
     9829       var-stat-line = "(блокированные карты)"
     9830       .
     9831     end.
     9832   END CASE.
     9833   return var-stat-line .
     9834   END FUNCTION.
