     3004     mBatchMode = mFramBachModHandle:visible ne yes.
     3005     mFramBachModHandle:visible = mFameOldVis.
     3006     current-window:visible = mVisCUrentVin.
     3007   end.
     3008    if  log-manager:logfile-name ne ?
     3009     then DO:
     3010         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     3011         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     3012         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     3013     end.
