     2637      define input  parameter p-user-id         as character no-undo .
     2638      define input  parameter p-host-code-obj   as integer   no-undo .
     2639      define input  parameter p-obj-type        as character no-undo .
     2640      define input  parameter p-obj-code        as integer   no-undo .
     2641      define output parameter p-user-select     as logical   no-undo .
     2642      define output parameter p-select-obj-type as character no-undo .
     2643      define output parameter p-select-obj-code as character no-undo .
     2644     do
     2645     on error undo, return error return-value
     2646     :
     2647       run gbl/userobjs.w
     2648         (input  parparentproc
     2649         ,input  this-procedure :handle
     2650         ,input  p-db-num
     2651         ,input  p-user-id
     2652         ,input  p-host-code-obj
     2653         ,input  p-obj-type
     2654         ,input  p-obj-code
     2655         ,INPUT  "b-sel"
