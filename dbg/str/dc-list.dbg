     3353                                                      then (chr(4) +  'СПН':U)
     3354                                                      else (if g#esys
     3355                                                            then (chr(4) +  'ВС':U)
     3356                                                            else g#userid
     3357                                                            )
     3358                                                      )
     3359         buf_c-dis-card-property.corr-date          = (if p-corr-date = ?
     3360                                                       then v-date
     3361                                                       else p-corr-date)
     3362         .
     3363         run gen-key-rec in this-procedure (
     3364                                             input 'dis-card-property':U
     3365                                           ,input buffer buf_dis-card-property:handle
     3366                                           ,output v-uniq-key-rec).
     3367       end.
     3368       if p-chip-num = 0   then do:
     3369         create buf_c-dc-hist.
     3370         buffer-copy buf_c-dis-card-property to buf_c-dc-hist
     3371         assign
     3372         buf_c-dc-hist.action =  p-action
     3373         buf_c-dc-hist.subject = 'dis-card-property':U
     3374         buf_c-dc-hist.is-news = g#news
     3375         buf_c-dc-hist.source-type = p-source-type
     3376         buf_c-dc-hist.source-ref = p-source-ref
     3377         buf_c-dc-hist.uniq-key-rec = v-uniq-key-rec
     3378         .
     3379       end.
     3380       assign
     3381       p-chip-num = buf_c-dis-card-property.chip-num
     3382       p-corr-date = buf_c-dis-card-property.corr-date
     3383       p-corr-time = buf_c-dis-card-property.corr-time
     3384       .
     3385       run disproph_send-nws in this-procedure (
     3386                                                 buffer buf_c-dis-card-property
     3387                                                ,buffer buf_c-dc-hist
     3388                                                ,buffer buf_dis-card
     3389                                                 ).
     3390       end.
     3391     end.
     3392   end procedure.
     3393   procedure disproph_send-nws :
     3394   define parameter buffer buf_c-dis-card-property for ub.c-dis-card-property.
     3395   define parameter buffer buf_c-dc-hist for ub.c-dc-hist.
     3396   define parameter buffer buf_Dis-card for ub.dis-card.
     3397   define variable v-dh-hn as integer no-undo .
     3398   main-block:
     3399   do
     3400   on error undo, return error return-value
     3401   :
     3402     if g#news
     3403     and g#db-num > 0
     3404     and buf_c-dis-card-property.corr-user-db-num <> g#db-num
     3405     then return.
     3406     if g#db-num = 0
     3407     or (g#news
     3408         and g#db-num > 0
     3409         and buf_c-dis-card-property.corr-user-name = (chr(4) +  'СПН':U)
     3410         )
     3411     then do:
     3412       if not available buf_dis-card then do:
     3413         find first buf_dis-card no-lock where
     3414                   buf_Dis-card.d-card = buf_c-dis-card-property.d-card no-error.
     3415       end.
     3416       if not available buf_dis-card then do:
     3417         assign
     3418         v-dh-hn = integer('0':U).
     3419       end.
     3420       else do:
     3421   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3422   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
     3423     (input  g#db-num
     3424     ,input  'dis-card-property':U
     3425     ,input  0
     3426     ,input  '':U
     3427     ,input  0
     3428     ,input  buf_dis-card.type
     3429     ,input  '':U
     3430     ,input  '':U
     3431     ,input  buf_dis-card.emitent-host-code
     3432     ,input  (if buf_c-dis-card-property.dt-code > 0 then 0 else -1)
     3433     ,input  0
     3434     ,input  'hist-to-nws'
     3435     ,output v-dh-hn
     3436     ) no-error .
     3437       end.
     3438       if v-dh-hn >= 0 then do:
     3439         run str/callnews.p (
     3440           input 'c-dis-card-property':U
     3441           ,input (buffer buf_c-dis-card-property:handle)
     3442           ) no-error .
     3443         if error-status:error then do:
     3444           undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
     3445         end.
     3446         if available buf_c-dc-hist then do:
     3447           run str/callnews.p (
     3448             input 'c-dc-hist':U
     3449             ,input (buffer buf_c-dc-hist:handle)
     3450             ) no-error .
     3451           if error-status:error then do:
     3452             undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
     3453           end.
     3454         end.
     3455       end.
     3456     end.
     3457   end.
     3458   end procedure.
     3459   procedure discprop-node-code :
     3460   define input parameter p-dtm-code as integer no-undo .
     3461   define input parameter p-node-code as integer no-undo .
     3462   define output parameter p-data-type as character no-undo .
     3463   define output parameter p-format as character no-undo .
     3464   define output parameter p-label as character no-undo .
     3465   define output parameter p-range as integer no-undo .
     3466   define output parameter p-rw-option as character no-undo .
     3467   define buffer buf_prop-map for ub.prop-map.
     3468   define buffer buf_prop-head for ub.prop-head.
     3469   do
     3470   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3471   :
     3472   find first buf_prop-head no-lock where
     3473             buf_prop-head.dtm-code = p-dtm-code no-error .
     3474   if available buf_prop-head then do:
     3475     if p-node-code > 0 then do:
     3476       find first buf_prop-map no-lock where
     3477                 buf_prop-map.dtm-code = p-dtm-code
     3478             and buf_prop-map.node-code = p-node-code no-error .
     3479       if available buf_prop-map then do:
     3480         assign
     3481         p-data-type = buf_prop-map.node-value-type
     3482         p-format = buf_prop-map.node-format
     3483         p-label = buf_prop-map.node-label
     3484         p-rw-option = buf_prop-map.rw-option
     3485         .
     3486       end.
     3487     end.
     3488     if buf_prop-head.storage-place  = "":U
     3489     and buf_prop-head.storage-place-host  > "":U
     3490     and buf_prop-head.storage-place-obj  > "":U then do:
     3491       p-range =  12.
     3492     end.
     3493     if buf_prop-head.storage-place  > "":U
     3494     and buf_prop-head.storage-place-host  > "":U
     3495     and buf_prop-head.storage-place-obj  > "":U then do:
     3496       p-range =  3.
     3497     end.
     3498     if buf_prop-head.storage-place  > "":U
     3499     and buf_prop-head.storage-place-host  > "":U
     3500     and buf_prop-head.storage-place-obj  = "":U then do:
     3501       p-range =  2.
     3502     end.
     3503     if buf_prop-head.storage-place  = "":U
     3504     and buf_prop-head.storage-place-host  > "":U
     3505     and buf_prop-head.storage-place-obj  = "":U then do:
     3506       p-range =  1.
     3507     end.
     3508     if buf_prop-head.storage-place  > "":U
     3509     and buf_prop-head.storage-place-host  = "":U
     3510     and buf_prop-head.storage-place-obj  = "":U then do:
     3511       p-range =  0.
     3512     end.
     3513   end.
     3514   end.
     3515   end procedure.
     3516   procedure discprop-initial:
     3517   define input parameter p-dtm-code as integer no-undo .
     3518   define input parameter p-node-code as integer no-undo .
     3519   define output parameter p-init-value-character as character no-undo .
     3520   define output parameter p-init-value-date as date no-undo .
     3521   define output parameter p-init-value-decimal as decimal no-undo .
     3522   define output parameter p-init-value-integer as integer no-undo .
     3523   define output parameter p-init-value-logical as logical no-undo .
     3524   define buffer buf_prop-map for ub.prop-map.
     3525   find first buf_prop-map no-lock where
     3526             buf_prop-map.dtm-code = p-dtm-code
     3527         and buf_prop-map.node-code = p-node-code no-error.
     3528   if not available buf_prop-map then return error substitute("Не найдено свойство &1 для объекта &2"
     3529                                                               , p-node-code
     3530                                                               , p-dtm-code).
     3531   assign
     3532   p-init-value-character = buf_prop-map.init-value-character
     3533   p-init-value-date = buf_prop-map.init-value-date
     3534   p-init-value-decimal = buf_prop-map.init-value-decimal
     3535   p-init-value-integer = buf_prop-map.init-value-integer
     3536   p-init-value-logical = buf_prop-map.init-value-logical
     3537   .
     3538   end procedure.
     3539   Function discprop-usercanedit returns logical (  input p-dtm-code as integer, input p-db-num as integer):
     3540   define buffer buf_attr-prop for ub.attr-prop.
     3541   find first buf_attr-prop no-lock where
     3542             buf_attr-prop.table-name = 'dis-card-property':U
     3543         and buf_attr-prop.templ-rl-root = p-dtm-code
     3544         and buf_attr-prop.upper-prop-code = "UserCanEdit"
     3545         and buf_attr-prop.prop-code = (if p-db-num = 0 then 'DB0' else 'DBR':U) no-error.
     3546   if not available buf_attr-prop
     3547   or logical(buf_attr-prop.property-value) = no then do:
     3548     return no.
     3549   end.
     3550   return yes.
     3551   end function.
     3552   procedure discprop-edit :
     3553   define input parameter p-dtm-code-node-name as character no-undo .
     3554   define output parameter p-edit-menu-section-num as integer no-undo .
     3555   define buffer buf_attr-prop for ub.attr-prop.
     3556   do
     3557   on error undo, return error return-value
     3558   :
     3559     find first buf_attr-prop no-lock where
     3560             buf_attr-prop.table-name = 'dis-card-property':U
     3561        and  buf_attr-prop.templ-rl-root = integer(entry(1, p-dtm-code-node-name, chr(4)))
     3562        and  buf_attr-prop.upper-prop-code = "ManualEdit":U
     3563        and  buf_attr-prop.prop-code = "SectionNum":U no-error .
     3564     if available buf_attr-prop then do:
     3565       assign
     3566       p-edit-menu-section-num = integer(buf_attr-prop.property-value).
     3567     end.
     3568   end.
     3569   end procedure.
     3570   procedure discprop-node-name :
     3571   define input parameter p-dtm-code-node-name as character no-undo .
     3572   define output parameter p-tool-tip as character no-undo .
     3573   define output parameter p-node-label as character no-undo .
     3574   define buffer buf_prop-map for ub.prop-map.
     3575   define buffer buf_prop-head for ub.prop-head.
     3576   do
     3577   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3578   :
     3579     find first buf_prop-head no-lock where
     3580               buf_prop-head.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) )) no-error .
     3581     assign
     3582     p-tool-tip   = if available buf_prop-head
     3583                    then buf_prop-head.prop-des
     3584                    else entry(1, p-dtm-code-node-name, chr(4) )
     3585     p-node-label = (if available buf_prop-head
     3586                     then buf_prop-head.prop-label
     3587                     else '':U)
     3588     .
     3589     if entry(2, p-dtm-code-node-name, chr(4) ) <> "" then do:
     3590       find first buf_prop-map no-lock where
     3591                 buf_prop-map.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) ))
     3592           and  buf_prop-map.node-code = integer(entry(2, p-dtm-code-node-name, chr(4) )) no-error.
     3593       if available buf_prop-map then do:
     3594         assign
     3595         p-tool-tip   = buf_prop-map.node-description
     3596         p-node-label = (if available buf_prop-head
     3597                         then buf_prop-head.prop-label
     3598                         else '':U) + ":" + buf_prop-map.node-label
     3599         .
     3600       end.
     3601     end.
     3602   end.
     3603   end procedure.
     3604   procedure discprop-write :
     3605   define input parameter p-d-card          like ub.dis-card-property.d-card     no-undo .
     3606   define input parameter p-host-code       like ub.dis-card-property.host-code  no-undo .
     3607   define input parameter p-obj-type        like ub.dis-card-property.obj-type   no-undo .
     3608   define input parameter p-obj-code        like ub.dis-card-property.obj-code   no-undo .
     3609   define input parameter p-dtm-code        like ub.dis-card-property.dtm-code   no-undo .
     3610   define input parameter p-node-code       like ub.dis-card-property.node-code  no-undo .
     3611   define input parameter p-dt-code         like ub.dis-card-property.dt-code    no-undo .
     3612   define input parameter p-sum-id          like ub.dis-card-property.sum-id     no-undo .
     3613   define input parameter p-value-character like ub.dis-card-property.property-value-character no-undo .
     3614   define input parameter p-value-date      like ub.dis-card-property.property-value-date no-undo .
     3615   define input parameter p-value-decimal   like ub.dis-card-property.property-value-decimal no-undo .
     3616   define input parameter p-value-integer   like ub.dis-card-property.property-value-integer no-undo .
     3617   define input parameter p-value-logical   like ub.dis-card-property.property-value-logical no-undo .
     3618   define input parameter p-source-type     as character no-undo .
     3619   define input parameter p-source-ref      as character no-undo .
     3620   define input-output parameter p-chip-num as integer no-undo .
     3621   define input-output parameter p-corr-date as date no-undo .
     3622   define input-output parameter p-corr-time as integer no-undo .
     3623   do
     3624   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3625   :
     3626     define buffer buf_dis-card-property for ub.dis-card-property .
     3627     define buffer buf_dis-card for ub.dis-card.
     3628     define buffer buf_prop-ref for ub.prop-ref.
     3629     define variable v-data-type      as character no-undo .
     3630     define variable v-data-type-1    as character no-undo .
     3631     define variable v-format         as character no-undo .
     3632     define variable v-label          as character no-undo .
     3633     define variable v-range          as integer   no-undo .
     3634     define variable v-rw-option      as character no-undo .
     3635     run discprop-node-code in this-procedure
     3636       (
     3637        input  p-dtm-code
     3638       ,input  p-node-code
     3639       ,output v-data-type
     3640       ,output v-format
     3641       ,output v-label
     3642       ,output v-range
     3643       ,output v-rw-option
     3644       ) no-error .
     3645     if error-status :error then do:
     3646       undo, return error return-value .
     3647     end.
     3648     v-data-type-1 = entry(1, v-data-type).
     3649     if p-dt-code = ? then do:
     3650       find buf_prop-ref no-lock where
     3651           buf_prop-ref.dtm-code = p-dtm-code
     3652       and buf_prop-ref.sum-id = p-sum-id no-error.
     3653       if not available buf_prop-ref then do:
     3654         undo, return error substitute("Неопределен или неоднозначен ИТОГ/СРЕЗ для объекта-операнда &1 &2"
     3655                                       ,p-dtm-code
     3656                                       ,p-sum-id).
     3657       end.
     3658       assign
     3659       p-dt-code = buf_prop-ref.dt-code.
     3660     end.
     3661     if discprop-usercanedit ( input p-dtm-code, input g#db-num)  = no then do:
     3662       undo, return error "Нельзя редактировать свойство в данной БД".
     3663     end.
     3664     run discprop-check in this-procedure (
     3665                                             input v-range
     3666                                           ,input p-d-card
     3667                                           ,input p-host-code
     3668                                           ,input p-obj-type
     3669                                           ,input p-obj-code
     3670                                           ,input p-dtm-code
     3671                                           ,input p-node-code
     3672                                           ,input p-dt-code
     3673                                         ) no-error .
     3674     if error-status:error then undo,  return error return-value .
     3675     find first buf_dis-card-property exclusive-lock
     3676       where buf_dis-card-property.d-card    = p-d-card
     3677         and buf_dis-card-property.host-code = p-host-code
     3678         and buf_dis-card-property.obj-type  = p-obj-type
     3679         and buf_dis-card-property.obj-code  = p-obj-code
     3680         and buf_dis-card-property.dt-code = p-dt-code
     3681         and buf_dis-card-property.node-code = p-node-code
     3682       no-error .
     3683       find first buf_dis-card no-lock where
     3684                   buf_dis-card.d-card = p-d-card.
     3685     if not available buf_dis-card-property then do:
     3686       create buf_dis-card-property .
     3687       assign
     3688         buf_dis-card-property.d-card    = p-d-card
     3689         buf_dis-card-property.host-code = p-host-code
     3690         buf_dis-card-property.obj-type  = p-obj-type
     3691         buf_dis-card-property.obj-code  = p-obj-code
     3692         buf_dis-card-property.dt-code = p-dt-code
     3693         buf_dis-card-property.node-code = p-node-code
     3694         buf_dis-card-property.dtm-code = p-dtm-code
     3695         buf_dis-card-property.sum-id   = p-sum-id
     3696         buf_dis-card-property.card-num  = buf_dis-card.card-num
     3697         buf_dis-card-property.main-card  = buf_dis-card.main-card
     3698         buf_dis-card-property.first-card  = buf_dis-card.first-card
     3699         buf_dis-card-property.first-main-card  = buf_dis-card.first-main-card
     3700       .
     3701     end.
     3702     else do:
     3703       if (v-data-type-1 = 'character':U
     3704       and buf_dis-card-property.property-value-character = p-value-character)
     3705       or  (v-data-type-1 = 'date':U
     3706           and buf_dis-card-property.property-value-date = p-value-date)
     3707       or  (v-data-type-1 = 'decimal':U
     3708           and buf_dis-card-property.property-value-decimal = p-value-decimal)
     3709       or  (v-data-type-1 = 'integer':U
     3710           and buf_dis-card-property.property-value-integer = p-value-integer)
     3711       or  (v-data-type-1 = 'logical':U
     3712           and buf_dis-card-property.property-value-logical = p-value-logical)
     3713       then return.
     3714     end.
     3715     run disproph_write-dis-card-property-proc  in this-procedure (
     3716             buffer buf_dis-card-property
     3717             ,buffer Buf_dis-card
     3718             ,input p-d-card
     3719             ,input p-dt-code
     3720             ,input p-host-code
     3721             ,input p-obj-type
     3722             ,input p-obj-code
     3723             ,input p-dtm-code
     3724             ,input buf_dis-card.card-num
     3725             ,input buf_dis-card.main-card
     3726             ,input buf_dis-card.first-card
     3727             ,input buf_dis-card.first-main-card
     3728             ,input p-node-code
     3729             ,input (if new(buf_dis-card-property) then integer('1':U) else integer('2':U))
     3730             ,input p-source-type
     3731             ,input p-source-ref
     3732             ,input-output p-chip-num
     3733             ,input-output p-corr-date
     3734             ,input-output p-corr-time
     3735             ).
     3736     assign
     3737     buf_dis-card-property.property-value-character = (if v-data-type-1 = 'character':U
     3738                                                       then p-value-character
     3739                                                       else buf_dis-card-property.property-value-character)
     3740     buf_dis-card-property.property-value-date      = (if v-data-type-1 = 'date':U
     3741                                                       then p-value-date
     3742                                                       else buf_dis-card-property.property-value-date)
     3743     buf_dis-card-property.property-value-decimal   = (if v-data-type-1 = 'decimal':U
     3744                                                       then p-value-decimal
     3745                                                       else buf_dis-card-property.property-value-decimal)
     3746     buf_dis-card-property.property-value-integer   = (if v-data-type-1 = 'integer':U
     3747                                                       then p-value-integer
     3748                                                       else buf_dis-card-property.property-value-integer)
     3749     buf_dis-card-property.property-value-logical   = (if v-data-type-1 = 'logical':U
     3750                                                       then p-value-logical
     3751                                                       else buf_dis-card-property.property-value-logical)
     3752     buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U)
     3753     .
     3754     release buf_dis-card-property no-error .
     3755     if error-status:error then do:
     3756       return error return-value .
     3757     end.
     3758   end.
     3759   end procedure.
     3760   procedure discprop-delete :
     3761   define input parameter p-d-card    like ub.dis-card-property.d-card     no-undo .
     3762   define input parameter p-host-code like ub.dis-card-property.host-code  no-undo .
     3763   define input parameter p-obj-type  like ub.dis-card-property.obj-type   no-undo .
     3764   define input parameter p-obj-code  like ub.dis-card-property.obj-code   no-undo .
     3765   define input parameter p-dtm-code  like ub.dis-card-property.dtm-code   no-undo .
     3766   define input parameter p-node-code like ub.dis-card-property.node-code  no-undo .
     3767   define input parameter p-dt-code   like ub.dis-card-property.dt-code    no-undo .
     3768   define input parameter p-source-type as character no-undo .
     3769   define input parameter p-source-ref as character no-undo .
     3770   define output parameter p-deleted  as logical no-undo.
     3771   define input-output parameter p-chip-num as integer no-undo .
     3772   define input-output parameter p-corr-date as date no-undo .
     3773   define input-output parameter p-corr-time as integer no-undo .
     3774   do
     3775   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3776   :
     3777   define buffer buf_dis-card-property for ub.dis-card-property .
     3778   define buffer buf_dis-card for ub.dis-card.
     3779   define variable v-data-type      as character no-undo .
     3780   define variable v-format         as character no-undo .
     3781   define variable v-label          as character no-undo .
     3782   define variable v-range          as integer   no-undo .
     3783   define variable v-rw-option      as character   no-undo .
     3784     run discprop-node-code in this-procedure
     3785       (input  p-dtm-code
     3786       ,input  p-node-code
     3787       ,output v-data-type
     3788       ,output v-format
     3789       ,output v-label
     3790       ,output v-range
     3791       ,output v-rw-option
     3792       ) no-error .
     3793     if error-status :error then do:
     3794       undo, return error return-value .
     3795     end.
     3796     find first buf_dis-card-property exclusive-lock
     3797       where buf_dis-card-property.d-card    = p-d-card
     3798         and buf_dis-card-property.host-code = p-host-code
     3799         and buf_dis-card-property.obj-type  = p-obj-type
     3800         and buf_dis-card-property.obj-code  = p-obj-code
     3801         and buf_dis-card-property.dt-code = p-dt-code
     3802         and buf_dis-card-property.node-code = p-node-code
     3803       no-error NO-WAIT.
     3804     if not available buf_dis-card-property then do:
     3805       p-deleted = no.
     3806     end.
     3807     else do:
     3808       run disproph_write-dis-card-property-proc  in this-procedure (
     3809            buffer buf_dis-card-property
     3810           ,buffer buf_dis-card
     3811           ,input buf_dis-card-property.d-card
     3812           ,input buf_dis-card-property.dt-code
     3813           ,input buf_dis-card-property.host-code
     3814           ,input buf_dis-card-property.obj-type
     3815           ,input buf_dis-card-property.obj-code
     3816           ,input buf_dis-card-property.dtm-code
     3817           ,input buf_dis-card-property.card-num
     3818           ,input buf_dis-card-property.main-card
     3819           ,input buf_dis-card-property.first-card
     3820           ,input buf_dis-card-property.first-main-card
     3821           ,input buf_dis-card-property.node-code
     3822           ,input integer('99':U)
     3823           ,input p-source-type
     3824           ,input p-source-ref
     3825           ,input-output p-chip-num
     3826           ,input-output p-corr-date
     3827           ,input-output p-corr-time
     3828            ).
     3829       buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U).
     3830       delete buf_dis-card-property no-error .
     3831       if error-status:error then do:
     3832         return error return-value.
     3833       end.
     3834       p-deleted = yes.
     3835     end.
     3836   end.
     3837   end procedure.
     3838   procedure discprop-check :
     3839   define input parameter p-range  as integer no-undo .
     3840   define input parameter p-d-card like ub.dis-card-property.d-card no-undo .
     3841   define input parameter p-host-code like ub.dis-card-property.host-code no-undo .
     3842   define input parameter p-obj-type like ub.dis-card-property.obj-type no-undo .
     3843   define input parameter p-obj-code like ub.dis-card-property.obj-code no-undo .
     3844   define input parameter p-dtm-code like ub.dis-card-property.dtm-code no-undo .
     3845   define input parameter p-node-code like ub.dis-card-property.node-code no-undo .
     3846   define input parameter p-dt-code like ub.dis-card-property.dt-code no-undo .
     3847   define variable v-message as character no-undo .
     3848   define buffer buf_sysconf for ub.sysconf.
     3849   define buffer buf_clients for ub.clients.
     3850   define buffer buf_dis-card for ub.dis-card.
     3851   define buffer buf_attr-prop for ub.attr-prop.
     3852   do
     3853   on error undo, return error return-value
     3854   :
     3855     if p-host-code > 0 then do:
     3856       FIND FIRST buf_sysconf No-LOCK WHERE
     3857                 buf_sysconf.host-code = p-host-code No-ERROR.
     3858       IF NOT AVAIL buf_sysconf THEN DO:
     3859         v-message = substitute("Не найдена фирма &1", p-host-code).
     3860         RETURN ERROR v-message.
     3861       END.
     3862     end.
     3863     if p-obj-type <> "":U or
     3864         p-obj-code <> 0 then do:
     3865       find first buf_clients No-LOCK WHERE
     3866                 buf_clients.obj-type = p-obj-type AND
     3867                 buf_clients.obj-code = p-obj-code no-error .
     3868       if not available buf_clients then do:
     3869         v-message = substitute("Не найден объект &1&2", p-obj-type, p-obj-code).
     3870         RETURN ERROR v-message.
     3871       end.
     3872     end.
     3873     else if NOT (p-obj-type = "":U and p-obj-code = 0) then do:
     3874       v-message = substitute("Неверные значения параметров p-obj-type/p-obj-code и/или p-host-code: &1&2 &3"
     3875                               , p-obj-type
     3876                               , p-obj-code
     3877                               , p-host-code).
     3878       RETURN ERROR v-message.
     3879     end.
     3880     if p-d-card <> "":U then do:
     3881       find first buf_dis-card No-LOCK WHERE
     3882                   buf_dis-card.d-card = p-d-card No-ERROR.
     3883       if not avail buf_dis-card then do:
     3884         v-message =substitute("Не найдена ДК").
     3885         return error  v-message.
     3886       end.
     3887       if buf_dis-card.emitent-host-code <> 0
     3888       and p-host-code <> buf_dis-card.emitent-host-code then do:
     3889         v-message = substitute("Для фирменной карты свойство можно ввести только с привязкой к фирме-эмитенту").
     3890         return error v-message.
     3891       end.
     3892       if buf_dis-card.emitent-host-code = 0
     3893       and p-range = 1
     3894       and p-host-code <> 0 then do:
     3895         v-message = substitute("Для свойство с ОБЛАСТЬЮ ДЕЙСТВИЯ СОГЛАСНО КОДУ ЭМИТЕНТА&1" +
     3896                               "для ГЛОБАЛЬНОЙ карты можно ввести только ГЛОБАЛЬНОЕ свойство"
     3897                                 , chr(10)
     3898                               ).
     3899         return error v-message.
     3900       end.
     3901     end.
     3902   end.
     3903   end procedure.
     3904   def var vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3905   define buffer l-dc-list for dc-list.
