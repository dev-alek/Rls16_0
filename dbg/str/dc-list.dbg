     8463           run Myenable  in this-procedure .
     8464           return error.
     8465         end.
     8466         system-dialog get-file f-name
     8467           filters "Списки клиентов *.cli" "*.cli"
     8468           title "Выберите файл списка"
     8469           INITIAL-DIR "."
     8470           return-to-start-dir
     8471           must-exist
     8472           update glog
     8473           default-extension "cli".
     8474         if not glog then do:
     8475           run MYenable  in this-procedure .
     8476           return error.
     8477         end.
     8478         run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8479                                             , input-output v-seq
     8480                                             , input 0
     8481                                             , input '':U
     8482                                             , input substitute("Карты клиентов из списка: &1 &2", f-name, stat-line(rs-status))
     8483                                             , input tot-lns
     8484                                             , input rs-list-method
     8485                                             , input rs-status
     8486                                             , input f-name
     8487                                             , input '':U
     8488                                             , input ?
     8489                                             ).
