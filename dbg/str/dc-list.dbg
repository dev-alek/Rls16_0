     2717   FUNCTION dct-algo-Date-to-String returns character(input  p-date as date):
     2718   define variable v-date-str as character no-undo .
     2719   assign
     2720   v-date-str = string(YEAR(p-date), "9999":U) + chr(47) +
     2721                string(Month(p-date), "99":U) + chr(47) +
     2722                string(DAY(p-date), "99":U).
     2723   return v-date-str.
     2724   END FUNCTION.
     2725   function dct-algo-string-to-date returns date ( input p-string  as character):
     2726     define variable v-date as date no-undo .
     2727     assign
     2728     v-date = date(integer(substring(p-string, 6, 2))
     2729                   ,integer(substring(p-string, 9, 2))
     2730                   ,integer(substring(p-string, 1, 4))
     2731                  ) no-error .
     2732     if error-status:error then return ?.
     2733     return v-date.
     2734   END FUNCTION.
     2735   FUNCTION dct-algo-get-sum-id-from-DT-CODE returns character ( input p-DT-CODE as integer):
     2736   define buffer buf_prop-ref for ub.prop-ref.
     2737   find first buf_prop-ref no-lock where
     2738             buf_prop-ref.DT-CODE = p-DT-CODE no-error.
     2739   if not available buf_prop-ref then do:
     2740     return chr(63).
     2741   end.
     2742   return buf_prop-ref.sum-id.
     2743   END FUNCTION.
     2744   FUNCTION dct-algo-get-description-sum-id returns character ( input p-dt-code as integer):
     2745   define variable v-des as character no-undo .
     2746   define buffer buf_prop-ref for ub.prop-ref.
     2747   define buffer buf_prop-head for ub.prop-head.
     2748   find first buf_prop-ref no-lock where
     2749             buf_prop-ref.dt-code = p-dt-code no-error.
     2750   if not available buf_prop-ref then do:
     2751     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
     2752   end.
     2753   find first buf_prop-head no-lock where
     2754           buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error.
     2755   if not available buf_prop-head then do:
     2756     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, buf_prop-ref.dtm-code).
     2757   end.
     2758   assign
     2759   v-des = substitute("&1  &2 &3"
     2760                     , buf_prop-head.prop-name
     2761                     , buf_prop-ref.sum-id
     2762                     , buf_prop-ref.caller_id).
     2763   return v-des.
     2764   end FUNCTION.
     2765   FUNCTION dct-algo-get-description-node-code returns character ( input p-dtm-code as integer
     2766                                                               ,input p-dt-code as integer
     2767                                                               ,input p-node-code as integer
     2768                                                               ):
     2769   define variable v-des as character no-undo .
     2770   define buffer buf_prop-ref for ub.prop-ref.
     2771   define buffer buf_prop-head for ub.prop-head.
     2772   define buffer buf_prop-map for ub.prop-map.
     2773   find first buf_prop-ref no-lock where
     2774             buf_prop-ref.dt-code = p-dt-code no-error.
     2775   if not available buf_prop-ref then do:
     2776     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
     2777   end.
     2778   find first buf_prop-head no-lock where
     2779           buf_prop-head.dtm-code = p-dtm-code no-error.
     2780   if not available buf_prop-head then do:
     2781     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, p-dtm-code).
     2782   end.
     2783   find first buf_prop-map no-lock where
     2784           buf_prop-map.dtm-code = p-dtm-code
     2785       and buf_prop-map.node-code = p-node-code no-error .
     2786   if not available buf_prop-map then do:
     2787     return substitute("Срез/итог по ДК &1, &2.&3 - неизвестно"
     2788                       , p-dt-code
     2789                       , buf_prop-head.prop-label
     2790                       , p-node-code).
     2791   end.
     2792   assign
     2793   v-des = substitute("&1.&2 &3 &4"
     2794                     , buf_prop-head.prop-label
     2795                     , buf_prop-map.node-label
     2796                     , buf_prop-ref.sum-id
     2797                     , buf_prop-ref.caller_id).
     2798   return v-des.
     2799   end FUNCTION.
     2800   function dct-algo-get-prev-sum-id RETURNS integer (
     2801                                                       input p-dt-code as integer
     2802                                                      ):
     2803   define variable v-dtm-code as integer no-undo .
     2804   define variable v-sum-id as character no-undo .
     2805   define variable v-caller-id as character no-undo .
     2806   define buffer buf_prop-ref for ub.prop-ref.
     2807   find first buf_prop-ref no-lock where
     2808           buf_prop-ref.dt-code = p-dt-code no-error.
     2809   if not available buf_prop-ref then return ?.
     2810   assign
     2811   v-dtm-code = buf_prop-ref.dtm-code
     2812   v-sum-id = buf_prop-ref.sum-id.
     2813   v-caller-id = buf_prop-ref.caller_id.
     2814   find last buf_prop-ref no-lock where
     2815             buf_prop-ref.dtm-code = v-dtm-code
     2816        and  buf_prop-ref.sum-id < v-sum-id
     2817        and  buf_prop-ref.caller_id = v-caller-id
     2818        no-error.
     2819   if available buf_prop-ref then return buf_prop-ref.dt-code.
     2820   return -1 .
     2821   END FUNCTION.
     2822   FUNCTION dct-algo-get_dcproperty-value returns logical (
     2823                                                             input p-prop-name as character
     2824                                                           , input p-d-card    as character
     2825                                                           , input p-host-code as integer
     2826                                                           , input p-obj-type  as character
     2827                                                           , input p-obj-code  as integer
     2828                                                           , output p-value-character as character
     2829                                                           , output p-value-date   as date
     2830                                                           , output p-value-integer as integer
     2831                                                           , output p-value-decimal as decimal
     2832                                                           , output p-value-logical as logical):
     2833     return no.
     2834   END FUNCTION.
     2835   FUNCTION dct-algo-get_dcproperty-value-chr returns logical (
     2836                                                             input p-d-card    as character
     2837                                                           , input p-emitent-host-code as integer
     2838                                                           , input p-type as character
     2839                                                           , input p-host-code as integer
     2840                                                           , input p-obj-type  as character
     2841                                                           , input p-obj-code  as integer
     2842                                                           , output p-value-chr as character):
     2843   define variable v-dt-code as integer no-undo .
     2844   define variable v-node-code as integer no-undo .
     2845   define variable v-field-name as character no-undo .
     2846   define variable v-storage-place as character no-undo .
     2847   define variable v-sum-id-value as character no-undo .
     2848   define variable v-sum-id-output as logical no-undo .
     2849   define variable v-value-chr as character no-undo .
     2850   define variable v-ii as integer no-undo .
     2851   define buffer buf_dis-card-property for ub.dis-card-property.
     2852   define buffer buf_dis-host for ub.dis-host.
     2853   define buffer buf_dis-obj for ub.dis-obj.
     2854   run get-cd-sumid in this-procedure (
     2855                                         input p-emitent-host-code
     2856                                        ,input p-type
     2857                                        ,input p-host-code
     2858                                        ,input p-obj-type
     2859                                        ,input p-obj-code
     2860                                        ,output v-sum-id-value
     2861                                        ,output v-sum-id-output
     2862                                       ) no-error.
     2863   if not v-sum-id-output then do:
     2864     return no.
     2865   end.
     2866   do v-ii = 1 to num-entries(v-sum-id-value):
     2867     assign
     2868     v-storage-place = entry(1, entry(v-ii, v-sum-id-value), chr(4))
     2869     v-dt-code = integer(entry(2, entry(v-ii, v-sum-id-value), chr(4)))
     2870     v-node-code = integer(entry(3, entry(v-ii, v-sum-id-value), chr(4)))
     2871     v-field-name = entry(4, entry(v-ii, v-sum-id-value), chr(4))
     2872     no-error .
     2873     if not error-status:error then do:
     2874       case v-storage-place:
     2875         when 'dis-card-property':U then do:
     2876           find first buf_dis-card-property no-lock where
     2877                     buf_dis-card-property.d-card = p-d-card
     2878               and  buf_dis-card-property.host-code = p-host-code
     2879               and  buf_dis-card-property.obj-type = p-obj-type
     2880               and  buf_dis-card-property.obj-code = p-obj-code
     2881               and  buf_dis-card-property.dt-code = v-dt-code
     2882               and  buf_dis-card-property.node-code = v-node-code no-error .
     2883           if available buf_dis-card-property then do:
     2884             v-value-chr = buffer buf_dis-card-property:handle:buffer-field(v-field-name):string-value.
     2885           end.
     2886           else do:
     2887             v-value-chr = chr(63).
     2888           end.
     2889         end.
     2890         when 'dis-obj':U then do:
     2891           find first buf_dis-obj no-lock where
     2892                     buf_dis-obj.d-card = p-d-card
     2893               and  buf_dis-obj.obj-type = p-obj-type
     2894               and  buf_dis-obj.obj-code = p-obj-code
     2895               and  buf_dis-obj.dt-code = v-dt-code no-error .
     2896           if available buf_dis-obj then do:
     2897             v-value-chr = buffer buf_dis-obj:handle:buffer-field(v-field-name):string-value.
     2898           end.
     2899           else do:
     2900             v-value-chr = chr(63).
     2901           end.
     2902         end.
     2903         when 'dis-host':U then do:
     2904           find first buf_dis-host no-lock where
     2905                     buf_dis-host.d-card = p-d-card
     2906               and  buf_dis-host.host-code = p-host-code
     2907               and  buf_dis-host.dt-code = v-dt-code no-error .
     2908           if available buf_dis-host then do:
     2909             v-value-chr = buffer buf_dis-host:handle:buffer-field(v-field-name):string-value.
     2910           end.
     2911           else do:
     2912             v-value-chr = chr(63).
     2913           end.
     2914         end.
     2915       end.
     2916     end.
     2917     p-value-chr = p-value-chr + (if v-ii = 1 then '':U else chr(44)) + v-value-chr.
     2918   end.
     2919   END FUNCTION.
     2920   FUNCTION dct-algo_custom-sent-description RETURNS CHARACTER
     2921     ( INPUT p-custom-sent as character ) :
     2922   DEFINE VARIABLE v-storage-place AS CHARACTER NO-UNDO.
     2923   DEFINE VARIABLE v-dtm-code AS integer NO-UNDO.
     2924   DEFINE VARIABLE v-sum-id AS character NO-UNDO.
     2925   DEFINE VARIABLE v-caller-id AS character NO-UNDO.
     2926   DEFINE VARIABLE v-node-code AS INTEGER NO-UNDO.
     2927   DEFINE VARIABLE v-sum-id-description AS CHARACTER.
     2928   DEFINE BUFFER buf_prop-ref FOR ub.prop-ref.
     2929   IF p-custom-sent = chr(63) THEN RETURN "Не отсылать".
     2930   assign
     2931   v-storage-place = entry(1, p-custom-sent, chr(4))
     2932   v-dtm-code = integer(entry(2, p-custom-sent, chr(4)))
     2933   v-sum-id   = entry(3, p-custom-sent, chr(4))
     2934   v-caller-id = entry(4, p-custom-sent, chr(4))
     2935   v-node-code = integer(entry(5, p-custom-sent, chr(4)))
     2936   no-error .
     2937   IF ERROR-STATUS:ERROR THEN DO:
     2938     MESSAGE
     2939     "Не могу разобрать строку, описывающую итог"
     2940      VIEW-AS ALERT-BOX WARNING.
     2941     RETURN chr(63).
     2942   END.
     2943   FIND FIRST buf_prop-ref NO-LOCK WHERE
     2944             buf_prop-ref.dtm-code = v-dtm-code
     2945        AND  buf_prop-ref.sum-id = v-sum-id
     2946        AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
     2947   IF NOT AVAILABLE buf_prop-ref THEN DO:
     2948     FIND FIRST buf_prop-ref NO-LOCK WHERE
     2949               buf_prop-ref.dtm-code = v-dtm-code
     2950         AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
     2951     IF NOT AVAILABLE buf_prop-ref THEN DO:
     2952         MESSAGE
     2953         "Не могу разобрать строку, описывающую итог"
     2954          VIEW-AS ALERT-BOX WARNING.
     2955         RETURN chr(63).
     2956      end.
     2957   end.
     2958   ASSIGN
     2959   v-sum-id-description =  dct-algo-get-description-node-code ( v-dtm-code
     2960                                                          ,buf_prop-ref.dt-code
     2961                                                          ,v-node-code).
     2962   RETURN v-sum-id-description.
     2963   END FUNCTION.
     2964   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2965   define variable v-waitfram-action01         as character   no-undo .
     2966   define variable v-waitfram-action02         as character   no-undo .
     2967   define variable v-waitfram-action03         as character   no-undo .
