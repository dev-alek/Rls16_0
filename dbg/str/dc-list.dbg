     3972   DEFINE MENU MENU-B-print
     3973          MENU-ITEM m_main-print   LABEL "Простой формат"
     3974          MENU-ITEM m_sel-print    LABEL "Выбор   полей" .
     3975   DEFINE MENU MENU-B-save
