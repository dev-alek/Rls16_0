     2988     B-viewProcInfo
     2989     B-WaitFramStop at row 4 col 30
     2990     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     2991     .
     2992   define new global shared variable mBatchMode as logical no-undo init ?.
     2993   define variable mFramBachModHandle as handle no-undo.
     2994   mFramBachModHandle = frame waitfram:handle.
     2995   define variable mFameOldVis as logical no-undo.
     2996   define variable mVisCUrentVin as logical no-undo.
     2997   if session:batch-mode
     2998   then
     2999      mBatchMode = yes.
     3000   if mBatchMode = ? then do:
     3001     mVisCUrentVin = current-window:visible.
     3002     mFameOldVis = mFramBachModHandle:visible.
