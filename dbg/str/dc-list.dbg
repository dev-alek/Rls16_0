     5000     define variable v-window-virtual-width as decimal   no-undo .
     5001     define variable v-change-sign          as integer   no-undo .
     5002     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     5003     define buffer buf_temp-browse-handle  for temp-browse-handle .
     5004     if p-change-value > 0
     5005     then do:
     5006       if frame Dialog-Frame :width + p-change-value >
     5007           session :width-chars
     5008       then do:
     5009         assign
     5010           p-change-value = session :width-chars - frame Dialog-Frame :width
     5011         .
     5012         if p-change-value <= 0
     5013         then do:
     5014           run diasize_position-resize-button in this-procedure .
     5015           return .
     5016         end.
     5017       end.
     5018     end.
     5019     if p-change-value < 0
     5020     then do:
     5021       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     5022       then do:
     5023         assign
     5024           p-change-value = v-diasize-orig-frame-width
     5025                          - frame Dialog-Frame :width
     5026         .
     5027         if p-change-value >= 0
     5028         then do:
     5029           run diasize_position-resize-button in this-procedure .
     5030           return .
     5031         end.
     5032       end.
     5033     end.
     5034     if p-change-value >= 0
     5035     then do:
     5036       assign
     5037         v-change-sign = 1
     5038       .
     5039     end.
     5040     else do:
     5041       assign
     5042         v-change-sign = -1
     5043       .
     5044     end.
     5045     assign
     5046       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     5047     .
     5048     if p-change-value = 0
     5049     then do:
     5050       run diasize_position-resize-button in this-procedure .
     5051       return .
     5052     end.
