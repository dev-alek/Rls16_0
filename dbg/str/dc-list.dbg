        1   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo .
        4   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
        5   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Автоматизированное формирование списка дисконтных карт".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   procedure proc-alt-shift-f2:
       82     if not ibs.th.gbl.gbl-var:rcode
       83   then
       84     run gbl\inidebug.p .
       85   end.
       86   procedure proc-alt-shift-f3:
       87     run gbl/prvssinf.p
       88       ( input this-procedure
       89       ) .
       90   end.
       91   define variable v-inform-launched as logical no-undo initial false .
       92   procedure proc-alt-shift-f4:
       93     define variable v-action as character no-undo .
       94     if v-inform-launched = false then do:
       95       assign
       96         v-inform-launched = true
       97       .
       98       run gbl/d-inform.w
       99         (  input self
      100         ,  input this-procedure
      101         , output v-action
      102         ) no-error .
      103       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      104       assign
      105         v-inform-launched = false
      106       .
      107     end.
      108   end.
      109   procedure proc-alt-f1:
      110     run gbl/corrhelp.p
      111       (input this-procedure
      112       ) .
      113   end .
      114   on alt-shift-f2 anywhere do:
      115     run proc-alt-shift-f2.
      116   end.
      117   on alt-shift-f3 anywhere do:
      118     run proc-alt-shift-f3 in this-procedure .
      119   end.
      120   on alt-shift-f4 anywhere do:
      121     run proc-alt-shift-f4 in this-procedure.
      122   end.
      123   on alt-f1 anywhere do:
      124     run proc-alt-f1 in this-procedure .
      125   end.
      126   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127   define shared temp-table dc-list no-undo like ub.dis-card
      128     field to-del as logical
      129     field order-num as integer
      130     field fdec as decimal
      131     field fint as integer
      132     field flog as logical
      133     field fchar as character
      134     index pi  is primary unique d-card
      135     index cn      card-num
      136     index cli cli-type cli-code
      137     index host-dscnt  emitent-host-code status_ d-pcnt
      138     index host-type  emitent-host-code type d-pcnt
      139     index oi order-num
      140     .
      141   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      142   define  shared  temp-table dc-list-hist no-undo
      143   field list-table as character
      144   field id as integer
      145   field line as integer
      146   field hist-mode as character
      147   field des as character
      148   field num-recs as integer
      149   field option_ as character
      150   field item_ as character
      151   field status_ as character
      152   field num-add as integer
      153   field num-ignored as integer
      154   field done as logical
      155   field err_ as logical
      156   field err-mes as character
      157   index pi is primary
      158   id
      159   line
      160   index isdone
      161   done
      162   .
      163   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      164     define variable v-cntxt-db-num        as integer   no-undo .
      165     define variable v-cntxt-userid        as character no-undo .
      166     define variable v-cntxt-level         as character no-undo .
      167     define variable v-cntxt-host-code-obj as integer   no-undo .
      168     define variable v-cntxt-obj-type      as character no-undo .
      169     define variable v-cntxt-obj-code      as integer   no-undo .
      170     define variable v-cntxt-db-num-obj    as integer   no-undo .
      171     define variable v-cntxt-is-admin      as logical   no-undo .
      172   define variable g#report-num as integer no-undo .
      173   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      174   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      175   procedure gen-key-rec :
      176     define input  parameter p-tbl-name    as character no-undo.
      177     define input  parameter p-bh_tbl-name as handle    no-undo.
      178     define output parameter p-key-rec     as character no-undo.
      179     do
      180     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      181     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      182     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      183     :
      184       define variable fh               as handle    no-undo .
      185       define variable v-ok             as logical   no-undo .
      186       define variable v-inform         as character no-undo .
      187       define variable v-ind            as integer   no-undo .
      188       define variable v-idx-field-qnty as integer   no-undo .
      189       if p-tbl-name = ?
      190         or p-tbl-name = "":U
      191       then do:
      192         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
      193       end.
      194       if not p-bh_tbl-name:available then do:
      195         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
      196       end.
      197       assign
      198         p-key-rec = p-tbl-name
      199         v-inform  = p-bh_tbl-name:index-information(1)
      200         v-ind     = 2
      201       .
      202       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      203       on error undo, return error
      204       :
      205         assign
      206           v-inform = p-bh_tbl-name:index-information( v-ind )
      207           v-ind    = v-ind + 1
      208         .
      209       end.
      210       if v-inform = ?
      211         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      212         or entry( 3, v-inform, ",":U ) <> "1":U
      213       then do:
      214         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
      215       end.
      216       else do:
      217         assign
      218           v-idx-field-qnty = num-entries( v-inform ) - 4
      219         .
      220         if v-idx-field-qnty < 2 then do:
      221           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
      222         end.
      223         do v-ind = 1 to v-idx-field-qnty by 2
      224         on error undo, return error
      225         :
      226           assign
      227             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      228             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      229           .
      230         end.
      231       end.
      232       if p-key-rec = ? then do:
      233         assign
      234           p-key-rec = "":U
      235         .
      236         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
      237       end.
      238     end.
      239     return.
      240   end procedure.
      241   procedure gen-where-keyr-tab :
      242     define input  parameter i-tableSerach as character no-undo.
      243     define input  parameter i-tablekey   as character  no-undo.
      244     define input  parameter p-key-rec    as character  no-undo.
      245     define input  parameter p-key-handle as handle     no-undo .
      246     define input  parameter p-db-name    as character  no-undo .
      247     define input  parameter p-tt-handle  as handle     no-undo .
      248     define output parameter o-Where      as character  no-undo.
      249     do
      250     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      251     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      252     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      253     :
      254       define variable v-full-tbl-name  as character no-undo .
      255       define variable bh_tbl-name      as handle    no-undo .
      256       define variable fh_key           as handle    no-undo .
      257       define variable fh_search        as handle    no-undo .
      258       define variable v-field-num      as integer   no-undo .
      259       define variable v-count-fld      as integer   no-undo .
      260       define variable v-inform         as character no-undo .
      261       define variable v-ind            as integer   no-undo .
      262       define variable v-idx-field-qnty as integer   no-undo .
      263       define variable v-field-name     as character no-undo .
      264       define variable v-field-val      as character no-undo .
      265       define variable v-word-link      as character no-undo .
      266       define variable vTable           as character no-undo.
      267       define variable bh_tbl-key       as handle    no-undo .
      268       assign
      269         p-key-rec = trim( p-key-rec )
      270       .
      271       if p-key-handle <> ? then do:
      272         if not valid-handle(p-key-handle)
      273            or p-key-handle:type <> "buffer"
      274         then do:
      275           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
      276         end.
      277         if num-entries( p-key-rec, chr(3) ) > 1
      278           or p-key-rec = ?
      279           or p-key-rec = "":U
      280         then do:
      281           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
      282         end.
      283       end.
      284       else do:
      285         if p-key-rec = ?
      286           or p-key-rec = "":U
      287         then do:
      288           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      289         end.
      290       end.
      291       assign
      292         vTable = entry( 1 , p-key-rec, chr(3) )
      293       .
      294       if p-tt-handle <> ?
      295         and ( not valid-handle(p-tt-handle)
      296               or p-tt-handle:type <> "buffer"
      297             )
      298       then do:
      299         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
      300       end.
      301       if p-tt-handle = ? then do:
      302         assign
      303           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      304         .
      305         create buffer bh_tbl-name for table v-full-tbl-name .
      306       end.
      307       else do:
      308         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      309       end.
      310       assign
      311         v-inform = bh_tbl-name:index-information(1)
      312         v-ind    = 2
      313       .
      314       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      315       on error undo, return error
      316       :
      317         assign
      318           v-inform = bh_tbl-name:index-information( v-ind )
      319           v-ind    = v-ind + 1
      320         .
      321       end.
      322       if v-inform = ?
      323         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      324         or entry( 3, v-inform, ",":U ) <> "1":U
      325       then do:
      326         delete object bh_tbl-name no-error.
      327         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
      328       end.
      329       assign
      330         v-idx-field-qnty = num-entries( v-inform ) - 4
      331       .
      332       if v-idx-field-qnty < 2 then do:
      333         delete object bh_tbl-name no-error.
      334         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
      335       end.
      336       assign
      337         o-where     = "where":U
      338         v-word-link = "":U
      339         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      340         v-count-fld = 0
      341       .
      342       if i-tablekey ne "" and i-tablekey ne ?
      343       then do:
      344         assign
      345           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      346         .
      347         create buffer bh_tbl-key for table v-full-tbl-name .
      348       end.
      349       if i-tableSerach ne "" and i-tableSerach ne ?
      350       then do:
      351         delete object bh_tbl-name no-error.
      352         assign
      353           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      354         .
      355         create buffer bh_tbl-name for table v-full-tbl-name .
      356       end.
      357       block_where:
      358       do v-ind = 1 to v-idx-field-qnty by 2
      359       on error undo, return error
      360       :
      361         assign
      362           v-count-fld = v-count-fld + 1
      363         .
      364         if p-key-handle = ?
      365           and v-count-fld > v-field-num
      366         then do:
      367           leave block_where.
      368         end.
      369         define variable VfieldKeyTable as handle no-undo.
      370         assign
      371           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      372           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      373         .
      374         if     bh_tbl-key ne ?
      375         then do:
      376            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      377            if VfieldKeyTable eq ?
      378            then next block_where.
      379         end.
      380         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      381         then
      382            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      383         else
      384            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      385         if p-key-handle = ? then do:
      386           assign
      387             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      388           .
      389         end.
      390         else do:
      391           assign
      392             fh_key = p-key-handle:buffer-field( v-field-name )
      393           .
      394           if fh_key = ?
      395             or not valid-handle( fh_key )
      396           then do:
      397             delete object bh_tbl-name.
      398             if     bh_tbl-key ne ?
      399             then
      400                delete object bh_tbl-key.
      401             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
      402           end.
      403           assign
      404             v-field-val = fh_key:buffer-value
      405           .
      406         end.
      407         if fh_search:data-type ="character":U then do:
      408           assign
      409             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      410             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      411             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      412             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      413             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      414             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      415             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      416             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      417             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      418             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      419             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      420             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      421             v-field-val = substitute( '"&1"', v-field-val )
      422           .
      423         end.
      424         assign
      425           o-where = substitute( "&1 &2", o-where, v-field-val )
      426         .
      427         if v-word-link = "":U then do:
      428           assign
      429             v-word-link = "and":U
      430           .
      431         end.
      432       end.
      433       delete object bh_tbl-name.
      434       if     bh_tbl-key ne ?
      435       then
      436          delete object bh_tbl-key.
      437       if p-key-handle = ?
      438         and v-count-fld <> v-field-num
      439       then do:
      440         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
      441       end.
      442     end.
      443   end procedure.
      444   procedure gen-hn-keyr-tab :
      445     define input  parameter i-tableSerach as character no-undo.
      446     define input  parameter i-tablekey   as character no-undo.
      447     define input  parameter p-key-rec    as character no-undo.
      448     define input  parameter p-key-handle as handle    no-undo .
      449     define input  parameter p-db-name    as character no-undo .
      450     define input  parameter p-tt-handle  as handle    no-undo .
      451     define input  parameter p-stts-lock  as integer   no-undo .
      452     define output parameter o-hn         as handle    no-undo.
      453     define variable v-full-tbl-name as character no-undo.
      454     define variable v-where         as character no-undo.
      455     define variable bh_tbl-name     as handle    no-undo.
      456     define variable vTable          as character no-undo.
      457     do
      458     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      459     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      460     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      461         run gen-where-keyr-tab(i-tableSerach,
      462                                i-tablekey,
      463                                p-key-rec,
      464                                p-key-handle,
      465                                p-db-name,
      466                                p-tt-handle,
      467                                output v-where).
      468         if i-tableSerach ne "" and i-tableSerach ne ?
      469         then do:
      470            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      471            create buffer bh_tbl-name for table v-full-tbl-name .
      472         end.
      473         else do:
      474            if p-tt-handle = ? then do:
      475               assign
      476                  vTable = entry( 1 , p-key-rec, chr(3) )
      477               .
      478               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      479               create buffer bh_tbl-name for table v-full-tbl-name .
      480            end.
      481            else do:
      482               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      483            end.
      484         end.
      485         if p-tt-handle = ? then do:
      486            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      487         end.
      488         else do:
      489            bh_tbl-name:find-first( v-where ) no-error .
      490         end.
      491         o-hn = bh_tbl-name.
      492      end.
      493   end procedure.
      494   procedure gen-hn-keyr :
      495     define input  parameter p-key-rec    as character no-undo.
      496     define input  parameter p-key-handle as handle    no-undo .
      497     define input  parameter p-db-name    as character no-undo .
      498     define input  parameter p-tt-handle  as handle    no-undo .
      499     define input  parameter p-stts-lock  as integer   no-undo .
      500     define output parameter o-hn         as handle    no-undo.
      501     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      502   end.
      503   procedure gen-row-keyr :
      504     define input  parameter p-key-rec    as character no-undo.
      505     define input  parameter p-key-handle as handle    no-undo .
      506     define input  parameter p-db-name    as character no-undo .
      507     define input  parameter p-tt-handle  as handle    no-undo .
      508     define input  parameter p-stts-lock  as integer   no-undo .
      509     define output parameter p-tbl-row    as rowid     no-undo.
      510     define output parameter p-tbl-name   as character no-undo.
      511     define variable vHn as handle no-undo.
      512       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      513       p-tbl-row = if vHn:available then vHn:rowid else ?.
      514       p-tbl-name =  vHn:table.
      515       delete object vHn no-error.
      516     if p-tbl-row = ? then do:
      517       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
      518     end.
      519     else do:
      520       return.
      521     end.
      522   end procedure.
      523   procedure gen-key-fv :
      524     define input  parameter p-key-rec    as character no-undo .
      525     define output parameter p-field-list as character no-undo .
      526     define output parameter p-value-list as character no-undo.
      527     do
      528     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      529     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      530     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      531     :
      532       define variable v-full-tbl-name  as character no-undo .
      533       define variable bh_tbl-name      as handle    no-undo .
      534       define variable v-tbl-name       as character no-undo .
      535       define variable v-field-num      as integer   no-undo .
      536       define variable v-count-fld      as integer   no-undo .
      537       define variable v-inform         as character no-undo .
      538       define variable v-ind            as integer   no-undo .
      539       define variable v-idx-field-qnty as integer   no-undo .
      540       define variable v-delim-key      as character no-undo .
      541       if p-key-rec = ?
      542         or p-key-rec = "":U
      543       then do:
      544         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      545       end.
      546       assign
      547         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      548         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      549       .
      550       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      551       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
      552       assign
      553         v-inform = bh_tbl-name:index-information(1)
      554         v-ind    = 2
      555       .
      556       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      557       on error undo, return error
      558       :
      559         assign
      560           v-inform = bh_tbl-name:index-information( v-ind )
      561           v-ind    = v-ind + 1
      562         .
      563       end.
      564       if v-inform = ?
      565         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      566         or entry( 3, v-inform, ",":U ) <> "1":U
      567       then do:
      568         delete object bh_tbl-name no-error.
      569         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      570       end.
      571       assign
      572         v-idx-field-qnty = num-entries( v-inform ) - 4
      573       .
      574       if v-idx-field-qnty < 2 then do:
      575         delete object bh_tbl-name no-error.
      576         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      577       end.
      578       assign
      579         p-field-list = "":U
      580         p-value-list = "":U
      581         v-delim-key  = "":U
      582         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      583         v-count-fld  = 0
      584       .
      585       block_where:
      586       do v-ind = 1 to v-idx-field-qnty by 2
      587       on error undo, return error
      588       :
      589         assign
      590           v-count-fld = v-count-fld + 1
      591         .
      592         if v-count-fld > v-field-num then do:
      593           leave block_where.
      594         end.
      595         assign
      596           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      597           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      598         .
      599         if v-ind = 1 then do:
      600           assign
      601             v-delim-key = chr(3)
      602           .
      603         end.
      604       end.
      605       delete object bh_tbl-name.
      606       if v-count-fld <> v-field-num then do:
      607         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
      608       end.
      609     end.
      610   end procedure.
      611   procedure gen-key-field :
      612     define input  parameter p-table      as character no-undo .
      613     define output parameter p-field-list as character no-undo .
      614     do
      615     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      616     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      617     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      618     :
      619       define variable v-full-tbl-name  as character no-undo .
      620       define variable bh_tbl-name      as handle    no-undo .
      621       define variable v-tbl-name       as character no-undo .
      622       define variable v-field-num      as integer   no-undo .
      623       define variable v-count-fld      as integer   no-undo .
      624       define variable v-inform         as character no-undo .
      625       define variable v-ind            as integer   no-undo .
      626       define variable v-idx-field-qnty as integer   no-undo .
      627       define variable v-delim-key      as character no-undo .
      628       if p-table = ?
      629         or p-table = "":U
      630       then do:
      631         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
      632       end.
      633       assign
      634         v-tbl-name      = p-table
      635         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      636       .
      637       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      638       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
      639       assign
      640         v-inform = bh_tbl-name:index-information(1)
      641         v-ind    = 2
      642       .
      643       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      644       on error undo, return error
      645       :
      646         assign
      647           v-inform = bh_tbl-name:index-information( v-ind )
      648           v-ind    = v-ind + 1
      649         .
      650       end.
      651       if v-inform = ?
      652         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      653         or entry( 3, v-inform, ",":U ) <> "1":U
      654       then do:
      655         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      656       end.
      657       assign
      658         v-idx-field-qnty = num-entries( v-inform ) - 4
      659       .
      660       if v-idx-field-qnty < 2 then do:
      661         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      662       end.
      663       assign
      664         p-field-list = "":U
      665         v-delim-key  = "":U
      666         v-count-fld  = 0
      667       .
      668       block_where:
      669       do v-ind = 1 to v-idx-field-qnty by 2
      670       on error undo, return error
      671       :
      672         assign
      673           v-count-fld = v-count-fld + 1
      674         .
      675         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      676         if v-ind = 1 then do:
      677           assign
      678             v-delim-key = chr(3)
      679           .
      680         end.
      681       end.
      682       delete object bh_tbl-name.
      683     end.
      684   end procedure.
      685   procedure create-dc-list-hist :
      686   define input parameter p-mode as character no-undo .
      687   define input-output parameter p-seq as integer no-undo .
      688   define input parameter p-line as integer no-undo .
      689   define variable p-list-table as character no-undo .
      690   define input parameter p-hist-mode as character no-undo .
      691   define input parameter p-des as character no-undo .
      692   define input parameter p-num-recs as integer no-undo .
      693   define input parameter p-option as character no-undo .
      694   define input parameter p-status_ as character no-undo .
      695   define input parameter p-item as character no-undo .
      696   define input parameter p-tbl-name as character no-undo .
      697   define input parameter p-bh_tbl-name as handle no-undo .
      698   define variable v-num-add as integer no-undo .
      699   define variable v-num-ignored as integer no-undo .
      700   define buffer buf_dc-list-hist for dc-list-hist.
      701     do
      702     on error undo, return error
      703     :
      704       CASE p-mode:
      705         when 'title' then do:
      706           find first buf_dc-list-hist where
      707                      buf_dc-list-hist.id = 0   no-error.
      708           if not available buf_dc-list-hist then do:
      709             create buf_dc-list-hist.
      710             assign
      711             buf_dc-list-hist.id = 0
      712             buf_dc-list-hist.line = 0
      713             buf_dc-list-hist.list-table = '':U
      714             .
      715           end.
      716           assign
      717           buf_dc-list-hist.des =  p-des
      718           buf_dc-list-hist.num-recs = p-num-recs
      719           buf_dc-list-hist.option_  = p-option
      720           buf_dc-list-hist.item_ = p-item
      721           .
      722         end.
      723         when 'ДОБАВЛЕНИЕ':U then do:
      724           if p-option begins 'single' then do:
      725             CASE p-hist-mode:
      726               when '+':U then do:
      727                 assign
      728                 v-num-add = 1
      729                 v-num-ignored  = 0
      730                 .
      731               end.
      732               when '-':U then do:
      733                 assign
      734                 v-num-add = 1
      735                 v-num-ignored  = 0
      736                 .
      737               end.
      738               when '*':U then do:
      739                 assign
      740                 v-num-add = p-num-recs - 1
      741                 p-num-recs = 1
      742                 v-num-ignored  = 0
      743                 .
      744               end.
      745             END CASE.
      746           end.
      747           create buf_dc-list-hist.
      748           assign
      749           buf_dc-list-hist.id = p-seq
      750           buf_dc-list-hist.list-table = p-list-table
      751            p-seq = (if p-line = 0 then (p-seq + 1) else p-seq)
      752           buf_dc-list-hist.des =  p-des
      753           buf_dc-list-hist.line = p-line
      754           buf_dc-list-hist.num-recs = p-num-recs
      755           buf_dc-list-hist.option_  = p-option
      756           buf_dc-list-hist.item_ = p-item
      757           buf_dc-list-hist.hist-mode =  p-hist-mode
      758           buf_dc-list-hist.status_ =  p-status_
      759           buf_dc-list-hist.num-add = v-num-add
      760           buf_dc-list-hist.num-ignored = v-num-ignored
      761           .
      762         end.
      763         when 'ИЗМЕНЕНИЕ':U + chr(4) + 'des' then do:
      764           find first buf_dc-list-hist where
      765                     buf_dc-list-hist.id = p-seq
      766                 and buf_dc-list-hist.line = p-line no-error .
      767           if  available buf_dc-list-hist then do:
      768             assign
      769             buf_dc-list-hist.des =  p-des
      770             buf_dc-list-hist.num-recs = p-num-recs
      771             buf_dc-list-hist.option_  = p-option
      772             buf_dc-list-hist.item_ = p-item
      773             buf_dc-list-hist.list-table = (if p-list-table <> '':U and p-list-table <> ?
      774                                        then p-list-table
      775                                        else buf_dc-list-hist.list-table)
      776             .
      777           end.
      778         end.
      779         when 'ИЗМЕНЕНИЕ':U + chr(4) + 'mode' then do:
      780           find first buf_dc-list-hist where
      781                     buf_dc-list-hist.id = p-seq
      782                 and buf_dc-list-hist.line = p-line  no-error .
      783           if available buf_dc-list-hist then do:
      784             assign
      785             buf_dc-list-hist.hist-mode =  p-hist-mode
      786             buf_dc-list-hist.num-recs  = (if buf_dc-list-hist.line = 0 then p-num-recs else buf_dc-list-hist.num-recs)
      787             buf_dc-list-hist.list-table = (if p-list-table <> '':U and p-list-table <> ?
      788                                        then p-list-table
      789                                        else buf_dc-list-hist.list-table)
      790             .
      791           end.
      792         end.
      793       END CASE.
      794       if p-tbl-name <> "":U
      795       and valid-handle(p-bh_tbl-name)
      796       then do:
      797         run gen-key-rec  in this-procedure (
      798                                               input  p-tbl-name
      799                                              ,input  p-bh_tbl-name
      800                                              ,output p-item) no-error .
      801         if not error-status:error then do:
      802           assign
      803           buf_dc-list-hist.item_ = p-item
      804           .
      805         end.
      806         else do:
      807           assign
      808           buf_dc-list-hist.item_ = "!ERROR"
      809           .
      810         end.
      811       end.
      812     end.
      813   end procedure.
      814   FUNCTION get-line-mode returns character(input p-hist-mode as character):
      815   case p-hist-mode:
      816     when '+':U then
      817       return  'ДОБАВЛЕНИЕ':U.
      818     when '-':U then
      819       return  'удаление':U.
      820     when '*':U then
      821       return  'ОСТАВИТЬ':U.
      822   end CASE.
      823   END FUNCTION.
      824   FUNCTION get-hist-mode returns character(input p-line-mode as character):
      825   case p-line-mode:
      826     when 'ДОБАВЛЕНИЕ':U then
      827       return  "+".
      828     when 'удаление':U then
      829       return  "-".
      830     when 'ОСТАВИТЬ':U then
      831       return  "*".
      832   end CASE.
      833   END FUNCTION.
      834   procedure proc-write-filter-expression :
      835   define input parameter p-filter-expression as character no-undo .
      836   define variable v-ii as integer no-undo .
      837   output to value(string(g#report-num) + ".whr").
      838   put .
      839   if num-entries(p-filter-expression) > 0 then do:
      840      put unformatted 'and ('.
      841      do v-ii = 1 to num-entries(p-filter-expression):
      842        put unformatted entry(v-ii, p-filter-expression) skip.
      843      end.
      844      put unformatted ')'.
      845   end.
      846   output close.
      847   end procedure.
      848   procedure proc-write-filter-expression-var :
      849   define input parameter p-filter-expression as character no-undo .
      850   define output parameter p-string as character no-undo .
      851   define variable v-ii as integer no-undo .
      852   if num-entries(p-filter-expression) > 0 then do:
      853      p-string = 'and ('.
      854      do v-ii = 1 to num-entries(p-filter-expression):
      855        p-string = p-string + entry(v-ii, p-filter-expression) + chr(10).
      856      end.
      857      p-string = p-string + ')'.
      858   end.
      859   end procedure.
      860   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      861   define variable c-point  as character no-undo .
      862   define variable tbl      as character no-undo .
      863   define variable join-tbl as character no-undo .
      864   define variable fld      as character no-undo .
      865   define variable lab      as character no-undo .
      866   define variable spr      as character no-undo .
      867   define variable dim      as character no-undo .
      868   function diff-list returns character (
      869     input parfirst-list  as character,
      870     input parsecond-list as character,
      871     input pardelim       as character).
      872     if pardelim = ""
      873     or pardelim = ?
      874     then do:
      875       assign
      876         pardelim = ","
      877       .
      878     end.
      879     def var ind as integer no-undo .
      880     def var v-elem as character no-undo .
      881     def var v-result-list as character no-undo init "".
      882     def var v-num-parfirst-list as integer no-undo .
      883     assign
      884       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      885     .
      886     do ind = 1 to v-num-parfirst-list
      887     :
      888       assign
      889         v-elem = entry(ind, parfirst-list, pardelim)
      890       .
      891       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      892         assign
      893           v-result-list = v-result-list
      894                         + (if v-result-list > "" then pardelim else "")
      895                         + v-elem
      896         .
      897       end.
      898     end.
      899     return v-result-list .
      900   end function.
      901   function add-list returns character (
      902    input parfirst-list  as character,
      903    input parsecond-list as character,
      904    input pardelim       as character).
      905     if pardelim = ""
      906     or pardelim = ?
      907     then do:
      908       assign
      909         pardelim = ","
      910       .
      911     end.
      912     def var ind as integer no-undo .
      913     def var v-elem as character no-undo .
      914     def var v-result-list as character no-undo init "".
      915     def var v-num-parfirst-list as integer no-undo .
      916     assign
      917       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      918     .
      919     do ind = 1 to v-num-parfirst-list
      920     :
      921       assign
      922         v-elem = entry(ind, parfirst-list, pardelim)
      923       .
      924       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      925         assign
      926           v-result-list = v-result-list
      927                         + (if v-result-list > "" then pardelim else "")
      928                         + v-elem
      929         .
      930       end.
      931     end.
      932     def var v-num-parsecond-list as integer no-undo .
      933     assign
      934       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      935     .
      936     do ind = 1 to v-num-parsecond-list
      937     :
      938       assign
      939         v-elem = entry(ind, parsecond-list, pardelim)
      940       .
      941       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      942         assign
      943           v-result-list = v-result-list
      944                         + (if v-result-list > "" then pardelim else "")
      945                         + v-elem
      946         .
      947       end.
      948     end.
      949     return v-result-list .
      950   end function.
      951   function cross-list returns character (
      952    input parfirst-list  as character,
      953    input parsecond-list as character,
      954    input pardelim       as character).
      955     if pardelim = ""
      956     or pardelim = ?
      957     then do:
      958       assign
      959         pardelim = ","
      960       .
      961     end.
      962     def var ind as integer no-undo .
      963     def var v-elem as character no-undo .
      964     def var v-result-list as character no-undo init "".
      965     def var v-num-parfirst-list as integer no-undo .
      966     assign
      967       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      968     .
      969     do ind = 1 to v-num-parfirst-list
      970     :
      971       assign
      972         v-elem = entry(ind, parfirst-list, pardelim)
      973       .
      974       if lookup(v-elem, v-result-list, pardelim) = 0
      975       and lookup(v-elem, parsecond-list, pardelim) > 0
      976       then do:
      977         assign
      978           v-result-list = v-result-list
      979                         + (if v-result-list > "" then pardelim else "")
      980                         + v-elem
      981         .
      982       end.
      983     end.
      984     return v-result-list .
      985   end function.
      986   function radio-label returns character (
      987    input par-rs-value  as character,
      988    input par-rs-radio-buttons as character)
      989    .
      990    DEFINE variable v-result-label as character no-undo.
      991    assign
      992    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      993                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      994                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      995                             ), par-rs-radio-buttons
      996                           )
      997    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      998    .
      999   return v-result-label.
     1000   end function.
     1001   function m-radio-label returns character (
     1002    input par-rs-value  as character,
     1003    input par-rs-radio-buttons as character,
     1004    input par-delim as character
     1005    )
     1006    .
     1007    DEFINE variable v-result-label as character no-undo.
     1008    assign
     1009    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
     1010                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
     1011                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
     1012                             ), par-rs-radio-buttons, par-delim
     1013                           )
     1014    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1015    .
     1016   return v-result-label.
     1017   end function.
     1018   FUNCTION mixlist returns character
     1019   (
     1020    input parfirst-list  as character
     1021    ,input parsecond-list as character
     1022    ,input pardelim       as character
     1023    ,input pardelim-result as character ) :
     1024     if pardelim = ""
     1025     or pardelim = ?
     1026     then do:
     1027       assign
     1028         pardelim = ","
     1029       .
     1030     end.
     1031     def var ind as integer no-undo .
     1032     def var v-elem1 as character no-undo .
     1033     def var v-elem2 as character no-undo .
     1034     def var v-result-list as character no-undo init "".
     1035     do ind = 1 to num-entries(parfirst-list, pardelim)
     1036     :
     1037       assign
     1038         v-elem1 = entry(ind, parfirst-list, pardelim)
     1039         v-elem2 = entry(ind, parsecond-list, pardelim)
     1040       .
     1041         assign
     1042           v-result-list = v-result-list
     1043                         + (if v-result-list > "" then pardelim-result else "")
     1044                         + v-elem1 + pardelim-result + v-elem2
     1045         .
     1046     end.
     1047     return v-result-list .
     1048   END FUNCTION.
