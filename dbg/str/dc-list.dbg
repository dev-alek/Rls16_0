     1382     define variable v-exist       as logical   no-undo .
     1383     do
     1384       on error undo, return error
     1385       :
     1386       run prn-lib-get-report-name  in this-procedure (
     1387         input parParentProc
     1388         ,output v-report-name
     1389         ).
     1390   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1391   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1392     (input  v-report-name
     1393     ,input  2
     1394     ,output v-exist
     1395     )  .
     1396       if NOT v-exist then
     1397       DO:
     1398         Message
     1399           "Нет заданий на печать ! "
     1400           view-as alert-box .
     1401         Return  .
     1402       End.
     1403       run gbl/prnfilen.w
     1404         (input  ""
     1405         ,input  p-DisabledOptions
     1406         ,input  string(v-report-name )
     1407         ,input  7
     1408         ,output v-user-action
     1409         ,output v-printed
     1410         ) .
     1411       if v-printed then
     1412       do:
     1413         return "YES" .
     1414       end.
     1415       else
     1416       do:
     1417         return "NO" .
     1418       end.
     1419     end.
     1420   end procedure.
     1421   procedure prn-lib-open-stream :
     1422     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1423     define input parameter p-page-size    as integer no-undo .
