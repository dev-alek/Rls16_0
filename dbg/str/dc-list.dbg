     1331   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1332   procedure fltfield-clear :
     1333     define output parameter loc-fld as character no-undo.
     1334     define output parameter loc-lab as character no-undo .
     1335     define output parameter loc-spr as character no-undo .
     1336     define output parameter loc-dim as character no-undo .
     1337     assign
     1338       loc-fld = ""
     1339       loc-lab = ""
     1340       loc-spr = ""
     1341       loc-dim = "0"
     1342     .
     1343   end procedure .
     1344   procedure fltfield-add :
     1345     define input        parameter par-fld as character no-undo.
     1346     define input        parameter par-lab as character no-undo .
     1347     define input        parameter par-spr as character no-undo .
     1348     define input-output parameter loc-fld as character no-undo.
     1349     define input-output parameter loc-lab as character no-undo .
     1350     define input-output parameter loc-spr as character no-undo .
     1351     define input-output parameter loc-dim as character no-undo .
     1352     do
     1353     on error undo, return error
     1354     :
     1355       assign
     1356       loc-fld = if loc-dim = '0'
     1357                 then par-fld
     1358                 else (loc-fld + chr(44) + par-fld)
     1359       loc-lab = if loc-dim = '0'
     1360                 then par-lab
     1361                 else (loc-lab + chr(44) + par-lab)
     1362       loc-spr = if loc-dim = '0'
     1363                 then par-spr
     1364                 else (loc-spr + chr(44) + par-spr)
     1365       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
     1366                 string(integer(if num-entries(loc-dim) > 1
     1367                               then entry(2, loc-dim)
     1368                               else entry(1, loc-dim)
     1369                               ) + 1)
     1370       no-error
     1371       .
     1372     end.
     1373   end procedure.
     1374   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1375   define  stream PrnLibStream.
     1376   procedure prn-lib-prn-file :
     1377     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1378     define input parameter p-DIsabledoptions as integer no-undo .
     1379     define variable v-report-name as character no-undo .
     1380     define variable v-user-action as character no-undo .
