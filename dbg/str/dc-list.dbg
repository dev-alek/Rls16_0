     8491       when "doc-list" then do:
     8492         glog = yes.
     8493         message
     8494         "Все карты для документов из сохраненного в файле списка документов."
     8495         skip stat-line(rs-status)
     8496         view-as alert-box question buttons OK-Cancel update glog.
     8497         if not glog then do:
     8498           run Myenable  in this-procedure .
     8499           return error.
     8500         end.
     8501         system-dialog get-file f-name
     8502           filters "Списки документов *.trn" "*.trn"
     8503           title "Выберите файл списка"
     8504           INITIAL-DIR "."
     8505           return-to-start-dir
     8506           must-exist
     8507           update glog
     8508           default-extension "trn".
     8509         if not glog then do:
     8510           run MYenable  in this-procedure .
     8511           return error.
     8512         end.
     8513         run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8514                                             , input-output v-seq
     8515                                             , input 0
     8516                                             , input '':U
     8517                                             , input substitute("Карты документов из списка: &1 &2", f-name, stat-line(rs-status))
     8518                                             , input tot-lns
     8519                                             , input rs-list-method
     8520                                             , input rs-status
     8521                                             , input f-name
     8522                                             , input '':U
     8523                                             , input ?
     8524                                             ).
     8525       end.
     8526       when "chk-list" then do:
     8527         glog = yes.
     8528         message
     8529         "Все карты для чеков из сохраненного в файле списка чеков."
     8530         skip stat-line(rs-status)
     8531         view-as alert-box question buttons OK-Cancel update glog.
     8532         if not glog then do:
     8533           run Myenable  in this-procedure .
     8534           return error.
     8535         end.
     8536         system-dialog get-file f-name
     8537           filters "Списки документов *.chk" "*.chk"
     8538           title "Выберите файл списка"
     8539           INITIAL-DIR "."
     8540           return-to-start-dir
     8541           must-exist
     8542           update glog
     8543           default-extension "chk".
     8544         if not glog then do:
     8545           run MYenable  in this-procedure .
     8546           return error.
     8547         end.
     8548         run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8549                                             , input-output v-seq
     8550                                             , input 0
     8551                                             , input '':U
     8552                                             , input substitute("Карты чеков из списка: &1 &2", f-name, stat-line(rs-status))
     8553                                             , input tot-lns
     8554                                             , input rs-list-method
     8555                                             , input rs-status
     8556                                             , input f-name
     8557                                             , input '':U
     8558                                             , input ?
     8559                                             ).
     8560       end.
     8561       when "deleted" then do:
     8562         if RS-status = 'текущие':U then do:
     8563           message
     8564           "Переключатель <СТАТУС> стоит в положениии <Текущие>" skip
     8565           "Вы не cможете выбрать ни одну карту"
     8566           view-as alert-box error .
     8567           run MyENable  in this-procedure .
     8568           return error.
     8569         end.
     8570         glog = yes.
     8571         message
     8572         "Все удаленные карты."
     8573         skip stat-line(rs-status)
     8574         view-as alert-box question buttons OK-Cancel update glog.
     8575         if not glog then do:
     8576           run MyEnable  in this-procedure .
     8577           return error.
     8578         end.
     8579         run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8580                                             , input-output v-seq
     8581                                             , input 0
     8582                                             , input '':U
     8583                                             , input substitute("ВСЕ удаленные карты &1", stat-line(rs-status))
     8584                                             , input tot-lns
     8585                                             , input rs-list-method
     8586                                             , input rs-status
     8587                                             , input 'deleted':U
     8588                                             , input '':U
     8589                                             , input ?
     8590                                             ).
     8591       end.
     8592       when "file" then do:
     8593         glog = yes.
     8594         message "Все карты из ранее сохраненного в файле списка."
     8595         skip stat-line(rs-status)
     8596         view-as alert-box question buttons OK-Cancel update glog.
     8597         if not glog then do:
     8598           run Myenable  in this-procedure .
     8599           return error.
     8600         end.
     8601         system-dialog get-file f-name
     8602           filters "Списки дисконтных карт *.dc" "*.dc"
     8603           title "Выберите файл списка"
     8604           INITIAL-DIR "."
     8605           return-to-start-dir
     8606           must-exist
     8607           update glog
     8608           default-extension "dc".
     8609         if not glog then do:
     8610           run MyEnable  in this-procedure .
     8611           return error.
     8612         end.
     8613         run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8614                                             , input-output v-seq
     8615                                             , input 0
     8616                                             , input '':U
     8617                                             , input substitute("Файл списка : &1 &2", f-name, stat-line(rs-status))
     8618                                             , input tot-lns
     8619                                             , input rs-list-method
     8620                                             , input rs-status
     8621                                             , input f-name
     8622                                             , input '':U
     8623                                             , input ?
     8624                                             ).
     8625     end.
     8626     when "clob-data" then do:
     8627       glog = yes.
     8628       message "Все карты из ранее сохраненного в БД списка"
     8629       skip stat-line(rs-status)
     8630       view-as alert-box question buttons OK-Cancel update glog.
     8631       if not glog then do:
     8632         run Myenable in this-procedure.
     8633         return error.
     8634       end.
     8635       run ref/clobbnds.w ( input parparentproc
     8636                           ,input this-procedure:handle
     8637                           ,input 'b-sel'
     8638                           ,input "uniq-key-rec"
     8639                           ,input ""
     8640                           ,input 'list':U
     8641                           ,input 'dc-list'
     8642                           ,input -1
     8643                           ,input-output v-rid-list) no-error.
     8644       if v-rid-list = '' then do:
     8645         run Myenable in this-procedure.
     8646         return error.
     8647       end.
     8648       find first buf_clob-bind no-lock where
     8649                 recid(buf_clob-bind) = integer(v-rid-list) .
     8650       run gen-key-rec in this-procedure ( input 'clob-bind':U
     8651                                           ,input (buffer buf_clob-bind:handle)
     8652                                           ,output v-uniq-key-rec).
     8653       run create-dc-list-hist in this-procedure (
     8654                                             input 'ДОБАВЛЕНИЕ':U
     8655                                           , input-output v-seq
     8656                                           , input 0
     8657                                           , input '':U
     8658                                           , input substitute("Хранимый Файл списка : &1 &2", buf_clob-bind.field-name_, stat-line(rs-status))
     8659                                           , input tot-lns
     8660                                           , input rs-list-method
     8661                                           , input rs-status
     8662                                           , input v-uniq-key-rec
     8663                                           , input '':U
     8664                                           , input ?)
     8665                                           .
     8666     end.
     8667     WHEN "FILTER" THEN DO:
     8668         run trig-filter  in this-procedure no-error.
     8669         if error-status:error then do:
     8670           run MyEnable  in this-procedure .
     8671           return error.
     8672         end.
     8673     END.
     8674   end case.
     8675   if tot-lns <> 0 then do:
     8676       run get-operation in this-procedure (input dsp-rs, output v-operation).
     8677       CASE v-operation:
     8678         when 1 then do:
     8679           run proc-b-add in this-procedure(no, ?, rs-list-method, rs-status ).
     8680         end.
     8681         when 2 then do:
     8682           run proc-b-del in this-procedure(no, ?, rs-list-method, rs-status ).
     8683         end.
     8684         when 3 then do:
     8685           run proc-b-rest in this-procedure(no, ?, rs-list-method, rs-status ).
     8686         end.
     8687         otherwise do:
     8688           assign
     8689           dsp-rs = "":U.
     8690           run MyEnable in this-procedure .
     8691           return error.
     8692         end.
     8693       END CASE.
     8694     end.
     8695     assign
     8696     rs-list-method = temp-list.fvalue
     8697     .
     8698     find last buf_dc-list-hist no-lock where
     8699               buf_dc-list-hist.id = (v-seq - 1)
     8700         and  buf_dc-list-hist.line = 0 no-error .
     8701     DISPLAY
     8702     (if available buf_dc-list-hist
     8703     then buf_dc-list-hist.des
     8704     else '') @ dsp-rs
     8705     with frame Dialog-Frame.
     8706     if tot-lns = 0
     8707     then do:
     8708       run proc-b-add in this-procedure(no, ?, rs-list-method, rs-status)  .
     8709     end.
     8710   end.
     8711   END PROCEDURE.
     8712   PROCEDURE rs-do :
     8713   define input parameter p-from-macro as logical no-undo .
     8714   define input parameter p-step as logical no-undo .
     8715   define input parameter rs-list-method as character no-undo .
     8716   define input parameter rs-status as character no-undo .
     8717   define input parameter line-mode as character no-undo .
     8718   define input parameter p-id      as integer no-undo .
     8719   define variable v-rowid   as rowid no-undo .
     8720   define variable v-tbl-name as character no-undo .
     8721   define variable v-obj-type as character  no-undo.
     8722   define variable v-obj-code as integer    no-undo.
     8723   DEFINE VARIABLE v-attr-code          as character           no-undo .
     8724   define variable grp-path as character no-undo .
     8725   define variable v-host-code as integer no-undo .
     8726   define variable v-dt-code as integer no-undo .
     8727   define variable v-r-b as character no-undo .
     8728   define variable v-field as character no-undo .
     8729   define variable v-low as decimal no-undo .
     8730   define variable v-high as decimal no-undo .
     8731   define variable v-acc as decimal no-undo .
     8732   define variable v-next as logical no-undo .
     8733   define variable v-last-change-date as date no-undo .
     8734   define variable v-cond as character no-undo .
     8735   define variable v-dtm-code as integer no-undo .
     8736   define variable v-node-code as integer no-undo .
     8737   define buffer buf_dis-card-property for ub.dis-card-property.
     8738   define buffer buf_prop-map for ub.prop-map.
     8739   define buffer buf_stop-list for ub.stop-list.
     8740   define buffer buf_stop-list-line for ub.stop-list-line.
     8741   define buffer buf_dc-list-hist for dc-list-hist.
     8742   do
     8743   on error undo, return error return-value
     8744   :
     8745   assign
     8746   lns-cnt = 0
     8747   lns-ignore = 0
     8748   v-num-add  = 0
     8749   v-num-ignored = 0
     8750   tot-lns = (if line-mode = 'ОСТАВИТЬ':U then 0 else tot-lns)
     8751   .
     8752   run write-hist in this-procedure (p-from-macro, rs-list-method, rs-status, line-mode).
     8753   if session:set-wait-state( "COMPILER" )  then .
     8754   dsp-rs:fgcolor in frame Dialog-Frame = 12.
     8755   case rs-list-method:
     8756     when "card" then do:
     8757       for each buf_dc-list-hist where
     8758                buf_dc-list-hist.id = p-id
     8759           and  buf_dc-list-hist.item_ <> '':U:
     8760         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_dc-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then next.
     8761         find ub.dis-card where rowid (ub.dis-card) = v-rowid no-lock.
     8762         if available ub.dis-card then
     8763         run ex-dc(input rs-list-method, input rs-status, input line-mode).
     8764         assign                                                           buf_dc-list-hist.num-add  = lns-cnt - v-num-add                       buf_dc-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_dc-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_dc-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8765       end.
     8766     end.
     8767     when "cli-grp" then do:
     8768       for each buf_dc-list-hist where
     8769                buf_dc-list-hist.id = p-id
     8770           and  buf_dc-list-hist.item_ <> '':U:
     8771         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_dc-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     8772         grp-path = "".
     8773         find first ub.cli-grp no-lock where rowid(ub.cli-grp) = v-rowid.
     8774         grp-path = ''.
     8775         run cli-grplib-get-full-name in this-procedure (cli-grp.node-code, output grp-path).
     8776         for each ub.clients no-lock where ub.clients.grp-name begins grp-path,
     8777             each ub.dis-card no-lock where
     8778                   ub.dis-card.cli-type = ub.clients.obj-type
     8779               AND ub.dis-card.cli-code = ub.clients.obj-code:
     8780           run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     8781         end.
     8782         assign                                                           buf_dc-list-hist.num-add  = lns-cnt - v-num-add                       buf_dc-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_dc-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_dc-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8783       end.
     8784     end.
     8785     when "cli" then do:
     8786       for each buf_dc-list-hist where
     8787                buf_dc-list-hist.id = p-id
     8788           and  buf_dc-list-hist.item_ <> '':U:
     8789         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_dc-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     8790         find first ub.clients no-lock where rowid(ub.clients) = v-rowid.
     8791         for each ub.dis-card no-lock where
     8792                   ub.dis-card.cli-type = ub.clients.obj-type
     8793               AND ub.dis-card.cli-code = ub.clients.obj-code:
     8794           run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     8795         end.
     8796         assign                                                           buf_dc-list-hist.num-add  = lns-cnt - v-num-add                       buf_dc-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_dc-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_dc-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8797       end.
     8798     end.
     8799     when "global":U then do:
     8800      find first buf_dc-list-hist where
     8801                  buf_dc-list-hist.id = p-id .
     8802       for each ub.dis-card no-lock where ub.dis-card.emitent-host-code = 0:
     8803         run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     8804       end.
     8805       assign                                                           buf_dc-list-hist.num-add  = lns-cnt - v-num-add                       buf_dc-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_dc-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_dc-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8806       end.
     8807     when "company":U then do:
     8808       find first buf_dc-list-hist where
     8809                  buf_dc-list-hist.id = p-id .
     8810       for each ub.dis-card no-lock where ub.dis-card.emitent-host-code = p-curr-host-code:
     8811         run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     8812       end.
     8813       assign                                                           buf_dc-list-hist.num-add  = lns-cnt - v-num-add                       buf_dc-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_dc-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_dc-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8814     end.
     8815     when "type":U then do:
     8816       for each buf_dc-list-hist where
     8817                buf_dc-list-hist.id = p-id
     8818           and  buf_dc-list-hist.item_ <> '':U:
     8819         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_dc-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     8820         find ub.dis-card-type where
     8821               rowid (ub.dis-card-type) = v-rowid no-lock.
     8822         for each ub.dis-card where
     8823                   ub.dis-card.type = ub.dis-card-type.type no-lock:
     8824             run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     8825         end.
     8826         assign                                                           buf_dc-list-hist.num-add  = lns-cnt - v-num-add                       buf_dc-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_dc-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_dc-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8827       END.
     8828     end.
     8829     when "person" then do:
     8830       find first buf_dc-list-hist where
     8831                  buf_dc-list-hist.id = p-id .
     8832       for each ub.clients where ub.clients.obj-type = 'чел':U no-lock,
     8833           each ub.dis-card where
     8834               ub.dis-card.cli-type = ub.clients.obj-type AND
     8835               ub.dis-card.cli-code = ub.clients.obj-code:
     8836         run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     8837       end.
     8838       assign                                                           buf_dc-list-hist.num-add  = lns-cnt - v-num-add                       buf_dc-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_dc-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_dc-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8839     end.
     8840     when "waybill" then do:
     8841     for each buf_dc-list-hist where
     8842               buf_dc-list-hist.id = p-id
     8843         and  buf_dc-list-hist.item_ <> '':U:
     8844       run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_dc-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     8845       find first ub.trn-doc no-lock where
     8846                 rowid(ub.trn-doc) = v-rowid no-error.
     8847       if available ub.trn-doc then do:
     8848         FIND FIRST ub.clients No-LOCK WHERE
     8849                   ub.clients.obj-type = ub.trn-doc.cli-type AND
     8850                   ub.clients.obj-code = ub.trn-doc.cli-code No-ERROR.
     8851         if avail ub.clients then do:
     8852           for each ub.dis-card No-LOCK WHERE
     8853                   ub.dis-card.cli-type = ub.clients.obj-type AND
