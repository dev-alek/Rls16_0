     5576   procedure diasize_init :
     5577     define variable v-default-value    as logical   no-undo .
     5578     define variable v-restore-saved    as logical   no-undo .
     5579     define variable v-resize-value-str as character no-undo .
     5580     do
     5581     on error undo, return error return-value
     5582     :
     5583       do with frame Dialog-Frame
     5584       :
     5585         assign
     5586           v-diasize-orig-frame-height = frame Dialog-Frame :height
     5587           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     5588           v-diasize-browse-handle     = browse br-list :handle
     5589         .
     5590         create button v-diasize-resize-button
     5591         assign
     5592           parent        = frame Dialog-Frame :first-child
     5593           label         = "s"
     5594           height-pixels = 16
     5595           width-pixels  = 16
     5596           visible       = true
     5597           sensitive     = true
     5598           movable       = true
     5599           triggers:
     5600             on end-move persistent run diasize_end-move in this-procedure .
     5601           end triggers.
     5602         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     5603         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     5604         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     5605         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     5606         assign
     5607           v-diasize-wndmax = false
     5608         .
     5609         if connected("ub") = true
     5610         then do:
     5611           define variable v-cntxt-db-num        as integer   no-undo .
     5612           define variable v-cntxt-userid        as character no-undo .
     5613           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5614                                             , OUTPUT v-cntxt-userid
     5615                                             ) .
     5616           run gbl/wndpar_r.p
     5617             (input  v-cntxt-db-num
     5618             ,input  v-cntxt-userid
     5619             ,input  'wndmax':U
     5620             ,output v-diasize-wndmax
     5621             ,output v-default-value
     5622             ) .
     5623         end.
     5624         assign
     5625           v-diasize-wndstore = false
     5626         .
     5627         if connected("ub") = true
     5628         then do:
     5629           run gbl/wndpar_r.p
     5630             (input  v-cntxt-db-num
     5631             ,input  v-cntxt-userid
     5632             ,input  'wndstore':U
     5633             ,output v-diasize-wndstore
     5634             ,output v-default-value
     5635             ) .
     5636         end.
     5637         assign
     5638           v-diasize-proc-name = entry(1, program-name(2), '.')
     5639         .
     5640         if v-diasize-wndstore = true
     5641         then do:
     5642           assign
     5643             v-restore-saved = false
     5644           .
     5645           if connected("ub") = true
     5646           then do:
     5647             run gbl/wndsizer.p
     5648               (input  v-cntxt-db-num
     5649               ,input  v-cntxt-userid
     5650               ,input  v-diasize-proc-name
     5651               ,input  'height':u
     5652               ,output v-resize-value-str
     5653               ) .
     5654             if v-resize-value-str <> '':U
     5655             then do:
     5656               run diasize_change-height in this-procedure
     5657                 (input  integer(v-resize-value-str)
     5658                 ,input  true
     5659                 ) .
     5660               assign
     5661                 v-restore-saved = true
     5662               .
     5663             end.
     5664           end.
     5665           if connected("ub") = true
     5666           then do:
     5667             run gbl/wndsizer.p
     5668               (input  v-cntxt-db-num
     5669               ,input  v-cntxt-userid
     5670               ,input  v-diasize-proc-name
     5671               ,input  'width':u
     5672               ,output v-resize-value-str
     5673               ) .
     5674             if v-resize-value-str <> '':U
     5675             then do:
     5676               run diasize_change-width in this-procedure
     5677                 (input  integer(v-resize-value-str)
     5678                 ,input  true
     5679                 ) .
     5680               assign
     5681                 v-restore-saved = true
     5682               .
     5683             end.
     5684           end.
     5685           if v-restore-saved <> true
     5686           then do:
     5687             if v-diasize-wndmax = true
     5688             then do:
     5689               run diasize_maximize in this-procedure
     5690                 (input  true
     5691                 ) .
     5692             end.
     5693           end.
     5694         end.
     5695         else do:
     5696           if v-diasize-wndmax = true
     5697           then do:
     5698             run diasize_maximize in this-procedure
     5699               (input  true
     5700               ) .
     5701           end.
     5702         end.
     5703       end.
     5704     end.
     5705   end procedure.
     5706   procedure diasize_need-full-display :
     5707     define output parameter p-need-full-display as logical   no-undo .
     5708     do
     5709     on error undo, return error return-value
     5710     :
     5711       assign
     5712         p-need-full-display = v-diasize-need-full-display
     5713       .
     5714       assign
     5715         v-diasize-need-full-display = false
     5716       .
     5717     end.
     5718   end procedure.
     5719   procedure get-context :
     5720      define output parameter p-db-num as integer          no-undo.
     5721      define output parameter p-user-id as character        no-undo.
     5722      define variable v-login               as character    no-undo.
     5723      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     5724      define buffer buf_user-login  for ub.user-login .
     5725      do
     5726      on error undo, return error
     5727      :
     5728            FIND FIRST buf_sys-ctrl no-lock.
     5729            ASSIGN
     5730               v-login = USERID("ub")
     5731               p-db-num = buf_sys-ctrl.db-num
     5732            .
     5733            FIND FIRST buf_user-login
     5734                 WHERE buf_user-login.db-num = p-db-num
     5735                   AND buf_user-login.user-login = v-login
     5736                 no-lock
     5737                 no-error
     5738                 .
     5739            IF AVAILABLE buf_user-login
     5740            THEN DO:
     5741               assign
     5742                  p-user-id = buf_user-login.user-id
     5743               .
     5744            END.
     5745      end.
     5746   end procedure.
     5747   run diasize_add_browse in this-procedure
     5748     (input  'height':u
     5749     ,input  browse BR-option :handle
     5750     ) .
     5751   run diasize_init in this-procedure .
     5752   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5753   do:
     5754     br-list :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     5755   end.
     5756   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5757   PROCEDURE ex-dc :
     5758   define input parameter rs-list-method as character no-undo .
     5759   define input parameter rs-status as character no-undo .
     5760   define input parameter line-mode as character no-undo .
     5761   if rs-list-method = "single":U or
     5762     (ub.dis-card.status_ = 'тек':U and (rs-status = 'тек':U or rs-status = 'все':U)) or
     5763     (ub.dis-card.status_ = 'удал':U and (rs-status = 'удал':U or rs-status = 'все':U)) or
     5764     (ub.dis-card.status_ = 'блок':U and (rs-status = 'блок':U or rs-status = 'все':U))
     5765     then do:
     5766     if line-mode = 'удаление':U or line-mode = 'ОСТАВИТЬ':U then do:
     5767       find first dc-list where
     5768                  dc-list.d-card = ub.dis-card.d-card no-error.
     5769       if available dc-list then do:
     5770         if line-mode = 'удаление':U then do:
     5771           lns-cnt = lns-cnt + 1.
     5772           delete dc-list.
     5773         end.
     5774         else do:
     5775           if dc-list.to-del = ? then.
     5776           else do:
     5777             lns-cnt = lns-cnt + 1.
     5778             dc-list.to-del = ?.
     5779           end.
     5780         end.
     5781       end.
     5782     end.
     5783     else
     5784       if line-mode = 'ДОБАВЛЕНИЕ':U then do:
     5785   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5786   find dc-list
     5787     where dc-list.d-card = dis-card.d-card
     5788     no-error .
     5789   if available dc-list then do:
     5790     assign
     5791       dc-list.to-del = no
     5792     .
     5793   end.
     5794   else do:
     5795     create dc-list .
     5796     buffer-copy dis-card to dc-list
     5797     assign
     5798       dc-list.to-del = no
     5799     .
     5800     assign
     5801       lns-cnt = lns-cnt + 1
     5802       line-rec = recid (dc-list)
     5803     .
     5804   end.
     5805       end.
     5806     if lns-cnt modulo 25 = 0 then
     5807     disp "Ждите..." + string (lns-cnt) @ dsp-rs with frame Dialog-Frame.
     5808   end.
     5809   end.
     5810   def var vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5811   def var vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5812   define variable v-no-context as logical no-undo .
     5813   define variable v-user-obj-type as character no-undo .
     5814   define variable v-user-obj-code as integer no-undo .
     5815   FUNCTION prepare-rowid returns character ( input p-uniq-key-rec as character
     5816                                            , input p-no-context as logical ):
     5817   define variable v-uniq-key-rec as character no-undo .
     5818   if p-no-context and p-uniq-key-rec begins 'user-obj':U then do:
     5819     v-uniq-key-rec = 'clients':U + chr(3) +
     5820                     entry(4, p-uniq-key-rec, chr(3)) + chr(3) +
     5821                     entry(5, p-uniq-key-rec, chr(3)).
     5822   end.
     5823   else do:
     5824     v-uniq-key-rec = p-uniq-key-rec.
     5825     case entry(1, p-uniq-key-rec, chr(3)):
     5826        when 'user-obj':U then do:
     5827          entry(lookup("user-id", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = v-cntxt-userid.
     5828          entry(lookup("db-num", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = string(v-cntxt-db-num).
     5829        end.
     5830     end case.
     5831   end.
     5832   return v-uniq-key-rec.
     5833   end function.
     5834   procedure find-user-obj-rowid :
     5835   define input parameter p-rowid as rowid no-undo .
     5836   define input parameter p-no-context as logical no-undo .
     5837   define output parameter p-user-obj-type as character no-undo .
     5838   define output parameter p-user-obj-code as integer no-undo .
     5839   define buffer user-obj_clients for ub.clients.
     5840   define buffer user-obj_user-obj for ub.user-obj .
     5841   if p-no-context then do:
     5842     find first user-obj_clients no-lock where rowid(user-obj_clients) = p-rowid.
     5843     assign
     5844     p-user-obj-type = user-obj_clients.obj-type
     5845     p-user-obj-code = user-obj_clients.obj-code.
     5846   end.
     5847   else do:
     5848     find first user-obj_user-obj no-lock where rowid(user-obj_user-obj) = p-rowid no-error.
     5849     if not available user-obj_user-obj then do:
     5850       undo, return error substitute("Не удалось выполнить в данной БД записанные действия пользователя").
     5851     end.
     5852     assign
     5853     p-user-obj-type = user-obj_user-obj.obj-type
     5854     p-user-obj-code = user-obj_user-obj.obj-code.
     5855   end.
     5856   end procedure.
     5857   define variable an-listp-start-macro-id as integer no-undo init ?.
     5858   define variable an-listp-end-macro-id as integer no-undo  init ?.
     5859   define variable an-listp-macros-label-id as integer   no-undo .
     5860   define variable v-macro-is-running as logical no-undo .
     5861   define variable v-current-step as integer no-undo .
     5862   define variable v-expand as logical no-undo .
     5863   define variable v-downed as character no-undo .
     5864   define variable p-title as character no-undo .
     5865   define variable bttns as character no-undo .
     5866   define variable p-keep-query as logical no-undo .
     5867   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5868   define     temp-table keep-macro-list-hist no-undo
     5869   field list-table as character
     5870   field id as integer
     5871   field line as integer
     5872   field hist-mode as character
     5873   field des as character
     5874   field num-recs as integer
     5875   field option_ as character
     5876   field item_ as character
     5877   field status_ as character
     5878   field num-add as integer
     5879   field num-ignored as integer
     5880   field done as logical
     5881   field err_ as logical
     5882   field err-mes as character
     5883   index pi is primary
     5884   id
     5885   line
     5886   index isdone
     5887   done
     5888   .
     5889   procedure assign-nums :
     5890   define input-output parameter p-num-add as integer no-undo .
     5891   define input-output parameter p-num-rec as integer no-undo .
     5892   define input-output parameter p-num-ignored as integer no-undo .
     5893   define input parameter p-line-mode as character no-undo .
     5894   assign
     5895   p-num-add  = lns-cnt - v-num-add
     5896   p-num-rec = (if line-mode = 'ОСТАВИТЬ':U
     5897                             then (tot-lns + p-num-add)
     5898                             else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))
     5899   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)
     5900   p-num-ignored = lns-ignore  - v-num-ignored
     5901   v-num-add             = lns-cnt
     5902   v-num-ignored         = lns-ignore
     5903   .
     5904   END PROCEDURE.
     5905   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     5906   or INSERT-MODE of br-list
     5907   DO:
     5908   define variable glog as logical no-undo .
     5909   define buffer buf-dc-list-hist for dc-list-hist.
     5910   define buffer buf_macro-list-hist for macro-list-hist.
     5911   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     5912    if p-keep-query then do:
     5913       glog = no.
     5914       message "Реинициализация списка. Вы уверены ?"
     5915               view-as alert-box question buttons OK-Cancel update glog.
     5916       if not glog then return no-apply.
     5917       if session:set-wait-state( "COMPILER" )  then .
     5918       for each dc-list:
     5919         delete dc-list.
     5920       end.
     5921       if session:set-wait-state( "" )  then .
     5922       tot-lns = 0.
     5923       v-seq = 1.
     5924       for each buf-dc-list-hist:
     5925         delete buf-dc-list-hist.
     5926       end.
     5927      for each buf_keep-macro-list-hist:
     5928        create buf_macro-list-hist.
     5929      end.
     5930      run proc-macro-play in this-procedure ( input 0, input yes, input 0).
     5931      run create-dc-list-hist in this-procedure (
     5932                                             input 'ДОБАВЛЕНИЕ':U
     5933                                           , input-output v-seq
     5934                                           , input 0
     5935                                           , input '0':U
     5936                                           , input "# Реинициализация списка."
     5937                                           , input 0
     5938                                           , input "init"
     5939                                           , input '':U
     5940                                           , input '':U
     5941                                           , input '':U
     5942                                           , input ?
     5943                                           ).
     5944       display
     5945       tot-lns @ f-tot-lns
     5946       with frame Dialog-Frame.
     5947       run MyEnable in this-procedure .
     5948    end.
     5949    else do:
     5950      assign rs-list-method = "single".
     5951      run proc-b-add in this-procedure(input no
     5952                                     ,input ?
     5953                                     ,input rs-list-method
     5954                                     ,input rs-status)  no-error .
     5955     if error-status:error then return no-apply.
     5956   end.
     5957   END.
     5958   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     5959   or DELETE-CHARACTER of br-list
     5960   DO:
     5961     if not available dc-list then return no-apply.
     5962     assign rs-list-method = "single".
     5963       run proc-b-del in this-procedure(
     5964                                                  input no
     5965                                                 ,input ?
     5966                                                 ,input rs-list-method
     5967                                                 ,input rs-status) no-error .
     5968     if error-status:error then return no-apply.
     5969   END.
     5970   ON CHOOSE OF B-rest IN FRAME Dialog-Frame
     5971   DO:
     5972   if not available dc-list then return no-apply.
     5973     assign rs-list-method = "single".
     5974    run proc-b-rest in this-procedure(
     5975                                                   input no
     5976                                                  ,input ?
     5977                                                  ,input rs-list-method
     5978                                                  ,input rs-status) no-error .
     5979     if error-status:error then return no-apply.
     5980   END.
     5981   on choose of MENU-ITEM m-macro-file in menu m-play DO:
     5982     assign
     5983     macro-play-option = 'file':U.
     5984     APPLY "CHOOSE" to b-macro in frame Dialog-Frame.
     5985   end.
     5986   on choose of MENU-ITEM m-macro-lob in menu m-play DO:
     5987     assign
     5988     macro-play-option = 'lob':U.
     5989     APPLY "CHOOSE" to b-macro in frame Dialog-Frame.
     5990   end.
     5991   ON CHOOSE OF B-macro IN FRAME Dialog-Frame
     5992   DO:
     5993   if macro-play-option = '':U then do:
     5994         run gbl/pop-up.p ( input self:handle, input no) no-error.
     5995   end.
     5996   if macro-play-option = '':U then return no-apply.
     5997   run proc-b-macro in this-procedure ( input macro-play-option) no-error .
     5998   if error-status:error then return no-apply.
     5999   END.
     6000   ON CHOOSE OF B-record IN FRAME Dialog-Frame
     6001   DO:
     6002   define variable glog as logical no-undo .
     6003   message
     6004   "Начать запись макроса формирования списка?"
     6005   view-as alert-box QUESTION buttons yes-no update glog.
     6006   if not glog then return no-apply.
     6007   assign
     6008   an-listp-start-macro-id = v-seq
     6009   an-listp-end-macro-id = ?
     6010   .
     6011     menu-item m-macro-file:label in menu m-play = "Ранее записанный макрос формирования списка товаров".
     6012     menu-item m-macro-lob:sensitive in menu m-play = no.
     6013   disable
     6014   b-record with frame Dialog-Frame .
     6015   hide
     6016   b-record
     6017   b-macro
     6018   in frame Dialog-Frame .
     6019   enable
     6020   b-stop with frame Dialog-Frame .
     6021   run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     6022                                       , input-output v-seq
     6023                                       , input 0
     6024                                       , input 'o':U
     6025                                       , input "Начата запись макроса формирования списка"
     6026                                       , input tot-lns
     6027                                       , input 'macro':U
     6028                                       , input '':U
     6029                                       , input '':U
     6030                                       , input '':U
     6031                                       , input ?
     6032                                       ).
     6033   END.
     6034   ON CHOOSE OF B-stop IN FRAME Dialog-Frame
     6035   DO:
     6036   define variable glog as logical no-undo .
     6037   define variable v-id as integer no-undo .
     6038   define buffer buf_dc-list-hist for dc-list-hist.
     6039   message
     6040   "Закончить запись макроса формирования списка?"
     6041   view-as alert-box QUESTION buttons yes-no update glog.
     6042   if not glog then return no-apply.
     6043   assign
     6044   an-listp-end-macro-id = v-seq.
     6045   disable
     6046   b-stop with frame Dialog-Frame .
     6047   hide
     6048   b-stop in frame Dialog-Frame .
     6049   enable
     6050   b-record
     6051   b-macro
     6052   with frame Dialog-Frame .
     6053   run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     6054                                       , input-output v-seq
     6055                                       , input 0
     6056                                       , input '[]':U
     6057                                       , input "Закончена запись макроса формирования списка"
     6058                                       , input tot-lns
     6059                                       , input 'macro':U
     6060                                       , input '':U
     6061                                       , input '':U
     6062                                       , input '':U
     6063                                       , input ?
     6064                                       ).
     6065   for each macro-list-hist:
     6066     delete macro-list-hist.
     6067   end.
     6068   for each buf_dc-list-hist where
     6069           buf_dc-list-hist.id >=  an-listp-start-macro-id
     6070     and  buf_dc-list-hist.id <=  an-listp-end-macro-id:
     6071     create macro-list-hist.
     6072     buffer-copy buf_dc-list-hist
     6073     except id num-recs num-add num-ignored
     6074     to macro-list-hist
     6075     assign
     6076     macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6077     v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6078     .
     6079   end.
     6080   END.
     6081   ON CHOOSE OF b-clear-macro IN FRAME Dialog-Frame
     6082   DO:
     6083   disable
     6084   b-clear-macro with frame Dialog-Frame .
     6085   assign
     6086   an-listp-start-macro-id = ?
     6087   an-listp-end-macro-id = ?
     6088   an-listp-macros-label-id = 0
     6089   .
     6090   menu-item m-macro-lob:sensitive in menu m-play = yes.
     6091   for each macro-list-hist:
     6092     delete macro-list-hist.
     6093   end.
     6094   hide
     6095   b-clear-macro in frame Dialog-Frame .
     6096   enable
     6097   b-record
     6098   b-macro
     6099   with frame Dialog-Frame .
     6100   END.
     6101   ON VALUE-CHANGED OF br-option IN FRAME Dialog-Frame
     6102   DO:
     6103     assign
     6104     Rs-list-method = temp-list.fvalue
     6105     .
     6106     run proc-vc-rs-list-method in this-procedure no-error .
     6107     if error-status:error then return no-apply.
     6108   END.
     6109   PROCEDURE get-operation :
     6110   define input parameter p-message as character no-undo .
     6111   define output parameter p-operation as integer no-undo .
     6112     do
     6113     on error undo, return error
     6114     :
     6115       run gbl/d-askw.w (
     6116                     input "Выбор операции над заданным списком"
     6117                    ,input (p-message + chr(10) +
     6118                            "Выберите операцию, которую Вы хотите применить к полученному списку" +  chr(10) )
     6119                    ,input "|"
     6120                   ,input  ("Добавить" + (if p-keep-query then "^disable" else '':U) + "|" +
     6121                            "Удалить" + "|" +
     6122                            "Оставить" + "|" +
     6123                            "Отказ")
     6124                    ,input ("Добавить полученный список к уже имеющемуся" + "|" +
     6125                           "Удалить полученный список из уже имеющегося" + "|" +
     6126                           "Оставить в уже имеющемся списке только элементы полученного списка" +  "|" +
     6127                           "Ничего не делать")
     6128                    ,input  (if p-keep-query then 2 else 1)
     6129                    ,input  4
     6130                    ,output p-operation).
     6131      if p-operation = 4 then do:
     6132         return error .
     6133      end.
     6134     end.
     6135   END PROCEDURE.
     6136   PROCEDURE proc-fill-temp-list :
     6137     define variable v-index               as integer   no-undo .
     6138     define variable v-num-entries-options as integer   no-undo .
     6139     do
     6140     on error undo, return error
     6141     :
     6142       assign
     6143         v-num-entries-options = num-entries("Текущая строка,single,                               Карта,card,                                           Клиент,cli,                                           Группа клиентов,cli-grp,                              Глобальные карты,global,                              Карты фирмы,company,                                  Карты определенного типа,type,                        Все физ.&лица,person,                                 Контрагенты по док-там,waybill,                       С установл. &атр. кл-та,attr,                         С атрибутом кл-та= ,attr-val,                         Значения общих итогов,general-sum-id,                 Значения частных итогов,partial-sum-id,               Дата посл.изм.общих итогов,last-change-general-sum-id,Дата посл.изм.частных итогов,last-change-partial-sum-id,Карты со свойством,dcp,                               Карты стоплиста,stop-list,                            Удаленные,deleted,                                    Карты по продаже,inkas,                               Карты по чеку,chk-doc,                                Карты кл-тов из списка,cli-list,                      Карты док-тов из списка,doc-list,                     Карты чеков из списка,chk-list,                       Файл,file,                                            Хранимый в БД список,clob-data,                         Фильтр,filter,                                        Все карты, all")
     6144       .
     6145       do v-index = 1 to v-num-entries-options by 2
     6146       :
     6147         create temp-list.
     6148         assign
     6149           temp-list.fname  = trim(entry(v-index
     6150                                        ,"Текущая строка,single,                               Карта,card,                                           Клиент,cli,                                           Группа клиентов,cli-grp,                              Глобальные карты,global,                              Карты фирмы,company,                                  Карты определенного типа,type,                        Все физ.&лица,person,                                 Контрагенты по док-там,waybill,                       С установл. &атр. кл-та,attr,                         С атрибутом кл-та= ,attr-val,                         Значения общих итогов,general-sum-id,                 Значения частных итогов,partial-sum-id,               Дата посл.изм.общих итогов,last-change-general-sum-id,Дата посл.изм.частных итогов,last-change-partial-sum-id,Карты со свойством,dcp,                               Карты стоплиста,stop-list,                            Удаленные,deleted,                                    Карты по продаже,inkas,                               Карты по чеку,chk-doc,                                Карты кл-тов из списка,cli-list,                      Карты док-тов из списка,doc-list,                     Карты чеков из списка,chk-list,                       Файл,file,                                            Хранимый в БД список,clob-data,                         Фильтр,filter,                                        Все карты, all"
     6151                                        )
     6152                                  ,chr(32)
     6153                                  )
     6154           temp-list.fvalue = trim(entry(v-index + 1
     6155                                        ,"Текущая строка,single,                               Карта,card,                                           Клиент,cli,                                           Группа клиентов,cli-grp,                              Глобальные карты,global,                              Карты фирмы,company,                                  Карты определенного типа,type,                        Все физ.&лица,person,                                 Контрагенты по док-там,waybill,                       С установл. &атр. кл-та,attr,                         С атрибутом кл-та= ,attr-val,                         Значения общих итогов,general-sum-id,                 Значения частных итогов,partial-sum-id,               Дата посл.изм.общих итогов,last-change-general-sum-id,Дата посл.изм.частных итогов,last-change-partial-sum-id,Карты со свойством,dcp,                               Карты стоплиста,stop-list,                            Удаленные,deleted,                                    Карты по продаже,inkas,                               Карты по чеку,chk-doc,                                Карты кл-тов из списка,cli-list,                      Карты док-тов из списка,doc-list,                     Карты чеков из списка,chk-list,                       Файл,file,                                            Хранимый в БД список,clob-data,                         Фильтр,filter,                                        Все карты, all"
     6156                                        )
     6157                                  ,chr(32)
     6158                                  )
     6159           temp-list.id     = v-index
     6160         .
     6161       end.
     6162     end.
     6163   END PROCEDURE.
     6164   procedure proc-b-macro :
     6165   define input parameter p-option as character no-undo .
     6166   define variable glog as logical no-undo .
     6167   define variable v-id as integer no-undo .
     6168   define variable v-result as character no-undo .
     6169   define variable v-des as character no-undo .
     6170   define variable v-hist-mode as character no-undo .
     6171   define variable v-file as logical no-undo .
     6172   define variable v-full-path        as character no-undo .
     6173   define variable v-path             as character no-undo .
     6174   define variable v-file-name        as character no-undo .
     6175   define variable v-file-name-no-ext as character no-undo .
     6176   define variable v-file-name-ext    as character no-undo .
     6177   define variable v-rid-list as character no-undo .
     6178   define variable v-ok as logical no-undo .
     6179   define buffer buf_dc-list-hist for dc-list-hist.
     6180   define buffer buf_clob-bind for ub.clob-bind.
     6181   define buffer buf_clob-data for ub.clob-data.
     6182   do
     6183   on error undo, return error
     6184   :
     6185     if v-macro-is-running then do:
     6186     end.
     6187     else do:
     6188       glog = yes.
     6189       if an-listp-start-macro-id >= 1 then do:
     6190         case p-option:
     6191           when "file" then do:
     6192         message
     6193         "Согласно командам формирования списка из записанного макроса"
     6194         view-as alert-box question buttons OK-Cancel update glog.
     6195           end.
     6196           when "lob" then do:
     6197             message
     6198             "Нелья!"
     6199             view-as alert-box question buttons OK-Cancel update glog.
     6200             run MyEnable in this-procedure .
     6201             return error.
     6202           end.
     6203         end case.
     6204         if not glog then do:
     6205           run MyEnable in this-procedure .
     6206           return error.
     6207         end.
     6208         if an-listp-end-macro-id = ? then do:
     6209           assign
     6210           an-listp-end-macro-id  = v-seq.
     6211           for each macro-list-hist:
     6212             delete macro-list-hist.
     6213           end.
     6214           for each buf_dc-list-hist where
     6215                   buf_dc-list-hist.id >=  an-listp-start-macro-id
     6216             and  buf_dc-list-hist.id <=  an-listp-end-macro-id:
     6217             create macro-list-hist.
     6218             buffer-copy buf_dc-list-hist
     6219             except id num-recs num-add num-ignored
     6220             to macro-list-hist
     6221             assign
     6222             macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6223             v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6224             macro-list-hist.done = no
     6225             .
     6226           end.
     6227         end.
     6228         else do:
     6229           find last macro-list-hist no-error.
     6230           if available macro-list-hist then do:
     6231             v-id = macro-list-hist.id.
     6232           end.
     6233         end.
     6234       end.
     6235       else do:
     6236         case p-option:
     6237           when "file" then do:
     6238         message
     6239         "Согласно командам формирования списка из ранее сохраненного в файле макроса"
     6240         view-as alert-box question buttons OK-Cancel update glog.
     6241         if not glog then do:
     6242           run MyEnable in this-procedure .
     6243           return error.
     6244         end.
     6245         system-dialog get-file f-name
     6246           filters "Макрос формирования списка *.dcm" "*.dcm"
     6247           title "Выберите файл макроса"
     6248           INITIAL-DIR "."
     6249           return-to-start-dir
     6250           must-exist
     6251           update glog
     6252           default-extension "dcm".
     6253         if not glog then do:
     6254           run MyEnable in this-procedure .
     6255           return error.
     6256         end.
     6257           end.
     6258           when "lob" then do:
     6259             message
     6260             "Согласно командам формирования списка из макроса, сохраненного в БД"
     6261             view-as alert-box question buttons OK-Cancel update glog.
     6262             if not glog then do:
     6263               run MyEnable in this-procedure .
     6264               return error.
     6265             end.
     6266             run ref/clobbnds.w ( input parparentproc
     6267                                 ,input this-procedure:handle
     6268                                 ,input 'b-sel'
     6269                                 ,input "uniq-key-rec"
     6270                                 ,input ""
     6271                                 ,input 'list-macro':U
     6272                                 ,input 'dc-list'
     6273                                 ,input -1
     6274                                 ,input-output v-rid-list) no-error.
     6275             if v-rid-list = '' then do:
     6276               run MyEnable in this-procedure.
     6277               return error.
     6278             end.
     6279             find first buf_clob-bind no-lock where
     6280                       recid(buf_clob-bind) = integer(v-rid-list) no-error.
     6281             if not available buf_clob-bind then do:
     6282               message
     6283               "Не найдена ссылка на макрос, сохраненный в БД!"
     6284               view-as alert-box error .
     6285               run MyEnable in this-procedure .
     6286               return error.
     6287             end.
     6288             find first buf_clob-data no-lock where
     6289                       buf_clob-data.db-num = buf_clob-bind.db-num
     6290                   and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     6291             if not available buf_clob-data then do:
     6292               message
     6293               "Не найдена ссылка на макрос, сохраненный в БД!"
     6294               view-as alert-box error .
     6295               run MyEnable in this-procedure .
     6296               return error.
     6297             end.
     6298             if buf_clob-data.db-num <> v-cntxt-db-num then do:
     6299               message
     6300               substitute("Возможно, не все действия пользователя БД &1 удастся воспроизвести!&2Продолжить?"
     6301                         , buf_clob-data.db-num
     6302                         , chr(10))
     6303              view-as alert-box question buttons yes-no update v-ok.
     6304              if not v-ok then do:
     6305                 run MyEnable in this-procedure .
     6306                 return error.
     6307              end.
     6308             end.
     6309             run gbl/_tmpfile.p ( input ""
     6310                           ,input "tmp"
     6311                           ,output v-file-name) .
     6312             copy-lob from object buf_clob-data.cdata
     6313             to file f-name.
     6314             run gbl/filename.p
     6315               (input  v-file-name
     6316               ,output f-name
     6317               ,output v-path
     6318               ,output v-file-name
     6319               ,output v-file-name-no-ext
     6320               ,output v-file-name-ext
     6321               ) no-error .
     6322             if error-status:error then do:
     6323             end.
     6324           end.
     6325         end case.
     6326         for each macro-list-hist:
     6327           delete macro-list-hist.
     6328         end.
     6329         input stream sout from value (f-name).
     6330         _macro:
     6331         repeat:
     6332           create macro-list-hist.
     6333           import stream sout macro-list-hist no-error.
     6334           if error-status:error then do:
     6335               undo _macro, next _macro.
     6336           end.
     6337           assign
     6338           macro-list-hist.num-rec = 0
     6339           macro-list-hist.num-add = 0
     6340           macro-list-hist.num-ignored = 0
     6341           v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6342           macro-list-hist.done = no
     6343           .
     6344         end.
     6345         find first macro-list-hist where
     6346                 macro-list-hist.id = 0.
     6347         delete macro-list-hist.
     6348         input stream sout close.
     6349         If p-option = "lob" then do:
     6350          os-delete value(f-name).
     6351         end.
     6352         v-file = yes.
     6353       end.
     6354       an-listp-macros-label-id = v-seq.
     6355       run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     6356                                           , input-output v-seq
     6357                                           , input 0
     6358                                           , input '>':U
     6359                                           , input (if v-file
     6360                                                   then substitute("Файл макроса : &1", f-name)
     6361                                                   else substitute("Записанный макрос")
     6362                                                   )
     6363                                           , input tot-lns
     6364                                           , input 'macro':U
     6365                                           , input '':U
     6366                                           , input (if v-file then f-name else '':U)
     6367                                           , input '':U
     6368                                           , input ?
     6369                                           ).
     6370     end.
     6371     disable
     6372     b-record
     6373     b-macro
     6374     with frame Dialog-Frame .
     6375     hide
     6376     b-record in frame Dialog-Frame .
     6377     enable
     6378     b-clear-macro with frame Dialog-Frame .
     6379     v-macro-is-running = yes.
     6380     run str/listmcro.w (input parparentproc
     6381                   ,input this-procedure:handle
     6382                  ,input "Макрос формирования списка карт" + chr(4) + "dcm"
     6383                   ,input "b-play,b-step"
     6384                   ,input-output v-current-step
     6385                   ,input v-id
     6386                   ,output v-result) no-error .
     6387     if error-status:error
     6388     or v-result = "b-stop"
     6389     or v-result = 'end':U
     6390     then do:
     6391       for each macro-list-hist:
     6392         delete macro-list-hist.
     6393       end.
     6394       assign
     6395       an-listp-start-macro-id = ?
     6396       an-listp-end-macro-id = ?
     6397       an-listp-macros-label-id = 0
     6398       .
     6399       menu-item m-macro-file:label in menu m-play = "Сохраненный в файле макрос формирования списка товаров".
     6400       menu-item m-macro-lob:sensitive in menu m-play = yes.
     6401       if v-result = 'b-stop' then do:
     6402         assign
     6403         v-hist-mode = '[]':U
     6404         v-des = "Выполнение макроса прекращено пользователем"
     6405         .
     6406         hide
     6407         b-clear-macro
     6408         b-stop
     6409         in frame Dialog-Frame .
     6410         enable
     6411         b-record
     6412         with frame Dialog-Frame .
     6413       end.
     6414       if v-result = 'end' then do:
     6415         assign
     6416         v-hist-mode = '<':U
     6417         v-des = "Выполнение макроса завершено"
     6418         .
     6419         hide
     6420         b-clear-macro
     6421         b-stop
     6422         in frame Dialog-Frame .
     6423         enable
     6424         b-record
     6425         with frame Dialog-Frame .
     6426       end.
     6427       if error-status:error then do:
     6428         assign
     6429         v-hist-mode = 'E':U
     6430         v-des = "Выполнение макроса прекращено из-за ошибки"
     6431         .
     6432       end.
     6433       run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     6434                                           , input-output v-seq
     6435                                           , input 0
     6436                                           , input v-hist-mode
     6437                                           , input v-des
     6438                                           , input tot-lns
     6439                                           , input 'macro':U
     6440                                           , input '':U
     6441                                           , input f-name
     6442                                           , input '':U
     6443                                           , input ?
     6444                                           ) no-error .
     6445       assign
     6446       v-macro-is-running = no
     6447       v-current-step = 0
     6448       .
     6449     end.
     6450     enable
     6451     b-macro
     6452     with frame Dialog-Frame .
     6453   end.
     6454   end procedure.
     6455   procedure proc-create-macro-list-hist :
     6456   define input parameter p-list-table as character no-undo .
     6457   define input parameter p-id as integer           no-undo .
     6458   define input parameter p-line as integer         no-undo .
     6459   define input parameter p-hist-mode as character  no-undo .
     6460   define input parameter p-des as character        no-undo .
     6461   define input parameter p-option_ as character    no-undo .
     6462   define input parameter p-item_ as character      no-undo .
     6463   define input parameter p-status_ as character    no-undo .
     6464   define buffer buf_macro-list-hist for macro-list-hist.
     6465   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     6466     do
     6467     on error undo, return error return-value
     6468     :
     6469       create buf_macro-list-hist.
     6470       assign
     6471       buf_macro-list-hist.list-table = p-list-table
     6472       buf_macro-list-hist.id         = p-id
     6473       buf_macro-list-hist.line       = p-line
     6474       buf_macro-list-hist.hist-mode  = p-hist-mode
     6475       buf_macro-list-hist.des        = p-des
     6476       buf_macro-list-hist.option_    = p-option_
     6477       buf_macro-list-hist.item_      = p-item_
     6478       buf_macro-list-hist.status_    = p-status_
     6479       .
     6480       if p-keep-query then do:
     6481         create buf_keep-macro-list-hist.
     6482         buffer-copy buf_macro-list-hist to buf_keep-macro-list-hist.
     6483       end.
     6484     end.
     6485   end procedure.
     6486   procedure proc-macro-play :
     6487   define input parameter p-id as integer no-undo .
     6488   define input parameter p-step as logical no-undo .
     6489   define input parameter p-max-id as integer no-undo .
     6490   define variable v-id as integer no-undo .
     6491   define variable v-rowid   as rowid no-undo .
     6492   define variable v-tbl-name as character no-undo .
     6493   define variable v-old-seq as integer no-undo .
     6494   define variable v-current-id as integer no-undo .
     6495   define variable v-temp-seq as integer no-undo .
     6496   define variable v-rs-do-error as logical no-undo .
     6497   define  buffer buf_macro-list-hist for macro-list-hist.
     6498   define  buffer buf_dc-list-hist for dc-list-hist.
     6499   do
     6500   on error undo, return error return-value
     6501   :
     6502     for each macro-list-hist where (p-id = 0 or macro-list-hist.id = p-id):
     6503       assign
     6504       v-current-id = v-current-id + 1
     6505       v-id = macro-list-hist.id.
     6506       CASE entry(1, macro-list-hist.option_, chr(4)):
     6507         when 'macro':U
     6508         or
     6509         when 'title':U
     6510         or
     6511         when 'start':U
     6512         then do:
     6513         end.
     6514         when 'clear':U then do:
     6515           for each dc-list:
     6516             delete dc-list.
     6517           end.
     6518           for each dc-list-hist where dc-list-hist.id > an-listp-macros-label-id:
     6519             delete dc-list-hist.
     6520           end.
     6521           tot-lns = 0.
     6522           v-seq = an-listp-macros-label-id + 1.
     6523           v-no-hist = 0.
     6524           create buf_dc-list-hist.
     6525           buffer-copy macro-list-hist
     6526           to buf_dc-list-hist
     6527           assign buf_dc-list-hist.id = v-seq
     6528           v-temp-seq = v-seq
     6529           v-seq = v-seq + 1
     6530           v-no-hist = v-no-hist + 1
     6531           .
     6532           run MyEnable in this-procedure .
     6533         end.
     6534         when 'single' then do:
     6535            run gen-row-keyr  in this-procedure (  input  macro-list-hist.item_
     6536                                                 ,input ?
     6537                                                 ,input 'ub'
     6538                                                 ,input ?
     6539                                                 ,input no-lock
     6540                                                 ,output v-rowid
     6541                                                 ,output v-tbl-name) no-error .
     6542           if not error-status:error then do:
     6543             CASE macro-list-hist.hist-mode:
     6544               when '+':U then do:
     6545                 run proc-b-add in this-procedure(input yes
     6546                                                 ,input v-rowid
     6547                                                 ,input macro-list-hist.option_
     6548                                                 ,input macro-list-hist.status_) no-error .
     6549               end.
     6550               when '-':U then do:
     6551                 run proc-b-del in this-procedure(input yes
     6552                                                 ,input v-rowid
     6553                                                 ,input macro-list-hist.option_
     6554                                                 ,input macro-list-hist.status_) no-error .
     6555               end.
     6556               when '*':U then do:
     6557                 run proc-b-rest in this-procedure(input yes
     6558                                                  ,input v-rowid
     6559                                                  ,input macro-list-hist.option_
     6560                                                  ,input macro-list-hist.status_) no-error .
     6561               end.
     6562             END.
     6563             if error-status:error then do:
     6564                 return ("error" + chr(4) + return-value) .
     6565             end.
     6566             find first  buf_dc-list-hist where
     6567                     buf_dc-list-hist.id = v-seq - 1 no-error .
     6568             if available buf_dc-list-hist then
     6569             assign
     6570             macro-list-hist.num-recs = buf_dc-list-hist.num-recs
     6571             macro-list-hist.num-add = buf_dc-list-hist.num-add
     6572             macro-list-hist.num-ignored = buf_dc-list-hist.num-ignored
     6573             .
     6574           end.
     6575           else do:
     6576             return ("error" + chr(4) + return-value).
     6577           end.
     6578         end.
     6579         otherwise do:
     6580           if can-find(first temp-list where temp-list.fvalue = macro-list-hist.option_)
     6581           or lookup(macro-list-hist.option_, '':U) > 0
     6582           then do:
     6583             if macro-list-hist.line = 0 then do:
     6584               v-no-hist = 0.
     6585               for each buf_macro-list-hist where
     6586                       buf_macro-list-hist.id = v-id:
     6587                 create buf_dc-list-hist.
     6588                 buffer-copy buf_macro-list-hist
     6589                 except id  num-recs num-add num-ignored done
     6590                 to buf_dc-list-hist
     6591                 assign
     6592                 buf_dc-list-hist.id = (if buf_macro-list-hist.line =0 then v-seq else v-temp-seq)
     6593                 v-temp-seq = (if buf_macro-list-hist.line = 0 then v-seq else v-temp-seq )
     6594                 v-seq = (if buf_macro-list-hist.line = 0
     6595                         then (v-seq + 1)
     6596                         else v-seq)
     6597                 v-no-hist = v-no-hist + 1
     6598                 .
     6599               end.
     6600               if v-no-hist = 1 then v-no-hist = 0.
     6601               run rs-do in this-procedure (input yes
     6602                                         , input p-step
     6603                                         , input macro-list-hist.option_
     6604                                         , input macro-list-hist.status_
     6605                                         , input get-line-mode(macro-list-hist.hist-mode)
     6606                                         , input v-temp-seq
     6607                                         ) no-error .
     6608               if error-status:error then do:
     6609                 assign
     6610                 v-rs-do-error = yes.
     6611               end.
     6612               if get-line-mode(macro-list-hist.hist-mode) = 'ОСТАВИТЬ':U then do:
     6613                 run proc-b-rest-2 in this-procedure .
     6614                 run MyEnable in this-procedure .
     6615               end.
     6616               for each buf_dc-list-hist where
     6617                       buf_dc-list-hist.id = v-temp-seq,
     6618                  first buf_macro-list-hist where
     6619                       buf_macro-list-hist.id = v-id
     6620                   AND buf_macro-list-hist.line = buf_dc-list-hist.line:
     6621                  assign
     6622                  buf_macro-list-hist.num-recs = buf_dc-list-hist.num-recs
     6623                  buf_macro-list-hist.num-add = buf_dc-list-hist.num-add
     6624                  buf_macro-list-hist.num-ignored = buf_dc-list-hist.num-ignored
     6625                  .
     6626               end.
     6627               if v-rs-do-error then do:
     6628                 run MyEnable in this-procedure .
     6629                 return ("error" + chr(4) + return-value).
     6630               end.
     6631               v-id = macro-list-hist.id.
     6632             end.
     6633           end.
     6634         end.
     6635       END CASE.
     6636     end.
     6637   end.
     6638   end procedure.
     6639   procedure proc-b-rest-2 :
     6640     do
     6641     on error undo, return error
     6642     :
     6643       for each dc-list:
     6644         if dc-list.to-del = ? then do:
     6645           assign
     6646           dc-list.to-del = no
     6647           .
     6648         end.
     6649         else do:
     6650           delete dc-list.
     6651         end.
     6652       end.
     6653       tot-lns = lns-cnt.
     6654     end.
     6655   end procedure.
     6656   PROCEDURE proc-expand :
     6657   define input parameter p-shift as integer no-undo .
     6658   define input parameter p-from as integer no-undo .
     6659   define input parameter p-to as integer no-undo .
     6660   define input parameter p-forcer-name as character no-undo .
     6661   define variable fh as widget-handle no-undo .
     6662   define variable hh as widget-handle no-undo .
     6663   define variable lh as widget-handle no-undo .
     6664   define variable ii as INTEGER no-undo .
     6665   ASSIGN
     6666   fh = frame Dialog-Frame:first-child
     6667   hh = fh:first-child
     6668   .
     6669   CASE v-expand:
     6670     WHEN YES THEN DO:
     6671       ASSIGN
     6672       v-expand = NO.
     6673       DO ii = 1 TO NUM-ENTRIES(v-downed):
     6674         ASSIGN
     6675         hh              = WIDGET-HANDLE(ENTRY(ii, v-downed))
     6676         hh:ROW          = (hh:ROW - p-shift).
     6677         hh:height-chars = (if hh:type = "browse" then (hh:height-chars + p-shift) else hh:height-chars).
     6678       END.
     6679     END.
     6680     WHEN NO THEN DO:
     6681       v-expand = YES.
     6682       v-downed = ''.
     6683       _do:
     6684       do while valid-handle(hh):
     6685         IF lookup(hh:type, "radio-set,browse,button,fill-in,literal,text,rectangle") > 0
     6686          AND hh:ROW >= p-from
     6687          AND hh:ROW <= p-to
     6688          and lookup(hh:name, p-forcer-name) = 0
     6689          THEN DO:
     6690           hh:height-chars = (if hh:type = "browse" then (hh:height-chars - p-shift) else hh:height-chars).
     6691           hh:ROW          = (hh:ROW + p-shift).
     6692           ASSIGN
     6693           v-downed = v-downed + chr(44) + STRING(hh).
     6694           IF hh:TYPE = "fill-in"
     6695           AND valid-handle(hh:side-label-handle) THEN dO:
     6696             assign
     6697             lh = hh:SIDE-LABEL-HANDLE
     6698             lh:ROW = lh:ROW + p-shift
     6699             v-downed = v-downed + chr(44) + STRING(lh)
     6700             .
     6701            END.
     6702          END.
     6703          hh = hh:next-sibling.
     6704       END.
     6705       v-downed = trim(v-downed, chr(44)).
     6706     END.
     6707   END CASE.
     6708   END PROCEDURE.
     6709   MAIN-BLOCK:
     6710   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     6711     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     6712     if lookup("automain", parparentproc:file-name, ".") > 0 then do:
     6713       v-no-context = yes.
     6714     end.
     6715     else do:
     6716   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6717     run mainmenu_getcntxt in parparentproc
     6718       (output v-cntxt-db-num
     6719       ,output v-cntxt-userid
     6720       ,output v-cntxt-level
     6721       ,output v-cntxt-host-code-obj
     6722       ,output v-cntxt-obj-type
     6723       ,output v-cntxt-obj-code
     6724       ,output v-cntxt-db-num-obj
     6725       ,output v-cntxt-is-admin
     6726       ) .
     6727     end.
     6728   define variable vss-include-info52 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6729   do:
     6730     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6731       (input  v-cntxt-db-num
     6732       ,input  v-cntxt-userid
     6733       ,input  0
     6734       ,input  'actn_documents_all':U
     6735       ,input  'global':U
     6736       ,input  0
     6737       ,input  '':U
     6738       ,input  0
     6739       ,input  0
     6740       ,input  0
     6741       ,input  0
     6742       ,input  false
     6743       ,output v-docs-all
     6744       )  .
     6745   end.
     6746   define variable vss-include-info53 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6747   do:
     6748     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6749       (input  v-cntxt-db-num
     6750       ,input  v-cntxt-userid
     6751       ,input  0
     6752       ,input  'actn_documents_company':U
     6753       ,input  'firm':U
     6754       ,input  v-cntxt-host-code-obj
     6755       ,input  '':U
     6756       ,input  0
     6757       ,input  0
     6758       ,input  0
     6759       ,input  0
     6760       ,input  false
     6761       ,output v-docs-cmp
     6762       )  .
     6763   end.
     6764     run get-report-num in parparentproc ( output g#report-num ).
     6765     assign
     6766       line-rec = ?
     6767       .
     6768       assign
     6769       n-c:radio-buttons in frame Dialog-Frame =
     6770       "Номер" + chr(44) + 'карта':U + chr(44) +
     6771       "Код кл." + chr(44) + 'Контрагент':U
     6772       RS-status:radio-buttons = "Текущие&+" + chr(44) + 'тек':U + chr(44) +
     6773                                 "Все&!" + chr(44) + 'все':U + chr(44) +
     6774                                 "Удаленные&-" + chr(44) + 'удал':U + chr(44) +
     6775                                 "Блокированные&0" + chr(44) + 'блок':U
     6776       RS-status = 'тек':U
     6777       .
     6778     ASSIGN b-save:MENU-MOUSE = 1.
     6779     ASSIGN b-print:MENU-MOUSE = 1.
     6780     assign b-macro:menu-mouse = 1.
     6781     run proc-fill-temp-list in this-procedure .
     6782     if lookup(bttns, "hide") > 0 then do:
     6783       return.
     6784     end.
     6785     RUN Myenable in this-procedure .
     6786     APPLY "VALUE-CHANGED" to n-c.
     6787     WAIT-FOR GO OF FRAME Dialog-Frame.
     6788   END.
     6789   RUN disable_UI.
     6790   procedure cb_fill-lob-res-list :
     6791   define input  parameter p-full-path as character no-undo .
     6792   output to value (p-full-path).
     6793   for each dc-list:
     6794     export
     6795     dc-list.d-card
     6796     dc-list.cli-type
     6797     dc-list.cli-code.
     6798   end.
     6799   output close.
     6800   end procedure.
     6801   procedure cb_fill-lob-res-list-macro :
     6802   define input  parameter p-full-path as character no-undo .
     6803   define buffer buf_dc-list-hist for dc-list-hist.
     6804   output to value (p-full-path).
     6805   for each buf_dc-list-hist:
     6806       export
     6807       buf_dc-list-hist.
     6808   end.
     6809   output close.
     6810   end procedure.
     6811   PROCEDURE disable_UI :
     6812     HIDE FRAME Dialog-Frame.
     6813   END PROCEDURE.
     6814   PROCEDURE enable_UI :
     6815     DISPLAY dsp-rs NameOrCode n-c RS-Status ed-notes f-tot-lns
     6816         WITH FRAME Dialog-Frame.
     6817     ENABLE dsp-rs BR-option B-exit B-save B-print B-hist B-lkp B-clr B-Help B-add
     6818            B-del B-rest B-macro B-stop B-clear-macro B-record NameOrCode n-c
     6819            RS-Status BR-list ed-notes f-tot-lns
     6820         WITH FRAME Dialog-Frame.
     6821     VIEW FRAME Dialog-Frame.
     6822     OPEN QUERY BR-list FOR EACH dc-list       WHERE dc-list.emitent-host-code = p-curr-host-code NO-LOCK     BY dc-list.d-card INDEXED-REPOSITION.     open query br-option for each temp-list no-lock .
     6823   END PROCEDURE.
     6824   procedure proc-macros :
     6825   define variable glog as logical no-undo .
     6826   define variable v-option as integer no-undo .
     6827   define buffer buf_dc-list-hist for dc-list-hist.
     6828   define buffer buf_macro-list-hist for macro-list-hist.
     6829   if can-find(first macro-list-hist) then do:
     6830     run gbl/d-askw.w ( input "Сохранение макроса"
     6831                   ,input "Выберите какие действия по формированию списка Вы хотите сохранить"
     6832                   ,input "|"
     6833                   ,input "Посл.ЗАПИСЬ|Все|Отказ"
     6834                   ,input "Действия при нажатой кнопке ЗАПИСЬ|ВСЯ последовательность действий|Отказ"
     6835                   ,input 1
     6836                   ,input 3
     6837                   ,output v-option).
     6838     if v-option = 3 then return no-apply.
     6839     v-option = 1.
     6840   end.
     6841   else do:
     6842     message
     6843     "Будет сохранена в файл ВСЯ последовательность действий по формированию списка" skip
     6844     view-as alert-box question buttons yes-no update glog.
     6845     v-option = 2.
     6846     if not glog then do:
     6847       return no-apply.
     6848     end.
     6849   end.
     6850     do
     6851     on error undo, return error
     6852     :
     6853     assign
     6854       f-name = "default.dcm"
     6855       glog = yes
     6856       .
     6857     system-dialog get-file f-name
     6858       filters "Макрос создания списка карт *.dcm" "*.dcm"
     6859       ask-overwrite
     6860       save-as
     6861       use-filename
     6862       update glog
     6863       default-extension "dcm".
     6864     if not glog then do:
     6865       apply "entry" to br-list in frame Dialog-Frame.
     6866       return no-apply.
     6867     end.
     6868     run waitfram-show in this-procedure ("Сохранение макроса формирования списка карт.    ЖДИТЕ...").
     6869     output stream PrnLibStream to value (f-name).
     6870     case v-option:
     6871       when 1 then do:
     6872         for each buf_macro-list-hist:
     6873           export stream PrnLibStream
     6874           buf_macro-list-hist.
     6875         end.
     6876       end.
     6877       when 2 then do:
     6878     for each buf_dc-list-hist:
     6879         export stream PrnLibStream
     6880         buf_dc-list-hist.
     6881     end.
     6882       end.
     6883     end case.
     6884     output stream PrnLibStream close.
     6885     run waitfram-hide in this-procedure .
     6886     end.
     6887   end procedure.
     6888   procedure m_dc-save-db-proc :
     6889   define variable v-rid-list as character no-undo .
     6890   run ref/clobbnds.w ( input parparentproc
     6891                       ,input this-procedure:handle
     6892                       ,input 'b-add'
     6893                       ,input "uniq-key-rec"
     6894                       ,input 'ИЗМЕНЕНИЕ':U
     6895                       ,input 'list':U
     6896                       ,input 'dc-list'
     6897                       ,input -1
     6898                       ,input-output v-rid-list) no-error.
     6899   end procedure.
     6900   procedure m-macros-save-db-proc :
     6901   define variable v-rid-list as character no-undo .
     6902   run ref/clobbnds.w ( input parparentproc
     6903                       ,input this-procedure:handle
     6904                       ,input 'b-add'
     6905                       ,input "uniq-key-rec"
     6906                       ,input 'ИЗМЕНЕНИЕ':U
     6907                       ,input 'list-macro':U
     6908                       ,input 'dc-list'
     6909                       ,input -1
     6910                       ,input-output v-rid-list) no-error.
     6911   end procedure.
     6912   PROCEDURE MyEnable :
     6913   define variable v-start as logical no-undo .
     6914   define buffer buf_temp-list for temp-list.
     6915   define variable v-recid0 as recid no-undo.
     6916   define buffer buf_dc-list-hist for dc-list-hist.
     6917   find first buf_dc-list-hist where buf_dc-list-hist.id = 0 no-error.
     6918   if available buf_dc-list-hist then
     6919   assign
     6920   frame Dialog-Frame:title = substitute("СПИСОК  КАРТ &1",  string(buf_dc-list-hist.des, "X(60)"))
     6921   .
     6922   br-option:column-scrolling in frame Dialog-Frame  = no.
     6923   if tot-lns = ? then do:
     6924     v-start = yes.
     6925     for each l-dc-list :
     6926       accumulate l-dc-list.d-card (count).
     6927     end.
     6928     tot-lns = (accum count l-dc-list.d-card).
     6929     if tot-lns > 0 then do:
     6930       find last  buf_dc-list-hist no-error .
     6931       v-seq = (if available buf_dc-list-hist then buf_dc-list-hist.id else 0)  + 1.
     6932       run create-dc-list-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     6933                                             , input-output v-seq
     6934                                             , input 0
     6935                                             , input 'S':U
     6936                                             , input substitute("# Исходный список: &1 строк", tot-lns)
     6937                                             , input tot-lns
     6938                                             , input "start":U
     6939                                             , input '':U
     6940                                             , input '':U
     6941                                             , input '':U
     6942                                             , input ?
     6943                                             ).
     6944     end.
     6945     else do:
     6946       line-mode = 'ДОБАВЛЕНИЕ':U.
     6947       for each buf_dc-list-hist:
     6948         delete buf_dc-list-hist.
     6949       end.
     6950       v-seq = 1.
     6951       run create-dc-list-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     6952                                             , input-output v-seq
     6953                                             , input 0
     6954                                             , input '':U
     6955                                             , input "# Исходный список карт пуст."
     6956                                             , input tot-lns
     6957                                             , input 'start':U
     6958                                             , input '':U
     6959                                             , input '':U
     6960                                             , input '':U
     6961                                             , input ?
     6962                                             ).
     6963     end.
     6964   end.
     6965   assign
     6966   nameorcode = ""
     6967   RS-list-method = "single".
     6968   find first buf_temp-list no-lock where
     6969               buf_temp-list.fvalue = "single".
     6970   assign
     6971   v-recid0 = recid(buf_temp-list).
     6972   open query br-option for each temp-list no-lock .
     6973     if v-seq > 1 then
     6974     find last buf_dc-list-hist no-lock where
     6975               buf_dc-list-hist.id = (v-seq - 1)
     6976          and  buf_dc-list-hist.line = 0 no-error .
     6977     DISPLAY br-option
     6978     (if available buf_dc-list-hist
     6979     then buf_dc-list-hist.des
     6980     else '') @ dsp-rs
     6981     RS-Status WITH FRAME Dialog-Frame.
     6982     ENABLE
     6983     b-macro  when v-start
     6984     b-record when v-start
     6985     b-exit b-add b-hist b-help br-option br-list RS-Status WITH FRAME Dialog-Frame.
     6986     if v-start then do:
     6987       hide
     6988       b-stop
     6989       b-clear-macro
     6990       in frame Dialog-Frame.
     6991     end.
     6992     v-start = no.
     6993     hide nameorcode in frame Dialog-Frame .
     6994     reposition br-option to recid v-recid0.
     6995     if tot-lns > 0 then
     6996       ENABLE
     6997       b-print
     6998       b-rest
     6999       b-save
     7000       b-del
     7001       b-lkp
     7002       b-clr
     7003       n-c
     7004       nameorcode
     7005       WITH FRAME Dialog-Frame.
     7006   else do:
     7007     DISABLE b-print b-rest b-save b-del b-lkp b-clr nameorcode WITH FRAME Dialog-Frame.
     7008   end.
     7009     if tot-lns = ? or tot-lns = 0 then do:
     7010       hide nameorcode in frame Dialog-Frame .
     7011     end.
     7012     VIEW FRAME Dialog-Frame.
     7013     run openbr in this-procedure .
     7014       if line-rec <> ? then
     7015       reposition br-list to recid line-rec no-error.
     7016     display tot-lns @ f-tot-lns with frame Dialog-Frame.
     7017   END PROCEDURE.
     7018   PROCEDURE Openbr :
     7019           Open query br-list
     7020           for each dc-list No-LOCK indexed-reposition.
     7021   APPLY "ENTRY" to br-list in frame Dialog-Frame.
     7022   END PROCEDURE.
     7023   PROCEDURE proc-b-add :
     7024   define input parameter p-from-macro as logical no-undo .
     7025   define input parameter p-rowid as rowid no-undo .
     7026   define input parameter rs-list-method as character no-undo .
     7027   define input parameter rs-status as character no-undo .
     7028   line-mode = 'ДОБАВЛЕНИЕ':U.
     7029   if rs-list-method = "single" then do:
     7030     v-no-hist = - 1.
     7031     if p-from-macro then do:
     7032       find ub.dis-card where rowid(ub.dis-card) = p-rowid no-lock no-error .
     7033     end.
     7034     else do:
     7035       run ref/discards.w ( input parparentproc
     7036                           ,input "b-sel,b-add"
     7037                           ,input 'все':U
     7038                           ,input p-curr-host-code
     7039                           ,input p-curr-obj-type
     7040                           ,input p-curr-obj-code
     7041                           ,input '':U
     7042                           ,input ?
     7043                           ,output ref-list).
     7044       apply "entry" to br-list in frame Dialog-Frame.
     7045       if ref-list = "" then return error.
     7046       find ub.dis-card where recid (ub.dis-card) = integer (ref-list) no-lock.
     7047     end.
     7048     if available dis-card then do:
     7049       run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     7050       tot-lns = tot-lns + 1.
     7051       run write-hist in this-procedure (p-from-macro, rs-list-method, rs-status, line-mode).
     7052     end.
     7053     else do:
     7054       return error "Нет в БД такой карты".
     7055     end.
     7056     run Myenable in this-procedure .
     7057   end.
     7058   else do:
     7059       run rs-do in this-procedure (no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
     7060   end.
     7061   END PROCEDURE.
     7062   PROCEDURE proc-b-del :
     7063   define input parameter p-from-macro as logical no-undo .
     7064   define input parameter p-rowid as rowid no-undo .
     7065   define input parameter rs-list-method as character no-undo .
     7066   define input parameter rs-status as character no-undo .
     7067   define variable glog as logical no-undo .
     7068   define variable v-rep-rec as recid no-undo .
     7069   line-mode = 'удаление':U.
     7070   if rs-list-method = "single" then do:
     7071     v-no-hist = - 1.
     7072     if p-from-macro then do:
     7073       find first ub.dis-card where rowid(ub.dis-card) = p-rowid no-error.
     7074       if not available ub.dis-card then return error "Нет в БД такой карты".
     7075       find first dc-list where dc-list.d-card = ub.dis-card.d-card no-error.
     7076     end.
     7077     if available dc-list then do:
     7078       line-rec = recid (dc-list).
     7079       get next br-list.
     7080       if available dc-list then v-rep-rec = recid (dc-list).
     7081       else do:
     7082         reposition br-list to recid line-rec no-error.
     7083         get prev br-list.
     7084         if available dc-list then v-rep-rec = recid (dc-list).
     7085       end.
     7086       reposition br-list to recid line-rec no-error.
     7087       tot-lns = tot-lns - 1.
     7088       run write-hist in this-procedure (p-from-macro, rs-list-method, rs-status, line-mode).
     7089       delete dc-list.
     7090       line-rec = v-rep-rec.
     7091       run Myenable in this-procedure .
     7092     end.
     7093     else do:
     7094       tot-lns = tot-lns - 1.
     7095       run Myenable  in this-procedure .
     7096       return error "Нет в списке карт такой карты".
     7097     end.
     7098   end.
     7099   else do:
     7100     glog = no.
     7101     message
     7102     "Удалить карты из списка ПО заданному УСЛОВИЮ ?   Вы уверены ?"
     7103      view-as alert-box question buttons OK-Cancel update glog.
     7104     if not glog then  return error.
     7105     run rs-do in this-procedure (no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
     7106   end.
     7107   END PROCEDURE.
     7108   PROCEDURE proc-b-rest :
     7109   define input parameter p-from-macro as logical no-undo .
     7110   define input parameter p-rowid as rowid no-undo .
     7111   define input parameter rs-list-method as character no-undo .
     7112   define input parameter rs-status as character no-undo .
     7113   define variable glog as logical no-undo .
     7114   define buffer buf_dc-list-hist for dc-list-hist.
     7115   line-mode = 'ОСТАВИТЬ':U.
     7116   if rs-list-method = "single" then do:
     7117     v-no-hist = - 1.
     7118     if p-from-macro then do:
     7119       find first ub.dis-card where rowid(ub.dis-card) = p-rowid no-error.
     7120       if not available ub.dis-card then return error substitute("Нет в БД такой карты").
     7121       find first dc-list where dc-list.d-card = ub.dis-card.d-card no-error.
     7122     end.
     7123     if available dc-list then do:
     7124       if p-from-macro then do:
     7125          glog = yes.
     7126       end.
     7127       else do:
     7128         glog = no.
     7129         message "Оставить отмеченную строку и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
     7130                 view-as alert-box question buttons OK-Cancel update glog.
     7131         if not glog then return no-apply.
     7132       end.
     7133       line-rec = recid (dc-list).
     7134       v-seq = 1.
     7135       for each buf_dc-list-hist:
     7136         delete buf_dc-list-hist.
     7137       end.
     7138       run write-hist in this-procedure (p-from-macro, rs-list-method, rs-status, line-mode).
     7139       for each dc-list:
     7140         if line-rec <> recid (dc-list) then delete dc-list.
     7141       end.
     7142       tot-lns = 1.
     7143       run Myenable  in this-procedure .
     7144    end.
     7145     else do:
     7146       return error substitute("Нет в списке такой карты").
     7147     end.
     7148   end.
     7149   else do:
     7150     if not p-from-macro then do:
     7151       glog = no.
     7152       message "Оставить карты в списке ПО заданному УСЛОВИЮ и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
     7153       view-as alert-box question buttons OK-Cancel update glog.
     7154       if not glog then
     7155         return no-apply.
     7156     end.
     7157     assign
     7158     lns-cnt = 0
     7159     lns-ignore = 0
     7160     .
     7161     run rs-do in this-procedure (no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
     7162     for each dc-list:
     7163       if dc-list.to-del = ? then do:
     7164         assign
     7165         dc-list.to-del = no
     7166         .
     7167       end.
     7168       else do:
     7169         delete dc-list.
     7170       end.
     7171     end.
     7172     tot-lns = lns-cnt.
     7173     run Myenable  in this-procedure .
     7174     message
     7175     "Оставлено строк :" lns-cnt skip(0)
     7176     string(if lns-ignore <> 0
     7177     then ("Проигнорировано строк :" + string(lns-ignore))
     7178     else "":U)
     7179     .
     7180   end.
     7181   END PROCEDURE.
     7182   procedure proc-file-list-methods :
     7183   define input parameter p-from-macro as logical no-undo .
     7184   define input parameter rs-list-method as character no-undo .
     7185   define input parameter rs-status as character no-undo .
     7186   define input parameter line-mode as character no-undo .
     7187   define input parameter p-id      as integer no-undo .
     7188   define variable ss as character no-undo .
     7189   define variable imp-type like ub.goods.prod-type no-undo.
     7190   define variable imp-code like ub.goods.prod-code no-undo.
     7191   define variable imp-art like ub.goods.artic no-undo.
     7192   define variable imp-doc-code like ub.trn-doc.doc-code no-undo.
     7193   define variable imp-doc-type as character no-undo.
     7194   define variable imp-chk-type as integer no-undo.
     7195   define variable imp-d-card as character no-undo.
     7196   define variable v-full-path        as character no-undo .
     7197   define variable v-path             as character no-undo .
     7198   define variable v-file-name        as character no-undo .
     7199   define variable v-file-name-no-ext as character no-undo .
     7200   define variable v-file-name-ext    as character no-undo .
     7201   define variable v-tbl-row          as rowid no-undo .
     7202   define variable v-tbl-name         as character no-undo .
     7203   define buffer buf_dc-list-hist for dc-list-hist.
     7204   define buffer buf_clob-data for ub.clob-data.
     7205   define buffer buf_clob-bind for ub.clob-bind.
     7206   do
     7207   on error undo, return error
     7208   :
     7209     find first buf_dc-list-hist where
     7210             buf_dc-list-hist.id = p-id
     7211         AND buf_dc-list-hist.item_ <> '':U .
     7212   if rs-list-method = "clob-data" then do:
     7213     run gen-row-keyr in this-procedure (
     7214      input  buf_dc-list-hist.item_
     7215     ,input  ?
     7216     ,input  "ub"
     7217     ,input  ?
     7218     ,input NO-LOCK
     7219     ,output v-tbl-row
     7220     ,output v-tbl-name  ) no-error.
     7221     if error-status :error then do:
     7222       message
     7223       "Ошибка при поиске хранимого файла"
     7224       view-as alert-box error.
     7225       return error.
     7226     end.
     7227     find first buf_clob-bind no-lock where
     7228               rowid(buf_clob-bind) = v-tbl-row .
     7229     find first buf_clob-data no-lock where
     7230               buf_clob-data.db-num = buf_clob-bind.db-num
     7231           and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     7232     if error-status :error then do:
     7233       message
     7234       "Ошибка при пополучении хранимого файла"
     7235       view-as alert-box error.
     7236       return error.
     7237     end.
     7238     run gbl/_tmpfile.p ( input ""
     7239                   ,input "tmp"
     7240                   ,output v-file-name) .
     7241     copy-lob from object buf_clob-data.cdata
     7242     to file v-file-name.
     7243   end.
     7244     run gbl/filename.p
     7245     (input  (if rs-list-method = "clob-data" then v-file-name else buf_dc-list-hist.item_  )
     7246     ,output v-full-path
     7247     ,output v-path
     7248     ,output v-file-name
     7249     ,output v-file-name-no-ext
     7250     ,output v-file-name-ext
     7251     ) no-error .
     7252     if error-status:error then do:
     7253     end.
     7254     else do:
     7255       input stream sout from value (v-full-path).
     7256         CASE rs-list-method:
     7257           when "doc-list" then do:
     7258             repeat:
     7259             import stream sout imp-doc-code imp-doc-type no-error.
     7260             if imp-doc-type <>  'переоценка':U then do:
     7261               find first ub.trn-doc no-lock where
     7262                         ub.trn-doc.doc-code = imp-doc-code No-error.
     7263               if available ub.trn-doc
     7264               and
     7265               (ub.trn-doc.ext-doc-type = 'es':U
     7266                or ub.trn-doc.ext-doc-type = 'rs':U) then do:
     7267                 for each ub.chk-doc no-lock where
     7268                         ub.chk-doc.out-code = (if ub.trn-doc.ext-doc-type = 'es':U
     7269                                             then ub.trn-doc.doc-code
     7270                                             else ub.trn-doc.out-code) and ub.chk-doc.d-card <> "":U,
     7271                     first ub.dis-card no-lock where
     7272                           ub.dis-card.d-card = ub.chk-doc.d-card:
     7273                   run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     7274                 end.
     7275               end.
     7276               else if ub.trn-doc.d-card <> "":U and ub.trn-doc.d-card <> ? then do:
     7277                 find first ub.dis-card no-lock where
     7278                           ub.dis-card.d-card = ub.trn-doc.d-card no-error .
     7279                 if available ub.dis-card then
     7280                   run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     7281               end.
     7282             end.
     7283           end.
     7284         end.
     7285         when "cli-list" then do:
     7286           repeat:
     7287             import stream sout imp-type imp-code no-error.
     7288             find ub.clients where
     7289                 ub.clients.obj-type = imp-type and
     7290                 ub.CLIENTS.OBJ-code = imp-code
     7291                 no-lock no-error.
     7292             if available ub.CLIENTS then do:
     7293               for each ub.dis-card No-LOCK WHERE
     7294                         ub.dis-card.cli-type = ub.clients.obj-type AND
     7295                         ub.dis-card.cli-code = ub.clients.obj-code:
     7296                 run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     7297               end.
     7298             end.
     7299           end.
     7300         end.
     7301         when "chk-list" then do:
     7302           repeat:
     7303             import stream sout imp-doc-code imp-chk-type no-error.
     7304             if imp-chk-type = integer('1':U)
     7305             or imp-chk-type = integer('6':U)
     7306             or imp-chk-type = integer('96':U)
     7307             or imp-chk-type = ? then do:
     7308               find first ub.chk-doc no-lock where
     7309                         ub.chk-doc.doc-code = imp-doc-code No-error.
     7310               if available ub.chk-doc and ub.chk-doc.d-card <> "":U then do:
     7311                 find first ub.dis-card no-lock where
     7312                           ub.dis-card.d-card = ub.chk-doc.d-card no-error.
     7313                 if available ub.dis-card then
     7314                 run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     7315               end.
     7316             end.
     7317           end.
     7318         end.
     7319         when "file"
     7320         or
     7321         when "clob-data"
     7322         then do:
     7323           repeat:
     7324             import stream sout imp-d-card no-error.
     7325             find ub.dis-card where
     7326                 ub.dis-card.d-card = imp-d-card no-lock no-error.
     7327             if available ub.dis-card then run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     7328           end.
     7329           if rs-list-method = "clob-data" then do:
     7330             os-delete value(v-full-path) .
     7331           end.
     7332         end.
     7333       end CASE.
     7334     end.
     7335     input stream sout close.
     7336     assign                                                           buf_dc-list-hist.num-add  = lns-cnt - v-num-add                       buf_dc-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_dc-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_dc-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7337   end.
     7338   end procedure.
     7339   PROCEDURE proc-b-save :
     7340   define input parameter loc-save-option as character no-undo.
     7341   define variable v-frame-width as integer no-undo.
     7342   define variable v-default-valid-date as date no-undo .
     7343   define variable v-codir as character no-undo .
     7344   define variable v-prefix as character no-undo .
     7345   define variable v-dopi as integer no-undo .
     7346   define variable v-default-valid-date-chr as character no-undo .
     7347   define variable glog as logical no-undo .
     7348   define variable v-full-number as character no-undo .
     7349   define variable v-rid-list as character no-undo .
     7350   define buffer buf_clients for ub.clients.
     7351   case loc-save-option:
     7352     when "dc-list":U then do:
     7353       assign
     7354       f-name = "default.dc"
     7355       glog = yes
     7356       .
     7357       system-dialog get-file f-name
     7358       filters "Списки дисконтных карт *.dc" "*.dc"
     7359       ask-overwrite
     7360       save-as
     7361       use-filename
     7362       update glog
     7363       default-extension "dc".
     7364       if not glog then do:
     7365         apply "entry" to br-list in frame Dialog-Frame.
     7366         return no-apply.
     7367       end.
     7368       output to value (f-name).
     7369       for each dc-list:
     7370         export
     7371         dc-list.d-card
     7372         dc-list.cli-type
     7373         dc-list.cli-code
     7374         .
     7375       end.
     7376       output close.
     7377     end.
     7378     when "dc-list-macros-db" then do:
     7379       run m-macros-save-db-proc in this-procedure .
     7380     end.
     7381     when "dc-list-db" then do:
     7382       run m_dc-save-db-proc in this-procedure .
     7383     end.
     7384     when "excel":U then do:
     7385       do on stop  undo, return no-apply
     7386           on error undo, return no-apply
     7387           on quit  undo, return no-apply
     7388         :
     7389         run str/dcl-prn.p (
     7390                          input parparentproc
     7391                         ,input p-curr-host-code
     7392                         ,input p-curr-obj-type
     7393                         ,input p-curr-obj-code
     7394                         ,input "excel":U
     7395                         ,output v-Frame-Width) no-error.
     7396           assign make-excel = no.
     7397           run waitfram-hide in this-procedure .
     7398       end.
     7399     end.
     7400     when "to-make":U then do:
     7401       assign
     7402       f-name = "default.crd"
     7403       glog = yes
     7404       .
     7405       system-dialog get-file f-name
     7406       filters "Списки ДК для изготовления *.crd" "*.crd"
     7407       ask-overwrite
     7408       save-as
     7409       use-filename
     7410       update glog
     7411       default-extension "crd".
     7412       if not glog then do:
     7413         apply "entry" to br-list in frame Dialog-Frame.
     7414         return no-apply.
     7415       end.
     7416       run gbl/crd-file.w (output v-codir, output v-default-valid-date, output v-prefix) no-error .
     7417       if error-status:error
     7418       or return-value = "error" then do:
     7419         apply "entry" to br-list in frame Dialog-Frame.
     7420         return no-apply.
     7421       end.
     7422       if session:set-wait-state( "COMPILER" )  then .
     7423       CASE v-codir:
     7424         when '':U
     7425         or when "1251":U
     7426         then do:
     7427           output to value (f-name).
     7428         end.
     7429         when "koi8-r" then do:
     7430           output to value (f-name) convert target "koi8-r".
     7431         end.
     7432         when "ibm866" then do:
     7433           output to value (f-name) convert target "ibm866".
     7434         end.
     7435       END CASE.
     7436       output stream slog to value("crd-file.log") .
     7437       for each dc-list:
     7438         if dc-list.mask-card then do:
     7439           put stream slog unformatted substitute("карта &1 - маска: пропускаем..."
     7440                                                 , dc-list.d-card) skip.
     7441           next.
     7442         end.
     7443         find first buf_clients no-lock where
     7444                   buf_clients.obj-type = dc-list.cli-type
     7445               AND  buf_clients.obj-code = dc-list.cli-code no-error .
     7446         if available buf_clients
     7447         and buf_Clients.obj-name <> '':U
     7448         then do:
     7449           if length(dc-list.d-card)  +  length(v-prefix) + 1 > 19 then do:
     7450             put stream slog unformatted substitute("карта &1 - длина с учетом префикса &2 и КЦ больше 19 символов: пропускаем..."
     7451                                                   , dc-list.d-card
     7452                                                   , v-prefix) skip.
     7453             next.
     7454           end.
     7455           run gbl/pluhnalg.p (input (v-prefix + dc-list.d-card + 'C')
     7456                           ,output v-full-number) no-error .
     7457           if error-status:error then do:
     7458             put stream slog unformatted substitute("карта &1 - ошибка при вычислении КЦ &2: пропускаем..."
     7459                                                   , dc-list.d-card
     7460                                                   , error-status:get-message(1) ) skip.
     7461             next.
     7462           end.
     7463           if v-codir <> '':U then do:
     7464             put unformatted
     7465             substitute("~~1%&1?", string(buf_clients.obj-name, "X(30)")) skip
     7466             .
     7467           end.
     7468           put unformatted
     7469           substitute("~~2;&1=&2&3700&4?"
     7470                     , v-full-number
     7471                     , (if dc-list.valid-date <> ?
     7472                       then string(year(dc-list.valid-date) - 2000, "99")
     7473                       else string(year(v-default-valid-date) - 2000, "99")
     7474                       )
     7475                     , (if dc-list.valid-date <> ?
     7476                       then string(month(dc-list.valid-date), "99")
     7477                       else string(month(v-default-valid-date), "99")
     7478                       )
     7479                     , fill(chr(32), 5 )
     7480                     ) skip.
     7481         end.
     7482         else do:
     7483           put stream slog unformatted
     7484           substitute("карта &1 - не найден клиент &2&3 или нет фамилии/названия: пропускаем..."
     7485                     , dc-list.d-card
     7486                     , dc-list.cli-type
     7487                     , dc-list.cli-code) skip.
     7488           next.
     7489         end.
     7490       end.
     7491       output close.
     7492       output stream slog close.
     7493       if session:set-wait-state( "" )  then .
     7494     end.
     7495   end case.
     7496   END PROCEDURE.
     7497   PROCEDURE proc-find-nameorcode :
     7498   case n-c:
     7499       when 'карта':U then do:
     7500       if last-event:label = "Ctrl-J" then
     7501           find next l-dc-list no-lock where
     7502                     l-dc-list.d-card begins nameorcode no-error.
     7503       else
     7504           find first l-dc-list no-lock where
     7505                     l-dc-list.d-card begins nameorcode no-error.
     7506       end.
     7507       when 'Контрагент':U then do:
     7508       if last-event:label = "Ctrl-J" then
     7509           find next l-dc-list no-lock where
     7510                     l-dc-list.cli-code = integer(nameorcode) no-error.
     7511       else
     7512           find first l-dc-list no-lock where
     7513                     l-dc-list.cli-code = integer(nameorcode) no-error.
     7514       end.
     7515   end case.
     7516   if available l-dc-list then do:
     7517     line-rec = recid (l-dc-list).
     7518     reposition br-list to recid line-rec no-error.
     7519       apply "value-changed" to br-list in frame Dialog-Frame.
     7520   end.
     7521   else do:
     7522     message "Строка не найдена."
     7523             view-as alert-box error.
     7524   end.
     7525   END PROCEDURE.
     7526   PROCEDURE proc-vc-rs-list-method :
     7527   define variable v-operation as integer no-undo .
     7528   define variable ii as integer no-undo.
     7529   define variable v-recs as integer no-undo .
     7530   define variable v-line as integer no-undo .
     7531   define variable v-item as character no-undo .
     7532   define variable v-tbl-name as character no-undo .
     7533   define variable v-bh as handle no-undo .
     7534   define variable v-tot-lns as integer no-undo .
     7535   define variable v-temp-seq as integer no-undo .
     7536   define variable v-message as character no-undo .
     7537   define variable grp-path as character no-undo .
     7538   define variable glog as logical no-undo .
     7539   define variable v-input-output as character no-undo .
     7540   define variable v-ref-rec as recid no-undo .
     7541   define variable v-grp-rec as recid no-undo .
     7542   define variable f-name as char init "default.trn" no-undo.
     7543   define variable v-host-name as character no-undo .
     7544   define variable v-host-code like ub.sysconf.host-code no-undo.
     7545   define variable v-rid-list as character no-undo .
     7546   define variable v-uniq-key-rec as character no-undo .
     7547   define buffer buf_stop-list for ub.stop-list.
     7548   define buffer buf_clob-bind for ub.clob-bind.
     7549   define buffer buf_dc-list-hist for dc-list-hist.
     7550    v-no-hist = - 1.
     7551   if rs-list-method = "single" then
     7552   run Myenable  in this-procedure .
     7553   else do:
     7554     v-no-hist = 0.
     7555     case rs-list-method:
     7556       when "company" then do:
     7557         glog = yes.
     7558         message
     7559         substitute("Все карты с эмитентом-фирмой &1", p-curr-host-code)
     7560         skip stat-line(rs-status)
     7561         view-as alert-box question buttons OK-Cancel update glog.
     7562         if not glog then do:
     7563           run Myenable  in this-procedure .
     7564           return no-apply.
     7565         end.
     7566         v-no-hist = 1.
     7567   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7568   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     7569     (input  p-curr-obj-type
     7570     ,input  p-curr-obj-code
     7571     ,output v-host-code
     7572     ,output v-host-name
     7573     )  .
     7574         run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     7575                                             , input-output v-seq
     7576                                             , input 0
     7577                                             , input '':U
     7578                                             , input substitute('Карты фирмы &1 &2', v-host-name, stat-line(rs-status))
     7579                                             , input tot-lns
     7580                                             , input rs-list-method
     7581                                             , input rs-status
     7582                                             , input "company"
     7583                                             , input string(p-curr-host-code)
     7584                                             , input ?
     7585                                             ).
     7586       end.
     7587       when "global" then do:
     7588         glog = yes.
     7589         message
     7590         substitute("Все глобальные карты")
     7591         skip stat-line(rs-status)
     7592         view-as alert-box question buttons OK-Cancel update glog.
     7593         if not glog then do:
     7594           run Myenable in this-procedure .
     7595           return no-apply.
     7596         end.
     7597         v-no-hist = 1.
     7598         run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     7599                                             , input-output v-seq
     7600                                             , input 0
     7601                                             , input '':U
     7602                                             , input substitute('Глобальные карты &1', stat-line(rs-status))
     7603                                             , input tot-lns
     7604                                             , input rs-list-method
     7605                                             , input rs-status
     7606                                             , input 'global'
     7607                                             , input string(0)
     7608                                             , input ?
     7609                                             ).
     7610       end.
     7611       when "type" then do:
     7612         glog = yes.
     7613         message
     7614         "Все карты выбранных типов."
     7615          view-as alert-box question buttons OK-Cancel update glog.
     7616         if not glog then do:
     7617           run MyEnable  in this-procedure .
     7618           return error.
     7619         end.
     7620         GRP-list = "".
     7621         run ref/dc-types.w (
     7622                          input parparentproc
     7623                         ,input "":U
     7624                         ,input "b-sel,b-mark":U
     7625                         ,input 0
     7626                         ,input p-curr-host-code
     7627                         ,input p-curr-obj-type
     7628                         ,input p-curr-obj-code
     7629                         ,input-output ref-list
     7630                         ).
     7631         if ref-list = "" then do:
     7632           run MyEnable  in this-procedure .
     7633           return error.
     7634         end.
     7635         dsp-rs = "".
     7636         v-recs = num-entries(ref-list).
     7637         do num-rec = 0 to v-recs:
     7638           if v-recs = 1 then do:
     7639             num-rec = 1 .
     7640           end.
     7641           if num-rec > 0 then do:
     7642             v-ref-rec = integer (entry (num-rec, ref-list)).
     7643             find ub.dis-card-type where recid (ub.dis-card-type) = v-ref-rec no-lock.
     7644           end.
     7645           if v-recs = 1 then do:
     7646             assign
     7647             v-temp-seq = v-seq
     7648             v-line     = 0
     7649             dsp-rs = substitute("Тип &1 Эмитент &2: &3"
     7650                                 , ub.dis-card-type.type
     7651                                 , ub.dis-card-type.emitent-host-code
     7652                                 , stat-line(rs-status)
     7653                                 )
     7654             v-item     = '':U
     7655             v-tbl-name = 'dis-card-type':U
     7656             v-bh       = buffer dis-card-type:handle
     7657             v-tot-lns = tot-lns
     7658             .
     7659           end.
     7660           else do:
     7661             if num-rec = 0 then do:
     7662               assign
     7663               v-temp-seq = v-seq
     7664               v-line     = 0
     7665               dsp-rs = substitute("Тип &1:"
     7666                                   , stat-line(rs-status))
     7667               v-item     = '':U
     7668               v-tbl-name = '':U
     7669               v-bh       = ?
     7670               v-tot-lns = tot-lns
     7671               .
     7672             end.
     7673             else do:
     7674               assign
     7675               v-temp-seq = v-seq - 1
     7676               v-line     = num-rec
     7677               dsp-rs = substitute("Тип &1 Эмитент &2"
     7678                                   , ub.dis-card-type.type
     7679                                   , ub.dis-card-type.emitent-host-code
     7680                                   )
     7681               v-item     = '':U
     7682               v-tbl-name = 'dis-card-type':U
     7683               v-bh       = buffer ub.dis-card-type:handle
     7684               v-tot-lns = tot-lns + num-rec
     7685               .
     7686             end.
     7687           end.
     7688           v-no-hist = (if num-rec = 1 then 0 else num-rec).
     7689           run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     7690                                               , input-output v-temp-seq
     7691                                               , input v-line
     7692                                               , input '':U
     7693                                               , input dsp-rs
     7694                                               , input v-tot-lns
     7695                                               , input rs-list-method
     7696                                               , input rs-status
     7697                                               , input v-item
     7698                                               , input v-tbl-name
     7699                                               , input v-bh
     7700                                               ).
     7701           if num-rec = 0 or v-recs = 1 then v-seq  = v-temp-seq.
     7702         end.
     7703       end.
     7704       when "all" then do:
     7705         glog = yes.
     7706         message "Все карты из справочника карт."
     7707         skip stat-line(rs-status)
     7708         view-as alert-box question buttons OK-Cancel update glog.
     7709         if not glog then do:
     7710           run MyEnable  in this-procedure .
     7711           return error.
     7712         end.
     7713         v-no-hist = 1.
     7714         run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     7715                                             , input-output v-seq
     7716                                             , input 0
     7717                                             , input '':U
     7718                                             , input substitute('Все карты &1', stat-line(rs-status))
     7719                                             , input tot-lns
     7720                                             , input rs-list-method
     7721                                             , input rs-status
     7722                                             , input 'all':U
     7723                                             , input '':U
     7724                                             , input ?
     7725                                             ).
     7726       end.
     7727       when "card" then do:
     7728         glog = yes.
     7729         message "1 или несколько карт"
     7730         skip stat-line(rs-status)
     7731         view-as alert-box question buttons OK-Cancel update glog.
     7732         if not glog then do:
     7733           run MyEnable  in this-procedure .
     7734           return error.
     7735         end.
     7736         dsp-rs = "".
     7737         run ref/discards.w (
     7738                              input parparentproc
     7739                             ,input "b-sel,b-mark"
     7740                             ,input 'все':U
     7741                             ,input p-curr-host-code
     7742                             ,input p-curr-obj-type
     7743                             ,input p-curr-obj-code
     7744                             ,input '':U
     7745                             ,input ?
     7746                             ,output ref-list).
     7747         apply "entry" to br-list in frame Dialog-Frame.
     7748         if ref-list = "" then do:
     7749             run MyEnable  in this-procedure .
     7750             return error.
     7751         end.
     7752         v-recs = num-entries (ref-list).
     7753         do num-rec = 0 to v-recs:
     7754           if v-recs = 1 then do:
     7755             num-rec = 1 .
     7756           end.
     7757           if num-rec > 0 then do:
     7758             v-ref-rec = integer (entry (num-rec, ref-list)).
     7759             find ub.dis-card  where recid (ub.dis-card) = v-ref-rec no-lock.
     7760           end.
     7761           if v-recs = 1 then do:
     7762             assign
     7763             v-temp-seq = v-seq
     7764             v-line     = 0
     7765             dsp-rs = substitute("Карта :&1 &2", ub.dis-card.d-card, stat-line(rs-status))
     7766             v-item     = '':U
     7767             v-tbl-name = 'dis-card':U
     7768             v-bh       = buffer ub.dis-card:handle
     7769             v-tot-lns = tot-lns
     7770             .
     7771           end.
     7772           else do:
     7773             if num-rec = 0 then do:
     7774               assign
     7775               v-temp-seq = v-seq
     7776               v-line     = 0
     7777               dsp-rs = substitute("Карты : &1", stat-line(rs-status))
     7778               v-item     = '':U
     7779               v-tbl-name = '':U
     7780               v-bh       = ?
     7781               v-tot-lns = tot-lns
     7782               .
     7783             end.
     7784             else do:
     7785               assign
     7786               v-temp-seq = v-seq - 1
     7787               v-line     = num-rec
     7788               dsp-rs = substitute("№ карты &1 &2&3", ub.dis-card.d-card, ub.dis-card.cli-type, ub.dis-card.cli-code)
     7789               v-item     = '':U
     7790               v-tbl-name = 'dis-card':U
     7791               v-bh       = buffer ub.dis-card:handle
     7792               v-tot-lns = tot-lns + num-rec
     7793               .
     7794             end.
     7795           end.
     7796           v-no-hist = (if num-rec = 1 then 0 else num-rec).
     7797           run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     7798                                                 , input-output v-temp-seq
     7799                                                 , input v-line
     7800                                                 , input '':U
     7801                                                 , input dsp-rs
     7802                                                 , input v-tot-lns
     7803                                                 , input rs-list-method
     7804                                                 , input rs-status
     7805                                                 , input v-item
     7806                                                 , input v-tbl-name
     7807                                                 , input v-bh
     7808                                                 ).
     7809           if num-rec = 0 or v-recs = 1 then v-seq  = v-temp-seq.
     7810         end.
     7811       end.
     7812       when "cli" or WHEN "cli-grp" then do:
     7813         if rs-list-method = "cli-grp" then do:
     7814           glog = yes.
     7815           message
     7816           "Карты по 1-й или нескольким групп клиентов"
     7817           skip stat-line(rs-status)
     7818           view-as alert-box question buttons OK-Cancel update glog.
     7819           if not glog then do:
     7820             run MyEnable  in this-procedure .
     7821             return error.
     7822           end.
     7823           GRP-list = "".
     7824           ref-list = "".
     7825           run ref/cli-grps.w ( input parparentproc
     7826                               ,input "b-sel,b-mark"
     7827                               ,input-output grp-list).
     7828         end.
     7829         else do:
     7830           glog = yes.
     7831           message
     7832           "Карты 1-го или нескольких произвольных клиентов из справочника."
     7833           skip stat-line(rs-status)
     7834           view-as alert-box question buttons OK-Cancel update glog.
     7835           if not glog then do:
     7836             run MyEnable  in this-procedure .
     7837             return error.
     7838           end.
     7839           run ref/cli-all.w ( input parparentproc
     7840                           ,input "b-sel,b-mark,b-add"
     7841                           ,input  ?
     7842                           ,input  ?
     7843                           ,input  ?
     7844                           ,input  ?
     7845                           ,input  ?
     7846                           ,input  ?
     7847                           ,output ref-list).
     7848           grp-list = ?.
     7849         end.
     7850         if grp-list <> ? and
     7851         grp-list <> "" then do:
     7852           v-recs = num-entries (grp-list).
     7853           do num-rec = 0 to v-recs:
     7854             if v-recs = 1 then do:
     7855               num-rec = 1 .
     7856             end.
     7857             if num-rec > 0 then do:
     7858               v-grp-rec = integer (entry (num-rec, grp-list)).
     7859               find ub.cli-grp where recid (ub.cli-grp) = v-grp-rec no-lock.
     7860               run cli-grplib-get-full-name in this-procedure (ub.cli-grp.node-code, output grp-path).
     7861             end.
     7862             if v-recs = 1 then do:
     7863               assign
     7864               v-temp-seq = v-seq
     7865               v-line     = 0
     7866               dsp-rs = substitute("Группа клиентов &1: &2", grp-path, stat-line(rs-status))
     7867               v-item     = '':U
     7868               v-tbl-name = 'cli-grp':U
     7869               v-bh       = buffer cli-grp:handle
     7870               v-tot-lns = tot-lns
     7871               .
     7872             end.
     7873             else do:
     7874               if num-rec = 0 then do:
     7875                 assign
     7876                 v-temp-seq = v-seq
     7877                 v-line     = 0
     7878                 dsp-rs = substitute("Группы клиентов: &1", stat-line(rs-status))
     7879                 v-item     = '':U
     7880                 v-tbl-name = '':U
     7881                 v-bh       = ?
     7882                 v-tot-lns = tot-lns
     7883                 .
     7884               end.
     7885               else do:
     7886                 assign
     7887                 v-temp-seq = v-seq - 1
     7888                 v-line     = num-rec
     7889                 dsp-rs = substitute("&1", grp-path)
     7890                 v-item     = '':U
     7891                 v-tbl-name = 'cli-grp':U
     7892                 v-bh       = buffer ub.cli-grp:handle
     7893                 v-tot-lns = tot-lns + num-rec
     7894                 .
     7895               end.
     7896             end.
     7897             v-no-hist = (if num-rec = 1 then 0 else num-rec).
     7898             run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     7899                                                 , input-output v-temp-seq
     7900                                                 , input v-line
     7901                                                 , input '':U
     7902                                                 , input dsp-rs
     7903                                                 , input v-tot-lns
     7904                                                 , input rs-list-method
     7905                                                 , input rs-status
     7906                                                 , input v-item
     7907                                                 , input v-tbl-name
     7908                                                 , input v-bh
     7909                                                 ).
     7910             if num-rec = 0 or v-recs = 1 then v-seq  = v-temp-seq.
     7911           end.
     7912         end.
     7913         else if ref-list <> "" and  ref-list <> ? then do:
     7914           v-recs = num-entries (ref-list) .
     7915           do num-rec = 0 to v-recs:
     7916             if v-recs = 1 then do:
     7917               num-rec = 1 .
     7918             end.
     7919             if num-rec > 0 then do:
     7920               v-ref-rec = integer (entry (num-rec, ref-list)).
