     4032   DEFINE BUTTON B-rest
     4033        LABEL "&*Остав. строку"
     4034        SIZE 20 BY 1 TOOLTIP "Оставить в списке только текущую строку".
     4035   DEFINE BUTTON B-save
     4036        LABEL "Со&хранить"
     4037        SIZE 10 BY 1 TOOLTIP "Сохранить список карт в текстовом файле, EXCEL".
     4038   DEFINE BUTTON B-stop
     4039        IMAGE-UP FILE "cmp/stop.bmp":U
     4040        IMAGE-DOWN FILE "cmp/stopi.bmp":U
     4041        IMAGE-INSENSITIVE FILE "cmp/stopi.bmp":U
     4042        LABEL "&[ ]"
     4043        SIZE 4 BY 1.25 TOOLTIP "Конец записи макроса формирования истории".
     4044   DEFINE VARIABLE ed-notes AS CHARACTER
     4045        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     4046        SIZE 75.63 BY 1.54 NO-UNDO.
     4047   DEFINE VARIABLE dsp-rs AS CHARACTER FORMAT "X(256)":U
     4048         VIEW-AS TEXT
     4049        SIZE 75.5 BY 1 TOOLTIP "Строка текущего состояния списка"
     4050        FGCOLOR 4  NO-UNDO.
     4051   DEFINE VARIABLE f-tot-lns AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
     4052         VIEW-AS TEXT
     4053        SIZE 10 BY .71 TOOLTIP "Кол. строк"
     4054        FGCOLOR 4  NO-UNDO.
     4055   DEFINE VARIABLE NameOrCode AS CHARACTER FORMAT "X(256)":U
     4056        VIEW-AS FILL-IN
     4057        SIZE 40.13 BY 1 NO-UNDO.
     4058   DEFINE VARIABLE n-c AS CHARACTER
     4059        VIEW-AS RADIO-SET HORIZONTAL
     4060        RADIO-BUTTONS
     4061             "Карта", "1",
     4062   "Клиент", "2"
     4063        SIZE 23 BY .79 NO-UNDO.
     4064   DEFINE VARIABLE RS-Status AS CHARACTER
     4065        VIEW-AS RADIO-SET HORIZONTAL
     4066        RADIO-BUTTONS
     4067             "Item 1", "1",
     4068   "Item 2", "2",
     4069   "Item 3", "3",
     4070   "Item 4", "4"
     4071        SIZE 48 BY .75 NO-UNDO.
     4072   DEFINE QUERY BR-list FOR
     4073         dc-list SCROLLING.
     4074   DEFINE QUERY br-option FOR
     4075         temp-list SCROLLING.
     4076   DEFINE BROWSE BR-list
     4077     QUERY BR-list NO-LOCK DISPLAY
     4078         dc-list.d-card COLUMN-LABEL "Номер" FORMAT "X(19)":U
     4079         dc-list.issue-code COLUMN-LABEL "Маг-н" FORMAT "99999":U
     4080         dc-list.issue-date COLUMN-LABEL "Выдано" FORMAT "99/99/9999":U
     4081         get-d-pcnt(buffer dc-list, input p-curr-host-code, input p-curr-obj-type, input p-curr-obj-code, input 'def-pcnt':U, output obj-d-pcnt) COLUMN-LABEL "Скидка" FORMAT "X(12)":U
     4082         dc-list.status_ FORMAT "X(4)":U
     4083         dc-list.emitent-host-code COLUMN-LABEL "Фирма" FORMAT "99999":U
     4084         dc-list.sourced-card COLUMN-LABEL "К карте" FORMAT "X(16)":U
     4085         obj-d-pcnt COLUMN-LABEL "Скидка на!объекте" FORMAT "->9.99%":U
     4086         dc-list.valid-date COLUMN-LABEL "Действ.по" FORMAT "99/99/9999":U
     4087         dc-list.type COLUMN-LABEL "Тип" FORMAT "X(8)":U
     4088         dc-list.credit-card FORMAT "+/":U
     4089         dc-list.lim-kr FORMAT ">>>,>>>,>>>,>>9.99":U
     4090         (cli-name) COLUMN-LABEL "Название/ФИО" FORMAT "x(29)":U
     4091         (dc-list.cli-type + STRING (dc-list.cli-code)) COLUMN-LABEL "Клиент" FORMAT "X(10)":U
     4092       WITH NO-ROW-MARKERS SEPARATORS SIZE 76.5 BY 15.13.
     4093   DEFINE BROWSE BR-option
     4094     QUERY BR-option DISPLAY
     4095         temp-list.fname format "X(40)"
     4096       WITH NO-LABELS NO-ROW-MARKERS SEPARATORS SIZE 30 BY 21.
     4097   DEFINE FRAME Dialog-Frame
     4098        dsp-rs AT ROW 1 COL 1 NO-LABEL
     4099        BR-option AT ROW 2 COL 79
     4100        B-exit AT ROW 2 COL 1
     4101        B-save AT ROW 2 COL 11
     4102        B-print AT ROW 2 COL 21
     4103        B-hist AT ROW 2 COL 31
     4104        B-lkp AT ROW 2 COL 41
     4105        B-clr AT ROW 2 COL 51
     4106        B-Help AT ROW 1 COL 61
     4107        B-add AT ROW 3 COL 11
     4108        B-del AT ROW 3 COL 31
     4109        B-rest AT ROW 3 COL 51
     4110        B-macro AT ROW 3 COL 71
     4111        B-stop AT ROW 3 COL 75
     4112        B-clear-macro AT ROW 3 COL 75
     4113        B-record AT ROW 3 COL 75
     4114        NameOrCode AT ROW 4.04 COL 34 COLON-ALIGNED NO-LABEL
     4115        n-c AT ROW 4.08 COL 2.38 NO-LABEL
     4116        RS-Status AT ROW 4.96 COL 3.25 NO-LABEL
     4117        BR-list AT ROW 5.96 COL 1.13
     4118        ed-notes AT ROW 21.38 COL 1 NO-LABEL
     4119        f-tot-lns AT ROW 5 COL 66 COLON-ALIGNED NO-LABEL
     4120        SPACE(22.00) SKIP(17.36)
     4121       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     4122            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     4123            TITLE "Список дисконтных карт"
     4124            DEFAULT-BUTTON B-exit.
     4125   ASSIGN
     4126          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     4127          FRAME Dialog-Frame:HIDDEN           = TRUE.
     4128   ASSIGN
     4129          B-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-print:HANDLE.
     4130   ASSIGN
     4131          B-macro:POPUP-MENU IN FRAME Dialog-Frame       = MENU m-play:HANDLE.
     4132   ASSIGN
     4133          B-save:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-save:HANDLE.
     4134   ASSIGN
     4135          ed-notes:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     4136   on GO of frame Dialog-Frame do:
     4137     define variable glog as logical no-undo .
     4138   end.
     4139   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     4140   DO:
     4141     APPLY "END-ERROR":U TO SELF.
     4142   END.
     4143   ON CHOOSE OF B-clr IN FRAME Dialog-Frame
     4144   DO:
     4145   define variable glog as logical no-undo .
     4146   define buffer buf-dc-list-hist for dc-list-hist.
     4147   glog = no.
     4148   message
     4149   "Удаление всех строк списка. Вы уверены ?"
     4150    view-as alert-box question buttons OK-Cancel update glog.
     4151   if not glog then return no-apply.
     4152   if session:set-wait-state( "COMPILER" )  then .
     4153   for each dc-list:
     4154     delete dc-list.
     4155   end.
     4156   if session:set-wait-state( "" )  then .
     4157   tot-lns = 0.
     4158   v-seq = 1.
     4159   for each buf-dc-list-hist:
     4160     delete buf-dc-list-hist.
     4161   end.
     4162   run create-dc-list-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     4163                                        , input-output v-seq
     4164                                        , input 0
     4165                                        , input '0':U
     4166                                        , input "# Список карт очищен."
     4167                                        , input 0
     4168                                        , input "clear"
     4169                                        , input '':U
     4170                                        , input '':U
     4171                                        , input '':U
     4172                                        , input ?
     4173                                        ).
     4174   ed-notes:screen-value = ''.
     4175   display
     4176   tot-lns @ f-tot-lns
     4177   with frame Dialog-Frame.
     4178   run MyEnable in this-procedure .
     4179   END.
     4180   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     4181   DO:
     4182   define buffer buf_dc-list-hist for dc-list-hist.
     4183   run prn-lib-open-stream  in this-procedure (
     4184                                                input parParentProc
     4185                                               ,input 43
     4186                                               ,input yes
     4187                                               ,input no
     4188                                               ).
     4189   find first buf_dc-list-hist no-lock where buf_dc-list-hist.id = 0 no-error .
     4190   PUT  STREAM PrnLibStream unformatted
     4191   SPACE(25) "История создания списка карт "
     4192   (if available buf_dc-list-hist
     4193   then buf_dc-list-hist.des
     4194   else "БЕЗЫМЯННЫЙ") skip(0)
     4195   space(25) cur-time-print() skip(1)
     4196   .
     4197   put stream PrnLibStream unformatted
     4198   string("№", "X(9)") chr(32)
     4199   string("Действие", "X(9)") chr(32)
     4200   string("записей", "X(9)") chr(32)
     4201   string(" = итого", "X(12)") chr(32)
     4202   string("Множество", "X(155)")
     4203   skip(0)
     4204   fill('-':U, 9) chr(32)
     4205   fill('-':U, 9) chr(32)
     4206   fill('-':U, 9) chr(32)
     4207   fill('-':U, 12) chr(32)
     4208   fill('-':U, 155)
     4209   skip(0)
     4210   .
     4211   for each buf_dc-list-hist where buf_dc-list-hist.id > 0
     4212   by buf_dc-list-hist.id
     4213   :
     4214     put stream PrnLibStream unformatted
     4215     (if buf_dc-list-hist.line = 0
     4216      then string(buf_dc-list-hist.id, ">>>>>>>>9")
     4217      else fill(chr(32) , 9)
     4218     )  chr(32)
     4219     (if buf_dc-list-hist.item_ <> '':U
     4220      then string(buf_dc-list-hist.hist-mode, "X(8)")
     4221      else fill( chr(32), 8)) chr(32)
     4222     string(buf_dc-list-hist.num-add, ">>>>>>>>9") chr(32) chr(32) chr(32) chr(32)
     4223     string(buf_dc-list-hist.num-recs, ">>>>>>>>9")  chr(32)
     4224     string(buf_dc-list-hist.des, "X(155)") skip.
     4225   end.
     4226   output stream prnlibstream close.
     4227     run prn-lib-prn-file in this-procedure (
     4228                                               input parParentProc
     4229                                               ,input 8
     4230                                               ).
