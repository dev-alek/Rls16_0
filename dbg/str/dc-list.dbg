     4979   procedure diasize_set-height :
     4980     define input  parameter p-new-height  as decimal   no-undo .
     4981     define input  parameter p-move-resize as logical   no-undo .
     4982     do
     4983     on error undo, return error return-value
     4984     :
     4985       run diasize_change-height in this-procedure
     4986         (input  (p-new-height - frame Dialog-Frame :height)
     4987         ,input  p-move-resize
     4988         ) .
     4989     end.
     4990   end procedure.
     4991   procedure diasize_change-width :
     4992     define input  parameter p-change-value as decimal   no-undo .
     4993     define input  parameter p-move-resize  as logical   no-undo .
     4994     define variable v-field-group-handle   as handle    no-undo .
     4995     define variable v-object-handle        as handle    no-undo .
