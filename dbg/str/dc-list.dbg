     4471   on help of frame Dialog-Frame
     4472   do:
     4473     run gbl/app_help.p
     4474       (input this-procedure :file-name
     4475       ,input ''
     4476       ,input ?
     4477       ) no-error.
     4478     if error-status :error then do:
     4479       message
     4480         "Ошибка при вызове помощи"
     4481         error-status :get-message(1)
     4482         view-as alert-box .
