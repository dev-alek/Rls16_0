     1632   procedure create_obj-list :
     1633      define input parameter p-obj-type like ub.clients.obj-type no-undo .
     1634      define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1635      do
     1636      on error undo, return error return-value
     1637      :
     1638         define buffer cli-obj for ub.clients .
     1639         define variable p-var as integer no-undo .
     1640         define buffer buf_obj-list for obj-list .
     1641         find last buf_obj-list  use-index pi no-error .
     1642         if available buf_obj-list
     1643         then
     1644            p-var = buf_obj-list.obj-id + 1.
     1645         else
     1646            p-var = 1.
     1647         find first cli-obj where
     1648                   cli-obj.obj-type = p-obj-type
     1649               and cli-obj.obj-code = p-obj-code
     1650         no-lock no-error.
     1651         if available cli-obj
     1652         then do:
     1653            create buf_obj-list.
     1654            assign
     1655               buf_obj-list.obj-id   = p-var
     1656               buf_obj-list.obj-code = cli-obj.obj-code
     1657               buf_obj-list.obj-type = cli-obj.obj-type
     1658               buf_obj-list.obj-name = cli-obj.obj-name
     1659               buf_obj-list.db-num   = cli-obj.db-num
     1660            .
     1661         end.
     1662      end.
     1663   end.
