     3019   function waitfram-check-timeout returns logical():
     3020      define variable vtime as int64 no-undo.
     3021      if mWaitFramStopTimeOut
     3022      then
     3023         return yes.
     3024      vtime = ( now - mWaitFramStartProc ) / 1000 .
     3025      if     mWaitFramTimeOut ne ?
     3026         and mWaitFramTimeOut ne 0
     3027         and mWaitFramTimeOut lt vtime
     3028      then do:
     3029         mWaitFramStopTimeOut = yes.
     3030      end.
     3031      return mWaitFramStopTimeOut.
     3032   end.
     3033   procedure waitfram-hide :
     3034     if not session:batch-mode
     3035     then do
     3036     on error undo, return error return-value
     3037     :
     3038       pause 0 before-hide .
     3039       if not mBatchMode then
     3040         hide frame waitfram .
     3041     if     not mWaitFramView
     3042        and mWaitProcEvent
     3043     then
     3044       process events .
     3045     end.
     3046   end procedure.
     3047   procedure waitfram-show :
     3048     define input  parameter p-message as character no-undo .
     3049     define variable v-left-margin as integer   no-undo .
     3050     if not session:batch-mode
     3051     then do
     3052     on error undo, return error return-value
     3053     :
     3054       if length(p-message) <= 70 then do:
     3055         assign
     3056           v-left-margin = integer((70 - length(p-message)) / 2)
     3057         .
     3058         assign
     3059           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     3060         .
     3061         assign
     3062           v-waitfram-action01 = " "
     3063           v-waitfram-action02 = " "
     3064                                    + fill(" ", v-left-margin)
     3065                                    + p-message
     3066           v-waitfram-action03 = " "
     3067         .
     3068       end.
     3069       else do:
     3070         define variable vRindex1 as integer no-undo.
     3071         define variable vRindex2 as integer no-undo.
     3072         vRindex1 = r-index(p-message," ",70).
     3073         if vRindex1 = 0
     3074         then
     3075            vRindex1 = 70.
     3076         if length(p-message)  <= vRindex1 + 70 then do:
     3077           assign
     3078             v-waitfram-action01 = " "
     3079             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     3080             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     3081           .
     3082         end.
     3083         else do:
     3084           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     3085           if vRindex2 <= vRindex1
     3086           then
     3087              vRindex2 = vRindex1 + 70.
     3088           assign
     3089             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     3090             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     3091             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     3092           .
     3093         end.
     3094       end.
     3095       B-viewProcInfo:visible   in frame waitfram = no.
     3096       B-viewProcInfo:sensitive in frame waitfram = no.
     3097       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3098       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3099       if  (   mWaitFramView
     3100          or  mWaitProcEvent)
     3101          and not mBatchMode
     3102       then
     3103          display
     3104             v-waitfram-action01 skip
     3105             v-waitfram-action02 skip
     3106             v-waitfram-action03 skip
     3107          with frame waitfram .
     3108       if     mWaitFramView
     3109          then do:
     3110             if     mWaitFramInterval ne ?
     3111                and not mBatchMode
     3112             then
     3113                wait-for go of frame waitfram pause mWaitFramInterval.
     3114          end.
     3115          else
     3116             if     mWaitProcEvent
     3117                and not mBatchMode
     3118             then
     3119                process events .
     3120     end.
     3121   end procedure.
     3122      procedure waitfram-show-this:
     3123         define input  parameter iInterval as int64 no-undo.
     3124         define variable vtime as int64 no-undo.
     3125         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     3126         mWaitFramInterval = iInterval.
     3127         run waitfram-show (substitute("&1&2 &3&4" ,
     3128                                       mWaitFramTextBeg ,
     3129                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     3130                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     3131                                       mWaitFramTextEnd
     3132                                      )
     3133                           ).
     3134      end.
     3135      procedure WaitFramRunPause:
     3136         define input  parameter iInterval as dec no-undo.
     3137         define variable vStart  as datetime-tz no-undo.
     3138         define variable vend    as datetime-tz no-undo.
     3139         define variable vint as int64 no-undo.
     3140         define variable vOk as logical no-undo.
     3141         vStart = now.
     3142         vend   = vStart.
     3143         publish "WaitFramPause" (iInterval,output vOk).
     3144         vend   =  now.
     3145         vint = vend - vStart.
     3146         vint = iInterval - vint / 1000.
     3147         if     not mWaitFramStop
     3148            and (   vint > 0
     3149                 or (    not vOk
     3150                     and iInterval eq ?
     3151                     )
     3152                 )
     3153         then
     3154            run waitfram-show-this (iInterval).
     3155         vend   =  now.
     3156         vint = vend - vStart.
     3157         vint = iInterval - vint / 1000.
     3158         if     not mWaitFramStop
     3159            and vint > 0
     3160         then do:
     3161            run gbl/pause.p (vint * 1000).
     3162         end.
     3163         if iInterval ne ?
     3164         then
     3165            publish "WaitFramStop".
     3166         waitfram-check-timeout().
     3167      end.
     3168      procedure WaitFramWaitFor:
     3169         define input  parameter iInterval as dec no-undo.
     3170         assign
     3171            mWaitFramStartProc   = now
     3172            mWaitFramStopUser    = no
     3173            mWaitFramStopTimeOut = no
     3174         .
     3175         block-wait:
     3176         do while not mWaitFramStop:
     3177            run WaitFramRunPause (iInterval).
     3178            if  waitfram-check-timeout()
     3179            then do:
     3180               leave block-wait.
     3181            end.
     3182         end.
     3183         run waitfram-hide.
     3184      end.
     3185   procedure waitfram-join :
     3186     define input  parameter p-line-1  as character no-undo .
     3187     define input  parameter p-line-2  as character no-undo .
     3188     define input  parameter p-line-3  as character no-undo .
     3189     define output parameter p-message as character no-undo .
     3190     do
     3191     on error undo, return error return-value
     3192     :
     3193       assign
     3194         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     3195                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     3196                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     3197       .
     3198     end.
     3199   end procedure.
     3200   function waitfram-join-function returns character
     3201     (input p-line-1 as character
     3202     ,input p-line-2 as character
     3203     ,input p-line-3 as character
     3204     ).
     3205     define variable v-message as character no-undo .
     3206     run waitfram-join in this-procedure
     3207       (input  p-line-1
     3208       ,input  p-line-2
     3209       ,input  p-line-3
     3210       ,output v-message
     3211       ) .
     3212     return v-message .
     3213   end function .
