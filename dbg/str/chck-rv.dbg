      491     (input  v-cntxt-obj-type
      492     ,input  v-cntxt-obj-code
      493     ,output v-today
      494     )  .
      495       cut-date = v-today.
      496       update cut-date with frame d.
      497       assign cut-date.
      498       hide frame d.
      499       run waitfram-show in this-procedure
      500         (input "Удаление запросов по сроку. Ждите..."
      501         ).
      502       for each trn-doc where trn-doc.doc-type = 'рас':U
      503                          and trn-doc.status_ = 'запрос':U
      504                          and trn-doc.obj-type = v-cntxt-obj-type
      505                          and trn-doc.obj-code = v-cntxt-obj-code
      506                          and trn-doc.fact-date < cut-date:
      507         accumulate trn-doc.doc-code (count).
      508         run waitfram-show in this-procedure
      509           (input "ЗАПРОС № " + trn-doc.doc-code + " Удален.  Всего : " +
      510                         string ((accum count trn-doc.doc-code))).
      511         delete trn-doc.
      512       end.
      513       run waitfram-hide in this-procedure .
      514       message "Удалено запросов :" (accum count trn-doc.doc-code).
      515     end.
      516     when "инв-снять" then do:
      517       if not (trn-doc.status_ = 'накл':U and
      518          trn-doc.flag_ or
      519          trn-doc.status_ = 'разрешен':U and
      520          not trn-doc.flag_) then do:
      521         message "Документ инвентаризации имеет не тот статус."
      522                 view-as alert-box error.
      523         return error.
      524       end.
      525       v-log = no.
      526       message "Сформировать заново список документов, мешающих включению инвентаризации ?"
      527               view-as alert-box question buttons Yes-No update v-log.
      528       if v-log then
      529         run str/inv-lst.p (
      530                         input parparentproc
      531                       , input v-cntxt-host-code-obj
      532                       , input v-cntxt-obj-type
      533                       , input v-cntxt-obj-code
      534                       , input trn-doc.doc-code).
      535       run waitfram-show in this-procedure
      536         (input "Снятие резервов по инвентаризации. Ждите..."
      537         ).
      538       inv-code = trn-doc.doc-code.
      539       for each trn-doc where trn-doc.inv-num = inv-code:
      540         run str/unrv-out.p (parparentproc, trn-doc.doc-code) no-error.
      541         if error-status:error then next.
      542         trn-doc.flag_ = yes.
      543         accumulate trn-doc.doc-code (count).
      544         run waitfram-show in this-procedure
      545           (input "СЧЕТ № " + trn-doc.doc-code + " -> ЗАПРОС.  Всего : " +
      546                         string ((accum count trn-doc.doc-code))
      547           ).
      548       end.
      549       run waitfram-hide in this-procedure .
      550       message "Снятие резервов по инвентаризации закончено." skip (2)
      551               "Отменено счетов :" (accum count trn-doc.doc-code).
      552     end.
      553     when "инв-рез" then do:
      554       if trn-doc.status_ = 'разрешен':U and
      555          trn-doc.flag_ then do:
      556         message "Документ инвентаризации включен. Резервирование невозможно."
      557                 view-as alert-box error.
      558         return error.
      559       end.
      560       run waitfram-show in this-procedure
      561         (input "Резервирование по инвентаризации. Ждите..."
      562         ).
      563       inv-code = trn-doc.doc-code.
      564       for each trn-doc where trn-doc.inv-num = inv-code:
      565         run str/rv-out.p (
      566             parparentproc,
      567             this-procedure ,
      568             trn-doc.doc-code,
      569             no ,
      570             true
      571             ) no-error.
      572         if error-status:error then next.
      573         accumulate trn-doc.doc-code (count).
      574         run waitfram-show in this-procedure
      575           (input "ЗАПРОС № " + trn-doc.doc-code + " -> СЧЕТ.  Всего : " +
      576                         string ((accum count trn-doc.doc-code))).
      577       end.
      578       run waitfram-hide in this-procedure .
      579       message "Создано счетов на основании запросов :" (accum count trn-doc.doc-code)
      580               view-as alert-box.
      581     end.
      582   end.
