        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: fnamegrp.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: str/fnamegrp.p $":U .
        7   define variable vss-description as character no-undo init "Полное название группы".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable vss-include-info0 as character format "X(65)" no-undo
       67   initial "@(#)$Workfile$ $Revision$".
       68   procedure grplib-get-full-name :
       69      define input parameter p-node-code  as integer      no-undo.
       70      define output parameter p-full-name as character    no-undo.
       71      do
       72   on error undo, return error
       73   :
       74       define variable v-upper-code    as integer           no-undo.
       75       define buffer buf_gds-grp       for ub.gds-grp.
       76       define buffer buf_upper_gds-grp for ub.gds-grp.
       77       find first buf_gds-grp no-lock
       78            where buf_gds-grp.node-code = p-node-code
       79       no-error.
       80       if not available buf_gds-grp
       81       then do:
       82           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
       83       end.
       84       assign
       85           p-full-name  = ""
       86           v-upper-code = 1
       87       .
       88       do while buf_gds-grp.upper-code <> 0
       89       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
       90       :
       91           assign
       92               p-full-name  = buf_gds-grp.node-name
       93                            + (if p-full-name <> "" then chr(47) else "")
       94                            + p-full-name
       95               v-upper-code = buf_gds-grp.upper-code
       96           .
       97           find first buf_gds-grp no-lock
       98                where buf_gds-grp.node-code = v-upper-code
       99           no-error.
      100           if not available buf_gds-grp
      101           then do:
      102               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      103                                   + string( v-upper-code )
      104                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      105           end.
      106       end.
      107       assign
      108       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      109       .
      110   end.
      111   end .
      112   procedure grplib-get-node-from-full-name :
      113   define input parameter p-full-name as character no-undo .
      114   define output parameter p-node-code as integer no-undo .
      115   define variable v-ii as integer no-undo .
      116   define variable v-upper-code as integer no-undo .
      117   define variable v-root-code as integer no-undo .
      118   define variable v-entry as character no-undo .
      119   define buffer buf_gds-grp       for ub.gds-grp.
      120   do
      121   on error undo, return error
      122   :
      123     find first buf_gds-grp no-lock
      124         where buf_gds-grp.upper-code = 0
      125     no-error .
      126     if not available buf_gds-grp
      127     then do:
      128         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      129     end.
      130     else do:
      131       assign
      132       v-root-code = buf_gds-grp.node-code
      133       .
      134     end.
      135     v-upper-code = v-root-code.
      136     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      137       assign
      138       v-entry = entry(v-ii, p-full-name, chr(47)).
      139       if v-entry = '' then leave.
      140       find first buf_gds-grp no-lock where
      141                 buf_gds-grp.node-name = v-entry
      142             and buf_gds-grp.upper-code = v-upper-code
      143             no-error.
      144       if not available buf_gds-grp then do:
      145         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      146       end.
      147       else do:
      148         p-node-code = buf_gds-grp.node-code.
      149         v-upper-code = buf_gds-grp.node-code.
      150       end.
      151     end.
      152   end.
      153   end .
      154   define input  parameter v-node-code as integer      no-undo.
      155   define output parameter v-full-name as character    no-undo.
      156   do
      157   on error undo, return error return-value
      158   :
      159       run grplib-get-full-name in this-procedure (
      160             input  v-node-code
      161           , output v-full-name
      162       ).
      163   end.
