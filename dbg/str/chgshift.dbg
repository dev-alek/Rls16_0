        1   define input  parameter parparentproc  as widget-handle no-undo .
        2   define input  parameter p-curr-obj-type like ub.clients.obj-type no-undo .
        3   define input  parameter p-curr-obj-code like ub.clients.obj-code no-undo .
        4   define output parameter p-shift-date like ub.chk-doc.shift-date no-undo.
        5   define output parameter p-shift-num like ub.chk-doc.shift-num no-undo.
        6   define output parameter p-shift-name as character no-undo .
        7   define output parameter p-shift-place-from as int no-undo.
        8   define output parameter p-shift-place-to as int no-undo.
        9   define output parameter p-change-fields as character no-undo.
       10   define output parameter p-can-back-shift as logical no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision$":u .
       12   define variable vss-author      as character no-undo init "$Author$":u .
       13   define variable vss-date        as character no-undo init "$Date$":u .
       14   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       15   define variable vss-archive     as character no-undo init "$Archive$":u .
       16   define variable vss-description as character no-undo init "Запрос на изменение даты и или номера смены" .
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   procedure proc-alt-shift-f2:
       76     if not ibs.th.gbl.gbl-var:rcode
       77   then
       78     run gbl\inidebug.p .
       79   end.
       80   procedure proc-alt-shift-f3:
       81     run gbl/prvssinf.p
       82       ( input this-procedure
       83       ) .
       84   end.
       85   define variable v-inform-launched as logical no-undo initial false .
       86   procedure proc-alt-shift-f4:
       87     define variable v-action as character no-undo .
       88     if v-inform-launched = false then do:
       89       assign
       90         v-inform-launched = true
       91       .
       92       run gbl/d-inform.w
       93         (  input self
       94         ,  input this-procedure
       95         , output v-action
       96         ) no-error .
       97       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       98       assign
       99         v-inform-launched = false
      100       .
      101     end.
      102   end.
      103   procedure proc-alt-f1:
      104     run gbl/corrhelp.p
      105       (input this-procedure
      106       ) .
      107   end .
      108   on alt-shift-f2 anywhere do:
      109     run proc-alt-shift-f2.
      110   end.
      111   on alt-shift-f3 anywhere do:
      112     run proc-alt-shift-f3 in this-procedure .
      113   end.
      114   on alt-shift-f4 anywhere do:
      115     run proc-alt-shift-f4 in this-procedure.
      116   end.
      117   on alt-f1 anywhere do:
      118     run proc-alt-f1 in this-procedure .
      119   end.
      120   define new global shared variable g#library  as handle no-undo .
      121   define new global shared variable g#library2 as handle no-undo .
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123     define variable v-cntxt-db-num        as integer   no-undo .
      124     define variable v-cntxt-userid        as character no-undo .
      125     define variable v-cntxt-level         as character no-undo .
      126     define variable v-cntxt-host-code-obj as integer   no-undo .
      127     define variable v-cntxt-obj-type      as character no-undo .
      128     define variable v-cntxt-obj-code      as integer   no-undo .
      129     define variable v-cntxt-db-num-obj    as integer   no-undo .
      130     define variable v-cntxt-is-admin      as logical   no-undo .
      131   define variable v-host-code as integer no-undo .
      132   define variable glog as logical no-undo .
      133   DEFINE BUTTON B-exit AUTO-GO
      134        LABEL "&Ввод"
      135        SIZE 10 BY 1
      136        BGCOLOR 8 .
      137   DEFINE BUTTON B-Help
      138        LABEL "Помо&щь"
      139        SIZE 3 BY 1
      140        BGCOLOR 8 .
      141   DEFINE BUTTON b-quit AUTO-END-KEY
      142        LABEL "&Отмена"
      143        SIZE 10 BY 1
      144        BGCOLOR 8 .
      145   DEFINE VARIABLE n-shift-date AS CHARACTER FORMAT "X(256)":U INITIAL "Дата смены (учета):"
      146         VIEW-AS TEXT
      147        SIZE 20 BY 1
      148        FGCOLOR 15  NO-UNDO.
      149   DEFINE VARIABLE n-shift-name AS CHARACTER FORMAT "X(256)":U INITIAL "№ смены"
      150         VIEW-AS TEXT
      151        SIZE 14.4 BY 1
      152        FGCOLOR 15  NO-UNDO.
      153   DEFINE VARIABLE n-shift-num AS CHARACTER FORMAT "X(256)":U INITIAL "Порядок смены"
      154         VIEW-AS TEXT
      155        SIZE 14.4 BY 1
      156        FGCOLOR 15  NO-UNDO.
      157   DEFINE VARIABLE n-shift-reservoir AS CHARACTER FORMAT "X(9)" INITIAL "Резервуар"
      158         VIEW-AS TEXT
      159        SIZE 14.4 BY 1
      160        FGCOLOR 15 NO-UNDO.
      161   DEFINE VARIABLE n-shift-reservoir-from AS CHARACTER FORMAT "X(7)" INITIAL "Сменить"
      162       VIEW-AS TEXT
      163       SIZE 9 BY 1
      164       NO-UNDO.
      165   DEFINE VARIABLE n-shift-reservoir-to AS CHARACTER FORMAT "X(2)" INITIAL "На"
      166       VIEW-AS TEXT
      167       SIZE 9 BY 1
      168       NO-UNDO.
      169   DEFINE VARIABLE shift-date AS DATE FORMAT "99/99/9999":U
      170        VIEW-AS FILL-IN
      171        SIZE 12.8 BY 1 NO-UNDO.
      172   DEFINE VARIABLE shift-name AS CHARACTER FORMAT "X(2)":U INITIAL "0"
      173        VIEW-AS FILL-IN
      174        SIZE 3.4 BY 1 NO-UNDO.
      175   DEFINE VARIABLE shift-name-i AS INTEGER FORMAT "99":U INITIAL 0
      176        VIEW-AS FILL-IN
      177        SIZE 3.4 BY 1 NO-UNDO.
      178   DEFINE VARIABLE shift-num AS INTEGER FORMAT "99":U INITIAL 0
      179        VIEW-AS FILL-IN
      180        SIZE 3.4 BY 1 NO-UNDO.
      181   DEFINE VARIABLE shift-reservoir-from AS CHARACTER FORMAT "X(8)" INITIAL ""
      182        VIEW-AS COMBO-BOX
      183        INNER-LINES 5
      184        LIST-ITEM-PAIRS "def", "1"
      185        DROP-DOWN-LIST
      186        SIZE 18 BY 1 NO-UNDO.
      187   DEFINE VARIABLE shift-reservoir-to AS CHARACTER FORMAT "X(8)" INITIAL ""
      188        VIEW-AS COMBO-BOX
      189        INNER-LINES 5
      190        LIST-ITEM-PAIRS "def", "1"
      191        DROP-DOWN-LIST
      192        SIZE 18 BY 1 NO-UNDO.
      193   DEFINE IMAGE l-shift-date
      194        FILENAME "adeicon\lock":U
      195        SIZE 2.9 BY .93.
      196   DEFINE IMAGE l-shift-name
      197        FILENAME "adeicon\lock":U
      198        SIZE 2.9 BY .93.
      199   DEFINE IMAGE l-shift-num
      200        FILENAME "adeicon\lock":U
      201        SIZE 2.9 BY .93.
      202   DEFINE IMAGE l-shift-reservoir
      203       FILENAME "adeicon\lock":U
      204       SIZE 2.9 BY .93.
      205   DEFINE FRAME Dialog-Frame
      206        b-quit AT ROW 1 COL 1
      207        B-exit AT ROW 1 COL 11
      208        B-Help AT ROW 1 COL 45
      209        shift-date AT ROW 2.5 COL 27.5 COLON-ALIGNED NO-LABEL
      210        shift-name AT ROW 3.93 COL 27.8 COLON-ALIGNED NO-LABEL
      211        shift-name-i AT ROW 3.93 COL 27.8 COLON-ALIGNED NO-LABEL
      212        shift-num AT ROW 5.93 COL 27.8 COLON-ALIGNED NO-LABEL
      213        shift-reservoir-from AT ROW 8.07 COL 27.8 COLON-ALIGNED NO-LABEL
      214        shift-reservoir-to AT ROW 9.07 COL 27.8 COLON-ALIGNED NO-LABEL
      215        n-shift-date AT ROW 2.53 COL 6.1 NO-LABEL
      216        n-shift-name AT ROW 4.07 COL 3.6 COLON-ALIGNED NO-LABEL
      217        n-shift-num AT ROW 6.07 COL 3.6 COLON-ALIGNED NO-LABEL
      218        n-shift-reservoir AT ROW 8.07 COL 3.6 COLON-ALIGNED NO-LABEL
      219        n-shift-reservoir-from AT ROW 8.07 COL 18 COLON-ALIGNED NO-LABEL
      220        n-shift-reservoir-to AT ROW 9.07 COL 18 COLON-ALIGNED NO-LABEL
      221        l-shift-num AT ROW 6 COL 2.6
      222        l-shift-date AT ROW 2.53 COL 2.6
      223        l-shift-name AT ROW 4 COL 2.6
      224        l-shift-reservoir AT ROW 8 COL 2.6
      225        SPACE(42.62) SKIP(2.60)
      226       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      227            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      228            TITLE "Изменение списка чеков"
      229            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      230   ASSIGN
      231          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      232          FRAME Dialog-Frame:HIDDEN           = TRUE.
      233   ASSIGN
      234          shift-name:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      235   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      236   DO:
      237     APPLY "END-ERROR":U TO SELF.
      238   END.
      239   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      240   DO:
      241     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      242     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      243   END.
      244   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      245   DO:
      246     assign
      247     p-shift-date = ?
      248     p-shift-num = 0
      249     p-shift-name = ''
      250     p-change-fields = "":U
      251     .
      252   END.
      253   ON MOUSE-SELECT-CLICK OF l-shift-date IN FRAME Dialog-Frame
      254   DO:
      255      IF l-shift-date:visible then do:
      256       assign
      257       n-shift-date:fgcolor = ?
      258       l-shift-date:visible = false.
      259       enable shift-date with frame Dialog-Frame.
      260       APPLY "ENTRY" TO shift-date.
      261     end.
      262   END.
      263   ON MOUSE-SELECT-CLICK OF l-shift-name IN FRAME Dialog-Frame
      264   DO:
      265      IF l-shift-name:visible then do:
      266       assign
      267       n-shift-name:fgcolor = ?
      268       l-shift-name:visible = false.
      269       enable
      270       shift-name-i
      271       with frame Dialog-Frame.
      272       APPLY "ENTRY" TO shift-name-i.
      273     end.
      274   END.
      275   ON MOUSE-SELECT-CLICK OF l-shift-num IN FRAME Dialog-Frame
      276   DO:
      277      IF l-shift-num:visible then do:
      278       assign
      279       n-shift-num:fgcolor = ?
      280       l-shift-num:visible = false.
      281       enable
      282       shift-num
      283       with frame Dialog-Frame.
      284       APPLY "ENTRY" TO shift-num.
      285     end.
      286   END.
      287   ON MOUSE-SELECT-CLICK OF l-shift-reservoir IN FRAME Dialog-Frame
      288   DO:
      289      IF l-shift-reservoir:visible then do:
      290       assign
      291       n-shift-reservoir:fgcolor = ?
      292       l-shift-reservoir:visible = false.
      293       enable
      294       shift-reservoir-from shift-reservoir-to
      295       with frame Dialog-Frame.
      296       disp n-shift-reservoir-from n-shift-reservoir-to
      297       with frame Dialog-Frame.
      298       APPLY "ENTRY" TO shift-reservoir-from.
      299     end.
      300   END.
      301   ON RIGHT-MOUSE-CLICK OF shift-date IN FRAME Dialog-Frame
      302   DO:
      303       assign
      304       n-shift-date:fgcolor = 15
      305       shift-date = ?
      306       l-shift-date:visible = true.
      307       display shift-date with frame Dialog-Frame.
      308       disable shift-date with frame Dialog-Frame.
      309   END.
      310   ON RIGHT-MOUSE-CLICK OF shift-name IN FRAME Dialog-Frame
      311   DO:
      312       assign
      313       n-shift-name:fgcolor = 15
      314       shift-name = ?
      315       l-shift-name:visible = true.
      316       display shift-name with frame Dialog-Frame.
      317       disable shift-name with frame Dialog-Frame.
      318   END.
      319   ON RIGHT-MOUSE-CLICK OF shift-name-i IN FRAME Dialog-Frame
      320   DO:
      321       assign
      322       n-shift-name:fgcolor = 15
      323       shift-name-i = ?
      324       l-shift-name:visible = true.
      325       display shift-name-i with frame Dialog-Frame.
      326       disable shift-name-i with frame Dialog-Frame.
      327   END.
      328   ON RIGHT-MOUSE-CLICK OF shift-num IN FRAME Dialog-Frame
      329   DO:
      330       assign
      331       n-shift-num:fgcolor = 15
      332       shift-num = ?
      333       l-shift-num:visible = true.
      334       display shift-num with frame Dialog-Frame.
      335       disable shift-num with frame Dialog-Frame.
      336   END.
      337   ON RIGHT-MOUSE-CLICK OF shift-reservoir-from IN FRAME Dialog-Frame
      338   DO:
      339       assign
      340       n-shift-reservoir:fgcolor = 15
      341       shift-reservoir-from = ""
      342       shift-reservoir-to = ""
      343       l-shift-reservoir:visible = true
      344       n-shift-reservoir-from:VISIBLE = false
      345       n-shift-reservoir-to:VISIBLE = false.
      346       display shift-reservoir-from shift-reservoir-to with frame Dialog-Frame.
      347       disable shift-reservoir-from shift-reservoir-to with frame Dialog-Frame.
      348   END.
      349   ON RIGHT-MOUSE-CLICK OF shift-reservoir-to IN FRAME Dialog-Frame
      350   DO:
      351       apply "RIGHT-MOUSE-CLICK" to shift-reservoir-from.
      352   END.
      353   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      354   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      355   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      356   on help of frame Dialog-Frame
      357   do:
      358     run gbl/app_help.p
      359       (input this-procedure :file-name
      360       ,input ''
      361       ,input ?
      362       ) no-error.
      363     if error-status :error then do:
      364       message
      365         "Ошибка при вызове помощи"
      366         error-status :get-message(1)
      367         view-as alert-box .
      368     end.
      369   end.
      370   run minbtn-set in this-procedure .
      371   on choose of b-help in frame Dialog-Frame
      372   do:
      373     apply "help":u to frame Dialog-Frame .
      374   end.
      375   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376   procedure minbtn-set :
      377       do
      378           on error undo, return error return-value
      379           :
      380           define variable ii              as integer       no-undo .
      381           define variable fh              as widget-handle no-undo .
      382           define variable hh              as widget-handle no-undo .
      383           define variable v-h             as handle        extent 4 no-undo .
      384           define variable v-name-button   as character     no-undo .
      385           define variable v-help-old-x    as decimal       no-undo .
      386           define variable v-help-old-y    as decimal       no-undo .
      387           define variable v-help-old-size as decimal       no-undo .
      388           define variable v-frame-width   as decimal       no-undo .
      389           define variable jj              as integer       no-undo .
      390           do
      391               on error undo, return error
      392               :
      393               assign
      394                   v-frame-width = frame Dialog-Frame:width - 0.3
      395                   fh            = frame Dialog-Frame:first-child
      396                   hh            = fh:first-child
      397                   ii            = 1
      398                   .
      399               do while valid-handle(hh):
      400                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      401                   do:
      402                       case lc(hh:name) :
      403                           when "b-help" then
      404                               do:
      405                                   hh:load-image-up("cmp/b-help.bmp":u) .
      406                                   hh:load-image-down("cmp/b-help.bmp":u) .
      407                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      408                                   hh:TOOLTIP = "Помощь" .
      409                                   v-help-old-x = hh:column .
      410                                   v-help-old-y = hh:row    .
      411                                   v-help-old-size = hh:width .
      412                                   hh:width-chars = 2.5 .
      413                               end.
      414                           when "b-print" then
      415                               do:
      416                                   hh:load-image("cmp/b-print.bmp":u) .
      417                                   hh:TOOLTIP = "Печать" .
      418                                   v-h[ii] = hh:handle .
      419                                   ii = ii + 1 .
      420                                   hh:width-chars = 3 .
      421                               end.
      422                           when "b-history" or
      423                           when "b-hist" then
      424                               do:
      425                                   hh:load-image("cmp/b-hist.bmp":u) .
      426                                   hh:TOOLTIP = "История" .
      427                                   v-h[ii] = hh:handle .
      428                                   ii = ii + 1 .
      429                                   hh:width-chars = 3 .
      430                               end.
      431                           when "b-sch" then
      432                               do:
      433                                   hh:load-image("cmp/b-sch.bmp":u) .
      434                                   hh:TOOLTIP = "Установка Фильтра" .
      435                                   v-h[ii] = hh:handle .
      436                                   ii = ii + 1 .
      437                                   hh:width-chars = 3 .
      438                               end.
      439                           when "b-hist-user" then
      440                               do:
      441                                   hh:load-image("cmp/b-hist.bmp":u) .
      442                                   hh:TOOLTIP = "История пользователя" .
      443                                   ii = ii + 1 .
      444                               end.
      445                       end case.
      446                   end.
      447                   hh = hh:next-sibling.
      448               end.
      449               b-help:column = v-frame-width - b-help:width-chars.
      450               jj = 0.
      451               repeat ii = 4 to 1 by -1 :
      452                   if valid-handle (v-h[ii] ) then
      453                   do:
      454                       jj  = jj + 1 .
      455                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      456                       v-h[ii]:row    = v-help-old-y .
      457                   end.
      458               end.
      459           end.
      460       end.
      461   end procedure.
      462   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      463   on ' ' of shift-date in frame Dialog-Frame
      464   do:
      465     if (can-query (self, "sensitive")
      466        and
      467        self :sensitive = true
      468        )
      469     or (can-query (self, "read-only")
      470        and
      471        self :read-only = false
      472        )
      473     then do:
      474       assign
      475         self :screen-value = ?
      476       .
      477     end.
      478     return no-apply.
      479   end.
      480   on delete-character of shift-date in frame Dialog-Frame
      481   do:
      482     if (can-query (self, "sensitive")
      483        and
      484        self :sensitive = true
      485        )
      486     or (can-query (self, "read-only")
      487        and
      488        self :read-only = false
      489        )
      490     then do:
      491       assign
      492         self :screen-value = ?
      493       .
      494     end.
      495     return no-apply.
      496   end.
      497   on ctrl-d of shift-date in frame Dialog-Frame
      498   do:
      499     define variable v-curr-sv-date as date no-undo .
      500     if (can-query (self, "sensitive")
      501        and
      502        self :sensitive = true
      503        )
      504     or (can-query (self, "read-only")
      505        and
      506        self :read-only = false
      507        )
      508     then do:
      509       if self :handle <> focus :handle
      510       then do:
      511         apply "entry":u to self .
      512       end.
      513       run gbl/getcurdt.p
      514         (output v-curr-sv-date
      515         ) .
      516       assign
      517         self :screen-value = string(v-curr-sv-date) .
      518       .
      519     end.
      520     return no-apply.
      521   end.
      522   on ctrl-b of shift-date in frame Dialog-Frame
      523   do:
      524     if (can-query (self, "sensitive")
      525        and
      526        self :sensitive = true
      527        )
      528     or (can-query (self, "read-only")
      529        and
      530        self :read-only = false
      531        )
      532     then do:
      533       if self :handle <> focus :handle
      534       then do:
      535         apply "entry":u to self .
      536       end.
      537       define variable v-curr-sv-date as date no-undo .
      538       define variable v-new-sv-date  as date no-undo .
      539       assign
      540         v-curr-sv-date = date(self :screen-value) no-error
      541       .
      542       if v-curr-sv-date = ?
      543       then do:
      544         run gbl/getcurdt.p
      545           (output v-curr-sv-date
      546           ) .
      547       end.
      548       if v-curr-sv-date <> ?
      549       then do:
      550         assign
      551           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      552         .
      553         assign
      554           self :screen-value = string(v-new-sv-date) .
      555         .
      556       end.
      557     end.
      558     return no-apply .
      559   end.
      560   on ctrl-e of shift-date in frame Dialog-Frame
      561   do:
      562     if (can-query (self, "sensitive")
      563        and
      564        self :sensitive = true
      565        )
      566     or (can-query (self, "read-only")
      567        and
      568        self :read-only = false
      569        )
      570     then do:
      571       if self :handle <> focus :handle
      572       then do:
      573         apply "entry":u to self .
      574       end.
      575       define variable v-curr-sv-date as date no-undo .
      576       define variable v-new-sv-date  as date no-undo .
      577       assign
      578         v-curr-sv-date = date(self :screen-value) no-error
      579       .
      580       if v-curr-sv-date = ?
      581       then do:
      582         run gbl/getcurdt.p
      583           (output v-curr-sv-date
      584           ) .
      585       end.
      586       if v-curr-sv-date <> ?
      587       then do:
      588         run gbl/lastdate.p
      589           (input  v-curr-sv-date
      590           ,output v-new-sv-date
      591           ).
      592         assign
      593           self :screen-value = string(v-new-sv-date) .
      594         .
      595       end.
      596     end.
      597     return no-apply .
      598   end.
      599   on ctrl-f of shift-date in frame Dialog-Frame
      600   do:
      601     if (can-query (self, "sensitive")
      602        and
      603        self :sensitive = true
      604        )
      605     or (can-query (self, "read-only")
      606        and
      607        self :read-only = false
      608        )
      609     then do:
      610       if self :handle <> focus :handle
      611       then do:
      612         apply "entry":u to self .
      613       end.
      614       define variable v-ok            as logical   no-undo .
      615       define variable v-curr-sv-date  as date      no-undo .
      616       define variable v-description   as character no-undo .
      617       assign
      618         v-curr-sv-date = date(self :screen-value) no-error
      619       .
      620       if v-curr-sv-date = ?
      621       then do:
      622         run gbl/getcurdt.p
      623           (output v-curr-sv-date
      624           ) .
      625       end.
      626       if v-curr-sv-date <> ?
      627       then do:
      628         run gbl/d-inpday.w
      629           (input ?
      630           ,input "Выбор даты"
      631           ,input v-description
      632           ,input ""
      633           ,input-output v-curr-sv-date
      634           ,output v-ok
      635           ).
      636         if v-ok = true
      637         then do:
      638           assign
      639             self :screen-value = string(v-curr-sv-date) .
      640           .
      641         end.
      642       end.
      643     end.
      644     return no-apply .
      645   end.
      646     define MENU m-ed-date4
      647       MENU-ITEM m-ed-date4-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
      648       MENU-ITEM m-ed-date4-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
      649       MENU-ITEM m-ed-date4-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
      650       MENU-ITEM m-ed-date4-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
      651       .
      652     if shift-date :POPUP-MENU in frame Dialog-Frame = ?
      653     then do:
      654       ASSIGN
      655         shift-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date4 :HANDLE
      656         shift-date :MENU-MOUSE in frame Dialog-Frame = 3
      657       .
      658     end.
      659     define variable v-label-handle4 as handle no-undo .
      660     assign
      661       v-label-handle4 = shift-date :side-label-handle in frame Dialog-Frame
      662     .
      663     if valid-handle (v-label-handle4)
      664     then do:
      665       if v-label-handle4 :tooltip = ""
      666       or v-label-handle4 :tooltip = ?
      667       then do:
      668         assign
      669           v-label-handle4 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
      670         .
      671       end.
      672     end.
      673     ON CHOOSE OF MENU-ITEM m-ed-date4-1 in menu m-ed-date4 DO:
      674       apply "ctrl-b":U to shift-date in frame Dialog-Frame .
      675     END.
      676     ON CHOOSE OF MENU-ITEM m-ed-date4-2 in menu m-ed-date4 DO:
      677       apply "ctrl-d":U to shift-date in frame Dialog-Frame .
      678     END.
      679     ON CHOOSE OF MENU-ITEM m-ed-date4-3 in menu m-ed-date4 DO:
      680       apply "ctrl-e":U to shift-date in frame Dialog-Frame .
      681     END.
      682     ON CHOOSE OF MENU-ITEM m-ed-date4-4 in menu m-ed-date4 DO:
      683       apply "ctrl-f":U to shift-date in frame Dialog-Frame .
      684     END.
      685   MAIN-BLOCK:
      686   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      687      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      688   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      689     run mainmenu_getcntxt in parparentproc
      690       (output v-cntxt-db-num
      691       ,output v-cntxt-userid
      692       ,output v-cntxt-level
      693       ,output v-cntxt-host-code-obj
      694       ,output v-cntxt-obj-type
      695       ,output v-cntxt-obj-code
      696       ,output v-cntxt-db-num-obj
      697       ,output v-cntxt-is-admin
      698       ) .
      699     RUN enable_UI.
      700     RUN fill-lists (p-curr-obj-type, p-curr-obj-code) .
      701     WAIT-FOR GO OF FRAME Dialog-Frame.
      702   END.
      703   RUN disable_UI.
      704   PROCEDURE disable_UI :
      705     HIDE FRAME Dialog-Frame.
      706   END PROCEDURE.
      707   PROCEDURE enable_UI :
      708     DISPLAY shift-date shift-name-i shift-num shift-reservoir-from shift-reservoir-to
      709             n-shift-date n-shift-name n-shift-num n-shift-reservoir
      710         WITH FRAME Dialog-Frame.
      711     ENABLE b-quit B-exit B-Help l-shift-num l-shift-date l-shift-name l-shift-reservoir
      712            n-shift-date n-shift-name n-shift-num n-shift-reservoir n-shift-reservoir-from
      713         WITH FRAME Dialog-Frame.
      714     VIEW FRAME Dialog-Frame.
      715   END PROCEDURE.
      716   function get-res-num returns char(res-id as int):
      717       def buffer buf_place for ub.place.
      718       find first buf_place no-lock
      719           where buf_place.pl-code = res-id
      720           no-error.
      721       if avail buf_place then
      722           return buf_place.loc1.
      723       else
      724           return "".
      725   end.
      726   PROCEDURE proc-save :
      727   define variable v-message as character no-undo.
      728   define variable loc#log as logical no-undo.
      729   define variable varshift-date as date no-undo .
      730   define variable varshift-num as integer no-undo .
      731   define variable varshift-name as character no-undo.
      732   define variable l-shift-on as logical no-undo .
      733   define variable v-value as character no-undo .
      734   assign
      735   frame Dialog-Frame
      736   shift-date
      737   shift-num
      738   shift-name-i
      739   shift-reservoir-from
      740   shift-reservoir-to
      741   .
      742   if shift-num > 24 then do:
      743     message
      744     "Порядок смены не может быть больше" 24
      745     view-as alert-box error.
      746     return error.
      747   end.
      748   if shift-name-i > 99 then do:
      749     message
      750     "Номер смены не может быть больше" 99
      751     view-as alert-box error.
      752     return error.
      753   end.
      754   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      755   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      756     (input  p-curr-obj-type
      757     ,input  p-curr-obj-code
      758     ,input  'shift-on=request'
      759     ,output l-shift-on
      760     )  .
      761   if l-shift-on then do:
      762   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      763   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
      764     (input  p-curr-obj-type
      765     ,input  p-curr-obj-code
      766     ,output varshift-date
      767     ,output varshift-num
      768     ,output varshift-name
      769     ) no-error .
      770     if error-status:error
      771     or not (varshift-date = shift-date
      772            and shift-date:sensitive)
      773     or not (varshift-num = shift-num
      774             and shift-num:sensitive) then do:
      775   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      776   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      777     (input  p-curr-obj-type
      778     ,input  p-curr-obj-code
      779     ,output v-host-code
      780     )  .
      781   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      782   do:
      783     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      784       (input  v-cntxt-db-num
      785       ,input  v-cntxt-userid
      786       ,input  0
      787       ,input  'actn_receipts_change-back-shift':U
      788       ,input  'object':U
      789       ,input  v-host-code
      790       ,input  p-curr-obj-type
      791       ,input  p-curr-obj-code
      792       ,input  0
      793       ,input  0
      794       ,input  0
      795       ,input  true
      796       ,output glog
      797       )  .
      798   end.
      799       if not glog then do:
      800         undo, return error .
      801       end.
      802       p-can-back-shift = yes.
      803     end.
      804   end.
      805   assign
      806   p-change-fields = '':U
      807   p-change-fields = IF shift-date:SENSITIVE
      808                                     then (p-change-fields + chr(44) + "shift-date":U)
      809                                     else p-change-fields
      810   p-change-fields = IF shift-num:SENSITIVE then
      811                                      (p-change-fields + chr(44) + "shift-num":U)
      812                                      else p-change-fields
      813   p-change-fields = IF shift-name-i:SENSITIVE
      814                   THEN (p-change-fields + chr(44) + "shift-name":U)
      815                   else p-change-fields
      816   p-change-fields = if shift-reservoir-from:SENSITIVE
      817                   then (p-change-fields + chr(44) + "shift-reservoir-from")
      818                   else p-change-fields
      819   p-change-fields = if shift-reservoir-to:SENSITIVE
      820                   then (p-change-fields + chr(44) + "shift-reservoir-to")
      821                   else p-change-fields
      822   p-shift-date = IF shift-date:SENSITIVE then shift-date else ?
      823   p-shift-num = if shift-num:SENSITIVE then shift-num else 0
      824   p-shift-name = if shift-name-i:SENSITIVE then string(shift-name-i) else ''
      825   p-shift-place-to = if shift-reservoir-to:SENSITIVE then int(shift-reservoir-to) else 0
      826   p-shift-place-from = if shift-reservoir-from:SENSITIVE then int(shift-reservoir-from) else 0
      827   v-message = substitute("ДАТА СМЕНЫ (УЧЕТА)=&1 НОМЕР СМЕНЫ=&2 ПОРЯДОК СМЕНЫ=&3 &4"
      828                        , (IF shift-date:SENSITIVE
      829                          then string(shift-date, "99/99/9999")
      830                          else "")
      831                        , (IF shift-name-i:SENSITIVE
      832                          then string(shift-name-i, ">9")
      833                          else "":U)
      834                     , (IF shift-num:SENSITIVE
      835                       then string(shift-num, ">9")
      836                       else "":U)
      837                     , ( if shift-reservoir-to:SENSITIVE
      838                       then "Резеруар (изменить=" + get-res-num(int(shift-reservoir-from)) + " на=" + get-res-num(int(shift-reservoir-to)) + ")"
      839                       else ""
      840                       ))
      841   .
      842   message
      843   "Для списка чеков будут проведены следующие изменения" skip
      844   v-message skip(2)
      845   "При проведении изменения будет проводиться проверка на корректность изменений для каждого конкретного чека" skip
      846   "Если изменения нарушают логику чека, то чек изменен не будет" skip(2)
      847   (if  p-can-back-shift = no
      848    then substitute("ВНИМАНИЕ!!!!&1"  +
      849                   "если сменный режим включен не только на кассах, но и в бэк-офисе,&1" +
      850                   "изменения даты/номера смены можно произвести ТОЛЬКО ПРИ ОТКРЫТОЙ СМЕНЕ&1"  +
      851                   "и дата/номер смены или резервуара чека после изменения должны СОВПАДАТЬ с датой/номером смены в бэк-офисе&1"  +
      852                   "ТАКОЙ ЧЕК ПОПАДЕТ В ОТЧЕТ О ПРОДАЖЕ ТЕКУЩЕЙ СМЕНЫ!&1&1"
      853                   , chr(10))
      854   else '':U)
      855   "Провести изменения даты/смены или резервуара чеков?"
      856   view-as alert-box question buttons YES-NO update loc#log.
      857   if not loc#log  then return error.
      858   END PROCEDURE.
      859   procedure fill-lists:
      860   define input parameter p-obj-type as character no-undo .
      861   define input parameter p-obj-code as integer no-undo .
      862   define variable v-pl-name as character no-undo .
      863   define variable v-pl-code as character no-undo .
      864   define buffer buf_place for ub.place .
      865       do with frame Dialog-Frame:
      866           shift-reservoir-from:DELETE (1).
      867           shift-reservoir-to  :DELETE (1).
      868           for each buf_place no-lock
      869              where buf_place.obj-type = p-obj-type
      870                and buf_place.obj-code = p-obj-code:
      871             assign
      872               v-pl-name = substitute(  "&1 &2",  buf_place.loc1,  replace(buf_place.pl-name, ",", " ")  )
      873               v-pl-code = substitute(  "&1",     buf_place.pl-code)
      874             .
      875             if trim(v-pl-name) = "" then v-pl-name = substitute("&1", buf_place.pl-name) .
      876             if trim(v-pl-name) = "" then v-pl-name = "N Топливо" .
      877             if trim(v-pl-code) = "" then v-pl-code = "0" .
      878             shift-reservoir-from:ADD-LAST(v-pl-name, v-pl-code).
      879             shift-reservoir-to  :ADD-LAST(v-pl-name, v-pl-code).
      880           end.
      881       end.
      882   end procedure.
