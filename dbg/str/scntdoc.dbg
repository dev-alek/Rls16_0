     2058         vss-include-info0 skip
     2059         "Ошибка при обсчете партии" skip
     2060         "Документ партии " bf_tt-clcparts.out-code skip
     2061         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     2062         return-value skip
     2063         error-status:get-message(1) skip
     2064         error-status:get-message(2) skip
     2065         error-status:get-message(3) skip
     2066         view-as alert-box error .
     2067       undo, return error .
     2068     end.
     2069     for each bf_tt-allsum on error undo, return error return-value :
     2070       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
