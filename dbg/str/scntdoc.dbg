     3132               where buf_temp-browse-handle.browse-type = 'width':u
     3133             on error undo, next
     3134             :
     3135               assign
     3136                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3137               .
     3138             end.
     3139             assign
     3140               v-diasize-browse-handle :width = v-browse-width
     3141             .
     3142             for each buf_temp-diasize-handle
     3143             on error undo, next
     3144             :
