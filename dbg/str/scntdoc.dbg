     3023     define variable v-change-sign          as integer   no-undo .
     3024     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3025     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3026     if p-change-value > 0
     3027     then do:
     3028       if frame Dialog-Frame :width + p-change-value >
     3029           session :width-chars
     3030       then do:
     3031         assign
     3032           p-change-value = session :width-chars - frame Dialog-Frame :width
     3033         .
     3034         if p-change-value <= 0
     3035         then do:
     3036           run diasize_position-resize-button in this-procedure .
     3037           return .
     3038         end.
     3039       end.
     3040     end.
     3041     if p-change-value < 0
     3042     then do:
     3043       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3044       then do:
     3045         assign
     3046           p-change-value = v-diasize-orig-frame-width
     3047                          - frame Dialog-Frame :width
     3048         .
     3049         if p-change-value >= 0
     3050         then do:
     3051           run diasize_position-resize-button in this-procedure .
     3052           return .
     3053         end.
     3054       end.
     3055     end.
     3056     if p-change-value >= 0
     3057     then do:
     3058       assign
     3059         v-change-sign = 1
     3060       .
     3061     end.
     3062     else do:
     3063       assign
     3064         v-change-sign = -1
     3065       .
     3066     end.
     3067     assign
     3068       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3069     .
     3070     if p-change-value = 0
     3071     then do:
     3072       run diasize_position-resize-button in this-procedure .
     3073       return .
     3074     end.
     3075     move_block:
     3076     do
     3077     on error undo move_block, leave move_block
     3078     :
     3079       if retry
     3080       then do:
     3081         do
     3082         on error undo move_block, leave move_block
     3083         :
     3084           if p-change-value > 0
     3085           then do:
     3086             for each buf_temp-diasize-handle
     3087             on error undo, next
     3088             :
     3089               assign
     3090                 v-object-handle = buf_temp-diasize-handle.handle-value
     3091               .
     3092               if v-object-handle <> v-diasize-resize-button
     3093               then do:
     3094                 assign
     3095                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3096                 .
     3097               end.
     3098             end.
     3099             assign
     3100               v-diasize-browse-handle :width = v-browse-width
     3101             .
