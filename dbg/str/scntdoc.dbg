     3263         or error-status :get-message(1) <> ""
     3264         then do:
     3265           undo move_block, retry move_block.
     3266         end.
     3267         for each buf_temp-browse-handle
     3268           where buf_temp-browse-handle.browse-type = 'width':u
     3269         on error undo move_block, retry move_block
     3270         :
     3271           assign
     3272             buf_temp-browse-handle.browse-handle :width
     3273               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3274             no-error .
     3275           if error-status :error
     3276           or error-status :get-message(1) <> ""
     3277           then do:
