     3288           then do:
     3289             assign
     3290               v-object-handle :col = v-object-handle :col + p-change-value
     3291               no-error .
     3292             if error-status :error
     3293             or error-status :get-message(1) <> ""
     3294             then do:
     3295               undo move_block, retry move_block .
     3296             end.
     3297           end.
     3298         end.
     3299       end.
     3300       else do:
     3301         for each buf_temp-diasize-handle
     3302         on error undo move_block, retry move_block
     3303         :
     3304           assign
     3305             v-object-handle = buf_temp-diasize-handle.handle-value
     3306           .
     3307           if v-object-handle <> v-diasize-resize-button
     3308           then do:
     3309             assign
     3310               v-object-handle :col = v-object-handle :col + p-change-value
     3311               no-error .
     3312             if error-status :error
     3313             or error-status :get-message(1) <> ""
     3314             then do:
     3315               undo move_block, retry move_block .
     3316             end.
     3317           end.
     3318         end.
     3319         for each buf_temp-browse-handle
     3320           where buf_temp-browse-handle.browse-type = 'width':u
     3321         on error undo move_block, retry move_block
     3322         :
     3323           assign
     3324             buf_temp-browse-handle.browse-handle :width
     3325               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3326             no-error .
