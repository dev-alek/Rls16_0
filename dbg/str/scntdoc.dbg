     1862             then do:
     1863               assign
     1864                 varprice-sale = 0
     1865                 varroad-tax   = 0
     1866                 varexcise     = 0
     1867               .
     1868             end.
     1869             assign
     1870               varlastcur-base     = varprice-sale
     1871               varlastcur-road-tax = varroad-tax
     1872               varlastcur-excise   = varexcise
     1873               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     1874               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     1875               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     1876               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     1877             .
     1878         end.
     1879       end.
     1880       if varcur-fact-qnty = 0 then do:
     1881         assign
     1882           varcur-base      = varlastcur-base
     1883           varcur-road-tax  = varlastcur-road-tax
     1884           varcur-excise    = varlastcur-excise
     1885         .
     1886       end.
     1887       else do:
     1888         assign
     1889           varcur-base      = varcur-base      / varcur-fact-qnty
     1890           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     1891           varcur-excise    = varcur-excise    / varcur-fact-qnty
     1892         .
     1893       end.
     1894       if varcur-vat-pc = ?
