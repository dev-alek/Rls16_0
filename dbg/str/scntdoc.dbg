     3235         v-diasize-resize-button :row = 1.
     3236         v-diasize-resize-button :column = 1.
     3237       end.
     3238       if p-change-value > 0
     3239       then do:
     3240         if frame Dialog-Frame :scrollable = true
     3241         then do:
     3242           assign
     3243             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3244             no-error .
     3245           if error-status :error
     3246           or error-status :get-message(1) <> ""
     3247           then do:
     3248             undo move_block, retry move_block.
     3249           end.
     3250         end.
     3251         assign
     3252           frame Dialog-Frame :width = v-frame-width + p-change-value
