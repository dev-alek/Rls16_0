     2133   end.
     2134   end.
     2135   end procedure.
     2136   define temp-table tt-parts-for-cnt no-undo like ub.parts.
     2137   define temp-table tt-cnt-parts no-undo
     2138   field host-code          like ub.contract.host-code
     2139   field contract-code      like ub.contract.contract-code
     2140   field sum-dsc-base-acc   like ub.doc-line.price-base
     2141   field sum-dsc-rubl-acc   like ub.doc-line.price-base
     2142   field vat-base-acc       like ub.doc-line.price-base
     2143   field vat-rubl-acc       like ub.doc-line.price-base
     2144   field slt-base-acc       like ub.doc-line.price-base
     2145   field slt-rubl-acc       like ub.doc-line.price-base
     2146   field road-tax-base-acc  like ub.doc-line.price-base
     2147   field road-tax-rubl-acc  like ub.doc-line.price-base
     2148   field excise-base-acc    like ub.doc-line.price-base
     2149   field excise-rubl-acc    like ub.doc-line.price-base
     2150   field transport-base-acc like ub.doc-line.price-base
     2151   field transport-rubl-acc like ub.doc-line.price-base
     2152   field other-base-acc     like ub.doc-line.price-base
     2153   field other-rubl-acc     like ub.doc-line.price-base
     2154   field contract-prn-code  like ub.contract.contract-prn-code
     2155   field supp-type          like ub.parts.supp-type
     2156   field supp-code          like ub.parts.supp-code
     2157   field supp-name          like ub.clients.obj-name
     2158   index pi is unique primary host-code contract-code supp-type supp-code.
     2159   procedure cntparts_calc-table-cnt :
     2160   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
     2161   define buffer bf_trn-doc  for ub.trn-doc.
     2162   define buffer bf_parts    for ub.parts.
     2163   do on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2) ) :
     2164   find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code no-lock no-error.
     2165   if not available bf_trn-doc then do:
     2166     return error substitute("Не найден документ с номером &1.", pardoc-code).
     2167   end.
     2168   for each tt-parts-for-cnt on error undo, return error return-value :
     2169     delete tt-parts-for-cnt.
     2170   end.
     2171   for each bf_parts where bf_parts.out-code = bf_trn-doc.doc-code no-lock on error undo, return error return-value :
     2172     create tt-parts-for-cnt.
     2173     buffer-copy bf_parts to tt-parts-for-cnt.
     2174   end.
     2175   run cntparts_calc-tt-table-cnt in this-procedure.
     2176   end.
     2177   end procedure.
     2178   procedure cntparts_calc-tt-table-cnt:
     2179   define buffer bf_contract for ub.contract.
     2180   define buffer bf_clients  for ub.clients.
     2181   do on error undo, return error return-value :
     2182   for each tt-cnt-parts on error undo, return error return-value :
     2183     delete tt-cnt-parts.
     2184   end.
     2185   for each tt-parts-for-cnt on error undo, return error return-value :
     2186     for each tt-allsum on error undo, return error return-value :
     2187       delete tt-allsum.
     2188     end.
     2189     for each tt-clcparts on error undo, return error return-value :
     2190       delete tt-clcparts.
     2191     end.
     2192     create tt-clcparts.
     2193     buffer-copy tt-parts-for-cnt to tt-clcparts.
     2194     run clcprtsl_calc-parts (
     2195         input recid(tt-clcparts),
     2196         input no,
     2197         input no,
     2198         input 0,
     2199         input 0,
     2200         input 0,
     2201         input 0,
     2202         input 0,
     2203         input 0,
     2204         input 0,
     2205         input 0,
     2206         input 0,
     2207         input 0,
     2208         input 0,
     2209         input 0,
     2210         input 0,
     2211         input 0) no-error.
     2212     if error-status:error then do:
     2213       return error substitute ("Ошибка при вызове процедуры clcprtsl_calc-parts &1 &2 &3.", return-value, error-status:get-message(1), error-status:get-message(2)).
     2214     end.
     2215     find first tt-allsum where tt-allsum.sum-type = 'основная_сумма':U.
     2216     find first tt-cnt-parts where tt-cnt-parts.host-code     = tt-parts-for-cnt.host-code     and
     2217                                      tt-cnt-parts.contract-code = tt-parts-for-cnt.contract-code and
     2218                                      tt-cnt-parts.supp-type     = tt-parts-for-cnt.supp-type     and
     2219                                      tt-cnt-parts.supp-code     = tt-parts-for-cnt.supp-code     no-error.
     2220     if not available tt-cnt-parts then do:
     2221       create tt-cnt-parts.
     2222       assign
     2223         tt-cnt-parts.host-code     = tt-parts-for-cnt.host-code
     2224         tt-cnt-parts.contract-code = tt-parts-for-cnt.contract-code.
     2225       if tt-parts-for-cnt.contract-code <> 0 then do:
     2226         find first bf_contract where bf_contract.host-code     = tt-parts-for-cnt.host-code     and
     2227                                      bf_contract.contract-code = tt-parts-for-cnt.contract-code no-lock no-error.
     2228         if not available bf_contract then do:
     2229           return error substitute ("Не найден договор по фирме &1 с внутренним кодом &2.", tt-parts-for-cnt.host-code, tt-parts-for-cnt.contract-code).
     2230         end.
     2231         assign
     2232           tt-cnt-parts.contract-prn-code = bf_contract.contract-prn-code.
     2233       end.
     2234       else do:
     2235         assign
     2236           tt-cnt-parts.contract-prn-code = "без договора".
     2237       end.
     2238       find first bf_clients where bf_clients.obj-type = tt-parts-for-cnt.supp-type and
     2239                                   bf_clients.obj-code = tt-parts-for-cnt.supp-code no-lock no-error.
     2240       if not available bf_clients then do:
     2241         return error substitute ("Не найден поставщик &1 &2.", tt-parts-for-cnt.supp-type, tt-parts-for-cnt.supp-code).
     2242       end.
     2243       assign
     2244         tt-cnt-parts.supp-type = bf_clients.obj-type
     2245         tt-cnt-parts.supp-code = bf_clients.obj-code
     2246         tt-cnt-parts.supp-name = bf_clients.obj-name.
     2247     end.
     2248     assign
     2249       tt-cnt-parts.sum-dsc-base-acc   = tt-cnt-parts.sum-dsc-base-acc   + tt-allsum.sum-dsc-base-acc
     2250       tt-cnt-parts.sum-dsc-rubl-acc   = tt-cnt-parts.sum-dsc-rubl-acc   + tt-allsum.sum-dsc-rubl-acc
     2251       tt-cnt-parts.vat-base-acc       = tt-cnt-parts.vat-base-acc       + tt-allsum.vat-base-acc
     2252       tt-cnt-parts.vat-rubl-acc       = tt-cnt-parts.vat-rubl-acc       + tt-allsum.vat-rubl-acc
     2253       tt-cnt-parts.slt-base-acc       = tt-cnt-parts.slt-base-acc       + tt-allsum.slt-base-acc
     2254       tt-cnt-parts.slt-rubl-acc       = tt-cnt-parts.slt-rubl-acc       + tt-allsum.slt-rubl-acc
     2255       tt-cnt-parts.road-tax-base-acc  = tt-cnt-parts.road-tax-base-acc  + tt-allsum.road-tax-base-acc
     2256       tt-cnt-parts.road-tax-rubl-acc  = tt-cnt-parts.road-tax-rubl-acc  + tt-allsum.road-tax-rubl-acc
     2257       tt-cnt-parts.excise-base-acc    = tt-cnt-parts.excise-base-acc    + tt-allsum.excise-base-acc
     2258       tt-cnt-parts.excise-rubl-acc    = tt-cnt-parts.excise-rubl-acc    + tt-allsum.excise-rubl-acc
     2259       tt-cnt-parts.transport-base-acc = tt-cnt-parts.transport-base-acc + tt-allsum.transport-base-acc
     2260       tt-cnt-parts.transport-rubl-acc = tt-cnt-parts.transport-rubl-acc + tt-allsum.transport-rubl-acc
     2261       tt-cnt-parts.other-base-acc     = tt-cnt-parts.other-base-acc     + tt-allsum.other-base-acc
     2262       tt-cnt-parts.other-rubl-acc     = tt-cnt-parts.other-rubl-acc     + tt-allsum.other-rubl-acc
     2263     .
     2264   end.
     2265   end.
     2266   end procedure.
     2267   procedure cntparts_calc-c-table-cnt :
     2268   define input parameter pardoc-code like ub.c-trn-doc.doc-code no-undo.
     2269   define input parameter parchip-num like ub.c-trn-doc.chip-num no-undo.
     2270   define buffer bf_c-trn-doc for ub.c-trn-doc.
     2271   define buffer bf_c-parts   for ub.c-parts.
     2272   define buffer bf_contract for ub.contract.
     2273   define buffer bf_clients  for ub.clients.
     2274   do on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2) ) :
     2275   find first bf_c-trn-doc where bf_c-trn-doc.doc-code = pardoc-code and
     2276                                 bf_c-trn-doc.chip-num = parchip-num no-lock no-error.
     2277   if not available bf_c-trn-doc then do:
     2278     return error substitute("Не найден удаленный документ с номером &1.", pardoc-code).
     2279   end.
     2280   for each bf_c-parts where bf_c-parts.out-code = bf_c-trn-doc.doc-code and
     2281                             bf_c-parts.chip-num = bf_c-trn-doc.chip-num no-lock on error undo, return error return-value :
     2282     for each tt-allsum on error undo, return error return-value :
     2283       delete tt-allsum.
     2284     end.
     2285     for each tt-clcparts on error undo, return error return-value :
     2286       delete tt-clcparts.
     2287     end.
     2288     create tt-clcparts.
     2289     buffer-copy bf_c-parts to tt-clcparts.
     2290     run clcprtsl_calc-parts (
     2291         input recid(tt-clcparts),
     2292         input no,
     2293         input no,
     2294         input 0,
     2295         input 0,
     2296         input 0,
     2297         input 0,
     2298         input 0,
     2299         input 0,
     2300         input 0,
     2301         input 0,
     2302         input 0,
     2303         input 0,
     2304         input 0,
     2305         input 0,
     2306         input 0,
     2307         input 0) no-error.
     2308     if error-status:error then do:
     2309       return error substitute ("Ошибка при вызове процедуры clcprtsl_calc-parts &1 &2 &3.", return-value, error-status:get-message(1), error-status:get-message(2)).
     2310     end.
     2311     find first tt-allsum where tt-allsum.sum-type = 'основная_сумма':U.
     2312     find first tt-cnt-parts where tt-cnt-parts.host-code     = bf_c-parts.host-code     and
     2313                                      tt-cnt-parts.contract-code = bf_c-parts.contract-code and
     2314                                      tt-cnt-parts.supp-type     = bf_c-parts.supp-type     and
     2315                                      tt-cnt-parts.supp-code     = bf_c-parts.supp-code     no-error.
     2316     if not available tt-cnt-parts then do:
     2317       create tt-cnt-parts.
     2318       assign
     2319         tt-cnt-parts.host-code     = bf_c-parts.host-code
     2320         tt-cnt-parts.contract-code = bf_c-parts.contract-code.
     2321       if bf_c-parts.contract-code <> 0 then do:
     2322         find first bf_contract where bf_contract.host-code     = bf_c-parts.host-code     and
     2323                                      bf_contract.contract-code = bf_c-parts.contract-code no-lock no-error.
     2324         if not available bf_contract then do:
     2325           return error substitute ("Не найден договор по фирме &1 с внутренним кодом &2.", bf_c-parts.host-code, bf_c-parts.contract-code).
     2326         end.
     2327         assign
     2328           tt-cnt-parts.contract-prn-code = bf_contract.contract-prn-code.
     2329       end.
     2330       else do:
     2331         assign
     2332           tt-cnt-parts.contract-prn-code = "без договора".
     2333       end.
     2334       find first bf_clients where bf_clients.obj-type = bf_c-parts.supp-type and
     2335                                   bf_clients.obj-code = bf_c-parts.supp-code no-lock no-error.
     2336       if not available bf_clients then do:
     2337         return error substitute ("Не найден поставщик &1 &2.", bf_c-parts.supp-type, bf_c-parts.supp-code).
     2338       end.
     2339       assign
     2340         tt-cnt-parts.supp-type = bf_clients.obj-type
     2341         tt-cnt-parts.supp-code = bf_clients.obj-code
     2342         tt-cnt-parts.supp-name = bf_clients.obj-name.
     2343     end.
     2344     assign
     2345       tt-cnt-parts.sum-dsc-base-acc   = tt-cnt-parts.sum-dsc-base-acc   + tt-allsum.sum-dsc-base-acc
     2346       tt-cnt-parts.sum-dsc-rubl-acc   = tt-cnt-parts.sum-dsc-rubl-acc   + tt-allsum.sum-dsc-rubl-acc
     2347       tt-cnt-parts.vat-base-acc       = tt-cnt-parts.vat-base-acc       + tt-allsum.vat-base-acc
     2348       tt-cnt-parts.vat-rubl-acc       = tt-cnt-parts.vat-rubl-acc       + tt-allsum.vat-rubl-acc
     2349       tt-cnt-parts.slt-base-acc       = tt-cnt-parts.slt-base-acc       + tt-allsum.slt-base-acc
     2350       tt-cnt-parts.slt-rubl-acc       = tt-cnt-parts.slt-rubl-acc       + tt-allsum.slt-rubl-acc
     2351       tt-cnt-parts.road-tax-base-acc  = tt-cnt-parts.road-tax-base-acc  + tt-allsum.road-tax-base-acc
     2352       tt-cnt-parts.road-tax-rubl-acc  = tt-cnt-parts.road-tax-rubl-acc  + tt-allsum.road-tax-rubl-acc
     2353       tt-cnt-parts.excise-base-acc    = tt-cnt-parts.excise-base-acc    + tt-allsum.excise-base-acc
     2354       tt-cnt-parts.excise-rubl-acc    = tt-cnt-parts.excise-rubl-acc    + tt-allsum.excise-rubl-acc
     2355       tt-cnt-parts.transport-base-acc = tt-cnt-parts.transport-base-acc + tt-allsum.transport-base-acc
     2356       tt-cnt-parts.transport-rubl-acc = tt-cnt-parts.transport-rubl-acc + tt-allsum.transport-rubl-acc
     2357       tt-cnt-parts.other-base-acc     = tt-cnt-parts.other-base-acc     + tt-allsum.other-base-acc
     2358       tt-cnt-parts.other-rubl-acc     = tt-cnt-parts.other-rubl-acc     + tt-allsum.other-rubl-acc
     2359     .
     2360   end.
     2361   end.
     2362   end procedure.
     2363   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2364   procedure tax-name:
     2365   define input  parameter pardef-tax  as character           no-undo.
     2366   define output parameter parname-tax as character initial ? no-undo.
     2367   define buffer bf_tax for ub.tax.
     2368   do on error undo, return error :
     2369      case pardef-tax:
     2370         when 'vat':U then do:
     2371                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
     2372         end.
     2373         when 'slt':U then do:
     2374                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
     2375         end.
     2376         when 'rdt':U then do:
     2377                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
     2378         end.
     2379         when 'exc':U then do:
     2380                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
     2381         end.
     2382         otherwise do:
     2383            return error "Задан неверный параметр " + pardef-tax + " .".
     2384         end.
     2385      end case.
     2386   end.
     2387   end procedure.
     2388   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
     2389   define input parameter parfin-db   as   logical             no-undo.
     2390   DEFINE VARIABLE vartax-name AS CHARACTER NO-UNDO.
     2391   DEFINE BUFFER bf_parts FOR ub.parts.
     2392   DEFINE BUFFER bf_fin-gds-part FOR ub.fin-gds-part.
     2393   DEFINE BUFFER bf_trn-doc FOR ub.trn-doc.
     2394   define buffer bf_fin-ob for ub.fin-ob.
     2395   define buffer bf_goods for ub.goods.
     2396   DEFINE BUTTON b-exit AUTO-GO
     2397        LABEL "&Выход"
     2398        SIZE 10 BY 1
     2399        BGCOLOR 8 .
     2400   DEFINE BUTTON b-fin-doc
     2401        LABEL "&Платежи"
     2402        SIZE 10 BY 1.
     2403   DEFINE BUTTON b-fin-ob
     2404        LABEL "&Фин. об"
     2405        SIZE 10 BY 1.
     2406   DEFINE BUTTON b-fin-pob
     2407        LABEL "П&редфиноб"
     2408        SIZE 10 BY 1.
     2409   DEFINE BUTTON b-help
     2410        LABEL "&Помощь"
     2411        SIZE 10 BY 1
     2412        BGCOLOR 8 .
     2413   DEFINE QUERY b-parts FOR
     2414         bf_parts,
     2415         bf_goods,
     2416         bf_fin-gds-part,
     2417         bf_fin-ob SCROLLING.
     2418   DEFINE QUERY b-supp-cnt FOR
     2419         tt-cnt-parts SCROLLING.
     2420   DEFINE BROWSE b-parts
     2421     QUERY b-parts DISPLAY
     2422         bf_parts.in-code COLUMN-LABEL "Прих. накл."
     2423    bf_parts.part-code FORMAT "x(15)" COLUMN-LABEL "Код партии"
     2424    bf_parts.fact-qnty COLUMN-LABEL "Факт кол-во"
     2425    bf_parts.price-base COLUMN-LABEL "Цена (вал)"
     2426    bf_parts.price-rubl COLUMN-LABEL "Цена (abbr_rub)"
     2427    bf_fin-ob.prn-doc-code COLUMN-LABEL "Фин. обязат."
     2428    bf_fin-ob.doc-code COLUMN-LABEL "Вн. код."
     2429       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9
     2430            TITLE "Партии по договору".
     2431   DEFINE BROWSE b-supp-cnt
     2432     QUERY b-supp-cnt DISPLAY
     2433         tt-cnt-parts.contract-prn-code COLUMN-LABEL "Договор"
     2434    tt-cnt-parts.supp-name FORMAT "x(20)" COLUMN-LABEL "Поставщик"
     2435    tt-cnt-parts.supp-type COLUMN-LABEL ""
     2436    tt-cnt-parts.supp-code COLUMN-LABEL ""
     2437    tt-cnt-parts.sum-dsc-base-acc COLUMN-LABEL "Сумма (вал)"
     2438    tt-cnt-parts.sum-dsc-rubl-acc COLUMN-LABEL "Сумма (abbr_rub)"
     2439    tt-cnt-parts.vat-base-acc COLUMN-LABEL "НДС (вал)"
     2440    tt-cnt-parts.vat-rubl-acc COLUMN-LABEL "НДС (abbr_rub)"
     2441    tt-cnt-parts.road-tax-base-acc COLUMN-LABEL ""
     2442    tt-cnt-parts.road-tax-rubl-acc COLUMN-LABEL ""
     2443    tt-cnt-parts.transport-base-acc COLUMN-LABEL "Транспортные расходы (вал)"
     2444    tt-cnt-parts.transport-rubl-acc COLUMN-LABEL "Транспортные расходы (abbr_rub)"
     2445    tt-cnt-parts.other-base-acc COLUMN-LABEL "Прочие расходы (вал)"
     2446    tt-cnt-parts.other-rubl-acc COLUMN-LABEL "Прочие расходы (abbr_rub)"
     2447    tt-cnt-parts.slt-base-acc COLUMN-LABEL "НП (вал)"
     2448    tt-cnt-parts.slt-rubl-acc COLUMN-LABEL "НП (abbr_rub)"
     2449    tt-cnt-parts.excise-base-acc COLUMN-LABEL "Акциз (вал)"
     2450    tt-cnt-parts.excise-rubl-acc COLUMN-LABEL "Акциз (abbr_rub)"
     2451    tt-cnt-parts.contract-code COLUMN-LABEL "Вн. номер договора"
     2452       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.5 BY 9
     2453            TITLE "Договора" ROW-HEIGHT-CHARS .67.
     2454   DEFINE FRAME Dialog-Frame
     2455        b-exit AT ROW 1 COL 1
     2456        b-fin-pob AT ROW 1 COL 11
     2457        b-fin-ob AT ROW 1 COL 21
     2458        b-fin-doc AT ROW 1 COL 31
     2459        b-help AT ROW 1 COL 41
     2460        b-supp-cnt AT ROW 2.5 COL 1
     2461        b-parts AT ROW 12 COL 1
     2462        SPACE(0.50) SKIP(0.00)
     2463       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2464            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2465            TITLE "Разбивка документа по договорам поставщиков"
     2466            DEFAULT-BUTTON b-exit.
     2467   ASSIGN
     2468          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2469          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2470   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2471   DO:
     2472     APPLY "END-ERROR":U TO SELF.
     2473   END.
     2474   ON CHOOSE OF b-fin-doc IN FRAME Dialog-Frame
     2475   DO:
     2476     run str/sfddoc.w (INPUT pardoc-code).
     2477   END.
     2478   ON CHOOSE OF b-fin-ob IN FRAME Dialog-Frame
     2479   DO:
     2480     run str/sfodoc.w (INPUT pardoc-code).
     2481   END.
     2482   ON CHOOSE OF b-fin-pob IN FRAME Dialog-Frame
     2483   DO:
     2484     run str/spfodoc.w (INPUT pardoc-code).
     2485   END.
     2486   ON VALUE-CHANGED OF b-supp-cnt IN FRAME Dialog-Frame
     2487   DO:
     2488     RUN open-query-parts IN THIS-PROCEDURE.
     2489   END.
     2490   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2491   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2492   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2493   on help of frame Dialog-Frame
     2494   do:
     2495     run gbl/app_help.p
     2496       (input this-procedure :file-name
     2497       ,input ''
     2498       ,input ?
     2499       ) no-error.
     2500     if error-status :error then do:
     2501       message
     2502         "Ошибка при вызове помощи"
     2503         error-status :get-message(1)
     2504         view-as alert-box .
     2505     end.
     2506   end.
     2507   run minbtn-set in this-procedure .
     2508   on choose of b-help in frame Dialog-Frame
     2509   do:
     2510     apply "help":u to frame Dialog-Frame .
     2511   end.
     2512   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2513   procedure minbtn-set :
     2514       do
     2515           on error undo, return error return-value
     2516           :
     2517           define variable ii              as integer       no-undo .
     2518           define variable fh              as widget-handle no-undo .
     2519           define variable hh              as widget-handle no-undo .
     2520           define variable v-h             as handle        extent 4 no-undo .
     2521           define variable v-name-button   as character     no-undo .
     2522           define variable v-help-old-x    as decimal       no-undo .
     2523           define variable v-help-old-y    as decimal       no-undo .
     2524           define variable v-help-old-size as decimal       no-undo .
     2525           define variable v-frame-width   as decimal       no-undo .
     2526           define variable jj              as integer       no-undo .
     2527           do
     2528               on error undo, return error
     2529               :
     2530               assign
     2531                   v-frame-width = frame Dialog-Frame:width - 0.3
     2532                   fh            = frame Dialog-Frame:first-child
     2533                   hh            = fh:first-child
     2534                   ii            = 1
     2535                   .
     2536               do while valid-handle(hh):
     2537                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2538                   do:
     2539                       case lc(hh:name) :
     2540                           when "b-help" then
     2541                               do:
     2542                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2543                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2544                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2545                                   hh:TOOLTIP = "Помощь" .
     2546                                   v-help-old-x = hh:column .
     2547                                   v-help-old-y = hh:row    .
     2548                                   v-help-old-size = hh:width .
     2549                                   hh:width-chars = 2.5 .
     2550                               end.
     2551                           when "b-print" then
     2552                               do:
     2553                                   hh:load-image("cmp/b-print.bmp":u) .
     2554                                   hh:TOOLTIP = "Печать" .
     2555                                   v-h[ii] = hh:handle .
     2556                                   ii = ii + 1 .
     2557                                   hh:width-chars = 3 .
     2558                               end.
     2559                           when "b-history" or
     2560                           when "b-hist" then
     2561                               do:
     2562                                   hh:load-image("cmp/b-hist.bmp":u) .
     2563                                   hh:TOOLTIP = "История" .
     2564                                   v-h[ii] = hh:handle .
     2565                                   ii = ii + 1 .
     2566                                   hh:width-chars = 3 .
     2567                               end.
     2568                           when "b-sch" then
     2569                               do:
     2570                                   hh:load-image("cmp/b-sch.bmp":u) .
     2571                                   hh:TOOLTIP = "Установка Фильтра" .
     2572                                   v-h[ii] = hh:handle .
     2573                                   ii = ii + 1 .
     2574                                   hh:width-chars = 3 .
     2575                               end.
     2576                           when "b-hist-user" then
     2577                               do:
     2578                                   hh:load-image("cmp/b-hist.bmp":u) .
     2579                                   hh:TOOLTIP = "История пользователя" .
     2580                                   ii = ii + 1 .
     2581                               end.
     2582                       end case.
     2583                   end.
     2584                   hh = hh:next-sibling.
     2585               end.
     2586               b-help:column = v-frame-width - b-help:width-chars.
     2587               jj = 0.
     2588               repeat ii = 4 to 1 by -1 :
     2589                   if valid-handle (v-h[ii] ) then
     2590                   do:
     2591                       jj  = jj + 1 .
     2592                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2593                       v-h[ii]:row    = v-help-old-y .
     2594                   end.
     2595               end.
     2596           end.
     2597       end.
     2598   end procedure.
     2599   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2600   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2601   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2602   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2603   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2604   define variable v-diasize-current-frame-height as decimal   no-undo .
     2605   define variable v-diasize-change-size          as logical   no-undo .
     2606   define variable v-diasize-resize-button        as handle    no-undo .
     2607   define variable v-diasize-wndmax               as logical   no-undo .
     2608   define variable v-diasize-wndstore             as logical   no-undo .
     2609   define variable v-diasize-proc-name            as character no-undo .
     2610   define variable v-diasize-browse-handle        as handle    no-undo .
     2611   define variable v-diasize-browse-number        as integer   no-undo .
     2612   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2613   define temp-table temp-diasize-handle no-undo
     2614     field handle-value  as handle
     2615     field save-position as decimal
     2616     index xpk is primary unique handle-value
     2617     .
     2618   define temp-table temp-browse-handle no-undo
     2619     field browse-type   as character
     2620     field browse-number as integer
     2621     field browse-handle as handle
     2622     field original-size as decimal
     2623     index xpk is primary unique browse-type browse-number
     2624     index xie browse-type browse-handle
     2625   .
     2626   procedure diasize_change-height :
     2627     define input  parameter p-change-value  as decimal   no-undo .
     2628     define input  parameter p-move-resize   as logical   no-undo .
     2629     define variable v-field-group-handle    as handle    no-undo .
     2630     define variable v-object-handle         as handle    no-undo .
     2631     define variable v-frame-height          as decimal   no-undo .
     2632     define variable v-frame-virtual-height  as decimal   no-undo .
     2633     define variable v-browse-height         as decimal   no-undo .
     2634     define variable v-window-height         as decimal   no-undo .
     2635     define variable v-window-virtual-height as decimal   no-undo .
     2636     define variable v-change-sign           as integer   no-undo .
     2637     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2638     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2639     if p-change-value > 0
     2640     then do:
     2641       if frame Dialog-Frame :height + p-change-value
     2642           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2643       then do:
     2644         assign
     2645           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2646                           - (frame Dialog-Frame :height-chars)
     2647         .
     2648         if p-change-value <= 0
     2649         then do:
     2650           run diasize_position-resize-button in this-procedure .
     2651           return .
     2652         end.
     2653       end.
     2654     end.
     2655     if p-change-value < 0
     2656     then do:
     2657       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2658       then do:
     2659         assign
     2660           p-change-value = v-diasize-orig-frame-height
     2661                          - (frame Dialog-Frame :height-chars)
     2662         .
     2663         if p-change-value >= 0
     2664         then do:
     2665           run diasize_position-resize-button in this-procedure .
     2666           return .
     2667         end.
     2668       end.
     2669     end.
     2670     if p-change-value >= 0
     2671     then do:
     2672       assign
     2673         v-change-sign = 1
     2674       .
     2675     end.
     2676     else do:
     2677       assign
     2678         v-change-sign = -1
     2679       .
     2680     end.
     2681     assign
     2682       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2683     .
     2684     if p-change-value = 0
     2685     then do:
     2686       run diasize_position-resize-button in this-procedure .
     2687       return .
     2688     end.
     2689     move_block:
     2690     do
     2691     on error undo move_block, retry move_block
     2692     :
     2693       if retry
     2694       then do:
     2695         do
     2696         on error undo move_block, leave move_block
     2697         :
     2698           if p-change-value > 0
     2699           then do:
     2700             for each buf_temp-diasize-handle
     2701             on error undo, next
     2702             :
     2703               assign
     2704                 v-object-handle = buf_temp-diasize-handle.handle-value
     2705               .
     2706               if v-object-handle <> v-diasize-resize-button
     2707               then do:
     2708                 assign
     2709                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2710                 .
     2711               end.
     2712             end.
     2713             assign
     2714               v-diasize-browse-handle :height = v-browse-height
     2715             .
     2716             for each buf_temp-browse-handle
     2717               where buf_temp-browse-handle.browse-type = 'height':u
     2718             on error undo, next
     2719             :
     2720               assign
     2721                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2722               .
     2723             end.
     2724             assign
     2725               frame Dialog-Frame :height = v-frame-height
     2726             .
     2727             if frame Dialog-Frame :scrollable = true
     2728             then do:
     2729               assign
     2730                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2731               .
     2732             end.
     2733             run diasize_position-resize-button in this-procedure .
     2734           end.
     2735           else do:
     2736             if frame Dialog-Frame :scrollable = true
     2737             then do:
     2738               assign
     2739                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2740               .
     2741             end.
     2742             assign
     2743               frame Dialog-Frame :height = v-frame-height
     2744             .
     2745             assign
     2746               v-diasize-browse-handle :height = v-browse-height
     2747             .
     2748             for each buf_temp-browse-handle
     2749               where buf_temp-browse-handle.browse-type = 'height':u
     2750             on error undo, next
     2751             :
     2752               assign
     2753                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2754               .
     2755             end.
     2756             for each buf_temp-diasize-handle
     2757             on error undo, next
     2758             :
     2759               assign
     2760                 v-object-handle = buf_temp-diasize-handle.handle-value
     2761               .
     2762               if v-object-handle <> v-diasize-resize-button
     2763               then do:
     2764                 assign
     2765                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2766                 .
     2767               end.
     2768             end.
     2769             run diasize_position-resize-button in this-procedure .
     2770           end.
     2771           assign
     2772             v-diasize-change-size = false
     2773           .
     2774           leave move_block .
     2775         end.
     2776       end.
     2777       assign
     2778         v-diasize-need-full-display = true
     2779       .
     2780       if v-diasize-change-size = false
     2781       then do:
     2782         assign
     2783           v-diasize-change-size = true
     2784         .
     2785       end.
     2786       else do:
     2787         return .
     2788       end.
     2789       assign
     2790         v-frame-height = frame Dialog-Frame :height
     2791         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2792         v-browse-height = v-diasize-browse-handle :height
     2793       .
     2794       for each buf_temp-browse-handle
     2795         where buf_temp-browse-handle.browse-type = 'height':u
     2796       :
     2797         assign
     2798           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2799         .
     2800       end.
     2801       for each buf_temp-diasize-handle
     2802       :
     2803         delete buf_temp-diasize-handle .
     2804       end.
     2805       assign
     2806         v-field-group-handle = frame Dialog-Frame :first-child
     2807       .
     2808       do while valid-handle(v-field-group-handle)
     2809       :
     2810         assign
     2811           v-object-handle = v-field-group-handle :first-child
     2812         .
     2813         do while valid-handle(v-object-handle)
     2814         :
     2815           if  v-object-handle <> v-diasize-browse-handle :handle
     2816           and can-query(v-object-handle, "row")
     2817           and can-query(v-object-handle, "height")
     2818           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2819           then do:
     2820             find first buf_temp-browse-handle
     2821               where buf_temp-browse-handle.browse-type   = 'height':u
     2822                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2823               no-error .
     2824             if available buf_temp-browse-handle
     2825             then do:
     2826             end.
     2827             else do:
