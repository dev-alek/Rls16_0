     3200         :
     3201           if  v-object-handle <> v-diasize-browse-handle :handle
     3202           and v-object-handle <> v-diasize-resize-button
     3203           and can-query(v-object-handle, "row")
     3204           and can-query(v-object-handle, "height")
     3205           and ( v-object-handle :col + v-object-handle :width
     3206                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3207               )
     3208           then do:
     3209             find first buf_temp-browse-handle
     3210               where buf_temp-browse-handle.browse-type   = 'width':u
     3211                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3212               no-error .
     3213             if available buf_temp-browse-handle
     3214             then do:
     3215             end.
