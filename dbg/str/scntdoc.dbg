     3386     .
     3387   end procedure.
     3388   procedure diasize_set-width :
     3389     define input  parameter p-new-width  as decimal   no-undo .
     3390     define input  parameter p-move-resize as logical   no-undo .
     3391     do
     3392     on error undo, return error return-value
     3393     :
     3394       run diasize_change-width in this-procedure
     3395         (input  (p-new-width - frame Dialog-Frame :width)
     3396         ,input  p-move-resize
     3397         ) .
     3398     end.
     3399   end procedure.
     3400   procedure diasize_position-resize-button :
     3401     do with frame Dialog-Frame
     3402     :
     3403       hide v-diasize-resize-button .
     3404       assign
     3405         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3406                     - 1
     3407                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3408         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3409                     - 1
     3410                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3411       .
     3412       view v-diasize-resize-button .
     3413     end.
     3414   end procedure.
     3415   on alt-right anywhere
     3416   do:
     3417     run diasize_change-width in this-procedure
     3418       (input 1
     3419       ,input true
     3420       ) .
     3421     return no-apply .
     3422   end.
     3423   on alt-left anywhere
     3424   do:
     3425     run diasize_change-width in this-procedure
     3426       (input -1
     3427       ,input true
     3428       ) .
     3429     return no-apply .
     3430   end.
     3431   on alt-down anywhere
     3432   do:
     3433     run diasize_change-height in this-procedure
     3434       (input 1
     3435       ,input true
     3436       ) .
     3437     return no-apply .
     3438   end.
     3439   on alt-up anywhere
     3440   do:
     3441     run diasize_change-height in this-procedure
     3442       (input -1
     3443       ,input true
     3444       ) .
     3445     return no-apply .
     3446   end.
     3447   on alt-enter of frame Dialog-Frame
     3448   do:
     3449     run diasize_maximize in this-procedure
     3450       (input  ?
     3451       ).
     3452     return no-apply .
     3453   end.
     3454   procedure diasize_end-move :
     3455     do
     3456     on error undo, return error return-value
     3457     :
     3458       define variable v-row-delta as decimal   no-undo .
     3459       define variable v-col-delta as decimal   no-undo .
     3460       define variable v-new-row as decimal   no-undo .
     3461       define variable v-new-col as decimal   no-undo .
     3462       assign
     3463         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3464         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3465       .
     3466       assign
     3467         v-row-delta = v-new-row - frame Dialog-Frame :height
     3468         v-col-delta = v-new-col - frame Dialog-Frame :width
     3469       .
     3470       run diasize_change-height in this-procedure
     3471         (input v-row-delta
     3472         ,input true
     3473         ) .
     3474       run diasize_change-width in this-procedure
     3475         (input v-col-delta
     3476         ,input true
     3477         ) .
     3478     end.
     3479   end procedure.
     3480   procedure diasize_maximize :
     3481     define input  parameter p-action as logical   no-undo .
     3482     do
     3483     on error undo, return error return-value
     3484     :
     3485       if p-action = ?
     3486       then do:
     3487         if v-diasize-need-maximize = true
     3488         then do:
     3489           assign
     3490             p-action = true
     3491           .
     3492         end.
     3493         else do:
     3494           assign
     3495             p-action = false
     3496           .
     3497         end.
     3498       end.
     3499       if p-action = true
     3500       then do:
     3501         run diasize_change-height in this-procedure
     3502           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3503               - frame Dialog-Frame :height-chars
     3504           ,input true
     3505           ) .
     3506         run diasize_change-width in this-procedure
     3507           (input session :width-chars
     3508               - frame Dialog-Frame :width-chars
     3509           ,input true
     3510           ) .
     3511         assign
     3512           v-diasize-need-maximize = false
     3513         .
     3514       end.
     3515       else do:
     3516         run diasize_change-width in this-procedure
     3517           (input v-diasize-orig-frame-width
     3518               - frame Dialog-Frame :width-chars
     3519           ,input true
     3520           ) .
     3521         run diasize_change-height in this-procedure
     3522           (input v-diasize-orig-frame-height
     3523               - frame Dialog-Frame :height-chars
     3524           ,input true
     3525           ) .
     3526         assign
     3527           v-diasize-need-maximize = true
     3528         .
     3529       end.
     3530     end.
     3531   end procedure.
     3532   procedure diasize_restore-orig-size :
     3533     do
     3534     on error undo, return error return-value
     3535     :
     3536       assign
     3537         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3538         v-diasize-current-frame-height = frame Dialog-Frame :height
     3539       .
     3540       run diasize_set-height in this-procedure
     3541         (input  v-diasize-orig-frame-height
     3542         ,input  true
     3543         ) .
     3544       run diasize_set-width in this-procedure
     3545         (input  v-diasize-orig-frame-width
     3546         ,input  true
     3547         ) .
     3548     end.
     3549   end procedure.
     3550   procedure diasize_restore-current-size :
     3551     do
     3552     on error undo, return error return-value
     3553     :
     3554       run diasize_set-height in this-procedure
     3555         (input  v-diasize-current-frame-height
     3556         ,input  true
     3557         ) .
     3558       run diasize_set-width in this-procedure
     3559         (input  v-diasize-current-frame-width
     3560         ,input  true
     3561         ) .
     3562     end.
     3563   end procedure.
     3564   procedure diasize_set-browse-handle :
     3565     define input  parameter p-browse-handle as handle   no-undo .
     3566     define buffer buf_temp-browse-handle for temp-browse-handle .
     3567     do
     3568     on error undo, return error return-value
     3569     :
     3570       assign
     3571         v-diasize-browse-handle = p-browse-handle
     3572       .
     3573       for each buf_temp-browse-handle
     3574       on error undo, return error return-value
     3575       :
     3576         delete buf_temp-browse-handle .
     3577       end.
     3578     end.
     3579   end procedure.
     3580   procedure diasize_add_browse :
     3581     define input  parameter p-browse-type   as character no-undo .
     3582     define input  parameter p-browse-handle as handle    no-undo .
     3583     define buffer buf_temp-browse-handle for temp-browse-handle .
     3584     do
     3585     on error undo, return error return-value
     3586     :
     3587       assign
     3588         v-diasize-browse-number = v-diasize-browse-number + 1
     3589       .
     3590       create buf_temp-browse-handle .
     3591       assign
     3592         buf_temp-browse-handle.browse-type   = p-browse-type
     3593         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3594         buf_temp-browse-handle.browse-handle = p-browse-handle
     3595       .
     3596     end.
     3597   end procedure.
     3598   procedure diasize_init :
     3599     define variable v-default-value    as logical   no-undo .
     3600     define variable v-restore-saved    as logical   no-undo .
     3601     define variable v-resize-value-str as character no-undo .
     3602     do
     3603     on error undo, return error return-value
     3604     :
     3605       do with frame Dialog-Frame
     3606       :
     3607         assign
     3608           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3609           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3610           v-diasize-browse-handle     = browse b-supp-cnt :handle
     3611         .
     3612         create button v-diasize-resize-button
     3613         assign
     3614           parent        = frame Dialog-Frame :first-child
     3615           label         = "s"
     3616           height-pixels = 16
     3617           width-pixels  = 16
     3618           visible       = true
     3619           sensitive     = true
     3620           movable       = true
     3621           triggers:
     3622             on end-move persistent run diasize_end-move in this-procedure .
     3623           end triggers.
     3624         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3625         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3626         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3627         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3628         assign
     3629           v-diasize-wndmax = false
     3630         .
     3631         if connected("ub") = true
     3632         then do:
     3633           define variable v-cntxt-db-num        as integer   no-undo .
     3634           define variable v-cntxt-userid        as character no-undo .
     3635           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3636                                             , OUTPUT v-cntxt-userid
     3637                                             ) .
     3638           run gbl/wndpar_r.p
     3639             (input  v-cntxt-db-num
     3640             ,input  v-cntxt-userid
     3641             ,input  'wndmax':U
     3642             ,output v-diasize-wndmax
     3643             ,output v-default-value
     3644             ) .
     3645         end.
     3646         assign
     3647           v-diasize-wndstore = false
     3648         .
     3649         if connected("ub") = true
     3650         then do:
     3651           run gbl/wndpar_r.p
     3652             (input  v-cntxt-db-num
     3653             ,input  v-cntxt-userid
     3654             ,input  'wndstore':U
     3655             ,output v-diasize-wndstore
     3656             ,output v-default-value
     3657             ) .
     3658         end.
     3659         assign
     3660           v-diasize-proc-name = entry(1, program-name(2), '.')
     3661         .
     3662         if v-diasize-wndstore = true
     3663         then do:
     3664           assign
     3665             v-restore-saved = false
     3666           .
     3667           if connected("ub") = true
     3668           then do:
     3669             run gbl/wndsizer.p
     3670               (input  v-cntxt-db-num
     3671               ,input  v-cntxt-userid
     3672               ,input  v-diasize-proc-name
     3673               ,input  'height':u
     3674               ,output v-resize-value-str
     3675               ) .
     3676             if v-resize-value-str <> '':U
     3677             then do:
     3678               run diasize_change-height in this-procedure
     3679                 (input  integer(v-resize-value-str)
     3680                 ,input  true
     3681                 ) .
     3682               assign
     3683                 v-restore-saved = true
     3684               .
     3685             end.
     3686           end.
     3687           if connected("ub") = true
     3688           then do:
     3689             run gbl/wndsizer.p
     3690               (input  v-cntxt-db-num
     3691               ,input  v-cntxt-userid
     3692               ,input  v-diasize-proc-name
     3693               ,input  'width':u
     3694               ,output v-resize-value-str
     3695               ) .
     3696             if v-resize-value-str <> '':U
     3697             then do:
     3698               run diasize_change-width in this-procedure
     3699                 (input  integer(v-resize-value-str)
     3700                 ,input  true
     3701                 ) .
     3702               assign
     3703                 v-restore-saved = true
     3704               .
     3705             end.
     3706           end.
     3707           if v-restore-saved <> true
     3708           then do:
     3709             if v-diasize-wndmax = true
     3710             then do:
     3711               run diasize_maximize in this-procedure
     3712                 (input  true
     3713                 ) .
     3714             end.
     3715           end.
     3716         end.
     3717         else do:
     3718           if v-diasize-wndmax = true
     3719           then do:
     3720             run diasize_maximize in this-procedure
     3721               (input  true
     3722               ) .
     3723           end.
     3724         end.
     3725       end.
     3726     end.
     3727   end procedure.
     3728   procedure diasize_need-full-display :
     3729     define output parameter p-need-full-display as logical   no-undo .
     3730     do
     3731     on error undo, return error return-value
     3732     :
     3733       assign
     3734         p-need-full-display = v-diasize-need-full-display
     3735       .
     3736       assign
     3737         v-diasize-need-full-display = false
     3738       .
     3739     end.
     3740   end procedure.
     3741   procedure get-context :
     3742      define output parameter p-db-num as integer          no-undo.
     3743      define output parameter p-user-id as character        no-undo.
     3744      define variable v-login               as character    no-undo.
     3745      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3746      define buffer buf_user-login  for ub.user-login .
     3747      do
     3748      on error undo, return error
     3749      :
     3750            FIND FIRST buf_sys-ctrl no-lock.
     3751            ASSIGN
     3752               v-login = USERID("ub")
     3753               p-db-num = buf_sys-ctrl.db-num
     3754            .
     3755            FIND FIRST buf_user-login
     3756                 WHERE buf_user-login.db-num = p-db-num
     3757                   AND buf_user-login.user-login = v-login
     3758                 no-lock
     3759                 no-error
     3760                 .
     3761            IF AVAILABLE buf_user-login
     3762            THEN DO:
     3763               assign
     3764                  p-user-id = buf_user-login.user-id
     3765               .
     3766            END.
     3767      end.
     3768   end procedure.
     3769   run diasize_add_browse in this-procedure
     3770     (input  'width':u
     3771     ,input  browse b-parts:handle
     3772     ) .
     3773   run diasize_init in this-procedure .
     3774   main-block:
     3775   do on error   undo main-block, leave main-block
     3776      on end-key undo main-block, leave main-block:
     3777    find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code no-lock.
     3778    run tax-name ('rdt':U, output vartax-name).
     3779    assign
     3780    tt-cnt-parts.road-tax-base-acc:label in browse b-supp-cnt  = vartax-name + " (вал)"
     3781    tt-cnt-parts.road-tax-rubl-acc:label in browse b-supp-cnt  = vartax-name + " (руб)"
     3782    tt-cnt-parts.sum-dsc-rubl-acc:label in browse b-supp-cnt   = "Сумма (руб)"
     3783    tt-cnt-parts.vat-rubl-acc:label in browse b-supp-cnt       = "НДС (руб)"
     3784    tt-cnt-parts.transport-rubl-acc:label in browse b-supp-cnt = "Транспортные расходы (руб)"
     3785    tt-cnt-parts.other-rubl-acc:label in browse b-supp-cnt     = "Прочие расходы (руб)"
     3786    tt-cnt-parts.slt-rubl-acc:label in browse b-supp-cnt       = "НП (руб)"
     3787    tt-cnt-parts.excise-rubl-acc:label in browse b-supp-cnt    = "Акциз (руб)"
     3788    bf_parts.price-rubl:label in browse b-parts                = "Цена (руб)"
     3789    .
     3790    assign frame
     3791      Dialog-Frame:TITLE = "Разбивка документа " + pardoc-code + " по договорам поставщиков".
     3792     run cntparts_calc-table-cnt in this-procedure (input pardoc-code) no-error.
     3793     if error-status:error then do:
     3794       message "Ошибка при обсчете документа." skip
     3795               return-value skip
     3796               error-status:get-message(1) skip
     3797               error-status:get-message(2)
     3798        view-as alert-box error.
     3799       return error.
     3800     end.
     3801       run enable_ui.
     3802     IF parfin-db THEN DO:
     3803       ENABLE b-fin-pob b-fin-ob b-fin-doc WITH FRAME Dialog-Frame.
     3804     END.
     3805     ELSE DO:
     3806       HIDE b-fin-pob b-fin-ob b-fin-doc IN FRAME Dialog-Frame.
     3807     END.
     3808     run open-query-parts in this-procedure.
     3809     wait-for go of frame Dialog-Frame.
     3810   end.
     3811   run disable_ui.
     3812   PROCEDURE disable_UI :
     3813     HIDE FRAME Dialog-Frame.
     3814   END PROCEDURE.
     3815   PROCEDURE enable_UI :
     3816     ENABLE b-exit b-help b-supp-cnt b-parts
     3817         WITH FRAME Dialog-Frame.
     3818     VIEW FRAME Dialog-Frame.
     3819     OPEN QUERY b-supp-cnt FOR EACH tt-cnt-parts.
     3820   END PROCEDURE.
     3821   PROCEDURE open-query-parts :
     3822   IF AVAILABLE tt-cnt-parts THEN DO:
     3823       OPEN QUERY b-parts FOR EACH bf_parts WHERE bf_parts.out-code      = pardoc-code          AND
     3824                                                  bf_parts.host-code     = tt-cnt-parts.host-code AND
     3825                                                  bf_parts.contract-code = tt-cnt-parts.contract-code USE-INDEX out-code NO-LOCK,
     3826       first bf_goods where bf_goods.artic = bf_parts.artic and
     3827                            bf_goods.prod-type = bf_parts.prod-type and
     3828                            bf_goods.prod-code = bf_parts.prod-code no-lock,
     3829       FIRST bf_fin-gds-part outer-join WHERE bf_fin-gds-part.obj-type = bf_trn-doc.obj-type AND
     3830                                              bf_fin-gds-part.obj-code = bf_trn-doc.obj-code AND
     3831                                              bf_fin-gds-part.out-code = bf_parts.out-code AND
     3832                                              bf_fin-gds-part.gds-code = bf_goods.gds-code AND
     3833                                              bf_fin-gds-part.in-code = bf_parts.in-code AND
     3834                                              bf_fin-gds-part.part-code = bf_parts.part-code NO-LOCK,
     3835       FIRST bf_fin-ob outer-join WHERE bf_fin-ob.doc-code = bf_fin-gds-part.fin-ob-code no-lock.
     3836       display b-parts with frame Dialog-Frame.
     3837   END.
     3838   END PROCEDURE.
