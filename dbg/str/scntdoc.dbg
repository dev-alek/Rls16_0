     2915         on error undo move_block, retry move_block
     2916         :
     2917           assign
     2918             v-object-handle = buf_temp-diasize-handle.handle-value
     2919           .
     2920           if v-object-handle <> v-diasize-resize-button
     2921           then do:
     2922             assign
     2923               v-object-handle :row = v-object-handle :row + p-change-value
     2924               no-error .
     2925             if error-status :error
     2926             or error-status :get-message(1) <> ""
     2927             then do:
     2928               undo move_block, retry move_block .
     2929             end.
     2930           end.
     2931         end.
     2932         assign
     2933           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2934           no-error .
     2935         if error-status :error
     2936         or error-status :get-message(1) <> ""
     2937         then do:
     2938           undo move_block, retry move_block .
     2939         end.
     2940         for each buf_temp-browse-handle
     2941           where buf_temp-browse-handle.browse-type = 'height':u
