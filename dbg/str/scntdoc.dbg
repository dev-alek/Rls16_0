     3217               create buf_temp-diasize-handle .
     3218               assign
     3219                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3220                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3221               .
     3222             end.
     3223           end.
     3224           assign
     3225             v-object-handle = v-object-handle :next-sibling
     3226           .
     3227         end.
