      511       define variable road-tax-rubl-lococur          like ub.doc-line.road-tax   no-undo.
      512       define variable road-tax-cli-lococur           like ub.doc-line.road-tax   no-undo.
      513       define variable transport-base-lococur         like ub.doc-line.price-base no-undo.
      514       define variable transport-rubl-lococur         like ub.doc-line.price-rubl no-undo.
      515       define variable transport-cli-lococur          like ub.doc-line.price-rubl no-undo.
