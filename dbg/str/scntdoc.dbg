     1990   procedure clcprtsl_calc-ttable :
     1991   define input parameter paris-doc           as   logical                 no-undo.
     1992   define input parameter paris-cur           as   logical                 no-undo.
     1993   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     1994   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     1995   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     1996   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     1997   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     1998   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     1999   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     2000   define input parameter parr-b              as   character               no-undo.
     2001   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     2002   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     2003   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     2004   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     2005   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     2006   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     2007   define buffer bf_tt-allsum      for tt-allsum.
     2008   define buffer bf_tt-clcparts    for tt-clcparts.
     2009   define buffer bf_tt-allsum-line for tt-allsum-line.
     2010   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2011   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2012   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2013   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2014   define variable varexcise          like ub.price-list.excise     no-undo.
     2015   do on error undo, return error return-value :
     2016   for each bf_tt-allsum-line
     2017   on error undo, return error return-value
     2018    :
     2019     delete bf_tt-allsum-line.
     2020   end.
     2021   for each bf_tt-allsum
     2022   on error undo, return error return-value
     2023   :
     2024     delete bf_tt-allsum.
     2025   end.
     2026   for each bf_tt-clcparts
     2027   on error undo, return error return-value
     2028   :
     2029   if v-calcbypart then do:
     2030             assign
     2031             parcur-base =   bf_tt-clcparts.part-cur-base
     2032             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     2033             parcur-excise =   bf_tt-clcparts.part-cur-excise
     2034             .
     2035   end.
     2036      run clcprtsl_calc-parts in this-procedure (
     2037        input recid(bf_tt-clcparts),
     2038        input paris-doc,
     2039        input paris-cur,
     2040        input parroad-tax,
     2041        input parexcise,
     2042        input parvat-pc,
     2043        input parcons-vat-pc,
     2044        input parslt-pc,
     2045        input parbase-rate,
     2046        input parbase-scale,
     2047        input parr-b,
     2048        input parcur-base,
     2049        input parcur-road-tax,
     2050        input parcur-excise,
     2051        input parcur-vat-pc,
     2052        input parcurcons-vat-pc,
     2053        input parcurslt-pc
     2054        ) no-error.
     2055     if error-status:error then do:
     2056       message
