      522   do on error undo, return error return-value :
      523   find first cl_tt-clcparts where recid(cl_tt-clcparts) = parrec-parts no-lock.
      524   for each bf_tt-allsum on error undo, return error return-value :
      525     delete bf_tt-allsum.
      526   end.
      527   assign
      528     price-rubl-with-tax-loccl = cl_tt-clcparts.price-rubl
      529     price-base-with-tax-loccl = cl_tt-clcparts.price-base
      530   .
      531   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      532   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      533     (output varinvprbcl
      534     )  .
      535     if cl_tt-clcparts.out-code = 'free-zone':U     or
      536        cl_tt-clcparts.out-code = 'out-zone':U   or
      537        cl_tt-clcparts.doc-type = 'акт':U then do:
      538       assign
      539         in-vatp-have-vat-sltcl = yes.
      540     end.
      541     else do:
      542       find first in-vatp_doc-attrcl no-lock
      543         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
      544           and in-vatp_doc-attrcl.attr-code = 'envd':U
      545         no-error .
      546       if not available in-vatp_doc-attrcl then do:
      547         assign
      548           in-vatp-have-vat-sltcl = yes.
      549       end.
      550       else do:
      551            in-vatp-have-vat-sltcl = no.
      552       end.
      553     end.
      554     assign
      555      price-cli-with-tax-loccl = cl_tt-clcparts.price-cli
      556      cli-base-ratecl          = cl_tt-clcparts.cli-base-rate.
      557     ASSIGN   road-tax-base-loccl  = (if cl_tt-clcparts.road-tax-base  = ? then 0 else cl_tt-clcparts.road-tax-base)
      558              road-tax-rubl-loccl  = (if cl_tt-clcparts.road-tax-rubl  = ? then 0 else cl_tt-clcparts.road-tax-rubl).
      559     ASSIGN  transport-base-loccl = (if cl_tt-clcparts.transport-base = ? then 0 else cl_tt-clcparts.transport-base)
      560             transport-rubl-loccl = (if cl_tt-clcparts.transport-rubl = ? then 0 else cl_tt-clcparts.transport-rubl)
      561             other-base-loccl     = (if cl_tt-clcparts.other-base     = ? then 0 else cl_tt-clcparts.other-base)
      562             other-rubl-loccl     = (if cl_tt-clcparts.other-rubl     = ? then 0 else cl_tt-clcparts.other-rubl)
      563             vat-pc-loccl         = (if cl_tt-clcparts.vat-pc         = ? then 0 else cl_tt-clcparts.vat-pc)
      564             slt-pc-loccl         = (if cl_tt-clcparts.slt-pc         = ? then 0 else cl_tt-clcparts.slt-pc).
      565             ASSIGN   slt-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
      566       ASSIGN   slt-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
      567     assign
      568       exch-rate-cli-loccl = (cl_tt-clcparts.price-rubl - transport-rubl-loccl - other-rubl-loccl - road-tax-rubl-loccl - (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-rubl-loccl else 0) - (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-rubl-loccl else 0)) / cl_tt-clcparts.price-cli .
      569     assign
      570       slt-cli-loccl        = slt-rubl-loccl       / exch-rate-cli-loccl
      571       vat-cli-loccl        = vat-rubl-loccl       / exch-rate-cli-loccl
      572       road-tax-cli-loccl   = road-tax-rubl-loccl  / exch-rate-cli-loccl
      573       transport-cli-loccl  = 0
      574       other-cli-loccl      = 0
      575     .
      576   ASSIGN
      577             price-base-without-tax-loccl = price-base-with-tax-loccl - vat-base-loccl - slt-base-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))
      578       price-rubl-without-tax-loccl = price-rubl-with-tax-loccl - vat-rubl-loccl - slt-rubl-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))
      579   .
      580   if paris-doc then do:
      581     assign
      582       parartic     = cl_tt-clcparts.artic
      583       parprod-type = cl_tt-clcparts.prod-type
      584       parprod-code = cl_tt-clcparts.prod-code
      585       pardoc-type  = cl_tt-clcparts.doc-type
      586       pardoc-code  = cl_tt-clcparts.out-code
      587       parobj-type  = cl_tt-clcparts.obj-type
      588       parobj-code  = cl_tt-clcparts.obj-code.
      589   if parext-doc-type = 'ot':U or
      590      parext-doc-type = ?                 then do:
      591     assign
      592      out-vatp-have-vat-sltcl = yes.
      593   end.
      594   else do:
      595     find first out-vatp_doc-attrcl no-lock
      596       where out-vatp_doc-attrcl.doc-code  = pardoc-code
      597         and out-vatp_doc-attrcl.attr-code = 'envd':U
      598         no-error .
      599     if not available out-vatp_doc-attrcl then do:
      600       assign
      601         out-vatp-have-vat-sltcl = yes.
      602     end.
      603     else do:
      604        out-vatp-have-vat-sltcl = no.
      605     end.
      606   end.
      607   find first out-vatp_goodscl where out-vatp_goodscl.artic     = parartic     and
      608                                      out-vatp_goodscl.prod-type = parprod-type and
      609                                      out-vatp_goodscl.prod-code = parprod-code no-lock.
      610   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      611   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
      612     (input  parartic
      613     ,input  parprod-type
      614     ,input  parprod-code
      615     ,output varroot-nodecl
      616     ) no-error .
      617   if error-status :error then do:
      618     message
      619       vss-workfile vss-revision vss-description skip
      620       "Ошибка при определении корневого признака товара" skip
      621       "Артикул" parartic parprod-type parprod-code skip
      622       error-status :get-message(1) skip
      623       return-value skip
      624       view-as alert-box error .
      625     undo, return error .
      626   end.
      627   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
      628     (input  varroot-nodecl
      629     ,input  'empty-scale=request'
      630     ,output varempty-scalecl
      631     ) no-error .
      632   if error-status :error then do:
      633     message
      634       vss-workfile vss-revision vss-description skip
      635       "Ошибка при определении атрибута признака" skip
      636       "Артикул" parartic parprod-type parprod-code skip
      637       "Признак" varroot-nodecl skip
      638       "Запрашивался атрибут" "empty-scale=request" skip
      639       error-status :get-message(1) skip
      640       return-value skip
      641       view-as alert-box error .
      642     undo, return error .
      643   end.
      644   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      645   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      646     (output varoutvprbcl
      647     )  .
      648   if varoutvprbcl = "base":u then do:
      649     assign
      650           road-tax-base-salecl    =  (if parroad-tax = ? then 0 else parroad-tax * 1)
      651       excise-base-salecl      =  (if parexcise   = ? then 0 else parexcise   * 1)
      652     .
      653   end.
      654   else do:
      655     assign
