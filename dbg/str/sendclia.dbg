      410   define variable p-db-num like ub.db.db-num no-undo .
      411   define variable p-optimize as character no-undo .
      412   define variable p-batch as logical no-undo .
      413   define variable p-action as character no-undo .
      414   define variable lns-cnt as integer no-undo .
      415   define variable line-rec as recid no-undo .
      416   define variable v-view-log as logical no-undo .
      417   define variable log-file-name as character no-undo init "send-cd.txt":U.
      418   define variable v-stop as logical no-undo .
      419   define variable var-type     as character no-undo .
      420   define variable v-optimize-object like ub.clients.obj-code no-undo .
      421   define buffer buf_clients for ub.clients.
      422   define buffer buf_shop for ub.shop.
      423   define buffer buf_cash-desk for ub.cash-desk.
      424   assign
      425   p-db-num = integer(entry(1, p-parameter, chr(4)))
      426   p-optimize = entry(2, p-parameter, chr(4))
      427   p-batch = (if entry(3, p-parameter, chr(4)) = "yes":U
      428                    then yes
      429                    else (if entry(3, p-parameter, chr(4)) = "no":U
      430                          then no
      431                          else ?)
      432                    )
      433   p-action = entry(4, p-parameter, chr(4))
      434   no-error
      435   .
      436   if error-status:error then return error substitute("Неверные параметры: &1", p-parameter).
      437   if p-optimize = "":U then do:
      438     _each1:
      439     FOR EACH buf_clients no-lock where
      440             buf_clients.obj-type = 'маг':U
      441         and buf_clients.db-num = p-db-num:
      442       run get-stop-state in p-log-handle (output v-stop).
      443       if v-stop then do:
      444         run write-log-and-file in p-log-handle (
      445               input 1
      446             , input log-file-name
      447             , input 1
      448             , input substitute("!!!Процедура пересылки остановлена пользователем"
      449                                 )
      450                                   ).
      451         leave _each1.
      452       end.
      453       run str/send-cli.p (
      454                     input parparentproc
      455                     ,input p-parent-handle
      456                     ,input p-log-handle
      457                     ,input (string(buf_clients.obj-code) + chr(4) + p-action + chr(4) + "no":U +
      458                             chr(4) + "yes":U)
      459                       ) no-error .
      460       if error-status:error then do:
      461         run write-log-and-file in p-log-handle (
      462               input 1
      463             , input log-file-name
      464             , input 1
      465             , input substitute("!!!Ошибки при пересылке на маг&1&2&3 &4"
      466                                , buf_clients.obj-code
      467                                , chr(10)
      468                                , error-status:get-message(1)
      469                                , return-value
      470                                 )
      471                                   ).
      472         assign
      473         v-view-log = yes
      474         .
      475       end.
      476     END.
      477   end.
      478   else do:
      479     if p-optimize begins "shop=":U then do:
      480       assign
      481       v-optimize-object = integer(replace(p-optimize, "shop=", "":U))
      482       .
      483     end.
      484     _each2:
      485     FOR EACH buf_clients no-lock where
      486             buf_clients.obj-type = 'маг':U
      487         and buf_clients.db-num = p-db-num
      488         and (v-optimize-object = 0 or buf_clients.obj-code = v-optimize-object)
      489         ,
      490         FIRST buf_cash-desk where
      491               buf_cash-desk.obj-code = buf_clients.obj-code:
      492       for each dcp-list no-lock where
      493             dcp-list.obj-type = 'маг':U
      494           AND dcp-list.obj-code = buf_clients.obj-code:
      495         find first dc-list where
      496                     dc-list.d-card = dcp-list.d-card no-error .
      497         if avail dc-list
      498         and dc-list.order-num > dcp-list.order-num then NEXT.
      499         if not avail dc-list then do:
      500           find first ub.dis-card no-lock where
      501                       ub.dis-card.d-card = dcp-list.d-card no-error .
      502   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      503   find dc-list
      504     where dc-list.d-card = dis-card.d-card
      505     no-error .
      506   if available dc-list then do:
      507     assign
      508       dc-list.to-del = no
      509     .
      510   end.
      511   else do:
      512     create dc-list .
      513     buffer-copy dis-card to dc-list
      514     assign
      515       dc-list.to-del = no
      516     .
      517     assign
      518       lns-cnt = lns-cnt + 1
      519       line-rec = recid (dc-list)
      520     .
      521   end.
      522         end.
      523         if avail dc-list then
      524         assign
      525         dc-list.order-num = dcp-list.order-num
      526         dc-list.flog =  yes
      527         .
      528         run get-stop-state in p-log-handle (output v-stop).
      529         if v-stop then do:
      530           run write-log-and-file in p-log-handle (
      531                 input 1
      532               , input log-file-name
      533               , input 1
      534               , input substitute("!!!Процедура пересылки остановлена пользователем"
      535                                   )
      536                                     ).
      537           leave _each2.
      538         end.
      539       end.
      540       if can-find (first dcp-list no-lock where dcp-list.obj-type = 'маг':U and dcp-list.obj-code = buf_clients.obj-code)
      541       or can-find(first dc-list)
      542       then  do:
      543         run str/send-cli.p (
      544                       input parparentproc
      545                       ,input p-parent-handle
      546                       ,input p-log-handle
      547                       ,input (string(buf_clients.obj-code) + chr(4) + p-action + chr(4) + "no":U +
      548                               chr(4) + (if p-action = "E":U then "no" else "yes")
      549                                 )
      550                         ) no-error  .
      551         if error-status:error then do:
      552           assign
      553           v-view-log = yes
      554           .
      555         end.
      556       end.
      557     END.
      558   end.
      559   if p-batch then do:
      560     if v-view-log then
      561     run set-view-log in p-log-handle(yes).
      562   end.
      563   else do:
      564   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      565   if v-view-log
      566   and not g#news
      567   and not g#auto
      568   then do:
      569     message
      570     '!!!При отсылке информации на кассы произошли ошибки!!!'  skip
      571     "!!!Внимательно прочитайте Log-file!!"
      572     view-as alert-box error .
      573        define variable v-user-action6   as character no-undo .
      574     define variable v-printed6       as logical   no-undo .
      575     run gbl/prnfilen.w
      576       (input  ('!!!При отсылке информации на кассы произошли ошибки!!!')
      577       ,input  0
      578       ,input  (string("./":U) + 'send-cd.txt')
      579       ,input  7
      580       ,output v-user-action6
      581       ,output v-printed6
      582       ) .
      583   end.
      584   if v-view-log = true
      585   and (g#news
      586   or g#auto)
      587   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
      588   then do:
      589      run cb_set-view-log in p-parent-handle ( input yes).
      590   end.
      591   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
      592     OS-DELETE value(string("./":U) + 'send-cd.txt').
      593   end.
      594   end.
