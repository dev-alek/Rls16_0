        1   block-level on error undo, throw.
        2   define input parameter p-rvs-code as character        no-undo.
        3   define input parameter p-obj-type as character        no-undo.
        4   define input parameter p-obj-code as integer          no-undo.
        5   define output parameter p-ok      as logical          no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision: 43fd28ac5b03, 3518, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: BelovaMM $":U .
        8   define variable vss-date        as character no-undo init "$Date: 2023/10/25 15:17:32 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: rvs-attr.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: str/rvs-attr.p $":U .
       11   define variable vss-description as character no-undo init "Оборот по по чекам".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   procedure cur-time :
       74      define output parameter p-today as date      no-undo .
       75      define output parameter p-time  as integer   no-undo .
       76     do
       77     on error undo, return error
       78     :
       79       define variable v-date1 as date      no-undo .
       80       define variable v-date2 as date      no-undo .
       81       define variable v-time  as integer   no-undo .
       82       assign
       83         v-date1 = today
       84         v-time  = time
       85         v-date2 = today
       86       .
       87       if v-date1 <> v-date2
       88       then do:
       89         assign
       90           v-date1 = today
       91           v-time  = v-time
       92         .
       93       end.
       94       assign
       95         p-today = v-date1
       96         p-time  = v-time
       97       .
       98     end.
       99   end.
      100   function cur-time-date returns character
      101   :
      102     return string(today, '99/99/9999':U) .
      103   end.
      104   function cur-time-mjd returns decimal
      105   :
      106     define variable v-date as date      no-undo .
      107     define variable v-time as integer   no-undo .
      108     run cur-time in this-procedure
      109       (output v-date
      110       ,output v-time
      111       ) .
      112     return integer(v-date) - 2400002 + (v-time / 86400) .
      113   end.
      114   function cur-time-get-ending-index returns integer
      115   (input p-number as integer
      116   )
      117   :
      118     if p-number < 0
      119     or p-number = ?
      120     then do:
      121       return 1 .
      122     end.
      123     define variable v-rest as integer   no-undo .
      124     assign
      125       p-number = p-number modulo 100
      126     .
      127     if p-number < 20
      128     then do:
      129       assign
      130         v-rest = p-number
      131       .
      132     end.
      133     else do:
      134       assign
      135         v-rest = p-number modulo 10
      136       .
      137     end.
      138     case v-rest :
      139       when 1
      140       then do:
      141         return 2 .
      142       end.
      143       when 2 or
      144       when 3 or
      145       when 4
      146       then do:
      147         return 3 .
      148       end.
      149       otherwise do:
      150         return 1 .
      151       end.
      152     end case .
      153   end.
      154   procedure cur-time-mjd-to-date :
      155      define input  parameter i-mjd-diff as decimal no-undo.
      156      define output parameter o-Date     as date    no-undo.
      157      define output parameter o-Time     as integer no-undo.
      158      define variable v-day-number as integer   no-undo .
      159      if    i-mjd-diff < 0
      160         or i-mjd-diff = ?
      161      then do:
      162         return "?" .
      163      end.
      164      assign
      165         v-day-number = truncate(i-mjd-diff,0).
      166         o-Date = date(v-day-number + 2400002).
      167         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      168     .
      169   end.
      170   function cur-time-mjd-to-string returns character
      171   (input p-mjd-diff as decimal
      172   )
      173   :
      174     define variable v-day-number as integer   no-undo .
      175     define variable v-seconds    as integer   no-undo .
      176     define variable v-hour       as integer   no-undo .
      177     define variable v-min        as integer   no-undo .
      178     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      179     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      180     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      181     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      182     if p-mjd-diff < 0
      183     or p-mjd-diff = ?
      184     then do:
      185       return "?" .
      186     end.
      187     assign
      188       v-day-number = integer(truncate(p-mjd-diff,0))
      189       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      190     .
      191     if v-seconds > 86400
      192     then do:
      193       assign
      194         v-seconds = 86400 - 1
      195       .
      196     end.
      197     if v-seconds < 0
      198     then do:
      199       assign
      200         v-seconds = 0
      201       .
      202     end.
      203     assign
      204       v-hour = truncate(v-seconds / 3600, 0)
      205     .
      206     assign
      207       v-seconds = v-seconds modulo 3600
      208     .
      209     assign
      210       v-min = truncate(v-seconds / 60, 0)
      211     .
      212     assign
      213       v-seconds = v-seconds modulo 60
      214     .
      215     return
      216         (if v-day-number <> 0
      217           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      218           else ""
      219         )
      220       + (if v-day-number <> 0 or v-hour <> 0
      221           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      222           else ""
      223         )
      224       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      225           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      226           else ""
      227         )
      228       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      229       .
      230   end.
      231   function cur-time-string returns character
      232   :
      233     define variable v-date as date      no-undo .
      234     define variable v-time as integer   no-undo .
      235     run cur-time in this-procedure
      236       (output v-date
      237       ,output v-time
      238       ) .
      239     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      240   end.
      241   function cur-time-string-sec returns character
      242   :
      243     define variable v-date as date      no-undo .
      244     define variable v-time as integer   no-undo .
      245     run cur-time in this-procedure
      246       (output v-date
      247       ,output v-time
      248       ) .
      249     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      250   end.
      251   function cur-time-custom  returns character
      252   (input p-prefix as character
      253   ,input p-date-format as character
      254   ,input p-delimiter as character
      255   ,input p-time-format as character
      256   ,input p-suffix as character
      257   )
      258   :
      259     define variable v-date as date      no-undo .
      260     define variable v-time as integer   no-undo .
      261     run cur-time in this-procedure
      262       (output v-date
      263       ,output v-time
      264       ) .
      265     return
      266       p-prefix
      267       + string(v-date, p-date-format)
      268       + p-delimiter
      269       + string(v-time, p-time-format)
      270       + p-suffix
      271       .
      272   end.
      273   function cur-time-print  returns character
      274   :
      275     define variable v-date as date      no-undo .
      276     define variable v-time as integer   no-undo .
      277     run cur-time in this-procedure
      278       (output v-date
      279       ,output v-time
      280       ) .
      281     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      282   end.
      283   function cur-time-datetime returns datetime
      284   :
      285     define variable v-char as character no-undo .
      286     define variable v-datetime as datetime no-undo .
      287     v-char = cur-time-string().
      288     v-datetime = datetime(v-char).
      289     return  v-datetime.
      290   end.
      291   function cur-time-string-msec returns character
      292   :
      293     define variable v-date as datetime  no-undo .
      294     v-date = now.
      295     return string(v-date) .
      296   end.
      297   procedure placelib_write-attr:
      298   define input  parameter p-code     like ub.place-attr.attr-code .
      299   define input  parameter p-obj-code like ub.place-attr.obj-code .
      300   define input  parameter p-obj-type like ub.place-attr.obj-type .
      301   define input  parameter p-pl-code  like ub.place-attr.pl-code .
      302   define input  parameter p-value    like ub.place-attr.attr-value .
      303   define output parameter p-ok       as logical.
      304   define buffer buf_place-attr for ub.place-attr .
      305     do on error undo, return error return-value :
      306        p-ok = false.
      307        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      308                                                   and buf_place-attr.obj-code    = p-obj-code
      309                                                   and buf_place-attr.obj-type    = p-obj-type
      310                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      311        if not available buf_place-attr then do :
      312           create buf_place-attr.
      313           assign
      314             buf_place-attr.attr-code   = p-code
      315             buf_place-attr.attr-value  = p-value
      316             buf_place-attr.obj-code    = p-obj-code
      317             buf_place-attr.obj-type    = p-obj-type
      318             buf_place-attr.pl-code     = p-pl-code
      319           .
      320           p-ok = true.
      321        end.
      322        else do:
      323           buf_place-attr.attr-value  = p-value .
      324           p-ok = true.
      325        end.
      326     end.
      327   end.
      328   procedure placelib_get-attr:
      329   define input  parameter  p-code     like ub.place-attr.attr-code .
      330   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      331   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      332   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      333   define output parameter  p-value    like ub.place-attr.attr-value .
      334   define output parameter  p-ok       as logical.
      335   define buffer buf_place-attr for ub.place-attr .
      336     do on error undo, return error return-value :
      337        p-ok = false.
      338        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      339                                                   and buf_place-attr.obj-code    = p-obj-code
      340                                                   and buf_place-attr.obj-type    = p-obj-type
      341                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      342        if available buf_place-attr then do :
      343          p-value = buf_place-attr.attr-value.
      344          p-ok = true.
      345        end.
      346        else do :
      347          p-ok = false.
      348        end.
      349     end.
      350   end.
      351   procedure placelib_del-attr:
      352   define input parameter  p-code     like ub.place-attr.attr-code .
      353   define input parameter  p-obj-code like ub.place-attr.obj-code .
      354   define input parameter  p-obj-type like ub.place-attr.obj-type .
      355   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      356   define input parameter  p-value    like ub.place-attr.attr-value .
      357   define output parameter p-ok       as logical.
      358   define buffer buf_place-attr for ub.place-attr .
      359     do on error undo, return error return-value :
      360        p-ok = false.
      361        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      362                                                   and buf_place-attr.obj-code    = p-obj-code
      363                                                   and buf_place-attr.obj-type    = p-obj-type
      364                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      365        if available buf_place-attr then do :
      366           delete buf_place-attr.
      367           p-ok = true.
      368        end.
      369     end.
      370   end.
      371   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      372   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      373   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      374   define variable ptrlprop-denstclc      as character no-undo initial 'shft_rvs-inc':U .
      375   define variable ptrlprop-inpptrl       as character no-undo initial 'weight':U .
      376   define variable ptrlprop-expptrl       as character no-undo initial 'volume':U .
      377   define variable ptrlprop-autopump      as logical   no-undo initial false .
      378   define variable ptrlprop-avtinvpm      as logical   no-undo initial false .
      379   define variable ptrlprop-rvsnmter      as logical   no-undo initial false .
      380   define variable ptrlprop-olddens       as logical   no-undo initial false .
      381   define variable ptrlprop-invclipt      as integer   no-undo initial ? .
      382   define variable ptrlprop-algrvspt      as integer   no-undo initial 1 .
      383   define variable ptrlprop-temp-for-pomi as integer   no-undo initial 1 .
      384   define variable ptrlprop-algoincome as integer no-undo init 0.
      385   define variable ptrlprop-mand-choice-autocar as logical no-undo init false.
      386   define variable ptrlprop-Delta-mass-horiz      as character no-undo .
      387   define variable ptrlprop-Delta-mass-vert       as character no-undo .
      388   define variable ptrlprop-calc-free-vol as logical no-undo init false.
      389   define variable ptrlprop-calc-free-vol-sug as logical no-undo init false.
      390   define variable ptrlprop-trn-reas-sug as logical no-undo init true.
      391   define variable ptrlprop-rvd-own-nb as logical no-undo init false.
      392   define variable ptrlprop-qr-scan-time as integer no-undo init 5000 .
      393   define variable ptrlprop-block-nozzle as logical no-undo init false.
      394   define variable ptrlprop-timeout-block-nozzle as integer no-undo init 5 .
      395   define variable ptrlprop-autopump-skip-time as integer no-undo init 0 .
      396   procedure get-ptrl-prop :
      397     define input  parameter p-obj-type as character no-undo .
      398     define input  parameter p-obj-code as integer   no-undo .
      399     do
      400     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      401     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
      402     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
      403     :
      404       define variable par-type          as character no-undo.
      405       define variable v-value-character as character no-undo .
      406       define variable v-value-date      as date      no-undo .
      407       define variable v-value-decimal   as decimal   no-undo .
      408       define variable v-value-integer   as integer   no-undo .
      409       define variable v-value-logical   as logical   no-undo .
      410       for each thbjattr_thbj-attr
      411       :
      412         delete thbjattr_thbj-attr .
      413       end.
      414       run adm/shattri.p
      415         ( input "get":U
      416         , input p-obj-type
      417         , input p-obj-code
      418         , input 'petrol':U
      419         , input  ""
      420         , output v-value-character
      421         , output v-value-date
      422         , output v-value-decimal
      423         , output v-value-integer
      424         , output v-value-logical
      425         , output par-type
      426         , input-output table thbjattr_thbj-attr
      427         ) no-error .
      428       for each thbjattr_thbj-attr
      429       on error undo, return error return-value
      430       :
      431         case thbjattr_thbj-attr.prop-code :
      432           when 'denstclc':U then do:
      433             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      434               assign
      435                 ptrlprop-denstclc = thbjattr_thbj-attr.property-value-character
      436               .
      437             end.
      438           end.
      439           when 'expptrl':U then do:
      440             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      441               and thbjattr_thbj-attr.prop-value-type = 'character':U
      442             then do:
      443               assign
      444                 ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
      445               .
      446             end.
      447           end.
      448           when 'inpptrl':U then do:
      449             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      450               and thbjattr_thbj-attr.prop-value-type = 'character':U
      451             then do:
      452               assign
      453                 ptrlprop-inpptrl = thbjattr_thbj-attr.property-value-character
      454               .
      455             end.
      456           end.
      457           when 'autopump':U then do:
      458             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      459               assign
      460                 ptrlprop-autopump = thbjattr_thbj-attr.property-value-logical
      461               .
      462             end.
      463           end.
      464           when 'rvsnmter':U then do:
      465             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      466               assign
      467                 ptrlprop-rvsnmter = thbjattr_thbj-attr.property-value-logical
      468               .
      469             end.
      470           end.
      471           when 'avtinvpm':U then do:
      472             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      473               assign
      474                 ptrlprop-avtinvpm = thbjattr_thbj-attr.property-value-logical
      475               .
      476             end.
      477           end.
      478           when 'invclipt':U then do:
      479             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      480               assign
      481                 ptrlprop-invclipt = thbjattr_thbj-attr.property-value-integer
      482               .
      483             end.
      484           end.
      485           when 'olddens':U then do:
      486             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      487               assign
      488                 ptrlprop-olddens = thbjattr_thbj-attr.property-value-logical
      489               .
      490             end.
      491           end.
      492           when 'algrvspt':U then do:
      493             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      494               assign
      495                 ptrlprop-algrvspt = thbjattr_thbj-attr.property-value-integer
      496               .
      497             end.
      498           end.
      499           when 'temp-for-pomi':U then do:
      500             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      501               assign
      502                 ptrlprop-temp-for-pomi = thbjattr_thbj-attr.property-value-integer
      503               .
      504             end.
      505           end.
      506           when 'algoincome':U then do:
      507             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      508               assign
      509                 ptrlprop-algoincome = thbjattr_thbj-attr.property-value-integer
      510               .
      511             end.
      512           end.
      513           when 'mand-choice-autocar':U then do:
      514             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      515               assign
      516                 ptrlprop-mand-choice-autocar = thbjattr_thbj-attr.property-value-logical
      517               .
      518             end.
      519           end.
      520           when 'block-nozzle':U then do:
      521             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      522               assign
      523                 ptrlprop-block-nozzle = thbjattr_thbj-attr.property-value-logical
      524               .
      525             end.
      526           end.
      527           when 'timeout-block-nozzle':U then do:
      528             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      529               assign
      530                 ptrlprop-timeout-block-nozzle = thbjattr_thbj-attr.property-value-integer
      531               .
      532             end.
      533           end.
      534           when 'Delta-mass-horiz':U then do:
      535             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      536               assign
      537                 ptrlprop-Delta-mass-horiz = thbjattr_thbj-attr.property-value-character
      538               .
      539             end.
      540           end.
      541           when 'Delta-mass-vert':U then do:
      542             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      543               assign
      544                 ptrlprop-Delta-mass-vert = thbjattr_thbj-attr.property-value-character
      545               .
      546             end.
      547           end.
      548           when 'calc-free-vol':U then do:
      549             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      550               assign
      551                 ptrlprop-calc-free-vol = thbjattr_thbj-attr.property-value-logical
      552               .
      553             end.
      554           end.
      555           when 'calc-free-vol-sug':U then do:
      556             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      557               assign
      558                 ptrlprop-calc-free-vol-sug = thbjattr_thbj-attr.property-value-logical
      559               .
      560             end.
      561           end.
      562           when 'trn-reas-sug':U then do:
      563             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      564               assign
      565                 ptrlprop-trn-reas-sug = thbjattr_thbj-attr.property-value-logical
      566               .
      567             end.
      568           end.
      569                 when 'rvd-own-nb':U then do:
      570             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      571               assign
      572                 ptrlprop-rvd-own-nb = thbjattr_thbj-attr.property-value-logical
      573               .
      574             end.
      575           end.
      576           when 'qr-scan-time':U then do:
      577             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      578               assign
      579                 ptrlprop-qr-scan-time = thbjattr_thbj-attr.property-value-integer
      580               .
      581             end.
      582           end.
      583           when 'autopump-skip-time':U then do:
      584             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      585               assign
      586                 ptrlprop-autopump-skip-time = thbjattr_thbj-attr.property-value-integer
      587               .
      588             end.
      589           end.
      590         end case.
      591         delete thbjattr_thbj-attr .
      592       end.
      593     end.
      594     return .
      595   end procedure.
      596   define temp-table tt-doc-line-attr no-undo
      597     field gds-code    like ub.goods.gds-code
      598     field pl-code     like ub.place.pl-code
      599     field artic       like ub.goods.artic
      600     field prod-type   like ub.goods.prod-type
      601     field prod-code   like ub.goods.prod-code
      602     field attr-value  as decimal
      603     field rest        as decimal initial 0.0
      604     field oo          as decimal initial 0.0
      605     index pi is primary unique gds-code pl-code
      606   .
      607   define TEMP-TABLE tt-rvs-line-attr no-undo
      608     field rvs-code    like ub.rvs-line-attr.rvs-code
      609     field obj-type    like ub.rvs-line-attr.obj-type
      610     field obj-code    like ub.rvs-line-attr.obj-code
      611     field pl-code     like ub.rvs-line-attr.pl-code
      612     field gds-code    like ub.rvs-line-attr.gds-code
      613     field attr-code   like ub.rvs-line-attr.attr-code
      614     field attr-value  as decimal
      615     field attr-value_s  as character
      616   index pi is primary unique gds-code pl-code obj-type obj-code attr-code
      617   .
      618   define buffer buf_tt-doc-line-attr  for tt-doc-line-attr .
      619   define buffer buf_tt-rvs-line-attr  for tt-rvs-line-attr .
      620   define buffer buf_place             for ub.place .
      621   define buffer buf_pl-gds            for ub.pl-gds .
      622   define buffer buf_inkas             for ub.inkas .
      623   define buffer buf_doc-pl            for ub.doc-pl .
      624   define buffer buf_trn-doc           for ub.trn-doc .
      625   define buffer buf_goods             for ub.goods .
      626   define buffer buf_doc-line          for ub.doc-line .
      627   define buffer buf_doc-line-attr     for ub.doc-line-attr .
      628   define buffer buf_doc-line-attr1    for ub.doc-line-attr.
      629   define buffer curr_shift-obj        for ub.shift-obj .
      630   define buffer prev_shift-obj        for ub.shift-obj .
      631   define buffer buf_rvs-doc           for ub.rvs-doc .
      632   define buffer buf_rvs-line          for ub.rvs-line .
      633   define buffer buf_rvs-line-attr     for ub.rvs-line-attr .
      634   define buffer buf_chk-doc           for ub.chk-doc .
      635   define buffer buf_chk-gds           for ub.chk-gds .
      636   define buffer buf_bar-code          for ub.bar-code .
      637   define buffer buf_pl-pump-nozzle    for ub.pl-pump-nozzle .
      638   define buffer buf_place-attr        for ub.place-attr.
      639   define buffer buf_doc-attr          for ub.doc-attr.
      640   define variable v-sign              as decimal   no-undo .
      641   define variable v-pl-code           as integer   no-undo .
      642   define variable vRvdDnstOn          as log no-undo.
      643   define variable vRvdTmpOn           as log no-undo.
      644   define variable vRvdLvlOn           as log no-undo.
      645   define variable vSkipAuto           as log no-undo.
      646   do
      647   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      648   :
      649     find first curr_shift-obj no-lock
      650       where curr_shift-obj.obj-type = p-obj-type
      651         and curr_shift-obj.obj-code = p-obj-code
      652         and curr_shift-obj.status_  = 'тек':U
      653       no-error .
      654     if not available curr_shift-obj then do:
      655       undo, return error substitute( "&1. Не найдена текущая смена.", vss-workfile ).
      656     end.
      657     for each buf_place no-lock
      658       where buf_place.obj-type = p-obj-type
      659         and buf_place.obj-code = p-obj-code
      660       ,first buf_pl-gds no-lock
      661       where buf_pl-gds.obj-type = p-obj-type
      662         and buf_pl-gds.obj-code = p-obj-code
      663         and buf_pl-gds.pl-code  = buf_place.pl-code
      664     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      665     :
      666       find first buf_tt-doc-line-attr
      667         where buf_tt-doc-line-attr.gds-code = buf_pl-gds.gds-code
      668           and buf_tt-doc-line-attr.pl-code  = buf_pl-gds.pl-code
      669         no-error .
      670       if not available buf_tt-doc-line-attr then do:
      671         find first buf_goods no-lock
      672           where buf_goods.gds-code = buf_pl-gds.gds-code
      673           no-error.
      674         if available buf_goods then do:
      675           create buf_tt-doc-line-attr.
      676           assign
      677             buf_tt-doc-line-attr.gds-code    = buf_pl-gds.gds-code
      678             buf_tt-doc-line-attr.pl-code     = buf_pl-gds.pl-code
      679             buf_tt-doc-line-attr.artic       = buf_goods.artic
      680             buf_tt-doc-line-attr.prod-type   = buf_goods.prod-type
      681             buf_tt-doc-line-attr.prod-code   = buf_goods.prod-code
      682           .
      683         end.
      684       end.
      685       if can-find(first buf_doc-attr no-lock where
      686                        buf_doc-attr.doc-code = p-rvs-code
      687                    and buf_doc-attr.attr-code = "rvs-auto"
      688                    and buf_doc-attr.attr-value = "Yes")
      689       then do:
      690          assign
      691             vRvdDnstOn = no
      692             vRvdTmpOn = no
      693             vRvdLvlOn = no
      694             .
      695          if buf_place.is-meas  = no then do:
      696             assign
      697                vRvdDnstOn = yes
      698                vRvdTmpOn = yes
      699                vRvdLvlOn = yes
      700                .
      701          end.
      702          else do:
      703             find first buf_place-attr where
      704                       buf_place-attr.obj-type = p-obj-type
      705                   and buf_place-attr.obj-code = p-obj-code
      706                   and buf_place-attr.pl-code  = buf_place.pl-code
      707                   and buf_place-attr.attr-code = "place-rvd-dnsty"
      708                   and logical(buf_place-attr.attr-value) = yes
      709               no-lock no-error.
      710            if available buf_place-attr then vRvdDnstOn = yes.
      711            find first buf_place-attr where
      712                       buf_place-attr.obj-type = p-obj-type
      713                   and buf_place-attr.obj-code = p-obj-code
      714                   and buf_place-attr.pl-code  = buf_place.pl-code
      715                   and buf_place-attr.attr-code = "place-rvd-tmp"
      716                   and logical(buf_place-attr.attr-value) = yes
      717               no-lock no-error.
      718            if available buf_place-attr then vRvdTmpOn = yes.
      719            find first buf_place-attr where
      720                       buf_place-attr.obj-type = p-obj-type
      721                   and buf_place-attr.obj-code = p-obj-code
      722                   and buf_place-attr.pl-code  = buf_place.pl-code
      723                   and buf_place-attr.attr-code = "place-rvd-lvl"
      724                   and logical(buf_place-attr.attr-value) = yes
      725               no-lock no-error.
      726            if available buf_place-attr then vRvdLvlOn = yes.
      727          end.
      728          if vRvdDnstOn or
      729             vRvdTmpOn or
      730             vRvdLvlOn
      731          then do:
      732             find first buf_rvs-line no-lock
      733                where   buf_rvs-line.rvs-code = p-rvs-code
      734                    and buf_rvs-line.obj-type = p-obj-type
      735                    and buf_rvs-line.obj-code = p-obj-code
      736                    and buf_rvs-line.pl-code  = buf_pl-gds.pl-code
      737                    and buf_rvs-line.gds-code = buf_pl-gds.gds-code
      738                no-error .
      739             if available buf_rvs-line then do:
      740                  find first tt-rvs-line-attr EXCLUSIVE-LOCK
      741                       where tt-rvs-line-attr.attr-code = "rvd-on"
      742                         and tt-rvs-line-attr.gds-code = buf_rvs-line.gds-code
      743                         and tt-rvs-line-attr.obj-code = buf_rvs-line.obj-code
      744                         and tt-rvs-line-attr.obj-type = buf_rvs-line.obj-type
      745                         and tt-rvs-line-attr.pl-code  = buf_rvs-line.pl-code
      746                         and tt-rvs-line-attr.rvs-code = buf_rvs-line.rvs-code
      747                     no-error .
      748                 if not AVAILABLE tt-rvs-line-attr then do:
      749                    create tt-rvs-line-attr .
      750                    ASSIGN
      751                       tt-rvs-line-attr.attr-code = "rvd-on"
      752                       tt-rvs-line-attr.gds-code =  buf_rvs-line.gds-code
      753                       tt-rvs-line-attr.obj-code = buf_rvs-line.obj-code
      754                       tt-rvs-line-attr.obj-type = buf_rvs-line.obj-type
      755                       tt-rvs-line-attr.pl-code = buf_rvs-line.pl-code
      756                       tt-rvs-line-attr.rvs-code = buf_rvs-line.rvs-code
      757                       tt-rvs-line-attr.attr-value_s = ""
      758                    .
      759                 end.
      760                 else tt-rvs-line-attr.attr-value_s = "".
      761                 if vRvdDnstOn then tt-rvs-line-attr.attr-value_s = if tt-rvs-line-attr.attr-value_s = "" then "p"
      762                                                                  else tt-rvs-line-attr.attr-value_s + ",p".
      763                 if vRvdTmpOn then  tt-rvs-line-attr.attr-value_s = if tt-rvs-line-attr.attr-value_s = "" then "t"
      764                                                                  else tt-rvs-line-attr.attr-value_s + ",t".
      765                 if vRvdLvlOn then  tt-rvs-line-attr.attr-value_s = if tt-rvs-line-attr.attr-value_s = "" then "l"
      766                                                                  else tt-rvs-line-attr.attr-value_s + ",l".
      767             end.
      768          end.
      769       end.
      770     end.
      771     find last prev_shift-obj no-lock
      772       where prev_shift-obj.obj-type = p-obj-type
      773         and prev_shift-obj.obj-code = p-obj-code
      774         and ( ( prev_shift-obj.shift-date = curr_shift-obj.shift-date
      775                 and prev_shift-obj.shift-num < curr_shift-obj.shift-num
      776               )
      777               or prev_shift-obj.shift-date < curr_shift-obj.shift-date
      778             )
      779       use-index pi
      780       no-error .
      781     if available prev_shift-obj then do:
      782       find first buf_rvs-doc no-lock
      783         where buf_rvs-doc.obj-type   = p-obj-type
      784           and buf_rvs-doc.obj-code   = p-obj-code
      785           and buf_rvs-doc.shift-date = prev_shift-obj.shift-date
      786           and buf_rvs-doc.shift-num  = prev_shift-obj.shift-num
      787           and buf_rvs-doc.status_    = 'факт':U
      788           and buf_rvs-doc.rvs-type   = 'смена':U
      789         no-error .
      790       if available buf_rvs-doc then do:
      791         for each buf_rvs-line no-lock
      792           where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
      793           ,first buf_tt-doc-line-attr
      794           where buf_tt-doc-line-attr.gds-code = buf_rvs-line.gds-code
      795             and buf_tt-doc-line-attr.pl-code  = buf_rvs-line.pl-code
      796         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      797         :
      798           assign
      799             buf_tt-doc-line-attr.rest = buf_tt-doc-line-attr.rest + buf_rvs-line.state-measure-qnty
      800           .
      801         end.
      802       end.
      803     end.
      804   define variable v-today        as date         no-undo.
      805   define variable v-time         as integer      no-undo.
      806     run cur-time in this-procedure ( output v-today, output v-time).
      807   for each buf_chk-doc where buf_chk-doc.chk-date = v-today
      808                          and buf_chk-doc.obj-code = curr_shift-obj.obj-code
      809                          and buf_chk-doc.obj-type = curr_shift-obj.obj-type,
      810                          each buf_chk-gds where buf_chk-gds.doc-code = buf_chk-doc.doc-code,
      811                          first buf_bar-code where buf_bar-code.b-code = buf_chk-gds.b-code,
      812                          first tt-doc-line-attr where tt-doc-line-attr.gds-code = buf_bar-code.gds-code:
      813   if (buf_chk-doc.chk-type = INTEGER('1':U) OR  buf_chk-doc.chk-type = INTEGER('6':U)) then do:
      814     v-pl-code = 0 .
      815     if buf_chk-gds.pl-code = 0 or buf_chk-gds.pl-code = ? then do:
      816       find first buf_pl-pump-nozzle no-lock where buf_pl-pump-nozzle.status_ <> 'блок':U
      817                                     and buf_pl-pump-nozzle.nozzle-code = buf_chk-gds.nozzle-code
      818                                     and buf_pl-pump-nozzle.pump-code = buf_chk-gds.pump
      819                                     and buf_pl-pump-nozzle.obj-code = buf_chk-doc.obj-code
      820                                     and buf_pl-pump-nozzle.obj-type = buf_chk-doc.obj-type no-error .
      821     if AVAILABLE buf_pl-pump-nozzle then do:
      822     v-pl-code = buf_pl-pump-nozzle.pl-code .
      823     end.
      824   end.
      825      else v-pl-code = buf_chk-gds.pl-code .
      826      find first tt-rvs-line-attr EXCLUSIVE-LOCK where tt-rvs-line-attr.attr-code = "current-sale"
      827                                    and tt-rvs-line-attr.gds-code = tt-doc-line-attr.gds-code
      828                                    and tt-rvs-line-attr.obj-code = buf_chk-doc.obj-code
      829                                    and tt-rvs-line-attr.obj-type = buf_chk-doc.obj-type
      830                                    and tt-rvs-line-attr.pl-code = v-pl-code
      831                                    and tt-rvs-line-attr.rvs-code = p-rvs-code no-error .
      832     if not AVAILABLE tt-rvs-line-attr then do:
      833       create tt-rvs-line-attr .
      834       ASSIGN
      835       tt-rvs-line-attr.attr-code = "current-sale"
      836       tt-rvs-line-attr.gds-code = tt-doc-line-attr.gds-code
      837       tt-rvs-line-attr.obj-code = buf_chk-doc.obj-code
      838       tt-rvs-line-attr.obj-type = buf_chk-doc.obj-type
      839       tt-rvs-line-attr.pl-code = v-pl-code
      840       tt-rvs-line-attr.rvs-code = p-rvs-code
      841       .
      842     end.
      843       tt-rvs-line-attr.attr-value = tt-rvs-line-attr.attr-value + buf_chk-gds.doc-qnty .
      844   end.
      845   end.
      846   for each buf_trn-doc no-lock where buf_trn-doc.doc-date = v-today
      847                          and buf_trn-doc.obj-code = p-obj-code
      848                          and buf_trn-doc.obj-type = p-obj-type
      849                          and buf_trn-doc.doc-type = 'при':U,
      850         each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code,
      851         first buf_goods no-lock where buf_goods.artic = buf_doc-line.artic
      852                           and buf_goods.prod-code = buf_doc-line.prod-code
      853                           and buf_goods.prod-type = buf_doc-line.prod-type,
      854                           each tt-doc-line-attr no-lock where tt-doc-line-attr.gds-code = buf_goods.gds-code,
      855                           each buf_doc-pl no-lock
      856                           where buf_doc-pl.out-code = buf_trn-doc.doc-code
      857                             and buf_doc-pl.gds-code = tt-doc-line-attr.gds-code
      858                             and buf_doc-pl.pl-code  = tt-doc-line-attr.pl-code
      859                            :
      860      find first tt-rvs-line-attr EXCLUSIVE-LOCK where tt-rvs-line-attr.attr-code = "income"
      861                                    and tt-rvs-line-attr.gds-code = tt-doc-line-attr.gds-code
      862                                    and tt-rvs-line-attr.obj-code = p-obj-code
      863                                    and tt-rvs-line-attr.obj-type = p-obj-type
      864                                    and tt-rvs-line-attr.pl-code = tt-doc-line-attr.pl-code
      865                                    and tt-rvs-line-attr.rvs-code = p-rvs-code no-error .
      866     if not AVAILABLE tt-rvs-line-attr then do:
      867       create tt-rvs-line-attr .
      868       ASSIGN
      869       tt-rvs-line-attr.attr-code = "income"
      870       tt-rvs-line-attr.gds-code = tt-doc-line-attr.gds-code
      871       tt-rvs-line-attr.obj-code = p-obj-code
      872       tt-rvs-line-attr.obj-type = p-obj-type
      873       tt-rvs-line-attr.pl-code = tt-doc-line-attr.pl-code
      874       tt-rvs-line-attr.rvs-code = p-rvs-code
      875       .
      876     end.
      877       tt-rvs-line-attr.attr-value = tt-rvs-line-attr.attr-value + buf_doc-pl.fact-qnty .
      878   end.
      879     for each buf_inkas no-lock
      880       where buf_inkas.obj-type   = p-obj-type
      881         and buf_inkas.obj-code   = p-obj-code
      882         and buf_inkas.status_    = 'новый':U
      883         and buf_inkas.shift-date = curr_shift-obj.shift-date
      884         and buf_inkas.shift-num  = curr_shift-obj.shift-num
      885     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      886     :
      887       for each buf_trn-doc no-lock
      888         where buf_trn-doc.doc-code = buf_inkas.inkas-code
      889           and buf_trn-doc.ext-doc-type = 'es':U
      890         ,each buf_tt-doc-line-attr no-lock
      891         ,each buf_doc-pl no-lock
      892         where buf_doc-pl.out-code = buf_trn-doc.doc-code
      893           and buf_doc-pl.gds-code = buf_tt-doc-line-attr.gds-code
      894           and buf_doc-pl.pl-code  = buf_tt-doc-line-attr.pl-code
      895       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      896       :
      897         assign
      898           buf_tt-doc-line-attr.rest = buf_tt-doc-line-attr.rest - buf_doc-pl.fact-qnty
      899           buf_tt-doc-line-attr.oo   = buf_tt-doc-line-attr.oo   - buf_doc-pl.fact-qnty
      900         .
      901       end.
      902       for each buf_trn-doc no-lock
      903         where buf_trn-doc.out-code = buf_inkas.inkas-code
      904           and buf_trn-doc.ext-doc-type = 'rs':U
      905         ,each buf_tt-doc-line-attr no-lock
      906         ,each buf_doc-pl no-lock
      907         where buf_doc-pl.out-code = buf_trn-doc.doc-code
      908           and buf_doc-pl.gds-code = buf_tt-doc-line-attr.gds-code
      909           and buf_doc-pl.pl-code  = buf_tt-doc-line-attr.pl-code
      910       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      911       :
      912         assign
      913           buf_tt-doc-line-attr.rest = buf_tt-doc-line-attr.rest + buf_doc-pl.fact-qnty
      914           buf_tt-doc-line-attr.oo   = buf_tt-doc-line-attr.oo   + buf_doc-pl.fact-qnty
      915         .
      916       end.
      917     end.
      918     for each buf_trn-doc no-lock
      919       where buf_trn-doc.obj-type   = p-obj-type
      920         and buf_trn-doc.obj-code   = p-obj-code
      921         and buf_trn-doc.status_    = 'факт':U
      922         and buf_trn-doc.shift-date = curr_shift-obj.shift-date
      923         and buf_trn-doc.shift-num  = curr_shift-obj.shift-num
      924     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      925     :
      926       for each buf_tt-doc-line-attr no-lock
      927         ,each buf_doc-pl no-lock
      928         where buf_doc-pl.out-code = buf_trn-doc.doc-code
      929           and buf_doc-pl.gds-code = buf_tt-doc-line-attr.gds-code
      930           and buf_doc-pl.pl-code  = buf_tt-doc-line-attr.pl-code
      931       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      932       :
      933         if lookup( buf_trn-doc.ext-doc-type, 'ee,ep,es,we,ev,em,wm,eo':U ) > 0 then do:
      934           assign
      935             v-sign = -1.0
      936           .
      937         end.
      938         else do:
      939           assign
      940             v-sign = 1.0
      941           .
      942           if lookup( buf_trn-doc.ext-doc-type, 'ie,re,rs,vt,vp,ap,mp,pc,iv,rv,im,io':U ) = 0 then do:
      943             undo, return error substitute( '&1. Тип "&2" не внесен в списки документов уменьшающих(увеличивающих) остатки!', vss-workfile, buf_trn-doc.ext-doc-type).
      944           end.
      945         end.
      946         assign
      947           buf_tt-doc-line-attr.rest = buf_tt-doc-line-attr.rest + buf_doc-pl.fact-qnty * v-sign
      948           buf_tt-doc-line-attr.oo   = buf_tt-doc-line-attr.oo   + buf_doc-pl.fact-qnty * v-sign
      949         .
      950       end.
      951     end.
      952     do transaction
      953     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      954     :
      955       for each buf_tt-doc-line-attr
      956       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      957       :
      958         find first buf_doc-line-attr exclusive-lock
      959           where buf_doc-line-attr.doc-code  = p-rvs-code
      960             and buf_doc-line-attr.gds-code  = buf_tt-doc-line-attr.gds-code
      961             and buf_doc-line-attr.attr-code = substitute("rvs-&1", buf_tt-doc-line-attr.pl-code)
      962           no-error .
      963         if not available buf_doc-line-attr then do:
      964           create buf_doc-line-attr .
      965           assign
      966             buf_doc-line-attr.doc-code = p-rvs-code
      967             buf_doc-line-attr.gds-code = buf_tt-doc-line-attr.gds-code
      968             buf_doc-line-attr.attr-code = substitute("rvs-&1", buf_tt-doc-line-attr.pl-code)
      969           .
      970         end.
      971         assign
      972           buf_doc-line-attr.attr-value = substitute ( "&1&2&3", buf_tt-doc-line-attr.rest, chr(4), buf_tt-doc-line-attr.oo )
      973         .
      974       end.
      975       for each buf_tt-rvs-line-attr:
      976         find first buf_rvs-line-attr EXCLUSIVE-LOCK where buf_rvs-line-attr.attr-code = buf_tt-rvs-line-attr.attr-code
      977                                                       and buf_rvs-line-attr.obj-code = buf_tt-rvs-line-attr.obj-code
      978                                                       and buf_rvs-line-attr.obj-type = buf_tt-rvs-line-attr.obj-type
      979                                                       and buf_rvs-line-attr.pl-code = buf_tt-rvs-line-attr.pl-code
      980                                                       and buf_rvs-line-attr.rvs-code = buf_tt-rvs-line-attr.rvs-code
      981                                                       and buf_rvs-line-attr.gds-code = buf_tt-rvs-line-attr.gds-code no-error .
      982         if not AVAILABLE buf_rvs-line-attr then do:
      983           create buf_rvs-line-attr .
      984         assign
      985           buf_rvs-line-attr.attr-code = buf_tt-rvs-line-attr.attr-code
      986           buf_rvs-line-attr.obj-code = buf_tt-rvs-line-attr.obj-code
      987           buf_rvs-line-attr.obj-type = buf_tt-rvs-line-attr.obj-type
      988           buf_rvs-line-attr.pl-code = buf_tt-rvs-line-attr.pl-code
      989           buf_rvs-line-attr.rvs-code = buf_tt-rvs-line-attr.rvs-code
      990           buf_rvs-line-attr.gds-code = buf_tt-rvs-line-attr.gds-code
      991         .
      992         end.
      993         if buf_rvs-line-attr.attr-code = "rvd-on"
      994            then buf_rvs-line-attr.attr-value = buf_tt-rvs-line-attr.attr-value_s .
      995         else
      996         buf_rvs-line-attr.attr-value = string(buf_tt-rvs-line-attr.attr-value) .
      997       end.
      998     end.
      999     empty temp-table  buf_tt-doc-line-attr.
     1000     empty TEMP-TABLE  buf_tt-rvs-line-attr.
     1001     assign
     1002       p-ok = true
     1003     .
     1004     return .
     1005   end.
