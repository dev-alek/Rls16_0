        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   define input parameter  parobj-type like ub.clients.obj-type no-undo.
        7   define input parameter  parobj-code like ub.clients.obj-code no-undo.
        8   define input parameter  pardb-num   like ub.db.db-num        no-undo.
        9   define output parameter parmy-obj   as   logical             no-undo.
       10   define variable vardb-num like ub.clients.db-num no-undo.
       11   define variable varactive as   logical           no-undo.
       12   define buffer bf_store   for ub.store.
       13   define buffer bf_clients for ub.clients.
       14   find first bf_clients where bf_clients.obj-type = parobj-type and
       15                               bf_clients.obj-code = parobj-code no-lock.
       16   assign
       17     vardb-num = bf_clients.db-num.
       18   case parobj-type :
       19     when 'маг':U then do:
       20       assign varactive = yes.
       21     end.
       22     when 'скл':U then do:
       23       find first bf_store where bf_store.obj-code = parobj-code no-lock no-error.
       24       if not available bf_store then do:
       25         return error substitute ("Ошибка при поиске склада с номером &1.", parobj-code).
       26       end.
       27       assign varactive = bf_store.active.
       28     end.
       29     otherwise do:
       30       return error substitute ("Неверный тип объекта &1.", parobj-type).
       31     end.
       32   end case.
       33   if vardb-num = pardb-num then do:
       34     assign
       35       parmy-obj = varactive
       36     .
       37   end.
       38   else do:
       39     assign
       40       parmy-obj = not varactive
       41     .
       42   end.
