        1   DEFINE INPUT PARAMETER pardoc-code LIKE ub.trn-doc.doc-code NO-UNDO.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Экран финансовых обязательств по документу".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   DEFINE TEMP-TABLE tt-fo NO-UNDO LIKE ub.fin-ob
      112   FIELD sum-base-trn LIKE ub.fin-ob.sum-base
      113   FIELD sum-rubl-trn LIKE ub.fin-ob.sum-rubl.
      114   DEFINE BUFFER bf_fin-ob       FOR ub.fin-ob.
      115   DEFINE BUFFER bf_fin-gds-part FOR ub.fin-gds-part.
      116   DEFINE BUFFER bf_parts        FOR ub.parts.
      117   DEFINE BUFFER bf_trn-doc      FOR ub.trn-doc.
      118   define buffer bf_goods        for ub.goods.
      119   DEFINE BUFFER bf_fin-doc      FOR ub.fin-doc.
      120   DEFINE BUFFER bf_fin-connect  FOR ub.fin-connect.
      121   DEFINE BUTTON b-exit AUTO-GO
      122        LABEL "&Выход"
      123        SIZE 10 BY 1
      124        BGCOLOR 8 .
      125   DEFINE BUTTON b-help
      126        LABEL "&Помощь"
      127        SIZE 10 BY 1
      128        BGCOLOR 8 .
      129   DEFINE QUERY b-fin-doc FOR
      130         bf_fin-connect,
      131         bf_fin-doc SCROLLING.
      132   DEFINE QUERY b-ob FOR
      133         tt-fo SCROLLING.
      134   DEFINE QUERY b-parts FOR
      135         bf_fin-gds-part,
      136         bf_goods,
      137         bf_parts SCROLLING.
      138   DEFINE BROWSE b-fin-doc
      139     QUERY b-fin-doc DISPLAY
      140         bf_fin-doc.prn-doc-code COLUMN-LABEL "Платеж"
      141    bf_fin-doc.contract-code COLUMN-LABEL "Договор"
      142    bf_fin-doc.sum-base FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма платежа (вал)"
      143    bf_fin-connect.sum-base FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма связи (вал)"
      144    bf_fin-doc.sum-rubl FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма платежа (abbr_rub)"
      145    bf_fin-connect.sum-rubl FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма связи (abbr_rub)"
      146    bf_fin-doc.fin-doc-code FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Вн. код платежа"
      147       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.5 BY 6
      148            TITLE "Платежи по финансовому обязательству".
      149   DEFINE BROWSE b-ob
      150     QUERY b-ob DISPLAY
      151         tt-fo.prn-doc-code COLUMN-LABEL "Фин. обяз."
      152   tt-fo.sum-base FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Общая сумма (вал)"
      153   tt-fo.sum-base-trn FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма по док. (вал)"
      154   tt-fo.sum-rubl FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Общая сумма (abbr_rub)"
      155   tt-fo.sum-rubl-trn FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма по док. (abbr_rub)"
      156   tt-fo.contract-code COLUMN-LABEL "Договор"
      157   tt-fo.doc-code COLUMN-LABEL "Вн. код. фин. обяз."
      158       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.5 BY 6
      159            TITLE "Финансовые обязательства" ROW-HEIGHT-CHARS .67.
      160   DEFINE BROWSE b-parts
      161     QUERY b-parts DISPLAY
      162         bf_parts.in-code    COLUMN-LABEL "Прих. накл."
      163    bf_parts.part-code  COLUMN-LABEL "Код партии"
      164    bf_parts.fact-qnty  COLUMN-LABEL "Факт кол-во"
      165    bf_parts.price-base COLUMN-LABEL "Цена (вал)"
      166    bf_parts.price-rubl COLUMN-LABEL "Цена (abbr_rub)"
      167       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.5 BY 6
      168            TITLE "Партии по финансовому обязательству" ROW-HEIGHT-CHARS .67.
      169   DEFINE FRAME Dialog-Frame
      170        b-exit AT ROW 1 COL 1
      171        b-help AT ROW 1 COL 11
      172        b-ob AT ROW 2.25 COL 1
      173        b-parts AT ROW 8.54 COL 1
      174        b-fin-doc AT ROW 14.83 COL 1
      175        SPACE(0.00) SKIP(0.17)
      176       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      177            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      178            TITLE "Финансовые обязательства на которые повлиял данный складской документ"
      179            DEFAULT-BUTTON b-exit.
      180   ASSIGN
      181          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      182          FRAME Dialog-Frame:HIDDEN           = TRUE.
      183   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      184   DO:
      185     APPLY "END-ERROR":U TO SELF.
      186   END.
      187   ON VALUE-CHANGED OF b-ob IN FRAME Dialog-Frame
      188   DO:
      189     RUN open-parts-query IN THIS-PROCEDURE.
      190     RUN open-fin-doc-query IN THIS-PROCEDURE.
      191   END.
      192   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      193   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      194   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      195   on help of frame Dialog-Frame
      196   do:
      197     run gbl/app_help.p
      198       (input this-procedure :file-name
      199       ,input ''
      200       ,input ?
      201       ) no-error.
      202     if error-status :error then do:
      203       message
      204         "Ошибка при вызове помощи"
      205         error-status :get-message(1)
      206         view-as alert-box .
      207     end.
      208   end.
      209   run minbtn-set in this-procedure .
      210   on choose of b-help in frame Dialog-Frame
      211   do:
      212     apply "help":u to frame Dialog-Frame .
      213   end.
      214   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      215   procedure minbtn-set :
      216       do
      217           on error undo, return error return-value
      218           :
      219           define variable ii              as integer       no-undo .
      220           define variable fh              as widget-handle no-undo .
      221           define variable hh              as widget-handle no-undo .
      222           define variable v-h             as handle        extent 4 no-undo .
      223           define variable v-name-button   as character     no-undo .
      224           define variable v-help-old-x    as decimal       no-undo .
      225           define variable v-help-old-y    as decimal       no-undo .
      226           define variable v-help-old-size as decimal       no-undo .
      227           define variable v-frame-width   as decimal       no-undo .
      228           define variable jj              as integer       no-undo .
      229           do
      230               on error undo, return error
      231               :
      232               assign
      233                   v-frame-width = frame Dialog-Frame:width - 0.3
      234                   fh            = frame Dialog-Frame:first-child
      235                   hh            = fh:first-child
      236                   ii            = 1
      237                   .
      238               do while valid-handle(hh):
      239                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      240                   do:
      241                       case lc(hh:name) :
      242                           when "b-help" then
      243                               do:
      244                                   hh:load-image-up("cmp/b-help.bmp":u) .
      245                                   hh:load-image-down("cmp/b-help.bmp":u) .
      246                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      247                                   hh:TOOLTIP = "Помощь" .
      248                                   v-help-old-x = hh:column .
      249                                   v-help-old-y = hh:row    .
      250                                   v-help-old-size = hh:width .
      251                                   hh:width-chars = 2.5 .
      252                               end.
      253                           when "b-print" then
      254                               do:
      255                                   hh:load-image("cmp/b-print.bmp":u) .
      256                                   hh:TOOLTIP = "Печать" .
      257                                   v-h[ii] = hh:handle .
      258                                   ii = ii + 1 .
      259                                   hh:width-chars = 3 .
      260                               end.
      261                           when "b-history" or
      262                           when "b-hist" then
      263                               do:
      264                                   hh:load-image("cmp/b-hist.bmp":u) .
      265                                   hh:TOOLTIP = "История" .
      266                                   v-h[ii] = hh:handle .
      267                                   ii = ii + 1 .
      268                                   hh:width-chars = 3 .
      269                               end.
      270                           when "b-sch" then
      271                               do:
      272                                   hh:load-image("cmp/b-sch.bmp":u) .
      273                                   hh:TOOLTIP = "Установка Фильтра" .
      274                                   v-h[ii] = hh:handle .
      275                                   ii = ii + 1 .
      276                                   hh:width-chars = 3 .
      277                               end.
      278                           when "b-hist-user" then
      279                               do:
      280                                   hh:load-image("cmp/b-hist.bmp":u) .
      281                                   hh:TOOLTIP = "История пользователя" .
      282                                   ii = ii + 1 .
      283                               end.
      284                       end case.
      285                   end.
      286                   hh = hh:next-sibling.
      287               end.
      288               b-help:column = v-frame-width - b-help:width-chars.
      289               jj = 0.
      290               repeat ii = 4 to 1 by -1 :
      291                   if valid-handle (v-h[ii] ) then
      292                   do:
      293                       jj  = jj + 1 .
      294                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      295                       v-h[ii]:row    = v-help-old-y .
      296                   end.
      297               end.
      298           end.
      299       end.
      300   end procedure.
      301   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      302   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      303   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      304   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      305   define variable v-diasize-current-frame-width  as decimal   no-undo .
      306   define variable v-diasize-current-frame-height as decimal   no-undo .
      307   define variable v-diasize-change-size          as logical   no-undo .
      308   define variable v-diasize-resize-button        as handle    no-undo .
      309   define variable v-diasize-wndmax               as logical   no-undo .
      310   define variable v-diasize-wndstore             as logical   no-undo .
      311   define variable v-diasize-proc-name            as character no-undo .
      312   define variable v-diasize-browse-handle        as handle    no-undo .
      313   define variable v-diasize-browse-number        as integer   no-undo .
      314   define variable v-diasize-need-full-display    as logical   no-undo init false .
      315   define temp-table temp-diasize-handle no-undo
      316     field handle-value  as handle
      317     field save-position as decimal
      318     index xpk is primary unique handle-value
      319     .
      320   define temp-table temp-browse-handle no-undo
      321     field browse-type   as character
      322     field browse-number as integer
      323     field browse-handle as handle
      324     field original-size as decimal
      325     index xpk is primary unique browse-type browse-number
      326     index xie browse-type browse-handle
      327   .
      328   procedure diasize_change-height :
      329     define input  parameter p-change-value  as decimal   no-undo .
      330     define input  parameter p-move-resize   as logical   no-undo .
      331     define variable v-field-group-handle    as handle    no-undo .
      332     define variable v-object-handle         as handle    no-undo .
      333     define variable v-frame-height          as decimal   no-undo .
      334     define variable v-frame-virtual-height  as decimal   no-undo .
      335     define variable v-browse-height         as decimal   no-undo .
      336     define variable v-window-height         as decimal   no-undo .
      337     define variable v-window-virtual-height as decimal   no-undo .
      338     define variable v-change-sign           as integer   no-undo .
      339     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      340     define buffer buf_temp-browse-handle  for temp-browse-handle .
      341     if p-change-value > 0
      342     then do:
      343       if frame Dialog-Frame :height + p-change-value
      344           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      345       then do:
      346         assign
      347           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      348                           - (frame Dialog-Frame :height-chars)
      349         .
      350         if p-change-value <= 0
      351         then do:
      352           run diasize_position-resize-button in this-procedure .
      353           return .
      354         end.
      355       end.
      356     end.
      357     if p-change-value < 0
      358     then do:
      359       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      360       then do:
      361         assign
      362           p-change-value = v-diasize-orig-frame-height
      363                          - (frame Dialog-Frame :height-chars)
      364         .
      365         if p-change-value >= 0
      366         then do:
      367           run diasize_position-resize-button in this-procedure .
      368           return .
      369         end.
      370       end.
      371     end.
      372     if p-change-value >= 0
      373     then do:
      374       assign
      375         v-change-sign = 1
      376       .
      377     end.
      378     else do:
      379       assign
      380         v-change-sign = -1
      381       .
      382     end.
      383     assign
      384       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      385     .
      386     if p-change-value = 0
      387     then do:
      388       run diasize_position-resize-button in this-procedure .
      389       return .
      390     end.
      391     move_block:
      392     do
      393     on error undo move_block, retry move_block
      394     :
      395       if retry
      396       then do:
      397         do
      398         on error undo move_block, leave move_block
      399         :
      400           if p-change-value > 0
      401           then do:
      402             for each buf_temp-diasize-handle
      403             on error undo, next
      404             :
      405               assign
      406                 v-object-handle = buf_temp-diasize-handle.handle-value
      407               .
      408               if v-object-handle <> v-diasize-resize-button
      409               then do:
      410                 assign
      411                   v-object-handle :row = buf_temp-diasize-handle.save-position
      412                 .
      413               end.
      414             end.
      415             assign
      416               v-diasize-browse-handle :height = v-browse-height
      417             .
      418             for each buf_temp-browse-handle
      419               where buf_temp-browse-handle.browse-type = 'height':u
      420             on error undo, next
      421             :
      422               assign
      423                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      424               .
      425             end.
      426             assign
      427               frame Dialog-Frame :height = v-frame-height
      428             .
      429             if frame Dialog-Frame :scrollable = true
      430             then do:
      431               assign
      432                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      433               .
      434             end.
      435             run diasize_position-resize-button in this-procedure .
      436           end.
      437           else do:
      438             if frame Dialog-Frame :scrollable = true
      439             then do:
      440               assign
      441                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      442               .
      443             end.
      444             assign
      445               frame Dialog-Frame :height = v-frame-height
      446             .
      447             assign
      448               v-diasize-browse-handle :height = v-browse-height
      449             .
      450             for each buf_temp-browse-handle
      451               where buf_temp-browse-handle.browse-type = 'height':u
      452             on error undo, next
      453             :
      454               assign
      455                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      456               .
      457             end.
      458             for each buf_temp-diasize-handle
      459             on error undo, next
      460             :
      461               assign
      462                 v-object-handle = buf_temp-diasize-handle.handle-value
      463               .
      464               if v-object-handle <> v-diasize-resize-button
      465               then do:
      466                 assign
      467                   v-object-handle :row = buf_temp-diasize-handle.save-position
      468                 .
      469               end.
      470             end.
      471             run diasize_position-resize-button in this-procedure .
      472           end.
      473           assign
      474             v-diasize-change-size = false
      475           .
      476           leave move_block .
      477         end.
      478       end.
      479       assign
      480         v-diasize-need-full-display = true
      481       .
      482       if v-diasize-change-size = false
      483       then do:
      484         assign
      485           v-diasize-change-size = true
      486         .
      487       end.
      488       else do:
      489         return .
      490       end.
      491       assign
      492         v-frame-height = frame Dialog-Frame :height
      493         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      494         v-browse-height = v-diasize-browse-handle :height
      495       .
      496       for each buf_temp-browse-handle
      497         where buf_temp-browse-handle.browse-type = 'height':u
      498       :
      499         assign
      500           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      501         .
      502       end.
      503       for each buf_temp-diasize-handle
      504       :
      505         delete buf_temp-diasize-handle .
      506       end.
      507       assign
      508         v-field-group-handle = frame Dialog-Frame :first-child
      509       .
      510       do while valid-handle(v-field-group-handle)
      511       :
      512         assign
      513           v-object-handle = v-field-group-handle :first-child
      514         .
      515         do while valid-handle(v-object-handle)
      516         :
      517           if  v-object-handle <> v-diasize-browse-handle :handle
      518           and can-query(v-object-handle, "row")
      519           and can-query(v-object-handle, "height")
      520           and ( v-object-handle :row > v-diasize-browse-handle :row )
      521           then do:
      522             find first buf_temp-browse-handle
      523               where buf_temp-browse-handle.browse-type   = 'height':u
      524                 and buf_temp-browse-handle.browse-handle = v-object-handle
      525               no-error .
      526             if available buf_temp-browse-handle
      527             then do:
      528             end.
      529             else do:
      530               create buf_temp-diasize-handle .
      531               assign
      532                 buf_temp-diasize-handle.handle-value  = v-object-handle
      533                 buf_temp-diasize-handle.save-position = v-object-handle :row
      534               .
      535             end.
      536           end.
      537           assign
      538             v-object-handle = v-object-handle :next-sibling
      539           .
      540         end.
      541         assign
      542           v-field-group-handle = v-field-group-handle :next-sibling
      543         .
      544       end.
      545       do with frame Dialog-Frame
      546       :
      547         hide v-diasize-resize-button .
      548         assign
      549           v-diasize-resize-button :row    = 1
      550           v-diasize-resize-button :column = 1
      551         .
      552       end.
      553       if p-change-value > 0
      554       then do:
      555         if frame Dialog-Frame :scrollable = true
      556         then do:
      557           assign
      558             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      559             no-error .
      560           if error-status :error
      561           or error-status :get-message(1) <> ""
      562           then do:
      563             undo move_block, retry move_block .
      564           end.
      565         end.
      566         assign
      567           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      568           no-error .
      569         if error-status :error
      570         or error-status :get-message(1) <> ""
      571         then do:
      572           undo move_block, retry move_block .
      573         end.
      574         assign
      575           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      576           no-error .
      577         if error-status :error
      578         or error-status :get-message(1) <> ""
      579         then do:
      580           undo move_block, retry move_block .
      581         end.
      582         for each buf_temp-browse-handle
      583           where buf_temp-browse-handle.browse-type = 'height':u
      584         on error undo move_block, retry move_block
      585         :
      586           assign
      587             buf_temp-browse-handle.browse-handle :height
      588               = buf_temp-browse-handle.browse-handle :height + p-change-value
      589             no-error .
      590           if error-status :error
      591           or error-status :get-message(1) <> ""
      592           then do:
      593             undo move_block, retry move_block .
      594           end.
      595         end.
      596         for each buf_temp-diasize-handle
      597         on error undo move_block, retry move_block
      598         :
      599           assign
      600             v-object-handle = buf_temp-diasize-handle.handle-value
      601           .
      602           if v-object-handle <> v-diasize-resize-button
      603           then do:
      604             assign
      605               v-object-handle :row = v-object-handle :row + p-change-value
      606               no-error .
      607             if error-status :error
      608             or error-status :get-message(1) <> ""
      609             then do:
      610               undo move_block, retry move_block .
      611             end.
      612           end.
      613         end.
      614       end.
      615       else do:
      616         for each buf_temp-diasize-handle
      617         on error undo move_block, retry move_block
      618         :
      619           assign
      620             v-object-handle = buf_temp-diasize-handle.handle-value
      621           .
      622           if v-object-handle <> v-diasize-resize-button
      623           then do:
      624             assign
      625               v-object-handle :row = v-object-handle :row + p-change-value
      626               no-error .
      627             if error-status :error
      628             or error-status :get-message(1) <> ""
      629             then do:
      630               undo move_block, retry move_block .
      631             end.
      632           end.
      633         end.
      634         assign
      635           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      636           no-error .
      637         if error-status :error
      638         or error-status :get-message(1) <> ""
      639         then do:
      640           undo move_block, retry move_block .
      641         end.
      642         for each buf_temp-browse-handle
      643           where buf_temp-browse-handle.browse-type = 'height':u
      644         on error undo move_block, retry move_block
      645         :
      646           assign
      647             buf_temp-browse-handle.browse-handle :height
      648               = buf_temp-browse-handle.browse-handle :height + p-change-value
      649             no-error .
      650           if error-status :error
      651           or error-status :get-message(1) <> ""
      652           then do:
      653             undo move_block, retry move_block .
      654           end.
      655         end.
      656         assign
      657           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      658           no-error .
      659         if error-status :error
      660         or error-status :get-message(1) <> ""
      661         then do:
      662           undo move_block, retry move_block .
      663         end.
      664         if frame Dialog-Frame :scrollable = true
      665         then do:
      666           assign
      667             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      668             no-error .
      669           if error-status :error
      670           or error-status :get-message(1) <> ""
      671           then do:
      672             undo move_block, retry move_block .
      673           end.
      674         end.
      675       end.
      676       if p-move-resize = true
      677       then do:
      678         run diasize_position-resize-button in this-procedure .
      679       end.
      680       if v-diasize-wndstore = true
      681       then do:
      682         if connected("ub") = true
      683         then do:
      684           define variable v-cntxt-db-num        as integer   no-undo .
      685           define variable v-cntxt-userid        as character no-undo .
      686           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      687                                             , OUTPUT v-cntxt-userid
      688                                             ) .
      689           run gbl/wndsizew.p
      690             (input  v-cntxt-db-num
      691             ,input  v-cntxt-userid
      692             ,input  v-diasize-proc-name
      693             ,input  'height':u
      694             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      695             ) .
      696         end.
      697       end.
      698     end.
      699     assign
      700       v-diasize-change-size = false
      701     .
      702   end procedure.
      703   procedure diasize_set-height :
      704     define input  parameter p-new-height  as decimal   no-undo .
      705     define input  parameter p-move-resize as logical   no-undo .
      706     do
      707     on error undo, return error return-value
      708     :
      709       run diasize_change-height in this-procedure
      710         (input  (p-new-height - frame Dialog-Frame :height)
      711         ,input  p-move-resize
      712         ) .
      713     end.
      714   end procedure.
      715   procedure diasize_change-width :
      716     define input  parameter p-change-value as decimal   no-undo .
      717     define input  parameter p-move-resize  as logical   no-undo .
      718     define variable v-field-group-handle   as handle    no-undo .
      719     define variable v-object-handle        as handle    no-undo .
      720     define variable v-frame-width          as decimal   no-undo .
      721     define variable v-frame-virtual-width  as decimal   no-undo .
      722     define variable v-browse-width         as decimal   no-undo .
      723     define variable v-window-width         as decimal   no-undo .
      724     define variable v-window-virtual-width as decimal   no-undo .
      725     define variable v-change-sign          as integer   no-undo .
      726     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      727     define buffer buf_temp-browse-handle  for temp-browse-handle .
      728     if p-change-value > 0
      729     then do:
      730       if frame Dialog-Frame :width + p-change-value >
      731           session :width-chars
      732       then do:
      733         assign
      734           p-change-value = session :width-chars - frame Dialog-Frame :width
      735         .
      736         if p-change-value <= 0
      737         then do:
      738           run diasize_position-resize-button in this-procedure .
      739           return .
      740         end.
      741       end.
      742     end.
      743     if p-change-value < 0
      744     then do:
      745       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      746       then do:
      747         assign
      748           p-change-value = v-diasize-orig-frame-width
      749                          - frame Dialog-Frame :width
      750         .
      751         if p-change-value >= 0
      752         then do:
      753           run diasize_position-resize-button in this-procedure .
      754           return .
      755         end.
      756       end.
      757     end.
      758     if p-change-value >= 0
      759     then do:
      760       assign
      761         v-change-sign = 1
      762       .
      763     end.
      764     else do:
      765       assign
      766         v-change-sign = -1
      767       .
      768     end.
      769     assign
      770       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      771     .
      772     if p-change-value = 0
      773     then do:
      774       run diasize_position-resize-button in this-procedure .
      775       return .
      776     end.
      777     move_block:
      778     do
      779     on error undo move_block, leave move_block
      780     :
      781       if retry
      782       then do:
      783         do
      784         on error undo move_block, leave move_block
      785         :
      786           if p-change-value > 0
      787           then do:
      788             for each buf_temp-diasize-handle
      789             on error undo, next
      790             :
      791               assign
      792                 v-object-handle = buf_temp-diasize-handle.handle-value
      793               .
      794               if v-object-handle <> v-diasize-resize-button
      795               then do:
      796                 assign
      797                   v-object-handle :col = buf_temp-diasize-handle.save-position
      798                 .
      799               end.
      800             end.
      801             assign
      802               v-diasize-browse-handle :width = v-browse-width
      803             .
      804             for each buf_temp-browse-handle
      805               where buf_temp-browse-handle.browse-type = 'width':u
      806             on error undo, next
      807             :
      808               assign
      809                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      810               .
      811             end.
      812             assign
      813               frame Dialog-Frame :width = v-frame-width
      814             .
      815             if frame Dialog-Frame :scrollable = true
      816             then do:
      817               assign
      818                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      819               .
      820             end.
      821             run diasize_position-resize-button in this-procedure .
      822           end.
      823           else do:
      824             if frame Dialog-Frame :scrollable = true
      825             then do:
      826               assign
      827                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      828               .
      829             end.
      830             assign
      831               frame Dialog-Frame :width = v-frame-width
      832             .
      833             for each buf_temp-browse-handle
      834               where buf_temp-browse-handle.browse-type = 'width':u
      835             on error undo, next
      836             :
      837               assign
      838                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      839               .
      840             end.
      841             assign
      842               v-diasize-browse-handle :width = v-browse-width
      843             .
      844             for each buf_temp-diasize-handle
      845             on error undo, next
      846             :
      847               assign
      848                 v-object-handle = buf_temp-diasize-handle.handle-value
      849               .
      850               if v-object-handle <> v-diasize-resize-button
      851               then do:
      852                 assign
      853                   v-object-handle :col = buf_temp-diasize-handle.save-position
      854                 .
      855               end.
      856             end.
      857             run diasize_position-resize-button in this-procedure .
      858           end.
      859           assign
      860             v-diasize-change-size = false
      861           .
      862           leave move_block .
      863         end.
      864       end.
      865       assign
      866         v-diasize-need-full-display = true
      867       .
      868       if v-diasize-change-size = false
      869       then do:
      870         assign
      871           v-diasize-change-size = true
      872         .
      873       end.
      874       else do:
      875         return .
      876       end.
      877       assign
      878         v-frame-width = frame Dialog-Frame :width
      879         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      880         v-browse-width = v-diasize-browse-handle :width
      881       .
      882       for each buf_temp-browse-handle
      883         where buf_temp-browse-handle.browse-type = 'width':u
      884       :
      885         assign
      886           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      887         .
      888       end.
      889       for each buf_temp-diasize-handle
      890       :
      891         delete buf_temp-diasize-handle .
      892       end.
      893       assign
      894         v-field-group-handle = frame Dialog-Frame :first-child
      895       .
      896       do while valid-handle(v-field-group-handle)
      897       :
      898         assign
      899           v-object-handle = v-field-group-handle :first-child
      900         .
      901         do while valid-handle(v-object-handle)
      902         :
      903           if  v-object-handle <> v-diasize-browse-handle :handle
      904           and v-object-handle <> v-diasize-resize-button
      905           and can-query(v-object-handle, "row")
      906           and can-query(v-object-handle, "height")
      907           and ( v-object-handle :col + v-object-handle :width
      908                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      909               )
      910           then do:
      911             find first buf_temp-browse-handle
      912               where buf_temp-browse-handle.browse-type   = 'width':u
      913                 and buf_temp-browse-handle.browse-handle = v-object-handle
      914               no-error .
      915             if available buf_temp-browse-handle
      916             then do:
      917             end.
      918             else do:
      919               create buf_temp-diasize-handle .
      920               assign
      921                 buf_temp-diasize-handle.handle-value  = v-object-handle
      922                 buf_temp-diasize-handle.save-position = v-object-handle :col
      923               .
      924             end.
      925           end.
      926           assign
      927             v-object-handle = v-object-handle :next-sibling
      928           .
      929         end.
      930         assign
      931           v-field-group-handle = v-field-group-handle :next-sibling
      932         .
      933       end.
      934       do with frame Dialog-Frame
      935       :
      936         hide v-diasize-resize-button .
      937         v-diasize-resize-button :row = 1.
      938         v-diasize-resize-button :column = 1.
      939       end.
      940       if p-change-value > 0
      941       then do:
      942         if frame Dialog-Frame :scrollable = true
      943         then do:
      944           assign
      945             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      946             no-error .
      947           if error-status :error
      948           or error-status :get-message(1) <> ""
      949           then do:
      950             undo move_block, retry move_block.
      951           end.
      952         end.
      953         assign
      954           frame Dialog-Frame :width = v-frame-width + p-change-value
      955           no-error .
      956         if error-status :error
      957         or error-status :get-message(1) <> ""
      958         then do:
      959           undo move_block, retry move_block.
      960         end.
      961         assign
      962           v-diasize-browse-handle :width = v-browse-width + p-change-value
      963         no-error .
      964         if error-status :error
      965         or error-status :get-message(1) <> ""
      966         then do:
      967           undo move_block, retry move_block.
      968         end.
      969         for each buf_temp-browse-handle
      970           where buf_temp-browse-handle.browse-type = 'width':u
      971         on error undo move_block, retry move_block
      972         :
      973           assign
      974             buf_temp-browse-handle.browse-handle :width
      975               = buf_temp-browse-handle.browse-handle :width + p-change-value
      976             no-error .
      977           if error-status :error
      978           or error-status :get-message(1) <> ""
      979           then do:
      980             undo move_block, retry move_block .
      981           end.
      982         end.
      983         for each buf_temp-diasize-handle
      984         on error undo move_block, retry move_block
      985         :
      986           assign
      987             v-object-handle = buf_temp-diasize-handle.handle-value
      988           .
      989           if v-object-handle <> v-diasize-resize-button
      990           then do:
      991             assign
      992               v-object-handle :col = v-object-handle :col + p-change-value
      993               no-error .
      994             if error-status :error
      995             or error-status :get-message(1) <> ""
      996             then do:
      997               undo move_block, retry move_block .
      998             end.
      999           end.
     1000         end.
     1001       end.
     1002       else do:
     1003         for each buf_temp-diasize-handle
     1004         on error undo move_block, retry move_block
     1005         :
     1006           assign
     1007             v-object-handle = buf_temp-diasize-handle.handle-value
     1008           .
     1009           if v-object-handle <> v-diasize-resize-button
     1010           then do:
     1011             assign
     1012               v-object-handle :col = v-object-handle :col + p-change-value
     1013               no-error .
     1014             if error-status :error
     1015             or error-status :get-message(1) <> ""
     1016             then do:
     1017               undo move_block, retry move_block .
     1018             end.
     1019           end.
     1020         end.
     1021         for each buf_temp-browse-handle
     1022           where buf_temp-browse-handle.browse-type = 'width':u
     1023         on error undo move_block, retry move_block
     1024         :
     1025           assign
     1026             buf_temp-browse-handle.browse-handle :width
     1027               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1028             no-error .
     1029           if error-status :error
     1030           or error-status :get-message(1) <> ""
     1031           then do:
     1032             undo move_block, retry move_block .
     1033           end.
     1034         end.
     1035         assign
     1036           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1037           no-error .
     1038         if error-status :error
     1039         or error-status :get-message(1) <> ""
     1040         then do:
     1041           undo move_block, retry move_block.
     1042         end.
     1043         assign
     1044           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1045         no-error .
     1046         if error-status :error
     1047         or error-status :get-message(1) <> ""
     1048         then do:
     1049           undo move_block, retry move_block.
     1050         end.
     1051         if frame Dialog-Frame :scrollable = true
     1052         then do:
     1053           assign
     1054             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1055           no-error .
     1056           if error-status :error
     1057           or error-status :get-message(1) <> ""
     1058           then do:
     1059             undo move_block, retry move_block.
     1060           end.
     1061         end.
     1062       end.
     1063       if p-move-resize
     1064       then do:
     1065         run diasize_position-resize-button in this-procedure .
     1066       end.
     1067       if v-diasize-wndstore = true
     1068       then do:
     1069         if connected("ub") = true
     1070         then do:
     1071           define variable v-cntxt-db-num        as integer   no-undo .
     1072           define variable v-cntxt-userid        as character no-undo .
     1073           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1074                                             , OUTPUT v-cntxt-userid
     1075                                             ) .
     1076           run gbl/wndsizew.p
     1077             (input  v-cntxt-db-num
     1078             ,input  v-cntxt-userid
     1079             ,input  v-diasize-proc-name
     1080             ,input  'width':u
     1081             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1082             ) .
     1083         end.
     1084       end.
     1085     end.
     1086     assign
     1087       v-diasize-change-size = false
     1088     .
     1089   end procedure.
     1090   procedure diasize_set-width :
     1091     define input  parameter p-new-width  as decimal   no-undo .
     1092     define input  parameter p-move-resize as logical   no-undo .
     1093     do
     1094     on error undo, return error return-value
     1095     :
     1096       run diasize_change-width in this-procedure
     1097         (input  (p-new-width - frame Dialog-Frame :width)
     1098         ,input  p-move-resize
     1099         ) .
     1100     end.
     1101   end procedure.
     1102   procedure diasize_position-resize-button :
     1103     do with frame Dialog-Frame
     1104     :
     1105       hide v-diasize-resize-button .
     1106       assign
     1107         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1108                     - 1
     1109                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1110         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1111                     - 1
     1112                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1113       .
     1114       view v-diasize-resize-button .
     1115     end.
     1116   end procedure.
     1117   on alt-right anywhere
     1118   do:
     1119     run diasize_change-width in this-procedure
     1120       (input 1
     1121       ,input true
     1122       ) .
     1123     return no-apply .
     1124   end.
     1125   on alt-left anywhere
     1126   do:
     1127     run diasize_change-width in this-procedure
     1128       (input -1
     1129       ,input true
     1130       ) .
     1131     return no-apply .
     1132   end.
     1133   on alt-down anywhere
     1134   do:
     1135     run diasize_change-height in this-procedure
     1136       (input 1
     1137       ,input true
     1138       ) .
     1139     return no-apply .
     1140   end.
     1141   on alt-up anywhere
     1142   do:
     1143     run diasize_change-height in this-procedure
     1144       (input -1
     1145       ,input true
     1146       ) .
     1147     return no-apply .
     1148   end.
     1149   on alt-enter of frame Dialog-Frame
     1150   do:
     1151     run diasize_maximize in this-procedure
     1152       (input  ?
     1153       ).
     1154     return no-apply .
     1155   end.
     1156   procedure diasize_end-move :
     1157     do
     1158     on error undo, return error return-value
     1159     :
     1160       define variable v-row-delta as decimal   no-undo .
     1161       define variable v-col-delta as decimal   no-undo .
     1162       define variable v-new-row as decimal   no-undo .
     1163       define variable v-new-col as decimal   no-undo .
     1164       assign
     1165         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1166         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1167       .
     1168       assign
     1169         v-row-delta = v-new-row - frame Dialog-Frame :height
     1170         v-col-delta = v-new-col - frame Dialog-Frame :width
     1171       .
     1172       run diasize_change-height in this-procedure
     1173         (input v-row-delta
     1174         ,input true
     1175         ) .
     1176       run diasize_change-width in this-procedure
     1177         (input v-col-delta
     1178         ,input true
     1179         ) .
     1180     end.
     1181   end procedure.
     1182   procedure diasize_maximize :
     1183     define input  parameter p-action as logical   no-undo .
     1184     do
     1185     on error undo, return error return-value
     1186     :
     1187       if p-action = ?
     1188       then do:
     1189         if v-diasize-need-maximize = true
     1190         then do:
     1191           assign
     1192             p-action = true
     1193           .
     1194         end.
     1195         else do:
     1196           assign
     1197             p-action = false
     1198           .
     1199         end.
     1200       end.
     1201       if p-action = true
     1202       then do:
     1203         run diasize_change-height in this-procedure
     1204           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1205               - frame Dialog-Frame :height-chars
     1206           ,input true
     1207           ) .
     1208         run diasize_change-width in this-procedure
     1209           (input session :width-chars
     1210               - frame Dialog-Frame :width-chars
     1211           ,input true
     1212           ) .
     1213         assign
     1214           v-diasize-need-maximize = false
     1215         .
     1216       end.
     1217       else do:
     1218         run diasize_change-width in this-procedure
     1219           (input v-diasize-orig-frame-width
     1220               - frame Dialog-Frame :width-chars
     1221           ,input true
     1222           ) .
     1223         run diasize_change-height in this-procedure
     1224           (input v-diasize-orig-frame-height
     1225               - frame Dialog-Frame :height-chars
     1226           ,input true
     1227           ) .
     1228         assign
     1229           v-diasize-need-maximize = true
     1230         .
     1231       end.
     1232     end.
     1233   end procedure.
     1234   procedure diasize_restore-orig-size :
     1235     do
     1236     on error undo, return error return-value
     1237     :
     1238       assign
     1239         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1240         v-diasize-current-frame-height = frame Dialog-Frame :height
     1241       .
     1242       run diasize_set-height in this-procedure
     1243         (input  v-diasize-orig-frame-height
     1244         ,input  true
     1245         ) .
     1246       run diasize_set-width in this-procedure
     1247         (input  v-diasize-orig-frame-width
     1248         ,input  true
     1249         ) .
     1250     end.
     1251   end procedure.
     1252   procedure diasize_restore-current-size :
     1253     do
     1254     on error undo, return error return-value
     1255     :
     1256       run diasize_set-height in this-procedure
     1257         (input  v-diasize-current-frame-height
     1258         ,input  true
     1259         ) .
     1260       run diasize_set-width in this-procedure
     1261         (input  v-diasize-current-frame-width
     1262         ,input  true
     1263         ) .
     1264     end.
     1265   end procedure.
     1266   procedure diasize_set-browse-handle :
     1267     define input  parameter p-browse-handle as handle   no-undo .
     1268     define buffer buf_temp-browse-handle for temp-browse-handle .
     1269     do
     1270     on error undo, return error return-value
     1271     :
     1272       assign
     1273         v-diasize-browse-handle = p-browse-handle
     1274       .
     1275       for each buf_temp-browse-handle
     1276       on error undo, return error return-value
     1277       :
     1278         delete buf_temp-browse-handle .
     1279       end.
     1280     end.
     1281   end procedure.
     1282   procedure diasize_add_browse :
     1283     define input  parameter p-browse-type   as character no-undo .
     1284     define input  parameter p-browse-handle as handle    no-undo .
     1285     define buffer buf_temp-browse-handle for temp-browse-handle .
     1286     do
     1287     on error undo, return error return-value
     1288     :
     1289       assign
     1290         v-diasize-browse-number = v-diasize-browse-number + 1
     1291       .
     1292       create buf_temp-browse-handle .
     1293       assign
     1294         buf_temp-browse-handle.browse-type   = p-browse-type
     1295         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1296         buf_temp-browse-handle.browse-handle = p-browse-handle
     1297       .
     1298     end.
     1299   end procedure.
     1300   procedure diasize_init :
     1301     define variable v-default-value    as logical   no-undo .
     1302     define variable v-restore-saved    as logical   no-undo .
     1303     define variable v-resize-value-str as character no-undo .
     1304     do
     1305     on error undo, return error return-value
     1306     :
     1307       do with frame Dialog-Frame
     1308       :
     1309         assign
     1310           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1311           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1312           v-diasize-browse-handle     = browse b-ob :handle
     1313         .
     1314         create button v-diasize-resize-button
     1315         assign
     1316           parent        = frame Dialog-Frame :first-child
     1317           label         = "s"
     1318           height-pixels = 16
     1319           width-pixels  = 16
     1320           visible       = true
     1321           sensitive     = true
     1322           movable       = true
     1323           triggers:
     1324             on end-move persistent run diasize_end-move in this-procedure .
     1325           end triggers.
     1326         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1327         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1328         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1329         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1330         assign
     1331           v-diasize-wndmax = false
     1332         .
     1333         if connected("ub") = true
     1334         then do:
     1335           define variable v-cntxt-db-num        as integer   no-undo .
     1336           define variable v-cntxt-userid        as character no-undo .
     1337           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1338                                             , OUTPUT v-cntxt-userid
     1339                                             ) .
     1340           run gbl/wndpar_r.p
     1341             (input  v-cntxt-db-num
     1342             ,input  v-cntxt-userid
     1343             ,input  'wndmax':U
     1344             ,output v-diasize-wndmax
     1345             ,output v-default-value
     1346             ) .
     1347         end.
     1348         assign
     1349           v-diasize-wndstore = false
     1350         .
     1351         if connected("ub") = true
     1352         then do:
     1353           run gbl/wndpar_r.p
     1354             (input  v-cntxt-db-num
     1355             ,input  v-cntxt-userid
     1356             ,input  'wndstore':U
     1357             ,output v-diasize-wndstore
     1358             ,output v-default-value
     1359             ) .
     1360         end.
     1361         assign
     1362           v-diasize-proc-name = entry(1, program-name(2), '.')
     1363         .
     1364         if v-diasize-wndstore = true
     1365         then do:
     1366           assign
     1367             v-restore-saved = false
     1368           .
     1369           if connected("ub") = true
     1370           then do:
     1371             run gbl/wndsizer.p
     1372               (input  v-cntxt-db-num
     1373               ,input  v-cntxt-userid
     1374               ,input  v-diasize-proc-name
     1375               ,input  'height':u
     1376               ,output v-resize-value-str
     1377               ) .
     1378             if v-resize-value-str <> '':U
     1379             then do:
     1380               run diasize_change-height in this-procedure
     1381                 (input  integer(v-resize-value-str)
     1382                 ,input  true
     1383                 ) .
     1384               assign
     1385                 v-restore-saved = true
     1386               .
     1387             end.
     1388           end.
     1389           if connected("ub") = true
     1390           then do:
     1391             run gbl/wndsizer.p
     1392               (input  v-cntxt-db-num
     1393               ,input  v-cntxt-userid
     1394               ,input  v-diasize-proc-name
     1395               ,input  'width':u
     1396               ,output v-resize-value-str
     1397               ) .
     1398             if v-resize-value-str <> '':U
     1399             then do:
     1400               run diasize_change-width in this-procedure
     1401                 (input  integer(v-resize-value-str)
     1402                 ,input  true
     1403                 ) .
     1404               assign
     1405                 v-restore-saved = true
     1406               .
     1407             end.
     1408           end.
     1409           if v-restore-saved <> true
     1410           then do:
     1411             if v-diasize-wndmax = true
     1412             then do:
     1413               run diasize_maximize in this-procedure
     1414                 (input  true
     1415                 ) .
     1416             end.
     1417           end.
     1418         end.
     1419         else do:
     1420           if v-diasize-wndmax = true
     1421           then do:
     1422             run diasize_maximize in this-procedure
     1423               (input  true
     1424               ) .
     1425           end.
     1426         end.
     1427       end.
     1428     end.
     1429   end procedure.
     1430   procedure diasize_need-full-display :
     1431     define output parameter p-need-full-display as logical   no-undo .
     1432     do
     1433     on error undo, return error return-value
     1434     :
     1435       assign
     1436         p-need-full-display = v-diasize-need-full-display
     1437       .
     1438       assign
     1439         v-diasize-need-full-display = false
     1440       .
     1441     end.
     1442   end procedure.
     1443   procedure get-context :
     1444      define output parameter p-db-num as integer          no-undo.
     1445      define output parameter p-user-id as character        no-undo.
     1446      define variable v-login               as character    no-undo.
     1447      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1448      define buffer buf_user-login  for ub.user-login .
     1449      do
     1450      on error undo, return error
     1451      :
     1452            FIND FIRST buf_sys-ctrl no-lock.
     1453            ASSIGN
     1454               v-login = USERID("ub")
     1455               p-db-num = buf_sys-ctrl.db-num
     1456            .
     1457            FIND FIRST buf_user-login
     1458                 WHERE buf_user-login.db-num = p-db-num
     1459                   AND buf_user-login.user-login = v-login
     1460                 no-lock
     1461                 no-error
     1462                 .
     1463            IF AVAILABLE buf_user-login
     1464            THEN DO:
     1465               assign
     1466                  p-user-id = buf_user-login.user-id
     1467               .
     1468            END.
     1469      end.
     1470   end procedure.
     1471   run diasize_add_browse in this-procedure
     1472     (input  'width':u
     1473     ,input  browse b-parts:handle
     1474     ) .
     1475   run diasize_add_browse in this-procedure
     1476     (input  'width':u
     1477     ,input  browse b-fin-doc:handle
     1478     ) .
     1479   run diasize_init in this-procedure .
     1480   MAIN-BLOCK:
     1481   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1482      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1483     FIND FIRST bf_trn-doc WHERE bf_trn-doc.doc-code = pardoc-code NO-LOCK.
     1484     RUN cr-tt-fo IN THIS-PROCEDURE.
     1485     ASSIGN FRAME
     1486     Dialog-Frame:TITLE = "Финансовые обязательства по складскому документу " + pardoc-code.
     1487     assign
     1488     bf_fin-connect.sum-rubl:label in browse b-fin-doc = "Сумма связи (руб)"
     1489     bf_fin-doc.sum-rubl:label in browse   b-fin-doc   = "Сумма платежа (руб)"
     1490     tt-fo.sum-rubl:label in browse b-ob               = "Общая сумма (руб)"
     1491     tt-fo.sum-rubl-trn:label in browse b-ob           = "Сумма по док. (руб)"
     1492     bf_parts.price-rubl:label in browse b-parts       = "Цена (руб)"
     1493     .
     1494     RUN enable_UI.
     1495     RUN open-parts-query IN THIS-PROCEDURE.
     1496     RUN open-fin-doc-query IN THIS-PROCEDURE.
     1497     WAIT-FOR GO OF FRAME Dialog-Frame.
     1498   END.
     1499   RUN disable_UI.
     1500   PROCEDURE cr-tt-fo :
     1501   FOR EACH bf_fin-gds-part WHERE bf_fin-gds-part.obj-type = bf_trn-doc.obj-type AND
     1502                                  bf_fin-gds-part.obj-code = bf_trn-doc.obj-code AND
     1503                                  bf_fin-gds-part.out-code = bf_trn-doc.doc-code NO-LOCK ON ERROR UNDO, RETURN ERROR RETURN-VALUE :
     1504       FIND FIRST bf_fin-ob WHERE bf_fin-ob.host-code = bf_fin-gds-part.host-code   AND
     1505                                  bf_fin-ob.doc-code  = bf_fin-gds-part.fin-ob-code NO-LOCK no-error.
     1506       if available bf_fin-ob then do:
     1507         FIND FIRST tt-fo WHERE tt-fo.host-code = bf_fin-ob.host-code AND
     1508                                tt-fo.doc-code  = bf_fin-ob.doc-code  NO-ERROR.
     1509         IF NOT AVAILABLE tt-fo THEN DO:
     1510           CREATE tt-fo.
     1511           BUFFER-COPY bf_fin-ob TO tt-fo.
     1512         END.
     1513         ASSIGN
     1514           tt-fo.sum-base-trn = tt-fo.sum-base-trn + bf_fin-gds-part.sum-base
     1515           tt-fo.sum-rubl-trn = tt-fo.sum-rubl-trn + bf_fin-gds-part.sum-rubl
     1516         .
     1517      end.
     1518   END.
     1519   END PROCEDURE.
     1520   PROCEDURE disable_UI :
     1521     HIDE FRAME Dialog-Frame.
     1522   END PROCEDURE.
     1523   PROCEDURE enable_UI :
     1524     ENABLE b-exit b-help b-ob b-parts b-fin-doc
     1525         WITH FRAME Dialog-Frame.
     1526     VIEW FRAME Dialog-Frame.
     1527     OPEN QUERY b-ob FOR EACH tt-fo.
     1528   END PROCEDURE.
     1529   PROCEDURE open-fin-doc-query :
     1530   IF AVAILABLE tt-fo THEN DO:
     1531       OPEN QUERY b-fin-doc
     1532           FOR EACH bf_fin-connect WHERE bf_fin-connect.host-code = tt-fo.host-code  AND
     1533                                         bf_fin-connect.fin-ob-code = tt-fo.doc-code NO-LOCK,
     1534           FIRST bf_fin-doc WHERE bf_fin-doc.host-code    = bf_fin-connect.host-code    AND
     1535                                  bf_fin-doc.fin-doc-code = bf_fin-connect.fin-doc-code NO-LOCK.
     1536       DISPLAY b-fin-doc WITH FRAME Dialog-Frame.
     1537   END.
     1538   END PROCEDURE.
     1539   PROCEDURE open-parts-query :
     1540   IF AVAILABLE tt-fo THEN DO:
     1541       OPEN QUERY b-parts
     1542           FOR EACH bf_fin-gds-part WHERE bf_fin-gds-part.host-code = tt-fo.host-code AND
     1543                                          bf_fin-gds-part.fin-ob-code = tt-fo.doc-code AND
     1544                                           bf_fin-gds-part.out-code = pardoc-code NO-LOCK,
     1545           first bf_goods where bf_goods.gds-code = bf_fin-gds-part.gds-code no-lock,
     1546           FIRST bf_parts WHERE bf_parts.obj-type = bf_fin-gds-part.obj-type AND
     1547                                bf_parts.obj-code = bf_fin-gds-part.obj-code AND
     1548                                bf_parts.artic    = bf_goods.artic AND
     1549                                bf_parts.prod-type = bf_goods.prod-type AND
     1550                                bf_parts.prod-code = bf_goods.prod-code AND
     1551                                bf_parts.in-code   = bf_fin-gds-part.in-code AND
     1552                                bf_parts.out-code  = bf_fin-gds-part.out-code AND
     1553                                bf_parts.part-code = bf_fin-gds-part.part-code NO-LOCK.
     1554       DISPLAY b-parts WITH FRAME Dialog-Frame.
     1555   END.
     1556   END PROCEDURE.
