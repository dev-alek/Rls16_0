     4962         find first goods no-lock where goods.artic = loc-gds-dtl.artic
     4963                                    and goods.prod-type = loc-gds-dtl.prod-type
     4964                                    and goods.prod-code = loc-gds-dtl.prod-code
     4965                                    .
     4966         if b-trn-doc.ext-doc-type =  'rs':U
     4967         then do :
     4968           find first buf_doc-fbr-gds no-lock where buf_doc-fbr-gds.out-code = replace(loc-gds-dtl.doc-code, "=", "-")
     4969                                                and buf_doc-fbr-gds.gds-code = goods.gds-code
     4970                                                no-error .
     4971           if available buf_doc-fbr-gds
     4972           then do :
     4973             if buf_doc-fbr-gds.fact-qnty > 0
     4974             then do :
     4975               assign
     4976                 v-to-reserv = no
     4977               .
     4978             end.
     4979             else do :
     4980               chg-qnty = if res-qnty >= 0 then abs(buf_doc-fbr-gds.fact-qnty) else buf_doc-fbr-gds.fact-qnty.
     4981             end.
     4982           end.
     4983         end.
     4984         if b-trn-doc.ext-doc-type =  'es':U
     4985         then do :
     4986           find first buf_doc-fbr-gds no-lock where buf_doc-fbr-gds.out-code = loc-gds-dtl.doc-code
     4987                                                and buf_doc-fbr-gds.gds-code = goods.gds-code
     4988                                                no-error .
     4989           if available buf_doc-fbr-gds
     4990           then do :
     4991             if buf_doc-fbr-gds.fact-qnty >= 0
     4992             then do :
     4993               chg-qnty = if res-qnty >= 0 then buf_doc-fbr-gds.fact-qnty else - buf_doc-fbr-gds.fact-qnty .
     4994             end.
     4995             else do :
     4996               assign
     4997                 v-to-reserv = no
     4998               .
     4999             end.
     5000           end.
     5001         end.
     5002       end.
     5003       if v-to-reserv and chg-qnty <> 0 then do:
     5004         if b-trn-doc.status_ = 'нередакт':U
     5005         or b-trn-doc.flag <> no
     5006         then do:
     5007           assign
     5008           v-return-status =  b-trn-doc.status_
     5009           v-return-flag = b-trn-doc.flag
     5010           b-trn-doc.status_ = 'накл':U
     5011           b-trn-doc.flag = no
     5012           v-return-st-fl = yes
     5013           .
