     3206     neg-tpsi-oper       = logical(entry(12, p-parameter, chr(4)))
     3207     no-error .
     3208     if error-status:error then do:
     3209       assign
     3210       v-esm = error-status:get-message(1)
     3211       v-input-error = yes
     3212       .
     3213     end.
     3214   end.
     3215   if p-auto = 0 then do:
     3216     log-file-name = 'salersrv.log' .
     3217   end.
