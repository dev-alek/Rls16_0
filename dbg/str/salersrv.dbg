     5634   procedure proc-main :
     5635   define variable v-close-enabled as logical no-undo .
     5636   define buffer tpsi_sale-doc for ub.sale-doc.
     5637   do
     5638   on error undo, return error return-value
     5639   :
     5640     find first buf_inkas exclusive-lock where
     5641                 buf_inkas.inkas-code = p-inkas-code no-error no-wait.
     5642     if NOT available buf_inkas
     5643     and not locked buf_inkas
     5644     then do:
     5645       return error substitute("Не найден отчет о продаже №&1", p-inkas-code).
     5646     end.
     5647     if locked buf_inkas then do:
     5648       if p-auto < 2 then
     5649       return error substitute("Отчет о продаже №&1 занят", p-inkas-code).
     5650       else do:
     5651         return "":U.
     5652       end.
     5653     end.
     5654     assign
     5655     v-obj-type = buf_inkas.obj-type
     5656     v-obj-code = buf_inkas.obj-code
     5657     .
     5658     FIND FIRST buf_trn-doc WHERE
     5659               buf_trn-doc.doc-code = buf_inkas.inkas-code NO-LOCK.
     5660     if (p-auto < 2
     5661     and not (buf_inkas.status_ = 'новый':U
     5662              or
     5663              buf_inkas.status_ = 'нередакт':U ))
     5664     then do:
     5665       return error substitute("Отчет о продаже №&1 имеет статус &2", buf_inkas.inkas-code, buf_inkas.status_).
     5666     end.
     5667     if buf_trn-doc.status_ = 'запрос':U then do:
     5668       return error substitute("Документы по продаже №&1 имеют статус", buf_trn-doc.status_).
     5669     end.
     5670     if p-auto >= 2
     5671     and buf_inkas.status_ <> 'новый':U
     5672     then do:
     5673       return "":U.
     5674     end.
     5675   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5676   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     5677     (input  'маг':U
     5678     ,input  buf_inkas.obj-code
     5679     ,output v-db-num
     5680     )  .
     5681     if v-db-num <> g#db-num then do:
     5682       return error substitute("Отчет о продаже №&1 относится к магазину БД &2, текущая БД &3"
     5683                               , buf_inkas.inkas-code
     5684                               , v-db-num
     5685                               , g#db-num
     5686                               ).
     5687     end.
     5688     FIND FIRST buf_ret-doc WHERE
     5689               buf_ret-doc.doc-code = buf_trn-doc.out-code NO-LOCK no-error.
     5690     find first buf_sysconf where
     5691              buf_sysconf.host-code = buf_inkas.host-code no-lock.
     5692     if not available buf_sysconf then do:
     5693       return error substitute("Не найдена запись о фирме &1", buf_inkas.host-code).
     5694     end.
     5695     assign
     5696     v-host-code = buf_inkas.host-code.
     5697     if p-auto <> 0 then do:
     5698       if can-find(first tpsi_sale-doc where
     5699                      tpsi_sale-doc.inkas-code = buf_inkas.inkas-code
     5700                  and tpsi_sale-doc.tpsidoc = yes)
     5701       then p-is-tpsi-obj = yes.
     5702       if p-is-tpsi-obj then do:
     5703         run tpsi-gds-fill-tpsi-obj-table in this-procedure (input v-db-num) no-error .
     5704         if error-status:error then do:
     5705         undo, return error
     5706           substitute("Ошибки при заполнении врем. таблицы объектов-членов ТПСИ на БД &1:&2&3 &4"
     5707                     , v-db-num
     5708                     , chr(10)
     5709                     , error-status:get-message(1)
     5710                     , return-value ).
     5711         end.
     5712       end.
     5713       if (p-is-tpsi-obj)
     5714       then do:
     5715   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input "Ждите.. получение информации по резервированию ЧУЖИХ товаров"                                       ).
     5716         run fill-tt-tpsi-table  in this-procedure (
     5717                                                       buf_inkas.inkas-code
     5718                                                     , buf_Inkas.host-code
     5719                                                     , buf_inkas.obj-type
     5720                                                     , buf_Inkas.obj-code).
     5721         run waitfram-hide in this-procedure .
     5722       end.
     5723     end.
     5724     assign
     5725     rdoc-line = ?
     5726     rgds-dtl = ?
     5727     r-or-v = ?
     5728     r-office = ?
     5729     r-qnty = ?
     5730     r-b-code = ?
     5731     r-pl-code = ?
     5732     r-doc-prts-qnty = ?
     5733     from-menu = yes
     5734     .
     5735     run b-res-proc in this-procedure (
     5736                                         buffer buf_Inkas
     5737                                       , buffer buf_trn-doc
     5738                                       , buffer buf_ret-doc
     5739                                       , input no
     5740                                       , input no
     5741                                       , input no
     5742                                       , input rest-dish
     5743                                       , input "":U
     5744                                       , input p-is-tpsi-obj
     5745                                       , input rest-tpsi) no-error .
     5746     if error-status:error  or return-value = "error" then do:
     5747       undo, return error  substitute("Ошибка при резервировании товаров продажи:&1&2 &3"
     5748                                      , chr(10)
     5749                                      , error-status:get-message(1)
     5750                                      , return-value
     5751                                      ).
     5752     end.
     5753     if p-auto = 3 then do:
     5754       RUN button-close in this-procedure (
     5755                                                buffer buf_trn-doc
     5756                                               ,buffer buf_ret-doc
     5757                                               ,input p-is-tpsi-obj
     5758                                               ,input auto-fbr
     5759                                               ,input neg-tpsi-weight
     5760                                               ,input neg-tpsi-qnty
     5761                                               ,input neg-tpsi-oper
     5762                                               ,Output b-close-enabled).
     5763       IF b-close-enabled then do:
     5764         run str/salestat.p (
     5765                           input parparentproc
     5766                           ,input p-inkas-code
     5767                           ,input '<закрытие документа>':U
     5768                           ,input 'нередакт':U
     5769                           ,input no
     5770                           ,input yes ) no-error .
     5771         if not error-status:error then do:
     5772                   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Продажа &1 помечена как готовая к закрытию", p-inkas-code)                                       ).
     5773         end.
     5774         else do:
     5775               run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("!!!Ошибка при переводе статуса продажи:&1&2 &3"                      , chr(10)                                                                   , error-status:get-message(1)                                                     , return-value )                                       ).
     5776         end.
     5777       end.
     5778     end.
     5779   end.
     5780   end procedure.
