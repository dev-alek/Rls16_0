     5062         b-doc-line.doc-qnty = b-doc-line.doc-qnty + chg-qnty
     5063         buf_sale-doc.doc-qnty = buf_sale-doc.doc-qnty  + chg-qnty
     5064         b-trn-doc.doc-qnty = b-trn-doc.doc-qnty  + chg-qnty
     5065         .
     5066         if available buf_doc-fbr-gds
     5067         then do :
     5068           if rz then do :
     5069             if buf_doc-fbr-gds.fact-qnty > 0
     5070             then do :
     5071               if loc-gds-dtl.doc-qnty = buf_doc-fbr-gds.fact-qnty then assign num_rec_res = num_rec_res + 1 .
     5072             end.
     5073             else
     5074             if buf_doc-fbr-gds.fact-qnty < 0
     5075             then do :
     5076               if loc-gds-dtl.doc-qnty = - buf_doc-fbr-gds.fact-qnty then assign num_rec_res = num_rec_res + 1 .
     5077             end.
     5078             else do :
     5079               if (loc-gds-dtl.doc-qnty = loc-gds-dtl.fact-qnty and rz) or                           (loc-gds-dtl.doc-qnty = 0 and not  rz)  then do: assign num_rec_res = num_rec_res + 1. end.
     5080             end.
     5081           end.
     5082           else do :
     5083             if loc-gds-dtl.doc-qnty = 0 then assign num_rec_res = num_rec_res + 1 .
     5084           end.
     5085         end.
     5086         else do :
     5087           if (loc-gds-dtl.doc-qnty = loc-gds-dtl.fact-qnty and rz) or                           (loc-gds-dtl.doc-qnty = 0 and not  rz)  then do: assign num_rec_res = num_rec_res + 1. end.
     5088         end.
     5089         if bottle then do:
     5090   assign
     5091     price-rubl-with-tax-loc = b-doc-line.price-rubl
     5092     price-base-with-tax-loc = b-doc-line.price-base
     5093   .
     5094   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5095   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5096     (output varinvprb
     5097     )  .
     5098      find first in-vatp_doc-attr no-lock
     5099       where in-vatp_doc-attr.doc-code  = b-trn-doc.doc-code
     5100         and in-vatp_doc-attr.attr-code = 'envd':U
