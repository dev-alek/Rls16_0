     4850           other-base-loc      = if b-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / b-doc-line.fact-qnty  else 0
     4851           other-rubl-loc      = if b-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / b-doc-line.fact-qnty  else 0
     4852                                           vat-base-loc        = if b-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / b-doc-line.fact-qnty   else 0
     4853           slt-base-loc        = if b-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / b-doc-line.fact-qnty   else 0
     4854                   vat-rubl-loc        = if b-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / b-doc-line.fact-qnty   else 0
     4855           slt-rubl-loc        = if b-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / b-doc-line.fact-qnty   else 0
     4856           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     4857           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     4858         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     4859         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     4860         if transport-base-loc = ? then transport-base-loc = 0.
     4861         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     4862         if other-base-loc     = ? then other-base-loc     = 0.
     4863         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     4864         assign
     4865           transport-cli-loc      = 0
     4866           other-cli-loc          = 0
     4867           road-tax-cli-loc       = ?
     4868           vat-cli-loc            = ?
     4869           slt-cli-loc            = ?
     4870           price-cli-with-tax-loc = ?.
     4871      end.
     4872   ASSIGN
     4873             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     4874       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     4875   .
     4876           assign
     4877           b-doc-line.road-tax = (if v-curr-r-b = 'rubl':U then road-tax-rubl-loc else road-tax-base-loc).
     4878         end.
     4879         if rz then do:
     4880           if b-trn-doc.print-rubl
     4881           then assign
     4882             loc-gds-dtl.price-base = loc-gds-dtl.price-rubl / b-trn-doc.base-rate * b-trn-doc.base-scale
     4883             loc-gds-dtl.discnt-base = loc-gds-dtl.discnt-rubl / b-trn-doc.base-rate * b-trn-doc.base-scale
     4884             loc-gds-dtl.discnt-pc = (if loc-gds-dtl.price-rubl = 0
     4885                                      then 0
     4886                                      else loc-gds-dtl.discnt-rubl * 100 / loc-gds-dtl.price-rubl) .
     4887           else
     4888           assign
     4889           loc-gds-dtl.price-rubl = loc-gds-dtl.price-base * b-trn-doc.base-rate / b-trn-doc.base-scale
     4890           loc-gds-dtl.discnt-rubl = loc-gds-dtl.discnt-base * b-trn-doc.base-rate / b-trn-doc.base-scale
     4891           loc-gds-dtl.discnt-pc = (if loc-gds-dtl.price-base = 0
     4892                                    then 0
     4893                                    else loc-gds-dtl.discnt-base * 100 / loc-gds-dtl.price-base ).
     4894         end.
     4895       end.
     4896       if chg-qnty = res-qnty
     4897       then parts-ok = yes.
     4898       else parts-ok = no.
     4899       release loc-gds-dtl.
     4900       if no-partion-qnty = 0 then return.
     4901     end.
     4902     if not cashparts or no-partion-qnty <> 0 or NOT cashplace OR no-place-qnty <> 0 then do:
     4903     if cashplace then no-partion-qnty = no-place-qnty.
     4904     _gdsdtl:
     4905     FOR EACH loc-gds-dtl WHERE
     4906             loc-gds-dtl.doc-code = b-trn-doc.doc-code AND
     4907             loc-gds-dtl.artic = b-doc-line.artic AND
     4908             loc-gds-dtl.prod-type = b-doc-line.prod-type AND
     4909             loc-gds-dtl.prod-code = b-doc-line.prod-code
     4910             EXCLUSIVE-LOCK ON ERROR UNDO, NEXT:
     4911       IF rz AND loc-gds-dtl.fact-qnty <= loc-gds-dtl.doc-qnty then NEXT.
     4912       IF not rz AND loc-gds-dtl.doc-qnty = 0 AND v-is-own then NEXT.
     4913       IF NOT (rgds-dtl = ?) then do:
     4914         if NOT recid(loc-gds-dtl) = rgds-dtl THEN NEXT.
     4915         assign
     4916         r-prt-code = loc-gds-dtl.prt-code.
     4917       end.
     4918   if ( num_rec modulo 10 ) = 0 then
     4919   run write-counter in p-log-handle (input substitute("&1 - обработано &2, из них успешно - &3"                                                         , rsrv-title                                                                 , num_rec                                                                    , num_rec_res)).
     4920       assign
     4921       res-qnty = if cashparts
     4922                   then (if rz
     4923                         then no-partion-qnty
     4924                         else (if r-qnty = ?
     4925                               then (- loc-gds-dtl.doc-qnty)
     4926                               else no-partion-qnty)
     4927                         )
     4928                   else (if rz
     4929                         then (loc-gds-dtl.fact-qnty - loc-gds-dtl.doc-qnty)
     4930                         else (if r-qnty = ?
     4931                               then (- loc-gds-dtl.doc-qnty)
     4932                               else r-qnty
     4933                               )
     4934                         )
     4935       chg-qnty = res-qnty
     4936       cost-base = 0
     4937       cost-rubl = 0 .
     4938       if not v-is-own and rz then do:
     4939         find first buf_tt0-gds-dtl no-lock where
     4940                   buf_tt0-gds-dtl.artic     = loc-gds-dtl.artic
     4941               AND buf_tt0-gds-dtl.prod-type = loc-gds-dtl.prod-type
     4942               AND buf_tt0-gds-dtl.prod-code = loc-gds-dtl.prod-code
     4943               AND buf_tt0-gds-dtl.prt-code = loc-gds-dtl.prt-code no-error .
     4944         if available buf_tt0-gds-dtl then do:
     4945           assign
     4946           chg-qnty = chg-qnty - buf_tt0-gds-dtl.doc-qnty.
     4947         end.
     4948       end.
     4949       if not v-is-own and not rz and chg-qnty = 0 then
     4950       assign
     4951       v-to-reserv = no
     4952       .
     4953       if not v-is-own
     4954       and rz
     4955       and (available buf_tt0-gds-dtl and (buf_tt0-gds-dtl.doc-qnty + loc-gds-dtl.doc-qnty) = loc-gds-dtl.fact-qnty)
     4956       then
     4957       assign
     4958       v-to-reserv = no
     4959       .
     4960       if p-auto-fbr-on
