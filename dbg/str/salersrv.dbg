     3202     rest-ingr           = logical(entry(8, p-parameter, chr(4)))
     3203     rest-tpsi           = logical(entry(9, p-parameter, chr(4)))
     3204     neg-tpsi-weight     = logical(entry(10, p-parameter, chr(4)))
